ext":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/65/b0/ba/a92ac357d4ab541d77a97d6776f928ec.JPG","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1778,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eNgày nay, việc sở hữu riêng cho mình một chiếc smartphone màn hình cảm ứng đã không còn là vấn đề khó khăn gì nữa. Phần lớn các thao tác trong qua trình sử dụng đều qua màn hình. Cho nên việc sử dụng \u003cem\u003ekính cường lực/miếng dán cường lực\u003c/em\u003e để bảo vệ màn hình khỏi những tác hại từ bên ngoài là vô cùng cần thiết.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/65/b0/ba/06d4ce41ec5c427a3d07eed646c96ad8.JPG\" alt=\"\" width=\"500\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp\u003eVới thiết kế đặc biệt, \u003cem\u003ekính cường lực điện thoại \u003cstrong\u003eIphone 7 Plus / 8 Plus\u003c/strong\u003e \u003c/em\u003ecó thể phủ đến tận viền của màn hình. Vừa có thể \u003cem\u003eđảm bảo được tính thẩm mỹ\u003c/em\u003e nhưng vẫn \u003cem\u003egiữ được độ an toàn\u003c/em\u003e cho thiết bị của bạn. Ngoài ra, việc kính phủ ra tận viền màn hình, sẽ giúp cho khả năng bảo vệ màn hình điện thoại tốt hơn so với cường lực thường.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/1c/6c/b5/11c3291acd5d7bebd1f1a5c3ce072fed.jpg\" alt=\"\" width=\"500\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp\u003eViền kính cường lực trùng với màu viền của máy, vì thế khi dán lên màn hình nó sẽ tạo thành 1 khối thống nhất với phần màn hình. Độ dày cường lực không quá lớn, nên nó sẽ không khiến cho màn hình của bạn quá lồi so với bình thường.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/ec/bc/9f/86e4c5129ee4b98f2e3a01ffc84701a3.jpg\" alt=\"\" width=\"500\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp\u003eKính cường lực full màn hình nên cong 2 mặt cả bên trong và bên ngoài, giúp \u003cem\u003eôm sát mép cong của máy\u003c/em\u003e hơn, hạn chế được việc hở viền máy và hạn chế bụi bẩn lọt qua cạnh viền, đồng thời khắc phục được hiện tượng mẻ viền sau thời gian sử dụng.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/55/75/2d/6d0f800932f2fd3efb13589d0d9e8b32.jpg\" alt=\"\" width=\"500\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp\u003eĐộ cứng đạt chuẩn 9H bảo vệ màn hình điiện thoại trước các va đập, cọ xát, mang lại sự an tâm tuyệt đối cho người dùng.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/0a/89/e8/70f24c26f4d2d5d424cba0619e3e3053.JPG\" alt=\"\" width=\"500\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp\u003eKính có độ trong đạt chuẩn HD, cho chất lượng hình ảnh sắc nét và đẹp như hình ảnh gốc, cũng như không ảnh hưởng đến độ nhạy của cảm ứng, cảm giác vuốt cảm ứng mượt như màn hình gốc.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eBộ kính cường lực điện thoại bao gồm đầy đủ phụ kiện: hộp đựng kính, 2 khăn lau kính.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/db/ec/53/bc7ffd63f0647b93ab2f9b49a9995c11.JPG\" alt=\"\" width=\"500\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp\u003eVới những điểm nổi bật đó, chắc chắn đây sẽ là món phụ kiện không thể thiếu để bảo vệ điện thoại của bạn khỏi nguy cơ nứt vỡ màn hình, giữ được sự sang trọng và cảm giác trải nghiệm hoàn hảo như không dán cường lực.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/65/b0/ba/a92ac357d4ab541d77a97d6776f928ec.JPG","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/65/b0/ba/a92ac357d4ab541d77a97d6776f928ec.JPG","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/65/b0/ba/a92ac357d4ab541d77a97d6776f928ec.JPG","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/65/b0/ba/a92ac357d4ab541d77a97d6776f928ec.JPG","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/65/b0/ba/a92ac357d4ab541d77a97d6776f928ec.JPG"},{"base_url":"https://salt.tikicdn.com/ts/product/0a/89/e8/bcbd335c6f74ccc01295b84411ab2beb.JPG","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0a/89/e8/bcbd335c6f74ccc01295b84411ab2beb.JPG","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/0a/89/e8/bcbd335c6f74ccc01295b84411ab2beb.JPG","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0a/89/e8/bcbd335c6f74ccc01295b84411ab2beb.JPG","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0a/89/e8/bcbd335c6f74ccc01295b84411ab2beb.JPG"},{"base_url":"https://salt.tikicdn.com/ts/product/1c/6c/b5/16c7f300f9501a6321378a54308427aa.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1