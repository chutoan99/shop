n_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"defective_product"}},"discount":0,"discount_rate":0,"rating_average":4,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/d0/8c/7a/51509278a64d2111fed31f483c1f6333.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":553,"all_time_quantity_sold":30,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eNước Hoa Vùng Kín Dionel Secret Love Black Edition Inner Parfume Oil\u003c/p\u003e\n\u003cp\u003eThương hiệu: Dionel\u003c/p\u003e\n\u003cp\u003eXuất xứ: Hàn Quốc\u003c/p\u003e\n\u003cp\u003eDung tích: 5ml\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/1e/72/70/b707d95c8d10f4952c348706a1622496.jpg\" alt=\"\" width=\"750\" height=\"837\" /\u003e\u003c/p\u003e\n\u003cp\u003eBlack Edition: Hương hoa cam, lan Nam Phi, cam đào và sự quyến rũ của hoa hồng, hoa nhài và hoa mộc lan.\u003c/p\u003e\n\u003cp\u003e+ Thành phần:\u003c/p\u003e\n\u003cp\u003e- Dầu Ô liu\u003c/p\u003e\n\u003cp\u003e- Dầu hoa Anh Thảo\u003c/p\u003e\n\u003cp\u003e- Dầu hạt Citron\u003c/p\u003e\n\u003cp\u003e- Dầu hạt Macadamia\u003c/p\u003e\n\u003cp\u003e- Dầu hạt Jojoba\u003c/p\u003e\n\u003cp\u003e- Dầu hạt Hạnh nhân\u003c/p\u003e\n\u003cp\u003e- Dầu hạt Hướng dương\u003c/p\u003e\n\u003cp\u003e- Và thành phần hương tự nhiên làm nên mùi đặc trưng của từng loại sản phẩm.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e+ Công dụng:\u003c/p\u003e\n\u003cp\u003e- Đem lại hương thơm dịu nhẹ, quyến rũ cho v.ùng k.ín.\u003c/p\u003e\n\u003cp\u003e- Giúp làm sạch và khử mùi gây khó chịu.\u003c/p\u003e\n\u003cp\u003e- Cân bằng độ pH và khử trùng vi khuẩn Candida, Pseudomonas Aeruginosa và Colon Bacillus, hạn chế tình trạng viêm nhiễm v.ùng k.ín.\u003c/p\u003e\n\u003cp\u003e- Phù hợp với mọi loại da.\u003c/p\u003e\n\u003cp\u003e- Lưu hương 16 -18 tiếng.\u003c/p\u003e\n\u003cp\u003e- Kích thích sự hưng phấn.\u003c/p\u003e\n\u003cp\u003e- Sản phẩm nước hoa v.ùng k.ín được bộ Y tế Hàn Quốc cấp phép.\u003c/p\u003e\n\u003cp\u003e- Chứa phytoncide có tác dụng hạn chế stress.\u003c/p\u003e\n\u003cp\u003e- Chứa thành phần tự nhiên và an toàn với 6 chiết xuất thảo dược và 6 loại dầu thực vật.\u003c/p\u003e\n\u003cp\u003e+ Hướng dẫn sử dụng: \u003c/p\u003e\n\u003cp\u003e- Với Nước hoa v.ùng k.ín Dionel Secret Love bạn có thể sử dụng theo nhiều cách phù hợp với nhu cầu của mình:\u003c/p\u003e\n\u003cp\u003e- Nhỏ 1-2 giọt vào quần lót mỗi ngày, dung dịch sẽ hút đi mùi khó chịu và tỏa ra hương dễ chịu một cách nhanh chóng.\u003c/p\u003e\n\u003cp\u003e- Khi tắm bồn: nhỏ 3~4 giọt vào nước. Mùi hương dễ chịu của nước hoa sẽ lan tỏa giúp bạn thư thái.\u003c/p\u003e\n\u003cp\u003e- Khi đến kỳ kinh nguyệt: Nhỏ 1-2 giọt vào băng vệ sinh, giúp khử mùi khó chịu và cân bằng độ pH.\u003c/p\u003e\n\u003cp\u003e- Trong ngày hẹn hò: Nhỏ 1~2 giọt lên quần lót, cổ tay, cổ, gáy. Mùi hương của Secret Love sẽ tạo cho bạn một bầu không khí lãng mạn, ngọt ngào.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eLưu ý: Bao bì có thể thay đổi theo từng đợt nhập\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/d0/8c/7a/51509278a64d2111fed31f483c1f6333.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d0/8c/7a/51509278a64d2111fed31f483c1f6333.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d0/8c/7a/51509278a64d2111fed31f483c1f6333.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d0/8c/7a/51509278a64d2111fed31f483c1f6333.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d0/8c/7a/51509278a64d2111fed31f483c1f6333.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/1e/72/70/954d72f12fd9cc902187acc3343e69f0.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/1e/72/70/954d72f12fd9cc902187acc3343e69f0.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/1e/72/70/954d72f12fd9cc902187acc3343e69f0.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1e/72/70/954d72f12fd9cc902187acc3343e69f0.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1e/72/70/954d72f12fd9cc902187acc3343e69f0.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/dc/fb/b7/a81759546f2f74639720c4325511a51a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/dc/fb/b7/a81759546f2f74639720c4325511a51a.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/dc/fb/b7/a81759546f2f74639720c4325511a51a.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/dc/fb/b7/a81759546f2f74639720c4325511a51a.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/dc/fb/b7/a81759546f2f74639720c4325511a51a.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/a1/b3/0e/98dbc1a0ac6af7361c3d765760a24041.jpg