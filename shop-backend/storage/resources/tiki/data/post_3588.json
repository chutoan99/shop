ext_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":83200,"discount_rate":52,"rating_average":5,"review_count":3,"review_text":"(3)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/95/b3/e3/54bd32adec2c169c0a970ebfaaf7df4e.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":714,"all_time_quantity_sold":101,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eĐiều quan trọng nhất\u003c/p\u003e\n\u003cp\u003eTác giả Adyashanti\u003c/p\u003e\n\u003cp\u003e----\u003c/p\u003e\n\u003cp\u003eĐIỀU QUAN TRỌNG NHẤT\u003c/p\u003e\n\u003cp\u003eLẽ thật cuộc đời từ những cơ duyên\u003c/p\u003e\n\u003cp\u003eMỗi khoảnh khắc trong cuộc sống là một câu chuyện dở dang \u003c/p\u003e\n\u003cp\u003eThói quen kể chuyện bắt đầu từ thuở xa xưa, thời tổ tiên ta cùng ngồi vây quanh đống lửa vào những đêm trăng sáng, ôn lại các sự kiện trong ngày, trong năm, hoặc kể lại các sự kiện đáng nhớ của dòng họ. Mặc dù công nghệ đã phát triển vượt xa mọi tưởng tượng của tổ tiên, song chúng ta vẫn kể chuyện cho nhau nghe hằng ngày và tự trò chuyện với chính mình, có lẽ gần như mỗi phút.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eMỗi khoảnh khắc trong cuộc sống của chúng ta là một câu chuyện còn dở dang, vẫn đang được viết tiếp, hay là một cuốn tiểu thuyết không hồi kết, các chương mới vẫn tiếp tục ra đời mỗi ngày. Và nếu chú tâm, chúng ta sẽ nhận thấy rằng một số câu chuyện chứa đựng những khoảnh khắc cơ duyên, khi chúng ta được ban tặng trí tuệ, tình yêu hay sự thấu suốt. Những câu chuyện như vậy có thể soi sáng và chuyển hóa đời ta trở nên tốt đẹp hơn.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eTừng mẩu nhỏ trong cuộc sống nội tâm của chúng ta đều đáng kinh ngạc, khó hiểu và bí ẩn như vũ trụ bao la, vĩnh hằng. Mỗi chúng ta là một bản thể có ý thức, chúng ta chứa đựng vũ trụ bao la trong mình, cũng như vũ trụ chứa ta bên trong nó. Nhìn vào nội tâm và đáp lại lời kêu gọi hiểu chính mình từ ngàn xưa có lẽ là cuộc phiêu lưu kỳ lạ và vĩ đại nhất trong tất cả các cuộc phiêu lưu. Đó là chìa khóa để thức tỉnh trước sự thật về con người chúng ta và sống một cuộc đời vượt xa những gì chúng ta có thể tưởng tượng.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eCuốn sách The Most Important Thing: Discovering Truth at The Heart of Life này sẽ không chỉ giúp bạn chiêu đãi và nâng cao tinh thần của mình, mà còn cung cấp cho bạn phương tiện để đi sâu vào trải nghiệm trực tiếp về sự hiện hữu, từ đó bạn sẽ nếm được vị của phúc lành nhờ biết ưu tiên cho điều quan trọng nhất.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eĐiều Quan Trọng Nhất - Cuốn sách hướng đến sự giác ngộ ngay trong ta \u003c/p\u003e\n\u003cp\u003eTrong “Điều quan trọng nhất”, bậc thầy hiện sinh nổi tiếng Adyashanti chia sẻ những câu chuyện giác ngộ của mình để giúp chúng ta khám phá ra điều quan trọng nhất đối với bản thân. Hành trình của ông và của chúng ta tập trung vào câu hỏi, cũng chính là lời chỉ dẫn: “Làm thế nào để tôi có thể trở thành hiện thân của những gì tôi yêu thích?”\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eTác giả diễn tả những chân lý cao siêu, khó hiểu nhất bằng ngôn ngữ đời thường giản dị. Những chia sẻ ngắn gọn, chân thành này vừa đủ để giúp ta biết về trí huệ, gợi mở cho ta về giác ngộ và những khoảnh khắc cơ duyên khi bạn cần đến chúng. Tôi hy vọng bạn sẽ tận hưởng món quà hào phóng và thiết yếu này đối với thời đại của chúng ta.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eKhi đọc “Điều quan trọng nhất”, bạn sẽ muốn gạch dưới những lời quý báu, thông tuệ trên khắp các trang sách, và bạn sẽ muốn dừng lại và lắng nghe chính mình. Adyashanti đã mang tới phúc lành cho chúng ta khi hướng ta tới sự giác ngộ ngay trong ta.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/8e/ca/4a/0ab229f7fd36bd4b811d051af7191a73.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e-----\u003c/p\u003e\n\u003cp\u003eTác giả Adyashanti\u003c/p\u003e\n\u003cp\u003eCông ty phát hành Saigon Books\u003c/p\u003e\n\u003cp\u003eMã sản phẩm 8935278606697\u003c/p\u003e\n\u003cp\u003eNhà xuất bản NXB Thế Giới\u003c/p\u003e\n\u003cp\u003eKích thước1 3 x 20.5 cm\u003c/p\u003e\n\u003cp\u003eSố trang:264\u003c/p\u003e\n\u003cp\u003eNăm phát hành 09/2022\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/95/b3/e3/54bd32adec2c169c0a970ebfaaf7df4e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/95/b3/e3/54bd32adec2c169c0a970ebfaaf7df4e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/95/b3/e3/54bd32adec2c169c0a970ebfaaf7df4e.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/95/b3/e3/54bd32adec2c169c0a970ebfaaf7df4e.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/95/b3/e3/54bd32adec2c169c0a970ebfaaf7df4e.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/77/e6/b2/e1588f421768e0f92873aae28ffb18bd.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/77/e6/b2/e1588f421768e0f92873aae28ffb18bd.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/77/e6/b2/e1588f421768e0f92873aae28ffb1