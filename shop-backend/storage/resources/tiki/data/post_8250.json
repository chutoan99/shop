596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/3a/b7/b4/785cce447102b1890a1790a9c08e26b7.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":239,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003carticle class=\"4ever-article\"\u003e\n\u003cp\u003eThông tin sản phẩm:\u003c/p\u003e\n\u003cp\u003eBình Thủy Điện SHARP KP-40EBV-ST/WH/BK - Hàng Chính Hãng\u003c/p\u003e\n\u003cp\u003eLoại bình: 4 lít, 800W\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cdiv\u003eMức nhiệt giữ nóng: Đun sôi 100°C, Giữ ấm 45 - 95°C\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv\u003eChất liệu vỏ, ruột bình: Thép không gỉInox 304\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv\u003eCách lấy nước: Chạm nút cảm ứng\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv\u003eHẹn giờ đun sôi: Tối đa 12 tiếng\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv\u003eTiện ích: Chế độ rót nước chậm chống bỏngCó màn hình hiển thịCột hiển thị mực nướcLoại bỏ CloTự đun sôi lại khi nước nguội\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv\u003eChế độ an toàn: Khóa trẻ em\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv\u003eThương hiệu của: Nhật Bản\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv\u003eHãng: Sharp\u003c/div\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eThiết kế\u003c/p\u003e\n\u003cp\u003e- Bình thủy điện được thiết kế tinh tế cùng màu đen sang trọng, tô điểm thêm cho không gian nhà bạn.\u003c/p\u003e\n\u003cp\u003e- Vỏ bình bằng thép không gỉ phủ sơn sáng bóng, ruột bình inox 304 bền bỉ, hạn chế gỉ sét, an toàn cho sức khỏe, dễ dàng vệ sinh.\u003c/p\u003e\n\u003cp\u003e- Trang bị thang đo mực nước với các vạch mức rõ ràng, tiện lợi việc quan sát và đo lường lượng nước cho vào bình.\u003c/p\u003e\n\u003cp\u003eCông suất - Dung tích - Mức nhiệt\u003c/p\u003e\n\u003cp\u003e- Công suất 800W, đun sôi và giữ ấm nước ổn định.\u003c/p\u003e\n\u003cp\u003e- Dung tích 4 lít, đáp ứng nhu cầu đun và giữ ấm nước cho gia đình đông thành viên, nhà có trẻ nhỏ, có nhu cầu dùng nước sôi lớn.\u003c/p\u003e\n\u003cp\u003eBảng điều khiển\u003c/p\u003e\n\u003cp\u003e- Bảng điều khiển cảm ứng tiếng Việt, có màn hình LED hiển thị.\u003c/p\u003e\n\u003cp\u003e- Rót nước bằng cách chạm nút cảm ứng, sử dụng tiện lợi, dễ dàng.\u003c/p\u003e\n\u003cp\u003eTiện ích - Chế độ an toàn\u003c/p\u003e\n\u003cp\u003e- Bình có chế độ tự đun sôi lại khi nước nguội, đảm bảo nước đủ nóng cho bạn sử dụng bất cứ khi nào cần.\u003c/p\u003e\n\u003cp\u003e- Chế độ rót nước chậm chống bỏng, thích hợp sử dụng cho người cao tuổi hay bị run tay hoặc lấy nước pha cà phê, dễ dàng điều chỉnh lượng nước phù hợp.\u003c/p\u003e\n\u003cp\u003e- Trang bị chức năng loại bỏ Clo trong nước, giúp nước được sạch và tinh khiết, đảm bảo an toàn cho sức khỏe gia đình bạn. \u003c/p\u003e\n\u003cp\u003e- Có chế độ khóa trẻ em, đảm bảo an toàn cho người sử dụng, nhất là những gia đình có trẻ nhỏ.\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cdiv\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/74/37/90/c79bda86497487e5bb485c1a629aba36.png\" alt=\"7437907898de3abfcacf7bd4e189451b.png\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/e9/16/0e/11621c8e8af6582403854dc2e3085d96.png\" alt=\"e9160ead3a320340ff8044af11452f3d.png\" /\u003e\u003c/div\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/article\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/3a/b7/b4/785cce447102b1890a1790a9c08e26b7.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/3a/b7/b4/785cce447102b1890a1790a9c08e26b7.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/3a/b7/b4/785cce447102b1890a1790a9c08e26b7.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3a/b7/b4/785cce447102b1890a1790a9c08e26b7.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3a/b7/b4/785cce447102b1890a1790a9c08e26b7.png"},{"base_url":"https://salt.tikicdn.com/ts/product/62/ed/b7/f731209aa60bbafd5261b60c31b989d8.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/62/ed/b7/f731209aa60bbafd5261b60c31b989d8.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/62/ed/b7/f731209aa60bbafd5261b60c31b989d8.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/62/ed/b7/f731209aa60bbafd5261b60c31b989d8.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/62/ed/b7/f731209aa60bbafd5261b60c31b989d8.png"},{"base_url":"https://salt.tikicdn.com/ts/product/f0/b4/2b/69a403c8f778ba30a9214269f0b15658.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f0/b4/2b/69a403c8f778ba30a9214269f0b15658.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f0/b4/2b/69a403c8f778ba30a9214269f0b15658.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f0/b4/2b/69a