 thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/1d/33/09/242b0b5901f0d80cc6e20b30f7c23ae7.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/1d/33/09/242b0b5901f0d80cc6e20b30f7c23ae7.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/1d/33/09/242b0b5901f0d80cc6e20b30f7c23ae7.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1d/33/09/242b0b5901f0d80cc6e20b30f7c23ae7.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1d/33/09/242b0b5901f0d80cc6e20b30f7c23ae7.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/f1/5c/d5/c7a52c85ac96b6f7fbfdceda72e30e8a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f1/5c/d5/c7a52c85ac96b6f7fbfdceda72e30e8a.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f1/5c/d5/c7a52c85ac96b6f7fbfdceda72e30e8a.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f1/5c/d5/c7a52c85ac96b6f7fbfdceda72e30e8a.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f1/5c/d5/c7a52c85ac96b6f7fbfdceda72e30e8a.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/6a/46/ed/8d6cf6c413e9967fa58f0b3d302a4146.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/6a/46/ed/8d6cf6c413e9967fa58f0b3d302a4146.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/6a/46/ed/8d6cf6c413e9967fa58f0b3d302a4146.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6a/46/ed/8d6cf6c413e9967fa58f0b3d302a4146.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6a/46/ed/8d6cf6c413e9967fa58f0b3d302a4146.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/b9/23/a7/048d301595d27f0521e416c3c4175f68.jpg","is_gallery":true,"label":null,"large_u