:null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/media/catalog/product/d/s/dsc_0136_7708795212976.u634.d20160613.t164711.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":3186,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003e\u003cspan style=\"font-size: medium; background-color: #ffffff; color: #008ab7;\"\u003eBút Dạ Quang Thiên Long HL-03 \u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eBút Dạ Quang \u003c/strong\u003e\u003cstrong\u003eThiên Long \u003c/strong\u003e\u003cstrong\u003eHL-03\u003c/strong\u003e\u003cstrong\u003e \u003c/strong\u003elà dòng văn phòng phẩm được các em học sinh, sinh viên và giới văn phòng sử dụng rộng rãi. Màu mực tươi sáng, làm nổi bật các dòng, các điểm cần lưu ý trong văn bản. Bút có 2 đầu, đầu tròn 0.8 - 1.1mm, đầu dẹp 4mm, giúp tăng thêm tính năng sử dụng.\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Bút Dạ Quang Thiên Long HL-03 \" src=\"http://tikicdn.com/media/catalog/product/g/f/gfnbgfngn345634vfdsfv.jpg\" alt=\"Bút Dạ Quang Thiên Long HL-03 \" width=\"500\" height=\"500\" /\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eThông tin sản phẩm\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eBút 2 đầu tiện dụng\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eBút Dạ Quang Thiên Long HL-03 có 2 đầu. Đầu tròn 0.8 - 1.1mm, đầu dẹp 4mm, giúp tăng thêm tính năng sử dụng. Nắp đậy chắc chắn, bảo vệ đầu bút hiệu quả. Kiểu dáng bút nhỏ gọn, thon dài, vừa tay, dễ sử dụng. Đầu bút và ruột bút dạ quang HL-03 được làm bằng polyester siêu bền.\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eMàu mực tươi sáng\u003c/strong\u003e\u003cstrong\u003e, nhanh khô\u003c/strong\u003e\u003cstrong\u003e \u003c/strong\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eMàu mực tươi sáng, nhanh khô. Độ phản quang cao làm nổi bật các dòng, các điểm cần lưu ý trong văn bản. Mực viết được sản xuất từ chất màu hoà với nước, không gây mùi khó chịu, không độc hại, đạt tiêu chuẩn EN71/3, ASTM D-4236.\u003cstrong\u003e \u003c/strong\u003e\u003cstrong\u003e\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eTính ứng dụng cao\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eBút Dạ Quang Thiên Long HL-03\u003cstrong\u003e \u003c/strong\u003elà dòng văn phòng phẩm được các em học sinh, sinh viên và giới văn phòng sử dụng rộng rãi. Đây là loại bút dùng để đánh dấu, nhớ dòng, có nhiều màu sắc khác nhau cho bạn lựa chọn. Màu dạ quang không làm lem nét chữ của mực khi viết chồng lên và không để lại vết khi photocopy. Sản phẩm có thể sử dụng trên nhiều loại giấy.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/media/catalog/product/d/s/dsc_0136_7708795212976.u634.d20160613.t164711.jpg","is_gallery":tr