":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/d9/5b/be/efe8b2e3c27b177228867baf8925bc8a.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":457,"all_time_quantity_sold":17,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2 class=\"irIKAp\"\u003e\u003cem\u003eMũ bảo hiểm nửa đầu kèm kính phi công, kính UV NON CAMRY CR01 độc đáo, nhiều màu sắc, Freesize (55-59cm)\u003c/em\u003e\u003c/h2\u003e\n\u003cp class=\"irIKAp\"\u003eđược thiết kế năng động trẻ trung, chắc chắn và bền bỉ, đem lại cảm giác thoải mái an toàn cho người đội.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/04/12/ac/dc1f7bf44cbc3a744a9b5c5fadbf6408.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e* Thân mũ/nón (vỏ mũ/nón) bảo hiểm: được làm từ nhựa ABS nguyên sinh chưa qua sử dụng, do đó có thể chịu được sự va đập mạnh và đâm xuyên cao, đặc biệt không mùi nhựa khó chịu như các loại mũ chất lượng kém khác.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/d1/97/c1/0bc70c52085f6f892086c3a5e998e261.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e* Lớp đệm mút xốp EPS (Foam): có độ cứng vững rất tốt, vừa vặn và bám chặt vào thân nón có tác dụng hấp thụ xung động cao giúp bảo vệ tối đa cho người dùng khi xảy ra va chạm, đặc biệt không gây cảm giác nặng và đau đầu, tạo cho người đội cảm giác thoải mái và thoáng mát khi sử dụng.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/36/1a/40/273e946e91eddc2977d1a225ecec8ef3.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e* Dây đeo và khóa mũ: chắc chắn, với khóa mũ là khóa PULL đỏ cao cấp, dễ dàng tháo lắp, bền với thời gian.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/c9/36/56/f8353382a498060909323f4cadec061a.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e* Nước sơn: được sơn bằng công nghệ hiện đại, tạo bề mặt sáng, bóng, nhẵn mịn, không ngả màu.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/28/6d/03/b8b047c4a572d1a041cb4d8575720476.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e* Đa sắc màu: đen, trắng, xanh hòa bình, hồng, kem, cam, xanh bộ đội\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/d9/5b/be/68628a557849aa568ec553728e799932.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e* Kích thước: freesize ( vòng đầu từ 54-59cm đội vừa, thích hợp cho cả nam và nữ).\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e* Được kiểm định độ bền và chất lượng kỹ lưỡng trước khi xuất xưởng.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eLưu ý: Có thể kết hợp thêm kính UV hay kính phi công để tăng thêm phần thời trang cho mũ.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/f2/60/95/cd50433356129393a21184c516155644.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eHướng dẫn đo vòng đầu chọn mũ bảo hiểm:\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e* Vòng 1 sợi dây quanh đầu, ngay phía trên lông ma*y và tai. Xiết sợi dây cho ôm vừa đủ thoải mái đầu và ghi lại số đo đó. Lặp lại như vậy để tìm được số đo mà bạn thấy đầu dễ chịu nhất và sử dụng số đo đó.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/4d/04/23/5e240b689687db12bf8037dd6745c8ac.png\" alt=\"\" width=\"687\" height=\"510\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/d9/5b/be/efe8b2e3c27b177228867baf8925bc8a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d9/5b/be/efe8b2e3c27b177228867baf8925bc8a.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d9/5b/be/efe8b2e3c27b177228867baf8925bc8a.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d9/5b/be/efe8b2e3c27b177228867baf8925bc8a.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d9/5b/be/efe8b2e3c27b177228867baf8925bc8a.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/ac/ea/89/2bad29aea91bd776889ce551c6d5847d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ac/ea/89/2bad29aea91bd776889ce551c6d5847d.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ac/ea/89/2bad29aea91bd776889ce551c6d5847d.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/pr