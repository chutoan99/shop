:114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/0b/2a/e6/327059169feef8a9b91f20fce1637d42.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":365,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eBộ dụng cụ cắt thái và tạo hình rau củ độc đáo Unie UMS51 chắc chắn sẽ là trợ thủ đắc lực hỗ trợ bạn chuẩn bị nguyên liệu những món ăn có tạo hình đẹp mắt, hấp dẫn cho gia đình. \u003c/p\u003e\n\u003cp\u003eThay thế 5 dụng cụ cắt thái thực phẩm\u003c/p\u003e\n\u003cp\u003eUSM51 trang bị đến 5 lưỡi dao: Lưỡi bào nhuyễn, lưỡi bào sợi nhỏ, lưỡi bào sợi to, lưỡi cắt lát mỏng, lưỡi cắt lượn sóng đảm bảo xay nhuyễn hay cắt thái thực phẩm nhanh chóng, tiết kiệm thời gian sơ chế và nấu nướng thực phẩm. \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-llfsr48js05k80\" width=\"1200\" height=\"1200\" alt=\"vn-11134208-7r98o-llfsr48js05k80\" /\u003e\u003c/p\u003e\n\u003cp\u003eNgoài ra có bộ phận giữ rau củ bảo vệ tay giúp quá trình sử dụng trở nên an toàn, tránh làm người dùng bị thương. Khay nhựa dùng để đựng thực phẩm sau khi bào có thể cắt, lưu trữ các lưỡi dao gọn gàng, hạn chế tối đa bị thất lạc sau khi sử dụng.\u003c/p\u003e\n\u003cp\u003eTạo hình rau củ quả dễ dàng\u003c/p\u003e\n\u003cp\u003eChỉ cần thay lưỡi dao, UMS51 cho phép chị em nội trợ sáng tạo và biến tấu rau củ quả từ cắt thái, bào, nghiền đến tạo hình với nhiều hình dạng đẹp mắt và thu hút. Việc trang trí món ăn trở nên dễ dàng, tạo hứng thú nấu ăn và kích thích vị giác của người thưởng thức.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-llfsr48jteq0ff\" width=\"1200\" height=\"1200\" alt=\"vn-11134208-7r98o-llfsr48jteq0ff\" /\u003e\u003c/p\u003e\n\u003cp\u003eLưỡi dao sắc bén \u0026amp; bền bỉ\u003c/p\u003e\n\u003cp\u003eLưỡi dao được làm bằng thép không gỉ, sắc bén có thể cắt, bào nạo tất cả các loại rau củ quả một cách nhanh chóng và an toàn cho người dùng. Thậm chí là xử lý các loại thực phẩm cứng như cà rốt, khoai tây, hành tây và nhiều loại rau củ khác mà không phải lo lắng về việc lưỡi dao bị mòn hoặc gãy.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-llfsr48jutag92\" width=\"1200\" height=\"1200\" alt=\"vn-11134208-7r98o-llfsr48jutag92\" /\u003e\u003c/p\u003e\n\u003cp\u003eChất liệu nhựa ABS và PS an toàn \u0026amp; độ bền cao\u003c/p\u003e\n\u003cp\u003eNgoài lưỡi dao thì các bộ cấu tạo còn lại của bộ dụng cụ UMS51 đều tạo thành từ nhựa ABS và PS an toàn, cho người dùng thoả sức tạo hình rau củ mà vẫn an tâm về chất lượng sản phẩm.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-llfsr48jw7uw54\" width=\"1200\" height=\"1200\" alt=\"vn-11134208-7r98o-llfsr48jw7uw54\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eThông số kỹ thuật \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-llfsr48jxmfc64\" width=\"1200\" height=\"1200\" alt=\"vn-11134208-7r98o-llfsr48jxmfc64\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e#Bocatthucpham #dungcuthairaucu #giadunghot #unie #usm51\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/0b/2a/e6/327059169feef8a9b91f20fce1637d42.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0b/2a/e6/327059169feef8a9b91f20fce1637d42.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/0b/2a/e6/327059169feef8a9b91f20fce1637d42.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0b/2a/e6/327059169feef8a9b91f20fce1637d42.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0b/2a/e6/327059169feef8a9b91f20fce1637d42.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/e7/9b/f5/7b1348ef13ef7ae54d7efa9661da50d5.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e7/9b/f5/7b1348ef13ef7ae54d7efa9661da50d5.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e7/9b/f5/7b1348ef13ef7ae54d7efa9661da50d5.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e7/9b/f5/7b1348ef13ef7ae54d7efa9661da50d5.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e7/9b/f5/7b1348ef13ef7ae54d7efa9661da50d5.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/d8/d9/df/b3260dc533c165721264fb11c59bdfce.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d8/d9/df/b3260dc533c165721264fb11c59bdfce.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d8/d9/df/b3260dc533c165721264fb11c59bdfce.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d8/d9/df/