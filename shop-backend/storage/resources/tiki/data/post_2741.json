3596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/f7/f5/2d/426bb102b472e4b2107e8debe0ddd213.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1912,"all_time_quantity_sold":32,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cdiv id=\"collapse-description\" class=\"desc-collapse showup\"\u003e\n\u003ch2\u003e\u003cspan style=\"font-size: 105%; color: #000000;\"\u003eThông tin sản phẩm:\u003c/span\u003e\u003c/h2\u003e\n\u003cp\u003e\u003cspan style=\"font-size: 120%; color: #000000;\"\u003eTên sản phẩm: Pin sạc AAA Panasonic Eneloop 800mAh BK-4MCCE/2B\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-size: 120%; color: #000000;\"\u003eLà loại pin có chỉ số thất thoát năng lượng thấp, giữ lại 100% năng lượng sau 1 năm sản xuất.và sau 5 năm còn lưu điện đến 65%\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-size: 120%; color: #000000;\"\u003eCó thể sạc lại, tái sử dụng đến 2100 lần.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-size: 120%; color: #000000;\"\u003eSố lần chụp hình (với máy ảnh số) khoảng 600 ảnh.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-size: 120%; color: #000000;\"\u003eCó thể tái sử dụng và an toàn cho môi trường.Có thể sử dụng ngay như pin thông thường mà không cần sạc .\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-size: 120%; color: #000000;\"\u003eAn toàn với môi trường , không có chất độc hại.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-size: 120%; color: #000000;\"\u003eCó thể sử dụng ở những nơi có nhiệt độ xuống thấp như các khu trượt tuyết...\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-size: 120%; color: #000000;\"\u003eXuất xứ : Pin sản xuất tại Nhật Bản ( Panasonic Nhật Bản)\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-size: 120%; color: #000000;\"\u003eTập đoàn Panasonic có trụ sở chính tại Osaka, Nhật Bản, là nhà sản xuất hàng đầu thế giới trong việc chế tạo và phát triển các thiết bị điện tử. Xuất hiện tại Việt Nam từ năm 1996, theo thời gian, Panasonic đã nhanh chóng mở rộng hoạt động kinh doanh khắp 64 tỉnh thành. Panasonic thể hiện cam kết trong hoạt động cung cấp sản phẩm và dịch vụ, dựa trên những ý tưởng làm phong phú cuộc sống và góp phần vào việc phát triển xã hội. Panasonic hiện là một trong những thương hiệu nổi tiếng về nhiều loại sản phẩm gia dụng và điện tử tiêu dùng.\u003c/span\u003e\u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv class=\"desc-collapse showup\"\u003e \u003c/div\u003e\n\u003cdiv class=\"desc-collapse showup\"\u003e\u003cspan style=\"font-size: 105%; color: #000000;\"\u003e\u003cimg class=\"img-responsive\" style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/product/78/bf/55/fccf7bedeeb1f74428f26487b5ef9cdd.jpg\" alt=\"Bộ 2 pin sạc AAA Panasonic Eneloop 800mAh BK-4MCCE/2BV\" width=\"600\" height=\"350\" /\u003e\u003c/span\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-size: 120%; color: #000000;\"\u003eNhằm tiết kiệm chi phí và thay thế cho những loại pin AAA chỉ sử dụng một lần, Panasonic đã cho ra đời loại pin sạc AAA Panasonic Eneloop thế hệ mới cho thời gian sử dụng lâu hơn, là loại pin có chỉ số thất thoát năng lượng thấp, giữ lại 100% năng lượng sau 1 năm sản xuất và sau 5 năm còn lưu điện đến 65%. Pin sạc AAA Panasonic Eneloop thế hệ mới chính là lựa chọn hợp lý cho bạn khi cần một nguồn cung cấp năng lượng mạnh và ổn định cho các thiết bị của mình.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-size: 105%; color: #000000;\"\u003e\u003cimg class=\"img-responsive\" style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/product/8e/3e/df/b717ee160e524e8759910ff7053cf223.jpg\" alt=\"Bộ 2 pin sạc AAA Panasonic Eneloop 800mAh BK-4MCCE/2BV\" width=\"750\" height=\"1000\" /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-size: 105%; color: #000000;\"\u003e\u003cimg class=\"img-responsive\" style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/product/36/11/0f/05a9caf090540f43bafe606c51d802d6.jpg\" alt=\"Bộ 2 pin sạc AAA Panasonic Eneloop 800mAh BK-4MCCE/2BV\" width=\"750\" height=\"750\" /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-size: 105%; color: #000000;\"\u003e\u003cimg class=\"img-responsive\" style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/product/61/15/5c/60002bac1c441ec9b700e44ed3b35694.jpg\" alt=\"Bộ 2 pin sạc AAA Panasonic Eneloop 800mAh BK-4MCCE/2BT\" width=\"750\" height=\"750\" /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003c/div\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-size: 120%; color: #000000;\"\u003eCác khuyến cáo sử dụng:\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color: #000000;\"\u003e\u003cspan style=\"font-size: 120%;\"\u003eTrong quá trình sử dụng, Quý khách hàng vui lòng đảm bảo dùng đúng quy cách, tránh gặp phải những nguy hiểm không đang có.\u003c/span\u003e\u003cspan style=\"font-size: 120%;\"\u003e Vui lòng không dùng răng hay vật cứng để làm thay đổi kích thước, và hy vọng dùng được tiếp. \u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color: #000000;\"\u003e\u003cspan style=\"font-size: 120%;\"\u003eVui lòng mua bộ pin mới để đảm bảo chất lượng và đủ điện tích sử dụng.\u003c/span\u003e\u003cspan style=\"font-size: 120%;\"\u003e Không dùng sản phẩm với lửa.\u003c/span\u003e\u003cspan style=\"font-size: 120%;\"\u003e Không dùng pin Panasonic với các thương hiệu pin khác, hoặc dùng pin than và pin kiềm lẫn lộn. Vì khác loại pin sẽ có những dòng điện khác nhau, có thể gây nguy hiểm.\u003c/span\u003e\u003cspan style=\"font-size: 120%;\"\u003e \u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color: #000000;\"\u003e\u003cspan style=\"font-size: 120%;\"\u003eKhông dùng pin Panasonic để chế biến thức ăn hay thực phẩm, vì không có những chất độc hại nào trong pin có thể can thiệp \u003c/span\u003e\u003cspan style=\"font-size: 120%;\"\u003equá trình sản xuất thực phẩm.\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/f7/f5/2d/426bb102b472e4b2107e8debe0ddd213.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f7/f5/2d/426bb102b472e4b2107e8debe0ddd213.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f7/f5/2d/426bb102b472e4b2107e8debe0ddd213.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f7/f5/2d/426bb102b472e4b2107e8debe0ddd213.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f7/f5/2d/426bb102b472e4b2107e8debe0ddd213.png"},{"base_url":"https://salt.tikicdn.com/ts/product/8c/65/e4/2539cbe287