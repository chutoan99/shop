dn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":24000,"discount_rate":27,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/70/33/36/bd1c45469d85f9535d42aa2093b9412b.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":252,"all_time_quantity_sold":9,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p><strong>Thành phần:</strong> Khẩu trang y tế kháng khuẩn KF94 An Tâm bao gồm 4 lớp: 3 lớp vải lọc PP cao cấp (100% Polypropylene) và 1 lớp vải lọc kháng khuẩn Melt-blown ở giữa.</p>\n<ul>\n<li>Lớp vải lọc PP mặt ngoài bóng mịn, màu sắc trang nhã, mềm mại, có đặc tính lọc bụi, chống thấm, giúp ngăn cản các hạt chất lỏng văng ra khi người bệnh hắt-xì, ho.</li>\n<li>Lớp vải lọc PP mặt trong tinh khiết, màu trắng, mịn màng, không lông tơ gây ngứa, không gây dị ứng.</li>\n<li>Lớp vải lọc Melt-Blown kháng khuẩn ở giữa, màu trắng, không thấm nước: có tác dụng lọc bụi siêu mịn, kháng khuẩn, ngăn ngừa lây nhiễm bệnh qua đường hô hấp, là thành phần quan trọng nhất của khẩu trang.</li>\n<li>Thiết kế 4D ôm sát khuôn mặt, không gian thở rộng rãi, thoải mái, vừa đảm bảo độ kín vừa mang tính thời trang, sang trọng.</li>\n<li>Không lem son môi, chống mờ kính.</li>\n</ul>\n<p><img src=\"https://salt.tikicdn.com/ts/tmp/06/60/98/b07201ec16e4b10c6d5362d1dde91215.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<ul>\n<li><strong>Thanh nẹp mũi được sản xuất từ nhựa nguyên sinh, không mùi, dẻo dai và độ dày vừa phải.</strong></li>\n</ul>\n<p><img src=\"https://salt.tikicdn.com/ts/tmp/24/0b/bf/93e86fbcbd15c465921041e111f6a21f.jpg\" alt=\"\" width=\"750\" height=\"720\" /></p>\n<p> </p>\n<ul>\n<li>Thun đeo tai: bền chắc, có độ co giãn tốt, không gây đau tai khi sử dụng trong thời gian dài.</li>\n</ul>\n<p> </p>\n<p><img src=\"https://salt.tikicdn.com/ts/tmp/b2/14/3f/ab7f41b6ca4d6ba22d09c342bc188eed.jpg\" alt=\"\" width=\"750\" height=\"924\" /></p>\n<p> </p>\n<ul>\n<li>Màu sắc: trắng, xám, đen.</li>\n</ul>\n<p> </p>\n<p><img src=\"https://salt.tikicdn.com/ts/tmp/1b/39/59/3741834a30fd1c88695dbfd826f16b48.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p> </p>\n<ul>\n<li><strong>Đóng gói: 10 Cái/Túi.</strong></li>\n</ul>\n<p> </p>\n<p><strong><img src=\"https://salt.tikicdn.com/ts/tmp/60/41/2e/0439b3cc6488744a823d72c866f26981.jpg\" alt=\"\" width=\"750\" height=\"975\" /></strong></p>\n<ul>\n<li>Sản phẩm đạt tiêu chuẩn ISO 9001:2015 và  đã được kiểm định bởi trung tâm Quatest 3 .</li>\n<li><strong>An Tâm: An Toàn - Thoải Mái.</strong></li>\n</ul><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/70/33/36/bd1c45469d85f9535d42aa2093b9412b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/70/33/36/bd1c45469d85f9535d42aa2093b9412b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/70/33/36/bd1c45469d85f9535d42aa2093b9412b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/70/33/36/bd1c45469d85f9535d42aa2093b9412b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/70/33/36/bd1c45469d85f9535d42aa2093b9412b.jpg"},{"base_u