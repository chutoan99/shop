,"discount_rate":0,"rating_average":5,"review_count":23,"review_text":"(23)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/d5/f4/c5/7922a17a8210f37d8e900cf65ab9d640.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1979,"all_time_quantity_sold":45,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp class=\"MsoNormal\" style=\"margin: 0in 0in 0.0001pt; font-size: medium; font-family: 'Times New Roman', serif;\"\u003e\u003cstrong\u003e\u003cspan style=\"font-family: Times;\"\u003eDây nịt nam - thắt lưng nam thương hiệu Sam Leather \u003c/span\u003e\u003c/strong\u003e\u003cstrong\u003e\u003cspan style=\"font-family: Times;\"\u003eSFDN001SB\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"margin-right: 0in; margin-left: 0in; font-size: medium; font-family: 'Times New Roman', serif;\"\u003e\u003cspan lang=\"VI\" style=\"font-family: Times;\"\u003e\u003cstrong\u003eSản phẩm được gia công tỉ mỉ và tinh xảo\u003c/strong\u003e. \u003cstrong\u003eĐạt tiêu chuẩn xuất khẩu Nhật và Châu Âu\u003c/strong\u003e. \u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"margin: 0in 0in 15pt; font-size: medium; font-family: 'Times New Roman', serif; text-align: justify;\"\u003e\u003cspan lang=\"VI\" style=\"font-family: Times;\"\u003eMặt khóa: làm bằng inox 316 đúc nguyên khối cao cấp 100% đảm bảo độ bền đẹp, không han gỉ, không bong tróc với thời gian, Mặt khóa thể dễ dàng tùy chỉnh kích cỡ cho phù hợp với vóc dáng cơ thể.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"margin: 0in 0in 15pt; font-size: medium; font-family: 'Times New Roman', serif;\"\u003e\u003cspan lang=\"VI\" style=\"font-family: Times;\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/59/0d/64/37a1eac1285ff051c2934aff3bd81f40.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003cbr /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"margin: 0in 0in 15pt; font-size: medium; font-family: 'Times New Roman', serif;\"\u003e\u003cspan lang=\"VI\" style=\"font-family: Times;\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/22/d2/75/ce1240e3add8b284c4974b4b51265a6d.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"margin: 0in 0in 15pt; font-size: medium; font-family: 'Times New Roman', serif;\"\u003e\u003cspan lang=\"VI\" style=\"font-family: Times;\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/da/57/4a/2a28fc839dd84d80846bd66cf35ab52a.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"margin: 0in 0in 3.75pt; font-size: medium; font-family: 'Times New Roman', serif;\"\u003e\u003cspan lang=\"VI\" style=\"font-family: Times;\"\u003e\u003cstrong\u003eChất liệu dây:\u003c/strong\u003e Sản phẩm làm bằng da bò nguyên miếng cao cấp theo quy trình khép kín thuộc da thảo mộc 100% nhập khẩu, đường may được gia công tỉ mỉ, tinh xảo và tinh tế.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"margin: 0in 0in 15pt; font-size: medium; font-family: 'Times New Roman', serif; text-align: justify;\"\u003e\u003cspan lang=\"VI\" style=\"font-family: Times;\"\u003eDây nịt làm từ chất liệu da thật không bong nổ, bền màu. Kích thước dây(D*R): 110 – 125 *3.5cm.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"margin: 0in 0in 15pt; font-size: medium; font-family: 'Times New Roman', serif;\"\u003e\u003cspan lang=\"VI\" style=\"font-family: Times;\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/60/4d/90/cf3155d4f81ebbea74e8a6f5af4a19ea.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"margin: 0in 0in 15pt; font-size: medium; font-family: 'Times New Roman', serif; text-align: justify;\"\u003e\u003cspan lang=\"VI\" style=\"font-family: Times;\"\u003eMột chiếc thắt lưng da thật không trộn lẫn PU sẽ góp phần tạo cá tính, phong cách cũng như khẳng định khiếu thẩm mỹ của bạn.  \u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"margin: 0in 0in 15pt; font-size: medium; font-family: 'Times New Roman', serif; text-align: justify;\"\u003e\u003cu\u003e\u003c/u\u003e\u003cspan lang=\"VI\" style=\"font-family: Times;\"\u003eDây nịt nam - thắt lưng nam là một sản phẩm không thể thiếu cho hầu hết cánh mày râu Việt Nam sản phẩm luôn luôn bên cạnh cánh mày râu mỗi khi bước ra ngoài. Dây nịt nam - thắt lưng nam có thể nói là vật bất ly thân của mỗi cánh mày râu.\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\" style=\"margin: 0in 0in 0.0001pt; font-size: medium; font-family: 'Times New Roman', serif;\"\u003e\u003cstrong\u003e\u003cspan lang=\"VI\" style=\"font-family: Times;\"\u003eDây nịt nam - thắt lưng nam thương hiệu Sam Leather SFDN001SB      \u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\" style=\"margin: 0in 0in 0.0001pt; font-size: medium; font-family: 'Times New Roman', serif; text-align: justify; line-height: 15.75pt;\"\u003e\u003cspan lang=\"VI\" style=\"font-family: Times;\"\u003eDễ dàng kết hợp cùng quần Jeans, Kaki, áo Sơ Mi, áo thun, nhằm mang lại vẻ ngoài lịch thiệp và sang trọng cho đấng mày râu.\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\" style=\"margin: 0in 0in 0.0001pt; font-size: medium; font-family: 'Times New Roman', serif;\"\u003e\u003cspan lang=\"VI\" style=\"font-family: Times;\"\u003e \u003c/span\u003e\u003cspan lang=\"VI\" style=\"font-family: Times;\"\u003e– Sản phẩm có hộp đựng kèm theo, thích hợp làm món quà tặng sang trọng. \u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"margin: 0in 0in 15pt; font-size: medium; font-family: 'Times New Roman', serif; text-align: justify;\"\u003e\u003cspan lang=\"VI\" style=\"font-family: Times;\"\u003e– Dây nịt và mặt khóa đều được khắc logo chính hãng. \u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"margin: 0in 0in 15pt; font-size: medium; font-family: 'Times New Roman', serif; text-align: justify;\"\u003e\u003cstrong style=\"font-family: -webkit-standard;\"\u003e\u003cspan lang=\"VI\" style=\"font-size: 12pt; font-family: Times;\"\u003eBộ sản phẩm bao gồm hộp đựng, phụ kiện tháo mặt dây, thẻ bảo hành chính hãng\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/d5/f4/c5/7922a17a8210f37d8e900cf65ab9d640.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d5/f4/c5/7922a17a8210f37d8e900cf65ab9d640.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d5/f4/c5/7922a17a8210f37d8e900cf65ab9d640.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d5/f4/c5/7922a17a8210f37d8e900cf65ab9d640.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d5/f4/c5/7922a17a8210f37d8e900cf65ab9d640.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/b2/5b/21/01b20f2c20746735ac546230e5c81e36.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b2/5b/21/01b20f2c20746735ac546230e5c81e36.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b2/5b/21/01b20f2c20746735ac546230e5c81e36.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/pro