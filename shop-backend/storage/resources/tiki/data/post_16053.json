":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/62/8a/72/73c82cf5ca5db2b0ef6008ebd01727bf.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":400,"all_time_quantity_sold":11,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2 style=\"text-align:center;\"\u003eGậy tự sướng tripod Yunteng YT-9928 đa năng có remote chụp ảnh\u003c/h2\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/f7/95/35/2465b952d7511af92ae9ea9f706b15b8.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eGậy chụp hình đa năng kèm chân  YUNTENG YT-9928, mẫu gậy đa năng mới nhất của hãng.\u003c/li\u003e\n\u003cli\u003eVới thiết kế mới nhỏ gọn tiền dùng hơn so với các phiên bản cũ.\u003c/li\u003e\n\u003cli\u003eGậy tự sướng Bluetooth Tripod đa năng YUNTENG YT 9928, kích thước nhỏ gọn chỉ 20.5cm và kéo dài tối đa tới 100cm.\u003c/li\u003e\n\u003cli\u003eCó tích hợp sẵn Remote chụp hình từ xa cho điện thoại.\u003c/li\u003e\n\u003cli\u003eTương thích với các máy Android và IOS, dùng pin sạc tiện dùng với pin dự phòng, sạc điện thoại, khi sạc đầy có thể chụp 700-1000 tấm hình.\u003c/li\u003e\n\u003cli\u003eGậy chụp hình đa năng kèm chân có thân cây làm từ hợp kim cứng cáp.\u003c/li\u003e\n\u003cli\u003eĐặc biệt trên mẫu mới này nhà sản xuất làm dạng rút dễ sử dụng hơn (dạng xoay) trên VCT-1688 hay YT-2288. Trên thân cây được làm 2 rãnh chống xoay đối xứng nhau chắc chắn và không bị lắc.\u003c/li\u003e\n\u003cli\u003ePhần chân của gậy đa năng được làm chất liệu nhựa cứng giống với chân YT-238. Độ mở giữa các chân là 19cm. Trên chân có trang bị máng gài remote tiện dùng khi không dùng tránh thất lạc.\u003c/li\u003e\n\u003cli\u003eĐầu gắn của Gậy tự sướng Bluetooth Tripod đa năng YUNTENG YT 9928 có ren chuẩn 1/4″. Dùng gắn các mẫu máy ảnh, máy quay cỡ nhỏ hoặc Action Cam Đầu ren có thể chỉnh xoay 360 độ, có tích hợp gương nhỏ để chụp hình với camera sau.\u003c/li\u003e\n\u003cli\u003eĐầu kẹp điện thoại với thiết kế mới có thể gập lại, dạng xoay có thể gắn các máy kích thước từ 3.5 inch tới 6.5 inch mà vẫn đảm bảo vô cùng chắc chắn\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/62/8a/72/73c82cf5ca5db2b0ef6008ebd01727bf.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/62/8a/72/73c82cf5ca5db2b0ef6008ebd01727bf.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/62/8a/72/73c82cf5ca5db2b0ef6008ebd01727bf.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/62/8a/72/73c82cf5ca5db2b0ef6008ebd01727bf.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/62/8a/72/73c82cf5ca5db2b0ef6008ebd01727bf.png"},{"base_url":"https://salt.tikicdn.com/ts/product/8d/98/9f/651ef8c9460b2ab294fdc20e7951c660.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/produc