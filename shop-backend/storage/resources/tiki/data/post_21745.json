f":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":3.8,"review_count":4,"review_text":"(4)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/13/e7/66/2d398ef67886650baf3b5f8c20d0ca62.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2406,"all_time_quantity_sold":33,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003eSữa Asumiru Phát Triển Chiều Cao (Từ 3 đến 16 tuổi) \u003c/strong\u003eđáp ứng tối đa nhu cầu về dinh dưỡng cho trẻ, không chỉ ở các giai đoạn vàng mà còn duy trì đều đặn cả một quá trình từ 3 đến 16 tuổi, tập trung cung cấp các Vitamin, Khoáng chất, giúp trẻ hoàn thiện cả về trí tuệ, thể chất, đặc biệt giúp phát triển tối ưu chiều cao cho trẻ.\u003c/li\u003e\n\u003cli\u003ePhối hợp hoàn hảo 5 thành phần thúc đẩy tăng trưởng: Vitamin D, Canxi, Magie, Sắt, Kẽm. Trong đó thành phần canxi phong phú như Canxi Casein, Canxi pantothenate, canxi tự nhiên trong vừng, bột cá trích không chỉ giúp tăng chiều dài mấu xương mà còn giúp tạo các hormon và hồng cầu khỏe mạnh, hỗ trợ quá trình vận động thể chất cho trẻ, giúp bé tăng trưởng chiều cao và tăng sức đề kháng.\u003c/li\u003e\n\u003cli\u003eThành phần DHA trong dầu cá giúp trẻ thông minh hơn, phát triển trí não và thị lực đi kèm với thành phần tế bào gốc noãn thực vật Placenta chống ô xy hóa hiệu quả, tăng cường miễn dịch, tăng khả năng ghi nhớ.\u003c/li\u003e\n\u003cli\u003eMenaquinone tự nhiên (MK7) được chiết xuất từ món natto của người Nhật. Trải qua nhiều thế hệ, người Nhật dùng natto như một món ăn hàng ngày nhằm tăng cường sức khỏe tim mạch và xương cốt mà không hề có tác dụng bất lợi nào. Đây là thành phần có vai trò quyết định trong việc hình thành và giúp xương dài tối đa.\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/13/e7/66/2d398ef67886650baf3b5f8c20d0ca62.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/13/e7/66/2d398ef67886650baf3b5f8c20d0ca62.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/13/e7/66/2d398ef67886650baf3b5f8c20d0ca62.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/13/e7/66/2d398ef67886650baf3b5f8c20d0ca62.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/13/e7/66/2d398ef67886650baf3b5f8c20d0ca62.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/d4/96/04/4d40dc2949144e7108cfdcf6bae523cd.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d4/96/04/4d40dc2949144e7108cfdcf6bae523cd.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d4/96/04/4d40dc2949144e7108cfdcf6bae523cd.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d4/96/04/4d40dc2949144e7108cfdcf6bae523cd.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d4/96/04/4d40dc2949144e7108cfdcf6bae523cd.jpg"}],"warranty_policy":null,"brand":{"id":160057,"name":"Asumiru","slug":"asumiru"},"current_seller":{"id":8084,"sku":"1621247748099","name":"Nature Beauty","link":"https://tiki.vn/cua-hang/nature-beauty","logo":"7b/60/ee/2edf00ecf43ec68982650cad55de48a3.jpg","price":880000,"product_id":"11917122","store