_average":4.5,"review_count":19,"review_text":"(19)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/e0/f6/8c/e1037cf9bb5177b6583dcc724dba8acc.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":523,"all_time_quantity_sold":78,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eQuạt máy Xiaomi Smart Fan 2 Lite sẽ đem làn gió mát lành tới cho gia đình bạn. Sử dụng hệ thống 7 cánh quạt, sản phẩm dễ dàng lùa gió lan tỏa khắp gian phòng nhờ động cơ mạnh mẽ và tiết kiệm điện. Các công nghệ hiện đại mà Xiaomi đem đến như chế độ ngủ, ba tốc độ quạt và trợ lý ảo sẽ cho bạn trải nghiệm chưa từng thấy ở các mẫu quạt máy khác.\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cimg src=\"https://fptshop.com.vn/Uploads/images/2015/Tin-Tuc/BaoPK/Qualcomm%20ra%20mat%20Snapdragon%20820/Quat-may-dung-xiaomi-smart-fan-2-lite-1.JPG\" alt=\"Quạt máy đứng Xiaomi Smart Fan 2 Lite 1\" width=\"750\" height=\"421\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003e7 cánh quạt với khả năng lùa gió hiệu quả\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eCách thiết kế độc đáo của Xiaomi Smart Fan 2 Lite giúp tăng lưu lượng gió tối đa để đẩy không khí lan tỏa khắp không gian phòng của bạn. Trong đó, hệ thống gồm cánh quạt được tối ưu nhằm đưa gió đi xa hơn trong phạm vi rộng hơn. Sự phối hợp nhịp nhàng giữa động cơ mạnh mẽ và 7 cánh quạt tạo nên làn gió đa chiều nhẹ nhàng, mang lại cảm giác thư thái và tự nhiên hơn hẳn các loại quạt trên thị trường.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://fptshop.com.vn/Uploads/images/2015/Tin-Tuc/BaoPK/Qualcomm%20ra%20mat%20Snapdragon%20820/Quat-may-dung-xiaomi-smart-fan-2-lite-3.JPG\" alt=\"Quạt máy đứng Xiaomi Smart Fan 2 Lite 1 1\" width=\"750\" height=\"421\" /\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003e3 cấp độ gió để lựa chọn, cài đặt qua smartphone\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eThay vì chạy đi tìm bộ remote mỗi khi muốn tinh chỉnh hướng gió và mức gió như ý muốn, bạn có thể thực hiện điều này ngay trên smartphone của mình thông qua ứng dụng Mi Home có thể tải về trên cả iOS và Android. Sau khi tải ứng dụng về và ghép đôi, bạn sẽ dễ dàng thao tác để điều chỉnh giữa 3 cấp độ gió của Xiaomi Smart Fan 2 Lite, đồng thời lựa chọn các tính năng như gió tự nhiên hoặc thổi trực tiếp.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://fptshop.com.vn/Uploads/images/2015/Tin-Tuc/BaoPK/Qualcomm%20ra%20mat%20Snapdragon%20820/Quat-may-dung-xiaomi-smart-fan-2-lite-9.JPG\" alt=\"3 cấp độ gió để lựa chọn, cài đặt qua smartphone 1\" width=\"750\" height=\"421\" /\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eĐộng cơ DC mạnh mẽ và tiết kiệm điện\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eHệ thống động cơ mà Xiaomi trang bị cho Smart Fan 2 Lite là động cơ DC dây đồng, cho hiệu suất vận hành cao và kéo dài tuổi thọ sử dụng hơn so với các loại quạt máy động cơ dây nhôm. Ưu điểm của động cơ DC là đem lại tốc độ thổi gió ổn định, đặc biệt tiêu thụ điện năng rất ít. Bí quyết giúp Xiaomi làm được điều này là thiết kế cánh quạt giảm ma sát với không khí khi vận hành, từ đó khiến động cơ giảm bớt năng lượng tiêu hao cũng như lọc bỏ tiếng ồn.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://fptshop.com.vn/Uploads/images/2015/Tin-Tuc/BaoPK/Qualcomm%20ra%20mat%20Snapdragon%20820/Quat-may-dung-xiaomi-smart-fan-2-lite-2.JPG\" alt=\"Động cơ DC mạnh mẽ và tiết kiệm điện 1\" width=\"750\" height=\"421\" /\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eRa lệnh bằng giọng nói tiện dụng\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eNgoài cơ chế điều khiển bằng ứng dụng trên smartphone, quạt máy Smart Fan 2 Lite còn hỗ trợ người dùng ra lệnh trực tiếp bằng giọng nói thông qua hai trợ lý ảo là Amazon Alexa hoặc Google Assistant. Với khẩu lệnh đơn giản, bạn chỉ cần nói trực tiếp yêu cầu của mình như tăng cấp độ gió hoặc kích hoạt tính năng mong muốn. Thoải mái tận hưởng những công nghệ hiện đại nhất để nâng cao chất lượng cuộc sống cho gia đình.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/09/11/af/d51ebeca1e197afe797d1f81362bdf13.jpg\" alt=\"Ra lệnh bằng giọng nói tiện dụng 1\" width=\"750\" height=\"421\" /\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eThiết lập độ cao dễ dàng để sử dụng mọi nơi\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eXiaomi Smart Fan 2 Lite phiên bản 2021 sở hữu chân đế linh hoạt, hỗ trợ người dùng thiết lập chiều cao dễ dàng tùy theo hoàn cảnh sử dụng. Trong đó, bạn có thể kéo dài chân quạt lên mức 1 mét để dùng trong phòng khách hoặc rút gọn còn 0,64 mét nếu đặt trên kệ hoặc bàn sao cho tận hưởng được 100% sức gió mà quạt thổi ra.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/86/c0/d5/f177e61863c011d55c7b2f9647eb8126.jpg\" alt=\"Thiết lập độ cao dễ dàng để sử dụng mọi nơi 1\" width=\"750\" height=\"421\" /\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eGóc thổi siêu rộng 90 độ, tăng lưu thông khí\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eQuạt máy Xiaomi Smart Fan 2 Lite có cơ chế điều chỉnh hướng gió thông qua góc xoay ngang 90 độ và độ nghiêng lên/xuống 36 độ. Nhờ đó, sản phẩm không chỉ đem tới luồng gió mát lành cho cả gia đình mà còn tăng khả năng lưu thông không khí, khiến cho không gian sống trở nên thoáng đãng hơn. Sự tiện dụng trong cơ chế xoay giúp thiết bị phục vụ người dùng một cách tốt nhất.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/60/2f/ed/c35f54e75c41b1d318df0548a060c7d7.jpg\" alt=\"Góc thổi siêu rộng 90 độ, tăng lưu thông khí 1\" width=\"750\" height=\"421\" /\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eThiết kế tối giản với trọng lượng nhẹ nhàng\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eLần đầu nhìn thấy Smart Fan 2 Lite, bạn sẽ lập tức cảm nhận được triết lý thiết kế tối giản đặc trưng của Xiaomi trên sản phẩm này. Với tone màu chủ đạo là màu trắng thanh lịch và loại bỏ mọi chi tiết rườm rà, quạt Smart Fan 2 Lite rút gọn trọng lượng chỉ còn 3.4 kg, chủ nhân của chiếc quạt có thể cầm nắm và di chuyển dễ dàng với một tay.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/ee/1c/08/b37bebf0b25745915fd6230fd6807c4b.jpg\" alt=\"Thiết kế tối giản với trọng lượng nhẹ nhàng 1\" width=\"750\" height=\"421\" /\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eHoàn thiện tối ưu, bền bỉ trong từng chi tiết\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eTrước khi xuất xưởng tới tay người dùng, quạt đứng Xiaomi Smart Fan 2 Lite đã được kiểm định nghiêm ngặt về chất lượng ở từng chi tiết nhỏ nhằm đảm bảo độ bền suốt vòng đời sử dụng. Trong đó, Xiaomi cho biết chiếc quạt có thể thoải mái điều hướng ngang tới 5.000 lần, chỉnh độ nghiêng lên/xuống 1.000 lần, nút nguồn đạt độ bền 10.000 lần nhấn và các nút chức năng khác cũng có thể bật/tắt trong 10.000 lần.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/b5/ab/a6/ee689f46645ff1c2ffb63aab0769f98e.jpg\" alt=\"Hoàn thiện tối ưu, bền bỉ trong từng chi tiết 5\" width=\"750\" height=\"421\" /\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eSử dụng đơn giản, dễ dàng tháo lắp\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eCó cơ chế hoạt động hiện đại với nhiều chức năng thông minh nhưng cấu trúc của quạt Xiaomi Smart Fan 2 Lite lại rất đơn giản. Các bộ phận như động cơ, lồng quạt, cánh quạt, chân đế và dây điện đều có thiết kế tối giản nhằm giúp thao tác tháo lắp trở nên dễ dàng nhất có thể.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://fptshop.com.vn/Uploads/images/2015/Tin-Tuc/BaoPK/Qualcomm%20ra