":36,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/9d/d5/0a/4b410cacfd14555c9599bd091cd7ed0b.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2126,"all_time_quantity_sold":3,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/da/e0/a5/15f87d4654120f239d22657993860e28.jpg\" alt=\"Bếp Gas Âm Đôi Mặt Kính Sunhouse - MMB6632 - Hàng chính hãng\" width=\"750px\" height=\"500px\" /\u003e\u003c/p\u003e\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/9d/46/b0/fc52ed426225d200a687ee24e765f0c0.jpg\" alt=\"Bếp Gas Âm Đôi Mặt Kính Sunhouse - MMB6632 - Hàng chính hãng\" width=\"750px\" height=\"500px\" /\u003e\u003c/p\u003e\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/d4/ae/70/c8fd1832e94580a3ccd70bf2561c0363.jpg\" alt=\"Bếp Gas Âm Đôi Mặt Kính Sunhouse - MMB6632 - Hàng chính hãng\" width=\"750px\" height=\"500px\" /\u003e\u003c/p\u003e\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/0e/2b/ed/42ee7a711ec553333f44013980936fc8.jpg\" alt=\"Bếp Gas Âm Đôi Mặt Kính Sunhouse - MMB6632 - Hàng chính hãng\" width=\"750px\" height=\"500px\" /\u003e\u003c/p\u003e\u003ch5\u003eKiểu dáng sang trọng với mặt kính cao cấp\u003c/h5\u003e\n\u003cp\u003e\u003cstrong\u003eBếp Gas Âm Mặt Kính Sunhouse - MMB6632\u003c/strong\u003e có kiểu dáng sang trọng, mặt kính toàn phần đen bóng. Đây là loại kính chịu nhiệt, chịu lực tốt, bề mặt trơn bóng nên rất dễ dàng lau chùi, vệ sinh. Sunhouse - MMB6632 được thiết kế lắp âm vừa tiết kiệm diện tích, vừa góp phần tạo nên vẻ hiện đại cho căn bếp của bạn.\u003c/p\u003e\n\u003ch5\u003eKiềng bếp độc lập, tráng men siêu bền\u003c/h5\u003e\n\u003cp\u003eKiềng bếp 5 chân vững chãi bằng thép nên có khả năng chịu lực và chịu nhiệt tốt, không bị hao mòn theo thời gian. Bề mặt kiềng tráng men, hạn chế bám bẩn và dễ lau chùi.\u003c/p\u003e\n\u003cp\u003eKiềng độc lập có thể tháo rời, tiện lợi cho việc lau chùi vệ sinh.\u003c/p\u003e\n\u003ch5\u003eĐầu đốt bằng đồng thau \u0026amp; họng bếp inox cao cấp\u003c/h5\u003e\n\u003cp\u003eĐầu được thiết kế với nhiều khe nhỏ giúp ngọn lửa tỏa đều, nấu ăn nhanh, được trang bị cả đầu hâm nên rất tiết kiệm gas. Được làm từ đồng thau chống bào mòn sử dụng lâu dài, đầu đốt sẽ không bị biến dạng dù cho việc sử dụng dưới nhiệt độ cao trong một khoảng thời gian dài khi ninh, hầm,… Họng bếp bằng thép không gỉ, không sinh ra muội đen, cho ngọn lửa xanh không đen đáy nồi, tiết kiệm nhiên liệu và an toàn khi sử dụng.\u003c/p\u003e\n\u003ch5\u003eHệ thống đánh lửa bằng pin\u003c/h5\u003e\n\u003cp\u003eBếp có hệ thống đánh lửa bằng PIN rất an toàn, tiện lợi. Bạn dễ dàng bật tắt và điều chỉnh lửa bằng 2 núm vặn cực nhạy, chỉ cần xoay 1 lần là lửa đã cháy, không cần bật nhiều lần gây rò rỉ và hao phí gas.\u003c/p\u003e\n\u003ch5\u003eHai lò nấu tiện lợi\u003c/h5\u003e\n\u003cp\u003eBếp có 2 lò nấu rộng rãi với giúp bạn chế biến được nhiều món ăn cùng lúc. Bạn có thể vừa nấu canh, vừa chiên xào thực phẩm một cách thật thoải mái.\u003c/p\u003e\n\u003ch5\u003eTiết kiệm nhiên liệu\u003c/h5\u003e\n\u003cp\u003eBếp có ngọn lửa tập trung, tỏa đều và dễ dàng điều chỉnh to nhỏ phù hợp với nhu cầu nấu nướng. Bếp được trang bị đầu hâm cho ngọn lửa nhỏ khi nấu, giúp tiết kiệm nhiên liệu nên rất thích hợp để hâm nóng thức ăn hoặc làm các món hầm, ninh ở nhiệt độ thấp trong thời gian dài.\u003c/p\u003e\n\u003ch5\u003ePhù hợp với mọi loại nồi chảo\u003c/h5\u003e\n\u003cp\u003eBếp phù hợp với mọi loại nồi chảo, kể cả chảo sâu lòng, chảo xào cỡ lớn, nồi gang, nồi đất hay nồi thủy tinh. Vì vậy bạn dễ dàng chế biến thật nhiều món ăn khác nhau cho gia đình.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/9d/d5/0a/4b410cacfd14555c9599bd091cd7ed0b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/9d/d5/0a/4b410cacfd14555c9599bd091cd7ed0b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/9d/d5/0a/4b410cacfd14555c9599bd091cd7ed0b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9d/d5/0a/4b410cacfd14555c9599bd091cd7ed0b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9d/d5/0a/4b410cacfd14555c9599bd091cd7ed0b.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/e6/a1/a4/9db3f31328aeefd628f5a2185adf077c.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e6/a1/a4/9db3f31328aeefd628f5a2185adf077c.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e6/a1/a4/9db3f31328aeefd628f5a2185adf077c.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e6/a1/a4/9db3f31328aeefd628f5a2185adf077c.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e6/a1/a4/9db3f31328aeefd628f5a2185adf077c.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/f5/5a/33/86952e2e057769160a1e4385bfa10c4a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f5/5a/33/86952e2e057769160a1e4385bfa10c4a.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f5/5a/33/86952e2e057769160a1e4385bfa10c4a.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f5/5a/33/86952e2e057769160a1e4385bfa10c4a.jpg","thumbnail_url":"http