eship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":60000,"discount_rate":36,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/b1/6c/24/9a6617a5c58b77abe8bf72e3f3126382.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1010,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eCombo Sữa tắm nước hoa Bergami - Tinh Chất nước hoa Pháp 330ml và Dung dịch vệ sinh phụ nữ Bergami kháng khuẩn 130ml\u003c/p\u003e\n\u003cp\u003eSỮA TẮM HƯƠNG NƯỚC HOA BERGAMI\u003c/p\u003e\n\u003cp\u003eHIỆU QUẢ SỬ DỤNG\u003c/p\u003e\n\u003cp\u003eMùi hương nước hoa tinh tế quyện hòa, giúp lưu giữ mùi hương thơm mát, quyến rũ trên da bạn lên đến 12 giờ sau khi tắm.\u003c/p\u003e\n\u003cp\u003eBổ sung Vitamin C và khoáng chất giúp nuôi dưỡng, X2 Dưỡng ẩm độc đáo giúp da giữ được sự ẩm mượt và cân bằng độ PH cho da, X2 làn da trắng sáng, mịn màng.\u003c/p\u003e\n\u003cp\u003eSữa tắm dạng Gel tạo bọt mịn nhẹ nhàng, làm sạch sâu từng bụi bẩn, giúp nàng tự tin tỏa sáng mọi khoảnh khắc.\u003c/p\u003e\n\u003cp\u003eDUNG DỊCH VỆ SINH TRẦU KHÔNG TRÀ XANH\u003c/p\u003e\n\u003cp\u003eHIỆU QUẢ SỬ DỤNG\u003c/p\u003e\n\u003cp\u003eSiêu thanh mát, siêu kháng khuẩn, siêu dịu nhẹ\u003c/p\u003e\n\u003cp\u003eSạch nhẹ nhàng phần phụ, khử mùi hôi, ngứa, rát , khó chịu, dưỡng da, vệ sinh vùng kín hàng ngày thời kỳ kinh nguyệt, thời kì mang thai, trước và sau khi sinh. Giúp kháng khuẩn.\u003c/p\u003e\n\u003cp\u003eDuy trì độ ẩm cho da. Chăm sóc phụ khoa trong các trường hợp: viêm, ngứa, huyết trắng - khí hư, nhiễm nấm candida\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/b1/6c/24/9a6617a5c58b77abe8bf72e3f3126382.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b1/6c/24/9a6617a5c58b77abe8bf72e3f3126382.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b1/6c/24/9a6617a5c58b77abe8bf72e3f3126382.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b1/6c/24/9a6617a5c58b77abe8bf72e3f3126382.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b1/6c/24/9a6617a5c58b77abe8bf72e3f3126382.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/ac/d3/99/3bff11b9bb879aa29eb5ce0e6a3476cb.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ac/d3/99/3bff11b9bb879aa29eb5ce0e6a3476cb.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ac/d3/99/3bff11b9bb879aa29eb5ce0e6a3476cb.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ac/d3/99/3bff11b9bb879aa29eb5ce0e6a3476cb.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ac/d3/99/3bff11b9bb879aa29eb5ce0e6a3476cb.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/21/fb/1a/0404d845c028c549a383a37b50408b03.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/21/fb/1a/0404d845c028c549a383a37b50408b03.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/21/fb/1a/0404d845c028c549a383a37b50408b03.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/21/fb/1a/0404d845c028c549a383a37b50408b03.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/21/