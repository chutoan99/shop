ref":null,"text":null}],"badges_v3":[{"placement":"pdp_badge","code":"text_badge","type":"text_badge","index":0,"icon":null,"icon_width":0,"icon_height":0,"text_color":"#FFF0F1","background_color":"#D93843","href":null,"text":"9.9"},{"placement":"pdp_badge","code":"is_hero","type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"freeship_xtra","type":"pdp_icon_badge","index":2,"icon":"https://salt.tikicdn.com/ts/upload/be/67/48/04a82ab8df178e1a13bde38316081865.png","icon_width":91,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":true,"return_reason":"any_reason"}},"discount":3836000,"discount_rate":51,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/c7/d8/9b/dffed6e5dadc8ca89c252dd1be17cda2.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":735,"all_time_quantity_sold":3,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eLưu Ý: Máy Hút Bụi Redroad V17 Lite thuộc hệ sinh thái của Xiaomi, Redroad là thương hiệu con của công ty mẹ Xiaomi. Hệ sinh thái Xiaomi hiện có các dòng như Dreame, Redroad, Redkey, Mijia... Do đó sẽ không có Logo Xiaomi mà chỉ có Redroad, tránh xảy ra khiếu nại quý khách vui lòng đọc kỹ thông tin nhà bán mô tả.\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eMáy hút bụi không dây cầm tay Redroad V17 Lite \u003c/strong\u003elà phiên bản rút gọn mới của Redroad V17. Sở hữu lực hút cực mạnh lên tới 26,500 Pa, thiết kế chổi lăn và lõi lọc HEPA kép độc đáo cùng giá bán vô cùng phải chăng, Redroad V17 Lite chính là một lựa chọn hoàn hảo nếu bạn đang có nhu cầu muốn mua 1 chiếc máy hút bụi cầm tay cho mình hoặc gia đình.\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"WebpImg__StyledImg-sc-h3ozu8-0 fWjUGo\" title=\"\" src=\"https://redroad-eu.oss-eu-central-1.aliyuncs.com/uploads/20220323/0e70db9e9bb2de3380e63977cbc06437.jpg\" alt=\"\" width=\"750\" height=\"444\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eĐiểm vượt trội của máy hút bụi không dây Redroad V17 Lite\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cp\u003eLực hút vô địch lên đến 26.500PA, hút sạch mọi loại bụi bẩn, kể cả bụi mịn có kích thước nhỏ\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eDung lượng pin 4000 mAh, làm việc liên tục tới 60 phút\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eChổi chính dạng kép, tăng cường khả năng làm sạch bụi\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eLõi lọc Hepa dạng kép, có thể lọc được bụi mịn 0,1 μm ( điều mà các máy hút bụi trên thị trường không làm được): làm sạch hoàn toàn bụi gây ảnh hưởng tới sức khỏe. Đặc biệt hơn, Lõi lọc còn được làm bằng than hoạt tính, giúp lọc sạch vi khuẩn, mùi hôi có trong sàn hay chăn gối…\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eĐộ ồn thấp chỉ khoảng 60dB, không gây khó chịu trong quá trình sử dụng\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eTrọng lượng siêu nhẹ chỉ 1.62kg, thoải mái cầm nắm di chuyển không lo đau mỏi\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eMàn hình LCD màu sắc nét, hiển thị các chế độ hút bụi\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eThiết kế hiện đại – Màn hình LCD sắc nét\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eCũng giống như Redroad V17, máy hút bụi Redroad V17 Lite sở hữu thiết kế hiện đại, vô cùng mạnh mẽ với tông màu đỏ – đen đầy ấn tượng. Không chỉ là một chiếc máy hút bụi thông thường, Redroad V17 còn có thể trở thành một vật trang trí đẹp mắt trong căn nhà của bạn.\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"WebpImg__StyledImg-sc-h3ozu8-0 fWjUGo\" title=\"\" src=\"https://redroad-eu.oss-eu-central-1.aliyuncs.com/uploads/20220323/1a279774e8a1df657694c70d0e681199.jpg\" alt=\"\" width=\"750\" height=\"411\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"WebpImg__StyledImg-sc-h3ozu8-0 fWjUGo\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/76/80/ea/647245c3b00471f7ab2406dc46147da1.png\" alt=\"\" width=\"750\" height=\"393\" /\u003e\u003c/p\u003e\n\u003cp\u003eMáy còn được trang bị một màn hình LCD màu sắc nét, hiển thị đầy đủ các thông số như: dung lượng pin, chế độ làm việc… giúp bạn dễ dàng quan sát và sử dụng.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eLõi lọc HEPA kép tân tiến\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eĐể tối ưu khả năng lọc sạch không khí, đảm bảo an toàn cho người sử dụng, nhà sản xuất Redroad đã trang bị bộ lõi lọc HEPA kép tân tiến cho Redroad V17 Lite. Thay vì chỉ có một lõi lọc thì giờ đây, Redroad V17 Lite sẽ có tới 2 lõi lọc HEPA cùng hoạt động song song, tăng gấp đôi hiệu quả lọc không khí, đảm bảo giữ lại mọi loại bụi bẩn. Theo đó, lõi lọc HEPA của máy có thể loại bỏ được các hạt bụi mịn có kích thước siêu nhỏ tới 0,1 μm – nhỏ hơn nhiều so với các loại máy hút bụi thông thường vốn chỉ dừng lại ở mức  0,3 μm.\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"WebpImg__StyledImg-sc-h3ozu8-0 fWjUGo\" title=\"\" src=\"https://redroad-eu.oss-eu-central-1.aliyuncs.com/uploads/20211209/ab552c7f2a76a2ca2f4cb14709d31d94.jpg\" alt=\"\" width=\"750\" height=\"421\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"WebpImg__StyledImg-sc-h3ozu8-0 fWjUGo\" title=\"英文详情_调色_06.jpg\" src=\"https://redroad-eu.oss-eu-central-1.aliyuncs.com/uploads/20220323/d6b1effe6e1a39a81e54e7c0859fbde3.jpg\" alt=\"英文详情_调色_06.jpg\" width=\"750\" height=\"421\" /\u003e\u003c/p\u003e\n\u003cp\u003eKhông chỉ bụi, lõi lọc HEPA của máy còn có khả năng lọc các loại vi khuẩn, tác nhân gây dị ứng như phấn hoa… có trong không khí. Lớp lọc bằng than hoạt tính sẽ có nhiệm vụ khử mùi, mang đến không khí trong lành cho người sử dụng.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eLực hút vô địch\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eRedroad V17 Lite có lực hút vô cùng mạnh mẽ, lên tới 26,500 Pa và là một trong những máy hút bụi cầm tay có lực hút lớn nhất trên thị trường. Redroad V17 Lite có thể dễ dàng hút sạch các loại bụi bẩn, lông tóc, vụn thức ăn… và cả các hạt lớn trên sàn nhà.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eChổi lăn kép độc đáo\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eMáy hút bụi Red Road V17 Lite được trang bị chổi lăn chính dạng kép với 2 con lăn hoạt động cùng lúc ngược chiều nhau. Thiết kế chổi lăn kép sẽ giúp tăng hiệu quả hút bụi lên gấp 2 lần, chỉ một lần đẩy sẽ có hiệu quả như 2 lần đẩy bởi các hạt bụi nhỏ hay siêu mịn sẽ dễ dàng được cuốn và hút lên hơn.\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"WebpImg__StyledImg-sc-h3ozu8-0 fWjUGo\" title=\"\" src=\"https://redroad-eu.oss-eu-central-1.aliyuncs.com/uploads/20211209/14a68b896bbebfa9078e198ea522341e.jpg\" alt=\"\" width=\"750\" height=\"421\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"WebpImg__StyledImg-sc-h3ozu8-0 fWjUGo\" title=\"\" src=\"https://redroad-eu.oss-eu-central-1.aliyuncs.com/uploads/20211209/38ee5f61719926c964d9c68d0b4e9606.jpg\" alt=\"\" width=\"750\" height=\"421\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eDung lượng pin lớn\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eRedroad V17 Lite có dung lượng pin lớn lên tới 4000mAh, cho thời lượng sử dụng máy lên đến hơn 60 phút. Giờ đây bạn có thể dọn dẹp cả căn phòng của mình sạch đẹp chỉ trong một lần sạc.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCông nghệ giảm ồn 9 cấp\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eRedroad V17 Lite được trang bị công nghệ giảm tiếng ồn 9 cấp tân tiến, giúp hạn chế tối đa tiếng ồn phát ra khi làm việc. Độ ồn của máy chỉ khoảng 60dB, hoàn toàn không gây khó chịu hay ảnh hưởng tới sinh hoạt của bạn và gia đình.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eSử dụng 1 nút dễ dàng\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eBạn có thể dễ dàng sử dụng Redroad V17 Lite chỉ với một nút bấm duy nhất. Thay vì phải liên tục nhấn và giữ nút để máy hoạt động, giờ đây, bạn chỉ cần nhấn giữ nút hút bụi trong 3 giây thì máy sẽ chuyển sang chế độ tự động vô cùng tiện lợi.\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"WebpImg__StyledImg-sc-h3ozu8-0 fWjUGo\" title=\"\" src=\"https://redroad-eu.oss-eu-central-1.aliyuncs.com/uploads/20211209/2c416e8c2c03dd92c2118a5fbbba7f6a.jpg\" alt=\"\" width=\"750\" height=\"421\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"WebpImg__StyledImg-sc-h3ozu8-0 fWjUGo\" title=\"\" src=\"https://redroad-eu.oss-eu-central-1.aliyuncs.com/uploads/20211209/7fdbaa0763e5c04c2f40fb2be04addb2.jpg\" alt=\"\" width=\"750\" height=\"418\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/c7/d8/9b/dffed6e5dadc8ca89c252dd1be17cda2.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c7/d8/9b/dffed6e5dadc8ca89c252dd1be17cda2.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c7/d8/9b/dffed6e5dadc8ca89c252dd1be17cda2.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c7/d8/9b/dffed6e5dadc8ca89c252dd1be17cda2.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c7/d8/9b/dffed6e5dadc8ca89c252dd1be17cda2.png"},{"base_url":"https://salt.tikicdn.com/ts/product/e4/b3/2f/19f2e629dc12c594bf8efb68da32184a.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e4/b3/2f/19f2e629dc12c594bf8efb68da32184a.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e4/b3/2f/19f2e629dc12c594bf8efb68da32184a.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e4/b3/2f/19f2e629dc12c594bf8efb68da32184a.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e4/b3/2f/19f2e629dc12c594bf8efb68da32184a.png"},{"base_url":"https://salt.tikicdn.com/ts/product/c5/38/69/580431dffaf7a21d5c3426150d751740.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c5/38/69/580431dffaf7a21d5c3426150d751740.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c5/38/69/580431dffaf7a21d5c3426150d751740.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c5/38/69/580431dffaf7a21d5c3426150d751740.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c5/38/69/580431dffaf7a21d5c3426150d751740.png"},{"base_url":"https://salt.tikicdn.com/ts/product/72/1b/81/7566de84ab531557435c3025674740fb.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/72/1b/81/7