x":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"freeship_xtra","type":"pdp_icon_badge","index":2,"icon":"https://salt.tikicdn.com/ts/upload/be/67/48/04a82ab8df178e1a13bde38316081865.png","icon_width":91,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":true,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/e6/9a/35/be9fc8920801908183c94c4c16952884.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2135,"all_time_quantity_sold":7,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eThiên thời địa lợi nhân hòa\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003ePhương thuật Trung Quốc bắt nguồn từ tầng thứ cao nhất của triết học cổ đại, song nó lại diễn ra dưới hình thức tín ngưỡng dân gian phổ biến nhất. Hàng mấy ngàn năm nay, những phương thuật này được vận dụng vào các lĩnh vực chính trị, quân sự, khoa học kỹ thuật, văn nghệ,  chứa đầy màu sắc thần bí, huyền hoặc mà từ trước đến nay đã tạo nên những ảnh hưởng cực kì quan trọng đối với sinh hoạt xã hội, sự hình thành trạng thái tâm linh văn hóa của người Trung Quốc.\u003c/p\u003e\n\u003cp\u003eQua nhiều năm nghiên cứu và chỉnh lý, từ ba phương diện lớn: Thiên thời, Địa lợi, Nhân hòa thông qua khía cạnh thực tiễn tùy cơ ứng biến của đời người, vận dụng tư duy mới; thành quả mới của nền khoa học hiện đại, tác giả đã giới thiệu lý thuyết và phương pháp của phương thuật Trung Quốc.\u003c/p\u003e\n\u003cp\u003ePhần \"Thiên thời\" giới thiệu các phương pháp làm thế nào để nhận thức quy luật phát triển xã hội, đặc điểm biến đổi của thời đại và giành được cơ may của đời người như: chiêm tinh thuật, sấm vĩ thuật, chiêm bốc thuật, đoán mệnh thuật, quái ảnh thuật, tướng diện thuật, viên mộng thuật, \u003c/p\u003e\n\u003cp\u003ePhần \"Địa lợi\" giới thiệu các phương pháp làm thế nào để nhận thức và lợi dụng hoàn cảnh xã hội, hoàn cảnh tự nhiên như \"Kì môn thuật\" để lựa chọn phương hướng tốt nhất, \"Thông thiên thuật\" dự đoán khí tượng, \"Quan nhân thuật\" thông qua tính khu vực phán đoán khí phách con người và \"Phong thủy thuật\" lợi dụng ưu thế địa lý.\u003c/p\u003e\n\u003cp\u003ePhần \"Nhân hòa\" giới thiệu phương pháp làm thế nào để nhận biết người và dùng người. Căn cứ kết quả nghiên cứu trong nhiều năm, tác giả đã sáng tạo ra một mô thức khoa học hành vi độc đáo: mô thức nhu cầu ngũ hành. Tác giả đã kết hợp một cách hữu cơ thuyết nhu cầu tâm lý của Maslow có ảnh hưởng nhất ở phương Tây với thuyết âm dương ngũ hành cổ đại của Trung Quốc, tổng kết thành phương pháp dùng người, hễ thực hiện là có hiệu quả rõ rệt.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/e6/9a/35/be9fc8920801908183c94c4c16952884.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e6/9a/35/be9fc8920801908183c94c4c16952884.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e6/9a/35/be9fc8920801908183c94c4c16952884.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e6/9a/35/be9fc8920801908183c94c4c16952884.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e6/9a/35/be9fc8920801908183c94c4c16952884.jpg"}],"warranty_policy":null,"authors":[{"id":16317,"name":"Bạch Huyết","slug":"bach-huyet"}],"current_seller":{"id":279977,"sku":"5863613995192","name":"Tiệm sách Minh Hằng","link":"https://tiki.vn/cua-hang/tiem-sach-minh-hang","logo":"72/e9/31/97b276a4c1d9e00bf2bac4f286c5b7c9.jpg","price":164000,"product_id":"189494821","store_id":267047,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[{"id":15583,"name":"NhatPham0356","link":"https://tiki.vn/cua-hang/nhatpham0356","logo":"68/14/5f/42ed646f43651029fc86dcc59d411c16.jpg","price":173000,"product_id":"8071794","store_id":15041},{"id":26874,"name":"Phương Đông Books","link":"https://tiki.vn/cua-hang/phuong-dong-books","logo":"2e/85/b7/e76104ae5f1beaf244f319e2f0d2d413.jpg","price":180830,"product_id":"19378330","store_id":26242},{"id":9988,"name":"AHABOOKS","link":"https://tiki.vn/cua-hang/ahabooks","logo":"7c/b8/e1/357f6a5d18da8daa4e9060a6b7eb9d5f.png","price":182170,"product_id":"58970681","store_id":9778},{"id":178049,"name":"Bùi Thị Anh","link":"https://tiki.vn/cua-hang/bui-thi-anh","logo":"4c/60/7a/94e7205a83f1d7727b63db4d547387cd.jpg","price":213000,"product_id":"112059182","store_id":165085},{"id":161219,"name":"Nhà Sách Trẻ Online","link":"https://tiki.vn/cua-hang/nha-sach-tre