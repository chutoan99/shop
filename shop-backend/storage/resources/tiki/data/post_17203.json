son":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.8,"review_count":8,"review_text":"(8)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/fe/77/62/235aed1d1f780c37b4c3b8d621033185.jpeg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":616,"all_time_quantity_sold":32,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch5\u003e\u003cimg src=\"https://vcdn.tikicdn.com/ts/tmp/db/17/b5/9943793239ba57485b2d1b2fb3bde6b4.jpg\" alt=\"Chuột Chơi Game Có Dây Logitech G102 8000DPI RGB 6 Phím - Hàng Chính Hãng\" width=\"750\" height=\"11996\" /\u003e\u003cbr /\u003eThiết kế đối xứng\u003c/h5\u003e\n\u003cp\u003e\u003cstrong\u003eChuột Chơi Game Có Dây Logitech G102 8000DPI RGB 6 Phím\u003c/strong\u003e được thiết kế dạng đối xứng nên người dùng có thể sử dụng bằng tay phải hoặc tay phái rất tiện lợi.\u003c/p\u003e\n\u003ch3 style=\"text-align:center\"\u003e\u003cimg src=\"https://vdcn.tikicdn.com/ts/tmp/d9/96/35/786f1304ff9c8162a8f291053cc52581.jpg\" alt=\"\" width=\"850\" height=\"567\" /\u003e\u003c/h3\u003e\n\u003ch5\u003eĐộ phân giải cao từ 200DPI lên tới 8000 DPI\u003c/h5\u003e\n\u003cp\u003eThiết bị giúp bạn không phải dừng lại khi đang chơi để điều chỉnh DPI. Bạn có thể chỉnh mức thiết lập DPI, từ siêu chính xác ở 200 DPI hoặc cực nhanh ở 8000 DPI cho bạn những cú click chuột cực kỳ ấn tượng.\u003cbr /\u003e\u003cbr /\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://vcdn.tikicdn.com/ts/tmp/f2/67/8b/07921a59b3a3a2fe0e925cf749f424c2.jpg\" alt=\"\" width=\"850\" height=\"567\" /\u003e\u003c/p\u003e\n\u003ch5\u003eChất liệu cao cấp\u003c/h5\u003e\n\u003cp\u003eĐặc biệt, chuột chơi game có dây Logitech được làm từ chất liệu cao cấp, bền bỉ gia tăng được thời gian sử dụng lâu dài. Với chất lượng đã được kiểm định và có 30 năm kinh nghiệm sản xuất thiết bị ngoại vi trong đó có phân khúc Gaming Gear, quy trình kiểm định sản phẩm được đầu tư vô cùng nghiêm ngặt trước khi đem tới các game thủ.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://vdcn.tikicdn.com/ts/tmp/a3/1d/36/35321ab91550265eeecd8181b0d1460e.jpg\" alt=\"\" width=\"850\" height=\"567\" /\u003e\u003c/p\u003e\n\u003ch5\u003eHệ thống LED RGB 16.8 triệu màu\u003c/h5\u003e\n\u003cp\u003eNgoài ra, sản phẩm còn có điểm nổi bật là được trang bị công nghệ LED RGB 16.8 triệu màu. Với 6 nút, giúp bạn có thể lập trình thông qua phần mềm Logitech Gaming Software, người dùng có thể dễ dàng thiết lập các thao tác Macro hay đơn giản là hoán đổi chức năng cho chú chuột một cách dễ dàng.\u003c/p\u003e\n\u003cp style=\"text-align:left\"\u003e\u003cimg src=\"https://vcdn.tikicdn.com/ts/tmp/66/1b/7a/058d56c86950458498cf824d8231d770.jpg\" alt=\"\" /\u003e\u003c/p\u003e\n\u003ch5\u003eCảm biến độc quyền, nút bấm nảy mềm mại\u003c/h5\u003e\n\u003cp\u003eChuột Chơi Game Có Dây G102 - Gaming được tích hợp nút cảm biến độc quyền, nút bấm nảy mềm mạiG102 được Logitech trang bị mắt cảm biến Logitech Mercury do chính hãng phát triển. Mắt cảm biến hiện tại đã có mức DPI lên tới 8000 và độ chính xác tuyệt vời cho chơi game nhịp độ cao. Hơn nữa, còn được tích hợp nút bấm nảy và mềm mại với lớp vỏ phần nút tách rời với lưng, tạo cảm giác nhấn nút tách bạch và độ nảy cao.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://vcdn.tikicdn.com/ts/tmp/34/ba/8f/dbfa9b76218fce0fe888a2800c68362b.jpg\" alt=\"\" width=\"850\" height=\"567\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003