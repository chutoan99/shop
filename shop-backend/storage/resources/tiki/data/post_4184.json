com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/4f/bd/a8/c89e916d66114a3c05a9a37aad4d93d9.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1929,"all_time_quantity_sold":27,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"box-sizing: border-box; margin: 0px 0px 10px; padding: 0px; color: #333333; font-family: Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003eTrong số các loại thảo mộc tại vùng Provence, cỏ roi ngựa là loại cây đặc biệt có mùi chanh tươi mát mang đến sự sảng khoái cho cơ thể và giúp thư giãn tinh thần. Vào mùa thu hoạch, hương thơm ngào ngạt từ các giỏ cây đầy ắp lan tỏa khắp vùng Provence tạo nên nét đặc trưng của vùng đất nổi tiếng này. Chắt lọc những tinh túy của loại cỏ thơm độc đáo này, thương hiệu L'Occitane đã cho ra đời dòng sản phẩm Verbena bao gồm nhiều loại nước hoa và các sản phẩm chăm sóc tóc, cơ thể. \u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 0px 0px 10px; padding: 0px; color: #333333; font-family: Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e\u003cspan style=\"box-sizing: border-box; margin: 0px; padding: 0px; font-weight: bold;\"\u003eGel tắm cỏ roi ngựa L'Occitane Verbena Shower Gel\u003c/span\u003e chứa chiết xuất cỏ roi ngựa vùng Provence nhẹ nhàng làm sạch da đồng thời nuôi dưỡng da sáng khỏe, mịn màng và lưu lại trên da hương thơm tươi mát trong nhiều giờ, tạo cảm giác thư thái như đang ở giữa khu vườn mùa xuân. Sản phẩm là lựa chọn lý tưởng dành cho da nhạy cảm. \u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 0px 0px 10px; padding: 0px; color: #333333; font-family: Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e\u003cspan style=\"box-sizing: border-box; margin: 0px; padding: 0px; font-weight: bold;\"\u003eHướng dẫn sử dụng và bảo quản\u003c/span\u003e\u003c/p\u003e\n\u003cul style=\"box-sizing: border-box; margin: 0px 0px 10px; padding: 0px 0px 0px 15px; color: #333333; font-family: Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 13px; list-style-position: initial !important; list-style-image: initial !important;\"\u003e\n\u003cli style=\"box-sizing: border-box; margin: 0px; padding: 0px; text-align: justify;\"\u003eLàm ướt cơ thể\u003c/li\u003e\n\u003cli style=\"box-sizing: border-box; margin: 0px; padding: 0px; text-align: justify;\"\u003eLấy một lượng sữa tắm vừa đủ ra lòng bàn tay hoặc bông tắm, tạo bọt\u003c/li\u003e\n\u003cli style=\"box-sizing: border-box; margin: 0px; padding: 0px; text-align: justify;\"\u003eMassage nhẹ nhàng lên cơ thể\u003c/li\u003e\n\u003cli style=\"box-sizing: border-box; margin: 0px; padding: 0px; text-align: justify;\"\u003eTắm sạch lại với nước\u003c/li\u003e\n\u003cli style=\"box-sizing: border-box; margin: 0px; padding: 0px; text-align: justify;\"\u003eBảo quản nơi khô ráo, thoáng mát, tránh ánh nắng trực tiếp và nhiệt độ cao\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"box-sizing: border-box; margin: 0px 0px 10px; padding: 0px; color: #333333; font-family: Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e\u003cspan style=\"box-sizing: border-box; margin: 0px; padding: 0px; font-weight: bold;\"\u003eThông tin thương hiệu\u003c/span\u003e\u003c/p\u003e\n\u003ctable style=\"box-sizing: border-box; margin: 0px; padding: 0px; border-collapse: collapse; border-spacing: 0px; width: 259px; color: #333333; font-family: Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 13px;\" border=\"0\" cellspacing=\"1\" cellpadding=\"1\" align=\"left\"\u003e\n\u003ctbody style=\"box-sizing: border-box; margin: 0px; padding: 0px;\"\u003e\n\u003ctr style=\"box-sizing: border-box; margin: 0px; padding: 0px;\"\u003e\n\u003ctd style=\"box-sizing: border-box; margin: 0px; padding: 16px 10px; vertical-align: top; text-align: center; width: 258.519px;\"\u003e\u003cimg class=\"loaded\" style=\"box-sizing: border-box; margin: 0px auto; padding: 0px; border: 0px; vertical-align: middle; max-width: 100%; display: block; height: 168px; width: 250px;\" src=\"https://salt.tikicdn.com/ts/product/b2/69/aa/7f83b812358d87d883bebde5b52b75cd.png\" data-src=\"https://salt.tikicdn.com/ts/product/b2/69/aa/7f83b812358d87d883bebde5b52b75cd.png\" /\u003e\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\n\u003cp style=\"box-sizing: border-box; margin: 0px 0px 10px; padding: 0px; color: #333333; font-family: Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e \u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 0px 0px 10px; padding: 0px; color: #333333; font-family: Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003eL'Occitane khởi nguồn từ một nhà máy làm xà phòng cũ, với những kiến thức đơn giản về thực vật của cậu thanh niên 23 tuổi Olivier Baussan. Từ sau khi chưng cất thành công tinh dầu hương thảo để bán ở các chợ địa phương vùng Provence, Olivier Baussan đã làm hồi sinh nghệ thuật làm xà phòng từ các thành phần thiên nhiên của vùng Marseille. Năm 1977, L'Occitane bắt đầu khai thác nguồn nguyên liệu chính là hoa oải hương - loài hoa đặc trưng với hương thơm là biểu tượng của vùng Provence nước Pháp. Từ đó đến nay, L'Occitane luôn mang đến những sản phẩm nước hoa và mỹ phẩm làm đẹp được sản xuất theo các quy tắc của liệu pháp thực vật và liệu pháp tinh dầu lấy cảm hứng từ cuộc sống của vùng Địa Trung Hải. L'Occitane cam kết sử dụng những nguyên liệu chất lượng được xác thực nguồn gốc và hoàn toàn từ thiên nhiên. L'Occitane sử dụng hơn 200 nguyên liệu từ thực vật, ¼ trong số đó được chứng nhận là sản phẩm hữu cơ, và được lựa chọn cẩn thận về công dụng và khả năng mà thành phần đó cung cấp cho da.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/4f/bd/a8/c89e916d66114a3c05a9a37aad4d93d9.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/4f/bd/a8/c89e916d66114a3c05a9a37aad4d93d9.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/4f/bd/a8/c89e916d66114a3c05a9a37aad4d93d9.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4f/bd/a8/c89e916d66114a3c05a9a37aad4d93d9.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4f/bd/a8/c89e916d66114a3c05a9a37aad4d93d9.jpg"}],"warranty_policy":null,"brand":{"id":288993,"name":" L'Occitane","slug":"l-occitane"},"current_seller":{"id":48477,"sku":"5649274828092","name":"MPRuby","link":"https://tiki.vn/cua-hang/mpruby","logo":"74/1f/33/5944c917a920d2bafe5183b847b7eac0.png","price":1150000,"product_id":"17887183","store_id":46521,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Operation","attributes":[{"code":"is_warranty_applied","name":"Sản phẩm có được bảo hành không?","valu