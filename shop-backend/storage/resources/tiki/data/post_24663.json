66e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":19000,"discount_rate":11,"rating_average":4,"review_count":6,"review_text":"(6)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/80/ed/91/3a0e980561b67545edfd8e826d94b8e6.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1912,"all_time_quantity_sold":90,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"margin: 0.2em 0px; padding: 0px; unicode-bidi: embed; font-family: Roboto, -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif; font-size: 20px; line-height: 1.6;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/41/af/35/7fad2909776e38a2d5b353bc635ebe7e.jpg\" alt=\"\" width=\"700\" height=\"700\" /\u003e\u003c/p\u003e\n\u003cp style=\"margin: 0.2em 0px; padding: 0px; unicode-bidi: embed; font-family: Roboto, -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif; font-size: 20px; line-height: 1.6;\"\u003eBệnh răng miệng là bệnh phổ biến trong mọi lứa tuổi từ trẻ em đến người già. Ai đã từng bị sâu răng thì cảm giác đau buốt đến tận óc, làm ảnh hưởng rất lớn đến đời sống hàng ngày. Bên cạnh đó các bệnh như: chảy máu chân răng, hôi miệng,…làm cho chúng ta mất tự tin khi giao tiếp.\u003c/p\u003e\n\u003cp style=\"margin: 0.2em 0px; padding: 0px; unicode-bidi: embed; font-family: Roboto, -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif; font-size: 20px; line-height: 1.6;\" data-spm-anchor-id=\"a2o4n.pdp.product_\"\u003eNắm bắt được sự cần thiết phải có một sản phẩm hỗ trợ chữa trị bệnh răng miệng cho mọi lứa tuổi đảm bảo cả chất lượng và tính an toàn Đông y Thanh Mộc Hương đã cho ra mắt dòng sản phẩm chuyên hỗ trợ răng miệng\u003cspan style=\"margin: 0px; padding: 0px; font-weight: bolder;\"\u003e THANH MỘC HƯƠNG\u003c/span\u003e.\u003c/p\u003e\n\u003ch2 style=\"margin: 0.75em 0px; padding: 0px; unicode-bidi: embed; font-weight: bolder; font-family: Roboto, -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;\"\u003eNƯỚC SÚC MIỆNG THANH MỘC HƯƠNG – SẢN PHẨM TỪ THẢO DƯỢC AN TOÀN CHO MỌI NGƯỜI.\u003c/h2\u003e\n\u003cp style=\"margin: 0.2em 0px; padding: 0px; unicode-bidi: embed; font-family: Roboto, -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif; font-size: 20px; line-height: 1.6;\"\u003eVới thành phần 100% từ thảo dược thiên nhiên: Vàng tằng, nhài trạ, nàng nhà hây, hoa cúc rừng, cây toong đỉa,\u003c/p\u003e\n\u003cp style=\"margin: 0.2em 0px; padding: 0px; unicode-bidi: embed; font-family: Roboto, -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif; font-size: 20px; line-height: 1.6;\"\u003e \u003c/p\u003e\n\u003cp style=\"margin: 0.2em 0px; padding: 0px; unicode-bidi: embed; font-family: Roboto, -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif; font-size: 20px; line-height: 1.6;\"\u003e\u003cstrong\u003eCông dụng:\u003c/strong\u003e hỗ trợ điều trị sâu răng, hôi miệng, chảy máu chân răng, viêm lợi, đau răng, ghê buốt răng.\u003c/p\u003e\n\u003cp style=\"margin: 0.2em 0px; padding: 0px; unicode-bidi: embed; font-family: Roboto, -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif; font-size: 20px; line-height: 1.6;\"\u003eSản phẩm có tác dụng ngấm vào những chỗ sâu nhất trong kẽ răng, vùng răng – lợi bị tổn thương, loại bỏ hoàn toàn các mảng bám vi khuẩn tích tụ.\u003c/p\u003e\n\u003cp style=\"margin: 0.2em 0px; padding: 0px; unicode-bidi: embed; font-family: Roboto, -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif; font-size: 20px; line-height: 1.6;\"\u003e \u003c/p\u003e\n\u003cp style=\"margin: 0.2em 0px; padding: 0px; unicode-bidi: embed; font-family: Roboto, -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif; font-size: 20px; line-height: 1.6;\"\u003e\u003cspan style=\"margin: 0px; padding: 0px; font-weight: bolder;\"\u003eCách dùng\u003c/span\u003e: Đổ 1 lượng vừa đủ ngụm nhỏ ra chén, pha thêm một ít nước lọc theo tỷ lệ 7 phần nước cốt 3 phần nước uống rồi ngậm từ 5-10 phút và nhổ bỏ. Một ngày ngậm từ 2-3 lần sau khi đánh răng sạch sẽ. Nếu ai không ngại đắng và cay thì ngậm trực tiếp nước cốt không pha thêm nước lọc sẽ đem lại hiệu quả tốt nhất.\u003c/p\u003e\n\u003cp style=\"margin: 0.2em 0px; padding: 0px; unicode-bidi: embed; font-family: Roboto, -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif; font-size: 20px; line-height: 1.6;\"\u003eĐối với trẻ em dưới 10 tuổi phải pha loãng với nước lọc theo tỷ lệ 50/50, cho bé ngậm rồi nhổ ra không uống.\u003c/p\u003e\n\u003cp style=\"margin: 0.2em 0px; padding: 0px; unicode-bidi: embed; font-family: Roboto, -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif; font-size: 20px; line-height: 1.6;\"\u003eTrong và sau khi dùng phải thường xuyên có thói quen vệ sinh răng miệng sạch sẽ, ăn uống hợp lý\u003c/p\u003e\n\u003cp style=\"margin: 0.2em 0px; padding: 0px; unicode-bidi: embed; font-family: Roboto, -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif; font-size: 20px; line-height: 1.6;\"\u003eSau khi dùng hết nước đầu tiên đổ thêm rượu 40 độ vào ngâm 10 ngày rồi dùng tiếp.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/80/ed/91/3a0e980561b67545edfd8e826d94b8e6.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/80/ed/91/3a0e980561b67545edfd8e826d94b8e6.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/80/ed/91/3a0e980561b67545edfd8e826d94b8e6.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/80/ed/91/3a0e980561b67545edfd8e826d94b8e6.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/80/ed/91/3a0e980561b67545edfd8e826d94b8e6.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/41/af/35/2c72d587b1bf6cda86ca124ce0cbf747.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/41/af/35/2c72d587b1bf6cda86ca124ce0cbf747.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/41/af/35/2c72d587b1bf6cda86ca124ce0cbf747.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/41/af/35/2c72d587b1bf6cda86ca124ce0cbf747.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/41/af/35/2c72d587b1bf6cda86ca124ce0cbf747.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/72/28/49/271d91cfcfb87742981a56f43c53821f.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/72/28/49/271d91cfcfb87742981a56f43c53821f.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/72/28/49/271d91cfcfb87742981a56f43c53821f.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/72/28/49/271d91cfcfb87742981a56f43c53821f.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/72/28/49/271d91cfcfb87742981a56f43c53821f.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/28/6a/3c/0c5ce05e9dc20d89c9c6c74fd61e84cd.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/prod