 đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e\u003cp\u003eSản phẩm này là tài sản cá nhân được bán bởi Nhà Bán Hàng Cá Nhân và không thuộc đối tượng phải chịu thuế GTGT. Do đó hoá đơn VAT không được cung cấp trong trường hợp này.\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/b3/9a/04/510014c13b7f44d6f23119c37ea99de0.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b3/9a/04/510014c13b7f44d6f23119c37ea99de0.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b3/9a/04/510014c13b7f44d6f23119c37ea99de0.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b3/9a/04/510014c13b7f44d6f23119c37ea99de0.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b3/9a/04/510014c13b7f44d6f23119c37ea99de0.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/1b/12/76/ca32b2826e543381ae1365863495a550.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/1b/12/76/ca32b2826e543381ae1365863495a550.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/1b/12/76/ca32b2826e543381ae1365863495a550.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1b/12/76/ca32b2826e543381ae1365863495a550.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1b/12/76/ca32b2826e543381ae1365863495a550.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/7c/7d/b1/e1fc77a8f59d399b971e3f2cc5331b28.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/7c/7d/b1/e1fc77a8f59d399b971e3f2cc5331b28.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/7c/7d/b1/e1fc77a8f59d399b971e3f2cc5331b