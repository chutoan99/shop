f2018.jpg\" alt=\"\" width=\"750\" height=\"372\" /\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/f1/b6/42/1cbfc0bacbe860f4202963439392d665.jpg\" alt=\"\" width=\"750\" height=\"485\" /\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/31/fa/9b/8a0f062521413f5529c93009d1a880d7.jpg\" alt=\"\" width=\"750\" height=\"625\" /\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/52/14/e7/45626b506b6dd9d7683c8199c71fbc62.jpg\" alt=\"\" width=\"750\" height=\"1187\" /\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/7f/93/a1/9a48b8db1b6138346799c05762ac90d8.jpg\" alt=\"\" width=\"750\" height=\"423\" /\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/d3/b9/9d/a770773a866037563c5275d9d39bd17e.jpg\" alt=\"\" width=\"750\" height=\"686\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/84/07/5a/fbad0044dde7f5b9744bc957bc307f2c.png\" alt=\"GiÃ¡o TrÃ¬nh HÃ¡n Ngá»¯ Táº­p 1: Quyá»n Háº¡ (PhiÃªn Báº£n Má»i) - KÃ¨m CD Hoáº·c DÃ¹ng App\" width=\"750\" height=\"500\" /\u003e\u003cspan style=\"color:#242424;font-family:Roboto, Helvetica, Arial, sans-serif;font-size:13px;text-align:justify;\"\u003eBạn học tiếng Trung nhưng những vấn đề trên lại đang cản bước bạn chinh phục ngôn ngữ này. Bạn có muốn tìm ra giải quyết những vấn đề này càng sớm càng tốt không? Nếu có hãy học ngay với cuốn sách “Giáo trình Hán ngữ tập 2 phiên bản mới” của Đại học ngôn ngữ Bắc Kinh.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"margin:5px 0px 12px;color:#242424;font-family:Roboto, Helvetica, Arial, sans-serif;font-size:13px;text-align:justify;\"\u003eVì sao các bạn nên học cùng cuốn sách này?\u003c/p\u003e\n\u003cp style=\"margin:5px 0px 12px;color:#242424;font-family:Roboto, Helvetica, Arial, sans-serif;font-size:13px;text-align:justify;\"\u003eTrình bày khoa học phù hợp với các bạn tự nghiên cứu\u003c/p\u003e\n\u003cp style=\"margin:5px 0px 12px;color:#242424;font-family:Roboto, Helvetica, Arial, sans-serif;font-size:13px;text-align:justify;\"\u003eVới những bạn đang tự học tiếng Trung hoặc tự ôn luyện sau những giờ học trên lớp thì cuốn sách này hoàn toàn phù hợp. Các bài học được biên soạn theo chương trình thống nhất, phù hợp với trình độ Sơ cấp, các kiến thức đều ở mức cơ bản nhất.\u003c/p\u003e\n\u003cul style=\"margin-top:0px;margin-bottom:10px;color:#333333;font-family:Roboto, Helvetica, Arial, sans-serif;font-size:13px;text-align:justify;\"\u003e\u003cli\u003eBài khóa\u003c/li\u003e\n\u003cli\u003eTừ mới\u003c/li\u003e\n\u003cli\u003eChú thích\u003c/li\u003e\n\u003cli\u003eNgữ pháp, ngữ âm\u003c/li\u003e\n\u003cli\u003eLuyện tập\u003c/li\u003e\n\u003c/ul\u003e\u003cp style=\"margin:5px 0px 12px;color:#242424;font-family:Roboto, Helvetica, Arial, sans-serif;font-size:13px;text-align:justify;\"\u003e\u003cspan\u003eHệ thống ngữ pháp và từ mới theo từng bài\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"margin:5px 0px 12px;color:#242424;font-family:Roboto, Helvetica, Arial, sans-serif;font-size:13px;text-align:justify;\"\u003eSo với tập 1, tập 2 với hệ thống ngữ pháp khó hơn và lượng từ mới nhiều hơn rất nhiều. Hệ thống từ vựng bám sát theo từng chủ đề, mỗi bài các bạn được học từ 30 – 40 từ vựng liên quan đến chủ đề. Ngoài ra ở cuối sách còn có bảng từ vựng cung cấp gần 372 từ vựng đủ cho những người mới học.\u003c/p\u003e\n\u003cp style=\"margin:5px 0px 12px;color:#242424;font-family:Roboto, Helvetica, Arial, sans-serif;font-size:13px;text-align:justify;\"\u003e\u003cspan\u003eGiúp người học phát triển đồng thời cả 4 kỹ năng\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"margin:5px 0px 12px;color:#242424;font-family:Roboto, Helvetica, Arial, sans-serif;font-size:13px;text-align:justify;\"\u003eSau khi học xong tập 1 các bạn đã nắm chắc được các kỹ năng phát âm cơ bản. Tập 2 này các bạn sẽ được ứng dụng các kiến thức đã học một cách tối đa qua các đoạn hội thoại có độ dài và khó cao hơn tập 1.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/06/77/5e/3710ad370df3c21260e2cc1357f1e7c3.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/06/77/5e/3710ad370df3c21260e2cc1357f1e7c3.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/06/77/5e/3710ad370df3c21260e2cc1357f1e7c3.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/06/77/5e/3710ad370df3c21260e2cc1357f1e7c3.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/06/77/5e/3710ad370df3c21260e2cc1357f1e7c3.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/2d/cf/2f/df2d02fdd322ad5b75b6da8eec6eaa51.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/2d/cf/2f/df2d02fdd322ad5b75b6da8eec6eaa51.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/2d/cf/2f/df2d02fdd322ad5b75b6da8eec6eaa51.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2d/cf/2f/df2d02fdd322ad5b75b6da8eec6eaa51.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2d/cf/2f/df2d02fdd322ad5b75b6da8eec6eaa51.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/76/db/4b/3c5516b431bfc0fc5d4b9e6bbf6a845d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/76/db/4b/3c5516b431bfc0fc5d4b9e6bbf6a845d.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/76/db/4b/3c5516b431bfc0fc5d4b9e6bbf6a845d.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/76/db/4b/3c5516b431bfc0fc5d4b9e6bbf6a845d.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/76/db/