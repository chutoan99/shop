 title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/24/92/14/226052d1622c375f449154dbb14b22bf.jpg\" alt=\"\" width=\"undefined\" height=\"undefined\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/36/12/96/288afdb050d997483d7674e342ad0ba1.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/36/12/96/288afdb050d997483d7674e342ad0ba1.jpg\" alt=\"\" width=\"undefined\" height=\"undefined\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/9c/d1/16/b88e4edbb7d51ff65a3b93921fce7645.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/9c/d1/16/b88e4edbb7d51ff65a3b93921fce7645.jpg\" alt=\"\" width=\"750\" height=\"1125\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/25/c6/12/ad80c5b54be7cda15b4b98048b50a866.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/25/c6/12/ad80c5b54be7cda15b4b98048b50a866.jpg\" alt=\"\" width=\"750\" height=\"691\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/72/42/22/ccbf60300efa36facdadfcf777bd09ab.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/72/42/22/ccbf60300efa36facdadfcf777bd09ab.jpg\" alt=\"\" width=\"750\" height=\"1125\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/50/f0/26/edda006e3769b9b2f8aa4c0c1526829e.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/50/f0/26/edda006e3769b9b2f8aa4c0c1526829e.jpg\" alt=\"\" width=\"750\" height=\"1155\" /\u003e\u003c/p\u003e\n\u003cp\u003e+ Phương pháp 1 (đo chiều dài chân). \u003c/p\u003e\n\u003cp\u003eĐể chân giẫm lên giấy, điểm đầu ngón chân và điểm ở gót chân mỗi phía đều vẽ điểm đánh dấu, khoảng cách giữa 2 điểm đó chính là chiều dài chân. \u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/22/f2/bd/3038b74fb0f3f88b196a4cbec5bec17c.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/22/f2/bd/3038b74fb0f3f88b196a4cbec5bec17c.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/c8/d9/66/8293fde875447f4fb69fbb9238485383.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/c8/d9/66/8293fde875447f4fb69fbb9238485383.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/b1/c4/83/302fce8208a499cd88274fd01b341793.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/b1/c4/83/302fce8208a499cd88274fd01b341793.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e+ Phương pháp 2: (đo chiều dài của lót giày) Lấy miếng lót vừa với chân , đo khoảng cách giữa điểm đầu và điểm cuối: chiều dài của lót giày = chiều dài bên trong giày.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/cd/2d/3c/ac63c5732f90c2ccb61aad12624d1b20.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/cd/2d/3c/ac63c5732f90c2ccb61aad12624d1b20.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/cd/2d/3c/ac63c5732f90c2ccb61aad12624d1b20.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/cd/2d/3c/ac63c5732f90c2ccb61aad12624d1b20.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/cd/2d/3c/ac63c5732f90c2ccb61aad12624d1b20.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/b0/09/55/9d2d4570395a0dfecd957672c2d4effb.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b0/09/55/9d2d4570395a0dfecd957672c2d4effb.jpg","medium_ur