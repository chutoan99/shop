"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.8,"review_count":94,"review_text":"(94)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/76/b2/21/870978f5491f35e8bedf5e5734bd9d23.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":665,"all_time_quantity_sold":575,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eGÓI TRỌN PHÚC TRAO TAY - HỘP QUÀ TẾT LỘC PHÁT – AN GIA TẾT ĐONG ĐẦY - XUÂN GIÁP THÌN 2024 - HỘP QUÀ TẾT NHÀ MỨT\u003c/p\u003e\n\u003cp\u003eNhắc đến Tết khiến ta không khỏi bồi hồi một năm nữa lại qua, mong rằng năm mới này sẽ khởi sắc và mang đến những điều may mắn, tốt đẹp.\u003c/p\u003e\n\u003cp\u003eBộ sưu tập quà TẾT LỘC PHÁT ra đời trên tinh thần ý nghĩa đó. Lấy nền đỏ chủ đạo hòa cùng sắc xanh mơn mởn như lộc xuân mới đến, mỗi hộp quà Tết của Nhà Mứt được trao đi với mong muốn có thể thay lời cầu chúc gửi đến cho người thân, bạn bè năm mới phát tài, phát lộc, an khang, hạnh phúc.\u003c/p\u003e\n\u003cp\u003eBộ quà Tết Lộc Phát 1 – Giá niêm yết 419K/Hộp – Quy tụ những thức quà quê đầy ý nghĩa, vì Tết Đong Đầy là Tết về nhà, có tiếng cười quây quần bên gia đình cùng 6 thức quà sau:\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003e Táo đỏ Tân Cương \u003cbr /\u003e Khô Gà lá chanh là món mồi nhậu ngon lành trên bàn tiệc, cho cuộc vui thêm trọn vẹn.\u003cbr /\u003e Đậu Hòa Lan tỏi ớt bùi cay lại giàu dinh dưỡng là lựa chọn tốt cho món khai vị ngày Xuân.\u003cbr /\u003e Đậu phộng phô mai giòn rụm, thơm béo giúp những buổi tán gẫu thêm vui vẻ và thú vị.\u003cbr /\u003e Kẹo me cay Đà Lạt kết hợp hoàn hảo nhiều hương vị kích thích vị giác, giúp giải ngấy cho những bữa ăn ngày Tết.\u003cbr /\u003e Xoài sấy dẻo ít calo, giàu Vitamin và khoáng chất tốt cho sức khoẻ để bạn không cần phải lo lắng về vóc dáng sau những cuộc vui ngày Tết.\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/94/40/9c/dcfe7704c886c3d7aee407d4e7e5c0a8.png\" alt=\"\" width=\"495\" height=\"700\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003eBộ quà Tết Lộc Phát 2 – Giá niêm yết 589K/Hộp – Là bộ sản phẩm gói gọn giá trị sức khoẻ và giá trị tinh thần một cách trọn vẹn nhất để trao tặng đến những người thân yêu và quý đối tác.\u003cbr /\u003e Hạt Macca sấy mang hương vị béo ngọt giòn tan khó cưỡng, giá trị dinh dưỡng cao và chất xơ dồi dào của hạt còn giúp ích cho hệ tiêu hoá và đường ruột\u003cbr /\u003e Hạt hạnh nhân Mỹ giàu dinh dưỡng và mang rất nhiều dấu ấn riêng trên thế giới nhưng ý nghĩa chung chính là lời cầu chúc những điều tốt lành gửi tặng cho người thân yêu\u003cbr /\u003e Hạt dẻ cười Mỹ chứa nhiều chất chống oxi hoá và axit béo không no giúp tăng cường sức khoẻ tim mạch, tốt cho trí não và là món quà ý nghĩa đối với sức khoẻ của mọi người\u003cbr /\u003e Hạt điều rang muối bùi ngậy đậm đà là món ăn vặt được nhiều người ưa thích, nhất là trong những dịp lễ Tết vì chúng mang ý nghĩa một năm mới may mắn cho gia đình\u003cbr /\u003e Bánh dứa thượng hạng có nghĩa thịnh vượng, phát đạt ở Đài Loan. Vì vậy gửi tặng bánh dứa cho người thân là mang lời chúc may mắn, tài lộc cho người thưởng thức nó\u003cbr /\u003e Cà phê rang xay được chọn từ những hạt cà phê tốt nhất sẽ giúp cho ly cà phê sáng thêm thơm ngon, đậm đà và đem lại tinh thần thoải mái cho người thân, bạn bè\u003c/p\u003e\n\u003cp\u003eNhà Mứt luôn tâm niệm mỗi phần quà dù giá trị lớn hay nhỏ đều sẽ được gói ghém chỉn chu và thành ý nhất để mang đến những phần quà tết độc đáo đến quý khách. Hy vọng những món quà trao đi sẽ thay lời chúc một năm đong đầy, vẹn tròn như ý đến người nhận\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/76/b2/21/870978f5491f35e8bedf5e5734bd9d23.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/76/b2/21/870978f5491f35e8bedf5e5734bd9d23.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/76/b2/21/870978f5491f35e8bedf5e5734bd9d23.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/76/b2/21/870978f5491f35e8bedf5e5734bd9d23.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/76/b2/21/870978f5491f35e8bedf5e5734bd9d23.png"},{"base_url":"https://salt.tikicdn.com/ts/product/18/56/a7/e5f023d772482ef81551fe9c10cd8758.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/18/56/a7/e5f023d772482ef81551fe9c10cd8758.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/18/56/a7/e5f023d772482ef81551fe9c10cd8758.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/18/56/a7/e5f023d772482ef81551fe9c10cd8758.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/18/56/a7/e5f023d772482ef81