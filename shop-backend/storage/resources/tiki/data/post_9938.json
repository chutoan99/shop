0,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/f4/28/46/1d5008533fe74f2605e5df0c8b6767eb.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":880,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003e1. Tên sản phẩm: MÁY LỌC NƯỚC NÓNG LẠNH COWAY OMBAK CHP-7310R\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400\"\u003eMáy lọc nước với công nghệ khử trùng tia UV\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e2. Mô tả ngắn gọn\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400\"\u003eThiết kế hiện đại, sang trọng với 2 màu trắng đen\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400\"\u003eBa chế độ nước Nóng - Lạnh - Thường được cung cấp từ bình chứa dung tích 13,5L khổng lồ, và bình chứa nước nóng lớn nhất từ trước tới nay (3,4L)\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400\"\u003e50 cách lựa chọn lấy nước kết hợp các nhiệt độ và dung tích nước khác nhau\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400\"\u003eTăng cường khả năng diệt khuẩn, làm sạch nguồn nước uống với tia UV\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400\"\u003eDễ dàng lấy nước theo lượng chính xác (250ml, 500ml, 1000ml) hoặc liện tục tùy ý theo nhu cầu sử dụng\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400\"\u003eMàn hình điều khiển cảm ứng đa chức năng đáp ứng nhu cầu đa dạng của người dùng\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400\"\u003eTối ưu chi phí sử dụng với nút bật tắt chế độ nước Nóng/Lạnh và chế độ ECO\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400\"\u003eHệ thống lọc 5 bước tích hợp trong 4 lõi lọc loại bỏ tạp chất độc hại theo tiêu chuẩn quốc tế\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400\"\u003eChỉ báo mực nước thấp\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400\"\u003eCảm biến ánh sáng giúp tiết kiệm điện tối ưu\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400\"\u003eChế độ chống bỏng nước nóng an toàn cho gia đình có trẻ em\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400\"\u003eLõi lọc kháng khuẩn chống lại tái nhiễm khuẩn ngay trong bình chứa nước\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e3. Tính năng nổi bật\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400\"\u003e★ Bạn có thể lấy dung tích nước chính xác theo các mục đích khác nhau ở cả 3 chế độ nóng/lạnh/thường chỉ với một cái chạm nhẹ.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400\"\u003e★ Ombak cho phép lựa chọn đến 50 cách lấy nước với nhiệt độ và dung tích khác nhau, cùng với bình chứa nước nóng lên đến 3.4L mang đến những trải nghiệm tốt nhất cho người sử dụng.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400\"\u003e★ Hệ thống lọc 5 bước thông minh tích hợp trong 4 lõi lọc loại bỏ các tạp chất độc hại theo tiêu chuẩn quốc tế và tiêu chuẩn nước uống đóng chai của Việt Nam.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400\"\u003e✓ Bước 1, 2: Lõi lọc Neo-sense (Sediment \u0026#43; Pre-carbon)\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400\"\u003eLõi lọc Neo-sense này có chức năng loại bỏ các hạt, tạp chất hữu cơ và vô cơ hòa tan. Lõi lọc này còn có chức năng khử clo, các hợp chất hữu cơ dễ bay hơi (VOC’s).\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400\"\u003eThời gian thay thế: 6 tháng\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400\"\u003e✓ Bước 3: Lõi lọc kiểu màng (RO)\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400\"\u003eLõi lọc kiểu màng RO có chức năng loại bỏ các chất gây ô nhiễm nước như kim loại nặng, vi sinh vật trong nước và hóa chất hữu cơ có hại, \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400\"\u003eNước có chứa vật chất độc hại này được loại bỏ qua ống nước loại bỏ dưới dạng nước thải.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400\"\u003eThời gian thay thế: 24 tháng\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400\"\u003e✓ Bước 4: Lõi lọc Plus Inno-sense\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400\"\u003eLõi lọc Plus Inno-sense này có chức năng loại bỏ các chất gây mùi và cải thiện mùi vị của nước.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400\"\u003eThời gian thay thế: 18 tháng\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400\"\u003e✓ Bước 5: Lõi lọc kháng khuẩn\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400\"\u003eLõi lọc kháng khuẩn này có chức năng kiểm soát sự lan truyền của vi sinh vật trong nước.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400\"\u003eThời gian thay thế: 12 tháng\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400\"\u003e✓ Bước 6: Tia UV khử trùng\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400\"\u003eHạn chế sự phát triển của các vi sinh vật trong nước.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e4. Thông số kỹ thuật\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400\"\u003e- Công suất lọc: 3,2 ℓ ~ 0,85 gal/giờ\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400\"\u003e- Dung tích bình chứa: \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400\"\u003eNước thường: 7,8 ℓ ~ 2,1 gal  \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400\"\u003eNước lạnh: 2,3 ℓ ~ 0,6 gal  \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400\"\u003eNước nóng: 3,4 ℓ ~ 0,9 gal\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400\"\u003eTổng: 13,5 ℓ ~ 3,6 gal\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400\"\u003e- Điện áp: 220 V, 50 Hz\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400\"\u003e- Điện năng tiêu thụ tối đa:\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400\"\u003eNước lạnh: 0,6 A                                                           \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400\"\u003eNước nóng: 672 W\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400\"\u003eTổng: 765 W\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400\"\u003e- Đèn báo nhiệt độ nước: Có\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400\"\u003e- Chức năng rót nước liên tục: Có\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400\"\u003e- Khóa an toàn nước nóng: Có\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400\"\u003e- Bật/tắt chế độ nước Nóng-Lạnh: Có\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan styl