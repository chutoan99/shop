9,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/5a/48/4a/743e6e7a40fcae4dc3183673377331ba.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1841,"all_time_quantity_sold":4,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eTẩy tế bào da chết chiết xuất từ chanh vàng ARRAHAN LEMON PEELING GEL\u003c/strong\u003e\u003cbr /\u003eThương hiệu : ARRAHAN\u003cbr /\u003eXuất xứ : Hàn Quốc.\u003cbr /\u003eDung tích : 180ml\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/5a/48/4a/14e12c49a8862af976bdc4a8c3a3d58e.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eMÔ TẢ:\u003cbr /\u003eCó thể nói, tẩy tế bào chết là công đoạn đầu tiên và quan trọng nhất trong việc chăm sóc da, bởi hơn 80% chất bụi bẩn bám lại trên da tạo nên lớp tế bào chết này. Một làn da trắng đẹp trước hết phải là một làn da sạch và khỏe mạnh. Tẩy tế bào chết không chỉ giúp da tươi sáng, rạng rỡ hơn mà còn kích thích quá trình tuần hoàn tái tạo da, xóa mờ các vết thâm, xỉn màu, làm tăng hiệu quả của quá trình dưỡng da, giúp các dưỡng chất thấm sâu vào da, nuôi dưỡng da từ bên trong một cách tối ưu.\u003cbr /\u003eGEL tẩy da chết dùng cho mặt: chiết xuất từ các loại trái cây nhanh chóng loại bỏ lớp tế bào chết, đen sạm cùng bụi bẩn trên da đồng thời cung cấp và bổ sung dưỡng chất cho da giúp làn da luôn tươi mát trắng mịn màng.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ae/0e/4e/5b7d441008f6619ce145b25769a97a7c.jpg\" alt=\"\" width=\"750\" height=\"740\" /\u003e\u003c/p\u003e\n\u003cp\u003eCÔNG DỤNG: \u003cbr /\u003eTẩy tế bài chết chanh Arrahan với chiết xuất từ quả chanh, có tính acid nhẹ, sẽ giúp làm sạch và tẩy tế bào chết trên da một cách tự nhiên, cho làn da sạch mịn.\u003cbr /\u003eĐồng thời, những vitamin trong chanh, nhất là Vitamin C sẽ cung cấp dưỡng chất cho làn da thêm mịn màng, và sáng màu hơn.\u003cbr /\u003eĐiều đặc biệt là lớp gel này không hề như các sản phẩm scrub hay gel lột khác. bạn sẽ không phải trải qua cảm giác rát da, mẩn đỏ sau mỗi lần tẩy tế bào chết xong.\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003eCũng như sản phẩm sẽ giúp bạn thư giãn hơn với hương chanh thiên nhiên tươi mát, dễ chịu.\u003cbr /\u003eSử dụng Tẩy tế bài chết chanh Arrahan Chanh đều đặn, bạn sẽ cảm nhận được làn da ngày càng mịn màng, săn chắc và tươi sáng hơn.\u003cbr /\u003eThiết kế Tẩy tế bài chết chanh Arrahan Chanh có thiết kế dạng tuýp, cho bạn tiện lợi khi sử dụng\u003cbr /\u003eSản phẩm thích hợp với mọi loại da.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eHƯỚNG DẪN SỬ DỤNG:\u003cbr /\u003eLấy một lượng gel vừa đủ massage khắp mặt từ 3-5 phút và rửa lại thật sạch bằng nước ấm.\u003cbr /\u003eSử dụng sản phẩm 1-2 lần mỗi tuần.\u003cbr /\u003eBảo quản sản phẩm nơi khô ráo, thoáng mát.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/27/be/4b/0e94a5fde58fa992d758a322f516d21e.png\" alt=\"\" width=\"720\" height=\"960\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCảm ơn quý khách đã ghé thăm shop . Rất mong quý khách chọn cho mình sản phẩm phù hợp dùng . SHOP đảm bảo tất cả sản phẩm SHOP sẽ không làm bạn thất Vọ Chúc Bạn Một Ngày Tốt Là!\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/5a/48/4a/743e6e7a40fcae4dc3183673377331ba.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/5a/48/4a/743e6e7a40fcae4dc3183673377331ba.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/5a/48/4a/743e6e7a40fcae4dc3183673377331ba.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5a/48/4a/743e6e7a40fcae4dc3183673377331ba.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5a/48/4a/743e6e7a40fcae4dc3183673377331ba.jpg"},{"base_url":"https://salt.tikicdn.com/media/catalog/producttmp/d4/f9/6a/e4cbf05ec49889a2fb78ff97a0805484.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/producttmp/d4/f9/6a/e4cbf05ec49889a2fb78ff97a0805484.png","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/producttmp/d4/f9/6a/e4cbf05ec49889a2fb78ff97a0805484.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/producttmp/d4/f9/6a/e4cbf05ec49889a2fb78ff97a0805484.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/producttmp/d4/f9/6a/e4cbf05ec49889a2fb78ff97a0805484.png"},{"base_url":"https://salt.tikicdn.com/ts/product/d7/af/26/549ed6225298cb2d464a96c0966429b8.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d7/af/26/549ed6225298cb2d464a96c0966429b8.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d7/af/26/549ed6225298cb2d464a96c0966429b8.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d7/af/26/549ed6225298cb2d464a96c0966429b8