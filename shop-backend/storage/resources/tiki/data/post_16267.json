rage":4.8,"review_count":13,"review_text":"(13)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/35/12/9f/337d9cfe6d8746eb793b204ec247199b.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1038,"all_time_quantity_sold":118,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003chtml\u003e\n \u003chead\u003e\u003c/head\u003e\n \u003cbody\u003e\n  \u003cul\u003e\n   \u003cp\u003eCông Thức:\u003c/p\u003e\n   \u003cp\u003eTinh chất nghệ, Vitamin E, Vitamin B2, SLES, GMS, CAB, Glycerin, Cetomacrogol 1000, PEG -75 Lanolin, PG, Tween 80, Isopropyl myristat, Nipazin, Nước cất, Nước hoa.\u003c/p\u003e\n   \u003cp\u003eCông Dụng:\u003c/p\u003e\n   \u003cp\u003eLàm sạch bụi cũng như tẩy trang hiệu quả, đặc biệt êm dịu với da và vẫn giữ được độ ẩm cho da, mềm da\u003c/p\u003e\n   \u003cp\u003eChống viêm,sát khuẩn giúp ngăn ngừa mụn cám, giảm nguy cơ nhiễm trùng từ các mụn trứng cá, tiêu giảm vết thâm giúp da trắng và mịn màng.\u003c/p\u003e\n   \u003cp\u003eLiều Dùng - Cách Dùng:\u003c/p\u003e\n   \u003cp\u003eLàm ướt tay và da mặt Cho ít sữa rửa mặt Nghệ Thái Dương vào tay, xoa đều, kỹ và nhẹ nhàng lên da mặt Rửa lại bằng nước sạch\u003c/p\u003e\n   \u003cp\u003eThấm khô nhẹ nhàng bằng khăn sạch, dùng riêng và được phơi ở chỗ có nắng, thoáng gió.\u003c/p\u003e\n   \u003cp\u003eChú Ý:\u003c/p\u003e\n   \u003cp\u003eVới da nhờn, có thể rửa mặt với sữa rửa mặt Nghệ Thái Dương bằng nước có vắt thêm 1/2 quả chanh tươi.\u003c/p\u003e\n   \u003cp\u003eVới da khô, có thể rửa mặt với sữa rửa mặt Nghệ Thái Dương bằng nước muối loãng.\u003c/p\u003e\n   \u003cp\u003eDưỡng da ban đêm bằng Kem Nghệ và Vitamin Thái Dương sau khi rửa mặt bằng sữa rửa mặt Nghệ Thái Dương để làm hết trứng cá, không để lại vết thâm, không để lại sẹo.\u003c/p\u003e\n   \u003cp\u003eSử dụng đồng bộ Sữa rửa mặt Nghệ Thái Dương cùng Kem nghệ \u0026amp; vitamin Thái Dương là cách đơn giản nhất để chăm sóc làn da hiệu quả nhất\u003c/p\u003e\n   \u003cp\u003eTrình Bày: tube 90g\u003c/p\u003e\n   \u003cp\u003eHạn sử dụng: 5 năm kể từ ngày sản xuất\u003c/p\u003e\n   \u003cp\u003eBảo quản: bảo quản nơi khô ráo thoáng mát, tránh ánh nắng mặt trời trực tiếp\u003c/p\u003e\n  \u003c/ul\u003e\n \u003c/body\u003e\n\u003c/html\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/35/12/9f/337d9cfe6d8746eb793b204ec247199b.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/35/12/9f/337d9cfe6d8746eb793b204ec247199b.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/35/12/9f/337d9cfe6d8746eb793b204ec247199b.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/35/12/9f/337d9cfe6d8746eb793b204ec247199b.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/35/12/9f/337d9cfe6d8746eb793b204ec247199b.png"},{"base_url":"https://salt.tikicdn.com/ts/product/f8/09/06/47f2bab1675437f200b696b57c297310.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f8/09/06/47f2bab1675437f200b696b57c297310.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f8/09/06/47f2bab1675437f200b696b57c297310.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f8/09/06/47f2bab1675437f200b696b57c297310.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f8/09/06/47f2bab1675437f