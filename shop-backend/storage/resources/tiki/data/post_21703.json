eturn_policy","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"badges_v3":[{"placement":"pdp_badge","code":"text_badge","type":"text_badge","index":0,"icon":null,"icon_width":0,"icon_height":0,"text_color":"#FFF0F1","background_color":"#D93843","href":null,"text":"9.9"},{"placement":"pdp_badge","code":"is_hero","type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":true,"return_reason":"any_reason"}},"discount":1964200,"discount_rate":14,"rating_average":4.5,"review_count":12,"review_text":"(12)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/d6/6e/d6/f548903a43d88387a9bdfc3c6a9325e9.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":895,"all_time_quantity_sold":18,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3 style=\"text-align:center;\"\u003e\u003cstrong\u003eVƯỢT TRÊN CHUẨN MỰC CỦA CHIẾC MÁY LỌC NƯỚC\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eMáy lọc nước nóng lạnh Karofi KAD-N69 hoàn toàn mới với thiết kế tủ kính tràn viền hiện đại cùng các cải tiến đột phá về tính năng giúp mang đến trải nghiệm mới cho người dùng. Dung tích gấp đôi, ba chế độ nước nóng – lạnh – lọc tiện dụng, ứng dụng công nghệ độc quyền Smax Pro, công nghệ cảm ứng chống tràn, lấy được nước trong trường hợp mất điện… là những ưu điểm đột phá chắc chắn sẽ khiến người dùng hài lòng tuyệt đối.\u003c/p\u003e\n\u003cfigure class=\"sudo-media-item\"\u003e\n\u003cfigure class=\"sudo-media-item\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://sudospaces.com/karofi-com/2022/03/kad-n69-vuot-tren-chuan-muc.jpg\" alt=\"kad-n69-vuot-tren-chuan-muc\" width=\"750\" height=\"428\" /\u003e\u003c/figure\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003c/figure\u003e\n\u003ch3 style=\"text-align:center;\"\u003eĐa năng 3 chế độ nước - Phục vụ đủ nhu cầu cho cả gia đình\u003c/h3\u003e\n\u003cp\u003eMáy lọc nước nóng lạnh KAD-N69 cung cấp 3 chế độ nước: nước lạnh, nước nóng và nước tinh khiết cho cả gia đình sử dụng thoải mái. Bởi vậy dù bạn muốn uống nước mát giải nhiệt, pha café hay mẹ muốn pha sữa cho bé, KAD-N69 đều có thể đáp ứng trong nháy mắt vô cùng tiện lợi.\u003c/p\u003e\n\u003cfigure class=\"sudo-media-item\"\u003e\n\u003cfigure class=\"sudo-media-item\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://sudospaces.com/karofi-com/2022/03/kad-n69-3-che-do.jpg\" alt=\"kad-n69-3-che-do\" width=\"750\" height=\"421\" /\u003e\u003c/figure\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003c/figure\u003e\n\u003ch3 style=\"text-align:center;\"\u003eCông nghệ block hiện đại - Cho nước lạnh sâu, máy bền bỉ\u003c/h3\u003e\n\u003cp\u003eVới công nghệ làm lạnh bằng block, KAD-N69 cho nước lạnh sâu như làm mát trong tủ lạnh, giúp bạn đã khát ngày hè một cách nhanh chóng. Bên cạnh đó ứng dụng công nghệ này giúp máy có độ bền cao, mức tiêu thụ điện thấp hơn, tiết kiệm điện năng hơn so với máy lọc nước nóng lạnh công nghệ chip điện tử\u003c/p\u003e\n\u003cfigure class=\"sudo-media-item\"\u003e\n\u003cfigure class=\"sudo-media-item\"\u003e\n\u003cfigure class=\"sudo-media-item\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://sudospaces.com/karofi-com/2022/03/kad-n69-block-1.jpg\" alt=\"kad-n69-block-1\" width=\"750\" height=\"427\" /\u003e\u003c/figure\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003c/figure\u003e\n\u003c/figure\u003e\n\u003ch3 style=\"text-align:center;\"\u003eVan chuyên dụng - Mất điện không lo hết nước\u003c/h3\u003e\n\u003cp\u003eSo với các dòng máy thông thường, KAD-N69 có một ưu điểm nổi bật là người dùng lấy được nước trong trường hợp mất điện. Dù máy không hoạt động khi có sự cố mất điện nhưng người dùng vẫn có thể dùng van chuyên dụng để lấy nước và sử dụng bình thường. Như vậy, bạn không cần phải lo ngại việc mất điện sẽ không có nước sử dụng.\u003c/p\u003e\n\u003cfigure class=\"sudo-media-item\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://sudospaces.com/karofi-com/2022/03/karofi-kad-n69-van-chuyen-dung.jpg\" alt=\"karofi-kad-n69-van-chuyen-dung\" width=\"750\" height=\"421\" /\u003e\u003c/figure\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch3 style=\"text-align:center;\"\u003eHệ thống 10 lõi lọc Smax Pro độc quyền - Nhân đôi công suất, gấp đôi tuổi thọ\u003c/h3\u003e\n\u003cp\u003eMáy lọc nước nóng lạnh KAD-N69 sở hữu hệ thống 10 lõi lọc mạnh mẽ mang đến hiệu suất cao vượt trội: Nhân đôi công suất, gấp đôi tuổi thọ. Đặc biệt với bộ 3 lõi lọc thô ứng dụng công nghệ Smax Pro tăng gấp 3 lần diện tích tiếp xúc với nước, nâng cao gấp 2 lần hiệu quả lọc, tăng khả năng loại bỏ tạp chất, cặn bẩn. Hệ lõi chức năng cao cấp gấp 2 lần lượng Hydrogen với lõi Hydrogen Plus và kết hợp 3 lõi Orp Alkaline, Tourmaline, Hydrogen Plus cho nước có chỉ số Hydro, pH, Orp tối ưu cho sức khỏe.\u003c/p\u003e\n\u003cfigure class=\"sudo-media-item\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://sudospaces.com/karofi-com/2022/03/karofi-kad-n69-smax-pro.jpg\" alt=\"karofi-kad-n69-smax-pro\" width=\"750\" height=\"421\" /\u003e\u003c/figure\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch3 style=\"text-align:center;\"\u003eCông nghệ AioTec thông minh - Giám sát độ sạch của nước từ xa, an tâm toàn diện\u003c/h3\u003e\n\u003cp\u003eVới công nghệ AioTec bạn có thể an tâm kiểm soát chất lượng nước mọi lúc mọi nơi kể cả khi vắng nhà. Đây cũng là xu hướng của các gia đình hiện đại, chỉ cần sở hữu điện thoại thông minh tải ứng dụng Karofi 365, bạn có thể kiểm tra được: độ sạch của nước, thời hạn thay lõi lọc, tình trạng máy, kích hoạt bảo hành, liên hệ nhanh tới CSKH…\u003c/p\u003e\n\u003cfigure class=\"sudo-media-item\"\u003e\n\u003cfigure class=\"sudo-media-item\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://sudospaces.com/karofi-com/2022/03/kad-n69-aiotec.jpg\" alt=\"kad-n69-aiotec\" width=\"750\" height=\"421\" /\u003e\u003c/figure\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003c/figure\u003e\n\u003ch3 style=\"text-align:center;\"\u003eThiết kế tinh tế - Tủ kính tràn viền ấn tượng\u003c/h3\u003e\n\u003cp\u003eKAD-N69 được thiết kế theo phong cách mới với tủ kính tràn viền hiện đại, ấn tượng. Mặt kính cường lực sang trọng, màu sắc hiện đại hòa quyện hoàn hảo với mọi không gian sống, bạn có thể đặt bất kỳ vị trí nào trong nhà đều nổi bật, đẹp mắt.\u003c/p\u003e\n\u003cfigure class=\"sudo-media-item\"\u003e\n\u003cfigure class=\"sudo-media-item\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://sudospaces.com/karofi-com/2022/03/kad-n69-thiet-ke-tran-vien.jpg\" alt=\"kad-n69-thiet-ke-tran-vien\" width=\"750\" height=\"421\" /\u003e\u003c/figure\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003c/figure\u003e\n\u003ch3 style=\"text-align:center;\"\u003eCông nghệ cảm ứng chống tràn – Tự động ngắt nước tức thì\u003c/h3\u003e\n\u003cp\u003eKAD-N69 hiện đại được trang bị cảm ứng chống tràn ngay dưới mặt bàn phím cảm ứng của máy lọc nước, bởi vậy trong quá trình sử dụng khi nước tràn ra bề mặt bàn phím do quên khóa vòi hoặc có sự cố, cảm biến sẽ được kích hoạt để tắt vòi nước ngay lập tức nhằm tránh lãng phí nước cũng như hạn chế rủi ro hỏng sàn gỗ. Đây là một tính năng vô cùng tiện nghi của máy lọc nước nóng lạnh KAD-N69.\u003c/p\u003e\n\u003cfigure class=\"sudo-media-item\"\u003e\n\u003cfigure class=\"sudo-media-item\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://sudospaces.com/karofi-com/2022/03/kad-n69-cam-ung.jpg\" alt=\"kad-n69-cam-ung\" width=\"750\" height=\"421\" /\u003e\u003c/figure\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003c/figure\u003e\n\u003ch3 style=\"text-align:center;\"\u003eNước sau lọc đạt chuẩn nước uống tinh khiết đóng chai QCVN 6-1:2010 BYT\u003c/h3\u003e\n\u003cp\u003eNguồn nước sau lọc từ máy lọc nước nóng lạnh Karofi KAD-N69 đạt chuẩn nước uống tinh khiết đóng chai QCVN 6-1:2010 BYT do Viện Sức khỏe nghề nghiệp \u0026amp; Môi trường – Bộ Y Tế công nhận. \u003c/p\u003e\n\u003cfigure class=\"sudo-media-item\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://sudospaces.com/karofi-com/2022/03/karofi-kad-n69-qcvn6.jpg\" alt=\"karofi-kad-n69-qcvn6\" width=\"750\" height=\"421\" /\u003e\u003c/figure\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch3 style=\"text-align:center;\"\u003eBảo hành 36 tháng - Cao nhất thị trường\u003c/h3\u003e\n\u003cp\u003eKarofi cam kết sẽ mang lại trải nghiệm tuyệt vời nhất cho quý khách hàng với sự Tận tâm - Chuyên nghiệp - Chuẩn chuyên gia.\u003c/p\u003e\n\u003cfigure class=\"sudo-media-item\"\u003e\n\u003cfigure class=\"sudo-media-item\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://sudospaces.com/karofi-com/2022/03/kad-n69-bao-hanh-36-thang.jpg\" alt=\"kad-n69-bao-hanh-36-thang\" width=\"750\" height=\"421\" /\u003e\u003c/figure\u003e\n\u003cp\u00