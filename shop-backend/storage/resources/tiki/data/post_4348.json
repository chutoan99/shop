":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/d9/8f/c8/375b47c49a03c251d416223364ff74d1.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1175,"all_time_quantity_sold":3,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003e\u003cspan style=\"color:#333300\"\u003eGIỚI THIỆU\u003c/span\u003e\u003c/h3\u003e\n\u003ch3\u003e\u003cspan style=\"color:#333300\"\u003e\u003cstrong\u003eKem Chống Nắng 3 Tác Động Chicco Baby Moments SPF 50\u0026#43; tốt như thế nào?\u003c/strong\u003e\u003c/span\u003e\u003c/h3\u003e\n\u003cp\u003e\u003cspan style=\"color:#333300\"\u003eKem chống nắng \u003cstrong\u003e3 TÁC ĐỘNG\u003c/strong\u003e Chicco có chỉ số \u003cstrong\u003eSPF cao (50\u0026#43;)\u003c/strong\u003e giúp bảo vệ Mẹ, Bé và cả gia đình khỏi tác hại của ánh nắng Mặt trời.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/d9/8f/c8/c6f07b1e01b7d83c0e0049efca5142e7.png\" alt=\"\" width=\"500\" height=\"500\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003ch4\u003e\u003cspan style=\"color:#333300\"\u003e1/ BẢO VỆ DA TOÀN DIỆN (3P Complex) trước tác động của tia UV và tia hồng ngoại:\u003c/span\u003e\u003c/h4\u003e\n\u003cp\u003e\u003cspan style=\"color:#333300\"\u003eMàng lọc tia UV với công thức 5 hoạt chất giúp hấp thu hiệu quả cả hai loại tia UVA, UVB và bảo vệ da khỏi các tác động từ:\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color:#333300\"\u003e\u003cstrong\u003e\u0026#43;\u003c/strong\u003e \u003cstrong\u003eTia UVA –\u003c/strong\u003e là tác nhân gây biến đổi cấu trúc và sắc tố da, lão hóa da và các mối nguy hiểm khác cho da.Tia UVA chiếm đến 90% tia tử ngoại (UV), xuất hiện ngay cả trong những ngày trời nhiều mây, trong bóng râm và thậm chí có thể xuyên qua cả kính\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color:#333300\"\u003e\u003cstrong\u003e\u0026#43; Tia UVB –\u003c/strong\u003e là tác nhân gây nám da, sạm da, cháy nắng\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color:#333300\"\u003e\u003cstrong\u003eBảo vệ da trước tia hồng ngoại:\u003c/strong\u003e \u003cstrong\u003eChiết xuất Physalis\u003c/strong\u003e từ tự nhiên đóng vai trò là hoạt chất \u003cstrong\u003echống oxy hóa\u003c/strong\u003e, giúp \u003cstrong\u003ebảo vệ da khỏi tác động từ tia hồng ngoại\u003c/strong\u003e cùng \u003cstrong\u003etia UV,\u003c/strong\u003e làm dịu da ngay cả trong và sau quá trình tiếp xúc với ánh nắng mặt trời.\u003c/span\u003e\u003c/p\u003e\n\u003ch4\u003e\u003cspan style=\"color:#333300\"\u003e2/ TÁC ĐỘNG KÉP\u003c/span\u003e\u003c/h4\u003e\n\u003cp\u003e\u003cspan style=\"color:#333300\"\u003e\u003cstrong\u003eVừa giữ ẩm vừa dưỡng da:\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color:#333300\"\u003e\u0026#43; \u003cstrong\u003eGlycerin\u003c/strong\u003e cùng các hoạt chất tích cực giữ độ ẩm cho da, giúp da không bị khô rát, ngăn ngừa hiện tượng cháy nắng.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color:#333300\"\u003e\u003cstrong\u003e\u0026#43;Bộ đôi vitamin E cùng chiết xuất từ Jojoba\u003c/strong\u003e giúp dưỡng da, bảo vệ da hiệu quả hơn trong quá trình tiếp xúc với ánh nắng.\u003c/span\u003e\u003c/p\u003e\n\u003ch4\u003e\u003cspan style=\"color:#333300\"\u003e3/ CÔNG THỨC ĐẶC BIỆT\u003c/span\u003e\u003c/h4\u003e\n\u003cp\u003e\u003cspan style=\"color:#333300\"\u003e\u003cstrong\u003eDành cho da nhạy cảm:\u003c/strong\u003e Thành phần an toàn, \u003cstrong\u003ekhông chứa cồn\u003c/strong\u003e, \u003cstrong\u003ekhông parabens\u003c/strong\u003e, \u003cstrong\u003ekhông nước hoa\u003c/strong\u003e và được \u003cstrong\u003echứng nhận kiểm nghiệm phù hợp với da nhạy cảm\u003c/strong\u003e. Thích hợp cho trẻ từ sơ sinh.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color:#333300\"\u003e\u003cstrong\u003e4/\u003c/strong\u003e Kem \u003cstrong\u003eTHẤM HÚT NHANH, KHÔNG GÂY NHỜN RÍT\u003c/strong\u003e:Các hoạt chất trong thành phần giúp giảm bóng dầu, giữ da khô thoáng, không bị nhờn rít sau khi thoa kem.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color:#333300\"\u003e\u003cstrong\u003e5/ Khả năng chịu nước tốt:\u003c/strong\u003e Kem chống nắng 3 tác động có các hoạt chất đóng vai trò chống nước, giúp kem bền và lâu trôi hơn.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color:#333300\"\u003e\u003cstrong\u003e6/ Sản phẩm được Cơ quan Quản lý tại Hoa Kỳ, Nhật Bản, EU và hơn 100 quốc gia chứng nhận an toàn.\u003c/strong\u003e Tại Việt Nam, sản phẩm đã được Bộ Y tế cấp giấy phép lưu hành số 32440/17/CBMP-QLD.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/19/c7/6f/dd38688d32e938ec6c32e76587c7b9a1.png\" alt=\"\" width=\"500\" height=\"500\" /\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cspan style=\"color:#333300\"\u003eĐỐI TƯỢNG SỬ DỤNG\u003c/span\u003e\u003c/h3\u003e\n\u003cp\u003eThích hợp cho trẻ từ sơ sinh, mẹ bầu, cả gia đình.\u003c/p\u003e\n\u003ch3\u003e\u003cspan style=\"color:#333300\"\u003eHƯỚNG DẪN SỬ DỤNG\u003c/span\u003e\u003c/h3\u003e\n\u003cul\u003e\u003cli\u003e\n\u003cp\u003e\u003cspan style=\"color:#333300\"\u003eLắc kỹ trước khi bôi. Lưu ý bôi kem trước ít nhất 20 phút. Thường xuyên bôi nhắc lại trong ngày và đặc biệt sau khi da tiếp xúc với nước.\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\u003cli\u003e\n\u003cp\u003e\u003cspan style=\"color:#333300\"\u003eĐối với trẻ sơ sinh, chỉ cần bôi các vùng da hở (không được bảo vệ bởi quần áo). Tránh để kem chống nắng 3 tác động tiếp xúc với vùng mắt.\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\u003c/ul\u003e\n\u003ch3\u003eTHÔNG TIN SẢN PHẨM\u003c/h3\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eTên sản phẩm:\u003c/strong\u003e Kem chống nắng 3 tác động Chicco SPF 50\u0026#43; 75ml cho bé\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eSản xuất tại:\u003c/strong\u003e Ý (Italy)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eĐộ tuổi sử dụng:\u003c/strong\u003e cho trẻ từ sơ sinh (0M\u0026#43;)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eThàng phần và dung tích:\u003c/strong\u003e xem trên bao bì\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eHạn sử dụng:\u003c/strong\u003e 4 năm kể từ ngày sản xuất\u003c/li\u003e\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/d9/8f/c8/375b47c49a03c251d416223364ff74d1.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d9/8f/c8/375b47c49a03c251d416223364ff74d1.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d9/8f/c8/375b47c49a03c251d416223364ff74d1.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d9/8f/c8/375b47c49a03c251d416223364ff74d1.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d9/8f/c8/375b47c49a03c251d416223364ff74d1.png"},{"base_url":"https://salt.tikicdn.com/ts/product/19/c7/6f/6ebdfdd9c8a084e61a1700aa914aad59.png","is_gallery":true,"label":null,"la