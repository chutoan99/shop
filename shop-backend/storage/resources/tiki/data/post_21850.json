n_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":225000,"discount_rate":10,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/b6/f5/0b/4a7afc0123cdf53dbdfe9dd45ded7ef3.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":709,"all_time_quantity_sold":3,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2\u003eMáy xay nấu làm sữa hạt Kalpen CBK-2601 thương hiệu Đức, bảo hành 2 năm\u003c/h2\u003e\n\u003cp\u003eThương hiệu: Kalpen thương hiệu Đức\u003cbr /\u003eModel: CBK-2601\u003cbr /\u003e- Điện Áp: 220-240V~50/60Hz\u003cbr /\u003e- Công Suất: Xay: 1000W, Nấu : 800W\u003cbr /\u003e- Dung tích: 1.75 Lít \u003cbr /\u003e- Menu 12 chế độ cài đặt sẵn\u003cbr /\u003e- Điểu khiển: phím cảm ứng\u003cbr /\u003e- Kích thước: 44 x 26.7 x 31.5cm\u003cbr /\u003e- Trọng lượng: 4.8kg\u003cbr /\u003e- Màu: xanh xám\u003cbr /\u003e- Sản xuất tại Trung Quốc\u003cbr /\u003eBảo hành 24 tháng, lỗi 1 đổi 1 trong 10 ngày chính hãng Kalpen Việt Nam\u003c/p\u003e\n\u003cp\u003e\u003ciframe src=\"https://www.youtube.com/embed/jhw3tb4khz0\" width=\"100%\" height=\"315\"\u003e\u003c/iframe\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://sanhangre.net/image/catalog/san-pham-2021/kalpen/may-lam-sua-hat-kalpen/may-lam-sua-hat-kalpen-2601-18.jpg\" alt=\"Máy xay nấu làm sữa hạt Kalpen CBK-2601\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTÍNH NĂNG NỒI BẬT CỦA MÁY LÀM SỮA HẠT KALPEN CBK-2601:\u003c/strong\u003e\u003cbr /\u003e- Máy làm sữa hạt KALPEN CBK-2601 là dòng máy xay nấu đa năng đến từ thương hiệu Kalpen GmbH của Đức.\u003cbr /\u003eTích hợp nhiều tính năng như: nấu sữa hạt, xay sữa hạt, làm sữa thảo mộc đa năng siêu mịn, hoạt động bền bỉ, độ ồn thấp, thiết kế sang trọng.\u003cbr /\u003e- Thiết kế thông minh với 12 chương trình nấu được lập trình sẵn công việc của bạn chỉ cần nhấn nút và tận hưởng thời gian rảnh rỗi của mình.\u003cbr /\u003e- Được nghiên cứu và sản xuất bởi tập đoàn Kalpen GmbH của Đức nên tính năng an toàn được đặt lên hàng đầu, chính vì thế máy được thiết kế với 2 cảm biến chống tràn kép cho bạn cảm giác an tâm khi sử dụng.\u003cbr /\u003e- Mạnh mẽ và bền bỉ với động cơ công suất lớn :\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://sanhangre.net/image/catalog/san-pham-2021/kalpen/may-lam-sua-hat-kalpen/may-lam-sua-hat-kalpen-2601-2.jpg\" alt=\"Máy xay nấu làm sữa hạt Kalpen CBK-2601\" /\u003e\u003c/p\u003e\n\u003cp\u003e- Đông cơ cực khỏe với công suất 1000W tạo ra lực xoắn với tốc độ 56000 r/phút.\u003cbr /\u003e- Lõi mô tơ được quấn bằng đồng nguyên chất, làm tăng tuổi thọ của động cơ lên đến 10 năm.\u003cbr /\u003e- Kết cấu lưỡi dao đặc biệt với chất liệu Inox 420 với độ cứng lên tới 50HRC. Gồm 8 lưỡi dao cùng vận hành 1 lúc giúp xay mọi loại thực phẩm mà bạn cần.\u003cbr /\u003e- Chất liệu an toàn và bền bỉ.\u003cbr /\u003e- Tiện lợi với chế độ hẹn giờ lên tới 12 tiếng.\u003cbr /\u003e- Chế độ bảo vệ mạnh mẽ cho người sử dụng\u003cbr /\u003e- Máy sẽ không hoạt động nếu nắp của sản phẩm chưa được đậy hoặc đậy không đúng cách.\u003cbr /\u003e- Động cơ của máy củng sẽ không hoạt động khi bạn nhấn nút khi mà cối thủy tinh chưa đặt đúng vị trí của nó.\u003cbr /\u003e- Cối thủy tinh cao cấp có dộ dày lên tới 6mm. Được thiết kế đặc biệt với 6 gờ nhô cao giúp máy xay trộn 1 cách hiệu quả hơn so với các dòng máy có cối chỉ có 4 cạnh gờ.\u003cbr /\u003e. Vệ sinh dễ dàng và tiện lợi.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://sanhangre.net/image/catalog/san-pham-2021/kalpen/may-lam-sua-hat-kalpen/may-lam-sua-hat-kalpen-2601-16.jpg\" alt=\"Máy xay nấu làm sữa hạt Kalpen CBK-2601\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eGiới thiệu tính năng nổi bật của Máy làm sữa hạt KALPEN CBK-2601\u003c/strong\u003e\u003cbr /\u003e- Máy làm sữa hạt KALPEN CBK-2601 là dòng máy xay nấu đa năng đến từ thương hiệu Kalpen GmbH của Đức. Đây là dòng sản phẩm tích hợp nhiều tính năng như: nấu sữa hạt, xay sữa hạt, làm sữa thảo mộc đa năng siêu mịn, hoạt động bền bỉ, độ ồn thấp, thiết kế sang trọng, nhiều tính năng công nghệ tiên tiến sẽ mang lại cho gia đình bạn những ly sữa hạt thơm ngon hấp dẫn và nhiều dinh dưỡng.\u003cbr /\u003e- Máy làm sữa hạt KALPEN CBK-2601 vô cùng đa năng và tiện lợi với thiết kế thông minh với 12 chương trình nấu được lập trình sẵn công việc của bạn chỉ cần nhấn nút và tận hưởng thời gian rảnh rỗi của mình.\u003cbr /\u003e- Được nghiên cứu và sản xuất bởi tập đoàn Kalpen GmbH của Đức nên tính năng an toàn được đặt lên hàng đầu, chính vì thế máy được thiết kế với 2 cảm biến chống tràn kép cho bạn cảm giác an tâm khi sử dụng.\u003cbr /\u003e- Với sản phẩm Máy làm sữa hạt KALPEN CBK-2601 thương hiệu Kalpen được Kalpen bảo hành 2 năm. Nếu trong quá trình sử dụng mà bạn gặp bất cứ vấn đề gì về Máy làm sữa hạt KALPEN CBK-2601 và cách sử dụng bếp từ trong thời gian được bảo hành thì đều có thể mang tới trung tâm bảo hành của Kalpen hoặc gọi tới phòng chăm sóc khách hàng để được tư vấn và giải đáp cụ thể.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://sanhangre.net/image/catalog/san-pham-2021/kalpen/may-lam-sua-hat-kalpen/may-lam-sua-hat-kalpen-2601-17.jpg\" alt=\"Máy xay nấu làm sữa hạt Kalpen CBK-2601\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://sanhangre.net/image/catalog/san-pham-2021/kalpen/may-lam-sua-hat-kalpen/may-lam-sua-hat-kalpen-2601-15.jpg\" alt=\"Máy xay nấu làm sữa hạt Kalpen CBK-2601\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://sanhangre.net/image/cat