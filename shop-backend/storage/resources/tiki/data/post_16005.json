t":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":191000,"discount_rate":52,"rating_average":4.5,"review_count":45,"review_text":"(45)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ab/c7/3f/2bba448f7db7d61f35722ed1309b5203.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1087,"all_time_quantity_sold":221,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2\u003eCÔNG DỤNG CỦA ĐỆM THẮT LƯNG EMA\u003c/h2\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/43/c1/1f/404e6d55cc939f5d209f895d5c8421c9.jpg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/43/c1/1f/404e6d55cc939f5d209f895d5c8421c9.jpg\" alt=\"\" width=\"690\" height=\"960\" /\u003e\u003c/p\u003e\n\u003cp style=\"font-size: 18px;\"\u003eĐệm thắt lưng Ema giúp lấp đầy những khoảng trống của cơ thể được tạo ra khi bạn nằm ngủ: vùng eo, vùng khoeo chân. Các khoảng trống này được tạo ra theo đường cong cơ thể con người, khi nằm xuống sẽ khiến các vùng thắt lưng hay khoeo chân chịu các lực không bình thường\u003c/p\u003e\n\u003cul\u003e\n\u003cli style=\"font-size: 18px;\"\u003eKê thắt lưng giảm đau cho các trường hợp bị tổn thương cột sống thắt lưng: người bị thoát vị đĩa đệm, thoái hóa đốt sống lưng, người cao tuổi bị các vấn đề xương khớ\u003c/li\u003e\n\u003cli style=\"font-size: 18px;\"\u003eKê thắt lưng cho bà bầu - đối tượng bị đau thắt lưng do sức nặng của bào thai gây nên\u003c/li\u003e\n\u003cli style=\"font-size: 18px;\"\u003eKê khoeo chân giảm căng cơ, tạo cảm giác thư giãn, thoải mái\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch2\u003eMÔ TA CHI TIẾT ĐỆM THẮT LƯNG EMA\u003c/h2\u003e\n\u003cp style=\"font-size: 18px;\"\u003e\u003cstrong\u003eThiết kế: \u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/38/ff/c1/3dd36de773d04e0ce33d7e894005fdae.jpg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/38/ff/c1/3dd36de773d04e0ce33d7e894005fdae.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"font-size: 18px;\"\u003eĐệm lưng Ema được thiết kế theo hình tam giác cân với chiều cao 4cm. Đây là thiết kế chuyên biệt giúp đệm lấp đầy khoảng trống ở dưới phần thắt lưng. Và tại sao điều này lại quan trọng đến thế?\u003c/p\u003e\n\u003cp style=\"font-size: 18px;\"\u003eĐường cong sinh lý của cột sống là đường cong cột sống ở người bình thường. Ở người bình thường thì khi nhìn cột sống từ bên thì cột sống uốn cong theo đường cong cơ thể, hơi cong về phía trước ở phần cột sống thắt lưng. Chính điều này làm cho khi ngủ (đặc biệt khi nằm nghiêng) sẽ tạo ra khe hở, cột sống thắt lưng ở trạng thái treo cong. Đối với những người thường xuyên mang vác vật nặng, làm việc cúi người hoặc người thoát vị đĩa đệm tư thế này sẽ gây đau, mỏi vùng thắt lưng\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/0a/d8/de/f57f37ba578a21ba138fd2abb04316a9.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003eẢnh minh họa: Đệm giúp nâng đỡ thắt lưng từ đó giữ cột sống cong theo đường cong sinh lý tự nhiên\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"font-size: 18px;\"\u003eĐệm thắt lưng Ema với thiết kế theo công thái học cột sống giúp người sử dụng \"lấp đầy\" vùng hẫng này, từ đó giải phóng áp lực lên cột sống thắt lưng, giúp cột sống luôn theo đường cong sinh lý của cơ thể (trạng thái tự nhiên nhất)\u003c/p\u003e\n\u003cp style=\"font-size: 18px;\"\u003e\u003cstrong\u003eĐiểm nổi bật: \u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/9a/ff/de/105d8c69a3e52b98156e7f04d03a083d.jpg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/9a/ff/de/105d8c69a3e52b98156e7f04d03a083d.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"font-size: 18px;\"\u003eKhông giống như các loại gối đệm thắt lưng thông thường, đệm thắt lưng Ema có chiều rộng vượt trội giúp người sử dụng xoay trở thoải mái khi nằm. Từ đó giúp người sử dụng thư giãn, không phải chịu các cơn đău thắt lưng, thoải mái xoay trở dù nằm ngửa hay nằm nghiêng. \u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/71/d3/d8/9f27f58b3e609a7bea5eb21eb79cb1b3.jpg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/71/d3/d8/9f27f58b3e609a7bea5eb21eb79cb1b3.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"font-size: 18px;\"\u003e\u003cstrong\u003eKích thước:\u003c/strong\u003e Dài 24cm - vừa khít vào vùng thắt lưng. Rộng 60cm - rộng hơn tất các các loại gối, đệm thắt lưng truyền thống giúp người dùng thoải mái xoay trở, không sợ bị trượt ra khỏi gối. Cao 4cm - chiều cao tiêu chuẩn phù hợp với vóc dáng người Việt, vừa khít vào vùng cong của thắt lưng\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/37/41/cc/d03a2668166b6b9564b3ff0d927b590d.jpg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/37/41/cc/d03a2668166b6b9564b3ff0d927b590d.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"font-size: 18px;\"\u003e\u003cstrong\u003eVỏ gối:\u003c/strong\u003e Gối được thiết kế gồm 2 lớp vỏ có khóa kéo giúp tiện lợi trong việc tháo giặt vệ sinh. Vỏ ngoài được làm từ vải nhung co giãn 4 chiều, trên mặt có hàng trăm lỗ nhỏ giúp điều hòa không khí. Vỏ lót móng hơn được làm từ vải mắt chim siêu thoáng\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/62/11/7d/a8b322fda95cc47dfe5cf7e1759e5f81.jpg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/62/11/7d/a8b322fda95cc47dfe5cf7e1759e5f81.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"font-size: 18px;\"\u003e\u003cstrong\u003eRuột gối: \u003c/strong\u003eĐược làm từ 100% cao su non với đặc tính đàn hồi chậm, giúp lấp đầy một cách êm ái vùng thắt lưng khi bạn nằm lên, từ đó giảm áp lực và giảm đau lên khu vực này. \u003c/p\u003e\n\u003cp style=\"font-size: 18px;\"\u003eMemory Foam (cao su non) với đặc tính chậm đàn hồi là vật liệu do trung tâm vũ trụ NASA phát minh vào năm 1966 nhằm nâng cao sự an toàn cho các phần nệm của thiết bị bay nhằm giảm thiểu tối đa áp lực tác động lên các phi hành gia và rung chấn trong quá trình phóng tàu vũ trụ. Ngày này chất liệu này được sử dụng rất nhiều trong ngành công nghiệp gối - đệm\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/d6/7c/1c/a078a5a31462bbbf661fe1633456d65f.jpg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/d6/7c/1c/a078a5a31462bbbf661fe1633456d65f.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003eẢnh minh họa: Dùng trứng sống ấn lên đệm - trứng không hề vỡ do đệm đã phân tán gần hết áp lực gây ra\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"font-size: 18px;\"\u003e\u003cstrong\u003eẢnh thực tế sản phẩm:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/b0/86/11/fb3531e6883c199c99f325c05aed7a00.jpg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/b0/86/11/fb3531e6883c199c99f325c05aed7a00.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/66/61/70/1a543ee47f342a97388322c3044927b4.jpg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/66/61/70/1a543ee47f342a97388322c3044927b4.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"font-size: 18px;\"\u003e\u003cstrong\u003eMàu sắc:\u003c/strong\u003e gối có 2 màu trung tính phù hợp với cả nam, nữ tất cả các độ tuổi là Xanh và Xám\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/df/36/5d/5c284c2b8abc914d6791580abb6f13a3.jpg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/df/36/5d/5c284c2b8abc914d6791580abb6f13a3.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/9c/97/04/74f50285b42056257d6bee1951186f0c.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ab/c7/3f/2bba448f7db7d61f35722ed1309b5203.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ab/c7/3f/2bba448f7db7d61f35722ed1309b5203.jpg","medium_url":"https://salt.tikicdn