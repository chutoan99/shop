xt_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"defective_product"}},"discount":0,"discount_rate":0,"rating_average":4.8,"review_count":4,"review_text":"(4)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/50/35/68/6ee01d274ff5e6a70fdff1c3b4fee0b1.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2003,"all_time_quantity_sold":23,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eTÊN SẢN PHẨM: Nước hoa Nam Gota Bouncy 50ml\u003c/p\u003e\n\u003cp\u003eLOẠI NƯỚC HOA: Eau De Parfum (EDP)\u003c/p\u003e\n\u003cp\u003eDÒNG: Gota\u003cbr /\u003e- Phức hợp mùi hương trong Gota Bouncy thể hiện một chút phức tạp trong tính cách của các chàng: bí ẩn, táo bạo nhưng không kém phần tinh tế, quyến rũ\u003c/p\u003e\n\u003cp\u003eTHÔNG TIN SẢN PHẨM: \u003cbr /\u003e- Mùi hương: Hương thơm sảng khoái và nồng ấm\u003cbr /\u003e- Tầng hương: 3 tầng hương rõ rệt.\u003cbr /\u003eHương thơm mở ra với hương cam quýt ngào ngạt pha lẫn một chút vị tarragon. Ở hương giữa, mùi hương của oải hương và gỗ tuyết tùng xuất hiện, kết hợp với hương táo rất nhẹ và dễ gần. Lớp hương cuối đóng lại với mùi hương trầm ấm kéo dài rất đặc trưng của vani, xạ hương và hổ phách.\u003cbr /\u003e- Nốt hương: \u003cbr /\u003e+ Hương đầu: hương chanh, hương quýt, (tarragon) cây ngải giấm\u003cbr /\u003e+ Hương giữa: (lavandin) hương hoa oải hương, gỗ tuyết tùng, hương táo\u003cbr /\u003e+ Hương cuối: hổ phách, hương vani, xạ hương\u003cbr /\u003e-Dung tích: 50ml\u003cbr /\u003e-Độ lưu hương: 8H\u003c/p\u003e\n\u003cp\u003ePHÂN LOẠI SẢN PHẨM:\u003cbr /\u003eDòng Nước hoa Gota có 3 loại chính: \u003cbr /\u003e- Bouncy\u003cbr /\u003e- Iconic\u003cbr /\u003e- Urban\u003c/p\u003e\n\u003cp\u003eHƯỚNG DẪN SỬ DỤNG: \u003cbr /\u003e- Hướng vòi xịt vào vị trí cần xịt, cách cơ thể khoảng 15 - 20 cm.\u003cbr /\u003e- Xịt ở những vùng cơ thể tập trung nhiều mạch máu, da ẩm và nhạy cảm như cổ tay, sau gáy, giữa ngực, để hương thơm có thể khuếch tán đồng thời cũng giữ mùi được lâu hơn.\u003cbr /\u003e- Hạn chế xịt trực tiếp lên quần áo và đồ trang sức. Cất nước hoa ở những nơi thoáng mát, không bị ánh nắng chiếu trực tiếp vào sẽ giúp chai nước hoa không bị biến chất, mất mùi.\u003c/p\u003e\n\u003cp\u003eHẠN SỬ DỤNG: \u003cbr /\u003e- 3 năm kể từ ngày sản xuất\u003c/p\u003e\n\u003cp\u003eXUẤT XỨ: \u003cbr /\u003e- Việt Nam\u003c/p\u003e\n\u003cp\u003eĐẶC ĐIỂM NỔI BẬT:\u003cbr /\u003e- Nhà chế tác nước hoa hàng đầu thế giới: Robertet\u003cbr /\u003e- Hương liệu nhập khẩu từ Châu Âu\u003cbr /\u003e- Nhà máy sản xuất đạt tiêu chuẩn CGMP và IFra\u003cbr /\u003e- Lưu hương: 6-8h\u003c/p\u003e\n\u003cp\u003eLƯU Ý:\u003cbr /\u003e- Không được xịt vào mắt.\u003cbr /\u003e- Không để nới có nhiệt độ cao.\u003cbr /\u003e- Để xa tầm tay trẻ em.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/50/35/68/6ee01d274ff5e6a70fdff1c3b4fee0b1.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/50/35/68/6ee01d274ff5e6a70fdff1c3b4fee0b1.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/50/35/68/6ee01d274ff5e6a70fdff1c3b4fee0b1.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/50/35/68/6ee01d274ff5e6a70fdff1c3b4fee0b1.png","thumbnail_url":