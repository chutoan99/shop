thể diễn ra\u003c/p\u003e\n\u003cp\u003e3. CHIẾC SOFA HOÀN HẢO\u003c/p\u003e\n\u003cp\u003eCánh Cụt và Gấu Trúc quyết định chiếc ghế sofa cũ cần được thay thế và bắt đầu tìm một chiếc sofa hoàn hảo. Nhưng dường như không có chiếc ghế sofa nào có thể đáp ứng được yêu cầu như chiếc sofa cũ …\u003c/p\u003e\n\u003cp\u003eSách phù hợp cho bé từ 2-8 tuổi. Sách bìa cứng, tranh vẽ sinh động, giấy in chống loá, thân thiện với mắt trẻ.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/d5/0a/c6/c9f36a74018a4857811dca6a169a5984.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d5/0a/c6/c9f36a74018a4857811dca6a169a5984.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d5/0a/c6/c9f36a74018a4857811dca6a169a5984.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d5/0a/c6/c9f36a74018a4857811dca6a169a5984.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d5/0a/c6/c9f36a74018a4857811dca6a169a5984.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/c7/c2/c6/99c6e4f78a9c0dae7ff02fd9399a120b.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c7/c2/c6/99c6e4f78a9c0dae7ff02fd9399a120b.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c7/c2/c6/99c6e4f78a9c0dae7ff02fd9399a120b.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c7/c2/c6/99c6e4f78a9c0dae7ff02fd9399a120b.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c7/c2/c6/99c6e4f78a9c0dae7ff02fd9399a120b.png"},{"base_url":"https://salt.tikicdn.com/ts/product/59/4d/