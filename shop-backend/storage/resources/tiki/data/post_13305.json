4800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.6,"review_count":93,"review_text":"(93)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/70/ec/5b/ecab3b9d984690de4dadfad959166d64.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2242,"all_time_quantity_sold":448,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cem\u003e\u003cstrong\u003eMũ bảo hiểm GRS A966K 2 Kính – Vệ sĩ chống tia cực tím:\u003c/strong\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003eKhi ta phơi mình dưới các điều kiện thời tiết khắc nghiệt lâu, bạn dễ bị bệnh. Do vậy, ta thường mặc áo khoát bảo vệ da, mang khẩu trang chống bụi, áo mưa…Nhưng cặp mắt thường bị chúng ta bỏ quên mặc dù các bệnh về mắt do ánh nắng, khói bụi gây ra khá nhiều.\u003c/p\u003e\n\u003cp\u003eMũ bảo hiểm GRS A966k được xem là dòng sản phẩm có tính năng bảo vệ mạnh, đặc biệt cặp mắt của mặt được bảo vệ qua 2 lớp kính. Lớp kính mát được dấu bên trong mũ rất tiện lợi, gọn nhẹ. Khi bị chói nắng, bạn dễ dàng kéo kính mát này xuống che phủ mắt bạn, tác dụng như chiếc kính râm mà bạn hay bỏ quên ở nhà. Lớp kính che bên ngoài to hơn, bao phủ 2/3 mặt bạn giúp chống bụi, mưa … giúp bạn thoải mái dù thời tiết có khắc nghiệt thế nào.\u003c/p\u003e\n\u003cp\u003eNgoài ra, lớp lót bên trong mũ còn có thể dễ dàng tháo rời ra để giặt. Tính năng này chỉ có ở 1 số dòng mũ bảo hiểm cao cấp. Điều này giúp bạn luôn cảm thấy tự tin về chiếc mũ và da đầu của mình, ko sợ bị lây các bệnh về da đầu và tóc khi sử dụng chung hoặc cho mượn nón bảo hiểm...\u003c/p\u003e\n\u003cp\u003eDo là dòng sản phẩm mũ bảo hiểm ½ đầu, GRS A966K có thể sử dụng khi bạn đi trong nội thành lẫn xa lộ. Mũ có nhiều màu sắc đa dạng như : đen, xanh mực, bạc, xám…\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cstrong\u003e*** Hướng dẫn xác định cỡ mũ phù hợp\u003c/strong\u003e\u003c/em\u003e: Vòng 1 sợi dây quanh đầu, phía trên lông mày và tai khoảng 2cm. Xiết sợi dây sao cho ôm vừa đủ thoải mái lấy đầu và ghi lại số đo đó. Lặp lại như vậy để tìm được số đo mà bạn thấy đầu dễ chịu. Đó chính là size đầu của bạn. So sánh với kích cỡ mũ để lựa chọn size mũ phù hợp.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/70/ec/5b/ecab3b9d984690de4dadfad959166d64.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/70/ec/5b/ecab3b9d984690de4dadfad959166d64.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/70/ec/5b/ecab3b9d984690de4dadfad959166d64.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/70/ec/5b/ecab3b9d984690de4dadfad959166d64.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/70/ec/5b/ecab3b9d984690de4dadfad959166d64.jpg"},{"base_url":"https://salt.tikicdn.com/media/catalog/producttmp/08/67/3d/21827df94425c91a6d740bd2a99c2a5d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/producttmp/08/67/3d/21827df94425c91a6d740bd2a99c2a5d.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/producttmp/08/67/3d/21827df94425c91a6d740bd2a99c2a5d.jpg","position":null,"small_url"