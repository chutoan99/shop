"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/d2/6f/31/bc611c2a5832228cce2c897b7730f947.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":501,"all_time_quantity_sold":4,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\n\u003ch3\u003e\u003cspan\u003eGiới thiệu\u003c/span\u003e\u003c/h3\u003e\n\u003cp\u003e\u003cspan\u003eBạn có biết khái niệm \"bé bị sốt\" khác nhau cho từng độ tuổi của bé? Bạn cần theo dõi nhiệt độ cho bé thường xuyên với kết quả đo chính xác? Nhiệt kế Braun ThermoScan 7 IRT 6520 đem đến cho bạn sự yên tâm khi theo dõi nhiệt độ cho bé. Với công nghệ Age Precision, nhiệt kế Braun 6520 cho phép bạn điều chỉnh độ tuổi giúp đo nhiệt độ chính xác cho bé, và báo cho bạn biết mức độ sốt tùy theo từng độ tuổi của bé. Ngoài ra, công nghệ pre-warmed tip và ExacTemp không những cho phép bạn đo chính xác thân nhiệt của bé một cách chuyên nghiệp mà còn giúp bạn đo nhiệt độ được nhanh chóng, dễ dàng, cho phép lưu lại nhiệt độ giữa các lần đo. \u003c/span\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cspan\u003eChất liệu\u003c/span\u003e\u003c/h3\u003e\n\u003cp\u003e\u003cspan\u003eNhựa cao cấp\u003c/span\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cspan\u003eĐặc điểm nổi bật\u003c/span\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eDòng nhiệt kế thương hiệu số 1 về độ chính xác ( kết quả đo tương đương với nhiệt kế thủ ngâ) với độ sai số +/- 0.1. Được nhiều bác sỹ thế giới khuyên dùng.\u003c/li\u003e\n\u003cli\u003eĐộ ổn định khi đo của nhiệt kế rất cao.\u003c/li\u003e\n\u003cli\u003eCó đèn cảnh báo hiển thị sốt và các màu giải thích kết quả đo ( xanh lá – bình thường; cam – sốt nhẹ; đỏ – sốt) Có chức năng đo ban đêm, sáng màn hình giúp bố mẹ có thể chăm sóc bé một cách dễ dàng nhất.\u003c/li\u003e\n\u003cli\u003eMàn hình LCD rộng rãi, hiển thị rõ ràng. Nhiệt kế có thể lưu lại các kết quả của lần đo trước giúp bố mẹ có thể xác định được tình trạng của con có giảm sốt hay không. Pin được cung cấp trong một thời gian dài, do đó bạn không lo về độ bền cũng như tuổi thọ của Nhiệt kế hồng ngoại.\u003c/li\u003e\n\u003cli\u003eThiết kế trang nhã, nhỏ gọn, dễ dàng bỏ túi khi di chuyển giúp bạn mang theo bên mình mọi lúc mọi nơi.\u003c/li\u003e\n\u003cli\u003eNhiệt kế đo tai Braun 6520 lấy thân nhiệt do các bức xạ hồng ngoại từ màng nhĩ. Màng nhĩ là nơi chia sẻ nguồn máu với khu vực kiểm soát nhiệt độ trong não bộ nên màng nhĩ là nơi phản ánh sớm và chính xác các thay đổi nhiệt độ trong cơ thể hơn ở những nơi khác. Vì thế, nhiệt kế đo tai Braun 6520 cho phép bạn đo thân nhiệt nhanh và rất chính xác.\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003e\u003cspan\u003eCông dụng\u003c/span\u003e\u003c/h3\u003e\n\u003cp\u003e\u003cspan\u003eNhiệt kế đo tai Braun 6520 ThermoScan 7 IRT với chức năng cho phép chọn độ tuổi của bé, đem đến kết quả đo nhiệt độ cơ thể chính xác. \u003c/span\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cspan\u003eHướng dẫn sử dụng\u003c/span\u003e\u003c/h3\u003e\n\u003cp\u003e1. Bạn lấy nhiệt kế ra khỏi hộp đựng.\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"__mce_add_custom__\" title=\"Lấy nhiệt kế ra khỏi hộp đựng\" src=\"https://cdn1.bigcommerce.com/server2300/fbd61/product_images/uploaded_images/step-01-braun6520.png\" alt=\"Lấy nhiệt kế ra khỏi hộp đựng\" width=\"199\" height=\"180\" /\u003e\u003c/p\u003e\n\u003cp\u003e2. Bấm nút nguồn để khởi động nhiệt kế. Trong lúc khởi động, nhiệt kế có hiển thị kết quả lấy nhiệt độ lần gần đây nhất\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"__mce_add_custom__\" title=\"Khởi động nhiệt kế\" src=\"https://cdn1.bigcommerce.com/server2300/fbd61/product_images/uploaded_images/step-02-braun6520.png\" alt=\"Khởi động nhiệt kế\" width=\"199\" height=\"180\" /\u003e\u003c/p\u003e\n\u003cp\u003e3. Nếu bạn chưa gắn đầu bọc mũi nhiệt kế vào máy thì trên màn hình sẽ xuất hiện cảnh báo nhắc bạn. Nhiệt kế chỉ hoạt động khi đầu bọc mũi nhiệt kế được gắn đúng vào máy. Để có kết quả đo chính xác, bạn nên dùng một đầu bọc mũi nhiệt kế mới, sạch cho mỗi lần đo \u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"__mce_add_custom__\" title=\"Gắn đầu bọc mũi nhiệt kế vào máy\" src=\"https://cdn1.bigcommerce.com/server2300/fbd61/product_images/uploaded_images/step-03-braun6520.png\" alt=\"Gắn đầu bọc mũi nhiệt kế vào máy\" width=\"408\" height=\"361\" /\u003e\u003c/p\u003e\n\u003cp\u003e4. Bấm nút Smart Age để chọn độ tuổi đúng của bé. \u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"__mce_add_custom__\" title=\"Chọn độ tuổi cho bé\" src=\"https://cdn1.bigcommerce.com/server2300/fbd61/product_images/uploaded_images/step-04-braun6520.png\" alt=\"Chọn độ tuổi cho bé\" width=\"550\" height=\"171\" /\u003e\u003c/p\u003e\n\u003cp\u003eNhiệt kế sẽ hiển thị như màn hình bên dưới là lúc bạn có thể bắt đầu do nhiệt độ cho bé\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"__mce_add_custom__\" title=\"Sẳn sàng lấy nhiệt độ\" src=\"https://cdn1.bigcommerce.com/server2300/fbd61/product_images/uploaded_images/step-04-01-braun6520.png\" alt=\"Sẳn sàng lấy nhiệt độ\" width=\"150\" height=\"149\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e5. Bạn để mũi đầu đo vào thẳng ống tai và bấm nút Start để đo thân nhiệt cho bé \u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"__mce_add_custom__\" title=\"Đo nhiệt độ với nhiệt kế đo tai Braun 6520\" src=\"https://cdn1.bigcommerce.com/server2300/fbd61/product_images/uploaded_images/step-05-braun6520.png\" alt=\"Đo nhiệt độ với nhiệt kế đo tai Braun 6520\" width=\"393\" height=\"173\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e6. Đèn sáng ExacTemp sẽ nhấp nháy trong quá trình lấy nhiệt độ. Khi đèn hết nhấp nháy và đứng yên khoảng 3 giây là lúc nhiệt độ đã được lấy xong. Nếu mũi đo nhiệt độ để không chính xác khiến nhiệt kế không thể lấy được nhiệt độ thì đèn ExacTemp sẽ tắt và dòng chữ POS (position of error) hiển thị trên màn hình.\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"__mce_add_custom__\" title=\"Đo nhiệt độ với đèn ExacTemp\" src=\"https://cdn1.bigcommerce.com/server2300/fbd61/product_images/uploaded_images/step-06-braun6520.png\" alt=\"Đo nhiệt độ với đèn ExacTemp\" width=\"202\" height=\"370\" /\u003e\u003c/p\u003e\n\u003cp\u003e 7. Khi bạn nghe 1 tiếng beep là lúc bạn có thể xem kết quả đo. Nhiệt kế sẽ hiển thị kết quả đo cùng với mã màu cho biết mức độ sốt\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"__mce_add_custom__\" title=\"Hiện thị kết quả đo nhiệt độ\" src=\"https://cdn1.bigcommerce.com/server2300/fbd61/product_images/uploaded_images/step-07-braun6520.png\" alt=\"Hiện thị kết quả đo nhiệt độ\" width=\"550\" height=\"309\" /\u003e \u003c/p\u003e\n\u003cp\u003e 7. Sau khi đo nhiệt độ xong, bạn bấm nút tháo đầu bọc mũi đo nhiệt kế và bỏ đầu bọc vừa dùng. Nhiệt kế tự tắt sau 60 giây không sử dụng\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"__mce_add_custom__\" title=\"Bỏ đầu bọc mũi đo nhiệt kế\" src=\"https://cdn1.bigcommerce.com/server2300/fbd61/product_images/uploaded_images/step-08-braun6520.png\" alt=\"Bỏ đầu bọc mũi đo nhiệt kế\" width=\"384\" height=\"356\" /\u003e \u003c/p\u003e\n\u003ch3\u003eHướng dẫn bảo quản\u003c/h3\u003e\n\u003cp\u003eBảo quản nơi khô ráo thoáng mát\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/d2/6f/31/bc611c2a5832228cce2c897b7730f947.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d2/6f/31/bc611c2a5832228cce2c897b7730f947.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d2/6f/31/bc611c2a5832228cce2c897b7730f947.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d2/6f/31/bc611c2a5832228cce2c897b7730f947.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d2/6f/31/bc611c2a5832228cce2c897b7730f947.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/58/2a/8b/fc34af6908e0aa18d2a686c4f07784c0.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/58/2a/8b/fc34af6908e0aa18d2a686c4f07784c0.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/58/2a/8b/fc34af6908e0aa18d2a686c4f07784c0.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/58/2a/8b/fc34af6908e0aa18d2a686c4f07784c0.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/58/2a/8b/fc34af6908e0aa18d2a686c4f07784c0.png"},{"base_url":"https://salt.tikicdn.com/ts/product/58/2a/8b/d25bfbd7b92fdb3b71a417e08993658b.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/58/2a/8b/d25bfbd7b92fdb3b71a417e08993658b.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/58/2a/8b/d25bfbd7b92fdb3b71a417e08993658b.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/58/2a/8b/d25bfbd7b92fdb3b71a417e08993658b.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/58/2a/8b/d25bfbd7b92fdb3b71a417e08993658b.png"},{"base_url":"https://salt.tikicdn.com/ts/product/c3/b0/0d/34d45058671c7deed4a3cf84b85c8307.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c3/b0/0d/34d45058671c7deed4a3cf84