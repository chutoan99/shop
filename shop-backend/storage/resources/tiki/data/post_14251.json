6ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.8,"review_count":19,"review_text":"(19)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/6c/6c/00/7b5374a4f5358290012ba4a4cb42c3b7.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1934,"all_time_quantity_sold":67,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eTrong thời tiết nắng nóng thì các gia đình nên trang bị cho mình một chiếc quạt máy để làm mát và xuat tan không khí oi ải và nóng bức khó chịu. Vì vậy, chiếc Quạt Đứng SENKO DR1608 là một gợi ý tố cho bạn khi chọn mua quạt điện.\u003c/p\u003e\n\u003cp\u003eQuạt Máy Senko DR1608 có chức năng hẹ giờ lên đến 8 giờ rất tiện lợi, quạt gió được tích hợp điều khiển từ xa giúp thuận tiện cho người dùng điểu chỉnh mức gió.\u003c/p\u003e\n\u003cp\u003eQuạt Máy Senko DR1608 có 2 tốc độ: gói thường, gió tự nhiên và gió mạnh tùy vào nhu cầu mà người dùng chọn mức gió phù hợp để làm mát tốt. Quạt có thể xoay chiều linh hoạt sang trái, phải giúp làn gió được lan tỏa đều khắp phòng.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/6f/ab/7d/b17ab859511671c76f95f34a9c5dd48f.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eQuạt có kiểu dáng gọn gàng, sang trọng với sải cánh rộng 39 cm và công suât 65W tạo luồng gió mạnh mẽ giúp làm mát nhanh hơn.\u003c/p\u003e\n\u003cp\u003eQuạt có bộ phẩn chuyển hướng rộng, gó chuyển hướng 90 độ.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/5e/5f/03/160425a2f1683978904c7b8397954b72.jpg\" alt=\"\" width=\"750\" height=\"530\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp style=\"text-align: start;\"\u003e\u003cspan style=\"text-align: center; background-color: #ffffff;\"\u003eĐiều khiển từ xa tiện dụng, giúp điều chỉnh quạt mà không phải lại gần.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: start;\"\u003e\u003cspan style=\"text-align: center; background-color: #ffffff;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/be/3e/16/4e026e418d112ce50ed6866cafff5d0a.jpg\" alt=\"\" width=\"499\" height=\"333\" /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: start;\"\u003e\u003cspan style=\"text-align: center; background-color: #ffffff;\"\u003eThay đổi chiều cao linh hoạt bằng núm vặn trên thân quạt.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: start;\"\u003e\u003cspan style=\"text-align: center; background-color: #ffffff;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/25/6b/87/cb303fe3d230a91af79136ca0e1620b7.jpg\" alt=\"\" width=\"750\" height=\"499\" /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: start;\"\u003e\u003cspan style=\"text-align: center; background-color: #ffffff;\"\u003eĐộng cơ bạc thau hoạt động êm ái, không gây tiếng ồn.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: start;\"\u003e\u003cspan style=\"text-align: center; background-color: #ffffff;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/fa/14/a5/87c3a62cf85f71523329dda6f896d0cc.jpg\" alt=\"\" width=\"750\" height=\"499\" /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: start;\"\u003e\u003cspan style=\"text-align: center; background-color: #ffffff;\"\u003eNan quạt đan khít, lồng quạt chắc chắn đảm bảo an toàn cho người sử dụng khi tiếp xúc với quạt.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: start;\"\u003e\u003cspan style=\"text-align: center; background-color: #ffffff;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/7f/8e/b2/4eb08fe4583fe32316178e3393590674.jpg\" alt=\"\" width=\"500\" height=\"333\" /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: start;\"\u003e\u003cspan style=\"text-align: center; background-color: #ffffff;\"\u003eLồng quạt che chắn hết động cơ, người sử dụng không chạm được vào bộ phận mang điện bên trong quạt.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: start;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/6d/38/0c/90a140867a5ab2645e649b0715f3ffc7.jpg\" alt=\"\" width=\"0\" height=\"0\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/6d/38/0c/e4a69571ec5251164d79067953c036c1.jpg\" alt=\"\" width=\"500\" height=\"333\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: start;\"\u003e\u003cspan style=\"text-align: center; background-color: #ffffff;\"\u003eQuạt Đứng Senko DR1608 tiết kiệm điện năng và cho sức gió mạnh, tạo không gian thóa mát.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: start;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align: start;\"\u003e\u003cspan style=\"text-align: center; background-color: #ffffff;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/4a/27/14/b67dc211f4369d51594b6ec91a98ba0d.jpg\" alt=\"\" width=\"750\" height=\"450\" /\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/6c/6c/00/7b5374a4f5358290012ba4a4cb42c3b7.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/6c/6c/00/7b5374a4f5358290012ba4a4cb42c3b7.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/6