":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":249000,"discount_rate":50,"rating_average":4.8,"review_count":282,"review_text":"(282)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/21/7a/af/d88fd0a120218e27ba3d800a71cf01f4.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1421,"all_time_quantity_sold":1021,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: center;\"\u003e\u003cstrong\u003eTÔNG ĐƠ CẮT TÓC CHUYÊN NGHIỆP KEMEI- KM 809A\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli style=\"text-align: left;\"\u003eTông đơ cắt tóc không dây Kemei 809A, dùng pin sạc.\u003c/li\u003e\n\u003cli style=\"text-align: left;\"\u003eCách sử dụng tông đơ dùng pin thường khá đơn giản và dễ dàng.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/af/1d/f8/9fe44dbf0b55c70536ea6dc20a306053.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli style=\"text-align: left;\"\u003eTrọng lượng của chúng khá nhẹ thường chưa tới 400Gram. Kích thường rất nhỏ gọn, dễ cầm, chắc tay, bạn không lo mỏi tay hay vướng víu dây điện như khi dùng tông có dây.\u003c/li\u003e\n\u003cli style=\"text-align: left;\"\u003eCông suất của những loại tông dùng pin hiện nay cũng đã được cải thiện khá nhiều vào khoảng 12 – 16 W đủ để bạn xử lý tất cả các loại tóc từ dài tới ngắn, từ cứng tới mềm.\u003c/li\u003e\n\u003cli style=\"text-align: left;\"\u003eMột ưu điểm vượt trội không thể không nhắc tới là dù có công suất lớn song khi hoạt động lại vô cùng êm ái và nhẹ nhàng nhờ có công nghệ chống rung, chồng ồn rất hiện đại.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/35/42/6b/4f710459193c6b2022515e06730dc72e.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli style=\"text-align: left;\"\u003eTông đơ cắt tóc không dây Kemei 809A có 2 lưỡi cắt Titatium, kim loại vô cùng đặc biệt, không hề độc hại với con người.\u003c/li\u003e\n\u003cli style=\"text-align: left;\"\u003eTuy nhẹ như nhôm nhưng lại có độ bền và khỏe vượt trên thép, chịu lực tốt, chống uốn, chống nén, không gỉ, không bị ăn mòn.\u003c/li\u003e\n\u003cli style=\"text-align: left;\"\u003eLưỡi dao titanium, sắc, bền, ít mòn, ít nóng khi sử dụng\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/61/4f/25/43bb8a72da6b57541c20b0d816993f92.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eTHÔNG TIN CHI TIẾT VỀ SẢN PHẨM:\u003c/span\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli style=\"font-weight: 400;\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eTên sản phẩm: TÔNG ĐƠ CẮT TÓC KEMEI 809A\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eBộ SP bao gồm: 01 tông đơ, 1 bộ răng lược 3-6-9-12mm, dây sạc nguồn, lọ dầu, 1 chổi vs máy.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eNguồn điện: 110-220v-50\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eKích thước: 27: 5: 5cm\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003e- Động cơ khỏe và bền bỉ\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003e- Thiết kế đẹp và sang trọng \u003c/span\u003e\u003cspan style=\"font-weight: 400;\"\u003elưỡi sắc bén\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eGiới thiệu sản phẩm Tông đơ cắt tóc chuyên nghiệp không dây KEMEI KM-809A\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTông đơ dùng cắt tóc chuyên nghiệp\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003e- Tông đơ sử dụng pin sạc ( không dây)\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003e- Thơi gian sạc 4h sử dụng 240 phút\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003e- Lưỡi sử dụng thép siêu bền ( săc bén)\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003e - Lưỡi cắt là Titatium. Đây là kim loại vô cùng đặc biệt, không hề độc hại với con người, tuy nhẹ như nhôm nhưng lại có độ bền và khỏe vượt trên thép, chịu lực tốt, chống uốn, chống nén, không gỉ, không bị ăn mòn. Lưỡi dao titanium, sắc, bền, ít mòn, ít nóng khi sử dụng.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/58/bf/d1/d73064fab0438c11092f86178344493f.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng 