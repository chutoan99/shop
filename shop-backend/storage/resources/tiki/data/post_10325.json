tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":205000,"discount_rate":41,"rating_average":5,"review_count":3,"review_text":"(3)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/b0/a3/e2/8e7cb5c11418156ad8170ec207b56b00.jpeg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":142,"all_time_quantity_sold":7,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p><strong>Thông tin mô tả Kính Bơi Nhật Bản VIEW V610 C Chống Tia UV Chống Sương Mù (Trong suốt) Chuyên Dùng Cho Bơi Buổi Tối - Hàng Chính Hãng</strong></p>\n<p>Thương hiệu: VIEW</p>\n<p>Độ tuổi: Người lớn và trẻ em từ 13 tuổi</p>\n<p>Sản xuất tại: Nhà máy Tabata Nhật Bản</p>\n<p>Cam kết hoàn tiền 200% nếu không đúng kính bơi View chính hãng.</p>\n<p><strong>Chất liệu nhựa Polycarbonat cùng silicone mềm dẻo</strong></p>\n<p>Sản phẩm có phần tròng kính được làm từ chất liệu nhựa trong suốt Polycarbonat cho độ bền cao, độ trong suốt của kính sẽ đảm bảo được tầm nhìn rõ ràng của bạn ngay cả khi bơi trong điều kiện buổi tối. Các chi tiết như dây đeo, vành bảo vệ được làm từ chất liệu silicone dùng trong y khoa, mềm dẻo và đảm bảo an toàn, không gây kích ứng đáng kể cho cả người có làn da nhạy cảm.</p>\n<p><strong>Lớp tráng phủ chống mờ và tia UV gây hại cho mắt</strong></p>\n<p>Bề mặt của kính được tráng phủ một lớp chất liệu đặc biệt có khả năng chống mờ bởi hơi nước, giữ cho kính luôn được trong suốt, đảm bảo tầm nhìn khi bơi lặn. Lớp tráng phủ còn có khả năng phản chiếu được tia UV gây hại cho mắt, từ đó hạn chế tình trạng mắt bị chói và khó chịu trong khi bơi.</p>\n<p><strong>Thiết kế đẹp mắt tiện dụng</strong></p>\n<p>Kính được thiết kế với phần dây đeo có thể thay đổi kích cỡ dễ dàng cùng với phần khoá nhựa đặc biệt, giữ cho phần dây đeo của kính luôn ở đúng vị trí. Phần thanh chắn mũi có thể thay thế dễ dàng trong trường hợp nứt gãy nên vô cùng tiện lợi cho người dùng. Kính bơi với những đường vát cong tinh tế càng làm tăng thêm tính thẩm mỹ khi sử dụng.</p>\n<p><strong>Thông tin thương hiệu View:</strong></p>\n<p>Kính bơi View là một trong các dòng kính bơi được người tiêu dùng tin tưởng và lựa chọn trang bị khi đi bơi. Với xuất xứ thương hiệu và sản xuất tại Nhật Bản thì bạn có thể an tâm về chất lượng, mẫu mã lại đa dạng để thoả mãn nhu cầu của khách hàng. Các sản phẩm kính bơi View cho người lớn và trẻ em thuộc loại tốt nhất trên thị trường và được sử dụng rộng rải không chỉ ở Việt Nam mà còn nhiều nước trên thế giới.</p>\n<p><strong>Lưu ý:</strong></p>\n<ul>\n<li>Để cho lớp phủ chống mờ và tia UV hoạt động hiệu quả, hãy ngâm kính trong nước vài giây trước khi sử dụng</li>\n<li>Không chạm tay cũng như vật cứng vào phần tròng kính để tránh làm hỏng lớp tráng phủ</li>\n<li>Sau khi sử dụng chỉ nên rửa sạch kính với nước và bảo quản nơi khô ráo, mát mẻ</li>\n<li>Để ngăn ngăn ngừa việc đọng hơi nước tốt hơn, hãy xoa nhẹ một lớp dầu ăn vào mặt trong kính trước khi đi bơi, hoặc có thể dùng chai Antifog View TV330 chuyên dụng</li>\n</ul>\n<p><strong>Hình ảnh sản phẩm:</strong></p>\n<p><strong><img src=\"https://salt.tikicdn.com/ts/tmp/1d/cb/9b/9531a96053552895840ea801d1367f61.jpeg\" alt=\"\" width=\"750\" height=\"750\" /></strong></p>\n<p><img title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/48/48/9d/56f53aca86d225dffcfad9dacb23f6a9.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p><img title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/cd/3e/c3/f56bc02aad4e5e50c603bef4ce34d28c.jpeg\" alt=\"\" /></p>\n<p><img title=\"\" s