acement":"pdp_badge","code":"is_hero","type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"freeship_xtra","type":"pdp_icon_badge","index":2,"icon":"https://salt.tikicdn.com/ts/upload/be/67/48/04a82ab8df178e1a13bde38316081865.png","icon_width":91,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":true,"return_reason":"any_reason"}},"discount":2000,"discount_rate":4,"rating_average":4.6,"review_count":141,"review_text":"(141)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/c6/9a/75/daa28f0e7b1a1ddbcdeb2b2a949766c0.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1337,"all_time_quantity_sold":505,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: center;\"\u003e\u003cem\u003e\u003cstrong\u003eBộ May Vá Quần Áo Đa Năng Cho Gia Đình Kèm Hộp Đựng Kim Chỉ\u003c/strong\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli style=\"text-align: left;\"\u003eTrong gia đình luôn cần một bộ đựng kim chỉ tiện dụng để đôi khi khâu vá những chiếc áo, chiếc quần vô tình bị hư, bị rách.\u003c/li\u003e\n\u003cli style=\"text-align: left;\"\u003e Đặc biệt hơn là khi đi du lịch cũng cần mang theo một bộ kim chỉ nhỏ gọn để phòng ngừa những rủi ro về quần áo bất chợt.\u003c/li\u003e\n\u003cli style=\"text-align: left;\"\u003eHộp kim chỉ may vá mini với thiết kế đặc biệt với kim may có phần đầu kim hở, giúp người dùng xỏ chỉ dễ dàng, nhanh chóng hơn.\u003c/li\u003e\n\u003cli style=\"text-align: left;\"\u003eHỗ trợ tối đa cho bạn trong công việc may vá, sửa lại các loại quần áo bị hư hỏng…\u003c/li\u003e\n\u003cli style=\"text-align: left;\"\u003eThiết kế hộ đựng nhỏ gọn, thông minh giúp bạn dễ dàng cất giữ các dụng cụ trong bộ sản phẩm hay mang theo hộp đựng bên mình trong các chuyến đi.\u003c/li\u003e\n\u003cli style=\"text-align: left;\"\u003eBộ sản phẩm gồm: 12 cuộn chỉ các màu, 1 hộp gồm 24 chiếc kim các loại, 01 kéo cắt chỉ, 01 thước dây, 01 dụng cụ xỏ chỉ.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/c1/57/a0/bfd434bbfc31652802e5b19b23fc4b3b.JPG\" alt=\"\" width=\"750\" height=\"491\" /\u003e\u003c/p\u003e\n\u003cp\u003eHộp có thiết kế nhỏ gọn, những chiếc kim khâu với nhiều kích thước khác nhau, đầu kim hở dễ xỏ giúp luồn chỉ nhanh chóng dễ dàng. Chỉ khâu nhiều màu sắc, sợi chỉ chắc chắn, không xù hay xơ chỉ. Những dụng cụ trong hộp đều được làm bằng chất liệu bền đẹp, bền bỉ, đạt tiêu chuẩn chất lượng.\u003c/p\u003e\n\u003cp\u003eVới hộp dụng cụ kim chỉ, khuy áo tiện dụng công việc may vá hay thêu thùa của bạn sẽ trở nên dễ dàng, linh động bất cứ lúc nào. Tất cả những dụng cụ mà bạn cần thiết để thực hiện những thao tác may vá đều được sắp xếp gọn gàng trong chiếc hộp này. Hộp kim chỉ đa năng 16 món rất cần thiết đối với mọi gia đình, giúp bạn chăm sóc chu đáo hơn cho trang phục của thành viên trong gia đình.\u003c/p\u003e\n\u003cp\u003eHộp kim chỉ có kích thước nhỏ gọn, xinh xắn và sắc màu với nhiều loại chỉ, nên các bạn nữ sẽ luôn có hứng thú, vui thích trong việc khâu vá. Chính vì thế, hộp kim chỉ cũng được coi là quà tặng rất độc đáo, ý nghĩa cho tất cả các bạn nữ, và những ai yêu thích việc khâu vá.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/96/64/ec/27d873f1dd9c6bd73e1aafe767b5b64e.JPG\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/96/64/ec/27d873f1dd9c6bd73e1aafe767b5b64e.JPG\" alt=\"\" width=\"750\" height=\"655\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/3d/43/c1/2f055d181f6372b8b33ee0a5e2477f4e.JPG\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/3d/43/c1/2f055d181f6372b8b33ee0a5e2477f4e.JPG\" alt=\"\" width=\"750\" height=\"739\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/79/76/10/4a046d95012429bb2cdfe95223e9c95f.JPG\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/79/76/10/4a046d95012429bb2cdfe95223e9c95f.JPG\" alt=\"\" width=\"750\" height=\"533\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/50/3f/53/4b64eeded41311a42c7eae9e6978d245.JPG\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/50/3f/53/4b64eeded41311a42c7eae9e6978d245.JPG\" alt=\"\" width=\"750\" height=\"615\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/a5/af/aa/ba4386d7e7150a5ab19e542601f87290.JPG\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/a5/af/aa/b