load/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/45/d3/11/b174e174e4ff94c33fb8d7a921a282e7.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1857,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"color: #242424;\"\u003e\u003cspan style=\"font-size: 14pt;\"\u003e\u003cstrong\u003eMặt nạ dưỡng trắng da chiết xuất khoai tây 3W Clinic Fresh Potato Mask Sheet 23ml\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"color: #242424;\"\u003e\u003cspan style=\"font-size: 14pt;\"\u003e\u003cstrong\u003eThương hiệu\u003c/strong\u003e: 3W Clinic\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"color: #242424;\"\u003e\u003cspan style=\"font-size: 14pt;\"\u003e\u003cstrong\u003eXuất xứ\u003c/strong\u003e: Hàn Quốc\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"color: #242424;\"\u003e\u003cspan style=\"font-size: 14pt;\"\u003e\u003cstrong\u003eDung tích:\u003c/strong\u003e 23ml/ miếng\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"color: #242424;\"\u003e\u003cspan style=\"font-size: 14pt;\"\u003eMột làn da đẹp không chỉ là làn da trắng trẻo, láng mịn được hỗ trợ bởi các loại kem dưỡng da. Da đẹp phải là da khỏe, săn chắc từ bên trong. Để làm được điều đó thực ra không hề khó như chị em vẫn tưởng với Mặt nạ dưỡng da 3W Clinic\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"color: #242424;\"\u003e\u003cspan style=\"font-size: 14pt;\"\u003e\u003cimg style=\"margin: 0 auto; display: block;\" src=\"https://salt.tikicdn.com/ts/product/b2/30/5a/8a3fbabe8ff466f5f8ec7dff95151cc1.jpg\" /\u003e\u003c/span\u003e\u003cbr /\u003e\u003cbr /\u003e\u003cbr /\u003e\u003c/p\u003e\n\u003cp style=\"color: #242424;\"\u003e\u003cspan style=\"font-size: 14pt;\"\u003e\u003cstrong\u003eĐặc điểm:\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"color: #242424;\"\u003e\u003cspan style=\"font-size: 14pt;\"\u003e- Mặt nạ chiết xuất từ các thành phần trái cây và rau quả tự nhiên nên thích hợp với tất cả loại da, kể cả da nhạy cảm\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"color: #242424;\"\u003e\u003cspan style=\"font-size: 14pt;\"\u003e– Chất liệu mặt nạ 100% cotton giúp bạn khi đắp lên da sẽ thấy mịn màng đến không ngờ\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"color: #242424;\"\u003e\u003cspan style=\"font-size: 14pt;\"\u003e- Mặt nạ gắn vừa khít với khuôn mặt. Chỉ đến khi mặt nạ đã khô hẳn, dưỡng chất đã thẩm thấu hết vào da mặt bạn thì mặt nạ mới bị bong ra.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"color: #242424;\"\u003e\u003cspan style=\"font-size: 14pt;\"\u003e– Khi đắp mặt nạ lên da, bạn sẽ cảm thấy mát lạnh và cảm nhận đc sự dễ chịu trên khuôn mặt. Khi lấy mặt nạ ra, bạn sẽ cảm nhận đc sự mịn màng và trắng sáng của làn da.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"color: #242424;\"\u003e\u003cspan style=\"font-size: 14pt;\"\u003e\u003cstrong\u003eCông dụng:\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"color: #242424;\"\u003e\u003cspan style=\"font-size: 14pt;\"\u003e– Ưu điểm của mặt nạ Collagen 3W Clinic là chứa thành phần thiên nhiên an toàn tuyệt đối chăm sóc da và khả năng dễ thích hợp với mọi loại da và nhu cầu của người sử dụng.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"color: #242424;\"\u003e\u003cspan style=\"font-size: 14pt;\"\u003e– Mặt nạ 3W CLINIC giúp da nuôi dưỡng, tái tạo tế bào mới và chống lão hóa da. Các dưỡng chất có trong mặt nạ sẽ thẩm thấu rất nhanh vào tận gốc tế bào, làm tăng khả năng phục hồi về tế bào, tăng cường độ ẩm, tính đàn hồi cho da, giúp da mặt trở nên hồng hào và căng mịn bên cạnh tác dụng chống oxy hóa – hình thành các nếp nhăn.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"color: #242424;\"\u003e\u003cspan style=\"font-size: 14pt;\"\u003e– Làm đẹp đều những vùng da có màu sắc tối, da bị tái, da có tàn nhang xuất hiện vết đồi mồi do tuổi tác mang lại hoặc những vết nám sâu.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"color: #242424;\"\u003e\u003cspan style=\"font-size: 14pt;\"\u003e\u003cimg style=\"margin: 0 auto; display: block;\" src=\"https://salt.tikicdn.com/ts/product/bc/f0/d5/2b1f82112867ed8f5ede6baa353a2bbe.jpg\" /\u003e\u003c/span\u003e\u003cbr /\u003e\u003cbr /\u003e\u003cbr /\u003e\u003c/p\u003e\n\u003cp style=\"color: #242424;\"\u003e\u003cspan style=\"font-size: 14pt;\"\u003e\u003cstrong\u003eHướng dẫn sử dụng và bảo quản:\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"color: #242424;\"\u003e\u003cspan style=\"font-size: 14pt;\"\u003e- Bước 1: Rửa mặt với nước sạch và sữa rửa mặt phù hợp. Có thể xông hơi để lấy sạch bụi bẩn và các chất bã nhờn bám sâu trong lỗ chân lông.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"color: #242424;\"\u003e\u003cspan style=\"font-size: 14pt;\"\u003e- Bước 2: Đắp mặt nạ lên da theo hình vòng tròn, nghỉ ngơi thư giãn trong vòng 30 phút để các dưỡng chất Collagen thẩm thấu vào da.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"color: #242424;\"\u003e\u003cspan style=\"font-size: 14pt;\"\u003e- Bước 3: Lột nhẹ miếng mặt nạ ra sau đó rửa mặt sạch với nước. Dùng tay vỗ nhẹ 2 bên má để cảm nhận da bạn được thư giãn và trắng hơn sau lần sử dụng.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"color: #242424;\"\u003e\u003cspan style=\"font-size: 14pt;\"\u003e- Nên dùng măt nạ dưỡng da 2-3 lần/tuần để có kết quả tốt nhất.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"color: #242424;\"\u003e\u003cspan style=\"font-size: 14pt;\"\u003e- Hiệu quả ngay lần sử dụng đầu tiên, thích hợp cho mọi loại da.\u003c/span\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli style=\"color: #242424;\"\u003e\u003cspan style=\"font-size: 14pt;\"\u003eBảo quản nơi thoáng mát, nếu có thể tốt nhất nên bảo quản trong ngăn mát tủ lạnh.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cspan style=\"font-size: 14pt;\"\u003e\u003cimg style=\"margin: 0 auto; display: block;\" src=\"https://salt.tikicdn.com/ts/product/47/8c/84/72e37514a8df0454e29feca2678674d3.jpg\" /\u003e\u003c/span\u003e\u003cbr /\u003e\u003cbr /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/45/d3/11/b174e174e4ff94c33fb8d7a921a282e7.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/45/d3/11/b174e174e4ff94c33fb8d7a921a282e7.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/45/d3/11/b174e174e4ff94c33fb8d7a921a282e7.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/45/d3/11/b174e174e4ff94c33fb8d7a921a282e7.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/45/d3/11/b174e174e4ff94c33fb8d7a921a282e7.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/00/6d/59/e28c9dd1aee2e1d84d331223e2e42a9d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/00/6d/59/e28c9dd1aee2e1d84d331223e2e42a9d.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/00/6d/59/e28c9dd1aee2e1d84d331223e2e42a9d.jpg","position":null,"small_url":"https://salt.tikicdn.com/cac