":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.8,"review_count":490,"review_text":"(490)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/4d/79/03/b7447b78326755119eb9e9de799b97df.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1773,"all_time_quantity_sold":2039,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eBài Tarot Kèm Túi Đựng Bài - Bài Bói Tarot Chính Hãng Amalife - The Rider Waite Deck\u003c/strong\u003e\u003c/p\u003e\n\u003ch3\u003eGiới thiệu\u003c/h3\u003e\n\u003cp\u003e\u003cstrong\u003eTarot The Deck\u003c/strong\u003e là bộ bài được sử dụng trong phần lớn các lớp học hay các buổi hội thảo diễn thuyết về bài Tarot, và cũng là bộ bài được tìm kiếm nhiều nhất trên các website cũng như các diễn đàn về Tarot khắp Internet,được khuyên là bộ bài nhập môn để có thể tiếp thu và nắm bắt những bước đầu tiên về Tarot dễ dàng hơn.\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cstrong\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/0c/55/1f/208a9aef2c3a45fe65f93d374cd73e42.jpg\" alt=\"Bài Bói Tarot\" width=\"750\" height=\"750\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003ch3\u003eMô tả sản phẩm\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003eNguồn gốc rõ ràng – hàng chính hãng Amalife – đã được TIKI kiểm duyệt.\u003c/strong\u003e\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eCó 2 Kích Thước: \u003c/strong\u003eLoại Nhỏ: 6 x 10,5Cm; Loại Chuẩn: 7 x 12Cm. Kèm Túi Đựng Chuyên Dụng.\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eChất liệu:\u003c/strong\u003e Giấy cứng được ép nilon bóng, in sắc nét, chuẩn đẹp\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eThiết kế:\u003c/strong\u003e Thiết kế theo phong cách cổ điển, nhỏ gọn, đẹp, tinh xảo, sang trọng. Mọi người có thể mang đi tới bất cứ đâu.\u003c/li\u003e\n\u003cli\u003eBộ gồm có 78 lá bài vân xanh – được sao chép từ nguyên bản gốc với kích thước phù hợp hơn.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/64/f2/bd/4397d18d50a5346d621b87d5f4271749.png\" alt=\"Bài Bói Tarot\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003eCông Dụng:\u003c/strong\u003e Làm bài Bói Tarot hoặc làm quà tặng cực đẹp và mới lạ.\u003c/li\u003e\n\u003cli\u003ePhiên bản Waite Smith Hấp dẫn với phong cách cổ điển cùng nét vẽ cổ và đậm hơn. Bản tiếng Anh sành điệu.  \u003c/li\u003e\n\u003cli\u003eNếu bạn là người mới bắt đầu tìm hiểu Tarot thì đây chính là bộ bài mà bạn cần đầu tiên.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/d0/af/ab/ca4d3133c5999526c9b62a86bd246f95.png\" alt=\"Bài Bói Tarot Chính Hãng\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cem\u003e\u003cstrong\u003eHãy sử dụng sản phẩm chính hãng để tránh hàng giả, hàng nhái, hàng kém chất lượng nhé.\u003c/strong\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003eNữ họa sĩ Pamela Colman-Smith là người khắc họa nên 78 lá bài dựa trên hệ thống phân tích ý nghĩa và sự ủy nhiệm của Arthur Edward Waite – người khai sinh ra chuẩn bài Rider Waite Smith. The Rider-Waite Tarot là bộ bài dành cho mọi đối tượng sử dụng kể cả người mới tìm hiểu về Tarot lẫn những reader chuyên nghiệp. Hầu hết reader chuyên nghiệp trên thế giới đều cho rằng bất cứ ai tìm hiểu về Tarot cũng đều phải sở hữu một bộ bài The Rider-Waite Tarot hoặc một trong các biến thể của bộ bài này. Bộ bài Nhỏ sẽ có đi kèm sách booklet rút gọn từ cuốn sách Pictorial Key to Tarot của Arthur Edward Waite – được xem là cuốn sách chuyên sâu về Tarot đầu tiên trên thế giới; ngoài ra người dùng có thể dễ dàng tìm thấy hàng trăm đầu sách khác về bộ bài The Rider-Waite Tarot và chuẩn bài truyền thống Rider Waite Smith trên thị trường.\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/79/91/d5/4b59314787ac2219811cf3aada432533.jpg\" alt=\"Bài Bói Tarot\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/8f/9a/99/4dc4a008aada3dcc3638d63084d86450.jpg\" alt=\"Bài Bói Tarot Chính Hãng\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/b4/9b/83/3cdfce295fac331507d15e3252a87897.jpg\" alt=\"Bài Bói Tarot Chính Hãng\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ba/62/24/e08112394c9ff3445cff31d7177a8ff3.jpg\" alt=\"Bài Bói Tarot Chính Hãng\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/4d/79/03/b7447b78326755119eb9e9de799b97df.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/4d/79/03/b7447b78326755119eb9e9de799b97df.jpg","medium_url":"https://salt.tikicdn.com/cac