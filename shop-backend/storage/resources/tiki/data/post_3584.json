dex":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"freeship_xtra","type":"pdp_icon_badge","index":2,"icon":"https://salt.tikicdn.com/ts/upload/be/67/48/04a82ab8df178e1a13bde38316081865.png","icon_width":91,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":true,"return_reason":"any_reason"}},"discount":22000,"discount_rate":10,"rating_average":5,"review_count":3,"review_text":"(3)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/2f/4a/29/554c93a193225fd4750c1b6d530a9cf2.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":439,"all_time_quantity_sold":63,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eCÙNG CON ĐỊNH HƯỚNG NGHỀ NGHIỆP\u003c/p\u003e\n\u003cp\u003eLời tựa\u003c/p\u003e\n\u003cp\u003eCuốn sách này ra đời như một phản hồi đến rất nhiều yêu cầu của cha mẹ đã dự các buổi chia sẻ ngắn hạn hay lớp học dài hạn về phát triển nghề nghiệp (gọi tắt là hướng nghiệp) mà tôi (Phoenix) có dịp dẫn dắt trong hơn 10 năm hành nghề tại Việt Nam. Quý cha mẹ thường kể với tôi rằng khi ngồi nghe tôi nói thì họ hiểu hết, nhưng lúc về nhà chia sẻ hay áp dụng với con thì quên rất nhiều kiến thức đã học được trong lớp.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eVì lý do trên, tôi cùng đồng tác giả Trần Thị Thu viết cuốn sách này nhằm giúp cho tất cả quý cha mẹ mới bắt đầu hành trình hướng nghiệp cùng con, cha mẹ đã dự những buổi chia sẻ ngắn (dưới 150 phút) hoặc lớp học dài (10 tiếng) có một tài liệu để sử dụng trong hành trình hướng dẫn con phát triển nghề nghiệp.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eVới quan điểm giáo dục hướng nghiệp “nuôi dưỡng, phát huy điểm mạnh tự nhiên của con”, quyển sách Cùng Con Định Hướng Nghề Nghiệp mở ra cơ hội để cha mẹ có thể quan sát con trẻ nhiều hơn, học cách nuôi dưỡng thế mạnh tự nhiên của con, cũng như vượt qua những định kiến của chính bản thân về nghề nghiệp để có thể đồng hành cùng con trên hành trình phát triển nghề nghiệp.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eChúng tôi chia cuốn sách \"Cùng con định hướng nghề nghiệp\" thành ba phần:\u003c/p\u003e\n\u003cp\u003ePhần 1: Giúp con hiểu bản thân Phần 2: Giúp con hiểu ngành nghề\u003c/p\u003e\n\u003cp\u003ePhần 3: Giúp con lập kế hoạch nghề nghiệp\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eTác giả cuốn sách Cùng con định hướng nghề nghiệp (Tái bản)\u003c/p\u003e\n\u003cp\u003eTh.S Phoenix Ho: Trưởng đại diện hội APCDA (Asia Pacific Career Development Association – Hội chuyên nghiệp Phát triển nghề nghiệp trong khu vực Châu Á Thái Bình Dương) tại Việt Nam. Thạc sĩ tham vấn, chuyên ngành Phát triển nghề nghiệp, Đại học Santa Clara, Hoa Kỳ, với hơn 10 năm kinh nghiệm trong lĩnh vực giáo dục, quản lý và tư vấn hướng nghiệp.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eTh.S Trần Thị Thu: Thạc sĩ về Quản lý Văn hóa - Giáo dục với gần 20 năm kinh nghiệm trong lĩnh vực giáo dục hướng nghiệp. Hiện đang tham gia biên soạn sách giáo khoa Hoạt động trải nghiệm, Hướng nghiệp từ cấp tiểu học đến cấp THPT theo chương trình giáo dục phổ thông mới cho Nhà xuất bản giáo dục Việt Nam.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eTác giả: Phoenix Ho , Th.S Trần Thị Thu\u003c/p\u003e\n\u003cp\u003eCông ty phát hành: Saigon Books\u003c/p\u003e\n\u003cp\u003eMã sản phẩm: 9786047789245\u003c/p\u003e\n\u003cp\u003eNhà xuất bản: NXB Văn Hóa - Văn Nghệ TP.HCM\u003c/p\u003e\n\u003cp\u003eKích thước: 16 x 24 cm\u003c/p\u003e\n\u003cp\u003eSố trang: 103\u003c/p\u003e\n\u003cp\u003eKhối lượng: 500.0 gram\u003c/p\u003e\n\u003cp\u003eNăm phát hành: 06/2023\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/2f/4a/29/554c93a193225fd4750c1b6d530a9cf2.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/2f/4a/29/554c93a193225fd4750c1b6d530a9cf2.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/2f/4a/29/554c93a193225fd4750c1b6d530a9cf2.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2f/4a/29/554c93a193225fd4750c1b6d530a9cf2.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2f/4a/29/554c93a193225fd4750c1b6d530a9cf2.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/97/1b/eb/d96af1bdc87cb4b770bd538da662702e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/97/1b/eb/d96af1bdc87cb4b770bd538da662702e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/97/1b/eb/d96af1bdc87cb4b770bd538da662702e.jpg","pos