thentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":11,"review_text":"(11)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/65/d4/ac/e865c3293f6d11468d64d3f3b636703e.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":405,"all_time_quantity_sold":47,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p><strong><span class=\"text\">BẮT TAY HÀNH ĐỘNG - ĐÁNH BAY TRÌ HOÃN </span></strong></p>\n<p><span class=\"text\">Ai cũng biết “đầu tư vào bản thân là khoản đầu tư sinh lợi nhất”. </span></p>\n<p><span class=\"text\">Thế nhưng không phải học nhiều là thành công lớn, mà đôi khi còn nhận hậu quả: trì hoãn, thất bại</span></p>\n<p><span class=\"text\">Hãy tưởng tượng… </span></p>\n<p><span class=\"text\">Bạn học đâu giỏi đấy. </span></p>\n<p><span class=\"text\">Với những kết quả xuất sắc của mình, bạn được giảng viên tự hào khoe khắp nơi, giúp bạn có thêm nhiều mối quan hệ chất lượng, nhiều cơ hội tuyệt vời. </span></p>\n<p><span class=\"text\">Bạn sẽ cảm thấy sao? Hồ Vĩnh Thùy Linh là một học viên xuất sắc của nhiều khoá học siêu đỉnh. </span></p>\n<p><span class=\"text\">Trong khi nhiều người cả đời chưa viết nổi 1 cuốn sách. </span></p>\n<p><span class=\"text\">Chỉ sau 2 tháng cầm tay chỉ viết với thầy, cô đã hoàn tất bản thảo cuốn sách ưng ý, với cả ngàn đơn đặt trước. Hiện chị cũng là Founder học viện Siêu Hạnh Phúc giúp mọi người sống hạnh phúc từng phút giây, giàu có về mọi mặt, mạnh khỏe từng tế bào dựa trên nguyên tắc vận hành của não bộ. </span></p>\n<p><span class=\"text\">Với quyển sách này bạn sẽ tự tin lái xe Mercedes vi vu trên Đại Lộ Hành Động với cảm giác cực kỳ thành công ngay lập tức. </span></p>\n<p><span class=\"text\">Hãy sẵn sàng để khám phá…</span></p>\n<p><span class=\"text\"> Nhổ tận gốc 3 rễ dẫn hầu hết mọi người xuống địa ngục thất bại </span></p>\n<p><span class=\"text\">Có được 4 yếu tố đưa bạn đến thiên đường thành công … </span></p>\n<p><span class=\"text\">Hồ Vĩnh Thùy Linh tin rằng, “Trì hoãn là một con dốc 90 độ, chỉ cần trượt chân nhẹ bạn phi thẳng xuống vực thẳm hậu quả thảm khốc.” Now or never - ngay bây giờ hoặc không bao giờ.</span></p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/65/d4/ac/e865c3293f6d11468d64d3f3b636703e.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/65/d4/ac/e865c3293f6d11468d64d3f3b636703e.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/65/d4/ac/e865c3293f6d11468d64d3f3b636703e.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/65/d4/ac/e865c3293f6d11468d64d3f3b636703e.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/65/d4/ac/e865c3293f6d11468d64d3f3b636703e.png"},{"base_url":"https://salt.tikicdn.com/ts/product/c8/84/c6/1020f88bbda22eb92cf6aac9f06936c7.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c8/84/c6/1020f88bbda22eb92cf6aac9f06936c7.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c8/84/c6/1020f88bbda22eb92cf6aac9f06936c7.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c8/84/c6/1020f88bbda22eb92cf6aac9f06936c7.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c8/84/c6/1020f88bbda22eb92cf6aac9f06936c7.png"},{