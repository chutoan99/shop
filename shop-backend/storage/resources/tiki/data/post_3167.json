;\"\u003eCổng sạc vào Micro USB thông dụng, đi kèm cáp để bạn có thể sạc nó bất cứ đâu, bất cứ lúc nào\u003c/li\u003e\n\u003cli style=\"box-sizing: border-box;\"\u003eELOOP là một trong những thương hiệu sạc pin dự phòng được yêu thích nhất tại Thái Lan bởi thiết kế, chất lượng, giá thành luôn rất phù hợp\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/c2/7f/a9/9e6d4db16c52991c7f64b3e0ccb07e46.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c2/7f/a9/9e6d4db16c52991c7f64b3e0ccb07e46.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c2/7f/a9/9e6d4db16c52991c7f64b3e0ccb07e46.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c2/7f/a9/9e6d4db16c52991c7f64b3e0ccb07e46.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c2/7f/a9/9e6d4db16c52991c7f64b3e0ccb07e46.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/a7/d2/8c/450f1c8bcc0effae2f68bf87945e5a4b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a7/d2/8c/450f1c8bcc0effae2f68bf87945e5a4b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a7/d2/8c/450f1c8bcc0effae2f68bf87945e5a4b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a7/d2/8c/450f1c8bcc0effae2f68bf87945e5a4b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a7/d2/8c/450f1c8bcc0effae2f68bf87945e5a4b.jpg"}],"warranty_policy":null,"brand":{"id":151829,"name":"Eloop","slug":"eloop"},"current_seller":{"id":66,"sku":"6716386756618","name":"Hava","link":"https://tiki.v