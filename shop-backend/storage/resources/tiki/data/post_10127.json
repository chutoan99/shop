t":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/8a/71/38/60da0ab603ecbafa1752be3b94c47e58.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":574,"all_time_quantity_sold":329,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<ul><li style=\"font-weight:400;\"><span style=\"font-weight:400;\">️HÀNH TRÌNH BÁNH XE Y HỌC</span><span style=\"font-weight:400;\"><br /></span></li>\n<li style=\"font-weight:400;\"><span style=\"font-weight:400;\">“ Ai cũng có thể bị sang chấn, kể cả tôi, bạn, người thân và bạn bè, đồng nghiệp của bạ Sang chấn không chỉ để lại vết thương trong tâm hồn, cảm xúc của chúng ta mà còn ảnh hưởng đến sinh lý, hệ thống miễn dịch.</span></li>\n<li style=\"font-weight:400;\"><span style=\"font-weight:400;\">Ngoài ra sang chấn tâm lý không chỉ ảnh hưởng đến những người trực tiếp chịu đựng nó mà còn ảnh hưởng đến những người xung quanh họ. Những người lính trở về từ chiến trường làm gia đình họ khiếp sợ vì nỗi giận vô cớ, lạnh lùng, khép kín. Vợ của những người đàn ông bị rối loạn căng thẳng hậu sang chấn ( PTSD) thường có xu hướng trầm cảm. Con của những người mẹ bị trầm cảm có nguy cơ cảm thấy bấp bênh và sợ hãi nhiều điều khi lớn lên. Một đứa trẻ thường xuyên chứng kiến cảnh bạo lực trong gia đình hoặc thậm chí bị cha mẹ bạo hành, thường sẽ khó xây dựng những mối quan hệ bền vững, tin cậy khi trẻ trưởng thành.</span></li>\n<li style=\"font-weight:400;\"><span style=\"font-weight:400;\">Theo định nghĩa, sang chấn thường rất khó chịu đựng và vượt qua.</span><span style=\"font-weight:400;\"><br /></span></li>\n<li style=\"font-weight:400;\"><span style=\"font-weight:400;\">Dù tất cả chúng ta đều muốn vượt qua những nỗi đau nhưng phần não bộ dành cho việc duy trì sự sống của chúng ta (nằm sâu dưới phần não bộ lý trí) lại không giỏi nhận cho lắm. Dù trải nghiệm thương đau đã xảy ra rất lâu thì bất kỳ dấy hiệu nguy hiểm nhỏ nào cũng có thể kích động những não bộ bị tổn thương, khiến chúng ta tiết ra một lượng vô cùng lớn hormon của stress. Điều này mang lại cảm giác vô cùng khó chịu, thúc đẩy những hành vi mất kiểm soát. Những người sống xót bản thân lo sợ rằng bệnh mình vô phương cứu chữ</span><span style=\"font-weight:400;\"><br /></span></li>\n<li style=\"font-weight:400;\"><span style=\"font-weight:400;\">Cuốn sách vừa là tài liệu hướng dẫn, vừa là lời động viên những ai bị sang chấn hãy dám đối mặt với những vết thương của mình, tìm cách chữa bệnh hiệu quả và cam kết với bản thân sẽ chung tay cùng xã hội ngăn chặn những sang chấn</span></li>\n</ul><p><img title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/3b/6d/b5/1a7b1c1d0ca276dc39c162d8bc1b147f.jpg\" alt=\"\" width=\"750\" height=\"1182\" /></p>\n<p> </p>\n<p><img title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/d8/21/44/f9bdf42cd68c8cabbf68d981c9dd6b06.jpg\" alt=\"\" width=\"750\" height=\"530\" /></p>\n<p><br /><br /><img src=\"https://salt.tikicdn.com/ts/tmp/44/7b/9c/45079fe85b65579a86c8fafe61dc0d62.jpg\" alt=\"\" width=\"750\" height=\"1333\" /></p>\n<p> </p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/8a/71/38/60da0ab603ecbafa1752be3b94c47e58.jpg","is_gallery":tru