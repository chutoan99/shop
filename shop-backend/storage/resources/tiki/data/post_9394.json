/salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":55000,"discount_rate":19,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/56/88/80/7ce998cc7ad3d83b3815a415f4cd60a3.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":35,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eTác phẩm: \u003cstrong\u003e“QUẢN TRỊ DỰ ÁN” \u003c/strong\u003e(Project Management QuickStart Guide)\u003cbr /\u003eTác giả: \u003cstrong\u003eChris Croft\u003c/strong\u003e\u003cbr /\u003eNgười dịch: Nguyễn Lê Chi Lan\u003cbr /\u003e\u003cstrong\u003ePACE BOOKs phát hành | NXB Tổng Hợp TP.HCM\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cstrong\u003eQUẢN TRỊ DỰ ÁN\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cstrong\u003e\u003cem\u003eCẩm nang hướng dẫn chi tiết để \u003c/em\u003e\u003c/strong\u003e\u003cstrong\u003e\u003cem\u003e\u003cbr /\u003equản trị dự án một cách hiệu quả\u003c/em\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e \u003c/em\u003e\u003c/p\u003e\n\u003cp\u003eQuản trị dự án là cách để thực hiện mọi thứ trên thế giới.\u003c/p\u003e\n\u003cp\u003eCho dù là dự án phóng tên lửa hay kế hoạch cho sinh nhật, kỹ năng quản trị dự án vẫn rất quan trọng để đảm bảo mọi thứ được hoàn thành mà không gặp bất kỳ sự cố nào.\u003c/p\u003e\n\u003cp\u003eVì thế, hiện nay các tổ chức đang tìm kiếm những cách linh hoạt, hiệu quả và mang lại nhiều lợi nhuận để đạt được mục tiêu của mình, và quản trị dự án hiệu quả chính là chìa khóa cho mọi câu trả lời.\u003c/p\u003e\n\u003cp\u003eTrong cuốn sách này, tác giả, diễn giả, nhà đào tạo và chuyên gia quản trị dự án Chris Croft đã đúc kết từ hơn 30 năm kinh nghiệm để đưa ra một hướng dẫn toàn diện cho những ai muốn trở thành nhà quản trị dự án, nhà lập kế hoạch dự án, hoặc cả hai.\u003c/p\u003e\n\u003cp\u003eCho dù bạn là một người bị buộc phải đảm nhận công việc quản trị dự án một cách bất đắc dĩ, một người quản lý với nhiều trách nhiệm mới hay là một chủ doanh nghiệp đang tìm hướng phát triển kinh doanh thì bạn vẫn có thể học hỏi và áp dụng các kỹ năng quản trị dự án mang tầm cỡ quốc tế để đạt được những mục tiêu của mình!\u003c/p\u003e\n\u003cp\u003e\u003cem\u003eQuyển sách này sẽ là một món quà tuyệt vời dành cho:\u003c/em\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eDoanh nhân, nhà quản lý hoặc chủ doanh nghiệp muốn có một cách hệ thống hóa để đạt được mục tiêu kinh doanh đúng hạn và phù hợp với ngân sách;\u003c/li\u003e\n\u003cli\u003eQuản lý dự án mới hoặc có kinh nghiệm muốn rèn luyện kỹ năng với sự hướng dẫn của chuyên gia;\u003c/li\u003e\n\u003cli\u003eNgười muốn nâng cấp bản thân và tăng giá trị của mình trên thị trường lao động;\u003c/li\u003e\n\u003cli\u003eNhững bạn trẻ muốn khởi nghiệp và bước vào thế giới kinh doanh;\u003c/li\u003e\n\u003cli\u003eBất kỳ ai muốn phá vỡ các dự án phức tạp thành các nhiệm vụ có thể quản lý, quản lý tài nguyên tốt hơn và tối đa hóa kỹ năng quản lý thời gian của mình.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cem\u003eTrong cuốn sách này, bạn sẽ dễ dàng học hỏi và tiếp thu các kiến thức quan trọng về:\u003c/em\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eCách xây dựng kế hoạch từ giai đoạn khởi đầu – khởi động, lên kế hoạch và thực thi các dự án với những mức độ phức tạp khác nhau;\u003c/li\u003e\n\u003cli\u003eCách dự án hoạt động - Làm sao để thực hiện dự án đúng hướng, đúng hạn và đúng với ngân sách;\u003c/li\u003e\n\u003cli\u003eSử dụng các công cụ quản trị dự án - Ứng dụng các công cụ như biểu đồ Gantt (không cần các phần mềm đặc biệt);\u003c/li\u003e\n\u003cli\u003eLàm sao để giảm thiểu rủi ro cho dự án - Cách tìm kiếm và loại bỏ rủi ro, hoặc thực hiện các thay đổi cần thiết;\u003c/li\u003e\n\u003cli\u003eNhững điều cơ bản về quản trị dự án - Quản lý nguồn lực, lãnh đạo đội nhóm, những sai lầm cần tránh và hơn thế nữa.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/d0/3f/b2/02f70e50cc58e5db3567e6c7c9e3d4ad.jpg\" alt=\"\" width=\"750\" height=\"600\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/56/88/80/7ce998cc7ad3d83b3815a415f4cd60a3.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/56/88/80/7ce998cc7ad3d83b3815a415f4cd60a3.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/56/88/80/7ce998cc7ad3d83b3815a415f4cd60a3.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/56/88/80/7ce998cc7ad3d83b3815a415f4cd60a3.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/56/88/80/7ce998cc7ad3d83b3815a415f4cd60a3.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/50/a8/a5/50bd1608c3363e6ce9f869f900dec749.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/50/a8/a5/50bd1608c3363e6ce9f869f900dec749.jpg","medium_url":"https://salt.tikicdn.c