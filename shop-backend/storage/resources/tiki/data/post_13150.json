00f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.8,"review_count":5,"review_text":"(5)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/86/ea/df/d96749f298427e2ad77aeab13ec4313b.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2184,"all_time_quantity_sold":27,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003ciframe src=\"//www.youtube.com/embed/ZTEhO04R8UY\" width=\"750\" height=\"421\" allowfullscreen=\"allowfullscreen\"\u003e\u003c/iframe\u003e\u003c/p\u003e\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003eBộ 03 Hộp Vuông (490ml) Và Túi Giữ Nhiệt Glasslock Lunch Set 03-V\u003c/strong\u003e hộp thủy tinh giúp bạn mang theo thức ăn khi đi làm, đi học, đến bệnh, đi dã ngoại… thật tiện lợi.\u003c/li\u003e\n\u003cli\u003eTúi giữ nhiệt giúp giữ ấm thức ăn, cho bạn những bữa ăn ngon miệng hơn. Đồng thời, túi có tay xách và khóa kéo sẽ bảo quản thức ăn thật tốt và giúp bạn xách, cầm dễ dàng.\u003c/li\u003e\n\u003cli\u003eÁp dụng công nghệ kín hơi, hút chân không cùng thiết kế gioăng silicon, nắp đậy 4 khớp khóa kín, hộp đựng giúp bảo quản thực phẩm, thức ăn bên trong được lâu, không tiếp xúc với không khí, chống lại sự xâm nhập của vi khuẩn có hại. Vì thế, thức ăn được bảo đảm vệ sinh, giữ nguyên hương vị, chất dinh dưỡng, bảo quản được lâu hơn.\u003c/li\u003e\n\u003cli\u003eHộp đựng làm từ chất liệu thủy tinh cường lực nên chắc chắn, sử dụng bền, lâu, khó vỡ khi rơi ở độ cao dưới 1,5m. Hộp đựng cũng không bị vỡ, nứt khi thay đổi nhiệt độ đột ngột. Đồng thời, thủy tinh làm từ cát tự nhiên, không chứa hóa chất BPA độc hại, vì thế sản phẩm an toàn cho sức khỏe, tạo sự yên tâm cho người sử dụng.\u003c/li\u003e\n\u003cli\u003eHộp thủy tinh chịu được nhiệt độ đến 120 độ C, không bị rạn nứt hay vỡ khi dùng trong lò vi sóng.\u003c/li\u003e\n\u003cli\u003eNắp hộp làm bằng nhựa cao cấp, có khả năng chịu nhiệt, có thể đậy nắp khi thức ăn còn nóng.\u003c/li\u003e\n\u003cli\u003eBạn có thể sử dụng hộp thủy tinh trong nhiều môi trường như: lò vi sóng, tủ lạnh, tủ đông, máy rửa chén.\u003c/li\u003e\n\u003cli\u003eBộ hộp Glasslock Lunch Set 3 được sản xuất hoàn toàn từ những nguyên liệu thô, có nguồn gốc tự nhiên. Sản phẩm có thể chịu được các thay đổi nhiệt độ của môi trường, sử dụng trong lò vi sóng, máy rửa bát và tủ lạnh mà không sản sinh ra các chất độc hại, an toàn cho sức khỏe người dùng.\u003c/li\u003e\n\u003cli\u003eHộp được thiết kế với kiểu dáng vuông vức, cùng chất liệu thủy tinh trong suốt, tạo nên vẻ đẹp sang trọng cho sản phẩm. Sau thời gian dài sử dụng, hộp vẫn không bị đổi màu như các sản phẩm nhựa.\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/86/ea/df/d96749f298427e2ad77aeab13ec4313b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/86/ea/df/d96749f298427e2ad77aeab13ec4313b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/86/ea/df/d96749f298427e2ad77aeab13ec4313b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/86/ea/df/d96749f298427e2ad77aeab13ec4313b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/p