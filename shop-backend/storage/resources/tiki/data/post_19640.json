t_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":37000,"discount_rate":14,"rating_average":4.7,"review_count":469,"review_text":"(469)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/78/4b/24/d222548ad70ce66a6d24bf3f5a009674.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1806,"all_time_quantity_sold":2840,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eTinh chất dưỡng The Ordinary Niacinamide 10% + Zinc 1%\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eNiacinamide (hay Vitamin B3), một thành phần đa-zi-năng với nhiều lợi ích to lớn cho da: kháng viêm, chống oxy hóa, giúp phụ hồi da, sáng mịn và se khít lỗ chân lông.\u003c/p\u003e\n\u003cp\u003eCùng với Niacinamide là “em ZinC thân thiện”. ZinC giúp các nốt mụn được nhanh chóng lành lại, và khả năng chống oxy hóa mạnh mẽ. \u003c/p\u003e\n\u003cp\u003eNhờ hai thành phần tuyệt vời này, giúp cải thiện tình trạng da mẫn cảm, mụn và đầy vết thâm. “Em nó” hoàn toàn phù hợp với mọi loại da, và mọi vấn đề thông thường của da, kể cả da mụn, dễ nổi mụn, thâm hay lỗ chân lông to.\u003c/p\u003e\n\u003cp\u003eLưu ý nho nhỏ, khi dùng Niacinamide bạn không nên dùng cùng lúc với các sản phẩm có tính acid như Acorbic Acid, BHA/AHA.\u003c/p\u003e\n\u003cp\u003eHướng dẫn sửa dụng:\u003c/p\u003e\n\u003cp\u003eBạn nên sử dụng sản phẩm 2 lần/ngày vào buổi sáng và tối theo các bước như sau.\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eBước 1: Tẩy trang và sử dụng sữa rửa mặt để loại bỏ các chất bẩn trên da.\u003c/li\u003e\n\u003cli\u003eBước 2: Dùng ống nhỏ giọt để lấy một lượng sản phẩm thích hợp ra lòng bàn tay. Hoặc các nàng cũng có thể chấm dung dịch lên 4 điểm trên gương mặt là trán, 2 bên má và cằm.\u003c/li\u003e\n\u003cli\u003eBước 3: Thoa đều serum lên khắp mặt, vỗ nhẹ mặt để serum có thể thẩm thấu vào da nhanh hơn.\u003c/li\u003e\n\u003cli\u003eBước 4: Tiếp tục các bước dưỡng da khác (nếu có).\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/9b/91/85/d47a08eb7d32f1e7254bb943f888468b.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ee/f8/3e/1ee03df33e381540282d8cb6783b8f91.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/24/d8/87/9e0840dd1afdb1acf897d2bbe21e4608.jpg\" alt=\"\" width=\"750\" height=\"562\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cstrong\u003eChú ý:\u003c/strong\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cdiv id=\"input_line_0\"\u003e\u003cem\u003e\u003cstrong\u003e\u003cspan id=\"input_part_0\" class=\"\" data-mention=\"Nhiều bạn thấy sản phẩm vừa mua khác với chai trước đã dùng về bao bì hoặc ngay cả mùi và chất bên trong thì hoang mang và đánh giá ko đúng về sp shop mình bán ra. Nên trước khi mua, các bạn lưu ý những điều sau đây để rõ hơn về The Ordinary nha!\"\u003eNhiều bạn thấy sản phẩm vừa mua khác với chai trước đã dùng về bao bì hoặc ngay cả mùi và chất bên trong thì hoang mang và đánh giá ko đúng về sp shop mình bán ra. Nên trước khi mua, các bạn lưu ý những điều sau đây để rõ hơn về The Ordinary nha!\u003c/span\u003e\u003c/strong\u003e\u003c/em\u003e\u003c/div\u003e\n\u