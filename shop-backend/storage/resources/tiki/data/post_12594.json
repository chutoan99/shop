 và thế chất. Hiện nay, công ty có 5 dòng sản phẩm chính: Xe ong Maiya, xếp hình, đồ chơi giáo dục, đồ chơi an toàn và đồ chơi có thiết kế đặc biệt khác.<p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/c0/f1/77/12515d83bd16cfd26c49f315a009f2bd.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c0/f1/77/12515d83bd16cfd26c49f315a009f2bd.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c0/f1/77/12515d83bd16cfd26c49f315a009f2bd.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c0/f1/77/12515d83bd16cfd26c49f315a009f2bd.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c0/f1/77/12515d83bd16cfd26c49f315a009f2bd.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/a0/6b/7a/7407ca7ab281374a4607a997d9013850.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a0/6b/7a/7407ca7ab281374a4607a997d9013850.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a0/6b/7a/7407ca7ab281374a4607a997d9013850.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a0/6b/7a/7407ca7ab281374a4607a997d9013850.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a0/6b/7a/7407ca7ab281374a4607a997d9013850.jpg"}],"warranty_policy":null,"brand":{"id":147729,"name":"Antona","slug":"antona"},"current_seller":{"id":3997,"sku":"7198851018641","name":"Babymart","link":"https://tiki.vn/cua-hang/babymart","logo":"https://vcdn.tikicdn.com/ts/seller/2c/5b/95/2d1b50fff97c850d93fa507650637b50.jpg","price":59000,"product_id":"275193148","store_id":3945,"is_best_store":false,"is_offli