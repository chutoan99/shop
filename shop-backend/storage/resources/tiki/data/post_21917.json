0,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":11000,"discount_rate":4,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/5d/a3/e2/969016957798f5b958d3ed25c212cab3.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":111,"all_time_quantity_sold":3,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\n\u003cp\u003e\u003cspan\u003eMáy phun sương tạo ẩm hẹn giờ Rhino H802 3000ml, tích hợp đèn ngủ nhiều màu, tiện lợi, dung tích lớn cho không gian rộng\u003cbr /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/f9/5f/9f/9ba57e8b62c2a5c8968ecc69c981e7a8.jpg\" alt=\"\" width=\"601\" height=\"601\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/e4/85/df/a8525af284da03eee3f2c8c93a209952.jpg\" alt=\"\" width=\"435\" height=\"600\" /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan\u003eMáy phun sương tạo ẩm là một thiết bị rất cần thiết đối với mọi gia đình trong thời tiết khô hanh, độ ẩm thấp với tác dụng chính là cấp thêm độ ẩm trong không khí. \u003cbr /\u003eTừ đó giúp da không bị mất nước, khô nứt nẻ đặc biệt vùng môi và da mặt tạo ra môi trường sống thoải mái và dễ chịu nhất, không còn mặc cảm khi tiếp xúc với mọi người.\u003cbr /\u003eKhi kết hợp với tinh dầu sẽ tạo ra bầu không khí dễ chịu, tránh nấm mốc và côn trùng ruồi muỗi (không nên lạm dụng và phải chọn đúng tinh dầu chất lượng tốt)\u003cbr /\u003e\u003cbr /\u003e1. THÔNG TIN SẢN PHẨM\u003cbr /\u003e- Tạo độ ẩm: Làm ẩm không khí để tránh khô da, mũi và cổ họng.\u003cbr /\u003e- Thanh lọc: Bằng cách giải phóng hơi nước, tạo ra vô số ion oxy âm thanh lọc không khí trong lành hơn.\u003cbr /\u003e- Thư giãn: Thêm tinh dầu tạo hương (Sử dụng dầu có nguồn gốc xuất xứ, chứng nhận kiểm định rõ ràng)\u003cbr /\u003e- Giữ ẩm: Có chức năng tương tự với máy phun sương nano, giúp da khỏe mạnh\u003cbr /\u003e- Chất liệu cao cấp: ABS + PP\u003cbr /\u003e- Bình chứa nước: 3000ml hoạt động từ 7 - 15h\u003cbr /\u003e- Sạc: dây sạc cắm USB, đầu sạc type C\u003cbr /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/14/86/09/83c47f9edb783e267d4f21db575fadc2.jpg\" alt=\"\" width=\"371\" height=\"528\" /\u003e\u003cbr /\u003e2. THÔNG TIN CHI TIẾT\u003cbr /\u003e- Đơn vị tính: 1 chiếc\u003cbr /\u003e- Diện tích hoạt động: 20-30m2\u003cbr /\u003e- Chất liệu: ABS + PP\u003cbr /\u003e- Màu sắc: Trắng\u003cbr /\u003e- Kích thước: 25 x 15 x 15 Cm\u003cbr /\u003e- Điện áp: 5V=1A\u003cbr /\u003e- Công suất: 2-5W\u003cbr /\u003e- Dung tích: 5000ml\u003cbr /\u003e- Độ ồn: \u0026lt;= 36db\u003cbr /\u003e- Khối lượng: 400g\u003cbr /\u003e- Tốc độ: 30 - 1000ml / giờ\u003cbr /\u003e- Thời gian làm việc: 7h - 15h ( 7h đối với phun sương 2 lõi liên tục, 15 giờ đối với phun sương luân phiên giữa 2 lõi)\u003cbr /\u003e- Loại sương: Sương làm mát\u003cbr /\u003e\u003cbr /\u003eBỘ SẢN PHẨM BAO GỒM:\u003cbr /\u003e1 x Máy phun sương tạo độ ẩm \u003cbr /\u003e1 x Dây sạc type C\u003cbr /\u003e1 x Hướng dẫn sử dụng \u003cbr /\u003e\u003cbr /\u003e3. HƯỚNG DẪN SỬ DỤNG \u003cbr /\u003eBước 1: Cắm đầu USB vào nguồn điện như củ sạc, máy tính, pin dự phòng, Cắm đầu type C vào máy\u003cbr /\u003e+ Thêm nước vào bình.\u003cbr /\u003eBước 2: \u003cbr /\u003e+ Bấm nút nguồn 1 lần để máy phun sương 2 lõi\u003cbr /\u003e+ Bấm nút nguồn thêm 1 lần để máy phun sương thay đổi lần lượt giữa 2 lõi, mỗi lõi phun 3 giây\u003cbr /\u003e+ Ấn thêm 1 lần để máy phun sương ngắt quãng cả 2 lõi, phun 3 giây ngắt 3 giây\u003cbr /\u003e- Ấn giữ nút nguồn 3 giây để bật đèn\u003cbr /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/a6/b2/ee/eac7c746eff31dc59fe49ab8c1d694d7.jpg\" alt=\"\" width=\"600\" height=\"800\" /\u003e\u003cbr /\u003e4. CAM KẾT\u003cbr /\u003e- 100% sản phẩm chính hãng, nguồn gốc xuất xứ rõ ràng\u003cbr /\u003e- Sản phẩm đẹp, chất lượng\u003cbr /\u003e- Được kiểm định chất lượng giúp người dùng yên tâm khi mua hàng\u003cbr /\u003e- Đóng gói, bọc kĩ càng khi vận chuyển đến tay người dùng một cách cẩn thận nhất\u003cbr /\u003e\u003cbr /\u003e#rhino #rhinostore #H802 #tinhdau #Rhino #rhinostoreofficial #mayphunsuong #mayxongtinhdau #maytaoam #taoamh #maytaodoamkhongkhi #mayphunsuongxongtinhdau #maytaodoamtinhdau #RhinoH802 #maycamdayphunsuong\u003c/span\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/5d/a3/e2/969016957798f5b958d3ed25c212cab3.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/5d/a3/e2/969016957798f5b958d3ed25c212cab3.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/5d/a3/e2/969016957798f5b958d3ed25c212cab3.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5d/a3/e2/969016957798f5b958d3ed25c212cab3.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5d/a3/e2/969016957798f5b958d3ed25c212cab3.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/cd/7a/0c/97eaef018e8c3e1bdc3bcb306bc98585.jpg","is_gallery":true,"