round_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":50000,"discount_rate":4,"rating_average":5,"review_count":6,"review_text":"(6)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/0c/09/35/9ffdbb52a9aff977f5b921877c6b4b7b.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1157,"all_time_quantity_sold":46,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch1\u003eThức ăn hạt dành cho chó trên 6 tháng tuổi ANF vị cá hồi 6kg \u003c/h1\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/56/0e/0a/bd2df246f8577e75175e6d1a91cd2d1b.jpg\" alt=\"vi-ca-hoi-1581502894.jpg\" /\u003e\u003c/p\u003e\n\u003cp\u003eCún nhà bạn thường xuyên bị dị ứng với thức ăn? Lựa chọn dòng sản phẩm thức ăn giúp giảm kích ứng là ưu tiên hàng đầu Sen cần biết. Thức ăn hạt dành cho chó ANF 6kg vị cá hồi đang được các bạn Sen trên toàn thế giới ưa chuộng. Sản phẩm này chắc chắn sẽ làm hài lòng các bạn cún dù khó tính nhất. Đặc biệt gói 6kg giúp sen tiết kiệm hơn so với gói 1kg, 2kg thông thường. \u003c/p\u003e\n\u003ch2\u003eTHÔNG TIN SẢN PHẨM\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003eTên sản phẩm: Thức ăn hạt cho chó lớn hơn 6 tháng tuổi ANF 5 Free Organic vị cá hồi\u003c/li\u003e\n\u003cli\u003eLoại sản phẩm: thức ăn cho chó\u003c/li\u003e\n\u003cli\u003eDạng sản phẩm: thức ăn dạng hạt\u003c/li\u003e\n\u003cli\u003eÁp dụng: mọi giống chó trên 6 tháng\u003c/li\u003e\n\u003cli\u003eXuất xứ: Hàn Quốc\u003c/li\u003e\n\u003cli\u003eThương hiệu: ANF\u003c/li\u003e\n\u003cli\u003eHương vị: cá hồi\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch2\u003eThành phần nguyên liệu cấu tạo \u003c/h2\u003e\n\u003cp\u003eThức ăn hạt dành cho chó ANF 6kg vị cá hồi được sản xuất từ nguyên liệu hữu cơ tự nhiên đảm bảo an toàn cho sức khỏe thú cưng. Xuất xứ từ Hàn Quốc - đất nước nổi tiếng với sự sạch sẽ vì thế từ quy trình sản xuất đến khâu đóng gói sản phẩm đều được kiểm tra rất nghiêm ngặt. \u003c/p\u003e\n\u003cp\u003eHạt ANF vị cá hồi được làm từ nguồn protein động vật tổng hợp, gạo hữu cơ, đạm thực vật hữu cơ, khoáng chất, vitamin, các loại rau củ, taurin, axit amin,...\u003c/p\u003e\n\u003cp\u003eCác thành phần cấu tạo chính của sản phẩm:\u003c/p\u003e\n\u003cp\u003e-Protein cao cấp: cá hồi ít gây kích ứng cho da nên đảm bảo an toàn cho mọi giống chó\u003cbr /\u003e-Chất béo đa dạng, đầy đủ: Omega 3 (DHA \u0026amp; EPA)\u003cbr /\u003e-Khoai lang hữu cơ\u003cbr /\u003e-Lúa mạch hữu cơ\u003cbr /\u003e-Chiết xuất Yucca\u003cbr /\u003e-Bột gạo\u003cbr /\u003e-Bột lúa mạch\u003cbr /\u003e-Hỗn hợp rau củ:  súp lơ, cà rốt, ..\u003cbr /\u003e-Đậu xanh\u003cbr /\u003e-Bí ngô\u003cbr /\u003e-Đường\u003cbr /\u003e-Taurine\u003cbr /\u003e-Vitamin và khoáng chất\u003c/p\u003e\n\u003ch2\u003eCông dụng sản phẩm \u003c/h2\u003e\n\u003cp\u003eVới thành phần lên tới 95% nguyên liệu hữu cơ, thức ăn hạt cho chó ANF vị cá hồi đảm bảo an toàn cho sức khỏe cũng như hệ thần kinh của chó. \u003cbr /\u003e \u003cbr /\u003eHạt ANF 6kg vị cá hồi so với các sản phẩm thông thường khác có chứa nhiều hơn 40% chất chống oxy hóa thiên nhiên giúp tăng cường hệ miễn dịch và giảm thiểu dị ứng do thực phẩm gây ra. \u003c/p\u003e\n\u003cp\u003eNgoài ra, sản phẩm cũng giúp cải thiện tỷ lệ hấp thụ thức ăn và hỗ trợ hệ tiêu hóa hoạt động hiệu quả hơn. \u003c/p\u003e\n\u003ch3\u003eLIỀU LƯỢNG KHUYÊN DÙNG\u003c/h3\u003e\n\u003cp\u003eDưới đây là bảng liều lượng khuyên dùng cho từng chú chó. Quý khách có thể tham khảo thêm để sử dụng cho thú cưng của mình nhé:\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eChó từ 1-4,5kg: dùng 20-100g\u003c/li\u003e\n\u003cli\u003eChó từ 5-10kg: dùng 100-200g\u003c/li\u003e\n\u003cli\u003eChó từ 10-25kg: dùng 200-350g\u003c/li\u003e\n\u003cli\u003eChó từ 25-44kg: dùng 350-600g\u003c/li\u003e\n\u003cli\u003eChó trên 45kg: dùng 600g \u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eBảo quản: nơi khô ráo, thoáng mát, tránh ánh nắng mặt trời.\u003c/p\u003e\n\u003cp\u003eVới những công dụng tuyệt vời trên, thức ăn hạt dành cho chó ANF 6kg vị cá hồi chắc chắn sẽ mang đến những trải nghiệm bữa ăn thú vị dành cho Boss. Nhìn các bạn cún cưng lớn lên khỏe mạnh từ hạt ANF chắc chắn các bạn sen cũng sẽ rất hạnh phúc phải không nào? \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/0c/09/35/9ffdbb52a9aff977f5b921877c6b4b7b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0c/09/35/9ffdbb52a9aff977f5b921877c6b4b7b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/0c/09/35/9ffdbb52a9aff977f5b921877c6b4b7b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0c/09/35/9ffdbb52a9aff977f5b921877c6b4b7b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0c/09/35/9ffdbb52a9aff977f5b921877c6b4b7b.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/96/cb/3b/be5774b55be9effb677ba1f1c3d9d48c.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/96/cb