review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/e2/09/be/59a3515f95517976e62fe1c0e44f5178.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1829,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eNgười mới làm lãnh đạo học từ lỗi lầm của bản thân. Nhà lãnh đạo thông minh học từ lỗi lầm của người khác.\u003cbr /\u003eLãnh đạo, chủ đề được quan tâm đặc biệt trong bối cảnh nhiều thay đổi và biến động hiện nay, là nghệ thuật kích thích con tim và khối óc của những người bình thường, vì những kết quả phi thường. Con đường trở thành lãnh đạo không bằng phẳng, song nghệ thuật lãnh đạo là hoàn toàn có thể lĩnh hội được.\u003cbr /\u003eTinh hoa lãnh đạo được John C. Maxwell viết trên quan điểm đó. Nếu mỗi chương của cuốn sách tương đương với một khóa đào tạo một thầy một trò với guru về lãnh đạo hàng đầu thế giới, thì 26 nguyên tắc đưa ra là phần tinh túy chắt lọc từ những thành công và thất bại trong hơn ba mươi năm lãnh đạo của ông.\u003cbr /\u003eNgười bắt đầu làm lãnh đạo sẽ tìm thấy cảm hứng từ những lời khuyên J. Maxwell đưa ra trên mỗi nguyên tắc. Nhà lãnh đạo đã có kinh nghiệm sẽ phân tích và tận dụng triết lý về thuật lãnh đạo của ông trong sự cọ sát với thực tế của bản thân. Còn các nhà lãnh đạo chủ chốt sẽ ngay lập tức muốn áp dụng hệ thống nguyên tắc và triết lý ấy để gây dựng và phát triển đội ngũ lãnh đạo tương lai cho tổ chức của mình.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/e2/09/be/59a3515f95517976e62fe1c0e44f5178.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e2/09/be/59a3515f95517976e62fe1c0e44f5178.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e2/09/be/59a3515f95517976e62fe1c0e44f5178.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e2/09/be/59a3515f95517976e62fe1c0e44f5178.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e2/09/be/59a3515f95517976e62fe1c0e44f5178.png"},{"base_url":"https://salt.tikicdn.com/ts/product/9f/13/e2/a1cf08dee6ac8980fce654a6e764e3f0.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/9f/13/e2/a1cf08dee6ac8980fce654a6e764e3f0.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/9f/13/e2/a1cf08dee6ac8980fce654a6e764e3f0.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9f/13/e2/a1cf08dee6ac8980fce654a6e764e3f0.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9f/13/e2/a1cf08dee6ac8980fce654a6e764e3f0.png"},{"base_url":"https://salt.tikicdn.com/ts/product/35/a0/47/cf0bedb3819fcc568a81fee608831e39.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/35/a0/47/cf0bedb3819fcc568a81fee608831e39.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/35/a0/47/cf0bedb3819fcc568a81fee608831e39.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/35/a0/47/cf0bedb3819fcc568a81fee608831e39.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/35/a0/47/cf0bedb3819fcc568a81fee608831e39.png"},{"base_url":"https://salt.tikicdn.com/ts/product/ce/85/64/372773fea852b1f85aac3fbb82620e95.png","is_gallery":true,"label":null,"large_url":"https://