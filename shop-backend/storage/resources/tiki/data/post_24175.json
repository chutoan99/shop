or":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/02/97/cd/bb6908af4911a8699f4bf06a289c8d88.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":790,"all_time_quantity_sold":14,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\n  \u003cp\u003eGIAN HÀNG CHÍNH HÃNG Inochi - MUA HÀNG UY TÍN - BÁN HÀNG CHẤT LƯỢNG\u003c/p\u003e\n   \u003cp\u003e* MIỄN PHÍ GIAO HÀNG TOÀN QUỐC - GIAO HÀNG HỎA TỐC 1-4 NGÀY (THÀNH PHÓ LỚN 1-2 NGÀY)\u003c/p\u003e\n   \u003cp\u003e* DÙNG CẢ TẤM LÒNG TƯ VẤN KHÁCH HÀNG\u003c/p\u003e\n   \u003cp\u003e* CAM KẾT XỬ LÝ VẤN ĐỀ HÀNG TRONG 30' SAU KHI QUÝ KHÁCH NHẬN HÀNG\u003c/p\u003e\n   \u003cp\u003e* HỖ TRỢ CHI PHÍ ĐỔI TRẢ TRONG 7 NGÀY\u003c/p\u003e\n   \u003cp\u003e* BẢO HÀNH SẢN PHẨM LÊN TỚI 2 NĂM\u003c/p\u003e\n   \u003cp\u003e*Túi rác tự huỷ Soji\u003c/p\u003e\n   \u003cp\u003e- Thành Phần: HDPE, LDPE, hạt tự hủy sinh học\u003c/p\u003e\n   \u003cp\u003e- HƯỚNG DẪN SỬ DỤNG: Dùng để đựng rác trong gia đình và văn phòng.\u003c/p\u003e\n   \u003cp\u003eKHUYẾN CÁO:\u003c/p\u003e\n   \u003cp\u003eKhông sử dụng trong các dung dịch và dung môi\u003c/p\u003e\n   \u003cp\u003eKhông tiếp xúc trực tiếp với nhiệt độ cao\u003c/p\u003e\n   \u003cp\u003eKhông tiếp xúc vật sắt nhọn\u003c/p\u003e\n   \u003cp\u003eDUNG TÍCH SẢN PHẨM: có 3 dung tích 10L, 25L và 50L\u003c/p\u003e\n   \u003cp\u003e- Túi rác tự huỷ Soji 10L x 71 túi (Túi miệng bằng)\u003c/p\u003e\n   \u003cp\u003e- Túi rác tự huỷ Soji 25L x 50 túi (Túi miệng bằng)\u003c/p\u003e\n   \u003cp\u003e- Túi rác tự huỷ Soji 50L x 36 túi (Túi miệng bằng)\u003c/p\u003e\n   \u003cp\u003e- Túi rác tự huỷ Soji 10L x 66 túi (Túi miệng lượn sóng)\u003c/p\u003e\n   \u003cp\u003e- Túi rác tự huỷ Soji 25L x 46 túi (Túi miệng lượn sóng)\u003c/p\u003e\n   \u003cp\u003e- Túi rác tự huỷ Soji 50L x 32 túi (Túi miệng lượn sóng)\u003c/p\u003e\n   \u003cp\u003e- Túi dây rút đa năng Soji 20L (số lượng 30 túi) - Màu (Trắng - Xanh)\u003c/p\u003e\n   \u003cp\u003e- Túi dây rút đa năng Soji 30L (số lượng 30 túi) - Màu (Trắng - Vàng)\u003c/p\u003e\n   \u003cp\u003e=== CAM KẾT CỦA INOCHIVIETNAM ===\u003c/p\u003e\n   \u003cp\u003e+ Sản phẩm xuất khẩu thị trường Nhật Bản chính hãng 100% do chúng tôi sản xuất.\u003c/p\u003e\n   \u003cp\u003e+ Đảm bảo chất lượng, dịch vụ tốt nhất, hàng được giao từ 1-5 ngày kể từ ngày đặt hàng.\u003c/p\u003e\n   \u003cp\u003e= = = ĐẢM BẢO CỦA INOCHIVIETNAM = = =\u003c/p\u003e\n   \u003cp\u003eSản Phẩm:\u003c/p\u003e\n   \u003cp\u003e+ Hình ảnh sản phẩm giống 100%\u003c/p\u003e\n   \u003cp\u003e+ Chất lượng sản phẩm tốt nhất\u003c/p\u003e\n   \u003cp\u003e+ Sản phẩm được kiểm tra kĩ càng, nghiêm ngặt trước khi giao cho khách hàng\u003c/p\u003e\n   \u003cp\u003e+ Giao hàng nhanh chóng ngay khi có đơn hàng\u003c/p\u003e\n   \u003cp\u003e+ Hoàn tiền nếu sản phẩm không đúng với mô tả\u003c/p\u003e\n   \u003cp\u003e+ Hỗ trợ đổi trả theo quy định\u003c/p\u003e\n   \u003cp\u003eTHÔNG TIN CHUNG VỀ SẢN PHẨM:\u003c/p\u003e\n   \u003cp\u003eTÚI RÁC TIỆN DỤNG SOJI với đối ưu hóa công năng khi sử dụng sẽ mang tới cho không gian sống của nhà bạn vẻ đẹp tinh tế, gọn gàng hơn. Soji – Mang ý nghĩa gọn gàng, ngăn nắp của Túi rác, liên tưởng của sản phẩm giúp nhà cửa gọn gàng, sạch sẽ mỗi ngày. Đó cũng là cảm hứng để Inochi đặt tên cho sản phẩm túi rác tiện dụng.\u003c/p\u003e\n   \u003cp\u003e+ Nguyên liệu nhựa nguyên sinh cao cấp,không mùi, dai và khó rách.\u003c/p\u003e\n   \u003cp\u003e+ Thiết kế quai xách tiện dụng sạch sẽ.\u003c/p\u003e\n   \u003cp\u003e+ Đa dạng công năng sử dụng, từ đựng đồ sạch đến rác.\u003c/p\u003e\n   \u003cp\u003e+ Đạt tiêu chuẩn khắt khe cho các sản phẩm gia dụng của Châu Âu.\u003c/p\u003e\n   \u003cp\u003e+ Kiểu dáng cuốn gọn nhẹ, tiết kiệm diện tích\u003c/p\u003e\n   \u003cp\u003e+ Thân thiện với moi trường\u003c/p\u003e\n   \u003cp\u003eƯU ĐIỂM SẢN PHẨM:\u003c/p\u003e\n   \u003cp\u003eSản phẩm dẽo dai, co giãn tốt và khó rách.\u003c/p\u003e\n   \u003cp\u003eKhông mùi không hóa chất an toàn cho da.\u003c/p\u003e\n   \u003cp\u003eChất liệu tự hủy thân thiện với môi trường.\u003c/p\u003e\n   \u003cp\u003eSản xuất theo tiêu chuẩn châu âu.\u003c/p\u003e\n  \u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/02/97/cd/bb6908af4911a8699f4bf06a289c8d88.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/02/97/cd/bb6908af4911a8699f4bf06a289c8d88.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/02/97/cd/bb6908af4911a8699f4bf06a289c8d88.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/02/97/cd/bb6908af4911a8699f4bf06a289c8d88.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/02/97/cd/bb6908af4911a8699f4bf06a289c8d88.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/cc/a7/7f/89d9eb3084a5823846d642bc4827ef36.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/cc/a7/7f/89d9eb3084a5823846d642bc4827ef36.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/cc/a7/7f/89d9eb3084a5823846d642bc4827ef36.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/cc/