ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.5,"review_count":182,"review_text":"(182)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/b8/ae/32/e48115d6f8889968cbb2207091fd2145.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1664,"all_time_quantity_sold":1148,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eThông tin Phân bón hữu cơ đậu tương, đậu nành trứng chuối humic DOCNEEM:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eThương hiệu DOCNEEM đã được đăng ký bảo hộ tại cục sở hữu trí tuệ Việt Nam.\u003c/p\u003e\n\u003cp\u003eNguồn gốc tự nhiên, sản phẩm hữu cơ, kết hợp đậu nành, trứng, chuối.\u003c/p\u003e\n\u003cp\u003eBổ sung Axit humic giúp cây trồng dễ hấp thụ được các chất dinh dưỡng hơn.\u003c/p\u003e\n\u003cp\u003eKết cấu hình dạng: Đậu nành lên men humic, dạng lỏng.\u003c/p\u003e\n\u003cp\u003eChai 1 lít (chai nhựa cao cấp).\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/c7/3f/f1/5110ec1e30c9c85ae0ed7f1627082732.jpg\" alt=\"đậu nành humic\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003ePhân bón đậu nành humic giúp đẩy chồi, sai hoa\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCông dụng Phân bón đậu tương, đậu nành trứng chuối humic DOCNEEM:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003ePhân bón hoa hồng giúp kích rễ, sai hoa, chồi tua tủa.\u003c/p\u003e\n\u003cp\u003eChế phẩm chuyên biệt dành cho hoa hồng, cây cảnh (kết hợp từ đậu nành lên men humic, trứng, và chuối)\u003c/p\u003e\n\u003cp\u003eKích ra rễ khỏe, mầm mập và đẩy chồi cực mạnh.\u003c/p\u003e\n\u003cp\u003eGiúp cây phát triển khỏe mạnh, cứng cáp: Hoa sai, to, đậm màu và lâu tàn, nẩy nhiều mầm nụ, mầm lộc.\u003c/p\u003e\n\u003cp\u003eCung cấp dưỡng chất dinh dưỡng cân đối và đầy đủ cho cây trồng (đa lượng, trung lượng, vi lượng, vitamin, khoáng chất, acid amin…).\u003c/p\u003e\n\u003cp\u003eKích ra rễ khỏe, mầm mập và ra chồi cực mạnh.\u003c/p\u003e\n\u003cp\u003eGiúp cây trồng phát triển khỏe mạnh, cứng cáp: Hoa sai, to, đậm màu và bền hoa, lâu tàn, nẩy nhiều mầm nụ, mầm lộc.\u003c/p\u003e\n\u003cp\u003eCải tạo đất, giúp đất tơi xốp, tăng độ mùn cho đất.\u003c/p\u003e\n\u003cp\u003eTăng sức đề kháng, cây khỏe, phòng chống sâu bệnh.\u003c/p\u003e\n\u003cp\u003eTạo lập hệ vi sinh vật hữu ích và tăng mật độ vi sinh vật hữu ích trong đất.\u003c/p\u003e\n\u003cp\u003eBảo vệ bộ rể và hỗ trợ khả năng hấp thu dưỡng chất của cây trồng.\u003c/p\u003e\n\u003cp\u003eGiúp cây trồng hấp thu dễ dàng các dưỡng chất trong đất.\u003c/p\u003e\n\u003cp\u003eHạn chế vàng lá gân xanh trên hoa hồng, rụng lá trên cây.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/78/be/a0/adb9bcc5e65168415ef90e051dde5e66.jpg\" alt=\"chế phẩm đậu nành humic\" width=\"750\" height=\"1000\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003eSản phẩm hoàn toàn hữu cơ, an toàn với con người\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eHướng dẫn sử dụng Phân bón đậu tương, đậu nành chuối humic DOCNEEM:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003ePha 10ml đậu tương humic với 1 lít nước, sau đó tưới gốc. Tưới định kỳ 1 lần/tuần.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/b8/ae/32/e48115d6f8889968cbb2207091fd2145.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b8/ae/32/e48115d6f8889968cbb2207091fd2145.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b8/ae/32/e48115d6f8889968cbb2207091fd2145.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b8/ae/32/e48115d6f8889968cbb2207091fd2145.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b8/ae/32/e48115d6f8889968cbb2207091fd2145.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/56/b4/ef/81ce3c2de0100d8493511d631b26cd67.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/56/b4/ef/81ce3c2de0100d8493511d631b26cd67.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/56/b4/ef/81ce3c2de0100d8493511d631b26cd67.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/56/b4/ef/81ce3c2de0100d8493511d631b26cd67.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/56/b4/ef/81ce3c2de0100d8493511d631b26cd67.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/0c/20/9b/65b2093cf3e772e365c6024aceab9843.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0c/20/9b/65b2093cf3e772e365c6024aceab9843.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/0c/20/9b/65b2093cf3e772e365c6024aceab9843.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0c/20/9b/65b2093cf3e772e365c6024aceab9843.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0c/20/9b/65b2093cf3e772e365c6024ac