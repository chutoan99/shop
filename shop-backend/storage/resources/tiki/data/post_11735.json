s_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.6,"review_count":5,"review_text":"(5)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/31/67/03/365cba6b240e779b1dee0c94246ab47a.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1478,"all_time_quantity_sold":30,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<div id=\"bd_1\" class=\"com-struct\">\n<div id=\"bd_1_container_0\" class=\"com-struct\">\n<div>\n<div id=\"shell-com-845358304\" class=\"J_module\">\n<div class=\"module-detailImageText\">\n<div>\n<div>\n<p><strong><img src=\"https://salt.tikicdn.com/ts/tmp/bf/d6/af/c367689f5425891fe3cebfec130f0b7d.jpg\" alt=\"\" width=\"750\" height=\"500\" /></strong></p>\n<p><strong>Thành phần:</strong></p>\n<p>Sorbitol, Nước, Glycerin, Hydrated silica, Silica, Sodium lauryl sulfate, Flavour, Peucedanum graveolens (dill) extract, Sodium carboxymethyl cellulose, Sodium saccharin, Menthol, Foeniculum vulgare fruit extract, Sodium benzoate, Potassium sorbate, Salvadora persica stem extract, Citric Acid, Eugenia caryophyllus bud extract, Elettaria cardamomum fruit extract, CI19140, CI 42053. .</p>\n<p><img src=\"https://salt.tikicdn.com/ts/tmp/75/49/91/f4b85ca64342eb9276644b08881a2c88.jpg\" alt=\"\" width=\"750\" height=\"500\" /></p>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n<div id=\"bd_2\" class=\"com-struct\">\n<div id=\"bd_2_container_0\" class=\"com-struct\">\n<div>\n<div id=\"shell-com-845358302\" class=\"J_module\">\n<div class=\"module-detailImageText\">\n<div>\n<div>\n<p><strong>Xuất xứ:</strong></p>\n<p>Sản phẩm thuộc thương hiệu Himalaya- một hãng dược mỹ phẩm nổi tiếng khá lâu đời của Ấn Độ (từ năm 1930 đến nay), với tiêu chí là \"HAPPINESS throught WELLNESS\" hãng cam kết các sản phẩm được chiết xuất từ 100% thiên nhiên, thảo dược từ chân đồi Himalaya, an toàn cho sức khỏe từ người già đến trẻ nhỏ.</p>\n<p><img src=\"https://salt.tikicdn.com/ts/tmp/a4/90/59/a29930916cb04d9ae97a82118045e5e4.jpg\" alt=\"\" width=\"750\" height=\"500\" /></p>\n<p><strong>Cách dùng</strong></p>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n<div id=\"bd_3\" class=\"com-struct\">\n<div id=\"bd_3_container_0\" class=\"com-struct\">\n<div id=\"shell-com-845358303\" class=\"J_module\">\n<div class=\"module-detailImageText\">\n<div data-spm-anchor-id=\"a2o4n.pdp.product_detail.i1.65038e1fG9Z4aM\">\n<p>Dùng được cho cả trẻ em và người lớn. Trẻ em dưới 6 tuổi nên có sự giám sát của người lớn. Khi sử dụng chỉ dùng 1 lượng nhỏ bằng hạt đậu. Không được nuốt. Nhổ ra và súc miệng sau khi đánh răng. Chải răng kỹ lưỡng ít nhất 2 lần/ngày, hoặc theo hướng dẫn của nha sĩ và bác sĩ.</p>\n<p><img src=\"https://salt.tikicdn.com/ts/tmp/e8/8f/e8/fc75b59af95a11135f68359e57e3a0ef.jpg\" alt=\"\" width=\"750\" height=\"532\" /></p>\n</div>\n</div>\n</div>\n</div>\n</div>\n<div id=\"bd_4\" class=\"com-struct\">\n<div id=\"bd_4_container_0\" class=\"com-struct\">\n<div>\n<div id=\"shell-com-845358301\" class=\"J_module\">\n<div class=\"module-detailImageText\">\n<div> </div>\n</div>\n</div>\n</div>\n</div>\n</div><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/31/67/03/365cba6b240e779b1dee0c94246ab47a.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/31/67/03/365cba6b240e779b1dee0c94246ab47a.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/31/67/03/365cba6b240e779b1dee0c94246ab47a.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/31/67/03/365cba6b240e779b1dee0c94246ab47a.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/31/67/03/365cba6b240e779b1dee0c94246ab47a.png"},{"base_url":"https://salt.tikicdn.com/ts/product/3c/3a/83/a97f7d70cbe9ec8e4b543b2a4c3bb9fc.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/3c/3a/83/a97f7d70cbe9ec8e4b543b2a4c3bb9fc.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/3c/3a/83/a97f7d70cbe9ec8e4b543b2a4c3bb9fc.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3c/3a/83/a97f7d70cbe9ec8e4b543b2a4c3bb9fc.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3c/3a/83/a97f7d70cbe9ec8e4b543b2a4c3bb9fc.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/fb/53/c4/e729d61680067a9342ae84f2febab010.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/fb/53/c4/e729d61680067a9342ae84f2febab010.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/fb/53/c4/e729d61680067a9342ae84f2febab010.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fb/53/c4/e729d61680067a9342ae84f2febab010.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fb/53/c4/e729d61680067a9342ae84f2febab010.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/9a/f5/b1/04f7cfc4f93c00720f5c17c2638a7f25.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/9a/f5/b1/04f7cfc4f93c00