":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/0d/ea/52/7af4108da8e0d37f6648735564e4d61e.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1429,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2 style=\"text-align: center;\"\u003eCOMBO Viên Uống Hỗ Trợ Xương Khớp DHC Canxi - Vitamin Tổng Hợp Nhật Bản\u003c/h2\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch3\u003eViên uống bổ sung Canxi DHC Calcium + CBP 30 Ngày, 90 Ngày\u003c/h3\u003e\n\u003cp\u003e\u003cstrong\u003eCông dụng:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e+ Bổ sung calci giúp hệ xương răng chắc khỏe, hỗ trợ phát triển chiều cao cho trẻ.\u003c/p\u003e\n\u003cp\u003e+ Giúp làm giảm nguy cơ loãng xương ở người cao tuổi, còi xương ở trẻ em.\u003c/p\u003e\n\u003cp\u003e+ CPB là thành phần protein chính được chiết xuất từ sữa non là nguồn dinh dưỡng tốt cho trẻ, giúp trẻ tăng cường sức đề kháng, hấp thụ chất dinh dưỡng, từ đó tăng trưởng chiều cao tốt hơn.\u003c/p\u003e\n\u003cp\u003e+ Lương CPB có trong 4 viên bổ sung Canxi + CBP tăng chiều cao DHC bằng lượng CPB có trong 8 lít sữa.\u003c/p\u003e\n\u003cp\u003e+ Canxi là một loại khoáng chất chính trong việc hình thành \u0026amp; tạo xương cho cơ thể.\u003c/p\u003e\n\u003cp\u003e+ Vitamin D giúp thúc đẩy \u0026amp; hỗ trợ việc tổng hợp Canxi, giúp cho xương chắc khỏe, cơ thể cao lớn.\u003c/p\u003e\n\u003cp\u003e+ Canxi + CBP tăng chiều cao DHC thơm vị sữa, bạn có thể nhai hoặc uống đều được.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eĐối tượng áp dụng:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eNgười có nhu cầu bổ sung calci: người bị loãng xương, phụ nữ sau mãnkinh, trẻ em còi xương, trẻ em trong giai đoạn phát triển chiều cao.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThành phần:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eMỗi 4 viên có chứa: Bột vỏ trứng: 1099,144mg (tương đương calci: 370mg)\u003c/p\u003e\n\u003cp\u003eWhey protein hoạt tính cô đặc từ sữa bò (CBP- concentrated bovine-milk whey active protein): 12 mg\u003c/p\u003e\n\u003cp\u003eVitamin D3 (cholecalciferol): 0,07μg.\u003c/p\u003e\n\u003cp\u003ePhụ liệu: Calci stearat, silicon dioxid, shellac, sáp carnauba, đường, bột ngô vừa đủ 4 viên.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCách dùng:\u003c/strong\u003e uống 4 viên/ngày (chia 2 lần uống, sau ăn 30p). Uống với nước hoặc nước ấm, hoặc nhai.\u003c/p\u003e\n\u003cp\u003eLưu ý:\u003c/p\u003e\n\u003cp\u003eThực phẩm này không phải là thuốc, không có tác dụng thay thế thuốc chữa bệnh.\u003c/p\u003e\n\u003cp\u003eDừng uống khi phát hiện bất thường. Không sử dụng cho người mẫn cảm với bất cứ thành phần nào của sản phẩm.\u003c/p\u003e\n\u003cp\u003eTham khảo ý kiến bác sỹ trước khi dùng nếu bạn đang dùng thuốc khác hoặc đang điều trị tại bệnh viện.\u003c/p\u003e\n\u003cp\u003eĐể xa tầm tay trẻ em. Sử dụng ngay sau khi mở bao bì.\u003c/p\u003e\n\u003cp\u003eĐóng túi ngay sau khi sử dụng.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eQuy cách đóng gói:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e+ Gói dùng trong 30 ngày: 120 viên.\u003c/p\u003e\n\u003cp\u003e+ Gói dùng trong 90 ngày: 360 viên.\u003c/p\u003e\n\u003cp\u003eBảo quản: Nơi khô ráo, thoáng mát, tránh ánh sáng mặt trời.\u003c/p\u003e\n\u003cp\u003eThương hiệu: DHC\u003c/p\u003e\n\u003cp\u003eXuất xứ: Made in Japan\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch3\u003eThực 