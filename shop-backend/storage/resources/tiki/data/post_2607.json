n_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":3,"review_text":"(3)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/media/catalog/product/t/u/tuc-ngu--ca-dao--dan-ca-viet-nam-bia-mem.u4972.d20170329.t151606.69925.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2722,"all_time_quantity_sold":24,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eTục Ngữ, Ca Dao, Dân Ca Việt Nam (Bìa Mềm)\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp\u003eTác phẩm của nhà nghiên cứu văn học Vũ Ngọc Phan được trao tặng Giải thưởng Hồ Chí Minh đợt đầu tiên (năm1996, lĩnh vực văn nghệ dân gian).\u003c/p\u003e\r\n\u003cp\u003eCuốn sách được tác giả dày công sưu tầm, khảo cứu trong suốt những năm tham gia kháng chiến chống Pháp, đặc biệt từ khi chuyển sang làm công tác nghiên cứu văn - sử - địa và hoàn thành vào năm 1956. Vũ Ngọc Phan đã có phần nghiên cứu tâm huyết về đặc điểm, giá trị đặc sắc của tục ngữ, ca dao, dân ca vô cùng đa dạng và phong phú của dân tộc Việt Nam ta (trong đó có cả của một số dân tộc thiểu số) bên cạnh phần tuyển chọn công phu.\u003c/p\u003e\r\n\u003cp\u003eĐặc biệt, cuốn sách còn có phần biên khảo rất sớm (với tầm nhìn xa trông rộng) và rất giá trị về dân ca, bao gồm các loại hình như: hát trống quân, hát xẩm, hát quan họ Bắc Ninh, hát ghẹo Phú Thọ, hát ví, hát giặm Nghệ Tĩnh, hò Huế, dân ca miền Nam Trung Bộ, dân ca Nam Bộ…\u003c/p\u003e\r\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/media/catalog/product/t/u/tuc-ngu--ca-dao--dan-ca-viet-nam-bia-mem.u4972.d20170329.t151606.69925.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/t/u/tuc-ngu--ca-dao--dan-ca-viet-nam-bia-mem.u4972.d20170329.t151606.69925.png","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/t/u/tuc-ngu--ca-dao--dan-ca-viet-nam-bia-mem.u4972.d20170329.t151606.69925.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/t/u/tuc-ngu--ca-dao--dan-ca-viet-nam-bia-mem.u4972.d20170329.t151606.69925.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/t/u/tuc-ngu--ca-dao--dan-ca-viet-nam-bia-mem.u4972.d20170329.t151606.69925.png"}],"warranty_policy":null,"authors":[{"id":25722,"name":"Vũ Ngọc Phan","slug":"vu-ngoc-phan"}],"current_seller":{"id":279977,"sku":"5920522334407","name":"Tiệm sách Minh Hằng","link":"https://tiki.vn/cua-hang/tiem-sach-minh-hang","logo":"72/e9/31/97b276a4c1d9e00bf2bac4f286c5b7c9.jpg","price":83000,"product_id":"189491494","store_id":267047,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[{"id":10984,"name":"Minhhabooks","link":"https://tiki.vn/cua-hang/minhhabooks","logo":"90/e2/81/710a7373c42be1565897d82ccbc00579.png","price":72000,"product_id":"13951768","store_id":10718},{"id":161219,"name":"Nhà Sách Trẻ Online","link":"https://tiki.vn/cua-hang/nha-sach-tre-online","logo":"6f/c0/15/6a56eb097a331c384398004ed5bc09ca.jpg","price":88200,"product_id":"274080106","store_id":148433},{"id":127989,"name":"Times Books","link":"https://tiki.vn/cua-hang/times-books","