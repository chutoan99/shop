":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/67/61/ce/6c6c4a0806ce778091ae98cfec0a96d0.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2217,"all_time_quantity_sold":3,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"margin:4px 0px;padding:0px;color:#231f20;font-family:Tahoma, Arial;text-align:justify;\"\u003e\u003cstrong style=\"margin:0px;padding:0px;line-height:28px;\"\u003e\u003ciframe src=\"//www.youtube.com/embed/fzk53iiAd9w\" width=\"560\" height=\"314\" allowfullscreen=\"\"\u003e\u003c/iframe\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"margin:4px 0px;padding:0px;color:#231f20;font-family:Tahoma, Arial;text-align:justify;\"\u003e\u003cstrong style=\"margin:0px;padding:0px;line-height:28px;\"\u003eMô tả sản phẩm Máy sấy hoa quả Makxim USA MKX-DH-2015:\u003c/strong\u003e\u003c/p\u003e\n\u003cul style=\"margin:0px;padding:0px;color:#231f20;font-family:Tahoma, Arial;text-align:justify;\"\u003e\u003cli style=\"margin:0px;padding:0px;\"\u003eDễ sử dụng, độ bền cao\u003c/li\u003e\n\u003cli style=\"margin:0px;padding:0px;\"\u003eVỏ inox siêu bền, chống xước\u003c/li\u003e\n\u003cli style=\"margin:0px;padding:0px;\"\u003eMàn hình hiển thị LCD\u003c/li\u003e\n\u003cli style=\"margin:0px;padding:0px;\"\u003e5 khay sấy riêng biệt\u003c/li\u003e\n\u003cli style=\"margin:0px;padding:0px;\"\u003eGiúp cô đặc đường và vitamin\u003c/li\u003e\n\u003cli style=\"margin:0px;padding:0px;\"\u003eLàm hoa quả khô, làm mứt\u003c/li\u003e\n\u003cli style=\"margin:0px;padding:0px;\"\u003eLàm cá khô, bò khô\u003c/li\u003e\n\u003c/ul\u003e\u003cp style=\"margin:4px 0px;padding:0px;color:#231f20;font-family:Tahoma, Arial;text-align:justify;\"\u003e\u003cstrong style=\"margin:0px;padding:0px;line-height:28px;\"\u003eMakxim MKX-DH-2015\u003c/strong\u003e - Máy sấy khô hoa quả, thực phẩm dành cho gia đình. Các loại hoa quả tươi thường rất tốt cho sức khỏe và thơm ngon. Nhưng việc bảo quản chúng lại khá khó khăn, thường thì thời gian bảo quản không được lâu. Do đó, một chiếc máy sấy khô hoa quả giúp bạn sấy khô các loại hoa quả, rau củ, tạo thành món củ quả khô với lượng đường cao và giữ được nhiều chất dinh dưỡng, vitamin có sẵn trong hoa quả.\u003c/p\u003e\n\u003cp style=\"margin:4px 0px;padding:0px;color:#231f20;font-family:Tahoma, Arial;text-align:justify;\"\u003e\u003cimg class=\"lazy\" style=\"margin:4px auto;padding:0px;border:none;vertical-align:middle;max-width:100%;text-align:center;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/22/a2/b3/a5db6484cbf632548035661eca430f8c.jpg\" alt=\"a5db6484cbf632548035661eca430f8c.jpg\" /\u003e\u003c/p\u003e\n\u003cp style=\"margin:4px 0px;padding:0px;color:#231f20;font-family:Tahoma, Arial;text-align:justify;\"\u003eNhư vậy, bạn không còn bận tâm đến lượng hoa quả dồi dào trong tủ lạnh mà chưa thể tiêu thụ hết, bạn cũng không còn lo lắng việc củ quả bị hư hỏng do tích trữ quá lâu. Máy sấy hoa quả Makxim sẽ giúp bạn xử lý nhanh chóng với phương pháp cực kỳ hiện đại. Bạn chỉ cần thái lát hoa quả ra (với những loại hoa quả to) hoặc tách nhỏ (với những dạng quả theo chùm hoặc có vỏ) và đặt vào trong khay sấy. Hệ thống điều khiển thông minh với màn hình LCD.* Nhiệt độ sấy từ 40 - 70 độ * Hẹn giờ lên đến 36 tiếng Máy sấy khô hoa quả, thực phẩm Makxim MKX-DH-2015 giúp các thực phẩm vẫn giữ nguyên hương vị, màu sắc, mùi thơm và vitamin sau khi được sấy khôtrong một thời gian dài. Nếu bạn thích ăn các loại thực phẩm sấy khô, thì máy sấy Makxim MKX-DH-2015 sẽ là sự lựa chọn tuyệt vời. Chính tay bạn sẽ làm ra những món ăn sấy khô ngon, bổ dưỡng cho người thân và bạn bè mỗi dịp cuối tuần. Makxim MKX-DH-2015có thể sấy khô được nhiều loại thực phẩm như: trái cây, rau củ quả, nấm, dược liệu, hoa, các loại hạt,…Với thiết kế 5 khay sấy riêng biệt, bạn có thể sấy khô cùng lúc nhiều loại thực phẩm khác nhau. Bạn có thể sử dụng một hay nhiều khay sấy, tùy theo số lượng thực phẩm cần sấy khô.\u003c/p\u003e\n\u003cp style=\"margin:4px 0px;padding:0px;color:#231f20;font-family:Tahoma, Arial;text-align:justify;\"\u003eMáy sấy hoa quả được thiết kế nhỏ gọn, không chiếm nhiều diện tích khi sử dụng.Vỏ máy có viền inox xước sáng bóng, khay sấy được thiết kế bằng nhựa trong suốt, giúp bạn nhìn thấy các thực phẩm trong quá trình sấy. Các khay sấy có thể tháo rời, bạn dễ dàng vệ sinh và bảo quản máy.Các khay sấy sau khi sử dụng có thể xếp chồng lên nhau gọn gàng, thuận tiện trong việc di chuyển và cất giữ. Ngoài ra, máy có hệ thống bảo vệ quá tải nhiệt, nên rất an toàn cho người sử dụng. Thông số kỹ thuật của máy sấy khô hoa quả, thực phẩm\u003c/p\u003e\n\u003cp style=\"margin:4px 0px;padding:0px;color:#231f20;font-family:Tahoma, Arial;text-align:justify;\"\u003e\u003cstrong style=\"margin:0px;padding:0px;line-height:28px;\"\u003eMakxim MKX-DH-2015:\u003c/strong\u003e\u003c/p\u003e\n\u003cul style=\"margin:0px;padding:0px;color:#231f20;font-family:Tahoma, Arial;text-align:justify;\"\u003e\u003cli style=\"margin:0px;padding:0px;\"\u003eKích thước sản phẩm (D x R x C): 34 x 28 x 27 cm\u003c/li\u003e\n\u003cli style=\"margin:0px;padding:0px;\"\u003eTrọng lượng:2.8kg\u003c/li\u003e\n\u003cli style=\"margin:0px;padding:0px;\"\u003eNhiệt độ sấy từ 40 - 70 độ C\u003c/li\u003e\n\u003cli style=\"margin:0px;padding:0px;\"\u003eHẹn giờ lên đến 36 tiếng\u003c/li\u003e\n\u003cli style=\"margin:0px;padding:0px;\"\u003e5 khay sấy\u003c/li\u003e\n\u003c/ul\u003e\u003cp style=\"margin:4px 0px;padding:0px;color:#231f20;font-family:Tahoma, Arial;text-align:justify;\"\u003eHệ thống điều khiển thông minh với màn hình LCD Hướng dẫn sử dụng máy sấy khô hoa quả, thực phẩm Makxim MKX-DH-2015: Cho hoa quả, thực phẩm sau khi đã rửa sạch ngâm qua nước nóng trước khi sấy để giữ được màu sắc của hoa quả sau khi sấy, đồng thời giúp loại bỏ vi khuẩn bám trên hoa quả. Thái lát hoa quả, thực phẩm (với những loại hoa quả, thực phẩm to) hoặc tách nhỏ (với những dạng quả theo chùm hoặc có vỏ) và đặt vào trong khay sấy.Sau đó, đóng nắp và cắm điện, chỉ trong một khoàng thời gian ngắn, hoa củ quả đã được tách nước, chỉ còn lại chất bột, đường và xơ, một dạng thực phẩm rất có lợi cho tiêu hóa và sức khỏe của gia đình bạn.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp style=\"margin:4px 0px;padding:0px;color:#231f20;font-family:Tahoma, Arial;text-align:justify;\"\u003e\u003cimg class=\"lazy\" style=\"margin:4px auto;padding:0px;border:none;vertical-align:middle;max-width:100%;text-align:center;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/2c/d2/30/44c5c916154068800d8c8f0fd7e63f1f.jpg\" alt=\"44c5c916154068800d8c8f0fd7e63f1f.jpg\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp style=\"margin:4px 0px;padding:0px;color:#231f20;font-family:Tahoma, Arial;text-align:justify;\"\u003e\u003cimg class=\"lazy\" style=\"margin:4px auto;padding:0px;border:none;vertical-align:middle;max-width:100%;text-align:center;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/57/cb/46/c517f71e7f4e6c219defa2ae78ad2ace.jpg\" alt=\"c517f71e7f4e6c219defa2ae78ad2ace.jpg\" /\u003e\u003c/p\u003e\n\u003cp style=\"margin:4px 0px;padding:0px;color:#231f20;font-family:Tahoma, Arial;text-align:justify;\"\u003e\u003cimg class=\"lazy\" style=\"margin:4px auto;padding:0px;border:none;vertical-align:middle;max-width:100%;text-align:center;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/ef/10/f4/708ec0f411f22e9a54e5733bc592d81a.jpg\" alt=\"708ec0f411f22e9a54e5733bc592d81a.jpg\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ ph