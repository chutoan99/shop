7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.8,"review_count":101,"review_text":"(101)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/d6/fc/6a/a5f34743ce462f4ab3eac6aa718dfd8e.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1037,"all_time_quantity_sold":1277,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eĐạt danh hiệu gạo ngon nhất thế giới năm 2019 tại Manila Gạo cho cơm mềm, dẻo dai, cơm giữ nguyên hạt,mùi thơm tự nhiên, để nguội cơm vẫn ngon Gạo được sản xuất theo quy trình gạo sạch, không dư lượng thuốc, bảo đảm ATVSTP Hàm lượng dinh dưỡng cao, tốt cho sức khỏe\u003c/p\u003e\n\u003cp\u003eGạo được chế biến từ những giống lúa thơm phẩm chất thượng hạng ở Sóc Trăng. Vỏ lúa màu nâu hoặc vàng nâu, hạt gạo dài 9mm. Cơm thơm dẻo mềm, vị ngọt. Hàm lượng đạm trong gạo thật cao ( 10% protein), cao gắp rưởi gạo thường, vì vậy sẽ no trước khi đầy bụng.\u003c/p\u003e\n\u003cp\u003eGạo ST25 được trồng từ giống lúa cùng tên. Là giống lúa mùa được được nghiên cứu và phát triển bởi kỹ sư Hồ Quang Cua. ST25 là loại gạo thuộc nhóm hảo hạng trong thị trường gạo hiện nay. Gạo hạt dài, trong, không bạc bụng. Cơm khi nấu dẻo, thơm mùi lá dứa, hương vị ngọt dẻo đặc biệt rất thu hút. Gạo thuộc loại dẻo thơm nên nấu ít nước, cơm vẫn dẻo dù không xới khi nấu, đặc biệt cơm vẵn giữ được độ dẻo, không bị cứng khi để nguội.\u003c/p\u003e\n\u003cp\u003eSản phẩm trực tiếp từ DNTN Hồ Quang Trí, công ty sở hữu độc quyền các giống lúa đặc sản ST của kỹ sư Hồ Quang Cua tại Sóc Trăng.\u003c/p\u003e\n\u003cp\u003eLúa ST25 được canh tác theo mô hình vuông tôm. Mùa khô nuôi tôm, mưa rửa mặn xong trồng lúa. Do ý thức giữ môi trường tốt cho vụ sau nuôi tôm thành công nên nông dân tuân thủ rất tốt quy trình sản xuất hữu cơ.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eVùng trồng gồm các huyện: Trần Đề, Mỹ Xuyên, Thạnh Trị, Châu Thành và thị xã Ngã Năm.\u003c/p\u003e\n\u003cp\u003eGạo ST25 của Việt Nam đã được trao giải gạo ngon nhất thế giới tại cuộc thi World's Best Rice, do The Rice Trader tổ chức.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/d6/fc/6a/a5f34743ce462f4ab3eac6aa718dfd8e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d6/fc/6a/a5f34743ce462f4ab3eac6aa718dfd8e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d6/fc/6a/a5f34743ce462f4ab3eac6aa718dfd8e.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d6/fc/6a/a5f34743ce462f4ab3eac6aa718dfd8e.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d6/fc/6a/a5f34743ce462f4ab3eac6aa718dfd8e.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/6c/8a/9c/c8d3a26f74de26d3017057bb6c389cfe.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/6c/8a/9c/c8d3a26f74de26d3017057bb6c389cfe.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/6c/8a/9c/c8d3a26f74de26d3017057bb6c389cfe.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6c/8a/9c/c8d3a26f74de26d301705