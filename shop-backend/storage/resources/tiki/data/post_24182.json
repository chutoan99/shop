ext":"9.9"},{"placement":"pdp_badge","code":"is_hero","type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":true,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.8,"review_count":23,"review_text":"(23)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/8e/5d/bd/6967f6975306df071fe3f1d8257f0840.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1183,"all_time_quantity_sold":102,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003chtml\u003e\n \u003chead\u003e\u003c/head\u003e\n \u003cbody\u003e\n  \u003cul\u003e\n   \u003cp\u003e=== ƯU ĐIỂM CỦA SẢN PHẨM ===\u003c/p\u003e\n   \u003cp\u003e+ Nguyên liệu nhựa nguyên sinh cao cấp, đã thông qua kiểm định theo tiêu chuẩn về an toàn vệ sinh thực phẩm.\u003c/p\u003e\n   \u003cp\u003e+ Đạt tiêu chuẩn khắt khe cho các sản phẩm gia dụng, thực phẩm, y tế của Nhật Bản.\u003c/p\u003e\n   \u003cp\u003e+ Không chứa BPA, không màu, không mùi, không tiết ra các chất có hại trong quá trình sử dụng.\u003c/p\u003e\n   \u003cp\u003e+ Tích hợp các tính năng vượt trội, kháng khuẩn, khử mùi…\u003c/p\u003e\n   \u003cp\u003e+ Nắp đậy kín khí giữ thực phẩm luôn tươi ngon\u003c/p\u003e\n   \u003cp\u003e+ Chịu nhiệt từ -20°C ～ 120°C có thể để trong ngăn đá tủ lạnh, lò vi sóng hoặc máy rửa bát\u003c/p\u003e\n   \u003cp\u003e+ Gọn nhẹ linh hoạt cách sắp xếp (dựng đứng, để ngang)\u003c/p\u003e\n   \u003cp\u003e+ Màu sắc: Xanh, Trắng, Cam, Trong\u003c/p\u003e\n   \u003cp\u003e+ Hình dáng: Vuông, Tròn, Chữ nhật\u003c/p\u003e\n   \u003cp\u003e+ Kích thước: 500ml: 143 x 99 x 50.5 mm - Trọng lượng: 64gr\u003c/p\u003e\n   \u003cp\u003e+ Kích thước: 750ml: 162 x 114 x 57 mm - Trọng lượng: 83gr\u003c/p\u003e\n   \u003cp\u003e+ Kích thước: 1000ml: 178 x 124 x 62.5 mm - Trọng lượng: 97gr\u003c/p\u003e\n   \u003cp\u003e+ Kích thước: 1500ml: 203 x 141 x 70.5 mm - Trọng lượng: 126gr\u003c/p\u003e\n   \u003cp\u003e+ Kích thước: 2000ml: 222 x 154 x 78 mm - Trọng lượng: 159gr\u003c/p\u003e\n   \u003cp\u003e+ Kích thước: 2500ml: 238 x 165 x 84 mm - Trọng lượng: 193gr\u003c/p\u003e\n   \u003cp\u003e=== MỘT SỐ LƯU Ý KHI SỬ DỤNG ===\u003c/p\u003e\n   \u003cp\u003e+ Mở nắp sản phẩm khi sử dụng trong lò vi sóng.\u003c/p\u003e\n   \u003cp\u003e+ Không nên hâm trong lò vi sóng quá 2 phút.\u003c/p\u003e\n   \u003cp\u003e+ Tránh bảo quản thực phẩm có nhiều dầu mỡ và phẩm màu.\u003c/p\u003e\n   \u003cp\u003e+ Không để gần lửa, không để trong lò nướng.\u003c/p\u003e\n   \u003cp\u003e+ Rửa sạch và để khô ngay sau khi sử dụng.\u003c/p\u003e\n   \u003cp\u003e+ Không rửa sản phẩm bằng chất tẩy rửa mạnh.\u003c/p\u003e\n   \u003cp\u003e=== NGUỒN GỐC CỦA SẢN PHẨM ===\u003c/p\u003e\n   \u003cp\u003e=== CAM KẾT CỦA CHÚNG TÔI ===\u003c/p\u003e\n   \u003cp\u003e+ Sản phẩm xuất khẩu thị trường Nhật Bản chính hãng 100% do chúng tôi sản xuất.\u003c/p\u003e\n   \u003cp\u003e+ Đảm bảo chất lượng, dịch vụ tốt nhất, hàng được giao từ 1-5 ngày kể từ ngày đặt hàng.\u003c/p\u003e\n  \u003c/ul\u003e\n \u003c/body\u003e\n\u003c/html\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/8e/5d/bd/6967f6975306df071fe3f1d8257f0840.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/8e/5d/bd/6967f6975306df071fe3f1d8257f0840.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/8e/5d/bd/6967f6975306df071fe3f1d8257f0840.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8e/5d/bd/6967f6975306df071fe3f1d8257f0840.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8e/5d/bd/6967f6975306df071fe3f1d8257f0840.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/1a/94/1e/45c727e035496ed0a3c6d4cddeaa73f2.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/1a/94/1e/45c727e035496ed0a3c6d4cddeaa73f2.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/1a/94/1e/45c727e035496ed0a3c6d4cddeaa73f2.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1a/94/1e/45c727e035496ed0a3c6d4cddeaa73f2.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1a/94/1e/45c727e035496ed0a3c6d4cddeaa73f2.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/40/3d/86/c5e821f548693ba6a156d05eb2b59ca8.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/40/3d/86/c5e821f548693ba6a156d05eb2b59ca8.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/40/3d/86/c5e821f548693ba6a156d05eb2b59ca8.jpg","position":null,"small_url":"https://salt.tikicdn.com/c