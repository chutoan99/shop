nd_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":19200,"discount_rate":15,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/86/25/a4/511f3c904f974cbb709e8dfc19ff820a.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":145,"all_time_quantity_sold":4,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cdiv\u003e\u003cstrong\u003eThần Đèn - Tập 2\u003c/strong\u003e\u003c/div\u003e\n\u003cul\u003e\n\u003cli\u003eTác giả: Thâm Hải Cự Cẩu\u003c/li\u003e\n\u003cli\u003eDịch giả: Bán Sinh Phù Trầm\u003c/li\u003e\n\u003cli\u003eThể loại: Truyện tranh \u003c/li\u003e\n\u003cli\u003eKhổ sách: 13x18cm\u003c/li\u003e\n\u003cli\u003eSố trang: 232 trang in màu\u003c/li\u003e\n\u003cli\u003eISBN: 978-604-378-874-7\u003c/li\u003e\n\u003cli\u003eNXB liên kết: NXB Dân Trí\u003c/li\u003e\n\u003cli\u003eQuà tặng kèm: Bao gồm bộ bìa 2 lớp độc đáo, cán màng nhung mịn, phần tên truyện phủ nhũ sần huyền bí; 01 Postcard Gia Đình “Hạnh Phúc” 10x15cm.\u003c/li\u003e\n\u003cli\u003ePhát hành: 30/04/2024 \u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eGiới thiệu:\u003c/p\u003e\n\u003cp\u003eTương truyền rằng có một tinh linh sở hữu sức mạnh vô ngần bị nhốt trong cây đèn thần, ai tìm thấy đèn thần thì có thể trở thành chủ nhân của tinh linh. Tinh linh sẽ thực hiện ba điều ước của chủ nhân. Sau khi điều ước cuối cùng thành hiện thực, tinh linh sẽ có được sự tự do.\u003c/p\u003e\n\u003cp\u003eỞ thế giới mộng tưởng ấy, những thứ tốt đẹp và hạnh phúc đều rất đỗi chân thực, chúng xảy đến như lẽ đương nhiên. Nhưng trong thế giới không có thần đèn ban phước, Red phải tự bước đi trên con đường đầy gian truân tàn khốc bằng chính đôi chân của mình. Mất đi sự bảo hộ của thần, dù vị dũng sĩ có mạnh mẽ ra sao cũng không thể chiến thắng cả ngàn quân địch - những cuộc chiến không hồi kết đã khiến Red nếm trải đủ mọi giày vò mất mát cùng cơ số vết sẹo khắc ghi mãi trên cơ thể không tài nào xóa nhòa. Trong lòng anh chỉ còn sục sôi một ý niệm duy nhất, đó chính là “Báo thù”.\u003c/p\u003e\n\u003cp\u003eMột lần nữa quay trở lại chốn làng quê xưa, chỉ khác rằng giờ đây Red đã trở thành tướng quân dẫn đầu đội quân hùng mạnh, mang theo một “món quà” dành tặng vị tinh linh đang say ngủ trong chiếc đèn thần kia…\u003c/p\u003e\n\u003cp\u003e#amak #truyện_tranh #thần_đèn_2 #thâm_hải_cự_cẩu\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/86/25/a4/511f3c904f974cbb709e8dfc19ff820a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/86/25/a4/511f3c904f974cbb709e8dfc19ff820a.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/86/25/a4/511f3c904f974cbb709e8dfc19ff820a.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/86/25/a4/511f3c904f974cbb709e8dfc19ff820a.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/86/25/a4/511f3c904f974cbb709e8dfc19ff820a.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/be/d5/0c/5fca52fbd6cbc3b49fd6e38d60a7f1a2.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/be/d5/0c/5fca52fbd6cbc3b49fd6e38d60a7f1a2.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/pr