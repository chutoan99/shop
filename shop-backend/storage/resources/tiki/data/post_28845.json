_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.6,"review_count":17,"review_text":"(17)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/13/d1/f6/937a07c81e2bd588d47db2102fdd09d2.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1377,"all_time_quantity_sold":246,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e*** Bao bì có thể thay đổi theo từng đợt nhập hàng\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eXịt khoáng cấp ẩm và làm dịu da Evian Brumisateur \u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003echứa nguồn nước khoáng bắt nguồn từ nước mưa và tuyết tan lắng đọng tại lưu vực hàng ngàn năm tuổi trung tâm dãy Alps, được bao quanh bởi nhiều núi và sông băng. \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eTại độ cao 850m của trung tâm dãy Alps, không bị tác động bởi ô nhiễm từ các khu thành thị và khu công nghiệp, nguồn nước này cực kỳ tinh khiết, được làm giàu bởi các khoáng chất thiết yếu từ thiên nhiên\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eXịt khoáng EVIAN FACIAL SPRAY Sản phẩm ‘cần có’ trong chu trình chăm sóc da hàng ngày\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eKhông trải qua bất kỳ công đoạn xử lý hóa chất nào, tinh khiết nhất có thể\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003epH trung tính, không gây dị ứng\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eMỗi lần nhấn xịt tạo giọt sương mịn, làm ẩm da tức thì\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eSự cân bằng khoáng chất độc đáo, khác biệt với các nguồn nước khác\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eThành phần khoáng chất (mg/l): Ca++ 80 - Mg ++ 26 - Na+ 6,5 - K+ 1 - SiO2 15 - HCO3- 360 - SO4- - 12,6 - Cl- 6,8 - NO3- 3,7  \u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eCông dụng:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eBuổi sáng\u003c/span\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eNhẹ nhàng đánh thức làn da mệt mỏi và xỉn màu\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eCấp nước cho da trước khi trang điểm\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eGiúp giảm bọng mắt và làm da sáng khỏe\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eLoại bỏ những tạp chất rắn và cặn thừa từ nước máy sau khi tắm\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eTrong ngày\u003c/span\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eNgay lập tức làm mới lớp trang điểm và hỗ trợ kiềm dầu, giúp da khô thoáng chỉ với 1 bước xịt khoáng đơn giản\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eDưỡng ẩm cho da mọi lúc: khi đi du lịch, chơi thể thao, làm việc ở văn phòng hay trong lúc di chuyển\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eBuổi tối\u003c/span\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eNhẹ nhàng loại bỏ lớp dầu mỏng để lại do một số sản phẩm làm sạch\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eMang lại cảm giác sạch mát và làn da khỏe mạnh\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eDung tích:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003e50ml: Xịt khoáng evian Brumisateur nhỏ gọn thích hợp bỏ túi xách, dễ dàng mang theo khi di chuyển.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003e150ml: Thích hợp để trên xe oto, tàu, văn phòng. Xxt khoáng dung tích 150ml giúp ngăn ngừa da khô mất nước do thường xuyên ngồi dưới điều hòa, ô nhiễm. \u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003e300ml: Thích hợp để phòng tắm dùng cho người lớn. Dung tích 300 ml phù hợp cho cả gia đình sử dụng.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eCách sử dụng:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eXịt và giữ trên da vài phút, sau đó để xịt khoáng tự khô hoặc thấm nhẹ bằng khăn mềm để loại bỏ nước còn lại.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003e Dùng thường xuyên theo ý muốn.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eHạn sử dụng: \u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003e3 năm kể từ ngày sản xuất.\u003c/span\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/13/d1/f6/937a07c81e2bd588d47db2102fdd09d2.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/13/d1/f6/937a07c81e2bd588d47db2102fdd09d2.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/13/d1/f6/937a07c81e2bd588d47db2102fdd09d2.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/13/d1/f6/937a07c81e2bd588d47db2102fdd09d2.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/13/d1/f6/937a07c81e2bd588d47db2102fdd09d2.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/fc/1a/8c/7d26c5775bc8339f6422b2a4e584a718.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/fc/1a/8c/7d26c5775bc8339f6422b2a4e584a718.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/fc/1a/8c/7d26c5775bc8339f6422b2a4e584a718.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fc/1a/8c/7d26c5775bc8339f6422b2a4e584a718.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fc/1a/8c/7d26c5775bc8339f6422b2a4e584a718.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/4c/7d/7b/c6eb7bce50c704ee6af56d1f870d5c53.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/4c/7d/7b/c6eb7bce50c704ee6af56d1f870d5c53.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/4c/7d/7b/c6eb7bce50c704ee6af56d1f870d5c53.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4c/7d/7b/c6eb7bce50c704ee6af56d1f870d5c53.jpg","thumbnail_url":"https://s