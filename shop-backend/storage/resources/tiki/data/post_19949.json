","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.7,"review_count":7,"review_text":"(7)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/df/37/3c/7f31abca79d5924e80592040d3f456ee.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2153,"all_time_quantity_sold":35,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e\u003cspan style=\"box-sizing: border-box;\"\u003eTHÔNG TIN SẢN PHẨM\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e\u003cspan style=\"box-sizing: border-box;\"\u003eTên sản phẩm : Chai thả bồn cầu làm sạch diệt khuẩn Hương Hoa Ly Mr.Fresh Hàn Quốc 180g\u003c/span\u003e\u003cbr style=\"box-sizing: border-box;\" /\u003eCông dụng : Giữ cho bồn cầu sạch sẽ mà không cần phải dùng cọ rửa, tẩy các vết bẩn bám vào thành toilet, diệt khuẩn. \u003cbr style=\"box-sizing: border-box;\" /\u003eThành phần : Anionic Sunfactants, chất hoạt động bề mặt , Hương liệu , hạt tạo mầu , bột tạo khuân kết dính\u003cbr style=\"box-sizing: border-box;\" /\u003eHướng dẫn sử dụng    :       - Mở nắp chai và điều chỉnh độ màu sắc của nước với núm xoay thông minh.Mở nắp bồn chứa nước, xả hết nước trong bồn.\u003cbr style=\"box-sizing: border-box;\" /\u003e                                        - Đợi lượng nước trong bồn rút hết, thả nguyên cả chai vào góc bồn nước ở vị trí xa van xả.\u003cbr style=\"box-sizing: border-box;\" /\u003e                                        - Sau khoảng 10 phút, nước trong bồn sẽ chuyển sang màu xanh nước biển.\u003cbr style=\"box-sizing: border-box;\" /\u003eHướng dẫn bảo quản : Bảo quản nơi khô, mát, Để xa tầm với trẻ em.Hạn chế tiếp xúc trực tiếp với da , nếu dính vào thì rửa ngay bằng nước sạch\u003cbr style=\"box-sizing: border-box;\" /\u003eQuy cách đóng gói : Chai\u003cbr style=\"box-sizing: border-box;\" /\u003ekích thước : 13 x 7 x 7 cm\u003cbr style=\"box-sizing: border-box;\" /\u003eMàu sắc : Hồng\u003cbr style=\"box-sizing: border-box;\" /\u003eHương : Hoa Ly\u003cbr style=\"box-sizing: border-box;\" /\u003eKhối lượng tịnh : 180g\u003cbr style=\"box-sizing: border-box;\" /\u003eTrọng lượng : 400g\u003cbr style=\"box-sizing: border-box;\" /\u003eXuất xứ : Hàn Quốc -Korea\u003cbr style=\"box-sizing: border-box;\" /\u003eSản xuất : SDJ Corporation ,Korea\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003eBận rộn với công việc công sở và dành nhiều thời gian để chăm lo con cái nên bạn ít có thời gian lau rửa toilet, dọn dẹp nhà vệ sinh. Bồn cầu trong toilet nhà bạn nếu trong 1 tuần không được cọ rửa, sẽ chuyển sang màu ố vàng, thậm chí còn có mùi hôi rất khó chịu. Sử dụng chai thả bồn cầu Hàn Quốc(hay còn gọi là cốc thả bồn cầu hoặc bình thả két nước) là giải pháp vô cùng hữu hiệu đỡ cho bạn rất nhiều thời gian, bồn cầu cũng như toilet nhà bạn sẽ luôn sạch sẽ và thơm mát chẳng kém gì các khách sạn sang trọng cả.\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: center;\"\u003e\u003cimg src=\"https://vcdn.tikicdn.com/ts/tmp/bd/12/87/d126ad84488fac269fbb212d934e4a25.jpg\" alt=\"\" width=\"750\" height=\"879\" /\u003e\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: center;\"\u003e\u003cspan style=\"box-sizing: border-box;\"\u003e1 Chai Thả Bồn Cầu Mr Fresh 180g (Hương Hoa Ly) có thể sử dụng cho 2000 lần xả nước\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003eMột chai có trọng lượng 400g, trọng lượng chất tẩy nặng 180g có thể dùng được ít nhất 40 ngày tương đương với 2000 lần xả nước. Nhưng thực tế sử dụng cho thấy đối với mức dùng trung bình của một hộ gia đình 4 người thì thời gian sử dụng hết 1 chai cũng rơi vào khoảng 2,5-3 tháng.\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: center;\"\u003e\u003cimg style=\"box-sizing: border-box; vertical-align: middle; border: 0px; display: block; max-width: 100%; height: auto; margin-left: auto; margin-right: auto;\" src=\"https://vn-live.slatic.net/v2/resize/products/S-12702-34ea2327c2f12e3869d6139e1c083066.jpg\" data-cke-saved-src=\"https://vn-live.slatic.net/v2/resize/products/S-12702-34ea2327c2f12e3869d6139e1c083066.jpg\" /\u003e\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e\u003cbr style=\"box-sizing: border-box;\" /\u003eĐặc điểm của chai thả bồn cầu Hàn Quốc này là chất tẩy dạng rắn (sáp), hòa tan trong nước và phân hủy nhanh vì thành phần chính chưa chất phốt pho không gây tắc nghẽn. Sản phẩm có công thức sinh học tiên tiến được đặc chế không gây hại cho các loại khuẩn có lợi cho toilet và cho con người. Sản phẩm không những có tác dụng KHỬ MÙI HÔI và DIỆT TẬN GỐC CÁC VI KHUẨN CÓ HẠI, hạn chế sự sinh trưởng của vi trùng gây hại, mà còn thay vì 1-2 ngày bạn phải cọ rửa bồn cầu 1 lần thì với sản phẩm này chỉ 1-2 TUẦN BẠN MỚI PHẢI CỌ RỬA BỒN CẦU 1 LẦN. Như vậy đã đỡ mất thời gian và công sức của bạn khá nhiều phải không nào. Hơn nữa, sản phẩm còn giúp duy trì sự sáng bóng của gốm (men) bồn cầu.\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: center;\"\u003e\u003cimg src=\"https://vcdn.tikicdn.com/ts/tmp/04/7b/0b/0f1fea6baf08fd486a46543668887ee6.jpg\" alt=\"\" width=\"750\" height=\"720\" /\u003e\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: center;\"\u003e\u003cspan style=\"box-sizing: border-box;\"\u003eChai thả dạng sáp màu xanh có tác dụng làm sạch, khử mùi , diệt khuẩn tận gốc cho bồn cầu, kèm theo đó là Hương Thơm Hoa Ly\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003eVới màu xanh dương đặc trưng, chai thả bồn cầu giúp giữ không khí trong lành và mang lại cho bạn cảm giác dễ chịu. Bạn cũng có thể dễ dàng điều chỉnh màu sắc của nước theo ý thích bằng việc điều chỉnh độ đậm đặc tiết ra ngoài qua núm xoay thông minh. Với núm xoay thông minh trên nắp chai, bạn có thể mở rộng hay thu hẹp các khe trên nắp theo ý muốn. Nhớ là khe mở càng to thì màu xanh của nước càng đậm đặc và đi kèm với nó là sản phẩm sẽ nhanh hết bạn nhé.\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003eSản phẩm chai tẩy bồn cầu loại thơm này có mùi thơm Hoa Ly rất dễ chịu, được sản xuất tại Hàn Quốc và được bảo quản nơi khô ráo, thoáng mát. Rất thích hợp sử dụng cho nhà riêng, công ty, nhà hàng, khách sạn...\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e=\u0026gt; Tiết kiệm chi tiêu. Tiết kiệm thời gian dọn dẹp vệ sinh. Khử sạch mùi hôi khó chịu. Ngăn ngừa vi khuẩn gây hại. Cho bồn cầu luôn sạch bóng, thơm mát. Hãy sử dụng chai thả bồn cầu Hàn Quốc để có thấy được những công hiệu tuyệt vời.\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: center;\"\u003e\u003cspan style=\"box-sizing: border-box;\"\u003eNgày sản xuất được in trên nắp chai (Hạn sử dụng là 3 năm tính từ ngày sản xuất)\u003c/span\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/df/37/3c/7f31abca79d5924e80592040d3f456ee.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/df/37/3c/7f31abca79d5924e80592040d3f456ee.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/df/37/3c/7f31abca79d5924e80592040d3f456ee.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/df/37/3c/7f31abca79d5924e80592040d3f456ee.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/df/37/3c/7f31abca79d5924e80592040d3f456ee.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/78/25/07/caa3a1a76df50b5869131399dc86629d.jpg","is_gallery":true,"la