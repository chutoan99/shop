04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/bc/1c/b0/5ba29ba7e9c9db70e0005307a2a70dab.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":49,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cdiv\u003eVăn chương Việt Nam thời hiện đại, có nhiều cặp vợ chồng cùng viết văn. Cố nhà văn, thi sĩ Hoàng Phủ Ngọc Tường và cố nhà thơ Lâm Thị Mỹ Dạ là một trong những \"cặp đôi văn chương\" đó. Số phận đã đưa hai con người tài hoa tới với nhau để rồi để lại cho đời những di sản văn chương đẹp đẽ.\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv\u003eNếu nói, điều gì đã gắn kết hai tâm hồn để đường văn, đường thơ của họ ở lại với người đọc và cuộc đời thì phải kể đến “tình yêu” đã đi qua năm tháng với văn chương.\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv\u003eNgười đàn ông, đứng trước một dòng sông, tự vấn với chính mình bằng lời thơ sâu lắng, chan chứa, man mác buồn. Người phụ nữ viết ra những thi từ đầy tính nữ, yêu thương và khát vọng trước một cuộc đời không thiếu những nông nỗi và bất trắc.\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv\u003eCho đến khi rời khỏi “cõi tạm” vào một mùa Hạ xanh biếc, họ vẫn tìm nhau trong hình hài khác, lặng lẽ chảy cùng dòng sông (văn chương), chảy với “gió heo may”, cùng yên nghỉ và cùng tái sinh.\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/bc/1c/b0/5ba29ba7e9c9db70e0005307a2a70dab.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/bc/1c/b0/5ba29ba7e9c9db70e0005307a2a70dab.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/bc/1c/b0/5ba29ba7e9c9db70e0005307a2a70dab.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/bc/1c/b0/5ba29ba7e9c9db70e0005307a2a70dab.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/bc/1c/b0/5ba29ba7e9c9db70e0005307a2a70dab.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/7d/60/30/dffeac051b7eac6d459a8682989be9eb.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/7d/60/30/dffeac051b7eac6d459a8682989be9eb.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/7d/60/30/dffeac051b7eac6d459a8682989be9eb.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7d/60/30/dffeac051b7eac6d459a8682989be9eb.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7d/60/30/dffeac051b7eac6d459a8682989be9eb.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/d6/fd/5f/4f498b41748cbdefd08da031af5ad32b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d6/fd/5f/4f498b41748cbdefd08da031af5ad32b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d6/fd/5f/4f498b41748cbdefd08da031af5ad32b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d6/fd/5f/4f498b41748cbdefd08da031af5ad32b.jpg","thumbnail_url"