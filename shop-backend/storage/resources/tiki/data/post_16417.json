ế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/5a/7d/8d/82cf7834d775da09aeb7da336d939c9d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/5a/7d/8d/82cf7834d775da09aeb7da336d939c9d.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/5a/7d/8d/82cf7834d775da09aeb7da336d939c9d.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5a/7d/8d/82cf7834d775da09aeb7da336d939c9d.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5a/7d/8d/82cf7834d775da09aeb7da336d939c9d.jpg"},{"base_url":"https://salt.tikicdn.com/media/catalog/producttmp/4f/a0/ef/4cf89cd76f3e317c28d6f6194e074884.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/producttmp/4f/a0/ef/4cf89cd76f3e317c28d6f6194e074884.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/producttmp/4f/a0/ef/4cf89cd76f3e317c28d6f6194e074884.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/producttmp/4f/a0/ef/4cf89cd76f3e317c28d6f6194e074884.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/producttmp/4f/a0/ef/4cf89cd76f3e317c28d6f6194e074884.jpg"},{"base_url":"https://salt.tikicdn.com/media/catalog/producttmp/5c/dc/dc/7f5501adf34da389c2d595653996a062.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/producttmp/5c/dc/dc/7f5501adf34da389c2d595653996a062.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/producttmp/5c/dc/dc/7f5501adf34da389c2d595653996a062.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/producttmp/