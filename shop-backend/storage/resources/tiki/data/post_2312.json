p_badge","code":"is_hero","type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"freeship_xtra","type":"pdp_icon_badge","index":2,"icon":"https://salt.tikicdn.com/ts/upload/be/67/48/04a82ab8df178e1a13bde38316081865.png","icon_width":91,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":true,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.8,"review_count":5,"review_text":"(5)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/05/7c/cb/152bf80c3711268311935eee52e05fef.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":918,"all_time_quantity_sold":25,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003eGiới thiệu\u003c/h3\u003e\n\u003cp\u003eBạn đang tìm kiếm món quà tuyệt vời dành cho trẻ em hoặc thanh thiếu niên yêu thích đồ chơi siêu xe?  Technic McLaren Senna GTR (42123) này là một lựa chọn tuyệt vời - và những người hâm mộ McLaren trưởng thành cũng sẽ thích nó! Được trang bị các tính năng chân thực lấy cảm hứng từ đường đua gốc - biểu tượng siêu xe, đồ chơi mô hình sưu tập này chắc chắn sẽ thiết lập các cuộc đua gây cấn.\u003c/p\u003e\n\u003cp\u003eChi tiết thực tế và các chức năng mạnh mẽ McLaren Senna GTR là một chiếc xe không giống bất kỳ chiếc xe nào. Và phiên bản đồ chơi  Technic tuyệt vời này cũng ấn tượng không kém. Khám phá động cơ V8 với các pít-tông chuyển động, cửa mở hai mặt mang tính biểu tượng, cùng với đồ họa và màu sắc chân thực, giống như trên xe hơi thật. Chỉ đạo bằng bánh xe, sau đó đưa mô hình lên trưng bày ở nơi chắc chắn sẽ thu hút nhiều ánh nhìn ngưỡng mộ. Mở ra thế giới kỹ thuật Bộ  Technic có các chuyển động và cơ chế thực tế giới thiệu những người xây dựng đến với vũ trụ kỹ thuật theo cách dễ tiếp cận và thực tế.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/27/de/23/147cab63489f0f86f4bbaf678f9920fc.jpg\" alt=\"\" width=\"600\" height=\"600\" /\u003e\u003c/p\u003e\n\u003ch3\u003eĐặc điểm nổi bật\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eMột công trình tuyệt đẹp dành cho những người hâm mộ siêu xe, bộ xây dựng mô hình  Technic McLaren Senna GTR 42123 được đóng gói với các chi tiết thực tế lấy cảm hứng từ nguyên bản mang tính biểu tượng.\u003c/li\u003e\n\u003cli\u003eKiểm tra các đặc điểm đích thực của mô hình đồ chơi siêu xe này, chẳng hạn như động cơ V8 chi tiết với các piston chuyển động và cửa hai chiều có thể mở 'lên và ra' theo phong cách không thể nhầm lẫn của McLaren thật.\u003c/li\u003e\n\u003cli\u003eBạn đang tìm kiếm những ý tưởng quà tặng tốt nhất cho một người hâm mộ môn đua xe thể thao hoặc một người yêu thích siêu xe? Bộ này là sự lựa chọn tuyệt vời cho trẻ em từ 10 tuổi trở lên, những người muốn chế tạo và trưng bày xe đua McLaren của riêng mình.\u003c/li\u003e\n\u003cli\u003eMô hình đồ chơi siêu xe tập trung vào đường đua tuyệt vời này trông tuyệt vời khi được trưng bày và chắc chắn sẽ thu hút trí tưởng tượng của bất kỳ trẻ em hoặc người lớn nào có niềm đam mê với siêu xe, mô tô thể thao và McLaren.\u003c/li\u003e\n\u003cli\u003eMô hình có kích thước cao hơn 3 inch (9 cm), dài 12 inch (32 cm) và rộng 4 inch (12 cm)\u003c/li\u003e\n\u003cli\u003eĐồ chơi McLaren sưu tầm được này có đồ họa và màu sắc bắt mắt, giống như trên siêu xe thật.\u003c/li\u003e\n\u003cli\u003eVũ trụ  Technic cung cấp đồ chơi xây dựng tiên tiến cho những người hâm mộ , những người đã sẵn sàng cho thử thách xây dựng tiếp theo của họ.\u003c/li\u003e\n\u003cli\u003eCác thành phần  Technic đáp ứng các tiêu chuẩn nghiêm ngặt của ngành để đảm bảo chúng luôn đồng nhất, tương thích.\u003c/li\u003e\n\u003cli\u003eCác thành phần  Technic được phân tích để đảm bảo chúng đáp ứng các tiêu chuẩn an toàn nghiêm ngặt trên toàn cầu.\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003eThông tin chi tiết:\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eChất liệu nhựa an toàn không gây hại cho sức khỏe của bé khi sử dụng.\u003c/li\u003e\n\u003cli\u003eĐộ tuổi phù hợp: 10+\u003c/li\u003e\n\u003cli\u003eBộ gồm: 830 chi tiết.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/10/fe/43/ecb279fbdf8473c470deb8bd8b7c7586.jpg\" alt=\"\" width=\"600\" height=\"600\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/05/7c/cb/152bf80c3711268311935eee52e05fef.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/05/7c/cb/152bf80c3711268311935eee52e05fef.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/05/7c/cb/15