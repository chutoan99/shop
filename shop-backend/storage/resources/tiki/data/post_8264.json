or":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/08/3a/17/905a1fdd23b73858aefcc05b6810ac24.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":74,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eSứ lọc nước SU COOLMART\u003c/strong\u003e được nhập khẩu trực tiếp từ Hàn Quốc và phân phối bởi CNC Việt Nam. Sản phẩm dùng phù hợp với bình lọc nước để bàn COOLMART-GL, bình lọc nước để bàn COOLMART-PL, giúp loại bỏ tạp chất, ngăn ngừa vi khuẩn trong nước.\u003c/p\u003e\n\u003cp\u003eSứ lọc nước Coolmart làm từ loại gốm rất đặc biệt, gốm được nén theo kĩ thuật cao cho kích thước lỗ hút 0.2 um chỉ có phần tử nước tinh khiết mới có thể thẩm thấu qua. Gốm có dạng hình phễu với diện tích bề mặt tiếp xúc với nước gấp 2 lần so với các loại gốm thông thường. Gốm được lắp ở tầng trên cùng, không có ren, dùng doăng rất khít để tránh rò nước.\u003c/p\u003e\n\u003cp\u003eThời gian sử dụng của lõi lọc gốm khoảng từ 3 – 6 tháng. Khi đến thời hạn thay, cần mua lõi chính hãng để thay ngay nhằm đảm bảo chất lượng nước đầu ra. Tài nguyên của sứ lọc hết, lõi gốm sẽ tự động vỡ không sử dụng được nữa.\u003c/p\u003e\n\u003cp\u003eTốt nhất là chúng ta nên thay trước khi lõi tự động nứt, vỡ.\u003c/p\u003e\n\u003cp\u003eSứ lọc nước không chứa thành phần độc hại, an toàn sức khỏe, sản phẩm nhỏ gọn dễ tháo lắp, chùi rửa khi sử dụng lâu ngày, có thể sử dụng nhiều lần, nên bạn có thể yên tâm khi sử dụng để lọc nước uống trong gia đình.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/08/3a/17/905a1fdd23b73858aefcc05b6810ac24.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/08/3a/17/905a1fdd23b73858aefcc05b6810ac24.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/08/3a/17/905a1fdd23b73858aefcc05b6810ac24.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/08/3a/17/905a1fdd23b73858aefcc05b6810ac24.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/08/3a/17/905a1fdd23b73858aefcc05b6810ac24.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/bc/c7/20/05070c55c05ecdcc25a48c29a9f5a9ff.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/bc/c7/20/05070c55c05ecdcc25a48c29a9f5a9ff.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/bc/c7/20/05070c55c05ecdcc25a48c29a9f5a9ff.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/bc/c7/20/05070c55c05ecdcc25a48c29a9f5a9ff.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/bc/c7/20/05070c55c05ecdcc25a48c29a9f5a9ff.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/9d/cc/7a/0c2f348f8eac4cabac4f1ffca89e1d09.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/9d/cc/7a/0c2f348f8eac4cabac4f1ffca89e1d09.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/9d/cc/7a/0c2f348f8eac4cabac4f1ffca89e1d09.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9d/cc/7a/0c2f348f8eac4cabac4f1ffca89e1