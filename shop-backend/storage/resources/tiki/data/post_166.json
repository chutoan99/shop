56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.6,"review_count":8,"review_text":"(8)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/aa/5c/5b/882a0f7e7e4d8da7a8caafaed534614e.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1086,"all_time_quantity_sold":25,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003eMáy Pha Cà Phê Espresso Zamboo ZB-68CF (3.5Bar) - Hàng Chính Hãng\u003c/strong\u003e là dòng máy pha cà phê nhỏ dùng cho gia đình, văn phòng …\u003c/li\u003e\n\u003cli\u003eMáy có 2 chức năng chính là pha cà phê espresso và chức năng đánh sữa dùng pha cà phê latte hoặc pha cà phê Capuchino kiểu Ý.\u003c/li\u003e\n\u003cli\u003eMáy được thiết kế tinh tế và sang trọng với sự kết hợp giữa màu đen của nhựa ABS và Inox, bình chứa nước cũng là bình đun (boiler) đúc nguyên khối bằng thép với dung tích 240 ml, công suất 800 W, dễ dàng pha cho bạn từ 1-4 ly cà phê espresso trong thời gian ngắn với áp suất đạt 3,5 bar tương đương 50PSI trong thang đo lường áp lực nước.\u003c/li\u003e\n\u003cli\u003eMáy pha cà phê Espresso Zamboo ZB-68CF hoạt động trên nguyên lý nước được làm nóng từ 90-95 trong boiler khi áp suất đạt 3,5 Bar (50psi) thì được xả thẳng vào trong filter bằng inox 304 có chứa cà phê, nhờ lực ép mạnh của hơi nước máy sẽ ép được các chất có trong cà phê tạo nên những ly cà phê espresso thơm ngon mà nhanh chóng.\u003c/li\u003e\n\u003cli\u003eVới máy pha cà phê Espresso Zamboo ZB-68CF bạn dễ dàng pha và thưởng thức cac loại café bạn thích, Máy pha ngon với những loại cà phê bột rang mộc, hoặc các loại cà phê bán sẵn như Trung Nguyên/ Highlands Coffee,\u003c/li\u003e\n\u003cli\u003eVới cà phê rang mộc nguyên hạt bạn có thể xay nhỏ kích cỡ từ 0,4-0,6mm để pha được những ly cà phê ngon, kích cỡ hạt cà phê cũng ảnh hưởng tới hương vị café.\u003c/li\u003e\n\u003cli\u003eVới người thích vị thơm tự nhiên và ít cafein thì nên chọn mua hạt Arabica, còn người thích uống đậm thì nên chọn hạt Robusta, ngoài ra bạn có thể trộn theo tỉ lệ tùy ý nếu bạn có sẵn 2 loại hạt café trên.\u003c/li\u003e\n\u003cli\u003eMáy có công tắc tắt mở riêng, núm điều khiển hiện thị dễ dàng với đèn LED xanh\u003c/li\u003e\n\u003cli\u003eCông suất: 220-240V /800W\u003c/li\u003e\n\u003cli\u003eDung tích bình đun (boiler) 240ml/ Áp suất 3.5bar (50psi)\u003c/li\u003e\n\u003cli\u003eFilter bằng inox (chứa khoảng 20gram cafe), tay phin bằng nhôm.\u003c/li\u003e\n\u003cli\u003eVòi đánh sữa inox, có thể tháo rời\u003c/li\u003e\n\u003cli\u003eLy thủy tinh hứng cafe 50-200ml\u003c/li\u003e\n\u003cli\u003eKhay hứng nhỏ giọt bằng inox dễ dàng tháo rời vệ sinh\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/aa/5c/5b/882a0f7e7e4d8da7a8caafaed534614e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/aa/5c/5b/882a0f7e7e4d8da7a8caafaed534614e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/aa/5c/5b/882a0f7e7e4d8da7a8caafaed534614e.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/aa/5c/5b/882a0f7e7e4