f":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":10000,"discount_rate":6,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/9e/61/4c/b0ee7c9d8375141ed62f925f5bb79ad1.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":748,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eVợt muỗi thông minh tự bắt muỗi và có chế độ đèn thu hút muỗi\u003c/p\u003e\n\u003cp\u003eThiết kế 3 tầng lưới\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eĐiện áp đầu ra lưới: \u003c/strong\u003e2500V\u003c/p\u003e\n\u003cp\u003eCổng sạc micro USB\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eĐiện áp sạc:\u003c/strong\u003e 5V/1A\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003ePin:\u003c/strong\u003e Lithium 1800mAh. Có đèn LED báo mức pin\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThời gian sạc đầy:\u003c/strong\u003e 5-6 giờ\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTrọng lượng:\u003c/strong\u003e 600g\u003c/p\u003e\n\u003cp\u003eCầu chì bảo vệ quá tải điện\u003c/p\u003e\n\u003cp\u003e1. Sản phẩm được cung cấp nguồn điện bởi một pin Lithium với dung lượng 1800mAh. Sau khi dừng hoạt động vợt bắt muỗi điện có chức năng tự động khử điện dư trên bề mặt lưới cao áp.\u003c/p\u003e\n\u003cp\u003e2. Sản phẩm được trang bị 6 đèn thu hút muỗi ánh sáng tím và bước sóng thu hút muỗi 360-400nm được lựa chọn đặc biệt.\u003c/p\u003e\n\u003cp\u003e3. Đèn báo màu xanh: sản phẩm được sạc đầy. Có chức năng tự động tắt nguồn và nhắc nhở. Đèn báo đỏ: sản phẩm đang sạc. Khi sản phẩm sạc đầy, đèn sẽ tự động chuyển sang màu xanh lục và người dùng không cần phải chú ý đến thời gian sạc theo cách thủ công.\u003c/p\u003e\n\u003cp\u003e4. Sản phẩm có bảo vệ quá tải và bảo vệ ngắn mạch tải, át hiện chính xác điện áp sạc để đảm bảo an toàn khi sạc.\u003c/p\u003e\n\u003cdiv\u003e\u003cspan\u003eƯu điểm của vợt muỗi MPE - VM1:\u003c/span\u003e\u003c/div\u003e\n\u003cdiv\u003e\u003cspan\u003eTự động khử điện dư khi dừng hoạt động bắt muỗi \u003c/span\u003e\u003c/div\u003e\n\u003cdiv\u003e\u003cspan\u003eTrang bị 6 đèn thu hút muỗi với ánh sáng tím \u003c/span\u003e\u003c/div\u003e\n\u003cdiv\u003e\u003cspan\u003eCó chế độ tự động tắt nguồn khi sạc đầy \u003c/span\u003e\u003c/div\u003e\n\u003cdiv\u003e\u003cspan\u003eTrang bị cầu chì vào thiết bị (bảo vệ quá tải và ngắt mạch tải) đảm bảo an toàn khi sạc.\u003c/span\u003e\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/9e/61/4c/b0ee7c9d8375141ed62f925f5bb79ad1.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/9e/61/4c/b0ee7c9d8375141ed62f925f5bb79ad1.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/9e/61/4c/b0ee7c9d8375141ed62f925f5bb79ad1.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9e/61/4c/b0ee7c9d8375141ed62f925f5bb79ad1.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9e/61/4c/b0ee7c9d8375141ed62f925f5bb79ad1.png"},{"base_url":"https://salt.tikicdn.com/ts/product/55/62/79/802ba4cc71216f1689fb38ff44be6039.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/55/62/79/802ba4cc71216f1689fb38ff44be6039.jpg","medium_url":"https://salt.tiki