i: 355x25.4x3mm\u003cbr /\u003e- Tốc độ không tải: 3900 vòng/ phút\u003cbr /\u003e- Khả năng cắt tối đa: \u003cbr /\u003e   + 100X6mm với ống tròn\u003cbr /\u003e   + 100x100mm với thép vuông\u003cbr /\u003e   + 120x100mm với hình chữ nhật\u003cbr /\u003e- Trọng lượng: 14kg\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/19/98/bd/e5986ed29ec96fc28b4c38f8aaa1882d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/19/98/bd/e5986ed29ec96fc28b4c38f8aaa1882d.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/19/98/bd/e5986ed29ec96fc28b4c38f8aaa1882d.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/19/98/bd/e5986ed29ec96fc28b4c38f8aaa1882d.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/19/98/bd/e5986ed29ec96fc28b4c38f8aaa1882d.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/db/57/38/2f40617e37abcd2b7458eca9c9e40203.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/db/57/38/2f40617e37abcd2b7458eca9c9e40203.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/db/57/38/2f40617e37abcd2b7458eca9c9e40203.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/db/57/38/2f40617e37abcd2b7458eca9c9e40203.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/db/57/38/2f40617e37abcd2b7458eca9c9e40203.jpg"}],"warranty_policy":null,"brand":{"id":26283,"name":"Pigeon","slug":"pigeon"},"current_seller":{"id":70082,"sku":"4864421050966","name":"THẾ GIỚI XÂY DỰNG","link":"https://tiki.vn/cua-hang/the-gioi-xay-dung","lo