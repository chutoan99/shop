eason"}},"discount":150000,"discount_rate":6,"rating_average":5,"review_count":70,"review_text":"(70)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/02/74/75/edd16aab69bfad6da620363de4ad109d.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1378,"all_time_quantity_sold":189,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/94/49/e5/01983e83052df01a6bfd9b173a18fc75.jpg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Nồi chiên không dầu Philips HD9252/90 - Hàng chính hãng\" src=\"https://salt.tikicdn.com/ts/tmp/94/49/e5/01983e83052df01a6bfd9b173a18fc75.jpg\" alt=\"Nồi chiên không dầu Philips HD9252/90 - Hàng chính hãng\" width=\"750\" height=\"421\" /\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003eNồi chiên không dầu Philips HD9252/90 thiết kế nhỏ gọn, vỏ nồi làm từ nhựa cao cấp cách nhiệt với gam đen sang trọng, bền bỉ\u003c/strong\u003e\u003cbr /\u003eChân đế chống trượt bám chắc trên mặt phẳng, đảm bảo hoạt động ổn định, tránh nghiêng đổ.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/e6/3b/de/3909b176a16722c9818e95a09fc10665.jpg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Nồi chiên không dầu Philips HD9252/90 - Hàng chính hãng\" src=\"https://salt.tikicdn.com/ts/tmp/e6/3b/de/3909b176a16722c9818e95a09fc10665.jpg\" alt=\"Nồi chiên không dầu Philips HD9252/90 - Hàng chính hãng\" width=\"750\" height=\"421\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cp\u003e\u003cstrong\u003eDung tích lòng nồi 4.1 lít, dung tích rổ chiên 2.4 lít chiên được khoảng 2 - 4 đùi gà\u003c/strong\u003e\u003cbr /\u003eThực đơn chế biến phong phú: nướng thịt, chiên khoai tây, làm bánh,...\u003c/p\u003e\n\u003cp\u003eLòng nồi làm từ thép không gỉ bền bỉ, truyền nhiệt tốt, an toàn cho sức khỏe.\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/e4/b2/8f/2faaf040a405159e7100c6e65998046d.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003eCông nghệ Rapid Air giảm lượng chất béo đến 90%, công suất 1400W chiên nướng nhanh, đều, không cháy khét\u003cbr /\u003e\u003c/strong\u003eCông nghệ Rapid Air với luồng khí nóng được luân chuyển liên tục đều khắp khay chiên, đối lưu nhiệt tốt, nhanh chóng làm chín đều thực phẩm mà không cần dùng tới dầu hoặc chỉ cần rất ít dầu. Nhờ đó món ăn giảm được tới 90% chất béo, chống ngán tốt, thơm ngon và có lợi hơn cho sức khỏe.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/92/46/53/78c8a21c503c400f139e08528dd0a3c6.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003ch3\u003e\u003ca\u003e\u003cstrong\u003eNồi chiên không dầu\u003c/strong\u003e\u003c/a\u003e\u003cstrong\u003e có \u003c/strong\u003e\u003ca\u003e\u003cstrong\u003ebảng điều khiển cảm ứng\u003c/strong\u003e\u003c/a\u003e\u003cstrong\u003e màn hình LED nhạy, dễ quan sát rõ ràng, điều chỉnh nhiệt độ\u003c/strong\u003e\u003c/h3\u003e\n\u003cp data-spm-anchor-id=\"a2o4n.pdp_revamp.product_detail.i5.3a9a1befg7kKSY\"\u003eĐiều chỉnh các mức nhiệt từ 80 - 200 độ C, 7 chế độ cài đặt riêng cho từng loại thực phẩm đáp ứng nhu cầu sử dụng khác nhau của người dùng. Đồng thời, chế độ tự ngắt khi quá nhiệt bảo vệ an toàn cho người dùng, tăng tuổi thọ cho nồi.\u003c/p\u003e\n\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/29/df/fe/a265e7345191ceae62964760086f6f26.jpg\" alt=\"\" width=\"750\" height=\"444\" /\u003e\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eChế độ hẹn giờ tối đa 60 phút\u003c/strong\u003e\u003cbr /\u003eGiúp người dùng chủ động cho việc nấu nướng với nồi, nhờ đó không lo món ăn chín không tới hay bị cháy khét. \u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003e Tích hợp khay chiên, rổ chiên dễ dàng tháo rời, không lo dầu mỡ văng ra ngoài trong quá trình chế biến, dễ vệ sinh, có thể làm sạch bằng máy rửa chén đơn giản\u003c/strong\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/02/74/75/edd16aab69bfad6da620363de4ad109d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/02/74/75/edd16aab69bfad6da620363de4ad109d.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/02/74/75/edd16aab69bfad6da620363de4ad109d.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/02/74/75/edd16aab69bfad6da620363de4ad109d.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/02/74/75/edd16aab69bfad6da620363de4ad109d.jpg"},{"base_url":"https://salt.tikicdn.com/media/catalog/producttmp/f1/8a/ad/a8d9e4b43eb8bbac3c094020747eb29d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/producttmp/f1/8a/ad/a8d9e4b43eb8bbac3c094020747eb29d.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/producttmp/f1/8a/ad/a8d9e4b43eb8bbac3c094020747eb29d.jpg",