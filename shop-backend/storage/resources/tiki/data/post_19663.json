_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":20000,"discount_rate":11,"rating_average":4.7,"review_count":96,"review_text":"(96)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/57/0c/86/a2ce1faff74357b26cc0c9534b3dbc73.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1113,"all_time_quantity_sold":558,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eKlenzit C có tác dụng diệt khuẩn và các gốc tự do gây hại cho da, ngăn chặn tối đa nguy cơ lên mụn trứng cá.\u003cbr /\u003eSản phẩm còn giúp giảm mụn nhanh chóng, hiệu quả, đặc biệt là các  mụn mủ trắng, mụn bọc.\u003cbr /\u003eNhờ khả năng gom cồi mụn nhanh chóng, giảm thiểu tối đa tình trạng sưng viêm, Klenzit C góp phần thúc đẩy quá trình làm lành da, ít để thâm sẹo do mụn.\u003cbr /\u003eCÁCH SỬ DỤNG :\u003cbr /\u003eKlenzit C là thuốc bôi, được bào chế dưới dạng gel, do đó con đường tốt nhất để dùng là bôi qua da.\u003cbr /\u003eTrước tiên, người bệnh cần làm sạch vùng da bị mụn, sau đó lấy một lượng thuốc vừa đủ, xoa đều lên vùng bị mụn. Lưu ý, bôi thuốc tránh xa vùng mắt, tránh để thuốc tiếp xúc với bộ phận nhạy cảm này.\u003cbr /\u003eNgười bệnh nên dùng kem Klenzit C vào buổi tối, hạn chế dùng vào buổi sáng để giảm thiểu tác động xấu của ánh nắng mặt trời.\u003cbr /\u003eTrong quá trình dùng kem , người bệnh nên hạn chế chà xát mạnh. Vì có thể gây vỡ nhân mụn, chảy máu, tăng nguy cơ nhiễm trùng, làm mụn có khả năng lây lan sang vùng da khác.\u003cbr /\u003eĐỐI TƯỢNG SỬ DỤNG:\u003cbr /\u003eNgười đang gặp các vấn đề về mụn trứng cá có nhiều nhân, sẩn, mụn mủ ở mặt, ngực và lưng.\u003c/p\u003e\n\u003ch3 dir=\"ltr\"\u003eLiều dùng dùng kem  Klenzit + C 15g\u003c/h3\u003e\n\u003cul\u003e\n\u003cli dir=\"ltr\" aria-level=\"1\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eSử dụng kem Klenzit C với lượng vừa đủ với vùng da đang mụn, liều thông thường là 1 hạt đỗ đen cho mỗi lần môi gel. \u003c/p\u003e\n\u003c/li\u003e\n\u003cli dir=\"ltr\" aria-level=\"1\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eSử dụng kem Klenzit C ngày 1 lần vào buổi tối, không dùng vào buổi sáng vì ánh sáng có thể tác động đến hiệu quả của thuốc. \u003c/p\u003e\n\u003c/li\u003e\n\u003cli dir=\"ltr\" aria-level=\"1\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eNgoài ra, trong quá trình sử dụng, để kem Klenzit C có tác dụng tốt hơn, bạn nên cải thiện chế độ luyện tập cũng như thực đơn ăn uống. Hạn chế các chất kích thích, chất cay nóng như tiêu, ớt,…Giảm bớt các thức ăn dầu mỡ trong khẩu phần và tăng cường các thực phẩm chứa nhiều vitamin, chất xơ như rau củ, trái cây. \u003c/p\u003e\n\u003c/li\u003e\n\u003cli dir=\"ltr\" aria-level=\"1\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eHạn chế để làn da đang bị mụn tiếp xúc với khói bụi từ môi trường, không khí ô nhiễm hay nguồn nước không đảm bảo vệ sinh trong quá trình sử dụng kem bôi mụn Klenzit C.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli dir=\"ltr\" aria-level=\"1\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/49/db/ef/adb6903233b7d0a597ff54d1c372cfc6.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/li\u003e\n\u003cli dir=\"ltr\" aria-level=\"1\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/f4/09/78/3b772d1320729c3718a8ea2263a60e5b.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/57/0c/86/a2ce1faff74357b26cc0c9534b3dbc73.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/57/0c/86/a2ce1faff74357b26cc0c9534b3dbc73.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/57/0c/86/a2ce1faff74357b26cc0c9534b3dbc73.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/57/0c/86/a2ce1faff74357b26cc0c9534b3dbc73.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/57/0c/86/a2ce1faff74357b26cc0c9534b3dbc73.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/6b/90/a8/eaa5739ed7eda6cf42d2a4df1cba2995.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/6b/90/a8/eaa5739ed7eda6cf42d2a4df1cba2995.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/6b/90/a8/eaa5739ed7eda6cf42d2a4df1cba2995.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6b/90/a8/eaa5739ed7eda6cf42d2a4df1cba2995.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6b/90/a8/eaa5739ed7eda6cf42d2a4df1cba2995.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/3a/00/ff/1d7f6353c2e1e333086d880a70edb84d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/3a/00/ff/1d7f6353c2e1e333086d880a70edb84d.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/3a/00/ff/1d7f6353c2e1e333086d880a70edb84d.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3a/00/ff/1d7f6353c2e1e333086d880a70edb84d.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3a/00/ff/1d7f6353c2e1e333086d880a70edb84d.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/f4/09/78/a234a5ffb92d8ae57a0273c4586d3ae1.jpg","is_gallery":tr