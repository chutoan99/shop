"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":339250,"discount_rate":27,"rating_average":4.5,"review_count":15,"review_text":"(15)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/f8/20/59/5a8c44625f7344b3a4992fa59ede032b.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1897,"all_time_quantity_sold":72,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2 style=\"margin: 0.75em 0px; padding: 0px; unicode-bidi: embed; font-weight: bolder; font-family: Roboto, -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;\"\u003e\u003cem style=\"margin: 0px; padding: 0px;\" data-spm-anchor-id=\"a2o4n.pdp.product_detail.i3.550139a4nl1ZFY\"\u003eCông dụng của tinh dầu thông đối với sức khỏe.\u003c/em\u003e\u003c/h2\u003e\n\u003cul style=\"margin: 0.2em 0px 0.2em 40px; padding: 0px; list-style-position: initial; list-style-image: initial; unicode-bidi: embed; font-family: Roboto, -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif; font-size: 12px;\"\u003e\n\u003cli style=\"margin: 0px; padding: 0px;\"\u003e\u003cem style=\"margin: 0px; padding: 0px;\"\u003eCông dụng của các loại tinh dầu \u003c/em\u003ecó tác dụng ngăn chặn tế bào ung thư nhờ hoạt chất Paclitaxel và Docetaxel trong tinh dầu thông đỏ.\u003c/li\u003e\n\u003cli style=\"margin: 0px; padding: 0px;\"\u003e\u003cem style=\"margin: 0px; padding: 0px;\"\u003eTinh dầu thông đỏ trị bệnh gì\u003c/em\u003e? Đó là hỗ trợ điều trị bệnh cao huyết áp, mỡ trong máu, tiểu đường, đau đầu, căng thẳng\u003c/li\u003e\n\u003cli style=\"margin: 0px; padding: 0px;\"\u003e\u003cem style=\"margin: 0px; padding: 0px;\"\u003eTinh dầu thông đỏ \u003c/em\u003ekích thích hệ miễn dịch và tuyến giáp\u003c/li\u003e\n\u003cli style=\"margin: 0px; padding: 0px;\"\u003e\u003cem style=\"margin: 0px; padding: 0px;\"\u003eTinh dầu\u003c/em\u003e giúp tăng số lượng tế bào máu và giảm căng thẳng mạch máu đồng thời ngăn chặn và loại bỏ màng bám động mạch, phòng ngừa nhồi máu cơ tim, cao huyết áp.\u003c/li\u003e\n\u003cli style=\"margin: 0px; padding: 0px;\"\u003e\u003cem style=\"margin: 0px; padding: 0px;\"\u003eTinh dầu thông đỏ Samsung\u003c/em\u003e giảm lượng cholesterol, cải thiện sức khỏe tim mạch\u003c/li\u003e\n\u003cli style=\"margin: 0px; padding: 0px;\"\u003e\u003cem style=\"margin: 0px; padding: 0px;\"\u003eDầu thông đỏ\u003c/em\u003e còn loại trừ độc hại ở gan nhất là đối với những người uống, loại bỏ độc hại ở phối với người hút thuốc lá, trợ giúp tuần hoàn và dẫn truyền thần kinh trong các trường hợp đau dây thần kinh, kháng viêm, tê tay chân, chứng rụng tóc\u003c/li\u003e\n\u003cli style=\"margin: 0px; padding: 0px;\"\u003e Nâng cao sinh lực cho đàn ông\u003c/li\u003e\n\u003cli style=\"margin: 0px; padding: 0px;\"\u003e\u003cem style=\"margin: 0px; padding: 0px;\"\u003eTinh dầu thông\u003c/em\u003e còn có tác dụng giúp cho vòng eo ở nữ săn chắc, thon gon hơn trong thời gian ngắn\u003c/li\u003e\n\u003cli style=\"margin: 0px; padding: 0px;\"\u003eTinh dầu thông ngặn chặn sự chảy xệ, lão hóa da từ đó cho bạn làn da săn chắc, tươi trẻ với thời gian.\u003c/li\u003e\n\u003cli style=\"margin: 0px; padding: 0px;\"\u003eNhư vậy, \u003cem style=\"margin: 0px; padding: 0px;\"\u003etinh dau thong\u003c/em\u003e không chỉ có tác dụng hỗ trợ điều trị bệnh bảo vệ sức khỏe mà còn giúp bạn chăm sóc làn da, níu kéo tuổi thanh xuân.\u003c/li\u003e\n\u003cli style=\"margin: 0px; padding: 0px;\"\u003e\n\u003ch2 style=\"margin: 0.75em 0px; padding: 0px; unicode-bidi: embed; font-weight: bolder;\"\u003e\u003cem style=\"margin: 0px; padding: 0px;\"\u003eCách dùng tinh dầu thông đỏ Hàn Quốc hiệu quả\u003c/em\u003e\u003c/h2\u003e\n\u003cp style=\"margin: 0.2em 0px; padding: 0px; unicode-bidi: embed; font-size: 20px; line-height: 1.6;\"\u003eMỗi ngày uống 1-2 \u003cem style=\"margin: 0px; padding: 0px;\"\u003eviên tinh dầu thông đỏ\u003c/em\u003e vào buổi sáng hoặc trưa, có thể uống trước hoặc sau khi ăn 30 phút\u003cbr style=\"margin: 0px; padding: 0px;\" /\u003eNên uống nhiều nước sau khi uống dầu thông đỏ để giúp cho quá trình đào thải chất tốt hơn\u003cbr style=\"margin: 0px; padding: 0px;\" /\u003eKhông dùng tinh dầu thông đỏ cho phụ nữ có thai, đang cho con bú, cho trẻ dưới 10 tuổi\u003cbr style=\"margin: 0px; padding: 0px;\" /\u003eKhông sử dụng khi viên tinh dầu thông bị biến dạng nứt vỡ, chuyển màu.\u003cbr style=\"margin: 0px; padding: 0px;\" /\u003eNên bảo quản sản phẩm tinh dầu thông đỏ Samsung 180 viên nơi khô thoáng tránh ánh mặt trời.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli style=\"margin: 0px; padding: 0px;\"\u003e\n\u003cp style=\"margin: 0.2em 0px; padding: 0px; unicode-bidi: embed; font-size: 20px; line-height: 1.6;\"\u003eXuất xứ : Hàn Quốc.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli style=\"margin: 0px; padding: 0px;\"\u003e\n\u003cp style=\"margin: 0.2em 0px; padding: 0px; unicode-bidi: embed; font-size: 20px; line-height: 1.6;\"\u003eQuy cách đóng gói :1 hộp / 180 viên x 450mg\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/f8/20/59/5a8c44625f7344b3a4992fa59ede032b.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f8/20/59/5a8c44625f7344b3a4992fa59ede032b.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f8/20/59/5a