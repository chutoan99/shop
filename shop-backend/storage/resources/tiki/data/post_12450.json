t_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.5,"review_count":4,"review_text":"(4)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/3f/49/92/187d9af6383fbd56dd35be5f48a13069.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":371,"all_time_quantity_sold":48,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p><img src=\"https://salt.tikicdn.com/ts/tmp/d8/57/2a/cd8d2eb43aede74d738d5e5f7ce6cfda.png\" alt=\"\" width=\"533\" height=\"792\" /></p>\n<p class=\"has-medium-font-size\">Các nghiên cứu khoa học gần đây đã chỉ ra ăn chay vừa bảo vệ bạn khỏi làn sóng bệnh tật đang càn quét các nước phát triển, vừa có ý nghĩa lớn với môi trường. Nhưng ở Việt Nam, ăn chay vẫn gặp nhiều rào cản…</p>\n<div class=\"wp-block-columns are-vertically-aligned-center is-layout-flex wp-container-21 wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column is-vertically-aligned-center is-layout-flow wp-block-column-is-layout-flow\">\n<figure class=\"wp-block-image size-full\"><img class=\"wp-image-4819 lazy loaded\" src=\"https://salt.tikicdn.com/ts/product/76/af/74/35bcb71bfe573b8c6aeaab0c031feebc.png\" alt=\"\" width=\"512\" height=\"512\" /></figure>\n</div>\n<div class=\"wp-block-column is-vertically-aligned-center is-layout-flow wp-block-column-is-layout-flow\">\n<ul class=\"is-style-checked has-medium-font-size\">\n<li>Làm sao ăn chay khoa học, không lo thiếu chất?</li>\n<li>Làm sao sống hài hoà khi có nhiều ý kiến trái chiều?</li>\n<li>Làm sao có những bữa chay ngon lành, bổ dưỡng?</li>\n<li>Làm sao để nhiều người biết tới con đường ý nghĩa này?</li>\n</ul>\n</div>\n</div>\n<p class=\"has-medium-font-size\">Đó cũng là những câu hỏi mà hai tác giả đã trăn trở nhiều năm. Giờ đây, họ không chỉ tìm ra lời giải đáp, mà còn ứng dụng vào cuộc sống, và liên tục gặt hái những kết quả tuyệt vời.</p>\n<div class=\"wp-block-group is-layout-constrained wp-block-group-is-layout-constrained\">\n<div class=\"wp-block-group__inner-container\">\n<div class=\"wp-block-columns is-layout-flex wp-container-24 wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\">\n<div class=\"wp-block-image is-style-editorskit-circular\">\n<figure class=\"aligncenter size-full\"><img class=\"wp-image-4746 lazy loaded\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/6f/64/e2/b649088441b05ef83c8fc619a0f8644a.jpg\" alt=\"\" width=\"1242\" height=\"1243\" /></figure>\n</div>\n<h2 class=\"wp-block-heading has-text-align-center\"><strong>Fususu – Nguyễn Chu Nam Phương</strong></h2>\n<p class=\"has-medium-font-size\">Trường chay từ tháng 7/2012, tác giả của hàng chục đầu sách chất lượng, với cả trăm ngàn độc giả theo dõi. Trước tuổi 30, Phương đã sống cuộc đời tự do như mơ ước: vừa du lịch, vừa viết lách, đóng góp cho đời. Ngoài là nhà huấn luyện diễn giả quốc tế được công nhận, anh cũng đào tạo nhiều tác giả xuất bản cuốn sách ước mơ của họ. </p>\n</div>\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\">\n<div class=\"wp-block-image is-style-editorskit-circular\">\n<figure class=\"aligncenter size-full\"><img class=\"wp-image-4974 lazy loaded\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/9f/92/b8/4d6cd7212388b4a7ad5e076b936ae7cc.jpg\" alt=\"\" width=\"1399\" height=\"1399\" /></figure>\n</div>\n<h2 class=\"wp-block-heading has-text-align-center\"><strong>Giang Rita – Đặng Thùy Giang</strong></h2>\n<p class=\"has-medium-font-size\">Trường chay từ tháng 12/2021. Chỉ sau 1 năm, cuộc sống của cô thay đổi hoàn toàn. Không chỉ đảm đương tốt công việc quan trọng ở một ngân hàng lớn, Giang còn có nhiều đóng tích cực cho cộng đồng Toastmasters Việt Nam với vai trò sáng lập câu lạc bộ, và giám đốc khu vực, giúp mọi người phát triển kỹ năng lãnh đạo và giao tiếp.</p>\n</div>\n</div>\n</div>\n</div>\n<div class=\"wp-block-group is-layout-constrained wp-block-group-is-layout-constrained\">\n<div class=\"wp-block-group__inner-container\">\n<p class=\"has-medium-font-size\">Chính vì thế, mà Giang đã không ngại đầu tư cả ngàn đô, và 2 tháng để học Plant-based Nutrition, khóa học dinh dưỡng thuần thực vật hàng đầu từ tiến sĩ T. Colin Campbell, để có thể kết hợp với kinh nghiệm thực tế 10 năm chay trường của Fususu, tạo ra cuốn sách lớn: Cuộc Cách Mạng Một Quả Chuối.</p>\n<div class=\"wp-block-image is-style-editorskit-circular\">\n<figure class=\"aligncenter size-full\"><img class=\"wp-image-4743 lazy loaded\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/40/4d/0d/445614298065340c5ce7d85de5902422.jpg\" alt=\"\" width=\"1408\" height=\"1408\" /></figure>\n<div class=\"wp-block-group is-layout-constrained wp-block-group-is-layout-constrained\">\n<div class=\"wp-block-group__inner-container\">\n<div class=\"wp-block-cover alignfull is-light\">\n<div class=\"wp-block-cover__inner-container is-layout-flow wp-block-cover-is-layout-flow\">\n<h2 class=\"wp-block-heading has-text-align-center has-large-font-size\"><span class=\"stk-highlight\">Sách sẽ giúp bạn thế nào?</span></h2>\n</div>\n</div>\n<p class=\"has-medium-font-size\">Với lối viết sinh động hóm hỉnh, bạn sẽ không chỉ có những giây phút thư giãn, mà còn được khám phá khoa học thuần thực vật, giúp hóa giải nhiều hiểu lầm phổ biến về ăn uống.</p>\n<ul class=\"is-style-starred has-medium-font-size\">\n<li>Phần I – Các lý do mạnh mẽ khiến ăn chay đang là xu thế, các thông tin và số liệu biết nói, có thể khiến bất cứ tín đồ ăn thịt nào cũng phải suy nghĩ lại.</li>\n<li>Phần II – Giúp bạn hiểu rõ các rào cản phổ biến mà những người trường chay hay gặp. Điều quan trọng là chiến lược hóa giải chúng, từ trong ra ngoài.</li>\n<li>Phần III – Lựa chọn trường chay là một chuyện, nhưng ăn sao cho khỏe là chuyện khác. Phần này bật mí cho bạn các chìa khóa vàng của dinh dưỡng thuần thực vật.</li>\n<li>Phần IV – Cung cấp lộ trình đơn giản, giúp bạn tránh các sai lầm thường gặp, để từng bước chay trường sung sướng, và bảo vệ bản thân khỏi làn sóng bệnh tật đang càn quét các nước phát triển.</li>\n</ul>\n</div>\n</div>\n<p class=\"has-medium-font-size\">Nếu bạn muốn một lối sống hài hòa với tự nhiên, hay tháo gỡ mọi khó khăn trong việc ăn chay trường, thì cuốn sách này là dành cho bạn. Hãy sẵn sàng để thay cách ăn, đổi cuộc đời, và… cứu thế giới!</p>\n</div>\n</div>\n</div><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/3f/49/92/187d9af6383fbd56dd35be5f48a13069.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/3f/49/92/187d9af6383fbd56dd35be5f48a13069.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/3f/49/92/187d9af6383fbd56dd35be5f48a13069.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3f/49/92/187d9af6383fbd56dd35be5f48a13069.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3f/49/92/187d9af6383fbd56dd35be5f48a13069.png"},{"base_url":"https://salt.tikicdn.com/ts/product/49/fc/e5/61e446c26d9851eb16d595a49a47aaa9.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/49/fc/e5/61e446c26d9851eb16d595a49a47aaa9.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/49/fc/e5/61e446c26d9851eb16d595a49a47aaa9.