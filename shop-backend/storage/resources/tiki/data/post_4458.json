_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":54000,"discount_rate":27,"rating_average":4.6,"review_count":552,"review_text":"(552)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/f9/6a/e7/dbcf994b6fac09c1b44a78ca7b3cc77a.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1471,"all_time_quantity_sold":1888,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/48/92/ed/36a2d10517f649a77ee7e608efdc608b.png\" alt=\"\" width=\"750\" height=\"250\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eBàn Chải Điện BOORUI Primus Z2 (TB-018) 3 Chế Độ , Bàn Chải Đánh Răng Cho Trẻ Em Và Người Lớn Tặng Kèm 3 Đầu Bản Chải : là bộ sản phẩm chính hãng của Broorui giải pháp hàng đầu về chăm sóc răng miệng\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cstrong\u003e\u003ciframe src=\"//www.youtube.com/embed/_g3gzgjCRTc\" width=\"560\" height=\"314\" allowfullscreen=\"\"\u003e\u003c/iframe\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/f9/6a/e7/5139cba9c129e951f843750dce6d9be3.jpg\" alt=\"\" width=\"750\" height=\"1057\" /\u003e\u003cbr /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cstrong\u003eBàn Chải Điện BOORUI Primus Z2 (TB-018) :\u003c/strong\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eChất liệu: sợi DuPont, nhựa ABS Pin dung lượng: 500mAh\u003c/li\u003e\n\u003cli\u003eCảm nhận là sạch hơn rất rất rất nhiều lần so với dùng bàn chải tay. Cọ bàn chải lông khá mềm, nhỏ nên dùng rất dễ dàng.\u003c/li\u003e\n\u003cli\u003eBàn chải hoạt động bằng pin với tính năng xoay liên tục giúp bạn thoải mái khi đánh răng\u003c/li\u003e\n\u003cli\u003eMàu sắc đa dạng : Đen , Trắng, Hồng\u003c/li\u003e\n\u003cli\u003eĐi kèm theo máy bao gồm 1 sạc,1 thân máy, 4 đầu bàn chải , 1 sách hướng dẫn\u003c/li\u003e\n\u003cli\u003eChống Nước tiêu chuẩn IPX7 , Sạc nhanh USB\u003c/li\u003e\n\u003cli\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/e3/15/b3/d59926b05f1485cb3e4de14b5582f2a0.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/li\u003e\n\u003cli\u003eƯu việt với tính năng làm sạch răng, chống mảng bám và hạn chế cao răng.\u003c/li\u003e\n\u003cli\u003eThiết kế thông minh.Bàn chải có 3 chế độ: Clean - Soft - White phù hợp cho tất cả mọi người.\u003c/li\u003e\n\u003cli\u003eBàn chải có 3 chế độ: Clean - Soft - White\n\u003cul\u003e\u003cli\u003eChế độ Clean: loại bỏ vi khuẩn, tạp chất; làm sạch khoang miệng hiệu quả\u003c/li\u003e\n\u003cli\u003eChế độ Soft: Dành cho các bạn có răng nhạy cảm, nhẹ nhàng hơn chế độ Clean\u003c/li\u003e\n\u003cli\u003eChế độ White: mỗi phút hiệu quả cao trong quá trình làm sạch sâu đồng thời loại bỏ các mảng bám trong khoang miệng\u003c/li\u003e\n\u003c/ul\u003e\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/68/97/5c/bff939f413062e0f45f752ac1178a2a7.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cem\u003eHướng Dẫn Sử Dụng\u003c/em\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eChải răng bằng bàn chải tự động cũng tương tự như bàn chải thường, chỉ khác ở điểm là đầu lông bàn chải tự động sẽ tự xoay và rung để làm sạch mặt răng, có thể đưa vào đánh tận các răng trong cùng mà ko cảm thấy vướng víu.\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/f9/6a/e7/c5d2f74ddfa4b3111fb83de21d9c788f.jpg\" alt=\"\" width=\"750\" height=\"1057\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/f9/6a/e7/dbcf994b6fac09c1b44a78ca7b3cc77a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f9/6a/e7/dbcf994b6fac09c1b44a78ca7b3cc77a.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f9/6a/e7/dbcf994b6fac09c1b44a78ca7b3cc77a.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f9/6a/e7/dbcf994b6fac09c1b44a78ca7b3cc77a.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f9/6a/e7/dbcf994b6fac09c1b44a78ca7b3cc77a.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/e3/15/b3/4027f5b0f664b39eb018aba0ec8080fc.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e3/15/b3/4027f5b0f664b39eb018aba0ec8080fc.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e3/15/b3/4027f5b0f664b39eb018aba0ec8080fc.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e3/15/b3/4027f5b0f664b39eb018aba0ec8080fc.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e3/15/b3/4027f5b0f664b39eb018aba0ec8080fc.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/17/b1/5c/07f96f4141bd9c148dbc2841d26c655c.jpg","is_gallery":true,"label":null,"large_url":"