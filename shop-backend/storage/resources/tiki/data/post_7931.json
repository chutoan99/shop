"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/f0/e5/1e/20420d5699bcdf94d442d0eaee4525e9.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":943,"all_time_quantity_sold":17,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003eĐẶC ĐIỂM NỔI BẬT CỦA SẢN PHẨM\u003c/strong\u003e\u003c/p\u003e\n\u003cul style=\"text-align:justify;\"\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eBột Cần Tây WeFresh \u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003ecó nguồn gốc từ trang trại sinh học VietGAP và được trải qua quy trình sấy lạnh tiệt trùng hiện đại, đảm bảo không ký sinh trùng và giun sán gây hại. Bột Cần Tây giữ được nguyên vẹn mùi vị, màu sắc và hàm lượng dưỡng chất tốt có trong Cần Tây tươi.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eBột Cần Tây WeFresh\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e không chứa chất bảo quản, không pha trộn thêm bất kỳ thành phần phụ gia hóa học nào, đáp ứng linh hoạt các mục đích khác nhau của người dùng.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/f0/e5/1e/179d2e5555b55b16607857ff53768ca6.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cem\u003e\u003cspan style=\"font-weight:400;\"\u003eBột Cần Tây gói WeFresh Quảng Thanh - gói tiện lợi 3g/gói - thanh lọc cơ thể, ổn định huyết áp\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003eCÔNG DỤNG CỦA SẢN PHẨM\u003c/strong\u003e\u003c/p\u003e\n\u003cul style=\"text-align:justify;\"\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eBột Cần Tây WeFresh\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e có tính hàn, tính mát, thanh lọc cơ thể.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eTốt cho đường hô hấp, hỗ trợ giảm bệnh ho, hen suyễn, viêm phế quản, bệnh lao phổi,\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eHỗ trợ người cao huyết áp, giãn nở mạch, tai biến mạch máu não, mỡ trong máu cao, thiếu máu.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eCó tác dụng lợi tiểu, giúp cho lượng nước tiểu thông và sạch.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eBột Cần Tây WeFresh \u003c/strong\u003ehỗ trợ \u003cspan style=\"font-weight:400;\"\u003en\u003c/span\u003e\u003cspan style=\"font-weight:400;\"\u003egăn ngừa bệnh ung thư: ngăn chặn sự phát triển các khối u, tế bào ung thư phát triển như ung thư vú, ung thư phổi, ung thư bạch cầu, ung thư tuyến tụy.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eHỗ trợ rối loạn tiêu hóa, khó tiêu, cân bằng axit trong dạ dày, cung cấp chất xơ ngăn ngừa táo bón.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eLàm giảm căng thẳng, mệt mỏi, tốt cho hệ thần kinh, hỗ trợ mất ngủ giúp ngủ ngon và sâu hơn\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eTốt cho xương khớp: phát triển xương khớp, là chất kháng viêm, làm giảm tình trạng bị sưng, đau giữa các khớp.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eHỗ trợ giảm cân: Giảm cảm giác thèm ăn, giúp no lâu.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eBột Cần Tây WeFresh \u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003ehỗ trợ giảm các bệnh về mắt, tránh nguy cơ mắc thoái hóa điểm vàng, đục thủy tinh thể, giúp mắt sáng và khỏe mạnh hơn.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eThúc đẩy quá trình lưu thông máu đến các cơ quan, tăng cường sức đề kháng cơ thể.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eDùng làm mặt nạ giúp ngăn ngừa nếp nhăn và làm sáng da.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/0b/cf/a9/0473ba1cd45530c15dd56a89e4b8076e.jpg\" alt=\"\" width=\"750\" height=\"677\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cem\u003e\u003cspan style=\"font-weight:400;\"\u003eSản phẩm được sấy lạnh giúp giữ được các thành phần dinh dưỡng của rau\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003eTHÔNG TIN CHUNG BỘT CẦN TÂY WEFRESH \u003c/strong\u003e\u003c/p\u003e\n\u003cul style=\"text-align:justify;\"\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eThành phần: 100% Cần Tây tươi, sấy lạnh tiệt trùng và nghiền siêu mịn\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eHàm lượng chất xơ: trên 10%\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eĐộ ẩm: dưới 5%\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eNgày sản xuất: xem trên bao bì\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eHạn sử dụng: 1 năm kể từ ngày sản xuất\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003eCÁCH DÙNG\u003c/strong\u003e\u003c/p\u003e\n\u003cul style=\"text-align:justify;\"\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eGiải khát và tăng sức đề kháng: Sử dụng 1 gói 3g\u003c/span\u003e \u003cstrong\u003eBột Cần Tây WeFresh\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e pha với 300 - 500ml nước lọc cho mỗi lần uống (1 – 2 lần/ ngày) . Có thể kết hợp thêm với chanh/tắc/hạnh/quất để kích thích vị giác vừa giúp hấp thụ dưỡng chất có trong rau nhanh hơn vừa tăng sức đề kháng.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eCông thức làm đẹp: pha với nước tinh khiết tỉ lệ 1:3 (có thể thay nước bằng sữa tươi hoặc sữa chua không đường để giảm mụn vừa dưỡng trắng), đắp hỗn hợp này lên da trong 15-20 phút, duy trì 2 lần/tuần.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eThêm vào cháo súp em bé\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003eBẢO QUẢN\u003c/strong\u003e\u003c/p\u003e\n\u003cul style=\"text-align:justify;\"\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eBảo quản\u003c/span\u003e \u003cstrong\u003eBột Cần Tây WeFresh gói 3g Tiện Lợi \u003c/strong\u003e\u003cem\u003e\u003cspan style=\"font-weight:400;\"\u003en\u003c/span\u003e\u003c/em\u003e\u003cspan style=\"font-weight:400;\"\u003eơi khô thoáng, tránh tác động của ánh sáng và nhiệt. Tốt nhất nên bảo quản trong ngăn mát tủ lạnh. \u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eKhóa kín miệng túi sau khi sử dụng. Không nên sang chiết sản phẩm sang hũ nhựa hay lọ thủy tinh để giúp bột không bị biến chất, đảm bảo chất lượng tốt nhất với thời hạn sử dụng được lâu.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/f0/e5/1e/20420d5699bcdf94d442d0eaee4525e9.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f0/e5/1e/20420d5699bcdf94d442d0eaee4525e9.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f0/e5/1e/20420d5699bcdf94d442d0eaee4525e9.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f0/e5/1e/20420d5699bcdf94d442d0eaee4525e9.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f0/e5/1e/20420d5699bcdf94d442d0eaee4525e9.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/69/ee/8e/410cc59da4cfb2ed8f1df4e05135b5ee.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/69/ee/8e/410cc59da4cfb2ed8f1df4e05135b5ee.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/69/ee/8e/410cc59da4cfb2ed8f1df4e05135b5ee.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/69/ee/8e/410cc59da4cfb2ed8f1df4e05135b5ee.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/69/ee/8e/410cc59da4cfb2ed8f1df4e05135b5ee.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/b4/b7/81/2311d919cdb502ff9619adcd2e0b2c06