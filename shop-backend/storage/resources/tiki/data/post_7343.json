d_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.5,"review_count":6,"review_text":"(6)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/16/0d/fb/b0c5f6f264afd9979102ddbd8d496475.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":809,"all_time_quantity_sold":9,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\n  \u003cp\u003eNâng Tiếng Karaoke, Nâng Tiếng TD Acoustic CB-1000 Cao Cấp, Bluetooth-Optical-Usb-Chỉnh Âm Hay, Tăng Tiếng Treble, Bass, Lời Sáng Rõ (Quà Tặng Cặp Dây Canon 139K)- H2Pro Tech\u003c/p\u003e\n   \u003cp\u003eHiện nay trên thị trường có rất nhiều các máy nâng tiếng với nhiều thương hiệu, mẫu mã, giá thành đa dạng khiến nhiều gia đình và người yêu thích âm thanh không biết lựa chọn mẫu nào cho tốt hiện nay. Thế giới công nghệ H2pro xin giới thiệu mẫu sản phẩm Nâng tiếng karaoke T.D Acoustic CB-1000 chuyên nghiệp cao cấp là một trong những máy nâng tiếng đứng trong top các mẫu nâng tiếng hiện nay và được nhiều người đánh giá cao khi sử dụng.\u003c/p\u003e\n   \u003cp\u003eGIỚI THIỆU VỀ MÁY NÂNG TIẾNG TD ACOUSTIC CB1000:\u003c/p\u003e\n   \u003cp\u003e- Nâng tiếng karaoke CB1000 với công nghệ bluetooth 5.0, đường quang optical, USB có thể kết hợp với mọi bộ dàn âm thanh để cải thiện chất âm mang đến âm thanh một dòng kiểu dáng mới, chất âm mới.\u003c/p\u003e\n   \u003cp\u003e- Đặc biệt, nâng tiếng CB1000 này còn có thể phân tần số tiếng siêu trầm riêng cho loa bass sub với ngõ out riêng, rất có lợi cho dàn amply karaoke không có đường out Subwoofer riêng.\u003c/p\u003e\n   \u003cp\u003eTHÔNG SỐ KĨ THUẬT VỀ MÁY NÂNG TIẾNG TD ACOUSTIC CB1000:\u003c/p\u003e\n   \u003cp\u003e- Thương hiệu : TD Acoustic\u003c/p\u003e\n   \u003cp\u003e- Model : CB-1000\u003c/p\u003e\n   \u003cp\u003e- Made in China\u003c/p\u003e\n   \u003cp\u003e- Tính năng nhận: Bluetooth 5.0\u003c/p\u003e\n   \u003cp\u003e- Điện vào: AC 220V / 50-60Hz\u003c/p\u003e\n   \u003cp\u003e- Điện năng tiêu thụ: 10W\u003c/p\u003e\n   \u003cp\u003e- Băng thông: 10Hz – 50kHz (+0, -1 dB)\u003c/p\u003e\n   \u003cp\u003e- Độ méo: 0.005%\u003c/p\u003e\n   \u003cp\u003e- Chuyển đổi: thay đổi từ 50Hz hoặc 100Hz\u003c/p\u003e\n   \u003cp\u003e- Trộn từ cổ điển (nặng) sang pop (mỏng)\u003c/p\u003e\n   \u003cp\u003e- Trọng lượng: 2.7kg\u003c/p\u003e\n   \u003cp\u003e- Bộ sản phẩm gồm: 1 x Nâng tiếng T.D Acoustic CB-1000, 1 x Dây nguồn, 1 x Sách hướng dẫn, 2 x Dây canon ( Quà tặng 139K)\u003c/p\u003e\n   \u003cp\u003e- Hình ảnh chi tiết Nâng tiếng T.D Acoustic CB-1000 được chụp và thiết kế bởi Thế giới công nghệ H2Pro.\u003c/p\u003e\n   \u003cp\u003eCAM KẾT\u003c/p\u003e\n   \u003cp\u003e- Cam kết đúng như hình ảnh và mô tả\u003c/p\u003e\n   \u003cp\u003e- Bảo hành 12 tháng\u003c/p\u003e\n   \u003cp\u003e- Được phép đổi trả nếu không hài lòng trong vòng 3 ngày nhận hàng.\u003c/p\u003e\n   \u003cp\u003eTHẾ GIỚI CÔNG NGHỆ H2PRO - UY TÍN \u0026amp; CHẤT LƯỢNG\u003c/p\u003e\n   \u003cp\u003e---------------------------------\u003c/p\u003e\n  \u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/16/0d/fb/b0c5f6f264afd9979102ddbd8d496475.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/16/0d/fb/b0c5f6f264afd9979102ddbd8d496475.jpg","medium_