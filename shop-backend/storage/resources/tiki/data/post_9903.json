,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":10000,"discount_rate":9,"rating_average":5,"review_count":21,"review_text":"(21)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/be/e8/40/8fb2e5547a0de3890bf43939fac85055.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":756,"all_time_quantity_sold":175,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cdiv\u003eThẻ Nhớ Mirco SD Mixie 64Gb Class 10 Chuyên Ghi Hình Cho Camera, Máy Ảnh và Điện Thoại - Hàng Chính Hãng\u003c/div\u003e\n\u003cdiv\u003eThẻ Nhớ Mixie 32Gb Class 10 Chuyên Ghi Hình Cho Camera, Máy Ảnh và Điện Thoại - Hàng Chính Hãng\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv\u003eThương hiệu Thái Lan, chip nhớ SamSung\u003c/div\u003e\n\u003cdiv\u003e\n\u003cdiv\u003e \u003c/div\u003e\nCam kết chính hãng 100% (kiểm tra bằng mọi cách có thể)\u003c/div\u003e\n\u003cdiv\u003e\n\u003cdiv\u003e \u003c/div\u003e\nTốc độ đọc U3 cực nhanh 95MB/s và tốc độ ghi 80MB/s (Thực tế đọc 80Mb/s, ghi 60Mb/s =\u0026gt; test trên laptop chạy SSD Samsung)\u003c/div\u003e\n\u003cdiv\u003e\n\u003cdiv\u003e \u003c/div\u003e\nCó khả năng chịu nhiệt tốt (từ -25° đến 85°C)\u003c/div\u003e\n\u003cdiv\u003e\n\u003cdiv\u003e \u003c/div\u003e\nChống nước, chống từ tính (Có thể ngâm nước biển 72 giờ)\u003c/div\u003e\n\u003cdiv\u003e\n\u003cdiv\u003e \u003c/div\u003e\nTương thích với mọi thiết bị như điện thoại thông minh, máy tính bảng và máy ảnh, camera, camera hành trình và thiết bị ghi hình yêu cầu chuẩn tốc độ cao cho độ phân giải 4K, 2K.\u003c/div\u003e\n\u003cdiv\u003e\n\u003cdiv\u003e \u003c/div\u003e\nChống tia X-Ray (gây ra bởi các máy quét X-ray trong sân bay)\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv\u003e➟ MIXIE là thương hiệu phụ kiện Máy Tính Chuyên Dụng Bán Chạy Số 01 Tại Thái Lan. Với 12 Giải Thưởng Chất Lượng Quốc Tế\u003c/div\u003e\n\u003cdiv\u003e➟ MIXIE bền bỉ với thương hiệu gần 20 năm trên thị trường máy tính và phụ kiện.\u003c/div\u003e\n\u003cdiv\u003eMIXIE thuộc công ty MISHEN Electronic thành lập từ 2002, đây là công ty chuyên sản xuất phụ kiện máy tính chuyên nghiệp, có trụ sở tại Thái Lan và Trung Quốc.\u003c/div\u003e\n\u003cdiv\u003e➟ 12 Giải Thưởng Chất Lượng Quốc Tế\u003c/div\u003e\n\u003cdiv\u003eVới gần 20 năm hoạt động trên thị trường, MIXIE đã giành được 12 giải thưởng chất lượng, chứng nhận quốc tế, giải thiết kế và người tiêu dùng bình chọn tại Thái Lan, Trung Quốc và Thế Giới.\u003c/div\u003e\n\u003cdiv\u003e➟ Bán Chạy Số 01 Tại Thái Lan\u003c/div\u003e\n\u003cdiv\u003eMIXIE được phân phối rộng rãi tại nhiều thị trường Mỹ, Thái Lan, Trung Quốc, Philippin, Malaysia, Singapore, Ấn Độ… và gặt hái thành công nhất tại thị trường Thái Lan\u003c/div\u003e\n\u003cdiv\u003e➟ Chính sách bảo hành 5 Sao\u003c/div\u003e\n\u003cdiv\u003eMIXIE cam kết sản phẩm chất lượng, bền bỉ\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/be/e8/40/8fb2e5547a0de3890bf43939fac85055.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/be/e8/40/8fb2e5547a0de3890bf43939fac85055.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/be/e8/40/8fb2e5547a0de3890bf43939fac85055.jpg","posit