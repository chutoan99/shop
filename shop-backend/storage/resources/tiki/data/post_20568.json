de":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/48/6e/27/a8192a4e6b8a65c64a4e2d91b16ccc67.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":789,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003e\u003cem\u003eRUIJIE RG-EW1200G Pro là dòng bộ định tuyến Wifi gia đình thực sự cao cấp. Đây là bộ định tuyến không dây băng tần kép gigabit được thiết kế đặc biệt cho các tình huống SOHO chẳng hạn như các ngôi nhà khác nhau.\u003c/em\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003ch3 style=\"text-align:justify;\"\u003e\u003cstrong\u003eBộ phát wifi Ruijie RG-EW1200G Pro (bộ định tuyến wifi gia đình)\u003c/strong\u003e\u003c/h3\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003eRUIJIE RG-EW1200G Pro\u003c/strong\u003e là bộ định tuyến không dây gigabit băng tần kép, được thiết kế cho mọi kiểu nhà và các tình huống SOHO khác. Nó đi kèm với chuẩn Wi-Fi 802.11ac Wave2 thế hệ tiếp theo có thể tăng tốc lên đến 1267Mbps để phát trực tuyến 4K ổn định và chơi game trực tuyến.\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/18/1d/c9/e4a53e2e73e924dd1c8b18630bee384e.jpg\" alt=\"\" width=\"750\" height=\"562\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003eEW1200G Pro\u003c/strong\u003e được tích hợp bộ khuếch đại công suất cao và nhiều ăng-ten bên ngoài, cùng với MU-MIMO và công nghệ tạo chùm tia, để cung cấp vùng phủ sóng Wi-Fi tốt nhất trong tất cả các mô hình gia đình.\u003c/p\u003e\n\u003ch3 style=\"text-align:justify;\"\u003e\u003cstrong\u003eThông số kỹ thuật ấn tượng của Ruijie RG-EW1200G Pro\u003c/strong\u003e\u003c/h3\u003e\n\u003cul style=\"text-align:justify;\"\u003e\u003cli\u003eRouter Wifi gia đình\u003c/li\u003e\n\u003cli\u003eTốc độ lên đến 1267Mbps\u003c/li\u003e\n\u003cli\u003eHỗ trợ 2 băng tần 2.4GHz và 5GHz chuẩn 802.11a/b/g/n/ac Wave1/Wave2, MU-MIMO\u003c/li\u003e\n\u003cli\u003eĐộ lợi An ten 6 x 6dBi\u003c/li\u003e\n\u003cli\u003eSố lượng người dùng truy cập đồng thời đề xuất là 30+\u003c/li\u003e\n\u003cli\u003e1 cổng 10/100/1000M WAN (Auto MDI/MDIX), 3 cổng 10/100/1000M LAN (Auto MDI/MDIX)\u003c/li\u003e\n\u003cli\u003eThiết bị mạng wifi RG-EW1200G PRO cũng được trang bị ứng dụng Ruijie Cloud để hỗ trợ toàn diện các cách quản lý thông minh và hoạt động từ xa.\u003c/li\u003e\n\u003cli\u003eTính năng nổi bật của thiết bị mạng wifi RUIJIE RG-EW1200G Pro\u003c/li\u003e\n\u003c/ul\u003e\u003cp style=\"text-align:justify;\"\u003e        + Chế độ định tuyến: PPPoE / DHCP / static IP\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e        + Chế độ phát lại: dây / không dây\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e        + Guest Wi-Fi; smart home Wi-Fi; wireless network isolation\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e        + Static DHCP \u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e        + Port mapping, DMZ, etc.\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e        + DDNS: Oray\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e        + UPnP\u003c/p\u003e\n\u003cul style=\"text-align:justify;\"\u003e\u003cli\u003eTính năng bảo mật của RG-EW1200G Pro\u003c/li\u003e\n\u003c/ul\u003e\u003cp style=\"text-align:justify;\"\u003e        + WPA-PSK/WPA2-PSK\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e        + ARP protection: IP/MAC binding\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e        + SSID hiding\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e        + Preventing rogue devices (Blacklist/whitelist)\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e        + Kiểm soát truy cập\u003c/p\u003e\n\u003cul style=\"text-align:justify;\"\u003e\u003cli\u003eNguồn DC 12V 1.5A\u003c/li\u003e\n\u003cli\u003eHỗ trợ dịch vụ Ruijie Cloud miễn phí cho phép cấu hình nhanh, đơn giản, quản lý và giám sát dễ dàng\u003c/li\u003e\n\u003cli\u003eHỗ trợ Mesh nhiều bộ Wifi với nhau (đề xuất 3 thiết bị)\u003c/li\u003e\n\u003cli\u003eHỗ trợ Roamming Layer 2\u003c/li\u003e\n\u003cli\u003eKích thước 220x140x36mm (W×D×H, bao gồm cả anten)\u003c/li\u003e\n\u003c/ul\u003e\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/7f/06/e3/bc8006233db7fce0511a9013ef59e5d8.jpg\" alt=\"\" width=\"750\" height=\"562\" /\u003e\u003c/p\u003e\n\u003ch3 style=\"text-align:justify;\"\u003e\u003cstrong\u003eTính năng nổi bật của Ruijie RG EW1200G Pro\u003c/strong\u003e\u003c/h3\u003e\n\u003ch4 style=\"text-align:justify;\"\u003e\u003cstrong\u003e1. Internet tốc độ cao\u003c/strong\u003e\u003c/h4\u003e\n\u003cul style=\"text-align:justify;\"\u003e\u003cli\u003e400Mpbs ở 2.4G + 867Mbps ở 5G, trong khi tốc độ có thể đạt 1267Mbps. Thiết kế tối ưu cho 2.4G, cung cấp thông lượng và truy cập Internet cao hơn.\u003c/li\u003e\n\u003cli\u003eTích hợp băng tần kép cung cấp độ nhiễu thấp và tốc độ internet nhanh. 802.11ac Wave2 + 6dBi. Ăng ten hiệu suất cao\u003c/li\u003e\n\u003c/ul\u003e\u003ch4 style=\"text-align:justify;\"\u003e\u003cstrong\u003e2. Tín hiệu Wi-Fi RG-EW1200G Pro ổn định và mạnh mẽ\u003c/strong\u003e\u003c/h4\u003e\n\u003cul style=\"text-align:justify;\"\u003e\u003cli\u003eChuẩn Wave2 và MU-MIMO có thể cải thiện hiệu quả dung lượng và hiệu suất truyền dẫn trong trường hợp nhiều thiết bị đa người dùng, camera giám sát, báo trộm,\u003c/li\u003e\n\u003cli\u003eĂng ten đa hướng 6dBi bên ngoài để nâng cao phạm vi Wi-Fi và hiệu suất mạng\u003c/li\u003e\n\u003cli\u003eCải tiến hai chiều để nhận và gửi tín hiệu\u003c/li\u003e\n\u003cli\u003eThiết kế FEM độc lập đảm bảo rằng mạng cục bộ khuếch đại công suất tín hiệu nhận được trong quá trình truyền tín hiệu, đồng thời, nó giảm hiệu quả sự gián đoạn giữa các thiết bị đầu cuối và đảm bảo hiệu suất thu phát.\u003c/li\u003e\n\u003c/ul\u003e\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/88/a4/2e/b5b10e657b6c2352d2435c672b723241.jpg\" alt=\"\" width=\"750\" height=\"562\" /\u003e\u003c/p\u003e\n\u003ch4 style=\"text-align:justify;\"\u003e\u003cstrong\u003e3. Tận dụng lợi thế của băng thông rộng tốt\u003c/strong\u003e\u003c/h4\u003e\n\u003cul style=\"text-align:justify;\"\u003e\u003cli\u003eKích hoạt tính năng NAT thông minh của phần cứng để đạt được chuyển tiếp dữ liệu tốc độ cao và tối đa hóa hiệu suất băng thông rộng\u003c/li\u003e\n\u003cli\u003eĐược trang bị CPU siêu phân luồng lõi kép mạnh mẽ, hỗ trợ chạy đa nhiệm và tốc độ siêu cao.\u003c/li\u003e\n\u003cli\u003eEW1200G PRO cung cấp vùng phủ sóng Wi-Fi tốt nhất trong mọi kiểu nhà. Bộ định tuyến Wifi Ruijie này ổn định và an toàn. \u003c/li\u003e\n\u003c/ul\u003e\u003ch3 style=\"text-align:justify;\"\u003e\u003cstrong\u003eMua ngay Router Wifi Ruijie Reyee RG-EW1200 chính hãng, giá rẻ tại NetworkP\u003c/strong\u003e\u003c/h3\u003e\n\u003cp style=\"text-align:justify;\"\u003eBạn có thể mua thiết bị mạng cục phát wifi \u003cstrong\u003eRuijie RG-EW1200G PRO\u003c/strong\u003e ở đâu, giá bán thiết bị mạng \u003cstrong\u003eRuijie RG-EW1200G PRO\u003c/strong\u003e là bao nhiêu? \u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/9b/1b/8e/e4c181b3ca8d9f8854cab3e9cc36b825.jpg\" alt=\"\" width=\"750\" height=\"562\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003eNetworkPro\u003c/strong\u003e là nhà phân phối chính thức các sản phẩm thiết bị mạng chính hãng, có giấy chứng nhận của nhà sản xuất, cam kết giá tốt nhất thị trường, hỗ trợ tư vấn tận tình.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/48/6e/27/a8192a4e6b8a65c64a4e2d91b16ccc67.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/48/6e/27/a8192a4e6b8a65c64a4e2d91b16ccc67.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/48/6e/27/a8192a4e6b8a65c64a4e2d91b16ccc67.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/48/6e/27/a8192a4e6b8a65c64a4e2d91b16ccc67.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/48/6e/27/a8192a4e6b8a65c64a4e2d91b16ccc67.png"},{"base_url":"https://salt.tikicdn.com/ts/product/eb/f0/b6/42c04092ccd6557037af3d1a5a050775.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/eb/f0/b6/42c04092ccd6557037af3d1a5a050775.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/eb/f0/b6/42c04092ccd6557037af3d1a5a050775.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/eb/f0/b6/42c04092ccd6557037af3d1a5a050775.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/eb/f0/b6/42c04092ccd6557037af3d1a5a050775.png"},{"base_url":"https://salt.tikicdn.com/ts/product/17/0b/30/4454eda44600ae8667bfa9ac4045d6d4.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/17/0b/30/4454eda44600ae8667bfa9ac4045d6d4.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/17/0b/30/4454eda44600ae8667bfa9ac4045d6d4.png","position":null,"small_url":"https://s