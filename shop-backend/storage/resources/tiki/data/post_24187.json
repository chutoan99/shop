,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":10,"review_text":"(10)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/fc/13/28/7adda2fd9e3e3c790857b9e45db06a1f.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1377,"all_time_quantity_sold":34,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eThông tin sản phẩm:\u003cbr /\u003eThiết kế hiện đại, tháo lắp dễ dàng\u003cbr /\u003eKết cấu chắc chắn, chịu lực tốt\u003cbr /\u003eDễ dàng tùy biến cho nhiều không gia\u003c/p\u003e\n\u003cp\u003eKích thước: Chiều dài 38cm x chiều sâu 23cm x chiều cao 1,3m\u003cbr /\u003eChất liệu: Sản phẩm sản xuât từ nhựa nguyên sinh cao cấp xuất sứ Nhật Bản\u003cbr /\u003eMàu sắc: Trắng Hiện đại\u003cbr /\u003eCó thể làm kệ nhà tắm kệ phòng khách kệ đựng Sách Tùy theo nhu cầu sử dụng\u003cbr /\u003ePhong cách: Hiện đại\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eBạn đang cần tìm sản phẩm\u003cstrong\u003e kệ\u003c/strong\u003e cho phòng ngủ cá nhân, kệ giá để đồ, \u003cstrong\u003ekệ trưng bày sản phẩm\u003c/strong\u003e tại cửa hàng, \u003cstrong\u003ekệ tài liệu\u003c/strong\u003e tại văn phòng làm việc.\u003c/li\u003e\n\u003cli\u003eBạn đang cần tìm mẫu \u003cstrong\u003ekệ đa năng để đồ\u003c/strong\u003e có thiết kế hiện đại tinh tế không chỉ là kệ mà còn là kệ trang trí.\u003c/li\u003e\n\u003cli\u003eBạn đang cần tìm mẫu \u003cstrong\u003ekệ đa năng\u003c/strong\u003e có kết cấu thông minh tiết kiệm diện tích dễ dàng di chuyển khi có nhu cầu.\u003c/li\u003e\n\u003cli\u003eBạn cần sản phẩm có chất lượng cao nhưng chi phí phải hợp lý không lãng phí.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003e     Chúng tôi xin giới thiệu mẫu kệ đa năng hot nhất năm 2020 đó chính là\u003c/strong\u003e\u003c/p\u003e\n\u003ch1\u003e\u003cem\u003e\u003cstrong\u003eKệ đa năng Tokyo 5 tầng hàng cao cấp\u003c/strong\u003e\u003c/em\u003e\u003c/h1\u003e\n\u003cp\u003e\u003cem\u003e\u003cstrong\u003e=== CÂU CHUYỆN CỦA SẢN PHẨM ===\u003c/strong\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003eSống tại Tokyo là trải nghiệm nghệ thuật tiết kiệm không gian. Trong những căn hộ bé xinh tại thủ đô đông đúc, người Nhật luôn tìm cách sắp xếp đồ đạc gọn gàng nhất, tiện lợi nhất nhưng vẫn thoáng đạt nhất có thể. Đó chính là cảm hứng cho bộ sưu tập kệ Tokyo của Inochi.\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cstrong\u003e=== NGUỒN GỐC CỦA SẢN PHẨM ===\u003c/strong\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003eInochi là thương hiệu nhựa gia dụng cao cấp Việt Nam được thiết kế và sản xuất theo phong cách và tiêu chuẩn Nhật Bản. Ra mắt năm 2018, các mặt hàng gia dụng cao cấp của Inochi đã sớm gây được ấn tượng khách hàng, bởi sản phẩm sử dụng 100% nguyên liệu nhựa nguyên sinh an toàn, có chất lượng cao, tích hợp các tính năng vượt trội, kháng khuẩn, khử mùi và thiết kế đẹp mắt, tiện lợi, phục vụ tối đa các nhu cầu thiết yếu cùng tiện ích của mọi gia đình.\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/a2/7b/1d/4489694905683418caddf8971adcf120.jpg\" alt=\"\" width=\"750\" height=\"1723\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003eThông tin sản phẩm\u003c/em\u003e:\u003cbr /\u003e- Thiết kế hiện đại, tháo lắp dễ dàng\u003cbr /\u003e- Kết cấu chắc chắn, chịu lực tốt\u003cbr /\u003e- Dễ dàng tùy biến cho nhiều không gia\u003cbr /\u003e- Kích thước: 370 x 230 x 1300 mm\u003cbr /\u003e- Khối lượng: 1000 gr\u003cbr /\u003e- Màu sắc: Trắng hiện đại\u003c/p\u003e\n\u003cp\u003e- Chất liệu: Nhựa nguyên sinh cao cấp\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/a2/7b/1d/0deb37845069f7365c6c3b44520b9b87.jpg\" alt=\"\" width=\"750\" height=\"1723\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/30/bd/7e/0fa4ef93df65cb898543e6f1d1b96ef1.jpg\" alt=\"\" width=\"750\" height=\"818\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cstrong\u003eNhựa nguyên sinh là gì?\u003c/strong\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003eNhựa nguyên sinh bao gồm một số loại nhựa như PP, PC, ABS, PS-GPPS, HIPS, POM, PA, PMMA… Đây đều là những loại nhựa nguyên chất, không pha tạp, không thêm phụ gia. Nhựa nguyên sinh có đặc tính là mềm dẻo, độ đàn hồi lớn, chịu được cong vênh và áp lực. Đặc biệt không có mùi, không độc hại và không ảnh hưởng đến sức khỏe của người sử dụng. \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/66/15/24/3cfa924b145b0bcbf6a3a78bc086fc85.jpg\" alt=\"\" width=\"750\" height=\"818\" /\u003e\u003c/p\u003e\n\u003cp\u003eSản phẩm thiết kế theo phong cách Nhật Bản kiểu dáng đơn giản mà lại rất sang trọng, màu sắc nhã nhặn, các sản phẩm kệ của Inochi công dụng đều rất đa dạng, không chỉ đựng đồ dùng cá nhân, người dùng có thể sử dụng được trong nhiều mục đích khác nhau. \u003c/p\u003e\n\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Tuy nhiên tuỳ vào từng loại sản phẩm hoặc phương thức, nơi giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh,\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/fc/13/28/7adda2fd9e3e3c790857b9e45db06a1f.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/fc/13/28/7adda2fd9e3e3c790857b9e45db06a1f.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/fc/13/28/7adda2fd9e3e3c790857b9e45db06a1f.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fc/13/28/7adda2fd9e3e3c790857b9e45db06a1f.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fc/13/28/7adda2fd9e3e3c790857b9e45db06a1f.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/65/a6/96/e1c8bde653397deecff1df3f5b339319.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/65/a6/96/e1c8bde653397deecff1df3f5b339319.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/65/a6/96/e1c8bde653397deecff1df3f5b339319.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/65/a6/96/e1c8bde653397deecff1df3f5b339319.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/65/a6/96/e1c8bde653397deecff1df3f5b339319.png"},{"base_url":"https://salt.tikicdn.com/ts/product/30/bd/7e/097cc541af01cd440889742b337c963c.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/30/bd/7e/097cc541af01cd440889742b337c963c.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/30/bd/7e/097cc541af01cd440889742b337c963c.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/30/bd/7e/097cc541af01cd440889742b337c963c.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/30/bd/7e/097cc541af01cd440889742b337c963c.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/36/02/fe/6fe30e8b50b82eeabf11ca190deb1fab.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/36/02/fe/6fe30e8b50b82eeabf11ca190deb1fab.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/36/02/fe/6fe30e8b50b82eeabf11c