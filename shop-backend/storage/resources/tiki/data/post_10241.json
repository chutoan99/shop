https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"freeship_xtra","type":"pdp_icon_badge","index":2,"icon":"https://salt.tikicdn.com/ts/upload/be/67/48/04a82ab8df178e1a13bde38316081865.png","icon_width":91,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":true,"return_reason":"any_reason"}},"discount":1000,"discount_rate":5,"rating_average":4.6,"review_count":20,"review_text":"(20)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/media/catalog/product/i/m/img_20170813_0150.u5465.d20170817.t110024.901940.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2581,"all_time_quantity_sold":312,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p><strong> Việt Nam Những Hình Ảnh Xưa </strong> là quyển sách sẽ cho các bạn được nhìn ngắm khung cảnh, cảnh vật, con người Việt Nam ta từ thời xa xưa. Trong cuốn sách     có nhiều chủ đề thú vị như: triều đình, quan chức, trẻ em hay người nông dân. Tất cả những ảnh thời xưa này được chụp từ     các nhiếp ảnh gia nước ngoài.</p>\r\n<p>Kỹ thuật chụp hình được Lois Jacques Mande Daguerre ở Paris sáng chế năm 1839. Sau khi máy chụp hình bán trên thị trường,     đã được mọi người tiếp đón nồng nhiệt. Các nhà thám hiểm, nghiên cứu và du lịch đã dùng ngay máy hình để thu lại hình ảnh     của những nơi họ đi qua.</p>\r\n<p>Theo các hình ảnh còn lưu trữ tại Thư viện Quốc gia (đường Richelieu, Paris) và Société de Géographie (Đại lộ Saint Germain,     Paris) thì tấm hình chụp Sứ bộ Phan Thanh Giản, do Vua Tự Đức gửi sang Pháp gặp Napoléon III năm 1863, để xin chuộc lại ba     tỉnh miền Đông Nam Kỳ, là những tấm ảnh đầu tiên liên quan đến Việt Nam. Năm 1866, khi Doudart de Lagrée dẫn đầu Phái đoàn     thám hiểm sông Mêkông, khi tìm thấy di tích Angkor ở Cam - Bốt đã cho gọi Gsell, một nhiếp ảnh gia ở Sài Gòn lên đó chụp     hình.</p>\r\n<p>Điều này chứng tỏ rằng kỹ thuật chụp hình đã được truyền sang nước ta rất sớm, ngay sau khi người Pháp chiếm được ba tĩnh     miền Đông Nam Kỳ (1862). Lúc bấy giờ một nhiếp ảnh gia người Việt, ông Trần Ngươn Hán dã chụp nhiều hình cho các quan và     các nhà quí tộc người Việt.</p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/media/catalog/product/i/m/img_20170813_0150.u5465.d20170817.t110024.901940.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/i/m/img_20170813_0150.u5465.d20170817.t110024.901940.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/i/m/img_20170813_0150.u5465.d20170817.t110024.901940.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/ca