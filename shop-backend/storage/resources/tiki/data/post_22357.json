:null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/12/2e/ef/279140a590f557e3766593e4ad4506d6.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":141,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eNhỏ gọn, vừa tay, tiện mang đi nhưng sức chứa lớn; xay rất nhẹ và ổn định, giúp cà phê đạt độ mịn vừa vặn và hương vị hoàn hảo; siêu bền và rất dễ lau chùi; vẻ ngoài hiện đại, đẹp mắt như một vật sở hữu đáng tự hào… Nếu trên đây là tất cả những gì bạn mong muốn ở một chiếc cối xay cà phê tay, thì Comadante chính là sản phẩm bạn đang kiếm tìm.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e Đặc điểm mổi bật của cối xay cà phê cầm tay Comandante C40 MK4\u003c/p\u003e\n\u003cp\u003e Thiết kế tiên tiến theo công nghệ Đức\u003c/p\u003e\n\u003cp\u003eCối xay cà phê cầm tay Comandante C40 MK4 được chế tác thủ công theo công nghệ cực kỳ chính xác của Đức, mọi sản phẩm đều được kiểm tra tỉ mỉ đến từng chi tiết trước khi tung ra thị trường.\u003c/p\u003e\n\u003cp\u003eKỳ công chọn lọc những vật liệu tốt nhất cùng công nghệ uốn gỗ Veneer độc đáo, Comandante giúp việc xay cà phê trở nên dễ dàng, linh hoạt hơn. Điều mà bạn có thể cảm nhận khi xay là xay rất nhẹ, không cần tốn quá nhiều lực vì được trợ lực và ổn định trục xay bằng 2 vòng bạc đạn. Ngoài ra, thiết kế điều chỉnh độ xay theo nấc giúp cố định độ xay ưa thích một cách dễ dàng.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e Lưỡi dao siêu bền và chính xác\u003c/p\u003e\n\u003cp\u003eCối xay cà phê cầm tay Comandante C40 MK4 có lưỡi dao được làm từ Thép Martensitic bổ sung thêm Nitơ, cối xay Conmandante có độ bền cực kỳ cao và xay vô cùng chính xác, chất lượng hạt đồng đều, ít hạt vỡ. Điều này giúp Conmandante có thể điều chỉnh để phù hợp với nhiều kiểu pha cà phê, đặc biệt là Espresso.\u003c/p\u003e\n\u003cp\u003eDù thiết kế nhỏ gọn nhưng Comandante có thể xay tối đa lên tới 40-45g, tương ứng với 4 shot Espresso hay 6-8 phần pha Drip.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e Vẻ ngoài hiện đại, bắt mắt\u003c/p\u003e\n\u003cp\u003eCối xay cà phê cầm tay Comandante C40 MK4 có kích thước nhỏ gọn, chắc chắn, phù hợp với việc mang theo đi du lịch. Vẻ ngoài bắt mắt, hiện đại cùng 9 màu sắc độc đáo để bạn tha hồ lựa chọn.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e Bên trong hộp Comandante C40 MK4 có gì?\u003c/p\u003e\n\u003cp\u003e- Thân máy.\u003c/p\u003e\n\u003cp\u003e- Tay quay và Crank - Knob\u003c/p\u003e\n\u003cp\u003e- 1 hũ đựng cà phê thủy tinh màu hổ phách và 1 hũ đựng bột cà phê Polyme trắng trong\u003c/p\u003e\n\u003cp\u003e- Nắp đậy hũ đựng cà phê\u003c/p\u003e\n\u003cp\u003e- Sách hướng dẫn sử dụng\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/12/2e/ef/279140a590f557e3766593e4ad4506d6.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/12/2e/ef/279140a590f557e3766593e4ad4506d6.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/12/2e/ef/279140a590f557e3766593e4ad4506d6.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200