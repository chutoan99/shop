nfo":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":65000,"discount_rate":31,"rating_average":4,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/88/32/f1/1babedcd4a6c527c1cfc6ca6fdf65ee6.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":0,"all_time_quantity_sold":58,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: medium; color: #008ab7;\"\u003e\u003cstrong\u003eKính Lúp Deli 9099\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eKính Lúp Deli 9099 \u003c/strong\u003ecó thiết kế nhỏ gọn, chắc chắn với vòng đai bảo vệ kính và phần tay cầm được làm từ nhựa đàn hồi chịu lực, chịu nhiệt. Tròng kính được làm bằng thủy tinh quang học cao cấp, cho chất lượng hình ảnh sáng trong và rõ nét, không bị mờ đục. Đồng thời, kính còn được tích hợp thêm đèn Led tiện dụng, giúp bạn quan sát rõ hơn các vật nhỏ trong điều kiện ánh sáng yếu.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"http://tikicdn.com/media/catalog/product/9/0/9098_9099_1.jpg\" alt=\"\" width=\"600\" height=\"600\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/9b/38/8d/71650651255dd3d85881310dcf6c1af0.jpg\" alt=\"\" width=\"750\" height=\"4846\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eThông tin sản phẩm\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eChất liệu thuỷ tinh cao cấp\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003eKính Lúp Deli 9099 được làm bằng thủy tinh quang học cao cấp, cho chất lượng hình ảnh sáng trong và rõ nét, không bị mờ đục. Ngoài ra, chất liệu này còn giúp sản phẩm không bị rạn nứt bởi ảnh hưởng của môi trường và thời gian, tạo độ bền cao, cho tuổi thọ lâu dài.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eThiết kế chắc chắn\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003eSản phẩm có trọng lượng nhẹ, được thiết kế chắc chắn với vòng đai bảo vệ kính được làm từ nhựa đàn hồi chịu lực, chịu nhiệt. Phần tay cầm cũng được làm bằng nhựa cao cấp, cho độ ma sát lớn, chống trơn trượt.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eKết hợp đèn Led tiện dụng\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003eKính lúp có đường kính rộng 75mm, cho độ phóng đại lớn, thích hợp dùng trong nghiên cứu, thí nghiệm, giảng dạy ở các trường học hoặc dùng trong các xí nghiệp, nhà máy,... Đặc biệt, kính có tích hợp thêm đèn Led, giúp bạn quan sát rõ hơn trong điều kiện ánh sáng yếu, đồng thời có thể sử dụng như một đèn pin mini dự phòng rất sáng, rất thuận tiện khi đọc sách, tìm kiếm, hoặc kiểm tra các vi mạch điện tử, bo mạch điện thoại di động...\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e\u003cp\u003eSản phẩm này là tài sản cá nhân được bán bởi Nhà Bán Hàng Cá Nhân và không thuộc đối tượng phải chịu thuế GTGT. Do đó hoá đơn VAT không được cung cấp trong trường hợp này.\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/88/32/f1/1babedcd4a6c527c1cfc6ca6fdf65ee6.png","is_gallery":true,