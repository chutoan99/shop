hero","type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"freeship_xtra","type":"pdp_icon_badge","index":2,"icon":"https://salt.tikicdn.com/ts/upload/be/67/48/04a82ab8df178e1a13bde38316081865.png","icon_width":91,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":true,"return_reason":"any_reason"}},"discount":74000,"discount_rate":35,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/40/28/81/0f36f915e2ed1df014019c7ad55161fe.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":371,"all_time_quantity_sold":4,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eTÁC GIẢ: Susan Forward, Joan Torres\u003c/p\u003e\n\u003cp\u003eDịch giả: Anh Tuấn\u003c/p\u003e\n\u003cp\u003eTHÔNG TIN XUẤT BẢN:\u003c/p\u003e\n\u003cp\u003eKích thước: 13x20.5\u003c/p\u003e\n\u003cp\u003eSố trang: 408\u003c/p\u003e\n\u003cp\u003eMã EAN: 8936066697033\u003c/p\u003e\n\u003cp\u003eNXB liên kết: NXB LAO ĐỘNG\u003c/p\u003e\n\u003cp\u003eSách do Công ty TNHH Văn hóa và Truyền thông 1980 BOOKS ấn hành quý III/2023.\u003c/p\u003e\n\u003cp\u003eTHAO TÚNG ĐÀN ÔNG BẰNG MẮT – THAO TÚNG ĐÀN BÀ BẰNG TAI\u003c/p\u003e\n\u003cp\u003eBạn có bao giờ cảm thấy rằng bạn luôn là người có lỗi trong một mối quan hệ? Rằng bạn không đủ tốt và đang phá hủy cuộc hôn nhân của chính mình? Rằng bạn ý thức được bản thân đang ở trong một mối quan hệ độc hại nhưng lại không thể rời đi?\u003c/p\u003e\n\u003cp\u003eNếu câu trả lời của bạn là có, thì Thao túng đàn ông bằng mắt, thao túng đàn bà bằng tai là cuốn sách bạn nên đọc. Bằng nhiều năm kinh nghiệm tư vấn tâm lý, tác giả Susan Forward sẽ đưa ra những ví dụ vô cùng chi tiết, các lời giải thích rõ ràng và nhiều bài tập để giúp bạn nhận ra bản chất thật của mối quan hệ, xây dựng góc nhìn mới về bản thân, từ đó thay đổi và chữa lành những tổn thương bạn đã phải chịu đựng.\u003c/p\u003e\n\u003cp\u003eVới những lời kể trực tiếp từ các thân chủ, Susan đã thành công viết lên một cuốn sách vô cùng chi tiết, giúp bạn đọc:\u003c/p\u003e\n\u003cp\u003e- Nhận biết một người đàn ông coi thường nữ giới.\u003c/p\u003e\n\u003cp\u003e- Hiểu được cách hắn thao túng bạn đời.\u003c/p\u003e\n\u003cp\u003e- Thực hành các bài tập để lấy lại sự tự tin của bản thân.\u003c/p\u003e\n\u003cp\u003e- Từng bước lựa chọn sửa chữa hoặc từ bỏ mối quan hệ đó.\u003c/p\u003e\n\u003cp\u003e- Xử lý mặc cảm tội lỗi sau khi phá bỏ một mối quan hệ độc hại.\u003c/p\u003e\n\u003cp\u003eVề tác giả:\u003c/p\u003e\n\u003cp\u003eSusan Forward (1938 – 2020) là một bác sĩ tâm lý lành nghề, giảng viên tài năng và tác giả của nhiều cuốn sách nổi bật. Trong những năm làm việc, bà đã tư vấn trị liệu cho vô số phụ nữ mắc kẹt trong mối quan hệ độc hại, bị chồng mình lạm dụng, bạo hành. Susan nhận ra điểm chung trong những mối quan hệ này là người chồng luôn là người coi thường nữ giới, họ mang trong mình nỗi thù địch, sự coi thường và định kiến với phái nữ.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/40/28/81/0f36f915e2ed1df014019c7ad55161fe.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/40/28/81/0f36f915e2ed1df014019c7ad55161fe.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/40/28/81/0f36f915e2ed1df014019c7ad55161fe.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/40/28/81/0f36f915e2ed1df014019c7ad55161fe.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/40/28/81/0f36f915e2ed1df014019c7ad55161fe.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/62/75/49/774d36836c01aa8ec97fedd8b51a5822.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/62/75/49/774d36836c01aa8ec97fedd8b51a5822.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/62/75/49/774d36836c01aa8ec97fedd8b51a5822.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/62/75/49/774d36836c01aa8ec97fedd8b51a5822.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/62/75/49/774d36836c01aa8ec97fedd8b51a5822.jpg"}],"warranty_policy":null,"current_seller":{"id":127920,"sku":"8312371703071","name":"1980 BOOKS HCM","link":"https://tiki.vn/cua-hang/1980-books-hcm","logo":"https://vcdn.tikicdn.com/ts/seller/32/ee/e4/029d9bc223e36fb8f5ee1933e6ac9d47.jpg","price":135000,"product_id":"272056492","store_id":118186,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[{"id":185035,"name":"19