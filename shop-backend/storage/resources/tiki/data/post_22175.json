o loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/6d/3d/20/6d2c5b9acad0353263a51728cffdffdb.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/6d/3d/20/6d2c5b9acad0353263a51728cffdffdb.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/6d/3d/20/6d2c5b9acad0353263a51728cffdffdb.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6d/3d/20/6d2c5b9acad0353263a51728cffdffdb.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6d/3d/20/6d2c5b9acad0353263a51728cffdffdb.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/df/26/52/86a4cdac09200ce34f5a312f2d53feb5.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/df/26/52/86a4cdac09200ce34f5a312f2d53feb5.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/df/26/52/86a4cdac09200ce34f5a312f2d53feb5.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/df/26/52/86a4cdac09200ce34f5a312f2d53feb5.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/df/26/52/86a4cdac09200ce34f5a312f2d53feb5.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/7b/4b/b7/f07d12279fddea645df8fd9fb87b7be6.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/7b/4b/b7/f07d12279fddea645df8fd9fb87b7be6.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/7b/4b/b7/f07d12279fddea645df8fd9fb87b7be6.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7b/4b/b7/f07d12279fddea645df8fd9fb87b7be6.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7b/4b/b7/f07d12279fddea645df8fd9fb87b7be6.jpg"},{"base