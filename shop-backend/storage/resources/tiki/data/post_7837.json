56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/b9/d9/c3/ecf40d3eb559cf74ee3394bf11bfc852.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":63,"all_time_quantity_sold":4,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2\u003e\u003cstrong\u003eGIÁ TREO KHỬ KHUẨN BÀN CHẢI\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/7f/58/c1/ae08f2cfc23c8595f79d8846c9d75a67.jpg\" alt=\"\" width=\"720\" height=\"720\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTHÔNG TIN SẢN PHẨM :\u003c/strong\u003e \u003cbr /\u003e+ Công nghệ diệt khuẩn bằng đèn UV an toàn. Tự động tắt đèn UV khi có hoạt động con người từ khoảng cách xa 2m với cảm biến thông minh.\u003cbr /\u003e+ Công nghệ thông minh sạc bằng năng lượng ánh sáng. Không phải cắm điện, dây rợ loằng ngoằng. Cực kỳ an toàn không lo hở điện như các loại khác. Không bao giờ lo hết pin. Muốn sạc pin có thể nhấc máy khỏi đế treo ra sạch 1 cách dễ dàng.\u003cbr /\u003e+ Tiêu diệt vi khuẩn ẩn sâu bên trong mọi ngõ ngách bàn chải, mà khi rửa bằng nước không thể diệt được vi khuẩn.\u003cbr /\u003e+ Nhả kem đánh răng thông minh không lãng phí.\u003cbr /\u003e+ Lắp đặt dễ dàng không cần khoan tường, bắt vít bằng giá treo với miếng dán chắc chắn.\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/c9/6b/b8/632ec87d34b1494f7c964f6a3a3109bf.png\" alt=\"\" width=\"722\" height=\"722\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ae/97/09/7abef85cb8c1fb367ef985d5cc378d66.jpg\" alt=\"\" width=\"720\" height=\"720\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTHÔNG SỐ KỸ THUẬT\u003c/strong\u003e\u003cbr /\u003e* Thiết kế nhỏ gọn và rỗng đảm bảo thông gió tốt, khó nuôi vi khuẩn.\u003cbr /\u003e+ Nhiệt độ môi trường làm việc: -15 đến 50 độ C.\u003cbr /\u003e+ Độ ẩm môi trường làm việc: 30-90% RH\u003cbr /\u003e+ Điện áp làm việc định mức: DC3.7V\u003cbr /\u003e+ Model: FV-568\u003cbr /\u003e+ Standby Hiện Tại: 1MA\u003cbr /\u003e+ Công suất đèn UV: 1.2 W\u003cbr /\u003e+ Dòng sạc DC: 450mA\u003cbr /\u003e+ Dung lượng pin lithium: 1200 mAh (đã bao gồm)\u003cbr /\u003e+ Các tính năng: Treo tường, kệ lưu trữ, cung cấp phòng tắm\u003cbr /\u003e+ Màu sắc: Trắng\u003cbr /\u003e+ Chất liệu: ABS + PP + linh kiện điện tử\u003cbr /\u003e+ Kích thước: 19 cm x 12.5 cm x 4.7 cm\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/a4/2a/72/75968b008a9b305ce80864a663b068ea.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/a6/0b/6a/34a7f368f1b3f6157df4ed9971fb1976.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003cbr /\u003e️Máy tiệt trùng bàn chải đánh răng có hệ thống sạc năng lượng mặt trời, có thể sạc lại dưới ánh sáng mà không cần ánh sáng mặt trời trực tiếp. Lưu trữ năng lượng pin lithium, tiết kiệm năng lượng và bảo vệ môi trường, hoàn toàn thoát khỏi xiềng xích của ổ cắm. Không có nguồn cung cấp bên ngoài là cần thiết để làm cho môi trường phòng tắm đẹp\u003cbr /\u003e️Khử trùng kép thông minh UV + Máy tiệt trùng bàn chải đánh răng là một dụng cụ đánh răng thông minh đa chức năng giúp làm sạch và bảo vệ đồ dùng trong nhà của bạn. Khử trùng bàn chải đánh răng tại nhà của bạn khi bạn không sử dụng nó. Hệ thống cảm ứng thông minh hồng ngoại làm cho nó hoạt động khi mọi người đến gần và khử trùng khi mọi người rời đi\u003cbr /\u003e️Mắt cảm ứng hồng ngoại thông minh sẽ bật đèn UV khử trùng bằng tia UV sau 2h tính từ lần cuối cùng bạn ở gần nó (tức là việc khử trùng sẽ làm việc khi không có người trong phòng để đảm bảo không làm bạn bị ảnh hưởng bởi tia cực tím mà nó phát ra để tiêu diệt vi khuẩn).\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/b9/d9/c3/ecf40d3eb559cf74ee3394bf11bfc852.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b9/d9/c3/ecf40d3eb559cf74ee3394bf11bfc852.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b9/d9/c3/ecf40d3eb559cf74ee3394bf11bfc852.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b9/d9/c3/ecf40d3eb559cf74ee3394bf11bfc852.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b9/d9/c3/ecf40d3eb559cf74ee3394bf11bfc852.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/3b/73/f0/09c5becdb7b8bc9ceca27cf264093f72.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/3b/73/f0/09c5becdb7b8bc9ceca27cf264093f72.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/3b/73/f0/09c5becdb7b8bc9ceca27cf264093f72.jpg","position":null,"small_url":"https://salt