":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":1948800,"discount_rate":32,"rating_average":5,"review_count":4,"review_text":"(4)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/8c/a5/7e/94d8dbc4786bd0a1faea95a8e01d4e37.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1135,"all_time_quantity_sold":11,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cdiv class=\"wpb_text_column wpb_content_element\"\u003e\n\u003cdiv class=\"wpb_wrapper\"\u003e\u003cstrong\u003eNệm cao su thiên nhiên Kim Cương với thiết kế thông minh\u003c/strong\u003e\n\u003cp\u003e- Bề mặt nệm được thiết  kế với trên 5.000 lỗ thoáng nhỏ ở mặt trên và hơn 500 lỗ thoáng lớn ở mặt dưới, tạo sự thông thoáng tối đa.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/3e/53/c9/3a9853ce9ab703a433d6a0ecb8042b6b.jpeg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e- Nệm có khả năng hút ẩm nhanh giúp bề mặt nệm luôn khô thoáng, không gây hầm nóng, bí hơi. Đảm bảo mát về mùa hè, ấm về mùa đông, thích hợp sử dụng cho tất cả các mùa.\u003c/p\u003e\n\u003cp\u003e- Thiết kế thông minh, độ đàn hồi tối ưu giúp nâng đỡ hoàn hảo các đường cong cơ thể, giữ cho cột sống luôn trong tư thế thẳng khi nằm.\u003c/p\u003e\n\u003cp\u003e- Sản phẩm hỗ trợ rất tốt cho cột sống người nằm. Đặc biệt với trẻ em đang trong giai đoạn phát triển hệ xương, người già và người đau nhức xương khớp.\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"wpb_text_column wpb_content_element\"\u003e\n\u003cdiv class=\"wpb_wrapper\"\u003e\u003cstrong\u003eNệm Happy Gold với 5 điểm đặc biệt\u003c/strong\u003e\n\u003cp\u003e\u003cstrong\u003e- Nệm Happy Gold Kim Cương \u003c/strong\u003eđược sản xuất theo dây chuyền công nghệ tiên tiến của Đức từ nguồn \u003cstrong\u003ecao su thiên nhiên \u003c/strong\u003ekhông tạp chất.\u003c/p\u003e\n\u003cp\u003e- Sản phẩm đảm bảo sạch khuẩn, không côn trùng lưu trú và có mùi thơm tự nhiên. \u003cstrong\u003eNệm cao su Happy Gold\u003c/strong\u003e không gây khó chịu, kích ứng người dùng.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/57/b9/c4/06263862c8e6047f2ddb9a94e45a7128.jpeg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e- Bề mặt nệm kháng khuẩn, tiêu diệt mọi loại vi khuẩn gây hại đến da. Đạt tiêu chuẩn chất lượng tham gia Hiệp hội ISPA hàng đầu thế giới về ngành nệm. Nệm được kiểm soát bởi hệ thống quản lý chất lượng đạt tiêu chuẩn ISO 9001:2008.\u003c/p\u003e\n\u003cp\u003e- Áo nệm được làm từ 100% cotton, tháo rời dễ dàng giúp cho người dùng dễ dàng vệ sinh.\u003c/p\u003e\n\u003cp\u003e- Độ bền cao lên đến 25 năm nếu sử dụng đúng cách. Đảm bảo không xẹp lún, không chảy nhựa theo thời gian.\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"wpb_text_column wpb_content_element\"\u003e\u003cstrong\u003eNệm Kim Cương Happy Gold đã đạt các chứng chỉ chất lượng quốc tế\u003c/strong\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003eNệm Kim Cương\u003c/strong\u003e đã trải qua hành trình khằng định chất lượng bằng việc thông qua các cuộc thử nghiệm, kiểm tra nghiêm ngặt trong và ngoài nước.\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eNệm cao su thiên nhiên Kim Cương\u003c/strong\u003e được chứng nhận là sản phẩm an toàn cho sức khỏe, vinh dự được các Tổ chức uy tín trên Thế giới công nhận:\n\u003cul\u003e\n\u003cli\u003eTUV (LGA) – Đức chứng nhận (Tính vật lý), sản phẩm cao su thiên nhiên đàn hồi tối ưu – độ bền và tuổi thọ cao.\u003c/li\u003e\n\u003cli\u003eSGS – Thụy Sĩ chứng nhận (Tính hóa học), sản phẩm cao su thiên nhiên kháng khuẩn, không côn trùng lưu trú.\u003c/li\u003e\n\u003cli\u003eISPA – Mỹ chứng nhận sản phẩm chăm sóc giấc ngủ đạt tiêu chuẩn chất lượng tham gia Hiệp Hội hàng đầu thế giới về ngành nệm (ISPA).\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/8c/a5/7e/94d8dbc4786bd0a1faea95a8e01d4e37.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/8c/a5/7e/94d8dbc4786bd0a1faea95a8e01d4e37.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/8c/a5/7e/94d8dbc4786bd0a1faea95a8e01d4e37.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8c/a5/7e/94d8dbc4786bd0a1faea95a8e01d4e37.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8c/a5/7e/94d8dbc4786bd0a1faea95a8e01d4e37.png"},{"base_url":"https://salt.tikicdn.com/ts/product/a0/95/a9/27811a538caed9ac6e0ad9f3d8857a51.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a0/95/a9/27811a538caed9ac6e0ad9f3d8857a51.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a0/95/a9/27811a538caed9ac6e0ad9f3d8857a51.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a0/95/a9/27811a538caed9ac6e0ad9f3d8857a51.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a0/95/a9/27811a538caed9ac6e0ad9f3d8857a51.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/76/6c/43/