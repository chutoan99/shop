 Nam.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e Cam kết của Shop:\u003c/p\u003e\n\u003cp\u003eILOTA cam kết 100% sản phẩm của ILOTA đều là sản phẩm chính hãng. Nếu khách hàng phát hiện hàng giả hàng nhái, ILOTA xin bồi thường 9.999.999đ cho khách hàng.\u003c/p\u003e\n\u003cp\u003e Chính sách đổi trả của ILOTA:\u003c/p\u003e\n\u003cp\u003e1 đổi 1 trong trường hợp lỗi do nhà sản xuất, sai sản phẩm.\u003c/p\u003e\n\u003cp\u003eTrường hợp ILOTA gửi thiếu, các bạn liên hệ shop để được đổi lại, gửi bù MIỄN PHÍ ạ. (Các bạn nhớ QUAY CLIP BÓC HÀNG để được giải quyết nhé).\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/96/9d/a7/60398c5fd1932ada7d9d30e5dd25b83b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/96/9d/a7/60398c5fd1932ada7d9d30e5dd25b83b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/96/9d/a7/60398c5fd1932ada7d9d30e5dd25b83b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/96/9d/a7/60398c5fd1932ada7d9d30e5dd25b83b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/96/9d/a7/60398c5fd1932ada7d9d30e5dd25b83b.jpg"}],"warranty_policy":null,"brand":{"id":629963,"name":"Trần Quang","slug":"tran-quang"},"current_seller":{"id":64301,"sku":"4217772773277","name":"ILOTA","link":"https://tiki.vn/cua-hang/ilota","logo":"https://vcdn.tikicdn.com/ts/seller/3c/db/58/7833ec95e5687e6a0d668f6556e144cb.jpg","price":73000,"product_id":"275826799","store_id":60367,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Content","attributes":[{"code":"bra