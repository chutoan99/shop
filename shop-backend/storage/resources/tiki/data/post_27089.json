1483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/e2/af/c4/6381bcb6b233a79d0b21cc2363415259.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":981,"all_time_quantity_sold":32,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2 style=\"text-align: center;\"\u003eBộ sách “THẾ GIỚI QUANH EM” - Khoa học không khó vì đã có sách hay!\u003c/h2\u003e\n\u003cp\u003eTừ những năm tháng đầu đời con đã đầu phát triển nhận thức ở mức độ phức tạp dần với vô vàn câu hỏi về thế giới xung quanh. Các em bé luôn khao khát tìm hiểu lý do đằng sau mỗi hiện tượng mà con quan sát được hàng ngày.\u003c/p\u003e\n\u003cp\u003eĐó là lý do vì sao đây là thời điểm tuyệt vời và cực kì cần thiết để ba mẹ giới thiệu sách khoa học với trẻ. Đọc một cuốn sách khoa học không chỉ mở ra những bí mật về thế giới xung quanh, mà còn là cơ hội để con khám phá sở thích, đam mê của chính bản thân mình và xây dựng các kỹ năng tư duy quan trọng cho quá trình học tập.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/9f/ae/3f/ae5b64458f59024f438b2324355b26d4.jpg\" alt=\"\" width=\"750\" height=\"502\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003eBộ sách khoa học “THẾ GIỚI QUANH EM” mới nhất của Lionbooks chính là một sự lựa chọn hoàn hảo cho các bạn nhỏ.\u003c/p\u003e\n\u003ch3\u003eBộ sách Thế Giới Quanh Em gồm 2 cuốn:\u003c/h3\u003e\n\u003cp\u003e\u003cstrong\u003e“MƯA NẮNG NẮNG MƯA”\u003c/strong\u003e: cuốn sách siêu đáng yêu sẽ kích thích trí tưởng tượng cho bé, giúp con nhận biết các hiện tượng thời tiết, tiếp thu các kiến thức khoa học một cách vô cùng hiệu quả mà không hề khô khan. Toàn bộ câu chuyện về các hiện tượng thiên nhiên sẽ giúp con trả lời được câu hỏi mà bạn nhỏ nào cũng từng tò mò: \"Mưa và nắng - Điều gì quan trọng hơn?\"\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/1a/2b/2c/865e2081c3e3f6d186a18613e788e87c.jpg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/1a/2b/2c/865e2081c3e3f6d186a18613e788e87c.jpg\" alt=\"\" width=\"750\" height=\"499\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/e2/af/c4/738c5df420ef9232b4d9d07d088349ce.jpg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/e2/af/c4/738c5df420ef9232b4d9d07d088349ce.jpg\" alt=\"\" width=\"750\" height=\"499\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/05/04/73/ea4feb6203cca22d6094e8fa9e44c4d4.jpg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/05/04/73/ea4feb6203cca22d6094e8fa9e44c4d4.jpg\" alt=\"\" width=\"750\" height=\"499\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/0a/92/4d/a508463750a57e5406e42632854892b9.jpg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/0a/92/4d/a508463750a57e5406e42632854892b9.jpg\" alt=\"\" width=\"750\" height=\"499\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e“SẮC MÀU CỦA GIỌT NƯỚC”\u003c/strong\u003e: Cuốn sách là hành trình đi tìm giá trị đích thực của bản thân mình với nhân vật chính là bạn Giọt Nước. Sinh ra từ mẹ Biển Cả, cứ ngỡ mình có màu xanh dương bất tận giống mẹ, nhưng thật ra Giọt Nước lại mang trong mình màu trong vắt. Từ đó nó bắt đầu một chuỗi hành trình đi tìm lại màu sắc của chính mình. Sau thất vọng trước những màu sắc rực rỡ nhưng không thuộc về mình, Giọt Nước đã tự hào nhận ra mình mang sắc màu của tất cả vạn vật trên thế giới này.\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/27/0f/83/a7339c4aafef04f5d0833bd462f23910.jpg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/27/0f/83/a7339c4aafef04f5d0833bd462f23910.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/a6/e1/cb/785f0ba25f464004c8e54fd32b4a3bbb.jpg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/a6/e1/cb/785f0ba25f464004c8e54fd32b4a3bbb.jpg\" alt=\"\" width=\"750\" height=\"499\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/8c/e3/76/b62eb74da00823adf98ac27d321a3f44.jpg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/8c/e3/76/b62eb74da00823adf98ac27d321a3f44.jpg\" alt=\"\" width=\"750\" height=\"499\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/3e/41/d8/3c6d7ba9282da4b30a1b85b463f3ab2f.jpg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/3e/41/d8/3c6d7ba9282da4b30a1b85b463f3ab2f.jpg\" alt=\"\" width=\"750\" height=\"499\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh