o loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ce/47/23/82fa8f03d63d088aa9980268c590fcf6.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ce/47/23/82fa8f03d63d088aa9980268c590fcf6.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ce/47/23/82fa8f03d63d088aa9980268c590fcf6.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ce/47/23/82fa8f03d63d088aa9980268c590fcf6.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ce/47/23/82fa8f03d63d088aa9980268c590fcf6.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/4e/2d/5a/07d4c42454759f82b0f6ab0e473ea58e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/4e/2d/5a/07d4c42454759f82b0f6ab0e473ea58e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/4e/2d/5a/07d4c42454759f82b0f6ab0e473ea58e.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4e/2d/5a/07d4c42454759f82b0f6ab0e473ea58e.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4e/2d/5a/07d4c42454759f82b0f6ab0e473ea58e.jpg"}],"warranty_policy":null,"authors":[{"id":191131,"name":"Thomas J Stanley","slug":"thomas-j-stanley"},{"id":8226978,"name":"William D Danko","slug":"william-d-danko"}],"current_seller":{"id":172838,"sku":"6527259463327","name":"NhatPhatbooks","link":"https://tiki.vn/cua-hang/nhatphatbooks","logo":"b4/d0/7e/d57aa44f57e010afead806f9de1a411c.jpg","price":88000,"product_id":"93268576","store_id":159874,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[{"id":127989,"name":"Times Books","link":"https://tiki.vn/cua-hang/times-books","logo":"a6/11/12/d2b1e40937a3