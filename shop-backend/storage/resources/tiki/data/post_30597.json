/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/2b/0f/3d/9dc9a4361b52402ce23b2ee25189b0ce.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1814,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"font-weight: 400;\"\u003e\u003cstrong style=\"font-weight: 500;\"\u003eSữa rửa mặt chiết xuất từ gạo Hàn Quốc cao cấp cho da nhạy cảm 3W Clinic Brown Rice Foam Cleansing (100ml) – Hàng chính hãng\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"font-weight: 400;\"\u003e\u003cstrong style=\"font-weight: 500;\"\u003eLàm sạch sâu, ngừa mụn, sáng da\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"font-weight: 400;\"\u003e\u003cstrong style=\"font-weight: 500;\"\u003e \u003cimg src=\"https://salt.tikicdn.com/ts/tmp/e1/8e/45/e72ba8134282905c6a436626ab7d06fa.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"font-weight: 400;\"\u003eSữa rửa mặt 3W Clinic chiết xuất từ gạo an toàn với mọi làn da, sản phẩm cao cấp của nhãn hàng 3W Clinic. Đặc biệt sữa rửa mặt có hiệu quả với các vùng da bị nám, tàn nhang, đồi mồi…\u003c/p\u003e\n\u003cp style=\"font-weight: 400;\"\u003eThành phần chính từ gạo giúp lấy sạch hoàn toàn bụi bẩn và bã nhờn sâu trong lỗ chân lông, đồng thời làm sáng da nhờ dẫn xuất tinh khiết từ nước gạo , cho làn da thực sự sạch, sáng khỏe. dễ tạo bọt, tạo cảm giác trơnláng, mềm mịn sau khi rửa mặt. Cách dùng: Lấy 1 lượng sản phẩm vừa đủ, dùng nước để tạo bọt trên tay, không nên tạo bọt trực tiếp trên bề mặt da, sau đó rửa mặt nhẹ nhàng theo chiều cấu tạo da, thời gian rửa mặt tối đa là 1 phút. Thích hợp cho mọi người.\u003c/p\u003e\n\u003cp style=\"font-weight: 400;\"\u003eXuất xứ: Hàn Quốc\u003c/p\u003e\n\u003cp style=\"font-weight: 400;\"\u003eNhãn hiệu: 3W Clinic\u003c/p\u003e\n\u003cp style=\"font-weight: 400;\"\u003eQuy cách: Tuýp 100ml\u003c/p\u003e\n\u003cp style=\"font-weight: 400;\"\u003ePhụ nữ xưa hay dùng nước vo gạo lần 1 (đối với gạo mới) và nước vo gạo lần 2 (đối với gạo cũ) để rửa mặt mỗi ngày. Vitamin B1, B3 và B5 hoàn toàn tinh khiết sẽ giúp làm sáng và mịn da, đơn giản, an toàn mà hiệu quả. Nay thì bạn hoàn toàn có thể thay thế nước vo gạo bằng sản phẩm công nghệ cao\u003c/p\u003e\n\u003cp style=\"font-weight: 400;\"\u003eThành phần có trong Brown Rice Foam Cleansing: Nước gạo tinh khiết làm sạch bụi bẩn và bã nhờn sâu trong lỗ chân lông, đồng thời làm sáng da, cho làn da thực sự sạch, sáng khỏe, tạo cảm giác trơn láng, mềm mịn sau khi rửa mặt\u003c/p\u003e\n\u003cp style=\"font-weight: 400;\"\u003eSữa rửa mặt gạo Brown Rice Foam Cleansing đặc biệt ăn toàn cho mọi làn da, chăm sóc và phục hồi sức sống cho da hiệu quả, đặc biệt là vùng da bị tàn nhang nám, đồi mồi, mang lại cho bạn làn da như mơ ước.\u003c/p\u003e\n\u003cp style=\"font-weight: 400;\"\u003e\u003cstrong style=\"font-weight: 500;\"\u003eCông dụng:\u003c/strong\u003e\u003c/p\u003e\n\u003cul style=\"font-weight: 400;\"\u003e\n\u003cli\u003eThành phần thiên nhiên từ gạo qua quá trình lựa chọn và sàng lọc với công nghệ hiện đại\u003c/li\u003e\n\u003cli\u003eVitamin B1, B3 và B5 hoàn toàn tinh khiết sẽ giúp làm sáng và mịn da, đơn giản, an toàn mà hiệu quả\u003c/li\u003e\n\u003cli\u003eGiúp lấy sạch hoàn toàn bụi bẩn và bã nhờn sâu trong lỗ chân lông, đồng thời làm sáng da\u003c/li\u003e\n\u003cli\u003eSản phẩm dễ dàng tạo bọt, tạo cảm giác trơn láng, mềm mịn sau khi rửa mặt\u003c/li\u003e\n\u003cli\u003eKhông gây dị ứng, an toàn, phù hợp với mọi loại da\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/7d/ba/08/7557fdcdfc1d123d85f9e1558b1fcb54.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"font-weight: 400;\"\u003e\u003cstrong style=\"font-weight: 500;\"\u003eCách dùng:\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"font-weight: 400;\"\u003eVới sữa rửa mặt gạo Brown Rice Foam Cleansing, ta lấy 1 lượng sản phẩm vừa đủ, dùng nước để tạo bọt trên tay, không nên tạo bọt trực tiếp trên bề mặt da, massage nhẹ nhàng theo chuyển động tròn để các dưỡng chất trong sữa rửa mặt có thể thấm sâu vào bên trong da, sau đó rửa mặt nhẹ nhàng theo chiều cấu tạo da, thời gian rửa mặt tối đa là 1 phút.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/2b/0f/3d/9dc9a4361b52402ce23b2ee25189b0ce.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/2b/0f/3d/9dc9a4361b52402ce23b2ee25189b0ce.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/2b/0f/3d/9dc9a4361b52402ce23b2ee25189b0ce.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2b/0f/3d/9dc9a4361b52402ce23b2ee25189b0ce.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2b/0f/3d/9dc9a4361b52402ce23b2ee25189b0ce.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/6d/0e/b7/17f1bae7b7840cb06f642da5a7bd8a72.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cach