ẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/15/fd/12/5307e795684e48f4260fb3b9dc5b8c63.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/15/fd/12/5307e795684e48f4260fb3b9dc5b8c63.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/15/fd/12/5307e795684e48f4260fb3b9dc5b8c63.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/15/fd/12/5307e795684e48f4260fb3b9dc5b8c63.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/15/fd/12/5307e795684e48f4260fb3b9dc5b8c63.jpg"}],"warranty_policy":null,"authors":[{"id":437737,"name":"Mai Lan Hương , Nguyễn Thị Thanh Tâm","slug":"mai-lan-huong-nguyen-thi-thanh-tam"}],"current_seller":{"id":670,"sku":"6991999303063","name":"Cá Chép Bookstore","link":"https://tiki.vn/cua-hang/ca-chep-bookstore","logo":"0a/89/1c/28dd476ede7a32391ad449d0f0c9c403.jpg","price":54150,"product_id":"263863772","store_id":633,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Thông tin chung","attributes":[{"code":"publisher_vn","name":"Công ty phát hành","value":"Zenbooks"},{"code":"book_cover","name":"Loại bìa","value":"Bìa mềm"},{"code":"manufacturer","name":"Nhà xuất bản","value":"Nhà Xuất Bản Đà Nẵng"}]}],"product_links":[],"gift_item_title":"0 quà tặng kèm","configurable_options":[{"code":"option1","name":"Tùy chọn","position":0,"show_preview_image":false,"values":[{"label":"Không đáp án"}]}],"configurable_products":[{"child_id":263863771,"discount_rate":5,"id":263863772,"images":[{"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/15/fd/12/5307e795684e48f4260fb3b9dc5b8c63.jpg","medium_url":"https://salt.tikicdn.com/cache/550x550/ts/product/15/fd/12/5307e795684e48f4260fb3b9dc5b8c63.jpg","small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/15/fd/12/5307e795684e48f4260fb3b9dc5