ng","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.7,"review_count":56,"review_text":"(56)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/0b/e8/f5/3d55fae0510bdec4dc80c2a37a757d66.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1399,"all_time_quantity_sold":183,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eGiới thiệu lá sen nguyên chất Đồng Tháp\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eLá sen (tên đông Y là hà diệp) từ lâu được xem là loại dược liệu giúp giảm cân, giảm mất ngủ, giảm mỡ máu… Từ xưa, người Việt đã biết cách phơi khô lá sen để hãm trà uống. Tuy nhiên, lá sen có kích thước lớn nên nếu phơi khô mà bảo quản không đúng cách rất dễ ẩm mốc trong điều kiện nóng ẩm.\u003c/p\u003e\n\u003cp\u003eLá sen đạt chuẩn phải là lá bánh tẻ lớn, xanh đậm, không quá non hay quá già, không bị sâu hại bởi lá non làm giảm hương vị trà, trong khi lá già ảnh hưởng đến chất lượng dược liệu. Lá thu hoạch vào sáng sớm sẽ còn độ tươi nên khi mang về cơ sở chế biến vẫn giữ nguyên mùi thơm ngan ngát đặc trưng của nhựa sen.\u003c/p\u003e\n\u003cp\u003eHiện nay, chúng tôi cung cấp lá sen bánh tẻ khô, được thu hái tại các đầm sen đẹp nhất Việt Nam, vùng Ba Tre, Tỉnh Đồng Tháp. Sản phẩm sạch sẽ và chất lượng rất tốt. Bảo đảm an toàn cho sức khỏe người sử dụng.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCông dụng chính của trà lá sen\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Hạ mỡ máu, giảm mỡ trong cơ thể, phòng ngừa và hỗ trợ điều trị chứng bệnh béo phì.\u003c/p\u003e\n\u003cp\u003e- Phòng trị chảy máu não và các biến chứng kèm theo ở bệnh nhân tăng huyết áp.\u003c/p\u003e\n\u003cp\u003e- Phòng và găn ngừa xơ vữa động mạch, giúp phòng ngừa và hỗ trợ điều trị bệnh mạch vành tim và viêm túi mật.\u003c/p\u003e\n\u003cp\u003e- Làm mát gan, tăng cường chức năng gan. Hỗ trợ điều trị người mắc bệnh gan nhiễm mỡ.\u003c/p\u003e\n\u003cp\u003e- Giúp tăng lưu lượng tuần hoàn não, giảm căng thẳng, mệt mỏi, an thần giúp giấc ngủ sâu và ngon giấc.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThành phần:\u003c/strong\u003e 100% lá sen nguyên chất.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCách dùng:\u003c/strong\u003e Mỗi ngày dùng 15-20g trà lá sen đun sôi với 1-2 lít nước, để nguội thay nước lọc hàng ngày, ngon hơn khi uống lạnh.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eNguồn gốc\u003c/strong\u003e: Ba Tre, Đồng Tháp.\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cstrong\u003eLưu ý:\u003c/strong\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eSử dụng nước Trà lá sen thay nước lọc hàng ngày ngày, nếu thấy có vị hơi đắng thì có thể pha loãng trà lại một chút hoặc uống với đá lạnh hoặc để nước trà trong tủ lạnh là tốt nhất.\u003c/li\u003e\n\u003cli\u003eSử dụng trà liên tục trong thời gian khoảng 30 ngày sẽ cảm nhận được hiệu quả của loại trà thảo dược từ thiên nhiên này.\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/0b/e8/f5/3d55fae0510bdec4dc80c2a37a757d66.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0b/e8/f5/3d55fae0510bdec4dc80c2a37a757