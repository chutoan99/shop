s://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/4b/11/b3/4b643187dc42ca9fa0cc742528347480.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1597,"all_time_quantity_sold":13,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003eGiới thiệu\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003e\"Bầu bí cũng muốn mình xinh đẹp mọi lúc mọi nơi và dùng đồ gì cũng phải đọc kỹ thành phần vì sợ thành phần hóa chất ảnh hưởng đến em bé\". Có mẹ bầu nào có suy nghĩ giống mình không?\u003c/li\u003e\n\u003cli\u003eAi đã và đang có bầu có đang bị tình trạng: Tóc rụng, khô xơ, da xạm màu, người mệt mỏi mỏi.... không?\u003c/li\u003e\n\u003cli\u003eNhiều khi muốn sử dụng son môi, sữa rửa mặt, dầu gội đầu,... mà sợ có hóa chất, ảnh hưởng đến em bé.\u003c/li\u003e\n\u003cli\u003eTừ nay, các mẹ không phải lo nhé vì đã có sản phẩm thiên nhiên của Cỏ cây hoa lá, an toàn tuyệt đối cho mẹ bầu và con nhỏ.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e#COMBO thiên nhiên dành cho #mẹ_bầu \u0026amp; sau sinh:\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/94/6d/86/4e7120f88a0609dcb51712b4edc064e6.jpg\" alt=\"\" width=\"750\" height=\"585\" /\u003e\u003c/p\u003e\n\u003ch3\u003eƯu điểm nổi bật\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eDầu gội gừng giúp mượt mà, hỗ trợ trị gàu, điều hòa lưu thông máu dưới da đầu.\u003c/li\u003e\n\u003cli\u003eSữa rửa mặt GoBo hỗ trợ trị nám, tàn nhang, săn chắc cơ mặt.\u003c/li\u003e\n\u003cli\u003eSữa tắm thảo dược gừng nghệ phòng cảm tránh gió dưỡng da giúp mẹ hạ thổ sau sinh (cực kỳ tốt).\u003c/li\u003e\n\u003cli\u003eDung dịch vệ sinh phụ nữ Gel X2 Nano Gel: hỗ trợ điều trị #ngứa, viêm giúp cô bé hồng xinh se khít.\u003c/li\u003e\n\u003cli\u003eCác mẹ yên tâm sử dụng sản phẩm nhà Lá vì sản phẩm thiên nhiên, không hóa chất nhé!\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e---------------------\u003c/p\u003e\n\u003ch3\u003eDẦU GỘI GỪNG - SỮA TẮM GỪNG SỰ LỰA CHỌN HÀNG ĐẦU CHO MẸ SAU SINH\u003c/h3\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/7f/55/25/1051bb33e94c12c7f48d3bd7c4521e99.jpg\" alt=\"\" width=\"750\" height=\"574\" /\u003e\u003c/p\u003e\n\u003cp\u003e️ Mang thai là một hành trình đầy gian nan và vất vả của người mẹ. Khi sinh con ra mẹ phải trải qua những cơn đau dữ dội, mất máu nhiều làm cho cơ thể người mẹ trở nên yếu ớt. Sau sinh chỉ cần có một cơn gió nhẹ thoảng thổi qua đã làm cho mẹ cảm thấy lạnh buốt người đầu óc quay cuồng.\u003c/p\u003e\n\u003cp\u003eGừng tươi có chứa hợp chất kháng viêm, làm ấm cơ thể, kích thích tuần hoàn máu. Sử dụng Gừng để gội đầu không chỉ làm sạch da đầu, còn kích thích cho việc phát triển của tóc, phòng ngừa các bệnh về da đầu.\u003c/p\u003e\n\u003cp\u003eDầu gội Gừng còn nguyên xơ Gừng trong chai dầu, khi gội sẽ có cảm giác ấm da đầu, giảm rụng tóc sau sinh và kích thích mọc tóc. Giữ nguyên vẹn mọi tác dụng của Gừng\u003c/p\u003e\n\u003cp\u003eTắm Sữa tắm Gừng có tác dụng làm giảm mụn trên da, làm da khỏe mạnh. Bên cạnh đó, với khả năng kích thích ra mồ hôi, tắm Sữa tắm Gừng còn giúp đẩy mạnh quá trình giải độc cơ thể. Một lợi ích cộng thêm đó là loại bỏ mùi hôi cơ thể, cho cảm giác sảng khoái và dịu cơn đau đầu.\u003c/p\u003e\n\u003cp\u003eSữa tắm Gừng Nghệ còn giúp làm sáng da, mờ vết thâm rạn trên da sau sinh. Đặc biệt giữ ấm cơ thể , phòng cảm tránh gió cho mẹ bầu và sau sinh sức đề kháng yếu.\u003c/p\u003e\n\u003cp\u003e------------------------\u003c/p\u003e\n\u003cp\u003eVì sao  là “bảo bối vùng kín” cho chị em có bầu và sau sinh\u003c/p\u003e\n\u003cp\u003eNano Nghệ giúp âm đạo không bị khô, luôn thoáng mát, dễ chịu suốt cả ngày\u003c/p\u003e\n\u003cp\u003eBerberin Clohydrat giúp ngăn ngừa nhiễm nấm, kháng khuẩn\u003c/p\u003e\n\u003cp\u003eGel vệ sinh còn được chiết xuất từ 8 thành phần thảo dược thiên nhiên khác giúp làm mờ vết thâm, săn chắc và hồng hào vùng kín cho chị em.\u003c/p\u003e\n\u003cp\u003eKhả năng cân bằng nội tiết tố trong Gel vệ sinh X2 Nano Nghệ không chỉ giúp “vùng kín” luôn đẹp, khỏe mà còn giúp phòng tránh những tác hại mà thời kỳ tiền mãn kinh, mãn kinh gây ra như: bốc hỏa, mất ngủ, đổ mồ hôi đêm, tóc rụng, nám da, béo bụng, loãng xương…để chị em luôn trẻ trung, quyến rũ và tự tin chinh phục bạn đời.\u003c/p\u003e\n\u003cp\u003e Gel vệ sinh phụ nữ X2 Nano Nghệ được T.O.P 10 bác sĩ sản - phụ khoa hàng đầu Việt Nam khuyên dùng, tự hào là sản phẩm chăm sóc sức khỏe phụ nữ Việt.\u003cbr /\u003e 95% khách hàng sử dụng hài lòng và muốn quay trở lại mua hàng lần hai.\u003c/p\u003e\n\u003cp\u003e--------------------------\u003c/p\u003e\n\u003cp\u003e️Sữa rửa mặt GOBO - Sạch sâu, sáng da, săn gọn cơ mặt.\u003c/p\u003e\n\u003cp\u003eSạch sâu với chiết xuất từ rễ cây ngưu bàng quý hiếm, loại bỏ dầu thừa và các bụi bẩn, len lỏi vào sâu lỗ chân lông để diệt khuẩn.\u003cbr /\u003eSáng da với nghệ và mật ong, dưỡng da, cân bằng độ PH một cách nhẹ nhàng, hiệu quả.\u003cbr /\u003eThon gọn cơ mặt nhờ các tinh chất thành phần tổng hợp, kết hợp với miếng pad rửa mặt giúp làn da được massage nhẹ nhàng, nâng cơ.\u003c/p\u003e\n\u003cp\u003eVới những thành phần hoàn toàn từ thiên nhiên, lành tính và an toàn với mọi loại da, an toàn với mẹ bầu và sau sinh.\u003c/p\u003e\n\u003cp\u003eGOBO tự tin trong việc bảo vệ làn da việt️\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/4b/11/b3/4b643187dc42ca9fa0cc742528347480.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/4b/11/b3/4b643187dc42ca9fa0cc742528347480.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/4b/11/b3/4b643187dc42ca9fa0cc742528347480.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4b/11/b3/4b643187dc42ca9fa0cc742528347480.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4b/11/b3/4b643187dc42ca9fa0cc742528347480.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/7e/4c/c8/c86dac033a522e53ba58579e8b59cdaa.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/7e/4c/c8/c86dac033a522e53ba58579e8b59cdaa.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/7e/4c/c8/c86dac033a522e53ba58579e8b59cdaa.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7e/4c/c8/c86dac033a522e53ba58579e8b59cdaa.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7e/4c/c8/c86dac033a522e53ba58579e8b59cdaa.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/05/7d/29/60f7010c53e84416fac0573a0f5ca8ad.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/05/7d/29/60f7010c53e84416fac0573a0f5ca8ad.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/05/7d/29/60f7010c53e84416fac0573a0f5ca8ad.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/05/7d/29/60f7010c53e84416fac0573a0f5ca8ad.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/05/7d/29/60f70