ext":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/aa/01/e0/892b12d1de871cb5905545cf82fa5749.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1037,"all_time_quantity_sold":6,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<h1>Flow - Dòng Chảy</h1>\n<p>Tiến sĩ tâm lý học người Mỹ gốc Hungary Mihaly Csikszentmihalyi đã từng tạo nên tiếng vang với nghiên cứu về “trải nghiệm tối ưu” của mình, hay còn gọi là “dòng chảy”. Trạng thái này diễn ra khi tâm và trí ta chìm đắm hoàn toàn vào hành động mà bản thân đang thực hiện. Đặc biệt, điều này đến từ cách chúng ta chủ động sắp xếp ý thức của mình, chứ chẳng phải là một trải nghiệm bị động.</p>\n<p><em>“Trải nghiệm tối ưu là thứ gì đó chúng ta chủ động làm cho nó xảy ra… Trải nghiệm tối ưu mang đến một cảm giác tự chủ - hoặc có thể tốt hơn là một cảm giác tham gia vào việc quyết định nội hàm của cuộc sống - điều gắn với những gì được cho là hạnh phúc hơi bất kỳ điền gì khác chúng ta có thể tưởng tượng ra về nó”</em> - trích trong cuốn sách “Dòng chảy”</p>\n<p>Thay vì trình bày một danh sách những thứ nên và không nên làm, cuốn sách “Dòng chảy” này lại đem đến cho độc giả một chuyến du hành qua các lãnh địa của tâm trí, với tấm bản đồ được vẽ bởi các công cụ khoa học. Giống như mọi cuộc phiêu lưu đáng giá, chuyến du hành này sẽ không hề dễ dàng, nhưng nó sẽ giúp bạn đạt được hạnh phúc thông qua sự kiểm soát đời sống nội tại của chính mình.</p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/aa/01/e0/892b12d1de871cb5905545cf82fa5749.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/aa/01/e0/892b12d1de871cb5905545cf82fa5749.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/aa/01/e0/892b12d1de871cb5905545cf82fa5749.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/aa/01/e0/892b12d1de871cb5905545cf82fa5749.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/aa/01/e0/892b12d1de871cb5905545cf82fa5749.jpg"}],"warranty_policy":null,"authors":[{"id":12958,"name":"Mihaly Csikszentmihalyi","slug":"mihaly-csikszentmihalyi"}],"current_seller":{"id":124753,"sku":"2887850872941","name":"Hiệu Sách Tự Do","link":"https://tiki.vn/cua-hang/hieu-sach-tu-do","logo":"98/02/ca/f5c52e12e6791bfc7ad8172c443ce2b7.jpg","price":228000,"product_id":"212922496","store_id":115284,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[{"id":2918,"name":"First News","link":"https://tiki.vn/cua-hang/first-news","logo":"22/27/4f/bd8035ded7b80defcc29420662d7e8c3.jpg","price":171000,"product_id":"138488350","store_id":2870},{"id":54507,"name":"BOOKCITY.VN","link":"https://tiki.vn/cua-hang/bookcity-vn","logo":"https://vcdn.tikicdn.com/ts/seller/ae/39/78/e802f9672f2da7e8c12fb85a33899be6.jpg","price":228000,"product_id":"141688750","store_id":51746},{"id":7247,"name":"Alpha Books Official","link":"https://tiki.vn/cua-hang/alphabooks-official","logo":"38/74/f3/f9cf41005697c643397d9b09d335f4c4.jpg","price":193000,"product_id":"173462752","store_id":7082},{"id":97533,"name":"Nhà Sách Vĩnh Thụy","link":"https://tiki.vn/cua-hang/nha-sach-vinh-thuy","l