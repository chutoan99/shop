n_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":63000,"discount_rate":35,"rating_average":4.3,"review_count":13,"review_text":"(13)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/87/86/c1/1e6ad1faf60536972b93a104a4a1a52e.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1707,"all_time_quantity_sold":91,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eTHÔNG TIN SẢN PHẨM BỘT HÚNG QUẾ:\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003e- Khối lượng: 72g (24 gói x 3g).\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e- Thành phần: 100% nguyên chất từ rau húng quế.\u003c/p\u003e\n\u003cp\u003e- Xuất xứ: Việt Nam.\u003c/p\u003e\n\u003cp\u003e- NSX và HSD: Xem trên bao bì (18 tháng kể từ ngày sản xuất).\u003c/p\u003e\n\u003cp\u003eLưu ý: Không sử dụng sản phẩm đã hết hạn. Sản phẩm này không phải là thuốc và không có tác dụng thay thế thuốc chữa bệnh\u003c/p\u003e\n\u003cp\u003eBảo quản: Nơi khô ráo, thoáng mát. Tránh ánh nắng trực tiếp.\u003c/p\u003e\n\u003cp\u003e--------------------------------------------------------------\u003c/p\u003e\n\u003cp\u003eHƯỚNG DẪN SỬ DỤNG BỘT HÚNG QUẾ:\u003c/p\u003e\n\u003cp\u003e- Cho gói bột húng quế (3g) vào 60ml - 85ml nước ấm (có thể gia giảm lượng nước theo ý thích). Khuấy đều và thưởng thức.\u003c/p\u003e\n\u003cp\u003eCó thể cho thêm đường vào để dễ uống và ngon hơn.\u003c/p\u003e\n\u003cp\u003e- Ngoài ra, bột húng quế còn dùng trong các món soup, cháo để bổ sung dinh dưỡng… và nhiều công thức khác.\u003c/p\u003e\n\u003cp\u003e--------------------------------------------------------------\u003c/p\u003e\n\u003cp\u003eCÔNG DỤNG CỦA BỘT HÚNG QUẾ:\u003c/p\u003e\n\u003cp\u003e- Bột húng quế giúp trị chứng khó tiêu, đầy hơi, rối loạn dạ dày, cho hệ tiêu hóa khỏe mạnh hơn.\u003c/p\u003e\n\u003cp\u003e- Giúp tăng cường hệ miễn dịch cơ thể.\u003c/p\u003e\n\u003cp\u003e- Giúp giảm cholesterol xấu trong cơ thể, giảm nguy cơ đột quỵ, tốt cho tim mạch.\u003c/p\u003e\n\u003cp\u003e- Giúp cải thiện tình trạng đau đầu, giảm căng thẳng, mệt mỏi, cải thiện chứng trầm cảm.\u003c/p\u003e\n\u003cp\u003e- Hỗ trợ ổn định đường huyết trong cơ thể, giảm nguy cơ tiểu đường.\u003c/p\u003e\n\u003cp\u003e- Phòng ngừa ung thư.\u003c/p\u003e\n\u003cp\u003e- Rất tốt cho da và tóc.\u003c/p\u003e\n\u003cp\u003e-------------------------------------------------------------\u003c/p\u003e\n\u003cp\u003eƯU ĐIỂM SẢN PHẨM:\u003c/p\u003e\n\u003cp\u003e- Nguồn nguyên liệu thiên nhiên được tuyển chọn khắt khe.\u003c/p\u003e\n\u003cp\u003e- Nguyên chất 100% từ rau húng quế.\u003c/p\u003e\n\u003cp\u003e- Cam kết: Không thêm phụ gia - Không sử dụng chất bảo quản.\u003c/p\u003e\n\u003cp\u003e- Bột có độ mịn cao 120 – 150 mesh\u003c/p\u003e\n\u003cp\u003e- Sản phẩm đạt tiêu chuẩn an toàn quốc tế ISO 22000:2018 và VSATTP, đã được xuất khẩu đi nhiều nước khó tính: Úc, Mỹ, Hàn Quốc, Nhật Bản, Đức, Hong Kong, Singapore…\u003c/p\u003e\n\u003cp\u003e- Hệ thống máy móc hiện đại giúp giữ trọn thành phần dinh dưỡng từ trái bí đỏ.\u003c/p\u003e\n\u003cp\u003e- Đóng gói túi nhỏ tiện dụng cho mỗi lần sử dụng.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/87/86/c1/1e6ad1faf60536972b93a104a4a1a52e.jpg","is_gall