":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/8b/f4/09/a3f5f75cff6f977ff9db96e53fd8b5b2.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":998,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p><em><strong>Gel Rửa Mặt Sạch Sâu Giảm Dầu Vichy Normaderm Phytosolution</strong></em><br />Lần đầu tiên từ Vichy xuất hiện Sữa rửa mặt dạng gel giúp làm sạch sâu và giảm dầu trên da Vichy Normaderm Phytosolution Intensive Purifying Gel chứa các khoáng chất quý hiếm từ nguồn khoáng Vichy và các thành phần giúp làm giảm mụn như: Zinc oxide, Copper, Salicylic acid, Bifidus P Sản phẩm đã được kiểm nghiệm lâm sàng và được chứng minh có tác dụng giảm mụn đầu đen, mụn sưng viêm, hạn chế tiết dầu hiệu quả. Đây chính là lựa chọn hoàn hảo cho làn da tinh khiết, không còn nỗi lo về mụn. </p>\n<p><img style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/product/70/26/89/ee4dbf7f7dd140c1c221cd7f5032b458.jpg\" width=\"511\" height=\"511\" /></p>\n<p><strong>Loại sản phẩm: </strong></p>\n<p>Sữa rửa mặt dạng gel giúp làm sạch sâu, giảm dầu trên da </p>\n<p><strong>Loại da phù hợp: </strong></p>\n<p>Mọi loại da, đặc biệt là da mụn, da nhạy cảm. </p>\n<p><strong>Độ an toàn </strong></p>\n<p>- Không parapen, không alcohol </p>\n<p>- Được kiểm nghiệm da liễu </p>\n<p>- Không gây kích ứng, không gây khô da </p>\n<p>- An toàn cho da nhạy cảm </p>\n<p><strong>Thành phần:</strong></p>\n<p>- Zinc oxide: kháng khuẩn và kháng viêm</p>\n<p>- Copper: điều tiết bã nhờn</p>\n<p>- Salicylic acid: thanh lọc da, giảm dày sừng nang lông tuyến bã</p>\n<p>- Bifidus Probiotics: Củng cố hàng rào bảo vệ da</p>\n<p><img style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/82/50/f5/df79a8313298d8c1d9646ae9c1331b14.jpg\" width=\"750\" height=\"750\" /></p>\n<p><strong>Công dụng </strong></p>\n<p>- Làm sạch sâu, giảm bã nhờn, không gây tổn hại đến da</p>\n<p>- Không làm khô da</p>\n<p>- Kiểm soát dầu, ngăn mụn tái phát</p>\n<p>- Giảm mụn đầu đen, mụn ẩn, mụn trứng cá</p>\n<p>- Giảm mụn sưng viêm</p>\n<p>- Thu nhỏ kích thước lỗ chân lông</p>\n<p><strong>Hướng dẫn sử dụng</strong></p>\n<p>- Sử dụng sáng và tối. Lấy một lượng sản phẩm vừa đủ rồi nhẹ nhàng massage mặt theo hình tròn, hướng lên trên.</p>\n<p>- Rửa sạch bằng nước lạnh hoặc nước ấm</p>\n<p>- Để có kết quả tốt nhất, hãy dùng kèm kem dưỡng ẩm Normaderm</p>\n<p>- Phytosolution Double-Correction Daily Care.</p>\n<p><strong>THÔNG TIN THƯƠNG HIỆU </strong></p>\n<p>Vichy là thương hiệu nổi tiếng của Pháp được thành lập vào năm 1931 tại thành phố cùng tên Vichy bởi bác sĩ da liễu Haller và nhà kinh doanh Guerin. Với nhiều năm kinh nghiệm, viện nghiên cứu Vichy đã sáng tạo ra nhiều phương thức mới và hiệu quả để chăm sóc sức khỏe làn da. Tất cả sản phẩm Vichy được kiểm nghiệm một cách toàn diện và khắt khe của chuyên gia da liễu về độ an toàn và dịu nhẹ cho da, đặc biệt đối với làn da nhạy cảm. Ngoài ra, các sản phẩm của Vichy đã được chứng minh không gây dị ứng, không gây mụn, chứa nước khoáng Vichy giàu khoáng chất có tác dụng củng cố và tăng cường tái tạo da. </p>\n<p><img style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/db/ce/bd/772c21c0c466b934365889d1f851e6cf.jpg\" width=\"750\" height=\"750\" /></p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/8b/f4/09/a3f5f75cff6f977ff9db96e53fd8b5b2.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/8b/f4/09/a3f5f75cff6f977ff9db96e53fd8b5b2.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/8b/f4/09/a3f5f75cff6f977ff9db96e53fd8b5b2.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8b/f4/09/a3f5f75cff6f977ff9db96e53fd8b5b2.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8b/f4/09/a3f5f75cff6f977ff9db96e53fd8b5b2.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/1e/1b/5b/cc4f891dfd4686fd478725b0769572dd.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/1e/1b/5b/cc4f891dfd4686fd478725b0769572dd.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/1e/1b/5b/cc4f891dfd4686fd478725b0769572dd.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1e/1b/5b/cc4f891dfd4686fd478725b0769572dd.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1e/1b/5b/cc4f891dfd4686fd478725b0769572dd.jpg"}],"warranty_policy":null,"brand":{"id":26689,"name":"VICHY","slug":"vichy"},"current_seller":{"id":883,"sku":"2356398900367","name":"Mỹ Phẩm N","link":"https://tiki.vn/cua-hang/my-pham-n-shop","logo":"6e/38/65/9613f19212fff24d33ecfe4c31f881b5.png","price":480000,"product_id":