e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.7,"review_count":81,"review_text":"(81)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/dd/f3/5c/ab1e94e4bede1d5c8a90558fc975c768.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1351,"all_time_quantity_sold":675,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eKhối lượng tịnh: 2kg\u003cbr /\u003eXuất xứ: Sóc Trăng, Việt Nam\u003cbr /\u003eNgày sản xuất: Xem trên bao bì\u003cbr /\u003eHạn sử dụng: 3 tháng kể từ ngày sản xuất\u003cbr /\u003eĐóng gói: Gói 2kg\u003cbr /\u003eThành phần: 100% gạo tím Sóc Trăng\u003cbr /\u003eSản xuất: DNTT Hồ Quang TríBảo quản: Nhiệt độ thường, tránh ánh nắng trực tiếp\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eGạo tím than là loại gạo chứa nhiều chất đạm ( trên 10% protein), lớp cám chứa rất nhiều Vitamin nhóm B. Mầm gạo chứa GABA - là chất giúp giảm nhẹ bệnh mất trí nhớ, làm lành các tổn thương ở gan và thận trong thời kì đầu, giảm bệnh cao huyết áp, tiểu đường. Nếu gạo đỏ chứa nhiều sắt thì gạo tím than chứa nhiều Calci hơn, giúp hạn chế loãng xương, mau lành xương bị gãy. Gạo không có tác dụng chữa bệnh mà chỉ có tác dụng hỗ trợ quá trình điều trị của bệnh nhân.\u003c/p\u003e\n\u003cp\u003e- Đặc biệt hàm lượng Anthocyanin trong gạo tím than rất cao (0,4%). Đây là chất chống oxy hóa mạnh, trung hòa các tác nhân gây ung thư, chất này cũng có công dụng kháng viêm, giảm acid uric trong máu. Có thể nấu riêng hoặc trộn với gạo đỏ để tăng hiệu lực phòng vệ của cơ thể. Liều lượng tùy theo sự trải nghiệm của từng người.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003eLỢI ÍCH SỨC KHỎE KHI ĂN GẠO LỨT TÍM THAN\u003cbr /\u003e- Chứa lượng chất chống oxy hóa cao giúp ngăn ngừa hoặc làm giảm nguy cơ phát triển của các bệnh ung thư hay bệnh tim\u003cbr /\u003e- Khả năng chống viêm\u003cbr /\u003e- Có lợi cho sức khỏe tim mạch và huyết áp\u003cbr /\u003e- Cải thiện tiêu hóa, giúp giảm cân hiệu quả\u003cbr /\u003e- Tốt cho sức khỏe của gan\u003cbr /\u003e- Điều chỉnh lượng đường trong máu, góp phần kiểm soát bệnh tiểu đường\u003cbr /\u003e- Cải thiện chức năng của não\u003cbr /\u003e- Giảm sự phát triển của tế bào ung thư\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eCÁCH NẤU CƠM GẠO LỨT TÍM THAN\u003cbr /\u003e- Vo gạo nhanh bằng nước sạch để tránh mất màu tím của gạo ( so với gạo lứt đỏ thì gạo lứt tím không cần ngâm trước do đặc tính của gạo là mềm dẻo, Chú ý cần vo gạo nhanh để tránh mất màu tím của gạo.)\u003cbr /\u003e- Nấu cơm theo tỷ lệ 1 gạo / 1,5 - 1,7 nước\u003cbr /\u003e- Nấu khoảng 1h - 1h30 để cơm chín đều\u003cbr /\u003e- Thưởng thức cơm khi còn nóng\u003c/p\u003e\n\u003cp\u003eNhai chậm và thưởng thức vị ngọt của cơm, mùi thơm đặc trưng của gạo lứt tím than.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/dd/f3/5c/ab1e94e4bede1d5c8a90558fc975c768.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/dd/f3/5c/ab1e94e4bede1d5c8a90558fc975c768.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/dd/f3/5c/ab1e94e4bede1d5c8a90558fc97