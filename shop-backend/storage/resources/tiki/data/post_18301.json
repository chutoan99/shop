14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":2900000,"discount_rate":15,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/e3/e3/d0/72966dfa27f0eaec1cc466b80df7c055.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":276,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2 align=\"center\"\u003e\u003cstrong\u003eLaptop Dell Vostro 3430 71011900 \u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003e\u003cstrong\u003eLaptop Dell Vostro 3430 71011900\u003c/strong\u003e là chiếc laptop mang kiểu dáng đặc trưng của phân khúc laptop văn phòng phù hợp cho nhiều đối tượng người dùng, đặc biệt là người dùng phổ thông. Sản phẩm ngoài sở hữu thiết kế trẻ trung, tối giản, thanh lịch thì còn được trang bị những linh kiện mới nhất cho hiệu năng mạnh mẽ cùng thiết kế bền bỉ, mẫu laptop Dell Vostro này chắc chắn sẽ là người bạn đồng hành đắc lực trong công việc cũng như cuộc sống bận rộn.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/65/34/4f/1e78dff62784b56f953a95a2184e3582.jpg\" alt=\"\" width=\"700\" /\u003e\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eThiết kế thanh lịch phù hợp người dùng phổ thông\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003e\u003cstrong\u003eLaptop Dell Vostro 3430 71011900\u003c/strong\u003e tuy sở hữu mức giá thuộc tầm trung nhưng được hãng chú trọng thiết kế đánh sâu vào độ bền với chất liệu cao cấp, bản lề cứng cáp, chắc chắn, khi đóng mở máy cho cảm giác rất chắc tay không hề ọp ẹp. Không chỉ đẹp về hình thức, độ bền bỉ của máy cũng được đánh giá cao khi có khả năng chống chịu các tác động của ngoại lực tốt, hạn chế hỏng hóc linh kiện khi bị va đập nên bạn có thể yên tâm sử dụng trong nhiều năm. \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/5a/c1/e3/1471bf64407027daba37f8e17656767c.jpg\" alt=\"\" width=\"700\" /\u003e\u003c/p\u003e\n\u003cp\u003eMang trên mình thiết kế đơn giản nhưng vẫn giữ cho mình sự tinh tế. Mặt lưng máy chống bám vân tay, các góc máy được bo tròn. Vỏ máy cứng nên có khả năng bảo vệ các linh kiện bên trong.\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eHiệu năng đáp ứng nhu cầu cho văn phòng hiện đại\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003eDell đã trang bị cho chiếc \u003cstrong\u003eLaptop Dell Vostro 3430 71011900\u003c/strong\u003e bộ vi xử lý thế hệ thứ 13 quá tuyệt vời cho chiếc máy tính học tập, làm việc văn phòng phổ thông. Với bộ vi xử lý Intel Core i5-1335U giúp xử lý mọi tác vụ siêu nhanh và chính xác để tối ưu hóa hiệu suất làm việc cho bạn.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/93/95/ca/c1826b2840cc5e3ab2fbc5c1ceb7de33.jpg\" alt=\"\" width=\"700\" /\u003e\u003c/p\u003e\n\u003cp\u003eMột con chip có giá thành cực kì phải chăng nhưng vẫn đảm bảo các tính năng và hiệu năng ổn định, giúp xử lý tốt đa dạng các nhu cầu cơ bản của người dùng: lướt web, xem video, sử dụng các ứng dụng văn phòng,\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/7b/27/41/98b8a3b424b86986d8026cc014334e3b.jpg\" alt=\"\" width=\"1000\" /\u003e\u003cbr /\u003e\u003cem\u003eKhả năng xử lý 1500 công thức trong Excel trong chỉ 74 giây\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003eNhờ được trang bị bộ nhớ trong 8GB DDR4 với tốc độ bus RAM 2666MHz \u003cstrong\u003eDell Vostro 3430 71011900\u003c/strong\u003e vẫn đảm bảo việc xử lý mượt mà, nhanh chóng, hạn chế giật lag nếu bạn không mở đồng thời quá nhiều tabs.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/85/51/25/185ddd7603542d94e3c7b2b665a01f5f.jpg\" alt=\"\" width=\"1000\" /\u003e\u003cem\u003e8GB RAM thực đảm bảo làm việc, lướt web mượt mà\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003eKhông chỉ có bộ nhớ RAM tốt, hãng còn trang bị 512GB mang đến khả năng lưu trữ khổng lồ cho mọi nhu cầu của bạn, đồng thời đem tới khả năng truy xuất dữ liệu siêu nhanh, khởi động máy tính chỉ trong vài giây.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/56/52/4b/ae80a519c21e100e469c63d18f475f25.jpg\" alt=\"\" width=\"700\" /\u003e\u003cem\u003eTốc độ đọc ghi ấn tượng\u003c/em\u003e\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eHình ảnh sắc nét với góc nhìn rộng\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003e\u003cstrong\u003eLaptop Dell Vostro 3430 71011900\u003c/strong\u003e sở hữu một chiếc màn hình tuyệt vời, bạn sẽ có những giây phút làm việc, giải trí tuyệt vời với không gian rộng rãi. Màn hình 14inch có độ phân giải Full HD góc rộng 178 độ cho hình ảnh được hiển thị sắc nét.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/ca/6c/a9/cd9906105973fbe4f65d4e0c1466e4a1.jpg\" alt=\"\" width=\"700\" /\u003e\u003c/p\u003e\n\u003cp\u003eCông nghệ LED Backlight được tích hợp trên Dell Vostro, mang đến khả năng hiển thị màu sắc tươi sáng, đẹp mắt và độ tương phản cao hơn, đồng thời mang đến khả năng tiết kiệm điện năng hiệu quả và vô cùng thân thiện với môi trường.\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eBàn phím, TouchPad tối ưu cho tác vụ văn phòng\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003eBàn phím chiclet trên \u003cstrong\u003eDell Vostro 3430 71011900\u003c/strong\u003e sở hữu bàn phím Fullsize thuận tiện cho tác vụ học tập, văn phòng với khoảng cách giữa các phím hợp lý, có độ sâu vừa phải độ nảy tốt và cho cảm giác thoải mái khi làm việc trong thời gian dài.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/3a/8b/e7/dc913461ca03dd1d7e4d5500c3221559.jpg\" alt=\"\" width=\"700\" /\u003e\u003c/p\u003e\n\u003cp\u003ePhần bàn phím của \u003cstrong\u003eDell Vostro 3430 71011900\u003c/strong\u003e cũng được thiết kế tối ưu cho nhập liệu, đồng thời có khu vực phím số riêng biệt, nâng cao năng suất làm việc của bạn. Về phần TouchPad được thiết kế tỉ mỉ mang tới thao tác mượt mà với nhiều ngón tay,  trải nghiệm nhanh nhạy và chuyên nghiệp.\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eKết nối đa dạng cho các tác vụ\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003eĐể phục vụ tốt cho các nhu cầu đa dạng của người sử dụng, \u003cstrong\u003eDell Vostro 3430 71011900\u003c/strong\u003e được trang bị khá đầy đủ các cổng kết nối bao gồm: \u003c/p\u003e\n\u003cp\u003e1 USB 3.2 Gen 1 port\u003cbr /\u003e1 USB 2.0 port\u003cbr /\u003e1 USB 3.2 Gen 1 Type-C port\u003cbr /\u003e1 USB 3.2 Gen 1 Type-C port with DisplayPort Alt Mode 1.4/Power Delivery \u003c/p\u003e\n\u003cp\u003eVà hai chuẩn kết nối không dây 802.11ac 1x1 WiFi, Bluetooth 5 cũng được hỗ trợ nhằm đảm bảo kết nối chặt chẽ với các thiết bị ngoại vi và duy trì ổn định tốc độ kết nối internet, tránh bị gián đoạn khi làm việc.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/63/04/58/c499dc7c322c8c270ee1f27bc67e45fb.jpg\" alt=\"\" width=\"700\" /\u003e\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eThời lượng sử dụng pin \u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003eĐi kèm với máy là viên pin 3 Cell, 41 Wh dù không phải là nổi bật nhưng với việc cung cấp năng lượng đáng kể cho màn hình kích thước 14inch thì khá là ổn áp, vẫn đáp ứng cho một cuộc họp kéo dài hay mang đi làm việc ở bên ngoài văn phòng của bạn.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa c