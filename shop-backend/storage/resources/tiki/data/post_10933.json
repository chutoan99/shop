ackground_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/f9/6f/b8/9c7bd9df6d46fb2114e8101d1d78e634.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1114,"all_time_quantity_sold":7,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p><em><strong>Chì Kẻ Mày The Nature Book Design Eyebrow Pencil 0.3g</strong></em></p>\n<p>Chì Kẻ Mày The Nature Book kẻ siêu êm, siêu mượt. Đầu chì dạng vát dễ kẻ tạo đường nét lông mày tinh tế, sắc nét và điều chỉnh dáng mày. Chì có 2 đầu, 1 đầu kẻ và 1 đầu chổi để chuốt và tạo hình.</p>\n<p><img style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/product/98/ac/79/0ee4a733b771e827bbaa0f75148b7914.jpg\" width=\"600\" height=\"525\" /></p>\n<h2>Đặc trưng</h2>\n<p>Chì kẻ mày The Nature Book với thiết kế 2 đầu: </p>\n<p>- 1 đầu chì mềm cực kỳ tiện lợi cho các bạn mới tập kẻ.</p>\n<p>- 1 đầu chổi dễ dàng tạo dáng mày và đều chỉnh màu sắc đậm nhạt.</p>\n<p> - Thành phần tự nhiên không gây kích ứng cho da.</p>\n<p>- Bản nâng cấp với nhiều màu sắc đậm nhạt khác nhau giúp tạo nên nhiều phong cách cho đôi mày đẹp mà vẫn tự nhiên như tiêu chí của các dòng Makeup:</p>\n<p>No 01 - Gray Brown (Nâu Xám)</p>\n<p>No 02 - Brown (Nâu)</p>\n<p>No 03 - Black Brown (Nâu Đen)</p>\n<p><img style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/product/15/72/8d/a8a6b41a7e775defa56da1d64bed2a11.jpg\" width=\"600\" height=\"402\" /></p>\n<h2>Công dụng chính</h2>\n<p>- Thiết kế 2 đầu chì-cọ tiện lợi</p>\n<p>- Đầu chì ngang dễ dàng trang điểm đa dạng dángchân mày</p>\n<p>- Đầu chổi mềm, thiết kế xoắn ốc giúp tán màu đều và tự nhiên</p>\n<p>- Chất chì kẻ mềm, mịn, độ lên màu chuẩn</p>\n<h2>Hướng dẫn sử dụng</h2>\n<p>- Dùng cọ xéo sử dụng màu để định hình khuôn chân mày</p>\n<p>- Tán màu chân mày đậm 1/3 đuôi chân mày và nhạt dần 2/3 đầu chân mày</p>\n<p>- Dùng cọ tròn chuốt đầu lông chân mày theo hướng đi lên</p>\n<p><img style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/product/d8/c7/82/e6f955ca26fcb9122ac0912bddd5fd0e.jpg\" width=\"600\" height=\"600\" /></p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/f9/6f/b8/9c7bd9df6d46fb2114e8101d1d78e634.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f9/6f/b8/9c7bd9df6d46fb2114e8101d1d78e634.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f9/6f/b8/9c7bd9df6d46fb2114e8101d1d78e634.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f9/6f/b8/9c7bd9df6d46fb2114e8101d1d78e634.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f9/6f/b8/9c7bd9df6d46fb2114e8101d1d78e634.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/3a/27/98/057748754a43b61236d2692740564bc1.jpg","is_gallery":true,"label":n