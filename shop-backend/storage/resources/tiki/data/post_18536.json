Content_caption\"\u003e\u003c/article\u003e\n\u003carticle class=\"featureContent_caption\"\u003e\u003c/article\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"featureContent_col-2\"\u003e\n\u003cdiv class=\"featureContent_col_wrap\"\u003e \u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/b5/26/79/4b3dd6b6e440b6ce6edc85ae665c955c.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b5/26/79/4b3dd6b6e440b6ce6edc85ae665c955c.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b5/26/79/4b3dd6b6e440b6ce6edc85ae665c955c.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b5/26/79/4b3dd6b6e440b6ce6edc85ae665c955c.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b5/26/79/4b3dd6b6e440b6ce6edc85ae665c955c.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/8e/4f/5d/7e2e643d4066998132fb4cb7cdbc3681.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/8e/4f/5d/7e2e643d4066998132fb4cb7cdbc3681.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/8e/4f/5d/7e2e643d4066998132fb4cb7cdbc3681.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8e/4f/5d/7e2e643d4066998132fb4cb7cdbc3681.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8e/4f/5d/7e2e643d4066998132fb4cb7cdbc3681.jpg"}],"warranty_policy":null,"brand":{"id":40722,"name":"Zojirushi","slug":"zojirushi"},"current_seller":{"id":55986,"sku":"4987215766848","name":"Estore VN","lin