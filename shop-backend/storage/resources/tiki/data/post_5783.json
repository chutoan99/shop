 hề có cảm giác bị giáo dục, bị dạy dỗ, mà trái lại càng thấy gần gũi, thân thươ\"\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eNhà nghiên cứu văn học Lã Thị Bắc Lý\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/media/catalog/product/k/v/kvh_tap_9_bo_day.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/k/v/kvh_tap_9_bo_day.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/k/v/kvh_tap_9_bo_day.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/k/v/kvh_tap_9_bo_day.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/k/v/kvh_tap_9_bo_day.jpg"}],"warranty_policy":null,"authors":[{"id":4107,"name":"Nguyễn Nhật Ánh","slug":"nguyen-nhat-anh"}],"current_seller":{"id":97533,"sku":"5058050631730","name":"Nhà Sách Vĩnh Thụy","link":"https://tiki.vn/cua-hang/nha-sach-vinh-thuy","logo":"19/f2/bd/8bda12adffb15edf1b3d8339b0238283.jpg","price":135000,"product_id":"212958652","store_id":90454,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[{"id":1308,"name":"Tazano Official Store","link":"https://tiki.vn/cua-hang/sachbanchay","logo":"95/08/28/6d2a2db44eb4b71b91fb2a1d9d60d863.jpg","price":107000,"product_id":"3905617","store_id":1265},{"id":127989,"name":"Times Books","link":"https://tiki.vn/cua-hang/times-books","logo":"a6/11/12/d2b1e40937a3a9953075558b8a80ff2c.png","price":142390,"product_id":"136784655","store_id":118250},{"id":161219,"name":"Nhà Sách Trẻ Online","link":"https://tiki.vn/cua-hang/nha-sach-tre