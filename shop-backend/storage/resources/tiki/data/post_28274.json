":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":8600,"discount_rate":10,"rating_average":4,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/00/70/76/0c47a81d409fac4ed282a4343e1cd6cd.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":572,"all_time_quantity_sold":4,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eGIEO MẦM HẠNH PHÚC – 125 điều tử tế nói và làm\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e \u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eSự tử tế giống như hạt mầm luôn tồn tại trong mỗi chúng ta, nó như một thói quen mà tất cả mọi người đều có thể nuôi dưỡng.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eCó những em bé sở hữu hạt mầm đó rất mạnh mẽ, gieo tại bất cứ mảnh đất nào đều có thể mọc cây và phát triển. Ngược lại, cũng có những em bé có hạt giống đó yếu hơn hoặc “ngủ vùi” hơi sâu. Khi đó, sẽ cần gia đình, trường lớp, bạn bè vun trồng, tạo một môi trường thích hợp để hạt mầm ấy lớn lên.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eHãy giúp trẻ “thực hành sự tử tế” mỗi ngày, “gieo niềm tin” vào con để biến thế giới thành một nơi tốt đẹp hơn, ba mẹ nhé! \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e“GIEO MẦM HẠNH PHÚC – 125 điều tử tế nói và làm” – cuốn sách đầy ý tưởng, truyền cảm hứng và dễ tiếp cận này giới thiệu hơn 100 điều tử tế, những việc làm, hành động cụ thể nên nói và làm để trẻ và cha mẹ có thể thực hành được ngay trong cuộc sống hàng ngày, như một “hạt giống” tính cách gieo vào trẻ những thói quen, khơi dậy lòng tốt trong mỗi đứa trẻ, giúp chúng biết sống chân thành, bao dung, biết tôn trọng mọi người xung quanh, biết làm thế nào để sống tử tế mỗi ngày.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eTử tế không phải là làm những việc to tát, cao siêu, mà là những điều giản dị trong cuộc sống quanh ta mà bất cứ ai cũng có thể làm được. Một cử chỉ thân thiện, một lời nói lịch sự, một hành động giúp đỡ, một nghĩa cử sẻ chia, đối xử tốt với động vật, gửi thiệp cho ai đó - không cần phải chờ dịp đặc biệt…và rất, rất nhiều những hành động, lời nói tử tế đều có trong cuốn sách này.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eSách có minh họa tươi vui, lối viết thân thiện phù hợp với các bạn nhỏ và ngay cả người lớn cũng nên đọc một lần.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/00/70/76/0c47a81d409fac4ed282a4343e1cd6cd.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/00/70/76/0c47a81d409fac4ed282a4343e1cd6cd.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/00/70/76/0c47a81d409fac4ed282a4343e1cd6cd.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/00/70/76/0c47a81d409fac4ed282a4343e1cd6cd.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/00/70/76/0c47a81d409fac4ed282a4343e1cd6cd.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/e1/c1/70/32ea95298ebea1571b86f9e788cde31b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e1/c1/70/32ea95298ebea1571b86f9e788cde31b.jpg