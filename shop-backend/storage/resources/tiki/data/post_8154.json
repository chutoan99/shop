round_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/28/6d/9c/577f67fe4030b3d976116ef5fd570ea0.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1236,"all_time_quantity_sold":5,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eThành phần của sản phẩm\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/31/62/01/1716ac029d64344730dbcce54739599f.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eNước rửa bình Arau Baby 500ml có thành phần bao gồm: Xà phòng nguyên chất (10% muối potassium của a-xít béo), chiết xuất lá tía tô.\u003c/p\u003e\n\u003cp\u003e100% thành phần tự nhiên\u003c/p\u003e\n\u003cp\u003eNước rửa bình Arau Baby chứa các thành phần chiết xuất tự nhiên, không chứa phụ gia tổng hợp, đạt hiệu quả làm sạch cao và nhanh chóng, giúp mẹ dễ dàng làm sạch mọi thứ.\u003c/p\u003e\n\u003cp\u003eSản phẩm được chiết xuất hoàn toàn từ thảo mộc, vừa an toàn cho sức khỏe của bé, vừa nhẹ nhàng trên da tay của mẹ.\u003c/p\u003e\n\u003cp\u003eLàm sạch hiệu quả\u003c/p\u003e\n\u003cp\u003eBọt dày đặc nhanh chóng làm sạch các vết bẩn, thức ăn thừa, dầu mỡ và vi khuẩn bám dính trên bề mặt trước khi tráng lại bằng nước. Mẹ sẽ cảm nhận được bề mặt sạch kin kít và không còn cảm giác nhớt nhờn trên các vật dụng của bé sau khi rửa.\u003c/p\u003e\n\u003cp\u003eHương thơm cây cỏ nhẹ dịu\u003c/p\u003e\n\u003cp\u003eRửa bình Arau Baby không chứa chất tạo mùi tổng hợp. Thành phần gồm các chiết xuất thảo mộc với hương thơm tự nhiên của cây cỏ vừa làm mất mùi các vết bẩn được rửa, vừa làm át mùi của chất béo tự nhiên thường có trong thành phần của xà phòng, an toàn tuyệt đối khi sử dụng các dụng cụ đã được làm sạch từ nước rửa bình Arau Baby.\u003c/p\u003e\n\u003cp\u003eSản phẩm dạng chai có vòi ấn tiện lợi thao tác mỗi lần sử dụng.\u003c/p\u003e\n\u003cp\u003eHướng dẫn sử dụng sản phẩm\u003c/p\u003e\n\u003cp\u003e- Hoà tan với nước 1 lượng nhỏ cho vào dụng cụ cần rửa, sử dụng với cây hoặc mút rửa bình.\u003c/p\u003e\n\u003cp\u003e- Bọt xà phòng mềm nhẹ dễ dàng thâm nhập vào mọi kẽ hở và tẩy sạch các vết bẩn và khử trùng.\u003c/p\u003e\n\u003cp\u003e- Sau đó rửa lại với nước sạch.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/28/6d/9c/577f67fe4030b3d976116ef5fd570ea0.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/28/6d/9c/577f67fe4030b3d976116ef5fd570ea0.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/28/6d/9c/577f67fe4030b3d976116ef5fd570ea0.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/28/6d/9c/577f67fe4030b3d976116ef5fd570ea0.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/28/6d/9c/577f67fe4030b3d976116ef5fd570ea0.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/d0/69/c0/8f280bf0e014f0d930eee6d442c378bb.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d0/69/c0/8f280bf0e014f0d930eee6d442c378bb.jpg","medium_url":"https://salt.tikic