on":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.8,"review_count":18,"review_text":"(18)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/95/e7/10/c7d6f5254c124387283db22538093e9a.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1567,"all_time_quantity_sold":97,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eLưu ý:\u003c/strong\u003e Bao bì sản phẩm có thể thay đổi theo từng đợt nhập hàng\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTặng 1 bộ cài khuy thẳng cộc Nous Petit cho bé:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eVải siêu mềm, thoáng khí, thoát hơi tốt. \u003c/li\u003e\u003cli\u003eSản phẩm giúp kháng khuẩn, kiểm soát nhiệt độ da bé. \u003c/li\u003e\u003cli\u003eChất liệu không gây kích ứng da bé.\u003c/li\u003e\u003cli\u003eSử dụng tông màu pastell nhẹ nhàng, đáng yêu. \u003c/li\u003e\u003cli\u003eThiết kế đơn giản nhưng không kém phần tinh tế. \u003c/li\u003e\u003cli\u003eThiết kế trang phục thông minh tiện lợi cho bé vận động. \u003c/li\u003e\u003cli\u003eKiểu dáng dễ kết hợp, phù hợp với mọi thời điểm trong ngày của bé\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eMách mẹ cách chọn size bộ Nous cho bé:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e9-12M: 7-12kg\u003c/li\u003e\u003cli\u003e18-24M: 11-15kg\u003c/li\u003e\u003c/ul\u003e\n\u003ch3\u003eGiới thiệu Tã Moony\u003c/h3\u003e\n\u003cp\u003e\u003cstrong\u003eTã Moony \u003c/strong\u003elà sản phẩm cao cấp được sản xuất theo công nghệ hiện đại nhất hiện nay, đáp ứng được tất cả những yêu cầu về chất lượng cũng như tiêu chuẩn về an toàn cho bé yêu của bạn. Thấu hiểu sự khác biệt trong cấu tạo về sống lưng của các bé sơ sinh không thẳng như người lớn mà thường có độ cong như hình dạng chữ C từ phần lưng xuống mông do ảnh hưởng từ tư thế khi bé còn trong bụng mẹ, do đó Moony đã \u0026#34;phát minh\u0026#34; ra một đặc điểm nổi bật mà chưa tã nào có, đó chính là hệ thun đũng mặt ngoài tã - tạo ra một độ cong tự nhiên ôm theo cấu tạo cơ thể sơ sinh của bé, hạn chế việc tạo ra khe trống mà vẫn rất thoải mái cho bé các bé sơ sinh.\u003c/p\u003e\n\u003ch3\u003eĐặc điểm Tã quần Moony M58/L44/XL38/XXL26\u003c/h3\u003e\n\u003cp\u003e\u003cimg src=\"https://vcdn.tikicdn.com/ts/tmp/d4/2a/34/6d53886c6599c2671d67ba2f80d0c4c3.jpg\" alt=\"\" width=\"750\" height=\"689\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThun chân vừa vặn\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"padding-left:40px\"\u003eKhi bé vận động nhiều, khoảng cách giữa miếng tã với đùi và hông bé chính là nguyên nhân chính gây tràn tã. Nhưng nếu tã quá chật, làn da mong manh nhạy cảm của bé sẽ bị tổn thương. Tã quần Moony man bé gái với thun chân vừa vặn, ôm trọn cơ thể bé, hạn chế khoảng cách giữa tã và hai chân bé. Nhờ đó, tã quần Moony man giúp chống tràn tối đa, khô thoáng cả ngày mà không để lại vết hằn trên da bé.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThun hông co giãn nguyên vòng\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"padding-left:40px\"\u003eThun hông linh hoạt co giãn theo từng chuyển động của bé giúp bé luôn cảm thấy thoải mái và dễ chịu tối đa.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eBề mặt đa rãnh thấm\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"padding-left:40px\"\u003eBề mặt với vô số các rãnh thấm hút giúp chất lỏng thấm xuống nhanh và tạo khe hở cho không khí đi qua, cho da bé hô hấp tự nhiên, hạn chế hăm tã và các bệnh ngoài da ở trẻ.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eSợi Nano siêu nhỏ và mịn\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"padding-left:40px\"\u003eToàn bộ bề mặt của Moony được cấu tạo từ chất liệu sợi nano siêu nhỏ và mịn, khiến tã không những vô cùng dịu nhẹ mềm mại mà còn cho phép không khí lưu thông giúp làn da bé có thể “thở” tự nhiên, từ đó tránh hăm bí khi mặc tã.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eChỉ thị ướt báo thời điểm thay tã\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"padding-left:40px\"\u003eMẹ có thể nhận biết thời điểm thay tã dễ dàng dựa vào vạch màu chỉ thị ướt trên miếng tã. Khi vạch màu tự động chuyển từ màu vàng sang màu xanh lá, mẹ sẽ biết đã đến thời điểm thay tã. Dải băng dính cuốn miếng tã, giúp mẹ vứt bỏ miếng tã thật sạch sẽ và dễ dàng.\u003c/p\u003e\n\u003ch3\u003eHướng dẫn mẹ chọn size tã Moony phù hợp\u003c/h3\u003e\n\u003cp\u003e\u003cstrong\u003eTã dán:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eTã dán Size 3S – Tã dán đầu tiên trên thị trường được thiết kế dành riêng cho trẻ sinh non/ nhẹ cân có cân nặng dưới 3 kg\u003c/li\u003e\u003cli\u003eTã dán Size NB – Dành cho bé dưới 5kg\u003c/li\u003e\u003cli\u003eTã dán Size S – Dành cho bé từ 4 - 8kg\u003c/li\u003e\u003cli\u003eTã dán Size M – Dành cho bé từ 6 - 11kg\u003c/li\u003e\u003cli\u003eTã dán Size L – Dành cho bé từ 9 - 14kg\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eTã quần:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eTã quần Size M – Dành cho bé từ 6 - 12kg\u003c/li\u003e\u003cli\u003eTã quần Size L (Boy \u0026amp; Girl) – Dành cho bé từ 9 - 14kg\u003c/li\u003e\u003cli\u003eTã quần Size XL (Boy \u0026amp; Girl) – Dành cho bé từ 12 -22kg\u003c/li\u003e\u003cli\u003eTã quần Size XXL (Boy \u0026amp; Girl) – Dành cho bé trên 13 - 28kg\u003c/li\u003e\u003c/ul\u003e\n\u003ch3\u003eHướng dẫn mẹ cách mặc tã quần đúng chuẩn\u003c/h3\u003e\n\u003cul\u003e\u003cli\u003eKiểm tra trước sau, giữ trẻ ở tư thế đứng vững rồi mặc tã cho trẻ giống như khi mặc quần. Dùng 2 tay mở rộng 2 bên hông miếng tã quần Moony cho trẻ sơ sinh, cho chân của trẻ bước qua miếng tã.\u003c/li\u003e\u003cli\u003eKéo phần đai lưng miếng tã quần Moony size XL lên đến rốn của bé để phần đùi không xuất hiện khe hở.\u003c/li\u003e\u003cli\u003eKiểm tra để chắc chắn phần nếp chun ở đai lưng và lớp diềm xung quanh phần chân không bị cuộn ngược vào trong.\u003c/li\u003e\u003c/ul\u003e\n\u003ch3\u003eLưu ý khi sử dụng\u003c/h3\u003e\n\u003cul\u003e\u003cli\u003eThay tã sau khoảng thời gian đều đặn và thay ngay sau khi bé tiêu bẩn.\u003c/li\u003e\u003cli\u003eNgừng sử dụng và hỏi ý kiến bác sĩ nếu xuất hiện bất thường trên da\u003c/li\u003e\u003c/ul\u003e\n\u003ch3\u003eHướng dẫn bảo quản\u003c/h3\u003e\n\u003cp\u003eBảo quản nơi khô ráo, thoáng mát, tránh ánh nắng mặt trời trực tiếp, xa tầm tay trẻ em.\u003c/p\u003e\n\u003cp\u003eHạn sử dụng: 4 năm kể từ ngày sản xuất\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eMời mẹ xem video giới thiệu về sản phẩm của Moony\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003ciframe src=\"https://www.youtube.com/embed/gl5LkIhjlMo\" width=\"900\" height=\"450\" allowfullscreen=\"allowfullscreen\"\u003e\u003c/iframe\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.co