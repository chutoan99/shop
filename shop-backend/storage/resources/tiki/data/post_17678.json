},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"defective_product"}},"discount":470000,"discount_rate":22,"rating_average":4.5,"review_count":10,"review_text":"(10)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/6e/0c/86/f888eb4aec1bb021df940999ea9743f7.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":798,"all_time_quantity_sold":24,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cul class=\"border-bottom\"\u003e\u003cli\u003eNhãn hiệu:Gucci\u003c/li\u003e\n\u003cli\u003eGiới tính:Nữ\u003c/li\u003e\n\u003cli\u003eNồng độ:Eau de Parfum\u003c/li\u003e\n\u003cli\u003ePhát hành:2015\u003c/li\u003e\n\u003cli\u003eNhóm hương:Hương Hoa Cỏ – Floral\u003c/li\u003e\n\u003cli\u003ePhong cách:Sang trọng, quý phái, quyến rũ.\u003c/li\u003e\n\u003c/ul\u003e\u003cp class=\"color-main\"\u003e\u003cstrong\u003eHương đặc trưng\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eHương đầu: Cam Bergamot.\u003cbr /\u003eHương giữa: Hoa ngọc lan tây, Hoa huệ Casablanca, Hoa cam.\u003cbr /\u003eHương cuối: Hổ phách, Gỗ đàn hương, Hương Va ni Tahiti.\u003c/p\u003e\n\u003cp\u003eNước Hoa Gucci Bamboo For Women EDP là chai nước hoa nữ cao cấp đến từ thương hiệu Gucci nổi tiếng nước Ý. Gucci Bamboo mang mùi hương thể hiện sự tự tin và nữ tính với thiết kế hiện đại, sang trọng.\u003c/p\u003e\n\u003cp\u003eLà sự pha trộn giữa những hương thơm tinh tế của vùng đất nhiệt đới, nước hoa Gucci Bamboo For Women mang đến cho bạn một cảm giác cực kỳ ngọt ngào và nữ tính khi xịt lên da. Gucci Bamboo EDP sở hữu hàm lượng tinh dầu lớn với hương thơm nồng nàn và bền mùi theo thời gian. Loại nước hoa này khá phù hợp để sử dụng ban ngày, trong điều kiện thời tiết xuân hè mát mẻ.\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eLịch sử ra đời nước hoa Gucci Bamboo For Women\u003c/strong\u003e\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eRa mắt vào mùa xuân năm 2015, Gucci Bamboo là dòng nước hoa cùng tên với BST trang sức và phụ kiện thời thượng đến từ nhà mốt nổi tiếng nước Ý. Với ý tưởng tôn vinh nét đẹp nữ tính đầy tự tin của mỗi người phụ nữ, \u003cstrong\u003enước hoa Gucci Bamboo\u003c/strong\u003e mang đến cho bạn một mùi hương sang trọng và cuốn hút đến bất ngờ. Sự hòa quyện giữa cam Bergamot, ngọc lan tây, hoa huệ Casablanca cùng hương thơm hổ phách đã tạo nên một “kim tự tháp” mùi hương không thể nhầm lẫn của loại nước hoa này. \u003cimg class=\"aligncenter wp-image-35978\" title=\"Gucci Bamboo For Women EDP 1 - Nuochoarosa.com - Nước hoa cao cấp, chính hãng giá tốt, mẫu mới\" src=\"https://nuochoarosa.com/wp-content/uploads/2018/03/z2974602318943_ae8bace54b5dade0e1693c24dd5158c7-min.jpg\" alt=\"z2974602318943 ae8bace54b5dade0e1693c24dd5158c7 min - Nuochoarosa.com - Nước hoa cao cấp, chính hãng giá tốt, mẫu mới\" width=\"400\" height=\"400\" /\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eThiết kế chai nước hoa Gucci Bamboo For Women\u003c/strong\u003e\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eBên cạnh hương thơm thanh lịch thì vẻ ngoài tinh tế đầy sang chảnh của Gucci Bamboo For Women cũng là một điểm nhấn khó phai trong lòng các tín đồ nước hoa Gucci nữ. Sử dụng chất liệu thủy tinh trong suốt với các mặt cắt vô cùng hoàn hảo, nước hoa Gucci Bamboo For Women khiến nhiều người liên tưởng đến hình ảnh những viên kim cương quý giá khi cầm trên tay. Nắp chai được thiết kế cách điệu theo hình dáng thân trúc, vừa mang cảm giác sang trọng lại vô cùng thân thiện, gần gũi.\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"aligncenter wp-image-35979\" title=\"Gucci Bamboo For Women EDP 2 - Nuochoarosa.com - Nước hoa cao cấp, chính hãng giá tốt, mẫu mới\" src=\"https://nuochoarosa.com/wp-content/uploads/2018/03/z2974602324484_af5912de9f6f9fbc20f7d0c8e86d1492-min.jpg\" alt=\"z2974602324484 af5912de9f6f9fbc20f7d0c8e86d1492 min - Nuochoarosa.com - Nước hoa cao cấp, chính hãng giá tốt, mẫu mới\" width=\"600\" height=\"600\" /\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eMùi hương nước hoa Gucci Bamboo For Women nữ tính, tươi mới\u003c/strong\u003e\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eThuộc nhóm hương hoa cỏ – Floral, Gucci Bamboo được so sánh như một trải nghiệm vô cùng tinh tế và chân thực đến từ thiên nhiên nhiệt đới hoang dã. Sử dụng nguyên liệu chính từ tinh dầu trái cây và hoa tươi xứ nóng, nước hoa mang đến cho bạn cảm giác ngọt ngào và quyến rũ như đang lan tỏa dịu nhẹ trên khắp cơ thể.\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"aligncenter wp-image-35976\" title=\"Gucci Bamboo For Women EDP 3 - Nuochoarosa.com - Nước hoa cao cấp, chính hãng giá tốt, mẫu mới\" src=\"https://nuochoarosa.com/wp-content/uploads/2018/03/z2974602313766_9ec8e0071ea2f9ba05d234fdd56c0347-min.jpg\" alt=\"z2974602313766 9ec8e0071ea2f9ba05d234fdd56c0347 min - Nuochoarosa.com - Nước hoa cao cấp, chính hãng giá tốt, mẫu mới\" width=\"600\" height=\"623\" /\u003e\u003c/p\u003e\n\u003cdiv\u003e\u003cspan\u003eGucci Bamboo khởi đầu “kim tự tháp” mùi hương với cảm giác thanh mát, ngọt ngào đặc trưng của cam Bergamot. Khúc dạo đầu này sẽ khéo dài trong khoảng từ 10 đến 15 phút đầu tiên với nhiệm vụ tạo nên ấn tượng nhẹ nhàng đầy cuốn hút cho cơ thể bạn.\u003c/span\u003e\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv\u003e\u003cspan\u003e“Perfume pyramid” tiếp tục di chuyển đến tầng thứ 2 với cú “tấn công” đầy bất ngờ của middle notes. Nốt giữa của chai nước hoa Gucci là sự pha trộn đầy phức tạp giữa ngọc lan tây, hoa huệ Casablanca và hoa cam nữ tính. Dù mang một mùi hương khá đậm nhưng middle notes của Gucci Bamboo lại được đánh giá là khá ngọt ngào và dễ chịu khi sử dụng lâu dài.\u003c/span\u003e\u003c/div\u003e\n\u003cdiv\u003eCuối cùng là base notes với sự góp mặt của xạ hương, gỗ đàn hương và vani Tây Ấn giúp mang đến cái kết không thể ngọt ngào và ấm áp hơn cho chai nước hoa của thương hiệu Gucci này.\u003c/div\u003e\n\u003cdiv\u003e\u003cimg class=\"wp-image-35975 aligncenter\" title=\"Gucci Bamboo For Women EDP 4 - Nuochoarosa.com - Nước hoa cao cấp, chính hãng giá tốt, mẫu mới\" src=\"https://nuochoarosa.com/wp-content/uploads/2018/03/z2974602305757_0011ca77e75c35aedc46fe70484b4598-min.jpg\" alt=\"z2974602305757 0011ca77e75c35aedc46fe70484b4598 min - Nuochoarosa.com - Nước hoa cao cấp, chính hãng giá tốt, mẫu mới\" width=\"380\" height=\"571\" /\u003e\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/6e/0c/86/f888eb4aec1bb021df940999ea9743f7.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/6e/0c/86/f888eb4aec1bb021df940999ea9743f7.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/6e/0c/86/f888eb4aec1bb021df940999ea9743f7.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6e/0c/86/f888eb4aec1bb021df940999ea9743f7.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6e/0c/86/f888eb4aec1bb021df940999ea9743f7.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/88/9f/f7/e28afa402e7cc5d13f8480fdb613d9c3.jpg","is_gallery":true,"label":null,"large_ur