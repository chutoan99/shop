56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/d7/64/47/7acb193006f2c1ca23add671115ccce6.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":109,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<h1><em><strong>Giới thiệu Bộ máy bắt vít dùng pin 4V kèm 20 chi tiết vít TOTAL TSDLI0442</strong></em></h1>\n<p><em><strong>Bộ máy bắt vít dùng pin 4V kèm 20 chi tiết vít TOTAL TSDLI0442</strong></em> là một công cụ cầm tay được thiết kế để siết chặt các loại vít. Máy được trang bị một đầu siết vít tự động với cơ chế tự động ngưng khi đạt mức siết đúng.</p>\n<p><em><strong>Bộ máy bắt vít dùng pin 4V kèm 20 chi tiết vít TOTAL TSDLI0442 </strong></em>với 16 đầu vít Cr size 25mm, khung đỡ, 2 mũi bắt vít Cr size 50mm, 1 khớp nối và hộp nhựa</p>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/36/ed/e1/2486d4afa5b876f133c7ba02efe9dd6e.jpg?v=1716436171494\" alt=\"tsdli0442-nd1.jpg?v=1716436171494\" /></p>\n<h2><strong>Thông tin sản phẩm</strong></h2>\n<ul>\n<li>Tên sản phẩm: <em><strong>Bộ máy bắt vít dùng pin 4V kèm 20 chi tiết vít TOTAL TSDLI0442</strong></em></li>\n<li>Mã hàng: <em><strong>TSDLI0442</strong></em></li>\n<li>Công dụng: bắt hoặc tháo vít</li>\n<li><em><strong>Thương hiệu: TOTAL</strong></em></li>\n<li><strong>Xuất xứ: Trung Quốc</strong></li>\n</ul>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/ba/03/f8/d19d17e1020d4c2c30004dc37ee9fb7d.jpg?v=1716436183907\" alt=\"tsdli0442-nd2.jpg?v=1716436183907\" /></p>\n<h2><strong>Thông số kỹ thuật</strong></h2>\n<ul>\n<li>Điện thế: 4V,</li>\n<li>Đầu lục giác: 1/4''.</li>\n<li>Tốc độ không tải: 240 vòng / phút.</li>\n<li>Lực xoắn  tối đa: 4 N</li>\n<li>Cài đặt mô men xoắn: 15 + 1.</li>\n<li>Với đèn làm việc LED, báo chỉ số mức sạc.</li>\n<li>Điện thế sạc : 110-240V~50/60Hz.</li>\n<li>Bộ sản phẩm bao gồm: 1 máy bắt vít, 16 mũi vít 25mm, 2 mũi bắt vít Cr size 50mm, 1 khớp nối và hộp nhựa</li>\n<li>\n<article class=\"4ever-article\">\n<ul>\n<li>\n<div>Lưu ý: sản phẩm không bao cục sạc đi kèm</div>\n</li>\n</ul>\n</article>\n</li>\n</ul>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/db/42/aa/752ea1abd4d5f3b1be4ebc595a4b2905.jpg?v=1716436194014\" alt=\"tsdli0442-nd3.jpg?v=1716436194014\" /></p>\n<h2><strong>Thông tin nổi bật</strong></h2>\n<ul>\n<li>\n<p><strong>Thiết kế nhỏ gọn:</strong> Máy có kích thước nhỏ gọn, dễ dàng cầm nắm và sử dụng.</p>\n</li>\n<li>\n<p><strong>Pin sạc lại:</strong> Máy được trang bị một pin lithium-ion 4V có thể sạc lại, giúp máy có thể hoạt động lâu hơn so với các loại máy siết vít dùng pin thông thường.</p>\n</li>\n<li>\n<p><strong>Đầu siết vít tự động: </strong>Máy được trang bị một đầu siết vít tự động với cơ chế tự động ngưng khi đạt mức siết đúng. Điều này giúp tránh tình trạng quá siết hoặc không đủ siết, giúp đảm bảo độ chính xác và độ an toàn của công việc.</p>\n</li>\n<li>\n<p><strong>Điều chỉnh tốc độ quay: </strong>Máy có thể điều chỉnh tốc độ quay phù hợp với từng loại vít và nhu cầu sử dụng khác nhau.</p>\n</li>\n<li>\n<p><strong>Đảo chiều quay: </strong>Máy có tính năng đảo chiều quay, giúp người sử dụng có thể dễ dàng thay đổi hướng xoay của máy để phù hợp với từng tình huống sử dụng.</p>\n</li>\n<li>\n<p><strong>Đèn LED: </strong>Máy được trang bị một đèn LED để giúp người dùng có thể làm việc dễ dàng trong điều kiện ánh sáng yếu hoặc khu vực tối.</p>\n</li>\n<li>\n<p><strong>Có thể sử dụng được với nhiều loại vít:</strong> Máy có thể sử dụng được với nhiều loại vít khác nhau, giúp cho công việc của người dùng trở nên đa dạng và thuận tiện hơn.</p>\n</li>\n</ul>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/64/b7/b1/31d7ef92f4158c218d2a7540a5bdc730.jpg?v=1716436203110\" alt=\"tsdli0442-nd4.jpg?v=1716436203110\" /></p>\n<h2><strong>Hướng dẫn sử dụng</strong></h2>\n<ul>\n<li>Vui lòng đọc kỹ hướng dẫn sử dụng kèm theo sản phẩm</li>\n</ul><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/d7/64/47/7acb193006f2c1ca23add671115ccce6.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d7/64/47/7acb193006f2c1ca23add671115ccce6.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d7/64/47/7acb193006f2c1ca23add671115ccce6.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d7/64/47/7acb193006f2c1ca23add671115ccce6.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d7/64/47/7acb193006f2c1ca23add671115ccce6.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/b8/b2/4c/eeef3c336e0a7f7551fc01943b2d2113.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b8/b2/4c/eeef3c336e0a7f7551fc01943b2d2113.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b8/b2/4c/eeef3c336e0a7f7551fc019