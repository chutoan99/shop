icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"freeship_xtra","type":"pdp_icon_badge","index":2,"icon":"https://salt.tikicdn.com/ts/upload/be/67/48/04a82ab8df178e1a13bde38316081865.png","icon_width":91,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":true,"return_reason":"any_reason"}},"discount":22000,"discount_rate":4,"rating_average":3,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/media/catalog/product/b/b/bb03.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2754,"all_time_quantity_sold":8,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p style=\"text-align: justify;\"><span style=\"font-size: medium; color: #008ab7;\"><strong>Bảng Ghim Vải Bố Bavico BB03 Đỏ - 0.6 x 1.0 m</strong></span></p>\r\n<p style=\"text-align: justify;\"><strong>Bảng ghim vải bố Bavico BB03 đỏ - 0.6 x 1.0 m</strong> là một sản phẩm tuyệt vời, dùng để ghi chú lại công việc tại công ty, hay dùng ghi chú bất kì công việc cá nhân của bản thân và gia đình. Bảng ghim được làm từ chất liệu cao cấp, 4 cạnh của bảng ghim được bọc khung nhôm hộp trắng, bóng, mang lại tính thẩm mỹ cao. Ngoài ra, 4 góc của bảng còn có co nhựa màu trắng, hài hòa với khung nhôm, chống trầy xước và an toàn cho người sử dụng.</p>\r\n<p><img style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Bảng Ghim Vải Bố Bavico BB03 Đỏ - 0.6 x 1.0 m\" src=\"http://tikicdn.com/media/catalog/product/b/b/bb03.u634.d20160930.t084032.930071.jpg\" alt=\"Bảng Ghim Vải Bố Bavico BB03 Đỏ - 0.6 x 1.0 m\" width=\"700\" height=\"407\" /></p>\r\n<p style=\"text-align: justify;\"><strong>Thông tin sản phẩm</strong></p>\r\n<p style=\"text-align: justify;\"><strong>Bảng ghim tiện ích</strong></p>\r\n<p style=\"text-align: justify;\">Bảng ghim vải bố Bavico BB03 dùng để đính giấy note, hình minh họa, hoặc bất kì thông tin nào bằng giấy. Bảng ghim được sử dụng nhiều ở phòng họp công ty, cơ quan, hoặc dùng cho gia đình với mục đích ghi chú công việc cá nhân.</p>\r\n<p style=\"text-align: justify;\"><strong>Chất liệu cao cấp</strong></p>\r\n<p style=\"text-align: justify;\">- Bảng được làm từ chất liệu cao cấp, có mặt vải bố màu đỏ đậm nhập khẩu từ HongKong, không bị phai màu. Phía sau mặt bảng là lớp mốp cao su đàn hồi, ghim không để lại dấu như các bảng vải bố khác.</p>\r\n<p style=\"text-align: justify;\">- Bảng ghim được lót bằng ván MDF có tính chịu lực tốt, độ bền tối ưu, giúp bảng không bị cong vênh. Mặt sau của bảng được ép giấy bóng vân gỗ chống ẩm, mang lại giá trị sử dụng lâu bền cho sản phẩm.</p>\r\n<p style=\"text-align: justify;\"><strong>Thiết kế tiện dụng, an toàn </strong></p>\r\n<p style=\"text-align: justify;\">- Bốn cạnh của bảng ghim được bọc khung nhôm hộp trắng, bóng, mang lại tính thẩm mỹ cao. Khung nhôm được thiết kế chắc chắn, có tác dụng chống oxy hóa, đảm bảo tính chịu lực cao. Ngoài ra, 4 góc của bảng còn có co nhựa màu trắng, hài hòa với khung nhôm, chống trầy xước và an toàn cho người sử dụng.</p>\r\n<p style=\"text-align: justify;\">- Bảng ghim được trang bị sẵn móc treo bằng inox cao cấp, giúp bạn treo bảng ghim lên dễ dàng và giữ cho bảng được cân bằng, vững chắc.</p>\r\n<p style=\"text-align: justify;\"><strong>Thông tin khác</strong></p>\r\n<p style=\"text-align: justify;\">- Thương hiệu Bavico</p>\r\n<p style=\"text-align: justify;\">- Nguyên liệu nhập khẩu</p>\r\n<p style=\"text-align: justify;\">- Lắp ráp tại Việt Nam</p>\r\n<p style=\"text-align: justify;\">- Kích thước: 0.6 x 1.0 m</p>\r\n<p style=\"text-align: justify;\">- Trọng lượng: 0,9 Kg</p>\r\n<p style=\"text-align: justify;\">- Bảo hành 12 tháng</p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/media/catalog/product/b/b/bb03.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/b/b/bb03.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/b/b/bb03.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/b/b/bb03.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/b/b/bb03.jpg"}],"warranty_policy":null,"brand":{"id":34015,"name":"Bavico","slug":"bavico"},"current_seller":{"id":176,"sku":"2201313061674","name":"Thiết Bị Giáo Dục BAVICO","link":"https://tiki.vn/cua-hang/thiet-bi-giao-duc-bavico","logo":"d8/1f/12/d81f12054ca8759fdc5087131bd1f120.jpg","price":520000,"product_id":"635574","store_id":142,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Thông tin chung","attributes":[{"code":"brand","nam