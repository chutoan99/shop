{"id":275159736,"master_id":275159736,"sku":"6789372645574","name":"Đồng Hồ GPS Thể Thao COROS VERTIX 2S - Space ","url_key":"dong-ho-gps-the-thao-coros-vertix-2s-space-p275159736","url_path":"dong-ho-gps-the-thao-coros-vertix-2s-space-p275159736.html?spid=275159740","short_url":"https://tiki.vn/product-p275159736.html?spid=275159740","type":"simple","book_cover":null,"short_description":"Từ việc chinh phục những đỉnh núi cao nhất thế giới cho hoàn thành những cự ly siêu marathon dài nhất, dòng VERTIX dành cho những ai có nhu cầu cao nhất. COROS VERTIX 2S thế hệ mới nhất  mang đến hiệu...","price":18800000,"list_price":18800000,"original_price":18800000,"badges":[{"code":"new_pdp","text":"v1"}],"badges_new":[{"placement":"left_brand","code":"is_authentic","type":"is_authentic","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"right_authentic","code":"return_policy","type":"return_policy","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"badges_v3":[{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/8b/09/f3/d223cca31643010b155cb6668fe32b35.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":103,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eTừ việc chinh phục những đỉnh núi cao nhất thế giới cho hoàn thành những cự ly siêu marathon dài nhất, dòng VERTIX dành cho những ai có nhu cầu cao nhất. \u003cstrong\u003eCOROS VERTIX 2S \u003c/strong\u003ethế hệ mới nhất  mang đến hiệu suất mà bạn cần để biến giấc mơ phiêu lưu của bạn thành hiện thực.\u003c/p\u003e\n\u003cp\u003eVới 3 phiên bản Earth, Moon, Space \u003cstrong\u003eCOROS\u003c/strong\u003e muốn dành sự tôn vinh tinh thần khám phá không ngừng nghỉ của con người!\u003c/p\u003e\n\u003cp\u003eCác nút vật lý cùng nút xoay đặc trưng của \u003cstrong\u003eCOROS\u003c/strong\u003e kết hợp với màn hình mặt số kỹ thuật số lớn giúp bạn dễ dàng truy cập tất cả các tính năng của \u003cstrong\u003eCOROS VERTIX 2S\u003c/strong\u003e trong mọi điều kiện, ngay cả khi đeo găng tay dày.\u003c/p\u003e\n\u003cfigure class=\"image\"\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/40/f8/88/5c5809d8b31b598d29513e91eb98d177.png\" alt=\"20240426_1CyL2VQJ.png\" width=\"1200\" height=\"945\" /\u003e\u003c/figure\u003e\n\u003cp\u003eMàn hình sapphire grade 5 chống trầy xước và viền titan phủ PVD bảo vệ các bộ phận bên trong \u003cstrong\u003eCOROS VERTIX 2S\u003c/strong\u003e, giúp chiếc đồng thách thức chịu đựng mọi thử thách mà môn thể thao, cuộc phiêu lưu tới những địa hình hiểm trở và các va đập hàng ngày trong cuộc sống.\u003c/p\u003e\n\u003cfigure class=\"image\"\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/8f/4c/d3/7597cee6fe23ca6f68b65b1f9fe89c3a.png\" alt=\"20240426_NOU95tE8.png\" width=\"1200\" height=\"945\" /\u003e\u003c/figure\u003e\n\u003cp\u003eVì hỏng hóc không bao giờ là một sự lựa chọn nên COROS VERTIX 2S có khả năng chịu được nhiệt độ không khí từ -22°F đến 122°F (-30°C đến 50°C) và áp lực nước lên tới 10 ATM (100 mét), ngay cả môi trường ngoài bầu khí quyển cũng không thể làm khó được “kẻ cứng đầu” này!\u003c/p\u003e\n\u003cfigure class=\"image\"\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/63/5f/54/7cb515f474cb942712ee2ec083b74685.png\" alt=\"20240426_xocgOI5Q.png\" width=\"1200\" height=\"820\" /\u003e\u003c/figure\u003e\n\u003cp\u003eNổi tiếng với thời lượng pin đặc biệt dài, đồng hồ dòng VERTIX đã liên tục hỗ trợ những người leo núi lên tới đỉnh Mt. Everest, các vận động viên hoàn thành các cuộc đua hơn 250 dặm và vô số kỳ tích về sức bền chỉ với một lần sạc. Thời lượng pin trên \u003cstrong\u003eCOROS VERTIX 2S\u003c/strong\u003e lần lượt là:\u003c/p\u003e\n\u003ctable style=\"border-collapse:collapse;width:100%;height:72px;\" border=\"1\"\u003e\n\u003ctbody\u003e\n\u003ctr style=\"height:36px;\"\u003e\n\u003ctd style=\"width:50%;height:36px;\"\u003e\u003cstrong\u003eTất cả hệ thống đang bật\u003c/strong\u003e\u003cbr /\u003e\u003cstrong\u003e(GPS, GLONASS, Galileo, Beidou, QZSS)\u003c/strong\u003e\u003c/td\u003e\n\u003ctd style=\"width:50%;height:36px;\"\u003e\n\u003cp\u003e(GPS, GLONASS, Galileo, Beidou, QZSS):   73 Hours\u003cbr /\u003e(Kết nối cùng lúc 5 hệ thống vệ tinh)\u003c/p\u003e\n\u003cp\u003e27 Giờ (nghe khi nhạc)\u003cbr /\u003eKết nối cùng lúc 5 hệ thống vệ tinh với âm nhạc offline\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr style=\"height:18px;\"\u003e\n\u003ctd style=\"width:50%;height:18px;\"\u003e\u003cstrong\u003eTần số kép\u003c/strong\u003e\u003cbr /\u003e\u003cstrong\u003e(GPS, GLONASS, Galileo, Beidou, QZSS)\u003c/strong\u003e\u003c/td\u003e\n\u003ctd style=\"width:50%;height:18px;\"\u003e\n\u003cp\u003e43 giờ\u003cbr /\u003e(Kết nối cùng lúc 5 hệ thống vệ tinh ở tần số kép)\u003c/p\u003e\n\u003cp\u003e22 Giờ (Có Nhạc)\u003cbr /\u003eKết nối cùng lúc 5 hệ thống vệ tinh ở tần số kép với âm nhạc offline\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr style=\"height:18px;\"\u003e\n\u003ctd style=\"width:50%;height:18px;\"\u003e\u003cstrong\u003eSử dụng hàng ngày\u003c/strong\u003e\u003c/td\u003e\n\u003ctd style=\"width:50%;height:18px;\"\u003e40 ngày\u003cbr /\u003eVới tính năng theo dõi giấc ngủ và hàng ngày\u003cbr /\u003e36 Ngày (Với Căng Thẳng Hàng Ngày)\u003cbr /\u003eTheo dõi mức độ căng thẳng của bạn suốt cả ngày\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\n\u003cfigure class=\"image\"\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/df/4a/f2/9f4ae604f9a6046d1197e429cb953dee.png\" alt=\"20240426_AqlADobL.png\" width=\"1200\" height=\"945\" /\u003e\u003c/figure\u003e\n\u003cp\u003eBộ công cụ lập kế hoạch và điều hướng tuyến đường mạnh mẽ của \u003cstrong\u003eCOROS\u003c/strong\u003e cho phép bạn lập kế hoạch, theo dõi và quay lại đường dẫn của mình trực tuyến hoặc ngoại tuyến. Phản chiếu điều hướng cho phép đi theo các tuyến đường phức tạp từ điện thoại lẫn đồng hồ của bạn.\u003c/p\u003e\n\u003cfigure class=\"image\"\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/64/cc/39/6c22d9df3546887c083c50fdd3ae588b.png\" alt=\"20240426_HmQVvNSI.png\" width=\"1200\" height=\"871\" /\u003e\u003c/figure\u003e\n\u003cp\u003eĐã được chứng minh bởi các vận động viên giỏi nhất thế giới, Giải pháp tập luyện \u003cstrong\u003eCOROS\u003c/strong\u003e sẽ giúp bạn đạt được thể lực tối ưu nhất. Bên cạnh đó Cảm biến quang học thế hệ tiếp theo trên \u003cstrong\u003eCOROS VERTIX 2S\u003c/strong\u003e của chúng tôi theo dõi chính xác nhịp tim của bạn để có dữ liệu luyện tập chính xác và Ứng dụng \u003cstrong\u003eCOROS\u003c/strong\u003e cho phép bạn theo dõi tiến trình của mình, nhận thông tin chi tiết hữu ích cũng như lên kế hoạch cho lộ trình đạt hiệu suất cao nhất.\u003c/p\u003e\n\u003cfigure class=\"image\"\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/e8/52/87/d45c5ea2fb6fc04fea9f81a8f403d0b0.png\" alt=\"20240426_BoBxbGS6.png\" width=\"1200\" height=\"945\" /\u003e\u003c/figure\u003e\n\u003cp\u003eTập luyện không chỉ kết thúc khi bạn hoàn thành giáo án! Tập luyện Đào tạo chỉ là một phần của bức tranh thể chất của bạn. Theo dõi quá trình phục hồi của bạn và giúp tránh chấn thương bằng tính năng theo dõi giấc ngủ chi tiết, sự thay đổi nhịp tim, kiểm tra sức khỏe,\u003c/p\u003e\n\u003cfigure class=\"image\"\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/b4/8d/6a/21c1b6f499ce87332f0670e6336a538b.png\" alt=\"20240426_cN76oigY.png\" width=\"1200\" height=\"779\" /\u003e\u003c/figure\u003e\n\u003cp\u003eMỗi hộp \u003cstrong\u003eCOROS VERTIX 2S\u003c/strong\u003e đều có cả dây nylon và silicone để phù hợp với nhu cầu biểu diễn của bạn hoặc thay đổi phong cách của bạn với bất kỳ dây đeo phụ kiện 26mm nào của chúng tôi.\u003c/p\u003e\n\u003cp\u003eĐồng bộ hóa trực tiếp với các ứng dụng sức khỏe và thể chất yêu thích của bạn như Strava,  Health Connect,.. Luôn kết nối bằng cách xem tin nhắn đến và cuộc gọi điện thoại hoặc sử dụng Tìm điện thoại của tôi để xác định vị trí thiết bị bị thất lạc của bạn và điều khiển máy ảnh GoPro và Insta360 ngay từ cổ tay của bạn.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eBao bì nhỏ gọn được làm từ vật liệu tái chế có thể tái sử dụng hoặc tái chế để bảo quản cáp sạc, phụ kiện, …\u003c/p\u003e\n\u003cfigure class=\"image\"\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/83/2d/63/a617bad66eb6ef76efcd26f2c44b271d.jpg\" alt=\"20240426_FPGEtL0P.jpg\" width=\"1200\" height=\"945\" /\u003e\u003c/figure\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/8b/09/f3/d223cca31643010b155cb6668fe32b35.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/8b/09/f3/d223cca31643010b155cb6668fe32b35.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/8b/09/f3/d223cca31643010b155cb6668fe32b35.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8b/09/f3/d223cca31643010b155cb6668fe32b35.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8b/09/f3/d223cca31643010b155cb6668fe32b35.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/e1/a7/7e/78b0443323eb74e04169205a16054c46.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e1/a7/7e/78b0443323eb74e04169205a16054c46.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e1/a7/7e/78b0443323eb74e04169205a16054c46.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e1/a7/7e/78b0443323eb74e04169205a16054c46.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e1/a7/7e/78b0443323eb74e04169205a16054c46.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/74/61/5f/87f1c4e5ba074ee60e234602af84b90c.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/74/61/5f/87f1c4e5ba074ee60e234602af84b90c.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/74/61/5f/87f1c4e5ba074ee60e234602af84b90c.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/74/61/5f/87f1c4e5ba074ee60e234602af84b90c.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/74/61/5f/87f1c4e5ba074ee60e234602af84b90c.jpg"},{"base_url":"https://salt.tikicdn.com/ts