ext":"9.9"},{"placement":"pdp_badge","code":"is_hero","type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"freeship_xtra","type":"pdp_icon_badge","index":2,"icon":"https://salt.tikicdn.com/ts/upload/be/67/48/04a82ab8df178e1a13bde38316081865.png","icon_width":91,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":true,"return_reason":"any_reason"}},"discount":268000,"discount_rate":31,"rating_average":4.3,"review_count":4,"review_text":"(4)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ec/1f/0d/8e8ae1104fd4a7e3cd8fb8ac6f6c1213.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":556,"all_time_quantity_sold":37,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<article class=\"4ever-article\">\n<h3><strong>Giới Thiệu</strong></h3>\n<ul>\n<li>Nhiệt độ của nước pha sữa có ảnh hưởng trực tiếp đến dinh dưỡng và cảm giác ngon miệng của bé. Để đảm bảo bé luôn hấp thu đầy đủ các dưỡng chất từ sữa, máy đun nước và hâm nước pha sữa điện tử Fatzbaby Quick 9 FB3526TN chính là giải pháp tối ưu cho mẹ. Máy được thiết kế nhỏ gọn tích hợp 3 chế độ hoạt động cùng các tính năng tiện ích, hiện đại giúp mẹ luôn có nước ấm thích hợp pha sữa cho bé ngay cả khi bé đòi ăn đêm. Với sự trợ giúp của máy, công việc chăm sóc bé yêu và gia đình trở nên thật dễ dàng.</li>\n</ul>\n<h3><strong>Đặc Điểm Nổi Bật</strong></h3>\n<p><em><strong>1. Thiết kế tiện lợi</strong></em></p>\n<ul>\n<li>Máy đun nước và hâm nước pha sữa điện tử Fatzbaby Quick 9 được thiết kế với bình có thể chứa đến 1200ml nước, đây là lượng nước phù hợp mà cả gia đình có thể sử dụng vừa pha sữa, pha trà, ngũ cốc.</li>\n<li>Thân bình bằng thủy tinh cao cấp có thể chịu được nhiệt độ cao, trong suốt giúp mẹ có thể quan sát được mực nước bên trong dễ dàng.</li>\n<li>Các bộ phận khác như nắp bình, tay cầm hay đế bình đều được làm từ nhựa chịu nhiệt, có thể cách nhiệt, cách điện hiệu quả nên không lo tình trạng rò rỉ điện, chập cháy. Đặc biệt không chứa BPA hay bất cứ loại hợp chất gây hại nào khác, đảm bảo nguồn nước sôi an toàn với sức khỏe của bé và cả gia đình.</li>\n</ul>\n<p><em><strong>2. Tích hợp 3 chế độ hoạt động</strong></em></p>\n<ul>\n<li>Đun sôi nước chỉ trong 5 phút: chế độ hoạt động này vô cùng tiện lợi nếu mẹ cần nước sôi gấp đặc biệt là vào ban đêm khi bé đòi ăn.</li>\n<li>Giữ ấm nước chỉ với 1 nút chạm: Sau khi đun sôi, máy còn có chức năng giữ ấm. Thời gian giữ ấm lên tới 24 giờ liên tục. Nhiệt độ giữ ấm nước linh hoạt ở 3 cấp độ tương ứng với 3 nút trên thân máy:</li>\n</ul>\n<p>                  + 45°C : pha sữa</p>\n<p>                  + 70°C : pha bột, ngũ cốc</p>\n<p>                  + 90°C: pha trà, cà phê</p>\n<ul>\n<li>Khử Clo tồn dư chỉ sau 5 phút: Hàm lượng Clo cao sẽ có ảnh hưởng không tốt đến sức khỏe của bé. Chế độ hoạt động này đảm bảo khử hết Clo tồn dư trong nước máy, giúp mẹ an tâm hơn.</li>\n</ul>\n<p><em><strong>3. Chức năng hiện đại</strong></em></p>\n<p>Sản phẩm với 2 chức năng bộ nhớ và hẹn giờ mang đến cho ba mẹ nhiều tiện ích.</p>\n<ul>\n<li>Chức năng bộ nhớ: máy sẽ tự động ghi nhớ thói quen của mẹ khi sử dụng. Nếu mẹ thường xuyên pha sữa thì máy sẽ ghi nhớ nhiệt độ và tự động chuyển sang chế độ pha sữa mà mẹ không cần thực hiện thêm thao tác nào khi nước sôi</li>\n<li>Chức năng hẹn giờ: Đây là chức năng mới của các dòng sản phẩm Quick. Mẹ có thể hẹn giờ đun và hâm nước ở một thời gian nhất định trong ngày. Chức năng này giúp mẹ tiết kiệm chi phí điện năng không cần thiết.</li>\n</ul>\n<h3><strong>Lưu Ý Khi Sử Dụng</strong></h3>\n<ul>\n<li>Để đảm bảo độ bền của máy, không nên đổ nước quá 1200ml.</li>\n<li>Để máy xa tầm với của trẻ để đảm bảo an toàn.</li>\n<li>Không sử dụng sản phẩm với mục đích khác ngoài đun và giữ ấm nước.</li>\n<li>Vệ sinh bình sau mỗi lần sử dụng.</li>\n</ul>\n<h3><strong>Thông Số Kỹ Thuật </strong></h3>\n<ul style=\"list-style-type:disc;\">\n<li>Nguồn điện: AC 220-240V, 50/60Hz</li>\n<li>Công suất: 800 W</li>\n<li>Dung tích: 1.2L</li>\n<li>Khối lượng: 1.1kg</li>\n<li>Kích thước: 230mmx195mmx290mm</li>\n</ul>\n<p> </p>\n<p> </p>\n<p> </p>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/ec/1f/0d/ffdeb2538d6e92c1515fc54f5293fe16.jpg\" alt=\"ec1f0d82a1cdc2b6118b4d502c1bcc88.jpg\" width=\"750\" height=\"750\" /></p>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/a0/03/bb/c0ccd52df2704d0af90946e24442ab74.jpg\" alt=\"a003bbd2ee61e6684fa8d308c8edf62e.jpg\" width=\"750\" height=\"750\" /></p>\n<p> </p>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/08/3f/22/85f03ccfca70916756981b0a8c0d1ffc.jpg\" alt=\"083f221029adb7c44f5e18ebbb4be1b8.jpg\" /></p>\n</article><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ec/1f/0d/8e8ae1104fd4a7e3cd8fb8ac6f6c1213.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ec/1f/0d/8e8ae1104fd4a7e3cd8fb8ac6f6c1213.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ec/1f/0d/8e8ae1104fd4a7e3cd8fb8ac6f6c1213.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ec/1f/0d/8e8ae1104fd4a7e3cd8fb8ac6f6c1213.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ec/1f/0d/8e8ae1104fd4a7e3cd8fb8ac6f6c1213.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/a0/03/bb/35dd271957b1a67bcf72e9bf0d8637bf.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a0/03/bb/35dd271957b1a67bcf72e9bf0d8637bf.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a0/03/bb/35dd271957b1a67bcf72e9bf0d8637bf.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a0/03/bb/35dd271957b1a67bcf72e9bf0d8637bf.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a0/03/bb/35dd271957b1a67bcf72e9bf0d8637bf.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/3a/11/6e/9dca1172fb6d4028fceb18c5a2e79b48.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/3a/11/6e/9dca1172fb6d4028fceb18c5a2e79b48.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/3a/11/6e/9dca1172fb6d4028fceb18c5a2e79b48.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3a/11/6e/9dca1172fb6d4028fceb18c5a2e79b48.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3a/11/6e/9dca1172fb6d4028fceb18c5a2e79b48.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/6a/e3/3f/1f2537087115bcfea32ecb42ff75f218.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w12