g","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":281000,"discount_rate":16,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/84/ee/39/1a1b3348cf135dee77c5345a25e9940c.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1526,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2\u003eLựa chọn mới về âm thanh \u003c/h2\u003e\n\u003cp\u003eLoa di động Bluetooth LG XBOOMGo PL5 một thiết kế loa đỉnh cao từ LG mang đến những âm thanh cân bằng và sống động cho người sử dụng\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/02/71/ef/339bcacb87805a38b5a73d2acc86d10c.jpg\" data-src=\"https://salt.tikicdn.com/cache/w750/ts/product/02/71/ef/339bcacb87805a38b5a73d2acc86d10c.jpg\" /\u003e\u003c/p\u003e\n\u003ch2\u003eThiết kế đơn giản đầy phong cách\u003c/h2\u003e\n\u003cp\u003eKhông quá cầu kì, Loa di động Bluetooth LG XBOOMGo PL5 mang dáng dấp của những chiếc radio cổ điển, kiểu dáng trụ tròn sang trọng, đẹp mắt kết hợp với chất liệu cao su dễ cầm dễ di chuyển và vừa tầm tay đặc biệt còn có viền nhiều màu bắt mắt tha hồ lựa chọn\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/b9/9b/84/e550fd455cb9c0a22e086e4767cb67c6.jpg\" data-src=\"https://salt.tikicdn.com/cache/w750/ts/product/b9/9b/84/e550fd455cb9c0a22e086e4767cb67c6.jpg\" /\u003e\u003c/p\u003e\n\u003ch2\u003eTrải nghiệm âm thanh xuất sắc\u003c/h2\u003e\n\u003cp\u003eLG XBOOM Go PL5 với công nghệ Meridian đỉnh cao mang đến cho bạn âm thanh chất lượng cao. Cho ậm thanh thêm âm trầm sâu và âm sắc phong phú hơn mỗi khi bạn chơi nhạc.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/ac/1b/45/c3ddc13e9fde0dc84e82585f4f8cbf35.jpg\" data-src=\"https://salt.tikicdn.com/cache/w750/ts/product/ac/1b/45/c3ddc13e9fde0dc84e82585f4f8cbf35.jpg\" /\u003e\u003c/p\u003e\n\u003ch2\u003eMang âm nhạc đến với cuộc sống\u003c/h2\u003e\n\u003cp\u003eTính năng Sound Boost khuếch đại công suất âm thanh tối đa và mở rộng trường âm thanh. Bạn chỉ cần nhấn nút là đủ để khuấy động bữa tiệc thêm đầy cảm xúc rồi đấy\u003c/p\u003e\n\u003cp\u003eBass hành động kép\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/ac/1b/45/c3ddc13e9fde0dc84e82585f4f8cbf35.jpg\" data-src=\"https://salt.tikicdn.com/cache/w750/ts/product/ac/1b/45/c3ddc13e9fde0dc84e82585f4f8cbf35.jpg\" /\u003e\u003c/p\u003e\n\u003cp\u003eBộ tản nhiệt  tạo ra những nhịp bass sống động và chân thật. Khi loa trầm rung các đèn hình vòng nhấp nháy tạo ra chuyển động đầy màu sắc làm tăng thêm cảm giác tươi mới của bữa tiệc.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/b5/44/e9/7cfc8d69781ce9b60f8bab834293d95f.jpg\" data-src=\"https://salt.tikicdn.com/cache/w750/ts/product/b5/44/e9/7cfc8d69781ce9b60f8bab834293d95f.jpg\" /\u003e\u003c/p\u003e\n\u003ch2\u003e“Quẩy” bất chấp thời tiết\u003c/h2\u003e\n\u003cp\u003eVới công nghệ chống nước tối tân IPX5 giờ đây bạn có thể tha hồ chơi đùa, ca hát với bạn bè ngay cả khi trời mưa vì LG XBOOMGo PL5 vẫn luôn hoạt động bên bạn ngay cả khi bị ướt\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/19/3a/93/77014d0248de7dca11cc386cef6f8ec1.jpg\" data-src=\"https://salt.tikicdn.com/cache/w750/ts/product/19/3a/93/77014d0248de7dca11cc386cef6f8ec1.jpg\" /\u003e\u003c/p\u003e\n\u003ch2\u003eThời gian sử dụng lâu hơn\u003c/h2\u003e\n\u003cp\u003eThời lượng pin lên đến 18 giờ cho phép bạn tự do thưởng thức âm nhạc ngay cả khi đang di chuyển mà không phải lo lắng về việc gián đoạn cuộc vui\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/4c/21/45/7fd4a3ba0d88d0f621e2b537ae4b96ec.jpg\" data-src=\"https://salt.tikicdn.com/cache/w750/ts/product/4c/21/45/7fd4a3ba0d88d0f621e2b537ae4b96ec.jpg\" /\u003e\u003c/p\u003e\n\u003ch2\u003eKhuấy đảo cuộc vui bất tận\u003c/h2\u003e\n\u003cp\u003eKhông chỉ một mà là hàng trăm, với LG XBOOM Go PL5 việc nhân gấp nhiều lần âm thanh phát ra với khả năng kết nối thêm nhiều thiết bị PL5 cho âm thanh lớn hơn\u003c/p\u003e\n\u003cp\u003eBluetooth Surround Ready\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/cf/79/8a/0824264c04a6f683eaa33aa779b0dc2f.jpg\" data-src=\"https://salt.tikicdn.com/cache/w750/ts/product/cf/79/8a/0824264c04a6f683eaa33aa779b0dc2f.jpg\" /\u003e\u003c/p\u003e\n\u003ch2\u003eLàm cho âm thanh TV trở nên hấp dẫn hơn\u003c/h2\u003e\n\u003cp\u003eKết nối hai LG XBOOM Go PL5 với TV LG và sử dụng chúng cho âm thanh TV. Thật đơn giản để thiết lập và cung cấp cho bạn âm thanh vòm sống động với mọi thứ bạn xem.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/0d/a5/ab/c70fb7ea507f796b6be289b47c47e2aa.jpg\" data-src=\"https://salt.tikicdn.com/cache/w750/ts/product/0d/a5/ab/c70fb7ea507f796b6be289b47c47e2aa.jpg\" /\u003e\u003c/p\u003e\n\u003ch2\u003eKết nối dễ dàng hơn với Bluetooth\u003c/h2\u003e\n\u003cp\u003eNhấn nút phát trong hai giây, sau đó nói để kích hoạt Google Assistant trên điện thoại Android  hoặc Siri trên iOS. Bạn có thể phát nhạc, podcast và hơn thế nữa bằng lệnh thoại đơn giản.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/b0/30/82/4c0f0752dba4f00c2f39f1f253a8f6b1.jpg\" data-src=\"https://salt.tikicdn.com/cache/w750/ts/product/b0/30/82/4c0f0752dba4f00c2f39f1f253a8f6b1.jpg\" /\u003e\u003c/p\u003e\n\u003ctable border=\"1\"\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/1f/7e/8a/0ae21c2350fe13aebf8262d4b0b5f92b.jpg\" data-src=\"https://salt.tikicdn.com/cache/w750/ts/product/1f/7e/8a/0ae21c2350fe13aebf8262d4b0b5f92b.jpg\" /\u003e\n\u003cp\u003e\u003cstrong\u003eKết nối với nhiều Bluetooth dễ dàng\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eGhép nối hai thiết bị cùng một lúc thông qua Ứng dụng XBOOM. Sử dụng bất kỳ thiết bị được kết nối nào để điều khiển liên tục danh sách phát nhạc mà không sợ bị gián đoạn\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/c3/40/1d/d3848f287e1df5bc6d03faad65554a3e.jpg\" data-src=\"https://salt.tikicdn.com/cache/w750/ts/product/c3/40/1d/d3848f287e1df5bc6d03faad65554a3e.jpg\" /\u003e\n\u003cp\u003e\u003cstrong\u003eSạc USB ngay cả khi bạn nghe nhạc\u003c/strong\u003e \u003c/p\u003e\n\u003cp\u003eSử dụng cổng USB để sạc thiết bị của bạn mọi lúc mọi nơi mà không cần phải mang thêm bộ sạc.\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/fd/65/b5/a56baf6689ec1f503a17d950d3fb5fd4.jpg\" data-src=\"https://salt.tikicdn.com/cache/w750/ts/product/fd/65/b5/a56baf6689ec1f503a17d950d3fb5fd4.jpg\" /\u003e\n\u003cp\u003e\u003cstrong\u003eTrả lời cuộc gọi dễ dàng\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eLG XBOOM Go PL5 sẽ tự động chuyển sang chế độ cuộc gọi đến cả khi nhạc đang phát và bạn có thể dễ dàng kết nối cuộc gọi với bạn bè.\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/95/af/9d/368d077eb67246506c18e7c8245020ff.jpg\" data-src=\"https://salt.tikicdn.com/cache/w750/ts/product/95/af/9d/368d077eb67246506c18e7c8245020ff.jpg\" /\u003e\n\u003cp\u003e\u003cstrong\u003eKiểm soát thiết bị dễ dàng với Ứng dụng XBOOM\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eK