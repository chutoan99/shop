f":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.8,"review_count":48,"review_text":"(48)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/20/6b/8e/f1d9c73f9cf94502c16a351b59c5e381.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1604,"all_time_quantity_sold":183,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eXuất xứ : Nhật Bản\u003c/p\u003e\n\u003cp\u003eTrọng lượng : 1000g\u003c/p\u003e\n\u003cp\u003eSử dụng dc cho cả gia đình và cho bé từ 10 tháng tuổi\u003c/p\u003e\n\u003cp\u003eNước cốt hầm xương  là dạng nước cốt được nấu từ thịt gà, heo, bò cô đặc hương vị thơm ngon kích thích vị giác đem đến cả nhà món soup, cháo. Là sản phẩm không thể thiếu trong tủ lạnh của các mẹ nội trợ Nhật Bản\u003c/p\u003e\n\u003cp\u003e- Nó là dạng Soup cô đặc\u003c/p\u003e\n\u003cp\u003e- Nước cốt gà Kagome được sử dụng làm gia vị chính, triết xuất từ cốt xương gà ngon ngọt, nêm cho các món ăn, giúp các món ăn thơm ngon hơn, hương vị đậm đà hơn.\u003c/p\u003e\n\u003cp\u003eVới chiết xuất từ cốt xương gà dựa trên công nghệ sản xuất và quá trình kiểm định nghiêm ngặt về chất lượng tại Nhật, giúp bạn nấu những món ăn thơm ngon, bổ dưỡng và thực sự an toàn cho gia đình. Súp chiết xuất từ xương gà Nhật Bản chứa những thành phần dinh dưỡ\u003c/p\u003e\n\u003cp\u003eThành phần :\u003c/p\u003e\n\u003cp\u003e- Làm từ thịt gà, thịt heo, dầu thực vật, gia vị ….\u003c/p\u003e\n\u003cp\u003e- Không chứa chất bảo quản an toàn cho trẻ nhỏ trong gia đình\u003c/p\u003e\n\u003cp\u003e- Hương vị thơm ngon, dậy mùi kích thích vị giác của bé cho cả gia đình có món soup, cháo ngon miệng.\u003c/p\u003e\n\u003cp\u003e- Bổ sung EPA có tác dụng tăng đồng hóa và giảm dị hóa protein hỗ trợ phát triển tế bào của tổ chức cơ, bắp.\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eBổ sung Vitamin D3 tăng hấp thu Calci, chống còi xương, vitamin A, vitamin E\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eHướng dẫn sử dụng\u003c/strong\u003e\n\u003cp\u003eCho 1- 2 thìa cà phê vào cháo cho bé khi đang nấu, các mẹ cũng có thể cho 2 thìa cà phê vào nước sôi hoà tan lấy nước đó hầm cháo.\u003c/p\u003e\n\u003cp\u003eNgoài ra, súp sệt Hiroshi cũng rất thích hợp dùng để ướp hoặc nêm vào các món hấp, xào, súp, canh, nước dùng món lẩu, … giúp các bà nội trợ tiết kiệm được thời gian và công sức trong việc chế biến các món ăn vừa ngon lành, vừa bổ dưỡng và an toàn cho sức khoẻ của cả nhà\u003c/p\u003e\n\u003cp\u003eBảo quản : Để sản phẩm vào tủ lạnh sau khi mở nắp, dùng trong 4 tháng kể từ ngày khui hộp\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/20/6b/8e/f1d9c73f9cf94502c16a351b59c5e381.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/20/6b/8e/f1d9c73f9cf94502c16a351b59c5e381.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/20/6b/8e/f1d9c73f9cf94502c16a351b59c5e381.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/20/6b/8e/f1d9c73f9cf94502c16a351b59c5e381.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/20/6b/8e/f1d9c73f9cf94502c16a351b59c5e381.png"},{"base_url":"https://salt.tikicdn.com/ts/product/ed/aa/1c/e0fb106af16eff3379ac