xt":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":311000,"discount_rate":50,"rating_average":4.7,"review_count":112,"review_text":"(112)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/70/b9/45/44dd51a7668a724f19f41ef3a78619e1.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":372,"all_time_quantity_sold":489,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cul\u003e\n\u003cli style=\"text-align:center;\"\u003e\u003cstrong\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/70/b9/45/0f692a84cb3a75195304b511814f3790.png\" alt=\"Kẽm hỗ trợ trị mụn Puritan Pride Premium Zinc For\" width=\"750\" height=\"750\" /\u003e\u003c/strong\u003e\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eThực Phẩm Chức Năng - Viên Uống Kẽm Hỗ Trợ Trị Mụn Puritan'S Pride Premium Zinc For Acne 2580 (100 Viên) \u003c/strong\u003e\u003c/li\u003e\n\u003cli\u003eViên uống bổ sung kẽm hỗ trợ trị mụn được cơ thể hấp thu trực tiếp qua đường uống, người có làn da nhạy cảm quá mức cũng có thể yên tâm sử dụng\u003c/li\u003e\n\u003cli\u003eTác dụng của viên uống kẽm zinc for Acne Viên uống bổ sung kẽm zinc bổ sung những dưỡng chất thiết yếu chăm sóc da. Các loại thực phẩm khi vào cơ thể mất đi gần hết các vitamin có lợi do biến tính\u003c/li\u003e\n\u003cli\u003eTác dụng của viên uống kẽm zinc chống lại các gốc tự do trong cơ thể, ngăn ngừa tình trạng lão hóa da, cải thiện nếp nhăn, vết chân chim trên mặt\u003c/li\u003e\n\u003cli\u003eTăng cường kiểm soát hoạt động của tuyến bã nhờn, se khít lỗ chân lông, giảm thiểu tối đa các tác nhân gây ra mụn\u003c/li\u003e\n\u003cli\u003eViên uống bổ sung kẽm làm mềm da, cho da mịn màng, đủ độ ẩm, không còn hiện tượng khô ráp, nứt nẻ\u003c/li\u003e\n\u003cli\u003eHỗ trợ \u003cstrong\u003elàm mờ các nốt nám đen, sẹo thâm\u003c/strong\u003e trên da do thói quen nặn mụn. Kích thích tái tạo tế bào da mới, chống nhăn da, tăng cường độ đàn hồi, hạn chế chảy sệ da nhờ kích thích sản sinh collagen tự nhiên\u003c/li\u003e\n\u003cli\u003eCải thiện cấu trúc của da nhờ Puritan Pride zinc for Acne 100 viên, làm căng da, bóng da cho làn da trẻ trung\u003c/li\u003e\n\u003cli\u003eNgười có làn da mẫn cảm, dị ứng với kem bôi, phấn phủ có thể yên tâm chăm sóc da\u003c/li\u003e\n\u003cli\u003eViên uống bổ sung kẽm khi vào đến cơ thể sẽ thấm trực tiếp vào thành ruột non, cải thiện tận gốc triệu chứng lão hóa da\u003c/li\u003e\n\u003cli\u003eCon gái bước vào tuổi dậy thì thường bị mụn do thay đổi nội tiết tố cơ thể. Viên uống bổ sung kẽm zinc hạn chế xuất hiện mụn, làm xẹp các đốm mụn sưng gây đau, khó chịu.\u003c/li\u003e\n\u003cli\u003ePhụ nữ sau 30 tuổi, cơ thể bắt đầu suy giảm collagen tự nhiên, cấu trúc làn da bị phá vỡ trở nên nhăn nheo, chảy xệ nên bổ sung collagen tự nhiên cho cơ thể bằng zinc for Acne Puritan Pride.\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/70/b9/45/44dd51a7668a724f19f41ef3a78619e1.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/70/b9/