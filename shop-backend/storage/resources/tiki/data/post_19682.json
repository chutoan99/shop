:null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/49/26/78/894ad42f925d4a60d8637aafcd3b0934.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":854,"all_time_quantity_sold":8,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\n  \u003cp\u003eKem Tẩy Lông Huyền Phi 120ml Đánh Bay Vĩnh Viễn Mọi Loại Lông - An Toàn Không Đau Rát\u003c/p\u003e\n   \u003cp\u003e TẠI SAO KEM TẨY LÔNG PERFECT CLEAN LẠI ĐƯỢC KHÁCH HÀNG TIN DÙNG ĐẾN VẬY?\u003c/p\u003e\n   \u003cp\u003eKhi tẩy lông không đau rát, đơn giản, không mất quá nhiều thời gian\u003c/p\u003e\n   \u003cp\u003ePerfect Clean được chiết xuất hoàn toàn từ thành phần tự nhiên, luôn đi theo tiêu chí an toàn, thân thiện với làn da.\u003c/p\u003e\n   \u003cp\u003eĐược sản xuất theo quy trình khép kín, an toàn đạt tiêu chuẩn quốc tế\u003c/p\u003e\n   \u003cp\u003eHàng chính hãng được cấp giấy chứng nhận SẢN PHẨM ĐẠT TIÊU CHUẨN LƯU HÀNH DO SỞ Y TẾ CẤP.\u003c/p\u003e\n   \u003cp\u003eTiết kiệm chi phí hơn do với các phương pháp triệt lông khác\u003c/p\u003e\n   \u003cp\u003e SẢN PHẨM MANG LẠI KẾT QUẢ NHƯ THẾ NÀO?\u003c/p\u003e\n   \u003cp\u003e THÀNH PHẦN\u003c/p\u003e\n   \u003cp\u003e QUY TRÌNH THỰC HIỆN CÁC BƯỚC\u003c/p\u003e\n   \u003cp\u003eCách sử dụng đơn giản thôi các bạn nhé, chúng ta cùng đi vào từng bước cụ thể nhé:\u003c/p\u003e\n   \u003cp\u003eTrước tiên rửa sạch vùng da cần tẩy lông, lau thật khô da và thoa một lớp kem phủ kín vùng da cần tẩy.\u003c/p\u003e\n   \u003cp\u003eĐể kem lưu lại trên da khoảng 3-5 phút, dùng khăn bông hay bông gòn thấm nước vắt khô rồi lau thử một vùng lông, nếu lông đi dễ thì tiếp tục lau những vùng lông khác sau đó rửa sạch với nước.\u003c/p\u003e\n   \u003cp\u003eSau khi lau sạch lông và rửa lại bằng nước sạch thì lấy lượng serum vừa đủ thoa lên vùng vừa tẩy\u003c/p\u003e\n   \u003cp\u003eLưu ý: Không thoa kem tẩy lông lên da khi còn ướt, không được để kem lưu quá lâu. Nên sử dụng 1 lượng kem ở 1 khu vực nhỏ tại nơi bạn muốn tẩy, nếu sau 24h mà không xảy ra phản ứng xấu nào thì tiến hành tẩy toàn bộ. Không tẩy liên tục, lần thứ 2 cách lần đầu 10 ngày, các lần tiếp theo cách 20 ngày. Tuyệt đối không sử kem tẩy lông cho vùng da bị trầy xước, mẩn đỏ cháy nắng và ĐẶC BIỆT KHÔNG DÙNG CHO DA MẶT.\u003c/p\u003e\n   \u003cp\u003e CAM KẾT\u003c/p\u003e\n   \u003cp\u003ePHÁT HIỆN HÀNG GIẢ, HÀNG NHÁI ĐỀN NGAY 100TR\u003c/p\u003e\n   \u003cp\u003eSau 10 - 14 ngày sử dụng nếu không hiệu quả hoặc có hiện tượng kích ứng công ty sẽ hoàn 100% chi phí.\u003c/p\u003e\n   \u003cp\u003eNgười mua có thể trả hàng khi sản phẩm đến tay không giống với sản phẩm đã đặt hoặc sản phẩm quá hạn sử dụng.\u003c/p\u003e\n   \u003cp\u003eNgười mua có thể trả hàng khi sản phẩm bị lỗi trong quá trình vận chuyển và phải có video, hình ảnh khi bóc mở sản phẩm để xác nhận.\u003c/p\u003e\n   \u003cp\u003eNếu bạn chưa tìm được 1 sản phẩm tẩy lông hiệu quả, hãy để KEM TẨY LÔNG PERFECT CLEAN bước vào tim bạn nhé!\u003c/p\u003e\n   \u003cp\u003eXuất sứ: VIệt Nam\u003c/p\u003e\n   \u003cp\u003eNGày sản xuất: In trên bao bì sản phẩm\u003c/p\u003e\n   \u003cp\u003eHạn sử dụng: 24 tháng\u003c/p\u003e\n  \u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://