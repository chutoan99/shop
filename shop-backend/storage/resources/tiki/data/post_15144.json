":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/52/74/60/04ce2ee006cf523b70a99facead2dcb7.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1066,"all_time_quantity_sold":18,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eSUPERMATTE CUSHION - Phấn nước SIÊU MỊN LỲ - SIÊU KIỀM DẦU - SIÊU BỀN ĐẸP - NỀN MỊN LỲ 10 TIẾNG\u003c/p\u003e\n\u003cp\u003e CÔNG DỤNG SẢN PHẨM\u003cbr /\u003eSupermatte Cushion là phấn nước được nghiên cứu dành cho làn da dầu, da siêu dầu và da dầu mụn nhờ có lớp màng cực kỳ bền vững, kiểm soát dầu thừa hữu hiệu, hạn chế vỡ hay chảy nền do mồ hôi và bã nhờn dư thừa. Do đó, lớp nền của bạn sẽ bền chắc, ít xuống màu và lâu trôi.\u003c/p\u003e\n\u003cp\u003e LOẠI DA: Da dầu mụn, da dầu hoặc da siêu dầu, da hỗn hợp dầu.\u003c/p\u003e\n\u003cp\u003e 6 ƯU ĐIỂM VƯỢT TRỘI KHÔNG THỂ BỎ QUA\u003cbr /\u003e• Phấn nước siêu lỳ Supermatte Cushion mang kết cấu hạt phấn mềm mại siêu nhẹ với độ kết dính cao giúp lớp nền bám và bền chặt, nhờ vậy tạo được lớp trang điểm cực kỳ mượt mà, tự nhiên và nhẹ mặt.\u003cbr /\u003e• Phấn nước được bổ sung dầu dưỡng siêu nhẹ dễ bay hơi vào dung môi tạo bề mặt để giúp lớp nền dễ dàng tiệp nhanh vào da sau mỗi lần chạm, đồng thời dầu sẽ bay hơi ngay sau khi thoa để cho ra lớp nền lỳ và ráo mịn.\u003cbr /\u003e• Các hạt phấn siêu nhỏ được kết nối chặt chẽ với nhau để lớp nền luôn được giữ độ ổn định, bên cạnh đó hạt sắc tố còn có tính bền vững cao nên hạn chế khả năng xuống màu hiệu quả.\u003cbr /\u003e• Đăc biệt ít khi có một loại cushion nào được bổ sung đến 2% Niacinamide giúp làm dịu da, giảm sưng tấy mụn, kháng viêm kháng khuẩn cho da, hạn chế phát sinh mụn và hỗ trợ điều tiết độ ẩm trên da. \u003cbr /\u003e• Kem nền có thành phần chống nắng cao nằm ở vị trí thứ 4 của bảng thành phần với chỉ số lên đến SPF50\u0026#43; PA\u0026#43;\u0026#43;\u0026#43; để tăng cường bảo vệ da cả ngày.\u003c/p\u003e\n\u003cp\u003e HƯỚNG DẪN SỬ DỤNG\u003cbr /\u003eNhấn một lượng vừa đủ kem nền và dùng mút/cọ tán đều lên mặt. Có thể tăng cường che phủ bằng cách dặm thêm nhiều lớp phấn nước cho đến khi cảm thấy lớp nền hoàn hảo.\u003c/p\u003e\n\u003cp\u003e TONE DA:\u003cbr /\u003e#. - phù hợp cho tone da trắng sáng nhưng không phải trắng bệt và nhợt nhạt.\u003cbr /\u003e#.  - phù hợp cho tone da trung bình đến trung bình sáng, tự nhiên và hài hòa, đây cũng là màu sắc dễ phù hợp với đại đa số chị em chúng mình.\u003cbr /\u003e#. - phù hợp cho tone da tự nhiên, da vàng hoặc da hơi tối màu.\u003c/p\u003e\n\u003cp\u003eTHÔNG TIN THƯƠNG HIỆU:\u003cbr /\u003eLemonade - nhãn hàng Makeup làm riêng cho phụ nữ Việt Nam được nghiền ngẫm, nghiên cứu và đúc kết dựa theo kinh nghiệm thực hành trang điểm gần 10 năm qua của Quách Ánh, để đưa ra những giải pháp làm đẹp tối ưu và hiệu quả nhất.\u003c/p\u003e\n\u003cp\u003eThời gian sử dụng tốt nhất: 12 tháng từ khi mở nắp\u003cbr /\u003eHSD \u0026amp; NSX: 03 năm kể từ ngày SX (ghi trên bao bì)\u003cbr /\u003eXuất xứ thương hiệu: Việt Nam\u003cbr /\u003eSản xuất tại: Hàn Quốc\u003cbr /\u003eQuy cách: Cushion 15g\u003cbr /\u003eHướng dẫn bảo quản: Nơi khô ráo thoáng mát, tránh ánh nắng trực tiếp\u003cbr /\u003eThành phần: Xem chi tiết trên bao bì sản phẩm\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/52/74/60/04ce2ee006cf523b70a99facead2dcb7.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/52/74/60/04ce2ee006cf523b70a99facead2dcb7.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/52/74/60/04ce2ee006cf523b70a99facead2dcb7.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/52/74/60/04ce2ee006cf523b70a99facead2dcb7.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/52/74/60/04ce2ee006cf523b70a99facead2dcb7.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/2c/38/9a/97acf2c3092470f1239afdd772d9994c.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/2c/38/9a/97acf2c3092470f1239afdd772d9994c.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/2c/38/9a/97acf2c3092470f1239afdd772d9994c.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2c/38/9a/97acf2c3092470f1239afdd772d9994c.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2c/38/9a/97acf2c3092470f1239afdd772d9994c.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/98/80/f1/94cc6cf9e4db87b923b7b66c73cd0577.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/98/80/f1/94cc6cf9e4db87b923b7b66c73cd0577.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/98/80/f1/94cc6cf9e4db87b923b7b66c73cd0577.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/98/80/f1/94cc6cf9e4db