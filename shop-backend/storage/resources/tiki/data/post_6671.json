rite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/a5/5b/6e/94a3b1a5d0fdc9ee4758311106cfab24.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":0,"all_time_quantity_sold":35,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch5 style=\"text-align:justify;\"\u003e \u003c/h5\u003e\n\u003ch1 class=\"product-title product_title entry-title\"\u003eBình nước nóng Ferroli Rita FS-4.5TE đa nhiệm, chống giật\u003c/h1\u003e\n\u003cdiv class=\"product-short-description\"\u003e\n\u003cul class=\"prd-attributesList ui-listBulleted js-short-description\"\u003e\n\u003cli\u003eChống rò điện ELCB\u003c/li\u003e\n\u003cli\u003eDòng máy đa nhiệm chịu áp có thể lắp dùng trực tiếp hoặc gián tiếp \u003c/li\u003e\n\u003cli\u003eBộ ngắt cảm biến lưu lượng\u003c/li\u003e\n\u003cli\u003eRowle chống quá nhiệt\u003c/li\u003e\n\u003cli\u003eChống thấm nước IPX4\u003c/li\u003e\n\u003cli\u003eTương thích điện từ\u003c/li\u003e\n\u003cli\u003eChịu áp lực nước tối đa 0.6 bar\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/div\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003eMáy Nước Nóng Ferroli Rita FS-4.5TE (4500W)\u003c/strong\u003e có thiết kế màu trắng sang trọng cùng kích thước vô cùng nhỏ gọn, sẽ không chiếm nhiều diện tích không gian của bạn.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"Máy Nước Nóng Trực Tiếp Không Bơm Ferroli Rita FS-4.5TE - Trắng\" src=\"http://tikicdn.com/media/catalog/product/t/h/thiet-ke-sang-trong.u2751.d20161021.t111043.220191.jpg\" alt=\"Máy Nước Nóng Trực Tiếp Không Bơm Ferroli Rita FS-4.5TE - Trắng\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003ch5\u003eCó thể dùng trong nhà bếp\u003c/h5\u003e\n\u003cp style=\"text-align:justify;\"\u003eĐáp ứng nhu cầu sử dụng nguồn nước nóng đa dạng ngày nay, máy nước nóng Rita được thiết kế để bạn có thể dễ dàng kết nối với các thiết bị sen vòi, vòi rửa… trong phòng tắm lẫn nhà bếp. Bạn không những có thể sử dụng nước nóng để tắm mà còn có thể dùng để rửa bát, nấu nướng, lau dọn nhà bếp…\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"Máy Nước Nóng Trực Tiếp Không Bơm Ferroli Rita FS-4.5TE - Trắng\" src=\"http://tikicdn.com/media/catalog/product/c/o/co-the-dung-trong-nha-bep.u2751.d20161021.t111042.898084.jpg\" alt=\"Máy Nước Nóng Trực Tiếp Không Bơm Ferroli Rita FS-4.5TE - Trắng\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003ch5 style=\"text-align:justify;\"\u003eAn toàn tuyệt đối khi sử dụng\u003c/h5\u003e\n\u003cp style=\"text-align:justify;\"\u003eMáy Nước Nóng Ferroli Rita FS-4.5TE sử dụng cơ chế làm nóng nước bằng dung môi nóng hiện đại, không phải thông qua thanh đun nhiệt bằng điện thông thường nên bạn có thể hoàn toàn yên tâm về hiện tượng rò rỉ điện trong quá trình sử dụng.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"Máy Nước Nóng Trực Tiếp Không Bơm Ferroli Rita FS-4.5TE - Trắng\" src=\"http://tikicdn.com/media/catalog/product/a/n/an-toan-khi-su-dung.u2751.d20161021.t111042.855953.jpg\" alt=\"Máy Nước Nóng Trực Tiếp Không Bơm Ferroli Rita FS-4.5TE - Trắng\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003ch5\u003eNhiều chế độ bảo vệ\u003c/h5\u003e\n\u003cp style=\"text-align:justify;\"\u003eNgoài chế độ làm nóng tách điện vô cùng an toàn, Ferroli Rita FS-4.5TE còn trang bị nhiều chức năng bảo vệ khác như: chế độ phát hiện lỗi trong lúc sử dụng, chế độ chống quá nhiệt, chống cháy khô khi lượng nước trong bình quá thấp, bộ lọc nâng cao chất lượng nước và kéo dài tuổi thọ cho thiết bị.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"Máy Nước Nóng Trực Tiếp Không Bơm Ferroli Rita FS-4.5TE - Trắng\" src=\"http://tikicdn.com/media/catalog/product/n/h/nhieu-che-do-bao-ve.u2751.d20161021.t111042.990681.jpg\" alt=\"Máy Nước Nóng Trực Tiếp Không Bơm Ferroli Rita FS-4.5TE - Trắng\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003ch5\u003eBộ chống rò điện ELCB\u003c/h5\u003e\n\u003cp style=\"text-align:justify;\"\u003eBất cứ khi nào có sự rò điện thông qua cơ thể người khi và các phần mang điện trong thiết bị, ELCB sẽ ngay lập tức ngắt kết nối với nguồn điện để đảm bảo an toàn cho người sử dụng.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"Máy Nước Nóng Trực Tiếp Không Bơm Ferroli Rita FS-4.5TE - Trắng\" src=\"http://tikicdn.com/media/catalog/product/e/l/elcb.u2751.d20161021.t111042.962656.jpg\" alt=\"Máy Nước Nóng Trực Tiếp Không Bơm Ferroli Rita FS-4.5TE - Trắng\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003ch5\u003eThay đổi công suất linh hoạt\u003c/h5\u003e\n\u003cp style=\"text-align:justify;\"\u003eFerroli Rita FS-4.5TE cho phép bạn điều chỉnh 3 mức độ công suất sử dụng phù hợp tùy theo nhiệt độ môi trường bên ngoài, đảm bảo bạn luôn có dòng nước với nhiệt độ thích hợp để sử dụng mà vẫn tiết kiệm điện tối đa.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"Máy Nước Nóng Trực Tiếp Không Bơm Ferroli Rita FS-4.5TE - Trắng\" src=\"http://tikicdn.com/media/catalog/product/c/o/cong-suat-thay-doi-linh-hoat.u2751.d20161021.t111042.934490.jpg\" alt=\"Máy Nước Nóng Trực Tiếp Không Bơm Ferroli Rita FS-4.5TE - Trắng\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003ch3 class=\"title_tn\"\u003eDỄ DÀNG KẾT NỐI VỚI NHIỀU THIẾT BỊ SEN VÒI, VÒI RỬA\u003c/h3\u003e\n\u003cp\u003eDễ dàng kết nối đồng thời với các thiết bị sen vòi, vòi rửa... phục vụ mọi nhu cầu nước nóng trong phòng bếp và phòng tắm\u003c/p\u003e\n\u003cdiv class=\"real-width infor-detail-pro\"\u003e\n\u003cdiv class=\"product_detail\"\u003e\n\u003cdiv class=\"tinh_nang\"\u003e\n\u003cdiv class=\"info_tinhnang\"\u003e\n\u003ch3 class=\"title_tn\"\u003eVAN ĐIỀU CHỈNH LƯU LƯỢNG THUẬN TIỆN, CHẤT LƯỢNG\u003c/h3\u003e\n\u003cp\u003eVan điều chỉnh lưu lượng đặc biệt, dễ dàng điều chỉnh lưu lượng nước như ý muốn. Có độ bền cao.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://ferroli.com.vn/wp-content/uploads/2015/11/van-dieu-chinh-am-luong.jpg\" width=\"272\" height=\"350\" alt=\"van-dieu-chinh-am-luong.jpg\" /\u003e\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"real-width\"\u003e\n\u003cdiv class=\"list-product-viewed clearfix\"\u003e\n\u003ch4\u003e \u003c/h4\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cp\u003e\u003cstrong\u003eShop Điện Máy Huy Ngọc hỗ trợ lắp miễn phí cho quý khách hàng khu vực Thành Phố Hồ Chí Minh:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eShop \u003cstrong\u003eMIỄN PHÍ\u003c/strong\u003e lắp đặt cho khách hàng trong phạm vi Thành Phố Hồ Chí Minh (Huyện Cần giờ và Huyện Củ Chi lắp đặt theo thỏa thuận chi phí đi lại của kỹ tuật với  khách) khách hàng có nhu cầu sau khi nhận hàng vui lòng liên hệ Tiki để tiki báo shop hoặc sử dụng ứng dụng chát trực tiếp với shop để lên lịch lắp đặt với kỹ thuật.\u003c/p\u003e\n\u003cp\u003eĐể đảm bảo kỹ thuật tới lắp được quý khách phải hoàn thiện đầu nước chờ nước phi 21 răng ngoài, điện, nước có sẵn và vật tư kết nối chuẩn bị sẵn.\u003c/p\u003e\n\u003cp\u003eShop cam kết kỹ thuật sẽ lắp đặt trễ nhất trong vòng 24h làm việc kể từ khi quý khách nhận được hàng.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product