ll,"text":null}],"badges_v3":[{"placement":"pdp_badge","code":"text_badge","type":"text_badge","index":0,"icon":null,"icon_width":0,"icon_height":0,"text_color":"#FFF0F1","background_color":"#D93843","href":null,"text":"9.9"},{"placement":"pdp_badge","code":"is_hero","type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":true,"return_reason":"any_reason"}},"discount":70000,"discount_rate":20,"rating_average":4.5,"review_count":46,"review_text":"(46)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/53/b2/49/d2f20c9125325f9f17e375707160cc1e.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1849,"all_time_quantity_sold":240,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<h2 style=\"box-sizing: border-box; color: #333333; width: 777px; margin-top: 0px; margin-bottom: 0.5em; text-rendering: optimizespeed; font-size: 1.6em; line-height: 1.3; font-family: Roboto, sans-serif;\">I. Giới thiệu sản phẩm </h2>\n<p style=\"box-sizing: border-box; margin-bottom: 1.3em; margin-top: 0px; color: #242222; font-family: Helvetica, sans-serif; font-size: 16px;\"><strong>Nhang nụ Trầm Hương</strong> thực chất cũng là Trầm Hương nhưng nó được chế tác từ bột gỗ Trầm Hương xay mịn. Gỗ Trầm Hương được xay nhuyễn sẽ được kết hợp với keo của một loại cây tự nhiên mà tạo thành một hỗ hợp có độ kết dính vừa đủ để tạo thành hình. Sau đó người ta sẽ nắn tạo thành hình chóp trụ, nón hoặc là búp sen,… tùy vào thẩm mỹ của mỗi người. Tuy có nhiều hình dáng khác nhau nhưng những dạng này của trầm được gọi chung là Nhang nụ Trầm Hương và thường được dùng trong thiền định, xông nhà hoặc yoga</p>\n<p style=\"box-sizing: border-box; margin-bottom: 1.3em; margin-top: 0px; color: #242222; font-family: Helvetica, sans-serif; font-size: 16px;\">40 nụ / hộp</p>\n<p style=\"box-sizing: border-box; margin-bottom: 1.3em; margin-top: 0px; color: #242222; font-family: Helvetica, sans-serif; font-size: 16px;\">Lưu ý: KHÓI SẼ BẮT ĐẦU CHẢY NGƯỢC XUỐNG THÁC KHI CHÁY TỪ 1/3 NỤ VÀ ĐẶT TRONG MÔI TRƯỜNG ÍT GIÓ</p>\n<h2 style=\"box-sizing: border-box; color: #333333; width: 777px; margin-top: 0px; margin-bottom: 0.5em; text-rendering: optimizespeed; font-size: 1.6em; line-height: 1.3; font-family: Roboto, sans-serif;\">II. Mô tả chi tiết</h2>\n<h3 style=\"box-sizing: border-box; color: #333333; width: 777px; margin-top: 0px; margin-bottom: 0.5em; text-rendering: optimizespeed; font-size: 1.25em; font-family: Roboto, sans-serif;\">1. Công dụng</h3>\n<p style=\"box-sizing: border-box; margin-bottom: 1.3em; margin-top: 0px; color: #242222; font-family: Helvetica, sans-serif; font-size: 16px;\">Nhang nụ Trầm Hương thường được dùng để thanh lọc không khí, điều trị bệnh về đường hô hấp. Theo thử nghiệm cho thấy các mẫu tinh dầu Trầm Hương có trên 60 hợp chất hữu cơ, trong đó có nhiều hợp chất thơm được dùng để chế biến mỹ phẩm cao cấp.</p>\n<ul style=\"box-sizing: border-box; list-style-position: initial; list-style-image: initial; margin-top: 0px; padding: 0px; margin-bottom: 1.3em; color: #242222; font-family: Helvetica, sans-serif; font-size: 16px;\">\n<li style=\"box-sizing: border-box; margin-bottom: 0.6em; margin-left: 1.3em;\">Chính nhờ hương thơm của tinh dầu trong gỗ, mà khi đốt, hương thơm từ nhang nụ trầm có thể giúp thanh lọc không khí, tạo không gian tươi mới, chữa khản tiếng, các bệnh về đường hô hấp, xua đuổi tà ma,..</li>\n<li style=\"box-sizing: border-box; margin-bottom: 0.6em; margin-left: 1.3em;\"> Ngoài các công dụng đặc trưng trên thì nó còn các công dụng đặc trưng của Trầm Hương không thể bàn cãi như: Ông hoàng phong thủy, thu hút tài lộc, thay đổi vận mệnh,…</li>\n</ul>\n<h3 style=\"box-sizing: border-box; color: #333333; width: 777px; margin-top: 0px; margin-bottom: 0.5em; text-rendering: optimizespeed; font-size: 1.25em; font-family: Roboto, sans-serif;\">2. Cách dùng</h3>\n<p style=\"box-sizing: border-box; margin-bottom: 1.3em; margin-top: 0px; color: #242222; font-family: Helvetica, sans-serif; font-size: 16px;\"><strong>Nhang nụ Trầm Hương</strong> được tạo ra cũng có mục đích riêng của nó. Một số cách sử dụng nhang nụ Trầm Hương phổ biến của người Việt như:</p>\n<ul style=\"box-sizing: border-box; list-style-position: initial; list-style-image: initial; margin-top: 0px; padding: 0px; margin-bottom: 1.3em; color: #242222; font-family: Helvetica, sans-serif; font-size: 16px;\">\n<li style=\"box-sizing: border-box; margin-bottom: 0.6em; margin-left: 1.3em;\">Đốt nhang nụ Trầm Hương trên đĩa: là phương pháp đơn giản nhất. Chỉ cần chuẩn bị một đĩa đốt bằng gốm sứ, gỗ hoặc đất nung, để chống cháy, phỏng khi tàn nhang rơi xuống.</li>\n<li style=\"box-sizing: border-box; margin-bottom: 0.6em; margin-left: 1.3em;\">Sử dụng lư sứ xông Trầm: Đặt Trầm vào trong các lư xông giúp cho văn phòng làm việc, bàn thờ, phòng trà thêm thanh lịch, ấm cúm hơn. Chỉ cần châm lửa trên đỉnh nụ rồi đặt nụ trầm vào bên trong lư và đậy nắp lư. Khói trầm tỏa lên trên cao đi theo các khe nhỏ trên đỉnh lư mà tỏa ra nhẹ nhàng, tinh tế. Cách này cũng giúp dễ dàng trong việc dọn vệ sinh khi nhang cháy hết.</li>\n<li style=\"box-sizing: border-box; margin-bottom: 0.6em; margin-left: 1.3em;\">Sử dụng thác khói Trầm Hương: Thác khói phổ biến đối với doanh nhân và người yêu phong thủy, thác khói Trầm Hương được xem là thú chơi cảnh tao nhã, đem lại sự thư thái an nhàn khi công việc căng thẳng. Khói trầm tỏa lên trên và chảy ngược xuống dưới lỗ nụ và nó sẽ lan tỏa lên trên cao, một phần khói chảy ngược xuống bên dưới theo cấu trúc thác trầm. Thác khói trầm hương là một thú vui an nhàn, giúp tịnh tâm trí trong công việc và đời sống'</li>\n</ul>\n<p><img class=\"aligncenter wp-image-9081 size-full lazyloaded\" style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://thienmochuong.com/wp-content/uploads/2019/07/Nhang-N%E1%BB%A5-tr%E1%BA%A7m-h%C6%B0%C6%A1ng-cao-c%E1%BA%A5p-2-scaled.jpg\" alt=\"\" width=\"750\" height=\"500\" data-ll-status=\"loaded\" /></p>\n<p>Nhang nụ Trầm Hương thực chất cũng là Trầm Hương nhưng nó được chế tác từ bột gỗ Trầm Hương xay mịn. Gỗ Trầm Hương được xay nhuyễn sẽ được kết hợp với keo của một loại cây tự nhiên mà tạo thành một hỗ hợp có độ kết dính vừa đủ để tạo thành hình. Sau đó người ta sẽ nắn tạo thành hình chóp trụ, nón hoặc là búp sen,… tùy vào thẩm mỹ của mỗi người. Tuy có nhiều hình dáng khác nhau nhưng những dạng này của trầm được gọi chung là Nhang nụ Trầm Hương và thường được dùng trong thiền định, xông nhà hoặc yoga.</p>\n<h2><strong><img class=\"aligncenter size-full wp-image-9082 lazyloaded\" style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://thienmochuong.com/wp-content/uploads/2019/07/Nhang-N%E1%BB%A5-tr%E1%BA%A7m-h%C6%B0%C6%A1ng-cao-c%E1%BA%A5p-5-scaled.jpg\" alt=\"\" width=\"750\" height=\"500\" data-ll-status=\"loaded\" /></strong><span style=\"font-size: 12pt; font-family: Arial; color: #000000; background-color: transparent; font-variant-numeric: normal; font-variant-east-asian: normal; vertical-align: baseline; white-space: pre-wrap;\"> </span></h2><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/53/b2/49/d2f20c9125325f9f17e375707160cc1e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/53/b2/49/d2f20c9125325f9f17e375707160cc1e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/53/b2/49/d2f20c9125325f9f17e375707160cc1e.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/53/b2/49/d2f20c9125325f9f17e375707160cc1e.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/53/b2/49/d2f20c9125325f9f17e375707160cc1e.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/23/7a/bf/ceb1edd5294b1e92821855e66cff980b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/23/7a/bf/ceb1edd5294b1e92821855e66cff980b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/23/7a/bf/ceb1edd5294b1e92821855e66cff980b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/23/7a/bf/ceb1edd5294b1e92821855e66cff980b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/23/7a/bf/ceb1edd5294b1e92821855e66cff980b.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/32/06/96/868ba3ae06de5c4ea95bb0e3954c30e3.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/32/06/96/868ba3ae06de5c4ea95bb0e3954c30e3.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/32/06/96/868ba3ae06de5c4ea95bb0e3954c30e3.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/20