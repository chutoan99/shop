xt":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ca/c3/c6/2e204852e95eac35e0a7105cb0b0c9c4.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":225,"all_time_quantity_sold":6,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e1. Giới thiệu thông tin chung:\u003c/p\u003e\n\u003cp\u003eCombo 4 cuốn truyện cảm xúc: Khi Cú con sợ hãi, Khi Gấu con lo lắng, Khi Hà Mã tức giận, Khi Sư Tử nhút nhát\u003c/p\u003e\n\u003cp\u003eThương hiệu: Mochibooks\u003c/p\u003e\n\u003cp\u003eKích thước: 25x25 cm\u003c/p\u003e\n\u003cp\u003eSố trang 1 cuốn: 36 trang\u003c/p\u003e\n\u003cp\u003eNhà xuất bản: Lao động\u003c/p\u003e\n\u003cp\u003eNăm xuất bản: 2023\u003c/p\u003e\n\u003cp\u003eNhà phát hành: Mochibooks\u003c/p\u003e\n\u003cp\u003eGiá: 436.000đ\u003c/p\u003e\n\u003cp\u003eMã ISBN: 9786043934465\u003c/p\u003e\n\u003cp\u003eSách được in 4 màu trên giấy Couches 120gsm, bìa Ivory 300gsm mạ vàng tên sách.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e2. Giới thiệu nội dung bộ sách\u003c/p\u003e\n\u003cp\u003eGồm 4 cuốn:\u003c/p\u003e\n\u003cp\u003eKhi Cú con sợ hãi\u003c/p\u003e\n\u003cp\u003eKhi Gấu con lo lắng\u003c/p\u003e\n\u003cp\u003eKhi Hà Mã tức giận\u003c/p\u003e\n\u003cp\u003eKhi Sư Tử nhút nhát\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eTức giận, lo lắng, sợ hãi, nhút nhát là những cảm xúc phổ biến và là một phần không thể thiếu trong quá trình trưởng thành của mỗi đứa trẻ. Vì vậy, bố mẹ đừng quá lo lắng hay khắt khe với những cảm xúc tiêu cực của con, mà hãy mở lòng và cùng con vượt qua chúng nhé!\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eVới mong muốn mang lại cho các thiên thần nhỏ những trải nghiệm gần gũi với thế giới tình cảm và khám phá bản chất của cảm xúc, Mochibooks mang đến Combo truyện tranh \"Con và cảm xúc của con\" - giúp con hàm dưỡng cảm xúc.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eBộ sách gồm 4 tập truyện tranh độc đáo: \"Khi Sư Tử nhút nhát,\" \"Khi Hà Mã tức giận,\" \"Khi Gấu Con lo lắng,\" và \"Khi Cú Con sợ hãi\". Mỗi cuốn sách là một chuyến phiêu lưu tuyệt vời, nơi các con không chỉ làm quen với những nhân vật đáng yêu mà còn được hàm dưỡng về cảm xúc.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eCon được hòa mình vào thế giới của các loài động vật\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eCác con được bước vào thế giới của muôn thú, từ chú cú nhỏ, sư tử, đến hà mã, gấu con,... Những hình ảnh hoạt hình các loài động vật đáng yêu và màu sắc tươi sáng trong sách sẽ khơi gợi tò mò và hứng thú của các con, giúp các con dễ dàng tiếp thu câu chuyện.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eHọc tiếng Anh một cách tự nhiên\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eBộ truyện song ngữ Anh - Việt với từ vựng đơn giản, dễ hiểu, giúp các con rèn kỹ năng đọc hiểu và mở rộng vốn từ vựng, khả năng giao tiếp bằng cách tiếp xúc với ngôn ngữ theo cách thú vị và phong phú. Các con không những được giải trí, vui chơi, bồi dưỡng cảm xúc, mà còn được học tiếng Anh một cách tự nhiên nữa.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eGiúp bố mẹ đồng hành cùng con trên chặng đường hàm dưỡng cảm xúc\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eĐiều khác biệt của \"Con và Cảm Xúc của Con\" chính là sự kết hợp hài hòa giữa truyện tranh cho cách con và lời khuyên cho phụ huynh. Cuối mỗi cuốn sách, bố mẹ sẽ tìm thấy những lời khuyên thân thiện, giúp bố mẹ hiểu rõ hơn về cảm xúc của con và cách đồng hành cùng con vượt qua những cảm xúc tiêu cực ấy. \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003ePhong cách viết gần gũi, mềm mại và giàu tình cảm trong combo sách này sẽ tạo ra một không gian an lành và thấm đượm yêu thương. Bố mẹ có thể cùng con thả lỏng tâm hồn vào từng trang, cùng nhau khám phá, tìm hiểu và trưởng thành.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e-------------------\u003c/p\u003e\n\u003cp\u003e*Đôi lời nhắn nhủ: Cảm ơn bạn đã lựa chọn sách của Mochibooks. Sau khi nhận hàng, nếu bạn cảm thấy hài lòng hãy gửi cho chúng mình những phản hồi tích cực như đánh giá 5 sao, feedback hình ảnh và đừng quên nhấn theo dõi nha. Nếu sản phẩm đến tay bạn có bị móp, méo, rách thì hãy liên hệ với chúng mình để được hỗ trợ tốt nhất nhé.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ca/c3/c6/2e204852e95eac35e0a7105cb0b0c9c4.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ca/c3/c6/2e204852e95eac35e0a7105cb0b0c9c4.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ca/c3/c6/2e204852e95eac35e0a7105cb0b0c9c4.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ca/c3/c6/2e204852e95eac35e0a7105cb0b0c9c4.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ca/c3/c6/2e204852e95eac35e0a7105cb0b0c9c4.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/ff/8c/f0/2f6c557eab0828638db01a0acad9253d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ff/8c/f0/2f6c557eab0828638db01a0acad9253d.jpg","medium_u