authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":20000,"discount_rate":10,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/e0/44/e7/2bf2ad28bf9e33ae5f5f34750580b2e2.JPG","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":537,"all_time_quantity_sold":3,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\n  \u003cul\u003e\u003cli\u003e\u003cp\u003eSản phẩm Nutrience Subzero Fraser Valley - Thức Ăn Hạt Cho Mèo sử dụng các nguồn nguyên liệu tự nhiên tươi sống của Canada như thịt bò, bò tót bison, heo rừng, cá biển đại dương và hạt thịt gà tươi sấy lạnh sấy lạnh để cho ra hương vị tuyệt hảo có thể khiến cho những chú mèo cưng khó tính nhất cũng phải thèm ăn.\u003c/p\u003e\n   \u003cp\u003e- Giàu protein:\u003c/p\u003e\n   \u003cp\u003eTất cả nguyên liệu như gà tây rút xương, gà tây, cá hồi đại dương, cá trích và cá tuyết Canada đều được cung cấp tươi sống không qua bảo quản đông lạnh.\u003c/p\u003e\n   \u003cp\u003eThịt gà tươi được hòa trộn với thịt vẹm xanh, gan cá tuyết đại dương, bí ngô và tảo biển Acadian sau đó được sấy lạnh khép kín để giữ nguyên chất lượng của thịt tươi sống, tạo nên hương vị tuyệt hảo và hỗ trợ sức khỏe phát triển tối ưu nhất.\u003c/p\u003e\n   \u003cp\u003e- Trái cây và rau củ tươi xanh:\u003c/p\u003e\n   \u003cp\u003eTrái cây và rau củ quả tươi xanh có chứa hàm lượng rất cao các chất chống oxi hóa và đặc tính dinh dưỡng thực vật.\u003c/p\u003e\n   \u003cp\u003e- Dầu dừa \u0026amp; thực vật:\u003c/p\u003e\n   \u003cp\u003eMột hỗn hợp thực vật đặc biệt và dầu dừa được sử dụng để cung cấp nhiều lợi ích sức khỏe.\u003c/p\u003e\n   \u003cp\u003e- Nguồn axit béo Omega-3 từ biển:\u003c/p\u003e\n   \u003cp\u003eDầu cá hồi, dầu cá trích và gan cá tuyết được sử dụng như là nguồn cung cấp chủ yếu DHA và EPA axit béo omega-3 để đảm bảo da lông thú cưng luôn khỏe mạnh cũng như hỗ trợ và phát triển nhận thức của trí não.\u003c/p\u003e\n   \u003cp\u003eChất xơ hòa tan và men vi sinh cung cấp prebiotics và probiotic giúp cung cấp sự hấp thụ tốt hơn các chất dinh dưỡng và phát triển hệ tiêu hóa khỏe mạnh hơn, trong khi hàm lượng glucosamine và chondroitin cung cấp bảo vệ xương khớp sự linh động cho thú cưng của bạn.\u003c/p\u003e\n   \u003cp\u003e- THÀNH PHẦN NGUYÊN LIỆU:\u003c/p\u003e\n   \u003cp\u003eThịt gà rút xương, gà tây rút xương, bột thịt gà, bột thịt gà tây, cá hồi, gan gà, tim gà, gan gà tây, tim gà tây, cá trích, cá tuyết, gan cá tuyết, trứng, đậu Hà Lan, mỡ gà (được bảo quản bằng hỗn hợp tocopherols – nhóm chất quan trọng có trong Vitamin E), đậu lăng đỏ, khoai lang, đậu gà, vị thịt gà tự nhiên, bột cỏ linh lăng, thịt gà sấy đông lạnh, bí ngô sấy đông lạnh, gan gà sấy đông lạnh, vẹm vỏ xanh sấy đông lạnh, gan cá tuyết sấy đông lạnh, tảo bẹ sấy đông lạnh, dầu cá hồi, dầu cá trích, dầu dừa, bí ngô, bí nghệ, cà rốt, rau bina, bông cải xanh, táo, việt quất, nam việt quất, lựu, chiết xuất từ quả cây bách xù, gừng, thì là, hoa cam cúc, lá bạc hà, rễ cam thảo, nghệ, rễ cây nữ lang, Vitamin tổng hợp\u003c/p\u003e\n   \u003cp\u003eXuất xứ Canada\u003c/p\u003e\n   \u003cp\u003eHSD: 12 tháng từ ngày sản xuất trên bao bì\u003c/p\u003e\n  \u003c/li\u003e\u003c/ul\u003e\n \u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/e0/44/e7/2bf2ad28bf9e33ae5f5f34750580b2e2.JPG","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e0/44/e7/2bf2ad28bf9e33ae5f5f34750580b2e2.JPG","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e0/44/e7/2bf2ad28bf9e33ae5f5f34750580b2e2.JPG","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e0/44/e7/2bf2ad28bf9e33ae5f5f34750580b2e2.JPG","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e0/44/e7/2bf2ad28bf9e33ae5f5f34750580b2e2.JPG"},{"base_url":"https://salt.tikicdn.com/ts/product/ea/ed/17/682b36ca2480f1b84ff305cd8a4a3354.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ea/ed/17/682b36ca2480f1b84ff305cd8a4a3354.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ea/ed/17/682b36ca2480f1b84ff305cd8a4a3354.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ea/ed/17/682b36ca2480f1b84ff305cd8a4a3354.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ea/ed/17/682b36ca2480f1b84ff305cd8a4a3354.png"},{"base_url":"https://salt.tikicdn.com/ts/product/38/47/44/b194b75d47a2aceccd3375f95ed0cb5d.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/38/47/44/b194b75d47a2aceccd3375f95ed0cb5d.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/38/47/44/b194b75d47a2aceccd3375f95ed0cb5d.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/38/47/44/b194b75d47a2aceccd3375f95ed0cb5d.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/38/47/44/b194b75d47a2aceccd3375f95ed0cb5d.png"},{"base_url":"https://salt.tikicdn.com/ts/product/fc/58/94/372344ab34fc5473ecb1e5d2b0c