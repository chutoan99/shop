_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/7c/ad/cc/a0e7f6777b6946747762974ff10bb8cc.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1107,"all_time_quantity_sold":13,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<h1><em>Serum dưỡng ẩm và chống lão hóa Senka Deep Moist 3X HA 30ml</em></h1>\n<div>Serum dưỡng ẩm và chống lão hóa Senka Deep Moist 3X HA là dòng sản phẩm mới ra mắt đến từ thương hiệu Senka nổi tiếng lâu đời của Nhật Bản, chứa Hyaluronic Acid đậm đặc giúp cấp ẩm tức thì và tăng cường độ ẩm cho làn da suốt 24 giờ, hỗ trợ làm đầy các nếp nhăn, mang lại làn da căng mịn và rạng rỡ.</div>\n<div>\n<p><img style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/product/45/bc/6b/57be45fd0ff19ad4f476f778da54b936.jpg\" width=\"600\" height=\"600\" /></p>\n<p><strong>Thành phần chính:</strong><br />- 3X Hyaluronic Acid<br />- Collagen<br />- Chiết xuất thiên nhiên Nhật Bản: Cám Gạo, Tơ Tằm Trắng, Mật Ong<br />- Không cồn - Không chất tạo màu - Không hương liệu</p>\n<p><img style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/product/5c/db/47/954b567707b8a84de12e2d23acae4b65.jpg\" width=\"600\" height=\"600\" /></p>\n<p><strong>Công dụng:</strong><br />- 2X Hyaluronic Acid: cấp ẩm sâu<br />- Hyaluronic Acid Vi Nang: chứa các hạt dưỡng ẩm siêu nhỏ thấm sâu vào tầng biểu bì, cung cấp trọn vẹn dưỡng chất và tối ưu hóa hiệu quả khóa ẩm trong thời gian dài, mang lại làn da trong mướt và căng mịn<br />- Chiết xuất Collagen chống oxy hóa cùng các thành phần thiên nhiên: Dầu Cám Gạo, Mật Ong, Tơ Tằm Trắng giúp da ẩm mượt, đàn hồi &amp; tươi trẻ</p>\n<p><img style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/product/3b/98/0f/c62f33b404406fde50d23a5188f599bb.jpg\" width=\"600\" height=\"600\" /></p>\n<p><strong>Loại da phù hợp</strong><br />Mọi loại da, kể cả da nhạy cảm<br /><strong>Hướng dẫn sử dụng:</strong><br />- Lấy một lượng sản phẩm vừa đủ lên lòng bàn tay và thoa đều khắp mặt &amp; cổ vào buổi sáng và tối.<br />- Sử dụng hằng ngày cho làn da căng mịn, ẩm mượt, đàn hồi và trong mướt.</p>\n<p><img style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/product/bb/cd/a7/cb69b97e138549c6263d814f2d72f597.jpg\" width=\"600\" height=\"338\" /></p>\n<p><strong>Thông tin dị ứng:</strong><br />- Không sử dụng cho vùng da bị tổn thương.<br />- Ngưng sử dụng ngay khi có biểu hiện kích ứng và hỏi ý kiến bác sĩ.<br /><strong>Hướng dẫn bảo quản:</strong><br />- Lau sạch serum dính trên miệng hũ và đóng chặt nắp sau khi sử dụng.<br />- Không để úp sản phẩm.<br />- Tránh ánh sáng trực tiếp, nơi có nhiệt độ cao hoặc ẩm ướt.<br />- Cặn serum thừa xung quanh miệng hũ không ảnh hưởng đến chất lượng sản phẩm, chỉ cần lau sạch trước khi sử dụng.<br />Ngày sản xuất: Xem trên bao bì sản phẩm<br />Hạn sử dụng: 3 năm kể từ ngày sản xuất<br />Xuất xứ thương hiệu: Nhật Bản<br />Tiêu chuẩn chất lượng Nhật Bản<br /><strong>Thông tin thương hiệu</strong><br />Ra đời năm 2002 tại Nhật Bản, nhãn hiệu Senka thừa hưởng lịch sử 140 năm của Tập đoàn Shiseido để mang đến những sản phẩm dưỡng da hiệu quả và an toàn với làn da phụ nữ châu Á. Với sản phẩm đại diện Senka Perfect Whip đứng đầu thị trường sữa rửa mặt Nhật Bản trong 7 năm liền (từ 2008 đến 2015), Senka mong muốn chăm sóc những người phụ nữ bận rộn một cách hiệu quả và tinh tế nhất.</p>\n<p> </p>\n<p><img style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/product/bc/84/c3/af4dbfb7e610f750a40b9aaa01d843f7.jpg\" width=\"600\" height=\"600\" /></p>\n</div><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/7c/ad/cc/a0e7f6777b6946747762974ff10bb8cc.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/7c/ad/cc/a0e7f6777b6946747762974ff10bb8cc.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/7c/ad/cc/a0e7f6777b6946747762974ff10bb8cc.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7c/ad/cc/a0e7f6777b6946747762974ff10bb8cc.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7c/ad/cc/a0e7f6777b6946747762974ff10bb8cc.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/7d/69/24/2f2318ebb574a106deea399b8e304137.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/7d/69/24/2f2318ebb574a106deea399b8e304137.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/7d/69/24/2f2318ebb574a106deea399b8e304137.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7d/69/24/2f2318ebb574a106deea399b8e304137.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7d/69/24/2f2318ebb574a106deea399b8e3