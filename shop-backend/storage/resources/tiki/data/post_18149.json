71483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/08/e0/c0/0e2ed96fba6c3bff841f1b062b461d74.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":90,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eBạn là người bị biến dạng ngón chân, hoặc đang lo lắng về tình trạng ngón chân chồng lên nhau? Hãy yên lòng, vì chúng tôi mang đến giải pháp hoàn hảo dành cho bạn - Bao Đeo Hỗ Trợ Tật Vẹo Chân Dr.MED DR-A001. Một sản phẩm chất lượng cao từ thương hiệu uy tín Dr.MED, được sản xuất tại Hàn Quốc.\u003c/p\u003e\n\u003cp\u003e1. Thương hiệu Dr.MED - Đảm Bảo Chất Lượng Từ Hàn Quốc: Khi nói về sản phẩm chăm sóc sức khỏe, Hàn Quốc luôn là điểm đến tin cậy của nhiều người tiêu dùng trên toàn thế giới. Dr.MED, với hơn nhiều năm kinh nghiệm, cam kết mang đến những sản phẩm chất lượng cao, đáp ứng mọi nhu cầu của bạn.\u003c/p\u003e\n\u003cp\u003e2. Đối Tượng Sử Dụng:\u003c/p\u003e\n\u003cp\u003eNgười bị Bệnh Hallus Valgus, dẫn đến biến dạng ngón chân cái.\u003cbr /\u003eNhững ai muốn ngăn chặn tình trạng ngón chân chồng lên nhau.\u003cbr /\u003e3. Đặc Điểm Nổi Bật:\u003c/p\u003e\n\u003cp\u003eẤm và Nén: Với thiết kế thông minh, bao đeo giúp tạo ra sự ấm áp và nén hiệu quả tại lòng bàn chân và lưng bàn chân, giúp bạn cảm thấy thoải mái và tự tin khi di chuyển.\u003c/p\u003e\n\u003cp\u003eChất Liệu Cao Su Neoprene: Được làm từ chất liệu cao su neoprene cao cấp, Dr.MED DR-A001 không chỉ mang lại độ nén mạnh mẽ, mà còn hỗ trợ và giữ cho bàn chân luôn ở trong trạng thái tốt nhất.\u003c/p\u003e\n\u003cp\u003eDễ Dàng Sử Dụng: Với kiểu dáng quấn đàn hồi, bạn có thể dễ dàng và thuận tiện khi sử dụng sản phẩm cùng với giày, không lo lắng về việc gây cản trở.\u003c/p\u003e\n\u003cp\u003eHỗ Trợ Ngón Chân: Với dây đeo đàn hồi Hallux, sản phẩm giúp kéo ngón chân lớn ra ngoài, giúp phục hồi và điều chỉnh tư duy ngón chân một cách hiệu quả.\u003c/p\u003e\n\u003cp\u003e4. Tùy Chọn Phong Phú: Màu sắc sang trọng của xanh đen và size duy nhất phù hợp với mọi người. Ngoài ra, bạn còn có thể lựa chọn giữa chân trái hoặc phải, tùy vào nhu cầu của mình.\u003c/p\u003e\n\u003cp\u003eĐừng chần chừ! Bao Đeo Hỗ Trợ Tật Vẹo Chân Dr.MED DR-A001 chính là sự lựa chọn tối ưu dành cho bàn chân của bạn. Đầu tư cho sức khỏe và tự tin di chuyển mỗi ngày với sản phẩm chất lượng từ Dr.MED.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/08/e0/c0/0e2ed96fba6c3bff841f1b062b461d74.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/08/e0/c0/0e2ed96fba6c3bff841f1b062b461d74.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/08/e0/c0/0e2ed96fba6c3bff841f1b062b461d74.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/08/e0/c0/0e2ed96fba6c3bff841f1b062b461d74.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/08/e0/c0/0e2ed96fba6c3bff841f1b062b461d74.png"},{"base_url":"https://salt.tikicdn.com/ts/product/5f/8c/87/6b3869fb1173ebc9783d1c71f09aa938.png","is_gallery":true,"label":null,"l