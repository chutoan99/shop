xt":"9.9"},{"placement":"pdp_badge","code":"is_hero","type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"freeship_xtra","type":"pdp_icon_badge","index":2,"icon":"https://salt.tikicdn.com/ts/upload/be/67/48/04a82ab8df178e1a13bde38316081865.png","icon_width":91,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":true,"return_reason":"any_reason"}},"discount":125700,"discount_rate":30,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ff/bd/43/0a3d539f69dc446439231f2aa69f1257.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":254,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eLEGO NINJAGO 71806 Đồ chơi lắp ráp Chiến giáp của Cole (235 chi tiết)\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lptd5mnbt4c721\" alt=\"vn-11134208-7r98o-lptd5mnbt4c721\" width=\"1500\" height=\"1500\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lptd5mnbuiwne8\" alt=\"vn-11134208-7r98o-lptd5mnbuiwne8\" width=\"1500\" height=\"1500\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lptd5mnbvxh32a\" alt=\"vn-11134208-7r98o-lptd5mnbvxh32a\" width=\"1500\" height=\"1500\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lptd5mnbxc1j53\" alt=\"vn-11134208-7r98o-lptd5mnbxc1j53\" width=\"1500\" height=\"1500\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lptimajpe14nbd\" alt=\"vn-11134208-7r98o-lptimajpe14nbd\" width=\"1500\" height=\"1500\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lptimajoykvr24\" alt=\"vn-11134208-7r98o-lptimajoykvr24\" width=\"1500\" height=\"1500\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lptimajozzg7b4\" alt=\"vn-11134208-7r98o-lptimajozzg7b4\" width=\"1500\" height=\"1500\" /\u003e\u003c/p\u003e\n\u003ch3\u003eGiới thiệu\u003c/h3\u003e\n\u003cp\u003eSiêu chiến giáp của Cole có buồng lái và được trang bị một cây búa để chiến đấu với những tên Chiến binh Sói gian ác. Và bây giờ, bạn có thể kết hợp các bộ phận của 3 cỗ máy ninja tuyệt vời do Cole, Sora và Ka-i điều khiển để tạo ra cỗ máy kết hợp của riêng bạn. Mỗi cỗ máy có thể tùy chỉnh và được bán riêng, đi kèm với chân, tay, trang bị và thân có thể tháo rời để bạn có thể kết hợp.\u003c/p\u003e\n\u003ch3\u003eĐặc điểm nổi bật\u003c/h3\u003e\n\u003cp\u003e• Xây dựng những bộ chiến giáp của riêng bạn – Những bé hâm mộ NINJAGO có thể tận hưởng hàng giờ vui vẻ sáng tạo khi kết hợp các bộ phận từ những bộ đồ chơi khác nhau (được bán riêng) để tạo ra những bộ siêu chiến giáp NINJAGO của riêng mình\u003c/p\u003e\n\u003cp\u003e• 2 nhân vật NINJAGO – Bộ trò chơi bao gồm Cole với phụ kiện thanh gươm mini và Chiến binh Sói gian ác cũng có thanh gươm. Bé có thể tái hiện các trận chiến từ phần 2 của bộ phim hoạt hình NINJAGO Rồng thần trỗi dậy\u003c/p\u003e\n\u003cp\u003e• Chiến giáp có thể điều chỉnh được – chiến giáp hạng nặng này có buồng lái để bé có thể đặt Cole vào, một chiếc búa lớn và tay chân có thể điều chỉnh được, có thể nghiêng và điều chỉnh thành các tư thế chiến đấu. Ngoài ra bé có thể hoán đổi và kết hợp các bộ phận từ chiến giáp của Cole với chiến giáp công nghệ của Sora (71807) và chiến giáp Ka-i (71808) được bán riêng\u003c/p\u003e\n\u003cp\u003e• Quà tặng siêu hấp dẫn cho bé – Bộ LEGO NINJAGO siêu đỉnh này sẽ mang đến cho bé nghiệm lắp ráp và vui chơi sáng tạo. Qúa thích hợp làm quà tặng cho những dịp sinh nhật hoặc lễ Tết.\u003c/p\u003e\n\u003cp\u003e• Xây dựng thế giới LEGO NINJAGO của bé – Cùng sưu tập thêm những bộ trò chơi LEGO NINJAGO khác và xây dựng một thế giới của riêng bé, từ đó mở ra những câu chuyện mới\u003c/p\u003e\n\u003cp\u003e• Kích thước – Bộ lắp ráp LEGO gồm 235 mảnh, sau khi hoàn thiện cao trên 5,5 inch (14 cm)\u003c/p\u003e\n\u003ch3\u003eChất liệu\u003c/h3\u003e\n\u003cp\u003eNhựa\u003c/p\u003e\n\u003ch3\u003eĐối tượng sử dụng\u003c/h3\u003e\n\u003cp\u003eDành cho bé từ 7 tuổi\u003c/p\u003e\n\u003ch3\u003eHướng dẫn sử dụng\u003c/h3\u003e\n\u003cp\u003eLắp ráp các khớp nối vào nhau theo hướng dẫn bản in hoặc qua ứng dụng LEGO® Building Instructions.\u003c/p\u003e\n\u003cp\u003eChơi theo sự sáng tạo của bé.\u003c/p\u003e\n\u003ch3\u003eThông số kỹ thuật\u003c/h3\u003e\n\u003cul\u003e\u003cli\u003eSố lượng chi tiết: 235\u003c/li\u003e\u003cli\u003eTrọng lượng: 362gr\u003c/li\u003e\u003cli\u003eKích thước: 26 x 18.8 x 6 cm\u003c/li\u003e\u003c/ul\u003e\n\u003ch3\u003eThông tin thương hiệu\u003c/h3\u003e\n\u003cp\u003eĐược thành lập vào năm 1932 tại Đan Mạch, Lego là thương hiệu hàng đầu thế giới về các sản phẩm đồ chơi lắp ráp bằng nhựa cao cấp dành cho trẻ từ 1.5 tuổi trở lên. Mang ý nghĩa tên gọi là “Chơi hay”, sản phẩm của Lego được thiết kế với nhiều chủng loại và chủ đề khác nhau, phù hợp với từng độ tuổi của các bé. Luôn tuân thủ những tiêu chuẩn đồ chơi của châu Âu, sản phẩm của Lego được sản xuất từ nguyên liệu nhựa ABS, đảm bảo tính an toàn cho trẻ khi chơi và có độ bền cao, chịu được nhiệt, axit, muối và các hóa chất khác. Với khả năng lắp ráp linh hoạt, màu sắc tươi sáng, đồ chơi Lego hỗ trợ tối đa quá trình phát triển kỹ năng nhận biết, tư duy thẩm mỹ, sáng tạo của trẻ qua từng giai đoạn phát triển.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ff/bd/43/0a3d539f69dc446439231f2aa69f1257.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ff/bd/43/0a3d539f69dc446439231f2aa69f1257.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ff/bd/43/0a3d539f69dc446439231f2aa69f1257.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ff/bd/43/0a3d539f69dc446439231f2aa69f1257.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ff/bd/43/0a3d539f69dc446439231f2aa69f1257.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/07/b0/92/b465c51f8a6ff6ccda528b97eb1ce26b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/07/b0/92/b465c51f8a6ff6ccda528b97eb1ce26b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/07/b0/92/b465c51f8a6ff6ccda528b97eb1ce26b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/07/b0/92/b465c51f8a6ff6ccda528b97eb1ce26b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/07/b0/92/b465c51f8a6ff