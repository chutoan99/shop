urite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/6f/a2/66/9ffe1a2756271b6658b9d7eb3c9ea63f.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1975,"all_time_quantity_sold":165,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"margin: 0px; padding: 8px 0px; font-family: verdana, arial, helvetica, sans-serif; white-space: pre-wrap; background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial;\" data-spm-anchor-id=\"a2o4n.pdp.product_detail.i4.74bf4b7aQJgoFm\"\u003e\u003cspan style=\"margin: 0px; padding: 0px; font-size: 13.5pt; font-family: arial, sans-serif; color: #333333;\" data-spm-anchor-id=\"a2o4n.pdp.product_detail.i2.74bf4b7aQJgoFm\"\u003eGiúp hỗ trợ điều trị chấn thương hiệu quả:\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"margin: 0px; padding: 8px 0px; font-family: verdana, arial, helvetica, sans-serif; white-space: pre-wrap; background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial;\"\u003e\u003cspan style=\"margin: 0px; padding: 0px; font-family: arial, sans-serif; color: #333333;\"\u003e Là đồ dùng hữu ích và cần thiết mà gia đình nên có. Hiện nay trên thị trường có rất nhiều loại túi chườm giúp cho mẹ và các bé dễ dàng sử dụng và chọn lựa. Tuy nhiên, đối với các bà mẹ chưa biết nhiều về sản phẩm thông dụng này, hẳn là chưa biết nên chọn loại túi chườm nào cho phù hợp. Do đó, chúng tôi sẽ giới thiệu cho mẹ và các bé một loại túi chườm rất được nhiều bà mẹ yêu thích và lựa chọn, đó là túi chườm đa năng Microlife.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"margin: 0px; padding: 8px 0px; font-family: verdana, arial, helvetica, sans-serif; white-space: pre-wrap; background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial;\"\u003e\u003cspan style=\"margin: 0px; padding: 0px; font-size: 12pt; font-family: arial, sans-serif; color: #333333;\"\u003eChườm nóng:\u003c/span\u003e\u003cspan style=\"margin: 0px; padding: 0px; font-family: arial, sans-serif; color: #333333;\"\u003e có tác dụng làm tăng tuần hoàn tại chỗ được chườm giúp vết thương mau lành, giảm đau, làm ấm...\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"margin: 0px; padding: 8px 0px; font-family: verdana, arial, helvetica, sans-serif; white-space: pre-wrap; background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial;\"\u003e\u003cspan style=\"margin: 0px; padding: 0px; font-family: arial, sans-serif; color: #333333;\"\u003eCó 2 kiểu chườm nóng là chườm nóng ướt và chườm nóng khô.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"margin: 0px; padding: 8px 0px; font-family: verdana, arial, helvetica, sans-serif; white-space: pre-wrap; background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial;\"\u003e\u003cspan style=\"margin: 0px; padding: 0px; color: #333333;\"\u003e\u003cspan style=\"margin: 0px; padding: 0px; font-weight: bolder;\"\u003eChườm nóng ướt:\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"margin: 0px; padding: 0px; font-family: arial, sans-serif; color: #333333;\"\u003e thường áp dụng trong những trường hợp u nhọt, vết thương hở, hoặc một số trường hợp nhiễm khuẩn nhẹ.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"margin: 0px; padding: 8px 0px; font-family: verdana, arial, helvetica, sans-serif; white-space: pre-wrap; background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial;\"\u003e\u003cspan style=\"margin: 0px; padding: 0px; font-family: arial, sans-serif; color: #333333; background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial;\"\u003e\u003cspan style=\"margin: 0px; padding: 0px; font-weight: bolder;\"\u003eChườm nóng khô:\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"margin: 0px; padding: 0px; font-family: arial, sans-serif; color: #333333; background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial;\"\u003e\u003cspan style=\"margin: 0px; padding: 0px;\"\u003e thường được áp dụng cho các trường hợp như cơn đau dạ dày, đau gan, thận hoặc đau khớp xương. Cũng có thể áp dụng chườm nóng khô cho những bệnh nhân viêm thanh quản, viêm khí quản, hoặc trẻ sơ sinh non yếu hoặc người cao tuổi khi trời rét.\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"margin: 0px; padding: 8px 0px; font-family: verdana, arial, helvetica, sans-serif; white-space: pre-wrap; background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial;\"\u003e\u003cspan style=\"margin: 0px; padding: 0px; color: #333333;\"\u003e\u003cspan style=\"margin: 0px; padding: 0px; font-weight: bolder;\"\u003eThời gian chườm nóng: \u003c/span\u003e\u003c/span\u003e\u003cspan style=\"margin: 0px; padding: 0px; font-family: arial, sans-serif; color: #333333;\"\u003eMỗi lần chườm chỉ nên kéo dài chừng 20 - 30 phút, cách nhau ít nhất là 3 giờ. Nếu chườm liên tục sẽ làm cho da mềm, lỗ chân lông mở ra, vi khuẩn dễ xâm nhập gây viêm da, viêm cơ rất nguy hiểm.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"margin: 0px; padding: 8px 0px; font-family: verdana, arial, helvetica, sans-serif; white-space: pre-wrap; background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial;\"\u003e\u003cspan style=\"margin: 0px; padding: 0px; font-size: 12pt; font-family: arial, sans-serif; color: #333333;\"\u003e\u003cspan style=\"margin: 0px; padding: 0px; font-weight: bolder;\"\u003eChườm lạnh:\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"margin: 0px; padding: 0px; color: #333333; font-family: arial, sans-serif; font-size: 11pt;\"\u003eKhi bị bong gân, sai khớp, bầm dập cơ... bạn có thể dùng túi chườm lạnh. Liệu pháp này giúp giảm đau và phù nề do làm tăng ngưỡng kích thích của các sợi cơ, gây co mạch, giảm lượng máu lưu thông ở vùng tổn thương.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"margin: 0px; padding: 8px 0px; font-family: verdana, arial, helvetica, sans-serif; white-space: pre-wrap; background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial; box-sizing: border-box; font-variant-numeric: inherit; font-variant-east-asian: inherit; font-stretch: inherit; line-height: inherit;\"\u003e\u003cspan style=\"margin: 0px; padding: 0px; font-size: 11pt; font-family: arial, sans-serif; color: #333333;\"\u003eKhi bị các chấn thương này, tùy thuộc vào mức độ tổn thương, trong giai đoạn từ 24 - 72 giờ đầu, vùng tổn thương cần yên tĩnh hoàn toàn để thực hiện các biện pháp như chườm lạnh, cố định và nâng cao tư thế vùng tổn thương.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"margin: 0px; padding: 8px 0px; font-family: verdana, arial, helvetica, sans-serif; white-space: pre-wrap; background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial; box-sizing: border-box; font-variant-numeric: inherit; font-variant-east-asian: inherit; font-stretch: inherit; line-height: inherit;\" data-spm-anchor-id=\"a2o4n.pdp.product_detail.i7.74bf4b7aQJgoFm\"\u003e\u003cspan style=\"margin: 0px; padding: 0px; font-size: 11pt; color: #333333;\"\u003e\u003cspan style=\"margin: 0px; padding: 0px; font-weight: bolder;\" data-spm-anchor-id=\"a2o4n.pdp.product_detail.i5.74bf4b7aQJgoFm\"\u003eThời gian chườm lạnh:\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"margin: 0px; padding: 0px; font-size: 11pt; font-family: arial, sans-serif; color: #333333;\"\u003eĐể đạt được hiệu quả cao nhất, chườm lạnh cần phải được tiến hành ngay ở những phút đầu tiên sau khi bị chấn thương. Trong 48 - 72 giờ đầu, việc chườm lạnh cần được tiến hành thường xuyên. Mỗi đợt chườm lạnh kéo dài từ 15 - 20 phút, thời gian nghỉ giữa hai đợt khoảng 120 - 180 phút. Tùy theo mức độ chấn thương, chườm lạnh có thể được tiến hành cho đến ngày thứ 7 sau chấn thương với tần suất giảm dần.\u003c/span\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/6f/a2/66/9ffe1a2756271b6658b9d7eb3c9ea63f.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/6f/a2/66/9ffe1a2756271b6658b9d7eb3c9ea63f.jpg","medium_url":"https://