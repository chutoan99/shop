r":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":16,"review_text":"(16)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/7b/04/bb/da6956723106765f470f6c4b94d391de.jpeg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1500,"all_time_quantity_sold":67,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cdiv class=\"tableparameter\"\u003e\n\u003ch2\u003eViên Giặt Quần Áo Kháng Khuẩn Kirkland Signature Ultra Clean\u003c/h2\u003e\n\u003ch2\u003eThông số sản phẩm\u003c/h2\u003e\n\u003cul class=\"parameter\"\u003e\n\u003cli\u003eQuy cách:Hộp 152 Viên\u003c/li\u003e\n\u003cli\u003eXuất xứ:Mỹ\u003c/li\u003e\n\u003cli\u003eHãng SX:Kirkland\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/div\u003e\n\u003cdiv class=\"clearfix\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/be/12/6b/dc94491175c356782a8eda706efddb2d.jpeg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/div\u003e\n\u003carticle id=\"description\"\u003e\n\u003cdiv class=\"article_content\"\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch2\u003eGiới thiệu sản phẩm Viên Giặt Quần Áo - Kirkland Signature 152 viên của Mỹ\u003c/h2\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eTrên thị trường có đủ loại nước giặt từ giặt tay, giặt máy, giặt quần áo màu, loại nhiều mùi, hay loại diệt khuẩn để giặt đồ lót. Mới đây, Kirkland đã cho ra mắt thêm sản phẩm viên giặt thông minh dạng gel với sự kết hợp 3 trong 1: giặt - xả - diệt khuẩn, giúp quần áo sạch sẽ, lưu hương dịu nhẹ và lâu, dùng được cho tất cả các loại máy giặt, giặt tay.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/24/5c/cf/7c00656bba25571c52b9c88e56a18928.jpg\" alt=\"\" width=\"700\" height=\"700\" /\u003e\u003c/p\u003e\n\u003cp\u003e được mọi gia đình ưa chuộng là giúp quần áo giặt xong màu như mới mua, dù giặt cả đống quần áo bạn cũng không bị phai lẫn màu quần áo.  ít bọt, dễ dàng hòa tan nhanh trong cả nước nóng, hay lạnh và giặt xong thì không để lại lốm đốm hay vệt trắng như bột giặt.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch2\u003eCông dụng của Viên Giặt Quần Áo - Kirkland Signature\u003c/h2\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eCông thức độc đáo, hòa tan nhanh chóng trong cả nước nóng hoặc lạnh, đơn giản dễ sử dụng.\u003c/li\u003e\n\u003cli\u003eBền màu, thơm lâu, kháng khuẩn\u003c/li\u003e\n\u003cli\u003eMang lại hiệu suất giặt tẩy đáng tin cậy, giúp cho việc giặt giũ nhanh chóng hơn và quần áo trắng sáng hơn. \u003c/li\u003e\n\u003cli\u003eSử dụng được cho tất cả các loại máy giặt. \u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch2\u003eHướng dẫn sử dụng\u003c/h2\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e- Sử dụng 1 viên cho mỗi lần giặt (khoảng 6 kg quần áo khô hay 30 chiếc áo/quần tương đương với 65L nước).\u003c/p\u003e\n\u003cp\u003e- Thả trực tiếp viên nước giặt vào lồng máy giặt rồi đặt quần áo lên trên.\u003c/p\u003e\n\u003cp\u003e- Nếu lượng quần áo nhiều, đồ jeans, hoặc nếu có nhiều vết bẩn có thể dùng 2 viên cho 1 lần giặt.\u003c/p\u003e\n\u003cp\u003e- Không cần phải cắt bỏ lớp màng bên ngoài do được làm với công nghệ tráng phim mới tự tiêu.\u003c/p\u003e\n\u003cp\u003e- Viên nước giặt xả thông minh này sẽ giúp bạn tiết kiệm được thời gian và giữ gìn đôi tay do bạn không phải tiếp xúc trực tiếp với bột giặt và .\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/31/19/7b/2c064406d73a56a6195cc00187fed9f8.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eLưu ý:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Vì sản phẩm tan nhanh trong nước nên khi lấy viên giặt, bạn nên lau khô tay trước khi lấy\u003c/p\u003e\n\u003cp\u003e- Màu sản phẩm vô cùng bắt mắt nên rất hấp dẫn các trẻ cho nên mẹ cần tránh xa tầm với của trẻ\u003c/p\u003e\n\u003cp\u003e- Luôn đậy kín nắp hộp sau khi sử dụng\u003c/p\u003e\n\u003c/div\u003e\n\u003c/article\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/7b/04/bb/da6956723106765f470f6c4b94d391de.jpeg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/7b/04/bb/da6956723106765f470f6c4b94d391de.jpeg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/7b/04/bb/da6956723106765f470f6c4b94d391de.jpeg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7b/04/bb/da6956723106765f470f6c4b94d391de.jpeg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7b/04/bb/da6956723106765f470f6c4b94d391de.jpeg"},{"base_url":"https://salt.tikicdn.com/ts/product/24/5c/cf/164bdeeb6a9c7a8989ef26e36eb1bf0d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/24/5c/cf/164bdeeb6a9c7a8989ef26e36eb1bf0d.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/24/5c/cf/164bdeeb6a9c7a8989ef26e36eb1bf0d.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/24/5c/cf/164bdeeb6a9c7a8989ef26e36eb1bf0d.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/24/5c/cf/164bdeeb6a9c7a8989ef26e36eb1bf0d.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/31/1