eturn_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/a7/ff/dc/0b63c7fc549cf2e1b462958205012be1.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1435,"all_time_quantity_sold":27,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/cc/f1/a2/65101d22abcd23e9509786e17c0b215c.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTHÔNG SỐ KỸ THUẬT\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eTên sản phẩm: Bếp ga mini du lịch siêu tiết kiệm Namilux \u003c/p\u003e\n\u003cp\u003eCông suất: 2.1 kW (1800 kcal/giờ)\u003c/p\u003e\n\u003cp\u003eThời gian hết lon ga (tiêu chuẩn): 90 phút\u003c/p\u003e\n\u003cp\u003eLoại ga sử dụng: Bình ga mini\u003c/p\u003e\n\u003cp\u003eChất liệu: Inox\u003c/p\u003e\n\u003cp\u003eTính năng an toàn: Ngắt ga tự động Inline Cut\u003c/p\u003e\n\u003cp\u003eKích thước: 102 x 256 x 205 mm\u003c/p\u003e\n\u003cp\u003eKhối lượng: 1.03 kg\u003c/p\u003e\n\u003cp\u003eXuất xứ: Việt Nam\u003c/p\u003e\n\u003cp\u003eSản xuất: Việt Nam\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/97/80/ff/7df879268df0c27d01f23765433a4e00.jpeg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eVÀI NÉT VỀ BẾP GA MINI DU LỊCH NAMILUX:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTIẾT KIỆM GA, GỌN NHẸ\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eBếp thiết kế gọn với kích thước 25 x 20 x 10cm thích hợp cho những không gian nhỏ hẹp, mang đi xa, tổ chức tiệc ngoài trời,\u003c/p\u003e\n\u003cp\u003eThiết kế mới làm bếp tiết kiệm ga hơn, thời gian sử dụng bình ga tăng thêm 1/3 so với các bếp khác\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/a7/ff/dc/3e698ae04535d0b6a925638493170bd1.jpg\" alt=\"\" width=\"700\" height=\"700\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCHẤT LIỆU INOX SIÊU BỀN\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eBếp mini du lịch siêu tiết kiệm ga Namilux sử dụng 100% inox, được sản xuất theo công nghệ cuốn mép làm cho bếp cứng hơn, không sắc cạnh, không gây đứt tay khi vô tình va chạm\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eĐẦU ĐỐT THEO TIÊU CHUẨN JIA (NHẬT BẢN)\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eĐầu đốt của bếp được thiết kế theo tiêu chuẩn JIA của Nhật Bản khiến ngọn lửa xanh hơn, tăng hiệu suất tỏa nhiệt cho bếp và hạn chế đen đáy nồi.\u003c/p\u003e\n\u003cp\u003eNgoài ra, với đầu đốt này có thể tiết kiệm đến 30% lượng ga khi sử dụng\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eVAN GA TỰ NGẮT CÔNG NGHỆ NHẬT BẢN\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eVan được đúc áp lực nên rất chắc chắn, không rò rỉ ga, được chế tạo theo công nghệ mới của Nhật Bản ngắt ga trực tiếp bên trong đảm bảo an toàn cháy nổ và sức khỏe cho gia đình\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/a7/ff/dc/0b63