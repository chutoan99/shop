"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":70000,"discount_rate":31,"rating_average":4.7,"review_count":93,"review_text":"(93)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/f8/a9/bf/0743879056386707056d776f4660edda.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1185,"all_time_quantity_sold":349,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eRang mộc thơm tự nhiên\u003cbr /\u003eLoại Coffee Tree đặc biệt có mùi hương thơm vừa, vị đắng đậm đà thơm ngọt và cafein vừa, chát, hậu vị ngọt.\u003cbr /\u003eĐược sản xuất theo hệ thống công nghệ tiên tiến trên dây chuyền hiện đại của Hà Lan\u003cbr /\u003eNguyên liệu tạo nên sản phẩm theo quy trình khép khín từ Farm to Cup được chọn lọc kĩ càng từ BMT, Đà Lạt.\u003cbr /\u003eCà phê 100% bột rang xay nguyên chất phù hợp pha phin\u003cbr /\u003eSự phối trộn hài hòa giữa dòng robusta BMT và Arabica Cầu Đất Đà Lạt mang tới hương vị hấp dẫn, thơm ngon đăc trưng riêng.\u003cbr /\u003eThích hợp gu đen đá và sữa đá truyền thống.\u003cbr /\u003eBao bì cao cấp có van 1 chiều bảo quản café thơm lâu.\u003cbr /\u003eTrọng lượng 250gr bột\u003c/p\u003e\n\u003cp\u003eChúng tôi làm cafe vì bạn, vì những người thưởng thức cafe đúng nghĩa, vì tình yêu với hạt cà phê và vì xã hội. Coffee Tree tự hào mang đến cho người thưởng thức những tách cafe thơm ngon và tan toàn cho sức khỏe.\u003c/p\u003e\n\u003cp\u003e\u003ciframe src=\"https://www.youtube.com/embed/VEqeIV5hSGs\" width=\"560\" height=\"315\" frameborder=\"0\" allowfullscreen=\"allowfullscreen\" data-mce-fragment=\"1\"\u003e\u003c/iframe\u003e\u003c/p\u003e\n\u003cp\u003eCà phê nguyên chất, vị đắng không gắt, nhẹ, hơi ngọt, không đọng lại lâu vị đắng trong miệng, uống nước trà hay nước lọc tráng miệng là hết ngay.\u003cbr /\u003eVì lợi nhuận và không có kinh nghiệm, nhất là kiến thức về chế biến cà phê còn hạn chế, nên trên thị trường cà phê Việt nam còn rất hỗn độn, quá nhiều cơ sở chế biến cà phê ra đời, người tiêu dùng rất phân vân khi lựa chọn cho mình một loại cà phê ngon, thực phẩm an toàn.\u003cbr /\u003eTại nông trại Coffee Tree, cà phê được hái bằng tay, chọn lựa chỉ quả chín đỏ, tỉ lệ bắt buộc 90% quả đỏ, không hái tuốt, hái đại trà cả quả xanh lẫn đỏ.\u003cbr /\u003eSau khi chế biến ướt ra hạt cà phê nhân (green bean), được chọn lọc bằng tay một lần nữa loại bỏ hạt sạn, hạt mẻ, giữ hạt cà phê sạch, không mối mọt, nấm mốc. Hạt cà phê nhân được vận chuyển về nhà máy rang xay.\u003cbr /\u003eTại đây, hạt được rang bởi chuyên gia cà phê và kiểm soát chặt chẽ nhiệt độ, thời gian rang, chất lượng các mẻ rang hoàn toàn đồng nhất với nhau từ những thợ rang giàu kinh nghiệm và tâm huyết với cà phê.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/6b/6e/c2/124ba27cbcda0c4377475dbbd5932886.png\" alt=\"coffee tree đặc biệt\" width=\"750\" height=\"614\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCoffee tree đặt biệt\u003c/strong\u003e\u003cem\u003e có mùi hương thơm vừa, vị đắng đậm đà thơm ngọt và cafein vừa, hậu vị ngọt lưu luyến.\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003eCách pha phin chuẩn xem video bên dưới.\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003ciframe src=\"https://www.youtube.com/embed/hdNIzHvuqEg\" width=\"560\" height=\"315\" frameborder=\"0\" allowfullscreen=\"allowfullscreen\" data-mce-fragment=\"1\"\u003e\u003c/iframe\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003eNHẬN BIẾT CÀ PHÊ NGUYÊN CHẤT NHƯ THẾ NÀO\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/51/69/d1/4bce0cb8a20128e5c38ca059cfffc4d2.png\" alt=\"nhận biết cà phê nguyên chất,tạp chất\" width=\"750\" height=\"593\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/f8/a9/bf/0743879056386707056d776f4660edda.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f8/a9/bf/0743879056386707056d776f4660edda.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f8/a9/bf/0743879056386707056d776f4660edda.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f8/a9/bf/0743879056386707056d776f4660edda.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f8/a9/bf/0743879056386707056d776f4660edda.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/c5/60/ce/80739b8f9f5ffcaffdca52900f0217bc.JPG","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c5/60/ce/80739b8f9f5ffcaffdca52900f0217bc.JPG","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c5/60/ce/80739b8f9f5ffcaffdca52900f0217bc.JPG","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c5/60/ce/80739b8f9f5ffcaffdca52900f0217bc.JPG","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c5/60/ce/80739b8f9f5ffcaffdca52900f0217bc.JPG"},{"base_url":"https://salt.tikicdn.com/ts/product/da/7b/18/12524f55064ba473c562265d52ffa602.jpg