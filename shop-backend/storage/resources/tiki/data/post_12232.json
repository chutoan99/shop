.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":551000,"discount_rate":40,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/e1/bd/af/b5dd607aa4f8d0aba6bae654caaefbb8.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":882,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<h2 style=\"text-align:justify;\">Hub chuyển đổi Baseus Metal Gleam Type-C 8 trong 1 kết nối tiện lợi, an toàn, nhanh chóng</h2>\n<p style=\"text-align:justify;\">Với những ai sử dụng Macbook thì đã quá quen thuộc với thiết bị Hub chuyển đổi Baseus Metal Gleam Type-C 8 trong 1 để giúp việc kết nối với các thiết bị bên ngoài được dễ dàng và nhanh chóng. Một trong những sản phẩm được đông đảo người dùng lựa chọn đó là Hub chuyển đổi Baseus Metal Gleam Type-C 8 trong 1.</p>\n<h3 style=\"text-align:justify;\"> </h3>\n<h3 style=\"text-align:justify;\"><strong>Thiết kế bền bỉ, tinh xảo</strong></h3>\n<p style=\"text-align:justify;\">Hub chuyển đổi Baseus Metal Gleam Type-C 8 trong 1 được hoàn thiện bởi chất liệu nhôm cao cấp có độ đàn hồi tốt mang đến cảm giác chắc chắn và cực kỳ cao cấp khi sử dụng. Bên cạnh đó, thiết kế gọn nhẹ, tinh xảo giúp bạn dễ dàng mang theo khi di chuyển.</p>\n<p style=\"text-align:justify;\"> </p>\n<p><img src=\"https://salt.tikicdn.com/ts/tmp/55/70/00/59ba8eb22d7e91e670a129497651a0c3.jpg\" alt=\"\" width=\"700\" height=\"700\"></p>\n<p style=\"text-align:justify;\"> </p>\n<p style=\"text-align:justify;\"><br>Ngoài ra, thiết bị còn có dây nối dài giúp việc di chuyển đầu nối còn lại được trở nên dễ dàng hơn. Cùng với đó là lõi đồng nguyên chất giúp cho khả năng kết nối và truyền tải được ổn định, đảm bảo tốt nhất trong khi sử dụng.</p>\n<p style=\"text-align:justify;\"> </p>\n<h3 style=\"text-align:justify;\"><strong>8 cổng tiện lợi, khả năng tương thích tốt</strong></h3>\n<p style=\"text-align:justify;\">Hub chuyển đổi Baseus Metal Gleam Type-C 8 trong 1 được trang bị đến 8 cổng kết nối mang tới khả năng nối ghép thiết bị đa dạng. Bên cạnh đó, tốc độ nhanh hơn, ổn định hơn và khả năng tương thích cao giúp cho mọi công việc nhanh chóng và hạn chế tối đa các vấn đề phát sinh.</p>\n<p style=\"text-align:justify;\"> </p>\n<p><img src=\"https://salt.tikicdn.com/ts/tmp/a6/cc/63/fd0e9dea7689e4cfc6af8302180edd33.jpg\" alt=\"\" width=\"700\" height=\"700\"></p>\n<p style=\"text-align:justify;\"><br>Ngoài ra, với việc hỗ trợ truyền tải dữ liệu chỉ qua duy nhất một cổng kết nối, các nhà sản xuất đã gộp chung để cho sản phẩm được trở nên gọn gàng hơn. Từ đó, mang đến sự tối giản nhất cũng như một không gian gọn gàng, thông thoáng cho hiệu quả làm việc tốt hơn.</p>\n<p style=\"text-align:justify;\"> </p>\n<h2 style=\"text-align:justify;\"><strong>Mua ngay Hub chuyển đổi Baseus Metal Gleam Type-C 8 trong 1 tại Tiki để được bảo hành chính hãng.</strong></h2><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/e1/bd/af/b5dd607aa4f8d0aba6bae654caaefbb8.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e1/bd/af/b5dd607aa4f8d0aba6bae654caaefbb8.png","medium_url":"https://salt.tikicdn.co