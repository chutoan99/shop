any_reason"}},"discount":24000,"discount_rate":13,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/15/7b/6f/f60e490a98a4d7a10566990d31600a44.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":578,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eMô tả sản phẩm đèn bàn học sinh Comet CT411 ( Đã bao gồm bóng 5W) có ngăn đựng dụng cụ:\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/c8/bb/81/35f4ba01001446b109188eaf2b0d4d5a.jpg\" alt=\"\" width=\"750\" height=\"416\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003eĐèn Bàn Học Sinh Comet CT411 được làm bằng chất liệu nhựa ABS cao cấp, có độ bền cao. \u003cbr /\u003eChịu lực và chịu nhiệt tốt, dễ dàng lau chùi khi bám bẩn. Sản phẩm không chứa các hóa chất gây hại, đảm bảo an toàn cho sức khỏe người sử dụng.\u003cbr /\u003eƯu điểm đèn bàn học sinh COMET CT411:\u003cbr /\u003eSử dụng bóng LED COMET 5W ánh sáng trắng, tiết kiệm điện năng kết hợp chóa đèn tản sáng tốt. \u003cbr /\u003eCông suất tối đa 60W\u003cbr /\u003eNguồn phát sáng an toàn, không tia tử ngoại, không sóng điện từ, chống lóa mắt, giúp bảo vệ tối ưu cho đôi mắt của bé. \u003cbr /\u003eThiết kế tiện dụng với khả năng dễ dàng xoay chuyển, giúp bạn có thể tùy chỉnh độ cao, thấp của thân đèn hoặc góc chiếu tùy thích rất dễ dàng. \u003cbr /\u003eSản phẩm được trang bị đui đèn E27 để bạn có thể dùng được nhiều loại bóng đèn khác nhau như: bóng LED, bóng compact… \u003cbr /\u003eBạn có thể điều chỉnh tắt mở một cách thuận tiện với nút công tắc được trang bị ngay trên đế đèn. \u003cbr /\u003eKiểu dáng tinh tế đẹp mắt với màu sắc nổi bật cùng thiết kế hộp đựng bút đa năng tiện lợi. Đèn bàn Comet CT411 sẽ mang đến sự sinh động và tươi mới cho không gian bàn học của bé cũng như không gian sống của gia đình bạn.\u003cbr /\u003eSản phẩm bảo hành chính hãng 12 tháng\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/06/dd/06/b7648937aa42433697e6d88e10934cbb.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/6e/8b/92/a7016ef03bd2f210a4699b11b9b5b099.jpg\" alt=\"\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/fd/a0/b6/6a3f65d04f9f457654ea9a1c0f80cf43.jpg\" alt=\"\" width=\"745\" height=\"745\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/67/59/d9/7698d95f3e094a60a1c3fa9a3d8e9ccf.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/15/7b/6f/f60e490a98a4d7a10566990d31600a44.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/15/7b/6f/f60e490a98a4d7a10566990d31600a44.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/15/7b/6f/f60e490a98a4d7a10566990d31600a44.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/15/7b/6f/f60e490a98a4d7a10566990d31600a44.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/15/7