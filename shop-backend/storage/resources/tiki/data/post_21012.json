_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/96/78/b0/7a28fcf35f260bdc3a218b525c5d936c.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1276,"all_time_quantity_sold":9,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cdiv style=\"font-size:12px;\"\u003e\n\u003ch3 style=\"text-align:left;\"\u003eGiới thiệu\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eCombo sữa tắm gội toàn thân Arau Baby - Mua chai 450ml được tặng túi 400ml Siêu tiết kiệm, bé dùng được lâu hơn, mẹ tiết kiệm được chi phí\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eSữa tắm Arau Baby\u003c/strong\u003e của Nhật dành cho bé từ sơ sinh với chiết xuất 100% từ thảo mộc tự nhiên mang lại cho bé những giây phút thư giãn khi tắm và bảo vệ làn da mỏng manh của trẻ nhỏ. Giúp bé có một làn da mềm mại và sạch khuẩn.\u003c/li\u003e\n\u003cli\u003eSữa tắm Arau Baby cho bé không chứa phụ gia hay các chất tạo màu, tạo mùi, đảm bảo an toàn tuyệt đối, giúp các bà mẹ yên tâm hơn khi làm vệ sinh cho con mình.\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3 style=\"font-size:12px;\"\u003eĐặc điểm nổi bật\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003e100% thành phần tự nhiên\u003c/li\u003e\n\u003cli\u003eĐược chiết xuất từ các loại thảo mộc, không chứa phụ gia tổng hợp, nâng niu cho làn da nhạy cảm của bé.\u003c/li\u003e\n\u003cli\u003eThành phần: Nước cất, potassium soap base, glycerin, tinh dầu hoa oải hương, tinh dầu chanh, chiết xuất lá tía tô, chiết xuất lá hương thảo.\u003c/li\u003e\n\u003cli\u003eSữa Tắm Bọt Arau Baby là loại sữa tắm bọt hoàn toàn nguyên chất tự nhiên, không chứa thành phần hóa chất có khả năng gây kích ứng da thường được thấy trong các loại xà phòng tắm thông thường khác như phốt phát, edentate, mùi hương tổng hợp, màu tổng hợp hay chất bảo quản.\u003c/li\u003e\n\u003cli\u003eTắm gội Arau Baby tạo cảm giác mềm mại tự nhiên trên da của bé, để lại trên da bé mùi hương thoang thoảng dịu dàng đáng yêu của thảo mộc suốt ngày.\u003c/li\u003e\n\u003cli\u003eKhông chứa phụ gia tạo hương tổng hợp\u003c/li\u003e\n\u003cli\u003eSản phẩm không chứa chất phụ gia, không gây kích ứng và đảm bảo an toàn cho làn nhạy cảm của trẻ nhỏ.\u003c/li\u003e\n\u003cli\u003eLàn bọt dày mịn ti li vừa nhẹ nhàng làm sạch làn da nhạy cảm và tóc bé, vừa cho bé cảm giác thoải mái vui đùa khi tắm; da bé sẽ không bị kích ứng vì hóa chất tổng hợp, lại luôn được giữ mềm mại, sạch sẽ với hương thơm tự nhiên của thảo mộc.\u003c/li\u003e\n\u003cli\u003eKhông làm cay mắt, an toàn cho làn da nhạy cảm của bé.\u003c/li\u003e\n\u003cli\u003eDùng cho bé từ sơ sinh trở lên\u003c/li\u003e\n\u003cli\u003eXuất xứ: Nhật Bản\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"font-size:12px;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/product/f3/b8/46/a9b97b7a3207365607cc4c757fe51d3b.jpg\" alt=\"a9b97b7a3207365607cc4c757fe51d3b.jpg\" /\u003e\u003c/p\u003e\n\u003ch3\u003eHướng dẫn sử dụng:\u003c/h3\u003e\n\u003cp\u003eLàm ướt cơ thể bé trước khi cho một lượng vừa đủ bọt nước tắm ARAU BABY, xoa đều lên da. (Tắm kết hợp với massage để đạt hiệu quả tối đa cho bé). Sau đó tắm lại với nước sạch.\u003c/p\u003e\n\u003ch3\u003eThông tin thương hiệu\u003c/h3\u003e\n\u003c/div\u003e\n\u003cdiv style=\"font-size:12px;\"\u003e\n\u003cp style=\"font-size:12px;\"\u003eArau Baby là dòng sản phẩm chuyên dành cho trẻ em nổi tiếng của Nhật từ công ty SARAYA. Kể từ năm 1952, với tầm nhìn tiên phong và ý thức trách nhiệm xã hội, SARAYA đã giành được sự tín nhiệm của các doanh nghiệp, trường học, chính phủ và các hộ gia đình trên khắp Nhật Bản và thế giới. Được biết đến với các dòng sản phẩm chuyên dành cho trẻ em, làm sạch thực phẩm, vệ sinh, chiết suất hoàn toàn từ thảo dược và các nguyên liệu thiên nhiên nên đặc biệt an toàn cho người sử dụng và thân thiện với môi trường. Arau Baby chính là một thương hiệu sản phẩm vệ sinh an toàn cho trẻ mà các bà mẹ trên thế giới tin dùng\u003c/p\u003e\n\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/96/78/b0/7a28fcf35f260bdc3a218b525c5d936c.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/96/78/b0/7a28fcf35f260bdc3a218b525c5d936c.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/96/78/b0/7a28fcf35f260bdc3a218b525c5d936c.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/96/78/b0/7a28fcf35f260bdc3a218b525c5d936c.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/96/78/b0/7a28fcf35f260bdc3a218b525c5d936c.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/4a/22/88/bf9165dca23280f1f6a6fa6e098bd1fb.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/4a/22/88/bf9165dca23280f1f6a6fa6e098bd1fb.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/4a/22/88/bf9165dca23280f1f6a6fa6e098bd1fb.jpg