son":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":16,"review_text":"(16)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/3c/12/ca/8d8b85c928358d8b9b3f65eef35f1e00.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1343,"all_time_quantity_sold":74,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eCông ty phát hành: Wabooks\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eNhà xuất bản: NXB Thanh Niên\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eTác giả: Yamaguchi Tatsu\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eLoại bìa:\u003c/span\u003e \u003cspan style=\"font-weight:400;\"\u003eBìa mềm\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eSố trang:\u003c/span\u003e \u003cspan style=\"font-weight:400;\"\u003e28 trang\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eMựcin thành phần dầu hạt lanh, không chứa chì và thủy ngân\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eGiấy C150 dày khó nhàu rách\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eNăm xuất bản: 10/2020\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eHướng dẫn bố mẹ phương pháp đọc Ehon được in ở đầu mỗi cuốn sách.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eThông tin về bộ sách:\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003e“Phép so sánh diệu kỳ” là bộ sách Ehon gồm 3 cuốn “To nhỏ”; “Cao thấp”; “Dài ngắn”.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eBộ sách là những mẩu chuyện vui về chú Tôm Nhỏ thông thái học cách so sánh những sự vật quen thuộc hằng ngày như chiếc áo, chiếc quần hay trò chơi xây lâu đài cát.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eBộ sách giúp gì cho bé:\u003c/span\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eHình thành tư duy logic và ghi nhớ có chủ đích thông qua những sự vật, câu chuyện quen thuộc.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eNhững mẩu chuyện trong sách chính là cách người Nhật dạy trẻ nhỏ về so sánh \u0026amp; tư duy logic. Sau khi đọc xong, bố mẹ hoàn toàn có thể dùng phương pháp này để rèn cho trẻ ngay tại nhà \u0026amp; ngay từ nhỏ.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eBộ sách phát triển gì:\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003e Thùy Trán – thùy não có chức năng tư duy logic, sáng tạo, giúp phân loại các đối tượng. Đồng thời thùy não còn đóng vai trò hình thành tính cách của bé.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eNội dung đơn giản mà sâu sắc được thể hiện bằng những hình vẽ vô cùng đáng yêu ngộ nghĩnh cùng với những mảng màu lớn, chắc chắn sẽ khiến các bé vô cùng thích thú và hào hứng theo dõi. Hứa hẹn đây sẽ là một bộ sách gối đầu giường của bất kỳ bạn nhỏ nào đang trong độ tuổi lên 3 đấy.\u003c/span\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/3c/12/ca/8d8b85c928358d8b9b3f65eef35f1e00.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/3c/12/ca/8d8b85c928358d8b9b3f65eef35f1e00.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/3c/12/ca/8d8b85c928358d8b9b3f65eef35f1e00.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3c/12/ca/8d8b85c928358d8b9b3f65eef35f1e00.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3c/12/ca/8d8b85c928358d8b9b3f65eef35f1e00.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/cb/9b/ae/123c93a0a2d11a7d03c53841e695afe7.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/cb/9b/ae/123c93a0a2d11a7d03c53841e695afe7.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/cb/9b/ae/123c93a0a2d11a7d03c53841e695afe7.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/cb/9b/ae/123c93a0a2d11a7d03c53841e695afe7.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/cb/9b/ae/123c93a0a2d11a7d03c53841e695afe7.png"},{"base_url":"https://salt.tikicdn.com/ts/product/ca/e3/b7/992ab60f6a761aecb938080689257bd5.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ca/e3/b7/992ab60f6a761aecb938080689257bd5.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ca/e3/b7/992ab60f6a761aecb938080689257bd5.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ca/e3/b7/992ab60f6a761aecb938080689257bd5.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ca/e3/b7/992ab60f6a761aecb938080689257bd5.png"},{"base_url":"https://salt.tik