.7,"review_count":115,"review_text":"(115)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/d4/8f/e4/6d9cd82c9b20e33d50db3b199433d882.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":720,"all_time_quantity_sold":819,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eThùng 24 Lon Bia Budweiser Chính Hãng (330ml/ lon)\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eBudweiser – King of beers – là thương hiệu bia Mỹ đứng đầu thế giới được sản xuất bằng loại mạch nha cùng với hoa bia thượng hạng của Hoa Kỳ và Châu Âu.\u003c/p\u003e\n\u003cp\u003eNhững chai bia Budweiser với vị thơm đậm đà của lúa mạch, cùng hoa bia và nước tinh khiết cùng công nghệ ủ bia bằng gỗ sồi của Budweiser đã tạo ra một hương vị bia tuyệt hảo không thể tìm thấy ở bất kì một loại bia nào khác, là sự cân bằng tuyệt đối giữa vị cay không quá nặng với vị ngọt ngào tinh tế, dịu dàng, làm người uống cảm nhận được chất lượng đỉnh cao đến trong từng hớp bia.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCâu chuyện thương hiệu\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eCâu slogan \"\"King Of Beers\"\" lần đầu được sử dụng vào năm 1898 để kỷ niệm 500 triệu chai bia Budweiser thượng hạng đầu tiên được sản xuất.\u003c/p\u003e\n\u003cp\u003eCông nghệ ủ bia trong gỗ sồi suốt 3 tuần giúp làm sạch men bia trong quá trình trưởng thành và cho ra vị bia thơm ngon độc nhất.\u003cbr /\u003eMen bia nguyên bản sử dụng nấu Budweiser được bảo quản trong hơn 139 năm nay tại Bỉ và Saint Louis (Mỹ), được rã đông mỗi năm một lần và đem đi sử dụng ở tất cả nhà máy của AB Inbev trên toàn thế giới, để cho ra đời cùng một loại bia với hương vị thơm ngon giống nhau.\u003c/p\u003e\n\u003cp\u003eBudweiser là dòng bia duy nhất được ủ với 100% năng lượng tái tạo \u0026amp; 100% lúa mạch thượng hạng của Mỹ.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/d4/8f/e4/6d9cd82c9b20e33d50db3b199433d882.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d4/8f/e4/6d9cd82c9b20e33d50db3b199433d882.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d4/8f/e4/6d9cd82c9b20e33d50db3b199433d882.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d4/8f/e4/6d9cd82c9b20e33d50db3b199433d882.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d4/8f/e4/6d9cd82c9b20e33d50db3b199433d882.png"},{"base_url":"https://salt.tikicdn.com/ts/product/6f/40/80/5246b531fca425d49696571214c16e81.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/6f/40/80/5246b531fca425d49696571214c16e81.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/6f/40/80/5246b531fca425d49696571214c16e81.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6f/40/80/5246b531fca425d49696571214c16e81.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6f/40/80/5246b531fca425d49696571214c16e81.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/c6/1c/4a/8c38416c2d09157bea8c49957eb0c03b.PNG","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c6/1c/4a/8c38416c2d09157bea8c49957eb0c03b.PNG","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c6/1c/4a/8c38416c2d09157bea8c49957eb0c03b.PNG","position":null,"small_url