ềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/69/1b/ea/68e09c53354208843bd1b2a60b3848b4.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/69/1b/ea/68e09c53354208843bd1b2a60b3848b4.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/69/1b/ea/68e09c53354208843bd1b2a60b3848b4.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/69/1b/ea/68e09c53354208843bd1b2a60b3848b4.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/69/1b/ea/68e09c53354208843bd1b2a60b3848b4.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/a3/57/55/4ff4877dee7996e8fac73581c8f10b43.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a3/57/55/4ff4877dee7996e8fac73581c8f10b43.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a3/57/55/4ff4877dee7996e8fac73581c8f10b43.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a3/57/55/4ff4877dee7996e8fac73581c8f10b43.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a3/57/55/4ff4877dee7996e8fac73581c8f10b43.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/46/1a/62/5deb3ee426a4462e4dd1a10b7172ae52.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/46/1a/62/5deb3ee426a4462e4dd1a10b7172ae52.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/46/1a/62/5deb3ee426a4462e4dd1a10b7172ae52.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/46/1a/62/5deb3ee426a4462e4dd1a10b7172ae52.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/46/1a/62/5deb3ee426a4462e4dd1a10b7172ae52.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/de/89/a2/7a1fe06bdf6cac9e846828893e0cea0a.jpg","is_gallery":true,"label":null,"lar