i Tây. \u003c/span\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"background-color: #ffffff; font-size: small;\"\u003e\u003cstrong\u003e Mời các bạn đón đọc!\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/71/01/c3/c5c254d2e2380090d15da6c354c8a6c0.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/71/01/c3/c5c254d2e2380090d15da6c354c8a6c0.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/71/01/c3/c5c254d2e2380090d15da6c354c8a6c0.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/71/01/c3/c5c254d2e2380090d15da6c354c8a6c0.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/71/01/c3/c5c254d2e2380090d15da6c354c8a6c0.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/82/53/65/545916a31a9e5439bef88255eb5646bd.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/82/53/65/545916a31a9e5439bef88255eb5646bd.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/82/53/65/545916a31a9e5439bef88255eb5646bd.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/82/53/65/545916a31a9e5439bef88255eb5646bd.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/82/53/65/545916a31a9e5439bef88255eb5646bd.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/d4/de/d2/66367e09f0d7cd7ee85101e897c8afcc.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d4/de/d2/66367e09f0d7cd7ee85101e897c8afcc.jpg","medium_url":"htt