_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/74/59/59/a02c9d3054b3752238fbc267f90c2a08.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":685,"all_time_quantity_sold":5,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cdiv class=\"_2N2_VN\"\u003eMÔ TẢ SẢN PHẨM\u003c/div\u003e\n\u003cdiv class=\"_2jz573\"\u003e\n\u003cdiv class=\"_1MqcWX\"\u003e\n\u003cp class=\"_2jrvqA\"\u003eVới không gian bếp nhỏ hẹp, hoặc nhu cầu sử dụng không cao, ít người dùng hay đối với các bạn sinh viên không đủ điều kiện kinh tế để sắm cho mình một thì bếp gas đơn là sự lựa chọn tối ưu. Là sản phẩm phục vụ cho nhu cầu khách như thế bếp gas đơn sinh viên Rinnai RV-150(G) vẫn có đầy đủ các tính năng thiết yếu, đặc biệt là độ bền bỉ theo thời gian. Sản phẩm vẫn được bảo hành đầy đủ 24 tháng giống như các sản phẩm bếp gas đôi khác.\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003egas đơn Rinnai RV-150(G) được sản xuất bởi công ty Rinnai Việt Nam có thiết kế bề mặt bằng thép tráng men xám chống han gỉ, chống bán bẩn, dễ vệ sinh. Với lớp men trên bếp sẽ có tuổi thọ cao hơn khi khung bếp không muối hoặc dầu mỡ cặn thức ăn bám vào bề mặt gây mọt, han gỉ lõi thép bên trong.\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003eBếp gas Rinnai RV-150(G) có công suất bếp khá lớn 1 vùng nấu 1 vòng lửa, Công suất bếp có thể điều chỉnh đến mức nhỏ thuận tiện cho các món ninh, hầm, kho, rim… lượng gas tiêu thụ của bếp đạt 0.19 kg/h/1 lò. Hệ thống kiềng thế hệ mới bếp còn có thêm kiềng thép trang men siêu bền không bị han rỉ khi đun nấu ở nhiệt độ cao, ngoài sự vững chãi, đẹp mắt kiềng bếp còn có tác dụng chống trơn trượt, và đặc biệt là chống bám bẩn rất thuận tiện khi vệ sinh., chân kiềng có thể tháo rời để vệ sinh khi cần.\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/74/59/59/a02c9d3054b3752238fbc267f90c2a08.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/74/59/59/a02c9d3054b3752238fbc267f90c2a08.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/74/59/59/a02c9d3054b3752238fbc267f90c2a08.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/74/59/59/a02c9d3054b3752238fbc267f90c2a08.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/74/59/59/a02c9d3054b3752238fbc267f90c2a08.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/cb/fb/90/170307530e6db9662a44ea7c14642b6d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/cb/fb/90/170307530e6db9662a44ea7c14642b6d.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/cb/fb/90/170307530e6db9662a44ea7c14642b6d.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/cb/fb/90/170307530e6db9662a44ea7c14642b6d.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/cb/fb/90/170307530e6db9662a44ea7c14642b6d.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/e4/5c/53/f871fc010d5d1894dab441233f2640d7.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e4/5c/53/f871fc010d5d1894dab441233f2640d7.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e4/5c/53/f871fc010d5d1894dab441233f2640d7.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e4/5c/53/f87