fa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ea/c4/cd/aeb9639dc18f014ac5239480abaaa3d2.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":138,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eViên rửa bát Finish Quantum All in one 100 viên- ĐỨC (Dùng cho máy rửa bát) hoặc combo 2 túi 44 viên thành 88 viên\u003c/p\u003e\n\u003cp\u003eViên rửa chén bát Quantum All in one với 12 chức năng - VIÊN CAO CẤP\u003c/p\u003e\n\u003cp\u003eViên nang ba ngăn giúp loại bỏ hiệu quả tất cả các loại cặn thức ăn - mà không cần rửa trước.\u003c/p\u003e\n\u003cp\u003eViên rửa bảo vệ chống ăn mòn thủy tinh và đồng thời ngăn ngừa cặn vôi trong máy rửa chén.\u003c/p\u003e\n\u003cp\u003eƯu điểm sản phẩm:\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eKhông cần ngâm trước\u003c/li\u003e\u003cli\u003eLoại bỏ bụi bẩn cứng đầu\u003c/li\u003e\u003cli\u003eBảo vệ thủy tinh và bạc\u003c/li\u003e\u003cli\u003eViên rửa chén với công thức 3 ngăn\u003c/li\u003e\u003cli\u003eLoại bỏ tất cả các loại dư lượng thực phẩm\u003c/li\u003e\u003cli\u003eChăm sóc và bảo vệ bát đĩa và máy móc\u003c/li\u003e\u003cli\u003ePhân hủy sinh học, phim hòa tan trong nước\u003c/li\u003e\u003cli\u003eĐể làm sạch sâu với độ bóng rạng rỡ\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003eFinish Chuyên dùng cho tất cả các loại máy rửa bát : Beko, Bosch, Gaggenau, Gorejne, Grundig, Neff, Siemens, S\u003c/p\u003e\n\u003cp\u003eKết quả rửa hoàn hảo với các sản phẩm hoàn thiện\u003c/p\u003e\n\u003cp\u003eKết thúc Quantum làm sạch sâu và tỏa sáng rực rỡ ngay từ lần sử dụng đầu tiên. Hiệu quả ngay cả khi không rửa bát đĩa trước. Viên nang dễ sử dụng, ở dạng màng có thể hòa tan, loại bỏ tất cả các loại cặn thức ăn, ngay cả ở nhiệt độ thấp.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eViên nang 3 ngăn đa chức năng\u003c/p\u003e\n\u003col\u003e\u003cli\u003ePowerball lỏng để tỏa sáng rực rỡ\u003c/li\u003e\u003cli\u003e2 ngăn chứa bột có chức năng ngâm và làm sạch, loại bỏ cặn thức ăn\u003c/li\u003e\u003cli\u003eMàng phân hủy sinh học đảm bảo hòa tan viên nang nhanh chóng và hiệu quả.\u003c/li\u003e\u003c/ol\u003e\n\u003cp\u003eTiết kiệm nước. Không rửa bát đĩa trước khi cho vào máy\u003c/p\u003e\n\u003cp\u003e48 lít nước - đó là số tiền bạn tiết kiệm được trong một tuần nếu bạn không rửa sạch bát đĩa trước khi cho vào máy rửa chén. Nhờ các công thức được sử dụng, viên rửa Finish Classic loại bỏ vết bẩn ngay lần đầu tiên mà không cần phải tráng lại bát đĩa trước khi cho vào máy rửa chén.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eHướng dẫn sử dụng\u003c/p\u003e\n\u003cp\u003eChỉ sử dụng với tay khô. Không đâm thủng, chọc thủng hoặc cắt mở. Đậy kín bao bì sau khi sử dụng. Không giải nén. Hòa tan hoàn toàn trong chu trình súc rửa. Đặt 1 tab mỗi lần rửa trong buồng định lượng khô. Không cho vào giỏ dao kéo.\u003c/p\u003e\n\u003cp\u003eSử dụng chương trình ECO/Auto để có kết quả tốt . Chức năng muối của tab đủ cho độ cứng của nước là 21°dH. Nếu nước của bạn cứng hơn, hãy sử dụng thêm muối Finish.\u003c/p\u003e\n\u003cp\u003eXuất xứ : ĐỨC\u003c/p\u003e\n\u003cp\u003eNgày Sản xuất : In trên bao bì\u003c/p\u003e\n\u003cp\u003eHạn sử dụng : 3 năm kể từ ngày Sản xuất\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e ĐẶT HÀNG QUA WEB - MIỄN PHÍ VẬN CHUYỂN \u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/cd/de/d6/bca22a94f0058c0354748b442569c91d.jpg\" alt=\"\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/product/44/8a/c8/46fd6a9aef7a80a1fad98ba010cba56d.jpg\" alt=\"\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/product/6d/e0/1b/ccd5cfe66fe6159b3d8bed6d04eb0214.jpg\" alt=\"\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/93/59/97/96eac82bb28848cd658552edd1e071f8.jpg\" alt=\"\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/product/93/13/c4/3830c1e999863863f5d302d018faae54.jpg\" alt=\"\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/b1/16/60/fe93256f250c2de2e15cecf454fa31b0.jpg\" alt=\"\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ea/c4/cd/aeb9639dc18f014ac5239480abaaa3d2.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ea/c4/cd/aeb9639dc18f014ac5239480abaaa3d2.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ea/c4/cd/aeb9639dc18f014ac5239480abaaa3d2.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ea/c4/cd/aeb9639dc18f014ac5239480abaaa3d2.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ea/c4/cd/aeb9639dc18f014ac5239480abaaa3d2.jpg"}],"warranty_policy":null,"brand":{"id":459929,"name":"