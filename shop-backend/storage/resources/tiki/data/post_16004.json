_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":227000,"discount_rate":52,"rating_average":4.5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/0f/e4/82/3027396e6beeb3310040634adff0a246.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":453,"all_time_quantity_sold":10,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2\u003eĐIỂM NỔI BẬT CỦA ĐỆM TỰA LƯNG DÀI EMA\u003c/h2\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/c4/d1/3c/c2a5d7670be565391951c852b5bfa322.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e- Thiết kế CHUYÊN BIỆT bảo vệ cột sống thắt lưng hỗ trợ nâng đỡ 3 khu vực: khu vực lưng, khu vực eo, khu vực thắt lưng giúp cột sống luôn được giữ thẳng\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/d4/01/62/dd40e5b617bb754407c963f7b9eadfe0.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e- Chiều dài VƯỢT TRỘI các loại gối tựa lưng trên thị trường cho trải nghiệm thoải mái hơn hẳn\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/7d/87/fc/53e19dfe95c398fa3a6f4aa9f9c47788.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e- Chất liệu Memory Foam (cao su non) kết hợp gai massage giúp tăng cảm giác thoải mái, thư giãn khi tựa lưng\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/ae/95/0b/c51067152fad3770f680003e511ab4cd.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e- Đai gài chắc chắn, giúp đệm cố định trên ghế không bị rơi, trượt trong quá trình sử dụng\u003c/p\u003e\n\u003ch2\u003eCÔNG DỤNG CỦA ĐỆM TỰA LƯNG DÀI EMA\u003c/h2\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/b5/e9/4e/2e9057d8e255c38586cb3f4375ba011e.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e- Với thiết kế CHUẨN CÔNG THÁI HỌC, gối tựa lưng Ema giúp người sử dụng giữ cột sống thắt lưng luôn ở trạng thái thẳng cộng thêm với chất liệu từ Memory Foam với đặc tính đàn hồi chậm giúp giảm áp lực lên vùng thắt lưng. Do đó, khi ngồi lâu với gối tựa lưng Ema sẽ không gây cảm giác đau, mỏi thắt lưng như với việc không sử dụng gối.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/79/45/e4/93d4ee7c53e168e0eba9fe74bc5ce3aa.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e- Gối tựa lưng Ema được thiết kế phù hợp với vóc dáng người Việt Nam, mặt cong của gối sẽ ôm trọn cột sống thắt lưng đồng thời tạo tư thế ngửa lưng thư giãn thoải mái. Vỏ gối được may từ chất liệu lưới 4D giúp tăng khả năng thoát nhiệt và tạo cảm giác massage.\u003c/p\u003e\n\u003ch2\u003eTHÔNG TIN CHI TIẾT GỐI TỰA LƯNG DÀI EMA\u003c/h2\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/5b/38/23/e6da2595a700b1e1136795409f3b8904.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e- Kích thước: Dài 44cm Rộng 37cm Cao 12cm\u003c/p\u003e\n\u003cp\u003e- Thiết kế: Lượn sóng kết hợp gai massage giúp ôm sát cột sống thắt lưng\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/d5/c4/b6/9f24493fb337b0341a067e536b9ede58.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e- Tiện ích: Đai cố định giúp gối cố định trên ghế không bị rơi, trượt trong quá trình sử dụng\u003c/p\u003e\n\u003cp\u003e- Ruột gối: được làm từ chất liệu Memory Foam hay còn gọi là cao su non với đặc tính đàn hồi chậm, độ bền từ 5-7 năm. Đây là vật liệu do trung tâm vũ trụ NASA phát minh vào năm 1966 nhằm nâng cao sự an toàn cho các phần nệm của thiết bị bay nhằm giảm thiểu tối đa áp lực tác động lên các phi hành gia và rung chấn trong quá trình phóng tàu vũ trụ. Ngày này chất liệu này được sử dụng rất nhiều trong ngành công nghiệp gối - đệm\u003c/p\u003e\n\u003cp\u003e- Vỏ gối: Vải lưới 4D sang trọng, thấm hút mồ hôi, thoáng mát mùa hè, tạo cảm giác massage.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/47/e5/81/5a801778c1ca6545ccabfda5c5c9dba2.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e- Màu sắc: Đa dạng phù hợp với tất cả mọi người với 3 lựa chọn chính: Đen lưới, Xanh lưới, Be lưới\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/c7/05/d1/b842115105ec4270f1ae4c592b81fd39.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/71/c8/d2/ce812bdcaa7cde005db192c06bd6bc04.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/89/15/75/59aa2141a4968bc0b7c66ca6bd54a215.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/0f/e4/82/3027396e6beeb3310040634adff0a246.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0f/e4/82/3027396e6beeb3310040634adff0a246.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/0f/e4/82/3027396e6beeb3310040634adff0a246.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0f/e4/82/3027396e6beeb3310040634adff0a246.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0f/e4/82/3027396e6beeb3310040634adff0a246.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/b5/e9/4e/17db3839ed0743b7c6da16142aee3a89.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b5/e9/4e/17db3839ed0743b7c6da16142aee3a89.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b5/e9/4e/17db3839ed0743b7c6da16142aee3a89.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b5/e9/4e/17db3839ed0743b7c6da16142aee3a89.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b5/e9/4e/17db3839ed0743b7c6da16142aee3a89.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/7d/87/fc/6d415db0a7c362e5037c1abc4aea70f9.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/7d/87/fc/6d415db0a7c362e5037c1abc4aea70f9.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/7d/87/fc/6d415db0a7c362e5037c1abc4aea70f9.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7d/87/fc/6d415db0a7c362e5037c1abc4aea70f9.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7d/87/fc/6d415db0a7c362e5037c1abc4aea70f9.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/ae/95/0b/6c8436f8d38012811af1de0521778b69.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ae/95