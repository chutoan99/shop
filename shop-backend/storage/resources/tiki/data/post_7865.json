"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/2d/35/f8/4554336dfd26bf2f645344ce5a3a30fa.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1086,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eTrên thị trường hiện nay có rất nhiều loại đèn bắt muỗi hoạt động theo các nguyên lý khác nhau sử dụng dòng điện ở lưới để bắt muỗi, sử dụng quạt hút để bắt muỗi và loại kết hợp cả 2 phương án lưới và quạt hút…. Tùy từng điều kiện và nhu cầu, mẹ có thể chọn sản phẩm phù hợp cho bé và gia đình.\u003c/p\u003e\n\u003cp\u003eĐèn bắt muỗi Rạng Đông hoạt động theo nguyên lý: Ánh sáng thu hút muỗi đến sau đó quạt hút muỗi vào lồng đựng, tuyệt đối an toàn đặc biệt với gia đình có trẻ nhỏ là lựa chọn mẹ không nên bỏ qua.\u003c/p\u003e\n\u003cp\u003eĐèn có cấu tạo gồm 3 bộ phận chính là module LED, quạt hút, lồng đựng muỗi và nhiều bộ phận cấu thành khác như chao đèn, cover đèn, thân đèn, mạch nguồn, phích và dây điện….\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/42/40/93/1718209bad034b6d14de13b2ae908426.jpg\" alt=\"\" width=\"750\" height=\"508\" /\u003e\u003c/p\u003e\n\u003cp\u003e- Đèn sử dụng LED UV phát ra ánh sáng dịu nhẹ bước sóng 365nm, hiệu quả cao trong việc thu hút các loại côn trùng. Mẹ có thể đặt đèn trên bàn, trên sàn nhà hoặc treo ở bất kỳ đâu phòng khách, phòng ngủ, phòng bếp hay ban công bởi phạm vi thu hút muỗi của đèn lên đến 30m.  \u003c/p\u003e\n\u003cp\u003e- Đèn hoạt động êm ái, không gây tiếng ồn nên không ảnh hưởng đến giấc ngủ, mẹ cũng có thể dùng làm đèn ngủ cho bé vào ban đêm.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/d7/13/bc/c45a54854affb2ad5521b90955875eec.jpg\" alt=\"\" width=\"750\" height=\"393\" /\u003e\u003c/p\u003e\n\u003cp\u003e- Muỗi khi bị hút vào lồng đựng sẽ tự chết sau 48 giờ, rất hiệu quả không gây mùi khét khó chịu như khi sử dụng các loại vợt muỗi và điện cao áp, cũng không dùng khí gas hay tỏa hóa chất độc hại.\u003c/p\u003e\n\u003cp\u003e- Dễ dàng tháo rời và vệ sinh.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/aa/47/d9/e0030c3b621472845bdd9c2f3b06e0f7.jpg\" alt=\"\" width=\"750\" height=\"337\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/2d/35/f8/4554336dfd26bf2f645344ce5a3a30fa.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/2d/35/f8/4554336dfd26bf2f645344ce5a3a30fa.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/2d/35/f8/4554336dfd26bf2f645344ce5a3a30fa.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2d/35/f8/4554336dfd26bf2f645344ce5a3a30fa.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2d/35/f8/4554336dfd26bf2f645344ce5a3a30fa.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/42/40/93/422ec5f3f7a57a563d99171dff6ec924.jpg","is_gallery":true,"lab