lor":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":178000,"discount_rate":19,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/a0/fe/82/a3ab49a1ae353871a4cff021bd195644.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1184,"all_time_quantity_sold":10,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<h1 style=\"text-align: center;\"><span style=\"color: #ff9900;\">COMBO HỖ TRỢ GIẢM ĐAU DẠ DÀY TÁ TRÀNG</span></h1>\n<p style=\"text-align: left;\">Combo bao gồm:</p>\n<p style=\"text-align: left;\">+ 3 Viên Uống Tinh Chất Nghệ Hỗ Trợ Giảm Đau Dạ Dày Novacurmin Hủ 30v</p>\n<p style=\"text-align: left;\">+ 1 Gói Uống Hỗ Trợ Giảm Đau Dạ Dày Novagel</p>\n<p style=\"text-align: left;\"><img style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/bb/c8/7c/ab99563b0f44c492df1c55e609f96015.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<h2 style=\"text-align: center;\"><span style=\"color: #ff9900;\">️ Gói Uống Hỗ Trợ Giảm Đau Dạ Dày Tức Thì Novagel Hộp 20 Gói ️</span></h2>\n<p><span style=\"color: #ff9900;\"><img style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/90/4c/94/a92d011cbd45e394276ddf521cf6bc7f.jpg\" alt=\"\" width=\"750\" height=\"750\" /></span></p>\n<h3 style=\"text-align: left;\"><span style=\"color: #ff9900;\">1. Thành phần Thành phần cho 10ml:</span></h3>\n<p style=\"text-align: left;\">Mật ong……………………………………… 1000mg</p>\n<p style=\"text-align: left;\">200mg Cao hỗn hợp chiết xuất từ:</p>\n<p style=\"text-align: left;\">+ Lá Khôi…………………………………… 2000mg</p>\n<p style=\"text-align: left;\">+ Trần bì……………………………………… 300mg</p>\n<p style=\"text-align: left;\">+ Tam thất………………………………… 200mg</p>\n<p style=\"text-align: left;\">+ Dạ cẩm…………………………………… 200mg</p>\n<p style=\"text-align: left;\">+ Mộc hương………………………………. 200mg</p>\n<p style=\"text-align: left;\">+ Ô tặc cốt…………………………………….120mg</p>\n<p style=\"text-align: left;\">+ Cam thảo………………………………… 100mg</p>\n<p style=\"text-align: left;\">Aluminum Hydroxide…………………….150mg</p>\n<p style=\"text-align: left;\">Magnesium Hydroxide………………….150mg</p>\n<p style=\"text-align: left;\">Curcumin………………………………………100mg</p>\n<p style=\"text-align: left;\">Beta – glucan………………………………….10mg</p>\n<p style=\"text-align: left;\">Novasol Curcumin…………………………</p>\n<p style=\"text-align: left;\">Phụ liệu: Đường, nước tinh khiết, chất bảo quản (E211, E202), hương tổng hợp vừa đủ 10ml.</p>\n<h3 style=\"text-align: left;\"><span style=\"color: #ff9900;\">2. Công dụng</span></h3>\n<p style=\"text-align: left;\">- Hỗ trợ bảo vệ niêm mạc da dày</p>\n<p style=\"text-align: left;\">- Giảm acid dịch vị</p>\n<p style=\"text-align: left;\">- Giúp giảm nguy cơ viêm loét dạ dày, tá tràng.</p>\n<h3 style=\"text-align: left;\"><span style=\"color: #ff9900;\">3. Đối tượng sử dụng</span></h3>\n<p style=\"text-align: left;\">- Người bị viêm loét dạ dày, hành tá tràng với biểu hiện: Đầy hơi, chướng bụng, khó tiêu, ợ hơi, ợ chua, nóng rát, đau thương vị, trào ngược dạ dày thực quản.</p>\n<p style=\"text-align: left;\">- Dùng cho người dễ bị tổn thương niêm mạc dạ dày do uống nhiều rượu bia hoặc tác dụng phụ của thuốc.</p>\n<h3 style=\"text-align: left;\"><span style=\"color: #ff9900;\">4. Cách dùng</span></h3>\n<p style=\"text-align: left;\">- Ngày uống 2-3 lần, mỗi lần 1 gói 10ml. Uống trước bữa ăn 30p</p>\n<p style=\"text-align: left;\">- Thực phẩm này không phải là thuốc, không có tác dụng thay thế thuốc.</p>\n<h2 style=\"text-align: center;\"><span style=\"color: #ff9900;\">️ Viên Uống Tinh Chất Nghệ Hỗ Trợ Giảm Đau Dạ Dày Novacurmin Hủ 30v ️</span></h2>\n<p style=\"text-align: center;\"><span style=\"color: #ff9900;\"><img src=\"https://salt.tikicdn.com/ts/tmp/6b/a7/ee/64a97cc3a4a503ee3c03ba28f5135dc6.jpg\" alt=\"\" width=\"750\" height=\"750\" /></span></p>\n<h3 style=\"text-align: left;\"><span style=\"color: #ff9900;\">1. Công dụng chính của Viên uống Novacurmin:</span></h3>\n<p style=\"text-align: left;\">- Làm giảm các triệu chứng khó chịu của chứng loét dạ dày, hành tá tràng, đại tràng.</p>\n<p style=\"text-align: left;\">- Chống lão hóa.</p>\n<p style=\"text-align: left;\">- Thúc đẩy quá trình làm lành các tổn thương trên da và trong cơ thể.</p>\n<p style=\"text-align: left;\">- Làm đẹp da.</p>\n<p style=\"text-align: left;\">- Giải độc, bảo vệ gan.</p>\n<p style=\"text-align: left;\">- Chống ung thư.</p>\n<h3 style=\"text-align: left;\"><span style=\"color: #ff9900;\">2. Thành phần Viên uống Novacurmin:</span></h3>\n<p style=\"text-align: left;\">- Novasol Curcumin: hoạt chất quý trong củ nghệ tươi có tác dụng giảm tiết dịch vị (giảm yếu tố tấn công) và tăng tiết dịch nhầy (tăng yếu tố bảo vệ) cho dạ dày, giúp làm liền các vết loét nhanh chóng, đồng thời chống oxy hóa, làm đẹp da, ngừa ung thư và bảo vệ gan.</p>\n<p style=\"text-align: left;\">- Bioperin: chiết xuất từ hạt tiêu đen, giúp tăng hấp thu và giảm đào thải Curcumin trong máu, tăng sinh khả dụng của Curcumin trong cơ thể lên gấp 20 lần so với không dùng Bioperin.</p>\n<h3 style=\"text-align: left;\"><span style=\"color: #ff9900;\">3. Mô tả sản phẩm:</span></h3>\n<p style=\"text-align: left;\">Hộp thủy tinh 30 viên nang cứng.</p>\n<h3 style=\"text-align: left;\"><span style=\"color: #ff9900;\">4. Đối tượng sử dụng:</span></h3>\n<p style=\"text-align: left;\">Viên uống Novacurmin dùng cho người từ 18 tuổi trở lên:</p>\n<p style=\"text-align: left;\">- Người bị loét dạ dày, hành tá tràng cấp và mãn tính.</p>\n<p style=\"text-align: left;\">- Người đang trong quá trình phục hồi sau mổm sau chấn thương.</p>\n<h3 style=\"text-align: left;\"><span style=\"color: #ff9900;\">5. Cách dùng:</span></h3>\n<p style=\"text-align: left;\">- Người lớn và trẻ em từ 12 tuổi trở lên: dùng 1-2 viên/lần x 2 lần/ngày sau khi ăn.</p>\n<p style=\"text-align: left;\">- Trẻ em từ 6-12 tuổi: dùng 1 viên/lần x 1-2 lần/ngày sau khi ăn.</p>\n<p style=\"text-align: left;\">- Khuyến cáo nên sử dụng đủ liệu trình 3 hộp để cảm nhận rõ hiệu quả sản phẩm.</p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/a0/fe/82/a3ab49a1ae353871a4cff021bd195644.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a0/fe/82/a3ab49a1ae353871a4cff021bd195644.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a0/fe/82/a3ab49a1ae353871a4cff021bd195644.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a0/fe/82/a3ab49a1ae353871a4cff021bd195644.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a0/fe/82/a3ab49a1ae353871a4cff021bd195644.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/1d/57/d7/1ae094ec8e58ef7b43bc3247f997d654.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/1d/57/d7/1ae094ec8e58ef7b43bc3247f997d654.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/1d/57/d7/1ae094ec8e58ef7b43bc3247f997d654.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1d/57/d7/1ae094ec8e58ef7b43bc3247f997d654.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1d/57/d7/1ae094ec8e58ef7b43bc3247f997d654.jpg"},{"base_url":"https://salt.ti