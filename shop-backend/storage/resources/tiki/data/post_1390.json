n.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":420000,"discount_rate":11,"rating_average":5,"review_count":7,"review_text":"(7)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/de/73/84/80c09b6794ee6d9a273352c806f096b6.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1176,"all_time_quantity_sold":15,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003e* Lắp ráp và vận chuyển:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e+ Tại TP.HCM:\u003c/strong\u003e 100% freeship. SIB Decor giao tận nơi, lắp ráp hoàn thiện cho khách hàng tại TP.HCM từ 0-3 ngày (có giao thứ 7, chủ nhật).\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e+ Các tỉnh/Tp khác:\u003c/strong\u003e SIB Decor có giao trực tiếp tại Bình Dương, Đồng Nai và các khu vực lân cận. Vui lòng gửi tin nhắn CHAT để được tư vấn cụ thể.\u003c/p\u003e\n\u003cp\u003e- Vui lòng nhắn với SIB Decor qua kênh chat nếu bạn có nhu cầu hỗ trợ lắp đặt tận nơi tại TP.HCM (dịch vụ có thu phí)\u003c/p\u003e\n\u003cp\u003e- Nếu có lỗi/hư hỏng (kể cả do lỗi vận chuyển), SIB Decor cam kết gửi thay thế phần bị hỏng ngay khi nhận được yêu cầu.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e— — — — — — — — —\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThông số\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Màu sắc: Vân gỗ sồi phối Trắng, Vàng và Xanh ngọc.\u003c/p\u003e\n\u003cp\u003e- Kích thước: \u003c/p\u003e\n\u003cp\u003e  + Lớn: 180x100x30cm (Cao x Dài x Rộng).\u003c/p\u003e\n\u003cp\u003e  + Vừa: 180x80x30cm (Cao x Dài x Rộng).\u003c/p\u003e\n\u003cp\u003e  + Nhỏ: 180x60x30cm (Cao x Dài x Rộng).\u003c/p\u003e\n\u003cp\u003e- Chất liệu tốt: gỗ MDF lõi xanh chống ẩm, độ dày 17mm, bề mặt phủ melamine đồng màu, căng phẳng có khả năng kháng nước, hạn chế trầy xước, lau sạch dễ dàng.\u003c/p\u003e\n\u003cp\u003e- Sản xuất tại: Việt Nam.\u003c/p\u003e\n\u003cp\u003e- Sản phẩm được sản xuất tại: Công ty TNHH Trang Trí Nội Thất Đơn Giản Là Đẹp\u003c/p\u003e\n\u003cp\u003e- Địa chỉ: 2/4/2 Đông Hưng Thuận 10B, phường Đông Hưng Thuận, Quận 12, TP. Hồ Chí Minh.\u003c/p\u003e\n\u003cp\u003e- Thương hiệu: SIB Decor.\u003c/p\u003e\n\u003cp\u003e*Lưu ý: Sản phẩm không gồm các vật dụng trang trí.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/de/73/84/052368b25ba14ad92a303b79ac8ea100.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e— — — — — — — — —\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e Điểm nổi bật\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Tủ gỗ được thiết kế vô cùng độc đáo với nhiều màu sắc mang phong cách Bắc Âu hiện đại.\u003c/p\u003e\n\u003cp\u003e- Sự kết hợp khéo léo của màu sắc và chia ngăn kệ tạo nên một tổng thể đẹp và cân đối.\u003c/p\u003e\n\u003cp\u003e- Kích thước các tầng được tính toán phù hợp với nhiều khổ sách mang đến khả năng lưu trữ vô cùng rộng rãi. Ngoài ra, là \u003cstrong\u003ebề rộng\u003c/strong\u003e của tủ lên đến \u003cstrong\u003e30cm\u003c/strong\u003e có khả năng để được các khổ sách lớn.\u003c/p\u003e\n\u003cp\u003e- Tủ sử dụng chân gỗ tự nhiên có nút nhựa dễ dàng di chuyển mà không làm hư sàn nhà và hạn chế nguy cơ ẩm mốc.\u003c/p\u003e\n\u003cp\u003e- Tủ sử dụng các tấm gỗ HMR dày 17mm và hệ giằng với thiết kế chắc chắn, an toàn và sử dụng lâu dài. Toàn bộ mặt trước sau và trên dưới đều được làm đẹp (tấm hậu phủ melamine 2 mặt và mặt sau được xử lý đẹp như mặt tiền).\u003c/p\u003e\n\u003cp\u003e- Có thể dễ dàng lắp ráp và tháo dời khi cần với hệ kết cấu ốc cam, chốt gỗ hiện đại (không phải dạng ke L, bắt vít, bắn đinh thiếu thẩm mỹ và chắc chắn).\u003c/p\u003e\n\u003cp\u003e- Sản phẩm khi giao được đóng gói cẩn trọng tránh nguy cơ lỗi do quá trình vận chuyển.\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/a9/70/4a/b2532c60bc415c7e291d2943d02cda87.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e- Bạn có thể đặt tại bất cứ đâu từ phòng khách đến phòng ngủ, phòng bếp hay dùng để trưng bày sản phẩm tại các cửa hàng.\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e- Nếu bạn là người có nhiều vật dụng, kích thước kệ lớn hơn sẽ là lựa chọn hàng đầu để giúp tiết kiệm diện tích.\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/cc/d2/b9/9b512471ac5136980cebb6112adce08c.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/39/77/e3/158a65862f0dacbbcdb43a19b7e1de37.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/e7/75/01/b4cc7484a362588234acd542e5bb936c.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/f1/ab/55/4657bd9bf892ad15f48ff48ddebe2048.jpg\" alt=\"\" width=\"750\" height=\"599\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/f3/2b/81/1e584bd2a43a6e217028142ab0cd6aea.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e— — — — — — — — —\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cstrong\u003eMột số câu hỏi thường gặp\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cstrong\u003eKhi nào tôi nhận được hàng?\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Vận chuyển bởi nhà bán hàng: SIB Decor liên hệ xác nhận ngay sau khi nhận được đơn hàng. Thời gian giao hàng thường từ 0-3 ngày làm việc (có giao thứ 7, chủ nhật).\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Giao hàng tiết kiệm: Thông thường từ 1-5 ngày.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cstrong\u003eSản phẩm còn hàng không?\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Tất cả các sản phẩm đều có hàng sẵn, bạn có thể đặt hàng ngay.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cstrong\u003eCam kết với khách hàng?\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- SIB xử lý các sự cố (nếu có) luôn nhanh nhất và có lợi nhất cho khách hàng.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Bảo hành 1 đổi 1 trong vòng 7 ngày nếu sản phẩm hư hỏng do vận chuyển hoặc do lỗi sản xuất.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Bảo hành chất lượng sản phẩm 24 tháng, bảo trì và chăm sóc trọn đời sản phẩm.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e— — — — — — — — —\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cstrong\u003e Hướng dẫn\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Khi cần làm sạch, chỉ cần dùng khăn ẩm và lau nhẹ (bề mặt phủ melamine có khả năng chống trầy xước, bền màu nên rất dễ làm sạch).\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Hạn chế để nơi có ánh nắng chiếu trực tiếp, nơi ẩm ướt.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e— — — — — — — — —\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cstrong\u003eWelcome to SIB Decor \u0026lt;3\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eChúng tôi phục vụ bạn bằng sự trung thực, luôn sẵn sàng hỗ trợ bạn bất cứ lúc nào. Nếu bạn có bất kỳ câu hỏi nào về việc lắp đặt hoặc bảo hành sản phẩm, vui lòng liên hệ với chúng tôi.\u003c/p\u003e\n\u003cp\u003eHy vọng sản phẩm của SIB Decor sẽ mang lại nhiều hạnh phúc hơn cho cuộc sống của bạn.\u003c/p\u003e\n\u003cp\u003e#kesach #kego#kesachdung #kesachgo #kephongkhach #sibdecor #dongianladep #giasach #giadesach #diy #cabinet #wood #shelf\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/de/73/84/80c09b6794ee6d9a273352c806f096b6.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/de/73/84/80c09b6794ee6d9a273352c806f096b6.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/de/73/84/80c09b6794ee6d9a273352c806f096b6.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/de/73/84/80c09b6794ee6d9a273352c806f096b6.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/de/73/84/80c09b6794ee6d9a273352c806f096b6.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/cc/d2/b9/d70da1db34c3ea764f388c1b1ad0084a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/cc/d2/b9/d70da1db34c3ea764f388c1b1ad0084a.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/cc/d2/b9/d70da1db34c3ea764f388c1b1ad0084a.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/cc/d2/b9/d70da1db34c3ea764f388c1b1ad0084a.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/cc/d2/b9/d70da1db34c3ea764f388c1b1ad0084a.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/a2/10/3b/6c9b0255d19915e198634c451916cee9.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/t