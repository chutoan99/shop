ồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/c3/60/8b/b018c73c463b70adf0792bff6a8d42ec.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c3/60/8b/b018c73c463b70adf0792bff6a8d42ec.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c3/60/8b/b018c73c463b70adf0792bff6a8d42ec.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c3/60/8b/b018c73c463b70adf0792bff6a8d42ec.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c3/60/8b/b018c73c463b70adf0792bff6a8d42ec.jpg"}],"warranty_policy":null,"brand":{"id":50655,"name":"Duy Tân","slug":"duy-tan"},"current_seller":{"id":6331,"sku":"9557362342117","name":"Thịnh Phát 1","link":"https://tiki.vn/cua-hang/thinh-phat-1","logo":"","price":425000,"product_id":"77030374","store_id":6188,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Content","attributes":[{"code":"brand","name":"Thương hiệu","value":"Duy Tân"},{"code":"brand_country","name":"Xuất xứ thương hiệu","value":"Việt Nam"},{"code":"capacity","name":"Dung tích","value":"11 Lít"},{"code":"chat_lieu","name":"Chất liệu","value":"PP"},{"code":"item_model_number","name":"Model","value":"No.899"},{"code":"kich_thuoc","name":"Kích thước (Dài x Rộng x Cao)","value":"49.5 x 29.5 x 29.5"},{"code":"origin","name":"Xuất xứ (Made in)","value":"Việt Nam"},{"code":"product_weight","name":"Trọng lượng sản phẩm","value":"2.6kg"}]},{"name":"Operation","attributes":[{"code":"is_warranty_applied","name":"Sản phẩm có được bảo hành không?","value":"Không"}]}],"product_links":[],"gift_item_title":"0 quà tặng kèm","configurable_options":[{"code":"option1","name":"Màu","position":0,"show_preview_image":true,"values":[{"label":"Tím"}]}],"configurable_products":[{"child_id":10980637,"discount_rate":0,"id":77030374,"images":[{"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c3/60/