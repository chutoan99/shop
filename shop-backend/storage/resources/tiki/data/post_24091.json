scount_rate":18,"rating_average":4.7,"review_count":6,"review_text":"(6)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/71/79/db/1091ac6bb54d8bc9783d82c0b4e69646.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1834,"all_time_quantity_sold":16,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/8c/59/c2/fd0f002ca195d2a2e9b43af929145ec2.jpg\" alt=\"Bình Đun Siêu Tốc Toshiba KT-17SH1NV (1.7 Lít) - Hàng Chính Hãng\" width=\"750\" height=\"616\" /\u003e\u003c/p\u003e\n\u003ch5\u003eChất liệu cao cấp\u003c/h5\u003e\n\u003cp\u003e\u003cstrong\u003eBình đun siêu tốc TOSHIBA KT-17SH1NV\u003c/strong\u003e được làm bằng thép không gỉ, có độ bền cao, chống bám cặn. Bình có kiểu dáng đơn giản, nhỏ gọn, không chiếm nhiều diện tích, góp phần tô điểm thêm cho không gian căn bếp nhà bạn.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/9b/0a/ca/0db7d324ed41771cc0b49c8a55f62b9c.jpg\" alt=\"\" width=\"750\" height=\"415\" /\u003e\u003c/p\u003e\n\u003ch5\u003eDung tích bình 1.7L\u003c/h5\u003e\n\u003cp\u003eDung tích 1.7 lít nên đảm bảo được các nhu cầu sử dụng của các thành viên trong gia đình: pha trà, nấu mì, uống sữỉ sau vài phút chờ đợi là bạn đã có ngay một bình nước nóng để sử dụng. Ấm có thể được rót đầy nước thông qua vòi hoặc bằng cách mở nắp giúp bạn sử dụng ấm tiện lợi hơn.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/13/a3/ee/17b9a83115eb6dd7b197aded440dfc08.jpg\" alt=\"\" width=\"750\" height=\"402\" /\u003e\u003c/p\u003e\n\u003ch5\u003eTốc độ đun nhanh\u003c/h5\u003e\n\u003cp\u003eCông suất của ấm là 2150W giúp đun nước nhanh sôi. Với tay cầm bằng nhựa cao cấp cách nhiệt và công tắc gạt bật tắt dưới thân tay cầm cũng mang lại sự tiện dụng khi hoạt động. Ngoài ra ấm còn có tính năng tự động ngắt điện khi sôi và khi ấm cạn nước, an toàn hơn khi sử dụng. Dây điện của ấm tách rời, giúp bạn đỡ vướng víu khi lấy nước hoặc rót nước.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/bb/8b/19/23dcfa5023b5570fa68979d0c2b800e2.jpg\" alt=\"\" width=\"750\" height=\"362\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/a8/18/b8/435bf455cace9bd393a757e9c94efb7a.jpg\" alt=\"\" width=\"750\" height=\"405\" /\u003e\u003c/p\u003e\n\u003ch5\u003eĐế xoay 360 độ\u003c/h5\u003e\n\u003cp\u003eThao tác với bình cũng tương đối đơn giản bạn chỉ cần dùng ngón tay ấn nút trên nắp bình và đổ nước vào, sau đó đậy lại, cắm điện và bật nút nguồn. Đồng thời, bạn cũng có thể quan sát được lượng nước bên trong nhờ vào thang đo bên ngoài ấm. Đế xoay 360 độ giúp bạn dễ nâng, nhấc bình lên. Đây sẽ là một sự lựa chọn tuyệt vời cho những người bận rộn muốn tiết kiệm thời gian trong việc đun sôi nước hằng ngày.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/51/be/b0/cb2cad1d1a48b72ee5538e77fc8fbc39.jpg\" alt=\"\" width=\"750\" height=\"415\" /\u003e\u003c/p\u003e\n\u003ch5\u003eĐèn LED tự động báo hiệu bật/tắt\u003c/h5\u003e\n\u003cp\u003eĐèn sáng đỏ từ khi bắt đầu cho đến khi kết thúc quá trình đun sôi nước, giúp người sử dụng dễ dàng nhận biết nước đã sôi hay chưa mà không cần mở nắp.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/8f/47/b6/b5c2875c73f2885d21097b36903eb81a.jpg\" alt=\"\" width=\"750\" height=\"415\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 tri