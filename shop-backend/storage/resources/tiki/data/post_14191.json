kicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"freeship_xtra","type":"pdp_icon_badge","index":2,"icon":"https://salt.tikicdn.com/ts/upload/be/67/48/04a82ab8df178e1a13bde38316081865.png","icon_width":91,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":true,"return_reason":"any_reason"}},"discount":24000,"discount_rate":19,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/49/23/99/f3eb67f30638919ec9db3e943f5bb63e.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":200,"all_time_quantity_sold":8,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eThần Đèn - Tập 1\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eTác giả: Thâm Hải Cự Cẩu\u003c/li\u003e\n\u003cli\u003eDịch giả: Bán Sinh Phù Trầm\u003c/li\u003e\n\u003cli\u003eThể loại: Truyện tranh \u003c/li\u003e\n\u003cli\u003eKhổ sách: 13x18cm\u003c/li\u003e\n\u003cli\u003eSố trang: 228 trang in màu\u003c/li\u003e\n\u003cli\u003eISBN: 978-604-378-867-9\u003c/li\u003e\n\u003cli\u003eNXB liên kết: NXB Dân Trí\u003c/li\u003e\n\u003cli\u003eQuà tặng kèm: Sách chỉ có một phiên bản duy nhất, bao gồm bộ bìa 2 lớp độc đáo, cán màng nhung mịn, phần tên truyện phủ nhũ sần huyền bí; 01 PVC postcard màu, 01 Booklet 4 trang đặc biệt - \"Red và Azur\" ở một chiều không gian \"tuyệt đối thẳng\". \u003c/li\u003e\n\u003cli\u003ePhát hành: 01/03/2024 \u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eGiới thiệu:\u003c/p\u003e\n\u003cp\u003eTương truyền rằng có một tinh linh sở hữu sức mạnh vô ngần bị nhốt trong cây đèn thần, ai tìm thấy đèn thần thì có thể trở thành chủ nhân của tinh linh. Tinh linh sẽ thực hiện ba điều ước của chủ nhân. Sau khi điều ước cuối cùng thành hiện thực, tinh linh sẽ có được sự tự do.\u003c/p\u003e\n\u003cp\u003eCậu bé Red sống tại một ngôi làng bị núi lửa tàn phá, toàn bộ gia sản chỉ có hai chú cừu nhỏ. Khi Red đến tuổi có thể đi chăn cừu một mình, mẹ dặn cậu không được bén mảng lại gần núi lửa kia. Tinh linh mưu ma chước quỷ, sẽ làm mụ mị đầu óc con người rồi nuốt linh hồn họ.\u003c/p\u003e\n\u003cp\u003eRed nhớ như in lời mẹ dặn, thế nhưng cừu của cậu lại sẩy chân ngã xuống một cái hang tối om. Ở đó, cậu tìm thấy cây đèn thần, gọi ra tinh linh và được ban cho ba điều ướ\u003c/p\u003e\n\u003cp\u003eKhác với truyện cổ tích, Red không ước mình có gia tài khổng lồ, không ước mình được lấy công chúa - cậu ước mình được sống cuộc đời của một anh hùng giống cha mình.\u003c/p\u003e\n\u003cp\u003eĐể thực hiện điều ước của Red, Thần Đèn không chỉ ban cho cậu phước lành mà còn biến thành cậu bạn đồng hành với Red từ thuở niên thiếu tới khi trở thành một người lính can đảm. Azur kề vai chiến đấu bên Red và rồi hy sinh như bao người bạn chí cốt của các anh hùng khác.\u003c/p\u003e\n\u003cp\u003eThần Đèn tưởng rằng chỉ cần Red giết được tướng địch, ca khúc khải hoàn trở về quê hương là điều ước của cậu đã trở thành sự thật. Nhưng thực tế lại không như mưu tính của nó\u003c/p\u003e\n\u003cp\u003eMột kẻ mưu ma chước quỷ, dùng mọi thủ đoạn để hoàn thành điều ước.\u003c/p\u003e\n\u003cp\u003eMột kẻ lại đắm chìm trong thế giới màu nhiệm, tưởng rằng đối phương hết lòng với mình là vì tình yêu.\u003c/p\u003e\n\u003cp\u003eĐến cuối cùng, khi phép màu biến mất, Red buộc phải đối mặt với hiện thực tàn khố\u003c/p\u003e\n\u003cp\u003e#amak #truyện_tranh #thần_đèn_1 #thâm_hải_cự_cẩu\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/49/23/99/f3eb67f30638919ec9db3e943f5bb63e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/49/23/99/f3eb67f30638919ec9db3e943f5bb63e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/49/23/99/f3eb67f30638919ec9db3e943f5bb63e.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/49/23/99/f3eb67f30638919ec9db3e943f5bb63e.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/49/23/99/f3eb67f30638919ec9db3e943f5bb63e.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/fd/cb/e0/a742288d573aa6e248a23b26a6fce62e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/fd/cb/e0/a742288d573aa6e248a23b26a6fce62e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/fd/cb/e0/a742288d573aa6e248a23b26a6fce62e.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fd/cb/e0/a742288d573aa6e248a23b26a6fce62e.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fd/cb/e0/a742288d573aa6e248a23b26a6fce62e.jpg"},{"base_url":"https://salt.ti