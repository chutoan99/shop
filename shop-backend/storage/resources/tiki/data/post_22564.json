r":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/a1/71/62/e1dba3bbe3f00880adf7bdcea2fa5fee.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":222,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" title=\"Sữa Bột Abbott Glucerna GLVLA Dành Cho Người Đái Tháo Đường Và Tiền Đái Tháo Đường (850g)\" src=\"http://tikicdn.com/media/catalog/product/1/9/1975.jpg\" alt=\"Sữa Bột Abbott Glucerna GLVLA Dành Cho Người Đái Tháo Đường Và Tiền Đái Tháo Đường (850g)\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch3\u003eGiới thiệu\u003c/h3\u003e\n\u003cp\u003e\u003cstrong\u003eSữa Bột Abbott Glucerna Vani 850g \u003c/strong\u003eđược chứng minh lâm sàng giúp kiểm soát tốt đường huyết nhờ sử dụng công thức tiên tiến và hệ dưỡng chất đặc chế Triple Care. Sản phẩm tốt cho tim mạch, giúp bạn giảm vòng eo và cân nặng hiệu quả.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eC\u003c/strong\u003e\u003cstrong\u003eông thức tiên tiến và hệ dưỡng chất đặc chế Triple Care\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eSữa Bột Abbott Glucerna Vani 850g có công thức tiên tiến và hệ dưỡng chất đặc chế Triple Care cho khả năng kiểm soát đường huyết hiệu quả:\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eHệ bột đường tiên tiến, với chỉ số đường huyết thấp và được tiêu hóa từ từ giúp bình ổn đường huyết.\u003c/li\u003e\u003cli\u003eHỗn hợp chất béo đặc chế giàu acid béo không no một nối đôi (MUFA) và Omega-3 tốt cho tim mạch.\u003c/li\u003e\u003cli\u003ePhối hợp độc đáo các dưỡng chất bao gồm Fructo-oligosaccharid (FOS).\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" title=\"Sữa Bột Abbott Glucerna GLV Dành Cho Người Đái Tháo Đường Và Tiền Đái Tháo Đường (400g)\" src=\"http://tikicdn.com/media/catalog/product/1/9/1974.jpg\" alt=\"Sữa Bột Abbott Glucerna GLV Dành Cho Người Đái Tháo Đường Và Tiền Đái Tháo Đường (400g)\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCung cấp dinh dưỡng đầy đủ và cân đối \u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eSữa Bột Abbott Glucerna Vani 400g đã được chứng minh lâm sàng và cung cấp dinh dưỡng đầy đủ và cân đối giúp kiểm soát đường huyết. Sản phẩm giúp bạn tự tin hơn với cơ thể khỏe mạnh lâu dài, hạn chế sự phát triển những triệu chứng của bệnh do thói quen ăn uống không hợp lý.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCó thể thay thế toàn phần bữa ăn chính\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eSữa Bột Abbott Glucerna Vani 850g được nghiên cứu và chứng minh thực tế có thể dùng thay thế toàn phần bữa ăn chính hoặc để làm bữa ăn phụ. Sản phẩm giúp bạn gỡ bỏ mối lo lựa chọn thực phẩm, chế độ ăn mỗi ngày, đặc biệt hữu ích khi cần chuẩn bị bữa ăn khi đi xa, du lịch.\u003c/p\u003e\n\u003ch3\u003eThành phần\u003c/h3\u003e\n\u003cp\u003eMaltodextrin, DẦU THỰC VẬT (dầu hướng dương giàu oleic, dầu đậu nành), canxi caseinat, sucromalt, đạm đậu nành tinh chế, maltitol, đạm sữa cô đặc, KHOÁNG CHẤT (kali clorid, magiê sulfat, canxi carbonat, kali citrat, natri phosphat, natri clorid, magiê phosphat, natri citrat, kali hydroxid, kẽm sulfat, sắt sulfat, mangan sulfat, đồng sulfat, crôm clorid, kali iodid, natri molybdat, natri selenit), fructose, fructo-oligosaccharid (FOS), isomaltulose, myo-inositol, chất xơ yến mạch, hương vani tổng hợp, carboxymethyl cellulose, cholin clorid, lecithin, gôm xanthan, VITAMIN (ascorbyl palmitat, acid ascorbic, vitamin E, niacinamid, canxi d-pantothenat, pyridoxin hydroclorid, thiamin clorid hydroclorid, riboflavin, vitamin A palmitat, acid folic, phylloquinon, d-biotin, cholecalciferol, cyanocobalamin), taurin, l-carnitin, hỗn hợp tocopherol.\u003c/p\u003e\n\u003ch3\u003eHướng dẫn sử dụng\u003c/h3\u003e\n\u003cul\u003e\u003cli\u003eĐun sôi nước trước khi dùng để pha và làm theo bảng hướng dẫn kèm theo. Chỉ dùng muỗng có sẵn trong hộp để lường sữa. Lượng pha dư hơn 1 lần uống phải bảo quản trong tủ lạnh ở 2-4ºC không quá 24 giờ.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eCách pha chuẩn\u003c/strong\u003e: Để pha 1 ly 237 ml, cho 200 ml nước chín để nguội vào ly. Vừa từ từ cho vào ly 5 muỗng gạt ngang (muỗng có sẵn trong hộp) tương đương 52.1g bột Glucerna, vừa khuấy đều cho đến khi bột tan hết.\u003c/li\u003e\u003c/ul\u003e\n\u003ch3\u003eHướng dẫn sử dụng\u003c/h3\u003e\n\u003cp\u003eBảo quản hộp chưa mở ở nhiệt độ phòng. Sau khi mở nắp cần sử dụng hết trong vòng 3 tuần. Đậy nắp kín sau mỗi lần sử dụng, để nơi khô mát (không cho vào tủ lạnh).\u003c/p\u003e\n\u003ch3\u003eLưu ý\u003c/h3\u003e\n\u003cul\u003e\u003cli\u003eĐược dùng để bổ sung dinh dưỡng giúp cân bằng đường huyết. Dùng theo sự hướng dẫn của bác sĩ. Không dùng cho trẻ em trừ khi có chỉ định của thầy thuốc hoặc chuyên viên y tế.\u003c/li\u003e\u003cli\u003eKhông dùng lò viba để hâm nóng sữa\u003c/li\u003e\u003cli\u003e\u003cem\u003e\u003cstrong\u003eSản phẩm giới hạn, mỗi khách hàng chỉ được mua tối đa 2 hộp. Tiki xin phép từ chối các đơn hàng mua sỉ.\u003c/strong\u003e\u003c/em\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/a1/71/62/e1dba3bbe3f00880adf7bdcea2fa5fee.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a1/71/62/e1dba3bbe3f00880adf7bdcea2fa5fee.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a1/71/62/e1dba3bbe3f00880adf7bdcea2fa5fee.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a1/71/62/e1dba3bbe3f00880adf7bdcea2fa5fee.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a1/71/62/e1dba3bbe3f00880adf7bdcea2fa5fee.png"},{"base_url":"https://salt.tikicdn.com/ts/product/46/e3/c7/9a94c676a89097c0a0e78fde3ec95cdd.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/46/e3/c7/9a94c676a89097c0a0e78fde3ec95cdd.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/46/e3/c7/9a94c676a89097c0a0e78fde3ec95cdd.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/46/e3/c7/9a94c676a89097c0a0e78fde3ec95cdd.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/46/e3/c7/9a94c676a89097c0a0e78fde3ec95cdd.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/4b/a4/c4/d5198720ad9a1441204ab2604808c5fb.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/4b/a4/c4/d5198720ad9a1441204ab2604808c5fb.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/4b/a4/c4/d5198720ad9a1441204ab2604808c5fb.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4b/a4/c4/d5198720ad9a1441204ab2604808c5fb.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4b/a4/c4/d5198720ad9a1441204ab2604808c5fb.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/d3/22/79/18f6c7294fe43af4616d54a190ba102a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d3/22/79/18f6c7294fe43af4616d54a190b