13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":210000,"discount_rate":28,"rating_average":4.6,"review_count":26,"review_text":"(26)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/1c/fb/97/3b9ccd7f5585e7b4723f28bfe5a53261.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":292,"all_time_quantity_sold":335,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p class=\"_2jrvqA\">1.THÔNG SỐ KỸ THUẬT SẢN PHẨM:</p>\n<div class=\"_2jrvqA\">\n<div>\n<div class=\"_1OPdfl\"><img class=\"_2qyaZL _2PWsS4\" src=\"https://cf.shopee.vn/file/sg-11134202-22090-bulw1s3ko1hv92\" alt=\"sg-11134202-22090-bulw1s3ko1hv92\" /></div>\n</div>\n</div>\n<p class=\"_2jrvqA\"> </p>\n<p class=\"_2jrvqA\">2. THÔNG TIN SẢN PHẨM</p>\n<p class=\"_2jrvqA\">Lò nướng điện COMET CM6510 - Dung tích 10L là một thiết bị điện gia dụng giúp hỗ trợ người dùng nướng chín thức ăn nhanh mà vẫn đảm bảo độ tươi ngon, rất thích hợp cho những nhu cầu nấu nướng nhanh cho các bữa tiệt tại gia. Đây thật sự là một trong những giải pháp thông minh giúp người dùng vừa có thể thưởng thức món ăn nướng nhanh, nhưng vẫn giữ được độ tươi ngon của sản phẩm.</p>\n<p class=\"_2jrvqA\">Trong những năm gần đây, những chiếc lò nướng điện ngày càng được ưa chuộng hơn, nhờ tích hợp nhiều công nghệ mới như giảm khói, đa dạng chế độ nấu,dung tích lò nướng lớn… Tuy có nhiều tính năng ưu việt, nhưng việc chọn lựa và mua nồi phù hợp chưa bao giờ là dễ dàng. Cùng điểm qua các chức năng của Lò nướng điện COMET CM6510</p>\n<p class=\"_2jrvqA\"> </p>\n<div class=\"_2jrvqA\">\n<div>\n<div class=\"_1OPdfl\"><img class=\"_2qyaZL _2PWsS4\" src=\"https://cf.shopee.vn/file/sg-11134202-22090-qmmsl2eoq1hv06\" alt=\"sg-11134202-22090-qmmsl2eoq1hv06\" /></div>\n</div>\n</div>\n<p class=\"_2jrvqA\"> </p>\n<p class=\"_2jrvqA\">3.ĐẶC ĐIỂM SẢN PHẨM:</p>\n<p class=\"_2jrvqA\">- Lưu thông không khí nóng hai chiều, làm nóng đồng đều.</p>\n<p class=\"_2jrvqA\">- Núm điều khiển kép nhiệt độ - thời gian, đơn giản và dễ vận hành.</p>\n<p class=\"_2jrvqA\">- Dung tích 10L phù hợp đáp ứng cho bữa tối của gia đình nhỏ.</p>\n<p class=\"_2jrvqA\">- Lò nướng nhỏ gọn, dễ vệ sinh.</p>\n<p class=\"_2jrvqA\">- Nhiều chế độ nướng khác nhau</p>\n<p class=\"_2jrvqA\">- Chế độ làm nóng: Làm nóng ống sưởi bằng thép không gỉ bằng không khí lưu thông động cơ.</p>\n<div class=\"_2jrvqA\">\n<div>\n<div class=\"_1OPdfl\"><img class=\"_2qyaZL _2PWsS4\" src=\"https://cf.shopee.vn/file/57efdf47dd30befabedb1c631de8d8c7\" alt=\"57efdf47dd30befabedb1c631de8d8c7\" /></div>\n</div>\n</div>\n<p class=\"_2jrvqA\">4.CÔNG DỤNG VÀ CHỨC NĂNG CỦA SẢN PHẨM:</p>\n<p class=\"_2jrvqA\">- Núm điều khiển kép, dễ điều chỉnh &amp; nấu nướng.</p>\n<p class=\"_2jrvqA\">- Cửa lò đóng mở dễ dàng</p>\n<p class=\"_2jrvqA\">- Khay nướng có thể tháo rời, - vỉ nướng cố định trong lò, vệ sinh dễ dàng.</p>\n<p class=\"_2jrvqA\"> </p>\n<div class=\"_2jrvqA\">\n<div>\n<div class=\"_1OPdfl\"><img class=\"_2qyaZL _2PWsS4\" src=\"https://cf.shopee.vn/file/sg-11134202-22090-aelp7icpq1hvda\" alt=\"sg-11134202-22090-aelp7icpq1hvda\" /></div>\n</div>\n</div>\n<p class=\"_2jrvqA\"> </p>\n<p class=\"_2jrvqA\">5.CHẤT LIỆU SẢN PHẨM:</p>\n<p class=\"_2jrvqA\">- Vật liệu phần thân: Vỏ tole phủ sơn.</p>\n<p class=\"_2jrvqA\">- Mặt kính : kính chịu lực, chịu nhiệt trong suốt giúp bạn dễ dàng quan sát được quá trình hoạt động của lò nướng.</p>\n<p class=\"_2jrvqA\"> </p>\n<div class=\"_2jrvqA\">\n<div>\n<div class=\"_1OPdfl\"><img class=\"_2qyaZL _2PWsS4\" src=\"https://cf.shopee.vn/file/sg-11134202-22090-ca7e2e3zl2hv10\" alt=\"sg-11134202-22090-ca7e2e3zl2hv10\" /></div>\n</div>\n</div>\n<p class=\"_2jrvqA\"> </p>\n<p class=\"_2jrvqA\">6.PHỤ KIỆN ĐI KÈM:</p>\n<p class=\"_2jrvqA\">- Hướng dẫn (bản sao): 1</p>\n<p class=\"_2jrvqA\">- Túi PE: 1</p>\n<p class=\"_2jrvqA\">- Nguồn cắm điện: VDE</p>\n<p class=\"_2jrvqA\">- Khay nướng nhôm</p>\n<p class=\"_2jrvqA\"> </p>\n<div class=\"_2jrvqA\">\n<div>\n<div class=\"_1OPdfl\"><img class=\"_2qyaZL _2PWsS4\" src=\"https://cf.shopee.vn/file/sg-11134202-22090-nb8t71j5l2hv27\" alt=\"sg-11134202-22090-nb8t71j5l2hv27\" /></div>\n</div>\n</div>\n<p class=\"_2jrvqA\"> </p>\n<p class=\"_2jrvqA\">7.CHẾ ĐỘ BẢO HÀNH:</p>\n<p class=\"_2jrvqA\">- Bảo hành 1 năm.</p>\n<p class=\"_2jrvqA\">- Đổi mới hoàn toàn trong 1 năm nếu lỗi do nhà sản xuất.</p>\n<p class=\"_2jrvqA\">- Bảo hành sản phẩm tận nhà (Áp dụng khu vực TP.HCM)</p>\n<div class=\"_2jrvqA\">\n<div class=\"_1OPdfl\"> </div>\n</div>\n<p class=\"_2jrvqA\">8.THÔNG TIN THƯƠNG HIỆU</p>\n<div class=\"_2jrvqA\">\n<div>\n<div class=\"_1OPdfl\"><img class=\"_2qyaZL _2PWsS4\" src=\"https://cf.shopee.vn/file/sg-11134202-22090-jomrjfb0o1hvb0\" alt=\"sg-11134202-22090-jomrjfb0o1hvb0\" /></div>\n</div>\n</div><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/1c/fb/97/3b9ccd7f5585e7b4723f28bfe5a53261.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/1c/fb/97/3b9ccd7f5585e7b4723f28bfe5a53261.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/1c/fb/97/3b9ccd7f5585e7b4723f28bfe5a53261.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1c/fb/97/3b9ccd7f5585e7b4723f28bfe5a532