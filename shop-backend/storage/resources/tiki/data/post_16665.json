800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":3.7,"review_count":11,"review_text":"(11)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/d0/29/e5/75f3e6eb2a01bdce0deffa46f8982b3e.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1521,"all_time_quantity_sold":102,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eMặt Chống nước ổ cắm điện, Công Tắc Điện vuông ngoài trời Cao Cấp Tenko TK-IP66 (  chưa bao gồm ổ cắm bên trong )\u003c/strong\u003e\u003c/p\u003e\n\u003cdiv\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/01/a8/c4/e4865098d48e5b187fd2653934a61cc4.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eKhi lắp đặt công tắc điện ở ngoài trời, chắc chắn công tắc điện đó sẽ phải chống chịu với rất nhiều điều kiện thời tiết khác nhau. Nên để đảm bảo an toàn cho người sử dụng thì nên lựa chọn loại công tắc điện có mặt che mưa.\u003c/p\u003e\n\u003cp\u003eCông tắc điện có mặt che mưa giúp chống thấm nước tốt, bảo vệ được công tắc bên trong chống khỏi hơi ẩm nên có thể lắp đặt ở điều kiện ngoài trời rất thuận lợi. Người tiêu dùng có thể lựa chọn công tắc mặt che mưa gồm một mặt công tắc ổ cắm dùng cho 1,2,3 hoặc 4 thiết bị điện.\u003c/p\u003e\n\u003cp\u003eBên cạnh đó, người tiêu dùng cũng nên lựa chọn công tắc điện có khả năng chống giật, chống nước để khi lắp đặt ở ngoài trời và trong quá trình sử dụng, bạn sẽ khắc phục được tình trạng bị chập, cháy hay bị điện giật trong quá trình sử dụng.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/c8/08/65/486e3e893503694e9164b9cc41e770a7.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003c/div\u003e\n\u003ch3\u003e\u003cspan id=\"Thong_so_ky_thuat_o_cam_dien_ngoai_troi_chong_nuoc_chong_bui\"\u003eThông số kỹ thuật Mặt Chống nước ổ cắm điện, Công Tắc Điện vuông ngoài trời Tenko TK-IP66\u003c/span\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eKích thước: 110x110x98 mm\u003c/li\u003e\n\u003cli\u003eDòng tải định mức: phụ thuộc ổ cắm hoặc công tắc lắp kèm\u003c/li\u003e\n\u003cli\u003eChất liệu vỏ hộp: nhựa ABS. Sử dụng doăng cao su chống nước tuyệt đối\u003c/li\u003e\n\u003cli\u003eCó nắp nhựa trong bảo vệ khỏi bị dính nước , sử dụng được ở trong nhà vườn, biệt thự… tạo phong cách riêng\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/67/ea/58/6521d1096183e68c77fadb25e4feeadc.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eTừ khóa tìm kiếm: Hộp bảo vệ ổ điện ngoài trời, lắp ổ điện ngoài trời, mặt che ổ cắm điện ngoài trời, nắp che ổ điện ngoài trời, tenko, Mặt Chống nước ổ cắm điện, Mặt Chống nước công tắc điện\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/d0/29/e5/75f3e6eb2a01bdce0deffa46f8982b3e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d0/29/e5/75f3e6eb2