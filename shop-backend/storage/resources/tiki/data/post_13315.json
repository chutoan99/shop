:null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.1,"review_count":15,"review_text":"(15)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/59/9e/b2/45dadc9cc4828792ad2e7c87646914f3.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1980,"all_time_quantity_sold":85,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cul\u003e\n\u003cli\u003eMũ bảo hiểm A27 kính  là loại mũ bảo hiểm trùm đầu cao cấp có thiết kế vỏ ngoài làm bằng hạt nhựa ABS chịu lực va đập và tránh trầy xước , độ bền cao\u003c/li\u003e\n\u003cli\u003eMút xốp làm bằng nhựa EPS hấp thụ gần như hoàn toàn lực tác dụng do va đập bảo vệ  phần đầu của bạn khỏi chấn động khi tai nạn\u003c/li\u003e\n\u003cli\u003eQuai mũ dệt 2 lớp bằng sợi tổng hợp, chịu lực kéo lực văng tốt, dễ thao tác khi dùng\u003c/li\u003e\n\u003cli\u003eKính mầu trà làm từ nhựa PC và được xử lý nano có khả năng hạn chế vỡ, trầy xước, chống tia  UV, nâng lên hạ xuống dễ dàng, cho hình ảnh trung thực cao\u003c/li\u003e\n\u003cli\u003eVải lót dầy, sử dụng nguyên liệu thấm hút cao\u003c/li\u003e\n\u003cli\u003eMũ được sơn bằng nguyên liệu ngoại nhập, độ bền cao\u003c/li\u003e\n\u003cli\u003eGRS A27 kính bảo vệ được phần đầu, phần tai, phần mặt và tạo được cảm giác thoải mái cho người đội \u003c/li\u003e\n\u003cli\u003eMũ bảo hiểm GRS A27 kính đạt tiêu chuẩn QCVN 2:2008/BKHCN\u003c/li\u003e\n\u003cli\u003eMũ phù hợp chu vi vòng đầu từ 55cm- 59cm (size phổ biến cho người trưởng thành, nón chỉ có 1 size chung)\u003c/li\u003e\n\u003cli\u003eHướng dẫn xác định cỡ mũ phù hợp: Vòng 1 sợi dây quanh đầu, ngay phía trên lông mày và tai. Xiết sợi dây sao cho ôm vừa đủ thoải mái lấy đầu và ghi lại số đo đó. Lặp lại như vậy để tìm được số đo mà bạn thấy đầu dễ chịu nhất và sử dụng số đo đó.\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/59/9e/b2/45dadc9cc4828792ad2e7c87646914f3.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/59/9e/b2/45dadc9cc4828792ad2e7c87646914f3.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/59/9e/b2/45dadc9cc4828792ad2e7c87646914f3.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/59/9e/b2/45dadc9cc4828792ad2e7c87646914f3.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/59/9e/b2/45dadc9cc4828792ad2e7c87646914f3.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/69/f2/1b/f2b445a912af413a2a2def716ba065f2.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/69/f2/1b/f2b445a912af413a2a2def716ba065f2.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/69/f2/1b/f2b445a912af413a2a2def716ba065f2.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/69/f2/1b/f2b445a912af413a2a2def716ba065f2.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/69/f2/1b/f2b445a912af413a2a2def716ba065f2.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/89/28/da/6bd62377e2289d5938d4cc565df91e1a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/89/28/da/6bd62377e2289d5938d4cc565df91e1a.jpg","mediu