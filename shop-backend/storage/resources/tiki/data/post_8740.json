,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":650000,"discount_rate":37,"rating_average":4.7,"review_count":6,"review_text":"(6)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/fa/f3/16/acde4dec7d6f7dab7706b3dd4ad451bf.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":491,"all_time_quantity_sold":20,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eMáy đấm lưng Bear AMQ-A01X1 thiết kế dạng đai cân bằng thông minh, sử dụng công nghệ Nhật Bản mô phỏng chân thật nhất phương pháp đấm massage như tay người giúp bạn thư giãn vùng cổ, vai gáy, thắt lưng và đùi nhanh chóng và hiệu quả nhất.\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/67/81/1d/6c277a05d1b0dc21d1d7a94fa8cae7df.jpg?v=1628350335222\" alt=\"6c277a05d1b0dc21d1d7a94fa8cae7df.jpg?v=1628350335222\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eMáy đấm lưng Bear sử dụng công nghệ Nhật Bản\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eMáy đấm lưng là một trong những sản phẩm chăm sóc sức khỏe giúp khắc phục tình trạng đau mỏi lưng, vai gáy ở mọi lứa tuổi. Bear giới thiệu đến bạn phiên bản máy đấm lưng thế hệ mới được sản xuất theo công nghệ Nhật Bản với thiết kế đai đeo tiện lợi, liệu phám đấm với 16 cường độ lực khác nhau tương tự tay người mang đến cảm giác thoải mái nhất khi đeo.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/46/1a/c6/4874945dab309ef0c9176e5398775d5c.jpg?v=1628350335962\" alt=\"4874945dab309ef0c9176e5398775d5c.jpg?v=1628350335962\" /\u003e\u003c/p\u003e\n\u003cp\u003eHướng đến sự tiện ích, máy đấm lưng Bear AMQ-A01X1 (MA-B01V1) có thiết kế cân bằng trước và sau thông minh, phù hợp với mọi vóc dáng. Ưu điểm của thiết kế cân bằng đó là người dùng không cần giữ cố định sản phẩm, trong lúc máy hoạt động vẫn có thể rảnh tay hoạt động và làm việc thoải mái.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/e5/68/f0/ba8428d97c11acf03f3eb17bc0130318.jpg?v=1628350339816\" width=\"750\" height=\"503\" alt=\"ba8428d97c11acf03f3eb17bc0130318.jpg?v=1628350339816\" /\u003e\u003c/p\u003e\n\u003cp\u003eChương trình đấm lưng được lập trình sẵn sẽ tự động ngắt sau 15 phút đấm lứng, massage. Chỉ với 15 phút mỗi ngày sử dụng đai đấm lưng Bear thông minh để tạm biệt tình trạng đau mỏi lưng, vai gáy, do ngồi lâu hay ít vận động nhé. \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/1c/14/99/3cb61131d19b485583bd141b02b02ed7.jpg?v=1628350336656\" width=\"750\" height=\"503\" alt=\"3cb61131d19b485583bd141b02b02ed7.jpg?v=1628350336656\" /\u003e\u003c/p\u003e\n\u003cp\u003eMặt ngoài của đai đấm lưng Bear được bọc vải Linen tự nhiên cho khả năng thấm hút mồ hôi và tản nhiệt tốt hơn các loại vải khác 1,5 lần. Đặc phiệt phần đệm chỗ tay đấm của máy được bọc vải dạng lưới giúp giảm nóng bức và tản nhiệt tốt trong quá trình đấm.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/52/86/ca/e9ec4f2fbec73f2fb311c5e000781128.jpg?v=1628350337158\" width=\"750\" height=\"503\" alt=\"e9ec4f2fbec73f2fb311c5e000781128.jpg?v=1628350337158\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eMô phỏng kỹ thuật đấm lưng như tay người\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eMáy đấm lưng Bear được thiết kế dựa trên sinh lý cơ thể người kết hợp với công việc và thói quen trong cuộc sống hiện đại. Sản phẩm có tác dụng làm giảm đau mỏi vùng vai cổ và lưng, thúc đẩy quá trình tuần hoàn máu. Đặc biệt bạn có thể thay đổi 16 tốc độ đấm bóp nhanh, chậm khác nhau cùng 4 chế độ: Đấm nhanh, đấm 1 tray, đấm 2 tay, đấm chậm phù hợp với từng sở thích và vùng cơ thể khác nhau.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/a3/5f/67/19a639263d6bbd6ae0eb50df8fd9d11f.jpg?v=1628350338401\" width=\"750\" height=\"503\" alt=\"19a639263d6bbd6ae0eb50df8fd9d11f.jpg?v=1628350338401\" /\u003e\u003c/p\u003e\n\u003cp\u003eCấu tạo động cơ máy đấm lưng Bear có 2 đầu tác động lực với công suất mạnh mẽ giúp tác động xoa bóp sâu, đồng thời thiết kế tích hợp 4 chế độ xoa bóp khác nhau đem lại cho bạn cảm giác thư thái dễ chịu nhất.\u003c/p\u003e\n\u003cp\u003e \u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/18/d7/9e/d6b02f99287377965c44702e952c97fe.jpg?v=1628350339117\" width=\"750\" height=\"503\" alt=\"d6b02f99287377965c44702e952c97fe.jpg?v=1628350339117\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTác động đến nhiều vùng trên cơ thể\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eĐặc biệt, chiếc máy đấm lưng này còn sở hữu thiết kế linh hoạt, kết hợp với phương thức Massage 5 trong 1, giúp bạn tác động vào nhiều phần khác nhau của cơ thể như: lưng, vai, cổ, mông và đùi.\u003c/p\u003e\n\u003cp\u003e-\u003cstrong\u003e Massage Vai, Cổ :\u003c/strong\u003e Khu vực được sử dụng nhiều nhất, mang lại cảm giác đấm bóp sâu, cải thiện tình trạng đau mỏi vai gáy hiệu quả.\u003cbr /\u003e- \u003cstrong\u003eMassage Eo, Mông :\u003c/strong\u003e Ngồi lâu thường hay mỏi hông - eo, bị căng cứng máy giúp thư giãn và làm mềm cơ, giảm căng thẳng và áp lực chi cột sống/\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e- Massage Chân, Đùi :\u003c/strong\u003e Mang lại cảm giác sảng khoái và thư giãn cơ khi bị mỏi chân vì phải đi lại liên tục.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/41/96/0f/e6bab94ecd47df63550afae33fd9c472.jpg?v=1628350343273\" width=\"750\" height=\"503\" alt=\"e6bab94ecd47df63550afae33fd9c472.jpg?v=1628350343273\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTích hợp nhiệt PTC giúp tăng lưu thông máu\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eKhông chỉ giúp thư giãn sâu, giảm đau mỏi cho cơ thể đai đấm lưng Bear còn được tích hợp nhiệt với công nghệ PTC, làm ấm nóng cơ thể khi đấm lưng giúp thúc đẩy và tăng cường tuần hoàn máu tốt hơn. Người dùng hoàn toàn có thể chọn chế độ có nhiệt hoặc không nhiệt trong quá trình sử dụng bằng nút bấm \"M\" trên bảng điều khiển vô cùng tiện lợi.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e        \u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/a0/0d/49/04b2b6152317a9a8b86f5b38be53bc1e.jpg?v=1628350340535\" width=\"750\" height=\"503\" alt=\"04b2b6152317a9a8b86f5b38be53bc1e.jpg?v=1628350340535\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/d9/b0/59/2c1d618d94ea80997f31af199998a229.jpg?v=1628350341466\" width=\"750\" height=\"503\" alt=\"2c1d618d94ea80997f31af199998a229.jpg?v=1628350341466\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTích hợp bảng điều khiển thông minh\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eTrên phần đai của máy đấm lưng thông minh Bear còn được tích hợp bảng điều khiển nút bấm kèm màn Led hiển thị chế độ đấm, người dùng dế dàng theo dõi và điều chỉnh phù hợp với cơ thể. Hướng dẫn sử dụng máy đấm lưng bear:\u003c/p\u003e\n\u003cp\u003eBước 1: Kết nối nguồn điện và bấm nút nguồn để khởi động máy\u003c/p\u003e\n\u003cp\u003eBước 2: Bấm nút \"M\" để chọn chế độ đấm lưng: Có nhiệt, không nhiệt, đấm nhanh, đấm chậm, đấm 1 tay\u003c/p\u003e\n\u003cp\u003eBước 2:  Trong quá trình sử dụng bấm nút \"+/-\" để điều chỉnh lực đấm từ 1 - 16 mức khác nhau phù hợp với cơ thể.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/df/0a/49/d684a48fb358c657fb2c9600e7311006.jpg?v=1628350342722\" alt=\"d684a48fb358c657fb2c9600e7311006.jpg?v=1628350342722\" /\u003e\u003c/p\u003e\n\u003cp\u003eMáy đã được cài đặt sẵn chương trình hẹn giờ ngắt tự động sau 15 phút hoạt động liên tục. Để tiếp tục sử dụng saqu 15 phút bạn có thể ấn nút chọn chế độ để máy khởi động một chu trình massage mới. Lưu ý để đảm bảo độ bền cho sản phẩm sau 15 - 30 ohust phút dùng liên tục bạn nên để máy nghỉ khoảng 5-10 phút làm mát lại động cơ rồi mới tiếp tục sử dụng máy nhé.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/66/a3/71/24dc36a62b18f8015d9ea13eeb30c5ff.jpg?v=1628350342195\" alt=\"24dc36a62b18f8015d9ea13eeb30c5ff.jpg?v=1628350342195\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003ePhù hợp với nhiều người dùng khác nhau\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eSở hữu thiết kế thông minh, tác dụng thư giãn hoàn hảo máy đấm lưng Bear là sản phẩm thích hợp cho nhiều người dùng khác nhau. Nhân viên văn phòng, học sinh, phải ngồi lâu khi sử dụng máy sẽ làm giảm mệt mỏi, công việc trở nên nhẹ nhàng, làm việc và học tập hiệu quả hơn. Người cao tuổi: Máy Massage giúp tận hưởng cảm giác thư giãn tuyệt vời, giảm đau mỏi vai gáy và đau nhức cơ vô cùng tốt.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/27/5a/9b/c0d21458a73387db2bb1fa4e39036348.jpg?v=1628350337865\" alt=\"c0d21458a73387db2bb1fa4e39036348.jpg?v=1628350337865\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/5a/2f/2b/d0107c18284c3501d4632ff48e179f4e.jpg?v=1628350344024\" alt=\"d0107c18284c3501d4632ff48e179f4e.jpg?v=1628350344024\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/30/c5/c1/4ed3597c19ddb85e0a9833d3425d1179.jpg?v=1628350344736\" width=\"750\" height=\"503\" alt=\"4ed3597c19ddb85e0a9833d3425d1179.jpg?v=1628350344736\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/fa/f3/16/acde4dec7d6f7dab7706b3dd4ad451bf.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/fa/f3/16/acde4dec7d6f7dab7706b3dd4ad451bf.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/fa/f3/16/acde4dec7d6f7dab7706b3dd4ad451bf.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fa/f3/16/acde4dec7d6f7dab7706b3dd4ad451bf.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fa/f3/16/acde4dec7d6f7dab7706b3dd4ad451bf.png"},{"base_url":"https://salt.tikicdn.com/ts/product/67/81/1d/0dd8a3234a12997082aa897cb9fd62ba.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/67/81/1d/0dd8a3234a12997082aa897cb9fd62ba.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/67/81/1d/0dd8a3234a12997082aa897cb9fd62ba.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/67/81/1d/0dd8a3234a12997082aa897cb9fd62ba.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/67/81/1d/0dd8a3234a12997082aa897cb9fd62ba.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/46/1a/c6/9257883ff7c7ac1d63ef5a41bc76ba45.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/46/1a/c6/9257883ff7c7ac1d63ef5a41bc76ba45.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/46/1a/c6/9257883ff7c7ac1d63ef5a41bc76ba45.jpg","position":null,"small_url":"h