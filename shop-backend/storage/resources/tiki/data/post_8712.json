ext":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/30/69/1a/4e7cb3b523352e5101d54c38d82ec842.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2414,"all_time_quantity_sold":13,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\n    \u003cstrong\u003e\n        Đời Nghệ Sĩ\n    \u003c/strong\u003e\n\u003c/p\u003e\n\u003cp\u003e\n    Về bản dịch này, chúng tôi xin có đôi lời với bạn đọc: vì cốt để bạn đọc hứng thú theo dõi kiệt tác này, nên chúng tôi đã\n    lược bỏ 2 chương đầu và một phần chương thứ ba, tất cả gồm 11 trang sách chính. Chúng tôi cứ phân vân không biết nên bỏ hay\n    không, thì tình cờ một hôm chúng gặp được bản dịch Pháp ngữ cũng bỏ như vậy và bỏ cả ba chương chứ không lấy phần đầu chương\n    thứ ba như của chúng tôi cho có vẻ nhập đề.\n\u003c/p\u003e\n\u003cp\u003e\n    Từ chương thứ tư trở đi chúng tôi dịch theo nguyên tác không bỏ sót một chữ nào. Thiết tưởng việc bỏ ba chương trong nguyên\n    tác không làm hại mà còn lợi cho bạn đọc rất nhiều; bởi chính chúng tôi đã \"bỏ cuộc\" mấy lần khi đọc mấy chương có vẻ lạc\n    đề ấy.\n\u003c/p\u003e\n\u003cp\u003e\n    Về phần văn hào Maugham, thiết tưởng bạn đọc đã biết nhiều nên chúng tôi thấy không cần phải giới thiệu gì nữa; và tác phẩm\n    này cũng là một trong những kiệt tác của Maugham mà bạn đọc hẳn đã biết rất tường tận. Như nhan đề chúng tôi đặt cho dịch\n    phẩm: ĐỜI NGHỆ SĨ, nhân vật chính trong tác phẩm này, Charles Strickland, chính là hình ảnh tiểu thuyết hóa cuộc đời của\n    một họa sĩ thiên tài lẫy lừng mà ai cũng biết: Paul Gauguin. Ngoài ra; những chữ Pháp có trong bản dịch này là những chữ\n    Pháp cũng có trong nguyên tác.\n\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/30/69/1a/4e7cb3b523352e5101d54c38d82ec842.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/30/69/1a/4e7cb3b523352e5101d54c38d82ec842.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/30/69/1a/4e7cb3b523352e5101d54c38d82ec842.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/30/69/1a/4e7cb3b523352e5101d54c38d82ec842.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/30/69/1a/4e7cb3b523352e5101d54c38d82ec842.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/c6/71/85/4c93c02c586a8865a4145b80c4ec9bb0.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c6/71/85/4c93c02c586a8865a4145b80c4ec9bb0.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c6/71/85/4c93c02c586a8865a4145b80c4ec9bb0.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c6/71/85/4c93c02c586a8865a4145b80c4ec9bb0.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c6/71/85/4c93c02c586a8865a4145b80c4ec9bb0.jpg"}],"warranty_policy":null,"authors":[{"id":7381,"name":"W. Somerset Maugham","slug":"w-somerset-maugham"}],"current_seller":{"id":192558,"sku":"5362461322061","name":"Thư Quán Hạnh Phúc","link":"https://tiki.vn/cua-hang/thu-quan-hanh-phuc","logo":"bc/c1/7f/6b18d0f7b15ea40ed4151b085401c0c6.jpg","price"