"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.8,"review_count":23,"review_text":"(23)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/10/cd/63/495f1ea88734b6ffd1e4ece9c4d376ab.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1133,"all_time_quantity_sold":130,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: center;\"\u003e\u003cstrong\u003e\u003cem\u003eQuạt hút gió tản nhiệt laptop máy tính đế tản nhiệt tương thích với mọi loại laptop tặng kèm móc khóa 5TECH\u003c/em\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003e\u003cstrong\u003eTặng kèm 1 móc khóa 5 Tech khi mua kèm sản phẩm!\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eNếu như bạn vẫn đang sử dụng các tấm làm mát phía dưới cho laptop và cảm giác rằng laptop mình vẫn bị nóng thì bên nên suy nghĩ lại về tính hiệu quả của những sản phẩm này. CoolCold Ice troll thật sự đã tạo ra một cuộc cách mạng khi đã làm thay đổi hoàn toàn những suy nghĩ, trải nghiệm trước đây của bạn về vấn đề này. Được thiết kế với một quạt hút đặc biệt để hút trực tiếp đi nhiệt laptop, CoolCold Ice Magic III đã giải quyết vấn đề hiệu năng thấp của các laptop khi bị nóng nhưng không làm ảnh hưởng đến các thiết bị tản nhiệt khác. Bằng cách kết nối trực tiếp với cổng thoát khí để hút khí nóng được tạo ra do CPU chạy để tối ưu hóa hiệu quả, đây thực sự là một giải pháp tốt hơn rất nhiều so với tấm làm mát truyền thống mà chỉ chuyển hướng nhiệt độ bề mặt xung quanh.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/10/cd/63/31c2f195f790652e6f8798ef892c310a.jpg\" alt=\"\" width=\"720\" height=\"720\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cstrong\u003eTản nhiệt laptop\u003c/strong\u003e\u003c/em\u003e này đã được giới thiệu vào năm 2014. Sản phẩm này được thiết kế riêng cho các game thủ. Ice Devil 3 sử dụng động cơ tốc độ cao, thiết bị chống trượt cường độ cao, ngoại hình giống như trò chơi và phiên bản tàu ngầm của thiết bị niêm phong. Kết hợp với nhiều bộ hướng dẫn gió, thiết kế thân mật, Ice Devil 3 cho phép bạn tự do chơi trong thế giới trò chơi.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/06/f8/f7/4ffee8dc8d153b87c8c64d87b33045b3.jpg\" alt=\"\" width=\"721\" height=\"751\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003eTính năng 1:\u003c/em\u003e Chế độ thủ công: Theo chế độ thủ công, bạn có thể điều chỉnh núm điều chỉnh theo cách thủ công để điều khiển tốc độ quạt. Điều khiển tốc độ vô cấp không thể so sánh với một số tốc độ.\u003c/p\u003e\n\u003cp\u003e\u003cem\u003eTính năng 2:\u003c/em\u003e Động cơ tăng tốc: Quạt làm mát công suất cao hai quả bóng có thể hoạt động hiệu quả trong một thời gian dài mà không ảnh hưởng đến tuổi thọ của quạt turbo do bụi đến 20-30 độ.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/c5/99/23/5dc4f69fedad2638099a16cbc40163ac.jpg\" alt=\"\" width=\"720\" height=\"720\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003eTính năng 3:\u003c/em\u003e Chống trượt thiết bị: siêu chống trượt hệ số, hai mặt không trượt hiệu lực, rắn, đơn giản.\u003c/p\u003e\n\u003cp\u003e\u003cem\u003eTính năng 4:\u003c/em\u003e Sự xuất hiện của tính mới: việc sử dụng các yếu tố khắc trò chơi khác nhau. Với ý tưởng thú vị, được thiết kế riêng, bay theo yêu cầu riêng.\u003c/p\u003e\n\u003cp\u003e\u003cem\u003eTính năng 5:\u003c/em\u003e Nhân bản thiết kế sản phẩm: Mỗi bộ tản nhiệt được trang bị bốn hướng dẫn gió để xử lý mọi ổ cắm máy tính xách tay. Một số tay lái không khí có thể tương thích với máy tính xách tay với các giao diện tản nhiệt khác nhau trên thị trường Người tiêu dùng không cần phải không tương thích với bộ tản nhiệt và không có hỗ trợ.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/99/01/8d/96a13805bc1378a97dd9f9e286f5acd4.jpg\" alt=\"\" width=\"720\" height=\"720\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003eTính năng 6:\u003c/em\u003e Thiết bị niêm phong phiên bản tàu ngầm: sản xuất Seiko, bảo vệ môi trường carbon thấp, vật liệu mật độ cao, công nghệ chất lượng cao.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/3d/19/42/1b4d559e8c1cf97f8ba7c95d896bdc09.jpg\" alt=\"\" width=\"720\" height=\"720\" /\u003e\u003c/p\u003e\n\u003ch4\u003eThông số kỹ thuật: \u003cem\u003e\u003cstrong\u003eTản nhiệt máy tính xách tay\u003c/strong\u003e\u003c/em\u003e\u003c/h4\u003e\n\u003cul\u003e\n\u003cli\u003eKích thước sản phẩm: 175x86x52mm\u003c/li\u003e\n\u003cli\u003eKích thước quạt: 75x75x25mm\u003c/li\u003e\n\u003cli\u003eTrọng lượng sản phẩm: 230g\u003c/li\u003e\n\u003cli\u003eTốc độ quạt: 1500-3000 ± 10% RPM\u003c/li\u003e\n\u003cli\u003eThể tích không khí tối đa: 75,35CFM\u003c/li\u003e\n\u003cli\u003eĐiện áp định mức: 5V\u003c/li\u003e\n\u003cli\u003ePhiên bản mạng định mức: 0,35 ± 10% A\u003c/li\u003e\n\u003cli\u003eCông suất đầu vào: 1,75V\u003c/li\u003e\n\u003cli\u003eChất liệu: Nhựa\u003c/li\u003e\n\u003cli\u003eBộ sản phẩm bao gồm: Bộ tản nhiệt + cáp USB + ống dẫn hướng không khí + Thảm trượt\u003c/li\u003e\n\u003cli\u003e1 móc khóa 5 Tech\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/10/cd/63/495f1ea88734b6ffd1e4ece9c4d376ab.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/10/cd/63/495f1ea88734b6ffd1e4ece9c4d376ab.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/10/cd/63/495f1ea88734b6ffd1e4ece9c4d376ab.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/10/cd/63/495f1ea88734b6ffd1e4ece9c4d376ab.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/10/cd/63/495f1ea88734b6ffd1e4ece9c4d376ab.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/06/f8/f7/c784a0871139732cb038561a34e5c270.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/06/f8/f7/c784a0871139732cb038561a34e5c270.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/06/f8/f7/c784a0871139732cb038561a34e5c270.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/06/f8/f7/c784a0871139732cb038561a34e5c270.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/06/f8/f7/c784a0871139732cb038561a34e5c270.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/26/c9/82/cc9f90b71b4f3e4aa268d8ed5c6d4efb.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/26/c9/82/cc9f90b71b4f3e4aa268d8ed5c6d4efb.jpg","medium_url":"https://salt