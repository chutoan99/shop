l,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":294000,"discount_rate":52,"rating_average":4.5,"review_count":288,"review_text":"(288)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/30/c6/85/eff7a254f90235748ae931471710b112.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":819,"all_time_quantity_sold":1073,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/1a/d3/33/64f513098116b8acb4cb629407b5222b.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch2\u003eĐỆM NGỒI CHỐNG ĐAU XƯƠNG CỤT EMA \u003cspan style=\"color:#ff9900\"\u003eCHỐNG ĐAU XƯƠNG CỤT, Ê MÔNG, THÂM MÔNG, XỆ MÔNG\u003c/span\u003e NHƯ THẾ NÀO?\u003c/h2\u003e\n\u003cp\u003eXương cụt là xương đáy tận cùng của hệ thống xương sống, đây là phần phải chịu toàn bộ áp lực của cơ thể khi ngồi. Việc ngồi quá lâu, trong một thời gian dài và trên một mặt phẳng cứng có thể \u003cstrong\u003egây nhiều áp lực lên xương cụt, dẫn đến đau mỏi xương cụt và các cơ, dây chằng xung quanh xương cụt\u003c/strong\u003e.\u003c/p\u003e\n\u003cp\u003eNhững người đang bị bệnh đau xương cụt sẽ thấy tình trạng đau tăng lên nhiều khi ngồi. \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/01/de/11/c0fc314c69b9f255c271c406a5c841c1.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/3c/42/52/9afd5022bae12b2e19b20757dfa7c886.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eKhi được ngồi ở đệm xương cụt công thái học, \u003cstrong\u003ephần xương cụt hầu như không còn phải chịu bất cứ một áp lực nào\u003c/strong\u003e, thậm chí kể cả khi ngả ra đằng sau\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/a6/b6/10/4c97bb7f3ead7b562db963303737fea0.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center\"\u003e\u003cem\u003eẢnh minh họa:\u003c/em\u003e Phần xương cụt được \u0026#34;giải phóng\u0026#34; khi ngồi trên đệm ngồi Ema chuyên dụng\u003c/p\u003e\n\u003cp\u003eKhi ngồi, phần chịu áp lực nhiều nhất là xương, cơ quanh ụ ngồi – phần nhô cao nhất của mông. Vì vùng xương ụ ngồi và các cơ xung quanh nó chịu nhiều áp lực nhất trong khi ngồi. Cho nên khi ngồi càng lâu, nhất là trên bề mặt cứng thì vùng này \u003cstrong\u003edễ thấy bị ê và thâm nhất\u003c/strong\u003e.\u003c/p\u003e\n\u003cp\u003eKhông chỉ như vậy, \u003cstrong\u003etheo nhiều chuyên gia về thẩm mỹ, ngồi lâu cũng khiến vòng 3 bị phẳng đi, chảy xệ, không còn giữ được độ cong\u003c/strong\u003e. \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/ea/c8/04/b919dc8c1e933d6ff9d29d7043a13e04.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center\"\u003e\u003cem\u003eẢnh minh họa:\u003c/em\u003e Đệm ngồi Ema giúp áp lực dàn đều, không tập trung vào ụ mông từ đó giảm ê, thâm và tăng cường lưu thông máu\u003c/p\u003e\n\u003cp\u003eĐệm xương cụt công thái học với thiết kế công thái học ôm theo đường cong của 2 bên mông và sử dụng chất liệu memory foam giúp giảm áp lực lên 2 vùng ụ ngồi.\u003c/p\u003e\n\u003ch2\u003e\u003cspan style=\"color:#ff9900\"\u003eĐỐI TƯỢNG SỬ DỤNG\u003c/span\u003e ĐỆM NGỒI CHỐNG ĐAU XƯƠNG CỤT EMA\u003c/h2\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/89/54/ac/83d8d5efa26c5514203640586a55d976.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eNhững người phải ngồi lâu, nhất là khi ngồi ghế cứng có thể dẫn đến vấn đề đau xương cụt, ê mông, thâm mông, xệ mông.\u003c/li\u003e\u003cli\u003eNhững người đang bị bệnh đau xương cụt như chấn thương, thoái hóa, phụ nữ mang thai.\u003c/li\u003e\u003cli\u003eNhững người đang ngồi làm việc trên một chiếc ghế dốc về đằng sau, ví dụ như ghế lái xe. Vì ghế ngả ra sau sẽ làm tăng áp lực ở vùng xương cụt khiến xương cụt dễ bị đau mỏi hơn khi ngồi lâu.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/b9/c6/98/b8a04f011226c80e6e626d855c4ce4c8.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch2\u003e\u003cspan style=\"color:#ff9900\"\u003eTHÔNG SỐ KỸ THUẬT\u003c/span\u003e ĐỆM NGỒI CHỐNG ĐAU XƯƠNG CỤT EMA\u003c/h2\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/6a/21/f9/4e2e3656b2f395470704b57577d49b8c.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/a3/68/85/703c2df0f3dd744cd95c033d9351774a.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eKhối lượng:\u003c/strong\u003e 1 kg\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eKích thước:\u003c/strong\u003e 45x35x7cm\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/60/99/29/2457e21c3bc0e11ad579c60238fa9a39.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eChất liệu:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eRuột gối được làm từ memory foam giúp giảm tốt nhất áp lực lên vùng mông. Tạo cảm giác thoải mái cho người ngồi, nhất là những người phải ngồi làm việc lâu trong nhiều giờ.\u003c/li\u003e\u003cli\u003eRuột gối được thiết kế thêm 1 lớp gel trên bề mặt tạo sự cảm giác thoáng mát khi sử dụng. Lướp gel này giúp giảm khoảng 3 độ so với nhiệt độ trên các loại đệm thông thường.\u003c/li\u003e\u003cli\u003eVỏ gối được làm từ từ vải lưới 3D giúp lưu thông không khí tốt hơn.\u003c/li\u003e\u003cli\u003eThêm vào đó, ruột gối và vỏ gối có thiết kế khóa kéo nên có thể dễ dàng vệ sinh vỏ gối.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/d8/49/ff/5edec025da4252afd06e0fb74bd4d698.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/db/09/29/d5f5d8648ad82addddbdd1621f304931.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/72/7a/0c/1cabf5a19bb683c9edc9f73a9521ba44.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eMàu sắc:\u003c/strong\u003e\u003c/p\u003e\n\u003ch2\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/40/0a/79/56eb3c7a8efd8e5d9a75172a892d8af7.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/h2\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/38/bd/42/b47c8b671b3e9d8364d982d19832a19b.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/39/48/ea/076e79ac49bb71c