89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":7000,"discount_rate":5,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/5e/b4/93/5147bba91af392231ac1776052e06d66.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1337,"all_time_quantity_sold":8,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eĐông Y Thanh Mộc Hương\u003c/strong\u003e đưa ra sản phẩm \u003cstrong\u003eDầu Gội Thảo Dược Thanh Mộc Hương không chứa silicon\u003c/strong\u003e năm 2021 giúp cho tóc mềm mượt hơn, giảm sơ rối, giữ ẩm tóc, chăm sóc ra đầu, sắp tới sẽ dừng cung cấp mẫu sản phẩm cũ, khách hàng đón nhận và phản hồi tích cực. Dầu gội Thanh Mộc Hương được chiết xuất từ những nguyên liệu thiên nhiên không những \u003cem\u003elàm sạch tóc, da đầu mà còn nuôi dưỡng mái tóc từ bên trong giúp da dầu khô thoáng sạch sẽ, giúp mái tóc của bạn trở nên đen nhánh, suôn mềm\u003c/em\u003e. \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/e2/57/c9/755fa7abd009d10887243467c43ea196.jpg\" alt=\"\" width=\"600\" height=\"600\" /\u003e\u003c/p\u003e\n\u003ch2 style=\"text-align: center;\"\u003eDầu gội Thanh Mộc Hương mẫu mới nhất năm 2021\u003c/h2\u003e\n\u003cp\u003e\u003cstrong\u003e► Dầu Gội Thanh Mộc Hương một sản phẩm nhiều tác dụng\u003c/strong\u003e\u003cbr /\u003e+ Giúp làm sạch da đầu, tóc và làm sạch gàu\u003cbr /\u003e+ Làm giảm và ngăn ngừa ngứa, xơ rối, chẻ ngọn, gẫy rụng tóc\u003cbr /\u003e+ Giúp làm thoáng lỗ chân lông, suôn, bóng mượt\u003cbr /\u003e+ Kích thích nang tóc phát triển, giúp tóc mọc nhanh\u003cbr /\u003e+ Hỗ trợ điểu trị nấm da đầu hiệu quả\u003cbr /\u003e \u003cbr /\u003e► Thành phần từ thiên nhiên không gây kích ứng da, an toàn cho sức khỏe, sử dụng đươc với mọi lứa tuổi đặc biệt những người có da đầu nhạy cảm, tóc yếu, rụng tóc, nhiều gàu, nấm đầu\u003cbr /\u003e \u003cbr /\u003e► Hộp được bọc túi bóng có tem dán niêm phong bên trong có 1 chai dung tính là 350 ml hàng chính hãng có hóa đơn giá trị gia tăng\u003cbr /\u003e \u003cbr /\u003e► \u003cstrong\u003eLô sản xuất mới nhất, thành phần tốt hơn\u003c/strong\u003e gội đầu bạn sẽ cảm thấy tóc mềm mượt hơn loại cũ, được dán tem chống hàng giả trên mỗi chai\u003cbr /\u003e \u003cbr /\u003e► Do thành phần của dầu gội là nước cốt chiết suất từ nhiều loại thảo mộc nên để một thời gian sẽ bị ngưng tụ không đều nên trước khi sử dụng ta phải lắc đều\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch2\u003eHướng dẫn sử dụng dầu gội thảo dược Thanh Mộc Hương\u003c/h2\u003e\n\u003cp\u003e\u003cimg class=\"size-full wp-image-3758 aligncenter lazy-load-active\" style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/product/8f/2c/a8/45e92290a73909c2f262e78828bc2a03.gif\" alt=\"gội đầu bằng cách dùng dầu gội thanh mộc hương\" width=\"529\" height=\"454\" data-src=\"https://salt.tikicdn.com/ts/product/8f/2c/a8/45e92290a73909c2f262e78828bc2a03.gif\" /\u003e\u003c/p\u003e\n\u003col\u003e\n\u003cli\u003eLàm ướt tóc gội sơ da dầu với nước sạch\u003c/li\u003e\n\u003cli\u003eSử dụng khoảng 2 – 2,5 ml dầu gội đổ vào lòng bàn tay xoa 2 bàn tay vào nhau để dầu gội trải đều và tạo bọt và xoa đều lên đầu.\u003c/li\u003e\n\u003cli\u003eGãi nhẹ từ chân tới đuôi tóc, dùng ngón tay massage da đầu nhẹ nhàng theo chuyển động tròn trong 2 – 5 phút, sau 20 giây, thêm chút nước lên đầu và tiếp tục xoa bóp nhẹ nhàng.\u003c/li\u003e\n\u003cli\u003eDội nước làm sạch mái tóc, vừa dội vừa xoa, gãi nhẹ mái tóc để sạch những bụi bẩn còn sót lại.\u003c/li\u003e\n\u003cli\u003eDùng khăn bông sạch lau toàn bộ mái tóc và để chúng khô tự nhiên. Nếu dùng máy sấy, bạn nên chờ 15-20 phút sau gội đầu.\u003c/li\u003e\n\u003cli\u003eCó thể gội thêm một lần nữa để tăng hiệu quả dầu gội.\u003c/li\u003e\n\u003c/ol\u003e\n\u003cp\u003e\u003cstrong\u003eLưu ý\u003c/strong\u003e: Nên sử dụng nước lạnh vì nó tăng cường lưu thông máu, giúp tóc chắc khỏe, nước ấm khiến chân tóc giãn nở và dễ bị rụng hơn. Dầu gội sử dụng cho mọi lứa tuổi, cả nam và nữ, khi dùng tránh để dầu gội dính vào mắt.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/5e/b4/93/5147bba91af392231ac1776052e06d66.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/5e/b4/93/5147bba91af392231ac1776052e06d66.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/5e/b4/93/5147bba91af392231ac1776052e06d66.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5e/b4/93/5147bba91af392231ac1776052e06d66.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5e/b4/93/5147bba91af392231ac1776052e06d66.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/1f/c5/f7/a916507d758b67aed506b9d8e4a270b4.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/1f/c5/f7/a916507d758b67aed506b9d8e4a270b4.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/1f/c5/f7/a916507d758b67aed506b9d8e4a270b4.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/