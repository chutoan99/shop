ount":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/86/0d/16/c0d026bf314d171bfb4d9dc470d339e5.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1856,"all_time_quantity_sold":18,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p style=\"box-sizing: border-box; word-break: break-word; margin: 0px 0px 10px; color: #333333; font-family: Roboto, sans-serif; font-size: 13px;\"><iframe style=\"box-sizing: border-box; word-break: break-word;\" src=\"https://www.youtube.com/embed/Qj3cZLdvzFg\" width=\"560\" height=\"315\" frameborder=\"0\" allowfullscreen=\"allowfullscreen\"></iframe></p>\n<h1 style=\"box-sizing: border-box; word-break: break-word; margin: 20px 0px 10px; font-size: 36px; font-family: Roboto, sans-serif; font-weight: 500; line-height: 1.1; color: #333333;\" data-field=\"title\"><span style=\"box-sizing: border-box; word-break: break-word; font-size: 14px;\">Dragon Ball FighterZ - Game đối kháng hot nhất năm 2018 </span></h1>\n<p style=\"box-sizing: border-box; word-break: break-word; margin: 0px 0px 10px; color: #333333; font-family: Roboto, sans-serif; font-size: 13px;\">Trên thực tế, Dragon Ball FigherZ cũng chính là tựa game mới nhất được Bandai Namco ra mắt dựa trên bộ Manga nổi tiếng 7 Viên Ngọc Rồng của tác giả Akira Toriyama.</p>\n<p style=\"box-sizing: border-box; word-break: break-word; margin: 0px 0px 10px; color: #333333; font-family: Roboto, sans-serif; font-size: 13px;\">Ngay từ khi công bố, Dragon Ball Fighter Z đã nhận được sự quan tâm của không ít fan hâm mộ khi quay trở lại phong cách màn hình ngang của thể loại game đối kháng truyền thống, thế nhưng gameplay của trò chơi lại thật sự gây ấn tượng khi mang đậm chất hành động và những nét tinh túy nhất của dòng game Dragon Ball từ trước tới nay.</p>\n<p style=\"box-sizing: border-box; word-break: break-word; margin: 0px 0px 10px; color: #333333; font-family: Roboto, sans-serif; font-size: 13px;\"><img style=\"box-sizing: border-box; word-break: break-word; border: 0px; vertical-align: middle; max-width: 100%; height: auto !important;\" src=\"https://salt.tikicdn.com/ts/product/dd/9f/06/ed8f2f2a80f678d6b61b85c9dbfc3c4d.jpg?v=1517030233582\" data-thumb=\"original\" /></p>\n<p style=\"box-sizing: border-box; word-break: break-word; margin: 0px 0px 10px; color: #333333; font-family: Roboto, sans-serif; font-size: 13px;\">Thật vậy, xuyên suốt đoạn gameplay mới, chúng ta có thể thấy được chất hành động cực hấp dẫn trong Dragon Ball Fighter Z. Các nhân vật đều có thể tung ra những đòn combo \"chết người\", dồn dập một cách liên tục khiến đối thủ không thể phản kháng.</p>\n<p style=\"box-sizing: border-box; word-break: break-word; margin: 0px 0px 10px; color: #333333; font-family: Roboto, sans-serif; font-size: 13px;\"><img style=\"box-sizing: border-box; word-break: break-word; border: 0px; vertical-align: middle; max-width: 100%; height: auto !important;\" src=\"https://salt.tikicdn.com/ts/product/73/30/12/550336cb1b5bac93dc14faa5d4476b30.jpg?v=1517030331566\" data-thumb=\"original\" /></p>\n<p style=\"box-sizing: border-box; word-break: break-word; margin: 0px 0px 10px; color: #333333; font-family: Roboto, sans-serif; font-size: 13px;\">Một điểm đặc biệt hơn trong Dragon Ball Fighter Z chính là tập trung phát triển điểm mạnh, điểm yếu riêng của từng nhân vật, như Majin Buu (Ma Bư) có khả năng tự hồi máu cực khủng khiếp trong trận đấu. Đây cũng là đặc điểm riêng của nhân vật này trong truyện tranh, khi Majin Buu có khả năng tự phục hồi khủng khiếp đến độ \"hư cấu\".</p>\n<p style=\"box-sizing: border-box; word-break: break-word; margin: 0px 0px 10px; color: #333333; font-family: Roboto, sans-serif; font-size: 13px;\">Majin Buu có khả năng hồi máu cực mạnh trong trận đấu</p>\n<p style=\"box-sizing: border-box; word-break: break-word; margin: 0px 0px 10px; color: #333333; font-family: Roboto, sans-serif; font-size: 13px;\">Dragon Ball Fighter Z giới thiệu đến cơ chế chiến đấu 3vs3. Trong trận đấu, game thủ có thể được lựa chọn 3 nhân vật mang theo. 3 nhân vật này có thể thoải mái thay đổi cho nhau trong trận đấu, tuy nhiên sau mỗi lần thay đổi thì có vẻ như sẽ có một khoảng thời gian chờ nhất định.</p>\n<p style=\"box-sizing: border-box; word-break: break-word; margin: 0px 0px 10px; color: #333333; font-family: Roboto, sans-serif; font-size: 13px;\">Để giành chiến thắng chung cuộc, người chơi sẽ phải hạ gục toàn bộ 3 nhân vật của đối phương. Khi một nhân vật ngã xuống, nhân vật kế tiếp sẽ lập tức thế chỗ và tham gia ngay vào trong trận đấu. Giống như mọi khi, hệ thống thể lực được áp dụng để người chơi có thể tung ra các đòn thế đặc biệt (chưởng) của từng nhân vật.</p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/86/0d/16/c0d026bf314d171bfb4d9dc470d339e5.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/86/0d/16/c0d026bf314d171bfb4d9dc470d339e5.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/86/0d/16/c0d026bf314d171bfb4d9dc470d339e5.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/86/0d/16/c0d026bf314d171bfb4d9dc470d339e5.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/86/0d/16/c0d026bf314d171bfb4d9dc470d339e5.jpg"}],"warranty_policy":null,"brand":{"id":18641,"name":"Sony","slug":"sony"},"current_seller":{"id":2304,"sku":"2951988337528","name":"Bách Tùng Ps"