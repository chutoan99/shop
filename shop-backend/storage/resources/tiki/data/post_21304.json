load/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4,"review_count":7,"review_text":"(7)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/b4/74/8e/c8568fd4718e4ce1b642c2559b4a086f.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1113,"all_time_quantity_sold":60,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/09/29/49/025440f23b9f5932a358aac85553184f.jpg\" alt=\"\" width=\"750\" height=\"231\" /\u003e\u003c/p\u003e\n\u003cp\u003eKhi lựa chọn thực phẩm bổ sung giúp tăng cơ, ngoài các tiêu chí như hàm lượng Protein, hương vị thì thương hiệu cũng là một trong yếu tố khiến chúng ta lựa chọn sản phẩm. Whey Gold Standard là sản phẩm của hãng ON - Optimum Nutrition, một thương hiệu có thể nói là lâu đời nhất tại Mỹ. Hãy cùng tìm hiểu lý do vì sao Whey on lại được dân thể hình tin tưởng sử dụng trong suốt 20 năm qua.\u003c/p\u003e\n\u003ch5\u003e\u003cstrong\u003eNGÔN NGỮ THIẾT KẾ WHEY GOLD\u003c/strong\u003e\u003c/h5\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/9e/47/ff/29ac8cd7560eb2ceec9f0e79be12a3ba.jpg\" alt=\"\" width=\"750\" height=\"231\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eNgôn ngữ thiết kế của các sản phẩm Âu Mỹ thường thiên về lối thiết kế tối giản, màu sắc trung tính không lòe loẹt. Thực phẩm bổ sung cũng không nằm ngoài phong cách này. Hãng đã làm khá tốt trong việc hướng sự tập trung của bạn khi mới nhìn vào sản phẩm vào dòng chữ 100% Gold Standard. Thiết kế bên ngoài lấy đỏ đen làm màu chủ đạo khỏe khoắn, đậm chất thể thao. Nói chung, chưa bàn về chất lượng hay hương vị, hãng đã ghi điểm với vẻ ngoài ấn tượng rồi.\u003c/p\u003e\n\u003ch5\u003e\u003cstrong\u003eTHÀNH PHẦN VÀNG MANG TÊN GOLD\u003c/strong\u003e\u003c/h5\u003e\n\u003cp\u003eChiếm phần lớn trong Gold Standard là protein isolate, sau đó đến protein concentrate và cuối cùng là protein peptides ( hay còn gọi là Hydrolyzed). Ngoài hai cựu binh Isolate chứa protein tinh khiết, Concentrate giữ lại các hợp chất sinh học tốt cho tiêu hóa của cơ thể. Hãng ON còn đưa vào whey gold standard một tân binh khác. Đó là gì? Đó chính là protein peptides.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/20/6b/11/baa34d4defb15022664a8326dc5c8126.webp\" alt=\"\" width=\"750\" height=\"421\" /\u003e\u003c/p\u003e\n\u003cp\u003ePeptides là một chuỗi acid amin dài, là các đoạn protein. Nói đơn giản khi protein được hấp thụ và chia nhỏ thì sẽ hình thành ra peptides. Whey peptides được tạo thành từ quá trình thủy phân tức là đem phân tử protein ra phân tách thành các chuỗi peotides có độ dài ngắn khác nhau.\u003c/p\u003e\n\u003cp\u003eQuá trình này được gọi là quá trình tiêu hóa trước. Nhờ có quá trình này, whey peptides sẽ không cần qua công đoạn tiêu hóa tại dạ dày mà đi thẳng vào máu, sự hấp thụ có thể lên đến 98-99%. Đối với những người có hệ tiêu hóa kém khi tiêu thụ các loại whey khác sẽ mất đi một phần protein lãng phí Thì Whey gold đã giải quyết bài toán này.\u003c/p\u003e\n\u003ch5\u003e\u003cstrong\u003eBẠN NHẬN ĐƯỢC NHỮNG GÌ TỪ MỖI MUỖNG GOLD STANDARD\u003c/strong\u003e\u003c/h5\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/03/25/a8/b11ac3fee3dedd9d7a18309782076919.webp\" alt=\"\" width=\"750\" height=\"421\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eMang lại nguồn protein tinh khiết nhất trong từng muỗng sản phẩm, hỗ trợ phát triển cơ bắp tối đa. Khả năng hòa tan cũng là một trong những điều mà hãng luôn mong muốn phát triển để làm hài lòng những khách hàng khó tính nhất. Khả năng tan hoàn toàn khi pha bằng bình shaker hoặc đơn giản là chỉ khấy bằng cốc và thìa. Thành phần protein isolate trong Gold Standard whey được lọc bằng cả hai phương pháp Ion Exchange và Cross Flow Micro-filtered cho khả năng hấp thụ cao hơn.\u003c/p\u003e\n\u003ch5\u003e\u003cstrong\u003eVỚI NHỮNG NGƯỜI TẬP THỂ HÌNH, CHƠI THỂ THAO NHIỀU\u003c/strong\u003e\u003c/h5\u003e\n\u003cp\u003eNếu bạn chơi thể thao nhiều, hoặc là dân tập thể hình, thì hai thời điểm vàng để bổ sung protein chính là buổi sáng khi ngủ dậy và ngay sau khi tập. Buổi sáng là thời điểm cơ thể sử dụng hết năng lượng từ ngày hôm trước, lúc này nguồn protein hấp thụ nhanh sẽ cung cấp cho cơ thể nguồn năng lượng mới để khởi đầu một ngày đầy hứng khởi.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/2e/1f/da/27aa08378b6530e14ac5007f98ee2ef8.webp\" alt=\"\" width=\"750\" height=\"421\" /\u003e\u003c/p\u003e\n\u003cp\u003eCòn sau khi tập, lúc các cơ bắp của bạn được đẩy lên mức hoạt động tối đa, nó cần được bổ sung ngay Protein để khôi phục và phát triển tối đa hết mức có thể. Có thể nói On đã cho ra đời dòng sữa tăng cơ đỉnh cao trong làng thể hình.\u003c/p\u003e\n\u003ch5\u003e\u003cstrong\u003eVỚI NHỮNG NGƯỜI LỚN TUỐI, HẤP THỤ PROTEIN KÉM\u003c/strong\u003e\u003c/h5\u003e\n\u003cp\u003eNgười cao tuổi vị giác suy giảm, hấp thụ kém nên có thể sử dụng Gold standard whey như một thực phẩm bổ sung nguồn đạm từ sữa thơm ngon, bổ dưỡng. Dùng 1 muỗng mỗi ngày vào buổi sáng hoặc sau khi tập thể dục. Ngoài những cách trên, có thể dùng làm bánh protein ăn vặt hoặc các thanh protein để ăn trước các buổi tập đều rất tốt.\u003c/p\u003e\n\u003cp\u003eViệc luyện tập có kết quả như mong đợi hay không là sự kết hợp của hai yếu tố phương pháp luyện tập và chế độ dinh dưỡng. Vì thế, tìm được cho mình một sản phẩm phù hợp đồng hành trong quá trình xây dựng cơ bắp là hết sức cần thiết. Nếu bạn mong muốn một sản phẩm cung cấp nguồn protein tinh khiết, hấp thụ nhanh, giá cả hợp lý thì Whey gold standard là ứng cử viên sáng giá. \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/b4/74/8e/c8568fd4718e4ce1b642c2559b4a086f.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b4/74/8e/c8568fd4718e4ce1b642c2559b4a086f.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b4/74/8e/c8568fd4718e4ce1b642c2559b4a086f.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b4/74/8e/c8568fd4718e4ce1b642c2559b4a086f.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b4/74/8e/c8568fd4718e4ce1b642c2559b4a086f.png"},{"base_url":"https://salt.tikicdn.com/ts/product/a0/a4/b4/6658f66a5108092ac8beef241e6cbd13.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a0/a4/b4/6658f66a5108092ac8beef241e6cbd13.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a0/a4/b4/6658f66a5108092ac8beef241e6cbd13.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a0/a4/b4/6658f66a5108092ac8beef241e6cbd13.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a0/a4/b4/6658f66a5108092ac8beef241e6cbd13.jpg"},{"base_url":"https://salt.tikicdn.com/ts/pr