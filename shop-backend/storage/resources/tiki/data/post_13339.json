ment":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.7,"review_count":91,"review_text":"(91)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/36/9b/86/77db2e02a03c0d40dbf11e2a44f8d8d1.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2127,"all_time_quantity_sold":323,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eMũ bảo hiểm GRS A760 là loại mũ bảo hiểm nửa đầu cao cấp có thiết kế vỏ ngoài làm bằng hạt nhựa ABS, chịu được lực va đập và tránh trầy xước, có độ bền cao, sẽ bảo vệ bạn hiệu quả trước những va chạm ngoài ý muốn. Đồng thời, chất liệu này cũng giúp sản phẩm có độ bền cao hơn, cho thời gian sử dụng lâu dài.\u003c/p\u003e\n\u003cp\u003eMút xốp làm bằng nhựa EPS hấp thụ gần như hoàn toàn lực tác dụng do va đập bảo vệ phần đầu của bạn khỏi chấn động khi tai nạn.\u003c/p\u003e\n\u003cp\u003eKhi đội mũ, bạn sẽ không có cảm giác đau hay nặng đầu nhờ lớp mút xốp lót bên trong êm ái, tạo cảm giác thoải mái.\u003c/p\u003e\n\u003cp\u003eLớp vải lót dầy, sử dụng nguyên liệu thấm hút cao, có khả năng kháng khuẩn, chống ẩm giúp hạn chế các bệnh về tóc và da đầu khi phải đội mũ trong thời gian dài.\u003c/p\u003e\n\u003cp\u003eQuai mũ dệt 2 lớp bằng sợi tổng hợp, chịu lực kéo lực văng tốt, dễ thao tác khi dùng.\u003c/p\u003e\n\u003cp\u003eMũ Bảo Hiểm GRS A760 được thiết kế ôm vừa vặn phần đầu, dây và khóa cài chắc chắc giúp giữ chặt mũ với đầu, cho tính an toàn cao hơn, để bạn an tâm khi lưu thông trên đường.\u003c/p\u003e\n\u003cp\u003eMũ được sơn bằng nguyên liệu ngoại nhập, độ bền cao.\u003c/p\u003e\n\u003cp\u003eSản phẩm có thiết kế thời trang cùng màu sắc trẻ trung, tươi mới, phù hợp với nhiều đối tượng sử dụng.\u003c/p\u003e\n\u003cp\u003eGRS A760  bảo vệ được phần đầu mà lại tạo được cảm giác thoải mái cho người đội.\u003c/p\u003e\n\u003cp\u003eGRS A760 là hàng chính hãng được sản xuất bởi Công ty TNHH  MTV SX -TM HOÀNG QUÁN.\u003c/p\u003e\n\u003cp\u003eMũ bảo hiểm GRS A760 đạt tiêu chuẩn QCVN 2:2008/BKHCN.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e***GRS hiện đang là nhãn hiệu mũ bảo hiểm rất phổ biến và được ưa chuộng tại Việt Nam, với nguyên liệu nhập khẩu 100% từ Đài Loan bảo đảm về chất lượng, có tem hợp quy CR (tem chứng nhận đạt chuẩn theo TCVN) dán sau mũ.\u003c/p\u003e\n\u003cp\u003eMô tả chung về sản phẩm:\u003c/p\u003e\n\u003cp\u003e– GRS là nhãn hàng đến từ Đài Loan.\u003c/p\u003e\n\u003cp\u003e– Chất liệu hạt nhựa ABS , chống va đập, xuyên thủng rất tốt. \u003c/p\u003e\n\u003cp\u003e– Lớp vải lót của mũ có khả năng kháng khuẩn, hút ẩm tốt, dễ dàng vệ sinh.\u003c/p\u003e\n\u003cp\u003e– Khóa dây quai chất lượng cao, bền bỉ, chịu lực mạnh, độ dài linh hoạt.\u003c/p\u003e\n\u003cp\u003e– Lớp mút xốp cứng, được thiết kế bám sát vào vỏ mũ nên dễ dàng phân tán lực khi có va đập. \u003c/p\u003e\n\u003cp\u003e– Mũ có tem đảm bảo chất lượng tiêu chuẩn CR của Việt Nam \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e*** Hướng dẫn xác định cỡ mũ phù hợp: Vòng 1 sợi dây quanh đầu, phía trên lông mày và tai khoảng 2cm. Xiết sợi dây sao cho ôm vừa đủ thoải mái lấy đầu và ghi lại số đo đó. Lặp lại như vậy để tìm được số đo mà bạn thấy đầu dễ chịu nhất. Đó chính là size đầu của bạn. So sánh với kích cỡ mũ để lựa chọn size mũ phù hợp nhất.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/36/9b/86/77db2e02a03c0d40dbf11e2a44f8d8d1.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/36/9b/86/77db2e02a03c0d40dbf11e2a44f8d8d1.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/36/9b/86/77db2e02a03c0d40dbf11e2a44f8d8d1.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/36/9b/86/77db2e02a03c0d40dbf11e2a44f8d8d1.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/36/9b/86/77db2e02a03c0d40dbf11e2a44f8d8d1.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/b2/4d/a0/4867c5058462bcebe96f01b340596919.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b2/4d/a0/4867c5058462bcebe96f01b340596919.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b2/4d/a0/4867c5058462bcebe96f01b340596919.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b2/4d/a0/4867c5058462bcebe96f01b340596919.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b2/4d/a0/4867c5058462bcebe96f01b340596919.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/3f/a9/28/7047a38d0225ab3726a5007781834c53.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/3f/a9/28/7047a38d0225ab3726a5007781834c53.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/3f/a9/28/7047a38d0225ab3726a5007781834c53.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3f/a9/28/7047a38d0225ab3726a5007781834c53.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3f/a9/28/7047a38