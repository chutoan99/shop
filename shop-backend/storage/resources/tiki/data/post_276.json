"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":9,"review_text":"(9)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/73/4e/9e/c79b04ec35d4351342be5908d18c22e3.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":580,"all_time_quantity_sold":23,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2 class=\"irIKAp\"\u003e\u003cstrong\u003eTHÔNG TIN CHI TIẾT\u003c/strong\u003e\u003c/h2\u003e\n\u003cp class=\"irIKAp\"\u003eLoại kết nối: Bluetooth Smart và kết nối không dây 2.4GHz\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003ePhạm vi không dây: 10 m2\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eĐèn chỉ báo (LED): LED pin\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eKết nối / Nguồn: Có, công tắc bật/tắt\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eChi tiết về pin: 1 x AA\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eTuổi thọ pin: 24 tháng2\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eDPI (Tối thiểu/Tối đa): 1000±\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eCông nghệ cảm biến: Tính năng theo dõi quang học tiên tiến của Logitech\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eĐộ phân giải cảm biến: 1000 dpi\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eBánh xe cuộn: 3G Core\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eSố lượng nút: 8\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eNút tiêu chuẩn và đặc biệt: Bánh xe nghiêng có nhấp chuột ở giữa\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eHỗ trợ thao tác (Windows): Có\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eHỗ trợ thao tác (Mac): Có\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003ePhần mềm tùy chọn: Logitech Options và Logitech Flow\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e==============================\u003c/p\u003e\n\u003ch2 class=\"irIKAp\" style=\"text-align:center;\"\u003eChuột không dây bluetooth | USB Logitech M720 - Kết nối đa thiết bị, pin 2 năm, tương thích Mac | Windows\u003c/h2\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cstrong\u003eĐƯỢC CHẾ TẠO ĐỂ CÓ ĐỘ BỀN CAO, KHẢ NĂNG LINH HOẠT VÀ SỰ THOẢI MÁI\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eThành công trong thế giới đa thiết bị cùng với chuột M720 Triathlon. Bạn sẽ được cung cấp sức mạnh để vượt qua các nhiệm vụ bằng cách chuyển đổi nhuần nhuyễn giữa 3 máy tính, lướt qua các tài liệu và trang web với tính năng cuộn siêu nhanh. Hiệu suất tăng cường vì chuột kết nối Bluetooth và Unifying này dùng được 24 tháng với một pin AA. Tất cả trong một hình dạng có kích thước đầy đủ, vừa vặn thoải mái trong lòng bàn tay.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cstrong\u003eCÔNG NGHỆ EASY-SWITCH\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eKết nối chuột của bạn với 3 thiết bị khác nhau, sau đó chuyển đổi nhuần nhuyễn giữa chúng bằng cách chạm vào nút được đặt thuận tiện dưới ngón tay cái của bạn. 3 con số được phát sáng sẽ cho biết bạn đang kết nối với thiết bị nào.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/f6/cd/e6/2b9866574fe7fc06183bed2a18c3e67f.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cstrong\u003eCUỘN SIÊU NHANH\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eLướt qua các tài liệu và trang web dài bằng cách quay bánh xe - và dừng ngay lập tức - hoặc chuyển đổi sang chế độ cuộn bằng cách nhấp chuột khi bạn cần độ chính xác.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/2d/e6/99/2cbb653ab7d3d9b882464deadc65d9ca.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cstrong\u003eTHIẾT KẾ BỀN BỈ, ĐỘC ĐÁO\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eNhư một vận động viên thực thụ, M720 được thiết kế để chống chịu, với các nút có thể chịu được 10 triệu lần nhấp chuột. Thiết kế có kích thước lớn cho người thuận tay phải vừa vặn một cách thoải mái trong lòng bàn tay, bề mặt cao su khiến nó cực êm ái khi chạm vào.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/40/3f/8b/a49d2519efe53079d68993bb52c1c2c8.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cstrong\u003eTIẾN TRÌNH LÀM VIỆC ĐA MÁY TÍNH DỄ DÀNG\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eKhám phá tiềm năng của M720 với Logitech Flow, để có tiến trình làm việc mượt mà nhất giữa các máy tính. Bạn có thể di chuyển con trỏ chuột qua ba màn hình máy tính và thậm chí sao chép/dán văn bản, hình ảnh và tệp tin từ máy này sang máy khác. Hiệu quả hơn hẳn việc tự gửi thư điện tử cho chính mình.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/ce/17/40/39e567b57c64a3ee52a2324a7895e3b7.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cstrong\u003eTUỔI THỌ PIN 24 THÁNG\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eBạn sẽ thích hiệu suất nâng cao của con chuột này, với năng lượng dùng được 24 tháng cho một pin AA\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cstrong\u003eHIỆU SUẤT CÁ NHÂN HÓA\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eMở khóa đầy đủ các khả năng và tùy chỉnh để phù hợp với nhu cầu của bạn trên Mac OS X và Windows bằng cách tải về phần mềm Logitech Options. Cài đặt và gán tác vụ vào các nút với hướng dẫn chi tiết từng bước. Hướng dẫn sử dụng có sẵn để trả lời các câu hỏi của bạn\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/78/87/f7/a841e88796105a681ede3677187def28.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eChú ý :\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Mổi sản phẩm Logitech có 2 cấp độ số Serial khác nhau. 1 số trên bao bì (ngoài vỏ hộp) và 1 số bên trên sản phẩm. Hai số Serial này hoàn toàn khác nhau. Do chính sách quản lí riêng của - Logitech nên đây là vấn đề hoàn toàn bình thường.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eLogitech bảo hành điện tử theo mã số đơn hàng (Ngoài ra còn bảo hành theo mã số seri từng sản phẩm) nên sẽ không có phiếu bảo hành đi kèm\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Tất cả sản phẩm Logitech đều có thể còn hoặc không còn niêm phong của nhà sản xuất tùy vào từng đợt hàng, chính sách của các đơn vị nhập khẩu, phân phối và quá trình kiểm tra sản phẩm.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/73/4e/9e/c79b04ec35d4351342be5908d18c22e3.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/73/4e/9