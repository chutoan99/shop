:400;\" /\u003e\u003cbr /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ff/c3/f6/379c704078afd27fe7cdca1a0c28bb4a.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ff/c3/f6/379c704078afd27fe7cdca1a0c28bb4a.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ff/c3/f6/379c704078afd27fe7cdca1a0c28bb4a.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ff/c3/f6/379c704078afd27fe7cdca1a0c28bb4a.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ff/c3/f6/379c704078afd27fe7cdca1a0c28bb4a.png"},{"base_url":"https://salt.tikicdn.com/ts/product/55/ce/18/71ae8bb3ef2dccf38bad7eaa5c7e17f0.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/55/ce/18/71ae8bb3ef2dccf38bad7eaa5c7e17f0.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/55/ce/18/71ae8bb3ef2dccf38bad7eaa5c7e17f0.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/55/ce/18/71ae8bb3ef2dccf38bad7eaa5c7e17f0.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/55/ce/18/71ae8bb3ef2dccf38bad7eaa5c7e17f0.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/fa/a4/22/9bb4dc01fc362d642f91e9c8ebb82493.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/fa/a4/22/9bb4dc01fc362d642f91e9c8ebb82493.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/fa/a4/22/9bb4dc01fc362d642f91e9c8ebb82493.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fa/a4/22/9bb4dc01fc362d642f91e9