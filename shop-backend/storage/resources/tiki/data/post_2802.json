6.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":760000,"discount_rate":15,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/f5/bc/ea/ba24b2ffd74190dd7f349b50454c739a.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2258,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: center;\"\u003e\u003cstrong\u003eGiới thiệu Lò Vi Sóng Inverter Tích Hợp Nướng Panasonic NN-GD37HBYUE\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eLò vi sóng có nướng NN-GD37HBYUE Black\u003cbr /\u003eLò vi sóng kết hợp đối lưu 23 L/ Chế độ nấu kép/ Chức năng nấu nhanh 30 giây 1000 W/ Đèn Eco \u0026amp; Đèn sáng/ Công nghệ Inverter\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTÍNH NĂNG\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/product/3a/20/89/2e67a26495920e5b62b336d2bdb256e1.jpg\" /\u003e\u003c/p\u003e\n\u003cp\u003eChế độ nấu kép\u003cbr /\u003eNhờ công nghệ Inverter, năng lượng vi sóng nấu thức ăn nhanh chóng, trong khi chức năng nướng giúp thức ăn chín vàng và giòn. Tất cả đều diễn ra đồng thời, làm giảm thời gian nấu.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/product/19/4b/ac/4ec9075572d7ad649042564b1f304d04.jpg\" /\u003e\u003c/p\u003e\n\u003cp\u003eChức năng nấu nhanh 30 giây 1000 W\u003cbr /\u003eChức năng này cho phép bạn chọn thời gian nấu 30 giây một cách nhanh chóng và đơn giản. Mỗi lần nhấn nút thời gian nấu sẽ tăng thêm 30 giây và thời gian tối đa lên tới 5 phút.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/product/5f/27/64/9ddc3775a3d8403b2bd725ac5224a4c0.jpg\" /\u003e\u003c/p\u003e\n\u003cp\u003eĐèn LED tiết kiệm điện\u003cbr /\u003eĐèn LED giúp bên trong lò sáng hơn, vì vậy sẽ giúp dễ dàng kiểm tra tình trạng thực phẩm trong lò.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/product/f6/19/2a/8630573c4f73afdb937f129f98220205.jpg\" /\u003e\u003c/p\u003e\n\u003cp\u003eSự phát triển của Công nghệ Inverter của Panasonic\u003cbr /\u003eLò vi sóng truyền thống chỉ hoạt động trên một mức năng lượng bật hoặc tắt hoàn toàn.\u003c/p\u003e\n\u003cp\u003eCông nghệ Inverter của Panasonic chia độ các mức năng lượng liên tục để thức ăn được nấu chín đều hơn, ngon hơn.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/product/e4/db/4c/a0abe965ad1483f59a84060cdf463e7a.jpg\" /\u003e\u003c/p\u003e\n\u003cp\u003eTối ưu hóa nhiệt lượng nấu nướng giúp cho hương vị ngon hơn\u003cbr /\u003eMỗi nguyên liệu có nhiệt độ nấu nướng phù hợp với hương vị, cấu trúc và giá trị dinh dưỡng của nó. Inverter giúp tối ưu hóa công suất nhiệt.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/product/6c/c6/f2/d816361c0ba897bb6a83e45c288664d3.jpg\" /\u003e\u003c/p\u003e\n\u003cp\u003eRã đông Inverter Turbo\u003cbr /\u003ePanasonic đã thành công trong việc phát triển tính năng Rã đông Turbo, cho phép rã đông thực phẩm thậm chí nhanh hơn cả tính năng Rã đông Tự động trước đây của Panasonic. Công nghệ của Panasonic sử dụng liên tục nhiệt lượng inverter để rã đông thực phẩm \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTHÔNG SỐ KỸ THUẬT\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Số mẫu: NN-GD37HB\u003c/p\u003e\n\u003cp\u003e- Loại: Lò vi sóng kết hợp nướng\u003c/p\u003e\n\u003cp\u003e- Khoang lò: 23 L\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCÔNG NGHỆ PANASONIC\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Panasonic Inverter: Có\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTHIẾT KẾ\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Màu: Màu đen\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTÍNH NĂNG LẬP TRÌNH\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Nấu cảm biến: Có\u003c/p\u003e\n\u003cp\u003e- Hâm lại bằng cảm biến: Có\u003c/p\u003e\n\u003cp\u003e- Rã đông Inverter Turbo: Có\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/f5/bc/ea/ba24b2ffd74190dd7f349b50454c739a.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f5/bc/ea/ba24b2ffd74190dd7f349b50454c739a.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f5/bc/ea/ba24b2ffd74190dd7f349b50454c739a.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f5/bc/ea/ba24b2ffd74190dd7f349b50454c739a.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f5/bc/ea/ba24b2ffd74190dd7f349b50454c739a.png"},{"base_url":"https://salt.tikicdn.com/ts/product/41/62/03/9cea9a2bf77cd664a16c7121c955c6c9.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/41/62/03/9cea9a2bf77cd664a16c7121c9