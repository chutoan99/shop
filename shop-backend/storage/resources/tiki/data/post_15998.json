is_hero":false,"return_reason":"any_reason"}},"discount":121000,"discount_rate":47,"rating_average":4.6,"review_count":136,"review_text":"(136)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/e4/f0/1c/a368fd76f2bbecdbbf14eb17bea6c714.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1093,"all_time_quantity_sold":777,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2\u003eĐIỂM NỔI BẬT CỦA ĐỆM TỰA LƯNG EMA\u003c/h2\u003e\n\u003ch2\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/a7/11/7e/5f6cd7cd93f808f7c79adfe3b6dd5e00.jpg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/a7/11/7e/5f6cd7cd93f808f7c79adfe3b6dd5e00.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/h2\u003e\n\u003cul\u003e\n\u003cli style=\"font-size: 18px;\"\u003eÔm trọn cột sống thắt lưng\u003c/li\u003e\n\u003cli style=\"font-size: 18px;\"\u003eTạo cảm giác thoải mái khi tựa\u003c/li\u003e\n\u003cli style=\"font-size: 18px;\"\u003eRuột gối làm từ cao su non\u003c/li\u003e\n\u003cli style=\"font-size: 18px;\"\u003eVỏ gối lưới 4D tổ ong thoáng mát\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch2\u003eTHÔNG TIN SẢN PHẨM ĐỆM TỰA LƯNG EMA\u003c/h2\u003e\n\u003cp style=\"font-size: 18px;\"\u003e\u003cstrong\u003eHình dáng:\u003c/strong\u003e đệm tựa lưng Ema được thiết kế nhăm mục tiêu uốn lượn theo cột sống thắt lưng với 3  vùng tiếp xúc chính A - B - C tiếp xúc dọc cột sống thắt lưng\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/fa/be/a9/44557850bb6aede4f0d2d2798aecb2d3.jpg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/fa/be/a9/44557850bb6aede4f0d2d2798aecb2d3.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"font-size: 18px;\"\u003eThiết kế hõm ở giữa của gối giúp ôm trọn toàn bộ phần lưng người sử dụng, chất liệu cao su non giúp giảm áp lực lên lưng khi tựa lưng\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/26/b8/89/a8bf1dfe2bead3e406398f91023388a7.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/5c/6d/7b/148127dafaad753a5b5e7d8e0c805bc9.jpg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/5c/6d/7b/148127dafaad753a5b5e7d8e0c805bc9.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003eThiết kế ôm vừa khít với lưng giúp nâng đỡ tối đa tạo nên cảm giác êm ái, thoải mái khi sử dụng\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"font-size: 18px;\"\u003e\u003cstrong\u003eKích thước:\u003c/strong\u003e 32x30x10cm, đây là kích thước phù hợp để dùng cho mọi loại ghế và thích hợp với vóc dáng người Việt Nam\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/21/af/78/29edd401736e7ed2a1e3f4cc57441c8b.jpg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/21/af/78/29edd401736e7ed2a1e3f4cc57441c8b.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003eĐệm dài 30cm rộng 32cm cao 10cm\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"font-size: 18px;\"\u003e\u003cstrong\u003eChất liệu ruột: \u003c/strong\u003eđược làm từ chất liệu Memory Foam hay còn gọi là cao su non với đặc tính đàn hồi chậm, độ bền từ 5-7 năm. Đây là vật liệu do trung tâm vũ trụ NASA phát minh vào năm 1966 nhằm nâng cao sự an toàn cho các phần nệm của thiết bị bay nhằm giảm thiểu tối đa áp lực tác động lên các phi hành gia và rung chấn trong quá trình phóng tàu vũ trụ. Ngày này chất liệu này được sử dụng rất nhiều trong ngành công nghiệp gối - đệm\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/e0/6d/ba/4891680a15badbf3dbf3622ea13bba4e.jpg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/e0/6d/ba/4891680a15badbf3dbf3622ea13bba4e.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003eRuột gối được làm từ cao su non cao cấp có độ bền từ 5-7 năm\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"font-size: 18px;\"\u003e\u003cstrong\u003eChất liệu vỏ: \u003c/strong\u003elàm từ chất liệu vải 4D cấu trúc tổ ong có các lỗ thoáng khí, thấm hút mồ hôi. Vỏ gối có nhiều màu sắc phù hợp với tất cả mọi người.\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/18/c0/ad/120e954a4c9c84699180c3e047942c7a.jpg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/18/c0/ad/120e954a4c9c84699180c3e047942c7a.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"font-size: 18px;\"\u003e\u003cstrong\u003eTiện ích:\u003c/strong\u003e Gối có đai cài chắc chắn giúp cố định gối trên ghế\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/34/26/a3/b521d331bcc203dffd7178f8977ada7a.jpg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/34/26/a3/b521d331bcc203dffd7178f8977ada7a.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"font-size: 18px;\"\u003eHình ảnh thực tế của sản phẩm\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/51/71/08/63cb7479261e54b83241851369fbb6cc.jpg\" style=\"display: block; margin-left: auto; margin-