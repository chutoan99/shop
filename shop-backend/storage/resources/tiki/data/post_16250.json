ll,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":34000,"discount_rate":9,"rating_average":4.8,"review_count":4,"review_text":"(4)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/19/85/e8/4df9d20077ef76d3e461ee0135e56dea.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1028,"all_time_quantity_sold":24,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch1 class=\"title\" style=\"text-align: center;\"\u003eHàu Biển Ob New - Tăng Cường Sinh Lý Nam, Bổ Thận Tráng Dương, Hỗ Trợ Giảm Xuất Tinh Sớm, Rối Loạn Cươ Dươ, Cải Thiện Tinh Trùng Yếu (Hộp 20 Viên)\u003c/h1\u003e\n\u003cp\u003e\u003cspan style=\"color: #0000ff;\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/a1/14/16/9726c2ce9eab357fafe68aaebf7a0911.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eĐược Bộ Y Tế cấp phép sản xuất, lưu hành và quảng cáo. Tinh chất hàu biển từ 100% dược liệu thiên nhiên, tác dụng nhanh chóng, bổ sung thêm thành phần Hải sâm và Nhân sâm quý giá\u003c/p\u003e\n\u003cp\u003eTinh chất hàu biển cao giúp Bổ thận, tráng dương, sinh tinh, mạnh gân cốt tăng cường sinh lý nam giới tăng Testosterone, giảm quá trình mãn dục nam giảm đau mỏi lưng, gối\u003c/p\u003e\n\u003cp\u003eTác dụng nhanh chóng, an toàn khi sử dụng lâu dài, Không gây tác dụng phụ\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch2\u003e\u003cem\u003e\u003cstrong\u003eThành phần Hàu Biển OB New:\u003c/strong\u003e\u003c/em\u003e\u003c/h2\u003e\n\u003cp\u003eThành phần cho 1 viên nén:\u003c/p\u003e\n\u003cp\u003eo    Bột Hàu Biển …………………………………………… 500mg\u003c/p\u003e\n\u003cp\u003eo    Cao Nhân Sâm ………………………………………… 300mg\u003c/p\u003e\n\u003cp\u003eo    Bột chiết xuất Hải Sâm …………………………… 150mg\u003c/p\u003e\n\u003cp\u003ePhụ liệu: Lactose, Tinh bột, Magnesium stearate, Titan Dioxyd, Hydroxypropyl Methylcellulose, Polyethylene Glycol vừa đủ 1 viên nén\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/0f/5b/9b/7da89cd71fdc430ef650c5055a47622d.jpg\" alt=\"\" width=\"750\" height=\"421\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e- Sản phẩm được tách hoàn toàn các chất có hại, chỉ giữ lại hàm lượng Kẽm bổ dưỡng từ Hàu tươi, hiệu quả và không gây tác dụng phụ khi sử dụng lâu dài\u003c/em\u003e\u003c/p\u003e\n\u003ch2\u003e\u003cem\u003e\u003cstrong\u003eCông dụng:\u003c/strong\u003e\u003c/em\u003e\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cp\u003eGiúp bổ thận, hỗ trợ tăng cường sinh lực nam.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003eLàm chậm quá trình mãn dục nam và gia tăng ham muốn tình dục.\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eHỗ trợ vấn đề yếu sinh lý, xuất tinh sớm\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eHỗ trợ tình trạng vô sinh, hiếm muộn thông qua cải thiện số lượng và chất lượng tinh trùng khỏe mạnh.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eHỗ trợ tăng nội tiết tố nam nội sinh\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/d5/f4/2a/4d71bd0b9ce3d6eeb15375ddc0576523.png\" alt=\"\" width=\"750\" height=\"415\" /\u003e\u003c/p\u003e\n\u003ch2\u003e\u003cem\u003eNgoài ra để cải thiện sinh lý nam các quý ông cần chú ý:\u003c/em\u003e\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cp\u003e Làm việc khoa học và luôn giữ tâm lý thoải mái là một cách tuyệt vời để giảm căng thẳng và cải thiện sức khỏe bản thân. Chia sẻ, tâm sự cùng đối tác để giải tỏa căng thẳng và gần gũi nhau hơn.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003e Các “quý ông” nên tránh xa những thói quen ăn uống không lành mạnh, Vì chúng làm mất cân bằng hormone nam giới, ngăn chặn quá trình sản sinh hormone sinh dụ\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003e Nói không với hút thuoc. Hút ốc gây tổn hại mạch máu, tổn thương mô “cậu nhỏ”, có thể hạn chế khả năng cương. Đàn ông hút thuoc có xu hướng \"cậu nhỏ\" nhỏ hơn, rối loạn cươ dư.ơng, chất lượng tinh trùng giảm sút.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eYêu thường xuyên hơn giúp tăng cường sức khỏe cho nam giới. Bên cạnh đó, yêu thường xuyên giúp cơ thể cân bằng hormone, cải thiện chất lượng tinh trùng hiệu quả.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eKhông thẩm du nhiều sẽ ảnh hưởng rất lớn tới đời sống tình dụ cũng như sức khỏe. Vì nó làm giảm khả năng cương \"cậu nhỏ\" và xuất tinh.\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/24/ff/e7/8e6472f2d594db1d8cd407383369d34b.jpg\" alt=\"\" width=\"720\" height=\"720\" /\u003e\u003c/p\u003e\n\u003ch2\u003e\u003cem\u003e\u003cstrong\u003eCách sử dụng Hàu biển OB New:\u003c/strong\u003e\u003c/em\u003e\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cp\u003eUống 2 viên/ngày, sau ăn sáng hoặc ăn trưa. \u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003eKhông nên uống vào buổi tối, do có thành phần Nhân sâm - giúp tỉnh táo, khó ngủ.\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eMỗi đợt sử dụng liên tục từ 1-3 tháng. Sản phẩm an toàn nên có thể sử dụng thường xuyên.\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cem\u003e- Lưu ý: Người có tiền sử dị ứng hàu nên thận trọng khi sử dụng\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch3\u003e\u003cem\u003e\u003cstrong\u003eCHỐNG CHỈ ĐỊNH:\u003c/strong\u003e\u003c/em\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cp\u003eThành phần chính yếu của sản phẩm này là hàu sữa tự nhiên, hải sâm, nhân sâm. Mặc dù là thực phẩm bổ dưỡng, “thần dược tình yêu” nhưng có không ít người dị ứng. Cho nên nếu đấng mày râu mẫn cảm với hải sản hay bất kì thành phần nào thì không nên sử dụng Hàu Biển OB New.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eNgoài ra, hãy thận trọng khi sử dụng loại Hàu Biển OB New này cho những người bị bệnh tiểu đường, huyết áp cao, bệnh tim mạch, theo dõi kỹ biểu hiện và điều chỉnh liều lượng phù hợp.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eKhông sử dụng Hàu Biển OB tăng cường sinh lý nam cho trẻ dưới 18 tuổi và phụ nữ.\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eQuy cách đóng gói và chất liệu bao bì:\u003c/strong\u003e Vỉ 10 viên. Hộp 2 vỉ\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eSố đăng ký:\u003c/strong\u003e 9362/2020/ĐKSP\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eSản xuất tại\u003c/strong\u003e: Công ty TNHH Dược Phẩm USAPHA – Khu công nghiệp Tiên Sơn, xã Hoàn Sơn, huyện Tiên Du, Tỉnh Bắc Ninh, Việt Nam\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"