placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":20800,"discount_rate":10,"rating_average":4.3,"review_count":30,"review_text":"(30)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/fb/94/b3/7fe4ef7332ea24fc1d45d6ad918001fc.jpeg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1003,"all_time_quantity_sold":181,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: center;\"\u003e\u003cstrong\u003eCân Tiểu Ly Điện Tử Nhà Bếp Định Lượng 3000g - 0.1g Cân Làm Bánh\u003c/strong\u003e\u003cstrong\u003e Có Độ Chính Xác Cao - Hàng Chính Hãng MINIIN\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/b7/a7/2a/ae1503491c48e98162b99ed0da1c63b3.jpeg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"font-weight: 400;\"\u003eCÁC TÍNH NĂNG TỔNG QUÁT CỦA CÂN TIỂU LY ĐIỆN TỬ:\u003c/p\u003e\n\u003cp style=\"font-weight: 400;\"\u003eĐộ chia nhỏ nhất: 0,1g\u003c/p\u003e\n\u003cp style=\"font-weight: 400;\"\u003eTrọng lượng tối đa: 3000g\u003cbr /\u003eCân đạt độ chính xác cấp II theo tiêu chuẩn OIML.\u003cbr /\u003eĐộ phân giải nội cao, tốc độ xử lý nhanh\u003cbr /\u003eThiết kế chống bụi, cũng như sự ảnh hưởng của môi trường\u003cbr /\u003eMàn hình hiển thị LCD độ phân giải  cao.\u003cbr /\u003eNgười sử dụng có thể lựa chọn các đơn vị khác nhau g,t1,ct,oz,pcs  theo nhu cầu riêng.\u003cbr /\u003eThiết kế gọn nhẹ, có thể đem đi mọi nơi.\u003c/p\u003e\n\u003cp style=\"font-weight: 400;\"\u003eCó nút bật tắt đèn LCD\u003cbr /\u003eChức năng: cân trừ bì (quy về 0)\u003c/p\u003e\n\u003cp style=\"font-weight: 400;\"\u003eChế độ thông báo tình trạng ổn định của cân.\u003cbr /\u003eCân có chức năng báo hiệu gần hết Pin.\u003cbr /\u003eChế độ tắt cân tự động (Automatic shut-off) giúp tiết kiệm năng lượng Pin.\u003c/p\u003e\n\u003cp style=\"font-weight: 400;\"\u003eTHÔNG SỐ KỸ THUẬT CỦA CÂN TIỂU LI ĐIỆN TỬ:\u003c/p\u003e\n\u003cp style=\"font-weight: 400;\"\u003ePhương thức định lượng : cảm biến từ (load cell)\u003cbr /\u003eKích thước đĩa cân : 10 x 10cm (Đĩa cân bằng inox)\u003c/p\u003e\n\u003cp style=\"font-weight: 400;\"\u003eKích thước cân: 10.5 x 13 x 2 cm\u003cbr /\u003eNguồn điện sử dụng : 2 Pin AAA.\u003c/p\u003e\n\u003cp style=\"font-weight: 400;\"\u003eCó thể cân tới trọng lượng lên đến 3000g, kết quả hiện thị trên nền màn hình xanh với sai số 0,1g. Với mức độ chính xác tương đối cao, nên có thể nói rằng nó là một trong những lựa chọn tuyệt vời dành cho những ai đang và đã có nhu cầu kinh doanh các mặt hàng như mỹ phẩm, hóa chất, kim loại như vàng, bạc…\u003c/p\u003e\n\u003cp style=\"font-weight: 400;\"\u003eVới thiết kế nhỏ gọn và thân thiện, bạn hoàn toàn có thể đem \u003cem\u003ecân tiểu li điện tử \u003c/em\u003eđi theo bên mình dễ dàng mà không bị cồng kềnh hay nặng nhọc.\u003c/p\u003e\n\u003cp style=\"font-weight: 400;\"\u003eĐể sử dụng chiếc \u003cem\u003ecân tiểu ly điện tử \u003c/em\u003enày thì bạn chỉ cần mở nắp cân ra và đặt đồ vật cần cân lên là được. Và tất nhiên là bạn cần tìm chọn cho mình một mặt bằng cố định để để chiếc cân của mình lên đó. Như thế nó sẽ cho bạn kết quả chính xác hơn rất nhiều so với những nới bị nghiêng.\u003c/p\u003e\n\u003cp style=\"font-weight: 400; text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/dc/0e/25/0774b813cb8f78430a2be30c6a036923.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/92/d3/85/59c84aa619a504b68e699359abd7de92.jpeg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/92/d3/85/59c84aa619a504b68e699359abd7de92.jpeg\" alt=\"\" width=\"undefined\" height=\"undefined\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/9a/5e/84/45a75cf2947f596459f01dc64f920700.jpeg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/9a/5e/84/45a75cf2947f596459f01dc64f920700.jpeg\" alt=\"\" width=\"532\" height=\"532\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/c7/32/c4/d1370560c033775d2704f2ef3170f6ce.jpg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/c7/32/c4/d1370560c033775d2704f2ef3170f6ce.jpg\" alt=\"\" width=\"525\" height=\"524\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/fb/94/b3/7fe4ef7332ea24fc1d45d6ad918001fc.jpeg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/fb/94/b3/7fe4ef7332ea24fc1d45d6ad918001fc.jpeg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/fb/94/b3/7fe4ef7332ea24fc1d45d6ad918001fc.jpeg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fb/94/b3/7fe4ef7332ea24fc1d45d6ad918001fc.jpeg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fb/94/b3/7fe4ef7332ea24fc1d45d6ad918001fc.jpeg"},{"base_url":"https://salt.tikicdn.co