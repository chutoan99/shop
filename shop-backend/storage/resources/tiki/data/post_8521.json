ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":630000,"discount_rate":44,"rating_average":5,"review_count":3,"review_text":"(3)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/6a/1e/5c/426e075a8f24865135fe6b5082c56938.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2552,"all_time_quantity_sold":35,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch5\u003eThiết kế trang nhã, sang trọng\u003c/h5\u003e\n\u003cp\u003e\u003cstrong\u003e Vỉ Nướng Điện Lock\u0026amp;Lock EJG211BLK (1800W) \u003c/strong\u003e có xuất xứ từ Hàn Quốc, mang thiết kế hiện đại theo phong cách của xứ sở Kim Chi với lớp sơn phủ màu đen, kiểu dáng đơn giản, tinh tế góp phần tô điểm sự sang trọng cho không gian bếp ngôi nhà bạn.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch5\u003eCông suất lớn, hoạt động mạnh mẽ\u003c/h5\u003e\n\u003cp\u003eSản phẩm hoạt động mạnh mẽ với công suất 1800W, có khả năng làm nóng nhanh từ nhiệt độ phòng 20 \u003csup\u003e o \u003c/sup\u003e C lên 240 \u003csup\u003e o \u003c/sup\u003e C chỉ trong 1 phút, giúp cho thực phẩm được chín nhanh và đều, đồng thời giữ được hương vị của món ăn. Với 5 mức nhiệt linh hoạt để bạn tùy chỉnh theo từng món ăn, thiết bị thích hợp để chuẩn bị thức ăn cho 2 - 6 người ăn. \u003cbr /\u003e\u003cbr /\u003e\u003cbr /\u003e\u003c/p\u003e\n\u003ch5\u003eChất liệu an toàn cho sức khỏe\u003c/h5\u003e\n\u003cp\u003eViền mặt trước và mặt sau được làm bằng thép không gỉ, hai bên tay cầm được làm bằng nhựa chống nóng hiệu quả, đảm bảo an toàn khi sử dụng. Vỉ nướng được phủ lớp chống dính chất lượng cao nhập khẩu từ Nhật Bản, không có chứa chất độc hại PFOA, tiết kiệm thời gian khi chùi rửa. \u003cbr /\u003e\u003cbr /\u003e\u003cbr /\u003e\u003c/p\u003e\n\u003ch5\u003eLoại bớt dầu mỡ thừa trong thức ăn\u003c/h5\u003e\n\u003cp\u003eBề mặt vỉ nướng có lỗ thoát dầu và bên dưới vỉ có ngăn hứng dầu, giúp dễ dàng loại bỏ dầu mỡ thừa khi đang nướng. Đồng thời, vỉ nướng được đính kèm theo giá đỡ, giúp nâng một bên vỉ nướng (bên cắm bộ điều nhiệt) cao hơn bên còn lại (bên có lỗ thoát dầu) để dầu mỡ có thể dễ dàng chảy về phía lỗ thoát dầu, vừa mang lại món ăn ngon, vừa đảm bảo an toàn sức khỏe cho bạn và những người thân trong gia đình. \u003cbr /\u003e\u003cbr /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/6a/1e/5c/426e075a8f24865135fe6b5082c56938.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/6a/1e/5c/426e075a8f24865135fe6b5082c56938.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/6a/1e/5c/426e075a8f24865135fe6b5082c56938.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6a/1e/5c/426e075a8f24865135fe6b5082c56938.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6a/1e/5c/426e075a8f24865135fe6b5082c56938.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/bd/59/a7/812784e120f534c46d6db3bc1b0897d1.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/bd/59/a7/812784e120f534c46d6db3bc1b0897d1.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/bd/59/a7/812784e120f534c46d6d