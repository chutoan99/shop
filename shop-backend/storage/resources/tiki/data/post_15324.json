n_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":10000,"discount_rate":13,"rating_average":4.8,"review_count":238,"review_text":"(238)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/81/ff/f0/fe8852e0cbfbd69c2d58b27fc874303b.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1724,"all_time_quantity_sold":1702,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: center;\"\u003e\u003ciframe src=\"//www.youtube.com/embed/Ms3a4BzXuos\" width=\"560\" height=\"314\" allowfullscreen=\"allowfullscreen\"\u003e\u003c/iframe\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/29/41/4d/6a74f026678e563f6f233553d68019ae.png\" alt=\"\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003eHạt diêm mạch Dk Harvest\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cem\u003eHạt diêm mạch\u003c/em\u003e\u003c/strong\u003e DK Harvest  được chọn lựa khắt khe để có được những hạt chất lượng về hương thơm lẫn vị, và vẫn giữ được những chất dinh dưỡng …\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTHÔNG TIN SẢN PHẨM\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eThương hiệu: DK Harvest.\u003c/li\u003e\n\u003cli\u003eNhập khẩu: Peru và Australia.\u003c/li\u003e\n\u003cli\u003eĐóng gói tại: Việt Nam.\u003c/li\u003e\n\u003cli\u003eThành phần: 100% diêm mạch.\u003c/li\u003e\n\u003cli\u003eHạn sử dụng: 12 tháng.\u003c/li\u003e\n\u003cli\u003eTrọng lượng: 300g, 500g, 1000g.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/8c/8f/c0/779861dcfead259983604f933fd36622.png\" alt=\"\" width=\"625\" height=\"417\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003eHạt diêm mạch Dk Harvest\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eNHỮNG LỢI ÍCH BẤT NGỜ TỪ HẠT DIÊM MẠCH DK HARVEST\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cem\u003e\u003cstrong\u003eHạt diêm mạch DK Harvest\u003c/strong\u003e\u003c/em\u003e nhập khẩu từ Peru và Australia. Được sử dụng phổ biến ở khu vực Nam Mỹ. Và gần đây có xu hướng lan rộng khắp thế giới nhờ tính hữu dụng của nó.\u003c/li\u003e\n\u003cli\u003eTương tự như củ cải đường, rau bina hay rau dền, diêm mạch cũng được xem như một loại hạt giả ngũ cốc. Tuy nhiên, trước khi đưa vào làm thực phẩm, hạt phải được xử lí loại bỏ lớp saponin đắng bao phủ bên ngoài để tạo cảm giác ngon miệng hơn.\u003c/li\u003e\n\u003cli\u003eSẽ rất tốt cho quá trình ăn thực dưỡng hoặc ăn kiêng vì trong 100 gam diêm mạch nấu chín cung cấp đến 120 calo. Và là nguồn dưỡng chất đa dạng gồm: mangan, photpho, kẽm, sắt, kali, vitamin B1, B2, B6 cùng một lượng nhỏ axit béo omega 3. Nhờ vậy, dù ăn ít nhưng quá trình trao đổi chất bên trong cơ thể vẫn được diễn ra mạnh mẽ. Cho bạn có cảm giác no lâu, khỏe khoắn và dồi dào năng lượng.\u003c/li\u003e\n\u003cli\u003eBên cạnh đó, \u003cstrong\u003e\u003cem\u003ehạt\u003c/em\u003e\u003c/strong\u003e \u003cstrong\u003e\u003cem\u003ediêm mạch DK Harvest\u003c/em\u003e\u003c/strong\u003e còn hỗ trợ hiệu quả cho người lớn tuổi, người mắc các bệnh tiểu đường, cao huyết áp. Giúp kiềm hãm sự thay đổi thất thường của lượng đường trong máu.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/06/a8/6d/3f029f5bd93a1209c5fb21f124975a19.png\" alt=\"\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003eHạt diêm mạch Dk Harvest\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eHƯỚNG DẪN SỬ DỤNG\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eNấu diêm mạch ăn thay thế cho cơm hàng ngày.\u003c/li\u003e\n\u003cli\u003eNghiền nhuyễn dùng kèm với thịt bò hoặc cá phile (thay vì ăn khoai tây).\u003c/li\u003e\n\u003cli\u003eChế biến thành các món: “salad”, nấu súp, trộn viên với thịt,…\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/4d/a8/dd/e0eaa7d403c27cbedd40c89b270990c0.png\" alt=\"\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003eHạt diêm mạch Dk Harvest\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCÁCH BẢO QUẢN HẠT DIÊM MẠCH DK HARVEST\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eBảo quản nơi khô ráo, thoáng mát, tránh ánh nắng mặt trời.\u003c/li\u003e\n\u003cli\u003eĐậy kín sau mỗi lần sử dụng.\u003c/li\u003e\n\u003cli\u003eCó thể nấu chín và cho vào tủ lạnh dùng dần. \u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cem\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/e6/42/27/40380009643fd66d8e3b496a1ac3eae1.png\" alt=\"\" width=\"750\" height=\"500\" /\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003eHạt diêm mạch Dk Harvest\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e CÓ TẤT CẢ NHỮNG ĐIỀU BẠN CẦN\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eNếu chưa biết nhiều về hạt diêm mạch thì DK Harvest chính là địa chỉ đáng tin cậy để bạn chọn mua và dùng thử. Đừng lo ngại, tất cả sản phẩm đều đã được Cục Quản Lý Dược Phẩm và Thực Phẩm Hoa Kì (FDA); Bộ Công Thương Việt Nam; Trung tâm xử lí thực phẩm công nghệ cao kiểm duyệt, cấp phép lưu hành.\u003c/p\u003e\n\u003cp\u003eĐội ngũ trẻ DK Harvest khẳng định luôn đem đến những sản phẩm an toàn, chất lượng và giá cả cạnh tranh top đầu thị trường. Sẵn sàn cung cấp khối lượng lớn đáp ứng kịp thời nhu cầu của khách hàng trên toàn quốc. Vì giữa chúng tôi và khách hàng không thông qua đơn vị nhập khẩu trung gian nào khác. \u003c/p\u003e\n\u003cp\u003eDK Harvest luôn khao khát đóng góp một chút sức mình vào việc cải thiện những con số về mức độ gia tăng người chết vì đột quỵ, ung thư khi còn ở độ tuổi rất trẻ. Hãy thay đổi thói quen ăn nhiều đường bột và chất béo động vật trong khẩu phần hàng ngày bằng cách bổ sung “siêu thực phẩm”, nạp dinh dưỡng có từ thực vật.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/81/ff/f0/fe8852e0cbfbd69c2d58b27fc874303b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/81/ff/f0/fe8852e0cbfbd69c2d58b27fc874303b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/81/ff/f0/fe8852e0cbfbd69c2d58b27fc874303b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/81/ff/f0/fe8852e0cbfbd69c2d58b27fc874303b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/81/ff/f0/fe8852e0cbfbd69c2d58b27fc874303b.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/78/13/e3/28cec85bbe3c9744c12a8a8ce6e44008.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/78/13/