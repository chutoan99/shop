om/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.5,"review_count":11,"review_text":"(11)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/03/06/0e/5d8d2c5b512142b76a3c71695aebca4d.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1275,"all_time_quantity_sold":23,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: left;\"\u003e\u003cstrong\u003eMũ bảo hiểm fullface trùm đầu 2 kính SUNDA 823 – vệ sĩ chống tia cực tím\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003e*** THÔNG SỐ:\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003eMã sản phẩm: Sunda 823\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003eKiểu mũ: Fullface (trùm đầu - 2 kính, kính ngoài màu trắng, kính trong là kính râm)\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003eChất liệu: Nhựa ABS\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003eMàu sắc: nhiều màu\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003eTrọng Lượng: 1000±50g\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003eDành cho người có vòng đầu trung bình hoặc hơi lớn (tương đương size XL)\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003eMũ bảo hiểm fullface trùm đầu Sunda 823 – 2 kính được xem là dòng sản phẩm có tính năng bảo vệ mạnh, đặc biệt cặp mắt của mặt được bảo vệ qua 2 lớp kính.\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003eLớp kính mát được giấu bên trong mũ rất tiện lợi, gọn nhẹ. Khi bị chói nắng, bạn dễ dàng kéo kính mát này xuống che phủ mắt bạn, tác dụng như chiếc kính râm mà bạn hay bỏ quên ở nhà. Lớp kính che bên ngoài to hơn, bao phủ toàn bộ mặt bạn giúp chống bụi, mưa… giúp bạn thoải mái dù thời tiết có khắc nghiệt thế nào!\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/bd/b0/06/ed08abde197cf20cc7373cf1c55b3b05.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/fa/09/c3/0e031dba77f416dbe3664a50e3502eb1.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/fe/9c/e8/b18f4743b02cad8043b5274b0d8d6e13.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/d6/95/94/970d8a0bf8a90084e50a5375b997e590.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/08/ff/89/4bff4786b903cc9c25550bb90f84b559.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/c7/4b/9d/d24ea282cdabe501a3b3ecfed5b54efc.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003e*** Mũ fullface SUNDA 823 là dòng mũ cao cấp của công ty LONGHUEI, được thiết kế 1 cách cực kì tỉ mỉ, và thông minh:\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003e*** Thiết kế bên ngoài:\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003eVỏ mũ: Sản phẩm mũ bảo hiểm Sunda cam kết luôn sử dụng nhựa ABS nguyên sinh 100% được nhập khẩu từ các nhà cung ứng uy tín như Hàn Quốc, Malaysia, Thái, Nhật chịu được độ va đập cao.\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003e\u003cstrong\u003eSunda 823\u003c/strong\u003e được trang bị các khe lấy gió và thoát gió ở các vị trí tối ưu nhất.\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003eKhe gió trên đỉnh mũ và dưới cằm: Giúp không khí lưu thông vào bên trong mũ, tránh tình trạng hơi nước đọng lại trên bề mặt kính. Có thể dễ dàng đóng/ mở bằng cách trượt nhẹ nút gạt.\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003eKhe thoát gió trên thân mũ: Mang hơi nóng bên trong mũ tỏa ra bên ngoài.\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003eBộ phận thông gió dưới cằm có hình dạng như tam giác có thể được mở bằng cách đẩy lên và có thể đóng bằng cách đẩy nắp xuống, giúp không khí lưu thông vào bên trong mũ.\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003eKính được làm từ vật liệu chất lượng cao, đã qua xử lý đặc biệt, cho góc quan sát rộng, hình ảnh rõ nét, trung thực, không bị chói đèn, có khả năng chống tia UV400, chắn gió, để bạn tập trung lái xe. Kính chắn được làm từ vật liệu PC chất lượng cao.\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003eKính phụ (kính âm bên trong) được mệnh danh là “vệ sĩ chống tia cực tím” giúp người dùng dễ dàng quan sát trong điều kiện ánh sáng gắt, dễ dàng giấu kính này chỉ bằng một nút bấm khi không sử dụng). Lớp kính mát được giấu bên trong mũ rất tiện lợi, gọn nhẹ. Khi bị chói nắng, bạn dễ dàng kéo kính mát này xuống che phủ mắt bạn, tác dụng như chiếc kính râm mà bạn hay bỏ quên ở nhà.\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003eCơ chế hoạt động của kính chắn: Với thiết kế cải tiến để có thể đóng mở một cách dễ dàng. Trong trường hợp muốn thay đổi kính, có thể  tháo lắp bằng tay không. Đẩy kính lên một khớp nhỏ, sau đó dùng lực tay vặn ra, vô cùng thuận tiện và dễ dàng.\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003eỞ phần lắp kính, ở phần phía trên và phía dưới, miếng đệm cao su được dùng để cản gió và làm cho nước mưa không lọt được vào bên trong.\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003e*** Thiết kế bên trong:\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003eBộ phận điều chỉnh không khí này được làm từ PVC mềm để không làm hại mắt hoặc mặt của người lái khi xảy ra tai nạn. Bộ phận này có thể tháo ra và rửa sạch.\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003eVải lót cao cấp được xử lý kháng khuẩn , thấm hút tốt, mau khô, giúp hạn chế nguy cơ mắc các bệnh về tóc và da đầu. Có thể được tháo ra một cách dễ dàng cho việc làm sạch.\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003eMút xốp: là bộ phận quan trọng của nón, đó là bộ phận được thiết kế để có thể hấp thụ lực khi xảy ra tai nạn. Khác với các loại mút xốp thông thường, xốp nguyên sinh có thể hấp thụ lực khi bị tác dụng bởi lực khi tai nạn xảy ra. Như vậy lực tác động sẽ không ảnh hưởng đến người điều khiển phương tiện. Với sáu lỗ nhỏ bên trong dùng để giúp thông khí một cách dễ dàng.\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003eNgoài ra, mũ còn được trang bị khóa chắc chắn và dây quai chịu lực cực mạnh, độ dài linh động phù hợp với tất cả mọi người.\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003e***  Hướng dẫn xác định cỡ nón phù hợp: Vòng 1 sợi dây quanh đầu, ngay phía trên lông mày và tai. Xiết sợi dây sao cho ôm vừa đủ thoải mái lấy đầu và ghi lại số đo đó. Lặp lại như vậy để tìm được số đo mà bạn thấy đầu dễ chịu nhất và sử dụng số đo đó.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/03/06/0e/5d8d2c5b512142b76a3c71695aebca4d.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/