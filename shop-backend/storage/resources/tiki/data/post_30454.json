nt":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/c8/1a/17/a6bbb0d5b31cceae3fc3629b57206dc6.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":114,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eTác giả: Albert Camus\u003c/p\u003e\n\u003cp\u003eDịch giả: Liễu Trương\u003c/p\u003e\n\u003cp\u003eNhà xuất bản: Dân Trí\u003c/p\u003e\n\u003cp\u003eSố trang: 169\u003c/p\u003e\n\u003cp\u003eKích thước: 14x20.5cm\u003c/p\u003e\n\u003cp\u003eNgày phát hành: 08-2021.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e“Hôm nay mẹ mất. Hay hôm qua cũng nên, tôi chẳng biết.\"\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e29 tuổi, Albert Carnus ghi dấu bước chân đầu tiên trên văn đàn bằng hai câu văn ngắn gọn. Hào quang đến với ông ngay sau đó và cho tới giờ dường như chưa khi nào lụi tắt. Câu chuyện về Meursault, một kẻ không bao giờ tự tra vấn mình, một kẻ dửng dưng, đứng ngoài những tập tục, lề thói của xã hội, một “kẻ ngoại cuộc\", ngay từ khi ra mắt đã (và sẽ còn) làm dấy lên bao cuộc tranh luận về tính phi lý, chủ đề cái chết cùng những tranh cãi không ngừng ở các lĩnh vực từ chính trị, tâm lý học cho tới tâm thần học.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eVới hơn 7 triệu bản in đã tiêu thụ chỉ riêng ở Pháp, cùng hàng trăm triệu bản in bằng hơn 60 thứ tiếng khác, Kẻ ngoại cuộc là một trong ba tác phẩm Pháp ngữ được đọc nhiều nhất trên toàn thế giới. Tác phẩm cũng đã nhiều lần được chuyển thể sang phim, kịch, truyện  và là một trong những dấu ấn quan trọng giúp Albert Camus được trao giải Nobel Văn học năm 1957.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/c8/1a/17/4b310d6956d6900a9f9e108894590455.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e#sách #sach #sachnhanam\u003c/p\u003e\n\u003cp\u003e#AlbertCamus #Kengoaicuoc\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/c8/1a/17/a6bbb0d5b31cceae3fc3629b57206dc6.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c8/1a/17/a6bbb0d5b31cceae3fc3629b57206dc6.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c8/1a/17/a6bbb0d5b31cceae3fc3629b57206dc6.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c8/1a/17/a6bbb0d5b31cceae3fc3629b57206dc6.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c8/1a/17/a6bbb0d5b31cceae3fc3629b57206dc6.jpg"}],"warranty_policy":null,"authors":[{"id":24945,"name":"Albert Camus","slug":"albert-camus"}],"current_seller":{"id":97533,"sku":"4906192498277","name":"Nhà Sách Vĩnh Thụy","link":"https://tiki.vn/cua-hang/nha-sach-vinh-thuy","logo":"https://vcdn.tikicdn.com/ts/seller/19/f2/bd/8bda12adffb15edf1b3d8339b0238283.jpg","price":111000,"product_id":"275116147","store_id":90454,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[{"id":344082,"name":"Nhã Nam Official","link":"https://tiki.vn/cua-hang/nha-nam-official","logo":"https://vcdn.tikicdn.com/ts/seller/71/91/9a/206c244198b235d84b81a2f4c726003f.jpg","price":104550,"product_id":"275062530","store_id":331791}],"specifications":[{"name":"Thông tin chung","attributes":[{"code":"publisher_vn","name":"Công ty phát hành","value":"Nhã N