{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":47000,"discount_rate":4,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/9b/85/a9/838a418080b8e38aafe8316a4070ebf5.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1240,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003ciframe src=\"//www.youtube.com/embed/HAp9Jf0Xo54\" width=\"560\" height=\"314\" allowfullscreen=\"allowfullscreen\"\u003e\u003c/iframe\u003e\u003c/p\u003e\n\u003cp\u003eChúng ta đã quá quen thuộc với những chiếc bồn tắm kiểu truyền thống được làm từ những chất liệu như gạch, gỗ, men sứ, composite nhưng còn sản phẩm bồn tắm nhựa gấp gọn thì hiện nay vẫn còn chưa có nhiều người biết đến. Bồn tắm nhựa gấp gọn có thể coi là một loại chậu tắm bằng nhựa có hình dáng tương tự như một chiếc bồn tắm truyền thống, có kích thước lớn đủ để một người trưởng thành có thể nằm, ngồi một cách thoải mái bên trong. Điểm khác biệt của loại bồn tắm này là nó được thiết kế với cấu tạo thông minh, có thể gấp gọn lại chỉ bằng 1/3 so với kích thước ban đầu nên rất tiết kiệm diện tích.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/fc/d7/57/0848b1c116190e8ed4b425c7088f7585.jpg\" alt=\"\" width=\"750\" height=\"749\" /\u003e\u003c/p\u003e\n\u003cp\u003eƯu điểm lớn nhất của sản phẩm đó là có thể lắp ráp cũng như gấp gọn một cách nhanh chóng, dễ dàng giúp tiết kiệm tối đa không gian trong phòng tắm\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/e7/f7/15/009e9b923de12003c06ae8a5bf2833a0.jpg\" alt=\"\" width=\"720\" height=\"720\" /\u003e\u003c/p\u003e\n\u003cp\u003eBên cạnh đó, với ưu điểm có thể gấp gọn, bạn hoàn toàn có thể mang theo chiếc bồn tắm này trong các chuyến du lịch, dã ngoại của gia đình.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/5b/ba/3c/60579e95fb4a6f3948a8b5ad4a61fa2d.jpg\" alt=\"\" width=\"720\" height=\"720\" /\u003e\u003c/p\u003e\n\u003cp\u003eThân của chiếc bồn tắm gấp sử dụng chất liệu PP và TPE bền bỉ, chịu tải tốt, chống trầy xước do va đập, dễ vệ sinh và cũng rất an toàn với cơ thể người. Với chất liệu cao cấp này, bạn hoàn toàn có thể pha nước ấm để ngâm mình thư giãn hoặc tắm thuốc bắc để làm đẹp và thải độc cơ thể như với những chiếc bồn men sứ truyền thống. Nó cũng phù hợp để sử dụng cho cả trẻ nhỏ - những đối tượng có làn da nhạy cảm với các chất liệu nhựa tổng hợp nhất.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/9b/6c/0a/ba20df9a35fb9cf751f597a2d8f20f6d.jpg\" alt=\"\" width=\"720\" height=\"720\" /\u003e\u003c/p\u003e\n\u003cp\u003eNắp bồn này cũng có thể tháo rời khi cần để bạn có thể có không gian nằm xuống một cách thoải mái hơn trong lúc ngâm mình. Bồn tắm có thiết kế ống dẫn bên cạnh giúp bạn dễ dàng xả nước và vệ sinh sau khi sử dụng.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/cf/a1/03/3709e673bca4bfe659810f3e0f4b5c80.jpg\" alt=\"\" width=\"720\" height=\"720\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/88/5b/a7/249459ae1f896f6123fa6f529426e463.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/b4/91/8d/413538d8f1e42f25872c44a9706f2163.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eBồn tắm nhựa gấp gọn có phần thành cao đến 58cm giúp tránh tình trạng nước bắn tung tóe ra bên ngoài gây trơn trượt, mất an toàn khi di chuyển xung quanh bồn. Hai bên thành bồn tắm có tay nắm thuận tiện, đảm bảo an toàn khi bạn đứng lên bước ra ngoài. Phần chân đế được thiết kế chắc chắn, khả năng chịu tải cao nên bạn có thể hoàn toàn thư giãn khi nằm bên trong mà không lo bị gãy, đổ\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/dd/f3/ef/573488af4a69ade8d10b1a26b9b2fce8.jpg\" alt=\"\" width=\"720\" height=\"720\" /\u003e\u003c/p\u003e\n\u003cp\u003eƯu điểm và lợi ích nổi bật của bồn tắm gấp gọn: Thiết kế chắc chắn, dễ dàng gấp gọn lại khi không sử dụng. Trọng lượng nhẹ ( dưới 10 Kg) dễ dàng di chuyển và gấp gọn. Đáy bồn tắm tạo điểm chống trơn trượt và massage bàn chân khi ngâm mình. Kích thước lớn phù hợp sử dụng cho cả người lớn và trẻ em sử dụng. Chất liệu silicon kết hợp nhựa PP bền bỉ, chắc chắn. Chịu được trọng lượng lớn cả người dùng và nước. Dễ dàng tháo xả nước, với vòi ở đáy và lưng bồn tắm sau khi sử dụng xong. Phù hợp tắm ngâm, tắm xả stress cùng dầu dưỡng. Tăng cường sức khỏe cơ thể và làn da.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ac/0f/af/ae1589341a233efae500f55055061bba.jpg\" alt=\"\" width=\"720\" height=\"720\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/0d/ba/06/14a5af1fadced3652734986e9e8e0d7d.jpg\" alt=\"\" width=\"750\" height=\"660\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/7b/10/36/1684ad4c6975ee491eab6871ea7bd9c7.jpg\" alt=\"\" width=\"750\" height=\"843\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/9b/85/a9/838a418080b8e38aafe8316a4070ebf5.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/9b/85/a9/838a418080b8e38aafe8316a4070ebf5.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/9b/85/a9/838a418080b8e38aafe8316a4070ebf5.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9b/85/a9/838a418080b8e38aafe8316a4070ebf5.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9b/85/a9/838a418080b8e38aafe8316a4070ebf5.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/0d/ba/06/697917779f8f0a1886f5371f56ecfe33.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0d/ba/06/697917779f8f0a1886f5371f56ecfe33.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/0d/ba/06/697917779f8f0a1886f5371f56ecfe33.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0d/ba/06/697917779f8f0a1886f5371f56ecfe33.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0d/ba/06/697917779f8f0a1886f5371f56ecfe33.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/5b/ba/3c/8d521be662f19620ed53c2983d5f56d5.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/5b/ba/3c/8d521be662f19620ed53c2983d5f56d5.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/5b/ba/3c/8d521be662f19620ed53c2983d5f56d5.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5b/ba/3c/8d521be662f19620ed53c2983d5f56d5.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5b/ba/3c/8d521be662f19620ed53c2983d5f56d5.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/86/8e/14/2c9f03fdd3532f9ff12d1a5585454e25.jpg","is_gallery":true,"label":null,"large_url":