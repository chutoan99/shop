ll,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/3b/8c/47/dfaf9b81b9b5abc18149901bb4d3cca6.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":494,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp class=\"irIKAp\"\u003eGhế xoay văn phòng Win W613A-3 là mẫu ghế đang được rất nhiều khách hàng lựa chọn nhờ sự nổi bật trong thiết kế, chất liệu cũng như tính năng. Ghế xoay lưng lưới phù hợp với thời tiết mùa hè nóng bức, tạo cảm giác mát mẻ, thoải mái cho người ngồi, quên đi sự ngột ngạt, nâng cao năng suất công việc. \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eGhế xoay văn phòng Win W613A-3 được nhập khẩu và phân phối bởi Govi Furniture\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cdiv class=\"irIKAp\"\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"_7eojrG\"\u003e\u003cimg class=\"_0O7Vlf _0dg1Q+\" src=\"https://down-vn.img.susercontent.com/file/vn-11134208-7qukw-lfbbg5xt4nes6f\" alt=\"vn-11134208-7qukw-lfbbg5xt4nes6f\" /\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e-Kích thước\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eW610 x D650 x H1180-1260 mm\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e-Tựa đầu bằng lưới thoáng mát, điều chỉnh độ cao thấp và chỉnh góc phù hợp với người ngồi.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e-Khung ghế bằng nhựa nylon bền chắc, chống mài mòn, lưng bọc lưới thoáng mát thích hợp với thời tiết mùa hè nóng ẩm.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e-Tựa lưng có phần đệm đỡ điều chỉnh độ sâu, hỗ trợ vùng thắt lưng luôn trong tư thế chuẩn, không đau lưng, không cong vẹo cột sống.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e-Tay ghế cố định bằng nhựa PP pha sợi thủy tinh có độ bền cao, trọng lượng nhẹ, thiết kế phù hợp với chiều dài cánh tay đảm bảo làm việc dễ dàng, bảo vệ khuỷu tay.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e-Đệm ngồi bằng bọt biển nguyên chất có độ đàn hồi cao, có độ nảy tốt, không xẹp lún không biến dạng, thoáng khí không tích nhiệt khi ngồi trong thời gian dài.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e-Mâm ghế có chức năng ngả sau và khóa cố định ở vị trí ngả đảm bảo sự chắc chắn khi sử dụng, giúp người ngồi thoải mái thư giãn.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e-Sử dụng thủy lực khí nén ba cấp chống cháy nổ, đạt tiêu chuẩn kiểm nghiệm BIFMA.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e-Chân ghế bán kính 320mm bằng thép mạ crom, chịu tải trọng lên đến 1136kg, có độ bền cao, không han gỉ, không oxy hóa.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e-Bánh xe đường kính 60mm bằng nhựa PA bền bỉ, chống ồn, chống sóc, dễ dàng di chuyển.\u003c/p\u003e\n\u003cdiv class=\"irIKAp\"\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"_7eojrG\"\u003e\u003cimg class=\"_0O7Vlf _0dg1Q+\" src=\"https://down-vn.img.susercontent.com/file/vn-11134208-7qukw-lfbbg5xt61z8cd\" alt=\"vn-11134208-7qukw-lfbbg5xt61z8cd\" /\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eCÔNG NĂNG SẢN PHẨM\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Bảo vệ sức khỏe người dùng, hạn chế mắc các bệnh văn phòng.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Đệm ngồi định hình mật độ cao giúp người dùng cảm thấy thoải mái êm ái khi sử dụng\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Ngăn ngừa dị dạng cột sống\u003c/p\u003e\n\u003cdiv class=\"irIKAp\"\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"_7eojrG\"\u003e\u003cimg class=\"_0O7Vlf _0dg1Q+\" src=\"https://down-vn.img.susercontent.com/file/vn-11134208-7qukw-lg0cbjpiowoa49\" alt=\"vn-11134208-7qukw-lg0cbjpiowoa49\" /\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cp class=\"irIKAp\"\u003e- Chống thoát vị đĩa điệm\u003c/p\u003e\n\u003cdiv class=\"irIKAp\"\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"_7eojrG\"\u003e\u003cimg class=\"_0O7Vlf _0dg1Q+\" src=\"https://down-vn.img.susercontent.com/file/vn-11134208-7qukw-lg09xsday9kn02\" alt=\"vn-11134208-7qukw-lg09xsday9kn02\" /\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cp class=\"irIKAp\"\u003eHƯỚNG DẪN SỬ DỤNG:\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Sản phẩm tự lắp ráp, nguyên kiện bao gồm bộ dụng cụ lắp ráp, hình ảnh và video hướng dẫn sử dụng.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Hạn chế tiếp xúc với ánh nắng mặt trời, nơi ẩm ướt. Sử dụng các chất tẩy rửa chuyên dụng để không làm mất độ thẩm mỹ của sản phẩm\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Không sử dụng vật sắc nhọn để bóc kiện, tránh hỏng hàng đáng tiếc\u003c/p\u003e\n\u003cdiv class=\"irIKAp\"\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"_7eojrG\"\u003e\u003cimg class=\"_0O7Vlf _0dg1Q+\" src=\"https://down-vn.img.susercontent.com/file/vn-11134208-7qukw-lg09xsdazo535c\" alt=\"vn-11134208-7qukw-lg09xsdazo535c\" /\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cp class=\"irIKAp\"\u003e- CHÍNH SÁCH BẢO HÀNH\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e+ 1 đổi 1 miễn phí trong vòng 7 ngày.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e+ Bảo hàng 24 tháng phần cơ khí.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e+ Sản phẩm lỗi từ nhà sản xuất trong quá trình sản xuất.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e+ Sản phẩm hư hỏng trong quá trình vận chuyển.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e+ Chăm sóc, hỗ trợ và tư vấn trọn đời.\u003c/p\u003e\n\u003cdiv class=\"irIKAp\"