/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/45/c1/58/2521d710e6e2df2c239e40987103abc5.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1598,"all_time_quantity_sold":5,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eĐÈN DIỆT KHUẨN DEVITOP UV: \u003c/strong\u003e\u003cstrong\u003eTIÊU DIỆT VIRUS BẢO VỆ SỨC KHỎE CHO BẠN VÀ GIA ĐÌNH\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eTheo thông tin từ website điện tử VN Express, VTV, TOQUOC, ZING,... thì đèn UV tia cực tím sẽ diệt hoàn toàn được vi khuẩn virus Covid-19 và Sars-cov-2, công nghệ này hiện tại đang được áp dụng rộng rãi trong các bệnh viện lớn trên khắp thế giới.\u003c/p\u003e\n\u003cp\u003eCông ty Surfacide ở bang Wisconsin của Mỹ cho biết thiết bị của công ty này có thể tiêu diệt virus SARS-CoV-2 bằng ánh sáng.\u003c/p\u003e\n\u003cp\u003eThiết bị này có dạng tháp, phát ra ánh sáng UVC. Đây là dạng ánh sáng cực tím không thể nhìn thấy bằng mắt thường, nhưng mạnh hơn tia UV của ánh sáng Mặt trời.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/be/ae/47/9cfcef5f2753f1797531c7aa0100d157.png\" alt=\"\" width=\"640\" height=\"421\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/f0/aa/2a/1bf3406cd0c34bd72697c9d282929bab.jpg\" alt=\"\" width=\"600\" height=\"400\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e***\u003c/strong\u003e Thiết bị này có dạng tháp, phát ra ánh sáng UV. Đây là dạng ánh sáng cực tím không thể nhìn thấy bằng mắt thường, nhưng mạnh hơn tia UV của ánh sáng Mặt trời.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e**\u003c/strong\u003e Bóng đèn cực tím (UV) chuyên dùng trong ngành y tế, thực phẩm và dược phẩm.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e**\u003c/strong\u003e Tiệt trùng, chống nấm.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e** \u003c/strong\u003eTriệt tiêu vi khuẩn có hại, chống loại các loại kí sinh nguy hiểm.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e**\u003c/strong\u003e Làm sạch không khí trong phòng (trừ bụi).\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/82/ee/78/d1e38f91428744ca416b9b54000d986d.jpg\" alt=\"\" width=\"750\" height=\"700\" /\u003e\u003c/p\u003e\n\u003cp\u003e=\u0026gt; Dễ dàng di chuyển, gọn nhẹ. Có điều khiển để bật tắt và hẹn giờ.\u003c/p\u003e\n\u003cp\u003e=\u0026gt; Cam kết hàng chính hãng, an toàn với con người và vật nuôi, không làm ô nhiễm môi trường.\u003c/p\u003e\n\u003cp\u003e=\u0026gt; Đối tượng: hộ gia đình, hộ kinh doanh,Doanh nghiệp, cơ quan, khách sạn, nhà hàng, bệnh viện, trường học, nhà máy, kho hàng, cầu cảng, resort, sân golf, khu vui chơi, tàu du lịch,\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/a3/f9/10/9a991f0685ac9baadd74f76589dccd30.jpg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/a3/f9/10/9a991f0685ac9baadd74f76589dccd30.jpg\" alt=\"\" width=\"565\" height=\"565\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"htt