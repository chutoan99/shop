"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":4110000,"discount_rate":33,"rating_average":5,"review_count":3,"review_text":"(3)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/fb/59/3f/a2d842a9176a6b4a4d62d0220391e4e3.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1370,"all_time_quantity_sold":27,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lsjm9l8objq1e8\" width=\"750\" height=\"1222\" alt=\"vn-11134208-7r98o-lsjm9l8objq1e8\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lsjm9l8ocyah79\" width=\"2500\" height=\"4424\" alt=\"vn-11134208-7r98o-lsjm9l8ocyah79\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lskqnzg8axll4d\" alt=\"vn-11134208-7r98o-lskqnzg8axll4d\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lsjm9l8oecux46\" width=\"2500\" height=\"3078\" alt=\"vn-11134208-7r98o-lsjm9l8oecux46\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lsjm9l8oh5ztd6\" width=\"2500\" height=\"4590\" alt=\"vn-11134208-7r98o-lsjm9l8oh5ztd6\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lsjm9l8oikk98e\" width=\"2500\" height=\"4235\" alt=\"vn-11134208-7r98o-lsjm9l8oikk98e\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lsjm9l8ojz4p3d\" width=\"2500\" height=\"3537\" alt=\"vn-11134208-7r98o-lsjm9l8ojz4p3d\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lsjm9l8oldp51e\" alt=\"vn-11134208-7r98o-lsjm9l8oldp51e\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lsjneu5j7oux29\" alt=\"vn-11134208-7r98o-lsjneu5j7oux29\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lsjneu5j93fd07\" alt=\"vn-11134208-7r98o-lsjneu5j93fd07\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e1/ THÔNG TIN CHUNG CỦA SẢN PHẨM\u003c/p\u003e\n\u003cp\u003e- Máy lọc nước Pureit Lavita 3 cấp độ nóng thông minh, lắp đặt linh hoạt chắc chắn là điểm nhấn tinh tế, sang trọng làm sáng bừng không gian sống, mang lại nguồn nước sạch khuẩn cho cả gia đình bạn.\u003c/p\u003e\n\u003cp\u003e- Công nghệ Smart Hot - nóng nhiều cấp độ: nhiệt độ phòng, 45 độ và 93 độ (dao động +/- 5 độ), phù hợp để sử dụng cho đa dạng nhu cầu như pha cà phê, pha trà, pha sữa và nấu mì.\u003c/p\u003e\n\u003cp\u003e- Tính năng tùy chỉnh mực nước theo nhu cầu sử dụng: 500ml, 350ml, 240ml.\u003c/p\u003e\n\u003cp\u003e- Tổng dung tích bình chứa: 3,5L, tốc độ lọc 0,25L/phút* (tương đương 15L/giờ)\u003c/p\u003e\n\u003cp\u003e- Màn hình kỹ thuật số cảm ứng hiện đại, thể hiện nồng độ chất rắn hòa tan trong nước trước và sau khi lọc.\u003c/p\u003e\n\u003cp\u003eNgoài ra, màn hình còn thể hiện tuổi thọ của từng lõi lọc, giúp người dùng chủ động thay lõi đúng hạn để đảm bảo nguồn nước cho gia đình.\u003c/p\u003e\n\u003cp\u003e- Bộ lọc thân thiện với môi trường, với với lõi lọc thẩm thấu ngược RO có công suất 4,000 lít, thiết kế đơn giản để khách hàng có thể tự thay lõi lọc tại nhà. Thời gian thay lọc: trung bình 6-12 tháng** đối với lõi PPCF và lõi CF; 2-3 năm** đối với lõi RO của máy.\u003c/p\u003e\n\u003cp\u003e- Công nghệ tự động làm sạch lõi lọc đảm bảo vệ sinh an toàn cho thiết bị\u003c/p\u003e\n\u003cp\u003e- Thiết kế nhỏ gọn, phù hợp với nhiều vị trí: phòng bếp, phòng khách, phòng ngủ.\u003c/p\u003e\n\u003cp\u003e- Không cần lắp đặt đường nước, chỉ cần kết nối nguồn điện để sử dụng.\u003c/p\u003e\n\u003cp\u003e- Khóa an toàn cho trẻ: giúp bảo vệ trẻ bằng cách hiển thị cảnh báo khi chọn mức nhiệt 93 độ, nhờ đó ngăn ngừa rủi ro bỏng cũng như đảm bảo an toàn cho trẻ.\u003c/p\u003e\n\u003cp\u003e- Máy được làm từ nhựa an toàn thực phẩm không chứa BPA***\u003c/p\u003e\n\u003cp\u003e- Tỷ lệ thu hồi nước sau lọc lớn: 2 lít nước sạch:1 lít nước thải****\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e2/ CÔNG NGHỆ LỌC \u0026amp; LÕI LỌC\u003c/p\u003e\n\u003cp\u003eMáy lọc nước Pureit Lavita được trang bị công nghệ lọc thẩm thấu ngược RO (Reverse Osmosis) với 4 bước lọc và khử khuẩn bằng tia cực tím UV hiện đại.\u003c/p\u003e\n\u003cp\u003e- PPCF bao gồm màng lọc PP và màng lọc than hoạt tính:\u003c/p\u003e\n\u003cp\u003e+ Màng lọc PP: Loại bỏ bụi bẩn li ti nhìn thấy được, kéo dài thời hạn sử dụng của bước lọc than hoạt tính.\u003c/p\u003e\n\u003cp\u003e+ Màng lọc than hoạt tính: Loại bỏ Chlorine, thuốc trừ sâu, hấp thụ các chất gây mùi, vị lạ trong nước, cặn bẩn có kích thước nhỏ thêm một lần nữa.\u003c/p\u003e\n\u003cp\u003e- RO: loại bỏ vi khuẩn, vi rút, bào tử vi khuẩn, ký sinh trùng, loại bỏ kim loại nặng như arsen, thủy ngân, sắt, chì,...\u003c/p\u003e\n\u003cp\u003e- CF: hấp thụ các cặn bã, tạp chất còn sót lại và loại bỏ màu, mùi, vị lạ trong nước.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e3/ CHẤT LƯỢNG NƯỚC ĐẦU VÀO VÀ ĐẦU RA\u003c/p\u003e\n\u003cp\u003eNguồn nước đầu vào mà máy lọc nước Pureit Lavita có thể xử lý là nước máy tiêu chuẩn. Thông số kĩ thuật nguồn nước đầu vào:\u003c/p\u003e\n\u003cp\u003e- Tổng chất rắn hoà tan dưới 500 mg/lít (Nước máy tiêu chuẩn)\u003c/p\u003e\n\u003cp\u003e- Độ pH: 6.5 - 8\u003c/p\u003e\n\u003cp\u003e- Độ đục 1 NTU (tối đa)\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eNước đầu ra đạt tiêu chuẩn nước uống trực tiếp theo quy định do Bộ Y Tế ban hành (quy chuẩn QCVN 6-1: 2010/BYT). Unilever Pureit là thành viên của Hiệp hội Chất lượng nước Hoa Kỳ (Water Quality Association) và cam kết mang lại nguồn nước sạch an toàn cho sức khoẻ của mọi gia đình Việt.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e4/ ĐIỀU KIỆN LẮP ĐẶT \u0026amp; BẢO HÀNH\u003c/p\u003e\n\u003cp\u003e- Hình thức lắp đặt: miễn phí lắp đặt tại nhà, hầu hết các tỉnh thành trên toàn quốc.\u003c/p\u003e\n\u003cp\u003e- Vị trí lắp đặt: Khu vực lắp đặt đủ khoảng trống không gian đặt máy.\u003c/p\u003e\n\u003cp\u003e- Nguồn điện: Điện áp đầu vào: 100-240 V AC 50/60 Hz, ổ cắm điện gần vị trí lắp đặt sản phẩm.\u003c/p\u003e\n\u003cp\u003e- Nước đầu vào được áp dụng là nước máy tiêu chuẩn, nhiệt độ nước đầu vào 5-38ºC, pH 6,5 – 8, độ đục \u0026lt;1 NTU.\u003c/p\u003e\n\u003cp\u003e- Không lắp đặt thiết bị này dưới ánh nắng trực tiếp.\u003c/p\u003e\n\u003cp\u003e- Lưu ý: Thường xuyên vệ sinh bình chứa nước (1-2 ngày/lần) để máy hoạt động tốt nhất.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eThời gian bảo hành: 12 tháng kể từ thời điểm mua hàng (ngày trên hóa đơn) hoặc kích hoạt bảo hành điện tử tùy vào thời điểm nào đến trước.\u003c/p\u003e\n\u003cp\u003eLoại hình bảo hành: Bảo hành điện tử.\u003c/p\u003e\n\u003cp\u003eĐiều kiện bảo hành: theo chính sách của hãng. Quý khách vui lòng liên hệ Hãng để biết thêm chi tiết.\u003c/p\u003e\n\u003cp\u003e(*) tùy thuộc vào chất lượng nguồn nước đầu vào\u003c/p\u003e\n\u003cp\u003e(**) tùy thuộc vào chất lượng nguồn nước đầu vào và mức độ sử dụng\u003c/p\u003e\n\u003cp\u003e(***) đối với các bộ phận tiếp xúc với nước\u003c/p\u003e\n\u003cp\u003e(****) tỉ lệ hồi nước chênh lệch phụ thuộc vào chất lượng nước đầu vào\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàn