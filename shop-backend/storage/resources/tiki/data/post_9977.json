t":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.8,"review_count":16,"review_text":"(16)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/04/f8/1f/20dec0184dd039664242c8264fa271b4.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":686,"all_time_quantity_sold":61,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eTai nghe game in-ear Logitech G333 - màn loa động kép Dual Driver, độ bền cao, 3.5mm Aux, Mic và điều khiển trên dây\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003ePhát ra âm thanh to, rõ ở bất cứ đâu. Tai nghe mang lại hiệu suất âm thanh chơi game đáng kinh ngạc, từ máy tính đến bất cứ đâu bạn muốn. Ahri yêu thích chiếc G333 với phong cách KDA cho phép cô ấy luôn đi chuyển và nâng cấp trong những cuộc chơi game\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eMÀNG LOA ĐỘNG KÉP NÂNG CẤP ĐỘ CHƠI GAME\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eG333 được thiết kế đặc biệt dành cho trải nghiệm chơi game tối ưu. Các màng loa âm thanh kép chuyên dụng, một cho âm cao/âm trung và một cho âm trầm, cung cấp âm thanh phong phú chi tiết để tái tạo chính xác thế giới game.\u003c/p\u003e\n\u003cdiv\u003e\u003csource type=\"image/webp\"\u003e\u003c/source\u003e\u003cimg class=\"WebpImg__StyledImg-sc-h3ozu8-0 fWjUGo\" src=\"https://salt.tikicdn.com/ts/tmp/e1/3b/32/847fe8255dc23baf744c259cdb738d95.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/div\u003e\n\u003cp\u003e\u003cstrong\u003eMIC TRÊN DÂY VÀ NÚT ĐIỀU KHIỂN TÍCH HỢP\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eMicrô trên dây chất lượng đem đến thông tin liên lạc và trò chuyện rõ ràng, trong khi các nút điều khiển tích hợp cho phép bạn phát, tam dừng và điều khiển âm lượng một cách liền mạch. Micrô cũng cho phép bạn giao tiếp trong trò chơi, cũng như nhận cuộc gọi khi bạn chơi game trên điện thoại của mình\u003c/p\u003e\n\u003cdiv\u003e\u003csource type=\"image/webp\"\u003e\u003c/source\u003e\u003cimg class=\"WebpImg__StyledImg-sc-h3ozu8-0 fWjUGo\" src=\"https://salt.tikicdn.com/ts/tmp/13/73/41/d6a616faa0e184a46aeef6dca7f83c0b.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/div\u003e\n\u003cdiv\u003e\u003csource type=\"image/webp\"\u003e\u003c/source\u003e\u003cimg class=\"WebpImg__StyledImg-sc-h3ozu8-0 fWjUGo\" src=\"https://salt.tikicdn.com/ts/tmp/4b/15/f0/2bd0b247630387dea2f7d8015f655fb2.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/div\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eKẾT NỐI ĐA THIẾT BỊ\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eCó thể kết nối với PC, điện thoại, Xbox, PlayStation và Nintendo với cổng 3.5mm aux. Ngoài ra, kèm hợp sẽ có một adapter type-C để giúp bạn tương thích với các thiết bị khác\u003c/p\u003e\n\u003cdiv\u003e\u003csource type=\"image/webp\"\u003e\u003c/source\u003e\u003cimg class=\"WebpImg__StyledImg-sc-h3ozu8-0 fWjUGo\" src=\"https://salt.tikicdn.com/ts/tmp/dc/c1/a9/78e4297c56606eb8a7942a1c40ee1c36.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/div\u003e\n\u003cp\u003e\u003cstrong\u003eTHOẢI MÁI TÙY CHỈNH, ĐỘ BỀN CỰC CAO\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eVới ba đầu mút silicon mềm dẻo, nằm nhẹ nhàng bên trong tai của bạn. Vỏ nhôm chắc chắn đáng tin cậy và bền với lớp hoàn tiện hấp dẫn\u003c/p\u003e\n\u003cdiv\u003e\u003csource type=\"image/webp\"\u003e\u003c/source\u003e\u003cimg class=\"WebpImg__StyledImg-sc-h3ozu8-0 fWjUGo\" src=\"https://salt.tikicdn.com/ts/tmp/86/14/5d/823f5ba8f6a04c221c2b2b4280a85fa6.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/div\u003e\n\u003cdiv\u003e\u003csource type=\"image/webp\"\u003e\u003c/source\u003e\u003cimg class=\"WebpImg__StyledImg-sc-h3ozu8-0 fWjUGo\" src=\"https://salt.tikicdn.com/ts/tmp/f1/d5/00/5ff0dd86fab87df6cd48d1e7ea921ef0.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/div\u003e\n\u003cdiv\u003e\u003csource type=\"image/webp\"\u003e\u003c/source\u003e\u003cimg class=\"WebpImg__StyledImg-sc-h3ozu8-0 fWjUGo\" src=\"https://salt.tikicdn.com/ts/tmp/ba/e5/ab/22d25a1546baca582eab3adbd1151513.png\" alt=\"\" width=\"750\" height=\"958\" /\u003e\u003c/div\u003e\n\u003cp\u003e\u003cstrong\u003eCHI TIẾT SẢN PHẨM\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eTrọng lượng: 19g (không cáp)\u003c/li\u003e\n\u003cli\u003e2 màng loa động kép: 5.8mm+9.2mm\u003c/li\u003e\n\u003cli\u003eĐộ nhạy tần số: 20HZ ~ 20KHz\u003c/li\u003e\n\u003cli\u003eTrở kháng: 24 Ohms ±20%\u003c/li\u003e\n\u003cli\u003eĐộ nhạy: 101,6±3 dB @ 1 kHz SPL\u003c/li\u003e\n\u003cli\u003eMic: 4mm ECM mic\u003c/li\u003e\n\u003cli\u003eĐộ dài cáp: 1.2mm\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/04/f8/1f/20dec0184dd039664242c8264fa271b4.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/04/f8/1f/20dec0184dd039664242c8264fa271b4.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/04/f8/1f/20dec0184dd039664242c8264fa271b4.jpg","position":null,"small_url"