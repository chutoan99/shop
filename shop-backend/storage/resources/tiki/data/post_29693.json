olor":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":6000,"discount_rate":2,"rating_average":4.7,"review_count":38,"review_text":"(38)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/4a/3e/cd/6698fc07a975589bde319e9f37d9eb73.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":719,"all_time_quantity_sold":261,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003eThùng 12 Lon Bia Budweiser (500ml / Lon)\u003c/h3\u003e\n\u003cul\u003e\u003cli\u003e\u003cem\u003e\u003cstrong\u003eBudweiser\u003c/strong\u003e \u003c/em\u003e– King of beers – là thương hiệu bia Mỹ đứng đầu thế giới được sản xuất bằng loại mạch nha cùng với hoa bia thượng hạng của Hoa Kỳ và Châu Âu.\u003c/li\u003e\n\u003cli\u003eNhững chai \u003cem\u003e\u003cstrong\u003ebia Budweiser \u003c/strong\u003e\u003c/em\u003evới vị thơm đậm đà của lúa mạch, cùng hoa bia và nước tinh khiết cùng công nghệ ủ bia bằng gỗ sồi của Budweiser đã tạo ra một hương vị bia tuyệt hảo không thể tìm thấy ở bất kì một loại bia nào khác, là sự cân bằng tuyệt đối giữa vị cay không quá nặng với vị ngọt ngào tinh tế, dịu dàng, làm người uống cảm nhận được chất lượng đỉnh cao đến trong từng hớp bia.\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e \u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cem\u003e\u003cstrong\u003eBia Budweiser \u003c/strong\u003e\u003c/em\u003eCHÍNH HÃNG\u003c/li\u003e\n\u003cli\u003eLoại bia: Lager\u003c/li\u003e\n\u003cli\u003eNồng độ cồn: 5.0%\u003c/li\u003e\n\u003cli\u003eDung tích: 500ml x 12 lon\u003c/li\u003e\n\u003cli\u003eXuất xứ: Mỹ\u003c/li\u003e\n\u003cli\u003eNơi sản xuất: Việt Nam\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eCâu chuyện thương hiệu\u003c/strong\u003e\u003cbr /\u003e\u003cbr /\u003eBudweiser có ý nghĩa là \"\"\"\"Xuất xứ từ Budweis\"\"\"\", một thị trấn của Czeck tên là Budejovice, nơi tạo ra công thức nguyên bản để nấu những mẻ bia Budweiser đầu tiên.\u003c/p\u003e\n\u003cp\u003eCâu slogan \"\"\"\"King Of Beers\"\"\"\" lần đầu được sử dụng vào năm 1898 để kỷ niệm 500 triệu chai bia Budweiser thượng hạng đầu tiên được sản xuất.\u003c/p\u003e\n\u003cp\u003eCông nghệ ủ bia trong gỗ sồi suốt 3 tuần giúp làm sạch men bia trong quá trình trưởng thành và cho ra vị bia thơm ngon độc nhất.\u003cbr /\u003eMen bia nguyên bản sử dụng nấu Budweiser được bảo quản trong hơn 139 năm nay tại Bỉ và Saint Louis (Mỹ), được rã đông mỗi năm một lần và đem đi sử dụng ở tất cả nhà máy của AB Inbev trên toàn thế giới, để cho ra đời cùng một loại bia với hương vị thơm ngon giống nhau.\u003c/p\u003e\n\u003cp\u003eBudweiser là dòng bia duy nhất được ủ với 100% năng lượng tái tạo \u0026amp; 100% lúa mạch thượng hạng của Mỹ.\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003eLưu ý: Bao bì sản phẩm có thể thay đổi theo từng đợt nhập hàng\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/4a/3e/cd/6698fc07a975589bde319e9f37d9eb73.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/4a/3e/cd/6698fc07a975589bde319e9f37d9eb73.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/4a/3e/cd/6698fc07a975589bde319e9f37d9eb73.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4a/3e/cd/6698fc07