iew_text":"(6)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/4d/a2/bb/ac298f15079c8206a04fbe127ba21e06.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":583,"all_time_quantity_sold":10,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/a4/a4/cf/42c10c946fd0129c8f5595142b169d09.png\" alt=\"\" width=\"750\" height=\"687\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cspan\u003eNhững điểm nổi bật trên Roborock Q Revo\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cp\u003eHệ thống Dock toàn năng: tự động đổ rác, tự động giặt \u0026amp; sấy khô khăn lau, tự động bổ sung nước sạch, đế sạc có thể tháo rời, sạc nhanh hơn 30%\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eLực hút mạnh 5500Pa\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eLau xoay 360 độ với lực nén mạnh lên sàn nhà\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eThiết kế chổi chính cao su chống rối hiệu quả\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eNhận diện thảm thông minh nâng lên 7mm đồng thời tăng lực hút làm sạch sâu\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eCông nghệ tránh vật cản Reactive + điều hướng LDS chính xác\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eBình chứa nước sạch lớn nhất hiện nay là 5L và bình chứa nước bẩn là 4,2L\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eĐiều khiển từ xa qua App Roborock hoặc Mi home\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg class=\"aligncenter wp-image-189877 entered lazyloaded\" src=\"https://mivietnam.vn/wp-content/uploads/2023/05/mivietnam-robot-hut-bui-lau-nha-roborock-q-revo-03.jpg\" alt=\"Những đặc điểm nổi bật trên Roborock Q Revo\" width=\"750\" height=\"854\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cspan\u003eRobot hút bụi lau nhà Roborock Q Revo sở hữu Dock đa chức năng\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eDock sạc được trang bị cho Roborock Q Revo là trạm sạc toàn năng với thiết kế tinh tế, gọn nhẹ nhưng chứa đầy đủ chức năng tiện ích. Bao gồm: tự động đổ rác, tự động giặt \u0026amp; sấy khô giẻ lau bằng khí nóng, tự động bơm nước sạch vào hộp nước, đế sạc có thể tháo rời để vệ sinh, sạc nhanh hơn 30% giúp robot nhanh chóng quay trở lại dọn dẹp các khu vực còn lại.\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/c6/11/8b/ecdfc367c7c280ed9a97b7d666a21d10.png\" alt=\"\" width=\"750\" height=\"708\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/4c/2c/a4/cd014a6109b6ddf49ed320388269ab4f.png\" alt=\"\" width=\"750\" height=\"356\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/7e/32/eb/5b6dc4e063c21541c3b0e848680766c2.png\" alt=\"\" width=\"750\" height=\"698\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/72/a9/72/f68044ea3c0d22cdebfae621459daa10.png\" alt=\"\" width=\"750\" height=\"711\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/92/b2/46/6eb26b5bd9dc16d34af412658bc07e48.png\" alt=\"\" width=\"750\" height=\"366\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan\u003e\u003cstrong\u003eRoborock Q Revo có khả năng nhận diện thảm tăng lực hút\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003eNếu trong nhà bạn có trải thảm, công nghệ phát hiện thảm siêu âm được trang bị trong \u003ca href=\"https://us.roborock.com/pages/roborock-q-revo\" target=\"_blank\" rel=\"noreferrer noopener\"\u003eRoborock Q Revo\u003c/a\u003e sẽ vô cùng hữu ích. Khi gặp thảm, nó sẽ chuyển sang chế độ hút bụi cực mạnh và tự động nâng cặp khăn lau lên 7mm mà không sợ ướt thảm hay làm thảm bị kéo rê khắp nhà.\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/cb/b1/0a/cfe8ecf377c692b36ac869cabdd2e846.png\" alt=\"\" width=\"750\" height=\"696\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan\u003e\u003cstrong\u003eBàn chải chính bằng cao su mềm thiết kế chống rối\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003eChổi cuộn được trang bị trong robot hút bụi lau nhà Roborock Q Revo sử dụng thiết kế cao su xoắn ốc cùng công nghệ chống rối bền hơn, không chỉ ít gây rối tóc mà còn làm sạch nhanh hơn.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cspan\u003eRoborock Q Revo lau nhà với cơ chế lau xoay kép cùng áp lực lớn\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eKhác với cơ chế lau rung của các dòng robot lau nhà trước đó của Roborock, Q Revo đánh dấu lần đầu tiên Roborock tham gia vào cuộc đua robot lau xoay kép với tốc độ lau 200 vòng/phút cùng với việc ép sát xuống nền nhà 1 lực nén lớn, giúp cho sàn nhà sạch hơn so với lau sàn thủ công, không chỉ tiết kiệm thời gian và công sức mà còn cải thiện đáng kể hiệu quả lau sàn.\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/08/81/86/e09c2cb97fb4fde0d870e8e81b4f97c3.png\" alt=\"\" width=\"750\" height=\"702\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan\u003e\u003cbr /\u003eLực hút mạnh mẽ 5500Pa\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003eRoborock Q Revo có lực hút siêu mạnh 5500Pa, dù là bụi mịn hay hạt lớn, robot đều có thể hút sạch bụi bẩn ngay lập tức và hút sạch chỉ trong một lần hút, lực hút mạnh cũng nâng cao hiệu quả làm sạch đáng kể.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cspan\u003eTránh vật cản chính xác với công nghệ Reactive\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/5b/ef/08/c51eb922c0988323b622852e625bda01.png\" alt=\"\" width=\"750\" height=\"376\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003eCông nghệ Reactive trang bị trên robot hút bụi thông minh Roborock Q revo cho khả năng phát hiện và tránh đồ vật trơn tru, tạm biệt việc mắc kẹt trong quá trình robot làm việc. Kể cả những đồ vật nhỏ như ổ điện, đồ chơi trẻ em, cáp sạc…\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/c0/8c/38/b0619c3a071e55b32c565da25be16936.png\" alt=\"\" width=\"750\" height=\"386\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cspan\u003eĐiều hướng LDS thông minh\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eHệ thống định vị LDS PreciSense là bộ não đằng sau khả năng phi thường của Roborock Q Revo. Hệ thống sẽ quét và tạo bản đồ chi tiết để lên lộ trình tối ưu làm sạch nhà của bạn.\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/f0/62/e5/9ee92fbe3ec98082e80e92243f7f0e0d.png\" alt=\"\" width=\"750\" height=\"683\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan\u003e\u003cstrong\u003eĐiều khiển từ xa dễ dàng qua App Roborock hoặc Mi Home\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eRoborock Q Revo \u003c/strong\u003ecó khả năng kết nối Wifi thông qua ứng dụng Mi Home hoặc Roborock, ngôn ngữ và giao diện hoàn toàn bằng Tiếng Việt mang lại trải nghiệm toàn diện cho người sử dụng. Sau khi kết nối, bạn có thể dễ dàng kiểm soát robot trong tầm tay như:\u003c/p\u003e\n\u003cp\u003e– Lập bản đồ nhanh\u003c/p\u003e\n\u003cp\u003e– Đề xuất thông minh các khu vực cấm đi\u003c/p\u003e\n\u003cp\u003e– Lập bản đồ 3D, tạo bản đồ nhiều tầng\u003c/p\u003e\n\u003cp\u003e– Tùy chỉnh khu vực làm sạch, hẹn giờ làm việc,…\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eRoborock Q Revo \u003c/strong\u003equả th