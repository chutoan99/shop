 hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ea/f3/a4/a5b0fbb31b068edd145c07e8376e3fc0.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ea/f3/a4/a5b0fbb31b068edd145c07e8376e3fc0.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ea/f3/a4/a5b0fbb31b068edd145c07e8376e3fc0.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ea/f3/a4/a5b0fbb31b068edd145c07e8376e3fc0.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ea/f3/a4/a5b0fbb31b068edd145c07e8376e3fc0.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/6e/2a/7d/7ae2576fd61ae1e04d59a04809afc651.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/6e/2a/7d/7ae2576fd61ae1e04d59a04809afc651.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/6e/2a/7d/7ae2576fd61ae1e04d59a04809afc651.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6e/2a/7d/7ae2576fd61ae1e04d59a04809afc651.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6e/2a/7d/7ae2576fd61ae1e04d59a04809afc651.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/11/f1/87/682bec0ebf114e48626e0d3d8fc4ea83.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/11/f1/87/682bec0ebf114e48626e0d3d8fc4ea83.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/11/f1/87/682bec0ebf114e48626e0d3d8fc4ea83.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/11/f1/87/682bec0ebf114e48626e0d3d8fc4ea83.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/11/f1/87/682bec0ebf114e48626e0d3d8fc4ea83.jpg"},{"base_url":"https://s