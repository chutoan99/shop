_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":137200,"discount_rate":48,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/78/2e/27/4dbc7bf104bed833b530857b82633982.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":322,"all_time_quantity_sold":10,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp class=\"irIKAp\"\u003eHộp cơm giữ nhiệt, Hộp đựng cơm văn phòng Inox 1 tầng tặng kèm đũa thìa inox Deli\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003ê  ̉ ̂̉:\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Kích thước: 22*16*7cm.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Dung tích: 640ml\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Chất liệu: Inox 304 \u0026amp; nhựa PP5 cao cấp.( an toàn cho sức khỏe )\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Tặng Kèm Đũa - Thìa\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003ê ̉ ̉ ̂̉:\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e-Hộp thiết kế gọn gàng, chắc chắn phù hợp để mang đi lại hàng ngày.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Hai lớp cách nhiệt có thể tháo rời: giữ nhiệt thức ăn lâu hơn, lại vệ sinh dễ dàng.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Chia ngăn đựng thức ăn tách riêng, sạch sẽ, không bị trộn lẫn vị, ngon miệng hơn.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Nắp có roăng cao su silicon ngăn rò rỉ nước khi mang đi đường.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e̛ Đ̂̉:\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Lõi làm bằng inox 304 không rỉ và nhựa PP cao cấp. An toàn cho sức khỏe, dễ dàng cọ rửa sau khi sử dụng\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Thiết kế sản phẩm nhỏ gọn có thể cho vào túi xách hoặc balo\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Màu sắc sang trọng, đơn giản phù hợp với mọi lứa tuổi\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Hộp cơm chia ngăn giúp thức ăn không bị lẫn vị\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Nắp hộp có gioăng chống rò rỉ nước\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Phần nắp có thể sử dụng như giá đỡ điện thoại để bạn có thể vừa thưởng thức bữa ăn, vừa xem phim hay nghe nhjac\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Vỏ hộp chất liệu từ nhựa PP an toàn cho sức khỏe mà không sợ rơi vỡ\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Khả năng chịu nhiệt cao. Có thể quay trong lò vi sóng trước khi ăn hoặc đổ nước sôi xuống đáy hộp để giữ nhiệt\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Khả năng giữ nhiệt tốt hơn khi kết hợp với túi giữ nhiệt.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- 2 lớp cách nhiệt có thể tháo rời: giữ nhiệt thức ăn lâu hơn, vệ sinh dễ dàng.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Hộp cơm thích hợp đối với dân văn phòng, học sinh, sinh viên để dễ dàng chuẩn bị một bữa cơm đầy đủ chất dinh dưỡng.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eChính sách bảo hành:\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eĐổi trả sản phẩm 1-1 trong 7 ngày kể từ khi nhận hàng với những lý do sau:\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Sản phẩm bị hư hỏng, bể vỡ, do quá trình vận chuyển.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Shop gửi sai hàng, thiếu hàng.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e*Hình ảnh chụp sẽ có sai lệch một chút so với thực tế do ánh sáng trong studio, tuy nhiên Deli cam kết chất lượng sản phẩm không thay đổi so với mô tả.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/78/2e/27/4dbc7bf104bed833b530857b82633982.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/78/2e/27/4dbc7bf104bed833b530857b82633982.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/78/2e/27/4dbc7bf104bed833b530857b82633982.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/78/2e/27/4dbc7bf104bed833b530857b82633982.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/78/2e/27/4dbc7bf104bed833b530857b82633982.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/46/b6/1d/f753a1d3c649852dadd961d84e8849da.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/46/b6/1d/f753a1d3c649852dadd961d84e8849da.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/46/b6/1d/f753a1d3c649852dadd961d84e8849da.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/46/b6/1d/f753a1d3c649852dadd961d84e8849da.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/46/b6/1d/f753a1d3c649852dadd961d84e8849da.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/fd/1a/dc/992911ceec22ae40043d86d7b11a2fac.jpg","is_gallery":true,"label":null,"large_url":"https://sa