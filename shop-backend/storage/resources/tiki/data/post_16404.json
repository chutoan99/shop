,"code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":150000,"discount_rate":45,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/dc/8d/5b/cf9e958eaeabd403930a05d8094375b5.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":616,"all_time_quantity_sold":3,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eQuý độc giả và các em học sinh thân mến!\u003c/p\u003e\n\u003cp\u003eKhoa học đã chứng minh rằng, trí thông minh, sự hiểu biết không phải tự nhiên có, tự nhiên đến, mà phải thông qua quá trình học tập, rèn luyện và trau dồi tri thức hàng ngày, hàng giờ mới có được.\u003c/p\u003e\n\u003cp\u003eVà một trong những phương pháp rèn luyện trí thông minh hiệu quả nhất chính là bắt tay ngay vào việc giải các câu đố gần gũi với cuộc sống xung quanh mình. Vì sao lại như vậy? Bởi vì, khi giải đố, ta phải trả lời các câu hỏi vừa gần, vừa xa, vừa dễ, vừa khó, nên não phải làm việc nhiều hơn, sáng tạo nhiều hơn. Chính những lúc suy nghĩ tìm tòi khám phá chính là lúc chúng ta học và ghi nhớ tốt nhất những kiến thức hữu ích từ cuộc sống xung quanh.\u003c/p\u003e\n\u003cp\u003eCombo 4 cuốn sách câu đố rèn luyện trí thông minh - tăng cường tư duy cho các em học sinh trong độ tuổi từ 6 -15 được Việt An Books biên soạn, xuất bản và phát hành không ngoài mong muốn trên.\u003c/p\u003e\n\u003cp\u003eĐiểm làm nên sự khác biệt trong combo 4 cuốn sách câu đố chính là sự kết hợp giữa trí tuệ - cảm xúc và tư duy ngôn ngữ, tư duy khoa học, cùng các giá trị văn hóa Việt, chính là nền tảng tri thức vô cùng quan trọng cho sự phát triển về nhận thức không chỉ ở hiện tại mà còn ở cả tương lai.  \u003c/p\u003e\n\u003cp\u003eCombo 4 cuốn sách giải đố tư duy\u003cstrong\u003e: Nhìn hình giải đố 100 câu thành ngữ, tục ngữ Việt Nam + Thử tài giải đố song ngữ Việt - Anh + 100 câu đố rèn luyện tư duy khám phá cuộc sống quanh ta tập 1 + 100 câu đố rèn luyện tư duy khám phá cuộc sống quanh ta tập 2.\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eVậy thì thay vì ngồi hàng giờ chơi các trò chơi điện tử, hay nhốt mình trong phòng để ngủ nướng, các em học sinh hãy rèn cho mình thói quen đọc sách để trau dồi tri thức, và làm phong phú thêm sự hiểu biết của mình nhé.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/dc/8d/5b/cf9e958eaeabd403930a05d8094375b5.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/dc/8d/5b/cf9e958eaeabd403930a05d8094375b5.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/dc/8d/5b/cf9e958eaeabd403930a05d8094375b5.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/dc/8d/5b/cf9e958eaeabd403930a05d8094375b5.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/dc/8d/5b/cf9e958eaeabd403930a05d8094375b5.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/02/cb/3c/d1ce1ddd9bb12efe1a81f3e6cb557679.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/ca