on":"any_reason"}},"discount":14000,"discount_rate":10,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/58/a0/54/e6437dd0676a913a2447edc78afe42ab.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":454,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eCánh Cửa Mở Rộng - Tôi, Charley Và Hành Trình Nước Mỹ - Trẻ - John Steinbeck\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e------------\u003c/p\u003e\u003cp\u003e\u003cbr /\u003e \u003c/p\u003e\u003ch2\u003eCánh Cửa Mở Rộng - Tôi, Charley Và Hành Trình Nước Mỹ\u003c/h2\u003e\u003cp\u003eỞ tuổi 58, sau một thời gian sống ở nước ngoài, nhà văn Mỹ đoạt giải Nobel văn học John Steinbeck quyết định tái khám phá đất nước mình. Ông lái một chiếc xe bán tải có cabin trên thùng xe, cùng con chó Charley rong ruổi khắp nước Mỹ. Đó là một hành trình gần mười ngàn dặm mà John Steinbeck gọi là hành trình \u003ci\u003e“đi tìm nước Mỹ”\u003c/i\u003e.\u003c/p\u003e\u003cp\u003eJohn Steinbeck đối diện với nhiều hoàn cảnh, sự kiện, con người trong suốt chuyến đi. Ông tìm thấy sự đa dạng của người Mỹ và phong cảnh nước Mỹ, nhưng cũng tìm cách khái quát nên những nét chung. Ông cũng phải đối diện với nhiều vấn đề của bản thân, chủ yếu là nỗi cô đơn và vấn đề sức khỏe.\u003c/p\u003e\u003cp\u003eNhà văn đã luôn đứng về phía những người lao động, đã thấy tổ quốc mình tồn tại không phải ở các địa danh mà trước hết, và quan trọng nhất, ở những con người đã lựa chọn mảnh đất này làm nơi sinh sống và, dù khác nhau, đều chỉ đang cố gắng thực hiện một hành trình tồn tại xứng đáng nhất.\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/2e/20/b1/0735c46ec49ca2cec4e287e51252b4d1.jpg\" alt=\"\" /\u003e\u003c/p\u003e\u003cp\u003e\u003cbr /\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/58/a0/54/e6437dd0676a913a2447edc78afe42ab.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/58/a0/54/e6437dd0676a913a2447edc78afe42ab.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/58/a0/54/e6437dd0676a913a2447edc78afe42ab.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/58/a0/54/e6437dd0676a913a2447edc78afe42ab.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/58/a0/54/e6437dd0676a913a2447edc78afe42ab.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/2e/20/b1/a2bf79002c790a89abaf2c9d29f0229c.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/2e/20/b1/a2bf79002c790a89abaf2c9d29f0229c.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/2e/20/b1/a2bf79002c790a89abaf2c9d29f0229c.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2e/20/b1/a2bf79002c790a89abaf2c9d29f0229c.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2e/20/b1/a2bf79002c790a89abaf2c9d29f0229c.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/d6/62/78/9d0b05db4bca00c68b8bfa8fd5fefc03.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d6/62/78/9d0b05db4bca00c68b8bfa8fd5fefc03.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d6/62/78/9d0b05db4bca00c68b8bfa8fd5fefc03.jpg","position":null,"small_url":"https://salt.tikic