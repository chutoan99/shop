alse,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":7,"review_text":"(7)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/61/22/33/0957e5b22c2ef9667f3c59084ec8490e.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1049,"all_time_quantity_sold":30,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: center;\"\u003e\u003cspan style=\"color: #ff6600;\"\u003e\u003cstrong\u003eKhai Sáng Thời Hiện Đại - Bàn Về Lý Trí, Khoa Học, Chủ Nghĩa Nhân Văn Và Tiến Bộ\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"font-weight: 400;\"\u003e\"Thế giới đang trở nên tốt đẹp hơn, ngay cả khi không phải lúc nào ta cũng cảm thấy như vậy. Tôi rất vui khi nhân loại có những nhà tư tưởng lỗi lạc như Steven Pinker để giúp chúng ta nhìn thấy bức tranh toàn cảnh. \u003c/span\u003e\u003cem\u003e\u003cspan style=\"font-weight: 400;\"\u003eKhai sáng thời hiện đại\u003c/span\u003e\u003c/em\u003e\u003cspan style=\"font-weight: 400;\"\u003e không chỉ là cuốn sách hay nhất mà Pinker từng viết. Đây là cuốn sách ưa thích mới của cuộc đời tôi.\" \u003c/span\u003e\u003cspan style=\"font-weight: 400;\"\u003e–Bill Gates\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/f1/d4/6e/d38e846683778db3849f842deaff6547.png\" alt=\"\" width=\"683\" height=\"572\" /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eChúng ta nên thay đổi suy nghĩ của mình (nếu có) rằng nhân loại đang đứng bên bờ vực. Mọi người đang sống lâu hơn, khỏe mạnh hơn, tự do hơn và hạnh phúc hơn, và các giải pháp nằm chính ở lý tưởng Khai sáng là sử dụng lý trí và khoa học.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eThế giới có thực sự tan rã? Lý tưởng tiến bộ có lỗi thời không? Trong cuốn sách này, Steven Pinker kêu gọi chúng ta lùi lại những tiêu đề đẫm máu và những lời tiên tri về sự diệt vong, vốn có tác động đến thành kiến ​​tâm lý của chúng ta. Thay vào đó, hãy theo dõi dữ liệu: Với 75 biểu đồ, Pinker cho thấy rằng cuộc sống, sức khỏe, sự thịnh vượng, an toàn, hòa bình, kiến ​​thức và hạnh phúc đang gia tăng, không chỉ ở phương Tây mà còn trên toàn thế giới. Sự tiến bộ này không phải là kết quả của một thế lực vũ trụ nào đó mà là một món quà của Khai sáng: niềm tin rằng lý trí và khoa học có thể nâng cao sự hưng thịnh của con người.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eKhác xa với một hy vọng ngây thơ, Lý tưởng Khai sáng giờ đây đã phát huy tác dụng. Nhưng hơn bao giờ hết, nó cần một hàng thủ vững chắc. Khai sáng chống lại các dòng chảy của bản chất con người – chủ nghĩa bộ tộc, chủ nghĩa độc tài, ma quỷ hóa, tư duy ma thuật – những thứ mà các nhà ma thuật đều quá sẵn sàng khai thác. \u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eVới chiều sâu trí tuệ, cuốn sách lý giải cặn kẽ về lý trí, khoa học và chủ nghĩa nhân văn: những lý tưởng mà chúng ta cần để đối đầu với các vấn đề của mình và tiếp tục tiến bộ.\u003c/span\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/61/22/33/0957e5b22c2ef9667f3c59084ec8490e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/61/22/33/0957e5b22c2ef9667f3c59084ec8490e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/61/22/33/0957e5b22c2ef9667f3c59084ec8490e.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/61/22/33/0957e5b22c2ef9667f3c59084ec8490e.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/61/22/33/0957e5b22c2ef9667f3c59084ec8490e.jpg"}],"warranty_policy":null,"authors":[{"id":114114,"name":"Steven Pinker","slug":"steven-pinker"}],"current_seller":{"id":130987,"sku":"3713763764582","name":"Moonshine Shop","link":"https://tiki.vn/cua-hang/moonshine-shop","logo":"07/b0/e1/607afc4ad1a4c9ccf3e43a37a5221ef2.jpg","price":265000,"product_id":"144252102","store_id":121005,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[{"id":34429,"name":"NewShop Official","link":"https://tiki.vn/cua-hang/newshopvn","logo":"dd/11/6e/71249ce7a46a63c6cf803c6169450ac6.jpg","price":347130,"product_id":"142900489","store_id":33717},{"id":126688,"name":"info book","link":"https://tiki.vn/cua-hang/info-book","logo":"66/49/ce/c528ff3a6e4022b080c1f8c6fe7bc541.jpg","price":359000,"product_id":"147422831","store_id":117060},{"id":57167,"name":"Nhà sách NetaBooks","link":"https://tiki.vn/cua-hang/nha-sach-netabooks","logo":"33/f2/97/e245fe4d226f0e26fb1cc7ba3741d661.jpg","price":339150,"product_id":"153891912","store_id":54106},{"id":281062,"name":"Bamboo Books","link":"https://tiki.vn/cua-hang/bamboo-books","logo":"46/9a/b3/e4fbfd97e7607ea4d2ff8e9ad769121b.jpg","price":339150,"product_id":"177858890","store_id":268132},{"id":295057,"name":"HỆ THỐNG NHÀ SÁCH ABC","link":"https://tiki.vn/cua-hang/he-thong-nha-sach-abc","logo":"98/3d/ff/cec0ba0eaa575634616ab4605fccbe6d.jpg