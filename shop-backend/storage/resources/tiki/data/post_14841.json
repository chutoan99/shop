0,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/bf/6b/65/d4a3c79bbb6e6f9d7d952d6eccd88fbf.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1681,"all_time_quantity_sold":3,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/02/58/db/1945cbf9022ae3a602ccbefd703b148a.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eSữa rửa mặt trị mụn Naris Acmedica Acne Care Wash là sản phẩm sữa rửa mặt dạng bọt được cấu tạo từ các thành phần làm sạch và kháng viêm kết hợp cùng khoáng chất giúp loại bỏ bụi bẩn, tế bào chết, điều tiết bã nhờn, thông thoáng lỗ chân lông, ngăn ngừa và trị mụn trứng cá hiệu quả đồng thời cung cấp độ ẩm và làm sáng da. Sản phẩm giúp giảm sự hình thành mụn đầu đen, mụn đầu trắng, nếp nhăn, tàn nhang, cải thiện làn da khô, mang đến làn da láng sạch, mịn màng và trắng sáng. \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/ae/34/5f/f9016db7c944f7066624582e36e89fcf.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eHướng dẫn bảo quản\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eLàm ướt mặt\u003c/li\u003e\n\u003cli\u003eLấy một lượng vừa đủ vào lòng bàn tay, tạo bọt và massage nhẹ nhàng trên da trong khoảng 3 - 5 phút\u003c/li\u003e\n\u003cli\u003eRửa sạch với nước\u003c/li\u003e\n\u003cli\u003eBảo quản nơi khô ráo, thoáng mát, tránh ánh nắng trực tiếp và nhiệt độ cao\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eThông tin thương hiệu\u003c/p\u003e\n\u003cp\u003eNăm 1932, xuất phát từ trăn trở về một thương hiệu mỹ phẩm “đem lại sự an toàn tuyệt đối cho người sử dụng”, bác sĩ, tiến sĩ da liễu đông y tại thành phố Osaka – miền Nam nước Nhật đã cho ra đời công ty Naris Cosmetics chuyên cung cấp các dòng mỹ phẩm dưỡng da và trang điểm chất lượng. Cho đến nay, mỹ phẩm Naris đã có mặt trên khắp thế giới, từ châu Á đến châu Âu, châu Úc hay châu Mỹ. Naris luôn là cái tên được ưa chuộng và là sự lựa chọn hàng đầu của những người yêu cái đẹp với phương châm “Naris – bí quyết để giữ và duy trì làn da khỏe đẹp”.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/bf/6b/65/d4a3c79bbb6e6f9d7d952d6eccd88fbf.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/bf/6b/65/d4a3c79bbb6e6f9d7d952d6eccd88fbf.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/bf/6b/65/d4a3c79bbb6e6f9d7d952d6eccd88fbf.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/bf/6b/65/d4a3c79bbb6e6f9d7d952d6eccd88fbf.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/bf/6b/65/d4a3c79bbb6e6f9d7d952d6eccd88fbf.png"},{"base_url":"https://salt.tikicdn.com/ts/product/f8/09/09/fda7d670a27645335b2cac6da5c1ad24.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f8/09/09/fda7d670a27645335b2cac6da5c1ad24.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/