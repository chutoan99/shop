t":"9.9"},{"placement":"pdp_badge","code":"is_hero","type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":true,"return_reason":"any_reason"}},"discount":609000,"discount_rate":30,"rating_average":4.7,"review_count":1403,"review_text":"(1403)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/8b/27/65/795b26f767fb55c100ac5ebcecbcdd72.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1786,"all_time_quantity_sold":5895,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003eMàu trắng trẻ trung, tươi sáng, thiết kế giống hình bình nước gọn đẹp\u003c/h3\u003e\n\u003cdiv\u003e\n\u003cp\u003e\u003cstrong\u003eMáy Làm Sữa Hạt Đa Năng Bluestone SMB-7329 (1.3 Lít) \u003c/strong\u003e thiết kế giống hình bình nước gọn đẹp, tiện sử dụng. Dung tích 1.3 lít chế biến được lượng nguyên liệu lớn cùng lúc, đáp ứng nhu cầu của gia đình có 3 - 5 thành viên.\u003cbr /\u003e\u003cbr /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/81/fe/ad/d15bf549ad14f7928c5fb166a1d4ec84.jpg\" alt=\"Máy Làm Sữa Hạt Đa Năng Bluestone SMB-7329 (1.3 Lít) - Hàng Chính Hãng\" width=\"750\" height=\"748\" /\u003e\u003c/p\u003e\n\u003ch3\u003eMáy làm sữa đậu nành có bảng điều khiển nút nhấn với chỉ dẫn tiếng Việt dễ hiểu, đèn tín báo tiện quan sát cho việc tùy chỉnh menu nấu tự động thêm chính xác\u003c/h3\u003e\n\u003cp\u003eSản phẩm các chế độ nấu tự động được tích hợp sẵn gồm làm sữa đậu, ngũ cốc, đậu khô/ngâm, cháo dinh dưỡng, đậu hũ, trà, sinh tố, giữ ấm cùng chế độ làm sữa nhanh giúp chị em chế biến món ăn đa dạng, tiện lợi hơn.\u003cbr /\u003e\u003cbr /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/47/07/d7/d9254adb30c96c6410e691d7a2f8f7a3.jpg\" alt=\"Máy Làm Sữa Hạt Đa Năng Bluestone SMB-7329 (1.3 Lít) - Hàng Chính Hãng\" width=\"750\" height=\"748\" /\u003e\u003cbr /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/f9/a8/54/91c10be3ebb6e664629597ce64171b92.jpg\" alt=\"Máy Làm Sữa Hạt Đa Năng Bluestone SMB-7329 (1.3 Lít) - Hàng Chính Hãng\" width=\"750\" height=\"748\" /\u003e\u003c/p\u003e\n\u003ch3\u003eThân bình dày 2 lớp với vỏ ngoài bằng nhựa tốt, ruột bình bằng inox 304 độ bền cao, an toàn cho sức khỏe, dễ chùi rửa\u003c/h3\u003e\n\u003cp\u003eCông suất 1000 W, lưỡi dao và cán dao làm bằng chất liệu inox 304 cứng chắc, sắc bén, xay nhuyễn nguyên liệu nhanh chóng\u003c/p\u003e\n\u003cp\u003eMang đến cho bạn cốc sữa đậu nành thơm ngon chỉ trong 17 phút.\u003cbr /\u003e\u003cbr /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/2e/8a/7c/6638078a5eb625e3859f8e139786024f.jpg\" alt=\"Máy Làm Sữa Hạt Đa Năng Bluestone SMB-7329 (1.3 Lít) - Hàng Chính Hãng\" width=\"750\" height=\"748\" /\u003e\u003c/p\u003e\n\u003ch3\u003eSử dụng an toàn với 6 chế độ bảo vệ\u003c/h3\u003e\n\u003cp\u003eGồm chống tràn, tự ngắt điện, tự động giảm áp lực, ngưng hoạt động khi máy không có nước, ngưng hoạt động khi nhiệt độ quá cao, ngăn nước vào động cơ. Nhờ đó kéo dài tuổi thọ cho máy, bảo vệ người dùng tối đa.\u003c/p\u003e\n\u003cp\u003eMáy làm sữa đậu nành Bluestone SMB-7329 1.3 lít, sản phẩm đa năng, chế biến thực phẩm tiện lợi, giá tiêu dùng tốt, lựa chọn đúng đắn cho gia đình Việt.\u003cbr /\u003e\u003cbr /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/c0/6d/39/cf06c9715c0499a5b4f48794ed8a8293.jpg\" alt=\"Máy Làm Sữa Hạt Đa Năng Bluestone SMB-7329 (1.3 Lít) - Hàng Chính Hãng\" width=\"750\" height=\"748\" /\u003e\u003c/p\u003e\n\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/8b/27/65/795b26f767fb55c100ac5ebcecbcdd72.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/8b/27/65/795b26f767fb55c100ac5ebcecbcdd72.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/8b/27/65/795b26f767fb55c100ac5ebcecbcdd72.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8b/27/65/795b26f767fb55c100ac5ebcecbcdd72.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8b/27/65/795b26f767fb55c100ac5ebcecbcdd72.jpg"},{"base_url":"https://salt.tikicdn.com/media/catalog/producttmp/6e/b7/c8/e15b159a75185ae90c9642a58b54ccec.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/producttmp/6e/b7/c8/e15b159a75185ae90c9642a58b54ccec.png","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/producttmp/6e/b7/c8/e15b159a75185ae90c9642a58b54ccec.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/producttmp/6e/b7/c8/e15b159a75185ae90c9642a58b54ccec.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/