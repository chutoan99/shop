ác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/25/78/67/e269a02392c1f469e767b1733f3ab791.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/25/78/67/e269a02392c1f469e767b1733f3ab791.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/25/78/67/e269a02392c1f469e767b1733f3ab791.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/25/78/67/e269a02392c1f469e767b1733f3ab791.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/25/78/67/e269a02392c1f469e767b1733f3ab791.png"},{"base_url":"https://salt.tikicdn.com/ts/product/45/46/e0/e3b8bbe5164fbff18e8399663fde29cb.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/45/46/e0/e3b8bbe5164fbff18e8399663fde29cb.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/45/46/e0/e3b8bbe5164fbff18e8399663fde29cb.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/45/46/e0/e3b8bbe5164fbff18e8399663fde29cb.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/45/46/e0/e3b8bbe5164fbff18e8399663fde29cb.png"},{"base_url":"https://salt.tikicdn.com/ts/product/30/a0/13/1a6ac99fa2789f698507c2ad12d3f369.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/30/a0/13/1a6ac99fa2789f698507c2ad12d3f369.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/30/a0/13/1a6ac99fa2789f698507c2ad12d3f369.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/30/a0/13/1a6ac99fa2789f698507c2ad12d3f369.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/30/a0/13/1a6ac99fa2789f698507c2ad12d3f369.png"},{"base_url":"https://salt.tikicdn.com/ts/product/f0/c3/98/0758c5679752d9be6e04e0a7b56dd76