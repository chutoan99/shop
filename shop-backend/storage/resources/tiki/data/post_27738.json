60/d8/e4b4e59009cb5762b27dd1321dbab888.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/91/60/d8/e4b4e59009cb5762b27dd1321dbab888.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/91/60/d8/e4b4e59009cb5762b27dd1321dbab888.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/91/60/d8/e4b4e59009cb5762b27dd1321dbab888.png"}],"warranty_policy":null,"brand":{"id":577673,"name":"UNIE","slug":"unie"},"current_seller":{"id":238957,"sku":"4573765791828","name":"UNIE Official Store","link":"https://tiki.vn/cua-hang/unie-official","logo":"https://vcdn.tikicdn.com/ts/seller/bf/0c/10/7cad6b6f0ecd3cb2be68306063eb32f6.jpg","price":2990000,"product_id":"274363589","store_id":225989,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Content","attributes":[{"code":"brand","name":"Thương hiệu","value":"UNIE"},{"code":"brand_country","name":"Xuất xứ thương hiệu","value":"Việt Nam"},{"code":"capacity","name":"Dung tích","value":"1.75L"},{"code":"cong_suat","name":"Công suất","value":"1800W"},{"code":"dimensions","name":"Kích thước","value":"\u003carticle class=\"4ever-article\"\u003e\n\u003cp\u003eSở hữu lưỡi dao inox 304 sắc bén, kết hợp tốc độ quay 84.000 vòng/ phút đã đưa Unie V9S trở thành “tân binh” máy làm sữa hạt mạnh mẽ số 1 thị trường. V9S sẽ mang tới cho bạn và cả gia đình những ly sữa hạt thơm ngon, sánh mịn, giàu dinh dưỡng chỉ với 10 – 30 phút mỗi ngày.\u003c/p\u003e\n\u003cp\u003eƯU ĐIỂM NỔI BẬT CỦA MÁY LÀM SỮA HẠT UNIE V9S\u003c/p\u003e\n\u003cp\u003eLưỡi dao inox 304 siêu sắc bén\u003c/p\u003e\n\u003cp\u003eSữa càng sánh mịn, uống càng thơm ngon, chính vì vậy lưỡi dao là điểm quan trọng và được rất nhiều người dùng quan tâm khi lựa chọn máy làm sữa hạt.\u003c/p\u003e\n\u003cp\u003eUnie V9S được trang bị lưỡi dao inox 304 được mài dũa sắc bén giúp xay nhuyễn mịn mọi thực phẩm từ cứng đến mềm như: Các loại hạt, đá viên, thịt, cá, hoa quả,….\u003c/p\u003e\n\u003cp\u003eKết hợp cùng động cơ 1800W cho khả năng xay nhuyễn hơn đến 20%, mang đến những ly sữa hạt thơm ngon, sánh mịn, dinh dưỡng.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://cf.shopee.vn/file/sg-11134202-22090-qaxk2oe4wyhv76\" alt=\"sg-11134202-22090-qaxk2oe4wyhv76\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eCông nghệ sấy khô khử khuẩn – An toàn tuyệt đối\u003c/p\u003e\n\u003cp\u003eMột trong những tính năng mới của V9S với các sản phẩm máy làm sữa hạt khác của Unie là được trang bị thêm công nghệ sấy khô khử khuẩn. Với tính năng này, sau mỗi lần sử dụng, bạn chỉ cần nhấn vào nút “Sấy khô khử khuẩn” trên bảng điều khiển là máy tự kích hoạt một chu kỳ Sấy – khử khuẩn tiêu chuẩn.\u003c/p\u003e\n\u003cp\u003eCông nghệ này giúp V9S luôn được vệ sinh cẩn thận, khô ráo, hạn chế tối đa sự sinh sôi của vi khuẩn trong môi trường ẩm ướt.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://cf.shopee.vn/file/58408f737a9e9c407deaa3f4c22d4d73\" alt=\"58408f737a9e9c407deaa3f4c22d4d73\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eTính năng tạm dừng tiện lợi\u003c/p\u003e\n\u003cp\u003eMáy làm sữa hạt Unie V9S được nâng cấp thêm tính năng TẠM DỪNG giúp bạn dễ dàng thêm nguyên liệu trong lúc máy đang xay nấu. \u003c/p\u003e\n\u003cp\u003eTính năng tăng thêm sự tiện lợi và an toàn cho người sử dụng trong quá trình nấu sữa/ cháo,… đang nóng. Bạn có thể an tâm cho thêm nước, đường hay các loại hạt trong lúc sữa đang nấu rất nóng mà không lo bị bỏng hoặc bị bắn bột lên người.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eNắp chống trào thông minh thế hệ mới\u003c/p\u003e\n\u003cp\u003eUnie V9S sở hữu nắp chống trào với gioăng silicon 5 lớp thông minh tăng khả năng chống trào lên gấp 5 lần. Với nắp chống trào này, dù bạn nấu sữa hạt, các món cháo hay súp nóng cũng không cần lo lắng vấn đề thực phẩm sôi, trào ra ngoài cối máy gây nguy hiểm hay mất vệ sinh, khó cọ rửa.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eCối thuỷ tinh Borosilicate siêu chịu lực, chịu nhiệt\u003c/p\u003e\n\u003cp\u003eLớp 1: Kính cường lực\u003c/p\u003e\n\u003cp\u003eLớp 2: Lớp Peptide Protein Nano\u003c/p\u003e\n\u003cp\u003eLớp 3: Lớp chống oxi hoá\u003c/p\u003e\n\u003cp\u003eLớp 4: Các nguyên tố vi lượng\u003c/p\u003e\n\u003cp\u003eLớp 5: Lớp hoạt hoá phân tử nước\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eVới nguyên lý hoạt động đặc biệt: Xay – đun nấu ở nhiệt độ cao nên toàn bộ phần cối máy làm sữa hạt Unie V9S được làm bằng thuỷ tinh Borosilicate 5 lớp cho khả năng chịu lực, chịu nhiệt lên đến 400 độ C. Từ đó, giúp đảm bảo an toàn, không sinh chất độc hại trong quá trình xay nấu hay gây ra phản ứng hoá học với thực phẩm.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e8 chương trình nấu chuyên sâu đã được lập trình sẵn\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eMáy được trang bị 8 chương trình nấu chuyên sâu đã được lập trình sẵn thời gian, chế độ đun, xay, nấu bao gồm: Sữa thảo mộc, sữa h\u003c/p\u003e\n\u003cp\u003eạt nấu chậm, sữa không nấu, nấu chậm, sinh tố/xay khô, cháo dinh dưỡng, cháo nguyên hạt, hấp/hầm.\u003c/p\u003e\n\u003cp\u003eNgoài ra còn có các chức năng như sấy khô khử khuẩn, giữ ấm, hẹn giờ, tạm dừng giúp người nội trợ nấu nướng nhanh, tiện hơn. Đặc biệt chức năng TẠM DỪNG giúp bạn có thể thoải mái thêm nguyên liệu nấu sữa như cốt dừa, lá dứa hay đường,.. dễ dàng và an toàn hơn.\u003c/p\u003e\n\u003cp\u003eThiết kế hiện đại, sang trọng\u003c/p\u003e\n\u003cp\u003eMáy làm sữa hạt Unie V9S gây ấn tượng với thiết kế tối giản nhưng không kém phần sang trọng. Thân máy bo tròn các góc kết hợp màu xám bạc vừa tinh tế, vừa hiện đại, phù hợp đặt ở mọi nơi trong căn bếp.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://cf.shopee.vn/file/sg-11134202-22090-ra2rdyk5wyhvf8\" alt=\"sg-11134202-22090-ra2rdyk5wyhvf8\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://cf.shopee.vn/file/016bc5ef3127b8173a9614c0ed054765\" alt=\"016bc5ef3127b8173a9614c0ed054765\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://cf.shopee.vn/file/f11fb0f7b59fa00714a2f20ad632d4ee\" alt=\"f11fb0f7b59fa00714a2f20ad632d4ee\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eThông số kỹ thuật của Unie V9s\u003c/p\u003e\n\u003cp\u003eThương hiệu: Unie\u003c/p\u003e\n\u003cp\u003eMã sản phẩm: V9S\u003c/p\u003e\n\u003cp\u003eMàu sắc: Xám bạc, đen ánh xanh\u003c/p\u003e\n\u003cp\u003eĐiện áp: 220V/50Hz\u003c/p\u003e\n\u003cp\u003eCông suất xay: 1000W\u003c/p\u003e\n\u003cp\u003eCông suất nấu: 800W\u003c/p\u003e\n\u003cp\u003eDung tích: 1.75L\u003c/p\u003e\n\u003cp\u003eTrọng lượng: 5.4kg\u003c/p\u003e\n\u003cp\u003eKích thước: 420x250x320mm\u003c/p\u003e\n\u003cp\u003eBảo hành: 24 tháng\u003c/p\u003e\n\u003c/article\u003e"},{"code":"function","name":"Tính năng","value":"Xay nấu đa năng"},{"code":"inside_material","name":"Chất liệu ruột bình","value":"Thủy tinh chịu lực chịu nhiệt"},{"code":"knife_material","name":"Chất liệu lưỡi dao","value":"inox 304 cao cấp nhất"},{"code":"origin","name":"Xuất xứ (Made in)","value":"Trung Quốc"},{"code":"outside_material","name":"Chất liệu vỏ bình","value":"Thủy tinh chịu lực chịu nhiệt"}]},{"name":"Operation","attributes":[{"code":"is_warranty_applied","name":"Sản phẩm có được bảo hành không?","value":"Không"}]}],"product_links":[],"gift_item_title":"0 quà tặng kèm","services_and_promotions":[],"promitions":[],"stock_item":{"max_sale_qty":1000,"min_sale_qty":1,"preorder_date":null,"qty":1000},"quantity_sold":{"text":"Đã bán 3","value":3},"categories":{"id":2025,"name":"Máy làm sữa đậu nành","is_leaf":true},"breadcrumbs":[{"url":"/dien-gia-dung/c