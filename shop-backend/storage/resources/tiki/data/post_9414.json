20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":40880,"discount_rate":28,"rating_average":4,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/07/c3/c2/e41b006570b2993fcd2edcaeb81aeeb3.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":59,"all_time_quantity_sold":16,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp class=\"QN2lPu\"\u003eCombo Bài Tập Tiếng Anh 9 + Ngữ Pháp Và Bài Tập Thực Hành Tiếng Anh 9 (Bám Sát SGK I-Learn Smart World) (Bộ 2 Cuốn)\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e \u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e1. Bài Tập Tiếng Anh 9 - Không Đáp Án (Bám Sát SGK Cánh Diều I-Learn Smart World)\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e \u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eCuốn sách “Bài tập Tiếng Anh 9 – Dùng kèm SGK Tiếng Anh 9” được biên soạn dựa trên sách Tiếng Anh 9 i-learn Smart World nằm trong bộ sách giáo khoa của Bộ Giáo dục và Đào tạo.\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e \u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eSách bao gồm rất nhiều dạng bài tập bám sát các chủ đề trong chương trình Tiếng Anh lớp 9 như: English in the World; Life in the Past; Living Environment; Tourism; Healthy Living; Natural wonders; Urban Life; Jobs in the Future,… nhằm giúp các em học sinh ôn luyện các kĩ năng về ngôn ngữ, phát triển vốn từ vựng, củng cố kiến thức ngữ pháp, cũng như nâng cao các kĩ năng phát âm, đọc, nói, và viết.\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e \u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eCác bài tập trong mỗi đơn vị bài học được bố cục theo từng phần rõ ràng như sau:\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e \u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eA. Pronunciation: Bao gồm các bài tập về kĩ năng phát âm\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e \u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eB. Vocabulary: Bao gồm các bài tập về từ vựng\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e \u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eC. Grammar: Bao gồm các bài tập về ngữ pháp\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e \u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eD. Speaking: Bao gồm các bài tập về kĩ năng nói\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e \u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eE. Reading: Bao gồm các bài tập về kĩ năng đọc hiểu\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e \u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eF. Writing: Bao gồm các bài tập về kĩ năng viết\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e \u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eNgoài ra, cuốn sách còn có phần Tự kiểm tra (Test yourself) ở cuối của bài học và các phần ôn tập giữa kì và cuối kì. Các phần này sẽ giúp các em học sinh tự kiểm tra lại những nội dung kiến thức mà mình đã học để kịp thời củng cố những kiến thức còn chưa nắm vững.\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e \u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eHy vọng cuốn sách này sẽ giúp các em tăng thêm niềm hứng thú và sự say mê học tập tiếng Anh, giúp các em có thêm nguồn động lực để tự tin phát triển tốt năng lực tiếng Anh, đồng thời chuẩn bị kiến thức vững chắc để làm tốt các bài kiểm tra tiếng Anh định kì cũng như các kì thi chứng chỉ quốc tế.\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e \u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eCông ty phát hành Nhà Sách Hồng Ân\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eTác Giả Nguyễn Hoàng Thanh Ly | Nguyễn Văn Hai\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eNăm Xuất Bản 2024\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eKích Thước 19 x 27 cm\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eNhà Xuất bản Đại Học Quốc Gia Hà Nội\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eSố Trang 147\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eBìa Mềm\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e \u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e2. Ngữ Pháp Và Bài Tập Thực Hành Tiếng Anh 9 (Bám Sát SGK I-Learn Smart World)\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e \u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eCuốn sách \"NGỮ PHÁP VÀ BÀI TẬP THỰC HÀNH TIẾNG ANH 9\" được biên soạn dựa theo SGK Tiếng Anh 9 (i-learn Smart World 9).\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e \u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eSách bao gồm nhiều chủ điểm ngữ pháp và bài tập thực hành để các em học tập, rèn luyện và trau dồi kiến thức ngữ pháp tiếng Anh. Các chủ điểm ngữ pháp bám sát nội dung trong sách giáo khoa, ngoài ra còn được mở rộng thêm để các em nắm vững hơn về cách dùng động từ nguyên mẫu có to (to-infinitive); Cụm động từ (Phrasal verb); Mệnh đề trạng ngữ/cụm trạng ngữ chỉ lý do (Adverbial clauses/phrases of reason); Ôn tập về cách dùng “Would”; Cách dùng “Used to”; Mệnh đề quan hệ xác định (defining relative clause) với đại từ quan hệ.; Cách dùng “wish” với thì quá khứ đơn (past simple); Câu tường thuật (Reported speech); Cách dùng “could” và các từ hỏi (wh-words) trước to-infinitive; Cách dùng suggest + gerund (danh động từ); Mệnh đề trạng ngữ/cụm từ chỉ sự nhượng bộ; Cấu trúc so sánh hơn với các từ nhấn mạnh; Cách dùng cấu trúc động từ + danh động từ (verb + gerund); Cách dùng mệnh đề quan hệ không xác định; Thì quá khứ tiếp diễn (Past Continuous); Cách dùng các mệnh đề trạng ngữ chỉ kết quả (adverbial clauses of result); Câu điều kiện loại 1 với động từ khiếm khuyết (First Conditional with modal verbs); Cách dùng cấu trúc “Động từ + to infinitive”.\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e \u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eBên cạnh việc giải thích kỹ càng các kiến thức ngữ pháp, sách còn đưa vào nhiều ví dụ minh họa và các dạng bài tập phù hợp để các em thực hành. Việc rèn luyện các bài tập này là vô cùng hữu ích bởi nó không những giúp các em sử dụng thành thạo các cấu trúc ngữ pháp mà còn giúp các em tự tin để đạt điểm tốt hơn trong các bài kiểm tra định kì.\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/cc/71/94/c5d6307268fb8101fb98fac07284cd3c.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/07/c3/c2/e41b006570b2993fcd2edcaeb81aeeb3.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/07/c3/c2/e41b006570b2993fcd2edcaeb81aeeb3.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/07/c3/c2/e41b006570b2993fcd2edcaeb81aeeb3.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/07/c3/c2/e41b006570b2993fcd2edcaeb81aeeb3.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/07/c3/c2/e41b006570b2993fcd2edcaeb81aeeb3.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/cc/71/94/0235d559d7ba1a58a4899c72980a2a2c.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/cc/71/94/0235d559d7ba1a58a4899c72980a2a2c.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/cc/71/94/0235d559d7ba1a58a4899c72980a2a2c.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/cc/71/94/0235d559d7ba1a58a4899c72980a2a2c.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/cc/71/94/0235d559d7ba1a58a4899c72980a2a2c.jpg"},{"base_url":"https: