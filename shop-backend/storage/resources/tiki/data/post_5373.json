,"href":null,"text":"9.9"},{"placement":"pdp_badge","code":"is_hero","type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"freeship_xtra","type":"pdp_icon_badge","index":2,"icon":"https://salt.tikicdn.com/ts/upload/be/67/48/04a82ab8df178e1a13bde38316081865.png","icon_width":91,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":true,"return_reason":"any_reason"}},"discount":250000,"discount_rate":43,"rating_average":4.8,"review_count":287,"review_text":"(287)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/45/30/89/0830a6b493ed2ac287ceb6f35e0cf549.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1162,"all_time_quantity_sold":30474,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003eThiết kế hiện đại, tiết kiệm diện tích\u003c/h3\u003e\n\u003cp\u003e\u003cstrong\u003eẤm siêu tốc Elmich Smartcook ICS-3859\u003c/strong\u003e sở hữu kiểu dáng nhỏ gọn, đường nét bắt mắt, tông màu trang nhã mang màu sắc sang trọng gây ấn tượng mạnh mẽ với người nhìn, tạo điểm nhấn cho không gian sử dụng. Sản phẩm phù hợp với nhiều không gian bếp khác nhau.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/c4/73/a1/9a0388e8a19fc941bdcaa9a28b96b4f1.jpg\" width=\"750\" height=\"750\" alt=\"9a0388e8a19fc941bdcaa9a28b96b4f1.jpg\" /\u003e\u003c/p\u003e\n\u003ch3\u003eCông suất 1850W\u003c/h3\u003e\n\u003cp\u003eẤm siêu tốc ICS-3859 có công suất mạnh mẽ 1850W giúp nước được đun sôi nhanh chóng và hiệu quả. Nhờ công suất lớn, người dùng có thể lấy nước trong ấm siêu tốc để sử dụng mà không mất quá nhiều thời gian và công sức.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/1f/6f/62/ffa8ea35ad3d033eb6428d52950d82c5.png\" width=\"750\" height=\"818\" alt=\"ffa8ea35ad3d033eb6428d52950d82c5.png\" /\u003e\u003c/p\u003e\n\u003ch3\u003eDung tích 1.7 lít\u003c/h3\u003e\n\u003cp\u003eBình đun siêu tốc ICS-3859 có dung tích 1.7 lít đáp ứng nhu cầu của đại đa số người tiêu dùng, phù hợp với nhu cầu sử dụng hàng ngày trong gia đình có từ 4 – 5 thành viên, hoặc dùng cho công sở, văn phòng.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/be/a8/2e/b2906e98e091fa19c2a9c85d4d74aa27.png\" width=\"750\" height=\"696\" alt=\"b2906e98e091fa19c2a9c85d4d74aa27.png\" /\u003e\u003c/p\u003e\n\u003ch3\u003eChất liệu cao cấp\u003c/h3\u003e\n\u003cp\u003eẤm được làm bằng chất liệu thủy tinh Borosilicate glass giúp bạn vừa dễ dàng quan sát nước trong ấm vừa nâng tầm thẩm mỹ cho sản phẩm. Chất liệu thủy tinh Borosilicate glass thường được dùng trong thiết bị y tế vừa giúp ấm siêu tốc giữ nhiệt lâu hơn, độ bền cao, không sản sinh các chất độc hại, đảm bảo an toàn cho sức khỏe và người dùng có thể dễ dàng vệ sinh sau khi sử dụng.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/51/80/4c/b307dc664d372e04d09a5a77d55950d0.png\" width=\"750\" height=\"938\" alt=\"b307dc664d372e04d09a5a77d55950d0.png\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/13/73/54/a8fa521ca6fcf7ca00c14ba63c442f02.png\" width=\"750\" height=\"802\" alt=\"a8fa521ca6fcf7ca00c14ba63c442f02.png\" /\u003e\u003c/p\u003e\n\u003cp\u003ePhần đáy ấm được làm bằng inox 304 với khả năng chống oxy hóa và an toàn với sức khỏe khi đun nước ở nhiệt độ cao, đảm bảo sức khỏe cho người sử dụng.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/d6/69/fe/022cb121369fc9f5a50dfadd2f77689b.png\" width=\"750\" height=\"851\" alt=\"022cb121369fc9f5a50dfadd2f77689b.png\" /\u003e\u003c/p\u003e\n\u003ch3\u003eThang hiển thị mực nước\u003c/h3\u003e\n\u003cp\u003eThang hiển thị mực nước được thiết kế tinh tế ở thân ấm, có dấu mực nước Min, Max cụ thể giúp người dùng tiện theo dõi lượng nước để tránh quá ít nước hay quá nhiều nước đều ảnh hưởng không tốt đến sản phẩm và kém an toàn sử dụng.\u003c/p\u003e\n\u003ch3\u003eLưới lọc cặn\u003c/h3\u003e\n\u003cp\u003eẤm siêu tốc Elmich Smartcook được thiết kế lưới chống cặn đặc biệt ngay ở nắp ấm, từ đó khi nước rót ra sẽ lọc được cặn lại và ngăn các loại côn trùng như: muỗi, kiến, bọ không bị lọt vào ấm cũng như ngăn lại cặn bẩn, giữ cho nước luôn sạch và đảm bảo vệ sinh khi sử dụng.\u003c/p\u003e\n\u003ch3\u003eThân ấm xoay 360 độ linh hoạt trên đế tiếp điện\u003c/h3\u003e\n\u003cp\u003eĐiểm đặc biệt của bình đun siêu tốc Elmich ICS-3859 đó chính là đế tiếp điện cao cấp siêu bền. Thân ấm có thể xoay 360 độ linh hoạt trên đế tiếp điện giúp người dùng có thể dụng dễ dàng nhấc và đặt bình lên xuống, mang lại sự thuận tiện khi sử dụng.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/fa/c8/b8/aa648640802c29f7c040184bbcce50f7.png\" width=\"750\" height=\"836\" alt=\"aa648640802c29f7c040184bbcce50f7.png\" /\u003e\u003c/p\u003e\n\u003ch3\u003eChế độ an toàn\u003c/h3\u003e\n\u003cp\u003eSử dụng bình đun siêu tốc Elmich Smartcook ICS-3859 an toàn hơn với chế độ tự ngắt khi nước sôi hoặc khi cạn nước giúp bảo vệ thiết bị khỏi cháy nổ, giúp ấm bền tốt theo thời gian và bảo vệ người dùng tốt hơn.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/70/74/2a/a4dd6077ce17db62c9eb4f7ecb36877f.png\" width=\"750\" height=\"889\" alt=\"a4dd6077ce17db62c9eb4f7ecb36877f.png\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/45/30/89/0830a6b493ed2ac287ceb6f35e0cf549.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/45/30/89/0830a6b493ed2ac287ceb6f35e0cf549.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/45/30/89/0830a6b493ed2ac287ceb6f35e0cf549.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/45/30/89/0830a6b493ed2ac287ceb6f35e0cf549.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/45/30/89/0830a6b493ed2ac287ceb6f35e0cf549.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/b7/0c/ff/bd29d6a80804d7fee4f74669ba017986.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b7/0c/ff/bd29d6a80804d7fee4f74669ba017986.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b7/0c/ff/bd29d6a80