:null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/c0/e3/45/66383512adb94f37a5dd728b23b0807d.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":533,"all_time_quantity_sold":3,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eSẢN PHẨM ĐƯỢC NHẬP KHẨU CHÍNH HÃNG VÀ PHÂN PHỐI BỞI CÔNG TY CỔ PHẦN TẦM NHÌN\u003c/strong\u003e   \u003c/p\u003e\n\u003cp\u003eXẻng trồng cây cán dài Gardena 17012-20 có chiều dài 117 cm, là mẫu xẻng mới có độ bền cao và tiện dụng, thích hợp để đào, xúc bất kỳ loại đất nào. \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/27/7c/92/7b5233b4702d53db65ddf1baa947ddfd.png\" alt=\"17012-20-S-002\" width=\"350\" height=\"250\" /\u003e\u003c/p\u003e\n\u003cp\u003eThiết kế hoàn hảo mới của xẻng là tay cầm chữ D hình bầu dục, phần vỏ bằng vật liệu nhựa mềm - đảm bảo hoạt động mạnh mẽ mà không bị trượt .\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/b0/a3/0c/e3fdb3083172f9a24121e9b95de055e2.jpeg\" alt=\"17010-20-L-013\" width=\"350\" height=\"250\" /\u003e\u003c/p\u003e\n\u003cp\u003eLưỡi xẻng Garden được làm từ thép cứng cao cấp và đã trải qua quá trình xử lý, mài sắc đặc biệt để giúp dễ xắn đất. \u003c/p\u003e\n\u003cp\u003eVị trí tì lực chân lớn với kết cấu đặc biệt đảm bảo lực đẩy xẻng khi chạm đất được mạnh mẽ.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/5f/04/64/3f899d25a3b88fb0b86e8ee15a8d6805.jpeg\" alt=\"17010-20-L-015\" width=\"350\" height=\"250\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTHÔNG TIN THƯƠNG HIỆU \u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eGARDENA là Thương hiệu dẫn đầu thế giới với hơn 60 năm kinh nghiệm trong lĩnh vực sản xuất dụng cụ và thiết bị chăm sóc sân vườn tại Châu Âu, được thành lập năm 1961 tại Đức bởi Werner Kress và Eberhard Kastner. Sản phẩm Gardena đã có mặt tại hơn 80 quốc gia thông qua các Nhà Nhập khẩu và Phân phối. Kể từ năm 2006, Gardena thuộc quyền sở hữu của Tập đoàn Husqvarna AB Thụy Điển. Gardena đã trở thành Thương hiệu ưa thích của hàng triệu chủ sở hữu nhà và vườn trên toàn thế giới bởi các sản phẩm đa dạng cùng chất lượng tuyệt vời.\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/c0/e3/45/66383512adb94f37a5dd728b23b0807d.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c0/e3/45/66383512adb94f37a5dd728b23b0807d.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c0/e3/45/66383512adb94f37a5dd728b23b0807d.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c0/e3/45/66383512adb94f37a5dd728b23b0807d.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c0/e3/45/66383512adb94f37a5dd728b23b0807d.png"},{"base_url":"https://salt.tikicdn.com/ts/product/96/2a/0d/b05fc0d9fd88d01c7ae84426611ce66f.jpg","is_gallery":true,"la