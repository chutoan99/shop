 trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/b3/17/58/8f2b3487b985e3dc61133cd2d1e00c49.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b3/17/58/8f2b3487b985e3dc61133cd2d1e00c49.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b3/17/58/8f2b3487b985e3dc61133cd2d1e00c49.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b3/17/58/8f2b3487b985e3dc61133cd2d1e00c49.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b3/17/58/8f2b3487b985e3dc61133cd2d1e00c49.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/55/1a/fd/5ef5ccb1c2d36cf793f0eba57c6bdf17.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/55/1a/fd/5ef5ccb1c2d36cf793f0eba57c6bdf17.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/55/1a/fd/5ef5ccb1c2d36cf793f0eba57c6bdf17.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/55/1a/fd/5ef5ccb1c2d36cf793f0eba57c6bdf17.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/55/1a/fd/5ef5ccb1c2d36cf793f0eba57c6bdf17.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/c4/aa/a6/48fda5835f63acf11f32621bd10f4b50.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c4/aa/a6/48fda5835f63acf11f32621bd10f4b50.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c4/aa/a6/48fda5835f63acf11f32621bd10f4b50.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c4/aa/a6/48fda5835f63acf11f32621bd10f4b50.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c4/aa/a6/48fda5835f63acf11f32621bd10f4b50.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/a4/f3/76/7c158f2d517f061d74ae33f43277039a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a4/f3/