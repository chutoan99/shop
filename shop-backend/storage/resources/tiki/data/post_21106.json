c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":17000,"discount_rate":5,"rating_average":5,"review_count":4,"review_text":"(4)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/65/86/cc/014baac9faef7a6a79caedc3669b1f54.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1027,"all_time_quantity_sold":36,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003chtml\u003e\n \u003chead\u003e\u003c/head\u003e\n \u003cbody\u003e\n  \u003cul\u003e\n   \u003cp\u003eCà Phê Rang Xay Culi Highlands Coffee (200g)\u003c/p\u003e\n   \u003cp\u003eLà sản phẩm được chắt lọc từ những hạt cà phê ngon nhất cùng bí quyết và công nghệ rang xay hiện đại.\u003c/p\u003e\n   \u003cp\u003eHạt cà phê thượng hạng trồng ở vùng cao nguyên của Việt Nam được rang và phối trộn theo công thức độc đáo tại Highlands\u003c/p\u003e\n   \u003cp\u003eThành phần: 100% hạt cà phê Culi, hàm lượng caffein cao hơn cà phê thông thường khác.\u003c/p\u003e\n   \u003cp\u003eHương vị: vị đắng mạnh mẽ cùng với hương thơm quyến rũ, được tách và pha chế riêng đảm bảo được chất lượng và mùi vị\u003c/p\u003e\n   \u003cp\u003eHình dạng và màu sắc: 1 trái cà phê chỉ chứa 1 hạt ( so với loại thường là 2 hạt ), hạt no trong đầy đặn, mang hàm lượng caffein cao hơn cà phê thông thường khác, màu sắc cà phê là nâu đậm.\u003c/p\u003e\n   \u003cp\u003eHạt cà phê thượng hạng trồng ở vùng cao nguyên của Việt Nam được rang và phối trộn theo công thức độc đáo tại Highlands, mang đến 1 sản phẩm cà phê rất đặc trưng không kém phầm đạ đà, cho một sự cân bằng giữa vị mạnh nhưng rất êm đềm, quyến rũ, đúng gu thưởng thức cà phê mang phong cách rất Việt Nam.\u003c/p\u003e\n   \u003cp\u003eCà phê rang xay Culi Highlands Coffee được đóng gói tiện lợi cho việc sử dụng và bảo quản. Không chỉ dùng trong gia đình, với bao bì lịch sự còn thích hợp làm quà tặng ý nghĩa dành cho người thân, bạn bè và đồng nghiệp.\u003c/p\u003e\n   \u003cp\u003eXuất xứ: Việt Nam\u003c/p\u003e\n   \u003cp\u003eHướng dẫn sử dụng:\u003c/p\u003e\n   \u003cp\u003e1. Cho 20 gram vào phin\u003c/p\u003e\n   \u003cp\u003e2. Dùng nước tinh khiết đun nóng khoảng 90 độ C. Châm 30ml vào phin và đợi 2 phút rồi rót thêm 40ml nước để có ly cà phê thành phẩm\u003c/p\u003e\n   \u003cp\u003e3. Cho thêm đá hoặc đường hoặc sữa đặc\u003c/p\u003e\n   \u003cp\u003e--------------------------------   SEN ----------------------------------------------\u003c/p\u003e\n   \u003cp\u003e SEN là một hệ thống siêu thị mini online chuyên cung cấp các sản phẩm chất lượng xuất khẩu và nhập khẩu\u003c/p\u003e\n   \u003cp\u003e CHÚNG TÔI CAM KẾT 100% ẢNH CHỤP THẬT - CHẤT LƯỢNG THẬT\u003c/p\u003e\n   \u003cp\u003eLuôn luôn lắng nghe và hỗ trợ tư vấn tận tình về sản phẩm để nâng cao chất lượng sản phẩm, chất lượng phục vụ quý khách.\u003c/p\u003e\n   \u003cp\u003eCAM KẾT-UY TÍN-CHẤT LƯỢNG-HÀNG CHẤT-GIÁ NGẤT NGÂY\u003c/p\u003e\n   \u003cp\u003eMUA HÀNG HIỆU, KHÔNG ĐẾN TIỀN TRIỆU\u003c/p\u003e\n   \u003cp\u003e️ CÁCH ĐẶT HÀNG\u003c/p\u003e\n   \u003cp\u003e Các bạn bấm chọn mẫu\u003c/p\u003e\n   \u003cp\u003e Sau đó bấm chọn size và số lượng\u003c/p\u003e\n   \u003cp\u003e Có cái giỏ mà có dấu cộng thì các bạn bấm vào đó\u003c/p\u003e\n   \u003cp\u003e Nếu muốn mua sản phẩm khác thì chọn và làm như trên\u003c/p\u003e\n   \u003cp\u003e Sau khi đầy đủ số lượng cần mua thì bấm mua hàng\u003c/p\u003e\n   \u003cp\u003e Shop sẽ gửi đúng size và mẫu mà các bạn đặt nha.\u003c/p\u003e\n   \u003cp\u003e**** Khách cần tư vấn, thắc mắc gì thì chat ngay với shop nh