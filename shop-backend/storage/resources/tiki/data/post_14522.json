 vợ mình biến ước mơ của cô ấy thành sự thật và sẵn sàng hi sinh sự nghiệp của mình vì sự nghiệp của vợ nếu như phải lựa chọn.\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eCuốn sách này dạy bạn rằng sự lãnh đạo bằng tình yêu thương cũng chính là chìa khóa dẫn tới thành công trong cả sự nghiệp và cuộc sống gia đình của bạn.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/media/catalog/product/i/m/img979_6.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/i/m/img979_6.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/i/m/img979_6.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/i/m/img979_6.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/i/m/img979_6.jpg"}],"warranty_policy":null,"authors":[{"id":45647,"name":"David Devin","slug":"david-devin"}],"current_seller":{"id":10914,"sku":"8514636833656","name":"trungthanh2018","link":"https://tiki.vn/cua-hang/trungthanh2018","logo":"a7/54/06/bad90228783e18b51eeff7187fadb302.jpg","price":118000,"product_id":"11366464","store_id":10648,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[{"id":9988,"name":"AHABOOKS","link":"https://tiki.vn/cua-hang/ahabooks","logo":"7c/b8/e1/357f6a5d18da8daa4e9060a6b7eb9d5f.png","price":118000,"product_id":"7062967","store_id":9778},{"id":10821,"name":"nha sach nguyet linh","link":"https://tiki.vn/cua-hang/nha-sach-nguyet-linh","logo":"88/2b/d0/eaa1eadc8566bf565288bb245d07f952.jpg","price":109250,"product_id":"8190065","store_id":10595},{"id":26874,"name":"Ph