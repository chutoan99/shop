,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":2309000,"discount_rate":52,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/6f/0f/59/beecf18bffa7369219927e22399b3639.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":629,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cdiv\u003e\n\u003cdiv\u003e\u003cstrong\u003eMáy hút mùi âm tủ Ecalite EH-AT700T\u003c/strong\u003e sở hữu kiểu dáng sang trọng, hiện đại, thiết kế âm tủ nhỏ gọn tiết kiệm không gian bếp tối ưu. Sản phẩm trang bị điều khiển cảm ứng với 3 tốc độ hút dễ dàng tuỳ chỉnh và cực nhạy, công suất hút mạnh mẽ sẽ nhanh chóng mang đến cho không gian bếp nhà bạn sự mát mẻ, trong lành và thoải mái nhất khi vào bếp.\u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e \u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/fb/d7/38/582af45397d2625d827a624ceeef98c9.png\" alt=\"Máy hút mùi âm tủ Ecalite EH-AT700T \" width=\"750\" height=\"392\" /\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv\u003e\n\u003ch2\u003e\u003cspan style=\"color:#3366ff;\"\u003eThiết kế lắp âm cực gọn\u003c/span\u003e\u003c/h2\u003e\n\u003cdiv\u003e\n\u003cdiv\u003eSở hữu những ưu điểm của các dòng \u003cstrong\u003emáy hút mùi âm tủ của Ecalite EH-AT700T\u003c/strong\u003e mang đến một thiết kế cực gọn gàng với toàn bộ phần thân máy được đặt phía bên trong tủ bếp, bên ngoài là phần mặt kính đen cùng bảng điều khiển tạo nên một tổng thể vô cùng sang trọng và hiện đại. Đặc biệt, phần tấm lọc dầu có thể kéo ra/đẩy vào dễ dàng tạo nên sự tinh tế cho tổng thế sản phẩm, tăng hiệu quả sử dụng. Đây cũng là dòng sản phẩm đáp ứng tốt cho không gian bếp vừa và nhỏ, các chung cư, căn hộ. \u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e \u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/50/78/b2/0dbf094c88ee2b177cf193301c2e2d1d.png\" alt=\"Máy hút mùi âm tủ Ecalite EH-AT700T lắp âm\" width=\"750\" height=\"392\" /\u003e\u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cem\u003eMáy hút mùi Ecalite EH-AT700T có thiết kế hiện đại\u003c/em\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv\u003e\n\u003ch2\u003e\u003cspan style=\"color:#3366ff;\"\u003eKích thước 70 cm phù hợp với nhiều bếp nấu\u003c/span\u003e\u003c/h2\u003e\n\u003cdiv\u003e\n\u003cdiv\u003e\u003cstrong\u003eMáy hút mùi lắp âm EH-AT700T \u003c/strong\u003evới kích thước 70cm là kích thước được sử dụng nhiều nhất trong các gia đình Việt. Bạn có thể kết hợp máy với nhiều bếp nấu 2, 3 hoặc 4 vùng nấu mà vẫn đảm bảo tính thẩm mỹ cũng như hiệu suất hoạt động không hề thay đổi.\u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e \u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/e7/e9/72/a626870d6981e3eaeaf1b52376594368.png\" alt=\"Máy hút mùi âm tủ Ecalite EH-AT700T ngang 70cm\" width=\"750\" height=\"392\" /\u003e\u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cem\u003eChiều ngang 70 cm kết hợp với nhiều bếp nấu hiện nay\u003c/em\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003ch2\u003e\u003cspan style=\"color:#3366ff;\"\u003eDễ dàng tháo vỉ dầu để vệ sinh\u003c/span\u003e\u003c/h2\u003e\n\u003cdiv\u003e\n\u003cdiv\u003e\u003cstrong\u003eEcalite EH-AT700T\u003c/strong\u003e trang bị vỉ lọc dầu được làm từ chất liệu nhôm có độ bền cao, bộ phận này có khả năng hút các dầu mỡ khi nấu nướng trước khi vào các bộ phận xử lý tiếp theo. Khi bạn cần lấy ra để vệ sinh, chỉ cần tháo nhẹ là có thể lấy để vệ sinh một cách thoải mái nhất. Vỉ dầu này chỉ cần ngâm vào nước ấm và pha chút nước rửa chén, các mảng bám sẽ dễ dàng bong tróc để bạn chùi rửa một cách dễ dàng.\u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e \u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/60/0f/94/021332fc241dac47dd14e710ac5f5243.png\" alt=\"Máy hút mùi âm tủ Ecalite EH-AT700T có lưới lọc nhôm\" width=\"750\" height=\"392\" /\u003e\u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cem\u003eLưới lọc nhôm dễ vệ sinh\u003c/em\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv\u003e\n\u003ch2\u003e\u003cspan style=\"color:#3366ff;\"\u003eKhử mùi than hoạt tính\u003c/span\u003e\u003c/h2\u003e\n\u003cdiv\u003eTại 2 họng hút của động cơ được gắn 2 bánh than khử mùi hiệu quả, lọc sạch mùi hôi trong bếp, đem đến không gian bếp luôn trong lành, không mùi hôi, bảo vệ sức khoẻ người dùng.\u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e \u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/84/8d/6f/ca902498dca5a292500cd5ef3e3d6baa.png\" alt=\"Máy hút mùi âm tủ Ecalite EH-AT700T khử mùi bằng than hoạt tính\" width=\"750\" height=\"392\" /\u003e\u003c/div\u003e\n\u003cdiv\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cem\u003eThan hoạt tính khử mùi triệt để\u003c/em\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv\u003e\n\u003cdiv\u003e\n\u003ch2\u003e\u003cspan style=\"color:#3366ff;\"\u003eĐiều khiển cảm ứng hiện đại\u003c/span\u003e\u003c/h2\u003e\n\u003cp\u003eĐể tăng thêm tính hiện đại và tiện ích khi sử dụng, máy hút mùi âm tủ EH-AT700T được Ecalite trang bị bảng điều khiển cảm ứng cực nhanh nhạy, kết hợp là màn hình LED hiển thị trực quan giúp người dùng dễ dàng quan sát và điều chỉnh các chức năng khi sử dụng.  \u003c/p\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/c3/bc/cc/994dedbe85a35b3b3879fe006398677c.png\" alt=\"Máy hút mùi âm tủ Ecalite EH-AT700T điều khiển cảm ứng\" width=\"750\" height=\"392\" /\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cem\u003eCác nút chức năng trên máy hút mùi EH-AT700T\u003c/em\u003e\u003c/div\u003e\n\u003cdiv\u003e\n\u003ch2\u003e\u003cspan style=\"color:#3366ff;\"\u003e3 tốc độ hút \u003c/span\u003e\u003c/h2\u003e\n\u003cp\u003eMáy hút mùi EH-AT700T âm tủ có 3 tốc độ hút từ thấp đến cao phù hợp với nhiều nhu cầu hút khác nhau, tiết kiệm điện năng hiệu quả. Với các món ăn không quá nhiều dầu mỡ bạn có thể cho máy chạy ở công suất 1, 2, còn với các món như chiên xào, kho hay những món ăn hơi nhiều mùi thì mức 3 là hợp lý nhất. \u003c/p\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cem\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/52/9e/66/374741a6e54020f1520ad618efd400c1.png\" alt=\"Máy hút mùi âm tủ Ecalite EH-AT700T có 3 tốc độ hút\" width=\"750\" height=\"392\" /\u003e\u003c/em\u003e\u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cem\u003eTuỳ chỉnh 3 tốc độ hút theo nhu cầu\u003c/em\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv\u003e\n\u003ch2\u003e\u003cspan style=\"color:#3366ff;\"\u003eChiếu sáng bằng đèn LED công suất cao\u003c/span\u003e\u003c/h2\u003e\n\u003cp\u003eMột điểm cộng của máy hút mùi Ecalite này chính là sở hữu 2 đèn LED, mỗi đèn công suất 2W chiếu sáng tốt cho khu vực nấu nướng nhà bạn, đặc biệt là các vị trí bị khuất mà các đèn trong nhà bếp không tiếp cận được. Để sử dụng, bạn chỉ cần chạm vào kí hiệu bóng đèn trên bảng điều khiển và tắt đi nếu không muốn sử dụng nữa.\u003c/p\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/21/dc/56/e577f0bd21b56935e20c0703c9fcf55f.png\" alt=\"Máy hút mùi âm tủ Ecalite EH-AT700T có 2 đèn led sáng\" width=\"750\" height=\"392\" /\u003e\u003cbr /\u003e\u003cem\u003eHai đèn LED công suất cao trên hút mùi Ecalite EH-AT700T\u003c/em\u003e\u003c/div\u003e\n\u003ch2\u003e\u003cspan style=\"color:#3366ff;\"\u003eCông suất hút 750m3/h\u003c/span\u003e\u003c/h2\u003e\n\u003cp\u003eCác máy hút mùi âm tủ thường bị hạn chế ở công suất hút so với các dòng máy hút mùi khác, tuy nhiên với Ecalite EH-AT700T lại trang bị công suất hút cực lớn lên đến 750m3/h, tương đương công suất hút của các dòng áp tường. Với công suất này sẽ hút sạch mùi hôi, dầu mỡ nhà bạn trong một phạm vi bếp tương đối lớn rất nhanh chóng, giúp bạn an tâm khi nấu ăn hàng ngày với tần suất cao. \u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/77/6f/81/1e9d40388f7901a1809ead5460a40f87.png\" alt=\"Máy hút mùi âm tủ Ecalite EH-AT700T công suất hút 750 m3/h\" width=\"750\" height=\"392\" /\u003e\u003cbr /\u003e\u003cem\u003eCông suất hút cao giúp bếp luôn thông thoáng\u003c/em\u003e\u003c/p\u003e\n\u003c/div\u003e\n\u003ch2\u003e\u003cspan style=\"color:#3366ff;\"\u003eHoạt động êm ái với độ ồn thấp\u003c/span\u003e\u003c/h2\u003e\n\u003cdiv\u003e\n\u003cdiv\u003eMáy hút mùi Ecalite EH-AT700T hoạt động rất êm ái nhờ động cơ bền bỉ, độ ồn tối đa chỉ 56dB không hề ảnh hưởng đến sinh hoạt chung của các thành viên trong gia đình. \u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/68/d8/85/d6820ec4bf8b20cc0f5d530a9ae1d22c.png\" alt=\"Máy hút mùi âm tủ Ecalite EH-AT700T hoạt động êm ái\" width=\"750\" height=\"392\" /\u003e\u003cbr /\u003e\u003cem\u003eMáy hút mùi Ecalite EH-AT700T có độ ồn thấp\u003c/em\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv\u003e\n\u003cdiv\u003e\n\u003ch2\u003e\u003cspan style=\"color:#3366ff;\"\u003eChính sách bảo hành máy hút mùi âm tủ Ecalite EH-AT700T\u003c/span\u003e\u003c/h2\u003e\n\u003cp\u003eMáy hút mùi âm tủ Ecalite EH-AT700T được hãng Ecalite bảo hành chính hãng 3 năm tại nhà.\u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/f4/cf/38/b01c5af833a3f9edbd787cbb85aee6b2.png\" alt=\"Máy hút mùi âm tủ Ecalite EH-AT700T bảo hành 3 năm\" width=\"750\" height=\"392\" /\u003e\u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cem\u003eSản phẩm bảo hành 3 năm yên tâm sử dụng\u003c/em\u003e\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv\u003eMáy hút mùi âm tủ Ecalite EH-AT700T với thiết kế hiện đại, nhỏ gọn, công suất hút cao là thiết bị bếp tiện ích mà gia đình bạn đang tìm kiếm.\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv\u003e\u003cem\u003eNguồn: ecalite.com\u003c/em\u003e\u003c/div\u003e\n\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/6f/0f/59/beecf18bffa7369219927e22399b3639.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/6f/0f/59/beecf18bffa7369219927e22399b3639.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/6f/0f/59/beecf18bffa7369219927e22399b3639.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6f/0f/59/beecf18bffa7369219927e22399b3639.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6f/0f/59/beecf18bffa7369219927e22399b3639.png"},{"base_url":"https://salt.tikicdn.com/ts/product/8e/c5/c2/311c50f51441b6612164dd61591e99c0.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/8e/c5/c2/311c50f51441b6612164dd61591e99c0.jpg","medium_ur