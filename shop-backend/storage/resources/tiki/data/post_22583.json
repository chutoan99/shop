text":"(10)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/e2/a8/9a/e0a6a004416af5b3e94a99d16816c3a7.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1787,"all_time_quantity_sold":45,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/product/57/d5/f7/c899ad64e31d2ca811257c1a888675bd.jpg\" alt=\"Kết quả hình ảnh cho Vòng sứ cô đặc dùng cho ấm sắc thuốc\" /\u003e\u003c/p\u003e\n\u003cp\u003eNhững chiếc vòng này được làm từ sứ, bạn nên chọn những loại có đảm bảo loại bỏ những tạp chất độc hại để khi sắc sẽ không gây ảnh hưởng tới chất lượng của thuốc cũng như sức khỏe của người dùng thuốc.\u003c/p\u003e\n\u003cp\u003eẤm có chức năng cho 3 bát nước (~750ml) vào ấm sẽ sắc còn lại đúng 1 chén thuốc (~250ml) vì vậy có nhiều người sử dụng muốn lượng nước khi sắc ra ít đi thì có thể sử dụng vòng cô đặc đi kèm.\u003c/p\u003e\n\u003cp\u003eNếu muốn cô đặc thuốc, người dùng có thể sử dụng vòng sứ bằng cách đặt vòng sứ quanh mâm gia nhiệt rồi xếp thuốc lên trên và sử dụng như bình thường, lượng nước bạn cho ít đi thì thuốc khi sắc ra sẽ cô đặc lại chỉ còn lại 8/10 của bát thuốc, cho thêm một vòng sứ nữa thì lượng thuốc chỉ còn 6/10.\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"cách sử dụng vòng sứ cô đặt của ấm sắc thuốc\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/0e/89/85/086f666823337d4843ba2286b8a656dc.jpg\" alt=\"cách sử dụng vòng sứ cô đặt của ấm sắc thuốc\" width=\"500\" /\u003e\u003c/p\u003e\n\u003ch2\u003eCách sử dụng vòng sứ cô đặc của ấm sắc thuốc\u003c/h2\u003e\n\u003cp\u003eĐể sử dụng vòng sứ hiệu quả khi thực hiện lần sắc thuốc đầu tiên không nên sử dụng vòng cô đặc. Nếu thấy lượng nước sắc ra trong lần này vượt quá yêu cầu thì những lần sau, bạn mới nên dùng thêm vòng sứ để lượng nước sắc ra ít hơn lần trước.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/e2/a8/9a/e0a6a004416af5b3e94a99d16816c3a7.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e2/a8/9a/e0a6a004416af5b3e94a99d16816c3a7.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e2/a8/9a/e0a6a004416af5b3e94a99d16816c3a7.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e2/a8/9a/e0a6a004416af5b3e94a99d16816c3a7.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e2/a8/9a/e0a6a004416af5b3e94a99d16816c3a7.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/3a/d5/1a/70f7c1fa2373d6c742ba8591cd0451a9.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/3a/d5/1a/70f7c1fa2373d6c742ba8591cd0451a9.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/3a/d5/1a/70f7c1fa2373d6c742ba8591cd0451a9.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3a/d5/1a/70f7c1fa2373d6c742ba8591cd0451a9.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3a/d5/1a/70f7c1fa2373d6c742ba8591cd0451a9.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/2c/a6/98/126cf5a14765947bdb0cc5d0d43bc1bb.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/2c/a6/98/126cf5a14765947bdb0cc5d0d43bc1bb.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/2c/a6/98/126cf5a14765947bdb0cc5d0d