ịa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/c8/ec/51/6d479e6051636321e1760878a548be64.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c8/ec/51/6d479e6051636321e1760878a548be64.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c8/ec/51/6d479e6051636321e1760878a548be64.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c8/ec/51/6d479e6051636321e1760878a548be64.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c8/ec/51/6d479e6051636321e1760878a548be64.png"},{"base_url":"https://salt.tikicdn.com/ts/product/f9/91/34/17b6444b3d9fa47e27c9b4ce6f50ff48.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f9/91/34/17b6444b3d9fa47e27c9b4ce6f50ff48.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f9/91/34/17b6444b3d9fa47e27c9b4ce6f50ff48.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f9/91/34/17b6444b3d9fa47e27c9b4ce6f50ff48.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f9/91/34/17b6444b3d9fa47e27c9b4ce6f50ff48.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/e8/b2/b9/f8fe485fe1a9e491dd05cfc830b5fdba.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e8/b2/b9/f8fe485fe1a9e491dd05cfc830b5fdba.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e8/b2/b9/f8fe485fe1a9e491dd05cfc830b5fdba.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e8/b2/b9/f8fe485fe1a9e491dd05cfc830b5fdba.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e8/b2/b9/f8fe485fe1a9e491dd05cfc830b5fdba.jpg"},{"base_url":"https://salt.tikicdn.com