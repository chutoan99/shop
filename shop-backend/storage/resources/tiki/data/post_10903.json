null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/37/7e/2e/9f3df73bc8ec50d9070b43cebf7a4a6d.jpeg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1036,"all_time_quantity_sold":3,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p style=\"margin: 0; padding: 8px 0; white-space: pre-wrap;\"><strong><iframe src=\"//www.youtube.com/embed/4JyfxDzemYA\" width=\"560\" height=\"314\" allowfullscreen=\"allowfullscreen\"></iframe></strong></p>\n<p style=\"margin: 0; padding: 8px 0; white-space: pre-wrap;\"> </p>\n<p style=\"margin: 0; padding: 8px 0; white-space: pre-wrap;\"><strong>TÍNH NĂNG</strong></p>\n<ul style=\"list-style: disc; margin-left: 10px;\">\n<li>Bơm sàn hiệu quả với kích thước nhỏ gọn như bơm xách tay tiện dụng.</li>\n<li>Thân, piston, đế và tay cầm chữ T bằng nhôm được gia công CNC siêu nhẹ, tối ưu cho việc bơm thường xuyên.</li>\n<li>Vòi bơm dài, linh hoạt, thuận tiện giúp bơm bánh dễ dàng hơn.</li>\n<li>Chân đạp bằng thép không gỉ giúp ổn định bơm khi sử dụng. </li>\n<li>Đầu bơm ABS đảo chuyển đầu, tương thích với cả 2 loại van Presta và Schrader. </li>\n<li>Đi kèm ngàm gắn lên khung xe. </li>\n<li>Áp suất tối đa: 90psi | 6.2bar</li>\n<li>Trọng lượng: 300mm |205g</li>\n</ul>\n<p style=\"margin: 0; padding: 8px 0; white-space: pre-wrap;\"> </p>\n<div style=\"width: 100.0%; margin: 0; padding: 8px 0; white-space: pre-wrap;\">\n<div style=\"width: 100.0%; display: block; margin: 0; padding: 8px 0; white-space: pre-wrap;\">\n<div style=\"width: 100.0%; display: block; margin: 0; padding: 8px 0; white-space: pre-wrap;\">\n<div style=\"width: 100.0%; display: block;\"><img class=\"\" style=\"width: 100.0%; display: block;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/46/e0/74/d65d4bcf04f4adf51f8c2f350decab33.jpg\" /></div>\n</div>\n</div>\n</div>\n<p style=\"margin: 0; padding: 8px 0; white-space: pre-wrap;\"> </p>\n<p style=\"margin: 0; padding: 8px 0; white-space: pre-wrap;\"><strong>THÔNG TIN THƯƠNG HIỆU</strong></p>\n<div style=\"margin: 0; padding: 8px 0; white-space: pre-wrap;\">\n<div style=\"width: 100.0%; margin: 0; padding: 8px 0; white-space: pre-wrap;\">\n<div style=\"width: 100.0%; display: block; margin: 0; padding: 8px 0; white-space: pre-wrap;\">\n<div style=\"width: 100.0%; display: block; margin: 0; padding: 8px 0; white-space: pre-wrap;\">\n<div style=\"width: 100.0%; display: block; margin: 0; padding: 8px 0; white-space: pre-wrap;\">\n<div style=\"width: 100.0%; display: block;\"><img class=\"\" style=\"width: 100.0%; display: block;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/59/00/41/59712463fc5a494197fbe1b4694160b1.jpg\" /></div>\n</div>\n</div>\n</div>\n</div>\n</div>\n<p style=\"margin: 0; padding: 8px 0; white-space: pre-wrap;\">Lezyne được thành lập vào ngày 01 tháng 3 năm 2007, bởi Micki Kozuschek, một người gốc Đức, đồng thời là một biểu tượng trong ngành công nghiệp xe đạp. Mục tiêu của Lezyne là thiết kế nên những sản phẩm hiệu quả, đạt tiêu chuẩn hàng đầu. Cho đến hôm nay, mục tiêu đó vẫn không thay đổi và Lezyne hiện đang là thương hiệu dẫn đầu ngành công nghiệp sản xuất phụ kiện xe đạp với hàng loạt giải thưởng quốc tế.</p>\n<p style=\"margin: 0; padding: 8px 0; white-space: pre-wrap;\">Từ năm 2011, Lezyne bắt đầu phát triển hệ thống đèn LED cho xe đạp và một lần nữa lại tái định nghĩa tiêu chuẩn về thiết kế và công năng. Tất cả các sản phẩm đèn LED từ Lezyne đều được thử nghiệm trong khoang nghiệm cầu tích hợp, một thiết kế từ chính Lezyne. Lezyne tự mình phát triển dòng thấu kính riêng nhằm sản sinh ra trường nhìn tối ưu, dành cho các sản phẩm đèn của hãng. </p>\n<p style=\"margin: 0; padding: 8px 0; white-space: pre-wrap;\">Trụ sở của Lezyne đặt tại San Luis Obispo, California. Tất cả các sản phẩm được sản xuất và lắp ráp tại nhà máy của Lezyne tại Cao Hùng, Đài Loan, hoặc được cung cấp độc quyền bởi các đối đác tin cậy, gần gũi với dây chuyền sản xuất của Lezyne.</p>\n<p style=\"margin: 0; padding: 8px 0; white-space: pre-wrap;\">Lezyne còn tự hào là nhà tài trợ cho các vận động viên hàng đầu, đẳng cấp thế giới, như đội đua Lotto-Soudal, VĐV Cedric Gracia, VĐV biểu diễn xe đạp mạo hiểm Danny MacAskill, và rất nhiều các VĐV  nổi tiếng khác. Lezyne là sự kết hợp giữa tình yêu xe đạp &amp; đam mê thiết kế. Tinh tế - Thông minh - Vượt trội. </p>\n<p> </p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/37/7e/2e/9f3df73bc8ec50d9070b43cebf7a4a6d.jpeg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/37/7e/2e/9f3df73bc8ec50d9070b43cebf7a4a6d.jpeg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/37/7e/2e/9f3df73bc8ec50d9070b43cebf7a4a6d.jpeg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/37/7e/2e/9f3df73bc8ec50d9070b43cebf7a4a6d.jpeg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/37/7e/2e/9f3df73bc8ec50d9070b43cebf7a4a6d.jpeg"},{"base_url":"https://salt.tikicdn.com/ts/product/46/e0/74/484aad6609911cc7bee469ed6cbf06e7.jpeg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/46/e0/74/484aad6609911cc7bee4