/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":111000,"discount_rate":37,"rating_average":4,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ce/0f/ae/2497b4d5917ed4db2f9b42745db59eee.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":575,"all_time_quantity_sold":52,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p><strong>Bí Mật Dinh Dưỡng Cho Sức Khỏe Toàn Diện - The China Study ( Tái Bản )</strong></p>\n<p><span style=\"font-weight:400;\">Cuốn sách được bạn đọc báo Doanh Nhân Sài gòn bình chọn Top 10 cuốn sách đáng đọc nhất năm 2020</span></p>\n<p><em><span style=\"font-weight:400;\">The China Study – Bí mật dinh dưỡng cho sức khỏe toàn diện,</span></em><span style=\"font-weight:400;\"> là công trình nghiên cứu lớn nhất về sức khỏe và dinh dưỡng từng được hiện trên thế giới kéo dài 20 năm, với sự hợp tác chặt chẽ đội ngũ chuyên gia từ Đại học Cornell, Đại học Oxford và Viện Y học Dự phòng Trung Quốc do Tiến sĩ T.Colin Campbell dẫn đầu. </span></p>\n<p><span style=\"font-weight:400;\">THÔNG TIN CHÍNH CỦA CUỐN SÁCH: Thực hiện chế độ  ăn Whole Foods Plant Based (WFPB) – tạm gọi là chế độ ăn toàn phần, chủ yếu là thực vật ( khác với chế độ ăn chay)- không những tốt cho cơ thể mà còn có thể chữa được hầu hết các loại bệnh.</span></p>\n<p><span style=\"font-weight:400;\"><img src=\"https://salt.tikicdn.com/ts/tmp/49/7c/70/951101bdcc4524470e6867c86d6bd205.png\" alt=\"\" width=\"750\" height=\"750\" /></span></p>\n<p><span style=\"font-weight:400;\">Cuốn sách gồm 04 phần:</span></p>\n<ol><li style=\"font-weight:400;\"><span style=\"font-weight:400;\">Phần 1: Bí mật dinh dưỡng toàn phần</span></li>\n<li style=\"font-weight:400;\"><span style=\"font-weight:400;\">Phần 2: Chỉ ra các căn bệnh của sự giàu có. Và khẳng định những bệnh này có thể chữa khỏi nếu bạn áp dụng đúng chế độ chế độ ăn toàn phần, chủ yếu là thực vật.</span></li>\n<li style=\"font-weight:400;\"><span style=\"font-weight:400;\">Phần 3: Hướng dẫn ăn sao cho đúng cách để có cơ thể khỏe mạnh và chữa được bệnh </span></li>\n<li style=\"font-weight:400;\"><span style=\"font-weight:400;\">Phần 4. “Góc khuất” trong lĩnh vực dinh dưỡng và sức khỏe: Chúng ta, những người đang trả tiền của những nhà khoa học trong ngành Y, giới học thuậ nhưng những thông tin về sức khoẻ có thật sự đúng như truyền thông hay chưa?</span></li>\n</ol><p><span style=\"font-weight:400;\">Nếu bạn thực sự quan tâm đến sức khoẻ của mình, hãy dành thời gian đọc cuốn sách này. </span></p>\n<p><span style=\"font-weight:400;\">Bác sĩ tốt nhất là chính mình.</span></p>\n<p><span style=\"font-weight:400;\"><img src=\"https://salt.tikicdn.com/ts/tmp/27/e2/4f/5e69112799d6bad25e5df4157636d2bd.jpg\" alt=\"\" width=\"750\" height=\"562\" /></span></p>\n<p> </p>\n<p><img title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/64/b1/59/fb3591a474e93def0440c13b1bfc47db.jpg\" alt=\"\" /></p>\n<p><img title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/22/5f/af/6d736d56bec66db60008c78788aa170e.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p><img src=\"https://salt.tikicdn.com/ts/tmp/f0/22/78/6de251593f16aea6f04438527f3ebf03.jpg\" alt=\"\" width=\"750\" height=\"866\" /></p>\n<p><span style=\"font-weight:400;\">TÁM (8) NGUYÊN TẮC DINH DƯỠNG THEO BÍ MẬT DINH DƯỠNG CHO SỨC KHỎE TOÀN DIỆN</span></p>\n<ol><li style=\"font-weight:400;\"><span style=\"font-weight:400;\">Dinh dưỡng là đại diện cho sự kết hợp của vô số chất trong thức ăn. Vì thế, ăn toàn phần thì tốt hơn tổng từng phần.</span></li>\n<li style=\"font-weight:400;\"><span style=\"font-weight:400;\">Thực phẩm chức năng không phải là thần dược chữa được bách bệnh.</span></li>\n<li style=\"font-weight:400;\"><span style=\"font-weight:400;\">Không có chuyện chất dinh dưỡng có trong thực phẩm có nguồn gốc động vật thì tốt hơn chất dinh dưỡng có trong thực phẩm có nguồn gốc thực vật.</span></li>\n<li style=\"font-weight:400;\"><span style=\"font-weight:400;\">Gen không chịu trách nhiệm cho bệnh tật</span></li>\n<li style=\"font-weight:400;\"><span style=\"font-weight:400;\">Dinh dưỡng có thể kiểm soát đáng kể các tác hại của hóa chất độc hại.</span></li>\n<li style=\"font-weight:400;\"><span style=\"font-weight:400;\">Cùng một dưỡng chất giúp ngăn ngừa bệnh ở giai đoạn đầu (trước khi chẩn đoán) cũng có thể giúp ngăn chặn hoặc đẩy lùi căn bệnh ở giai đoạn sau (sau khi chẩn đoán).</span></li>\n<li style=\"font-weight:400;\"><span style=\"font-weight:400;\">Chế độ dinh dưỡng có ích cho người mắc bệnh mạn tính là chế độ giúp hỗ trợ sức khỏe toàn diện.</span></li>\n<li style=\"font-weight:400;\"><span style=\"font-weight:400;\">Dưỡng chất tốt tạo ra sức khỏe cho mọi hoạt động tồn tại của chúng ta. Tất cả các hoạt động đều được kết nối với nhau.</span></li>\n</ol><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ce/0f/ae/2497b4d5917ed4db2f9b42745db59eee.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ce/0f/ae/2497b4d5917ed4db2f9b42745db59eee.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ce/0f/ae/2497b4d5917ed4db2f9b42745db59eee.jpg","position":null,"small_url":"https://salt.tikicdn.com/cac