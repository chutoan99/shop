r":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/34/15/d3/620edfed75d126d274d5f5be5218c58e.png","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":93,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eBình Xịt GIÁN, Muỗi, Kiến Và Các Loại Côn Trùng (Thái Lan 600ml) - An Toàn Cho Người Sử Dụng\u003c/p\u003e\n\u003cp\u003eà thương hiệu diệt côn trùng nổi tiếng số 1 Thái Lan thuộc tập đoàn Sherwood được nhập khẩu trực tiếp và phân phối tại Việt Nam.Từ khi được cho ra mắt thị trường cho đến nay, thì loại bình xịt này luôn được nhiều khách hàng tìm kiếm để mua về nhà tự diệt các loại côn trùng tại nhà, hoặc các công ty diệt muỗi sử dụng.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e*THÔNG TIN SẢN PHẨM:\u003c/p\u003e\n\u003cp\u003e-Bình xịt GIÁN, Kiến, Muỗi và các loại côn trùng\u003c/p\u003e\n\u003cp\u003e-Dung tích: 600ml\u003c/p\u003e\n\u003cp\u003e-Quy cách: Bình Xịt\u003c/p\u003e\n\u003cp\u003e-Xuất xứ: Thái Lan (có tem phụ nhập khẩu)\u003c/p\u003e\n\u003cp\u003e-Hạn Sử Dụng: 3 năm kể từ ngày sản xuất\u003c/p\u003e\n\u003cp\u003e-Thành phần hoạt chất: Prallethrin Nồng độ: 0,030% W / W, Imiprothin Nồng độ: 0,031% W / W, Cypermethrin Nồng Độ 0.100% W/W\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e*CÔNG DỤNG:\u003c/p\u003e\n\u003cp\u003e-Diệt GIÁN, Kiến, Muỗi và các loại côn trùng\u003c/p\u003e\n\u003cp\u003e-Bình xịt có vòi xịt khuếch tán tiện dụng,dễ dàng đưa vào các ổ gián,kiến,các vết nứt của tủ,sàn nhà,trần nhà\u003c/p\u003e\n\u003cp\u003e-An toàn tuyệt đối cho người trong nhà,không phát tán trong không khí.\u003c/p\u003e\n\u003cp\u003e-Có tác dụng trong 4 tuần kể từ lúc xịt.\u003c/p\u003e\n\u003cp\u003e-Chaindrite diệt muỗi,gián,kiến và các loại côn trùng dựa trên phương pháp dùng côn trùng lính và côn trùng thợ mang về lây nhiễm (mang dịch bệnh về) cho cả hệ thống tổ dưới lòng đất. Dẫn đến cả hệ thống tổ chết theo.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e*Hướng dẫn sử dụng:\u003c/p\u003e\n\u003cp\u003e-Lắc đều trước khi sử dụng\u003c/p\u003e\n\u003cp\u003e-Lắc bình và xịt bằng cách hướng đầu ống xịt vào các lỗ mà côn trùng làm tổ, trong các góc,sàn nhà, gầm tủ, xung quanh thùng rác, xung quanh cửa ra vào và cửa sổ, các vết nứt, dọc đường côn trùng đi lại hoặc thích sống , hoặc phun trực tiếp lên côn trùng.\u003c/p\u003e\n\u003cp\u003e-Đậy kín thực phẩm hoặc di chuyển ra xa chỗ chuẩn bị xịt\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e* Bảo Quản:\u003c/p\u003e\n\u003cp\u003e-Bảo quản nơi khô ráo,thoáng khí.\u003c/p\u003e\n\u003cp\u003e-Tháo vòi xịt khỏi van khi không sử dụng.\u003c/p\u003e\n\u003cp\u003e-Tránh để bình xịt gần nguồn nhiệt và tiếp xúc trực tiếp với ánh nắng.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e*Lưu ý:\u003c/p\u003e\n\u003cp\u003e-Đọc kỹ hướng dẫn trước khi sử dụng.\u003c/p\u003e\n\u003cp\u003e-Để xa tầm tay trẻ em\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e#dietgian #diệt gián #dietcontrung #xitcontrung #chaindrite #chaindrite thái Lan #xịt muỗi #xitmuoi #xịt kiến #xitkien #bình xịt gián #binhxitgian #diệt côn trùng\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e\u003cp\u003eSản phẩm này là tài sản cá nhân được bán bởi Nhà Bán Hàng Cá Nhân và không thuộc đối tượng phải chịu thuế GTGT. Do đó hoá đơn VAT không được cung cấp trong trường hợp này.\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/34/15/d3/620edfed75d126d274d5f5be5218c58e.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/34/15/d3/620edfed75d126d274d5f5be5218c58e.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/34/15/d3/620edfed75d126d274d5f5be5218c58e.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/34/15/d3/620edfed75d126d274d5f5be5218c58e.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/34/15/d3/620edfed75d126d274d5f5be5218c58e.png"},{"base_url":"https://salt.tikicdn.com/ts/product/77/4b/34/8a04f5e73d128fee9ff645b976e1670f.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/77/4b/34/8a04f5e73d128fee9ff645b976e1670f.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/77/4b/34/8a04f5e73d128fee9ff645b976e1670f.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/77/4b/34/8a04f5e73d128fee9ff645b976e1670f.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/77/4b/34/8a04f5e73d128fee9ff645b976e1670f.png"},{"base_url":"https://salt.tikicdn.com/ts/product/81/58/65/62977fc88400a8b7879fec920808fbbb.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/81/58/65/62977fc88400a8b7879fec920808fbbb.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/81/58/65/62977fc88400a8b7879fec920808fbbb.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/81/58/65/62977fc88400a8b7879fec920808fbbb.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/81/58/65/62977fc88400a8b7879fec920808fbbb.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/2