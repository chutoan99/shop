,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":374000,"discount_rate":22,"rating_average":4.8,"review_count":29,"review_text":"(29)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/9a/bf/5c/fba037c301452825cb2996bbba0cdb6f.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2178,"all_time_quantity_sold":78,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cdiv class=\"mb30 ldtl-toggle-content\"\u003e\n\u003cp\u003e\u003cstrong\u003eTÚI DU LỊCH CAO CẤP TRAVELLER: ĐA TIỆN ÍCH, ĐỈNH THỜI THƯỢNG\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eKhi đi du lịch, điều khiến phần lớn chúng ta cảm thấy phiền toái là khâu ký gửi hành lý, vừa tốn thời gian vừa tiềm ẩn nguy cơ thất lạc. Chính vì vậy trong những chuyến đi ngắn ngày thì một chiếc túi du lịch sẽ là lựa chọn hợp lý. Với thiết kế sang trọng cùng sự đột phá trong tính năng, Sakos Traveller sẽ khiến bạn trở nên thật phong cách và thời thượng.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThiết kế sang trọng, đường may tinh xảo\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/a7/5f/ed/5ed701fe131ef0ae81470ff7b6081a0a.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eTúi du lịch Traveller là sản phẩm được đúc kết từ bàn tay và khối óc của những người thợ đầy tâm huyết của Sakos. Đây là một trong những bộ sưu tập dành tặng cho những người yêu thích du lịch nhưng ngại ký gởi hành lý vì nhiều rủi ro.\u003c/p\u003e\n\u003cp\u003eThuộc phân khúc túi du lịch nhưng sức chứa của Traveller không thua kém gì một chiếc vali. Với 2 size S và M giúp bạn thoải mái trong việc ký gởi hay muốn xách tay trong các chuyến bay quốc tế.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/29/7c/30/b981ca90d50ed706838ae99a3acdf386.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eVề thiết kế, dòng túi du lịch cao cấp này là một hình hộp chữ nhật nguyên khối được chia ra nhiều ngăn với những tính năng khác nhau. Quai xách được thiết kế to bản, được chốt bởi đai dán bảo vệ với lớp đệm êm ái mang lại cảm giác dễ chịu ngay cả khi bạn xách một khối lượng hành lý tương đối nặng. Hai đầu quai được may chắc chắn với đường chỉ tinh xảo vừa bền chắc vừa mang tính thẩm mỹ cao.\u003c/p\u003e\n\u003cp\u003eLogo Sakos – bảo chứng của chất lượng được in nổi ở vị trí trung tâm chiếc túi, tạo nên sự sang trọng, đẳng cấp cho dòng sản này.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eChất liệu chống nước hiệu quả xứng tầm tiêu chuẩn quốc tế\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eSakos Traveller được làm từ chất liệu Polyester siêu trượt nước, chống bám bụi và bền bỉ cùng thời gian khiến người dùng an tâm tuyệt đối về vấn đề ướt mưa.Phần khung bộ sưu tập này có cấu tạo từ các loại nhựa cao cấp với các đặc tính dẻo dai, chịu được nhiệt độ cao giúp chiếc túi trở nên khỏe khoắn một cách vững chãi.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/c0/43/0e/5b93e4924f78e515732ecc5f8a99a249.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eBên trong Traveller được tích hợp vải lót Poly 210D với khả năng chống nước, hút ẩm và kháng khuẩn hiệu quả giúp bạn yên tâm trong mọi điều kiện thời tiết.\u003c/p\u003e\n\u003cp\u003eTất cả dây kéo đều vận hành êm ái, mượt mà từ chất liệu nhựa dẻo cao cấp. Lá kéo bằng hợp kim nhôm chống gỉ, ánh kim sang trọng mang đến nét đẹp thuần khiết cho chiếc túi du lịch Traveller.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCấu trúc ngăn thông minh mang lại tiện ích vượt trội\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eSakos Traveller gồm ngăn chính có sức chứa lớn cùng nhiều ngăn phụ tiện dụng. Giữa các ngăn đều được trang bị đệm chống sốc, hạn chế tối đa trầy xước và xô lệch đồ đạc trong quá trình di chuyển.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/72/90/e9/3e010a88b5f3fd5e9223f29ca591db64.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eKhoang chính của Traveller rộng, chứa được tư trang cá nhân, thiết bị điện tử, vật dụng chuyên dụng cho các chuyến du lịch. Bên hông chiếc túi tích hợp hai ngăn phụ với khóa kéo chắc chắn, dễ dàng trích xuất đồ dùng khi cần thiết.\u003c/p\u003e\n\u003cp\u003eCác ngăn phụ được bố trí khắp bề mặt túi giúp người dùng không mất quá nhiều thời gian cho việc sắp xếp hành lý mà vẫn đảm bảo được sự gọn gàng, ngăn nắp.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/76/5a/b0/d7156dd412490bf145c4492d184c2a1f.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eMột chiếc túi du lịch đa năng và thời trang như Sakos Traveller đang khiến cho các tín đồ du lịch trở nên điêu đứng. Hãy nhanh tay xách ngay Traveller về để đồng hành cùng bạn trong các hành trình du lịch thú vị nhưng đầy thử thách.\u003c/p\u003e\n\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[