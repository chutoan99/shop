dex":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":3,"review_text":"(3)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/c6/5f/5a/09b09dd8d84bb00f79aeb6a925aededd.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":347,"all_time_quantity_sold":8,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2\u003e\u003cstrong\u003eAPPLIED NUTRITION CREATINE- HỖ TRỢ TĂNG SỨC BỀN\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003eBạn đã tập gym thì chắc hẳn đã nghe đến các sản phẩm dinh dưỡng thể thao của hãng \u003cstrong\u003e\u003ca href=\"https://wheytot.com/collections/applied-nutrition\"\u003eApplied Nutrition\u003c/a\u003e \u003c/strong\u003elà một thương hiệu nổi tiếng lâu đời được đầu tư kỹ lưỡng. Với chất lượng cao tăng tối đa sức mạnh giúp bạn bùng nổ trong những giờ tập luyện. \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCreatine\u003c/strong\u003e được phát hiện vào năm 1832 bởi một nhà khoa học người pháp mang tên\u003ca href=\"https://vi.wikipedia.org/wiki/Michel_Eug%C3%A8ne_Chevreul\"\u003e \u003cstrong\u003eMichel Eugène Chevreul\u003c/strong\u003e\u003c/a\u003e\u003cstrong\u003e \u003c/strong\u003esau khi ông chiết xuất và nghiên cứu thành công từ thịt bò ra.\u003c/p\u003e\n\u003cp\u003eNghiên cứu đã chỉ ra rằng Creatine làm tăng hoạt động của tế bào vệ tinh trong cơ thể con người. Sản phẩm cũng đã được chứng minh là làm tăng khả năng phục hồi các cơ bị tổn thương sau khi tập luyện và làm tăng trí nhớ, hiệu suất tập luyện.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cu\u003e\u003ca href=\"https://wheytot.com/blogs/tin-tuc/creatine-la-gi\"\u003eCreatine\u003c/a\u003e\u003c/u\u003e\u003c/strong\u003e phù hợp cho người tập thể dục cường độ cao hoặc kéo dài, muốn cải thiện hoạt động thể chất. Creatine cung cấp Creatine Monohydrate tinh khiết nhất, dễ hấp thụ nhất có nồng độ creatine giúp trì hoãn sự khởi đầu mệt mỏi, tăng chuyển hóa năng lượng trong các tế bào cơ và nâng cao khả năng tập luyện tổng thể.\u003c/p\u003e\n\u003cp\u003eApplied Nutrition sử dụng công nghệ lọc hiện đại sản xuất ra dòng sản phẩm Micronized siêu nhỏ, thẩm thấu nhanh chóng và dễ dàng đi vào nuôi dưỡng cơ bắp.\u003c/p\u003e\n\u003cp\u003eĐiểm cộng nữa là dạng bột siêu nhỏ và mịn nên rất dễ pha chế và sử dụng, không bị vón cục hay đọng cặn dưới đáy. Kết hợp pha chung với các sản phẩm whey, mass khác cũng không thành vấn đề.\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eLỢI ÍCH CHÍNH CREATINE:\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003eTăng hiệu suất thể chất trong các đợt tập luyện cường độ cao, ngắn hạn liên tiếp.\u003c/p\u003e\n\u003cp\u003eTăng cường năng lượng, sức mạnh và sức bền.\u003c/p\u003e\n\u003cp\u003eThích hợp cho người ăn chay.\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eTHÔNG TIN DINH DƯỠNG:\u003c/strong\u003e\u003c/h2\u003e\n\u003cdiv\u003e\n\u003cp\u003e\u003cimg src=\"https://file.hstatic.net/200000623631/file/z4703571752526_d41d376af8b58bb23a50481964d5fb34_32cf35ea34234a0cb872a483bb9e4e01_grande.jpg\" alt=\"z4703571752526_d41d376af8b58bb23a50481964d5fb34_32cf35ea34234a0cb872a483bb9e4e01_grande.jpg\" /\u003e\u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv\u003e4250mg Creatine Monohydrate.\u003c/div\u003e\n\u003cdiv\u003e\n\u003cp\u003e\u003cem\u003e*Thông tin dinh dưỡng phần mô tả sản phẩm chỉ đúng với 1 mùi vị nhất định của sản phẩm. Thành phần và hàm lượng sẽ được thay đổi (không đáng kể) theo từng mùi vị, từng lô sản xuất nhưng vẫn giữ được chức năng chính của sản phẩm.\u003c/em\u003e\u003c/p\u003e\n\u003c/div\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/c6/5f/5a/09b09dd8d84bb00f79aeb6a925aededd.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c6/5f/5a/09b09dd8d84bb00f79aeb6a925aededd.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c6/5f/5a/09b09dd8d84bb00f79aeb6a925aededd.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c6/5f/5a/09b09dd8d84bb00f79aeb6a925aededd.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c6/5f/5a/09b09dd8d84bb00f79aeb6a925aededd.png"},{"base_url":"https://salt.tikicdn.com/ts/product/e2/1f/a2/82e1c9a35720a790381a81461fa37100.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e2/1f/a2/82e1c9a35720a790381a81461fa37100.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e2/1f/a2/82e1c9a35720a790381a81461fa37100.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e2/1f/a2/82e1c9a35720a790381a81461fa37100.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e2/1f/a2/82e1c9a35720a790381a81461fa37100.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/a2/fa/51/a422d0d67977b6b1c58f4ea9a0cbf630.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a2/fa/51/a422d0d67977b6b1c58f4ea9a0cbf630.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a2/fa/51