7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.6,"review_count":24,"review_text":"(24)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/98/7c/e1/5d213dd2660fc6286da590a896897a3e.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1180,"all_time_quantity_sold":81,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3 style=\"text-align:center;\"\u003e\u003cspan style=\"color:#ff0000;\"\u003eCOMBO 2 HỘP - TIẾT KIỆM HƠN, ƯU ĐÃI HƠN!!!\u003c/span\u003e\u003c/h3\u003e\n\u003ch3\u003eLineabon K2+D3 hay còn gọi K2D3 là sản phẩm vitamin D3 nhỏ giọt nhập khẩu từ châu Âu đầu tiên chứa cả Vitamin D3 và MK7 (Vitamin K2 tự nhiên) giúp hấp thu tối đa canxi vào xương, giải quyết nhanh chóng tình trạng còi xương và giúp tăng chiều cao vượt trội cho trẻ sơ sinh và trẻ nhỏ.\u003cbr /\u003e+ D3 giúp tăng hấp thu Canxi tại ruột non.\u003cbr /\u003e+ K2 giúp kéo canxi vào đúng vị trí xương và răng, không bị lắng đọng canxi ở mạch máu và mô mềm như gan, thận, mắt … lâu dài có thể gây ảnh hưởng không tốt cho cơ thể.\u003c/h3\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch3\u003eBIỂU HIỆN THIẾU CANXI Ở TRẺ - ĐẾN LÚC PHẢI DÙNG LINEBON K2D3\u003c/h3\u003e\n\u003cp\u003e+ Mất ngủ hay khóc quấy ban đêm, Khó ngủ\u003cbr /\u003e+ Bị còi xương, chiều cao phát triển không đạt yêu cầu theo độ tuổi (khi đi chích ngừa thường sẽ được cân đo, các mẹ lấy số liệu này đối chiếu với bảng tiêu chuẩn hình bên trên nhé).\u003cbr /\u003e+ Tay chân hay bị chuột rút\u003cbr /\u003e+ Tóc mỏng, rụng nhiều, rụng tóc vành khăn\u003cbr /\u003e+ Ra nhiều mồ hôi trộm\u003c/p\u003e\n\u003ch3\u003eCÔNG DỤNG:\u003c/h3\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ec/7c/b4/46e3324e90e933d53e604d50fb67b18e.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003cbr /\u003e+ Giúp bé hấp thu nhanh: Công nghệ bao vi nang giúp các phân tử vitamin D3 và MK7 cực kì ổn định, dễ dàng chui qua màng tế bào, dễ hấp thu mà không bị dịch vị dạ dày phân hủy, giúp việc tăng chiều cao nhanh chóng, trẻ hết còi xương.\u003cbr /\u003e+ Tăng chiều cao tối đa: Nhờ bộ đôi vitamin D3 và Vitamin K2 trong Lineabon K2+D3, canxi sẽ được tăng hấp thu tối đa tới tận xương giúp xương của trẻ phát triển chắc khỏe và tăng chiều cao, giúp trẻ hết còi xương, thích hợp sử dụng cho cả những trẻ có cơ địa khó hấp thu canxi.\u003cbr /\u003e+ Giảm thiểu chứng ra mồ hôi trộm và mang đến cho con một giấc ngủ sâu và ngon hơn\u003cbr /\u003e+ Công nghệ SX hiện đại chiết xuất vitamin D3 và MK7 từ tự nhiên, không chất bảo quản, không lactose, kim loại, GMO, hương liệu…AN TOÀN với cả trẻ sơ sinh, trẻ có cơ địa khó hấp thu canxi, trẻ không dung nạp lactose…\u003cbr /\u003e+ Giảm hủy xương, tăng tạo xương\u003c/p\u003e\n\u003ch3\u003eTHÀNH PHẦN\u003c/h3\u003e\n\u003cp\u003eThành phần trong 0,2ml tương đương với 6 giọt siro Lineabon K2D3:\u003cbr /\u003e+ Vitamin K2 (MK-7): 22,5mcg\u003cbr /\u003e+ Vitamin D3: 400 IU\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/3b/18/c2/8c47ffc460f6d02eaecc69ead814bb67.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch3\u003eCÁCH SỬ DỤNG\u003c/h3\u003e\n\u003cp\u003e+ Trẻ em từ 0-12 tháng: 6 giọt/ngày\u003cbr /\u003e+ Trẻ em từ 1-3 tuổi: 6-8 giọt/ngày\u003cbr /\u003e+ Trẻ em từ 3-12 tuổi: 8-12 giọt/ngày\u003cbr /\u003e+ Người lớn: 12 giọt/ngày\u003cbr /\u003e*** Sử dụng trước 11h sáng/ngày\u003cbr /\u003e\u003cbr /\u003e\u003cstrong\u003e\u003cspan style=\"color:#0000ff;\"\u003eTHÔNG TIN THÊM\u003c/span\u003e\u003c/strong\u003e\u003cbr /\u003eCác SP bổ sung Canxi thông thường sẽ phải sử dụng cách tháng, tạm ngưng để tránh tình trạng tích tụ Canxi (Cơ thể cần thời gian để thanh lọc lượng Canxi không hấp thụ hết, rồi mới sử dụng tiếp). Tuy nhiên, Lineabon K2D3 không có Canxi, là sản phẩm giúp tăng hấp thu canxi, nên không cần lo ngại về việc tích tụ Canxi, bên cạnh đó, liều lượng D3 ở trong sản phẩm tuân theo quy chuẩn của Bộ Y Tế là 400 IU/ ngày, nên có thể sử dụng liên tiếp - KHÔNG CẦN CÁCH THÁNG.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/98/7c/e1/5d213dd2660fc6286da590a896897a3e.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/98/7c/e1/5d213dd2660fc6286da590a896897a3e.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/98/7c/e1/5d213dd2660fc6286da590a896897a3e.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/98/7c/e1/5d213dd2660fc6286da590a896897a3e.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/98/7c/e1/5d213dd2660fc6286da590a896897a3e.png"},{"base_url":"https://salt.tikicdn.com/ts/product/ec/7c/b4/f555c1785853968800a5233de9ebcc3c.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ec/7c/b4/f555c1785853968800a5233de9ebcc3c.jpg","medium_url":"https://sal