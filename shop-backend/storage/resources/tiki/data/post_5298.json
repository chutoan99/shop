ight":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":622000,"discount_rate":19,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/59/d9/8b/aedc224b02ec8039a41365873a879ab6.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2366,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch5\u003eThiết kế nhỏ gọn, tiện lợi\u003c/h5\u003e\n\u003cp\u003e\u003cstrong\u003eNồi Lẩu Điện 2 Trong 1 Tiger Queen SQ-2200\u003c/strong\u003e có kiểu dáng nhỏ gọn với thiết kế hình hộp vuông độc đáo kết hợp với gam màu đen tinh tế, góp phần làm cho không gian bếp của bạn trở nên đẹp hơn, sang trọng hơn. Dung tích nồi lên đến 4L, thoải mái chế biến thực phẩm với số lượng lớn, giúp tiết kiệm được nhiều thời gian nấu, rất thích hợp cho gia đình từ 6 - 7 người.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://vcdn.tikicdn.com/ts/tmp/7c/e0/ec/19fb31bc21dd1c7f1f694049da416b8e.jpg\" alt=\"\" width=\"850\" height=\"567\" /\u003e\u003c/p\u003e\n\u003ch5\u003eCông suất hoạt động mạnh mẽ\u003c/h5\u003e\n\u003cp\u003eSản phẩm có công suất hoạt động mạnh mẽ, giúp bạn và những người thân yêu trong gia đình sẽ có những bữa ăn tuyệt vời. Với lẩu điện này, giờ đây bạn không còn phải chuẩn bị bếp gas, lửa cồn,... nồi, xoong, mất thời gian. Việc duy nhất phải làm là cắm điện, cho lẩu vào nồi rồi vặn nút, đậy nắp chờ xôi thế là đã có 1 bữa lẩu ngon lành xôi liên tục. \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://vcdn.tikicdn.com/ts/tmp/56/18/a1/4e91048b4179ca0d93a2bb714df737a4.jpg\" alt=\"\" width=\"850\" height=\"567\" /\u003e\u003c/p\u003e\n\u003ch5\u003eChất liệu cao cấp\u003c/h5\u003e\n\u003cp\u003eĐặc biệt, nồi gồm 2 lòng làm bằng chất liệu tráng men chống dính tia hồng ngoại cao cấp: lòng nồi chiên chống dính và lòng nồi lẩu chống dính. Hơn nữa, lòng nồi có thể nhấc ra và rửa như thông thường, còn khuôn nồi thì chỉ cần lau chùi bằng miếng vải mềm, rất đơn giản. Phần nắp bằng kính trong suốt chịu nhiệt cao, giúp bạn dễ dàng quan sát được quá trình nấu bên trong cùng với tay cầm không nóng, đảm bảo an toàn, thao tác dễ dàng.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://vcdn.tikicdn.com/ts/tmp/a2/f5/d9/0d378f739b6d1bfeb7e73ce6cf020d79.jpg\" alt=\"\" width=\"850\" height=\"567\" /\u003e\u003c/p\u003e\n\u003ch5\u003eĐa chức năng nấu\u003c/h5\u003e\n\u003cp\u003eNồi lẩu điện Tiger Queen SQ-2200 được tích hợp với 7 chức năng nấu: lẩu, nướng, rang, chiên, xào, hầm, luộc cùng 5 mức điều chỉnh nhiệt độ đến 250ºC phù hợp với từng loại nguyên liệu. Và khả năng làm nóng nhanh tiết kiệm thời gian với chức năng ngắt nhiệt tự động giúp tiết kiệm điện hiệu quả.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://vcdn.tikicdn.com/ts/tmp/a1/cf/2b/c96cd36a283a2bbff14e72ca2195c722.jpg\" alt=\"\" width=\"850\" height=\"567\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/59/d9/8b/aedc224b02ec8039a41365873a879ab6.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/59/d9/8b/aedc224b02ec8039a41365873a879ab6.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/59/d9/8b/aedc224b02ec8039a41365873a879ab6.jpg","po