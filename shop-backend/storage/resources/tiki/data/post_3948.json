ount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/89/fb/81/c056157d9a37c8fa350e8bc30ea88e32.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":586,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eMột tai nghe nhỏ gọn nhưng mang lại những âm thanh trung thực đầy mạnh mẽ độc quyền của thương hiệu danh tiếng \u003cstrong\u003eJBL\u003c/strong\u003e cùng khả năng kết nối và đàm thoại tuyệt vời. Bên cạnh đó \u003cstrong\u003etai nghe JBL\u003c/strong\u003e Live Pro \u0026#43; TWS với các tính năng chống ồn chủ động, Smart Ambient, điều khiển bằng giọng nói cùng thời lượng pin khủng sẽ giúp bạn kết nối với thế giới giải trí của riêng mình mọi lúc mọi nơi. Từ công sở cho đến những phòng gym, từ trong nhà cho đến không gian ngoài trời.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/91/67/29/fdbd2f2152c763edf00aba7a04cb8f47.jpg\" alt=\"\" width=\"750\" height=\"937\" /\u003e\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eThiết kế nhỏ gọn, bám tai tốt, chống nước IPX4\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003eTai nghe ‎‎JBL Live Pro\u0026#43; có thiết kế nhỏ gọn‎ chỉ nặng có 5g với kích thước 3,6 x 2 x 2 cm mỗi bên, hộp sạc cũng chỉ nặng 49,5g. Do đó, người dùng có thể dễ dàng mang theo, thậm chí cả khi sử dụng những túi đeo siêu nhỏ.\u003c/p\u003e\n\u003cp\u003eTai nghe có thiết kế bám tai, bạn có thể thoải mái nghe nhạc, di chuyển, vận động nhẹ nhàng mà không lo bị rơi ra. Đặc biệt, JBL Live Pro\u0026#43; TWS‎‎ được chứng nhận IPX4 giúp chống mồ hôi, chống nước nhẹ và chống va đập. Hãng còn tặng kèm 5 cặp nút tai nghe giúp kích cỡ khác nhau để bạn chắc chắn sẽ chọn được kích thước vừa vặn cho mình. ‎‎JBL Live Pro\u0026#43; có 4 màu cực trendy và cũng rất dễ phối đồ là Đen, Trắng, Hồng và Be.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/51/5b/45/855c43af8188c8f1b8383c0c13219f5a.PNG\" alt=\"\" width=\"750\" height=\"904\" /\u003e\u003c/p\u003e\n\u003cp\u003e‎Sản phẩm này được hỗ trợ điều khiển bằng cảm ứng cực nhạy và việc sử dụng chúng cũng trở nên dễ dàng hơn bao giờ hết. Bạn có thể nhấn một lần để trả lời hoặc kết thúc cuộc gọi, nhấn và giữ để truy cập trợ lý giọng nói của điện thoại hoặc giữ trong ba giây để tắt tiếng và bật tiếng micro khi bạn đang gọi. Một lần nhấn vào tai nghe bên trái sẽ bật hoặc tắt ANC trong khi hai lần nhấn sẽ kích hoạt chế độ Smart Ambient, cho phép bạn nghe thấy môi trường xung quanh trong khi vẫn tận hưởng âm nhạc. Trên tai nghe bên phải, một lần nhấn sẽ phát hoặc tạm dừng âm thanh, hai lần nhấn sẽ chuyển sang bản nhạc tiếp theo, trong khi ba lần nhấn sẽ chuyển về bản nhạc liền trước đó. \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/88/32/6a/3bcec5d801452dd9544020c6fbe90370.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eÂm thanh JBL Signature đặc trưng mang đến một một trải nghiệm âm nhạc tuyệt vời\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003e‎Tai nghe ‎‎JBL Live Pro\u0026#43; TWS‎‎ nhỏ nhưng vô cùng mạnh mẽ. Sản phẩm này sở hữu trình điều khiển 11mm với Âm thanh đặc trưng JBL vượt trội mọi lúc mọi nơi. Tai nghe cũng hỗ trợ cho cả 2 hệ điều hành Android và iOS, đem đến trải nghiệm âm nhạc đỉnh cao. \u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003e‎Khử tiếng ồn thích ứng với môi trường xung quanh thông minh‎\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003e‎Khi muốn tập trung hoàn toàn cho công việc, luyện tập hay chìm đắm hoàn toàn trong thế giới âm nhạc, chức năng khử tiếng ồn chủ động ANC của tai nghe sẽ giúp lọc các tạp âm hiệu quả và liên tục. Và nếu bạn muốn nghe những gì đang diễn ra xung quanh mình mà không cần tháo ‎‎tai nghe‎‎, Smart Ambient sẽ tăng cường âm thanh của môi trường xung quanh, để vừa trải nghiệm âm nhạc mà không bỏ lỡ những thông tin cần thiết khi làm việc, vừa nhận hướng dẫn từ các hướng dẫn viên khi tập luyện hay nghe được những âm thanh cảnh báo khi tham gia giao thông. \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/dd/61/46/83270189b14687a087ab948f6760474a.jpg\" alt=\"\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003e‎Thời lượng pin lên đến 28 giờ, tích hợp tính năng sạc nhanh và sạc không dây‎\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003e‎Với tối đa 7 giờ phát nhạc khi tắt tính năng ANC (chống ồn chủ động) và 6 giờ khi bật ANC, cộng với 21 giờ thêm từ hộp sạc, tai nghe JBL Live Pro\u0026#43; TWS có thể đồng hành cùng bạn suốt cả ngày. ‎‎Tai nghe còn tích hợp sạc nhanh và sạc không dây tương thích với Qi dễ sử dụng và tiện lợi khi bạn cần gấp.‎ Chỉ mất 2 giờ để sạc đầy là bạn đã có thể thoải mái tận hưởng âm nhạc suốt ngày dài.\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003e‎6 micro cho cuộc gọi hoàn hảo không có tiếng ồn‎\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003e‎Bạn có một cuộc họp trực tiếp, một cuộc đàm thoại quan trọng? Không cần lo lắng vì lời nói của bạn được chuyển tiếp hoàn hảo sang đầu bên kia nhờ công nghệ cách ly tiếng ồn và tạp âm bên ngoài. Bên cạnh đó, micro kép ở mỗi bên tai giúp ghi lại giọng nói của bạn một cách rõ nét. Điều này mang lại cho bạn cảm giác như tham gia một cuộc trò chuyện, hội thảo trực tiếp.‎\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/7c/13/68/0bfc0658fcff943a6b339f2cce6db246.jpeg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003e‎Kết nối kép, đồng bộ hóa và ghép nối nhanh‎\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003eNgay sau khi mở hộp sạc, tai nghe sẽ tự động ghép nối với thiết bị của người dùng đã kết nối gần nhất và sẵn sàng để nghe nhạc, thực hiện cuộc gọi mono/stereo hoặc sử dụng Trợ lý giọng nói ở một hoặc cả hai tai. Hơn nữa, ứng dụng JBL giúp việc gán chức năng cho từng tai nghe trở nên dễ dàng hơn bao giờ hết. Khi bật Tính năng Ghép nối nhanh của Google, JBL Live Pro\u0026#43; TWS được kết nối ngay lập tức với điện thoại của bạn. Bạn cũng có thể ghép nối điện thoại với các thiết bị JBL khác bằng cách nhấn vào hình ảnh sản phẩm tương ứng trên màn hình.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/e9/3e/53/73b02ab196d9f4387441726102aa4d8d.jpeg\" alt=\"\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eTạo ra không gian âm nhạc của riêng bạn với Ứng dụng JBL\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003eÂm thanh và chức năng của tai nghe JBL Live Pro\u0026#43; TWS có thể dễ dàng điều chỉnh với Ứng dụng JBL sử dụng hoàn toàn miễn phí. Thay đổi bộ EQ, chọn Trợ lý giọng nói yêu thích của bạn và kiểm tra đầu tai tối ưu cho tai của bạn chỉ trong vài phút.‎\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eĐiều khiển bằng trợ lý giọng nói\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003eKích hoạt tính năng trợ lý giọng nói Hey Google và Alexa nhanh chóng bằng cách chạm vào tai nghe. Sau đó, bạn có thể dễ dàng kích hoạt ANC, Smart Ambient, kiểm tra pin, tắt nguồn chỉ bằng giọng nói. Người dùng cũng có thể dễ dàng thiết lập trợ lý giọng nói ưa thích qua ứng dụng JBL. Tuy nhiên, tính năng này chỉ hỗ trợ cho Android 6.0 trở lên.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh th