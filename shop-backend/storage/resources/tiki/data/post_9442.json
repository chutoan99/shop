dn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":34000,"discount_rate":17,"rating_average":4.6,"review_count":42,"review_text":"(42)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/c7/90/85/bef61acb59197327bb57ab5a1903bfd6.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":284,"all_time_quantity_sold":208,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cspan style=\"color:#ff0000;\"\u003e\u003cstrong\u003eCHÚ Ý: lần đầu sử dụng, quý khách hàng vui lòng bóc seal ở chân sạc tai nghe để sử dụng ạ\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eKhám Phá Âm Nhạc Tuyệt Vời Cùng Tai Nghe Bluetooth RIBI G60: Sự Kết Hợp Hoàn Hảo Giữa Chất Lượng và Tiện Nghi\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eHòa mình trong trải nghiệm âm thanh tuyệt vời với Tai Nghe Bluetooth G60, người bạn hoàn hảo cho những người yêu thích âm nhạc. Dưới đây là những tính năng nổi bật giúp RiBi G60 trở nên đặc sắc:\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e1. Bluetooth 5.2 - Kết Nối Mượt Mà:\u003c/strong\u003e Trải nghiệm kết nối mượt mà với công nghệ Bluetooth 5.2 tiên tiến. Không chỉ mang lại kết nối mạnh mẽ, mà nó còn tăng cường tốc độ truyền dữ liệu, giúp bạn thưởng thức âm nhạc mà không bị gián đoạn.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e2. Thiết Kế Nhỏ Gọn - Mang Theo Dễ Dàng:\u003c/strong\u003e G60 tự hào với thiết kế nhỏ gọn và nhẹ, là sự kết hợp hoàn hảo giữa phong cách và tiện ích. Đặt chúng vào túi của bạn và bắt đầu hành trình âm nhạc của mình mọi lúc, mọi nơi.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ca/fa/65/787f44fabf299534624af7adf4f7d1ce.jpg\" alt=\"\" width=\"750\" height=\"1149\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e3. Âm Thanh Stereo - Chất Lượng Audio Tốt Nhất:\u003c/strong\u003e Được trang bị loa driver 13mm, G60 mang đến âm thanh stereo rõ ràng và phong phú. Dừng lại và lắng nghe từng nốt nhạc như chưa bao giờ có.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/0e/10/09/8b8d5c000047b3dd0d41c6e419022e0c.jpg\" alt=\"\" width=\"750\" height=\"1347\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e4. Âm Thanh Vòm 360 Độ - Ngập Tràn Không Gian Âm Nhạc:\u003c/strong\u003e Trải nghiệm âm thanh vòm 360 độ, đưa bạn vào không gian âm nhạc hoàn hảo. Mọi chi tiết âm thanh được tái tạo sống động, đưa bạn đến những trải nghiệm âm nhạc mới mẻ.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/e5/4f/0d/7a2269cc5188a60a360f7cd4f5f770b6.jpg\" alt=\"\" width=\"750\" height=\"1241\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e5. Sử Dụng Liên Tục Đến 8 Giờ - Thưởng Thức Âm Nhạc Mọi Lúc:\u003c/strong\u003e Với thời lượng pin lên đến 8 giờ, G60 đảm bảo bạn có đủ thời gian để thưởng thức âm nhạc mà không lo lắng về việc sạc lại.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/53/13/2e/2b0f13a39f36e104d68c989ad4e48667.jpg\" alt=\"\" width=\"520\" height=\"755\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e6. Sạc Type-C - Nhanh Chóng và Tiện Lợi:\u003c/strong\u003e Việc tích hợp sạc Type-C mang lại sự tiện lợi hiện đại. Thưởng thức thời gian sạc nhanh và kết nối không gặp trở ngại với cổng giao tiếp phổ biến Type-C.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e7. Mang Theo Thoải Mái - Thưởng Thức Qua Cả Ngày:\u003c/strong\u003e Được thiết kế để thoải mái, G60 mang đến trải nghiệm đeo êm ái. Thiết kế nhẹ và ergonomic đảm bảo bạn có thể đeo chúng trong thời gian dài mà không gặp bất kỳ sự khó chịu nào.\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/c9/61/e3/4275509ceaa682ec617666f46d48c78a.png\" alt=\"\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/59/b6/c8/72a2d6cc0d5b4a4e6ca164d8b98126b4.png\" alt=\"\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/72/a2/52/f3b60894bcaf9056f4b015203524158e.png\" alt=\"\" /\u003e\u003c/p\u003e\n\u003cp\u003eNhấn play và bắt đầu hành trình âm nhạc của bạn với Tai Nghe Bluetooth G60 - nơi chất lượng gặp gỡ với sự tiện lợi. Hãy thưởng thức âm thanh cuốn hút và sự thoải mái tối đa!\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/7d/ae/20/c88de12f62ea17b85351cd07bb586fa9.jpg\" alt=\"\" width=\"750\" height=\"1189\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/2a/ab/10/ceeff995221188d5c3747ba4ee09de13.jpg\" alt=\"\" width=\"750\" height=\"905\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/99/d3/42/ab3903f7d7e953449c0089de1085e243.jpg\" alt=\"\" width=\"750\" height=\"1000\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/c7/90/85/bef61acb59197327bb57ab5a1903bfd6.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c7/90/85/bef61acb59197327bb57ab5a1903bfd6.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c7/90/85/bef61acb59197327bb57ab5a1903bf