0f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":215000,"discount_rate":13,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/65/48/cb/ad10c2b941428d0d997cc16053339289.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1567,"all_time_quantity_sold":6,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/4a/22/8e/0209a6908451a6f8fb15558655577104.jpg\" alt=\"Nồi Cơm Điện Tử Toshiba RC-10DH2PV(W) - Hàng chính hãng\" width=\"750px\" height=\"547px\" /\u003e\u003c/p\u003e\n\u003ch5\u003e\u003cstrong\u003eKiểu dáng nhỏ gọn, thời trang\u003c/strong\u003e\u003c/h5\u003e\n\u003cp\u003e\u003cstrong\u003eNồi Cơm Điện Tử Toshiba RC-10DH2PV\u003c/strong\u003e có dạng hình chữ nhật đơn giản với màu trắng sang trọng, góp phần tô điểm thêm cho không gian bếp. Nồi có dung tích 1 lít cung cấp đủ cơm nóng cho gia đình có từ 2 - 4 thành viên. Thân nồi được làm bằng chất liệu cao cấp, bền bỉ, chịu nhiệt, chịu lực tốt, không bị biến dạng khi va chạm. Bề mặt sáng bóng, cách nhiệt nên hạn chế tình trạng nóng tay khi tiếp xúc với nồi.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/d8/14/7a/8a5432255fda3402e05a13043016625a.jpg\" alt=\"\" width=\"750\" height=\"415\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/a7/7f/bd/d066a4736f3669cf8e4b1da42a936a04.jpg\" alt=\"\" width=\"750\" height=\"415\" /\u003e\u003c/p\u003e\n\u003ch5\u003eLòng nồi chống dính, an toàn\u003c/h5\u003e\n\u003cp\u003eLòng nồi bằng hợp kim nhôm dày 2.2 mm, có tới 4 lớp phủ chống dính an toàn cho sức khỏe, cho nhiệt lượng tỏa đều truyền đến từng hạt gạo giúp cơm thơm ngon, hấp dẫn.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/92/ba/49/7bfcbe899cee7af51b1a39c7a3c331a2.jpg\" alt=\"\" width=\"750\" height=\"415\" /\u003e\u003c/p\u003e\n\u003ch5\u003eNấu cơm nhanh chóng, tiết kiệm thời gian\u003c/h5\u003e\n\u003cp\u003eCông suất 605W kết hợp với mâm nhiệt lớn đảm bảo cơm được nấu chín đều và nhanh chóng, tiết kiệm tối đa thời gian của bạn. Ngoài ra nồi còn được trang bị van thoát khí thông minh giúp giữ lại các dưỡng chất và vitamin có trong cơm.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/9a/13/c9/331a5467bc3c52bf97308146e44fbd28.jpg\" alt=\"\" width=\"750\" height=\"535\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/93/18/79/d681faacf5d10859ebf5ac945f0be9ea.jpg\" alt=\"\" width=\"750\" height=\"415\" /\u003e\u003c/p\u003e\n\u003ch5\u003eChế độ nấu đa dạng, nhiều tiện ích\u003c/h5\u003e\n\u003cp\u003eNồi đa dạng chế độ nấu như nấu cơm, cháo, làm bánh, nấu súp, canh, nước lè cho bữa ăn gia đình thêm phần phong phú.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/a8/e1/53/8ce174e30ea7009c8b1ee0b7c4da9f5a.jpg\" alt=\"\" width=\"750\" height=\"415\" /\u003e\u003c/p\u003e\n\u003cp\u003eBảng điều khiển hiện đại kết hợp với nút ấn dễ sử dụng. Màn hình LCD giúp người dùng tiện theo dõi quá trình nấu.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/66/49/05/30a0c6a0b38b520e400444ed3cf34af9.jpg\" alt=\"\" width=\"750\" height=\"415\" /\u003e\u003c/p\u003e\n\u003cp\u003eDây điện được tháo rời, tiện lợi khi di chuyển cũng như bảo quản nồi. Chức năng hẹn giờ nấu tự động giúp bạn linh hoạt hơn trong việc sắp xếp các công việc nhà. \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/27/bb/4a/947a8a4bf51722005139a681c7bf48d2.jpg\" alt=\"\" width=\"750\" height=\"415\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ae/a6/1d/e0c72a8df3cd1a39372e8dc15bc6e9a6.jpg\" alt=\"\" width=\"750\" height=\"415\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/65/48/cb/ad10c2b941428d0d997cc16053339289.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/65/48/cb/ad10c2b941428d0d997cc16053339289.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/65/48/cb/ad10c2b941428d0d997cc16053339289.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/65/48/cb/ad10c2b941428d0d997cc16053339289.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/65/48/cb/ad10c2b941428d0d997cc16053339289.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/b2/61/b5/60ed6bdabc90c3589cec9aac07a87f5d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b2/61/b5/60ed6bdabc90c3589cec9aac07a87f5d.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b2/61/b5/60ed6bdabc90c3589cec9aac07a87f5d.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b2/61/b5/60ed6bdabc90c3589cec9aac07a87f5d.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b2/61/b5/60ed6bdabc90c3589cec9aac07a87f5d.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/68/f2/21/e45529b9160a806cfc93930503793c26.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/6