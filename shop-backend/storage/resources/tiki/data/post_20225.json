on_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/e0/fe/3a/4298d31514bd7c8f3e7209f6ee38368c.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2169,"all_time_quantity_sold":15,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2 style=\"box-sizing: border-box; margin: 15px auto 10px; padding: 0px 0px 2px; font-family: Arial, sans-serif; font-weight: 500; line-height: 1.1; color: #333333; font-size: 19px; text-align: center;\"\u003e\u003cspan style=\"box-sizing: border-box; margin: 0px; padding: 0px; font-size: 18pt;\"\u003e\u003cspan style=\"box-sizing: border-box; margin: 0px; padding: 0px; font-weight: bold;\"\u003eGH-Creation tăng chiều cao cho người dưới 30 tuổi\u003c/span\u003e\u003c/span\u003e\u003c/h2\u003e\n\u003cp style=\"box-sizing: border-box; margin: 0px 0px 10px; padding: 0px; color: #333333; font-family: Arial, sans-serif; text-align: justify;\"\u003eGH là viết tắt của một loại nội tiết tố tăng trưởng đóng vai trò quan trọng trong chiều cao con người. Nội tiết tố GH giúp kích thích sự phát triển của mô sụn đầu các xương dài làm thân xương dài ra và cốt hóa trước tuổi trưởng thành. Sản sinh nội tiết tố tăng trưởng là yếu tố đầu tiên quan trọng nhất cần thiết để phát triển chiều cao.\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 0px 0px 10px; padding: 0px; color: #333333; font-family: Arial, sans-serif; text-align: justify;\"\u003eGH-Creation là thực phẩm chức năng hỗ trợ phát triển chiều cao nổi tiếng của Nhật Bản dành cho độ tuổi từ 10 đến 30 tuổi. GH-Creation Nhật Bản là sự kết hợp các chất dinh dưỡng, bổ sung dưỡng chất giúp cải thiện, tăng cường nội tiết tố tăng trưởng giúp bạn có thể phát triển chiều cao tối đa\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 0px 0px 10px; padding: 0px; color: #333333; font-family: Arial, sans-serif; text-align: center;\"\u003e\u003cimg style=\"box-sizing: border-box; margin: 0px; padding: 0px; border: 0px; vertical-align: middle;\" src=\"https://salt.tikicdn.com/ts/product/cb/31/cc/fc7c54380ce0eb37022b135506dc1497.jpg\" alt=\"GH-Creation - Viên Uống Tăng Chiều Cao Nhật Bản\" /\u003e\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 0px 0px 10px; padding: 0px; color: #333333; font-family: Arial, sans-serif; text-align: center;\"\u003e\u003cspan style=\"box-sizing: border-box; margin: 0px; padding: 0px; font-size: 10pt;\"\u003e\u003cem style=\"box-sizing: border-box; margin: 0px; padding: 0px;\"\u003eGH-Creation - Viên Uống Tăng Chiều Cao Nhật Bản dưới 30 tuổi\u003c/em\u003e\u003c/span\u003e\u003c/p\u003e\n\u003ch3 style=\"box-sizing: border-box; margin: 15px auto 10px; padding: 0px 0px 2px; font-family: Arial, sans-serif; font-weight: 500; line-height: 1.1; color: #333333; font-size: 24px; text-align: justify;\"\u003e\u003cspan style=\"box-sizing: border-box; margin: 0px; padding: 0px; font-size: 12pt;\"\u003e\u003cspan style=\"box-sizing: border-box; margin: 0px; padding: 0px; font-weight: bold;\"\u003eGH-Creation hoạt động như thế nào\u003c/span\u003e\u003c/span\u003e\u003c/h3\u003e\n\u003cp style=\"box-sizing: border-box; margin: 0px 0px 10px; padding: 0px; color: #333333; font-family: Arial, sans-serif; text-align: justify;\"\u003eTùy theo thể trạng cơ thể, khả năng hấp thu của từng người mà GH-Creation có thể hỗ trợ tăng chiều cao từ 3 đến 9 cm. Ở người lùn thường có nồng độ GH trong máu thấp hơn so với các bạn khác cùng tuổi do thùy trước tuyến yên sản xuất GH cung không đủ cầu.\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 0px 0px 10px; padding: 0px; color: #333333; font-family: Arial, sans-serif; text-align: justify;\"\u003eGH-Creation có tên đầy đủ GH-creation hi support supplement là thực phẩm chức năng giúp bổ sung các hoạt chất kích thích hormon tăng trưởng tự nhiên trong cơ thể sản sinh một cách tự nhiên, không gây tác dụng phụ.\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 0px 0px 10px; padding: 0px; color: #333333; font-family: Arial, sans-serif; text-align: justify;\"\u003eKhông chỉ kích thích sự phát triển các mô sụn đầu xương, giúp xương dài ra, GH-Creation còn giúp tăng độ dày và độ đàn hồi của da, rút ngắn thời gian phục hồi sau chấn thương hoặc phẫu thuật.\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 0px 0px 10px; padding: 0px; color: #333333; font-family: Arial, sans-serif; text-align: center;\"\u003e\u003cimg style=\"box-sizing: border-box; margin: 0px; padding: 0px; border: 0px; vertical-align: middle;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/e7/96/24/e0d0f9efaf89f18412f9465d3d894123.jpg\" alt=\"GH-Creation - Viên Uống Tăng Chiều Cao Nhật Bản\" /\u003e\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 0px 0px 10px; padding: 0px; color: #333333; font-family: Arial, sans-serif; text-align: center;\"\u003e\u003cspan style=\"box-sizing: border-box; margin: 0px; padding: 0px; font-size: 10pt;\"\u003e\u003cem style=\"box-sizing: border-box; margin: 0px; padding: 0px;\"\u003eNội tiết tố tăng trưởng hoạt động mạnh mẽ ở độ tuổi 10-15, giảm dần từ độ tuổi 20-25 đến đầu năm 30 tuổi\u003c/em\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 0px 0px 10px; padding: 0px; color: #333333; font-family: Arial, sans-serif; text-align: center;\"\u003e\u003cimg style=\"box-sizing: border-box; margin: 0px; padding: 0px; border: 0px; vertical-align: middle;\" src=\"htt