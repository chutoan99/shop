ttps://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":31937,"discount_rate":16,"rating_average":5,"review_count":165,"review_text":"(165)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/df/12/9d/1fa00fa2473e17471a881e73a8d6fbe4.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":882,"all_time_quantity_sold":3895,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eCÀ PHÊ HÒA TAN G7 3IN1 – BỊCH 50 SACHETS X 16GR\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eBỘ SẢN PHẨM BAO GỒM: \u003cbr /\u003eTúi 50 gói vuông x 16gr\u003cbr /\u003e\u003cbr /\u003eĐẶC ĐIỂM NỔI BẬT:\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eCà phê G7 3in1 được 89% người tiêu dùng bình chọn là sản phẩm yêu thích hơn các loại cà phê hòa tan khác tại sự kiện thử mùi trực tiếp năm 2003.\u003c/li\u003e\n\u003cli\u003eG7 là sản phẩm cà phê hòa tan duy nhất được chọn phục vụ các nguyên thủ quốc gia tại APEC, ASEM 5.\u003c/li\u003e\n\u003cli\u003eCà phê G7 3in1 mang đến sự tiện lợi cho người sử dụng: bạn không mất nhiều thời gian nhưng vẫn có được ly cà phê với hương vị đậm đà, quyến rũ.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cbr /\u003eTHÀNH PHẦN: \u003cbr /\u003eĐường, Bột kem (có chứa đạm sữa), hỗn hợp cà phê hòa tan (12,5% cà phê Robusta, 0,5% đậu nành), maltodextrin, cà phê rang xay nhuyễn (0.5%), muối i-ốt, hương liệu Cà phê tổng hợp dùng trong thực phẩm. \u003cbr /\u003e\u003cbr /\u003eHƯỚNG DẪN SỬ DỤNG: \u003cbr /\u003eUống nóng: Hòa 1 gói cà phê với 75ml nước nóng (80°C-100°C) khuấy đều và thưởng thức \u003cbr /\u003eUống đá: Hòa 2 gói cà phê với 75ml nước nóng (80°C-100°C) khuấy đều, cho thêm khoảng 100g đá vào và thưởng thức. \u003cbr /\u003e\u003cbr /\u003eThương hiệu: Trung Nguyên Legend\u003c/p\u003e\n\u003cp\u003eNgành hàng: cà phê\u003c/p\u003e\n\u003cp\u003eNhà sản xuất: Trung Nguyên\u003c/p\u003e\n\u003cp\u003eXuất xứ: Việt Nam\u003c/p\u003e\n\u003cp\u003eNơi sản xuất: Việt Nam\u003c/p\u003e\n\u003cp\u003eNgày sản xuất: In trên bao bì sản phẩm\u003c/p\u003e\n\u003cp\u003eHạn sử dụng: 2 năm kể từ ngày sản xuất\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003eCÁCH BẢO QUẢN: \u003cbr /\u003eBảo quản sản phẩm nơi khô ráo, thoáng mát, tránh ánh nắng trực tiếp. \u003cbr /\u003e\u003cbr /\u003eLƯU Ý: \u003cbr /\u003eKhông dùng cho người dị ứng với các thành phần của sản phẩm.\u003c/p\u003e\n\u003cp\u003eBột cà phê rang xay nhuyễn có thể lắng dưới đáy ly và an toàn khi sử dụng.\u003cbr /\u003e\u003cbr /\u003eTHỜI GIAN GIAO HÀNG\u003c/p\u003e\n\u003cp\u003eSản phẩm của gian hàng đã được gửi sẵn ở kho Tiki, vì vậy đơn hàng sẽ được giao theo thời gian dự kiến trên đơn hàng.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eCHÍNH SÁCH BẢO HÀNH:\u003c/p\u003e\n\u003cp\u003eSản phẩm được đổi trả theo đúng quy định của Tiki.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eĐể biết thêm thông tin chi tiết của sản phẩm hoặc chính sách giá tốt, giá sỉ vui lòng inbox cho shop.\u003c/p\u003e\n\u003cp\u003eChân thành cảm ơn quý khách hàng!\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e#trungnguyen #trung_nguyen #trung_nguyên #trung_nguyen_legend #trung_nguyên_legend #trungnguyenlegend #trungnguyenlegendofficial #trung_nguyen_legend_official #trung_nguyên_legend_official #caphe #ca_phe #cà_phê #caphetrungnguyen #cà_phê_hòa_tan #cà_phê_sữa #ca_phe_trung_nguyen #cà_phê_trung_nguyên #Cà_phê_sữa_hòa_tan #Cà_phê_nguyên_chất #G73in1 #G7_3in1 #cà_phê_3in1\u003c/p\u003e\n\u003cp\u003e*Bao bì thực tế sẽ thay đổi theo từng đợt nhập hàng\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/df/12/9d/1fa00fa2473e17471a881e73a8d6fbe4.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/df/12/9d/1fa00fa2473e17471a881e73a8d6fbe4.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/df/12/9d/1fa00fa2473e17471a881e73a8d6fbe4.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/df/12/9d/1fa00fa2473e17471a881e73a8d6fbe4.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/df/12/9d/1fa00fa2473e17471a881e73a8d6fbe4.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/82/36/4a/3b809b8f9380109c7f14d81a19598e84.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/82/36/4a/3b809b8f9380109c7f14d81a19598e84.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/82/36/4a/3b809b8f9380109c7f14d81a19598e84.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/82/36/4a/3b809b8f9380109c7f14d81a19598e84.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/82/36/4a/3b809b8f9380109c7f14d81a19598e84.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/c6/06/b2/19e82be2d84231392a432062fb85b40b.jpg","is_gallery":true,"label":null,"large_url":"ht