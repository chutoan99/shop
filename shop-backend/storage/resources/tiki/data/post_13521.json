is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/bc/db/04/4b6677a268f8610e88e90a05c671e67d.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":417,"all_time_quantity_sold":10,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align:justify\"\u003e\u003cstrong\u003eThành phần:\u003c/strong\u003e Đậu tương, chất béo động vật, muối, đường, chất đạm thực vật, chiết xuất thịt, tiêu, bột mì, chiết xuất thịt heo, dầu mè, chiết xuất tôm, nước.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/d9/c7/a5/bb44354a75bf16edc74bbe3f3ab60ecd.jpg\" alt=\"\" width=\"640\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/2e/59/d1/5804ad20c6d5d8736346a0ce8d071c00.jpg\" alt=\"\" width=\"640\" height=\"501\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/16/53/1f/e0c9670a84f3eac3e8d33680766ec50d.jpg\" alt=\"\" width=\"640\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify\"\u003eMiso ( みそ hoặc 味噌 ) Là một loại nước sốt truyền thống của Nhật Bản được làm bằng cách lên men đậu nành với muối và koji (nấm Aspergillus oryzae ) và đôi khi có cả gạo, lúa mạch, hoặc một số thành phần khác. Kết quả của quá trình lên men đó là tạo thành một miếng ván dày sử dụng tạo thành nước sốt “gây nghiện”, có thể dùng với các loại thịt, đặc biệt là ăn kèm với mì Soba, đây là loại gia vị vô cùng thiết yếu trong ẩm thực Nhật Bản.\u003c/p\u003e\n\u003cp style=\"text-align:justify\"\u003eChứa hàm lượng protein cao, giàu vitamin và khoáng chất , miso đóng vai trò rất quan trọng trong thời phong kiến Nhật Bản bởi độ dinh dưỡng chứa trong nó .\u003c/p\u003e\n\u003cp style=\"text-align:justify\"\u003eCàng để lâu thì Miso sẽ càng thơm ngon hơn và dấy lên hương vị lôi cuốn mỗi khi dùng kèm với các món ăn kết hợp.\u003c/p\u003e\n\u003cp style=\"text-align:justify\"\u003e\u003cstrong\u003eHướng dẫn sử dụng:\u003c/strong\u003e\u003c/p\u003e\n\u003col style=\"text-align:justify\"\u003e\u003cli\u003e    Nước sốt salad: Trộn miso trắng với ít giấm gạo, dầu oliu và mù tạt sẽ tạo ra một món rưới cực ngon\u003c/li\u003e\u003cli\u003e    Súp: Nấu món súp từ miso (hòa tan miso trong nước nóng trước khi cho vào nồi súp của bạn. Tốt nhất là cho vào lúc nhấc nồi ra khỏi bếp chứ đừng nấu miso trên bếp.\u003c/li\u003e\u003cli\u003e    Dùng để ướp thực phẩm: Trộn miso sẫm màu với gừng, tiêu đen và vài giọt giấm , một ít mật đường để tạo thành một thức ướp chay rất tuyệt vời.\u003c/li\u003e\u003cli\u003e    Cho vào trà hoặc là thay thế cà phê: Rót 1 cốc nước ấm và trộn một thìa hoặc nửa thìa miso vào nước và thưởng thức. Nếu bạn thấy khó để hòa tan miso trong một cốc đầy thì hãy cho vào một ít nước quấy tan miso rồi cho nước vào sau.\u003c/li\u003e\u003cli\u003e    Dùng như là một loại nước chấm: Trộn tỏi, hành, miso, bơ vừng, nước chanh và thì là tạo thành một món nước chấm ngon tuyệt.\u003c/li\u003e\u003c/ol\u003e\n\u003cp style=\"text-align:justify\"\u003e\u003cstrong\u003eHạn sử dụng:\u003c/strong\u003e Xem trên bao bì sản phẩm\u003c/p\u003e\n\u003cp style=\"text-align:justify\"\u003e\u003cstrong\u003eXuất xứ:\u003c/strong\u003e Nhật bản\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/bc/db/04/4b6677a268f8610e88e90a05c671e67d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/bc/db/04/4b6677a268f8610e88e90a05c671e67d.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/bc/db/04/4b6677a268f8610e88e90a05c671e67d.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/bc/db/04/4b6677a268f8610e88e90a05c671e67d.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/bc/db/04/4b6677a268f8610e88e90a05c671e67d.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/16/53/1f/787445e8212f7702f142c7ca1d059bea.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/16/53/1f/787445e8212f7702f142c7ca1d059bea.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/16/53/1f/787445e8212f7702f142c7ca1d059bea.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/16/53/1f/787445e8212f7702f142c7ca1d059bea.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/16/53/1f/787445e8212f7702f142c7ca1d059bea.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/b3/41/31/d88d74b96db556359dcbf23d351af9a4.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b3/41/31/d88d74b96db556359dcbf23d351af9a4.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b3/41/31/d88d74b96db556359dcbf23d351af9a4.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b3/41/31/d88d74b96db556359dcbf23d351af9a4.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b3/41/31/d88d74b96db556359dcbf23d351af9a4.jpg"}],"warranty_policy":null,"brand":{"id":3981767,"name":"Shinshu