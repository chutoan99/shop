800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/9c/2e/81/c144c292b9a81439f99ed82707a3bd8e.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":912,"all_time_quantity_sold":15,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch1\u003eLy thủy tinh Cassiopea - màu trắng (Bormioli Rocco)\u003c/h1\u003e\n\u003cp\u003e\u003cbr /\u003eXUẤT XỨ: Ý\u003c/p\u003e\n\u003cp\u003eCAM KẾT: Được Công ty Nhập khẩu chính ngạch có hóa đơn chứng từ đảm bảo an toàn VATP hiện hà\u003c/p\u003e\n\u003cp\u003e===========================\u003c/p\u003e\n\u003cp\u003eThông tin sản Phẩm :\u003c/p\u003e\n\u003cp\u003eChất liệu: Thủy tinh\u003c/p\u003e\n\u003cp\u003eCassiopea 32cl Kích thước: 8.5 x 8.5 x 11cm Trọng lượng: 250g\u003c/p\u003e\n\u003cp\u003eCassiopea 48cl Kích thước: 8 x 8 x 15cm Trọng lượng: 350g\u003c/p\u003e\n\u003cp\u003eLy thủy tinh Cassiopea được làm từ chất liệu thủy tinh cao cấp, đạt tiêu chuẩn của châu Âu. Sản phẩm có độ bền cao, dễ chùi rửa, không bị phai màu và đặc biệt an toàn với sức khỏe người sử dụng. Với đa dạng màu sắc để bạn lựa chọn cho phù hợp với không gian gian sống của mình, ly uống nước thật tiện dụng và sang trọng.\u003c/p\u003e\n\u003cp\u003eSở hữu thiết kế trơn không hoa văn, nhưng gây ấn tượng bởi những đường cắt độc đáo mang nét sang trọng và tinh tế. Ly Cassiopea của thương hiệu Bormioli Rocco sẽ là một lựa chọn hoàn hảo cho những không gian sống hiện đại. Sản phẩm được làm từ chất liệu thủy tinh cao cấp, đạt tiêu chuẩn của châu Âu.\u003c/p\u003e\n\u003cp\u003eLy thủy tinh Cassiopea có những đặc điểm nổi bậc sau:\u003c/p\u003e\n\u003cp\u003eThân ly với các vân thủy tinh nổi sang trọng làm nổi bật màu sắc trong ly khi rót\u003c/p\u003e\n\u003cp\u003eGiữa ly được thắt nhỏ bo tròn tinh tế khi uống dùng ngón tay cái và ngón trỏ nhấc ly rượu lên\u003c/p\u003e\n\u003cp\u003eĐộ bền cao, siêu nhẹ, khả năng chống nứt vỡ sứt mẻ ngay cả khi va chạm mạnh dùng được trong máy rửa chén\u003c/p\u003e\n\u003cp\u003eĐược sản xuất tại Ý trên công nghệ hiện đại kết hợp với kỹ thuật được đúc kết lâu đời\u003c/p\u003e\n\u003cp\u003eSản phẩm hiện có nhiều dung tích và màu sắc:\u003c/p\u003e\n\u003cp\u003eMàu khói 30cl: Ø86x88mm\u003c/p\u003e\n\u003cp\u003eMàu tím 30cl: Ø86x88mm\u003c/p\u003e\n\u003cp\u003eMàu trắng 30cl: Ø86x88mm\u003c/p\u003e\n\u003cp\u003eMàu trắng 48cl: Ø80x147mm\u003c/p\u003e\n\u003cp\u003e============================\u003c/p\u003e\n\u003cp\u003eTHÔNG TIN THƯƠNG HIỆU:\u003c/p\u003e\n\u003cp\u003eBormioli Rocco là thương hiệu sản xuất sản phẩm thủy tinh của Italia được thành lập từ năm 1825, có có trụ sở chính tại Fidenza (Italia) và nhiều nhà máy, cơ sở ở các nước như Tây Ban Nha, Pháp, Mỹ…Hiện nay, Bormioli Rocco chiếm 50% thị phần cung cấp các sản phẩm phục vụ bàn ăn của kênh phân phối bán lẻ lớn ở Ý và hơn 85% người dân Ý biết đến và sử dụng sản phẩm của Bormioli\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e\u003cp\u003eSản phẩm này là tài sản cá nhân được bán bởi Nhà Bán Hàng Cá Nhân và không thuộc đối tượng phải chịu thuế GTGT. Do đó hoá đơn VAT không được cung cấp trong trường hợp này.\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/9c/2e/81/c144c292b9a81439f99ed82707a3bd8e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/9c/2e/81/c144c292b9a81439f99ed82707a3bd8e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/9c/2e/81/c144c292b9a81439f99ed82707a3bd8e.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9c/2e/81/c144c292b9a81439f99ed82707a3bd8e.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9c/2e/81/c144c292b9a81439f99ed82707a3bd8e.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/f4/b2/7e/bf88374680837d6eb62408165854269a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f4/b2/7e/bf88374680837d6eb62408165854269a.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f4/b2/7e/bf88374680837d6eb62408165854269a.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f4/b2/7e/bf88374680837d6eb62408165854269a.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f4/b2/7e/bf88374680837d6eb62408165854269a.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/bd/0c/f2/37778a8661a2f15dd01126ae6e66264b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/bd/0c/f2/37778a8661a2f15dd01126ae6e66264b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/bd/0c/f2/37778a8661a2f15dd01126ae6e66264b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/bd/0c/f2/37778a8661a2f15dd01126ae6e66264b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/bd/0c/f2/37778a8661a2f15dd01126ae6e66264b.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/77/c3/4f/fd081ffdaca68ee7d87246e4ce748fb0.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/77/c3/4f/fd081ffdaca68ee7d87246e4ce74