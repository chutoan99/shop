ext":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":106900,"discount_rate":43,"rating_average":5,"review_count":7,"review_text":"(7)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/43/c9/b8/407c4a6d11ba7190706be189fda45989.png","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1134,"all_time_quantity_sold":67,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003eGiới thiệu\u003c/h3\u003e\n\u003cp\u003eMideer Magnet Letters- Bảng chữ cái, chữ số nam châm Mideer cho bé từ 2 tuổi trở lên học chữ cái nhận biết con vật và ghép từ đơn giản.\u003c/p\u003e\n\u003cp\u003eĐể nhớ chữ thông qua việc liên tưởng đến những con vật dễ thương, màu sắc tươi đẹp, bố mẹ hãy sắm ngay cho bé yêu bảng chữ cái các con vật có Nam Châm này nhé\u003c/p\u003e\n\u003cp\u003eMỗi chữ cái biểu trưng cho một loài động vật và có tên tiếng Anh phía trên. Bé học tiếng Anh, học chữ cái nhanh nhớ, dễ liên tưởng, không áp lực mà lại nắm từ dễ dàng\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eHọc chữ cái\u003c/li\u003e\u003cli\u003eHọc tên các con vật trên từng chữ cái\u003c/li\u003e\u003cli\u003eHọc ghép các từ đơn giản\u003c/li\u003e\u003c/ul\u003e\n\u003ch3\u003eChất liệu\u003c/h3\u003e\n\u003cp\u003eĐược làm giấy ép lụa cứng như gỗ, các miếng ghép bo viền xung quanh cẩn thận, mặt sau được phủ 1 lớp nam châm, các bé có thể dán lên mọi mặt phẳng có từ tính\u003c/p\u003e\n\u003ch3\u003eĐối tượng sử dụng\u003c/h3\u003e\n\u003cp\u003eDành cho bé từ 3 tuổi trở lên\u003c/p\u003e\n\u003ch3\u003eMô tả sản phẩm\u003c/h3\u003e\n\u003cul\u003e\u003cli\u003eBộ chữ cái và số đếm nam châm - Mideer Letter/Number Magnets - MD2064/2102\u003c/li\u003e\u003cli\u003eKích thước sản phẩm: 21 x 10 x 5cm\u003c/li\u003e\u003cli\u003eTrọng lượng 500 gr\u003c/li\u003e\u003cli\u003e26 chi tiết\u003c/li\u003e\u003c/ul\u003e\n\u003ch3\u003eHướng dẫn sử dụng\u003c/h3\u003e\n\u003cul\u003e\u003cli\u003eBé có thể dán vào tủ lạnh, bảng trắng, hoặc các nơi hút nam châm.\u003c/li\u003e\u003cli\u003eMặt sau từ tính có đệm nên không gây trầy xước cho các chỗ dán\u003c/li\u003e\u003cli\u003eTừ tính mạnh nên không sợ rớt\u003c/li\u003e\u003cli\u003eMỗi chữ cái đều to bản nên bé cầm nắm chắc chắn, cạnh mài nhẵn nên an toàn cho bé\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cem\u003eVề thương hiệu\u003c/em\u003e\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eThương hiệu đồ chơi giáo dục Mideer nổi tiếng trên thế giới có thị trường rộng khắp từ châu Á, châu Âu đến châu Mỹ - Latinh. Với thiết kế bắt mắt, nội dung sáng tạo ý nghĩa, những sản phẩm của Mideer rất được các ông bố bà mẹ trên thế giới lựa chọn cho con mình.\u003c/p\u003e\n\u003cp\u003eChúc các con chơi vui vẻ và học giỏi\u003c/p\u003e\n\u003cp\u003eMỘC NHIÊN KIDS STORE ĐỒNG HÀNH CÙNG BÉ YÊU KHÔN LỚN\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/97/92/e9/47f25baba4b4c021fd8b5bf4340c3821.JPG\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/66/df/27/62fd580c487a72deb6f4de142b862a5d.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/c9/68/1e/38f9a2f61cbc8a40eaeb0bf39e69da01.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\