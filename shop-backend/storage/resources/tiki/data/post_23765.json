dge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":5,"review_text":"(5)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/7d/0e/b4/8d95294e38bb254ca71cdbc442ee19be.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1109,"all_time_quantity_sold":13,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eFitobimbi D3K2 được dùng cho trẻ sơ sinh từ 1 ngày tuổi, hỗ trợ bổ sung vitamin D3 và vitamin K2, giúp hấp thu tối đa canxi vào xương răng, cho con một khởi đầu vững chắc. Sản phẩm được sản xuất trên dây chuyền hiện đại với các tiêu chuẩn nghiêm ngặt tại Châu Âu (cGMP, ISO 9001:2008, ISO 13485:2012, ISO 22000:2005)\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThành phần trong 5 giọt (0,25ml) Fitobimbi D3K2\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eVitamin K2 1% (Menaquinon) 1,125mg (chứa Vitamin K 11,25 mcg), Vitamin D3 2,5% (Cholecalciferol) 0,1mg (chứa Vitamin D 2,5mcg).\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003ePhụ liệu: Dầu đậu nành (Glycine max), chất chống oxy hóa (Vitamin E (DL-alpha-Tocopherol))\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eFitobimbi D3K2 giúp gì cho bé yêu?\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eFitobimbi được dùng cho trẻ từ 1 ngày tuổi với công dụng:\u003c/span\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eBổ sung vitamin D3 và vitamin K2, giúp hỗ trợ hấp thu canxi cho cơ thể, hỗ trợ xương, răng chắc khỏe.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eHỗ trợ giảm nguy cơ còi xương ở trẻ.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eĐối tượng sử dụng\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eTrẻ sơ sinh, trẻ nhỏ và người lớn thiếu vitamin D, vitamin K.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eTrẻ em còi xương do kém hấp thu canxi.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eTrẻ em đang trong giai đoạn phát triển cần bổ sung vitamin D và vitamin K\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eHướng dẫn sử dụng\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eLắc kỹ trước khi dùng.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eTrẻ dưới 1 tuổi: Uống tối thiểu 5 giọt (0,25ml), tối đa 20 giọt mỗi ngày.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eTrẻ trên 1 tuổi: Có thể uống tới 30 giọt/ngày\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eSử dụng pipet kèm theo. \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eCó thể pha loãng với các dung dịch khác (nước, nước trái cây,…)\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eChú ý:\u003c/span\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eKhông dùng cho người mẫn cảm với bất kỳ thành phần nào của sản phẩm\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eĐể xa tầm tay trẻ em. Không dùng quá liều chỉ định. Sản phẩm không thay thế chế độ dinh dưỡng cân bằng và lối sống lành mạnh.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eDùng được cho trẻ sơ sinh. Tham khảo ý kiến bác sỹ trước khi sử dụng.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eKhông chứa Lactose - Không chứa gluten.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eBảo quản\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eBảo quản nơi khô mát, tránh ánh sáng. \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eQuy cách sản phẩm\u003c/strong\u003e\u003cspan style=\"font-weight: 400;\"\u003e: 30ml/lọ\u003c/span\u003e\u003cspan style=\"font-weight: 400;\"\u003e± 5%\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eHạn sử dụng\u003c/strong\u003e\u003cspan style=\"font-weight: 400;\"\u003e: 3 năm kể từ ngày sản xuất. Số lô và hạn dùng in dưới đáy hộp. Hạn sử dụng tương ứng khi sản phẩm chưa bị mở nắp và bảo quản đúng cách\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eXuất xứ\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eXuất xứ: Italia\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eSản xuất bởi: Pharmalife Research ,\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eĐịa chỉ: Via Casa Paradiso, 2/A 23846 Garbagnate Monastero (LC) – Italia\u003c/span\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/7d/0e/b4/8d95294e38bb254ca71cdbc442ee19be.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/7d/0e/b4/8d95294e38bb254ca71cdbc442ee19be.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/7d/0e/b4/8d95294e38bb254ca71cdbc442ee19be.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7d/0e/b4/8d95294e38bb254ca71cdbc442ee19be.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7d/0e/b4/8d95294e38bb254ca71cdbc442ee19be.png"}],"warranty_policy":null,"brand":{"id":186553,"name":"Fitobimbi","slug":"fitobimbi"},"current_seller":{"id":3997,"sku":"5887303977212","name":"Babymart","link":"https://tiki.vn/cua-hang/babymart","logo":"2c/5b/95/2d1b50fff97c850d93fa507650637b50.jpg","price":294000,"product_id":"122624528","store_id":3945,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[{"id":150357,"name":"BABY THIÊN PHÚC","link":"https://tiki.vn/cua-hang/baby-thien-phuc","logo":"df/29/ee/58c5cbd0341fc0e6df74de2bd1a30251.jpg","price":300000,"product_id":"157835050","store_id":138719}],"specifications":[{"name":"C