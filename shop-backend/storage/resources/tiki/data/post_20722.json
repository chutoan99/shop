:89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.8,"review_count":59,"review_text":"(59)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/05/00/1f/062c299c1c347060ee030345f43f4d81.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1016,"all_time_quantity_sold":215,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003eThiết kế thanh mảnh, bố trí gọn gàng\u003c/h3\u003e\n\u003cp\u003e có kích thước lần lượt là \u003cstrong\u003edài 76 cm - rộng 9 cm - cao 6.3 cm\u003c/strong\u003e bạn có thể đặt gọn ngay phía dưới tivi, không chiếm quá nhiều diện tích. Loa có tông màu chủ đạo là đen đậm chất hiện đại, các mặt bên được tạo điểm nhấn tông màu gỗ thời trang.  \u003c/p\u003e\n\u003cp\u003eLG Soundbars là sản phẩm ECV cực thân thiện với môi trường vì phần thân trên và thân dưới của loa soundbar sử dụng từ vật li tái chế. \u003c/p\u003e\n\u003cp\u003e\u003c/p\u003e\n\u003ch3\u003eÂm thanh chân thực tràn ngập không gian\u003c/h3\u003e\n\u003cp\u003e với tổng công suất 100 W cùng hệ thống kênh 2.1 kênh mang đến bạn những âm trầm sâu lắng, chân thực đến từng chi tiết mà vẫn giữ được chất âm vốn có giúp bạn luôn có thể thưởng thức nội dung với âm thanh chất lượng cao.\u003c/p\u003e\n\u003cp\u003e\u003c/p\u003e\n\u003ch3\u003eÂm thanh tràn ngập trong căn phòng của bạn với công nghệ \u003c/h3\u003e\n\u003cp\u003eCông nghệ này sẽ tạo nên âm thanh đa chiều biến căn phòng thành rạp chiếu phim thực thụ giúp bạn có thể xem bộ phim yêu thích với chất lượng âm thanh tốt nhất ngay tại nhà.\u003c/p\u003e\n\u003cp\u003e\u003c/p\u003e\n\u003ch3\u003eÂm trầm thêm sâu lắng với loa siêu trầm tích hợp\u003c/h3\u003e\n\u003cp\u003eBên trong lđược trang bị một chiếc loa siêu trầm và bộ tản nhiệt thụ động cho khả năng thể hiện âm trầm phong phú và phù hợp với mọi nội dung.\u003c/p\u003e\n\u003cp\u003e\u003c/p\u003e\n\u003ch3\u003eÂm thanh phù hợp với nội dung mà bạn đang xem với AI Sound Pro\u003c/h3\u003e\n\u003cp\u003eAI Sound Pro sẽ phân tích nội dung bạn đang xem trên tivi sau đó dựa vào các thuật toán chuyên sâu sẽ tiến hành tối ưu hóa âm thanh phát ra của loa sao cho phù hợp nhất.\u003c/p\u003e\n\u003cp\u003e\u003c/p\u003e\n\u003ch3\u003eĐồng bộ âm thanh giữa tivi và loa thanh\u003c/h3\u003e\n\u003cp\u003eBộ xử lý AI Alpha 9 2021 trên tivi LG bạn và TV Sound Mode Share cho phép âm thanh của 2 thiết bị cộng hưởng cho mọi thứ bạn nghe rõ ràng và nhất quán hơn, ngay cả từ các nguồn nội dung khác nhau. Lưu ý, tính năng này chỉ áp dụng cho tivi LG và loa LG có hỗ trợ.\u003c/p\u003e\n\u003cp\u003e\u003c/p\u003e\n\u003ch3\u003eChế độ âm thanh mới phù hợp với mục yêu thích\u003c/h3\u003e\n\u003cp\u003eLG đã trang bị cho chiếc loa này các chế độ âm thanh độc quyền bạn sẽ không tìm thấy ở các dòng  khác, các chế độ này phù hợp cho phim ảnh và chơi game.\u003c/p\u003e\n\u003cp\u003e\u003c/p\u003e\n\u003ch3\u003eTrang bị đa dạng kết nối \u003c/h3\u003e\n\u003cp\u003eLoa có kết nối không dây Bluetooth 4.0, cổng USB, HDMI, Optical hỗ trợ ghép nối loa với tivi, đầu đĩa, điện thoại, dễ dàng.\u003c/p\u003e\n\u003cp\u003e\u003c/p\u003e\n\u003cp\u003eLoa thanh LG SP2 có vẻ ngoài sang đẹp với chất âm ấn tượng trên các nền công nghệ tân tiến thiết bị âm thanh này sẽ mang đến đa dạng sắc màu trong âm thanh cho bạn thưởng thức phim ảnh, nghe nhạc tuyệt vời hơn.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/05/00/1f/062c299c1c347060ee030345f43f4d81.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/05/00/1f/062c299c1c347060ee030345f43f4d81.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/05/00/1f/062c299c1c347060ee030345f43f4d81.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/05/00/1f/062c299c1c347060ee030345f43f4d81.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/05/00/1f/062c299c1c347060ee030345f43f4d81.png"},{"base_url":"https://salt.tikicdn.com/ts/product/20/07/38/98241b34127a3fbe02ff5dc64ac80960.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/20/07/38/98241b34127a3fbe02ff5dc64ac80960.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/20/07/38/98241b34127a3fbe02ff5dc64ac80960.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/20/07/38/98241b34127a3fbe02ff5dc64ac80960.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/20/07/38/98241b34127a3fbe02ff5dc64ac80960.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/56/06/ef/160ff917cae5b12fa6c5d371b0c67267.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/56/06/ef/160ff917cae5b12fa6c5d371b0c67267.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/56/06/ef/160ff917cae5b12fa6c5d371b0c67267.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/56/06/ef/160ff917cae5b12fa6c5d371b0c67267.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/56/06/ef/160ff917cae5b12fa6c5d371b0c67267.png"},{"base_url":"https://salt.tikicdn.com/ts/product/85/16/ac/6e516f6e5457fe89ecac88aa5883bb7c.jpg