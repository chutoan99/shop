0,"rating_average":5,"review_count":5,"review_text":"(5)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/1b/3f/29/43f90e908af258890755eaed3dbc22ff.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2007,"all_time_quantity_sold":55,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp dir=\"ltr\" style=\"line-height: 1.38; margin-top: 0pt; margin-bottom: 10pt; text-align: center;\"\u003e\u003cspan style=\"font-size: 12pt; font-family: Arial; color: #000000; background-color: transparent; font-weight: bold; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"\u003eCao hồng sâm Bio-science 240g\u003c/span\u003e\u003c/p\u003e\n\u003cp dir=\"ltr\" style=\"line-height: 1.38; margin-top: 0pt; margin-bottom: 10pt;\"\u003e\u003cspan style=\"font-size: 12pt; font-family: Arial; color: #000000; background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"\u003eCông ty Korea Ginseng Bio-science Co.,Ltd được thành lập vào năm 1998 với tên gọi ban đầu là Thực phẩm Dong-guk.\u003c/span\u003e\u003c/p\u003e\n\u003cp dir=\"ltr\" style=\"line-height: 1.38; margin-top: 0pt; margin-bottom: 10pt;\"\u003e\u003cspan style=\"font-size: 12pt; font-family: Arial; color: #000000; background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"\u003eTính đến nay, các sản phẩm của Bio-science Co.,Ltd đã được giới thiệu rộng rãi trên thị trường thế giới, thể hiện sự nỗ lực phấn đấu và niềm tự hào về tính ưu việt của các sản phẩm bổ sung sức khỏe Hàn Quốc. Với áp lực lớn của quá trình mở cửa thị trường rất nhiều sản phẩm bổ sung sức khỏe nước ngoài, đồ uống cho các lứa tuổi và thực phẩm chức năng đã đổ bộ vào thị trường Hàn Quốc, do hiện tượng này chúng tôi đã nghiên cứu ra các sản phẩm sức khỏe phù hợp với sức khỏe của người Hàn Quốc.\u003c/span\u003e\u003c/p\u003e\n\u003cp dir=\"ltr\" style=\"line-height: 1.38; margin-top: 0pt; margin-bottom: 10pt;\"\u003e\u003cspan style=\"font-size: 12pt; font-family: Arial; color: #000000; background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"\u003eSản phẩm của Bio-science Co.,Ltd được dựa trên các loại thực phẩm truyền thống Hàn Quốc phù rất thích hợp cho thể chất của người Châu Á. Bio-science Co.,Ltd đang ngày càng nâng cao tiêu chuẩn lượng, giảm giá thành sản phẩm hơn từng ngày.\u003c/span\u003e\u003c/p\u003e\n\u003cp dir=\"ltr\" style=\"line-height: 1.38; margin-top: 0pt; margin-bottom: 10pt;\"\u003e\u003cspan style=\"font-size: 12pt; font-family: Arial; color: #000000; background-color: transparent; font-weight: bold; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"\u003e1/ Nguồn gốc xuất xứ\u003c/span\u003e\u003c/p\u003e\n\u003cp dir=\"ltr\" style=\"line-height: 1.38; margin-top: 0pt; margin-bottom: 10pt;\"\u003e\u003cspan style=\"font-size: 12pt; font-family: Arial; color: #000000; background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"\u003e\u003cstrong\u003eCao hồng sâm Bio-science 240g Hàn Quốc\u003c/strong\u003e đã trải qua một quy trình chế biến rất công phu từ Daehan Red Ginseng Promotion. Từ một củ sâm tươi 6 tuổi được chọn lọc thật kỹ, sau đó qua giai đoạn chưng cất và hấp cách thủy ở nhiệt độ phù hợp, sâm tươi trở thành bạch sâm và dần thành hồng sâm chứa hàm lượng lớn giá trị dưỡng chất tối đa.\u003c/span\u003e\u003c/p\u003e\n\u003cp dir=\"ltr\" style=\"line-height: 1.38; margin-top: 0pt; margin-bottom: 10pt;\"\u003e\u003cspan style=\"font-size: 12pt; font-family: Arial; color: #000000; background-color: transparent; font-weight: bold; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"\u003e2/ Thành phần\u003c/span\u003e\u003c/p\u003e\n\u003cp dir=\"ltr\" style=\"line-height: 1.38; margin-top: 0pt; margin-bottom: 10pt;\"\u003e\u003cspan style=\"font-size: 12pt; font-family: Arial; color: #000000; background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"\u003e\u003cstrong\u003eCao hồng sâm Bio-science 240g\u003c/strong\u003e gồm \u003c/span\u003e\u003cspan style=\"font-size: 12pt; font-family: Arial; color: #000000; background-color: #ffffff; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"\u003echiết xuất nhân sâm đỏ (l0,5%), Isomalt olgosacchande, dextrin, chiết xuất Dacbo: cây tố nữ, rễ hoàng kỳ, rễ cây cam thảo bắc, cây quế, bạch thược, địa hoàng, bạch truật trắng, phục linh, nhu hươu, Cindii, zhizoma, ngũ gia gai. Nấm linh chi, năm Chaga, VTM C, VTM B1 hydrochloride, VTM B6 hydrochloride, chiết xuất từ bưởi.\u003c/span\u003e\u003c/p\u003e\n\u003cp dir=\"ltr\" style=\"line-height: 1.38; margin-top: 0pt; margin-bottom: 10pt;\"\u003e\u003cspan style=\"font-size: 12pt; font-family: Arial; color: #000000; background-color: #ffffff; font-weight: bold; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"\u003e3/ Công dụng \u003c/span\u003e\u003cstrong\u003e\u003cspan style=\"font-family: Arial; font-size: 16px; white-space: pre-wrap;\"\u003eCao hồng sâm Bio-science 240g\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp dir=\"ltr\" style=\"line-height: 1.38; margin-top: 0pt; margin-bottom: 10pt;\"\u003e\u003cspan style=\"font-size: 12pt; font-family: Arial; color: #000000; background-color: #ffffff; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"\u003eCao hồng sâm Bio-science 240g là một trong những sản phẩm được cho là ” thượng phẩm thượng hạng”, có tác dụng hỗ trợ tăng cường sinh lực, làm hạ huyết áp, tăng cường và bồi bổ toàn diện, làm giảm cholesterol, phòng ngừa bệnh tiểu đường, tim mạch, tăng cường sức đề kháng…\u003c/span\u003e\u003c/p\u003e\n\u003cp dir=\"ltr\" style=\"line-height: 1.38; margin-top: 0pt; margin-bottom: 10pt;\"\u003e\u003cspan style=\"font-size: 12pt; font-family: Arial; color: #000000; background-color: #ffffff; font-weight: bold; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"\u003e4/ Hướng dẫn sử dụng\u003c/span\u003e\u003c/p\u003e\n\u003cp dir=\"ltr\" style=\"line-height: 1.38; margin-top: 0pt; margin-bottom: 10pt;\"\u003e\u003cspan style=\"font-size: 12pt; font-family: Arial; color: #000000; background-color: #ffffff; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"\u003e– Ngày uống từ 1 – 2 lần trước hoặc sau bữa ăn 20 phút.\u003c/span\u003e\u003c/p\u003e\n\u003cp dir=\"ltr\" style=\"line-height: 1.38; margin-top: 0pt; margin-bottom: 10pt;\"\u003e\u003cspan style=\"font-size: 12pt; font-family: Arial; color: #000000; background-color: #ffffff; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"\u003e– Mỗi lần lấy 2 – 3 thìa (có sẵn trong hộp) pha với 40 – 60ml nước ấm.\u003c/span\u003e\u003c/p\u003e\n\u003cp dir=\"ltr\" style=\"line-height: 1.38; margin-top: 0pt; margin-bottom: 10pt;\"\u003e\u003cspan style=\