ra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":20900,"discount_rate":10,"rating_average":4.8,"review_count":12,"review_text":"(12)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/48/e5/7b/8991f3f664572476c34f21c6ede94a60.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1720,"all_time_quantity_sold":55,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003eĐẶC ĐIỂM NỔI BẬT CỦA SẢN PHẨM\u003c/strong\u003e\u003c/p\u003e\n\u003cul style=\"text-align:justify;\"\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eBột Lá Sen Quảng Thanh\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e có nguồn gốc từ những vùng trồng riêng biệt. Sản phẩm rất thích hợp cho người thường hay mất ngủ, người bị mỡ máu, mỡ tạng hoặc nhiều mỡ cơ thể.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eNguồn gốc từ những vùng trồng riêng biệt để sản xuất thành bột có thể làm thực phẩm. Bột được trải qua quy trình sấy lạnh và nghiền mịn đảm bảo an toàn cho người dùng. Đặc biệt, rất thích hợp cho người  thường hay mất ngủ, những người bị mỡ máu, mỡ tạng hoặc nhiều mỡ cơ thể. \u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eBột Lá Sen Quảng Thanh \u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003ekhông chứa chất bảo quản, không pha trộn thêm bất kỳ thành phần phụ gia hóa học nào.\u003c/span\u003e\u003cspan style=\"font-weight:400;\"\u003e \u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/48/e5/7b/8747a733571273a3caec61e8324226cf.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cem\u003e\u003cspan style=\"font-weight:400;\"\u003eBột lá sen Quảng Thanh - gói tiết kiệm - giúp an thần ngủ ngon, giảm mỡ máu và mỡ cơ thể\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003eCÔNG DỤNG CỦA SẢN PHẨM\u003c/strong\u003e\u003c/p\u003e\n\u003cul style=\"text-align:justify;\"\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eBột Lá Sen Quảng Thanh \u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003ehỗ trợ mất ngủ\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eNgăn ngừa mỡ trong máu, mỡ trong nội tạng\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eĐiều hòa huyết áp\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eNgoài ra còn dùng làm nguyên liệu pha chế dược liệu và nguyên liệu mỹ phẩm vì bột lá sen hoàn toàn tự nhiên.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cem\u003e\u003cspan style=\"font-weight:400;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/f1/10/c9/773a5627cd7f16310c972de0fb8e07e2.jpg\" alt=\"Bột Lá Sen Quảng Thanh\" width=\"750\" height=\"750\" /\u003e\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cem\u003e\u003cspan style=\"font-weight:400;\"\u003eBột lá sen Quảng Thanh thích hợp cho người hay mất ngủ, những người bị mỡ máu\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003eTHÔNG TIN CHUNG\u003c/strong\u003e\u003c/p\u003e\n\u003cul style=\"text-align:justify;\"\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eThành phần: 100% lá sen tươi, sấy lạnh tiệt trùng và nghiền siêu mịn.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eĐộ ẩm: dưới 5%.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eNgày sản xuất: xem trên bao bì.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eHạn sử dụng: 1 năm kể từ ngày sản xuất.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003eCÁCH DÙNG BỘT LÁ SEN QUẢNG THANH\u003c/strong\u003e\u003c/p\u003e\n\u003cul style=\"text-align:justify;\"\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eGiải khát bằng một ly lá sen tươi: Sử dụng khoảng 3 - 5 gr bột lá sen pha với 300 - 500ml nước lọc cho mỗi lần uống (1 – 2 lần/ ngày)\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eCông thức làm đẹp với bột lá sen: Để có được làn da căng mịn, tràn sức sống, hãy áp dụng ngay công thức: bột lá sen trộn với nước tinh khiết tỉ lệ 1:3 (có thể thay nước bằng sữa tươi hoặc sữa chua không đường để vừa trị mụn vừa dưỡng trắng), đắp hỗn hợp này lên da trong 15-20 phút, duy trì 2 lần/tuần.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cem\u003e\u003cspan style=\"font-weight:400;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/04/6f/29/3b885b8687d047756bc0f3b29c10e92e.jpg\" alt=\"Bột Lá Sen Quảng Thanh\" width=\"750\" height=\"750\" /\u003e\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cem\u003e\u003cspan style=\"font-weight:400;\"\u003eLàm đẹp với bột lá sen Quảng Thanh\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003eBẢO QUẢN\u003c/strong\u003e\u003c/p\u003e\n\u003cul style=\"text-align:justify;\"\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eBột Lá Sen Quảng Thanh \u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003eđể ở\u003c/span\u003e \u003cspan style=\"font-weight:400;\"\u003enơi khô thoáng, tránh tác động của ánh sáng và nhiệt. Tốt nhất nên bảo quản trong ngăn mát tủ lạnh. \u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eKhóa kín miệng túi sau khi sử dụng. Không nên sang chiết sản phẩm sang hũ nhựa hay lọ thủy tinh để giúp bột không bị biến chất, đảm bảo chất lượng tốt nhất với thời hạn sử dụng được lâu.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align:justify;\"\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/48/e5/7b/8991f3f664572476c34f21c6ede94a60.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/48/e5/7b/8991f3f664572476c34f21c6ede94a60.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/48/e5/7b/8991f3f664572476c34f21c6ede94a60.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/48/e5/7b/8991f3f664572476c34f21c6ede94a60.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/48/e5/7b/8991f3f664572476c34f21c6ede94a60.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/94/af/f3/52d53bb05904c3ee7c20c42fde4481b4.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/94/af/f3/52d53bb05904c3ee7c20c42fde4481b4.jpg","medium_url":"https://salt.tikicdn.com/cache