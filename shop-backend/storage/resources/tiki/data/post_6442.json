ground_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":10000,"discount_rate":3,"rating_average":5,"review_count":13,"review_text":"(13)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/3e/af/24/4a10e1af3810cbce15cb1aaaf55a7802.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":768,"all_time_quantity_sold":62,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/3e/af/24/aa433bfc733298c6ff1c4d9bdd0d2368.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eBESTON ĐƠN VỊ DẪN ĐẦU TRONG NGÀNH SẢN XUẤT PHỤ KIỆN ĐIỆN THOẠI/ IT/ KỸ THUẬT SỐ - THƯƠNG HIỆU CAO CẤP QUỐC TẾ\u003c/p\u003e\n\u003cp\u003eĐược thành lập từ năm 2007, Beston từng bước thiết lập danh tiếng trên con đường tự phát triển thương hiệu riêng của mình. Với việc tạo ra các sản phẩm chất lượng cao thời thượng Beston đã dần chiếm được lòng tin của người tiêu dùng. Sản lượng tăng nhanh chóng và liên tục đứng đầu ngành.\u003c/p\u003e\n\u003cp\u003eCác sản phẩm chính hãng thương hiệu quốc tế Beston, BTY bao gồm: pin điện thoại, bộ sạc; pin máy ảnh kỹ thuật số, bộ sạc và các thiết bị ngoại vi khác…\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003eSạc pin Beston BST-C9023L là một sản phẩm mới nhất 2022 vô cùng hữu ích và tiện dụng cho những đồ dùng sử dụng pin như máy ảnh, micro, đồ điện tử, điều khiển hay đồ chơi dùng pin của trẻ\u003c/p\u003e\n\u003cp\u003eVới khả năng sạc pin AA và AAA cùng lúc một cách đơn giản, nhanh chóng. Chúng ta sẽ tha hồ dùng mà không lo tốn pin nữa.\u003c/p\u003e\n\u003cp\u003eĐặc biệt, có hỗ trợ sạc nhanh lên tới 1800mAh, có đèn báo, có tự ngắt thông minh an toàn giúp người dùng tiết kiệm đáng kể thời gian sử dụng và chi phí sử dụng.\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003eThông số :\u003c/p\u003e\n\u003cp\u003eThương hiệu : Beston\u003c/p\u003e\n\u003cp\u003eMã sản phẩm : BST-C9023L\u003c/p\u003e\n\u003cp\u003eSố khe sạc: 4 khe\u003c/p\u003e\n\u003cp\u003eĐiện áp đầu vào : 5V/1A (min)\u003c/p\u003e\n\u003cp\u003eCông suất tối đa: 5W\u003c/p\u003e\n\u003cp\u003eĐiện áp đầu ra : với pin AA : 1.2/1800mAh, với pin AAA: 1.2V/900mAh\u003c/p\u003e\n\u003cp\u003eKích thước : 79.5*66.5*29.7mm (kích thước có thể sai lệch đôi chút so với thực tế)\u003c/p\u003e\n\u003cp\u003eCổng vào : Micro USB + Type C ( ko hỗ trợ sạc 2 cổng cùng lúc)\u003c/p\u003e\n\u003cp\u003eMàn hình LCD hiển thị thông tin sạc pin.\u003c/p\u003e\n\u003cp\u003eKiểu pin hỗ trợ : AAA , AA ( pin 1.2V Ni-MH), không sạc được các loại pin dùng 1 lần hay pin 1.5V.\u003c/p\u003e\n\u003cp\u003eBộ sạc kèm dây cáp sạc micro (không kèm củ sạc), có thể cắm vào củ sạc điện thoại hoặc cổng USB bất kì để sạc.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/b2/a6/36/9053e89d5ac5fa9d492e4451fe236e51.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eBộ 4 pin tiểu sạc AA 3300mah\u003cbr /\u003e- Pin sạc 1.2V Ni-Mh Kích thước: dài 49mm x 14mm\u003cbr /\u003e- Tuổi thọ: 1000 lần sạc\u003cbr /\u003e- Điện áp 1.2V, pin đầy điện áp 1.4V\u003cbr /\u003e- Dung lượng thực 2600mAh\u003cbr /\u003e- Bộ 04 pin AA được đóng gói sẵn tron hộp nhựa đụng pin cao cấp.\u003c/p\u003e\n\u003cp\u003e#bosacpin #pinsac #pinAA #binsac #pintieusac #machsacpin #pintieusac #pindongho #pinmicro #pinkaraoke #beston #9023L #sacnhanh #sacpintungat #pinsacaa #pinsacmayanh #pinsacbeston #bosactungat #sacpinaatungat #sacpintieutungat #sacpinbeston #sacc9023\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/3e/af/24/4a10e1af3810cbce15cb1aaaf55a7802.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/3e/af/24/4a10e1af3810cbce15cb1aaaf55a7802.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/3e/af/24/4a10e1af3810cbce15cb1aaaf55a7802.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3e/af/24/4a10e1af3810cbce15cb1aaaf55a7802.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3e/af/24/4a10e1af3810cbce15cb1aaaf55a7802.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/d4/1b/4f/abbf89112909c0f4cb6ad429e311b7e1.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d4/1b/4f/abbf89112909c0f4cb6ad429e311b7e1.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d4/1b/4f/abbf89112909c0f4cb6ad429e311b7e1.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d4/1b/4f/abbf89112909c0f4cb6ad429e311b7e1.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d4/1b/4f/abbf89112909c0f4cb6ad429e311b7e1.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/b2/a6/36/8b5765a4