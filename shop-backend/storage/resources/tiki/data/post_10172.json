ki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/3c/92/69/c23c5f35fae6533b62c599d0a1d67eca.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/3c/92/69/c23c5f35fae6533b62c599d0a1d67eca.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/3c/92/69/c23c5f35fae6533b62c599d0a1d67eca.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3c/92/69/c23c5f35fae6533b62c599d0a1d67eca.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3c/92/69/c23c5f35fae6533b62c599d0a1d67eca.jpg"}],"warranty_policy":null,"authors":[{"id":110989,"name":"Tăng Văn Mùi - Trần Duy Nam","slug":"tang-van-mui-tran-duy-nam"}],"current_seller":{"id":39,"sku":"2442915931082","name":"Trí Dân","link":"https://tiki.vn/cua-hang/tri-dan","logo":"30/d2/46/30d24691868937032a55d28471d2aca0.jpg","price":65000,"product_id":"581921","store_id":62,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Thông tin chung","attributes":[{"code":"publisher_vn","name":"Công ty phát hành","value":"Trí Dân"},{"code":"publication_date","name":"Ngày xuất bản","value":"2010-06-14 00:00:00"},{"code":"dimensions","name":"Kích thước","value":"19 x 27 cm "},{"code":"book_cover","name":"Loại bìa","value":"Bìa mềm"},{"code":"number_of_page","name":"Số trang","value":"150"},{"code":"manufacturer","name":"Nhà xuất bản","value":"Nhà Xuất Bản Khoa học và Kỹ thuật"}]}],"product_links":[],"gift_item_title":"0 quà tặng kèm","services_and_promotions":[],"promitions":[],"stock_item":{"max_sale_qty":1000,"min_sale_qty":1,"preorder_date":null,"qty":1000},"quantity_sold":{"text":"Đã bán 301","value":