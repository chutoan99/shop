tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":391000,"discount_rate":20,"rating_average":5,"review_count":14,"review_text":"(14)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/f3/bc/32/29f09a2ecb93f965fb2fa20592d95cef.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":876,"all_time_quantity_sold":32,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p class=\"irIKAp\"><strong>***Balo laptop Sakos Matura: THÔNG MINH BẮT KỊP XU HƯỚNG***</strong></p>\n<p class=\"irIKAp\">MATURA là dòng balo laptop có thể đựng vừa laptop 15.6 inch, có thiết kế thông minh và là sản phẩm mới nhất của Sakos với nhiều tính năng hiện đại. Đây là dòng balo cao cấp hướng đến giới trẻ năng động và nắm bắt xu hướng trời trang mới lạ. Thiết kế gọn nhẹ, phân ngăn tiện dụng cùng nhiều tiện ích vượt trội đã tạo nên một dòng balo laptop hoàn hảo cho công dân toàn cầu thế kỷ công nghệ số.</p>\n<p class=\"irIKAp\"><strong>1. THÔNG SỐ CỦA SẢN PHẨM</strong></p>\n<p class=\"irIKAp\">- Thương hiệu: Sakos</p>\n<p class=\"irIKAp\">- Màu sắc: Xanh – đen, Xám – đen, Xám – nâu, Xanh – nâu</p>\n<p class=\"irIKAp\">- Chất liệu: Polyester, PU, EVA, PE</p>\n<p class=\"irIKAp\">- Trọng lượng: 0.9 kg</p>\n<p class=\"irIKAp\">- Kích thước RxSxC: 30x17x44 cm</p>\n<p class=\"irIKAp\">- Tải trọng: 15 kg</p>\n<p class=\"irIKAp\">- Bảo hành: chính hãng 01 năm.</p>\n<p class=\"irIKAp\"><strong>2. CHI TIẾT SẢN PHẨM</strong></p>\n<p class=\"irIKAp\">Balo laptop MATURA có thiết kế hiện đại với chất liệu chống nước tuyệt đối</p>\n<p class=\"irIKAp\"> </p>\n<div class=\"irIKAp\">\n<div>\n<div class=\"cxDtMn\"><img class=\"_0O7Vlf bgImIg\" src=\"https://down-vn.img.susercontent.com/file/vn-11134208-7qukw-litr5ccll82492\" alt=\"vn-11134208-7qukw-litr5ccll82492\" /></div>\n</div>\n</div>\n<p class=\"irIKAp\"> </p>\n<p class=\"irIKAp\">- Thiết kế quen thuộc với hình hộp chữ nhất đứng nhưng tạo điểm nhấn “trượt nóc” ở phần đỉnh lạ mắt.</p>\n<p class=\"irIKAp\">- Chất liệu polyester phủ PU chống nước tuyệt đối, bền bỉ, dễ dàng vệ sinh bằng khăn ẩm khi bị dính bẩn.</p>\n<p class=\"irIKAp\">- Ngăn mở rộng với dây kéo sát mặt lưng, tăng cường thể tích lên 20% so với trạng thái bình thường.</p>\n<p class=\"irIKAp\">- Bên trong trang bị vải lót 3 tính năng: chống thấm, hút ẩm, kháng khuẩn.</p>\n<p class=\"irIKAp\"> </p>\n<p class=\"irIKAp\">Phân ngăn tiện lợi khiến balo laptop MATURA phù hợp đi học, đi làm hoặc du lịch</p>\n<div class=\"irIKAp\">\n<div>\n<div class=\"cxDtMn\"><img class=\"_0O7Vlf bgImIg\" src=\"https://down-vn.img.susercontent.com/file/vn-11134208-7qukw-litr5cclquvmd0\" alt=\"vn-11134208-7qukw-litr5cclquvmd0\" /></div>\n</div>\n</div>\n<div class=\"irIKAp\">\n<div>\n<div class=\"cxDtMn\"><img class=\"_0O7Vlf bgImIg\" src=\"https://down-vn.img.susercontent.com/file/vn-11134208-7qukw-litr5ccls9g25d\" alt=\"vn-11134208-7qukw-litr5ccls9g25d\" /></div>\n</div>\n</div>\n<p class=\"irIKAp\">- Ngăn laptop chống sốc 15.6 inch được tích hợp bên trong ngăn chính tiện lợi.</p>\n<p class=\"irIKAp\">- Ngăn chính rộng rãi có thể đựng quần áo cho chuyến đi cả tuần.</p>\n<p class=\"irIKAp\">- Hệ thống các ngăn phụ kích thước lớn – nhỏ đa dạng tiết kiệm thời sắp xếp đồ dùng ngăn nắp.</p>\n<p class=\"irIKAp\">- Hai ngăn phụ bên hông với độ co giãn nhất định dễ dàng cất – lấy đồ dùng nhanh chóng.</p>\n<p class=\"irIKAp\">Đệm lưng thoáng khí, quai đeo êm ái giúp balo laptop MATURA chống đau vai, mỏi cổ</p>\n<div class=\"irIKAp\">\n<div>\n<div class=\"cxDtMn\"><img class=\"_0O7Vlf bgImIg\" src=\"https://down-vn.img.susercontent.com/file/vn-11134208-7qukw-litr5cclto0i10\" alt=\"vn-11134208-7qukw-litr5cclto0i10\" /></div>\n</div>\n</div>\n<p class=\"irIKAp\">- Quai đeo to bản với đệm mút dày, chống hằn, chống đau vai, mỏi cổ. Dễ dàng điều chỉnh chiều dài dây đeo với chốt tăng – đơ tiện lợi.</p>\n<p class=\"irIKAp\">- Đệm lưng EVA cấu trúc tổ ong với hàng ngàn lỗ thông khí chống nóng lưng.</p>\n<p class=\"irIKAp\">- Quai xách cấu tạo 2 lớp với đệm mút dày êm ái và sử dụng công nghệ đánh bọ siêu bền.</p>\n<p class=\"irIKAp\">Balo laptop nam MATURA thông minh trong từng chi tiết mang lại cảm giác thoải mái cho người dùng</p>\n<div class=\"irIKAp\">\n<div>\n<div class=\"cxDtMn\"><img class=\"_0O7Vlf bgImIg\" src=\"https://down-vn.img.susercontent.com/file/vn-11134208-7qukw-litr5cclh0csac\" alt=\"vn-11134208-7qukw-litr5cclh0csac\" /></div>\n</div>\n</div>\n<div class=\"irIKAp\">\n<div>\n<div class=\"cxDtMn\"><img class=\"_0O7Vlf bgImIg\" src=\"https://down-vn.img.susercontent.com/file/vn-11134208-7qukw-litr5ccliex88b\" alt=\"vn-11134208-7qukw-litr5ccliex88b\" /></div>\n</div>\n</div>\n<p class=\"irIKAp\"> </p>\n<p class=\"irIKAp\">- Dây kéo nhựa dẻo phủ PU chống nước tuyệt đối.</p>\n<p class=\"irIKAp\">- Cổng sạc USB thông minh dễ dàng kết nối với sạc dự phòng và điện thoại.</p>\n<p class=\"irIKAp\">- Đai cố định vào cần kéo vali tiện lợi.</p>\n<p class=\"irIKAp\">- Đai móc mắt kính tinh tế được tích hợp trên quai đeo.</p>\n<p class=\"irIKAp\"><strong>3. SAKOS CAM KẾT VỚI KHÁCH HÀNG</strong></p>\n<p class=\"irIKAp\">- 1 ĐỔI 1 trong vòng 07 ngày sản phẩm bị lỗi do nhà sản xuất (nhắn tin cho Shop để được hỗ trợ nhanh nhất).</p>\n<p class=\"irIKAp\">- BẢO HÀNH chính hãng theo chính sách của Sakos.</p>\n<p class=\"irIKAp\"><strong>4. DỊCH VỤ CỦA SAKOS</strong></p>\n<p class=\"irIKAp\">- Các sản phẩm của Sakos khi giao đến tay khách hàng thân yêu &lt;3 đều được kèm theo Phiếu Bảo Hành chính hãng của Sakos</p>\n<p class=\"irIKAp\">- Gói hàng cẩn thận trước khi giao cho khách.</p>\n<p class=\"irIKAp\">- Hỗ trợ tư vấn chăm sóc khách hàng 24/7 (khách iu ơi! Nhắn cho Sakos ngay nhé)</p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/f3/bc/32/29f09a2ecb93f965fb2fa20592d95cef.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f3/bc/32/29f09a2ecb93f965fb2fa20592d95cef.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f3/bc/32/29f09a2ecb93f965fb2fa20592d95cef.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f3/bc/32/29f09a2ecb93f965fb2fa20592d95cef.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f3/bc/32/29f09a2ecb93f965fb2fa20592d95cef.png"},{"base_url":"https://salt.tikicdn.com/ts/product/8e/79/7f/a1b81c96a6616715116974ade734a4f8.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/8e/79/7f/a1b81c96a6616715116974ade734a4f8.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/8e/79/7f/a1b81c96a6616715116974ade734a4f8.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8e/79/7f/a1b81c96a6616715116974ade734a4f8.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8e/79/7f/a1b81c96a6616715116974ade734a4f8.png"},{"base_url":"https://salt.tikicdn.com/ts/product/58/fe/d3/e7ac1fb713e6fb2ffe72747bf