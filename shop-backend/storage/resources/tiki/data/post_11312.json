son"}},"discount":2310000,"discount_rate":31,"rating_average":4.3,"review_count":3,"review_text":"(3)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ab/bc/03/d9ce784785746d912146951e6b787138.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1296,"all_time_quantity_sold":7,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<div>\n<p><strong>(MIỄN PHÍ giao hàng và lắp đặt tại: Hà Nội, TP. Hồ Chí Minh, Hải Phòng và Đà Nẵng)</strong></p>\n</div>\n<div>Giàn tạ đa năng kết hợp xà đơn xà kép Zasami 8211 tích hợp nhiều bài tập, sẽ là lựa chọn hoàn hảo để bạn có cơ bụng 6 múi, thân hình săn chắc mà không cần đến phòng Gym.</div>\n<div><iframe src=\"//www.youtube.com/embed/wOKqBvorKk0\" width=\"560\" height=\"314\" allowfullscreen=\"\"></iframe></div>\n<h2><strong>THÔNG SỐ KỸ THUẬT</strong></h2>\n<table style=\"width:100%;height:170px;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\"><tbody><tr style=\"height:17px;\"><td style=\"width:38.3897%;height:17px;\" width=\"239\">\n<div><strong>  Mã sản phẩm</strong></div>\n</td>\n<td style=\"width:61.3769%;height:17px;\" width=\"383\">\n<div>  SGD 8211</div>\n</td>\n</tr><tr style=\"height:17px;\"><td style=\"width:38.3897%;height:17px;\" width=\"239\">\n<div><strong>  Thương hiệu</strong></div>\n</td>\n<td style=\"width:61.3769%;height:17px;\" width=\"383\">\n<div>  Zasami</div>\n</td>\n</tr><tr style=\"height:17px;\"><td style=\"width:38.3897%;height:17px;\" width=\"239\">\n<div><strong>  Xuất xứ</strong></div>\n</td>\n<td style=\"width:61.3769%;height:17px;\" width=\"383\">\n<div>  Việt Nam</div>\n</td>\n</tr><tr style=\"height:17px;\"><td style=\"width:38.3897%;height:17px;\" width=\"239\">\n<div><strong>  Tải trọng tối đa</strong></div>\n</td>\n<td style=\"width:61.3769%;height:17px;\" width=\"383\">\n<div>  200 kg</div>\n</td>\n</tr><tr style=\"height:17px;\"><td style=\"width:38.3897%;height:17px;\" width=\"239\">\n<div><strong>  G.W</strong></div>\n</td>\n<td style=\"width:61.3769%;height:17px;\" width=\"383\">\n<div>  53.5 kg</div>\n</td>\n</tr><tr style=\"height:17px;\"><td style=\"width:38.3897%;height:17px;\" width=\"239\">\n<div><strong>  Kích thước đóng thùng</strong></div>\n</td>\n<td style=\"width:61.3769%;height:17px;\" width=\"383\">\n<div>  150 x 80 x 30 cm</div>\n</td>\n</tr><tr style=\"height:17px;\"><td style=\"width:38.3897%;height:17px;\" width=\"239\">\n<div><strong>  Kích thước lắp đặt (CxRxD)</strong></div>\n</td>\n<td style=\"width:61.3769%;height:17px;\" width=\"383\">\n<div>  238 x 124 x 225 cm</div>\n</td>\n</tr><tr style=\"height:17px;\"><td style=\"width:38.3897%;height:17px;\" width=\"239\">\n<div><strong>  Chất liệu sử dụng</strong></div>\n</td>\n<td style=\"width:61.3769%;height:17px;\" width=\"383\">\n<div>  Khung thép 50 x 50 mm, dày 1,4 mm; màu đen</div>\n</td>\n</tr><tr style=\"height:17px;\"><td style=\"width:38.3897%;height:17px;\" width=\"239\">\n<div><strong>  Nệm ghế</strong></div>\n</td>\n<td style=\"width:61.3769%;height:17px;\" width=\"383\">\n<div>  4 cm – màu đỏ</div>\n</td>\n</tr><tr style=\"height:17px;\"><td style=\"width:38.3897%;height:17px;\" width=\"239\">\n<div><strong>  Chức năng</strong></div>\n</td>\n<td style=\"width:61.3769%;height:17px;\" width=\"383\">\n<div>  Gồm 11 chức năng cơ bản về các cơ</div>\n</td>\n</tr></tbody></table><h2><strong>ĐẶC ĐIỂM NỔI BẬT</strong></h2>\n<p> </p>\n<p> </p>\n<p>Giàn tạ đa năng kết hợp xà đơn xà kép Zasami 8211 với <strong>11 chức năng</strong> tập Gym tại nhà gồm:</p>\n<p><strong><em>- Tập kéo xô trước - xô sau</em></strong></p>\n<p><strong><em>- Tập cơ đùi trước - cơ đùi sau</em></strong></p>\n<p><strong><em>- Tập ngực trên - ngực dưới - ngực giữa <br /></em></strong></p>\n<p><strong><em>- Tập bụng</em></strong></p>\n<p><strong><em>- Tập ép ngực</em></strong></p>\n<div>Thiết kế chắc chắn, kiểu dáng thể thao, màu sắc nổi bật sẽ tạo phong cách riêng cho ngôi nhà bạn.</div>\n<div>Bề mặt được sơn tĩnh điện, độ bền cao, chống gỉ, chống xước tốt.</div>\n<div>Tiện nghi tối đa: thiết kế động điều chỉnh phù hợp với thể hình mỗi người.</div>\n<div>Nệm tựa lưng êm ái – hạn chế chấn thương.</div>\n<div>Hiệu quả tối ưu: bộ ròng rọc trợ lực, dây cáp, bố trí các điểm puly phù hợp cho các động tác được kéo nhẹ, mượt, trơn.</div>\n<div>\n<h2><strong>HƯỚNG DẪN CÁC BÀI TẬP</strong></h2>\n<p> với thiết kế đơn giản, dễ dàng sử dụng nhưng các bạn có thể dành ra một vài phút để tìm hiểu về cách tập luyện của giàn tạ này.</p>\n<p><img style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/47/49/1a/3a195f04900b94667c5e79201596269e.jpg\" alt=\"\" width=\"750\" height=\"1000\" /></p>\n<p><img style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/f3/3b/c3/34839488abbe50ce32dfddaaeca27f53.jpg\" alt=\"\" width=\"750\" height=\"1000\" /></p>\n<p><img style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/bd/61/15/3b97b1e1587b89d784a34f240feced4f.jpg\" alt=\"\" width=\"750\" height=\"1000\" /></p>\n<p><img style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/65/23/a7/afd54bf02de4c7afdc366c49c35177b5.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<div>Với bất kỳ bài tập nào cũng vậy, giàn tạ Zasami 8211 cũng cần 5 phút khởi động bình thường để các khớp, cơ bắp sẵn sàng vận động theo cường độ tập luyện của bạn.</div>\n<div>Bài tập theo từng nhóm cơ bắp trên cơ thể. Tùy theo mục đích luyện tập bạn có thể chọn cho mình bài tập phù hợp với bản thân. Giàn tạ đa năng kết hợp xà đơn xà kép Zasami 8211 được làm từ thép hộp có khả năng chịu lực tốt, nệm da êm ái cho cảm giác thoải mái khi nằm đẩy tạ hay kéo xô. Ngay cả những bài tập chân cũng có các đệm mút êm ái sẽ giúp bạn tập luyện hiệu quả nhất.</div>\n</div><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ab/bc/03/d9ce784785746d912146951e6b787138.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ab/bc/03/d9ce784785746d912146951e6b787138.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ab/bc/03/d9ce784785746d912146951e6b787138.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ab/bc/03/d9ce784785746d912146951e6b787138.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ab/bc/03/d9ce784785746d912146951e6b787138.png"},{"base_url":"https://salt.tikicdn.com/ts/product/f8/6e/56/151f6832d7ac1a5199b37e0c367b0924.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f8/6e/56/151f6832d7ac1a5199b37e0c367b0924.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f8/6e/56/151f6832d7ac1a5199b37e0c367b0924.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f8/6e/56/151f6832d7ac1a5199b37e0c367b0924.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f8/6e/56/151f6832d7ac1a5199b37e0c367b0924.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/49/08/3d/c182c3fb9f4cb2a22625dac00b79603f.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/49/08/3d/c182c3fb9f4cb2a22625dac00b79603f.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/49/08/3d/c182c3fb9f4cb2a22625dac00b79603f.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/