4467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":false,"is_freeship_xtra":false,"is_hero":true,"return_reason":"any_reason"}},"discount":69500,"discount_rate":50,"rating_average":5,"review_count":3,"review_text":"(3)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/a4/c2/76/6459a1749c63632055cc830e2ba7ea90.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":773,"all_time_quantity_sold":137,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003chtml\u003e\n \u003chead\u003e\u003c/head\u003e\n \u003cbody\u003e\n  \u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eTư Duy Ngược\u003c/strong\u003e\u003c/p\u003e \n  \u003cp style=\"text-align: justify;\"\u003eChúng ta thực sự có hạnh phúc không? Chúng ta có đang sống cuộc đời mình không? Chúng ta có dám dũng cảm chiến thắng mọi khuôn mẫu, định kiến, đi ngược đám đông để khẳng định bản sắc riêng của mình không?. Có bao giờ bạn tự hỏi như thế, rồi có câu trả lời cho chính mình?\u003c/p\u003e \n  \u003cp style=\"text-align: justify;\"\u003eTôi biết biết, không phải ai cũng đang sống cuộc đời của mình, không phải ai cũng dám vượt qua mọi lối mòn để sáng tạo và thành công… Dựa trên việc nghiên cứu, tìm hiểu, chắt lọc, tìm kiếm, ghi chép từ các câu chuyện trong đời sống, cũng như trải nghiệm của bản thân, tôi viết cuốn sách này.\u003c/p\u003e \n  \u003cp style=\"text-align: justify;\"\u003eCuốn sách sẽ giải mã bạn là ai, bạn cần \u003cstrong\u003eTư duy ngược\u003c/strong\u003e để thành công và hạnh phúc như thế nào và các phương pháp giúp bạn dũng cảm sống cuộc đời mà bạn muốn.\u003c/p\u003e\n \u003c/body\u003e\n\u003c/html\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/a4/c2/76/6459a1749c63632055cc830e2ba7ea90.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a4/c2/76/6459a1749c63632055cc830e2ba7ea90.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a4/c2/76/6459a1749c63632055cc830e2ba7ea90.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a4/c2/76/6459a1749c63632055cc830e2ba7ea90.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a4/c2/76/6459a1749c63632055cc830e2ba7ea90.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/32/bb/ab/8c7bbee83ef1304fba7695805ed87459.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/32/bb/ab/8c7bbee83ef1304fba7695805ed87459.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/32/bb/ab/8c7bbee83ef1304fba7695805ed87459.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/32/bb/ab/8c7bbee83ef1304fba7695805ed87459.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/32/bb/ab/8c7bbee83ef1304fba7695805ed87459.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/46/2e/2c/53b473e741afeb622b110cb4ec9fde56.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/46/2e/2c/53b473