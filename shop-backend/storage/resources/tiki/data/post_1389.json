3f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":150000,"discount_rate":18,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/52/61/e3/1167a179672f19a0faaa31740e7e8f8f.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":741,"all_time_quantity_sold":7,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cdiv class=\"Iv7FJp\"\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cstrong\u003e*Lắp ráp*\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Bộ sản phẩm được đóng gói dạng rời gồm các tấm gỗ được dán nhãn và đánh số kèm theo sơ đồ lắp ráp, đầy đủ phụ kiện.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Nếu có lỗi/hư hỏng do sản xuất hoặc do lỗi vận chuyển. SIB Decor cam kết gửi thay thế phần bị hỏng ngay khi nhận được yêu cầu.\u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv class=\"MCCLkq\"\u003e\n\u003cdiv class=\"f7AU53\"\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/94/4a/34/10cc8f71a1256b6fcbc02db616d7f6ab.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e— — — — — — — — —\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThông số\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Chất liệu tốt: gỗ MDF lõi xanh chống ẩm, độ dày 17mm, bề mặt phủ melamine đồng màu, căng phẳng có khả năng kháng nước, hạn chế trầy xước, lau sạch dễ dàng.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Kích thước: 120 x 40 x 20cm (Dài x Cao x Sâu).\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Màu sắc: Trắng; Xanh đen; Vân gỗ sồi.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Ứng dụng:\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e+ Để sách, tài liệu chậu cây, khung ảnh, vật dụng trang trí. Khả năng chịu lực đến 30kg mỗi kệ.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e+ Phù hợp với nhiều không gian: Phòng khách, phòng ngủ, văn phòng làm việc.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Bộ sản phẩm gồm: Kệ gỗ, phụ kiện, hướng dẫn lắp đặt, tặng kèm nivo mini (thước thủy để lấy cân bằng).\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Thương hiệu: SIB Decor.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Sản phẩm được sản xuất tại: Công ty TNHH Trang Trí Nội Thất Đơn Giản Là Đẹp\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Địa chỉ: 2/4/2 Đông Hưng Thuận 10B, phường Đông Hưng Thuận, Quận 12, TP. Hồ Chí Minh.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Xuất xứ: Việt Nam\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e— — — — — — — — —\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eĐiểm nổi bật\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Dễ dàng lắp ráp: Kệ gỗ được gia công bằng CNC tự động, các vị trí liên kết đều có độ chuẩn xác cao, phụ kiện hiện đại nên chúng mình nghĩ nó sẽ không làm khó được bạn đâu.\u003c/p\u003e\n\u003cp\u003e- Phụ kiện treo kệ là loại kết cấu giấu chân (không giá đỡ) được thiết kế riêng biệt với khả năng chịu lực rất tốt và đảm bảo an toàn. \u003c/p\u003e\n\u003cp\u003e*Bên cạnh đó, các hướng dẫn gửi kèm bằng hình ảnh dễ hiểu, có tặng kèm nivo cân bằng để bạn lắp kệ không bị nghiêng, và luôn có đội ngũ kỹ thuật hỗ trợ bạn khi nhận được yêu cầu.\u003c/p\u003e\n\u003cp\u003e- Đẹp: Sản phẩm thiết kế tối ưu về công năng sử dụng, khả năng chịu lực và luôn được xử lý đẹp Trước – Sau – Trên – Dưới. Các vị trí liên kết đều được cung cấp miếng dán decal đồng màu để che lại rất thẩm mỹ.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/5b/71/c1/7d50064357b77693b1e36392f2c7804f.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/35/83/eb/d3fbe0e73832f38bafbc2c74d3545e6e.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cdiv class=\"irIKAp\"\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"cxDtMn\"\u003e\u003cimg class=\"_0O7Vlf bgImIg\" style=\"margin-left:auto;margin-right:auto;\" src=\"https://down-vn.img.susercontent.com/file/vn-11134208-7qukw-lhfvrobrgh3947\" alt=\"vn-11134208-7qukw-lhfvrobrgh3947\" width=\"750\" height=\"750\" /\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"irIKAp\"\u003e\n\u003cdiv class=\"cxDtMn\"\u003e\u003cimg class=\"_0O7Vlf bgImIg\" style=\"margin-left:auto;margin-right:auto;\" src=\"https://down-vn.img.susercontent.com/file/vn-11134208-7qukw-lhfvrobr3u0x10\" alt=\"vn-11134208-7qukw-lhfvrobr3u0x10\" width=\"750\" height=\"750\" /\u003e\u003c/div\u003e\n\u003cdiv class=\"cxDtMn\"\u003e\n\u003cp class=\"irIKAp\"\u003e— — — — — — — — —\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cstrong\u003eMột số câu hỏi thường gặp\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cstrong\u003eKhi nào tôi nhận được hàng?\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Vận chuyển bởi nhà bán hàng: SIB Decor liên hệ xác nhận ngay sau khi nhận được đơn hàng. Thời gian giao hàng thường từ 0-3 ngày làm việc (có giao thứ 7, chủ nhật).\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Giao hàng tiết kiệm: Thông thường từ 1-5 ngày.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cstrong\u003eSản phẩm còn hàng không?\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Tất cả các sản phẩm đều có hàng sẵn, bạn có thể đặt hàng ngay.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cstrong\u003eSIB có lắp đặt tận nơi không?\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Đây là sản phẩm được giao hàng bởi đối tác vận chuyển của Tiki. Do đó, dịch vụ lắp đặt tận nơi không được cung cấp.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cstrong\u003eCam kết với khách hàng?\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- SIB xử lý các sự cố (nếu có) luôn nhanh nhất và có lợi nhất cho khách hàng.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Bảo hành 1 đổi 1 trong vòng 7 ngày nếu sản phẩm hư hỏng do vận chuyển hoặc do lỗi sản xuất.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Bảo hành chất lượng sản phẩm 24 tháng, bảo trì và chăm sóc trọn đời sản phẩm.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e— — — — — — — — —\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cstrong\u003e Hướng dẫn\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Sản phẩm khách hàng tự lắp ráp (các tấm gỗ được dán nhãn và đánh số kèm theo sơ đồ lắp ráp đầy đủ, rất dễ dàng thực hiện).\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Khi cần làm sạch, chỉ cần dùng khăn ẩm và lau nhẹ (bề mặt phủ melamine có khả năng chống trầy xước, bền màu nên rất dễ làm sạch).\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Hạn chế để nơi có ánh nắng chiếu trực tiếp, nơi ẩm ướt.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e— — — — — — — — —\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cstrong\u003eWelcome to SIB Decor \u0026lt;3\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eChúng tôi phục vụ bạn bằng sự trung thực, luôn sẵn sàng hỗ trợ bạn bất cứ lúc nào. Nếu bạn có bất kỳ câu hỏi nào về việc lắp đặt hoặc bảo hành sản phẩm, vui lòng liên hệ với chúng tôi.\u003c/p\u003e\n\u003cp\u003eHy vọng sản phẩm của SIB Decor sẽ mang lại nhiều hạnh phúc hơn cho cuộc sống của bạn.\u003c/p\u003e\n\u003cp\u003e#ketrangtri #kesach #giasach #sibdecor #kego #ketreotuong #k