:null,"text":"9.9"},{"placement":"pdp_badge","code":"is_hero","type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"freeship_xtra","type":"pdp_icon_badge","index":2,"icon":"https://salt.tikicdn.com/ts/upload/be/67/48/04a82ab8df178e1a13bde38316081865.png","icon_width":91,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":true,"return_reason":"any_reason"}},"discount":51000,"discount_rate":30,"rating_average":4.8,"review_count":498,"review_text":"(498)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/60/82/1f/ea4bdbe43c788159f84eb30981ec3b3f.png","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1258,"all_time_quantity_sold":2577,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2 style=\"text-align:left;\"\u003e\u003cstrong\u003e4 TƯ DUY ĐỘC ĐÁO VÀ 7 BƯỚC TĂNG TỐC KHỞI NGHIỆP GIÚP BẠN KINH DOANH BỀN VỮNG.\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003e\u003cstrong\u003eKinh doanh có rất nhiều rủi ro. Đừng dại dột!\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eĐó là nhận định của số đông đã thất bại và cố gắng “tỏ ra thông thái”  bằng những lời khuyên hữu ích cho người đến sau. Thực tế thì hoàn toàn ngược lại!\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eKinh doanh không hề rủi ro như người ta đã thổi phồng.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eGiống như mọi ngành nghề, để\u003c/span\u003e\u003cstrong\u003e khởi sự kinh doanh hiệu quả\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e bạn cần có một \u003c/span\u003e\u003cstrong\u003elộ trình đúng đắn.\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eNếu đi sai, bạn sẽ trả giá.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eNếu đi đúng, bạn sẽ rất an toàn và nhanh chóng đạt được thành công.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eQuyển sách \u003c/span\u003e\u003cstrong\u003eLối Tắt Khởi Nghiệp\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e sẽ chỉ ra cho bạn con đường đó.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eTư duy độc đáo, thú vị trong sách sẽ giúp bạn xây nên doanh nghiệp thành công, trong thời gian rất ngắn, bất kể bạn đang gặp rào cản về chuyên môn, vốn liếng, kinh nghiệm hay thiếu ý tưởng.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eQuyển sách là một chuyến phiêu lưu kinh doanh đầy thú vị, mang đến cho bạn:\u003c/span\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003e“\u003c/span\u003e\u003cstrong\u003eBài học về 3 viên đá nhỏ\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e”: Mỗi viên đá nhỏ là vũ khí chống lại nghèo đói, lười biếng và cả sự ngu dốt.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003e“4 tư duy khởi nghiệp độc đáo”\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e bao gồm: tư duy của người khai hoang, người cày xới, người gieo hạt và người chăm sóc. Mỗi tư duy là một công cụ hữu ích giúp bạn từng bước nhìn thấy được nhu cầu của khách hàng, tìm ra giải pháp và biến chúng thành những công việc kinh doanh sinh lời nhanh chóng.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eQuyển sách còn trang bị cho bạn “\u003c/span\u003e\u003cstrong\u003eVòng lặp tăng tốc khởi nghiệp” \u0026amp; “7 kỹ năng kinh doanh cơ bản”\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e để bạn tự tin khởi nghiệp ngay mà không phải đối mặt với rủi ro hay thất bại.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eNgoài ra, sách còn có thêm \u003c/span\u003e\u003cstrong\u003e15 câu chuyện thành công \u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003ecủa nhiều người đang là triệu phú nhờ áp dụng tư duy trong quyển sách vào công việc kinh doanh thực tế của mình\u003c/span\u003e\u003cstrong\u003e.\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e 15 tấm gương này sẽ mang đến cho bạn những bài học sinh động nhất - thực tế nhất, để bạn quyết định hành động ngay.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"padding-left:40px;\"\u003e\u003cem\u003e\u003cspan style=\"font-weight:400;\"\u003eĐường tắt không có nghĩa là đường dễ đi nhưng nó giúp ta đi nhanh hơn. Có rất nhiều cách để đến với thành công nhưng người khôn ngoan luôn biết tìm ra con đường ngắn nhất cho riêng mình.\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eHãy đọc \u003c/span\u003e\u003cstrong\u003eLối Tắt Khởi Nghiệp\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e và hẹn gặp bạn trên đỉnh thành công!\u003c/span\u003e\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eDỊCH GIẢ: TRẦN THANH PHONG\u003c/strong\u003e\u003c/h2\u003e\n\u003ch3\u003e\u003cstrong\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/9b/87/44/14c61423ca3518fdbc77103995cea867.png\" alt=\"\" width=\"206\" height=\"206\"\u003e\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eTrần Thanh Phong là tác giả, chủ doanh nghiệp và là một vận động viên ba môn phối hợp Ironman. Anh được mọi người nhắc đến như là một tác giả Việt đầu tiên viết về chủ đề \u003c/span\u003e\u003cstrong\u003eKhởi Nghiệp Kinh Doanh Thực Chiến\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e, bao gồm những quyển sách như:\u003c/span\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eKhởi Nghiệp Bán Lẻ\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eKhởi Nghiệp Du Kích\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eĐừng Để Mất Bò\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eTrên Lưng Khổng Tượng\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eAnh không phải là diễn giả hay học giả mà là một người làm nghề thực sự. Sau 15 năm khởi nghiệp, từng quản lý nhiều công việc kinh doanh, từ ngành bán lẻ, thương mại điện tử cho đến lĩnh vực xuất bản, anh đã đúc kết nhiều kinh nghiệm hết sức thực tế và gói gọn trong tập sách này.\u003c/span\u003e\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eTÓM TẮT SƠ LƯỢC\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003e\u003cstrong\u003eChuyến phiêu lưu thứ nhất: Bài học từ 3 viên đá nhỏ giữ cho bạn không bị chết chìm vì lòng ghen tị.\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eTrong cuộc sống thường ngày và cả việc kinh doanh, chắc chắn bạn sẽ khó tránh khỏi sự ghen tị với những đối tượng giỏi hơn mình. Đừng như vậy, chính lòng đố kỵ sẽ giết đi sự sáng tạo trong bạn. Chúng kìm hãm không cho bạn phát triển theo cách của bạn mà sẽ mãi chạy theo hình bóng của người khác. Bên cạnh đó, ở chặng đường này tác giả còn chia sẻ cho bạn biết biết những nguyên tắc cơ bản trong kinh doanh.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eChuyến phiêu lưu thứ hai: Đừng tốn công cho những thứ không cần thiết\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eBạn không phải là thiên tài, bạn không thể biết tất cả mọi thứ, cho dù là bạn biết, quỹ thời gian của mỗi người cũng không cho phép bạn thực hiện tất cả mọi việc. Vì sao không để những người tài giỏi về chuyên môn đó thực hiện đúng vai trò của mình. Bạn có thể thuê ngoài các chuyên gia, việc của bạn chỉ là quản lý họ.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eChuyến phiêu lưu thứ ba: Tập trung vào những điều thực sự cần cho bạn\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eCó một số đặc điểm mà một doanh nhân cần phải trau dồi cho mình. Ví dụ như bạn là người sợ việc chấp nhận rủi ro, hãy tìm cách điều khiển chúng lại. Hãy rèn luyện cho mình một tinh thần can trường và làm chủ nỗi sợ. Có như vậy, đích đến thành công sẽ gần với bạn hơn.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eChuyến phiêu lưu thứ tư: 4 tư duy bứt phá\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eỞ chặng đường này, tác giả sẽ bật mí cho bạn 4 tư duy của người làm vườn bao gồm: Tư duy của người khai hoang, người cày xới, người gieo mầm và người chăm sóc. Sở hữu 2 trong 4 tư duy này là bạn đã có thể bước nhanh hơn đến đích thành công. Chúng giúp cho bạn tránh những hoạt động gây lãng phí thời gian mà không mang lại hiệu quả trong công việc kinh doanh. Để biết cụ thể hơn từng tư duy đó, bạn hãy tìm đọc cuốn sách “Lối Tắt Khởi Nghiệp”\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eChuyến phiêu lưu thứ 5: 7 kỹ năng quan trọng của một người doanh nhân\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eChúng bao gồm:\u003c/p\u003e\n\u003cp\u003e- Cách sử dụng ngôn từ trong bán hàng hay nói cách khác là tầm quan trọng của việc sử dụng ngôn ngữ.\u003cbr\u003e- Người làm chủ và chuyên gia khác nhau như thế nào\u003cbr\u003e- Nhập vai trở thành người lính mới\u003cbr\u003e- Phát triển tư duy kết quả so với quy trình\u003cbr\u003e- Kiếm tiền trong niềm hạnh phúc\u003cbr\u003e- Rút ra những bài học từ mất mát, sai lầm và khoảnh khắc thiếu liêm chính của bản thân.\u003cbr\u003e- Tạo ra bước nhảy vọt\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eChuyến phiêu lưu thứ 6: 4 cấp độ tăng trưởng trong kinh doanh\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eBạn có thể đánh giá cấp độ của mình thông qua hành động và kết quả. Ở chương này sẽ chia sẻ đến bạn những phương pháp đánh giá, cho bạn biết được tư duy bán hàng của bạn sẽ như thế nào? kỹ năng cá nhân, cách để nâng cấp bản thân và tầm nhìn của một doanh nhân vĩ đại.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eChuyến phiêu lưu thứ 7: Bài học thực tế từ 15 câu chuyện thành công.\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e15 câu chuyện thành công của nhiều người đang là triệu phú nhờ áp dụng tư duy trong quyển sách vào công việc kinh doanh thực tế của mình. 15 tấm gương này sẽ mang đến cho bạn những bài học sinh động nhất - thực tế nhất, để bạn quyết định hành động ngay.\u003c/p\u003e\n\u003cp\u003e#loitat #khoinghiep #tuduykhoinghiep #baihoc #kinhdoanh #cauchuyen #thanhcong #tuduybutpha #banhang #thanhcongbenvung\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":