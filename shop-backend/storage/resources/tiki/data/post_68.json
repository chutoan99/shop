ên, những người giờ đây dù tuổi đã trên, dưới tám mươi, vẫn vẹn nguyên niềm lung linh một thời làm báo \u003cem\u003eQuân giải phóng\u003c/em\u003e.\u003c/p\u003e\n\u003cp\u003e(Đại tá, PGS. TS. Hồ Sơn Đài)\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/8c/50/0f/2171098a5ad18ef2dfb869e5f2c98877.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/8c/50/0f/2171098a5ad18ef2dfb869e5f2c98877.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/8c/50/0f/2171098a5ad18ef2dfb869e5f2c98877.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8c/50/0f/2171098a5ad18ef2dfb869e5f2c98877.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8c/50/0f/2171098a5ad18ef2dfb869e5f2c98877.png"}],"warranty_policy":null,"authors":[{"id":17770,"name":"Hồ Sơn Đài","slug":"ho-son-dai"}],"current_seller":{"id":44,"sku":"7581116156678","name":"Nhân Văn","link":"https://tiki.vn/cua-hang/nhan-van","logo":"e2/78/f2/94604b04028e2e93c805b676ac594111.jpg","price":180000,"product_id":"274418757","store_id":64,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[{"id":97533,"name":"Nhà Sách Vĩnh Thụy","link":"https://tiki.vn/cua-hang/nha-sach-vinh-thuy","logo":"https://vcdn.tikicdn.com/ts/seller/19/f2/bd/8bda12adffb15edf1b3d8339b0238283.jpg","price":200000,"product_id":"274780694","store_id":90454}],"specifications":[{"name":"Thông tin chung","attributes":[{"code":"publisher_vn","name":"Công ty phát hành","value":"NXB Tổng Hợp TPHCM"},{"cod