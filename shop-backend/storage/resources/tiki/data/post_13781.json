n_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"defective_product"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/12/c3/57/24cdfb63a27f48d94bba7a74e4188653.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1819,"all_time_quantity_sold":20,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eTÊN SẢN PHẨM: Nước hoa Nữ Laura Anne Mystic 30ml\u003c/p\u003e\n\u003cp\u003eLOẠI NƯỚC HOA: Eau De Parfum (EDP)\u003c/p\u003e\n\u003cp\u003eDÒNG: Laura Anne\u003cbr /\u003e- Nước Hoa Nữ Laura Anne Mystic 30ml với phong cách bí ẩn, mùi hương phá cách đầy sáng tạo và đặc biệt này đã khiến cho các cô gái mạnh mẽ, tự tin luôn say mê, vì nó thể hiện chính cô!\u003c/p\u003e\n\u003cp\u003eTHÔNG TIN SẢN PHẨM: \u003cbr /\u003e- Mùi hương: Cá tính, sành điệu\u003cbr /\u003e- Tầng hương: 3 tầng hương rõ rệt.\u003cbr /\u003eHương gia vị cay của gừng hòa cùng chút chua mát của quýt, cam bergamot và bưởi xộc vào khứu giác, ta đã cảm nhận được ngay, đây là một cô nàng cực cá tính, đỏng đảnh và khó chiều, hoàn toàn có thể gây nghiện và tạo nên sự lôi cuốn không thể cưỡng. \u003cbr /\u003e- Nốt hương: \u003cbr /\u003e+ Hương đầu: cam bergamot, quýt, bưởi, gừng.\u003cbr /\u003e+ Hương giữa: hoa nhài, hoa hồng, hoa cam, bạch đậu khấu\u003cbr /\u003e+ Hương cuối: An tức hương, hương vani, gỗ Cashmere, đậu Tonka\u003cbr /\u003e-Dung tích: 30ml\u003cbr /\u003e-Độ lưu hương: 8H\u003c/p\u003e\n\u003cp\u003ePHÂN LOẠI SẢN PHẨM:\u003cbr /\u003eDòng Nước hoa Laura Anne có 3 loại chính: \u003cbr /\u003e- Dynamic For Him/ Her (màu xanh)\u003cbr /\u003e- Allure For Him/ Her (màu đỏ)\u003cbr /\u003e- Mystic For Him/ Her (màu xám)\u003c/p\u003e\n\u003cp\u003eHƯỚNG DẪN SỬ DỤNG: \u003cbr /\u003e- Hướng vòi xịt vào vị trí cần xịt, cách cơ thể khoảng 15 - 20 cm.\u003cbr /\u003e- Xịt ở những vùng cơ thể tập trung nhiều mạch máu, da ẩm và nhạy cảm như cổ tay, sau gáy, giữa ngực, để hương thơm có thể khuếch tán đồng thời cũng giữ mùi được lâu hơn.\u003cbr /\u003e- Hạn chế xịt trực tiếp lên quần áo và đồ trang sức. Cất nước hoa ở những nơi thoáng mát, không bị ánh nắng chiếu trực tiếp vào sẽ giúp chai nước hoa không bị biến chất, mất mùi.\u003c/p\u003e\n\u003cp\u003eHẠN SỬ DỤNG: \u003cbr /\u003e- 3 năm kể từ ngày sản xuất\u003c/p\u003e\n\u003cp\u003eXUẤT XỨ: \u003cbr /\u003e- Việt Nam\u003c/p\u003e\n\u003cp\u003eĐẶC ĐIỂM NỔI BẬT:\u003cbr /\u003e- Nhà chế tác hàng đầu thế giới: Firmenich\u003cbr /\u003e- Hương liệu nhập khẩu hoàn toàn từ Châu Âu\u003cbr /\u003e- Nhà máy sản xuất đạt chuẩn CGMP và IFra\u003cbr /\u003e- Độ Lưu Hương: 6-8h\u003c/p\u003e\n\u003cp\u003eLƯU Ý:\u003cbr /\u003e-Không được xịt vào mắt.\u003cbr /\u003e-Không để nới có nhiệt độ cao.\u003cbr /\u003e-Để xa tầm tay trẻ em.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/12/c3/57/24cdfb63a27f48d94bba7a74e4188653.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/12/c3/57/24cdfb63a27f48d94bba7a74e4188653.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/12/c3/57/24cdfb63a27f48d94bba7a74e4188653.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/t