ght":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":2601000,"discount_rate":43,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/59/73/f8/6bff5d5f1e1699b49bbcb71ad4a1b14b.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":378,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003eThiết kế không viền - Cảm giác sống động đáng kinh ngạc\u003c/h3\u003e\n\u003cp\u003eTrải nghiệm hình ảnh không giới hạn và tỉ lệ màn hình - thân máy phi thường với thiết kế không có viền, đồng thời sẵn sàng đắm mình trong trải nghiệm xem chân thực, không bị gián đoạn.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/40/b9/1e/d80b68dec35204ad58f7c08529494317.jpg\" alt=\"\" width=\"750\" height=\"383\" /\u003e\u003c/p\u003e\n\u003ch3\u003eNguyên khối - Chất lượng chế tác tuyệt mĩ\u003c/h3\u003e\n\u003cp\u003eHãy cảm nhận vẻ đẹp hoàn hảo, chất lượng cao cấp và kết cấu chắc chắn do thiết kế nguyên khối mang lại.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/af/9d/27/79c8a5d59f32d4adc37f2ee87e5b2726.png\" alt=\"\" width=\"750\" height=\"867\" /\u003e\u003c/p\u003e\n\u003ch3\u003eDTS Virtual:X - Trải nghiệm âm thanh như trong rạp chiếu phim\u003c/h3\u003e\n\u003cp\u003eThông qua thuật toán độc đáo, DTS Virtual:X chuyển đổi âm thanh hai chiều thành âm trường đa chiều, tạo cảm giác về độ cao và không gian. Đắm chìm trong âm thanh phong phú, chi tiết hơn bao giờ hết với giải mã kép của Dolby Audio và DTS-X.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/0c/77/be/92570592e2230b694a32ebc1a230934a.png\" alt=\"\" width=\"750\" height=\"411\" /\u003e\u003c/p\u003e\n\u003ch3\u003eNội dung giải trí bạn yêu thích với sự trợ giúp từ Google\u003c/h3\u003e\n\u003cp\u003eKhông cần phải chuyển từ ứng dụng này sang ứng dụng khác nữa. Google TV tập hợp các bộ phim, chương trình và các nội dung khác từ tất cả các đăng ký của bạn để chúng ở cùng một nơi. Cần nguồn cảm hứng? Nhận các đề xuất được tuyển chọn, sử dụng tính năng tìm kiếm mạnh mẽ của Google để tìm các chương trình trên hơn 10.000 ứng dụng hoặc duyệt qua hàng trăm kênh miễn phí. Và với các cấu hình được cá nhân hóa, trải nghiệm của mọi người sẽ được tùy chỉnh cho riêng họ.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/0d/75/ab/2b919df6749ef9e7dff3b1fb3195c4b5.png\" alt=\"\" width=\"750\" height=\"671\" /\u003e\u003c/p\u003e\n\u003ch3\u003eLàm được nhiều việc hơn trên TV bằng giọng nói của bạn\u003c/h3\u003e\n\u003cp\u003eTV của bạn hữu ích hơn bao giờ hết. Yêu cầu Google Assistant tìm phim, phát trực tuyến các ứng dụng, phát nhạc và điều khiển TV - tất cả bằng giọng nói của bạn. Bạn thậm chí còn có thể xem câu trả lời, điều khiển thiết bị thông minh trong gia đình và làm nhiều việc khác. Nhấn nút Google Assistant trên điều khiển từ xa để bắt đầu.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/a0/a3/65/8b6c8a5fcbae4234ae8559b4ac461d44.png\" alt=\"\" width=\"750\" height=\"417\" /\u003e\u003c/p\u003e\n\u003ch3\u003eĐiều khiển từ xa Bluetooth 360° - Điều khiển TV thoải mái hơn\u003c/h3\u003e\n\u003cp\u003eTrải nghiệm sự tự do liền mạch và không giới hạn với điều khiển từ xa Bluetooth. Trải nghiệm giải trí thú vị hơn với các nút tắt tiện lợi.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/02/78/e1/15855e1b86e70f6410fe93319b45fdac.jpg\" alt=\"\" width=\"750\" height=\"367\" /\u003e\u003c/p\u003e\n\u003ch3\u003ePhát trực tuyến từ điện thoại\u003c/h3\u003e\n\u003cp\u003eNgoài Miracast, bạn có thể dễ dàng phát phim, chương trình, ảnh, từ điện thoại hoặc máy tính bảng của mình sang TV bằng Chromecast built-in.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/7c/cb/80/2395ac10c873c5793b8a8ec0aa6b3287.png\" alt=\"\" width=\"750\" height=\"563\" /\u003e\u003c/p\u003e\n\u003ch3\u003eTrải nghiệm mượt mà hơn\u003c/h3\u003e\n\u003cp\u003eTận hưởng nhiều loại hình giải trí với CPU A55 lõi tứ với RAM 1,5GB và ROM 8GB của chúng tôi.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/3d/9f/cb/46534853281b432ee642209907cb7989.png\" alt=\"\" width=\"750\" height=\"383\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/59/73/f8/6bff5d5f1e1699b49bbcb71ad4a1b14b.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/59/73/f8/6bff5d5f1e1699b49bbcb71ad4a1b14b.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/59/73/f8/6bff5d5f1e1699b49bbcb71ad4a1b14b.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/59/73/f8/6bff5d5f1e1699b49bbcb71ad4a1b14b.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/59/73/f8/6bff5d5f1e1699b49bbcb71ad4a1b14b.png"},{"base_url":"https://salt.tikicdn.com/ts/product/43/5a/e8/18a9b1a35761cef983f9192bbe204652.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/43/5a/e8/18a9b1a35761cef983f9192bbe204652.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/43/5a/e8/18a9b1a35761cef983f9192bbe204652.jpg","position":nul