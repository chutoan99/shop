m/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":14160,"discount_rate":3,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/cc/4d/15/c5ba15e3824c11f9850ea6c8bfc61f87.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":674,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3 class=\"QN2lPu\"\u003eBộ lắp ráp xếp hình Qman 42301 – Xe tăng quân sự là sản phẩm thuộc series # Trans-Combo.\u003c/h3\u003e\n\u003ch3 class=\"QN2lPu\"\u003eGiới thiệu\u003c/h3\u003e\n\u003cp class=\"QN2lPu\"\u003eBộ sản phẩm gồm có tổng cộng 642 chi tiết được chia thành 8 hộp nhỏ với tương ứng mỗi hộp nhỏ là những chiến đấu cơ xe tăng, máy bay, thủy phi có, xe zeep, v.v. ….Mỗi hộp nhỏ có thể lắp chuyển đổi thành 2 mô hình nhỏ, như vậy bộ sản phẩm có thể lắp chuyển đổi tất cả thành 16 mô hình hoặc 1 xe tăng lớn.  Lắp ráp 8 hộp nhỏ lại với nhau để thành mô hình xe tăng quân sự to, đẹp và vô cùng chắc chắn.\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eBộ sản phẩm gồm có tổng cộng 642 chi tiết với chất liệu cao cấp, an toàn, kích thước mảnh ghép tiêu chuẩn nên sau khi chơi xong, mô hình có thể bỏ lại trong hộp, cất giữ gọn gàng hoặc tận dụng các mảnh ghép để sáng tạo nên nhiều mô hình đồ chơi mới.\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003ePhát triển kỹ năng: Đồ Chơi Lắp Ráp QMAN giúp cho trẻ học tập cách nhận diện đồ vật, học tập lắp ghép và kết hợp\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003ecác đồ vật với nhau.\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eBé sẽ thỏa sức tưởng tượng và nhập vai vào trò chơi, qua đó tăng khả năng tư duy và óc sáng tạo.\u003c/p\u003e\n\u003ch3 class=\"QN2lPu\"\u003eĐối tượng sử dụng\u003c/h3\u003e\n\u003cp class=\"QN2lPu\"\u003eSản phẩm phù hợp với các bé từ 6 tuổi trở lên.\u003c/p\u003e\n\u003ch3 class=\"QN2lPu\"\u003eChất liệu\u003c/h3\u003e\n\u003cp class=\"QN2lPu\"\u003eNhựa ABS đạt đầy đủ các chứng nhận EN71,CCC,ASTM,ISO9001,BSCI\u003c/p\u003e\n\u003ch3 class=\"QN2lPu\"\u003eThông tin sản phẩm\u003c/h3\u003e\n\u003cul\u003e\u003cli class=\"QN2lPu\"\u003eSố mảnh ghép: 642 chi tiết\u003c/li\u003e\u003cli class=\"QN2lPu\"\u003eKhối lượng: 970 gram\u003c/li\u003e\u003cli class=\"QN2lPu\"\u003eKích thước: 43.1 x 19.2 x 9.4 cm\u003c/li\u003e\u003cli class=\"QN2lPu\"\u003eThương hiệu: QMAN\u003c/li\u003e\u003c/ul\u003e\n\u003ch3 class=\"QN2lPu\"\u003eHướng dẫn sử dụng\u003c/h3\u003e\n\u003cp class=\"QN2lPu\"\u003eLắp ráp sản phẩm theo hướng dẫn đi kèm (nên lắp đến đâu thì xé bịch đến đó để chọn mảnh\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eghép nhanh hơn và tránh thất lạc mảnh ghép).\u003c/p\u003e\n\u003ch3 class=\"QN2lPu\"\u003eGiới thiệu về thương hiệu đồ chơi xếp hình Qman\u003c/h3\u003e\n\u003cp class=\"QN2lPu\"\u003eQman là tên nhận diện thương hiệu mới của hãng sản xuất đồ chơi nội địa nổi tiếng của Trung Quốc – ENLIGHTEN. Qman là nhà sản xuất đồ chơi xếp hình lớn trên thế giới, bắt đầu từ những năm 1963. Các mẫu xếp hình của Qman do Qman tự phát triển, thiết kế. Đồ chơi xếp hình Qman được bán khắp thế giới và được cộng đồng chơi xếp hình đánh giá cao. Các khối xếp hình Qman làm bằng nhựa nguyên sinh an toàn với trẻ nhỏ, không có chất độc hại, bền dưới tác dụng vật lý, bền màu theo thời gian. Đặc điểm nhận dạng là dòng chữ ENLI in dập nổi trên các nốt tròn của từng mảnh ghép.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/cc/4d/15/c5ba15e3824c11f9850ea6c8bfc61f87.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/cc/4d/15/c5ba15e3824c11f9850ea6c8bfc61f87.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/cc/4d/15/c5ba15e3824c11f9850ea6c8bfc61f87.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/cc/4d/15/c5ba15e3824c11f9850ea6c8bfc61f87.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/cc/4d/15/c5ba15e3824c11f9850ea6c8bfc61f87.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/77/0e/75/4e728107f41da215a5b82e8241fe37ba.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/77/0e/75/4e728107f41da215a5b82e8241fe37ba.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/77/0e/75/4e728107f41da215a5b82e8241fe37ba.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/77/0e/75/4e728107f41da215a5b82e8241fe37ba.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/77/0e/75/4e728107f41da215a5b82e8241fe37ba.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/0f/53/d9/b0ffbeeb9faf3fdefa1c6f069cc9f12a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0f/53/d9/b0ffbeeb9faf3fdefa1c6f069cc9f12a.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/0f/53/d9/b0ffbeeb9faf3