 luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/bd/b8/88/a708bec450c48b73912f0ec6404a3568.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/bd/b8/88/a708bec450c48b73912f0ec6404a3568.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/bd/b8/88/a708bec450c48b73912f0ec6404a3568.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/bd/b8/88/a708bec450c48b73912f0ec6404a3568.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/bd/b8/88/a708bec450c48b73912f0ec6404a3568.png"},{"base_url":"https://salt.tikicdn.com/ts/product/69/dd/fe/eff3f7b911fd7eae59b1453e2ee18f73.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/69/dd/fe/eff3f7b911fd7eae59b1453e2ee18f73.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/69/dd/fe/eff3f7b911fd7eae59b1453e2ee18f73.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/69/dd/fe/eff3f7b911fd7eae59b1453e2ee18f73.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/69/dd/fe/eff3f7b911fd7eae59b1453e2ee18f73.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/32/f6/63/d902ac4922a9ce9840bee49228ba82c5.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/32/f6/63/d902ac4922a9ce9840bee49228ba82c5.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/32/f6/63/d902ac4922a9ce9840bee49228ba82c5.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/32/f6/63/d902ac4922a9ce9840bee49228ba82c5.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/32/f6/63/d902ac492