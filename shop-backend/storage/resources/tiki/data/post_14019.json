s_hero":false,"return_reason":"any_reason"}},"discount":23000,"discount_rate":5,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/cc/ab/c1/8fb17e8fa570f0e83cd8027756e6417f.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":84,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eGiày Sandal Nữ 1cm Thời Trang JUNO Đế Bệt Quai Ngang Phối Khóa Trang Trí SD01137\u003c/p\u003e\n\u003cp\u003eMã sản phẩm: SD01137\u003c/p\u003e\n\u003cp\u003eMàu sắc: Kem-Đen-Vàng đồng\u003c/p\u003e\n\u003cp\u003eKiểu dáng: Giày xăng đan\u003c/p\u003e\n\u003cp\u003eChất liệu: Da tổng hợp\u003c/p\u003e\n\u003cp\u003eKích cỡ: 35-36-37-38-39\u003c/p\u003e\n\u003cp\u003eXuất xứ: Việt Nam\u003c/p\u003e\n\u003cp\u003eĐộ cao: 1cm\u003c/p\u003e\n\u003cp\u003eGiá đã bao gồm VAT\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eGiày Sandal Đế Bệt Quai Ngang Phối Khóa Trang Trí đơn giản, tiện dụng\u003c/p\u003e\n\u003cp\u003eGiày bệt tạo cảm giác vững chân, thoải mái khi di chuyển\u003c/p\u003e\n\u003cp\u003ePhần logo kim loại trên quai giày tạo điểm nhấn\u003c/p\u003e\n\u003cp\u003eThiết kế quai xé dán tiện dụng\u003c/p\u003e\n\u003cp\u003eChất liệu da tổng hợp bền đẹp, dễ sử dụng, dễ bảo quản\u003c/p\u003e\n\u003cp\u003eCó 3 màu sắc cơ bản đen, kem, vàng đồng phù hợp với đa dạng phong cách của các nàng\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/sg-11134202-7rd72-lwo8hb67i0lq48\" width=\"900\" height=\"1139\" alt=\"sg-11134202-7rd72-lwo8hb67i0lq48\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/sg-11134202-7rd6y-lwo8hbh126cu37\" width=\"900\" height=\"1139\" alt=\"sg-11134202-7rd6y-lwo8hbh126cu37\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/sg-11134202-7rd4c-lwo8hbqgodrve1\" width=\"900\" height=\"1139\" alt=\"sg-11134202-7rd4c-lwo8hbqgodrve1\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/sg-11134202-7rd57-lwo8hc4m3nodf8\" width=\"900\" height=\"1139\" alt=\"sg-11134202-7rd57-lwo8hc4m3nodf8\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/sg-11134202-7rd3m-lwo8hcd7r2mx23\" width=\"900\" height=\"1139\" alt=\"sg-11134202-7rd3m-lwo8hcd7r2mx23\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/sg-11134202-7rd6z-lwo8hcltehba2f\" width=\"900\" height=\"1139\" alt=\"sg-11134202-7rd6z-lwo8hcltehba2f\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/sg-11134202-7rd4m-lwo8hcvszva76a\" width=\"900\" height=\"1139\" alt=\"sg-11134202-7rd4m-lwo8hcvszva76a\" /\u003e\u003c/p\u003e\n\u003cp\u003eHướng dẫn chọn size giày\u003c/p\u003e\n\u003cp\u003eĐể biết cỡ chân của bạn phù hợp với Size giày bao nhiêu của Juno, bạn hãy thực hiện cách đo như sau:\u003c/p\u003e\n\u003cp\u003eBước 1: Đặt bàn chân lên tờ giấy trắng, rồi dùng bút vẽ bo hết bàn chân (để chính xác thì bạn phải đặt bút thẳng đứng và vuông góc với tờ giấy)\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134202-7qukw-lj6ta1453ua4ec\" width=\"1018\" height=\"372\" alt=\"vn-11134202-7qukw-lj6ta1453ua4ec\" /\u003e\u003c/p\u003e\n\u003cp\u003eBước 2:Dùng thước hay sợi dây đo một vòng khớp ngón phần rộng nhất của bàn chân ở tư thế ngồi hoặc đứng thẳng 2 chân.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134202-7qukw-lj6ta16310iafd\" width=\"1024\" height=\"401\" alt=\"vn-11134202-7qukw-lj6ta16310iafd\" /\u003e\u003c/p\u003e\n\u003cp\u003eSo sánh bảng dưới đây để biết size giày của bạn nhé!\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134202-7qukw-lj6ta180y5n090\" width=\"1024\" height=\"329\" alt=\"vn-11134202-7qukw-lj6ta180y5n090\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eHƯỚNG DẪN BẢO QUẢN GIÀY:\u003c/p\u003e\n\u003cp\u003eLàm mềm giày da\u003c/p\u003e\n\u003cp\u003eGiày da để quá lâu không được sử dụng, đôi khi sẽ bị co cứng lại, dễ gây cảm giác đau chân khi dùng. Để làm mềm giày, bạn có thể thoa một lớp vaseline lên giày trong một vài tiếng để giày sẽ mềm trở lại. Đối với các loại giày da lộn, bạn có thể dùng vải mềm ẩm lau qua toàn bộ giày, để qua đêm, da giày sẽ mềm hơn hẳn.\u003c/p\u003e\n\u003cp\u003eĐể da giày được bền lâu, bạn nhớ hạn chế làm ướt giày. Khi giày bị ướt, không nên hơ bằng lửa, phơi nắng hoặc dùng máy sấy nóng, sẽ làm giày bị cứng, co lại hoặc hỏng bể mặt da. Hãy dùng giấy khô vò lại đặt vào trong giày để hút ẩm, phơi giày ở nơi râm mát. Sau khi khô, với giày da thì nên thoa vaseline, đánh si để da mềm và bóng đẹp trở lại.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eBảo quản giày khi không sử dụng\u003c/p\u003e\n\u003cp\u003eKhi không sử dụng giày, hãy nhét một ít giấy vụn vào bên trong giày để giữ cho dáng giày luôn chuẩn, đẹp rồi đặt giày vào hộp giày kèm thẻ màu xanh hút ẩm luôn được tặng kèm khi bạn mua giày.\u003c/p\u003e\n\u003cp\u003eKhi cần mang ra sử dụng, hãy áp dụng những cách làm mềm giày da bên trên, như vậy đôi giày của bạn sẽ luôn bền đẹp như mới.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eChính sách đổi trả, bảo hành áp dụng trên toàn hệ thống JUNO\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eThời gian đổi/trả:\u003c/p\u003e\n\u003cp\u003e07 ngày (theo quy định Tiki) đối với hàng khuyến mãi.\u003c/p\u003e\n\u003cp\u003e30 ngày đối với hàng nguyên giá.\u003c/p\u003e\n\u003cp\u003e*Thời gian đổi/ trả được tính kể từ ngày nhận hàng\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eĐiều kiện đổi trả:\u003c/p\u003e\n\u003cp\u003e- Đổi trả khi có lỗi sản xuất hoặc hàng chưa sử dụng và sửa chữa (còn tem, nhãn).\u003c/p\u003e\n\u003cp\u003e- Sản phẩm chưa qua sử dụng, còn nguyên vẹn\u003c/p\u003e\n\u003cp\u003e- Sản phẩm không bị hư hỏng, bể vỡ\u003c/p\u003e\n\u003cp\u003e- Tem, mạc niêm phong còn nguyên vẹn, không bị rách và trầy xước\u003c/p\u003e\n\u003cp\u003e- Sản phẩm còn đầy đủ phụ kiện / quà tặng đi kèm (nếu có)\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eBảo hành: Bảo hành giày túi trong 6 tháng kể từ ngày mua hàng (căn cứ thông tin mua hàng/ hóa đơn)\u003c/p\u003e\n\u003cp\u003eKhông bảo hành phụ kiện và dép tông\u003c/p\u003e\n\u003cp\u003e*Lưu ý: Nếu cần hỗ trợ thêm thông tin Quý Khách Hàng vui lòng inbox chat box JUNO.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e#giaysandal #sandal #xangdan #giayxangdan #JUNO #juno #giaysandalnu #giay #giaysandaldep #SD01137\u003c/p\u003e\n\u003cp\u003e#juno #JUNO #Duno #zuno #despnu #giafynu #de2p #gia3ynu #tusinu #tu2inu\u003c/p\u003e\n\u003cp\u003e#giayjuno ##tuijuno #balojuno #vijuno # matkinhjuno #sneakerjuno #sandaljuno #thoitrangnu #thoitrangjuno #giaythethaojuno\u003c/p\u003e\n\u003cp\u003e#cao_got_juno #giay_juno #tui_juno #balo_juno #vi_juno #may_kinh_juno #sneaker_juno #sandal_juno #giaythethao_juno\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/cc/ab/c1/8fb17e8fa570f0e83cd8027756e6417f.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/cc/ab/c1/8fb17e8fa570f0e83cd8027756e6417f.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/cc/ab/c1/8fb17e8fa570f0e83cd8027756e6417f.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/cc/ab/c1/8fb17e8fa570f0e83cd8027756e6417f.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/cc/ab/c1/8fb17e