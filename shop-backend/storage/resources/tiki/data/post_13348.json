huốc khác hoặc đang điều trị tại bệnh viện hoặc đang mang thai. Để xa tầm tay trẻ em. Sử dụng ngay sau khi mở bao bì. Đóng túi ngay sau khi sử dụng. Màu sắc của sản phẩm có thể có thay đổi do biến đổi nhiệt độ, nhưng không ảnh hưởng tới thành phần và chất lượng.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e6. Hạn dùng:\u003c/strong\u003e 30 tháng kể từ ngày sản xuất. Sử dụng tốt nhất trước thời gian ghi trên bao bì. \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e7. Bảo quản:\u003c/strong\u003e Nơi khô ráo, thoáng mát, tránh ánh sáng mặt trời.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/63/25/ca/510966de0eb8acfed54e297efe1956d5.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/63/25/ca/510966de0eb8acfed54e297efe1956d5.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/63/25/ca/510966de0eb8acfed54e297efe1956d5.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/63/25/ca/510966de0eb8acfed54e297efe1956d5.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/63/25/ca/510966de0eb8acfed54e297efe1956d5.png"}],"warranty_policy":null,"brand":{"id":200189,"name":"DHC","slug":"dhc"},"current_seller":{"id":108980,"sku":"8170867965360","name":"365 Cosmetics","link":"https://tiki.vn/cua-hang/365-cosmetics","logo":"4f/83/78/9a997fe24458dda5250c90b2e59f3669.png","price":174000,"product_id":"50323606","store_id":100874,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[{"id":6639,"name":"DHC Official Store","link":"https://tiki.vn/cua-hang/dhc","logo":"53/58/28/677f7a9a9fe67cc6ad0728ec43985d38.png",