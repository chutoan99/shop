ref":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":7,"review_text":"(7)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/90/bc/cf/876eb739d7851123df8150f1dc79347d.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":685,"all_time_quantity_sold":64,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eTHUỐC XỊT TRỊ NẤM TỐT DÀNH CHO CHÓ MÈO \u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThành phần:\u003c/strong\u003e thuộc tính chất lỏng trong suốt màu vàng với mùi đặc biệt. Cùng các hoạt chất\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eGriseofulvin\u003c/li\u003e\n\u003cli\u003eNystatin\u003c/li\u003e\n\u003cli\u003eMiconazole Nitrate\u003c/li\u003e\n\u003cli\u003eaxit salicylic\u003c/li\u003e\n\u003cli\u003ecác thành phần hoạt chất tăng cường.\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e Đối tượng áp dụng:\u003c/strong\u003e Dành cho chó mèo từ 8 tuần tuổi trở lên.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eChỉ định:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eChữa nấm cho chó, chữa nấm cho mèo, chuyên trị nhiễm nấm, nấm ngoài da, ngứa trầm trọng, các bệnh ngoài da và nhiều triệu chứng khác.\u003c/li\u003e\n\u003cli\u003eCó khả năng chữa lành nhiều loại bệnh nhiễm trùng nấm và nhiễm nấm trộn mạt.\u003c/li\u003e\n\u003cli\u003eĐi.ề trị hiệu quả bệnh nấm da như hắc lào, nấm móng, nhiễm trùng nấm men…\u003c/li\u003e\n\u003cli\u003eLoại bỏ vảy, loại bỏ gàu, ngứa dữ dội và các triệu chứng khác trên chó mèo…\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e Hướng dẫn sử dụng: \u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eKhoanh vùng khu vực bị ảnh hưởng và các khu vực xung quanh càng sạch càng tốt trước khi sử dụng. Nếu có thể hãy cạo lông khu vực thú cưng bị nấm bệnh.\u003c/li\u003e\n\u003cli\u003ePhun thuốc đều khắp các khu vực bị nấm bệnh.\u003c/li\u003e\n\u003cli\u003eĐối với việc đi.ề trị của mắt và các bộ phận nhạy cảm khác, có thể bảo vệ đôi mắt của con đường, hoặc mất tăm bông y tế làm nản với chất lỏng áp dụng cho các khu vực bị ảnh hưởng.\u003c/li\u003e\n\u003cli\u003eKhông tắm sau 24h kể từ khi sử dụng thuốc.\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eXuất xứ:\u003c/strong\u003e Anh\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e\u003cp\u003eSản phẩm này là tài sản cá nhân được bán bởi Nhà Bán Hàng Cá Nhân và không thuộc đối tượng phải chịu thuế GTGT. Do đó hoá đơn VAT không được cung cấp trong trường hợp này.\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/90/bc/cf/876eb739d7851123df8150f1dc79347d.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/90/bc/cf/876eb739d7851123df8150f1dc79347d.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/90/bc/cf/876eb739d7851123df8150f1dc79347d.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/90/bc/cf/876eb739d7851123df8150f1d