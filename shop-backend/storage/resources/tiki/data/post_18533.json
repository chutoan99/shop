ype":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":427500,"discount_rate":45,"rating_average":5,"review_count":69,"review_text":"(69)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/9f/1f/40/427f875e5c379f14606ea65ee7d107ac.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1301,"all_time_quantity_sold":242,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eBình giữ nhiệt Thermos sản xuất tại Malaysia, đạt tiêu chuẩn chất lượng gắt gao của Nhật Bản, được tin dùng tại hơn 120 quốc gia trên thế giới. Bình giữ nhiệt Thermos:\u003cbr /\u003e- Đa dạng mẫu mã, phù hợp nhiều phong cách\u003cbr /\u003e- Chất liệu thép không gỉ (inox 304) an toàn khi đựng thực phẩm\u003cbr /\u003e- Trọng lượng bình siêu nhẹ thuận tiện cất vào túi xách, balo\u003cbr /\u003e- Mở bình dễ dàng chỉ bằng một nút bấm\u003cbr /\u003e- Thiết kế bình tránh rò rỉ khi mang đi\u003cbr /\u003e- Khả năng giữ nhiệt ưu việt lên đến 24 giờ\u003c/p\u003e\n\u003cp\u003e• Bình giữ nhiệt cao cấp Thermos có nhiều màu sắc (đỏ, xanh, đen…), kích thước (350ml, 500ml, 750ml) phù hợp với nhiều phong cách đi học, đi làm, tập thể thao, mục đích sử dụng khác nhau.\u003cbr /\u003eỨng dụng công nghệ tiên tiến:\u003cbr /\u003e• Trọng lượng bình giữ nhiệt siêu nhẹ, thuận tiện cất vào túi xách mang đi.\u003cbr /\u003e• Chất liệu thân bình bằng thép không gỉ (inox 304) độ bền cao, chịu nhiệt tốt. Nắp bình bằng nhựa PP, không chứa BPA, đảm bảo an toàn khi đựng thực phẩm dùng hằng ngày.\u003cbr /\u003e• Mở bình nhanh chóng bằng một tay chỉ với một nút bấm.\u003cbr /\u003e• Các phần nắp bình có thể tháo rời, thao tác vệ sinh dễ dàng.\u003cbr /\u003e• Bình có khóa an toàn, tránh nước bị đổ hoặc rò rỉ khi mang đi.\u003cbr /\u003e• Khả năng giữ nhiệt ưu việt lên đến 24 giờ:\u003cbr /\u003e- Ứng dụng công nghệ giữ nhiệt chân không tiên tiến từ Nhật Bản. Bình giữ nhiệt Thermos gồm thành bình 2 lớp, lớp chân không cách nhiệt ở giữa đảm bảo thời gian giữ nhiệt tốt, ngăn chặn hiện tượng ngưng tụ nước trên mặt bình giúp không gian xung quanh bình luôn được khô ráo.\u003cbr /\u003e- Giữ nóng trong 6 giờ: nhiệt độ từ khoảng 68℃ trở lên\u003cbr /\u003e- Giữ lạnh trong 6 giờ: nhiệt độ từ khoảng 10℃ trở xuống\u003cbr /\u003e• Miệng bình rộng dễ cho đá viên vào trong hoặc vệ sinh.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ba/8d/19/9135a8e2e452ed2b1c6794f3080e8e9d.png\" alt=\"\" width=\"750\" height=\"362\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/33/4f/c2/0a307ccb8731a2cffa3ed7e4ba188eeb.jpg\" alt=\"\" width=\"750\" height=\"1265\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/04/25/79/50d6799ee485632ff9ffaea8a38f5e16.png\" alt=\"\" width=\"750\" height=\"741\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/b9/1c/00/5d7651b01e757926dc178984add9cd6f.png\" alt=\"\" width=\"605\" height=\"768\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/b9/1c/00/b024dd59c223353b0e1732ecfdbc9fa8.png\" alt=\"\" width=\"0\" height=\"0\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://s