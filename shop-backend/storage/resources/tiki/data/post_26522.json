dth":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":17100,"discount_rate":10,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/f7/2b/37/0efc108619db8eca16ed5de6758a357f.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":524,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003eGiới thiệu:\u003c/h3\u003e\n\u003cp\u003eNước muối sinh lý pháp tép vàng Fysoline Septinasal Gifrer là dòng nước muối sinh lý kháng khuẩn được bổ sung chiết xuất cỏ xạ hương, ion đồng và glycerol giúp hỗ trợ phòng ngừa và điều trị sổ mũi, nghẹt mũi hiệu quả, đồng thời duy trì độ ẩm cần thiết cho niêm mạc, hạn chế khô rát mũi do dịch tiết hay nghẹt mũi nhiều. Sản phẩm làm thông thoáng, hỗ trợ giảm tắc nghẽn mũi giúp trẻ dễ thở hơn nhờ cơ chế rửa trôi dịch tiết và chất nhầy, hỗ trợ giảm cảm giác khó chịu bởi các triệu chứng trong trường hợp cảm lạnh, viêm mũi, cảm cúm.\u003c/p\u003e\n\u003ch3\u003eĐặc điểm nổi bật:\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eNước muối sinh lý Pháp tép vàng Fysoline Septinasal Gifrer được sản xuất theo tiêu chuẩn vô trùng, thuộc thương hiệu Fysoline Pháp hơn 100 năm kinh nghiệm.\u003c/li\u003e\n\u003cli\u003eSản phẩm chất lượng cao, đạt đầy đủ các tiêu chuẩn CE, Sterile A của châu Âu.\u003c/li\u003e\n\u003cli\u003eThành phần hoàn toàn từ thảo dược tự nhiên và nước muối, không chứa chất bảo quản, không Xylometazolin gây co mạch.\u003c/li\u003e\n\u003cli\u003eSản phẩm duy nhất trên thị trường không phải là kháng sinh có tác dụng hỗ trợ điều trị viêm mũi, sổ mũi, đặc biệt khuyên dùng cho trẻ từ 0 ngày tuổi, phù hợp cho mọi đối tượng.\u003c/li\u003e\n\u003cli\u003eThiết kế dưới dạng ống đơn liều, sử dụng một lần nên không nguy cơ lây nhiễm chéo.\u003c/li\u003e\n\u003cli\u003eĐầu tròn và nhỏ, trơn nhẵn thích hợp với cấu trúc của khoang mũi, tránh gây tổn thương niêm mạc.\u003c/li\u003e\n\u003cli\u003eSản phẩm Fysoline vàng giúp vệ sinh an toàn và dịu nhẹ cho trẻ nhỏ và trẻ sơ sinh.\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003eHướng dẫn sử dụng:\u003c/h3\u003e\n\u003cp\u003eLiều dùng:\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e- Liều thông thường: 1 ống 5ml cho mỗi lần rửa, 2-3 lần/ngày\u003c/li\u003e\n\u003cli\u003e- Trong trường hợp mũi bị đặc: nhỏ tối đa 5ml (1 ống) cho mỗi bên mũi cho mỗi lần. 2-3 lần/ngày.\u003c/li\u003e\n\u003cli\u003e- Fysoline kháng khuẩn không nên sử dụng hàng ngày\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eĐộ tuổi: sơ sinh trở lên\u003c/p\u003e\n\u003cp\u003eThông tin sản phẩm:\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eHộp: 20 tuýp\u003c/li\u003e\n\u003cli\u003eXuất xứ: Pháp\u003c/li\u003e\n\u003cli\u003eThương hiệu: Fysoline\u003c/li\u003e\n\u003cli\u003eHạn sử dụng: 24 tháng kẻ từ ngày sản xuất\u003c/li\u003e\n\u003c/ul\u003e\n\u003cdiv class=\"inner\"\u003e\n\u003cdiv class=\"preservation\"\u003e\n\u003ch3 class=\"css-8uyn92\"\u003eBảo quản\u003c/h3\u003e\n\u003cdiv\u003e\n\u003cul\u003e\n\u003cli\u003eBảo quản nơi khô ráo, thoáng mát, tránh ánh sáng trực tiếp từ mặt trời.\u003c/li\u003e\n\u003cli\u003eTránh xa tầm tay trẻ em.\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"lc-wrap-link lc-overlay-detail float-bottom mt-auto flex w-full cursor-pointer items-end justify-center\"\u003e \u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/f7/2b/37/0efc108619db8eca16ed5de6758a357f.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f7/2b/37/0efc108619db8eca16ed5de6758a357f.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f7/2b/37/0efc108619db8eca16ed5de6758a357f.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f7/2b/37/0efc108619db8eca16ed5de6758a357f.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f7/2b/37/0efc108619db8eca16ed5de6758a357f.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/2c/08/ea/095a966ae908ecb4ec6b1b6c6585b6c4.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/2c/08/ea/095a966ae908ecb4ec6b1b6c6585b6c4.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/2c/08/ea/095a966ae908ecb4ec6b1b6c6585b6c4.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2c/08/ea/095a966ae908ecb4ec6b1b6c6585b6c4.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2c/08/ea/095a966ae908ecb4ec6b1b6c6585b6c4.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/9a/11/19/4b53def7b440513afa0451039fc37b3e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/9a/11/19/4b53def7b440513afa0451039fc37b3e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/9a/11/19/4b53def7b440513afa0451039fc37b3e.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9a/11/19/4b53def7b440513afa0451039fc37b3e.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9a/11/19/4b53def7b440513afa0451039fc37b3e.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/9a/0b/70/134edb708a3409c5d2d1b833e85d18ba.jpg","i