/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":328599,"discount_rate":50,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/14/9d/55/ddd36f01ff54a81022e31ead7f71a4d0.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1100,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eBột rửa bát Finish hương chanh 2,5kg HÀNG MỚI/ SỬ DỤNG CHO MÁY RỬA BÁT / SẢN XUẤT EU\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/78/77/9b/86dffa1ec8a2c8f3d9442e33e3538313.png\" alt=\"\" width=\"500\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp\u003eThương hiệu: Finish\u003c/p\u003e\n\u003cp\u003eTrọng lượng: 2.5kg/can\u003c/p\u003e\n\u003cp\u003eXuất xứ thương hiệu: CHLB Đức\u003c/p\u003e\n\u003cp\u003eNơi sản xuất: Ba Lan\u003c/p\u003e\n\u003cp\u003eLưu ý:\u003cbr /\u003e- Mẫu mã bao bì có thể thay đổi theo từng lô hàng nhập về nhưng chất lượng không đổi.\u003cbr /\u003e- Để nơi khô ráo, thoáng mát.\u003cbr /\u003e- Tránh ánh sáng trực tiếp.\u003c/p\u003e\n\u003cp\u003eGiao nguyên can 2,5 kg Hoặc 2 can 1,2 kg + 100 g bột bóc lẻ \u003c/p\u003e\n\u003cp\u003eCAM KẾT HÀNG CHÍNH HÃNG, PHÁT HIỆN HÀNG NHÁI ĐỀN GẤP 10 LẦN\u003c/p\u003e\n\u003cp\u003eCÔNG DỤNG\u003c/p\u003e\n\u003cp\u003eBột Finish hương chanh được đóng gói dạng can nhựa dễ dàng hơn trong việc bảo quản và vận chuyển.\u003c/p\u003e\n\u003cp\u003eSử dụng bột Finish giúp khách hàng linh động hơn và tiết kiệm hơn so với viên rửa bởi có thể căn chỉnh liều lượng bột rửa theo số lượng chén bát thực tế mỗi lần rửa.\u003c/p\u003e\n\u003cp\u003eBột rửa bát Finish Classic có hoạt tính tẩy rửa rất mạnh. Do đó khả năng loại các vết bẩn bằng Finish Classic là rất tốt\u003c/p\u003e\n\u003cp\u003eTrong thành phần bột rửa bát Finish Classic có chứa các hoạt chất có khả năng ngấm sâu vào các vết bẩn khô cứng. Các hoạt chất sau khi ngấm và hòa tan cùng nước. Chất này sẽ làm phá vỡ các liên kết của vết bẩn với chén đĩa. Các vết bẩn khô cứng khó chịu sẽ được tẩy đi một cách dễ dàng\u003c/p\u003e\n\u003cp\u003eCÁCH SỬ DỤNG\u003c/p\u003e\n\u003cp\u003eThông thường sử dụng từ 15-25g mỗi lần rửa cho máy 12-14 bộ, 5-10g cho máy Nhật 6 bộ, và khoảng 10-15g cho máy 8 bộ.\u003c/p\u003e\n\u003cp\u003eKết hợp thêm với muối chuyên dụng và nước bóng để giúp đạt hiệu quả làm sạch tốt nhất\u003c/p\u003e\n\u003cp\u003e.HÀNG MỚI/ SỬ DỤNG CHO MÁY RỬA BÁT / SẢN XUẤT EU\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e\u003cp\u003eSản phẩm này là tài sản cá nhân được bán bởi Nhà Bán Hàng Cá Nhân và không thuộc đối tượng phải chịu thuế GTGT. Do đó hoá đơn VAT không được cung cấp trong trường hợp này.\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/14/9d/55/ddd36f01ff54a81022e31ead7f71a4d0.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/14/9d/55/ddd36f01ff54a81022e31ead7f71a4d0.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/14/9d/55/ddd36f01ff54a81022e31ead7f71a4d0.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/14/9d/55/ddd36f01ff54a81022e31ead7f71a4d0.png","thumbnail_url":"