s_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":14100,"discount_rate":47,"rating_average":4.7,"review_count":3,"review_text":"(3)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ed/5c/06/ff4ff28f52a923fbe1415c2f872bc7f8.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":140,"all_time_quantity_sold":226,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e GIÁ SỈ SIÊU LỢI:\u003c/p\u003e\n\u003cp\u003eGiá chỉ còn 9k  Số lượng: 200 viên\u003c/p\u003e\n\u003cp\u003eGiá chỉ còn 11k  Số lượng: 100 viên\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lnjja3gw9ray2a\" width=\"720\" height=\"720\" alt=\"vn-11134208-7r98o-lnjja3gw9ray2a\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eĐất nén hữu cơ, mụn sơ dừa bánh lớn đã qua xử lý, nở gấp 5 lần, trồng rau, trộn giá thể trồng cây |Greenhome\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e ĐẶC ĐIỂM NỔI BẬT:\u003c/p\u003e\n\u003cp\u003e-Viên nén mụn dừa bánh lớn là sự thay thế hoàn hảo cho đất sạch, diệt trùng và diệt khuẩn, kháng bệnh cho cây, giúp rễ phát triển tạo tiền đề cho việc ươm hoa kết trái. \u003c/p\u003e\n\u003cp\u003e-Nhỏ gọn, dễ vận chuyển và di chuyển dễ dàng\u003c/p\u003e\n\u003cp\u003e-Có sẵn chất dinh dưỡng – Vi sinh núi lửa dạng thiên địch tốt cho cây trồng\u003c/p\u003e\n\u003cp\u003e-Sạch sẽ, tiệt trùng, diệt khuẩn\u003c/p\u003e\n\u003cp\u003e-Tơi xốp, giàu chất dinh dưỡng\u003c/p\u003e\n\u003cp\u003e-Thay thế hoàn toàn cho đất sạch\u003c/p\u003e\n\u003cp\u003e-Là giá thể trồng cây cao cấp\u003c/p\u003e\n\u003cp\u003e-Tiện lợi, chất lượng ngang bằng nhưng lại có giá rẻ hơn so với nhiều loại đất trồng khác.\u003c/p\u003e\n\u003cp\u003e-Có thể tái sử dụng\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lnjja3gwb5ve69\" width=\"720\" height=\"720\" alt=\"vn-11134208-7r98o-lnjja3gwb5ve69\" /\u003e\u003c/p\u003e\n\u003cp\u003eĐất nén hữu cơ bánh lớn là sự thay thế hoàn hảo cho đất sạch, diệt trùng và diệt khuẩn, kháng bệnh cho cây, giúp rễ phát triển tạo tiền đề cho việc ươm hoa kết trái. \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lnjja3gwckfu0d\" width=\"720\" height=\"720\" alt=\"vn-11134208-7r98o-lnjja3gwckfu0d\" /\u003e\u003c/p\u003e\n\u003cp\u003eĐất nén hữu cơ nhỏ gọn, dễ vận chuyển và di chuyển dễ dàng.Có sẵn chất dinh dưỡng, vi sinh núi lửa dạng thiên địch tốt cho cây trồng\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lnjja3gwdz0ad6\" width=\"720\" height=\"720\" alt=\"vn-11134208-7r98o-lnjja3gwdz0ad6\" /\u003e\u003c/p\u003e\n\u003cp\u003eĐất nén hữu cơ sạch sẽ, tiệt trùng, diệt khuẩn, tơi xốp, giàu chất dinh dưỡng\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e MÔ TẢ SẢN PHẨM: \u003c/p\u003e\n\u003cp\u003e-Viên nén mụn dừa bánh 450Gr. \u003c/p\u003e\n\u003cp\u003e-Quy cách: Đường kính 13 cm – Dày 5 cm ĐÃ QUA XỬ LÝ CHẤT CHÁT (LIGNIN VÀ TANIN) \u003c/p\u003e\n\u003cp\u003e-Thành phần có trong 450Gr xơ dừa loại nén tròn này có:  80% là MỤN DỪA được nghiền nhuyễn (EC giao động trong khoảng 0.22 Ms/cm – pH = 5.5 – 6.5) – 20% còn lại là Men Vi Sinh cao cấp + Chất Dinh Dưỡng Hữu Cơ\u003c/p\u003e\n\u003cp\u003e-1 viên ngâm vào nước sẽ nở gấp 5 lần. Cho bạn 5 dm3 (Khoảng 3-4 kg) giá thể mụn dừa sạch trồng cây.\u003c/p\u003e\n\u003cp\u003e-Đặc tính bên trong có sẵn chất dinh dưỡng và Vi Sinh cao cấp. Hơn nữa, tự bản thân nó có thể cung cấp chất dinh dưỡng cho cây từ 35 – 50 ngày mà không cần thêm phân bón.\u003c/p\u003e\n\u003cp\u003e-Dùng viên nén giá thể mụn dừa, bạn không cần bón thêm phân bón mà cây vẫn đủ dinh dưỡng để phát triển. Tuy nhiên, để đảm bảo cây phát triển tốt nhất bạn có thể bón thêm phân bón hoặc trộn viên mụn dừa mới vào sau 40 – 50 ngày.\u003c/p\u003e\n\u003cp\u003e-Nếu trồng rau mầm, 7 ngày bạn đã thu hoạch. Và cũng có thể tái dùng trồng rau mầm đến lần thứ 2. Chỉ cần sau khi thu hoạch bạn chịu khó nhổ các gốc của rau mầm cũ, xới lại và gieo hạt giống rau mầm lứa tiếp theo.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lnjja3gwfdkq3e\" width=\"720\" height=\"720\" alt=\"vn-11134208-7r98o-lnjja3gwfdkq3e\" /\u003e\u003c/p\u003e\n\u003cp\u003eĐất nén hữu cơ thay thế hoàn toàn cho đất sạch, là giá thể trồng cây cao cấp\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lnjja3gwgs5620\" width=\"720\" height=\"720\" alt=\"vn-11134208-7r98o-lnjja3gwgs5620\" /\u003e\u003c/p\u003e\n\u003cp\u003eĐất nén hữu cơ tiện lợi, chất lượng ngang bằng nhưng lại có giá rẻ hơn so với nhiều loại đất trồng khác. Có thể tái sử dụng\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lnjja3gwi6pmef\" width=\"720\" height=\"720\" alt=\"vn-11134208-7r98o-lnjja3gwi6pmef\" /\u003e\u003c/p\u003e\n\u003cp\u003eĐất nén hữu cơ 1 viên ngâm vào nước sẽ nở gấp 5 lần. Cho bạn 5 dm3 (Khoảng 3-4 kg) giá thể mụn dừa sạch trồng cây.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e Hướng dẫn sử dụng:\u003c/p\u003e\n\u003cp\u003eBước 1: Chuẩn bị số lượng viên nén mụn dừa cần dùng\u003c/p\u003e\n\u003cp\u003eBước 2: Ngâm 3 lít nước/viên trong 10 – 20 phút\u003c/p\u003e\n\u003cp\u003eBước 3: Bạn có 5 dm3/viên (khoảng 3-4 kg mụn dừa sạch)\u003c/p\u003e\n\u003cp\u003eBước 4: Tiến hành trồng rau sạch, rau mầm, bón vào cải tạo đất,..trồng lan, cây kiểng..\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lnjja3gwjla2fe\" width=\"720\" height=\"720\" alt=\"vn-11134208-7r98o-lnjja3gwjla2fe\" /\u003e\u003c/p\u003e\n\u003cp\u003eĐất nén hữu cơ với đặc tính bên trong có sẵn chất dinh dưỡng và Vi Sinh cao cấp. Hơn nữa, tự bản thân nó có thể cung cấp chất dinh dưỡng cho cây từ 35 – 50 ngày mà không cần thêm phân bón.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lnjja3gwkzui56\" width=\"720\" height=\"720\" alt=\"vn-11134208-7r98o-lnjja3gwkzui56\" /\u003e\u003c/p\u003e\n\u003cp\u003eĐất nén hữu cơ với thành phần chính là giá thể mụn dừa, bạn không cần bón thêm phân bón mà cây vẫn đủ dinh dưỡng để phát triển\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eBẢO HÀNH: đổi mới hoàn toàn bất kể lỗi do vận chuyển, sản xuất.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e CAM KẾT \u003c/p\u003e\n\u003cp\u003e- Sản phẩm y như hình ảnh\u003c/p\u003e\n\u003cp\u003e- Dịch vụ nhanh, chất lượng sản phẩm luôn được quan tâm.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eSIÊU THỊ LÀM VƯỜN GREENHOME\u003c/p\u003e\n\u003cp\u003e Đầy Đủ Vật Tư - Giao Nhanh Hoả Tốc\u003c/p\u003e\n\u003cp\u003e---------------------\u003c/p\u003e\n\u003cp\u003e#đất_nén\u003c/p\u003e\n\u003cp\u003e#đất_nén_hữu_cơ\u003c/p\u003e\n\u003cp\u003e#đất_nén_trồng_cây\u003c/p\u003e\n\u003cp\u003e#đất_nén_xơ_dừa\u003c/p\u003e\n\u003cp\u003e#đất_nén_hữu_cơ_trồng_rau\u003c/p\u003e\n\u003cp\u003e#đấ