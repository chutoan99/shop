hơi vừa bay qua đó\u003c/em\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cem\u003eCái mỉm cười nhạo báng của thời gian\"\u003c/em\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/media/catalog/product/i/m/img016_21.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/i/m/img016_21.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/i/m/img016_21.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/i/m/img016_21.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/i/m/img016_21.jpg"}],"warranty_policy":null,"authors":[{"id":13766,"name":"Nguyễn Quang Thiều","slug":"nguyen-quang-thieu"}],"current_seller":{"id":112977,"sku":"9852257471333","name":"Liên Việt Official Store","link":"https://tiki.vn/cua-hang/lienvietbooks","logo":"88/56/24/80e4a0e582e2e1fdd9bd692414e2dc3f.jpg","price":30000,"product_id":"87494182","store_id":104518,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Thông tin chung","attributes":[{"code":"publisher_vn","name":"Công ty phát hành","value":"Liên Việt"},{"code":"publication_date","name":"Ngày xuất bản","value":"2015-11-12 00:00:00"},{"code":"dimensions","name":"Kích thước","value":"15.5 x 24 cm"},{"code":"book_cover","name":"Loại bìa","value":"Bìa mềm"},{"code":"number_of_page","name":"Số trang","value":"87"},{"code":"manufacturer","name":"Nhà xuất bản","value":"Nhà Xuất Bản Hội Nhà Văn"}]}],"product_links":[],"gift_item_title":"0 quà tặng kèm","services_and_promotions":[],"p