04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.5,"review_count":39,"review_text":"(39)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/93/8d/18/3be0f502b0546345944b8f99ffc2f5dd.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1646,"all_time_quantity_sold":193,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eThông tin Phân bón hữu cơ đậu tương, đậu nành trứng chuối humic DOCNEEM:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eThương hiệu DOCNEEM đã được đăng ký bảo hộ tại cục sở hữu trí tuệ Việt Nam.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eNguồn gốc tự nhiên, sản phẩm hữu cơ, kết hợp đậu nành, trứng, chuối.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eBổ sung Axit humic giúp cây trồng dễ hấp thụ được các chất dinh dưỡng hơn.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eKết cấu hình dạng: Đậu nành lên men humic, dạng lỏng.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eChai 1 lít (chai nhựa cao cấp).\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/c7/3f/f1/5110ec1e30c9c85ae0ed7f1627082732.jpg\" alt=\"đậu nành humic\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003eĐẩy chồi, mầm trên hoa hồng\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCông dụng Phân bón đậu tương, đậu nành trứng chuối humic DOCNEEM:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003ePhân bón hoa hồng giúp kích rễ, sai hoa, chồi tua tủa.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eChế phẩm chuyên biệt dành cho hoa hồng, cây cảnh (kết hợp từ đậu nành lên men humic, trứng, và chuối)\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eKích ra rễ khỏe, mầm mập và đẩy chồi cực mạnh.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eGiúp cây phát triển khỏe mạnh, cứng cáp: Hoa sai, to, đậm màu và lâu tàn, nẩy nhiều mầm nụ, mầm lộc.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eCung cấp dưỡng chất dinh dưỡng cân đối và đầy đủ cho cây trồng (đa lượng, trung lượng, vi lượng, vitamin, khoáng chất, acid amin…).\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eKích ra rễ khỏe, mầm mập và ra chồi cực mạnh.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eGiúp cây trồng phát triển khỏe mạnh, cứng cáp: Hoa sai, to, đậm màu và bền hoa, lâu tàn, nẩy nhiều mầm nụ, mầm lộc.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eCải tạo đất, giúp đất tơi xốp, tăng độ mùn cho đất.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eTăng sức đề kháng, cây khỏe, phòng chống sâu bệnh.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eTạo lập hệ vi sinh vật hữu ích và tăng mật độ vi sinh vật hữu ích trong đất.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eBảo vệ bộ rể và hỗ trợ khả năng hấp thu dưỡng chất của cây trồng.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eGiúp cây trồng hấp thu dễ dàng các dưỡng chất trong đất.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eHạn chế vàng lá gân xanh trên hoa hồng, rụng lá trên cây.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eHướng dẫn sử dụng Phân bón đậu tương, đậu nành chuối humic DOCNEEM:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003ePha 10ml đậu tương humic với 1 lít nước, sau đó tưới gốc. Tưới định kỳ 1 lần/tuần.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/78/be/a0/adb9bcc5e65168415ef90e051dde5e66.jpg\" alt=\"chế phẩm đậu nành humic\" width=\"750\" height=\"1000\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003eSản phẩm hữu cơ, thân thiện với môi trường\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eDOCNEEM cam kết:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eSản phẩm Phân bón đậu tương, đậu nành chuối humic DOCNEEM 2 chai 1L giống mô tả. \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eHình ảnh sản phẩm là ảnh thật do shop tự chụp và giữ bản quyền hình ảnh.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eĐảm bảo sản phẩm hữu cơ chất lượng 100%.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eĐược đóng gói cẩn thận và tư vấn nhiệt tình trước khi gói hàng giao cho Quý Khách.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eHàng có sẵn, giao hàng ngay khi nhận được đơn. \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eHoàn tiền nếu sản phẩm không giống với mô tả.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eGiao hàng trên toàn quốc, nhận hàng tại nhà.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cstrong\u003eHỗ trợ đơn hàng theo quy định của Tiki:\u003c/strong\u003e\u003c/em\u003e\u003c/p\u003e\n\u003col\u003e\n\u003cli\u003e\u003cspan style=\"font-weight: 400;\"\u003e Điều kiện áp dụng (trong vòng 07 ngày kể từ khi nhận sản phẩm) \u003c/span\u003e\u003c/li\u003e\n\u003c/ol\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003e- Hàng hoá vẫn còn mới, chưa qua sử dụng \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003e- Hàng hoá bị lỗi hoặc hư hỏng do vận chuyển hoặc do nhà sản xuất \u003c/span\u003e\u003c/p\u003e\n\u003col start=\"2\"\u003e\n\u003cli\u003e\u003cspan style=\"font-weight: 400;\"\u003e Trường hợp được chấp nhận: \u003c/span\u003e\u003c/li\u003e\n\u003c/ol\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003e- Hàng không đúng kích thước, kiểu dáng như quý khách đặt hàng \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003e- Không đủ số lượng, không đủ bộ như trong đơn hàng \u003c/span\u003e\u003c/p\u003e\n\u003col start=\"3\"\u003e\n\u003cli\u003e\u003cspan style=\"font-weight: 400;\"\u003e Trường hợp không đủ điều kiện áp dụng chính sách: \u003c/span\u003e\u003c/li\u003e\n\u003c/ol\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003e- Quá 07 ngày kể từ khi Quý khách nhận hàng. \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003e- Gửi lại hàng không đúng mẫu mã, không phải sản phẩm của DOCNEEM.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003e- Không thích, đặt nhầm mã,...\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003e- Do màn hình và điều kiện ánh sáng khác nhau, màu sắc thực tế 