ển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/62/ff/0f/a66b39583387a7a233ab317f28f30550.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/62/ff/0f/a66b39583387a7a233ab317f28f30550.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/62/ff/0f/a66b39583387a7a233ab317f28f30550.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/62/ff/0f/a66b39583387a7a233ab317f28f30550.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/62/ff/0f/a66b39583387a7a233ab317f28f30550.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/6c/55/23/024806ee84e9f0618d27978e9b8371ce.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/6c/55/23/024806ee84e9f0618d27978e9b8371ce.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/6c/55/23/024806ee84e9f0618d27978e9b8371ce.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6c/55/23/024806ee84e9f0618d27978e9b8371ce.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6c/55/23/024806ee84e9f0618d27978e9b8371ce.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/94/c3/e3/32956fc154e30cfadd02887f1af161e9.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/94/c3/e3/32956fc154e30cfadd02887f1af161e9.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/94/c3/e3/32956fc154e30cfadd02887f1af161e9.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/94/c3/e3/32956fc154e30cfadd02887f1af161e9.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/94/c3/e3/32956fc154e30cfadd02887f1af161e9.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/10/71/11/db8adc60465622c9790ec8319723cb30.jpg","is_gallery"