68d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":75000,"discount_rate":50,"rating_average":4.8,"review_count":37,"review_text":"(37)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/2a/c9/6f/be22882191b5d3b32ac2050177d2c36f.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1035,"all_time_quantity_sold":205,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cspan style=\"color:#ff6600;\"\u003e\u003cstrong\u003eOSRAM\u003c/strong\u003e\u003c/span\u003e Thương hiệu hàng đầu thế giới trong lĩnh vực chiếu sáng đến từ \u003cstrong\u003eCHLB Đức\u003c/strong\u003e. Các dòng sản phẩm được Nhập khẩu và Phân phối chính hãng tại thị trường Việt Nam, đáp ứng các tiêu chuẩn an toàn Quốc tế mang lại sự tin cậy cho người dùng.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eBóng đèn LED T-Bulb trụ OSRAM\u003c/strong\u003e dòng sản phẩm với hiệu suất vượt trội là giải pháp chiếu sáng tiết kiệm với giá thành cực tốt. Dùng để thay thể bóng Compact công suất cao. Chất liệu nhựa cao cấp hạn chế vở và chống côn trùng xâm nhập. Tiết kiệm 50% điện năng so với bóng Compact và 30% so với bóng LED thông thường khác.\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/dc/f2/2c/02508d7fb86f03059f94d12489ba2e64.jpg\" alt=\"Bóng LED trụ OSRAM\" width=\"750\" height=\"421\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cem\u003eBóng LED Trụ Chính Hãng OSRAM\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eỨng dụng chiếu sáng: \u003c/strong\u003eHộ gia đình\u003cstrong\u003e, \u003c/strong\u003eNhà xưởng, Nhà kho, Nhà ga, Khu công nghiệp...\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/12/bf/45/9b466b363ba2812926d3f73f75596931.jpg\" alt=\"Bóng LED Trụ OSRAM\" width=\"750\" height=\"501\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cem\u003eBóng LED Trụ Chiếu sáng tiết kiệm, hiệu suất phát sáng cao.\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eLỢI ÍCH SẢN PHẨM:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eSử dụng công nghệ LED tiết kiệm điện 50% so với đèn Compact truyền thống.\u003c/li\u003e\n\u003cli\u003eHiệu suất phát sáng vượt trội là giải pháp chiếu sáng tiết kiệm giá thành cực tốt.\u003c/li\u003e\n\u003cli\u003eTuổi thọ đèn lên đến 12,000 giờ giúp hạn chế chi phí bảo trì, thay thế.\u003c/li\u003e\n\u003cli\u003eChỉ số trung thực màu CRI \u0026gt;80, điện áp 220-240V.\u003c/li\u003e\n\u003cli\u003eKhông chứa tia UV, tia hồng ngoại độc hại trong nguồn sáng.\u003c/li\u003e\n\u003cli\u003eChất liệu nhựa thân thiện với môi trường.\u003c/li\u003e\n\u003cli\u003eTự động điều chỉnh ánh sáng khi quá nhiệt độ do sử dụng liên tục trong thời gian dài.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eTHÔNG SỐ KỸ THUẬT\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eCông suất: 18W/ 27W/ 36W/ 45W\u003c/li\u003e\n\u003cli\u003eCường độ ánh sáng: 1650lm/ 2500lm/ 3300lm/ 4100 lm\u003c/li\u003e\n\u003cli\u003eNhiệt độ màu: Vàng (3000K), Trắng (6500K)\u003c/li\u003e\n\u003cli\u003eĐộ chuẩn màu CRI: \u0026gt;80\u003c/li\u003e\n\u003cli\u003eChất liệu: Nhựa tổng hợp\u003c/li\u003e\n\u003cli\u003eTiêu chuẩn bảo vệ: IP20\u003c/li\u003e\n\u003cli\u003eTiêu chuẩn năng lượng: A+\u003c/li\u003e\n\u003cli\u003eNguồn điện: 220 - 240V/ 50 – 60Hz\u003c/li\u003e\n\u003cli\u003eTuổi thọ: 12,000 Giờ\u003c/li\u003e\n\u003cli\u003eSố lần bật tắt: 100,000 lần\u003c/li\u003e\n\u003cli\u003eĐui đèn: E27\u003c/li\u003e\n\u003cli\u003eHãng sản xuất: OSRAM - Nhập khẩu Chính Hãng\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/e5/33/c0/c59df35461f49c2c4aea5e5c98e6f247.jpg\" alt=\"Hỗ trợ\" width=\"750\" height=\"238\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/2a/c9/6f/be22882191b5d3b32ac2050177d2c36f.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/2a/c9/6f/be22882191b5d3b32ac2050177d2c36f.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/2a/c9/6f/be22882191b5d3b32ac2050177d2c36f.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2a/c9/6f/be22882191b5d3b32ac2050177d2c36f.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2a/c9/6f/be22882191b5d3b32ac2050177d2c36f.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/76/1e/71/82087b38e6222f0dbc545521b46e806f.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/76/1e/71/82087b38e6222f0dbc545521b46e806f.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/76/1e/71/82087b38e