c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":413000,"discount_rate":30,"rating_average":5,"review_count":7,"review_text":"(7)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/11/7d/5e/68f1a0ba1e6b12fc5533f26a25d280af.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":533,"all_time_quantity_sold":48,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003eGiới thiệu\u003c/h3\u003e\n\u003cp\u003e\u003cstrong\u003eSữa Bột Abbott Ensure Gold Hương Vani Ít Ngọt 850g \u003cbr /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/34/34/c2/25a7af5276c2980363e13b6f7ad9f5d4.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003cbr /\u003e\u003c/strong\u003e được đặc chế với hỗn hợp chất béo giàu PUFA, MUFA rất tốt cho hệ tim mạch. Sữa  cũng cung cấp các acid béo thiết yếu như Linoleic và Linolenic, hàm lượng acid béo no và Cholesterol thấp phù hợp với chế độ ăn lành mạnh hằng ngày của bạn.\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eĐược đặc chế với hỗn hợp chất béo giàu PUFA, MUFA rất tốt cho hệ tim mạch. Sữa cũng cung cấp Cholin và Acid Oleic giúp hỗ trợ trí nhớ và hoạt động của hệ thần kinh.\u003c/li\u003e\u003cli\u003eGiúp hệ tiêu hóa khỏe mạnh và hoạt động tốt. Dưỡng chất FOS có trong sữa còn được tăng thêm hiệu quả hoạt độngnhờ sự kết hợp lý tưởng với Inulin* (chất xơ hòa tan) để hình thành hệ Prebiotic kép – Beneo Synergy 1. Y học đã chứng minh BeneoSynergy 1** giúp cơ thể hấp thu canxi tốt hơn.\u003c/li\u003e\u003cli\u003eThích hợp cho người ăn uống kém và người bệnh cần phục hồi nhanh.\u003c/li\u003e\u003cli\u003eCung cấp đầy đủ vitamin và khoáng chất rất thích hợp khi cần phục hồi sức khỏe nhanh. Bạn cũng có thể dùng sữa để bổ sung vào khẩu phần ăn khi có nhu cầu tăng thêm về năng lượng và chất đạm, hoặc để duy trì tình trạng dinh dưỡng tốt Sữa Bột Abbott Ensure Gold ESS có thể thay thế hoàn toàn hay một phần bữa ăn để duy trì hoặc tăng cường sức khỏe cho bạn và gia đình.\u003c/li\u003e\u003c/ul\u003e\n\u003ch3\u003e\u003cstrong\u003e Hướng dẫn sử dụng \u003c/strong\u003e\u003c/h3\u003e\n\u003cul\u003e\u003cli\u003eĐun sôi nước trước khi dùng để pha và làm theo bảng hướng dẫn kèm theo. Chỉ dùng muỗng có sẵn trong hộp để lường sữa. Lượng pha dư hơn 1 lần uống phải bảo quản trong  ở 2-4ºC không quá 24 giờ.\u003c/li\u003e\u003cli\u003eChỉ sử dụng sản phẩm này theo chỉ dẫn của bác sĩ/chuyên viên dinh dưỡng.\u003c/li\u003e\u003c/ul\u003e\n\u003ch3\u003e\u003cstrong\u003e Cách pha chuẩn\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003ePha 230,4 gram sữa với nước ấm để có được 1 lít sữa. Hoặc 6 muỗng bột với 195ml nước ấm.\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003e Bảo quản\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eBảo quản hộp chưa mở ở nhiệt độ phòng. Sau khi mở nắp cần sử dụng hết trong vòng 3 tuần. Đậy nắp kín sau mỗi lần sử dụng, để nơi khô mát (không cho vào tủ lạnh).\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003e Lưu ý\u003c/strong\u003e\u003c/h3\u003e\n\u003cul\u003e\u003cli\u003eKhông dùng cho người bệnh Galactosemia\u003c/li\u003e\u003cli\u003eKhông dùng qua đường tĩnh mạch\u003c/li\u003e\u003cli\u003eKhông dùng cho trẻ nhỏ nếu không có hướng dẫn của bác sĩ và các chuyên gia y tế\u003c/li\u003e\u003cli\u003eKhông dùng lò viba để hâm nóng sữa.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cem\u003e \u003cstrong\u003e Sản phẩm giới hạn, mỗi khách hàng chỉ được mua tối đa 2 hộp. Tiki xin phép từ chối các đơn hàng mua sỉ. \u003c/strong\u003e \u003c/em\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/11/7d/5e/68f1a0ba1e6b12fc5533f26a25d280af.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/11/7d/5e/68f1a0ba1e6b12fc5533f26a25d280af.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/11/7d/5e/68f1a0ba1e6b12fc5533f26a25d280af.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/11/7d/5e/68f1a0ba1e6b12fc5533f26a25d280af.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/11/7d/5e/68f1a0ba1e6b12fc5533f26a25d280af.png"},{"base_url":"https://salt.tikicdn.com/ts/product/64/a5/a4/8dc22a99ca4cc987c19c4bbac8f86fb4.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/64/a5/a4/8dc22a99ca4cc987c19c4bbac8f86fb4.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/64/a5/a4/8dc22a99ca4cc987c19c4bbac8f86fb4.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/64/a5/a4/8dc22a99ca4cc987c19c4bbac8f86fb4.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/64/a5/a4/8dc22a99ca4cc987c19c4bbac8f86fb4.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/60/8f/ce/4555a1a43ffd6e6db0d90a781fbc1803.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/60/8f/ce/4555a1a43ffd6e6db0d90a781fbc1803.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/60/8f/ce/4555a1a43ffd6e6db0d90a781fbc1803.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/60/8f/ce/4555a1a43ffd6e6db0d90a781fbc1803.jpg","thumbnail_url":"https://salt.tikicdn.c