9971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":1,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/cd/8e/88/cb7f52bf494290756293995c56ec4ad6.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2323,"all_time_quantity_sold":127,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch5\u003e \u003c/h5\u003e\n\u003ch5\u003eThiết kế tiện dụng\u003c/h5\u003e\n\u003cp\u003e\u003cstrong\u003eGậy Chụp Hình Đa Năng Kèm Chân Yunteng YT-9928 \u003c/strong\u003emẫu gậy đa năng mới nhất của hãng. Với thiết kế mới nhỏ gọn tiền dùng hơn so với các phiên bản cũ. Gậy tự sướng kèm chân Yunteng YT-9928, kích thước nhỏ gọn chỉ 20.5cm và kéo dài tối đa tới 100cm. Phiên bản thu gọn của gậy VCT-1688, tiện dùng hơn khi đi du lịch. \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch5\u003eCấu tạo chắc chắn\u003c/h5\u003e\n\u003cp\u003eGậy chụp hình đa năng kèm chân Yunteng thân cây làm từ hợp kim cứng cáp. Đặc biệt trên mẫu mới này nhà sản xuất làm dạng rút dễ sử dụng hơn (dạng xoay) trên VCT-1688 hay YT-2288. Trên thân cây được làm 2 rãnh chống xoay đối xứng nhau chắc chắn và không bị lắc.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003ePhần chân của gậy đa năng được làm chất liệu nhựa cứng giống với chân YT-238. Độ mở giữa các chân là 19cm. Do vậy khi kéo lên làm chân đứng nên để ở mức độ khoảng 50cm tránh bị rung lắc nhiều. Nếu dùng máy ảnh cỡ vừa và nhỏ thì nên để ở độ cao mặc định của chân không nên kéo cao. Trên chân có trang bị máng gài remote tiện dùng khi không dùng tránh thất lạc.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eĐầu gắn của gậy Selfie đa năng YT-9928 có ren chuẩn 1/4″. Dùng gắn các mẫu máy ảnh, máy quay cỡ nhỏ hoặc Action Cam như GoPro, Xiaomi, SJCAM. Đầu ren có thể chỉnh xoay 360 độ, có tích hợp gương nhỏ để chụp hình với camera sau.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch5\u003eTính năng vượt trội\u003c/h5\u003e\n\u003cp\u003eCó tích hợp sẵn Remote chụp hình từ xa cho điện thoại. Tương thích với các máy Android và IOS, dùng pin sạc tiện dùng với pin dự phòng, sạc điện thoại, khi sạc đầy có thể chụp 700-1000 tấm hình. Đầu kẹp điện thoại với thiết kế mới có thể gập lại, dạng xoay có thể gắn các máy kích thước từ 3.5 inch tới 6.5 inch.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://vcdn.tikicdn.com/ts/tmp/d8/dd/da/ec6dbbe5fde8af195d1bf114b990ddfb.jpg\" alt=\"Gậy Chụp Hình Đa Năng Kèm Chân Yunteng YT-9928 - Hàng Nhập Khẩu\" width=\"750\" height=\"675\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/cd/8e/88/cb7f52bf494290756293995c56ec4ad6.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/cd/8e/88/cb7f52bf494290756293995c56ec4ad6.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/cd/8e/88/cb7f52bf494290756293995c56ec4ad6.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/cd/8e/88/cb7f52bf494290756293995c56ec4ad6.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/cd/8e/88/cb7f52bf494