con_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"defective_product"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":22,"review_text":"(22)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/61/ed/87/99254c4ac887ccef602f2f5f8c4c91c6.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1905,"all_time_quantity_sold":109,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eTÊN SẢN PHẨM: Nước Hoa Nam Laura Anne Mystic 50ml\u003c/p\u003e\n\u003cp\u003eLOẠI NƯỚC HOA: Eau De Parfum (EDP)\u003c/p\u003e\n\u003cp\u003eDÒNG: Laura Anne\u003cbr /\u003e- Mùi hương của Nước Hoa Nam Laura Anne Mystic 50ml mang một ít tươi mát của những cơn mưa ngày hè, làm xộc lên mùi đất trầm ấm, cảm nhận sự ngọt ngào đến nồng nàn rồi lại chạm vào tầng sâu tĩnh lặng của gỗ. Khoác mùi hương này lên người, mọi chàng trai đều trở nên huyền bí và mạnh mẽ như những khu rừng phương Đông.\u003c/p\u003e\n\u003cp\u003eTHÔNG TIN SẢN PHẨM: \u003cbr /\u003e- Mùi hương: Huyền bí và phong trần\u003cbr /\u003e- Tầng hương: 3 tầng hương rõ rệt.\u003cbr /\u003eLà bản hòa tấu của những note hương ngọt ngào của vani, của bạch đậu khấu, xen kẽ một chút cay nồng của hồ tiêu rồi lại lắng đọng đầy trầm ấm của gỗ tuyết tùng.\u003cbr /\u003e- Nốt hương: \u003cbr /\u003e+ Hương đầu: hồ tiêu, bạch đậu khấu, hương bưởi\u003cbr /\u003e+ Hương giữa: hương quế, nhục đậu khấu, hoa cam\u003cbr /\u003e+ Hương cuối: đậu Tonka, hương vani, hổ phách, gỗ tuyết tùng.\u003cbr /\u003e-Dung tích: 50ml\u003cbr /\u003e-Độ lưu hương: 8H\u003c/p\u003e\n\u003cp\u003ePHÂN LOẠI SẢN PHẨM:\u003cbr /\u003eDòng Nước hoa Laura Anne có 3 loại chính: \u003cbr /\u003e- Dynamic For Him/ Her (màu xanh)\u003cbr /\u003e- Allure For Him/ Her (màu đỏ)\u003cbr /\u003e- Mystic For Him/ Her (màu xám)\u003c/p\u003e\n\u003cp\u003eHƯỚNG DẪN SỬ DỤNG: \u003cbr /\u003e- Hướng vòi xịt vào vị trí cần xịt, cách cơ thể khoảng 15 - 20 cm.\u003cbr /\u003e- Xịt ở những vùng cơ thể tập trung nhiều mạch máu, da ẩm và nhạy cảm như cổ tay, sau gáy, giữa ngực, để hương thơm có thể khuếch tán đồng thời cũng giữ mùi được lâu hơn.\u003cbr /\u003e- Hạn chế xịt trực tiếp lên quần áo và đồ trang sức. Cất nước hoa ở những nơi thoáng mát, không bị ánh nắng chiếu trực tiếp vào sẽ giúp chai nước hoa không bị biến chất, mất mùi.\u003c/p\u003e\n\u003cp\u003eHẠN SỬ DỤNG: \u003cbr /\u003e- 3 năm kể từ ngày sản xuất\u003c/p\u003e\n\u003cp\u003eXUẤT XỨ: \u003cbr /\u003e- Việt Nam\u003c/p\u003e\n\u003cp\u003eĐẶC ĐIỂM NỔI BẬT:\u003cbr /\u003e- Nhà chế tác hàng đầu thế giới: Firmenich\u003cbr /\u003e- Hương liệu nhập khẩu hoàn toàn từ Châu Âu\u003cbr /\u003e- Nhà máy sản xuất đạt chuẩn CGMP và IFra\u003cbr /\u003e- Độ Lưu Hương: 6-8h\u003c/p\u003e\n\u003cp\u003eLƯU Ý:\u003cbr /\u003e- Không được xịt vào mắt.\u003cbr /\u003e- Không để nới có nhiệt độ cao.\u003cbr /\u003e- Để xa tầm tay trẻ em.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/61/ed/87/99254c4ac887ccef602f2f5f8c4c91c6.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/61/ed/87/99254c4ac887ccef602f2f5f8c4c91c6.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/61/ed/87/99254c4ac887ccef602f2f5f8c4c91c6.png","position":null,"sma