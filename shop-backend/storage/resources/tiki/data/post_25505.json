d/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/38/91/23/e4406f4b1dc021ce935abc3a50c3de1d.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":516,"all_time_quantity_sold":12,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003eAdapter Sạc Type C 15W Samsung EP-T1510N sở hữu thiết kế tối giản cùng mức công suất sạc tối đa 15 W cho phép sạc an toàn cho các thiết bị điện tử, đồng hành hàng ngày cùng bạn.\u003c/h3\u003e\n\u003ch3\u003eVẻ ngoài tối giản, màu trắng sang trọng\u003c/h3\u003e\n\u003cp\u003eAdapter này mang đến một kiểu dáng đơn giản, đẹp mắt, các cạnh và mép được bo hơi cong một chút, cho cảm giác mềm mại khi cầm nắm, không bị đau tay. Về tổng thể, củ sạc nhỏ gọn, bạn có thể mang nó theo trong mọi chuyến hành trình bằng cách bỏ vào balo hoặc túi áo.\u003c/p\u003e\n\u003cp\u003e\u003c/p\u003e\n\u003ch3\u003eMức công suất 15 W phù hợp để sạc cho nhiều thiết bị\u003c/h3\u003e\n\u003cp\u003eCông suất đầu ra tối đa được hỗ trợ là 15 W. Mức công suất này cho phép bạn sạc pin an toàn cho các thiết bị như: Tai nghe Bluetooth, sạc dự phòng, smartwatch, điện thoại, máy tính bảng, Đặc biệt, củ sạc hoàn toàn và hoàn toàn tương thích khi sạc cho các thiết bị của Samsung như: Galaxy S23, Galaxy S23 Plus, Galaxy S23 Ultra, Galaxy Buds 2 Pro, Galaxy Tab S8 Series,\u003c/p\u003e\n\u003cp\u003eLưu ý: Để đạt được hiệu suất tối ưu khi sạc, nhà sản xuất khuyên dùng cùng cáp sạc Samsung.\u003c/p\u003e\n\u003cp\u003e\u003c/p\u003e\n\u003ch3\u003eĐầu vào cổng cắm 2 chấu tiện lợi, cổng ra Type C phổ biến\u003c/h3\u003e\n\u003cp\u003e Adapter Samsung này phù hợp với hầu hết các ổ điện dân dụng và cắm dễ dàng hơn nhờ được trang chân cắm dạng 2 chấu tròn.\u003c/p\u003e\n\u003cp\u003eChuẩn sạc Type C đang dần được sử dụng phổ biến và trở thành chuẩn mới ở thời điểm hiện tại cho phép bạn dễ dàng tìm kiếm cáp sạc đầu vào Type C ở ngoài thị trường để tạo một bộ sạc hoàn chỉnh.\u003c/p\u003e\n\u003cp\u003e\u003c/p\u003e\n\u003cp\u003eTóm lại, với một thiết kế nhỏ gọn nhưng adapter Sạc Type C 15W Samsung EP-T1510N hoàn toàn đáp ứng tốt các trải nghiệm sạc pin cơ bản của bạn hàng ngày, tự tin sạc cho nhiều thiết bị.\u003c/p\u003e\n\u003cp class=\"parameter__title\"\u003eThông số kỹ thuật Adapter Sạc Type C 15W Samsung EP-T1510N\u003c/p\u003e\n\u003cdiv class=\"parameter\"\u003e\n\u003cul class=\"parameter__list 292276 active\"\u003e\u003cli\u003e\n\u003cp class=\"lileft\"\u003eChức năng: \u003cspan\u003eSạc\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp class=\"lileft\"\u003eĐầu vào: \u003cspan\u003e100-240V~50/60Hz, 0.5A\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp class=\"lileft\"\u003eĐầu ra: \u003cspan\u003eType C: 9V - 1.67A, 5V - 2A\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp class=\"lileft\"\u003eJack kết nối: \u003cspan\u003eType-C\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp class=\"lileft\"\u003eDòng sạc tối đa: \u003cspan\u003e15 W\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp class=\"lileft\"\u003eSản xuất tại: \u003cspan\u003eViệt Nam\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp class=\"lileft\"\u003eThương hiệu của: \u003cspan\u003eHàn Quốc\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u0