x":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/bf/51/f6/2f94bb68c38f4ecb95c8c4738ff4c58f.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1729,"all_time_quantity_sold":14,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eXuất xứ Nhật Bản\u003cbr /\u003eHạn sử dụng 3 năm kể từ ngày sản xuất\u003cbr /\u003eThành phần Chiết xuất nhau thai cừu, Collagen, Protein, Vitamin, Amino A\u003cbr /\u003eCông dụng Hỗ trợ nuôi dưỡng làn da mịn màng, tăng cường sức đề kháng cho cơ thể\u003cbr /\u003eQuy cách đóng gói Vỉ\u003cbr /\u003eDung tích 50 (ml)\u003cbr /\u003eNước uống bổ sung Collagen Itoh EX Placenta chứa chiết xuất từ nhau thai cừu nguyên chất, cung cấp các Protein, Vitamin và các Amino Axit thiết yếu đánh thức nguồn năng lượng cho làn da được trẻ hóa. Bên cạnh đó, nhau thai cừu còn có khả năng ức chế Enzyme xúc tác quá trình hình thành hắc sắc tố, hỗ trợ nuôi dưỡng làn da tươi sáng, đồng thời cải thiện tình trạng rối loạn sắc tố trên da như nám, tàn nhang khiến da sạm màu, hỗ trợ phục hồi những tế bào da hư tổn, thúc đẩy làm nhanh liền sẹo cho làn da mịn màng.\u003c/p\u003e\n\u003cp\u003eBên cạnh đó, sản phẩm còn chứa chiết xuất từ Collagen tinh khiết, hỗ trợ tăng cường độ đàn hồi, tái tạo làn da kém săn chắc và ngăn ngừa da chùng nhão do quá trình lão hóa. Kết hợp cùng với CoEnzyme Q10 là một chất có đặc tính chống oxy hóa mạnh mẽ, nước uống hỗ trợ củng cố sức đề kháng cho cơ thể và làm chậm lại quá trình lão hóa ở da, giúp nuôi dưỡng và duy trì làn da tươi trẻ đầy sức sống.\u003c/p\u003e\n\u003cp\u003eThành phần chính và công dụng\u003c/p\u003e\n\u003cp\u003eChiết xuất nhau thai cừu\u003cbr /\u003eHỗ trợ làm trắng da nhờ ức chế Enzyme xúc tác cho quá trình hình thành sắc tố\u003cbr /\u003eHỗ trợ giảm sự tổng hợp hắc tố gây ra các vết nám, loại bỏ vết nám và tình trạng nhợt nhạt của da\u003cbr /\u003eHỗ trợ giữ ẩm cho da trong thời gian dài\u003cbr /\u003eHỗ trợ tăng sinh và tái tạo tế bào, giúp chống lão hoá\u003cbr /\u003eCollagen\u003cbr /\u003eHỗ trợ tăng cường sự kết nối giữa các tế bào, tái tạo độ đàn hồi cho da, giúp da căng mịn và không bị chùng nhão, chảy xệ\u003cbr /\u003eHỗ trợ bổ sung Collagen cũng giúp các vết thương mau lành sẹo, tăng cường độ chắc khoẻ của mạch máu và cấu trúc xương\u003cbr /\u003eCoEnzyme Q10\u003cbr /\u003eHỗ trợ làm chậm sự lão hóa cơ thể, cải thiện khả năng làm việc, kéo dài tuổi thọ\u003cbr /\u003eHỗ trợ tăng cường hệ miễn dịch, giúp cơ thể phòng chống được nhiều loại bệnh tật\u003cbr /\u003eCeramide hỗ trợ kết dính các tế bào sừng của da, tạo nên bức tường rào vững chắc bảo vệ cho các thành phần quan trọng bên dưới như Collagen, Elastin, độ ẩm\u003cbr /\u003eHyaluronic Acid là phân tử dạng gel có khả năng giữ nước rất tốt, có chức năng làm chất đệm và lấp đầy khoảng trống giữa những tế bào, nhờ vậy hỗ trợ tăng hiệu quả hấp thu của sản phẩm và giữ ẩm cho da.\u003cbr /\u003eSản phẩm không phải là thuốc, không có tác dụng thay thế thuốc chữa bệnh.\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/64/b3/e1/59c4c71eee163cc4b65864da9f4b8fac.jpg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/64/b3/e1/59c4c71eee163cc4b65864da9f4b8fac.jpg\" alt=\"\" width=\"550\" height=\"677\