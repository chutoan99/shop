4/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":15500,"discount_rate":10,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/19/0e/37/2520ed19f66921c3027bf0cf9a077759.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":184,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3 style=\"text-align:center;\"\u003e\u003cspan style=\"color:#ff0000;\"\u003e\u003cstrong\u003eBÀ DALLOWAY\u003c/strong\u003e\u003c/span\u003e\u003c/h3\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cspan style=\"color:#008000;\"\u003e\u003cstrong\u003e“MỘT CUỐN SÁCH KỲ LẠ ĐẾN KHÔNG TƯỞNG VÀ SÂU RỘNG ĐẾN PHI THƯỜNG\u003c/strong\u003e\u003c/span\u003e\u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e \u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cspan style=\"color:#008000;\"\u003e\u003cstrong\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/aa/f0/c4/fd0cbe8fdff48a02d1a846feb6af598e.jpg\" alt=\"\" width=\"750\" height=\"274\" /\u003e\u003c/strong\u003e\u003c/span\u003e\u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cspan style=\"color:#008000;\"\u003e\u003cstrong\u003e---\u003c/strong\u003e\u003c/span\u003e\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv\u003eBà Dalloway của Virginia Woolf được xuất bản vào năm 1925 và lấy bối cảnh cùng thời điểm đó. Tác phẩm được mở đầu bằng một buổi sáng, bà Dalloway tự đi mua hoa để trang trí cho bữa tiệc tối của mình, và câu chuyện kết thúc vào tối khuya ngày hôm đó – Đây là câu chuyện của một ngày. Nó diễn ra trong một ngày.\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv\u003eNhưng, có quá nhiều bước nhảy về thời gian, lộn xộn, quá khứ, hiện tại, đan xen trong quá trình phát triển câu chuyện. Có quá nhiều nhân vật, cả chính, phụ đều cùng nhau diễu hành trong cốt truyện và phô bày những khoảnh khắc nội tâm phức tạp của họ. Ý nghĩ và hành động của nhân vật đen xen như những sợi tơ nhện với tầng tầng lớp lớp các ẩn dụ. Những điều sâu thẳm nhất trong tâm hồn mỗi nhân vật lại được miêu tả một cách rõ ràng.\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv\u003eChỉ trong một ngày, lần theo bước chân của một người phụ nữ, người đọc sẽ lần lượt được chiêm ngưỡng cả London hiện tại, một London thời hậu chiến, nơi mà những vết thương do chiến tranh để lại vẫn còn rỉ máu. Những tác động của nó đối với mọi tầng lớp xã hội vẫn còn nặng nề, sâu thẳm. Và ở đó, là cuộc đấu tranh như chính Virginia Woolf đã nói về tác phẩm này của mình: “ Tôi muốn đưa ra sự sống và cái chết; sự tỉnh táo và mất trí; tôi muốn phê phán xã hội; Và biểu thị nó trong hoạt động, ở một trạng thái mãnh liệt nhất của nó.”\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv\u003eBà Dalloway được coi là một trong những cuốn sách văn học tiêu biểu đầu thế kỷ 20, được tờ Telegrap đánh giá là 100 cuốn tiểu thuyết nên đọc trong đời.\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv\u003eNhư chính Virginia Woolf đã nói: “Nhà văn thả vào từng con chữ trong các tác phẩm của mình những bí mật thẳm sâu trong tâm hồn, những trải nghiệm cuộc sống và cả đạo đức của họ.” Bà Dalloway là như thế.\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv\u003e\u003cstrong\u003eVỀ VIRGINIA WOOLF\u003c/strong\u003e\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv\u003eVirghinia Woolf là một tiểu thuyết gia và là một nhà văn tiểu luận người Anh, bà được coi là một trong những nhân vật văn học hiện đại lừng danh nhất thế kỷ 20, một nhân vật có tầm ảnh hưởng xã hội văn học Anh, với các tác phẩm nổi tiếng như: Căn phòng riêng, Đêm và Ngày, Căn phòng của Jacob, Đến ngọn hải đăng, Orlando, Những đợt sóng, Ba đồng tiền vàng.\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv\u003eCác tác phẩm của bà gắn liền với sự phát triển của phê bình nữ quyền, một nhà văn quan trọng trong phong trào chủ nghĩa hiện đại, đồng tính luyến ái và tiền sử trầm cảm.\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/19/0e/37/2520ed19f66921c3027bf0cf9a077759.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/19/0e/37/2520ed19f66921c3027bf0cf9a077759.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/19/0e/37/2520ed19f66921c3027bf0cf9a077759.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/19/0e/37/2520ed19f66921c3027bf0cf9a077759.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/19/0e/37/2520ed19f66921c3027bf0cf9a077759.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/95/2b/ec/f84e6b9998332fab2f77e27e51b0e469.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/95/2b/ec/f84e6b9998332fab2f77e27e51b0e469.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/95/2b/ec/f84e6b9998332fab2f77e27e51b0e469.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/95/2b/ec/f84e6b9998332fab2f77e27e51b0e469.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/prod