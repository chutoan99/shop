":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":8000,"discount_rate":40,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/2c/bd/2c/fe8712d819dca0f98df392e0603497a2.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":406,"all_time_quantity_sold":38,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp class=\"irIKAp\"\u003eKhử mùi ô tô túi than hoạt tính lọc không khí, không hương liệu, an toàn cho sức khỏe, phụ kiện trang trí oto Tâm Luân\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cstrong\u003eĐẶC ĐIỂM NỔI BẬT SẢN PHẨM KHỬ MÙI Ô TÔ, TÚI THAN HOẠT TÍNH LỌC KHÔNG KHÍ KHÔNG HƯƠNG LIỆU, AN TOÀN CHO SỨC KHỎE, PHỤ KIỆN TRANG TRÍ OTÔ TÂM LUÂN\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- 100% than hoạt tính\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Hấp thụ mạnh và khử sạch mùi mồ hôi, nấm mốc vi khuẩn, khí độc\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Không hương liệu tổng hợp, không hóa chất độc hại, an toàn sử dụng cho trẻ em, thú cưng,\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Dễ dàng tái tạo, phân hủy, thân thiện với môi trường\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Túi vải lanh, thấm hút tốt, có quai treo tiện lợi\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eMùi thức ăn, khói bụi, ẩm mốc, mùi điều hòa đầy vi khuẩn thường gây cảm giác khó chịu, say xe và ảnh hưởng trực tiếp tới sức khỏe khi di chuyển trên xe. Trang bị 4 túi than tra hoạt tính trong xe là phương pháp đơn giản, tiết kiêm, an toàn để duy trì môi trường không khí trên xe trong lành, khô ráo và không có mùi. Tạo cảm giác thoải mái, dễ chịu, chống say xe khi di chuyển trên xe.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cstrong\u003eMÔ TẢ CHI TIẾT SẢN PHẨM KHỬ MÙI Ô TÔ, TÚI THAN HOẠT TÍNH LỌC KHÔNG KHÍ KHÔNG HƯƠNG LIỆU, AN TOÀN CHO SỨC KHỎE, PHỤ KIỆN TRANG TRÍ OTÔ TÂM LUÂN\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Than tre hoạt tính an toàn và bảo vệ sức khỏe tuyệt đối, hấp thụ mạnh những phân tử mùi độc hại như benzen và formaldehyde sinh ra từ nội thất xe, khử khuẩn, ẩm mốc hiệu quả cao. Túi vải không dệt chất lượng, vừa thoáng khí, có khả năng hấp thụ mùi vừa đảm bảo vụn than không rơi rớt ra xe.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Túi vải lanh bền đẹp, có độ thấm hút tốt, tiện dụng khi có thêm quai treo, có thể treo/ đặt tại nhiều vị trí trên xe\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eCác thiết bị trên ô tô có thể phát ra mức từ trường cao tới 18 uT, sử dụng lâu dài gây rối loạn cơ thể như mệt mỏi, mất ngủ, thoái hóa thần \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eHãy đặt các túi than hoạt tính xung quanh xe để giảm tác động của từ trường lên cơ thể bạn\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cstrong\u003eTHÔNG SỐ SẢN PHẨM KHỬ MÙI Ô TÔ, TÚI THAN HOẠT TÍNH KHỬ MÙI OTO KHÔNG HƯƠNG LIỆU, AN TOÀN CHO SỨC KHỎE, PHỤ KIỆN TRANG TRÍ OTÔ TÂM LUÂN\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eKích thước: 10x13cm\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eTrọng lượng: 100gr\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eThời hạn sử dụng: 6 -12 tháng. Sau 2-3 tuần sử dụng đem phơi nắng 1-3 tiếng và đựng vào túi vải lanh sử dụng tiếp\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cstrong\u003eHƯỚNG DẪN SỬ DỤNG\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eCó thể đặt trong các hộc đựng đồ, hộc cửa xe hoặc treo trong xe\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eTâm Luân cam kết với khách hàng.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e* Sản phẩm 100% giống mô tả.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e* Giao hàng trên toàn quốc – nhận hàng trả tiền.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e* Đổi trả theo đúng quy định của Tiki\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eĐiều kiện áp dụng (trong vòng 03 ngày kể từ khi nhận sản phẩm):\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Hàng hoá vẫn còn mới, chưa qua sử dụng.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Hàng hóa hư hỏng do vận chuyển hoặc do nhà sản xuất.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/2c/bd/2c/b104126fc75c74850e23403988800755.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/74/50/b3/33c0368362ba2a49d907bde883cba040.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/06/61/bb/39199db37693cf384d06e0b47a338fdb.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/e8/b9/43/3dc4f9c30a9132a7b2db15682440a133.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/32/9b/1a/6e4f4078b282561fb3a8637d1b4ad7bc.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/f8/56/a0/9ec7f9a238a52eef3bc2a52be4eb8abe.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/4f/b5/da/7587e1f208797b0ab1ded4aa7ae501f6.jpg\" alt=\"\" width=\