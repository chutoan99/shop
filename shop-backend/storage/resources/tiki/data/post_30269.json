:20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/a1/95/b9/e3565f4694aff9cf1502f078b8d6d4d6.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":68,"all_time_quantity_sold":6,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp class=\"QN2lPu\"\u003eTHÔNG TIN TÁC PHẨM\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e \u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eTên tác phẩm: Càng Lớn Càng Trở Thành Đứa Trẻ Hiểu Chuyện\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eTác giả: Đoàn Đoàn\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eDịch giả: Thiên\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eThể loại: Sách tản văn\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eThương hiệu: Time Books\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eNhà xuất bản: NXB Phụ nữ\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eNgôn ngữ được dịch: Tiếng Trung\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eNgôn ngữ: Tiếng Việt\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eMã ISBN: 978-604-490-186-2\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eLoại bìa: Mềm\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eKhổ: 11,5 x 17 cm\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eSố trang: 212 trang\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e_________________________\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e \u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eGIỚI THIỆU TÁC GIẢ\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e \u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eĐoàn Đoàn là tác giả nổi tiếng trên các nền tảng mạng xã hội Trung Quốc như Pipixia, Douyin, Huoshan, K\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eLà “người lữ khách cô đơn”, bầu bạn, nâng đỡ và đồng hành với độc giả trải qua những tháng ngày chênh vênh của hành trình trưởng thành, thông qua những con chữ.\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e__________________________\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e \u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eGIỚI THIỆU TÁC PHẨM\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eCuốn sách dành tặng bạn, những đứa trẻ hiểu chuyện vẫn muốn có kẹo ăn\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eLớn lên, ta sẽ đi qua những lúc tủi hờn, ấm ức nhưng mong bạn sẽ luôn vững vàng bước về phía trước\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e—\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eCó phải càng lớn lên chúng ta càng trở nên hiểu chuyện, ít kỳ vọng, cũng ít chia sẻ hơn?\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eKhi những đứa trẻ dần lớn lên, va vấp với thế giới của người trưởng thành, sẽ có những lúc ta cảm thấy buồn tủi, ấm ức muốn chực khóc, nhưng nước mắt chỉ có thể nuốt ngược vào trong. Ta dần học cách thu mình lại, quan sát và lắng nghe nhiều hơn… Dường như chúng ta “Càng lớn càng trở thành đứa trẻ hiểu chuyện”!\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eThế nhưng bạn thân mến ơi, người lớn cũng được phép nói mệt, ai bảo trẻ con lớn lên không được rơi nước mắt? Những lời thủ thỉ, tâm tình trong cuốn sách “Càng lớn càng trở thành đứa trẻ hiểu chuyện” muốn nhắn nhủ với bạn rằng:\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e- Trưởng thành thực sự không phải là luôn thỏa hiệp, không phải là đè nén cảm xúc, mà là học cách cân bằng và thấu hiểu bản sắc riêng của bản thân.\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e- Trưởng thành là khi ta biết yêu thương, bao dung cho người khác và cả chính mình.\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eSẽ có vài lần vấp ngã để ta biết mình mạnh mẽ, kiên cường đến nhường nào.\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eSẽ có những nỗi sợ, những thất bại trong cuộc đời làm bạn sụp đổ niềm tin, nhưng mình mong bạn hãy coi đó là bàn đạp để đứng lên và lắng nghe trái tim mình muốn gì. Hy vọng bạn có thể chăm sóc chính mình thật tốt, đối xử với bản thân thật dịu dàng và luôn yêu lấy bản sắc riêng của mình, bạn nhé.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/a1/95/b9/e3565f4694aff9cf1502f078b8d6d4d6.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a1/95/b9/e3565f4694aff9cf1502f078b8d6d4d6.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a1/95/b9/e3565f4694aff9cf1502f078b8d6d4d6.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a1/95/b9/e3565f4694aff9cf1502f078b8d6d4d6.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a1/95/b9/e3565f4694aff9cf1502f078b8d6d4d6.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/76/2a/ca/abf7172dd04699ecc9214c26c4725470.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/76/2a/ca/abf7172dd04699ecc9214c26c4725470.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/76/2a/ca/abf7172dd04699ecc9214c26c4725470.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/76/2a/ca/abf7172dd04699ecc9214c26c4725470.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/76/2a/ca/abf7172dd04699ecc9214c26c4725470.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/0a/46/8a/2399df135dc723200529460c1209eaa3.jpg","is_galle