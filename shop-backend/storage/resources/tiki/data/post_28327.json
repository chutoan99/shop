"icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ce/1c/54/6690d5d5c62c40f58e42fc7994d45e00.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1829,"all_time_quantity_sold":221,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eBánh dừa nướng là thương hiệu đặc sản nối tiếng của Xứ Quảng, được nhiều người biết đến. Món bánh giòn, thơm và hơi beo béo của cùi dừa sẽ làm bạn có cảm giác khó tả khi thưởng thức. Rất nhiều người đã đặt mua món bánh dừa nướng này để thưởng thức khi họ không có dịp mua trực tiếp ở Quảng Nam, Đà Nẵng.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eĐối với những người xứ Quảng, chỉ cần nghe mùi thôi là tuổi thơ tràn về, món quà mỗi lần mẹ đi chợ không thể thiếu.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cspan style=\"font-weight:400;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/11/3c/fb/22d64bf2d957e0180b2be5a192625090.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003cbr /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cspan style=\"font-weight:400;\"\u003e\u003cspan style=\"color:#0000ff;\"\u003e\u003cem\u003eBánh dửa nướng hiệu Phúc Đạt giòn, thơm ngon\u003c/em\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eMua bánh dừa nướng ở đâu?\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eKhông khó để bắt gặp, bánh dừa nướng có mặt tại tất cả các chợ ở Quảng Nam- Đà Nẵng, tuy nhiên nếu bạn ở xa thì lựa chọn mua qua Tiki là vô cùng hợp lí, đảm bảo hàng thật, chất lượng, date luôn mới.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/db/4e/89/42cacaf7c3bd9a05de9cd9c3db8cc21f.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cem\u003e\u003cspan style=\"color:#0000ff;\"\u003eBên trong túi nhỏ có 3-4 thanh bánh dừa nướng \u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003eBánh dừa nướng hiệu Phúc Đạt cắn vào giòn rụm, thơm ngon, vị ngọt vừa phải, không gắt như những cơ sở sản xuất khác.\u003c/p\u003e\n\u003cp\u003eMỗi gói bánh dừa nướng có 12 túi nhỏ bên trong, bên trong mỗi túi lại có 3-4 thanh bánh giòn rụm, ăn rất là ngon, ăn là ghiền. Cắn 1 miếng là muốn cắn thêm miếng nữa bởi cái vị đặc trưng của bánh dừa nướng nơi đây.\u003c/p\u003e\n\u003cp\u003eThành phần: Dừa, đường, bột nếp, Vani\u003c/p\u003e\n\u003cp\u003eTrọng lượng: 180g\u003c/p\u003e\n\u003cp\u003eHạn sử dụng: 12 tháng kể từ ngày sản xuất có in trên bao bì.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ce/1c/54/6690d5d5c62c40f58e42fc7994d45e00.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ce/1c/54/6690d5d5c62c40f58e42fc7994d45e00.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ce/1c/54/6690d5d5c62c40f58e42fc7994d45e00.jpg","