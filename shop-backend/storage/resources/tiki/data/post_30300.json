"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":27250,"discount_rate":25,"rating_average":1,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/33/52/ee/a45e98ca402ba20e95d6c92f31b4204f.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":295,"all_time_quantity_sold":5,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp class=\"irIKAp\"\u003eTHÔNG TIN TÁC PHẨM\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eTên tác phẩm: Hiên Nhà Chắn Hết Mưa Giông\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eTác giả: Chà và Lam\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eThể loại: Sách tô màu\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eThương hiệu: Time Books\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eNhà xuất bản: NXB Thế Giới\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eNăm xuất bản: 2023\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eMã ISBN: 978-604-77-8722-7\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eLoại bìa: Mềm\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eKhổ: 21 x 18 cm\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eSố trang: 116 trang\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e__________________________\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eGIỚI THIỆU TÁC GIẢ\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eChà và Lam là hai tác giả quen thuộc với các bạn trẻ cùng hai fanpage sở hữu hàng trăm nghìn lượt theo dõi. Đó là nơi các tác giả chia sẻ những câu chuyện dễ thương, gần gũi, những nỗi lòng sâu sắc và cả những bức tranh xinh đẹp, đậm chất riêng. “Hiên nhà chắn hết mưa giông” là cuốn sách kết hợp đầu tiên của cả hai, Chà góp tranh, Lam góp chữ, xây nên một chiếc hiên nhà chứa bao mưa nắng và những ký ức tuổi thơ.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e__________________________\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eGIỚI THIỆU TÁC PHẨM\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eHIÊN NHÀ CHẮN HẾT MƯA GIÔNG\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Ấn phẩm kết hợp đầu tiên của hai tác giả Chà và Lam\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Cuốn sách tô màu giúp chữa lành trái tim bạn\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Tấm vé đưa bạn trở lại miền ký ức bình yên\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e___\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eNhững niềm hạnh phúc bé xinh luôn ngập tràn quanh mình\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eCó lẽ bạn đã từng trải qua những ngày chẳng mấy “đẹp trời”: những câu chuyện không suôn sẻ, những cảm xúc tiêu cực, Tất cả như áng mây đen che lấp đi tâm hồn vốn ngập tràn sắc màu của chúng ta.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eNhưng bạn biết không?\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e“Hoa không thể vòng tay ôm lấy bạn, vì thế nó chọn cách bung nở nụ xinh. Cây xanh không thể cùng bạn gỡ những rối bời, vì thế nó mở rộng tán cây để che mát ngày nắng đổ. Tia nắng nhỏ bé nơi kia, vì muốn sưởi ấm cho bạn mà cố gắng xuyên qua bao tầng mây lớp lớp…”\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eĐó cũng chính là thông điệp yêu thương được gửi gắm qua cuốn sách “Hiên nhà chắn hết mưa giông” do hai tác giả Chà và Lam kết hợp thực hiện.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eCuốn sách là sự đan xen thú vị giữa những dòng tản văn ngắn đầy chữa lành và những bức tranh vô cùng đáng yêu. Qua từng trang sách, tác giả sẽ đưa bạn ghé thăm từng miền ký ức bình yên và trong trẻo nhất của mình, đặt lên tay bạn chiếc cọ xinh để bạn tha hồ tô điểm cuộc sống này bằng những gam màu mà bạn thích.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eHy vọng rằng, “Hiên nhà chắn hết mưa giông” sẽ là món quà tuyệt vời, giúp bạn xua tan đi “mây giông” trong “thế giới người lớn”, để mặt trời yêu thương được ló rạng và cầu vồng lại rực rỡ trong tim.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/33/52/ee/a45e98ca402ba20e95d6c92f31b4204f.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/33/52/ee/a45e98ca402ba20e95d6c92f31b4204f.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/33/52/ee/a45e98ca402ba20e95d6c92f31b4204f.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/33/52/ee/a45e98ca402ba20e95d6c92f31b4204f.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/33/52/ee/a45e98ca402ba20e95d6c92f31b4204f.png"},{"base_url":"https://salt.tikicdn.com/ts/product/64/0e/58/2a0918173bbdcda016c1f8301608efed.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/64/0e/58/2a0918173bbdcda016c1f8301608efed.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/64/0e/58/2a0918173bbdcda016c1f8301608efed.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/64/0e/58/2a0918173bbdcda016c1f8301