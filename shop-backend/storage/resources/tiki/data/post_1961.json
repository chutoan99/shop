 khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/01/c5/e4/c67611b896cb26cf62734e771ca8fe51.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/01/c5/e4/c67611b896cb26cf62734e771ca8fe51.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/01/c5/e4/c67611b896cb26cf62734e771ca8fe51.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/01/c5/e4/c67611b896cb26cf62734e771ca8fe51.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/01/c5/e4/c67611b896cb26cf62734e771ca8fe51.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/a6/e3/fe/e583b0120454526ae90814e9bfb28809.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a6/e3/fe/e583b0120454526ae90814e9bfb28809.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a6/e3/fe/e583b0120454526ae90814e9bfb28809.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a6/e3/fe/e583b0120454526ae90814e9bfb28809.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a6/e3/fe/e583b0120454526ae90814e9bfb28809.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/0a/3c/02/022b8115fb1ca8e64415c19b6a51e502.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0a/3c/02/022b8115fb1ca8e64415c19b6a51e502.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/0a/3c/02/022b8115fb1ca8e64415c19b6a51e502.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0a/3c/02/022b8115fb1ca8e64415c19b6a51e502.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0a/3c/02/022b8115fb1ca8e64415c19b6a51e502.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/e1/82/9e/42bb8c1cf54647b0aa8506f90e4113ff.jpg","is_gallery":true,"label":null,"large_url":"https