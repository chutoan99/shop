003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/18/98/70/5b81f6a934b651311bde0387f4b6b66b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/18/98/70/5b81f6a934b651311bde0387f4b6b66b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/18/98/70/5b81f6a934b651311bde0387f4b6b66b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/18/98/70/5b81f6a934b651311bde0387f4b6b66b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/18/98/70/5b81f6a934b651311bde0387f4b6b66b.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/1c/df/92/b55125fb258f8b4832f87d2f7ea67813.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/1c/df/92/b55125fb258f8b4832f87d2f7ea67813.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/1c/df/92/b55125fb258f8b4832f87d2f7ea67813.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1c/df/92/b55125fb258f8b4832f87d2f7ea67813.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1c/df/92/b55125fb258f8b4832f87d2f7ea67813.jpg"}],"warranty_policy":null,"brand":{"id":65122,"name":"Vinamilk","slug":"vinamilk"},"current_seller":{"id":81354,"sku":"5638461936800","name":"Cửa hàng G8","link":"https://tiki.vn/cua-hang/cua-hang-g8","logo":"26/0f/45/3165d68c27bb0ad37c2bcb23e7092449.jpg","price":124000,"product_id":"170161030","store_id":75754,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[{"id":103335,"name":"Shop Sữa Hà Phương","link":"https://tiki.vn/cua-hang/shop-sua-ha-phuong","logo":"f