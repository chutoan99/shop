f14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":17964,"discount_rate":4,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/47/f7/ab/73e15cfdc4720971794f1649f2861f28.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":820,"all_time_quantity_sold":143,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cdiv\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/product/89/34/2b/cfeb8c4e81c510979d459c2360bba96b.png\" alt=\"Bộ nồi anod SUNHOUSE SH6634 001\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003c/div\u003e\n\u003ch5\u003e\u003cstrong\u003eThiết kế tinh tế sang trọng, phù hợp với không gian bếp hiện đại\u003c/strong\u003e\u003c/h5\u003e\n\u003cp\u003eSản phẩm được làm từ hợp kim nhôm Anod cứng bằng công nghệ tiên tiến giúp sản phẩm có độ cứng và bền vững cao, chống ăn mòn, chịu được nhiệt độ cao cũng như khả năng chống dính tốt. Vỏ ngoài màu vàng nổi bật, chịu nhiệt tốt, không biến màu theo thời gian.\u003c/p\u003e\n\u003cdiv\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/product/6e/e2/8b/784340dca9d007b923a96ae13cac46d5.png\" alt=\"Bộ nồi anod SUNHOUSE SH6634 002\" width=\"750\" height=\"500\" /\u003e\u003c/div\u003e\n\u003cp\u003eĐược làm từ kính cường lực chịu nhiệt dày 5mm, bề mặt kính trong suốt thuận tiện cho việc đun nấu, cũng như quan sát thực phẩm mà không cần mở vùng nhiều lần. Viền bo bằng inox giúp vung nồi kín khít, hạn chế nứt vỡ nếu bị va chạm.\u003c/p\u003e\n\u003cdiv\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/product/21/84/eb/615590c49343c95e0237329d076a9e58.png\" alt=\"Bộ nồi anod SUNHOUSE SH6634 003\" width=\"750\" height=\"500\" /\u003e\u003c/div\u003e\n\u003cp\u003eNúm nhựa bắt vít, chống nóng tốt. Quai đinh tán, bọc nhựa cách nhiệt giúp cho người dùng dễ dàng nhấc nồi lên ngay cả  khi đang được đun nóng, thuận tiện hơn trong việc đun nấu.\u003c/p\u003e\n\u003cdiv\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/product/cd/87/18/693c958b66d75851bb9ec9f7fef5a6b2.png\" alt=\"Bộ nồi anod SUNHOUSE SH6634 004\" width=\"750\" height=\"500\" /\u003e\u003c/div\u003e\n\u003ch5\u003e\u003cstrong\u003eCông năng tuyệt vời, giúp việc nấu ăn trở nên đơn giản, nhanh gọn hơn\u003c/strong\u003e\u003c/h5\u003e\n\u003cp\u003eĐộ bền cứng cao: Bộ nồi Anod có độ bền cứng rất cao và khả năng chống mài mòn tối ưu, hạn chế trầy xước. Sản phẩm có thể dùng cho nhiều mục đích chế biến và không bị biến dạng nếu gặp tác động lực.\u003c/p\u003e\n\u003cdiv\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/product/89/34/2b/cfeb8c4e81c510979d459c2360bba96b.png\" alt=\"Bộ nồi anod SUNHOUSE SH6634 005\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp\u003eĐáy nồi phẳng rộng, hấp thụ nhiệt tốt, truyền nhiệt đều, nấu chín thức ăn nhanh hơn các loại nồi thông thường.\u003c/p\u003e\n\u003cp\u003eNồi Anod đã được xử lý oxy hóa nên tuyệt đối không có tình trạng thôi nhiễm vào thức ăn, an toàn cho sức khỏe. Nồi còn giúp giữ được hương vị tươi ngon của thức ăn trong thời gian tương đối.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/product/d1/d9/04/76b4115f3e707bea271968e401705e92.png\" alt=\"Bộ nồi anod SUNHOUSE SH6634 006\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp\u003eBộ gồm 3 nồi Anod với những kích cỡ phổ biến 16cm – 20cm – 24cm, đáp ứng nhiều mục đích sử dụng khác nhau trong gia đình (nồi nhỏ 16cm thích hợp để luộc trứng, kho thịt, nồi cỡ trung 20cm để nấu canh cho 3-4 người và nồi lớn 24cm có thể luộc gà, nấu canh hoặc lẩu cho 3-5 người).\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/product/6e/e2/8b/784340dca9d007b923a96ae13cac46d5.png\" alt=\"Bộ nồi anod SUNHOUSE SH6634 007\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp\u003eNồi dùng được trên bếp gas, bếp hồng ngoại, không dùng trên bếp từ.\u003c/p\u003e\n\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/47/f7/ab/73e15cfdc4720971794f1649f2861f28.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/47/f7/ab/73e15cfdc4720971794f1649f2861f28.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/47/f7/ab/73e15cfdc4720971794f1649f2861f28.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/47/f7/ab/73e15cfdc4720971794f1649f2861f28.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/47/f7/ab/73e15cfdc4720971794f1649f2861f28.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/06/db/ef/efb9c1d2325d2eb96340547942690e43.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/06/db/ef/efb9c1d2325d2eb96340547942690e43.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/06/db/ef/efb9c1d2325d2eb96340547942690e43.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/06/db/ef/efb9c1d2325d2eb96340547942690e43.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/06/db/ef/efb9c1d2325d2eb96340547942690e43.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/66/b5/7d/1632999a3427f39f6fdacedcb3e6cfa0.jpg","is_gallery":true