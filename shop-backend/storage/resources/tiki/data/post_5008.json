":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":520000,"discount_rate":37,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/9b/7b/b0/b6b8920e3e502cb8301ea1ddc9ef772d.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":641,"all_time_quantity_sold":13,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eCảm biến khói Aqara Zigbee 3.0 bản Quốc Tế - Thiết bị báo cháy, Gửi thông báo lên lên điện thoại, Tương thích HomeKit\u003c/p\u003e\n\u003cp\u003eLƯU Ý: Cảm biến khói Aqara này là phiên bản Zigbee, CẦN KẾT NỐI VÀO HUB AQARA MỚI CÓ THỂ CÀI ĐẶT LÊN ĐIỆN THOẠI VÀ XEM TRẠNG THÁI TỪ XA. CẢM BIẾN VẪN HOẠT ĐỘNG ĐỘC LẬP VÀ VẪN HÚ CÒI KHI CÓ KHÓI kể cả có kết nối hay không kết nối với Hub.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/34/0e/f0/b3cd617a6a22267e663540eff8c88048.png\" alt=\"\" width=\"655\" height=\"881\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/7a/28/71/1993f4b89be64419e2e98814a894dc57.png\" alt=\"\" width=\"750\" height=\"470\" /\u003e\u003c/p\u003e\n\u003cp\u003eCảm biến khói Aqara 2022 Zigbee 3.0 thông báo nhanh chóng với còi báo động tích hợp lên đến 85dB giúp bạn dù ở phòng khác, đang ngủ hay đang nghe nhạc lớn đều có thể nghe được. Ngoài ra, một đèn Led nhiều màu sắc được trang bị cùng sẽ nhấp nháy trong trường hợp có báo động.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/de/19/f9/270d56c25438b5f93c174f4fa5c8fe75.png\" alt=\"\" width=\"750\" height=\"741\" /\u003e\u003c/p\u003e\n\u003cp\u003eCảm biến khói Aqara 2022 Zigbee 3.0 được cài đặt thông báo đẩy từ xa, giúp bạn nhận được các cảnh báo quan trọng bất kể bạn đnag ở nhà hay đi vắng.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/0c/3a/fb/458860e8badc01f836708d8f4ca3329a.png\" alt=\"\" width=\"750\" height=\"707\" /\u003e\u003c/p\u003e\n\u003cp\u003eCảm biến khói Aqara 2022 Zigbee 3.0 có thể đạt tuổi thọ pin lên đến 10 năm, thời lượng pin trâu hơn so với các phiên bản sử dụng WIFI hay Bluetooth. Thực tế thì Cảm biến khói Aqara 2022 Zigbee 3.0 chỉ tiêu hao năng lượng khi nó báo động và hoàn toàn không tiêu hao năng lượng ở chế độ chờ.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/c9/6f/fb/8d9601b2c291c680364524abc623b793.png\" alt=\"\" width=\"750\" height=\"451\" /\u003e\u003c/p\u003e\n\u003cp\u003eBạn có thể tắt còi báo động của Cảm biến khói Aqara 2022 Zigbee 3.0 một cách dễ dàng chỉ với một nút nhấn hoặc hiển thị cử chỉ \"OK\" với Camera Hub G3.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/09/f9/b5/9d66e0bc3fcd0c76ffd664378234bec7.png\" alt=\"\" width=\"750\" height=\"729\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/79/36/af/2c28ad4710f0e1a37a1a5db62b7968bd.png\" alt=\"\" width=\"750\" height=\"528\" /\u003e\u003c/p\u003e\n\u003cp\u003eBạn có thể dễ dàng tự lắp đặt Cảm biến khói Aqara 2022 Zigbee 3.0 này bằng 2 cách dán hoặc bắt vít lên trần. Rất đơn giản, bạn chỉ cần dán/bắt vít phần đế của cảm biến khói Aqara lên trần nhà, sau đó gắn phần còn lại của cảm biến khói aqara lên là đã có thể sử dụng.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/9b/7b/b0/b6b8920e3e502cb8301ea1ddc9ef772d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/9b/7b/b0/b6b8920e3e502cb8301ea1ddc9ef772d.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/9b/7b/b0/b6b8920e3e502cb8301ea1ddc9ef772d.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9b/7b/b0/b6b8920e3e502cb8301ea1ddc9ef772d.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9b/7b/b0/b6b8920e3e502cb8301ea1ddc9ef772d.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/01/ac/84/19c42b79ad4e5ff5d613a44680e730b2.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/01/ac/84/19c42b79ad4e5ff5d613a44680e730b2.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/01/ac/84/19c42b79ad4e5ff5d613a44680e730b2.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/01/ac/84/19c42b79ad4e5ff5d613a44680e730b2.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/01/ac/84/19c42b79ad4e5ff5d613a44680e730b2.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/b5/86/24/037b2ba1993748626aa3c9003461373b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b5/86/24/037b2ba1993748626aa3c9003461373b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b5/86/24/037b2ba1993748626aa3c9003461373b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b5/86/24/037b2ba1993748626aa3c9003461373b.jpg","thumbnail_url":"https://sal