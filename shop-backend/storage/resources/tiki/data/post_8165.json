_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/1a/00/4e/cd85370c655ca357d6e346a3a2de8a8c.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1198,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003chtml\u003e\n \u003chead\u003e\u003c/head\u003e\n \u003cbody\u003e\n  \u003cul\u003e\n   \u003cp\u003eHộp đồ dụng cụ sửa chữa cơ khí Toys House 008-916 dành cho bé là món quà có ý nghĩa và bổ ích mà bố mẹ dành tặng cho con yêu của mình. Với nhiều thiết bị, dụng cụ sửa chữa kỹ thuật y như thật, bé sẽ thỏa thích chơi trò đóng vai kỹ sư cùng bạn bè sửa chữa các vật dụng. Thông qua quá trình chơi, tư duy logic và trí tưởng tượng của bé sẽ được kích thích phát triển, cũng nhờ thế, bé sẽ trở nên tự tin và trưởng thành hơn.\u003c/p\u003e\n   \u003cp\u003eĐặc điểm sản phẩm\u003c/p\u003e\n   \u003cp\u003eHộp đồ dụng cụ sửa chữa cơ khí 008-916 cho bé được mô phỏng và trang bị đầy đủ các dụng cụ sửa chữa trong nhà thật giống như của bố.\u003c/p\u003e\n   \u003cp\u003eTăng cường khả năng phối hợp giữa tay và mắt, sử dụng linh hoạt các giác quan.\u003c/p\u003e\n   \u003cp\u003eHộp đồ dụng cụ sửa chữa cơ khí 008-916 cho bé được thiết kế nhỏ gọn, dễ dàng di chuyển trong nhà và thuận tiện trong việc cất giữ.\u003c/p\u003e\n   \u003cp\u003eKhi chơi đóng vai thợ cơ khí, bé sẽ phát huy trí tưởng tượng, óc sáng tạo của mình, phát triển khả năng tư duy nhiều hơn.\u003c/p\u003e\n   \u003cp\u003eChất liệu an toàn:\u003c/p\u003e\n   \u003cp\u003eHộp đồ dụng cụ sửa chữa cơ khí 008-916 cho bé được làm từ chất liệu nhựa cao cấp, không chứa BPA và các thành phần độc hại nên tuyệt đối an toàn với sức khỏe của bé.\u003c/p\u003e\n   \u003cp\u003eBề mặt Hộp đồ dụng cụ sửa chữa cơ khí 008-916 cho bé trơn tru láng mịn không có các cạnh vi ba sắc nhọn không làm trầy xước làn da nhạy cảm của bé.\u003c/p\u003e\n   \u003cp\u003eChất liệu nhựa bền đẹp theo thời gian sử dụng, giúp bố mẹ tiết kiệm tối đa chi phí.\u003c/p\u003e\n   \u003cp\u003eThông tin chi tiết:\u003c/p\u003e\n   \u003cp\u003eKích thước: 270x210x100mm\u003c/p\u003e\n   \u003cp\u003eĐồ chơi cho bé từ 1- 2 tuổi trở lên.\u003c/p\u003e\n   \u003cp\u003eBộ đồ chơi sửa chữa có 19 chi tiết: búa, kìm, tua vít, cờ lê, thước góc …\u003c/p\u003e\n  \u003c/ul\u003e\n \u003c/body\u003e\n\u003c/html\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/1a/00/4e/cd85370c655ca357d6e346a3a2de8a8c.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/1a/00/4e/cd85370c655ca357d6e346a3a2de8a8c.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/1a/00/4e/cd85370c655ca357d6e346a3a2de8a8c.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1a/00/4e/cd85370c655ca357d6e346a3a2de8a8c.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1a/00/4e/cd85370c655ca357d6e346a3a2de8a8c.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/86/d5/92/8e4ce92f2b71c5b393f0c1e22a018d48.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/86/d5/92/8e4ce92f2b71c5b393f0c1e22a018d48