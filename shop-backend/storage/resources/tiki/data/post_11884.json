con_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":20000,"discount_rate":11,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/76/5a/f5/19fc2ce77ed6ec9a07b4ccc4f2296fbb.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":95,"all_time_quantity_sold":3,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<div class=\"dac-diem-thong-so\">\n<div class=\"dac-diem\">\n<h3 style=\"text-align:center;\"><strong>Túi chống nước Sakos Orcas</strong></h3>\n<p>Túi chống nước Sakos Orcas có khả năng chống thấm khi nước bắn vào. Phù hợp để đi dưới mưa, dã ngoại, trekking, leo núi, chèo thuyền kayak, chèo ván đứng, chèo thuyền nhẹ, đi công viên nước, đi dưới điều kiện thời tiết ẩm ướt hoặc các hoạt động ngoài trời, thám hiểm sông suối. Túi có dây dễ điều chỉnh, dễ dàng gấp gọn mang theo.</p>\n<p><strong>ĐẶC ĐIỂM NỔI BẬT</strong></p>\n<ul>\n<li>Chống thấm nước.</li>\n<li>Dễ sử dụng và bảo quản.</li>\n<li>Chất liệu Tarpaulin chống mài mòn cực tốt, có độ bền cao.</li>\n<li>Thể tích lớn, phù hợp để đựng đồ đạc cho các chuyến đi cả ngày.</li>\n</ul>\n</div>\n<div class=\"thong-so\">\n<p><strong>THÔNG SỐ KỸ THUẬT</strong></p>\n<table>\n<tbody>\n<tr>\n<td><strong>Dung tích:</strong></td>\n<td><strong>2L</strong></td>\n<td><strong>5L</strong></td>\n<td><strong>10L</strong></td>\n<td><strong>20L</strong></td>\n</tr>\n<tr>\n<td><strong>Kích thước:</strong></td>\n<td>14 x 32.5 cm</td>\n<td>15.5 x 44 cm</td>\n<td>21 x 46.5 cm</td>\n<td>23.5 x 63.5 cm</td>\n</tr>\n<tr>\n<td><strong>Khối lượng:</strong></td>\n<td>0.2 kg</td>\n<td>0.2 kg</td>\n<td>0.3 kg</td>\n<td>0.4 kg</td>\n</tr>\n<tr>\n<td><strong>Chất liệu:</strong></td>\n<td colspan=\"4\">Tarpaulin</td>\n</tr>\n<tr>\n<td><strong>Màu sắc:</strong></td>\n<td colspan=\"4\">Xanh dương, Xám</td>\n</tr>\n<tr>\n<td><strong>Bảo hành:</strong></td>\n<td colspan=\"4\">01 năm</td>\n</tr>\n</tbody>\n</table>\n</div>\n</div>\n<h4><strong>Khả năng chống nước tuyệt đối</strong></h4>\n<p><img class=\"wp-image-34925 alignleft\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/1e/0a/98/ae487347317510557c2b607d04412870.png\" alt=\"\" width=\"580\" height=\"580\" /><img class=\"alignnone wp-image-34926\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/9d/80/86/bcad6a992f074c64581f1e856d55960b.png\" alt=\"\" width=\"580\" height=\"580\" /></p>\n<p>Túi chống nước Sakos Orcas có khả năng chống nước hoàn hảo, đa dạng kích thước và màu sắc năng động, cá tính, sẽ giúp bạn cất giữ quần áo, đồ điện tử, máy ảnh, điện thoại và đồ cá nhân luôn khô ráo và an toàn. Không chỉ vậy, túi chống nước có thể sử dụng như một túi chứa các đồ dùng đi dã ngoại, cắm trại của hội bạn bè vào dịp cuối tuần, ngày lễ.</p>\n<ul>\n<li>Khóa miệng túi cứng cáp, chắc chắn trong suốt quá trình sử dụng.</li>\n<li>Sử dụng chất liệu cao cấp và công nghệ hàn tần số cao mới giúp đảm bảo chiếc túi chắc chắn, chống nước tối đa.</li>\n<li>Thiết kế đơn giản, gọn nhẹ, dễ sử dụng và dễ dàng mang theo.</li>\n<li>Túi có thể gấp gọn, tiện cất giữ và sử dụng trong thời gian dài.</li>\n<li>Túi 5L và 10L có thể đặt bên trong túi chống nước hoặc túi du lịch chống nước có dung tích 30L để tăng gấp đôi khả năng chống nước và để tách riêng đồ vật.</li>\n<li>Có thể xách tay, đeo chéo, đeo sau lưng theo kiểu balo với túi có dung tích 20 L.</li>\n<li>Dây đeo vai được gia cố chắc chắn. Khóa nhựa chống va đập tốt.</li>\n</ul>\n<h4><strong>Nhanh chóng biến thành chiếc phao bơi khi cần thiết</strong></h4>\n<p>Đáng chú ý, nhờ thiết kế đặc biệt, túi chống nước Sakos Orcas có thể sử dụng như một chiếc phao bơi an toàn khi cần thiết, thích hợp khi tham gia các môn thể thao dưới nước (Lưu ý: chỉ nên dùng tính năng này ở các vùng nước cạn và gần bờ).</p>\n<p><img class=\"wp-image-34909 alignleft\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/d1/e5/e2/992e31d9830034d6120fd86ce686854c.png\" alt=\"Túi chống nước đi biển Sakos Orcas 10L xanh dương\" width=\"580\" height=\"580\" /><img class=\"alignnone wp-image-34915\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/30/54/9a/863795d6dcb72e3b57a70ba7b69464b9.png\" alt=\"Túi chống nước đi biển Sakos Orcas 10L xanh dương\" width=\"580\" height=\"580\" /></p>\n<h4><strong>Bảo vệ “kép” cho các thiết bị điện tử</strong></h4>\n<p>Nên để các vật dụng và thiết bị điện tử vào túi zip/bao chống nước khi tham gia các môn thể thao dưới nước. Các camera có thể đặt trong túi khô nhỏ và để vào túi chống nước lớn Sakos Orcas có dung tích từ 20 L.</p>\n<h4><strong>Hướng dẫn khóa túi để đảm bảo khả năng chống nước tuyệt đối</strong></h4>\n<p><img class=\"alignleft wp-image-34914\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/7b/08/9d/4e2ffaf89b0381c591c5fcab22f41fa4.png\" alt=\"Túi chống nước đi biển Sakos Orcas 10L xanh dương\" width=\"580\" height=\"580\" /><img class=\"alignnone wp-image-34889\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/45/93/27/2bdbc032ae01c3ab5a6a0335f9f987b0.png\" alt=\"Túi chống nước đi biển Sakos Orcas 5L xanh dương\" width=\"580\" height=\"580\" /></p>\n<ol>\n<li>Cuộn miệng túi xuống tối thiểu 3 vòng và siết chặt các nếp gấp.</li>\n<li>Gài khóa ở hai bên.</li>\n<li>Gài khóa ở giữa. Để lại một ít không khí trong túi. Sau khi đóng lại, túi phải phồng lên: Điều này giúp túi kín nước hơn và sẽ nổi lên nếu rơi xuống nước.</li>\n</ol>\n<p>Với thiết kế thông tin, bạn thao tác đóng mở chiếc túi chống nước Sakos Orcas nhanh chóng hơn, chỉ khoảng 15 giây.</p>\n<h4><strong>Hướng dẫn bảo quản</strong></h4>\n<ul>\n<li>Rửa bằng nước sạch và để ráo nước trước khi bảo quản trong thời gian dài.</li>\n<li>Không giặt khô. Không sấy.</li>\n<li>Không ủi.</li>\n<li>Không dùng chất tẩy.</li>\n<li>Không ngâm túi hoặc nhấn chìm túi trong nước trong dời gian dài.</li>\n</ul><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/76/5a/f5/19fc2ce77ed6ec9a07b4ccc4f2296fbb.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/76/5a/f5/19fc2ce77ed6ec9a07b4ccc4f2296fbb.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/76/5a/f5/19fc2ce77ed6ec9a07b4ccc4f2296fbb.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/76/5a/f5/19fc2ce77ed6ec9a07b4ccc4f2296fbb.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/76/5a/f5/19fc2ce77ed6ec9a07b4ccc4f2296fbb.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/69/5c/9e/14cbfaa1db38bf1b5a52e2f8291610b5.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/69/5c/9e/14cbfaa1db38bf1b5a52e2f8291610b5.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/69/5c/9e/14cbfaa1db38bf1b5a52e2f8291610b5.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/69/5c/9e/14cbfaa1db38bf1b5a52e2f8291610b5.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/69/5c/9e/14cbfaa1db38bf1b5a52e2f8291610b5.jpg"},{"base_url":"https://sa