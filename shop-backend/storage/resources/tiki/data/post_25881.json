ing_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/88/4f/fb/07f68b1667efe000c02fcf18bb3ed810.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1111,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2\u003e\u003cstrong\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/7f/af/e0/5ba7506e564d4662ebe36cb5394e30d2.jpg\" alt=\"\" width=\"750\" height=\"500\" /\u003e\u003c/strong\u003e\u003c/h2\u003e\n\u003ch2 style=\"text-align:center;\"\u003e\u003cstrong\u003eTHÔNG TIN CHI TIẾT SẢN PHẨM\u003c/strong\u003e\u003c/h2\u003e\n\u003ctable\u003e\u003ctbody\u003e\u003ctr\u003e\u003ctd\u003e\n\u003cp\u003e\u003cstrong\u003eTên sản phẩm\u003c/strong\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003cp\u003eBộ bình trà Long Phương có kê ấm, kê chén \u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003e\n\u003cp\u003e\u003cstrong\u003eTên thương hiệu\u003c/strong\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003cp\u003eLONG PHUONG\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003e\n\u003cp\u003e\u003cstrong\u003eMàu sắc\u003c/strong\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003eTrắng\u003c/td\u003e\n\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003e\u003cstrong\u003ePhù hợp cho\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e\n\u003cp\u003eGia đình/Tiệc/ nhà hàng \u0026amp; Khách sạn/ Ngoài trời/Tiệc cưới \u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\u003c/tbody\u003e\u003c/table\u003e\u003cp\u003eSản phẩm bộ bình trà 6 chén sứ có đĩa kê của Long Phương \u003c/p\u003e\n\u003cul\u003e\u003cli\u003eKhả năng chịu va đập mạnh\u003c/li\u003e\n\u003cli\u003eChất sứ đanh- bền\u003c/li\u003e\n\u003cli\u003eMàu sắc tinh tế\u003c/li\u003e\n\u003cli\u003eKiểu dáng sang trọng\u003c/li\u003e\n\u003cli\u003eBề mặt sản phẩm sáng, bóng nhắn\u003c/li\u003e\n\u003cli\u003eKhả năng chịu sốc nhiệt cao vì được nung ở lò tuynel với nhiệt độ 1380 độ C\u003c/li\u003e\n\u003cli\u003eSử dụng tốt trong lò vi sóng, máy rửa bát\u003c/li\u003e\n\u003cli\u003eSản phẩm được nung ở 1380 độ C nên đã loại bỏ được hết chì và các chất độc hại có trong đất\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eBộ sản phẩm gồm: \u003c/p\u003e\n\u003cul\u003e\u003cli\u003e1 ấm bầu 2 (500ml)\u003c/li\u003e\n\u003cli\u003e1 đĩa kê ấm (đĩa cà phê 3 trắng)\u003c/li\u003e\n\u003cli\u003e6 chén sô 5 (70 ml)\u003c/li\u003e\n\u003cli\u003e6 đĩa kê chén\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eĐể tạo ra được một sản phẩm sứ trắng chất lượng, những người thợ phải suy nghĩ và khéo léo tạo hình trong suốt thời gian dài từ quá trình hình thành ý tưởng, thử nghiệm, hoàn thiện, bổ sung lại tiếp tục hoàn thiện rồi mới cho ra sản phẩm cuối cùng bán ra thị trường. \u003c/p\u003e\n\u003cp\u003eBộ ấm chén uống trà bầu 2 trắng là sản phẩm phù hợp với mọi bàn trà của gia đình Việt. Sản phẩm hội tụ được nét tinh xảo của bàn tay người thợ, tạo ra những sản phẩm cũng tinh xảo vạn phần khiến cho ai cũng phải mê mẩn mỗi khi được chiêm ngưỡng.\u003c/p\u003e\n\u003cp\u003ePhương châm của Sứ Long Phương là \"mang lại vẻ đẹp hoàn mỹ trong từng sản phẩm, mỗi sản phẩm dù lớn hay nhỏ đều là kết tinh của tinh hoa, trí tuệ và công sức\".\u003c/p\u003e\n\u003ch2 style=\"text-align:center;\"\u003e\u003cstrong\u003eMỘT SỐ HÌNH ẢNH SẢN PHẨM \u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/7f/af/e0/6e23e46a881e75db4c0a82df6b1f5596.jpg\" alt=\"\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/78/61/f7/10650355c9d3e5b953d85e48b9229fe1.jpg\" alt=\"\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/27/ac/56/6bef1fc7fdcbde27aedcf4064f76db47.jpg\" alt=\"\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/fb/ba/ba/7a4da7c9be1448df673dbbcbf8f9ed75.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/e3/fd/1d/9d9b4954c59807fd2d84f8aefe965283.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch2 style=\"text-align:center;\"\u003e\u003cstrong\u003eMỘT SỐ GIẢI THƯỞNG CỦA CHÚNG TÔI\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/bc/6b/f6/8cf3ff8a38dc59e1ecddff2a21cba665.jpg\" alt=\"\" width=\"750\" height=\"458\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/88/4f/fb/07f68b1667efe000c02fcf18bb3ed810.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/88/4f/fb/07f68b1667efe000c02fcf18bb3ed810.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/88/4f/fb/07f68b1667efe000c02fcf18bb3ed810.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/88/4f/fb/07f68b1667efe000c02fcf18bb3ed810.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/88/4f/fb/07f68b1667efe000c02fcf18bb3ed810.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/73/ff/b8/8fe792757ff62e5a8c17a65fa1e0c960.jpg","is_gallery":true,"label":null,"large_url":"https://sa