,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":39000,"discount_rate":3,"rating_average":3,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/d0/4b/fa/b148c715c91018e54a511a5e70e70f24.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":734,"all_time_quantity_sold":10,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eBộ phát Wifi di động PROLiNK DL7203E dùng SIM 4G LTE 150Mbps, pin 5200mAH lên tới 25h, TFT 1.44\", cổng RJ45, USB 2.0 - Hàng chính hãng\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/23b309201148d54844ea7cd91f7a2bbb\" alt=\"23b309201148d54844ea7cd91f7a2bbb\" width=\"750\" height=\"299\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e️ Tận hưởng truy cập Internet không dây tốc độ cao khi đang di chuyển với bộ phát Wi-Fi di động này. PROLiNK DL7203E cung cấp cho bạn kết nối Internet tốc độ cao, không bị gián đoạn và kết nối lên đến 300Mbps cả ngày với dung lượng pin dài gấp 2 lần so với phiên bản cũ. \u003c/p\u003e\n\u003cp\u003e️ Wi-Fi di động này giúp việc chia sẻ trở nên dễ dàng hơn - nó cho phép bạn chia sẻ quyền truy cập Internet trên nhiều thiết bị và với thẻ nhớ microSD; nó cho phép bạn chia sẻ ảnh, nhạc, video và nhiều thứ khác qua mạng không dây.\u003c/p\u003e\n\u003cp\u003e️ Với tốc độ Wi-Fi lên đến 300Mbps, bạn có thể truy cập vào thế giới kết nối tốc độ cao khi bạn ở ngoài và di chuyển. Tải video HD nhanh chóng, tải tệp xuống nhanh và giữ cuộc gọi điện video mà không cần kết thúc cuộc gọi.\u003c/p\u003e\n\u003cp\u003e️ Trang bị cổng RJ45 LAN/WAN cho kết nối ổn định và nhanh hơn.\u003c/p\u003e\n\u003cp\u003e️ Dung lượng pin lớn không chỉ duy trì hoạt động cho thiết bị suốt cả ngày lên đến 25 giờ sử dụng mà còn có thể được sử dụng để sạc cho các thiết bị di động khác khi cần.\u003c/p\u003e\n\u003cp\u003e️ Quan sát tuổi thọ pin hiện tại, cường độ kết nối mạng, sử dụng dữ liệu di động, nhà cung cấp mạng và hơn thế nữa, tất cả từ màn hình chỉ báo LCD trực quan.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/f6b3ef0419262c780bbb8f30d84d6a49\" alt=\"f6b3ef0419262c780bbb8f30d84d6a49\" width=\"750\" height=\"299\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/dcda144c724f3c3f524adddff2c8aedb\" alt=\"dcda144c724f3c3f524adddff2c8aedb\" width=\"750\" height=\"299\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/4bbbc3b67a1c21192e9f91a394a74565\" alt=\"4bbbc3b67a1c21192e9f91a394a74565\" width=\"750\" height=\"299\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/b52b7465cffba69092039889691ca956\" alt=\"b52b7465cffba69092039889691ca956\" width=\"750\" height=\"299\" /\u003e\u003c/p\u003e\n\u003cp\u003eTHÔNG SỐ KỸ THUẬT:\u003c/p\u003e\n\u003cp\u003e+ Pin: 5200mAH (thời gian sử dụng lên đến 25 giờ).\u003c/p\u003e\n\u003cp\u003e+ Nguồn USB: 5V/1A.\u003c/p\u003e\n\u003cp\u003e+ Kết nối: USB 2.0, Wifi, RJ45\u003c/p\u003e\n\u003cp\u003e+ Nút bấm: nguồn, reset, WPL.\u003c/p\u003e\n\u003cp\u003e+ Ethernet: 10/100Mbps 1 x LAN/WAN.\u003c/p\u003e\n\u003cp\u003e+ Khe cắm sim: Micro SIM 3FF.\u003c/p\u003e\n\u003cp\u003e+ Kích thước màn hình: 1.44” TFT 128 x 128.\u003c/p\u003e\n\u003cp\u003e+ Băng tần LTE: B1/3/5/7/8/20/38/40/41.\u003c/p\u003e\n\u003cp\u003e+ Băng tần UMTS: B1/5/8.\u003c/p\u003e\n\u003cp\u003e+ Tốc độ LTE: CAT4, 150Mbps DL, 50Mbps UL.\u003c/p\u003e\n\u003cp\u003e+ Ăng-ten LTE: tích hợp (2 x 2).\u003c/p\u003e\n\u003cp\u003e+ Truy cập tối đa: 16 thiết bị.\u003c/p\u003e\n\u003cp\u003e+ Tiêu chuẩn: 802.11b/g/n.\u003c/p\u003e\n\u003cp\u003e+ Bảo mật Wifi: Mở \u0026amp; WPA-PSK \u0026amp; WPA2-PSK \u0026amp; WPA-PSK/ WPA2-PSK.\u003c/p\u003e\n\u003cp\u003e+ Ăng-ten Wifi: bên trong.\u003c/p\u003e\n\u003cp\u003e+ Tốc độ Wifi: lên đến 300Mbps.\u003c/p\u003e\n\u003cp\u003e+ Tần số Wifi: 2.4Ghz.\u003c/p\u003e\n\u003cp\u003e+ Công suất ra: tối đa 20dBm.\u003c/p\u003e\n\u003cp\u003e+ Kích thước: 100 x 60 x 23mm (Dài x rộng x cao).\u003c/p\u003e\n\u003cp\u003e+ Trọng lượng: 161g.\u003c/p\u003e\n\u003cp\u003e+ Hệ điều hành được hỗ trợ:\u003c/p\u003e\n\u003cp\u003e    - Windows 10 trở lên, Windows 8, Windows 7.\u003c/p\u003e\n\u003cp\u003e    - Mac OS X 10.10 trở lên.\u003c/p\u003e\n\u003cp\u003e    - Linux 2.6+.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eBAO GỒM:\u003c/p\u003e\n\u003cp\u003e+ 1 x Prolink DL-7203E Wi-Fi di động 4G LTE.\u003c/p\u003e\n\u003cp\u003e+ 1 x Cáp sạc USB.\u003c/p\u003e\n\u003cp\u003e+ 1 x Hướng dẫn cài đặt nhanh (QIG).\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eCHỨNG NHẬN:\u003c/p\u003e\n\u003cp\u003e+ CE.\u003c/p\u003e\n\u003cp\u003eCAM KẾT \u0026amp; BẢO HÀNH:\u003c/p\u003e\n\u003cp\u003e+ 100% sản phẩm chính hãng PROLiNK.\u003c/p\u003e\n\u003cp\u003e+ Bảo hành chính hãng trong vòng 12 tháng.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/d0/4b/fa/b148c715c91018e54a511a5e70e70f24.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d0/4b/fa/b148c715c91018e54a511a5e70e70f24.jpg","medium_url":"https://salt.tikicdn.com/cache/w300