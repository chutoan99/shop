596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":411000,"discount_rate":28,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/85/1e/2a/617b6b89d22bd129ce1c9c16c5d10364.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":860,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<h3><strong>MÔ TẢ SẢN PHẨM</strong></h3>\n<h3><strong>1. Ưu điểm của Nồi Cơm Điện Sharp KS-COM100DV-RD:</strong></h3>\n<ul><li>Thiết kế tiện lợi, nhỏ gọn</li>\n<li>Các chức năng hiện đại, dễ sử dụng</li>\n<li>Giữ ấm lâu, tiết kiệm điện</li>\n</ul><h3><strong>2. Mô tả chi tiết Nồi Cơm Điện Sharp KS-COM100DV-RD:</strong></h3>\n<p><strong><a>Nồi cơm điện</a> </strong></p>\n<p> </p>\n<div>\n<div>\n<div>\n<div> </div>\n<div>\n<div><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/7d/ae/8e/ac0a5b4d24353b75dd4c7626f454be14.png\" alt=\"7dae8eb9b0a59f09f73dab69e436d309.png\"></div>\n</div>\n</div>\n</div>\n</div>\n<p> </p>\n<p> </p>\n<p>Công suất nấu 600W cùng công nghệ nấu cao tần IH sử dụng từ trường làm nóng không qua mâm nhiệt giúp cho cơm, món ăn được chế biến nhanh, chín đều, hạt cơm xốp dẻo, tiết kiệm điện năng tối đa cho gia đình.</p>\n<p> </p>\n<div>\n<div>\n<div>\n<div> </div>\n<div>\n<div><img src=\"https://salt.tikicdn.com/ts/product/9e/81/6e/911dadfca9c9239b0079443e1d2cb053.jpg\" alt=\"9e816ef4dbc4f6ddd351e7037a7f0b24.jpg\"></div>\n</div>\n</div>\n</div>\n</div>\n<p> </p>\n<p>Lòng nồi dày 2.867 mm, cấu tạo bởi 7 lớp, phủ chống dính có độ bền cao, nấu không lo cháy dính, giúp hạt cơm giữ được vị ngọt và chín đều.</p>\n<p> </p>\n<div>\n<div>\n<div>\n<div> </div>\n<div>\n<div><img src=\"https://salt.tikicdn.com/ts/product/ca/0b/a7/3a392d9e55de1bf0018ed55659f53a1c.jpg\" alt=\"ca0ba7b81567c1cfcf96f2b9dcb7e5e4.jpg\"></div>\n</div>\n</div>\n</div>\n</div>\n<p> </p>\n<p><strong>Van thoát hơi thông minh cùng nắp trong dạng tổ ong giúp hạn chế nhão cơm và giữ chất dinh dưỡng hiệu quả</strong></p>\n<p><strong>Dây điện có thể tháo rời giúp bảo quản, cất giữ sản phẩm gọn gàng, dễ dàng hơn</strong></p>\n<p>Nồi cơm điện Sharp KS-COM100DV-RD 1 lít có kiểu dáng hiện đại, chất lượng tốt, đa chức năng sẽ là thiết bị nấu nướng phục vụ đắc lực cho các gia đình yêu thích sự tiện ích.</p>\n<p>#Sharp<br>#Nồi_cơm_điện_Sharp<br>#Nồi_cơm_điện_Sharp_KS_COM100DV_RD<br>#Noicomdiensharp<br>#Bảo_hành_12_tháng<br>#Hàng_gia_dụng</p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/85/1e/2a/617b6b89d22bd129ce1c9c16c5d10364.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/85/1e/2a/617b6b89d22bd129ce1c9c16c5d10364.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/85/1e/2a/617b6b89d22bd129ce1c9c16c5d10364.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/85/1e/2a/617b6b89d22bd129ce1c9c16c5d10364.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/85/1e/2a/617b6b89d22bd129ce1c9c16c5d10364.png"},{"base_url":"https://salt.tikicdn.com/ts/product/69/4f/f3/62dbf9c3e041c2f499e57b15b22d088e.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/69/4f/f3/62dbf9