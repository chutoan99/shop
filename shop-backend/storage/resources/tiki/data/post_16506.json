":0,"rating_average":4.3,"review_count":20,"review_text":"(20)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/4f/fd/0a/77e962c4f28be2be47bd0e6e7c13b231.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1889,"all_time_quantity_sold":74,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: justify;\"\u003eBộ chia tẩu ra 2 cổng usb và 2 cổng tẩu thuộc hãng Huyndai thương hiệu nổi tiếng trên thị trường. Sản phẩm chính hãng Huyndai giúp bạn yên tâm về chất lượng đảm bảo an toàn cho thiết bị điện cũng như chiếc xe của bạn.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/65/57/53/ef2e4986ab76f8b902324214a16a324a.jpg\" alt=\"\" width=\"750\" height=\"608\" /\u003e\u003c/p\u003e\n\u003cp\u003eVì đây là một sản phẩm đa năng nên bạn sẽ thấy nó sẽ có rất nhiều công dụng, \u003cem\u003e\u003cstrong\u003etẩu sạc\u003c/strong\u003e\u003c/em\u003e có 2 cổng USB (5V 2.1A), nên bạn có thể sạc 2 thiết bị cùng một lúc, và MỘT MÀN HÌNH LED để hiển thị các thông số điện áp để từ đó có thể lưạ chọn các sợi dây cáp sao cho phù hợp với thiết bị của mình nhất.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/4f/fd/0a/e6e2f4aee122c81973bf2acf705a8b05.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eThiết kế giúp cho sản phẩm trở nên nổi bât và không làm sản phẩm quá đơn giản nhàm chán. Các vị trí tiếp điểm ở phía dưới và 2 bên được mạ một lớp kim loại chống oxy hóa, giúp cho sản phẩm luôn hoạt động tốt, bển bỉ với những tác động từ môi trường.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/9f/72/5e/bbac83fe6e662b107f2d7d142a6792fb.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/4f/fd/0a/105c8055b6a01414484ba0ec98719115.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eSạc vẫn được trang bị công nghệ an toàn như mạch bảo vệ quá dòng, quá áp, vì thế nó giúp rút ngắn thời gian sạc và đảm bảo an toàn cho các thiết bị và cả hệ thống điên trên xe.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/40/9d/b8/ed78972061224f49e2bc01643cae38b9.jpg\" alt=\"\" width=\"750\" height=\"577\" /\u003e\u003c/p\u003e\n\u003cp\u003eSản phẩm \u003cem\u003e\u003cstrong\u003ebộ chia tẩu sạc\u003c/strong\u003e\u003c/em\u003e này có thể sạc cho hầu hết các thiết bị điện thoại và tablet hiện nay nhờ cung cấp dòng ra lớn, cho phép tăng nhanh tốc độ sạc. Ngoài ra sạc cũng được trang bị nhiều công nghệ an toàn giúp bao vệ thiết bị. Vì thế người dùng có thể yên tâm khi sử dụng sạc để kết nối với các thiết bị.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/a7/40/98/6145e56de525da1c0ef7552d1ac90c73.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/37/b3/4e/202ac8d871ff8c5322c8fd9cafdbfe90.jpg\" alt=\"\" width=\"720\" height=\"720\" /\u003e\u003c/p\u003e\n\u003cdiv id=\"gioi-thieu\" class=\"content js-content expand\" style=\"box-sizing: border-box; overflow: hidden; margin-bottom: 15px; max-height: none; line-height: 21px; color: #333333; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e\n\u003cp style=\"margin: 0px; padding: 8px 0px; font-size: 14px; color: #000000; font-family: Roboto, -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif; text-align: start; white-space: pre-wrap;\"\u003e\u003cspan style=\"margin: 0px; padding: 0px; font-weight: bolder;\"\u003eĐặc điểm nổi bật \u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"margin: 0px; padding: 8px 0px; font-size: 14px; color: #000000; font-family: Roboto, -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif; text-align: start; white-space: pre-wrap;\"\u003e- Sản phẩm chia ra 2 tẩu và 2 cổng sạc USB.\u003c/p\u003e\n\u003cp style=\"margin: 0px; padding: 8px 0px; font-size: 14px; color: #000000; font-family: Roboto, -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif; text-align: start; white-space: pre-wrap;\"\u003e- Hỗ trợ sạc nhanh bảo vệ thông minh quá dòng và quá nhiệt.\u003c/p\u003e\n\u003cp style=\"margin: 0px; padding: 8px 0px; font-size: 14px; color: #000000; font-family: Roboto, -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif; text-align: start; white-space: pre-wrap;\"\u003e- Có màn hình hiển thị điện áp.\u003c/p\u003e\n\u003cp style=\"margin: 0px; padding: 8px 0px; font-size: 14px; color: #000000; font-family: Roboto, -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif; text-align: start; white-space: pre-wrap;\"\u003e- Thiết kế linh hoạt, hợp lý với phần đầu có thể xoay giúp bạn có thể điều chỉnh hướng sạc phù hợp.\u003c/p\u003e\n\u003cp style=\"margin: 0px; padding: 8px 0px; font-size: 14px; color: #000000; font-family: Roboto, -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif; text-align: start; white-space: pre-wrap;\"\u003e- Chân cắm tiếp xúc điện tốt, luôn chắc chắn khi xe đi trong mọi địa hình.\u003c/p\u003e\n\u003cp style=\"margin: 0px; padding: 8px 0px; font-size: 14px; color: #000000; font-family: Roboto, -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif; text-align: start; white-space: pre-wrap;\"\u003e- Cấp nguồn cho các thiết bị điện trên xe hơi như máy hút bụi, máy lọc không khí, bảng điều khiển, máy nghe nhạc, camera giám sát hành trì\u003c/p\u003e\n\u003cp style=\"margin: 0px; padding: 8px 0px; font-size: 14px; color: #000000; font-family: Roboto, -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif; text-align: start; white-space: pre-wrap;\" data-spm-anchor-id=\"a2o4n.pdp.product_\"\u003e- Tương thích với hầu hết các mô hình chủ đạo (12-24v).\u003c/p\u003e\n\u003cp style=\"margin: 0px; padding: 8px 0px; font-size: 14px; color: #000000; font-family: Roboto, -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif; text-align: center; white-space: pre-wrap;\" data-spm-anchor-id=\"a2o4n.pdp.product_\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/d7/15/06/cf72d8bcb6b5e7b15786059468e20131.jpg\" alt=\"\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp style=\"margin: 0px; padding: 8px 0px; font-size: 14px; color: #000000; font-family: Roboto, -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif; text-align: start; white-space: pre-wrap;\" data-spm-anchor-id=\"a2o4n.pdp.product_\"\u003e\u003cspan style=\"margin: 0px; padding: 0px; font-weight: bolder;\"\u003eThông số kỹ thuật \u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"margin: 0px; padding: 8px 0px; font-size: 14px; color: #000000; font-family: Roboto, -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif; text-align: start; white-space: pre-wrap;\"\u003e- Tên sản phẩm: HY-16.\u003c/p\u003e\n\u003cp style=\"margin: 0px; padding: 8px 0px; font-size: 14px; color: #000000; font-family: Roboto, -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif; text-align: start; white-space: pre-wrap;\"\u003e- Chất liệu: ABS.\u003c/p\u003e\n\u003cp style=\"margin: 0px; padding: 8px 0px; font-size: 14px; color: #000000; font-family: Roboto, -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif; text-align: start; white-space: pre-wrap;\"\u003e- Kích thướ