":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/2b/f9/0d/a6ff459ad0be0bd8c844ca5f19b2c1ba.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":429,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eTai Nghe Bluetooth Chính Hãng Soundpeats Opera 05 | Hi Res Audio LDAC | Pin 33h | Hỗ trợ app\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eKiểu dáng độc đáo, củ tai thiết kế dạng in-ear giúp ôm trọn khuôn tai\u003cbr /\u003eCông nghệ chống ồn chủ động ANC cao cấp hỗ trợ khử nhiều tạp âm\u003cbr /\u003eThời lượng pin lớn, hoạt động lên đến 33 giờ liên tục khi kèm hộp sạc\u003cbr /\u003eDriver 12mm cùng nhiều công nghệ âm thanh cho trải nghiệm trọn vẹn\u003cbr /\u003eMic kép ENC chống ồn đàm thoại hiệu quả\u003cbr /\u003eHỗ trợ codec LDAC nghe nhạc Hi-res\u003c/p\u003e\n\u003cp\u003e️ Công nghệ âm thanh Hi-Res Audio chất lượng cao với bộ giải mã âm thanh LDAC\u003cbr /\u003eHi-Res Audio (HAR) được viết tắt từ cụm từ High-Resolution, đây là khái niệm để diễn tả định dạng âm thanh có độ nét và chất lượng cao. HAR có chất lượng lượng vượt trội hơn cả Compact Disc Digital Audio – CD (tiêu chuẩn chất lượng của nhạc số).\u003c/p\u003e\n\u003cp\u003eĐồng thời tai nghe còn được hỗ trợ bộ giải mã âm thanh LDAC. Cho phép người sử dụng tai nghe có thể nghe nhạc Hi-Res với chất lượng đạt mức 96kHZ/24 bit và tốc độ truyền băng thông tối đa là 990kbps. Tốc độ truyền tải âm thanh của LDAC nhanh hơn nhiều so với aptX của Qualcomm hoặc SBC.\u003c/p\u003e\n\u003cp\u003e️ Trải nghiệm âm thanh khác biệt\u003c/p\u003e\n\u003cp\u003eSở hữu Driver Dynamic Bio-Diaphragm dày 12mm cùng 2 lõi sắt động để tạo ra âm thanh có độ phân giải cao, dải tần số đáp ứng rộng 20HZ-40KHZ.\u003c/p\u003e\n\u003cp\u003eÂm thanh Hi-Res và codec LDAC giúp cho âm trường sống động hơn và có độ chân thực cao hơn khi so sánh với tai nghe không dây tiêu chuẩn. Các nốt cao và giọng hát tỏa sáng với độ trong trẻo tối đa trong khi âm trầm được xử lý vô cùng khéo léo. Nhờ có các driver dynamic 12 mm, âm trầm thực sự mạnh mẽ và mang lại trải nghiệm nghe vượt trội hơn hẳn.\u003c/p\u003e\n\u003cp\u003e️ Mic ENC kép – Cuộc trò chuyện rõ ràng\u003cbr /\u003eChất lượng cuộc gọi của tai nghe Bluetooth SoundPEATS Opere 05 này khá mạnh với ENC kép nên bạn có thể nghe rõ ràng những gì mà người ở đầu dây bên kia nói. Thiết kế này cũng có khả năng chống gió, vì vậy micrô sẽ không bị gió hấp thụ quá nhiều, giọng nói của bạn cũng sẽ được tái tạo lại vô cùng rõ ràng trước khi gửi thông tin đến cho đối phương.\u003c/p\u003e\n\u003cp\u003e️ Chống ồn chủ động hiệu quả\u003cbr /\u003eTai nghe sở hữu bộ 3 chế độ ANC, Xuyên âm, Bình thường. Với chế độ ANC, tiếng ồn có thể giảm sâu xuống ở mức 30dB, kết hợp cùng thiết kế In-ear với miếng tips tai khít chặt vào tai, tiếng ồn gần như được loại bỏ triệt để, cho bạn tập trung vào âm nhạc.\u003c/p\u003e\n\u003cp\u003e️ Kiểm soát mọi tác vụ thông qua APP\u003cbr /\u003eThoải mái tùy chỉnh các trải nghiệm âm thanh của riêng bạn như là: Đặt EQ, âm lượng, điều chỉnh chọn bài, chế độ trò chơi… Kiểm soát dễ dàng, tiện lợi và nhanh chóng hơn bao giờ hết.\u003c/p\u003e\n\u003cp\u003e#soundpeats #minipro #miniprohs #truewireless #bluetoothheadphone #tainghekhongday #hiresaudio #ldac #opera05 #opera03\u003c/p\u003e\n\u003cp\u003eTHÔNG SỐ KỸ THUẬT\u003cbr /\u003eBluetooth:V5.3\u003cbr /\u003eSupported Bluetooth Profiles: HSP 、HFP 、 A2DP、AVRCP\u003cbr /\u003eSupported Bluetooth Codec:AAC,SBC,LDAC\u003cbr /\u003eANC: Yes\u003cbr /\u003eFrequency Response Range: 20-40000Hz\u003cbr /\u003eBattery Capacity: 40mAh*2 + 300mAh\u003cbr /\u003eCharging interface: Type-C\u003cbr /\u003eCharge Time: 1.5H（earphones/charging case）\u003cbr /\u003eTotal Music Play Time 60% volume:Earphone-9h/charging case 2.7 times\u003cbr /\u003eTotal Standby Time:60H\u003cbr /\u003ePlaytime:33H (AAC、Normal Use)\u003cbr /\u003eCharging Input:5V/1A\u003cbr /\u003eWater resistance:IPX4\u003cbr /\u003eDriver size: 12mm Dynamic Driver + 3.87*2.69*4.06mm Balanced Armature Driver\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003eNhà sản xuất: SHENZHEN GINTO E-COMMERCE CO., LTD\u003cbr /\u003eĐịa chỉ: Room 1308-1309, Building B, Huihai Square, Chuangye Road, Longhua District, Shenzhen, China, 518109\u003cbr /\u003eXuất xứ: China\u003c/p\u003e\n\u003cp\u003eNhập khẩu:\u003cbr /\u003eHKD Nam Phương\u003cbr /\u003e820 Võ Văn Kiệt P5 Q5 TPHCM\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/2b/f9/0d/a6ff459ad0be0bd8c844ca5f19b2c1ba.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/2b/f9/0d/a6ff459ad0be0bd8c844ca5f19b2c1ba.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/2b/f9/0d/a6ff459ad0be0bd8c844ca5f19b2c1ba.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2b/f9/0d/a6ff459ad0be0bd8c844ca5f19b2c1ba.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2b/f9/0d/a6ff459ad0be0bd8c844ca5f19b2c1ba.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/3f/b1/81/0d314e3aece57c833d0bfa990322ca9a.jpg","is_gallery":true,"label":