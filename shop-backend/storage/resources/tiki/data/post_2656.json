":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.6,"review_count":65,"review_text":"(65)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/53/e4/03/aa76f4a036933653f2a14e9d1f1e5a7a.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1658,"all_time_quantity_sold":171,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eHướng dẫn cách thay toàn bộ 8 lõi lọc nước - 8 lõi lọc Karofi loại mới nên sẽ là công nghệ đầu cắm, chỉ cần cắm dây vào đầu lõi lọc:\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/df/1a/5e/bea134c5cbfcdd87278f37ac02251fa3.jpg\" alt=\"\" width=\"402\" height=\"301\" /\u003e\u003c/p\u003e\n\u003cp\u003eKhi mua về bóc nilong ra thay, trên các lõi lọc thô có ghi số thứ tự 1,2 và 3 để thay vào cốc lọc 1,2,3 (cốc lọc trong suốt màu xanh là cốc 1).\u003c/p\u003e\n\u003cp\u003e1. Chú ý đầu tiên khi thay là khóa đầu vào nước vào máy lọc, rút điện, khóa van ở đầu bình chứa nước. \u003c/p\u003e\n\u003cp\u003e2. Với các lõi từ Ro và các lõi khoáng cần chú ý do công nghệ mới nên bên nhà bán sẽ trang bị thêm các đoạn dây gắn kết giữa các lõi lọc và đầu chia T ở đầu vào lõi khoáng ( Thường là lõi Gac T33, 1 đầu nước là đầu tinh khiết từ lõi lọc Ro, 1 đầu chạy vào bình chứa nước, 1 đầu vào lõi Gac T33)\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/9e/32/2c/4df052edf5880a526a8a6b327c3ad3db.jpg\" alt=\"\" width=\"750\" height=\"1000\" /\u003e\u003c/p\u003e\n\u003cp\u003eCắm sâu vào đầu lõi khoáng Gac T33\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/91/df/f2/1601b573d2c99af60154870783906a53.jpg\" alt=\"\" width=\"750\" height=\"562\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/97/9b/71/2ccd771d0a4549b5b53faeb1a7bb3f16.jpg\" alt=\"\" width=\"750\" height=\"1000\" /\u003e\u003c/p\u003e\n\u003cp\u003eThứ tự các lõi không quan trọng nhưng lõi cuối cùng sẽ là lõi Nano Silver (lõi diệt khuẩn). Trên các lõi đều có hình mũi xanh dập nổi để chỉ chiều đi của nước theo chiều mũi tên. Do vậy lắp các lõi nối tiếp theo đúng chiều mũi tên.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/f0/07/b2/a0f8483dad5fd7e1042c9b4703cbb77b.jpg\" alt=\"\" width=\"720\" height=\"960\" /\u003e \u003c/p\u003e\n\u003cp\u003eSau khi lắp đặt hoàn tất cần cho máy chạy 1h để tẩy rửa qua các lõi, rồi sau đó mới mở khóa van ở đầu bình chứa nước.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/15/bd/0d/ef0fb7470f5e77136da05b3b4b450346.jpg\" alt=\"\" width=\"750\" height=\"1000\" /\u003e\u003c/p\u003e\n\u003cp\u003eLưu ý: khi cắm dây vào các lõi lọc cần cắm hết nấc, nếu nước vẫn rò ở đầu dây là do cắm chưa sâu. Còn khi tháo ra thì ấn đầu nẫy hình tròn sát với dây xuống sẽ rút dây ra được dễ dàng.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/53/e4/03/aa76f4a036933653f2a14e9d1f1e5a7a.