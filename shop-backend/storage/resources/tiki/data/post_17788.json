div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/8d/d5/5e/62d5bd993bf28383c3ef0d450724957e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/8d/d5/5e/62d5bd993bf28383c3ef0d450724957e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/8d/d5/5e/62d5bd993bf28383c3ef0d450724957e.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8d/d5/5e/62d5bd993bf28383c3ef0d450724957e.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8d/d5/5e/62d5bd993bf28383c3ef0d450724957e.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/4d/28/ff/0e77bda26cc59aafd9a7c6423d6c2197.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/4d/28/ff/0e77bda26cc59aafd9a7c6423d6c2197.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/4d/28/ff/0e77bda26cc59aafd9a7c6423d6c2197.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4d/28/ff/0e77bda26cc59aafd9a7c6423d6c2197.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4d/28/ff/0e77bda26cc59aafd9a7c6423d6c2197.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/d6/e1/56/b3e8c222fad50cef0f284e5ba97c7a12.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d6/e1/56/b3e8c222fad50cef0f284e5ba97c7a12.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d6/e1/56/b3e8c222fad50cef0f284e5ba97c7a12.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d6/e1/56/b3e8c222fad50cef0f284e5ba97c7a12.jpg","thumbnail_url":"htt