,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":14,"review_text":"(14)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/3b/b2/d1/5b0359a2f1a1f7558b5b340811f416e7.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":676,"all_time_quantity_sold":72,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cul\u003e\u003cli\u003e\u003cstrong\u003eMÔ TẢ SẢN PHẨM \u003c/strong\u003e\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eBề mặt vải của Tấm lót chuột Chơi game bằng vải G240 của Logitech G tạo ra ma sát bề mặt lý tưởng cho trò chơi có DPI thấp, nâng cao khả năng điều khiển chuột và đặt con trỏ ở vị trí chính xác. Bắt đầu, dừng và thay đổi hướng nhanh và đột ngột không làm khó được tấm lót chuột Logitech G240. \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eKết cấu bề mặt ổn định có thể nâng cao hiệu suất cảm biến, đặc biệt khi được sử dụng với các cảm biến chơi game của Logitech G. Đồng thời, lớp đế bằng cao su mềm mại của tấm lót chuột chơi game duy trì được sự ổn định khi chơi game trên PC mà không làm giảm đi sự thoải mái.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eVới độ dày chỉ 1 mm, Tấm lót chuột G240 của Logitech duy trì độ cao khiêm tốn. Vải mềm làm tăng sự thoải mái khi cổ tay di chuyển qua lại giữa các cạnh của bàn di chuột. Với cấu trúc vải mềm, tấm lót chuột bằng vải G240 cuộn lại để dễ dàng mang đi và trải phẳng ra khi bạn sẵn sàng chơi. Bảo vệ bàn di chuột khi bạn mang tới các sự kiện có nối mạng LAN bằng cách sử dụng hộp đựng hình lục giác.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eCÁC ĐẶC ĐIỂM NỔI BẬT \u003c/strong\u003e\u003c/li\u003e\n\u003c/ul\u003e\u003cul\u003e\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eĐược xử lý nhiệt ở 200 độ C, bề mặt vải tạo ra lực cản vừa đủ cho chân chuột để điều khiển ở DPI thấp khi bắt đầu hoặc dừng một chuyển động đột ngột.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e \u003c/p\u003e\n\u003cul\u003e\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eG240 có kết cấu bề mặt sạch sẽ, ổn định. Điều này mang lại cho cảm biến hình ảnh tốt hơn để biến chuyển động của chuột thành chuyển động con trỏ, một bước cải tiến so với các bề mặt bàn và bàn làm việc không ổn định hoặc dính bẩn.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e \u003c/p\u003e\n\u003cul\u003e\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eG240 có thể giúp cho các game thủ đạt được độ chính xác cảm biến nâng cao. G240 sử dụng kết cấu bề mặt tương đương với môi trường thử nghiệm tối ưu cho chuột Logitech G.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003e.\u003c/span\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eTHÔNG SỐ KỸ THUẬT \u003c/strong\u003e\u003c/li\u003e\n\u003c/ul\u003e\u003cul\u003e\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eKích thước: (13,4 x 11 x 0,04 in)\u003c/span\u003e\n\u003cul\u003e\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eCHIỀU DÀI: 340 mm\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eCHIỀU RỘNG: 280 mm\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eCHIỀU DÀY: 1 mm\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e \u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eYÊU CẦU KỸ THUẬT\u003c/strong\u003e\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eTHÔNG TIN THAM KHẢO THÊM\u003c/strong\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003e.CHỨNG CHỈ FSC: Bao bì giấy của G240 đến từ các khu rừng được chứng nhận bởi FSC và các nguồn được kiểm soát khác. Bằng cách chọn sản phẩm này, bạn đang hỗ trợ việc quản lý có trách nhiệm các khu rừng trên thế giới.\u003c/span\u003e\u003cspan style=\"font-weight:400;\"\u003e\u003cbr /\u003e\u003cbr /\u003e\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003e 2022 Logitech. Logitech, Logitech G và các logo tương ứng là các nhãn hiệu và nhãn hiệu đã đăng ký của Logitech Europe S.A. và các chi nhánh tại Hoa Kỳ và/hoặc các quốc gia khác.\u003c/span\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/3b/b2/d1/5b0359a2f1a1f7558b5b340811f416e7.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/3b/b2/d1/5b0359a2f1a1f7558b5b340811f416e7.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/3b/b2/d1/5b0359a2f1a1f7558b5b