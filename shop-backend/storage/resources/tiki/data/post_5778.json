iao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/media/catalog/product/b/a/barron-s-gmat-14th-edition--kem-cd-.u2469.d20161109.t105741.540403.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/b/a/barron-s-gmat-14th-edition--kem-cd-.u2469.d20161109.t105741.540403.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/b/a/barron-s-gmat-14th-edition--kem-cd-.u2469.d20161109.t105741.540403.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/b/a/barron-s-gmat-14th-edition--kem-cd-.u2469.d20161109.t105741.540403.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/b/a/barron-s-gmat-14th-edition--kem-cd-.u2469.d20161109.t105741.540403.jpg"}],"warranty_policy":null,"authors":[{"id":4043,"name":".","slug":""}],"current_seller":{"id":97533,"sku":"9207793291251","name":"Nhà Sách Vĩnh Thụy","link":"https://tiki.vn/cua-hang/nha-sach-vinh-thuy","logo":"https://vcdn.tikicdn.com/ts/seller/19/f2/bd/8bda12adffb15edf1b3d8339b0238283.jpg","price":180000,"product_id":"275011848","store_id":90454,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Thông tin chung","attributes":[{"code":"publisher_vn","name":"Công ty phát hành","value":"First News - Trí Việt"},{"code":"publication_date","name":"Ngày xuất bản","value":"2014-06-16 00:00:00"},{"code":"dimensions","name":"Kích thước","value":"20.5 x 26 cm"},{"code":"book_cover","name":"Loại bìa","value":"Bìa mềm"},{"code":"number_of_page","name":"Số trang","value":"507"},{"code":"manufacturer","name":"Nhà xuất bản","value":"NXB Trẻ"}]}],"product_links":[],"gift_item_title":"0 quà tặng kèm","services_and_promotions":[],"promitions":[],"stock_item":{