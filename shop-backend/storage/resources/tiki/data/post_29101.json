o loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/3a/df/33/b37f7b33e746a57006c2bdc24fdfff88.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/3a/df/33/b37f7b33e746a57006c2bdc24fdfff88.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/3a/df/33/b37f7b33e746a57006c2bdc24fdfff88.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3a/df/33/b37f7b33e746a57006c2bdc24fdfff88.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3a/df/33/b37f7b33e746a57006c2bdc24fdfff88.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/0c/44/c7/64f57f9bad9431234e7e8a3bda7daa36.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0c/44/c7/64f57f9bad9431234e7e8a3bda7daa36.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/0c/44/c7/64f57f9bad9431234e7e8a3bda7daa36.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0c/44/c7/64f57f9bad9431234e7e8a3bda7daa36.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0c/44/c7/64f57f9bad9431234e7e8a3bda7daa36.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/af/f8/dd/003f4a21b8c1de26c02027a618f9c1c1.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/af/f8/dd/003f4a21b8c1de26c02027a618f9c1c1.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/af/f8/dd/003f4a21b8c1de26c02027a618f9c1c1.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/af/f8/dd/003f4a21b8c1de26c02027a618f9c1c1.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/af/f8/dd/003f4a21b8c1de26c02027a618f9c1c1.jpg"},{"base