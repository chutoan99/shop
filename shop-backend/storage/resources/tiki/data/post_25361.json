n_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":47000,"discount_rate":35,"rating_average":5,"review_count":5,"review_text":"(5)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/82/28/47/6cbe6dd75c2d950bc5cf1819f98657bc.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":989,"all_time_quantity_sold":25,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eTủ sách Tiềm thức cho bé từ 0-6 tuổi.\u003c/p\u003e\n\u003cp\u003eTrọn bộ gồm 4 quyển: Đồng dao - Thơ - Truyện - Câu đố cho bé Tập nói, Tập đọc – kèm File đọc quét mã QR ngay trên từng quyển.\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color: #0000ff;\"\u003e\u003cstrong\u003eTặng kèm 1 bút viết xóa (viết dễ dàng trên các chất liệu: giấy cán bóng, bảng, thủy tinh, gốm  sau đó dùng 1 đầu còn lại của bút để xóa)\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003eBộ sách tuyển chọn các bài đồng dao, thơ, truyện, câu đố mang tính giáo dục, nội dung đơn giản, dễ hiểu nhất, được yêu thích nhất dành cho thiếu nhi. Với các từ khóa được minh họa bằng những hình ảnh ngộ nghĩnh, đáng yêu sẽ giúp các bé tư duy ngôn ngữ, nhìn hình và đọc kể theo nội dung từng bài.\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003eBố mẹ hãy dành 10-15 phút mỗi ngày để đọc thơ, kể chuyện, đố vui cùng con. Nó vừa giúp gắn kết tình cảm gia đình, vừa giúp con phát triển ngôn ngữ, giao tiếp, tư duy và nhận thức. Và hơn hết là giáo dục con trở nên ngoan ngoãn thông qua việc hiểu được nội dung ẩn chứa trong các bài thơ, đồng dao, truyện kể.\u003c/p\u003e\n\u003cp\u003eNgoài ra bố mẹ có thể quét mã QR trên từng quyển để cho bé nghe đọc nha.\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003eMỗi quyển gồm 32 trang, khổ to 19x26.5 cm. Giá bìa: 42.000đ/ quyển.\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/82/28/47/437adea3e5890ca3ee54a1aea1655d94.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/82/28/47/437adea3e5890ca3ee54a1aea1655d94.jpg\" alt=\"\" width=\"undefined\" height=\"undefined\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/67/e9/41/6f9aecf3458a1f6f0e27e5e1a03f5aac.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/67/e9/41/6f9aecf3458a1f6f0e27e5e1a03f5aac.jpg\" alt=\"\" width=\"750\" height=\"519\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/97/04/25/8ece72caae7e915d822ba84cb0ccff77.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/97/04/25/8ece72caae7e915d822ba84cb0ccff77.jpg\" alt=\"\" width=\"750\" height=\"518\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/ee/46/9a/87beb2725b2232ab1034c286c3d5b3e7.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/ee/46/9a/87beb2725b2232ab1034c286c3d5b3e7.jpg\" alt=\"\" width=\"750\" height=\"519\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/67/e9/41/16a06f98ef67cf9827c3a3cfd57a9797.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/67/e9/41/16a06f98ef67cf9827c3a3cfd57a9797.jpg\" alt=\"\" width=\"750\" height=\"519\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/c0/b7/7c/f5e682b027d4bb9a2bf1599a80364688.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts