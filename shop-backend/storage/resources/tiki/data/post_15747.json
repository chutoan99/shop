04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":50000,"discount_rate":20,"rating_average":4.5,"review_count":25,"review_text":"(25)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/63/65/55/4f9a091cb47cb8244c9407d8af22f969.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1839,"all_time_quantity_sold":89,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003eGiới thiệu\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cspan\u003eBộ lắp ghép Chiến Xa Lội Nước QMAN 1803 lầ sản phẩm thuộc bộ sưu tập Combined Defomation nổi tiếng của QMAN đã được nhiều người chơi ở Việt Nam biết và sưu tập. Sản phẩm là mô hình xe tăng lội nước cỡ lớn đẹp và chắc chắn.\u003c/span\u003e\u003c/li\u003e\n\u003cli\u003eBộ sản phẩm gồm 361 chi tiết (mảnh ghép), với 8 hộp nhỏ mỗi hộp là một chiến đấu cơ dạng nhỏ như máy bay tiếp kích, xe quân sự , ô tô, trực thăng…\u003c/li\u003e\n\u003cli\u003eSự đa dạng của các loại máy bay chiến đấu, xe quân sự, xe tăng chắc chắn sẽ làm cho các bé vô cùng thích thú và say mê sáng tạo.\u003c/li\u003e\n\u003cli\u003eBộ mô hình với màu sắc vô cùng bắt mắt cùng với chất liệu nhựa ABS cao cấp, sinh động và trực quan. Các mảnh ghép không sắc nhọn an toàn cho trẻ. Sau khi chơi xong có thể cất lại trong hộp gọn gàng.\u003c/li\u003e\n\u003cli\u003eĐồ Chơi Lắp Ráp QMAN giúp cho trẻ học tập cách nhận diện đồ vật, học tập lắp ghép, kết hợp các đồ vật với nhau. Giúp bé thỏa sức tưởng tượng, tăng khả năng trí tuệ, óc sáng tạo.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/f3/7b/83/1cf75b27bd774cdf8fcd707100e71752.jpg\" alt=\"\" width=\"750\" height=\"539\" /\u003e\u003c/p\u003e\n\u003ch3\u003eThông số kỹ thuật\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eSố mảnh ghép: 361 \u003c/li\u003e\n\u003cli\u003eChi tiết đặc biệt: Màu sắc các miếng ghép đẹp, chất lượng an toàn cho bé, các mảnh ghép\u003c/li\u003e\n\u003cli\u003ekhông sắc nhọn đỡ nguy hiểm cho bé. \u003c/li\u003e\n\u003cli\u003eKích thước: 263 x 193 x 90 mm \u003c/li\u003e\n\u003cli\u003eĐộ tuổi:6+\u003c/li\u003e\n\u003cli\u003eĐược làm từ chất liệu nhựa ABS cao cấp\u003c/li\u003e\n\u003cli\u003eGiúp bé rèn luyện sự khéo léo, tỉ mỉ\u003c/li\u003e\n\u003cli\u003eGiúp bé học thêm về cuộc sống xung quanh\u003c/li\u003e\n\u003cli\u003eKích thích tư duy sáng tạo, phát triển trí não toàn diện\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003eGiới thiệu thương hiệu Qman\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eQMAN là tên nhận diện thương hiệu mới của hãng sản xuất đồ chơi nội địa nổi tiếng của Trung Quốc – ENLIGHTEN\u003c/li\u003e\n\u003cli\u003eQMAN có thể coi là lão làng trong giới sản xuất đồ chơi xếp hình lắp trên thế giới, bắt đầu từ những năm 1963.Các mẫu xếp hình của QMAN gần như độc lập hoàn toàn, do QMAN tự phát triển, thiết kế. Điều đó làm cho QMAN trở nên nổi bật và khác biệt so với những thương hiệu đồ chơi lắp ghép khác - đa phần thiết kế giống các mẫu sản phẩm đã có sẵn từ trước đó.\u003c/li\u003e\n\u003cli\u003eĐồ chơi xếp hình lắp ráp QMAN được bán khắp thế giới và được cộng đồng chơi xếp hình lắp ráp đánh giá cao một cách đến ngạc nhiên. Nhiều người đánh giá không hiểu sao lại có những bộ xếp hình có chất lượng tốt đến như vậy.\u003c/li\u003e\n\u003cli\u003eCác khối xếp hình lắp ráp QMAN làm bằng nhựa ABS nguyên chất an toàn với trẻ nhỏ, không có chất độc hại, bền dưới tác dụng vật lý (xe ô tô chạy qua không sao), bền màu theo thời gian và nhiệt độ (rửa nước nóng không sao).\u003c/li\u003e\n\u003cli\u003eCác mảnh ghép, khối ghép cùng kích thước, độ dày nhựa, với bề mặt sáng bóng, không có phần nhựa dư thừa, không sắc nhọn các cạnh với đặc điểm nhận dạng là dòng chữ ENLI in dập nổi trên các nốt tròn của từng mảnh ghép.\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/63/65/55/4f9a091cb47cb8244c9407d8af22f969.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/63/65/55/4f9a091cb47cb8244c9407d8af22f969.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/63/65/55/4f9a091cb47cb8244c9407d8af22f969.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/63/65/55/4f9a091cb47cb8244c9407d8af22f969.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/63/65/55/4f9a091cb47cb8244c9407d8af22f969.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/15/7a/d3/8d8794b3d602b424402e131d7a54fc25.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/15/7a/d3/8d8794b3d602b424402e131d7a54fc25.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/15/7a/d3/8d8794b3d602b424402e131d7a54fc25.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/15/7a/d3/8d8794b3d602b424402e131d7a54fc25.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/15/7a/d3/8d8794b3d602b424402e131d7a54fc25.png"},{"base_url":"https://salt.tikicdn.com/ts/product/8d/59/df/b1c88623d809dd2944e974807b050f7e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/8d/59/df/b1c88623d809dd2944e974