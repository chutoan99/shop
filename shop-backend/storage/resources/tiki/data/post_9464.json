con_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":96000,"discount_rate":33,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/d4/09/29/9424261d2889770ed55bcc48e691a25f.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":813,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cul\u003e\u003cli\u003eDrive units có độ chính xác cao mang đến âm thanh chất lượng tốt và rõ nét. Hỗ trợ rất đắc lực lúc chơi game, nghe rõ nét âm thanh tiếng động trong trận đấu giúp bạn bắt được kẻ thù trước khi chúng tìm thấy bạn.\u003c/li\u003e\n\u003cli\u003eHai tai hoạt động độc lập nên có thể kết nối 1 hoặc đồng thời 2 tai vào thiết bị.\u003c/li\u003e\n\u003cli\u003eĐiều khiển tai nghe bằng chạm cảm ứng thông minh.\u003c/li\u003e\n\u003cli\u003eTai nghe nhỏ vừa vặn với ống tai và trọng lượng nhẹ không gây đau tai.\u003c/li\u003e\n\u003cli\u003eCông nghệ BT 5.0, độ trễ latency thấp và tiêu thụ ít điện năng\u003c/li\u003e\n\u003cli\u003eHướng dẫn kết nối: lấy tai nghe ra khỏi hộp. Sau đó mở Bluetooth trên thiết bị cần kết nối và chọn \"BT\".\u003c/li\u003e\n\u003cli\u003eThời gian nghe nhạc: 4-5 giờ (tùy thuộc vào âm lượng)\u003c/li\u003e\n\u003cli\u003eDung lượng pin: Tai nghe: 30mah \u003cbr /\u003e                            Hộp sạc: 320mah\u003cbr /\u003e                            Cổng hộp sạc: Type-c\u003cbr /\u003e                            Thời gian hộp sạc đầy: 1,5 giờ\u003c/li\u003e\n\u003c/ul\u003e\u003cp style=\"text-align:center;\"\u003e\u003ciframe src=\"//www.youtube.com/embed/C_dvQCsXWNM\" width=\"560\" height=\"314\" allowfullscreen=\"\"\u003e\u003c/iframe\u003e\u003c/p\u003e\n\u003ctable dir=\"ltr\" style=\"height:306px;width:847px;\" border=\"1\" cellspacing=\"0\" cellpadding=\"0\"\u003e\u003ccolgroup\u003e\u003ccol width=\"174\" /\u003e\u003ccol width=\"174\" /\u003e\u003ccol width=\"622\" /\u003e\u003c/colgroup\u003e\u003ctbody\u003e\u003ctr style=\"height:18px;\"\u003e\u003ctd style=\"height:18px;width:843px;\" colspan=\"3\" rowspan=\"1\"\u003e\n\u003cp\u003e\u003cstrong\u003eChức năng điều khiển cảm ứng_Cần đảm bảo tai nghe đã được kết nối bluetooth trên thiết bị với tên \"BT\"\u003c/strong\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\u003ctr style=\"height:18px;\"\u003e\u003ctd style=\"height:18px;width:154.25px;\"\u003eBật\u003c/td\u003e\n\u003ctd style=\"height:18px;width:157.512px;\"\u003eTai nghe trái/phải\u003c/td\u003e\n\u003ctd style=\"height:18px;width:527.237px;\"\u003eChạm cảm ứng và giữ khoảng 5 giây. Nghe tiếng \"power on\".\u003c/td\u003e\n\u003c/tr\u003e\u003ctr style=\"height:18px;\"\u003e\u003ctd style=\"height:18px;width:154.25px;\"\u003eTắt\u003c/td\u003e\n\u003ctd style=\"height:18px;width:157.512px;\"\u003eTai nghe trái/phải\u003c/td\u003e\n\u003ctd style=\"height:18px;width:527.237px;\"\u003eChạm cảm ứng và giữ khoảng 5 giây. Nghe tiếng \"power off\".\u003c/td\u003e\n\u003c/tr\u003e\u003ctr style=\"height:36px;\"\u003e\u003ctd style=\"height:36px;width:154.25px;\"\u003eTrả lời/ngắt cuộc gọi\u003c/td\u003e\n\u003ctd style=\"height:36px;width:157.512px;\"\u003eTai nghe trái/phải\u003c/td\u003e\n\u003ctd style=\"height:36px;width:527.237px;\"\u003eNhấn 1 vào nút cảm ứng khi có cuộc gọi đến/nhấn 1 lần để ngắt cuộc gọi.\u003c/td\u003e\n\u003c/tr\u003e\u003ctr style=\"height:18px;\"\u003e\u003ctd style=\"height:18px;width:154.25px;\"\u003eTạm dừng/phát nhạc\u003c/td\u003e\n\u003ctd style=\"height:18px;width:157.512px;\"\u003eTai nghe trái/phải\u003c/td\u003e\n\u003ctd style=\"height:18px;width:527.237px;\"\u003eNhấn 1 lần vào nút cảm ứng trong chế độ phát lại nhạc.\u003c/td\u003e\n\u003c/tr\u003e\u003ctr style=\"height:36px;\"\u003e\u003ctd style=\"height:36px;width:154.25px;\"\u003eChuyển tới bài hát tiếp theo\u003c/td\u003e\n\u003ctd style=\"height:36px;width:157.512px;\"\u003eTai nghe phải\u003c/td\u003e\n\u003ctd style=\"height:36px;width:527.237px;\"\u003eỞ chế độ phát lại nhạc, nhấn 2 lần vào nút cảm ứng để chuyển tới bài hát tiếp theo.\u003c/td\u003e\n\u003c/tr\u003e\u003ctr style=\"height:36px;\"\u003e\u003ctd style=\"height:36px;width:154.25px;\"\u003eChuyển về bài hát trước đó\u003c/td\u003e\n\u003ctd style=\"height:36px;width:157.512px;\"\u003eTai nghe trái\u003c/td\u003e\n\u003ctd style=\"height:36px;width:527.237px;\"\u003eỞ chế độ phát lại nhạc, nhấn 2 lần vào nút cảm ứng để trở về bài hát trước đó.\u003c/td\u003e\n\u003c/tr\u003e\u003ctr style=\"height:36px;\"\u003e\u003ctd style=\"height:36px;width:154.25px;\"\u003eTăng âm lượng\u003c/td\u003e\n\u003ctd style=\"height:36px;width:157.512px;\"\u003eTai nghe phải\u003c/td\u003e\n\u003ctd style=\"height:36px;width:527.237px;\"\u003eNhấn 3 lần liên tiếp vào nút cảm ứng trong chế độ phát lại nhạc để tăng âm lượng. Nghe tiếng \"beep\".\u003c/td\u003e\n\u003c/tr\u003e\u003ctr style=\"height:36px;\"\u003e\u003ctd style=\"height:36px;width:154.25px;\"\u003eGiảm âm lượng\u003c/td\u003e\n\u003ctd style=\"height:36px;width:157.512px;\"\u003eTai nghe trái\u003c/td\u003e\n\u003ctd style=\"height:36px;width:527.237px;\"\u003eNhấn 3 lần liên tiếp vào nút cảm ứng trong chế độ phát lại nhạc để giảm âm lượng. Nghe tiếng \"beep\".\u003c/td\u003e\n\u003c/tr\u003e\u003ctr style=\"height:18px;\"\u003e\u003ctd style=\"height:18px;width:154.25px;\"\u003eTrợ lý giọng nói Siri\u003c/td\u003e\n\u003ctd style=\"height:18px;width:157.512px;\"\u003eTai nghetrái/phải\u003c/td\u003e\n\u003ctd style=\"height:18px;width:527.237px;\"\u003eChạm cảm ứng và giữ khoảng 1.5 giây. Nghe tiếng \"beep\".\u003c/td\u003e\n\u003c/tr\u003e\u003ctr style=\"height:18px;\"\u003e\u003ctd style=\"height:18px;width:154.25px;\"\u003eBật chế độ chơi game\u003c/td\u003e\n\u003ctd style=\"height:18px;width:157.512px;\"\u003eTai nghetrái/phải\u003c/td\u003e\n\u003ctd style=\"height:18px;width:527.237px;\"\u003eNhấn 5 lần vào nút cảm ứng, sau đó nghe tiếng \"Game Mode\".\u003c/td\u003e\n\u003c/tr\u003e\u003ctr style=\"height:18px;\"\u003e\u003ctd style=\"height:18px;width:154.25px;\"\u003eTắt chế độ chơi game\u003c/td\u003e\n\u003ctd style=\"height:18px;width:157.512px;\"\u003eTai nghetrái/phải\u003c/td\u003e\n\u003ctd style=\"height:18px;width:527.237px;\"\u003eNhấn 5 lần vào nút cảm ứng, sau đó nghe tiếng \"Music Mode\".\u003c/td\u003e\n\u003c/tr\u003e\u003c/tbody\u003e\u003c/table\u003e\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/d4/09/29/7108828d9d1bd08242ff44cd93dc2379.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/a5/7e/49/c52a4c67ebc7415b6a666641726792cb.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/2c/3e/c7/0828bedf346baa5e77f47b83d4fe57f4.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/26/07/24/ca2114c5bf62e9f4491b004513b24a2b.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003cimg style=\"margin-left:aut