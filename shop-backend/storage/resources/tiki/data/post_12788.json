0f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.7,"review_count":28,"review_text":"(28)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/81/94/ef/7e3b774fd4d8938c711be25e41152090.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1769,"all_time_quantity_sold":182,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eI. CÁCH SỬ DỤNG\u003c/p\u003e\n\u003cp\u003e· Quấn thắt lưng quanh phần cơ thể đã chọn (bụng, eo, hoặc hông). Bạn nên quấn nó quanh người mà không để nó bị gấp hoặc bị đè lên.\u003c/p\u003e\n\u003cp\u003e· Không quấn quá chặt để có hiệu quả tối ưu và tránh bị nóng cục bộ.\u003c/p\u003e\n\u003cp\u003e· Kiểm tra điện áp nguồn với điện áp ghi trên phích cắm trước khi cắm thiết bị vào.\u003c/p\u003e\n\u003cp\u003e· Đảm bảo là bộ điều chỉnh nhiệt đã tắt.\u003c/p\u003e\n\u003cp\u003e· Cắm điện.\u003c/p\u003e\n\u003cp\u003e· Vặn công tắc điều chỉnh nhiệt vào vị trí tối đa để nhanh chóng tăng nhiệt. Sau 3 - 5 phút, giảm nhiệt độ tới mức vừa phải đối với bạn.\u003c/p\u003e\n\u003cp\u003e· Sau 50 phút, tắt máy, lau mồ hôi và đợi khoảng 15 đến 20 phút trước khi tắm, ăn, hoặc uống thức uống lạnh. Đừng lo lắng nếu da bạn bị đỏ lên, nó sẽ mất đi sau vài giờ.\u003c/p\u003e\n\u003cp\u003eII. BẢO TRÌ VÀ LÀM SẠCH\u003c/p\u003e\n\u003cp\u003eKhi dùng xong, cởi thắt lưng và trải nó ra trên nền phẳng cho đến khi nó nguội xuống. Sau đó lau bằng vải ẩm và làm khô nó. Bảo quản ở nơi khô thoáng.\u003c/p\u003e\n\u003cp\u003eIII. CHÚ Ý: · Kiểm tra điện áp nguồn trước khi sử dụng.\u003c/p\u003e\n\u003cp\u003e· Không gấp thắt lưng hỗ trợ giảm béo khi đang sử dụng hoặc khi bảo quản.\u003c/p\u003e\n\u003cp\u003e· Không sử dụng kim, đinh ghim, và các vật bằng kim loại nhọn sắc khác khi sử dụng thắt lưng hỗ trợ giảm béo.\u003c/p\u003e\n\u003cp\u003e· Không giặt. · Không sử dụng thắt lưng hỗ trợ giảm béo khi đang say rượu, uống thuốc ngủ hoặc thuốc giảm đau. · Không dùng cho trẻ em hoặc người ốm. · Không sử dụng thắt lưng hỗ trợ giảm béo quá lâu ở nhiệt độ tối đa để tránh bị bỏng da. · Những người có làn da nhạy cảm không nên sử dụng ở nhiệt độ tối đa.\u003c/p\u003e\n\u003cp\u003e· Tháo thắt lưng hỗ trợ giảm béo ra nếu bạn cảm thấy buồn ngủ và trước khi bạn ngủ quên. · Chỉ sử dụng bộ điều chỉnh nhiệt độ đi kèm với thắt lưng hỗ trợ giảm béo. · Không thay thế các linh kiện trong thắt lưng hỗ trợ giảm béo với các linh kiện của các thiết bị khác. · Không để thắt lưng hỗ trợ giảm béo gần nước. · Khi không sử dụng, bạn phải nhớ tắt máy và rút điện ra khỏi nguồn.\u003c/p\u003e\n\u003cp\u003e· Để thắt lưng hỗ trợ giảm béo xa khỏi tầm tay trẻ em. Chỉ sử dụng thắt lưng hỗ trợ giảm béo ở những phần cơ thể được chỉ định trong hướng dẫn sử dụng này. · Không sử dụng trong phòng tắm · Không sử dụng máy khi đang mang thai hoặc trong kỳ kinh nguyệt. Điện áp sử dụng: 200V - 230V/ 50hz - 60hz Công suất tạo nóng: 60W. Xuất xứ: Việt Nam.\u003c/p\u003e\n\u003cp\u003eBảo hành: 12 tháng. Sản phẩm đã có mặt nhiều nước trên thế giới và đã được nhiều người ưa chuộng vì công năng và tính hiệu quả của sản phẩm này mang lại, là dụng cụ y tế cần thiết trong mọi gia đình.\u003c/p\u003e\n\u003cp\u003eBẠN ĐO VÒNG BỤNG ĐỂ CHỌN SIZE NHÉ:\u003c/p\u003e\n\u003cp\u003eSize M: 70 - 80 cm. Size L: 90 - 105 cm. Size XL: 110 - 120 cm.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/81/94/ef/7e3b774fd4d8938c711be25e41152090.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/81/94/ef/7e3b774fd4d8938c711be25e41152090.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/81/94/ef/7e3b774fd4d8938c711be25e41152090.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/81/94/ef/7e3b774fd4d8938c711be25e41152090.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/81/94/ef/7e3b774fd4d8938c711be25e41152090.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/fb/ef/ea/19632c8dd408381d0d5c793ba279e8ea.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/fb/ef/ea/19632c8dd408381d0d5c793ba279e8ea.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/fb/ef/ea/19632c8dd408381d0d5c793ba279e8ea.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fb/ef/ea/19632c8dd408381d0d5c793ba279e8ea.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fb/ef/ea/19632c8dd408381d0d5c793ba279e8ea.jpg"}],"warranty_policy":null,"brand":{"id":298405,"name":"DCYTLOC","slug":"dcytloc"},"current_seller":{"id":4189,"sku":"6644132084510","name":"Y Tế Lộc","link":"https://tiki.vn/cua-hang/y-te-loc","logo":"f7/57/5d/a8899b07df1959b9f33b82635b4c77e6.png","price":479000,"product_id":"40888006","store_id":4137,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Content","attributes":[{"code":"brand","name":"Thương hiệu","value":"DCYTLOC"}]}],"product_links":[],"gift_item_title":"0 quà tặng kèm","configurable_options":[{"code":"option1","name":"SIZE","position":0,"show_preview_image":false,"values":[{"label":"SIZE L"},