olor":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.1,"review_count":8,"review_text":"(8)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/e1/87/07/8d79a0429ac7daa90afcc4d450f57bf1.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1252,"all_time_quantity_sold":37,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eXà đơn gắn cửa, treo tường thép chịu lực có thước thăng bằng GoodFit GF201PU (model 2021)\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eChất liệu: Thép không gỉ, EVA, Cao su\u003c/li\u003e\n\u003cli\u003eĐược làm từ thép chịu lực đảm bảo an toàn tuyệt đối\u003c/li\u003e\n\u003cli\u003eCó thêm thước thủy để đo độ cân bằng khi lắp đặt\u003c/li\u003e\n\u003cli\u003eTăng diện tích bề mặt bám tường bảo vệ bạn tốt hơn\u003c/li\u003e\n\u003cli\u003eĐơn vị bán: Chiếc\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eXà đơn treo tường\u003c/strong\u003e GoodFit GF201PU là mẫu mới năm 2021 đã được cải tiến, sửa đổi những khuyết điểm của mẫu xà cũ thông thường. Nhờ bề mặt tiếp xúc với tường rộng hơn, xà bám chắc nhưng không làm hỏng kết cấu tường, đồng thời tăng mức độ an toàn khi tập luyện.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/58/76/f8/b8394bcc4468a0002cb5aa2f373f8299.jpg\" alt=\"\" width=\"750\" height=\"550\" /\u003e\u003c/p\u003e\n\u003ch2\u003eĐặc điểm nổi bật\u003c/h2\u003e\n\u003cp\u003eThân \u003cstrong\u003exà đơn gắn cửa\u003c/strong\u003e được làm từ thép phun sơn tĩnh điện có thể chống chịu lực lên tới 200kg. Xà cũng có trọng lượng nặng hơn và đem lại khả năng chống chịu tốt hơn các sản phẩm thông thường.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/1c/4b/bc/d3d8d2f51858603bd35ccc679122914c.jpg\" alt=\"\" width=\"750\" height=\"783\" /\u003e\u003c/p\u003e\n\u003cp\u003eXà đơn gắn tường được trang bị 2 chốt khóa xoay an toàn ở 2 đầu của thanh xà. Bạn có thể yên tâm thực hiện những động tác đu xà trên cao mà không lo sợ chúng bị nhả ren, đảm bảo 100% khả năng an toàn khi sử dụng.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/08/b4/4a/05ba87b1643df975ebb9c074c877f5ec.jpg\" alt=\"\" width=\"750\" height=\"649\" /\u003e\u003c/p\u003e\n\u003cp\u003eBên cạnh đó,\u003cstrong\u003e xà đơn gắn tường\u003c/strong\u003e cũng được bổ sung thêm thước thủy để đo cân bằng. Bạn cần lắp đặt sao cho giọt nước nằm chính giữa của thước thủy, lúc này xà mới được cân bằng và đảm bảo an toàn cho việc tập luyện.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/ca/35/57/9993c4e456b4fbe1d01906b9bf2d0af9.jpg\" alt=\"\" width=\"750\" height=\"730\" /\u003e\u003c/p\u003e\n\u003cp\u003eVới ưu điểm tháo lắp dễ dàng, phân chia kích thước phù hợp với nhiều khung cửa, xà đơn tại nhà đem lại độ an toàn gần như tuyệt đối để bạn có thể thực hiện những bài tập cơ bản như sau (hình ảnh).\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/62/d1/6a/fecf11babd5747e9ac928a319e932042.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eBằng việc sử dụng những động tác kéo người lên nhờ lực cánh tay, tập luyện cùng xà đơn giúp toàn bộ cơ thể được kéo căng, đầu sụn và khớp xương được giải toả lực nén. \u003cem\u003eNgười tập cũng được tiêu hao một phần năng lượng dư thừa, kích thích tăng trưởng chiều cao, phát triển hệ cơ bắp. Xà đơn cũng đã được rất nhiều người kiểm nghiện có thể chữa chứng cong vẹo cột sống do ngồi sai tư thế\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/66/15/ab/5b2c68579398080647e795d095441100.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003eĐế gắn tường được thiết kế giống hình đế giày với 32 dải chống trượt. Nhờ diện tích tiếp xúc lớn nên nó bám tường chắc hơn so với loại đế cũ hình lục giác. Tường nhà bạn và chính bạn cũng được bảo vệ một cách tốt hơn\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/5b/ce/60/5aea0e5fd1ba7d65d35999424017cdb2.jpg\" alt=\"\" width=\"750\" height=\"404\" /\u003e\u003c/p\u003e\n\u003cp\u003eTuy nhiên, nhà sản xuất cũng khuyến cáo bạn chỉ nên gắn chúng trên bề mặt tường bề tông, tường gỗ, để đảm bảo an toàn, tránh những bề mặt kính, đá hoa, nhựa, nhôm bởi nó có thể làm hỏng cấu trúc cửa.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/51/b7/9e/fdef7b321e849b865e7f45933a41daba.jpg\" alt=\"\" width=\"750\" height=\"518\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/f3/7b/9e/6ec1e4754156c729205a0348f3fe386b.jpg\" alt=\"\" width=\"750\" height=\"570\" /\u003eBộ phận tay cầm được bọc bằng đệm xốp EVA mềm. Đây là điểm tì êm ái, tránh gây ra những vết chai sần tay sau khi tập luyện.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/0e/c3/15/9ba30232c516613812dfbaffe136e136.jpg\" alt=\"\" width=\"750\" height=\"608\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cem\u003eHƯỚNG DẪN LẮP ĐẶT XÀ ĐƠN GẮN TƯỜNG CHỈ TRONG 30 GIÂY (KHÔNG ĐỤC LỖ, KHÔNG HỎNG TƯỜNG) VỚI 4 BƯỚC CƠ BẢN\u003c/em\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cem\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/ba/97/cb/865988eb8dc4b8b290d65fab41ffa8fb.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/em\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eXà đơn treo tường là dụng cụ tập thể thao tại nhà rất tiện lợi, đặc biệt là dành cho những ai có nhu cầu tập luyện nhưng không có thời gian tới phòng tập.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/f7/91/7b/59a171b6ba4e8f0282a5b51f4d08d21a.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch2\u003eVỀ THƯƠNG HIỆU GOODFIT\u003c/h2\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/46/7a/53/006153a93c27564e8cbfb48c49d85cce.jpg\" alt=\"\" width=\"750\" height=\"492\" /\u003e6 bước để tạo ra các dòng sản phẩm mang thương hiệu GOODFIT\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/80/e5/68/d208291cf1d1cb0c19758d264667ade2.jpg\" alt=\"\" width=\"750\" height=\"450\" /\u003eĐội ngũ GOODFIT\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/b7/8c/f3/2249db430abeef20fa276c63cbd460ff.jpg\" alt=\"\" width=\"750\" height=\"514\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/e1/87/07/8d79a0429ac7daa90afcc4d450f57bf1.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e1/87/07/8d79a0429ac7daa90afcc4d450f57bf1.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e1/87/07/8d79a0429ac7daa90afcc4d450f57bf1.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e1/87/07/8d79a0429ac7daa90afcc4d450f57bf1.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e1/87/07/8d79a0429ac7daa90afcc4d450f57bf1.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/59/22/f1/fba7ba1fa6672b9f491bbef8e102ab69.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/59/22/f1/fba7ba1fa6672b9f491bbef8e102ab69.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/59/22/f1/fba7ba1fa6672b9f491bbef8e102ab69.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/59/22/f1/fba7ba1fa6672b9f491bbef8e102ab69.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5