 giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/55/60/f0/632e91710f44ef6bcdf40383d1e140ca.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/55/60/f0/632e91710f44ef6bcdf40383d1e140ca.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/55/60/f0/632e91710f44ef6bcdf40383d1e140ca.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/55/60/f0/632e91710f44ef6bcdf40383d1e140ca.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/55/60/f0/632e91710f44ef6bcdf40383d1e140ca.png"},{"base_url":"https://salt.tikicdn.com/ts/product/00/a2/d1/49f36d06a2f6eb24b90a8a4723d8d953.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/00/a2/d1/49f36d06a2f6eb24b90a8a4723d8d953.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/00/a2/d1/49f36d06a2f6eb24b90a8a4723d8d953.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/00/a2/d1/49f36d06a2f6eb24b90a8a4723d8d953.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/00/a2/d1/49f36d06a2f6eb24b90a8a4723d8d953.png"},{"base_url":"https://salt.tikicdn.com/ts/product/66/58/c1/468fa0bdbb80919bf90ff4cc0f30d328.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/66/58/c1/468fa0bdbb80919bf90ff4cc0f30d328.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/66/58/c1/468fa0bdbb80919bf90ff4cc0f30d328.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/66/58/c1/468fa0bdbb80919bf90ff4cc0f30d328.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/66/58/c1/468fa0bdbb80919bf90ff4cc0f30d328.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/cb/5e/99/761caf2033e5921caafd43b0eae52553.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cac