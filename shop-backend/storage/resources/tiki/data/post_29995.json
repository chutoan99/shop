ight":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":34000,"discount_rate":12,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/d4/93/f8/4653770fdc69a3517a209048ec181a06.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":602,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eĐèn Diệt Muỗi Comet CM078 với thiết kế đặc biệt giúp diệt muỗi và lọc không khí. Đèn thu hút muỗi bằng ánh sáng tím, và tiêu diệt muỗi hiệu quả, khép kín theo một cơ chế thông minh dựa vào việc định vị mục tiêu của muỗi. Ánh sáng tím giúp thu hút muỗi, bên trong đèn có những cánh thu hút muỗi hoặc côn trùng xuống phía lưới xung điện bên dưới. Bên dưới có lớp lưới ngăn muỗi hoặc côn trùng bay ngược ra ngoài do đó, đèn có thể bắt muỗi trong phạm vi diện tích rộng, giúp đảm bảo sức khỏe cho mọi thành viên trong gia đình bạn.\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/3d/10/23/56591c2abbf62f9cb947eaa703cbbaec.jpg\" alt=\"\" width=\"750\" height=\"977\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003e\u003cbr /\u003e\u003cstrong\u003e*** Công suất và số bóng đèn\u003c/strong\u003e\u003cbr /\u003e\u003cbr /\u003e- Đèn bắt muỗi hoạt động với công suất 3W tiết kiệm điện.\u003cbr /\u003e\u003cbr /\u003e- Trang bị 8 bóng đèn LED với công suất mỗi bóng 0.2W, cho hiệu suất bắt muỗi cao.\u003cbr /\u003e\u003cbr /\u003e\u003cbr /\u003e\u003cstrong\u003e*** Thời gian sử dụng đèn\u003c/strong\u003e\u003cbr /\u003e\u003cbr /\u003eĐèn sử dụng điện trực tiếp với điện áp 5V DC, không dùng pin, sử dụng tiện lợi.\u003cbr /\u003e\u003cbr /\u003e\u003cbr /\u003e\u003cstrong\u003e*** Bảng điều khiển\u003c/strong\u003e\u003cbr /\u003ePhía trên đèn có nút nhấn, cho bạn dễ dàng thao tác bật/tắt đèn.\u003cbr /\u003e\u003cstrong\u003e*** Tiện ích\u003c/strong\u003e\u003cbr /\u003e- Đèn bắt muỗi Comet CM078 sử dụng tia ánh sáng tím để thu hút muỗi, kết hợp với quạt hút mạnh mẽ, tránh muỗi thoát ra được khi đã vào trong, tiêu diệt muỗi hiệu quả.\u003cbr /\u003e\u003cbr /\u003e- Khay hứng xác muỗi khóa/mở linh hoạt, dễ dàng thu gom xác muỗi và vệ sinh.\u003cbr /\u003e\u003cbr /\u003eĐèn bắt muỗi Comet CM078 thiết kế độc đáo, kiểu dáng nhỏ gọn, ngoài sử dụng để bắt muỗi còn có thể dùng làm đèn ngủ, tô điểm không gian gia đình, đèn sử dụng đơn giản, là lựa chọn đúng đắn của mỗi gia đình.\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/e9/53/b8/1b6dcfb57886c9b22466d5b2095f79f4.jpg\" alt=\"\" width=\"750\" height=\"786\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003e– Diệt muỗi và côn trùng với công nghệ hiện đại\u003cbr /\u003e– Lọc không khí\u003cbr /\u003e– Không gây ồn ào\u003cbr /\u003e– An toàn và thân thiện với môi trường\u003cbr /\u003e– Kiểu dáng độc đáo, nhỏ gọn, đèn diệt muỗi Comet CM078 không chỉ mang lại sự tiện ích cao mà còn có thể dùng như đèn ngủ, đèn trang trí cực kỳ sang trọng, góp phần tô điểm cho không gian nhà bạn thêm phần sinh động và bắt mắt.\u003cbr /\u003e– Công suất: 3W\u003cbr /\u003e– Điện năng: 220V\u003cbr /\u003e\u003cbr /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/46/41/19/ca8819aa91bd82afcf6e0126e6567873.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikic