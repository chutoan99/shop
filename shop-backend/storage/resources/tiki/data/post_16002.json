}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":294000,"discount_rate":52,"rating_average":4.7,"review_count":45,"review_text":"(45)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/8a/c7/f2/96d24111cf8b988c8ddbe9693cd78ff9.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1180,"all_time_quantity_sold":218,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/1a/d3/33/b2e2640c7970ac3102b8a3a101797ffe.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/h2\u003e\n\u003ch2\u003eĐỆM NGỒI CHỐNG ĐAU XƯƠNG CỤT EMA CHỐNG ĐAU XƯƠNG CỤT, Ê MÔNG, THÂM MÔNG, XỆ MÔNG NHƯ THẾ NÀO?\u003c/h2\u003e\n\u003cp style=\"font-size: 20px;\"\u003eXương cụt là xương đáy tận cùng của hệ thống xương sống, đây là phần phải chịu toàn bộ áp lực của cơ thể khi ngồi. Việc ngồi quá lâu, trong một thời gian dài và trên một mặt phẳng cứng có thể \u003cstrong\u003egây nhiều áp lực lên xương cụt, dẫn đến đau mỏi xương cụt và các cơ, dây chằng xung quanh xương cụt\u003c/strong\u003e. Những người đang bị bệnh đau xương cụt sẽ thấy tình trạng đau tăng lên nhiều khi ngồi.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/06/e0/4e/a482bb477b917ee50ec3241c0aea7724.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"font-size: 20px;\"\u003eKhi được ngồi ở đệm xương cụt công thái học, \u003cstrong\u003ephần xương cụt hầu như không còn phải chịu bất cứ một áp lực nào\u003c/strong\u003e, thậm chí kể cả khi ngả ra đằng sau\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/75/7c/97/8aded1ce32f1bbe7a717040ab5176d3f.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003eẢnh minh họa:\u003c/em\u003e Phần xương cụt được \"giải phóng\" khi ngồi trên đệm ngồi Ema chuyên dụng\u003c/p\u003e\n\u003cp style=\"font-size: 20px;\"\u003eKhi ngồi, phần chịu áp lực nhiều nhất là xương, cơ quanh ụ ngồi – phần nhô cao nhất của mông. Vì vùng xương ụ ngồi và các cơ xung quanh nó chịu nhiều áp lực nhất trong khi ngồi. Cho nên khi ngồi càng lâu, nhất là trên bề mặt cứng thì vùng này \u003cstrong\u003edễ thấy bị ê và thâm nhất\u003c/strong\u003e.\u003c/p\u003e\n\u003cp style=\"font-size: 20px;\"\u003eKhông chỉ như vậy, \u003cstrong\u003etheo nhiều chuyên gia về thẩm mỹ, ngồi lâu cũng khiến vòng 3 bị phẳng đi, chảy xệ, không còn giữ được độ cong\u003c/strong\u003e. \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/9f/07/3d/308522d1bc9c5f10ef33a2c18e845153.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"font-size: 20px;\"\u003eĐệm xương cụt công thái học với thiết kế công thái học ôm theo đường cong của 2 bên mông và sử dụng chất liệu memory foam giúp giảm áp lực lên 2 vùng ụ ngồi.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/7b/d5/49/530b2d8a0466478b2330587fc471cdc9.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003eẢnh minh họa:\u003c/em\u003e Đệm ngồi Ema giúp áp lực dàn đều, không tập trung vào ụ mông từ đó giảm ê, thâm và tăng cường lưu thông máu\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch2\u003eĐỐI TƯỢNG SỬ DỤNG ĐỆM NGỒI CHỐNG ĐAU XƯƠNG CỤT EMA\u003c/h2\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/89/54/ac/83d8d5efa26c5514203640586a55d976.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli style=\"font-size: 20px;\"\u003eNhững người phải ngồi lâu, nhất là khi ngồi ghế cứng có thể dẫn đến vấn đề đau xương cụt, ê mông, thâm mông, xệ mông.\u003c/li\u003e\n\u003cli style=\"font-size: 20px;\"\u003eNhững người đang bị bệnh đau xương cụt như chấn thương, thoái hóa, phụ nữ mang thai.\u003c/li\u003e\n\u003cli style=\"font-size: 20px;\"\u003eNhững người đang ngồi làm việc trên một chiếc ghế dốc về đằng sau, ví dụ như ghế lái xe. Vì ghế ngả ra sau sẽ làm tăng áp lực ở vùng xương cụt khiến xương cụt dễ bị đau mỏi hơn khi ngồi lâu.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/b9/c6/98/b8a04f011226c80e6e626d855c4ce4c8.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch2 style=\"text-align: left;\"\u003eTHÔNG SỐ KỸ THUẬT ĐỆM NGỒI CHỐNG ĐAU XƯƠNG CỤT EMA\u003c/h2\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/83/b0/f6/c6023188d3252e4c79d4bb7a8a57fc52.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"font-size: 20px;\"\u003eKhối lượng: 1 kg\u003c/p\u003e\n\u003cp style=\"font-size: 20px;\"\u003eKích thước: 45x35x7cm\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/31/e1/b9/0f14916e398a84c90c5c866ef9e322fd.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"font-size: 20px;\"\u003eChất liệu:\u003c/p\u003e\n\u003cul\u003e\n\u003cli style=\"font-size: 20px;\"\u003eRuột gối được làm từ memory foam giúp giảm tốt nhất áp lực lên vùng mông. Tạo cảm giác thoải mái cho người ngồi, nhất là những người phải ngồi làm việc lâu trong nhiều giờ.\u003c/li\u003e\n\u003cli style=\"font-size: 20px;\"\u003eRuột gối được thiết kế thêm 1 lớp gel trên bề mặt tạo sự cảm giác thoáng mát khi sử dụng. Lướp gel này giúp giảm khoảng 3 độ so với nhiệt độ trên các loại đệm thông thường.\u003c/li\u003e\n\u003cli style=\"font-size: 20px;\"\u003eVỏ gối được làm từ từ vải lưới 3D giúp lưu thông không khí tốt hơn.\u003c/li\u003e\n\u003cli style=\"font-size: 20px;\"\u003eThêm vào đó, ruột gối và vỏ gối có thiết kế khóa kéo nên có thể dễ dàng vệ sinh vỏ gối.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/09/e9/b0/233162e0d18074b55042f1834db9a59a.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"font-size: 20px;\"\u003eMàu sắc:\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/99/3a/d5/c594456dcd142e751eb2b93b51175400.jpg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/99/3a/d5/c594456dcd142e751eb2b93b51175400.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/83/b0/f6/1d628aa6a36bad42596c069369a6260e.jpg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/83/b0/f6/1d628aa6a36bad42596c069369a6260e.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/99/4a/0f/7c6ed1b2e4b2c3eca2a2cd941bdfc8dc.jpg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/99/4a/0f/7c6ed1b2e4b2c3eca2a2cd941bdfc8dc.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch2\u003eMới r