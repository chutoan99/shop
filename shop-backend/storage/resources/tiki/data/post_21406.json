800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.7,"review_count":13,"review_text":"(13)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/c2/1d/5b/de91f36a1443363d670ab85baafac634.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1580,"all_time_quantity_sold":59,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eThông tin sản phẩm:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e- \u003c/strong\u003eTên sản phẩm: Trà Oolong bao nhôm Tâm Châu 250g hút chân không\u003c/p\u003e\n\u003cp\u003e- Khối lượng tịnh: 250gr\u003c/p\u003e\n\u003cp\u003e- Thành phần: búp trà Oolong tươi\u003c/p\u003e\n\u003cp\u003e- Xuất xứ: Bảo Lộc - Lâm Đồng\u003c/p\u003e\n\u003cp\u003e- Hạn sử dụng: 24 tháng kể từ ngày sản xuất\u003c/p\u003e\n\u003cp\u003e- Đặc điểm: trà Oolong đều có hình thể màu xanh đen, hình cầu hoặc bán cầu.\u003c/p\u003e\n\u003cp\u003e- Màu sắc và hương vị: màu nước vàng xanh, vị chát nhẹ, dịu, hậu ngọt và hương Oolong tự nhiên.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ca/8f/b1/86023744983f26dd62bb928322c77fd5.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eTrà Oolong là một giống trà có hương vị đặc trưng và là sản phẩm nổi tiếng của người Trung Quốc. Thời xưa, trà Oolong đã đi vào các nghi lễ long trọng và trở thành một thứ cống phẩm cho vua chúa. Trà Oolong đã xuất hiện cách đây khoảng 400 năm tại tỉnh Phúc Kiến – Trung Quốc và thời nhà Minh. Mãi cho đến năm 1992 cây trà này mới được du nhập vào Việt Nam và hiện nay được trồng rộng rãi ở tỉnh Lâm Đồng.\u003c/p\u003e\n\u003cp\u003eĐặc tính của trà Oolong Tâm Châu là không sử dụng bất kì hương hay phụ gia nào trong quá trình chế biến, mà đó là mùi hương đặc trưng sẵn có của trà Oolong. Để có được thành phẩm trà Oolong thì từ nguyên liệu tươi thu hái về phải mất hơn 30 tiếng qua nhiều công đoạn khác nhau như: làm héo, quay thơm, diệt men, định hình và cuối cùng là đóng gói tạo ra nhiều chủng loại trà Oolong Tâm Châu theo thị hiếu người tiêu dùng.\u003c/p\u003e\n\u003cp\u003eNhìn chung sản phẩm trà Oolong đều có hình thể màu xanh đen, bóng, hình cầu hoặc bán cầu, có màu sắc và kích thước hạt đồng nhất, màu nước vàng xanh, vị chát nhẹ, dịu, hậu ngọt và hương Oolong tự nhiên.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/c2/1d/5b/de91f36a1443363d670ab85baafac634.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c2/1d/5b/de91f36a1443363d670ab85baafac634.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c2/1d/5b/de91f36a1443363d670ab85baafac634.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c2/1d/5b/de91f36a1443363d670ab85baafac634.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c2/1d/5b/de91f36a1443363d670ab85baafac634.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/ca/8f/b1/c8ab6509b70ec5bb29535840321314b7.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ca/8f/b1/c8ab6509b70ec5bb29535840321314b7.jpg","medium_url":"ht