ề những vị kì tài của dân tộc để thể hiện sự tác động của lý tưởng yêu nước đến cậu bé Nguyễn Sinh Côn ngay từ khi còn rất nhỏ.\u003c/p\u003e\n\u003cp\u003e***\u003c/p\u003e\n\u003cp\u003eBÔNG SEN VÀNG\u003c/p\u003e\n\u003cp\u003eSơn Tùng\u003c/p\u003e\n\u003cp\u003eNxb Chính trị quốc gia Sự thật\u003c/p\u003e\n\u003cp\u003eBìa mềm\u003c/p\u003e\n\u003cp\u003e***\u003c/p\u003e\n\u003cp\u003eThông số cơ bản:\u003c/p\u003e\n\u003cp\u003eKích thước: 13 x 20,5cm\u003c/p\u003e\n\u003cp\u003eSổ trang: 416 trang\u003c/p\u003e\n\u003cp\u003eKhối lượng: 500gr\u003c/p\u003e\n\u003cp\u003e***\u003c/p\u003e\n\u003cp\u003e#bông_sen_vàng\u003c/p\u003e\n\u003cp\u003e#nxb_CTQG_ST\u003c/p\u003e\n\u003cp\u003e#sơn_tùng\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ab/2d/2e/ead8c9c4af004398428d48ffa84911de.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ab/2d/2e/ead8c9c4af004398428d48ffa84911de.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ab/2d/2e/ead8c9c4af004398428d48ffa84911de.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ab/2d/2e/ead8c9c4af004398428d48ffa84911de.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ab/2d/2e/ead8c9c4af004398428d48ffa84911de.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/10/0b/9e/1b8c2b3a6e43e5f1bef4e4ea59b7d7fc.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/10/0b/9e/1b8c2b3a6e43e5f1bef4e4ea59b7d7fc.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/10/0b/9e/1b8c2b3a6e43e5f1bef4e4ea59b7d7fc.jpg","position":null