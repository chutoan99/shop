on_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":128000,"discount_rate":54,"rating_average":4.2,"review_count":25,"review_text":"(25)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/d3/df/ce/0ac9f77e8b430466d66e70102a41ebfd.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1778,"all_time_quantity_sold":130,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/d8/12/5c/c8e079ac77a166668d5de8d8612a8480.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eGiày đinh vải đá bóng nam Thượng Đình (trắng) là loại giày làm bằng chất liệu vải có kiểu dáng\u003cbr /\u003ethể thao,bền, đẹp, nhẹ. Giúp công việc di chuyển nhẹ nhàng, linh hoạt, dễ chịu hơn cho đôi chân,\u003cbr /\u003ekhông tạo cảm giác khó chịu.\u003cbr /\u003eĐặc điểm:\u003cbr /\u003e- Nhà sản xuất : Thượng Đình\u003cbr /\u003e- Chất liệu: vải thô\u003cbr /\u003e- Màu sắc: màu trắng có kết hợp điểm nhấn giúp tạo điểm nhấn thể thao năng động\u003cbr /\u003e- Đế giày: Đinh nhưa chống trơn trượt, đế khâu\u003cbr /\u003e- Thân giày làm từ lớp lót bông\u003cbr /\u003e- Thích hợp chơi đá bóng (sân đất hay sân cỏ tự nhiên),đi bộ,à có thể tham gia các hoạt động ngoài trời\u003cbr /\u003e- Sản phẩm được sản xuất theo HTQLCL \u0026amp; MT đạt tiêu chuẩn: ISO 9001:2000 - ISO 14001:2004.\u003cbr /\u003e- Sản phẩm được công nhận là hàng Việt Nam chất lượng cao.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/a5/ad/ed/f3083a4ec35f15e49eed3922a671770e.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eGiày đá bóng Thượng Đình đế đinh màu trắng cho độ bám sàn tốt cũng như có độ bền cùng\u003cbr /\u003eđộ dẻo dai cao, là chọn lựa lý tưởng của những bạn nam yêu thích thể thao. Đặc biệt, thiết kế\u003cbr /\u003echủ đạo màu trắng sọc đỏ nổi bật, bắt mắt cùng logo ấn tượng, làm toát lên phong cách mạnh\u003cbr /\u003emẽ của cầu thủ bóng đá.\u003cbr /\u003e\u003cbr /\u003eThân giày đá bóng Thượng Đình đế đinh màu trắng được làm từ vải, bề mặt được may nhiều\u003cbr /\u003eđường chỉ tỉ mỉ tăng độ bền cho đôi giày này lên rất cao.\u003cbr /\u003eMàu trắng chủ đạo điểm xuyết là các đường sọc mạnh mẽ màu đỏ nổi bật vô cùng thời trang.\u003cbr /\u003e\u003cbr /\u003eĐế giày được thiết kế bằng cao su thiên nhiên và được may toàn bộ đế nên rất chắc chắn,\u003cbr /\u003ethích ứng với sân cỏ và sân trong nhà. Giày thiết kế dành riêng cho bề mặt sân cỏ nhân tạo\u003cbr /\u003evà sân thường với các đường rảnh vừa phải, tránh trơn trượt ngay cả khi bạn chạy trên sân\u003cbr /\u003ecỏ nhân tạo và sân thường đồng thời hỗ trợ tuyệt vời cho những pha xử lý bóng bằng gầm giày,\u003cbr /\u003enhững cú ngoặt bóng siêu nhanh.\u003cbr /\u003e\u003cbr /\u003ePhần lõi trong đôi giày đá bóng Thượng Đình đế đinh màu trắng là lớp vải mềm giúp thấm hút\u003cbr /\u003emồ hôi và tạo sự thông thoáng cho đôi chân, không gây mùi khó chịu khi sử dụng.\u003cbr /\u003eChất liệu cao su thiên nhiên tạo sự đàn hồi nhất định cho đôi giày, mang đến cảm giác êm ái\u003cbr /\u003ethoải mái khi sử dụng sản phẩm.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/d3/df/ce/0a