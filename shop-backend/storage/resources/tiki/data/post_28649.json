u003cstrong\u003eLƯU Ý: \u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eChỉ dùng cho chó mèo.\u003c/li\u003e\n\u003cli\u003eNơi khô thoáng, nhiệt độ không quá 30 độ C.\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e\u003cp\u003eSản phẩm này là tài sản cá nhân được bán bởi Nhà Bán Hàng Cá Nhân và không thuộc đối tượng phải chịu thuế GTGT. Do đó hoá đơn VAT không được cung cấp trong trường hợp này.\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/40/0d/78/b484b7a52de6a3212e628b15f5b7bba8.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/40/0d/78/b484b7a52de6a3212e628b15f5b7bba8.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/40/0d/78/b484b7a52de6a3212e628b15f5b7bba8.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/40/0d/78/b484b7a52de6a3212e628b15f5b7bba8.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/40/0d/78/b484b7a52de6a3212e628b15f5b7bba8.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/e8/52/83/affc49e39c64c2e0d869149f9ba3731a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e8/52/83/affc49e39c64c2e0d869149f9ba3731a.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e8/52/83/affc49e39c64c2e0d869149f9ba3731a.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e8/52/83/affc49e39c64c2e0d869149f9ba3731a.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e8/52/83/affc49e39c64c2e0d869149f9ba3731a.jpg"}],"warranty_policy":null,"brand":{"id":49012,"name":"Bio","slug":"bio-bio"},"current_se