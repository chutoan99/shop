ref":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":19800,"discount_rate":2,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/e9/64/b3/21d49e6ea3fc408009ee5bac4f2f574b.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":83,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eThông số kỹ thuật:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eThương hiệu: WILIT\u003cbr /\u003eMô hình: U2C\u003cbr /\u003eNguồn điện: DC5V / 1A\u003cbr /\u003eBóng điện: 5W\u003cbr /\u003eVật liệu: nhựa ABS + ống silicone\u003cbr /\u003eMàu: cafe. đen\u003cbr /\u003eCó sẵn bóng đèn LED 5V\u003cbr /\u003eTuổi thọ: 30.000 giờ\u003c/p\u003e\n\u003cp\u003ePin sạc\u003cbr /\u003eKích thước: 90 * 65 * 495mm\u003cbr /\u003eTrọng lượng (đèn, cung cấp điện và gói) : 0,94KG\u003c/p\u003e\n\u003cp\u003eĐèn sản xuất tại Đức với công nghệ led tiên tiến tiết kiệm điện, có độ bền cao lên đến 30.000 giờ. Ánh sáng của đèn Wilit trắng ấm chống loà và thân thiện với môi trường, sử dụng ít năng lượng, thân thiện với môi trường\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eĐặc điểm nổi bật của sản phẩm:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e– Đèn có 3 chế độ điều chỉnh độ sáng bằng thanh cảm ứng tiện lợi giúp lựa chọn ánh sáng tối ưu cho mục đích sử dụng.\u003c/p\u003e\n\u003cp\u003e– Thiết kế hình cổ ngỗng tiện lợi, có thể điều chỉnh các góc đến 150 độ linh động phục vụ cho nhu cầu nằm hoặc ngồi đọc sách.\u003c/p\u003e\n\u003cp\u003e– Đèn cấu tạo bằng chất liệu nhựa ABS và silicon, không có các thành phần bức xạ và độ carbon thấp, an toàn cho sức khỏe người sử dụng.\u003c/p\u003e\n\u003cp\u003e– Đèn Wilit có tích hợp thêm màn hình led hiển thị ngày giờ, nhiệt độ và đặt báo thức. Kiểu dáng đèn gọn gàng hiện đai, phù hợp với mọi không gian sống. Đèn có kèm hướng dẫn sử dụng bằng tiếng Anh và tiếng Đức.\u003c/p\u003e\n\u003cp\u003e– Đèn học chống cận Wilit U2 7W còn có tình năng không ph.át xạ tia U.V làm ảnh hưởng trực tiếp tới làn da của bạn.\u003c/p\u003e\n\u003cp\u003e– Nói không với ánh sáng bức xạ nhiệt rentina, bức x.ạ nhiệt hồng ngoại gây ảnh hưởng tới niêm mạc mắt.\u003c/p\u003e\n\u003cp\u003e– Sử dụng liên tiếp trong nhiều giờ mà không gây ảnh hưởng cho mắt và không gây bỏng \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/e9/64/b3/47292c8cb7ee53addc01d40a6f1d2350.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/e9/64/b3/21d49e6ea3fc408009ee5bac4f2f574b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e9/64/b3/21d49e6ea3fc408009ee5bac4f2f574b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e9/64/b3/21d49e6ea3fc408009ee5bac4f2f574b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e9/64/b3/21d49e6ea3fc408009ee5bac4f2f574b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e9/64/b3/21d49e6ea3fc408009ee5bac4f2f574b.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/30/7b/1c/f3081a9360e12466c54e240140cb84a3.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1