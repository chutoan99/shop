 trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/fc/f1/47/7761ca26dafbec952cff952c6ed86afc.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/fc/f1/47/7761ca26dafbec952cff952c6ed86afc.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/fc/f1/47/7761ca26dafbec952cff952c6ed86afc.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fc/f1/47/7761ca26dafbec952cff952c6ed86afc.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fc/f1/47/7761ca26dafbec952cff952c6ed86afc.jpg"}],"warranty_policy":null,"brand":{"id":152855,"name":"Honda","slug":"honda"},"current_seller":{"id":180553,"sku":"2816348535104","name":"Honda ủy nhiệm Hoàng Việt","link":"https://tiki.vn/cua-hang/honda-uy-nhiem-hoang-viet","logo":"https://vcdn.tikicdn.com/ts/seller/3e/7c/41/812063263dc8516a6cd8d09e6061ebc3.jpg","price":5000000,"product_id":"274076063","store_id":167589,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Thông tin chung","attributes":[{"code":"brakes","name":"Phanh","value":"CBS"},{"code":"brand","name":"Thương hiệu","value":"Honda"},{"code":"brand_country","name":"Xuất xứ thương hiệu","value":"Nhật Bản"},{"code":"origin","name":"Xuất xứ (Made in)","value":"Việt Nam"},{"code":"seller_delivery_method","name":"Phương thức giao hàng Seller Delivery","value":"Khách hàng đến lấy hàng tại nhà bán"},{"code":"is_warranty_applied","name":"Sản phẩm có được bảo hành không?","value":"Có"},{"code":"warranty_form","name":"Hình thức bảo hành","value":"Phiếu bảo hành"},{"code":"warranty_time_period","name":"Thời gian bảo hành","value"