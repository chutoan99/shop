á trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/3e/13/50/dc37efa814ef66cd7eeeeb5944829a34.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/3e/13/50/dc37efa814ef66cd7eeeeb5944829a34.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/3e/13/50/dc37efa814ef66cd7eeeeb5944829a34.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3e/13/50/dc37efa814ef66cd7eeeeb5944829a34.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3e/13/50/dc37efa814ef66cd7eeeeb5944829a34.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/89/31/61/07bf5e0869d051cec6270451658ae82b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/89/31/61/07bf5e0869d051cec6270451658ae82b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/89/31/61/07bf5e0869d051cec6270451658ae82b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/89/31/61/07bf5e0869d051cec6270451658ae82b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/89/31/61/07bf5e0869d051cec6270451658ae82b.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/ee/d1/9d/8ee4d291a0b367bb46a4b68f3f6f5070.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ee/d1/9d/8ee4d291a0b367bb46a4b68f3f6f5070.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ee/d1/9d/8ee4d291a0b367bb46a4b68f3f6f5070.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ee/d1/9d/8ee4d291a0b367bb46a4b68f3f6f5070.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ee/d1/9d/8ee4d291a0b367bb46a4b68f3f6f5070.jpg"}],"warranty_policy":null,"authors":[{"id":709597,"name":"nhieu tac gia","slug":""}],"current_seller":{"id":670,"sku":"3858573002666","name":"Cá Chép Bookstore","link":"https://tiki.vn/cua-hang/ca-chep-boo