:0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/59/dc/a9/e0fa065caa464ad144a1d6987ff7cd9a.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":0,"all_time_quantity_sold":66,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: medium; color: #ff6600;\"\u003e\u003cstrong\u003eBóng Tối Thiên Đường\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eSau những năm tháng bị hành hạ trong trại tập trung tàn khốc trên chính quê hương mình, nhân vật chính của \u003cstrong\u003e\u003cem\u003eBóng tối thiên đường\u003c/em\u003e\u003c/strong\u003e, Robert Ross cuối cùng cũng được an toàn ở Hoa Kỳ. Chính trên miền đất mơ ước của những người tị nạn chiến tranh này, anh đã tìm thấy những gì mà mình hằng mơ ước: một tình yêu cuồng nhiệt với nàng Natasha xinh đẹp và quyến rũ, một công việc với đồng lương hậu hĩnh, một cuộc sống tự do không còn nguy hiểm rình rập… Những tưởng tất cả điều đó sẽ mang lại cho Ross hạnh phúc vĩnh cửu, nhưng bóng đen quá khứ vẫn lẩn khuất trong những giấc mơ hằng đêm; chúng bám lấy anh, thôi thúc anh đi đến quyết định trọng đại nhất cho cuộc đời mình.\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eLà tiểu thuyết sau cùng được viết trong những năm tháng cuối đời ở Thụy Sĩ, \u003cstrong\u003e\u003cem\u003eBóng tối thiên đường \u003c/em\u003e\u003c/strong\u003echính là niềm nhớ thương da diết hướng về quê hương của nhà văn Remarque. Thông qua tác phẩm, ông gửi gắm tình yêu bất tận dành cho đất nước của mình, dù chính mảnh đất ấy đã từng chối bỏ ông.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/59/dc/a9/e0fa065caa464ad144a1d6987ff7cd9a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/59/dc/a9/e0fa065caa464ad144a1d6987ff7cd9a.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/59/dc/a9/e0fa065caa464ad144a1d6987ff7cd9a.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/59/dc/a9/e0fa065caa464ad144a1d6987ff7cd9a.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/59/dc/a9/e0fa065caa464ad144a1d6987ff7cd9a.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/cb/66/93/819cfba112c5da72f7246943558a248f.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/cb/66/93/819cfba112c5da72f7246943558a248f.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/cb/66/93/819cfba112c5da72f7246943558a248f.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/cb/66/93/819cfba112c5da72f7246943558a248f.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/cb/66/93/819cfba112c5da72f7246943558a248f.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/e6/f0/56/dd1d242b2bd14cbd8a7ad3e130cb9300.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e6/f0/56/dd1d242b2bd14cbd8a7ad3e130cb9300.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e6/f0/56/dd1d242b2bd14cbd8a7ad3e130cb9300.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e6/f0/56/dd1d242b2bd14cbd8a7ad3e130cb9300.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e6/f0/56/dd1d242b2bd14cbd8a7ad3e130cb9300.j