_url":"https://salt.tikicdn.com/cache/280x280/ts/product/c6/b5/36/717b3d65e14049cffc8e647f8ddf2dab.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1950,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p style=\"text-align: center; margin: 0px; padding: 8px 0px; white-space: pre-wrap;\"><span data-key=\"6\"><span data-slate-leaf=\"true\" data-offset-key=\"6:0\"><strong>NẾN TINH DẦU THƠM QUẾ NEOP</strong></span></span></p>\n<p style=\"margin: 0px; padding: 8px 0px; white-space: pre-wrap;\"><span data-key=\"9\">Với thành phần chính là Tinh Dầu Quế (Cinnamon Oil), sáp ong và sáp thực vật, 100% thiên nhiên.</span></p>\n<p style=\"margin: 0px; padding: 8px 0px; white-space: pre-wrap;\"><span data-key=\"12\">Mùi Quế thơm nồng, cay ấm, ấm áp, tạo không khí lãng mạn, vừa ấm cúng, vừa thư giãn tinh thần, lại khử mùi cực kỳ hiệu quả...</span></p>\n<p style=\"margin: 0px; padding: 8px 0px; white-space: pre-wrap;\"><span data-key=\"15\">Mục đích sử dụng:</span></p>\n<div data-slate-void=\"true\" data-key=\"16\">\n<div style=\"height: 0px; color: transparent; outline: none; position: absolute;\" data-slate-spacer=\"true\"> </div>\n<div contenteditable=\"false\"> </div>\n</div>\n<p><span data-key=\"18\"> - Khử mùi toilet, nhà bếp, nhà mới xây...</span></p>\n<div data-slate-void=\"true\" data-key=\"19\">\n<div style=\"height: 0px; color: transparent; outline: none; position: absolute;\" data-slate-spacer=\"true\"> </div>\n<div contenteditable=\"false\"> </div>\n</div>\n<p><span data-key=\"21\"> - Làm thơm phòng làm việc, phòng ngủ...</span></p>\n<div data-slate-void=\"true\" data-key=\"22\">\n<div style=\"height: 0px; color: transparent; outline: none; position: absolute;\" data-slate-spacer=\"true\"> </div>\n<div contenteditable=\"false\"> </div>\n</div>\n<p><span data-key=\"24\"> - Khử mùi trong xe ô tô, tủ, vali, túi xách..</span></p>\n<div data-slate-void=\"true\" data-key=\"25\">\n<div style=\"height: 0px; color: transparent; outline: none; position: absolute;\" data-slate-spacer=\"true\"> </div>\n<div contenteditable=\"false\"> </div>\n</div>\n<p><span data-key=\"27\"> - Để bàn thờ cúng.</span></p>\n<div data-slate-void=\"true\" data-key=\"28\">\n<div style=\"height: 0px; color: transparent; outline: none; position: absolute;\" data-slate-spacer=\"true\"> </div>\n<div contenteditable=\"false\"> </div>\n</div>\n<p><span data-key=\"30\"> - Đốt nến khi tỏ tình, lãng mạn...</span></p>\n<div data-slate-void=\"true\" data-key=\"31\">\n<div style=\"height: 0px; color: transparent; outline: none; position: absolute;\" data-slate-spacer=\"true\"> </div>\n<div contenteditable=\"false\"> </div>\n</div>\n<p><span data-key=\"33\"> - Nhỏ gọn dễ mang theo khi đi picnic.</span></p>\n<p> </p>\n<p style=\"margin: 0px; padding: 8px 0px; white-space: pre-wrap;\"><span data-key=\"36\">** Thời gian đốt: từ 16h - 18h</span></p>\n<p style=\"margin: 0px; padding: 8px 0px; white-space: pre-wrap;\"><span data-key=\"39\">** Màu: Nâu đỏ.</span></p>\n<p style=\"margin: 0px; padding: 8px 0px; white-space: pre-wrap;\" data-slate-fragment=\"\"><span data-key=\"42\">*** ƯU ĐIỂM:</span></p>\n<div data-slate-void=\"true\" data-key=\"43\">\n<div style=\"height: 0px; color: transparent; outline: none; position: absolute;\" data-slate-spacer=\"true\"> </div>\n<div contenteditable=\"false\"> </div>\n</div>\n<p><span data-key=\"45\"> - Thành phần hoàn toàn từ thiên nhiên</span></p>\n<div data-slate-void=\"true\" data-key=\"46\">\n<div style=\"height: 0px; color: transparent; outline: none; position: absolute;\" data-slate-spacer=\"true\"> </div>\n<div contenteditable=\"false\"> </div>\n</div>\n<p><span data-key=\"48\"> - Thời gian đốt rất lâu</span></p>\n<div data-slate-void=\"true\" data-key=\"49\">\n<div style=\"height: 0px; color: transparent; outline: none; position: absolute;\" data-slate-spacer=\"true\"> </div>\n<div contenteditable=\"false\"> </div>\n</div>\n<p><span data-key=\"51\"> - Màu sắc đẹp</span></p>\n<div data-slate-void=\"true\" data-key=\"52\">\n<div style=\"height: 0px; color: transparent; outline: none; position: absolute;\" data-slate-spacer=\"true\"> </div>\n<div contenteditable=\"false\"> </div>\n</div>\n<p><span data-key=\"54\"> - Mùi thơm dễ chịu</span></p>\n<div data-slate-void=\"true\" data-key=\"55\">\n<div style=\"height: 0px; color: transparent; outline: none; position: absolute;\" data-slate-spacer=\"true\"> </div>\n<div contenteditable=\"false\"> </div>\n</div>\n<p><span data-key=\"57\"> - Dùng trang trí nhà cửa</span></p>\n<div data-slate-void=\"true\" data-key=\"58\">\n<div style=\"height: 0px; color: transparent; outline: none; position: absolute;\" data-slate-spacer=\"true\"> </div>\n<div contenteditable=\"false\"> </div>\n</div>\n<p><span data-key=\"60\"> - Giá cả hạt dẻ.</span></p>\n<div data-slate-void=\"true\" data-key=\"61\">\n<div style=\"height: 0px; color: transparent; outline: none; position: absolute;\" data-slate-spacer=\"true\"> </div>\n<div contenteditable=\"false\"> </div>\n</div>\n<p><span data-key=\"63\"> - An toàn cho mẹ và bé</span></p>\n<p> </p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/c6/b5/36/717b3d65e14049cffc8e647f8ddf2dab.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c6/b5/36/717b3d65e14049cffc8e647f8ddf2dab.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c6/b5/36/717b3d65e14049cffc8e647f8ddf2dab.jpg","position":null,"smal