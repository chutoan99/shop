ght":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/94/9a/22/d4ff1b2515f19924fea91deefc1c323d.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":765,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eViên rau củ quả DHC Nhật Bản bổ sung 32 loại rau xanh, củ quả cung cấp nhiều dưỡng chất cơ bản cần thiết cho cơ thể, dành cho những bạn bận rộn không có thời gian ăn uống đủ chất, hay những bạn ghét và lười ăn rau, tránh được nhiều căn bệnh như nóng người, nổi mụn, táo bón…\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eThành phần viên uống dhc rau củ Nhật Bản gồm Cellulose, glycerin axit béo và este, silicon  Cà rốt, cà chua, bí ngô, bắp, khoai lang, bắp cải, măng tây; lá củ cải, củ sen và lúa mạch, cải xoăn, hành tây, bí ngô, ngô ngọt, khoai lang tím; tía tô đỏ, rau bina, lá củ cải, hoa sen gốc; Nozawana, bok-choy, cải bắp Trung Quốc; bột rau, hành lá, tỏi, gừng, rau mùi tây, cây ngưu bàng, bông cải xanh; cần tây, lá, mướp đắng, ngải cứu, cỏ linh lăng, đậu xanh, măng tây, tía tô…\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eDành cho:\u003c/p\u003e\n\u003cp\u003eNgười bận rộn khó bổ sung rau xanh vào bữa ăn hàng ngày\u003c/p\u003e\n\u003cp\u003eNgười hay bị táo bón, nổi mụn\u003c/p\u003e\n\u003cp\u003eNgười ăn kiêng, người chỉ ăn được một hoặc 1 vài loại rau\u003c/p\u003e\n\u003cp\u003eNgười lười hoặc ghét ăn rau\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eThành phần trong mỗi 04 viên DHC rau củ gồm:\u003c/p\u003e\n\u003cp\u003eNăng lượng: 6.6kcal\u003c/p\u003e\n\u003cp\u003eProtein: 0.23g\u003c/p\u003e\n\u003cp\u003eChất béo: 0.12g\u003c/p\u003e\n\u003cp\u003eCarbohydrate 1.48g (Đường: 0.82g, Chất xơ 0.66g)\u003c/p\u003e\n\u003cp\u003eNatri Clorua: 0.003g Vitamin E ( d-α- tocopherol) 5mg\u003c/p\u003e\n\u003cp\u003e32 loại rau: 1730mg\u003c/p\u003e\n\u003cp\u003eAxit lactic \u0026amp; nấm men khử trùng: 1mg\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eBảo quản: Nơi khô ráo, thoáng mát, tránh ánh sáng mặt trời.\u003c/p\u003e\n\u003cp\u003eHạn dùng: 36 tháng kể từ ngày sản xuất. Sử dụng tốt nhất trước thời gian ghi trên bao bì. Hạn sử dụng ghi theo định dạng “năáng”\u003c/p\u003e\n\u003cp\u003eHiệu quả sử dụng sản phẩm còn tùy thuộc cơ địa mỗi người\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eLưu ý:\u003c/p\u003e\n\u003cp\u003eSản phẩm không phải là thuốc không có tác dụng thay thế thuốc chữa bệnh\u003c/p\u003e\n\u003cp\u003eSử dụng sau bữa ăn sẽ dễ dàng được tiêu hóa và hấp thụ.\u003c/p\u003e\n\u003cp\u003eKhông uống quá liều hướng dẫn\u003c/p\u003e\n\u003cp\u003e+Nếu đang điều trị bệnh hay đang uống thuốc, đang có thai nên hỏi ý kiến bác sĩ trước khi sử dụng.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eThương hiệu: DHC\u003c/p\u003e\n\u003cp\u003eXuất Xứ: Nhật Bản\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e#vien #uong #rau #cu #qua #dhc #vegetable\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/94/9a/22/d4ff1b2515f19924fea91deefc1c323d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/94/9a/22/d4ff1b2515f19924fea91deefc1c323d.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/94/9a/22/d4ff1b2515f19924fea91deefc1c323d.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/94/9a/22/d4ff1b2515f19924fea91deefc1c323d.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/94/9a/22/d4ff1b2515f19924fea91deefc1c323d.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/38/3e/86/ccd921b447e267f9c9c8aff1bb682c66.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/38/3e/86/ccd921b447e267f9c9c8aff1bb682c66.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/38/3e/86/ccd921b447e267f9c9c8aff1bb682c66.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/38/3e/86/ccd921b447e267f9c9c8aff1bb682c66.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/38/3e/86/ccd921b447e267f9c9c8aff1bb682c66.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/5c/c0/5e/c2404578799a449d7f3c181f9518129a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/5c/c0/5e/c2404578799a449d7f3c181f9518129a.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/5c/c0/5e/c2404578799a449d7f3c181f9518129a.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5c/c0/5e/c2404578799a449d7f3c181f9518129a.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5c/c0/5e/c2404578799a449d7f3c181f9518129a.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/a6/00/0b/9061eb3e39efe66f123a232a418f009b.jpg","is_gallery":true,"label":