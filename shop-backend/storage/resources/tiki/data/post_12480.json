ating_average":3.4,"review_count":11,"review_text":"(11)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/93/14/99/4998747c5bc78adbd448566d387f0fc7.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2528,"all_time_quantity_sold":162,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p><img src=\"https://salt.tikicdn.com/ts/tmp/7c/19/6d/3b8d9c2126921896bad04156fcd5170d.jpg\" alt=\"Máy Đưa Võng Tự Động Vinanoi A100\" width=\"750\" height=\"431\" /></p>\n<p><img src=\"https://salt.tikicdn.com/ts/tmp/6f/11/cc/62e4f570a17a49df20d53b2cb0277d98.jpg\" alt=\"Máy Đưa Võng Tự Động Vinanoi A100\" width=\"750px\" height=\"431px\" /></p>\n<p><img src=\"https://salt.tikicdn.com/ts/tmp/ea/cd/37/3b9dbea7f1ac3521106de41532334d00.jpg\" alt=\"Máy Đưa Võng Tự Động Vinanoi A100\" width=\"750px\" height=\"431px\" /></p>\n<p><img src=\"https://salt.tikicdn.com/ts/tmp/dc/ba/41/ce654f6151ca32c4e6f7d2c0c32800d7.jpg\" alt=\"Máy Đưa Võng Tự Động Vinanoi A100\" width=\"750px\" height=\"431px\" /></p>\n<p><img src=\"https://salt.tikicdn.com/ts/tmp/a9/9e/d8/3acf6d9de2f84c3e553d029946b37d0a.jpg\" alt=\"Máy Đưa Võng Tự Động Vinanoi A100\" width=\"750px\" height=\"431px\" /></p>\n<p><img src=\"https://salt.tikicdn.com/ts/tmp/75/07/f6/48c47c6977ce7fe2a7bddef9413aff35.jpg\" alt=\"Máy Đưa Võng Tự Động Vinanoi A100\" width=\"750px\" height=\"431px\" /></p>\n<p><img src=\"https://salt.tikicdn.com/ts/tmp/11/5c/41/7cb4373d44482583d92435384975c0f3.jpg\" alt=\"Máy Đưa Võng Tự Động Vinanoi A100\" width=\"750px\" height=\"431px\" /></p>\n<ol>\n<li><strong>Máy Đưa Võng Tự Động Vinanoi A100</strong> được thiết kế nhằm giúp mẹ của bé có thể có nhiều thời gian để chăm lo việc nhà mà không tốn quá nhiều thời gian cho việc đưa võng cho bé.</li>\n<li>Máy có sức đưa mạnh mẽ lên đến 100 kg giúp người sử dụng có thể chìm sâu vào giấc ngủ.</li>\n<li>Máy đưa võng có khả năng vận hành êm ái, nhịp đưa đều giữ cho giấc ngủ được sâu hơn và ngon hơn.</li>\n<li>Với chất liệu sắt không gỉ giúp cho máy bền hơn, hạn chế sự oxi hóa kim loại.</li>\n<li>Máy nhỏ gọn và dễ lắp đặt giúp người sử dụng thuận tiện lắp vào võng khi có nhu cầu và có thể cất gọn không tốn nhiều diện tích nhà cửa.</li>\n<li>\n<h2 style=\"text-align: left;\"><strong>ĐẶC ĐIỂM NỔI BẬT</strong><br /><strong> 1. Mạnh mẽ với sức đưa 100kg</strong><br /><strong> Được cải tiến với khả năng chịu lực và sức đưa đến 100kg, mẹ và bé có thể thoải mái tận hưởng những giây phút thư giãn tuyệt vời trên võng cùng nhau. Và không chỉ mẹ và bé, mọi thành viên trong gia đình đều có thể sử dụng chiếc máy hiện đại này để dễ dàng có được giấc ngủ say mà không phải tốn chút sức lực.</strong></h2>\n</li>\n<li style=\"text-align: left;\">\n<h2><strong>2. Vận hành êm ái, bền bỉ</strong><br /><strong> Một đặc điểm nổi bật ở <em>Máy đưa võng tự động em bé và người lớn A100</em> là sử dụng 2 bạc đạn cho độ bền và cân bằng tốt nhất. Với cải tiến kỹ thuật, máy sẽ giảm tối đa độ lắc, chống giật, cực đầm và êm ái, không gây khó chịu. Đồng thời, thời gian sử dụng cho máy cũng được gia tăng đáng kể.</strong></h2>\n<h3><strong>3. Dễ điều chỉnh biên độ mạnh nhẹ</strong><br /><strong> Máy đưa võng tự động A100 được trang bị adapter bằng IC giúp tùy ý điều chỉnh biên độ mạnh nhẹ dễ dàng như vặn volume. Với 6 nấc điều chỉnh khác nhau, máy sẽ mang đến cho người dùng trải nghiệm đa dạng hoàn toàn khác biệt.</strong></h3>\n</li>\n<li>\n<h3 style=\"text-align: left;\"><strong>4. An toàn – Tiết kiệm</strong><br /><strong> Máy sử dụng bộ biến điện DC chuyển đổi dòng điện vào 220V DC thành dòng 5-15V AC, đảm bảo an toàn khi sử dụng điện. Thiết kế linh động phù hợp với nhiều loại khung võng có mặt trên thị trường, tháo lắp dễ dàng đến ngay cả chị em phụ nữ cũng có thể thực hiện trong 30s.</strong><br /><strong>Hơn thế nữa, với công nghệ hiện đại, <em>Máy đưa võng tự động em bé và người lớn A100</em> chỉ có công suất tiêu thụ điện ở mức 3W. Với một năm sử dụng, cả nhà chỉ tiêu tốn tối đa 9Kwh điện cho máy. Vì thế, mọi người có thể tha hồ đung đưa trên chiếc võng hiện đại mà không cần lo lắng về việc hao phí điện.</strong></h3>\n</li>\n</ol><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/93/14/99/4998747c5bc78adbd448566d387f0fc7.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/93/14/99/4998747c5bc78adbd448566d387f0fc7.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/93/14/99/4998747c5bc78adbd448566d387f0fc7.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/93/14/99/4998747c5bc78adbd448566d387f0fc7.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/93/14/99/4998747c5bc78adbd448566d387f0fc7.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/7d/ad/14/1effb185690fb65648f989c1068a8ccf.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/7d/ad/14/1effb185690fb65648f989c1068a8ccf.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/7d/ad/14/1effb185690fb65648f989c1068a8ccf.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7d/ad/14/1effb185690fb65648f989c1068a8ccf.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7d/ad/14/1effb185690fb65648f989c1068a8ccf.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/49/7d/68/f7555c9efdc62a7dc7d44a5c96b4bc07.jpg","is_gallery":true,"label":null,"large_u