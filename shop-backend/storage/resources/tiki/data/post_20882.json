"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":11000,"discount_rate":5,"rating_average":4.7,"review_count":65,"review_text":"(65)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/55/ca/4e/075bf99dd587e8c53fc36c6fdc9ce95c.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1653,"all_time_quantity_sold":263,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eXin chào mọi người, mình là Huyền Vy, hiện đang học tập và sinh sống tại Nhật. Đây là Shop của mình, các sản phẩm đều do mình trực tiếp liên lạc với nhà phân phối Nhật và sau đó là tại Việt Nam để được phép đăng những dòng sản phẩm có đầy đủ nguồn gốc rõ ràng và giá cả tốt nhất cho mọi người ạ. Nếu bạn nào có thắc mắc thì hãy liên lạc với mình để mình tư vấn tận tình cho nha. Yêu mọi người nhiều ạ. :)\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/55/ca/4e/7b26436927b39edbfda19a685500835a.jpg\" alt=\"\" width=\"500\" height=\"500\" /\u003e\u003cspan style=\"color: #ff0000;\"\u003e\u003cstrong\u003eKem mắt hỗ trợ trị thâm, làm mờ nếp nhăn mắt Meishoku Whitening Eye Cream\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e“Đôi mắt là cửa sổ tâm hồn” những vết thâm quầng mắt và nếp nhăn không ảnh hưởng đến sức khỏe nhưng lại ảnh hưởng đến vẻ đẹp tự nhiên của bạn vì phần lớn thời gian khi giao tiếp của chúng ta là thông qua ánh mắt. Kem mắt Meishoku Whitening Eye Cream là sản phẩm rất được ưa chuộng tại Nhật Bản. Nó vừa bổ sung nhau thai giúp giảm thâm sạm vùng da quanh mắt, vừa bổ sung vitamin E chống lão hoá hiệu quả, cải thiện các nếp nhăn, bọng mắt, giảm tình trạng da quanh mắt nhăn nheo, chảy xệ.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/cb/95/9e/ab7729ea07bc138e892d3885df73a629.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eTHÀNH PHẦN VÀ CÔNG DỤNG\u003c/p\u003e\n\u003cp\u003eVới thành phần chủ yếu chiết xuất từ nhau thai - placenta extract, dẫn xuất vitamin E - tocopherol acetate, kem mắt Meishoku giúp giải quyết các khuyết điểm của vùng da quanh mắt như:\u003c/p\u003e\n\u003cp\u003e️ Hết thâm quầng mắt: chiết xuất nhau thai cùng vitamin E nhẹ nhàng thẩm thấu sâu vào da ngăn chặn sự hình thành và phân tán của hắc sắc tố melanin, từ đó xóa bỏ vết thâm quầng giúp vùng da quanh mắt sáng hồng, mịn màng.\u003c/p\u003e\n\u003cp\u003e️ Xóa mờ nếp nhăn: sự kết hợp của thành phần chống oxy hóa, chống lão hóa từ nhau thai, cùng Yokuininekisu giúp thúc đẩy quá trình trao đổi chất, xóa mờ nếp nhăn, giảm chảy xệ, ngăn ngừa xuất hiện vết chân chim.\u003c/p\u003e\n\u003cp\u003e️ Đánh tan bọng mắt: Kem Meishoku cũng chứa các hoạt chất kích thích mạnh tuần hoàn máu khu vực quanh mắt giúp đôi mắt nhìn có sức sống và trẻ trung hơn.\u003c/p\u003e\n\u003cp\u003e️ Đặt biệt, sử dụng tốt cho cả vùng da quanh miệng để giảm nếp nhăn.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ce/ce/53/c36dcb0d4324fcb7a62693c6bbdbca46.jpg\" alt=\"\" width=\"600\" height=\"600\" /\u003e\u003c/p\u003e\n\u003cp\u003eHƯỚNG DẪN SỬ DỤNG\u003c/p\u003e\n\u003cp\u003eBạn chỉ cần rửa mặt sạch, bôi một lớp mỏng kem Meishoku vào vùng da quanh mắt. Sau đó, dùng ngón áp út massage nhẹ nhàng theo đường tròn và xuất phát từ đầu khóe mắt, đi lên rồi dần xuống đuôi mắt.\u003c/p\u003e\n\u003cp\u003eDùng đều đặn, ngày dùng 2 lần sáng và tối để mang đến hiệu quả tối ưu nhất.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/2b/57/b8/1f0c6e9fd0402301e27ba691874356e7.jpg\" alt=\"\" width=\"576\" height=\"576\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/55/ca/4e/075bf99dd587e8c53fc36c6fdc9ce95c.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/55/ca/4e/075bf99dd587e8c53fc36c6fdc9ce95c.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/55/ca/4e/075bf99dd587e8c53fc36c6fdc9ce95c.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/55/ca/4e/075bf99dd587e8c53fc36c6fdc9ce95c.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/55/ca/4e/075bf99dd587e8c53fc36c6fdc9ce95c.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/cb/95/9e/a4c16e51093b4c4b550706d9eb869397.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/cb/95/9e/a4c16e51093b4c4b550706d9eb869397.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/cb/95/9e/a4c16e51093b4c4b550706d9eb869397.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/cb/95/9e/a4c16e51093b4c4b550706d9eb869397.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/cb/95/9e/a4c16e51093b4c4b550706d9eb869397.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/ce/ce/53/0bd4493dba432fb73b940d2dc125f25e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ce/ce/53/0bd44