olor":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/96/39/d8/7bea980be1a0cd16660b9ee2cc022867.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":709,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eĐặc điểm nổi bật:\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eCông nghệ Sensorwash với cảm biến AI thông minh loại bỏ đến 49 loại vết bẩn*\u003c/li\u003e\n\u003cli\u003eCông nghệ UltraMix giặt sạch sâu, không cặn giặt tẩy*.\u003c/li\u003e\n\u003cli\u003eCông nghệ giặt hơi nước HygienicCare diệt 99.9% vi khuẩn và chất gây dị ứng*\u003c/li\u003e\n\u003cli\u003eNhiều chương trình giặt nhanh 15ph, 39ph, 60ph linh hoạt\u003c/li\u003e\n\u003cli\u003eKết nối Wifi, tư vấn chăm sóc quần áo chuyên nghiệp\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/d8/6e/81/4037e71e9f8690f936465fda2f2d9720.jpg\" width=\"750\" height=\"750\" alt=\"eww1142q7wb-vn-insit-1500x1500.jpg\" /\u003e\u003c/p\u003e\n\u003ch2 class=\"benefit-module-content_title\"\u003eGiặt sạch 49 loại vết bẩn*\u003c/h2\u003e\n\u003cdiv class=\"benefit-module-content_description-container p-relative\"\u003e\n\u003cdiv class=\"benefit-module-content_description -read-more js-benefit-description mgr-md-30 -expand ps\"\u003eGiặt sạch nhiều loại vết bẩn cứng đầu dễ dàng mà không cần ngâm giặt trước. Hệ thống cảm biến kép AI thông minh đo độ bẩn \u0026amp; cặn chất giặt trên quần áo để tự động điều chỉnh chu trình giặt xả phù hợp, đảm bảo làm sạch hóa chất và 49 loại vết bẩn cứng đầu như dầu ăn, rượu vang đỏ, bùn đất và sôcôla.*\u003cbr /\u003e\u003cbr /\u003e\u003cem\u003e*Đã được kiểm nghiệm trên 4.5kg quần áo với 5cm² vết bẩn từ thức ăn, hóa chất, bùn đất... với chương trình giặt Đồ Cotton 40°C và vết ố. Kết quả có thể thay đổi tùy vào khối lượng đồ, loại và thời gian dính bẩn, loại chất giặt tẩy và áp lực nước.\u003c/em\u003e\u003c/div\u003e\n\u003cdiv class=\"benefit-module-content_description -read-more js-benefit-description mgr-md-30 -expand ps\"\u003e\n\u003ch2 class=\"benefit-module-content_title\"\u003eTạm biệt cặn chất giặt tẩy*\u003c/h2\u003e\n\u003cdiv class=\"benefit-module-content_description-container p-relative\"\u003e\n\u003cdiv class=\"benefit-module-content_description -read-more js-benefit-description mgr-md-30 -expand ps\"\u003eCông nghệ UltraMix hòa tan hoàn toàn chất giặt và xả trước khi cho vào lồng giặt giúp giặt sạch sâu, không cặn hóa chất trên quần áo và không cần giặt đi giặt lại nhiều lần*.\u003cbr /\u003e\u003cbr /\u003e\u003cem\u003e*Đã được kiểm nghiệm với 3kg hỗn hợp áo phông và áo sơ mi màu với lượng chất giặt tẩy được đề xuất. Chương trình có thể khác nhau tùy thuộc vào tải trọng quần áo, loại chất tẩy và áp lực nước.\u003c/em\u003e\u003c/div\u003e\n\u003cdiv class=\"benefit-module-content_description -read-more js-benefit-description mgr-md-30 -expand ps\"\u003e\n\u003ch2 class=\"benefit-module-content_title\"\u003eDiệt khuẩn tối ưu bằng hơi nước\u003c/h2\u003e\n\u003cdiv class=\"benefit-module-content_description-container p-relative\"\u003e\n\u003cdiv class=\"benefit-module-content_description -read-more js-benefit-description mgr-md-30 -expand ps\"\u003eKết thúc chu trình giặt, công nghệ HygienicCare sẽ phun vào lồng giặt hơi nước để loại bỏ đến 99.9% vi khuẩn \u0026amp; tác nhân gây dị ứng.*Công nghệ tạo hơi nước chỉ ở 40°C nên nhẹ nhàng với sợi vải và tiết kiệm năng lượng.\u003cbr /\u003e\u003cbr /\u003e\u003cem\u003e*Công nghệ HygienicCare giúp loại bỏ 99.2% tác nhân gây dị ứng như Der f1 (mạt bụi), Fel d1 (có ở mèo), đồng thời giảm đến 99.9% vi khuẩn Staphylococcus aureus, Klebsiella pneumonia khi giặt ở 40°C, chương trình giặt đồ Cotton\u003c/em\u003e\u003c/div\u003e\n\u003cdiv class=\"benefit-module-content_description -read-more js-benefit-description mgr-md-30 -expand ps\"\u003e\n\u003ch2 class=\"benefit-module-content_title\"\u003eGiảm nhăn và làm mới trang phục\u003c/h2\u003e\n\u003cdiv class=\"benefit-module-content_description-container p-relative\"\u003e\n\u003cdiv class=\"benefit-module-content_description -read-more js-benefit-description mgr-md-30 -expand ps\"\u003eNhanh chóng làm mới trang phục và giảm nhăn nhờ chương trình VapourRefresh chỉ trong 30 phút. Áo quần của bạn sẽ mềm mại và thơm mới, ít nhăn hơn tới 23% so với phơi khô thông thường*.\u003cbr /\u003e\u003cbr /\u003e\u003cem\u003e*Ít nhăn hơn 23%, so sánh chu trình giặt hơi nước của sản phẩm EWF9025BQWA với phơi khô thông thường - Thử nghiệm và chứng nhận bởi THTI\u003c/em\u003e\u003c/div\u003e\n\u003cdiv class=\"benefit-module-content_description -read-more js-benefit-description mgr-md-30 -expand ps\"\u003e\n\u003ch2 class=\"benefit-module-content_title\"\u003eGiặt nhanh tiện lợi và linh hoạt\u003c/h2\u003e\n\u003cdiv class=\"benefit-module-content_description-container p-relative\"\u003e\n\u003cdiv class=\"benefit-module-content_description -read-more js-benefit-description mgr-md-30 -expand ps\"\u003eChế độ giặt nhanh đáp ứng linh hoạt theo từng nhu cầu và lịch trình của bạn. Chương trình Giặt 15 Phút giặt sạch hiệu quả với lượng nhỏ quần áo hoặc các món đồ riêng lẻ. Chương trình Giặt 39 Phút là lựa chọn lý tưởng khi bạn giặt đồ bẩn mỗi ngày. Nếu bạn có lượng quần áo đầy như thông thường, hãy chọn chương trình Đầy Lồng Giặt 60 Phút.\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/96/39/d8/7bea980be1a0cd16660b9ee2cc022867.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/96/39/d8/7bea980be1a0cd16660b9ee2cc022867.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/96/39/d8/7bea980be1a0cd16660b9ee2cc022867.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/96/39/d8/7bea980be1a0cd16660b9ee2cc022867.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/96/39/d8/7bea980be1a0cd16660b9ee2cc022867.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/ed/9c/63/923d09078a7dd8611598d3d3ad1c205c.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ed/9c/63/923d09078a7dd8611598d3d3ad1c205c.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ed/9c/63/923d09078a7dd8611598d3d3ad1c205c.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ed/9c/63/923d09078a7dd8611598d3d3ad1c205c.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ed/9c/63/923d09078a7dd8611598d3d3ad1c205c.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/7d/52/3e/4467822a08a4beb0ebe8ae7541929dd6.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/7d/52/3e/4467822a08a4beb0ebe8ae7541929dd6.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/7d/52/3e/4467822a08a4beb0ebe8ae7541929dd6.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7d