 trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/00/38/8a/fc92d18660eda37000a824800e7f5916.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/00/38/8a/fc92d18660eda37000a824800e7f5916.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/00/38/8a/fc92d18660eda37000a824800e7f5916.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/00/38/8a/fc92d18660eda37000a824800e7f5916.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/00/38/8a/fc92d18660eda37000a824800e7f5916.png"},{"base_url":"https://salt.tikicdn.com/ts/product/85/a1/e5/02bd22d728150d1a36c6e29256638ead.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/85/a1/e5/02bd22d728150d1a36c6e29256638ead.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/85/a1/e5/02bd22d728150d1a36c6e29256638ead.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/85/a1/e5/02bd22d728150d1a36c6e29256638ead.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/85/a1/e5/02bd22d728150d1a36c6e29256638ead.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/f9/64/37/a4b6384ddd480a50a3518c92322f5d4f.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f9/64/37/a4b6384ddd480a50a3518c92322f5d4f.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f9/64/37/a4b6384ddd480a50a3518c92322f5d4f.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f9/64/37/a4b6384ddd480a50a3518c92322f5d4f.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x28