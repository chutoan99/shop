rite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/9d/ed/d5/b158fd0110c9b05cd4c56a5605f7f239.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":793,"all_time_quantity_sold":4,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eCông suất: (W) 4.8W\u003c/p\u003e\n\u003cp\u003eMàu sắc: Trắng-Hồng\u003c/p\u003e\n\u003cp\u003eĐộ ồn :30 - 40dB\u003c/p\u003e\n\u003cp\u003e Pin : 3.7V 7200mAh\u003c/p\u003e\n\u003cp\u003eĐóng gói : 1 cái/thùng\u003c/p\u003e\n\u003cdiv\u003eChính sách bảo hành: 9 tháng\u003c/div\u003e\n\u003cdiv\u003e\n\u003cdiv\u003e\u003cstrong\u003eQuạt sạc gấp gọn Nanoco\u003c/strong\u003e là sự pha trộn tuyệt vời của tính năng làm mát nhanh, gọn nhẹ, không dây và hoạt động yên tĩnh. Với chiếc quạt sạc này, người dùng sẽ dễ dàng di chuyển quạt đi bất kể nơi đâu mà không tốn nhiều sức. Trọng lượng quạt chỉ 0,8kg, khi gấp gọn lại quạt chỉ còn 20 cm nên dễ dàng xếp vào balo, vali mà không chiếm quá nhiều chỗ.\u003c/div\u003e\n\u003cdiv\u003eĐiểm đặc biệt nhất của sản phẩm đó chính là phần thân có thể gấp gọn hoặc nâng cao lên dễ dàng nhờ vào khớp nối được làm bằng hợp kim nhôm. Nhờ đó, phần thân có thể thay đổi linh hoạt cũng như chắc chắn mà không bị lung lay.\u003c/div\u003e\n\u003cdiv\u003eKhông chỉ thế, dung lượng pin lithium lên tới 7200mAh, giúp quạt có thể sử dụng bền bỉ suốt ngày dài, mang lại cho bạn những trải nghiệm tốt nhất khi không có nguồn điện.\u003c/div\u003e\n\u003cdiv\u003eQuạt sạc gấp gọn mặc dù có kích cỡ nhỏ, nhẹ nhưng cánh quạt tương đối to với 3 cánh, đảm bảo cung cấp luồng gió mát tuyệt đối cho căn phòng nơi bạn cần.\u003c/div\u003e\n\u003cdiv\u003eMột ưu điểm nữa khiến nhiều người quyết định chọn sản phẩm này là bởi tính năng vận hành êm ái, không gây ồn với cấp độ 3 là 40dB.\u003c/div\u003e\n\u003cdiv\u003eChất liệu là nhựa cao cấp ABS và hợp kim nhôm nên quạt rất cứng cáp, bền bỉ, an toàn và không độc hại đến sức khỏe người sử dụng. Quạt có 2 màu sắc để cho bạn lựa chọn là Hồng và Trắng.\u003c/div\u003e\n\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/9d/ed/d5/b158fd0110c9b05cd4c56a5605f7f239.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/9d/ed/d5/b158fd0110c9b05cd4c56a5605f7f239.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/9d/ed/d5/b158fd0110c9b05cd4c56a5605f7f239.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9d/ed/d5/b158fd0110c9b05cd4c56a5605f7f239.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9d/ed/d5/b158fd0110c9b05cd4c56a5605f7f239.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/92/32/8f/95859a8839a0ff4e5138a4389e839e6d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/92/32/8f/95859a8839a0ff4e5138a4389e839e6d.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/92/32/8f/95859a8839a0ff4e5138a4389e839e6d.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/92/32/8f/95859a8839a0ff4e5138a4389e839e6d.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/92/32/8f/95859a8839a0ff4e5138a4389e839e6d.jpg"}],"warranty_policy":null,"brand":{"id":413827,"name":"Nanoco","slug":"nanoco"},"current_seller":{"id":229550,"sku":"4212786359310","name":"ĐiệnTânThịnh","link":"https://tiki.vn/cua-hang/dientant