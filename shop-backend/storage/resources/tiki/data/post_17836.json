rate":6,"rating_average":4.7,"review_count":146,"review_text":"(146)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/47/05/6a/f7f209297730723f15828ca5b4cb5818.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1245,"all_time_quantity_sold":611,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cdiv class=\"product-detail page-product__detail\"\u003e\n\u003csection class=\"U9rGd1\"\u003e\n\u003cdiv class=\"MCCLkq\"\u003e\n\u003cdiv class=\"f7AU53\"\u003e\n\u003cp class=\"irIKAp\"\u003eKhi mua 1 chai Mật ong nguyên chất Hoa Rừng Phương Nam 630g sẽ được tặng kèm 1 hũ cùng loại 360g\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e----------------------------------------------------------------\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eMật ong Rừng Nhiệt Đới và Honimore là 2 thương hiệu thuộc sở hữu của Công ty TNHH Zemlya, với hơn 40 năm kinh nghiệm trong sản xuất mật ong. Các sản phẩm thuộc 2 thương hiệu này hiện đã có mặt ở tất cả các hệ thống siêu thị lớn của Việt Nam và nước ngoài.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eCác con ong được nuôi tại rừng tràm nước tại Long An, Đồng Tháp Mười, hoa nhãn Tiền Giang, hoa chôm chôm, hoa tràm nước. Với điều kiện địa lý khắc nghiệt, đất ngập mặn, mùa mưa Nam Bộ lại kéo dài 6 tháng nên những cánh rừng tràm cho mật màu nâu đỏ, hương nồng nàn, vị đậm đà rất mạnh.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cdiv class=\"irIKAp\"\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"cxDtMn\"\u003e\u003cimg class=\"_0O7Vlf bgImIg\" src=\"https://down-vn.img.susercontent.com/file/vn-11134208-7qukw-limgey0tcu8c1e\" alt=\"vn-11134208-7qukw-limgey0tcu8c1e\" /\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eI. THÔNG TIN SẢN PHẨM\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Tên sản phẩm: Mật Ong Nguyên Chất Hoa Rừng Phương Nam\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Thương hiệu: Honimore\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Khu vực khai thác mật ong: Rừng tràm nước ở Bến Tre, Tiền Giang và Kiên Giang\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Thành phần: 100% mật ong nguyên chất\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Nhà sản xuất: Công ty TNHH Zemlya\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Quy cách đóng gói: Chai thủy tinh và hũ thủy tinh\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Khối lượng: từ 360g đến 630g\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Hạn sử dụng: 36 tháng kể từ ngày sản xuất\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Chứng nhận Vệ sinh an toàn thực phẩm số 5331/2020/BQLATTPHCM do Ban quản lí An toàn thực phẩm TPHCM cấp ngày 15/12/2020\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Giấy kiểm nghiệm số AR-23-VD-042972-01 được cấp bởi Eurofins\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eII. ĐẶC ĐIỂM NỔI BẬT\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Mật ong rừng nguyên chất Hoa Rừng Phương Nam khác với các loại mật ong trôi nổi, không nhãn mác trên thị trường đó là chỉ khai thác các cầu ong đủ độ chín, vít nắp sáp 100% mới cho thu hoạch.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Mật ong chín được các con ong loại bỏ hoàn toàn 100% nước ra khỏi mật, tạo nên một loại mật dẻo, đặc sánh và có thể bảo quản lâu mà không bị lên men.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Những con ong lấy mật từ các cây tràm nước tạo ra loại mật có màu nâu đỏ với vị ngọt đậm mạnh mẽ (vượt trội hơn so với mật ong hoa nhãn và mật ong hoa vải).\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Nhờ vị ngọt đậm đà nên khi kết hợp với chanh đào có vị chua làm nên một loại thức uống chua ngọt giải nhiệt hiệu quả vào mùa hè nắng nóng.\u003c/p\u003e\n\u003cdiv class=\"irIKAp\"\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"cxDtMn\"\u003e\u003cimg class=\"_0O7Vlf bgImIg\" src=\"https://down-vn.img.susercontent.com/file/vn-11134208-7qukw-lhiggvujgpttf2\" alt=\"vn-11134208-7qukw-lhiggvujgpttf2\" /\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eIII. CÔNG DỤNG/ ỨNG DỤNG\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Mật ong Hoa Rừng Phương Nam có thể kết hợp các loại thực phẩm từ thiên nhiên như nghệ, bột trà xanh, cám gạo làm trắng sáng da, mịn da, xóa mờ nám da, tẩy da chết, xóa vết thâm mụn hiệu quả\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Mật ong nguyên chất giúp cải thiện hệ tiêu hóa và tăng cường hệ miễn dịch\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Pha mật ong Hoa Rừng Phương Nam với nước ấm uống trước khi ngủ giúp tăng cường chất lượng giấc ngủ\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Nhờ vị ngọt cao có thể dùng chế biến, làm gia vị nấu nướng thay cho đường và tạo màu nâu bắt mắt cho món ăn\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Kết hợp với cam, chanh, chanh dây, nước ép trái cây, trà xanh… bổ sung năng lượng và vitamin cho cơ thể sau ngày dài vận động\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e*** Lưu ý: Không dùng cho trẻ em dưới 1 tuổi.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e                 Người bị bệnh tiểu đường không nên dùng mật ong thường xuyên nhưng lại rất cần bổ sung một muỗng mật ong khi bị hạ đường huyết.\u003c/p\u003e\n\u003cdiv class=\"irIKAp\"\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"cxDtMn\"\u003e\u003cimg class=\"_0O7Vlf bgImIg\" src=\"https://down-vn.img.susercontent.com/file/vn-11134208-7qukw-limgey0te8ss7e\" alt=\"vn-11134208-7qukw-limgey0te8ss7e\" /\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eIV. BẢO QUẢN\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Bảo quản nơi khô ráo và thoáng mát. Không bảo quản lạnh vì mật ong có thể đóng băng hay kết tinh. Khi gặp trường hợp như vậy, hãy lấy chai/hũ mật ong ngâm vào nước nóng 70 độ C trong 30 phút (lưu ý, giữ đúng nhiệt độ 70 độ trong suốt quá trình này), mật ong sẽ trở về trạng thái như ban đầu và không ảnh hưởng đến chất lượng.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Tránh ánh sáng trực tiếp, không để ở sát bếp, nơi có nhiệt độ cao.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eV. CAM KẾT VÀ CHÍNH SÁCH ĐỔI TRẢ HÀNG\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Cam kết hoàn tiền 200% nếu khách hàng phát hiện pha đường\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Đổi trả hàng trong các trường hợp sản phẩm bị nhầm lẫn, bị lỗi hoặc bị bể, vỡ khi nhận hàng\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Sản phẩm có Hồ sơ công bố, đạt tiêu chuẩn An toàn vệ sinh thực phẩm theo quy định về An toàn vệ sinh thực phẩm Việt Nam\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/d2/26/75/9159474f7663e70bc9bce2f1fa5ffa18.jpg\" alt=\"\" width=\"750\" height=\"234\" /\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e#matong #matongrungnguyenchat #matongrung #muamatong #honimore #mậtong #mậtongnguyênchất #mậtongrừng #mat #ong #matongnguyenchat #matongrung #matong #honey #curcumin #tinhbotnghe #nguyenchat #rung #nguyenchat #matongthat #suaongchua #suaongchuanguyenchat #matongcaphe #matongrunguminh\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/section\u003e\n\u003c/div\u003e\n\u003cdiv\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"product-ratings\"\u003e\n\u003cdiv class=\"product-ratings__header\"\u003e \u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao