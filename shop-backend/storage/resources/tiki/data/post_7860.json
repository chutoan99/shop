"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/a2/b5/a9/7a443f7bd4b57d805fdc4265473f67d0.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":112,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch1 style=\"text-align:center;\"\u003e\u003cspan style=\"color:#ff0000;\"\u003eNồi cơm điện \u003cspan style=\"color:#0000ff;\"\u003eSUNHOUSE SHD8213\u003c/span\u003e chống dính tổ ong siêu bền, cơm ngon, dung tích 1,2L cho 2-4 người, giá rẻ phù hợp cho sinh viên, gia đình\u003c/span\u003e\u003c/h1\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/95/5c/ac/4b652d03ff89e8d087f9186d7d6b0754.jpg\" alt=\"\" width=\"720\" height=\"720\" /\u003e\u003cstrong\u003eĐẶC ĐIỂM NỔI BẬT\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Mâm nhiệt lớn, tỏa nhiệt đều, cơm dẻo ngon\u003c/p\u003e\n\u003cp\u003e- Lòng nồi chống dính vân tổ ong cao cấp, dễ dàng vệ sinh\u003c/p\u003e\n\u003cp\u003e- Dung tích nấu 1.2 L, phù hợp cho gia đình từ 2-3 thành viên\u003c/p\u003e\n\u003cp\u003e- Nút gạt tiện lợi, đèn tín hiệu dễ quan sát\u003c/p\u003e\n\u003cp\u003e- Van thoát hơi nước thông minh, hạn chế đọng nước\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eTHIẾT KẾ HIỆN ĐẠI – TRẺ TRUNG – TIỆN LỢI\u003c/strong\u003e\u003c/h2\u003e\n\u003ch3\u003e\u003cstrong\u003eThiết kế hiện đại, trẻ trung, an toàn\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003e\u003cstrong\u003eNồi cơm điện 1.2L SUNHOUSE SHD8213\u003c/strong\u003e nổi bật với màu xanh trẻ trung, thời thượng, khơi gợi cảm hứng nấu nướng cho người nội trợ và tô điểm thêm màu sắc tươi tắn cho gian bếp.\u003c/p\u003e\n\u003cp\u003eThân nồi được làm bằng nhựa cao cấp siêu bền, chịu nhiệt, chịu lực tốt. Sản phẩm có bề mặt sáng bóng, hạn chế bám bụi, dễ dàng lau chùi và cách nhiệt tối đa, giúp bạn không bị nóng tay khi nồi đang nấu.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/11/dd/9f/68b337dea01925a7eb381db1458d2457.jpg\" alt=\"\" width=\"750\" height=\"525\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eLòng nồi dày 1.2mm, phủ chống dính vân tổ ong cao cấp\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eLòng nồi làm từ hợp kim nhôm dày tới 1.2mm giúp giữ nhiệt tốt, cơm ngon lâu hơn và hương vị được giữ trọn vẹn. Đặc biệt lớp phủ chống dính vân tổ ong cao cấp với độ bền cứng cao giúp sản phẩm bền bỉ, hạn chế móp méo trong trường hợp va đập.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/fa/73/8e/62ed3d4a5c6528dff7c46259eb41dbda.jpg\" alt=\"\" width=\"750\" height=\"525\" /\u003e\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eLỰA CHỌN HOÀN HẢO CHO CƠM NGON TRÒN VỊ\u003c/strong\u003e\u003c/h2\u003e\n\u003ch3\u003e\u003cstrong\u003eNấu nhanh hơn, cơm chín đều\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eVới lòng nồi dày dặn, nồi cơm điện \u003cstrong\u003e1.2L SUNHOUSE SHD8213\u003c/strong\u003e giúp cơm chín đều, dẻo ngon. Công suất lớn 500W giúp tăng khả năng giữ ấm, cơm nấu nhanh và ngon hơn, tiết kiệm tối đa thời gian và công sức.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/78/88/c6/b4bf557b6a9e735afb20934901d63128.jpeg\" alt=\"image-20240325180424-3.jpeg\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eDễ dàng sử dụng và vệ sinh\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eHai chế độ \"Nấu - Cook\" và \"Giữ ấm - Warm\" điều chỉnh bằng nút gạt đơn giản, có đèn báo hiệu dễ quan sát.\u003c/p\u003e\n\u003cp\u003eCác bộ phận của nồi như nắp trong, lòng nồi, van thoát hơi, khay đựng nước thừa dễ dàng tháo rời, dễ dàng vệ sinh.\u003cbr /\u003e\u003cbr /\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/d3/2b/da/24f06934418f4a232b166b506227a736.jpeg\" alt=\"image-20240325180424-4.jpeg\" /\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eAn toàn cho sức khỏe\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eLớp chống dính vân tổ ong cao cấp không phát sinh các khí độc hại trong quá trình sử dụng và không chứa các độc tố gây hại cho sức khỏe. Lớp chống dính bền bỉ hạn chế tối đa sự bám dính và cháy xém của thực phẩm giúp bạn dễ dàng vệ sinh sau khi nấu.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTHÔNG SỐ KĨ THUẬT:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Dung tích nồi 1.2 L\u003c/p\u003e\n\u003cp\u003e- Chế độ Nấu cơm, Giữ ấm\u003c/p\u003e\n\u003cp\u003e- Màu sắc Xanh\u003c/p\u003e\n\u003cp\u003e- Loại nồi Nắp liền\u003c/p\u003e\n\u003cp\u003e- Chất liệu lòng nồi\u003c/p\u003e\n\u003cp\u003e- Hợp kim nhôm phủ chống dính PTFE\u003c/p\u003e\n\u003cp\u003e- Công suất 500 W\u003c/p\u003e\n\u003cp\u003e- Điện áp 220 V~/50 Hz\u003c/p\u003e\n\u003cp\u003e- Dây điện Dây rời\u003c/p\u003e\n\u003cp\u003e- Phụ kiện: Vỉ hấp, cốc đong gạo, thìa xới cơm, dây nguồn,\u003c/p\u003e\n\u003cp\u003e- Đặc điểm khác: Lòng nồi chống dính vân tổ ong cao cấp\u003c/p\u003e\n\u003cp\u003e- Van thoát hơi nước thông minh, hạn chế đọng nước\u003c/p\u003e\n\u003cp\u003e- Thương hiệu: SUNHOUSE\u003c/p\u003e\n\u003cp\u003e- Xuất xứ: Trung Quốc\u003c/p\u003e\n\u003cp\u003e- Trọng lượng: 2.0 kg\u003c/p\u003e\n\u003cp\u003e- Bảo hành 12 tháng\u003c/p\u003e\n\u003cp\u003e- Số người ăn 2 – 4 người\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/a2/b5/a9/7a443f7bd4b57d805fdc4265473f67d0.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a2/b5/a9/7a443f7bd4b57d805fdc4265473f67d0.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a2/b5/a9/7a443f7bd4b57d805fdc4265473f67d0.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a2/b5/a9/7a443f7bd4b57d805fdc4265473f67d0.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a2/b5/a9/7a443f7bd4b57d805fdc4265473f67d0.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/95/5c/ac/ffc4cd57ab5c907073f0e3ca746e2954.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/95/5c/ac/ffc4cd57ab5c907073f0e3ca746e2954.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/95/5c/ac/ffc4cd57ab5c907073f0e3ca746e2954.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/95/5c/ac/ffc4cd57ab5c907073f0e3ca746e2954.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/95/5c/ac/ffc4cd57ab5c907073f0e3ca746e2954.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/e1/a9/42/5afaee9ce58bdd3fe0b0ebb19729c8d9.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e1/a9/42/5afaee9ce58bdd3fe0b0ebb19729c8d9.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e1/a9/42/5afaee9ce58bdd3fe0b0ebb19