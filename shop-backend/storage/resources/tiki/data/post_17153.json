14,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.8,"review_count":4,"review_text":"(4)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ca/f2/7d/f38a8b2a15efd13602061ad282c1176c.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1185,"all_time_quantity_sold":13,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e- Để bảo vệ an toàn cho chiếc điện thoại khi đi du lịch đặc biệt là chụp những bức ảnh đẹp ở dưới nước mà không phải lo lắng điện thoại không bị vào nước. Baseus mang đến sản phẩm Túi chống nước Cylinder Slide-Cover Waterproof Bag cho các dòng smartphone Android và iPhone…\u003cbr /\u003e- Túi chống nước cho điện thoại Baseus Cylinder Slide-Cover Waterproof Bag thuộc dòng chuyên dùng cho thể thao và các hoạt động ngoài trời. Sản phẩm được làm bằng nhựa dẻo cao cấp và sợi nylon carbon siêu bền (TPU + ABS + Nylon) giúp cho túi có tính đàn hồi và chịu lực cao. Sử dụng cho nhiều loại điện thoại khác nhau với kích thước màn hình từ 7.2 inch trở xuống.\u003cbr /\u003e- Chất liệu nhựa dẽo trong suốt cao cấp, có tính đàn hồi cao đi cùng thiết kế thon gọn giúp cho bề mặt túi luôn tiếp xúc với màn hình cảm ứng bên trong đảm bảo thao tác dễ dàng, cảm ứng nhạy. Chất liệu nhựa trong suốt không làm giảm chất lượng ảnh chúp của camera và chất lượng ảnh khi qua túi.\u003cbr /\u003e- Khóa bảo vệ được thiết kế thông minh, dạng trượt giúp dễ dàng khóa chặt, nhanh chóng và an toàn hơn đảm bảo nước không bị rò rỉ vào bên trong. Bảo vệ an toàn cho chiếc điện thoại khi xuống nước.\u003cbr /\u003e- Thiết kế tiện dụng có thể đeo cổ, đeo tay hoặc thắc lưng rất linh hoạt.\u003c/p\u003e\n\u003cp\u003eTên thương hiệu: BASEUS\u003cbr /\u003e- Tên sản phẩm: Túi chống nước Baseus \u003cbr /\u003e- Chất liệu: PVC + ABS + Silicone\u003cbr /\u003e- Công nghệ: Ép nóng\u003cbr /\u003e- Kiểu máy sử dụng: Điện thoại dưới 7,2 inch\u003cbr /\u003e- Nhiệt độ phù hợp: -20oC -70oC\u003cbr /\u003e- Đặc điểm 1: Chống nước 5 lớp \u003cbr /\u003e- Đặc điểm 2: Có thể sử dụng trên màn hình cảm ứng\u003cbr /\u003e- Đặc điểm 3: Thiết kế nắp đóng kiểu trượt, độ trong suốt cao\u003cbr /\u003e- Phù hợp cho: Dành cho điện thoại, sử dụng khi chơi thể thao dưới nước, lặn, bãi biển, hồ bơi\u003cbr /\u003e- Loại sản phẩm: Túi bơi chống nước, Túi đựng điện thoại di động chuyên dụng\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/5b/18/94/dc312486512b966d57cc2f884edddd2a.jpg\" alt=\"\" width=\"668\" height=\"1377\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/72/6a/e9/508f77c63f914c824eae329e52ad4829.jpg\" alt=\"\" width=\"668\" height=\"1121\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/85/bb/57/4838a2ce2f628e554ad67e52e35e0895.jpg\" alt=\"\" width=\"667\" height=\"1212\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/20/08/e7/9c935e8cb6d469446fe03acb907255ae.jpg\" alt=\"\" width=\"667\" height=\"1179\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ed/02/e1/68c0ab6a316b64b606e789f260cdd083.jpg\" alt=\"\" width=\"665\" height=\"1148\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/a9/3b/cd/c59aa7b1f2c0bbdaa30fddb08e69e651.jpg\" alt=\"\" width=\"664\" height=\"644\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/t