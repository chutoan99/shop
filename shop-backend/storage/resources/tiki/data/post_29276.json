tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":1000,"discount_rate":3,"rating_average":4.6,"review_count":5,"review_text":"(5)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/4a/d5/7b/04f209cded45791a11ab995261522227.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":0,"all_time_quantity_sold":31,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"color: #008ab7; font-size: medium;\"\u003e\u003cstrong\u003eDao Rọc Giấy Deli 2064\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\r\n\u003cp\u003e\u003cspan style=\"color: #ff0000;\"\u003e\u003cstrong\u003eLưu ý: Sản phẩm được giao màu ngẫu nhiên tùy theo từng đợt nhập hàng.\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eDao Rọc Giấy Deli 2064\u003c/strong\u003e thiết kế tay cầm cong có rãnh chống trượt giúp bạn cầm chắc tay hơn khi rọc giấy. Lưỡi dao sắc bén cho tốc độ cắt giấy nhanh, chuẩn xác trong tạo hình, có thể dùng trong chế tác thủ công. Dao có khóa cố định an toàn, dễ điều chỉnh tạo sự tiện lợi cho bạn khi sử dụng.\u003c/p\u003e\r\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"http://tikicdn.com/media/catalog/product/7/0/7032_1.jpg\" alt=\"\" width=\"600\" height=\"600\" /\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eThông tin sản phẩm\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eLưỡi dao làm từ hợp kim thép cao cấp\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eDao Rọc Giấy Deli chế tác lưỡi dao từ chất liệu hợp kim thép cao cấp cho độ bền, sắc bén và độ khía sâu hoàn hảo. Chất liệu này cũng giữ cho đường rọc trở nên trơn tru, chính xác hơn. Lưỡi dao không gỉ sét nên bạn có thể yên tâm sử dụng lâu dài.\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eThiết kế dễ cầm, màu xanh dương đẹp mắt\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eDao Rọc Giấy Deli 2064 thiết kế tay cầm bản lớn có độ cong hoàn hảo vừa với lòng bàn tay tạo cảm giác thoải mái, giúp bạn giữ vững tay khi cắt, rọc giấy. Kích thước dao nhỏ gọn dễ mang theo sử dụng khi cần đồng thời giúp bạn dễ dàng rọc giấy chuẩn xác, linh hoạt hơn.\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eTay cầm bọc nhựa an toàn\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003ePhần tay cầm được làm bằng nhựa giúp bao bọc toàn bộ phần lưỡi dao tránh cho đôi tay của bạn không bị cắt phạm, trầy xước khi sử dụng. Tay cầm cũng có thêm các đường vân chống trượt, giúp bạn dễ dàng cố định dao và vững tay hơn khi thực hiện những đường rọc cắt một cách an toàn nhất.\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eNút khóa tự động dễ điều chỉnh\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eDao thiết kế nút khóa tự động an toàn giúp bạn điều chỉnh và cố định độ dài của lưỡi dao dễ dàng và chắc chắn hơn. Bạn chỉ cần đẩy nút khóa lên khi cắt và kéo xuống khi khóa lưỡi dao, đảm bảo an toàn một cách tối ưu.\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eTiện sử dụng\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eSản phẩm là dụng cụ văn phòng tiện ích mà học sinh, sinh viên, nhân viên công sở, thợ chế tác thủ công,… có thể sử dụng để giúp quá trình học tập, làm việc của mình được thuận tiện hơn.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e\u003cp\u003eSản phẩm này là tài sản cá nhân được bán bởi Nhà Bán Hàng Cá Nhân và không thuộc đối tượng phải chịu thuế GTGT. Do đó hoá đơn VAT không được cung cấp trong trường hợp này.\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/4a/d5/7b/04f209cded45791a11ab995261522227.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/4a/d5/7b/04f209cded45791a11ab995261522227.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/4a/d5/7b/04f209cded45791a11ab995261522227.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4a/d5/7b/04f209cded45791a11ab995261522227.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4a/d5/7b/04f209cded45791a11ab995261522227.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/be/99/bd/721125ff1e7176e884b4d47de7f38896.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/be/99/bd/721125ff1e7176e884b4d47de7f38896.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/be/99/bd/721125ff1e7176e884b4d47de7f38896.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/be/99/bd/721125ff1e7176e884b4d47de7f38896.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/be/99/bd/721125ff1e7176e884b4d47de7f38896.jpg"}],"warranty_policy":null,"brand":{"id":46703,"name":"Deli","slug":"deli"},"current_seller":{"id":3644,"sku":"1248635907