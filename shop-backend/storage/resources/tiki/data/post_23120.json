 nhâm nhi cùng bạn bè, người thân.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eHạn sử dụng: dùng trong 6 tháng (xem trên bao bì)\u003c/p\u003e\n\u003cp\u003eBảo quản nơi khô thoáng, đóng kín nắp sau khi mở.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/f4/43/63/7f54456f3b8305c487e35b12d75dc677.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f4/43/63/7f54456f3b8305c487e35b12d75dc677.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f4/43/63/7f54456f3b8305c487e35b12d75dc677.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f4/43/63/7f54456f3b8305c487e35b12d75dc677.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f4/43/63/7f54456f3b8305c487e35b12d75dc677.png"},{"base_url":"https://salt.tikicdn.com/ts/product/3e/9a/00/1f87891b4bd07092ee78cccefc30b652.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/3e/9a/00/1f87891b4bd07092ee78cccefc30b652.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/3e/9a/00/1f87891b4bd07092ee78cccefc30b652.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3e/9a/00/1f87891b4bd07092ee78cccefc30b652.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3e/9a/00/1f87891b4bd07092ee78cccefc30b652.png"}],"warranty_policy":null,"brand":{"id":403371,"name":"DTfood","slug":"dtfood"},"current_seller":{"id":136935,"sku":"8805685132518","name":"Bách Hóa Xuân Thu","link":"https://tiki.vn/cua-hang/bach-hoa-xuan-thu","logo":"e7/5a/f1/024df591f064cd76917d9bfc35da7c73.jpg","price":1650