t_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":3.5,"review_count":4,"review_text":"(4)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/c2/73/b3/510450f8e64c4e3273ca2d25f55dd196.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2198,"all_time_quantity_sold":24,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eTHÔNG TIN SẢN PHẨM\u003cbr /\u003e \u003cbr /\u003eTên Sản Phẩm : Nước hoa xe hơi WINE Korea 65ml A50\u003c/strong\u003e\u003cbr /\u003eCông dụng : Khử mùi , làm thơm đem lại sự thoải mái dễ chịu trong xe\u003cbr /\u003eThành phần vật liệu : Hương liệu tổng hợp Rose Florant (Green), Cetyl ancohol, Fragrance.\u003cbr /\u003eMùi hương : Hương Dream (mơ mộng) , hương Lenon (Chanh), hương Angel (Thiên Thần), hương Flower Dance (hoa nhảy).\u003cbr /\u003eHướng dẫn sử dụng : Vặn nắp mở lọ nước hoa , bỏ nút nhựa ở miệng lọ ra , đóng nắp lại để sử dụng.\u003cbr /\u003eModem :  AW-A50\u003cbr /\u003eKích thước đóng gói : 13 x 9 x 7,5 cm\u003cbr /\u003eTrọng lượng : 350g\u003cbr /\u003eMàu sắc : Màu Xanh Dương, Màu Cam, Màu tím, Màu Đỏ\u003cbr /\u003eQuy cách đóng gói : hộp\u003cbr /\u003eDung tích : 65ml\u003cbr /\u003eXuất xứ : Wine - Korea\u003cbr /\u003e \u003cbr /\u003eNước hoa ô tô được gọi là nghệ thuật của sự im lặng vì nó không chỉ đẹp lại sự thoải mái, dễ chịu mà còn là thông điệp thể hiện đẳng cấp và cái tôi của mỗi chủ xe. Do vậy, cùng với sự lựa chọn những phụ kiện đồ chơi đắt tiền để trang bị cho chiếc xe của mình thì việc chọn lựa một loại nước hoa cho ô tô phù hợp cũng là mối quan tâm của các chủ xe hiện nay.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://vn-live.slatic.net/v2/resize/products/S-100124467-d890924795198b948d8a33340891f6b0.jpg\" data-cke-saved-src=\"https://vn-live.slatic.net/v2/resize/products/S-100124467-d890924795198b948d8a33340891f6b0.jpg\" /\u003e \u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003eNước hoa xe hơi WINE Korea 65ml A50 có thể sử dụng trên xe ô tô, trong phòng ngủ, phòng khách, tủ quần áo, phòng làm việc... làm mát không khí, mang lại cảm giác sảng khoái, mạnh mẽ, quyến rũ cho không gian sử dụng.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e \u003cimg src=\"https://vn-live.slatic.net/v2/resize/products/S-100124467-094a851f330137027eec0e098ace8fda.jpg\" data-cke-saved-src=\"https://vn-live.slatic.net/v2/resize/products/S-100124467-094a851f330137027eec0e098ace8fda.jpg\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003e Thiết kế nhỏ gọn nhưng sang trọng, mùi hương khơi gợi xúc giác ấm áp nồng nàn sẽ lan tỏa nhẹ nhàng trong không khí giúp không gian trong xe của bạn sẽ trở nên trong lành, đem đến cảm giác dễ chịu khi lái xe. \u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://vn-live.slatic.net/v2/resize/products/S-100124467-7be29dcd8d179fc0fd2fbc52ae2561f3.jpg\" data-cke-saved-src=\"https://vn-live.slatic.net/v2/resize/products/S-100124467-7be29dcd8d179fc0fd2fbc52ae2561f3.jpg\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://vn-live.slatic.net/v2/resize/products/S-100124467-0210625b860900ff62b09d14ef7776d2.jpg\" data-cke-saved-src=\"https://vn-live.slatic.net/v2/resize/products/S-100124467-0210625b860900ff62b09d14ef7776d2.jpg\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cstrong\u003e \u003cbr /\u003e Mùi hương nồng nàn khơi gợi xúc giác\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003eNước hoa xe hơi WINE Korea 65ml A50 còn giúp giảm thiểu tác nhân gây ô nhiễm không khí bên trong xe, giữ cho xe ô tô của bạn luôn tỏa hương hàng giờ, tạo cảm giác dễ chịu, thoải mái sau những giờ làm việc căng thẳng.\u003c/p\u003e\n\u003cp\u003eSản phẩm được sản xuất theo công nghệ Hàn Quốc, không chứa chất độc hại, an toàn cho người sử dụng và trẻ em, lưu hương lâu, chống say xe, giúp thư giãn, giảm căng thẳng và mệt mỏi.\u003cbr /\u003eGiúp cho không gian xe hơi luôn tươi mát bằng tinh dầu thơm quý phái đẳng cấp. Có 4 mùi, Hương Dream (mơ mộng) , hương Lenon (Chanh), hương Angel (Thiên Thần), hương Flower Dance (hoa nhảy).\u003cbr /\u003eThời gian lưu hương lên đến hơn 60 ngày.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://vn-live.slatic.net/v2/resize/products/S-100124467-1fb466afe23071c9e6322afa769c7acb.jpg\" data-cke-saved-src=\"https://vn-live.slatic.net/v2/resize/products/S-100124467-1fb466afe23071c9e6322afa769c7acb.jpg\" /\u003e\u003cimg src=\"https://vn-live.slatic.net/v2/resize/products/S-100124467-fb944a579a3a543987a0979964d468d9.jpg\" data-cke-saved-src=\"https://vn-live.slatic.net/v2/resize/products/S-100124467-fb944a579a3a543987a0979964d468d9.jpg\" /\u003e\u003cimg src=\"https://vn-live.slatic.net/v2/resize/products/S-100124467-4123ea027adcbb459cdfd177d6dde112.jpg\" data-cke-saved-src=\"https://vn-live.slatic.net/v2/resize/products/S-100124467-4123ea027adcbb459cdfd177d6dde112.jpg\" /\u003e\u003cimg src=\"https://vn-live.slatic.net/v2/resize/products/S-100124467-9af0bd9148380a5296d596a956515eb9.jpg\" data-cke-saved-src=\"https://vn-live.slatic.net/v2/resize/products/S-100124467-9af0bd9148380a5296d596a956515eb9.jpg\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u0