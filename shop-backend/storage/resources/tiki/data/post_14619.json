:89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.3,"review_count":28,"review_text":"(28)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/c2/ab/95/3483824917b1297330ffbd8d0be6aee1.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2754,"all_time_quantity_sold":180,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cspan style=\"font-size: medium; color: #008ab7;\"\u003e \u003cstrong\u003e Bếp Nướng Than Inox Prota PT016 - Kèm Theo 1 Vỉ Nướng \u003c/strong\u003e \u003c/span\u003e làm từ inox cao cấp cho thời gian sử dụng lâu dài. Bếp nướng Prota hoạt động theo cách truyền thống là dùng than để nướng     thực phẩm, giữ được hương vị và màu sắc vốn có của thực phẩm.\u003c/p\u003e\r\n\u003cp\u003e\u003cstrong\u003e Đặc điểm nổi bật: \u003c/strong\u003e\u003c/p\u003e\r\n\u003cul\u003e\r\n\u003cli\u003e Bếp nướng than Prota và vĩ nướng được làm hoàn toàn bằng inox cao cấp, cho thời gian sử dụng lâu bền. Ngoài ra chất liệu         inox còn giúp cho vỉ nướng có tính dẫn nhiệt tốt, giúp thực phẩm chín đều trong thời gian ngắn. \u003c/li\u003e\r\n\u003cli\u003e Sản phẩm có kích thước nhỏ gọn nên bạn có thể dễ dàng mang theo trong các chuyến cắm trại, picnic, liên hoan ngoài trời...         hoặc để ngay trên bàn tiệc. \u003c/li\u003e\r\n\u003cli\u003e Sản phẩm dùng than để nướng nên sẽ giúp bạn tiết kiệm được chi phí đáng kể, vì khi dùng bếp nướng điện hoặc bằng gas thì         bạn tốn nhiều chi phí hơn so với khi nướng bằng than. \u003c/li\u003e\r\n\u003cli\u003e Hệ thống chân đế dạng kiềng 3 chân giúp bếp có thể đứng vững vàng và thăng bằng. \u003c/li\u003e\r\n\u003cli\u003e Sản phẩm có bộ phận nướng khép kín, cùng với kệ để than được thiết kế có nhiều lỗ tròn, giúp cho bụi than không bị bay ra         ngoài, mang lại cho không gian bàn tiệc sự sạch sẽ và thoải mái. \u003c/li\u003e\r\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/c2/ab/95/3483824917b1297330ffbd8d0be6aee1.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c2/ab/95/3483824917b1297330ffbd8d0be6aee1.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c2/ab/95/3483824917b1297330ffbd8d0be6aee1.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c2/ab/95/3483824917b1297330ffbd8d0be6aee1.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c2/ab/95/3483824917b1297330ffbd8d0be6aee1.png"},{"base_url":"https://salt.tikicdn.com/media/catalog/product/b/e/bep-nuong-than-inox-kem-vi-nuong-prota_1_.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/b/e/bep-nuong-than-inox-kem-vi-nuong-prota_1_.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/b/e/bep-nuong-than-inox-kem-vi-nuong-prota_1_.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/b/e/bep-nuong-than-inox-kem-vi-nuong-prota_1_.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/b/e/bep-nuong-than-inox-kem-vi-nuong-prota_1_.jpg"},{"base_url":"https://salt.tikicdn.com/media/catalog/product/