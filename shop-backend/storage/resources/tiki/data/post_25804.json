installment_supported":null},"other_sellers":[{"id":11119,"name":"GIA DỤNG VIỆT","link":"https://tiki.vn/cua-hang/nguyen-van-thang","logo":"47/20/4f/9800dd1b2ca67db582030ded1dc700b3.png","price":285000,"product_id":"14846463","store_id":10842}],"specifications":[{"name":"Content","attributes":[{"code":"brand","name":"Thương hiệu","value":"Sunhouse"},{"code":"brand_country","name":"Xuất xứ thương hiệu","value":"Việt Nam"},{"code":"chat_lieu","name":"Chất liệu","value":"\u003cul\u003e\u003cli\u003eThân chảo: Nhôm tấm dày 2.5mm \u003c/li\u003e\n\u003cli\u003eQuai cầm: Nhựa chịu nhiệt\u003c/li\u003e\u003c/ul\u003e"},{"code":"huong_dan_bao_quan","name":"Hướng dẫn bảo quản","value":"\u003cul\u003e\u003cli\u003eRửa chảo chống dính qua 1-2 lần nước rửa chén, sau đó bôi một lớp cà phê lên mặt chảo và hâm nóng, như thế chảo sẽ được rửa sạch an toàn và không có mùi khó chịu\u003c/li\u003e\n\u003cli\u003eSử dụng miếng rửa chén mềm để không làm trầy xước bề mặt chống dính của chảo\u003c/li\u003e\n\u003cli\u003eSau khi sử dụng nên để chảo nguội hẳn và rửa ngay để giữ độ bền của chảo cũng như không để thức ăn bám vào chảo quá lâu gây khó vệ sinh\u003c/li\u003e\n\u003cli\u003eNên rửa chảo bằng nước ấm sẽ dễ loại bỏ dầu mỡ và cặn thức ăn thừa\u003c/li\u003e\n\u003cli\u003eKhông nên rửa chảo chống dính trong máy rửa chén vì có thể làm hư hại chảo\u003c/li\u003e\n\u003cli\u003eTreo chảo chống dính lên sau khi sử dụng và hạn chế chồng lên các xoong, chảo khác để không làm trầy xước mặt chảo\u003c/li\u003e\n\u003cli\u003eThay mới chảo khi hỏng lớp chống dính để đảm bảo an toàn cho sức khỏe khi sử dụng, thông thường là sau 1-2 năm\u003c/li\u003e\n\u003c/ul\u003e"},{"code":"huong_dan_su_dung","name":"Hướng dẫn sử dụng","value":"\u003cul\u003e\u003cli\u003eNên đổ dầu vào chảo trước khi chảo nóng, nếu không thì nhiệt độ quá nóng trong chảo khi đổ dầu sẽ làm bong lớp chống dính, gây độc hại cho người sử dụng\u003c/li\u003e\n\u003cli\u003eSử dụng lượng ít dầu, mỡ, bơ khi chiên, rán hoặc có thể không cần đến dầu, mỡ khi chiên\u003c/li\u003e\n\u003cli\u003eNấu ở nhiệt độ thấp hoặc trung bình vì ở nhiệt độ cao chất chống dính sẽ bắt đầu bị phân hủy và gây hại cho sức khỏe\u003c/li\u003e\n\u003cli\u003eKhông dùng chảo để nướng hoặc kho vì lớp chống dính sẽ nhanh bị hư hại và bong tróc do nhiệt độ cao\u003c/li\u003e\n\u003cli\u003eKhông nêm mắm muối trực tiếp khi đang sử dụng chảo vì sẽ khiến bề mặt chảo dễ bị rỗ, hư hại lớp chống dính và giảm tuổi thọ chảo\u003c/li\u003e\n\u003cli\u003eSử dụng dụng cụ nấu ăn bằng gỗ cho chảo chống dính\u003c/li\u003e\n\u003c/ul\u003e"},{"code":"item_model_number","name":"Model","value":"SHM30"},{"code":"kich_thuoc","name":"Kích thước (Dài x Rộng x Cao)","value":"Đường kính 30 cm"},{"code":"origin","name":"Xuất xứ (Made in)","value":"Việt Nam"}]},{"name":"Operation","attributes":[{"code":"is_warranty_applied","name":"Sản phẩm có được bảo hành không?","value":"Không"}]}],"price_comparison":{"sub_title":"Giá từ 285.000 ₫","title":"So sánh 1 nhà bán khác"},"product_links":[],"gift_item_title":"0 quà tặng kèm","services_and_promotions":[],"promitions":[],"stock_item":{"max_sale_qty":1000,"min_sale_qty":1,"preorder_date":null,"qty":1000},"quantity_sold":{"text":"Đã bán 1","value":1},"categories":{"id":1984,"name":"Chảo chiên","is_leaf":true},"breadcrumbs":[{"url":"/nha-cua-doi-song/c1883","name":"Nhà Cửa - Đời Sống","category_id":1883},{"url":"/nha-bep/c1951","name":"Dụng cụ nhà bếp","category_id":1951},{"url":"/noi-va-chao/c53052","name":"Nồi và chảo","category_id":53052},{"url":"/chao-chien/c1984","name":"Chảo chiên","category_id":1984},{"url":"https://tiki.vn/chao-day-tu-chong-dinh-sunhouse-shm30-30cm-p579847.html","name":"Chảo Đáy Từ Chống Dính Sunhouse SHM30 30cm","category_id":0}],"installment_info_v2":null,"installment_info_v3":[{"display_text":"Ưu đãi đến 600k với thẻ TikiCard","icon":"https://salt.tikicdn.com/ts/upload/73/4d/f7/f86e767bffc14aa3d6abed348630100b.png","summary":"Ưu đãi đến 600k với thẻ TikiCard.","title":"Ư