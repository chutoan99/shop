ull,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":691000,"discount_rate":35,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/61/b8/3d/266adee31e037f5eae77d136eb431788.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1509,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003e\u003cstrong\u003eT\u003c/strong\u003e\u003cstrong\u003ehiết kế thanh lịch, gọn nhẹ, nhiều màu sắc và tiện dụng\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eBình lưỡng tính Tiger MJE-A048 dung tích 480ml thu hút ánh nhìn với thiết kế kiểu dáng thời trang, sang trọng, hiện đại kết hợp với đa dạng màu sắc tăng độ thẩm mỹ cao cũng như phù hợp với nhu cầu uống nước tại văn phòng hay tại nhà cũng như trong túi xách của mỗi người khi ra đường. Bên cạnh đó, lớp sơn tĩnh điện giữ bình lâu phai màu và không mau dơ. Không chỉ vậy, nắp được cải tiến lật 180° giúp bạn uống nước thoải mái hơn.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/65/e9/49/21d3cd84c1c1ac63bcd8786b5df87140.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eGiữ lạnh và giữ nóng cả ngày với công nghệ cách nhiệt chân không “Double Wall”\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eỨng dụng công nghệ thân kép inox cách nhiệt chân không “\u003cstrong\u003eDouble Wall\u003c/strong\u003e“, bình giữ nhiệt Tiger MJE-A048 giúp giữ nước nóng và lạnh cả ngày đáp ứng được nhu cầu thưởng thức nước uống yêu thích mọi lúc mọi nơi cũng như trong khi bạn đang bận rộn làm việc hay trong cuộc họp. Ngoài ra, nắp được thiết kế hình xoắn ốc và còn được trang bị lớp cao su bọc kín mang đến khả năng giữ nhiệt tốt hơn và chống rò rỉ nước. \u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eBình siêu nhẹ với công nghệ “Super Light”\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eBình lưỡng tính Tiger MJE-A048 với công nghệ “\u003cstrong\u003eSuper Light\u003c/strong\u003e” cho thiết kế bình gọn nhẹ hơn so với những model cũ dễ dàng cầm nắm hay di chuyển bình cũng như bỏ trong balo, túi xách mang theo trong văn phòng hay đi dã ngoại / du lịch vì thiết kế siêu nhẹ tiện lợi này.  \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/15/ed/65/580feb963e652dc88573c050077e5982.jpg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/15/ed/65/580feb963e652dc88573c050077e5982.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eChống bám bẩn, khử mùi với công nghệ “Super Clean Plus”\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eToàn bộ cấu trúc bình lưỡng tính Tiger MJE-A048 làm từ thép không gỉ tiêu chuẩn SUS304 (18/8) được áp dụng công nghệ “\u003cstrong\u003eSuper Clean Plus\u003c/strong\u003e” chống gỉ sét, chống ăn mòn, chống dính, chống bám bẩn, khử mùi và dễ dàng vệ sinh ngay cả những thức uống dễ để lại vết bám bẩn và mùi như cà phê / trà mà không gây ra những chất độc hại cho sức khỏe của người sử dụng. \u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/41/f5/9d/9d8ea8463530f6198b36dcb8abd7ff2b.jpg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/41/f5/9d/9d8ea8463530f6198b36dcb8abd7ff2b.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eAn toàn khi sử dụng bình giữ nhiệt Tiger với công nghệ “Auto Lock”\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eBình lưỡng tính Tiger MJE-A048 là sản phẩm không chứa chất gây ung thư “\u003cstrong\u003ePFOA\u003c/strong\u003e” luôn luôn an toàn cho người sử dụng. Không chỉ vậy, Tập Đoàn Tiger còn thiết kế tấm bảo vệ dưới đáy bình giữ nhiệt để chống trượt và chống trầy xước tăng độ bền cho bình trong khi sử dụng. Ngoài ra, với công nghệ “\u003cstrong\u003eAuto Lock\u003c/strong\u003e” khóa nắp tự động an toàn và mở nắp với 1 nút nhấn ngăn ngừa rò rỉ nước khi bạn quên đóng nắp. \u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/e8/8a/99/f4c8311a0584ad2761378df0df6b3903.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/e8/8a/99/f4c8311a0584ad2761378df0df6b3903.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eThiết kế miệng bình rộng và dễ dàng vệ sinh\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eMiệng bình lưỡng tính MJE-A048 bằng thép không gỉ được gia công dạng gọng kép nhẵn mịn và rộng đến 5.5cm dễ dàng bỏ đá viên hay uống trực tiếp cũng như thuận tiện vệ sinh. Ngoài ra, các bộ phận của bình lưỡng tính tách rời được giúp bạn thuận tiện cho việc vệ sinh. Không chỉ vậy, với thiết kế nguyên khối bạn có thể rửa được dưới vòi nước.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/4e/07/16/a616c91a5778a0e4e08a91085c703f36.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/61/b8/3d/266adee31e037f5eae77d136eb43178