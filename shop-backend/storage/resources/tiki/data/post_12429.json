xt":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":100000,"discount_rate":32,"rating_average":2.5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/a6/e3/80/1485bf0c8d8562499db3fedd9a725a26.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2274,"all_time_quantity_sold":103,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<h2>Trái banh, Quả bóng đá bằng da AOLIKES TC-606</h2>\n<p>Trái banh, Quả bóng đá bằng da số 4 được làm từ chất liệu PU - PVC dai bền, có độ nảy ổn định, bóng êm, hướng bay chuẩn, khả năng chống thấm nước tốt, ít bị mài mòn. Bóng có cấu tạo nhiều lớp nên không bị biến dạng qua quá trình sử dụng, có độ bền cao. Phần ruột bóng được làm từ chất liệu bền, cho khả năng giữ hơi cực tốt.</p>\n<p>Sản phẩm có thiết kế đẹp mắt, màu sắc nổi bật cùng với đường may sắc nét, tỉ mỉ. Bóng tròn đều, là sự kết hợp giữa gam màu xanh dương, đen, trắng tạo nên họa tiết khỏe khoắn, đem lại cho người sử dụng cảm giác hứng thú mỗi khi tập luyện, thi đấu.</p>\n<p>Bóng sử dụng cho tập luyện và thi đấu phong trào</p>\n<p><strong>Thông tin sản phẩm</strong></p>\n<ul>\n<li><strong>Kích thước:</strong> 680 – 700mm.</li>\n<li><strong>Trọng lượng:</strong> 410 – 450g.</li>\n<li><strong>Độ nảy:</strong> 115 -155cm.</li>\n<li><strong>Độ ổn định:</strong> 3,8mm.</li>\n<li><strong>Độ thấm nước:</strong> 15%.</li>\n<li><strong>Nhà sản xuất:</strong> AOLIKES</li>\n<li><strong>Màu sắc:</strong> Đen, Đỏ, Vàng, Xanh </li>\n</ul>\n<p style=\"text-align: center;\"><img src=\"https://vcdn.tikicdn.com/ts/tmp/5b/a5/fe/098581dac95924d42f4931719eb1c80b.jpg\" alt=\"Trái banh, Quả bóng đá bằng da AOLIKES TC-606\" width=\"750\" height=\"1137\" /></p>\n<p style=\"text-align: center;\"><img src=\"https://vcdn.tikicdn.com/ts/tmp/3b/14/30/4bd365579f42707235181199a7d8d390.jpg\" alt=\"Trái banh, Quả bóng đá bằng da AOLIKES TC-606\" width=\"750\" height=\"2333\" /></p>\n<p style=\"text-align: center;\"><img src=\"https://vcdn.tikicdn.com/ts/tmp/bd/bf/29/13cb0f187dcdc5e7edbf1d5b21681ab6.jpg\" alt=\"Trái banh, Quả bóng đá bằng da AOLIKES TC-606\" width=\"750\" height=\"1862\" /></p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/a6/e3/80/1485bf0c8d8562499db3fedd9a725a26.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a6/e3/80/1485bf0c8d8562499db3fedd9a725a26.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a6/e3/80/1485bf0c8d8562499db3fedd9a725a26.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a6/e3/80/1485bf0c8d8562499db3fedd9a725a26.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a6/e3/80/1485bf0c8d8562499db3fedd9a725a26.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/1f/32/7b/2d0899b1cbf94994080ec57f6cf2d63b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/1f/32/7b/2d0899b1cbf94994080ec57f6cf2d63b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/1f/32/7b/2d0899b1cbf94994080ec57f6cf2d63b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1f/32/7b/2d0899b1cbf94994080ec57f6cf2d63b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1f/32/7b/2d0899b1cbf94994080ec57f6cf2d63b.jpg"}