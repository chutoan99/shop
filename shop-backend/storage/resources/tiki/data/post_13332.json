color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/0b/48/41/9cc079bd8ee0189a781bdf3d7eb62ba6.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2176,"all_time_quantity_sold":10,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cul\u003e\n\u003cli\u003eMũ bảo hiểm Sunda Halya là loại mũ nửa đầu không kính, gắn lưỡi trai được sản xuất bởi Công Ty TNHH LongHuei Việt Nam, là một công ty chuyên sản xuất mũ bảo hiểm với gần ba mươi năm kinh nghiệm phục vụ cho thị trường quốc tế. Các nhãn hiệu mũ của công ty tại Việt Nam như: ZEUS, ANDES, SUNDA; SIMPSON, CROMO. cTrong đó, những thương hiệu như ANDES, CROMO,...hẳn đã rất quen thuộc với nhiều người và đã nhận được sự tin tưởng rất lớn của khách hàng từ hàng chục năm qua tại Việt Nam.\u003c/li\u003e\n\u003cli\u003eLong Huei là công ty duy nhất tại Việt Nam có phòng thử nghiệm hiện đại, đạt tiêu chuẩn quốc tế, nhằm đảm bảo chất lượng sản phẩm đáp ứng các tiêu chuẩn an toàn của Việt Nam và quốc tế trước khi đến với người tiêu dùng.\u003c/li\u003e\n\u003cli\u003eNhững sản phẩm của công ty LongHuei đều đạt tiêu chuẩn Việt Nam và tiêu chuẩn “DOT, ECE,CNS,SNI,JIS” nhằm đáp ứng các yêu cầu của khách hàng và phục vụ hầu hết các thị trường quốc tế khó tính nhất. Đó là lí do phần lớn các sản phẩm của công ty được xuất khẩu sang thị trường nước ngoài.\u003c/li\u003e\n\u003cli\u003eMũ bảo hiểm Sunda Halya ứng dụng công nghệ sản xuất hiện đại nhất, và sử dụng nguyên vật liệu tốt nhất để sản xuất mũ bảo hiểm với thiết kế phù hợp với người Việt Nam\u003c/li\u003e\n\u003cli\u003eVỏ Nón: Sản phẩm mũ bảo hiễm Sunda cam kết luôn sử dụng Nhựa ABS nguyên sinh 100% được nhập khẩu từ các nhà cung ứng uy tín như Hàn Quốc, Malaysia, Thái , Nhật, chịu được độ va đập cao .\u003c/li\u003e\n\u003cli\u003eMút xốp: là bộ phận cực kỳ quan trọng để bảo vệ não bộ , hấp thụ xung động khi xảy ra tai nạn , Sunda luôn sử dụng xốp nguyên sinh trong tất cả các sản phẩm .\u003c/li\u003e\n\u003cli\u003eVải lót cao cấp được xử lý kháng khuẩn, thấm hút tốt, mau khô, giúp hạn chế nguy cơ mắc các bệnh về tóc và da đầu. Vải lót Sunda có kết cấu màng lưới lớn độc quyền duy nhất trên các sản phẩm của Công Ty TNHH LongHuei, cho phép không khí lưu thông dễ dàng vào bên trong, tạo cảm giác thoáng mát và dễ chịu .\u003c/li\u003e\n\u003cli\u003eKhóa bằng INOX và dây đai chịu được lực kéo mạnh, chắc chắn, luôn bám sát vào đầu đảm bảo an toàn tốt nhất.\u003c/li\u003e\n\u003cli\u003eQuai mũ dệt 2 lớp bằng sợi tổng hợp, chịu lực kéo lực văng tốt, dễ thao tác khi sử dụng\u003c/li\u003e\n\u003cli\u003eMũ được sơn bằng nguyên liệu ngoại nhập, độ bền cao, chống trầy rất tốt (3 đến 5 năm). Với mũ bảo hiểm dỏm mua vài chục nghìn, lớp sơn sẽ nhanh chóng bong tróc sau nửa năm sử dụng.\u003c/li\u003e\n\u003cli\u003eMũ có 3 khuy bấm phía trên nên bạn có thể lắp thêm kính rời nếu có nhu cầu. Lưỡi trai đi kèm mũ cũng có thể tháo rời dễ dàng bằng cách giật 3 khuy bấm.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e***  Hướng dẫn xác định cỡ mũ phù hợp: Vòng 1 sợi dây quanh đầu, ngay phía trên lông mày và tai. Xiết sợi dây sao cho ôm vừa đủ thoải mái lấy đầu và ghi lại số đo đó. Lặp lại như vậy để tìm được số đo mà bạn thấy đầu dễ chịu nhất và sử dụng số đo đó. Đó chính là size đầu (chu vi đầu) của bạn. So sánh với cỡ mũ để lựa chọn loại mũ phù hợp.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/0b/48/41/9cc079bd8ee0189a781bdf3d7eb62ba6.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0b/48/41/9cc079bd8ee0189a781bdf3d7eb62ba6.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/0b/48/41/9cc079bd8ee0189a781bdf3d7eb62ba6.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0b/48/41/9cc079bd8ee0189a781bdf3d7eb62ba6.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0b/48/41/9cc079bd8ee0189a781bdf3d7eb62ba6.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/87/48/fb/c5b32afa59ef32289586041195d7321e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/87/48/fb/c5b32afa59ef32289586041195d7321e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/87/48/fb/c5b32afa59ef32289586041195d7321e.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/87/48/fb/c5b32afa59ef32289586041195d7321e.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/87/48/fb/c5b32afa59ef32289586041195d7321e.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/85/8f/dc/887fa4a6318680dc8b955116ece0eb30.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/85/8f/dc/887fa4a6318680dc8b955116ece0eb30.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/85/8f/dc/887fa4a6318680dc8b955116ece0eb30.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/85/8f/dc/887fa4a6318680dc8b955116ece0eb30.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/85/8f/dc/887fa4a6318680dc8b955116ece0eb30.jpg"},{"base_url":"https://salt.tikicd