age":4,"review_count":4,"review_text":"(4)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/85/77/b9/325930575e5ec66105c12557502822af.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1621,"all_time_quantity_sold":12,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch5\u003eMặt kính siêu bền, vỏ nhựa ABS an toàn cho sức khỏe\u003c/h5\u003e\n\u003cp\u003eMặt bếp hồng ngoại bằng kính cường lực siêu bền, chống xước, chịu được nhiệt độ lên tới 800 độ C, tránh cho bề mặt bếp bị biến dạng hoặc nóng chảy. Sản phẩm làm nóng nhưng không bức xạ nhiệt, bảo đảm an toàn về nhiệt và điện cho người sử dụng.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/6c/ae/6c/387b2d1aad772a6c10442fb61bd592a9.jpg\" alt=\"Bếp hồng ngoại cơ Sunhouse SHD6004 - Hàng chính hãng\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp\u003eChất liệu kính sáng bóng, hạn chế trầy xước, dễ dàng làm sạch. Mặt kính màu đen tinh tế, lịch sự. Vỏ bếp bằng nhựa ABS siêu bền, chịu nhiệt tốt. Bếp gọn nhẹ, dễ dàng di chuyển đến vị trí mà bạn mong muốn.\u003c/p\u003e\n\u003ch5\u003eDễ dàng thao tác với bảng điều khiển cơ nhạy bén\u003c/h5\u003e\n\u003cp\u003e\u003cstrong\u003eBếp hồng ngoại cơ Sunhouse SHD6004\u003c/strong\u003e được trang bị các phím bấm hiển thị Tiếng Việt và màn hình LED hiển thị đa thông tin, mang đến sự tiện lợi cho người dùng trong quá trình sử dụng.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/36/86/f5/96d2bed40e2c1d5527bb7b442ca8896f.png\" alt=\"Bếp hồng ngoại cơ Sunhouse SHD6004 - Hàng chính hãng\" width=\"750\" height=\"502\" /\u003e\u003c/p\u003e\n\u003ch5\u003eCông suất lớn, 5 chế độ nấu linh hoạt\u003c/h5\u003e\n\u003cp\u003eBếp có công suất 2000W cho khả năng nấu nhanh, giúp tiết kiệm tối đa điện năng và thời gian nấu nướng. Ngoài ra bếp có chế độ hẹn giờ bật trước 12 giờ và cài đặt tắt trước 4 giờ giúp người dùng tiết kiệm được thời gian trông coi.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/0a/d6/09/70f67d3a5fb2f1b2c63464bf7a1974bb.jpg\" alt=\"Bếp hồng ngoại cơ Sunhouse SHD6004 - Hàng chính hãng\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp\u003eSản phẩm có 5 chức năng đã được cài đặt sẵn nhiệt độ/công suất: Đun nước, Súp, Lẩu, Nướng, Chiên/Xào. Ngoài ra, bạn có thể tùy chỉnh theo nhu cầu để chế biến nhiều món ăn khác.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/dd/1b/94/7c71112c7a820b902eb09278c1686ab5.jpg\" alt=\"Bếp hồng ngoại cơ Sunhouse SHD6004 - Hàng chính hãng\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp\u003eTrong suốt quá trình nấu, chạm phím “Điện năng” 1 lần, màn hình sẽ cho thấy mức điện năng tiêu thụ. Ấn phím “Điện năng” 2 lần, màn hình hiển thị điện áp hiện tại theo vôn.\u003c/p\u003e\n\u003ch5\u003eSử dụng được cho tất cả các loại nồi\u003c/h5\u003e\n\u003cp\u003eBếp không kén chọn loại nồi chuyên dụng: nồi inox, nhôm, sứ, thủy tinh… giúp tận dụng tối đa các loại nồi sẵn có, tiết kiệm tiền bạc và không gian lưu trữ cho nhà bếp.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/26/96/5b/ba1cfe26443af7f82d6505ccfe3c5e34.jpg\" alt=\"Bếp hồng ngoại cơ Sunhouse SHD6004 - Hàng chính hãng\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp\u003eNgoài ra quạt gió tốc độ cao được trang bị dưới mặt bếp giúp tản nhiệt đều, hạ nhiệt nhanh nhưng không tạt hơi nóng vào người sử dụng. Sản phẩm có tuổi thọ cao, mặt kính bền, linh kiện bền… đều được quạt gió góp phần hỗ trợ.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/85/77/b9/325930575e5ec66105c12557502822af.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/85/77/b9/325930575e5ec66105c12557502822af.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/85/77/b9/325930575e5ec66105c12557502822af.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/85/77/b9/325930575e5ec66105c12557502822af.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/85/77/b9/325930575e5ec66105c12557502822af.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/09/30/00/d767cd079f98b05104860c649a7676c5.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/09/30/00/d767cd079f98b05104860c649a7676c5.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/09/30/00/d767cd079f98b05104860c649a7676c5.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/09/30/00/d767cd079f98b05104860c649a7676c5.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/09/30/00/d767cd079f98b05104860c649a7676c5.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/a3/90/67/eb1bebdf2a26573a2109ca8e45325037.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a3/90/67/eb1bebdf2a26573a2109ca8e45325037.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a3/90/67/eb1bebdf2a26573a2109ca8e45325037.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a3/90/67/eb1bebdf2a26573a2109ca8e45325037.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a3/90/67/eb1bebdf2a26573a2109ca8e45325037.jpg"},{"base_url":"https://salt.tikicdn.com/ts/produc