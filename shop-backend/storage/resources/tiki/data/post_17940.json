f":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":100000,"discount_rate":26,"rating_average":4.8,"review_count":11,"review_text":"(11)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/e2/f8/75/d41b24a20e2898b32d564b09380f61f0.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1276,"all_time_quantity_sold":80,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/6f/35/7d/b1a1d9791e60097f4736d115de4796b4.jpg\" alt=\"\" width=\"633\" height=\"718\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003e4 màu lựa chọn theo sở thích\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003e\u003ciframe src=\"//www.youtube.com/embed/bgn9NzoAT7Q\" width=\"560\" height=\"314\" allowfullscreen=\"allowfullscreen\"\u003e\u003c/iframe\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003eVideo về sản phẩm\u003c/em\u003e\u003c/p\u003e\n\u003ch2\u003e\u003cspan style=\"color: #008000;\"\u003eƯU ĐIỂM\u003c/span\u003e\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003eThiết kế thể thao và nắp đạy thông minh, nhiều màu sắc lựa chọn, an toàn cho sức khỏe và thân thiện với môi trường\u003c/li\u003e\n\u003cli\u003eBền và chịu nhiệt ở nhiệt độ cao, bạn dễ dàng pha trà trực tiếp vào bình hoặc pha sữa,  dễ dàng vệ sinh và giữ bình luôn được bền đẹp.\u003c/li\u003e\n\u003cli\u003eTùy chọn dung tích để sử dụng cho mọi lứa tuổi dùng trong văn phòng hoặc tập luyện thể thao đều rất phù hợp (500ml. 650ml, 1000ml)\u003c/li\u003e\n\u003cli\u003eDùng làm quà tặng rất đẹp và đầy sang trọng không giống như các bình đựng nước thông thường.\u003c/li\u003e\n\u003cli\u003eBình chịu nhiệt ở -20ºC ~ 96ºC (Không bị teo hay phai mùi nhựa)\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/0b/74/ec/8f4ded1c8a77d3838e3b5a63d8d6ca58.jpg\" alt=\"\" width=\"633\" height=\"718\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003e3 dung tích lựa chọn phù hợp theo nhu cầu\u003c/em\u003e\u003c/p\u003e\n\u003ch2 style=\"text-align: left;\"\u003e\u003cspan style=\"color: #008000;\"\u003eCHẤT LIỆU TRITAN LÀ GÌ?\u003c/span\u003e\u003c/h2\u003e\n\u003cul\u003e\n\u003cli style=\"text-align: left;\"\u003eChất liệu\u003cstrong\u003e Tritan\u003c/strong\u003e được chiết xuất tinh khiết từ Copolyester và không chứa BPA (BPA free) nên đảm bải an toàn khi sử dụng và thân thiện với môi trường. Bởi \u003cstrong\u003eTritan\u003c/strong\u003e là một loại nhựa tổng hợp, trong suốt và siêu bền như thủy tinh; nhưng vẫn có độ dẻo, chịu lực tốt và không rơi vỡ\u003c/li\u003e\n\u003cli style=\"text-align: left;\"\u003e\u003cstrong\u003eTritan\u003c/strong\u003e được dùng nhiều trong các hộp đựng thức ăn cao cấp, bình đựng sữa cho trẻ nhỏ vì độ an toàn cao không gây các độc tố như các loại bình nhựa thông thường\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cspan style=\"color: #ff0000;\"\u003e\u003cstrong\u003eĐặc biệt\u003c/strong\u003e\u003c/span\u003e: Bạn có thể đổ trực tiếp nước sôi vào bình để pha trà hoặc các loại lá dùng làm nước uống, pha sữa nóng (Bình không giữ nhiệt)\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/32/36/50/959c940a11ee3c4bd2ce22431de36a06.jpg\" alt=\"\" width=\"750\" height=\"1217\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/63/8c/69/85f1cf4b656cd9c09b03cf9612203caf.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/6e/81/34/5b50c0ec8b257a30e6226d569a10e549.jpg\" alt=\"\" width=\"750\" height=\"883\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/00/af/33/92fe992f191117882e19acb7f75a6604.jpg\" alt=\"\" width=\"750\" height=\"878\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/7c/df/91/d5284d65605cb7530d7e8a674dc82f3c.jpg\" alt=\"\" width=\"750\" height=\"928\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003e\u003cspan style=\"color: #ff0000;\"\u003e\u003cstrong\u003eLưu ý:\u003c/strong\u003e\u003c/span\u003e Mỗi dung tích sẽ có giá thành khác nhau, dung tích thể hiện trên bình (Có thể kiểm tra sản phẩm khi nhận hàng)\u003c/p\u003e\n\u003ch2 style=\"text-align: left;\"\u003e\u003cspan style=\"color: #008000;\"\u003eMỘT SỐ HÌNH ẢNH THỰC TẾ VỀ SẢN PHẨM\u003c/span\u003e\u003c/h2\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/2b/5a/d5/934d8577c0e480ef12c3739e78361d83.jpg\" alt=\"\" width=\"633\" height=\"718\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003eMàu xanh dương\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/84/c7/59/080ec0e52f18cfbba8d162122f7ef231.jpg\" alt=\"\" width=\"633\" height=\"718\" /\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003eMàu xám\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/53/7f/37/a3dc77a3b470595cfebbfe939321b15f.jpg\" alt=\"\" width=\"633\" height=\"718\" /\u003e\u003c