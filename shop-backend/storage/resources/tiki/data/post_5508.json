"discount":9000,"discount_rate":12,"rating_average":4.6,"review_count":51,"review_text":"(51)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/05/62/69/10dcdae574e2da1ff04a6d99d3f58324.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1920,"all_time_quantity_sold":501,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch1 style=\"text-align:center;\"\u003e\u003cspan style=\"color:#ff0000;\"\u003eVỏ Bưởi Sấy Dẻo 200g Nông Lâm Food\u003c/span\u003e\u003c/h1\u003e\n\u003ch2 dir=\"ltr\" style=\"line-height:1.38;margin-top:18pt;margin-bottom:4pt;\"\u003e\u003cspan style=\"font-size:17pt;font-family:Verdana;color:#ff0000;background-color:transparent;font-weight:bold;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\"\u003eThông tin sản phẩm\u003c/span\u003e\u003c/h2\u003e\n\u003cul\u003e\n\u003cli dir=\"ltr\"\u003e\n\u003cp\u003eXuất xứ: Việt Nam\u003c/p\u003e\n\u003c/li\u003e\n\u003cli dir=\"ltr\"\u003e\n\u003cp\u003eQuy cách: Túi 200g\u003c/p\u003e\n\u003c/li\u003e\n\u003cli dir=\"ltr\"\u003e\n\u003cp\u003eSản phẩm được chế biến theo quy trình nghiên cứu phát triển từ trường ĐH Nông Lâm Tp. HCM.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli dir=\"ltr\"\u003e\n\u003cp\u003eVỏ bưởi giúp giảm mỡ và giảm cân do chứa các hợp chất polyphenol có hoạt tính sinh học đặc biệt\u003c/p\u003e\n\u003c/li\u003e\n\u003cli dir=\"ltr\"\u003e\n\u003cp\u003eGiảm hấp thu cholesterol và béo nhờ chứa nhiều chất xơ và pectin\u003c/p\u003e\n\u003c/li\u003e\n\u003cli dir=\"ltr\"\u003e\n\u003cp\u003eGiúp cải thiện sức khỏe đường ruột vì có hàm lượng xơ cao\u003c/p\u003e\n\u003c/li\u003e\n\u003cli dir=\"ltr\"\u003e\n\u003cp\u003eKháng vi vi khuẩn gây bệnh (ví dụ viêm họng) với các thành phần tinh dầu như limonene, g-terpinene, pinene …cũng như các hoạt chất khác\u003c/p\u003e\n\u003c/li\u003e\n\u003cli dir=\"ltr\"\u003e\n\u003cp\u003eKháng tiểu đường vì chứa các flavonoid đặc biệt như naringin và naringenin\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch2\u003e\u003cspan style=\"color:#ff0000;\"\u003eBạn biết gì về Nông Lâm Food ?\u003c/span\u003e\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cp\u003eNguyên liệu thực phẩm, đặc biệt là nguyên liệu thực vật như trái cây, rau củ, thảo mộc bên cạnh cung cấp các dưỡng chất cần thiết cho cơ thể, tùy theo loại còn chứa nhiều hoạt chất sinh học có lợi nhiều mặt khác nhau cho sức khỏe người sử dụng. Phần lớn các hoạt chất này không bền, thường bị hư hoại hay giảm rất nhiều nếu phương pháp bảo quản nguyên liệu, thông số chế biến, và điều kiện bảo quản không phù hợp.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eNongLamFood lựa chọn những loại nguyên liệu có những đặc tính tốt cho sức khỏe một cách nỗi trội để chế biến. Quy trình chế biến được nghiên cứu phát triển tại Khoa Công nghệ Thực Phẩm – Trường ĐH Nông Lâm Tp. HCM. Quá trình chế biến thực tế sau đó được kiểm soát nghiêm ngặt để ‘lưu giữ giá trị mà thiên nhiên’ ban tặng trong từng sản phẩm. Tất cả các bước từ nghiên cứu, đến chế biến, và phân phối được tiến hành với kiến thức chuyên môn cao, với niềm đam mê, sự tận tâm để tạo sản phẩm hữu ích cho sức khỏe người sử dụng và phục vụ cộng đồng.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eNongLamFood khởi nguồn từ Trường ĐH Nông Lâm Tp. HCM, thành lập từ 2015 và là thành viên Trung Tâm Ươm Tạo Doanh nghiệp Công nghệ của Trường. NongLamFood không chỉ đơn thuần là thương hiệu mà còn là tâm huyết của các nhà khoa học được đào tạo nhiều năm từ các nước phát triển, là đam mê của sinh viên cống hiến cho sự phát triển của xã hội.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eNongLamFood được hỗ trợ kỹ thuật và giám sát chế biến bởi FTIE (Food Technology \u0026amp; Innovation Experts), là nhóm cố vấn gồm nhiều chuyên gia thực phẩm là các giáo sư, tiến sĩ, thạc sĩ làm việc tại các trường Đại Học.\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch2\u003e\u003cspan style=\"color:#ff0000;\"\u003eCông dụng của Vỏ Bưởi Sấy Dẻo\u003c/span\u003e\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cem\u003eGiảm cân:\u003c/em\u003e\u003c/strong\u003e Bên trong vỏ bưởi sấy dẻo vẫn còn chứa các hợp chất polyphenol có hoạt tính sinh học đặc biệt giúp cho lượng mỡ trong cơ thể đốt cháy hiệu quả, nhanh chóng. Ngoài ra vỏ bưởi sấy dẻo còn giúp giảm hấp thu cholesterol và chất béo nhờ chứa nhiều chất xơ và pectin. Vì vậy, lượng mỡ thừa và lượng calo trong cơ thể được đốt cháy nhanh chóng giúp giảm tích tụ mỡ thừa dẫn đến tăng cân béo phì\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003e\u003cem\u003e\u003cstrong\u003eTăng sức đề kháng:\u003c/strong\u003e\u003c/em\u003e Bên trong vỏ bưởi chứa rất nhiều vitamin C cùng nhiều loại hợp chất giúp cơ thể tăng cường hệ miễn dịch một cách tự nhiên ngăn ngừa cảm lạnh, cảm cúm và các bệnh nhiễm trùng. Cùng với hương thơm dễ chịu vỏ bưởi sấy dẻo giúp cho tinh thần trở nên sảng khoái thư giản và dể chịu hơn.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003e\u003cem\u003e\u003cstrong\u003eCải thiện sức khỏe đường ruột:\u003c/strong\u003e\u003c/em\u003e Nhờ vậy mà khi mắc chứng ăn không tiêu, đầy hơi, chướng bụng thì chỉ cần ăn một ít vỏ bưởi sấy dẻo là sẽ cảm thấy đỡ hơn.Ngoài ra, đây còn là thực phẩm cực tốt cho người bị tiểu đường, sỏi thận vì các hợp chất bên trong vỏ bưởi giúp cơ thể loại bỏ các chất lỏng dư thừa tích tụ và kiểm soát tốt chỉ số đường huyết trong cơ thể.\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch2 dir=\"ltr\"\u003e\u003cspan style=\"color:#ff0000;\"\u003eHướng dẫn sử dụng\u003c/span\u003e\u003c/h2\u003e\n\u003cul\u003e\n\u003cli dir=\"ltr\"\u003e\n\u003cp\u003eDùng ăn liền .\u003c/p\u003e\n\u003c/li\u003e\n\u003cli dir=\"ltr\"\u003e\n\u003cp\u003eSau khi mở bao bì nên sử dụng sản phẩm trong vòng 10 ngày.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli dir=\"ltr\"\u003e\n\u003cp\u003eKhông sử dụng sản phẩm đã hết hạn, sản phẩm có dấu hiệu biến chất, đổi màu, nấm mốc.\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch2 dir=\"ltr\" style=\"line-height:1.38;margin-top:18pt;margin-bottom:4pt;\"\u003e\u003cspan style=\"font-size:17pt;font-family:Verdana;color:#ff0000;background-color:transparent;font-weight:bold;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\"\u003eHướng dẫn bảo quản\u003c/span\u003e\u003c/h2\u003e\n\u003cul\u003e\n\u003cli dir=\"ltr\" style=\"line-height:1.38;\"\u003e\n\u003cp\u003e\u003cspan style=\"font-size:10.5pt;font-family:Verdana;color:#000000;background-color:transparent;font-weight:400;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\"\u003eBảo quản ở nhiệt độ thường.\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli dir=\"ltr\" style=\"line-height:1.38;\"\u003e\u003cspan style=\"font-size:10.5pt;font-family:Verdana;color:#000000;background-color:transparent;font-weight:400;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\"\u003eTránh tiếp xúc ánh nắng trực tiếp.\u003c/span\u003e\u003c/li\u003e\n\u003cli dir=\"ltr\" style=\"line-height:1.38;\"\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/05/62/69/10dcdae574e2da1ff04a