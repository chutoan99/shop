":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/b9/c9/36/5d95d40dcf3ec2b03be41edfcbce4ccd.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2464,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch5 style=\"text-align: center;\"\u003e\u003cbr /\u003e\u003ciframe src=\"https://www.youtube.com/embed/C8sOsA6zwNg\" width=\"560\" height=\"315\" frameborder=\"0\" allowfullscreen=\"allowfullscreen\"\u003e\u003c/iframe\u003e\u003c/h5\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003ciframe src=\"https://www.youtube.com/embed/_Iwy31dZDCQ\" width=\"560\" height=\"315\" frameborder=\"0\" allowfullscreen=\"allowfullscreen\"\u003e\u003c/iframe\u003e\u003cbr /\u003e\u003cbr /\u003e\u003c/p\u003e\n\u003ch5\u003eKiểu dáng hiện đại\u003c/h5\u003e\n\u003cp\u003e\u003cstrong\u003eNồi cơm điện Zojirushi NP-HRQ18\u003c/strong\u003e bí quyết lâu đời đến từ thương hiệu nồi cơm bán chạy số 1 Nhật Bản, nay được thiết kế riêng cho hạt gạo Việt Nam. Có kiểu dáng hiện đại với gam màu trầm ấm đầy tinh tế, sang trọng và có dung tích lớn lên đến 1.8L, thích hợp dành cho gia đình có 4 - 6 thành viên. Cùng với thiết kế quai xách tiện lợi để bạn có di dời nồi cơm điện một cách dễ dàng và thuận tiện hơn.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/2d/2f/ce/f0ef28c0919c10b51eb9a5ea05c06918.jpg\" alt=\"Nồi Cơm Điện Zojirushi NP-BSQ18V-TA (1.8L) - Nâu Tím\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003ch5\u003eChất liệu cao cấp - an toàn cho sức khoẻ\u003c/h5\u003e\n\u003cp\u003eĐặc biệt sản phẩm có lớp vỏ ngoài được làm bằng chất liệu thép không gỉ cao cấp, mang lại độ bền cao, giúp sản phẩm trông như mới lâu hơn. Lòng nồi được mạ Platinum giúp tăng cường độ ngọt cho gạo mà vẫn đảm bảo an toàn vệ sinh.\u003c/p\u003e\n\u003cp\u003eNgoài ra với chất liệu Platinum này giống như 1 lớp chống dính giúp cơm không bị dính vào nồi từ đó giúp việc vệ sinh nồi dễ dàng hơn. \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/74/e7/a3/124ec4b510ccedf1fc51e0728b326b67.jpg\" alt=\"Nồi Cơm Điện Zojirushi NP-BSQ18V-TA (1.8L) - Nâu Tím\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003ch5\u003eHệ thống điều chỉnh nhiệt độ thông minh\u003c/h5\u003e\n\u003cp\u003eNồi cơm Zojirushi còn có ưu điểm đó là sử dụng hệ thống điều khiển nhiệt chính xác và áp suất để nấu cơm hoàn hảo với tên gọi là AI (Artificial Intelligence).\u003c/p\u003e\n\u003cp\u003eViệc nấu cơm bằng áp suất giúp biến hạt tinh bột beta thành alpha tạo nên hạt cơm chín mềm dẻo có lợi cho hệ tiêu hoá. Phát huy phương pháp nấu gia nhiệt Hagama với vòng đệm đôi dẫn nhiệt hiệu quả giúp cơm chín đều và sáng bóng. Nồi cơm thông minh tự động thay đổi nhiệt độ và thời gian nấu.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/0e/b6/55/c80705d46f93112b1f22f7b0479070af.jpg\" alt=\"Nồi Cơm Điện Zojirushi NP-BSQ18V-TA (1.8L) - Nâu Tím\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003ch5\u003eTích hợp nhiều chức năng nấu tiện lợi\u003c/h5\u003e\n\u003cp\u003eCùng với việc lựa chọn kết cấu hạt cơm từ 7 cấp nấu khác nhau và hấp áp suất Unami sẽ giải phóng hương vị tối ưu từ hạt gạo.\u003c/p\u003e\n\u003cp\u003eNgoài ra sản phẩm còn tích hợp chức năng nấu cơm thông minh, như là nấu gạo hạt dài (LONG GRAIN), 2 chức năng nấu cháo đặc (THICK) hoặc loãng (THIN), chức năng nấu cơm cháy (SCORCH), chức năng nấu xôi (SWEET) vô cùng tiện lợi đáp ứng rất tốt nhu cầu của người nội trợ.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/af/9a/e3/573df2a2b785081d27ae396c4732cdbe.jpg\" alt=\"Nồi Cơm Điện Zojirushi NP-BSQ18V-TA (1.8L) - Nâu Tím\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003ch5\u003eKhả năng nấu gạo lức và giữ ấm hiệu quả\u003c/h5\u003e\n\u003cp\u003eNồi cơm còn có nắp khoá đôi giữ ẩm tối đa khi nấu xong và trong thời gian giữ nóng giúp cơm luôn thơm dẻo không bị khô. Hơn nữa, còn có thể chế biến gạo lứt thơm ngon, đầy chất dinh dưỡng chính là điểm nổi bật của loại nồi này.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/9d/de/d6/8a11fee1119c22f97b6621214c689fc8.jpg\" alt=\"Nồi Cơm Điện Zojirushi NP-BSQ18V-TA (1.8L) - Nâu Tím\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/b9/c9/36/5d95d40dcf3ec2b03be41edfcbce4ccd.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b9/c9/36/5d95d40dcf3ec2b03be41edfcbce4ccd.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b9/c9/36/5d95d40dcf3ec2b03be41edfcbce4ccd.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b9/c9/36/5d95d40dcf3ec2b03be41edfcbce4ccd.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b9/c9/36/5d95d4