(15)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/e3/e7/05/d5671f1a5fa6ccabc5d462e013aa471e.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1868,"all_time_quantity_sold":103,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cspan style=\"color:#333333;font-family:Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:13px;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/30/4d/f1/b863993573ff0142dc30bbe1696748cb.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003ch3\u003eĐặc điểm nổi bật\u003c/h3\u003e\n\u003cp\u003e\u003cspan style=\"margin:0px;padding:0px;font-weight:bold;color:#333333;font-family:Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:13px;\"\u003eNước rửa bình sữa Dnee\u003c/span\u003e\u003cspan style=\"color:#333333;font-family:Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:13px;\"\u003e sản xuất tại Thái Lan bởi D-nee, nhãn hiệu chất lượng hàng đầu Thái Lan về bình sữa, núm vú, máy hút sữa và các sản phẩm chăm sóc làn da và đồ vệ sinh cho trẻ em.\u003c/span\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cspan style=\"color:#333333;font-family:Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:13px;\"\u003eLà dung dịch tẩy rửa, hạn chế nấm mốc cho bình sữa, núm vú, dụng cụ cai sữa, rau quả và đồ chơi trẻ em.\u003c/span\u003e\u003c/li\u003e\n\u003cli\u003e\u003cspan style=\"color:#333333;font-family:Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:13px;\"\u003eSản phẩm có thành phần từ các chất tương tự như bánh gatô và kem trái cây, nên rất an tâm khi sử dụng cho bé.\u003c/span\u003e\u003c/li\u003e\n\u003cli\u003e\u003cspan style=\"color:#333333;font-family:Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:13px;\"\u003eLà hoá hợp của các chất có khả năng tẩy rửa như este, glycoliqid hàm chứa bên trong trái cây, và tinh chất từ cam.\u003c/span\u003e\u003c/li\u003e\n\u003cli\u003e\u003cspan style=\"color:#333333;font-family:Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:13px;\"\u003eLà chất tẩy nhưng mềm mại cho da mẹ,  đóng gói dạng chai có ống dẫn tiện dụng.\u003c/span\u003e\u003c/li\u003e\n\u003cli\u003e\u003cspan style=\"color:#333333;font-family:Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:13px;\"\u003eNước rửa bình sữa dạng túi đựng bằng chất dễ phân hủy, tiện dụng và an toàn cho môi trường.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003e\u003cspan style=\"color:#333333;font-family:Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:13px;\"\u003eCông dụng\u003c/span\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eLàm sạch các vết ố bẩn như vết sữa, vết dầu, vết thức ăn và loại bỏ những mùi chua hôi.\u003c/li\u003e\n\u003cli\u003eDùng để ngâm rửa loại bỏ dư lượng thuốc trừ sâu hay hóa chất bảo quản còn đọng lại trên rau quả và trái cây.\u003c/li\u003e\n\u003cli\u003eĐộ pH trung tính tránh không ăn mòn bình mòn bình sữa và các vật dụng.\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3 style=\"margin:0px 0px 10px;padding:0px;color:#333333;font-family:Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:13px;\"\u003e\u003cspan style=\"margin:0px;padding:0px;\"\u003eHướng dẫn sử dụng nước rửa bình sữa Dnee\u003c/span\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eBước 1: Bạn hòa 1/3 nắp hoặc 10ml dung dịch rửa bình sữa D-Nee với 1 lít nước, sau đó vệ sinh bình sữa hoặc đồ dùng của bé bằng bàn chải hoặc khăn sạch.\u003c/li\u003e\n\u003cli\u003eBước 2. Làm sạch bằng nước sạch.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"margin:0px 0px 10px;padding:0px;color:#333333;font-family:Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:13px;\"\u003e\u003cspan style=\"margin:0px;padding:0px;font-weight:bold;\"\u003eThành phần\u003c/span\u003e: Lauryl Polyglucose, Sodium Lauryl Ether Sulfate\u003cbr style=\"margin:0px;padding:0px;\" /\u003e\u003cspan style=\"margin:0px;padding:0px;font-weight:bold;\"\u003eBảo quản\u003c/span\u003e: Bạn nên để sản phẩm ở nơi khô ráo, thoáng mát\u003cbr style=\"margin:0px;padding:0px;\" /\u003e\u003cspan style=\"margin:0px;padding:0px;font-weight:bold;\"\u003eLưu ý\u003c/span\u003e: Cách xa tầm tay trẻ em, không nên cho trẻ chơi hoặc đùa nghịch với sản phẩm\u003cbr style=\"margin:0px;padding:0px;\" /\u003e\u003cspan style=\"margin:0px;padding:0px;font-weight:bold;\"\u003eHạn sử dụng\u003c/span\u003e: 3 năm kể từ ngày sản xuất được in trên bao bì\u003cbr style=\"margin:0px;padding:0px;\" /\u003e\u003cspan style=\"margin:0px;padding:0px;font-weight:bold;\"\u003eNgày sản xuất:\u003c/span\u003e Xem trên bao bì (Ngày /tháng/ năm/ Số lô sản xuất)\u003cbr style=\"margin:0px;padding:0px;\" /\u003e\u003cspan style=\"margin:0px;padding:0px;font-weight:bold;\"\u003eSản xuất tại\u003c/span\u003e: Thái Lan\u003c/p\u003e\n\u003ch3\u003eThông tin thương hiệu\u003c/h3\u003e\n\u003cp\u003eDnee là một thương hiệu về sản phẩm chăm sóc gia đình và trẻ em nổi tiếng của Thái Lan. Các dòng nước giặt xả, sữa tắm, dầu gội dành cho trẻ sơ sinh và gia đình,.... được hàng triệu người Việt Nam tin dùng. Tất cả sản phẩm của Dnee đều được trải qua những quy trình sản xuất nghiêm ngặt để đạt được tiêu chuẩn chất lượng cao nhất. Các sản phầm của Dnee mang tới cho gia đình bạn một hương thơm rất tự nhiên và an toàn từ những chiếc áo quần của bé và mẹ\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/e3/e7/05/d5671f1a5fa6ccabc5d462e013aa471e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e3/e7/05/d5671f1a5fa6ccabc5d462e013aa471e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e3/e7/05/d5671f1a5fa6ccabc5d462e013aa471e.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e3/e7/05/d5671f1a5fa6ccabc5d462e013aa471e.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e3/e7/05/d5671f1a5fa6ccabc5d462e013aa471e.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/18/75/83/ebc0c258694f075bc1ade8adc56d3c3f.jpeg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/18/75/83/ebc0c258694f075bc1ade8adc56d3c3f.jpeg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/18/75/83/ebc0c258694f075bc1ade8adc56d3c3f.jpeg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/18/75/83/ebc0c258694f075bc1ade8adc56d3c3f.jpeg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/18/75/83/ebc0c258694f075bc1ade8adc56d3c3f.jpeg"},{"base_url":"https://salt.tikicdn.com/ts/product/8a/b9/dd/9b188633a4c950823042536fbadf69df.jpeg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/8a/b9/dd/9b188633a4c950823042536fbadf69df.jpeg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/8a/b9/dd/9b188633a4c950823042536fbadf69df.jpeg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8a/b9/dd/9b188633a4c950823042536fbadf69df.jpeg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8a/b9/dd/9b188633a4c950823042536fbadf69df.jpeg"},{"base_url":"https://salt.tikicdn.com/ts/product/a1/6c/48/5ac1bea91c2514e09365744eb37983c4.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com