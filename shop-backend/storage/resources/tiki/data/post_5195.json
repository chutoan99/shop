view_text":"(4)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/81/a9/ec/b7b278d3590725bfc1d5c6c3c2eebb95.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1664,"all_time_quantity_sold":23,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch5 style=\"text-align: justify;\"\u003eThiết kế nhỏ gọn\u003c/h5\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eMáy vắt cam Sharp EJ-J130-ST\u003c/strong\u003e được đánh giá cao với ngoại hình thực sự gọn. Điều này sẽ giúp tiết kiệm được nhiều hơn không gian bếp của gia đình bạn. Và ngoại hình sản phẩm cũng được đánh giá tốt khi có thiết kế với chất liệu nhựa nhẹ hơn, trong suốt mang đến vẻ đẹp cao cấp không những cho thiết bị mà còn cho không gian bếp của bạn.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/7b/46/a2/731fd330726238a6444e7eabcf5131f7.jpg\" alt=\"Máy Vắt Cam Sharp EJ-J130-ST - Hàng Chính Hãng\" width=\"750\" height=\"415\" /\u003e\u003c/p\u003e\n\u003ch5 style=\"text-align: justify;\"\u003eThiết kế máy vắt cam đầu rót trực tiếp tiện lợi, dễ dàng vắt ép liên tục với số lượng nhiều\u003c/h5\u003e\n\u003cp style=\"text-align: justify;\"\u003eChỉ cần dùng ly hứng nước ép từ đầu rót, người dùng vắt ép liên tục mà không cần ngưng lại tháo ly chứa ra để lấy nước ép. Sản phẩm đặc biệt thích hợp sử dụng cho nhu cầu kinh doanh ăn uống, gia đình đông người...\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/d0/f8/fd/4915c3bac765c969304d4c32c420d851.jpg\" alt=\"Máy Vắt Cam Sharp EJ-J130-ST - Hàng Chính Hãng\" width=\"750\" height=\"415\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003eViệc có thiết kế nhựa trong suốt cao cấp cũng giúp cho bạn có thể dễ dàng quan sát được lượng nước bên trong lúc vắt và xem được lúc nào thì ngưng vắt vì đủ nước cam để dùng.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/c9/26/7e/ee4dbcd682d319275b841ecae8cbe1cb.jpg\" alt=\"Máy Vắt Cam Sharp EJ-J130-ST - Hàng Chính Hãng\" width=\"750\" height=\"415\" /\u003e\u003c/p\u003e\n\u003ch5\u003eLưới lọc bằng chất liệu thép không gỉ bền bỉ, dễ vệ sinh, dùng an toàn\u003c/h5\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/56/4e/30/32e00f9c80ad60294b822b5339981866.jpg\" alt=\"Máy Vắt Cam Sharp EJ-J130-ST - Hàng Chính Hãng\" width=\"750\" height=\"415\" /\u003e\u003c/p\u003e\n\u003ch5 style=\"text-align: justify;\"\u003eCông suất 130W\u003c/h5\u003e\n\u003cp style=\"text-align: justify;\"\u003eSản phẩm cũng có thể hoạt động mạnh mẽ với công suất 130W nên dường như chỉ cần vài phút thôi, bạn sẽ có được một ly nước cam tươi ngon mà không cần mất nhiều thời gian.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/a9/76/d8/a8f4e781b31b2ce5b130671e124760e6.jpg\" alt=\"Máy Vắt Cam Sharp EJ-J130-ST - Hàng Chính Hãng\" width=\"750\" height=\"415\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003eMáy có tốc độ ép nhanh và kiệt nước, không ảnh hưởng đến vỏ trái cây bị ép nên không ra dầu vỏ gây đắng thường gặp như những sản phẩm khác.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/8e/73/b2/bb053025dd493abbf20b7a1d3be9cdff.jpg\" alt=\"Máy Vắt Cam Sharp EJ-J130-ST - Hàng Chính Hãng\" width=\"750\" height=\"415\" /\u003e\u003c/p\u003e\n\u003ch5\u003eĐầu vắt bằng nhựa chắc chắn, bền tốt, vắt hiệu quả, tự động đảo chiều trong quá trình hoạt động giúp vắt kỹ hơn, tăng lượng nước ép\u003c/h5\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/0d/94/af/adfe09c7fd8714be91ec204fad6ff132.jpg\" alt=\"Máy Vắt Cam Sharp EJ-J130-ST - Hàng Chính Hãng\" width=\"750\" height=\"415\" /\u003e\u003c/p\u003e\n\u003ch5 style=\"text-align: justify;\"\u003eDễ dàng tháo lắp, vệ sinh máy\u003c/h5\u003e\n\u003cp style=\"text-align: justify;\"\u003eMiệng vòi của Máy vắt cam Sharp EJ-J130-ST cũng được thiết kế theo kiểu mới nên có thể đảm bảo rằng máy sẽ không nhỏ giọt khi bạn rót nước ép ra ngoài. Điều này sẽ giúp cho gian bếp luôn sạch sẽ gọn gàng.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/c5/c5/6d/d4be104c071d0b32ec12a05b13667124.jpg\" alt=\"Máy Vắt Cam Sharp EJ-J130-ST - Hàng Chính Hãng\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003eCác bộ phận khác của máy vắt cam đều có thể tháo rời dễ dàng nhằm giúp căn bếp của bạn gọn gàng hơn, sạch sẽ hơn. Hay các bộ phận của máy có thể tháo lắp một cách dễ dàng, rất thuận tiện trong việc vệ sinh, lau chùi sau khi dùng. \u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/59/14/43/8edeafc19c6dc129a04992d62367ce04.jpg\" alt=\"Máy Vắt Cam Sharp EJ-J130-ST - Hàng Chính Hãng\" width=\"750\" height=\"415\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/81/a9/ec/b7b278d3590725bfc1d5c6c3c2eebb95.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/81/a9/ec/b7b278d3590725bfc1d5c6c3c2eebb95.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/81/a9/ec/b7b278d3590725bfc1d5c6c3c2eebb95.jpg","position":null,"small_url":"