und_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":15000,"discount_rate":50,"rating_average":4.6,"review_count":10,"review_text":"(10)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/f3/ff/a6/f02d5660713fb8f409748a8584883663.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":358,"all_time_quantity_sold":86,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-llnb1edwd8pb22\" width=\"1154\" height=\"1800\" alt=\"vn-11134208-7r98o-llnb1edwd8pb22\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-llnb1edwen9r6d\" width=\"1200\" height=\"1858\" alt=\"vn-11134208-7r98o-llnb1edwen9r6d\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-llnb1edwg1u72e\" width=\"1200\" height=\"1602\" alt=\"vn-11134208-7r98o-llnb1edwg1u72e\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-llnb1edwhgenf3\" width=\"1200\" height=\"1816\" alt=\"vn-11134208-7r98o-llnb1edwhgenf3\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-llnb1edwiuz373\" width=\"1200\" height=\"1803\" alt=\"vn-11134208-7r98o-llnb1edwiuz373\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-llnb1edwk9jjcc\" width=\"1200\" height=\"1803\" alt=\"vn-11134208-7r98o-llnb1edwk9jjcc\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-llnb1edwlo3zf3\" width=\"1200\" height=\"1411\" alt=\"vn-11134208-7r98o-llnb1edwlo3zf3\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-llnb1edwn2of30\" width=\"1200\" height=\"1584\" alt=\"vn-11134208-7r98o-llnb1edwn2of30\" /\u003e\u003c/p\u003e\n\u003cp\u003eNhà vệ sinh là nơi chứa nhiều vi khuẩn và hôi  khó xử lý dứt điểm. Vì vậy CleanZ ra mắt sản phẩm viên thả bồn cầu CleanZ tẩy sạch mảng bám, sạch khuẩn với những đặc điểm ưu việt giúp nhà vệ sinh thơm mát sạch khuẩn. Góp phần bảo vệ sức khỏe và chất lượng cuộc sống của gia đình bạn\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eMô tả sản phẩm\u003c/p\u003e\n\u003cp\u003e- Tên sản phẩm :  Viên thả bồn cầu\u003c/p\u003e\n\u003cp\u003e- Trọng lượng : 50g - 1 viên/ gói\u003c/p\u003e\n\u003cp\u003e- Thành phần: Active detergent, fungicide, aromatic agent, high polymer\u003c/p\u003e\n\u003cp\u003e- Công thức đặc biệt với hoạt chất có hiệu quả cao chống sản sinh mảng bám ố vàng trên bồn cầu, khử khuẩn kháng mùi.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eƯu điểm: Sản phẩm có công thức sinh học tiên tiến được đặc chế giúp loại bỏ nhanh những vi khuẩn từ chất thải và vi khuẩn tích tụ trên toilet. Sản phẩm không những có tác dụng KHỬ MÙI HÔI và TIÊU DIỆT CÁC VI KHUẨN CÓ HẠI, hạn chế sự sinh trưởng của vi trùng gây hại, mà còn thay vì 1-2 ngày bạn phải cọ rửa bồn cầu 1 lần thì với sản phẩm này chỉ 1-2 TUẦN BẠN MỚI PHẢI CỌ RỬA BỒN CẦU 1 LẦN. Như vậy đã đỡ mất thời gian và công sức của bạn khá nhiều phải không nào. Hơn nữa, sản phẩm còn giúp duy trì sự sáng bóng của gốm (men) bồn cầu.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e- Thời gian sử dụng 15 - 18 ngày tùy theo mức độ sử dụng, tiết kiệm chi tiêu, tiết kiệm thời gian\u003c/p\u003e\n\u003cp\u003e- Bao bì dạng túi dễ sử dụng\u003c/p\u003e\n\u003cp\u003e- Hoạt chất có hiệu quả  làm  sạch cao và chống vết bẩn trở lại lâu hơn\u003c/p\u003e\n\u003cp\u003e- Phân tử khử mùi mùi hôi và giữ lại hương thơm lâu dài, mỗi lần xả bằng làm sạch sâu\u003c/p\u003e\n\u003cp\u003e- thời gian sử dụng thử nghiệm thực tế viên thả bồn cầu CleanZ có thể được sử dụng trong khoảng 20 ngày ở nhiệt độ thường sau khi được xả 17 lần một ngày\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eCông dụng:\u003c/p\u003e\n\u003cp\u003e- Làm sạch hoàn toàn những vết bẩn, ố vàng đọng lại trên bồn cầu.\u003c/p\u003e\n\u003cp\u003e- Khử mùi hôi khó chịu trong toilet, giữ cho toilet luôn thơm mát.\u003c/p\u003e\n\u003cp\u003e- Duy trì độ trắng bóng, sáng của gốm sứ, không gây xước men.\u003c/p\u003e\n\u003cp\u003e- Đặc biệt Viên sạch bồn cầu CleanZ được đóng gói mỗi viên vào 1 túi nilon để khách hàng dễ dàng bảo quản khi sử dụng.\u003c/p\u003e\n\u003cp\u003e- Sử dụng đến 348 lần xả.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eHướng dẫn sử dụng viên thả bồn cầu: \u003c/p\u003e\n\u003cp\u003e- Lấy viên sạch bồn cầu ra khỏi túi\u003c/p\u003e\n\u003cp\u003e- Mở ngăn nước và đặt vào cửa xả nước\u003c/p\u003e\n\u003cp\u003e- Chờ 10p để viên thả bồn cầu tan ra đổi màu nước.\u003c/p\u003e\n\u003cp\u003e- Sau thời gian dài sử dụng viên cũ tan ra hết thì thay viên mới\u003c/p\u003e\n\u003cp\u003e#vienthaboncau #lamsacboncau #taynhavesinh #aikomi # khumuivesinh # vienthalamsach\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/f3/ff/a6/f02d5660713fb8f409748a8584883663.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f3/ff/a6/f02d5660713fb8f409748a8584883663.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f3/ff/a6/f02d5660