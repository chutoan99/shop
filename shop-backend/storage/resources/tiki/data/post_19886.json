,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":98000,"discount_rate":31,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/48/90/5a/e9feb87e835bbfa47a8b207a88c6ceab.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":187,"all_time_quantity_sold":7,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eTrải nghiệm sự sạch sẽ, thư giãn toàn thân từ bộ sản phẩm đến từ Men Stay Simplicity mang lại, bao gồm: Sữa tắm tinh dầu cao cấp 500ml \u0026amp; Dung dịch vệ sinh nam 135ml chứa thành phần tinh dầu thiên nhiên kết hợp với thành phần dưỡng ẩm, giúp làm sạch và không gây khô da, ngăn mùi hiệu quả, đồng thời giúp thư giãn ngay khi dùng.\u003cbr /\u003e*Che tên sản phẩm in trên đơn hàng*\u003cbr /\u003e\u003cbr /\u003eCÔNG DỤNG CHÍNH:\u003cbr /\u003e- Làm sạch toàn thân\u003cbr /\u003e- Dưỡng ẩm, da không bị khô ráp, ngứa\u003cbr /\u003e- Ngăn mùi hiệu quả lên đến 24h\u003c/p\u003e\n\u003cp\u003e- Tạo cảm giác thư giãn, sảng khoái ngay khi dùng\u003cbr /\u003e\u003cbr /\u003eTHÀNH PHẦN CHÍNH VÀ CƠ CHẾ HOẠT ĐỘNG:\u003cbr /\u003eSản phẩm sử dụng chiết xuất thiên nhiên lành tính:\u003cbr /\u003e- Glycerin: cơ chế hút hơi ẩm từ không khí vào lớp sừng (lớp trên cùng của da), giúp bổ sung độ ẩm cần thiết cho da, từ đó giúp cơ thể hạn chế tiết mồ hôi và ngăn mùi toàn thân.\u003cbr /\u003e- 9 loại tinh dầu: giảm căng thẳng, mang lại sự sảng khoái, thư giãn tinh thần, mùi hương lưu hương trên cơ thể từ 2-3 tiếng (tùy cơ địa)\u003cbr /\u003e- Bạc hà \u0026amp; Cam Bergamot: khử mùi \u0026amp; làm sạch dịu nhẹ, không gây cảm giác the mát, ngứa ngáy, mùi hương dịu nhẹ.\u003c/p\u003e\n\u003cp\u003ePHÙ HỢP VỚI:\u003cbr /\u003e- Người dùng đang gặp các vấn đề về mùi cơ thể từ nhẹ đến vừa\u003cbr /\u003e- Người dùng đang gặp vấn đề khô, ngứa da\u003cbr /\u003e- Người dùng cần sự thư giãn thoải mái sau ngày dài\u003cbr /\u003e- Người dùng sản phẩm làm sạch toàn diện\u003cbr /\u003e- Người sử dụng nước hoa vì mùi tinh dầu không làm mất mùi đặc trưng của nước hoa\u003cbr /\u003e\u003cbr /\u003eHƯỚNG DẪN SỬ DỤNG\u003cbr /\u003e- Sữa tắm: Lấy một lượng sữa tắm vừa đủ, thoa đều lên nền da ẩm rồi rửa sạch với nước sau khi dùng. Trải nghiệm thư giãn hiệu quả hơn khi tắm với nước ấm.\u003cbr /\u003e- Dung dịch vệ sinh nam: Lấy một lượng dung dịch vệ sinh vừa đủ, thoa đều lên nền da ẩm trong 1 phút. Rửa sạch lại với nước, chú ý các nếp gấp và kẽ trên da.\u003cbr /\u003eNên dùng khăn tắm sợi tre cao cấp 60x120cm Men Stay Simplicity với khả năng thấm hút vượt trội, lau sạch toàn thân.\u003cbr /\u003e\u003cbr /\u003eNGUYÊN TẮC TH N THIỆN\u003cbr /\u003e- Không sử dụng những thành phần hoá học mạnh, gây kích ứng\u003cbr /\u003e- Không chứa Paraben\u003cbr /\u003e- Không chứa hương liệu nhân tạo\u003c/p\u003e\n\u003cp\u003eTHÔNG TIN SẢN PHẨM\u003cbr /\u003e- Tên: Bộ đôi tắm sạch toàn thân: Sữa tắm tinh dầu cao cấp 500ml và Dung dịch vệ sinh nam 135ml làm sạch \u0026amp; ngăn mùi MSS\u003cbr /\u003e- Thương hiệu: Men Stay Simplicity thuộc Công ty Cổ phần Parsley\u003cbr /\u003e- Nơi sản xuất: Việt Nam\u003cbr /\u003e- Hạn sử dụng: 3 năm kể từ ngày sản xuất\u003cbr /\u003e- Ngày sản xuất: Xem chi tiết trên bao bì\u003cbr /\u003e- Hướng dẫn bảo quản: Để sản phẩm nơi thoáng mát, tránh nhiệt độ cao và ánh nắng trực tiếp\u003cbr /\u003e\u003cbr /\u003e️ Thương hiệu đã được đăng ký bảo hộ ở Cục Sở hữu Trí tuệ Việt Nam.\u003cbr /\u003eSản phẩm đã được cấp giấy Công bố Mỹ phẩm của Bộ Y tế.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/48/90/5a/e9feb87e835bbfa47a8b207a88c6ceab.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/48/90/5a/e9feb87e835bbfa47a8b207a88c6ceab.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/48/90/5a/e9feb87e835bbfa47a8b207a88c6ceab.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/48/90/5a/e9feb87e835bbfa47a8b207a88c6ceab.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/48/90/5a/e9feb87e835bbfa47a8b207a88c6ceab.png"},{"base_url":"https://salt.tikicdn.com/ts/product/48/90/5a/0ecdf925d5f1d659b3ac15fbfbb5f758.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/48/90/5a/0ecdf925d5f1d659b3ac15fbfbb5f758.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/48/90/5a/0ecdf925d5f1d659b3ac15fbfbb5f758.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/48/90/5a/0ecdf925d5f1d659b3ac15fbfbb5f758.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/48/90/5a/0ecdf925d5f1d659b3ac15fbfbb5f758.png"},{"base_url":"https://salt.tikicdn.com/ts/product/4a/2e/28/996cb7118963f04d1bc294d1c563178f.jpeg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/4a/2e/28/996cb7118963f04d1bc294d1c563178f.jpeg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/4a/2e/28/996cb7118963f04d1bc294d1c563178f.jpeg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4a/2e/28/996cb7118963f04d1bc294d1c563178f.jpeg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4a/2e/28/9