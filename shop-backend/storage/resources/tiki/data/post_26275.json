lacement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/0d/f2/cf/bd3b28d4a9ea9d9e7d3c6fcc3cbbfa76.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":653,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eLoa kéo Nanomax SK-15X5 có Bass 40 cm (4 tấc) với công suất lớn 620 watt phù hợp hát karaoke gia đình kết nối bluetooth phạm vi không gian siêu rộng, thời lượng pin lâu bền bỉ với loa 3 đường tiếng cho âm thanh hay sống động.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch2\u003eTHÔNG SỐ KỸ THUẬT LOA KÉO NANOMAX SK-15X5:\u003c/h2\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e• Loại: Karaoke di động \u003cbr /\u003e• Mã: SK-15X5 \u003cbr /\u003e• Số lượng kênh: 3 đường tiếng\u003cbr /\u003e• Công suất: 620W\u003cbr /\u003e• Thời gian sạc: 3-4 tiếng\u003cbr /\u003e• Thời gian pin: 5-7 tiếng tùy âm lượng\u003cbr /\u003e• Tiện ích: Cổng USB, thẻ nhớ\u003cbr /\u003e• Kết nối không dây: Bluetooth 5.0 xa 15m, Mic UHF\u003cbr /\u003e• Kết nối khác: Jack RCA Audio IN/OUT kết nối Micro có dây và Đàn Guitar bên ngoài\u003cbr /\u003e• Kích thước/ Trọng lượng: 45x45x76 cm / 29kg\u003cbr /\u003e• Chất liệu thùng: Gỗ sơn gai chống trầy \u003cbr /\u003e• Sản xuất tại: Việt Nam\u003cbr /\u003e• Bảo hành loa bass, treble và bo mạch chính: 12 tháng \u003cbr /\u003e• Số lượng loa: 1 loa bass 4 tấc + 1 loa mid 16cm + 1 loa treble họng còi 10cm\u003cbr /\u003e• Sử dụng nguồn: AC 220V hoặc Ắc qui 12V\u003cbr /\u003e• Phụ kiện: 1 dây sạc, 2 micro và 4 pin\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eLoa karaoke di động Nanomax SK-15X5 sử dụng công nghệ kết nối không dây bluetooth giúp nghe nhạc mọi lúc mọi nơi với thao tác rất dễ dàng trên smartphone. Những lần tiếp theo, loa sẽ tự động ghi nhớ và kết nối với chính chiếc điện thoại đó.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eLoa karaoke Nanomax SK-15X5 tích hợp rất nhiều chức năng khác: nghe nhạc và karaoke di động, nghe radio FM, nghe nhạc qua USB và thẻ nhớ.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eNanomax SK-15X5 có độ méo tiếng thấp, âm thanh chuẩn, khi mua sẽ nhận full box gồm loa và phụ kiện.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eMicro của Nanomax SK-15X5 được làm từ kim loại sáng bóng tinh tế, đầu có màu bạc kim sang trọng cực nổi bật. Micro được đặt tại hai mạn loa, trong bộ giữ micro, vì vậy người dùng sẽ tiện lợi lấy micro ra sử dụng loa mà không gặp phải khó khăn.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eDo thiết kế sang trọng, vỏ ngoài chắc chắn, bền đẹp và tích hợp đầy đủ các chức năng như chơi nhạc offline từ USB / thẻ nhớ, hát nhạc online / karaoke trên các thiết bị thông minh qua kết nối bluetooth, nghe đài FM, dùng cho các hoạt động thuyết trình / event, gia đì sẽ rất phù hợp với các công ty có nhu cầu sử dụng loa trong phòng họp, hội trường, loa karaoke gia đinh, quán ăn, shop bán đồ, nhà hàng, …\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e️CHẾ ĐỘ BẢO HÀNH\u003cbr /\u003e• 1 đổi 1 trong 15 ngày lỗi sản xuất\u003cbr /\u003e• Bảo hành loa 12 tháng, 6 tháng cho mic và ắc quy\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e️GIỜ LÀM VIỆC CỦA SHOP\u003cbr /\u003e️ Tất cả các ngày từ 7h30 đến 5h (trừ lễ).\u003cbr /\u003e️ Follow shop để được áp mã giảm giá cho khách hàng thân thiết.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e️ CAM KẾT CỦA NAM HOÀNG AUDIO\u003cbr /\u003e• Cung cấp những sản phẩm chính hãng với chất lượng phù hợp với giá tiền \u003cbr /\u003e• Sản phẩm luôn được test kỹ trước khi đóng gói và vận chuyển\u003cbr /\u003e• Hỗ trợ tư vấn / Hướng dẫn sử dụng từ a tới z\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e️ LƯU Ý NHẬN HÀNG \u003cbr /\u003e️ Các đơn hàng không hỗ trợ đồng kiểm, sau khi nhận hàng vui lòng quay video lúc mở để đối chiếu và xử lý một cách tốt nhất.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e#loabluetooth #loakaraoke #loakeo #loakeokeo #nanomax #loakeodidong #loadidong #loahatkaraoke #loakeobass30 #loakeo3tac #loakeodien #mickaraoke #loakeokaraoke #loakaraokegiare #loakeonanomax #loakaraokedidong #loahatkaraoke\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/0d/f2/cf/bd3b28d4a9ea9d9e7d3c6fcc3cbbfa76.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0d/f2/cf/bd3b28d4a9ea9d9e7d3c6fcc3cbbfa76.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/0d/f2/cf/bd3b28d4a9ea9d9e7d3c6fcc3cbbfa76.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0d/f2/cf/bd3b28d4a9ea9d9e7d3c6fcc3cbbfa76.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0d/f2/cf/bd3b28d4a9ea9d9e7d3c6fcc3cbbfa76.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/30/f0/b7/d263b4dbf0f01c7b71dec346c7101b09.jpg","is_gallery":true,"label":null,"large_url