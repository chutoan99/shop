ển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/77/bb/8e/c9e12c8cb281ef58595f2735e2fad6a1.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/77/bb/8e/c9e12c8cb281ef58595f2735e2fad6a1.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/77/bb/8e/c9e12c8cb281ef58595f2735e2fad6a1.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/77/bb/8e/c9e12c8cb281ef58595f2735e2fad6a1.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/77/bb/8e/c9e12c8cb281ef58595f2735e2fad6a1.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/ab/9a/de/d5c124716bbb97007e22a5f9d1013f58.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ab/9a/de/d5c124716bbb97007e22a5f9d1013f58.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ab/9a/de/d5c124716bbb97007e22a5f9d1013f58.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ab/9a/de/d5c124716bbb97007e22a5f9d1013f58.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ab/9a/de/d5c124716bbb97007e22a5f9d1013f58.jpg"}],"warranty_policy":null,"authors":[{"id":143041,"name":"MediaZ","slug":"mediaz"}],"current_seller":{"id":263635,"sku":"8859999287618","name":"Sunbook Store","link":"https://tiki.vn/cua-hang/sunbook-store","logo":"f5/b5/2c/c571bb4348af26cb56b23e93220d3393.png","price":59000,"product_id":"161508813","store_id":250680,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Thông tin chung","attributes":[{"code":"publisher_vn","name":"Công ty phát hành","value":"MEDIAZ"},{"code":"dimensions","name":"Kích thước","value":"14 x 20.5 cm"},{"code":"book_cover","name":"Loại bìa","value":"Bìa mềm"},{"code":"number_of_page","name":"Số trang","