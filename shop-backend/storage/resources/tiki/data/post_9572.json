hác như báo chí, hoạt động xã hội, đấu tranh vì nữ quyền… giai đoạn đầu thế kỉ 20.\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/b7/c3/16/974fbc79d76a0f4363b9ce2047924942.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b7/c3/16/974fbc79d76a0f4363b9ce2047924942.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b7/c3/16/974fbc79d76a0f4363b9ce2047924942.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b7/c3/16/974fbc79d76a0f4363b9ce2047924942.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b7/c3/16/974fbc79d76a0f4363b9ce2047924942.jpg"}],"warranty_policy":null,"authors":[{"id":162107,"name":"Đạm Phương nữ sử","slug":"dam-phuong-nu-su"}],"current_seller":{"id":281062,"sku":"6809415679291","name":"Bamboo Books","link":"https://tiki.vn/cua-hang/bamboo-books","logo":"46/9a/b3/e4fbfd97e7607ea4d2ff8e9ad769121b.jpg","price":58500,"product_id":"272832085","store_id":268132,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[{"id":347428,"name":"Phú Minh Shop","link":"https://tiki.vn/cua-hang/phu-minh-shop","logo":"https://vcdn.tikicdn.com/ts/seller/4b/54/1a/f385a79a716cb3505f152e7af8c769aa.png","price":64500,"product_id":"273442725","store_id":335136}],"specifications":[{"name":"Thông tin chung","attributes":[{"code":"publisher_vn","name":"Công ty phát hành","value":"Kim Đồng"},{"code":"book_cover","name":"Loại bìa","value":"Bìa mềm"},{"code":"number_of_page","name":"Số trang","value":"216"},{"code":"manufacturer","name":"Nhà xuất bản","value":"Nhà 