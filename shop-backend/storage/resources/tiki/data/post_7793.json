eview_text":"(6)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/media/catalog/product/d/s/dsc_0396.u634.d20160502.t163018.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":0,"all_time_quantity_sold":42,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: medium; color: #008ab7;\"\u003e\u003cstrong\u003eBút Sáp Dầu Đ.A Vali Dooly 36 Màu\u003c/strong\u003e\u003c/span\u003e\u003cstrong\u003e \u003c/strong\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eBút Sáp Dầu Đ.A Vali Dooly 36 Màu\u003c/strong\u003e được làm từ nguyên liệu cao cấp, cho màu sắc tươi sáng và chân thật. Sáp dầu mềm, dễ vẽ, không gây đổ bột màu, không gây lem và rất ít hao phí.  Đặc biệt, sản phẩm được đánh giá cao về chất lượng, đạt tiêu chuẩn về an toàn sức khỏe cho người sử dụng.\u003c/p\u003e\r\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Bút Sáp Dầu Đ.A Vali Dooly 36 Màu\" src=\"http://tikicdn.com/media/catalog/product/d/s/dsc_0398.u634.d20160502.t163018.jpg\" alt=\"Bút Sáp Dầu Đ.A Vali Dooly 36 Màu\" width=\"600\" height=\"600\" /\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eThông tin sản phẩm\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eDạng màu sáp dầu tiện dụng\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eBút Sáp Dầu Đ.A Vali Dooly 36 Màu là màu vẽ ở dạng sáp dầu khá mềm nên cho lớp màu rất đều và mịn, có độ phủ và độ bám giấy rất tốt.\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eSáp dầu còn có đặc tính là chất phủ nên có thể tạo ra nhiều bề mặt theo ý muốn như sần sùi, nổi gờ, trơn bóng, dạng hạ Giấy tối sáp lên màu đẹp và có chiều sâu hơn giấy màu trắng thuần.\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eChất liệu cao cấp\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eSản phẩm được làm từ nguyên liệu cao cấp, cho màu sắc tươi sáng và chân thật. Đặc biệt, sản phẩm đạt tiêu chuẩn chất lượng về an toàn sức khỏe cho người sử dụng, an toàn khi các bé vô tình ngậm hoặc nuốt phải.\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eThiết kế tiện ích\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eMàu được bọc trong lớp vỏ giấy, không lem ra tay, cho các bé dễ dàng sử dụng. Với 36 rực rỡ, bé có thể thoả sức sáng tạo nên những tác phẩm nghệ thuật cho riêng mình.\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eBút vừa tay cầm của trẻ, giúp trẻ dễ dàng tô vẽ, sáng tạo. Thiết kế góc cạnh giúp cây màu không bị lăn khi ở trên mặt phẳng. Sản phẩm được đựng trong một va li nhỏ tiện dụng, giúp trẻ cất bút gọn gàng sau khi sử dụng, tránh tình trạng thất lạc.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/media/catalog/product/d/s/dsc_0396.u634.d20160502.t163018.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/d/s/dsc_0396.u634.d20160502.t163018.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/d/s/dsc_0396.u634.d20160502.t163018.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/