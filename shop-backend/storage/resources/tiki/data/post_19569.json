00f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/40/43/06/939ddce11ae784181296dfb2978fdce5.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":461,"all_time_quantity_sold":9,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003carticle class=\"4ever-article\"\u003e\u003cp\u003eĐến với tủ sách của BAC, không thể nào thiếu được combo 3 quyển sách \"hot hit\" dành cho ngành BA cũng như sách phát triển doanh nghiệp về quản trị kinh doanh và khởi nghiệp. \u003c/p\u003e\n\u003cp\u003eChúng tôi - đội ngũ giảng viên BAC, những người đang làm việc trong lĩnh vực phát triển phần mềm - mong muốn truyền tải đến bạn những chia sẻ thực tế về công việc phân tích nghiệp vụ phần mềm (Business Analysis) tại Việt Nam thông qua ấn phẩm của combo Sổ tay Business Analyst - Sác phát triển doanh nghiệp từ ý tưởng đến quản trị - Sách Babok V3 phiên bản tiếng Việt\u003c/p\u003e\n\u003cp\u003eCũng như các bạn, chúng tôi đã từng là người mới, từng bỡ ngỡ khi phải lựa chọn cho mình một ngành nghề thực sự phù hợp với tính cách lẫn đam mê. Chúng tôi hiểu rằng, khi đã quyết định dấn thân vào lĩnh vực phát triển phần mềm, vô vàn câu hỏi không tên: “Tôi là ai trong thế giới phần mềm?”, “Tôi sẽ ở vị trí vào trong đội ngũ phát triển dự án?\" sẽ thường xuyên xuất hiện khiến hành trình khám phá thế giới công nghệ thêm nhiều phần thách thức. Hơn thế nữa, theo phương châm \"GIEO TRÍ THỨC - GIẶT THÀNH CÔNG\" combo 3 quyển sách tại tủ sách BAC sẽ mang lại cho độc giả những nội dung độc đáo và thực tiễn về kinh tế, cách vận hành quản trị tại doanh nghiệp. Đối với các độc giả đang theo đuổi ngành Business Analyst sẽ có cái nhìn thực tiễn hơn. \u003c/p\u003e\n\u003cp\u003e Thông qua ấn phẩm này, chúng tôi hy vọng rằng những kiến thức trong lĩnh vực phần mềm nói chung và công việc phân tích nghiệp vụ nói riêng sẽ trở thành hành trang quý giá, giúp các Business Analyst hiểu đúng vai trò của các nhà phân tích nghiệp vụ phần mềm, định hình những nấc thang sự nghiệp một cách thật vững chắc, sẵn sàng theo đuổi những giá trị hoàn mỹ trong tương lai.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003c/article\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/40/43/06/939ddce11ae784181296dfb2978fdce5.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/40/43/06/939ddce11ae784181296dfb2978fdce5.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/40/43/06/939ddce11ae784181296dfb2978fdce5.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/40/43/06/939ddce11ae784181296dfb2978fdce5.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/40/43/06/939ddce11ae784181296dfb2978fdce5.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/1c/ca/7e/b95245ab283547a44cdb0e80262bc412.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/1c/ca/7e/b95245ab283547a44cdb0e80262bc412.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/1c/ca/7e/b95245ab283547a44cdb0e80262bc412.jpg","positio