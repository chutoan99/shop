eship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":130000,"discount_rate":14,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/6a/6b/a8/d9fda3cad07eb326777bf8ff223f63cf.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":506,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2 style=\"text-align:center;\"\u003eGiường gấp đôi không đệm NIKITA, Gọn nhẹ chắc chắn, \u003cbr /\u003egiá rẻ cho người dùng\u003c/h2\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eHiện nay không gian sống càng ngày càng thu hẹp, vì vậy mọi người đang tìm kiếm các biện pháp tiết kiệm không gian, đặc biệt là các sản phẩm nội thất, gập gọn, thông minh. Để đón đầu xu hướng NIKITA luôn đi theo các sản phẩm nội thất gấp gọn, từ giường, ghế, thang. NIKITA vừa nhập sản phẩm mới muốn được giới thiệu đến quý khách hàng là giường gấp đôi không đệm, thông minh.\u003c/p\u003e\n\u003cp\u003eĐặc điểm nổi bật:\u003cbr /\u003e● Gọn nhẹ: Giường có trọng lượng nhẹ từ 8-10kg, khi gấp gọn có kích thước rất nhỏ giúp người dùng dễ dàng mang cất.\u003cbr /\u003e● Chắc chắn: Tuy có trọng lượng nhẹ, Nhưng vì là giường đơn giãn nên ít chi tiết, điều đó đảm bảo được phần khung sắt vẫn đủ độ dày để giường chịu được tải 150kg\u003cbr /\u003e● Thiết kế đẹp: Giường có thiết kế tối giãn, nhưng tinh tế có thể đặt phù hợp với mọi không gian từ đơn giãn đến sang trọng.\u003cbr /\u003e● Thương hiệu Uy tín: Là sản phẩm của thương hiệu NIKITA thương hiệu đã hoạt động ở thị trường Việt Nam hơn 20 năm, Được người dùng đánh giá cao ở chất lượng sản phẩm, và uy tín ở khâu hậu mãi\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003c