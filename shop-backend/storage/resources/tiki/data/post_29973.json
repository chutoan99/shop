ue,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":44000,"discount_rate":13,"rating_average":4.5,"review_count":4,"review_text":"(4)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/92/a6/25/fa29ddc9da7aba1d58b674df296ededc.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":603,"all_time_quantity_sold":27,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp class=\"irIKAp\"\u003eThông số kĩ thuật quạt kẹp bàn CRF0705:\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Công suất 5W\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Pin lithium-ion 3.7V 1800mAh\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Điện áp 5V DC\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Kích thước lồng quạt: 12.7 cm\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- 3 tốc độ\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Thời gian sạc: 6-8h\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Thời gian hoạt động: cao 1.5h, thấp 4h\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Cân nặng: 300g\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Kích thước: 153x113x200 mm\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Tặng kèm cáp Micro USB\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cstrong\u003eQuạt kẹp xe đẩy thiết kế nhỏ gọn, hiện đại\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eQuạt Sạc Comet CRF0705 có thiết kế nhỏ gọn, đẹp mắt, có thể mang theo mọi lúc mọi nơi. Sản phẩm thích hợp cho nhiều đối tượng sử dụng khác nhau: nhân viên văn phòng, các bạn sinh viên, Có thể đặt trên bàn, hoặc sử dụng chế độ kẹp ở mọi nơi bạn muốn sử dụng, rất tiện dụng. Giá nâng quạt và thân quạt đều có khả năng xoay 360 độ, điều chỉnh hướng gió mọi góc độ\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/e1/9c/64/7b7da7409bb70affb83b75d0c54e896e.jpg\" alt=\"Quạt Sạc Tích Điện Mini Kẹp Bàn Comet CRF0705 5W Đế Kẹp Xe Đẩy Hoặc Để Bàn Xoay 360 Độ\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cstrong\u003eQuạt Cổng sạc bằng đầu USB tiện dụng\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eQuạt sạc Comet có cổng sạc bằng đầu USB, dễ dàng sạc lại cho quạt bằng cách cắm trực tiếp cổng sạc USB vào máy tính. Bạn có thể sạc pin cho quạt bằng cục sạc dự phòng của điện thoại ngay khi đi du lịch hoặc sạc cho quạt trực tiếp bằng điện.\u003c/p\u003e\n\u003cp class=\"irIKAp\" style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/a3/0e/9c/3c7ac0f0f42d0837f2c0940eda2fbba6.jpg\" alt=\"Quạt Sạc Tích Điện Mini Kẹp Bàn Comet CRF0705 5W Đế Kẹp Xe Đẩy Hoặc Để Bàn Xoay 360 Độ\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\" style=\"text-align:center;\"\u003eQuạt văn phòng CRF0705 có dung lượng pin lên đến 1800mAh\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eVới Pin lithium-ion 3.7V 1800mAh, quạt có thể đáp ứng nhu cầu liên tục 4 giờ ở mức thấp, 2,5 giờ ở mức trung bình và 1,5 giờ sử dụng ở tốc độ cao nhất. Đèn báo sạc: CÓ (đèn báo sạc sẽ sáng khi quạt hoat động hoặc khi cắm sạc. Trong 02 trường hợp này,đèn luôn sáng)\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cstrong\u003e3 cấp độ gió\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eQuạt sạc đa năng có 03 cấp độ gió giúp bạn chủ động được tốc độ gió khi cần sử dụng: nhẹ dịu hoặc gió mạnh. Sản phẩm được làm bằng chất liệu nhựa ABS cao cấp, có độ bền cao và sử dụng mô tơ không chổi than yên tĩnh, không nóng máy, đảm bảo an toàn cho người dùng.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eXin vui lòng LƯU Ý KỸ nguyên lý kỹ thuật của quạt sạc tích điện sử dụng pin sạc:\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003ePin sạc trong sản phẩm sẽ HỎNG, hoặc không còn lưu điện tốt, NẾU sản phẩm không được sạc điện trong suốt thời gian 02 tháng (trường hợp sản phẩm còn mới 100%, chưa sử dụng, cũng phải được cắm điện sạc lại Pin định kỳ 2 tháng/ 1 lần để bảo vệ pin sạc)\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eVui lòng nhớ cắm điện sạc lại pin cho sản phẩm ít nhất 2 tháng/ một lần để bảo vệ pin sạc.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eKhông sử dụng sản phẩm khi đang cắm sạc để bảo vệ pin sạc\u003c/p\u003e\n\u003cp class=\"irIKAp\" style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/33/88/f8/5bf225fda16cafcfd49edab4904766e2.jpg\" alt=\"Quạt Sạc Comet CRF0705 (5W)\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/92/a6/25/fa29ddc9da7aba1d58b674df296ededc.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/92/a6/25/fa29ddc9da7aba1d58b674df296ededc.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/92/a6/25/fa29ddc9da7aba1d58b674df296ededc.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/92/a6/25/fa29ddc9da7aba1d58b674df296ededc.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/92/a6/25/fa29ddc9da7aba1d58b674df296ededc.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/40/3f/05/98b9ba255774c44766184060964e5f0a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/40/3f/05/98b9ba255774c44766184060964e5f0a.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/40/