9,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":13350,"discount_rate":15,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/05/5f/bc/2a1ae83951f0c27d2fbe03cce70ffebc.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":19,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cul\u003e\n\u003cli\u003eTác giả: Iro Kusunoki\u003c/li\u003e\n\u003cli\u003eDịch giả: Phong Linh\u003c/li\u003e\n\u003cli\u003eThể loại: Truyện tranh BL\u003c/li\u003e\n\u003cli\u003eKhổ sách: 13x18cm\u003c/li\u003e\n\u003cli\u003eSố trang: 156 trang\u003c/li\u003e\n\u003cli\u003eISBN: 978-604-40-1319-0\u003c/li\u003e\n\u003cli\u003eNXB liên kết: NXB Dân Trí\u003c/li\u003e\n\u003cli\u003eQuà tặng kèm: Sách được in trên chất liệu giấy BB100, là loại giấy chuyên dụng chất lượng cao dành cho truyện tranh. Sách chỉ có một bản gồm 01 postcard hai mặt 10x15cm, 01 standee giấy bế hình, và 01 clearcard 9x12cm (dành cho bản in đầu).\u003c/li\u003e\n\u003cli\u003ePhát hành: 10/09/2024\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch2\u003eRắc Rối Tình Yêu Mùa Hoa Nở\u003c/h2\u003e\n\u003cp\u003eHồi cấp hai, cậu bé Ota đã tiết lộ cho Tomoaki, người bạn thân nhất của mình, về việc cậu buộc phải chuyển trường. Thế nhưng, những gì cậu nhận được lại chỉ là lời hồi đáp “Biết làm sao được” đầy lạnh nhạt, thay vì những lời nuối tiếc từ bạn mình. Cảm thấy bị tổn thương nặng nề, Ota đã lặng lẽ rời đi mà không hề tạm biệt.\u003c/p\u003e\n\u003cp\u003eThời gian thấm thoắt trôi, Ota giờ đã trở thành một sinh viên đại học và quyết tâm tự mình tận hưởng chương mới của cuộc đời. Trớ trêu thay, ngay tại trường học, cậu đã vô tình tái ngộ với Tomoaki - người mà cậu không hề muốn gặp lại. Dù cảm thấy khó xử và luôn cố gắng giữ khoảng cách, thế nhưng hết lần này đến lần khác người bạn thân năm xưa ấy vẫn tìm cách bắt chuyện…\u003c/p\u003e\n\u003cp\u003e#amak #manga #bl #hana_saku_bokura_no_koi_wazurai #rắc_rối_tình_yêu_mùa_hoa_nở \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/05/5f/bc/2a1ae83951f0c27d2fbe03cce70ffebc.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/05/5f/bc/2a1ae83951f0c27d2fbe03cce70ffebc.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/05/5f/bc/2a1ae83951f0c27d2fbe03cce70ffebc.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/05/5f/bc/2a1ae83951f0c27d2fbe03cce70ffebc.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/05/5f/bc/2a1ae83951f0c27d2fbe03cce70ffebc.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/1c/21/c6/c34589ba9806d4173e4639e1372bcb7a.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/1c/21/c6/c34589ba9806d4173e4639e1372bcb7a.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/1c/21/c6/c34589ba9806d4173e4639e1372bcb7a.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1c/21/c6/c34589ba9806d4173e4639e1372bcb7a.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1c/21/c6/c34589ba9806d4173e4639e1372bcb7a.png"},{"base_url"