plitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":2.5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/3f/59/f7/7144caa031c77be842bc3ba324636f95.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1734,"all_time_quantity_sold":6,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/aa/80/c6/b04314e058dc9fc7143b1f08af553529.jpg\" alt=\"weilaiya1\" width=\"750\" height=\"2554\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/6b/d9/1b/cad20beff4b2304270743b9f7938e04b.jpg\" alt=\"Weilaiya\" width=\"750\" height=\"2556\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/c0/50/5f/b2b4973cc9a286a4b2da522929be66ea.undefined\" alt=\"\" width=\"750\" height=\"0\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/7d/34/44/cf56009f7a69fd4fb74f19c9f3895f0b.jpg\" alt=\"\" width=\"750\" height=\"2334\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e \u003c/p\u003e\n\u003cp\u003eNếu sau tuổi 25, mà bạn không quan tâm thực sự tới các loại dầu gội tốt cho da đầu và bạn cũng không cân nhắc kĩ càng tới các dịch vụ hoá chất: uốn, ép nhuộm tại những cơ sở có không uy tín làm tác động tới da đầu bạn. Thì bạn sẽ giật mình vì tóc càng ngày càng mỏng không thể cứu vãn nổi.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003ciframe src=\"//www.youtube.com/embed/B53ViY47pgE\" width=\"560\" height=\"314\" allowfullscreen=\"allowfullscreen\"\u003e\u003c/iframe\u003e\u003c/p\u003e\n\u003cp\u003eMột loại dầu gội tốt thực sự, loại dầu gội và xả lấy sức khoẻ da đầu làm tiêu chuẩn số 1, với thành phần từ thiên nhiên sẽ giúp bạn! \u003cstrong\u003eDầu xả dưỡng tóc Weilaiya\u003c/strong\u003e có nguồn gốc tự nhiên, không hoá chất kích mọc tóc mà nó hoạt động bằng cách kích thích da đầu, làm tăng cường lượng máu lưu thông đến chân tóc giúp cho tóc mọc nhanh và dày hơn. Khi gội cảm thấy da đầu nóng ấm bởi tinh chất gừng thúc đẩy thông huyết lên não, sạch gầu, giảm rụng tóc, ngứa da đầu. Gừng và dầu trà sẽ làm sạch dầu trên tóc, một phần nguyên nhân gây ngứa rụng và hôi tóc.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eDầu xả dưỡng tóc Weilaiya phiên bản mới có gì khác biệt?\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003eMột phiên bản nâng cấp sâu, hướng đến sự hài lòng từ khách hàng: Mọc tóc hiệu quả hơn - Thơm hơn - Mềm tóc hơn. Với chiết xuất chính từ tinh dầu gừng quện với nước gừng nấu, hỗn hợp gừng nấu tác động cực hiệu quả tới “hệ sinh thái da đầu” : dầu giảm, chân tóc được làm sạch, cân bằng lại da đầu nuôi dưỡng da đầu và chân tóc đồng thời thúc đẩy sự phát triển của tóc. Tính nóng của gừng kích thích các nang tóc phát triển, tăng cường lưu thông máu tới da đầu, giúp tóc mau dài. Ngoài ra, trong gừng có chất chống oxy hoá, chống nấm có lợi cho tóc, giúp tóc chắc khỏe.\u003c/p\u003e\n\u003cp\u003eSo với phiên bản cũ, phiên bản mới ngoài 70% từ nước gừng, được bổ sung thêm 10% tinh dầu gừng già củ nên đẩy mạnh hiệu quả mọc tóc, nhanh dài và tác động mạnh hơn nữa đến chân nang tóc. Dầu xả bên cạnh dầu dừa làm mềm tóc nay được đưa thêm tinh dầu hoa trà, đem đến 1 cảm giác tột cùng của sự tròn đầy hương thơm tao nhã, ngất ngây. Tinh dầu hoa trà một lần nữa làm cho mái tóc mềm hơn, không bị khô tóc như phiên bản cũ.\u003c/p\u003e\n\u003cp\u003e\u003cem\u003edầu gội cặp Weilaiya thảo dược\u003c/em\u003e mới vẫn giữ nguyên trọn vẹn cam kết là dòng sản phẩm chăm sóc Tóc thành phần không chứa Sulfate (SLES), Silicone \u0026amp; Phthalate.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eDầu xả dưỡng tóc Weilaiya có thật sự đẳng cấp?\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cem\u003eDầu xả dưỡng tóc WEILAIYA\u003c/em\u003e\u003c/strong\u003e được nghiên cứu bởi các chuyên gia đầu ngành tại các trường đại học y khoa nổi tiếng trong nước, kết hợp với phòng nghiên cứu của Đức.\u003c/p\u003e\n\u003cp\u003eKết hợp với thiết bị sản xuất tiên tiến, với hệ thống quản lý sản xuất hiện đại. Sử dụng 32 công cụ, kết hợp với 1032 ngày nghiên cứu . Tổng hợp 2500 người thử nghiệm để đưa ra kết quả. \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eWEILAIYA\u003c/strong\u003e có hiệu quả trong việc làm sạch gầu và dầu, giữ cân bằng lượng nước trong tóc, kết hợp với vitamin E có công hiệu chắc khỏe ngọn tóc, cân bằng lượng dầu sinh thái, giúp tóc đen và dày hơn. \u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eDầu  xả dưỡng tóc weilaiya giúp được các vấn đề nào của tóc?\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003ea, Tóc khô chẻ ngọn, xơ rối\u003cbr /\u003eb, Tóc gầu, bóng dầu\u003cbr /\u003ec, Rụng tóc từ nhẹ đến nghiêm trọng, cần mọc tóc.\u003cbr /\u003ed, Không bóng mượt.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eDầu xả dưỡng tóc weilaiya\u003c/strong\u003e giúp điều chỉnh cân bằng nồng độ PH, nuôi dưỡng tóc và da đầu, giúp giải quyết nhanh các vấn đề về tóc.\u003cbr /\u003ea. Làm sạch da đầu cực kỳ hiệu quả\u003cbr /\u003eb. Thâm nhập tinh chất dưỡng tóc thực sự từ bên trong, nuôi dưỡng da đầu\u003cbr /\u003ed. Cân bằng điều chỉnh nồng độ PH trên da đầu\u003cbr /\u003ee. Thúc đẩy mọc tóc sau thời gian ngắn sử dụng.\u003cbr /\u003ef. Làm mềm mịn tóc, tóc trở nên suôn mượt óng ả.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/3f/59/f7/7144caa031c77be842bc3ba324636f95.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/3f/59/f7/7144caa031c77be842bc3ba324636f95.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/3f/59/f7/7144caa031c77be842bc3ba324636f95.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3f/59/f7/7144caa031c77be842bc3ba324636f95.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3f/59/f7/7144caa031c77be842bc3ba324636f95.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/48/fc/29/69d995b2f8a178e322ad7428e2e3266e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/48/fc/29/69d995b2f8a178e322ad7428e2e3266e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/48/fc/29/69d995b2f8a178e322ad7428e2e3266e.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/48/fc/29/69d995b2f8a178e322ad7428e2e3266e.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/48/fc/29/69d995b2f8a178e322ad7428e2e3266e.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/4b/96/98/3a45ed7970f688c5e08f1288b3cc1d9f.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/4b/96/98/3a45ed7970f688c5e08f1288b3cc1d9f.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/4b/96/98/3a45ed7970f688c5e08f1288b3cc1d9f.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4b/96/98/3a45ed7970f688c5e08f1288b3cc1d9f.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4b/96/98/3a45ed7970f688c5e08f1288b3cc1d9f.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/bc/ef/fc/