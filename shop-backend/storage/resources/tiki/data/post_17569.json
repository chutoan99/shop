olor":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/5e/78/72/2a44e75c3eb7c380c612cd74d160d5b4.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":995,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2 style=\"text-align: center;\"\u003e\u003cstrong\u003eTAI NGHE TRUE WIRELESS SIÊU NHỎ EARFUN FREE MINI\u003c/strong\u003e\u003c/h2\u003e\n\u003cdiv style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/f3/fa/a8/9fcb7f856ec120f399c31796e8da1b57.jpg\" alt=\"\" width=\"750\" height=\"463\" /\u003e\u003c/div\u003e\n\u003ch3\u003e \u003c/h3\u003e\n\u003ch3\u003e\u003cstrong\u003e\u003cem\u003eThiết kế siêu nhỏ, khả năng kháng nước IPX7\u003c/em\u003e\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eBên cạnh sản phẩm Free Pro 2 cao cấp nhất của dòng Free, EarFun cũng bổ sung thêm một phiên bản ở phân khúc bình dân dưới 1 triệu Đồng là Free Mini. Cặp tai nghe này đúng như cái tên đã gợi ý, được thiết kế để hướng đến sự gọn nhẹ nhất có thể ở cả hộp sạc lẫn tai nghe, tạo cảm giác gọn gàng khi đem đi và thoải mái khi sử dụng.\u003c/p\u003e\n\u003cp\u003eTai nghe được trang bị khả năng kháng nước cao tới IPX7, cho phép người dùng thưởng thức nhạc khi đi chạy, tập gym, tránh những tai nạn với nước không đáng có và thậm chí đem tai nghe đi tắm hoặc sử dụng khi đi bơi.\u003c/p\u003e\n\u003ch3 style=\"text-align: center;\"\u003e\u003cem\u003e\u003cstrong\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ee/0c/c2/6eb74f2c8e4b52f131b8d05594dcf99c.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/strong\u003e\u003c/em\u003e\u003c/h3\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch3\u003e\u003cem\u003e\u003cstrong\u003eMàng loa Composite 6mm, Bluetooth 5.0 ổn định cao\u003c/strong\u003e\u003c/em\u003e\u003c/h3\u003e\n\u003cp\u003eViệc thu nhận tín hiệu được đảm nhiệm bởi chip PixArt PAU1603 Bluetooth 5.0 với công nghệ GreenRadio Stereo độc quyền, tăng tính ổn định cũng như giảm độ trễ với nguồn phát để bạn thoải mái nghe nhạc, xem phim và chơi game. Màng loa thuộc dạng Dynamic composite 6mm đã được EarFun sử dụng ở nhiều sản phẩm của mình, cho chất âm cứng cáp, rõ ràng và ít bị méo.\u003c/p\u003e\n\u003ch3 style=\"text-align: center;\"\u003e\u003cem\u003e\u003cstrong\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/db/7a/cc/35a629294d11d97009bd7d5e36a07b61.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/strong\u003e\u003c/em\u003e\u003c/h3\u003e\n\u003ch3\u003e \u003c/h3\u003e\n\u003ch3\u003e\u003cem\u003e\u003cstrong\u003eĐiều khiển cảm ứng\u003c/strong\u003e\u003c/em\u003e\u003c/h3\u003e\n\u003cp\u003eMặt ngoài của tai nghe là mặt cảm ứng cho phép bạn điều khiển những thao tác cơ bản mà không cần phải lấy smartphone ra khỏi túi: điều khiển bài nhạc, nhận hoặc từ chối cuộc gọi, điều chỉnh âm lượng và gọi trợ lý ảo Google Assistant hoặc Siri.\u003c/p\u003e\n\u003cdiv id=\"protab1\" class=\"pro-tabcontent\"\u003e\n\u003cdiv\u003e\n\u003ch3 style=\"text-align: center;\"\u003e\u003cem\u003e\u003cstrong\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/25/da/61/eb8f46679bbfbcd7a93df5b94963d079.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/strong\u003e\u003c/em\u003e\u003c/h3\u003e\n\u003ch3\u003e \u003c/h3\u003e\n\u003ch3\u003e\u003cem\u003e\u003cstrong\u003eThời lượng sử dụng 24 tiếng\u003c/strong\u003e\u003c/em\u003e\u003c/h3\u003e\n\u003cp\u003eDù có kích thước nhỏ nhưng Free Mini vẫn có thời lượng sử dụng cao. Tai nghe có thể chơi nhạc được liên tục trong 5 tiếng, và khi kết hợp với hộp sạc thì sẽ tăng thời lượng này lên 24 tiếng.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv id=\"protab2\" class=\"pro-tabcontent\"\u003e\n\u003cdiv class=\"tab-title\"\u003e\u003cstrong\u003eTHÔNG SỐ KỸ THUẬT:\u003c/strong\u003e\u003c/div\u003e\n\u003cdiv class=\"tab-content\"\u003e\n\u003cul\u003e\n\u003cli\u003eMàng loa Composite 6mm\u003c/li\u003e\n\u003cli\u003eChip PixArt PAU1603 với Bluetooth 5.0\u003c/li\u003e\n\u003cli\u003eThời lượng sử dụng độc lập: 5 tiếng\u003c/li\u003e\n\u003cli\u003eThời lượng sử dụng tổng cộng: 24 tiếng\u003c/li\u003e\n\u003cli\u003eKháng nước chuẩn cao IPX7\u003c/li\u003e\n\u003cli\u003eKích thước: 55 x 26 x 43mm\u003c/li\u003e\n\u003cli\u003eTrọng lượng: 38g\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/5e/78/72/2a44e75c3eb7c380c612cd74d160d5b4.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/5e/78/72/2a44e75c3eb7c380c612cd74d160d5b4.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/5e/78/72/2a44e75c3eb7c380c612cd74d160d5b4.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5e/78/72/2a44e75c3eb7c380c612cd74d160d5b4.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5e/78/72/2a44e75c3eb7c380c612cd74d160d5b4.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/1b/65/5e/7ac5feeb6a7334cb63aeedcbd41777d4.jpg","is_gallery":true,"label":null,"lar