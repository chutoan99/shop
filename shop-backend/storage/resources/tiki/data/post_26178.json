unt":345000,"discount_rate":50,"rating_average":5,"review_count":11,"review_text":"(11)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/95/7a/da/f9c6651f241b4be7e063adce84d35dc9.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1027,"all_time_quantity_sold":23,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch1 dir=\"ltr\" style=\"text-align: center;\"\u003e\u003cstrong\u003e SẠC NHANH THẾ HỆ MỚI - SẠC MOPHIE PD 30W GaN\u003c/strong\u003e\u003c/h1\u003e\n\u003cp dir=\"ltr\"\u003eMophie là thương hiệu phụ kiện di động uy tín hàng đầu thế giới đến từ Mỹ, được cấp phép và bán toàn khắp các Apple Store toàn cầu. Điểm khác biệt tạo nên thương hiệu của Mophie đó là các sản phẩm pin, cáp sạc của hãng đều chỉ dành riêng cho tín đồ nhà Apple.\u003c/p\u003e\n\u003cp dir=\"ltr\"\u003eiPhone 13 Series ra mắt với tốc độ sạc có thể đạt tới 27W trên iPhone 13 Pro Max, vậy nên, Mophie cho ra mắt Phụ kiện Sạc nhanh Mophie PD 30W GaN giúp điện thoại chạm đỉnh công suất sạc, rút ngắn thời gian sạc, đảm bảo an toàn cho máy, chính sách bảo hành tối ưu lên tới 2 năm 1 đổi 1 giúp các fans nhà Táo an tâm trải nghiệm.\u003c/p\u003e\n\u003cp dir=\"ltr\"\u003eCùng tìm hiểu chi tiết về Sạc nhanh Mophie Power Delivery 30W GaN.\u003c/p\u003e\n\u003cp dir=\"ltr\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/c8/8a/a5/aefe2ec05b12ce802ab13d6c32ac3a3d.png\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp dir=\"ltr\" style=\"text-align: center;\"\u003e\u003cem\u003eSạc nhanh Mophie Power Delivery 30W Type C GaN\u003c/em\u003e\u003c/p\u003e\n\u003cp dir=\"ltr\"\u003e\u003cstrong\u003eThiết kế gọn nhẹ, hoàn thiện chắc chắn\u003c/strong\u003e\u003c/p\u003e\n\u003cp dir=\"ltr\"\u003eMột điểm khác biệt có trên Sạc nhanh Mophie PD 30W đó là sản phẩm được ứng dụng thêm Vật liệu tiên tiến mới thay cho silicon: GaN (Gallium nitride). Vật liệu GaN không chỉ giúp thu nhỏ kích thước sạc mà còn làm giảm hao hụt năng lượng, tỏa nhiệt ít hơn, duy trì được công suất sạc tối ưu cho thiết bị.\u003c/p\u003e\n\u003cp dir=\"ltr\"\u003eSạc nhanh Mophie Power Delivery 30W GaN được thiết kế bo tròn 4 góc đẹp mắt, cầm chắc tay, kích thước nhỏ gọn, siêu nhẹ giúp bạn dễ dàng mang theo bên mình. \u003c/p\u003e\n\u003cp dir=\"ltr\"\u003eThân sạc được phủ bởi một lớp chất liệu nhựa cao cấp mang đến vẻ ngoài hiện đại, sang trọng. Các thông số kỹ thuật, Serial Number được thể hiện đầy đủ, rõ ràng trên sản phẩm.\u003c/p\u003e\n\u003cp dir=\"ltr\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/17/18/78/b9fb764ecc05c12c5c48355c62b5356e.png\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp dir=\"ltr\" style=\"text-align: center;\"\u003e\u003cem\u003eThiết kế gọn nhẹ, hoàn tiện tốt nhờ ứng dụng vật liệu mới GaN\u003c/em\u003e\u003c/p\u003e\n\u003cp dir=\"ltr\"\u003e \u003c/p\u003e\n\u003cp dir=\"ltr\"\u003e\u003cstrong\u003eHỗ trợ sạc nhanh Power Delivery cho công suất lên tới 30W\u003c/strong\u003e\u003c/p\u003e\n\u003cp dir=\"ltr\"\u003eSạc nhanh Mophie Power Delivery 30W GaN tích hợp 1 cổng USB Type C hỗ trợ sạc nhanh chuẩn Power Delivery cho công suất lên tới 30W, đi kèm theo là 3 Profile sạc nhanh: 5V - 2.4A ; 9V - 3A ; 15V - 2A ; 20V - 1.5A. Với cổng chuẩn sạc nhanh này, Sạc nhanh Mophie Power Delivery 30W khi đi kèm với cáp USB-C to L Mophie đạt chuẩn MFi của Apple sẽ giúp sạc nhanh tối đa cho các dòng iPhone 12, 13 cũng như sạc nhanh cho các iPhone hay iPad khác, rút ngắn thời gian sạc cho thiết bị một cách nhanh chóng.\u003c/p\u003e\n\u003cp dir=\"ltr\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/38/c0/4a/f58cca7417953cb2f3aa1026e528074d.png\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp dir=\"ltr\" style=\"text-align: center;\"\u003e\u003cem\u003eHỗ trợ sạc nhanh Power Delivery công suất lên tới 30W qua cổng Type C\u003c/em\u003e\u003c/p\u003e\n\u003cp dir=\"ltr\"\u003e\u003cstrong\u003eKhả năng tương thích cao với nhiều thiết bị\u003c/strong\u003e\u003c/p\u003e\n\u003cp dir=\"ltr\"\u003eSạc nhanh Mophie Power Delivery 30W GaN cung cấp tốc độ sạc nhanh tối đa khi đi kèm với cáp sạc chất lượng, đạt chuẩn MFi của Apple, hỗ trợ sạc nhanh chuẩn PD.\u003c/p\u003e\n\u003cp dir=\"ltr\"\u003eSản phẩm hoạt động hiệu quả cho tất cả các dòng từ iPhone 8 đến iPhone 13 Series, iPad và các thiết bị hỗ trợ sạc nhanh PD khác. \u003c/p\u003e\n\u003cp dir=\"ltr\"\u003eNgoài ra, bạn hoàn toàn có thể sử dụng sản phẩm để sạc nhanh cho các thiết bị khác khi kết nối với cáp sạc cổng USB-Type C hỗ trợ sạc nhanh.\u003c/p\u003e\n\u003cp dir=\"ltr\"\u003e \u003c/p\u003e\n\u003cp dir=\"ltr\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/95/7a/da/3cb81835003e8f605691b4e96bb1dd73.png\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp dir=\"ltr\" style=\"text-align: center;\"\u003e\u003cem\u003eSạc nhanh tương thích với nhiều thiết bị\u003c/em\u003e\u003c/p\u003e\n\u003cp dir=\"ltr\"\u003e\u003cstrong\u003eĐảm bảo an toàn cho bạn và thiết bị\u003c/strong\u003e\u003c/p\u003e\n\u003cp dir=\"ltr\"\u003eSạc nhanh Mophie Power Delivery 30W GaN đáp ứng đầy đủ các quy định khắt khe của Châu  Âu về chất lượng, đảm bảo an toàn tuyệt đối cho bạn và thiết bị trong quá trình sử dụng.\u003c/p\u003e\n\u003cp dir=\"ltr\"\u003e \u003c/p\u003e\n\u003cp dir=\"ltr\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/