,"discount":20300,"discount_rate":10,"rating_average":5,"review_count":35,"review_text":"(35)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/3f/1f/4d/971926f9e87e43e500ba7e701b27507c.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1243,"all_time_quantity_sold":298,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003eĐẶC ĐIỂM NỔI BẬT CỦA SẢN PHẨM\u003c/strong\u003e\u003c/p\u003e\n\u003cul style=\"text-align:justify;\"\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eBột tía tô Quảng Thanh \u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003eđược dùng thay thế cho rau tía tô tươi. Bột vừa có thể dùng để pha uống như nước giải khát, vừa bổ sung vào cháo/súp/bột ăn dặm rất tiện dụng.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eThành phần từ rau tía tô tươi từ vùng nguyên liệu sạch, đảm bảo chất lượng. Kết hợp cùng với quy trình sấy lạnh tiệt trùng và nghiền bằng cối đá Granite, nhằm tạo ra sản phẩm giữ được hương vị đặc trưng mà không hề làm mất đi dinh dưỡng so với việc sử dụng công nghệ sấy truyền thống.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eBột tía tô Quảng Thanh\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e không chứa chất bảo quản, không pha trộn thêm bất kỳ thành phần phụ gia hóa học nào, đảm bảo an toàn tuyệt đối sức khỏe của người dùng.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/3f/1f/4d/18abbc694cea340d81fc51f7956dd3e8.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cem\u003e\u003cspan style=\"font-weight:400;\"\u003eBột tía tô Quảng Thanh hỗ trợ gout, cảm cúm, bổ phổi phế\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003eCÔNG DỤNG CỦA SẢN PHẨM\u003c/strong\u003e\u003c/p\u003e\n\u003cul style=\"text-align:justify;\"\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eAn thai\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eBổ phổi phế\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eHỗ trợ cảm, ho\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eHỗ trợ gout\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eHạn chế mụn trứng cá, cân bằng độ ẩm cho da khô và dầu\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eNgoài ra còn dùng làm nguyên liệu pha chế dược liệu và nguyên liệu mỹ phẩm vì bột tía tô hoàn toàn tự nhiên.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align:center;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003eTHÔNG TIN CHUNG\u003c/strong\u003e\u003c/p\u003e\n\u003cul style=\"text-align:justify;\"\u003e\n\u003cli style=\"font-weight:400;\"\u003e \u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003eCÁCH DÙNG\u003c/strong\u003e\u003c/p\u003e\n\u003cul style=\"text-align:justify;\"\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eGiải khát và tăng sức đề kháng: Sử dụng khoảng 3 - 5gr bột Tía Tô Quảng Thanh\u003c/span\u003e\u003cspan style=\"font-weight:400;\"\u003e pha với 300 - 500ml nước lọc cho mỗi lần uống (1 – 2 lần/ ngày) . Có thể kết hợp thêm với chanh/tắc/hạnh/quất để kích thích vị giác vừa giúp hấp thụ dưỡng chất có trong rau nhanh hơn vừa tăng sức đề kháng.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eCông thức làm đẹp với bột Tía Tô: tía tô là thần dược trong việc trị mụn, giúp sáng da và hỗ trợ trị thâm nám của chị em phụ nữ. Để có được làn da căng mịn, tràn sức sống, hãy áp dụng ngay công thức: bột tía tô trộn với nước tinh khiết tỉ lệ 1:3 (có thể thay nước bằng sữa tươi hoặc sữa chua không đường để vừa trị mụn vừa dưỡng trắng), đắp hỗn hợp này lên da trong 15-20 phút, duy trì 2 lần/tuần.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eThêm vào cháo súp em bé\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cem\u003e\u003cspan style=\"font-weight:400;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/1d/c3/c1/510b4e0be0287ee51e417dee2bd3962a.jpg\" alt=\"Bột tía tô Quảng Thanh\" width=\"750\" height=\"750\" /\u003e\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cem\u003e\u003cspan style=\"font-weight:400;\"\u003eBột Tía Tô Quảng Thanh tăng cường sức đề kháng\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003eBẢO QUẢN\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli style=\"font-weight:400;text-align:justify;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eNơi khô thoáng, tránh tác động của ánh sáng và nhiệt. Tốt nhất nên bảo quản trong ngăn mát tủ lạnh. \u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;text-align:justify;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eKhóa kín miệng túi sau khi sử dụng. Không nên sang chiết sản phẩm sang hũ nhựa hay lọ thủy tinh để giúp bột không bị biến chất, đảm bảo chất lượng tốt nhất với thời hạn sử dụng được lâu.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/3f/1f/4d/971926f9e87e43e500ba7e701b27507c.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/3f/1f/4d/971926f9e87e43e500ba7e701b27507c.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/3f/1f/4d/971926f9e87e43e500ba7e701b27507c.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3f/1f/4d/971926f9e87e43e500ba7e701b27507c.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3f/1f/4d/971926f9e87e43e500ba7e701b27507c.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/89/8c/3a/65849ff1c4c5c792da9be32cf42bfba5.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/89/8c/3a/65849ff1c4c5c792da9be32cf42bfba5.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/89/8c/3a/65849ff1c4c5c792da9be32cf42bfba5.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/89/8c/3a/65849ff1c4c5c792da9be32cf42bfba5.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/89/8c/3a/65849ff1c4c5c792da9be32cf42bfba5.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/7c/92/1c/f27ff25360dd5e4df51560cffc9ceac7.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/7c/92/1c/f27ff25360dd5e4df51560cffc9ceac7.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/7c/92/1c/f27ff25360dd5e4df51560cffc9ceac7.jpg","position":null,"small_url":