t_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.8,"review_count":82,"review_text":"(82)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/53/10/9f/22b875b49722429a3e4a67884b788dfc.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1923,"all_time_quantity_sold":271,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch4 class=\"BlockTitle__Wrapper-sc-qpz3fo-0 eHltcn\"\u003eMô Tả Sản Phẩm\u003c/h4\u003e\n\u003cdiv class=\"content\"\u003e\n\u003cdiv class=\"ToggleContent__Wrapper-sc-1dbmfaw-1 cqXrJr\"\u003e\n\u003cdiv class=\"ToggleContent__View-sc-1dbmfaw-0 jpFMBi\"\u003e\n\u003cdiv\u003eThông tin sản phẩm: Thiết kế hiện đại, tháo lắp dễ dàng\u003c/div\u003e\n\u003cdiv\u003eKết cấu chắc chắn, chịu lực tốt Dễ dàng tùy biến cho nhiều không gian\u003c/div\u003e\n\u003cdiv\u003e\u003cstrong\u003eKích thước:\u003c/strong\u003e455 x 260 x 447 mm\u003c/div\u003e\n\u003cdiv\u003eMàu sắc: Trắng,\u003c/div\u003e\n\u003cdiv\u003eChất liệu: Nhựa nguyên sinh cao cấp\n\u003ch1\u003eKỆ TRƯỢT TOKYO\u003c/h1\u003e\n\u003cp\u003e\u003cem\u003e\u003cstrong\u003e=== CÂU CHUYỆN CỦA SẢN PHẨM ===\u003c/strong\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003eSống tại Tokyo là trải nghiệm nghệ thuật tiết kiệm không gian. Trong những căn hộ bé xinh tại thủ đô đông đúc, người Nhật luôn tìm cách sắp xếp đồ đạc gọn gàng nhất, tiện lợi nhất nhưng vẫn thoáng đạt nhất có thể. Đó chính là cảm hứng cho bộ sưu tập kệ Tokyo của Inochi.\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cstrong\u003e=== NGUỒN GỐC CỦA SẢN PHẨM ===\u003c/strong\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003eInochi là thương hiệu nhựa gia dụng cao cấp Việt Nam được thiết kế và sản xuất theo phong cách và tiêu chuẩn Nhật Bản. Ra mắt năm 2018, các mặt hàng gia dụng cao cấp của Inochi đã sớm gây được ấn tượng khách hàng, bởi sản phẩm sử dụng 100% nguyên liệu nhựa nguyên sinh an toàn, có chất lượng cao, tích hợp các tính năng vượt trội, kháng khuẩn, khử mùi và thiết kế đẹp mắt, tiện lợi, phục vụ tối đa các nhu cầu thiết yếu cùng tiện ích của mọi gia đình.\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/b9/8a/65/d3f4b3abddbc29a0d16293cf1ef6d9f8.jpg\" alt=\"\" width=\"0\" height=\"0\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/60/36/1f/5728feca75ea0c7a2481b6710f29bd97.jpg\" alt=\"\" width=\"720\" height=\"720\" /\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cstrong\u003eNhựa nguyên sinh là gì?\u003c/strong\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003eNhựa nguyên sinh bao gồm một số loại nhựa như PP, PC, ABS, PS-GPPS, HIPS, POM, PA, PMMA… Đây đều là những loại nhựa nguyên chất, không pha tạp, không thêm phụ gia. Nhựa nguyên sinh có đặc tính là mềm dẻo, độ đàn hồi lớn, chịu được cong vênh và áp lực. Đặc biệt không có mùi, không độc hại và không ảnh hưởng đến sức khỏe của người sử dụng. \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/b9/8a/65/b1766b18b6edc8f09812190a1dc9571e.jpg\" alt=\"\" width=\"720\" height=\"720\" /\u003e\u003c/p\u003e\n\u003cp\u003eSản phẩm thiết kế theo phong cách Nhật Bản kiểu dáng đơn giản mà lại rất sang trọng, màu sắc nhã nhặn, các sản phẩm kệ của Inochi công dụng đều rất đa dạng, không chỉ đựng đồ dùng cá nhân, người dùng có thể sử dụng được trong nhiều mục đích khác nhau. \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/04/28/01/7730aa1b94bf775b3c29f79c74628cd4.jpg\" alt=\"\" width=\"720\" height=\"720\" /\u003e\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/53/10/9f/22b875b49722429a3e4a67884b788dfc.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/53/10/9f/22b875b49722429a3e4a67884b788dfc.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/53/10/9f/22b875b49722429a3e4a67884b788dfc.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/53/10/9f/22b875b49722429a3e4a67884b788dfc.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/53/10/9f/22b875b49722429a3e4a67884b788dfc.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/04/28/01/d93d16b13d1480b8c2d5338a21c628c1.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/04/28/01/d93d16b13d1480b8c2d5338a21c628c1.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/04/28/01/d93d16b13d1480b8c2d5338a21c628c1.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/04/28/01/d93d16b13d1480b8c2d5338a21c628c1.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/04/28/01/d93d16b13d1480b8c2d5338a21c628c1.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/60/36/1f/594f7ed5a6f45345321c09f687fee3a7.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/60/36/1f/594f7ed5a6f45345321c09f687fee3a7.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/60/36/1f/594f7ed5a6f45345321c09f687fee3a7.jpg","position":null,"small_url":"https://sa