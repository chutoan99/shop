eight":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/media/catalog/product/1/_/1.u2409.d20170526.t134310.916979.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2669,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003eThông tin sản phẩm:\u003cbr /\u003e\u003c/strong\u003eKích thước 1 ly: 8.5 x 8.5 x 10cm\u003cbr /\u003eTrọng lượng 1 ly: 300g\u003cbr /\u003eKích thước bộ: 26.5 x 17.5 x 11cm\u003cbr /\u003eTrọng lượng bộ: 2kg\u003cstrong\u003e\u003cbr /\u003eBộ 6 Ly Thủy Tinh Naos Acqua Bormioli Rocco 530330G13021990 (295ml) \u003c/strong\u003esản xuất tại Ý được làm từ chất liệu thủy tinh cao cấp sáng bóng đạt chất lượng châu Âu, thiết kế trang nhã với màu sắc tươi sáng sẽ giúp cho căn bếp của bạn thêm sống động.\u003c/li\u003e\n\u003cli\u003eKhông chỉ thu hút bởi kiểu dáng đẹp, sản phẩm ly thủy tinh Naos còn được người tiêu dùng đánh giá cao bởi màu sắc luôn bền đẹp, có giá trị sử dụng lâu dài.\u003c/li\u003e\n\u003cli\u003eThân ly được thiết kế với những đường cách điệu theo phong cách mosaic ấn tượng như được chạm trổ, điêu khác làm ánh xạ màu thức uống cực kỳ đẹp mắt, mang đến sự thích thú cho người dùng, một  lựa chọn hoàn hảo cho những không gian sống hiện đại.\u003c/li\u003e\n\u003cli\u003eĐược làm từ chất liệu thủy tinh tốt, xuất xứ rõ ràng an toàn cho người sử dụng. Với ly thủy tinh, bạn không cần phải lo lắng các chất hóa học có độc sẽ dễ hòa tan trong nước như khi dùng những loại ly thông thường khác (ly nhựa, ly inox, ly giấy).\u003c/li\u003e\n\u003cli\u003eThủy tinh sáng bóng, có độ bền cơ học cao, có thể chịu được nhiệt độ và không bị phai màu hoặc giảm độ trong suốt theo thời gian.\u003c/li\u003e\n\u003cli\u003eVới kích cỡ 295ml có thể dùng làm ly uống rượu, ly uống nước, ly pha café, ly nước trái cây … đều tiện dụng. Ngoài ra, có thể dùng như vật trang trí sang trọng trong không gian phòng khách, phòng bếp nhà bạn.\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e\u003cp\u003eSản phẩm này là tài sản cá nhân được bán bởi Nhà Bán Hàng Cá Nhân và không thuộc đối tượng phải chịu thuế GTGT. Do đó hoá đơn VAT không được cung cấp trong trường hợp này.\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/media/catalog/product/1/_/1.u2409.d20170526.t134310.916979.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/1/_/1.u2409.d20170526.t134310.916979.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/1/_/1.u2409.d20170526.t134310.916979.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/1/_/1.u2409.d20170526.t134310.916979.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/1/_/1.u2409.d20170526.t134310.916979.jpg"},{"base_url":"https://salt.tikicdn.com/media/catalog/product/6/l/6ly.u2409.d20170526.t134310.956306.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/6/l/6ly.u2409.d20170526.t134310.956306.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/p