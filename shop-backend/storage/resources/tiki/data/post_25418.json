on_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":74000,"discount_rate":10,"rating_average":4,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/2e/ea/b5/ba75defbe64b0431757a4f74e775ae1e.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":246,"all_time_quantity_sold":8,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cspan\u003eGiày Thể Thao Nam \u003c/span\u003eBSM000900 sở hữu thiết kế tuy đơn giản nhưng lại rất đặc biệt. Điều này thể hiện qua bảng màu đen, đi nét cam táo báo; cũng như form ôm trọn bàn chân quen thuộc với đầu mũi giày tròn.\u003c/p\u003e\n\u003ch2\u003eĐế giày \u003c/h2\u003e\n\u003cp\u003eNhững đặc điểm nổi trội phải kể đến ở sản phẩm Giày Thể Thao Nam BSM000900 như:\u003c/p\u003e\n\u003ch3\u003eĐế ngoài\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cdiv\u003eĐế ngoài sử dụng chất liệu cao su nhiệt dẻo (TPR, PU) đạt chuẩn chất lượng cao cấp. Qua đó mang lại độ dẻo dai cao nhất, ít bị cong vênh hay biến dạng.\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv\u003eĐế giày thiết kế thêm rãnh chống trượt hình oval, phủ thêm gai nhỏ giúp người mang di chuyển an toàn và hạn chế trơn trượt tối đa. \u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv\u003ePhần đế thiết kế theo form chân người Việt (độ dài - độ rộng phụ thuộc kích cỡ giày), tạo ra cảm giác thoải mái, êm ái nhất khi di chuyển. \u003c/div\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003eĐế trong (lót giày)\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cdiv\u003eBên trong giày được lót miếng đệm EVA 5 phân với nhiều ưu điểm đặc biệt như trọng lượng siêu nhẹ, tính linh hoạt cao, cảm giác êm ái và mềm mại hoàn hảo, khá bền, hỗ trợ giảm sốc và giữ nhiệt khi cần… \u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv\u003eKết hợp cùng lớp lót Phylon rất nhẹ và đàn hồi, cho khả năng chịu tải hiệu quả gấp đôi nhưng giá thành lại tiết kiệm hơn. \u003c/div\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003eĐế giữa\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cdiv\u003eBiti’s liên tục cải tiến chất lượng của phần đế giữa với chất liệu EVA phun, tạo nên cảm giác mang chắc chân, hạn chế đau mỏi. \u003c/div\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch2\u003eThân trên giày \u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cdiv\u003eThân trên ứng dụng công nghệ dệt lưới, bố trí thêm các lỗ thông thoáng khí nhỏ phủ đều khắp bề mặt. Điều này tạo ra cảm giác thông thoáng khí và thoải mái nhất có thể nếu phải mang giày trong thời gian dài.  \u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv\u003eQuai giày làm từ chất liệu si thun nên cực kỳ dẻo dai, bền bỉ.\u003c/div\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch2\u003eMàu sắc\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cdiv\u003eHiện tại, sản phẩm có 3 bảng màu là Đen, Trắng và Xám. \u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv\u003eBởi vì điều kiện ánh sáng khác nhau nên màu sắc thực tế của sản phẩm có thể chênh lệch tầm khoảng 3 - 5%.\u003c/div\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch2\u003eSize giày \u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cdiv\u003eBao gồm 6 kích cỡ cơ bản là 39, 40, 41, 42, 43 và 44.\u003c/div\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch2\u003eĐộ bền và bảo hành\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cdiv\u003eSản phẩm được bảo hành 3 tháng (kể từ thời điểm mua hàng). \u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv\u003eBảo hành trọn đời với lỗi bong keo và đứt chỉ.\u003c/div\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch2\u003eTính năng và lợi ích nổi bật\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cdiv\u003eThiết kế thời trang, phù hợp với nhiều độ tuổi khác nhau.\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv\u003eCông nghệ thoáng khí trên thân giày giúp hạn chế cảm giác bí bách, nóng bức khi mang giày trong thời gian dài. \u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv\u003eChất liệu đế giày cao cấp, chắc chắn, độ bền cao. \u003c/div\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch2\u003eSản phẩm bao gồm\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cdiv\u003eHộp giày giấy bìa cứng cáp giúp bảo quản giày tốt hơn.\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv\u003eDây giày chắc chắn.\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv\u003eTúi chống ẩm.\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv\u003eGiày\u003c/div\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/2e/ea/b5/ba75defbe64b0431757a4f74e775ae1e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/2e/ea/b5/ba75defbe64b0431757a4f74e775ae1e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/2e/ea/b5/ba75defbe64b0431757a4f74e775ae1e.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2e/ea/b5/ba75defbe64b0431757a4f74e775ae1e.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2e/ea/b5/ba75defbe64b0431757a4f74e775ae1e.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/90/