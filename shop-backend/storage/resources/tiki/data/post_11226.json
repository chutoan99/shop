3f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.7,"review_count":3,"review_text":"(3)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ca/1f/58/46c6de3e56cc75f785cb52c47d8ec99c.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":650,"all_time_quantity_sold":35,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p style=\"text-align:center\"><strong>Tinh Dầu Tràm Thiên Nhiên FoBaby - Chai 25ml</strong></p>\n<p style=\"text-align:center\"><strong><img src=\"https://salt.tikicdn.com/ts/tmp/5e/44/89/f9b50b41fc33ad719bdee5571d2c6a7c.jpg\" alt=\"\" width=\"750\" height=\"750\" /></strong></p>\n<p><strong>Liều Dùng</strong><br />- Để tắm: 5 giọt/ lần<br />- Nhỏ vào nước nóng để xông: 3-4 giọt/lần<br />- Xoa trực tiếp: 1-2 giọt/lần.</p>\n<p><strong>Công Dụng:</strong><br />- Dùng massage da hoặc pha với nước ấm để tắm khi trời lạnh, giúp làm ẩm da.<br />- Dùng bôi da: giúp làm dịu da khi bị muỗi côn trùng đốt. Tinh dầu trong sản phẩm giúp ăn ngừa muỗi, côn trùng.</p>\n<p><strong>Cách Dùng:</strong><br />- <em><strong>Khi bị ho khan, ho gió</strong></em>: dùng dầu xoa đều vùng lưng để cơ thể ấm dần lên, sẽ giúp giảm ho.<br />- <em><strong>Khi đau bụng hoặc ăn quá no</strong></em>: dùng dầu xoa một chút lên rốn và vùng da xung quanh rốn, xoa nhẹ theo chiều kim đồng hồ làm ấm bụng, thức ăn dễ tiêu hoá.<br />- <em><strong>Khi bị ngạt mũ</strong></em>i: nhỏ vài giọt dầu vào chén nước sôi, hít tinh dầu sẽ giúp dễ thở hơn và bớt chảy nước mũi.<br />- <em><strong>Khi bị muỗi đốt, côn trùng nước</strong></em>: dùng dầu xoa lên vết cắn giúp giảm viêm, sưng.<br />- Đổ chút dầu vào nước tắm hoặc sử dụng tinh dầu massage giúp giảm mệt mỏi, giảm đau nhức, giải cảm.<br />- Xoa dầu vào gan bàn chân, lưng, ngực giúp phòng cảm lạnh.<br />- Xoa dầu lên cơ thể giúp phòng côn trùng đốt, khử trùng và phòng các bệnh truyền nhiễm về đường hô hấp.<br />- Khi đi chơi xa hoặc tới nơi đông người, xoa dầu lên áo quần và lòng bàn tay để phòng nhiễm bệnh.</p>\n<p><strong>Bảo quản</strong><br />Để nơi khô ráo, Tránh xa tầm tay trẻ em.</p>\n<p><img style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/59/ac/cf/8e03c592a0f7e6042bac84377336d0f2.jpg\" alt=\"\" width=\"444\" height=\"444\" /></p>\n<p><br /><strong>Lưu Ý:</strong><br />Không bôi lên vết thương, hở, vùng da non hoặc niêm mạc mắt<br />Không dùng nếu có dấu hiệu bị dị ứng với tinh dầu.</p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ca/1f/58/46c6de3e56cc75f785cb52c47d8ec99c.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ca/1f/58/46c6de3e56cc75f785cb52c47d8ec99c.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ca/1f/58/46c6de3e56cc75f785cb52c47d8ec99c.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ca/1f/58/46c6de3e56cc75f785cb52c47d8ec99c.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ca/1f/58/46c6de3e56cc75f785cb52c47d8ec99c.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/05/e3/10/1fd94dda66e67216aa4788a320cb0548.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com