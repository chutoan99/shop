_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":429000,"discount_rate":52,"rating_average":4.2,"review_count":6,"review_text":"(6)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/9c/4a/c5/f2d49678e075a69e6e8858467a114fd5.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1204,"all_time_quantity_sold":15,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cul\u003e\u003cli\u003eViên uống vitamin E DHC là một sản phẩm thực phẩm chức năng DHC bổ sung vitamin E tự nhiên chiết xuất từ đậu nành đến từ thương hiệu DHC Nhật Bản.\u003c/li\u003e\u003cli\u003eViên uống được nhiều khách hàng tại Nhật Bản và quốc tế yêu thích và tin dùng nhờ khả năng duy trì, nâng cao sức khỏe cơ thể và cải thiện vẻ đẹp, sự trẻ trung cho làn da của bạn.\u003c/li\u003e\u003cli\u003eViên uống vitamin E DHC chống lão hóa tuyệt vời. Nếu cơ thể thiếu vitamin E, da sẽ nhanh chóng lão hóa, các vết nhăn xuất hiện sớm cùng với thâm, nám. Đồng thời tóc và móng sẽ không còn khỏe mạnh.\u003c/li\u003e\u003cli\u003eSản phẩm có tác dụng cung cấp độ ẩm để cải thiện tình trạng da khô, cải thiện sức khỏe, bổ sung dinh dưỡng cho những người có chế độ ăn uống thiếu chất.\u003cbr /\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/0a/f7/1a/c4596d9fc507c1dde31d057fe9f69266.jpg\" alt=\"\" width=\"750\" height=\"421\" /\u003e\u003c/li\u003e\u003c/ul\u003e\n\u003cp style=\"text-align:center\"\u003e\u003cspan style=\"color:#0000ff\"\u003e\u003cem\u003eSản phẩm được bán trên Tiki luôn là phiên bản mới nhất, hình ảnh sản phẩm sẽ được cập nhật mới theo từng lô hàng nhập\u003c/em\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003eThực phẩm bảo vệ sức khỏe DHC Natural Vitamin E (soybean) có chứa tới 301,5mg vitamin E hoạt tính cao dưới dạng d-alpha tocopherol được chiết xuất hoàn toàn tự nhiên từ đậu nành. Viên uống thích hợp cho những người gặp một số vấn đề như khô da, nhạy cảm với thời tiết lạnh, cứng khớp, chế độ ăn thiếu dinh dưỡng và tối ưu hóa sức khỏe cho người trung niên và cao tuổi.\u003c/p\u003e\n\u003cp\u003eVitamin E được mệnh da là \u0026#34;vitamin trẻ hóa\u0026#34; nhờ tác dụng chống oxy hóa và tăng cường lưu thông máu tuyệt vời của nó. Bổ sung vitamin E bằng viên uống vitamin E DHC là cách dễ nhất để duy trì một cơ thể trẻ trung, sức khỏe dẻo dai.\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003e\u003cem\u003eThực phẩm này không phải là thuốc và không có tác dụng thay thế thuốc chữa bệnh.\u003c/em\u003e\u003c/strong\u003e\u003c/li\u003e\u003c/ul\u003e\n\u003ch2\u003e\u003cstrong\u003eThành phần\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003eMỗi viên nang mềm có chứa:\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eVitamin E (90% (d-alpha tocopherol) (từ đậu nành): 335mg.\u003c/li\u003e\u003cli\u003ePhụ liệu: gelatin, glycerin vừa đủ 1 viên.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/32/50/4c/6260ad50ae904b048f9c8345b9419be8.webp\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center\"\u003e\u003cspan style=\"color:#0000ff\"\u003e\u003cem\u003eSản phẩm được bán trên Tiki luôn là phiên bản mới nhất, hình ảnh sản phẩm sẽ được cập nhật mới theo từng lô hàng nhập\u003c/em\u003e\u003c/span\u003e\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eCông dụng\u003c/strong\u003e\u003c/h2\u003e\n\u003cul\u003e\u003cli\u003eBảo vệ các tế bào trong cơ thể tránh khỏi hiện tượng bị oxy hóa, hạn chế được bệnh xơ cứng động mạch.\u003c/li\u003e\u003cli\u003eHạn chế bị cứng vai, đau đầu, dễ cảm lạnh và sưng tấy.\u003c/li\u003e\u003cli\u003eNgăn ngừa lão hóa da, cải thiện tình trạng da khô hiệu quả.\u003c/li\u003e\u003cli\u003eBổ sung thêm dinh dưỡng cho cơ thể khỏe mạnh.\u003c/li\u003e\u003c/ul\u003e\n\u003ch2\u003e\u003cstrong\u003eĐối tượng sử dụng\u003c/strong\u003e\u003c/h2\u003e\n\u003cul\u003e\u003cli\u003eNgười muốn cải thiện thói quen sinh hoạt.\u003c/li\u003e\u003cli\u003eNgười muốn duy trì thanh xuân.\u003c/li\u003e\u003cli\u003eNgười muốn cải thiện da khô.\u003c/li\u003e\u003cli\u003eNgười kháng lạnh.\u003c/li\u003e\u003cli\u003eNgười có nhịp sống xáo trộn.\u003c/li\u003e\u003c/ul\u003e\n\u003ch2\u003e\u003cstrong\u003eQuy cách đóng gói\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003eKhối lượng tịnh: 510mg ± 18mg\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eGói dùng 20 ngày (20 viên)\u003c/li\u003e\u003cli\u003eGói dùng 30 ngày (30 viên)\u003c/li\u003e\u003cli\u003eGói dùng 60 ngày (60 viên)\u003c/li\u003e\u003cli\u003eGói dùng 90 ngày (90 viên)\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/f7/df/74/c8db702261b1b735f6604a8153dda157.jpg\" alt=\"\" width=\"720\" height=\"720\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center\"\u003e\u003cspan style=\"color:#0000ff\"\u003e\u003cem\u003eSản phẩm được bán trên Tiki luôn là phiên bản mới nhất, hình ảnh sản phẩm sẽ được cập nhật mới theo từng lô hàng nhập\u003c/em\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCách dùng:\u003c/strong\u003e người lớn uống 1 viên/ngày (uống với nước hoặc nước ấm). Dùng theo liều khuyến cáo và tránh sử dụng quá liều.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eLưu ý:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eSản phẩm không dùng cho người mẫn cảm với các thành phần của sản phẩm.\u003c/li\u003e\u003cli\u003eDừng uống khi phát hiện bất thường.\u003c/li\u003e\u003cli\u003eKhông sử dụng sản phẩm nếu dị ứng với bất cứ thành phần nào của sản phẩm.\u003c/li\u003e\u003cli\u003eNếu bạn đang dùng sản phẩm khác, đang điều trị tại bệnh viện hoặc đang mang thai, hãy tham khảo ý kiến bác sĩ trước khi dùng.\u003c/li\u003e\u003cli\u003eĐể xa tầm tay trẻ em. Sử dụng ngay sau khi mở bao bì. Đóng túi ngay sau khi sử dụng.\u003c/li\u003e\u003cli\u003eVì sản phẩm sử dụng nguyên liệu thiên nhiên không sử dụng chất điều chỉnh màu nên có thể có một chút khác nhau về màu sắc nhưng không ảnh hưởng tới chất lượng sản phẩm.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eBảo quản:\u003c/strong\u003e Nơi khô ráo, thoáng mát, tránh ánh sáng mặt trời.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/9c/4a/c5/f2d49678e075a69e6e8858467a114fd5.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/9c/4a/c5/f2d49678e075a69e6e8858467a114fd5.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/9c/4a/c5/f2d49678e075a69e6e8858467a114fd5.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9c/4a/c5/f2d49678e075a69e6e8858467a114fd5.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9c/4a/c5/f2d49678e075a69e6e8858467a114fd5.png"},{"base_url":"https://salt.tikicdn.com/ts/product/57/85/45/504e0b33a0566b1c47a2dca9f7ba06a7.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/57/85/45/504e0b33a0566b1c47a2dca9f7ba06a7.jpg","medium_url":"https://s