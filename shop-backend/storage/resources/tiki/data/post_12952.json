66e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":228800,"discount_rate":17,"rating_average":5,"review_count":5,"review_text":"(5)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/8d/bc/68/b1905f76c095865f1c953d848af04693.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1449,"all_time_quantity_sold":12,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003eGiới thiệu\u003c/h3\u003e\n\u003cp\u003e\u003cstrong\u003eTã quần Bobby lõi nén thần kì 3mm\u003c/strong\u003e đến từ thương hiệu Unicharm Nhật Bản sẽ là lựa chọn hoàn hảo của mẹ cho sức khỏe của bé trong những năm tháng đầu đời. Với lưng thun co giãn 3 vùng linh hoạt, bề mặt siêu thấm hút và thoát ẩm tối đa, tã quần sẽ mang đến cho bé những giờ phút vui chơi vui vẻ và thoải thích. Bề mặt tã với công nghệ 3D tiên tiến giúp bé thoải mái vận động, tự do khám phá thế giới xung quanh. Sản phẩm là sự lựa chọn tốt nhất mà mẹ dành cho bé yêu trong những tháng năm đầu đời.\u003c/p\u003e\n\u003ch3\u003eĐặc điểm nổi bật\u003c/h3\u003e\n\u003cp\u003e\u003cstrong\u003eLõi nén thần kì 3mm thoáng khí gấp 2 lần\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eBobby ứng dụng công nghệ ép đặc biệt cho ra đời chiếc tã quần Bobby Lõi Nén Thần Kỳ 3mm mỏng nhẹ không tưởng nhưng vẫn giữ được khả năng thấm hút và khô thoáng tối đa. Bé khi mặc tã không hề có cảm giác dày cộm ở đũng hay gây cản trở trong suốt quá trình vận động.\u003cbr /\u003e\u003cbr /\u003e\u003cstrong\u003eLớp thấm nhanh siêu tốc\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eNhanh chóng dàn đều và giữ sâu chất lỏng, thấm hút thật nhiều mà không lo dày bí, cho làn da bé luôn khô thoáng.\u003cbr /\u003e\u003cbr /\u003e\u003cstrong\u003eHệ thun Magic Fit\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eCo giãn linh hoạt theo từng cử động của bé nên miếng tã luôn vừa vặn, thoải mái lại chống tràn hiệu quả hơn.\u003cbr /\u003e\u003cbr /\u003e\u003cstrong\u003eMàng đáy thoát ẩm đa chiều\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eNhanh chóng đẩy hơi nóng ẩm ra ngoài, giúp da hô hấp tự nhiên, ngăn ngừa hăm tã.\u003c/p\u003e\n\u003cp style=\"text-align:center\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/f3/5a/d3/734ab7e656c021f300837a810c5edae0.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch3\u003eHướng dẫn chọn size\u003c/h3\u003e\n\u003cul\u003e\u003cli\u003eSize M - gói 76 miếng dành cho bé từ 6 - 11kg\u003c/li\u003e\u003cli\u003eSize L - gói 68 miếng dành cho bé từ 9 - 13kg\u003c/li\u003e\u003cli\u003eSize XL - gói 62 miếng dành cho bé từ 12 - 17kg\u003c/li\u003e\u003cli\u003eSize XXL - gói 56 miếng dành cho bé từ 15 - 25kg\u003c/li\u003e\u003cli\u003eSize XXXL dành cho bé 20 - 35 kg\u003c/li\u003e\u003c/ul\u003e\n\u003ch3\u003eHướng dẫn sử dụng\u003c/h3\u003e\n\u003cul\u003e\u003cli\u003eMở rộng phần eo và chân bỉm Bobby. Mang tã quần Bobby cho bé giống như mặc quần lót.\u003c/li\u003e\u003cli\u003eKéo tã quần Bobby lên bụng cho đến khi đũng quần vừa chạm mông bé.\u003c/li\u003e\u003cli\u003eĐiều chỉnh để vách chống trào luôn nằm trong bỉm quần Bobby và mép chun chân nằm ngoài cho bé thoải mái\u003c/li\u003e\u003c/ul\u003e\n\u003ch3\u003eCách bảo quản\u003c/h3\u003e\n\u003cdiv class=\"content-product\"\u003e\n\u003cdiv id=\"product-description\" class=\"product-description less-content table-responsive full-screen\"\u003e\n\u003cp\u003eBảo quản ở nơi khô mát, tránh bụi và ánh nắng trực tiếp.\u003c/p\u003e\n\u003ch3\u003eThông tin sản phẩm\u003c/h3\u003e\n\u003cul\u003e\u003cli\u003eXuất xứ : Nhật Bản\u003c/li\u003e\u003cli\u003eNơi sản xuất : Việt Nam\u003c/li\u003e\u003cli\u003eHạn sử dụng : 4 năm kể từ ngày sản xuất\u003c/li\u003e\u003c/ul\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003ch3\u003eThông tin thương hiệu\u003c/h3\u003e\n\u003cp style=\"text-align:justify\"\u003eBobby là thương hiệu nổi tiếng của công ty Diana, thuộc tập đoàn Unicharm Nhật Bản, chuyên cung cấp những sản phẩm chất lượng cao cấp dành cho trẻ em. Ra mắt thị trường Việt Nam từ năm 2003, Bobby trở thành thương hiệu tã giấy được ưa chuộng và tin dùng bởi sự sáng tạo độc đáo và đầy yêu thương dành cho trẻ em, với thiết kế các loại tã giấy màng đáy thoáng khí dạng vải, đem đến sự khô thoáng và bảo vệ làn da của các bé. Tháng 12 năm 2005, Bobby lại đi tiên phong trên thị trường Việt Nam bằng việc cải tiến sản phẩm tã giấy chống hăm 3 tác động với lõi bông siêu thấm, màng đáy thoáng khí dạng vải và tinh chất trà xanh. Sử dụng dây chuyền sản xuất hiện đại kết hợp với thế mạnh là thành viên của tập đoàn hàng đầu thế giới Unicharm Nhật Bản, công ty Diana luôn đi đầu trong việc ứng dụng các công nghệ hiện đại trong lĩnh vực sản xuất các sản phẩm chăm sóc vệ sinh cá nhân để sáng tạo ra những sản phẩm chất lượng cao nhất, phù hợp nhất và Bobby là một minh chứng cho điều đó.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/8d/bc/68/b1905f76c095865f1c953d848af04693.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/8d/bc/68/b1905f76c095865f1c953d848af04693.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/8d/bc/68/b1905f76c095865f1c953d848af04693.jpg","position":n