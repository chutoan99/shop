h thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/0b/31/88/5171fa626493b8872d488977f5ab5460.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0b/31/88/5171fa626493b8872d488977f5ab5460.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/0b/31/88/5171fa626493b8872d488977f5ab5460.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0b/31/88/5171fa626493b8872d488977f5ab5460.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0b/31/88/5171fa626493b8872d488977f5ab5460.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/ef/06/d0/94c467bbff221cb7cee926e7dc9178eb.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ef/06/d0/94c467bbff221cb7cee926e7dc9178eb.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ef/06/d0/94c467bbff221cb7cee926e7dc9178eb.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ef/06/d0/94c467bbff221cb7cee926e7dc9178eb.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ef/06/d0/94c467bbff221cb7cee926e7dc9178eb.jpg"}],"warranty_policy":null,"brand":{"id":86206,"name":"Senka","slug":"senka"},"current_seller":{"id":177208,"sku":"7121964298375","name":"Ngô Thành Lợi Store","link":"https://tiki.vn/cua-hang/ngo-thanh-loi-store","logo":"f1/6a/81/c7f08b5d316ababba1841639a8ff79cd.jpg","price":27000,"product_id":"183036227","store_id":164244,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Content","attributes":[{"code":"brand","name":"Thương hiệu","value":"Senka"},{"code":"brand_country","name":"Xuất xứ thương hiệu","value":"Trung Quốc"},{"code":"kich_thuoc","name"