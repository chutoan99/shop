ent":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ac/89/f0/6fe65028d6ea0b1816223e7fd617ef56.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":178,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eĐỒNG HỒ NAM CHÍNH HÃNG LOBINNI NO.3604 - ỨNG CỬ VIÊN SỐ MỘT TRONG TẦM GIÁ\u003c/p\u003e\n\u003cp\u003e\u003ciframe src=\"https://www.youtube.com/embed/TMsgpfZLU4E\" width=\"800\" height=\"400\" frameborder=\"0\" scrolling=\"no\"\u003e\u003c/iframe\u003e\u003c/p\u003e\n\u003cp\u003eChỉ với giá hơn 2 triệu đồng, tìm kiếm một chiếc đồng hồ nam chính hãng đến từ thương hiệu có tiếng, đi kèm với đó là vẻ ngoài sang trọng, đẹp mắt và sự chất lượng bên trong bộ máy quả là việc không hề đơn giản.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/d8/40/05/e9e61d9b97a74b04c2baeeccb54d17fd.jpg?v=1670492037728\" alt=\"dong-ho-nam-lobinni-no-3604-chinh-hang-1.jpg?v=1670492037728\" /\u003e\u003c/p\u003e\n\u003cp\u003eTuy nhiên Lobinni No.3604 sẽ là vị cứu tinh hoàn hảo cho bạn. Sản phẩm sở hữu những điểm cộng đắt giá mà ít ai nghĩ với mức giá thành này lại đáp ứng được. Cụ thể:\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/00/44/f3/9c32eeefa69a85d4d5da3b27699e4379.jpg?v=1670492038596\" alt=\"dong-ho-nam-lobinni-no-3604-chinh-hang-2.jpg?v=1670492038596\" /\u003e\u003c/p\u003e\n\u003cp\u003eXuất xứ đến từ thương hiệu đình đám \u003c/p\u003e\n\u003cp\u003eLobinni No.3604 là đứa con tâm đắc của nhà Lobinni, thương hiệu nổi tiếng với nhiều năm kinh nghiệm trong ngành chế tác đồng hồ đeo tay. Nhắc đến Lobinni, người ta thường nghĩ đến những cỗ máy thời gian chất lượng, bền bỉ cùng vẻ ngoài tinh tế đến từng chi tiết.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/a6/e9/9c/2c101fafc3ff54b48fd8b766e08fc965.jpg?v=1670492039461\" alt=\"dong-ho-nam-lobinni-no-3604-chinh-hang-3.jpg?v=1670492039461\" /\u003e\u003c/p\u003e\n\u003cp\u003eThiết kế trẻ trung, sang trọng\u003c/p\u003e\n\u003cp\u003eCực kì ấn tượng bởi sự thanh lịch, dưới lớp kính Sapphire là một sự sắp đặt tinh tế, các mốc giờ được thể hiện bằng những chữ số La Mã làm tăng thêm tính cổ điển.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/58/6e/9e/2ad8747df441ae682126deb851f03f76.jpg?v=1670492040111\" alt=\"dong-ho-nam-lobinni-no-3604-chinh-hang-4.jpg?v=1670492040111\" /\u003e\u003c/p\u003e\n\u003cp\u003eTrang bị bộ khung xương được chế tác hoàn toàn bằng chất liệu thép không gỉ 316L với nhiều ưu điểm như độ cứng cao, không bị gỉ sét hay bong tróc theo thời gian.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/15/a0/b9/f20f07889f38897216c4e5db2009eac5.jpg?v=1670492040839\" alt=\"dong-ho-nam-lobinni-no-3604-chinh-hang-5.jpg?v=1670492040839\" /\u003e\u003c/p\u003e\n\u003cp\u003eMặt kính Sapphire cao cấp đem đến trải nghiệm sắc nét cho người dùng, độ trong suốt giúp chiêm ngưỡng trọn vẹn cảnh sắc mặt số.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/58/df/a3/355e4689dae76f09cc94e6b94153ac76.jpg?v=1670492041647\" alt=\"dong-ho-nam-lobinni-no-3604-chinh-hang-6.jpg?v=1670492041647\" /\u003e\u003c/p\u003e\n\u003cp\u003eBộ máy hiện đại\u003c/p\u003e\n\u003cp\u003eTrang bị máy Quartz với nhiều cải tiến mới giúp sản phẩm đạt được độ chính xác 100% và dễ dàng bảo dưỡng sửa chữa.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/a8/60/48/1b170e3bc9c024a7fc7c401295ccd153.jpg?v=1670492042341\" alt=\"dong-ho-nam-lobinni-no-3604-chinh-hang-7.jpg?v=1670492042341\" /\u003e\u003c/p\u003e\n\u003cp\u003eKhông chỉ dừng lại ở việc xem giờ\u003c/p\u003e\n\u003cp\u003eLobinni No.3604 không chỉ hỗ trợ người dùng ở việc xem thời gian cơ bản mà còn trang bị thêm nhiều chức năng như lịch thứ, lịch ngày, lịch moon phase.....\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/6c/46/e5/ca4d271c03b8e3d21cd419b4ce7251c5.jpg?v=1670492043242\" alt=\"dong-ho-nam-lobinni-no-3604-chinh-hang-8.jpg?v=1670492043242\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/a4/f3/ab/6c4ee75235161ef60b754febdd671784.jpg?v=1670492043971\" alt=\"dong-ho-nam-lobinni-no-3604-chinh-hang-9.jpg?v=1670492043971\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/eb/3b/40/22a1674af597807e1f93d100f99261d0.jpg?v=1670492044688\" alt=\"dong-ho-nam-lobinni-no-3604-chinh-hang-10.jpg?v=1670492044688\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/6c/f7/b2/75374c258142aca2bfbbed67db3492aa.jpg?v=1670492045134\" alt=\"dong-ho-nam-lobinni-no-3604-chinh-hang-11.jpg?v=1670492045134\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/e6/3f/b7/ce9da809c57e154d91d93df708db31e3.jpg?v=1670492045791\" alt=\"dong-ho-nam-lobinni-no-3604-chinh-hang-12.jpg?v=1670492045791\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ac/89/f0/6fe65028d6ea0b1816223e7fd617ef56.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ac/89/f0/6fe65028d6ea0b1816223e7fd617ef56.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ac/89/f0/6fe65028d6ea0b1816223e7fd617ef56.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ac/89/f0/6fe65028d6ea0b1816223e7fd617ef56.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ac/89/f0/6fe65028d6ea0b1816223e7fd617ef56.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/9c/ab/66/cad568b9253e4c7411471e3c1c869a50.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/9c/ab/66/cad568b9253e4c7411471e3c1c869a50.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/9c/ab/66/cad568b9253e4c7411471e3c1c869a50.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9c/ab/66/cad568b9253e4c7411471e3c1c869a50.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9c/ab/66/cad568b9253e4c7411471e3c1c869a50.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/67/71/c4/4688b8eaced90b5ebb81bfea22ea6825.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/67/71/c4/4688b8eaced90b5ebb81bfea22ea6825.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/67/71/c4/4688b8eaced90b5ebb81bfea22ea6825.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/67/71/c4/4688b8eaced90b5ebb81bfea22ea6825.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/67/71/c4/4688b8eaced90b5ebb81bfea22ea6825.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/d3/49/84/1da4dc13dce7be172e955ece11dcb9c2.jpg","is_gallery":true,"label":null,"large_url":"https://salt.