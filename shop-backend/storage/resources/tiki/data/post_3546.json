n"}},"discount":1404000,"discount_rate":47,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/d3/84/d6/4e718a12cb1870a2ad6abfda07ab954c.png","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":189,"all_time_quantity_sold":6,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eĐộng cơ không chổi than tốc độ cao 110.000 rpm, tốc độ gió 65m/s, làm khô tóc ngắn chỉ trong 40 giây\u003c/p\u003e\n\u003cp\u003eCảm biến kiểm soát nhiệt thông minh NTC, kiểm soát nhiệt độ 100 lần/giây. Tránh hư tóc và da đầu\u003c/p\u003e\n\u003cp\u003eKích thước siêu gọn nhẹ (chỉ 330g, chiều ngang 8,2 mm)\u003c/p\u003e\n\u003cp\u003eNâng cấp giảm tiếng ồn, sấy tóc trong yên tĩnh (độ ồn 75dB)\u003c/p\u003e\n\u003cp\u003eCông nghệ bung tỏa 200 triệu ion âm chăm sóc tóc\u003c/p\u003e\n\u003cp\u003eNút bấm đổi màu khi chuyển chế độ, dễ quan sát\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-ls27b7yge07t59\" width=\"700\" height=\"700\" alt=\"vn-11134208-7r98o-ls27b7yge07t59\" /\u003e\u003c/p\u003e\n\u003cp\u003eLuồng khí tốc độ cao\u003c/p\u003e\n\u003cp\u003eĐược trang bị động cơ có tốc độ quay 110.000 vòng/phút tiên tiến nhất, luồng khí sấy mạnh mẽ 65m/s, máy sấy Dreame Hair Gleam có khả năng sấy khô tóc ngắn nhanh chỉ trong 40 giây. Dreame Hair Gleam nhanh chóng sấy khô tóc từ gốc đến ngọn nhưng vẫn giữ cho da đầu luôn khỏe mạnh, tránh mất ẩm.\u003c/p\u003e\n\u003cp\u003eKhối lượng nhẹ, dễ thao tác\u003c/p\u003e\n\u003cp\u003eMáy sấy tóc Dreame Hair Gleam chỉ nặng 330gr cùng đầu sấy ngắn 82mm cho cảm giác cầm nắm thoải mái và dễ chịu khi sử dụng. Sản phẩm được cấu thành từ chất liệu mỏng nhẹ với cấu tạo máy tối ưu, tiện cất giữ hoặc mang theo trong các chuyến đi.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-ls27b7ygclnd80\" width=\"700\" height=\"700\" alt=\"vn-11134208-7r98o-ls27b7ygclnd80\" /\u003e\u003c/p\u003e\n\u003cp\u003eCông nghệ hiện đại, chăm sóc tóc toàn diện\u003c/p\u003e\n\u003cp\u003eMáy sấy tóc Dreame Hair Gleam được tích hợp công nghệ tiên tiến nhằm đảm bảo khả năng làm khô tóc nhanh chóng. Công nghệ bung tỏa 200 triệu phân tử ion âm/cm³ - nồng độ gấp 20 lần so với các dòng máy sấy thông thường - giúp trung hòa tĩnh điện và làm mượt tóc. Những ion âm này giúp bảo vệ biểu bì tóc, khóa độ ẩm, giúp tóc chắc khỏe hơn.\u003c/p\u003e\n\u003cp\u003eThiết kế bộ lọc khí được đưa xuống dưới tay cầm vừa tránh tóc bị cuốn vào trong, vừa an toàn về mặt điện năng. Ngoài ra, việc trang bị có sản phẩm chip NTC kiểm soát nhiệt thông minh sẽ giúp tránh tình trạng quá nhiệt, không gây bỏng da đầu và chống giật điện.\u003c/p\u003e\n\u003cp\u003eĐể đáp ứng nhu cầu sử dụng đa dạng của người dùng, máy sấy tóc Dreame Hair Gleam được trang bị 4 chế độ sấy đi kèm 2 tốc độ gió. Kết hợp với nhau, người dùng có đến 8 tùy chỉnh sấy khác nhau.\u003c/p\u003e\n\u003cp\u003eĐặc biệt, sản phẩm được áp dụng công nghệ giảm ồn độc quyền từ nhà Dreame, tạo cảm giác thoải mái nhất cho người dùng.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-ls27b7yg9sih7a\" width=\"700\" height=\"700\" alt=\"vn-11134208-7r98o-ls27b7yg9sih7a\" /\u003e\u003c/p\u003e\n\u003cp\u003eThông số kỹ thuật\u003c/p\u003e\n\u003cp\u003eTên sản phẩm: Máy sấy tóc Dreame Hair Gleam\u003c/p\u003e\n\u003cp\u003eNguồn điện: 220V~50Hz\u003c/p\u003e\n\u003cp\u003eCông suất: 1.600 Watt\u003c/p\u003e\n\u003cp\u003eKích thước sản phẩm: 76 x 82 x 255 mm\u003c/p\u003e\n\u003cp\u003eTốc độ động cơ: 110.000 vòng/phút\u003c/p\u003e\n\u003cp\u003eTốc độ thổi: 65m/giây\u003c/p\u003e\n\u003cp\u003eTrọng lượng: 330 gram\u003c/p\u003e\n\u003cp\u003eChế độ nhiệt: 4\u003c/p\u003e\n\u003cp\u003eChế độ gió: 2\u003c/p\u003e\n\u003cp\u003eĐộ ồn: 75 dB(A)\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/d3/84/d6/4e718a12cb1870a2ad6abfda07ab954c.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d3/84/d6/4e718a12cb1870a2ad6abfda07ab954c.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d3/84/d6/4e718a12cb1870a2ad6abfda07ab954c.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d3/84/d6/4e718a12cb1870a2ad6abfda07ab954c.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d3/84/d6/4e718a12cb1870a2ad6abfda07ab954c.png"},{"base_url":"https://salt.tikicdn.com/ts/product/68/c1/c1/bf6d3fe3245c76dcbc5134ff89c0e811.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/68/c1/c1/bf6d3fe3245c76dcbc5134ff89c0e811.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/68/c1/c1/bf6d3fe3245c76dcbc5134ff89c0e811.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/68/c1/c1/bf6d3fe3245c76dcbc5134ff89c0e811.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/68/c1/c1/bf6d3fe3245c76dcbc5134ff89c0e811.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/e5/48/d2/da43d63e279c5ff90064cd685e5c014d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e5/48/d2/da43d63e279c5ff90064cd685e5c014d.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e5/48/d2/da43d63e279c5ff90064cd685e5c014d.jpg","position":null,"small_url":"http