g_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":6000,"discount_rate":9,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/media/catalog/product/n/h/nhu_thien_duong_lanh_in-1.u2751.d20170221.t134031.901420.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2753,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p style=\"text-align: justify;\"><span style=\"font-size: medium; color: #ff6600;\"><strong>Như Thiên Đường Lạnh - Truyện Dài</strong></span></p>\r\n<p style=\"text-align: justify;\">\"Sức hấp dẫn của Nguyễn Thị Thuỵ Vũ chính là câu chuyện gia đình, những cuộc hôn nhân éo le, gãy đổ do ràng buộc nghiêm ngặt của quan niệm cũ kỹ và những đổi thay bên ngoài của thời cuộc. Với mảng đề tài này, có một điều cần ghi nhận ngoài lời ăn tiếng nói rặt ròng Nam bộ, tác giả còn có biệt tài quan sát khi miêu tả sinh hoạt nghệ thuật quen thuộc ở nông thôn miền Nam thuở ấy như hát bội đình làng, giải sầu ca vọng cổ…, ngoài ra còn miêu tả các món ăn dân dã, quê mùa rất đỗi thân thương nay đã ít nhiều trở thành dĩ vãng.</p>\r\n<p style=\"text-align: justify;\">Bên cạnh đó Nguyễn Thị Thuỵ Vũ cũng chọn cho mình một lối đi khác hẳn khi đưa vào tác phẩm của mình: đó là khai thác về số phận vũ nữ, gái bán bar, bằng cái nhìn nhân văn, sự đồng cảm sâu sắc về một tầng lớp phụ nữ bị rẻ rúng, khinh thường.\"</p>\r\n<p style=\"text-align: justify;\"><span style=\"font-size: medium; color: #ff6600;\"><strong><br /></strong></span></p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/media/catalog/product/n/h/nhu_thien_duong_lanh_in-1.u2751.d20170221.t134031.901420.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/n/h/nhu_thien_duong_lanh_in-1.u2751.d20170221.t134031.901420.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/n/h/nhu_thien_duong_lanh_in-1.u2751.d20170221.t134031.901420.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/n/h/nhu_thien_duong_lanh_in-1.u2751.d20170221.t134031.901420.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/n/h/nhu_thien_duong_lanh_in-1.u2751.d20170221.t134031.901420.jpg"},{"base_url":"https://salt.tikicdn.com/media/catalog/product/n/h/nhu_thien_duong_lanh_in.u2751.d20170221.t134031.956919.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/n/h/nhu_thien_duong_lanh_in.u2751.d20170221.t134031.956919.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/n/h/nhu_thien_duong_lanh_in.u2751.d20170221.t134031.956919.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/n/h/nhu_thien_duong_lanh_in.u2751.d20170221.t134031.956919.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/n/h/nhu_thien_duong_lanh_in.u2751.d20170221.t134031.956919.jpg"}],"warranty_policy":null,"authors":[{"id":79714,"name":"Nguyễn Thị Thụy Vũ","slug":"nguyen-thi-thuy-vu"}],"current_seller":{"id":670,"sku":"7911470613139","name":"Cá Chép Bookstore","link":"https://tiki.vn/cua-hang/ca-chep-bookstore","logo":"https://vcdn.tikicdn.com/ts/seller/0a/89/1c/28dd476ede7a32391ad449d0f0c9c403.jpg"