trong>SẢN PHẨM BAO GỒM</strong></div>\n<ul>\n<li>01 Micro Takstar PC-K220USB</li>\n<li>01 Cáp USB</li>\n<li>01 Kẹp Micro</li>\n<li>01 Giá đỡ 3 chân</li>\n<li>01 Bông lọc gió</li>\n<li>Sách hướng dẫn</li>\n</ul>\n<div><strong>THÔNG SỐ KỸ THUẬT</strong></div>\n<div>\n<table style=\"width: 100%;\" border=\"1\">\n<tbody>\n<tr style=\"height: 17px;\">\n<td style=\"height: 17px; width: 172.812px;\">Data Transmission</td>\n<td style=\"height: 17px; width: 376.337px;\">USB2.0</td>\n</tr>\n<tr style=\"height: 17px;\">\n<td style=\"height: 17px; width: 172.812px;\">Sample Rate</td>\n<td style=\"height: 17px; width: 376.337px;\">44.1/48KHz</td>\n</tr>\n<tr style=\"height: 17px;\">\n<td style=\"height: 17px; width: 172.812px;\">Bit Rate</td>\n<td style=\"height: 17px; width: 376.337px;\">16bit</td>\n</tr>\n<tr style=\"height: 17px;\">\n<td style=\"height: 17px; width: 172.812px;\">Frequency Response</td>\n<td style=\"height: 17px; width: 376.337px;\">20Hz-20KHz</td>\n</tr>\n<tr style=\"height: 17px;\">\n<td style=\"height: 17px; width: 172.812px;\">Cartridge</td>\n<td style=\"height: 17px; width: 376.337px;\">Φ16mm condenser cartridge</td>\n</tr>\n<tr style=\"height: 17px;\">\n<td style=\"height: 17px; width: 172.812px;\">Polar Pattern</td>\n<td style=\"height: 17px; width: 376.337px;\">cardioid</td>\n</tr>\n<tr style=\"height: 17px;\">\n<td style=\"height: 17px; width: 172.812px;\">Sensitivity</td>\n<td style=\"height: 17px; width: 376.337px;\">-14dB±3dB(0dB=1V/Pa/m at 1KHz)</td>\n</tr>\n<tr style=\"height: 17px;\">\n<td style=\"height: 17px; width: 172.812px;\">Output Sensitivity</td>\n<td style=\"height: 17px; width: 376.337px;\">-5dB±3dB</td>\n</tr>\n<tr style=\"height: 17px;\">\n<td style=\"height: 17px; width: 172.812px;\">Max SPL</td>\n<td style=\"height: 17px; width: 376.337px;\">≥108dB(at 1KHz,1%THD)</td>\n</tr>\n<tr style=\"height: 17px;\">\n<td style=\"height: 17px; width: 172.812px;\">Power Supply</td>\n<td style=\"height: 17px; width: 376.337px;\">USB(DC 5V/100mA)<