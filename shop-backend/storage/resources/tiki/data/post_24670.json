ps://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":10000,"discount_rate":13,"rating_average":4.5,"review_count":10,"review_text":"(10)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/30/50/f5/9e138480f824877669e97bd1f84513c3.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1331,"all_time_quantity_sold":36,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\"Pomelo - dưỡng tóc tinh dầu vỏ bưởi\" với thành phần tinh dầu vỏ bưởi kết hợp với những nguyên liệu từ thiên nhiên đã được nghiên cứu kĩ lưỡng sẽ tác động vào từng tế bào tóc và da đầu, giúp tóc ngày càng chắc khoẻ và suôn mượt hơn, đặc biệt là ngăn ngừa tình trạng rụng tóc và phục hồi tóc hư tổn hiệu quả.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/d1/a3/7e/861bdd4cad7560d8b558dd446d7f23eb.jpg\" alt=\"\" width=\"708\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThành phần chính:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Tinh dầu vỏ bưởi: Do có tính kháng khuẩn và chống oxy hóa cao, tinh dầu vỏ bưởi giúp ngăn ngừa nhiễm trùng, mang lại cho bạn da đầu và tóc khỏe mạnh, cải thiện rõ rệt tình trạng gãy rụng tóc.\u003cbr /\u003e- Vitamin B5 (D-panthenol): Chức năng như một tác nhân dưỡng tóc để cung cấp độ ẩm lâu dài cho tóc, ngăn ngừa hư tổn, làm dày tóc và cải thiện độ bóng khỏe của mái tóc.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/73/70/3e/8c019956129206f1e4968214a5789a3d.jpg\" alt=\"\" width=\"750\" height=\"481\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTác dụng:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eNgăn ngừa rụng tóc,kích thích tóc mọc, phục hồi tóc hư tổn.\u003c/p\u003e\n\u003cp\u003eGiảm khô xơ,nuôi dưỡng da đầu và chân tóc, giúp tóc trở nên suôn mượt tự nhiên.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCách dùng:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eLắc đều chai để tinh dầu được hòa tan đồng nhất\u003c/p\u003e\n\u003cp\u003eXịt trực tiếp lên da đầu, dùng các ngón tay massage nhẹ nhàng để dưỡng chất thấm sâu vào da đầu.\u003c/p\u003e\n\u003cp\u003eNên dùng sau khi tắm xong 30 phút hoặc khi tóc bị khô xơ.\u003c/p\u003e\n\u003cp\u003eKhông xịt lên tóc khi trên tóc có nhiều mồ hôi và bụi bẩn\u003c/p\u003e\n\u003cp\u003e1 ngày dùng 2 lần, 1 chai dùng khoảng 2 tuần.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/3d/de/01/b0806ee310327d57ec7d4bd1c937478b.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eKhuyên dùng:\u003c/strong\u003e 2 chai trong 1 tháng để thấy được hiệu quả rõ nhất\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eBảo quản:\u003c/strong\u003e nơi khô ráo, thoáng mát, tránh ánh nắng trực tiếp.\u003c/p\u003e\n\u003cp\u003eKHI SỬ DỤNG SẢN PHẨM , MÁI TÓC CỦA BẠN SẼ CÓ NHỮNG THAY ĐỔI SAU:\u003c/p\u003e\n\u003cp\u003eThời gian đầu dùng sản phẩm, bạn sẽ thấy tình trạng rụng tóc giảm đáng kể.\u003cbr /\u003eĐến tiếp theo sử dụng, tóc giảm khô xơ, chẻ ngọn và trở nên suôn mượt dần lên.\u003cbr /\u003eSau khi dùng sản phẩm sẽ giúp kích thích mọc tóc, mái tóc sẽ dày lên thấy rõ, đen đậm và rất mượt.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/d8/3c/f9/6ce1df025723e8351180c1c6144ffe8f.jpg\" alt=\"\" width=\"750\" height=\"942\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/30/50/f5/9e138480f824877669e97bd1f84513c3.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/30/50/f5/9e138480f824877669e97bd1f84513c3.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/30/50/f5/9e138480f824877669e97bd1f84513c3.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/30/50/f5/9e138480f824877669e97bd1f84513c3.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/30/50/f5/9e138480f824877669e97bd1f84513c3.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/7a/d4/90/627defd97f2f1f6224e4ebd7914f6897.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/7a/d4/90/627defd97f2f1f6224e4ebd7914f6897.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/7a/d4/90/627defd97f2f1f6224e4ebd7914f6897.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7a/d4/90/627defd97f2f1f6224e4ebd7914f6897.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7a/d4/90/627defd97f2f1f6224e4ebd7914f6897.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/dc/a5/ef/8a4fa07cc32329179481cc8f967124d9.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/dc/a5/ef/8a4fa07cc32329179481cc8f967124d9.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/t