,"icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":43000,"discount_rate":25,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/cd/fb/a2/43009ffb9116fc57d00da287e8091b36.PNG","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":943,"all_time_quantity_sold":10,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: center;\"\u003e\u003cspan style=\"color: #ff6600;\"\u003e\u003cstrong\u003eOKRs – Tối Ưu Hóa Hiệu Suất Của Bất Kỳ Đội Nhóm Nào\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eTrong cuốn sách này, cựu Chủ tịch kiêm CEO của Intel, Andrew Grove, cung cấp một cái nhìn tổng quan toàn diện về vai trò và mục đích của người quản lý, với những hiểu biết thực tế về cách tăng hiệu suất của bạn. Cuốn sách được viết chủ yếu dành cho các nhà quản lý cấp trung, nhưng những hiểu biết sâu sắc lại phù hợp với cả các nhà lãnh đạo và quản lý các cấp. Tác giả đưa ra ba nội dung chính trong cuốn sách này. Nội dung đầu tiên là \u003c/span\u003e\u003cspan style=\"font-weight: 400;\"\u003ephương pháp quản trị hướng đến hiệu suất\u003c/span\u003e\u003cspan style=\"font-weight: 400;\"\u003e. Nội dung thứ hai \u003c/span\u003e\u003cspan style=\"font-weight: 400;\"\u003enhấn mạnh rằng công việc của một doanh nghiệp, một cơ quan chính phủ, hay trong hầu hết các hình thái hoạt động của con người, là một nỗ lực đến từ tập thể chứ không phải là của một cá nhân. Nội dung thứ ba là Một đội ngũ sẽ làm việc hiệu quả chỉ khi từng thành viên được khích lệ để hoàn thành tốt nhất công việc của mình.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eCác chủ đề cốt lõi được đề cập trong cuốn sách:\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003e- Ủy quyền\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003e- Các cuộc họp\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003e- Quy trình đưa ra quyết định\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003e- Báo cáo kép\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003e- Tạo động lực\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003e- Đánh giá hiệu suất\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color: #ff6600;\"\u003e\u003cstrong\u003eGIỚI THIỆU TÁC GIẢ : \u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eNăm 1956, Andrew S. Grove di cư từ Hungary đến Mỹ. Ông đồng sáng lập Intel và trở thành chủ tịch của tập đoàn vào năm 1979, đến năm 1987 ông đảm nhận vị trí giám đốc điều hành. Năm 1997, Tạp chí \u003c/span\u003e\u003cem\u003e\u003cspan style=\"font-weight: 400;\"\u003eTime \u003c/span\u003e\u003c/em\u003e\u003cspan style=\"font-weight: 400;\"\u003ebình chọn ông là “Nhân vật của năm”. Năm 1998, ông thôi giữ chức Giám đốc điều hành tại Intel và từ năm 2004, ông rời khỏi chức chủ tịch công ty. Grove tham gia giảng dạy chuyên ngành Kinh doanh thuộc khoa Sau đại học tại Đại học Stanford trong suốt 24 năm. Ông hiện đang sống ở khu vực vịnh San Francisco.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/cd/fb/a2/43009ffb9116fc57d00da287e8091b36.PNG","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/cd/fb/a2/43009ffb9116fc57d00da287e8091b36.PNG","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/cd/fb/a2/43009ffb9116fc57d00da287e8091b36.PNG","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/cd/fb/a2/43009ffb9116fc57d00da287e8091b36.PNG","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/cd/fb/a2/43009ffb9116fc57d00da287e8091b36.PNG"}],"warranty_policy":null,"authors":[{"id":19132,"name":"Andrew S. Grove","slug":"andrew-s-grove"}],"current_seller":{"id":145814,"sku":"1898736592674","name":"Omega Plus Books","link":"https://tiki.vn/cua-hang/omega-plus-books","logo":"8b/17/0b/9e986158bc230b4fd699f07095893546.jpg","price":126000,"product_id":"162096074","store_id":134535,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[{"id":7247,"name":"Alpha Books Official","link":"https://tiki.vn/cua-hang/alphabooks-official","logo":"38/74/f3/f9cf41005697c643397d9b09d335f4c4.jpg","price":126000,"product_id":"167029918","store_id":7082},{"id":57167,"name":"Nhà sách NetaBooks","link":"https://tiki.vn/cua-hang/nha-sach-netabooks","logo":"33/f2/97/e245fe4d226f0e26fb1cc7ba3741d661.jpg","price":144500,"product_id":"170782372","store_id":54106},{"id":281062,"name":"Bamboo Books","link":"https://tiki.vn/cua-hang/bamboo-books","logo":"46/9a/b3/e4fbfd97e7607ea4d2ff8e9ad769121b.jpg","price":143650,"product_id":"177835872","store_id":268132},{"id":295057,"name":"HỆ THỐNG NHÀ SÁCH ABC","link":"https://tiki.vn/cua-hang/he-thong-nha-sach-abc","logo":"98/3d/ff/cec0ba0eaa575634616ab4605fccbe6d.jpg","price":152000,"product_id":"193730728