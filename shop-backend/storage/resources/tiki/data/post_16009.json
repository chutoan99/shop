":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":1007000,"discount_rate":51,"rating_average":4.8,"review_count":28,"review_text":"(28)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/03/bd/ee/b0d70eaf5e761b4ce3afa72c6245d80c.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1901,"all_time_quantity_sold":171,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003ciframe src=\"https://www.youtube.com/embed/qf_BiSNr2s4\" width=\"974\" height=\"548\" frameborder=\"0\" allowfullscreen=\"allowfullscreen\"\u003e\u003c/iframe\u003e\u003c/p\u003e\n\u003ch2 class=\"vc_custom_heading everymovie\" style=\"font-size: 27px;\"\u003e\u003cspan style=\"color: #a1cc0f;\"\u003eCHẤT LIỆU CAO CẤP\u003c/span\u003e\u003c/h2\u003e\n\u003cp\u003e\u003cspan style=\"color: #a1cc0f;\"\u003e\u003cspan style=\"color: #a1cc0f;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/c4/20/3a/65f35970632dd172c96bf7c397674887.jpg\" alt=\"Gối nêm Hi-Sleep có 2 loại kích thước, phù hợp với tất cả mọi người\" width=\"750\" height=\"562\" /\u003e\u003cbr /\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color: #000000;\"\u003eLoại 1: Dài 70cm Rộng 60cm Cao 22cm, góc nghiêng 17,5 độ. Dùng cho người bị SUY GIẢM NHIỀU chất lượng cuộc sống do thường xuyên (trên 3 lần/tuần) gặp triệu chứng trào ngược.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color: #000000;\"\u003eLoại 2: Dài 70cm Rộng 60cm Cao 14cm, góc nghiêng 11,3 độ. Dùng cho người bị SUY GIẢM NHẸ chất lượng cuộc sống do thỉnh thoảng (dưới 3 lần/tuần) gặp triệu chứng trào ngược.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/b6/08/e2/44292ad15bb5b4055cc0e4a8704465ab.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cstrong\u003eLưu ý:\u003c/strong\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eHai loại gối cao 14 cm dài 70 cm và cao 18 cm dài 90 cm sẽ có cấu tạo 1 lớp mút foam than tre hoạt tính nguyên khối.\u003c/li\u003e\n\u003cli\u003eRiêng gối cao 22 cm dài 70 cm có cấu tạo 2 lớp, bên dưới là lớp foam than tre hoạt tính màu đen, còn trên bề mặt là 2 cm memory foam (hay còn được gọi là cao su non) màu xanh.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cspan style=\"color: #000000;\"\u003eGối được làm từ mút cao cấp PolyUrethan tỷ tọng cao, đàn hồi cực tốt đem đến cảm giác êm ái, thoải mái khi nằm mà không hề xẹp lún. \u003cbr /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color: #000000;\"\u003e \u003cimg src=\"https://salt.tikicdn.com/ts/tmp/66/57/64/c9fde99eff781b4da015fa15770a6de3.jpg\" alt=\"\" width=\"900\" height=\"450\" /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color: #000000;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/89/b1/f5/27fc9f06ab7c1b2a6fee241e95e01d96.jpg\" alt=\"\" width=\"750\" height=\"417\" /\u003e\u003cbr /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color: #000000;\"\u003eGối có 2 lớp áo giúp thuận tiện tháo rời để vệ sinh. Vỏ gối được làm từ chất liệu cao cấp, chuyên dụng trong các khách sạn 4-5 sao.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color: #a1cc0f;\"\u003e\u003cspan style=\"color: #a1cc0f;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/33/fd/bc/f808aa16ac8d0e61c80a0f9aea6fdc9c.jpg\" alt=\"\" width=\"750\" height=\"494\" /\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color: #000000;\"\u003eCảm giác mềm mại, êm ái nhưng không hề xẹp lún khi nằm trên gối. Gối được bảo hành xẹp lún 1 đổi 1 trong 1 năm.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color: #a1cc0f;\"\u003e\u003cspan style=\"color: #a1cc0f;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/24/49/ba/713ab2f6bff2d9ea7056405f2fa9cd77.jpg\" alt=\"\" width=\"750\" height=\"457\" /\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\n\u003ch2 class=\"vc_custom_heading everymovie\" style=\"font-size: 27px;\"\u003e\u003cspan style=\"color: #a1cc0f;\"\u003eĐA DẠNG CÁCH SỬ DỤNG\u003c/span\u003e\u003c/h2\u003e\n\u003cp\u003e\u003cspan style=\"color: #a1cc0f;\"\u003e\u003cspan style=\"color: #a1cc0f;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/9d/96/0f/bd9e7f9edc50601f22dc040c5d66f8d6.jpg\" alt=\"\" width=\"750\" height=\"474\" /\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color: #a1cc0f;\"\u003e\u003cspan style=\"color: #a1cc0f;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/34/9b/de/52389643cb763a3644af5d06131b382a.jpg\" alt=\"\" width=\"750\" height=\"474\" /\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color: #a1cc0f;\"\u003e\u003cspan style=\"color: #a1cc0f;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/7f/f5/2e/02ca311cc014ede02bec6941bce1f2b3.jpg\" alt=\"\" width=\"750\" height=\"460\" /\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color: #a1cc0f;\"\u003e\u003cspan style=\"color: #a1cc0f;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/88/37/00/498d3b1432736efb7f35f0e056280802.jpg\" alt=\"\" width=\"750\" height=\"465\" /\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color: #a1cc0f;\"\u003e\u003cspan style=\"color: #a1cc0f;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/6b/e4/be/6adc45d5b88e92e59a7cfdd804297cda.jpg\" alt=\"\" width=\"750\" height=\"474\" /\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\n\u003ch2 class=\"vc_custom_heading everymovie\" style=\"font-size: 27px; line-height: 1.4;\"\u003e\u003cspan style=\"color: #a1cc0f;\"\u003e\u003cspan style=\"color: #a1cc0f;\"\u003eBẠN HOÀN TOÀN CÓ THỂ GIẢM TRÀO NGƯỢC MÀ \u003c/span\u003e\u003cspan style=\"color: #b21c09;\"\u003eKHÔNG CẦN DÙNG THUỐC \u003c/span\u003e\u003cspan style=\"color: #b21c09;\"\u003e\u003cspan style=\"color: #a1cc0f;\"\u003eNẾU BẠN:\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/h2\u003e\n\u003cp\u003e\u003cstrong\u003e1. Có 1 trong các triệu chứng sau xảy ra vào ban đêm:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eNóng rát, khó thở, đau tức ngực khi đi ngủ\u003c/li\u003e\n\u003cli\u003eCảm giác trào ngược\u003c/li\u003e\n\u003cli\u003eKhó ngủ, mất ngủ, thức giấc ban đêm do các cơn trào ngược\u003c/li\u003e\n\u003cli\u003eBuồn nôn, ho\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003e2. Có 1 trong các triệu chứng sau xảy ra vào buổi sáng:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eBuồn nôn, nôn khan khi đánh răng\u003c/li\u003e\n\u003cli\u003eChua miệng, đắng miệng\u003c/li\u003e\n\u003cli\u003eKhàn giọng, mất tiếng khi ngủ dậy\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003e3. Mắc bệnh trào ngược dạ dày và không muốn gặp phải các biến chứng: \u003c/strong\u003eviêm thực quản, nuốt khó, nghẹn cổ, tiền ung thư và ung thư thực quản…\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e4. Mắc bệnh trào ngược nhưng không thể dùng thuốc điều trị \u003c/strong\u003edo đang mang thai hoặc đang điều trị bệnh đặc biệt khác\u003c/p\u003e\n\u003ch2 class=\"vc_custom_heading everymovie\" style=\"font-size: 27px; text-align: left; line-height: 1.4;\"\u003e\u003cspan style=\"color: #a1cc0f;\"\u003eGỐI NÊM ĐÃ ĐƯỢC CÁC CHUYÊN GIA TOÀN CẦU \u003cspan style=\"color: #b21c09;\"\u003eCHỨNG MINH HIỆU QUẢ\u003c/span\u003e\u003c/span\u003e\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cspan style=\"color: #000000;\"\u003e\u003cstrong\u003e“Ngủ trên gối nêm và giảm cân là 2 phương pháp không dùng thuốc duy nhất được chứng minh là có tác dụng cải thiện triệu chứng ở bệnh nhân trào ngược dạ dày”\u003c/strong\u003e \u003cem\u003e- Hội nghị Đồng thuận Châu Á Thái Bình Dương về bệnh trào ngược dạ dày thực quản\u003c/em\u003e\u003c/span\u003e\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003e\u003cspan style=\"color: #000000;\"\u003e“65% bệnh nhân cải thiện chất lượng giấc ngủ sau 1 tuần sử dụng gối nêm” - \u003c/span\u003e\u003c/strong\u003e\u003cspan style=\"color: #000000;\"\u003e\u003cem\u003eTạp chí Gastroenterology and Hepatology 2012.\u003c/em\u003e\u003c/span\u003e\u003c/li\u003e\n\u003cli\u003e\u003cspan style=\"color: #000000;\"\u003e\u003cstrong\u003e“Sử dụng gối nêm giúp tăng 58,8% khả năng cải thiện triệu chứng trào ngược và tăng gấp đôi diện tích vết loét được làm lành so với dùng thuốc đơn độc”\u003c/strong\u003e\u003cem\u003e - Bệnh viện Franchay, Anh quốc.\u003c/em\u003e\u003c/span\u003e\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003e“Ngủ trên gối nêm giúp giảm 67% thời gian thực quản phải tiếp xúc với acid”\u003c/strong\u003e \u003cem\u003e- Bác sĩ Lawrence F. Johnson MD và Tom R. Demeester, Mỹ.\u003c/em\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch2 class=\"vc_custom_heading everymovie\" style=\"font-size: 27px; text-align: left; line-height: 1.4;\"\u003e\u003cspan style=\"color: #a1cc0f;\"\u003eHÀNG NGÀN NGƯỜI\u003c/span\u003e\u003cspan style=\"color: #a1cc0f;\"\u003e\u003cspan style=\"color: #b21c09;\"\u003e ĐÃ GIẢM TRÀO NGƯỢC\u003c/span\u003e NHỜ GỐI HI-SLEEP\u003c/span\u003e\u003c/h2\u003e\n\u003cp\u003e\u003cspan style=\"color: #a1cc0f;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/product/f7/16/bf/97d876347fd2777489f3f8ed1e497f37.png\" alt=\"\" width=\"0\" height=\"0\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/48/9b/30/9b095c9ae3af384a76fecef6977219d9.jpg\" alt=\"\" width=\"750\" height=\"421\" /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003e