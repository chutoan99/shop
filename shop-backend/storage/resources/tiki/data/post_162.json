596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":171000,"discount_rate":9,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/d0/81/30/3b7768a59297356bfcb93f6bc59ccc3b.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":0,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch5\u003eLò vi sóng Sharp nhỏ gọn, lắp đặt ở mọi vị trí mà không chiếm nhiều diện tích\u003c/h5\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ea/3f/09/a2b7a98325aea79320dfd8e77d058667.jpg\" alt=\"Lò Vi Sóng Có Nướng Sharp R-G222VN-S- 20 Lít - Hàng chính hãng\" width=\"750\" height=\"563\" /\u003e\u003c/p\u003e\n\u003ch5\u003eKhoang lò tráng men, hạn chế bám dầu mỡ, tiện vệ sinh sau khi dùng\u003c/h5\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/1f/3b/a0/ecd6095bb6da2fe33516a3a69c730387.jpg\" alt=\"Lò Vi Sóng Có Nướng Sharp R-G222VN-S- 20 Lít - Hàng chính hãng\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003ch5\u003eĐĩa xoay tròn cho món ăn chín đều, ngon hơn, lò có đèn chiếu sáng\u003c/h5\u003e\n\u003cp\u003eGiúp bạn dễ quan sát quá trình thức ăn được chế biến khi lò đang hoạt động.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/c1/09/d0/aa1661c9f650515c32b15402e2ef3002.jpg\" alt=\"Lò Vi Sóng Có Nướng Sharp R-G222VN-S- 20 Lít - Hàng chính hãng\" width=\"750px\" height=\"500px\" /\u003e\u003c/p\u003e\n\u003ch5\u003ePhục vụ tốt cho gia đình có từ 2 - 4 thành viên\u003c/h5\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/31/1a/55/70961473c9f47f4ee5f5235f59492b3c.jpg\" alt=\"Lò Vi Sóng Có Nướng Sharp R-G222VN-S- 20 Lít - Hàng chính hãng\" width=\"750px\" height=\"500px\" /\u003e\u003c/p\u003e\n\u003ch5\u003eChức năng nấu nướng kết hợp cho món ăn chín đều và thơm ngon\u003c/h5\u003e\n\u003cp\u003eBên cạnh 3 chức năng chính là nấu, hâm nóng và rã đông thì lò vi sóng Sharp R-G222VN-S còn được trang bị chức năng nướng với mức công suất cao nhất là 1000 W giúp bạn nướng thịt, bánh, hải sả ngay tại nhà dễ dàng.\u003c/p\u003e\n\u003ch5\u003eĐiều khiển nút vặn bằng tiếng Việt dễ dàng thao tác\u003c/h5\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/73/b9/23/65ead3b5bd27f4990304cb7eac256abc.jpg\" alt=\"Lò Vi Sóng Có Nướng Sharp R-G222VN-S- 20 Lít - Hàng chính hãng\" width=\"750px\" height=\"563px\" /\u003e\u003c/p\u003e\n\u003ch5\u003eChế độ hẹn giờ với thời gian hẹn tối đa đến 35 phút\u003c/h5\u003e\n\u003cp\u003eTùy theo món ăn, công thức nấu mà bạn chọn mốc thời gian phù hợp nhất.\u003c/p\u003e\n\u003cp\u003eLò vi sóng Sharp R-G222VN-S được sản xuất theo công nghệ hiện đại Nhật Bản nên bạn có thể hoàn toàn yên tâm về chất lượng khi sử dụng.\u003c/p\u003e\n\u003ch5\u003eLưu ý khi sử dụng lò vi sóng:\u003c/h5\u003e\n\u003cp\u003e- Không dùng chung ổ điện với các thiết bị điện khác.\u003c/p\u003e\n\u003cp\u003e- Để thêm một cốc nước khi hâm nóng thức ăn khô.\u003c/p\u003e\n\u003cp\u003e- Không sử dụng đồ đựng thức ăn bằng kim loại trong lò vi sóng.\u003c/p\u003e\n\u003cp\u003e- Khi ở chế độ nướng, không để lò vận hành khi không có thức ăn.\u003c/p\u003e\n\u003cp\u003e- Đặt lò vi sóng ở nơi thoáng mát, không gần các thiết bị điện khác như: tủ lạnh, bếp \u003c/p\u003e\n\u003cp\u003e- Trước khi vệ sinh khoang lò, phải rút điện ra trước, không dùng các chất tẩy rửa mạnh để lau chùi.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/d0/81/30/3b7768a59297356bfcb93f6bc59ccc3b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d0/81/30/3b7768a59297356bfcb93f6bc59ccc3b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d0/81/30/3b7768a59297356bfcb93f6bc59ccc3b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d0/81/30/3b7768a59297356bfcb93f6bc59ccc3b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d0/81/30/3b7768a59297356bfcb93f6bc59ccc3b.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/2e/91/5e/c2da13c395a70bf1ff18c91b46f75f4f.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/2e/91/5e/c2da13c395a70bf1ff18c91b46f75f4f.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/2e/91/5e/c2da13c395a70bf1ff18c91b46f75f4f.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2e/91/5e/c2da13c395a70bf1ff18c91b46f75f4f.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2e/91/5e/c2da13c395a70bf1ff18c91b46f75f4f.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/39/26/dc/35e2ab3d186a12dce02f03d5c62fc23a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/39/26/dc/35e2ab3d186a12dce02f03d5c62fc23a.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/39/26/dc/35e2ab3d186a12dce02f03d5c62fc23a.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/39/26/dc/35e2ab3d186a12dce02f03d5c62fc23a.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/39/26/dc/35e2ab3d186a12dc