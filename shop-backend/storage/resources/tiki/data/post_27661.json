"tracking_info":{"amplitude":{"is_authentic":false,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":63000,"discount_rate":24,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/a7/d8/d2/a816fc19fc5cbb8e4ec5ff6dde1a1188.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1071,"all_time_quantity_sold":5,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003eDầu Gội Phủ Bạc Tóc Lich5 Thảo Dược Đen Tóc Chỉ Trong 5 Phút - An Toàn - Không Hóa Chất - Giữ Màu 3 - 4 Tuần, Hộp 10 gói mylovestore\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cspan style=\"color:#ff0000;\"\u003e\u003cstrong\u003e1. THÔNG TIN CHI TIẾT DẦU GỘI PHỦ BẠC TÓC LICH5 THẢO DƯỢC\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003e- \u003c/strong\u003e\u003cstrong\u003eThương hiệu:\u003c/strong\u003e LICH5 (Việt Nam)\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003e- \u003c/strong\u003e\u003cstrong\u003eSản xuất tại:\u003c/strong\u003e HongKong\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003e- \u003c/strong\u003e\u003cstrong\u003eCông nghệ \u0026amp; Nguyên liệu\u003c/strong\u003e: Đức\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003e- \u003c/strong\u003e\u003cstrong\u003eSố lượng:\u003c/strong\u003e 10 gói/ hộp - 30gram/ gói\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003e- \u003c/strong\u003e\u003cstrong\u003eMùi hương:\u003c/strong\u003e Mùi hương nhân sâm tự nhiên\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003e\u003cspan style=\"color:#000000;\"\u003e- Màu:\u003c/span\u003e\u003c/strong\u003e Đen và Nâu đen\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003e- \u003c/strong\u003e\u003cstrong\u003eThành phần:\u003c/strong\u003e chiết xuất từ 8 thành phần thảo dược từ thiên nhiên: Hà thủ ô, nhân sâm, đương quy, ô dược, dầu hạt nho, dầu hạt bơ, cỏ mực, lá móng (henna ám).\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003e- \u003c/strong\u003e\u003cstrong\u003eCông dụng: \u003c/strong\u003e\u003c/p\u003e\n\u003cul style=\"text-align:justify;\"\u003e\u003cli\u003eLàm đen tóc, không làm hại da đầu, không gây kích ứng và không làm ảnh hưởng đến cấu trúc của sợi tóc.\u003c/li\u003e\n\u003cli\u003eThời gian giữ màu còn tùy thuộc vào chất tóc, độ tẩy màu của dầu gội đầu, nhiệt độ, độ ẩm và cách gội của mỗi người, màu có thể giữ được trong vòng 3 tuần đến 4 tuần.\u003c/li\u003e\n\u003c/ul\u003e\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003e- \u003c/strong\u003e\u003cstrong\u003eĐối tượng sử dụng: \u003c/strong\u003e\u003c/p\u003e\n\u003cul style=\"text-align:justify;\"\u003e\u003cli\u003eNgười bị bạc tóc, người thích nhuộm, thay đổi màu tóc mà không dùng sản phẩm hóa chất.\u003c/li\u003e\n\u003cli\u003eĐặc biệt phù hợp với người bị dị ứng với các loại thuốc nhuộm hóa chất.\u003c/li\u003e\n\u003cli\u003eNhững người lỡ cắt tóc ngắn mà không ưng ý, muốn tóc mọc nhanh hơn.\u003c/li\u003e\n\u003c/ul\u003e\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003e- \u003c/strong\u003e\u003cstrong\u003eHạn sử dụng:\u003c/strong\u003e 3 năm kể từ ngày sản xuất\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cspan style=\"color:#ff0000;\"\u003e\u003cstrong\u003e2. MÔ TẢ DẦU GỘI PHỦ BẠC TÓC LICH5 THẢO DƯỢC\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003eVì sao nên chọn Dầu phủ bạc tóc Lich5 Thảo dược?\u003c/p\u003e\n\u003cul\u003e\u003cli style=\"text-align:justify;\"\u003eLên màu tự nhiên: Lich5 được chiết xuất từ 8 thành phần thảo dược quý từ thiên nhiên: Hà thủ ô, nhân sâm, ô dược, đương quy, dầu hạt nho, dầu bơ, cỏ nhọ nhồi, lá móng (henna ám)\u003c/li\u003e\n\u003cli style=\"text-align:justify;\"\u003eKhông gây rát, xót da đầu như thuốc nhuộm tóc hóa học.\u003c/li\u003e\n\u003cli style=\"text-align:justify;\"\u003eKhông gây ra hư tổn, khô, xơ, gãy rụng như các sản phẩm nhuộm tóc hóa học; an toàn cho da đầu và mái tóc; không gây hại cho sức khỏe.\u003c/li\u003e\n\u003cli style=\"text-align:justify;\"\u003eChống lại những tác nhân có hại từ môi trường, bảo vệ tóc khỏi hư tổn.\u003c/li\u003e\n\u003cli style=\"text-align:justify;\"\u003eMùi thơm tự nhiên, không gây cảm giác khó chịu như thuốc nhuộm tóc hóa học.\u003c/li\u003e\n\u003cli style=\"text-align:justify;\"\u003eTiết kiệm chi phí nhuộm tóc và rất tiện lợi theo mỗi túi 30 gram cho một lần nhuộm tóc.\u003c/li\u003e\n\u003c/ul\u003e\u003cp style=\"text-align:justify;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cspan style=\"color:#ff0000;\"\u003e\u003cstrong\u003e3. HƯỚNG DẪN SỬ DỤNG DẦU GỘI PHỦ BẠC TÓC LICH5 THẢO DƯỢC\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli style=\"text-align:justify;\"\u003e\u003cstrong\u003eBước 1\u003c/strong\u003e: Cắt túi đựng dung dịch dầu gội đen tóc Lich5, sau đó chấm hỗn hợp vào cổ tay/ vùng da phía sau tai và để trong khoảng 2 phút để thử phản ứng dị ứng với sản phẩm (chỉ cần thử một lần vào lần đầu sử dụng sản phẩm)\u003c/li\u003e\n\u003cli style=\"text-align:justify;\"\u003e\u003cstrong\u003eBước 2\u003c/strong\u003e: Cho hỗn hợp dung dịch gội phủ bạc vào một cốc nhỏ, trộn đều. \u003c/li\u003e\n\u003cli style=\"text-align:justify;\"\u003e\u003cstrong\u003eBước 3:  \u003c/strong\u003eLàm ẩm tóc. Lưu ý chỉ cần làm ẩm tóc là đủ, không để tóc quá ướt/ quá khô, không cần gội đầu trước khi nhuộm vì sẽ ảnh hưởng đến khả năng bám màu của tóc).\u003c/li\u003e\n\u003cli style=\"text-align:justify;\"\u003e\u003cstrong\u003eBước 4\u003c/strong\u003e: Đeo găng tay có sẵn trong hộp dầu gội đen tóc Lich5 để tránh việc màu nhuộm làm đen móng tay. Xoa đều hỗn hợp lên tóc, massage nhẹ nhàng và sau đó ủ như thế trong khoảng 5-10 phút (đối với Nâu đen cần để thời gian lâu hơn, khoảng 15-30 phút).\u003c/li\u003e\n\u003cli style=\"text-align:justify;\"\u003e\u003cstrong\u003eBước 5\u003c/strong\u003e: Tiến hành gội tạo bọt như dầu bình thường với nước sạch.\u003c/li\u003e\n\u003cli style=\"text-align:justify;\"\u003e\u003cstrong\u003eBước 6\u003c/strong\u003e:Để khô tóc và kiểm tra mức độ lên màu của sản phẩm. Nên tuân thủ đúng cách gội nhuộm chuẩn để có hiệu quả tốt nhất\u003c/li\u003e\n\u003c/ul\u003e\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003eLưu ý: Nếu tóc dày và dài có thể sử dụng 2 gói đầu gội nhuộm tóc Lich5 để gội. Đừng quên trộn đều 2 hỗn hợp lên bạn nhé! \u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e \u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color:#ff0000;\"\u003e\u003cstrong\u003eMYLOVESTORE\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eSHOP Cam kết Sản phẩm Chất lượng - An Toàn cho người sử dụng - Thân thiện với môi trường.\u003c/li\u003e\n\u003cli\u003eBạn hãy Nhấn nút “Theo dõi” SHOP để nhận mã giảm giá cũng như Big Sale hàng ngày, hàng tuần, hàng tháng.\u003c/li\u003e\n\u003cli\u003eBạn hãy Chia sẻ cảm nhận về sản phẩm sau khi bạn sử dụng cho SHOP nha\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/15/cc/d4/69cd367f4e