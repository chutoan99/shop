_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/d0/2b/ef/4c58e2c441024bed49f62b2b2380e62d.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1870,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch5\u003eThiết kế nhỏ gọn cùng 3 cối xay tiện dụng\u003c/h5\u003e\n\u003cp\u003e\u003cstrong\u003eMáy Xay Sinh Tố Đa Năng Sunhouse SHD5322\u003c/strong\u003e có thiết kế hiện đại với một cối xay sinh tố kèm lưới lọc bã và 1 thanh đẩy giúp bạn xay trái cây được nhanh hơn, sánh mịn hơn. Bên cạnh đó là 1 cối xay thực phẩm khô và 1 cối xay thịt, đáp ứng mọi nhu cầu làm bếp của bạn. \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/19/b0/b6/c11178c631216075a4e8de9da429d6cc.jpg\" alt=\"Máy Xay Sinh Tố Đa Năng Sunhouse SHD5322 (250W - 1.25L) - Đỏ - Hàng Chính Hãng\" width=\"750px\" height=\"563px\" /\u003e\u003c/p\u003e\n\u003ch5\u003eLưỡi dao inox siêu sắc\u003c/h5\u003e\n\u003cp\u003eMỗi cối xay đều được trang bị lưỡi dao inox sắc bén giúp xay thực phẩm cực nhanh, cực nhuyễn. Chất liệu inox có độ bền cao, không han gỉ, an toàn với sức khỏe.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/3c/10/84/24596703017cb087ca0d8a41bdf60ea7.jpg\" alt=\"Máy Xay Sinh Tố Đa Năng Sunhouse SHD5322 (250W - 1.25L) - Đỏ - Hàng Chính Hãng\" width=\"750px\" height=\"500px\" /\u003e\u003c/p\u003e\n\u003ch5\u003eNúm xoay tiện dụng\u003c/h5\u003e\n\u003cp\u003eMáy vận hành nhờ núm xoay tùy chỉnh cường độ xay nghiền khác nhau trên thân máy, phù hợp với nhiều loại thực phẩm. Đặc biệt có chế độ đảo trộn làm tăng cường hiệu quả khi xay.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/72/f3/0f/b496e36851d540386133a3b4f5d03914.jpg\" alt=\"Máy Xay Sinh Tố Đa Năng Sunhouse SHD5322 (250W - 1.25L) - Đỏ - Hàng Chính Hãng\" width=\"750px\" height=\"500px\" /\u003e\u003c/p\u003e\n\u003ch5\u003eXay được nhiều loại thực phẩm\u003c/h5\u003e\n\u003cp\u003eTrang bị động cơ 220W mạnh mẽ, máy xay sinh tố đa năng SUNHOUSE SHD5322 có khả năng xay nhuyễn nhiều loại thực phẩm từ hoa quả mềm đến các loại hạt cứng, các loại thịt cá với 2 tốc độ và 1 nút nhồi. Máy hoạt động êm ái, độ ồn thấp, không rung lắc nhiều, rất dễ chịu trong quá trình sử dụng.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/dc/61/9f/37da78143c66a4d9ee5269123081d8ab.jpg\" alt=\"Máy Xay Sinh Tố Đa Năng Sunhouse SHD5322 (250W - 1.25L) - Đỏ - Hàng Chính Hãng\" width=\"750px\" height=\"500px\" /\u003e\u003c/p\u003e\n\u003ch5\u003eĐộ bền cao, đảm bảo sức khỏe\u003c/h5\u003e\n\u003cp\u003eMáy xay sinh tố đa năng SUNHOUSE SHD5322 được làm từ những chất liệu an toàn, không gây hại (inox cao cấp, nhựa PC siêu bền), giúp bạn hoàn toàn yên tâm khi sử dụng.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/96/97/65/8b714655b10baeaa8aac2ea27adcd54b.jpg\" alt=\"Máy Xay Sinh Tố Đa Năng Sunhouse SHD5322 (250W - 1.25L) - Đỏ - Hàng Chính Hãng\" width=\"750px\" height=\"500px\" /\u003e\u003c/p\u003e\n\u003ch5\u003eKhóa an toàn trong quá trình sử dụng\u003c/h5\u003e\n\u003cp\u003eĐộng cơ trang bị rơ-le chống quá tải nhiệt. Khi máy hoạt động liên tục hoặc xay quá nhiều thực phẩm, máy sẽ tự động ngắt để bảo vệ động cơ và kéo dài tuổi thọ sản phẩm.\u003c/p\u003e\n\u003cp\u003eĐặc biệt, máy chỉ hoạt động khi lắp đúng khớp đem đến sự an toàn cho người sử dụng.\u003c/p\u003e\n\u003ch5\u003eDễ dàng vệ sinh\u003c/h5\u003e\n\u003cp\u003eCác bộ phận máy có thể tháo rời dễ dàng nên việc vệ sinh, lau chùi rất đơn giản và nhẹ nhàng. Chất liệu máy không bám dính thực phẩm nên không lưu lại cặn hỏng, không gây mùi cho lần sử dụng sau.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/d0/2b/ef/4c58e2c441024bed49f62b2b2380e62d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d0/2b/ef/4c58e2c441024bed49f62b2b2380e62d.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d0/2b/ef/4c58e2c441024bed49f62b2b2380e62d.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d0/2b/ef/4c58e2c441024bed49f62b2b2380e62d.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d0/2b/ef/4c58e2c441024bed49f62b2b2380e62d.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/78/b6/ec/dcd64915e4f07ddc4cf33f17c2962454.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/78/b6/ec/dcd64915e4f07ddc4cf33f17c2962454.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/78/b6/ec/dcd64915e4f07ddc4cf33f17c2962454.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/78/b6/ec/dcd64915e4f07ddc4cf33f17c2962454.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/78/b6/ec/dcd64915e4f07ddc4cf33f17c2962454.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/e0/b2/b1/a32710b15aea85b7b4dbbfa6323f914d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e0/b2/b1/a32710b15aea85b7b4dbbfa6323f914d.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e0/b2/b1/a32710b15aea85b7b4dbbfa6323f914d.jpg","position":null,"small_url":"https://salt.tikicdn.com/cac