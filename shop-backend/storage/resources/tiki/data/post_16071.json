},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":436000,"discount_rate":46,"rating_average":5,"review_count":5,"review_text":"(5)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/3b/43/3b/5b3754c6bba4be0e2abe374222193d0f.jpeg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":617,"all_time_quantity_sold":18,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eHộp quà tặng - set quà tặng cao cấp Kingdom Herb với thiết kế sang trọng, có các chi tiết ép kim vàng. Mang lại cảm giác vô cùng tinh tế và sang trọng. Sự kết hợp hài hòa giữa các họa tiết hoa văn, màu sắc, các sản phẩm chứa đựng bên trong, tạo nên một set quà tặng đẳng cấp, phù hợp với tất cả sự kiện, đối tượng được tặng như trong các dịp quà tặng sinh nhật, quà tặng tết, quà tặng 8/3 - 20/10, quà tặng doanh nghiệp, quà tặng valentine, quà tặng noel giáng sinh, quà tặng bố mẹ, quà tặng bạn gái, bạn trai...\u003c/p\u003e\n\u003cp\u003eĐặc biệt, set quà tặng cao cấp Kingdom Herb là một sản phẩm in-house 100%. Các sản phẩm bên trong đều là sản phẩm được sản xuất bởi Kingdom Herb. Với chất lượng cao cấp, các sản phẩm bổ trợ cho nhau, giúp người được tặng luôn cảm giác hài lòng tuyệt đối. Chắc chắn, người được tặng sẽ dành cho Quý khách một sự trân trọng vô bờ\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://cf.shopee.vn/file/sg-11134202-22110-hi90krqf9gkv7e\" alt=\"hộp quà tặng\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eThông tin hộp quà tặng saffron ngâm mật ong \u0026amp; táo đỏ / kỷ tử Kingdom Herb chính hãng thượng hạng\u003c/p\u003e\n\u003cp\u003e- Xuất xứ: Việt Nam\u003cbr /\u003e- Quy cách hộp quà tặng: 1 hộp saffron ngâm mật ong 311g + 1 hộp táo đỏ 55g hoặc 1 hộp kỷ tử 90g + 1 que lấy mật + 1 bình nước thuỷ tinh 300ml + 1 thiệp chúc + 1 túi giấy\u003cbr /\u003e- Thành phần: saffron ngâm mật ong + táo đỏ hoặc kỷ tử\u003cbr /\u003e- Hạn sử dụng: 3 năm kể từ ngày sản xuất\u003cbr /\u003e- Ngày sản xuất: in trên bao bì sản phẩm\u003c/p\u003e\n\u003cp\u003e* Hộp quà tặng 1 gồm có:\u003c/p\u003e\n\u003cp\u003e- 1 hộp saffron ngâm mật ong Kingdom Herb 311 gram, với hương thơm thanh khiết từ thiên nhiên, hương vị ngọt thanh. Với nhiều công dụng kết hợp từ saffron \u0026amp; mật ong, chắc chắn sẽ mang lại trải nghiệm \u0026amp; cảm nhận tuyệt vời cho người được tặng\u003cbr /\u003e- 1 hộp táo đỏ Tân Cương Kingdom Herb 55 gram, chuẩn Organic, trái to \u0026amp; không phẩm màu, hóa chất\u003cbr /\u003e- 1 bình nước thủy tinh cao cấp. Sản phẩm khác biệt với các loại cùng mẫu mã trôi nổi. Người được tặng có thể sử dụng hàng ngày để sử dụng các sản phẩm trong set quà, giúp người được tặng luôn nhớ đến người tặng\u003cbr /\u003e- 1 que gỗ lấy mật ong bằng gỗ thông. Một phụ kiện thể hiện sự tinh tế của người tặng. Giúp lấy mật ong dễ dàng \u0026amp; không làm biến chất mật khi sử dụng dụng cụ kim loại\u003cbr /\u003e- 1 thiệp chúc mừng để ghi những lời chúc tốt đẹp tới người nhận\u003cbr /\u003e- 1 túi quà tặng thương hiệu, thuận tiện cho việc mang đi\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://cf.shopee.vn/file/sg-11134202-22110-aigwvwpa9gkvba\" alt=\"set quà tặng\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e* Hộp quà tặng 2 gồm có:\u003c/p\u003e\n\u003cp\u003e- 1 hộp Saffron ngâm mật ong Kingdom Herb 311 gram, với hương thơm thanh khiết từ thiên nhiên, hương vị ngọt thanh. Với nhiều công dụng kết hợp từ saffron\u0026amp; mật ong, chắc chắn sẽ mang lại trải nghiệm \u0026amp; cảm nhận tuyệt vời cho người được tặng\u003cbr /\u003e- 1 hộp kỷ tử đỏ Ninh Hạ Kingdom Herb 90 gram, chuẩn organic, trái to mọng \u0026amp; không phẩm màu, hóa chất\u003cbr /\u003e- 1 chai nước thủy tinh cao cấp. Sản phẩm khác biệt với các loại cùng mẫu mã trôi nổi. Người được tặng có thể sử dụng hàng ngày để sử dụng các sản phẩm trong set quà, giúp người được tặng luôn nhớ đến người tặng\u003cbr /\u003e- 1 que gỗ lấy mật ong bằng gỗ thông. Một phụ kiện thể hiện sự tinh tế của người tặng. Giúp lấy mật ong dễ dàng \u0026amp; không làm biến chất mật khi sử dụng dụng cụ kim loại\u003cbr /\u003e- 1 thiệp chúc mừng để ghi những lời chúc tốt đẹp tới người nhận\u003cbr /\u003e- 1 túi quà tặng thương hiệu, thuận tiện cho việc mang đi\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://cf.shopee.vn/file/sg-11134202-22110-c4tlvg3a9gkv6b\" width=\"750\" height=\"750\" alt=\"sg-11134202-22110-c4tlvg3a9gkv6b\" /\u003e\u003c/p\u003e\n\u003cp\u003eCông dụng các sản phẩm trong hộp quà tặng Kingdom Herb:\u003c/p\u003e\n\u003cp\u003e- Giúp ngủ ngon và ngủ sâu hơn trong vòng 1 tuần\u003cbr /\u003e- Tăng sức đề kháng, ổn định hệ tiêu hóa, cân bằng lượng acid trong dạ dày\u003cbr /\u003e- Mật ong ngâm saffron sở hữu đặc tính chống oxi hóa mạnh từ 2 nguyên liệu chính, giúp da đàn hồi và ngăn ngừa lão hóa\u003cbr /\u003e- Cải thiện chức năng não bộ, tăng cường trí nhớ, chống trầm cảm và Alzheimer\u003cbr /\u003e- Giúp kiểm soát tốt lượng cholesterol trong máu\u003cbr /\u003e- Kiểm soát huyết áp, cải thiện sức khỏe tim mạch\u003cbr /\u003e- Hỗ trợ chống ung thư và bảo vệ thần kinh, thúc đẩy sự hình thành và sửa chữa các tế bào\u003cbr /\u003e- Bổ sung năng lượng cho cơ thể, không còn trạng thái uể oải và mệt mỏi\u003cbr /\u003e- Cải thiện chức năng sinh lý\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://cf.shopee.vn/file/sg-11134202-22110-qv7il46b9gkv05\" alt=\"bộ quà tặng\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eCam kết với khách hàng:\u003c/p\u003e\n\u003cp\u003e- Sản phẩm chất lượng cao, cam kết hàng chính hãng 100%\u003cbr /\u003e- Date các sản phẩm được tặng luôn mới\u003cbr /\u003e- Đầy đủ giấy tờ xuất xứ, chứng nhận chất lượng Organic\u003cbr /\u003e- Phát hiện hàng giả bồi thường 500%\u003cbr /\u003e- Với hộp bảo vệ và vật liệu chống sốc dày dặn kèm cách đóng gói chuyên nghiệp, Kingdom Herb tự tin quà tặng khách hàng nhận được sẽ luôn chỉnh chu về hình thức, không bị móp méo và đảm bảo về chất lượng\u003c/p\u003e\n\u003cp\u003eCách dùng saffron mật ong và táo đỏ / kỷ tử Kingdom Herb:\u003c/p\u003e\n\u003cp\u003e1. Một ngày uống 2 lần vào sáng và tối sau khi ăn no. Mỗi lần cho từ 1-2 muỗng cà phê saffron ngâm mật ong và 5-6 lát táo đỏ hoặc 10-15 quả kỷ tử vào 200-300 ml nước ấm (khoảng 70 độ), trà thảo mộc, nước trái cây... Chờ khoảng 5-10 phút có thể sử dụng.\u003cbr /\u003e2. Trộn 1 muỗng cà phê safaron mật ong với sữa chua không đường hoặc sữa tươi làm mặt nạ để đắp mặt\u003c/p\u003e\n\u003cp\u003e*Bảo quản nơi khô ráo, tránh nơi ẩm thấp hoặc có ánh sáng mặt trời trực tiếp\u003cbr /\u003e*Lưu ý: không sử dụng cho phụ nữ đang mang thai, trẻ em dưới 2 tuổi và người bị tiểu đường\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://cf.shopee.vn/file/sg-11134202-22110-21ixkesc9gkv70\" alt=\"hộp quà tết\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e#saffron #nhuy #hoa #nghe #tay #nhi #nhuyhoang