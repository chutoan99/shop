g nhôm dày dặn có độ bền cao, giúp ngăn dầu mỡ, mắm muối bắn vào motor và các linh kiện khác gây hỏng hóc, giảm tuổi thọ sản phẩm và cấu tạo ống thoát khí cao cấp dài 220mm.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/b5/10/bc/68018e44d54c9963e7652d4a30609728.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b5/10/bc/68018e44d54c9963e7652d4a30609728.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b5/10/bc/68018e44d54c9963e7652d4a30609728.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b5/10/bc/68018e44d54c9963e7652d4a30609728.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b5/10/bc/68018e44d54c9963e7652d4a30609728.jpg"}],"warranty_policy":null,"brand":{"id":41048,"name":"Sunhouse","slug":"sunhouse"},"current_seller":{"id":23395,"sku":"5917096235214","name":"TTTShop","link":"https://tiki.vn/cua-hang/tttshop","logo":"","price":1690000,"product_id":"70905472","store_id":22803,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[{"id":11119,"name":"GIA DỤNG VIỆT","link":"https://tiki.vn/cua-hang/nguyen-van-thang","logo":"47/20/4f/9800dd1b2ca67db582030ded1dc700b3.png","price":1603000,"product_id":"11756504","store_id":10842},{"id":11580,"name":"Cửa Hàng Gas Hà Thành","link":"https://tiki.vn/cua-hang/cua-hang-gas-ha-thanh","logo":"","price":2450000,"product_id":"23464439","store_id":11292},{"id":65797,"name":"GREENBOX","link":"https://tiki.vn/cua-hang/greenbox","logo":"2d/a9/35/ab93a840ca8293dafbe6695c28717810.png","price":1540000,"product_id":"48322982","store_id":61693},{"id"