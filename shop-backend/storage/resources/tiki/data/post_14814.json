6/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":238000,"discount_rate":40,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/b9/78/64/d535c67b28e357e394025d2a113409a5.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":882,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\n  \u003cp\u003e Gel chống nắng Naris Purece có tốt không?\u003c/p\u003e\n   \u003cp\u003e- Gel chống nắng Naris Purece Body Mild Watery UV Gel dịu nhẹ cho da nhạy cảm, với chiết xuất 7 loại thảo dược thiên nhiên giúp bảo vệ da, chống lại tác hại từ tia tử ngoại gây tổn thương cho làn da, không nhờn dính, luôn khô thoáng khi sử dụng.\u003c/p\u003e\n   \u003cp\u003e- Không trôi trong nước và mồ hôi, thẩm thấu nhanh, mang đến cảm giác ẩm mịn, thoáng mát cho làn da khi sử dụng.\u003c/p\u003e\n   \u003cp\u003e Thành phần 100% thiên nhiên\u003c/p\u003e\n   \u003cp\u003eCúc kim tiền: có tác dụng làm lành vết thương, làm dịu da.\u003c/p\u003e\n   \u003cp\u003eHoa ngô, Hoa Cỏ Bàng, Bạc Hà: làm dịu mát da, ngăn ngừa kích ứng do ánh nắng mặt trời, dưỡng ẩm sâu cho da.\u003c/p\u003e\n   \u003cp\u003eCây bạch quả: chống lão hóa, nổi bật trong khả năng bảo vệ da trước tia UV tối ưu.\u003c/p\u003e\n   \u003cp\u003eCúc La Mã: hỗ trợ tế bào da tiêu diệt các tác nhân gây dị ứng, từ đó ngăn ngừa ê da, mẩn ngứa, dị ứng hiệu quả.\u003c/p\u003e\n   \u003cp\u003eHoa cúc: làm dịu những làn da nhạy cảm.\u003c/p\u003e\n   \u003cp\u003e Kem chống nắng dành cho Trẻ Em từ 3 - 4 - 5 - 6 -7 - 12 - 15 tuổi, những người có da nhạy cảm.\u003c/p\u003e\n   \u003cp\u003e- Chống nắng Naris Purece dạng gel trong không màu mang lại cảm giác dịu nhẹ, thoáng mát và ẩm mịn cho làn da khi sử dụng.\u003c/p\u003e\n   \u003cp\u003e- Thiết kế dạng vòi nhấn tiện lợi và an toàn vệ sinh cho người sử dụng.\u003c/p\u003e\n   \u003cp\u003e- Sản phẩm sử dụng cho cả mặt và body.\u003c/p\u003e\n   \u003cp\u003e- Gel chống nắng Naris Purece phù hợp với trẻ nhỏ và những đối tượng có làn da nhạy cảm.\u003c/p\u003e\n   \u003cp\u003eHạn sử dụng: 5 năm kể từ ngày sản xuất\u003c/p\u003e\n   \u003cp\u003eXuất xứ: Nhật Bản\u003c/p\u003e\n   \u003cp\u003eQuy cách đóng gói: Chai\u003c/p\u003e\n   \u003cp\u003eDung tích: 180 ml\u003c/p\u003e\n   \u003cp\u003e Công dụng:\u003c/p\u003e\n   \u003cp\u003ePurec’e UV Gel SPF30/ PA+++ chống nắng bảo vệ da trước tia cực tím.\u003c/p\u003e\n   \u003cp\u003eLàm sạch, dưỡng ẩm và bảo vệ da khỏi các tác động từ bên ngoài.\u003c/p\u003e\n   \u003cp\u003e Hướng dẫn sử dụng:\u003c/p\u003e\n   \u003cp\u003eBước 1: lấy một lượng gel vừa đủ ra lòng bàn tay.\u003c/p\u003e\n   \u003cp\u003eBước 2: thoa đều lên da trước khi ra nắng từ 15 - 30 phút.\u003c/p\u003e\n   \u003cp\u003eBảo quản: nơi khô ráo, thoáng mát, tránh ánh nắng trực tiếp và nhiệt độ cao\u003c/p\u003e\n   \u003cp\u003e Thương hiệu mỹ phẩm Naris:\u003c/p\u003e\n   \u003cp\u003eCho đến nay, mỹ phẩm Naris đã có mặt trên khắp thế giới, từ Châu Á đến Châu Âu, Châu Úc hay Châu Mỹ.\u003c/p\u003e\n   \u003cp\u003eNaris luôn là cái tên được ưa chuộng và là sự lựa chọn hàng đầu của những người yêu cái đẹp với phương châm “Naris – bí quyết để giữ và duy trì làn da khỏe đẹp”.\u003c/p\u003e\n  \u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/b9/78/64/d535c67b28e357e394025d2a113409a5.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b9/78/64/d535c67b28e357e394025d2a113409a5.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b9/78/64/d535c67b28e357e394025d2a113409a5.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b9/78/64/d535c67b28e357e394025d2a113409a5.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b9/78/64/d535c67b28e357e394025d2a113409a5.png"},{"base_url":"https://salt.tikicdn.com/ts/product/22/59/42/3bf6beff56da191409268064bd58a5dd.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/22/59/42/3bf6beff56da191409268064bd58a5dd.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/22/59/42/3bf6beff56da191409268064bd58a5dd.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/22/59/42/3bf6beff56da191409268064bd58a5dd.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/22/59/42/3bf6beff56da191409268064bd58a5dd.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/22/59/42/89d937669aac8b23d9bd82415c8430cc.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/22/59/42/89d937669aac8b23d9bd82415c8430cc.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/22/59/42/89d937669aac8b23d9bd82415c8430cc.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/22/59/42/89d937669aac8b23d9bd82415c8430cc.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/22/59/42/89d937669aac8b23d9bd82415c8430cc.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/9b/b2/d9/589268c8bdcfc4df7edb117da51e7000.jpg