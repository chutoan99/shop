ad/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.1,"review_count":53,"review_text":"(53)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/1a/dd/57/0f43b924c07bac2ff7cd3d5a0863ea4d.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":578,"all_time_quantity_sold":258,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cdiv class=\"com-struct\"\u003e\n\u003cdiv class=\"com-struct\"\u003e\n\u003cdiv class=\"J_module\"\u003e\n\u003cdiv class=\"module-detailImageText\"\u003e\n\u003cp\u003eThành phần: Thành phần tự nhiên lành tính, thân thiện với môi trường. Chiết xuất từ nhân sâm đen (hắc sâm) và các thành phần tự nhiên, an toàn cho da đầu.\u003c/p\u003e\n\u003cp\u003eCông dụng dầu gội phủ bạc Hắc Sâm Mộc Nhu:\u003c/p\u003e\n\u003cp\u003e- Cung cấp Collagen tươi giúp tóc mềm mượt hơn\u003c/p\u003e\n\u003cp\u003e- Phủ bạc tóc nhanh chóng chỉ sau một lần gội\u003c/p\u003e\n\u003cp\u003e- Kích thích tóc mọc nhiều và nhanh, trả lại cho bạn một mái tóc đen hơn và dày hơn\u003c/p\u003e\n\u003cp\u003e- Giúp dưỡng tóc, phục hồi mái tóc hư tổn do nhuộm hóa chất, tẩy tóc, tạo kiểu…\u003c/p\u003e\n\u003cp\u003e- Dưỡng tóc chuyên sâu từ bên trong giúp ngăn ngừa tình trạng gãy rụng tóc\u003c/p\u003e\n\u003cp\u003e- Độ bền màu: Giữ được màu cho đến khi tóc mọc ra lớp mới\u003c/p\u003e\n\u003cp\u003e- Đối tượng sử dụng: Nam, nữ thanh niên bị bạc tóc, người trung niên.\u003c/p\u003e\n\u003cp\u003eCách sử dụng dầu gội phủ bạc Hắc Sâm Mộc Nhu vô cùng đơn giản:\u003c/p\u003e\n\u003cp\u003eBước 1: Cho một lượng vừa đủ dầu gội ra tay\u003c/p\u003e\n\u003cp\u003eBước 2: Để tóc khô hoặc ẩm, sau đó thoa dầu gội phủ bạc Hắc Sâm Mộc Nhu lên tóc dùng lược chải đều và massage da đầu để tạo bọt trong vòng 10 – 15 phút\u003c/p\u003e\n\u003cp\u003eBước 3: xả lại tóc với nước, lúc này tóc đã đen bóng và thơm mùi thảo dược\u003c/p\u003e\n\u003cp\u003eChỉ ngay lần đầu sử dụng bạn sẽ được sở hữu ngay mái tóc đen mềm mượt như ý\u003c/p\u003e\n\u003cp\u003eTóc sau khi gội sẽ được đổi màu theo ý muốn (nâu hoặc đen), không gây tình trạng khô cứng thay vào đó tóc sẽ mềm mượt hơn.\u003c/p\u003e\n\u003cp\u003eLưu ý khi sử dụng:\u003c/p\u003e\n\u003cp\u003eKhi gội, bạn chỉ nên dùng tay massage nhẹ nhàng vùng da đầu, tránh cào nhiều sẽ làm tổn thương vùng da đầu\u003c/p\u003e\n\u003cp\u003eSau khi sử dụng nên đậy nắp thật chặt, bảo quản nơi khô thoáng, tránh để ánh nắng chiếu trực tiếp lên sản phẩm\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/d4/eb/49/de696e3ecc09fb2acf0066f69cefb56c.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/3e/b7/33/286fc1c90a2044bb15d3e3fb995d195a.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/cd/ca/eb/1646289dd33751189d4f13369ce81a15.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/15/a3/60/51477acd4dd76f52852fe8b5c7ddfc2e.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/1a/dd/57/0f43b924c07bac2ff7cd3d5a0863ea4d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/1a/dd/57/0f43b924c07bac2ff7cd3d5a0863ea4d.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/1a/dd/57/0f43b924c07bac2ff7cd3d5a0863ea4d.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1a/dd/57/0f43b924c07bac2ff7cd3d5a0863ea4d.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1a/dd/57/0f43b924c07bac2ff7cd3d5a0863ea4d.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/29/bd/d2/c0b31c1fccce7ae14c10dc065eb3e6bf.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/29/bd/d2/c0b31c1fccce7ae14c10dc065eb3e6bf.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/29/bd/d2/c0b31c1fccce7ae14c10dc065eb3e6bf.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/29/bd/d2/c0b31c1fccce7ae14c10dc065eb3e6bf.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/29/bd/d2/c0b31c1fccce7ae14c10dc065eb3e6bf.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/0b/0f/15/53f76d7190984ae1875c4394dd3edcfe.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0b/0f/15/53f76d7190984ae1875c4394dd3edcfe.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/0b/0f/15/53f76d7190984ae1875c4394dd3edcfe.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0b/0f/15/53f76d7190984ae1875c4394dd3edcfe.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0b/0f/15/53f76d7190984ae1875c4394dd3edcfe.png"},{"base_url":"https://salt.tikicdn.com/ts/product/3e/b7/33/71e234e12427a4dc70fe003742fa377f.jpg","is_gallery":true,"label":null