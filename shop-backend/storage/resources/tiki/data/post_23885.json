 sản phẩm.\u003c/p\u003e\n\u003cp\u003e+ Hướng dẫn bảo quản: Bảo quản nơi khô ráo, thoáng mát, tránh ánh nắng trực tiếp từ mặt trời. Để xa tầm tay trẻ em.\u003c/p\u003e\n\u003cp\u003e+ Ngày sản xuất/ Hạn sử dụng: Xem trên bao bì sản phẩm\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/39/fe/61/a354c64191791ec298953ca846ba9cda.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/39/fe/61/a354c64191791ec298953ca846ba9cda.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/39/fe/61/a354c64191791ec298953ca846ba9cda.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/39/fe/61/a354c64191791ec298953ca846ba9cda.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/39/fe/61/a354c64191791ec298953ca846ba9cda.png"},{"base_url":"https://salt.tikicdn.com/ts/product/04/f0/c2/64cc40bbe390611ea6f256e78762418f.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/04/f0/c2/64cc40bbe390611ea6f256e78762418f.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/04/f0/c2/64cc40bbe390611ea6f256e78762418f.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/04/f0/c2/64cc40bbe390611ea6f256e78762418f.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/04/f0/c2/64cc40bbe390611ea6f256e78762418f.jpg"}],"warranty_policy":null,"brand":{"id":5224099,"name":"Mediphar+","slug":"mediphar+"},"current_seller":{"id":153397,"sku":"7884217516596","name":"Baby Shop 1820","link":"https://tiki.vn/cua-hang/baby-shop-1820","logo":"","price":430000,"product_id"