e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":11,"review_text":"(11)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/65/d5/e7/655d0eeff92239b23fd6d1258cfddf93.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1490,"all_time_quantity_sold":86,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eThức ăn cho chó con Ganador vị Trứng và Sữa - Egg and Milk 3kg\u003cbr /\u003eQuy cách đóng gói: 1 gói x 3kg\u003c/p\u003e\n\u003cp\u003eGanador là nhãn hiệu thức ăn cho chó cưng được sản xuất bởi Tập đoàn Neovia với gần 60 năm kinh nghiệm trong lĩnh vực dinh dưỡng và chăm sóc thú cưng. Công thức sản phẩm là tâm huyết nghiên cứu của các chuyên gia dinh dưỡng vật nuôi hàng đầu tại Pháp với mong muốn cung cấp cho chó cưng hàm lượng dinh dưỡng cân bằng và đầy đủ nhất, giúp chúng có một cuộc sống thật khỏe mạnh và năng động. Mỗi sản phẩm của chúng tôi được sản xuất từ những nguyên liệu chất lượng cao như thịt thật và gạo/cơm, tuân thủ nghiêm ngặt hệ thống tiêu chuẩn quốc tế của Ngành sản xuất thức ăn Chăn nuôi Hoa Kỳ (AAFCO).\u003cbr /\u003eSản phẩm Ganador đảm bảo chó cưng được nuôi dưỡng đầy đủ cả về thể chất lẫn tinh thần để chúng luôn có một cuộc sống mạnh khỏe, dài lâu và hạnh phúc bên bạn.\u003cbr /\u003eChứa các vitamin giúp tăng cường đề kháng tự nhiên cho chó con\u003cbr /\u003eCông thức cân bằng protein, canxi và phốt pho giúp phát triển xương và cơ bắp chắc khoẻ\u003cbr /\u003eGanador chứa các thành phần giúp cải thiện vấn đề tiêu hoá nhạy cảm của chó\u003c/p\u003e\n\u003cp\u003eThành phần: Ngũ cốc nguyên hạt( lúa mì, ngô, gạo) bột gia cầm, bã nành, cám lúa mì, mỡ gia cầm, sữa bột, bột trứng,  khoáng chất (sắt, đòng mangan, kẽm, lốt, selen), vitamin (A, D3, K3, B1, B2, B6, B12, PP, E, Tocopherol), Canxi D-Pantothenate, Biotin, Axit Filoic, Choline0, Dicalclum, Phosphate, Canxi Caribonate, Natri clorua, Chất bảo quản, chất chống oxi hóa, màu thực phẩm, chất làm ngon miệng, hương vị sữa, chiết xuất Yucca Schidigera. \u003c/p\u003e\n\u003cp\u003eXuất xứ: Việt Nam\u003cbr /\u003eHSD: 1 năm kể từ ngày sản xuất \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/fc/18/84/e491b5e4822a8b82591b742c120f64ee.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/78/41/c4/a51bc415cbe190aed9991b2d5f911d79.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/65/d5/e7/655d0eeff92239b23fd6d1258cfddf93.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/65/d5/e7/655d0eeff92239b23fd6d1258cfddf93.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/65/d5/e7/655d0eeff92239b23fd6d1258cfddf93.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/65/d5/e7/655d0eeff92239b23fd6d1258cfddf93.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/65/d5/e7/655d0eeff92239b23fd6d1258cfddf93.jpg"},{"base_url":"https://salt.tikicdn.com/ts/pro