,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":21000,"discount_rate":23,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/6d/cc/09/386e1c9eee46e57a6dd98c4dc0c1423e.jpeg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":195,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eTHÔNG TIN TÁC PHẨM\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eTên tác phẩm: Sống Mòn\u003c/li\u003e\n\u003cli\u003eTác giả/Dịch giả: Nam Cao\u003c/li\u003e\n\u003cli\u003eThương hiệu: SBOOKS\u003c/li\u003e\n\u003cli\u003eNhà xuất bản: NXB Văn Học\u003c/li\u003e\n\u003cli\u003eNăm xuất bản: 2024\u003c/li\u003e\n\u003cli\u003eLoại bìa: Bìa mềm\u003c/li\u003e\n\u003cli\u003eKhổ: 12x18(cm)\u003c/li\u003e\n\u003cli\u003eSố trang: 288\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e________________________\u003c/p\u003e\n\u003cp\u003eGIỚI THIỆU TÁC PHẨM\u003c/p\u003e\n\u003cdiv class=\"syl-image-wrapper\"\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/20/b9/5e/6458da6151a7c788fd848d7544f0be86.jpeg?from=476444299\" width=\"750\" height=\"750\" alt=\"054d2ca262904309987fac492197b043~tplv-o3syd03w52-origin-jpeg.jpeg?from=476444299\" /\u003e\u003c/div\u003e\n\u003cp\u003eNhà văn Nam Cao (1915-1951) là một nhà văn lớn của nền văn xuôi hiện đại Việt Nam. Với quan điểm nghệ thuật vị nhân sinh luôn là ngọn đèn soi sáng trong những sáng tác văn chương của ông, những tác phẩm của Nam Cao đều tập trung vào đối tượng người nông dân nghèo và tầng lớp trí thức nghèo và tái hiện chân thực xã hội lúc bấy giờ; đồng thời đi sâu vào nội tâm nhân vật, từ đó làm nổi bật lên giá trị hiện thực và nhân đạo sâu sắc.\u003c/p\u003e\n\u003cp\u003e\u003cem\u003eSống mòn\u003c/em\u003e là tiểu thuyết được sáng tác vào năm 1944, tiểu thuyết kể về nhân vật Thứ, một chàng trí thức nghèo mang nhiều hoài bão nhưng cái nghèo đói đã bủa vây và vùi dập cuộc đời của Thứ và những thân phận khác; chính cái nghèo cũng là thứ khiến tâm hồn họ chết mòn từng ngày. Đọc Sống mòn người ta cảm nhận được sự ảm đạm, ngột ngạt của cái nghèo đói và nghẹn ngào với những kiếp người bất hạnh.\u003c/p\u003e\n\u003cp\u003e“Bản tính cốt yếu của sự sống chính là cảm giác và tư tưởng. Cảm giác càng mạnh, càng linh diệu, tư tưởng càng dồi dào, càng sâu sắc, càng sáng suốt thì sự sống càng cao.” \u003c/p\u003e\n\u003cp\u003e(Trích \u003cem\u003eSống mòn\u003c/em\u003e)\u003c/p\u003e\n\u003cp\u003e______________________\u003c/p\u003e\n\u003cp\u003eSBOOKS CAM KẾT:\u003c/p\u003e\n\u003cp\u003e- Mọi đơn hàng đều được đóng gói tỉ mỉ và cẩn thận.\u003c/p\u003e\n\u003cp\u003e- Sbooks luôn có chương trình tốt cho mọi đơn hàng.\u003c/p\u003e\n\u003cp\u003e- Đổi trả sản phẩm trong vòng 7 ngày nếu lỗi từ nhà sản xuất.\u003c/p\u003e\n\u003cp\u003e______________________\u003c/p\u003e\n\u003cp\u003eSỨ MỆNH:\u003c/p\u003e\n\u003cp\u003e- Sbooks được hình thành bởi sứ mệnh lan tỏa trí tuệ đến với mọi người.\u003c/p\u003e\n\u003cp\u003e- Sbooks luôn hi vọng mỗi sản phẩm được quý khách hàng lựa chọn sẽ mang lại nhiều giá trị cho bản thân.\u003c/p\u003e\n\u003cp\u003e*****************\u003c/p\u003e\n\u003cp\u003eSbooks biết rằng người đọc có rất nhiều sự lựa chọn nhưng lại dành sự lựa chọn đó cho Sbooks, Sbooks xin chân thành cảm ơn sâu sắc đến người đọc. Chúc Quý Khách Hàng có 1 ngày mua sắm vui vẻ ^^!!!\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/6d/cc/09/386e1c9eee46e57a6dd98c4dc0c1423e.jpeg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/6d/cc/09/386e1c9eee46e57a6dd98c4dc0c1423e.jpeg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/6d/cc/09/386e1c9eee46e57a6dd98c4dc0c1423e.jpeg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6d/cc/09/386e1c9eee46e57a6dd98c4dc0c1423e.jpeg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6d/cc/09/386e1c9eee46e57a6dd98c4dc0c1423e.jpeg"},{"base_url":"https://salt.tikicdn.com/ts/product/0a/00/72/907a7d8142b89cd7fed6720bc56f706f.jpeg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0a/00/72/907a7d8142b89cd7fed6720bc56f706f.jpeg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/0a/00/72/907a7d8142b89cd7fed6720bc56f706f.jpeg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0a/00/72/907a7d8142b89cd7fed6720bc56f706f.jpeg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0a/00/72/907a7d8142b89cd7fed6720bc56f706f.jpeg"},{"base_url":"https://salt.tikicdn.com/ts/product/20/b9/5e/64bd8bd703cd338a98828cb0494696a3.jpeg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/20/b9/5e/64bd8bd703cd338a98828cb0494696a3.jpeg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/20/b9/5e/64bd8bd703cd338a98828cb0494696a3.jpeg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/20/b9/5e/64bd8bd703cd338a98828cb0494696a3.jpeg","thumbnail_url":"https://salt.tik