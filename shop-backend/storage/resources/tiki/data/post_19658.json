text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":73000,"discount_rate":46,"rating_average":4.8,"review_count":66,"review_text":"(66)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/4f/05/81/3cf04989d12caefb1ab5828a1febf3e0.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1065,"all_time_quantity_sold":290,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eDung dịch vệ sinh phụ nữ Intima Ziaja \u003cbr /\u003eINTIMA - CHUYÊN GIA HÀNG ĐẦU CHĂM SÓC VÙNG NHẠY CẢM- Dòng sản phẩm do hãng Dược - Mỹ phẩm Ziaja sản xuất. Không chỉ chiếm thị phần lớn tại Châu Âu, Anh, Pháp, Mỹ, Intima đã nhanh chóng có mặt tại Việt Nam để mang lại sự tự tin, thoải mái cho phụ nữ Việt\u003cbr /\u003eIntima là sản phẩm Dung dịch vệ sinh phụ nữ duy nhất được Hội phụ sản khoa Việt Nam khuyên dùng.\u003cbr /\u003e==============================\u003cbr /\u003eCông dụng: \u003cbr /\u003e+ Vệ sinh hàng ngày: dành cho mọi đối tượng, không phân biệt lứa tuổi và giới tính. Thích hợp vệ sinh thân thể (tắm, rửa) đối với các trường hợp bị bệnh ngoài Da, đang điều trị và sau khi điều trị các bệnh ngoài Da, Da dễ bị kích ứng, Da dị ứng với xà phòng. Sản phẩm có tác dụng dưỡng ẩm sâu cho Da, làm sạch Da, đem lại cảm giác tươi mới và giữ lại mùi hương tinh khiết trên Da. \u003cbr /\u003e+ Đặc biệt sản phẩm rất tốt dùng chăm sóc cơ thể Phụ nữ, Phụ nữ sau sinh và các bệnh nhân có bệnh ngoài Da do tác động làm sạch rất nhẹ nhàng của các thành phần có trong công thức sản phẩm. \u003cbr /\u003e+ Vệ sinh phụ khoa: rửa sạch nhẹ nhàng phần phụ, khử hoàn toàn hết mùi hôi khó chịu, đem lại cảm giác tươi mát, giữ vững độ cân bằng pH sinh lý tự nhiên, ổn định hệ kháng khuẩn và gia tăng khả năng đề kháng của màng nhầy. \u003cbr /\u003e+ Làm lành nhanh các tổn thương, chống viêm, chống nhiễm khuẩn trong phụ khoa. \u003cbr /\u003e+ Sản phẩm chăm sóc đặc biệt nhẹ nhàng do không chứa xà phòng.\u003cbr /\u003eHướng dẫn sử dụng:\u003cbr /\u003e+ Lấy một lượng vừa đủ ra tay hoặc bông tắm, xoa đều nhẹ nhàng, sau đó rửa lại bằng nước. \u003cbr /\u003e+ Có thể sử dụng vài lần trong ngày tùy theo nhu cầu. \u003cbr /\u003eMÀU XANH ĐẬM - KHÔ : bổ sung Axit Hyaluronic: có khả năng hydrat hóa sâu và hiệu quả dưỡng ẩm và giữ ẩm lâu (dưỡng ẩm)\u003cbr /\u003eMÀU HỒNG - VIÊM NHẸ bổ sung Axit Lactic : Trong phần phụ sự cân bằng sinh học tự nhiên được duy trì bởi hệ thực vật gồm Lactobacillus. Thực vật này tạo ra axit lactic trong đó duy trì độ acid của môi trường vùng kín. Vì lý do này, các axit lactic là quan trọng trong việc vệ sinh thân mật. Nó giúp kiểm soát cân bằng độ pH của âm đạo, và do đó cung cấp bảo vệ chống kích ứng, ngứa, nhiễm trùng.\u003c/p\u003e\n\u003cp\u003e+ MÀU CAM - CHỐNG VIÊM: bổ sung Axit Ascorbic: Axit Ascorbic (VitC) tham gia vào quá trình hình thành collagen, bảo vệ các tế bào Da, tăng cường khả năng chống viêm, nhiễm khuẩn\u003c/p\u003e\n\u003cp\u003eMÀU XANH NHẠT - VIÊM: bổ sung Axit Lactobionic : Chuyên chăm sóc khu vực da nhạy cảm, ngay cả khi lớp da đó đang bị hư tổn dẫn đến việc viêm nhiễm. Nó vừa dưỡng ẩm vừa tái tạo Da và tăng cường chức năng của hàng rào bảo vệ Da.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/6a/6c/35/1721b67e38dc1dc80bf8e67fda9c880d.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/b4/59/69/a4eaa03903512ef0fd8f505f66269942.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/3e/ed/59/cb1298370a10abcb26