or":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/09/cf/97/73d04a67ccb84205e958060498f8a4b8.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1356,"all_time_quantity_sold":4,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eChống nắng phổ rộng bảo vệ da khỏi tia UV và ô nhiễm\u003cbr /\u003eKhông chứa hương liệu, không paraben, tuyệt đối an toàn với da.\u003cbr /\u003eKhông gây bết dính và không để lại vệt trắng, không gây bóng nhờn\u003cbr /\u003eLâu trôi khi sử dụng dưới nước\u003cbr /\u003eKết cấu dạng lỏng khô thoáng\u003cbr /\u003eThích hợp cho da dầu nhạy cảm\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eBao bì sản phẩm sẽ thay đổi tùy từng đợt sản xuất\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eVới mục tiêu chung tay bảo vệ môi trường, từ tuần 3 tháng 8 các sản phẩm của La Roche-Posay sẽ thay màng co bằng tem niêm phong trên nắp và đáy hộp.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eKem Chống Nắng Kiểm Soát Dầu Có Màu La Roche-Posay Anthelios XL Tinted Dry Touch Gel-Cream SPF 50+ UVB \u0026amp; UVA 50ml\u003c/strong\u003e có độ bảo vệ cao nhất SPF 50+ bảo vệ da trước những tác hại từ tia nắng mặt trời và khói bụi ô nhiễm, giúp da ngăn chặn các tác nhân gây lão hóa sớm, đốm nâu, kích ứng da. Công thức chống thấm nước thích hợp dùng hàng ngày và cả những hoạt động ngoài trời, để bạn luôn tự tin tỏa sáng. Kem chống nắng có màu giúp làm đều màu da với kết cấu lỏng nhẹ, khô thoáng, kiểm soát dầu, không gây bết dính và bóng nhờn.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCông dụng\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Da được bảo vệ tối ưu khỏi tia UVA, UVB, tia hồng ngoại \u0026amp; tác hại từ ô nhiễm.\u003c/p\u003e\n\u003cp\u003e- Khô thoáng tức thì nhưng không làm quá khô bề mặt da.\u003c/p\u003e\n\u003cp\u003e- Kết cấu dạng lỏng khô thoáng, không gây bóng nhờn.\u003c/p\u003e\n\u003cp\u003e- Lâu trôi khi sử dụng dưới nước.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCông thức\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Công nghệ XL-PROTECT TM chống nắng tối ưu – bảo vệ da trước tia UVA-UVB, tia hồng ngoại \u0026amp; tác hại từ ô nhiễm, kết hợp với nước khoáng La Roche-Posay giúp làm dịu và chống oxy hoá.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTiêu chuẩn chất lượng\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Không chứa hương liệu, không paraben, tuyệt đối an toàn với da.\u003c/p\u003e\n\u003cp\u003e- Không gây bết dính và không để lại vệt trắng.\u003c/p\u003e\n\u003cp\u003e- Không gây mụn trứng cá, không gây kích ứng hay dị ứng với bất cứ loại da nào.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eĐối tượng sử dụng\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Dành cho da dầu \u0026amp; nhạy cảm.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eHướng dẫn sử dụng\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Thoa kem trước khi tiếp xúc với ánh nắng 20 phút.\u003c/p\u003e\n\u003cp\u003e- Lấy một lượng sản phẩm vừa đủ và chấm 5 điểm trên mặt (trán, mũi, cằm và hai bên má) sau đó thoa sản phẩm theo chiều từ trong ra ngoài và trên xuống dưới.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThông tin thương hiệu\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eLa Roche-Posay là thương hiệu dược mỹ phẩm hàng đầu của Pháp về các sản phẩm chăm sóc chuyên sâu cho da dầu, da mụn, da cực kỳ nhạy cảm và hỗ trợ điều trị các bệnh lý về da. Sản phẩm có thành phần chính là nguồn nước khoáng thần kì tại làng La Roche-Posay, giàu selenium tự nhiên, có khả năng chống oxy hoá, giảm kích ứng và làm dịu da tức thời. Tất cả sản phẩm đều được thử nghiệm lâm sàng với quy trình bào chế nghiêm ngặt từ viện nghiên cứu da liễu nổi tiếng quốc tế, đảm bảo mang lại sự hiệu quả và an toàn khi sử dụng.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/09/cf/97/73d04a67ccb84205e958060498f8a4b8.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/09/cf/97/73d04a67ccb84205e958060498f8a4b8.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/09/cf/97/73d04a67ccb84205e958060498f8a4b8.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/09/cf/97/73d04a67ccb84205e958060498f8a4b8.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/09/cf/97/73d04a67ccb84205e958060498f8a4b8.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/f8/f9/5f/ddcbd5c56cd95188fb09eec1dda47eb0.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f8/f9/5f/ddcbd5c56cd95188fb09eec1dda47eb0.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f8/f9/5f/ddcbd5c56