idth":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/9e/19/d1/2d351334dad379ce130d24e96cd851cd.jpeg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":939,"all_time_quantity_sold":30,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2 style=\"text-align: center;\"\u003eCombo 5 cuốn Truyện kể cho bé trước giờ đi ngủ\u003c/h2\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/9e/19/d1/0dae1798160a7d834fdb00a01d8ca459.jpeg\" alt=\"truyện kể cho bé trước giờ đi ngủ\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eVượt xa giá trị của một cuốn sách, kể chuyện cùng con trước giờ đi ngủ không chỉ là hoạt động để gắn kết ba mẹ và con, đây còn là sự nuôi dưỡng phẩm chất, cảm xúc trong tiềm thức được các nhà giáo dục đánh giá rất cao đó ba mẹ ạ!\u003c/p\u003e\n\u003cp\u003eTheo nghiên cứu khoa học, lúc trẻ chập chờn vào giấc ngủ, mọi thông tin trẻ nghe sẽ được lưu giữ hoàn toàn vô thức vào não bộ. Vì vậy, khi con tiếp nhận những lời thủ thỉ lúc chúng vừa ngủ, những lời tâm tình này dễ dàng đi vào tiềm thức của con, dần dần con sẽ ghi nhớ và khắc sâu. Các nhà giáo dục nổi tiếng của Nhật Bản như Shichida, Ibukai Masaru khuyên rằng trong khoảng thời gian này, ba mẹ kể con nghe những câu truyện nhẹ nhàng, ý nghĩa, nhân văn sẽ giúp con hình thành những phẩm chất mà sách mang lại.\u003c/p\u003e\n\u003ch2\u003eCombo sách gồm 5 cuốn truyện kể\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003eCuốn \u003cstrong\u003eRừng Xanh Rì Rào (Tái Bản Bìa Mềm)\u003c/strong\u003e: Cuốn sách về sự chia sẻ, tình bạn đầu đời của con và hơn thế nữa,\u003c/li\u003e\n\u003cli\u003eCuốn \u003cstrong\u003eHương của mùa Xuân\u003c/strong\u003e: Qua khứu giác của bạn Sâu Nhỏ, mùa xuân miền núi phía Bắc nước mình thơm ngào ngạt nào mùi hoa, mùi bánh, mùi hương ấm áp, hạnh phúc của không khí ngày Tết rộn ràng.\u003c/li\u003e\n\u003cli\u003eCuốn \u003cstrong\u003eThanh âm mùa Hạ\u003c/strong\u003e: Qua thính giác của bạn Ve Sầu, cậu đã tìm ra những âm thanh nào mà chỉ có mùa hạ mới có, mang đến niềm vui và năng lượng mới.\u003c/li\u003e\n\u003cli\u003eCuốn \u003cstrong\u003eSắc màu mùa Thu\u003c/strong\u003e: Hành trình khám phá một trong những mùa đẹp nhất trong năm bé sẽ được đồng hành cùng bạn Bồ Câu, qua thị giác xuất sắc của cậu, mùa thu trong trang sách hiện lên như một tác phẩm nghệ thuật đầy màu sắc và nhiều điều thú vị.\u003c/li\u003e\n\u003cli\u003eCuốn \u003cstrong\u003eVị của mùa Đông\u003c/strong\u003e: Với vị giác của anh em nhà Kiến, những hương vị ngọt ngào của mùa đông miền Bắc chắc chắn là một màn kết thúc trọn vẹn cho chuyến hành trình khám phá lần này đó các bạn nhỏ ơi!\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/9e/19/d1/2d351334dad379ce130d24e96cd851cd.jpeg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/9e/19/d1/2d351334dad379ce130d24e96cd851cd.jpeg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/9e/19/d1/2d351334dad379ce130d24e96c