":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"defective_product"}},"discount":210000,"discount_rate":8,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/97/05/84/7f6bff3465517e29d33e621b5e066887.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":557,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eNhóm Nước Hoa: Hương Gỗ Woody Spicy\u003c/p\u003e\n\u003cp\u003eGiới tính: Nam\u003c/p\u003e\n\u003cp\u003eNăm ra mắt: 2022\u003c/p\u003e\n\u003cp\u003eNồng độ: Eau De Parfum (EDP)\u003c/p\u003e\n\u003cp\u003ePhong Cách: Thu Hút, Sang Trọng, Mạnh Mẽ\u003c/p\u003e\n\u003cdiv\u003e\n\u003cdiv\u003e\n\u003cdiv\u003eHương đầu: Lá thông, Olibanum\u003cbr /\u003eHương giữa: Benzoin, Hương nhang\u003cbr /\u003eHương cuối: Gỗ Tuyết tùng Himalaya, Tuyết tùng Virginia.\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv\u003e\n\u003cp\u003eBurberry Hero Eau de Parfum mở ra cho ta khung cảnh của rừng thông Virginia, được thêm thắt bởi chi tiết của những đốm lửa trại và một chút gió thu len lỏi. Thế đó, dù mang cái tên Hero, nhưng Burberry Hero Eau de Parfum lại không hề mang cái vibe “vĩ đại” hay quá hoành tráng, mà ngược lại, ấm áp và đầy gần gũi.\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"aligncenter wp-image-43449\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/0e/13/84/4f36df48598a2f4a07a218e0a3560012.jpg\" alt=\"Burberry Hero Eau de Parfum 2 - N - Nước hoa cao cấp, chính hãng giá tốt, mẫu mới\" width=\"550\" height=\"688\" /\u003e\u003cbr /\u003eBurberry Hero Eau de Parfum mở đầu mùi hương của lá thông đưa lối ta tiến vào khu rừng. Lá thông kết hợp cùng hương nhũ hương Olibanum mang đến một mùi hăng hắc đặc trưng. Benzoin, mùi hương của nhựa cây, đậm đà và dày dặn, làm cho tầng hương giữa có phần tối màu hơn. Tầng hương cuối là một sự hòa quyện của những nốt hương gỗ tuyết tùng khác nhau, từ tuyết tùng Himalaya đến Virginia. Mỗi vùng đất sẽ góp nhặt tạo nên một loại tinh hoa khác biệt, khiến cho mùi hương của nước hoa Hero trở nên trầm lắng và có chiều sâu hơn, cứ mãi quanh quẩn trong tâm trí người dùng mà họ không thể nào quên được.\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/97/05/84/7f6bff3465517e29d33e621b5e066887.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/97/05/84/7f6bff3465517e29d33e621b5e066887.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/97/05/84/7f6bff3465517e29d33e621b5e066887.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/97/05/84/7f6bff3465517e29d33e621b5e066887.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/97/05/84/7f6bff3465517e29d33e621b5e066887.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/22/72/34/469eebc3f737d2b66f0a8f1d1d9a7108.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/22