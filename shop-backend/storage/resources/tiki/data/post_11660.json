c và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/cd/70/45/6d463b6a8fc02c22dbd1821f306b61cb.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/cd/70/45/6d463b6a8fc02c22dbd1821f306b61cb.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/cd/70/45/6d463b6a8fc02c22dbd1821f306b61cb.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/cd/70/45/6d463b6a8fc02c22dbd1821f306b61cb.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/cd/70/45/6d463b6a8fc02c22dbd1821f306b61cb.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/a2/ed/37/1e9d0e427c1d314b8f1e2e429d0239cc.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a2/ed/37/1e9d0e427c1d314b8f1e2e429d0239cc.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a2/ed/37/1e9d0e427c1d314b8f1e2e429d0239cc.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a2/ed/37/1e9d0e427c1d314b8f1e2e429d0239cc.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a2/ed/37/1e9d0e427c1d314b8f1e2e429d0239cc.jpg"}],"warranty_policy":null,"authors":[{"id":161113,"name":"Trung Tâm Nghiên Cứu Giáo Dục Và Chăm Sóc Việt Nam","slug":"trung-tam-nghien-cuu-giao-duc-va-cham-soc-viet-nam"}],"current_seller":{"id":1595,"sku":"7275214860631","name":"SAVINA","link":"https://tiki.vn/cua-hang/savina","logo":"c0/0e/3d/cb8bb80fa05370ae1de39bf2e60005fe.png","price":18000,"product_id":"4407371","store_id":1553,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Thông tin chung","attributes":[{"code":"publisher_vn","name":"Công ty phát hành","value":"Công ty Cổ phần Sách Việt Nam"},{"code":"