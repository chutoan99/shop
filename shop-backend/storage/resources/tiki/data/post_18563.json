 có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ad/84/65/708d9f82dd77f114bf77333a70b37b6b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ad/84/65/708d9f82dd77f114bf77333a70b37b6b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ad/84/65/708d9f82dd77f114bf77333a70b37b6b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ad/84/65/708d9f82dd77f114bf77333a70b37b6b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ad/84/65/708d9f82dd77f114bf77333a70b37b6b.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/92/dd/50/c275207cd24cf67687a0e69c31074d10.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/92/dd/50/c275207cd24cf67687a0e69c31074d10.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/92/dd/50/c275207cd24cf67687a0e69c31074d10.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/92/dd/50/c275207cd24cf67687a0e69c31074d10.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/92/dd/50/c275207cd24cf67687a0e69c31074d10.jpg"},{"base_url":"https://salt.tikicdn.com/media/catalog/producttmp/18/c6/53/8b7485b5ab88d7e2dd6367e9cb0b9c9c.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/producttmp/18/c6/53/8b7485b5ab88d7e2dd6367e9cb0b9c9c.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/producttmp/18/c6/53/8b7485b5ab88d7e2dd6367e9cb0b9c9c.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/producttmp/18/c6/53/8b7485b5ab88d7e2dd6367e9cb0b9c9c.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/producttmp/18/c6/53/8b7485b5ab88d7e2dd6367e9c