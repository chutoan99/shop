í hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/media/catalog/product/r/e/ren-luyen-nang-luc-giao-tieng-bang-so-do-tu-duy-1t.u5762.d20171030.t101916.726675.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/r/e/ren-luyen-nang-luc-giao-tieng-bang-so-do-tu-duy-1t.u5762.d20171030.t101916.726675.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/r/e/ren-luyen-nang-luc-giao-tieng-bang-so-do-tu-duy-1t.u5762.d20171030.t101916.726675.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/r/e/ren-luyen-nang-luc-giao-tieng-bang-so-do-tu-duy-1t.u5762.d20171030.t101916.726675.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/r/e/ren-luyen-nang-luc-giao-tieng-bang-so-do-tu-duy-1t.u5762.d20171030.t101916.726675.jpg"},{"base_url":"https://salt.tikicdn.com/media/catalog/product/r/e/ren-luyen-nang-luc-giao-tieng-bang-so-do-tu-duy-2.u5762.d20171030.t101916.770207.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/r/e/ren-luyen-nang-luc-giao-tieng-bang-so-do-tu-duy-2.u5762.d20171030.t101916.770207.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/r/e/ren-luyen-nang-luc-giao-tieng-bang-so-do-tu-duy-2.u5762.d20171030.t101916.770207.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/r/e/ren-luyen-nang-luc-giao-tieng-bang-so-do-tu-duy-2.u5762.d20171030.t101916.770207.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/r/e/ren-luyen-nang-luc-giao-tieng-bang-so-do-tu-duy-2.u5762.d20171030.t101916.770207.jpg"}],"warranty_policy":null,"authors":[{"id":155716,"name":"Trịnh Quỳnh","slug":"trinh-quynh"}],"current_seller":{"id":15583,"sku":"7000363058247","name":"NhatPh