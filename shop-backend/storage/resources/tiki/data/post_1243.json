/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":true,"return_reason":"any_reason"}},"discount":18000,"discount_rate":25,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/d9/5f/4e/269fb5ad2adecccdab2b29bb82580c33.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1873,"all_time_quantity_sold":11,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"Đối với những người làm sáng tạo, thời gian thường là cơn ác mộng. Họ có quá nhiều ý tưởng và quá ít thời gian. Rất nhiều người không thể xoay xở để hoàn thành công việc đúng như kỳ vọng, trong khoảng thời gian được cho phép. <br />\nTrên thực tế, những tên tuổi lớn trong giới sáng tạo luôn có cách để quản lý thời gian. Bí quyết của họ là làm ít việc lại và loại bỏ những việc không cần thiết. Họ chỉ tập trung vào những việc thật sự quan trọng. <br />\n\"Danh Sách Việc-Đừng-Làm\" là phương pháp chủ đạo được giới thiệu trong \"Khoảnh khắc người sáng tạo\". Cuốn sách này chứng minh, việc nói \"không\" với một số việc mới chính là cách để những người làm sáng tạo tiết kiệm thời gian. Càng loại bỏ nhiều việc không quan trọng, bạn càng tập trung tốt cho những việc quan trọng. <br />\nTừ đó, tác giả Donald Roos đưa ra quan điểm: \"Bạn không cần phải lên kế hoạch thật chi tiết cho mọi việc thì mới có thể quản lý thời gian hiệu quả. Thay vào đó, hãy nghĩ đến một mục tiêu lớn hơn rồi đưa ra các lựa chọn trên đó: Bạn sẽ làm việc gì và không làm việc gì?\" <br />\n\"Khoảnh khắc người sáng tạo\" gồm năm chương. Sau hai chương đầu giới thiệu về việc quản lý thời gian và phương pháp danh sách Việc-Đừng-Làm, tác giả dành ba chương sau để trình bày cách ứng dụng phương pháp này vào các khía cạnh khác nhau, như: Cuộc sống, công việc và việc quản lý các dự án. Dù ở mặt nào, nguyên tắc chủ đạo mà Donald Roos đưa ra vẫn là: quyết định việc cần làm và việc-đừng-làm. Đó có thể là từ chối công việc không phải là thế mạnh, loại bỏ những dự án không phù hợp với bản thân, phớt lờ mạng xã hội để tiết kiệm thời gian hay từ chối các cuộc hẹn cà phê. Tác giả cũng không quên đưa ra những gợi ý mở, nhằm giúp những lần nói \"không\" của bạn không gây ảnh hưởng tới mối quan hệ và mọi trải nghiệm đẹp đẽ vốn có trong cuộc sống. <br />\nNgười đọc dễ nắm bắt những chỉ dẫn trong \"Khoảnh khắc người sáng tạo\" nhờ vào văn phong đơn giản, các ví dụ rõ ràng cùng với những hình minh hoạ dễ hiểu của Donald Roos. Không chỉ dành riêng cho người làm sáng tạo, bất cứ ai muốn tổ chức tốt công việc, cuộc sống và tiết kiệm thời gian để có thể tìm đọc cuốn sách này.<p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/d9/5f/4e/269fb5ad2adecccdab2b29bb82580c33.jpg",