text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":181000,"discount_rate":15,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/44/7a/8b/327e52887fcd11b7f051f5f50643f582.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":762,"all_time_quantity_sold":6,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eMáy xay sinh tố Mini MX-XP103WRA Panasonic\u003c/strong\u003e nhỏ gọn mang theo tiện lời sẽ giúp bạn được thưởng thức món sinh tố tươi ngon dù ở bất cứ đâu. Cốc được làm từ chất liệu nhựa không chứa BPA, trọng lượng nhẹ, giúp bạn thưởng thức đồ uống trực tiếp một cách an toàn.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/34/85/02/a42b5c6ab5a46009e4004ebabbcbe2f4.jpg\" alt=\"\" width=\"702\" height=\"468\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eĐược thiết kế nhỏ gọn, phù hợp với mọi vị trí trong nhà bếp hoặc bất kỳ không gian nào trong nhà. Giúp bạn thuận tiện chuẩn bị thức uống bổ dưỡng mỗi ngày để cân bằng chế độ ăn uống.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/dd/5e/e0/0b83cc22ef6ad04f7496ec3e552b4b6b.jpg\" alt=\"\" width=\"700\" height=\"467\" /\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/b9/7e/c9/20c3e4951952ce174e9ba707e1a30651.jpg\" alt=\"\" width=\"702\" height=\"468\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/03/d2/e9/67eb0040dcf80c0efbc39ec3841b0565.jpg\" alt=\"\" width=\"702\" height=\"468\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/3f/7c/52/095096f6ffbe95039e61e4fd6381e35b.jpg\" alt=\"\" width=\"702\" height=\"468\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/9e/60/a2/a11ebbe56cf37e1a960c54d7c143de26.jpg\" alt=\"\" width=\"0\" height=\"0\" /\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/9e/60/a2/5b1d65a7194d939d2d5f886b0d935b26.jpg\" alt=\"\" width=\"702\" height=\"468\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/95/62/60/f8fd2d52e71fca02e813cef26eeb70d9.jpg\" alt=\"\" width=\"702\" height=\"468\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/7d/c3/dc/a9674050ce10d138c7e28cddbd75b8b5.jpg\" alt=\"\" width=\"702\" height=\"468\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/de/f7/eb/9ba3a315cbfce130b212d53d860a676f.jpg\" alt=\"\" width=\"702\" height=\"468\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/f3/00/a5/0d2c7e9de779e16913902cd8c8ce0859.jpg\" alt=\"\" width=\"702\" height=\"468\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/17/44/66/1d8cf0d80c7a32c0043af6ea8ed25629.jpg\" alt=\"\" width=\"702\" height=\"468\" /\u003e \u003c/p\u003e\n\u003cp\u003eXay sinh tố tại nhà và đựng trực tiếp trong cốc có nắp đậy kín hoặc uống trực tiếp từ cốc xay vô cùng tiện lợi. Tháo lưỡi dao, gắn nắp đậy vào bình xay và dễ dàng mang theo trong túi xách.\u003c/p\u003e\n\u003cp\u003eLưỡi dao zigzag độc đáo được thiết kế để xay nhiều loại nguyên liệu một cách hiệu quả, khả năng cắt nhỏ kết hợp nghiền một cách mạnh mẽ cho thành phẩm nhuyễn mịn.\u003c/p\u003e\n\u003cp\u003eBạn có thể xay tối đa 100g đá viên trong một lần, làm sinh tố với các loại hạt và nhiều loại nguyên liệu cứng khácNhờ hình dạng cốc độc đáo với bốn đường gờ chạy dọc thành cốc, các nguyên liệu được đảo trộn kỹ và đều. Các khoảng trống giữa các đường gờ và lưỡi dao được điều chỉnh và thiết kế một cách cân đối để giảm thiểu tối đa hư hại lưỡi dao trong quá trình xay cắt nguyên liệu.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThông số kỹ thuật:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eNguồn điện: 220V・50-60Hz\u003c/li\u003e\n\u003cli\u003eKích thước (R×S×C): 120 x 120 x 322 mm\u003c/li\u003e\n\u003cli\u003eTrọng lượng: 1,1 kg\u003c/li\u003e\n\u003cli\u003eMức tiêu thụ điện năng: 310W\u003c/li\u003e\n\u003cli\u003eCài đặt tốc độ: Bật / Tắt\u003c/li\u003e\n\u003cli\u003eDung tích làm việc: 400ml\u003c/li\u003e\n\u003cli\u003ePhụ kiện: 01 Nắp có vòi uống + 01 Nắp không có vòi uống\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eThông tin Bảo hành:\u003c/strong\u003e\u003cbr /\u003eBảo hành chính hãng 1 năm trên toàn quốc\u003cbr /\u003eGiờ làm việc: Thứ Hai - thứ Sáu: 08:00 - 17:30. Không làm việc trong các ngày lễ và Tết Âm lịch.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTHÔNG TIN THƯƠNG HIỆU\u003c/strong\u003e\u003cbr /\u003ePanasonic thành lập năm 1918 bởi Konosuke Matsushita với khẩu hiệu \"A better life, a better world\" cam kết mang đến cho khách hàng một cuộc sống hiện đại và tốt đẹp hơn. Trong suốt quá trình phát triển, Panasonic từng bước khẳng định thương hiệu qua các sản phẩm được ưa chuộng trên khắp thế giới: lò vi sóng, tivi, máy giặt, tủ lạnh, điều hoà, máy lọc không khí, thiết bị hỗ trợ sức khoẻ và làm đẹp, điện thoại bàn,\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/44/7a/8b/327e52887fcd11b7f051f5f50643f582.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/44/7a/8b/327e52887fcd11b7f051f5f50643f582.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/44/7a/8b/327e52887fcd11b7f051f5f50643f582.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/44/7a/8b/327e52887fcd11b7f051f5f50643f582.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/44/7a/8b/327e52887fcd11b7f051f5f50643f582.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/48/9e/1c/f1517bf292c67bd164d52ca34d6160b6.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/48/9e/1c/f1517bf292c67bd164d52ca34d6160b6.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/48/9e/1c/f1517bf292c67bd164d52ca34d6160b6.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/48/9e/1c/f1517bf292c67bd164d52ca34d6160b6.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/48/9e/1c/f1517bf292c67bd164d52ca34d6160b6.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/65/79/fb/c2c5e9cfcbe11cae3e2a17e639b574c1.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/65/79/fb/c2c5e9cfcbe11cae3e2a17e639b574c1.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/65/79/fb/c2c5e9cfcbe11cae3e2a17e639b574c1.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/65/79/fb/c2c5e9cfcbe11cae3e2a17e639b574c1.jpg","thumbnail_ur