t":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":160000,"discount_rate":24,"rating_average":4.5,"review_count":46,"review_text":"(46)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/fa/0c/78/825ecc5786e43a634d8bdab35256a0b8.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":659,"all_time_quantity_sold":343,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p class=\"_2jrvqA\">1.THÔNG SỐ KỸ THUẬT SẢN PHẨM:</p>\n<p><img title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/14/57/d4/51859f90e2d09847ba550460d2efc15a.png\" alt=\"\" width=\"818\" height=\"348\" /></p>\n<p> </p>\n<p class=\"_2jrvqA\">2.THÔNG TIN SẢN PHẨM</p>\n<p class=\"_2jrvqA\">Nồi lẩu điện COMET CM7731 - Dung tích 3.5L là một thiết bị điện gia dụng có thiết kế thân nồi bằng thép sơn tĩnh điện giúp sản phẩm bền đẹp theo thời gian. Lòng nồi được làm bằng hợp kim nhôm tráng lớp men chống dính cao cấp giúp cho bạn tiết kiệm được rất nhiều thời gian và vệ sinh dễ dàng sau khi sử dụng xong, không lo bị cháy khét trong khi nấu.</p>\n<div class=\"_2jrvqA\">\n<div class=\"_1OPdfl\"><img src=\"https://salt.tikicdn.com/ts/tmp/ec/1b/31/7dcdcc9d254830595b6885e0fcdf47be.jpg\" alt=\"\" width=\"750\" height=\"728\" /></div>\n</div>\n<p class=\"_2jrvqA\"> </p>\n<p class=\"_2jrvqA\">3.ĐẶC ĐIỂM SẢN PHẨM:</p>\n<p class=\"_2jrvqA\">- Nút vặn điều chỉnh nhiệt độ từ 65 – 220 độ C thuận tiện theo nhu cầu sử dụng</p>\n<p class=\"_2jrvqA\">- Dung tích lớn 3.5L, dễ dàng đáp ứng cho bữa tối của gia đình.</p>\n<p class=\"_2jrvqA\">- Dễ vệ sinh.</p>\n<p class=\"_2jrvqA\">- Có 1 mâm nhiệt lớn, cùng công suất cao 1300W, nấu nhanh mà vẫn tiết kiệm điện.</p>\n<div class=\"_2jrvqA\">\n<div class=\"_1OPdfl\"><img src=\"https://salt.tikicdn.com/ts/tmp/f8/a3/74/8d2a8f502cc33ffeba56b3809e654782.jpg\" alt=\"\" width=\"750\" height=\"667\" /></div>\n</div>\n<p class=\"_2jrvqA\"> </p>\n<p class=\"_2jrvqA\">4.CÔNG DỤNG VÀ CHỨC NĂNG CỦA SẢN PHẨM:</p>\n<p class=\"_2jrvqA\">- Nút vặn điều chỉnh nhiệt độ</p>\n<p class=\"_2jrvqA\">- Làm sôi nước lẩu nhanh</p>\n<p class=\"_2jrvqA\">- Nhiều thực đơn, giúp bạn trở thành đầu bếp ngay lập tức.</p>\n<p class=\"_2jrvqA\"> </p>\n<div class=\"_2jrvqA\">\n<div class=\"_1OPdfl\"><img src=\"https://salt.tikicdn.com/ts/tmp/c3/8b/9e/f9d69f363ae9fd6af00f517928a618c3.jpg\" alt=\"\" width=\"750\" height=\"911\" /></div>\n</div>\n<p class=\"_2jrvqA\"> </p>\n<p class=\"_2jrvqA\">5.CHẤT LIỆU SẢN PHẨM:</p>\n<p class=\"_2jrvqA\">- Vật liệu phần thân : thép sơn tĩnh điện</p>\n<p class=\"_2jrvqA\">- Lòng nồi : hợp kim nhôm tráng lớp men chống dính</p>\n<p class=\"_2jrvqA\"> </p>\n<div class=\"_2jrvqA\">\n<div class=\"_1OPdfl\"><img src=\"https://salt.tikicdn.com/ts/tmp/52/d0/63/01537d8c2619b36420e91018f11da2d1.jpg\" alt=\"\" width=\"750\" height=\"683\" /></div>\n</div>\n<p class=\"_2jrvqA\">6.PHỤ KIỆN ĐI KÈM:</p>\n<p class=\"_2jrvqA\"> </p>\n<p class=\"_2jrvqA\">- Hướng dẫn (bản sao): 1</p>\n<p class=\"_2jrvqA\">- Phiếu bảo hành : 1</p>\n<p class=\"_2jrvqA\">- Nguồn cắm điện: VDE</p>\n<p class=\"_2jrvqA\">- Lòng nồi - Xửng hấp</p>\n<p class=\"_2jrvqA\"> </p>\n<div class=\"_2jrvqA\">\n<div>\n<div class=\"_3iW6K2\"><img class=\"_2qyaZL _3DKwBj\" src=\"https://cf.shopee.vn/file/sg-11134202-22100-5fxxb35pobjv4b\" alt=\"sg-11134202-22100-5fxxb35pobjv4b\" /></div>\n</div>\n</div>\n<div class=\"_2jrvqA\">\n<div class=\"_1OPdfl\"> </div>\n<div class=\"_1OPdfl\"> </div>\n<div class=\"_1OPdfl\">\n<p class=\"_2jrvqA\">7.CHẾ ĐỘ BẢO HÀNH:</p>\n<p class=\"_2jrvqA\">- Bảo hành 1 năm.</p>\n<p class=\"_2jrvqA\">- Đổi mới hoàn toàn trong 1 năm nếu lỗi do nhà sản xuất.</p>\n<p class=\"_2jrvqA\">- Bảo hành sản phẩm tận nhà (Áp dụng khu vực TP.HCM)</p>\n</div>\n</div>\n<p class=\"_2jrvqA\"> </p>\n<p class=\"_2jrvqA\">8.THÔNG TIN THƯƠNG HIỆU:</p>\n<div class=\"_2jrvqA\">\n<div>\n<div class=\"_1OPdfl\"><img class=\"_2qyaZL _2PWsS4\" src=\"https://cf.shopee.vn/file/5f4aaa631926db37ee89e65c5173236f\" alt=\"5f4aaa631926db37ee89e65c5173236f\" width=\"750\" height=\"229\" /></div>\n</div>\n</div><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/fa/0c/78/825ecc5786e43a634d8bdab35256a0b8.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/fa/0c/78/825ecc5786e43a634d8bdab35256a0b8.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/fa/0c/78/825ecc5786e43a634d8bdab35256a0b8.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fa/0c/78/825ecc5786e43a634d8bdab35256a0b8.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fa/0c/78/825ecc5786e43a634d8bdab35256a0b8.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/a1/08/3e/ca8e083454aa91601893c63d5663ea03.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a1/08/3e/ca8e083454aa91601893c63d5663ea03.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a1/08/3e/ca8e083454aa91601893c63d5663ea03.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a1/08/3e/ca8e083454aa91601893c63d5663ea03.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a1/08/3e/ca8e083454aa91601893c63d5663ea03.png"},{"base_url":"https://salt.tikicdn.com/ts/product/79/b9/22/f0364b66