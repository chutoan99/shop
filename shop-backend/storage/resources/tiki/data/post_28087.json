/salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":34200,"discount_rate":15,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/91/a4/95/2f0a648b6e2983155342ddb80a1e2063.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":579,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/4c/90/f1/bcc684df1b4496e989a84d4eea89ffef.jpg\" alt=\"\" width=\"750\" height=\"1125\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003eLịch sử ngôn từ cho trẻ em\u003c/p\u003e\n\u003cp\u003eTác giả: Mary Richards, Rose Blake\u003c/p\u003e\n\u003cp\u003eThể loại: Bách khoa toàn thư cho trẻ em\u003c/p\u003e\n\u003cp\u003eGiá bìa: 228,000 VNĐ\u003c/p\u003e\n\u003cp\u003eNăm XB: 2023\u003c/p\u003e\n\u003cp\u003eKích thước: 21.6 x 27.9 cm\u003c/p\u003e\n\u003cp\u003eHình thức: Bìa cứng\u003c/p\u003e\n\u003cp\u003eSố trang: 104\u003c/p\u003e\n\u003cp\u003eNgôn ngữ: Tiếng Việt\u003c/p\u003e\n\u003cp\u003eNgười dịch: T.S.\u003c/p\u003e\n\u003cp\u003eĐơn vị phát hành: San Hô Books\u003c/p\u003e\n\u003cp\u003eDành cho trẻ em từ 7 tuổi trở lên.\u003c/p\u003e\n\u003cp\u003e------------------------------------------------------------\u003c/p\u003e\n\u003cp\u003eCùng du hành thời gian để khám phá lịch sử sáng tạo và tôn vinh ngôn từ.\u003c/p\u003e\n\u003cp\u003eNgười xưa tạo ra chữ viết và sử dụng ngôn ngữ như thế nào, ngày nay chúng ta giao tiếp với nhau ra sao? Mời các bạn nhỏ gặp gỡ các danh nhân tự cổ chí kim để chiêm ngưỡng lịch sử thế giới qua từ ngữ và những phát kiến vĩ đại như bảng viết, giấy bút, sách vở! Kế đó, ta sẽ hướng về tương lai với sự phát triển của ngôn ngữ mạng, ngôn ngữ lập trình song song với sứ mệnh bảo tồn các ngôn ngữ bị đe doạ. Lịch sử ngôn từ cho trẻ em – cuốn sách truyền cảm hứng cho những bộ óc sáng tạo đầy hiếu kì, độc giả nhí sẽ được thoả sức học hỏi về cách loài người chúng ta giao tiếp và tha hồ giải đố, làm thơ, chơi đùa cùng ngôn từ.\u003c/p\u003e\n\u003cp\u003e------------------------------------------------------------\u003c/p\u003e\n\u003cp\u003eVỀ TÁC GIẢ\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eMARY RICHARDS\u003c/strong\u003e là tác giả, hoạ sĩ minh hoạ sách nghệ thuật từng đạt giải thưởng. Cô đã biên tập và chuyển thể cuốn sách bán chạy nổi tiếng \u003cem\u003eA History of Pictures for Children\u003c/em\u003e (tạm dịch: \u003cem\u003eNghệ thuật tranh cho trẻ em\u003c/em\u003e) của David Hockney.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eROSE BLAKE\u003c/strong\u003e là nghệ sĩ, hoạ sĩ minh hoạ từng đoạt giải thưởng. Cô đã vẽ minh hoạ cho nhiều cuốn sách thiếu nhi, trong đó có \u003cem\u003eLịch sử âm nhạc cho trẻ em, Lịch sử ngôn từ cho trẻ em\u003c/em\u003e.\u003c/p\u003e\n\u003cp\u003e------------------------------------------------------------\u003c/p\u003e\n\u003cp\u003eQuy cách: Bìa cứng bồi các tông chắc chắn, cán mờ, …. Ruột sách in 4 màu trên giấy dày dặn, chống loá, thân thiện với mắt trẻ.\u003c/p\u003e\n\u003cp\u003e------------------------------------------------------------\u003c/p\u003e\n\u003cp\u003eTRANG ĐỌC THỬ:\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/c9/19/09/f611380a86491bc4aecfa4efb959080d.jpg\" alt=\"\" width=\"750\" height=\"484\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/53/74/f7/5319723b7f9ec1790abf19411c86f3f4.jpg\" alt=\"\" width=\"750\" height=\"484\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/ce/44/39/7a3cd59710f48667e7a4ae0eb9c4e1f0.jpg\" alt=\"\" width=\"750\" height=\"484\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/85/4b/c6/366b99f0e07dce556426c1a615bd5cad.jpg\" alt=\"\" width=\"750\" height=\"484\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/ae/e3/83/fed55612c4005e5072cfcb74686443ea.jpg\" alt=\"\" width=\"750\" height=\"484\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/91/a4/95/2f0a648b6e2983155342ddb80a1e2063.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/91/a4/95/2f0a648b6e2983155342ddb80a1e2063.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/91/a4/95/2f0a648b6e2983155342ddb80a1e2063.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/91/a4/95/2f0a648b6e2983155342ddb80a1e2063.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/91/a4/95/2f0a648b6e2983155342ddb80a1e2063.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/b3/df/2f/2aaff46d61ef46d2fdfdc25fd6dcc60a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b3/df/2f/2aaff46d61ef46d2fdfdc25fd6dcc60a.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b3/df/2f/2aaff46d61ef46d2fdfdc25fd6dcc60a.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b3/df/2f/2a