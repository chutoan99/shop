ng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/6b/2c/b1/fbd51c14da01462158e8aa10fe643112.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/6b/2c/b1/fbd51c14da01462158e8aa10fe643112.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/6b/2c/b1/fbd51c14da01462158e8aa10fe643112.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6b/2c/b1/fbd51c14da01462158e8aa10fe643112.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6b/2c/b1/fbd51c14da01462158e8aa10fe643112.png"},{"base_url":"https://salt.tikicdn.com/ts/product/00/8c/15/3795731ef286c1c0d02da1b57cf1d99d.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/00/8c/15/3795731ef286c1c0d02da1b57cf1d99d.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/00/8c/15/3795731ef286c1c0d02da1b57cf1d99d.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/00/8c/15/3795731ef286c1c0d02da1b57cf1d99d.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/00/8c/15/3795731ef286c1c0d02da1b57cf1d99d.png"},{"base_url":"https://salt.tikicdn.com/ts/product/10/30/5b/63f91d112ccf0e18483e7410bd6931fb.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/10/30/5b/63f91d112ccf0e18483e7410bd6931fb.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/10/30/5b/63f91d112ccf0e18483e7410bd6931fb.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/10/30/5b/63f91d112ccf0e18483e7410bd6931fb.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/10/30/5b/63f91d112ccf0e18483e7410bd6931fb.png"},{"base_url":"https://salt.tikicdn.com/ts/product/69/82/a7/78c9797b651e414006da843050cb86fe.png","is_gallery":true,"label":