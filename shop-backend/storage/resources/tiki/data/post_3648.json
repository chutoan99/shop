upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":true,"return_reason":"any_reason"}},"discount":20500,"discount_rate":27,"rating_average":5,"review_count":170,"review_text":"(170)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/c5/3f/9b/231139a300c4a1d120c619b860da1449.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":915,"all_time_quantity_sold":2253,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003eLời nói đầu\u003c/h3\u003e\n\u003cp\u003eLần đầu tiên, nỗi buồn, thậm chí cái chết được mô tả một cách không khoan nhượng trong văn học thiếu nhi Việt Nam. Đằng sau lại thắm đẫm tình yêu, sự cảm thông và lòng trắc ẩn. Cuốn sách được các nhà văn trong nước mệnh danh là \u0026#34;Hoàng tử bé\u0026#34; của Việt Nam.\u003c/p\u003e\n\u003cp\u003eCâu chuyện được bắt đầu bằng sự ra đời của một cái tên - như một âm thanh đẹp nhất - và kết thúc dưới bầu trời đầy sao. Nó lý giải tại sao những gì thân thuộc và chung ta ra đời cũng giống như việc ta cất tiếng nói từ những khoảng trời trong trái tim mình.\u003c/p\u003e\n\u003cp\u003eCác chương sách là những câu chuyện ẩn dụ về âm nhạc - bà mẹ vĩ đại nhất, vẻ ngọt ngào - bài học thần thánh về sự kiêu hãnh, về khu vườn - một ẩn dụ rất chi tiết về sự lớn lên khi chúng ta xuôi theo khu vườn, rồi từ đó nhận ra thế giới không bằng trái giác mà bằng sự trải nghiệm những giác quan khác có tính chất riêng biệt.\u003c/p\u003e\n\u003cp\u003eSau khi xuất bản, cuốn sách đã nhận được vô số lời khen ngợi từ nhiều phía, từ các tác giả, từ một hoạt động trên một nền văn học chú ý trên toàn nền. Không chỉ cho trẻ con, nó còn là tác phẩm viết cho trẻ con nhưng lại được người lớn đọc nhìn nhận.\u003c/p\u003e\n\u003cp\u003eTập sách hay, dễ thương, và còn nhiều mỹ từ khác nữa xứng đáng được dành cho nó. Hãy tìm đọc nội dung thay vì đọc trước phần giới thiệu sách này viết gì…. Như thế, bạn sẽ càng thích thú hơn với “Vừa nhắm mắt, vừa mở cửa sổ”.\u003c/p\u003e\n\u003ch3\u003eMục lục\u003c/h3\u003e\n\u003cp\u003eXem tại hình ảnh đọc thử\u003c/p\u003e\n\u003ch3\u003eGiới thiệu tác giả\u003c/h3\u003e\n\u003cp\u003e\u003cstrong\u003eNguyễn Ngọc Thuần\u003c/strong\u003e là một nhà văn nổi tiếng của Việt Nam, đặc biệt trong lĩnh vực văn học dành cho thiếu nhi và thanh thiếu niên. Dưới đây là một số thông tin về tác giả:\u003c/p\u003e\n\u003ch3\u003eTiểu sử và sự nghiệp:\u003c/h3\u003e\n\u003col\u003e\u003cli\u003e\n\u003cp\u003e\u003cstrong\u003eXuất thân\u003c/strong\u003e: Nguyễn Ngọc Thuần sinh năm 1972 tại tỉnh Quảng Trị. Ông có nền tảng học vấn vững chắc và đã theo đuổi đam mê viết lách từ khi còn nhỏ.\u003c/p\u003e\n\u003c/li\u003e\u003cli\u003e\n\u003cp\u003e\u003cstrong\u003eSáng tác\u003c/strong\u003e: Ông nổi bật với những tác phẩm giàu cảm xúc, sâu sắc và mang tính giáo dục cao. Các tác phẩm của ông thường xoay quanh các chủ đề như tình bạn, gia đình, ước mơ và những vấn đề xã hội.\u003c/p\u003e\n\u003c/li\u003e\u003cli\u003e\n\u003cp\u003e\u003cstrong\u003eThành tựu\u003c/strong\u003e: Nguyễn Ngọc Thuần đã viết nhiều cuốn sách được yêu thích, trong đó có những tác phẩm nổi bật như \u0026#34;Người bạn nhỏ\u0026#34;, \u0026#34;Câu chuyện của những vì sao\u0026#34;, và \u0026#34;Hoàng tử bé\u0026#34;. Ông được biết đến là một trong những cây bút tiêu biểu trong văn học thiếu nhi Việt Nam.\u003c/p\u003e\n\u003c/li\u003e\u003cli\u003e\n\u003cp\u003e\u003cstrong\u003ePhong cách viết\u003c/strong\u003e: Tác phẩm của ông thường mang tính thơ mộng, giàu hình ảnh và cảm xúc, dễ dàng chạm đến trái tim của độc giả trẻ tuổi. Ông cũng chú trọng đến việc khơi dậy trí tưởng tượng và tư duy sáng tạo của trẻ.\u003c/p\u003e\n\u003c/li\u003e\u003cli\u003e\n\u003cp\u003e\u003cstrong\u003eĐóng góp cho văn học\u003c/strong\u003e: Nguyễn Ngọc Thuần không chỉ là một nhà văn mà còn là một người truyền cảm hứng cho nhiều thế hệ độc giả, khuyến khích tình yêu đọc sách và khám phá thế giới xung quanh.\u003c/p\u003e\n\u003c/li\u003e\u003c/ol\u003e\n\u003cp\u003eTóm lại, Nguyễn Ngọc Thuần là một tác giả có tầm ảnh hưởng lớn trong lĩnh vực văn học thiếu nhi tại Việt Nam, với nhiều tác phẩm ý nghĩa và sâu sắc.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/c5/3f/9b/231139a300c4a1d120c619b860da1449.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c5/3f/9b/231139a300c4a1d120c619b860da1449.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c5/3f/9b/231139a300c4a1d120c619b860da1449.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c5/3f/9b/231139a300c4a1d120c619b860da1449.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/t