ng hoa bia thơm dịu đặc trưng của bia tươi.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/a4/7d/b8/fd6b3ccb0795f5caacf4012230f6cc24.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a4/7d/b8/fd6b3ccb0795f5caacf4012230f6cc24.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a4/7d/b8/fd6b3ccb0795f5caacf4012230f6cc24.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a4/7d/b8/fd6b3ccb0795f5caacf4012230f6cc24.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a4/7d/b8/fd6b3ccb0795f5caacf4012230f6cc24.png"},{"base_url":"https://salt.tikicdn.com/ts/product/9d/47/4d/deeb21877357a0eb037dce8ac0f6b91b.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/9d/47/4d/deeb21877357a0eb037dce8ac0f6b91b.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/9d/47/4d/deeb21877357a0eb037dce8ac0f6b91b.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9d/47/4d/deeb21877357a0eb037dce8ac0f6b91b.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9d/47/4d/deeb21877357a0eb037dce8ac0f6b91b.png"},{"base_url":"https://salt.tikicdn.com/ts/product/35/b9/21/39de972c7953f72568e8a8e97983dc9e.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/35/b9/21/39de972c7953f72568e8a8e97983dc9e.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/35/b9/21/39de972c7953f72568e8a8e97983dc9e.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/35/b9/21/39de972c79