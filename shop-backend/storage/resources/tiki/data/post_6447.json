ght":0,"text_color":"#FFF0F1","background_color":"#D93843","href":null,"text":"9.9"},{"placement":"pdp_badge","code":"is_hero","type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"freeship_xtra","type":"pdp_icon_badge","index":2,"icon":"https://salt.tikicdn.com/ts/upload/be/67/48/04a82ab8df178e1a13bde38316081865.png","icon_width":91,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":true,"return_reason":"any_reason"}},"discount":8000,"discount_rate":4,"rating_average":4.8,"review_count":4,"review_text":"(4)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/41/f3/98/df1dae04f7480deb0637dfc8f95ad40e.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":491,"all_time_quantity_sold":8,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003chtml\u003e\n \u003chead\u003e\u003c/head\u003e\n \u003cbody\u003e\n  \u003cul\u003e\n   \u003cp\u003eBộ sạc pin tiểu 8 cổng 1.5V, pin sạc AA AAA BESTON 1.5V chính hãng pin lithium hàng cao cấp\u003c/p\u003e\n   \u003cp\u003eĐây là loại pin sạc thế hệ thứ 2 của hãng Beston, cũng là thế hệ mới nhất.\u003c/p\u003e\n   \u003cp\u003ePin sạc AA / AAA 1.5V có điện áp ổn định 1.5V trong suốt chu kì sả giúp khắc phục hoàn toàn trường hợp không tương thích của thiết bị khi sử dụng pin sạc 1,2V, cũng như pin dùng một lần khi xả điện bị giảm áp.\u003c/p\u003e\n   \u003cp\u003e- Pin sạc AA thông thường có điện áp tiêu chuẩn 1.2V nên thường xảy ra không tương thích với một số thiết bị yêu cầu pin dùng 1 lần 1.5V. Để khắc phục vấn đề đó Beston đã nghiên cứu và sản xuất pin sạc 1.5V lithium. Pin được thiết kế lõi pin từ pin lithium siêu bền cho khả năng sạc xả tới 1500 lần, cùng mạch ổn định điện áp giúp điện áp pin ổn định ở 1,5V trong suốt chu kì xả.\u003c/p\u003e\n   \u003cp\u003e- Pin làm từ chất liệu lithium nên trọng lượng pin sẽ nhẹ hơn pin 1.2V (pin Ni-Mh) nhưng dung lượng tốt hơn và dùng bền hơn.\u003c/p\u003e\n   \u003cp\u003e- Pin có điện áp sử dụng tương đương với pin Akaline thông thường nên hoàn toàn tương thích với các thiết bị điện tử dùng pin. giúp giảm chi phí vận hành, thân thiện với môi trường.\u003c/p\u003e\n   \u003cp\u003e- Theo thông tin nhà sản xuất cung cấp, pin có thể cung cấp điện năng 2800mWh/3500mWh với pin AA hoặc 800mWh với pin AAA. Tương đượng với pin Akaline cao cấp, Pin có tuổi thọ sạc xả lên tới 1500 lần.\u003c/p\u003e\n   \u003cp\u003ePin cho thời gian sử dụng tương đượng so với pin Akaline cao cấp hoặc 4-6 lần so với pin than đang có trên thị trường.\u003c/p\u003e\n   \u003cp\u003ePin sạc lại được nhiều lần nên cực thân thiện với môi trường.\u003c/p\u003e\n   \u003cp\u003ePhù hợp lắp cho những thiết bị dùng thường xuyên hết pin. ( thông thường phải thay pin \u0026lt; 6 tháng 1 lần) với một số thiết bị dùng hết ít pin hơn bạn nên dùng pin Akaline dùng 1 lần.\u003c/p\u003e\n   \u003cp\u003eMô tả sản phẩm:\u003c/p\u003e\n   \u003cp\u003eBộ 4 pin sạc AA (2A) (pin tiểu sạc)\u003c/p\u003e\n   \u003cp\u003eLoại pin: lithium 1.5V\u003c/p\u003e\n   \u003cp\u003eDung lượng: 2800/3500 mWh\u003c/p\u003e\n   \u003cp\u003eKhối lượng 1 viên: 20g\u003c/p\u003e\n   \u003cp\u003eĐiện áp định mức: 1.5V\u003c/p\u003e\n   \u003cp\u003eDùng cho đồ chơi, micro karaoke, chuột không dây, flash máy ảnh, đồng hồ treo tường, khóa vân \u003c/p\u003e\n   \u003cp\u003eBộ 4 pin sạc AAA (3A) (pin đũa sạc)\u003c/p\u003e\n   \u003cp\u003eLoại pin: lithium 1.5V\u003c/p\u003e\n   \u003cp\u003eDung lượng: 800 mWh\u003c/p\u003e\n   \u003cp\u003eKhối lượng 1 viên: 9g\u003c/p\u003e\n   \u003cp\u003eĐiện áp định mức: 1.5V\u003c/p\u003e\n   \u003cp\u003eBộ sạc 8 cổng M7012\u003c/p\u003e\n   \u003cp\u003eĐiện áp vào 5V 1A (không bao gồm cốc sạc)\u003c/p\u003e\n   \u003cp\u003eCông suất 10W lúc sạc (0.5W lúc không sạc)\u003c/p\u003e\n   \u003cp\u003eDòng sạc 300mah x8 AAA hoặc 200mah X 8AA\u003c/p\u003e\n   \u003cp\u003eCó thể sạc 1 lúc 8 pin AA hoặc 8 pin AAA hoặc sạc kết hợp, sạc 1 pin cũng được.\u003c/p\u003e\n   \u003cp\u003eKhi sạc đèn led trạng thái màu đỏ, khi sạc đầy đèn sẽ chuyển sang trạng thái màu xanh.\u003c/p\u003e\n   \u003cp\u003eLưu ý:\u003c/p\u003e\n   \u003cp\u003ePin Li-Ion 1.5V có thể sạc lên bằng bộ sạc đa năng (LiitoKala), tuy nhiên những bộ sạc đa năng này thường chỉ hỗ trợ pin Ni-MH/Ni-Cd 1.2V chứ ko hỗ trợ pin 1.5V, khi sạc nó sẽ sạc bằng dòng 4V nên về lâu dài sẽ làm hại pin. Tốt nhất nên dùng đúng bộ sạc 1.5V cùng hãng Beston để sạc pin này vì chưa có nhiều hãng sản xuất loại pin 1.5V thế hệ mới này.\u003c/p\u003e\n  \u003c/ul\u003e\n \u003c/body\u003e\n\u003c/html\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base