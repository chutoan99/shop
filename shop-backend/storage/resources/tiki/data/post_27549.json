t":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":23000,"discount_rate":25,"rating_average":4.7,"review_count":23,"review_text":"(23)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/2f/b4/6a/3739e9903ec3601c838cb5dca84e423f.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1016,"all_time_quantity_sold":376,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cspan style=\"color: #ff6600;\"\u003e\u003cstrong\u003eOSRAM\u003c/strong\u003e\u003c/span\u003e Thương hiệu hàng đầu thế giới trong lĩnh vực chiếu sáng đến từ \u003cstrong\u003eCHLB Đức\u003c/strong\u003e. Các dòng sản phẩm được Nhập khẩu và Phân phối chính hãng tại thị trường Việt Nam, đáp ứng các tiêu chuẩn an toàn Quốc tế mang lại sự tin cậy cho người dùng.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eBóng đèn LED Eco Stick G3 OSRAM\u003c/strong\u003e là dòng sản phẩm thế hệ mới với thiết kế nhỏ gọn hơn so với dòng sản phẩm cũ, ánh sáng chất lượng CRI 80 theo tiêu chuẩn toàn cầu, bảo vệ quá nhiệt giúp gia tăng tuổi thọ bóng đèn.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/17/94/44/809e58ca4cab96e7fe69b9b4279f8f1d.jpg\" alt=\"Bóng LED Stick thế hệ mới\" width=\"750\" height=\"563\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003eBóng LED ECO Stick G3 Thế hệ mới\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eSản phẩm được ứng dụng thay thế bóng Compact 3U, bóng xoắn gắn trong các chóa đèn lon âm trần, đèn lon nổi truyền thống, đèn bàn học, đèn trang trí sử dụng \u003cstrong\u003eđui đèn xoắn chuẩn E27\u003c/strong\u003e. Mang lại không gian chiếu sáng chất lượng hoàn hảo cho ngôi nhà bạn với kinh phí thấp nhất.\u003c/p\u003e\n\u003cp\u003eBóng đèn\u003cstrong\u003e LED ECO Stick G3\u003c/strong\u003e có 3 màu ánh sáng cơ bản:\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003eÁnh sáng Trắng:\u003c/strong\u003e Tạo môi trường năng động, hứng khởi cho các hoạt động sinh hoạt hằng ngày, thích hợp cho các môi trường làm việc, sinh hoạt như nhà ở, cửa hàng, văn phòng.\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eÁnh sáng Trung tính:\u003c/strong\u003e Ánh sáng ban ngày tự nhiên tạo nên không gian hài hòa mang lại cảm giác thoải mái nên được ứng dụng tại phòng khách, phòng bếp, nơi làm việ\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eÁnh sáng Vàng:\u003c/strong\u003e Tạo môi trường sang trọng, ấm cúng và có phần lãng mạn, thích hợp dùng trong nhà hàng, khách sạn.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/f0/df/28/e0377d22ee2136d070f0ffc98a824b16.jpg\" alt=\"Ứng dụng bóng LED Stick G3 OSRAM\" width=\"750\" height=\"562\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003eÁnh sáng chất lượng tạo nên không gian hoàn hảo\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTHÔNG SỐ KỸ THUẬT\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eCông suất: 9W, 11W\u003c/li\u003e\n\u003cli\u003eNhiệt độ màu: Vàng (2700K), Trung tính (4000K), Trắng (6500K)\u003c/li\u003e\n\u003cli\u003eĐộ chuẩn màu CRI:80\u003c/li\u003e\n\u003cli\u003eGóc chiếu: 200°\u003c/li\u003e\n\u003cli\u003eChất liệu: Nhựa tổng hợp\u003c/li\u003e\n\u003cli\u003eTiêu chuẩn bảo vệ: IP20\u003c/li\u003e\n\u003cli\u003eTiêu chuẩn năng lượng: A+\u003c/li\u003e\n\u003cli\u003eNguồn điện: 220 - 240V/ 50 – 60Hz\u003c/li\u003e\n\u003cli\u003eTuổi thọ: 12,000 giờ\u003c/li\u003e\n\u003cli\u003eSố lần bật tắt: 100,000 lần\u003c/li\u003e\n\u003cli\u003eĐui đèn: E27\u003c/li\u003e\n\u003cli\u003eThương hiệu: OSRAM\u003c/li\u003e\n\u003cli\u003eHãng sản xuất: OSRAM - Nhập khẩu Chính Hãng\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/e5/33/c0/c59df35461f49c2c4aea5e5c98e6f247.jpg\" alt=\"Hỗ trợ\" width=\"750\" height=\"238\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/2f/b4/6a/3739e9903ec3601c838cb5dca84e423f.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/2f/b4/6a/3739e9903ec3601c838cb5dca84e423f.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/2f/b4/6a/3739e9903ec3601c838cb5dca84e423f.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2f/b4/6a/3739e9903ec3601c838cb5dca84e423f.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2f/b4/6a/3739e9903ec3601c838cb5dca84e423f.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/50/c9/73/c5a1082dab61f464c6ac5b2e76687625.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/50/c9/73/c5a1082dab61f464c6ac5b2e76687625.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/50/c9/73/c5a1082da