:89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":1,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/92/c4/27/265a5e06bab9a13dede1e06b6bd952a7.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":971,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003ciframe src=\"//www.youtube.com/embed/4XJNYrVDHho\" width=\"999\" height=\"560\" allowfullscreen=\"allowfullscreen\"\u003e\u003c/iframe\u003e\u003c/p\u003e\n\u003cp\u003eBỘ SẢN PHẨM BÁT ĐĨA mang phong cách Bắc Âu sang trọng nhẹ nhàng với màu trắng đơn giản, trang nhã kết hợp viền bao quanh rất tinh tế.Chất liệu gốm sứ tráng men cao cấp, không chứa chì, không độc hại, thân thiện với môi trường, kiểu dáng đa dạng, họa tiết sắc nét, màu sắc bắt mắt phù hợp với những gia đình yêu thích sự đơn giản nhưng đầy tinh tế. Sản phẩm sử dụng an toàn với lò vi sóng, lò nướng, máy rửa bát\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/cc/b1/23/bc7e9189529a9e5da005af957d9fd059.jpg\" alt=\"\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp\u003eĐặc điểm nổi bật của bộ bát gốm sứ cao cấp:\u003c/p\u003e\n\u003cul class=\"\"\u003e\n\u003cli class=\"\" data-spm-anchor-id=\"a2o4n.pdp_revamp.product_\"\u003e- Đảm bảo an toàn: Bộ bát đĩa sứ được nung qua 1300 độ C loại bỏ hoàn toàn tạp chất, độc tố, đảm bảo an toàn cho người sử dụng\u003c/li\u003e\n\u003cli class=\"\"\u003e- Không chứa chì, không hóa chất, không tạp chất được chứng nhận an toàn thực phẩm cho người tiêu dùng\u003c/li\u003e\n\u003cli class=\"\"\u003e- Màu sắc sản phẩm tươi sáng, đẹp không tì vết\u003c/li\u003e\n\u003cli class=\"\"\u003e- Hoa văn trên thân bát tinh tế, nhã nhặn, nổi bật, làm đẹp không gian bàn ăn\u003c/li\u003e\n\u003cli class=\"\"\u003e- Bộ bát đĩa đẹp cao cấp với khả năng chống trầy xước cao, độ bền dài lâu, bảo hành dài hạn\u003c/li\u003e\n\u003cli class=\"\"\u003e- Chất liệu sứ cao cấp tráng men công nghệ Nano, đạt tiêu chuẩn xuất Âu mang đến vẻ đẹp sang trọng, hiện đại phong cách Bắc Âu\u003c/li\u003e\n\u003cli class=\"\"\u003e- Bề mặt bộ bát đĩa đẹp được tráng men nhẵn bóng, sáng, không bám dính do đó rất dễ để vệ sinh. Phù hợp với phương pháp lau rửa thủ công và các loại máy rửa bát đĩa\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/92/c4/27/7181cde462206510a101b756fae717f4.jpg\" alt=\"\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/82/bd/6b/7560e870309ee55c5dee7202ad2970ac.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eChất liệu sứ ceramic cao cấp \u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eChất liệu làm ra chén và dĩa trong bộ sản phẩm hoàn toàn có thể chinh phục được người tiêu dùng khó tính nhất vì ceramic cao cấp với độ bền cao, chịu sốc nhiệt, chịu va đập tốt, giúp bạn có thể an tâm hoàn toàn khi sử dụng.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/b6/5b/13/b34af09bca4fc08cabfb0bfe6d005d5e.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cdiv\u003eThông tin sản phẩm bộ set 4 người:\u003c/div\u003e\n\u003cdiv\u003e\u003cspan data-spm-anchor-id=\"a2o4n.pdp_revamp.product_\"\u003e4 bát ăn cơm (11.4cm*5.8cm),\u003c/span\u003e\u003c/div\u003e\n\u003cdiv\u003e4 đĩa (18cm*3.5cm),\u003c/div\u003e\n\u003cdiv\u003e4 thìa (dài 13cm),\u003c/div\u003e\n\u003cdiv\u003e4 đôi đũa 1 bát tô to (19.8cm*8cm),\u003c/div\u003e\n\u003cdiv\u003e1 muôi canh (dài 23cm)\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv\u003eThông tin sản phẩm bộ set 6 người:\u003c/div\u003e\n\u003cdiv\u003e6 bát ăn cơm (11.4cm*5.8cm),\u003c/div\u003e\n\u003cdiv\u003e6 đĩa (18cm*3.5cm),\u003c/div\u003e\n\u003cdiv\u003e6 thìa (dài 13cm),\u003c/div\u003e\n\u003cdiv\u003e6 đôi đũa 1 bát tô to (19.8cm*8cm),\u003c/div\u003e\n\u003cdiv\u003e1 muôi canh (dài 23cm)\u003c/div\u003e\n\u003cdiv\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/4f/e0/26/4e5f11eb54f9e37984fbdb7eb16b22a2.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/div\u003e\n\u003cdiv\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/bf/d4/26/fa025cd389d8714687b12777599e5b5d.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/div\u003e\n\u003cdiv\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/92/b3/1a/51584222f850c79608262e0bf609bb6d.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/div\u003e\n\u003cdiv\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/6b/2b/9c/938c0779fa0f64d8589a2ee563ed4ad2.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/div\u003e\n\u003cdiv\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/5c/b2/92/ba8c3c6e328b42042cd08e5d33b83b10.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/div\u003e\n\u003cdiv\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/83/9a/e5/d0a6b55160988717d4ba938249cfe44d.jpg\" alt=\"\" width=\"750\" height=\"1001\" /\u003e\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/92/c4/27/265a5e06bab9a13dede1e06b6bd952a7.jpg","is_