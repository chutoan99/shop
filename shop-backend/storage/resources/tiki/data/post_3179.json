: PUJIMAX\u003cbr /\u003eLoại: AA NiMH Có Thể Sạc Lại Pin\u003cbr /\u003eDung lượng pin: 3400mAh\u003cbr /\u003eKích thước pin: 14*50mm\u003cbr /\u003eĐóng Gói:4pcs/Thẻ hút\u003cbr /\u003eĐiện áp đầu ra: 1.2V\u003cbr /\u003eTuổi thọ pin: \u0026gt; 1200 chu kỳ sạc\u003c/p\u003e\n\u003cp\u003eLưu Ý về các loại Pin Sạc\u003cbr /\u003e- Pin Ghi 1.2V Chỉ có thể sạc bằng bộ sạc 1.2V(cho Ni-MH), \u003cbr /\u003e- Pin Ghi 1.5V Chỉ có thể sạc bằng bộ sạc 1.5V(cho pin Lion) \u003cbr /\u003e- Pin Ghi 1.6V Chỉ có thể sạc bằng bộ sạc 1.6V(cho pin Ni-Zn),\u003cbr /\u003e- Các loại pin \u0026#34;Kẽm-Cacbon\u0026#34; như pin con thỏ, con ó... hoặc pin \u0026#34;Alkaline\u0026#34; đều là pin dùng 1 lần, pin loại này không sạc được. \u003cbr /\u003eNgười dùng không nên cố tình sạc pin trên!\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/b6/96/2a/e37d1d752c5ac2b32c2927b346f190a1.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b6/96/2a/e37d1d752c5ac2b32c2927b346f190a1.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b6/96/2a/e37d1d752c5ac2b32c2927b346f190a1.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b6/96/2a/e37d1d752c5ac2b32c2927b346f190a1.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b6/96/2a/e37d1d752c5ac2b32c2927b346f190a1.jpg"}],"warranty_policy":null,"brand":{"id":230165,"name":"Doublepow","slug":"doublepow"},"current_seller":{"id":165612,"sku":"4808932841577","name":"S Audio","link":"https://tiki.vn/cua-hang/s-audio","logo":"6c/3c/60/e1bae5535ac755ebddb2d3274a313152.png","price":75900,"product_id":"2718226