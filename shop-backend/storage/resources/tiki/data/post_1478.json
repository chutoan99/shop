ge","code":"text_badge","type":"text_badge","index":0,"icon":null,"icon_width":0,"icon_height":0,"text_color":"#FFF0F1","background_color":"#D93843","href":null,"text":"9.9"},{"placement":"pdp_badge","code":"is_hero","type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":true,"return_reason":"any_reason"}},"discount":731000,"discount_rate":39,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/77/55/4f/9c3d18fdcdf793a8a2bed064ccb3453c.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1176,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch5 style=\"text-align:center;\"\u003e\u003ciframe src=\"//www.youtube.com/embed/UsAtLrW4mGw?si=DVN4NN6f76Y3waKp\" width=\"560\" height=\"314\" allowfullscreen=\"\"\u003e\u003c/iframe\u003e\u003c/h5\u003e\n\u003ch5\u003eThiết kế trẻ trung, nổi bật với chất liệu siêu bền\u003c/h5\u003e\n\u003cp\u003e\u003cstrong\u003eNồi Cơm Điện Cảm Ứng Nagakawa NAG0136\u003c/strong\u003e thiết kế với 2 lựa chọn màu sắc đen và trắng trẻ trung, độc đáo, nồi cơm điện NAG0136 sẽ tô điểm cho căn bếp thêm sắc màu tươi tắn và mới mẻ.\u003c/p\u003e\n\u003cp\u003eVỏ nồi làm từ nhựa nguyên sinh siêu bền, chịu nhiệt tốt, hạn chế bám bụi, dễ dàng lau chùi giúp nồi luôn giữ được vẻ mới mẻ sáng bóng sau thời gian dài sử dụng. Vật liệu cũng giúp nồi cách nhiệt, cách điện tốt đảm bảo an toàn cho người sử dụng.\u003c/p\u003e\n\u003ch5\u003eDung tích 1.2L phù hợp 3-5 người\u003c/h5\u003e\n\u003cp\u003eNồi cơm điện tử NAG0136 dung tích 1.2L phù hợp với gia đình 3-5 người. Sử dụng nồi có dung tích phù hợp sẽ giúp tiết kiệm điện năng, chi phí và chất lượng cơm ngon hơn.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/06/eb/6a/95024b6351a5975fffa25eaf4e05a9be.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch5\u003eLòng nồi dạng niêu phủ chống dính cao cấp an toàn vệ sinh thực phẩm\u003c/h5\u003e\n\u003cp\u003eLòng nồi phủ chống dính Whitford cao cấp khó bong tróc, không chứa PFOA vệ sinh an toàn thực phẩm, an toàn cho sức khỏe người tiêu dùng, dễ dàng vệ sinh sau mỗi lần sử dụng.\u003c/p\u003e\n\u003cp\u003eLòng nồi dạng niêu lấy cảm hứng từ nồi niêu đất truyền thống, tạo dòng sôi tuần hoàn, là bí quyết giúp cơm chín đều và ngon hơn. Thành nồi dày dặn, giữ nhiệt tốt hơn, hương vị được giữ trọn vẹn.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/e3/c6/fa/845ac78a345a8d3e9e4e6018147bcf7a.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/57/2b/f5/cfceed5f9637869af2e0bea64a5ec513.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch5\u003eMâm nhiệt dạng cong ôm trọn lòng nồi truyền nhiệt tốt, giữ nhiệt lâu\u003c/h5\u003e\n\u003cp\u003eMâm nhiệt lớn gia nhiệt tốt hơn, được thiết kế đặc biệt dạng cong ôm trọn lòng nồi, tăng khả năng truyền nhiệt giúp cơm chín nhanh, dẻo và thơm hơn.\u003c/p\u003e\n\u003ch5\u003eBảng điều khiển điện tử bằng Tiếng Việt dễ sử dụng\u003c/h5\u003e\n\u003cp\u003eBảng điều khiển điện tử bằng Tiếng Việt dễ sử dụng kể cả cho người cao tuổi, người giúp việc hay những người lần đầu tiên sử dụng hoặc ít sử dụng.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/5a/1c/19/7cbdf09f87cec2e4f94c04ec71d7b3f5.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch5\u003eTích hợp 11 Chương trình nấu tiện dụng\u003c/h5\u003e\n\u003cp\u003eNồi cơm điện tử NAG0136 tích hợp 11 chương trình nấu tiện dụng đáp ứng đa dạng nhu cầu: nấu cơm, nấu cơm gạo dẻo, nấu cơm gạo lứt, nấu nhanh, hấp, nấu cháo đặc, nấu cháo loãng, nấu cháo trẻ em, nấu cháo thập cẩm, làm bánh và đặc biệt là chế độ nấu cơm giảm tinh bột độc đáo. Với 11 chương trình nấu đa dạng, người sử dụng có thể thỏa thích chế biến các món ngon đúng vị, phù hợp cho cả gia đình có người già, trẻ em.\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/be/79/76/451dabf0cc05e8e420627600c20487ba.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch5\u003eDễ dàng vệ sinh, di chuyển khi sử dụng\u003c/h5\u003e\n\u003cp\u003eCác bộ phận của nồi như nắp trong, lòng nồi, van thoát hơi, dễ tháo ra để cọ rửa, đảm bảo vệ sinh cho những lần sử dụng sau. Quai xách tiện dụng, nhỏ gọn dễ bảo quản và di chuyển.\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/d6/c9/a0/90038fadfdf695ad272c3e6c49e21a06.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/80/f5/e3/da1b6b8a65b92fb48f26084ad6992364.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/77/55/4f/9c3d18fdcdf793a8a2bed064ccb3453c.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/77/55/4f/9c3d18fdcdf793a8a2bed064ccb3453c.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/77/55/4f/9c3d18fdcdf793a8a2bed064ccb3453c.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/77/55/4f/9c3d18fdcdf793a8a2bed064ccb3453c.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/77/55/4f/9c3d18fdcdf793a8a2bed064ccb3453c.png"},{"base_url":"https://salt.tikicdn.com/ts/product/62/bc/9f/0e4f5e249f607e98d53043844eb8f891.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/62/bc/9f/0e4f5e249f607e98d53043844eb8f891.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/62/bc/9f/0e4f5e249f607e98d53043844eb8f891.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/62/bc/9f/0e4f5e249f607e98d53043844eb8f891.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/62/bc/9f/0e4f5e249f607e98d53043844eb8f891.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/24/68/04/d6e28afd825b9f901d1ef259ce2a77c9.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/24/68/04/d6e28afd825b9f901d1ef259ce2a77c9.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/24/68/04/d6e28afd825b9f901d1ef259ce2a77c9.png","position":null,"small_url":"https: