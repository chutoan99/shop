umbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ce/92/31/6d7e7f1483dc1c6626dc5cae3b15b3e0.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":685,"all_time_quantity_sold":157,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cdiv style=\"text-align:center;\"\u003e\u003cstrong\u003eGiận - Thích Nhất Hạnh\u003c/strong\u003e\u003cbr /\u003e\u003cbr /\u003e \u003c/div\u003e\n\u003cp\u003eKhi ta giận, khi một ai đó làm cho ta giận, ta phải trở về với thân tâm và chăm sóc cơn giận của mình. Không nên nói gì hết. Không nên làm gì hết. Khi đang giận mà nói năng hay hành động thì chỉ gây thêm đổ vỡ mà thôư thế là không khôn ngoan. Phải trở về dập tắt lửa trước đã\u003c/p\u003e\n\u003cp\u003eGiận là một cuốn sách  hay của Thiền sư Thích Nhất Hạnh, nó mở ra cho ta những khả năng kỳ diệu, nhưng lại rất dễ thực hành để ta tự mình từng bướát khỏi cơn giận và sống đẹp với xã hội quanh mình.\u003c/p\u003e\n\u003cp\u003eGiận được xuất bản tại Hoa Kỳ ngày 10.9.2001, trước biến cố 11.9.2001 có một ngày. Vì thế Giận đã trở thành quyển sách bán chạy nhất Hoa Kỳ - 50.000 bản mỗi tuần - trong vòng 9 thá\u003c/p\u003e\n\u003cp\u003eTại Hàn Quốc, quyển sách \u003cstrong\u003eGiận \u003c/strong\u003enày đã bán được 1 triệu bản trong vòng 11 tháng. Rất nhiều độc giả nhờ đọc sách này mà đã điều phục được tâm mình, sử dụng ái ngữ lắng nghe để hoà giải với người thân, đem lại hạnh phúc trong gia đình và trong cộng đồng của họ.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ce/92/31/6d7e7f1483dc1c6626dc5cae3b15b3e0.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ce/92/31/6d7e7f1483dc1c6626dc5cae3b15b3e0.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ce/92/31/6d7e7f1483dc1c6626dc5cae3b15b3e0.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ce/92/31/6d7e7f1483dc1c6626dc5cae3b15b3e0.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ce/92/31/6d7e7f1483dc1c6626dc5cae3b15b3e0.jpg"}],"warranty_policy":null,"authors":[{"id":545903,"name":" Thích Nhất Hạnh","slug":"thich-nhat-hanh"}],"current_seller":{"id":7247,"sku":"9712456549381","name":"Alpha Books Official","link":"https://tiki.vn/cua-hang/alphabooks-official","logo":"38/74/f3/f9cf41005697c643397d9b09d335f4c4.jpg","price":121000,"product_id":"216198469","store_id":7082,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[{"id":127989,"name":"Times Books","link":"https://tiki.vn/cua-hang/times-books","logo":"a6/11/12/d2b1e40937a3a9953075558b8a80ff2c.png","price":134595,"product_id":"215779786","store_id":118250},{"id":281062,"name":"Bamboo Books","link":"https://tiki.vn/cua-hang/bamboo-books","logo":"46/9a/b3/e4fbfd97e7607ea4d2ff8e9ad769121b.jpg","price":121500,"product_id":"247856102","store_id":268132},{"id":161219,"name":"Nhà Sách Trẻ Online","link":"https://tiki.vn/cua-hang/nha-sach-tre-online","logo":"6f/c0/15/6a56eb097a331c384398004ed5bc09ca.jpg","price":134865,"product_id":"248608360","store_id":148433},{"id":10821,"name":"nha sach nguyet linh","link":"https://tiki.vn/cua-hang/nha-sach-nguyet-linh","logo":"https://vcdn.tikicdn.com/ts/seller/88/2b/d0/eaa1eadc8566bf565288bb245d07f952.jpg","price":128250,"product_id":"273318034","store_id":10595},{"id":295057,"name":"HỆ THỐNG NHÀ SÁCH ABC","link":"https://tiki.vn/cua-hang/he-tho