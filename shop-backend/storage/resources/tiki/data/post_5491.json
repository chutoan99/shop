":"any_reason"}},"discount":3000,"discount_rate":9,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/60/4e/d7/8eaa6ec1977298c504368b20efa0fdcc.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":377,"all_time_quantity_sold":5,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003carticle class=\"4ever-article\"\u003e\n\u003cp\u003e*ĐẶC BIỆT KHÔNG THÊM ĐƯỜNG, KHÔNG CHẤT BẢO QUẢN, KHÔNG PHẨM MÀU, SẢN PHẨM ĐẠT CHUẨN XUẤT KHẨU \u003c/p\u003e\n\u003cp\u003eCHÂU ÂU\u003c/p\u003e\n\u003cp\u003eThông tin sản phẩm\u003c/p\u003e\n\u003cp\u003eTên sản phẩm: Khoai môn sấy giòn Nonglamfood túi 100g | \u003c/p\u003e\n\u003cp\u003eThương hiệu: Nonglamfood - Lưu Giữ Giá Trị Thiên Nhiên\u003c/p\u003e\n\u003cp\u003eKhối lượng tịnh / Thể tích thực: 100g\u003c/p\u003e\n\u003cp\u003eHạn sử dụng: 12 tháng\u003c/p\u003e\n\u003cp\u003eThành phần: Khoai môn (99%), dầu thực vật.\u003c/p\u003e\n\u003cp\u003eCông dụng:\u003c/p\u003e\n\u003cp\u003e️ Khoai môn cung cấp chất xơ, nhiều Vitamin và khoáng chất. …\u003c/p\u003e\n\u003cp\u003e️ Khoai môn chứa Polyphenol và chất chống oxy hóa giúp chống lại sự phát triển của tế bào ung thư và bảo vệ cơ thể khỏi stress oxy hóa.\u003c/p\u003e\n\u003cp\u003e️ Nhiều chất xơ: Nguồn chất xơ dồi dào. Sau khi sấy, khoai môn giữ được lượng chất xơ cao gấp gần 4 lần so với khi còn tươi (so sánh cùng trọng lượng). .\u003c/p\u003e\n\u003cp\u003e️ Khoai môn còn chứa rất nhiều khoáng chất như Phosphorus, Magnesium và Potassium (Kali) điều hòa chức năng tim và huyết áp.\u003c/p\u003e\n\u003cp\u003eHướng dẫn bảo quản: Nơi khô ráo thoáng mát. Tránh ánh nắng mặt trời chiếu trực tiếp vào sản phẩm.\u003c/p\u003e\n\u003cp\u003eHướng dẫn sử dụng: Ăn liền sau khi mở túi, đóng kín túi sau khi mở và dùng hết trong 10 ngày.\u003c/p\u003e\n\u003cp\u003eThông tin lưu ý: Không sử dụng đối với người có khả năng mẫn cảm hoặc dị ứng với các thành phần trong sản phẩm.\u003c/p\u003e\n\u003cp\u003eNonglamfood là thương hiệu thuần Việt chuyên sản xuất và phân phối các dòng trái cây sấy, hạt dinh dưỡng và thanh gạo lứt.\u003c/p\u003e\n\u003cp\u003e7 Lý do tin chọn Nonglamfood:\u003c/p\u003e\n\u003cp\u003e️ Được 95% người tiêu dùng bình chọn yêu thích nhất bởi hương vị \"chuẩn tự nhiên\"\u003c/p\u003e\n\u003cp\u003e️ Thương hiệu đã đạt được các chứng chỉ uy tín trong lĩnh vực chế biến nông sản có lợi cho sức khỏe: Hàng Việt Nam Chất Lượng Cao, HACCP,\u003c/p\u003e\n\u003cp\u003e ISO 22000, GMP, BRC\u003c/p\u003e\n\u003cp\u003e️ Các sản phẩm của Nonglamfood được nghiên cứu và phát triển bởi các nhà khoa học trường ĐH Nông Lâm và ĐH Ghent, Bỉ - thuộc top 100 trường đại học tốt nhất thế giới\u003c/p\u003e\n\u003cp\u003e️ Quy trình chế biến tiên tiến, hiện đại đến từ Hàn Quốc giúp sản phẩm dẻo mềm, thơm ngon mà vẫn lưu giữ được hàm lượng dinh dưỡng.\u003c/p\u003e\n\u003cp\u003e️ Nguyên liệu được tuyển chọn kỹ lưỡng, giữ trọn vẹn hương vị và giá trị thiên nhiên\u003c/p\u003e\n\u003cp\u003e️ Sản phẩm của Nonglamfood đã có mặt tại khắp các chuỗi hệ thống siêu thị, cửa hàng tiện lợi\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/21/86/0e/1db901f1b6adee8848593ace4a9bc985.jpg\" alt=\"21860ed43e04503aee0ec19631f7efa4.jpg\" width=\"0\" height=\"0\" /\u003e cùng các cửa hàng thực phẩm sạch, đặc sản và quà tặng trên toàn quốc\u003c/p\u003e\n\u003cp\u003e️ Các sản phẩm trái cây sấy của Nonglamfood là mặt hàng được yêu thích tại nhiều nước trên thế giới, đặc biệt là các thị trường khó tính như EU, Nhật, Úc, Singapore,v.v.\u003c/p\u003e\n\u003c/article\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/60/4e/d7/8eaa6ec1977298c504368b20efa0fdcc.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/60/4e/d7/8eaa6ec1977298c504368b20efa0fdcc.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/60/4e/d7/8eaa6ec1977298c504368b20efa0fdcc.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/60/4e/d7/8eaa6ec1977298c504368b20efa0fdcc.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/60/4e/d7/8eaa6ec1977298c504368b20efa0fdcc.png"},{"base_url":"https://salt.tikicdn.com/ts/product/c0/c7/5f/135b24529d10a8e89e195eb2ccc3bae5.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c0/c7/5f/135b24529d10a8e89e195eb2ccc3bae5.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c0/c7/5f/135b24529d10a8e89e195eb2ccc3bae5.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c0/c7/5f/135b24529d10a8e89e195eb2ccc3bae5.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c0/c7/5f/135b24529d10a8e89e195eb2ccc3bae5.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/08/2a/21/80e7d81ed8da0175814071f8700202dd.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/08/2a/21/80e7d81ed8da0175814071f8700202dd.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/08/2a/21/80e7d81ed8da0175814071f8700202dd.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/08/2a/21/80e7d81ed8da0175814071f8700202dd.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/08/2a/21/80e7d81ed8da0175814071f8700202dd.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/e6