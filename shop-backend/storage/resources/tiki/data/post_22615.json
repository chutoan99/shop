dge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.7,"review_count":6,"review_text":"(6)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/eb/1c/a0/436816c697b28ca398a844cf9ca2172a.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":625,"all_time_quantity_sold":24,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eTai Nghe Bluetooth 5.3 Chính Hãng Soundpeats Capsule 3 Pro ️ Game Mode 70ms ️ Hi Res Audio LDAC ️ Pin 52h ️ Hỗ trợ app\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003eTai nghe Bluetooth Soundpeats Capsule 3 Pro mẫu tai nghe không dây thứ 3 của nhà SoundPEATS sở hữu công nghệ âm thanh chất lượng cao Hi-Res và các công nghệ \"đỉnh\" với 6 mic giúp chất lượng thoại tốt nhất, hỗ trợ chống ồn chủ động ANC lên đến -43db.\u003c/p\u003e\n\u003cp\u003e️ Công nghệ âm thanh Hi-Res Audio chất lượng cao với bộ giải mã âm thanh LDAC\u003cbr /\u003eHi-Res Audio (HAR) được viết tắt từ cụm từ High-Resolution, đây là khái niệm để diễn tả định dạng âm thanh có độ nét và chất lượng cao. HAR có chất lượng lượng vượt trội hơn cả Compact Disc Digital Audio – CD (tiêu chuẩn chất lượng của nhạc số). Soundpeats Capsule 3 Pro là mẫu tai nghe thứ 2 của nhà SoundPEATS sở hữu công nghệ âm thanh Hi-Res chất lượng cao này.\u003c/p\u003e\n\u003cp\u003eĐồng thời tai nghe Bluetooth Soundpeats Capsule 3 Pro còn được hỗ trợ bộ giải mã âm thanh LDAC. Cho phép người sử dụng tai nghe có thể nghe nhạc Hi-Res với chất lượng đạt mức 96kHZ/24 bit và tốc độ truyền băng thông tối đa là 990kbps. Tốc độ truyền tải âm thanh của LDAC nhanh hơn nhiều so với aptX của Qualcomm hoặc SBC.\u003c/p\u003e\n\u003cp\u003e️ Có chế độ Mode Game để chơi game thuận tiện hơn, độ trễ 70ms giúp giảm hiện tượng lệch tiếng và hình\u003c/p\u003e\n\u003cp\u003e️ Chống ồn chủ động lên đến -43db, cho bạn một không gian hoàn toàn riêng tư để thưởng thức âm nhạc của riêng mình. Tai nghe cũng hỗ trợ Chế độ xuyên âm\u003c/p\u003e\n\u003cp\u003e️ Driver 12mm cho phép tái tạo âm thanh chân thực.\u003c/p\u003e\n\u003cp\u003e️ Cuộc gọi không tiếng ồn\u003cbr /\u003eCông nghệ Mic kép ENC chặn tiếng ồn xung quanh lên đến 80%, chất lượng cuộc gọi được tối ưu hóa. Dù bạn ở trong môi trường có độ ồn lớn, tai nghe Bluetooth SoundPEATS Mini HS vẫn có thể giúp bạn thoải mái trò chuyện cùng bạn bè. Tiếng ồn được triệt tiêu hoàn hảo, cho bạn cảm giác như đang trò chuyện trực tiếp.\u003c/p\u003e\n\u003cp\u003e️ Kiểm soát mọi tác vụ thông qua APP\u003cbr /\u003eThoải mái tùy chỉnh các trải nghiệm âm thanh của riêng bạn như là: Đặt EQ, âm lượng, điều chỉnh chọn bài, chế độ trò chơi… Kiểm soát dễ dàng, tiện lợi và nhanh chóng hơn bao giờ hết.\u003c/p\u003e\n\u003cp\u003e#soundpeats #air3pro #capsule3pro #capsulepro #minipro #miniprohs #truewireless #bluetoothheadphone #tainghekhongday #hiresaudio #ldac\u003c/p\u003e\n\u003cp\u003eTHÔNG SỐ KỸ THUẬT\u003cbr /\u003e1.Sensitivity: 102±3dB\u003cbr /\u003e2.Resistance: 32Ω\u003cbr /\u003e3.Frequency Response Range: 20-40000Hz\u003cbr /\u003e4.Codecs: SBC,LDAC\u003cbr /\u003e5.Active Noise-Cancellation: Yes\u003cbr /\u003e6.Bluetooth Version: Bluetooth V5.3\u003cbr /\u003e7.Bluetooth Prole: HSP 、HFP 、 A2DP、AVRCP\u003cbr /\u003e8.Bluetooth Chipset: WQ7033AR\u003cbr /\u003e9.Maximun Working Range: 33feet/10m(no abstacle)\u003cbr /\u003e10.Play Time: About 8 hours (volume Lower than 60% \u0026amp; ANC OFF)\u003cbr /\u003e10.Earbuds Charging Time: About 1 hour\u003cbr /\u003e11.Charging Case Charging Time: About 2 hours\u003cbr /\u003e12.Charging Case Recharge Earbuds: About 5.5 times\u003cbr /\u003e13.Earbud Power Capacity: 3.7V/70mAh (35mAh*2)\u003cbr /\u003e14.Charging Case Power Capacity: 3.7V/500mah\u003cbr /\u003e15.Earbud Dimension(L*W*H): 33.57x21.53x25.61mm\u003cbr /\u003e16.Charging Case Dimension(L*W*H): 50.07x67.31x25.9mm\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003eNhà sản xuất: SHENZHEN GINTO E-COMMERCE CO., LTD\u003cbr /\u003eĐịa chỉ: Room 1308-1309, Building B, Huihai Square, Chuangye Road, Longhua District, Shenzhen, China, 518109\u003cbr /\u003eXuất xứ: China\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/eb/1c/a0/8c2f8ff95153787d7bfd7d059fc523de.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/6a/79/82/3f5e2cb39f9ac671cc834de4f2f19cac.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/c5/5f/e4/26f2ebcf30c15d0288e1c0accd7a810f.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/0e/69/31/5f9211de632b923c14547d8bf79f009c.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/9e/08/56/40645980759662131f71cbad19c23d27.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/e6/97/cf/58482cf801eddc7cef1306fe6f6b2d5b.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/38/d3/0d/c2f637c55bba0fff45ce788bd5faf369.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003c