,{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/42/b3/ec/f17d6275282861a0885cd857b4a982b9.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":452,"all_time_quantity_sold":5,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003carticle class=\"4ever-article\"\u003e\u003cp\u003eBình Pha Trà BEAR SB-PT15K 1,5L 1000W Giữ Nhiệt Hẹn Giờ Lên Đến 9 Tiếng Bảo Hành 18 Tháng\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/7d/07/92/23e44cf88683dc2265df0f39c6ac58f4.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003carticle class=\"4ever-article\"\u003e\u003cp\u003eLý do nên mua Bình Pha Trà BEAR SB-PT15K\u003c/p\u003e\n\u003cp\u003e-Thiết kế trang nhã, hiện đại với gam màu đặc biệt.\u003c/p\u003e\n\u003cp\u003e-8 chức năng chính, đơn giản hóa quá trình chế biến.\u003c/p\u003e\n\u003cp\u003e-Cài đặt hẹn giờ chỉ bằng 1 nút bấm.\u003c/p\u003e\n\u003cp\u003e-Thời gian hẹn giờ lên đến 9.5 giờ.\u003c/p\u003e\n\u003cp\u003e-Nhiều mức độ giữ nhiệt khác nhau.\u003c/p\u003e\n\u003cp\u003e-Tùy ý điều chỉnh mức độ giữ ấm phù hợp.\u003c/p\u003e\n\u003cp\u003e-Dung tích 1.5L thuận tiện khi đun nấu.\u003c/p\u003e\n\u003cp\u003e-Lưới lọc inox 304 không gỉ, an toàn khi sử dụng.\u003c/p\u003e\n\u003cp\u003e-Bình thủy tinh có khả năng chịu nhiệt cao.\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/26/39/84/71243a26c77afcab59b0fe1789f58fbc.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/83/b5/fb/0e1dbc69efedceafbad84c6abc6bc879.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003carticle class=\"4ever-article\"\u003e\u003cp\u003e Thiết kế, kiểu dáng hiện đại.\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/9d/08/3c/41ed0f58433ebc0fc18fc1c975f879d2.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/b0/5b/85/eea8b731018f8c4d289b1c9c4c17ab63.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003carticle class=\"4ever-article\"\u003e\u003cp\u003e Công suất hoạt động mạnh mẽ: với công suất 1000W, chỉ cần chờ đợi trong một vài phút, bạn đã có thể thưởng thức những ly trà, ly cà phê, nước nóng thơm ngon, đậm vị.\u003c/p\u003e\n\u003cp\u003e Cài đặt hẹn giờ đơn giản.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/b0/f3/a2/71e11565bbe5a600d8c1278d789fd146.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003carticle class=\"4ever-article\"\u003e\u003cp\u003e Thao tác sử dụng dễ dàng: bảng điều khiển cảm ứng nhạy bén, giúp bạn dễ dàng điều chỉnh nhiệt độ chỉ bằng một nút nhấn\u003c/p\u003e\n\u003cp\u003e Giữ nhiệt cực tốt\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/92/e5/b1/4fe5534080e17cbdfcfd642b7303db94.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/bc/3a/7f/e25841d9f014d2388bdfc75fcc125086.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003carticle class=\"4ever-article\"\u003e\u003cp\u003eThao tác sử dụng dễ dàng \u003c/p\u003e\n\u003cp\u003e Chất liệu an toàn khi sử dụng: khả năng chịu được nhiệt độ nóng - lạnh tốt, giúp chiếc bình có thể hạn chế được tình trạng bị nứt vỡ do nhiệt độ thay đổi đột ngột. Bộ lọc của bình được làm bằng inox 304 không gỉ, an toàn khi tiếp xúc trực tiếp với nguyên liệu.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/37/96/d6/358a8c59493d797764c70cafb6d19dbe.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/5a/5b/6a/5d397f872467571142848cc4c0f767fb.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003carticle class=\"4ever-article\"\u003e\u003cp\u003e Tích hợp nhiều tính năng: Bạn hoàn toàn có thể tận hưởng sự tiện lợi và thú vị khi nấu nướng, trong suốt quá trình sử dụng chiếc bình pha trà giữ nhiệt Bear.  Với những tính năng đặc biệt như đun nước - nấu đồ ngọt - nấu cháo trắng - canh thuốc - pha trà - nấu súp - giữ ấm - hẹn trước, giúp đơn giản hóa quá trình chế biến món ăn.\u003c/p\u003e\n\u003carticle class=\"4ever-article\"\u003e\u003cp\u003eThông số kỹ thuật:\u003c/p\u003e\n\u003cp\u003e- Tên sản phẩm: Bình pha trà giữ nhiệt.\u003c/p\u003e\n\u003cp\u003e- Hãng sản xuất: Bear.\u003c/p\u003e\n\u003cp\u003e- Mã sản phẩm: SB-PT15K.\u003c/p\u003e\n\u003cp\u003e- Chất liệu: Bình được làm từ thủy tinh borosilicate chịu lực và chịu nhiệt tốt.\u003c/p\u003e\n\u003cp\u003e- Bộ lọc: Lõi lọc được làm bằng inox không gỉ 304.\u003c/p\u003e\n\u003cp\u003e- Dung tích: 1.5L.\u003c/p\u003e\n\u003cp\u003e- Công suất hoạt động: 1000W.\u003c/p\u003e\n\u003cp\u003e- Điện áp định mức: 220V ~ 50Hz.\u003c/p\u003e\n\u003cp\u003e- Kích thước (L x W x H): 222 x 212 x 250 (mm) \u003c/p\u003e\n\u003cp\u003e- Bộ phụ kiện: 1 nắp đậy - 1 bình đun - 1 thân đế bình - 1 lưới lọc thực phẩm.\u003c/p\u003e\n\u003cp\u003e- Xuất xứ: Trung Quốc.\u003c/p\u003e\n\u003cp\u003e- Bảo hành: 18 tháng.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/9b/59/38/57d40100b898cf4760721318846bc429.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003carticle class=\"4ever-article\"\u003e\u003cp\u003eHướng dẫn sử dụng\u003c/p\u003e\n\u003cp\u003eTrong quá trình sử dụng, ấm siêu tốc có dấu hiệu bị hoen. Đây là hiện tượng thông thường xảy ra trong quá trình đun sôi các vệt nước bám trên thành bình. Do đó, để vệ sinh bình, bạn nên sử dụng dung dịch giấm và nước pha theo tỷ lệ 1:2 và cho vào bình, đun sôi lên. Sau đó, trong vòng 2-4 tiếng sau, bạn có thể tráng lại bằng nước sạch một lần nữa để tránh các vết hoen. Lưu ý, bạn cần tránh xa nước văng lên đế truyền nhiệt và phần ổ cắm, công tắc bật hay bất cứ chỗ nào tiếp xúc với nguồn điện.\u003c/p\u003e\n\u003cp\u003eNên rút phích cắm điện ra khỏi nguồn điện, sau đó để ấm siêu tốc nguội.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/c9/52/ff/5aa7229b8a78ae4309a500cbbcad3456.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003c/article\u003e\u003c/article\u003e\u003c/article\u003e\u003c/article\u003e\u003c/article\u003e\u003c/article\u003e\u003c/article\u003e\u003c/article\u003e\u003c/article\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/42/b3/ec/f17d6275282861a0885cd857b4a982b9.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/42/b3/ec/f17d6275282861a0885cd857b4a982b9.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/42/b3/ec/f17d6275282861a0885cd857b4a982b9.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/42/b3/e