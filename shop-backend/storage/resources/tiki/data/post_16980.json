93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.8,"review_count":25,"review_text":"(25)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/fd/0d/cc/e1dae7f0e9038bee448479ae798b5773.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1243,"all_time_quantity_sold":153,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eBộ Vệ Sinh Laptop/Macbook Cao Cấp JRC bao gồm dung dịch vệ sinh, cọ, khăn lau, dụng cụ thổi bụi, giữ cho Laptop của bạn luôn sạch sẽ, tránh bụi bẩn, đồng thời gia tăng tuổi thọ và hiệu quả hoạt động của máy.\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eChất liệu: Dung dịch vệ sinh chuyên dụng,công nghệ nano\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/cd/a7/77/5695ce86d2b711d79050c22cdd7af716.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003e1. Bộ dụng cụ vệ sinh cho Macbook, Laptop đủ đồ\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003eBộ Vệ Sinh Laptop/Macbook Cao Cấp JRC bao gồm: 2 KHĂN mịn để lau màn hình; 1 CÂY chổi quét bắt mắt; 1 LỌ dung dịch vệ sinh; 1 BÓNG thổi bụi; 1 Cốc Giấy đựng.\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003e2. Công thức tự nhiên không chứa Amoniac và cồn, an toàn\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003eSản phẩm sử dụng công thức chế tạo hoàn toàn tự nhiên không có Ammonia hay chất cồn như những dung dịch làm sạch khác trên thị trường. Vì thế, chúng không gây ảnh hưởng đến môi trường và sức khỏe người sử dụng.\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003e3. Khử trùng hiệu quả\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/ba/7a/57/cc30372779dd70b461ba87769390d97f.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eBộ Vệ Sinh Laptop/Macbook Cao Cấp JRC giúp làm sạch dấu vân tay và vết bẩn, khử trùng hiệu quat. Khăn lau được làm từ chất liệu cao cấp, mềm mại. Sản phẩm có khả năng làm sạch tốt, không để lại vết lằn sau mỗi lần sử dụng, thích hợp sử dụng cho tất cả các sản phẩm có màn hình hiển thị LCD.\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003e4. Hạn chế phai màu zin Macbook, Laptop\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003eDung dịch hạn chế làm phai màu zin máy sau thời gian dài sử dụng dung dịch cũng như không ảnh hưởng đến chất lượng và giữ an toàn cho thiết bị máy móc.\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eHướng dẫn sử dụng\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003eĐối với màn hình\u003c/p\u003e\n\u003cp\u003e– Ngắt điện các thiết bị cần vệ sinh.\u003c/p\u003e\n\u003cp\u003e– Xịt 1- 2 lần dung dịch làm sạch lên màn hình hoặc miếng vải đi kèm.\u003c/p\u003e\n\u003cp\u003e– Nhẹ nhàng làm sạch màn hình bằng vải mềm.\u003c/p\u003e\n\u003cp\u003e– Lau lại màn hình bằng phần khô còn lại của miếng vải để đảm bảo thiết bị được sạch sẽ.\u003c/p\u003e\n\u003cp\u003eĐối với các thiết bị nhựa\u003c/p\u003e\n\u003cp\u003e– Dùng chổi nhỏ để đẩy hết bụi ra khỏi thiết bị.\u003c/p\u003e\n\u003cp\u003e– Xịt 2- 3 lần dung dịch làm sạch lên miếng vải và lau lên các thiết bị nhựa.\u003c/p\u003e\n\u003cp\u003e– Để đảm bảo thiết bị được sạch sẽ, hãy lau thiết bị nhựa với phần khô còn lại của miếng vải.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tm