entic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":190000,"discount_rate":33,"rating_average":4.8,"review_count":154,"review_text":"(154)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/69/44/ea/b209bc9b7e3a5e944b0a4780586ec908.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":490,"all_time_quantity_sold":537,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch1 style=\"text-align:center\"\u003eMáy sấy tóc Lebenlang LBH3088 (2100W) của Đức, kiểu gấp gọn, chống xơ rối tóc, bảo hành 2 năm\u003c/h1\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/1b/73/74/81fe72489ba22b458652ea5c3abb877c.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eĐẶC ĐIỂM NỔI BẬT CỦA SẢN PHẨM:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eMáy sấy tóc Lebenlang LBH3088G với thiết kế gấp gọn, trong lượng nhẹ tiện lợi, màu sắc sang trọng mang lại cho mái tóc bạn sự chăm sóc thật nhẹ nhàng và hiệu quả để luôn giữ được độ ẩm và sự chắc khỏe như được làm khô tự nhiên, duy trì vẻ óng mượt và mềm mại.\u003c/p\u003e\n\u003cp\u003eCông nghệ ion giúp chống lại xơ rối sau khi sấy tóc, hỗ trợ chăm sóc tóc hàng ngày\u003c/p\u003e\n\u003cp style=\"text-align:center\"\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/e5/d7/44/18f0be5cb07f0090793dacf4d486bc56.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center\"\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/f9/4b/4d/07743d6c17f8f9517678ba2868ba6f86.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center\"\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/69/80/2f/9c5eff2d1477ced5d3eb8665220e6510.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eHoạt động hiệu quả, sấy khô tóc nhanh chóng. Hơn nữa bạn có thể tự tạo cho mình nhiều kiểu tóc khác nhau, định hình và làm bền các nếp uốn để mái tóc luôn trông thật bồng bềnh và quyến rũ mỗi ngày\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/d0/2c/5a/749c2257a52205784133d0f452ef6248.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eMáy sấy tóc Lebenlang LBH3088G có công suất 2100W được thiết kế với 2 tốc độ sấy dễ dàng chuyển đổi bằng nút.\u003c/p\u003e\n\u003cp\u003eĐầu sấy có thể tháo rời, khi gắn liền sẽ hướng gió tập trung vào nơi bạn cần tạo kiểu tóc bạn muốn nhé.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/44/ca/7e/b05d53ebfa0c5aca0a8db006133e1a49.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eCông suất: 2100W \u003cbr /\u003eĐiện áp: 220v, 50-60Hz\u003cbr /\u003eChất liệu: Nhựa PC và ABS\u003cbr /\u003e\u003cbr /\u003eHướng dẫn sử dụng:\u003cbr /\u003eMáy sấy tóc Lebenlang LBH3088G có 2 chế độ gió mạnh, nhẹ và 2 chế độ nhiệt nóng và mát phù hợp với mọi nhu cầu của khách hàng.\u003cbr /\u003eBảo hành 2 năm\u003cbr /\u003eChính sách hậu mãi theo như đang áp dụng tại Đức và châu Âu\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/f4/89/ac/3600f08f16cbc9c40cd44057d3d3b5db.jpg\" alt=\"\" width=\"750\" height=\"631\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/69/44/ea/b209bc9b7e3a5e944b0a4780586ec908.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/69/44/ea/b209bc9b7e3a5e944b0a4780586ec908.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/69/44/ea/b209bc9b7e3a5e944b0a4780586ec908.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/69/44/ea/b209bc9b7e3a5e944b0a4780586ec908.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/69/44/ea/b209bc9b7e3a5e944b0a4780586ec908.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/b7/0d/3b/a0e03a31b0eda5ae4354e4fd986d2120.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b7/0d/3b/a0e03a31b0eda5ae4354e4fd986d2120.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b7/0d/3b/a0e03a31b0eda5ae4354e4fd986d2120.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b7/0d/3b/a0e03a31b0eda5ae4354e4fd986d2120.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b7/0d/3b/a0e03a31b0eda5ae4354e4fd986d2120.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/aa/20/a5/2cc01267857f9b9ace9ba9992103a93e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/aa/20/a5/2cc01267857f9b9ace9ba9992103a93e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/aa/20/a5/2cc01267857f9b9ace9ba9992103a93e.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/aa/