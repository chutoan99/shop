ull}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ce/12/a4/16b1c92c1b3a624dd4acaba6ae7836d8.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1519,"all_time_quantity_sold":6,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eSẢN PHẨM ĐƯỢC NHẬP KHẨU CHÍNH HÃNG VÀ PHÂN PHỐI BỞI CÔNG TY CỔ PHẦN TẦM NHÌN\u003c/strong\u003e   \u003c/p\u003e\n\u003ch4\u003e\u003cstrong\u003eBẢO VỆ CHỐNG ĂN MÒN\u003c/strong\u003e\u003c/h4\u003e\n\u003cp\u003eCuốc và cào đất cầm tay Gardena 08915-20 được làm từ thép chất lượng hàng đầu và lớp phủ Duroplast chống ăn mòn và han gỉ, làm tăng thêm độ cứng cáp của sản phẩm. \u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/product/49/fa/68/9af72ba2fe2bf821373b2e01740ca01b.jpg\" alt=\"\" /\u003e\u003c/p\u003e\n\u003ch4\u003e\u003cstrong\u003eTHOẢI MÁI KHI LÀM VIỆC\u003c/strong\u003e\u003c/h4\u003e\n\u003cp\u003eTay cầm được thiết kế bọc lớp nhựa mềm mang lại cảm giác thoải mái khi làm việc, không bị trơn tuột khi cầm, giúp bạn thực hiện công việc một cách chắc chắn và hiệu quả.\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/product/c6/ba/ca/8cdf470080028c2f2fff8af77e288718.jpg\" alt=\"\" /\u003e\u003c/p\u003e\n\u003ch4\u003e\u003cstrong\u003eKẾT HỢP LINH HOẠT\u003c/strong\u003e\u003c/h4\u003e\n\u003cp\u003eCuốc và cào đất cầm tay Gardena rất linh hoạt, vì chúng có thể sử dụng cầm tay hoặc kết hợp với bất kỳ cán cầm đa năng nào của Gardena để gia tăng chiều dài tay cầm, dược thực hiện đơn giản nhờ vít nhựa xoay gắn chắc chắn vào cán cầm.\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/product/eb/c5/e1/f7c9a5efcf1fddf90b68b6aa7a0ba537.jpg\" alt=\"\" /\u003e\u003c/p\u003e\n\u003cp\u003eCHỈ NHỮNG PHẦN MÀU CAM TRÊN SẢN PHẨM LÀ CÓ THỂ ĐIỀU CHỈNH DI CHUYỂN ĐƯỢC (XOAY/ẤN/VẶN/KÉO).\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTHÔNG TIN THƯƠNG HIỆU \u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eGARDENA là Thương hiệu dẫn đầu thế giới với hơn 60 năm kinh nghiệm trong lĩnh vực sản xuất dụng cụ và thiết bị chăm sóc sân vườn tại Châu Âu, được thành lập năm 1961 tại Đức bởi Werner Kress và Eberhard Kastner. Sản phẩm Gardena đã có mặt tại hơn 80 quốc gia thông qua các Nhà Nhập khẩu và Phân phối. Kể từ năm 2006, Gardena thuộc quyền sở hữu của Tập đoàn Husqvarna AB Thụy Điển. Gardena đã trở thành Thương hiệu ưa thích của hàng triệu chủ sở hữu nhà và vườn trên toàn thế giới bởi các sản phẩm đa dạng cùng chất lượng tuyệt vời.\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ce/12/a4/16b1c92c1b3a624dd4acaba6ae7836d8.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ce/12/a4/16b1c92c1b3a624dd4acaba6ae7836d8.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ce/12/a4/16b1c92c1b3a624dd4acaba6ae7836d8.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ce/12/a4/16b1c92c1b3a624dd4acaba6ae7836d8.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/pr