, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/1e/25/3c/50235d45fe06b0b1d3f9dfa982d144c4.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/1e/25/3c/50235d45fe06b0b1d3f9dfa982d144c4.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/1e/25/3c/50235d45fe06b0b1d3f9dfa982d144c4.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1e/25/3c/50235d45fe06b0b1d3f9dfa982d144c4.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1e/25/3c/50235d45fe06b0b1d3f9dfa982d144c4.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/9c/d8/81/3eb253a0c3a27986235ca7e8ec535130.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/9c/d8/81/3eb253a0c3a27986235ca7e8ec535130.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/9c/d8/81/3eb253a0c3a27986235ca7e8ec535130.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9c/d8/81/3eb253a0c3a27986235ca7e8ec535130.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9c/d8/81/3eb253a0c3a27986235ca7e8ec535130.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/5c/1f/7c/f810a6d6c4a20d658893429afc38b85a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/5c/1f/7c/f810a6d6c4a20d658893429afc38b85a.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/5c/1f/7c/f810a6d6c4a20d658893429afc38b85a.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5c/1f/7c/f810a6d6c4a20d658893429afc38b85a.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5c/1f/7c/f810a6d6c4a20d658893429afc38b85a.jpg"}],"warranty_policy":nu