,"rating_average":4.8,"review_count":13,"review_text":"(13)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/34/8b/f4/f8cd551db0d9af422e2c2a607d8caa50.jpeg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1090,"all_time_quantity_sold":37,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cdiv class=\"title_text\"\u003eĐặc điểm nổi bật\u003c/div\u003e\n\u003cul\u003e\n\u003cli\u003eNồi cơm điện có dung tích 1.8 lít thích hợp \u003cstrong\u003echo 4 – 6 người\u003c/strong\u003e dùng.\u003c/li\u003e\n\u003cli\u003eCông suất 800 W, cho thời gian nấu nhanh, \u003cstrong\u003etiết kiệm điện năng\u003c/strong\u003e.\u003c/li\u003e\n\u003cli\u003eNồi nấu \u003cstrong\u003ecơm chín đều, ngon \u003c/strong\u003evới công nghệ nấu 3D.\u003c/li\u003e\n\u003cli\u003eLòng nồi bằng hợp kim nhôm tráng chống dính Diamond Titanium \u003cstrong\u003ebền bỉ\u003c/strong\u003e.\u003c/li\u003e\n\u003cli\u003eBảng điều khiển nút nhấn có màn hình hiển thị, \u003cstrong\u003ehẹn giờ nấu 24 tiếng tiện lợi.\u003c/strong\u003e\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eNhiều chế độ nấu\u003c/strong\u003e gồm: nấu gạo trắng, gạo trộn, nấu nhanh, làm bánh…\u003cbr /\u003e\n\u003cdiv\u003e\n\u003ch3\u003eNồi cơm điện Toshiba RC-18NTFVN(W) thiết kế chắc chắn, màu trắng sang trọng\u003c/h3\u003e\n\u003c/div\u003e\n\u003cp\u003eGóp phần tôn thêm nét đẹp hiện đại của mọi không gian bếp.\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"lazy\" title=\"Nồi cơm điện tử Toshiba 1.8 lít RC-18NMFVN(WT)\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/d2/3c/fa/ef40b1dac7137c14069066cb7e134aa0.jpg\" alt=\"Nồi cơm điện tử Toshiba 1.8 lít RC-18NMFVN(WT)\" data-src=\"https://salt.tikicdn.com/cache/w750/ts/product/d2/3c/fa/ef40b1dac7137c14069066cb7e134aa0.jpg\" /\u003e\u003c/p\u003e\n\u003ch3\u003eDung tích 1.8 lít đáp ứng nhu cầu cơm cho gia đình 4 – 6 thành viên\u003c/h3\u003e\n\u003cp\u003e\u003cimg class=\"lazy\" title=\"Nồi cơm điện tử Toshiba 1.8 lít RC-18NMFVN(WT)\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/f8/63/02/413f635fe6290a808f2b62aa08b5adb2.jpg\" alt=\"Nồi cơm điện tử Toshiba 1.8 lít RC-18NMFVN(WT)\" data-src=\"https://salt.tikicdn.com/cache/w750/ts/product/f8/63/02/413f635fe6290a808f2b62aa08b5adb2.jpg\" /\u003e\u003c/p\u003e\n\u003ch3\u003eNấu cơm nhanh chín, tiết kiệm điện với công suất 800 W cùng công nghệ nấu 3D\u003c/h3\u003e\n\u003cp\u003e\u003cimg class=\"lazy\" title=\"Nồi cơm điện tử Toshiba 1.8 lít RC-18NMFVN(WT)\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/b8/33/b4/b556a26a94d6ee0a97fb107cfc5d1d7d.jpg\" alt=\"Nồi cơm điện tử Toshiba 1.8 lít RC-18NMFVN(WT)\" data-src=\"https://salt.tikicdn.com/cache/w750/ts/product/b8/33/b4/b556a26a94d6ee0a97fb107cfc5d1d7d.jpg\" /\u003e\u003c/p\u003e\n\u003ch3\u003eLòng nồi 3 lớp dày 4 mm, bằng hợp kim nhôm phủ lớp chống dính cao cấp Diamond Titanium bền bỉ\u003c/h3\u003e\n\u003cp\u003eAn toàn cho sức khỏe, cho hạt cơm chín tơi, ngon và dễ chùi rửa sau khi dù\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"lazy\" title=\"Nồi cơm điện tử Toshiba 1.8 lít RC-18NMFVN(WT)\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/25/30/38/ee638a9f1794b9753d1a670ae13dc9a6.jpg\" alt=\"Nồi cơm điện tử Toshiba 1.8 lít RC-18NMFVN(WT)\" data-src=\"https://salt.tikicdn.com/cache/w750/ts/product/25/30/38/ee638a9f1794b9753d1a670ae13dc9a6.jpg\" /\u003e\u003c/p\u003e\n\u003ch3\u003eNhiều chế độ nấu tự động, giữ ấm, hâm nóng, hẹn giờ nấu tiện dụng với bảng điều khiển điện tử có màn hình hiển thị\u003c/h3\u003e\n\u003cp\u003eCác chế độ nấu tự động như: nấu gạo trắng, gạo trộn, nấu nhanh, nấu cháo, lên men làm bánh, làm bánh ngọt, nấu súp, luộc trứng, hấ giúp bạn chế biến các món ăn đa dạng, dễ dàng.\u003c/p\u003e\n\u003ctable border=\"1\" cellspacing=\"1\" cellpadding=\"1\"\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd\u003e\n\u003cp\u003e\u003cstrong\u003eChức năng nấu trên bảng điều khiển\u003c/strong\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003cp\u003e\u003cstrong\u003eThời gian nấu mặc định (phút)\u003c/strong\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\n\u003cp\u003eGạo trắng (white Rice)\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003cp\u003e38 - 51 phút\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\n\u003cp\u003eNấu nhanh (quick cook)\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003cp\u003e34 - 43 phút\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\n\u003cp\u003eGạo trộn (mixed rice)\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003cp\u003e44 - 48 phút\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\n\u003cp\u003eGạo nếp (cook)\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003cp\u003e37 - 46 phút\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\n\u003cp\u003eNấu cháo (congee)\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003cp\u003e76 - 80 phút\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\n\u003cp\u003eNồi cơm điện tử Toshiba 1.8 lít RC-18NMFVN với các nút bấm có chú thích chức năng sử dụng rõ ràng giúp bạn điều chỉnh các chức năng, chế độ nấu dễ dàng, chính xác.\u003c/p\u003e\n\u003cp\u003eNgoài ra, nồi cơm điện tử còn có chức năng hâm nóng, giữ ấm đến 30 giờ, hẹn giờ nấu tới 24 giờ đem đến cho người nội trợ nhiều sự tiện lợi khi nấu ăn.\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"lazy\" title=\"Nồi cơm điện tử Toshiba 1.8 lít RC-18NMFVN(WT)\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/f0/34/7d/29cf4ea1dcc0a3b78195050ef59981a5.jpg\" alt=\"Nồi cơm điện tử Toshiba 1.8 lít RC-18NMFVN(WT)\" widt