:null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":370000,"discount_rate":49,"rating_average":4.7,"review_count":47,"review_text":"(47)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ee/02/b6/5e2f57907122e8ee4d221750360a3268.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":783,"all_time_quantity_sold":215,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp dir=\"ltr\"\u003eBình đun nước siêu tốc Ecalite EK-G1812 là sản phẩm đang được nhiều người tin dùng hiện nay, sở hữu thiết kế bền đẹp với chất liệu bình bằng thủy tinh trong suốt chịu nhiệt tốt. Bình được hoạt động với công suất mạnh mẽ tối đa lên đến 2200W và dung tích lớn 1.8L giúp bạn có đủ lượng nước để đáp ứng cho nhiều nhu cầu sử dụng khác nhau trong cuộc sống như pha mì, pha trà, cà phê.\u003c/p\u003e\n\u003cdiv\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://ecalite.com/Uploads/binh-dun-nuoc-sieu-toc-ek-g1812.jpg\" alt=\"Bình đun nước siêu tốc Ecalite EK-G1812 dung tích 1,8l\" width=\"750\" height=\"392\" /\u003e\u003c/div\u003e\n\u003ch2\u003eThiết kế hiện đại tinh tế\u003c/h2\u003e\n\u003cp dir=\"ltr\"\u003eBình đun nước siêu tốc EK-G1812 được thiết kế với kiểu dáng sang trọng đẹp mắt. Thân ấm siêu tốc được làm bằng thủy tinh Borosilicate chịu nhiệt, dễ dàng nhìn thấy mực nước bên trong, đồng thời không bị oxy hóa nên rất an toàn cho sức khỏe người dùng và dễ dàng vệ sinh. Bên cạnh đó trên thân bình còn có hiển thị mực nước giúp bạn dễ dàng điều chỉnh lượng nước nấu phù hợp với nhu cầu dùng. Có thể nói đây là thiết bị nhà bếp không thể thiếu trong gia đình việt. \u003c/p\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://ecalite.com/Uploads/thiet-ke-hien-dai-tinh-te-voi-muc-hien-thi-nuoc-cua-binh-ek-g1812.jpg\" alt=\"Thiết kế hiện đại tinh tế của bình đun siêu tốc Ecalite EK-G1812\" width=\"750\" height=\"392\" /\u003e\u003cbr /\u003eThiết kế hiện đại tinh tế \u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cp dir=\"ltr\"\u003eĐế, nắp và tay cầm được làm bằng nhựa PP cao cấp, cách nhiệt tốt giúp bạn hoàn toàn an tâm khi sử dụng, không bị bỏng tay khi nước đang sôi. Nắp bình siêu tốc được hãng Ecalite thiết kế nút mở nắp rất tiện lợi khi mở mà không gây ra bỏng hơi nước. Ấm siêu tốc được thiết kế hiện đại, trẻ trung, màu sắc phù hợp với mọi không gian bếp trong nhà bạn.\u003c/p\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://ecalite.com/Uploads/nap-tay-cam-cua-binh-dun-nuoc-sieu-toc-ecalite-ek-g1812.jpg\" alt=\"Nắp và tay cầm được làm bằng nhựa PP của bình đun siêu tốc Ecalite EK-G1812\" width=\"750\" height=\"392\" /\u003e\u003cbr /\u003eNắp và tay cầm được làm bằng nhựa PP \u003c/div\u003e\n\u003ch2\u003eCông suất lên đến 2200W giúp tiết kiệm thời gian\u003c/h2\u003e\n\u003cp dir=\"ltr\"\u003eBình đun Ecalite EK-G1812 sở hữu mâm nhiệt bằng inox SUS 304 cao cấp sáng bóng, bền bỉ, rộng phẳng kết hợp với  công suất 1850-2200W mạnh mẽ giúp đun sôi lượng nước lớn chỉ trong vài phút rất nhanh chóng. Nhờ đó, thời gian được rút ngắn nhưng không làm giảm hiệu suất khi đun, vừa tiết kiệm điện và không làm hao nguồn điện năng khi đun nấu.\u003c/p\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://ecalite.com/Uploads/cong-suat-len-den-2200w-cua-binh-dun-sieu-toc-ek-g1812.jpg\" alt=\"Công suất lên đến 2200W của bình đun siêu tốc Ecalite EK-G1812\" width=\"750\" height=\"392\" /\u003e\u003cbr /\u003eCông suất lên đến 2200W giúp đun sôi nước nhanh\u003c/div\u003e\n\u003ch2\u003eMiệng rót kết hợp lưới lọc cặn bẩn, bã trà,...\u003c/h2\u003e\n\u003cp dir=\"ltr\"\u003eỞ miệng rót nước của bình đun siêu tốc Ecalite EK-G1812 được trang bị thêm lưới lọc nhằm đảm bảo nước không bị ọc ra ngoài khi rót. Bên cạnh đó lưới lọc còn giúp lọc các tạp chất hay bã trà đảm bảo nguồn nước rót ra sử dụng được sạch hơn, an toàn hơn và ngăn chặn các loài côn trùng xâm nhập vào bình.\u003c/p\u003e\n\u003cp dir=\"ltr\" style=\"text-align:center;\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://ecalite.com/Uploads/mieng-rot-chua-luoi-loc-cua-binh-sieu-toc-ek-g1812.jpg\" alt=\"Lưới lọc ở miệng bình đun siêu tốc Ecalite EK-G1812\" width=\"750\" height=\"392\" /\u003e\u003cbr /\u003eLưới lọc ở miệng bình đun siêu tốc Ecalite EK-G1812\u003c/p\u003e\n\u003ch2\u003eTính năng cài đặt nhiệt độ đun sôi của nước và đèn LED hiển thị theo nhiệt độ\u003c/h2\u003e\n\u003cp dir=\"ltr\"\u003eBình đun nước siêu tốc EK-G1812 được trang bị thêm các nút bấm điều khiển thông minh, cho phép người dùng cài đặt nhiệt độ sôi của nước theo mong muốn từ 60 độ C đến 100 độ C. Chức năng này đặc biệt hữu ích khi người dùng cần chọn nhiệt độ nóng đúng chuẩn để pha sữa, trà, các loại thức uống khác nhau. Chế độ tự động ngắt sẽ được kích hoạt khi nước trong bình đạt đến nhiệt độ đã chọn.\u003c/p\u003e\n\u003cp dir=\"ltr\" style=\"text-align:center;\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://ecalite.com/Uploads/cai-dat-nhiet-do-dun-soi-cua-binh-sieu-toc-ek-g1812.jpg\" alt=\"Nút bấm điều khiển thông minh của bình đun nước siêu tốc Ecalite EK-G1812\" width=\"750\" height=\"392\" /\u003e\u003cbr /\u003eNút bấm điều khiển thông minh của bình đun nước siêu tốc Ecalite EK-G1812\u003c/p\u003e\n\u003cp dir=\"ltr\"\u003eBên cạnh đó, hãng Ecalite còn trang bị thêm hệ thống đèn LED với 5 màu tương ứng với 5 nhiệt độ khác nhau nằm phía trên mâm nhiệt vừa tăng tính thẩm mỹ vừa giúp bạn theo dõi quá trình đun nước dễ dàng, tiện lợi. Bạn nên lựa chọn nhiệt độ phù hợp với nhu cầu mà mình muốn sử dụng để đạt được hiệu quả cao nhất.\u003c/p\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://ecalite.com/Uploads/he-thong-den-led-cua-binh-sieu-toc-ek-g1812.jpg\" alt=\"Hệ thống đèn LED hiện đại trên bình đun nước siêu tốc Ecalite EK-G1812\" width=\"750\" height=\"392\" /\u003e\u003cbr /\u003eHệ thống đèn LED hiện đại \u003c/div\u003e\n\u003ch2\u003eĐế tiếp điện cao cấp vừa an toàn vừa tinh tế\u003c/h2\u003e\n\u003cp dir=\"ltr\"\u003eĐế tiếp điện ấm siêu tốc là một bộ phận không thể thiếu trong cấu tạo của thiết bị này. Nó có tác dụng kết nối nguồn điện với thân bình để truyền nhiệt năng vào bình siêu tốc qua đó giúp làm nóng và đun sôi nước. Nhờ đó, giúp nâng cao hiệu quả đun nước và tăng tuổi thọ của bình đun.\u003c/p\u003e\n\u003cp dir=\"ltr\"\u003eĐế bình EK-G1812 được thiết kế xoay 360 độ linh hoạt, giúp bạn có thể đặt ấm đun nấu nước ở bất kỳ hướng nào. Ngoài ra, người dùng có thể dễ dàng nhấc và đặt bình vào đế tiếp điện nhanh chóng, tiết kiệm được thời gian.\u003c/p\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://ecalite.com/Uploads/de-tiep-dien-cua-binh-dun-nuoc-ecalite-ek-g1812.jpg\" alt=\"Đế tiếp điện cao cấp của bình đun nước siêu tốc Ecalite EK-G1812\" width=\"750\" height=\"392\" /\u003e\u003cbr /\u003eĐế tiếp điện cao cấp của bình đun nước siêu tốc Ecalite EK-G1812\u003c/div\u003e\n\u003cdiv\u003e\n\u003ch2\u003eChính sách bảo hành của bình đun siêu tốc Ecalite EK-G1812\u003c/h2\u003e\n\u003cp\u003eBình đun siêu tốc Ecalite EK-G1812 có chính sách bảo hành chính hãng 12 tháng tại nhà.\u003c/p\u003e\n\u003cp\u003eBình đun nước siêu tốc Ecalite EK-G1812 với chất lượng tốt, an toàn tiện lợi, chức năng nấu nước nhanh sôi tiết kiệm được 