 đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/d4/72/d0/47da4085ee547f7bd050084ff5ef9041.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d4/72/d0/47da4085ee547f7bd050084ff5ef9041.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d4/72/d0/47da4085ee547f7bd050084ff5ef9041.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d4/72/d0/47da4085ee547f7bd050084ff5ef9041.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d4/72/d0/47da4085ee547f7bd050084ff5ef9041.jpg"},{"base_url":"https://salt.tikicdn.com/media/catalog/product/c/a/capture_8.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/c/a/capture_8.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/c/a/capture_8.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/c/a/capture_8.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/c/a/capture_8.jpg"},{"base_url":"https://salt.tikicdn.com/media/catalog/product/p/a/panasonic-nc-sk1-electric-kettle-panasonic-nc-sk1-electric-kettle-kmz71p.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/p/a/panasonic-nc-sk1-electric-kettle-panasonic-nc-sk1-electric-kettle-kmz71p.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/p/a/panasonic-nc-sk1-electric-kettle-panasonic-nc-sk1-electric-kettle-kmz71p.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/p/a/panasonic-nc-sk1-electric-kettle-panasonic-nc-sk1-electric-kettle-kmz71p.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/p/a/panasonic-nc-sk1-electric-kettle-panasonic-nc-sk1-electric-kettle-kmz71p.jpg"},{"base_url":"h