,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/b7/1a/01/13f357e0a5257e2e2211fd800e439cbb.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":909,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp class=\"title-ar\"\u003eTHÔNG SỐ\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eDải tần lựa chọn:\u003c/li\u003e\n\u003cli\u003eDải tần số lựa chọn băng thông:\u003c/li\u003e\n\u003cli\u003eChế độ điều chỉnh: FM\u003c/li\u003e\n\u003cli\u003eTần số đáp ứng:\u003c/li\u003e\n\u003cli\u003eSố lượng kênh điều chỉnh:\u003c/li\u003e\n\u003cli\u003eĐộ nhạy đầu vào thực tế: \u0026gt;15dB\u003c/li\u003e\n\u003cli\u003eKhoảng cách hoạt động ổn định: 90 mét\u003c/li\u003e\n\u003cli\u003eTHD: \u0026lt;0.5% (@1KHz)\u003c/li\u003e\n\u003cli\u003eTỷ số S / N\u0026gt; 80dB\u003c/li\u003e\n\u003cli\u003eCông suất: ≦ 50mW\u003c/li\u003e\n\u003cli\u003eNguồn điện: DC 12-16V , 1200mA\u003c/li\u003e\n\u003cli\u003eMàn hình: LCD nền trắng + màn hình backlit nhiều màu\u003c/li\u003e\n\u003cli\u003eTrọng lượng: 3kg\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp class=\"title-ar\"\u003eMÔ TẢ\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eMicro không dây CAVS V3\u003c/strong\u003e là dòng  với hình thức sang trọng, mới mẻ. Màu vang Champagne của \u003cstrong\u003eMicro không dây CAVS V3 \u003c/strong\u003elà điểm nổi bật mà các dòng mic khác không có được. Quan trọng hơn cả, chất tiếng của CAVS V3 cực kỳ trung thực và ấm áp. Với \u003cstrong\u003eMicro không dây CAVS V3\u003c/strong\u003e, người hát sẽ cảm thấy rất thoải mái cất cao giọng hát của mình.\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eNgoại hình thiết kế mới nhất\u003c/li\u003e\n\u003cli\u003eMàu vàng Champagne\u003c/li\u003e\n\u003cli\u003eTay sơn nhám, chống bám vân tay\u003c/li\u003e\n\u003cli\u003eĐầu thu được làm bằng nhôm phay tinh xảo\u003c/li\u003e\n\u003cli\u003eMàn hình LCD tinh thể lỏng\u003c/li\u003e\n\u003cli\u003eTích hợp bộ ổn định thu phát sóng\u003c/li\u003e\n\u003cli\u003eSử dụng pin (AA) với tuổi thọ trên 6 tiếng\u003c/li\u003e\n\u003cli\u003eTầm sử dụng lên tới hơn 80m\u003c/li\u003e\n\u003cli\u003eTự động quét tần số, thu phát sóng tự động\u003c/li\u003e\n\u003cli\u003eChế động tự động ngắt thông minh: V3 sẽ tự động ngắt khi không sử dụng sau 5 giây, giúp tiết kiệm pin tối đa và tránh các tạp âm không mong muốn lọt vào mic. V3 sẽ lập tức hoạt động lại khi người sử dụng cầm mic lên mà không cần ấn công tắc\u003c/li\u003e\n\u003cli\u003eTay và chụp của micro không dây V3 được làm bằng hợp kim chống va đập, chống rỉ, siêu cứng và phủ nano chống sước, chống vân tay. Nước sơn có độ lỳ không bị bạc màu qua thời gian dài sử dụng, vẫn mới nguyên.\u003c/li\u003e\n\u003cli\u003eV3 là loại mic chuyên dùng cho Karaoke và hội trường, có khả năng lọc tạp âm. Độ nhậy cao, tiếng hát nhẹ, tròn tiếng, trong sáng, dầy và ấm.\u003c/li\u003e\n\u003cli\u003eMạch tiên tiến cung cấp khả năng chống hú và rít tối đa. Phù hợp với bất cứ loại Amply Karaoke, vang và loa nào\u003c/li\u003e\n\u003cli\u003eĐộ ổn định của CAVS V3 là rất cao\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/11/46/15/8b000bb9ad9107a1be1d6b4a9a0f6f97.jpg\" alt=\"micro-khong-day-cavs-v3\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/00/1b/c7/935bb1280033e2dae50530d62e50d658.png\" alt=\"\" width=\"1000\" heig