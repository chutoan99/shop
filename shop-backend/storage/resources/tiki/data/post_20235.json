ull,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.5,"review_count":7,"review_text":"(7)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/2b/92/f3/d85780440ce3928c1cbff11c655edf01.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2182,"all_time_quantity_sold":77,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eNƯỚC RỬA CHÉN TRUNG TÍNH HƯƠNG CAM ROCKET 600G\u003c/p\u003e\n\u003cp\u003eXuất xứ: Nhật Bản\u003c/p\u003e\n\u003cp\u003eThành phần: chất hoạt tính bề mặt, chất ổn định, dầu cam\u003c/p\u003e\n\u003cp\u003eHạn sử dụng: 36 tháng từ ngày sản xuất. Sản phẩm được bán bảo đảm còn ít nhất 324 ngày sử dụng. Lưu ý: không sử dụng sản phẩm khi hết hạn sử dụng. Hạn dùng của hàng hóa được thể hiện bằng khoảng thời gian tính từ ngày sản xuất đến ngày hết hạn hoặc thể hiện bằng ngày, tháng, năm hết hạn. Trường hợp hạn dùng chỉ thể hiện tháng, năm thì hạn dùng được tính đến ngày cuối cùng của tháng hết hạn (theo Nghị Định 43/2017/NĐ-CP)\u003c/p\u003e\n\u003cp\u003eMã: 4903367306487\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eĐẶC ĐIỂM NỔI BẬT\u003c/p\u003e\n\u003cp\u003e Nước rửa chén kết hợp với dầu cam giúp rửa sạch vết bẩn, dầu mỡ cứng đầu trên chén bát, dụng cụ làm bếp…\u003c/p\u003e\n\u003cp\u003e Hương cam thơm mát, dễ chịu.\u003c/p\u003e\n\u003cp\u003e Nước rửa chén trung tính nhẹ nhàng với da tay, không gây khô da.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eHƯỚNG DẪN SỬ DỤNG\u003c/p\u003e\n\u003cp\u003e Pha 1.5ml nước rửa chén với 1L nước, dùng mút rửa chén để rửa.\u003c/p\u003e\n\u003cp\u003e Trường hợp rửa rau quả không nên ngâm quá 5 phút.\u003c/p\u003e\n\u003cp\u003e Khi rửa dưới vòi nước: tráng lại bằng nước hơn 5 giây đối với chén bát và hơn 30 giây đối với rau quả, khi rửa trong thau, chậu: nên tráng lại với nước từ 2 lần trở lên.\u003c/p\u003e\n\u003cp\u003e Rửa tay thật sạch với nước sau khi sử dụng.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eHƯỚNG DẪN BẢO QUẢN\u003c/p\u003e\n\u003cp\u003e Bảo quản nơi thoáng mát. Tránh ánh nắng trực tiếp.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/2b/92/f3/d85780440ce3928c1cbff11c655edf01.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/2b/92/f3/d85780440ce3928c1cbff11c655edf01.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/2b/92/f3/d85780440ce3928c1cbff11c655edf01.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2b/92/f3/d85780440ce3928c1cbff11c655edf01.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2b/92/f3/d85780440ce3928c1cbff11c655edf01.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/de/e5/5c/897e661d4c4dffbadee5e5f6c4cda5f9.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/de/e5/5c/897e661d4c4dffbadee5e5f6c4cda5f9.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/de/e5/5c/897e661d4c4dffbadee5e5f6c4cda5f9.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/de/e5/5c/897e661d4c4dffbadee5e5f6c4cda5f9.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/de/e5