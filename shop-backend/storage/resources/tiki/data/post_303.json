ệ sinh sản phẩm hoặc sửa chữa cần ngắt nguồn điện và dùng vít có cán cách điện chạm vào lưới điện để xả điện.\u003c/p\u003e\n\u003cp\u003e-Ngoài trường hợp bóng đèn bị hư, các trường hợp khác nên mang sản phẩm của công ty Đại Sinh để sửa chữa.\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eVỏ ngoài: Nhựa.\u003c/li\u003e\n\u003cli\u003eKhung lưới điện: Nhựa chống cháy.\u003c/li\u003e\n\u003cli\u003eĐiện áp: 220V - 50Hz.\u003c/li\u003e\n\u003cli\u003eBóng đèn: 6W x 1.\u003c/li\u003e\n\u003cli\u003ePhạm vi: 16 m².\u003c/li\u003e\n\u003cli\u003eKích thước: 16 x 35 (cm).\u003c/li\u003e\n\u003cli\u003eTrọng lượng: 1.3 kg.\u003c/li\u003e\n\u003cli\u003eSử dụng lưới điện.\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/72/2e/da/f0de78bc62e12c54a0e2e6d89dca694c.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/72/2e/da/f0de78bc62e12c54a0e2e6d89dca694c.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/72/2e/da/f0de78bc62e12c54a0e2e6d89dca694c.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/72/2e/da/f0de78bc62e12c54a0e2e6d89dca694c.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/72/2e/da/f0de78bc62e12c54a0e2e6d89dca694c.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/14/ff/64/f6fa56d1b1858e2e12da180ee59e19c3.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/14/ff/64/f6fa56d1b1858e2e12da180ee59e19c3.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/14/ff/64/f6fa56d1b1858e2e12da180ee59e19c3.jpg","position":null,"small_url":"https://