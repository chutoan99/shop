ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":13000,"discount_rate":5,"rating_average":4.7,"review_count":3,"review_text":"(3)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/a5/fe/03/8c1ce2b356c254a84362fc379499a18b.jpeg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":849,"all_time_quantity_sold":57,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"font-style:normal;font-weight:normal;text-decoration:none;color:#000000;font-family:Arial, Helvetica, sans-serif;\"\u003eMỘT SỐ CHỦ ĐỀ SỐ HỌC HƯỚNG TỚI KÌ THI CHUYÊN TOÁN\u003c/p\u003e\n\u003cp style=\"font-style:normal;font-weight:normal;text-decoration:none;color:#000000;font-family:Arial, Helvetica, sans-serif;\"\u003eNgày nay, Số học nắm giữ vai trò trọng yếu với đời sống và khoa học. Song hành cùng Tổ hợp, Số học có mặt trong rất nhiều phân khúc của thế giới công nghệ hiện đại. Như trong Lí thuyết thông tin, Số học làm nền tảng của rất nhiều mã hóa. Nhờ số học, mật mã ngày càng có tính bảo mật cao.\u003c/p\u003e\n\u003cp style=\"font-style:normal;font-weight:normal;text-decoration:none;color:#000000;font-family:Arial, Helvetica, sans-serif;\"\u003eRiêng đối với các đề thi chuyên Toán những năm gần đây, câu Số học ngày càng chiếm nhiều điểm, từ đó trở thành mấu chốt quyết định tương lai của mỗi học sinh có nguyên vọng thí vào các trường THPT chuyên trên địa bàn toàn quốc. Một số đề thị các tỉnh thành như đề thi của Sở Giáo dục Hà Nội, đề thi của Sở Giáo dục Quảng Trị... thậm chí còn có đến 3 câu Số học. Tầm quan trọng của phần môn này trong các kì tuyển sinh cấp ba chuyên Toán cũng là một trong những động lực thôi thúc nhóm tác giả viết nên cuốn sách.\u003c/p\u003e\n\u003cp style=\"font-style:normal;font-weight:normal;text-decoration:none;color:#000000;font-family:Arial, Helvetica, sans-serif;\"\u003eCác chương, mục, tiểu mục trong sách được nhóm tác giả sắp xếp một cách chọn lọc và bài bản, chủ yếu dựa trên cơ sở là đề thi chuyên Toán khoảng 5 năm trở lại đây. Cụ thể, các vấn đề về chia hết, số nguyên tố, số chính phương và phương trình nghiệm nguyên (lần lượt nằm ở các chương I,II,III,V) xuất hiện với tần suất cao, và nhận được nhiều sự quan tâm của nhóm tác giả hơn các chương khác. Được dành nhiều không gian trong sách nhất phải kể đến chương phương trình nghiệm nguyên. Đây là chương tổng hợp các kiến thức từ các chương trước, cũng như định dạng và chỉ ra các kĩ thuật của từng kiểu, từng loại phương trình. Song, cũng không vì thế mà nhóm tác giả không cố gắng làm tốt ở các chương đa thức, bất đẳng thức, phần nguyên/phần lễ.\u003c/p\u003e\n\u003cp style=\"font-style:normal;font-weight:normal;text-decoration:none;color:#000000;font-family:Arial, Helvetica, sans-serif;\"\u003eTrái qua hơn một năm, quá trình sưu tầm, sáng tác bài toán để biên soạn nên cuốn sách đã đi đến hồi kết. Từ những ngày mày mà từng bài toán trong các shortlist, các đề thi, các cuộc thi từ nhỏ đến lớn trên từng bài báo, từng trang tin, cho đến những buổi họp xuyên đêm, tất cả đều là kỉ niệm khó quên hằn sâu trong tâm trí mỗi cá nhân của nhóm tác giả. Ý thức được việc mang đến những điều tốt đẹp nhất cho bạn đọc, nhóm tác giả luôn chăm chỉ để mỗi độc giả có thể chạm đến giấc mơ còn dang dở trước mắt – đặc biệt là với các bạn học sinh ấp ủ nguyên vọng thi vào khối chuyên Toán của các trường THPT chuyên.\u003c/p\u003e\n\u003cp style=\"font-style:normal;font-weight:normal;text-decoration:none;color:#000000;font-family:Arial, Helvetica, sans-serif;\"\u003eThắp sáng được ngọn lửa tình yêu dành cho Sổ học cần rất nhiều sự kiện nhẫn và cần củ, vì đây là phần môn được đánh giá rất khó tiếp cận với đại đa số học sinh trung học cơ sở. Giữ ngọn lửa ấy luôn rực cháy trong tim còn khó hơn\u003c/p\u003e\n\u003cdiv style=\"font-style:normal;font-weight:normal;text-decoration:none;color:#000000;font-family:Arial, Helvetica, sans-serif;width:370px;\"\u003e\u003cimg style=\"width:370px;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/53/66/5e/127fc0bfa8f3a9a2d0b86930601bbaa0.jpg\" alt=\"53665e7c603a90af8884bf370d79c99b.jpg\"\u003e\u003c/div\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cbr style=\"color:#000000;font-style:normal;font-weight:normal;text-decoration:none;\"\u003e\u003cbr\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/a5/fe/03/8c1ce2b356c254a84362fc379499a18b.jpeg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a5/fe/03/8c1ce2b356c254a84362fc379499a18b.jpeg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a5/fe/03/8c1ce2b356c254a84362fc379499a18b.jpeg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a5/fe/03/8c1ce2b356c254a84362fc379499a18b.jpeg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a5/fe/03/8c1ce2b356c254a84362fc379499a18b.jpeg"},{"base_url":"https://salt.tikicdn.com/ts/product/04/61/94/797e86e888ef9fdd32d30c4de35024c4.jpeg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/04/61/94/797e86e888ef9fdd32d30c4de35024c4.jpeg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/04/61/9