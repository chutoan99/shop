dge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":60000,"discount_rate":50,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/d5/7b/32/a5b173612197647b84c5324b1df3fcd6.png","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":154,"all_time_quantity_sold":8,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003carticle class=\"4ever-article\"\u003e\n\u003cp\u003eKính Bảo Hộ Chống Hóa Chất 3M 334  1 CAI/ TÚI\u003c/p\u003e\n\u003cp\u003eThông tin chi tiết\u003c/p\u003e\n\u003cp\u003eDòng kính an toàn 334 chống hóa chất, có lỗ thông khí kín, dây mang điều chỉnh được, tròng kính bằng vật liệu polycarbonate. Sử dụng trong nhà hoặc ngoài trời.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eKính an toàn chống hóa chất 334, vật liệu polycarbonate, dây mang điều chỉnh được. Có van thông khí gián tiếp tạo sự thông thoáng.\u003c/p\u003e\n\u003cp\u003e• Màu trong suốt.\u003c/p\u003e\n\u003cp\u003e• Vật liệu Polycarbonate hấp thụ 99.9% UV.\u003c/p\u003e\n\u003cp\u003e• Đạt chuẩn ANSI Z87.1 2003.\u003c/p\u003e\n\u003cp\u003e• 10 cái / thùng., 1 CÁI/TÚI\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eGiải pháp kinh tế\u003c/p\u003e\n\u003cp\u003eChống các chất văng bắn hóa chất\u003c/p\u003e\n\u003cp\u003eCó thể đeo kính cận và kính viễn đồng thời với Kính chống hóa chất 334\u003c/p\u003e\n\u003cp\u003eThiết kế đường viền phù hợp thoải mái và vừa vặn \u003c/p\u003e\n\u003cp\u003e \u003cstrong\u003e\u003c/strong\u003e là dòng kính bảo hộ với thiết kế tinh tế, dễ sử dụng. Giúp bảo vệ đôi mắt trước nguy cơ bụi, sương, hơi hóa chất và yếu tố văng bắn. Dùng kính chống hóa chất 3M 334 trong một số môi trường làm việc hóa chất, dầu khí, đóng tàu, cảng - ô tô, nhựa, gỗ, kim loại, dệt may, xây dựng, thực phẩm, dược phẩm…Và phù hợp với cả môi trường phòng thí nghiệm.\u003c/p\u003e\n\u003cp\u003e- Tròng kính được làm bằng vật liệu Polycarbonate hấp thụ 99.9% tia UV, với khả năng chống va đập và chống vỡ vượt trội. Mặt kính được phủ lớp chống ngưng tụ hơi nước.\u003c/p\u003e\n\u003cp\u003e- Kính được trang bị 4 khe thoát khí (2 ở trên, 2 ở hai bên) giúp giảm tình trạng tròng kính bị mờ do hơi nước, đồng thời với thiết kế khe thông minh giữ cho chất lỏng không bị thẩm thấu ngược. Có hệ thống thông hơi gián tiếp tạo sự thông thoáng.\u003c/p\u003e\n\u003cp\u003e- Dây đeo bằng vật liệu thun đàn hồi có thể điều chỉnh và mở rộng để phù hợp với từng kích thước đầu người sử dụng. Thiết kế đường viền kính thoải mái và vừa vặn.\u003c/p\u003e\n\u003cp\u003e- Thiết kế Over the glass hỗ trợ đeo kính cận. \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/product/dd/20/fb/4575863ccc017eb63610c07e4e66b18d.jpg\" alt=\"dd20fb73759233664578b0c62fd2d033.jpg\" /\u003e\u003c/p\u003e\n\u003c/article\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/d5/7b/32/a5b173612197647b84c5324b1df3fcd6.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d5/7b/32/a5b173612197647b84c5324b1df3fcd6.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d5/7b/32/a5b173612197647b84c5324b1df3fcd6.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d5/7b/32/a5b173612197647b84c5324b1df3fcd6.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d5/7b/32/a5b173612197647b84c5324b1df3fcd6.png"},{"base_url":"https://salt.tikicdn.com/ts/product/b8/2c/51/d4486c8cb6008ed807dbbe356d2b1b53.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b8/2c/51/d4486c8cb6008ed807dbbe356d2b1b53.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b8/2c/51/d4486c8cb6008ed807dbbe356d2b1b53.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b8/2c/51/d4486c8cb6008ed807dbbe356d2b1b53.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b8/2c/51/d4486c8cb6008ed807dbbe356d2b1b53.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/7a/30/94/97ca65664c61c6d7bec5d76222a8898a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/7a/30/94/97ca65664c61c6d7bec5d76222a8898a.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/7a/30/94/97ca65664c61c6d7bec5d76222a8898a.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7a/30/94/97ca65664c61c6d7bec5d76222a8898a.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7a/30/94/97ca65664c61c6d7bec5d76222a8898a.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/dd/20/fb/c91b85c5d4a35c9214a5555eeaaf8a6e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/dd/20