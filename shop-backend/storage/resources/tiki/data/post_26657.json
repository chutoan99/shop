.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":25000,"discount_rate":42,"rating_average":4.6,"review_count":7,"review_text":"(7)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/56/b4/5a/0f2668d8eec6176f2978c18e9179a643.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":399,"all_time_quantity_sold":46,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7qukw-lk7jjxaz84ac61\" alt=\"vn-11134208-7qukw-lk7jjxaz84ac61\" width=\"853\" height=\"853\" /\u003e\u003cbr /\u003eChăm sóc cho những đôi giày da luôn sáng bóng không phải là điều dễ dàng với dân chơi giày. Khi các đôi giày có dấu hiệu bị xước hay tróc sơn, chi phí để đưa đôi giày ra tiệm spa có thể sẽ làm bạn băn khoăn. Để giải quyết điều đó, thương hiệu XIMO đem đến bộ 3 SẢN PHẨM XI ĐÁNH GIÀY HOÀN TOÀN MỚI - CẢI TIẾN BAO BÌ, CHẤT LƯỢNG NÂNG CẤP. \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eTHÔNG TIN SẢN PHẨM XI ĐÁNH GIÀY XIMO DẠNG SÁP\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eThương hiệu: XIMO\u003c/p\u003e\n\u003cp\u003eDung tích: 50ml\u003c/p\u003e\n\u003cp\u003eMàu sắc:\u003c/p\u003e\n\u003cp\u003e+ Black (Màu đen)\u003c/p\u003e\n\u003cp\u003e+ Brown (Màu nâu)\u003c/p\u003e\n\u003cp\u003e+ Neutral (Không màu)\u003c/p\u003e\n\u003cp\u003eThành phần thiên nhiên và chất nhuộm cô đặc giúp thẩm thấu mạnh và tái tạo lại màu da, phục hồi màu tốt hơn:\u003c/p\u003e\n\u003cp\u003e+ Dầu sáp Carnauba, Natural waxes, White spirit, Dye.\u003c/p\u003e\n\u003cp\u003e+ Mùi hương từ cọ dừa carnauba.\u003c/p\u003e\n\u003cp\u003eThời hạn sử dụng: 3 năm\u003c/p\u003e\n\u003cp\u003eNhận dạng: hộp tròn, dạng sáp.\u003c/p\u003e\n\u003cp\u003ePhạm vi sử dụng: chỉ dùng cho đồ da bóng, da trơn,... (Không sử dụng cho da lộn, da nubuck, ...).\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eCÔNG DỤNG SẢN PHẨM XI ĐÁNH GIÀY DẠNG SÁP XIMO\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eXi sáp đánh giày XIMO làm sạch bề mặt, chống mốc, kháng khuẩn, giúp tăng tuổi thọ cho đồ da.\u003c/p\u003e\n\u003cp\u003eGiúp phục hồi, làm mới màu da đối với những sản phẩm đã bị phai màu, mất màu.\u003c/p\u003e\n\u003cp\u003eĐánh bóng bề mặt của đồ da da.\u003c/p\u003e\n\u003cp\u003eKhử mùi cho đồ da.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eƯU ĐIỂM CỦA PHIÊN BẢN NÂNG CẤP\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eMức độ lên màu rất tốt, ưu việt hơn so với sản phẩm cũ.\u003c/p\u003e\n\u003cp\u003eMùi hương cực kỳ dịu nhẹ, sau khi đánh giày gần như không để lại mùi.\u003c/p\u003e\n\u003cp\u003eGiúp giày da sáng bóng, sạch sẽ, dưỡng cho chất da trên giày bền đẹp.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eHƯỚNG DẪN SỬ DỤNG\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eBƯỚC 1: Tháo dây giày và sử dụng dụng cụ giữ form giày (Shoe Tree) để giữ cho bề mặt da trong trạng thái cố định.\u003c/p\u003e\n\u003cp\u003eBƯỚC 2: Sử dụng bàn chải lông ngựa để đánh sạch bụi bẩn trên bề mặt giày.\u003c/p\u003e\n\u003cp\u003eBƯỚC 3: Sử dụng chai tẩy chuyên dụng để tẩy sạch vết xi cũ (nếu có) và các vết dơ bẩn trên giày. Lưu ý sử dụng chai tẩy chuyên dụng để tránh làm hỏng và bong tróc da giày.\u003c/p\u003e\n\u003cp\u003eBƯỚC 4: Thoa xi đánh giày XIMO lên bề mặt cần dưỡng và bổ sung màu bằng tay hoặc khăn sạch. Đảm bảo thoa đều và mỏng để xi thẩm thấu đều trên da.\u003c/p\u003e\n\u003cp\u003eBƯỚC 5: Đợi khoảng 3-5 phút. Sau đó, sử dụng bàn chải đánh giày lông ngựa để đánh đều chất xi và làm bóng da giày. Điều này giúp xi thẩm thấu sâu hơn và mang lại độ bóng cho giày.\u003c/p\u003e\n\u003cp\u003eBƯỚC 6: Nếu bạn muốn giày có khả năng chống nước và bóng hơn, bạn có thể sử dụng xi sáp Mink oil XIMO. Áp dụng sáp lên da giày và đánh bóng bằng bàn chải để tạo lớp bảo vệ và làm bóng cho giày.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7qukw-lk7jjxaz9iusa8\" alt=\"vn-11134208-7qukw-lk7jjxaz9iusa8\" width=\"1067\" height=\"1067\" /\u003e\u003c/p\u003e\n\u003cp\u003eLƯU Ý CẦN THIẾT\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eSử dụng xi sáp đánh giày chuyên dụng giúp bạn làm mới và sửa chữa đồ da. Đối với các vùng bề mặt bị phai màu, bong tróc, xi sáp là lựa chọn phù hợp.\u003c/p\u003e\n\u003cp\u003eXi đánh giày XIMO cũng có thể được sử dụng để đổi màu cho đồ da.\u003c/p\u003e\n\u003cp\u003eXi sáp XIMO chuyên dụng có thể được sử dụng trên nhiều loại đồ da khác nhau như: áo, túi, ví, giày, dép, ...\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eLưu ý: Trước khi sử dụng xi đánh giày XIMO, hãy đảm bảo chọn đúng màu sắc của da, đọc kỹ hướng dẫn sử dụng và tuân thủ hướng dẫn sử dụng của nhà sản xuất để đạt hiệu quả tốt nhất và tránh gây hại cho đồ da.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eBỘ XI ĐÁNH GIÀY SHOE POLISH XIMO BAO GỒM:\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e02 hộp xi đánh giày (được chọn phân loại)\u003c/p\u003e\n\u003cp\u003e02 bàn chải quẹt xi\u003c/p\u003e\n\u003cp\u003e01 độn gót giày\u003c/p\u003e\n\u003cp\u003e01 bàn chải lông ngựa\u003c/p\u003e\n\u003cp\u003e01 khăn đánh bóng giày\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eCHÍNH SÁCH BẢO HÀNH VÀ ĐỔI TRẢ\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eQuý khách vui lòng quay video chi tiết quá trình bóc bưu phẩm.\u003c/p\u003e\n\u003cp\u003eHỗ trợ đổi trả trong vòng 07 ngày kể từ khi quý khách nhận được hàng, chưa qua sử dụng.\u003c/p\u003e\n\u003cp\u003eĐiều kiện áp dụng: Lỗi do nhà sản xuất, không đúng màu, không đủ số lượng sản phẩm.\u003c/p\u003e\n\u003cp\u003eTrường hợp từ chối đổi trả: Quá thời gian 07 ngày từ khi nhận hàng, không phải sản phẩm của shop.\u003c/p\u003e\n\u003cp\u003eHỗ trợ đổi trong trường hợp quý khách đặt nhầm, không hợp mẫu mã.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eTrong quá trình phục vụ có thể phát sinh sai sót từ khi kiểm tra, đóng hàng, vận chuyển. Nếu có bất kỳ điều gì cần được giải đáp, quý khách vui lòng nhắn tin để được XIMO tư vấn và hỗ trợ.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eCảm ơn Quý Khách đã tin tưởng sử dụng các sản phẩm của XIMO.\u003c/p\u003e\n\u003cp\u003e---------------------------\u003c/p\u003e\n\u003cp\u003e#xidanhgiay #xidanhgiayden #danhbonggiayda #xigiay #xidanhgiaytrang #xidanhgiayximo #xidanhgiaykhongmau #xidanhgiaynau #xidanhgiayda #sidanhgiay #lamsachgiayda #hopxidanhgiay #vesinhgiay #phukiengiay #chamsocgiayda #muaxidanhgiay\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/56/b4/5a/0f2668d8eec6176f2978c18e9179a643.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/56/b4/5a/0f2668d8eec6176f2978c18e9179a643.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/56/b4/5a/0f2668d8eec6176f2978c18e9179a643.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/56/b4/5a/0f2668d8eec6176f2978c18e9179a643.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/56/b4/5a/0f2668d8eec6176f2978c18e9179a643.png"},{"base_url":"https://salt