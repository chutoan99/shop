ht":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.8,"review_count":98,"review_text":"(98)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/04/e9/6d/2b603348a7a524d8a018bfd084eee068.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1632,"all_time_quantity_sold":225,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eNón bảo hiểm Royal M139 là nón 3/4 kính âm đầu tiên của Việt Nam sản xuất. Là 1 trong những dòng nón 3/4 có kính thời trang nhất với thiết kế kính âm thanh lịch, độc đáo\u003c/p\u003e\n\u003cp\u003eSize: M(53-55cm); L(56-57cm), XL(58-60cm)\u003c/p\u003e\n\u003cp\u003eVỏ nón được làm từ nhựa ABS nguyên sinh, là vật liệu dùng cho các sản phẩm yêu cầu cao như vỏ các thiết bị y tế, vỏ máy  độ bền cao, chống chịu lực va chạm mạnh\u003c/p\u003e\n\u003cp\u003eLớp mút xốp nón M139 được làm từ vật liệu EPS hấp thụ lực tốt, cùng với vỏ nón là 2 phần quan trọng nhất cấu thành 1 chiếc nón bảo hiểm\u003c/p\u003e\n\u003cp\u003eỐp tai và lớp lót được làm từ nhung giả da cực kì êm ái, được xử lý chống khuẩn và mùi hôi, cải tiến có thể tháo rời hoàn toàn để vệ sinh\u003c/p\u003e\n\u003cp\u003eĐiều đặc biệt nhất ở chiếc nón bảo hiểm M139 chính là phần KínhÂm, khi thu gọn trở thành chiếc lưỡi trai trang trí hợp mốt đồng thời giúp bảo vệ kính tránh trầy xước khi không sử dụng. Còn khi sử dụng bạn chỉ việc kéo phần lưỡi trai xuống là lớp kính âm chắn gió bụi sẽ hiện ra với 3 nấc điều chỉnh tùy theo nhu cầu sử dụng. Khi kéo hết, kính sẽ trở thành 1 tấm khiên che chắn bạn khỏi gió, bụi, mưa, côn trù đồng thời còn giúp chống chói rất hiệu quả\u003c/p\u003e\n\u003cp\u003eKính nón bảo hiểm M139 được làm bằng nguyên liện ngoại nhập, độ bền cao. Kính khói là kính màu rất nhẹ chống chói tốt, đi được cả ngày và đêm\u003c/p\u003e\n\u003cp\u003eMàu sơn sang trọng, chống xước cao\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/04/e9/6d/2b603348a7a524d8a018bfd084eee068.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/04/e9/6d/2b603348a7a524d8a018bfd084eee068.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/04/e9/6d/2b603348a7a524d8a018bfd084eee068.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/04/e9/6d/2b603348a7a524d8a018bfd084eee068.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/04/e9/6d/2b603348a7a524d8a018bfd084eee068.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/cf/43/3e/3faf2311ae4040ac02f8c127a10dd6d6.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/cf/43/3e/3faf2311ae4040ac02f8c127a10dd6d6.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/cf/43/3e/3faf2311ae4040ac02f8c127a10dd6d6.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/cf/43/3e/3faf2311ae4040ac02f8c127a10dd6d6.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/cf/43/3e/3faf2311ae4040ac02f8c127a10dd6d6.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/7c/f8/9f/8c7c18ceb67761b930e9466e0ed8f693.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w120