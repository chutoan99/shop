ht":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":62500,"discount_rate":25,"rating_average":4.6,"review_count":9,"review_text":"(9)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/d2/ce/e2/69d51d950104ec456311d5006927980b.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":824,"all_time_quantity_sold":91,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p style=\"text-align:center;\"><strong>BẤT ĐẲNG THỨC DƯỚI GÓC NHÌN CÁC BỔ ĐỀ</strong></p>\n<p style=\"text-align:justify;\">Sách viết về các kết quả quen thuộc (gọi là bổ đề) trong bất đẳng thức và ứng dụng nó. <br />Sách có tổng cộng 9 chương và một phụ lục hướng dẫn giải các chương.</p>\n<ul><li style=\"text-align:justify;\">7 chương đầu là 7 kết quả đơn giản trong bất đẳng thức . Thông qua lăng kính của người viết, chúng có những ứng dụng bất ngờ, đi xa hơn với vẻ bên ngoài vốn có của nó.</li>\n<li style=\"text-align:justify;\">Chương 8 là sự tiếp nối của chương 6, một kết quả có nhiều ứng dụng (dùng cho các bất đẳng thức có nhiều hơn 3 biến số) nhưng mức độ phức tạp hơn so với 7 kết quả ở 7 chương đầu.</li>\n<li style=\"text-align:justify;\">Chương 9 đề cập đến một chủ đề tương đối khó trong bất đẳng thức là tìm hằng số tốt. Đây không chỉ là chương điểm qua một số hướng tiếp cận cho bài toán tìm hằng số tốt, mà còn có thể xem là chương áp dụng các bổ đề hiện có.</li>\n<li style=\"text-align:justify;\">Cuối cùng là phụ lục hướng dẫn giải cho các bài toán ở 9 chương đầu. </li>\n</ul><p style=\"text-align:center;\"><img src=\"https://salt.tikicdn.com/ts/tmp/49/a6/fa/89c461e356b1d0354afae416a40e49fa.jpg\" alt=\"\" width=\"750\" height=\"586\" /></p>\n<p style=\"text-align:center;\"><img src=\"https://salt.tikicdn.com/ts/tmp/1b/48/cd/26df8a918143a9452c8cc2dc9fe4a32a.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/d2/ce/e2/69d51d950104ec456311d5006927980b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d2/ce/e2/69d51d950104ec456311d5006927980b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d2/ce/e2/69d51d950104ec456311d5006927980b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d2/ce/e2/69d51d950104ec456311d5006927980b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d2/ce/e2/69d51d950104ec456311d5006927980b.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/3d/39/14/7f1e199d03467963e6665d1d10dcd132.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/3d/39/14/7f1e199d03467963e6665d1d10dcd132.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/3d/39/14/7f1e199d03467963e6665d1d10dcd132.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3d/39/14/7f1e199d03467963e6665d1d10dcd132.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3d/39/14/7f1e199d03467963e6665d1d10dcd132.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/ba/55/21/8327aeba56ff9d175b50c55f3e3a448b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ba/55/21/8327aeba56ff9d175b50c55f3e3a448b.jpg","medium_url":"http