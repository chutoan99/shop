ẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/d2/ef/9e/b4a891d7a3d54c1e33c081cef8954df5.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d2/ef/9e/b4a891d7a3d54c1e33c081cef8954df5.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d2/ef/9e/b4a891d7a3d54c1e33c081cef8954df5.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d2/ef/9e/b4a891d7a3d54c1e33c081cef8954df5.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d2/ef/9e/b4a891d7a3d54c1e33c081cef8954df5.jpg"}],"warranty_policy":null,"current_seller":{"id":164395,"sku":"1908495959562","name":"Trạm đọc","link":"https://tiki.vn/cua-hang/tram-doc","logo":"d8/c2/33/0c5467a0e2d780425ef00f82f250443b.jpg","price":134000,"product_id":"193417747","store_id":151394,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Thông tin chung","attributes":[{"code":"publisher_vn","name":"Công ty phát hành","value":"Alphabooks"},{"code":"manufacturer","name":"Nhà xuất bản","value":"Nhà Xuất Bản Thế Giới"}]}],"product_links":[],"gift_item_title":"0 quà tặng kèm","configurable_options":[{"code":"option1","name":"Phiên bản","position":0,"show_preview_image":false,"values":[{"label":"Phiên bản mới nhất"}]}],"configurable_products":[{"child_id":273678468,"discount_rate":25,"id":193417747,"images":[{"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d2/ef/9e/b4a891d7a3d54c1e33c081cef8954df5.jpg","medium_url":"https://salt.tikicdn.com/cache/550x550/ts/product/d2/ef/9e/b4a891d7a3d54c1e33c081cef8954df5.jpg","small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d2/ef/9e/b4a891d7a3d54c1e33c081cef8954df5.jpg"}],"inventory_status":"available","name":"Trạm Đọc Official | Kỹ Năng Học Tập Thành Công Ở Bậc Cao Đẳng, Đại Học (Tập 2 ) : Những kỹ năng học thuật - Phiê