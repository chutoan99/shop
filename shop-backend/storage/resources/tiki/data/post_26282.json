round_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":288000,"discount_rate":9,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/6a/8a/19/28dfd17fa5e45bc018e91c9c4abe8eb9.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":274,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eLoa kẹo kéo karaoke bluetooth Nanomax SK-12X3 chính hãng giá rẻ tặng 2 Mic không dây Bass 3 tấc bản mới sản xuất.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eLOA KÉO KARAOKE NANOMAX SK-12X3 THÔNG SỐ:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e• Loại: Loa karaoke bluetooth di động \u003cbr /\u003e• Số đường tiếng: 2\u003cbr /\u003e• Công suất: 380w\u003cbr /\u003e• Thời gian sạc: 3-6 giờ \u003cbr /\u003e• Thời gian dùng: 4-7 giờ\u003cbr /\u003e• Vừa sạc vừa dùng: Có\u003cbr /\u003e• Tiện ích: Cổng USB, thẻ nhớ\u003cbr /\u003e• Kết nối không dây: Bluetooth 5.0\u003cbr /\u003e• Kết nối khác: Audio In/Out 3.5, Cổng mic dây 6.5, cổng guitar 6.5\u003cbr /\u003e• Kích thước/ Trọng lượng: (35x34x61.5)cm/ 16kg\u003cbr /\u003e• Chất liệu thùng: Gỗ, sơn gai chống trầy \u003cbr /\u003e• Thương hiệu: Nanomax\u003cbr /\u003e• Sản xuất tại: Việt Nam\u003cbr /\u003e• Kích thước bass: 30cm\u003cbr /\u003e• Số lượng loa: 1 bass + 1 treble họng còi \u003cbr /\u003e• Dây sạc: 1\u003cbr /\u003e• Micro: 2\u003cbr /\u003e• Pin: 4 AA+\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eLOA BLUETOOTH KARAOKE NANOMAX SK-12X3 NỔI BẬT:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eLoa kẹo kéo Nanomax SK-12X3 có kích thước vừa đủ để hát karaoke trong phòng, hội trường, sân vườn với âm bass ấm, treble vang. Đến nay chưa khách nào than phiền về chất lượng âm thanh, nhưng được bán giá rẻ phù hợp túi tiền nhiều người.\u003c/p\u003e\n\u003cp\u003eBảng điều khiển loa karaoke đầy đủ nút chỉnh Treble, Bass, Echo, Delay giúp âm thanh và chuyên nghiệp cao, nhạc remix đã tai, bolero nhẹ nhàng dịu dàng.\u003c/p\u003e\n\u003cp\u003eNgoài ra, còn bổ sung chế độ ghi âm giọng hát, chế độ tắt lời chỉ giữ nhạc để hát karaoke, chế độ tự động nhỏ nhạc để ưu tiên micro; cổng kết nối với USB/ thẻ nhớ, 2 cổng mic có dây, 1 cổng guitar, 4 cổng Audio In/output; ngõ vào bình ắc quy 12V; chế độ chỉ dùng pin (DC On) và vừa sạc vừa hát (AC On).\u003c/p\u003e\n\u003cp\u003eLoa kéo có 2 bóng báo để theo dõi tình trạng loa: bóng dưới sẽ sáng màu đỏ khi pin yếu, bóng trên là chế độ sạc: đỏ là đang sạc, xanh hoặc tím là đầy.\u003c/p\u003e\n\u003cp\u003eNanomax SK-12X3 là loa kéo giá rẻ vì riêng 2 mic không dây chiếm tới 1/3 giá bán; đầu kim loại, đuôi nhựa; khả năng chống hú siêu tốt, hát siêu nhẹ do dùng band UHF; có thể chỉnh tần số, khóa tần số chống mất kết nối. Ngoài ra, trong mic có 2 nút tăng giảm độ nhạy 7 mức, người giọng yếu nên để mức 6-7, người giọng khỏe mức 4-5.\u003c/p\u003e\n\u003cp\u003eLưới loa karaoke bluetooth làm bằng kim loại xịn, đàn hồi cực tốt, sơn vàng dày chống trầy xước; thùng loa gỗ ép chất lượng cao, rất cứng cáp, tăng độ khỏe cho âm thanh, bên ngoài sơn gai đen bóng chống trầy siêu tốt.\u003c/p\u003e\n\u003cp\u003eLoa bluetooth karaoke có 4 bánh xe giúp linh hoạt di chuyển, 2 bánh sau có chốt khóa cố định loa 1 chỗ.\u003c/p\u003e\n\u003cp\u003eMặt trên thùng in chữ Nanomax chìm; tem chính hãng, logo kim loại trên lưới; luôn được test kĩ càng và đóng gói cẩn thận trước khi gửi nên giảm được 99% hư hỏng. Quý khách muốn kiểm tra hàng trước khi nhận thì nên yêu cầu shiper gọi shop khi giao hàng.\u003c/p\u003e\n\u003cp\u003eBộ loa karaoke: loa, 2 mic, dây sạc, 4 pin AA, 1 tờ hướng dẫn của hãng, 1 tờ hướng dẫn chi tiết của Nam Hoàng, bên ngoài bọc 2 lớp chống sốc. Liên hệ shop ngay sau khi nhận hàng nếu cần hướng dẫn dùng loa.\u003c/p\u003e\n\u003cp\u003eBẢO HÀNH LOA KẸO KÉO NANOMAX:\u003cbr /\u003e• 1 đổi 1 bị lỗi khi nhận\u003cbr /\u003e• Bass và mạch: 12 tháng\u003cbr /\u003e• Mic và ắc quy: 6 tháng\u003c/p\u003e\n\u003cp\u003eNam Hoàng Audio tự tin cam kết chất lượng sản phẩm, chúng tôi luôn muốn sản phẩm tốt nhất tới tay quý khách.\u003c/p\u003e\n\u003cp\u003e#nanomax #loakeo #loakaraoke #loakeokeo #loakaraokebluetooth\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/6a/8a/19/28dfd17fa5e45bc018e91c9c4abe8eb9.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/6a/8a/19/28dfd17fa5e45bc018e91c9c4abe8eb9.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/6a/8a/19/28dfd17fa5e45bc018e91c9c4abe8eb9.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6a/8a/19/28dfd17fa5e45bc018e91c9c4abe8eb9.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6a/8a/19/28dfd17fa5e45bc018e91c9c4abe8eb9.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/7b/91/d7/cd6e11c0f790318821cfa2a44d894245.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/7b/91/d7/cd6e11c0f790318821cfa2a44d894245.jpg","medium_url":"h