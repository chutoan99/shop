"is_hero","type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"freeship_xtra","type":"pdp_icon_badge","index":2,"icon":"https://salt.tikicdn.com/ts/upload/be/67/48/04a82ab8df178e1a13bde38316081865.png","icon_width":91,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":true,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.5,"review_count":59,"review_text":"(59)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/a5/a1/76/aadcc09dad51f8e53abe956f2777a302.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1730,"all_time_quantity_sold":191,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<h1><em><strong>Giới thiệu Dung dịch chống bám nước trên kính xe Karshine KA-RO150</strong></em></h1>\n<p><strong>Dung dịch chống bám nước trên kính xe Karshine KA-RO150 </strong>áp dụng công thức tiên tiến giúp sản phẩm phủ 1 lớp phin mỏng lên bề mặt kính làm cho nước mưa cũng như mưa đá không bám lên kính. Nước mưa sẽ trượt trên kính dễ dàng khi xe đang chạy. Sản phẩm giúp việc lái xe của bạn trở nên dễ dàng, thoải mái và an toàn trong bất kỳ điều kiện thời tiết nào vì tầm nhìn được cải thiện. Sản phẩm còn giúp cho việc lau chùi các vết dơ do bụi bẩn, côn trùng, phân chim trở nên dễ đang hơn rất nhiều.<br />Ngoài cửa kính, gương ô tô, sản phẩm còn có thể dùng cho các loại kính, gương trong nhà giúp chống hấp hơi, mờ kính.</p>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/ce/f5/a5/9aad448cb334b6ddb891dd71c30d5dc3.jpg?v=1575015780665\" data-thumb=\"original\" /></p>\n<h2><strong>Thông tin chi tiết:</strong></h2>\n<ul>\n<li>Tên sản phẩm: <em><strong>Dung dịch chống bám nước trên kính xe Karshine KA-RO150</strong></em></li>\n<li>Mã hàng: <strong>KA-RO150</strong></li>\n<li>Công dụng: Chống bám nước hay còn gọi là trượt nước trên kính xe</li>\n<li>Dung tích: 150ml</li>\n<li>Thương hiệu: Karshine</li>\n<li>Nơi sản xuất: Thái Lan</li>\n</ul>\n<p><strong>Tặng kèm 1 khăn lau</strong></p>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/34/9d/67/ab11670744ca32f4bb44df2b5295c856.jpg?v=1575015900015\" data-thumb=\"original\" /></p>\n<h2><strong>Thông tin nổi bật:</strong></h2>\n<ul>\n<li>Chống bám (trượt) nước trên kính xe</li>\n<li>Dễ dàng sử dụng, làm sạch hiệu quả.</li>\n<li>An toàn khi lái xe</li>\n<li>Tiện lợi để cất giữ và mang theo</li>\n<li>Mỗi lần sử dụng có thể kéo dài đến 2 tuần hoặc 3 lần rửa xe (tùy thuộc một phần vào điều kiện thời tiết)</li>\n</ul>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/a6/9e/2e/091d096fa83bd7f72d1e0a638a576278.jpg?v=1575015911005\" data-thumb=\"original\" /></p>\n<h2><strong>Hướng dẫn sử dụng:</strong></h2>\n<ul>\n<li><strong>Bước 1</strong>: Rửa sạch kính trước khi áp dụng.</li>\n<li><strong>Bước 2</strong>: Dùng khăn mềm (hoặc mút xốp) thoa đều dung dịch lên kính theo đường ngang dọc hoặc tròn.</li>\n<li><strong>Bước 3</strong>: Chờ 5 phút cho khô sau đó lau sạch bằng khăn lau ô tô chuyên dụng.</li>\n<li>Mỗi lần sử dụng chỉ cần 20-30ml</li>\n</ul>\n<p><img src=\"https://salt.tikicdn.com/ts/product/da/73/24/bfdb2d339fd59876f225346c47ba4423.jpg?v=1536902046126\" data-thumb=\"original\" /></p>\n<p><strong>Lưu Ý:</strong> Khi sử dụng \"<em><strong>Dung dịch chống bám nước trên kính xe Karshine KA-RO150 </strong></em>\" thì sẽ tạo 1 lớp màng mỏng trong suốt trên mặt kính có tác dụng làm cho nước trượt đi, không bám lại trên mặt kính.</p>\n<p>Do đó, khi sử dụng dung dịch trên kính lái thì có một số ít dòng xe (như ford) sử dụng gạt mưa không xương, ôm sát vào mặt kính sẽ kêu rít rít.</p>\n<p>Theo thông tin từ nhà sản xuất thì sản phẩm này được sản xuất phục vụ chủ yếu cho các loại kính hậu, kính cửa 2 bên (ngang hông), còn kính lái đã có cần gạt mưa để đẩy nước đi rồi.</p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/a5/a1/76/aadcc09dad51f8e53abe956f2777a302.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a5/a1/76/aadcc09dad51f8e53abe956f2777a302.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a5/a1/76/aadcc09dad51f8e53abe956f2777a302.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a5/a1/76/aadcc09dad51f8e53abe956f2777a302.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a5/a1/76/aadcc09dad51f8e53abe956f2777a302.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/23/11/cf/594c03b23964e5b2b8591e3f40f9c37d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/23/11/