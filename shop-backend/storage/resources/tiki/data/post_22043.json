unt":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/70/d9/9b/334b47ee9ada4a91f78ca86207ff7dc4.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":260,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003chtml\u003e\n \u003chead\u003e\u003c/head\u003e\n \u003cbody\u003e\n  \u003cdiv\u003e\n   Giàu Có Từ Nội Tâm là hành trình đưa chúng ta quay trở về với chính mình giữa những ồn ào, xáo động của thế giới bên ngoài. Đó là sự bình an trong suy nghĩ; học cách bao dung và cho đi vô điều kiện; rèn luyện trí tuệ và sức mạnh nội tâm, từ đó trở thành một người luôn bình yên giữa nghịch cảnh, sống với sự tự do và trao đi tình yêu đích thực.\n   \u003cbr\u003e \n   \u003cimg src=\"https://salt.tikicdn.com/ts/product/de/1c/c3/c44972eb43f89a8e02154195520f2262.jpg\"\u003eNgày nay, khi xã hội đang trọng vọng những giàu có về vật chất, những thăng tiến trong địa vị, giá trị con người dường như đang đong đếm bằng số tiền họ kiếm được, thì cuốn sách này đưa ra một khái niệm “giàu có trong nội tâm”. Vậy thì nội tâm giàu có và nội tâm nghèo nàn có gì khác nhau? Chúng ta cứ mải mê tìm kiếm sự tiện nghi để thỏa mãn chính mình, nhưng có lẽ từ khi con người xuất hiện trên trái đất cho đến nay, chúng ta chưa bao giờ thỏa mãn. Sự sung túc chẳng làm ta hạnh phúc hơn, chúng ta vẫn thất vọng, vẫn đau khổ, vẫn mong cầu những thứ mình chưa có. Sự không thỏa mãn này, khiến cho ta buộc lòng phải đi tìm một tiện nghi khác, một sự giàu có khác, bền vững và đích thực, và đó là sự giàu có trong tâm hồn.\n   \u003cbr\u003e Nhà sách Thành An cam kết chỉ bán sách thật, sách mới, nhập nguyên kiện từ nhà xuất bản, đảm bảo chất lượng nguyên vẹn; sách được lựa chọn và đóng gói cẩn thận.\n   \