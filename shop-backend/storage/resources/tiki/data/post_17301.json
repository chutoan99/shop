n.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/67/08/ff/feafe97bffadcaa2d0d0562d27a1234e.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":390,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch1 dir=\"ltr\"\u003e\u003cstrong\u003eMICRO PASION ECHO\u003c/strong\u003e\u003c/h1\u003e\n\u003cp dir=\"ltr\"\u003ePASION ECHO là micro không dây tích hợp công nghệ xử lý quy trình số (DSP), cho phép người dùng thao tác hiệu quả các các chức năng điều chỉnh Echo, Bass, Treble, Volume trực tiếp trên thân micro.\u003c/p\u003e\n\u003cp dir=\"ltr\"\u003e\u003cimg title=\"MICRO PASION ECHO\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/aa/be/94/e5c48b28a78d87954a7d0e344c6000df.jpg\" alt=\"MICRO PASION ECHO\" /\u003e\u003c/p\u003e\n\u003cp dir=\"ltr\"\u003eSản phẩm được thiết kế theo hướng thu gọn tối đa để tạo nên sự linh hoạt khi kết nối với các thiết bị âm thanh tích hợp, đặc biệt là các loại loa di động, phục vụ cho đa dạng nhu cầu sử dụng như karaoke giải trí, phát biểu, hội họp…\u003c/p\u003e\n\u003cp dir=\"ltr\"\u003eSở hữu tính năng thông minh tiện lợi: Khóa phím để tránh thay đổi tình trạng cài đặt, đồng bộ hóa nhận dạng giữa bộ thu và bộ phát giúp hạn chế nhiễu kênh.\u003c/p\u003e\n\u003cp dir=\"ltr\"\u003eBộ thu tín hiệu (Receiver) sử dụng pin sạc 18650-1200mAh với cổng sạc Type C. Ngõ ra tín hiệu (Jack micro) của bộ thu được thiết kế với jack 6.5mm có thể gập gọn 90°, đồng thời trang bị thêm 1 đầu chuyển audio qua jack 3.5mm.\u003c/p\u003e\n\u003cp dir=\"ltr\"\u003ePASION ECHO hoạt động trên băng tần UHF 675.3MHz ~ 684MHz với 15 kênh cho Micro A và 15 kênh cho Micro B, đồng thời cho phép linh hoạt thay đổi kênh tần số nhằm tránh hiện tượng trùng kênh.\u003c/p\u003e\n\u003ch2 dir=\"ltr\"\u003e\u003cstrong\u003eThông số kỹ thuật micro Pasion Echo\u003c/strong\u003e\u003c/h2\u003e\n\u003cp dir=\"ltr\"\u003e\u003cstrong\u003eBộ phát tín hiệu\u003c/strong\u003e\u003c/p\u003e\n\u003cp dir=\"ltr\"\u003e- Tần số sóng vận chuyển tín hiệu\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cp\u003eUHF CH-A: 675.3Mhz ~ 679.5Mhz\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eUHF CH-B: 679.8Mhz ~ 684Mhz\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp dir=\"ltr\"\u003e- Phương pháp điều chế: điều chế tần FM\u003c/p\u003e\n\u003cp dir=\"ltr\"\u003e- Nguồn cung cấp: pin AA - 1.5V\u003c/p\u003e\n\u003cp dir=\"ltr\"\u003e- Hiển thị: LCD\u003c/p\u003e\n\u003cp dir=\"ltr\"\u003e- Kích thước: 257 x 55 mm\u003c/p\u003e\n\u003cp dir=\"ltr\"\u003e- Khối lượng tịnh bộ phát tín hiệu (chưa kèm pin AA): 300g\u003c/p\u003e\n\u003cp dir=\"ltr\"\u003e- Khối lượng tịnh bộ phát tín hiệu (đã lắp pin AA): 340g\u003c/p\u003e\n\u003cp dir=\"ltr\"\u003e\u003cstrong\u003eBộ thu tín hiệu\u003c/strong\u003e\u003c/p\u003e\n\u003cp dir=\"ltr\"\u003e- Tần số sóng vận chuyển tín hiệu:\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cp\u003eUHF CH-A: 675.3Mhz ~ 679.5Mhz\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eUHF CH-B: 679.8Mhz ~ 684Mhz\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp dir=\"ltr\"\u003e- Dynamic Range: \u0026gt; 100dB\u003c/p\u003e\n\u003cp dir=\"ltr\"\u003e- Tỉ số tín hiệu trên nhiễu: 97dB\u003c/p\u003e\n\u003cp dir=\"ltr\"\u003e- Độ ổn định tần số: ±5Khz\u003c/p\u003e\n\u003cp dir=\"ltr\"\u003e- Đáp ứng tần số: 40Hz - 15kHz\u003c/p\u003e\n\u003cp dir=\"ltr\"\u003e- Tín hiệu ngõ ra: 0~300mV\u003c/p\u003e\n\u003cp dir=\"ltr\"\u003e- Nguồn cung cấp sạc: 5V, USB type-C port và pin Lithium Ion 3.7V-1200mAh\u003c/p\u003e\n\u003cp dir=\"ltr\"\u003e- Khối lượng tịnh bộ thu tín hiệu (chưa kèm pin sạc): 65g\u003c/p\u003e\n\u003cp dir=\"ltr\"\u003e- Khối lượng tịnh bộ thu tín hiệu (đã lắp kèm pin sạc): 100g\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/67/08/ff/feafe97bffadcaa2d0d0562d27a1234e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/67/08/ff/feafe97bffadcaa2d0d0562d27a1234e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/67/08/ff/feafe97bffadcaa2d0d0562d27a1234e.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/67/08/ff/feafe97bffadcaa2d0d0562d27a1234e.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/67/08/ff/feafe97bffadcaa2d0d0562d27a1234e.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/ab/07/f2/c5e334f9437b83516bf7a317091aab97.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ab/07/f2/c5e334f9437b83516bf7a317091aab97.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ab/07/f2/c5e334f9437b83516bf7a317091aab97.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ab/07/f2/c5e334f9437b83516bf7a317091aab97.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ab/07/f2/c5e334f9437b83516bf7a317091aab97.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/3e/ca/b