tawn8ab\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lr76pss0gy4k86\" width=\"900\" height=\"1133\" alt=\"vn-11134208-7r98o-lr76pss0gy4k86\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lr76psusa2tg38\" width=\"900\" height=\"1133\" alt=\"vn-11134208-7r98o-lr76psusa2tg38\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lr76q2p3vkjo97\" width=\"900\" height=\"1133\" alt=\"vn-11134208-7r98o-lr76q2p3vkjo97\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lr76q2rbsblw96\" width=\"900\" height=\"1133\" alt=\"vn-11134208-7r98o-lr76q2rbsblw96\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lr76q2xpizes88\" width=\"900\" height=\"1133\" alt=\"vn-11134208-7r98o-lr76q2xpizes88\" /\u003e\u003c/p\u003e\n\u003cp\u003eHƯỚNG DẪN BẢO QUẢN TÚI XÁCH:\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eSử dụng:\u003c/p\u003e\n\u003cp\u003eTrên bề mặt sạch, trên bàn. Tránh đặt nơi đất bẩn. \u003c/p\u003e\n\u003cp\u003eTránh treo túi bằng quai vì trọng lượng có thể phải hư quai và dáng túi.\u003c/p\u003e\n\u003cp\u003eTránh để túi tiếp xúc trực tiếp ánh mặt trời quá lâu.\u003c/p\u003e\n\u003cp\u003eKhông để các vật sắc nhọn như dao, bấm móng tay vào túi. \u003c/p\u003e\n\u003cp\u003eTránh để trực tiếp các vật có thể lem màu (viết mực, mỹ phẩm) vào lòng túi.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eVệ sinh:\u003c/p\u003e\n\u003cp\u003eLau túi theo chiều dọc, nhẹ nhàng, tránh chất tẩy mạnh, cồn, nước, khăn ướt vì khiến túi phai màu, khô da.\u003c/p\u003e\n\u003cp\u003eDùng dung dịch hỗ trợ chuyên dụng chống thấm dầu và nước để giảm thiểu khả năng bám bẩn.\u003c/p\u003e\n\u003cp\u003eKhông mang túi đi giặt và sử dụng các dụng cụ có nhiệt độ cao để làm khô túi.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eCất giữ:\u003c/p\u003e\n\u003cp\u003eTháo dây đeo cất vào bên trong túi, cho vào bao chân hoặc tủ, giữ túi xách không bị bám bụi khi ít sử dụng.\u003c/p\u003e\n\u003cp\u003eGiữ dáng túi bằng cách nhồi giấy hoặc túi nilon. \u003c/p\u003e\n\u003cp\u003eLưu ý, không dùng giấy báo vì mực có thể dính vào túi và gây mùi khó chịu.\u003c/p\u003e\n\u003cp\u003eDùng gói hút ẩm có sẵn trong túi để ngăn chặn mùi hôi.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eChính sách đổi trả, bảo hành áp dụng trên toàn hệ thống JUNO\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eThời gian đổi/trả:\u003c/p\u003e\n\u003cp\u003e07 ngày (theo quy định Tiki) đối với hàng khuyến mãi.\u003c/p\u003e\n\u003cp\u003e30 ngày đối với hàng nguyên giá.\u003c/p\u003e\n\u003cp\u003e*Thời gian đổi/ trả được tính kể từ ngày nhận hàng\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eĐiều kiện đổi trả:\u003c/p\u003e\n\u003cp\u003e- Đổi trả khi có lỗi sản xuất hoặc hàng chưa sử dụng và sửa chữa (còn tem, nhãn).\u003c/p\u003e\n\u003cp\u003e- Sản phẩm chưa qua sử dụng, còn nguyên vẹn\u003c/p\u003e\n\u003cp\u003e- Sản phẩm không bị hư hỏng, bể vỡ\u003c/p\u003e\n\u003cp\u003e- Tem, mạc niêm phong còn nguyên vẹn, không bị rách và trầy xước\u003c/p\u003e\n\u003cp\u003e- Sản phẩm còn đầy đủ phụ kiện / quà tặng đi kèm (nếu có)\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eBảo hành: Bảo hành giày túi trong 6 tháng kể từ ngày mua hàng (căn cứ thông tin mua hàng/ hóa đơn)\u003c/p\u003e\n\u003cp\u003eKhông bảo hành phụ kiện và dép tông\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e*Lưu ý: Nếu cần hỗ trợ thêm thông tin Quý Khách Hàng vui lòng inbox chat box JUNO.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e#tuinho #tuixachmini #tuinhodethuong #tuixach #tuimini #tuijuno #TXN779\u003c/p\u003e\n\u003cp\u003e#juno #JUNO #Duno #zuno #despnu #giafynu #de2p #gia3ynu #tusinu #tu2inu\u003c/p\u003e\n\u003cp\u003e#giayjuno #tuijuno #balojuno #vijuno # matkinhjuno #sneakerjuno #sandaljuno #thoitrangnu #thoitrangjuno #giaythethaojuno\u003c/p\u003e\n\u003cp\u003e#cao_got_juno #giay_juno #tui_juno #balo_juno #vi_juno #may_kinh_juno #sneaker_juno #sandal_juno #giaythethao_juno\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/3f/a8/9b/cf237835bd1e358aa10e82cab069ad86.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/3f/a8/9b/cf237835bd1e358aa10e82cab069ad86.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/3f/a8/9b/cf237835bd1e358aa10e82cab069ad86.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3f/a8/9b/cf237835bd1e358aa10e82cab069ad86.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3f/a8/9b/cf237835bd1e358aa10e82cab069ad86.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/19/16/eb/25714662957e1e5e8dce7f5b2d7d73e0.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/19/16/eb/25714662957e1e5e8dce7f5b2d7d73e0.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/19/16/eb/25714662957e1e5e8dce7f5b2d7d73e0.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/19/16/eb/25714662957e1e5e8dce7f5b2d7d73e0.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/19/16/eb/25714662957e1e5e8dce7f5b2d7d73e0.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/42/d0/da/8232534b8696b205bbd1804ca9d2e626.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/42/d0/da/8232534b8696b205bbd1804ca9d2e626.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/42/d0/da/8232534b8696b205bbd1804ca9d2e626.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/produc