ew_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/e4/0e/be/229e02511bdda71f424e57223b201891.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":888,"all_time_quantity_sold":10,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003e\u003cem\u003eMikrotik RB750Gr3 là một router Gigabit có năm cổng, dùng để làm router chính với các bộ phát wifi có thể nối sau nó. Thiết bị có một cổng USB, phiên bản mới nhất mang lại một số cải tiến về hiệu suất. Quan trọng là Mikrotik Hex RB750Gr3 hoàn toàn tương thích với dịch vụ WiFi Marketing của SmartWiFi\u003c/em\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e \u003cstrong\u003eMikrotik RB750Gr3 \u003c/strong\u003enày có sức mạnh, nhỏ gọn và dễ sử dụng. Nó sử dụng một CPU hai nhân xung nhịp \u003cstrong\u003e880MHz\u003c/strong\u003e rất mạnh mẽ, nhờ thế \u003cstrong\u003eMikrotik RB750Gr3\u003c/strong\u003e hỗ trợ tất cả những tính năng của hệ điều hành \u003cstrong\u003eRouterOS.\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cstrong\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/05/ba/63/96d78acb688484b5a658b5d191770d6f.png\" alt=\"\" width=\"500\" height=\"500\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eThông số sản phẩm Router Mikrotik RB750Gr3\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e• CPU : 2 Core, 4 thears 880 MHz, MMIPS MT7621A\u003cbr /\u003e• RAM : 256 MB  RAM\u003cbr /\u003e• Bộ nhớ lưu trữ : 16 MB FLASH\u003cbr /\u003e• Operating System : RouterOS License level 4\u003cbr /\u003e• (5) Cổng mạng 1 Gbps \u003cbr /\u003e• (1) Cổng USB type A\u003cbr /\u003e• (1) Khe MicroSD Card\u003cbr /\u003e• 1039.1 kpps, 532.0 Mbps for 64‑byte packets\u003cbr /\u003e• 443.7 kpps, 1,817.4 Mbps for 512‑byte packets\u003cbr /\u003e• 162.4 kpps, 1,972.2 Mbps for 1518-byte packets\u003cbr /\u003e• Phụ kiện : 1 nguồn DC 24V-0.38A\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"color: #ff0000;\"\u003e\u003cstrong\u003eBẢO HÀNH: 12 THÁNG\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eRouter RB750Gr3\u003c/strong\u003e hỗ trợ mã hóa IPsec bằng phần cứng nên cho tốc độ rất tốt, lên tới \u003cstrong\u003e~470Mbps\u003c/strong\u003e. \u003cstrong\u003eServer Dude\u003c/strong\u003e được hỗ trợ – đây là một gói phần mềm miễn phí dùng để quản lý tất cả các thiết bị mạng có trong hệ thống.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/5a/90/1e/f2b9c6a345bedbe25583df608d7b1de0.png\" alt=\"\" width=\"500\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003eNgoài việc là một router mạnh, \u003cstrong\u003eMikroTik 750Gr3\u003c/strong\u003e còn được dùng làm \u003cstrong\u003eWifi Marketing Gateway\u003c/strong\u003e cho dịch vụ của SmartWifi. Bạn có thể dùng thiết bị này để biến một mạng wifi thường thành một kênh quảng cáo.\u003c/p\u003e\n\u003ch3 style=\"text-align: justify;\"\u003e\u003cstrong\u003eMikrotik RB750Gr3 – bộ cân bằng tải mạnh mẽ.\u003c/strong\u003e\u003c/h3\u003e\n\u003cp style=\"text-align: justify;\"\u003eLà một router, \u003cstrong\u003eMikroTik\u003c/strong\u003e \u003cstrong\u003eRB750Gr3\u003c/strong\u003e có tất cả 5 cổng mạng, cổng nào cũng có thể dùng để làm WAN nối ra Internet. Tựu chung, nó có thể chạy \u003cstrong\u003eLoad Balancing\u003c/strong\u003e (hay còn gọi là cân bằng tải) tới 4 đường mạng.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003eCó thể tổng hợp băng thông từ 2 đường mạng trở lên để cho một mạng với tốc độ cực cao.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003eCác kiểu cân bằng tải mà \u003cstrong\u003eMikrotik RB750Gr3\u003c/strong\u003e hỗ trợ bao gồm:\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e+ Failover: Chạy dự phòng\u003cbr /\u003e+ Firewall marking: Đánh dấu gói tin.\u003cbr /\u003e+ ECMP (Equal Cost Multi-Path).\u003cbr /\u003e+ PCC (Per Connection Classifier)\u003cbr /\u003e+ Nth\u003cbr /\u003e+ Bonding\u003cbr /\u003e+ OSPF\u003cbr /\u003e+ BGP\u003c/p\u003e\n\u003ch4 style=\"text-align: justify;\"\u003e\u003cstrong\u003eBộ Router RB750Gr3 được sử dụng ở đâu?\u003c/strong\u003e\u003c/h4\u003e\n\u003cp style=\"text-align: justify;\"\u003eLà một router mạnh có thể chịu tải tới 100 người dùng nên \u003cstrong\u003eMikrotik Gr3 RB750\u003c/strong\u003e thường hay được sử dụng tại những nơi có mật độ người sử dụng cao.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003eBạn có để ý thấy tại một số quán cafe đông người mà tốc độ internet vẫn rất tốt không? Bí mật của hệ thống mạng nơi đó luôn bắt đầu từ một router khỏe như vậy.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/42/76/75/1820a7e61864310eee8b0cc0a3153955.png\" alt=\"\" width=\"500\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003eDưới đây là những nơi hay sử dụng thiết bị này để làm router chính cũng như là cân bằng tải (gộp băng thông) trên nhiều đường mạng.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cem\u003e\u003cstrong\u003eRouter Mikrotik\u003c/strong\u003e\u003c/em\u003e RB750Gr3 phù hợp với văn phòng công ty với số lượng nhân viên từ 15-40 người. Phù hợp với shop bán hàng trong siêu thị, quán cafe, nhà hàng,khách sạn vừa và nhỏ, gia đình.\u003c/p\u003e\n\u003ch3 style=\"text-align: justify;\"\u003e\u003cstrong\u003eHình ảnh thiết bị Router\u003c/strong\u003e\u003c/h3\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eThông số kỹ thuật\u003c/strong\u003e\u003c/p\u003e\n\u003ctable class=\"table product-table\"\u003e\n\u003cthead\u003e\n\u003ctr\u003e\n\u003cth colspan=\"2\"\u003eDetails\u003c/th\u003e\n\u003c/tr\u003e\n\u003c/thead\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd\u003eProduct code\u003c/td\u003e\n\u003ctd\u003eRB750Gr3\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003eArchitecture\u003c/td\u003e\n\u003ctd\u003eMMIPS\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003eCPU\u003c/td\u003e\n\u003ctd\u003eMT7621A\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003eCPU core count\u003c/td\u003e\n\u003ctd\u003e2\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003eCPU nominal frequency\u003c/td\u003e\n\u003ctd\u003e880 MHz\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003eCPU Threads count\u003c/td\u003e\n\u003ctd\u003e4\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003eIPsec hardware acceleration\u003c/td\u003e\n\u003ctd\u003eYes\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003eDimensions\u003c/td\u003e\n\u003ctd\u003e113x89x28mm\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003eRouterOS license\u003c/td\u003e\n\u003ctd\u003e4\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003eOperating System\u003c/td\u003e\n\u003ctd\u003eRouterOS\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003eSize of RAM\u003c/td\u003e\n\u003ctd\u003e256 MB\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003eStorage size\u003c/td\u003e\n\u003ctd\u003e16 MB\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003eStorage type\u003c/td\u003e\n\u003ctd\u003eFLASH\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003eMTBF\u003c/td\u003e\n\u003ctd\u003eApproximately 100’000 hours at 25C\u003c/td\u003e\n\u003c/