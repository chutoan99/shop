rage":5,"review_count":26,"review_text":"(26)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/41/fe/0f/c55e9c18fb2f3ea62670bb8b83c30195.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1213,"all_time_quantity_sold":314,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eNƯỚC KHOÁNG KIỀM THIÊN NHIÊN VIKODA pH 9,0 TỐT CHO SỨC KHỎE VÀ HỆ TIÊU HÓA\u003c/p\u003e\n\u003cp\u003eNằm sâu dưới chân núi Hòn Chuông thuộc dãy Trường Sơn, nguồn khoáng kiềm Đảnh Thạnh là món quà vô giá của thiên nhiên ban tặng cho vùng đất Khánh Hoà, Việt Nam. Các kết quả nghiên cứu từ 1977 đến 1999 đã chỉ ra Đảnh Thạnh là nguồn nước thiên nhiên có tính khoáng kiềm tự nhiên hoàn hảo, hàm lượng khoáng nhẹ và độ kiềm pH = 9.0, phù hợp uống bổ trợ sức khoẻ hàng ngày. \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/e5/84/f8/7a88598c4bda60cd83d8132ba513ddae.jpg\" alt=\"\" width=\"624\" height=\"304\" /\u003e\u003c/p\u003e\n\u003cp\u003eNước khoáng kiềm thiên nhiên Vikoda bảo toàn vẹn nguyên tinh túy từ nguồn khoáng kiềm Đảnh Thạnh quý hiếm.  Nước khoáng kiềm thiên nhiên Vikoda được khai thác từ mỏ đi lên được đưa thẳng vào nhà máy chiết và chỉ qua quá trình lọc thô, lọc bằng tia cực tím (UV). Sản phẩm sở hữu vị ngọt thanh mát và độ kiềm hoàn hảo pH = 9.0 100% tự nhiên cùng với các khoáng chất giúp trung hòa axit dạ dày dư thừa, đưa cơ thể trở về trạng thái cân bằng khoẻ mạnh tự nhiên. Uống Vikoda mỗi ngày sẽ hỗ trợ tích cực cho hệ tiêu hóa và sức khỏe.\u003c/p\u003e\n\u003cp\u003eUống nước khoáng kiềm thiên nhiên Vikoda mang đến những lợi ích tích cực cho hệ tiêu hóa và sức khỏe!\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/41/fe/0f/c55e9c18fb2f3ea62670bb8b83c30195.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/41/fe/0f/c55e9c18fb2f3ea62670bb8b83c30195.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/41/fe/0f/c55e9c18fb2f3ea62670bb8b83c30195.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/41/fe/0f/c55e9c18fb2f3ea62670bb8b83c30195.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/41/fe/0f/c55e9c18fb2f3ea62670bb8b83c30195.png"},{"base_url":"https://salt.tikicdn.com/ts/product/44/c1/5d/25303d2b09bcd18544caf0c50f175d0c.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/44/c1/5d/25303d2b09bcd18544caf0c50f175d0c.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/44/c1/5d/25303d2b09bcd18544caf0c50f175d0c.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/44/c1/5d/25303d2b09bcd18544caf0c50f175d0c.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/44/c1/5d/25303d2b09bcd18544caf0c50f175d0c.png"},{"base_url":"https://salt.tikicdn.com/ts/product/ee/fa/4a/1987468f4152c24fd9e29ffac7955c04.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ee/fa/4a/1987468f4152c24fd9e29ffac7955c04.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ee/fa/4a/1987468f4152c24fd9e29ffac7955c04.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ee/fa/4a/1987468f4152c24fd9e29ffac7955c04.png","thumbnail_url"