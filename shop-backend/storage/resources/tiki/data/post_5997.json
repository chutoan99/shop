idth":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/af/e1/40/98b255dfc30b3b9104f4bdd6d59b7519.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1663,"all_time_quantity_sold":3,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eMáy trợ giảng Unizone 8080 là máy trợ giảng không dây Hàn Quốc sử dụng Micro HẠT GẠO đeo 1 bên tai. Là model máy trợ giảng công suất 36W VIP nhất thị trường hiện nay. Âm thanh cực kỳ trong và ấm cho giọng nói rõ ràng sắc nét với giọng thật. Hỗ trợ chặn tiếng ồn bên ngoài cho giọng nói tốt nhất, hỗ trợ khi dạy ngoài trời. Chúng ta cùng tìm hiểu những thông tin chi tiết về chiếc máy này nhé!\u003c/p\u003e\n\u003cp\u003eThông số kỹ thuật của máy trợ giảng Unizone 8080\u003c/p\u003e\n\u003cp\u003eCông suất loa: 36W\u003c/p\u003e\n\u003cp\u003eDung lượng PIN máy: 8 - 10 tiếng\u003c/p\u003e\n\u003cp\u003eDung lượng PIN mic: 4-5 tiếng\u003c/p\u003e\n\u003cp\u003eThời gian sạc: 3 tiếng\u003c/p\u003e\n\u003cp\u003eLoại PIN sử dụng: 7.4V Lithium/2200mAh\u003c/p\u003e\n\u003cp\u003eTần số: 50Hz-18kHz\u003c/p\u003e\n\u003cp\u003eChức năng mới: Kích lên loa hội trường\u003c/p\u003e\n\u003cp\u003eCác chức năng khác: Line-In, USB, Micro SD, Bluetooth, Reg\u003c/p\u003e\n\u003cp\u003eKích thước: 140x56x140mm\u003c/p\u003e\n\u003cp\u003eTrọng lượng: 370Gram\u003c/p\u003e\n\u003cp\u003eXuất xứ: Hàn Quốc (Made In Korea)\u003c/p\u003e\n\u003cp\u003eMáy trợ giảng không dây Unizone 8080 VIP nhất thị trường vì Model này được sản xuất trực tiếp tại Hàn Quốc, trên dây truyền công nghệ hiện đại thương hiệu Unizone nổi tiếng.\u003c/p\u003e\n\u003cp\u003eTiếp đó là chất lượng âm thanh của Unizone 8080 tốt nhất thị trường. Có thể nói tới thời điểm hiện tại chưa có model máy trợ giảng nào có âm thanh tốt như máy Unizone 8080.\u003c/p\u003e\n\u003cp\u003eTiếp tục là máy trợ giảng UZ-8080 sở hữu công suất loa lớn nhất trong dòng máy trợ giảng hiện nay Công suất 36W đủ sức cho phòng dưới 150m2 nghe rõ ràng. Unizone 8080 được tích hợp bộ lọc âm đa tầng cho giọng nói hay từ khi thu vào Micro cho tới khi xử lý lại trên máy.\u003c/p\u003e\n\u003cp\u003eNgoài công suất lớn thì Unizone có thể kết nối lên loa hội trường. Tức là nếu trong phòng âm thanh của Unizone 8080 có nhỏ thì có thể kích âm thanh lên qua hệ thống loa hội trường.\u003c/p\u003e\n\u003cp\u003eTrong khi đó, việc sử dụng Micro HẠT GẠO đeo 1 bên tai sẽ rất thuận tiện cho việc giảng dạy. Không còn cảm giác đau bên thái dương hay vướng tóc.\u003c/p\u003e\n\u003cp\u003eMáy trợ giảng Hàn Quốc Unizone 8080 được trang bị dòng PIN 7.4V Lithium/2.200mAh đáp ứng dạy học cả ngày cho dù là người có dạy nhiều tiết nhất 8-10 tiết. Vì máy được trang bị 2 Micro là có dây và không dây. Khi Micro không dây dùng 4-5 tiếng liên tục mà hết có thể chuyển sang sử dụng Micro có dây.\u003c/p\u003e\n\u003cp\u003eĐi theo máy là túi da chống sốc và bộ dây đeo chính hãng. Thầy cô có thể đeo máy trên người rất thuận tiện. Không ảnh hưởng nhiều tới việc giảng dạy hay hoạt động ngoài trời.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/af/e1