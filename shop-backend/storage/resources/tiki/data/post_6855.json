ull,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/media/catalog/product/p/h/phich-giu-nhiet-bang-inox-420ml-binh-xanh-397c2.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2709,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cspan style=\"font-size: medium; color: #008ab7;\"\u003e\u003cstrong\u003ePhích Giữ Nhiệt Elmich 2247917 - 420ml (Màu Xanh)\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\r\n\u003cp\u003e\u003cstrong\u003ePhích Giữ Nhiệt Elmich 2247917 - 420ml (Màu Xanh)\u003c/strong\u003e có lớp vỏ ngoài được làm từ inox cao cấp cùng thiết kế hút chân không và ruột phích tráng bạc sẽ giúp bạn giữ được nhiệt độ của các loại thức uống và thức ăn dạng lỏng. Sản phẩm có thiết kế nhỏ gọn, nắp đậy kín, phích có màu xanh phối cùng nắp xám vô cùng trang nhã sẽ là người bạn đồng hành cùng bạn trong các buổi dã ngoại, cắm trại hay đi học, đi làm, chơi thể \u003c/p\u003e\r\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Phích Giữ Nhiệt Elmich 2247917 - 420ml (Màu Xanh)\" src=\"http://tikicdn.com/media/catalog/product/p/h/phich-giu-nhiet-bang-inox-420ml-binh-xanh-397c2.jpg\" alt=\"Phích Giữ Nhiệt Elmich 2247917 - 420ml (Màu Xanh)\" width=\"400\" height=\"400\" /\u003e\u003c/p\u003e\r\n\u003cp\u003e\u003cstrong\u003eTính năng nổi bật\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp\u003e- Sản phẩm làm từ inox 304 đảm bảo an toàn cho người sử dụng.\u003c/p\u003e\r\n\u003cp\u003e- Thiết kế nhỏ gọn, kiểu dáng đẹp mắt.\u003c/p\u003e\r\n\u003cp\u003e- Sử dụng môi trường chân không giúp truyền nhiệt tốt.\u003c/p\u003e\r\n\u003cp\u003e- Phích giữ nhiệt đa năng.\u003c/p\u003e\r\n\u003cp\u003e\u003cstrong\u003eThông số kỹ thuật\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp\u003e- Dung tích: 420 ml\u003c/p\u003e\r\n\u003cp\u003e- Kích thước: 8 x 8 x 21 cm\u003c/p\u003e\r\n\u003cp\u003e- Trọng lượng: 0.3 kg\u003c/p\u003e\r\n\u003cp\u003e- Chất liệu: Inox\u003c/p\u003e\r\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Phích Giữ Nhiệt Elmich 2247917 - 420ml (Màu Xanh)\" src=\"http://tikicdn.com/media/catalog/product/p/h/phich-giu-nhiet-bang-inox-420ml-binh-xanh-397bd.jpg\" alt=\"Phích Giữ Nhiệt Elmich 2247917 - 420ml (Màu Xanh)\" width=\"400\" height=\"400\" /\u003e\u003c/p\u003e\r\n\u003cp\u003e\u003cstrong\u003eMô tả tính năng\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp\u003e\u003cstrong\u003eThiết kế nhỏ gọn, kiểu dáng đẹp\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp\u003eElmich 2247917 là chiếc phích giữ nhiệt được thiết kế với kiểu dáng nhỏ gọn, tinh tế cùng tông màu xanh lơ và chiếc nắp xám được phối hợp với nhau thật hài hòa. Sản phẩm có nắp đậy kín, chống rò rỉ, bạn có thể đem theo phích giữ nhiệt trong các chuyến tham quan, dã ngoài hoặc đi học, đi làm hay đi chơi thể thao đều được.\u003c/p\u003e\r\n\u003cp\u003e\u003cstrong\u003eSử dụng môi trường cách nhiệt chân không\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp\u003ePhích giữ nhiệt Elmich 2247917 sản xuất theo nguyên tắc kín hơi, lớp vỏ có cấu tạo bằng 2 lớp và phần giữ được hút chân không. Do ở môi trường chân không, không truyền nhiệt và lớp tráng phủ trong lòng bình phản xạ nhiệt vào bên trong khiến cho nước bên trong giữ được nhiệt độ lâu.\u003c/p\u003e\r\n\u003cp\u003e\u003cstrong\u003ePhích được làm từ chất liệu inox 304 cao cấp\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp\u003eSản phẩm được làm từ chất liệu inox 304 chống biến dạng, gỉ sét, an toàn với sức khỏe của người dùng. Ruột bình tráng bạc tạo hiệu quả phản xạ nhiệt vào bên trong khá tốt. Nắp bình bằng nhựa, gioăng cao su giúp giữ kín hơi, chống rò rỉ.\u003c/p\u003e\r\n\u003cp\u003e\u003cstrong\u003eĐa chức năng, mang đến nhiều tiện ích\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp\u003eKhông chỉ dùng để chứa nước lọc nóng - lạnh, phích giữ nhiệt Elmich 2247917 còn được dùng để chứa các thức ăn lỏng như cháo, nước canh, nước súp (giữ nóng) hoặc các loại nước trái cây, nước giải khát (giữ lạnh). Phích có thể chịu được các chấn động khi sử dụng hoặc di chuyển.\u003c/p\u003e\r\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"http://tikicdn.com/media/catalog/product/p/h/phich-giu-nhiet-bang-inox-420ml-binh-xanh-397b71.jpg\" src=\"http://tikicdn.com/media/catalog/product/p/h/phich-giu-nhiet-bang-inox-420ml-binh-xanh-397b71.jpg\" alt=\"http://tikicdn.com/media/catalog/product/p/h/phich-giu-nhiet-bang-inox-420ml-binh-xanh-397b71.jpg\" width=\"434\" height=\"371\" /\u003e\u003c/p\u003e\r\n\u003cp\u003e\u003cstrong\u003eCách nhận biết chất lượng sản phẩm\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp\u003eSo sánh về hình thức bao bì bên ngoài,\u003cstrong\u003e \u003c/strong\u003e\u003cstrong\u003ebình giữ nhiệt Trung Quốc \u003c/strong\u003echỉ có thông tin về thời gian giữ nhiệt, còn bình sản xuất theo tiêu chuẩn châu Âu ghi rõ chỉ dùng để đựng nước nóng và nước lạnh, không sử dụng vào mục đích khác.\u003c/p\u003e\r\n\u003cp\u003eĐáng chú ý là chỉ cần lắc mạnh bình giữ nhiệt Trung Quốc đã phát hiện có vật lạ bên trong. Khi cắt đôi chiếc bình ra đã có thể thấy phần đáy bình có chứa xốp và một túi nilon đựng chất lạ. Tiếp tục cắt đôi một bình giữ nhiệt khác, giữa lớp nhựa và inox là một lớp bột xốp, giống như những hình ảnh mà báo chí Trung Quốc đã cảnh báo trong thời gian gần đây .\u003c/p\u003e\r\n\u003cp\u003eSo sánh với một chiếc bình giữ nhiệt sản xuất theo tiêu chuẩn châu Âu, dễ dàng nhận thấy bên trong bình này chỉ có lớp chân không ở giữa 2 lớp inox chứ không có bất cứ chất gì khác.\u003c/p\u003e\r\n\u003cp\u003e\u003cstrong\u003e(Theo nguồn thông tin từ VTV)\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/media/catalog/product/p/h/phich-giu-nhiet-bang-inox-420ml-binh-xanh-397c2.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/p/h/phich-giu-nhiet-bang-inox-420ml-binh-xanh-397c2.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/p/h/phich-giu-nhiet-bang-inox-420ml-binh-xanh-397c2.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/p/h/phich-giu-nhiet-bang-inox-420ml-binh-xanh-397c2.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/p/h/phich-giu-nhiet-bang-inox-420ml-binh-xanh-397c2.jpg"},{"base_url":"https://salt.tikicdn.com/media/catalog/product/p/h/phich-giu-nhiet-bang-inox-420ml-binh-xanh-397b7.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/p/h/phich-giu-nhiet-bang-inox-420ml-binh-xanh-397b7.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/p/h/phich-giu-nhiet-bang-inox-420ml-binh-xanh-397b7.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/p/h/phich-giu-nhiet-bang-inox-420ml-binh-xanh-397b7.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/p/h/phich-giu-nhiet-bang-inox-420ml-binh-xanh-397b7.jpg"},{"base_url":"https://salt.tikicdn.com/media/catalog/product/p/h/phich-giu-nhiet-bang-inox-420