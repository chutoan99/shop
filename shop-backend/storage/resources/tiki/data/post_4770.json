ny_reason"}},"discount":17700,"discount_rate":15,"rating_average":5,"review_count":9,"review_text":"(9)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/44/bf/4e/1b81c12bb0914b9d302fd3b7fe55cc08.jpeg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":868,"all_time_quantity_sold":124,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"font-style:normal;font-weight:400;font-size:17px;color:#000000;text-decoration:none;\"\u003e\u003cspan style=\"font-family:UICTFontTextStyleEmphasizedBody;font-weight:bold;font-style:normal;font-size:17px;\"\u003e“Là con người, ai cũng mang phức cảm tự ti.”\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"font-style:normal;font-weight:400;font-size:17px;color:#000000;text-decoration:none;\"\u003e\u003cspan style=\"font-family:UICTFontTextStyleBody;font-weight:normal;font-style:normal;font-size:17px;\"\u003eCâu nói này của Alfred Adler đã mở ra một chân trời mới trong việc nghiên cứu tâm lý của con người, về những động lực và chướng ngại mà con người thường gặp phải trong cuộc đời mình.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"font-style:normal;font-weight:400;font-size:17px;color:#000000;text-decoration:none;\"\u003e\u003cspan style=\"font-family:UICTFontTextStyleBody;font-weight:normal;font-style:normal;font-size:17px;\"\u003eChính “phức cảm tự ti” là nguyên nhân khiến chúng ta trở nên cố gắng hơn, nỗ lực hơn để không bị thua kém người khác. Nhưng chính “phức cảm tự ti” cũng là nguyên nhân khiến chúng ta trốn tránh, che đậy cho sự tụt hậu của bản thân bằng những lý do, bằng những lời biện hộ giả tạo khéo léo.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"font-style:normal;font-weight:400;font-size:17px;color:#000000;text-decoration:none;\"\u003e\u003cspan style=\"font-family:UICTFontTextStyleBody;font-weight:normal;font-style:normal;font-size:17px;\"\u003eVấn đề là làm sao tận dụng “phức cảm tự ti” cho đúng để biến nó thành sức mạnh giúp bản thân vượt qua tất thảy mọi khó khăn, thách thức để đi đến cái đích mà bạn đã chọn.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"font-style:normal;font-weight:400;font-size:17px;color:#000000;text-decoration:none;\"\u003e\u003cspan style=\"font-family:UICTFontTextStyleBody;font-weight:normal;font-style:normal;font-size:17px;\"\u003eTâm lý học Adler, thông qua 100 lời trích kinh điển được tác giả Hiroshi Ogura chọn lọc và bình luận, sẽ giúp bạn làm được điều đó. Là một trong những nhà tâm lý học vĩ đại nhất mọi thời, Alfred Adler đã dành cả đời mình cho sự nghiệp tìm hiểu về tâm lý học cá nhân, đặc biệt là cảm giác thấp kém – hay còn gọi là “phức cảm tự ti”.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"font-style:normal;font-weight:400;font-size:17px;color:#000000;text-decoration:none;\"\u003e\u003cspan style=\"font-family:UICTFontTextStyleBody;font-weight:normal;font-style:normal;font-size:17px;\"\u003eHy vọng, cuốn sách này sẽ trở thành người bạn đồng hành hữu ích của bạn đọc trên con đường “tự biết chính mình” và “thay đổi bản thân” – dưới sự soi sáng của ánh trăng Tâm lý học Adler.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"font-style:normal;font-weight:400;font-size:17px;color:#000000;text-decoration:none;\"\u003e\u003cspan style=\"font-family:UICTFontTextStyleItalicBody;font-weight:normal;font-style:italic;font-size:17px;\"\u003e————\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"font-style:normal;font-weight:400;font-size:17px;color:#000000;text-decoration:none;\"\u003e\u003cspan style=\"font-family:UICTFontTextStyleEmphasizedBody;font-weight:bold;font-style:normal;font-size:17px;\"\u003eAlfred Adler\u003c/span\u003e\u003cspan style=\"font-family:UICTFontTextStyleBody;font-weight:normal;font-style:normal;font-size:17px;\"\u003e (1870-1937) là một bác sĩ, chuyên gia tâm thần học người Áo. Ông là người đã sáng lập ra trường phái Tâm lý học cá nhân.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"font-style:normal;font-weight:400;font-size:17px;color:#000000;text-decoration:none;\"\u003e\u003cspan style=\"font-family:UICTFontTextStyleBody;font-weight:normal;font-style:normal;font-size:17px;\"\u003eLà một trong những nhà tâm lý học vĩ đại nhất mọi thời, Alfred Adler đã dành cả đời mình cho sự nghiệp tìm hiểu về tâm lý học cá nhân, đặc biệt là cảm giác thấp kém – hay còn gọi là “phức cảm tự ti”.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"font-style:normal;font-weight:400;font-size:17px;color:#000000;text-decoration:none;\"\u003e \u003c/p\u003e\n\u003cp style=\"font-style:normal;font-weight:400;font-size:17px;color:#000000;text-decoration:none;\"\u003e\u003cspan style=\"font-family:UICTFontTextStyleEmphasizedBody;font-weight:bold;font-style:normal;font-size:17px;\"\u003eHiroshi Ogura\u003c/span\u003e\u003cspan style=\"font-family:UICTFontTextStyleBody;font-weight:normal;font-style:normal;font-size:17px;\"\u003e là nhà tư vấn tổ chức nhân sự, nhà tư vấn tâm lý theo trường phái Adler. Ông nổi tiếng trong việc truyền đạt những tư tưởng của Adler từ lý thuyết phức tạp thành những câu từ dễ hiểu, và ông đã viết nhiều sách về Adler, chẳng hạn như \u003c/span\u003e\u003cspan style=\"font-family:UICTFontTextStyleItalicBody;font-weight:normal;font-style:italic;font-size:17px;\"\u003eTâm lý học đào tạo cấp dưới học từ Adler\u003c/span\u003e\u003cspan style=\"font-family:UICTFontTextStyleBody;font-weight:normal;font-style:normal;font-size:17px;\"\u003e (Nhà xuất bản Nikkei BP). Tác phẩm trước đó, \u003c/span\u003e\u003cspan style=\"font-family:UICTFontTextStyleItalicBody;font-weight:normal;font-style:italic;font-size:17px;\"\u003e100 câu nói của Alfred Adler giúp cách mạng hóa cuộc sống của bạn (tạm dịch)\u003c/span\u003e\u003cspan style=\"font-family:UICTFontTextStyleBody;font-weight:normal;font-style:normal;font-size:17px;\"\u003e đã trở thành ấn phẩm bán chạy với hơn 200.000 bản.\u003c/span\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/44/bf/4e/1b81c12bb0914b9d302fd3b7fe55cc08.jpeg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/44/bf/4e/1b81c12bb0914b9d302fd3b7fe55cc08.jpeg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/44/bf/4e/1b81c12bb0914b9d302fd3b7fe55cc08.jpeg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/44/bf/4e/1b81c12bb0914b9d302fd3b7fe55cc08.jpeg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/44/bf/4e/1b81c12bb0914b9d302fd3b7fe55cc08.jpeg"}],"warranty_policy":null,"authors":[{"id":310307,"name":"Hiroshi Ogura","slug":"hiroshi-ogura"}],"current_seller":{"id":62437,"sku":"3634268156017","name":"Haidangbooks","link":"https://tiki.vn/cua-hang/haidangbooks","logo":"ad/fd/fc/f3f74073a4ec7bd73b817b8ebb675245.png","price":100300,"product_id":"176969625","store_id":58725,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[{"id":97533,"name":"Nhà Sách Vĩnh Thụy","link":"https://tiki.vn/cua-hang/nha-sach-vinh-thuy","logo":"https://vcdn.tikicdn.com/ts/seller/19/f2/bd/8bda12adffb15edf1b3d8339b0238283.jpg","price":118000,"product_id":"274870381","store_id":90454}],"specifications":[{"name":"Thông tin chung","attributes":[{"code":"publisher_vn","name":"Công ty phát hành","value":"Hải Đăng"},{"code":"publication_date","name":"Ngày xuất bản","value":"2022-04-25 17:35:59"},{"code":"dich_gia","name":"Dịch Giả","value":"Linh Phi"},{"code":"book_cover","name":"Loại bì