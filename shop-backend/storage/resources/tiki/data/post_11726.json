://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.8,"review_count":4,"review_text":"(4)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ca/37/5c/b4408848501ed57ff045fed10b37b892.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2406,"all_time_quantity_sold":305,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p class=\"irIKAp\"><strong> KEM ĐÁNH RĂNG BẢO VỆ NƯỚU HIMALAYA COMPLETE CARE TOOTHPASTE </strong></p>\n<p class=\"irIKAp\"> </p>\n<p class=\"irIKAp\"><strong>Dung tích: 100G</strong></p>\n<p class=\"irIKAp\"> </p>\n<p class=\"irIKAp\"> Nướu răng khỏe mạnh là chìa khóa cho răng khỏe mạnh và vệ sinh răng miệng tốt. Kem đánh răng thảo mộc Himalaya chứa Miswak, một chất làm se tự nhiên giúp duy trì sự chắc khỏe và bảo vệ cho nướu răng. Kem Đánh Răng Bảo Vệ Nướu Himalaya Complete Care Toothpaste là công thức thảo mộc được cải tiến bảo vệ răng trong 12 giờ đồng hồ khỏi vi khuẩn có hại và ngăn ngừa mảng bám răng.</p>\n<p class=\"irIKAp\"> Neem và Babool giúp ngăn ngừa viêm nướu và giảm chảy máu nướu răng</p>\n<p class=\"irIKAp\"> Pomegrante là một chất làm se tự nhiên hiệu quả.</p>\n<p class=\"irIKAp\"> </p>\n<p class=\"irIKAp\"><strong>Xuất xứ:</strong> Sản phẩm thuộc thương hiệu Himalaya- một hãng dược mỹ phẩm nổi tiếng khá lâu đời của Ấn Độ (từ năm 1930 đến nay), với tiêu chí là \"HAPPINESS throught WELLNESS\" hãng cam kết các sản phẩm được chiết xuất từ 100% thiên nhiên, thảo dược từ chân đồi Himalaya, an toàn cho sức khỏe từ người già đến trẻ nhỏ.</p>\n<p class=\"irIKAp\"> </p>\n<p class=\"irIKAp\"><strong>Thành phần chính:</strong> Sorbitol, Nước, Hydrated silica, Glycerin, Silica, Sodium lauryl sulfate, Flavour, Xanthan gum, Titanium dioxide, Sodium saccharin, Menthol, Sodium benzoate, Punica granatum pericarp extract, Potassium sorbate, Calcium fluoride, Zanthoxylum alatum fruit extract, Acacia arabica stem bark extract, Terminalia chebula fruit extract, Emblica officinalis fruit extract, Azadirachta indica bark extract, Vitex negundo extract, Thymol, Citric Acid, Salvadora persica stem extract, Acacia Farnesiana Flower/Stem Extract, Acacia catechu bark powder, Mimusops elengi flower extract.</p>\n<p class=\"irIKAp\"> </p>\n<p class=\"irIKAp\"><strong> Hạn sử dụng: 31/3/2024</strong></p>\n<p class=\"irIKAp\"> </p>\n<p class=\"irIKAp\"> Hướng dẫn sử dụng: Dùng được cho cả trẻ em và người lớn. Trẻ em dưới 6 tuổi nên có sự giám sát của người lớn. Khi sử dụng chỉ dùng 1 lượng nhỏ bằng hạt đậu. Không được nuốt. Nhổ ra và súc miệng sau khi đánh răng. Chải răng kỹ lưỡng ít nhất 2 lần/ngày, hoặc theo hướng dẫn của nha sĩ và bác sĩ.</p>\n<p class=\"irIKAp\"> </p>\n<p class=\"irIKAp\">️Bảo Quản: Bảo quản nơi khô ráo thoáng mát,không để nơi có nhiệt độ cao, tránh ánh nắng trực tiếp.</p>\n<p class=\"irIKAp\"> </p>\n<p class=\"irIKAp\">️Lưu ý : Đọc kỹ hướng dẫn trước khi sử dụng, Không chứa hóa chất nguy hiểm. Đã được kiểm nghiệm của bác sĩ, chuyên gia da liễu. Tránh để dính vào mắt. Nếu sản phẩm dính vào mắt hãy rửa sạch bằng nước. Bảo quản nơi khô ráo thoáng mát, không để nơi có nhiệt độ cao, tránh ánh nắng trực tiếp.</p>\n<p class=\"irIKAp\">#himalaya #HIMALAYA_HERBALS #PioneerWagon #MyphamAnDo #Myphamthaoduoc #KEMDANHRANG #dungchomoiloaida #baovenuou #since1930 #toothpaste #rang #viemnuou #hoimieng #saurang</p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ca/37/5c/b4408848501ed57ff045fed10b37b892.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ca/37/5c/b4408848501ed57ff045fed10b37b892.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ca/37/5c/b4408848501ed57ff045fed10b37b892.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ca/37/5c/b4408848501ed57ff045fed10b37b892.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ca/37/5c/b4408848501ed57ff045fed10b37b892.png"},{"base_url":"https://salt.tikicdn.com/ts/product/93/96/40/2ecd344e298a032aa10888525288f4f2.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/93/96/40/2ecd344e298a032aa10888525288f4f2.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/93/96/40/2ecd344e298a032aa10888525288f4f2.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/93/96/40/2ecd344e298a032aa10888525288f4f2.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/93/96/40/2ecd344e298a032aa10888525288f4f2.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/aa/58/3d/a45de60c890978acb0ca461e2fa02761.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/aa/58/3d/a45de60c890978acb0ca461e2fa02761.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/aa/58/3d/a45de60c890978acb0ca461e2fa02761.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/aa/58/3d/a45de60c890978acb0ca461e2fa02761.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/aa/58/3d/a45de60c890978acb0ca461e2fa02761.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/97