load/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/56/a6/e1/755c1d943a2f6cec387883e54bd91ab4.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1201,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch1 class=\"title\"\u003eNước Tẩy Quần Áo Rocket 600ml\u003c/h1\u003e\n\u003cp\u003e\u003cstrong\u003eXuất xứ:\u003c/strong\u003e Nhật Bản/ Made in Japan\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eDung tích:\u003c/strong\u003e 600ml\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/cc/51/24/840417839c439ffe58607881acb13f93.jpg\" alt=\"\" width=\"750\" height=\"779\" /\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003eNước Tẩy Quần Áo Rocket (600ml)\u003c/strong\u003e Loại nước tẩy trắng được sử dụng cho quần áo để tẩy các vết bẩn, vết ố vàng, đồ ăn, vết máu, loại bỏ các vi khuẩn gây mùi khó chịu.\u003c/li\u003e\n\u003cli\u003eSử dụng với các loại chất liệu cotton, lanh, polyester, acrylic.\u003c/li\u003e\n\u003cli\u003eNhập khẩu trực tiếp từ Nhật.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/c5/7f/1c/c28dad508c95851d4fbb76ee7c3ea8c2.jpg\" alt=\"\" width=\"750\" height=\"558\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eHướng dẫn sử dụng\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eGiặt máy: Cho nước tẩy vào cùng với nước giặt.\u003c/li\u003e\n\u003cli\u003eGiặt tay: Ngâm khoảng 30 phút (không quá 2 giờ), tráng lại bằng nước.\u003c/li\u003e\n\u003cli\u003eGiặt máy: 30L nước, dùng 70 ml nước tẩy.\u003c/li\u003e\n\u003cli\u003eGiặt tay: 5L nước, dùng 12 ml nước tẩy. 1L nước, dùng 10 ml nước tẩy.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eChú ý khi sử dụng:\u003c/strong\u003e Không sử dụng với nước nóng. Sau khi sử dụng, rửa tay bằng xà phòng. Nên sử dụng găng tay nếu tiếp xúc trong thời gian dài. Không sử dụng với lụa, chất pha nilon, vải polyurethane, acetate.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch1 class=\"title\"\u003eThanh Xà phòng Giặt Cổ Áo, Tay Áo 100g\u003c/h1\u003e\n\u003cp\u003e\u003cstrong\u003eXuất xứ:\u003c/strong\u003e Nhật Bản/ Made in Japan\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTrọng lượng:\u003c/strong\u003e 100g\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/08/76/6b/37d856b773d775a16f1ead02cfd92d32.jpg\" alt=\"\" width=\"750\" height=\"915\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003e\u003cstrong\u003eCông dụng:\u003c/strong\u003e Sản phẩm giúp dễ dàng loại bỏ các vết bẩn hiệu quả, đặc biệt là vùng cánh tay và cổ áo…\u003cbr /\u003eChỉ cần thấm ướt quần áo, chà nhẹ sản phẩm lên những chỗ có vết bẩn và ngâm, rồi giặt (giặt tay hay giặt máy đều được).\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/66/fe/a8/6f33403dc63a948feba045f0cc0813a2.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eThanh tẩy vết bẩn nhật giúp bạn dễ dàng loại bỏ các vết bẩn nơi cổ áo và cổ tay áo một cách hiệu quả, đặc biệt là vùng cánh tay và cổ á Giữ cho áo quần luôn sạch sẽ. Giặt sạch hiệu quả các vết bùn, dầu khoáng, cafe, nước tương, vết máu, trên vải sợ\u003cbr /\u003e\u003cstrong\u003eHướng dẫn sử dụng:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eChỉ cần thấm ướt quần áo, chà nhẹ sp lên những chỗ có vết bẩn và ngâm, rồi giặt (giặt tay hay giặt máy đều được).\u003c/li\u003e\n\u003cli\u003eCác chất hoạt tính bề mặt có trong sp sẽ giúp lấy đi các vết bẩn cứng đầu đó. đối với các vải màu, cần thử trước trên một vùng nhỏ, nơi khó thấy.\u003c/li\u003e\n\u003cli\u003eRửa sạch tay sau khi sử dụng sp, để xa tầm tay trẻ em\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eBảo quản nơi khô ráo, thoáng mát\u003c/p\u003e\n\u003cp\u003eTránh ánh nắng trực tiếp \u0026amp; nhiệt độ cao!\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/56/a6/e1/755c1d943a2f6cec387883e54bd91ab4.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/56/a6/e1/755c1d943a2f6cec387883e54bd91ab4.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/56/a6/e1/755c1d943a2f6cec387883e54bd91ab4.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/56/a6/e1/755c1d943a2f6cec387883e54bd91ab4.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/56/a6/e1/755c1d943a2f6cec387883e54bd91ab4.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/87/5f/10/e16acff76afb51b848dbbe370faeaefe.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/87/5f/10/e16acff76afb51b848dbbe370faeaefe.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/87/5f/10/e16acff76afb51b848dbbe370faeaefe.jpg","position":null,"small_url":"https://salt.tik