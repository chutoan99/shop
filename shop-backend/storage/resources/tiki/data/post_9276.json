g giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e\u003cp\u003eSản phẩm này là tài sản cá nhân được bán bởi Nhà Bán Hàng Cá Nhân và không thuộc đối tượng phải chịu thuế GTGT. Do đó hoá đơn VAT không được cung cấp trong trường hợp này.\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/2c/a9/db/e704e80d14d70f5b7bec19a290900a67.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/2c/a9/db/e704e80d14d70f5b7bec19a290900a67.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/2c/a9/db/e704e80d14d70f5b7bec19a290900a67.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2c/a9/db/e704e80d14d70f5b7bec19a290900a67.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2c/a9/db/e704e80d14d70f5b7bec19a290900a67.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/f7/b9/db/a6e70c59fa83fe10823dcbf6fa35846b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f7/b9/db/a6e70c59fa83fe10823dcbf6fa35846b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f7/b9/db/a6e70c59fa83fe10823dcbf6fa35846b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f7/b9/db/a6e70c59fa83fe10823dcbf6fa35846b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f7/b9/db/a6e70c59fa83fe10823dcbf6fa35846b.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/d5/85/11/ac8f5439b0cbc196e278c22659bbb9e7.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d5/85/11/ac8f5439b0cbc196e278c22659bbb9e7.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d5/85/11/ac8f5439b0cbc196e278c22659bbb9e7.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d5/85/11/ac8f5439b0cbc196e278c22659bbb9e7.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d5/85/11/ac8f5439