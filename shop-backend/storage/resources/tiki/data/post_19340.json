iscount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/4c/25/24/a11b8ea8b9237ed81884a57eb0e06ee4.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1008,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e Thiết kế mới dạng center nằm ngang của JBL đẹp mắt và sang trọng, kích thước trọng lượng cân đối thích hợp với nhiều không gian.\u003c/p\u003e\n\u003cp\u003e– Thùng loa dạng gỗ cao cấp vừa tăng độ bền bỉ vừa giúp loa hạn chế độ rung khi hoạt động.\u003c/p\u003e\n\u003cp\u003e– 2 phiên bản đen tuyền và vân gỗ thích hợp phối ghép, bố trí với nhiều không gian phòng.\u003c/p\u003e\n\u003cp\u003e– Chất âm chuẩn xác, toàn dải 2,5 đường tiếng, 2 loa bass PolyPlas 13,3 cm tái hiện âm trầm sâu lắng, chân thực.\u003c/p\u003e\n\u003cp\u003e– Loa treble 2,5 cm cho âm cao, sáng rõ, mượt mà.\u003c/p\u003e\n\u003cp\u003e– Công suất khoảng 120W (công suất amply đề xuất 150W) chơi tốt âm thanh mọi thể loại.\u003c/p\u003e\n\u003cp\u003e– Thiết kế ống dẫn sóng hình ảnh độ nét cao (HDI)\u003c/p\u003e\n\u003cp\u003e– Độ tương thích cao, kết nối với âm ly dễ dàng qua 2 cổng – + phía sau.\u003c/p\u003e\n\u003cp\u003eLoa JBL STUDIO 625C là sự kết hợp hoàn hảo giữa một thiết kế đẹp phù hợp đa số không gian, cùng chất âm rõ ràng, chi tiết giúp tái hiện rõ ràng chân thực nhất âm thanh dù nhỏ nhất như tiếng thì thầm, hay tiếng lá rơi… Bởi vậy được sử dụng rất nhiều trong các hệ thống âm thanh xem phim cao cấp trên thị trường hiện nay.\u003c/p\u003e\n\u003cp\u003e\u003cem\u003eLoa center JBL STUDIO 625C giúp tái hiện hoàn hảo âm trung với đặc điểm là giọng nói rõ ràng, chính xác ấn tượng\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"size-full wp-image-9013 aligncenter\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/57/29/5c/2cd92e9c4c77f227f46cc0305bfc21b5.jpg\" sizes=\"(max-width: 800px) 100vw, 800px\" srcset=\"https://salt.tikicdn.com/cache/w750/ts/product/57/29/5c/2cd92e9c4c77f227f46cc0305bfc21b5.jpg 800w, https://salt.tikicdn.com/ts/product/3c/71/df/9ce242dd3ccf79a7c6d673b7aef4185a.jpg 300w, https://salt.tikicdn.com/cache/w750/ts/product/db/53/09/962d161cbf19caa841d88ab6ad5f140a.jpg 768w, https://salt.tikicdn.com/ts/product/0e/cc/70/cbe8001fd807a06e60e016e63475e61e.jpg 370w, https://salt.tikicdn.com/ts/product/6c/c1/84/bf4d813cc0dfec4180e1d6712ad511c6.jpg 600w\" alt=\"\" width=\"800\" height=\"450\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eSTUDIO 625C\u003c/strong\u003e tích hợp một lớp ê căng cao cấp dễ tháo lắp giúp bảo vệ tối đa bass khỏi bui bẩn, kết hợp cùng 4 chân đế chống di chuyển được gắn trực tiếp vào phía dưới thùng loa giúp loa đứng vững vàng trên các mặt phẳng hướng đến người dùng. Loa có hai màu nâu vân gỗ và đen vân gỗ giúp bạn lựa chọn để phù hợp với hệ thống âm thanh của mình.\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"size-full wp-image-9014 aligncenter\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/42/b3/d1/f22f712678ebf428db7faa1d194520c5.jpg\" sizes=\"(max-width: 800px) 100vw, 800px\" srcset=\"https://salt.tikicdn.com/cache/w750/ts/product/42/b3/d1/f22f712678ebf428db7faa1d194520c5.jpg 800w, https://salt.tikicdn.com/ts/product/a8/77/a4/b061d64a2ae0def9e1f437d6b467f2e7.jpg 300w, https://salt.tikicdn.com/cache/w750/ts/product/27/72/ac/6b040db99c679fdd269ec89a7ca9001f.jpg 768w, https://salt.tikicdn.com/ts/product/2a/d1/4e/4cc53625baf112e016e540e7509b6a47.jpg 370w, https://salt.tikicdn.com/ts/product/9a/1e/6b/b547e4ca4fa756c09677162f5cd3b084.jpg 600w\" alt=\"\" width=\"800\" height=\"450\" /\u003e\u003c/p\u003e\n\u003ch3\u003eChất âm chuẩn xác, ít méo tiếng với công nghệ PolyPlas tiên tiến.\u003c/h3\u003e\n\u003cp\u003e\u003cstrong\u003eLoa Center JBL STUDIO 625C\u003c/strong\u003e được thiết kế hoàn hảo với 2 bass 5,25 inch tích hợp công nghệ mới \u003cstrong\u003ePolyPlas \u003c/strong\u003etrong việc thiết kế thiết kế màng loa kết hợp với tép nén 1inch với kèn hình chữ nhật nằm dọc  (HDI) được bố trí ở giữa 2 bass giúp loa tái hiện hoào hảo âm thanh trong khoảng tần số từ 64Hz đến 40 kHz\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"size-full wp-image-9019 aligncenter\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/08/dc/29/4ed90d3fffedaf22b4a25c0acf204e03.jpg\" sizes=\"(max-width: 2560px) 100vw, 2560px\" srcset=\"https://salt.tikicdn.com/cache/w750/ts/product/08/dc/29/4ed90d3fffedaf22b4a25c0acf204e03.jpg 2560w, https://salt.tikicdn.com/ts/product/49/6e/cd/12cb5acecc4c1858f11af94f62b70b59.jpg 300w, https://salt.tikicdn.com/cache/w750/ts/product/ff/6d/e6/448dcd655677b0815fcf15aacd3f6198.jpg 1024w, https://salt.tikicdn.com/cache/w750/ts/product/dc/95/aa/78084258f3f06d48af13b62cf6fec9a1.jpg 768w, https://salt.tikicdn.com/cache/w750/ts/product/ab/49/4b/e840c62c0603e31dbfd6d6f05bfbe821.jpg 1536w, https://salt.tikicdn.com/cache/w750/ts/product/0c/e4/cd/6dfcb3a715ead8fbbf6f447e47652eb5.jpg 2048w, https://salt.tikicdn.com/ts/product/55/b7/0d/34df39d4a3c20a84aa7a4a35bea3fe1b.jpg 370w, https://salt.tikicdn.com/ts/product/7b/e5/4f/b01676180ae66e9d8db4f59210cc4e61.jpg 600w\" alt=\"\" width=\"2560\" height=\"1920\" /\u003e\u003c/p\u003e\n\u003cp\u003eVới thiết kế dạng thùng loa kín cùng công suất khoảng 120W  (tương thích với các amply có công suất kéo 150W) \u003cstrong\u003eJBL STUDIO 625C\u003c/strong\u003e  thích hợp để sử dụng trong các hệ thống nghe nhạc, xem phim cao cấp trên thị trường hiện nay.\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"size-full wp-image-9016 aligncenter\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/3c/d0/0e/6190c10f392c6517b90426da4b9d8f0b.jpg\" sizes=\"(max-width: 800px) 100vw, 800px\" srcset=\"https://salt.tikicdn.co