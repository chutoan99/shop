t":0,"discount_rate":0,"rating_average":4.8,"review_count":14,"review_text":"(14)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/3b/48/cb/7679b82a2bfdcb5c41b024c7b7528b6f.JPG","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1979,"all_time_quantity_sold":91,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cdiv class=\"meta_info meta_info_full medium-100 small-100 tiny-100\"\u003e\n\u003cp\u003e\u003cstrong\u003eThorakao\u003c/strong\u003e là thương hiệu khuynh đảo thị trường Việt Nam trong suốt nhiều thập kỷ, được biết đến với các dòng sản phẩm chăm sóc sức khỏe và làm đẹp có chiết xuất từ thiên nhiên, gần gũi, an toàn và cực kỳ hiệu quả cho người sử dụng.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/59/4a/27/7a4c74aa713b013633bc37256d2eddfe.JPG\" alt=\"\" width=\"750\" height=\"275\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003c/div\u003e\n\u003cp\u003e\u003cstrong\u003e- Sữa rửa mặt hạt nghệ ngừa mụn Thorakao\u003c/strong\u003e với thành phần được chiết xuất từ củ nghệ thiên nhiên, giúp chăm sóc làn da bạn một cách an toàn.\u003c/p\u003e\n\u003cp\u003e- Sản phẩm với các hạt massage nghệ li ti, giúp kích thích lưu thông máu dưới da, se lỗ chân lông, giúp sạch sâu khi da tiếp xúc nhiều bụi bẩn, cho làn da thêm thư giãn, dễ chịu.\u003c/p\u003e\n\u003cp\u003e- Củ nghệ với đặc tính sát trùng hiệu quả sẽ giúp ngăn ngừa sự lây lan của mụn, lấy đi nhân mụn cám, mụn đầu đen và những nốt mụn li ti hiệu quả, mang lại làn da mịn màng, sạch sẽ cho người sử dụng.\u003c/p\u003e\n\u003cp\u003e- Sữa rửa mặt hạt nghệ ngừa mụn Thorakao êm dịu, không tạo bọt, hương thơm đặc trưng của củ nghệ thiên nhiên và độ PH cân bằng, giúp làm sạch da tối ưu, lấy đi bụi bẩn, bã nhờn nhưng không làm mất độ ẩm tự nhiên của da. Sau khi rửa mặt bằng sữa rửa mặt hạt nghệ, da vẫn sẽ ẩm mịn tự nhiên chứ không hề có cảm giác khô căng khó chịu, đảm bảo bạn sẽ hài lòng và tin dùng sản phẩm tự nhiên chất lượng này.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/5e/e3/02/d72facc99843548d97cbed863a217490.JPG\" alt=\"\" width=\"750\" height=\"492\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eHƯỚNG DẪN SỬ DỤNG\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Làm ướt đều da mặt\u003c/p\u003e\n\u003cp\u003e- Cho một ít Sữa Rửa Mặt hạt nghệ ngừa mụn Thorakao vào lòng bàn tay, hòa thêm một ít nước và thoa đều khắp mặt (kết hợp massage nhẹ).\u003c/p\u003e\n\u003cp\u003e- Sau đó rửa mặt lại bằng nước sạch. Sau khi rửa mặt xong, có thể dùng thêm nước hoa hồng để giúp cân bằng da tốt nhất, giúp da hấp thụ tốt hơn các chất dinh dưỡng và thu nhỏ lỗ chân lông hiệu quả nhất\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/af/7b/11/311a1acfcb5d97187a9b63eab0d4c1d2.jpg\" alt=\"\" width=\"750\" height=\"525\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eLƯU Ý:\u003cbr /\u003e\u003c/strong\u003e\u003cspan style=\"color: #091e42;\"\u003e- Bao bì sản phẩm có thể thay đổi theo từng lô hàng từ nhà sản xuất nhé ạ!\u003c/span\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/3b/48/cb/7679b82a2bfdcb5c41b02