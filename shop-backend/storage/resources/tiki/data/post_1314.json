adge","index":0,"icon":null,"icon_width":0,"icon_height":0,"text_color":"#FFF0F1","background_color":"#D93843","href":null,"text":"9.9"},{"placement":"pdp_badge","code":"is_hero","type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"freeship_xtra","type":"pdp_icon_badge","index":2,"icon":"https://salt.tikicdn.com/ts/upload/be/67/48/04a82ab8df178e1a13bde38316081865.png","icon_width":91,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":true,"return_reason":"any_reason"}},"discount":37000,"discount_rate":19,"rating_average":5,"review_count":3,"review_text":"(3)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/76/17/68/0337183602937a7b10ff5aa42313da47.png","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":34,"all_time_quantity_sold":5,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eCUỐN SÁCH GIÚP PHỤ NỮ ĐƯỢC LÀ CHÍNH MÌNH, ĐẠT ĐƯỢC HẠNH PHÚC, THÀNH CÔNG BẰNG TÌNH YÊU THƯƠNG VÔ ĐIỀU KIỆN.\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eKhông cần hy sinh hay đánh đổi bất cứ điều gì, phụ nữ hoàn toàn có thể đạt được cả thành công trong sự nghiệp lẫn hạnh phúc trong gia đình với TÌNH YÊU THƯƠNG VÔ ĐIỀU KIỆN.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cspan style=\"font-weight:400;\"\u003e\u003cstrong\u003eCuốn sách này sẽ mang đến cho bạn:\u003c/strong\u003e\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eTâm thế chủ động lèo lái cuộc đời ở mọi phương diện: Học hành, sự nghiệp và tình yêu\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003e4 câu hỏi đơn giản, giúp bạn xác định ước mơ thật sự và lên kế hoạch rõ ràng để chinh phục hoài bão ấy\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eNhững bài học quý giá trong hôn nhân giúp vun đắp gia đình hạnh phúc, luôn tràn đầy thấu cảm và yêu thương\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eKinh nghiệm đồng hành với con, cách thức bồi dưỡng nội lực và tăng cường ngoại lực để con vững vàng tiến xa trên đường đời\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eBí quyết xây dựng doanh nghiệp hạnh phúc và thịnh vượng - nơi mọi thành viên được trân trọng và phát triển\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eTriết lý “Cho đi hào phóng, Đón nhận cừ khôi\", giúp bạn vun bồi những mối quan hệ chân thành và sâu sắc\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eVới ngòi bút đầy cảm xúc và tinh tế, giọng văn khi thì nhỏ nhẹ tâm tình, khi thì điềm tĩnh chiêm nghiệm, tác giả đã vẽ nên bức tranh chân thực về hạnh phúc của một người phụ nữ. Từ đó, giúp bạn đọc nhận ra rằng: \u003c/span\u003e\u003cstrong\u003ePhụ nữ không phải lúc nào cũng là phái yếu, họ mạnh mẽ nhất khi là phụ nữ\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eVỀ TÁC GIẢ\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/c2/01/9c/e7dc1baffab003be3e7c7f52e484c5b0.png\" alt=\"\" width=\"348\" height=\"348\" /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTác giả Lê Hiền Lương\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003ePhó chủ tịch HĐQT Công ty cổ phần Điện và Chiếu sáng An Phú\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eGiám đốc Công ty TNHH MTV Le Lapin Vietnam \u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eChủ đầu tư hai nhà máy điện Năng lượng mặt trời Minh Hiếu và MDT\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eCổ đông chiến lược- Lãnh đạo nhân ái tập đoàn Táo Vàng Toàn Cầu\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eCổ đông chiến lược Công ty SK-Global (là chủ đầu tư của hệ thống trường Quốc Tế OIS)\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eCổ đông chiến lược hệ thống Anh ngữ, Toán tư duy Quốc Tế S-Group\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eCổ đông chiến lược của Retreat Puluong Natura\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eLỜI KHEN TẶNG DÀNH CHO QUYỂN SÁCH\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/b4/e3/5e/504853144392385e407bad0310eaed7f.png\" alt=\"\" width=\"567\" height=\"567\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eTÓM TẮT SÁCH\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eSự nghiệp và Gia đình - Người phụ nữ phải làm thế nào để dung hòa cả hai, kiến tạo cuộc sống viên mãn? Bài toán này tuy khó nhưng không phải không có cách giải. Bạn sẽ tìm ra đáp án thuyết phục nhất thông qua cuốn sách này. \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eCuốn sách sẽ giúp phụ nữ\u003c/span\u003e\u003cstrong\u003e thôi loay hoay trong vòng xoáy gia đình - sự nghiệp\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e, trao cho họ chìa khóa\u003c/span\u003e\u003cstrong\u003e khai mở nội lực tiềm ẩn\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e, tự tin bước vào hành trình \u003c/span\u003e\u003cstrong\u003ekiến tạo cuộc đời hạnh phúc\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e.\u003c/span\u003e \u003cspan style=\"font-weight:400;\"\u003eHãy nhớ, \u003c/span\u003e\u003cstrong\u003ephụ nữ không phải lúc nào cũng là phái yếu, họ mạnh mẽ nhất khi là phụ nữ\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCHƯƠNG 1: VẼ CUỘC ĐỜI MÌNH KHAO KHÁT\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eTinh thần tự chủ là chất liệu quan trọng để vẽ nên cuộc đời mà bạn hằng khao khát. \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eBản lĩnh tự chủ cần được rèn luyện trong mọi khía cạnh của cuộc sống, bao gồm:\u003c/span\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eLiên tục \u003c/span\u003e\u003cstrong\u003ehọc hỏi với thái độ chủ động và khiêm nhường\u003c/strong\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eXây dựng \u003c/span\u003e\u003cstrong\u003etâm thế làm chủ ngay từ khi làm thuê\u003c/strong\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eLựa chọn bạn đời\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e dựa trên sự \u003c/span\u003e\u003cstrong\u003ethấu hiểu giá trị của bản thân, \u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003evun đắp mối quan hệ đồng điệu và tôn trọng lẫn nhau.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eBản lĩnh đích thực của một người không nằm ở những hào nhoáng bên ngoài như địa vị hay ngoại hình, mà chính là sức mạnh nội tại giúp họ tự tin định hướng cuộc đời và đạt được hạnh phúc thực sự.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCHƯƠNG 2: ƯỚC MƠ XUẤT PHÁT TỪ TRÁI TIM\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eMơ nhiều, mơ cao, mơ lớn không hề sai. Nhưng một khi đã dám mơ, hãy mạnh mẽ thực hiện. Ước mơ càng lớn, hành động phải càng quyết liệt.\u003c/span\u003e \u003cspan style=\"font-weight:400;\"\u003eĐó là thông điệp mà tác giả muốn nhắn gửi đến bạn đọc thông qua các bài học thực tế kèm theo những công cụ thiết thực giúp bạn biến hoài bão thành hiện thực:\u003c/span\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003e4 câu hỏi \u003c/span\u003e\u003cstrong\u003exác định ước mơ\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e xuất phát từ trái tim, giúp bạn thoát khỏi ma trận của những mong muốn hời hợt\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003e4 \u003c/span\u003e\u003cstrong\u003ebước biến ước mơ thành sự thật\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e: Xác định mục tiêu lớn, chia thành những cột mốc nhỏ, vạch ra các phương án thực hiện và kiên định bước đi\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003e3 cách \u003c/span\u003e\u003cstrong\u003eduy trì động lực\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e hiện thực hóa ước mơ: sử dụng tư duy đích đến, tạo thông điệp có cảm xúc và cuốn sổ ước mơ\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eKhi dành thời gian để suy ngẫm và thực hành những bài tập từ chương này, bạn sẽ khám phá ra ước mơ chân chính, xuất phát từ tận sâu thẳm trái tim mình và cách để biến nó thành hiện thực.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCHƯƠNG 3: HỌA MÀU HÔN NHÂN\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eHôn nhân bền vững đặt nền móng trên sự thấu hiểu và nâng đỡ nhau như cây với đất. Vậy, làm thế nào để người phụ nữ trở thành mảnh đất lý tưởng, để chồng an tâm bám rễ và vững vàng trước những sóng gió?\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eTheo tác giả, cách hiệu quả nhất chính là \u003c/span\u003e\u003cstrong\u003etự tin phát huy thế mạnh đặc trưng\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e của phụ nữ - khả năng quán xuyến nhiều việc, sự tinh tế, thấu hiểu và kiên trì. \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eBên cạnh đó, tác giả còn chia sẻ 5 bài học kinh nghiệm để lèo lái con thuyền hôn nhân vượt qua mọi chông gai đời thường:\u003c/span\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eBài học yêu thương: Thương ai thương cả niềm đau, nỗi buồn\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eBài học kết nối: Tìm lập trường chung giữa những bất hòa\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eBài học thay đổi: Kiên trì sửa tâm\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eBài học bao dung: Ôm lấy người những khi “xấu xí\"\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eBài học nâng đỡ: Đồng cảm không phán xét\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCHƯƠNG 4: CON CÁI LÀ NGƯỜI THẦY VĨ ĐẠI NHẤT\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eDi sản quý giá nhất\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e mà tất cả \u003c/span\u003e\u003cstrong\u003ecác bậc cha mẹ\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e, bất kể giàu hay nghèo, đều có thể \u003c/span\u003e\u003cstrong\u003eđể lại cho con\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e không phải quyền lực hay tài lực, mà là \u003c/span\u003e\u003cstrong\u003enội lực.\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e Hiểu được điều đó nên ngay từ nhỏ, tác giả đã chú trọng giúp con hình thành \u003c/span\u003e\u003cstrong\u003etư duy đích đến, thói quen sống có kế hoạch\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e và \u003c/span\u003e\u003cstrong\u003esự tự tin ra quyết định\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e, qua đó đúc kết được sáu kinh nghiệm sau:\u003c/span\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eTin con từ thuở còn thơ\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e: Muốn con tự lập, trước hết bạn phải tin rằng con có khả năng tự lập.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eVẽ đường cho hươu chạy đúng:\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e Thay vì cấm đoán vì sợ con làm sai, hãy để cho con được phép sai và học cách làm đúng. \u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eDạy con lập kế hoạch to qua những cuộc trò chuyện nhỏ: \u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003eCách dẫn dắt bé lên kế hoạch cho mọi việc thông qua các câu hỏi 5W + 1H.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eTôn trọng quyết định của con\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e: Cha mẹ sinh ra con nhưng con không phải là bản sao của cha mẹ. Chúng ta cần chấp nhận sự khác biệt và tôn trọng mục tiêu, nguyện vọng riêng của con.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eDạy con làm chủ đồng tiền\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e bằng cách hình thành tư duy đúng đắn về tiền, cho con sáng tạo cách kiếm tiền và dạy con giữ tiền, tiêu tiền có kế hoạch\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eGiúp con rèn luyện thói quen tốt\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e bằng \u003c/span\u003e\u003cstrong\u003enguyên tắc Em-Chị-Anh\u003c/strong\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCHƯƠNG 5: YÊU THƯƠNG TẠO NÊN DOANH NGHIỆP HẠNH PHÚC\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eMuốn nhân viên xem việc của công ty như việc của bản thân, chúng ta phải tạo cho họ cảm giác công ty như là nhà của chính họ. Khi mỗi thành viên trong tổ chức đều cảm thấy hạnh phúc, doanh nghiệp đương nhiên sẽ phát triển. \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eĐể xây dựng được sự nghiệp thịnh vượng và bền vững, tác giả chia sẻ những quan niệm lãnh đạo sâu sắc: \u003c/span\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eNhững bước tiến của tổ chức phải xuất phát từ người đứng đầu, bởi chỉ khi \u003c/span\u003e\u003cstrong\u003elãnh đạo đổi tính, doanh nghiệp mới có thể chuyển mình\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e. \u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eMột \u003c/span\u003e\u003cstrong\u003edoanh nghiệp hạnh phúc \u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003evừa là \u003c/span\u003e\u003cstrong\u003esân bay cho nhân viên cất cánh\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e - thúc đẩy họ \u003c/span\u003e\u003cstrong\u003ephát triển\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e toàn diện về \u003c/span\u003e\u003cstrong\u003etư duy, sức khỏe \u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003elẫn \u003c/span\u003e\u003cstrong\u003ekỹ năng\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e - vừa là ngôi nhà, nơi họ cảm thấy tin tưởng, gắn bó và yên tâm góp sức xây dựng.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eXây dựng văn hóa doanh nghiệp phù hợp là một trong những việc quan trọng bậc nhất của người lãnh đạo. \u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCHƯƠNG 6: CHO ĐI HÀO PHÓNG, ĐÓN NHẬN CỪ KHÔI\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eNếu có một phép màu giúp bạn \u003c/span\u003e\u003cstrong\u003ethu hút sự\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e thịnh vượng, \u003c/span\u003e\u003cstrong\u003eduy trì nguồn năng lượng tích cực\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e và \u003c/span\u003e\u003cstrong\u003ehàn gắn những mối quan hệ tổn thương\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e, liệu bạn có sẵn lòng trải nghiệm?\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003ePhép màu ấy chính là lòng biết ơn. Ai cũng có thể bồi dưỡng lòng biết ơn bên trong mình bằng cách: \u003c/span\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eThường xuyên dành thời gian trồng “cây biết ơn”.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eThực hành lòng bao dung, “đổi lăng kính, biến ghét thành thương\".\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eBên cạnh đó, tác giả còn chia sẻ một bí quyết nuôi dưỡng những mối quan hệ sâu sắc, chân thành: Cho đi hào phóng, đón nhận cừ khôi. Khi bạn trao đi điều tử tế đúng cách - bằng niềm tin yêu, đúng người, đúng lúc, đúng phương tiện - mà không mong cầu đền đáp, bạn sẽ đón về vô vàn yêu thương. \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003e#HienLuong #Giadinh #Phunuthanhcong #Phunuhanhphuc #giver #thanhcong\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/76/17/68/0337183602