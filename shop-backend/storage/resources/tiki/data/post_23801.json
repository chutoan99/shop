:{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":3.7,"review_count":9,"review_text":"(9)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/c9/03/56/065a68f959b072d5b0e24f5117449a7e.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1443,"all_time_quantity_sold":59,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003chtml\u003e\n \u003chead\u003e\u003c/head\u003e\n \u003cbody\u003e\n  \u003cul\u003e\n   \u003cp\u003eThương hiệu được sử dụng rộng rãi tại INDONESIA\u003c/p\u003e\n   \u003cp\u003eFULL PENETRATE - DẦU CHỐNG RỈ SÉT\u003c/p\u003e\n   \u003cp\u003eFULL MEGACOOLS PENETRATE là một chất bôi trơn đa chức năng rất mạnh như chất bôi trơn chống rỉ và bảo vệ độ ẩm trở lại. Rất an toàn để sử dụng cho nhiều phương tiện khác nhau như nhựa vinyl, da, nhựa, thép không gỉ, cao su nhựa. Có thể được sử dụng cho các thiết bị gia dụng, văn phòng, cho đến sản xuất.\u003c/p\u003e\n   \u003cp\u003eCHẾ TẠO KHUÔN - SẠCH BỀ MẶT TIẾP XÚC - VỆ SINH XÍCH - TẨY RỬA DẦU MỠ\u003c/p\u003e\n   \u003cp\u003eChất tẩy rửa và hoà tan: keo cũ, nhãn dán, sơn, nhựa đường, nhựa đường trên thân xe, phụ tùng, cơ khí, \u003c/p\u003e\n   \u003cp\u003eLoại bỏ độ ẩm, ngăn chặn tiếp xúc điện / chống rò rỉ mạch điện (Bugi, dây điện, máy phát điện, máy phát điện)\u003c/p\u003e\n   \u003cp\u003eDầu nhờn và chống rỉ sét và ăn mòn\u003c/p\u003e\n   \u003cp\u003eXâm nhập nhanh chóng (theo sử dụng để mở bu lông bị kẹt, bản lề cửa bôi trơn, lỗ khóa, cơ cấu cáp, phanh, bàn đạp ly hợp, lò xo ghế, giảm xóc, xe đạp xích / xe máy, điện tử, lực đẩy.\u003c/p\u003e\n   \u003cp\u003eTRONG NƯỚC KHÔNG xảy ra ngắn mạch, sau 5 phút phân tử hấp thụ.\u003c/p\u003e\n   \u003cp\u003eCÁCH SỬ DỤNG: (1). Lắc đều trước khi sử dụng. (2). Xịt trực tiếp vào phần mong muốn để làm sạch, xịt đều và hỗ trợ với bàn chải. (3). Lặp lại ứng dụng nếu cần thiết cho kết quả tối đa. (4). Có thể được sử dụng khi động cơ đang hoạt động. (5). Xịt lại sau mỗi 4 - 6 tuần để làm sạch và bảo dưỡng định kỳ.\u003c/p\u003e\n   \u003cp\u003eĐóng gói có sẵn: 300ML - 500ML\u003c/p\u003e\n  \u003c/ul\u003e\n \u003c/body\u003e\n\u003c/html\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/c9/03/56/065a68f959b072d5b0e24f5117449a7e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c9/03/56/065a68f959b072d5b0e24f5117449a7e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c9/03/56/065a68f959b072d5b0e24f5117449a7e.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c9/03/56/065a68f959b072d5b0e24f5117449a7e.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c9/03/56/065a68f959b072d5b0e24f5117449a7e.jpg"}],"warranty_policy":null,"brand":{"id":281823,"name":"MEGACOOLS","slug":"megacools"},"current_seller":{"id":150479,"sku":"1399690538146","name":"NK LUBE CENTER SHOP","link":"https://tiki.vn/cua-hang/nk-lube-center-shop","logo":"e9/5e/1d/d305219d38b34cf68b6c95a63e5760d4.jpg","price":65000,"product_id":"68480085","store_id":138834,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Thông tin chung","attributes":[{"code":"brand","name":"Thương hiệu","value":"MEGACOOLS"},{"code":"brand_country","name":"Xuất xứ thương hiệu","value"