.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":160000,"discount_rate":40,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/58/8e/e6/853cfe0055098db975634bff3df3da21.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":737,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eMÔ TẢ SẢN PHẨM\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/cf/da/0f/396998866fda3cdd6cab3c779eb63243.jpg\" alt=\"\" width=\"600\" height=\"382\" /\u003e\u003c/p\u003e\n\u003cp\u003e- Tủ lạnh sử dụng lâu ngày với không gian chứa đựng nhiều loại thực phẩm nên thường có mùi khó chịu khiến bạn e ngại mỗi khi mở cửa. Là nơi bảo quản thực phẩm cho cả gia đình từ thực phẩm sống chín, sơ chế hoặc chưa qua sử dụ đều để chung nên hỗn hợp này sẽ tạo ra mùi vô cùng khó chịu.\u003c/p\u003e\n\u003cp\u003e- Việc sử dụng các sản phẩm khử mùi cho tủ lạnh là cần thiết giúp mỗi loại thực phẩm giữ nguyên được hương vị đặc trưng vốn có và khắc phục \"nỗi sợ\" về mùi mỗi khi mở tủ lạnh.\u003c/p\u003e\n\u003cp\u003e- Với thiết kế nhỏ gọn dành riêng cho tủ lạnh, có thể treo ở cửa tủ lạnh để các phân tử khử mùi khuếch tán 360° đồng đều giữa các ngăn.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/84/04/fb/970c120d3044220ff01365530a8c9418.jpg\" alt=\"\" width=\"750\" height=\"900\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/77/fe/4d/0808f44b5342363be0d136f00a82fb7e.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e - Thiết bị ứng dụng công nghệ ozone hiện đại, hiệu quả trong xử lý mùi trong nhà vệ sinh, các nhà hàng, phòng khách sạn, quán karaoke, quán cà phê có mức diện tích trong khoảng 15-20m2.\u003c/p\u003e\n\u003cp\u003e- Thay vì tạo ra mùi thơm để lấn át mùi hôi tạm thời như các sản phẩm tạo mùi hương hay bình xịt, Máy khử mùi tủ lạnh CTFAST tận dụng những ưu điểm của ozone một cách khoa học, ozone được sản sinh ra nhanh chóng xâm nhập và phá vỡ cấu trúc của các phân tử mùi, loại bỏ vi khuẩn, nấm mốc, loại bỏ khả năng phát tán mùi hôi hay phát sinh dịch bệnh.\u003c/p\u003e\n\u003cp\u003e- Sử dụng công nghệ bảo quản thực phẩm mới chuyên nghiệp hơn, kìm hãm chất Ethylen trên bề mặt rau củ, kéo dài độ tươi mà không sợ bị hỏng.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/5e/f0/38/eb367ef57bded43105e357ea255eac71.jpg\" alt=\"\" width=\"750\" height=\"900\" /\u003e\u003c/p\u003e\n\u003cp\u003e-----------------------------------------------\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eỨNG DỤNG\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Khử mùi diệt khuẩn tủ lạnh\u003c/p\u003e\n\u003cp\u003e- Khử mùi nhà tắm, nhà vệ sinh\u003c/p\u003e\n\u003cp\u003e- Khử mùi phòng ngủ, phòng khách, nhà bếp, sảnh.\u003c/p\u003e\n\u003cp\u003e- Khử mùi vật nuôi.\u003c/p\u003e\n\u003cp\u003e- Khử mùi hôi phòng người già.\u003c/p\u003e\n\u003cp\u003e- Khử mùi khói các loại.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/8a/ff/d3/da6f2c94650b704e20ca7f6ea4d19558.jpg\" alt=\"\" width=\"750\" height=\"617\" /\u003e\u003c/p\u003e\n\u003cp\u003e- Diệt nấm mốc, vi khuẩn, virus, mầm bệnh lây lan trong không khí.\u003c/p\u003e\n\u003cp\u003e- Khử mùi thú cưng.\u003c/p\u003e\n\u003cp\u003e- Thời lượng pin lâu dài, có thể sử dụng được 1 tháng\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/2e/b6/d5/0d059cc40be63f43f6b0db118405225b.jpg\" alt=\"\" width=\"750\" height=\"542\" /\u003e\u003c/p\u003e\n\u003cp\u003e- Với dung lượng pin 1200mAh có thể sạc đầy trong vòng 3 tiếng bạn đã có thể sử dụng 30 ngày liên tục (ở chế độ khử mùi, giữ tươi thực phẩm) và 48h đối với chế độ khử mùi và khử trùng.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/87/ee/b7/95aec291d58f0ea76a57941af0fdf296.jpg\" alt=\"\" width=\"750\" height=\"1030\" /\u003e\u003c/p\u003e\n\u003cp\u003e--------------------------------\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTHÔNG SỐ SẢN PHẨM\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/7e/fa/f9/1fc2aeae13cd55569191a596cfa3532d.jpg\" alt=\"\" width=\"750\" height=\"854\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003c/p\u003e\u003csource type=\"image/webp\"\u003e\u003c/source\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/58/8e/e6/853cfe0055098db975634bff3df3da21.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/58/8e/e6/853cfe0055098db975634bff3df3da21.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/58/8e/e6/853cfe0055098db975634bff3df3da21.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache