ate":7,"rating_average":4.8,"review_count":105,"review_text":"(105)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/23/a4/96/6928efcbe193ee2cd1ecc5213f5ca34e.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":896,"all_time_quantity_sold":453,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/52/3a/1d/17d1d7d3a5b6a41c6fe8cacd8896ac18.png\" alt=\"\" width=\"750\" height=\"970\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ea/d5/5f/b85bb48bb92796acce31d16320d26a3e.png\" alt=\"\" width=\"750\" height=\"1088\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/89/5d/30/a19090f9f47e3ed24a9447e60a1cb11a.png\" alt=\"\" width=\"750\" height=\"1088\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/1c/2d/26/3d579e5cf827b57a9dd77dd87e28c730.png\" alt=\"\" width=\"750\" height=\"1086\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/4c/3a/82/8389c00bca10c5de23a66b816ce5de65.png\" alt=\"\" width=\"750\" height=\"1308\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/63/8a/b4/1fac3ae0faf8244ec0f93b2287ad441a.png\" alt=\"\" width=\"750\" height=\"913\" /\u003e\u003c/p\u003e\n\u003cp\u003eĐồ vật trong nhà ngổn ngang, bừa bãi mà không có nơi để sắp xếp bài trí nó một cách gọn gàng ngăn nắp? Đừng lo, đã có sản phẩm Kệ đa năng GM05 IGA hiện đại cao cấp, một trợ thủ đắc lực trong ngôi nhà của bạn.\u003c/p\u003e\n\u003cp\u003eKệ để đồ đa năng là một vật dụng không thể thiếu, xuất hiện hầu hết trong mọi ngóc ngách trong nhà do tính ứng dụng cao, linh hoạt của nó.\u003c/p\u003e\n\u003cp\u003eSản phẩm sở hữu thiết kế tinh giản nhưng mang tính thẩm mỹ cao, chất lượng tốt, giúp không gian nhà của bạn trở nên gọn gàng. Với thiết kế hữu dụng này, việc sắp xếp đồ đạc sẽ trở thành thú vui mỗi ngày của bạn.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTHÔNG TIN SẢN PHẨM\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eKích thước: 3 Tầng (50x30x64) 4 Tầng (50x30x99cm) 5 Tầng (50x30x127cm)\u003c/li\u003e\n\u003cli\u003eChất liệu: Khung thép không ghỉ sơn tĩnh điện, gỗ MDF phủ melamin\u003c/li\u003e\n\u003cli\u003eMàu sắc: Khung trắng - vân gỗ, khung đen - vân gỗ\u003c/li\u003e\n\u003cli\u003eCông năng: Sắp xếp không gian bếp gọn gàng ngăn nắp.\u003c/li\u003e\n\u003cli\u003eCấu tạo: Là sản phẩm có cấu tạo thông mình lắp ráp dễ dàng bạn có thể lắp ráp ngay khi nhận hàng và shop cung cấp phụ kiện hướng dẫn chi tiết.\u003c/li\u003e\n\u003cli\u003eĐặc tính sản phẩm:\n\u003cul\u003e\u003cli\u003eGỗ MDF cao cấp chống cong vênh, mối mọt, chống cháy\u003c/li\u003e\n\u003cli\u003eLớp Melamine dày dặn chống thấm nước, trầy xước do va đập\u003c/li\u003e\n\u003cli\u003eKhông có chất hóa học trên gỗ gây hại cho người\u003c/li\u003e\n\u003cli\u003eDán chỉ cạnh cho ván gỗ luôn giữ được độ chắc không bị nứt gãy gỗ\u003c/li\u003e\n\u003cli\u003eCác tầng có kích thước vừa phải để sắp xếp đồ, sáng tạo trang trí\u003c/li\u003e\n\u003cli\u003eKhung thép chắc chắn, phủ sơn tĩnh điện chống gỉ, hao mòn, sự oxy hóa.\u003c/li\u003e\n\u003cli\u003eDễ dàng vệ sinh lau chùi đơn giản\u003c/li\u003e\n\u003cli\u003eDễ dàng di chuyển kệ vì khối lượng không đáng kể\u003c/li\u003e\n\u003cli\u003eGỗ bền có hạn sử dụng lâu năm\u003c/li\u003e\n\u003c/ul\u003e\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/1a/4c/80/ae5b1ea40a60c9602508c07a2f4eefbf.png\" alt=\"\" width=\"0\" height=\"0\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/23/a4/96/6928efcbe193ee2cd1ecc5213f5ca34e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/23/a4/96/6928efcbe193ee2cd1ecc5213f5ca34e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/23/a4/96/6928efcbe193ee2cd1ecc5213f5ca34e.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/23/a4/96/6928efcbe193ee2cd1ecc5213f5ca34e.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/23/a4/96/6928efcbe193ee2cd1ecc5213f5ca34e.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/cf/01/cf/cf95d81e82ae948bf44b9fc45fd57ee5.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/cf/01/cf/cf95d81e82ae948bf44b9fc45fd57ee5.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/cf/01/cf/cf95d81e82ae948bf44b9fc45fd57ee5.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/cf/01/cf/cf95d81e82ae948bf44b9fc45fd57ee5.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/cf/01/cf/cf95d81e82ae948bf44b9fc45fd57ee5.png"}],"warranty_policy":null,"brand":{"id":523789,"name":"IGA","slug":"iga"},"current_seller":{"id":48574,"sku":"7133864426712","name":"IGEA Nội Thất Thông Minh","link":"https://tiki.vn/cua-hang/igea-noi-that-thong-minh","logo":"d6/a4/69/a586534fc4d76d788023dc79e2778999.png","price":215000,"product_id":"172950050","store_id":46608,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Operation","attributes":[{"code":"is_warranty_applied","name":"Sản phẩm có được bảo hành không?","value":"Có"},{"code":"warranty_form","name":"Hình thức 