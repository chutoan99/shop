lor":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":400000,"discount_rate":6,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/4b/6b/0d/0e2ed9d5b70c38844130a1b467c4e959.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":609,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eLoa kéo Nanomax K-180 lưới xám là siêu phẩm 4 tấc chính thức ra mắt cuối 10/2022. Mệnh danh là \"The Best Audio\", Nanomax K180 không chỉ là tốt nhất, mà tốt nhất từ trước tới nay so với các dòng loa kéo do Nanomax sản xuất, vì được được cập nhật công nghệ hoàn toàn mới, có kích thước thùng lớn và công suất khủng nên khoảng âm rộng, chất âm vang - trong - hay vượt trội.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTHÔNG SỐ KỸ THUẬT LOA KẸO KÉO NANOMAX K-180 :\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e• Số đường tiếng: 03\u003cbr /\u003e• Công suất: 820W\u003cbr /\u003e• Thời gian sạc: 5 tiếng\u003cbr /\u003e• Thời gian dùng: 4-7 tiếng\u003cbr /\u003e• Loa Bass: 40cm\u003cbr /\u003e• Loa Mid: 16cm\u003cbr /\u003e• Loa Treble: Họng còi\u003cbr /\u003e• Kết nối không dây: Bluetooth 5.0\u003cbr /\u003e• Micro: Không dây band tần UHF\u003cbr /\u003e• Tiện ích: Cổng USB, thẻ nhớ, mic có dây 6.5 x2; Jack guitar 6.5, Audio In/Output 3.5\u003cbr /\u003e• Kích thước/ Trọng lượng: (45.5 x 46.5 x 79)cm / 36kg\u003cbr /\u003e• Chất liệu thùng: Gỗ sơn gai chống trầy \u003cbr /\u003e• Sản xuất tại: Việt Nam\u003cbr /\u003e• Thương hiệu: Nanomax\u003cbr /\u003e• Sử dụng nguồn: AC 220V hoặc Ắc qui 12V/20A\u003cbr /\u003e• Phụ kiện: 1 dây sạc, 2 micro, 4 pin và 1 hướng dẫn\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eLOA KARAOKE NANOMAX K180 CÓ ƯU ĐIỂM GÌ?\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eNanomax K-180 là phiên bản loa kéo tốt nhất trước nay, vì nó thừa hưởng công nghệ tiên tiến nhất 2022, là loa karaoke 4 tấc duy nhất tích hợp hiệu ứng âm thanh Reverb cho giọng hát mượt nhẹ thanh thoát hơn.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\"Nanomax K180 - Vươn tầm giọng hát, nâng tầm cuộc vui\"\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eNgoại hình bắt mắt, nhìn vào là mê, in chữ The Best Audio trên lưới giúp loa trở nên sang trọng, đẹp đẽ mà khách hàng nào cũng muốn sở hữu.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eTuy là loa bass 4 tấc nhưng thùng loa có kích thước lớn, chất gỗ chắc chắn; bố cục loa bass, treble và loa mid hợp lý nên âm thanh vang xa, lúc cần thì trầm ấm.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eTốc độ xủ lý âm thanh nhanh, cường độ âm thanh đánh ngang loa 5 tấc công suất lớn. Khi mở nhạc bằng K180, nếu mang đối chiếu với con loa bất kì khác sẽ thấy ngay sự khác biệt rất lớn về chất lượng âm thanh.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eBảng điều khiển 18 nút chức năng, đầy đủ tất cả thông số, người chơi tùy ý chỉnh loa cho phù hợp với tông và chất giọng của mình.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eLoa kéo Nanomax K-180 có đẩy đủ cổng USB, thẻ nhớ để chạy file nhạc khi không có wifi; 2 lỗ cắm micro có dây hỗ trợ 4 người hát cùng lúc; có cổng Guitar, cổng Audio In/Output để kết nối với các thiết bị nhạc khác.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eMicro band tần UHF chống lạc tần số, chống hú siêu hạng, thiết kế gọn gàng, sang trọng, cầm nặng đầm chắc tay.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eBluetooth 5.0 kết nối tầm xa tới 15m không gây ngắt nhạc giữa chừng, giúp giữ cuộc vui trọn vẹn.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e️CHẾ ĐỘ BẢO HÀNH\u003cbr /\u003e• 1 đổi 1 lỗi sản xuất\u003cbr /\u003e• Loa Bass và mạch 12 tháng; mic và ắc quy 6 tháng\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e️GIỜ LÀM VIỆC\u003cbr /\u003e️ Tất cả ngày từ 7h30 đến 21h (trừ lễ).\u003cbr /\u003e️ Follow shop để được áp mã giảm giá khách hàng thân thiết.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e️ CAM KẾT CỦA NAM HOÀNG AUDIO\u003cbr /\u003e• Sản phẩm chính hãng Nanomax \u003cbr /\u003e• Luôn test kỹ trước khi đóng gói và vận chuyển\u003cbr /\u003e• Tư vấn / Hướng dẫn suốt quá trình dùng\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e️ LƯU Ý NHẬN HÀNG \u003cbr /\u003e️ Các đơn hàng không hỗ trợ đồng kiểm, sau khi nhận hàng vui lòng quay video lúc mở để đối chiếu và xử lý một cách tốt nhất.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e#nanomax #loakaraoke #loakeo #loakeokeo #loakeobass50cm #loakeocongsuatlon #loakaraokedidong #loakeodidong\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/4b/6b/0d/0e2ed9d5b70c38844130a1b467c4e959.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/4b/6b/0d/0e2ed9d5b70c38844130a1b467c4e959.jpg","