","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":30000,"discount_rate":7,"rating_average":4,"review_count":3,"review_text":"(3)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/01/61/72/3c22eb9c120e87e99eaa6c27d5c48d95.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":603,"all_time_quantity_sold":16,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp class=\"irIKAp\"\u003eQuạt Tích Điện Đa Năng Để Bàn COMET CRF1406 Công Suất 6W 3 Cấp Độ Gió, Có Đèn LED, Pin Lithium Dung Lượng Cao\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eQuạt sạc tích điện Comet CRF1406 có thiết kế nhỏ gọn, đẹp mắt, có thể mang theo mọi lúc mọi nơi. Sản phẩm thích hợp cho nhiều đối tượng sử dụng khác nhau: nhân viên văn phòng, các bạn sinh viên,… Sử dụng đặt bàn ở mọi nơi bạn muốn sử dụng, rất tiện dụng. Có thể điều chỉnh hướng quạt và thân quạt có khả năng xoay 360 độ, giúp điều chỉnh hướng gió mọi góc độ.\u003c/p\u003e\n\u003cp class=\"irIKAp\" style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/9d/f9/21/1a05078b045b56222d9e28b83e85b372.jpg\" alt=\"\" width=\"750\" height=\"723\" /\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e* Quạt văn phòng Comet CRF1406 có cổng sạc bằng đầu USB tiện dụng, dễ dàng sạc lại cho quạt bằng cách:\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e1. Cắm trực tiếp cổng sạc USB vào PC, Laptop.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e2. Bạn có thể sạc pin cho quạt bằng Pin sạc dự phòng của điện thoại ngay khi đi du lịch\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e3. Hoặc sạc cho quạt trực tiếp bằng cốc sạc điện thoại để cắm sạc trực vào điện nguồn AC thông qua cốc sạc điện thoại\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e4. Hoặc cắm vào ổ cắm có tích hợp cổng USB\u003c/p\u003e\n\u003cp class=\"irIKAp\" style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/c5/57/2b/a476b03726e91cbc6244d7f665fe9c94.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e* Dung lượng pin bao gồm 2 pin rời có dung lượng cao lên đến 1200mAh. Dễ dàng mua pin thay thế sau thời gian dài sử dụng. Với 2 Pin lithium 1500mAh, quạt có thể đáp ứng nhu cầu liên tục ở mức thấp, 3.5 giờ ở mức trung bình và 1.5 giờ sử dụng ở tốc độ cao nhất. Ngoài ra Quạt còn có thể tự quay.\u003c/p\u003e\n\u003cp class=\"irIKAp\" style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/37/0e/d8/09042a02b6ea7b521d3ac3467ffda7dc.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e* Có 3 cấp độ gió\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eQuạt cắm điện mini để bàn Comet CRF1406 có 03 cấp độ gió giúp bạn chủ động được tốc độ gió khi cần sử dụng: nhẹ dịu hoặc gió mạnh. Sản phẩm được làm bằng chất liệu nhựa ABS cao cấp, có độ bền cao và sử dụng mô tơ không chổi than yên tĩnh, không nóng máy, đảm bảo an toàn cho người dùng.\u003c/p\u003e\n\u003cp class=\"irIKAp\" style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/3c/4d/b4/231c92e1afcda11b4d78eff134f3f1fe.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e*** Điểm Nổi Bật Quạt Tích Điện Để Bàn\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Có thể sử dụng như Quạt Điện mà không cần pin, hoặc lắp pin để sử dụng như Quạt sạc khi nhà mất điện\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Một sản phẩm tiện dụng, đa năng phù hợp sử dụng trong gia đình, nhà có trẻ nhỏ, hoặc sử dụng tại văn phòng làm việc để mang đến luồn gió mát và làm sang trọng không gian làm việc của bạn\u003c/p\u003e\n\u003cp class=\"irIKAp\" style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/58/2e/e3/20100b6df42e3da789bff0753942c490.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e*** Thông số kĩ thuật quạt sạc tích điện CRF1406:\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e– Model: CRF1406\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e– Công suất 6W\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e– Pin rời: 2 x 1200mAH\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e– Điện áp sạc 5V DC (cáp sạc MicroUSB tặng kèm)\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e– Kích thước lồng quạt: 6 inch\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e– Cấp độ gió: 3 tốc độ\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e– Thời gian sạc: 6-8h\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e– Thời gian quạt từ cao đến thấp: từ 1.5 – 8 giờ.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e– Cân nặng: 600g\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e– Kích thước: 149*240*79mm\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e– Có cổng sạc USB\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e*** HÌNH ẢNH THỰC TẾ KHI SỬ DỤNG:\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/af/82/5c/d027e4590291d9cc9483ceb7743f71fa.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/95/51/03/60ddc657a558d091b241ba66859e4237.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/30/77/bb/8c97dec42e148d9f70f74f72a6172a60.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left: