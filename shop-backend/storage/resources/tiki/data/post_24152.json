/li\u003e\n\u003cli\u003eĐối tác của Fortune Group, một hãng tư vấn về quỹ đầu tư có trụ sở tại London.\u003c/li\u003e\n\u003cli\u003eCó 22 năm kinh nghiệm là Giám đốc nghiên cứu cổ phiếu tương lai cho một số hãng hàng đầu phố Wall.\u003c/li\u003e\n\u003cli\u003eDiễn giả về các chủ đề phân tích chứng khoán như đặc điểm của các nhà giao dịch tài năng, danh mục quản lý quỹ đầu tư, phân tích kỹ thuật và đánh giá hệ thống giao dịch.\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/92/fb/d3/2aed8cb0d2282f31c73615762d5aabae.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/92/fb/d3/2aed8cb0d2282f31c73615762d5aabae.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/92/fb/d3/2aed8cb0d2282f31c73615762d5aabae.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/92/fb/d3/2aed8cb0d2282f31c73615762d5aabae.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/92/fb/d3/2aed8cb0d2282f31c73615762d5aabae.jpg"}],"warranty_policy":null,"authors":[{"id":203993,"name":"Phạm Quốc Trưởng","slug":"pham-quoc-truong"}],"current_seller":{"id":156095,"sku":"6583508051735","name":"HaAnBooks","link":"https://tiki.vn/cua-hang/haanbooks","logo":"7c/47/26/2f2dda4cc240e94355778dbfc2b8d405.jpg","price":168000,"product_id":"106273221","store_id":143850,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[{"id":26874,"name":"Phương Đông Books","link":"https://tiki.vn/cua-hang/phuong-dong-books","logo":"2e/85/b7/e76104ae5f1beaf244f319e2f0d2d413.jpg","price":199500,"product_id":"12337430","store_id":26242},{"id"