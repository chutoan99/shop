und_color":"#D93843","href":null,"text":"9.9"},{"placement":"pdp_badge","code":"is_hero","type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":true,"return_reason":"any_reason"}},"discount":57000,"discount_rate":19,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/4c/27/67/6a3677d63222902d80c1c0929260ef3d.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":271,"all_time_quantity_sold":7,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\n<p><strong>I. Thông tin lư đồng xông trầm hương Thiên Mộc Hương chất liệu đồng đúc nguyên khối cao cấp.</strong></p>\n<p><img style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/52/d7/10/d4e85b34f91f8d823b7fa3131aca9386.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p>Chất liệu đồng nguyên chất đúc tinh xảo, sắc nét.</p>\n\n<p>* Lư đồng lớn</p>\n<p>Kích thước: cao 6 cm, rộng 8 cm.</p>\n<p>* Lư đồng nhỏ</p>\n<p>Kích thước: cao 5.3 cm, rộng 7.4 cm</p>\n<p>So với lư xông trầm bằng gốm, sứ thì chất liệu bằng đồng được nhiều người ưa chuộng hơn bởi độ bền cao, tỏa hương tốt, dù đốt trầm nhiều cũng không ảnh hưởng đến chất lượng hay màu sắc.</p>\n<p><strong>II. Công dụng lư đồng xông trầm hương Thiên Mộc Hương.</strong></p>\n<p>Lư đồng xông trầm hương giúp xông trầm trở nên hiệu quả hơn, bạn có thể bỏ trực tiếp mảnh trầm, bột trầm…. vào lư xông, châm lửa. Lư đồng xông trầm hương sẽ giữ sức lửa cháy vừa phải không quá lớn cũng không quá nhỏ nhờ đó bạn vừa có thể tiết kiệm được một lượng trầm hương vừa thưởng thức được hương vị trọn vẹn của trầm.</p>\n\n<p><strong>III. Các sử dụng lư đồng xông trầm Thiên Mộc Hương chất liệu đồng đúc nguyên khối cao cấp.</strong></p>\n<p>Lư đồng xông trầm dùng để xông trầm hương các loại, nụ trầm hương khói ngược, nụ trầm, nhang vòng, nhang cây…</p>\n<p>Bước 1: Dùng bật lửa hoặc máy khò đốt 1 đầu trầm.</p>\n<p>Bước 2: Nhẹ nhàng đặt nhang khoanh hoặc nhang nụ vào bên trên miếng lót chống cháy ở trong lư. </p>\n<p>Bước 3: Chờ cho khói trầm lan tỏa và từ từ thưởng thức.</p>\n<p><img style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/75/f7/22/44af9d98d9f58135d42e228d621418f7.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p><strong>IV. Cách bảo quản lư đồng xông trầm Thiên Mộc Hương chất liệu đồng đúc nguyên khối cao cấp.</strong></p>\n<p>Việc bảo quản, lau chùi lư đồng đốt trầm cũng rất đơn giản, cho dù dùng thời gian dài lư vẫn sẽ giữ được độ sáng bóng. Lư sứ Xông Trầm bằng đồng đặc biệt rất dễ bảo quản. Việc lau chùi lư đồng đốt trầm cũng rất đơn giản, cho dù dùng thời gian dài lư vẫn sẽ giữ được độ sáng bóng.</p>\n\n<p><strong>- THIÊN MỘC HƯƠNG - </strong></p>\n<p><strong>Thương hiệu Trầm Hương Việt dành tặng Nguyên thủ Quốc Tế.</strong></p>\n<p>#ludong #luxongtram #luxongtramhuong #luxongtramdong #ludongxongtram #tramhuong #ludongđottram #xongtram #ludottram #ludottramhuong #nutramhuong #nhangtramhuong #dottram #dottramhuong #lutram #luhuongdottram</p>\n\n\n\n<p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/4c/27/67/6a3677d63222902d80c1c0929260ef3d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/4c/27/67/6a3677d63222902d80c1c0929260ef3d.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/4c/27/67/6a3677d63222902d80c1c0929260ef3d.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4c/27/67/6a3677d63222902d80c1c0929260ef3d.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4c/27/67/6a3677d63222902d80c1c0929260ef3d.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/c3/d2/0a/2fa4476f80dce9f854db1ef62711b689.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c3/d2/0a/2fa4476f80dce9f854db1ef62711b689.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c3/d2/0a/2fa4476f80dce9f854db1ef62711b689.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c3/d2/0a/2fa4476f80dce9f854db1ef62711b689.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c3/d2/0a/2fa4476f80dce9f854db1ef62711b689.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/a8/ca/70/427b3df1bfd1acfbd3036d3fa67af423.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a8/ca/70/427b3df1bfd1acfbd3036d3fa67af423.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a8/ca/70/427b3df1bfd1acfbd3036d3fa67af423.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/t