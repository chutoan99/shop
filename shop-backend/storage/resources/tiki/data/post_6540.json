ount":0,"discount_rate":0,"rating_average":5,"review_count":3,"review_text":"(3)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/a2/5b/e1/d25e01b6e930e4ad8a01c43f6c10d756.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1499,"all_time_quantity_sold":8,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eĐặc tính:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eKhẩu độ lớn F1.4: Khẩu độ lớn hơn F1.4, được thiết kế đặc biệt cho máy ảnh ILDC gắn trên Fuji X. Tiêu cự 23mm của ống kính này tương đương với định dạng 35mm, phù hợp với nhiều cảnh, như chân dung, phong cảnh, nội thất, kiến ​​trúc, ban đêm,\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eỐng kính nhân văn cổ điển: 11 yếu tố trong 10 nhóm, bao gồm 2 ống kính ED và 2 ống kính có chỉ số khúc xạ cao, có thể triệt tiêu hiệu quả sự khác biệt màu sắc. Độ sâu trường ảnh dưới khẩu độ lớn của F1.4 là rất nhỏ và xuất hiện một vệt mờ lớn từ gần tiêu điểm.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eThiết kế nhỏ gọn nhẹ: 260g Thiết kế ống kính nhẹ và nhỏ gọn và linh hoạt có thể đáp ứng các nhu cầu khác nhau của các nhiếp ảnh gia và người dùng video. Dễ dàng mang theo và vận hành.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eĐộng cơ bước: Động cơ bước được thông qua, giúp tự động lấy nét nhanh, chính xác và yên tĩnh trở thành sự thật.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eKhả năng chụp cận cảnh tuyệt vời: Ống kính được cung cấp khả năng chụp cận cảnh tuyệt vời, giúp chụp ảnh cận cảnh dễ dàng hơn.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eLấy nét thủ công lấy nét tự động: Xoay núm điều chỉnh khẩu độ ở dưới cùng của ống kính thành A và tự động điều chỉnh khẩu độ; Xoay vòng khẩu độ ở dưới cùng của ống kính trực tiếp bằng tay và điều chỉnh khẩu độ bằng tay.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eNâng cấp chương trình cơ sở USB: Dễ dàng nâng cấp chương trình cơ sở, phía dưới ống kính được trang bị giao diện micro USB, thuận tiện cho việc nâng cấp chương trình cơ sở trong tương lai và giúp hiệu suất của nó mạnh hơn.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThông số kỹ thuật:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eThương hiệu: Viltrox\u003c/p\u003e\n\u003cp\u003eModel: AF 23 / 1.4 XF\u003c/p\u003e\n\u003cp\u003eLoại gắn kết: X-mount\u003c/p\u003e\n\u003cp\u003eCác mẫu máy ảnh tương thích: Tương thích với máy ảnh ILDC Fujifilm X-mount (X-A1, X-A2, X-A3, X-A5, X-A7, X-A10, X-A20, X-E1, X-E2, X -E2S, X-E3, X-H1, X-M1, X-Pro1, X-Pro2, X-Pro3, X-T1, X-T2, X-T3, X-T10, X-T20, X-T30 , X-T100, X-T200)\u003c/p\u003e\n\u003cp\u003eCác thành phần thấu kính: 11 thành phần trong 10 nhóm\u003c/p\u003e\n\u003cp\u003eTiêu cự: f = 23mm\u003c/p\u003e\n\u003cp\u003eGóc nhìn: 63,4\u003c/p\u003e\n\u003cp\u003eTối đa Khẩu độ: F1.4\u003c/p\u003e\n\u003cp\u003eTối thiểu Khẩu độ: F16\u003c/p\u003e\n\u003cp\u003eKích thước bộ lọc: 52mm\u003c/p\u003e\n\u003cp\u003eLưỡi khẩu độ: 9\u003c/p\u003e\n\u003cp\u003eCơ chế tập trung: Tập trung nội bộ\u003c/p\u003e\n\u003cp\u003ePhạm vi lấy nét: 0,3m ~\u003c/p\u003e\n\u003cp\u003eĐộng cơ tập trung: Động cơ bước STM + vít chì\u003c/p\u003e\n\u003cp\u003eChế độ lấy nét: AF, MF\u003c/p\u003e\n\u003cp\u003eTối đa Độ phóng đại: 0,1\u003c/p\u003e\n\u003cp\u003eKích thước đường kính ngoài: φ65mm * 72mm\u003c/p\u003e\n\u003cp\u003eTrọng lượng sản phẩm: 260g / 9.2oz\u003c/p\u003e\n\u003cp\u003eKích thước gói: 11,5 * 9,4 * 9,3cm / 4,5 * 3,7 * 3,66 inch\u003c/p\u003e\n\u003cp\u003eTrọng lượng gói: 500g / 17,6oz\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eGói sản phẩm bao gồm:\u003c/stron