ef":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":32000,"discount_rate":20,"rating_average":4,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/0c/2d/37/ea3ec406f5b71307804bf8e0834035a2.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":852,"all_time_quantity_sold":8,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003e\u003cstrong\u003eGiới thiệu Đồ Chơi\u003c/strong\u003e\u003cstrong\u003e SU\u003c/strong\u003e\u003cstrong\u003eDOKU\u003c/strong\u003e\u003cstrong\u003e Kết Hợp Cờ CARO 2 Trong 1\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eVới niềm đam mê , tình yêu , nhiệt huyết với đồ chơi giáo dục cho bé .Shop luôn luôn nỗ lực không ngừng sáng tạo , đem đến cho khách hàng những sản phẩm mới và hay nhất,để bé có thể được trải nghiệm chơi những trò chơi tuổi thơ chúng ta đã từng trải qua ,tránh xa điện thoại ,ipad. Và chính chúng ta được quay về với tuổi thơ dữ dội, có được những phút giây hạnh phúc và vui vẻ bên gia đình. xin cho ra mắt bộ \u003cstrong\u003eĐồ Chơi 2 Trong 1\u003c/strong\u003e vô cùng tiện lợi - \u003cstrong\u003e\u003cem\u003eSUDOKU Kết Hợp Cờ CARO\u003c/em\u003e\u003c/strong\u003e giúp phát triển tư duy logic,sáng tạo ,phù hợp với mọi lứa tuổi.Hy vọng sẽ đem lại những trải nghiệm ,những giây phút giải trí bên gia đình và người thân.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/db/52/96/c540f315737052d3223f88d8a58dc05e.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/b8/df/e9/fc9bf6680f19069a619efe7d2178836d.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch3\u003eƯu đim SUDOKU Kết Hợp Cờ CARO\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eCó hướng dẫn chơi 100 bài đố sudoku kèm lời giải đáp án\u003c/li\u003e\n\u003cli\u003eBộ \u003cem\u003eSUDOKU Kết Hợp Cờ CARO\u003c/em\u003e được làm từ chất liệu gỗ tự nhiên an toàn cho người chơi.\u003c/li\u003e\n\u003cli\u003eSUDOKU và cờ CARO đều là những trò chơi trí tuệ với lối chơi tưởng chừng đơn giản nhưng nó lại ngốn thời gian, tâm sức, trí tuệ và cả sự kiên nhẫn của người chơi.\u003c/li\u003e\n\u003cli\u003eTên gọi tiếng Anh của Sudoku là Number Place. Đây là một trò chơi dạng câu đố, một vài con số sẽ được cho sẵn và nằm ở vị trí bất kỳ nào đó. Nhiệm vụ của người chơi là trên cơ sở logic theo tổ hợp sẽ sắp xếp điền các chữ số vào một lưới 9×9 sao cho ở mỗi hàng, mỗi cột cũng như mỗi phần trong số chín mắt lưới con 3×3 tạo thành lưới chính đều phải chứa tất cả các con số từ 1 đến 9.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/27/a2/ea/bf434c3f40c9b0794b21972507dbffd7.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eCác quân cờ và số được mải mịn, không góc cạnh , lớp sơn an toàn\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/00/e5/26/441e1c706c6174786453f177733204d1.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003ch3\u003eBộ đồ chơi SUDOKU Kết Hợp Cờ CARO của được thiết kế dựa trên tiêu chí 2 trong 1\u003c/h3\u003e\n\u003cp\u003eChỉ một bàn cờ nhưng có tận 2 trò có thể chơi, không hề nhàm chán.\u003c/p\u003e\n\u003cp\u003eCách chơi đơn giản, dễ hiểu, có thể tìm hiểu ở nhiều nơi\u003c/p\u003e\n\u003cp\u003eChơi \u003cstrong\u003eSUDOKU \u003c/strong\u003ehay \u003cstrong\u003ecờ CARO \u003c/strong\u003ecũng sẽ giúp bạn, gia đình và bạn bè sẽ có những phút giây bên nhau, gắn kết sau cả ngày học tập và làm việc mệt mỏi, đồng thời rèn luyện chiến thuật, tư duy logic.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/71/2c/52/9e1264889a61ffae4286ae29ced83ada.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eThông tin chi tiết: \u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003e- Bộ \u003cem\u003e\u003cstrong\u003eSUDOKU Kết Hợp Cờ CARO\u003c/strong\u003e\u003c/em\u003e làm từ gỗ tự nhiên, được mài nhẵn mịn, đảm bảo an toàn khi sử dụng\u003c/p\u003e\n\u003cp\u003e- Bộ đồ chơi có thể cất hay di chuyển đều tiện lợi\u003c/p\u003e\n\u003cp\u003e- Bên trong gồm có các con số và các quân cờ caro\u003c/p\u003e\n\u003cp\u003e- Phù hợp cho cả người lớn và trẻ nhỏ\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/0c/2d/37/ea3ec406f5b71307804bf8e0834035a2.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0c/2d/37/ea3ec406f5b71307804bf8e0834035a2.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/0c/2d/37/ea3ec406f5b71307804bf8e0834035a2.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0c/2d/37/ea3ec406f5b71307804bf8e0834035a2.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0c/2d/37/ea3ec406f5b71307804bf8e0834035a2.png"},{"base_url":"https://salt.tikicdn.com/ts/product/da/53/5a/ef526fea75fbb5801c4621fc4c07a33d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/da/53/5a/ef526fea75fbb5801c4621fc4c07a33d.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/da