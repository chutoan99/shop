_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.6,"review_count":9,"review_text":"(9)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/a3/ee/c2/f3ab90c449b6855435067ad5fe47510a.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":611,"all_time_quantity_sold":54,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e– Combo 3 sản phẩm gồm:XĐB\u003cbr /\u003e01- Lon xăng 125ml\u003cbr /\u003e• Xăng chuyên dụng bật lửa Zippo.\u003cbr /\u003e• Hàng chính phẩm được đặc chế cho bật lửa Zippo dùng xăng\u003cbr /\u003e• Đốt sạch khói không màu – Duy trì hiệu quả cháy – Bén lửa tốt\u003cbr /\u003e• Không chứa hóa chất axeton và có mùi thơm nhẹ đặc trưng. Xăng Zippo chính hãng ít hao xăng, bảo vệ tim (bấc) không bị đen, bông được lâu bền.\u003cbr /\u003e• Chứa trong lon có nắp an toàn\u003cbr /\u003e• Dung tích : 125ml\u003cbr /\u003e• Xuất xứ : Mỹ\u003cbr /\u003e• Có dán tem phản quang chống hàng giả (Xem thêm hình ảnh để phân biệt)\u003cbr /\u003e• Dùng phụ kiện chính hãng Zippo cho hiệu quả trữ xăng, đánh lửa và chống gió tốt nhất\u003cbr /\u003e02- vỉ đá lửa màu vàng 6 viên\u003cbr /\u003e• Đá lửa chuyên dụng bật lửa Zippo.\u003cbr /\u003e• Hàng chính phẩm được đặc chế cho bật lửa Zippo hiệu quả đánh lửa cao – Ít để lại bụi than\u003cbr /\u003e• Quy cách : Đựng trong vỉ chuyên dùng 6 viên đá lửa màu vàng\u003cbr /\u003e• Xuất xứ : Mỹ\u003cbr /\u003e• Dùng phụ kiện chính hãng Zippo cho hiệu quả trữ xăng, đánh lửa và chống gió tốt nhất\u003cbr /\u003e03- bấc Zippo tiêu chuẩn\u003cbr /\u003e• Bấc (tim) chuyên dụng bật lửa Zippo.\u003cbr /\u003eHàng chính phẩm được đặc chế cho bật lửa Zippo hiệu quả cháy cao chống gió tốt – Có dây đồng định hình giữ bấc thẳng\u003cbr /\u003eQuy cách : Đựng trong vỏ giấy ép vỉ chân không 01 bấc (100mm / 4 inches)\u003cbr /\u003eXuất xứ : Mỹ\u003cbr /\u003eDùng phụ kiện chính hãng Zippo cho hiệu quả trữ xăng, đánh lửa và chống gió tốt nhất.\u003c/p\u003e\n\u003cp\u003e ***ĐỊA CHI MUA HÀNG 108 TRẦN HƯNG ĐẠO F7 Q5 TP.HCM\u003c/p\u003e\n\u003cp\u003e***DIEN THOAI: KHONG CHIN KHONG, SAU SAU SAU, CHIN CHIN KHONG CHIN\u003c/p\u003e\n\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng)\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/48/1a/e0/b1d62b79938ded2943b7bac807b4cd4c.jpg\" alt=\"\" width=\"750\" height=\"705\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/f1/1e/c8/78164727258e8105cf8bd99f41a60748.jpg\" alt=\"\" width=\"750\" height=\"626\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/bd/5f/0c/84296411ed92ef6260cd57b0c3a083a7.jpg\" alt=\"\" width=\"750\" height=\"454\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/a3/ee/c2/0400ea509954c8d5ed068150e9707c04.jpg\" alt=\"\" width=\"750\" height=\"497\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/0f/09/2e/9d22bb480f0155b1b07b7344f22de826.jpg\" alt=\"\" width=\"750\" height=\"413\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/d7/3a/57/b43c23cda84727431a3dcb9a9597911c.jpg\" alt=\"\" width=\"750\" height=\"495\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title