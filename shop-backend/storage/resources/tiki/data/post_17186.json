ref":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/fb/88/4d/a99556a53d4c9f9fc8b5ea70a8d67e24.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":336,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eĐế Tản Nhiệt Đa Năng Siêu Nhỏ Gọn Cho Laptop/Mac-book Ba-se-us Slim Laptop Kickstand (2pcs)\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Sở hữu kích thước siêu nhỏ, siêu mỏng chỉ 5mm tiết kiệm không gian, bỏ ba lô cực kỳ tiện lợi so với những mẫu cồng kềnh ở ngoài thị trường hiện nay. Keo 3M nano siêu dính khi tháo ra dễ dàng không để lại dấu vết trên máy .\u003c/p\u003e\n\u003cp\u003e- Giá đỡ Slim đa năng cho laptop còn có thể điều chỉnh độ cao với 2 góc nhìn hoàn hảo 18mm \u0026amp; 28mm. Hỗ trợ công việc của bạn mọi lúc mọi nơi như một chuyên gia thực thụ.\u003c/p\u003e\n\u003cp\u003e- Được thiết kế theo trường phái công thái học, với độ nghiêng hoàn hảo 12º giữ tư thế ngồi chuẩn giúp bạn luôn thoải mái làm việc mà không phải cong lưng hay dí mắt sát màn hình. Kích thước của giá đỡ Slim cũng không chiếm quá nhiều không gian, giúp bạn dễ dàng bố trí giá đỡ trên bàn sao cho phù hợp với nhu cầu công việc.\u003c/p\u003e\n\u003cp\u003e- Giá đỡ Slim đa năng cho laptop có bộ đế hình tam giác đóng vai trò làm trụ cho chiếc giá đỡ, không bị sập, lung lay. Thiết kế tỉ mỉ và tinh xảo, kết hợp với chất liệu nhôm nguyên khối sẽ giúp cho bộ khung có độ chắc chắn tốt có thể chịu khối lượng lên đến 10kg, luôn giữ laptop của bạn thẳng đứng theo ý bạn muốn và yên tâm làm việc.\u003c/p\u003e\n\u003cp\u003e- Sản phẩm còn có công dụng giảm nhiệt giữ cho máy tính luôn mát mẻ giúp duy trì tuổi thọ cho thiết bị. Khả năng tương thích với nhiều thiết bị như : Laptop, Macbook với kích thước thiết bị từ 12-17.3 inch .\u003c/p\u003e\n\u003cp\u003e- Chiếc giá đỡ Slim được chế tác từ hợp kim nhôm nguyên khối sang trọng và có độ cứng tốt, đảm bảo bền bỉ theo năm tháng. Phần chân giá đỡ còn được lót thêm một lớp silicone giữ cho chiếc laptop luôn cố định và không bị trượt, giúp bạn yên tâm làm việc trên máy.\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/1e/59/24/f29d82b7b4bf113032eca22c3bf15166.jpg\" alt=\"\" width=\"750\" height=\"1236\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/82/c1/aa/c850154400413cc2fed6e3a4a1a56616.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/83/d0/db/fd487df7d3d0d6d64db3476c5ad23720.jpg\" alt=\"\" width=\"750\" height=\"1213\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/fc/14/4f/9688cf23e9dd2ca0045659a12a1d3781.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/10/ba/8d/61f597e196b10a773a1ec888928ea981.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"http