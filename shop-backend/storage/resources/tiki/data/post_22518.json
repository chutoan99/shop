r":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":1000,"discount_rate":9,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/fa/67/60/a5312db11c8c3813374bfffd4c6fe78b.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":161,"all_time_quantity_sold":9,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eXốp Chèn Cửa 95cm Chặn Đáy Khe Cửa, Cách Nhiệt, Cách Âm, Ngăn Côn Trùng, Thanh Chắn Khe Cửa \u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eCó thể cắt ngắn được. Sử dụng tiện lợi, tháo rút dễ dàng. Không ảnh hưởng tới nền. Bản thân nhà tôi cũng đang dùng,bền bỉ, dẻo dai\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/c4/18/1a/5db8c3a041310ea96d2993d78d6d4ef3.jpg\" alt=\"\" width=\"674\" height=\"675\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eCÔNG DỤNG:\u003c/p\u003e\n\u003cp\u003eNẹp cửa chắn gió lùa khe cửa, hạn chế thoát nhiệt vào mùa hè và giữ ấm phòng vào mùa đông. Sản phẩm cực kỳ hữu ích cho gia đình, tiết kiệm điện năng.\u003c/p\u003e\n\u003cp\u003eLắp cho cửa rộng 95cm, dày tối đa 6cm.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/dd/88/91/244f1dab8cd2f57dbe66158bed794afc.jpg\" alt=\"\" width=\"720\" height=\"720\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/54/48/da/658b3438b8aead27f52c02fc93081f4d.jpg\" alt=\"\" width=\"677\" height=\"678\" /\u003e\u003c/p\u003e\n\u003cp\u003e️ VỊ TRÍ LẮP ĐẶT:\u003c/p\u003e\n\u003cp\u003eNên nắp mỗi cửa phòng ngủ một cái nếu nhà có dùng điều hoà.\u003c/p\u003e\n\u003cp\u003eCó thể cắt đi để vừa cửa ngắn hơn. Còn cửa dài hơn có thể để hở 2 bên 1 chút cũng không sao.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/34/45/7d/b73ff4b932ca42f9e3ccad6234f8ef08.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e️ LÝ DO SỬ DỤNG:\u003c/p\u003e\n\u003cp\u003eNếu nhà bạn (nhất là nhà chung cư) hướng ban công đông bắc thì bạn hiểu thế nào là gió mùa đông bắc. Gió đông bắc lạnh lùa qua khe cửa làm giảm nhiệt độ phòng. Điều này khiến tốn tiền điện cho lò sưởi. Thậm chí có thể gây cảm lạnh ảnh hưởng tới sức khoẻ.\u003c/p\u003e\n\u003cp\u003eVào mùa hè thì ngược lại. Khi bạn bật điều hòa, không khí lạnh trong phòng sẽ thoát ra tại các khe cửa. Việc này gây tổn thất rất nhiều điện năng và tống tiền điện.\u003c/p\u003e\n\u003cp\u003eTheo Ủy ban năng lượng của USA thì thoát nhiệt qua khe cửa làm hao tổn 30% điện năng sử dụng. Hãy sử dụng nẹp cửa chắn gió như video để tiết kiệm điện năng và mang lại một cuộc sống dễ chịu thoải mái, đảm bảo sức khỏe cho bé.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/8f/1a/a4/9e93cd0956f7f5236efbd3946bcd3222.jpg\" alt=\"\" width=\"673\" height=\"676\" /\u003e\u003c/p\u003e\n\u003cp\u003eCHÍNH SÁCH ĐẶC BIỆT:\u003c/p\u003e\n\u003cp\u003e+ Chấp nhận đổi trả nếu hàng bị lỗi, kể cả do vận chuyển.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/40/80/87/0d2601ee58835ebac8b7b23e319a68c9.jpg\" alt=\"\" width=\"674\" height=\"675\" /\u003e\u003c/p\u003e\n\u003cp\u003e#xốp_chắn_cửa #xốp #chắn_cửa #chống_ồn #xốp_chống_ồn #ngăn_côn_trùng #xốp_chèn_cửa\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/fa/67/60/a5312db11c8c3813374bfffd4c6fe78b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/fa/67/60/a5312db11c8c3813374bfffd4c6fe78b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/fa/67/60/a5312db11c8c3813374bfffd4c6fe78b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fa/67/60/a5312db11c8c3813374bfffd4c6fe78b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fa/67/60/a5312db11c8c3813374bfffd4c6fe78b.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/3d/ac/98/30f2fa3c4d32d2f74ab27430a866e673.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/3d/ac/98/30f2fa3c4d32d2f74ab27430a866e673.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/3d/ac/98/30f2fa3c4d32d2f74ab27430a866e673.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3d/ac/98/30f2fa3c4d32d2f74ab27430a866e673.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3d/ac/98/30f2fa3c4d32d2f74ab27430a866e673.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/b8/9a/2e/b3b9bdccdfad17eb7c8c87f36cf5f42a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b8/9a/2e/b3b9bdccdfad17eb7c8