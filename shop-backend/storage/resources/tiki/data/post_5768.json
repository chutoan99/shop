3cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/media/catalog/product/m/a/mat_troi_be_con.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/m/a/mat_troi_be_con.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/m/a/mat_troi_be_con.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/m/a/mat_troi_be_con.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/m/a/mat_troi_be_con.jpg"}],"warranty_policy":null,"authors":[{"id":924,"name":"Eleanor H. Porter","slug":"eleanor-h-porter"}],"current_seller":{"id":126688,"sku":"8755144705225","name":"info book","link":"https://tiki.vn/cua-hang/info-book","logo":"66/49/ce/c528ff3a6e4022b080c1f8c6fe7bc541.jpg","price":61000,"product_id":"180598317","store_id":117060,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[{"id":97533,"name":"Nhà Sách Vĩnh Thụy","link":"https://tiki.vn/cua-hang/nha-sach-vinh-thuy","logo":"19/f2/bd/8bda12adffb15edf1b3d8339b0238283.jpg","price":61000,"product_id":"199962010","store_id":90454},{"id":326534,"name":"SÁCH ĐẠI NAM","link":"https://tiki.vn/cua-hang/sach-dai-nam","logo":"https://vcdn.tikicdn.com/ts/seller/4b/54/1a/f385a79a716cb3505f152e7af8c769aa.png","price":68000,"product_id":"253127384","store_id":314216},{"id":295057,"name":"HỆ THỐNG NHÀ SÁCH ABC","link":"https://tiki.vn/cua-hang/he-thong-nha-sach-abc","logo":"https://vcdn.tikicdn.com/ts/seller/98/3d/ff/cec0ba0eaa575634616ab4605fccbe6d.jpg","price":61000,"product_id":"274314090","store_id":282399}],"specifications":[{"name":"Thông tin chung","attri