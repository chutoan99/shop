or":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/85/8d/42/ca85d708a02e6b2ab4f5e136ca5e383c.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":788,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch1\u003eLoa kéo Bluetooth Karaoke PS-K8A Dalton công suất 250W, Bass 8 inches, tặng kèm 2 micro không dây sóng UHF\u003c/h1\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cdiv\u003e\n\u003cdiv\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/47/f3/c4/3c8a6603056f1c6aa73f1015ca7e560f.jpg_.webp\" alt=\"b1bd3fc3cf220bea4940659458b5a926.jpg_2200x2200q80.jpg_.webp\" /\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e•Công suất: 250W\u003c/p\u003e\n\u003cp\u003e•Loa bass: 8 inch\u003c/p\u003e\n\u003cp\u003e•Ng.uồn điện: 220V / 50Hz - 60Hz\u003c/p\u003e\n\u003cp\u003e•Bình acquy: có, bình acquy 12V tích hợp trong loa\u003c/p\u003e\n\u003cp\u003e•Remote: không\u003c/p\u003e\n\u003cp\u003e•Micro đi kèm: 2 micro không dây UHF\u003c/p\u003e\n\u003cp\u003e•Kết nối: Bluetooth, USB, SD card, AUX, đài FM\u003c/p\u003e\n\u003cp\u003e•Kích thước: (26,5x42x23)cm\u003c/p\u003e\n\u003cp\u003e•Trọng lượng: 12 kg\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cdiv\u003e\n\u003cdiv\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/7c/21/76/6bc188a22ed7dddef483cd21ff65dc3b.jpg_.webp\" alt=\"27ab5028279c8260044255d9034f6858.jpg_2200x2200q80.jpg_.webp\" /\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e THIẾT KẾ TINH TẾ, NHỎ GỌN\u003c/p\u003e\n\u003cp\u003e- Xu hướng mới cho dòng loa karaoke di động. Loa xách tay PS-K8A là một siêu phẩm mới nhất của Dalton trong năm 2022.\u003c/p\u003e\n\u003cp\u003e- PS-K8A dòng loa karaoke với thiết kế mới đến từ thương hiệu Dalton. Chiếc loa nhỏ gọn và dễ dàng di chuyển\u003c/p\u003e\n\u003cp\u003e CHẤT LIỆU GỖ CAO CẤP\u003c/p\u003e\n\u003cp\u003e- Chất liệu gỗ MDF luôn được Dalton lựa chọn để làm thân loa\u003c/p\u003e\n\u003cp\u003eThân loa được làm bằng chất liệu gỗ MDF sơn nhám. Âm thanh sẽ trở nên mạnh mẽ và uy lực hơn. Cảm quan chiếc loa rất chắc chắn, năng động và cá tính. Đặc biệt với chất liệu gỗ chống trầy xước giúp loa luôn giữ được vẻ ngoài hoàn hảo.\u003c/p\u003e\n\u003cp\u003e HỆ THỐNG ÂM THANH CHUYÊN NGHIỆP\u003c/p\u003e\n\u003cp\u003ePS-K8A sử dụng hệ thống loa 2 đường tiếng thường được sử dụng trong dàn âm thanh chuyên nghiệp.\u003c/p\u003e\n\u003cp\u003e- Giúp cho trải nghiệm âm nhạc trở nên sống động, thực tế và rõ ràng hơn. PS- K8A trang bị loa Bass, loa Treb mang lại âm trầm chắc và gọn, tiếng ca trong trẻo và lan tỏa.\u003c/p\u003e\n\u003cp\u003e- Loa sử dụng mạch công suất A-B giúp loa đạt công suất lên đến 250W, rất phù hợp cho các không gian 15 – 20m2.\u003c/p\u003e\n\u003cp\u003e TÍCH HỢP NHIỀU TÍNH NĂNG NỔI BẬT\u003c/p\u003e\n\u003cp\u003e- Ngoài sự tiện dụng, loa PS- K8A còn có nhiều tính năng nổi bật\u003c/p\u003e\n\u003cp\u003eMặt trên loa hỗ trợ quai xách chắc chắn.Các nút điều chỉnh loa trên một tấm nhôm phây xước rất tinh xảo không kém phần sang trọng.Màn hình LED màu đỏ thể hiện thông tin kết nối. Loa hỗ trợ đầy đủ các kết nối bao gồm: Kết nối Bluetooth 4.0, thẻ nhớ SD, USB, đài FM, jack cắm bông sen…\u003c/p\u003e\n\u003cp\u003e HỖ TRỢ MICRO CÓ DÂY\u003c/p\u003e\n\u003cp\u003e- Loa hỗ trợ thêm cổng mở rộng cho micro có dây, giúp loa linh hoạt hơn trong nhu cầu sử dụng.\u003c/p\u003e\n\u003cp\u003e- PS- K8A mang trong mình nguồn điện 12V có thể đáp ứng hoạt động ca hát liên tục trong 3-4h.\u003c/p\u003e\n\u003cp\u003e MICRO KHÔNG DÂY SÓNG UHF\u003c/p\u003e\n\u003cp\u003e- Loa PS-K8A cũng đi kèm với 2 micro không dây sóng UHF điều chỉnh được tần số, tránh trùng lặp tần số khi ở cùng với loa khác, màu sắc micro trùng với loa tạo sự sang trọng và chuyên nghiệp. Micro được làm bằng chất liệu kim loại, sơn tĩnh điện rất chắc chắn.Mặt sau loa in Logo và model sản phẩm, kèm theo cổng sạc và đầu vào mở rộng 6.5mm\u003c/p\u003e\n\u003cp\u003e NĂNG ĐỘNG VÀ TRẺ TRUNG\u003c/p\u003e\n\u003cp\u003e- Thiết kế nhỏ gọn, tổng trọng lượng loa chỉ 12 kg, với kích thước loa chỉ cao (26,5x42x23)cm.\u003c/p\u003e\n\u003cp\u003e- Dalton PS-K8A là sự lựa chọn hoàn hảo cho những chuyến đi chơi xa, du lịch dã ngoại cùng gia đình. Kích thước loa đặt gọn trong cốp xe ô tô hoặc có thể chở bằng xe máy vẫn rất thoải mái.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cdiv\u003e\n\u003cdiv\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/2c/11/09/bb880cf818917197c74b7a9d16e33bd9.jpg_.webp\" alt=\"2efb0f34d4b559714f3e63eaaf43a0fe.jpg_2200x2200q80.jpg_.webp\" /\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e- Sản phẩm loa kéo Dalton PS-K8A được bảo hành lên đến 12 tháng.\u003c/p\u003e\n\u003cp\u003e️ Hãy cùng trải nghiệm sản phẩm PS-K8A của Dalton tại các Hệ thống phân phối của Dalton trên toàn quốc.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cdiv\u003e\n\u003cdiv\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/f4/c4/c3/6e6d6a8184856c0c2940da8eb2ab5b1c.jpg_.webp\" alt=\"a0899d49b068e9dd6f6c1ada6309eb82.jpg_2200x2200q80.jpg_.webp\" /\u003e\u003c/