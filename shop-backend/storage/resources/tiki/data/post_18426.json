9971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.6,"review_count":15,"review_text":"(15)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/12/49/68/2b3f1eaf305ebe81206fffa1b141ed93.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1129,"all_time_quantity_sold":50,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2\u003e\u003cstrong\u003eBioThrive – Kích hoa lan nở sai, đậm màu, lâu tàn\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003e\u003cstrong\u003ePhân bón kích hoa lan BioThrive\u003c/strong\u003e nguồn gốc 100% hữu cơ, giàu Potassium Humate, Fulvic Acid, Ca và Bo thúc đẩy sự phát triển và phân hoá nụ hoa. Đồng thời, đẩy nhanh quá trình phân hóa mầm hoa, đẩy nụ giúp hoa nở sai hơn, lâu tàn, chuẩn form và đậm màu\u003c/p\u003e\n\u003cp\u003eNgoài ra, do hoa lan thường chỉ ra hoa 1-2 lần mỗi năm nên phân bón hoa lan BioThrive còn hỗ trợ phát triển kích thích bộ rễ, tăng sức đề kháng cho cây, hạn chế tình trạng mất sức. Có thể được xem là thần dược siêu kích hoa lan\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eCô đặc, hàm lượng dinh dưỡng x2\u003c/li\u003e\n\u003cli\u003eĐa năng: bón là và bón góc cho tất cả các loại cây cảnh\u003c/li\u003e\n\u003cli\u003e100% hữu cơ vi sinh, AN TOÀN\u003c/li\u003e\n\u003cli\u003eThương hiệu DOCNEEM được bảo hộ tại Cục sở hữu trí tuệ Việt Nam\u003c/li\u003e\n\u003cli\u003eKiểm định chất lượng bởi TỔNG CỤC TIÊU CHUẨN ĐO LƯỜNG CHẤT LƯỢNG\u003c/li\u003e\n\u003cli\u003eTích luỹ dinh dưỡng sau nở hoa\u003c/li\u003e\n\u003c/ul\u003e\n\u003cdiv\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/61/f6/51/deaf2aac5eb47f8d36eba0f891086090.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003c/div\u003e\n\u003ch2\u003e\u003cstrong\u003eThành phần\u003c/strong\u003e\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003ePotassium Humate (80%)\u003c/li\u003e\n\u003cli\u003eFulvic Acid (12%)\u003c/li\u003e\n\u003cli\u003eN (0.67%)\u003c/li\u003e\n\u003cli\u003eP2O5 (1.91%)\u003c/li\u003e\n\u003cli\u003eK2O (1.84%)\u003c/li\u003e\n\u003cli\u003eCa\u003c/li\u003e\n\u003cli\u003eBo\u003c/li\u003e\n\u003c/ul\u003e\n\u003cdiv\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/05/5d/c6/ddb9c3c9e1654f3847e52904c8747c64.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003c/div\u003e\n\u003ch2\u003e\u003cstrong\u003eCông dụng\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003eKích hoa lan BioThrive là sản phẩm phân bón dạng dung dịch, dễ hoà tan và giúp cây hấp thụ nhanh hơn các phân bón dạng hạt thông thường. Phân bón đạt hiệu quả từ khi bón phân kích hoa phi điệp đến lúc ra hoa tầm 2-3 tháng, là lựa chọn hoàn hảo để sở hữu một vườn lan nở rộ mà không gây mất sức\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eTăng tốc độ phân hoá nụ, hoa nở sai\u003c/li\u003e\n\u003cli\u003eLan nở chuẩn form, đậm màu và lâu tàn\u003c/li\u003e\n\u003cli\u003eTăng đề kháng, chống chọi sâu bệnh\u003c/li\u003e\n\u003cli\u003eỔn định dinh dưỡng, tránh mất sức sau nở hoa\u003c/li\u003e\n\u003cli\u003eDùng được cho các loại cây cảnh khác\u003c/li\u003e\n\u003c/ul\u003e\n\u003cdiv\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/4c/b2/31/cffacdde70dc5cba3a22656a7f1302e9.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003c/div\u003e\n\u003ch2\u003e\u003cstrong\u003eCách sử dụng\u003c/strong\u003e\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003eCây khoẻ: 7-10ml/1 lít nước. Bón lá hoặc bón gốc định kỳ 2 lần/tháng\u003c/li\u003e\n\u003cli\u003eCây yếu: 5ml/1 lít nước. Bón lá hoặc bón gốc định kỳ 2 lần/tháng\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch2\u003e\u003cstrong\u003eThông tin khác\u003c/strong\u003e\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003eHạn sử dụng: 36 tháng kể từ ngay sản xuất\u003c/li\u003e\n\u003cli\u003eDung tích: 500 ml\u003c/li\u003e\n\u003cli\u003eBảo quản nơi khô ráo, thoáng mát, vặn kín nắp chai sau khi sử dụng và tránh ánh nắng trực tiếp từ mặt trời\u003c/li\u003e\n\u003c/ul\u003e\n\u003cdiv\u003eKích hoa lan, kích hoa phi điệp, cách kích hoa phi điệp, cách kích hoa lan, lịch kích hoa lan tết, phân bón hoa lan, kích hoa lan phi điệp, phân bón cho hoa lan, kích hoa cho lan, kích hoa lan hồ điệp\u003c/div\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/6d/8e/19/f30b77b1782c5944f1a319eaa1fab54e.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/12/49/68/2b3f1eaf305ebe81206fffa1b141ed93.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/12/49/68/2b3f1eaf305ebe81206fffa1b141ed93.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/12/49/68/2b3f1eaf305ebe81206fffa1b141ed93.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/12/49/68/