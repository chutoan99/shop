":[{"placement":"pdp_badge","code":"text_badge","type":"text_badge","index":0,"icon":null,"icon_width":0,"icon_height":0,"text_color":"#FFF0F1","background_color":"#D93843","href":null,"text":"9.9"},{"placement":"pdp_badge","code":"is_hero","type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"freeship_xtra","type":"pdp_icon_badge","index":2,"icon":"https://salt.tikicdn.com/ts/upload/be/67/48/04a82ab8df178e1a13bde38316081865.png","icon_width":91,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":true,"return_reason":"any_reason"}},"discount":196000,"discount_rate":38,"rating_average":4.5,"review_count":1203,"review_text":"(1203)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/bd/92/59/fc492fc72ca3f4463504b6e3719f1fdb.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1524,"all_time_quantity_sold":4624,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/77/f0/93/51aa8eec597fc8c6632be879b4baaf52.jpg\" alt=\"\" width=\"750\" height=\"502\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eĐặc điểm nổi bật\u003c/strong\u003e\u003c/h3\u003e\n\u003cul style=\"text-align: justify;\"\u003e\n\u003cli\u003e\u003cstrong\u003eBộ Lau Nhà Xoay 360 Độ Sunhouse Ks-Cl350PO\u003c/strong\u003e được thiết kế tiện dụng với thùng vắt làm bằng nhựa nguyên sinh PP siêu bền với màu cam bắt mắt. Kích thước phù hợp giúp bạn thoải mái giặt, vắt mà không lo bị bắn nước ra bên ngoài.\u003c/li\u003e\n\u003cli\u003eNgoài ra, dưới thùng giặt có 4 bánh xe giúp cân bằng và dễ dàng di chuyển sản phẩm mà không cần tốn quá nhiều công sức để xách thùng nước lau nhà, thoải mái tận hưởng mà không lo đau lưng hay mỏi tay.\u003c/li\u003e\n\u003cli\u003eBên trong thùng giặt có 1 lồng vắt bằng inox chống han gỉ và giúp dễ dàng vắt khô nước của bông lau nhờ cơ chế vắt ly tâm và thiết kế lỗ thoát tiện dụng.\u003c/li\u003e\n\u003cli\u003eBộ lau nhà xoay 360 độ SUNHOUSE KS-CL350PO có cây lau được làm bằng inox với các mấu chốt bằng nhựa PP nguyên sinh giúp tăng độ bền của sản phẩm, chống ăn mòn và không bị han gỉ sau 1 thời gian sử dụng. Bên cạnh đó, cây lau còn có thể điều chỉnh được độ dài từ 950 đến 1200mm giúp làm sạch cả những góc khuất khó lau dọn như gầm giường, tủ hay cả những nơi cao, khó với tới.\u003c/li\u003e\n\u003cli\u003eTấm bông lau làm bằng sợi Microfiber thiết kế đan chéo lập thể siêu nhỏ giúp thấm hút nước tốt, vắt khô nhanh gấp nhiều lần so với các loại khăn lau thông thường, có tác dụng lau sạch bụi bẩn nhanh chóng nhất. Hệ thống vắt nước tích hợp gọn và tiện lợi, dễ dàng giặt và vắt khô bông lau. Đặc biệt, sợi Microfiber có ưu điểm là không bị xơ cứng nên không làm trầy xước bề mặt được lau. \u003c/li\u003e\n\u003cli\u003eBộ phận tạo chuyển động với thanh dẫn động xoắn bằng thép hợp kim và cơ cấu tạo chuyển động bằng nhựa POM chống mài mòn tốt cùng hệ thống giảm chấn động bằng cao su giúp tạo chuyển động 360 độ nhẹ nhàng, tăng độ bền sản phẩm (thao tác vắt 60,000 lần). Chỉ cần nhấn cây lau vào thùng giặt hoặc lồng vắt bạn sẽ dễ dàng giặt hoặc vắt khô bông lau.\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3 style=\"text-align: justify;\"\u003e\u003cstrong\u003eThông số kỹ thuật\u003c/strong\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli style=\"text-align: justify;\"\u003eKích thước lồng vắt: Ø200x90 mm\u003c/li\u003e\n\u003cli style=\"text-align: justify;\"\u003eCây lau: 3 đoạn inox, có thể điều chỉnh độ dài 950 -\u0026gt;1200 mm\u003c/li\u003e\n\u003cli style=\"text-align: justify;\"\u003eBông lau: Microfiber Kích thước bông: Ø380 mm. Độ dài sợi 40 /110 mm\u003c/li\u003e\n\u003cli style=\"text-align: justify;\"\u003eChốt giặt: Nhựa POM + PP + thép hợp kim. Kích thước định vị Ø27 mm\u003c/li\u003e\n\u003cli style=\"text-align: justify;\"\u003eĐầu chổi: Nhựa nguyên sinh PP + POM Ø164 mm. Kích thước định vị quay Ø27 mm\u003c/li\u003e\n\u003cli style=\"text-align: justify;\"\u003eQuai: 1 quai\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/bd/92/59/fc492fc72ca3f4463504b6e3719f1fdb.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/bd/92/59/fc492fc72ca3f4463504b6e3719f1fdb.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/bd/92/59/fc492fc72ca3f4463504b6e3719f1fdb.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/bd/92/59/fc492fc72ca3f4463504b6e3719f1fdb.jpg