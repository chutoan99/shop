t":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":78000,"discount_rate":15,"rating_average":5,"review_count":33,"review_text":"(33)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/2f/73/54/037df6dc5382114e44bfb88952c87e0b.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":726,"all_time_quantity_sold":101,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp class=\"_2jrvqA\"\u003ePhấn nước trang điểm Cushion Dewytree Hàn Quốc là sự kết hợp của nhiều sản phẩm kem chống nắng, kem nền, phấn và kem dưỡng da. Với kết cấu dạng lỏng, mềm mịn giúp bạn dễ dàng che đi các khuyết điểm trên khuôn mặt mà không cần phải trải qua nhiều bước.\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003eVới độ dưỡng cao, độ che phủ và che khuyết điểm hoàn hảo và có khả năng bám dính tối ưu. Nó tạo ra tone màu da tự nhiên với hiệu ứng sáng da tinh tế, ko gây cảm giác khô da, giữ cho làn da luôn căng mịn, đặc biệt ko lem ko trôi khi đổ mồ hôi.(Kết quả thử nghiệm thực tế, dùng phấn nước Dewytree xong vào phòng xông hơi 40 phút. Vẫn giữ dược lớp nền đến 96,5%)\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e\u003cstrong\u003ePHẤN NƯỚC CHE KHUYẾT ĐIỂM NÂNG TONE KIỀM DẦU CHỐNG NẮNG DƯỠNG DA CHO LỚP NỀN MỊN LÌ KHÔNG TRÔI DEWYTREE CUSHION 14G\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e\u003cstrong\u003e1. Thành phần Phấn nước Cushion che khuyết điểm kiềm dầu chống nắng Dewytree\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003eChiết xuất dừa, Pentylene Glycol, Tocopherol, Caprylyl Glycol, Nước cây bách, King Chiết xuất lá thông, tinh chất lá cây chè, nhựa cây bạch dương, Nước tinh khiết, titanium dioxide, cyclopentasiloxan, phenyl trimethicone, butylene glycol, butyl octyl salicylate, glycerin... Và nhiều thành phần khác.\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e\u003cstrong\u003e2. Đối tượng sử dụng Phấn nước Cushion che khuyết điểm kiềm dầu chống nắng Dewytree\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e+ Phù hợp mọi loại da:\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e+ Da dầu mụn, da nhạy cảm…\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e+ Dành cho ai đang tìm kiếm sản phẩm đa chức năng đa công dụng: Vừa trang điểm cho lớp nền mịn lì tự nhiên, lâu trôi. Lại vừa kiềm dầu, dưỡng da, chống nắng hoàn hảo với chỉ số SPF50 + PA ++++\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e\u003cstrong\u003e3. Hiệu quả sử dụng Phấn nước Cushion che khuyết điểm kiềm dầu chống nắng Dewytree\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e+ Có tác dụng vừa trang điểm vừa chống nắng, ngăn ngừa tia cực tím và bảo vệ da tối ưu nhất có thể.\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e+ Cushion phù hợp với những cô nàng thích đẹp nhưng lại ngại trang điểm nhiều bước.\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e+ Phấn nước làm sáng những vùng da sỉn, ko đều màu, kiềm dầu hiệu quả.\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e+ Giúp tiết kiệm thời gian cho các nàng do được tích hợp nhiều công dụng: kem lót – kem nền – phấn phủ – chống nắng.\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e+ Phấn nước trang điểm mang lại cho các nàng một lớp nền mỏng mịn bền màu, độ che phủ hoàn hảo, nâng tone tạo cảm giác tự nhiên.\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e\u003cstrong\u003eHƯỚNG DẪN SỬ DỤNG\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e\u003cstrong\u003e+ Nhẹ nhàng bóc lớp Nilon bảo vệ mặt gương.\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e+ Sau khi đã dưỡng đầy đủ, lấy 1 lượng vừa phải dậm đều trên bề mặt da. Nếu thường xuyên phải ra ngoài, ta có thể dậm lại trước khi đi.\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e+ Lưu ý: Sau khi sử dụng đóng kín nắp sản phẩm, bảo quản nơi thoáng mát và tránh tiếp xúc trực tiếp với ánh nắng mặt trời.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTHÔNG TIN THƯƠNG HIỆU:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Dewytree là thương hiệu chuyên cung cấp các sản phẩm chăm sóc da đến từ Hàn Quốc. Ưu điểm của dòng sản phẩn này là được chiết xuất từ các thành phần tự nhiên và phong phú, đa dạng về nhiều dòng dưỡng, làm sạch và mask.\u003c/p\u003e\n\u003cp\u003eVới chất lượng đảm bảo, giá cả hợp lý, Dewytree đã chiếm được lòng tin của khách hàng ở thị trường trong nước và quốc tế trở thành thương hiệu uy tín được nhiều người lựa chọn.\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e\u003cstrong\u003e+ Xuất xứ thương hiệu:\u003c/strong\u003e Hàn Quốc\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e\u003cstrong\u003e+ Nơi sản xuất:\u003c/strong\u003e Hàn Quốc\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e\u003cstrong\u003e+ Dung tích:\u003c/strong\u003e 14g\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e\u003cstrong\u003e+ NSX \u0026amp; HSD:\u003c/strong\u003e 03 năm trước hạn sử dụng - In trên vỏ sản phẩm.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCELLKEY-SCIEN OFFICIAL - STORE CHÍNH HÃNG\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Cam kết sản phẩm 100% là hàng chính hãng, có giấy tờ chứng nhận.\u003c/p\u003e\n\u003cp\u003e- Dịch vụ tư vấn chuyên nghiệp với đội ngũ tư vấn viên nhiệt tình sẵn sàng giải đáp mọi thắc mắc của khách hàng liên quan tới sản phẩm.\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e#dewytree #blackcherry #cellkeyscien #cellkey #phannuoc #trangdiem #kiemdau #duongda #chongnang #cushion #phannen #kemnen #chekhuyetdiem #phannuocchekhuyetdiem #phannuocnangtone #nangtone #phannuochanquoc #phannuocchongnang #phannuocduongda #phannuoctrangdiem #phannuockiemdau #phannuocdewytree #cushionchekhuyetdiem #cushionnangtone #cushionhanquoc #cushionchongnang #cushionduongda #cushiontrangdiem #cushionkiemdau #cushiondewytree #myphamchinhhang #myphamhanquoc #myphamnhapkhau #phantuoi #bbcream #nangtone #nangtong\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/2f/73/54/037df6dc5382114e44bfb88952c87e0b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/2f/73/54/037df6dc5382114e44bfb88952c87e0b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/2f/73/54/037df6dc5382114e44bfb88952c87e0b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2f/73/54/037df6dc5382114e44bfb88952c87e0b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2f/73/54/037df6dc5382114e44bfb88952c87e0b.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/f0/f0/e7/d2fe26cfc460454ce24eec91619dc17c.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f0/f0/e7/d2fe26cfc460454ce24eec91619dc17c.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f0/f0/e7/d2fe26cfc460454ce24eec91619dc17c.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/p