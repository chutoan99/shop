or":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.8,"review_count":134,"review_text":"(134)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/da/22/fc/9ac939c7a526b4b61ecdf6d7104aec09.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1587,"all_time_quantity_sold":433,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch1\u003e\u003cem\u003e\u003cstrong\u003eKệ di động Inochi hàng cao cấp\u003c/strong\u003e\u003c/em\u003e\u003c/h1\u003e\n\u003cp\u003e\u003cstrong\u003e=== CÂU CHUYỆN CỦA SẢN PHẨM === \u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003eSống tại Tokyo là trải nghiệm nghệ thuật tiết kiệm không gian. Trong những căn hộ bé xinh tại thủ đô đông đúc, người Nhật luôn tìm cách sắp xếp đồ đạc gọn gàng nhất, tiện lợi nhất nhưng vẫn thoáng đạt nhất có thể. Đó chính là cảm hứng cho bộ sưu tập kệ Tokyo của Inochi. \u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e=== NGUỒN GỐC CỦA SẢN PHẨM ===\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e Inochi là thương hiệu nhựa gia dụng cao cấp Việt Nam được thiết kế và sản xuất theo phong cách và tiêu chuẩn Nhật Bản. Các sản phẩm của Inochi được phát triển và sản xuất bởi Công ty CP Nhựa Tân Phú, đơn vị có hơn 40 năm kinh nghiệm trong ngành nhựa với 3 nhà máy hiện đại tại Việt Nam, quy trình đạt chuẩn ISO 9001 và quan hệ hợp tác chiến lược với các thương hiệu nhựa hàng đầu Nhật Bản. Ra mắt năm 2018, các mặt hàng gia dụng cao cấp của Inochi đã sớm gây được ấn tượng khách hàng, bởi sản phẩm sử dụng 100% nguyên liệu nhựa nguyên sinh an toàn, có chất lượng cao, tích hợp các tính năng vượt trội, kháng khuẩn, khử mùi và thiết kế đẹp mắt, tiện lợi, phục vụ tối đa các nhu cầu thiết yếu cùng tiện ích của mọi gia đình.\u003c/em\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/8e/ec/24/2150d3a7333c5b6ce98f8e662c99de10.png\" alt=\"\" width=\"750\" height=\"1338\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cstrong\u003e=== ƯU ĐIỂM CỦA SẢN PHẨM ===\u003c/strong\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e+ Nguyên liệu nhựa nguyên sinh cao cấp, an toàn cho sức khoẻ.\u003c/p\u003e\n\u003cp\u003e+ Đạt tiêu chuẩn khắt khe cho các sản phẩm gia dụng, thực phẩm, y tế của Nhật Bản.\u003c/p\u003e\n\u003cp\u003e+ Chất lượng cao, tích hợp các tính năng vượt trội, kháng khuẩn, khử mùi…\u003c/p\u003e\n\u003cp\u003e+ Kiểu dáng gọn nhẹ, Tận dụng không gian dọc (chồng tầng) tiết kiệm diện tích\u003c/p\u003e\n\u003cp\u003e+ Sử dụng đồ dùng đa năng, linh hoạt tuỳ biến trong nhiều không gian.\u003c/p\u003e\n\u003cp\u003e+ Kích thước: 480 x 210 x 1000 mm\u003c/p\u003e\n\u003cp\u003e+ Khối lượng: 1600 gr\u003c/p\u003e\n\u003cp\u003e+ Màu sắc: Trắng\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/b0/f3/e3/0e80d164dcf76503014006a73272145c.jpg\" alt=\"\" width=\"750\" height=\"1125\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cstrong\u003eNhựa nguyên sinh là gì? \u003c/strong\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003eNhựa nguyên sinh bao gồm một số loại nhựa như PP, PC, ABS, PS-GPPS, HIPS, POM, PA, PMMA… Đây đều là những loại nhựa nguyên chất, không pha tạp, không thêm phụ gia. Nhựa nguyên sinh có đặc tính là mềm dẻo, độ đàn hồi lớn, chịu được cong vênh và áp lực. Đặc biệt không có mùi, không độc hại và không ảnh hưởng đến sức khỏe của người sử dụng.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/83/0a/45/a7700e1b72d2300d8f85fabb0d7bb42e.jpg\" alt=\"\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eSản phẩm thiết kế theo phong cách Nhật Bản kiểu dáng đơn giản mà lại rất sang trọng, màu sắc nhã nhặn\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/8e/ec/24/a25bec569bd7ffecec989f4379fbbfa1.png\" alt=\"\" width=\"750\" height=\"1338\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/da/22/fc/9ac939c7a526b4b61ecdf6d7104aec09.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/da/22/fc/9ac939c7a526b4b61ecdf6d7104aec09.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/da/22/fc/9ac939c7a526b4b61ecdf6d7104aec09.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/da/22/fc/9ac939c7a526b4b61ecdf6d7104aec09.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/da/22/fc/9ac939c7a526b4b61ecdf6d7104aec09.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/ca/67/0c/f5f32ddf4b3189bff71d9a214c0f80ad.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ca/67/0c/f5f32ddf4b3189bff71d9a214c0f80ad.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ca/67/0c/f5f