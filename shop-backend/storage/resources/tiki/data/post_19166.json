03e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eĐỐI TƯỢNG SỬ DỤNG\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eDùng cho trẻ từ 0 - 6 tháng tuổi.\u003c/p\u003e\n\u003cdiv\u003e\n\u003cp\u003e\u003cstrong\u003eHƯỚNG DẪN SỬ DỤNG\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-family: arial, helvetica, sans-serif;\"\u003e+ Rửa sạch bình sữa và nắp trước khi sử dụng. \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e+ Làm nguội nước đun sôi đến 45ºC, sau đó đổ lượng nước chính xác vào bình đã tiệt trùng.\u003c/p\u003e\n\u003cp\u003e+ Thêm lượng sữa theo từng độ tuổi của trẻ, chỉ sử dụng muỗng kèm theo.\u003c/p\u003e\n\u003cp\u003e+ Đóng và lắc chai cho đến khi sữa hòa tan hoàn toàn\u003c/p\u003e\n\u003cp\u003e+ Kiểm tra nhiệt độ trên cổ tay trước khi cho con ăn.\u003c/p\u003e\n\u003c/div\u003e\n\u003cp\u003e\u003cstrong\u003eCách pha: \u003c/strong\u003e1 muỗng = 4,3g; Một muống bột pha với 30ml nước\u003c/p\u003e\n\u003ctable border=\"1\" cellspacing=\"1\" cellpadding=\"1\"\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd\u003e\n\u003ctable border=\"0\" cellspacing=\"0\" cellpadding=\"0\"\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd\u003e\n\u003cp\u003e\u003cstrong\u003eTuổi của trẻ sơ sinh\u003c/strong\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd colspan=\"2\"\u003e\n\u003cp\u003e\u003cstrong\u003eSố lượng mỗi bữa ăn\u003c/strong\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003cp\u003e\u003cstrong\u003eSố lần ăn mỗi ngày\u003c/strong\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003cp\u003e\u003cstrong\u003eNước ấm đã được \u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eđun sôi\u003c/strong\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003cp\u003e\u003cstrong\u003eSố muỗng đo\u003c/strong\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003c/td\u003e\n\u003c