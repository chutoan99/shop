xt_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":510000,"discount_rate":15,"rating_average":5,"review_count":15,"review_text":"(15)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/1e/e1/19/fbab73f9ac8f2ef487da1363de8ad90b.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2739,"all_time_quantity_sold":63,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3 style=\"text-align: justify;\"\u003e14 đường may cùng nhiều chức năng tự động thông minh\u003c/h3\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eMáy May Brother JA1400 \u003c/strong\u003ecó sẵn 14 mũi đường may cơ bản, may được loại chỉ thẳng đơn giản, mũi ziczac và nhiều mũi trang trí khác.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003eNgoài ra máy còn giúp đơm nút, làm khuy 4 bước, suốt chỉ tự động giúp bạn may được nhiều loại quần áo cho cả gia đình. Chức năng may kim đôi giúp và độ dài rộng của mũi chỉ có thể điều chỉnh được giúp bạn vừa linh hoạt trong việc may vá vừa có thể tạo ra những đường chỉ đa dạng dày mỏng khác nhau. Ngoài may quần áo máy còn có thể linh hoạt trong việc sữa chữa quần áo, may trang trí nhiều loại chăn, gối, màng, rèm cửa...\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Máy May Brother JA1400\" src=\"http://tikicdn.com/media/catalog/product/1/4/14-duong-may-u2751-d20160905.u3059.d20170313.t122433.635607.jpg\" alt=\"Máy May Brother JA1400\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003ch3 style=\"text-align: justify;\"\u003eChân vịt dễ dàng thay thế\u003c/h3\u003e\n\u003cp style=\"text-align: justify;\"\u003ePhần chân vịt dễ dàng tháo lắp, bạn có thể thay đổi \u003ca href=\"https://tiki.vn/phu-kien-may-may-theu-vat-so/c11530\" target=\"_blank\" rel=\"noopener\"\u003enhiều loại chân vịt khác nhau\u003c/a\u003e như chân vịt vắt sổ, chân vịt đính ren... tùy theo nhu cầu sử dụng. Việc thay đổi chân vịt dễ dàng giúp bạn có thể may, vắt sổ, hay đính ren, làm nút trên cùng một sản phẩm.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Máy May Brother JA1400\" src=\"http://tikicdn.com/media/catalog/product/c/h/chan%20vit.u2751.d20160905.t103351.689580.jpg\" alt=\"Máy May Brother JA1400\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003ch3 style=\"text-align: justify;\"\u003eMay được trên nhiều chất liệu vải\u003c/h3\u003e\n\u003cp style=\"text-align: justify;\"\u003eMáy có thể may trên nhiều loại vải, kể cả những loại vải cực dày hoặc những loại vải cực mỏng như lụa, voan,... Bạn hoàn toàn có thể tự tay chuẩn bị những món đồ từ vải như túi xách, bóp ví,... hay các kiểu quần áo đơn giản.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Máy May Brother JA1400\" src=\"http://tikicdn.com/media/catalog/product/m/a/may%20ten%20nhieu%20vat%20lieu.u2751.d20160905.t103352.261141.jpg\" alt=\"Máy May Brother JA1400\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003ch3 style=\"text-align: justify;\"\u003eĐèn Led tiện dụng\u003c/h3\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eMáy May Brother JA1400 \u003c/strong\u003etích hợp đèn Led có khả năng chiếu sáng một vùng may, bạn có thể sử dụng đèn trong điều kiện thiếu ánh sáng. Như vậy sẽ giúp bạn có những thao tác cực kỳ chính xác, cực kỳ nhanh và tạo ra những sản phẩm cực kỳ đẹp mắt.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Máy May Brother JA1400\" src=\"http://tikicdn.com/media/catalog/product/d/e/den%20led.u2751.d20160905.t103351.923781.jpg\" alt=\"Máy May Brother JA1400\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003ch3 style=\"text-align: justify;\"\u003eLàm khuy nút 4 bước\u003c/h3\u003e\n\u003cp style=\"text-align: justify;\"\u003eLàm khuy nút giờ đã không còn quá khó khăn nữa, bởi vì máy may Brother JA1400 giúp làm khuy nút, điều này không chỉ giúp khuy nút đẹp mà nó còn giúp rút tiết kiệm thời gian\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Máy May Brother JA1400\" src=\"http://tikicdn.com/media/catalog/product/k/h/khuy%204%20buoc.u2751.d20160905.t103352.189464.jpg\" alt=\"Máy May Brother JA1400\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003ch3 style=\"text-align: justify;\"\u003ePhụ kiện đi kèm đa dạng\u003c/h3\u003e\n\u003cp style=\"text-align: justify;\"\u003eMáy được kèm theo nhiều phụ kiện như chân vịt làm khuy, chân vịt vào dây kéo, chân vịt đa năng, bộ 4 suốt chỉ, bộ 3 kim may, bàn đạp, DVD hướng dẫn sẽ giúp tối đa cho bạn may quần áo được dễ dàng, nhanh chóng ngay cả khi mới học may.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/1e/e1/19/fbab73f9ac8f2ef487da1363de8ad90b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/1e/e1/19/fbab73f9ac8f2ef487da1363de8ad90b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/1e/e1/19/fbab73f9ac8f2ef487da1363de8ad90b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1e/e1/19/fbab73f9ac8f2ef487da1363de8