clear\"\u003e \u003c/div\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"product_view_tab_content_ad_more\"\u003e\n\u003cdiv class=\"product_view_tab_content_additional\"\u003e \u003c/div\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"std\"\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/82/e0/cc/8afb2da6d20b9d688e2917575985cbf9.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/82/e0/cc/8afb2da6d20b9d688e2917575985cbf9.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/82/e0/cc/8afb2da6d20b9d688e2917575985cbf9.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/82/e0/cc/8afb2da6d20b9d688e2917575985cbf9.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/82/e0/cc/8afb2da6d20b9d688e2917575985cbf9.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/b5/92/f4/ce241ce479bacd0072f922449826388c.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b5/92/f4/ce241ce479bacd0072f922449826388c.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b5/92/f4/ce241ce479bacd0072f922449826388c.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b5/92/f4/ce241ce479bacd0072f922449826388c.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b5/92/f4/ce241ce479bacd0072f922449826388c.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/ed/6a/29/36cfaf0e99034deb1b222835b8563f39.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.