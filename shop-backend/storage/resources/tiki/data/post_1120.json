6.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/05/ff/d3/c3bdeeff71997ff3ecf527194f387d62.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":91,"all_time_quantity_sold":3,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<h1><em><strong>Giới thiệu Ampe kềm đo điện AC kỹ thuật số TOTAL TMT46003</strong></em></h1>\n<p><strong>Ampe kềm đo điện AC kỹ thuật số TOTAL TMT46003</strong> là một thiết bị đo lường điện tử đa năng, được sử dụng trong nhiều ứng dụng điện tử và điện lạnh. Với công nghệ hiện đại mà sản phẩm mang đến sẽ giúp bạn đo lường dòng điện với độ chính xác cao, kèm theo màn hình LCD 6000 số đếm có kèm đèn nền, dùng tốt trong môi trường tối. Thiết bị được thiết kế nhỏ gọn, dễ dàng mang theo.</p>\n<p>Sản phẩm có kèm sẵn pin trong hộp nên bạn có thể sử dụng ngay khi cầm sản phẩm trên tay.</p>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/ed/46/cc/daec224026770c64838962aeef89655a.jpg?v=1718008712417\" alt=\"tmt46003-nd1.jpg?v=1718008712417\" /></p>\n<h2><strong>Thông tin sản phẩm</strong></h2>\n<ul>\n<li>Tên sản phẩm: <em><strong>Ampe kềm đo điện AC kỹ thuật số TOTAL TMT46003</strong></em></li>\n<li>Mã hàng: <em><strong>TO-TMT46003</strong></em></li>\n<li>Công dụng: Đo điện ampe</li>\n<li><em><strong>Thương hiệu: TOTAL</strong></em></li>\n<li><strong>Xuất xứ: Trung Quốc</strong></li>\n</ul>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/79/e6/16/6f795fb27813d80a4ba8d8c2cfdabc18.jpg?v=1718008721127\" alt=\"tmt46003-nd2.jpg?v=1718008721127\" /></p>\n<h2><strong>Thông số kỹ thuật</strong></h2>\n<ul>\n<li>Màn hình LCD 6000 số đếm</li>\n<li>Dòng AC: 6A/60A/600A/±(2.5% +8)</li>\n<li>Điện áp AC : 1.0~600V±(0.8% +5)</li>\n<li>Điện áp DC ::0~600V±(0.5% +3)</li>\n<li>Điện trở: 0~6kΩ±(0.8% +3) </li>\n<li>Với chức năng chỉ báo pin thấp và lưu trữ dữ liệu, đèn flash</li>\n</ul>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/f0/38/38/dbc53df904037a4a42c05cd152f0909b.jpg?v=1718008728576\" alt=\"tmt46003-nd3.jpg?v=1718008728576\" /></p>\n<h2><strong>Thông tin nổi bật</strong></h2>\n<ul>\n<li>\n<p><strong>Đo lường đa chức năng:</strong> Total TMT46003 có khả năng đo lường dòng điện AC, điện áp AC, điện trở và tần số. Điều này giúp người dùng có được thông tin chi tiết về các thông số điện cần thiết để kiểm tra và phân tích hệ thống điện.</p>\n</li>\n<li>\n<p><strong>Kềm đo chính xác: </strong>Thiết bị được trang bị kềm đo ampe chính xác và nhạy, cho phép người dùng đo dòng điện một cách chính xác và thuận tiện. kềm đo cung cấp khả năng đo dòng điện không cần phải cắt mạch, giúp tiết kiệm thời gian và đảm bảo an toàn cho người dùng.</p>\n</li>\n<li>\n<p><strong>Màn hình hiển thị dễ đọc: </strong>Total TMT46003 có một màn hình LCD lớn với đèn nền, cho phép người dùng dễ dàng đọc các thông số đo được ngay cả trong điều kiện ánh sáng yếu. Màn hình cung cấp thông tin chi tiết và rõ ràng, giúp người dùng dễ dàng theo dõi và đánh giá các dữ liệu đo.</p>\n</li>\n<li>\n<p><strong>Chức năng giữ dữ liệu (Data Hold):</strong> Thiết bị có tính năng giữ dữ liệu (Data Hold), cho phép người dùng lưu trữ và ghi nhớ các giá trị đo lường quan trọng. Điều này giúp người dùng thuận tiện trong việc ghi lại và so sánh các dữ liệu đo theo thời gian.</p>\n</li>\n<li>\n<p><strong>Thiết kế tiện dụng và bền bỉ: </strong>Total TMT46003 có thiết kế nhỏ gọn và cầm tay tiện lợi, giúp người dùng dễ dàng mang theo và sử dụng trong các công việc đo lường điện. Ngoài ra, thiết bị cũng được làm từ vật liệu chất lượng cao và có độ bền cao, đảm bảo sự đáng tin cậy và tuổi thọ lâu dài.</p>\n</li>\n</ul>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/d7/20/29/62025ed41b6d2daadacc0813e36691b7.jpg?v=1718008737276\" alt=\"tmt46003-nd4.jpg?v=1718008737276\" /></p>\n<h2><strong>Hướng dẫn sử dụng</strong></h2>\n<ul>\n<li>Vui lòng đọc kỹ hướng dẫn sử dụng kèm theo sản phẩm</li>\n</ul><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/05/ff/d3/c3bdeeff71997ff3ecf527194f387d62.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/05/ff/d3/c3bdeeff71997ff3ecf527194f387d62.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/05/ff/d3/c3bdeeff71997ff3ecf527194f387d62.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/05/ff/d3/c3bdeeff71997ff3ecf527194f387d62.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/05/ff/d3/c3bdeeff71997ff3ecf527194f387d62.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/d5/47/d0/5c47fd6ec8cf0b989a96509592204e6f.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d5/47/d0/5c47fd6ec8cf0b989a96509592204e6f.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d5/47/d0/5c47fd6ec8cf0b989a965095922