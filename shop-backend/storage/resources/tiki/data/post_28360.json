,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/fa/97/27/e35616daafd72bba713c9470c5e53b39.jpeg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":20,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eThành phần: Cà phê Arabica, Robusta, Bơ, Muối,\u003c/p\u003e\n\u003cp\u003eKhối lượng: 500gr\u003c/p\u003e\n\u003cp\u003eVới kinh nghiệm gần 40 năm hoạt động trong lĩnh vực chế biến cà phê, cà phê Huy Tùng được chế biến với công thức bí truyền, mang lại hương vị độc đáo, đậm đà và tự hào là sản phẩm đặc trưng của vùng đất Phú Yên. Sự kết hợp chọn lọc hoàn hảo giữa hai loại cà phê nổi tiếng của Cao nguyên Buôn Ma Thuột - Arabica và Robusta cùng những hương liệu cao cấp, Huy Tùng cho ra sản phẩm cà phê Hương Chồn truyền thống gợi nhớ đến sản phẩm cà phê Chồn Kopi Luwak danh tiếng.\u003c/p\u003e\n\u003cp\u003eNhững hạt cà phê thơm ngon tới tay người tiêu dùng đều phải qua một quá trình chọn lựa nguyên liệu và chế biến kĩ càng. Hạt cà phê sau khi chọn lọc, phân loại sẽ được đưa vào lò rang trong khoảng 55 phút, với nhiệt độ khoảng 228 độ C. Sau đó cà phê được làm nguội rồi trộn tẩm bơ, nguyên liệu, cho vào bao ủ thùng trong 3 ngày. Sau đó, cà phê hạt được chuyển sang công đoạn xay và đóng bao thành phẩm. Mặc dù đầu tư công nghệ hiện đại nhưng công ty vẫn giữ một phần công đoạn làm tay truyền thống như rang kết hợp giữa điện và than củi để giữ được nhiệt độ đều, duy trì độ nóng phù hợp. Bên cạnh đó, trong quá trình rang, người rang cà phê bằng kinh nghiệm lâu năm có thể kiểm tra được độ chín của hạt cà phê để đảm bảo hạt cà phê đạt đúng độ chín cần thiết. Nhờ vậy, sản phẩm cà phê Huy Tùng luôn giữ được nét riêng, hương vị đậm đà. Khi uống cà phê có mùi đặc trưng, một chút vị khói, hương thơm đậm đà, thoang thoảng vị socola và một chút đắng dễ chịu.\u003c/p\u003e\n\u003cp\u003eCách pha cà phê:\u003c/p\u003e\n\u003cp\u003e- Cho vào phin 4 muỗng cà phê bột\u003c/p\u003e\n\u003cp\u003e- Lắc đều và ép nhẹ nắp gài bên trong\u003c/p\u003e\n\u003cp\u003e- Dùng 10ml nước tinh khiết độ 96 - 100 độ C châm vào phin, chờ cà phê ngấm đều khoảng 1 phút. Sau đó châm 60ml nước sôi vào phin\u003c/p\u003e\n\u003cp\u003e- Thêm đường, sữa, đá tùy khẩu vị\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/fa/97/27/e35616daafd72bba713c9470c5e53b39.jpeg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/fa/97/27/e35616daafd72bba713c9470c5e53b39.jpeg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/fa/97/27/e35616daafd72bba713c9470c5e53b39.jpeg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fa/97/27/e35616daafd72bba713c9470c5e53b39.jpeg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fa/97/27/e35616daafd72bba713c9470c5e53b39.jpeg"},{"base_url":"https://salt.tikicdn.com/ts/product/58/f3/21/a800d973869b582d1b502c5b72364c8c.jpeg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/58/f3/21/a800d973869b582d1b502c5b72364c8c.jpeg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/