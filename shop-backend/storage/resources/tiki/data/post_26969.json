/center\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/87/87/5c/2e68079e31b4626ca743af3ea963600b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/87/87/5c/2e68079e31b4626ca743af3ea963600b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/87/87/5c/2e68079e31b4626ca743af3ea963600b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/87/87/5c/2e68079e31b4626ca743af3ea963600b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/87/87/5c/2e68079e31b4626ca743af3ea963600b.jpg"}],"warranty_policy":null,"current_seller":{"id":211810,"sku":"2158351870135","name":"Sách Thành Vinh","link":"https://tiki.vn/cua-hang/sach-thanh-vinh","logo":"https://vcdn.tikicdn.com/ts/seller/dc/68/8b/156446ccfdde32fb7c0ab68e8ccbc898.jpg","price":145000,"product_id":"275504254","store_id":198842,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Thông tin chung","attributes":[{"code":"publisher_vn","name":"Công ty phát hành","value":"CN NXB Văn Học"},{"code":"publication_date","name":"Ngày xuất bản","value":"2016-07-22 06:29:59"},{"code":"number_of_page","name":"Số trang","value":"220"},{"code":"manufacturer","name":"Nhà xuất bản","value":"Nhà Xuất Bản Văn Học"}]}],"product_links":[],"gift_item_title":"0 quà tặng kèm","services_and_promotions":[],"promitions":[],"stock_item":{"max_sale_qty":1000,"min_sale_qty":1,"preorder_date":null,"qty":1000},"quantity_sold":{"text":"Đã bán 1","value":1},"categories":{"id":67995,"name":"Tác Phẩm Kinh