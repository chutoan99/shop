g_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/b2/1b/d3/9b7b07a2f6af609c8309029d045a8835.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1053,"all_time_quantity_sold":9,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p><strong>Máy nhắc chữ Teleprompter TC7 Lensgo</strong> là một thiết bị lý tưởng thay thế cho những sản phẩm máy nhắc chữ cồng kềnh, giá thành cao trên thị trường. Với thiết kế nhỏ gọn, đơn giản và dễ sử dụng, khả năng tương thích với nhiều thiết bị như điện thoại, máy ảnh. <strong>Teleporompter TC7</strong> sẽ phù hợp với những nhà làm phim cá nhân, vlogger quay phim di động. Phần khung được thiết kế đẹp mắt với sự kết hợp linh hoạt giữa chất liệu nhựa ABS chắc chắn và thép không gỉ ở một vài chi tiết nhỏ. Kính quang phổ chuyên dụng với bề mặt được tráng nano chống xước giúp chữ hiển thị một cách rõ ràng nhất mà không ảnh hưởng tới chất lượng video.</p>\n<div class=\"lwptoc lwptoc-right lwptoc-autoWidth lwptoc-baseItems lwptoc-light lwptoc-notInherit\" data-smooth-scroll=\"1\" data-smooth-scroll-offset=\"24\" data-lwptoc-initialized=\"1\">\n<div class=\"lwptoc_i\">\n<div class=\"lwptoc_header\"> </div>\n</div>\n</div>\n<p style=\"text-align: center;\"><img class=\"size-full wp-image-15351 aligncenter litespeed-loaded\" src=\"https://salt.tikicdn.com/ts/product/b2/1b/d3/fdce4da75fa6dd4a1c854d9a6e7b9e3b.jpg\" sizes=\"(max-width: 690px) 100vw, 690px\" srcset=\"https://salt.tikicdn.com/ts/product/b2/1b/d3/fdce4da75fa6dd4a1c854d9a6e7b9e3b.jpg 690w, https://salt.tikicdn.com/ts/product/f4/d1/e8/da96b09e8abca62d5a097ed2200bf87e.jpg 300w, https://salt.tikicdn.com/ts/product/26/8d/79/cb06b890d6b61d22c8a3ba7596dd3daa.jpg 400w, https://salt.tikicdn.com/ts/product/d7/be/70/44ffb811320bb46266b8aefd58fe3c7b.jpg 100w, https://salt.tikicdn.com/ts/product/78/02/68/91de2ebffecd6bcd9a206cf777d1bedc.jpg 64w\" alt=\"Máy nhắc chữ Teleprompter TC7 Lensgo\" width=\"690\" height=\"690\" data-lazyloaded=\"1\" data-src=\"https://salt.tikicdn.com/ts/product/b2/1b/d3/fdce4da75fa6dd4a1c854d9a6e7b9e3b.jpg\" data-srcset=\"https://salt.tikicdn.com/ts/product/b2/1b/d3/fdce4da75fa6dd4a1c854d9a6e7b9e3b.jpg 690w, https://salt.tikicdn.com/ts/product/f4/d1/e8/da96b09e8abca62d5a097ed2200bf87e.jpg 300w, https://salt.tikicdn.com/ts/product/26/8d/79/cb06b890d6b61d22c8a3ba7596dd3daa.jpg 400w, https://salt.tikicdn.com/ts/product/d7/be/70/44ffb811320bb46266b8aefd58fe3c7b.jpg 100w, https://salt.tikicdn.com/ts/product/78/02/68/91de2ebffecd6bcd9a206cf777d1bedc.jpg 64w\" data-sizes=\"(max-width: 690px) 100vw, 690px\" data-was-processed=\"true\" /></p>\n<p> </p>\n<h2><span id=\"THONG_SO_MAY_DOC_CHU_LENSGO_TC7\">THÔNG SỐ MÁY ĐỌC CHỮ LENSGO TC7</span></h2>\n<ul>\n<li>Hãng sản xuất: <strong>Lensgo</strong></li>\n<li>Model: <strong>TC7</strong></li>\n</ul>\n<h2><span id=\"Tinh_nang_co_ban\">Tính Năng Cơ Bản</span></h2>\n<ol>\n<li>xếp gọn trong 1 Giây. Dễ dàng gấp gọn và di động mang theo.</li>\n<li>Hỗ trợ máy ảnh, điện thoại di động, máy tính bảng và nhiều thiết bị đa năng.</li>\n<li>Bộ sản phẩm bao gồm Nhiều-Thông số kỹ thuật camera Bộ chuyển đổi ống kính vòng, phù hợp với nhiều ống kính.</li>\n<li>1/4 lỗ vít cho mở rộng thiết bị, có thể kết nối với nhiều của chân máy, đèn đứng, v. v.</li>\n<li>Chuyên về văn bản ỨNG DỤNG, kích hoạt để phóng to thu nhỏ hoặc zoom trong lời nói. Và cũng có thể thay đổi màu sắc của nền và font chữ, tạm dừng, tăng tốc độ hoặc giảm tốc độ, chuyển trang.</li>\n<li>Điều khiển Từ Xa Bluetooth, bạn có thể tự do tạm dừng, tốc độ lên hoặc xuống, và biến trang một cách dễ dàng.</li>\n<li>Khả năng tương thích rộng, teleprompter có thể phù hợp với tất cả các dòng điện thoại thông minh hoặc máy tính bảng và Máy Ảnh.</li>\n<li>Nó là tương thích với 17mm của ống kính góc rộng</li>\n<li>Ứng dụng tương thích với iOS &amp; Android hệ thống, tuyệt vời cho trực tuyến giảng dạy, Vlogging, trực tuyến, cuộc phỏng vấn v. v.</li>\n</ol>\n<h3><span id=\"Bo_san_pham_TC7_bao_gom\">Bộ sản phẩm TC7 bao gồm</span></h3>\n<ul>\n<li>Teleprompter * 1</li>\n<li>Kẹp điện thoại * 1</li>\n<li>Adapter Ring * 9 (49 52 55 58 62 67 77 82mm)</li>\n<li>Điện thoại di động bóng vòng * 2</li>\n<li>Xoắn Vít * 2</li>\n<li>Điều khiển Từ Xa Bluetooth * 1</li>\n</ul>\n<h3><span id=\"Cach_su_dung_phan_mem_may_doc_chu\"><strong>Cách sử dụng phần mềm máy đọc chữ</strong></span></h3>\n<ol>\n<li>Quét hoặc mã để tải tương ứng điện thoại di động khiến ứng dụng phần mềm</li>\n<li>khi sử dụng thích lật Mirroring chức năng, bạn cần phải đăng nhập số Di Động: 13000686868. Đăng ký mã sản phẩm: 686868</li>\n</ol>\n<p>(Android người dùng) xin quét QA mã với chức năng scan trong trình duyệt của bạn, tải về và cài đặt nó trong một cách bình thường.<br />Bạn cũng có thể tìm kiếm trong Kho ỨNG DỤNG  Ouda ticiqi)<br />(Apple người dùng): Tìm Kiếm (Ouda ticiqi) tại Cửa Hàng ỨNG DỤNG<br />Phần mềm sử dụng phông lật Mirroring chức năng, và cần đăng nhập số Di Động: 13000686868 mã đăng ký: 686868 Bạn có thể sử dụng sau khi đăng nhập thành công</p>\n<h3><span id=\"Cac_buoc_lap_dat_TC7_voi_dien_thoai\">Các bước lắp đặt TC7 với điện thoại</span></h3>\n<ol>\n<li>Gắn vào một ống kính vòng với EVA và phù hợp điện thoại di động ống kính EVA được đưa vào teleprompter khe cắm thẻ. Kết xuất của điện thoại nắp che ống kính lắp đặt</li>\n<li>Vung mở bề mặt của giá đỡ điện thoại để hướng thể hiện trong fugure</li>\n<li>Đặt kẹp điện thoại trên trượt thanh và vặn một tay vít trên lưng.</li>\n<li>Đặt kẹp điện thoại trên teleprompter theo hướng trong hình Xoắn một tay vít trên và bên trái và bên phải để cố định.</li>\n<li>Kẹp điện thoại giá đỡ điện thoại và se khít hai hạt</li>\n<li>Bật điện thoại camera, bật chế độ quay phim và điều chỉnh tiêu cự.</li>\n<li>Cho điện thoại của bạn trên teleprompter Bảng điều khiển</li>\n<li>Khóa kẹp điện thoại đến đáy teleprompter theo hướng thể hiện trong hình</li>\n<li>Điều chỉnh tâm của điện thoại ống kính đến một vị trí thích hợp và se khít các ốc vít</li>\n<li>Bật điện thoại camera, bật chế độ quay phim và điều chỉnh tiêu cự</li>\n<li>Đặt điện thoại trên teleprompter bảng điều khiển.</li>\n</ol>\n<h3><span id=\"Cach_ket_noi_TC7_voi_may_anh\">Cách kết nối TC7 với máy ảnh</span></h3>\n<ol>\n<li>khóa phù hợp Adapter Ring cho ống kính</li>\n<li>trượt ống kính máy ảnh vòng từ đáy teleprompter vào khe cắm thẻ.</li>\n<li>sau khi điều chỉnh ống kính máy ảnh, đặt điện thoại vào đáy teleprompter.</li>\n</ol>\n<p style=\"text-align: center;\"><img class=\"size-medium wp-image-15352 aligncenter litespeed-loaded\" src=\"https://salt.tikicdn.com/ts/product/00/74/f5/d69a58b964b523a1a77c405d2607f0db.jpg\" sizes=\"(max-width: 690px) 100vw, 690px\" srcset=\"https://salt.tikicdn.com/ts/product/00/74/f5/d69a58b964b523a1a77c405d2607f0db.jpg 690w, https://salt.tikicdn.com/ts/product/ab/d7/cf/253b30823162b1deb3275d8c9ccfce95.jpg 400w, https://salt.tikicdn.com/ts/product/e4/b9/ce/359a257f1c21bdd0b94a15d789fd2c68.jpg 64w\" alt=\"Máy nhắc chữ Teleprompter TC7 chính hãng Lensgo\" width=\"690\" height=\"585\" data-lazyloaded=\"1\" data-src=\"https://salt.tikicdn.com/ts/product/00/74/f5/d69a58b964b523a1a77c405d2607f0db.jpg\" data-srcset=\"https://salt.tikicdn.com/ts/product/00/74/f5/d69a58b964b523a1a77c405d2607f0db.jpg 690w, https://salt.tikicdn.com/ts/product/ab/d7/cf/253b30823162b1deb3275d8c9ccfce95.jpg 400w, https://salt.tikicdn.com/ts/product/e4/b9/ce/359a257f1c21bdd0b94a15d789fd2c68.jpg 64w\" data-sizes=\"(max-width: 690px) 100vw, 690px\" data-was-processed=\"true\" /><img class=\"size-medium wp-image-15353 aligncenter litespeed-loaded\" src=\"https://salt.tikicdn.com/ts/product/cd/e6/b5/d582447794e51543a97b40962094dfa6.jpg\" sizes=\"(max-width: 690px) 100vw, 690px\" srcs