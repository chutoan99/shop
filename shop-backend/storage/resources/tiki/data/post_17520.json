th":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":1900,"discount_rate":5,"rating_average":4,"review_count":4,"review_text":"(4)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/a0/bc/46/28c1c291a030a80885aa187846454b74.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":826,"all_time_quantity_sold":49,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eKhung Hỗ Trợ Tập Lưng, Nắn Chỉnh Cột Sống, Khung Định Hình Cột Sống, Hỗ Trợ Điều Trị Thoát Vị Đĩa Đệm, Đau Lưng, Vai Gáy - Chính Hãng Amalife\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThông tin Sản phẩm\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eChất liệu:\u003c/strong\u003e Nhựa cao cấp siêu bền, Đệm mút tốt\u003cbr /\u003e\u003cstrong\u003eThiết kế 2 mảnh:\u003c/strong\u003e 1 miếng nhựa cố định làm đế và 1 miếng nhựa uốn cong tiếp xúc với lưng\u003cbr /\u003e\u003cstrong\u003ePhần đế:\u003c/strong\u003e Có nhiều nấc để tăng giảm chiều cao theo nhu cầu người sử dụng Miếng nhựa tiếp xúc với phần lưng có thêm các hạt massage nhỏ Dụng cụ hỗ trợ tập lưng với tất cả mọi người trên 15 tuổi Làm giảm thoái hóa đốt sống lưng.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ca/14/00/06d9203c56eb81ce59f028d288fda18c.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/f4/cf/41/e17daf1a6373b1116ab0f3b01da1bbd9.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eLỢI ÍCH SẢN PHẨM\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eCác cơn đau lưng dai dẳng xuất phát từ việc phần cột sống bị tổn thương do bị lệch, cong, giữ nguyên tư thế trong một thời gian dài.\u003cbr /\u003eTình trạng này ngày càng phổ biến do thói quen ngồi máy tính gù lưng, tập luyện nặng vượt quá sức chịu đựng của phần cột sống hoặc việc phải giữ vị trí, đứng quá lâu.\u003cbr /\u003eDụng cụ tập lưng giảm thoái hóa đốt sống sẽ giúp bạn Massage phần lưng, hạn chế khỏi các cơn đau thường gặp Thư giãn cơ lưng, giảm nguy cơ thoái hóa đốt sống Cải thiện tư thế và tạo độ linh hoạt cho phần lưng Phù hợp sử dụng với mọi lứa tuổi. Nên sử dụng 2 lần/ ngày.\u003cbr /\u003eMỗi lần kéo dài từ 5-10 phút Dụng cụ tập lưng giảm thoái hóa đốt sống\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cstrong\u003eHướng dẫn sử dụng:\u003c/strong\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003eLắp ráp dụng cụ tập lưng theo các nấc độ cao như ý muốn Đặt lưng nằm trên sản phẩm Chú ý người duỗi thẳng, đặt vị trí lưng khớp trên sản phẩm.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/9a/7b/df/73c5a8ab03927125edf70917d987296f.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/33/f0/ee/658ec37bab9a25f6ad5291592a8ecf58.png\" alt=\"\" width=\"750\" height=\"506\" /\u003e\u003c/p\u003e\n\u003cp\u003eKhung nắn có độ cong lý tưởng cho người dùng một cách tự nhiên.\u003c/p\u003e\n\u003cp\u003eKhung nắn có thể chạm tới tối đa các huyệt đạo có trên lưng, đả thông huyệt, tăng cường tuần hoàn máu, làm bệnh mau thuyên giảm.\u003c/p\u003e\n\u003cp\u003eHỗ trợ định hình cột sống về dạng tự nhiên ban đầu mà không cần phải tác động ngoại lực.\u003c/p\u003e\n\u003cp\u003eHỗ trợ giảm đau một cách tự nhiên tại nhà.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/42/3d/03/00c5eefdea7aa2a1844fa4d9369e09f1.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/15/40/a8/abccb37fdb3376fd2e181aba38035c94.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/a0/bc/46/28c1c291a030a80885aa187846454b74.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a0/bc/46/28c1c291a030a80885aa187846454b74.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a0/bc/46/28c1c291a030a80885aa187846454b74.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a0/bc/46/28c1c291a030a80885aa187846454b74.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a0/bc/46/28c1c291a030a80885aa187846454b74.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/3e/96/84/47dd05d29211a41b0c3a48e2581d62de.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/3e/96/84/47dd05d29211a41b0c3a48e2581d62de.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/3e/96/84/47dd05d29211a41b0c3a48e2581d62de.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3e/96/84/47dd05d29211a41b0c3a48e2581d62de.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3e/96/84/47dd05d29211a41b0c3a48e2581d62de.png"},{"base_url":"https://salt.tikicdn.com/ts/p