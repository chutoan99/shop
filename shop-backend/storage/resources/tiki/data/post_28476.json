ail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/e8/66/9e/b1af8ae2c7bff8d69ef40c05e99e8378.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1260,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eKhổng Tử Tinh Hoa\u003c/strong\u003e\u003cbr /\u003e\u003cbr /\u003eKhổng Tử và học thuyết Nho gia có ảnh hưởng rất lớn đối với các nền văn hóa Á Đông, trong đó có Việt Nam. Bao nhiêu thế hệ trí thức Việt Nam đã tiếp thu và ứng dụng triết lý của ông. Còn ngày nay, sự minh triết trong tư tưởng Khổng Tử có thể giúp gì cho chúng ta khi đối diện với vô số vấn đề của cuộc sống hiện đại?\u003cbr /\u003e\u003cbr /\u003eVu Đan, với niềm say mê và am hiểu về Khổng Tử cộng với tầm nhìn của một nhà nghiên cứu thông thái, đã làm cho mọi người sững sờ khi vén mở những bí mật ẩn chứa trong tư tưởng Khổng Tử. Đó là những bí mật có thể giúp ta đứng vững trong thực tại, hiểu được thế giới sôi động mà chúng ta đang sống, giúp ta tận hưởng một cuộc đời phong phú và trọn vẹn.\u003cbr /\u003e\u003cbr /\u003eGiản dị, trực tiếp và hứng khởi, bà gạt bỏ cách tiếp cận sùng kính của các học giả khác và cho thấy những chân lý mà Khổng Tử giới thiệu với chúng ta luôn là những chân lý dễ nắm bắt nhất, chỉ cho chúng ta một cách sống hạnh phúc theo đúng nhu cầu tinh thần của mình.\u003cbr /\u003e\u003cbr /\u003eNhững gì chúng ta có thể học hỏi từ Khổng Tử hôm nay không phải là môn “Khổng học” do Hán Vũ Đế lập ra; không phải là “Khổng giáo” long trọng, cao quý, nặng nghi thức bên cạnh Đạo giáo và Phật giáo; cũng chẳng phải học thuyết Khổng Tử của các học giả, đầy luận chứng sâu xa và mang tính bác học khuôn phép mà là những bài học, những chân lý giản dị mà mỗi người tâm đắc và đều có thể tiếp nhận.\u003cbr /\u003e\u003cbr /\u003eNhững chân lý đó đi vào lòng người tự nhiên nhất như chính là tiếng gọi từ bên trong tâm tưởng của mỗi chúng ta. Dù thời gian trôi qua và thế giới có đổi thay thế nào đi nữa thì những giá trị tinh túy nhất của Khổng Tử luôn mãi sống với thời gian.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/e8/66/9e/b1af8ae2c7bff8d69ef40c05e99e8378.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e8/66/9e/b1af8ae2c7bff8d69ef40c05e99e8378.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e8/66/9e/b1af8ae2c7bff8d69ef40c05e99e8378.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e8/66/9e/b1af8ae2c7bff8d69ef40c05e99e8378.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e8/66/9e/b1af8ae2c7bff8d69ef40c05e99e8378.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/0d/c6/dd/bc317fbe0dcea06f5fa8af7e5f439e19.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0d/c6/dd/bc317fbe0dcea06f5fa8af7e5f439e19.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/0d/c6/dd/bc317fbe0dcea06f5fa8af7e5f439e19.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0d/c6/dd/bc317fbe0dcea06f5fa8af7e5f439e19.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0d/c6/dd/bc317fbe0dcea06f5fa8af7e5f439e19.jpg"}],"warranty_policy":null,"authors":[{"id":14288,"name":"Yu Dan","slug":"yu-dan"}],"current_seller":{"id":273880,"sku":"7542246031625","name":"Happy Books HCM","link":"https://