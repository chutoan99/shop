d_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/05/14/ce/6228947fe62b207e14416a1b19a88be5.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":835,"all_time_quantity_sold":9,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eTai nghe W820NB là tai nghe bluetooth Over-Ear mới nhất của hãng EDIFIER có chứng nhận HI-RES (Âm thanh độ phân giải cao) của hiệp hội âm thanh Nhật Bản JAS phê duyệt. Kết nối dây cáp usb typeB - typeC từ máy tính sang tai nghe sẽ cho chất lượng âm thanh cao nhất. Ngoài ra, tai nghe hỗ trợ Audio Coding AAC tương thích cao với iPhone hay iPad. Tai nghe W820NB hỗ trợ driver dynamic 40mm, kích thước tương đối lớn, tạo ra âm thanh sống động, giàu chi tiết.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eTHÔNG SỐ KỸ THUẬT:\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eThương hiệu: Edifier\u003c/li\u003e\u003cli\u003eXuất xứ thương hiệu: Canada\u003c/li\u003e\u003cli\u003eNhập khẩu \u0026amp; Phân phối: DALITO VIỆT NAM\u003c/li\u003e\u003cli\u003eMã sản phẩm: Tai nghe Edifier W820NB\u003c/li\u003e\u003cli\u003eModel: W820NB\u003c/li\u003e\u003cli\u003eKiểu tai nghe: Headphone over-ear\u003c/li\u003e\u003cli\u003eDriver: 40mm dynamic\u003c/li\u003e\u003cli\u003eBluetooth: V5.0\u003c/li\u003e\u003cli\u003eAudio coding: AAC,SBC\u003c/li\u003e\u003cli\u003eThời lượng pin: 29h(ANC ON) – 49h(ANC OFF)\u003c/li\u003e\u003cli\u003eCổng sạc USB-C (Type-C) \u003c/li\u003e\u003cli\u003eGame mode, Xuyên âm\u003c/li\u003e\u003cli\u003eTần số: 20HZ-40KHZ\u003c/li\u003e\u003cli\u003eỨng dụng: Edifier Connect\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eƯU ĐIỂM SẢN PHẨM:\u003c/p\u003e\n\u003cp\u003e- Tai nghe W820NB có công nghệ ANC lai giúp giảm tiếng ồn lên đến -38dB. Điều này giúp nâng cao trải nghiệm nghe nhạc của bạn đồng thời loại bỏ tiếng ồn không mong muốn. Khoang tai thiết kế kín, bao bọc bởi lớp đệm tai rất êm, đã nâng cao khả năng chống ồn bị động. Về tổng thế, không gian âm nhạc của W820NB đầy chất riêng tư.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e- Tai nghe W820NB được trang bị thời lượng pin rất tốt. Chế độ ANC hỗ trợ 29 giờ, còn ở chế độ thường có thể nghe nhạc liên tục 49 giờ.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e- Tai nghe W820NB được trang bị công nghệ chống ồn cuộc gọi DNN (Deep Neural Network), dạng học máy, giúp cho những cuộc trò chuyện tự nhiên, mượt mà và trọn vẹn.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e- Bạn có thể cá nhân hóa tai nghe Bluetooth W820NB bằng ứng dụng Edifier Connect để thay đổi chế độ, kiểm tra tình trạng pin và xem hướng dẫn sử dụng.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e- Chuyển sang chế độ môi trường xung quanh và luôn cảm nhận môi trường xung quanh khi nghe nhạc của bạn. Nghe thông báo của sân bay hoặc các thông báo quan trọng mà không cần tháo tai nghe.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e- Trong chế độ game mode, độ trễ thấp tới 80ms và có sự đồng bộ hóa hoàn hảo giữa âm thanh và hình ảnh. Điều này đảm bảo trải nghiệm chơi game hoàn hảo sẽ khiến người chơi muốn nhiều hơn nữa.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eHƯỚNG DẪN SỬ DỤNG\u003c/p\u003e\n\u003cp\u003e1 : Mở nắp và ấn giữ 3s nút nguồn trên tai nghe đến khi đèn blue green nhấp nháy liên tục.\u003c/p\u003e\n\u003cp\u003e2 : Bật bluetooth và dò trên thiết bị, tai nghe sẽ thông báo kết nối.\u003c/p\u003e\n\u003cp\u003e3 : Thao tác điều khiển\u003c/p\u003e\n\u003cp\u003e- Nút \u0026#43;/- : Tăng/giảm âm lượng\u003c/p\u003e\n\u003cp\u003e- Nút -  : Giảm âm lượng\u003c/p\u003e\n\u003cp\u003e- Nút nguồn ON/OFF : Ấn và giữ 3s\u003c/p\u003e\n\u003cp\u003e- Nhận cuộc gọi: Chạm 2 lần bên tai trái hoặc phải.\u003c/p\u003e\n\u003cp\u003e- Stop/ play: Ấn 1 lần nút nguồn.\u003c/p\u003e\n\u003cp\u003e- Trợ lí ảo : Ấn 2 lần nút nguồn.\u003c/p\u003e\n\u003cp\u003e- Giảm tiếng ồn: Chạm 2 lần vào tai trái.\u003c/p\u003e\n\u003cp\u003e- Next track: Ấn và giữ nút \u0026#43;\u003c/p\u003e\n\u003cp\u003e- Previous track : Ấn và giữ nút -\u003c/p\u003e\n\u003cp\u003e- Bật/ tắt chế độ chơi game: Ấn nút chức năng 2 lần\u003c/p\u003e\n\u003cp\u003e- Chuyển hiệu ứng âm thanh: Ấn nút chức năng 1 lần.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eBỘ SẢN PHẨM GỒM:\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eTai nghe headphone W820NB x1\u003c/li\u003e\u003cli\u003eDây sạc typeC x1       \u003c/li\u003e\u003cli\u003eSách hướng dẫn sử dụng x1 \u003c/li\u003e\u003c/ul\u003e\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eCHÍNH SÁCH BẢO HÀNH:\u003c/p\u003e\n\u003cp\u003e12 tháng\u003c/p\u003e\n\u003cp\u003eĐổi mới trong 30 ngày lỗi nhà sản xuất\u003c/p\u003e\n\u003cp\u003eBảo hành điện tử theo serial number \u003c/p\u003e\n\u003cp\u003e(Vui lòng giữ đủ vỏ hộp, phụ kiện tai nghe)\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e---\u003c/p\u003e\n\u003cp\u003eEDIFIER MEDIA là nhà phân phối chính thức của EDIFIER tại thị trường Việt Nam. Các sản phẩm chúng tôi kinh doanh là hàng xuất khẩu cho thị trường quốc tế và được bảo hành theo đúng chính sách bảo hành của EDIFIER.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/05/14/ce/6228947fe62b207e14416a1b19a88be5.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/05/14/ce/6228947fe62b207e14416a1b19a88be5.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/05/14/ce/6228947fe62b207e14416a1b19a88be5.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/05/14/ce/6228947fe62b207e14416a1b19a88be5.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/05/14/ce/6228947fe62b207e14416a1b19a88be5.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/2d/8d/f3/da8614d8e16838de9f6965ee805e098a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/2d/8d/f3/da8614d8e16838de9f6965ee805e098a.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/2d/8d/f3/da8614d8e16838de9f6965ee805e098a.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2d/8d/f3/da8614d8e16838de9f6965ee805e098a.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2d/8d/f3/da8614d8e16838de9f6965ee805e098a.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/42/2e/ff/a1f2eda01dd3c03b53319387049389db.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/42/2e/ff/a1f2eda01dd3c03b53319387049389db.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/42/2e/ff/a1f2eda01dd3c03b53319387049389db.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/42/2e/ff/a1f2eda01dd3c03b53319387049389db.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/42/2e/ff/a1f2eda01dd3c03b53319387049389db.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/58/09/df/dd7a522e0d04dd6644255122a1d3a67f.jpg","is_gallery":true,"label":null,"large_url":"https