71483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":19500,"discount_rate":15,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ca/a0/3f/c4d60980746803956338d79e7cdd8baa.JPG","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1857,"all_time_quantity_sold":3,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cul style=\"box-sizing: border-box; margin-top: 0px; margin-bottom: 10px; color: #333333; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e\n\u003cli style=\"box-sizing: border-box;\"\u003e\u003cspan style=\"box-sizing: border-box;\"\u003eThức Ăn Cho Chó Nhỏ Trưởng Thành Nutrience Original - Thịt Gà, Rau Củ Và Trái Cây Tự Nhiên \u003c/span\u003elà một công thức dinh dưỡng toàn diện và cân bằng được Nutriencce nghiên cứu và phát triển cho các giống chó kích thước nhỏ đã trưởng thành (trên 12 tháng)\u003c/li\u003e\n\u003cli style=\"box-sizing: border-box;\"\u003eNguyên liệu đầu tiên trong công thức dinh dưỡng của chúng tôi luôn luôn là thịt gà chất lượng cao giúp chú chó nhỏ đáng yêu của bạn duy trì cơ bắp dẻo dai.\u003c/li\u003e\n\u003cli style=\"box-sizing: border-box;\"\u003eChúng tôi không bao giờ sử dụng những nguyên liệu kém chất lượng như meat-by-product (phụ phẩm từ thịt) hay đạm thực vật để tăng hàm lượng đạm trong các sản phẩm của mình.\u003c/li\u003e\n\u003cli style=\"box-sizing: border-box;\"\u003eChúng tôi sử dụng nhiều nguồn nguyên liệu tự nhiên có chứa chất chống oxy hóa cho các công thức dinh dưỡng (quả việt quất, nam việt quất và cà rốt cùng với vitamin C và vitamin E) để chúng hoạt động cùng nhau hỗ trợ phát triển hệ miễn dịch của chú chó cưng của bạn.\u003c/li\u003e\n\u003cli style=\"box-sizing: border-box;\"\u003eSức khỏe tiêu hóa có liên kết trực tiếp đến sức khỏe tổng thể của thú cưng của bạn.\u003c/li\u003e\n\u003cli style=\"box-sizing: border-box;\"\u003eCông thức của chúng tôi bao gồm một sự kết hợp của ngũ cốc nguyên hạt, chất xơ tự nhiên và prebiotics để giúp chó cưng của bạn duy trì một đường ruột khỏe mạnh.\u003c/li\u003e\n\u003cli style=\"box-sizing: border-box;\"\u003eDa và lông của một chú chó sẽ phản ánh tổng thể sức khỏe của chúng.\u003c/li\u003e\n\u003cli style=\"box-sizing: border-box;\"\u003eNguồn cung cấp axit béo tự nhiên Omega 3 và Omega 6, bao gồm dầu cá hồi và hạt lanh, sẽ giúp chú chó cưng của bạn duy trì da lông một cách khỏe mạnh và sáng bóng.\u003c/li\u003e\n\u003cli style=\"box-sizing: border-box;\"\u003eNhững giống chó nhỏ cũng cần phải được bảo vệ xương khớp và sự linh động của chúng.\u003c/li\u003e\n\u003cli style=\"box-sizing: border-box;\"\u003eChúng tôi luôn đảm bảo lượng Glucosamin và Chondroitin cần thiết trong công thức dinh dưỡng của chúng tôi để hỗ trợ xương khớp và sự linh động cho chú chó cưng của bạn.\u003c/li\u003e\n\u003cli style=\"box-sizing: border-box;\"\u003eCác giống chó nhỏ thường rất kén chọn thức ăn. Đó là lý do chúng tôi tạo nên hạt thức ăn có kích thước nhỏ hơn, vừa miệng và đảm bảo hương vị thịt gà tươi tự nhiên sẽ làm cho chú chó cưng của bạn sẽ yêu thích .\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e\u003cspan style=\"box-sizing: border-box;\"\u003eThành phần\u003c/span\u003e\u003c/p\u003e\n\u003cul style=\"box-sizing: border-box; margin-top: 0px; margin-bottom: 10px; color: #333333; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e\n\u003cli style=\"box-sizing: border-box;\"\u003eBột thịt gà, gạo lứt, đậu xanh, bột yến mạch, mỡ gà (được bảo quản bằng hỗn hợp tocopherols – nhóm chất quan trọng có trong Vitamin E), bột củ cải khô, hương vị gà tự nhiên, hạt lanh, canxi cacbonat, men bia, dầu cá hồi (nguồn DHA), quả việt quất, quả nam việt quất, cà rốt, Vitamin [bổ sung vitamin E, axit ascorbic (vitamin C), bổ sung vitamin A, niacin, calcium pantothenate, inositol, riboflavin, pyridoxine hydrochloride, thiamine mononitrate, biotin, bổ sung vitamin B12, bổ sung vitamin D3, folic acid], khoáng chất [kẽm oxide, kẽm proteinate, sắt proteinate, sắt sulfate, đồng proteinate, đồng sulfate, manganese proteinate, manganese oxide, calcium iodate, sodium selenite], kali clorua, DL-methionine, L-lysine, chiết xuất từ rễ rau diếp xoăn, choline clorua, chiết xuất nấm men, muối, glucosamine hydrochloride, chondroitin sulfate.\u003c/li\u003e\n\u003cli style=\"box-sizing: border-box;\"\u003eKhông phải là thành phần cần thiết trong hồ sơ dinh dưỡng thức ăn cho chó của AAFCO\u003c/li\u003e\n\u003cli style=\"box-sizing: border-box;\"\u003eHàm lượng calo (tính toán): 3,625 kcal/kg or 455 kcal/cốc\u003c/li\u003e\n\u003cli style=\"box-sizing: border-box;\"\u003eSản phẩm Nutrience Original Adult, Small Breed được phát triển để đáp ứng các mức dinh dưỡng về duy trì sức khỏe toàn diện được thiết lập bởi hồ sơ dinh dưỡng thức ăn cho chó AAFCO.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e\u003cspan style=\"box-sizing: border-box;\"\u003eHướng dẫn cách cho ăn\u003c/span\u003e\u003c/p\u003e\n\u003cul style=\"box-sizing: border-box; margin-top: 0px; margin-bottom: 10px; color: #333333; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e\n\u003cli style=\"box-sizing: border-box;\"\u003eTất cả các chú chó cưng không được tạo ra như nhau. Chú chó của bạn có thể đòi hỏi nhiều thức ăn hơn hoặc ít hơn tùy thuộc vào độ tuổi, mức độ hoạt động và môi trường. Chỉ cần bắt đầu với các đề xuất của chúng tôi, điều chỉnh khi cần và đảm bảo luôn có sẵn nước sạch.\u003c/li\u003e\n\u003cli style=\"box-sizing: border-box;\"\u003eChuyển sang thức ăn Nutrience\u003c/li\u003e\n\u003cli style=\"box-sizing: border-box;\"\u003eĐiều quan trọng là phải chuyển dần dần chú chó cưng của bạn từ thức ăn này sang thức ăn khác để tránh gây kích ứng cho hệ tiêu hóa. Bắt đầu với tỷ lệ 25% thức ăn Nutrience trộn với 75% thực phẩm cũ đang sử dụng. Từ từ thay đổi tỷ lệ trong 5 đến 7 ngày tiếp theo bằng cách tăng dần lượng thức ăn Nutrience và giảm dần lượng thức ăn cũ đang sử dụng.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e\u003cspan style=\"box-sizing: border-box;\"\u003eTrọng lượng số lượng / ngày\u003c/span\u003e\u003c/p\u003e\n\u003cul style=\"box-sizing: border-box; margin-top: 0px; margin-bottom: 10px; color: #333333; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e\n\u003cli style=\"box-sizing: border-box;\"\u003e1 kg / 2.2 lbs ⅓ cốc\u003c/li\u003e\n\u003cli style=\"box-sizing: border-box;\"\u003e3 kg / 6.6 lbs ⅔ cốc\u003c/li\u003e\n\u003cli style=\"box-sizing: border-box;\"\u003e5 kg / 11 lbs 1 cốc\u003c/li\u003e\n\u003cli style=\"box-sizing: border-box;\"\u003e7 kg / 15.5 lbs 1¼ cốc\u003c/li\u003e\n\u003cli style=\"box-sizing: border-box;\"\u003e10 kg / 22 lbs 1¾ cốc\u003c/li\u003e\n\u003cli style=\"box-sizing: border-box;\"\u003e1 cốc (8 oz) = 125g\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và 