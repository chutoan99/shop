ng vật hoang dã và môi trường đã được ghi nhận bằng những giải thưởng vô cùng danh giá. Cho đến nay, tuy đã 80 tuổi, bà vẫn miệt mài nghiên cứu và đi khắp năm châu để tuyên truyền, kêu gọi người dân chung tay bảo vệ động vật và môi trường để thế giới ngày càng tốt đẹp hơn.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/75/9e/bd/dc48497033af087afaaf697751509cd8.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/75/9e/bd/dc48497033af087afaaf697751509cd8.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/75/9e/bd/dc48497033af087afaaf697751509cd8.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/75/9e/bd/dc48497033af087afaaf697751509cd8.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/75/9e/bd/dc48497033af087afaaf697751509cd8.jpg"}],"warranty_policy":null,"authors":[{"id":434361,"name":"ChungBe Studios, Lee Sukja","slug":"chungbe-studios-lee-sukja"}],"current_seller":{"id":62303,"sku":"6521120267867","name":"Tiệm Sách Minh Vân","link":"https://tiki.vn/cua-hang/tiem-sach-minh-van","logo":"https://vcdn.tikicdn.com/ts/seller/3b/a8/12/9ed725b43ccb5523a205e6c14c8725ad.jpg","price":58500,"product_id":"241907367","store_id":58603,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Thông tin chung","attributes":[{"code":"publisher_vn","name":"Công ty phát hành","value":" NXB Kim Đồng"},{"code":"book_cover","name":"Loại bìa","value":"Bìa mềm"},{"code":"manufacturer","name":"Nhà xuất bản","value":"Nhà Xuất Bản Kim Đồng"}]}],"product_links":[],"gift_item_title":"0 qu