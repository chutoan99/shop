":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":131000,"discount_rate":7,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/28/75/b4/217c349c9efefc19d7986fe0bd2c91c6.jpeg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":787,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003eTông quan nồi cơm điện tử Toshiba 1.8 lít RC-18DH2PV(W)\u003c/h3\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/53/ab/bc/534de4ffc443e8237ec60b47750fde16.jpeg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch3\u003eNồi cơm điện tử Toshiba 1.8 lít RC-18DH2PV(W) kiểu dáng bo cong mềm mại, có quai xách tiện dụng cho việc cầm nắm\u003c/h3\u003e\n\u003cp\u003e\u003cimg title=\"Thiết kế Toshiba 1.8 lít RC-18DH2PV(W)\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/dc/bb/d9/2c88271dc066abd2d972335ebe1a23c0.jpg\" alt=\"Thiết kế Toshiba 1.8 lít RC-18DH2PV(W)\" /\u003e\u003c/p\u003e\n\u003ch3\u003eDẫn nhiệt tốt và dễ vệ sinh với chất liệu lòng nồi hợp kim nhôm phủ chống dính Bichotan 5 lớp độ dày 2.2mm\u003c/h3\u003e\n\u003cp\u003e\u003cimg title=\"Lòng nồi Toshiba 1.8 lít RC-18DH2PV(W)\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/2c/b2/ac/b630d0b9c9e9726e78f0ba7f8eb96bf7.jpg\" alt=\"Lòng nồi Toshiba 1.8 lít RC-18DH2PV(W)\" /\u003e\u003c/p\u003e\n\u003ch3\u003eTiết kiệm điện nhờ công nghệ nấu 1D\u003c/h3\u003e\n\u003cp\u003eNhiệt được truyền từ mâm nhiệt trực tiếp từ đáy nồi giúp cơm nhanh chín trong thời gian từ 30 - 40 phút, tiết kiệm điện.\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"Mâm nhiệt Toshiba 1.8 lít RC-18DH2PV(W)\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/bf/c6/84/d7d8e44f8d5e3be80faa9509cc0b6052.jpg\" alt=\"Mâm nhiệt Toshiba 1.8 lít RC-18DH2PV(W)\" /\u003e\u003c/p\u003e\n\u003ch3\u003eNồi có chức năng hẹn giờ nấu xong lên đến 24 tiếng để cơm chín đúng thời gian bạn muốn\u003c/h3\u003e\n\u003cp\u003eThực đơn đa dạng chương trình nấu nấu nhanh, cơm trộn, cháo, cơm trắng, gạo lức, xôi, cơm cháy, canh súp, làm bánh, nấu cơm sushi, hấp. Cùng với chế độ giữ ấm lên đến 12 giờ cho cơm ngon hơn.Màn hình LED được tích hợp ngay bảng điều khiển dạng nút nhấn, thuận tiện cho việc quan sát thời gian và chế độ nấu.\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"Bảng điều khiển Toshiba 1.8 lít RC-18DH2PV(W)\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/0f/a7/9e/ebb7f77cb47123b965e1dcbca8293769.jpg\" alt=\"Bảng điều khiển Toshiba 1.8 lít RC-18DH2PV(W)\" /\u003e\u003c/p\u003e\n\u003ch3\u003eNắp trong nồi dạng tổ ong, có thể tháo rời lau chùi\u003c/h3\u003e\n\u003cp\u003eThiết kế này giúp hạn chế hơi nước đọng lại trên nắp rồi rơi lại vô bề mặt cơm làm nhanh hư cơm.\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"Nắp nồi Toshiba 1.8 lít RC-18DH2PV(W)\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/00/ed/5a/20d1f14a28d0b987dbc6861ef4a4f7eb.jpg\" alt=\"Nắp nồi Toshiba 1.8 lít RC-18DH2PV(W)\" /\u003e\u003c/p\u003e\n\u003ch3\u003eVan thoát hơi thông minh chống trào\u003c/h3\u003e\n\u003cp\u003e\u003cimg title=\"Van thoát hơi Toshiba 1.8 lít RC-18DH2PV(W)\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/91/70/c7/f892d871493a3fd59b0c5d6fd0e10050.jpg\" alt=\"Van thoát hơi Toshiba 1.8 lít RC-18DH2PV(W)\" /\u003e\u003c/p\u003e\n\u003ch3\u003ePhù hợp cho gia đình 4 - 6 thành viên với dung tích 1.8 lít\u003c/h3\u003e\n\u003cp\u003eNấu được khoảng 8 - 10 cốc gạo (cốc kèm nồi) tương đương 4 lon sữa.\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"Dung tích Toshiba 1.8 lít RC-18DH2PV(W)\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/2f/7d/65/384f8c9fa00340490ae69cea6aac26bb.jpg\" alt=\"Dung tích Toshiba 1.8 lít RC-18DH2PV(W)\" /\u003e\u003c/p\u003e\n\u003cp\u003eNồi cơm điện tử Toshiba 1.8 lít RC-18DH2PV(W) thương hiệu uy tín Nhật Bản đảm bảo chất lượng phù hợp cho mọi gia đình.\u003c/p\u003e\n\u003cp\u003eLưu ý khi sử dụng:\u003c/p\u003e\n\u003cp\u003e- Nên lau khô mặt ngoài và đáy của lòng nồi cơm trước khi đặt vào nồi cơm điện để bảo vệ cho mâm nhiệt.\u003c/p\u003e\n\u003cp\u003e- Không dùng miếng nhám chà nồi, đồ chà nồi có chứa kim loại sẽ làm trầy lớp chống dính.\u003c/p\u003e\n\u003cp\u003e- Đặt nồi cơm ở nơi thoáng mát, khô ráo, bề mặt phẳng, không đặt gần nguồn nhiệt như bếp gas, lò vi sóng,\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/28/75/b4/217c349c9efefc19d7986fe0bd2c91c6.jpeg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/28/75/b4/217c349c9efefc19d7986fe0bd2c91c6.jpeg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/28/75/b4/217c349c9efefc19d7986fe0bd2c91c6.jpeg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/28/75/b4/217c349c9efefc19d7986fe0bd2c91c6.jpeg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/28/75/b4/217c349c9efefc19d7986fe0bd2c91c6.jpeg"},{"base_url":"https://salt.tikicdn.com/ts/product/a2/a0/3d/0d1e4d3a908