ull,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":151000,"discount_rate":14,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/09/84/35/9b9c3771556b812b32f3b47e79518cc9.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":496,"all_time_quantity_sold":7,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eBàn Phím Không Dây Logitech Signature K650\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eVới các lối tắt được nâng cấp và tích hợp chỗ gác tay, SIGNATURE K650 phù hợp hoàn hảo cho nhu cầu làm việc hàng ngày của bạn. Tiết kiệm thời gian với các phím tắt như tắt tiếng micrô và bật tiếng, chụp ảnh màn hình và điều hướng web. Tận hưởng sự thoải mái bạn cần trong nhiều giờ. Kết nối không dây với Bluetooth hoặc đầu thu USB Logi Bolt đi kèm và sử dụng cùng chuột Signature để mở ra năng suất cao hơn. Với thời lượng pin lên tới 36 tháng và thiết kế chống tràn, dễ lau chùi, bạn có thể làm việc hiệu quả trên bất kỳ hệ điều hành nào — mà không có dây cáp vướng víu.\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eCÁC ĐẶC ĐIỂM NỔI BẬT \u003c/strong\u003e\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eThoải mái suốt ngày:\u003c/strong\u003e Chỗ gác tay tích hợp mềm mại của bàn phím với các phím có đệm sâu đem lại cảm giác quen thuộc tức thì cho trải nghiệm gõ đầy thỏa mãn.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/fe/99/4c/2065b0531e2bf6d7aafaaf66ab635cef.png\" alt=\"\" width=\"750\" height=\"749\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eNhẹ nhàng hơn, năng suất hơn:\u003c/strong\u003e Bố cục bàn phím không dây có kích thước đầy đủ với khả năng tiếp cận thuận tiện vào tất cả các phím tắt phù hợp; tiết kiệm thời gian với các lệnh như tắt tiếng, bật tiếng micrô, chụp ảnh màn hình và điều hướng web.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/84/9b/68/1e174575466d5d07425efef6addcf409.png\" alt=\"\" width=\"750\" height=\"749\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eKết nối theo cách bạn muốn:\u003c/strong\u003e Kết nối không dây thông qua công nghệ Bluetooth BLE (Bluetooth Low Energy) hoặc đầu thu Logi Bolt đi kèm.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/79/9f/b3/18a5d06019eb3c6fb66ee8c585cafd41.png\" alt=\"\" width=\"750\" height=\"749\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eHoạt động trên nhiều nền tảng:\u003c/strong\u003e Bàn phím không dây Signature K650 của Logitech hoạt động với nhiều hệ điều hành — Windows, macOS, Chrome OS, Linux, iPadOS, iOS và Android\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/47/01/b1/1edfab3f8151e7031d0670ddf9b373c2.png\" alt=\"\" width=\"750\" height=\"749\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eĐơn giản là tốt hơn khi kết hợp cùng nhau:\u003c/strong\u003e Nâng cấp để có năng suất và khả năng linh hoạt tốt hơn bằng cách kết hợp K650 của bạn với chuột M650 Logitech; cá nhân hóa thông qua phần mềm Logi Options+ (Windows 10 và macOS 10.15 trở lên)\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTối giản và đáng tin cậy:\u003c/strong\u003e Bàn phím không dây của bạn sẽ không yêu cầu pin mới trong tối đa 36 tháng (có thể thay đổi tùy theo người dùng và điều kiện tính toán); nó cũng dễ dàng làm sạch và chống tràn\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThiết kế lựa chọn mà bạn sẽ cảm thấy hài lòng:\u003c/strong\u003e Các bộ phận bằng nhựa trong Signature K650 bao gồm nhựa tái chế sau tiêu dùng đã được chứng nhận (4) (Graphite: 28%, Off White: 21%).\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/4d/04/f6/c3fa7133ff724e031f4c99eb6af1bbc1.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/61/5d/9d/4dfd90f0575bd493f0e0c7192b4e227b.png\" alt=\"\" width=\"750\" height=\"14623\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/09/84/35/9b9c3771556b812b32f3b47e79518cc9.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/09/84/35/9b9c3771556b812b32f3b47e79518cc9.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/09/84/35/9b9c3771556b812b32f3b47e79518cc9.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/09/84/35/9b9c3771556b812b32f3b47e79518cc9.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/09/84/35/9b9c3771556b812b32f3b47e79518cc9.png"},{"base_url":"https://salt.tikicdn.com/ts/product/9d/4f/90/61a61431918b7fd2e761b8c4ec397e03.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/9d/4f/90/61a61431918b7fd2e761b8c4ec397e03.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/9d/4f/90/61a61431918b7fd2e761b8c4ec397e03.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9d/4f/90/61a61431918b7fd2e761b8c4ec397e03.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9d/4f/90/61a61431918b7fd2e761b8c4ec397e03.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/5d/53/31/a633ec