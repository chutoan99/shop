"\u003cp\u003e\n    \u003c!-- td {border: 1px solid #ccc;}br {mso-data-placement:same-cell;} --\u003e\n    \u003cstrong\u003e\n        Tiếng Việt Trình Độ A (Tập 1)\n    \u003c/strong\u003e\n\u003c/p\u003e\n\u003cp\u003e\n    Tiếng Việt Trình Độ A  (Tập 1) do GS.TS Đoàn Thiện Thuật làm chủ biên là một cuốn sách có cách bố cục khá chặt chẽ, khoa\n    học. Cách trình bày cũng tương đối dễ hiểu, dễ xem.\n\u003c/p\u003e\n\u003cp\u003e\n    Mục Lục\n\u003c/p\u003e\n\u003cul\u003e\n    \u003cli\u003e\n        Bài 1: Đại từ nhân xưng, tên các nước, số từ 1 - 10\n    \u003c/li\u003e\n    \u003cli\u003e\n        Bài 2: Tên một số nghề, số từ 11 - 19\n    \u003c/li\u003e\n    \u003cli\u003e\n        Bài 3: Mấy và bao nhiêu, số từ 20 -100\n    \u003c/li\u003e\n    \u003cli\u003e\n        Bài 4: Đồ dùng và con vật trong nhà, số từ 101 - 1000\n    \u003c/li\u003e\n    \u003cli\u003e\n        Bài 5: Cái gì của ai. Ông/ bà/ bố/ mẹ\n    \u003c/li\u003e\n    \u003cli\u003e\n        Bài 6: Này/ kia/ ấy/ đó. Các tính từ: già, trẻ, đẹp, xấu\n    \u003c/li\u003e\n    \u003cli\u003e\n        Bài 7: Ôn tập\n    \u003c/li\u003e\n    \u003cli\u003e\n        Bài 8: Từ chỉ giờ. Đã/ đang/ sẽ\n    \u003c/li\u003e\n    \u003cli\u003e\n        Bài 9: Từ chỉ thời gian: thứ, ngày, tháng\n    \u003c/li\u003e\n    \u003cli\u003e\n        Bài 10: Từ chỉ mùa. Lúc (2 giờ). Vào (thứ hai)\n    \u003c/li\u003e\n    \u003cli\u003e\n        Bài 11: Từ chỉ đồ đạc trong nhà. Tên các phòng. Từ chỉ vị trí: trên, dưới, trong, ngoài...\n    \u003c/li\u003e\n    \u003cli\u003e\n        Bài 12: Từ chỉ màu sắc. Các tính từ. Rất/ khá/ hơi\n    \u003c/li\u003e\n    \u003cli\u003e\n        Bài 13: Từ so sánh: bằng, không, bằng, hơn, nhất. Giống nhau, khác nhau.\n    \u003c/li\u003e\n    \u003cli\u003e\n        Bài 14: Ôn tập\n    \u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/b1/9c/64/76fc4f5b6bd69d950dea45b3c885acba.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b1/9c/64/76fc4f5b6bd69d950dea45b3c885acba.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b1/9c/64/76fc4f5b6bd69d950dea45b3c885acba.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b1/9c/64/76fc4f5b6bd69d950dea45b3c885acba.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b1/9c/64/76fc4f5b6bd69d950dea45b3c885acba.jpg"}],"warranty_policy":null,"authors":[{"id":27477,"name":"Nguyễn Khánh Hà","slug":"nguyen-khanh-ha"},{"id":148981,"name":"GS.TS Đoàn Thiện Thuật","slug":"gs-ts-doan-thien-thuat"},{"id":149007,"name":"Trịnh Cẩm Lan","slug":"trinh-cam-lan"},{"id":149009,"name":"Nguyễn Phương Trang","slug":"nguyen-phuong-trang"}],"current_seller":{"id":10914,"sku":"8909249927784","name":"trungthanh2018","link":"https://tiki.vn/cua-hang/trungthanh2018","logo":"a7/54/06/bad90228783e18b51eeff7187fadb302.jpg","price":140000,"product_id":"12717602","store_id":10648,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Thông tin chung","attributes":[{"code":"publisher_vn","name":"Công ty phát hành","value":"CÔNG TY CỔ PHẦN NAGAI"},{"code":"publication_date","name":"Ngày xuất bản","value":"2017-11-06 17:18:11"},{"code":"dimensions","name":"Kích thước","value":"30 x 20 cm"},{"code":"book_cover","name":"Loại bìa","value":"Bìa mềm"},{"code":"number_of_page","name":"Số trang","value":"232"},{"code":"manufacturer","name":"Nhà xuất bản","value":"Tiki Tổng Hợp"}]}],"product_links":[],"gift_item_title":"0 quà tặng kèm","highlight":{"items":["Bố cục sách chặt chẽ và khoa học, giúp người đọc dễ tiếp thu kiến 