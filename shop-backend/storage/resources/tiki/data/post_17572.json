l,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/6b/e5/06/ca74dcce61d82e81c1ed1f743a3d1189.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1381,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cdiv id=\"protab1\" class=\"pro-tabcontent\"\u003e\n\u003cdiv class=\"tab-content\"\u003e\n\u003ch2\u003e\u003cstrong\u003eLOA DI ĐỘNG TIỆC TÙNG MỌI NƠI EARFUN UBOOM\u003c/strong\u003e\u003c/h2\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/6e/fe/12/7fe5df2fdb41aa68032fb5c11eb78354.jpg\" alt=\"\" width=\"750\" height=\"463\" /\u003e\u003c/p\u003e\n\u003ch3\u003e \u003c/h3\u003e\n\u003ch3\u003e\u003cem\u003eThiết kế âm thanh phát 360 độ, 2 màng loa công suất 24W\u003c/em\u003e\u003c/h3\u003e\n\u003cp\u003eBên cạnh những cặp tai nghe True Wireless đầy thú vị, hãng âm thanh EarFun cũng đem một chiếc loa di động tới thị trường Việt Nam mang tên EarFun UBOOM. Chiếc loa này được tích hợp 2 màng loa với tổng \u003cstrong\u003ecông suất 24W\u003c/strong\u003e được đặt đối diện nhau, tạo thành âm thanh phát ra từ 360 hướng giúp khuấy động mọi bữa tiệc dù loa có được để ở đâu đi chăng nữa.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/60/ea/1a/130cb769b1e238af70dd2fc30e6a45d1.jpg\" alt=\"\" width=\"750\" height=\"978\" /\u003e\u003c/p\u003e\n\u003ch3\u003e \u003c/h3\u003e\n\u003ch3\u003e\u003cem\u003eBluetooth 5.0 giảm độ trễ, thời lượng sử dụng 16 tiếng\u003c/em\u003e\u003c/h3\u003e\n\u003cp\u003eLoa được tích hợp chuẩn Bluetooth 5.0 mới nhất, giúp độ trễ được giảm xuống thấp nhất có thể. Với viên \u003cstrong\u003epin 2200mAh\u003c/strong\u003e, UBOOM có thể \u003cstrong\u003echơi nhạc liên tục 16 giờ\u003c/strong\u003e trước khi phải sạc.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/65/7b/37/62918e2be5aa4f0f148b97ef7c7add21.jpg\" alt=\"\" width=\"750\" height=\"978\" /\u003e\u003c/p\u003e\n\u003ch3\u003e \u003c/h3\u003e\n\u003ch3\u003e\u003cem\u003eSẵn sàng đi khắp mọi nơi với chuẩn chống nước IPX7\u003c/em\u003e\u003c/h3\u003e\n\u003cp\u003eKhông giới hạn là một chiếc loa sử dụng trong nhà, EarFun UBOOM được trang bị chuẩn \u003cstrong\u003echống nước IPX7\u003c/strong\u003e - đây là một chuẩn chống nước cao không những có thể chống chịu được mưa, nước đổ vào mà còn sẵn sàng cho việc bị nhúng xuống dưới nước, cho phép người dùng sử dụng loa ở những bữa tiệc bãi biển hoặc hồ bơi.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/2c/92/ef/1988b7d9e19872db78fdf91f219463e1.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003ch3\u003eVideo đánh giá chi tiết sản phẩm:\u003c/h3\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003ciframe src=\"//www.youtube.com/embed/wb-HJ2E3TCY\" width=\"560\" height=\"314\" allowfullscreen=\"allowfullscreen\"\u003e\u003c/iframe\u003e\u003c/p\u003e\n\u003cdiv class=\"tab-title\"\u003e \u003c/div\u003e\n\u003ch3 id=\"protab2\" class=\"pro-tabcontent\"\u003eTHÔNG SỐ KỸ THUẬT:\u003c/h3\u003e\n\u003cdiv class=\"pro-tabcontent\"\u003e\n\u003cdiv class=\"tab-content\"\u003e\n\u003cul\u003e\n\u003cli\u003e2 màng loa dynamic đường kính 