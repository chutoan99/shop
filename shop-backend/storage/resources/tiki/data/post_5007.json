u003cimg class=\"_2qyaZL _2PWsS4\" src=\"https://cf.shopee.vn/file/1bf7d053c3a1f96cab3b91c309e9f584\" alt=\"1bf7d053c3a1f96cab3b91c309e9f584\" /\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cp class=\"_2jrvqA\"\u003e \u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003eTÍNH NĂNG NỔI BẬT:\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003eKhoá vân tay Aqara A100 nay đã chính thức hỗ trợ HomeKey. Đây là phương thức mở khoá mới và tiện lợi nhất.\u003c/p\u003e\n\u003cdiv class=\"_2jrvqA\"\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"_1OPdfl\"\u003e\u003cimg class=\"_2qyaZL _2PWsS4\" src=\"https://cf.shopee.vn/file/87c888aee909ade185254a763d8d2fb7\" alt=\"87c888aee909ade185254a763d8d2fb7\" /\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cp class=\"_2jrvqA\"\u003eKHOÁ VÂN TAY 7 CÁCH MỞ KHÓA:\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e\u0026#43; Mở khoá bằng vân tay, lưu trữ tối đa 50 vân tay\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e\u0026#43; Mở khoá bằng mật khẩu số.\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e\u0026#43; Mở khoá bằng mật khẩu tạm thời (dành cho khách đến thăm nhà).\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e\u0026#43; Mở khoá bằng NFC (thẻ NFC Aqara cần mua riêng).\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e\u0026#43; Mở khoá bằng chìa khoá cơ.\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e\u0026#43; Mở khoá bằng ứng dụng Aqara trên điện thoại thông qua Bluetooth.\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e\u0026#43; Mở khoá bằng HomeKey.\u003c/p\u003e\n\u003cdiv class=\"_2jrvqA\"\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"_1OPdfl\"\u003e\u003cimg class=\"_2qyaZL _2PWsS4\" src=\"https://cf.shopee.vn/file/ac0a97cd587e4b3a797058a2644cfccd\" alt=\"ac0a97cd587e4b3a797058a2644cfccd\" /\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cp class=\"_2jrvqA\"\u003eKhoá vân tay Aqara A100 được thiết kế bảo mật toàn diện từ mặt trong ra mặt ngoài. Với lõi khoá bảo mật cấp C (cấp bảo mật cao nhất), thân khoá bảo mật cấp B. Aqara A100 có thể chống chịu mọi hành động phá khoá bằng lực mạnh, đem lại cảm giác an tâm tuyệt đối cho gia chủ.\u003c/p\u003e\n\u003cdiv class=\"_2jrvqA\"\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"_1OPdfl\"\u003e\u003cimg class=\"_2qyaZL _2PWsS4\" src=\"https://cf.shopee.vn/file/2d9ff86608368fa92ea0c95cc114f1f8\" alt=\"2d9ff86608368fa92ea0c95cc114f1f8\" /\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cp class=\"_2jrvqA\"\u003eKhoá vân tay Aqara A100 được trang bị cảm biến vân tay bán dẫn 3D và thuật toán nhận diện vân tay của công ty PB Thuỵ Điển, giúp loại bỏ 100% tình trạng vân tay giả mạo.\u003c/p\u003e\n\u003cdiv class=\"_2jrvqA\"\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"_1OPdfl\"\u003e\u003cimg class=\"_2qyaZL _2PWsS4\" src=\"https://cf.shopee.vn/file/3fe62eb512a789ec318f7d92d8a13f55\" alt=\"3fe62eb512a789ec318f7d92d8a13f55\" /\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cp class=\"_2jrvqA\"\u003eKhoá vân tay Aqara A100 được thiết kế với Công Nghệ Đen bảo mật tuyệt đối.\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e- Thiết kế mạch điện bên trong có lớp chống nhiễu điện, tránh mở khoá bằng thiết bị ngoại vi.\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e- Mặt khoá sơn nhám giúp bạn không để lại dấu vân tay, tránh việc sao chép dấu vân tay giả mạo.\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e- Chốt khoá cơ nằm ở mặt trong, có phá banh hết khoá thì vẫn còn 1 lớp cuối cùng chống chịu.\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e- Mạch điều khiển nằm ở mặt trong, có nghĩa là phía ngoài có hư hại cỡ nào thì vẫn không thể can thiệp.\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e- Ly hợp của khoá tích hợp bên trong nhiều lớp, giảm tình trạng phá khoá.\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e- Cảm biến nhận diện cửa mở giúp cảnh báo cho chủ nhà tình trạng đóng mở của cửa.\u003c/p\u003e\n\u003cdiv class=\"_2jrvqA\"\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"_1OPdfl\"\u003e\u003cimg class=\"_2qyaZL _2PWsS4\" src=\"https://cf.shopee.vn/file/e1e9aaac1bd8c854a4ada0edbba83a52\" alt=\"e1e9aaac1bd8c854a4ada0edbba83a52\" /\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cp class=\"_2jrvqA\"\u003eKhoá vân tay Aqara A100 là khoá thông minh, vì vậy có có thể thông báo các trạng thái mở khoá, mở khoá bất thường (ngoài khung giờ bạn cài đặt) hoặc cảnh báo cửa mở bằng cảm biến cửa, cảnh báo nhập sai mật khẩu, quản lý các vân tay trên khoá, và xem trạng thái khoá trực tiếp trên app. Để xem trạng thái khoá trực tiếp trên app và xem từ xa, bạn cần trạng bị Điều khiển trung tâm Aqara Hub Zigbee 3.0 trở lên.\u003c/p\u003e\n\u003cdiv class=\"_2jrvqA\"\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"_1OPdfl\"\u003e\u003cimg class=\"_2qyaZL _2PWsS4\" src=\"https://cf.shopee.vn/file/0d8a26b4ebb7a84ea0087a99cde5b79c\" alt=\"0d8a26b4ebb7a84ea0087a99cde5b79c\" /\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cp class=\"_2jrvqA\"\u003eKhoá vân tay Aqara A100 được trang bị 8 viên pin dung lượng cao của Alkaline, cho bạn 540 ngày dùng khoá không cần phải sạc. Đảm bảo cho việc mở khoá được thông suốt, không bị mất điện, không sợ hết pin.\u003c/p\u003e\n\u003cdiv class=\"_2jrvqA\"\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"_1OPdfl\"\u003e\u003cimg class=\"_2qyaZL _2PWsS4\" src=\"https://cf.shopee.vn/file/39366e2263911293d3292ec6fca8e0d3\" alt=\"39366e2263911293d3292ec6fca8e0d3\" /\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cp class=\"_2jrvqA\"\u003eKhoá vân tay Aqara A100 còn có thể liên kết thông minh với các thiết bị khác trong hệ sinh thái Aqara Home ví dụ như công tắc Aqara D1, Rèm Aqara, điều khiển máy lạnh của Aqara hub M2/G3,....\u003c/p\u003e\n\u003cdiv class=\"_2jrvqA\"\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"_1OPdfl\"\u003e\u003cimg class=\"_2qyaZL _2PWsS4\" src=\"https://cf.shopee.vn/file/fba6bdd2601f8fae1f4d743daabc5ca0\" alt=\"fba6bdd2601f8fae1f4d743daabc5ca0\" /\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cp class=\"_2j