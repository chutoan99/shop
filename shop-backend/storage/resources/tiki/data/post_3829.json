ng_average":5,"review_count":9,"review_text":"(9)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/37/84/b7/e1dc7699593dbc7a9a78302fe42b3e8e.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":652,"all_time_quantity_sold":39,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align:center;\"\u003e\u003cspan style=\"color:#ff0000;\"\u003e\u003cstrong\u003eTướng Cao Văn Khánh - Hồi Ức Lịch Sử\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cspan style=\"color:#ff0000;\"\u003e\u003cstrong\u003e\u003ciframe src=\"//www.youtube.com/embed/AU9pkukM2qg\" width=\"560\" height=\"314\" allowfullscreen=\"\"\u003e\u003c/iframe\u003e\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e\u003cstrong\u003eGIỚI THIỆU SÁCH:\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003eĐây là hồi ức về một vị tướng trầm lặng, rất hiếm khi được nhắc tên dù luôn xuất hiện trong những bức ảnh của nhóm đầu não chiến lược Bộ Tổng Tham mưu. Người ta chỉ biết nhiều về đám cưới độc nhất vô nhị của ông và tin đồn ông là anh ruột của Đại tướng Cao Văn Viên, Tổng Tham mưu trưởng quân đội Sài Gòn. Nhưng không mấy người biết về công việc và cuộc đời của \u003cstrong\u003eTrung tướng Cao Văn Khánh -\u003c/strong\u003e nguyên Phó Tổng Tham mưu trưởng Quân đội Nhân dân Việt Nam -\u003cem\u003e “vị tướng trí thức”\u003c/em\u003e như thường được gọi.\u003c/p\u003e\n\u003cp\u003eCuốn sách \u003cem\u003e\u003cstrong\u003eTướng Cao Văn Khánh - Hồi Ức Lịch Sử\u003c/strong\u003e\u003c/em\u003e không chỉ là một bản tường thuật về cuộc đời và sự nghiệp của \u003cem\u003eTrung tướng Cao Văn Khánh\u003c/em\u003e, mà còn là một bức tranh rực rỡ về những mảnh đời và những sự kiện quan trọng đã gắn bó với ông. Từ những ngày tháng dày đặc trong vai trò quân sự đến những khúc mắc và thành công trong sự nghiệp lãnh đạo, cuốn sách khám phá sâu sắc các diễn biến của một nhân vật mang tính chiến lược và tầm nhìn dài hạn.\u003c/p\u003e\n\u003cp\u003eSách dày 800 trang sách khổ lớn, gồm 40 chương với một khối lượng tư liệu khá lớn, là tài liệu tham khảo rất bổ ích cho những ai quan tâm đến lịch sử Việt Nam từ năm 1945 -1975, không những về cuộc chiến mà còn về lý tưởng sống của những người chân chính phần lớn là vô danh đã cống hiến cả cuộc đời họ.\u003c/p\u003e\n\u003cp\u003e--\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTHÔNG TIN CHI TIẾT:\u003c/strong\u003e\u003cbr /\u003eCông ty phát hành Khác.\u003cbr /\u003eTác Giả: Cao Bảo Vân.\u003cbr /\u003eNăm Xuất Bản: 2022.\u003cbr /\u003eSố Trang: 810.\u003cbr /\u003eBìa Cứng.\u003cbr /\u003eKích Thước: 16x24 cm.\u003cbr /\u003eNhà Xuất bản Tri Thức.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/37/84/b7/e1dc7699593dbc7a9a78302fe42b3e8e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/37/84/b7/e1dc7699593dbc7a9a78302fe42b3e8e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/37/84/b7/e1dc7699593dbc7a9a78302fe42b3e8e.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/37/84/b7/e1dc7699593dbc7a9a78302fe42b3e8e.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/37/84/b7/e1dc7699593dbc7a9a78302fe42b3