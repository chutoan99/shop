ef":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"defective_product"}},"discount":1400000,"discount_rate":15,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/71/79/76/4df7e816325a226278618e80b6bba847.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":129,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eNhóm nước hoa: Hương trái cây SÍP\u003c/p\u003e\n\u003cp\u003eGiới tính: Nam\u003c/p\u003e\n\u003cp\u003eNăm ra mắt: 2010\u003c/p\u003e\n\u003cp\u003eNồng độ: EDP\u003c/p\u003e\n\u003cp\u003eĐộ lưu hương: Tạm ổn – 3 giờ đến 6 giờ\u003c/p\u003e\n\u003cp\u003ePhong cách: Nam tính, Hấp dẫn, Tinh tế\u003c/p\u003e\n\u003cp\u003eHương Đầu: Cam Bergamot, Quả lý chua đen, Quả dứa (quả thơm), Quả táo xanh\u003c/p\u003e\n\u003cp\u003eHương giữa: Gỗ Bu-lô, Cây hoắc hương, Hoa hồng, Hoa nhài Morocco\u003c/p\u003e\n\u003cp\u003eHương cuối: Xạ hương, Rêu cây sồi, Hương Va ni (Vanille), Long diên hương.\u003c/p\u003e\n\u003cp\u003eCreed Aventus được lấy cảm hứng từ cuộc đời đầy kịch tính của Hoàng Đế Napoleon (chiến tranh, hòa bình, lãng mạn). Aventus là dòng nước hoa dành cho nam giới được giới thiệu vào năm 2010. Nó thuộc nhóm hương trái cây Chypre. Người sáng tạo ra dòng nước hoa này là Erwin Creed 7th, Olivier Creed 6th Generation.\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"aligncenter wp-image-36695\" style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/db/51/7a/b5462b101074c6a9b10777d4019b3a69.jpg\" alt=\"Creed Aventus - N - Nước hoa cao cấp, chính hãng giá tốt, mẫu mới\" width=\"600\" height=\"449\" /\u003e\u003c/p\u003e\n\u003cp\u003eCreed Aventus tôn vinh sức mạnh, tầm nhìn và sự thành công, lấy cảm hứng từ cuộc sống đầy giai thoại giữa chiến tranh, hòa bình và sự lãng mạn của hoàng đế Napoleon. Nhắc đến Aventus hẳn những ai yêu thích nước hoa đều phải dành cho nó nhiều mỹ từ, và từ ngữ miêu tả về nó một cách chân thật nhất đó là “vua” của nước hoa. Aventus là một cổ ngữ, có ý nghĩa là “thành công”, và Aventus cũng từng là một địa danh bao gồm vùng Louisiana, một khu vực Napoleon cai trị. Chừng ấy thôi để thấy rằng nhà sản xuất nước hoa kinh điển của nước Anh, Creed, một trong những nhà chế tác nước hoa lâu đời nhất trong lịch sử từ những năm 1760 đã gửi gắm và dành mọi tâm huyết cho huyền thoại Creed Aventus. Và ngay cả thiết kế chai cũng hướng tới hình tượng Napoleon cưỡi ngựa ra chiến trường, một sự mạnh mẽ và đầy chất sử thi. Một mùi hương nam tính, thách thức, tự tin, lạc quan và đầy hoài bão dành cho những người giàu tham vọng và chí lớn. Khí chất của Creed Aventus tỏa ra là vậy, quyền lực một cách tuyệt đối. Hương thơm của trái Dứa hòa quyện cùng Xạ hương, đan xen theo từng cung bậc mùi hương của Gỗ Bu-lô tạo nên một cốt cách phi thường, bản lĩnh và có thừa sự cuốn hút. Creed Aventus không dành cho những kẻ yếu đuối, nhút nhát, bởi khi khoác lên lớp giáp Aventus, sự cuốn hút và nể trọng đã được đẩy lên một tầng cao nhất dành cho những người xung quanh. Và bạn cũng đừng bao giờ quên, Creed Aventus đã là một vị vua, sự phục tùng vô điều kiện của những cô gái xung quanh là một điều hiển nhiên và khó tránh khỏi.\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"aligncenter wp-image-36696\" style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/40/f6/d5/d2064e96afcdd9b0ae418b9e5c964fd7.jpg\" alt=\"Creed Aventus 2 - N - Nước hoa cao cấp, chính hãng giá tốt, mẫu mới\" width=\"600\" height=\"440\" /\u003e\u003c/p\u003e\n\u003cp\u003eCreed Aventus là chai nước hoa giản dị có mùi hương mang lại cảm giác chững chạc, trưởng thành với hương thơm được khéo léo cân bằng giữa các thành phần nguyên liệu. Aventus sẽ gây ấn tượng mạnh cho những nơi mà bạn có mặt như một thỏi nam châm hút mọi ánh nhìn. Hấp dẫn , nam tính và gợi cảm là những tính từ để diễn tả chai nước hoa này.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/71/79/76/4df7e816325a226278618e80b6bba847.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/71/79/76/4df7e816325a226278618e80b6bba847.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/71/79/76/4df7e816325a226278618e80b6bba847.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/71/79/76/4df7e816325a226278618e80b6bba847.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/71/79/76/4df7e816325a226278618e80b6bba847.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/a6/26/9d/36212d45d134d554d55d7c281593e668.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a6/26/9d/36212d45d134d554d55d7c281593e668.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a6/26/9d/36212d45d134d554d55d7c281593e668.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a6/26/9d/36212d45d134d554d55d7c281593e668.jpg","thumbnail_url":"https://salt.tikicdn.c