_reason"}},"discount":0,"discount_rate":0,"rating_average":4.6,"review_count":18,"review_text":"(18)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/4f/b6/68/7a79700bfca6c5b2c3592aa3f603fcda.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1822,"all_time_quantity_sold":163,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp class=\"sidebar\" style=\"text-align: center;\"\u003e\u003cstrong\u003e\u003cspan style=\"color: #ff99cc;\"\u003eSỮA RỬA MẶT SINH HỌC  CLEAR SKIN CONTROL\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"chu-thich\" style=\"text-align: left;\"\u003eThương hiệu: Detox BlanC\u003c/p\u003e\n\u003cp class=\"chu-thich\" style=\"text-align: left;\"\u003eXuất sứ: Việt Nam\u003c/p\u003e\n\u003cdiv class=\"chu-thich\"\u003e \u003cspan style=\"line-height: 1.2em;\"\u003e \u003c/span\u003e\u003c/div\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/2d/03/60/589fdf57cee18b6f87c708949a1743c4.jpg\" alt=\"sữa rửa mặt sinh học đa năng Detox BlanC\" /\u003e\u003c/p\u003e\n\u003cdiv id=\"hieuquasudung\" class=\"\"\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eSỮA RỬA MẶT ĐA NĂNG PHIÊN BẢN MỚI\u003c/strong\u003e\u003c/p\u003e\n\u003c/div\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e- Rửa sạch dễ dàng: Tích hợp khả năng 4 trong 1 là làm sạch da + tẩy hết các tế bào chết + tẩy trang + ngăn ngừa mụn nám.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e- Kết cấu các hạt bọt mịn: Giúp rửa sạch hoàn toàn bụi bẩn, dầu nhờn, lớp trang điểm giúp làn da sạch bong.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e- Thanh lọc cho một làn da mềm mượt: Chứa chất dưỡng ẩm tự nhiên và Vitamin B3 giúp loại bỏ nhẹ nhàng các tế bào da già cỗi còn sót lại trên bề mặt da, cho bạn gái một chất da mịn màng và mềm mượt.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e- Đặc tính dưỡng sáng: Thành phần chứa AHA chiết xuất từ các loại trái cây đào thải tế bào già nua và duy trì một làn da láng mịn.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" alt=\"sữa rửa mặt sinh học đa năng Detox Blanc dưỡng trắng kiềm nhờn\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cdiv id=\"hieuquasudung\" class=\"\"\u003e\n\u003cp\u003e\u003cstrong\u003eCÔNG DỤNG VƯỢT TRỘI CỦA SỮA RỬA MẶT SINH HỌC ĐA NĂNG DETOX\u003c/strong\u003e\u003c/p\u003e\n\u003c/div\u003e\n\u003cp style=\"text-align: justify;\"\u003e- Làm sạch tận sâu bên trong lỗ chân lông, loại bỏ hết các chất cặn bã, giúp da luôn căng mịn.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e- Đánh tan bã nhờn và mụn đầu đen\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e- Thu nhỏ lỗ chân lông giúp da săn chắc và mịn màng.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e- Giúp da tăng khả năng ngăn chặn việc phát sinh mụn.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e- Loại bỏ hoàn toàn các tế bào chết và duy trì một làn da láng mịn.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e- Hỗ trợ cải thiện tình trạng da xỉn màu và nâu xám từ giai đoạn tẩy trang ban đầu.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e- Khả năng chống lại oxy hóa của vitamin giúp tái sinh làn da trở nên sáng sạch và tươi trẻ.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e- Tối đa hóa hiệu quả dưỡng ẩm giúp cho làn da được dưỡng ẩm tức sau khi sử dụng.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e- Giúp giảm thiểu hóa tác dụng phụ gây dị ứng, đặc biệt là đối với những người có làn da nhạy cảm.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" alt=\"sữa rửa mặt sinh học đa năng Detox BlanC dưỡng trắng da\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTHÀNH PHẦN TỰ NHIÊN NỔI BẬT TRONG SỮA RỬA MẶT SINH HỌC ĐA NĂNG CLEAR SKIN CONTROL THẾ HỆ MỚI\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" alt=\"sữa rửa mặt sinh học đa năng Detox BlanC dưỡng trắng da\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e- Chiết xuất lá lô hội: Làm sạch sâu, cung cấp độ ẩm liên tục, giảm sắc tố nám trên da, chống nắng cho da\u003c/p\u003e\n\u003cp\u003e- B3: Cải thiện cấu trúc da, đẩy lui sự xuất hiện của các tế bào melanin, làm da sáng hồng rạng rỡ, làm mờ các đốm nâu, thâm nám, ngăn ngừa mụn\u003c/p\u003e\n\u003cp\u003e- Đường mía: Giữ da sạch hơn, ngăn ngừa mụn xuất hiện, giảm mụn sưng tấy, chống lão hóa và dưỡng ẩm cho da.\u003c/p\u003e\n\u003cp\u003e- AHA: Ngăn ngừa mụn, giảm vết thâm, hỗ trợ điều trị thâm mụn sẹo mụn, xoá các vết nhăn li ti, làm căng và mịn da\u003c/p\u003e\n\u003cp\u003e- Axit trái cây xanh: Làm tiêu lớp sừng trên da.đẩy nhanh quá trình tái tạo tế bào da giúp nuôi dưỡng biểu bì da để tăng sự mềm, mịn cho da.\u003c/p\u003e\n\u003cp\u003e- Axit hữu cơ thải độc chì: Lấy đi những khói bụi, độc tố làm sáng da, đồng thời ức chế sự hình thành melanin mới.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cdiv id=\"hieuquasudung\" class=\"\"\u003e\n\u003cp\u003e\u003cstrong\u003eHƯỚNG DẪN SỬ DỤNG SỮA RỬA MẶT SINH HỌC ĐA NĂNG CLEAR SKIN CONTROL HIỆU QUẢ\u003c/strong\u003e\u003c/p\u003e\n\u003c/div\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eBước 1: Lấy một lượng vừa đủ ra lòng bàn tay và xoa nhẹ với nước để tạo bọt \u003c/p\u003e\n\u003cp\u003eBước 2: Thoa nhẹ và mát xa khắp mặt \u003c/p\u003e\n\u003cp class=\"chu-thich\"\u003eBước 3: Rửa mặt sạch lại bằng nước.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/4f/b6/68/7a79700bfca6c5b2c3592aa3f603fcda.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/4f/b6/68/7a79700bfca6c5b2c3592aa3f603fcda.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/4f/b6/68/7a79700bfca6c5b2c3592aa3f603fcda.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4f/b6/68/7a79700bfca6c5b2c3592aa3f603fcda.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4f/b6/68/7a79700bfca6c5b2c3592aa3f603fcda.png"},{"base_url":"https://salt.tikicdn.com/ts/product/f8/54/c2/bf9e30cd6afcc5fc7f2d97703b19cdf1.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f8/54/c2/bf9e30cd6afcc5fc7f2d97703b19cdf1.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f8/54/c2/bf9e30cd6afcc5fc7f2d97703b19cdf1.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f8/54/c2/bf9e30cd6afcc5fc7f2d97703b19cdf1.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f8/54/c2/bf9e30cd6afcc5fc7f2d97703b19cdf1.png"},{"base_url":"https://salt.tikicdn.com/ts/product/4f/18/8b/949bec084236db4d888f202c55aaed14.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/4f/18/8b/949bec084236db4d888f202c55aaed14.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/4f/18/8b/949bec084236db4d888f202c55aaed14.png","positi