dth":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":43000,"discount_rate":36,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/42/d8/65/6fe7f3a3dd6dfc7ee0ef45c98822dad5.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1108,"all_time_quantity_sold":14,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3 style=\"margin:3.75pt 0in 9pt;color:#242424;font-family:Roboto, Helvetica, Arial, sans-serif;font-size:13px;text-align:justify;\"\u003e\u003cspan style=\"font-size:16pt;font-family:Helvetica, sans-serif;\"\u003eChất Liệu\u003c/span\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli style=\"color:#242424;font-family:Roboto, Helvetica, Arial, sans-serif;font-size:13px;text-align:justify;\"\u003e\u003cspan style=\"font-size:16pt;\"\u003eBàn cờ vua nam châm làm bằng nhựa nguyên sinh có kim loại và có thể gấp gọn, với khóa cài chắc chắn đảm bảo không làm rơi rớt  các quân cờ bên trong.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"color:#242424;font-family:Roboto, Helvetica, Arial, sans-serif;font-size:13px;text-align:justify;\"\u003e\u003cspan style=\"font-size:16pt;\"\u003eBề mặt bàn cờ được thiết kế với màu sắc Xám Đen nổi bật, được xử lý bề mặt giúp người chơi nhìn rõ được các quân cờ, và dễ dàng điều khiển hơn.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"color:#242424;font-family:Roboto, Helvetica, Arial, sans-serif;font-size:13px;text-align:justify;\"\u003e\u003cspan style=\"font-size:16pt;font-family:Helvetica, sans-serif;\"\u003e\u003cspan style=\"font-size:16pt;\"\u003eBảo quản sản phẩm nơi khô ráo, tránh tiếp xúc trực tiếp với ánh nắng.\u003c/span\u003e\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"margin:3.75pt 0in 9pt;color:#242424;font-family:Roboto, Helvetica, Arial, sans-serif;font-size:13px;text-align:justify;\"\u003e \u003c/p\u003e\n\u003ch3 style=\"margin:3.75pt 0in 9pt;color:#242424;font-family:Roboto, Helvetica, Arial, sans-serif;font-size:13px;text-align:justify;\"\u003e\u003cspan style=\"font-size:16pt;font-family:Helvetica, sans-serif;\"\u003eĐặc Điểm Nổi Bật\u003c/span\u003e\u003c/h3\u003e\n\u003cp style=\"margin:5px 0px 12px;color:#242424;font-family:Roboto, Helvetica, Arial, sans-serif;font-size:13px;text-align:justify;\"\u003e \u003c/p\u003e\n\u003cul\u003e\n\u003cli style=\"color:#242424;font-family:Roboto, Helvetica, Arial, sans-serif;font-size:13px;text-align:justify;\"\u003e\u003cspan style=\"font-size:16pt;font-family:Helvetica, sans-serif;\"\u003eBộ Bàn Cờ Vua Cỡ To  bao gồm 1 bàn cờ nhựa và 32 quân cờ, với 2 màu sắc Vàng – Bạc sang trọng. Quân cờ được làm từ chất liệu nhựa cao cấp, bền đẹp và sáng bóng. Đặc biệt có nam châm giúp cho  quân cờ luôn đứng vững không đổ hay bị xê dịch.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"color:#242424;font-family:Roboto, Helvetica, Arial, sans-serif;font-size:13px;text-align:justify;\"\u003e\u003cspan style=\"font-size:16pt;font-family:Helvetica, sans-serif;\"\u003eBộ Bàn Cờ Vua Cỡ To  được thiết kế đặc biệt, khi gấp gọn lại sẽ thành khối vuông Cỡ To, bạn có thể xếp gọn gàng vào hộp sau khi chơi, thuận tiện cho việc di chuyển và cất giữ. Bạn có thể chơi cờ ngay tại nhà với gia đình, hoặc mang theo khi đi du lịch để giải trí cùng bạn bè, đồng nghiệp.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"color:#242424;font-family:Roboto, Helvetica, Arial, sans-serif;font-size:13px;text-align:justify;\"\u003e\u003cspan style=\"font-size:16pt;\"\u003eĐặc biệt, hộp cờ cũng chính là bàn cờ, vì thế bạn có thể mang cờ đi đến nhiều nơi để giải trí mà không phải mang vác quá cồng kềnh, bạn chỉ cần mở hộp cờ, đặt các quân cờ lên và bắt đầu chơi.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3 style=\"margin:3.75pt 0in 9pt;color:#242424;font-family:Roboto, Helvetica, Arial, sans-serif;font-size:13px;text-align:justify;\"\u003e\u003cspan style=\"font-size:16pt;font-family:Helvetica, sans-serif;\"\u003e\u003cbr /\u003eHướng Dẫn Cách Chơi\u003c/span\u003e\u003c/h3\u003e\n\u003cp style=\"margin:3.75pt 0in 9pt;color:#242424;font-family:Roboto, Helvetica, Arial, sans-serif;font-size:13px;text-align:justify;\"\u003e \u003c/p\u003e\n\u003cul\u003e\n\u003cli style=\"color:#242424;font-family:Roboto, Helvetica, Arial, sans-serif;font-size:13px;text-align:justify;\"\u003e\u003cspan style=\"font-size:16pt;font-family:Helvetica, sans-serif;\"\u003eVua (ký hiệu Vua là K): Là quân cờ quan trọng nhất bàn cờ. Nếu để mất vua thì coi như thua ván chơi. Vua đi mỗi nước một ô (trừ trường hợp nhập thành), có thể đi ngang, đi dọc hoặc đi chéo. Mỗi lần di chuyển vua có thể ăn quân của đối phương nhưng không được đi vào vị trí quân của mình đang đứng\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"color:#242424;font-family:Roboto, Helvetica, Arial, sans-serif;font-size:13px;text-align:justify;\"\u003e\u003cspan style=\"font-size:16pt;font-family:Helvetica, sans-serif;\"\u003eHậu (ký hiệu Vua Q): Đi ngang, đi dọc, đi chéo khắp bàn cờ. Hậu có thể ăn quân đối phương trên đường đi, nhưng không được phép đi vào vị trí quân mình đang đứng.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"color:#242424;font-family:Roboto, Helvetica, Arial, sans-serif;font-size:13px;text-align:justify;\"\u003e\u003cspan style=\"font-size:16pt;font-family:Helvetica, sans-serif;\"\u003eTượng (ký hiệu Vua B): Di chuyển theo đường chéo với ô có cùng màu. Tượng di chuyển tới ô còn trống, không có quân cản giữa đường hoặc di chuyển tới ô bị quân đối phương chiếm giữ (ăn quân)\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"color:#242424;font-family:Roboto, Helvetica, Arial, sans-serif;font-size:13px;text-align:justify;\"\u003e\u003cspan style=\"font-size:16pt;font-family:Helvetica, sans-serif;\"\u003eMã (ký hiệu Vua N): Đi ngang 2 ô và đi dọc 1 ô ( hoặc đi dọc 2 ô và đi ngang 1 ô) cho mỗi nước đi theo dạng hình chữ L. Mã có thể di chuyển tới ô còn trống hay ô bị quân đối phương chiếm giữ (ăn quân). Quân mã không bị cản như trong cờ Tướng.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"color:#242424;font-family:Roboto, Helvetica, Arial, sans-serif;font-size:13px;text-align:justify;\"\u003e\u003cspan style=\"font-size:16pt;font-family:Helvetica, sans-serif;\"\u003eXe (ký hiệu Vua R): Đi ngang hoặc dọc khắp bàn cờ miễn không có quân khác cản trên đường đi. Hoặc di chuyển tới vị trí quân đối phương đang chiếm giữ nhưng không được vượt qua quân đang đứng ở ô đó (trừ trường hợp nhập thành)\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"color:#242424;font-family:Roboto, Helvetica, Arial, sans-serif;font-size:13px;text-align:justify;\"\u003e\u003cspan style=\"font-size:16pt;font-family:Helvetica, sans-serif;\"\u003eTốt (không có ký hiệu): Di chuyển thẳng về phía trước, mỗi nước đi tới một ô còn trống. Riêng nước đi đầu tiên có thể đi 2 ô tùy ý. Tốt ăn quân theo đường chéo. Đặc biệt nếu tốt đi tới ô cuối cùng của đối phương thì sẽ được phong cấp thành Hậu hay các quân khác tùy chọn, nhưng không được phong cấp thành vua.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3 style=\"margin:3.75pt 0in 9pt;color:#242424;font-family:Roboto, Helvetica, Arial, sans-serif;font-size:13px;text-align:justify;\"\u003e\u003cspan style=\"font-size:16pt;font-family:Helvetica, sans-serif;\"\u003eThông Tin Chi Tiết\u003c/span\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli style=\"color:#242424;font-family:Roboto, Helvetica, Arial, sans-serif;font-size:13px;text-align:justify;\"\u003e\u003cspan style=\"font-size:16pt;font-family:Helvetica, sans-serif;\"\u003eCỜ VUA QUỐC TẾ 6 (SATO 059)- Kích thước: 19,3×19,3×1,5 cm\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"color:#242424;font-family:Roboto, Helvetica, Arial, sans-serif;font-size:13px;text-align:justify;\"\u003e\u003cspan style=\"font-size:16pt;font-family:Helvetica, sans-serif;\"\u003eKhối lượng: 500 gram\u003cbr /\u003e\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"color:#242424;font-family:Roboto, Helvetica, Arial, sans-serif;font-size:13px;text-align:justify;\"\u003e\u003cspan style=\"font-size:16pt;font-family:Helvetica, sans-serif;\"\u003eChi tiết: 33 ( 1 bàn cờ, 32 quân cờ vua chia đều cho 2 màu trắng và đen được gắn nam châm)\u003cbr /\u003e\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"color:#242424;font-family:Roboto, Helvetica, Arial, sans-serif;font-size:13px;text-align:justify;\"\u003e\u003cspan style=\"font-size:16pt;font-family:Helvetica, sans-serif;\"\u003eSản phẩm phù hợp với các bé từ 6 tuổi trở lên\u003cbr /\u003e\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"color:#242424;font-family:Roboto, Helvetica, Arial, sans-serif;font-size:13px;text-align:justify;\"\u003e\u003cspan style=\"font-size:16pt;font-family:Helvetica, sans-serif;\"\u003eChất liệu : Nhựa nguyên sinh\u003cbr /\u003e\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"color:#242424;font-family:Roboto, Helvetica, Arial, sans-serif;font-size:13px;text-align:justify;\"\u003e\u003cspan style=\"font-size:16pt;font-family:Helvetica, sans-serif;\"\u003eThương hiệu: SATO\u003cbr /\u003e\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"color:#242424;font-family:Roboto, Helvetica, Arial, sans-serif;font-size:13px;text-align:justify;\"\u003e\u003cspan style=\"font-size:16pt;font-family:Helvetica, sans-serif;\"\u003eXuất xứ: Việt Nam\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/42/d8/65/4259544264fcd5c82981ec3e22cb7652.jpg\" alt=\"\" width=\"750\" height=\"562\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki 