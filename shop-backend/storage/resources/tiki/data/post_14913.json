lor":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":3,"review_count":4,"review_text":"(4)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/media/catalog/product/c/r/cr--0661-o.u2769.d20160929.t120541.752604.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":0,"all_time_quantity_sold":17,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003eThiết kế sang trọng, tinh tế\u003c/h3\u003e\r\n\u003cp\u003eNồi cơm điện Cuckoo CR- 0661-O được thiết kế tinh tế, kiểu dáng hiện đại và sang trọng, kết hợp hai màu trắng - cam làm nổi bật không gian sử dụng. Thiết kế tay cầm chắc chắn, cách nhiệt và được gài chặt với phần thân nồi giúp bạn dễ dàng di chuyển hoặc nhấc lên, đặt xuống\u003c/p\u003e\r\n\u003cp\u003eSản phẩm có kích thước nhỏ gọn, dung tích 1 lít, đáp ứng nhu cầu cho gia đình có từ 3 - 4 thành viên.\u003c/p\u003e\r\n\u003cp style=\"text-align: center;\"\u003e\u003cimg title=\"Nồi Cơm Điện Nắp Gài Cuckoo CR- 0661-O - 1L\" src=\"http://tikicdn.com/media/catalog/product/c/r/cr--0661-o_1.u2769.d20160929.t120552.497309.jpg\" alt=\"Nồi Cơm Điện Nắp Gài Cuckoo CR- 0661-O - 1L\" width=\"650\" height=\"433\" /\u003e\u003c/p\u003e\r\n\u003ch3\u003eLòng nồi 3 lớp chống dính\u003c/h3\u003e\r\n\u003cp\u003eChất liệu lòng nồi hợp kim nhôm 3 lớp chống dính cao cấp siêu bền, không những giúp giữ ấm lâu, an toàn cho sức khỏe mà còn giúp chị em nội trợ dễ dàng vệ sinh sau khi sử dụng. Ngoài ra, lớp vỏ được làm từ chất liệu nhựa cao cấp cho độ sáng bóng cao, có khả năng chịu lực và chịu nhiệt tốt, nên bạn có thể yên tâm về độ bền và sự an toàn của sản phẩm.\u003c/p\u003e\r\n\u003cp style=\"text-align: center;\"\u003e\u003cimg title=\"Nồi Cơm Điện Nắp Gài Cuckoo CR- 0661-O - 1L\" src=\"http://tikicdn.com/media/catalog/product/c/r/cr--0661-o_3.u2769.d20160929.t120552.567239.jpg\" alt=\"Nồi Cơm Điện Nắp Gài Cuckoo CR- 0661-O - 1L\" width=\"650\" height=\"433\" /\u003e\u003c/p\u003e\r\n\u003ch3\u003eCơ chế gia nhiệt 4 chiều\u003c/h3\u003e\r\n\u003cp\u003eNồi cơm điện Cuckoo CR- 0661-O chính hãng có thiết kế cơ chế gia nhiệt 4 chiều, có tác dụng tỏa nhiệt đều và giữ nhiệt lâu hơn. Sau khi cơm được nấu chín sẽ tự động chuyển sang chế độ giữ ấm, nhờ lớp bông thủy tinh mà nồi có khả năng giữ ấm lên đến nhiều giờ, nên bạn và gia đình có thể thoải mái thưởng thức bữa cơm nóng dẻo, ngon miệng.\u003c/p\u003e\r\n\u003cp style=\"text-align: center;\"\u003e\u003cimg title=\"Nồi Cơm Điện Nắp Gài Cuckoo CR- 0661-O - 1L\" src=\"http://tikicdn.com/media/catalog/product/c/r/cr--0661-o_4.u2769.d20160929.t120552.613968.jpg\" alt=\"Nồi Cơm Điện Nắp Gài Cuckoo CR- 0661-O - 1L\" width=\"650\" height=\"433\" /\u003e\u003c/p\u003e\r\n\u003ch3\u003eDễ dàng sử dụng và vệ sinh\u003c/h3\u003e\r\n\u003cp\u003eSản phẩm trang bị một nút gạt (nấu/hâm nóng) và đèn báo tín hiệu, giúp bạn dễ dàng sử dụng và quan sát.\u003c/p\u003e\r\n\u003cp style=\"text-align: center;\"\u003e\u003cimg title=\"Nồi Cơm Điện Nắp Gài Cuckoo CR- 0661-O - 1L\" src=\"http://tikicdn.com/media/catalog/product/c/r/cr--0661-o_9.u2769.d20160929.t120552.755171.jpg\" alt=\"Nồi Cơm Điện Nắp Gài Cuckoo CR- 0661-O - 1L\" width=\"650\" height=\"433\" /\u003e\u003c/p\u003e\r\n\u003cp\u003eThiết kế dây điện được dấu dưới đáy nồi, bạn có thể quấn dây gọn gàng để cất giữ sau khi sử dụng. Thiết kế lòng nồi có thể tháo rời, giúp người dùng có thể vệ sinh dễ dàng và nhanh chóng.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/media/catalog/product/c/r/cr--0661-o.u2769.d20160929.t120541.752604.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/c/r/cr--0661-o.u2769.d20160929.t120541.752604.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/c/r/cr--0661-o.u2769.d20160929.t120541.752604.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/c/r/cr--0661-o.u2769.d20160929.t120541.752604.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/c/r/cr--0661-o.u2769.d20160929.t120541.752604.jpg"},{"base_url":"https://salt.tikicdn.com/media/catalog/product/c/r/cr--0661-o_2.u2769.d20160929.t120552.537693.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/c/r/cr--0661-o_2.u2769.d20160929.t120552.537693.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/c/r/cr--0661-o_2.u2769.d20160929.t120552.537693.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/c/r/cr--0661-o_2.u2769.d20160929.t120552.537693.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/c/r/cr--0661-o_2.u2769.d20160929.t120552.537693.jpg"},{"base_url":"https://salt.tikicdn.com/media/catalog/product/c/r/cr--0661-o_6.u2769.d20160929.t120552.671611.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/c/r/cr--0661-o_6.u2769.d20160929.t120552.671611.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/c/r/cr--0661-o_6.u2769.d20160929.t120552.671611.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/c/r/cr--06