o":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/media/catalog/product/h/i/hinh.u4939.d20170925.t091351.687421.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2543,"all_time_quantity_sold":35,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/84/07/5a/fbad0044dde7f5b9744bc957bc307f2c.png\" alt=\"Giáo Trình Hán Ngữ Tập 1: Quyển Hạ (Phiên Bản Mới) - Kèm CD Hoặc Dùng App\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp\u003eBạn học tiếng Trung nhưng những vấn đề trên lại đang cản bước bạn chinh phục ngôn ngữ này. Bạn có muốn tìm ra giải quyết những vấn đề này càng sớm càng tốt không? Nếu có hãy học ngay với cuốn sách “Giáo trình Hán ngữ tập 2 phiên bản mới” của Đại học ngôn ngữ Bắc Kinh.\u003c/p\u003e\n\u003cp\u003eVì sao các bạn nên học cùng cuốn sách này?\u003c/p\u003e\n\u003cp\u003eTrình bày khoa học phù hợp với các bạn tự nghiên cứu\u003c/p\u003e\n\u003cp\u003eVới những bạn đang tự học tiếng Trung hoặc tự ôn luyện sau những giờ học trên lớp thì cuốn sách này hoàn toàn phù hợp. Các bài học được biên soạn theo chương trình thống nhất, phù hợp với trình độ Sơ cấp, các kiến thức đều ở mức cơ bản nhất.\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eBài khóa\u003c/li\u003e\n\u003cli\u003eTừ mới\u003c/li\u003e\n\u003cli\u003eChú thích\u003c/li\u003e\n\u003cli\u003eNgữ pháp, ngữ âm\u003c/li\u003e\n\u003cli\u003eLuyện tập\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eHệ thống ngữ pháp và từ mới theo từng bài\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eSo với tập 1, tập 2 với hệ thống ngữ pháp khó hơn và lượng từ mới nhiều hơn rất nhiều. Hệ thống từ vựng bám sát theo từng chủ đề, mỗi bài các bạn được học từ 30 – 40 từ vựng liên quan đến chủ đề. Ngoài ra ở cuối sách còn có bảng từ vựng cung cấp gần 372 từ vựng đủ cho những người mới học.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eGiúp người học phát triển đồng thời cả 4 kỹ năng\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eSau khi học xong tập 1 các bạn đã nắm chắc được các kỹ năng phát âm cơ bản. Tập 2 này các bạn sẽ được ứng dụng các kiến thức đã học một cách tối đa qua các đoạn hội thoại có độ dài và khó cao hơn tập 1.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/media/catalog/product/h/i/hinh.u4939.d20170925.t091351.687421.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/h/i/hinh.u4939.d20170925.t091351.687421.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/h/i/hinh.u4939.d20170925.t091351.687421.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/h/i/hinh.u4939.d20170925.t091351.687421.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/h/i/hinh.u4939.d20170925.t091351.687421.jpg"}],"warranty_policy":null,"authors":[{"id":4043,"name":".","slug":""}],"current_seller":{"id":10914,"sku":"2788220141557","name":"trungthanh2018","link":"https://tiki.vn/cua-hang/trungthanh2018","logo":"a7/54/06/bad90228783e18b51eeff7187fadb302.jpg","price":116000,"product_id":"26136036","store_id":10648,"is_best_store":