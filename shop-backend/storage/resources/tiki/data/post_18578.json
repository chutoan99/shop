de":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/98/9b/99/a070499e68aa6662a4d726d6e28bc655.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1178,"all_time_quantity_sold":5,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003e\u003cspan style=\"color: #ff0000;\"\u003eHỘP QUÀ TẶNG BÀ BẦU VÀ SAU SINH GIÚP PHỤC HỒI SỨC KHỎE, CHĂM SÓC CƠ THỂ TỪ COCAYHOALA - COMBO DẦU GỘI XẢ GỪNG, SỮA TẮM GỪNG AN TOÀN, LÀNH TÍNH, NGĂN NGỪA RỤNG TÓC VÀ MỜ THÂM RẠN (\u003c/span\u003e\u003c/strong\u003e\u003cem\u003e\u003cspan style=\"color: #ff0000;\"\u003eSản phẩm bao gồm hộp quà như hình, hoa lụa và phụ kiện có thể khác màu tùy đợt nhập hàng nhưng chất lượng tương đương\u003c/span\u003e\u003c/em\u003e\u003cstrong\u003e\u003cspan style=\"color: #ff0000;\"\u003e)\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cspan style=\"color: #ff0000;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/67/9a/2f/d0bac93139c3d2a9b70427ec68a4e585.jpg\" alt=\"\" width=\"750\" height=\"1000\" /\u003e\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e9 tháng 10 ngày mang nặng đẻ đau, rồi thêm những tháng ngày kiêng cữ vất vả. Nhiều lúc chỉ thèm được giây phút *lạc trôi* vào Spa để được nghỉ ngơi.\u003cbr /\u003eThích mùi GỪNG, yêu mùi SẢ. Thích hòa mình vào thiên nhiên để bớt mệt nhoài những đêm tắc sữa, những đêm con dậy khóc đòi mẹ ẵm bồng.\u003cbr /\u003eDầu gội Gừng - Sữa tắm Gừng được sinh ra trên nền tảng tình yêu đó, tình yêu dành cho sự hy sinh vô bờ bến của những người MẸ.\u003cbr /\u003eBản thân mình cùng từng trải qua thời gian kinh khủng sau sinh, với ám ảnh #Rụngtóc, cho con bú nên #Khôtóc, cả năm tóc dài được 2cm.\u003cbr /\u003eCơ thể lúc nào cũng thấy mùi chua của sữa, mùi hôi của tã bỉm đồ ăn.\u003cbr /\u003eBộ quà tặng Dầu gội Gừng - Sữa tắm Gừng Nghệ chính là món quà mà bà bầu và mẹ sau sinh nào cũng mong muốn được sở hữu.\u003cbr /\u003e--------------------------------------------------------------\u003cbr /\u003e\u003cspan style=\"color: #ff0000;\"\u003e\u003cstrong\u003eDẦU GỘI GỪNG LÀM ẤM DA ĐẦU, GIẢM RỤNG CHO MẸ SAU SINH. CHAI 500ML\u003c/strong\u003e\u003c/span\u003e\u003cbr /\u003eThành phần có chứa: 90% GỪNG TƯƠI nguyên chất được say nhuyễn, kết hợp cùng tinh dầu hoa cúc, tinh dầu hướng dương, chiết xuất lá bạc hà, quả mâm xôi.\u003cbr /\u003eDầu gội Gừng còn nguyên vụn, xơ Gừng trong dầu gội =\u0026gt; Thực sự dùng Gừng tươi tự nhiên chứ không chỉ sử dụng \"hương liệu Gừng\" như các loại dầu gội khác.\u003cbr /\u003eĐem lại cảm giác Ấm nóng và thư thái dễ chịu như đang ở spa khi gội và mátxa da đầu từ 5-10 phút, do tinh dầu Gừng nguyên chất mới làm được điều này. Từ đó tinh dầu gừng thấm sau vào chân tóc và da đầu =\u0026gt; Giúp lưu thông khí huyết =\u0026gt; mầm tóc được nuôi dưỡng tốt hơn =\u0026gt; Tóc chắc khỏe hơn.\u003cbr /\u003eGiữ ấm cho mẹ sau sinh, người hay cảm lạnh,\u003cbr /\u003eĐộ đậm đặc hơn hẳn so với các loại dầu gội khác trên thị trường =\u0026gt; mỗi lần gội chỉ cần dùng 1 lượng bằng 1/2 hoặc 2/3 so với dầu gội thông thường mà vẫn sạch. \u003cbr /\u003eCác tinh chất của gừng hoạt động như một chất điều chỉnh bã nhờn, hiệu chỉnh sự oxy hóa của tóc. Vì vậy tóc sẽ rất bông mềm sau khi sử dụng dầu gội gừng Cỏ cây Hoa Lá.\u003cbr /\u003e----------------------------------------------------------\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003e\u003cspan style=\"color: #ff0000;\"\u003e\u003cstrong\u003eSỮA TẮM CHỐNG CẢM LẠNH, TRẮNG DA CHO MẸ BẦU VÀ SAU SINH TỪ GỪNG - NGHỆ . CHAI 300ML\u003c/strong\u003e\u003c/span\u003e\u003cbr /\u003eTừ nay không phải hạ thổ gừng nghệ trong 3 tháng 10 ngày nữa, mẹ bầu đã có sưã tắm Gừng Nghệ hoàn toàn từ thiên nhiên giúp làm đẹp da, se khít lỗ chân lông và chống cảm, làm ấm cơ thể sau sinh.\u003cbr /\u003eĐặc biệt có thể dùng cho trẻ nhỏ, cho người già, cho cả gia đình giúp giải tỏa căng thẳng, chống cảm lạnh.\u003c/p\u003e\n\u003cp\u003e- Chiết xuất từ Gừng, Nghệ, dầu Oliu, dầu hạt Nho, chiết xuất Chanh, Táo.\u003cbr /\u003e- Không hóa chất độc hại\u003cbr /\u003e- Tránh gió, chống cảm, dưỡng da\u003cbr /\u003e- Làm sạch và ngăn ngừa viêm tắc chân lông\u003cbr /\u003e- Dưỡng trắng da, cung cấp độ ẩm giúp làn da căng mịn, trắng sáng một cách tự nhiên.\u003cbr /\u003e- Liền sẹo, làm mờ vết thâm trên cơ thể.\u003cbr /\u003e- An toàn cho trẻ nhỏ, mẹ bầu và mẹ sau sinh\u003c/p\u003e\n\u003cp\u003e#quatang #quatangbabau #quatangmesausinh #chamsocsausinh #babau\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/98/9b/99/a070499e68aa6662a4d726d6e28bc655.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/98/9b/99/a070499e68aa6662a4d726d6e28bc655.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/98/9b/99/a070499e68aa6662a4d726d6e28bc655.j