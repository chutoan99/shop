n sách của mọi thời đại (2003), 100 cuốn sách giá trị nhất (2007) do BBC và trang web worldbookday bầu chọn.\u003c/div\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/a0/f0/f3/b9208b363f07cf03bc8f1cd5501ea437.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a0/f0/f3/b9208b363f07cf03bc8f1cd5501ea437.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a0/f0/f3/b9208b363f07cf03bc8f1cd5501ea437.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a0/f0/f3/b9208b363f07cf03bc8f1cd5501ea437.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a0/f0/f3/b9208b363f07cf03bc8f1cd5501ea437.png"}],"warranty_policy":null,"authors":[{"id":4476,"name":"Richard Adams","slug":""}],"current_seller":{"id":126688,"sku":"4902784967272","name":"info book","link":"https://tiki.vn/cua-hang/info-book","logo":"66/49/ce/c528ff3a6e4022b080c1f8c6fe7bc541.jpg","price":119000,"product_id":"274296666","store_id":117060,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[{"id":295057,"name":"HỆ THỐNG NHÀ SÁCH ABC","link":"https://tiki.vn/cua-hang/he-thong-nha-sach-abc","logo":"https://vcdn.tikicdn.com/ts/seller/98/3d/ff/cec0ba0eaa575634616ab4605fccbe6d.jpg","price":152000,"product_id":"274372116","store_id":282399},{"id":97533,"name":"Nhà Sách Vĩnh Thụy","link":"https://tiki.vn/cua-hang/nha-sach-vinh-thuy","logo":"https://vcdn.tikicdn.com/ts/seller/19/f2/bd/8bda12adffb15edf1b3d8339b0238283.jpg","price":152000,"product_id":"274863205","store_id":90454}],"specifications":[{"name":"Thông tin chung",