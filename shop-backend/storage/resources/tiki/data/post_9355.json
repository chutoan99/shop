eight":0,"text_color":"#FFF0F1","background_color":"#D93843","href":null,"text":"9.9"},{"placement":"pdp_badge","code":"is_hero","type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"freeship_xtra","type":"pdp_icon_badge","index":2,"icon":"https://salt.tikicdn.com/ts/upload/be/67/48/04a82ab8df178e1a13bde38316081865.png","icon_width":91,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":true,"return_reason":"any_reason"}},"discount":3687000,"discount_rate":17,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/a6/07/4e/ae047caec57b16f71abd1887bdd70b18.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":91,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3 style=\"text-align:justify;\"\u003eMàn hình cảm ứng, trải nghiệm như smartphone cỡ lớn\u003c/h3\u003e\n\u003cp style=\"text-align:justify;\"\u003eLG StanbyME 2K 27 inch 27ART10AKPL gây ấn tượng với kiểu dáng năng động, màn hình cảm ứng cho bạn điều khiển dễ dàng với 1 thao tác chạm nhẹ, đường nét tinh tế, cho vẻ ngoài cao cấp, thời thượng. \u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003eMàn hình 27 inch, xoay chỉnh đa hướng phù hợp với nhu cầu xem phim trong phòng ngủ, xem video dạy nấu ăn trong bếp hoặc mở nhạc ngoài trời để không khí bữa tiệc nhỏ thêm hào hứng,\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003c/p\u003e\n\u003ch3 style=\"text-align:justify;\"\u003eDi chuyển đến mọi nơi, sử dụng không dây trong thời gian đến 3 giờ\u003c/h3\u003e\n\u003cp style=\"text-align:justify;\"\u003eKhông giống với kiểu tivi truyền thống, mẫu tivi LG này tích hợp pin sạc cung cấp năng lượng cho bạn dùng trong thời gian dài ngay cả khi không kết nối với nguồn điện trực tiếp.\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003eĐặc biệt, thiết kế như quạt đứng, với bên dưới chân đế có trang bị các bánh xe cho phép người dùng chuyển đổi vị trí tivi linh hoạt, chỉ cần nắm chân đế kéo nhẹ là bạn có thể mang tivi từ phòng ngủ ra phòng khách ra đến ban công nhà mình tiện lợi.\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003c/p\u003e\n\u003ch3 style=\"text-align:justify;\"\u003eĐộ phân giải 2K cho hình ảnh hiển thị sắc nét đến từng chi tiết\u003c/h3\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003c/p\u003e\n\u003ch3 style=\"text-align:justify;\"\u003eCải thiện màu sắc, độ tương phản tối ưu qua công nghệ Active HDR\u003c/h3\u003e\n\u003cp style=\"text-align:justify;\"\u003eActive HDR phân tích các hình ảnh theo từng cấp độ sáng, chọn chi tiết phù hợp, kết hợp tạo thành một hình ảnh hoàn mỹ nhất để mang đến trải nghiệm xem tuyệt vời nhất cho bạn thưởng thức. \u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003c/p\u003e\n\u003ch3 style=\"text-align:justify;\"\u003eCải thiện trải nghiệm xem với bộ xử lý α7 Gen4 Al\u003c/h3\u003e\n\u003cp style=\"text-align:justify;\"\u003eCon chip mạnh mẽ này tự động nhận dạng nội dung và điều kiện ánh sáng xung quanh, tối ưu hóa thiết lập màn hình phù hợp, đảm bảo hình ảnh hiển thị sắc nét, chất lượng cao. \u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003eNgoài ra nó còn phân tích các nguồn âm thanh và tối ưu âm thanh theo nội dung bạn đang xem và vị trí của tivi trong căn phòng, trộn - nâng cấp những kênh âm thanh giúp mang đến chất âm tuyệt vời một cách toàn diện.\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003c/p\u003e\n\u003ch3 style=\"text-align:justify;\"\u003eNâng cấp chất lượng hình ảnh với công nghệ Image Enhancing \u003c/h3\u003e\n\u003cp style=\"text-align:justify;\"\u003eCông nghệ này mang đến khung hình với chất lượng cao bằng cách xử lý hình ảnh đầu vào thông qua các thuật toán chuyên sâu với trí thông minh nhân tạo. Ngoài ra, 27ART10AKPL còn có công nghệ Resolution Upscaler tăng cường độ phân giải cho hình ảnh rõ ràng, đẹp mắt hơn. \u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003c/p\u003e\n\u003ch3 style=\"text-align:justify;\"\u003eÂm thanh phù hợp với từng thể loại nhờ công nghệ AI Sound\u003c/h3\u003e\n\u003cp style=\"text-align:justify;\"\u003eChất âm được tinh chỉnh tương thích với nội dung xem cụ thể, đặc biệt, tivi hỗ trợ âm thanh vòm Ultra Surround, tổng công suất 10W tái tạo chất âm sống động, lan tỏa rộng để người nghe chìm đắm vào bộ phim, bản nhạc hay đang phát.\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003eChế độ Clear Voice III tự động nhận diện giọng nói, lọc tạp âm từ môi trường xung quanh để bạn nghe rõ lời thoại trong phim, không bỏ sót bất kỳ tình tiết gay cấn nào khi xem. \u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003c/p\u003e\n\u003ch3 style=\"text-align:justify;\"\u003eHệ điều hành webOS 6.0 dễ sử dụng\u003c/h3\u003e\n\u003cp style=\"text-align:justify;\"\u003eGiao diện trực quan cho người dùng quan sát và tùy chọn các chức năng, ứng dụng thuận tiện. Kho ứng dụng phong phú đáp ứng nhu cầu trải nghiệm đa dạng với mặc định là trình duyệt web và bạn có thể vào thư viện LG Store để tải thêm YouTube, VieON và nhiều ứng dụng tiện ích khác. \u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003c/p\u003e\n\u003ch3 style=\"text-align:justify;\"\u003eHỗ trợ kết nối không dây và có dây đa dạng\u003c/h3\u003e\n\u003cp style=\"text-align:justify;\"\u003eThiết kế có thể kết nối rảnh tay với điện thoại qua Bluetooth, Wifi hoặc phối ghép có dây thông qua cổng HDMI, USB để nghe nhạc, xem phim, hình ảnh thuận tiện. \u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003eLG StanbyME 2K 27 inch 27ART10AKPL đã cháy hàng ngay khi vừa ra mắt ở Hàn Quốc, mẫu mã độc đáo, có tính di động cao, màn hình 2K sắc nét, công nghệ âm thanh và hình ảnh cho trải nghiệm chân thật, màn hình cảm ứng dễ tùy chỉnh, kèm theo pin tích hợp cho bạn di chuyển và sử dụng ở bất kỳ nơi nào mình.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/a6/07/4e/ae047caec57b16f71abd1887bdd70b18.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a6/07/4e/ae047caec57b16f71abd1887bdd70b18.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a6/07/4e/ae047caec57b16f71abd1887bdd70b18.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a6/07/4e/ae047caec57b16f71abd1887bdd70b18.jpg","thu