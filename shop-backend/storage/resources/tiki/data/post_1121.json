m/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.6,"review_count":51,"review_text":"(51)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ec/e1/be/f25a2a46684a085f71d5afafd105b63d.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1474,"all_time_quantity_sold":339,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<h1><em><strong>Giới thiệu Kính bảo hộ mắt chuyên dụng chống hóa chất, bụi và chống tia UV 3M 3M-334</strong></em></h1>\n<p><strong><em>Kính bảo hộ mắt chuyên dụng chống hóa chất, bụi và chống tia UV 3M 3M-334</em></strong> chống hóa chất là dòng kính tinh tế, dễ sử dụng. Bảo vệ mắt trước nguy cơ bụi, sương, hơi hóa chất và yếu tố văng bắn.</p>\n<p>Dùng <em><strong>Kính bảo hộ mắt chuyên dụng chống hóa chất, bụi và chống tia UV 3M 3M-334 </strong></em>trong một số môi trường làm việc hóa chất, dầu khí, đóng tàu, cảng - ô tô, nhựa, gỗ, kim loại, dệt may, xây dựng, thực phẩm, dược phẩm… Và phù hợp với cả môi trường phòng thí nghiệm.</p>\n<p><strong>Sản phẩm đạt các chứng nhận bảo vệ mắt như ANSI Z87.1-2003</strong></p>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/78/d3/16/a158310028e797da83554ae400fb6ebf.jpg?v=1598413886832\" data-thumb=\"original\" /></p>\n<h2><strong>Thông tin sản phẩm</strong></h2>\n<ul>\n<li>Tên sản phẩm: <em><strong>Kính bảo hộ mắt chuyên dụng chống hóa chất, bụi và chống tia UV 3M 3M-334</strong></em></li>\n<li>Mã sản phẩm: <strong>3M-334</strong></li>\n<li>Màu tròng kính: Trong suốt</li>\n<li>Công dụng: Bảo vệ mắt khỏi nhiều tác hại khác nhau</li>\n<li>Chất liệu: Polycarbonate, nhựa PVC an toàn</li>\n<li>Thương hiệu: 3M - Mỹ</li>\n<li>Sản xuất: tại Trung Quốc</li>\n</ul>\n<h2><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/68/26/01/d6fe8fee0facce12ae1d5c205f941f20.jpg?v=1598413897359\" data-thumb=\"original\" /><br /><strong>Thông tin nổi bật</strong></h2>\n<ul>\n<li>Tròng kính bằng vật liệu Polycarbonate hấp thụ 99.9% UV, với khả năng chống va đập và chống vỡ vượt trội. Mặt kính được phủ lớp chống ngưng tụ hơi nước.</li>\n<li>Có khả năng chống văn bắn hoá chất với thiết kế ôm sát khuôn mặt.</li>\n<li>Được trang bị 4 khe thoát khí (2 ở trên, 2 ở hai bên) giúp giảm tình trạng tròng kính bị mờ do hơi nước, đồng thời với thiết kế khe thông minh giữ cho chất lỏng không bị thẩm thấu ngược. Có hệ thống thông hơi gián tiếp tạo sự thông thoáng.</li>\n<li>Đạt các chứng nhận bảo vệ mắt như ANSI Z87.1-2010 </li>\n<li>Sản phẩm có trọng lượng nhẹ, thiết kế ôm sát mặt, sống mũi mềm có thể điều chỉnh được, phù hợp với cả nam và nữ</li>\n<li>Đặc tính chống động sương của kính là tính năng hữu dụng khi mang kính kèm khẩu trang hoặc di chuyển trong mưa.</li>\n<li>Được dùng nhiều trong công việc tiếp xúc với hầu hết cái loại hóa chất</li>\n<li>Dây đeo bằng vật liệu thun đàn hồi có thể điều chỉnh qua đầu tạo độ kín khít, không làm rơi kính ra ngoài trong lúc di chuyển, thuận tiện hơn khi làm việc.</li>\n<li>Thiết kế Over-the-glass hỗ trợ đeo kính cận.</li>\n</ul>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/85/d3/8e/405c4619b975dae9f5c458fe22b7087d.jpg?v=1598413906708\" data-thumb=\"original\" /></p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ec/e1/be/f25a2a46684a085f71d5afafd105b63d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ec/e1/be/f25a2a46684a085f71d5afafd105b63d.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ec/e1/be/f25a2a46684a085f71d5afafd105b63d.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ec/e1/be/f25a2a46684a085f71d5afafd105b63d.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ec/e1/be/f25a2a46684a085f71d5afafd105b63d.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/ea/30/de/e7c232a6636a36f028c531c9d9eb1892.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ea/30/de/e7c232a6636a36f028c531c9d9eb1892.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ea/30/de/e7c232a6636a36f028c531c9d9eb1892.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ea/30/de/e7c232a6636a36f028c531c9d9eb1892.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ea/30/de/e7c232a6636a36f028c531c9d9eb1892.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/6f/ef/a8/e373cf9f31416cb6fa7d8412a9a733d4.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/6f/ef/a8/e373cf9f31416cb6fa7d8412a9a733d4.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/6f/ef/a8/e373cf9f31416cb6fa7d8412a9a733d4.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6f/ef/a8/e373cf9f31416cb6fa7d8412a9a733d4.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6f/ef/a8/e373cf9f31416cb6fa7d8412a9a733d4.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/d7/85/5b/500fe1a232b435273605754068c399b7.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d7/85/5b/500fe1a232b435273605754068c399b7