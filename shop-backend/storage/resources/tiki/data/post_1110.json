,"icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/20/8b/1f/23d8ab3a378e2dab2c5561c7a90ef374.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":260,"all_time_quantity_sold":12,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<h3>Giới thiệu</h3>\n<p>Máy ủ ấm khăn giấy ướt cho bé Warm 4 đã có thêm những cải tiến với công nghệ làm nóng ba chiều giúp làm nóng tổng thể đều và nhanh chóng, tăng độ hiệu quả với những cách làm nóng thông thường.</p>\n<h3>Thiết kế và công dụng</h3>\n<ul><li>Công nghệ làm nóng 3 chiều: làm nóng tổng thể đồng đều và nhanh chóng, hiệu quả tốt hơn là chỉ làm nóng từ phía trên hoặc chỉ làm nóng từ phía dưới.  </li><li>Có 3 cấp độ làm ấm khăn giấy ướt (35°C, 45°C, 55°C) tuỳ vào nhu cầu </li><li>Màn hình LED với nút cảm biến, dễ dàng sử dụng. </li><li>Giữ độ ẩm: Miếng đệm của nắp kín khít giữ ẩm và giữ nhiệt tốt. </li><li>Thiết kế chống rò rỉ: giữ vệ sinh và an toàn mọi lúc. </li><li>Dung tích lớn: phù hợp với tất cả các kích cỡ khăn giấy ướt trẻ em, </li><li>Tiết kiệm năng lượng và an toàn: chỉ tiêu thụ 20 W. </li><li>Đèn ngủ: với ánh sáng vàng ấm, đem lại cảm giác dễ chịu, thoải mái.</li></ul>\n<p> </p>\n<p><img title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/7d/bf/1b/398df05cee5952fe85a3efb5e4557071.png\" alt=\"\" width=\"1536\" height=\"1536\" /></p>\n<h3>Lưu ý sử dụng</h3>\n<ul><li><strong>KHÔNG</strong> cho sản phẩm vào nước để rửa. Không đặt nó vào máy tiệt trùng hơi nước để khử trùng.</li><li><strong>KHÔNG</strong> đặt sản phẩm ở nơi trẻ sơ sinh và trẻ nhỏ có thể với tới; vui lòng tắt nguồn nếu nó không được <strong>sử </strong>dụng trong một thời gian dài.</li><li>Nếu sản phẩm bị hỏng, không được tự tháo rời. Nó phải được sửa chữa hoặc thay thế bởi nhà sản xuất hoặc chuyên gia. Thiết bị này có thể được sử dụng bởi trẻ em từ 8 tuổi trở lên và những người bị suy giảm khả năng thể chất, giác quan hoặc tinh thần hoặc thiếu kinh nghiệm và kiến thức nếu họ đã được giám sát hoặc hướng dẫn về cách sử dụng thiết bị theo cách an toàn và hiểu các mối nguy hiểm bị liên lụy.</li><li>Trẻ em không được chơi với thiết bị. Trẻ em không được làm vệ sinh và bảo dưỡng nếu không <strong>có </strong>sự giám <strong>sát</strong>. Thiết bị này được thiết kế để sử dụng trong gia đình và các môi trường tương tự như: khu vực bếp của nhân viên trong cửa hàng, văn phòng và các môi trường làm việc khác; nhà trang trại; bởi khách hàng trong khách sạn, nhà nghỉ và các môi trường dân cư khác. Trước khi rút phích cắm, hãy đảm bảo rằng thiết bị đã được tắt.</li></ul>\n<h3>Thông số kĩ thuật.</h3>\n<ul><li>Điện áp: AC 220-240V, 50/60Hz. </li><li>Công suất: 20W. </li><li>Kích thước (DxRxC): 19,2× 23,7 x 13,7 (cm). </li></ul><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/20/8b/1f/23d8ab3a378e2dab2c5561c7a90ef374.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/20/8b/1f/23d8ab3a378e2dab2c5561c7a90ef374.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/20/8b/1f/23d8ab3a378e2dab2c5561c7a90ef374.png","position":null,"small_url":"https://salt.tikicdn.com/cache/