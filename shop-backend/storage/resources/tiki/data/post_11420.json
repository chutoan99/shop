ref":null,"text":"9.9"},{"placement":"pdp_badge","code":"is_hero","type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":true,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/2f/f6/d6/00b89e9c490ebb88a302545a691b5c7e.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1999,"all_time_quantity_sold":11,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<h3 style=\"margin: 0px; padding: 8px 0px; white-space: pre-wrap; text-align: center;\">VIÊN UỐNG BỔ SUNG NỘI TIẾT TỐ VÀ CẢI THIỆN SINH LÝ NỮ</h3>\n<p>Với sự kết hợp giữa các thành phần cải thiện nội tiết tố nữ và làm đẹp da cao cấp, Viên uống Cân Bằng Nội Tiết Tố, Cải Thiện Sinh Lý Marilyn là giải pháp hàng đầu dành cho phụ nữ trong giai đoạn tiền mãn kinh, mãn kinh, phụ nữ sau sinh và rối loạn nội tiết tố nữ.</p>\n<p>Không chỉ cải thiện sinh lý nữ, sản phẩm còn giảm thiểu các triệu chứng của tiền mãn kinh, mãn kinh như mất ngủ, bốc hỏa, rụng tóc, lo âu, đồng thời làm đẹp da, mờ thâm nám và bảo vệ tim mạch.</p>\n<h3 style=\"margin: 0px; padding: 8px 0px; white-space: pre-wrap; text-align: justify;\"><strong>HIỆU QUẢ RÕ RỆT CHỈ SAU 45 NGÀY SỬ DỤNG!</strong></h3>\n<p style=\"margin: 0px; padding: 8px 0px; white-space: pre-wrap;\"><img style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/83/a8/17/14f9113e85575b20f571bad1586ffb67.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<h3 style=\"margin: 0px; padding: 8px 0px; white-space: pre-wrap; text-align: justify;\"><strong>GENIVIDA - BÍ MẬT TẠO NÊN SỨC QUYẾN RŨ CỦA PHÁI ĐẸP</strong></h3>\n<p>Để cải thiện các vấn đề liên quan đến nội tiết, thông thường người ta sẽ nghĩ đến mầm đậu nành, bởi trong thành phần của nó có chứa genistein, một chất có tác dụng cân bằng nội tiết tố và cải thiện các vấn đề về sinh lý nữ. Tuy nhiên, bằng công nghệ vượt trội, các nhà khoa học đã tạo nên một thành phần mạnh mẽ và hiệu quả hơn nhiều so với mầm đậu nành truyền thống, đó là Genivida.</p>\n<p>Nếu hàm lượng genistein trong mầm đậu nành chỉ chiếm 5% thì Genivida chứa đến &gt;98,5% genistein, gấp 20 lần hàm lượng trong mầm đậu nành, do đó mang đến hiệu quả vượt trội và nhanh hơn hẳn.</p>\n<p style=\"margin: 0px; padding: 8px 0px; white-space: pre-wrap; text-align: justify;\"><img style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/cb/14/b3/d25f905f79bef9b7e0ca4450c5d16c16.jpg\" alt=\"\" width=\"750\" height=\"853\" /></p>\n<h3 style=\"margin: 0px; padding: 8px 0px; white-space: pre-wrap; text-align: justify;\"><strong>THÀNH PHẦN CỦA VIÊN UỐNG CÂN BẰNG NỘI TIẾT TỐ, CẢI THIỆN SINH LÝ NỮ MARILYN</strong></h3>\n<ul>\n<li style=\"white-space: pre-wrap; text-align: justify;\"><strong>Genivida</strong>: nhập khẩu từ hãng dược nổi tiếng DSM - Thụy Sĩ, được các chuyên gia hàng đầu trên thế giới công nhận hiệu quả vượt trội trong việc cải thiện các triệu chứng: khô hạn, giảm ham muốn, khó ngủ, bốc hỏa, căng thẳng, loãng xương, bệnh tim mạ cho phụ nữ.</li>\n<li style=\"white-space: pre-wrap; text-align: justify;\"><strong>Fish Collagen</strong>: <span data-key=\"50\">nhập khẩu từ Ý, giúp phục hồi cấu trúc da, trẻ hóa da, dưỡng ẩm và chống khô da, làm mờ nếp nhăn, chống lão hóa.</span></li>\n<li style=\"white-space: pre-wrap; text-align: justify;\"><strong>Omega-3</strong>: <span data-key=\"53\">dưỡng ẩm da, hỗ trợ hoạt động của hệ thần kinh và thị lực, tăng cường trí nhớ, bảo vệ hệ tim mạch, hạn chế nguy cơ mắc các chứng xơ vữa mạch, rối loạn nhịp </span></li>\n<li style=\"white-space: pre-wrap; text-align: justify;\"><strong>Vitamin E tự nhiên</strong>: c<span data-key=\"56\">hống lại quá trình lão hóa, duy trì làn da và vóc dáng trẻ trung, giúp da tóc mịn màng, giúp noãn (trứng) phát triển.</span></li>\n<li style=\"white-space: pre-wrap; text-align: justify;\"><span data-key=\"59\"><strong>Biotin</strong>: tăng cường sức khỏe cho tóc và móng, giảm tình trạng rụng tóc. </span></li>\n</ul>\n<p style=\"margin: 0px; padding: 8px 0px; white-space: pre-wrap; text-align: left;\"><img src=\"https://salt.tikicdn.com/ts/tmp/c3/2a/dc/8975deae1478952452ed616a93b01bbe.jpg\" alt=\"\" width=\"750\" height=\"750\" /><img src=\"https://salt.tikicdn.com/ts/tmp/18/79/d7/f07028d82b5e243604b08b8dcf6aa1f1.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<h3 style=\"margin: 0px; padding: 8px 0px; white-space: pre-wrap; text-align: justify;\"><strong>CÔNG DỤNG CỦA VIÊN UỐNG CÂN BẰNG NỘI TIẾT TỐ, CẢI THIỆN SINH LÝ NỮ MARILYN</strong></h3>\n<ul>\n<li style=\"white-space: pre-wrap; text-align: justify;\"><span data-key=\"25\">Giúp cải thiện sinh lý nữ. </span></li>\n<li style=\"white-space: pre-wrap; text-align: justify;\"><span data-key=\"28\">Làm chậm quá trình mãn kinh, giảm triệu chứng khó chịu giai đoạn tiền mãn kinh: bốc hỏa, mất ngủ, căng thẳng, mệt mỏ</span></li>\n<li style=\"white-space: pre-wrap; text-align: justify;\"><span data-key=\"31\">Giúp da sáng mịn, giảm nám (do nội tiết tố).</span></li>\n<li style=\"white-space: pre-wrap; text-align: justify;\"><span data-key=\"34\">Tăng cường độ chắc khỏe cho tóc và móng tay.</span></li>\n<li style=\"white-space: pre-wrap; text-align: justify;\"><span data-key=\"37\">Hỗ trợ bảo vệ tim mạch và xương khớp. </span></li>\n</ul>\n<h3 style=\"margin: 0px; padding: 8px 0px; white-space: pre-wrap; text-align: justify;\"><strong>ĐỐI TƯỢNG SỬ DỤNG</strong></h3>\n<ul>\n<li style=\"white-space: pre-wrap; text-align: justify;\"><span data-key=\"70\">Phụ nữ tiền mãn kinh, mãn kinh, suy giảm sinh lý dẫn tới các triệu chứng: khô hạn, bốc hỏa, mất ngủ, giảm ham muốn, tiểu đêm</span></li>\n<li style=\"white-space: pre-wrap; text-align: justify;\"><span data-key=\"73\">Phụ nữ da khô, nhăn, sạm da, rụng tó</span></li>\n</ul>\n<p><strong>HƯỚNG DẪN SỬ DỤNG</strong></p>\n<ul>\n<li style=\"white-space: pre-wrap; text-align: justify;\"><span data-key=\"78\">Dùng 2 viên/lần/ngày sau khi ăn. Nên sử dụng đủ liệu trình 3 hộp để cảm nhận rõ hiệu quả. </span></li>\n<li style=\"white-space: pre-wrap; text-align: justify;\"><span data-key=\"78\">Sau khi đã cải thiện hoàn toàn các triệu chứng, có thể chuyển sang liều 1 viên/ngày để duy trì hiệu quả liên tục hơn. </span></li>\n</ul>\n<h3 style=\"margin: 0px; padding: 8px 0px; white-space: pre-wrap; text-align: justify;\"><strong>MÔ TẢ SẢN </strong><strong>PHẨM</strong></h3>\n<ul>\n<li style=\"white-space: pre-wrap; text-align: justify;\"><span data-key=\"17\">Hộp thủy tinh 30 viên nang mềm.</span></li>\n</ul><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://s