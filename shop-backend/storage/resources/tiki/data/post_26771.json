olor":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":37500,"discount_rate":25,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/e8/06/c7/ed29146283807b3f69be39ff833dc05f.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":506,"all_time_quantity_sold":12,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003e\u003cem\u003eSÁCH NĂM THÁNG VỘI VÃ, THỈNH NGƯỜI TRÂN TRỌNG - SÁCH TÔNG GIÁO TÂM LINH CỦA TÁC GIẢ GIA THỐ ( GYATSO RINPOCHE ) - BỘ SÁCH DÀNH CHO NHỮNG AI ĐÃ, ĐANG VÀ SẼ TĨNH LẶNG - Á CHÂU BOOKS, BÌA CỨNG, IN MÀU \u003c/em\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cem\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/e8/06/c7/3ea5f0ebf76f194784fc4f009989ebf2.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/em\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003col\u003e\u003cli\u003e\u003cstrong\u003e\u003cem\u003eThông tin tác giả\u003c/em\u003e\u003c/strong\u003e\u003c/li\u003e\n\u003c/ol\u003e\u003cp\u003e\u003cem\u003eGia Thố (Gyatso Rinpoche) \u003c/em\u003eLà vị Phật sống của chùa Trát, Tây Tạng.\u003c/p\u003e\n\u003cp\u003eNăm 13 tuổi, Gyatso Rinpoche theo học tại Học viện Phật giáo Larung Gar, quy y làm đệ tử của Pháp vương Jigme Phuntsok,\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/36/b3/a4/e091e13d0455e032c8375e4c78d49efe.png\" alt=\"NĂM THÁNG ĐÃ QUA THỈNH NGƯỜI TRÂN TRỌNG\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eGyatso Rinpoche bôn ba khắp các ngôi chùa lớn nhỏ ở Tây Tạng để cầu pháp, xây chùa tu hành. Ngài tích cực tham gia các hoạt động truyền bá đạo Phật, sự hưng thịnh trong nền văn hóa dân tộc cũng như công cuộc phát triển giáo dục tại các vùng miền xa xôi hẻo lánh.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/product/4d/96/63/4648279bc1fe192d0c9f3aa26e4326aa.jpg\" alt=\"NĂM THÁNG VỘI TRÔI, THỈNH NGƯỜI TRÂN TRỌNG\" width=\"600\" height=\"510\" /\u003e\u003c/p\u003e\n\u003cp\u003eVới hơn 80 câu chuyện với 5 chương chính\u003cem\u003e: Hạnh phúc là một dãy mật mã đơn giản nhưng đặc biệt; Quyền lựa chọn vui vẻ, chưa bao giờ nằm trong tay người khác; Tình yêu chân thành là cơ duyên hiếm có trên thế gian; Bởi thế giới này không có sự vĩnh hằng; Thứ quý giá nhất trên thế gian là gì?\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003eCuốn sách \u003cstrong\u003e\u003cem\u003e“Năm tháng vội trôi, thỉnh người trân trọng”\u003c/em\u003e\u003c/strong\u003e\u003cstrong\u003e \u003c/strong\u003elà \u003cem\u003e\"bản vẽ\"\u003c/em\u003e phác họa nên chân dung của hạnh phúc. Là sự giác ngộ về hạnh phúc tại tâm. Nhân gian hữu hạn, thời gian hữu hạn, quyền lựa chọn trong tay mỗi người, hà cớ giao phó hạnh phúc cuộc đời mình vào bàn tay người khác? Hiểu được điều trân quý nhất thế gian là thời gian mà trân trọng hiện tại.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTHÔNG TIN THUỘC TÍNH SÁCH\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e-Tác giả: Gia Thố (Gyatso Rinpoche)\u003c/p\u003e\n\u003cp\u003e- Dịch giả: Mai Dung\u003c/p\u003e\n\u003cp\u003e- Khổ: 12x18\u003c/p\u003e\n\u003cp\u003e- Số trang 296\u003c/p\u003e\n\u003cp\u003e- NXB: Lao Động\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eNHÀ SÁCH GIÁO DỤC QUỐC TẾ CAM KẾT :\u003c/strong\u003e\u003cbr /\u003e- Sách thật chính hãng , hoàn tiền ngay 100% nếu phát hiện sách giả.\u003cbr /\u003e- Sách nhập nguyên kiện từ nhà xuất bản, đảm bảo chất lượng nguyên vẹn\u003cbr /\u003e- 100% là sách mới, chưa qua sử dụng, còn thơm nguyên mùi giấy.\u003cbr /\u003e- Hàng luôn có sẵn, giao ngay khi nhận được đơn\u003cbr /\u003e- Sản phẩm được kiểm tra kỹ càng, đóng gói chắc chắn, cẩn thận trước khi giao cho Quý khách.\u003cbr /\u003e\u003cbr /\u003e\u003c/p\u003e\n\u003cp\u003e#achaubooks #sachtongiao #sachtamlinh #sachphatgiao\u003c/p\u003e\n\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng)\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/e8/06/c7/ed29146283807b3f69be39ff833dc05f.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e8/06/c7/ed29146283807b3f69be39ff833dc05f.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e8/06/c7/ed29146283807b3f69be39ff833dc05f.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e8/06/c7/ed29146283807b3f69be39ff833dc05f.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e8/06/c7/ed29146283807b3f69be39ff833dc05f.png"},{"base_url":"https://salt.tikicdn.com/ts/product/02/a2/1b/5b174a532c6ef12178232c416e160420.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/02/a2/1b/5b174a532c6ef12178232c416e160420.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/02/a2/1b/5b174a532c6ef12178232c416e160420.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/02/a2/1b/5b174a532c6ef12178232c416e160420.pn