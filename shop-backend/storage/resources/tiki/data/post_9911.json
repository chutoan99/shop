điểm mù mà bạn không thể nhìn thấy là mối nguy hiểm thực sự.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eCamera giám sát thông thường chỉ có thể giám sát một trường nhìn duy nhất dễ bị mất tầm nhìn Khu vực ngoài góc nhìn là điểm mù. CAMERA WIFI EZVIZ CS-C7 hỗ trợ 1 camera cố định góc rộng nét cao và 1 camera quay 360 và có độ phân giải 4MP + 4MP là bản nâng cấp cho camera đã được ra mắt trước đó với nâng cấp từ ngoại hình đến tính năng\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/e4/e7/59/4579c4df6702ced2d29ec45cf5a59eac.jpg\" alt=\"e4e759e2f5c618ed8a6cd6cdb25c03ac.jpg\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eThông số kỹ thuật Camera Wifi Ezviz CS-C7:\u003c/p\u003e\n\u003cp\u003eChuẩn nén H.264\u003c/p\u003e\n\u003cp\u003eĐộ phân giải 4MP+4MP\u003c/p\u003e\n\u003cp\u003eCảm biến SNR1s kích thước 1/3”, 25/30fps@5.0M(2880 × 1620)\u003c/p\u003e\n\u003cp\u003eCamera góc rộng Ống kính 2,8mm@F1.6, góc nhìn chéo: 108°, ngang: 92°, dọc: 50°\u003c/p\u003e\n\u003cp\u003eCamera quay Ống kính 6mm@F1.6, góc nhìn chéo: 60°, ngang: 51°, dọc: 28°\u003c/p\u003e\n\u003cp\u003eHỗ trợ quay quét: ngang 0-355°, dọc 0-90°\u003c/p\u003e\n\u003cp\u003eTầm nhìn ban đêm: 30m\u003c/p\u003e\n\u003cp\u003eChế độ ngày đêm(ICR), chống ngược sáng DWDR, tự động cân bằng trắng (AWB), tự động bù sáng (AGC),Chống nhiễu 2D-DNR.\u003c/p\u003e\n\u003cp\u003eChế độ ban đêm thông minh với 4 chế độ sáng: Tự động, Full Color, Hồng ngoại và tắt.\u003c/p\u003e\n\u003cp\u003eCảnh báo chủ động: bật đèn khi phát hiện có đối tượng xâm nhập.\u003c/p\u003e\n\u003cp\u003eHỗ trợ các tính năng thông minh phát hiện con người, phát hiện chuyển động, Theo dõi đối tượng Smart Tracking.\u003c/p\u003e\n\u003cp\u003eHỗ trợ khe cắm thẻ nhớ Micro SD lên đến 512GB\u003c/p\u003e\n\u003cp\u003eHỗ trợ chuẩn ONVIF, Cloud, LAN, tích hợp Wi-Fi\u003c/p\u003e\n\u003cp\u003eChống bụi nước IP66 (ngoài trời)\u003c/p\u003e\n\u003cp\u003eNguồn cấp: DC12V/1A, Công suất \u0026lt;5.32W.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003c/article\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/5f/50/f6/6081cc13b739467c49b1f09f597b4fb6.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/5f/50/f6/6081cc13b739467c49b1f09f597b4fb6.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/5f/50/f6/6081cc13b739467c49b1f09f597b4fb6.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5f/50/f6/6081cc13b739467c49b1f09f597b4fb6.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5f/50/f6/6081cc13b739467c49b1f09f597b4fb6.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/1e/a6/0e/738a945cf8d73646222881b2d5c6b20e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/1e/a6/0e/738a945cf8d73646222881b2d5c6b20e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/1e/a6/0e/738a945cf8d73646222881b2d5c6b20e.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1e/a6/0e/738a945cf8d73646222881b2d5c6b20e.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1e/a6/0e/738a945cf8d73646222881b2d5c6b20e.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/8c/2f/8f/b3427e25b3c19461bb47dfb14e8d7a72.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/8c/2f/8f/b3427e25b3c19461bb47dfb14e8d7a72.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/8c/2f/8f/b3427e25b3c19461bb47dfb14e8d7a72.jpg","p