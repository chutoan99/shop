ex":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"freeship_xtra","type":"pdp_icon_badge","index":2,"icon":"https://salt.tikicdn.com/ts/upload/be/67/48/04a82ab8df178e1a13bde38316081865.png","icon_width":91,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":true,"return_reason":"any_reason"}},"discount":553560,"discount_rate":42,"rating_average":5,"review_count":8,"review_text":"(8)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/e8/f9/38/ba3a42a5c00497f97d5c77c7fb9264e0.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":922,"all_time_quantity_sold":30,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003eGiới thiệu\u003c/h3\u003e\n\u003cp\u003e\u003cstrong\u003eLEGO DUPLO 10913 Thùng Gạch Duplo Sáng Tạo ( 65 Chi Tiết)\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eKhi bạn mở hộp gạch LEGO DUPLO đầy màu sắc này, bạn sẽ mở ra một thế giới vui chơi sáng tạo và những lợi ích phát triển. Bộ vở kịch đa năng này chứa đựng nhiều ý tưởng và cảm hứng cho trẻ mới biết đi. Có một chiếc ô tô có bánh xe di chuyển, mái nhà, cửa sổ, hoa, bánh mì ... tất cả kết hợp với nhiều loại gạch và mảnh để chơi thỏa trí tưởng tượng. Bạn thậm chí có thể giới thiệu các số với 1,2 và 3 gạch.\u003c/p\u003e\n\u003ch3\u003eĐặc điểm nổi bật\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eKhi chúng tạo ra và chơi với hỗn hợp các khối hình và mảnh ghép LEGO DUPLO thân thiện với trẻ mới biết đi, người thợ xây nhỏ của bạn sẽ phát triển khả năng tư duy sáng tạo và giải quyết vấn đề, nhận thức không gian-thị giác và các kỹ năng vận động tốt.\u003c/li\u003e\n\u003cli\u003eBao gồm 65 viên gạch đầy màu sắc cùng với các mảnh ghép quen thuộc để kích thích trí não của trẻ mới biết đi, bao gồm một chiếc ô tô có bánh xe di chuyển, mái nhà, cửa sổ, hoa, bánh mì, hình người DUPLO và các viên gạch học số 1-2-3.\u003c/li\u003e\n\u003cli\u003eKhi cha mẹ và người chăm sóc tham gia thú vị khi kết hợp các khối hình và mảnh để tạo ra đồ chơi và khả năng chơi có trí tưởng tượng vô tận, họ sẽ trải qua các mốc phát triển quý giá của người thợ xây nhỏ của mình.\u003c/li\u003e\n\u003cli\u003eVới những viên gạch và mảnh ghép an toàn, nhiều màu sắc, dễ cầm nắm, đồ chơi giáo dục cho trẻ mới biết đi này sẽ tạo nên một món quà tuyệt vời cho Giáng sinh, sinh nhật hoặc bất kỳ ngày nào khác cho các bé trai và bé gái từ 18 tháng trở lên.\u003c/li\u003e\n\u003cli\u003eTất cả các màu sắc, hình dạng, đồ vật, con người và con số quyến rũ được cất giữ thuận tiện trong một hộp LEGO DUPLO hấp dẫn. Kết hợp chúng với các bộ DUPLO khác để có thêm nhiều niềm vui giàu trí tưởng tượng.\u003c/li\u003e\n\u003cli\u003eĐồ chơi xây dựng này được cung cấp bởi trí tưởng tượng của trẻ em - không cần pin! Đồ chơi không dùng pin giúp tăng cường khả năng vận động tốt và kỹ năng giải quyết vấn đề của trẻ, đồng thời giúp trẻ kiểm soát khả năng sáng tạo ngay trong tay.\u003c/li\u003e\n\u003cli\u003eMở hộp lưu trữ và trò chơi giàu trí tưởng tượng bắt đầu ngay lập tức! Một hướng dẫn đơn giản cung cấp cho cha mẹ và trẻ mới biết đi nguồn cảm hứng - và, một khi trẻ bắt đầu xây dựng, trí tưởng tượng sẽ không bao giờ dừng lại!\u003c/li\u003e\n\u003cli\u003eBộ đồ chơi LEGO DUPLO là món quà tuyệt vời cho trẻ mẫu giáo. Chúng thúc đẩy trí tưởng tượng của trẻ em, khuyến khích chơi không gian mở và mang lại lợi ích phát triển cho trẻ mới biết đi\u003c/li\u003e\n\u003cli\u003eBộ khởi động LEGO DUPLO đáp ứng các tiêu chuẩn cao của ngành, đảm bảo chúng dễ dàng cho những bàn tay nhỏ.\u003c/li\u003e\n\u003cli\u003eTại The LEGO Group, chúng tôi thả, bóp, vặn, nung, cắn, bẻ cong, cào và kéo các viên gạch và mảnh LEGO DUPLO để đảm bảo mọi đồ chơi xây dựng DUPLO đều đáp ứng các tiêu chuẩn chất lượng và an toàn toàn cầu cao.\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003eThông tin chi tiết:\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eChất liệu nhựa an toàn không gây hại cho sức khỏe của bé khi sử dụng.\u003c/li\u003e\n\u003cli\u003eĐộ tuổi phù hợp: 18 tháng +\u003c/li\u003e\n\u003cli\u003eBộ gồm: 65 chi tiết\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/e8/f9/38/ba3a42a5c00497f97d5c77c7fb9264e0.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e8/f9/38/ba3a42a5c00497f97d5c77c7fb9264e0.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e8/f9/38/ba3a42a5c00497f97d5c77c7fb9264e0.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e8/f9/38/ba3a42a5c00497f97d5c77c7fb9264e0.jpg","thumbnail_u