age":4,"review_count":5,"review_text":"(5)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/f1/aa/25/1eb5828eb325f98bb8818382a112bb41.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1782,"all_time_quantity_sold":25,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch1\u003e\u003cstrong\u003eĐèn diệt côn trùng\u003c/strong\u003e\u003c/h1\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/76/66/90/5a5302af5ce045678daf2f1204e53b6e.jpg\" alt=\"\" width=\"683\" height=\"558\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003ePhát ra tia UAV để thu hút côn trùng, ruồi, muỗi và các loại côn trùng bay trong phạm vi 360 độ xung quanh đèn. Khi côn trùng bay vào thân đèn, tiếp xúc vào lưới điện sẽ bị tiêu diệt bởi hệ thống lưới điện áp cao.Thiết kế hiện đại, kích thước phù hợp nhưng mang lại hiệu quả cao.\u003c/p\u003e\n\u003cp\u003eKhung nhựa bên ngoài có độ an toàn cao.\u003c/p\u003e\n\u003cdiv class=\"pd-news-content\"\u003e\n\u003cp\u003eThiết kế sang trọng, ánh sáng dịu nhẹ có thể vừa sử dụng bắt muỗi vừa làm đèn ngủ. \u003cbr /\u003eKhông gây ô nhiễm môi trường, không gây khói hay mùi khó chịu.\u003cbr /\u003eĐèn phát tia UV là hoàn toàn vô hại với cơ thể người, trẻ em  và vật nuôi.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/be/5d/37/682c1e9f555c06b4cbb8254dcecfb500.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003c/div\u003e\n\u003ch2\u003e\u003cstrong\u003eSản phẩm  của Đại Sinh  là đơn vị đầu tiên tại Việt Nam được Trung tâm III cấp Giấy chứng nhận an toàn chất lượng về tiêu diệt côn trùng.\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003e thích hợp đặt trong phòng Phòng khách, Nhà bếp, Phòng ngủ\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/c2/3d/1b/22b9e9fd89a08707e42d9b898c86a2d6.jpg\" alt=\"\" width=\"640\" height=\"640\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/f1/aa/25/1eb5828eb325f98bb8818382a112bb41.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f1/aa/25/1eb5828eb325f98bb8818382a112bb41.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f1/aa/25/1eb5828eb325f98bb8818382a112bb41.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f1/aa/25/1eb5828eb325f98bb8818382a112bb41.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f1/aa/25/1eb5828eb325f98bb8818382a112bb41.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/a3/52/90/ef028bf30bcc72bb1578131436e0d7c4.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a3/52/90/ef028bf30bcc72bb1578131436e0d7c4.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a3/52/90/ef028bf30bcc72bb1578131436e0d7c4.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a3/52/90/ef028bf30bcc72bb1578131436e0d7c4.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a3/52/90/ef028bf30bcc72bb1578131436e0d7c4.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/2d/09/0f/b8d8b610047c7bdcd0264d5a