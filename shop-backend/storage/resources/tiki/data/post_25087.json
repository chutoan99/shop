,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/b6/94/81/f1e5bc96bca0b0215a3eefa925ef7aa8.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":275,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eCông tắc thông minh [ĐIỀU KHIỂN TỪ XA] bằng điện thoại Hunonic Lahu 4 kênh RTC 500W/kênh (công nghệ 4.0)\u003c/p\u003e\n\u003cp\u003e HẸN GIỜ KHÔNG CẦN WIFI + ĐIỀU KHIỂN TỪ XA QUA WIFI VÀ BLUETOOTH\u003c/p\u003e\n\u003cp\u003e️ 1.Mô tả cơ bản:\u003cbr /\u003e+ Điều khiển thiết bị từ xa đang là xu hướng của thời đại mới.\u003cbr /\u003e+ Ngày nay, chúng ta đã có thể điều khiển mọi thiết bị điện bằng điện thoại thông minh qua wifi.\u003cbr /\u003e+ Đặc biệt, công tắc Lahu RCT có thể điều khiển qua wifi và bluetooth, hẹn giờ mà không cần có kết nối wifi.\u003cbr /\u003e+ Công tắc wifi thông minh Lahu RTC phù hợp để:\u003cbr /\u003e- Lắp đặt điều khiển hẹn giờ và bật tắt từ xa máy bơm, quạt điện, bóng đèn.\u003cbr /\u003e- Bật tắt valve nước, bơm nước tưới cây, tưới hoa, tưới giàn lan, hệ thống phun sương.\u003cbr /\u003e- Điều khiển bật tắt quạt hút, quạt thông gió, bình nóng lạnh.\u003cbr /\u003e- Và nhiều thiết bị điện dân dụng và công nghiệp khác.\u003cbr /\u003e+ Thiết kế thân thiện, có thể gắn lên tường, bảng điện, hoặc lắp trên thanh ray nhôm, tủ điện đều được.\u003cbr /\u003e+ Công nghệ hẹn giờ thông minh giúp bạn tiết kiệm rất nhiều thời gian để làm những việc quan trọng khác.\u003cbr /\u003e+ Tương thích với các hệ điều hành Android và IOS.\u003c/p\u003e\n\u003cp\u003e️ 2.Thông số kỹ thuật:\u003cbr /\u003e+ Điện áp cấp: 90 – 250VAC/50Hz\u003cbr /\u003e+ Ngõ ra: 4 ngõ ra (4 kênh) 500W/kênh Max *\u003cbr /\u003e+ Wifi: 2.4Ghz (wifi sử dụng trong nhà ở, văn phòng, nhà xưởng đều ok)\u003cbr /\u003e+ Bluetooth: Có\u003cbr /\u003e+ Chức năng nổi bật: Hẹn giờ và điều khiển ngay cả khi không có kết nối internet.\u003c/p\u003e\n\u003cp\u003e️ 3. Hướng dẫn sử dụng:\u003cbr /\u003e+ Download app (tải ứng dụng) có tên \"Hunonic\" từ CH-Play hoặc App Store và cài đặt vào điện thoại của bạn.\u003cbr /\u003e+ Mở ứng dụng lên và làm theo hướng dẫn của ứng dụng. Chỉ vài bước đơn giản là bạn sẽ làm được ngay.\u003c/p\u003e\n\u003cp\u003e️ 4.Chế độ bảo hành:\u003cbr /\u003e+ [HÀNG CHÍNH HÃNG] Bảo hành 12 tháng.\u003c/p\u003e\n\u003cp\u003e️ 5.Thông tin thêm:\u003cbr /\u003e+ Đã test và dán tem đảm bảo chất lượng (QC) từ nhà sản xuất.\u003cbr /\u003e+ Tư vấn online 24/7 nhiệt tình, vui vẻ. Hãy liên hệ với shop ngay để được giải đáp các thắc mắc.\u003cbr /\u003e* Để điều khiển các thiết bị có công suất lớn hơn 500W, hãy sử dụng công tắc Lahu 1 kênh 4000W hoặc lắp thêm khởi động từ phù hợp. Nếu bạn cần tư vấn, xin đừng ngại liên hệ hoặc CHAT với chúng tôi nhé!\u003c/p\u003e\n\u003cp\u003e️ 6. Khuyến mãi:\u003cbr /\u003e- Các chương trình khuyến mãi sẽ được cập nhật liên tục trên trang chính của shop. Quý khách sẽ dễ dàng nhìn thấy các mã giảm giá phù hợp khi lựa chọn thanh toán cho sản phẩm này.\u003cbr /\u003eSố lượng có hạng\u003cbr /\u003e HÃY BẤM MUA NGAY ĐỂ KHÔNG BỎ LỠ CƠ HỘI NHẬN ƯU ĐÃI HẤP DẪN TỪ SHOP NHÉ\u003cbr /\u003e_________________________________\u003cbr /\u003e#congtacthongminh #congtacwifi #co