ref":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":10000,"discount_rate":7,"rating_average":4.6,"review_count":155,"review_text":"(155)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ac/81/f6/f23b77be68111eb8ca87980bc2111264.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1330,"all_time_quantity_sold":852,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eSản phẩm là sự kết hợp hoàn hảo giữa tinh dầu vỏ bưởi Năm roi \u0026amp; vitamin B5 và các dưỡng chất từ thiên nhiên giúp nuôi dưỡng và chăm sóc mái tóc của bạn một cách tốt nhất!\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/7a/ab/fb/d84a24b1603d5d71eb557a4b2b32d6ac.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e- Thành phần chính: \u003cbr /\u003e- Tinh dầu vỏ bưởi: Do có tính kháng khuẩn và chống oxy hóa cao, tinh dầu vỏ bưởi giúp ngăn ngừa nhiễm trùng, mang lại cho bạn da đầu và tóc khỏe mạnh, cải thiện rõ rệt tình trạng gãy rụng tóc.\u003cbr /\u003e- Vitamin B5 (D-panthenol): Chức năng như một tác nhân dưỡng tóc để cung cấp độ ẩm lâu dài cho tóc, ngăn ngừa hư tổn, làm dày tóc và cải thiện độ bóng khỏe của mái tóc.\u003c/p\u003e\n\u003cp\u003eCông dụng: \u003cbr /\u003e- Chống rụng tóc, kích thích tóc mọc nhanh, phục hồi tóc hư tổn. \u003cbr /\u003e- Giảm khô xơ,nuôi dưỡng da đầu và chân tóc, giúp tóc trở nên suôn mượt .\u003cbr /\u003e\u003cbr /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/17/92/31/0679319c547c9f31e166f6c342476bc9.jpg\" alt=\"\" width=\"750\" height=\"456\" /\u003e\u003c/p\u003e\n\u003cp\u003eHướng dẫn sử dụng : \u003cbr /\u003e- Lắc đều để tạo nhủ tương đồng nhất trước khi sử dụng, sau đó xịt đều sản phẩm lên tóc và da đầu, massage nhẹ nhàng để dưỡng chất thấm sâu vào da đầu.\u003cbr /\u003e- Không cần gội đầu lại sau khi sử dụng.\u003cbr /\u003e- Nên dùng hằng ngày để hiệu quả nhanh nhất.\u003c/p\u003e\n\u003cp\u003eKhi sử dụng sản phẩm Tinh Dầu Bưởi Pomelo, bạn sẽ cảm nhận được những thay đổi về mái tóc của mình như sau:\u003c/p\u003e\n\u003cp\u003e- Thời gian đầu sử dụng, bạn sẽ nhận thấy tình trạng gãy rụng tóc giảm đáng kể.\u003c/p\u003e\n\u003cp\u003e- Sau đó, khi tiếp tục sử dụng, tình trạng khô xơ, chẻ ngọn sẽ giảm dần, mái tóc trở nên suôn mượt óng ả. - Sau khi dùng được một thời gian, các sợi tóc con sẽ mọc lên, mái tóc\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/1e/2a/1c/130c1609527dc2ffecf98e401d1feb8c.jpg\" alt=\"\" width=\"750\" height=\"863\" /\u003e\u003c/p\u003e\n\u003cp\u003eLưu ý khi sử dụng Tinh Dầu Bưởi Pomelo Tabaha 120ml\u003c/p\u003e\n\u003cp\u003e- Trước khi sử dụng lắc đều, không lắc quá nhẹ. (Khi lắc quá nhẹ sản phẩm sẽ chưa tạo thành một dung dịch đồng nhất)\u003c/p\u003e\n\u003cp\u003e- Không xịt lên tóc khi trên tóc có nhiều mồ hôi và bụi bẩn. (Khi trên đầu chứa nhiều bụi, các dưỡng chất chưa kịp thấm vào da đầu thì đã bị kết dính với chất bẩn bám vào tóc gây khó chịu)\u003c/p\u003e\n\u003cp\u003e- Tránh tinh dầu bưởi vào mắt, nếu bị vào mắt, rửa sạch nhiều lần với nước. Không cần gội đầu lại sau khi sử dụng. (Khi xịt sản phẩm lên tóc, cần thời gian để thẩm thấu vào da đầu và tóc, sản phẩm cũng đã có mùi thơm đặc trưng vì vậy không gội đầu sau khi sử dụng sản phẩm)\u003c/p\u003e\n\u003cp\u003e- Nên dùng hằng ngày và kiên trì sử dụng để mang lại hiệu quả cao (Nên dùng hằng ngày và sử dụng kiên trì đến hết chai đây là sản phẩm từ thiên nhiên an toàn và mang lại hiệu quả lâu dài, sau thời gian nhất định sẽ giảm khô xơ, tóc hư tổn sẽ được phục hồi, tóc sẽ mọc dày và đều hơn, da đầu được nuôi dưỡng đúng cách, tóc sẽ dần trở nên suôn mượt )\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/04/6f/a7/da0a5b34e40e7542573b6a7b9d651d4a.jpg\" alt=\"\" width=\"750\" height=\"1000\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ac/81/f6/f23b77be68111eb8ca87980bc2111264.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ac/81/f6/f23b77be68111eb8ca87980bc2111264.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ac/81/f6/f23b77be68111eb8ca87980bc2111264.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ac/81/f6/f23b77be68111eb8ca87980bc2111264.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ac/81/f6/f23b77be68111eb8ca87980bc2111264.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/13/2c/fc/79d979a2b8a7e0bc87cca0b3ad7da496.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/13/2c/fc/79d979a2b8a7e0bc87cca0b3ad7da496.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/13