nd_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":125000,"discount_rate":30,"rating_average":4.5,"review_count":60,"review_text":"(60)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/b2/98/34/9aedcc1adf4f0c32e03de2ee8fad1a6d.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":662,"all_time_quantity_sold":256,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<h1 style=\"text-align:center;\"><span style=\"color:#800000;\"><strong>Thực Phẩm Bảo Vệ Sức Khỏe Khang Thận Đơn Hỗ Trợ Tăng Sinh Lý Nam Bổ Thận Tráng Dương</strong></span></h1>\n<p style=\"text-align:center;\"> </p>\n<p>Giải pháp từ thiên nhiên giúp bổ thận, tráng dương, tăng cường sinh lực và khả năng sinh lý ở nam giới</p>\n<p><strong><span style=\"color:#800000;\">Thông tin sản phẩm:</span> </strong></p>\n<p>Giải pháp từ thiên nhiên giúp bổ thận, tráng dương, tăng cường sinh lực và khả năng sinh lý ở nam giới</p>\n<p><span style=\"color:#800000;\"><strong>Quy cách khang thận đơn:</strong></span></p>\n<ul><li>Hộp 30 viên</li>\n<li>Hộp 40 viên</li>\n</ul><p><span style=\"color:#800000;\"><strong>Khối lượng trung bình viên</strong>:</span></p>\n<ul><li>600mg ± 7,5% ( bao gồm vỏ nang )</li>\n</ul><p style=\"text-align:center;\"><strong><img src=\"https://salt.tikicdn.com/ts/tmp/31/1a/27/aa803449045b222440199bf8bc810ff0.jpg\" alt=\"\" width=\"750\" height=\"750\" /></strong></p>\n<h2><span style=\"color:#800000;\"><strong>Thành phần: Mỗi viên nang cứng có chứa</strong></span></h2>\n<p>275mg cao chiết xuất tương đương</p>\n<p>Dâm dương hoắ 500mg</p>\n<p>Ba kích 500mg</p>\n<p>Bá bệ 500mg</p>\n<p>Bạch tật lê 200mg</p>\n<p>Sâm 200mg</p>\n<p>Nấm ngọc cẩ 200mg</p>\n<p>Nhân sâm (panax ginseng) 100mg</p>\n<p>Lộc 50mg</p>\n<p>Hòe 50mg</p>\n<p>Hoàng 50mg</p>\n<p>Hoài sơ 50mg</p>\n<p>Câu kỷ tử 50mg</p>\n<p>Thảo quyết 20mg</p>\n<p>Bột thịt Hàu biển khô 100mg</p>\n<p>L-Arginine HCI 100mg</p>\n<p>Phụ liệu: Talc, lascote, magnesium stearate, PVP, Nipazil, Nipazol, nước tinh khiết, vỏ nang gelatin vừa đủ 1 viên nang cứng.</p>\n<p><img style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/bf/21/e6/f4420f9c300b9c5cd22a7ca487ae679e.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p><span style=\"color:#800000;\"><strong>Dâm dương hoắc</strong></span>: giúp bổ can thận, trợ dương, mạnh gân cốt, ích tinh, trừ thấp. Dâm dương hoắc thường được sử dụng trong các bài thuốc Đông Y giúp bổ thận, chữa liệt dương, di tinh, xuất tinh sớm, lưng gối đau mỏi.</p>\n<p><span style=\"color:#800000;\"><strong>Ba kích</strong></span>: các nghiên cứu dược lý cho thấy Ba kích giúp tăng sức dẻo dai, tăng sức đề kháng, hỗ trợ trong trường hợp sinh lý yếu, tăng cường thể lực, giảm đau mỏi khớp.</p>\n<p><span style=\"color:#800000;\"><strong>Bá bệnh</strong></span>: phân bố chủ yếu ở khu vực Đông Nam Á, bá bệnh giúp tăng cường ở nam giới, qua đó cải thiện sinh lý.</p>\n<p><span style=\"color:#800000;\"><strong>Bạch tật lê</strong></span>: được ví như Viagra cho nam giới. Thường được sử dụng trong các bài thuốc chữa chứng thận hư yếu, rối loạn cương dương và vô sinh, hiếm muộn.</p>\n<p><span style=\"color:#800000;\"><strong>Sâm macca</strong></span>: còn được gọi là nhân sâm Peru, sâm macca giúp tăng cường năng lượng, sức chịu đựng, giảm mệt mỏi.</p>\n<p><span style=\"color:#800000;\"><strong>Nấm ngọc cẩu</strong></span>: Theo Đông Y, nấm ngọc cẩu có tác dụng Bổ Tỳ dưỡng thận, tráng dương, bổ máu, giảm đau, kích thích lưu thông khí huyết, bồi bổ cơ thể, nâng cao khả năng sinh lý.</p>\n<p><strong><span style=\"color:#800000;\">Nhân sâm (panax ginseng)</span>: </strong>có tác dụng đại bổ nguyên khí, cải thiện tâm trạng, bổ sung năng lượng cho cơ thể, hỗ trợ rối loạn cương dương ở nam giới.</p>\n<p><span style=\"color:#800000;\"><strong>Lộc nhung</strong></span>: có tác dụng tăng cường thể lực, nâng cao sức khỏe, cải thiện giấc ngủ.</p>\n<p><span style=\"color:#800000;\"><strong>Hòe hoa</strong></span>: có tác dụng chống viêm, bảo vệ thành mạch.</p>\n<p><span style=\"color:#800000;\"><strong>Hoàng tinh, hoài sơn</strong></span>: bồi bổ cơ thể.</p>\n<p><span style=\"color:#800000;\"><strong>Câu kỷ tử</strong></span>: ích tinh khí huyết, bổ thận.</p>\n<p><span style=\"color:#800000;\"><strong>Thảo quyết minh</strong></span>: Giúp ngủ ngon</p>\n<p><span style=\"color:#800000;\"><strong>Bột thịt Hàu biển khô</strong></span>: Chứa kẽm, acid amin, khoáng chất và vitamin, giúp cải thiện chất lượng tinh trùng và sinh lý ở nam giới.</p>\n<p><span style=\"color:#800000;\"><strong>L-Arginine HCl</strong>:</span> Giúp hỗ trợ chứng rối loạn cương dươ</p>\n<p><img style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/f0/e7/a9/2a21e899ae86da6c3bd9224ade407211.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<h2><span style=\"color:#800000;\"><strong>Công dụng của Khang Thận Đơn</strong></span></h2>\n<p>Hỗ trợ bổ thận, tráng dương, giúp tăng cường sinh lực và tăng khả năng sinh lý ở nam giới. Hỗ trợ hạn chế quá trình mãn dục sớm.</p>\n<p><img style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/08/37/74/414258d95e3993c89b0a4cd2ddc03f00.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<h2><span style=\"color:#800000;\"><strong>Đối tượng sử dụng:</strong></span></h2>\n<p>Nam giới trưởng thành sinh lý yếu, mãn dục sớm, người thận hư với các biểu hiện: tiểu đêm nhiều lần, đau lưng, mỏi gối, cơ thể mệt mỏi.</p>\n<h2><strong><span style=\"color:#800000;\">Cách dùng:</span> </strong></h2>\n<p>Ngày uống 2 lần, mỗi lần 1-2 viên. Uống sau bữa ăn và trước khi đi ngủ 2 giờ</p>\n<p><span style=\"color:#800000;\"><strong>Bảo quản</strong>:</span> Nơi khô ráo, tránh ánh sáng mặt trời. Để xa tầm tay trẻ em.</p>\n<p><img style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/ec/f1/49/8111e80358b539b772ba53ba90a630d5.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p><span style=\"color:#800000;\"><strong>Tiêu chuẩn</strong>:</span> TCCS</p>\n<p><span style=\"color:#800000;\"><strong>Lưu ý</strong>:</span></p>\n<ul><li>Không dùng cho người mẫn cảm với bất kỳ thành phần nào của thuốc.</li>\n<li>Thực phẩm này không phải là thuốc, không có tác dụng thay thế thuốc chữa bệnh</li>\n<li>Không dùng cho người dưới 18.</li>\n</ul><p> </p>\n<p> </p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/b2/98/34/9aedcc1adf4f0c32e03de2ee8fad1a6d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b2/98/34/9aedcc1adf4f0c32e03de2ee8fad1a6d.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b2/98/34/9aedcc1adf4f0c32e03de2ee8fad1a6d.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b2/98/34/9aedcc1adf4f0c32e03de2ee8fad1a6d.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b2/98/34/9aedcc1adf4f0c32e03de2ee8fad1a6d.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/f0/e7/a9/739cbfe5b2ab53d0556e1f3b839f8430.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f0/e7/a9/739cbfe5b2ab53d0556e1f3b839f8430.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f0/e7/a9/739cbfe5b2ab53d0556e1f3b839f8430.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200