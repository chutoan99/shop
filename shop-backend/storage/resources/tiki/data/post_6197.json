tejustify\"\u003eNhà văn Nguyễn Việt Hà nhận định: “Ngày nay, với riêng chủ đề về bọn trẻ loay hoay đang lớn, Nguyễn Nhật Ánh là một nhà văn bậc nhất.”\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/7d/c5/07/538b9e6f6efbd0dccf12de03668c2709.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/7d/c5/07/538b9e6f6efbd0dccf12de03668c2709.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/7d/c5/07/538b9e6f6efbd0dccf12de03668c2709.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7d/c5/07/538b9e6f6efbd0dccf12de03668c2709.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7d/c5/07/538b9e6f6efbd0dccf12de03668c2709.jpg"}],"warranty_policy":null,"current_seller":{"id":7734,"sku":"7503685189372","name":"NHBook","link":"https://tiki.vn/cua-hang/nhbook","logo":"49/49/f3/973a1913dac7a3cbaa379403203cb8b7.jpg","price":669000,"product_id":"272306372","store_id":7554,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[{"id":110426,"name":"Tủ sách Hoa Hướng Dương","link":"https://tiki.vn/cua-hang/tu-sach-hoa-huong-duong","logo":"","price":630000,"product_id":"151037826","store_id":102212},{"id":10821,"name":"nha sach nguyet linh","link":"https://tiki.vn/cua-hang/nha-sach-nguyet-linh","logo":"https://vcdn.tikicdn.com/ts/seller/88/2b/d0/eaa1eadc8566bf565288bb245d07f952.jpg","price":735300,"product_id":"274670101","store_id":10595}],"specifications":[{"name":"Thông tin chung","attributes":[{"code":"publisher_vn","name":"Công ty phát hành","value":"NXB Kim Đồng"},{"code":"publication_date","name":"Ngày xuất