9,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":3.7,"review_count":6,"review_text":"(6)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/91/d5/17/59e2dddc0bedccc708d8fa3d7f4195de.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1355,"all_time_quantity_sold":12,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eSản phẩm GUINNESS MU-113 sở hữu những đặc điểm nổi trội như:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eBăng tần UHF từ 650 MHz – 675 MHz giúp thiết bị bắt sóng dễ dàng.\u003c/li\u003e\n\u003cli\u003eĐáp ứng 32 tần số/2 kênh A và B.\u003c/li\u003e\n\u003cli\u003eTích hợp mạch nén và giải nén tín hiệu, giúp hạn chế tiếng ồn, tiếng rít một cách hiệu quả.\u003c/li\u003e\n\u003cli\u003eĐầu Micro (Capsule) được thiết kế đặc biệt theo các đặc điểm của từng loại âm thanh cho tiếng ca trong sáng, âm trầm sâu và âm cao rõ.\u003c/li\u003e\n\u003cli\u003eChức năng khởi động mềm giúp loại bỏ tiếng ồn hiệu quả khi tắt mở sản phẩm, tránh ảnh hưởng đến loa và gây ra tác động xấu trong quá trình sử dụng.\u003c/li\u003e\n\u003cli\u003eTính năng tự động đồng bộ tần số qua Receiver bằng cách nhấn nút chọn tần số trên thân Micro.\u003c/li\u003e\n\u003cli\u003eThiết kế tinh tế với màu đen làm chủ đạo.\u003c/li\u003e\n\u003cli\u003eThu và phát sóng mạnh và ổn định trong phạm vi 30-40m (trong điều kiện lý tưởng).\u003c/li\u003e\n\u003cli\u003eChuyên dùng cho Karaoke gia đình, Karaoke chuyên nghiệp, hát với nhau, hội trường, kịch nói, giảng dạy, sân khấu ca nhạc…\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/91/d5/17/59e2dddc0bedccc708d8fa3d7f4195de.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/91/d5/17/59e2dddc0bedccc708d8fa3d7f4195de.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/91/d5/17/59e2dddc0bedccc708d8fa3d7f4195de.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/91/d5/17/59e2dddc0bedccc708d8fa3d7f4195de.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/91/d5/17/59e2dddc0bedccc708d8fa3d7f4195de.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/36/54/5c/ac5c8a07deb296640d517c694094cca7.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/36/54/5c/ac5c8a07deb296640d517c694094cca7.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/36/54/5c/ac5c8a07deb296640d517c694094cca7.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/36/54/5c/ac5c8a07deb296640d517c694094cca7.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/36/54/5c/ac5c8a07deb296640d517c694094cca7.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/fe/7a/85/c3868bb8bb9da54acecb314e431b93c2.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/fe/7a/85/c3868bb8bb9da54acecb314e431b93c2.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/fe/7a/85/c3868bb8bb9da54acecb314e431b93c2.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f