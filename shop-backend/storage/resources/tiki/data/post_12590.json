iá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/84/db/65/704693c71000063927c3b2cd755fb297.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/84/db/65/704693c71000063927c3b2cd755fb297.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/84/db/65/704693c71000063927c3b2cd755fb297.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/84/db/65/704693c71000063927c3b2cd755fb297.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/84/db/65/704693c71000063927c3b2cd755fb297.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/e8/4b/ae/f52f269b4ddfa08b40cbc9964ef2924d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e8/4b/ae/f52f269b4ddfa08b40cbc9964ef2924d.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e8/4b/ae/f52f269b4ddfa08b40cbc9964ef2924d.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e8/4b/ae/f52f269b4ddfa08b40cbc9964ef2924d.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e8/4b/ae/f52f269b4ddfa08b40cbc9964ef2924d.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/f8/c1/f1/8218288f292679a12dc9b635b0491248.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f8/c1/f1/8218288f292679a12dc9b635b0491248.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f8/c1/f1/8218288f292679a12dc9b635b0491248.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f8/c1/f1/8218288f292679a12dc9b635b0491248.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f8/c1/f1/8218288f292679a12dc9b635b0491248.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/51/a2/f2/cb79326746256e7cadc4f2da94ae1ae8.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/51/a2/f2/cb793