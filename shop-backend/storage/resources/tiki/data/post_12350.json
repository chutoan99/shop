_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/52/1a/0b/ae78851dc97b06093b1529b5b7456bb2.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2359,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p style=\"text-align: center;\"><strong><iframe src=\"//www.youtube.com/embed/P8aqOz4l__4\" width=\"600\" height=\"336\" allowfullscreen=\"allowfullscreen\"></iframe></strong></p>\n<p><strong>Đặc điểm nổi bật:</strong> </p>\n<ul>\n<li>100% đồng hồ Citizen chính hãng thương hiệu Nhật Bản.</li>\n<li>5 năm bảo hành bao gồm 1 năm chính hãng toàn cầu và 4 năm bảo hành tại hệ thống.</li>\n<li>Công nghệ Eco-drive độc quyền Citizen giúp đồng hồ hoạt động không dùng Pin. </li>\n<li>Thuộc bộ sưu tập Citizen Radio-Controlled tự động điều chỉnh giờ khi bắt sóng theo trạm Radio tại Trung Quốc/Nhật/Mỹ/Châu Âu</li>\n<li>Sở hữu chức năng perpetual calendar (lịch vạn niên), tự động điều chỉnh lịch ngày trong năm, kể cả năm nhuận. Chính xác trong vòng 100 năm.</li>\n<li>Sở hữu chức năng World Time xem giờ 26 thành phố trên thế giới.</li>\n<li>Viền đồng hồ được phủ vàng bằng công nghệ PVD, không bong tróc.</li>\n<li>Dây da được dập vân cá sấu chất liệu cao cấp chính hãng Citizen.</li>\n<li>Viền kim loại chất liệu thép không gỉ hạn chế ăn mòn cao.</li>\n<li>Mặt kính Sapphire trong suốt hạn chế trầy xước. </li>\n<li>Chức năng Chronograph đếm giờ thể thao.</li>\n<li>Chức năng lịch thứ, ngày.</li>\n<li>Thiết kế thanh lịch.</li>\n</ul>\n<p style=\"text-align: center;\"><img src=\"https://salt.tikicdn.com/ts/tmp/2e/b1/bf/b801ae4d5c692ab22c91dcd57328df1c.jpg\" alt=\"AT8113-12H\" width=\"600\" height=\"400\" /></p>\n<p><strong>Thông số kỹ thuật:</strong></p>\n<ul>\n<li>Kích thước mặt: 43 mm</li>\n<li>Độ rộng dây: 23 mm</li>\n<li>Độ dày vỏ: 10 mm</li>\n<li>Chống nước: 10 ATM (100M) thoải mái đi mưa, rửa tay, đi bơi (không dùng đi lặn)</li>\n</ul>\n<p style=\"text-align: center;\"><img src=\"https://salt.tikicdn.com/ts/tmp/3c/62/8a/2f96f3732906e3594c180f68cbb6ed44.jpg\" alt=\"AT8113-12H\" width=\"600\" height=\"400\" /></p>\n<p><strong>Hình thức bảo hành:</strong></p>\n<ul>\n<li>Sổ bảo hành</li>\n</ul>\n<p><strong>CHẾ ĐỘ BẢO HÀNH</strong></p>\n<p><strong>I. Tất cả Đồng Hồ CITIZEN đều được áp dụng chế độ bảo hành chính hãng 01 năm toàn cầu cộng thêm 04 năm tại Hệ Thống Store Đồng Hồ Citizen.</strong></p>\n<ul>\n<li><em>1 Năm Bảo Hành Chính Hãng + 4 Năm Bảo Hành Tại Hệ Thống Store Đồng Hồ Citizen = 5 Năm Bảo Hành</em></li>\n</ul>\n<p><strong>II. Chi tiết bảo hành</strong></p>\n<p>1. Eco-Drive: Công nghệ độc quyền của Citizen, đồng hồ không cần thay pin và sử dụng mọi nguồn ánh sáng.</p>\n<p>2. Để đồng hồ được sử dụng lâu bền, Qúy khách vui lòng tham khảo những thông tin cần thiết dưới đây: </p>\n<ul>\n<li>Khi trong bóng tối đồng hồ vẫn họat động liên tục từ 2-6 tháng vì đã có sẵn nguồn năng lượng được dự trữ.</li>\n<li>Khi đồng hồ không họat động, Qúy khách nên để đồng hồ dưới ánh sáng cách xa 30cm, khi sạc đầy đồng hồ sẽ tự họat động trở lại.</li>\n<li>Nên đặt đồng hồ ở nơi có đủ ánh sáng khi không sử dụng.</li>\n<li>Không đặt đồng hồ ở những nơi có nhiệt độ quá cao (trên 60 độ C), và những thiết bị có từ tính.</li>\n<li>Không bao giờ dùng loại pin khác để thay thế.</li>\n<li>Mặc áo dài tay thường xuyên, đồng hồ sẽ bị bao phủ và pin sẽ không được sạc đầy đủ.</li>\n</ul>\n<p><strong>Theo khuyến cáo của hãng, mỗi tháng nên để đồng hồ sạc dưới ánh nắng mặt trời từ 2-3 tiếng nhằm đảm bảo nguồn năng lượng được ổn định. Thời gian sạc sẽ phụ thuộc vào đời máy, mẫu mã và điều kiện của môi trường.</strong></p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/52/1a/0b/ae78851dc97b06093b1529b5b7456bb2.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/52/1a/0b/ae78851dc97b06093b1529b5b7456bb2.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/52/1a/0b/ae78851dc97b06093b1529b5b7456bb2.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/52/1a/0b/ae78851dc97b06093b1529b5b7456bb2.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/52/1a/0b/ae78851dc97b06093b1529b5b7456bb2.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/e3/6b/74/1efb4439f96d9472cdda9449c548fe1a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e3/6b/74/1efb4439f96d9472cdda9449c548fe1a.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e3/6b/74/1efb4439f96d9472cdda9449c548fe1a.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e3/6b/74/1efb4439f96d9472cdda9449c548fe1a.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e3/6b/74/1efb4439f96d9472cdda9449c548fe1a.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/01/27/69/b2c3a2bd834d1ce111b7f6f40f20904c.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/01/27/69/b2c3a2bd834d1ce111b7f6f40f20904c.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/01/27/69/b2c3a2bd834d1ce111b7f6f40f20904c.jpg","position":null,"small_url":"https://salt.tik