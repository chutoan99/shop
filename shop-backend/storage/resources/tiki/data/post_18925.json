or":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":1091000,"discount_rate":48,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/38/a0/91/78a32df629893942b81cb9b41c1b1964.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":279,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eGhế sofa bập bênh đôi khung thép, cao cấp, sang trọng, rộng rãi, êm ái, đệm hai mặt, hai màu thay đổi, chính hãng Nikita\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/d0/94/9c/f03888c107a02678cd273ac6dbd3ad40.JPG\" alt=\"\" width=\"750\" height=\"714\" /\u003e\u003c/p\u003e\n\u003cp\u003eGhế bập bênh đôi kích thước 120x92x77 có tựa lưng cong rộng rãi và thoải mái mang lại sự hỗ trợ và thoải mái tuyệt vời cho cơ thể. Thiết kế chân kết nối ghế và tay vịn cung cấp thêm sự hỗ trợ và cân bằng khi bạn lắc lư ghế.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/2b/ac/5c/42c2919c2fc213f59a813b95431dd3b7.JPG\" alt=\"\" width=\"733\" height=\"783\" /\u003e\u003c/p\u003e\n\u003cp\u003eCÔNG NĂNG VƯỢT TRỘI\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eChiếc ghế bập bênh cỡ lớn này có kết cấu chắc chắn, nổi bật với khung được chế tạo từ thép chất lượng cao. Thiết kế này đảm bảo khả năng chịu tải và độ ổn định đặc biệt.\u003c/li\u003e\n\u003cli\u003eChất liệu vải nano thoáng khí không chỉ chống phai màu, chống nước mà còn thân thiện với da và mềm mại, chống vết bẩn tuyệt vời\u003c/li\u003e\n\u003cli\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/4e/96/e2/fe7b9b30b6b94a83f715ca36745b79b4.JPG\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/li\u003e\n\u003cli\u003eThiết kế ôm chặt đường cong thả áp lực để xua tan mệt mỏi hỗ trợ bảo vệ cột sống, giảm áp lực lên mông, giúp chân thư giãn, thoải mái khi ngồi, chống lật\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/59/0f/7b/46a29f7963ac07d14ff81b4b621355f6.JPG\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/li\u003e\n\u003cli\u003eGhế bập bênh phù hợp với nhiều mục đích, không gian khác nhau như nghỉ trưa, đọc báo, xem phim, thư giãn.\u003c/li\u003e\n\u003cli\u003eNệm đàn hồi êm ái, có thể tháo rời\u003c/li\u003e\n\u003cli\u003eKhi ngồi xuống và đung đưa, nghiêng người về phía trước 23,3° và lùi lại 20,4° để tạo thành vòng cung nụ cười. Chân, góc vung phải vừa phải\u003c/li\u003e\n\u003cli\u003eGhế bập bênh được trang bị một chiếc đệm rộng rãi được làm từ bông dày, có độ đàn hồi cao. Thiết kế công thái học của nó mang lại sự thoải mái và thư giãn tối đa\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/b3/6e/6a/0bed4b025a4c455d762283228cbb812a.JPG\" alt=\"\" width=\"735\" height=\"739\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/a0/62/53/1dbf7fa6e85f8ae47389b794eaf197a2.JPG\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/li\u003e\n\u003cli\u003eChiếc ghế này được thiết kế tỉ mỉ để mang lại trải nghiệm bập bênh an toàn. Bạn có thể tận hưởng trải nghiệm ngồi yên tĩnh và thú vị mà không phải lo lắng về việc vô tình bị ngã.\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/3b/34/b6/b8419b911f04fd1b96291addad78d160.JPG\" alt=\"\" width=\"750\" height=\"768\" /\u003e\u003c/li\u003e\n\u003cli\u003eThiết kế kiểu dáng đẹp và hiện đại của nó kết hợp đẹp mắt với một chiếc đệm sang trọng, mang đến một nơi ấm cúng và hấp dẫn để ngả lưng và thư giãn.\u003c/li\u003e\n\u003cli\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/21/7e/3f/9ca06a2fbbc39f03f0fcfc75213ac5d0.JPG\" alt=\"\" width=\"0\" height=\"0\" /\u003e\u003c/li\u003e\n\u003cli\u003e=================\u003c/li\u003e\n\u003cli\u003e PHƯƠNG CHÂM VÀ CAM KẾT CỦA SHOP :\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e️ Luôn bán hàng uy tín chất lượng\u003c/p\u003e\n\u003cp\u003e️ Chính sách bảo hành Sản phẩm 12 tháng\u003c/p\u003e\n\u003cp\u003e️ Hàng cam kết đúng trọng lượng của từng sản phẩm\u003c/p\u003e\n\u003cp\u003e️ Hoàn hàng 3 ngày theo quy định của Sàn\u003c/p\u003e\n\u003cp\u003e️ Cam kết giống y như hình 100%\u003c/p\u003e\n\u003cp\u003e️ Cung cấp các sản phẩm theo đúng tiêu chuẩn với chất lượng tốt nhất,cam kết hàng giống hình 100%.\u003c/p\u003e\n\u003cp\u003e️ Giá cả hợp lý, cạnh tranh.\u003c/p\u003e\n\u003cp\u003e️ Đảm bảo về số lượng và đúng chủng loại khách đặt\u003c/p\u003e\n\u003cp\u003e️ Shop chỉ cung cấp những sản phẩm có chất lượng tốt nhất tới tay khách hàng.\u003c/p\u003e\n\u003cp\u003e️ QUÝ KHÁCH LƯU Ý: Khi nhận hàng nếu không hài lòng về chất lượng sản phẩm xin đừng vội đánh giá, hãy liên hệ ngay với SHOP để được hỗ trợ.\u003c/p\u003e\n\u003cp\u003eSỰ HÀI LÒNG CỦA KHÁCH HÀNG LUÔN LÀ MỤC TIÊU HƯỚNG ĐẾN CỦA SHOP \u003c/p\u003e\n\u003cp\u003e️ Lưu ý : \u003c/p\u003e\n\u003cp\u003e Hàng đổi trả phải còn nguyên tem mác và không có dấu hiệu sử dụng\u003c/p\u003e\n\u003cp\u003e Khi shop nhận được hàng đổi trả sẽ chuyển ngay sản phẩm khác cho quý khách hoặc hoàn tiền theo hình thức chuyển khoản.\u003c/p\u003e\n\u003cp\u003e Quý khách nên mua tổng lượng hàng phù hợp để được hưởng ưu đãi phí vận chuyển từ Sàn\u003c/p\u003e\n\u003cp\u003e Quý khách vui lòng chú ý điện thoại khi đặt hàng tránh trường hợp không liên lạc được để xác nhận đặt hàng và giao hàng.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e#ghe_bap-benh, #ghe_doi, #ghe_bap_benh_doi #ghe_thu_gian, #ghe_sofa_mini, #ghe_bap_benh_chong_lat, #ghe_banh_benh_co_nem, #ghe_sofa_thong_minh, #ghe_sofa_kem_giuong, #ghe_sofa_cho, #ghe_sofa_bup_be, #ghe_thu_gian, #ghe_thu_gian_tron\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện h