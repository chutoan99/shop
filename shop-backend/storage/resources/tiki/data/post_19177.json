"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":58000,"discount_rate":12,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/2a/aa/07/016025a1e964c7d8535430312579b828.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1610,"all_time_quantity_sold":4,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/af/f2/28/9d1896ada9b3df37d9b8fea1a3279807.JPG\" alt=\"\" width=\"432\" height=\"435\" /\u003e\u003c/p\u003e\n\u003ch3\u003eSắt là “ai” mà quan trọng với trẻ đến thế?\u003c/h3\u003e\n\u003cp\u003eMẹ có biết, sắt là một chất vô cùng quan trọng đối trẻ? Sắt giúp các tế bào hồng cầu mang oxy đến khắp cơ thể và đóng vai trò quan trọng trong các hoạt động chức năng của não bộ, cơ bắp.\u003c/p\u003e\n\u003cp\u003eTrẻ bị thiếu sắt trong máu có thể dẫn đến nhiều bệnh nguy hiểm, ảnh hưởng nghiêm trọng đến sự phát triển của trẻ: Trẻ bị thiếu sắt sẽ suy giảm hệ miễn dịch, giảm trí thông minh, cơ thể luôn trong trạng thái mệt mỏi, khó chịu, cáu gắt.\u003c/p\u003e\n\u003cp\u003eThS.BS. Lê Thị Hải, Giám đốc Trung tâm khám và tư vấn dinh dưỡng, Viện sinh dưỡng Quốc gia cho biết: Ở bất kỳ người nào, tình trạng thiếu máu cũng rất nguy hiểm và gây ra nhiều ảnh hưởng tác hại khôn lường cho sức khỏe, nhất là đối với phụ nữ mang thai và trẻ em.\u003c/p\u003e\n\u003cp\u003eĐể phòng ngừa thiếu máu và cải thiện tình trạng thiếu máu ở trẻ mẹ cần cải thiện chế độ ăn uống của con, đa dạng bữa ăn, ăn đa dạng nguồn thực phẩm, bổ sung thêm nguồn thức ăn động vật nhiều sắt: trứng, thịt đỏ, bổ sung thêm rau xanh và trái cây.\u003c/p\u003e\n\u003cp\u003eNgoài việc cân đối lại chế độ ăn uống của trẻ, mẹ nên bổ sung thêm các sản phẩm sắt để bổ sung sắt cho trẻ, tránh tình trạng trẻ thiếu máu gây ra nhiều hậu quả xấu.\u003c/p\u003e\n\u003ch2\u003eKids Smart Liquid Multi + Iron - Bổ vitamin và sắt cho trẻ trên 1 tuổi\u003c/h2\u003e\n\u003cp\u003eNature's Way Kids Smart Multi + Iron giúp thúc đẩy sự tăng trưởng và phát triển lành mạnh của trẻ em. Sản phẩm có hương vị berry tuyệt vời được pha chế với \u003cstrong\u003e12 loại vitamin thiết yếu\u003c/strong\u003e bao gồm sắt, cho sự tăng trưởng và phát triển khỏe mạnh của trẻ em.\u003c/p\u003e\n\u003ch2\u003eKids Smart Liquid Multi + Iron mang lại lợi ích gì cho trẻ?\u003c/h2\u003e\n\u003cp\u003e- Hỗ trợ mức năng lượng cần thiết cho trẻ\u003cbr /\u003e- Hỗ trợ chức năng hệ thống miễn dịch khỏe mạnh\u003cbr /\u003e- Duy trì/hỗ trợ tăng trưởng và phát triển lành mạnh\u003cbr /\u003e- Một chế độ ăn uống cân bằng và đủ lượng vitamin và khoáng chất từ thực phẩm, rất cần thiết cho trẻ em.\u003c/p\u003e\n\u003ch2\u003eVì sao nên lựa chọn Kids Smart Liquid Multi + Iron?\u003c/h2\u003e\n\u003cp\u003e- Là một sản phẩm của Nature's Way - thương hiệu Số 1 tại Úc dành cho trẻ em. Nature's Way ra đời từ 1943 được phân phối hơn 10.000 điểm bán hàng trên thế giới.\u003cbr /\u003e- Kids Smart Liquid Multi + Iron có hương vị berry tuyệt vời được pha chế với 12 loại vitamin thiết yếu bao gồm: sắt, cho sự tăng trưởng và phát triển khỏe mạnh của trẻ em.\u003cbr /\u003e- Sản phẩm bổ sung hương vị trái cây thơm ngon giúp trẻ uống dễ dàng và có cảm giác thích thú, hào hứng mỗi lần được uống vitamin\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eTẠI SAO BỔ SUNG SẮT CẦN KẾT HỢP CHOLINE?\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003eCholine là một chất dẫn truyền thần kinh có chức năng tăng cường bảo vệ ống dây thần kinh. Tổ hợp Choline và Sắt sẽ đảm bảo cho đứa trẻ trở nên năng động hơn bởi khi cung cấp đủ dinh dưỡng và oxy xung thần kinh sẽ được truyền đi nhanh hơn trong các ống thần kinh. Điều này khiến bé trở nên rất năng động (dynamic duo) và nhạy bén. Nhiều người lầm tưởng Choline có tác dụng tương tự DHA, tốt cho phát triển trí não của bé. Điều này không đúng. DHA làm gia tăng tế bào thần kinh trong não còn Choline là tăng cường dẫn truyền các tế bào này trong ống thần kinh.\u003c/p\u003e\n\u003cp\u003eHương vị: quả berry thơm ngon\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/a7/f2/4c/ddaf8f5a609aba7c9e316bc6ef370861.JPG\" alt=\"\" width=\"705\" height=\"510\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/99/f3/fe/e1a8b65ce097260a5d655c5dfaf66615.jpg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/99/f3/fe/e1a8b65ce097260a5d655c5dfaf66615.jpg\" alt=\"\" width=\"480\" height=\"640\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/26/04/f3/ef7a3ae2e3556653b308969de5548019.jpg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/26/04/f3/ef7a3ae2e3556653b308969de5548019.jpg\" alt=\"\" width=\"480\" height=\"640\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/2a/aa/07/016025a1e964c7d8535430312579b828.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/2a/aa/07/016025a1e964c7d8535430312579b828.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/2a/aa/07/016025a1e964c7d8535430312579b828.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2a/aa/07/016025a1e964c7d8535430312579b828.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2a/aa/07/016025a1e964c7d8535430312579b828.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/ce/5e/e6/cfbc82c3ee2a4f41cae15221970021f0.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ce/5e/e6/cfbc82c3ee2a4f41cae15221970021f0.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ce/5e/e6/cfbc82c3ee2a4f41cae15221970021f0.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ce/5e/e6/cfbc82c3ee2a4f41cae15221970021f0.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ce/5e/e6/cfbc82c3ee2a4f41cae15221970021f0.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/75/fa/61/da0c8bfbe1d7fead706ce0aa9e5fb739.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/75/fa/61/da0c8bfbe1d7fead706ce0aa9e5fb739.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/75/fa/61/da0c8bfbe1d7fead706ce0aa9e5fb739.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/75/fa/61/da0c8bfbe1d7fead706ce0aa9e5fb739.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/75/fa/61/da0c8bfbe1d7fead706ce0aa9e5fb739.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/a7/f2/4c/f8abb23963767e0cda345c3611cdab34.JPG","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/pro