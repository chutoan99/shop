ckground_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":486000,"discount_rate":40,"rating_average":4.8,"review_count":97,"review_text":"(97)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/71/ff/fb/25552908f75054cf44fe8c048f780445.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1978,"all_time_quantity_sold":575,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"box-sizing: border-box; margin: 0px; padding: 0px; outline: none; color: #080003; font-family: 'Source Sans Pro', Arial, Helvetica, sans-serif;\"\u003e\u003cstrong\u003eHiệu quả nổi bật:\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 0px; padding: 0px; outline: none; color: #080003; font-family: 'Source Sans Pro', Arial, Helvetica, sans-serif;\"\u003e \u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 0px; padding: 0px; outline: none; color: #080003; font-family: 'Source Sans Pro', Arial, Helvetica, sans-serif;\"\u003e1. Sản phẩm nổi bật với công nghệ chống nắng Fernblock được chiết xuất từ dương xỉ Polypodium leucotomos mang tới những tác dụng sau:\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 0px; padding: 0px; outline: none; color: #080003; font-family: 'Source Sans Pro', Arial, Helvetica, sans-serif;\"\u003eTiêu diệt các gốc tự do và làm giảm sự phát triển của sắc tố da.\u003cbr style=\"box-sizing: border-box; margin: 0px; padding: 0px; outline: none;\" /\u003eTăng sức đề kháng cho da chống cháy nắng lên gấp 3 lần\u003cbr style=\"box-sizing: border-box; margin: 0px; padding: 0px; outline: none;\" /\u003eBảo vệ và sửa chữa DNA hư hại gây ra bởi tia UV.\u003cbr style=\"box-sizing: border-box; margin: 0px; padding: 0px; outline: none;\" /\u003eBảo vệ nguyên bào sợi trong da và nâng cao hoạt động của collagen và elastin, đem đến một làn da săn chắc hơn và ẩm mượt hơn.\u003cbr style=\"box-sizing: border-box; margin: 0px; padding: 0px; outline: none;\" /\u003eTăng 66% độ săn chắc da -\u0026gt; giảm sự hình thành nếp nhăn và se khít lỗ chân lông\u003cbr style=\"box-sizing: border-box; margin: 0px; padding: 0px; outline: none;\" /\u003eGiảm 60% gốc oxi tự do -\u0026gt; ngăn ngừa lão hóa\u003cbr style=\"box-sizing: border-box; margin: 0px; padding: 0px; outline: none;\" /\u003eGiảm 55% sự thoái biến collagen -\u0026gt; ngăn ngừa lão hóa\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 0px; padding: 0px; outline: none; color: #080003; font-family: 'Source Sans Pro', Arial, Helvetica, sans-serif;\"\u003e\u003cbr style=\"box-sizing: border-box; margin: 0px; padding: 0px; outline: none;\" /\u003e2. Bảo vệ toàn bộ cơ thể bạn: vì dạng bào chế là viên uống nên được hấp thu và phân bố đều trong cơ thể, nhờ vậy Heliocare có thể bảo vệ tất cả các vùng da trên cơ thể bạn.\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 0px; padding: 0px; outline: none; color: #080003; font-family: 'Source Sans Pro', Arial, Helvetica, sans-serif;\"\u003e \u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 0px; padding: 0px; outline: none; color: #080003; font-family: 'Source Sans Pro', Arial, Helvetica, sans-serif;\"\u003e3. Heliocare Oral đã được nghiên cứu rộng rãi tại Trường Đại học Y Harvard trong hơn 12 năm bởi các nhà khoa học nổi tiếng. Ngoài ra, những phát hiện này được công bố trên tạp chí y khoa, bao gồm các tạp chí hàng đầu cho da liễu hàng đầu - Tạp chí của Viện Da liễu Mỹ. Tại Singapore, sản phẩm này cũng được phân loại theo HSA là một bổ sung sức khỏe và khuyến cáo rộng rãi bởi các bác sĩ nói chung và bác sĩ da liễu nói riêng.\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 0px; padding: 0px; outline: none; color: #080003; font-family: 'Source Sans Pro', Arial, Helvetica, sans-serif;\"\u003e \u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 0px; padding: 0px; outline: none; color: #080003; font-family: 'Source Sans Pro', Arial, Helvetica, sans-serif;\"\u003e4. Chiết xuất Polypodium leucotomos có trong Heliocare đã được sử dụng một cách an toàn trên thị trường trong hơn 20 năm ở châu Âu mà không có bất kỳ tác dụng phụ được báo cáo hoặc gây tăng cân cho người sử dụng. Nó cũng không độc hại, không chứa i-ốt, cholesterol, hoặc kích thích tố.\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 0px; padding: 0px; outline: none; color: #080003; font-family: 'Source Sans Pro', Arial, Helvetica, sans-serif;\"\u003e \u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 0px; padding: 0px; outline: none; color: #080003; font-family: 'Source Sans Pro', Arial, Helvetica, sans-serif;\"\u003e5. Heliocare rất thích hợp với:\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 0px; padding: 0px; outline: none; color: #080003; font-family: 'Source Sans Pro', Arial, Helvetica, sans-serif; text-align: left;\"\u003eHoạt động ngoài trời: dã ngoại, tắm biển, bơi lội…\u003cbr style=\"box-sizing: border-box; margin: 0px; padding: 0px; outline: none;\" /\u003eDa nhạy cảm, da mụn\u003cbr style=\"box-sizing: border-box; margin: 0px; padding: 0px; outline: none;\" /\u003eCơ địa dị ứng với kem chống nắng\u003cbr style=\"box-sizing: border-box; margin: 0px; padding: 0px; outline: none;\" /\u003eBệnh nhân đang sử dụng các thủ thuật thẩm mỹ chăm sóc da (lột, laser, microdermabrasion…)\u003cbr style=\"box-sizing: border-box; margin: 0px; padding: 0px; outline: none;\" /\u003eNam giới, vận động viên thể thao, những ngƣời hay làm việc ngoài trời\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 0px; padding: 0px; outline: none; color: #080003; font-family: 'Source Sans Pro', Arial, Helvetica, sans-serif; text-align: left;\"\u003e\u003cbr style=\"box-sizing: border-box; margin: 0px; padding: 0px; outline: none;\" /\u003e\u003cstrong\u003eMách nhỏ:\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 0px; padding: 0px; outline: none; color: #080003; font-family: 'Source Sans Pro', Arial, Helvetica, sans-serif;\"\u003eSản phẩm này không phải là thuốc và không có tác dụng thay thế thuốc chữa bệnh.\u003cbr style=\"box-sizing: border-box; margin: 0px; padding: 0px; outline: none;\" /\u003eKhi sử dụng Heliocare, bạn vẫn nên sử dụng kèm kem chống nắng để đạt được hiệu quả tối ưu.\u003cbr style=\"box-sizing: border-box; margin: 0px; padding: 0px; outline: none;\" /\u003ePhụ nữ có thai hoặc đang cho con bú cần sự tư vấn của bác sĩ trước khi sử dụng viên uống chống nắng Heliocare\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 0px; padding: 0px; outline: none; color: #080003; font-family: 'Source Sans Pro', Arial, Helvetica, sans-serif;\"\u003e\u003cimg style=\"box-sizing: border-box; margin: 0px auto; padding: 0px; outline: none; border: 0px; vertical-align: middle; max-width: 100%; display: block;\" src=\"//file.hstatic.net/1000097940/file/vien-uong-chong-nang-heliocare-oral-picare1_grande.jpg\" width=\"600\" height=\"262\" /\u003e\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 0px; padding: 0px; outline: none; color: #080003; font-family: 'Source Sans Pro', Arial, Helvetica, sans-serif;\"\u003e\u003cbr style=\"box-sizing: border-box; margin: 0px; padding: 0px; outline: none;\" /\u003e\u003cstrong\u003eHƯỚNG DẪN SỬ DỤNG:\u003c/strong\u003e\u003cbr style=\"box-sizing: border-box; margin: 0px; padding: 0px; outline: none;\" /\u003eChống nắng (bình thường): 1 viên sáng, 1 viên trưa (Khuyến cáo thời điểm uống: 9h; 12h)\u003cbr style=\"box-sizing: border-box; margin: 0px; padding: 0px; outline: none;\" /\u003eChống nắng (tăng cường): 2 viên/ lần, lặp lại sau mỗi 3 tiếng\u003cbr style=\"box-sizing: border-box; margin: 0px; padding: 0px; outline: none;\" /\u003eNgăn ngừa lão hóa: 1 viên mỗi ngày/ quanh năm\u003cbr style=\"box-sizing: border-box; margin: 0px; padding: 0px; outline: none;\" /\u003eUống trước khi ra nắng 30 phút\u003cbr style=\"box-sizing: border-box; margin: 0px; padding: 0px; outline: none;\" /\u003e\u003cstrong\u003eLưu ý:\u003c/strong\u003e\u003cbr style=\"box-sizing: border-box; margin: 0px; padding: 0px; outline: none;\" /\u003e- Tránh xa tầm với của trẻ em.\u003cbr style=\"box-sizing: border-box; margin: 0px; padding: 0px; outline: none;\" /\u003e- Không sử dụng quá thời hạn in trên nắp hộp.\u003cbr style=\"box-sizing: border-box; margin: 0px; padding: 0px; outline: none;\" /\u003e- Bảo quản nơi khô ráo và thoáng mát\u003cbr style=\"box-sizing: border-box; margin: 0px; padding: 0px; outline: none;\" /\u003e\u003cstrong\u003eTHÀNH PHẦN:\u003c/strong\u003e\u003cbr style=\"box-sizing: border-box; margin: 0px; padding: 0px; outline: none;\" /\u003e240 mg Fernblock\u003cbr style=\"box-sizing: border-box; margin: 0px; padding: 0px; outline: none;\" /\u003e50 mg Té verde\u003cbr style=\"box-sizing: border-box; margin: 0px; padding: 0px; outline: none;\" /\u003e5 mg Betacaroteno\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 0px; padding: 0px; outline: none; color: #080003; font-family: 'Source Sans Pro', Arial, Helvetica, sans-serif;\"\u003e\u003cbr style=\"box-sizing: border-box; margin: 0px; padding: 0px; outline: none;\" /\u003eXuất xứ: \u003cstrong\u003eTây Ban Nha\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 0px; padding: 0px; outline: none; color: #080003; font-family: 'Source Sans Pro', Arial, Helvetica, 