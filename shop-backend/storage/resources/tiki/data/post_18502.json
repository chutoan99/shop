"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":1000,"discount_rate":1,"rating_average":4.7,"review_count":422,"review_text":"(422)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/e6/89/a2/f1d3746006e1440934dc5dcad4bbfa70.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1785,"all_time_quantity_sold":1494,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch1 style=\"text-align: center;\"\u003e\u003cspan style=\"color: #ff6600;\"\u003e\u003cstrong\u003eCon lăn tập cơ bụng 4 bánh Chính Hãng miDoctor\u003c/strong\u003e\u003c/span\u003e\u003c/h1\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cstrong\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/b9/76/1e/5601e2e21db503fa8a3eb61d0833feed.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eMô tả sản phẩm:\u003c/strong\u003e\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cp\u003eThiết kế đơn giản; gọn nhẹ; dễ sử dụng, tập hiệu quả động hợp thời trang. Giảm mỡ bụng; nhanh chóng lấy lại vóc dáng thon gọn; săn chắc động hợp thời trang. Dễ dàng sử dụng với nhiều tư thế và thao tác cho sức khỏe dẻo dai; cơ bắp săn chắc; khỏe mạnh và thon gọn động hợp thời trang\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003ePhù hợp sử dụng cho tất cả mọi người\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eCon Lăn Tập Cơ Bụng 4 Bánh Chính Hãng miDoctor là bộ dụng cụ tập luyện dành cho những người bận rộn hay không muốn mất nhiều thời gian đến phòng tập nhưng vẫn mong có 1 thân hình săn chắc, khỏe mạnh.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eThiết kế tiện dụng, chắc chắn với nguyên liệu nhựa cao cấp, cứng chắc, kích thước nhỏ gọn dễ cất giữ.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eCon lăn có thiết kế, cấu tạo đơn giản nhưng đa năng, có thể tập cho nhiều bộ phận cơ thể: bụng, eo, tay, đùi, lưng. Thiết kế nhỏ gọn giúp tiết kiệm không gian và thời gian tập luyện. \u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eBánh xe con lăn nhỏ nhưng cực kỳ chắc chắn với vỏ cao su bọc ngoài được thiết kế nhám sẽ giúp bạn dễ dàng di chuyển trên mặt đất mà không sợ bị trơn trượt.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eCó khả năng chịu sức nặng của người tập lên tới 120kg.\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/33/99/59/be1912f0ff72dba2b75907ccaf13c3b6.png\" alt=\"Con lăn tập cơ bụng chính hãng\" width=\"750\" height=\"614\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/7c/4a/a8/9ab816d5ccb0c2b973f1bc7e43b83333.png\" alt=\"Con Lăn Tập Cơ Bụng\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/51/d5/e1/32d68673d5f98136f42243e12fa29792.png\" alt=\"con lăn tập bụng\" width=\"750\" height=\"585\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/4c/bc/e8/9ec6fd76a564b17ebb3d71224792e287.png\" alt=\"con lăn tập bụng\" width=\"750\" height=\"453\" /\u003e\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eHướng dẫn cách sử dụng Con lăn tập bụng 4 bánh chính hãng miDoctor:\u003c/strong\u003e\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cp\u003e\u003cstrong\u003eB1:\u003c/strong\u003e Đầu tiên bạn nên trong tư thế quỳ đầu gối lên tấm thảm (Bạn có thể dùng Thảm tập yoga chính hãng của miDoctor nhé), 2 tay đặt vào hai bên tay cầm của con lăn tập bụng 4 bánh. Chú ý tay cầm thoải mái không quá chặt dễ gây tê mỏi tay và khó cử động, không cầm quá lỏng vì dễ bị trượt tay khi bạn đẩy con lăn về phía trước\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003e\u003cstrong\u003eB2:\u003c/strong\u003e Dùng lực từ từ đẩy con lăn tập bụng theo hướng thẳng về phía trước với 1 khoảng cách nhất định theo khả năng của mình nhưng đảm bảo căng hết thân người. Tư thế khi đẩy con lăn tập bụng 4 bánh về phía trước sao cơ thể song song với mặt sàn, giữ Lưng và đầu, Tay thẳng. Hít thở đều, tập hít thở từ bụng để có tác dụng lên vùng cơ bụng nhiều hơn\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003e\u003cstrong\u003eB3:\u003c/strong\u003e Tiếp theo bạn kéo con lăn về gần phía thân người của mình sao cho vuông góc với vai\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003e\u003cstrong\u003eB4:\u003c/strong\u003e Lặp lại động tác để tiếp tục bài tập, thực hiện khoảng 15 – 20 lần lặp.\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/a7/8e/87/c3152399ac020dbce556d56ab1bdc575.png\" alt=\"Con lăn tập cơ bụng chính hãng\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/b8/26/03/bacfd9acdeb73c229fa6f76f0d39c431.png\" alt=\"con lăn tập cơ bụng\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/4b/66/ac/fe79d448b006e95ae971d7133c30c6ed.png\" alt=\"con lăn tập cơ bụng\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/31/e9/a9/9bd8c696d31a5754b0af0898d49299e3.png\" alt=\"con lăn tập cơ bụng\" width=\"750\" height=\"562\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003e\u003cstrong\u003eSử dụng sản phẩm chính hãng để tránh phải hàng giả hàng nhái, hàng kém chất lượng\u003c/strong\u003e\u003c/em\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/e6/89/a2/f1d3746006e1440934dc5dcad4bbfa70.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e6/89/a2/f1d3746006e1440934dc5dcad4bbfa70.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e6/89/a2/f1d3746006e1440934dc5dcad4bbfa70.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e6/89/a2/f1d3746006e1440934dc5dcad4bbfa70.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e6/89/a2/f1d3746006e1440934dc5dcad4bbfa70.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/b9/76/1e/140f2db777b92d72f597bd8d22b8e9ae.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b9/76/1e/140f2db777b92d72f597bd8d22b8e9ae.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b9/76/1e/140f2db777b92d72f597bd8d22b8e9ae.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b9/76/1e/140f2db777b92d72f597bd8d22b8e9ae.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b9/76/1e/140f2db777b92d72f597bd8d22b8e9ae.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/66/4b/73/4c4fea5bbe1f8317e83c71861c6c3812.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/produ