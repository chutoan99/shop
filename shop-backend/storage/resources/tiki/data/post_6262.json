null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":48000,"discount_rate":4,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/9b/6c/0a/865e685b0ac4556650ee703a096e93bd.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1243,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003ciframe src=\"//www.youtube.com/embed/HAp9Jf0Xo54?t=1s\" width=\"999\" height=\"560\" allowfullscreen=\"allowfullscreen\"\u003e\u003c/iframe\u003e\u003c/p\u003e\n\u003cp\u003eChúng ta đã quá quen thuộc với những chiếc bồn tắm kiểu truyền thống được làm từ những chất liệu như gạch, gỗ, men sứ, composite nhưng còn sản phẩm bồn tắm nhựa gấp gọn thì hiện nay vẫn còn chưa có nhiều người biết đến. Bồn tắm nhựa gấp gọn có thể coi là một loại chậu tắm bằng nhựa có hình dáng tương tự như một chiếc bồn tắm truyền thống, có kích thước lớn đủ để một người trưởng thành có thể nằm, ngồi một cách thoải mái bên trong. Điểm khác biệt của loại bồn tắm này là nó được thiết kế với cấu tạo thông minh, có thể gấp gọn lại chỉ bằng 1/3 so với kích thước ban đầu nên rất tiết kiệm diện tích.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/fc/d7/57/0848b1c116190e8ed4b425c7088f7585.jpg\" alt=\"\" width=\"750\" height=\"749\" /\u003e\u003c/p\u003e\n\u003cp\u003eƯu điểm lớn nhất của sản phẩm đó là có thể lắp ráp cũng như gấp gọn một cách nhanh chóng, dễ dàng giúp tiết kiệm tối đa không gian trong phòng tắm\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/e7/f7/15/009e9b923de12003c06ae8a5bf2833a0.jpg\" alt=\"\" width=\"720\" height=\"720\" /\u003e\u003c/p\u003e\n\u003cp\u003eBên cạnh đó, với ưu điểm có thể gấp gọn, bạn hoàn toàn có thể mang theo chiếc bồn tắm này trong các chuyến du lịch, dã ngoại của gia đình.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/5b/ba/3c/60579e95fb4a6f3948a8b5ad4a61fa2d.jpg\" alt=\"\" width=\"720\" height=\"720\" /\u003e\u003c/p\u003e\n\u003cp\u003eThân của chiếc bồn tắm gấp sử dụng chất liệu PP và TPE bền bỉ, chịu tải tốt, chống trầy xước do va đập, dễ vệ sinh và cũng rất an toàn với cơ thể người. Với chất liệu cao cấp này, bạn hoàn toàn có thể pha nước ấm để ngâm mình thư giãn hoặc tắm thuốc bắc để làm đẹp và thải độc cơ thể như với những chiếc bồn men sứ truyền thống. Nó cũng phù hợp để sử dụng cho cả trẻ nhỏ - những đối tượng có làn da nhạy cảm với các chất liệu nhựa tổng hợp nhất.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/9b/6c/0a/ba20df9a35fb9cf751f597a2d8f20f6d.jpg\" alt=\"\" width=\"720\" height=\"720\" /\u003e\u003c/p\u003e\n\u003cp\u003eNắp bồn này cũng có thể tháo rời khi cần để bạn có thể có không gian nằm xuống một cách thoải mái hơn trong lúc ngâm mình. Bồn tắm có thiết kế ống dẫn bên cạnh giúp bạn dễ dàng xả nước và vệ sinh sau khi sử dụng.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/cf/a1/03/3709e673bca4bfe659810f3e0f4b5c80.jpg\" alt=\"\" width=\"720\" height=\"720\" /\u003e\u003c/p\u003e\n\u003cp\u003eBồn tắm nhựa gấp gọn có phần thành cao đến 58cm giúp tránh tình trạng nước bắn tung tóe ra bên ngoài gây trơn trượt, mất an toàn khi di chuyển xung quanh bồn. Hai bên thành bồn tắm có tay nắm thuận tiện, đảm bảo an toàn khi bạn đứng lên bước ra ngoài. Phần chân đế được thiết kế chắc chắn, khả năng chịu tải cao nên bạn có thể hoàn toàn thư giãn khi nằm bên trong mà không lo bị gãy, đổ\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/dd/f3/ef/573488af4a69ade8d10b1a26b9b2fce8.jpg\" alt=\"\" width=\"720\" height=\"720\" /\u003e\u003c/p\u003e\n\u003cp\u003eƯu điểm và lợi ích nổi bật của bồn tắm gấp gọn: Thiết kế chắc chắn, dễ dàng gấp gọn lại khi không sử dụng. Trọng lượng nhẹ ( dưới 10 Kg) dễ dàng di chuyển và gấp gọn. Đáy bồn tắm tạo điểm chống trơn trượt và massage bàn chân khi ngâm mình. Kích thước lớn phù hợp sử dụng cho cả người lớn và trẻ em sử dụng. Chất liệu silicon kết hợp nhựa PP bền bỉ, chắc chắn. Chịu được trọng lượng lớn cả người dùng và nước. Dễ dàng tháo xả nước, với vòi ở đáy và lưng bồn tắm sau khi sử dụng xong. Phù hợp tắm ngâm, tắm xả stress cùng dầu dưỡng. Tăng cường sức khỏe cơ thể và làn da.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ac/0f/af/ae1589341a233efae500f55055061bba.jpg\" alt=\"\" width=\"720\" height=\"720\" /\u003e\u003c/p\u003e\n\u003cp\u003eThông tin chi tiết sản phẩm:\u003c/p\u003e\n\u003cp\u003eTên sản phẩm: Bồn tắm silicon gấp gọn.\u003c/p\u003e\n\u003cp\u003eChất liệu: Silicon và PP, thành nhựa cứng.\u003c/p\u003e\n\u003cp\u003eKích thước: 118x60x58cm\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/77/06/dd/e1a1c559c87e7374308d3fb1871f8c38.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ec/31/55/ac13d5245db8c4429409e865444c0905.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/04/b4/f0/53ae51657d4d2b8a80611c4ca0eb582a.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eHướng dẫn sử dụng bồn tắm xếp gọn Để xếp gọn bồn tắm sau khi sử dụng, quý khách vui lòng úp ngược bồn tắm và làm theo 2 bước đơn giản sau: Bước 1: Dùng tay ấn thùng bồn tắm lại như hình mô tả. Bước 2: Gập chân của bồn tắm. Dựng bồn tắm lên và đặt vào vị trí như ý muốn.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/da/2b/8a/f78e7365a4ce678dcf37c6f8c47906fe.jpg\" alt=\"\" width=\"750\" height=\"980\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/9b/6c/0a/865e685b0ac4556650ee703a096e93bd.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/9b/6c/0a/865e685b0ac4556650ee703a096e93bd.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/9b/6c/0a/865e685b0ac4556650ee703a096e93bd.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9b/6c/0a/865e685b0ac4556650ee703a096e93bd.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9b/6c/0a/865e685b0ac4556650ee703a096e93bd.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/0f/3a/a5/95300ca51c5b87689f18b7bb687b64b9.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0f/3a/a5/95300ca51c5b87689f18b7bb687b64b9.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/0f/3a/a5/95300ca51c5b87689f18b7bb687b64b9.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0f/3a/a5/95300ca51c5b87689f18b7bb687