olor":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":4100,"discount_rate":18,"rating_average":4.8,"review_count":28,"review_text":"(28)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/1b/91/00/594678132a67521c2dc35867371efa22.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":582,"all_time_quantity_sold":1069,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lxm0fmz0ah9764\" width=\"1200\" height=\"738\" alt=\"vn-11134208-7r98o-lxm0fmz0ah9764\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lxm0fmz0bvtnee\" width=\"1200\" height=\"738\" alt=\"vn-11134208-7r98o-lxm0fmz0bvtnee\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lxm0fmz0dae3fa\" width=\"1200\" height=\"739\" alt=\"vn-11134208-7r98o-lxm0fmz0dae3fa\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lxm0fmz0eoyj91\" width=\"1200\" height=\"738\" alt=\"vn-11134208-7r98o-lxm0fmz0eoyj91\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lxm0fmz0g3iz04\" width=\"1200\" height=\"738\" alt=\"vn-11134208-7r98o-lxm0fmz0g3iz04\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lxm0fmz0hi3f8b\" width=\"1200\" height=\"738\" alt=\"vn-11134208-7r98o-lxm0fmz0hi3f8b\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lxmfq954r07v95\" width=\"1200\" height=\"738\" alt=\"vn-11134208-7r98o-lxmfq954r07v95\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lxmfq97d37iz79\" width=\"1200\" height=\"738\" alt=\"vn-11134208-7r98o-lxmfq97d37iz79\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lxmfq97cnrh522\" width=\"1200\" height=\"739\" alt=\"vn-11134208-7r98o-lxmfq97cnrh522\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lxmfq97d37q11c\" width=\"1200\" height=\"738\" alt=\"vn-11134208-7r98o-lxmfq97d37q11c\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lxmfq97cnra3b4\" width=\"1200\" height=\"738\" alt=\"vn-11134208-7r98o-lxmfq97cnra3b4\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lxmfq990lbrt21\" width=\"1200\" height=\"738\" alt=\"vn-11134208-7r98o-lxmfq990lbrt21\" /\u003e\u003c/p\u003e\n\u003cp\u003eVới thiết kế hộp khoa học giúp tránh bay hơi và chảy mực, bình mực bút lông bảng WBI-01 không chỉ tiện lợi mà còn giúp tiết kiệm hơn khi bơm mực. Sản phẩm có màu mực tươi, nhanh khô, dễ dàng xóa sạch trên bảng trắng hoặc bề mặt nhẵn. \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eTÍNH NĂNG SẢN PHẨM\u003c/p\u003e\n\u003cp\u003e️ Sản phẩm dùng để bơm mực cho các loại bút lông bảng.\u003c/p\u003e\n\u003cp\u003e️ Tặng kèm 01 ngòi bút lông bảng.\u003c/p\u003e\n\u003cp\u003e️ Màu mực tươi, nhanh khô, dễ dàng xóa sạch trên bảng trắng hoặc bề mặt nhẵn.\u003c/p\u003e\n\u003cp\u003e️ Van tiết lưu giúp mực luôn nhỏ thành dạng giọt khi bơm, giúp cho việc bơm mực dễ dàng và thuận tiện.\u003c/p\u003e\n\u003cp\u003e️ Thiết kế hộp khoa học giúp tránh bay hơi và chảy mực.\u003c/p\u003e\n\u003cp\u003e️ Mực không độc hại, đạt tiêu chuẩn quốc tế. \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eTIÊU CHUẨN VÀ BẢO QUẢN\u003c/p\u003e\n\u003cp\u003e️ Tiêu chuẩn: Mực đạt tiêu chuẩn Châu Âu EN 71/3, EN 71/9 và Mỹ ASTM D-4236. Sản xuất theo tiêu chuẩn TCCS 024:2010/TL-MBLB.\u003c/p\u003e\n\u003cp\u003e️ Dung tích mực: 25 ml\u003c/p\u003e\n\u003cp\u003e️ Đóng gói: 1 lọ/ hộp.\u003c/p\u003e\n\u003cp\u003e️ Trọng lượng: 42 gram.\u003c/p\u003e\n\u003cp\u003e️ Bảo quản: Không thích hợp cho trẻ dưới 3 tuổi. Bảo quản nơi khô ráo, thoáng mát, tuyệt đối tránh xa nguồn nhiệt, hóa chất. Vặn đóng nắp sau khi sử dụng. Tránh làm bẩn hoặc thấm mực lên quần, áo, túi áo, vật có bề mặt thấm hút.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eTập đoàn Thiên Long là công ty hàng đầu trong ngành văn phòng phẩm tại Việt Nam, chuyên cung cấp các sản phẩm và dịch vụ chất lượng cao cho quý khách hàng. Hiện tại, Thiên Long có 4 nhãn hàng nổi tiếng được phân phối rộng khắp trong và ngoài nước là Thiên Long, Flexoffice, Colokit và Bizner.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e#bia #biacung #biala #biakeptailieu #but #butlong #butlongvietbang #butlongdau #butdaquang #thienlong #thienlonggroup #thienlongoffficialstore #butxoa #filela #butthienlong #vanphongpham #kim #kimbam #bamlogiay #kep #kepbuom #cat #khaydungbut #bang #keo #keodan #keo502 #so #baothu #giay #flexoffice\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/1b/91/00/594678132a67521c2dc35867371efa22.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/1b/91/00/594678132a67521c2dc35867371efa22.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/1b/91/00/594678132a67521c2dc35867371efa22.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1b/91/00/594678132a67521c2dc35867371efa22.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1b/91/00/594678132a67521c2dc35867371efa22.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/3b/97/98/a19ee2ccd8958f4f6cf18ef9b223267c.jpg","is_gallery":true,"label":null,"large_url":"https: