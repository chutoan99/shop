ge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":151000,"discount_rate":43,"rating_average":5,"review_count":3,"review_text":"(3)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/7a/62/a3/a2de447183a61cbbec8d28d5a9ba11b5.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":237,"all_time_quantity_sold":5,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch1 class=\"pdp-mod-product-badge-title\" style=\"text-align:center;\"\u003eKem dưỡng trắng da Hoa Thiên\u003c/h1\u003e\n\u003ch1 class=\"pdp-mod-product-badge-title\" style=\"text-align:center;\"\u003eGiải pháp từ thiên nhiên cho làn da trắng sáng mịn màng và rạng rỡ 30g\u003c/h1\u003e\n\u003cp class=\"QN2lPu\"\u003eKem dưỡng trắng da Hoa Thiên được chiết xuất từ các thành phần thiên nhiên như: mật ong lên men (Nhật Bản), dầu cám gạo (Nhật Bản), chiết suất Hoa Anh Đào, rễ Cam Thảo…giúp nuôi dưỡng làn da trắng sáng tự nhiên, nâng tông da, tăng cường độ ẩm, tăng tính đàn hồi, ngăn ngừa lão hóa giúp da luôn tươi trẻ dài lâu.\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e \u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eChất kem mỏng mịn giúp hiệu chỉnh tông da sáng mịn đều màu, che mờ khuyết điểm mà không gây bết rít hay để lại vệt trắng trên da. Đồng thời cùng với công nghệ Công Nghệ Ultrafine UV Titan giúp bảo vệ da trước tác hại của tia UVA và UVB từ ánh nắng mặt trời, hạn chế tác nhân bên ngoài gây hại cho da.\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e.\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eXuất xứ : Việt Nam\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eMã sản phẩm : CHT01\u003c/p\u003e\n\u003cdiv class=\"QN2lPu\"\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"P7IbkE\"\u003e\u003cimg class=\"GqYslU hnult1\" src=\"https://down-vn.img.susercontent.com/file/vn-11134208-7r98o-lqmrzqe9b8iae9\" alt=\"vn-11134208-7r98o-lqmrzqe9b8iae9\" /\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cp class=\"QN2lPu\"\u003e1. THÀNH PHẦN KEM DƯỠNG TRẮNG DA HOA THIÊN\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e1. 1 Thành phần chính\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e- Chiết xuất mật ong lên men: có tác dụng loại bỏ các tế bào chết dịu nhẹ nhờ acid Gluconic, không gây kích ứng, tổn thương da như các loại Acid thông thường. Nhờ đó mang lại hiệu quả làm trắng sáng tự nhiên cho làn da.\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e \u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e- Chiết xuất Dầu Cám Gạo: có khả năng bảo vệ khỏi gốc tự do, làm chậm quá trình lão hóa, tăng tính đàn hồi cho da. Ngoài ra, dầu Cám Gạo còn có khả năng giữ ẩm nuôi dưỡng làn da sáng mịn. \u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e \u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e- Chiết xuất hoa Anh Đào Nhật Bản ức chế trung tâm tạo sắc tố đen Melanin, giúp dưỡng sáng da và ngăn ngừa hình thành nám, sạm, tàn nhang. Đồng thời các hoạt chất chống oxy hóa trong Hoa Anh Đào giúp bảo vệ da khỏi tác động của các gốc tự do, đào thải nám sạm, ngăn ngừa lão hóa da, Bên cạnh đó, tinh chất hoa Anh Đào còn thúc đẩy hình thành collagen, giúp tăng độ đàn hồi và săn chắc của da, làm dịu và các tổn thương do tác động của tia cực tím và môi trường. \u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e \u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e- Chiết xuất rễ Cam Thảo: giàu hàm lượng hoạt chất Glycyrrhizate làm dịu da. \u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e- Alpha-Arbutin: Hoạt chất dưỡng trắng da lành tính có khả năng ức chế  enzyme Tyrosinase ngăn hình thành hắc sắc tố Melanin trong da, giúp làm sáng da, giảm các đốm nâu, từ đó giúp da trở lên trắng sáng, đều màu. \u003c/p\u003e\n\u003cdiv class=\"QN2lPu\"\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"P7IbkE\"\u003e\u003cimg class=\"GqYslU hnult1\" src=\"https://down-vn.img.susercontent.com/file/vn-11134208-7r98o-lqmrzqe9cn2qc7\" alt=\"vn-11134208-7r98o-lqmrzqe9cn2qc7\" /\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cp class=\"QN2lPu\"\u003e1.2 Thành phần đầy đủ\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eAqua, Cyclopentasiloxane, Titanium Dioxide, Dimethicone, Glycerin, Caprylic/Capric Triglyceride, Cetearyl Alcohol, Hydroxyethyl Acrylate/Sodium Acryloyldimethyl Taurate Copolymer, Silica, Gluconobacter/Honey Ferment Filtrate, Oryza Sativa Bran Oil, Prunus Lannesiana Flower Extract, Alpha-Arbutin, Dipotassium Glycyrrhizate, Dextrin, Ascorbic Acid, Malic Acid, Allantoin, Sodium Acrylate/Acryloyldimethyltaurate/Dimethylacrylamide Crosspolymer, Polysorbate 60, Aluminum hydroxide, Phospholipids, Isohexadecane, Stearic acid, Ethylhexyl Methoxycinnamate, Benzophenone-3, Butyl Methoxydibenzoylmethane, Triethoxycaprylylsilane, Disodium EDTA, Butylene Glycol, Ethylhexylglycerin, Phenoxyethanol, Citric Acid, Fragrance  \u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e \u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e2.CÔNG DỤNG \u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eGiúp dưỡng da trắng sáng tự nhiên, làm giảm tác hại của tia UV và ánh sáng xanh, giúp hiệu chỉnh tông da sáng mịn đều màu. Tăng cường độ ẩm, cải thiện cấu trúc da giúp da luôn mịn màng, mềm mại. Giúp làm mờ các nếp nhăn, nám, sạm, tàn nhang, làm chậm quá trình lão hóa.\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e \u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e3. ĐỐI TƯỢNG SỬ DỤNG\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e - Người có nhu cầu dưỡng trắng, duy trì làn da mịn màng, tươi trẻ\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e - Người đang gặp phải các vấn đề về da như đen sạm, da nám, không đều màu, thô ráp và thiếu sức sống .\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e- Người muốn tìm một dòng sản phẩm chăm sóc da an toàn, hiệu quả và không gây kích ứng. \u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e \u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e4. HƯỚNG DẪN SỬ DỤNG: \u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eSử dụng sau các bước làm sạch da. Lấy một lượng vừa đủ, nhẹ nhàng thoa lên mặt và cổ. Có thể sử dụng như kem dưỡng trắng mỗi buổi sáng hoặc kem trang điểm vào bất cứ khi nào cần nâng tông da.\u003c/p\u003e\n\u003cdiv class=\"QN2lPu\"\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"P7IbkE\"\u003e\u003cimg class=\"GqYslU hnult1\" src=\"https://down-vn.img.susercontent.com/file/vn-11134208-7r98o-lqmrzqe9e1n632\" alt=\"vn-11134208-7r98o-lqmrzqe9e1n632\" /\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cp class=\"QN2lPu\"\u003e5. BẢO QUẢN \u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eNơi khô ráo, tránh ánh sáng trực tiếp và nhiệt độ cao\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e \u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e6. ƯU ĐIỂM NỔI BẬT\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eKem dưỡng trắng da Hoa Thiên kết hợp cả hai cơ chế bên trong lẫn bên ngoài đem lại hiệu quả tối ưu trong việc dưỡng da trắng sáng, mịn màng, tươi trẻ.\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eCơ chế bên ngoài: Tẩy tế bào chết dịu nhẹ, dưỡng ẩm, làm mềm da nhờ thành phần mật ong lên men, mà không gây kích ứng tổn thương da.\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eCơ chế bên trong: Chiết xuất Hoa Anh Đào:  Giúp ức chế hắc sắc tố Melanin và nuôi dưỡng làn da trắng sáng mờ nám sạm.\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eAlpha Arbutin: Đồng thời cung cấp các dưỡng chất giúp nuôi dưỡng da từ sâu bên trong.\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e \u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e7. QUY CÁCH\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eHộp 30g\u