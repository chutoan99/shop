ển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/dd/e9/ce/efe0cc02eff3f16873a7a0611e1fd9b2.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/dd/e9/ce/efe0cc02eff3f16873a7a0611e1fd9b2.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/dd/e9/ce/efe0cc02eff3f16873a7a0611e1fd9b2.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/dd/e9/ce/efe0cc02eff3f16873a7a0611e1fd9b2.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/dd/e9/ce/efe0cc02eff3f16873a7a0611e1fd9b2.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/fa/ab/5e/ebe139e93e083538101a350a61312e94.jpeg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/fa/ab/5e/ebe139e93e083538101a350a61312e94.jpeg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/fa/ab/5e/ebe139e93e083538101a350a61312e94.jpeg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fa/ab/5e/ebe139e93e083538101a350a61312e94.jpeg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fa/ab/5e/ebe139e93e083538101a350a61312e94.jpeg"},{"base_url":"https://salt.tikicdn.com/ts/product/67/80/f7/b624976e0ea624ee6d049cc8e6ca35ce.jpeg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/67/80/f7/b624976e0ea624ee6d049cc8e6ca35ce.jpeg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/67/80/f7/b624976e0ea624ee6d049cc8e6ca35ce.jpeg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/67/80/f7/b624976e0ea624ee6d049cc8e6ca35ce.jpeg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/67/80/f7/b624976e0ea624ee6d049cc8e6ca35ce.jpeg"},{"base_url":"https://salt.tikicdn.com/ts/product/e5/1b/91/545738c0da2696f5d0ddcf9bc7ac5b46.jpg","i