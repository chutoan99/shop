ht":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":186000,"discount_rate":57,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ab/f7/2a/edec387ef0e1cbbf8868a7d6313e5e09.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":905,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eNước hoa hồng Numee Glow Up sạch sâu, thu nhỏ lỗ chân lông 150ML\u003c/p\u003e\n\u003cp\u003eMô tả sản phẩm:\u003c/p\u003e\n\u003cp\u003eNước hoa hồng Numee Glow Up sạch sâu, thu nhỏ lỗ chân lông 150ML với công thức đặc biệt nhẹ nhàng làm sạch da, lấy đi các bụi bẩn cuối cùng còn sót lại sau bước sữa rửa mặt, cân bằng độ pH cho da và chuẩn bị cho các bước chăm sóc tiếp theo. Sản phẩm tạo cảm giác thông thoáng và se khít lỗ chân lông giúp da sạch thoáng và tươi mới hơn.\u003c/p\u003e\n\u003cp\u003eSản phẩm đã được kiểm nghiệm da liễu, an toàn cho mọi loại da.\u003c/p\u003e\n\u003cp\u003eCông dụng:\u003c/p\u003e\n\u003cp\u003e+ Chiết xuất Betaine từ của cải đường (1%): Bảo vệ các tế bào da khỏi tác động của môi trường và kiểm soát cân bằng lượng nước giúp dưỡng ẩm và làm dịu da.\u003c/p\u003e\n\u003cp\u003e+ Dịch chiết xuất cây phỉ (Dịch chiết Hamamelis Virginiana 1%): giúp điều tiết bã nhờn và giảm thiểu tình trạng lỗ chân lông to.\u003c/p\u003e\n\u003cp\u003eThành phần:Aqua, Propylene Glycol, Alcohol Denat, Salicylic Acid, Betaine, Hamamelis Virginiana Water, Sodium Hydroxide, Sodium Benzoate, Potassium Sorbate, Citric Acid.\u003c/p\u003e\n\u003cp\u003eSản phẩm nhẹ nhàng làm sạch da, lấy đi các bụi bẩn cuối cùng còn sót lại sau bước sữa rửa mặt\u003c/p\u003e\n\u003cp\u003eHướng dẫn sử dụng: Lấy một lượng thích hợp rồi nhẹ nhàng thoa đều lên mặt và cổ. Vỗ nhẹ để đạt được hiệu quả thẩm thấu tốt nhất.\u003c/p\u003e\n\u003cp\u003eBảo quản: Bảo quản nơi thoáng mát, tránh ánh nắng trực tiếp của mặt trời và tầm tay trẻ em.\u003c/p\u003e\n\u003cp\u003eXuất xứ: Tây Ban Nha\u003c/p\u003e\n\u003cp\u003eThông tin thương hiệu:\u003c/p\u003e\n\u003cp\u003eNUMEE – VẺ ĐẸP MỚI CHO LÀN DA\u003c/p\u003e\n\u003cp\u003eNumee hiện đang trở thành thương hiệu làm đẹp được yêu thích tại Tây Ban Nha và tạo nên những xu hướng mới lan rộng trên toàn thế giới, trong đó có Việt Nam. Mục đích lớn nhất của Numee chính là giúp khách hàng có thể tiếp cận được với mỹ phẩm SẠCH, thành phần thiên nhiên cùng công thức tuyệt vời với giá thành hợp lý nhất.\u003c/p\u003e\n\u003cp\u003eĐặc biệt, sản phẩm từ Numee sẽ giúp bạn có các giải pháp chăm sóc da an toàn, dịu nhẹ và rất thân thiện với môi trường. Đây cũng chính là điều tuyệt vời thể hiện sự trân trọng, góp phần bảo vệ môi trường sống ngày càng tốt đẹp hơn. Bên cạnh đó, Numee rất chú trọng về màu sắc, thiết kế để tạo nên những sản phẩm đẹp về hình thức cùng chất lượng vượt trội.\u003c/p\u003e\n\u003cp\u003eCó mặt tại Việt Nam từ cuối năm 2021 do DaiLinh Group tiên phong phân phối độc quyền trên thị trường Việt, các sản phẩm chăm sóc da của Numee hứa hẹn sẽ trở thành một trong những thương hiệu làm đẹp chất lượng, uy tín và được khách hàng tin dùng.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ab/f7/2a/edec387ef0e1cbbf8868a7d6313e5e09.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ab/f7/2a/edec387ef0e1cbbf8868a7d6313e5e09.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ab/f7/2a/edec387ef0e1cbbf8868a7d6313e5e09.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ab/f7/2a/edec387ef0e1cbbf8868a7d6313e5e09.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ab/f7/2a/edec387ef0e1cbbf8868a7d6313e5e09.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/8b/fd/12/22344f95021507cd3d5ff05829dcc453.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/8b/fd/12/22344f95021507cd3d5ff05829dcc453.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/8b/fd/12/22344f95021507cd3d5ff05829dcc453.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8b/fd/12/22344f95021507cd3d5ff05829dcc453.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8b/fd/12/22344f95021507cd3d5ff05829dcc453.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/e4/a1/6b/17dca92914b19d2ed990b7d50ba76592.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e4/a1/6b/17dca92914b19d2ed990b7d50ba76592.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e4/a1/6b/17dca92914b19d2ed990b7d50ba76592.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e4/a1/6b/17dca92914b19d2ed990b7d50ba76592.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e4/a1/6b/17dca92914b19d2ed990b7d50ba76592.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/6c/a8/9f/19cfde7816