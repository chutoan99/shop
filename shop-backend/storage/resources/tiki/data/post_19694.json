06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.8,"review_count":42,"review_text":"(42)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/37/6c/6b/ba7634984492b6e86999b18911f091b6.jpeg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1028,"all_time_quantity_sold":291,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2\u003e\u003cstrong\u003eCông dụng Dầu gội gừng Hà thủ ô Weilaiya\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003e Nuôi dưỡng và phục hồi hư tổn cho mái tóc do các tác nhân khác như uốn, nhuộm, ép; do tạo kiểu bằng nhiệt; do ô nhiễm môi trường,…\u003c/p\u003e\n\u003cp\u003e Giúp lưu thông khí huyết đem lại cảm giác thư giãn và sảng khoái cho da đầu, giảm tình trạng đau nhức đầu hoặc đau nửa đầu.\u003c/p\u003e\n\u003cp\u003e Kích thích mọc tóc nhanh và dài tóc : Nhờ vào tác dụng của tinh chất gừng thúc đẩy tuần hoàn máu tăng nhanh tốc độ mọc tóc và kết hợp với dầu oliu tóc khỏe hơn không bị gãy rụng.\u003c/p\u003e\n\u003cp\u003e Trị sạch gàu và các bụi bẩn bám trên da đầu giúp tóc luôn sạch sẽ\u003c/p\u003e\n\u003cp\u003e Cung cấp dưỡng chất cho tóc giúp tóc chắc khoẻ, mềm mượt và óng ả.\u003c/p\u003e\n\u003cp\u003e Dầu gội có mùi hương dễ chịu giúp đem lại cảm giác lôi cuốn và quý phái\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eThành phần Dầu gội gừng Hà thủ ô Weilaiya\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003e \u003cu\u003e\u003cem\u003eGừng\u003c/em\u003e\u003c/u\u003e: Có 3 công năng lớn mà 2 thành phần từ gừng mang lại\u003c/p\u003e\n\u003cp\u003eLá gừng: chống oxy hóa hiệu quả\u003c/p\u003e\n\u003cp\u003eTinh chất Củ gừng: Có hoạt tính ức chế vi khuẩn, kháng viêm nên giảm ngứa rõ rệt, tinh chất gừng còn giúp hoạt huyết, thẩm thấu cực nhanh, kiềm dầu và mang lại cảm giác thư thái cho da đầu. Giữ độ ẩm cho tóc và kích thích mọc tóc.\u003c/p\u003e\n\u003cp\u003e \u003cu\u003e\u003cem\u003eHà thủ ô:\u003c/em\u003e\u003c/u\u003e\u003c/p\u003e\n\u003cp\u003eỞ đây có nói đến hoạt tính SOD - Superoxide dismutase\u003cbr /\u003eHoạt tính này có tác dụng rất lớn trong việc làm sạch nang tóc, hút bớt dầu.\u003cbr /\u003eBên cạnh đó, chúng không để lại chất cặn bã hay dư lượng sau khi làm sạch giống như các loại dầu gội khác, vì vậy mái tóc của bạn sẽ cảm thấy nhẹ nhàng và đầy đặn hơn.\u003c/p\u003e\n\u003cp\u003e \u003cu\u003e\u003cem\u003eHoa oải hương (Lavender):\u003c/em\u003e\u003c/u\u003e\u003c/p\u003e\n\u003cp\u003eTinh dầu hoa oải hương làm giảm các hiện tượng liên quan đến da đầu như rụng tóc, gàu, cải thiện tình trạng da đầu ngứa và bị kích ứng. Bên cạnh đó tinh dầu lavender còn có khả năng kháng viêm tự nhiên, nhờ vậy nó có thể bảo vệ tóc và da đầu tránh khỏi các tác hại của môi trường bên ngoài.\u003c/p\u003e\n\u003cp\u003e Ngoài ra, dầu gừng hà thủ ô còn kết hợp 2 thành phần trọng yếu, giúp nuôi dưỡng sâu da đầu:\u003c/p\u003e\n\u003cp\u003e\u003cu\u003e\u003cem\u003eDầu oliu\u003c/em\u003e\u003c/u\u003e: giảm gàu, khắc phục tình trạng bị đứt gãy tóc, tăng “sức khỏe” cho tóc, rất tốt đối với những người có tóc mỏng hoặc bị hói, tóc đã sử dụng hóa chất uốn nhuộm nhiều.\u003cbr /\u003e\u003cu\u003e\u003cem\u003eProtein Hydrolase\u003c/em\u003e\u003c/u\u003e: cung cấp chất dinh dưỡng cho da đầu , có khả năng giữ nước của lớp cutin dưới da, cung cấp Vitamin B và proline bảo vệ tóc.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/product/92/2e/68/4ac11ae46cdc96ce780b43d32ce5cf87.jpg\" alt=\"dsc00383vuong.jpg\" width=\"600\" height=\"600\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eĐối tượng sử dụng Dầu gội gừng Hà thủ ô Weilaiya\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003eDầu gội xả \u003cstrong\u003eWeilaiya \u003c/strong\u003ephù hợp cho mọi đối tượng nam, nữ, mọi độ tuổi.Đặc biệt, những người thường xuyên có những vấn đề về da đầu, gàu ngứa, rụng tóc, thưa tóc, hói đầu.\u003c/p\u003e\n\u003cp\u003e Sản phẩm thích hợp với phụ nữ sau khi sinh.\u003c/p\u003e\n\u003cp\u003e Tóc nhiều gàu, bóng dầu, thiếu sức sống.\u003c/p\u003e\n\u003cp\u003e Người đang gặp phải tình trạng rụng tóc nghiêm trọng và cần kích thích tóc mọc dày trở lại.\u003c/p\u003e\n\u003cp\u003e Người có nhu cầu phục hồi tóc hư tổn.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/f7/2d/23/f485250291323b22c707eb58043ae9ea.jpg\" alt=\"Bo_Dau_goi_xa_gung_Ha_Thu_O_Weilaiya___kich_thich_moc_toc__phuc_hoi_toc_hu_ton_(106453867_1390040424516604_1049176056115860026_o).jpg\" width=\"750\" height=\"1000\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eHướng dẫn sử dụng Dầu gội gừng Hà thủ ô Weilaiya\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003eBước 1: Làm ướt tóc với nước sạch.\u003c/p\u003e\n\u003cp\u003eBước 2: Lấy một lượng dầu gội đầu vừa đủ thoa lên tóc và tiến hành massage da đầu nhẹ nhàng và tạo bọt cho đến khi tóc sạch, sau đó gội sạch với nước. \u003c/p\u003e\n\u003cp\u003e\u003cu\u003e\u003cem\u003e\u003cstrong\u003eLưu ý: \u003c/strong\u003e\u003c/em\u003e\u003c/u\u003eNên sử dụng kết hợp dầu gội và dầu xả Weilaiya để đạt hiệu quả tốt nhất\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/2e/50/a9/242ea82dc7ab36aca8244cd26949fb37.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/37/6c/6b/ba7634984492b6e86999b18911f091b6.jpeg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/37/6c/6b/ba7634984492b6e86999b18911f091b6.jpeg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/37/6c/6b/ba7634984492b6e86999b18911f091b6.jpeg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/37/6c/6b/ba7634984492b6e86999b18911f091b6.jpeg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/37/6c/6b/ba7634984492b6e86999b18911f091b6.jpeg"},{"base_url":"https://salt.tikicdn.com/ts/product/55/b8/19/6c72f1814f14ea3a6e82fadead1977ee.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/55/b8/19/6c72f1814f14ea3a6e82fadead1977ee.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/55/b8/19/6c72f1814f14ea3a6e82fadead1977ee.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/55/b8/19/6c72f1814f14ea3a6e82fadead1977ee.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/55/b8/19/6c72f1814f14ea3a6e82fadead1977ee.png"},{"base_url":"https://salt.tikicdn.com/ts/product/ac/2f/ba/918b58881e212b8dc4b8947d5993a