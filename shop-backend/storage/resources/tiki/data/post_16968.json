"icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.5,"review_count":18,"review_text":"(18)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/5f/28/70/d8990439c41353a70382e5d61e42ec14.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1448,"all_time_quantity_sold":46,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2\u003eXe Thăng Bằng Cho Bé Từ 18 Tháng Đến 5 Tuổi, Giúp Bé Phát Triển Thể Chất Tối Ưu EBV GROUP, Tặng Chuông Xe Hình Bọ Rùa Đáng Yêu - Hàng Chính Hãng\u003c/h2\u003e\n\u003cp\u003e\u003ciframe src=\"//www.youtube.com/embed/sSijFWnuUyw\" width=\"560\" height=\"314\" allowfullscreen=\"allowfullscreen\"\u003e\u003c/iframe\u003e\u003c/p\u003e\n\u003ch2\u003eĐẶC ĐIỂM NỔI BẬT CỦA CHIẾC XE TẬP THĂNG BẰNG \u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003eKhung xe được làm từ hợp kim chắc chắn, đảm bảo độ vững chãi của chiếc xe và sự an toàn của trẻ khi lái xe nhưng lại không làm trọng lượng của chiếc xe trở nên quá nặng (trẻ có thể tự vác, xách xe bằng 1 tay). Thiết kế khung xe đơn giản và thu gọn tối đa tạo không gian cho trẻ thực hiện những động tác vận động linh hoạt.\u003c/li\u003e\n\u003cli\u003eYên xe rộng, bọc nệm mềm nhằm tránh gây ê hay đau mông khi ngồi lâu, chiều cao phù hợp cho trẻ từ 1,5-6 tuổi.\u003c/li\u003e\n\u003cli\u003eTay lái nằm ngang được thiết kế tương thích với chiều cao yên giúp trẻ dễ dàng điều khiển hướng đi của xe. \u003c/li\u003e\n\u003cli\u003eBánh xe vành nhựa đúc liền khối siêu nhẹ; lốp xe đặc không cần bơm, bám đường, chống trơn trượt và chống xóc nảy hiệu quả, đảm bảo chiếc xe di chuyển trơn tru trên mọi địa hình.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/cf/1b/bf/6ce4b86020c7e5351c857d92ed92a89d.jpg\" alt=\"\" width=\"750\" height=\"499\" /\u003e\u003c/p\u003e\n\u003ch2\u003eMỘT VÀI ĐIỀU MẸ CẦN LƯU Ý KHI CHO TRẺ DI CHUYỂN BẰNG XE TẬP THĂNG BẰNG\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003eLuôn cho trẻ đội mũ bảo hiểm, đeo đai bảo vệ chân tay trong suốt quá trình luyện tập. \u003c/li\u003e\n\u003cli\u003eKhông cho trẻ mới tập xe đi vào những đoạn đường không bằng phẳng, đoạn đường bùn đất lầy lội, đoạn đường nhiều sỏi đá, đoạn đường diện tích quá hẹp hay những đoạn đường có nhiều phương tiện giao thông qua lại. \u003c/li\u003e\n\u003cli\u003eKhông cho trẻ chưa đủ chiều cao (chân chưa chạm tới đất khi ngồi trên yên xe) luyện tập đi xe thăng bằng.\u003c/li\u003e\n\u003cli\u003eThường xuyên tham gia cùng bé trong quá trình luyện tập và vui chơi của trẻ nhằm đảm bảo an toàn tối đa.\u003c/li\u003e\n\u003cli\u003eKhông để trẻ tập đi xe tại khu vực gần sông, hồ, có thể gây nguy hiểm. \u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/64/5b/64/073e4e947bf1c4e4b62eee2ed66a56f0.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/95/57/1c/2068a5218e2828cf83691271e6b54293.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/00/79/1c/4115b9335822e8bbd5d8d4133193a51f.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/11/d6/9a/e933542431b08fcbffb351fa04f96bd5.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/9d/65/23/9dd05668d84975806d95f840c8c3435d.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eThành thạo điều khiển  sẽ là bước đệm hoàn hảo giúp trẻ làm quen và luyện tập đi xe đạp 2 bánh nhanh và dễ dàng hơn.\u003cbr /\u003eNgày nay, xe thăng bằng đã và đang dần trở thành một lựa chọn không thể bỏ qua của hầu hết các gia đình cho các con. Từ những kĩ năng lái xe đơn giản, bé hoàn toàn có thể luyện tập nhiều kĩ năng phức tạp hơn hay tham gia những cuộc đua vượt qua địa hình trắc trở trên chính chiếc xe \"đơn giản\" này.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/e2/ed/a0/f5139f91410d29aec2b8604d8baab140.jpg\" alt=\"\" width=\"750\" height=\"499\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eChuông xe đạp bọ rùa dễ thương\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e✯ Thiết kế hình chú bọ rùa, màu sắc rực rỡ, một vật trang trí hoàn hảo cho chiếc xe của bạn\u003c/li\u003e\n\u003cli\u003e✯ Âm thanh lớn và rõ ràng, dù ở xa cũng dễ dàng nghe thấy\u003c/li\u003e\n\u003cli\u003e✯ Phụ kiện không thể thiếu cho xe đạp\u003c/li\u003e\n\u003cli\u003e✯ Dễ dàng lắp đặt cho xe đạp\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/70/38/77/5470ced94067ec77d78496e303a16eaa.jpg\" alt=\"\" width=\"750\" height=\"559\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/73/05/60/f9f23531ca61ab0ebf380234e224539d.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/73/05/60/f9f23531ca61ab0ebf380234e224539d.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/67/fc/35/d1554fe8c13277949c197e56330dba96.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/67/fc/35/d1554fe8c13277949c197e56330dba96.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/5f/28/70/d8990439c41353a70382e5d61e42ec14.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/5f/28/70/d8990439c41353a70382e5d61e42ec14.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/5f/28/70/d8990439c41353a70382e5d61e42ec14.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5f/28/70/d8990439c41353a70382e5d61e42ec14.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5f/28/70/d8990439c41353a70382e5d61e42ec14.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/c8/13/a0/8dec8d866b4be347035a7360087b2b5d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c8/13/a0/8dec8d866b4be347035a7360087b2b5d.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c8/13/a0/8dec8d866b4be347035a7360087b2b5d.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c8/13/a0/8dec8d866b4be347035a7360087b2b5d.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c8/13/a0/8dec8d866b4be347035a7360087b2b5d.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/5b/97/19/b5c9a56ebfe177f1e6a731628ab40d41.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/5b/97/19/b5c9a56ebfe177f1e6a731628ab40d41.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/5b/97/19/b5c9a56ebfe177f1e6a731628ab40d41.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5b/97/19/b5c9a56ebfe177f1e6a731628ab40d41.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5b/97/19/b5c9a56ebfe177f1e6a731628ab40d41.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/d1/85/17/d5e07560a6a81be64723a0de