m/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":411000,"discount_rate":42,"rating_average":4.5,"review_count":19,"review_text":"(19)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/1d/b5/9d/f2f97f66f353cf5bb2ec440634a2a243.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":672,"all_time_quantity_sold":116,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<h2 class=\"_2jrvqA\">Thông số tăm nước h2ofloss HF-9P (Sản phẩm mới nhất của hãng h2ofloss)</h2>\n<ul style=\"list-style-type:square;\"><li class=\"_2jrvqA\">\n<h3>Model: h2ofloss - HF-9P.</h3>\n</li>\n<li class=\"_2jrvqA\">\n<h3>Đầu vào: 5V,1A.</h3>\n</li>\n<li class=\"_2jrvqA\">\n<h3>Công suất: 21W.</h3>\n</li>\n<li class=\"_2jrvqA\">\n<h3>Dung tích bình chứa nước: 300ml. Bình chứa nước có thể tháo rời dễ dàng.</h3>\n</li>\n<li class=\"_2jrvqA\">\n<h3>Áp lực nước: 40 -130PSI. Mạnh hơn so với mẫu HF-6, HF-6P.</h3>\n</li>\n<li class=\"_2jrvqA\">\n<h3>Xung nhịp: 1200 lần/phút.</h3>\n</li>\n<li class=\"_2jrvqA\">\n<h3>Cơ chế phun: Cơ chế phun đứt đoạn theo từng nhịp, các xung động nước tác động vào nướu, len lỏi qua từng kẽ răng giúp làm sạch và matxa nướu hiệu quả mà không làm tổn thương nước.</h3>\n</li>\n<li>\n<h3>Pin: 2500 mAh pin Lithium-ion (có thể sử dụng được từ 15 ngày, với tần suất 1 ngày 2 lần, mỗi lần 1 phút). Thời gian sử dụng cho 1 lần sạc ở mỗi khách hàng có thể khác nhau nếu không sử dụng đúng đầu vào quy định sạc máy output 5V 1A và tần suất sử dụng sản phẩm/ngày, mức chỉnh áp lực nước cao.</h3>\n</li>\n<li>\n<h3>Tiêu chuẩn chống thấm nước IPX7.</h3>\n</li>\n<li>\n<h3>Chất liệu: Nhựa cao cấp ABS.</h3>\n</li>\n</ul><p> </p>\n<p><img style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/45/5c/33/e40bc7bcf765a776bc9919c7c0a6892a.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p> </p>\n<ul style=\"list-style-type:square;\"><li>\n<h3>Bộ sản phẩm : Máy tăm nước H2ofloss HF-9P, Cáp sạc USB, 5 vòi phun, túi cầm tay, hộp đựng vòi phun</h3>\n</li>\n</ul><p> </p>\n<p><img style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/d0/a9/21/15c0ac1dfaad3ffda21e10da3bc8f611.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p> </p>\n<h2>Máy tăm nước H2ofloss HF-9P là mẫu máy tăm nước cầm tay mới trong năm 2022 của thương hiệu H2ofloss. Đây là phiên bản nâng cấp cả về thiết kế cũng như hiệu năng sử dụng từ các phiên bản trước là HF-6 và HF-6P, mang đến trải nghiệm tốt hơn cho người dùng</h2>\n<p><img style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/e3/83/6a/85136dca3a896c58c6e4a087f5c8aa5f.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<h2>Thiết kế sang trọng, tinh tế, kiểu dáng máy bắt mắt</h2>\n<p>Có thể dễ dàng nhận ra, thiết kế của máy tăm nước H2ofloss HF-9P thanh thoát hơn, bình đựng nước được làm thon hơn so với phiên bản HF6 trước đây. Phần bảng điều khiển được bo viền kim loại sáng bóng, giúp máy tăm nước HF-9P thêm phần sang trọng, cũng như chống va đập tốt hơn. Thiết kế máy nhỏ gọn, dễ dàng bỏ vào hành lý, thuận tiện để bạn mang đi trong những chuyến du lịch, công tác xa nha nhà.</p>\n<p>Máy có trọng lượng khá nhẹ chỉ khoảng tầm 700 gam, được làm từ chất liệu nhựa ABS có khả năng chống va đập tốt. Phần tay cầm cũng được làm bằng nhựa nhám để tạo độ bám trong quá trình sử dụng.</p>\n<p> </p>\n<p><img style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/37/3b/28/3af1ff7e0c7940b16239fb6ea903dbf7.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<h2> </h2>\n<h2>Công nghệ tia nước siêu âm, 5 chế độ làm sạch, áp lực nước mạnh</h2>\n<p> </p>\n<p><img style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/ac/c1/51/533868157bf6b41ed27e3495b6dfb38e.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p> </p>\n<p>Máy tăm nước H2ofloss HF-9P sử dụng động cơ bơm nước nổi tiếng của hãng Mabuchi Nhật Bản kết hợp với đường kính vòi phun nhỏ chỉ 0,6mm. Từ đó tạo ra tia nước có áp lực cao đạt tới mức 110 psi, cùng tần số rung 1200 lần/phút nên dễ dàng thổi bay các mảng bám cứng đầu nhất. Răng miệng của bạn sẽ được làm sạch một cách hiệu quả, ngăn ngừa các bệnh về nha khoa.</p>\n<p>Trên các phiên bản máy tăm nước H2ofloss, nhà sản xuất đều trang bị tới 5 mức điều chỉnh áp lực nước, từ mức nhỏ nhất là 40 psi dành cho người mới dùng, người có nướu nhạy cảm hoặc là trẻ em. Mức áp lực nước cao nhất là 110 psi cho người cần làm sạch sâu, người đã sử dụng quen hoặc người đang niềng răng.</p>\n<h2>Bình đựng nước lớn, có thể tháo rời</h2>\n<p> </p>\n<p><img style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/8b/dc/9b/65ff6cbb6bbf7f8130e8985b42fd496a.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p> </p>\n<p>Bình đựng nước của H2ofloss HF-9P dễ dàng tháo rời để thay nước hoặc vệ sinh bình chứa sau mỗi lần sử dụng. Đảm bảo vệ sinh, hạn chế tình trạng nước còn tồn đọng trong bình, lâu ngày sẽ sinh ra vi khuẩn, rong rê</p>\n<p> </p>\n<p><img style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/52/75/bb/d6ac87fed789cd90935a2d7938e2f36a.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p> </p>\n<p>Bình đựng nước của máy cũng có dung tích lớn tới 300ml, bằng với phiên bản HF- 6 và cũng được đánh giá là mẫu máy tắm nước có dung tích bình nước lớn nhất hiện nay. Với dung tích bình chứa nước này, bạn có thể thoải mái sử dụng trong vòng từ 1 – 2 phút mà không cần thêm nước.</p>\n<p> </p>\n<p><img style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/d3/82/81/a2f2ccca0b4a49d413ad9a5e315c6576.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<h2> </h2>\n<h2>Trang bị 5 đầu vòi phun</h2>\n<p>Máy tăm nước H2ofloss HF-9P được trang bị bộ 5 đầu phun dành cho nhiều đối tượng sử dụng và mục đích sử dụng khác nhau: 2 đầu tăm cơ bản. 1 đầu tăm niềng răng, hoạt động như bàn chải giúp vệ sinh mắc cài. 1 đầu tăm nha chu với vòi nhọn. 1 đầu tăm vệ sinh lưỡi, làm sạch mảng bám.</p>\n<p> </p>\n<p><img style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/99/cc/fe/e85b4ee7391c043dbd8da6ffa56c9c0b.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<h2>Dung lượng pin cao, thời gian sử dụng lâu</h2>\n<p> </p>\n<p><img style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/6b/a4/da/d07f20c764ce840327c114e98601057b.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p> </p>\n<p>Phiên bản máy tăm nước H2ofloss được nhà sản xuất với dung lượng pin lớn, đạt 2500 mah nên có thể sử dụng từ 15-20 ngày mà không cần sạc lại.</p>\n<p>Với dung lượng pin 2500mAh, bạn sẽ mất khoảng từ 4 – 5 tiếng để có thể sạc đầy. Điều này cực kỳ tiện lợi cho các bạn hay phải di chuyển, đi công tác nhiều mà vẫn muốn đem máy tăm nước này đi cùng.</p>\n<p> </p>\n<p><img style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/0a/ca/9d/cdb1815ee35a159055a83f1e001da7fb.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p> </p>\n<p>Cũng như các mẫu tăm nước của H2ofloss, HF-9P cũng được trang bị đầu hút nước có khả năng tự lựa theo các góc khác nhau. Đảm bảo máy có khả năng hút cạn nước trong bình chứa ở mọi vị trí thao tác của người dùng. Nhờ đó mà máy hoạt động ổn định, tăng hiệu quả sử dụng.</p>\n<h2>Thân máy thiết kế đảm bảo kín nước cao, chống nước IPX7</h2>\n<p> </p>\n<p><img style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/ea/7b/af/ae9c5a061f51af0e5900ae4ebde4796a.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p> </p>\n<p>Các bộ phận trên máy tăm nước H2ofloss HF-9P được thiết kế để đảm bảo kín nước. Khả năng chống nước đạt chuẩn IPX7, đây là tiêu chuẩn kháng nước thuộc loại cao nhất hiện nay, tuy nhiên nó cũng không hoàn toàn tuyệt đối. Do đó các bạn cần lưu ý không sạc máy trong môi trường ẩm ướt, bảo quản nơi khô thoáng. Đối với các dòng máy tăm nước luôn hoạt động trong môi trường ẩm ướt do đó các vị trí dễ bị nước vào gây chập cháy là cổng sạc và phím bấm.</p>\n<h2>Nút bịt cổng sạc đi cùng máy</h2>\n<p><img style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/32/33/ba/44d3a44e29acfaf5b0e79c3348ec1000.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p> </p>\n<h2>Đầu hút nước tự lựa, hút kiệt nước ở mọi góc độ</h2>\n<p> </p>\n<p><img style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/19/41/f6/f0d1da6094702dd1208775d92b1d41fb.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/1d/b5/9d/f2f97f66f353cf5bb2ec440634a2a243.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/1d/b5/9d/f2f97f66f353cf5bb2ec440634a2a243.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/1d/b5/9d/f2f97f66f353cf5bb2ec440634a2a243.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1d/b5/9d/f2f97f66f353cf5bb2ec440634a2a243.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/produc