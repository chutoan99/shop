}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":30,"review_text":"(30)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/56/e6/94/c2d325494774d498c95d64337682ae94.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":703,"all_time_quantity_sold":127,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2\u003e\u003cstrong\u003eĐánh giá chi tiết tay cầm DareU H101X Wireless Black\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003eĐối với game thủ hệ console, một trong những phụ kiện chơi game không thể thiếu và được sử dụng rất nhiều hiện nay, đó là tay cầm chơi game. Và để mang đến luồng gió mới trong phân khúc sản phẩm này, DareU đã cho ra mắt sản phẩm đến từ chính dây chuyền sản xuất của mình với model mang tên \u003cstrong\u003eDareU H101X Wireless Black\u003c/strong\u003e. Hãy cùng GEARVN tìm hiểu kỹ hơn về sản phẩm này nhé !\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eThiết kế đặc biệt và thú vị trên từng họa tiết\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eHoàn thiện với thiết kế đối xứng - công thái học, DareU H101X Wireless Black mang đến sự thoải mái khi sử dụng chiếc \u003ca href=\"https://gearvn.com/collections/tay-cam-choi-game\"\u003etay cầm chơi game\u003c/a\u003e, phù hợp và vừa vặn cho mọi form tay. Khu vực cầm và nắm của DareU H101X Wireless Black được làm trơn để tạo cảm giác dễ chịu khi sử dụng trong thời gian dài. Đặc biệt, với phiên bản màu đen này, DareU mang đến cho người dùng lớp skin trông cực kì bắt mắt khi sử dụng những chấm trắng ngay trên phần màu đen của chiếc tay cầm, đưa ta đến hình ảnh của những bầu trời đêm đầy sao lúc chơi game xuyên đêm.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://file.hstatic.net/1000026716/file/gearvn-tay-cam-dareu-h101x-wireless-black-7_3ecc3a18724d4898a3f834b897021ff2_1024x1024.jpg\" alt=\"GEARVN - Tay cầm DareU H101X Wireless Black\" /\u003e\u003c/p\u003e\n\u003cp\u003eNhững hoạt tiết, biểu tượng phím bấm trên DareU H101X Wireless Black được cách tân và làm mới cho game thủ cái nhìn thích thú và có cảm hứng hơn khi sử dụng. Đây sẽ là một trong những lựa chọn đáng cân nhắc khi chọn mua tay cầm giá rẻ cho game thủ.\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eĐa dạng trong khả năng kết nối\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eChiếc \u003ca href=\"https://gearvn.com/collections/tay-cam-dareu\"\u003etay cầm DareU\u003c/a\u003e hỗ trợ cho bạn mọi kết nối thông dụng hiện nay. Bạn có thể dễ dàng trải nghiệm chơi game trên \u003ca href=\"https://gearvn.com/pages/pc-gvn\"\u003ePC Gaming\u003c/a\u003e, Switch, TV và thậm chí là smartphone. Từ đó, bạn có thể thoải mái hơn trong việc lựa chọn thiết bị giải trí kết hợp cùng DareU H101X Wireless Black.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://file.hstatic.net/1000026716/file/gearvn-tay-cam-dareu-h101x-wireless-black-8_65b76346a0af4d698a3ba4864d99b931_1024x1024.jpg\" alt=\"GEARVN - Tay cầm DareU H101X Wireless Black\" /\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eTăng tốc với nút TURBO\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eTrang bị trên DareU H101X Wireless Black phím lớn mang tên TURBO. Với 3 mức tốc độ tùy chọn, DareU H101X Wireless Black cho phép bạn thoải mái sử dụng với tốc độ phù hợp. Bao gồm 3 cách điều chỉnh là, nhất lần đầu sẽ là semi-auto, lần thứ hai là auto và lần thứ ba sẽ tắt chế độ turbo.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://file.hstatic.net/1000026716/file/gearvn-tay-cam-dareu-h101x-wireless-black-9_f05a6b69b119492ca252c1d7a007117e_1024x1024.jpg\" alt=\"GEARVN - Tay cầm DareU H101X Wireless Black\" /\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eTrải nghiệm sử dụng chân thực\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u0