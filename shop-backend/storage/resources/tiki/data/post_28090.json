xt":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":24000,"discount_rate":15,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/31/d0/14/46bf099b9ce68c31b028c59770b5a24d.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":267,"all_time_quantity_sold":3,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003e*Thông tin chung\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eTiêu đề: Phấp phới cờ bay\u003c/li\u003e\n\u003cli\u003eTác giả: Robert G. Fresson\u003c/li\u003e\n\u003cli\u003eThể loại: Sách bách khoa toàn thư cho thiếu nhi\u003c/li\u003e\n\u003cli\u003eGiá bìa: 160.000 VNĐ\u003c/li\u003e\n\u003cli\u003eNăm XB:\u003c/li\u003e\n\u003cli\u003eKích thước: 18.5 x 24 cm\u003c/li\u003e\n\u003cli\u003eHình thức:\u003c/li\u003e\n\u003cli\u003eSố trang: 116\u003c/li\u003e\n\u003cli\u003eNgôn ngữ: Tiếng Việt\u003c/li\u003e\n\u003cli\u003eNgười dịch: Dr. Gấu\u003c/li\u003e\n\u003cli\u003eĐơn vị phát hành: San Hô Books\u003c/li\u003e\n\u003cli\u003eMã sản phẩm: 893-533-371-024-6\u003c/li\u003e\n\u003cli\u003eISBN: 978-604-472-345-7\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/53/8e/68/51efa268bb60a135384081afe0ed97f0.jpg\" alt=\"\" width=\"750\" height=\"312\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e--------------------\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e*Giới thiệu sách\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eDành cho trẻ em từ 7-12 tuổi.\u003c/p\u003e\n\u003cp\u003e------------------------------------------\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cem\u003ePhấp phới cờ bay\u003c/em\u003e\u003c/strong\u003e là cuốn bách khoa toàn thư về các lá quốc kì trên thế giới. Bằng cách khám phá hình dạng, màu sắc và biểu tượng trên cờ, bạn nhỏ sẽ được ngao du đây đó để tìm hiểu về lịch sử, văn hoá và tinh thần các quốc gia.\u003c/p\u003e\n\u003cp\u003eBạn có biết quốc kì Mĩ đã trải qua 28 phiên bản sửa đổi kể từ thiết kế đầu tiên? Hay ý nghĩa của biểu tượng cờ đỏ sao vàng trên quốc kì Việt Nam?\u003c/p\u003e\n\u003cp\u003eĐi kèm với thông tin thú vị là bản đồ, câu hỏi tương tác sáng tạo, kèm bộ từ mới tiếng Anh. Cuốn sách sẽ là người bạn đồng hành giúp độc giả nhí rèn luyện khả năng ghi nhớ và bồi đắp tình yêu với địa lí, lịch sử thế giới; hay đơn giản là công cụ để cả nhà đố vui cuối tuần.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e--------------------\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e*Về tác giả:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eRobert G. Fresson (hay Ruby Fresson) là hoạ sĩ minh hoạ và giảng viên Đại học Kingston (Vương quốc Anh). Fresson tốt nghiệp cử nhân ngành Đồ họa tại Đại học Falmouth và thạc sĩ ngành Truyền thông Thị giác tại Đại học Nghệ thuật Hoàng gia.\u003c/p\u003e\n\u003cp\u003eFresson chịu ảnh hưởng mạnh mẽ từ hoạ sĩ người Bỉ Hergé, với bộ truyện tranh \u003cem\u003eNhững cuộc phiêu lưu của Tintin\u003c/em\u003e. Những tác phẩm của hoạ sĩ người Anh mang đậm phong cách retro, thường xuyên xuất hiện trên các tờ báo nổi tiếng như \u003cem\u003eThe New York Times\u003c/em\u003e, \u003cem\u003eThe Guardian\u003c/em\u003e, \u003cem\u003eThe New Yorker\u003c/em\u003e,… đồng thời Fresson cũng là đối tác của nhiều thương hiệu quốc tế như Apple, Google,…\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e--------------------\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e*Quy cách:\u003c/strong\u003e Bìa cứng bồi các tông chắc chắn, cán mờ, phủ UV cục bộ. Ruột sách in 4 màu trên giấy Offset 120 dày dặn, chống loá, thân thiện với mắt trẻ.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e--------------------\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e*Trang đọc thử:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/67/a9/21/e01578503158b621ca0c8f581532f886.jpg\" alt=\"\" width=\"750\" height=\"972\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/2e/d3/14/8f00f18c20a79acaa3c30c9e2aabd21d.jpg\" alt=\"\" width=\"750\" height=\"972\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/18/89/d0/46c04f8a22f83b68e0f83b7f32e652be.jpg\" alt=\"\" width=\"750\" height=\"972\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/f0/03/6f/69ca5a9dcf06d1acbaafa46f189c8683.jpg\" alt=\"\" width=\"750\" height=\"972\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/0d/dc/a5/d5b91e3071772572784220c38e2e48e5.jpg\" alt=\"\" width=\"750\" height=\"972\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/28/33/2a/19d4afb5b7318b9bd1d33daeefbe8a26.jpg\" alt=\"\" width=\"750\" height=\"972\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/ff/ba/d6/6d3ff409f128268be29f91f9ae1fe037.jpg\" alt=\"\" width=\"750\" height=\"972\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/31/d0/14/46bf099b9ce68c31b028c59770b5