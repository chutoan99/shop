entic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":3,"review_text":"(3)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/f0/94/a7/5f278b60c9b8b7ffe0411b245d279056.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":645,"all_time_quantity_sold":12,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp class=\"N5VAH-\"\u003eTinhtebeauty cam kết chính hiệu 100%\u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003eChính sách: Hoàn tiền 111% nếu phát hiện hàng giả\u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003e============================\u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003eNếu bạn đã quá chán nản với những sản phẩm xà bông tắm thông thường, gây nên tình trạng khô da, nhờn rít da và rất mất thời gian mỗi khi sử dụng, bạn nên thay thế ngay sản phẩm trong nhà tắm của bạn bằng Sữa tắm dạng Gel tới từ thương hiệu đình đám lâu đời của Mỹ Old Spice.\u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003e \u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003eChỉ trên 1 sản phẩm, Sữa tắm dạng Gel Old Spice 473ml vừa đem lại một cơ thể sạch sẽ, mát mẻ tuyệt đối, vừa dưỡng ẩm cho da, tránh những tác nhân gây bệnh như vi khuẩn, nấm, đồng thời sẽ đem lại cho nam giới một mùi hương đầy lôi cuốn, nam tính, đúng tinh thần Old Spice: \"Smell like a man, man\".\u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003eĐẶC ĐIỂM VÀ TÍNH NĂNG NỔI BẬT:\u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003e- Gel tắm của Old Spice phát triển công nghệ 3X tác động, kết hợp cả 3 đặc tính trên cùng 1 sản phẩm: làm sạch da hoàn toàn, tạo bọt nhiều, lưu hương dài lâu lên tới 48 giờ\u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003e- Sản phẩm dạng Gel tươi mát, tự nhiên nên không gây nhờn rít da, làm sạch cơ thể vượt trội\u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003e- Không chỉ làm sạch, sản phẩm trú trọng vào mùi hương, đem đến cho người sử dụng nhiều lựa chọn về mùi hương và lưu hương lâu trên cơ thể sau cả ngày dài\u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003e- Sản phẩm hoàn toàn chứa các thành phần lành tính, nên chắc chắn sẽ không gây kích ứng da sau khi sử dụng kể cả với người có làn da nhạy cảm\u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003eĐÁNH GIÁ TỪ NGƯỜI TIÊU DÙNG:\u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003e- Mức độ làm sạch da: 9/10\u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003e- Độ lưu hương: 8.5/10\u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003e- Mức độ tạo bọt: 9/10\u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003e- Mức độ lành tính: 9/10\u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003e- Giá cả: 8.5/10\u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003e \u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003eMÙI HƯƠNG CHÍNH:\u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003eKết hợp từ những thành phần lành tính, mùi hương của sữa tắm dạng Gel Old Spice 473ml trong BST Wild\u0026amp;Fresher Collection đều được lấy cảm hứng từ những mùi hương trong tự nhiên:\u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003e- Bearglove: Sự kết hợp giữa Cam, Chanh và Quế mang đến hương thơm nam tính, đầy bản lĩnh, rất thích hợp với người thích hương thơm nồng nàn, nam tính\u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003e- Wolfthorn: Sự kết hợp giữa Cam và Quýt tự nhiên mang đến hương thơm lôi cuốn, sáng tạo, rất thích hợp với người thích hương thơm độc đáo, quyến rũ, sắc sảo\u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003e- Timber: Sự kết hợp giữa Gỗ Đàn Hương và Bạc Hà mang đến cảm giác sảng khoái, the mát dài lâu, rất thích hợp với người thích hương thơm của gỗ tự nhiên và bạc hà lạnh\u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003e- Fiji: Sự kết hợp giữa Lá cọ, Dừa và hoa Lavender mang đến cảm giác thư giãn, dễ chịu, rất thích hợp với người thích hương thơm của biển, dịu nhẹ, thoải mái\u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003e \u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003eHƯỚNG DẪN SỬ DỤNG:\u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003e- Làm ướt cơ thể khi đang tắm\u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003e- Cho một lượng sữa tắm vừa phải vào bông hoặc khăn tắm và xoa nhẹ nhàng để tạo bọt\u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003e- Massage nhẹ nhàng trong vài phút để làm sạch các bụi bẩn\u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003e- Tắm lại bằng nước sạch\u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003e- Sử dụng thường xuyên để đạt hiệu quả tối ưu\u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003e \u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003eLƯU Ý:\u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003e- Chỉ dùng ngoài da, tránh tiếp xúc với mắt, nếu tiếp xúc với mắt hãy rửa kỹ bằng nước sạch\u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003e- Tránh sử dụng khi da đang bị trầy xước, ngưng sử dụng ngay khi có dấu hiệu rát da\u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003e- Không sử dụng sản phẩm để thay thế các sản phẩm sữa rửa mặt hay tẩy trang\u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003e \u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003eCÁCH BẢO QUẢN:\u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003e- Nơi khô ráo thoáng mát\u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003e- Tránh ánh nắng trực tiếp, nơi có nhiệt độ cao hoặc ẩm ướt\u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003e- Đậy nắp kín sau khi sử dụng.\u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003e \u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003eTHÔNG TIN CHI TIẾT:\u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003e- Dung tích: 473ml\u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003e- Xuất xứ: Mỹ\u003c/p\u003e\n\u003cp class=\