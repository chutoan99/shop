://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":1505000,"discount_rate":36,"rating_average":4.5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/c5/a3/9f/2f1fb7326814c04a964e31f8e6ad0230.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":648,"all_time_quantity_sold":6,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003e\u003cstrong\u003eVali kéo vải Sakos Champion: Xứng đáng là nhà vô địch\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eChampion là bộ sưu tập vali kéo vải trượt nước vượt trội từ SAKOS. Với những đặc tính ưu việt như chất liệu cao cấp, trọng lượng siêu nhẹ, phân ngăn thông minh, vali du lịch SAKOS mang đậm phong cách Vintage dù theo thời gian vẫn giữ được chỗ đứng trong lòng các tín đồ yêu thích sự tiện lợi và chỉn chu.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/de/98/e6/5ea50c973fd1d8a0a89065dc0b29d97b.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cdiv\u003e\n\u003ch4\u003e\u003cstrong\u003eCHI TIẾT SẢN PHẨM\u003c/strong\u003e\u003c/h4\u003e\n\u003c/div\u003e\n\u003cp\u003e\u003cstrong\u003eVali vải Champion xứng đáng là nhà vô địch với phong cách cổ điển đầy cuốn hút\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eLà một trong những bộ sưu tập vali vải SAKOS, Champion sở hữu đặc tính ưu việt với trọng lượng siêu nhẹ và độ bền thách thức thời gian.\u003c/li\u003e\u003cli\u003eThiết kế tổng thể là hình hộp chữ nhật đứng với cấu trúc đơn giản nhưng tiện lợi.\u003c/li\u003e\u003cli\u003eChất liệu vải polyester trượt nước, bền màu và dễ dàng vệ sinh khi bị dính bẩn.\u003c/li\u003e\u003cli\u003e3 phiên bản màu đơn sắc được tái hiện độc đáo: Đen – Đỏ – Xanh dương phù hợp cho cả nam và nữ.\u003c/li\u003e\u003cli\u003eKích thước đa dạng nhỏ – trung – đại đáp ứng tiêu chuẩn khắt khe của các chuyến bay quốc tế.\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eVới phân ngăn thông minh, nội thất sang trọng, vali vải SAKOS là bạn đồng hành đáng tin cậy\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"alignleft wp-image-7693\" src=\"https://salt.tikicdn.com/ts/product/56/fd/a5/6ee86be07d0ad3008bc9543fd7fa723d.png\" alt=\"Vali kéo vải Sakos Champion mô tả\" width=\"430\" height=\"430\" /\u003e\u003cimg class=\"alignnone wp-image-7694\" src=\"https://salt.tikicdn.com/ts/product/4d/5b/63/9b2c6b03b12285be96f304a4fd77b861.png\" alt=\"Vali kéo vải Sakos Champion mô tả\" width=\"430\" height=\"430\" /\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eNgăn chính rộng rãi, trang bị vách ngăn chống đổ với khóa cài tiện lợi, dễ dàng tháo – lắp.\u003c/li\u003e\u003cli\u003eHệ thống các ngăn phụ với kích thước lớn – nhỏ khác nhau dễ dàng sắp xếp đồ dùng ngăn nắp.\u003c/li\u003e\u003cli\u003eCác ngăn được bảo vệ bởi khóa zip an toàn.\u003c/li\u003e\u003cli\u003eVải lót 3 tính năng: chống thấm, hút ẩm, kháng khuẩn.\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eVali vải Champion sở hữu hệ thống cần kéo và bánh xe êm mượt, lướt nhẹ trên mọi địa hình\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"alignleft wp-image-7692\" src=\"https://salt.tikicdn.com/ts/product/0d/92/a5/51dd9e9980a5e9e1f804aec23f45068f.png\" alt=\"Vali kéo vải Sakos Champion mô tả\" width=\"430\" height=\"429\" /\u003e\u003cimg class=\"alignnone wp-image-7696\" src=\"https://salt.tikicdn.com/ts/product/bf/5d/53/caaa84f9b89f2b7c5b7845db0478c7fa.png\" alt=\"Vali kéo vải Sakos Champion mô tả\" width=\"430\" height=\"430\" /\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eCần kéo hộp kim nhôm chống gỉ sét, cấu trúc hình học dễ dàng điều chỉnh theo vóc dáng người dùng.\u003c/li\u003e\u003cli\u003eBánh xe đơn chịu lực xoay 360°, lướt êm trên mọi địa hình.\u003c/li\u003e\u003cli\u003eBên trong bánh xe trang bị túi trữ dầu tự đồng kích hoạt giúp bánh xe luôn vận hành êm mượt.\u003c/li\u003e\u003cli\u003eQuai xách theo trục ngang và dọc với 2 lớp êm ái, sử dụng công nghệ đánh bọ chắc chắn.\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eBộ đôi dây kéo chống trộm và khóa TSA tiêu chuẩn quốc tế giúp vali kéo Champion an toàn tuyệt đối\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"aligncenter size-full wp-image-7695\" src=\"https://salt.tikicdn.com/ts/product/b7/6f/ca/15dcd2de8c03c4b106356e3144b4c0fe.png\" alt=\"Vali kéo vải Sakos Champion mô tả\" width=\"460\" height=\"460\" /\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eKhung vali vải chắc chắn được tạo viền tinh tế bởi sợi nhựa dẻo PE.\u003c/li\u003e\u003cli\u003eDây kéo nhựa dẻo êm mượt, chống rạch.\u003c/li\u003e\u003cli\u003eKhóa TSA tiêu chuẩn quốc tế được cấp phép bởi tổ chức an ninh vận chuyển Hoa Kỳ.\u003c/li\u003e\u003cli\u003eTag name chống thất lạc hành lý.\u003c/li\u003e\u003cli\u003eLogo SAKOS tinh tế khẳng định chất lượng sản phẩm được sản xuất trên công nghệ độc quyền Sakostyle (USA).\u003c/li\u003e\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/c5/a3/9f/2f1fb7326814c04a964e31f8e6ad0230.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/c