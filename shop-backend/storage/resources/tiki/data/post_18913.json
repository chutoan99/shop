l,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":371000,"discount_rate":29,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/80/95/79/850634cff2dfd5f40b8534befa8a511d.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":300,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eThang inox rút đơn nhập khẩu gấp gọn, tiện dụng- Chống trượt - Nhiều kích thước - Sản phẩm mới chính hãng Nikita \u003c/p\u003e\n\u003cp\u003e️    THÔNG SỐ KỸ THUẬT CHUNG\u003c/p\u003e\n\u003cp\u003e-  Tên sản phẩm: Thang rút đơn inox Nikita\u003c/p\u003e\n\u003cp\u003e-  Tiêu chuẩn an toàn: EN131\u003c/p\u003e\n\u003cp\u003e-  Tải trọng: 150 kg\u003c/p\u003e\n\u003cp\u003e-  Chất liệu: Inox 316\u003c/p\u003e\n\u003cp\u003e-  Bảo hành: 24 tháng\u003c/p\u003e\n\u003cp\u003e-  Chiều cao tối đa: 2,6 m – 5,9m\u003c/p\u003e\n\u003cp\u003e-  Chiều cao rút gọn: 0,76 m – 1,13 m\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/f2/1a/4e/816526333a2d385f02a2b3fe8c5a7234.JPG\" alt=\"\" width=\"572\" height=\"566\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/1a/28/d6/3fbc73a6efedd95ef798a7e1cf9fa5ce.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e️    ƯU ĐIỂM VƯỢT TRỘI\u003c/p\u003e\n\u003cp\u003eChất liệu inox 316 chống rỉ sét, cao cấp, cứng gấp 5 lần T6063\u003c/p\u003e\n\u003cp\u003eThiết kế thông minh tiện dụng, dễ dàng kéo và rút gọn tùy theo nhu cầu sử dụng\u003c/p\u003e\n\u003cp\u003eỐng thang không có điểm nối, chống cong võng, gia tăng độ bền vững\u003c/p\u003e\n\u003cp\u003eKhả năng chịu được tải trọng lớn, đảm bảo an toàn khi sử dụng\u003c/p\u003e\n\u003cp\u003eỐng thang đường kính lớn, chắc chắn tuyệt đối\u003c/p\u003e\n\u003cp\u003eĐai thang nhựa ABS bền bỉ theo thời gian\u003c/p\u003e\n\u003cp\u003eChân đế cao su cao cấp chống trượt, chống trầy sàn, vững chãi, an toàn\u003c/p\u003e\n\u003cp\u003eRút sử dụng và thu gọn dễ dàng, dễ dàng mang vác, di chuyển.\u003c/p\u003e\n\u003cp\u003eChốt khóa thang, giúp hạ tất cả các nấc thang xuống một cách dễ dàng, và cố định thang an toàn khi sử       dụng\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/83/52/15/9bf5d119c0cf33bbb2f194196682dbe4.JPG\" alt=\"\" width=\"565\" height=\"564\" /\u003e\u003c/p\u003e\n\u003cp\u003eThang có nhiều kích thước để lựa chọn\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/62/68/90/a87d449e95e7addcaff890fa40b82d8e.JPG\" alt=\"\" width=\"723\" height=\"550\" /\u003e\u003c/p\u003e\n\u003cp\u003e          QUY TẮC SỬ DỤNG THANG\u003c/p\u003e\n\u003cp\u003e-  Thang phải được sử dụng ở trên mặt phẳng và chắc chắn.\u003c/p\u003e\n\u003cp\u003e-  Không nên sử dụng thang khi bạn đang đeo găng tay có dầu mỡ, trơn trượt hoặc  giày dép không đủ an toàn\u003c/p\u003e\n\u003cp\u003e-  Bậc thang, bề mặt sàn, điểm tựa ông nên để dính dầu mỡ vào.\u003c/p\u003e\n\u003cp\u003e-  Tuyệt đối không để nhiều người làm việc trên một chiếc thang nếu thang chỉ thiết kế dành cho một người.\u003c/p\u003e\n\u003cp\u003e-  Không bao giờ được nhảy hoặc trượt xuống từ một cái thang, phải rời thang từ độ cao an toàn\u003c/p\u003e\n\u003cp\u003e-  Các bậc thang phải được giữ sạch. Các vết bẩn, keo trét, vệt sơn… cần phải được chùi sạch sau khi sử dụng.\u003c/p\u003e\n\u003cp\u003e-  Các bậc thang cũng phải được chùi sạch.\u003c/p\u003e\n\u003cp\u003e-  Không sử dụng thang quá tải trọng cho phép (150kg)\u003c/p\u003e\n\u003cp\u003e-  Không bao giờ treo thang lên ở bậc 1. Không để thang ở nơi trẻ có thể nghịch và leo lên.\u003c/p\u003e\n\u003cp\u003e-  Không nên đứng lên đỉnh của thang, giữ độ cao đỉnh thang ngang với bụng người sử dụng.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/05/b0/ef/e3d1f1c92db194f988d8253de30340e4.JPG\" alt=\"\" width=\"574\" height=\"559\" /\u003e\u003c/p\u003e\n\u003cp\u003e️    VỀ CHÚNG TÔI\u003c/p\u003e\n\u003cp\u003e️ Chuyên cung cấp ác loại thang inox, thang nhôm gia đình: thang tay vịn, thang ghế, thang chữ A\u003c/p\u003e\n\u003cp\u003e️ Chuyên cung cấp các loại thang chuyên dụng dùng cho công trình: thang rút đơn, thang rút đa năng, thang trượt, thang gác mái, thang gấp khúc,\u003c/p\u003e\n\u003cp\u003e️ Hàng chính hãng Nikita, đúng ảnh, đúng sản phẩm\u003c/p\u003e\n\u003cp\u003e️ Bảo hành 24 tháng cho tất cả các sản phẩm thang\u003c/p\u003e\n\u003cp\u003e️ Shop chỉ cung cấp những sản phẩm có chất lượng tốt nhất tới tay khách hàng.\u003c/p\u003e\n\u003cp\u003e️ Giao hàng toàn quốc\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/8b/d3/7a/e8a5704d615d5b995c3aab16ec32b812.JPG\" alt=\"\" width=\"750\" height=\"419\" /\u003e\u003c/p\u003e\n\u003cp\u003e#thanginoxrut #thanginoxrutdon #thangrut #thangrutchua #thangxep #thangdanang #thanginoxrutchui #thang #thanggap #thanginox\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/80/95/79/850634cff2dfd5f40b8534befa8a511d.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/80/95/79/850634cff2dfd5f40b8534befa8a511d.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/80/95/79/850634cff2dfd5f40b