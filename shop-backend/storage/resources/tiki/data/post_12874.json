href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.8,"review_count":200,"review_text":"(200)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/dd/28/24/aea601f751d212ec034be97db6f41c9d.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1659,"all_time_quantity_sold":1200,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cul\u003e\n\u003cli\u003eHạt cacao được lên men thủ công trong thùng gỗ làm khơi dậy hương vị của dòng cacao trinitario chất lượng, được xếp vào loại hạt cacao ngon nhất thế giới.\u003c/li\u003e\n\u003cli\u003eDây chuyền sản xuất Nhật Bản đáp ứng các tiêu chuẩn quốc tế về độ mịn, kiểm soát tỷ lệ bơ cacao và chất lượng bột cacao xuất khẩu.\u003c/li\u003e\n\u003cli\u003eBột cacao nguyên chất Balanced là dòng bột cacao kiệt bơ (tỷ lệ bơ cacao tự nhiên 12%) nên vị lên sẽ đắng đậm, không thơm dịu như dòng Origin. Thích hợp làm bánh, pha chế đồ uống cacao cho các quán cà phê, nhà hàng.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eMột điều mà nhiều khách hàng nhầm lẫn khi nghĩ bột cacao nguyên chất sao lại có thành phần bơ cacao. Trong hạt cacao sẽ có tỷ lệ hơn 50% bơ cacao tự nhiên, chính vì vậy khi nghiền hạt cacao sẽ chuyển sang dạng nhão. Để sản xuất bột cacao nguyên chất cần trải qua quá trình tách ép bớt bơ cacao, chỉ giữ lại từ 10% đến 24% tùy yêu cầu sản phẩm. Và bơ cacao chính là thành phần tạo nên hương vị và giá trị dinh dưỡng cho các sản phẩm từ cacao.\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/ef/69/e8/70bc63ce7eca24345bc7baf6e064037a.jpg\" alt=\"\" width=\"750\" height=\"471\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/ec/be/d8/733a4137967d924fbfdb0d605ddd902b.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/49/26/13/b60a47b36c386c4b4ed854b198bedcf4.JPG\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/c6/b2/46/9a41c97fda1908fa0056d349beedbb7e.jpg\" alt=\"\" width=\"750\" height=\"421\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eSử dụng bột cacao nguyên chất Heyday\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e·  Với bột cacao nguyên chất Heyday, bạn có thể tùy ý pha chế một tách cacao theo công thức của riêng bạn: cacao nóng, cacao sữa đá, cacao bạc hà, chocolate đá xay… Đặc biệt là những bạn mê hương vị cacao nhưng đang trong chế độ ăn kiêng (Keto, Eat Clean, DAS...) hay đang gặp các vấn đề về sức khỏe cần hạn chế chất ngọt vẫn an tâm sử dụng.\u003c/p\u003e\n\u003cp\u003e·  Ngoài ra bạn có thể sử dụng bột cacao nguyên chất làm mỹ phẩm. Các loại mặt nạ từ cacao giúp chống lão hóa da cực kỳ hiệu quả mà hiện nay đang được các spa cao cấp sử dụng.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e07 lợi ích của bột cacao nguyên chất\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e.  Cacao rất giàu dinh dưỡng\u003c/p\u003e\n\u003cp\u003e.  Giúp tỉnh táo, vui vẻ hơn, giảm stress hiệu quả.\u003c/p\u003e\n\u003cp\u003e.  Giàu chất chống oxy hóa – làm đẹp da, kéo dài sự trẻ trung.\u003c/p\u003e\n\u003cp\u003e.  Cải thiện lưu thông máu, ổn định huyết áp, tim mạch.\u003c/p\u003e\n\u003cp\u003e.  Cacao giúp kiểm soát cân nặng.\u003c/p\u003e\n\u003cp\u003e.  Tăng cường trí nhớ.\u003c/p\u003e\n\u003cp\u003e.  Gia tăng khoái cảm\u003c/p\u003e\n\u003cp\u003eChính vì những lợi ích trên của cacao đối với sức khỏe mà các chuyên gia dinh dưỡng khuyên bạn nên uống một tách cacao mỗi sáng để có một ngày làm việc hiệu quả và duy trì sức khỏe tốt.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/dd/28/24/aea601f751d212ec034be97db6f41c9d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/dd/28/24/aea601f751d212ec034be97db6f41c9d.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/dd/28/24/aea601f751d212ec034be97db6f41c9d.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/dd/28/24/aea601f751d212ec034be97db6f41c9d.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/dd/28/24/aea601f751d212ec034be97db6f41c9d.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/b0/31/33/5e4342f537bc2cca0ab788359a935997.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b0/31/33/5e4342f537bc2cca0ab788359a935997.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b0/31/33/5e4342f537bc2cca0ab788359a935997.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b0/31/33/5e4342f537bc2cca0ab788359a935997.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b0/31/33/5e4342f537bc2cca0ab788359a935997.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/b1/3e/e6/6daddf08d299a51e21b34819c39d079f.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b1/3e/e6/6daddf08d299a51e21b34819c39d079f.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b1/3e/e6/6daddf08d299a51e21b34819c39d079f.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b1/3e/e6/6dad