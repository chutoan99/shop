,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.7,"review_count":381,"review_text":"(381)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/68/8b/d8/1728b44835e65932a2e40764b36b28b7.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1806,"all_time_quantity_sold":1184,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp data-spm-anchor-id=\"a2o4n.pdp.product_\"\u003eMŨ BẢO HIỂM NỬA ĐẦU A737K\u003c/p\u003e\n\u003cp data-spm-anchor-id=\"a2o4n.pdp.product_\"\u003e*** \u003cstrong\u003e\u003cem\u003eMũ bảo hiểm nửa đầu GRS A737k\u003c/em\u003e\u003c/strong\u003e có kiểu dáng hiện đại, đẹp mắt, phần kính trong suốt phía trước bảo vệ tối ưu. Vỏ ngoài được làm từ chất liệu nhựa ABS chuyên dùng, chịu lực và chịu va chạm tốt để bạn an tâm khi lưu thông trên đường. Bên trong được trang bị lớp vải lót mềm, có khả năng chống khuẩn, chống ẩm tốt, tránh tình trạng ngứa da đầu kể cả khi bạn đội mũ trong thời tiết nóng bức.\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cstrong\u003e*** Thông tin sản phẩm:\u003c/strong\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e + Chất liệu cao cấp, bền bỉ:\u003c/p\u003e\n\u003cp\u003eVỏ ngoài làm từ nhựa ABS tổng hợp có thể chịu được va đập mạnh, nên Mũ GRS A737k sẽ bảo vệ bạn hiệu quả trước những va chạm ngoài ý muốn. Đồng thời, chất liệu này cũng giúp sản phẩm có độ bền cao hơn, cho thời gian sử dụng lâu dài.\u003c/p\u003e\n\u003cp\u003e+ Thoải mái khi sử dụng:\u003c/p\u003e\n\u003cp\u003eKhi đội mũ, bạn sẽ không có cảm giác đau hay nặng đầu nhờ lớp mút xốp lót bên trong êm ái, tạo cảm giác thoải mái. Lớp vải lót có khả năng kháng khuẩn, chống ẩm giúp hạn chế các bệnh về tóc và da đầu khi phải đội mũ trong thời gian dài.\u003c/p\u003e\n\u003cp\u003e+ Kiểu dáng nửa đầu thời trang:\u003c/p\u003e\n\u003cp\u003eSản phẩm có thiết kế thời trang cùng màu sắc trẻ trung, tươi mới, phù hợp với nhiều đối tượng sử dụng.\u003c/p\u003e\n\u003cp\u003e+ Thiết kế chắc chắn, an toàn:\u003c/p\u003e\n\u003cp\u003eMũ Bảo Hiểm Nửa Đầu Có Kính GRS A737k được thiết kế ôm vừa vặn phần đầu, dây và khóa cài chắc chắc giúp giữ chặt mũ với đầu, cho tính an toàn cao hơn, để bạn an tâm khi lưu thông trên đường. Bên cạnh đó, dây và khóa cài còn có thể thay đổi độ dài ngắn dễ dàng để bạn linh hoạt điều chỉnh khi cần.\u003c/p\u003e\n\u003cp\u003e+ Phần kính chắn trong suốt bảo vệ bạn dưới những tác động từ bên ngoài như nắng, gió, khói bụi\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/7c/c7/0e/5cc357d0fb2e8655d54ad33dc6653c83.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/7c/c7/0e/5cc357d0fb2e8655d54ad33dc6653c83.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/51/71/03/bf5f93f8301b366fe77aacf2734e11c9.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/51/71/03/bf5f93f8301b366fe77aacf2734e11c9.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/e3/de/ad/f6c56005196bbd39afad00b98a1eaa83.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/e3/de/ad/f6c56005196bbd39afad00b98a1eaa83.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cstrong\u003e*** Thông tin thương hiệu:\u003c/strong\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003eGRS là thương hiệu mũ bảo hiểm chính hãng được sản xuất bởi Công ty TNHH MTV SX -TM HOÀNG QUÁN (thương hiệu Đài Loan), đã khẳng định được uy tín tại Việt Nam, với nguyên liệu nhập khẩu 100% từ Đài Loan, lắp ráp tại Việt Nam bảo đảm về chất lượng, có tem hợp quy CR (tem chứng nhận đạt chuẩn theo TCVN) dán sau mũ.\u003c/p\u003e\n\u003cp\u003e*** \u003cem\u003e\u003cstrong\u003eHướng dẫn xác định cỡ mũ phù hợp:\u003c/strong\u003e\u003c/em\u003e Vòng 1 sợi dây quanh đầu, phía trên lông mày và tai khoảng 2cm. Xiết sợi dây sao cho ôm vừa đủ thoải mái lấy đầu và ghi lại số đo đó. Lặp lại như vậy để tìm được số đo mà bạn thấy đầu dễ chịu nhất. Đó chính là size đầu của bạn. So sánh với kích cỡ mũ để lựa chọn size mũ phù hợp nhất.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/68/8b/d8/1728b44835e65932a2e40764b36b28b7.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/68/8b/d8/1728b44835e65932a2e40764b36b28b7.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/68/8b/d8/1728b44835e65932a2e40764b36b28b7.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/68/8b/d8/1728b44835e65932a2e40764b36b28b7.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/68/8b/d8/1728b44835e65932a2e40764b36b28b7.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/84/5a/25/3bf009921fd5c447106db675136b9094.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/84/5a/25/3bf009921fd5c447106db675136b9094.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/84/5a/25/3bf009921fd5c447106db675136b9094.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/84/5a/25/3bf009921fd5c447106db675136b9094.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/84/5a/25/3bf009921fd5c4471