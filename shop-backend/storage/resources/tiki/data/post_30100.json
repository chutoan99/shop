 và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/media/catalog/product/r/u/ruot-oi-la-ruot-01.u4972.d20170419.t121614.594677.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/r/u/ruot-oi-la-ruot-01.u4972.d20170419.t121614.594677.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/r/u/ruot-oi-la-ruot-01.u4972.d20170419.t121614.594677.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/r/u/ruot-oi-la-ruot-01.u4972.d20170419.t121614.594677.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/r/u/ruot-oi-la-ruot-01.u4972.d20170419.t121614.594677.jpg"}],"warranty_policy":null,"authors":[{"id":112595,"name":"Giulia Enders","slug":"giulia-enders"}],"current_seller":{"id":97533,"sku":"7005144181924","name":"Nhà Sách Vĩnh Thụy","link":"https://tiki.vn/cua-hang/nha-sach-vinh-thuy","logo":"19/f2/bd/8bda12adffb15edf1b3d8339b0238283.jpg","price":90000,"product_id":"173568522","store_id":90454,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[{"id":9988,"name":"AHABOOKS","link":"https://tiki.vn/cua-hang/ahabooks","logo":"7c/b8/e1/357f6a5d18da8daa4e9060a6b7eb9d5f.png","price":107970,"product_id":"8246173","store_id":9778},{"id":26874,"name":"Phương Đông Books","link":"https://tiki.vn/cua-hang/phuong-dong-books","logo":"2e/85/b7/e76104ae5f1beaf244f319e2f0d2d413.jpg","price":98300,"product_id":"12500893","store_id":26242},{"id":161219,"name":"Nhà Sách Trẻ Online","link":"https://tiki.vn/cua-hang/nha-sach-tre-online","logo":"6f/c0/15/6a56eb097a331c384398004ed5bc09ca.jpg","price":101150,"product_id":"82669728","store_id":148433},{"id":10821,"name":"nha sach nguyet linh","link":"https://tiki.vn/cua-han