kground_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.6,"review_count":10,"review_text":"(10)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/6c/7a/d5/5facf5683460ac403249fe8d71e17032.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":433,"all_time_quantity_sold":26,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003eGiới thiệu\u003c/h3\u003e\n\u003cp\u003eBước vào kỷ nguyên mới của việc hút sữa bằng sự cân bằng hoàn hảo giữa lực hút và kích thích núm vú được lấy cảm hứng từ cách bú sữa tự nhiên của trẻ. Máy hút sữa điện đôi Philips Avent duy trì dòng sữa ở mức tối ưu và nhẹ nhàng thích ứng với kích thước và hình dạng núm vú của bạn\u003c/p\u003e\n\u003ch3\u003eĐặc điểm nổi bật\u003c/h3\u003e\n\u003cp\u003e\u003cstrong\u003eMáy hút sữa bằng điện Philips AVENT SCF393/11 \u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eHút sữa và kích thích núm vú như cách bú sữa tự nhiên của trẻ.\u003c/li\u003e\n\u003cli\u003eCông nghệ chuyển động tự nhiên giúp hút sữa nhanh hơn, nhiều hơn, trong thời gian ngắn hơn*\u003c/li\u003e\n\u003cli\u003eMiếng đệm bằng silicon mềm mại, co giãn, phù hợp với mọi kích thước và hình dạng núm vú của mẹ\u003c/li\u003e\n\u003cli\u003eHút sữa nhẹ nhàng và thoải mái mà không cần phải nghiêng người về phía trước\u003c/li\u003e\n\u003cli\u003eCó thể tùy chỉnh theo nhu cầu cá nhân với 8 mức kích thích và 16 mức hút\u003c/li\u003e\n\u003cli\u003eĐộng cơ chạy êm để hút sữa một cách kín đáo ở bất cứ nơi đâu (sử dụng dây nối)\u003c/li\u003e\n\u003cli\u003eChức năng bộ nhớ cho phép máy lưu lại chế đột hút và kích thích ở lần hút sữa cuối cùng\u003c/li\u003e\n\u003cli\u003eChức năng tạm dừng/phát cho phép mẹ điều chỉnh chế độ hoặc tạm dừng bất cứ khi muốn\u003c/li\u003e\n\u003cli\u003eCó sẵn túi nhỏ và bao đựng máy hút sữa\u003c/li\u003e\n\u003cli\u003eÍt bộ phận, dễ lắp đặt, vệ sinh\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003ePhụ kiện đi kèm\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eTúi chứa : 1  cái\u003c/li\u003e\n\u003cli\u003eBình sữa 125ml/4oz, tốc độ chảy cho trẻ sơ sinh: 2  cái\u003c/li\u003e\n\u003cli\u003eMiếng lót thấm sữa dùng một lần: 2  cái\u003c/li\u003e\n\u003cli\u003eBộ dụng cụ hút sữa: 2  cái\u003c/li\u003e\n\u003cli\u003eBao đựng cách nhiệt: 1  cái\u003c/li\u003e\n\u003cli\u003eBộ phận động cơ (Chỉ sử dụng có nối dây): 1  cái\u003c/li\u003e\n\u003cli\u003eĐĩa đệm kín: 2  cái\u003c/li\u003e\n\u003cli\u003eBộ chuyển đổi Micro-USB (sử dụng có nối dây): 1  cái\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003eChức năng\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eKhông cần nghiêng người về phía trước: Tư thế ngồi thoải mái\u003c/li\u003e\n\u003cli\u003eCài đặt\u003c/li\u003e\n\u003c/ul\u003e\n\u003cul\u003e\n\u003cli style=\"list-style-type:none;\"\u003e\n\u003cul class=\"p-bullets\"\u003e\n\u003cli\u003e\n\u003cdiv class=\"p-body-copy-02\"\u003e16 mức hút sữa\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv class=\"p-body-copy-02\"\u003e8 mức kích thích\u003c/div\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cul\u003e\n\u003cli\u003eMiếng đệm mềm và co giãn: Kích thích nhẹ nhàng\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003eCông suất\u003c/h3\u003e\n\u003cdl class=\"p-s08__main-list\"\u003e\n\u003cdt class=\"p-heading-04 p-heading-bold p-s08__main-list-title\"\u003eĐiện áp nguồn điện: 100 - 240  V\u003c/dt\u003e\n\u003c/dl\u003e\n\u003ch3 class=\"p-heading-03 p-heading-light p-s08__spec-title\"\u003eChất liệu\u003c/h3\u003e\n\u003cdl class=\"p-s08__main-lis