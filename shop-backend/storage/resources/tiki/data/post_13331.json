on_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.3,"review_count":3,"review_text":"(3)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/e2/b8/cc/53b318cc6432ff8c2b0a53acfe926b94.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1932,"all_time_quantity_sold":3,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eNón bảo hiểm fullface Sunda 2000c đen nhám tem xanh:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eNón được thiết kế nhỏ gọn, lòng nón sâu, phù hợp cho người có vòng đầu từ 55-59 cm - đây là size phổ biến của người VN trưởng thành\u003c/p\u003e\n\u003cp\u003eSunda 2000c là sản phẩm có độ bền cao, chịu được va đập tốt, thiết kế thời trang thông minh, bảo vệ an toàn trên mỗi hành trình của bạn.\u003c/p\u003e\n\u003cp\u003eVỏ mũ: Sản phẩm mũ bảo hiểm Sunda cam kết luôn sử dụng nhựa ABS nguyên sinh 100% được nhập khẩu từ các nhà cung ứng uy tín như Hàn Quốc, Malaysia, Thái, Nhật chịu được độ va đập cao.\u003c/p\u003e\n\u003cp\u003eHệ thống thông gió trên thân mũ:  giúp tản nhiệt. Với thiết kế thông minh, phía trước mũ có 2 lỗ thông gió hình tam giác có thể dễ dàng đóng/ mở bằng cách trượt nhẹ, giúp người sử dụng luôn cảm thấy thông thoáng, đồng thời ngăn chặn hoàn toàn nước mưa khi thay đổi thời tiết.\u003c/p\u003e\n\u003cp\u003eBộ phận thông gió dưới cằm: có hình dạng hình tam giác có thể được mở bằng cách đẩy lên và có thể đóng bằng cách đẩy nắp xuống, giúp không khí lưu thông vào bên trong mũ.\u003c/p\u003e\n\u003cp\u003eLưới dưới cằm: vừa giúp tạo cảm giác thông thoáng vừa có tác dụng ngăn chặn côn trùng.\u003c/p\u003e\n\u003cp\u003eKính: được làm từ vật liệu chất lượng cao, đã qua xử lý đặc biệt, cho góc quan sát rộng, hình ảnh rõ nét, trung thực, không bị chói đèn, có khả năng chống tia UV400, chắn gió, chống xước. Kính được thiết kế tháo lắp dễ dàng bằng tay không, không cần sử dụng dụng cụ hỗ trợ.\u003c/p\u003e\n\u003cp\u003eKhóa mũ: sử dụng khóa E8 dễ đóng, mở, chịu được lực kéo mạnh, chắc chắn,  đảm bảo an toàn tốt nhất cho người sử dụng.\u003c/p\u003e\n\u003cp\u003eDây mũ: dài, chắc chắn, có thể điều chỉnh linh hoạt phù hợp với nhu cầu của người sử dụng.\u003c/p\u003e\n\u003cp\u003eVải lót cao cấp được xử lý kháng khuẩn, thấm hút tốt, mau khô, giúp hạn chế nguy cơ mắc các bệnh về tóc và da đầu.\u003c/p\u003e\n\u003cp\u003eMút xốp: là bộ phận quan trọng của nón, được thiết kế để có thể hấp thụ lực khi xảy ra tai nạn. Do đó Sunda luôn cam kết sử dụng xốp nguyên sinh để đảm bảo chất lượng tốt nhất cho sự an toàn của người sử dụng.\u003c/p\u003e\n\u003cp\u003eMũ thiết kế nhiều lỗ thông gió phía trước và sau mũ, các lỗ này có thể đóng mở được, đảm bảo bạn luôn cảm thấy thoải mái và dễ chịu khi sử dụng.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e*** Hướng dẫn xác định cỡ mũ phù hợp:\u003c/strong\u003e Vòng 1 sợi dây quanh đầu, phía trên lông mày và tai khoảng 2cm. Xiết sợi dây sao cho ôm vừa đủ thoải mái lấy đầu và ghi lại số đo đó. Lặp lại như vậy để tìm được số đo mà bạn thấy đầu dễ chịu nhất. Đó chính là size đầu của bạn. So sánh với kích thước mũ để tìm size mũ phù hợp.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/a4/15/83/774a9a0c92ed5891ac8fb707799e2108.jpg\" alt=\"non bao hiem sunda 2000c den nham tem xanh\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/19/e3/c1/a42ec7dbc7