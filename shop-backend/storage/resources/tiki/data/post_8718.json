xt_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":8,"review_text":"(8)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/68/a4/d1/00de6f174327bdfabdb5800577136fb0.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":402,"all_time_quantity_sold":144,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"margin:0px;padding:0px;line-height:1.7;color:#333333;font-family:'system-ui', '-apple-system', BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;font-size:12px;font-style:normal;font-weight:400;letter-spacing:normal;text-indent:0px;text-transform:none;white-space:normal;word-spacing:0px;background-color:#ffffff;text-align:left;\"\u003e\u003cspan style=\"margin:0px;padding:0px;\"\u003eNhà xuất bản Đồng Nai\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"margin:0px;padding:0px;line-height:1.7;color:#333333;font-family:'system-ui', '-apple-system', BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;font-size:12px;font-style:normal;font-weight:400;letter-spacing:normal;text-indent:0px;text-transform:none;white-space:normal;word-spacing:0px;background-color:#ffffff;text-align:left;\"\u003e\u003cspan style=\"margin:0px;padding:0px;\"\u003eKích thước: 15.5 x 23.5cm\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"margin:0px;padding:0px;line-height:1.7;color:#333333;font-family:'system-ui', '-apple-system', BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;font-size:12px;font-style:normal;font-weight:400;letter-spacing:normal;text-indent:0px;text-transform:none;white-space:normal;word-spacing:0px;background-color:#ffffff;text-align:left;\"\u003e\u003cspan style=\"margin:0px;padding:0px;\"\u003eHình thức: Nét chữ in mờ, gáy lò xo, bìa cứng\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"margin:0px;padding:0px;line-height:1.7;color:#333333;font-family:'system-ui', '-apple-system', BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;font-size:12px;font-style:normal;font-weight:400;letter-spacing:normal;text-indent:0px;text-transform:none;white-space:normal;word-spacing:0px;background-color:#ffffff;text-align:left;\"\u003e\u003cspan style=\"margin:0px;padding:0px;\"\u003eDịch giả: HT. Thích Trí Tịnh\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"margin:0px;padding:0px;line-height:1.7;color:#333333;font-family:'system-ui', '-apple-system', BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;font-size:12px;font-style:normal;font-weight:400;letter-spacing:normal;text-indent:0px;text-transform:none;white-space:normal;word-spacing:0px;background-color:#ffffff;text-align:left;\"\u003e\u003cspan style=\"margin:0px;padding:0px;\"\u003eSố trang: 129 trang\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"margin:0px;padding:0px;line-height:1.7;color:#333333;font-family:'system-ui', '-apple-system', BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;font-size:12px;font-style:normal;font-weight:400;letter-spacing:normal;text-indent:0px;text-transform:none;white-space:normal;word-spacing:0px;background-color:#ffffff;text-align:left;\"\u003e\u003cspan style=\"margin:0px;padding:0px;\"\u003eKinh Địa Tạng (tên đầy đủ là kinh Địa Tạng Bồ Tát Bổn Nguyện) là bản kinh nói về công hạnh và nguyện lực của Bồ Tát Địa Tạng. Chép kinh Địa Tạng là một phương pháp thực tập phổ biến ngày nay. Bồ tát Địa Tạng có đại nguyện cứu độ tất cả chúng sanh trong sáu cõi luân hồi và không thành Phật quả khi cõi địa ngục vẫn còn chúng sanh phải chịu đau khổ. Điều đó thể hiện tinh thần từ bi cao thượng của nhà Phật.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"margin:0px;padding:0px;line-height:1.7;color:#333333;font-family:'system-ui', '-apple-system', BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;font-size:12px;font-style:normal;font-weight:400;letter-spacing:normal;text-indent:0px;text-transform:none;white-space:normal;word-spacing:0px;background-color:#ffffff;text-align:left;\"\u003e\u003cspan style=\"margin:0px;padding:0px;\"\u003eToàn bộ kinh Địa Tạng gồm 13 phẩm. Thông qua hai hình ảnh đối lập, một bên là tinh thần từ bi cao cả của Bồ tát Địa Tạng, một bên là sự đau khổ cùng cực trong cõi địa ngục, kinh này cảnh tỉnh người đời từ bỏ tham sân si, tu tập các việc lành, giải trừ vô minh… Kinh này phổ biến ở các nước Phật giáo Đại thừa, sử dụng chủ yếu trong các nghi thức cầu siêu cho người quá vãng.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"margin:0px;padding:0px;line-height:1.7;color:#333333;font-family:'system-ui', '-apple-system', BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;font-size:12px;font-style:normal;font-weight:400;letter-spacing:normal;text-indent:0px;text-transform:none;white-space:normal;word-spacing:0px;background-color:#ffffff;text-align:left;\"\u003e\u003cspan style=\"margin:0px;padding:0px;\"\u003eTrong phần lớn nội dung Phẩm 6 của kinh này có đề cập đến những lợi ích đối với các chúng sanh khi lễ bái và cúng dường Bồ tát Địa Tạng, trì tụng và biên chép kinh Địa Tạng, khuyên nhủ người khác noi theo công hạnh của Bồ tát Địa Tạng. Các lợi ích của việc chép kinh Địa Tạng có thể kể đến như tiêu trừ tội chướng, được thân xinh đẹp, thoát kiếp nô lệ, siêu độ vong linh…\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"margin:0px;padding:0px;line-height:1.7;color:#333333;font-family:'system-ui', '-apple-system', BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;font-size:12px;font-style:normal;font-weight:400;letter-spacing:normal;text-indent:0px;text-transform:none;white-space:normal;word-spacing:0px;background-color:#ffffff;text-align:left;\"\u003e\u003cspan style=\"margin:0px;padding:0px;\"\u003eNhờ công đức thọ trì kinh điển, chúng ta được Chư Phật, Bồ Tát, Chư Thiên… gia trợ hộ trì để vượt qua các chướng ngại và thành tựu các thiện sự. Đặc biệt, chúng ta có thể hồi hướng công đức thọ trì kinh điển đến người thân đã mất, rộng hơn nữa là cầu nguyện cho chúng sanh đang chịu khổ đau trong các cõi luân hồi. Sau khi chép kinh Địa Tạng, Phật tử cần học theo tấm gương từ bi rộng lớn của Bồ Tát Địa Tạng. Mỗi người có thể tùy theo khả năng của mình mà thực hiện những hành động nhằm giúp đỡ các chúng sanh chịu đau khổ. Đó là ứng dụng lời dạy của Chư Phật và Chư Bồ Tát vào đời sống thực tế.\u003c/span\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/68/a4/d1/00de6f174327bdfabdb5800577136fb0.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/68/a4/d1/00de6f174327bdfabdb5800577136fb0.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/68/a4/d1/00de6f174327bdfabdb5800577136fb0.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/68/a4/d1/00de6f174327bdfabdb5800577136fb0.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/68/a4/d1/00de6f174327bdfabdb5800577136fb0.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/53/c7/db/251898110e4d6332450dd845e905dfe6.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/53/c7/db/251898110e4d6332450dd845e905dfe6.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/53/c7/db/251898110e4d6332450dd845e905dfe6.jpg","position":null,"small_url":"htt