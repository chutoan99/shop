://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/d1/53/33/26802a32ffc59be2e8ca6cab687b7445.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":8,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch1\u003eMicronized Creatine ON - Lựa chọn hoàn hảo cho chế độ tập luyện của bạn\u003c/h1\u003e\n\u003cp\u003eMicronized Creatine ON được sản xuất bởi Optimum Nutrition, thương hiệu cung cấp TPBS hàng đầu nước Mỹ. Sản phẩm hỗ trợ tăng năng lượng, sức bền và kích thước cơ vô cùng hiệu quả.\u003c/p\u003e\n\u003ch2\u003eThành phần chính có trong mỗi khẩu phần Micronized Creatine ON \u003c/h2\u003e\n\u003cp\u003e\u003cimg class=\"ckimgrsz\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/6b/1e/b6/9db2fd3b95616b168b809db5f2b28c90.jpg\" alt=\"Micronized-Creatine-ON-tang-cuong-do-hieu-suat-tap-luyen\" width=\"900\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003eTăng khối lượng cơ bắp và giảm tình trạng viêm cơ\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e5g Creatine Monohydrate: Creatine hay  Creatine Monohydrate là một chất thường được sử dụng trong TPBS. Creatine có vai trò lớn trong việc cải thiện cường độ tập luyện, tăng khối lượng cơ bắp và giảm tình trạng viêm cơ. Nó được ví như “thần dược” giúp người tập có sự bền bỉ và sức chịu đựng cao hơn. Bên cạnh đó  creatine còn tăng khả năng chống các gốc tự do, thúc đẩy quả trình phục hồi và phát triển cơ bắp diễn ra nhanh hơn. \u003c/p\u003e\n\u003ch2\u003eTại sao nên sử dụng Micronized Creatine ON?\u003c/h2\u003e\n\u003cp\u003e\u003cimg class=\"ckimgrsz\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/92/84/47/dc09e8f464911a6dd3143dd7824d119c.jpg\" alt=\"Micronized-Creatine-ON-phat-trien-co-bap\" width=\"900\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003eMicronized Creatine ON có nhiều công dụng vượt trội\u003c/em\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eHỗ trợ tăng sức bền cũng như cải thiện hiệu suất tập luyện.\u003c/li\u003e\u003cli\u003eGia tăng kích thước và khối lượng cơ bắp đồng thời hỗ trợ phát triển cơ bắp.\u003c/li\u003e\u003cli\u003eCung cấp nước cho tế bào, qua đó hỗ trợ cơ phồng to hơn.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cimg class=\"ckimgrsz\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/08/31/9c/0cc9f5cb289b52793c9d2b2c8b37fcc0.jpg\" alt=\"Micronized-Creatine-ON-creatine-tinh-khiet\" width=\"900\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003eMicronized Creatine ON 100% nguyên chất\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003eMicronized Creatine ON đã trải qua quá trình tinh lọc kỹ lưỡng bởi các công nghệ hiện đại để cho ra sản phẩm  creatine tinh khiết và hoàn toàn không chứa tạp chất. Bên cạnh đó, nó được sản xuất dưới dạng bột mịn, dễ hòa tan nhờ áp dụng công nghệ mài mòn phân thử  Micronized để làm ra các hạt siêu nhỏ giúp dễ thẩm thấu và hấp thụ vào cơ bắp tốt hơn.\u003c/p\u003e\n\u003cp\u003eKhác với các dòng Micronized Creatine thông thường, sản phẩm nhà Optimum Nutrition vô cùng sánh mịn. Khi sử dụng Creatine không tinh khiết có thể để lại cặn sau khi uống. Tuy nhiên với Micronized Creatine ON thì cảm giác sạn trong miệng là hoàn toàn không có. \u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"ckimgrsz\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/0a/a3/56/15a355df1633e09c95c12369ea05bbb0.jpg\" alt=\"Micronized-Creatine-ON-thuong-hieu-danh-tieng\" width=\"900\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003eOptimum Nutrition - thương hiệu TPBS quốc tế\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003eĐược thành lập vào năm 1986, Optimum Nutrition ngày càng để lại được nhiều dấu ấn riêng trong lòng người tiêu dùng. Hiện nay, đơn vị này được đánh giá là một trong những thương hiệu cung cấp TPBS hàng đầu tại Mỹ. Các sản phẩm của Optimum Nutrition đã có mặt tại hơn 100 quốc gia trên toàn thế giới và nhận được nhiều phản hồi tích cực từ phía khách hàng.\u003c/p\u003e\n\u003cp\u003eTheo chia sẻ từ nhà sản xuất, họ đã chọn lọc kỹ lưỡng và lựa chọn những nguyên liệu thô cao cấp nhất để cho ra những sản phẩm chất lượng, có hương vị tuyệt vời. Với tiêu chí luôn quan tâm đến sức khỏe của khách hàng, mọi khâu trong quá trình sản xuất đều được kiểm tra nhiều lần một cách cẩn thận, do đó bạn có thể yên tâm khi sử dụng sản phẩm.\u003c/p\u003e\n\u003ch2\u003eNhững điều cần lưu ý khi sử dụng Micronized Creatine ON\u003c/h2\u003e\n\u003cul\u003e\u003cli\u003eSản phẩm này dành cho những người có độ tuổi từ 18 trở lên. \u003c/li\u003e\u003cli\u003eKhông tùy tiện tăng giảm liều lượng nếu không được sự cho phép của các chuyên gia để sản phẩm phát huy hiệu quả tốt nhất.\u003c/li\u003e\u003cli\u003eNếu bạn thuộc một trong các đối tượng: Dưới 18 tuổi, phụ nữ đang mang thai hoặc cho con bú, đang dùng thuốc, có bệnh lý, nên hỏi ý kiến của bác sĩ trước khi sử dụng sản phẩm.\u003c/li\u003e\u003cli\u003eNên chú ý hạn sử dụng của sản phẩm, không nên sử dụng khi sản phẩm đã có dấu hiệu hư hỏng.\u003c/li\u003e\u003cli\u003eHãy lưu ý để sản phẩm xa tầm với của trẻ nhỏ.\u003c/li\u003e\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/d1/53/33/26802a32ffc59be2e8ca6cab687b7445.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d1/53/33/26802a32ffc59be2e8ca6cab687b7445.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d1/53/33/26802a32ffc59be2e8ca6cab687b7445.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d1/53/33/26802a32ffc59be2e8ca6cab687b7445.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d1/53/33/26802a32ffc59be2e8ca6cab687b7445.png"},{"base_url":"https://salt.tikicdn.com/ts/product/89/89/0c/4b6f11d2d98e433eb1c603a3324c4c29.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/89/89/0c/4b6f11d2d98e433eb1c603a3324c4c29.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/89/89/0c/4b6f11d2d98e433eb1c603a3324c4c29.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/89/89/0c/4b6f11d2d98e433eb1c603a3324c4c29.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/89/89/0c/4b6f11d2d98e433eb1c603a3324c4c29.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/89/a5/ba/6c199305f9c9ce831bcb4877e2ce65bd.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/89/a5/ba/6c199305f9c9ce831bcb4877e2ce65bd.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/89/a5/ba/6c199305f9c9ce831bcb4877e2ce65bd.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/89/a5/ba/6c199305f9c9ce831bcb4877e2ce65bd.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/89/a5/ba/6c199305f9c9ce831bcb4877e2ce65bd.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/2f/0e/a7/8a3d62ee02f77f7ce51095c4df448ecb.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/2f/0e/a7/8a3d62ee02