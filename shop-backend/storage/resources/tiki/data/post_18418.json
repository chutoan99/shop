f":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.7,"review_count":38,"review_text":"(38)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/19/f6/20/ff889cd7a1c3c41c5403e7f9225c7c43.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":989,"all_time_quantity_sold":205,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2\u003e\u003cstrong\u003eBioRoot – Siêu kích rễ cho lan, cây cảnh\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003e\u003cstrong\u003ePhân bón Siêu Kích rễ cho hoa lan, cây cảnh BioRoot\u003c/strong\u003e là chế phẩm hữu cơ vi sinh được ủ theo công thức độc quyền, giàu Potassium Humate và các chất dinh dương thúc đẩy sự phát triển của rễ cây, đặc biệt là hoa lan. Ngoài ra, BioRoot còn được người chơi cây cảnh chuyên nghiệp dùng “hồi sức” cây sang chậu và áp dụng rộng rãi để kích rễ khi giâm cành, nhân giống. Được kiểm định chất lượng bởi TỔNG CỤC TIÊU CHUẨN ĐO LƯỜNG CHẤT LƯỢNG và phân phối bởi DOCNEEM, BioRoot dự kiến sẽ phá đảo thị thị trường phân bón cho hoa lan với công dụng vượt trội, an toàn cho cây cảnh và cả người sử dụng với những ưu điểm vượt trội\u003c/p\u003e\n\u003cp\u003e- Cô đặc, hàm lượng dinh dưỡng x2 \u003c/p\u003e\n\u003cp\u003e- Pha loãng và sử dụng dễ dàng cho nhiều loại cây cảnh khác nhau \u003c/p\u003e\n\u003cp\u003e- AN TOÀN với môi trường và người sử dụng \u003c/p\u003e\n\u003cp\u003e- Thương hiệu DOCNEEM được bảo hộ tại Cục sở hữu trí tuệ Việt Nam\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/06/65/77/e9ca39a46303a4635d2af3d0643648b8.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eThành phần\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003e- Potassium Humate (80%)\u003c/p\u003e\n\u003cp\u003e- Fulvic Acid (12%)\u003c/p\u003e\n\u003cp\u003e- N (0.28%)\u003c/p\u003e\n\u003cp\u003e- P2O5 (0.06%)\u003c/p\u003e\n\u003cp\u003e- K2O (0.65%)\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/25/33/94/34ab20dd8e8f3ca4e4be815bbcfec3dc.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eCông dụng\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003ePhân bón Kích rễ cho lan BioRoot xây dựng một bộ rễ khoẻ, vững chắc cho hoa lan. Từ đó, cây trồng hấp thụ đủ nước, chất dinh dưỡng và phát triển vượt trội với khả năng chống chịu hoàn hảo trước những nhân tố khắc nghiệt của môi trường như lạnh, hạn hán,…\u003c/p\u003e\n\u003cp\u003eKích rễ BioRoot là sản phẩm phân bón dạng dung dịch, dễ hoà tan và giúp cây hấp thu nhanh hơn các phân bón dạng hạt thông thường.\u003c/p\u003e\n\u003cp\u003e- Phù hợp với tất cả các loại cây trồng\u003c/p\u003e\n\u003cp\u003e- Thích hợp với các loại đất khác nhau của từng vùng miền hoặc giá thể\u003c/p\u003e\n\u003cp\u003e- Hiệu quả cao đối với các loại cây con, cây giâm chiết cành hoặc các cây đang giai đoạn phát triển\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/c0/65/eb/c6b9236c333a1a12dfdbf3caf1c7ed63.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eCách sử dụng\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003e\u003cstrong\u003eVới hoa lan:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Kích rễ Bio Root có thể sử dụng trong bất cứ giai đoạn nào của Lan, đặc biệt dùng cho cả cây yếu. \u003c/p\u003e\n\u003cp\u003e- Tỉ lệ: 8-10ml/ lít nước sạch, phun lên lá, tưới gốc mỗi 2 lần/tháng\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCây cảnh khác:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Lúc vừa sang/chuyển chậu: 8-10ml/ lít nước sạch, bón mỗi 5-7 ngày/lần, liên tục trong 1 tháng \u003c/p\u003e\n\u003cp\u003e- Cây ổn định: 8-10ml/ lít nước sạch, phun lên lá, tưới gốc mỗi 2 lần/tháng\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eGiâm cành giống:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Ngâm trực tiếp vào dung dịch 15-20 phút và giâm cành Không cần rữa lại với nước\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/67/75/76/8bb1d0bf17b8d77a3b2834f2547c8ff8.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eThông tin khác\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003e- Hạn sử dụng: 36 tháng kể từ ngay sản xuất \u003c/p\u003e\n\u003cp\u003e- Dung tích: 500 ml \u003c/p\u003e\n\u003cp\u003e- Bảo quản nơi khô ráo, thoáng mát, vặn kín nắp chai sau khi sử dụng và tránh ánh nắng trực tiếp từ mặt trời\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/19/f6/20/ff889cd7a1c3c41c5403e7f9225c7c43.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/19/f6/20/ff889cd7a1c3c41c5403e7f9225c7c43.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/19/f6/20/ff889cd7a1c3c41c5403e7f9225c7c43.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/19/f6/20/ff889cd7a1c3c41c5403e7f9225c7c43.jpg","thu