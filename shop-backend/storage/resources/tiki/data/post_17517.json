_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.6,"review_count":474,"review_text":"(474)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/2e/e0/f9/346896a9d916c6e001988cf81367af9f.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1771,"all_time_quantity_sold":1367,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch1 style=\"text-align: center;\"\u003e\u003cstrong\u003eCon Lăn Tập Bụng 4 Bánh Chính Hãng Amalife – Kèm Đệm Lót\u003c/strong\u003e\u003c/h1\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cstrong\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/1b/47/99/a7a998e4324e4251ddb9f5059709ff7b.png\" alt=\"Con Lăn Tập Bụng \" width=\"750\" height=\"750\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eMô tả sản phẩm:\u003c/strong\u003e\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cp\u003eThiết kế đơn giản; gọn nhẹ; dễ sử dụng, tập hiệu quả động hợp thời trang. Giảm mỡ bụng; nhanh chóng lấy lại vóc dáng thon gọn; săn chắc động hợp thời trang. Dễ dàng sử dụng với nhiều tư thế và thao tác cho sức khỏe dẻo dai; cơ bắp săn chắc; khỏe mạnh và thon gọn động hợp thời trang\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003ePhù hợp sử dụng cho tất cả mọi người\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eCon Lăn Tập Cơ Bụng 4 Bánh Chính Hãng Amalife là bộ dụng cụ tập luyện dành cho những người bận rộn hay không muốn mất nhiều thời gian đến phòng tập nhưng vẫn mong có 1 thân hình săn chắc, khỏe mạnh.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eThiết kế tiện dụng, chắc chắn với nguyên liệu nhựa cao cấp, cứng chắc, kích thước nhỏ gọn dễ cất giữ.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eCon lăn có thiết kế, cấu tạo đơn giản nhưng đa năng, có thể tập cho nhiều bộ phận cơ thể: bụng, eo, tay, đùi, lưng. Thiết kế nhỏ gọn giúp tiết kiệm không gian và thời gian tập luyện. \u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eBánh xe con lăn nhỏ nhưng cực kỳ chắc chắn với vỏ cao su bọc ngoài được thiết kế nhám sẽ giúp bạn dễ dàng di chuyển trên mặt đất mà không sợ bị trơn trượt.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eCó khả năng chịu sức nặng của người tập lên tới 120kg.\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/92/d0/38/dc7bcd9228895a0032964b1231b0a52e.png\" alt=\"Con Lăn Tập Bụng Chính Hãng\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/4b/66/ac/1c535b1abd6d8085acd54a50d6ac09d7.png\" alt=\"Con Lăn Tập Bụng Chính Hãng\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/7c/4a/a8/f39357ba5370337b8a74fd8d5a6e45cd.png\" alt=\"Con Lăn Tập Bụng \" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/4c/bc/e8/b7d16eb2880ce08a66cecbc4b75d22da.png\" alt=\"Con Lăn Tập Bụng\" width=\"750\" height=\"453\" /\u003e\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eHướng dẫn cách sử dụng Con lăn tập bụng 4 bánh chính hãng Amalife:\u003c/strong\u003e\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cp\u003e\u003cstrong\u003eB1:\u003c/strong\u003e Đầu tiên bạn nên trong tư thế quỳ đầu gối lên tấm thảm (Bạn có thể dùng Thảm tập yoga chính hãng của Amalife nhé), 2 tay đặt vào hai bên tay cầm của con lăn tập bụng 4 bánh. Chú ý tay cầm thoải mái không quá chặt dễ gây tê mỏi tay và khó cử động, không cầm quá lỏng vì dễ bị trượt tay khi bạn đẩy con lăn về phía trước\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003e\u003cstrong\u003eB2:\u003c/strong\u003e Dùng lực từ từ đẩy con lăn tập bụng theo hướng thẳng về phía trước với 1 khoảng cách nhất định theo khả năng của mình nhưng đảm bảo căng hết thân người. Tư thế khi đẩy con lăn tập bụng 4 bánh về phía trước sao cho lưng và đầu vẫn thẳng. Tay duỗi thẳng. Hít thở đều, tập hít thở từ bụng để có tác dụng lên vùng cơ bụng nhiều hơn\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003e\u003cstrong\u003eB3:\u003c/strong\u003e Tiếp theo bạn kéo con lăn về gần phía thân người của mình sao cho vuông góc với vai\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003e\u003cstrong\u003eB4:\u003c/strong\u003e Lặp lại động tác để tiếp tục bài tập, thực hiện khoảng 15 – 20 lần lặp.\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/a7/8e/87/f8f8da08345c1c1a25ed7a3bc1dbf634.png\" alt=\"Con Lăn Tập Bụng\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/33/99/59/a8db02daa1e5e3afa7c9ad4943dae32c.png\" alt=\"Con Lăn Tập Bụng\" width=\"750\" height=\"614\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/51/d5/e1/9dcd76e045a4b1c0324d75f23263cc94.png\" alt=\"Con Lăn Tập Bụng\" width=\"750\" height=\"586\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/31/e9/a9/82bfc6f29726c2dfef1b55b532506906.png\" alt=\"Con Lăn Tập Bụng\" width=\"750\" height=\"562\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cspan style=\"color: #0000ff;\"\u003e\u003cem\u003e\u003cstrong\u003eSử dụng hàng chính hãng để tránh mua phải hàng giả, hàng nhái, hàng kém chất lượng\u003c/strong\u003e\u003c/em\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/2e/e0/f9/346896a9d916c6e001988cf81367af9f.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/2e/e0/f9/346896a9d916c6e001988cf81367af9f.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/2e/e0/f9/346896a9d916c6e001988cf81367af9f.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2e/e0/f9/346896a9d916c6e001988cf81367af9f.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2e/e0/f9/346896a9d916c6e001988cf81367af9f.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/08/d8/61/317a4693604b4ff843fdb223d995afa7.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/08/d8/61/317a4693604b4ff843fdb223d995afa7.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/08/d8/61/317a4693604b4ff843fdb223d995afa7.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/08/d8/61/317a4693604b4ff843fdb223d995afa7.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/08/d8/61/317a4693604b4ff843fdb223d995afa7.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/71/b7/39/1a47e3e3b0d886e9ab8e27fda19bfdc4.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/71/b7/39/1a47e3e3b0d886e9ab8e27fda19bfdc4.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/71/b7/39/