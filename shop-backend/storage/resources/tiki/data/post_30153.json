on_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":7500,"discount_rate":5,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/e5/91/2c/2d6479c54fb8c6acb6fe4574037b39f3.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":478,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eCác bạn đang cầm trên tay cuốn truyện vô cùng hài hước, hấp dẫn và giàu trí tưởng tượng về các chú tí hon ở thành phố Hoa. Đó là Mít Đặc ham hiểu biết, nhưng lại lười suy nghĩ và thiếu kiên trì nên chẳng học được gì. Là Biết Tuốt thông minh, hiểu nhiều biết rộng, chín chắn. Và các chú Tròn Xoay, Ngộ Nhỡ, Mất Sạch, Cáu Kỉnh, nhạc sĩ Kèn Đồng, họa sĩ Thuốc Nước, mỗi người một tính cách, một vẻ đáng yêu riêng.\u003c/p\u003e\n\u003cp\u003eTheo cùng trang sách, các bạn sẽ có những chuyến phiêu lưu rất thú vị với các chú tí hon đi trên chín tầng mây, đến thành phố Xanh vô cùng tươi đẹp toàn… con gái, và thành phố Diều với những phát minh khoa học tiên tiến…\u003c/p\u003e\n\u003cp\u003eĐặc biệt, phần minh họa rất sinh động của họa sĩ Aleksey Laptev khiến cho cuộc phiêu lưu của Mít Đặc và các bạn càng thêm hấp dẫn.\u003c/p\u003e\n\u003cp\u003eNIKOLAY NOSOV (1908-1976)\u003c/p\u003e\n\u003cp\u003eÔng là nhà văn Nga nổi tiếng chuyên viết cho trẻ em, đã từng nhận được Giải thưởng Quốc gia. Các tác phẩm của ông được dịch ra nhiều thứ tiếng và được trẻ em nhiều nước trên thế giới vô cùng yêu thích.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/e5/91/2c/2d6479c54fb8c6acb6fe4574037b39f3.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e5/91/2c/2d6479c54fb8c6acb6fe4574037b39f3.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e5/91/2c/2d6479c54fb8c6acb6fe4574037b39f3.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e5/91/2c/2d6479c54fb8c6acb6fe4574037b39f3.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e5/91/2c/2d6479c54fb8c6acb6fe4574037b39f3.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/66/5b/b7/bcc5aa7d29eccbe268032905f68658f8.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/66/5b/b7/bcc5aa7d29eccbe268032905f68658f8.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/66/5b/b7/bcc5aa7d29eccbe268032905f68658f8.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/66/5b/b7/bcc5aa7d29eccbe268032905f68658f8.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/66/5b/b7/bcc5aa7d29eccbe268032905f68658f8.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/90/c6/99/35540d08fd72637425c8b30ec06b157a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/90/c6/99/35540d08fd72637425c8b30ec06b157a.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/90/c6/99/35540d08fd72637425c8b30ec06b157a.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/90/c6/99/35540d08fd72637425c8b30ec06b157a.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/90/