":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/b4/68/6b/7a439d5277ba2dc303dc6b8d2865a127.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":449,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eTHÔNG SỐ M650:\u003c/p\u003e\n\u003cp\u003e- Công nghệ SilentTouch giảm ồn\u003c/p\u003e\n\u003cp\u003e- Hình dáng nhỏ gọn có đường viền\u003c/p\u003e\n\u003cp\u003e- Điều khiển con trỏ nhạy, êm ái\u003c/p\u003e\n\u003cp\u003e- Nút bật/tắt nguồn\u003c/p\u003e\n\u003cp\u003e- 1 pin AA (Pin kiềm)\u003c/p\u003e\n\u003cp\u003e- Cao x Rộng x Dài: 37,8 x 61,8 x 107,19 mm\u003c/p\u003e\n\u003cp\u003e- Trọng lượng (kèm pin): 101,2 g\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eĐầu thu USB Logi Bolt\u003c/p\u003e\n\u003cp\u003e-Cao x Rộng x Dài: 14,4 x 18,7 x 6,1 mm, 1,8 g\u003c/p\u003e\n\u003cp\u003eĐầu thu USB: Logi Bolt\u003c/p\u003e\n\u003cp\u003eYêu cầu: Cổng USB có sẵn\u003c/p\u003e\n\u003cp\u003e•Windows 10, 11 trở lên\u003c/p\u003e\n\u003cp\u003e•macOS 10.10 trở lên\u003c/p\u003e\n\u003cp\u003e•Linux\u003c/p\u003e\n\u003cp\u003e•Chrome OS\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eCông nghệ Bluetooth không dây Tiết kiệm Năng lượng (Logo Bluetooth)\u003c/p\u003e\n\u003cp\u003eYêu cầu: Công nghệ Bluetooth không dây Tiết kiệm Năng lượng\u003c/p\u003e\n\u003cp\u003e•Windows 10, 11 trở lên\u003c/p\u003e\n\u003cp\u003e•macOS 10.15 trở lên\u003c/p\u003e\n\u003cp\u003e•Linux\u003c/p\u003e\n\u003cp\u003e•Chrome OS\u003c/p\u003e\n\u003cp\u003e•iPadOS 13.4 trở lên\u003c/p\u003e\n\u003cp\u003e•Android 8.0 trở lên\u003c/p\u003e\n\u003cp\u003eKHẢ NĂNG TƯƠNG THÍCH:\u003c/p\u003e\n\u003cp\u003eWindows, macOS, Linux, Chrome OS, iPadOS, Android\u003c/p\u003e\n\u003cp\u003eTHÔNG TIN BẢO HÀNH: Bảo hành phần cứng trong 1 năm\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://img.sp.mms.shopee.sg/vn-11134208-7qukw-lhhdvo9rjoht51\" width=\"1000\" height=\"1509\" alt=\"vn-11134208-7qukw-lhhdvo9rjoht51\" /\u003e\u003cimg src=\"https://img.sp.mms.shopee.sg/vn-11134208-7qukw-lhhdvo9rl329eb\" width=\"1000\" height=\"2000\" alt=\"vn-11134208-7qukw-lhhdvo9rl329eb\" /\u003e\u003cimg src=\"https://img.sp.mms.shopee.sg/vn-11134208-7qukw-lhhdvo9rmhmp41\" width=\"1000\" height=\"1675\" alt=\"vn-11134208-7qukw-lhhdvo9rmhmp41\" /\u003e\u003cimg src=\"https://img.sp.mms.shopee.sg/vn-11134208-7qukw-lhhdvo9rnw75af\" width=\"1000\" height=\"1700\" alt=\"vn-11134208-7qukw-lhhdvo9rnw75af\" /\u003e\u003cimg src=\"https://img.sp.mms.shopee.sg/vn-11134208-7qukw-lhhdvo9rparlbd\" width=\"1000\" height=\"1804\" alt=\"vn-11134208-7qukw-lhhdvo9rparlbd\" /\u003e\u003cimg src=\"https://img.sp.mms.shopee.sg/vn-11134208-7qukw-lhhgmahe09fl0f\" width=\"1000\" height=\"2000\" alt=\"vn-11134208-7qukw-lhhgmahe09fl0f\" /\u003e\u003c/p\u003e\n\u003cp\u003eĐặc điểm nổi bật:\u003c/p\u003e\n\u003cp\u003e•CUỘN THÔNG MINH HƠN – Cuộn chính xác đến từng dòng để xem tài liệu – và cuộn siêu nhanh cho những trang web dài. Chuyển đổi chế độ với một cú nhấp SmartWheel.\u003c/p\u003e\n\u003cp\u003e•VỪA VẶN HOÀN HẢO CHO ĐÔI TAY BẠN – Được thiết kế cho những đôi tay có kích cỡ từ nhỏ tới trung bình – đem đến độ vừa vặn đến hoàn hảo.\u003c/p\u003e\n\u003cp\u003e•VÔ CÙNG THOẢI MÁI – Làm việc thoải mái trong nhiều giờ với hình dáng uốn lượn, khu vực đặt ngón tay cái êm ái và viền bên bằng cao su giúp bạn giữ chắc chắn.\u003c/p\u003e\n\u003cp\u003e•KẾT NỐI THEO CÁCH BẠN MUỐN – Kết nối ngay lập tức thông qua Bluetooth Tiết kiệm Năng lượng hoặc đầu thu USB Logi Bolt.\u003c/p\u003e\n\u003cp\u003e•ÍT ỒN HƠN, TẬP TRUNG HƠN – Ít ồn từ cú nhấp hơn 90% với công nghệ SilentTouch.*\u003c/p\u003e\n\u003cp\u003e•CÁC NÚT BÊN CÓ THỂ TÙY CHỈNH – Tùy chỉnh các nút bên với Logitech Options+, khả dụng trên Windows và macOS, thành các lối tắt ưa thích của bạn – như quay lại/tiếp theo hoặc sao chép/dán.\u003c/p\u003e\n\u003cp\u003e•THỜI LƯỢNG PIN 24 THÁNG – Hoạt động lên tới hai năm trên một quả pin AA đi kèm với chuột của bạn.**\u003c/p\u003e\n\u003cp\u003e•TƯƠNG THÍCH TRÊN NHIỀU NỀN TẢNG – Tương thích liền mạch với các hệ điều hành Windows, macOS, Linux, Chrome OS, ipadOS, và Android.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eNâng cấp để cuộn thông minh hơn, thoải mái hơn và có hiệu suất cao hơn với Signature M650\u003c/p\u003e\n\u003cp\u003eCác tính năng linh hoạt của chuột bao gồm cuộn SmartWheel đem lại độ chính xác từng dòng và tự động chuyển sang chế độ lăn tự do siêu nhanh với cú lướt nhẹ của ngón tay. Với nhiều lựa chọn kích cỡ dành cho người có đôi tay nhỏ, hoặc form tay to hay người thuận tay trái có nghĩa là luôn có độ vừa vặn hoàn hảo cho bất kỳ ai. Khả năng kết nối không dây liền mạch, nút bên có thể tùy chỉnh và hình dáng thoải mái giúp bạn làm việc dễ chịu và hiệu quả trong nhiều giờ liền. Công nghệ SilentTouch của Logitech đem lại các cú nhấp yên tĩnh để giúp bạn tập trung - trong khi thời lượng pin 24 tháng** và tính tương thích phổ dụng trên nhiều hệ điều hành đảm bảo hiệu suất cao dễ dàng.\u003c/p\u003e\n\u003cp\u003e**Thời gian sử dụng pin có thể thay đổi tùy theo người dùng và điều kiện sử dụng máy tính\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tik