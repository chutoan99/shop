/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":136500,"discount_rate":30,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/10/4f/a6/0ae8956015f8486b29357654ef7e4f85.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1072,"all_time_quantity_sold":3,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cspan\u003eSữa rửa mặt ngăn ngừa lão hóa Naris Collagen Moisturizing Creamy Foam của Nhật - Áp dụng công nghệ Micro Emulsion phân tách phân tử về mức nhỏ nhất, giúp sản phẩm len lỏi sau vào lỗ chân lông, làm sạch kép và loại bỏ bụi bẩn một cách hiệu quả. \u003cbr /\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/d6/ca/57/9258f4c98ebccb8ad0420cfb39902ff7.jpg\" alt=\"\" width=\"501\" height=\"501\" /\u003e\u003cbr /\u003eƯu điểm vượt trội: \u003cbr /\u003e- Tích hợp 2 tính năng trong 1 sản phẩm: Sữa rửa mặt kiêm tẩy trang giúp tiết kiệm thời gian và chi phí khi sử dụng. \u003cbr /\u003e- Giúp làm sạch lớp trang điểm và kem chống nắng hiệu quả, làm sạch bụi bẩn, bã nhờn bít tắc sâu trong lỗ chân lông. \u003cbr /\u003e- Ngăn ngừa lượng dầu thừa bài tiết, ngừa mụn xuất hiện. Mang đến làn da sạch mịn và thông thoáng. \u003cbr /\u003e- Bổ sung 3 loại Collagen cho da, ngăn ngừa các dấu hiệu lão hóa và cung cấp độ ẩm để làn da luôn sáng khỏe, mềm mại và mịn màng. \u003cbr /\u003e\u003cbr /\u003eThành phần sản phẩm: \u003cbr /\u003e- Dâu tây: Kích thích tái tạo tế bào da, chống oxy hóa, hỗ trợ se nhỏ lỗ chân lông. \u003cbr /\u003e- Ceramide: Điều hòa lượng bài tiết, bổ sung độ ẩm cho da. \u003cbr /\u003e- Nho: Giảm nhăn, chống oxy hóa ,tia UV, làm sáng và sạch da. \u003cbr /\u003e- Cây kim sa: Êm dịu với da, an toàn không gây kích ứng, giúp phục hồi và dưỡng ẩm cho da. \u003cbr /\u003e\u003cbr /\u003eHướng dẫn sử dụng \u003cbr /\u003eLàm ướt da mặt, lấy từ 1-1,5cm sữa rửa mặt ra lòng bàn tay (hoặc lưới tạo bọt), cho 1 chút nước để tạo bọt kem bông mịn. Sau đó thoa bọt lên mặt và massage nhẹ nhàng để làm sạch da trong 1-2 phút. Rửa mặt lại với nước sạch và tiến hành các bước chăm sóc da tiếp theo. \u003cbr /\u003e\u003cbr /\u003eBảo quản: \u003cbr /\u003e- Nơi khô ráo, thoáng mát. \u003cbr /\u003e-Tránh ánh nắng trực tiếp, nơi có nhiệt độ cao hoặc ẩm ướt. \u003cbr /\u003e- Đậy nắp kín sau khi sử dụng \u003cbr /\u003e\u003cbr /\u003eDung tích: 100ml \u003cbr /\u003eThương hiệu: Naris Cosmetic \u003cbr /\u003eXuất xứ thương hiệu: Nhật Bản \u003cbr /\u003eKhuyến cáo: Sản phẩm không phải là thuốc, không có tác dụng thay thế thuốc chữa bệnh \u003cbr /\u003eHạn sử dụng: 5 năm kể từ ngày sản xuất \u003cbr /\u003e\u003cbr /\u003eRa đời từ năm 1932, Naris Cosmetics là một thương hiệu mỹ phẩm cao cấp Nhật Bản là bí quyết kì diệu để gìn giữ và duy trì làn da khỏe đẹp. Những sản phẩm của Naris đạt chứng nhận sản xuất theo quy trình công nghệ tiên tiến hàng đầu tại Nhật Bản, luôn nghiên cứu và phát triển sản phẩm sau mỗi năm để nâng cao hiệu quả sử dụng. \u003cbr /\u003eNgoài ra, Naris không bao giờ thử nghiệm trên động vật. Chúng tôi cũng thực hiện cam kết giảm thiểu cacbon và giảm sức ép rác thải ra trái đất. Các mỹ phẩm của Naris, 100% từ thiên nhiên, hoàn toàn không gây kích ứng da. \u003cbr /\u003e“For Others – Vì bạn” cũng chính là lời cam kết của Naris Cosmetics về chất lượng sản phẩm và dịch vụ\u003c/span\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/10/4f/a6/0ae8956015f8486b29357654ef7e4f85.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/10/4f/a6/0ae8956015f8486b29357654ef7e4f85.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/10/4f/a6/0ae8956015f8486b29357654ef7e4f85.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/10/4f/a6/0ae8956015f8486b29357654ef7e4f85.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/10/4f/a6/0ae8956015f8486b29357654ef7e4f85.png"},{"base_url":"https://salt.tikicdn.com/ts/product/d6/ca/57/9bb6d1da5226604e102ea58cb544586f.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d6/ca/57/9bb6d1da5226604e102ea58cb544586f.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d6/ca/57/9bb6d1da5226604e102ea58cb544586f.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d6/ca/57/9bb6d1da5226604e102ea58cb544586f.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d6/ca/57/9bb6d1da5226604e102ea58cb544586f.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/eb/1d/2f/af02ae5234c7581587aa7e1b8d959455.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/eb/1d/2f/af02ae5234c7581587aa7e1b8d959455.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/eb/1d/2f/af02ae5234c7581587aa7e1b8d959455.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/eb/1d/2f/af02ae5234c7581587aa7e1b8d959455.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200