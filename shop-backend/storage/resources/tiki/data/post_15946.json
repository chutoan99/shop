color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":94000,"discount_rate":3,"rating_average":4,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/8d/16/5f/1ee0f8aa555e92ae6b1e349133ac94e7.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":624,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003eNồi cơm điện tử 1 lít JBV-S10W thương hiệu Tiger của Nhật Bản, đảm bảo uy tín về chất lượng và mẫu mã\u003c/h3\u003e\n\u003cp\u003e có kiểu dáng nhỏ gọn, thiết kế quai xách giúp di chuyển nồi tiện lợi, không lo bị bật nắp nồi.\u003c/p\u003e\n\u003cp\u003e\u003c/p\u003e\n\u003ch3\u003e sở hữu tính năng Tacook 2 trong 1: vừa nấu cơm vừa hấp bánh bao, hấp cách thủy, nấu xôi,… cùng một lúc\u003c/h3\u003e\n\u003cp\u003eChức năng nấu đồng thời Tacook hỗ trợ bạn nấu nướng nhiều món ăn cùng lúc, cực kỳ tiện lợi và tiết kiệm thời gian.\u003c/p\u003e\n\u003cp\u003e\u003c/p\u003e\n\u003ch3\u003eCông suất 564W kết hợp công nghệ Fuzzy Logic cảm ứng nhiệt thông minh, giúp điều chỉnh nhiệt độ và thời gian nấu thích hợp\u003c/h3\u003e\n\u003cp\u003eNhờ công nghệ nấu hiện đại này, nồi sẽ tự động điều chỉnh nhiệt độ và thời gian nấu thích hợp, cho ra hạt cơm chín đều, thơm ngon tròn vị.\u003c/p\u003e\n\u003cp\u003e\u003c/p\u003e\n\u003ch3\u003e sở hữu 9 chức năng cài đặt sẵn, mang lại menu đa dạng, dễ lựa chọn\u003c/h3\u003e\n\u003cp\u003eCác chức năng gồm:  (Plain), chế độ nấu đồng thời (Synchro-Cooking), nấu nhanh (Quick), nấu cơm trộn hoặc xôi (Sweet-Mixed), nấu cháo (Porridge), ngũ cốc (Multigrain), nấu gạo lứt (Brown), nấu chậm hoặc hấp (Slow Cook - Steam) và giữ ấm (Keep Warm).\u003c/p\u003e\n\u003cp\u003eCác chế độ nấu giúp bạn chế biến được nhiều món ăn đa dạng chỉ với thao tác đơn giản, tiết kiệm thời gian, đáp ứng nhu cầu khẩu vị của mọi thành viên trong gia đình.\u003c/p\u003e\n\u003cp\u003e\u003c/p\u003e\n\u003ch3\u003eLòng nồi làm từ hợp kim nhôm phủ chống dính tia hồng ngoại, gia nhiệt tốt giúp cơm chín đều, không dính cháy\u003c/h3\u003e\n\u003cp\u003eLòng nồi dày 2.028 mm, bền bỉ, giúp hạn chế cháy dính cơm, đảm bảo an toàn sức khỏe và .\u003c/p\u003e\n\u003cp\u003eXem thêm: .\u003c/p\u003e\n\u003cp\u003e\u003c/p\u003e\n\u003ch3\u003eBảng điều khiển nút nhấn có màn hình hiển thị, dễ quan sát và điều chỉnh chức năng \u003c/h3\u003e\n\u003cp\u003eNồi có tính năng hẹn giờ, hỗ trợ bạn nấu nướng linh hoạt thời gian.\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cstrong\u003eLưu ý:\u003c/strong\u003e\u003c/em\u003e Hãng khuyến cáo không hẹn giờ và giữ ấm cơm quá 12 tiếng (tùy chất lượng gạo, khí hậu,) để giữ được độ mềm ngon của cơm.\u003c/p\u003e\n\u003cp\u003e\u003c/p\u003e\n\u003ch3\u003e nấu được 5 - 8 cốc gạo đi kèm nồi, phục vụ khẩu phần ăn cho gia đình 2 - 4 thành viên.\u003c/h3\u003e\n\u003cp\u003e\u003c/p\u003e\n\u003ch3\u003eNồi có chức năng hẹn giờ giúp bạn chủ động trong việc nấu ăn, kiểm soát thời gian nấu nướng dễ dàng hơn\u003c/h3\u003e\n\u003cp\u003eXem thêm: \u003c/p\u003e\n\u003cp\u003e\u003c/p\u003e\n\u003ch3\u003eDây điện có thể tháo rời, giúp bạn tiện bảo quản, cất giữ và di chuyển nồi\u003c/h3\u003e\n\u003ch3\u003e\u003c/h3\u003e\n\u003ch3\u003ePhụ kiện đi kèm gồm: vá múc cơm, cốc đong gạo và khay hấp hỗ trợ hấp bánh bao, rau củ, giúp người dùng nấu nướng tiện lợi hơn\u003c/h3\u003e\n\u003cp\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eLưu ý sử dụng nồi cơm điện tử Tiger bền tốt:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Chỉ sử dụng đĩa nấu được hãng cung cấp cùng với nồi cơm.\u003c/p\u003e\n\u003cp\u003e- Không ngâm nồi trong nước, hoặc đổ nước lên nồi.\u003c/p\u003e\n\u003cp\u003e- Không dịch chuyển nồi cơm điện trong khi đang nấu.\u003c/p\u003e\n\u003cp\u003e- Chờ đến khi thiết bị đã nguội hẳn trước khi tiến hành vệ sinh, tránh bị bỏng bởi các bề mặt nóng.\u003c/p\u003e\n\u003cp\u003e với thiết kế nhỏ gọn, khả năng nấu cơm nhanh và ngon, hỗ trợ chế biến nhiều món ăn đa dạng cho bữa cơm gia đình, là sản phẩm gia dụng xứng đáng có mặt trong gian bếp mọi nhà.  \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/8d/16/5f/1ee0f8aa555e92ae6b1e349133ac94e7.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/8d/16/5f/1ee0f8aa555e92ae6b1e349133ac94e7.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/8d/16/5f/1ee0f8aa555e92ae6b1e349133ac94e7.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8d/16/5f/1ee0f8aa555e92ae6b1e349133ac94e7.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8d/16/5f/1ee0f8aa555e92ae6b1e349133ac94e7.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/42/46/0f/8458753a58f988237639ade8c588d80a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/42/46/0f/8458753a58f988237639ade8c588d80a.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/42/46/0f/8458753a58f988237639ade8c588d80a.jpg"