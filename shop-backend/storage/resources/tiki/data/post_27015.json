hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.6,"review_count":18,"review_text":"(18)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/7e/a2/53/7b05c329768ed6caf63434fe25ceb685.jpeg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1087,"all_time_quantity_sold":46,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eSản phẩm giao màu ngẫu nhiên Thiết kế nhỏ gọn, hoa văn tinh tế Dung tích lòng nồi 1.1L Phù hợp với gia đình 3 - 4 người Hoạt động mạnh mẽ với công suất 485W Giữ nhiệt đến 5 giờ\u003ciframe src=\"//www.youtube.com/embed/R05ilFpj_Xc\" width=\"560\" height=\"314\" allowfullscreen=\"allowfullscreen\"\u003e\u003c/iframe\u003e\u003c/p\u003e\n\u003ch5 style=\"text-align: justify;\"\u003e\u003cstrong\u003eThiết kế nắp rời, tiện dụng\u003c/strong\u003e\u003c/h5\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eNồi Cơm Điện Nắp Rời Sharp KSH-D11 (1.1L)\u003c/strong\u003e có thiết kế nhỏ gọn, dễ dàng di chuyển và bố trí trong gian bếp, không chiếm nhiều diện tích. Kiểu nồi cơm nắp rời giúp bạn dễ dàng vệ sinh và dễ theo dõi quá trình nấu cơm.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003eTay cầm hai bên bằng vật liệu Phenolic, loại nhựa cách nhiệt cao cấp, được trang bị để bạn di chuyển nồi dễ dàng mà không lo bị bỏng. Dây điện có thể tháo rời, dễ dàng di chuyển và bảo quản mà không lo vướng víu.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/3b/27/0e/8324b1dfdf5d78963004a2ae90f19232.jpeg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch5 style=\"text-align: justify;\"\u003e\u003cstrong\u003eDung tích nồi 1.1L\u003c/strong\u003e\u003c/h5\u003e\n\u003cp style=\"text-align: justify;\"\u003eSản phẩm có dung tích 1.1L nấu được 0.2 - 0.8kg gạo cho từ 2-4 người ăn, phù hợp với những ai đang độc thân và những gia đình ít người.\u003c/p\u003e\n\u003ch5 style=\"text-align: justify;\"\u003eHiệu suất nấu chín cơm cao\u003c/h5\u003e\n\u003cp style=\"text-align: justify;\"\u003eCông suất 485W giúp nấu cơm nhanh và tiết kiệm điện năng. Nồi có một mâm nhiệt, tiết diện lớn truyền nhiệt đều giúp nấu cơm không bị nhão.\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/6b/4d/c6/6daa0fa4524aefa97ae9b238d5801085.jpeg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003eBên cạnh đó, lòng nồi được làm bằng nhôm cao cấp chắc chắn và bền vững, truyền nhiệt tốt nấu cơm nhanh, giữ nhiệt lâu cho chất lượng cơm thơm ngon. Nắp làm bằng thép không gỉ cho độ bền cao.\u003c/p\u003e\n\u003ch5 style=\"text-align: justify;\"\u003eGiữ nóng đến 5 giờ\u003c/h5\u003e\n\u003cp style=\"text-align: justify;\"\u003eSản phẩm có thiết kế nồi kín và khả năng giữ nóng lâu đến 5 giờ giúp cơm luôn ấm nóng trong thời gian dài. Trên thân nồi có nút gạt qua chế độ \"Cook\" và \"Warm\", dễ dàng thao tác.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003eKhi cơm được nấu chín, hệ thống sẽ tự động chuyển qua chế độ giữ ấm để giữ cho cơm luôn được nóng và thơm ngon.\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/0f/82/7f/df21178e61d1f106d3f8968a088580b5.jpeg\" alt=\"\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Tuy nhiên tuỳ vào từng loại sản phẩm hoặc phương thức, địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, .....\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/7e/a2/53/7b05c329768ed6caf63434fe25ceb685.jpeg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/7e/a2/53/7b05c329768ed6caf63434fe25ceb685.jpeg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/7e/a2/53/7b05c329768ed6caf63434fe25ceb685.jpeg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7e/a2/53/7b05c329768ed6caf63434fe25ceb685.jpeg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7e/a2/53/7b05c329768ed6caf63434fe25ceb685.jpeg"},{"base_url":"https://salt.tikicdn.com/ts/product/52/67/02/7ac1719980ab1af6b2d284bbb7caa1e0.jpeg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/52/67/02/7ac1719980ab1af6b2d284bbb7caa1e0.jpeg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/52/67/02/7ac1719980ab1af6b2d284bbb7caa1e0.jpeg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/52/67/02/7ac1719980ab1af6b2d284bbb7caa1e0.jpeg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/52/67/02/7ac1719980ab1af6b2d284bbb7caa1e0.jpeg"},{"base_url":"https://salt.tikicdn.com/ts/product/6d/e3/56/790af5d54bd740cda144fdddfbbda90c.jpeg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/6d/e3/56/790af5d54bd740cda144fdddfbbda90c.jpeg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/6d/e3/56/790af5d54bd740cda144fdddfbbda90c.jpeg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6d/e3/56/790af5d54bd740cda144fdddfbbda90c.jpeg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6d/e3/56/790af5d54bd740cda144fdddfbbda90c.jpeg"},{"base_url":"https://salt.tikicdn.com/ts/product/01/d3/43/d651194a7d8efc11f1186bcb02643af5.j