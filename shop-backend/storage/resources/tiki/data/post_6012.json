c/strong\u003e\u003cstrong\u003eữ\u003c/strong\u003e\u003cstrong\u003eng v\u003c/strong\u003e\u003cstrong\u003eấ\u003c/strong\u003e\u003cstrong\u003en \u003c/strong\u003e\u003cstrong\u003eđề\u003c/strong\u003e\u003cstrong\u003e c\u003c/strong\u003e\u003cstrong\u003eầ\u003c/strong\u003e\u003cstrong\u003en l\u003c/strong\u003e\u003cstrong\u003eư\u003c/strong\u003e\u003cstrong\u003eu \u003c/strong\u003e\u003cstrong\u003eý\u003c/strong\u003e\u003cstrong\u003e khi s\u003c/strong\u003e\u003cstrong\u003eử\u003c/strong\u003e\u003cstrong\u003e d\u003c/strong\u003e\u003cstrong\u003eụ\u003c/strong\u003e\u003cstrong\u003eng G.el bôi tr.\u003c/strong\u003e\u003cstrong\u003eơ\u003c/strong\u003e\u003cstrong\u003en .\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/9e/c7/4a/40a49a8df137432071974131a7030697.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e1 Thành ph\u003c/strong\u003e\u003cstrong\u003eầ\u003c/strong\u003e\u003cstrong\u003en\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eThành phần:\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eGel Durex Play Intimate Lube 50ml\u003c/strong\u003e gồm các thành phần là:\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003ePropylene Glycol\u003c/li\u003e\n\u003cli\u003eNước tinh khiết\u003c/li\u003e\n\u003cli\u003eBenzoic Acid\u003c/li\u003e\n\u003cli\u003eHydroxyenthylcellulose\u003c/li\u003e\n\u003cli\u003eSodium Hydroxide.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eDạng bào chế: Sản phẩm được bào chế dạng gel dùng ngoài da.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e2 Tác d\u003c/strong\u003e\u003cstrong\u003eụ\u003c/strong\u003e\u003cstrong\u003eng - Ch\u003c/strong\u003e\u003cstrong\u003eỉ\u003c/strong\u003e \u003cstrong\u003eđị\u003c/strong\u003e\u003cstrong\u003enh c\u003c/strong\u003e\u003cstrong\u003eủ\u003c/strong\u003e\u003cstrong\u003ea\u003c/strong\u003e\u003cstrong\u003e \u003c/strong\u003e\u003cstrong\u003eDurex Play Intimate Lube 50ml\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e2.1 Tác d\u003c/strong\u003e\u003cstrong\u003eụ\u003c/strong\u003e\u003cstrong\u003eng c\u003c/strong\u003e\u003cstrong\u003eủ\u003c/strong\u003e\u003cstrong\u003ea Durex Play Intimate Lube 50ml\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eNhu cầu si.nh lý là một trong những nhu cầu cơ bản của con người. Việc QH tì.nh d.ục cũng đóng một vai trò quan trọng trong đời sống tinh thần của mỗi người, đây cũng là một trong những yếu tố giúp duy trì hạnh phúc của các cặp vợ chồng. Chính vì lý do đó, các sản phẩm hỗ trợ cho nhu cầu sinh lý luôn được mọi người quan tâm và sử dụng.\u003c/p\u003e\n\u003cp\u003eGel bôi trơn Durex Play Intimate Lube 50ml là một gel bôi trơn có nguồn gốc từ nước tinh khiết có tác dụng giữ ẩm, tăng độ nhờn nhưng không gây cảm giác trơn dính, mỡ. Từ đó tạo cảm giác nhẹ nhàng, êm ái, mịn màng, tăng kh.oái cảm cho quá trình qu.an hệ tìn.h .\u003c/p\u003e\n\u003cp\u003eĐặc biệt, sản phẩm còn có thành phần được chiết xuất từ cây nha đam nên mang lại cảm giác mát, dịu nhẹ, không gây ra các kích ứng da nên đặc biệt rất an toàn cho người sử dụng.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e2.2 Ch\u003c/strong\u003e\u003cstrong\u003eỉ\u003c/strong\u003e \u003cstrong\u003eđị\u003c/strong\u003e\u003cstrong\u003enh c\u003c/strong\u003e\u003cstrong\u003eủ\u003c/strong\u003e\u003cstrong\u003ea Durex Play Intimate Lube 50ml\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eĐối tượng sử dụng là những người muốn cảm xúc thăng hoa và giúp việc qu.an hệ tì.nh d.ục dễ dàng hơn.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e3 Cách dùng c\u003c/strong\u003e\u003cstrong\u003eủ\u003c/strong\u003e\u003cstrong\u003ea\u003c/strong\u003e\u003cstrong\u003e \u003c/strong\u003e\u003cstrong\u003eDurex Play Intimate Lube 50ml\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eGel bôi tr\u003c/strong\u003e\u003cstrong\u003eơ\u003c/strong\u003e\u003cstrong\u003en Durex Play Intimate Lube 50ml\u003c/strong\u003e được sử dụng để bôi ngoài da. Trước khi sử dụng, hãy vệ sinh thật sạch dư.ơ.ng v.ật, lắc đều lọ gel và bôi trực tiếp lên dư.ơ.ng v.ật hoặc bôi lên bên ngoài bao cao su (nếu sử dụng bao) sau đó xoa đều. Bôi lượng vừa đủ hoặc tùy theo nhu cầu của mỗi người.\u003c/p\u003e\n\u003cp\u003eSản phẩm được sử dụng để bôi trước khi quan hệ tì.nh d.ục. Sau khi QH hãy vệ sinh thật sạch bộ phận sinh d.ục bằng nước sạch hoặc xà phòng.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e4 Ch\u003c/strong\u003e\u003cstrong\u003eố\u003c/strong\u003e\u003cstrong\u003eng ch\u003c/strong\u003e\u003cstrong\u003eỉ\u003c/strong\u003e \u003cstrong\u003eđị\u003c/strong\u003e\u003cstrong\u003enh\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eKhông sử dụng sản phẩm cho những người dị ứng với bất kì thành phần nào có trong sản phẩm.\u003c/p\u003e\n\u003cp\u003eKhông sử dụng sản phẩm để uống hay bôi lên vùng da tổn thương.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e5 Tác d\u003c/strong\u003e\u003cstrong\u003eụ\u003c/strong\u003e\u003cstrong\u003eng ph\u003c/strong\u003e\u003cstrong\u003eụ\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eSản phẩm là một loại gel cơ bản với nguồn gốc là nước tinh khiết và các thành phần lành tính nên hầu như không gây ra các tác dụng không mong muốn nào.\u003c/p\u003e\n\u003cp\u003eNếu gặp các kích ứng trong quá trình sử dụng Gel Durex Play Intimate Lube 50ml hãy ngừng sử dụng sản phẩm ngay và rửa thật sạch vùng da vừa bôi.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e6 L\u003c/strong\u003e\u003cstrong\u003eư\u003c/strong\u003e\u003cstrong\u003eu \u003c/strong\u003e\u003cstrong\u003eý\u003c/strong\u003e\u003cstrong\u003e khi s\u003c/strong\u003e\u003cstrong\u003eử\u003c/strong\u003e\u003cstrong\u003e d\u003c/strong\u003e\u003cstrong\u003eụ\u003c/strong\u003e\u003cstrong\u003eng v\u003c/strong\u003e\u003cstrong\u003eà\u003c/strong\u003e\u003cstrong\u003e b\u003c/strong\u003e\u003cstrong\u003eả\u003c/strong\u003e\u003cstrong\u003eo qu\u003c/strong\u003e\u003cstrong\u003eả\u003c/strong\u003e\u003cstrong\u003en\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e6.1 L\u003c/strong\u003e\u003cstrong\u003eư\u003c/strong\u003e\u003cstrong\u003eu \u003c/strong\u003e\u003cstrong\u003eý\u003c/strong\u003e\u003cstrong\u003e khi s\u003c/strong\u003e\u003cstrong\u003eử\u003c/strong\u003e\u003cstrong\u003e d\u003c/strong\u003e\u003cstrong\u003eụ\u003c/strong\u003e\u003cstrong\u003eng\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eSản phẩm chỉ được dùng để bôi ngoài da, không được uống.\u003c/p\u003e\n\u003cp\u003eKhông bôi sản phẩm vào các vùng da nhạy cảm hoặc những vùng da bị tổn thương.\u003c/p\u003e\n\u003cp\u003eSản phẩm cũng có thể được bôi vào â.m đ.ạo. Bạn lấy một lượng vừa đủ ra đầu ngón tay, sau đó bôi vào â.m đ.ạ;o từ ngoài vào trong.\u003c/p\u003e\n\u003cp\u003eSản phẩm chỉ được sử dụng trong vòng 3 tháng kể từ ngày mở nắp. Sau 3 tháng, kể cả còn hạn sử dụng, cũng không nên tiếp tục sử dụng sản phẩm.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e6.2 L\u003c/strong\u003e\u003cstrong\u003eư\u003c/strong\u003e\u003cstrong\u003eu \u003c/strong\u003e\u003cstrong\u003eý\u003c/strong\u003e\u003cstrong\u003e khi d\u003c/strong\u003e\u003cstrong\u003eù\u003c/strong\u003e\u003cstrong\u003eng cho ph\u003c/strong\u003e\u003cstrong\u003eụ\u003c/strong\u003e\u003cstrong\u003e n\u003c/strong\u003e\u003cstrong\u003eữ\u003c/strong\u003e\u003cstrong\u003e c\u003c/strong\u003e\u003cstrong\u003eó\u003c/strong\u003e\u003cstrong\u003e thai v\u003c/strong\u003e\u003cstrong\u003eà\u003c/strong\u003e\u003cstrong\u003e cho con b\u003c/strong\u003e\u003cstrong\u003eú\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eSản phẩm được chứng minh an toàn với phụ nữ cho con bú.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e6.3 B\u003c/strong\u003e\u003cstrong\u003eả\u003c/strong\u003e\u003cstrong\u003eo qu\u003c/strong\u003e\u003cstrong\u003eả\u003c/strong\u003e\u003cstrong\u003en\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eDurex Play Intimate Lube 50ml được bảo quản ở nhiệt độ khô ráo, thoáng mát. Tránh để sản phẩm ở nơi tiếp xúc trực tiếp với ánh nắng.\u003c/p\u003e\n\u003cp\u003eĐậy kín nắp sau khi sử dụng và để xa tầm với của trẻ.\u003c/p\u003e\n\u003cp\u003eTránh để trẻ nuốt hoặc đùa nghịch với sản phẩm.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e7 Nhà s\u003c/strong\u003e\u003cstrong\u003eả\u003c/strong\u003e\u003cstrong\u003en xu\u003c/strong\u003e\u003cstrong\u003eấ\u003c/strong\u003e\u003cstrong\u003et\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eNhà sản xuất: sản phẩm được sản xuất bởi hãng Durex.\u003c/p\u003e\n\u003cp\u003eĐóng gói: Mỗi hộp sản phẩm gồm 1 chai có dung tích 50ml.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/9e/c7/4a/7d0166b4b0825bc12a8f495021d100c0.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/9e/c7/4a/7d0166b4b0825bc12a8f495021d100c0.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/9e/c7/4a/7d0166b4b0825bc12a8f495021d100c0.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9e/c7/4a/7d0166b4b0825bc12a8f495021d100c0.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9e/c7/4a/7d0166b4b0825bc12a8f495021d100c0.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/78/de/48/a0f3022e96b20cb16863f4cb1e45dd74.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/78/de/48/a0f3022e96b20cb16863f4cb1e45dd74.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/78/de/48/a0f3022e96b20cb16863f4cb