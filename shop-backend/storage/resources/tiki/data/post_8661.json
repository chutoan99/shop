t_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":544000,"discount_rate":48,"rating_average":4.8,"review_count":8,"review_text":"(8)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/9b/6e/93/7000cce6214824365dfe80c9ffe0683b.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":537,"all_time_quantity_sold":61,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eBỘ 2 VỢT CẦU LÔNG CHÍNH HÃNG AGNITE HÀNG CAO CẤP - TẶNG KÈM QUẤN VỢT VÀ HỘP 12 CẦU - MÃ F2126\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134202-7qukw-lepav2ot6caa84\" alt=\"vn-11134202-7qukw-lepav2ot6caa84\" /\u003e\u003c/p\u003e\n\u003cp\u003e THÔNG SỐ KỸ THUẬT\u003c/p\u003e\n\u003cp\u003eSố lượng vợt: 2 chiếc\u003c/p\u003e\n\u003cp\u003eCó tặng 01 túi đựng kèm vợt + 01 hộp cầu 12 QUẢ + 2 dây quấn cán vợt.\u003c/p\u003e\n\u003cp\u003eVợt đã được căng dây sẵn theo nhà sản xuất, sức căng như trên thông số của vợt.\u003c/p\u003e\n\u003cp\u003eMàu sắc: tím + xanh.\u003c/p\u003e\n\u003cp\u003eTrọng lượng vợt: 90 ± 5g.\u003c/p\u003e\n\u003cp\u003eLực căng dây: 18-20LB.\u003c/p\u003e\n\u003cp\u003eKích thước vợt: 664*222mm.\u003c/p\u003e\n\u003cp\u003eChất liệu khung: hợp kim carbon cao cấp.\u003c/p\u003e\n\u003cp\u003eTay cầm bằng da PU + gỗ paulownia.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134202-7qukw-lepaw1dedrxu9b\" alt=\"vn-11134202-7qukw-lepaw1dedrxu9b\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134202-7qukw-lepaw166ockz9f\" alt=\"vn-11134202-7qukw-lepaw166ockz9f\" /\u003eXuất xứ: Tập đoàn Deli - Trung Quốc\u003c/p\u003e\n\u003cp\u003eLưu ý: * Dữ liệu đo có thể có sai số, vui lòng tham khảo sản phẩm thực tế\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e 7 ĐIỂM MẠNH CỦA VỢT CẦU LÔNG AGNITE\u003c/p\u003e\n\u003cp\u003e1. Thiết kế khung vuông phẳng, đàn hồi tốt\u003c/p\u003e\n\u003cp\u003e2. Lỗ dây đơn (Làm sâu phần rãnh vợt, bảo vệ và kéo dài tuổi thọ của vợt)\u003c/p\u003e\n\u003cp\u003e3. Tay cầm chắc chắn, thoải mái (Làm từ da tay cầm PVC chống trượt, giúp cầm nắm và kiểm soát tốt hơn)\u003c/p\u003e\n\u003cp\u003e4. Nắp hỗ trợ kiểm soát (Nắp hình nón rộng, tăng tính linh hoạt trong việc điều khiển vợt)\u003c/p\u003e\n\u003cp\u003e5. Thiết kế khớp chữ T (Tăng sự ổn định cho vợt và kiểm soát chính xác)\u003c/p\u003e\n\u003cp\u003e6. Thiết kế dây nylon (Độ căng dây: 16-22LB)\u003c/p\u003e\n\u003cp\u003e7. Hệ thống giảm chấn chống sốc (Giảm biên độ biến dạng, giảm tần số rung, giảm thiểu tác động lên tay\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e CÔNG NGHỆ DÒNG VỢT CẦU LÔNG CHÍNH HÃNG AGNITE\u003c/p\u003e\n\u003cp\u003e- Công nghệ Titan Aerodynamic: thân vợt được phủ Titan giúp vợt được trợ lực tốt hơn và mạnh hơn.\u003c/p\u003e\n\u003cp\u003e- Công nghệ Isodynamic: khung vợt được thiết kế theo công nghệ IsoDynamic giúp diện tích điểm ngọt của khung vợt rộng hơn từ đó đường cầu sẽ thoát hơn và nẩy mạnh hơn.\u003c/p\u003e\n\u003cp\u003e- Thân vợt và khung vợt sử dụng High Modulus Carbon\u003c/p\u003e\n\u003cp\u003e- Carbon cường độ cao là loại carbon ứng suất cao chuyên dụng được Agnite dệt tấm từ những cuộn sợi carbon nguyên chất để tạo ra dòng vợt carbon truyền tải động năng của người chơi mạnh mẽ\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------\u003c/p\u003e\n\u003cp\u003eAGNITE - LÀN GIÓ MỚI CHO DÒNG SẢN PHẨM THỂ THAO CHUYÊN DỤNG !\u003c/p\u003e\n\u003cp\u003e Agnite là một thương hiệu hoàn toàn mới được xây dựng bởi Tập đoàn Dynamic Group Co., Ltd. vào tháng 4 năm 2017 cùng với đội ngũ thiết kế hàng đầu của Đức và được điều hành bởi Ningbo Agnite Sports Limited.\u003c/p\u003e\n\u003cp\u003e Với hơn 70 chi nhánh trên toàn thế giới, 1.000 nhân viên bán hàng, và gần 10.000 điểm bán, chúng tôi mong muốn cung cấp dịch vụ thuận tiện nhất cho người tiêu dùng.\u003c/p\u003e\n\u003cp\u003e Sứ mệnh của Agnite:\u003c/p\u003e\n\u003cp\u003eChúng tôi ủng hộ một cách tiến hóa \"di chuyển\". Agnite giúp mọi người thoát khỏi vùng thoải mái tầm thường, theo đuổi bản thân tốt hơn, và tận hưởng niềm vui thể thao. Đó là quá trình thúc đẩy con người trở nên tốt hơn thông qua tập luyện thể dục.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e#vợt_cầu_lông #vợt_cầu_lông_yonex #vợt_cầu_lông_cho_nữ #vợt_cầu_lông_lining #vợt_cầu_lông_chính_hãng #vợt_cầu_lông_victor #vợt_cầu_lông_trẻ_em #vợt_cầu_lông_adidas #vợt_cầu_lông_alp #vợt_cầu_lông_astrox_77 #vợt_cầu_lông_giá_rẻ #vợt_cầu_lông_giá_rẻ_chất_lượng #vợt_cầu_lông_guang_yu #vợt_cầu_lông_guangyu_4u\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/9b/6e/93/7000cce6214824365dfe80c9ffe0683b.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/9b/6e/93/7000cce6214824365dfe80c9ffe0683b.png","mediu