de":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":6,"review_text":"(6)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/7c/11/98/6cff80d52dc767db11537d623f2e2a11.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":344,"all_time_quantity_sold":29,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2 style=\"text-align:center\"\u003e\u003cstrong\u003eLoa Bluetooth V5.3 Wireless EDIFIER MP85 | Thời lượng pin 8H | Edifier Connect App\u003c/strong\u003e\u003c/h2\u003e\n\u003cul\u003e\u003cli class=\"font-size-14\"\u003eThời gian chơi nhạc lâu dài với pin tích hợp 480mAh\u003c/li\u003e\u003cli class=\"font-size-14\"\u003eNặng khoảng 70g có dây buộc\u003c/li\u003e\u003cli class=\"font-size-14\"\u003eThưởng thức âm nhạc chất lượng với trình điều khiển 40mm\u003c/li\u003e\u003cli class=\"font-size-14\"\u003eBluetooth v5.3\u003c/li\u003e\u003cli class=\"font-size-14\"\u003eVận hành dễ dàng bằng bảng điều khiển ĐẦY ĐỦ Ứng dụng kết nối Edifier được hỗ trợ với cài đặt EQ\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ef/4c/c6/147454c7c50e834305ba17955dcdcba8.png\" alt=\"\" width=\"750\" height=\"412\" /\u003e\u003c/p\u003e\n\u003cp class=\"product-detail-title font-size-32 font-bold\"\u003e\u003cstrong\u003eThời gian chơi dài\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"product-detail-desc font-size-16\"\u003eMP85 được tích hợp pin lithium-ion polymer có thời lượng pin dài và có thể phát nhạc liên tục trong 8 giờ.\u003c/p\u003e\n\u003cp class=\"product-detail-desc font-size-16\"\u003e \u003c/p\u003e\n\u003cp class=\"product-detail-desc font-size-16\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ef/b0/89/de33cfaf4370affa5f7468b08f069b5a.png\" alt=\"\" width=\"750\" height=\"412\" /\u003e\u003c/p\u003e\n\u003cp class=\"product-detail-title font-size-32 font-bold\"\u003e\u003cstrong\u003eỨng dụng kết nối Edifier\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"product-detail-desc font-size-16\"\u003eTrong ứng dụng, bạn có thể chọn bốn hiệu ứng âm thanh: Âm nhạc, Trò chơi, Giọng hát và Tự làm. Bạn cũng có thể thưởng thức âm thanh êm dịu thông qua ứng dụng.\u003c/p\u003e\n\u003cp class=\"product-detail-desc font-size-16\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/30/29/fb/d45c65e588d8cff821e51ca4fec4eafc.png\" alt=\"\" width=\"750\" height=\"412\" /\u003e\u003c/p\u003e\n\u003cp class=\"sub-title font-size-32\"\u003e\u003cstrong\u003eNhỏ nhưng đầy đủ\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"sub-desc font-size-16\"\u003eMP85 được trang bị driver toàn dải 1,5 inch (40mm) với tổng công suất đầu ra là 2,2w (RMS), được tinh chỉnh đặc biệt cho giọng hát để giúp giọng nói trong trẻo hơn.\u003c/p\u003e\n\u003cp class=\"sub-desc font-size-16\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/75/8e/69/b6a76bf5769311ce9fbf6d652c0cb415.png\" alt=\"\" width=\"750\" height=\"540\" /\u003e\u003c/p\u003e\n\u003cp class=\"sub-title font-size-32\"\u003e\u003cstrong\u003eNhẹ nhàng và sang trọng\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"sub-desc font-size-16\"\u003eThiết kế sản phẩm tuyệt vời, kích thước nhỏ tinh tế, âm thanh chất lượng tốt, trải nghiệm sử dụng thoải mái. Chơi và vận hành tất cả các chức năng bằng một tay, cho phép người dùng không tốn nhiều công sức.\u003c/p\u003e\n\u003cp class=\"sub-desc font-size-16\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/77/07/9d/4c193f0b62fcd8aa891e6a92967b9ac1.png\" alt=\"\" width=\"750\" height=\"540\" /\u003e\u003c/p\u003e\n\u003cp class=\"sub-title font-size-32\"\u003e\u003cstrong\u003eTruyền phát Bluetooth không dây\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"sub-desc font-size-16\"\u003eBluetooth V5.3 có độ phân giải mạnh, đường truyền ổn định, tiêu thụ điện năng thấp và mục đích sử dụng rộng rãi, mang lại trải nghiệm âm thanh chất lượng cao.\u003c/p\u003e\n\u003cp class=\"sub-desc font-size-16\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/77/4e/f0/38ea34a160e7b6999e7b410bfc3fec58.png\" alt=\"\" width=\"750\" height=\"540\" /\u003e\u003c/p\u003e\n\u003cp class=\"sub-title font-size-32\"\u003e\u003cstrong\u003eKiểm soát dễ dàng\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"sub-desc font-size-16\"\u003eVới các nút ở trên cùng \u0026amp; Ứng dụng Edifier Connect, bạn dễ dàng vận hành sản phẩm và tận hưởng đầy đủ các chức năng.\u003c/p\u003e\n\u003cp class=\"sub-desc font-size-16\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/04/ae/97/f4a3146a14f4ae1128cbbd8400a0d910.png\" alt=\"\" width=\"750\" height=\"540\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/27/9e/47/6a01102812fcf892de74be8cbf86dbaa.jpg\" alt=\"\" width=\"750\" height=\"781\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/7d/e9/eb/f84ece853ea0ac8f0b6994ee874e749a.png\" alt=\"\" width=\"750\" height=\"1386\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/e7/b2/e3/8a44cf37790cfb88017ed352974b299c.png\" alt=\"\" width=\"750\" height=\"1386\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/28/d7/4d/54fb10bce43e15e7a29aa0a195a5c278.png\" alt=\"\" width=\"750\" height=\"1386\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/bb/19/7b/73f587ec2ea824eb82a710ea1ffef323.png\" alt=\"\" width=\"750\" height=\"1386\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/88/e5/58/fca6e544c2489341427cf0fcd40a53be.png\" alt=\"\" width=\"750\" height=\"1022\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/7c/11/98/6cff80d52dc767db11537d623f2e2a11.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/7c/11/98/6cff80d52dc767db11537d623f2e2a11.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/7c/11/98/6cff80d52dc767db11537d623f2e2a11.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7c/11/98/6cff80d52dc767db11537d623f2e2a11.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7c/11/98/6cff80d52dc767db11537d623f2e2a11.png"},{"base_url":"https://salt.tikicdn.com/ts/product/ae/37/4b/cb31b59cb47e503ef6d4bf6b80bd48ce.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ae/37/4b/cb31b59cb47e503ef6d4bf6b80bd48ce.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ae/37/4b/cb31b59cb47e503ef6d4bf6b80bd48ce.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ae/37/4b/cb31b59cb47e503ef6d4bf6b80bd48ce.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ae/37/4b/cb31b59cb47e503ef6d4bf6b80bd48ce.png"},{"base_url":"https://salt.tikicdn.com/ts/product/68/6d/17/98bcce29e0ba86c42a18477464e28776.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/68/6d/17/98bcce29e0ba86c42a18477464e28776.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/68/6d/17/98bcce29e0ba86c42a18477464e28776.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/68/6d/1