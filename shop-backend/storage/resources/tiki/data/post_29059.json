"icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/53/b0/6c/b9502fe879cefbda7317d314a6df23a4.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":296,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp class=\"irIKAp\"\u003e\u003cstrong\u003eLắp ráp và vận chuyển: \u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Sản phẩm do KEGODA giao hàng và lắp ráp tận nơi cho khách hàng tại TP. HCM. Sau khi Quý khách đặt hàng trên Tiki, KEGODA sẽ liên hệ xác nhận đơn hàng và tiến hành giao hàng theo lịch hẹn.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Nếu có lỗi/hư hỏng (kể cả do lỗi vận chuyển), KEGODA cam kết gửi thay thế phần bị hỏng ngay khi nhận được yêu cầu.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e— — — — — — — — —\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/7f/e0/c4/25ea477cfd74a3670422fdac9adc0403.jpg\" alt=\"\" width=\"750\" height=\"1425\" /\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/9c/a7/60/8ed329078a333f6357d148632faf4196.jpg\" alt=\"\" width=\"750\" height=\"1475\" /\u003e\u003c/p\u003e\n\u003cp\u003e— — — — — — — — —\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThông số: \u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Chất liệu: MDF bề mặt phủ Melamine kháng nước, bền màu, an toàn và sử dụng lâu dài.\u003c/p\u003e\n\u003cp\u003e- Màu sắc: Trắng; Vân gỗ sồi.\u003c/p\u003e\n\u003cp\u003e- Kích thước: Theo từng mẫu\u003c/p\u003e\n\u003cp\u003e- Thương hiệu: KEGODA\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e— — — — — — — — —\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cstrong\u003eLưu ý an toàn:\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eTủ/bàn trang điểm số #1 có chiều cao lớn (165cm) với hệ cánh nặng nên để đảm bảo an toàn trong quá trình sử dụng, quý khách cần gắn pát chống lật/ngã đổ (KEGODA có gửi kèm theo sản phẩm).\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eQuý khách thực hiện gắn pát theo hướng dẫn dưới đây.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/6d/37/aa/35b6b8c357205998c51cfec4fec9b141.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\" style=\"text-align:center\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/a2/cd/77/32c2265a4f58072b4bcc7496dd8d4887.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e— — — — — — — — —\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eDịch vụ sau bán hàng:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Bảo hành 1 đổi 1 miễn phí theo chính sách của tiki nếu sản phẩm có lỗi kĩ thuật hoặc do lỗi vận chuyển\u003c/p\u003e\n\u003cp\u003e- Bảo hành chất lượng sản phẩm 24 tháng. Bảo trì và hỗ trợ khách hàng trọn đời.\u003c/p\u003e\n\u003cp\u003e— — — — — — — — —\u003c/p\u003e\n\u003cdiv\u003e\n\u003cp\u003e- Sản phẩm được sản xuất tại: Công ty TNHH Trang Trí Nội Thất Đơn Giản Là Đẹp\u003c/p\u003e\n\u003cp\u003e- Xuất xứ: Việt Nam\u003c/p\u003e\n\u003cp\u003e— — — — — — — — —\u003c/p\u003e\n\n\u003cp\u003e\u003cstrong\u003e Welcome to KEGODA\u003c/strong\u003e\u003c/p\u003e\n\n\u003cp\u003eKEGODA là thương hiệu thuộc Công ty TNHH Trang Trí Nội Thất Đơn Giản Là Đẹp, cam kết mang đến cho bạn những sản phẩm đồ gỗ nội thất chất lượng cao với chi phí tiết kiệm. Chúng tôi luôn sẵn sàng lắng nghe và làm việc chăm chỉ để có thể phục vụ bạn tốt hơn mỗi ngày. Bạn luôn được chào đón.\u003c/p\u003e\n\n\u003cp\u003e\u003cstrong\u003eNếu bạn hài lòng với sản phẩm của KEGODA, hy vọng bạn có thể dành tặng KEGODA đánh giá tốt 5 sao.\u003c/strong\u003e\u003c/p\u003e\n\n\u003c/div\u003e\n\u003cp class=\"irIKAp\"\u003e#tuguong #bantrangdiem #banphan #bantrangdiemcoguong #bantrangdiemgapgon #kegoda\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/53/b0/6c/b9502fe879cefbda7317d314a6df23a4.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/53/b0/6c/b9502fe879cefbda7317d314a6df23a4.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/53/b0/6c/b9502fe879cefbda7317d314a6df23a4.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/53/b0/6c/b9502fe879cefbda7317d314a6df23a4.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/53/b0/6c/b9502fe879cefbda7317d314a6df23a4.jpg"}],"warranty_policy":null,"brand":{"id":4720599,"name":"kegoda","slug":"kegoda"},"current_seller":{"id":286476,"sku":"3660036629822","name":"KEGODA Official","link":"https://tiki.vn/cua-hang/kegoda-official","logo":"https://vcdn.tikicdn.com/ts/seller/a4/5d/76/517f027fe3e42d54fc18ddbb87af9b19.jpg","price":1430000,"product_id":"273376955","store_id":273583,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Con