unt":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/40/ed/e9/90bd1e68317b558e26693e8c17c26402.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":332,"all_time_quantity_sold":27,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003e1. Nguyên nhân: \u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eDo mùi hôi từ hố ga, đường ống thải xông ngược lên mà thoát sàn thông thường hiện nay chưa xử lý triệt để được. Nhất là sau 1 đêm, nước ở những nơi đó bị khô không còn tác dụng ngăn mùi nữa. Sử dụng phụ kiện nắp bịt nhựa PVC chống mùi hôi, côn trùng cho đường ống nước thải.hố ga,bể phốt,ống thông gió,ống hút mùi,ao hồ,bể bơi, thoát sàn, ống xả máy giặt, nhà vệ sinh, chậu rửa bát… là những nơi rất dễ bị mùi hôi bốc lên từ cống xông khắp nhà vô cùng khó chịu. Bên cạnh đó còn xuất hiện các loại côn trùng rải rác. Bất kể ở nhà đất, chung cư, tập thể, khách sạn, nhà kho, bếp… đều bị. bơi, hồ cá \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e2. Tính ưu việt: \u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eCác loại thoát sàn chống mùi khác làm bằng đồng, inox, thép không gỉ, sau một thời gian, nãy lò xo ít nhiều bị gỉ sét gây hiện tượng kẹt dẫn đến không đóng mở van được do đó mùi hôi lại xông lên sau một thời gian sử dụng, phải đục sàn lên để thay. So với các loại trên, phụ kiện nắp nhựa PVC siêu đàn hồi, tuổi thọ trên 20 năm, dễ dàng thay thế, lắp đặt chỉ qua một vài thao tác.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e3. Nguyên lý hoạt động: \u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Loại lắp cho ống nằm ngang lực tự trọng sẽ tự đóng khi không có nước chảy kín chống hôi và côn trùng chuột bọ không thể vào nhà theo đường thoát nước (không có từ tính nam châm hút nắp).\u003c/p\u003e\n\u003cp\u003e- Loại chống trào ngược, chống ngập không ảnh hưởng tới mức độ thoát nước do được làm bằng nhựa mà nhựa dưới nước thì mọi người biết độ bền rồi. Tuổi thọ trên 20 năm. Lặp đặt thay thế rất đơn giản, nhanh gọn.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/d4/65/46/c88967e62c52a9f35ae65463f95ff7ff.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/c6/06/d7/9bea009b27774ea024da32edc26dc49b.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/40/ed/e9/90bd1e68317b558e26693e8c17c26402.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/40/ed/e9/90bd1e68317b558e26693e8c17c26402.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/40/ed/e9/90bd1e68317b558e26693e8c17c26402.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/40/ed/e9/90bd1e68317b558e26693e8c17c26402.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/40/ed/e9/90bd1e68317b558e26693e8c17c26402.jpg"}],"warranty_policy":null,"brand":{"id":4958627,"name":"DORON","slug":"doron"},"current_seller":{"id":154892,"sku":"5311955519609","name":"HDC Home","link":"https://tiki.vn/cua-hang/hdc-home","logo":"https://vcdn.tikicdn.com/ts/seller/3f/e0/00/a7b43edf8d444b8d3f09fef1d95267a7.jpg","price":45000,"product_i