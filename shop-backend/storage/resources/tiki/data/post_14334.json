ref":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/e7/bd/01/406adfd798dd7a9e5fb1e847b1ef8201.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2165,"all_time_quantity_sold":15,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eSẢN PHẨM ĐƯỢC NHẬP KHẨU CHÍNH HÃNG VÀ PHÂN PHỐI BỞI CÔNG TY CỔ PHẦN TẦM NHÌN\u003c/strong\u003e   \u003c/p\u003e\n\u003cp\u003eVòi phun súng bằng nhựa (2 chế độ phun) Gardena 18303-20 được làm từ chất liệu nhựa cao cấp, kết nối với ống dây Gardena và vòi nước để tưới cây, rửa sân vườn.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://hqvcdn3.azureedge.net/qs_h=250\u0026amp;w=350\u0026amp;crop=0\u0026amp;ver=20220502T103602\u0026amp;hcsh=5088513A9CF93F3C42711FE40D64B636/_$$_/media/aprimo/gardena/nozzles-sprayers/photos/studio/ga110-12xxxx/ga110-1266.png\" alt=\"18303-20-S-001\" width=\"350\" height=\"250\" /\u003e\u003c/p\u003e\n\u003cp\u003eVòi có 2 chế độ phun xoay để điều chỉnh, tay cầm thoải mái, có chế độ khóa rảnh tay khi tưới trong thời gian dài, nút gạt chuyển chế độ phun thuận tiện ngay trên tay cầm.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://hqvcdn3.azureedge.net/qs_h=250\u0026amp;w=350\u0026amp;crop=0\u0026amp;ver=20220502T103653\u0026amp;hcsh=2EA9E1311EA12E3E847AE4D114B7BCF1/_$$_/media/aprimo/gardena/nozzles-sprayers/photos/action/ga150-20xxxx/ga150-2025.jpeg\" alt=\"18303-20-L-008\" width=\"350\" height=\"250\" /\u003e\u003c/p\u003e\n\u003cp\u003eVới áp lực nước tốt, vòi phun súng bằng nhựa Gardena không chỉ dùng để tưới vườn mà còn có thể dùng để làm sạch đất cát, bụi bẩn bởi chế độ phun mạnh.\u003c/p\u003e\n\u003cp\u003e    \u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://hqvcdn3.azureedge.net/qs_h=250\u0026amp;w=350\u0026amp;crop=0\u0026amp;ver=20220502T103609\u0026amp;hcsh=F9E5E1BA7FFA1B0F04286D06AC355B34/_$$_/media/aprimo/gardena/nozzles-sprayers/photos/action/ga150-20xxxx/ga150-2014.jpeg\" alt=\"18303-20-L-005\" width=\"350\" height=\"250\" /\u003e\u003c/p\u003e\n\u003cp\u003eCHỈ NHỮNG PHẦN MÀU CAM TRÊN SẢN PHẨM LÀ CÓ THỂ ĐIỀU CHỈNH DI CHUYỂN ĐƯỢC (XOAY/ẤN/VẶN/KÉO).\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTHÔNG TIN THƯƠNG HIỆU \u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eGARDENA là Thương hiệu dẫn đầu thế giới với hơn 60 năm kinh nghiệm trong lĩnh vực sản xuất dụng cụ và thiết bị chăm sóc sân vườn tại Châu Âu, được thành lập năm 1961 tại Đức bởi Werner Kress và Eberhard Kastner. Sản phẩm Gardena đã có mặt tại hơn 80 quốc gia thông qua các Nhà Nhập khẩu và Phân phối. Kể từ năm 2006, Gardena thuộc quyền sở hữu của Tập đoàn Husqvarna AB Thụy Điển. Gardena đã trở thành Thương hiệu ưa thích của hàng triệu chủ sở hữu nhà và vườn trên toàn thế giới bởi các sản phẩm đa dạng cùng chất lượng tuyệt vời.\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/e7/bd/01/406adfd798dd7a9e5fb1e847b1ef8201.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e7/bd/01/406adfd798dd7a9e5