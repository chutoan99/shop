,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/a6/e5/b6/6b9048e5b6113555df61e5320828ad5a.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1975,"all_time_quantity_sold":6,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e51 Chìa Khóa Vàng Để Trở Thành Nhà Lãnh Đạo Truyền Cảm Hứng\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003eCuốn sách này bán chạy nhất tại Nhật Bản được các nhà lãnh đạo yêu thích.\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003eBạn mạnh mẽ, trình bày xuất sắc và nói một cách đơn giản, người mà mọi người bị thu hút. Có lẽ có những người nghi ngờ rằng họ có thể trở lên như vậy. Nhưng tác giả Matsuo Iwata khẳng định rằng bất kỳ ai làm việc chăm chỉ đều có thể trở thành lãnh đạo.\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003eÔng Iwata, mặc dù tự nhận mình là một người thường, nhưng ông chia sẻ 51 chìa khóa vàng để trở thành nhà lãnh đạo truyền cảm hứng đầy thu hút. Cuốn sách này được khuyến nghị cho những người quản lý, nhưng nhà lãnh đạo mới, những người sẽ lần đầu tiên chịu trách nhiệm về người khác.\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e _ 51 Chìa Khóa Vàng Để Trở Thành Người Ai Cũng Muốn Làm Việc Cùng\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003eBạn có đang gặp phải: \u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e- Tôi cảm thấy khó khăn khi làm quen với sếp của mình.\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e- Tôi Không thực sự biết cách giao tiếp hay thaoir luận về vấn đề của sếp.\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e- Tôi đã muốn sử lý công việc với sếp tốt và làm việc trôi chảy.\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003eMột số người phải đối mặt với những mối quan tâm này\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003eTất nhiên có một khoảng thời gain mà ngay cả ông Iwata cũng là cấp dưới trước khi ông trở thành CEO tại The Body Shop và Starbucks\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003eLàm thế nào anh ấy tiếp cận công việc và tự phát triển bản thân trong khi anh ấy ở vị trí thấp hơn?\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003eNgoài ra với tư cách là một người ở vị trí cấp cao hoặc là một doanh nhân, anh ta sẽ vui mừng khi có những người nhân viên như thế nào?\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003eSử dụng hai góc nhìn từ kinh nghiệm của mình cả với tư cách là cấp dưới và là người lãnh đạo, tác giả trì bày 51 chìa khóa vàng để trở thành người mà ai cũng muốn làm việc cùng.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/a6/e5/b6/6b9048e5b6113555df61e5320828ad5a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a6/e5/b6/6b9048e5b6113555df61e5320828ad5a.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a6/e5/b6/6b9048e5b6113555df61e5320828ad5a.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a6/e5/b6/6b9048e5b6113555df61e5320828ad5a.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a6/e5/b6/6b9048e5b6113555df61e5320828ad5a.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/bf/2d/3f/bb279255f9c42