f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":1730000,"discount_rate":30,"rating_average":4.8,"review_count":6,"review_text":"(6)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/e5/7c/89/63b597ff5479dda66bf3274a19c83d1e.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":656,"all_time_quantity_sold":15,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003e*Lắp ráp và vận chuyển:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e+ Tại TP.HCM:\u003c/strong\u003e SIB Decor giao tận nơi (chỉ giao hàng) cho khách hàng tại TP.HCM từ 0-3 ngày (có giao thứ 7, chủ nhật).\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e+ Các tỉnh/Tp khác:\u003c/strong\u003e SIB Decor có giao trực tiếp tại Bình Dương, Đồng Nai và các khu vực lân cận. Vui lòng gửi tin nhắn CHAT để được tư vấn cụ thể.\u003c/p\u003e\n\u003cp\u003e- Sản phẩm khách hàng tự lắp ráp. Bộ sản phẩm được đóng gói dạng rời gồm các tấm gỗ được dán nhãn và đánh số kèm theo sơ đồ lắp ráp, đầy đủ phụ kiện.\u003c/p\u003e\n\u003cp\u003e- Vui lòng nhắn với SIB Decor qua kênh chat nếu bạn có nhu cầu hỗ trợ lắp đặt tận nơi tại TP.HCM (dịch vụ có thu phí)\u003c/p\u003e\n\u003cp\u003e- Nếu có lỗi/hư hỏng (kể cả do lỗi vận chuyển), SIB Decor cam kết gửi thay thế phần bị hỏng ngay khi nhận được yêu cầu.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7qukw-ljqnfcvnqy7o06\" alt=\"vn-11134208-7qukw-ljqnfcvnqy7o06\" width=\"800\" height=\"801\" /\u003e\u003c/p\u003e\n\u003cp\u003e— — — — — — — — —\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThông số:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Chất liệu tốt: gỗ MDF lõi xanh chống ẩm, độ dày 17mm, bề mặt phủ melamine đồng màu, căng phẳng có khả năng kháng nước, hạn chế trầy xước, lau sạch dễ dàng.\u003c/p\u003e\n\u003cp\u003e- Màu sắc: Trắng/ Vân Gỗ.\u003c/p\u003e\n\u003cp\u003e- Kích thước: 178 x 40 x 24cm (Cao x Dài x Rộng)\u003c/p\u003e\n\u003cp\u003e- Thương hiệu: SIB Decor.\u003c/p\u003e\n\u003cp\u003e- Sản phẩm được sản xuất tại: Công ty TNHH Trang Trí Nội Thất Đơn Giản Là Đẹp\u003c/p\u003e\n\u003cp\u003e- Địa chỉ: 2/4/2 Đông Hưng Thuận 10B, phường Đông Hưng Thuận, Quận 12, TP. Hồ Chí Minh.\u003c/p\u003e\n\u003cp\u003e- Xuất xứ: Việt Nam\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7qukw-ljqnfcvntrck63\" alt=\"vn-11134208-7qukw-ljqnfcvntrck63\" width=\"800\" height=\"800\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e— — — — — — — — —\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eĐiểm nổi bật\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Kệ kích thước cao 178cm, dài 40cm và rộng 24cm có 6+1 tầng hệ len chân chắc chắn, hệ pát chống lật giúp hạn chế tối đa nguy cơ đổ ngã.\u003c/p\u003e\n\u003cp\u003e- Với 5 ngăn kệ có khả năng để được rất nhiều sách, đồ trang trí.\u003c/p\u003e\n\u003cp\u003e- Kệ thiết kế đơn giản nên dễ dàng sắp đặt tại nhiều vị trí: Phòng làm việc, phòng ngủ, phòng khá và rất tiện di chuyển khi cần.\u003c/p\u003e\n\u003cp\u003e- Các ngăn kệ có chiều cao lọt lòng ~27cm để được nhiều khổ sách. Đặc biệt là bề rộng (sâu) của kệ 24cm cho không gian lưu trữ rộng rãi và chiếc kệ trông cứng cáp, đầy đặn.\u003c/p\u003e\n\u003cp\u003e- Kệ sách sử dụng các tấm gỗ MDF lõi xanh bền mặt phủ melamine chống trầy, kháng nước và hệ giằng với thiết kế chắc chắn, an toàn và sử dụng lâu dài.\u003c/p\u003e\n\u003cp\u003e- Dễ dàng lắp ráp: Sản phẩm được gia công bằng CNC tự động, các vị trí liên kết đều có độ chuẩn xác nên rất dễ dàng trong quá trình lắp ráp sản phẩm.\u003c/p\u003e\n\u003cp\u003e- Bộ sản phẩm gồm đầy đủ phụ kiện và hướng dẫn lắp đặt được đóng gói cẩn trọng tránh nguy cơ lỗi do quá trình vận chuyển.\u003c/p\u003e\n\u003cp\u003e- Đặc biệt: Các vị trí liên kết đều được SIB cung cấp miếng dán decal đồng màu để che lại rất thẩm mỹ.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7qukw-ljqnfcvnscs467\" alt=\"vn-11134208-7qukw-ljqnfcvnscs467\" width=\"800\" height=\"800\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/d9/36/16/3a25cd2049c18318479118334624ed26.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/2c/56/8f/8d81911838c8f043685e93aa8c5577a1.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e— — — — — — — — —\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eLưu ý an toàn:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eSản phẩm còn được kèm theo bộ phụ kiện Pát chống lật có tác dụng chống ngã đổ kệ/tủ, giữ an toàn trong quá trình sử dụng, đặc biệt với gia đình có trẻ nhỏ.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7qukw-ljqmcinzxwjmcd\" alt=\"vn-11134208-7qukw-ljqmcinzxwjmcd\" width=\"800\" height=\"800\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7qukw-ljqmcinzzb4242\" alt=\"vn-11134208-7qukw-ljqmcinzzb4242\" width=\"800\" height=\"800\" /\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e— — — — — — — — —\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cstrong\u003eMột số câu hỏi thường gặp\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cstrong\u003eKhi nào tôi nhận được hàng?\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Vận chuyển bởi nhà bán hàng: SIB Decor liên hệ xác nhận ngay sau khi nhận được đơn hàng. Thời gian giao hàng thường từ 0-3 ngày làm việc (có giao thứ 7, chủ nhật).\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Giao hàng tiết kiệm: Thông thường từ 1-5 ngày.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cstrong\u003eSản phẩm còn hàng không?\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Tất cả các sản phẩm đều có hàng sẵn, bạn có thể đặt hàng ngay.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cstrong\u003eCam kết với khách hàng?\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- SIB xử lý các sự cố (nếu có) luôn nhanh nhất và có lợi nhất cho khách hàng.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Bảo hành 1 đổi 1 trong vòng 7 ngày nếu sản phẩm hư hỏng do vận chuyển hoặc do lỗi sản xuất.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Bảo hành chất lượng sản phẩm 24 tháng, bảo trì và chăm sóc trọn đời sản phẩm.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e— — — — — — — — —\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cstrong\u003e Hướng dẫn\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Sản phẩm khách hàng tự lắp ráp (các tấm gỗ được dán nhãn và đánh số kèm theo sơ đồ lắp ráp đầy đủ, rất dễ dàng thực hiện).\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Khi cần làm sạch, chỉ cần dùng khăn ẩm và lau nhẹ (bề mặt phủ melamine có khả năng chống trầy xước, bền màu nên rất dễ làm sạch).\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Hạn chế để nơi có ánh nắng chiếu trực tiếp, nơi ẩm ướt.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e— — — — — — — — —\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cstrong\u003eWelcome to SIB Decor \u0026lt;3\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eChúng tôi phục vụ bạn bằng sự trung thực, luôn sẵn sàng hỗ trợ bạn bất cứ lúc nào. Nếu bạn có bất kỳ câu hỏi nào về việc lắp đặt hoặc bảo hành sản phẩm, vui lòng liên hệ với chúng tôi.\u003c/p\u003e\n\u003cp\u003eHy vọng sản phẩm của SIB Decor sẽ mang lại nhiều hạnh phúc hơn cho cuộc sống của bạn.\u003c/p\u003e\n\u003cp\u003e#giasach