}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":3,"review_text":"(3)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/53/ef/df/1d2f2d224588f324fc273808fe73c9d4.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1181,"all_time_quantity_sold":23,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align:justify;\"\u003eBếp nướng gas đa năng \u003cstrong\u003eNamilux GM2020PS\u003c/strong\u003e mẫu mới cao cấp, màu xám nâu, nướng NGON HƠN NƯỚNG ĐIỆN, TIỆN HƠN NƯỚNG THAN.\u003cbr /\u003eĐây là dòng bếp nướng gas chuyên nghiệp với bề mặt diện tích nướng lớn hơn 2 lần so với các loại bếp nướng thông thường khác. Do vậy, bếp có thể nướng được nhiều hơn, rất tiện ích, tiết kiệm thời gian, và đảm bảo hiệu quả rất cao.\u003cbr /\u003eBếp có khay hứng mỡ lớn, giúp ngăn ngừa dầu mỡ tràn ra bên ngoài, và rất dễ vệ sinh sau khi sử dụng.\u003cbr /\u003eGM2120PS là sản phẩm đa dụng khi có thể nướng được tất cả các loại thức ăn như sườn, thịt, cá, gà, bò, rau củ, quả, Bếp rất thuận tiện khi đi du lịch, và những buỗi tiệc tùng ngoài trời. Bếp còn có thêm kiềng phụ để chuyển sang chức năng nấu như bếp thông thường.\u003cbr /\u003eVới tính năng an toàn - bền bỉ, bếp sử dụng van an toàn 2 cấp có cầu chì xả gas chống nổ. Thân bếp dày 0,5mm (hơn 1,6 lần so với các bếp khác) và được dập theo công nghệ Transfer Robot rất bền bỉ và chắc chắn theo thời gian.\u003cbr /\u003eGM2120PS sử dụng lon gas mini Butane và là sản phẩm mới nhất được cải tiến từ bếp Namilux NA-24N (kích thước lớn hơn bếp NA-24N).\u003cbr /\u003eThân bếp được sơn tĩnh điện chống dính cao cấp, bền bỉ sử dụng trong thời gian dài.\u003cbr /\u003eCông suất bếp tăng lên đến 42%, giúp rút ngắn thời gian nướng. Công suất mạnh nhất có thể đạt 3.0kW/h, giúp rút ngắn thời gian xử lý nấu nướng, tiết kiệm gas, và làm cho thức ăn tươi ngon, bổ dưỡng hơn.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/53/ef/df/1d2f2d224588f324fc273808fe73c9d4.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/53/ef/df/1d2f2d224588f324fc273808fe73c9d4.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/53/ef/df/1d2f2d224588f324fc273808fe73c9d4.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/53/ef/df/1d2f2d224588f324fc273808fe73c9d4.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/53/ef/df/1d2f2d224588f324fc273808fe73c9d4.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/00/64/1a/133f833ab990f8c1bfb87870a5615adf.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/00/64/1a/133f833ab990f8c1bfb87870a5615adf.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/00/64/1a/133f833ab990f8c1bfb87870a5615adf.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/00/64/1a/133f833ab990f8c1bfb87870a5615adf.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/00/64/1a/133f833ab990f8c1bfb87870a5615adf.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/05/19/5b/ce41f93fe2f72a55560d4a86cbc03be2.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/05/19/5b/ce41f93fe2f72a55560d4a86cbc03be2.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/05/19/5b/ce41f93fe2f72