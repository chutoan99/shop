:null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":3.9,"review_count":7,"review_text":"(7)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/03/7f/9a/2c7fea6b7b88b855e5f359cd97cb60a7.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2754,"all_time_quantity_sold":35,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cspan style=\"font-size: medium; color: #008ab7;\"\u003e \u003cstrong\u003e Giàn Phơi Inox Đơn Lắp Ráp CB - 1.55x1.4m \u003c/strong\u003e \u003c/span\u003e với thiết kế thông minh giúp bạn phơi/treo quần áo trong nhà một cách tiện lợi và nhanh chóng. Dưới chân giàn phơi có bánh xe, giúp bạn có thể di chuyển dễ dàng trong mọi không gian. Sản phẩm thích hợp cho những gia đình có không gian nhỏ, căn hộ chung cư hoặc các cửa hàng thời trang hay hội chợ.\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eGiàn phơi làm bằng chất liệu inox cao cấp không gỉ sét, có thể bảo vệ quần áo của bạn không bị hư do chất gỉ tạo nên. Các thanh được làm bằng inox chắc chắn; dày 0.6mm; dày gần gấp đôi các giàn phơi thông thường. Hai thanh đế ngang ống inox vuông 30x30 cm; dày 1mm, chịu được khối lượng lớn; các khớp và bánh xe bằng nhựa cao cấp, 4 bánh xe chắc chắn giúp bạn có thể di chuyển kệ phơi đồ này đến bất cứ nơi nào bạn muốn.\u003c/li\u003e\n\u003cli\u003eSản phẩm được cấu tạo từ các ống inox tháo rời, kết hợp bánh xe, dễ dàng lắp ráp và di chuyển khi cần thiết, giúp bạn thuận tiện trong việc di dời giàn phơi từ vị trí này sang vị trí khác trong nhà.\u003c/li\u003e\n\u003cli\u003eThiết kế thông minh bao gồm: 4 bánh xe, 2 thanh trụ nối từ bánh xe, 2 giá đỡ, 2 thanh hỗ trợ, 2 khớp nối, 2 sào phơi đồ dễ dàng tháo lắp, thu gọn.\u003c/li\u003e\n\u003cli\u003eKích thước sản phẩm cao 1.55m và ngang 1.4m, tiện dụng cho những gia đình. Sản phẩm còn có thể sử dụng để trưng bày hàng hóa tại các shop quần áo hay hội chợ.\u003c/li\u003e\n\u003cli\u003eSản phẩm được bảo hành trong 3 năm, có phiếu bảo hành kèm theo.\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/03/7f/9a/2c7fea6b7b88b855e5f359cd97cb60a7.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/03/7f/9a/2c7fea6b7b88b855e5f359cd97cb60a7.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/03/7f/9a/2c7fea6b7b88b855e5f359cd97cb60a7.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/03/7f/9a/2c7fea6b7b88b855e5f359cd97cb60a7.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/03/7f/9a/2c7fea6b7b88b855e5f359cd97cb60a7.jpg"},{"base_url":"https://salt.tikicdn.com/media/catalog/product/p/t/pt-907--2-.u2566.d20161103.t110928.615218.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/p/t/pt-907--2-.u2566.d20161103.t110928.615218.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/p/t/pt-907--2-.u2566.d20161103.t110928.615218.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/p/t/pt-907--2-.u2566.d20161103.t110928.615218.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/p/t/pt-907--2-