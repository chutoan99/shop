upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":7,"review_text":"(7)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/0a/9f/54/89e8754b82d6bb8ed695cd59897bf804.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":526,"all_time_quantity_sold":49,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<article class=\"4ever-article\">\n<h1 class=\"Title__TitledStyled-sc-c64ni5-0 iXccQY\" style=\"text-align:justify;\">Máy úp bình sữa tiệt trùng sấy khô UVC Tidy 1 Fatzbaby FATZ FB4268WM</h1>\n<p style=\"text-align:justify;\"><strong>Giới thiệu</strong></p>\n<p style=\"text-align:justify;\"><strong>Máy úp bình sữa tiệt trùng UVC sấy khô Fatzbaby</strong> FB4268WM là dụng cụ tiện ích giúp bảo quản bình sữa và các vật dụng ăn uống của bé. Nhờ được tích hợp đèn UVC-LEDs và chức năng sấy khô hiện đại, sản phẩm có tác dụng ngăn ngừa vi khuẩn hiệu quả, giữ cho các vật dụng luôn được an toàn và sạch sẽ. Ngoài ra, máy úp còn được cấu tạo bởi vật liệu chịu nhiệt cao cấp và được trang bị nắp đậy PP chắc chắn, đảm bảo không biến dạng, không nứt vỡ, đem đến nhiều tiện ích vượt trội và bền bỉ.</p>\n<p style=\"text-align:justify;\"><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/84/9a/7f/a11001fb65e161dc551226bc5cb47ed1.jpg\" alt=\"849a7f997379c7426b726fef7bfff625.jpg\" /> </p>\n<p style=\"text-align:justify;\"> </p>\n<p style=\"text-align:justify;\"> <img src=\"https://salt.tikicdn.com/cache/w750/ts/product/f9/e6/ed/fd0f8a4ba328287a5498f75633e510d0.jpg\" alt=\"f9e6edcde741821d086ef26f6fcdebe5.jpg\" />  </p>\n<p style=\"text-align:justify;\"><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/89/3a/5a/343b708c53ce01fa341c960b99ce80e0.jpg\" alt=\"893a5a1b26cf671b1a114ae57eecdcad.jpg\" />  </p>\n<p style=\"text-align:justify;\"> <img src=\"https://salt.tikicdn.com/cache/w750/ts/product/70/dd/02/1c06cd8ef767e212afd4240cb13a7961.jpg\" alt=\"70dd022100594fced63476fac9e9f55e.jpg\" /> </p>\n<p style=\"text-align:justify;\"><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/6f/9d/76/b397699c16ca65a22b5df56b9668e1bf.jpg\" alt=\"6f9d7621d794dc1b0724b9595611604e.jpg\" />   </p>\n<p style=\"text-align:justify;\"><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/cb/1a/91/c9614fab97397f5e32721e84fb86c64e.jpg\" alt=\"cb1a912f9a2e77007e3af7deb2d742e7.jpg\" /> </p>\n<p style=\"text-align:justify;\"><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/8c/23/ed/fdeb5f356b8bacacc3f57d00542e54a3.jpg\" alt=\"8c23ed7c66ee5e02b7fc573c5b077cd8.jpg\" />  </p>\n<p style=\"text-align:justify;\"><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/16/c4/ac/c4993999ac5cebffc9949b3c67e14715.jpg\" alt=\"16c4aca54c125f7264ffbc47648f5bbc.jpg\" width=\"750\" height=\"421\" />  <strong>Đặc điểm nổi bật</strong></p>\n<p>Công nghệ hiện đại, công dụng vượt trội</p>\n<p>- Máy úp bình sữa tiệt trùng UVC sấy khô Fatzbaby FB4268WM có khả năng tiêu diệt triệt để các vi khuẩn gây hại bằng UVC-LEDs nhờ được trang bị lớp thép tăng phản xạ đèn UVC LED ở dưới đáy.</p>\n<p>- Máy sử dụng công nghệ PTC để sấy vật dụng, có quạt thông gió giúp làm nguội nhanh chóng, tránh bỏng tay và khử mùi hôi hiệu quả.</p>\n<p>- Chức năng tự động tắt và bật đèn LED khi nắp bị mở giúp quá trình sử dụng trở nên đơn giản, dễ dàng lắp đặt và sắp xếp vật dụng trong nhiều điều kiện ánh sáng khác nhau.</p>\n<p>- Chức năng giữ tiệt trùng các vật dụng đã tiệt trùng lên tới 72 giờ, giúp vật dụng luôn sạch kể cả khi quá trình tiệt trùng đã kết thúc.</p>\n<p>Thiết kế thông minh, tiện lợi</p>\n<p>- Máy úp bình sữa tiệt trùng có thể tích lớn 20L, dễ dàng úp nhiều loại bình và vật dụng khác nhau, tiết kiệm tối đa thời gian và công sức cho ba mẹ.</p>\n<p>- Máy có thể tuỳ chỉnh 3 mức thời gian hoạt động 55/65/75 phút, phù hợp cho nhiều mục đích sử dụng.</p>\n<p>- Khay đựng nước tháo rời, dễ dàng làm sạch và đổ nước dư thừa nhằm đảm bảo an toàn vệ sinh cho máy và các loại vật dụng.</p>\n<p>- Đèn UVC-LEDs có tuổi thọ lâu dài, hoàn toàn có thể sử dụng vĩnh viễn mà không cần phải thay đèn.</p>\n<p><strong>Lưu ý khi sử dụng sản phẩm</strong></p>\n<p>- Trước khi vệ sinh làm sạch sản phẩm, hãy dừng hoạt động và rút phích cắm để đảm bảo an toàn.</p>\n<p>- Trong quá trình vệ sinh, không đổ nước vào trong máy để tránh gây hư hại các bộ phận của máy.</p>\n<p>- Trước khi sử dụng thiết bị lần đầu tiên, để máy hoạt động trong 1-2 chu kỳ mà không cho bất cứ thứ gì vào bên trong, sau đó mở nắp trong 20 phút để thông.</p>\n<p>- Máy chỉ phù hợp với vật dụng chịu nhiệt được từ 80ºC trở lên (không sử dụng các thiết bị điện tử).</p>\n<p style=\"text-align:justify;\"> <img src=\"https://salt.tikicdn.com/cache/w750/ts/product/0a/9f/54/398dfcc945990ab94298b294ede5e28a.jpg\" alt=\"0a9f542126e85cbf7e3ccd2cd3dd0f20.jpg\" width=\"750\" height=\"750\" /> <strong>Thông số kỹ thuật</strong></p>\n<ul>\n<li style=\"text-align:justify;\">Nguồn điện: 220-240V AC, 50/60Hz; Công suất sấy :75W</li>\n<li style=\"text-align:justify;\">Dung tích: 20L.</li>\n<li style=\"text-align:justify;\">Khối lượng: 1.31 kg.</li>\n<li style=\"text-align:justify;\">Kích thước: 31.5 x 31.5 x 27.5 cm</li>\n</ul>\n</article><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/0a/9f/54/89e8754b82d6bb8ed695cd59897bf804.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0a/9f/54/89e8754b82d6bb8ed695cd59897bf804.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/0a/9f/54/89e8754b82d6bb8ed695cd59897bf804.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0a/9f/54/89e8754b82d6bb8ed695cd59897bf804.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0a/9f/54/89e8754b82d6bb8ed695cd59897bf804.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/9e/d5/47/efe60adb67b0c7ae0e7cef212b68080d.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/9e/d5/47/efe60adb67b0c7ae0e7cef212b68080d.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/9e/d5/47/efe60adb67b0c7ae0e7cef212b68080d.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9e/d5/47/efe60adb67b0c7ae0e7cef212b68080d.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9e/d5/47/efe60adb67b0c7ae0e7cef212b68080d.png"},{"base_url":"https://salt.tikicdn.com/ts/product/89/3a/5a/30ef99a4a682d4ff2f32bc9145710699.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/89/3a/5a/30ef99a4a682d4ff2f32bc9145710699.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/89/3a/5a/30ef99a4a682d4ff2f32bc9145710699.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/89/3a/5a/30ef99a4a682d4ff2f32bc9145710699.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/89/3a/5a/30ef99a4a682d4ff2f32bc9145710699.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/f9/e6/ed/2fbd447e076b455140a5fe38d47e2930.jpg","is_gallery":true,"label":null,"large_url":"https:/