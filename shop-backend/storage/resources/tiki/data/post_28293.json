,"icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":26400,"discount_rate":15,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/51/d0/f0/3c11fc40d57e1490b7370534408c8a31.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":29,"all_time_quantity_sold":4,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp class=\"QN2lPu\"\u003e\u003cimg class=\"GqYslU hnult1\" src=\"https://down-vn.img.susercontent.com/file/vn-11134208-7r98o-lyr9b5qfjgi579\" alt=\"vn-11134208-7r98o-lyr9b5qfjgi579\" /\u003e\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e---\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e“Tu viện Northanger” kể về Catherine Morland, 17 tuổi, được miêu tả là người hoàn toàn không phải là hình mẫu cho các vai nữ chính anh hùng (theo kiểu các nữ anh hùng Gothic), vì mọi yếu tố liên quan tới cô đều bình thường. Như bao thiếu nữ khác của thời đại mình, cô cũng đang \"được đào tạo để trở thành một nữ anh hùng”. Cô cũng thích đọc tiểu thuyết Gothic. Mang theo trí tưởng tượng phong phú và một tâm hồn ngây thơ, một cuộc đời chưa hề được trải nghiệm, Catherine Morland đến thăm thành phố Bath, “vũ trụ” của những buổi khiêu vũ và các mối giao tế xã hội.\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e..\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e“Tu viện Northanger” hấp dẫn bởi phong cách văn chương đặc trưng của Jane Austen – sự tinh tế và chuẩn mực trong trong ngôn ngữ, dù với mục đích châm biếm, đả kích, nhưng không hề nặng nề mà là sự dí dỏm, hài hước nhẹ nhàng, thú vị nhưng cực kỳ sắc sảo và quyết liệt.\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e---\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eVỀ TÁC GIẢ:\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eJane Austen (1775 - 1817) là nữ văn sĩ người Anh, nổi tiếng với 6 tác phẩm được ca ngợi là những kiệt tác của mọi thời đại. Bà bắt đầu viết thơ, truyện ngắn và kịch khi mới 11 tuổi. Bà đã dùng ngòi bút của mình để phê phán xã hội Anh truyền thống một cách dí dỏm và trào phúng. Các tác phẩm của bà thường xoay quanh sự lệ thuộc của nữ giới vào hôn nhân để tìm địa vị xã hội và sự ổn định tài chính, từ đó ngầm chỉ trích dòng tiểu thuyết lãng mạn của nửa sau thế kỷ mười tám và là một phần của sự chuyển dịch sang văn học hiện thực của thế kỷ 19.\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eCùng với các tác phẩm khác của bà, “Tu viện Northanger” trở thành di sản của một thiên tài văn học được yêu mến trong suốt mấy trăm năm qua. Không những là nguồn cảm hứng cho các bản chuyển thể điện ảnh, truyền hình, những tác phẩm văn học ăn theo, cả trên nền tảng Internet, nhất là những video ngắn trên mạng xã hội… Điều đó chứng tỏ sức hút của “Tu viện Northanger” cũng như các tác phẩm khác của bà vẫn chưa hề giảm. Một nghiên cứu tên OMG Jane Austen của nhóm học giả Cambridge về trào lưu này cho rằng Austen là nhà văn được ghi nhớ nhiều nhất, sau Shakespeare.\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eĐại diện của nhà xuất bản tem Bưu chính Hoàng gia Anh, ông Andrew Hammond nói rằng: “Khi bạn nghĩ về những tác giả lớn của Anh, ngay lập tức Jane Austen sẽ xuất hiện trong đầu bạn. Những tiểu thuyết của bà đóng một vai trò quan trọng trong nền văn hóa Anh suốt hai thế kỷ qua.”\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eRainbow Books hân hạnh giới thiệu đến bạn đọc bản dịch tiếng Việt “Tu viện Northanger” - tác phẩm thứ 6 (trong số 6 tiểu thuyết nổi tiếng nhất của Jane Austen) do Mạc Linh chuyển ngữ.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/51/d0/f0/3c11fc40d57e1490b7370534408c8a31.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/51/d0/f0/3c11fc40d57e1490b7370534408c8a31.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/51/d0/f0/3c11fc40d57e1490b7370534408c8a31.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/51/d0/f0/3c11fc40d57e1490b7370534408c8a31.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/51/d0/f0/3c11fc40d57e1490b7370534408c8a31.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/fe/20/ed/e452e6ca269d1731ce3d419301c2ea32.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/fe/20/ed/e452e6ca269d1731ce3d419301c2ea32.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/fe/20/ed/e452e6ca269d1731ce3d419301c2ea32.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fe/20/ed/e452e6ca269d1731ce3d419301c2ea32.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fe/20/ed/e452e6ca269d1731ce3d419301c2ea32.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/0d/9e/e4/82c9fadc5c477747c19e70ee9505e29e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0d/9e/e4/82c9fadc5c477747c19e70ee9505e29e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/0d/9e/e4/82c9fadc5c477747c19e70ee9505e29e.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0d/9e/e4/82c9fadc5c477747c19e70ee9505e29e.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0d/9e/e4/