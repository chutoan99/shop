"text_color":"#FFF0F1","background_color":"#D93843","href":null,"text":"9.9"},{"placement":"pdp_badge","code":"is_hero","type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":true,"return_reason":"any_reason"}},"discount":6000,"discount_rate":4,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/4a/f7/18/347ab92f9614c5c05832e76fc24cd7cf.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1631,"all_time_quantity_sold":3,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3 class=\"mb-2 text-center\" style=\"text-align: center;\"\u003eLời giới thiệu\u003c/h3\u003e\n\u003cdiv class=\"resource__book-detail-collapsible\"\u003e\n\u003cdiv class=\"relative-block has_signature is_large-padding text-justify\"\u003e\n\u003cp class=\"block-indent\"\u003eNgày nay ngành sản khoa nước ta đã phát triển vượt trội so với cách đây vài thập niên nhưng vẫn có nhiều bà mẹ mang thai xuất hiện tai biến sản khoa và những vấn đề tại lúc sinh, sinh non, em bé sau sinh trong tình trạng nguy kịch hoặc dị tật bẩm sinh hoặc mang bệnh suốt đời. Để giảm tình trạng này cần nhiều giải pháp đồng bộ mà trong đó việc phổ cập rộng rãi kiến thức chăm sóc trước sinh là không thể thiếu.\u003c/p\u003e\n\u003cp class=\"block-indent\"\u003eĐọc quyển Chăm sóc Em bé Trước sinh của TS.BS. Trần Thị Hoa tôi nhận thấy tác giả nhằm vào việc giúp bà mẹ mang thai khỏe mạnh, cuộc sinh an toàn cho cả hai mẹ con và em bé sinh ra khỏe mạnh toàn diện. Bố cục sách được sắp xếp trình tự giúp độc giả có thể hình dung quá trình chăm sóc trước sinh bắt đầu từ đâu và những chủ đề nào liên quan với nhau. Nội dung sách không những đầy đủ các thủ thuật chăm sóc trước sinh gồm cả những bất thường và tai biến sản khoa mà còn giới thiệu các chương về phát triển thai và những yếu tố ảnh hưởng, đặc biệt chủ đề chăm sóc sức khỏe tiền hôn nhân, là vùng khoa học không thể thiếu nhưng chưa thấy nhiều sách xuất bản trước nhắc tới.\u003c/p\u003e\n\u003cp class=\"block-indent\"\u003eKiến thức và kỹ thuật chăm sóc sức khỏe cho các cặp vợ chồng và bà mẹ mang thai được tác giả đưa vào sách là chọn lọc những ưu việt của hai nền y học hiện đại và cổ truyền nhằm tăng hiệu quả, tránh tối đa tác dụng phụ và đỡ tốn kém. Lối viết thiên về thực hành và dễ áp dụng để độc giả ngoài ngành y có thể tự học làm \"bác sĩ ban đầu\" cho chính mình. Nhìn chung, sách của tác giả ảnh hưởng quan điểm cũng như khung tư duy chăm sóc sản khoa thiết yếu của các chuyên gia của WHO, UNFPA và danh y Hải Thượng Lãn Ông. Nước ta trước năm 2000 cũng triển khai chương trình sức khỏe sinh sản-làm mẹ an toàn do UNFPA tài trợ đã cải thiện được tai biến sản khoa và biến chứng sinh nở rõ rệt.\u003c/p\u003e\n\u003cp class=\"block-indent\"\u003eTheo tôi, \"Chăm sóc Em bé Trước sinh\" là cẩm nang gối đầu giường dành cho các cặp nam nữ có ý định chào đón thành viên mới. Phần nhiều kiến thức trong sách cũng cần thiết cho sinh viên y khoa, nữ hộ sinh và điều dưỡng đồng thời cũng bổ ích cho bác sĩ sản, nhi, đa khoa, nhân viên y tế cơ sở và những ai quan tâm tới trẻ em. Riêng bác sĩ nhi, nếu thiếu kiến thức chăm sóc trước sinh sẽ không đủ thông tin để chẩn đoán xác định bởi vì nhiều bệnh ở trẻ em đã xuất hiện từ thời kỳ thai nhi. Nếu có nhiều độc giả tiếp cận được quyển sách này, tôi tin rằng sẽ góp phần giảm tỷ lệ bệnh tật, tử vong bà mẹ và trẻ sơ sinh-một trong những mục tiêu mà vẫn còn là nỗi lo của Bộ Y tế.\u003c/p\u003e\n\u003cp class=\"block-indent\"\u003eTôi đánh giá cao cuốn sách rất chất lượng và đầy tâm huyết trên đây của TS. Trần Thị Hoa. Xin trân trọng được giới thiệu tới quý độc giả!\u003c/p\u003e\n\u003cp class=\"time-and-signature\"\u003e\u003cstrong\u003eGS.TS.BS.Nguyễn Thu Nhạn\u003c/strong\u003e\u003cbr /\u003e\u003cem\u003eNguyên Giám đốc Bệnh viện Nhi trung ương\u003cbr /\u003eChủ tịch danh dự Hội Nhi khoa Việt Nam\u003c/em\u003e\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/4a/f7/18/347ab92f9614c5c05832e76fc24cd7cf.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/4a/f7/18/347ab92f9614c5c05832e76fc24cd7cf.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/4a/f7/18/347ab92f9614c5c05832e76fc24cd7cf.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4a/f7/18/347ab92f9614c5c05832e76fc24cd7cf.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4a/f7/18/347ab92f9614c5c05832e76fc24cd7cf.jpg"},{"base_url":"https://salt.tikic