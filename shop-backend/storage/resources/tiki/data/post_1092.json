b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/0e/3d/c7/453eff3122e8fece795ec207e9eee6ba.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":650,"all_time_quantity_sold":19,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<article class=\"4ever-article\">\n<h3>Giới thiệu</h3>\n<p>Duo 6 với thiết kế độc đáo, nhỏ gọn và tiện lợi, tích hợp rất nhiều chức năng: tiệt trùng, hâm sữa, hâm thức ăn, hâm nóng nhanh, rã đông ngoài ra máy còn có chức năng hẹn giờ để hoạch định trước thời gian và cả đèn LED ban đêm cho mẹ.</p>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/3b/67/53/e821bf81eaf46949cae0158fde24c44b.jpg\" alt=\"3b6753a2f95f0bea1e08258ba7a68503.jpg\" /> </p>\n<h3>Thiết kế và công dụng</h3>\n</article>\n<article class=\"4ever-article\">\n<ul>\n<li>Vật liệu nhựa cao cấp &amp; an toàn cho bé: bình đun và nắp bình được làm từ nhựa polypropylene không chứa BPA</li>\n</ul>\n<p> </p>\n<p><img src=\"https://salt.tikicdn.com/ts/tmp/60/13/a8/36d0cda4a5c74eeff4819b592ac5266c.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<ul>\n<li>Bảng điều khiển LED kích thước lớn với các nút cảm ứng: màn hình hiện đại hiển thị nhiệt độ với các nút nhấn điều khiển cảm ứng vô cùng nhạy, khiến mẹ thực hiện các thao tác chỉ trong tích tắc.</li>\n</ul>\n</article>\n<article class=\"4ever-article\"><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/2e/d2/c2/e8f19b9036d81e826b3e25e30fbdcb42.jpg\" alt=\"2ed2c2fc8f84f1d591a2da09bd443bcb.jpg\" width=\"750\" height=\"750\" /> \n<ul>\n<li>Hiển thị nhiệt độ thực tế trong khoang hâm nóng : đây cũng là một trong những điểm mạnh của dòng máy này. Mẹ hoàn toàn có thể check được nhiệt độ của sữa đã đạt yêu cầu hay chưa.</li>\n</ul>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/6a/30/2a/a2a75affa915d0f3df5e43cde6596e3c.jpg\" alt=\"6a302a005b9ef284360d3e8e88cbdbb5.jpg\" width=\"750\" height=\"750\" /> </p>\n<ul>\n<li>Thiết kế  2 bình cổ rộng</li>\n<li>Giá đỡ ngăn cách đế đun nóng, tiện lợi khi nhấc bình sữa ra khỏi máy.</li>\n<li>Tự động tắt sau khi hết nước.</li>\n</ul>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/69/be/7d/f10512599dbdf9432609412767af2c8a.jpg\" alt=\"69be7de3474f96935f36ca441d73e91d.jpg\" /> </p>\n<p>Tích hợp 6 chức năng:</p>\n<p>1. Hâm nóng sữa chế độ chậm bằng cơ chế hâm nóng điều nhiệt thích hợp hâm nóng sữa ở nhiệt độ thường:</p>\n<p>2. Hâm nước pha sữa công thức</p>\n<p>3. Rã đông</p>\n<p>4. Chức năng hâm nóng nhanh</p>\n<p>5. Hâm thức ăn</p>\n<p>6.Tiệt trùng bằng hơi nước</p>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/0e/3d/c7/54e78907e19d8982c0c1584ad40f50e3.jpg\" alt=\"0e3dc743cb3249c62c6ea974130b0cfc.jpg\" /> </p>\n<ul>\n<li>Tích hợp chức năng hẹn giờ:  </li>\n<li>Cài đặt hẹn giờ được sử dụng khi người dùng muốn hoạch đinh sẵn việc đun nóng/tiệt trùng ở một thời gian xác định trong ngày. Điều này sẽ rất hữu ích khi cần hâm nóng sữa/thức ăn từ ngăn đông hay ngăn lạnh để sữa/thức ăn rã đông từ từ ở nhiệt độ thường trước khi hâm nóng.</li>\n<li>Máy được trang bị đèn LED để giúp mẹ pha sữa ban đêm </li>\n</ul>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/5e/48/b1/18a0e5d744aadd2a2b2352b6b10256f0.jpg\" alt=\"5e48b1edf9c3f5731027e3cd0b074c2e.jpg\" width=\"750\" height=\"750\" /> </p>\n<h3>Thông số kĩ thuật</h3>\n<ul>\n<li>Nguồn điện: AC 220V-240 V, 50/60 Hz;</li>\n<li>Công suất : 270 W;</li>\n<li>Dung tích : 2 bình cổ rộng;</li>\n<li>Màu sắc: Ghi trắng</li>\n<li>Sản xuất tại Trung Quốc</li>\n</ul>\n<p> </p>\n<h3>Thông tin bảo hành</h3>\n<ul>\n<li>Bảo hành 12 tháng</li>\n</ul>\n</article><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/0e/3d/c7/453eff3122e8fece795ec207e9eee6ba.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0e/3d/c7/453eff3122e8fece795ec207e9eee6ba.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/0e/3d/c7/453eff3122e8fece795ec207e9eee6ba.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0e/3d/c7/453eff3122e8fece795ec207e9eee6ba.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0e/3d/c7/453eff3122e8fece795ec207e9eee6ba.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/3b/67/53/c1925f8f82c04211719459b8d7a9e6c5.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/3b/67/53/c1925f8f82c04211719459b8d7a9e6c5.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/3b/67/53/c1925f8f82c04211719459b8d7a9e6c5.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3b/67/53/c1925f8f82c04211719459b8d7a9e6c5.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3b/67/53/c1925f8f82c04211719459b8d7a9e6c5.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/69/be/7d/79a171c97f1c0330a4606b0716319ad7.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/t