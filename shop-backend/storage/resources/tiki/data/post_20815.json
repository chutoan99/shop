iscount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/60/24/d7/88ac86651e39bd4ebd05fb161618ddb0.JPG","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":562,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align:center\"\u003e\u003cspan style=\"color:#0000ff\"\u003e\u003cstrong\u003eShop có lắp đặt tính phí(250k) tại tp. HCM . Khách CHAT với shop để hẹn giờ lắp ạ.\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"color:#333333;font-family:\u0026#39;roboto\u0026#39; , \u0026#39;helvetica neue\u0026#39; , \u0026#39;helvetica\u0026#39; , \u0026#39;arial\u0026#39; , sans-serif;font-size:13px;margin:0px 0px 10px;padding:0px;text-align:justify\"\u003e\u003cem style=\"padding:0px;margin:0px\"\u003e\u003cspan style=\"font-weight:bold;padding:0px;margin:0px\"\u003eVới khả năng tùy chỉnh mức nhiệt độ dễ dàng kết hợp đèn LED báo nước nóng sẵn sàng, ANDRIS2 RS mang đến cho người sử dụng sự tiện nghi và thoải mái bất tận. Bên cạnh đó, ANDRIS2 RS sử dụng thanh đốt 100% Đồng để mang lại hiệu quả làm nóng nhanh, chống bám cặn và bền bỉ với thời gian, hơn hẳn tiêu chuẩn phổ biến trên thị trường sử dụng thanh đốt bằng INOX/thép không gỉ (sản phẩm thông thường) với công nghệ tráng men, cho độ bền vượt trội.\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"color:#333333;font-family:\u0026#39;roboto\u0026#39; , \u0026#39;helvetica neue\u0026#39; , \u0026#39;helvetica\u0026#39; , \u0026#39;arial\u0026#39; , sans-serif;font-size:13px;margin:0px 0px 10px;padding:0px;text-align:justify\"\u003e\u003cspan style=\"font-weight:bold;padding:0px;margin:0px\"\u003eThanh đốt bằng đồng bền vượt trội\u003c/span\u003e\u003cbr style=\"padding:0px;margin:0px\" /\u003eĐồng kim loại có ưu điểm làm nóng nhanh, kéo dài tuổi thọ của thanh đốt giúp tăng hơn 50% so với thanh đốt bằng thép không gỉ thông thường. Nhờ sử dụng 100% nguyên liệu an toàn – không mạ kền, có tác dụng kháng khuẩn – thanh đốt bằng đồng đem lại nguồn nước trong lành, tốt hơn cho sức khỏe người sử dụng.\u003c/p\u003e\n\u003cp style=\"color:#333333;font-family:\u0026#39;roboto\u0026#39; , \u0026#39;helvetica neue\u0026#39; , \u0026#39;helvetica\u0026#39; , \u0026#39;arial\u0026#39; , sans-serif;font-size:13px;margin:0px 0px 10px;padding:0px;text-align:justify\"\u003e\u003cspan style=\"font-weight:bold;padding:0px;margin:0px\"\u003eELCB và bộ ổn định nhiệt điện tử TBSE\u003c/span\u003e\u003cbr style=\"padding:0px;margin:0px\" /\u003eThiết bị ổn định nhiệt giữ vai trò rất quan trọng đối với \u003cspan style=\"font-weight:bold;padding:0px;margin:0px\"\u003emáy nước nóng Ariston Andris2 RS 30\u003c/span\u003e. Bộ cảm biến đầu tiên sẽ dừng quá trình làm nóng khi nước đã đạt đến nhiệt độ mong muốn. Bộ cảm biến thứ hai sẽ tự động ngắt nguồn điện trong trường hợp nước nóng vượt quá ngưỡng nhiệt độ cao của máy để bảo đảm an toàn cho người sử dụng.\u003c/p\u003e\n\u003cp style=\"color:#333333;font-family:\u0026#39;roboto\u0026#39; , \u0026#39;helvetica neue\u0026#39; , \u0026#39;helvetica\u0026#39; , \u0026#39;arial\u0026#39; , sans-serif;font-size:13px;margin:0px 0px 10px;padding:0px;text-align:justify\"\u003e\u003cspan style=\"font-weight:bold;padding:0px;margin:0px\"\u003eĐèn báo nước nóng sẵn sàng\u003c/span\u003e\u003cbr style=\"padding:0px;margin:0px\" /\u003e\u003cspan style=\"font-weight:bold;padding:0px;margin:0px\"\u003eBình nước nóng Ariston Andris2 RS 30 lít \u003c/span\u003etrang bị đèn báo nước nóng sẵn sàng sẽ giúp bạn và người thân dễ dàng nhận biết khi nào nước đã nóng đủ độ để có thể sử dụng. Do đó, bạn sẽ tránh được tình trạng đun nước lâu quá gây hao tổn điện, hay trường hợp nước vẫn chưa nóng đủ độ dẫn đến bị lạnh khi tắm.\u003c/p\u003e\n\u003cp style=\"color:#333333;font-family:\u0026#39;roboto\u0026#39; , \u0026#39;helvetica neue\u0026#39; , \u0026#39;helvetica\u0026#39; , \u0026#39;arial\u0026#39; , sans-serif;font-size:13px;margin:0px 0px 10px;padding:0px;text-align:justify\"\u003e\u003cspan style=\"font-weight:bold;padding:0px;margin:0px\"\u003eVỏ chống thấm nước\u003c/span\u003e\u003cbr style=\"padding:0px;margin:0px\" /\u003eVỏ bình được thiết kế chống thấm nước, vì vậy bạn hoàn toàn có thể yên tâm lắp đặt trong nhà tắm. Nhờ khả năng chống thấm nên bình vận hành an toàn khi gặp độ ẩm cao, không bị rò rỉ điện ra ngoài.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/60/24/d7/88ac86651e39bd4ebd05fb161618ddb0.JPG","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/60/24/d7/88ac86651e39bd4ebd05fb161618ddb0.JPG","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/60/24/d7/88ac86651e39bd4ebd05fb161618ddb0.JPG","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/60/24/d7/88ac86651e39bd4ebd05fb161618ddb0.JPG","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/60/24/d7/88ac86651e39bd4ebd05fb161618ddb0.JPG"},{"base_url":"https://salt.tikicdn.com/ts/product/ed/48/f9/a37b91242a1ab16967fa3dd4f8753797.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ed/48/f9/a37b91242a1ab16967fa3dd4f8753797.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ed/48/f9/a37b91242a1ab16967fa3dd4f8753797.jpg","position":null,"small_url":"https