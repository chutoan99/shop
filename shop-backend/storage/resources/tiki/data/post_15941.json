olor":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":121000,"discount_rate":4,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/f3/b4/cd/c947098a2f0ff9c191e7136bfcd15193.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":628,"all_time_quantity_sold":13,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003eDung tích 1.8 lít\u003c/h3\u003e\n\u003cp\u003eNồi cơm điện nắp gài Tiger JNP-1803 có dung tích 1.8 lít, phù hợp cho gia đình có từ 4 - 6 thành viên. Nồi có màu sắc nhã nhặn, kiểu dáng hiện đại và họa tiết tươi tắn, mang lại sự sinh động cho căn bếp của gia đình bạn.\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"Nồi Cơm Điện Nắp Gài Tiger JNP-1803 - 1.8L (Hồng)\" src=\"http://tikicdn.com/media/catalog/product/j/n/jnp-1803pink_2.u2769.d20161103.t094907.768901.jpg\" alt=\"Nồi Cơm Điện Nắp Gài Tiger JNP-1803 - 1.8L (Hồng)\" width=\"650\" height=\"433\" /\u003e\u003c/p\u003e\n\u003ch3\u003eTiết kiệm thời gian khi chế biến\u003c/h3\u003e\n\u003cp\u003eSản phẩm được sản xuất bởi công nghệ Nhật Bản tiên tiến, trang bị khả năng tập trung nhiệt cao, làm nóng nhanh giúp cơm chín nhanh hơn và giúp người nội trợ vừa tiết kiệm được thời gian, vừa tiết kiệm điện tối đa khi chế biến.\u003c/p\u003e\n\u003ch3\u003eSử dụng đơn giản\u003c/h3\u003e\n\u003cp\u003eNồi cơm được được thiết kế nắp gài tiện lợi với nút nhấn cơ đơn giản, dễ dàng sự dụng. Hệ thống đèn báo khi nấu giúp người nội trợ thuận tiện trong việc kiểm soát thức ăn.\u003c/p\u003e\n\u003cp\u003eLồng nấu của nồi cơm điện Tiger JNP-1803 được tráng men chống dính cao cấp, chống bám bẩn vừa giúp các bà nội trợ dễ dàng vệ sinh nồi, vừa giúp thức ăn chính trong trạng thái tốt nhất, đảm bảo chất lượng dinh dưỡng trong thực phẩm.\u003c/p\u003e\n\u003ch3\u003eBền chắc, tiện lợi\u003c/h3\u003e\n\u003cp\u003eQuai nắp của nồi dày, chắn chắn, chịu lực tốt kèm với dây điện rời giúp nồi trở nên linh hoạt hơn, người sử dụng có thể thuận tiện di chuyển nồi khi cần thiết.\u003c/p\u003e\n\u003cp\u003eNồi còn được trang bị chế độ nấu 3 trong 1: nấu cơm, nấu cháo, hâm nóng tự động. Người sử dụng có thể tùy ý chế biến thức ăn theo ý thích của mình.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/f3/b4/cd/c947098a2f0ff9c191e7136bfcd15193.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f3/b4/cd/c947098a2f0ff9c191e7136bfcd15193.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f3/b4/cd/c947098a2f0ff9c191e7136bfcd15193.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f3/b4/cd/c947098a2f0ff9c191e7136bfcd15193.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f3/b4/cd/c947098a2f0ff9c191e7136bfcd15193.jpg"}],"warranty_policy":null,"brand":{"id":79440,"name":"Tiger","slug":"tiger"},"current_seller":{"id":18190,"sku":"6835885294244","name":"Điện máy Sài Gòn","link":"https://tiki.vn/cua-hang/dien-may-sai-gon","logo":"https://vcdn.tikicdn.com/ts/seller/4b/54/1a/f385a79a716cb3505f152e7af8c769aa.png","price":2569000,"product_id":"212568991","store_id":17567,"is_best_store":false,"is_offline_installment_supported":null}