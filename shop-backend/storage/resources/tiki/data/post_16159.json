con_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/9b/54/fa/e06188c47bf294514d83221fa03bea28.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1833,"all_time_quantity_sold":10,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003e\u003ciframe src=\"//www.youtube.com/embed/j_YM1lqjsBA\" width=\"560\" height=\"314\" allowfullscreen=\"allowfullscreen\"\u003e\u003c/iframe\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eMũ bảo hiểm nửa đầu có kính Andes 3S139\u003c/strong\u003e là sản phẩm đang được ưa thích nhất hiện nay của Andes. Andes 3S139 được cải tiến từ chiếc mũ Andes 3S181 có thiết kế kính giấu bên trong đáp ứng tiêu chí gọn – nhẹ – thoải mái phù hợp với khách hàng thường xuyên di chuyển trong thành phố.\u003c/p\u003e\n\u003cp\u003e– \u003cstrong\u003eLớp vỏ ngoài\u003c/strong\u003e của mũ bảo hiểm nửa đầu có kính Andes 3S139 được làm từ nhựa ABS nguyên sinh cho lớp vỏ cứng cáp chống va đập cực tốt. Nhựa ABS có đặc tính cứng, bền với nhiệt độ và hoá chất; tính dẻo, dai giúp đảm bảo độ an toàn khi khách hàng sử dụng trong thời gian dài.\u003c/p\u003e\n\u003cp\u003e– \u003cstrong\u003ePhần mút xốp bên trong\u003c/strong\u003e được làm từ nhựa EPS với lực nén tỷ trọng cao giúp cho xốp dày dặn và cứng cáp, đồng thời với thiết kế, kết hợp và phân bố đặc biệt giữa phần vỏ ngoài và phần mút xốp của mũ bảo hiểm Andes tạo giảm cảm giác an toàn, chắc chắn khi sử dụng. Mút xốp sẽ hấp thụ và triệt tiêu lực tác động từ vỏ mũ vào bên trong, đảm bảo an toàn tối đa cho phần đầu của người đội, hạn chế những hậu quả đáng tiếc khi có tai nạn xảy ra.\u003c/p\u003e\n\u003cp\u003e– \u003cstrong\u003eLớp vải lót 3S (sạch sẽ – sảng khoái – sức khỏe)\u003c/strong\u003e là phát minh đột phá của Andes đối với sản phẩm mũ bảo hiểm tại Việt Nam. Lớp vải lót 3S bao gồm lớp lưới thoáng khí kết hợp với lớp mút mỏng nhẹ tạo sự êm dịu cho người dùng, không gây hầm bí khi đội mũ cả ngày. Đặc biệt hơn, với công nghệ 3S cải tiến có thể tháo rời nhanh chóng và dễ dàng, giúp khử sạch ẩm mốc, mùi hôi, vi khuẩn tích tụ bên trong lòng mũ ngăn ngừa các bệnh cho da đầu: nấm tóc, rụng tóc, gàu, vảy nến,…\u003c/p\u003e\n\u003cp\u003e–  \u003cstrong\u003eKính chắn gió\u003c/strong\u003e của mũ bảo hiểm nửa đầu có kính Andes 3S139 được làm nhựa đã qua xử lý đặc biệt để đạt được độ trong suốt, không gây hại cho mắt người dùng, đồng thời kính bảo hiểm của Andes cũng có độ đàn hồi cao, không sợ bể do va đập. Ngoài ra, với khả năng chống tia UV, kính còn có khả năng chống nắng tốt bảo vệ da mặt người dùng khỏi ánh nắng gay gắt buổi ban trưa. Thêm vào đó, với thiết kế mới của mũ bảo hiểm nửa đầu có kính Andes 3S139, kính có thể tháo lắp dễ dàng bằng tay, bạn có thể tự thay thế tại nhà mà không cần bất kỳ dụng cụ hỗ trợ nào.\u003c/p\u003e\n\u003cp\u003e– \u003cstrong\u003eDây quai\u003c/strong\u003e mũ bảo hiểm Andes an toàn chắc chắn, tăng chỉnh dễ dàng để ôm sát đầu giữ mũ không bị lung lay khi có tác động cho bạn thoải mái lái xe. Phần ốp bên tai được thiết kế hở giúp thoải mái và thoáng mát khi sử dụng.\u003c/p\u003e\n\u003cp\u003e– \u003cstrong\u003eKhóa và ốc\u003c/strong\u003e được làm từ inox 304 cao cấp chống gỉ sét cực tốt, mang đến sự sang trọng đẳng cấp.\u003c/p\u003e\n\u003cp\u003eVới thiết kế hiện đại và thanh lịch, \u003cstrong\u003emũ bảo hiểm nửa đầu có kính Andes 3S139\u003c/strong\u003e sẽ là sự lựa chọn tuyệt vời cho mọi người khi phối hợp với trang phục và cả chiếc xe của mình để tạo nên một phong cách đậm chất riêng.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/3a/97/c0/da2b26bd43334767cd173ca90329413d.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/36/03/fd/7f20e005292cb3c9ccb13e7342a90565.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/7d/b3/24/74cf1c26ccb9c21dd9053c63f214a28c.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/f4/0f/88/7976b4ca2642fb141b7d13c6b63a2d27.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/9b/54/fa/e06188c47bf294514d83221fa03bea28.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/9b/54/fa/e06188c47bf294514d83221fa03bea28.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/9b/54/fa/e06188c47bf294514d83221fa03bea28.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9b/54/fa/e06188c47bf294514d83221fa03bea28.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9b/54/fa/e06188c47bf294514d83221fa03bea28.jpg"}],"warranty_policy":null,"brand":{"id":152608,"name":"Andes","slug":"andes"},"current_seller":{"id":19357,"sku":"7345131648269","name":"Nón Bảo Hiểm Halo Phượt","link":"https://tiki.vn/cua-hang/non-bao-hiem-halo-phuot","logo":"https://vcdn.tikicdn.com/ts/seller/ca/f8/f3/884dc7fda5f4b5a60bada93b1bd58082.jpg","price":349000,"prod