rị trên 1 triệu đồng).....\u003c/p\u003e\u003cp\u003eSản phẩm này là tài sản cá nhân được bán bởi Nhà Bán Hàng Cá Nhân và không thuộc đối tượng phải chịu thuế GTGT. Do đó hoá đơn VAT không được cung cấp trong trường hợp này.\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ce/b4/11/5aa6dba595c12fd2b79d79d6f8296fd4.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ce/b4/11/5aa6dba595c12fd2b79d79d6f8296fd4.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ce/b4/11/5aa6dba595c12fd2b79d79d6f8296fd4.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ce/b4/11/5aa6dba595c12fd2b79d79d6f8296fd4.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ce/b4/11/5aa6dba595c12fd2b79d79d6f8296fd4.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/0c/48/59/6f5825449e52916a025323268a514fb9.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0c/48/59/6f5825449e52916a025323268a514fb9.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/0c/48/59/6f5825449e52916a025323268a514fb9.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0c/48/59/6f5825449e52916a025323268a514fb9.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0c/48/59/6f5825449e52916a025323268a514fb9.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/df/00/9d/98df4ef79a9fea55b9e1bdd8a1b5e4b7.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/df/00/9d/98df4ef79a9fea55b9e1bdd8a1b5e4b7.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/df/00/9d/98df4ef79a9fea55b9e1bdd8a1b5e4b7.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/df/00/9d/98df4ef79a9fea55b9e1bdd8a1b5e4b7.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/df/00/9d/98df4ef79a9fea55b9e1bdd8a1b5e4b7.jpg"