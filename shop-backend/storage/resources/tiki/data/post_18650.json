 đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/6d/e5/84/fbe0c0c4426fd0d8957b44af6665772a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/6d/e5/84/fbe0c0c4426fd0d8957b44af6665772a.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/6d/e5/84/fbe0c0c4426fd0d8957b44af6665772a.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6d/e5/84/fbe0c0c4426fd0d8957b44af6665772a.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6d/e5/84/fbe0c0c4426fd0d8957b44af6665772a.jpg"}],"warranty_policy":null,"authors":[{"id":4043,"name":".","slug":""}],"current_seller":{"id":57650,"sku":"4357937712332","name":"Nhà sách Mạnh Hùng","link":"https://tiki.vn/cua-hang/nha-sach-manh-hung","logo":"52/ba/4d/d9373035d8965d150ae8fccbb74d5692.jpg","price":45000,"product_id":"207811978","store_id":54526,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Thông tin chung","attributes":[{"code":"publisher_vn","name":"Công ty phát hành","value":"Nhà sách Sao Mai"},{"code":"publication_date","name":"Ngày xuất bản","value":"2017-01-01 00:00:00"},{"code":"dimensions","name":"Kích thước","value":"14.5 x 20.5 cm"},{"code":"book_cover","name":"Loại bìa","value":"Bìa mềm"},{"code":"number_of_page","name":"Số trang","value":"334"},{"code":"manufacturer","name":"Nhà xuất bản","value":"Nhà Xuất Bản Đại Học Quốc Gia Hà Nội"}]}],"product_links":[],"gift_item_title":"0 quà tặng kèm","services_and_promotions":[],"promitions":[],"stock_item":{"max_sale_qty":1000,"min_sale_qty":1,"preorder_date":null,"qty":1000},"quantity_sold":{"text":"Đã bán 35","value":35},"categories":{"id":2,"name":"Root","is_leaf":false},"breadcrumbs":[{"url":"/nha-sach-tiki/c8322","name":"Nhà Sách Tiki","category_id":8322},{"url":"/sach-truyen-tieng-viet/c316","name":"Sách tiếng Việt","category_id":316},{"url":"/sach-tham-khao/c2320","name