, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/0c/9b/cd/b423dc2f0d09e9c24bd89a28f2a18804.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0c/9b/cd/b423dc2f0d09e9c24bd89a28f2a18804.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/0c/9b/cd/b423dc2f0d09e9c24bd89a28f2a18804.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0c/9b/cd/b423dc2f0d09e9c24bd89a28f2a18804.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0c/9b/cd/b423dc2f0d09e9c24bd89a28f2a18804.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/7c/86/0a/f45b2f4291e37623f5c473b4a280e93a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/7c/86/0a/f45b2f4291e37623f5c473b4a280e93a.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/7c/86/0a/f45b2f4291e37623f5c473b4a280e93a.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7c/86/0a/f45b2f4291e37623f5c473b4a280e93a.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7c/86/0a/f45b2f4291e37623f5c473b4a280e93a.jpg"},{"base_url":"https://salt.tikicdn.com/media/catalog/producttmp/eb/55/24/afe7cf7ed537f2c12bb8c6aad6dc0877.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/producttmp/eb/55/24/afe7cf7ed537f2c12bb8c6aad6dc0877.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/producttmp/eb/55/24/afe7cf7ed537f2c12bb8c6aad6dc0877.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/producttmp/eb/55/24/afe7cf7ed537f2c12bb8c6aad6dc0877.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/producttmp/eb/55/24/afe7cf7ed537f2c12bb8c6aad6dc0877.jpg"},{"base_url":"https://salt.tikicdn.com/media/catalog/producttmp/b