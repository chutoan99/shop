_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":205000,"discount_rate":35,"rating_average":4.8,"review_count":29,"review_text":"(29)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/54/1f/3e/58d6d4b3e9ec7ade27d931f84299f16c.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1869,"all_time_quantity_sold":140,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"box-sizing: border-box; margin: 0px 0px 10px; padding: 0px; color: #333333; font-family: Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e\u003cspan style=\"box-sizing: border-box; margin: 0px; padding: 0px; font-weight: bold;\"\u003eKem kiểm soát dầu và điều tiết nhờn \u003c/span\u003e\u003cstrong\u003eFloslek\u003c/strong\u003e \u003cspan style=\"box-sizing: border-box; margin: 0px; padding: 0px; font-weight: bold;\"\u003ePharma Mattifying Cream\u003c/span\u003e thuộc dòng sản phẩm ngừa mụn Anti Acne của thương hiệu Floslek. Floslek Pharma Mattifying Cream chứa chiết xuất cải xoong, rễ ngưu bàng, cây xô thơm, vỏ chanh vàng, thường xuân, tảo gạc hươu và nhiều thành phần thiên nhiên khác giúp da láng mịn, điều tiết lượng dầu và nước trên da, kiểm soát bã nhờn, cho làn da ẩm mượt, mịn màng và không bóng nhờn. Đồng thời kem có tác dụng làm se da, kháng khuẩn, chống ngứa và chống viêm da, ngăn hình thành tổn thương da, không gây bí hay tắc lỗ chân lông, trả lại cho bạn làn da khỏe mạnh và mịn màng. Sản phẩm phù hợp với da dầu và hỗn hợp.\u003c/p\u003e\n\u003ch3 style=\"box-sizing: border-box; margin: 20px 0px 10px; padding: 0px; font-family: Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif; font-weight: 500; line-height: 1.1; color: #333333; text-align: justify; font-size: 15px !important;\"\u003e\u003cspan style=\"box-sizing: border-box; margin: 0px; padding: 0px; font-weight: bold;\"\u003eHướng dẫn sử dụng và bảo quản\u003c/span\u003e\u003c/h3\u003e\n\u003cul style=\"box-sizing: border-box; margin: 0px 0px 10px; padding: 0px 0px 0px 15px; color: #333333; font-family: Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 13px; list-style-position: initial !important; list-style-image: initial !important;\"\u003e\n\u003cli style=\"box-sizing: border-box; margin: 0px; padding: 0px; text-align: justify;\"\u003eLấy một lượng nhỏ kem thoa đều lên mặt và cổ\u003c/li\u003e\n\u003cli style=\"box-sizing: border-box; margin: 0px; padding: 0px; text-align: justify;\"\u003eTập trung ở vùng có nhiều mụn trứng cá như trán, cằm, mũi\u003c/li\u003e\n\u003cli style=\"box-sizing: border-box; margin: 0px; padding: 0px; text-align: justify;\"\u003eSử dụng 2 - 3 lần/ngày\u003c/li\u003e\n\u003cli style=\"box-sizing: border-box; margin: 0px; padding: 0px; text-align: justify;\"\u003eBảo quản nơi khô ráo, thoáng mát, tránh ánh nắng trực tiếp và nhiệt độ cao\u003c/li\u003e\n\u003cli style=\"box-sizing: border-box; margin: 0px; padding: 0px; text-align: justify;\"\u003eĐể xa tầm tay trẻ em\u003cbr /\u003e\u003cbr /\u003e\u003cem\u003e\u003cstrong\u003e**Bao bì sản phẩm có thể khác nhau theo từng lô nhập hàng\u003c/strong\u003e\u003c/em\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3 style=\"box-sizing: border-box; margin: 20px 0px 10px; padding: 0px; font-family: Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif; font-weight: 500; line-height: 1.1; color: #333333; text-align: justify; font-size: 15px !important;\"\u003e\u003cspan style=\"box-sizing: border-box; margin: 0px; padding: 0px; font-weight: bold;\"\u003eThông tin thương hiệu\u003c/span\u003e\u003c/h3\u003e\n\u003cp style=\"box-sizing: border-box; margin: 0px 0px 10px; padding: 0px; color: #333333; font-family: Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003eViện nghiên cứu mỹ phẩm Floslek được thành lập năm 1994, chuyên sản xuất các sản phẩm chăm sóc da và làm đẹp. Sau hơn 20 năm hình thành và phát triển, Floslek đã sản xuất hơn 200 loại mỹ phẩm với nhiều dòng sản phẩm đa dạng, đáp ứng được các nhu cầu về độ tuổi, chủng loại và loại da, kể cả làn da nhạy cảm của trẻ nhỏ. Sản phẩm được sản xuất từ các hoạt chất thiên nhiên, dựa trên những công thức cải tiến và dây chuyền công nghệ hiện đại nên có tính hiệu quả và an toàn cao. Floslek đã có mặt tại các nhà thuốc và cửa hàng mỹ phẩm ở nhiều nước trên thế giới.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/54/1f/3e/58d6d4b3e9ec7ade27d931f84299f16c.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/54/1f/3e/58d6d4b3e9ec7ade27d931f84299f16c.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/54/1f/3e/58d6d4b3e9ec7ade27d931f84299f16c.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/54/1f/3e/58d6d4b3e9ec7ade27d931f84299f16c.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/54/1f/3e/58d6d4b3e9ec7ade27d931f84299f