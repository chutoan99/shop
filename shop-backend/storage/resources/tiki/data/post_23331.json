duct/17/66/1d/11fd634cec0099e54c3cfd2e97211f35.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/17/66/1d/11fd634cec0099e54c3cfd2e97211f35.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/c4/25/22/28c570c3e35181b80630ff562b4393ab.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c4/25/22/28c570c3e35181b80630ff562b4393ab.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c4/25/22/28c570c3e35181b80630ff562b4393ab.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c4/25/22/28c570c3e35181b80630ff562b4393ab.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c4/25/22/28c570c3e35181b80630ff562b4393ab.jpg"}],"warranty_policy":null,"brand":{"id":148561,"name":"Edena","slug":"edena"},"current_seller":{"id":140698,"sku":"8457937707358","name":"Nệm Thanh Như","link":"https://tiki.vn/cua-hang/nem-thanh-nhu","logo":"c4/a9/bb/b6cea9650ed947f37843ecb1dc810840.png","price":450000,"product_id":"146499429","store_id":129908,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Content","attributes":[{"code":"brand","name":"Thương hiệu","value":"Edena"},{"code":"brand_country","name":"Xuất xứ thương hiệu","value":"Việt Nam"},{"code":"chat_lieu","name":"Chất liệu","value":"\u003cp\u003eGòn tơ tằm và gòn Micro Fiber cao cấp\u003c/p\u003e"},{"code":"huong_dan_bao_quan","name":"Hướng dẫn bảo quản","value":"\u003ch3\u003e\u003cspan style=\"font-size: 14px;\"\u003eCác sản phẩm chăn nệm ra gối ngủ của Edena được cam kết không bị đổ lông và phai màu sau thời gian sử dụng nếu tuân thủ theo các yêu cầu sau:\u003c/span\u003e\u003c/h3\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cdiv class=\"scrollA\"\u003e\n\u003cdiv class=\"content-text\"\u003e\n\u003cp\u003e\u003cstrong\u003eNÊN:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Giặt trước khi sử dụng, ngâm bộ ra vào nước lạnh, xả 2-3 nước cho sạch, không sử dụng bột giặt cho lần giặt đầu tiên.\u003c/p\u003e\n\u003cp\u003e- Ngâm nước lạnh 3-4 tiếng, sau đó bỏ xà phòng vào giặt ngay cho các lần giặt tiếp theo.\u003c/p\u003e\n\u003cp\u003e- Có thể giặt hấp, giặt tay hoặc sử dụng máy giặt ở chế độ nhẹ nhất (dành cho vải mềm)\u003c/p\u003e\n\u003cp\u003e- Phơi ở nơi khô thoáng, tránh phơi dưới nắng mặtg trời quá gắt.\u003c/p\u003e\n\u003cp\u003e- Ủi chăn ra sau khi phơi ở nhiệt độ trung bình.\u003c/p\u003e\n\u003cp\u003e- Khi chưa sử dụng, nên gấp gọn và cất vào vali đi kèm với sản phẩm và bảo quản ở nơi thoáng khí, tránh ẩm mốc.\u003c/p\u003e\n\u003cp\u003e- Vệ sinh bụi trên bề mặt ra phủ thường xuyên để tránh bụi bẩn bám vào ảnh hưởng đến hô hấp.\u003c/p\u003e\n\u003cp\u003e- Đối với trường hợp giường ngủ buộc phải đặt gần cửa sổ, nên lắp rèm/màn cửa để hạn chế ánh nắng mặt trời chiếu trực tiếp vào sản phẩm.\u003cbr /\u003e\u003cbr /\u003e\u003cstrong\u003eKHÔNG NÊN:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Ngâm bộ ra với xà phòng (bột giặt) quá lâu, các chất tẩy mạnh trong bột giặt sẽ làm bay màu sản phẩm.\u003c/p\u003e\n\u003cp\u003e- Giặt chế độ mạnh hoặc dùng bàn chải đối với những sản phẩm cotton cao cấp như satin hay tencel\u003c/p\u003e\n\u003cp\u003e- Để các vật sắc nhọn hoặc các quần áo có nút bằng kim loại tiếp xúc với bề mặt bộ chăn ra.\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003e\u003cbr /\u003e\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e"},{"code":"huong_dan_su_dung","name":"Hướng dẫn sử dụng","value":"\u003cp style=\"text-align: justify;\"\u003e- Để ruột gối ngủ kéo dài thời gian sử dụng và hạn chế bị hư tổn sản phẩm, quý khách vui lòng chú ý một số hướng dẫn sau:\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e- Nên nhồi đều bằng tay để tơ tằm bên trong gối ngủ được phân bố đều khắp nơi, đặc biệt là khi vừa mua sản phẩm sử dụng.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e- Hạn chế tiếp xúc các chất bẩn, chất tạo màu lên trên gối ngủ.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e- Thường xuyên giũ bụi bẩn để đảm bảo ruột gối ngủ luôn sạch sẽ.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e- Khi giặt giũ vệ sinh, nên vò nhẹ và nhanh trong nước giặt pha loãng với nước, ép mạnh và phơi khô tại nơi có ánh sáng mặt trời yếu, hoặc bằng máy giặt. Không sấy sản phẩm bằng máy sấy.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eHƯỚNG DẪN ĐẶC BIỆT CHO HÀNG TENCEL:\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e- Cách tốt nhất là nên giặt hấp.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e- Hoặc có thể: giặt tay, giặt máy phải sử dụng \u003cstrong\u003etúi giặt đặc biệt\u003c/strong\u003e của Edena để bảo quản sản phẩm\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e- Xà phòng sử dụng tốt nhất khi giặt tay, giặt máy là dầu gội (hoặc phải sử dụng xà phòng không có chất tẩy)\u003c/p\u003e"},{"code":"item_model_number","name":"Model","value":"2021"},{"code":"kich_thuoc","name":"Kích thước (Dài x Rộng x Cao)","value":"45 x 65 cm"},{"code":"material","name":"Chất liệu","value":"Microfiber"},{"code":"origin","name":"Xuất xứ (Made in)","value":"Việt Nam"},{"code":"product_weight","name":"Trọng lượng sản phẩm","value":"1,5 kg"}]},{"name":"Operation","attributes":[{"code":"is_warranty_applied","name":"Sản phẩm có được bảo hành không?","value":"Không"}]}],"product_links":[],"gift_item_title":"0 quà tặng kèm","services_and_promotions":[],"promitions":[],"stock_item":{"max_sale_qty":1000,"min_sale_qty":1,"preorder_date":null,"qty":1000},"quantity_sold":{"text":"Đã bán 6","value":6},"categories":{"id":1883,"name":"Nhà Cửa - Đời Sống","is_leaf":false},"breadcrumbs":[{"url":"/nha-cua-doi-song/c1883","name":"Nhà Cửa - Đời Sống","category_id":1883},{"url":"/do-dung-phong-ngu/c8313","name":"Đồ dùng phòng ngủ","category_id":8313},{"url":"/ruot-goi-ruot-chan/c6724","name":"Gối, ruột gối, vỏ gối","category_id":6724},{"url":"/ruot-goi/c23366","nam