83596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":141000,"discount_rate":31,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/4b/e4/b0/d23ee679215f84985ad40984fecb13f4.jpeg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1140,"all_time_quantity_sold":3,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e+ Thương hiệu: Caryophy\u003c/p\u003e\n\u003cp\u003e+ Xuất xứ: Hàn Quốc\u003c/p\u003e\n\u003cp\u003e️ =\u0026gt; Kem chống nắng Caryophy có chỉ số chống nắng SPF50+/PA+++ bảo vệ da trước tác hại của ánh nắng mặt trời, có khả năng chống thấm nước cao, nâng tone nhẹ cho làn da và đặc biệt hỗ trợ ngăn ngừa mụn giảm thâm hiệu quả\u003c/p\u003e\n\u003cdiv class=\"syl-image-wrapper\"\u003e\u003cimg src=\"https://p16-oec-va.ibyteimg.com/tos-maliva-i-o3syd03w52-us/cd60eba7606f41ef81656a5e3560dd4d~tplv-o3syd03w52-origin-jpeg.jpeg\" width=\"1024\" height=\"1024\" alt=\"cd60eba7606f41ef81656a5e3560dd4d~tplv-o3syd03w52-origin-jpeg.jpeg\" /\u003e\u003c/div\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003eCông dụng nổi bật\u003c/strong\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e️+ Là dòng kem chống nắng vật lý giúp bảo vệ da khỏi cả tia UVA và UVB, đồng thời giúp phân hủy các gốc tự do do tia UV tạo ra\u003c/p\u003e\n\u003cp\u003e+️ Khả năng chống tia cực tím không gây kích ứng hỗ trợ ngăn ngừa các dấu hiệu lão hóa lớn nhất, bao gồm cả sự xỉn màu và khô da\u003c/p\u003e\n\u003cp\u003e+️ Khả năng nâng tone tự nhiên giúp da trắng hồng rạng rỡ\u003c/p\u003e\n\u003cp\u003e️+ Caryophy Smart Sunscreen có hiệu quả vượt trội trong việc dưỡng trắng da và chống oxy hoá\u003c/p\u003e\n\u003cp\u003e️+ Đặc điểm nổi bật là có thể sử dụng hàng ngày giống như các loại kem dưỡng da mà không gây nặng mặt, khó chịu\u003c/p\u003e\n\u003cp\u003e️+ Kết cấu mỏng nhẹ, không để lại các vệt trắng trên da, có thể sử dụng hàng ngày\u003c/p\u003e\n\u003cp\u003e️+ Thành phần từ thiên nhiên an toàn và lành tính cho mọi làn da\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003eThành phần chính\u003c/strong\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e+ Chiết xuất củ dền đỏ: giúp làm giảm nguy cơ thiếu hụt vitamin D, ngừa các bệnh về da như vảy nến, bệnh khô da, mất cân bằng lượng da chết\u003c/p\u003e\n\u003cp\u003e️+ Repair Complex CLR (Bifida Ferment Lysate): giúp ngăn chặn sự mất cân bằng của hệ thống miễn dịch bị phá vỡ và tổn thương bởi tia UV\u003c/p\u003e\n\u003cp\u003e️+ Chiết xuất nho: có hiệu quả vượt trội trong việc dưỡng trắng da và chống oxy hoá\u003c/p\u003e\n\u003cp\u003e+️ Chiết xuất rau má (Centella Asiatica Extrac): hỗ trợ phục hồi và tái tạo lại làn da bị tổn thương, ngoài ra còn có khả năng chống oxy hoá và bảo vệ da, đồng thời cung cấp độ ẩm cho làn da\u003c/p\u003e\n\u003cp\u003e️+ Chiết xuất rau sam (Portulaca Oleracea Extract): giúp làm giảm sự kích ứng, cung cấp độ ẩm cho da, giúp làm da khoẻ mạnh, ẩm mịn hơn\u003c/p\u003e\n\u003cp\u003e*** Ngoài ra, Caryophy Smart Sunscreen Tone Up cũng chứa những thành phần liên quan đến Portulaca như sau: Glycerin, Butylene Glycol, Beta-Glucan, Hyaluronic Acid, Betaine salicylate\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003eHướng dẫn sử dụng\u003c/strong\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e️+ Thoa kem chống nắng lên vùng da cần bảo vệ khoảng 20 – 30 phút trước khi ra nắng\u003c/p\u003e\n\u003cp\u003e️+ Nếu không make up: Sau tất cả các bước dưỡng da, thoa kem chống nắng Caryophy một lớp mỏng vào buổi sáng\u003c/p\u003e\n\u003cp\u003e+️ Nếu có make up: Bạn bôi kem chống nắng Caryophy trước khi dùng kem lót\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/4b/e4/b0/d23ee679215f84985ad40984fecb13f4.jpeg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/4b/e4/b0/d23ee679215f84985ad40984fecb13f4.jpeg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/4b/e4/b0/d23ee679215f84985ad40984fecb13f4.jpeg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4b/e4/b0/d23ee679215f84985ad40984fecb13f4.jpeg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4b/e4/b0/d23ee679215f84985ad40984fecb13f4.jpeg"},{"base_url":"https://salt.tikicdn.com/ts/product/e9/db/8c/dc78a7935cb05f8348703ea899b5af41.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e9/db/8c/dc78a7935cb05f8348703ea899b5af41.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e9/db/8c/dc78a7935cb05f8348703ea899b5af41.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e9/db/8c/dc78a7935cb05f8348703ea899b5af41.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e9/db/8c/dc78a7935cb05f8348703ea899b5af41.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/4c/50/08/bc5d1473b997cf1b326e780117df065b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/4c/50/08/bc5d1473b997cf1b326e780117df065b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/4c/50/08/bc5d1473b997cf1b326e780117df06