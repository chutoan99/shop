ớc ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/87/12/80/5160f2f85240a264dba9c35608afb5e2.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/87/12/80/5160f2f85240a264dba9c35608afb5e2.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/87/12/80/5160f2f85240a264dba9c35608afb5e2.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/87/12/80/5160f2f85240a264dba9c35608afb5e2.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/87/12/80/5160f2f85240a264dba9c35608afb5e2.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/a8/ff/7d/d5b3d3c947271edbd801fe362eb4e8be.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a8/ff/7d/d5b3d3c947271edbd801fe362eb4e8be.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a8/ff/7d/d5b3d3c947271edbd801fe362eb4e8be.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a8/ff/7d/d5b3d3c947271edbd801fe362eb4e8be.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a8/ff/7d/d5b3d3c947271edbd801fe362eb4e8be.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/1b/b7/21/f286896e11959a278bc957e8ea781a95.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/1b/b7/21/f286896e11959a278bc957e8ea781a95.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/1b/b7/21/f286896e11959a278bc957e8ea781a95.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1b/b7/21/f286896e11959a278bc957e8ea781a95.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1b/b7/21/f286896e11959a278bc957e8ea781a95.jpg"}],"warranty_policy":null,"brand":{"id":158953,"name":"XOX","slug":"xox"},"current_seller":{"id":1892,"sku":"1908536999845","name":"Binaishop","link":"https://tiki.vn/cua-hang/binaishop","log