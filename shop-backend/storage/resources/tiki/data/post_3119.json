ext_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.6,"review_count":64,"review_text":"(64)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/29/3b/ec/3e07ba700195fdfbc028d399f8ed788e.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1449,"all_time_quantity_sold":312,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eGiới thiệu về phin nhôm Trung Nguyên\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003ePhin nhôm cao cấp Trung Nguyên được sản xuất dựa trên tiêu chuẩn kỹ thuật của các chuyên gia cà phê để tạo ra những ly cà phê tuyệt hảo. Phin nhôm cao cấp dành pha cà phê là một vật dụng không thể thiếu đối với những người yêu – đam mê cà phê.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/9a/32/09/2a3cadf120cba3ca921ae7af76d1e7c5.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eChất liệu của phin cũng rất quan trọng, phổ biến hiện giờ thì có phin nhôm và phin inox. Phin nhôm cao cấp Trung Nguyên, chiếc phin rất đặc biệt từ đường nét và hoa văn được in lên vỏ phin. Từ lá cafe tới hình trống đồng đông sơn thể hiện được tính truyền thống của Việt Nam.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThông tin chi tiếp:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eChất liệu nhôm tốt nhất. Vì nó có có thể giữ nhiệt tốt hơn các chất liệu khác và không gây hại tới sức khỏe khi sử dụng.\u003c/p\u003e\n\u003cp\u003eThể tích đạt tiêu chuẩn của phin 170 ml, số lượng lỗ trên thân phin, đĩa phin bằng nhau và phân bổ đồng đều để cà phê có thể lọc tốt hơn.\u003c/p\u003e\n\u003cp\u003eKích thước lỗ tương thích với kích thước hạt cafe xay, đạt tiêu chuẩn 50-60 giọt cafe/1 phút\u003c/p\u003e\n\u003cp\u003eLỗ trên thân gài cũng được phân bổ đồng đều và có mật độ dày hơn mật độ lỗ trên thân phin và đĩa phin để nước thấm xuống cà phê tốt hơn\u003c/p\u003e\n\u003cp\u003eCó vạch định mức trong thân phin để định lượng 25gr cà phê / tách\u003c/p\u003e\n\u003cp\u003eKích thước: cụ thể được ghi trên hình sản phẩm\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/07/fa/86/3fbefc65652e5df52f91aafaab5387fb.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003eThông số sản phẩm phin nhôm cao cấp.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003eĐể có một ly cà phê thơm ngon chuẩn vị cà phê - Hãy chọn lựa cho mình một chiếc phin tốt nhất và đẹp nhất. Bạn sẽ thấy hương vị khác biệt.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/29/3b/ec/3e07ba700195fdfbc028d399f8ed788e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/29/3b/ec/3e07ba700195fdfbc028d399f8ed788e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/29/3b/ec/3e07ba700195fdfbc028d399f8ed788e.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/29/3b/ec/3e07ba700195fdfbc028d399f8ed788e.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/29/3b/ec/3e07ba700195fdfbc028d399f8ed788e.jpg"},{"base_url":"https://salt.tikicdn.com/ts/pr