,{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":960000,"discount_rate":39,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/6f/7d/c5/d19b53b054301826156a0731482750d6.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":776,"all_time_quantity_sold":7,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eTÍNH NĂNG NỔI BẬT UBOOM L\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eChiếc loa di động tiếp theo của hãng EarFun sau sự thành công của dòng UBOOM\u003c/li\u003e\n\u003cli\u003eĐược chỉnh âm bởi chuyên gia âm thanh Oluv nổi tiếng\u003c/li\u003e\n\u003cli\u003eSử dụng 2 màng loa tăng trầm cùng 2 màng rung thụ động cho một chất âm mạnh mẽ, bùng nổ\u003c/li\u003e\n\u003cli\u003eCó khả năng kết nối nhiều loa để tạo thành hệ thống stereo\u003c/li\u003e\n\u003cli\u003eKháng nước và bụi chuẩn cao IP67, sẵn sàng cho bất cứ cuộc đi chơi nào\u003c/li\u003e\n\u003cli\u003eThời lượng sử dụng 16 tiếng và sạc lại bằng cổng USB Type-C\u003c/li\u003e\n\u003cli\u003eTích hợp microphone để đàm thoại, nói chuyện với trợ lý ảo\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e \u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cstrong\u003eLOA DI ĐỘNG TIỆC TÙNG EARFUN UBOOM L\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cstrong\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/a3/27/5c/7b1e4848b58dc6e6074ecd9603c2d5bb.jpg\" alt=\"\" width=\"750\" height=\"422\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eÂm thanh bùng nổ với 2 màng loa, tinh chỉnh bởi chuyên gia Oluv\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eDựa trên sự thành công của dòng loa đầu tay EarFun UBOOM, hãng điện tử Trung Quốc tiếp tục ra mắt người dùng dòng loa tiếp theo của mình mang tên UBOOM L. Chiếc loa này có sự nâng cấp mạnh mẽ về chất lượng âm thanh, khi được tinh chỉnh bởi Olaf Lubanski (Oluv) là một nhà sáng tác nhạc và cũng rất đam mê âm thanh đến từ châu Âu.\u003c/p\u003e\n\u003cp\u003eLoa được trang bị 2 màng loa 55mm để đem tới công suất 28mm trang bị công nghệ JumboBass để tăng lượng âm trầm. 2 bên loa cũng có thêm 2 màng rung thụ động để bất cứ bài nhạc nào được phát qua EarFun UBOOM L cũng trở nên mạnh mẽ, sôi động.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/64/03/ba/2306e763688c177578b0bf7339b3a015.jpg\" alt=\"\" width=\"600\" height=\"400\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThiết kế để sử dụng ở bất cứ nơi đâu\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eUBOOM L là một chiếc loa di động được thiết kế để sử dụng ở bất cứ nơi đâu. Đây là lý do loa được trang bị 3 chế độ âm thanh là Trong nhà, Xem phim và Ngoài trời để có âm thanh phù hợp nhất với các trường hợp sử dụng khác nhau. Bên cạnh đó là chuẩn kháng nước và bụi IP67 để loa không bị hỏng hóc, dù trong các điều kiện thời tiết khắc nghiệt nhất.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/d7/ab/9e/f8db7364a983169363eb051e795bf335.jpg\" alt=\"\" width=\"750\" height=\"562\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThời lượng sử dụng 16 tiếng, khả năng ghép stereo\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eBên cạnh các tính năng mạnh mẽ về chất âm và độ bền, EarFun UBOOM L cũng được trang bị thời lượng sử dụng lâu dài tới 16 tiếng để giảm thời gian phải cắm sạc, thêm thời gian thưởng thức âm nhạc. Bên cạnh đó là khả năng ghép đôi stereo với loa tương để để mở rộng không gian âm nhạc hoặc tạo thành hệ thống loa stereo cho máy tính.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTHÔNG SỐ KỸ THUẬT:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e2 màng loa tăng trầm 55mm\u003c/li\u003e\n\u003cli\u003e2 màng rung thụ động\u003c/li\u003e\n\u003cli\u003eChuẩn Bluetooth 5.0\u003c/li\u003e\n\u003cli\u003eDải tần 20Hz - 20kHz\u003c/li\u003e\n\u003cli\u003eDung lượng pin 2 x 2600mAH\u003c/li\u003e\n\u003cli\u003eThời lượng sử dụng 16 tiếng\u003c/li\u003e\n\u003cli\u003eKích thước 78mm x 210mm x 72mm\u003c/li\u003e\n\u003cli\u003eTrọng lượng 650g\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/6f/7d/c5/d19b53b054301826156a0731482750d6.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/6f/7d/c5/d19b53b054301826156a0731482750d6.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/6f/7d/c5/d19b53b054301826156a0731482750d6.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6f/7d/c5/d19b53b054301826156a0731482750d6.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6f/7d/c5/d19b