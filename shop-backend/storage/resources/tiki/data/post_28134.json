count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/93/90/b2/9cf227208efaaf1dbb5a8738bc85a31d.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1058,"all_time_quantity_sold":16,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eThông điệp bộ truyện là bài học về Tình Yêu Thương trên nền tảng Hiểu Biết Sâu Sắc. Qua các tập truyện, những suy ngẫm về tình bạn, về lời dạy của\u003cem class=\"Highlight\" style=\"padding: 1px; box-shadow: #e5e5e5 1px 1px; border-radius: 3px; -webkit-print-color-adjust: exact; background-color: #ffff66; color: #000000; font-style: inherit;\"\u003e Đức \u003c/em\u003ePhật sẽ gieo mầm nhân cách trong từng bạn nhỏ, nuôi dưỡng tâm hồn mỗi con người. Rồi từ đó một nhân cách mới được thành hình: Yêu thương, hiểu biết và sống tử tế hơn mỗi ngày\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTóm tắt tập 2\u003c/strong\u003e \"Những bước chân đầu tiên của sáu bạn nhỏ tại thế giới khổng lồ, nơi mà con ếch cũng trở thành \"quái vật\", những bậc thang cũng trở thành dốc núi cao vời vợi. Nhưng vì một tình yêu với gia đình, khao khát được gặp lại ba mẹ mình nên các bạn nhỏ đã cùng nhau vượt qua thử thách để giải cứu hành tinh\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTập 3\u003c/strong\u003e với chủ đề - LỜI DỰ ĐOÁN VỀ SỨ MỆNH LỚN LAO nói về sứ mệnh to lớn của vị Thầy tương lai của biệt đội Cánh Nhỏ.\u003c/p\u003e\n\u003cp\u003eThấm thoát ngày này đã đến, vị Thầy của họ đã chào đời. Trong buổi \u003cem\u003eLễ Đặt Tên\u003c/em\u003e, Thái tử được\u003cem class=\"Highlight\" style=\"padding: 1px; box-shadow: #e5e5e5 1px 1px; border-radius: 3px; -webkit-print-color-adjust: exact; background-color: #ffff66; color: #000000; font-style: inherit;\"\u003e Đức \u003c/em\u003evua đặt tên là Siddhartha Gotama. Các thầy Bà – la – môn dự đoán tương lai Thái tử có hai con đường: Trở thành Vua của các vua, hoặc trở thành thầy tu.\u003c/p\u003e\n\u003cp\u003eĐây cũng là lần đầu tiên bảy Thầy trò đồng hành cùng nhau vượt qua những hiểm nguy và thử thách của những kẻ xấu đang lên kế hoạch giết hại mình.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/c3/c0/60/af7ea24ec51c40b3e0ab0fa037eb1a30.png\" alt=\"\" width=\"750\" height=\"715\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cspan style=\"color: #ff0000;\"\u003e\u003cstrong\u003e\"Không thể nào, Tớ \u003cem class=\"Highlight\" style=\"padding: 1px; box-shadow: #e5e5e5 1px 1px; border-radius: 3px; -webkit-print-color-adjust: exact; background-color: #ffff66; color: #000000; font-style: inherit;\"\u003echắc chắn \u003c/em\u003eThầy sẽ là vua của các vị vua\"\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e \u003c/p\u003e\n\u003cp\u003eBiệt Đội Cánh Nhỏ kéo nhau đi tìm và giải cứu Thái tử một cách không thể ngoạn mục hơn. Thái tử được trao lại cho vua Suddhodana và mọi chuyện được giải quyết ổn thỏa.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/71/e0/f0/a13e36b46797487f4a4dc4e63e785552.png\" alt=\"\" width=\"750\" height=\"557\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cspan style=\"color: #ff0000;\"\u003e\u003cstrong\u003eCuộc giải cứu thái tử của đội Cánh Nhỏ và khỉ mẹ\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003eĐể giúp Thầy mình thoát khỏi âm mưu độc ác của những kẻ xấu, rùa Panna đã dùng chiếc \u003cem\u003ekhăn hoá trang\u003c/em\u003e thần thánh của mình hoá Raga thành tiên Asita\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/c0/8c/04/798156427cfc7662bee41f6af585e595.png\" alt=\"\" width=\"750\" height=\"375\" /\u003e\u003cstrong\u003e\u003cspan style=\"color: #ff0000;\"\u003eRaga đưa tay sờ lên mặt, chỉ thấy mặt mình nhẵn bóng, không hề có mắt, mũi, miệ\u003c/span\u003e\u003c/strong\u003e \u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003eThần rừng khẽ thức giấc nhìn cảnh và thốt lên: \u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\"Trên trời trăng sáng lung linh\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003eTừng đôi cánh nhỏ xinh xinh dập dìu\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003eCùng nhau khe khẽ nâng niu\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003eThiên thử khúc khích, ra chiều thích mê\" \u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/f6/65/c0/701d3335456f72b68ca9621cafe87c45.jpg\" alt=\"\" width=\"744\" height=\"731\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003eVới mong muốn truyền tải những giá trị tinh hoa qua những câu chuyện tranh kể lại cho các bạn nhỏ, nhưng cũng không mất đi tính chất của nội dung về cuộc đời\u003cem class=\"Highlight\" style=\"padding: 1px; box-shadow: #e5e5e5 1px 1px; border-radius: 3px; -webkit-print-color-adjust: exact; background-color: #ffff66; color: #000000; font-style: inherit;\"\u003e Đức \u003c/em\u003ePhật. Qua những câu chuyện tác giả muốn truyền tải đến mỗi em nhỏ có thói quen soi lại chính mình mỗi ngày từ đó rút ra được bài học cho bản thân, vững vàng trong cuộc sống hằng ngày.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003eCuối mỗi tập truyện đều có các câu hỏi rèn tư duy - quan sát - đúc kết, từ đó giúp bạn hiểu bản thân mình hơn và vun bồi tình yêu thương mỗi ngày.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/63/41/55/c22dc4d758e12ff26de4fb17aace8d3f.png\" alt=\"\" width=\"242\" height=\"136\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/93/90/b2/9cf227208efaaf1dbb5a8738bc85a31d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/93/90/b2/9cf227208efaaf1dbb5a8738bc85a31d.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/93/90/b2/9cf227208efaaf1dbb5a8738bc85a31d.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/93/90/b2/9cf227208efaaf1dbb5a8738bc85a31d.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/93/90/b2/9cf227208efaaf1dbb5a8738bc85a31d.jpg"}],"warranty_policy":null,"current_seller":{"id":256173,"sku":"6215059262251","name":"Thiện Ngôn Book","link":"https://tiki.vn/cua-hang/thien-ngon-book","logo":"01/28/f3/e22ecef32f76b31aac9d42bd2a279c12.jpg","price":31500,"product_id":"159958250","store_id":243205,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Thông tin chung","attributes":[{"code":"publisher_vn","name":"Công ty phát hành","value":"CÔNG TY TNHH GIÁO DỤC GIÁC NGỘ"},{"code":"manufacturer","name":"Nhà xuất bản","value":"Nhà Xuất Bản Thông Ti