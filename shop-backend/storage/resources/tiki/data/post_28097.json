,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":16800,"discount_rate":10,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/44/da/53/dc0117b760d9c18c27027eb8acfef531.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":342,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eThông tin chung:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eTiêu đề: Người tình ác quỷ (Tập truyện ngắn Xổ số: Hay là cuộc phiêu lưu của James Harris)\u003c/li\u003e\n\u003cli\u003eTác giả: Shirley Jackson\u003c/li\u003e\n\u003cli\u003eThể loại: Tập truyện ngắn\u003c/li\u003e\n\u003cli\u003eGiá bìa: 168000 VNĐ\u003c/li\u003e\n\u003cli\u003eNăm XB: 2023\u003c/li\u003e\n\u003cli\u003eKích thước: 14 x 20.5 CM\u003c/li\u003e\n\u003cli\u003eHình thức: Bìa mềm\u003c/li\u003e\n\u003cli\u003eSố trang: 360 trang\u003c/li\u003e\n\u003cli\u003eNgôn ngữ: Tiếng Việt\u003c/li\u003e\n\u003cli\u003eNgười dịch: Linh M. Nguyễn\u003c/li\u003e\n\u003cli\u003eNhà xuất bản: Thanh Niên\u003c/li\u003e\n\u003cli\u003eCông ty phát hành: San Hô Books\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eGiới thiệu sách:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eCô tuyệt vọng trở về căn hộ không có bóng anh, vị hôn phu đã vắng mặt trong ngày cưới. Chẳng nơi nào thấy tăm hơi gã đàn ông mặc vét xanh, dường như chỉ mình cô biết đến sự tồn tại của con người ấy. Và \u003cem\u003eNgười tình ác quỷ\u003c/em\u003e cũng là truyện đầu tiên ở tuyển tập này hé lộ hình hài, danh tính cái bóng ma lẩn lút trong hầu khắp các truyện ngắn khác của Shirley Jackson – bóng ma mang tên James Harris.\u003c/p\u003e\n\u003cp\u003eGã đến cùng cơn loạn thần, gã đến bên những người phụ nữ phải gồng mình dưới áp lực kinh hoàng từ chính cuộc sống thường nhật. Khai thác chủ đề kinh dị tâm lí và cái khủng khiếp ẩn trong những tình huống đời thường vốn là biệt tài của Shirley Jackson. Tác phẩm khơi dậy câu hỏi về ý nghĩa tồn tại của cá thể, về nỗi đơn côi bất lực tột cùng của con người trước quyền lực cộng đồng.\u003c/p\u003e\n\u003cp\u003eShirley Jackson thành công ở cả tiểu thuyết lẫn truyện ngắn, trong đó \u003cem\u003eNgười tình ác quỷ\u003c/em\u003e chính là tuyển tập chứa đựng một trong những truyện ngắn hay nhất, gây ám ảnh nhất nền văn học Mĩ thế kỉ XX.\u003c/p\u003e\n\u003cp\u003e------------------------------------------------------------\u003c/p\u003e\n\u003cp\u003e“Bậc thầy của truyện kinh dị gothic và sự lưỡng lự tâm lí.”\u003c/p\u003e\n\u003cp\u003e―\u003cem\u003eBritannica\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e“Sở hữu một lối viết dung dị nhưng hàm nghĩa thì luôn đầy ắp và ẩn sâu sau câu chữ, rất đặc trưng cho tự sự tối giản tâm lí, ý nhị và gián đoạn, truyện của Shirley Jackson [...] mê hoặc người đọc bằng cách kể không có chuyện và đa phần là khước từ cái kết theo lối truyền thống.”\u003c/p\u003e\n\u003cp\u003e―GS. TS. Lê Huy Bắc\u003c/p\u003e\n\u003cp\u003e“Có lẽ hơn bất cứ nơi đâu, truyện và phim kinh dị bảo người ta rằng cứ hoà vào làm một với đám đông, cứ tiêu diệt kẻ ngoại lai đi, chẳng sao hết. Ý tưởng này được diễn tả hay nhất, văn chương nhất trong truyện ngắn \u003cem\u003eXổ số\u003c/em\u003e của Shirley Jackson.” \u003c/p\u003e\n\u003cp\u003e―Stephen King, \u003cem\u003eDanse Macabre\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e------------------------------------------------------------\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eVề tác giả:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eSHIRLEY JACKSON (1916-1965), nữ nhà văn người Mĩ, là bậc thầy sáng tác truyện kinh dị bí ẩn ở thế kỉ XX. Bà nổi danh với các tiểu thuyết\u003cem\u003e Ta vẫn luôn sống trong lâu đài, Chuyện ma ám ở Dinh thự Hill\u003c/em\u003e, và truyện ngắn \u003cem\u003eXổ số\u003c/em\u003e – tác phẩm được giảng dạy trong chương trình Ngữ Văn tại Mĩ.\u003c/p\u003e\n\u003cp\u003eĐược ca ngợi là “bà hoàng văn học gothic” nước Mĩ, Shirley Jackson để lại 06 tiểu thuyết, 02 hồi kí và hơn 200 truyện ngắn. Năm 2007, tên của bà được đặt cho một giải thưởng văn học thường niên dành cho truyện tâm lí kinh dị kì bí – Giải Shirley Jackson.\u003c/p\u003e\n\u003cp\u003eTác phẩm của Shirley Jackson do San Hô phát hành:\u003c/p\u003e\n\u003cp\u003e-           \u003cem\u003eTa vẫn luôn sống trong lâu đài\u003c/em\u003e (tiểu thuyết)\u003c/p\u003e\n\u003cp\u003e-           \u003cem\u003eNgười tình ác quỷ \u003c/em\u003e(tập truyện ngắn)\u003c/p\u003e\n\u003cp\u003e------------------------------------------------------------\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTrang đọc thử:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/98/49/4b/f06888521f73fb22d62482daaf7fddc0.jpg\" alt=\"\" width=\"750\" height=\"549\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/72/44/ea/0c51a465e525a09a66315e0322087b4e.jpg\" alt=\"\" width=\"750\" height=\"549\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/92/40/a2/f5ec886e8e7529ba03d9f4fd4b36222b.jpg\" alt=\"\" width=\"750\" height=\"549\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/24/df/7d/3846f3e107e9c874f0e9f6e5cc5b96f9.jpg\" alt=\"\" width=\"750\" height=\"549\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/44/da/53/dc0117b760d9c18c27027eb8acfef531.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/44/da/53/dc0117b760d9c18c27027eb8acfef531.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/44/da/53/dc0117b760d9c18c27027eb8acfef531.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/44/da/53/dc0117b760d9c18c27027eb8acfef531.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/44/da/53/dc0117b760d9c18c27027eb8acfef531.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/24/df/7d/8c958cbff4ec05ad0462b85b1496789d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/24/df/7d/8c958cbff4ec05ad0462b85b1496789d.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/24/df/7d/8c958cbff4ec05ad0462b85b1496789d.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/24/df/7d/8c958cbff4ec05ad0462b85b1496789d.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/24/df/7d/8c958cbff4ec05ad0462b85b1496789d.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/27/f9/c4/daf8393de6b31eb80481688f5f6f1d7b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/27/f9/c4/daf8393de6b31eb80481688f5f6f1d7b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/27/f9/c4/daf8393de6b31eb80481688f5f6f1d7b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/27/f9/c4/daf8393de6b31eb804