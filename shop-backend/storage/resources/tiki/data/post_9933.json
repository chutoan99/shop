y_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/55/24/33/32df77368e2ebf6f21ad1b6513117bdc.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":760,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch5\u003eKhai mở giới hạn không gian - Thiết kế chữ I độc đáo với chân đế linh hoạt\u003c/h5\u003e\n\u003cp\u003eThưởng thức một tổng thể hoàn thiện, liền mạch và sắc sảo đến từng chi tiết. Tuyệt tác màn hình kết hợp với thiết kế tinh giản từ The Serif khắc hoạ nên nét chấm phá tuyệt mỹ, nâng tầm không gian sống đậm chất nghệ thuật.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/53/59/61/5ec70e30165f3a92a50820146598330e.jpg\" alt=\"5ec70e30165f3a92a50820146598330e.jpg\" /\u003e\u003c/p\u003e\n\u003ch5\u003ePhản chiếu tối thiểu, tận hưởng tối đa - Công nghệ QLED với tấm nền chống phản chiếu ánh sáng\u003c/h5\u003e\n\u003cp\u003eThưởng thức mọi tác phẩm trọn vẹn. Công nghệ chống phản sáng giúp giảm thiểu tình trạng chói hay phản chiếu của màn hình để không gì cản trở trải nghiệm xem của bạn.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/64/ae/04/13ed16bb06474449888e5f8dfd4e59da.jpg\" alt=\"13ed16bb06474449888e5f8dfd4e59da.jpg\" /\u003e\u003c/p\u003e\n\u003ch5\u003eDễ dàng hòa hợp với mọi không gian - Chân đế tháo lắp không cần dụng cụ\u003c/h5\u003e\n\u003cp\u003eĐơn giản và nhanh gọn hơn bao giờ hết. Chỉ cần gạt mở các hốc ở cạnh dưới TV và lắp đặt chân đế vào đúng vị trí, bạn có thể lắp đặt TV ở mọi nơi trong nhà mà bạn muốn.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/a7/34/1e/2d5beecd59b752469385e7c622385639.jpg\" alt=\"2d5beecd59b752469385e7c622385639.jpg\" /\u003e\u003c/p\u003e\n\u003ch5\u003eNgắm nhìn thế giới qua khung hình QLED - Công nghệ Quantum Dot hiển thị 100% dải sắc màu\u003c/h5\u003e\n\u003cp\u003eCông nghệ Quantum Dot sử dụng các chấm lượng tử kích thước nano để tái tạo 100% dải sắc màu ấn tượng, mang đến bạn những chi tiết siêu thực dù cho khung hình sáng rực rỡ hay tối thăm thẳm. Công nghệ HDR10+ tiên tiến phân tích từng cảnh quay, điều chỉnh độ sáng cho mọi khoảnh khắc thêm sắc nét, sống động.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/92/85/c0/a117fd9faa1c82318b37567c56dbd8bb.jpg\" alt=\"a117fd9faa1c82318b37567c56dbd8bb.jpg\" /\u003e\u003c/p\u003e\n\u003ch5\u003eTác phẩm của thiên tài thiết kế Ronan \u0026amp; Erwan Bouroullec - Thiết kế chữ I phá cách\u003c/h5\u003e\n\u003cp\u003eThiết kế dạng khối chữ “I' hài hòa trong khung viền thanh mảnh, tinh tế đã tạo nên \"The Serif\", một tác phẩm thẩm mỹ độc tôn và khác biệt từ thiên tài thiết kế Ronan \u0026amp; Erwan Bouroullec.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ec/1e/a4/0cea988173079919879d229fdb6ba634.jpg\" alt=\"0cea988173079919879d229fdb6ba634.jpg\" /\u003e\u003c/p\u003e\n\u003ch5\u003eTinh hoa sắc màu đương đại - Tô điểm không gian với 2 màu sắc thuần khiết\u003c/h5\u003e\n\u003cp\u003eHoàn thiện không gian theo phong cách riêng bạn với khung viền tinh tế làm hài lòng mọi đôi mắt duy mỹ. Sắc trắng Cloud White kinh điển với vẻ đẹp hài hòa phù hợp cho mọi cấu trúc và phong cách bài trí. Sắc xanh Cotton Blue độc đáo làm nối bật The Serif như phẩm chất vốn có.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/f7/f8/43/157703f4cba737f4a97fbe9af8bcb65b.jpg\" alt=\"157703f4cba737f4a97fbe9af8bcb65b.jpg\" /\u003e\u003c/p\u003e\n\u003ch5\u003eTrọn vẹn từng khoảnh khắc cùng The Serif - Chế độ Ambient Mode+\u003c/h5\u003e\n\u003cp\u003eThe Serif mang đến nhiều lựa chọn cài đặt để biến đổi TV phù hợp với không gian và nhu cầu riêng bạn. Tuỳ chọn để hiển thị các thông tin hữu ích, các phối màu vui tươi cho bữa tiệc, các tông màu trầm làm ấm không gian hay khoảnh khắc vô giá của bạn bên những người thân yêu, ngay khi TV đang tắt.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/70/09/51/18343049459915d7cef94f882c474318.jpg\" width=\"750\" height=\"681\" alt=\"18343049459915d7cef94f882c474318.jpg\" /\u003e\u003c/p\u003e\n\u003ch5\u003eHọa tiết độc quyền từ các nhà thiết kế lừng danh\u003c/h5\u003e\n\u003cp\u003eĐược thiết kế đặc biệt bởi cặp anh em tài hoa Ronan \u0026amp; Erwan Bouroullec, chế độ Ambient Mode mới sở hữu 2 họa tiết nền ấn tượng: Lá - lấy cảm hứng từ thế giới tự nhiên và họa tiết vải với đa dạng các mảng màu độc đáo. Thổi hồn thẩm mỹ, điểm tô không gian sống thêm hoàn hảo cùng The Serif.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/36/e1/cb/83e8404506ef543ae92aba893058ff5f.jpg\" alt=\"83e8404506ef543ae92aba893058ff5f.jpg\" /\u003e\u003c/p\u003e\n\u003ch5\u003eMở rộng trải nghiệm với nội dung trên màn hình lớn - Tính năng Mobile Mirroring\u003c/h5\u003e\n\u003cp\u003eTruyền nội dung trực tiếp từ điện thoại của bạn, với ứng dụng SmartThings cho Android và iOS hoặc AirPlay cho các thiết bị Apple.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/4c/40/8a/3845d9b69f82fb00e891c7ae37653884.jpg\" alt=\"3845d9b69f82fb00e891c7ae37653884.jpg\" /\u003e\u003c/p\u003e\n\u003ch5\u003eTrải nghiệm mượt mà hoàn hảo - Tính năng Tap View\u003c/h5\u003e\n\u003cp\u003eChỉ cần chạm nhẹ điện thoại lên The Serif, mọi thao tác trên điện thoại đều có thể được hiển thị trên màn hình TV, cho bạn tận hưởng nội dung liền mạch trên cả 2 thiết bị, nâng tầm trải nghiệm thêm hoàn hảo hơn.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/65/89/c9/bc7332adbe951f13d09735c61621c954.jpg\" width=\"750\" height=\"625\" alt=\"bc7332adbe951f13d09735c61621c954.jpg\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/98/6c/1e/296d61ccff1c3f4440b165e155a305a9.jpg\" alt=\"296d61ccff1c3f4440b165e155a305a9.jpg\" /\u003e\u003c/p\u003e\n\u003ch5\u003eCá nhân hóa kho ứng dụng giải trí - Smart Hub\u003c/h5\u003e\n\u003cp\u003eỨng dụng Smart Hub mới từ Samsung hiển thị nội dung yêu thích chuẩn xác trong mục Khám phá, giúp bạn không tốn nhiều thời gian để tìm kiếm và tận hưởng nhiều hơn khoảng thời gian xem phim cũng như nhiều chương trình khác.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/77/a7/48/c5a2058b4fe68cf0977ce605ab93ba11.jpg\" alt=\"c5a2058b4fe68cf0977ce605ab93ba11.jpg\" /\u003e\u003c/p\u003e\n\u003ch5\u003eĐa tác vụ trên một màn hình - Tính năng Multi View\u003c/h5\u003e\n\u003cp\u003eTiện lợi hơn với chế độ Multi View mang đến cho bạn trải nghiệm xem cùng lúc cả hai nội dung trên TV và trên điện thoại. Chỉ cần kết nối với điện thoại của bạn và sử dụng tính năng đa nhiệm với Multi View.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/b0/6a/8b/8a459264a104d6333b243e71756526d4.jpg\" alt=\"8a459264a104d6333b243e71756526d4.jpg\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/40/2b/e2/cb0104907fc9c1155a9ba73a4e1df693.jpg\" alt=\"cb0104907fc9c1155a9ba73a4e1df693.jpg\" /\u003e\u003c/p\u003e\n\u003ch5\u003eThưởng thức nội dung một cách khác biệt - Kết nối 1 chạm NFC đơn giản với các thiết bị di động\u003c/h5\u003e\n\u003cp\u003eĐơn giản kết nối, thưởng thức bất tận thế giới âm nhạc đỉnh cao cùng những khung hình ấn tượng trên The Serif.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/95/54/88/be4fe9fdeb2ef2bdbea71804f7b7c787.jpg\" alt=\"be4fe9fdeb2ef2bdbea71804f7b7c787.jpg\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch5\u003eĐiều khiển chỉ cần khẩu lệnh - Chọn ngay trợ lý giọng nói của riêng bạn\u003c/h5\u003e\n\u003cp\u003eLần đầu tiên, Samsung TV tích hợp cả 3 trợ lý giọng nói: Bixby, Amazon Alexa và Google Assistant. Cho bạn thoải mái lựa chọn trợ lý yêu thích, cung cấp trải nghiệm giải trí tối ưu và khả năng điều khiển liền mạch ngôi nhà thông minh của bạn.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/f1/46/f0/d3e21b2baefa902d6de559e5ca15dffa.jpg\" alt=\"d3e21b2baefa902d6de559e5ca15dffa.jpg\" /\u003e\u003c/p\u003e\n\u003ch5\u003eDễ dàng quản lý hơn cho một tương lai xanh hơn - Điều khiển SolarCell Remote\u003c/h5\u003e\n\u003cp\u003eTạm biệt việc thay pin điều khiển để đến với điều khiển từ xa SolarCell sạc bằng ánh sáng mặt trời và đèn chiếu sáng trong nhà cho bạn lối sống thân thiện với môi trường và tối ưu năng lượng hơn.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/f6/05/3d/61f77f54da8bb55da8e7e6272a4e1b74.jpg\" alt=\"61f77f54da8bb55da8e7e6272a4e1b74.jpg\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/61/6c/57/07bded9bea95e3a292aef916400182de.jpg\" alt=\"07bded9bea95e3a292aef916400182de.jpg\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/8e/eb/89/ffd7ac4cc1a0b8cc50a2d22f740a0d5e.jpg\" alt=\"ffd7ac4cc1a0b8cc50a2d22f740a0d5e.jpg\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/72/6b/2c/a82a9e10094170888946f65ce58b0a2e.jpg\" alt=\"a82a9e10094170888946f65ce58b0a2e.jpg\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/3e/5f/1f/10992b7dd966ede8767c096753c10b52.jpg\" alt=\"10992b7dd966ede8767c096753c10b52.jpg\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/cc/dd/4f/171a5f2a303d45ec1294b723c3c4a7d3.jpg\" alt=\"171a5f2a303d45ec1294b723c3c4a7d3.jpg\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/74/cc/17/33442af5d37ad01a5ccca9dcb614eef9.jpg\" alt=\"33442af5d37ad01a5ccca9dcb614eef9.jpg\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p