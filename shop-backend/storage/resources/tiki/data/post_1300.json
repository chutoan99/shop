badge","code":"is_hero","type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"freeship_xtra","type":"pdp_icon_badge","index":2,"icon":"https://salt.tikicdn.com/ts/upload/be/67/48/04a82ab8df178e1a13bde38316081865.png","icon_width":91,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":true,"return_reason":"any_reason"}},"discount":46000,"discount_rate":23,"rating_average":5,"review_count":7,"review_text":"(7)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ab/66/40/3b112e92ca1d982fb8436508d2a3c22a.png","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":119,"all_time_quantity_sold":84,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eSách - Dám Kể Chuyện - Đã Đến Lúc Dừng Đốt Tiền Cho Quảng Cáo\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e\u003cbr /\u003e\u003c/span\u003e\u003cspan style=\"font-weight:400;\"\u003e\u003cbr /\u003e\u003c/span\u003e\u003cspan style=\"font-weight:400;\"\u003eKhông chỉ là kể chuyện, việc áp dụng Storytelling trong doanh nghiệp còn mang lại các giá trị lớn về doanh số, danh tiếng và uy tín thương hiệu. Bí quyết ở đây là gì? Cuốn sách Dám kể chuyện sẽ chia sẻ rất chi tiết về các yếu tố và kỹ thuật để bạn có thể viết được những câu chuyện chân thật, thú vị, hiệu quả, áp dụng được ngay cho doanh nghiệp của mình.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCuốn sách sẽ mang đến cho bạn:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eSự hiểu biết đúng về Storytelling dưới góc nhìn khoa học, tâm lý và kinh nghiệm sử dụng trong thực tế của tác giả kèm các kỹ thuật cần thiết để áp dụng được ngay.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eHiểu được sự ảnh hưởng tích cực và mạnh mẽ của Storytelling trong thực tế cuộc sống cũng như kinh doanh.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eCác hướng dẫn chi tiết và bài tập thực hành để tìm insight khách hàng khi kể câu chuyện thương hiệu, câu chuyện bán hàng.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eTư duy cần có và các kỹ thuật quan trọng để xây dựng thương hiệu thông qua việc kể các câu chuyện thú vị, nhất quán và phù hợp khách hàng.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eĐộng lực đủ mạnh mẽ để bạn Dám kể chuyện và tạo ra những sự thay đổi trong chính mối quan hệ, cuộc sống và công việc của mình thông qua Storytelling.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eVỀ TÁC GIẢ\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTác giả Dương Tống\u003c/strong\u003e\u003cstrong\u003e\u003cbr /\u003e\u003c/strong\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/22/30/aa/7589d7e30c5d758c6525c775e8a9bf26.png\" alt=\"\" width=\"270\" height=\"270\" /\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eChuyên gia trong ngành bất động sản, chuyên gia tư vấn chiến lược kinh doanh, Marketing, quản trị và bán hàng cho các doanh nghiệp. \u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eHuấn luyện viên kinh doanh (Business Coach) cho lãnh đạo các công ty SME tại Bình Dương.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eFounder \u0026amp; CEO của HomeNext Corp và On Home Asia.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eGiám đốc Cổng thông tin, kiêm Phó trưởng ban Truyền thông và Tổ chức sự kiện Liên chi hội Đào tạo Bất động sản Việt Nam (VNREEA).\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eGiảng viên thỉnh giảng tại các trường đại học ở Bình Dương, Tp.HCM.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eDiễn giả tại các chương trình trong và ngoài nước, các trường đại học.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eTác giả nhiều bài viết trên báo Doanh Nhân Sài Gòn, The Leader, CafeF, Nhà Quản Lý…\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eTác giả sách Kỹ năng bán hàng bất động sản trong kỷ nguyên mới (2023)\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTác giả Giàu Dương\u003c/strong\u003e\u003cstrong\u003e\u003cbr /\u003e\u003c/strong\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ff/04/85/7cbd3f474d25ecc45792a7d08ebbb413.png\" alt=\"\" width=\"270\" height=\"270\" /\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eHọc viên Cao học tại Đại học Khoa học Xã hội và Nhân văn (HCMUSSH) với các nghiên cứu về văn học và điện ảnh, văn hóa đại chúng, văn học trong thời đại trí tuệ nhân tạo…\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eTác giả nhiều bài viết trên Diễn đàn của Hội nhà văn TP.HCM, báo Thanh niên, Người Lao Động, Tạp chí Văn nghệ Trẻ, Tạp chí Tao Đàn…\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eCác giải thưởng trong nghiên cứu và viết lách: Giải thưởng Inoue Yasushi (2022), Dám ước mơ (Báo Hoa học trò, 2021), Khoảnh khắc Eureka (Meet to Read - JCI Sài Gòn, 2022)\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eCác quyển sách đã “góp chữ”: Cánh chim tự do (CSAGA Vietnam, 2021), Chuyện kể từ vùng Đồng Tháp Mười (British Council x Sở Giáo dục và Đào tạo Đồng Tháp, 2021), Trang sách tôi yêu (NXB Giáo dục, 2022), Đã yêu xong một mùa hè (Báo Sinh Viên VN - Hoa Học Trò, 2022) \u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTÓM TẮT SÁCH\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eCuốn sách là những tinh túy mà hai tác giả đúc kết lại sau nhiều năm làm việc, kinh doanh và đạt được những thành tựu trong viết lách. Đau đáu với những câu chuyện, nhìn ra được tiềm năng và lợi ích của kể chuyện không chỉ với giao tiếp mà còn cả trong kinh doanh, marketing, xây dựng thương hiệu nhưng mảng này vẫn còn bỏ ngỏ. Tác giả quyết tâm đem đến cho độc giả một quyển sách về Storytelling với mong muốn mọi người hiểu và dễ áp dụng nó để truyền tải các thông điệp hiệu quả hơn.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cem\u003eCuốn sách gồm 5 chương, cụ thể như sau:\u003c/em\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eChương 1 - Sức mạnh của nghệ thuật kể chuyện (Storytelling)\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eAi cũng nói rằng kể chuyện có một sức mạnh to lớn nhưng cách thức áp dụng nó trong thực tế cuộc sống, công việc kinh doanh thế nào để đạt hiệu quả thì chưa phải ai cũng hiểu. Chương này không chỉ làm rõ những điều đó mà còn cung cấp cái nhìn tổng quan về storytelling dưới góc độ khoa học, tâm lý từ đó đưa ra cách áp dụng cụ thể trong hoạt động marketing nội bộ, thuyết trình và các hoạt động khác trong doanh nghiệp.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eChương 2 - Kể gì với “Customer Insight”?\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eĐể kể một câu chuyện hay và hữu ích chúng ta cần biết mình sẽ kể cho ai, kể như thế nào. Chương này sẽ đưa ra những gợi ý thực tế cùng 3 mô hình hỗ trợ bạn đi tìm Customer insight (sự thật ngầm ẩn) của khách hàng từ đó việc áp dụng storytelling sẽ trúng đích và hiệu quả hơn.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eChương 3 - Làm thế nào để kể một câu chuyện hấp dẫn?\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eHiểu về khách hàng là chưa đủ để bạn áp dụng storytelling cho doanh nghiệp mình. Chương này tập trung giải quyết chữ How - cách để bạn xây dựng được câu chuyện phù hợp và áp dụng trong kinh doanh, marketing để tăng doanh số. Không chỉ có kỹ thuật và bí kíp cho bạn áp dụng ngay khi kể chuyện mà quyển sách còn chia sẻ cách tư duy, cách làm dày “vốn văn hóa” để câu chuyện của bạn hấp dẫn hơn.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eChương 4 - Câu chuyện thương hiệu\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003e “Thành Rome” của mọi câu chuyện: Khi đã biết kể gì, kể như thế nào và kể cho ai, đã đến lúc bạn áp dụng storytelling vào xây dựng bản sắc thương hiệu cho doanh nghiệp của mình. Lấy cảm hứng từ câu chuyện thành Rome, chương này đưa ra gợi ý chi tiết, ví dụ trực quan và tất tần tật những điều bạn cần làm để kể câu chuyện thương hiệu. Mỗi câu chuyện đó giống như nhiều con ngõ nhỏ đều đổ về “thành Rome” giúp thương hiệu của bạn phát triển lớn mạnh và hiện diện trong tâm trí khách hàng.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eChương 5 - Kể chuyện trong kỷ nguyên hậu nhân văn\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eStorytelling sẽ thế nào và đi về đâu với sự phát triển mạnh mẽ của AI, công nghệ hay bất cứ điều gì khác? Chương này tập trung vào tầm nhìn lớn về sự thay đổi của kỹ năng kể chuyện với bối cảnh xã hội và công nghệ luôn biến động. Bạn sẽ tìm thấy rất nhiều kinh nghiệm thực tế để thực hành sử dụng storytelling mỗi ngày trong doanh nghiệp mình. \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eVà đừng quên Dám kể chuyện! - Thông điệp mà quyển sách muốn gửi tới bạn đọc.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003e#Damkechuyen #storytelling #DuongTong #GiauDuong #marketingtips #contentmarketing #businessstories #storytellingTips #kynangstorytelling #nghethuatkechuyen #kechuyentrongkinhdoanh #nghethuatkechuyen #cauchuyenthuonghieu #marketingnoidung\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003e\u003cbr /\u003e\u003cbr /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003e \u003c/span\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ab/66/40/3b112e92ca1d982fb8436508d2a3c22a.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ab/66/40/3b112e92ca1d982fb8436508d2a3c22a.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ab/66/40/3b112e92ca1d982fb8436508d2a3c22a.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ab/66/40/3b112e92ca1d982fb8436508d2a3c22a.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ab/66/40/3b112e92ca1d982fb8436508d2a3c22a.png"},{"base_url":"https://salt.tikicdn.com/ts/product/65/3c/0c/0cc0d2cb9c117525fefb003b01d4286f.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/65/3c/0c/0cc0d2cb9c117525fefb003b01d4286f.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/65/3c/0c/0cc0d2cb9c117525fefb003b01d4286f.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/65/3c/0c/0cc0d2cb9c117525fefb003b01d4286f.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/65/3c/0c/0cc0d2cb9c117525fefb003b01d4286f.png"},{"base_url":"https://salt.tikicdn.com/ts/product/70/70/a7/5c570a2fd33c4140ad104c0ef342b5e3.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/70/70/a7/5c570a2fd33c4140ad104c0ef342b5e3.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/70/70/a7/5c570a2fd33c4140ad104c0ef342b5e3.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/70/