483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.2,"review_count":9,"review_text":"(9)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/29/68/61/904f2e80e2bbf4e75e68f38edb9e730d.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1011,"all_time_quantity_sold":77,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003chtml\u003e\n \u003chead\u003e\u003c/head\u003e\n \u003cbody\u003e\n  \u003cul\u003e\n   \u003cp\u003eThực trạng hiện tại:\u003c/p\u003e\n   \u003cp\u003e01 ĐỂ LỘ CHÂN TÓC BẠC luôn là nỗi lo lắng, ám ảnh của tất cả mọi người.\u003c/p\u003e\n   \u003cp\u003e02 Không ít người cảm thấy BẤT AN về chất lượng sản phẩm và sợ HÓA CHẤT ẢNH HƯỞNG XẤU đến sức khỏe.\u003c/p\u003e\n   \u003cp\u003e03 Đối với tóc bạc, khi nhuộm bằng những sản phẩm thông thường, cần phải nhuộm 2 lần để có được MÀU TÓC THỜI TRANG, mất nhiều thời gian hơn và màu tóc rất khó được như ý.\u003c/p\u003e\n   \u003cp\u003eHoặc với tình trạng tóc đã nhuộm màu sẵn, cần phủ những vùng bạc nhưng vẫn duy trì màu hiện tại\u003c/p\u003e\n   \u003cp\u003eREEN HEUKMOBICHAEK ORIENTAL CREAM\u003c/p\u003e\n   \u003cp\u003eRa đời mang đến giải pháp NHUỘM PHỦ BẠC TẠI NHÀ\u003c/p\u003e\n   \u003cp\u003eĐƠN GIẢN VỚI NHIỀU TONE MÀU CHO TÓC BẠC\u003c/p\u003e\n   \u003cp\u003eSự khác biệt của sản phẩm:\u003c/p\u003e\n   \u003cp\u003e1. DẠNG GÓI TIỆN LỢI với tỉ lệ thích hợp cho việc tự nhuộm tại nhà, không gây lãng phí.\u003c/p\u003e\n   \u003cp\u003e2. MÙI HƯƠNG DỄ CHỊU ngay cả sau khi nhuộm do không chứa Amoniac.\u003c/p\u003e\n   \u003cp\u003e3. THÀNH PHẦN THIÊN NHIÊN an toàn cho mái tóc khỏe mạnh và bền màu.\u003c/p\u003e\n   \u003cp\u003eChiết xuất NGƯ TINH THẢO ( cây diếp cá ) giúp cải thiện tóc bạc quay trở lại và giảm rụng tóc;\u003c/p\u003e\n   \u003cp\u003eGiảm thiểu kích ứng và dịu nhẹ da đầu với các thành phần từ HOÀNG LIÊN, TANG BẠCH BÌ;\u003c/p\u003e\n   \u003cp\u003eMàu sắc tự nhiên từ các loại THẢO MỘC NGŨ SẮC theo truyền thống Hàn Quốc, cho tóc đều màu và óng mượt tự nhiên.\u003c/p\u003e\n   \u003cp\u003eSản phẩm gồm 2 tông màu chính:\u003c/p\u003e\n   \u003cp\u003e\u0026gt;\u0026gt;\u0026gt; BẢNG MÀU TỐI: NÂU SẨM - NÂU ĐEN - ĐEN\u003c/p\u003e\n   \u003cp\u003e\u0026gt;\u0026gt;\u0026gt; BẢNG MÀU SÁNG: NÂU SÁNG - NÂU TỰ NHIÊN - NÂU ĐỎ\u003c/p\u003e\n   \u003cp\u003eBƯỚC 1: CHUẨN BỊ HỖN HỢP NHUỘM\u003c/p\u003e\n   \u003cp\u003e• Đeo găng tay, mở lần lượt dung dịch 1 và dung dịch 2 (Sẽ nhanh và gọn hơn nếu cắt bằng kéo).\u003c/p\u003e\n   \u003cp\u003e• Cho dung dịch 1 và dung dịch 2 vào khay đựng.\u003c/p\u003e\n   \u003cp\u003e• Trộn đều hỗn hợp nhuộm bằng lược có sẵn trong hộp.\u003c/p\u003e\n   \u003cp\u003eBƯỚC 2: THOA HỖN HỢP NHUỘM (Sử dụng khi tóc khô)\u003c/p\u003e\n   \u003cp\u003e1. Dùng lược để thoa hỗn hợp nhuộm lên phần tóc cần nhuộm.\u003c/p\u003e\n   \u003cp\u003e2. Thoa theo trình tự như sau\u003c/p\u003e\n   \u003cp\u003e• Phần nhiều tóc bạc.\u003c/p\u003e\n   \u003cp\u003e• Phần tóc sau.\u003c/p\u003e\n   \u003cp\u003e• Phần đỉnh đầu.\u003c/p\u003e\n   \u003cp\u003e• Dùng phần cọ của lược để đảm bảo thuốc nhuộm thấm đều từng sợi tóc.\u003c/p\u003e\n   \u003cp\u003eBƯỚC 3: HOÀN TẤT\u003c/p\u003e\n   \u003cp\u003e• Sau khi thoa kỹ thì đợi để hỗn hợp nhuộm hấp thụ theo khoảng thời gian như sau. (Liên tục dùng lược chải sẽ cho hiệu quả tốt hơn)\u003c/p\u003e\n   \u003cp\u003e• Đối với tóc đen, tóc nâu đen hoặc tóc nâu đậm: 10 phút\u003c/p\u003e\n   \u003cp\u003e• Đối với tóc nâu hạt dẻ, nâu tự nhiên, nâu sáng: 15 phút\u003c/p\u003e\n   \u003cp\u003e• Sau khi nhuộm, xả sạch lại với nước ấm và gội sạch bằng dầu gội.\u003c/p\u003e\n   \u003cp\u003e• Cung cấp dưỡng chất cho tóc với gói kem xả.\u003c/p\u003e\n   \u003cp\u003eKhối lượng tịnh\u003c/p\u003e\n   \u003cp\u003e1. Hair Color : 20gx3\u003c/p\u003e\n   \u003cp\u003e2. Color Developer: 20gx3\u003c/p\u003e\n   \u003cp\u003e3. Treatment: 8ml\u003c/p\u003e\n   \u003cp\u003e CAM KẾT HÀNG CHÍNH HÃNG - NÓI KHÔNG VỚI HÀNG KÉM CHẤT LƯỢNG\u003c/p\u003e\n  \u003c/ul\u003e\n \u003c/body\u003e\n\u003c/html\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/29/68/61/904f2e80e2bbf4e75e68f38edb9e730d.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/29/68/61/904f2e80e2bbf4e75e68f38edb9e730d.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/29/68/61/904f2e80e2bbf4e75e68f38edb9e730d.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/29/68/61/904f2e80e2bbf4e75e68f38edb9e730d.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/29/68/61/904f2e80e2bbf4e75e68f38edb9e730d.png"},{"base_url":"https://salt.tikicdn.com/ts/product/c2/27/2f/728b21494a8e033964f3157b82211e24.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c2/27/2f/728b21494a8e033964f3157b82211e24.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c2/27/2f/728b21494a8e033964f3157b82211e24.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c2/27/2f/728b21494a8e033964f3157b82211e24.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/20