ull}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":3,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/86/b1/b2/efa88389ad9051bbb8a9b11b21a79de9.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":931,"all_time_quantity_sold":19,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003eCốm Pre-Vipteen 2 VINH GIA Bổ Sung Canxi Tăng Chiều Cao, Tăng Sức Đề Kháng Phát Triển Thể Lực Cho Trẻ Hộp 20 Gói\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003e1. THÔNG TIN SẢN PHẨM\u003c/strong\u003e\u003cbr /\u003e- Tên sản phẩm: Cốm Pre-Vipteen 2.\u003cbr /\u003e- Thương hiệu: Pre Vipteen\u003cbr /\u003e- Mã sản phẩm: Pre Vipteen 2.\u003cbr /\u003e- Xuất xứ: Việt Nam.\u003cbr /\u003e- Màu sắc: Hộp xanh dương.\u003cbr /\u003e- Quy cách hộp: 20 gói x2g.\u003cbr /\u003e- Cốm hỗ trợ phát triển chiều cao cho trẻ từ 6 tháng tuổi giúp bổ sung canxi, vitamin D cải thiện chiều cao và xương chắc khỏe.\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/6e/7c/6f/5c8c9807119c09cd69be88c49bf3b6a4.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003e2. THÀNH PHẦN\u003c/strong\u003e\u003cbr /\u003e- Menaquinon-7 (MK7) : 1,25 mcg.\u003cbr /\u003e- Vitamin D3 : 300 UI.\u003cbr /\u003e- Calci Carbonat (dạng nano) : 250 mg.\u003cbr /\u003e- Magiesi (oxyd) : 125 mg.\u003cbr /\u003e- Kẽm Oxyd (dạng nano) : 1 mg.\u003cbr /\u003e- DHA : 11 mg.\u003cbr /\u003e- Acid folic : 300 mcg.\u003cbr /\u003e- Immune alpha : 250 mg.\u003cbr /\u003e- Colostrum (Sữa non) : 100 mg.\u003cbr /\u003e- FOS : 250 mg.\u003cbr /\u003e- Thành phần khác đường, hương vừa đủ 1 gói.\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003e3. CÔNG DỤNG\u003c/strong\u003e\u003cbr /\u003e- Cốm Pre-Vipteen 2 giúp bổ sung canxi, vitamin D, MK7 (vitamin K2), hỗ trợ xương răng chắc khỏe.\u003cbr /\u003e- Hỗ trợ giúp phát triển chiều cao cho trẻ đồng thời duy trì tốc độ tăng trưởng chiều cao.\u003cbr /\u003e- Giúp tăng sức đề kháng hạn chế nguy cơ còi xương, thấp còi.\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/79/5f/58/9a3893335616c33df07da42b8a89ebaf.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003e4. HƯỚNG DẪN SỬ DỤNG\u003c/strong\u003e\u003cbr /\u003e- Trẻ từ 6 tháng tuổi đến 4 tuổi: Uống mỗi lần 1 gói, ngày 1-2 lần.\u003cbr /\u003e- Trẻ từ 6 tháng tuổi đến 2 tuổi nên hỏi ý kiến của bác sỹ hoặc chuyên gia dinh dưỡng trước khi sử dụng.\u003cbr /\u003e- Trẻ từ 5 tuổi đến 9 tuổi: Uống mỗi lần 1 gói, ngày 2 lần.\u003cbr /\u003e- Khi cho trẻ uống có thể pha với nước, sữa hoặc trộn với thức ăn đặc như sữa chua, váng sữa, hoa quả xay, cháo, bột.\u003cbr /\u003e- Nên uống trước bữa ăn 30 phút hoặc sau khi ăn 1 giờ. Nên sử dụng thành đợt từ 3 - 6 tháng để có kết quả tốt\u003cbr /\u003e- Có thể sử dụng hàng ngày và thường xuyên để thu được kết quả tốt\u003cbr /\u003e- Để đạt kết quả tốt, cần kết hợp với việc ăn uống đủ dưỡng chất, sinh hoạt điều độ, tập thể dục đều đặn và ngủ đủ giấc.\u003cbr /\u003e- Lưu ý: Sản phẩm có Vitamin K2 (MK7) nên hỏi ý kiến nhân viên y tế hoặc dinh dưỡng khi sử dụng cùng với loại thuốc khác (như thuốc chống đông máu…). Không sử dụng cho người có mẫn cảm với bất kỳ thành phần nào của sản phẩm.\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/75/99/da/a6278bb751b3a3845d139d82100414c1.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003e5. ĐỐI TƯỢNG SỬ DỤNG\u003c/strong\u003e\u003cbr /\u003e+ Trẻ em từ 6 tháng - 9 tuổi cần hỗ trợ phát triển chiều cao và tăng sức đề kháng.\u003cbr /\u003e+ Trẻ còi xương, thiếu Canxi, vitamin D, trẻ em sức đề kháng kém.\u003cbr /\u003e\u003cbr /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/cf/cf/27/54205f5bdff4b78a2cb01a8bf5e9a583.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003e6. HẠN SỬ DỤNG:\u003c/strong\u003e \u003cbr /\u003e- Hạn sử dụng: 36 tháng kể từ ngày sản xuất\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003e7. HƯỚNG DẪN BẢO QUẢN: \u003c/strong\u003e\u003cbr /\u003e- Bảo quản nơi khô thoáng.\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/92/85/5d/f51c08310cd449c22ea73c63e9fd36d4.jpg\" alt=\"\" width=\"542\" height=\"417\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/86/b1/b2/efa88389ad9051bbb8a9b11b21a79de9.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/86/b1/b2/efa88389ad9051bbb8a9b11b21a79de9.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/86/b1/b2/efa88389ad9051bbb8a9b11b21a79de9.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/86/b1/b2/efa88389