n_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":78000,"discount_rate":14,"rating_average":4.8,"review_count":4,"review_text":"(4)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/bb/f1/09/fad0de0dd06bd7895d451f01fc463dc2.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1398,"all_time_quantity_sold":23,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cdiv id=\"huong-dan-su-dung\" class=\"#huong-dan-su-dung\"\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cspan style=\"color: #ffffff; background-color: #800000;\"\u003e\u003cstrong\u003eCareline Liver Tonic - Viên uống bổ gan, giải độc gan, thanh lọc cơ thể\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003eLiver Tonic Capsule 13000mg là một trong những sản phẩm chuyên biệt của hãng Careline (Úc), với thành phần chính là Silymarin hàm lượng cao được chiết xuất từ 1300mg hạt của cây kế sữa (Silybum marianum) có công dụng mạnh hơn gấp nhiều lần trong việc phòng ngừa bệnh gan và hỗ trợ điều trị một số bệnh về gan, duy trì chức năng gan khỏe mạnh, cải thiện sức khỏe, tăng cường để kháng, mang lại một cuộc sống lành mạnh và vui khỏe hơn.\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"background-color: #800000; color: #ffffff;\"\u003e\u003cstrong\u003eCÔNG DỤNG\u003c/strong\u003e\u003c/span\u003e\u003cbr /\u003eBổ gan, thanh nhiệt, giải độc gan, mát gan, đào thải độc tố, thanh lọc cơ thể, giúp tăng cường chức năng khử độc của gan.\u003cbr /\u003eChống oxi hóa, bảo vệ gan chống lại các độc tố từ rượu bia, các loại thuốc, các hóa chất độc hại, sử dụng quá nhiều thuốc kháng sinh và các tác nhân gây viêm gan khác.\u003cbr /\u003eỔn định màng tế bào gan, bảo vệ tế bào gan cho khỏi bị suy thoái do sự tấn công của gốc tự do, hỗ trợ sự phát triển của các tế bào gan khỏe mạnh.\u003cbr /\u003eỔn định tế bào gây viêm, ức chế phản ứng viêm, giúp gan chống lại sự phá hoại của các vi rút gây viêm gan, làm phục hồi lại những thiệt hại của tế bào gan trong bệnh viêm gan mãn tính.\u003cbr /\u003eỨc chế sự chuyển đổi của các tế bào gan hình sao vào nguyên bào sợi, ức chế sự biến đổi của gan thành các tổ chức xơ, giảm sự hình thành và lắng đọng của các sợi collagen dẫn đến xơ gan.\u003cbr /\u003eHỗ trợ trong quá trình điều trị các bệnh về gan như: xơ gan, viêm gan, gan nhiễm mỡ, men gan cao, dị ứng, mẩn ngứa, nổi mề đay…\u003cbr /\u003eHỗ trợ quá trình tái tạo của các tế bào gan, thúc đẩy phục hồi các tế bào gan đã bị phá hủy và kích thích sự phát triển của các tế bào gan mới thay thế, làm chậm quá trình lão hóa của gan và các tế bào.\u003cbr /\u003eKhôi phục chức năng gan, cải thiện và duy trì chức năng gan, đặc biệt là những người uống rượu thường xuyên.\u003cbr /\u003eTrẻ hóa gan, hạ men gan.\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003e\u003cspan style=\"background-color: #800000; color: #ffffff;\"\u003eTHÀNH PHẦN\u003c/span\u003e\u003cbr /\u003eTinh chất trong một viên tương đường với 13g hạt Kế sữa khô.\u003c/p\u003e\n\u003ch2\u003e\u003cspan style=\"background-color: #800000; color: #ffffff;\"\u003eHƯỚNG DẪN SỬ DỤNG\u003c/span\u003e\u003c/h2\u003e\n\u003c/div\u003e\n\u003cp\u003eUống 1 – 2 viên/ngày, uống trước ăn.\u003c/p\u003e\n\u003cdiv id=\"doi-tuong-su-dung\" class=\"#doi-tuong-su-dung\"\u003e\n\u003ch2\u003e\u003cspan style=\"background-color: #800000; color: #ffffff;\"\u003e\u003cstrong\u003eĐỐI TƯỢNG SỬ DỤNG\u003c/strong\u003e\u003c/span\u003e\u003c/h2\u003e\n\u003c/div\u003e\n\u003cul\u003e\n\u003cli\u003eSử dụng cho người bị suy giảm chức năng gan, viêm gan cấp và mãn tính, gan nhiễm mỡ.\u003c/li\u003e\n\u003cli\u003eNgười bị yếu gan, suy gan, gan yếu, gan nhiễm mỡ, men gan cao, viêm gan, rối loạn chức năng gan, mụn nhọt, trứng cá, dị ứng do gan nóng…\u003c/li\u003e\n\u003cli\u003eSản phẩm đặc biệt thích hợp sử dụng cho những người thường xuyên phải tiếp khách, uống nhiều bia và các chất kích thích có nguy cơ gây tổn hại gan.\u003c/li\u003e\n\u003cli\u003eNhững người làm việc tại những nơi có nhiều hóa chất độc hại, sống trong môi trường ô nhiễm, rất ích lợi cho những người bị viêm gan B\u0026amp;C…\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch2\u003e\u003cspan style=\"background-color: #800000; color: #ffffff;\"\u003e\u003cstrong\u003eBảo quản:\u003c/strong\u003e\u003c/span\u003e\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003eĐể nơi khô ráo, thoáng mát.\u003c/li\u003e\n\u003cli\u003eTránh nhiệt độ cao và ánh nắng trực tiếp.\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/bb/f1/09/fad0de0dd06bd7895d451f01fc463dc2.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/bb/f1/09/fad0de0dd06bd7895d451f01fc463dc2.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/bb/f1/09/fad0de0dd06bd7895d451f01fc463dc2.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/bb/f1/09/fad0de0dd06bd7895d451f01fc463dc2.jpg","thumbnail_url":"https://salt.tik