":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":609992,"discount_rate":32,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/96/fb/b4/805c7f0d0ca3c8677593237dab0cc01d.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":260,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align:center;\"\u003e\u003cspan style=\"color:#0000ff;\"\u003e\u003cstrong\u003eKhung tập đi cho người già, hỗ trợ phục hồi chức năng, có bô đi kèm, gấp gọn khi không sử dụng, chính hãng Nikita.\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e\u003cspan style=\"color:#000000;\"\u003eKhung tập đi là một loại dụng cụ trợ giúp di chuyển cần thiết để giúp người gặp khó khăn trong di chuyển đi lại. Khung tập đi có bô là một bước tiến vượt bậc trong thiết kế tích hợp 2 trong 1 giúp người già, người khó khăn trong di chuyển có thể tập đi, và vệ sinh một cách thuận tiện hơn\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e\u003cspan style=\"color:#000000;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/f0/ef/2c/9eed42a7fc5e86da42ae58303003af09.JPG\" alt=\"\" width=\"712\" height=\"707\" /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e\u003cspan style=\"color:#000000;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/1a/bc/85/873e4b45ca9096deccf50faeed583dc9.JPG\" alt=\"\" width=\"611\" height=\"614\" /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003eƯU ĐIỂM NỔI TRỘI\u003c/p\u003e\n\u003cp\u003e Tay vịn chắc chắn điều kiện cho người dùng dần dần đứng lên khỏi ghế sofa hoặc ghế thấp hơn.\u003c/p\u003e\n\u003cp\u003e 4 tay cầm có rãnh tăng cường ma sát và chống mài mòn trong quá trình sử dụng.\u003c/p\u003e\n\u003cp\u003e Chiều cao của xe tập đi có thể được điều chỉnhđể phù hợp với những người dùng có chiều cao khác nhau.\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e\u003cspan style=\"color:#000000;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/db/ec/f9/a24457e4ad7b4d1ce5911d5808e1e066.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003eTHÔNG SỐ\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cdiv\u003e\u003cspan\u003eThương hiệu: Nikita\u003c/span\u003e\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv\u003eKích thước nệm: 40 x 34cm\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv\u003eChiều cao bô đến mặt đất: 55 - 65cm\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv\u003eChiều cao sản phẩm: Có thể điều chỉnh\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv\u003eKích thước đóng gói: 78 x 60 x 22cm (Dài x Rộng x Cao)\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv\u003eKhối lượng: 7kg\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv\u003eTrọng lượng: 120kg\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ae/72/90/600613254276a1e677cf3d4821700976.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/div\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align:left;\"\u003e\u003cspan style=\"color:#000000;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/b5/e3/9f/ca7209ab54362f254ba7442509c3d754.JPG\" alt=\"\" width=\"713\" height=\"693\" /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e Thiết kế di động - bồn cầu có nắp mang đến giải pháp tiện lợi đáp ứng nhu cầu của mọi nơi, mọi lúc, dễ cất giữ, dễ mang theo\u003c/p\u003e\n\u003cp\u003e \u003cspan\u003eKhung thép carbon chống trượt chắc chắn - nhẹ, chống ăn mòn.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e Các vít khóa của phần bô được siết chặt để chống lật và an toàn.\u003c/p\u003e\n\u003cp\u003e\u003cspan\u003eDễ dàng điều chỉnh mà không cần dụng cụ, nâng hoặc hạ ghế để phù hợp an toàn với bất kỳ cá nhân nào.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/54/76/9b/5aa2ad9eec4a9a43c91a4f049f79e1a6.jpg\" alt=\"\" width=\"693\" height=\"671\" /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/61/cc/58/82f94fd8d87632f7287e1315479628bc.JPG\" alt=\"\" width=\"750\" height=\"735\" /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/9c/1a/8b/c18c7f961e82444a0760a78b03d067b7.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan\u003e PHƯƠNG CHÂM VÀ CAM KẾT CỦA SHOP : \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e️ Luôn bán hàng uy tín chất lượng\u003c/p\u003e\n\u003cp\u003e️ Chính sách bảo hành Sản phẩm 12 tháng\u003c/p\u003e\n\u003cp\u003e️ Hàng cam kết đúng trọng lượng của từng sản phẩm\u003c/p\u003e\n\u003cp\u003e️ Cam kết giống y như hình 100%\u003c/p\u003e\n\u003cp\u003e️ Cung cấp các sản phẩm theo đúng tiêu chuẩn với chất lượng tốt nhất,cam kết hàng giống hình 100%.\u003c/p\u003e\n\u003cp\u003e️ Giá cả hợp lý, cạnh tranh.\u003c/p\u003e\n\u003cp\u003e️ Đảm bảo về số lượng và đúng chủng loại khách đặt\u003c/p\u003e\n\u003cp\u003e️ Shop chỉ cung cấp những sản phẩm có chất lượng tốt nhất tới tay khách hàng.\u003c/p\u003e\n\u003cp\u003e️ QUÝ KHÁCH LƯU Ý: Khi nhận hàng nếu không hài lòng về chất lượng sản phẩm xin đừng vội đánh giá, hãy liên hệ ngay với SHOP để được hỗ trợ.\u003c/p\u003e\n\u003cp\u003eSỰ HÀI LÒNG CỦA KHÁCH HÀNG LUÔN LÀ MỤC TIÊU HƯỚNG ĐẾN CỦA SHOP \u003c/p\u003e\n\u003cp\u003e️ Lưu ý :\u003c/p\u003e\n\u003cp\u003e Hàng đổi trả phải còn nguyên tem mác và không có dấu