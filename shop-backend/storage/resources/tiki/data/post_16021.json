_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":300000,"discount_rate":30,"rating_average":5,"review_count":8,"review_text":"(8)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/9f/8d/5f/e450cfa872412d73ff11a54c9b5f3926.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":468,"all_time_quantity_sold":45,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eBạn cần 1 chiếc chân máy có đầu xoay mượt mà để quay những shot chuyển cảnh thì đây sẽ là Chiếc chân máy phù hợp với bạn nhé!\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/e1/a2/51/82540409ea3c2dc3faaebef1adc05c66.jpg\" alt=\"\" width=\"748\" height=\"704\" /\u003e\u003c/p\u003e\n\u003cp\u003eTên sản phẩm: Chân máy YUNTENG VCT-691RM\u003c/p\u003e\n\u003cp\u003eXuất xứ: Trung Quốc\u003c/p\u003e\n\u003cp\u003eThông số kỹ thuật\u003c/p\u003e\n\u003cp\u003eThương hiệu: Yunteng\u003c/p\u003e\n\u003cp\u003eModel: VCT-691RM\u003c/p\u003e\n\u003cp\u003eBộ sản phẩm bao gồm: Chân máy, túi đựng, đầu kẹp xoay 360 độ, Remote Yunteng\u003c/p\u003e\n\u003cp\u003eChiều cao tối đa: 152cm\u003c/p\u003e\n\u003cp\u003eTối thiểu: 54cm\u003c/p\u003e\n\u003cp\u003eTải trọng: 3kg\u003c/p\u003e\n\u003cp\u003eTrọng lượng: 1,3kg\u003c/p\u003e\n\u003cp\u003eChất liệu: Hợp kim.\u003c/p\u003e\n\u003cp\u003eChân đế, Tripod máy quay, máy ảnh, điện thoại YUNTENG VCT-691RM  là một trong những chân máy ảnh tầm trung được rất nhiều nhiếp ảnh gia lựa chọn bởi sự chắc, cơ động với đầy đủ các tính năng hỗ trợ tối đa cho công việc chụp ảnh và quay phim.\u003c/p\u003e\n\u003cp\u003eVới chiều dài thu gọn chỉ 54cm, bạn có thể dễ dàng vỏ gọn trong ba lô trong các chuyến công tác xa hay du lịch, picnic.\u003c/p\u003e\n\u003cp\u003eThiết kế 3 chân vững chãi, phù hợp với mọi địa hình sẽ giúp bạn tác nghiệp ở mọi điều kiện. Toàn bộ thân tripod được phủ sơn chống ô xi hóa giúp sản phẩm bền bỉ với thời gian.\u003c/p\u003e\n\u003cp\u003eMột số tính năng nổi bật như:\u003c/p\u003e\n\u003cp\u003e+ Trục xoay 360 độ\u003c/p\u003e\n\u003cp\u003e+ Có thể đặt máy theo chiều ngang hoặc dọc\u003c/p\u003e\n\u003cp\u003e+ Có thước đo thăng bằng giọt nước\u003c/p\u003e\n\u003cp\u003e+ Đế gài theo chuẩn ¼ inch tương thích với mọi loại máy ảnh, máy quay.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/9f/8d/5f/e450cfa872412d73ff11a54c9b5f3926.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/9f/8d/5f/e450cfa872412d73ff11a54c9b5f3926.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/9f/8d/5f/e450cfa872412d73ff11a54c9b5f3926.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9f/8d/5f/e450cfa872412d73ff11a54c9b5f3926.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9f/8d/5f/e450cfa872412d73ff11a54c9b5f3926.png"},{"base_url":"https://salt.tikicdn.com/ts/product/f5/3b/b4/3f96d66ebbcdc26fb27942a51feb38bf.jpg","is_gallery":true,"label