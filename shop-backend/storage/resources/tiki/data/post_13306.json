"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.5,"review_count":37,"review_text":"(37)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/media/catalog/product/2/7/27-(1).u2569.d20160617.t152211.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":3008,"all_time_quantity_sold":244,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cspan style=\"font-size: medium; color: #008ab7;\"\u003e\u003cstrong\u003eMũ Bảo Hiểm Nửa Đầu Có Kính GRS A737K Nhám\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\r\n\u003cp\u003e\u003cstrong\u003e\u003cstrong\u003eMũ Bảo Hiểm Nửa Đầu Có Kính GRS A737K Nhám \u003c/strong\u003e\u003c/strong\u003ecó kiểu dáng hiện đại, đẹp mắt, phần kính trong suốt phía trước bảo vệ tối ưu. Vỏ ngoài được làm từ chất liệu nhựa ABS chuyên dùng, chịu lực và chịu va chạm tốt để bạn an tâm khi lưu thông trên đường. Bên trong được trang bị lớp vải lót mềm, có khả năng chống khuẩn, chống ẩm tốt, tránh tình trạng ngứa da đầu kể cả khi bạn đội mũ trong thời tiết nóng bức.\u003c/p\u003e\r\n\u003cp\u003e\u003cspan\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Mũ Bảo Hiểm 1/2 Đầu Có Kính GRS A737K Nhám\" src=\"http://tikicdn.com/media/catalog/product/2/5/25-(1).u2569.d20160617.t151319.jpg\" alt=\"Mũ Bảo Hiểm 1/2 Đầu Có Kính GRS A737K Nhám\" width=\"450\" height=\"416\" /\u003e\u003c/span\u003e\u003c/p\u003e\r\n\u003cp\u003e\u003cspan\u003e\u003cstrong\u003eThông tin chi tiết\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\r\n\u003cp\u003e\u003cspan\u003e- Model: A737K Nhám\u003cbr /\u003e\u003c/span\u003e\u003c/p\u003e\r\n\u003cp\u003e\u003cspan\u003e- Chất liệu vỏ: Nhựa ABS\u003c/span\u003e\u003c/p\u003e\r\n\u003cp\u003e\u003cspan\u003e- Cỡ mũ: 56 - 58 cm\u003c/span\u003e\u003c/p\u003e\r\n\u003cp\u003e\u003cspan\u003e- Xuất xứ: Việt Nam\u003c/span\u003e\u003c/p\u003e\r\n\u003cp\u003e\u003cspan\u003e\u003cstrong\u003eThông tin sản phẩm\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\r\n\u003cp\u003e\u003cstrong\u003eChất liệu cao cấp, bền bỉ\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp\u003eVỏ ngoài làm từ nhựa ABS tổng hợp có thể chịu được va đập mạnh, nên \u003cstrong\u003eMũ Bảo Hiểm Nửa Đầu Có Kính GRS A737K Nhám \u003c/strong\u003esẽ bảo vệ bạn hiệu quả trước những va chạm ngoài ý muốn. Đồng thời, chất liệu này cũng giúp sản phẩm có độ bền cao hơn, cho thời gian sử dụng lâu dài.\u003c/p\u003e\r\n\u003cp\u003e\u003cstrong\u003eThoải mái khi sử dụng\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp\u003eKhi đội mũ, bạn sẽ không có cảm giác đau hay nặng đầu nhờ lớp mút xốp lót bên trong êm ái, tạo cảm giác thoải mái. Lớp vải lót có khả năng kháng khuẩn, chống ẩm giúp hạn chế các bệnh về tóc và da đầu khi phải đội mũ trong thời gian dài.\u003c/p\u003e\r\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Mũ Bảo Hiểm 1/2 Đầu Có Kính GRS A737K Nhám\" src=\"http://tikicdn.com/media/catalog/product/2/6/26-(1).u2569.d20160617.t151319.jpg\" alt=\"Mũ Bảo Hiểm 1/2 Đầu Có Kính GRS A737K Nhám\" width=\"450\" height=\"418\" /\u003e\u003c/p\u003e\r\n\u003cp\u003e\u003cspan\u003e\u003cstrong\u003eKiểu dáng nửa đầu thời trang\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\r\n\u003cp\u003e\u003cspan\u003eSản phẩm có thiết kế thời trang cùng màu sắc trẻ trung, tươi mới, phù hợp với nhiều đối tượng sử dụng.\u003c/span\u003e\u003c/p\u003e\r\n\u003cp\u003e\u003cstrong\u003eThiết kế chắc chắn, an toàn\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp\u003e- \u003cstrong\u003eMũ Bảo Hiểm Nửa Đầu Có Kính GRS A737K Nhám \u003c/strong\u003eđược thiết kế ôm vừa vặn phần đầu, dây và khóa cài chắc chắc giúp giữ chặt mũ với đầu, cho tính an toàn cao hơn, để bạn an tâm khi lưu thông trên đường. Bên cạnh đó, dây và khóa cài  còn có thể thay đổi độ dài ngắn dễ dàng để bạn linh hoạt điều chỉnh khi cần.\u003c/p\u003e\r\n\u003cp\u003e- Phần kính chắn trong suốt bảo vệ bạn dưới những tác động từ bên ngoài như nắng, gió, khói bụi...\u003c/p\u003e\r\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Mũ Bảo Hiểm 1/2 Đầu Có Kính GRS A737K Nhám\" src=\"http://tikicdn.com/media/catalog/product/2/8/28-(1).u2569.d20160617.t151319.jpg\" alt=\"Mũ Bảo Hiểm 1/2 Đầu Có Kính GRS A737K Nhám\" width=\"450\" height=\"414\" /\u003e\u003c/p\u003e\r\n\u003cp\u003e\u003cstrong\u003eLưu ý sử dụng\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp\u003e\u003cspan\u003eCài chặt khóa mũ, chọn mũ phù hợp với kích cỡ đầu. Khi mũ bị va đập, không nên sử dụng lại.\u003c/span\u003e\u003c/p\u003e\r\n\u003cp\u003e\u003cspan\u003e\u003cstrong\u003eHướng dẫn bảo quản\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\r\n\u003cp\u003e\u003cspan\u003eKhông sơn hoặc lau bề mặt bằng hóa chất vì có thể làm ảnh hưởng đến bề mặt sơn.\u003c/span\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/media/catalog/product/2/7/27-(1).u2569.d20160617.t152211.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/2/7/27-(1).u2569.d20160617.t152211.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/2/7/27-(1).u2569.d20160617.t152211.jpg","positio