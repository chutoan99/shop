"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":58000,"discount_rate":12,"rating_average":4.7,"review_count":196,"review_text":"(196)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/82/b5/2d/972b6c4df9c0bbf5056c78bf2e7c2dfb.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1639,"all_time_quantity_sold":747,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/f6/f3/58/71ec92c9cf6c20c7cd6157084331ac19.jpg\" alt=\"Kem Se Nhỏ Lỗ Chân Lông Bioderma Sebium Pore Refiner - 30ml\" width=\"750\" height=\"845\" /\u003e\u003c/p\u003e\n\u003cstyle type=\"text/css\"\u003e\u003c!--td {border: 1px solid #ccc;}br {mso-data-placement:same-cell;}--\u003e\u003c/style\u003e\n\u003cp\u003e\u003cspan data-sheets-value=\"{\u0026quot;1\u0026quot;:2,\u0026quot;2\u0026quot;:\u0026quot;Kem dưỡng se nhỏ lỗ chân lông Sébium Pore Refiner điều chỉnh tiết bã nhờn, giúp lỗ chân lông se nhỏ và mờ dần, ngăn chặn bít tắc lỗ chân lông gây mụn. Thích hợp làm lớp kem dưỡng hoàn hảo trước khi trang điểm.\\n\\nĐỐI TƯỢNG SỬ DỤNG:\\nDành cho da hỗn hợp, da dầu và mụn\\n*Không dùng cho trẻ em dưới 3 tuổi\\n\\nTÁC ĐỘNG SINH HỌC: \\n- Phát minh độc quyền Fluidactiv điều chỉnh chất lượng bã nhờn khỏe mạnh ở mức độ sinh học, khiến lỗ chân lông ít tiết dầu và se nhỏ lại, đồng thời làm giảm tác nhân gây ra mụn. \\n- Phức hợp độc quyền D.A.F được chứng nhận tăng ngưỡng dung nạp và tăng cường đề kháng cho làn da nhạy cảm.\\n- Hoạt chất Agaric acid giúp làm se khít lỗ chân lông và làm mịn da, mang đến hiệu quả tức thì trên da.\\n- Cấu trúc bề mặt da mềm mịn hơn nhờ có salicylic acid và AHA esters\\n- Các chất chống oxy hóa giúp duy trì vẻ đẹp rạng rỡ tự nhiên của làn da suốt ngày dài.\\n\\nĐỘ AN TOÀN:\\nKhông gây kích ứng và gây mụn\\nKhông chứa paraben và cồn\\nMùi hương dịu nhẹ\\nDung nạp tối ưu cho da\\n\\nHƯỚNG DẪN SỬ DỤNG:\\n- Dùng mỗi buổi sáng và/hoặc tối.\\n- Thoa Sébium Pore Refiner lên da sau khi làm sạch da mặt\\nCó thể dùng Sébium Pore Refiner một mình hoặc trước khi thoa kem dưỡng, thoa cả mặt hoặc vùng da tiết nhiều dầu (vùng da chữ T: trán, mũi, cằm)\\n*Dùng kết hợp với Sébium H2O và Sébium Gel Moussant để đạt hiệu quả tối ưu.\\n*Không dùng cho trẻ em dưới 3 tuổi\\n\\nTHÀNH PHẦN: \\nAQUA/WATER/EAU, METHYL METHACRYLATE CROSSPOLYMER, DIPROPYLENE GLYCOL, CYCLOPENTASILOXANE, CYCLOHEXASILOXANE, DIMETHICONE, GLYCERIN, BUTYLENE GLYCOL, FOMES OFFICINALIS (MUSHROOM) EXTRACT, SODIUM POLYACRYLATE, SALICYLIC ACID, DODECYL GALLATE, GINKGO BILOBA LEAF EXTRACT, MANNITOL, XYLITOL, RHAMNOSE, FRUCTOOLIGOSACCHARIDES, LAMINARIA OCHROLEUCA EXTRACT, SILICA, TRIDECETH-6, C30-45 ALKYL CETEARYL DIMETHICONE CROSSPOLYMER, LAURYL PEG/PPG-18/18 METHICONE, CAPRYLIC/CAPRIC TRIGLYCERIDE, MINERAL OIL (PARAFFINUM LIQUIDUM), PENTYLENE GLYCOL, 1,2-HEXANEDIOL, PEG/PPG-18/18 DIMETHICONE, CAPRYLYL GLYCOL, PROPYLENE GLYCOL, SODIUM HYDROXIDE, CITRIC ACID, DISODIUM EDTA, FRAGRANCE (PARFUM).\\n\\nVỀ BIODERMA:\\nLà một trong những hãng dược mỹ phẩm tiên phong đến từ Pháp, thành lập từ những năm 1970, BIODERMA đã đạt được những thành tựu độc đáo khi ứng dụng các thành phần và công nghệ sinh học vào việc chăm sóc da và duy trì một làn da khỏe mạnh. Các sản phẩm của BIODERMA mô phỏng cơ chế sinh học tự nhiên của làn da, bắt chước các thành phần và phương thức hoạt động của chúng, từ đó giúp da dung nạp tốt hơn, cải thiện và phục hồi làn da nhưng vẫn tôn trọng quá trình tự nhiên của da, mang lại hiệu quả lâu dài.\\nSản phẩm của Bioderma được các chuyên gia khuyên dùng với độ an toàn \u0026amp; hiệu quả tối ưu, đáp ứng các nhu cầu chăm sóc da ở mọi lứa tuổi. \\n\\nDung tích: 30ml\\nXuất xứ thương hiệu: Pháp\\nNơi sản xuất: Pháp\\nHạn sử dụng: 9 tháng sau khi mở nắp\\nHướng dẫn bảo quản: Nơi thoáng mát, tránh ánh nắng trực tiếp, đậy kín nắp sau khi sử dụng.\\n\\n#sebiumgelmoussant #sebium #bioderma #biodermavietnam \u0026quot;}\" data-sheets-userformat=\"{\u0026quot;2\u0026quot;:13057,\u0026quot;3\u0026quot;:{\u0026quot;1\u0026quot;:0},\u0026quot;11\u0026quot;:3,\u0026quot;12\u0026quot;:0,\u0026quot;15\u0026quot;:\u0026quot;Arial\u0026quot;,\u0026quot;16\u0026quot;:10}\"\u003e*Bao bì có thể thay đổi theo từng đợt nhập hàng.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan data-sheets-value=\"{\u0026quot;1\u0026quot;:2,\u0026quot;2\u0026quot;:\u0026quot;Kem dưỡng se nhỏ lỗ chân lông Sébium Pore Refiner điều chỉnh tiết bã nhờn, giúp lỗ chân lông se nhỏ và mờ dần, ngăn chặn bít tắc lỗ chân lông gây mụn. Thích hợp làm lớp kem dưỡng hoàn hảo trước khi trang điểm.\\n\\nĐỐI TƯỢNG SỬ DỤNG:\\nDành cho da hỗn hợp, da dầu và mụn\\n*Không dùng cho trẻ em dưới 3 tuổi\\n\\nTÁC ĐỘNG SINH HỌC: \\n- Phát minh độc quyền Fluidactiv điều chỉnh chất lượng bã nhờn khỏe mạnh ở mức độ sinh học, khiến lỗ chân lông ít tiết dầu và se nhỏ lại, đồng thời làm giảm tác nhân gây ra mụn. \\n- Phức hợp độc quyền D.A.F được chứng nhận tăng ngưỡng dung nạp và tăng cường đề kháng cho làn da nhạy cảm.\\n- Hoạt chất Agaric acid giúp làm se khít lỗ chân lông và làm mịn da, mang đến hiệu quả tức thì trên da.\\n- Cấu trúc bề mặt da mềm mịn hơn nhờ có salicylic acid và AHA esters\\n- Các chất chống oxy hóa giúp duy trì vẻ đẹp rạng rỡ tự nhiên của làn da suốt ngày dài.\\n\\nĐỘ AN TOÀN:\\nKhông gây kích ứng và gây mụn\\nKhông chứa paraben và cồn\\nMùi hương dịu nhẹ\\nDung nạp tối ưu cho da\\n\\nHƯỚNG DẪN SỬ DỤNG:\\n- Dùng mỗi buổi sáng và/hoặc tối.\\n- Thoa Sébium Pore Refiner lên da sau khi làm sạch da mặt\\nCó thể dùng Sébium Pore Refiner một mình hoặc trước khi thoa kem dưỡng, thoa cả mặt hoặc vùng da tiết nhiều dầu (vùng da chữ T: trán, mũi, cằm)\\n*Dùng kết hợp với Sébium H2O và Sébium Gel Moussant để đạt hiệu quả tối ưu.\\n*Không dùng cho trẻ em dưới 3 tuổi\\n\\nTHÀNH PHẦN: \\nAQUA/WATER/EAU, METHYL METHACRYLATE CROSSPOLYMER, DIPROPYLENE GLYCOL, CYCLOPENTASILOXANE, CYCLOHEXASILOXANE, DIMETHICONE, GLYCERIN, BUTYLENE GLYCOL, FOMES OFFICINALIS (MUSHROOM) EXTRACT, SODIUM POLYACRYLATE, SALICYLIC ACID, DODECYL GALLATE, GINKGO BILOBA LEAF EXTRACT, MANNITOL, XYLITOL, RHAMNOSE, FRUCTOOLIGOSACCHARIDES, LAMINARIA OCHROLEUCA EXTRACT, SILICA, TRIDECETH-6, C30-45 ALKYL CETEARYL DIMETHICONE CROSSPOLYMER, LAURYL PEG/PPG-18/18 METHICONE, CAPRYLIC/CAPRIC TRIGLYCERIDE, MINERAL OIL (PARAFFINUM LIQUIDUM), PENTYLENE GLYCOL, 1,2-HEXANEDIOL, PEG/PPG-18/18 DIMETHICONE, CAPRYLYL GLYCOL, PROPYLENE GLYCOL, SODIUM HYDROXIDE, CITRIC ACID, DISODIUM EDTA, FRAGRANCE (PARFUM).\\n\\nVỀ BIODERMA:\\nLà một trong những hãng dược mỹ phẩm tiên phong đến từ Pháp, thành lập từ những năm 1970, BIODERMA đã đạt được những thành tựu độc đáo khi ứng dụng các thành phần và công nghệ sinh học vào việc chăm sóc da và duy trì một làn da khỏe mạnh. Các sản phẩm của BIODERMA mô phỏng cơ chế sinh học tự nhiên của làn da, bắt chước các thành phần và phương thức hoạt động của chúng, từ đó giúp da dung nạp tốt hơn, cải thiện và phục hồi làn da nhưng vẫn tôn trọng quá trình tự nhiên của da, mang lại hiệu quả lâu dài.\\nSản phẩm của Bioderma được các chuyên gia khuyên dùng với độ an toàn \u0026amp; hiệu quả tối ưu, đáp ứng các nhu cầu chăm sóc da ở mọi lứa tuổi. \\n\\nDung tích: 30ml\\nXuất xứ thương hiệu: Pháp\\nNơi sản xuất: Pháp\\nHạn sử dụng: 9 tháng sau khi mở nắp\\nHướng dẫn bảo quản: Nơi thoáng mát, tránh ánh nắng trực tiếp, đậy kín nắp sau khi sử dụng.\\n\\n#sebiumgelmoussant #sebium #bioderma #biodermavietnam \u0026quot;}\" data-sheets-userformat=\"{\u0026quot;2\u0026quot;:13057,\u0026quot;3\u0026quot;:{\u0026quot;1\u0026quot;:0},\u0026quot;11\u0026quot;:3,\u0026quot;12\u0026quot;:0,\u0026quot;15\u0026quot;:\u0026quot;Arial\u0026quot;,\u0026quot;16\u0026quot;:10}\"\u003eKem dưỡng se nhỏ lỗ chân lông Sébium Pore Refiner điều chỉnh tiết bã nhờn, giúp lỗ chân lông se nhỏ và mờ dần, ngăn chặn bít tắc lỗ chân lông gây mụn. Thích hợp làm lớp kem dưỡng hoàn hảo trước khi trang điểm.\u003cbr /\u003e\u003cbr /\u003eĐỐI TƯỢNG SỬ DỤNG:\u003cbr /\u003eDành cho da hỗn hợp, da dầu và mụn\u003cbr /\u003e*Không dùng cho trẻ em dưới 3 tuổi\u003cbr /\u003e\u003cbr /\u003eTÁC ĐỘNG SINH HỌC: \u003cbr /\u003e- Phát minh độc quyền Fluidactiv điều chỉnh chất lượng bã nhờn khỏe mạnh ở mức độ sinh học, khiến lỗ chân lông ít tiết dầu và se nhỏ lại, đồng thời làm giảm tác nhân gây ra mụn. \u003cbr /\u003e- Phức hợp độc quyền D.A.F được chứng nhận tăng ngưỡng dung nạp và tăng cường đề kháng cho làn da nhạy cảm.\u003cbr /\u003e- Hoạt chất Agaric acid giúp làm se khít lỗ chân lông và làm mịn da, mang đến hiệu quả tức thì trên da.\u003cbr /\u003e- Cấu trúc bề mặt da mềm mịn hơn nhờ có salicylic acid và AHA esters\u003cbr /\u003e- Các chất chống oxy hóa giúp duy trì vẻ đẹp rạng rỡ tự nhiên của làn da suốt ngày dài.\u003cbr /\u003e\u003cbr /\u003eĐỘ AN TOÀN:\u003cbr /\u003eKhông gây kích ứng và gây mụn\u003cbr /\u003eKhông chứa paraben và cồn\u003cbr /\u003eMùi hương dịu nhẹ\u003cbr /\u003eDung nạp tối ưu cho da\u003cbr /\u003e\u003cbr /\u003eHƯỚNG DẪN SỬ DỤNG:\u003cbr /\u003e- Dùng mỗi buổi sáng và/hoặc tối.\u003cbr /\u003e- Thoa Sébium Pore Refiner lên da sau khi làm sạch da mặt\u003cbr /\u003eCó thể dùng Sébium Pore Refiner một mình hoặc trước khi thoa kem dưỡng, thoa cả mặt hoặc vùng da tiết nhiều dầu (vùng da chữ T: trán, mũi, cằm)\u003cbr /\u003e*Dùng kết hợp với Sébium H2O và Sébium Gel Moussant để đạt hiệu quả tối ưu.\u003cbr /\u003e*Không dùng cho trẻ em dưới 3 tuổi\u003cbr /\u003e\u003cbr /\u003eTHÀNH PHẦN: \u003cbr /\u003eAQUA/WATER/EAU, METHYL METHACRYLATE CROSSPOLYMER, DIPROPYLENE GLYCOL, CYCLOPENTASILOXANE, CYCLOHEXASILOXANE, DIMETHICONE, GLYCERIN, BUTYLENE GLYCOL, FOMES OFFICINALIS (MUSHROOM) EXTRACT, SODIUM POLYACRYLATE, SALICYLIC ACID, DODECYL GALLATE, GINKGO BILOBA LEAF EXTRACT, MANNITOL, XYLITOL, RHAMNOSE, FRUCTOOLIGOSACCHARIDES, LAMINARIA OCHROLEUCA EXTRACT, SILICA, TRIDECETH-6, C30-45 ALKYL CETEARYL DIMETHICONE CROSSPOLYMER, LAURYL PEG/PPG-18/18 METHICONE, CAPRYLIC/CAPRIC TRIGLYCERIDE, MINERAL OIL (PARAFFINUM LIQUIDUM), PENTYLENE GLYCOL, 1,2-HEXANEDIOL, PEG/PPG-18/18 DIMETHICONE, CAPRYLYL GLYCOL, PROPYLENE GLYCOL, SODIUM HYDROXIDE, CITRIC ACID, DISODIUM EDTA, FRAGRANCE (PARFUM).\u003cbr /\u003e\u003cbr /\u003eVỀ BIODERMA:\u003cbr /\u003eLà một trong những hãng dược mỹ phẩm tiên phong đến từ Pháp, thành lập từ những năm 1970, BIODERMA đã đạt được những thành tựu độc đáo khi ứng dụng các thành phần và công nghệ sinh học vào việc chăm sóc da và duy trì một làn da khỏe mạnh. Các sản phẩm của BIODERMA mô phỏng cơ chế sinh học tự nhiên của làn da, bắt chước các thành phần và phương thức hoạt động của chúng, từ đó giúp da dung nạp tốt hơn, cải thiện và phục hồi làn da nhưng vẫn tôn trọng quá trình tự nhiên của da, mang lại hiệu quả lâu dài.\u003cbr /\u003eSản phẩm của Bioderma được các chuyên gia khuyên dùng với độ an toàn \u0026amp; hiệu quả tối ưu, đáp ứng các nhu cầu chăm sóc da ở mọi lứa tuổi. \u003cbr /\u003e\u003cbr /\u003eDung tích: 30ml\u003cbr /\u003eXuất xứ thương hiệu: Pháp\u003cbr /\u003eNơi sản xuất: Pháp\u003cbr /\u003eHạn sử dụng: 3 năm kể từ ngày sản xuất\u003cbr /\u003eHướng dẫn bảo quản: Nơi thoáng mát, tránh ánh nắng trực tiếp, đậy kín nắp sau khi sử dụng.\u003cbr /\u003e\u003cbr /\u003e#sebiumgelmoussant #sebium #bioderma #biodermavietnam \u003c/span\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/pro