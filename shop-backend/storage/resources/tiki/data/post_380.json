d_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":47,"review_text":"(47)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/c5/99/56/5b90f014761638e3b4912cccbff1d2d7.png","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":900,"all_time_quantity_sold":212,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: center;\"\u003e\u003cstrong\u003eLót chuột Logitech Studio Series - Đế cao su chống trượt, lướt dễ dàng, bề mặt chống đổ tràn, bền bỉ, nhỏ gọn, hiện đại – Hồng, Xanh, Đen\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003eLót chuột Logitech Studio Series là phụ kiện mềm mịn với đế chống trượt giúp đưa không gian làm việc của bạn lên tầm cao mới. Được làm từ vật liệu cao cấp, bề mặt vải mềm mịn, thoải mái để trải nghiệm lướt dễ dàng và yên tĩnh - dù ở văn phòng hay tại nhà\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/b2/eb/ed/a7b544b995ab7661bb168910eda503a5.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cstrong\u003eLƯỚT NHẸ NHÀNG\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003eBề mặt vải mềm mịn, thoải mái được làm từ vật liệu cao cấp để trải nghiệm lướt dễ dàng và yên tĩnh - dù ở văn phòng hay tại nhà\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/5f/2e/41/3da26abb930e49dbbfb451ebd025eb21.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cstrong\u003eCHỐNG THẤM NƯỚC ĐỔ TRÀN\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003eTấm lót chuột (Mouse Pad) của Logitech là lớp phủ chống nước, chịu được các sự cố ngẫu nhiên, do đó chất lỏng có thể được lau sạch (Đã được kiểm nghiệm trong các điều kiện giới hạn. Lau sạch bằng một miếng vải ẩm sau tối đa 2 phút\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/bc/bc/85/25cfd2677b5c426bb91cf256c2725bce.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cstrong\u003eVẬT LIỆU ĐƯỢC CHỌN LỰA CẨN THẬN\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003engăn cho tấm lót khỏi bị nhăn và co lại, trong khi thiết kế đường may thẳng bảo vệ các cạnh khỏi bị sờn. Lớp đế chống trượt bao gồm cao su tự nhiên.\u003cbr /\u003e\u003cstrong\u003eVẺ ĐẸP VƯỢT THỜI GIAN: \u003c/strong\u003eLớp lót trong được làm từ polyeste tái chế, đem lại cho các chai PET một vòng đời thứ hai\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/6a/7c/86/b5ce70feccf81fb4312b8511acac7585.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/6e/0f/5a/2cb628a17139c512290512c141747fa4.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/ff/81/52/8a156311376c7e127d8a61f273887f89.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cstrong\u003eKẾT HỢP VỚI CÁC CHUỘT LOGITECH\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003eSự kết hợp hoàn hảo giữa lót chuột và các thiết bị chuột phím từ Logitech để tôn lên không gian làm việc của chính bạn. Có các màu các màu \u003cstrong\u003eHồng đậm, Xanh và Đen\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003e\u003cstrong\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/5f/29/40/c075b460b015cef83c34c22528193130.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003e\u003cstrong\u003eThông số kỹ thuật:\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003eKích thước: 20 x 23 cm\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003eĐộ dày: 2 mm với đế cao su\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003eTrọng lượng: 73 g\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/c5/99/56/5b90f014761638e3b4912cccbff1d2d7.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c5/99/56/5b90f014761638e3b4912cccbff1d2d7.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c5/99/56/5b90f014761638e3b4912cccbff1d2d7.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c5/99/56/5b90f014761638e3b4912cccbff1d2d7.png","thumbna