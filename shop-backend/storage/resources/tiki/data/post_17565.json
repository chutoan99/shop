l,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/db/1a/74/eeb7fa7327630b2909b50ed10547640a.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1022,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2 style=\"text-align: center;\"\u003e\u003cstrong\u003eTAI NGHE CHỐNG ỒN SIÊU NHỎ EARFUN FREE PRO 2\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cstrong\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/c9/38/a5/1fb40ba1c73fad6a0642b23f3601be77.jpg\" alt=\"\" width=\"750\" height=\"470\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e \u003c/p\u003e\n\u003ch3\u003e\u003cem\u003e\u003cstrong\u003eTai nghe chống ồn với thiết kế siêu nhỏ, mặt cảm ứng điều khiển\u003c/strong\u003e\u003c/em\u003e\u003c/h3\u003e\n\u003cp\u003eLà thành viên mới nhất trong bộ sưu tập sản phẩm của EarFun, Free Pro 2 đem tới nhiều những tính năng cao cấp với một mức giá mà bất cứ ai cũng có thể tiếp cận được. Trong đó nổi bật nhất chắc chắn sẽ là công nghệ chống ồn chủ động QuietSmart 2.0, có khả năng chặn tới 40dB những tạp âm ngoài môi trường để bạn có một không gian nghe nhạc yên tĩnh nhất có thể.\u003c/p\u003e\n\u003cp\u003eTai nghe có thiết kế rất nhỏ nhắn, có thể đeo lọt vào trong vành tai của cả những bạn có tai nhỏ nhất. Mặt ngoài của tai là những mặt cảm ứng, với đầy đủ tính năng từ chỉnh bài hát, nhận cuộc gọi, gọi trợ lý ảo, chỉnh âm lượng và bật tắt chống ồn.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/df/27/23/485b845108af06a6175ced8d164de55c.jpg\" alt=\"\" width=\"750\" height=\"435\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e \u003c/p\u003e\n\u003ch3\u003e\u003cem\u003e\u003cstrong\u003eThời lượng lên tới 30 tiếng, sạc nhanh và sạc không dây\u003c/strong\u003e\u003c/em\u003e\u003c/h3\u003e\n\u003cp\u003eCó thiết kế rất nhỏ nhắn nhưng EarFun Free Pro 2 không đánh đổi về thời lượng pin. Trong một lần sạc đầy, tai nghe có thể sử dụng để nghe nhạc liên tiếp trong 6 tiếng, sạc lại thêm 4 lần với hộp sạc để nâng thời lượng lên 30 tiếng. Free Pro 2 cũng tích hợp các công nghệ sạc tân tiến như sạc nhanh với chỉ 10 phút để tiếp tục dùng trong 2 tiếng, sạc không dây chuẩn Qi.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/c7/f8/94/f4d4f8348e3065da6d06330685b4e50d.jpg\" alt=\"\" width=\"750\" height=\"466\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e \u003c/p\u003e\n\u003ch3\u003e\u003cem\u003e\u003cstrong\u003eBluetooth 5.2 và độ trễ thấp dưới 80ms\u003c/strong\u003e\u003c/em\u003e\u003c/h3\u003e\n\u003cp\u003eĐiều khiển chức năng của tai nghe là con chip Airoha AB1562A thế hệ mới nhất, đem tới chuẩn Bluetooth 5.2 với độ trễ đo được dưới 80ms. Nhờ đó tai nghe ngoài việc có thể dùng để nghe nhạc thì luôn sẵn sàng cho việc giải trí với game và phim\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/d6/dc/a1/d00f089e82b2e8cbd72fcc8126fe2d87.jpg\" alt=\"\" width=\"750\" height=\"372\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e \u003c/p\u003e\n\u003ch3\u003e\u003cem\u003e\u003cstrong\u003eMàng loa Composite kép với chất âm cân bằng, chống nước IPX5\u003c/strong\u003e\u003c/em\u003e\u003c/h3\u003e\n\u003cp\u003eDành cho phần tái tạo âm thanh, EarFun được tích hợp màng loa Composite kép độ lớn 6mm. Màng loa này có thể di chuyển một cách chính xác hơn những loại Dynamic thông thường, từ đó tạo ra chất âm cân bằng và có độ chi tiết cao.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/04/74/e4/612159bef094ab80f9f2edbad7a066c7.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003eMột tính năng cũng không thể không nhắc tới là chống nước IPX5, cho phép tai nghe có thể dùng để đi tập thể dục, tránh hỏng hóc bởi những tai nạn với nước không đáng có trong quá trình sử dụng hàng ngày.\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/cb/80/ee/c4b23f51208a1c8ee002a9ea79102e1c.jpg\" alt=\"\" width=\"750\" height=\"467\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e \u003c/p\u003e\n\u003ch3 style=\"text-align: center;\"\u003e\u003cstrong\u003eSO SÁNH VỚI NHỮNG MẪU TAI NGHE NỔI BẬT:\u003c/strong\u003e\u003c/h3\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cstrong\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/f4/27/13/b0c843c408ec1f8c89ceee0e44e24804.jpg\" alt=\"\" width=\"750\" height=\"427\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e \u003c/p\u003e\n\u003ch3 style=\"text-align: center;\"\u003e\u003cstrong\u003ePhụ kiện đi kèm tai nghe Earfun Free Pro 2\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cstrong\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/2e/0b/55/01d330dcb74f7ea55292c73db5030781.jpg\" alt=\"\" width=\"750\" height=\"449\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e \u003c/p\u003e\n\u003ch3 class=\"tab-title\"\u003eTHÔNG SỐ KỸ THUẬT\u003c/h3\u003e\n\u003cdiv class=\"tab-content\"\u003e\n\u003cul style=\"list-style-type: disc;\"\u003e\n\u003cli\u003eMàng loa Composite kép 6mm\u003c/li\u003e\n\u003cli\u003eTrọng lượng siêu nhẹ 38g\u003c/li\u003e\n\u003cli\u003eBluetooth 5.2 với độ trễ \u0026lt;80ms\u003c/li\u003e\n\u003cli\u003eThời lượng sử dụng độc lập: 6 tiếng\u003c/li\u003e\n\u003cli\u003eThời lượng sử dụng với hộp: 30 tiếng\u003c/li\u003e\n\u003cli\u003eChống ồn QuietSmart 2.0 và chống ồn mic ENC\u003c/li\u003e\n\u003cli\u003eChống nước IPX5\u003c/li\u003e\n\u003cli\u003eSạc không dây Qi, sạc nhanh 10 phút cho 2 tiếng dùng\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/db/1a/74/eeb7fa7327630b2909b50ed10547640a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/db/1a/74/eeb7fa7327630b2909b50ed10547640a.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/db/1a/74/eeb7fa7327630b2909b50ed10547640a.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/db/1a/74/eeb7fa7327630b2909b50ed10547640a.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/db/1a/74/eeb7fa7327630b2909b50ed10547640a.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/04/b5/d0/69b0