0,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.5,"review_count":62,"review_text":"(62)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/c7/95/ba/923e7a53b64339f5f70ad6dcc36a9889.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2027,"all_time_quantity_sold":281,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: center;\"\u003e\u003cspan style=\"font-size: 15pt; color: #ff0000;\"\u003e\u003cstrong\u003eĐèn Bắt Muỗi Điện Quang ĐQ EML06L (380x65x250mm)\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cspan style=\"font-size: 11pt; color: #000000;\"\u003e\u003cem\u003e\u003cstrong\u003eĐÈN BẮT MUỖI ĐIỆN QUANG - GIẢI PHÁP DIỆT MUỖI AN TOÀN, HIỆU QUẢ, TIỆN LỢI!\u003c/strong\u003e\u003c/em\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"//\" width=\"750\" height=\"525\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003eThời tiết nóng bức, không khí ẩm thấp tạo cơ hội cho muỗi quấy hoành hành. Vậy làm sao để giải quyết tình trạng trên. Hãy để Điện Quang giúp bạn nhé!\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003eMột sản phẩm mới, tiện dụng cho bạn: Đèn bắt muỗi Điện Quang, sử dụng diệt muỗi trong nhà, nơi muỗi có thể ẩn náu. Với những ưu việt không ngờ:\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003eThiết bị này không dùng hóa chất để đuổi hay thu hút lũ muỗi vì vậy không độc hại.\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003eThiết bị này không dùng sóng siêu âm tần số cao dẫn đến không gây hại cho thính giác.\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003eMặc dù sử dụng trực tiếp điện lưới nhưng nguồn điện ở lưới diệt muỗi lại rất an toàn cho người sử dụng. Bên ngoài cũng đã cho thêm một lớp lưới bằng nhựa bảo vệ cho bạn.\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e1/ ĐIỂM ĐẶC BIỆT SẢN PHẨM:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eĐèn bắt muỗi Điện Quang được thiết kế với cấu trúc chắc chắn\u003c/li\u003e\n\u003cli\u003eĐèn được \u003cspan style=\"color: #ff0000;\"\u003e\u003cstrong\u003elồng ghép chất liệu nhôm và nhựa có độ bền cao\u003c/strong\u003e\u003c/span\u003e, tạo nên sự an toàn với người sử dụng\u003c/li\u003e\n\u003cli\u003eLưới điện được làm bằng kim loại\u003c/li\u003e\n\u003cli\u003e\u003cspan style=\"color: #ff0000;\"\u003e\u003cstrong\u003eLưới bảo vệ được thiết kế hai mặt\u003c/strong\u003e\u003c/span\u003e rất an toàn\u003c/li\u003e\n\u003cli\u003eVới 2 bóng LED tube chuyên dụng tạo nên ánh sáng thu hút muỗi hiệu quả, \u003cspan style=\"color: #ff0000;\"\u003e\u003cstrong\u003ekhông gây ảnh hưởng cho người và vật nuôi\u003c/strong\u003e.\u003c/span\u003e\u003c/li\u003e\n\u003cli\u003eSử dụng rất đơn giản, chỉ cần cắm điện và bật công tắc đèn sẽ hoạt động\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003e2/ THÔNG SỐ KỸ THUẬT\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e* Thông số điện:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Dải điện áp đầu vào: 220V- 230V\u003c/p\u003e\n\u003cp\u003e- Tần số: 50Hz\u003c/p\u003e\n\u003cp\u003e- Công suất đèn: 4.5W\u003c/p\u003e\n\u003cp\u003e\