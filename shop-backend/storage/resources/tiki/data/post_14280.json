56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.8,"review_count":148,"review_text":"(148)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/07/f8/93/8ab726337fc055df54211fe277e87cde.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1535,"all_time_quantity_sold":1519,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cem\u003e\u003cstrong\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/09/20/dc/1d99189d9f79e30af690ee1357291d8c.jpg\" alt=\"\" width=\"750\" height=\"421\" /\u003e\u003c/strong\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cstrong\u003eNếp cẩm\u003c/strong\u003e\u003c/em\u003e còn được gọi là “bổ huyết mễ”, là một loại gạo có thành phần dinh dưỡng rất cao vì cám vẫn còn nguyên, hạt gạo không được chế biến như gạo trắng. So với các loại gạo khác, nếp cẩm có hàm lượng protein cao hơn 6,8% và chất béo cao hơn 20%. Không chỉ thế, nó còn chứa tới 8 loại axit amin cùng carotene và các nguyên tố vi lượng cần thiết. Trong gạo nếp cẩm chứa chất xơ, chất chống oxy hóa tương đương với quả việt quất hay quả mâm xôi, đặc biệt là nguồn vitamin E phong phú.\u003c/p\u003e\n\u003cp\u003eNgoài ra vỏ cám màu tím đen của gạo có chứa nhiều Anthocyanins. Chất  này có công dụng chống Oxy hóa mạnh, giúp giảm trừ nhiều bệnh như tiểu đường, gout, ngăn ngừa loãng xương, chống lão hóa, cải thiện thần kinh, giảm nguy cơ bệnh Alzheimer và Parkinson, bảo vệ đục thủy tinh thể, bệnh quáng gà.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/5b/bd/a2/4d94bd3b73565388e6e34abaa793b625.jpg\" alt=\"\" width=\"746\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCÔNG DỤNG CỦA GẠO NẾP CẨM\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cstrong\u003eBảo vệ tim mạch\u003c/strong\u003e\u003c/em\u003e: Theo các nghiên cứu gạo nếp cẩm có tác dụng giảm nguy cơ mắc bệnh tim mạch, bảo vệ động mạch ngăn chặn các cơn đau tim đột quỵ. Các chất phytochemical trong gạo nếp cẩm cân bằng lượng cholesterol trong cơ thể.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cem\u003eGiải độc cơ thể\u003c/em\u003e:\u003c/strong\u003e Lý do vì trong gạo nếp cẩm có thành phần dinh dưỡng rất cao, giúp làm sạch gan, đào thải độc tố tích tụ trong cơ thể. Đặc biệt là chất chống oxy hóa sẽ hỗ trợ quá trình giải độc, giúp cơ thể khỏe mạnh hơn, giảm đáng kể tình trạng viêm nhiễm.\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cstrong\u003eNgăn ngừa tiểu đường:\u003c/strong\u003e\u003c/em\u003e Giá trị dinh dưỡng từ gạo nếp cẩm đáng để được nhắc đến khi nó có tác dụng trong việc ngăn ngừa bệnh tiểu đường. Chất xơ từ hạt gạo có thể giúp glucose (đường) từ hạt được cơ thể hấp thụ trong một khoảng thời gian dài hơn.\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cstrong\u003eBảo vệ tốt hệ tiêu hóa:\u003c/strong\u003e\u003c/em\u003e Vì có chứa chất xơ từ đó ngăn ngừa táo bón đầy hơi và các triệu chứng liên quan đến hệ tiêu hóa khác. Không chỉ tốt cho những đối tượng giảm cân với những bệnh nhân mắc bệnh đường ruột, gạo nếp cẩm cũng là một bài thuốc hiệu quả.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cem\u003eNgăn ngừa béo phì\u003c/em\u003e:\u003c/strong\u003e Các chất dinh dưỡng trong gạo nếp cẩm đảm bảo ổn định năng lượng cơ thể, giảm cảm giác thèm ăn. Bên cạnh đó, gạo nếp cẩm có tác dụng kháng insulin từ đó ngăn chặn nguy cơ béo phì.\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cstrong\u003eGiúp làm đẹp:\u003c/strong\u003e\u003c/em\u003e Lớp màng đen bên ngoài của nếp cẩm chứa nhiều vitamin E. Đặc biệt, nếp cẩm lên men còn chứa nhóm vitamin B cùng nhiều vi chất có lợi khác. Vì thế, loại gạo này còn được sử dụng với mục đích làm đẹp, giúp làm ẩm và phục hồi làn da một cách hiệu quả.\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cstrong\u003eTốt cho phụ nữ sau sinh:\u003c/strong\u003e\u003c/em\u003e Trong nếp cẩm có chứa protein, canxi, phốt, sắt, kẽm… và một nhất là hàm lượng vitamin C, chất diệp lục thường không có trong các loại nếp khác. Mẹ sau sinh nếu thường xuyên ăn nếp cẩm sẽ giúp cho dạ dày hoạt động tốt. Ngoài ra còn giúp cơ thể lưu thông khí huyết, chống suy nhược, tăng lượng sữa cho con.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eNHỮNG MÓN ĂN NGON VỚI GẠO NẾP CẨM\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eXôi Nếp Cẩm:\u003c/strong\u003e Ăn xôi nếp cẩm vừa tốt cho hệ tiêu hoá, tốt cho tim mạch, bổ máu, lại giúp giúp bạn có một làn da mịn màng, tươi sáng, vóc dáng cân đối.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/09/20/dc/57f3fe7935dc14dec238097dcc8caa48.jpg\" alt=\"\" width=\"750\" height=\"421\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eSữa chua nếp cẩm:\u003c/strong\u003e Sữa chua nếp cẩm được rất nhiều chị em mê mẩn không chỉ làm thực phẩm mà còn được dùng làm đẹp da cho chị em. Có thể nấu nếp cẩm rồi trộ với sữa chua hoặc dùng nếp cẩm đã lên men như trên để trộn cùng sữa chua là bạn đã có món ăn khoái khẩu mà bổ dưỡng.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/92/8b/ed/1110ab9e72c510baaffd9fe0e9dfbd1e.jpg\" alt=\"\" width=\"600\" height=\"400\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eChè nếp cẩm:\u003c/strong\u003e Đây cũng là món được rất nhiều gia đình yêu thích\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/cf/e3/40/aa1b7086bd51a0a564f6252b49497292.jpg\" alt=\"\" width=\"750\" height=\"457\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cstrong\u003eChú ý\u003c/strong\u003e\u003c/em\u003e những người mới phẫu thuật, người có những chỗ bị sưng viêm nên tránh ăn các sản phẩm làm từ nếp.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e#gaonepcam #gaolutden \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/07/f8/93/8ab726337fc055df54211fe277e87cde.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/07/f8/93/8ab726337fc055df54211fe277e87cde.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/07/f8/93/8ab726337fc055df54211fe277e87cde.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/07/f8/93/8ab726337fc055df54211fe277e87cde.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/07/f8/93/8ab726337fc055df54211fe277e87cde.jpg"},{"base_url":"https://salt.tikicdn.com/media/catalog/producttmp/79/07/67/d0d1f89db7a0f2b859861848ceef8187.jpg","is_gallery":true,"