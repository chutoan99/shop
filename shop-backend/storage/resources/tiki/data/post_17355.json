596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":110000,"discount_rate":9,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/6b/69/f4/61c789b9a7dd0c820d82cdd49c0eec5d.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":811,"all_time_quantity_sold":45,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eCÂN ĐIỆN TỬ CHỈ SỐ BMI OMRON HN-300T2 - KẾT NỐI ĐIỆN THOẠI - THƯƠNG HIỆU NHẬT BẢN\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eTÍNH NĂNG SẢN PHẨM\u003c/p\u003e\n\u003cp\u003eCông nghệ chính xác 4 cảm biến\u003c/p\u003e\n\u003cp\u003eĐo chỉ số khối cơ thể BIM\u003c/p\u003e\n\u003cp\u003eKết nối Bluetooth với điện thoại; sử dụng ứng dụng Omron Connect giúp bạn dễ dàng lưu, theo dõi và quản lý dữ liệu sức khỏe.\u003c/p\u003e\n\u003cp\u003eTrọng lượng cơ thể\u003c/p\u003e\n\u003cp\u003eHiển thị chính xác mức sai số thấp nhất\u003c/p\u003e\n\u003cp\u003eKính cường lực đảm bảo an toàn \u003c/p\u003e\n\u003cp\u003eChức năng Bật/Tắt tự động\u003c/p\u003e\n\u003cp\u003eCác chỉ số kg / lb / st có thể lựa chọn\u003c/p\u003e\n\u003cp\u003eĐo trọng lượng lên đến 150kg\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eTHÔNG TIN THƯƠNG HIỆU\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eTập đoàn Omron được thành lập năm 1933, với trụ sở chính đặt tại Kyoto, Nhật Bản. Mở rộng và hoạt động ở Châu Á, Châu Mỹ, Châu Úc và Châu Âu. Với công nghệ “cảm biến thông tin sinh học” đảm bảo độ chính xác cao trong các thiết bị kiểm tra sức khỏe, \u003c/p\u003e\n\u003cp\u003eTất cả các loại máy đo huyết áp, nhiệt kế điện tử OMRON đã được Hiệp hội y tế Hoa Kỳ, Hiệp hội tăng huyết áp Anh, Hiệp hội tăng huyết áp Châu Âu chứng nhận lâm sàng về độ chính xác và an toàn khi sử dụng.\u003c/p\u003e\n\u003cp\u003e- Linh kiện chính được sản xuất tại Omron Healthcare, Kyoto, Nhật Bản  \u003c/p\u003e\n\u003cp\u003e- Lắp ráp tại nhà máy Omron Dalian, số 3 Song Jiang, Trung Quốc\u003c/p\u003e\n\u003cp\u003e- Công ty chịu trách nhiệm nhập khẩu và phân phối: Công ty TNHH DKSH Việt Nam.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e---------\u003c/p\u003e\n\u003cp\u003e* LƯU Ý: \u003c/p\u003e\n\u003cp\u003eOmron chỉ xuất hóa đơn điện tử. Khách hàng cần hóa đơn (cùng hay khác với thông tin đặt hàng) vui lòng chat trực tiếp với chúng tôi: Thông tin xuất hóa đơn gồm: Tên công ty, MST, Địa chỉ, Địa chỉ thư điện tử. Chùng tôi sẽ gửi hóa đơn qua thư điện tử và không nhận thông tin qua phần GHI CHÚ trong đơn hàng. \u003c/p\u003e\n\u003cp\u003e- Khi nhận sản phẩm có giá trị cao, Quý khách vui lòng quay clip khi mở thùng hàng. Trong trường hợp sai/ thiếu hoặc không có sản phẩm trong hộp, Omron chỉ chấp nhận xử lý khi có đủ clip, hình ảnh kèm theo phiếu mua hàng có trong thùng hàng. Omron sẽ kiểm tra và xử lý cho khách nhé. \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e----------\u003c/p\u003e\n\u003cp\u003eHƯỚNG DẪN ĐĂNG KÝ BẢO HÀNH ONLINE \u003c/p\u003e\n\u003cp\u003eBước 1: Chụp hình tem của nhà phân phối cùng số seri máy trên vỏ hộp \u003c/p\u003e\n\u003cp\u003eBước 2: Sử dụng máy ảnh trên điện thoại quét mã QR code hoặc truy cập vào  \u003c/p\u003e\n\u003cp\u003eBước 3: Điền các thông tin cần thiết và tải hình chụp ở bước 1 lên. Hoàn thành đăng ký!\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p