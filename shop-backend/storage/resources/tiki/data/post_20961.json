"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":88000,"discount_rate":29,"rating_average":5,"review_count":18,"review_text":"(18)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/37/b3/a5/82357f21471ec744dcf07e13ece094db.png","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":474,"all_time_quantity_sold":135,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2\u003e\u003cstrong\u003eKính Bơi Tráng Gương kèm bịt tai cao cấp VinBuy chống sương mù, chống tia UV Hàng chính hãng - Tặng kèm nón bơi Silicon (Màu ngẫu nhiên)\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003e\u003cstrong\u003eĐặc tính sản phẩm:\u003c/strong\u003e\u003c/p\u003e\n\u003col\u003e\u003cli\u003eTròng kính được làm từ chất liệu PC với độ trong suốt, tính quang học cực cao. Đồng thời, bề mặt kính rất cứng, chống mài mòn và chống tia cực tím.\u003c/li\u003e\n\u003cli\u003eMặt kính được phủ lớp chống tia UV, giúp mắt an toàn khi đi biển\u003c/li\u003e\n\u003cli\u003eBề mặt bên trong của tròng kính sử dụng chất chống sương mù (hơi nước) chuyên dụng, chống thấm nước, không gây kích ứng cho mắt, cho tầm quan sát rõ ràng trong mọi môi trường nước.\u003c/li\u003e\n\u003cli\u003eLớp ngoài cùng được tráng gương, giúp mắt không bị chói khi trời nắng, tăng thêm sự cuốn hút.\u003c/li\u003e\n\u003cli\u003ePhần nối 2 tròng kính được làm từ chất liệu PU thân thiện với môi trường có độ dẻo dai rất cao.\u003c/li\u003e\n\u003cli\u003eVòng cao su chụp mắt được làm 100% silicone không gây kích ứng da. Được thiết kế theo nhân trắc học, giúp kính ôm sát mắt, chống vào nước và giúp mở rộng tối đa góc nhìn khi đeo.\u003c/li\u003e\n\u003cli\u003eDây đeo được làm 100% silicone mềm mại, thoải mái, thiết kế không trơn trượt, độ co giãn và độ bền thách thức thời gian.\u003c/li\u003e\n\u003c/ol\u003e\u003cp\u003e\u003cstrong\u003eHướng dẫn sử dụng và bảo quản sản phẩm:\u003c/strong\u003e\u003c/p\u003e\n\u003col\u003e\u003cli\u003eNgâm nước bên trong tròng kính trước khi đeo giúp tăng hiệu quả chống sương.\u003c/li\u003e\n\u003cli\u003eSau khi sử dụng kính dùng nước sạch để rửa và để khô tự nhiên, tránh lau bên trong tròng kính sẽ làm mất tác dụng của lớp phủ chống sương mù.\u003c/li\u003e\n\u003cli\u003eĐeo cố định vị trí mắt trước, kéo dây ra sau đầu. Điều chỉnh dây đeo cho phù hợp với đầu.\u003c/li\u003e\n\u003cli\u003eThao tác ngược lại khi không dùng kính nữa.\u003c/li\u003e\n\u003cli\u003eĐặt kính vào hộp trở lại sau khi kính đã khô tự nhiên, nếu được hãy đặt miếng chống ẩm để bảo quản kính tốt nhất.\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/c0/50/56/e6ed350fde41b6542f10f1a0729ec613.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/8a/0b/e0/d96ba20e36633944c0bb83a2e60f5eb7.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/b4/42/d3/a649a77e9ffd982f16f1a86261074768.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/65/1e/95/39b56ce687c48b2bd945777dc3384fd1.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=