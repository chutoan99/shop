":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/9c/e8/d3/6c6a06499e465adc24708670166d8d35.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":683,"all_time_quantity_sold":10,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align:justify;\"\u003eViên Uống Hỗ Trợ Phát Triển Chiều Cao VIPTEEN VINH GIA Cho Trẻ Từ 9-18 Tuổi Hộp 20 Viên \u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/35/53/4f/51ea83813f73ecb442d4fa402ea414c9.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e1. THÔNG TIN SẢN PHẨM\u003cbr /\u003e- Tên sản phẩm: Viên Uống Hỗ Trợ Phát Triển Chiều Cao VIPTEEN VINH GIA\u003cbr /\u003e- Thương hiệu: VINH GIA\u003cbr /\u003e- Xuất xứ: Việt Nam\u003cbr /\u003e- Quy cách hộp: 20 viên\u003cbr /\u003e- Hạn sử dụng: 24 tháng\u003cbr /\u003e- Viên uống hỗ trợ phát triển chiều cao cho trẻ từ 9 tuổi và thanh thiếu niên giúp bổ sung canxi, vitamin D cải thiện chiều cao và xương chắc khỏe.\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e2. THÀNH PHẦN\u003cbr /\u003e- Menaquinon-7 (MK7), Vitamin D3, Calci Carbonat (dạng nano), Magnesium Oxide, Zinc Oxide nano (Kẽm oxyd dạng nano), Chelate Boron amino acid, Manganese gluconate, Copper Gluconate (Đồng gluconate), Natri chondroitin sulphate, Horsetail Extract (Equisetum Arvense) ( chiết xuất cỏ đuôi ngựa), DHA, Acid Folic, Vitamin B1, Vitamin B6.\u003cbr /\u003e- Thành phần khác: lactose monohydrat, PVP K30, magnesi stearat, ethanol 96%\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/83/19/54/bfd100563d47900e6f4fa8795a36b062.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e3. CÔNG DỤNG\u003cbr /\u003e- Viên uống giúp bổ sung canxi, vitamin D, MK7 (vitamin K2), hỗ trợ xương răng chắc khỏe.\u003cbr /\u003e- Hỗ trợ giúp phát triển chiều cao và hỗ trợ hạn chế nguy cơ còi xương, thấp còi.\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/02/0e/95/76fb08e5afe96735b203fb4294714c0b.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e4. CÁCH DÙNG\u003cbr /\u003e- Uống mỗi lần 2 viên, ngày 2 lần (sáng/ chiều). \u003cbr /\u003e- Nên uống trước bữa ăn 30 phút hoặc sau khi ăn 1 giờ. \u003cbr /\u003e- Nên sử dụng thành từng đợt từ 3-6 tháng để có kết quả tốt. \u003cbr /\u003e- Có thể sử dụng hàng ngày và thường xuyên để thu được kết quả tốt \u003cbr /\u003e- Để đạt kết quả tốt, cần kết hợp với việc ăn uống đủ dưỡng chất, sinh hoạt điều độ, tập thể dục đều đặn và ngủ đủ giấc.\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e5. ĐỐI TƯỢNG SỬ DỤNG\u003cbr /\u003e+ Thanh thiếu niên và trẻ em từ 9 tuổi trở lên, trẻ em đang trong giai đoạn phát triển.\u003cbr /\u003e+ Trẻ còi xương, thiếu Canxi, vitamin D.\u003cbr /\u003e#vipteen#vipteenvinhgia#vienuong#vienuongphattrienchieucao#vienuongphattrienchieucaochotre#vienuongphattrienchieucaochotretu9tuoi#v\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"b