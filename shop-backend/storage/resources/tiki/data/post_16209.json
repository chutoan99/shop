d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":89000,"discount_rate":18,"rating_average":4.8,"review_count":75,"review_text":"(75)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/75/d7/7b/23dd1f8750ce35fb8ab8a087bcc5ae9d.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":812,"all_time_quantity_sold":184,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eVới trọng lượng 0.57 kg siêu nhẹ cùng với đầy đủ chức năng, thiết kế thời trang, bắt kịp xu hướng mới, \u003cstrong\u003eBalo Laptop 865 (hoặc mã cũ 744) \u003c/strong\u003ethích hợp với mọi đối tượng với các công việc khác nhau như sinh viên, học sinh, công sở, \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTHIẾT KẾ THỜI TRANG\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eBalo Laptop 744 với thiết kế lấy từ phong cách thời trang đơn giản, thanh lịch. Với các ngăn phụ, các chi tiết tạo điểm nhấn được may tỉ mỉ và kết hợp hài hòa với nhau.  Điểm nhấn của balo laptop 744 có thêm một cổng USB ở bên hông balo, giúp bạn có thể dễ dàng kết nối sạc dự phòng và điện thoại của bạn thông qua cổng đó.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/b6/ab/9c/c7fa3c457c8162e605e7dfd52b3df505.jpg\" alt=\"\" width=\"650\" height=\"650\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCHẤT LIỆU SIÊU BỀN, NHẸ\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eBalo Laptop 744 được sử dụng chất liệu Polyester siêu nhẹ, hạn chế thấm nước và bám bụi kết hợp với vải Poly Oxford chống ẩm, chống mùi hôi được lót bên trong, sẽ là bộ đôi bảo vệ thật tốt cho laptop và các vật dụng bên trong balo của bạn.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/0c/77/ed/2fee87f844e949196b5d99414d212da3.jpg\" alt=\"\" width=\"650\" height=\"650\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eNGĂN CHỨA RỘNG RÃI, ĐA DẠNG\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eNội thất bên trong ngăn chính balo khá rộng rãi, ngăn laptop có thể chứa laptop lên đến 17 inch, đệm lót ngăn laptop được may khá dày, bảo vệ tốt cho laptop của bạn khi có va đập. Ngoài ra, ngoài chức năng đựng laptop, bạn có thể chứa thêm nhiều hồ sơ, sách vở,\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/d7/a6/3a/d5f55a3f0acdf4390eb0e4f43e4e2ce7.jpg\" alt=\"\" width=\"650\" height=\"650\" /\u003e\u003c/p\u003e\n\u003cp\u003eKèm theo đó, phía trước balo trang bị thêm ngăn chứa các vật dụng được thiết kế thông minh để bạn có thể sắp xếp gọn gàng các đồ dùng nhỏ như sổ, đồng hồ, thẻ xe, điện thoại, bút viết, tránh tình trạng thất lạc và tiết kiệm thời gian hơn khi bạn tìm kiếm.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/5f/04/78/fcf0066d213ba5c2f6ed42b4038f3488.jpg\" alt=\"\" width=\"650\" height=\"650\" /\u003e\u003c/p\u003e\n\u003cp\u003eHai bên hông balo còn có thêm ngăn lưới đựng nước, điện thoại, Chiếc Balo Laptop 744 đa năng sẽ là người bạn hỗ trợ tốt cho bạn khi đang di chuyển. \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/bf/d9/16/47312604d437f3aad09e6bc9ea1d7cac.jpg\" alt=\"\" width=\"650\" height=\"650\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eĐỆM LƯNG THOÁNG KHÍ - QUAI ĐEO CHẮC CHẮN\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eĐệm lưới phía sau balo phân tán khí, giúp lưng bạn luôn được khô thoáng và giảm thiểu tối đa tình trạng đau lưng với những người sử dụng balo trong thời gian dài hoặc sử dụng mang nhiều vật nặng.\u003c/p\u003e\n\u003cp\u003eQuai đeo được lót lớp đệm mỏng, không gây siết và bạn có thể tùy chỉnh độ dài quai đeo thích hợp với từng vóc dáng. Quai đeo còn được nhấn nhá thêm đoạn phản quang phát sáng khi trời tối, bảo vệ cho bạn khi phải đi học, đi làm, vào ban đêm.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/08/08/61/6a519742e951f962da20af1f04a3d88e.jpg\" alt=\"\" width=\"650\" height=\"650\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eHƯỚNG DẪN SỬ DỤNG\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e- Không ngâm giặc trong nước.\u003c/p\u003e\n\u003cp\u003e- Không dùng chất tẩy rửa.\u003c/p\u003e\n\u003cp\u003e- Không là (ủi).\u003c/p\u003e\n\u003cp\u003e- Không sấy khô.\u003c/p\u003e\n\u003cp\u003e- Không chứa vật quá tải trọng cho phép (Xem Thông số kỹ thuật).\u003c/p\u003e\n\u003cp\u003e- Bảo quản nơi khô ráo, thoáng mát.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/75/d7/7b/23dd1f8750ce35fb8ab8a087bcc5ae9d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/75/d7/7b/23dd1f8750ce35fb8ab8a087bcc5ae9d.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/