y_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/c7/2a/35/c5545c997f6e1666d918ccfe8575f19f.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":933,"all_time_quantity_sold":15,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cspan data-spm-anchor-id=\"a2o4n.pdp_revamp.product_\"\u003eNăm xuất bản: 2022\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003eKích thước: 15.5 x 23cm\u003c/p\u003e\n\u003cp\u003eLoại bìa: Bìa mềm\u003c/p\u003e\n\u003cp\u003eSố trang: 32\u003c/p\u003e\n\u003cp\u003eNgôn ngữ: Song ngữ (Anh + Việt)\u003c/p\u003e\n\u003cp\u003eĐộ tuổi: 2 - 7 tuổi\u003c/p\u003e\n\u003cp\u003eTác giả: Corey R. Tabor\u003c/p\u003e\n\u003cp\u003eDịch giả: Hà Trang\u003c/p\u003e\n\u003cp\u003eMã sản phẩm: 8 935333 710048\u003c/p\u003e\n\u003cp\u003eNhà xuất bản: NXB Thanh Niên\u003c/p\u003e\n\u003cp\u003eCông ty phát hành: Công ty CP Sách và Truyền thông San Hô\u003c/p\u003e\n\u003cp\u003e\u003cem\u003eCáo cực kì, cực kì muốn thắng cuộc thi nhảy cao. Cậu biết chính xác mình sẽ đặt cúp ở đâu. Vấn đề là gì? Cáo nhảy không giỏi. Nhưng cậu rất giỏi ủ mưu…\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003eCorey R. Tabor là tác giả và họa sĩ minh họa của Snail Crossing, Cáo Thi Nhảy (Fox and the Jumping Contest), Cáo Đạp Xe (Fox and the Bike Ride), Cáo Đi Muộn (Fox Is Late), Cáo Chống Lại Mùa Đông (Fox vs Winter), và Cáo Da Hổ (Fox the Tiger, từng đoạt giải giải thưởng văn học của Hiệp hội Thư viện Hoa Kỳ). Anh sống ở Seattle với vợ và con trai và dành thời gian để vẽ và viết truyện.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/0c/b4/7d/3e561c2a57dbd4b9f10496fad5417c2f.jpg\" alt=\"\" width=\"750\" height=\"483\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/c9/f7/4a/8ed44eb97767add3d3e0db38e98e31e7.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/c9/f7/4a/8ed44eb97767add3d3e0db38e98e31e7.jpg\" alt=\"\" width=\"750\" height=\"556\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/83/92/6b/1d056d069f2dd31516b327c88081078f.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/83/92/6b/1d056d069f2dd31516b327c88081078f.jpg\" alt=\"\" width=\"750\" height=\"486\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/11/3f/60/8de356eab379bff3954fc187e63067b3.jpg\" alt=\"\" width=\"750\" height=\"556\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/c7/2a/35/c5545c997f6e1666d918ccfe8575f19f.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c7/2a/35/c5545c997f6e1666d918ccfe8575f19f.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c7/2a/35/c5545c997f6e1666d918ccfe8575f19f.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c7/2a/35/c5545c997f6e1666d918ccfe8575f19f.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c7/2a/35/c5545c997f6e1666d918ccfe8575f19f.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/fd/4a/9a/7d344dc0ef3369636eabcad83decc0f7.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/fd/4a/9a/7d344dc0ef3369636eabcad83decc0f7.jpg","medium_url":"https://salt.tikicdn.com/cache/