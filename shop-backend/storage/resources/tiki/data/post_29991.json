/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":41800,"discount_rate":20,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/41/1c/12/8aab0b8e5d6cd93eda28a76ddd0e089c.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":579,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/fd/ae/0d/74ced7801a53688c970eeecf74619435.png\" alt=\"\" width=\"553\" height=\"558\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eTHÔNG SỐ KỸ THUẬT\u003cbr /\u003eThương hiệu: COMET\u003cbr /\u003eModel: CT178\u003cbr /\u003eMàu sắc: TRẮNG \u0026amp; XANH\u003cbr /\u003eCông suất: 3W\u003cbr /\u003eĐầu vào USB: DC 5V --- 2.1A (Max)\u003cbr /\u003eThời gian sạc: 4 giờ\u003cbr /\u003eThời gian sử dụng\u003cbr /\u003e- Sáng mạnh: 2 giờ\u003cbr /\u003e- Sáng vừa: 4 giờ\u003cbr /\u003e- Sáng yếu: 5 giờ\u003cbr /\u003eChỉ số hoàn màu CRI: 82 Ra\u003cbr /\u003eNhiệt độ màu của ánh sáng CCT: 5700-7300K\u003cbr /\u003eQuang thông: \u0026gt;190ml\u003cbr /\u003ePin Lithium 18650 rời: dung lượng 1200mAh\u003cbr /\u003eCổng sạc Micro USB: Có (tặng kèm cáp sạc MicroUSB)\u003cbr /\u003eChế độ ngắt khi pin đầy: Có\u003cbr /\u003eĐèn LED báo hiệu sạc đầy: Có\u003cbr /\u003eĐiều chỉnh ánh sáng: Chạm nhẹ\u003cbr /\u003eCấp độ sáng: 3 mức (100%, 40%, 10%) \u003cbr /\u003eMàu ánh sáng: ánh sáng Trắng\u003cbr /\u003eKích thước: 94 x 94 x 450 mm\u003cbr /\u003eHƯỚNG DẪN SỬ DỤNG\u003cbr /\u003e- Vui lòng RÚT BỎ giấy ngăn pin tiếp xúc với thân khi mới mua về, để đèn hoạt động.\u003cbr /\u003e- Bật/tắt đèn \u0026amp; Điều chỉnh màu ánh sáng: Chạm nhẹ 1, 2, 3, 4 (lần) vào nút nguồn trên thân đèn để chọn cấp độ sáng phù hợp: Ánh sáng mạnh/ vừa / yếu/ tắt.\u003cbr /\u003e- Sạc pin:\u003cbr /\u003e* Kết nối dây cáp MicroUSB vào thiết bị sạc có điện áp phù hợp với đầu vào Micro USB DC 5V, dòng điện tối đa 2.1A, sau đó cắm đầu sạc vào cổng Mirco USB trên thân đèn, đèn LED báo sạc pin sẽ sáng ĐỎ. Khi sạc khoảng 4 tiếng pin sẽ đầy và tự động ngắt, đèn báo sạc chuyển sang màu XANH, bạn chú ý rút cốc sạc.\u003cbr /\u003e(Với cáp sạc MicroUSB tặng kèm, Bạn có thể sạc cho đèn thông qua cổng USB-A của Củ sạc/Cốc sạc điện thoại của bạn, hoặc cắm vào cổng USB-A của pin sạc dự phòng, hoặc CPU của maý tính để bàn, hoặc của )\u003cbr /\u003e* Sạc đèn đủ 8 giờ trước khi sử dụng lần đầu. Nếu không sử dụng đèn trong thời gian dài, sạc đèn ít nhất 1 lần trong vòng 3 tháng, sạc đủ 8 giờ để bảo vệ tuổi thọ của pin.\u003cbr /\u003e- Đèn sử dụng Pin rời, nên Bạn có thể sử dụng đèn CT178 bình thường như Đèn bàn Led khi mà không cần có pin. Để sử dụng đèn không cần pin, vui lòng cấp nguồn cho CT178 thông qua Củ sạc/Cốc sạc điện thoại của bạn, hoặc cắm vào cổng USB-A của pin sạc dự phòng, hoặc CPU của maý tính để bàn, hoặc của \u003cbr /\u003e\u003cbr /\u003e Khi sử dụng đèn CT178 ở chế độ cấp nguồn trực tiếp không thông qua pin, thì thời gian sử dụng KHÔNG CÒN BỊ GIỚI HẠN về thời gian nữa mà tuỳ thuộc vào nguồn cấp (Khi cúp điện trong thời gian dài hơn thời gian sử dụng của viên pin, bạn có thể lấy pin sạc dự phòng cấp nguồn cho CT178, khi đó CT178 hoạt động theo dung lượng của pin sạc dự phòng của Bạn\u003cbr /\u003e\u003cbr /\u003e Việc sử dụng Pin lithium rời 18650, giúp bạn dễ dàng sử dụng Đèn tuỳ biến mà không còn tuỳ thuộc vào việc hết pin, trong trường hợp pin hỏng/giảm tuổi thọ sau vài năm sử dụng, bạn dễ dàng mua Pin sạc 18650 khác thay thế, tìm mua pin sạc 18650 dễ dàng trên các trang thương mại điện tử, hoặc cửa hàng tạp hoá gần nhà Bạn)\u003cbr /\u003e\u003cbr /\u003e Đèn có tặng kèm 02 vách ngăn nhỏ, dùng để chia line giữa (ngăn giữa) của đèn thành 03 hộc nhỏ riêng biệt để chứa bút viết trong trường hợp Bạn cần chia tách nhỏ ngăn chứa line giữa\u003cbr /\u003e\u003cbr /\u003e CẢNH BÁO\u003cbr /\u003e- Sản phẩm dùng điện không nhúng vào nước.\u003cbr /\u003e- Để tránh xa trẻ em.\u003cbr /\u003e\u003cbr /\u003e HƯỚNG DẪN BẢO QUẢN\u003cbr /\u003eBảo quản trong môi trường khô ráo, không ẩm ướt, tránh ánh sáng mặt trời trực tiếp và nơi có nhiệt độ cao.\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/7d/0e/f5/0c5b82d6a4ec73d48e8017f58e0611e3.jpg\" alt=\"\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/21/cb/ec/23a943dbc7f9fc635720ba39c031002a.jpg\" alt=\"\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/1d/08/0a/f1a4d8cc04417a2de24bfbc1ac885e2a.jpg\" alt=\"\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/c1/f3/40/cc3c5dc79a8ee91579f218f87b340a4a.jpg\" alt=\"\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/bd/b4/8e/daaeca7b5c5ae25735d71c5de8066404.jpg\" alt=\"\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/90/3c/b8/c2d47c0daa0bc316083f578ff3ad582e.jpg\" alt=\"\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/5f/77/36/950ade6fcd032ec4d6fe28776428b4db.png\" alt=\"\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg t