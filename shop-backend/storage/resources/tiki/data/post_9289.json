ll,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/f1/56/0d/acc69d996545bf7fea1f83045cef14b4.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":57,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lxnsri2nfzyxfe\" width=\"2380\" height=\"3368\" alt=\"vn-11134208-7r98o-lxnsri2nfzyxfe\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eTAI NGHE THỂ THAO DẪN TRUYỀN ÂM THANH QUA XƯƠNG SHOKZ OPENSWIM PRO\u003c/p\u003e\n\u003cp\u003eKết nối Bluetooth kết hợp bộ nhớ MP3 32GB\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e Vì sao nên chọn tai nghe Shokz?\u003c/p\u003e\n\u003cp\u003e Sử dụng công nghệ dẫn truyền qua xương dẫn các rung động từ xương gò má đến tai trong, âm thanh được truyền tới tai mà không cần phải nhét vào hay che phủ đôi tai của bạn.\u003c/p\u003e\n\u003cp\u003e Các dòng tai nghe của giúp nghe được mọi âm thanh xung quanh, giữ cho bạn an toàn và tận hưởng những giai điệu của riêng mình.\u003c/p\u003e\n\u003cp\u003e Tai nghe số 1 Singapore\u003c/p\u003e\n\u003cp\u003e Đã được lưu hành trên 60 quốc gia và khu vực\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e Tại sao nên chọn OpenSwim Pro?\u003c/p\u003e\n\u003cp\u003e Chống nước IP68: Cho phép bạn thưởng thức âm nhạc khi bơi ở độ sâu tối đa 2 mét trong khoảng 2 giờ.\u003c/p\u003e\n\u003cp\u003e Tích hợp chế độ Bluetooth và bộ nhớ MP3 32GB\u003c/p\u003e\n\u003cp\u003e Kết nối đa điểm có thể kết nối với 2 thiết bị, dễ dàng chuyển đổi giữa máy tính và điện thoại của bạn.\u003c/p\u003e\n\u003cp\u003e Thiết kế Open Ear thoải mái dễ chú ý đến môi trường xung quanh.\u003c/p\u003e\n\u003cp\u003e Chất liệu Titan bên bỉ, gọn nhẹ vô cùng thuận tiện cho việc cất giữ và mang theo sử dụng\u003c/p\u003e\n\u003cp\u003e Thiết kế vừa vặn hoàn hảo giúp tai nghe cố định trong suốt quá trình tập luyện\u003c/p\u003e\n\u003cp\u003e Tai nghe có mic đàm thoại chống ồn kép thoải mái nghe gọi bất chấp không gian náo nhiệt\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e Thích hợp sử dụng\u003c/p\u003e\n\u003cp\u003e Shokz OpenSwim Pro thích hợp sử dụng khi chơi các môn thể thao như Bơi, chạy bộ, đạp xe, đi bộ đường dài,vv\u003c/p\u003e\n\u003cp\u003e Không gây tổn thương màng nhĩ, đây là một tai nghe lành mạnh phù hợp với trẻ em, người trẻ và cũng như với người sử dụng tai nghe thường xuyên để tránh làm hỏng tai như tài xế lái xe, nhân viên văn phòng,vv\u003c/p\u003e\n\u003cp\u003e Tai nghe tương thích rộng rãi cho hệ điều hành Android, iOS và có thể sử dụng cho điện thoại thông minh, máy tính bàn, máy tính bảng có chức năng bluetooth,vv\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e Thông số kĩ thuật:\u003c/p\u003e\n\u003cp\u003e- Dòng sản phẩm: S710\u003c/p\u003e\n\u003cp\u003e- Loại tai nghe: Truyền âm thanh qua xương thế hệ 8\u003c/p\u003e\n\u003cp\u003e- Tần số phản hồi: 20Hz~20KHz\u003c/p\u003e\n\u003cp\u003e- Bluetooth: v5.4\u003c/p\u003e\n\u003cp\u003e- Phạm vi kết nối: 10m\u003c/p\u003e\n\u003cp\u003e- Phát liên tục: Chế độ Bluetooth: 9 Giờ \u0026amp; Chế độ MP3: 6 Giờ\u003c/p\u003e\n\u003cp\u003e- Thời gian chờ: Tự động tắt sau 2 giờ ở chờ trong chế độ MP3, hoặc 6 giờ trong chế độ Bluetooth\u003c/p\u003e\n\u003cp\u003e- Thời gian sạc: 2 giờ\u003c/p\u003e\n\u003cp\u003e- Sạc nhanh: Có, 10 phút sạc cho 3 giờ sử dụng (âm nhạc)\u003c/p\u003e\n\u003cp\u003e- Trọng lượng: 23.7g\u003c/p\u003e\n\u003cp\u003e- Bảo hành: 2 năm\u003c/p\u003e\n\u003cp\u003e- Chuẩn chống nước: IP68\u003c/p\u003e\n\u003cp\u003e- Dung lượng pin: 160 mAh\u003c/p\u003e\n\u003cp\u003e- Cấu hình tương thích Bluetooth: A2DP, AVRCP, HFP\u003c/p\u003e\n\u003cp\u003e- Cấu hình tương thích MP3: MP3, WMA, FLAC, WAV, AAC, M4A, APE\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e Bộ sản phẩm gồm có:\u003c/p\u003e\n\u003cp\u003e Tai nghe OpenSwim Pro\u003c/p\u003e\n\u003cp\u003e Dây cáp sạc\u003c/p\u003e\n\u003cp\u003e Hộp đựng tai nghe\u003c/p\u003e\n\u003cp\u003e Phiếu bảo hành\u003c/p\u003e\n\u003cp\u003e Sách hướng dẫn sử dụng\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e Thông tin bảo hành\u003c/p\u003e\n\u003cp\u003e Thời gian bảo hành: 2 năm\u003c/p\u003e\n\u003cp\u003e Hình thức bảo hành: 1 đổi 1\u003c/p\u003e\n\u003cp\u003e Căn cứ bảo hành: bao bì sản phẩm và phiếu bảo hành\u003c/p\u003e\n\u003cp\u003e Bảo hành không áp dụng nếu:\u003c/p\u003e\n\u003cp\u003e+ Không có thiệt hại được tìm thấy.\u003c/p\u003e\n\u003cp\u003e+ Hư hỏng do yếu tố tác nhân bên ngoài.\u003c/p\u003e\n\u003cp\u003e+ Hư hỏng do sử dụng sai (rơi, trầy xước, ố, vỡ,..)\u003c/p\u003e\n\u003cp\u003e+ Đã qua sửa chữa\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eQuý khách vui lòng liên hệ Chatbox để được Hỗ trợ tư vấn, giải đáp các Thông tin bảo hành\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e#tainghekhongdayantruyenquaxuong #IP68 #tainghebluetooth #bluetooth #tainghe #tainghenhettai #tainghebluetooth #tainghethethao\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hà