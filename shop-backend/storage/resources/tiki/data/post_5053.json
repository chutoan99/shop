reason":"any_reason"}},"discount":10000,"discount_rate":2,"rating_average":4.1,"review_count":20,"review_text":"(20)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ef/d3/5c/e0a2866a3d1fc32852ec19f169fc382b.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1737,"all_time_quantity_sold":74,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eBếp Gas Đôi Hồng Ngoại Rainy - RN1602TT+1\u003c/strong\u003e được thiết kế mang đến sự tiện dụng tối đa cho người nội trợ. Đó là 1 bộ đôi bếp với kiểu dáng nhỏ gọn, hiện đại, phù hợp với nhiều loại nồi khác nhau và giúp bạn có thể nấu 1 lúc 2 món ăn mà không mất nhiều thời gian.Kết hợp với màu sắc tinh tế, đẹp mắt mang đến cho bạn ấn tượng từ cái nhìn đầu tiên.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ef/d3/5c/b52caeedebe22c41e65cbc7b9a4d0eb4.jpg\" alt=\"\" width=\"0\" height=\"0\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ef/d3/5c/2d00cec77043fd99aece8466842df99b.jpg\" alt=\"\" width=\"720\" height=\"720\" /\u003e\u003c/p\u003e\n\u003ch5\u003eSử dụng đầu chia lửa hồng ngoại, đảm bảo an toàn\u003c/h5\u003e\n\u003cp\u003eBếp trang bị đầu chia lửa ứng dụng công nghệ hồng ngoại, đảm bảo an toàn và giảm đến 22% thời gian nấu chín thức ăn, có thể giảm đến 30% lượng ga tiêu thụ. Đặc biệt, bếp gas đôi hồng ngoại Rainy hòan toàn không sinh ra khói trong quá trình sử dụng, nhờ sử dụng công nghệ đầu đốt lõi gốm đen, có độ bền cao, khiến các dụng cụ nấu nướng của bạn không bị ám khói đen, an toàn cho các vật dụng nhà bếp.\u003c/p\u003e\n\u003ch5\u003eĐảm bảo tiết kiệm gas hiệu quả\u003c/h5\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/0b/b6/ed/650f58c4924d536b4c3246b7f6c51952.jpg\" alt=\"\" width=\"720\" height=\"720\" /\u003e\u003c/p\u003e\n\u003cp\u003eĐặc biệt, đầu chia lửa được thiết kế với hơn 3.000 lỗ li ti đốt cháy 100% lượng gas tiêu thụ, bố trí tối ưu nhất để mang lại hiệu quả đốt nóng hoàn hảo cho bề mặt lửa phủ đều toàn bộ diện tích đáy nồi giúp bếp nóng nhanh hơn, thức ăn chín đều hơn và tiết kiệm thời gian trong quá trình nấu nướng. Ngọn lửa đỏ và đầu đốt gốm khi bị đốt nóng đến đỏ hồng sẽ phát ra tia hồng ngoại cường độ cao lên đến 1100 độ C, đảm bảo không bị gió thổi hay nước tràn làm tắt bếp, vì thế không phải lo lắng khi sử dụng.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/4e/df/28/1ee7fe754e29ee47d19f43550ff834a4.jpeg\" alt=\"\" width=\"720\" height=\"720\" /\u003e\u003c/p\u003e\n\u003ch5\u003eMặt kính cường lực cao cấp\u003c/h5\u003e\n\u003cp\u003eBếp gas đôi hồng ngoại Rainy có phần thân bếp sang trọng với mặt kính cường lực chịu nhiệt cao dày 7mm, dễ dàng vệ sinh, chùi rửa sau mỗi lần nấu nướng. Hiện đại hơn với mặt kính phía trước che chắn toàn bộ thân kim loại, mặt kính cường lực này có thể chịu nhiệt và áp lực lên đến 25kg, không lo sợ nứt vỡ khi tiếp xúc với vật dụng cứng hay nhiệt độ cao từ bếp. Các góc mặt kính được mài nhẵn tránh nguy hiểm, đảm bảo an toàn cho người sử dụng.\u003c/p\u003e\n\u003cp\u003eCùng với kiềng bếp làm bằng thép phủ men siêu bền, chắc chắn và nút vặn được làm từ nhựa ABS, an toàn sử dụng. Sử dụng chỉ với 1 nút vặn, cực kỳ tiện lợi.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/25/f1/50/dbd106e23785aeb2fe7a6df5730077f5.jpg\" alt=\"\" width=\"720\" height=\"720\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/c1/db/4a/a011d03495c53fcc3569fe7bddc54085.jpg\" alt=\"\" width=\"750\" height=\"318\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/11/42/9c/490418c74d52b746a2916f97ac341e9c.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ef/d3/5c/e0a2866a3d1fc32852ec19f169fc382b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ef/d3/5c/e0a2866a3d1fc32852ec19f169fc382b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ef/d3/5c/e0a2866a3d1fc32852ec19f169fc382b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ef/d3/5c/e0a2866a3d1fc32852ec19f169fc382b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ef/d3/5c/e0a2866a3d1fc32852ec19f169fc382b.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/1e/f6/a5/16921668b785f6b8faa7f710ead2787b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/1e/f6/a5/16921668b785f6b8faa7f710ead2787b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/1e/f6/a5/16921668b785f6b8faa7f710ead2787b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1e/f6/a5/16921668b785f6b8faa7f710ead2787b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1e/f6/a5/16921668b785f6b8faa7f710ead2787b.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/d4/53/2e/b3792e2df85535f371865a9f3f3e0232.jpeg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d4/53/2e/b3792e2df85535f371865a9f3f3e0232.jpeg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d4/53/2e/b3792e2df85535f371865a9f3f3e0232.jpeg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d4/53/2e/b3792e2df85535f371865a9f3f3e0232.