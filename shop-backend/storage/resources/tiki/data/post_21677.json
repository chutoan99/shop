/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":38090,"discount_rate":5,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/d7/48/14/9cecf0c6fd597b0cc8689629a8d9581f.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":818,"all_time_quantity_sold":3,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e1. Mô tả sản phẩm\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/43/e9/02/1046ce85e398f0357fccc78f586485eb.png\" alt=\"\" width=\"450\" height=\"600\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003eQuạt điện Nanoco là dòng sản phẩm cơ điện giá rẻ đang khá nổi trên thị trường thuộc phân khúc phổ thông trong những năm gần đây. Nguyên nhân là do những chiếc quạt của họ có giá rẻ vô địch và chất lượng không thua kém bất kỳ hãng nổi tiếng nào. Với 30 năm kinh nghiệm kinh doanh, phân phối sản phẩm chính hãng của Panasonic. Người dùng có thể tin rằng quạt điện nanoco chính là lựa chọn đảm bảo tiêu chuẩn \"ngon bổ rẽ\" để xua tan cái nóng mùa hè nhất hiện nay.\u003c/p\u003e\n\u003cp\u003eChiếc quạt sạc gấp gọn Nanoco là sự pha trộn tuyệt vời của tính năng làm mát nhanh, gọn nhẹ, không dây và hoạt động yên tĩnh. Với chiếc quạt sạc này, người dùng sẽ dễ dàng di chuyển quạt đi bất kể nơi đâu mà không tốn nhiều sức. Trọng lượng quạt chỉ 0,8kg, khi gấp gọn lại quạt chỉ còn 20 cm nên dễ dàng xếp vào balo, vali mà không chiếm quá nhiều chỗ.\u003c/p\u003e\n\u003cp\u003eĐiểm đặc biệt nhất của sản phẩm đó chính là phần thân có thể gấp gọn hoặc nâng cao lên dễ dàng nhờ vào khớp nối được làm bằng hợp kim nhôm. Nhờ đó, phần thân có thể thay đổi linh hoạt cũng như chắc chắn mà không bị lung lay.\u003cbr /\u003eKhông chỉ thế, dung lượng pin lithium lên tới 7200mAh, giúp quạt có thể sử dụng bền bỉ suốt ngày dài, mang lại cho bạn những trải nghiệm tốt nhất khi không có nguồn điện.\u003cbr /\u003eQuạt sạc gấp gọn mặc dù có kích cỡ nhỏ, nhẹ nhưng cánh quạt tương đối to với 3 cánh, đảm bảo cung cấp luồng gió mát tuyệt đối cho căn phòng nơi bạn cần.\u003cbr /\u003eMột ưu điểm nữa khiến nhiều người quyết định chọn sản phẩm này là bởi tính năng vận hành êm ái, không gây ồn với cấp độ 3 là 40dB.\u003c/p\u003e\n\u003cp\u003eChất liệu là nhựa cao cấp ABS và hợp kim nhôm nên quạt rất cứng cáp, bền bỉ, an toàn và không độc hại đến sức khỏe người sử dụng. Quạt có 2 màu sắc để cho bạn lựa chọn là Hồng và Trắng.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/69/c7/8b/aaa85c6e008ac1b820bd8d109a5a3898.png\" alt=\"\" width=\"600\" height=\"600\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eQuạt Sạc Điện Gấp Gọn Nanoco\u003cbr /\u003eChất liệu chính: Hợp kim nhôm và nhựa ABS\u003cbr /\u003eMã pin: Lithium Baterry 18650\u003cbr /\u003eDung lượng pin: 3.7 V 7200 mAh\u003cbr /\u003eCông suất: 4.8W\u003cbr /\u003eKích thước xếp: 197*197*93 mm\u003cbr /\u003eChiều dài dây nguồn: 1.5 m\u003cbr /\u003eLưu lượng gió: 4.0m/s Chế độ gió:\u003cbr /\u003e1 Gió nhẹ\u003cbr /\u003e2 Gió vừa\u003cbr /\u003e3 Gió mạnh\u003cbr /\u003e4 Gió tự nhiên\u003cbr /\u003eĐộ ồn: 30-40db\u003cbr /\u003eThời gian sạc: 4.5 tiếng\u003cbr /\u003eThời gian sử dụng:\u003cbr /\u003eTốc độ 1: 23h30p\u003cbr /\u003eTốc độ 2: 9h30p\u003cbr /\u003eTốc độ 3: 5h30p\u003c/p\u003e\n\u003cp\u003e#quatnanoco\u003cbr /\u003e#quatban\u003cbr /\u003e#quatdung\u003cbr /\u003e#quatsacpin\u003cbr /\u003e#hangchinhhang\u003cbr /\u003e#quat\u003cbr /\u003e#freeship\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/d7/48/14/9cecf0c6fd597b0cc8689629a8d9581f.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d7/48/14/9cecf0c6fd597b0cc8689629a8d9581f.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d7/48/14/9cecf0c6fd597b0cc8689629a8d9581f.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d7/48/14/9cecf0c6fd597b0cc8689629a8d9581f.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d7/48/14/9cecf0c6fd597b0cc8689629a8d9581f.png"},{"base_url":"https://salt.tikicdn.com/ts/product/f0/3f/fd/eddb301107d233ea8b8d0151f5ad515d.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f0/3f/fd/eddb301107d233ea8b8d0151f5ad515d.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f0/3f/fd/eddb301107d233ea8b8d0151f5ad515d.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f0/3f/fd/eddb301107d233ea8b8d0151f5ad515d.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f0/3f/fd/eddb301107d233ea8b8d0151f5ad515d.png"},{"base_url":"https://salt.tikicdn.com/ts/product/0f/7d/4e/7f2a55675cde67e93c76beaea9fc9867.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0f/7d/4e/7f2a55675cde67e93c76beaea9fc9867.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/0f/7d/4e/7f2a55675cde67e93c76beaea9fc9867.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0f/7d/4e/7f2a55675cde67e93c76beaea9fc98