77904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"freeship_xtra","type":"pdp_icon_badge","index":2,"icon":"https://salt.tikicdn.com/ts/upload/be/67/48/04a82ab8df178e1a13bde38316081865.png","icon_width":91,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":true,"return_reason":"any_reason"}},"discount":88000,"discount_rate":35,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/a8/4d/22/dcb47027a7061768c9f8a4583fe1d278.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":45,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eTÁC GIẢ: Steve Cavanagh\u003c/p\u003e\n\u003cp\u003eDịch giả: Thảo Nguyên\u003c/p\u003e\n\u003cp\u003eTHÔNG TIN XUẤT BẢN:\u003c/p\u003e\n\u003cp\u003eGiá bìa: 250.000đ\u003c/p\u003e\n\u003cp\u003eKích thước: 16x24\u003c/p\u003e\n\u003cp\u003eSố trang: 464\u003c/p\u003e\n\u003cp\u003eMã EAN: 8936066698535\u003c/p\u003e\n\u003cp\u003eNXB liên kết: NXB THANH NIÊN\u003c/p\u003e\n\u003cp\u003eSách do Công ty TNHH Văn hóa và Truyền thông 1980 BOOKS ấn hành quý III/2024\u003c/p\u003e\n\u003cp\u003eNẠN NHÂN SỐ 13\u003c/p\u003e\n\u003cp\u003eNội dung sách\u003c/p\u003e\n\u003cp\u003eCả nước Mỹ rúng động khi nghe tin một nữ ngôi sao chết trên giường trong tình trạng bị dao đâm chém nghiêm trọng và khỏa thân trên. Kỳ lạ hơn là bên cạnh cô còn có xác chết của người vệ sĩ. Mọi bằng chứng pháp y và hình ảnh được ghi lại từ camera gia đình đều chỉ ra nghi phạm trong vụ án thương tâm này là chồng của cô, cũng là một ngôi sao nổi tiếng, tình cờ đã không có mặt ở nhà trước đó.\u003c/p\u003e\n\u003cp\u003eTuy nhiên, nghi phạm không nhận tội. Và đội luật sư bào chữa cho cậu cũng tin rằng cậu vô tội. Eddie Flynn, một luật sư bào chữa khét tiếng có quá khứ từng là một kẻ lừa đảo, đã được bổ sung vào đội hình trong phút chót. Nhờ những mối quan hệ sâu rộng và bản năng nhanh nhạy, Eddie đã tìm ra rất nhiều điểm đáng ngờ trong vụ án này. Tờ tiền 1 đô-la được gấp thành hình con bướm, bị nhét trong cổ họng nạn nhân? DNA của một kẻ giết người hàng loạt đã chết từ cả chục năm trước? Kẻ giết người thực sự có mục đích gì? Và phải chăng hắn ở gần hơn ta nghĩ?\u003c/p\u003e\n\u003cp\u003eVề tác giả:\u003c/p\u003e\n\u003cp\u003eSteve Cavanagh là tác giả có sách bán chạy nhất của tờ Sunday Times được giới phê bình đánh giá cao. Thirteen là cuốn thứ 4 trong loạt truyện về Eddie Flynn đình đám. Cuốn sách đã nhận được giải thưởng Theakston Old Peculier cho Tiểu thuyết trinh thám hay nhất năm 2019.\u003c/p\u003e\n\u003cp\u003eÔng hiện cũng đang là luật sư và từng tham gia xử lý nhiều vụ án nổi tiếng. Vào năm 2010, ông đại diện cho một công nhân nhà máy bị lạm dụng tại nơi làm việc và giành được khoản bồi thường thiệt hại lớn nhất do phân biệt trong lịch sử pháp luật Bắc Ireland.\u003c/p\u003e\n\u003cp\u003eTrích dẫn hay trong sách:\u003c/p\u003e\n\u003cp\u003e1. “Trò lừa lớn nhất mà ma quỷ từng làm là thuyết phục thế giới rằng hắn không tồn tại.” - Christopher McQuarrie\u003c/p\u003e\n\u003cp\u003e2. “Tội lỗi là một hình xăm nặng cả trăm cân.”\u003c/p\u003e\n\u003cp\u003e3. “Số ba tương đương với sự thật hoặc thực tế nào đó trong tiềm thức của chúng ta. Ở một khía cạnh nào đó, nó rất linh thiêng. Chúa Jesus đã sống lại vào ngày thứ ba. Chúa Ba Ngôi. Lần may mắn thứ ba. Ba lần đình công và bạn bị loại.”\u003c/p\u003e\n\u003cp\u003e4. “Trong một phiên tòa hình sự, bằng chứng pháp y là Thánh.\u003c/p\u003e\n\u003cp\u003eNhưng tôi là luật sư bào chữa. Ma quỷ đứng về phía tôi và ma quỷ thì không chơi công bằng.”\u003c/p\u003e\n\u003cp\u003e5. “Câu chuyện thực sự nằm ở các bức ảnh. Hình ảnh hiện trường vụ án không nói dối. Chúng không phải là nhân chứng, vì thế sẽ không phạm sai lầm hay che giấu sự thật.”\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/a8/4d/22/dcb47027a7061768c9f8a4583fe1d278.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a8/4d/22/dcb47027a7061768c9f8a4583fe1d278.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a8/4d/22/dcb47027a7061768c9f8a4583fe1d278.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a8/4d/22/dcb47027a7061768c9f8a4583fe1d278.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a8/4d/22/dcb47027a7061768c9f8a4583fe1d278.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/0c/ea/73/31668b8dc095737ab0e06d234f75c993.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0c/ea/73/31668b8dc095737ab0e06d234f75c993.jpg","medium_url":"https://salt.tikicdn.com/cache