e\n\u003c/ul\u003e\n\u003c/div\u003e\n\u003cdiv id=\"detail_decorate_root\" style=\"margin: 0px; padding: 0px; font-family: Roboto-Regular, 'Helvetica Neue', Helvetica, Tahoma, Arial, sans-serif; font-size: 12px; width: 960px;\"\u003e\n\u003cdiv id=\"_root\" class=\"engine-app\" style=\"margin: 0px; padding: 0px;\"\u003e\n\u003cdiv id=\"Root\" class=\"com-struct\" style=\"margin: 0px; padding: 0px;\"\u003e\n\u003cdiv id=\"hc\" class=\"com-struct\" style=\"margin: 0px; padding: 0px;\"\u003e \u003c/div\u003e\n\u003cdiv id=\"hd\" class=\"com-struct\" style=\"margin: 0px; padding: 0px;\"\u003e \u003c/div\u003e\n\u003cdiv id=\"bd\" class=\"com-struct\" style=\"margin: 0px; padding: 0px;\"\u003e\n\u003cdiv id=\"bd_-999\" class=\"com-struct\" style=\"margin: 0px; padding: 0px;\"\u003e\n\u003cdiv id=\"bd_-999_container_0\" class=\"com-struct\" style=\"margin: 0px; padding: 0px;\"\u003e \u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv id=\"bd_0\" class=\"com-struct\" style=\"margin: 0px; padding: 0px;\"\u003e\n\u003cdiv id=\"bd_0_container_0\" class=\"com-struct\" style=\"margin: 0px; padding: 0px;\"\u003e\n\u003cdiv style=\"margin: 0px; padding: 0px;\"\u003e\n\u003cdiv id=\"shell-com-7114017\" class=\"J_module\" style=\"margin: 0px; padding: 0px;\"\u003e\n\u003cdiv class=\"module-detailCustomArea\" style=\"margin: 0px; padding: 0px; unicode-bidi: embed; height: 6474px;\"\u003e\n\u003cdiv class=\"custom-content\" style=\"margin: 0px; padding: 0px; unicode-bidi: embed; width: 750px; height: auto; transform: scale(1.28, 1.28); transform-origin: 0% 0% 0px;\"\u003e\n\u003cp style=\"margin: 0.2em 0px; padding: 0px; unicode-bidi: embed;\"\u003e\u003cimg style=\"margin: 0px; padding: 0px; border-style: none; max-width: 100%; height: auto !important;\" title=\"IMG_9470ah\" src=\"http://cdn-img-v2.webbnc.net/uploadv2/web/40/4020/product/2017/08/30/06/51/1504075738_img_9470ah.jpg\" alt=\"IMG_9470ah \" /\u003e\u003c/p\u003e\n\u003cp style=\"margin: 0.2em 0px; padding: 0px; unicode-bidi: embed; text-align: center;\"\u003e \u003c/p\u003e\n\u003cp style=\"margin: 0.2em 0px; padding: 0px; unicode-bidi: embed;\"\u003e\u003cimg style=\"margin: 0px; padding: 0px; border-style: none; max-width: 100%; height: auto !important;\" src=\"https://vn-test-11.slatic.net/shop/cb1b6de3cb1a2ffb3ff1621089e161ef.jpeg\" alt=\"\" /\u003e\u003cimg style=\"margin: 0px; padding: 0px; border-style: none; max-width: 100%; height: auto !important;\" src=\"https://vn-test-11.slatic.net/shop/b016d7062d948f3ee614245bd60a6bd8.png\" alt=\"\" /\u003e\u003cimg style=\"margin: 0px; padding: 0px; border-style: none; max-width: 100%; height: auto !important;\" src=\"https://vn-test-11.slatic.net/shop/1a237592b03529fd887367294f7068f8.jpeg\" alt=\"\" /\u003e\u003c/p\u003e\n\u003cp style=\"margin: 0.2em 0px; padding: 0px; unicode-bidi: embed;\"\u003e \u003c/p\u003e\n\u003cp style=\"margin: 0.2em 0px; padding: 0px; unicode-bidi: embed;\"\u003eĐèn Diệt Muỗi  phát ra tia UAV để thu hút côn trùng, ruồi, muỗi và các loại côn trùng bay trong phạm vi 360 độ xung quanh đèn. Khi côn trùng bay vào thân đèn, tiếp xúc vào lưới điện sẽ bị tiêu diệt bởi hệ thống lưới điện áp cao.Thiết kế hiện đại, kích thước phù hợp nhưng mang lại hiệu quả cao.\u003c/p\u003e\n\u003cp style=\"margin: 0.2em 0px; padding: 0px; unicode-bidi: embed;\"\u003eKhung nhựa bên ngoài có độ an toàn cao.\u003cbr style=\"margin: 0px; padding: 0px;\" /\u003eThiết kế sang trọng, ánh sáng dịu nhẹ có thể vừa sử dụng bắt muỗi vừa làm đèn ngủ. \u003cbr style=\"margin: 0px; padding: 0px;\" /\u003eKhông gây ô nhiễm môi trường, không gây khói hay mùi khó chịu.\u003cbr style=\"margin: 0px; padding: 0px;\" /\u003eĐèn phát tia UV là hoàn toàn vô hại với cơ thể người, trẻ em  và vật nuôi.\u003c/p\u003e\n\u003cp style=\"margin: 0.2em 0px; padding: 0px; unicode-bidi: embed;\"\u003e\u003cspan style=\"margin: 0px; padding: 0px; font-weight: bolder;\"\u003eSản phẩm đèn diệt côn trùng DS-D62 của Đại Sinh  là đơn vị đầu tiên tại Việt Nam được Trung tâm III cấp Giấy chứng nhận an toàn chất lượng về tiêu diệt côn trùng.\u003c/span\u003e\u003cbr style=\"margin: 0px; padding: 0px;\" /\u003eĐèn diệt côn trùng DS-D62 thích hợp đặt trong phòng Phòng khách, Nhà bếp, Phòng ngủ...\u003c/p\u003e\n\u003cul style=\"margin: 0.2em 0px 0.2em 40px; padding: 0px; list-style-position: initial; list-style-image: initial; unicode-bidi: embed;\"\u003e\n\u003cli style=\"margin: 0px; padding: 0px;\"\u003e\n\u003ch2 style=\"margin: 0.75em 0px; padding: 0px; unicode-bidi: embed; font-weight: bolder;\"\u003e\u003cspan style=\"margin: 0px; padding: 0px; font-weight: bolder;\"\u003eHướng dẫn cách sử dụng Đèn diệt côn trùng Đại Sinh:\u003c/span\u003e\u003c/h2\u003e\n\u003cp style=\"margin: 0.2em 0px; padding: 0px; unicode-bidi: embed;\"\u003eĐèn diệt côn trùng được chế tạo dựa vào tính nhạy cảm sóng dài và tính hướng về nguồn sáng của các loại côn trùng. Từ đó thiết kế loại bóng đèn có khả năng thu hút côn trùng đến và dùng lưới điện có điện áp cao để phóng điện đốt cháy côn trùng.\u003c/p\u003e\n\u003cp style=\"margin: 0.2em 0px; padding: 0px; unicode-bidi: embed;\"\u003eCông suất đèn nói lên sự khác biệt về độ sáng của bóng đèn, đa số côn trùng đều là động vật hướng về nguồn sáng, do đó tuỳ theo từng loại côn trùng mà ta thiết kế công suất đèn cho phù hợp..\u003c/p\u003e\n\u003cp style=\"margin: 0.2em 0px; padding: 0px; unicode-bidi: embed;\"\u003eĐể đèn diệt côn trùng hiệu quả thì nên dùng loại bóng có bước sóng ánh sáng trong khoảng từ 350nm đến 375nm. Ta nên chọn bóng đèn có cường độ sáng mạnh, công suất từ 6 watt trở lên. Đèn diệt côn trùng không chỉ được dùng với mục đích đuổi muỗi mà còn được dùng để hạ gục tất cả các loại côn trùng, đặc biệt là các loại hoạt động về đêm, chẳng hạn như muỗi nhiệt đới...\u003cbr style=\"margin: 0px; padding: 0px;\" /\u003e \u003c/p\u003e\n\u003cp style=\"margin: 0.2em 0px; padding: 0px; unicode-bidi: embed;\"\u003e\u003cem style=\"margin: 0px; padding: 0px;\"\u003e\u003cspan style=\"margin: 0px; padding: 0px; font-weight: bolder;\"\u003eSau đây là cách lắp đặt, cũng như vị trí lắp đặt sao cho đèn đạt được hiệu quả tốt.\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"margin: 0.2em 0px; padding: 0px; unicode-bidi: embed;\"\u003e1.      Đèn diệt côn trùng không nên lắp đặt tại một ví trí cố định trong thời gian dài mà nên thay đổi vị trí và nên đặt ở độ cao từ đầu gối trở lên, chẳng hạn như: đặt trên kệ hoặc bàn uống trà.\u003c/p\u003e\n\u003cp style=\"margin: 0.2em 0px; padding: 0px; unicode-bidi: embed;\"\u003e2.      Khi dùng đèn diệt côn trùng nên tắt hết tất cả các loại đèn khác trong phòng do muỗi bị ảnh hưởng bởi các nguồn sáng khác sẽ không cảm nhận được nguồn sáng phát ra từ đèn diệt côn trùng, nên hiệu quả sẽ giảm đáng kể, ban đêm chính là thời điểm tốt để diệt muỗi.\u003c/p\u003e\n\u003cp style=\"margin: 0.2em 0px; padding: 0px; unicode-bidi: embed;\"\u003e3.      Việc định kỳ làm vệ sinh đèn diệt côn trùng cũng không kém phần quan trọng, là mỗi tuần nên dùng cọ lông để quét sạch xác côn trùng và lưới điện, thường xuyên giữ vệ sinh do nếu côn trùng nhìn thấy có nhiều xác khác trên đèn cũng không đến gần đèn nữa.\u003c/p\u003e\n\u003cp style=\"margin: 0.2em 0px; padding: 0px; unicode-bidi: embed;\"\u003e4.      Khi mua đèn diệt côn trùng nên chọn mua loại nào có công suất bóng đèn lớn hơn 6 watt trở lên, đồng thời phải chọn linh phụ kiện đầy đủ (như cọ quét...) để bảo trì bảo dưỡng.\u003c/p\u003e\n\u003cp style=\"margin: 0.2em 0px; padding: 0px; unicode-bidi: embed;\"\u003e5.      Bề mặt của lưới bị dính bẩn cũng làm giảm khả năng diệt côn trùng cho nên cần phải định kỳ dùng cọ quét có cáng dài và nhỏ để làm vệ sinh lưới điện và chấu cắm dây nguồn\u003c/p\u003e\n\u003cp style=\"margin: 0.2em 0px; padding: 0px; unicode-bidi: embed;\"\u003e6.      Vị trí đặt sản phẩm cũng ảnh hưởng đến hiệu quả của việc bắt muỗi,  là đặt ở nơi có độ cao từ đầu gối trở lên nhưng không được treo ở độ cao quá 2 mét, đây là phạm vi hoạt động thường xuyên của muỗi. Nên đặt sản phẩm ở vị trí nơi ẩn gốc, tắt hết các loại đèn khác nhằm đạt hiệu quả tốt của bóng đèn.\u003c/p\u003e\n\u003cp style=\"margin: 0.2em 0px; padding: 0px; unicode-bidi: embed;\"\u003e7.      Khi bóng đèn bị cũ sẽ làm giảm khả năng thu hút côn trùng nên tốt ta phải thay bóng đèn hàng năm.\u003c/p\u003e\n\u003cp style=\"margin: 0.2em 0px; padding: 0px; unicode-bidi: embed;\"\u003eThông thường người sử dụng có quan niệm không đúng về cách lắp đặt sản phẩm như đặt ở những nơi ẩn tối, không khí không lưu thông. Trên thực tế cách lắp đặt sản phẩm chính xác là nên đặt sản phẩm tại những nơi thông thoáng, thông thường được đặt trong phòng cách cửa ra vào từ 1.5 mét đến 3 mét, đồng thời phải điều chỉnh ánh sáng của đèn chiếu sáng sao cho có cường độ sáng thấp hơn cường độ sáng của đèn diệt côn trùng. Khi đó mới có thể tận dụng triệt  để nguyên lý hướng  về nguồn sáng của côn trùng, hơn nữa đối với các loại côn trùng bay thì tầm hoạt động của chúng là từ 0,7 mét đến 2 mét nên ta phải điều chỉnh, thay đổi độ  cao cho phù hợp và phải thường xuyên thay đổi vị trí để đạt được hiệu quả tối ưu, tạo môi trường sinh hoạt trong  gia đình sạch sẽ, không còn bóng dáng các loại côn trùng.\u003c/p\u003e\n\u003cp style=\"margin: 0.2em 0px; padding: 0px; unicode-bidi: embed;\"\u003e\u003cem style=\"margin: 0px; padding: 0px;\"\u003e\u003cspan style=\"margin: 0px; padding: 0px; font-weight: bolder;\"\u003eNgoài ra còn một vấn đề rất quan trọng xin quý khách lưu ý:\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"margin: 0.2em 0px; padding: 0px; unicode-bidi: embed;\" data-spm-anchor-id=\"a2o4n.pdp.product_detail.i1.58533b78X9ozpk\"\u003eHãy cầm phần nhựa của tuốc nơ vít và đưa vít vào phía trong đèn để kiểm tra lưới điện cao áp, phải nghe tiếng \"pẹc ~\", nếu không nghe thì nhanh chóng mang sản phẩm đi sửa chữa, bảo hành đi nhé!\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ec/08/b9/bbb42cbe1e29c0c073af9690b3fac7c8.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ec/08/b9/bbb42cbe1e29c0c073af9690b3fac7c8.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ec/08/b9/bbb42cbe1e29c0c073af9690b3fac7c8.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ec/08/b9/bbb42cbe1e29c0c073af9690b3fac7c8.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ec/08/b9/bbb42cbe1e29c0c073af9690b3fac7c8.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/ee/61/fb/18bb35482cb79704752b05ff2448f153.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ee/61/fb/18bb35482cb79704752b05ff2448f153.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ee/61/fb/18bb35482cb79704752b05ff2448f153.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ee/61/fb/18bb35482cb79704752b05ff2448f153.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ee/61/fb/18bb35482cb79704752b05ff2448f153.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/9d/ae/3c/6975dc086df9acc5291ab3ce43839c51.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/9d/ae/3c/6975dc086df9acc5291ab3ce43839c51.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/9d/ae/3c/6975dc086df9acc5291ab3ce43839c51.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/p