:{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":7,"review_text":"(7)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/7e/17/9f/84bfc745150300065368b32bb9b9f38a.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2163,"all_time_quantity_sold":53,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eSẢN PHẨM ĐƯỢC NHẬP KHẨU CHÍNH HÃNG VÀ PHÂN PHỐI BỞI CÔNG TY CỔ PHẦN TẦM NHÌN\u003c/strong\u003e   \u003c/p\u003e\n\u003cp\u003eVòi phun cổ điển Gardena 18300-50 được làm từ chất liệu chựa cao cấp chịu lực va đập mạnh, kết nối với cút và ống dây Gardena để tưới cây, rửa sân vườn.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://hqvcdn3.azureedge.net/qs_h=250\u0026amp;w=350\u0026amp;crop=0\u0026amp;ver=20220502T103123\u0026amp;hcsh=488246560E3E298A43EF78C658EE5371/_$$_/media/aprimo/gardena/nozzles-sprayers/photos/studio/ga110-10xxxx/ga110-1045.png\" alt=\"18300-20-S-002\" width=\"350\" height=\"250\" /\u003e\u003c/p\u003e\n\u003cp\u003eVòi có thể điều chỉnh chế độ phun, từ phun tia sang phun chùm. Tay cầm thoải mái, khớp xoay điều chỉnh chế độ phun tiện lợi và dễ dàng.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://hqvcdn3.azureedge.net/qs_h=250\u0026amp;w=350\u0026amp;crop=0\u0026amp;ver=20220502T103452\u0026amp;hcsh=470147EF7E1BD5C0DFEB9E22C7D6D1E8/_$$_/media/aprimo/gardena/nozzles-sprayers/photos/action/ga150-00xxxx/ga150-0036.jpeg\" alt=\"18300-20-L-013\" width=\"350\" height=\"250\" /\u003e\u003c/p\u003e\n\u003cp\u003eCHỈ NHỮNG PHẦN MÀU CAM TRÊN SẢN PHẨM LÀ CÓ THỂ ĐIỀU CHỈNH DI CHUYỂN ĐƯỢC (XOAY/ẤN/VẶN/KÉO).\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTHÔNG TIN THƯƠNG HIỆU \u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eGARDENA là Thương hiệu dẫn đầu thế giới với hơn 60 năm kinh nghiệm trong lĩnh vực sản xuất dụng cụ và thiết bị chăm sóc sân vườn tại Châu Âu, được thành lập năm 1961 tại Đức bởi Werner Kress và Eberhard Kastner. Sản phẩm Gardena đã có mặt tại hơn 80 quốc gia thông qua các Nhà Nhập khẩu và Phân phối. Kể từ năm 2006, Gardena thuộc quyền sở hữu của Tập đoàn Husqvarna AB Thụy Điển. Gardena đã trở thành Thương hiệu ưa thích của hàng triệu chủ sở hữu nhà và vườn trên toàn thế giới bởi các sản phẩm đa dạng cùng chất lượng tuyệt vời.\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/7e/17/9f/84bfc745150300065368b32bb9b9f38a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/7e/17/9f/84bfc745150300065368b32bb9b9f38a.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/7e/17/9f/84bfc745150300065368b32bb9b9f38a.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7e/17/9f/84bfc745150300065368b32bb9b9f38a.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7e/17/9f/84bfc745150300065368b32bb9b9f38a.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/dc/28/10/53d2e7d9ffd95679499237207b75cae2.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/dc/28/10/53d2e7d9ffd95679499237207b75cae2.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/dc/28/10