/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":910000,"discount_rate":46,"rating_average":4.5,"review_count":42,"review_text":"(42)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/72/eb/4e/36aaaef281207a424a42db8abd0df065.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":627,"all_time_quantity_sold":150,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eQuý khách lưu ý: \u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u0026#43; Model Xiaomi Fan 2 Lite (1C) \u0026#34;KHÔNG TÍCH ĐIỆN\u0026#34; và không có \u0026#34;REMOTE\u0026#34; - Hiện tại thị trường Việt Nam là bản nội địa Trung Quốc, kết nối điện thoại bình thường.\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u0026#43; Model Xiaomi Smart Smartmi Fan 2S không có \u0026#34;REMOTE\u0026#34;\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eNhà bán sẽ không hỗ trợ đổi trả trường hợp khách hàng mua nhầm và khui SEAL sản phẩm. Xin tìm hiểu kỹ sản phẩm trước khi mua, hoặc yêu cầu nhà bán tư vấn.\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eQuạt thông minh Mi Smart Standing Fan 2 Lite - Cho làn gió mát tự nhiên\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eCác sản phẩm gia dụng thông minh của hãng Xiaomi đã tạo dựng nên tiếng vang lớn nhờ chất lượng cao cùng cách sử dụng đầy hiện đại. Và \u003cstrong\u003equạt thông minh Mi Smart Standing Fan 2 Lite\u003c/strong\u003e - với khả năng tái tạo làn gió mát tự nhiên - là một trong những sản phẩm ấy.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eKết cấu cánh quạt kép với nhiều tốc độ làm mát đa dạng\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eQuạt thông minh Mi Smart mang đến làn gió tự nhiên cho không gian của bạn. Mi Smart Standing Fan 2 Lite có kết cấu cánh quạt kép quay liên tục giúp tạo ra lượng gió mạnh hơn. Thân quạt có thiết kế linh hoạt, xoay trái / phải với phạm vi làm mát rộng, giúp lan tỏa luồng gió tự nhiên khắp căn phòng bạn.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://xiaomiworld.vn/upload_images/images/section12bg.jpg\" alt=\"section12bg.jpg\" width=\"750\" height=\"372\" /\u003e\u003c/p\u003e\n\u003cp\u003eQuạt thông minh Mi Smart Standing Fan 2 Lite hỗ trợ 2 chế độ làm mát: gió tự nhiên và gió mạnh, đạt tốc độ gió phù hợp với từng điều kiện môi trường. Đặc biệt, bạn có thể kết nối quạt Mi Smart Standing Fan 2 Lite với điện thoại của mình qua ứng dụng Mi Home, giúp bạn thoải mái điều chỉnh quạt từ xa và tận hưởng gió mát.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://xiaomiworld.vn/upload_images/images/fan2lite6%281%29.jpg\" alt=\"fan2lite6(1).jpg\" width=\"750\" height=\"405\" /\u003e\u003c/p\u003e\n\u003cp\u003eQuạt cũng hỗ trợ điều khiển giọng nói từ xa thông minh Google Assistant và Alexa.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eHoạt động công suất mạnh với lượng điện tiêu thụ thấp\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eQuạt thông minh Mi Smart cung cấp hiệu suất làm mát cao với lượng điện tiêu thụ thấp. Bộ motor DC lõi dây đồng bên trong sẽ giúp cho quạt vận hành ổn định dài lâu kèm theo yếu tố tiết kiệm điện, giúp bạn yên tâm sử dụng mà không lo hao tốn điện năng trong nhà.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://xiaomiworld.vn/upload_images/images/fan2lite.jpg\" alt=\"fan2lite.jpg\" width=\"750\" height=\"390\" /\u003e\u003c/p\u003e\n\u003cp\u003eBộ motor DC bên trong cũng được tối ưu độ tĩnh cho quạt thông minh. Cho dù ở tốc độ làm mát cao, Mi Smart Standing Fan cũng sẽ vận hành êm ái, không gây tiếng động, tạo nên trải nghiệm làm mát đầy yên tĩnh và không gây phiền hà.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://xiaomiworld.vn/upload_images/images/fan2lite2.jpg\" alt=\"fan2lite2.jpg\" width=\"750\" height=\"477\" /\u003e\u003cimg src=\"https://xiaomiworld.vn/upload_images/images/fanliet56.jpg\" alt=\"fanliet56.jpg\" width=\"750\" height=\"465\" /\u003e\u003cimg src=\"https://xiaomiworld.vn/upload_images/images/fan2litefffff.jpg\" alt=\"fan2litefffff.jpg\" width=\"750\" height=\"397\" /\u003e\u003cimg src=\"https://xiaomiworld.vn/upload_images/images/fan2lite767.jpg\" alt=\"fan2lite767.jpg\" width=\"750\" height=\"355\" /\u003e\u003cimg src=\"https://xiaomiworld.vn/upload_images/images/fan2lite19.jpg\" alt=\"fan2lite19.jpg\" width=\"750\" height=\"353\" /\u003e\u003cimg src=\"https://xiaomiworld.vn/upload_images/images/fan2literrrrr.jpg\" alt=\"fan2literrrrr.jpg\" width=\"750\" height=\"353\" /\u003e\u003cimg src=\"https://xiaomiworld.vn/upload_images/images/fan2lite9.jpg\" alt=\"fan2lite9.jpg\" width=\"750\" height=\"480\" /\u003e\u003cimg src=\"https://xiaomiworld.vn/upload_images/images/fan2lite4444444444.jpg\" alt=\"fan2lite4444444444.jpg\" width=\"750\" height=\"442\" /\u003e\u003cimg src=\"https://xiaomiworld.vn/upload_images/images/fan2lite8.jpg\" alt=\"fan2lite8.jpg\" width=\"750\" height=\"401\" /\u003e\u003cimg src=\"https://xiaomiworld.vn/upload_images/images/fan2lite7.jpg\" alt=\"fan2lite7.jpg\" width=\"750\" height=\"453\" /\u003e\u003cimg src=\"https://xiaomiworld.vn/upload_images/images/fan2lite6.jpg\" alt=\"fan2lite6.jpg\" width=\"750\" height=\"405\" /\u003e\u003cimg src=\"https://xiaomiworld.vn/upload_images/images/fan2lite5.jpg\" alt=\"fan2lite5.jpg\" width=\"750\" height=\"373\" /\u003e\u003cimg src=\"https://xiaomiworld.vn/upload_images/images/fan2lite4.jpg\" alt=\"fan2lite4.jpg\" width=\"750\" height=\"467\" /\u003e\u003cimg src=\"https://xiaomiworld.vn/upload_images/images/fan2lite3.jpg\" alt=\"fan2lite3.jpg\" width=\"750\" height=\"475\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/72/eb/4e/36aaaef281207a424a42db8abd0df065.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/72/eb/4e/36aaaef281207a424a42db8abd0df065.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/72/eb/4e/36aaaef281207a424a42db8abd0df065.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/72/eb/4e/36aaaef281207a424a42db8abd0df065.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/72/eb/4e/36aaaef281207a424a42db8abd0df065.png"}],"warranty_policy":null,"brand":{"id":25422,"name":"Xiaomi","slug":"xiaomi"},"current_seller":{"id":193366,"sku":"4240080188063","name":"HOMES STORE","link":"https://tiki.vn/cua-hang/homes-store","logo":"f5/41/53/f3a278748983b3b5ebadff2d72d198a1.jpg","price":1089000,"product_id":"274440245","store_id":180399,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Thông tin chung","attributes":[{"code":"remote_control","name":"Remo