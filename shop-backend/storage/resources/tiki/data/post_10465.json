,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":60000,"discount_rate":15,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/4f/1c/ff/2eebae23948ed01b7e25840a1972edad.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":670,"all_time_quantity_sold":10,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p><strong>ĐẶC ĐIỂM NỔI BẬT</strong></p>\n<ul><li>Sản phẩm đạt tiêu chuẩn xuất khẩu đến hơn 30 quốc gia như Nhật Bản, Châu Âu, Hàn Quốc, Đài Loan…</li>\n</ul><p>-     17 năm liên tục đạt danh hiệu HVNCLC (2005-2022)</p>\n<p>-     Sản phẩm được mua bảo hiểm lên đến 7 tỷ đồng</p>\n<p>-     Bảo hành 12 tháng</p>\n<p>-     Hỗ trợ vận chuyển</p>\n<p>-     Tư vấn 24/7</p>\n<p><strong> </strong></p>\n<p><strong>TÍNH NĂNG ƯU VIỆT CỦA BẾP </strong></p>\n<p><strong><em> </em></strong></p>\n<p><strong>ĐỘ AN TOÀN CAO</strong></p>\n<p>Bếp gas mini (hay còn gọi là bếp gas du lịch) NaMilux Mother được trang bị hệ thống van <strong>Inline Cut</strong>  - <strong>ngắt gas tự động</strong>, được sản xuất trên dây chuyền đạt chuẩn Quốc Tế &amp; độ an toàn cao: khi sử dụng lon gas có áp quá cao (thường là lon gas sạc lại), bộ phận ngắt gas sẽ tự động ngắt gas và tắt lửa, đảm bảo an toàn tuyệt đối trong suốt quá trình sử dụng bếp.</p>\n<p>Công nghệ dập xếp mí giúp dễ dàng vệ sinh sau khi sử dụng</p>\n<p>Chân kiềng bếp 2 cấp giúp đặt nồi, chảo không bị trơn trượt</p>\n<p>Thân bếp:  được sản xuất trên công nghệ dập TRANSFER ROBOT tạo kết cấu vững chắc và đồng bộ. Thân bếp được dập xếp mí toàn bộ tăng độ cứng và an toàn khi vệ sinh lau chùi bếp không bị đứt tay</p>\n<p>Tiết kiệm gas: Hệ thống đầu đốt được thiết kế theo công nghệ hiện đại của Nhật Bản đạt tiêu chuẩn cao về hiệu suất đốt giúp tiết kiệm gas và nồng độ khí thải thấp</p>\n<p> </p>\n<p><strong>THÔNG SỐ KỸ THUẬT</strong></p>\n<p>Mã sản phẩm:        PL-2111PF</p>\n<p>Công suất:               2.6kW (2,200 kcal/h)</p>\n<p>Gas sử dụng:           Lon gas mini</p>\n<p>Tính năng an toàn: Van ngắt tự động – Inline Cut</p>\n<p>Khối lượng:             1.3 kg</p>\n<p>Kích thước:             C99 x D332 x R283 mm</p>\n<p>Thương hiệu:           NaMilux</p>\n<p>Xuất xứ:                   Việt Nam</p>\n<p>Bảo hành:                12 tháng</p>\n<p> </p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/4f/1c/ff/2eebae23948ed01b7e25840a1972edad.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/4f/1c/ff/2eebae23948ed01b7e25840a1972edad.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/4f/1c/ff/2eebae23948ed01b7e25840a1972edad.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4f/1c/ff/2eebae23948ed01b7e25840a1972edad.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4f/1c/ff/2eebae23948ed01b7e25840a1972edad.png"},{"base_url":"https://salt.tikicdn.com/ts/product/d7/55/54/10ec5b305d06712077592e899eb1947b.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d7/55/54/10ec5b305d06712077592e899eb1947b.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d7/55/54/10ec5b305d06712077592e899eb1947b.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/produc