_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/4e/71/3f/6335779ce760efe88e39c3e2c6cef291.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":903,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eKem Dưỡng Da Nâng Cơ Ngăn Ngừa Lão Hóa Medi-Peel Bor-Tox Peptide Cream\u003c/strong\u003e là  thuộc thương hiệu \u003cstrong\u003e \u003c/strong\u003echứa thành phần chính gồm Volufiline đến từ Pháp, 7 loại thành phần lên men cùng 5 loại Peptide giúp cung cấp dưỡng chất cải thiện nếp nhăn hiệu quả, nâng cơ, cho da đàn hồi săn chắc hơn. \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/0b/cc/e2/70f22d6c31ab45d4e9946596927f49fa.jpg\" alt=\"\" width=\"639\" height=\"639\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e• Đặc trưng:\u003c/strong\u003e\u003c/p\u003e\n\u003cul style=\"list-style-type: circle;\"\u003e\n\u003cli\u003e\u003cstrong\u003eKem Dưỡng Da Nâng Cơ Ngăn Ngừa Lão Hóa Medi-Peel Bor-Tox Peptide Cream\u003c/strong\u003e với thành phần\u003cstrong\u003e Volufiline \u003c/strong\u003elà một thành phần có nguồn gốc từ cây Jimo để kích thích sự phát triển của các tế bào mỡ từ đó giúp bù đắp những khuyết điểm trên da mặt như nếp nhăn ở mắt, da chảy xệ, mất độ đàn hồi.\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003e5 loại Peptide Copper Tripeptide-1, Acetylhexapeptide-8, Palmitoylpentapeptide-4, Palmitoyl Tetrapeptide -7, Palmitoyl Tripeptide-1\u003c/strong\u003e các chuỗi này như là chuỗi Axit Amin nhỏ có tác động đến việc tái tạo Collagen, giúp tăng khả năng đàn hồi và nâng cơ cho da.\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003e7 loại thành phần lên men được chiết xuất từ thiên nhiên bao gồm gạo, lê, lựu, tương đậu và lúa mạch với lợi khuẩn Lactobacillus\u003c/strong\u003e có công dụng dưỡng ẩm, cải thiện màu da, ngăn ngừa quá trình Oxy hóa trên da\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eChiết xuất từ mô sẹo hoa Edelweiss\u003c/strong\u003e bằng cách áp dụng kỹ thuật nuôi cấy công nghệ SMART-RC² đã được cấp bằng sáng chế giúp dưỡng ẩm, làm dịu và cải thiện nếp nhăn, và đã được khẳng định có tác dụng ngăn ngừa lão hóa thông qua các thử nghiệm lâm sàng.\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eAdenosine\u003c/strong\u003e có chức năng như một chất phục hồi và làm dịu da, giảm sự xuất hiện của các nếp nhăn bằng cách cung cấp dưỡng chất cho bề mặt da mang đến một làn da mịn màng hơn, trẻ trung.\u003c/li\u003e\n\u003cli\u003eSản phẩm có màu trắng, kết cấu mỏng nhẹ,  thẩm thấu nhanh và không gây nhờn dính khi sử dụng.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003e• Đối tượng khuyên dùng:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Dành cho \u003c/p\u003e\n\u003cp\u003e- Dành cho da đang có các\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e• Hướng dẫn sử dụng\u003c/strong\u003e: \u003c/p\u003e\n\u003cp\u003eSử dụng ở bước cuối cùng trong chu trình chăm sóc da mỗi sáng và tối. Lấy ra một lượng kem vừa đủ và thoa đều trên khắp khuôn mặt. Vỗ nhẹ để dưỡng chất hấp thụ hết vào da.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/20/51/e1/3bbb138f9f0c1f1ea087640c2e557f93.jpg\" width=\"750\" height=\"1124\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product