type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":true,"return_reason":"any_reason"}},"discount":3234000,"discount_rate":30,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/e5/f0/01/97c939487d87d7538718eda01c8567f3.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":277,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cul\u003e\n\u003cli style=\"text-align:justify;\"\u003eThương hiệu: OHAHA\u003c/li\u003e\n\u003cli style=\"text-align:justify;\"\u003eChất liệu: Khung sắt sơn tĩnh điện kết hợp MDF lõi xanh chống ẩm\u003c/li\u003e\n\u003cli style=\"text-align:justify;\"\u003eSản phẩm thân thiện với môi trường, đạt tiêu chuẩn xuất khẩu\u003c/li\u003e\n\u003cli style=\"text-align:justify;\"\u003eĐã qua xử lý chống cong vênh, mối mọt\u003c/li\u003e\n\u003cli style=\"text-align:justify;\"\u003eBảo hành chính hãng 24 tháng\u003c/li\u003e\n\u003cli style=\"text-align:justify;\"\u003eKích thước nệm:\n\u003cul\u003e\n\u003cli\u003e1m x 2m\u003c/li\u003e\n\u003cli\u003e1m2 x 2m\u003c/li\u003e\n\u003cli\u003e1m4 x 2m\u003c/li\u003e\n\u003cli\u003e1m6 x 2m\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/li\u003e\n\u003cli style=\"text-align:justify;\"\u003e\u003cem\u003e\u003cstrong\u003eKích thước tổng thể: (Dài x Rộng x Cao) 255 x 107/127/147/167 x 190cm\u003c/strong\u003e\u003c/em\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align:justify;\"\u003e- Sản phẩm giao và lắp đặt miễn phí tại TP.HCM và một số tỉnh lân cận.\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e- Các tỉnh khác có thể phát sinh chi phí vận chuyển (200k-500k). \u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e- Hướng dẫn video lắp đặt chi tiết đơn giản đối với khách tỉnh.\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e####\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003eGiường tầng thông minh khung sắt Ohaha - GTS006\u003c/strong\u003e được rất nhiều khách hàng yêu thích và lựa chọn bởi thiết kế thẩm mỹ, chắc chắn và đầy đủ tiện nghi.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/product/db/35/89/88c119a427e0a70ea381e51c743662ad.png\" alt=\"Giường tầng sắt - GTS006\" width=\"600\" height=\"600\" /\u003e\u003c/p\u003e\n\u003ch2 style=\"text-align:justify;\"\u003e\u003cstrong\u003eGiường tầng sắt thông minh tiện dụng và tối ưu\u003c/strong\u003e\u003c/h2\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003eGiường tầng sắt - GTS006\u003c/strong\u003e được thiết kế tiện dụng, tiết kiệm diện tích và chắc chắn, an toàn cho cả người lớn và trẻ nhỏ khi nằm. Đây là sự lựa chọn ưu việt cho không gian nội thất phòng ngủ nhỏ hẹp. \u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003eMẫu \u003cstrong\u003egiường tầng sắt - GTS006\u003c/strong\u003e được thiết kế đầy đủ tủ đồ, các ngăn kệ chứa đồ. Sản phẩm là sự kết hợp giữa sắt sơn tĩnh điện và MDF lõi xanh chống ẩm phủ Melamine 2 mặt.\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003eThành giường xung quanh được làm cao và chắc chắn, đảm bảo an toàn cho khách hàng khi nằm ngủ không bị ngã. Phần cầu thang cũng được thiết kế vô cùng tỉ mỉ với mặt bước to, rộng và tay vịn lớn để an toàn cho khách hàng khi bước đi.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/product/ed/a4/a2/e6630ae55a5beb34b3d419ee82d9d189.png\" alt=\"Giường tầng sắt - GTS006\" width=\"600\" height=\"600\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/product/94/86/2c/8065e53b2b3175cdea7b375fc7d2bb03.png\" alt=\"Giường tầng sắt - GTS006\" width=\"600\" height=\"600\" /\u003e\u003c/p\u003e\n\u003ch2 style=\"text-align:justify;\"\u003e\u003cstrong\u003eGiường tầng sắt - chất liệu an toàn, thân thiện với môi trường.\u003c/strong\u003e\u003c/h2\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003eGiường tầng sắt - GTS006\u003c/strong\u003e được làm từ khung sắt sơn tĩnh điện và gỗ MDF lõi xanh nhập khẩu, bề mặt phủ Melamine 2 mặt chống ẩm tốt.\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003eSản phẩm không chỉ đẹp hơn về mỹ quang mà còn mang lại độ bền chắc lâu dài. Phần gỗ MDF đã qua xử lý chống cong vênh, mối mọt bằng công nghệ của Đức. Sản phẩm thân thiện, an toàn cho sức khỏe gia đình và môi trường.\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003ePhụ kiện nhập khẩu đảm bảo chất lượng uy tín. \u003cstrong\u003eGiường tầng\u003c/strong\u003e được thiết kế cam kết an toàn về kỹ thuật, có thể chịu được trọng lượng lớn nên gia đình có thể yên tâm khi sử dụng.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/e5/f0/01/97c939487d87d7538718eda01c8567f3.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e5/f0/01/97c939487d87d7538718eda01c8567f3.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e5/f0/01/97c939487d87d7538718eda01c8567f3.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e5/f0/01/97c939487d87d7538718eda01c8567f3.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e5/f0/01/97c939487d87d7538718eda01c8567f3.png"}],"warranty_policy":null,"brand":{"id":217345,"name":"OHAHA","slug":"ohaha"},"current_seller":{"id":8582,"sku":"3903111024169","name":"OHAHA","link":"https://tiki.vn/cua-hang/ohaha","logo":"2f/d3/c6/2b6218aeb413b72f783cd16e8bad4c16.jpg","price":7566000,"product_id":"273586313","store_id":8396,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Content","attributes":[{"code":"brand","name":"Thương hiệu","value":"OHAHA"},{"code":"brand_country","name":"Xuất xứ thương hiệu","value":"Việt Nam"},{"code":"material","name":"Chất liệu","value":"Khung sắt sơn tĩnh điện kết hợp MDF lõi xanh chống ẩm"},{"code":"Organization_address","name":"Địa chỉ tổ chức chịu trách nhiệm về hàng hóa","value":"Vĩnh Lộc A, Bình Chánh, HCM"},{"code":"Organization_name","name":"Tên đơn vị/tổ chức chịu trách nhiệm về hàng hóa","value":"Công ty TNHH Ohaha Việt Nam"},{"code":"origin","name":"Xuất xứ (Made in)","value":"Việt Nam"}]},{"name":"Operation","attributes":[{"code":"is_warranty_applied","name":"Sản phẩm có được bảo hành không?","value":"Không"},{"code":"seller_delivery_method","name":"Phương thức giao hàng Seller Delivery","value":"Nhà bán giao hàng cho khách hàng"}]}],"product_links":[],"