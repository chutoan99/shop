,"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/85/5a/6e/09eecd9542c8ce88c5e50b32eef3b081.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":0,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: medium; color: #008ab7;\"\u003e\u003cstrong\u003eKẹp Bướm Màu 25mm 8554\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eKẹp Bướm Màu 25mm 8554 \u003c/strong\u003egồm một hộp 48 cái với nhiều màu sắc khác nhau, cho bạn tuỳ ý sử dụng theo sở thích của mình. Sản phẩm có kích thước 25 mm, có thể kẹp chặt một lúc được rất nhiều tài liệu. Kẹp giấy cho lực kẹp khoẻ, phần lò xo của kẹp linh hoạt, nhẹ, dễ dùng.\u003c/p\u003e\r\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Kẹp Bướm Màu 25mm 8554\" src=\"http://tikicdn.com/media/catalog/product/9/0/9030.u634.d20160403.t215645.jpg\" alt=\"Kẹp Bướm Màu 25mm 8554\" width=\"420\" height=\"420\" /\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eThông tin sản phẩm\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eChất liệu bền chắc\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eSản phẩm được làm bằng chất liệu tốt, cứng và bền chắc. Bề mặt kẹp còn được phủ một lớp sơn gia nhiệt khó bong tróc, giúp chống gỉ, chống oxi hoá nhằm nâng cao tuổi thọ sản phẩm.\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eLực kẹp khoẻ, chắc chắn\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eKẹp giấy cho lực kẹp khoẻ, có thể kẹp chắc chắn được nhiều giấy cùng một lúc. Phần lò xo của kẹp linh hoạt, nhẹ, dễ dùng, bạn chỉ cần bóp nhẹ là có thể mở được độ rộng tối đa. Đồng thời, phần lo xo này cũng rất ổn định sau nhiều lần sử dụng, không bị lỏng hoặc bị bung rời.\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eTính tiện dụng cao\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eKẹp Bướm Màu 25mm 8554 có kích thước 25 mm, rất tiện dụng trong văn phòng, học tập, dùng để kẹp góc các liên giấy, tài liệu rời, nhằm giúp dễ dàng bảo quản, phân loại và tránh thất lạc. Sản phẩm gồm một hộp 48 cái với nhiều màu sắc khác nhau, cho bạn tuỳ ý sử dụng theo sở thích của mình.\u003cstrong\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/85/5a/6e/09eecd9542c8ce88c5e50b32eef3b081.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/85/5a/6e/09eecd9542c8ce88c5e50b32eef3b081.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/85/5a/6e/09eecd9542c8ce88c5e50b32eef3b081.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/85/5a/6e/09eecd9542c8ce88c5e50b32eef3b081.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/85/5a/6e/09eecd9542c8ce88c5e50b32eef3b081.jpg"},{"base_url":"https://salt.tikicdn.com/med