800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":35000,"discount_rate":35,"rating_average":4.5,"review_count":6,"review_text":"(6)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/4f/49/b3/fa36ca7fa06c3de2a7fc4bb7fb1aef4d.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":503,"all_time_quantity_sold":41,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eChai xịt tạo bọt vệ sinh giày Aikomi chính hãng, chất lượng\u003cbr /\u003e------------------------------------------------------------------------------\u003cbr /\u003e CAM KẾT CHẤT LƯỢNG SẢN PHẨM ĐÚNG NHƯ MÔ TẢ\u003cbr /\u003e ĐỔI TRẢ MIỄN PHÍ NẾU DO LỖI CỦA SHOP\u003cbr /\u003e Thông tin sản phẩm xịt tạo bọt vệ sinh giày khô Aikomi\u003cbr /\u003eHầu hết chúng ta không biết việc dùng bột giặt thông thường hoặc xà phòng để vệ sinh giày sẽ khiến giày của bạn dễ bị ố vàng, cứng và phai màu nghiêm trọng. Chai tạo bọt vệ sinh giày Aikomi đến từ Nhật Bản chắc chắn sẽ là lựa chọn hoàn hảo để duy trì sự sạch sẽ và trắng sáng cho đôi giày của bạn.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/5e/14/7c/7beb132bc896b44f3488f67961093b24.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e Tác dụng, tính năng chai xịt tạo bọt vệ sinh giày Aikomi\u003cbr /\u003e- Làm sạch các vết bẩn, vết ố nhẹ nhanh chóng, giúp đôi giày của bạn sáng bóng, trắng sạch như mới\u003cbr /\u003e- Nút nhấn ở đầu tiện lợi, dễ sử dụng \u003cbr /\u003e- Chỉ cần lau bằng khăn, không cần rửa lại với nước, giúp bạn tiết kiệm thời gian.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/be/65/d3/dd25b8a21608b815d4f12fb1129f3435.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e Hướng dẫn sử dụng chai xịt tạo bọt vệ sinh giày Aikomi\u003cbr /\u003e- Bước 1: Lắc nhẹ chai và xịt bọt đều lên phần cần làm sạch (Khoảng cách 15-20cm)\u003cbr /\u003e- Bước 2: Sau khi xịt bọt xong, bạn để bọt trong 1 phút \u003cbr /\u003e- Bước 3: Sau 2 phút bạn sử dụng bàn chải để chà và lau chùi các bộ phận bạn muốn vệ sinh\u003cbr /\u003e- Bước 4: Cuối cùng thì dùng khăn mềm để loại bỏ bọt, lâu khô các bụi bẩn. \u003cbr /\u003eLưu ý: Đối với vết bẩn cứng đầu, bạn lặp lại bước 1-4 (Từ 1 đến 3 lần). các vết tẩy ố nhẹ có thể clean sạch, còn đối với các vết sơn hay ố lâu ngày cần phải dùng sản phẩm Tẩy ố chuyên dụng của Aikomi để làm sạch.\u003c/p\u003e\n\u003cp\u003e Xuất xứ: Nhật Bản\u003cbr /\u003e Hạn sử dụng: 03 năm\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/21/89/3d/24bb89d6945312fe8e33ce1a7161fb9b.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eCHÍNH SÁCH ĐỔI HÀNG:\u003cbr /\u003e Để đảm bảo quyền lợi cho người tiêu dùng, shop khuyến khích quý khách hàng phải quay video và kiểm tra kỹ tình trạng sản phẩm trong quá trình mở hộp. Ngoài ra quý khách cần kiểm tra sản phẩm có bể, trầy xước do tác động bên ngoài, màu sắc, số lượng, có đúng chủng loại, thông số kỹ thuật hay không. Nếu sản phẩm không đúng như thông tin mua hàng, ảnh hưởng bởi quá trình vận chuyển, quý khách vui lòng thông báo ngay cho shop để shop hỗ trợ hoàn hàng và trả.\u003c/p\u003e\n\u003cp\u003e#vesinhgiay #vesinhgiaysneaker #vesinhgiaysnoker #dungdichvesinhgiay #xitvesinhgiay #chaivesinhgiay #xittaobot #nuoclaugiay #lamsachgiay #giatgiay #giaydep #giay #giaythethao #cleangiay #Aikomi #NhatBan\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/4f/49/b3/fa36ca7fa06c3de2a7fc4bb7fb1aef4d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/4f/49/b3/fa36ca7fa06c3de2a7fc4bb7fb1aef4d.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/4f/49/b3/fa36ca7fa06c3de2a7fc4bb7fb1aef4d.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4f/49/b3/fa36ca7fa06c3de2a7fc4bb7fb1aef4d.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4f/49/b3/fa36ca7fa06c3de2a7fc4bb7fb1aef4d.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/9c/dd/15/ffc6b5ba018af744b6f97e60ecc686cd.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/9c/dd/15/ffc6b5ba018af744b6f97e60ecc686cd.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/9c/dd/15/ffc6b5ba018af744b6f97e60ecc686cd.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9c/dd/15/ffc6b5ba018af744b6f97e60ecc686cd.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9c/dd/15/ffc6b5ba018af744b6f97e60ecc686cd.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/4f/87/5f/3cf5d34e0e478ee956d23573aa30a540.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/4f/87/5f/3cf5d34e0e478ee956d23573aa30a540.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/4f/87/5f/3cf5d34e0e478ee956d23573aa30a540.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4f/87/5f/3cf5d34e0e478ee956d23573aa30a540.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4f/87/5f/3cf5d34e0e478ee956d23573aa30a540.jpg"}