dge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":234000,"discount_rate":47,"rating_average":4.6,"review_count":10,"review_text":"(10)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ab/4c/6c/8273cb4ff9ffff4ba6e3df3d773aa7d0.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":454,"all_time_quantity_sold":41,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eBộ tạ miếng nhựa đen ( 10kg ; 20kg; 30kg; 40kg; ) gồm:\u003c/p\u003e\n\u003cp\u003e- Thanh nối \u0026amp; khóa\u003c/p\u003e\n\u003cp\u003e- Tạ miếng nhựa 10kg: 1kg - 4 miếng; 1.25kg - 4 miếng\u003c/p\u003e\n\u003cp\u003e- Tạ miếng nhựa 20 kg : 2kg - 4 miếng; 1,5kg - 4 miếng \u0026amp; 1,25kg - 4 miếng\u003c/p\u003e\n\u003cp\u003e- Tạ miếng nhựa 30 kg : 2,5kg - 4 miếng ; 2kg - 4 miếng; 1,5kg - 4 miếng \u0026amp; 1,25kg - 4 miếng\u003c/p\u003e\n\u003cp\u003e- Tạ miếng nhựa 40 kg : 3kg - 8 miếng ; 2,5kg - 4 miếng \u0026amp; 1,25kg - 4 miếng \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/0c/5a/60/b8e55e75b0cc1e841f0097e25ad53959.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eTạ tay hay tạ tay đơn là dòng sản phẩm phổ biến hiện nay và được rất nhiều người lựa chọn để tập luyện.\u003c/p\u003e\n\u003cp\u003eTạ tay đơn được thiết kế đơn giản và có thể luyện tập ngay tại nhà, các bài tập với tạ tay đơn cũng rất dễ dàng, gọn nhẹ. Những động tác có thể thực hiện với tạ đơn chủ yếu cho vùng bụng và tay, vai hay ngực cùng với nhiều cân nặng khác nhau để có thể tập luyện.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/fa/31/09/64c37be62c3ac9e1c446e2e65bca8a71.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eVới độ bề cao, đáp ứng mọi nhu cầu tập luyện của bạn.Ngoài ra tạ còn được thiết kế đẹp mắt, đòn tạ cầm nắm chắc chắn giúp bạn yên tâm tập luyện.\u003c/p\u003e\n\u003cp\u003eTạ có thể tháo lắp dễ dàng để tăng hoặc giảm cân nặng phù hợp nhiều bài tập khác nhau. Bên ngoài bọc nhựa cứng dày \u0026#43; có độ bền cao và nó có nhiều trọng lượng khác nhau cho bạn lựa chọn. Đường kính và độ dày của mỗi miếng tạ sẽ được điều chỉnh sao cho phù hợp với từng mức cân nặng cụ thể.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/01/92/4e/ee6df1144c901e13ab1393ecc1fcb29f.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/7d/cc/b5/d6ba122e5e2aa4414bb5f5cde2f7585d.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/b9/2b/6e/664b8ff2a6db8972a7e770b14ec4f229.JPG\" alt=\"664b8ff2a6db8972a7e770b14ec4f229.JPG\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/aa/7a/b9/526045cf22d3d87e81a3b2f4d6a5664d.png\" alt=\"\" width=\"916\" height=\"826\" /\u003e\u003c/p\u003e\n\u003cp\u003eTrên mỗi miếng tạ có ghi rõ trọng lượng từng quả tạ, giúp người sử dụng có thể dễ dàng phân biệt.\u003c/p\u003e\n\u003cp\u003eTạ miếng nhựa phù hợp dùng để ghép vào đòn tạ đẩy, đòn tạ tay hoặc các mẫu ghế tập tạ để thực hiện các bài tập Gym tại nhà. Ưu điểm của tạ miếng nhựa này là giá rẻ và phù hợp với tất cả các mẫu đòn tạ dùng tập thể hình tại nhà.\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/63/c2/83/c6d165b22fbeba7d6ff666b25e70cd28.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/b0/7e/0a/2c25a0bdb684d6e80b1a272605f6b172.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ab/4c/6c/8273cb4ff9ffff4ba6e3df3d773aa7d0.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ab/4c/6c/8273cb4ff9ffff4ba6e3df3d773aa7d0.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ab/4c/6c/8273cb4ff9ffff4ba6e3df3d773aa7d0.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ab/4c/6c/8273cb4ff9ffff4ba6e3df3d773aa7d0.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ab/4c/6c/8273cb4ff9ffff4ba6e3df3d773aa7d0.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/8e/a7/d8/93082089531ad270992e170a46d310f3.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/8e/a7/d8/93082089531ad270992e170a46d310f3.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/8e/a7/d8/93082089531ad270992e170a46d310f3.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8e/a7/d8/93082089531ad270992e170a46d310f3.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8e/a7/d8/93082089531ad270992e170a46d310f3.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/3e/e2/90/a07d3aa427236be9dffce951cdf8286e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/pro