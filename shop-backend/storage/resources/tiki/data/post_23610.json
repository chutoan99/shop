text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.6,"review_count":33,"review_text":"(33)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/b9/30/86/91bcacc732868ae316fc6dbe4adbd1e5.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1194,"all_time_quantity_sold":135,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eDây sạc type C to C PROLiNK GCC_100G2_01 dài 2M, Sạc siêu nhanh 100W, truyền dữ liệu audio, video 4K\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e️ Một loại cáp đa chức năng: cung cấp khả năng truyền dữ liệu siêu tốc, sạc phân phối điện năng cao và chia sẻ video liền mạch cho mọi thiết bị tương thích Type-C. Được thiết kế để mang lại sự tiện lợi và bền bỉ.\u003c/p\u003e\n\u003cp\u003e️ Truyền dữ liệu liền mạch: nói lời tạm biệt với thời gian dài chờ đợi. Cáp USB 3.2 Thế hệ 2 này mang lại tốc độ truyền dữ liệu 10Gbps nhanh chóng đáng kinh ngạc, cho phép bạn truyền các tệp lớn quan trọng một cách dễ dàng hoặc thậm chí tải xuống bộ phim HD yêu thích của bạn chỉ trong vài giây.\u003c/p\u003e\n\u003cp\u003e️ Tăng sức mạnh cho thiết bị của bạn: tận hưởng khả năng sạc nhanh hơn, mạnh hơn và ổn định hơn với 100W Power Delivery 3.0, QC4.0 Sạc nhanh cho mọi thiết bị tương thích Type-C, như điện thoại thông minh, máy tính bảng và máy tính xách tay Android yêu thích của bạn.\u003c/p\u003e\n\u003cp\u003e️ Màn hình 4K Ultra HD: cung cấp chế độ thay thế DisplayPort (DP Alt Mode), âm thanh và tín hiệu video 4K @ 60Hz cho đầu ra video và kết nối màn hình/ màn hình hiển thị USB-C (Lưu ý: Chức năng video hoạt động đối với những thiết bị có cổng USB C hỗ trợ Chế độ thay thế DP).\u003c/p\u003e\n\u003cp\u003e️ Độ bền đáp ứng sự tiện lợi: được bọc trong lớp vỏ ngoài bằng nylon bện cao cấp với đầu nối cao su giảm sức căng cho sợi cáp chắc chắn hơn, có khả năng chống đứt và không bị rối. \u003c/p\u003e\n\u003cp\u003e️ Đầu nối hình chữ L: làm việc và giải trí không bị gián đoạn khi bạn đang cắm điện! Đầu nối hình chữ L cung cấp một vị trí cầm thoải mái, cho phép bạn bật nguồn hoặc đồng bộ hóa thiết bị của mình trong khi cắm vào. \u003c/p\u003e\n\u003cp\u003e️ Chip thông minh E-Mark: bộ điều khiển giao thức thông minh để đảm bảo an toàn cho bạn và tránh quá tải cho việc truyền tải điện năng, giúp bạn yên tâm hơn khi sử dụng loại cáp này.\u003c/p\u003e\n\u003cp\u003e️ Sản phẩm phù hợp với người dùng: nhiếp ảnh gia, nhà quay phim, sạc máy tính xách tay và điện thoại thông minh.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/90c287a3f35782649b55e91b40042b56\" alt=\"90c287a3f35782649b55e91b40042b56\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/c85689f40b0342543f870bc706d065a8\" alt=\"c85689f40b0342543f870bc706d065a8\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/3ae14203b0970fbb20a29273cf68c4cd\" alt=\"3ae14203b0970fbb20a29273cf68c4cd\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/976ca7bceb5f22b84011f68554679b35\" alt=\"976ca7bceb5f22b84011f68554679b35\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/26e26dd00c1a029ca1895ac3f74abab6\" alt=\"26e26dd00c1a029ca1895ac3f74abab6\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/53337f2582c046ef365318f914997770\" alt=\"53337f2582c046ef365318f9149