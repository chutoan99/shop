:null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":5,"review_text":"(5)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/media/catalog/product/b/i/bi-mat-ufo.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2754,"all_time_quantity_sold":31,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"color: #ff6600; font-size: medium;\"\u003e\u003cstrong\u003eBí Mật UFO\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eBí mật UFO\u003c/strong\u003e - Công bố các tài liệu mật về sự xuất hiện của UFO từ chính phủ, các tướng lĩnh và phi công trên thế giới. Những chương sách mà bạn sắp đọc sau đây sẽ giúp bạn tìm hiểu những vấn đề cơ bản nhất về hiện tượng UFO. Chúng ta thực sự biết gì về chúng? Có thật là một số UFO có nguồn gốc ngoài trái đất? Các phi công có bao giờ đối mặt với chúng không? Chính phủ và quân đội phản ứng thế nào trước hiện tượng này? Tại sao lại xuất hiện sự giễu cợt và phủ nhận hiện tượng UFO tại Hoa Kỳ? Câu trả lời cho những câu hỏi này chắc chắn sẽ khiến cho bạn phải ngạc nhiên.\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\"Đây là cuốn sách tuyệt vời, được viết với thái độ nghiêm túc và chính xác. Tất cả những ai quan tâm đến đề tài UFO đều phải đọc cuốn sách này.\" - \u003cstrong\u003eTiến sĩ Rudy Schild\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\"Leslie Kean là tín đồ của thuyết bất khả thi về đề tài UFO. Tác giả không viết về những niềm tin, tác giả viết về sự thật.\"- \u003cstrong\u003eMiles O'Brien, cựu phóng viên CNN\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\"Nếu bạn không biết nhiều về UFO, bạn phải đọc cuốn sách này. Nếu bạn nghĩ rằng UFO là đề tài vô nghĩa, cuốn sách này sẽ giúp bạn tỉnh ngộ.\"- \u003cstrong\u003eTiến sĩ Don Donderi, Khoa tâm lý\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\"Cuốn sách này trình bày những thông tin chính xác nhất về UFO qua các tài liệu của chính phủ và các bản báo cáo trực tiếp từ các phi công và các tướng lĩnh quân sự. Kean có khả năng phân tích sâu sắc và thuyết phục.\" - \u003cstrong\u003eTiến sĩ Harold E.Puthoft, Chủ tịch học viện Advanced Studies tại Austin.\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/media/catalog/product/b/i/bi-mat-ufo.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/b/i/bi-mat-ufo.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/b/i/bi-mat-ufo.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/b/i/bi-mat-ufo.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/b/i/bi-mat-ufo.jpg"}],"warranty_policy":null,"authors":[{"id":19884,"name":"Leslie Kean","slug":"leslie-kean"}],"current_seller":{"id":174532,"sku":"1379794479933","name":"TNHH Sách Đông Nam","link":"https://tiki.vn/cua-hang/tnhh-sach-dong-nam","logo":"7e/13/1f/8c6c5bd3ff99e293bd44180f5bb46714.jpg","price":54400,"product_id":"84717612","store_id":161568,"is_best_store":false,"is_offline_installment