index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":19800,"discount_rate":20,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/19/0e/5a/d82b5b7033ab863d6f3c5b75dcae4213.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":603,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eGiới thiệu sản phẩm:\u003cbr /\u003e- Pin 900mAh \u003cbr /\u003e- Đèn pin sạc LED đội đầu COMET CRT1612 có thiết kế đẹp, gọn nhẹ, thông minh và vô cùng tiện dụng kết hợp với cường độ và phạm vi chiếu sáng ấn tượng sẽ khiến bạn ấn tượng. \u003cbr /\u003e\u003cbr /\u003e- Đèn thiết kế theo kiểu đeo trên trán rất tiện lợi, bạn không cần dùng tay để cầm mà có thể thoải mái hoạt động, làm việc. Với đặc điểm này, Đèn pin sạc LED đội đầu CRT1612 rất thích hợp cho những công việc trong điều kiện thiếu ánh sáng như: đi bộ, soi ếch, cạo mũ cao su, câu cá và đánh bắt cá ban đêm, việc đồng án hàng ngày hay trên nương rẫy, leo núi, công việc hầm mỏ, sửa chửa máy móc hay đơn giản là nhà mất điệ\u003cbr /\u003e\u003cbr /\u003e- Sản phẩm được thiết kế thông minh với chuôi sạc ẩn trong thân sản phẩm, bạn không cần phải mang theo dây sạc hoặc vướn víu dây khi sạc. Bạn chỉ cần đẩy chuôi sạc trong thân sản phẩm, cắm trực tiếp vào ổ cắm là có thể an tâm làm những công việc khác cho đến khi CRT1612 được sạc xong, thật dễ dàng và thuận tiện.\u003cbr /\u003e\u003cbr /\u003eNgoài ra, Đèn pin sạc LED đội đầu COMET CRT1612 có 2 chế độ chiếu sáng: Cốt và pha, giúp bạn điều chỉnh cường độ chiếu sáng, phạm vi chiếu sáng phù hợp nhất với mục đích sử dụng. Ngoài ra, đèn pin còn có thể điều chỉnh góc chiếu lên hoặc xuống cho đến khi nào phù hợp với góc chiếu sáng mà bạn mong muốn.\u003cbr /\u003e\u003cbr /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/31/0c/d0/1362191b1d9058bf08bfb8e456a87f2c.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003e\u003cbr /\u003eThiết kế đế của CRT1612 hoàn toàn độc lập với thân đèn, giúp việc đeo trên đầu lâu không gây nóng, đây là một cải tiến rất thực tế dựa trên ý kiến đóng góp của khách hàng. Ngoài ra, đèn CRT1612 còn có thể sử dụng như đèn pin đi đường khi tháo rời đây đeo ra, mang theo đi đường vào ban đêm rất sáng.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cbr /\u003e\u003cbr /\u003e\u003cbr /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/dd/2f/1d/af05b8668f505bb0d17078adb01d8f17.jpg\" alt=\"\" width=\"750\" height=\"416\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e* Đặc điểm nổi bật\u003cbr /\u003e\u003cbr /\u003eĐèn pin thiết kế dạng đội đầu, có thể điều chỉnh hướng chiếu sáng lên - xuống dễ dàng.\u003cbr /\u003e\u003cbr /\u003eSản phẩm tiện dùng khi di chuyển trong bóng tối như đi du lịch, dã ngoại, làm việ\u003cbr /\u003e\u003cbr /\u003eVới 1 bóng đèn LED công suất 3W, cho ánh sáng mạnh, tiết kiệm điện, đáp ứng nhu cầu sử dụng.\u003cbr /\u003e\u003cbr /\u003eThời gian sạc từ 12 - 15 giờ\u003cbr /\u003e\u003cbr /\u003eThời gian sử dụng từ 1 tiếng đối với ánh sáng mạnh, 4 tiếng đối với ánh sáng yếu.\u003cbr /\u003e\u003cbr /\u003eĐèn có tuổi thọ lên đến 5 năm.\u003cbr /\u003e\u003cbr /\u003eChuôi sạc điện có thể thu gọn dễ dàng khi ngắt sạc. Khi cấm sạc đèn sẽ có màu đỏ, đầy pin đèn không đổi màu.\u003cbr /\u003e\u003cbr /\u003eSạc lại cho đèn đội đầu CRT1612 nếu 3 tháng không sử dụng để bảo vệ pin\u003cbr /\u003e\u003cbr /\u003eThương hiệu Comet - Việt Nam, sản xuất tại Trung Quốc.\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/60/c5/4a/b03c69068a662f4249e1b95eb6bfe0aa.jpg\" alt=\"\" width=\"750\" height=\"562\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/19/0e/5a/d82b5b7033ab863d6f3c5b75dcae4213.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/19/0e/5a/d82b5b7033ab863d6f3c5b75dcae4213.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/19/0e/5a/d82b5b7033ab863d6f3c5b75dcae4213.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/19/0e/5a/d82b5b7033ab863d6f3c5b75dcae4213.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/19/0e/5a/d82b5b7033ab863d6f3c5b75dcae4213.png"},{"base_url":"https://salt.tikicdn.com/ts/product/0f/2b/2e/5487aeb60f9797f63fe06846fe1fb99f.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0f/2b/2e/5487aeb60f9797f63fe06846fe1fb99f.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/0f/2b/2e/5487aeb60f9797f63fe06846fe1fb99f.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0f/2b/2e/5487aeb60f9797f63fe06846fe1fb99f.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0f/2b/2e/5487aeb60f9797f63fe06846fe1fb99f.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/31/0c/d0/7fd6fc61c771b99f4c5824eef9efe700.jpg","is_galler