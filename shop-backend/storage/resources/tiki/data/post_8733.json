dn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":1890000,"discount_rate":50,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/19/dc/1e/04eb612ebb25daad14df7185abd03073.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":747,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eĐộ phân giải 1600P sắc nét, chi tiết\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eCamera hành trình DDPAI MOLA N3/N3 GPS cho hình ảnh sắc nét với độ phân giải 2560×1600 pixel. Các chi tiết như biển số xe, hay biển tên đường với tầm xa lên tới 10m…Tầm nhìn bao quát rộng hơn camera thường với góc quay siêu rộng 140\u003csup\u003eo\u003c/sup\u003e lấy được hết hình ảnh cả hai bên đường.\u003c/p\u003e\n\u003cp\u003e\u003c/p\u003e\n\u003cp\u003e6 thấu kính khẩu độ F1.8 của camera cho phép ánh sáng đi qua và tới được các cảm biến hình ảnh bên trong len kính, nhờ đó hình ảnh được sắc nét hơn.\u003c/p\u003e\n\u003cp\u003e\u003c/p\u003e\n\u003cp\u003e\u003c/p\u003e\n\u003cp\u003eKể cả trong trường hợp thiếu ánh sáng thì khẩu độ F1.8 cũng giúp khắc phục tình trạng bị nhiễu hạt hay tối khi thời tiết không đủ ánh sáng (hôm trời đen, mưa sầm).\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eThiết kế dễ lắp đặt, chế độ theo dõi đỗ xe an toàn\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eCamera DDPAI Mola N3/N3 GPS có thiết kế tổng vô cùng trang nhã, phù hợp với mọi phong cách nội thất ô tô. Đặc biệt, với đầu nối Type-C đối xứng, bạn có thể dễ dàng xoay camera để quay video phía trước, xung quanh và quay ngược lại để chụp ảnh selfie bên trong xe.\u003c/p\u003e\n\u003cp\u003e\u003c/p\u003e\n\u003cp\u003eCamera hành trình DDPAI Mola N3/N3 GPS còn được tích hợp thêm chế độ đỗ xe an toàn cho ô tô của bạn. Theo đó, camera sẽ hiển thị hình ảnh giám sát bãi đỗ xe với tốc độ 1 khung hình/giây, vừa giúp tiết kiệm dung lượng lưu trữ, vừa đảm bảo an toàn cho xe của bạn.\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"aligncenter\" src=\"https://cf.shopee.vn/file/c7aae36fd1b01e9ad2dfce26d4f5b03c\" alt=\"c7aae36fd1b01e9ad2dfce26d4f5b03c\" /\u003e\u003c/p\u003e\n\u003cp\u003eLưu ý: Để khởi động chế độ này, camera cần được kết nối cố định với nguồn hoặc kết nối với pin\u003c/p\u003e\n\u003cblockquote\u003e\n\u003cp\u003e\u003cstrong\u003eMua thêm:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003c/blockquote\u003e\n\u003ch3\u003e\u003cstrong\u003eKết nối app dễ dàng, kết nối wifi tốc độ cao\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eDDPAI MOLA N3/N3 GPS sẽ ghi lại video quá trình lái xe của bạn, Bạn có thể xem và tải video thông qua app ứng dụng trên điện thoại. Đặc biệt các video quan trọng khi xe xảy ra va chạm hay rung lắc mạnh sẽ không bị ghi đè, bạn sẽ không cần bận tâm nhiều trong quá trình lái xe của mình.\u003c/p\u003e\n\u003cp\u003e\u003c/p\u003e\n\u003cp\u003eNgoài ra, camera có thể kết nối wifi một cách dễ dàng thông qua app DDPAI, cho phép bạn xem và tải xuống video HD trong thời gian thực. Bên cạnh đó, bạn cũng có thể chọn các video quan trọng bằng cách chuyển thành video Emergency để tránh bị ghi đè.\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eLưu trữ video tốt trên thẻ nhớ\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003e\u003c/p\u003e\n\u003cp\u003eDữ liệu hình ảnh của camera hành trình DDPAI MOLA N3/N3 GPS sẽ được lưu trữ trên thẻ nhớ (hỗ trợ dung lượng lên tới 128GB). Khi thẻ nhớ đầy, camera thông minh sẽ tự động ghi đè lên các video cũ, bạn sẽ không cần phải tháo thẻ nhớ để giải phóng dung lượng như những camera thông thường nữa.\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003ePhiên bản Camera hành trình DDPAI Mola N3 GPS\u003c/strong\u003e\u003c/h3\u003e\n\u003ch3\u003e\u003cstrong\u003eTích hợp GPS khả năng định vị chính xác\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003e\u003c/p\u003e\n\u003cp\u003eCamera hành trình DDPAI Mola N3 GPS được tích hợp GPS (Global Positioning System), cho phép bạn theo dõi hành trình của mình qua app trên điện thoại di dộng. Hiển thị tốc độ và tọa độ cho chiếc ô tô của bạn, giúp bạn kiểm soát hành trình của mình một cách an toàn và toàn diện.\u003c/p\u003e\n\u003cp\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eGiải Pháp Hỗ Trợ Lái Xe Tiên Tiến (ADAS) \u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003e\u003c/p\u003e\n\u003cp\u003eKhi cần lái xe đường dài, người lái sẽ dễ bị buồn ngủ, mất tập trung hoặc căng thẳng (stress), công nghệ ADAS (Advanced driver-assistance systems) của camera hành trình DDPAI Mola N3 GPS sẽ giúp bạn giám sát tìnhh trạng giao thông và cung cấp chỉ dẫn, cảnh báo khi lái xe như: làn đường, va chạm , xe phía trước, cảnh báo tốc độ, cảnh báo vào hay ra khu dân cư…\u003c/p\u003e\n\u003cp\u003e\u003c/p\u003e\n\u003cp\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eCamera hành trình DDPAI Z50 là mẫu camera mới nhất đến từ thương hiệu DDPAI với độ phân giải 4K sắc nét, hệ thống camera kết hợp trước và sau sẽ mang lại những trải nghiệm mới lạ cho người lái.\u003c/p\u003e\n\u003cp\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/19/dc/1e/04eb612ebb25daad14df7185abd03073.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/19/dc/1e/04eb612ebb25daad14df7185abd03073.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/19/dc/1e/04eb612ebb25daad14df7185abd03073.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/19/dc/1e/04eb612ebb25daad14df7185abd03073.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/19/dc/1e/04eb612ebb25daad14df7185abd03073.png"},{"base_url":"https://salt.tikicdn.com/ts/product/66/48/d4/9bfed46ab9f5077986639b8f8db6552e.PNG","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/66/48/d4/9bfed46ab9f5077986639b8f8db6552e.PNG","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/66/48/d4/9bfed46ab9f5077986639b8f8db6552e.PNG","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/66/48/d4/9bfed46ab9f5077986639b8f8db6552e.PNG","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/66/48/d4/9bfed46ab9f5077986639b8f8db6552e.PNG"},{"base_url":"https://salt.tikicdn.com/ts/product/42/06/a9/53aa3a0c02b8b760acb764ff3462430a.PNG","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/42/06/a9/53aa3a0c02b8b760acb764ff3462430a.PNG","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/42/06/a9/53aa3a0c02b8b760acb764ff3462430a.PNG","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/42/06/a9/53aa3a0c02b8b760acb764ff3462430a.PNG","thumbn