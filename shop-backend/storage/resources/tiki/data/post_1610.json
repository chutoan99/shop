ement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":121000,"discount_rate":27,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/39/7a/8a/b9085c00040e8359cf99197e9a74afb4.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1030,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: left;\"\u003e\u003cspan style=\"font-size: 18pt;\"\u003e\u003cstrong\u003eKem Dưỡng Ẩm Chuyên Sâu, Phục Hồi, Làm Dịu Da Klairs Rich Moist Soothing Cream 80ml\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-size: 14pt;\"\u003e\u003cstrong\u003eThương hiệu: Dears Klairs\u003c/strong\u003e\u003c/span\u003e\u003cbr /\u003e\u003cspan style=\"font-size: 14pt;\"\u003e\u003cstrong\u003eXuất xứ: Hàn Quốc\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eDears Klairs\u003c/strong\u003e là thương hiệu mỹ phẩm đến từ Hàn Quốc được thành lập vào năm 2010, trực thuộc By Wishtrend. Klairs tập trung vào các sản phẩm lành tính phù hợp với làn da nhạy cảm, đồng thời hãng cũng đề cao sự uy tín trách nhiệm với khách hàng với cam kết \"dùng tốt cho tất cả những khách hàng có làn da nhạy cảm\". Thành phần lành tính vượt trội, không thử nghiệm trên động vật và không chứa hương liệu.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/1a/1d/b1/d8c060c72353460b9e17181f5ffc6b0a.jpg\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eKem dưỡng Klairs Rich Moist Soothing Cream\u003c/strong\u003e được chiết xuất từ dẫn xuất nấm men có nguồn gốc từ Beta Glucan và bảng thành phần dài dằng dặc các loại chiết xuất thực vật, nào là dầu jojoba, chiết xuất bưởi, đu đủ, cần tây, bắp cải, súp lơ, củ cải, cà rốt, cám gạo, cà chua. Trong kem dưỡng của Klairs cũng có cả dầu oải hương nữa, vì thế mà tuy không có hương liệu nhưng kem vẫn có mùi thơm dễ chịu của thảo mộc.\u003c/p\u003e\n\u003cp\u003eSản phẩm có tác dụng cấp ẩm, làm dịu các nốt mụn và hỗ trợ làm mờ vết thâm. Da của bạn sẽ sáng lên sau một thời gian sử dụng và ngăn ngừa được những dấu hiệu lão hoá da, giảm bớt các nếp nhăn nhẹ.\u003c/p\u003e\n\u003cp\u003eChất kem bông nhẹ, không lỏng hẳn như sữa dưỡng thể, không bị chảy nước, không tạo cảm giác nhờn rít. Vì vậy mặc dù sản phẩm được ghi dành cho da khô nhưng các bạn sở hữu làn da hỗn hợp và da thường vẫn có thể sử dụng được trong mùa hè này nhé\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/32/07/2b/bb559e61440517db0dccb308d09385e3.jpg\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCông dụng chính:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eKem dưỡng cấp ẩm sâu, tập trung chăm sóc làn da khô ráp khó chịu bằng cách cấp và giữ nước tại tầng biểu bì, đem lại làn da mềm mại, mịn màng.\u003c/li\u003e\n\u003cli\u003eLàm dịu và phục hồi các vùng da kích ứng hoặc đang bị tổn thương, tái tạo lớp bảo vệ da.\u003c/li\u003e\n\u003cli\u003eNgăn chặn quá trình lão hóa, các biểu hiện nhăn nhẹ hoặc giảm liên kết đàn hồi sâu trong da.\u003c/li\u003e\n\u003cli\u003eChiết xuất nấm lên men giúp tăng khả năng miễn dịch và đề kháng của da. Giúp da khoẻ lên chống lại các vấn đề như mụn, khô sần, nhăn \u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eCách sử dụng\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003eDùng sau các bước: Sữa rửa mặt\u0026gt; serum\u0026gt;essence/serum…\u003cbr /\u003eThoa lớp kem dưỡng lên da, nhẹ nhàng vỗ cho kem thẩm thấu tốt hơn.\u003cbr /\u003eCó thể sử dụng cho cả ngày và đêm.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/07/7c/f3/6b4a6fe44a680ef31d25e06f1564428e.jpg\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/39/9a/62/9d2eacc6314f7465388070e3e90a23a7.jpg\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/39/7a/8a/b9085c00040e8359cf99197e9a74afb4.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/39/7a/8a/b9085c00040e8359cf99197e9a74afb4.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/39/7a/8a/b9085c00040e8359cf99197e9a74afb4.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/39/7a/8a/b9085c00040e8359cf99197e9a74afb4.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/39/7a/8a/b9085c00040e8359cf99197e9a74afb4.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/30/2b/09/301f4812b8812aa86743d7d7e25ae2f5.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/30/2b/09/301f4812b88