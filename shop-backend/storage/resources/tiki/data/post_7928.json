"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":9400,"discount_rate":10,"rating_average":5,"review_count":8,"review_text":"(8)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/32/b4/e8/209462c3f4ae037d6e86f8f3360d41e3.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1249,"all_time_quantity_sold":30,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cul\u003e\n\u003cli style=\"font-weight:400;text-align:justify;\"\u003e\u003cstrong\u003eHộp Bột Chùm Ngây Quảng Thanh \u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003ecó thời hạn sử dụng cao và không mất đi những công dụng quý giá của lá Chùm Ngây tươi.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;text-align:justify;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eG\u003c/span\u003e\u003cspan style=\"font-weight:400;\"\u003eiữ nguyên vẹn những giá trị quý của lá chùm ngây tươi. Bột không pha trộn thêm bất kỳ thành phần phụ gia hóa học nào.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/32/b4/e8/9621e9d71bd5fd70e212f3962425cf45.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cem\u003e\u003cspan style=\"font-weight:400;\"\u003eBột Chùm Ngây Quảng Thanh hỗ trợ bệnh đái tháo đường, cao huyết áp\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003eCÔNG DỤNG CỦA SẢN PHẨM\u003c/strong\u003e\u003c/p\u003e\n\u003cul style=\"text-align:justify;\"\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eHộp Bột Chùm Ngây Quảng Thanh \u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003ebổ sung vitamin và nguồn dinh dưỡng thiết yếu, dồi dào, chống suy nhược cơ thể, chống còi xương. Món ăn làm từ bột chùm ngây giúp cải thiện sự mất ngủ, giảm căng thẳng, lo âu, rất tốt cho trẻ nhỏ, người già và phụ nữ sau sinh. Tăng cường khả năng làm việc liên tục trong thời gian dài, tăng sức chịu đựng , giảm mệt mỏi về tinh thần và thể chất. Phù hợp cho các vận động viên thường xuyên vận động và người làm việc trí óc nhiều giờ hoặc lao lực.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eDùng làm thực phẩm giàu dinh dưỡng: trong chùm ngây có chứa nhiều hợp chất quý hiếm như: zeatin, quercetin, alpha-sitosterol, caffeoylquinic acid và kaempferol,…cùng hơn 90 chất dinh dưỡng tổng hợp, liều lượng lớn các chất chống viêm nhiễm, các chất kháng sinh, kháng độc tố,…úp ngăn ngừa ung thư, u xơ tiền liệt tuyến, giúp ổn định huyết áp, hạ cholesterol, bảo vệ gan.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003ePhòng ngừa nhiều bệnh nguy hiểm: bệnh ung thư, tiểu đường, thiếu máu, còi xương, tim mạch, kinh phong, sưng tấy, viêm nhiễm, mỡ máu, đau dạ dày, ngừa thai, ung loét, lão hóa, suy nhược cơ thể, suy nhược thần kinh và tăng cường khả năng ham muốn tình dục.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eHộp Bột Chùm Ngây Quảng Thanh \u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003echống lão hóa mạnh mẽ: hợp chất zeatin chống lão hóa cực tốt chứa đựng trong lá cây chùm ngây cao gấp nhiều lần so với bất cứ loại cây nào, do đó, bột chùm ngây được xem là “thần dược” giúp chị em phụ nữ gìn giữ nét xuân.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cem\u003e\u003cspan style=\"font-weight:400;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/5b/54/d8/c9227ab19db5de1790688923ac5891de.jpg\" alt=\"Hộp Bột Chùm Ngây mini Quảng Thanh chống lão hóa mạnh mẽ\" width=\"600\" height=\"467\" /\u003e\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cem\u003e\u003cspan style=\"font-weight:400;\"\u003eHộp Bột Chùm Ngây Quảng Thanh - gói nhỏ tiện lợi - dễ dàng sử dụng và bảo quản\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003eTHÔNG TIN CHUNG\u003c/strong\u003e\u003c/p\u003e\n\u003cul style=\"text-align:justify;\"\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eThành phần: 100% lá chùm ngây tươi, sấy lạnh tiệt trùng và nghiền siêu mịn.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eĐộ ẩm: dưới 5%\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eNgày sản xuất: xem trên bao bì\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eHạn sử dụng:  1 năm kể từ ngày sản xuất\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eSố XNCB: 005-2019/CBHQ-TNV\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003eCÁCH DÙNG BỘT CHÙM NGÂY QUẢNG THANH \u003c/strong\u003e\u003c/p\u003e\n\u003cul style=\"text-align:justify;\"\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eDùng làm thức uống:\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e Pha 1 gói với 200ml nước. Khuấy đều và thêm đá nếu uống lạnh. Bạn cũng có thể thêm đường, mật ong, chanh hoặc nước dừa để tăng thêm vị ngon.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eDùng làm đồ ăn: \u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003eBột chùm ngây có vị ngọt ngọt gần như bột ngọt (mì chính), vì thế, chúng có thể làm nguyên liệu để thêm vào cháo, canh hay rắc lên các món ăn như một gia vị. Liều lượng bột chùm ngây thích hợp nhất cho cơ thể người lớn là 10gr/ngày và trẻ em dưới 6 tuổi là 5gr/ngày.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/05/e8/1a/ff63510af8283767e783142a803ddb8e.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cem\u003e\u003cspan style=\"font-weight:400;\"\u003eHộp Bột Chùm Ngây Quảng Thanh món quà của sức khỏe\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003eHƯỚNG DẪN BẢO QUẢN\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/78/6f/b9/85744c1e21ae3c737c96d1a177cc6ba3.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/32/b4/e8/209462c3f4ae037d6e86f8f3360d41e3.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/32/b4/e8/209462c3f4ae037d6e86f8f3360d41e3.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/32/b4/e8/209462c3f4ae037d6e86f8f3360d41e3.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200