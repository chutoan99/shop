0,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/54/77/36/018f8d5b6aa9730519279d9f0faf1a99.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":880,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\n  \u003cp\u003eThiết kế nguyên khối, công suất 2.5 HP phù hợp với không gian 30 - 40 m2\u003c/p\u003e\n   \u003cp\u003eVới thiết kế nguyên khối, đường nét sắc sảo mạnh mẽ cùng sắc trắng hiện đại, máy lạnh Toshiba Inverter 2.0 HP RAS-H24E2KCVG-V sẽ tạo nên điểm nhấn nổi bật cho không gian nội thất nhà bạn.\u003c/p\u003e\n   \u003cp\u003eMáy lạnh Toshiba Inverter có công suất hoạt động 2.5 Hp sẽ là lựa chọn phù hợp cho phòng có diện tích từ 30 - 40 m2. Bề mặt máy lạnh phẳng tuyệt đối sang trọng, không vết nối giúp hạn chế bám bẩn và dễ dàng vệ sinh, tháo lắp.\u003c/p\u003e\n   \u003cp\u003eTiết kiệm điện năng tối ưu, hoạt động êm ái với công nghệ Hybrid Inverter\u003c/p\u003e\n   \u003cp\u003eCông nghệ Hybrid Inverter với sự kết hợp giữa PAM (Công suất làm lạnh cao) + PWM (Hiệu suất làm lạnh cao), có tác dụng tiết kiệm lên đến 60% điện năng tiêu thụ mà vẫn đảm bảo được hiệu quả làm việc cao nhất. Công nghệ này còn đảm bảo nhiệt độ phòng luôn ổn định, vận hành êm ái, thời gian làm lạnh nhanh.\u003c/p\u003e\n   \u003cp\u003eTiết kiệm đến 25% điện năng bằng chế độ Eco\u003c/p\u003e\n   \u003cp\u003eKhông khí trong lành hơn nhờ công nghệ tinh lọc không khí IAQ, lưới lọc chống nấm mốc\u003c/p\u003e\n   \u003cp\u003eKhông khí trong lành và giảm chi phí làm vệ sinh với công nghệ độc quyền Magic Coil\u003c/p\u003e\n   \u003cp\u003eNhờ lớp phủ đặc biệt Magic Coil ngăn ngừa bụi bẩn, vi khuẩn, nấm mốc bám vào dàn lạnh, máy lạnh có thể tiết kiệm điện năng tối ưu, nâng cao khả năng làm lạnh nhanh, tối ưu hóa tính năng lọc khí và giảm chi phí bảo trì cũng như số lần vệ sinh máy.\u003c/p\u003e\n   \u003cp\u003eThiết kế cánh đảo gió Hada Care giúp làm mát không gian rộng lớn, đều hơn\u003c/p\u003e\n   \u003cp\u003eNgăn môi trường lý tưởng cho vi khuẩn, nấm mốc phát triển với chức năng tự làm sạch\u003c/p\u003e\n   \u003cp\u003eMáy lạnh Toshiba trang bị thêm tính năng tự động làm sạch bằng cách hong khô dàn lạnh sau khi tắt máy, giảm độ ẩm xuống một cách tối đa giúp hạn chế sự hình thành vi khuẩn, nấm mốc.\u003c/p\u003e\n   \u003cp\u003eChế độ làm lạnh nhanh Hi Power\u003c/p\u003e\n   \u003cp\u003eMang đến giấc ngủ ngon cho gia đình nhờ chế độ hoạt động ban đêm\u003c/p\u003e\n  \u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/54/77/36/018f8d5b6aa9730519279d9f0faf1a99.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/54/77/36/018f8d5b6aa9730519279d9f0faf1a99.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/54/77/36/018f8d5b6aa9730519279d9f0faf1a99.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/54/77/36/018f8d5b6aa9730519279d9f0faf1a99.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/54/77/36/018f8d5b6aa9730519279d9f0faf1a99.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/e2/f4/38/71dca311367e2264071632