dth":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":84000,"discount_rate":10,"rating_average":4.6,"review_count":21,"review_text":"(21)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/media/catalog/product/p/h/philips-hr1393-_1_.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2754,"all_time_quantity_sold":151,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch5\u003eThiết kế đẹp mắt, chân đế chống trượt\u003c/h5\u003e\n\u003cp\u003e\u003cstrong\u003eMáy Xay Thịt Philips HR1393\u003c/strong\u003e sở hữu thiết kế nhỏ gọn, tinh tế, hiện đại, đây sẽ là một phụ kiện tuyệt vời giúp cho những người nội trợ chuẩn bị những bữa ăn gia đình một cách nhanh chóng nhất. Phần chân đế của máy chống trượt hiệu quả cho phép máy đứng vững trên nhiều bề mặt khác nhau đảm bảo an toàn cho thiết bị và người dùng khi sử dụng, đồng thời cũng giúp máy vận hành êm ái, nhẹ nhàng hơn. Vỏ máy làm từ nhựa ABS chắc chắn, chống bám bụi bẩn tốt, dễ dàng lau chùi và vê sinh. \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/6e/7a/98/0e94e6c4745294cc88797b412945e4c3.jpg\" alt=\"Máy Xay Thịt Philips HR1393 – 0.7 Lít - Trắng\" width=\"750\" height=\"720\" /\u003e\u003c/p\u003e\n\u003ch5\u003eCông suất hoạt động 450W, dung tích 700ml\u003c/h5\u003e\n\u003cp\u003eMáy hoạt động với công suất 450W, rất nhanh chóng, các thực phẩm như hành tươi, rau thơm, lạc, sẽ được xay nhuyễn. Dung tích 700ml cho phép bạn xay được nhiều thực phẩm một lúc giúp tiết kiệm thời gian và công sức cho người dùng.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/e8/65/a1/8649eb0a28d0ff2aff4232628f839c33.jpg\" alt=\"Máy Xay Thịt Philips HR1393 – 0.7 Lít - Trắng\" width=\"750\" height=\"811\" /\u003e\u003c/p\u003e\n\u003ch5\u003eCối xay bằng nhựa, lưỡi dao bằng thép không gỉ sắc bén\u003c/h5\u003e\n\u003cp\u003eCối xay của máy làm từ nhựa cao cấp kháng vỡ tốt tạo sự chắc chắn cho tuổi thọ sử dụng cao. Lưỡi dao bằng thép không gỉ không gây các chất độc hại trong quá trình sử dụng, đảm bảo vệ sinh an toàn thực phẩm. Đồng thời, lưỡi dao bằng thép có độ sắc bén cao giúp xay nhuyễn thực phẩm nhanh chóng.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/86/20/43/d6f5bd9f7105a61ff42cfe9b8d31b605.jpg\" alt=\"Máy Xay Thịt Philips HR1393 – 0.7 Lít - Trắng\" width=\"750\" height=\"421\" /\u003e\u003c/p\u003e\n\u003ch5\u003eVận hành đơn giản, dễ dàng xay nhuyễn thực phẩm\u003c/h5\u003e\n\u003cp\u003eMáy vận hành đơn giản, chỉ với một động tác ấn xuống thực phẩm trong cối sẽ được xay nhuyễn trong thời gian ngắn, giúp tiết kiệm tối đa thời gian chuẩn bị nguyên liệu.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/e3/ae/9f/d23e5b9cd308c660d13c161c1dfc7131.jpg\" alt=\"Máy Xay Thịt Philips HR1393 – 0.7 Lít - Trắng\" width=\"750\" height=\"749\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/media/catalog/product/p/h/philips-hr1393-_1_.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/p/h/philips-hr1393-_1_.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/p/h/philips-hr1393-_1_.jpg","position":null,"small