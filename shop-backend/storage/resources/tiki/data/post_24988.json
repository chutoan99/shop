cking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":2750,"discount_rate":5,"rating_average":4.8,"review_count":9,"review_text":"(9)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/media/catalog/product/d/s/dsc_8327.u634.d20160402.t154251.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":0,"all_time_quantity_sold":59,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: medium; color: #008ab7;\"\u003e\u003cstrong\u003eBút Chì 24 Màu G-Star\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eBút Chì 24 Màu G-Star \u003c/strong\u003ebao gồm 24 sắc màu sinh động, bé có thể tha hồ sáng tạo nên những tác phẩm nghệ thuật cho riêng mình. Lõi chì mềm, chỉ cần tô nhẹ, chất màu sẽ lên rất đều, đậm, mịn màng và sắc nét. Bộ chì màu được làm từ chất liệu cao cấp, không chứa chất độc hại, rất an toàn và thân thiện với con người.\u003c/p\u003e\r\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Bút Chì 24 Màu G-Star\" src=\"http://tikicdn.com/media/catalog/product/d/s/dsc_8327.u634.d20160402.t154251.jpg\" alt=\"Bút Chì 24 Màu G-Star\" width=\"600\" height=\"600\" /\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eThông tin sản phẩm\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eChất màu chuẩn, bền màu\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eBút Chì 24 Màu G-Star cho tone màu rất chuẩn, màu sắc tươi sáng, giúp gia tăng độ phủ đến 100%. Khi tô, chất màu ra đều, đậm, mịn màng và sắc nét.\u003cstrong\u003e \u003c/strong\u003eMàu bám giấy tốt, không tạo bột màu, ít hao phí, rất tiết kiệm. Chì bền màu, lâu phai, cho sắc màu tươi đẹp cùng thời gian.\u003cstrong\u003e\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003e24 màu sắc sáng tạo\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eSản phẩm bao gồm 24 sắc màu sinh động, bé có thể tha hồ sáng tạo nên những tác phẩm nghệ thuật cho riêng mình. Ngoài ra, bạn còn có thể tô chồng, kết hợp các màu lại với nhau để sáng tạo nên màu mới mà không sợ bệt màu. \u003cstrong\u003e\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eChất liệu an toàn\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eBút Chì 24 Màu G-Star\u003cstrong\u003e \u003c/strong\u003eđược làm từ chất liệu cao cấp, rất an toàn và thân thiện với con người. Đặc biệt, sản phẩm tuân thủ đúng tiêu chuẩn an toàn Châu Âu, không chứa chất độc gây hại cho sức khỏe, được đánh giá là phù hợp khi sử dụng cho trẻ em.\u003cstrong\u003e\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eThiết kế vừa tay cầm\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eThiết kế thân bút hình lục giác, giúp người sử dụng cầm bút rất chắc tay mà vẫn tạo cảm giác vô cùng thoải mái. Lõi chì được đặt ngay ngắn, thân bút cứng, dễ chuốt, không bị gãy khi chuốt.\u003cstrong\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.co