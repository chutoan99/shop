n_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/24/5b/8b/c3ceb0f79f4699090db449eaa0601f56.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":114,"all_time_quantity_sold":4,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eLắp ráp và vận chuyển\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e* Có hai lựa chọn giao lắp:\u003c/p\u003e\n\u003cp\u003e- \"Tự lắp ráp\": bộ sản phẩm được đóng gói dạng rời gồm các tấm gỗ được dán nhãn và đánh số kèm theo sơ đồ lắp ráp, đầy đủ phụ kiện, video. Quý khách hàng sẽ tiến hành lắp ráp theo hướng dẫn.\u003c/p\u003e\n\u003cp\u003e- \"Hoàn thiện\": KEGODA lắp ráp hoàn thiện sản phẩm quý khách có thể sử dụng ngay khi nhận hàng.\u003c/p\u003e\n\u003cp\u003e** Nếu có lỗi/hư hỏng (kể cả do lỗi vận chuyển), KEGODA cam kết gửi thay thế phần bị hỏng ngay khi nhận được yêu cầu.\u003c/p\u003e\n\u003cp\u003e— — — — — — — — —\u003c/p\u003e\n\u003cp\u003eBộ bàn trang điểm thiết kế đơn giản gồm bàn có gương gập và ghế gỗ thiết kế đa năng như 1 chiếc hộp đựng đồ.\u003c/p\u003e\n\u003cp\u003eNhỏ xinh, cân đối và tối giản, bộ bàn phấn này là một lựa chọn tuyệt vời.\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/f6/b5/18/9ebd5a2d121bdb9fd6b359169507ade1.jpg\" alt=\"\" width=\"750\" height=\"1096\" /\u003e\u003cem\u003eHình thực tế bộ bàn trang điểm+ ghế ngồi\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e— — — — — — — — —\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThông số:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Chất liệu: MDF bề mặt phủ Melamine kháng nước, bền màu, an toàn và sử dụng lâu dài.\u003c/p\u003e\n\u003cp\u003e- Màu sắc: Vân gỗ sồi.\u003c/p\u003e\n\u003cp\u003e- Quy cách: chỉ bàn hoặc combo bàn ghế\u003c/p\u003e\n\u003cp\u003e- Kích thước tổng thể: Lõi gỗ dày 17mm.\u003c/p\u003e\n\u003cp\u003e + Bàn trang điểm: 62,6 x 80 x 29,5cm (Dài x Cao x Rộng).\u003c/p\u003e\n\u003cp\u003e + Ghế trang điểm: 32 x 37 x 23,5cm (Dài x Cao x Rộng).\u003c/p\u003e\n\u003cp\u003e- Thương hiệu: KEGODA.\u003c/p\u003e\n\u003cp\u003e- Công năng: Bàn ngồi trang điểm và lưu trữ các vật dụng cần thiết: tranh ảnh, sách vở, mỹ phẩm.\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/f8/c8/34/160eab9d0cd89f0122505c7df634c9cd.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/60/ff/71/0c4b9be70cf2c123b7b103239b15100f.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cstrong\u003e— — — — — — — — —\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cstrong\u003eĐiểm nổi bật:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Thiết kế: Bàn trang điểm có thiết kế nhỏ gọn với \u003cstrong\u003egương gập/mở\u003c/strong\u003e tiện lợi. Hệ \u003cstrong\u003egương và tủ tích hợp\u003c/strong\u003e thông minh, \u003cstrong\u003eghế ngồi kết hợp ngăn tủ nhỏ\u003c/strong\u003e tăng giúp bạn tăng khả năng lưu trữ nhiều vật dụng cần thiết khác.\u003c/p\u003e\n\u003cp\u003e- Đa công năng: Bàn có thể để mỹ phẩm, trang sức, đồ trang điểm và vật dụng trang trí phù hợp cho chị em phụ nữ tiện lợi sử dụng. \u003c/p\u003e\n\u003cp\u003e- Phù hợp đặt tại nhiều nơi: phòng khách, phòng ngủ và nhiều khu vực khác. Với thiết kế độc đáo, bàn còn là một món đồ trang trí tuyệt vời và cần thiết cho các chị em phụ nữ.\u003c/p\u003e\n\u003cp\u003e- Bàn rộng \u003cstrong\u003e29,5cm \u003c/strong\u003echo bạn không gian sử dụng rộng rãi mà không bị gò bó. Phía dưới bàn có thanh giằng tạo nên sự cứng cáp và chắc chắn.\u003c/p\u003e\n\u003cp\u003e- Các cạnh trước \u0026amp; sau, trên \u0026amp; dưới đều được xử lý đẹp, đảm bảo an toàn và lâu bền trong quá trình sử dụng.\u003c/p\u003e\n\u003cp\u003e- Chân bàn có đính kèm chân nhựa tiện lợi giúp bàn hạn chế ma sát với mặt đất, tránh trầy xước cho nền gạch.\u003c/p\u003e\n\u003cp\u003e- Dễ dàng lắp đặt: Bàn gỗ sẽ đi kèm đầy đủ phụ kiện và hướng dẫn lắp đặt, kệ được khoan sẵn các mối liên kết (các thanh kệ được đánh dấu sẵn để bạn lắp theo thứ tự).\u003c/p\u003e\n\u003cp\u003e- Sử dụng lâu dài: Chất liệu MDF bề mặt phủ melamine loại tốt (căng, phẳng, dày và đồng màu).\u003c/p\u003e\n\u003cp\u003e- Sản phẩm sẽ được đóng gói cẩn thận \u0026amp; dày dặn đảm bảo an toàn trong quá trình vận chuyển.\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/24/5b/8b/eb551ffdd104a867929b63b5c5a1fec6.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/4e/3e/c0/6a62f2f9c0e26f95f31dd35ee5d9ee34.jpg\" alt=\"\" width=\"750\" height=\"1024\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e- Màu sắc hiện đại nên dễ dàng phối với nhiều phong cách khác nhau.\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/64/1f/41/d27ff566a6de92767b76ffee3866e6c0.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/4d/25/31/7694ea1d31e50e331658011f59d946f9.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e\u003cstrong\u003e— — — — — — — — —\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e\u003cstrong\u003e Hướng dẫn:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e- \u003c/strong\u003eGiấy hướng dẫn lắp ráp chi tiết và phụ kiện đi kèm trong sản phẩm.\u003c/p\u003e\n\u003cp\u003e- Video hướng dẫn lắp ráp xem tại đây:\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003ciframe src=\"//www.youtube.com/embed/h5kLez41f7o\" width=\"560\" height=\"314\" allowfullscreen=\"\"\u003e\u003c/iframe\u003e\u003c/p\u003e\n\u003cp\u003e- Hạn chế để kệ tiếp xúc trực tiếp với ánh nắng trực tiếp, nơi ẩm ướt. Nên lau khô ngay khi sản phẩm tiếp xúc với nước.\u003c/p\u003e\n\u003cp\u003e- Sử dụng các chất tẩy rửa chuyên dụng để không làm mất độ thẩm mỹ của bề mặt.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eDịch vụ sau bán hàng:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Bảo hành 1 đổi 1 miễn phí theo chính sách của tiki nếu sản phẩm có lỗi kĩ thuật hoặc do lỗi vận chuyển\u003c/p\u003e\n\u003cp\u003e- Bảo hành chất lượng sản phẩm 24 tháng. Bảo trì và hỗ trợ khách hàng trọn đời.\u003c/p\u003e\n\u003cp\u003e— — — — — — — — —\u003c/p\u003e\n\u003cdiv\u003e\n\u003cp\u003e- Sản phẩm được sản xuất tại: Công ty TNHH Trang Trí Nội Thất Đơn Giản Là Đẹp\u003c/p\u003e\n\u003cp\u003e- Xuất xứ: Việt Nam\u003c/p\u003e\n\u003carticle class=\"4ever-article\"\u003e\n\u003cp\u003e\u003cstrong\u003e Welcome to KEGODA\u003c/strong\u003e\u003c/p\u003e\n\u003c/article\u003e\n\u003cp\u003eKEGODA là thương hiệu thuộc Công ty TNHH Trang Trí Nội Thất Đơn Giản Là Đẹp, cam kết mang đến cho bạn những sản phẩm đồ gỗ nội thất chất lượng cao với chi phí tiết kiệm. Chúng tôi luôn sẵn sàng lắng nghe và làm việc chăm chỉ để có thể phục vụ bạn tốt hơn mỗi ngày. Bạn luôn được chào đón.\u003c/p\u003e\n\u003carticle class=\"4ever-article\"\u