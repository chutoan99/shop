or":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":600000,"discount_rate":38,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/69/3e/aa/1b6df8d00e78b5706df37118a32a9750.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":385,"all_time_quantity_sold":3,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eThiết kế 3 tầng với dung tích lớn lên tới 18L, nồi hấp Unie UE560 cho phép người dùng chuẩn bị nhiều món hấp cùng lúc nhanh chóng. 12 tính năng được thiết lập sẵn nhiệt độ và thời gian nấu, cho món ăn trọn dinh dưỡng ,tiết kiệm thời gian và công sức cho người dùng. Đặc biệt phù hợp với dân eat clean, eat healthy, người tập gym, các mẹ bỉm sữa.\u003c/p\u003e\n\u003cp\u003e03 tầng riêng biệt, nấu nhiều loại thực phẩm cùng một lúc \u003c/p\u003e\n\u003cp\u003eNồi UE560 trang bị 3 tầng hấp cho phép người dùng thoải mái chuẩn bị đồ ăn cho cả gia đình từ 4-6 người, trong một lần nấu duy nhất, tiết kiệm tối đa thời gian và điện năng. Xửng hấp được thiết kế thông minh dạng hình chữ nhật hấp được nhiều đồ hơn, và đa dạng món ăn.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lkor00ohp7myff\" width=\"2000\" height=\"2000\" alt=\"vn-11134208-7r98o-lkor00ohp7myff\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eDung tích lớn lên tới 18L \u003c/p\u003e\n\u003cp\u003eDung tích lên đến 18L, người dùng có thể thoải mái hấp cá nguyên con với nồi UE560. Mỗi tầng hấp dung tích 6L, thiết kế rời nhau, dễ dàng hấp đơn lẻ 1-2 tầng cho bữa ăn phụ như bánh bao, khoai, bánh trứng, ngô hoặc xếp chồng gọn gàng hấp được nhiều hơn cho các bữa chính là thịt, cá, tôm, xương sườn, trứng gà và rau xanh.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lkor00ohqm7e3d\" width=\"2000\" height=\"2000\" alt=\"vn-11134208-7r98o-lkor00ohqm7e3d\" /\u003e\u003c/p\u003e\n\u003cp\u003e12 tính năng tiện lợi \u003c/p\u003e\n\u003cp\u003eVới 12 chế độ được thiết lập sẵn cùng công suất 850W, nhanh chóng, giữ được vị ngọt tự nhiên đậm đà và giảm thất thoát chất dinh dưỡng. Chỉ bằng vài thao tác đơn giản, các món ăn bổ dưỡng và tốt cho sức khỏe đã được hấp chín. \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lkor00ohs0ru56\" width=\"2000\" height=\"2000\" alt=\"vn-11134208-7r98o-lkor00ohs0ru56\" /\u003e\u003c/p\u003e\n\u003cp\u003eThiết kế trang nhã, dễ vệ sinh\u003c/p\u003e\n\u003cp\u003eThiết kế sang trọng cùng màu be thời thượng, UE560 tạo điểm nhấn riêng cho căn bếp, thêm cảm hứng nấu ăn cho các thành viên trong gia đình. Nắp đậy bằng nhựa trong suốt, an toàn cho sức khỏe giúp người dùng dễ dàng quan sát toàn bộ quá trình hấp. Hơn thế, 3 tầng riêng biệt, dễ tháo rời và vệ sinh tiện lợi.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lkor00ohtfca1b\" width=\"2000\" height=\"2000\" alt=\"vn-11134208-7r98o-lkor00ohtfca1b\" /\u003e\u003c/p\u003e\n\u003cp\u003eThông số kỹ thuật\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lkor00ohutwq48\" width=\"2000\" height=\"2000\" alt=\"vn-11134208-7r98o-lkor00ohutwq48\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e#unie #noihapunie #unieue560 #ue560 #noi #noihap #xunghap #noihap2tang #noihap3tang #noihapdien #noihapmini #xunghapinox #noihap3tang #hap # xunghaptre #xungtrehap #noihapxoi #noihapinox #noihap3tang #hap #xunghaptre #xungtrehap #noihapxoi #noihapinox #noihapbanhbao #noihapdiendanang3tang\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/69/3e/aa/1b6df8d00e78b5706df37118a32a9750.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/69/3e/aa/1b6df8d00e78b5706df37118a32a9750.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/69/3e/aa/1b6df8d00e78b5706df37118a32a9750.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/69/3e/aa/1b6df8d00e78b5706df37118a32a9750.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/69/3e/aa/1b6df8d00e78b5706df37118a32a9750.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/21/87/11/5f788da4438e0d96c435761eb8b31ccb.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/21/87/11/5f788da4438e0d96c435761eb8b31ccb.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/21/87/11/5f788da4438e0d96c435761eb8b31ccb.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/21/87/11/5f788da4438e0d96c435761eb8b31ccb.jpg","thumbnail_url":"https://salt.tikicdn.co