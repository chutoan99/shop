","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":360000,"discount_rate":39,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/00/6c/5a/5e374330396212c12dbf9c8683a9e0f2.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":674,"all_time_quantity_sold":13,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003e\u003ciframe src=\"//www.youtube.com/embed/1ZlysJ4OZwA\" width=\"750\" height=\"750\" allowfullscreen=\"\"\u003e\u003c/iframe\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eGối massage cổ cao cấp Xiaomi LR-S100 là chiếc gối có tính năng massage bằng điện sử dụng pin tiểu, chiếc gối nhỏ gọn phù hợp với những chuyến máy bay dài, du lịch xa bằng ô tô hay đơn giản chỉ là giấc ngủ trưa nhẹ nhàng của dân văn phò\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ed/8f/7c/81f55b16a5c9680ddb09e0ed8326ab97.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eGiới thiệu qua gối massage Xiaomi\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eLà chiếc \u003cstrong\u003egối massage của hãng Xiaomi\u003c/strong\u003e\u003cbr /\u003eMassage thư giãn với nhiều chế độ\u003cbr /\u003eSử dụng pin tiểu dễ thay thế\u003cbr /\u003eThiết kế ôm cổ giúp thoải mái khi sử dụng\u003cbr /\u003ePhù hợp với những bạn dân văn phòng, người hay đi xa bằng máy bay hay ô tô, những chuyến đi du lịch\u003cbr /\u003eChỉ 20p mỗi ngày sẽ giúp bạn phục hồi sức khỏe\u003cbr /\u003eNhỏ gọn, cất nhét dễ dàng\u003cbr /\u003eĐộng cơ êm ái\u003cbr /\u003eLà sản phẩm có tính sáng tạo, thực tế mà rẻ tiền, cửa hàng khuyến khách hàng mua dùng\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/3f/d7/df/a21ae925539a045d21164723dbe24e10.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eChiếc gối đệm cổ hỗ trợ tính năng massage dành cho dân văn phòng.\u003cbr /\u003e- Gối có tác dụng nâng đỡ cổ và gáy, ngăn ngừa nhức mỏi và hỗ trợ điều trị chữa thoái hóa đốt sống cổ.\u003cbr /\u003e- Gối kê cổ tiện dụng êm ái, đỡ đau nhức khi nghỉ trưa tại văn phòng hay khi phải ngồi làm việc cả ngày dài, phòng tránh được các bệnh về xương khớp cực hiệu quả.\u003cbr /\u003e- Kiểu dáng gọn nhẹ, dễ dàng xếp gọn vào túi đựng để mang theo khi đi du lịch, dã ngoại hay đi công tác xa nhà, bảo vệ chiếc gối luôn sạch sẽ và không ảnh hưởng tới .\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/cb/35/0f/cb2f4e6ce11359ad689e9a03b6aa7333.jpg\" alt=\"\" width=\"750\" height=\"748\" /\u003e\u003c/p\u003e\n\u003cp\u003eTrong cuộc sống bộn bề những lo toan như hiện nay, chúng ta thường quên mất tầm quan trọng của việc massage cổ sau một ngày làm việc cực nhọc. Đặc biệt đối với những ai làm công việc văn phòng thì thao tác này lại càng quan trọng hơn. Vì việc liên tục nhìn vào màn hình máy tính sẽ khiến các đốt sống cổ chịu áp lực lớn và dễ bị thoái hóa hơn. Thế nhưng tình trạng này sẽ không thể kéo dài lâu thêm vì giờ đây bạn đã có Gối massage cổ cao cấp Xiaomi cực kỳ tiện lợi dưới đây.\u003c/p\u003e\n\u003cp\u003eThông số sản phẩm :\u003cbr /\u003eThương hiệu: Xiaomi\u003cbr /\u003e\u003cstrong\u003eModel: LR-S100\u003c/strong\u003e\u003cbr /\u003eKích thước: 265 x 240 x 100mm\u003cbr /\u003eKhối lượng: 390g\u003cbr /\u003eCông suất định mức: 2 W\u003cbr /\u003eNhiệt độ hoạt động: -10oC – 45oC\u003cbr /\u003eChu kỳ xoa bóp: 10 ± 1 phút\u003cbr /\u003eDòng điện định mức: chế độ massage \u0026lt; 450mA; Chế độ ngủ \u0026lt; 300mA\u003cbr /\u003eTiêu chuẩn quản lý: 6B47061-2005 6B4706.10-2008\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/55/38/bc/69da82fc03f5b81184fae5c4a9397f0a.png\" alt=\"\" width=\"750\" height=\"498\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/b3/0c/03/f09a44f94b42cc4b371135871e95dbaf.jpg\" alt=\"\" width=\"750\" height=\"726\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eGối massage cổ cao cấp Xiaomi\u003c/strong\u003e là một thiết bị massage giúp người dùng giải tỏa khỏi những cơn đau nhức thường trực quanh khu vực cổ. Gối có ngoại hình không khác nhiều so với những chiếc gối quàng cổ thông thường nhưng về mặt tính năng thì lại vượt trội hoàn toàn.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/b9/ba/b0/afdae1a26108a9dab8cf390447b2da0c.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/00/6c/5a/5e374330396212c12dbf9c8683a9e0f2.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/00/6c/5a/5e374330396212c12dbf9c8683a9e0f2.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/00/6c/5a/5e374330396212c12dbf9c8683a9e0f2.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/00/6c/5a/5e374330396212c12dbf9c8683a9