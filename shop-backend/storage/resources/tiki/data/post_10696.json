_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/3e/f7/11/ba42500d5db21b5202d43b702ed79a7c.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":165,"all_time_quantity_sold":5,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<div class=\"QN2lPu\">\n<div>\n<div class=\"P7IbkE\"><img class=\"GqYslU hnult1 shipxanh-image\" src=\"https://down-vn.img.susercontent.com/file/vn-11134208-7r98o-lntkgoj8wqnh72\" alt=\"vn-11134208-7r98o-lntkgoj8wqnh72\" /></div>\n</div>\n</div>\n<div class=\"QN2lPu\">\n<div>\n<div class=\"P7IbkE\"><img class=\"GqYslU hnult1 shipxanh-image\" src=\"https://down-vn.img.susercontent.com/file/vn-11134208-7r98o-lntkgoj8y57xf6\" alt=\"vn-11134208-7r98o-lntkgoj8y57xf6\" /></div>\n</div>\n</div>\n<div class=\"QN2lPu\">\n<div>\n<div class=\"P7IbkE\"><img class=\"GqYslU hnult1 shipxanh-image\" src=\"https://down-vn.img.susercontent.com/file/vn-11134208-7r98o-lntkgoj8zjsda9\" alt=\"vn-11134208-7r98o-lntkgoj8zjsda9\" /></div>\n</div>\n</div>\n<div class=\"QN2lPu\">\n<div>\n<div class=\"P7IbkE\"><img class=\"GqYslU hnult1 shipxanh-image\" src=\"https://down-vn.img.susercontent.com/file/vn-11134208-7r98o-lntkgoj90yctc5\" alt=\"vn-11134208-7r98o-lntkgoj90yctc5\" /></div>\n</div>\n</div>\n<p class=\"QN2lPu\"> </p>\n<p class=\"QN2lPu\">TAI NGHE TRUE WIRELESS SOUNDPEATS CLEAR</p>\n<p class=\"QN2lPu\"> Sản phẩm chính hãng từ SoundPEATS Việt Nam</p>\n<p class=\"QN2lPu\"> Phân phối trực tiếp độc quyền tại Việt Nam qua Công ty Phương Linh</p>\n<p class=\"QN2lPu\"> Bảo hành đổi mới toàn diện trong 12 tháng (Đối với lỗi từ nhà sản xuất)</p>\n<p class=\"QN2lPu\"> </p>\n<p class=\"QN2lPu\">Dòng sản phẩm SoundPEATS Transparent Series</p>\n<p class=\"QN2lPu\">SoundPEATS Clear hình dáng in-ear, đàm thoại rõ ràng với mic kép + ENC, hỗ trợ chế độ chơi game, điều khiển EQ qua ứng dụng SoundPEATS.</p>\n<p class=\"QN2lPu\"> </p>\n<p class=\"QN2lPu\"> Trong Suốt Ấn Tượng</p>\n<p class=\"QN2lPu\">SoundPEATS Clear gây ấn tượng mạnh mẽ với vẻ ngoài trong suốt đầy thời trang, một trong những xu hướng thiết kế tai nghe thịnh hành trong những tháng gần đây. Phần tai nghe là sự kết hợp hài hòa giữa thiết kế trong suốt, logo chữ S cách điệu, dòng chữ “Hear Your Imagination” cùng điểm nhấn màu xanh ở phần gắn tips tai nghe.</p>\n<p class=\"QN2lPu\"> </p>\n<p class=\"QN2lPu\"> Thiết Kế Tinh Tế</p>\n<p class=\"QN2lPu\">Tai nghe không dây SoundPEATS Clear được thiết kế theo dạng In-ear và có 3 nút tai thay thế với kích thước S/M/L. Với thiết kế nhỏ gọn, được tinh chỉnh để vừa vặn với mọi khuôn tai.</p>\n<p class=\"QN2lPu\"> </p>\n<p class=\"QN2lPu\"> Bluetooth Hiện Đại</p>\n<p class=\"QN2lPu\">SoundPEATS Clear mang đến tốc độ kết nối vô cùng nhanh chóng, ổn định và liền mạch trong bán kính 10m. Đồng thời, chuẩn Bluetooth mới cũng hạn chế phần nào độ trễ của tai nghe và tăng thời lượng sử dụng tai nghe, thỏa thích nghe nhạc, chơi game trong nhiều giờ liền.</p>\n<p class=\"QN2lPu\"> </p>\n<p class=\"QN2lPu\"> Driver Dynamic Màng Sinh Học Bio</p>\n<p class=\"QN2lPu\">Được trang bị Driver Dynamic màng sinh học Bio 12mm, SoundPEATS Clear mang đến cho bạn trải nghiệm âm thanh chất lượng cao và sống động. Màng loa dày dặn giúp tái tạo các dải âm trầm chắc, khỏe vô cùng ninh tai, kết hợp cùng những dải cao đầy tinh tế và dải âm trung vừa vặn.</p>\n<p class=\"QN2lPu\"> </p>\n<p class=\"QN2lPu\"> Pin Dùng Lâu Dài</p>\n<p class=\"QN2lPu\">Pin sử dụng 40 giờ liên tục khi có hộp sạc và 7 giờ khi dùng tai nghe. SoundPEATS Clear có thể đáp ứng được nhiều ngày sử dụng liên tục mà không cần phải sạc lại hộp.</p>\n<p class=\"QN2lPu\"> </p>\n<p class=\"QN2lPu\"> Đàm thoại Rõ Ràng Cùng Mic Kép ENC</p>\n<p class=\"QN2lPu\">SoundPEATS Clear được trang bị 2 mic kép với công nghệ ENC chống ồn môi trường. Công nghệ này hỗ trợ cho quá trình đàm thoại được rõ ràng và chi tiết hơn. Tiếng ồn và tạp âm khi trò chuyện ở nơi đông người sẽ được lọc ở mức tối đa.</p>\n<p class=\"QN2lPu\"> </p>\n<p class=\"QN2lPu\"> Lần Đầu Tiên Sử Dụng</p>\n<p class=\"QN2lPu\">1. Tháo miếng cách nhiệt nilon khỏi chấu sạc hai tai nghe.</p>\n<p class=\"QN2lPu\">2. Sạc đầy pin của tai nghe và hộp sạc trước khi sử dụng. Thời gian sạc đầy là 2 tiếng.</p>\n<p class=\"QN2lPu\">3. Lấy hai tai nghe ra khỏi hộp sạc. Chờ trong giây lát.</p>\n<p class=\"QN2lPu\">4. Sau đó truy cập Bluetooth trên điện thoại của bạn, chọn “SOUNDPEATS Clear” và kết nối ngay lập tức.</p>\n<p class=\"QN2lPu\">***Lần sau chỉ cần lấy tai nghe ra khỏi hộp sạc, tai nghe sẽ tự động kết nối ***</p>\n<p class=\"QN2lPu\"> </p>\n<p class=\"QN2lPu\"> Các thao tác cảm ứng trên tai nghe:</p>\n<div class=\"QN2lPu\">\n<div>\n<div class=\"P7IbkE\"><img class=\"GqYslU hnult1 shipxanh-image\" src=\"https://down-vn.img.susercontent.com/file/vn-11134208-7r98o-lntkgoj92cx903\" alt=\"vn-11134208-7r98o-lntkgoj92cx903\" /></div>\n</div>\n</div>\n<p class=\"QN2lPu\"> </p>\n<p class=\"QN2lPu\"> Sử dụng cảm ứng điều khiển chức năng</p>\n<p class=\"QN2lPu\">1.Điều khiển âm nhạc</p>\n<p class=\"QN2lPu\">Phát/Tạm dừng Nhạc: Chạm hai lần vào cảm ứng trên tai nghe bên trái hoặc bên phải.</p>\n<p class=\"QN2lPu\">Phát bài hát trước: Chạm và giữ cảm ứng trong 1,5 giây trên tai nghe bên trái.</p>\n<p class=\"QN2lPu\">Phát bài hát tiếp theo: Chạm và giữ cảm ứng trong 1,5 giây trên tai nghe bên phải.</p>\n<p class=\"QN2lPu\">Tăng âm lượng: Chạm 1 lần vào cảm ứng bên tai phải.</p>\n<p class=\"QN2lPu\">Giảm âm lượng: Chạm 1 lần vào cảm ứng ở bên tai trái.</p>\n<p class=\"QN2lPu\"> </p>\n<p class=\"QN2lPu\">2. Điều khiển cuộc gọi</p>\n<p class=\"QN2lPu\">Trả lời/Kết thúc cuộc gọi điện thoại: Nhấn hai lần vào cảm ứng trên tai nghe bên trái hoặc bên phải.</p>\n<p class=\"QN2lPu\">Từ chối cuộc gọi điện thoại : Chạm và giữ cảm ứng trong 1,5 giây trên tai nghe bên trái hoặc bên phải.</p>\n<p class=\"QN2lPu\">Chuyển cuộc gọi: Chạm và giữ cảm ứng trong 2 giây trên tai nghe bên trái hoặc bên phải. (Có cuộc gọi chờ)</p>\n<p class=\"QN2lPu\">Kích hoạt Trợ lý giọng nói: Chạm vào cảm ứng 3 lần trên tai nghe bên phải.</p>\n<p class=\"QN2lPu\">Bật / tắt chế độ trò chơi: Chạm vào cảm ứng 3 lần trên tai nghe bên trái.</p>\n<p class=\"QN2lPu\"> </p>\n<p class=\"QN2lPu\"> Cách reset SoundPEATS Clear:</p>\n<p class=\"QN2lPu\">1. Xóa tai nghe khỏi danh sách Bluetooth của điện thoại.</p>\n<p class=\"QN2lPu\">2. Cho 2 tai nghe vào trong hộp sạc đảm bảo 2 tai nghe đang được sạc bởi hộp sạc</p>\n<p class=\"QN2lPu\">2. Nhấn giữ nút trên hộp sạc trong 10 giây cho đến khi đèn báo hộp sạc nhấp nháy trắng đỏ 2 lần.</p>\n<p class=\"QN2lPu\">Quá trình reset đã hoàn tất.</p>\n<div class=\"QN2lPu\">\n<div>\n<div class=\"P7IbkE\"><img class=\"GqYslU hnult1 shipxanh-image\" src=\"https://down-vn.img.susercontent.com/file/vn-11134208-7r98o-lntkgoj95625bd\" alt=\"vn-11134208-7r98o-lntkgoj95625bd\" /></div>\n</div>\n</div>\n<p class=\"QN2lPu\"> </p>\n<p class=\"QN2lPu\"> Cách đeo:</p>\n<p class=\"QN2lPu\">1. Xác định tai trái, phải.</p>\n<p class=\"QN2lPu\">2, Xoay tai nghe và tìm một vị trí đeo thoải mái nhất. Hướng logo chữ S theo chiều thẳng đứng.</p>\n<div class=\"QN2lPu\">\n<div>\n<div class=\"P7IbkE\"><img class=\"GqYslU hnult1 shipxanh-image\" src=\"https://down-vn.img.susercontent.com/file/vn-11134208-7r98o-lntkgoj93rhp65\" alt=\"vn-11134208-7r98o-lntkgoj93rhp65\" /></div>\n</div>\n</div>\n<p class=\"QN2lPu\"> </p>\n<p class=\"QN2lPu\"> Thông Số Kỹ Thuật</p>\n<p class=\"QN2lPu\">Mẫu mã: SoundPEATS Clear</p>\n<p class=\"QN2lPu\">Màu sắc: Đen, Trắng</p>\n<p class=\"QN2lPu\">Chipset: JL6973D8</p>\n<p class=\"QN2lPu\">Kích thước tai nghe: 57*30*50 2mm</p>\n<p class=\"QN2lPu\">Kích thước hộp sạc: 21*24*33mm”</p>\n<p class=\"QN2lPu\">Trọng lượng tai nghe đơn: 4,2g</p>\n<p class=\"QN2lPu\">Trọng lượng hộp sạc: 45g</p>\n<p class=\"QN2lPu\">Phiên bản Bluetooth: V5.3</p>\n<p class=\"QN2lPu\">Cấu hình Bluetooth được hỗ trợ: HFP/A2DP/AVRCP</p>\n<p class=\"QN2lPu\">Hỗ trợ Bluetooth Codec: AAC,SBC</p>\n<p class=\"QN2lPu\">Dung lượng pin: 38mAh*2 +400mAh</p>\n<p class=\"QN2lPu\">Cổng sạc: Type-C</p>\n<p class=\"QN2lPu\">Phương pháp giảm tiếng ồn bằng giọng nói: Mic kép</p>\n<p class=\"QN2lPu\">Điều khiển: Cảm ứng</p>\n<p class=\"QN2lPu\">Thời gian sạc tai nghe 1,5 giờ; Hộp sạc 2 giờ</p>\n<p class=\"QN2lPu\">Tổng thời gian phát nhạc: Tai nghe: 7 giờ, Số lần sạc: 4,5 lần</p>\n<p class=\"QN2lPu\">Tổng thời gian sử dụng bao gồm hộp sạc: 40 giờ</p>\n<p class=\"QN2lPu\">Kháng nước: IPX4</p>\n<p class=\"QN2lPu\">Đầu vào: 5V/1A</p>\n<p class=\"QN2lPu\">Tổng thời gian chờ: 40 giờ</p>\n<p class=\"QN2lPu\">Độ nhạy của micro: -38±1dB</p>\n<p class=\"QN2lPu\">Đáp ứng tần số: 20-20KHz</p>\n<p class=\"QN2lPu\">Trở kháng/độ nhạy của trình điều khiển: 32Ω ± 15% ở 1KHz AC</p>\n<p class=\"QN2lPu\">Kích thước trình điều khiển: 12 mm</p>\n<p class=\"QN2lPu\">Linh kiện pin: Polyme Li-ion</p>\n<p class=\"QN2lPu\"> </p>\n<p class=\"QN2lPu\"> Bộ sản phẩm bao gồm:</p>\n<p class=\"QN2lPu\">1 x Tai nghe Soundpeats Clear</p>\n<p class=\"QN2lPu\">1 x Cáp sạc Type-C</p>\n<p class=\"QN2lPu\">2 x Tips thay thế size (S,L)</p>\n<p class=\"QN2lPu\">1 x HDSD nhiều ngôn ngữ</p>\n<p class=\"QN2lPu\"> </p>\n<p class=\"QN2lPu\"> Đèn báo hộp sạc của SoundPEATS Clear</p>\n<p class=\"QN2lPu\">1. Khi không sạc hộp sạc</p>\n<p class=\"QN2lPu\">Màu xanh lá: 100% - 50%</p>\n<p class=\"QN2lPu\">Màu vàng: 49% - 10%</p>\n<p class=\"QN2lPu\">Màu đỏ: &lt;10%</p>\n<p class=\"QN2lPu\">2. Khi đang sạc hộp sạc</p>\n<p class=\"QN2lPu\">&lt;10%: Đèn đỏ nhấp nháy</p>\n<p class=\"QN2lPu\">11%-49%: Đèn vàng nhấp nháy</p>\n<p class=\"QN2lPu\">50%-99%: Đèn xanh nhấp nháy</p>\n<p class=\"QN2lPu\">100%: Đèn xanh đứng yên</p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/3e/f7/11/ba42500d5db21b5202d43b702ed79a7c.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/3e/f7/11/ba42500d5db21b5202d43b702ed79a7c.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/3e/f7/11/ba42500d5db21b5202d43b702ed79a7c.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3e/f7/11/ba42500d5db21b5202d43b702ed79a7c.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3e/f7/11/ba42500d5db21b5202d43b702ed79a7c.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/ed/fb/6f/f037f9c67102412339c94768d9038b1b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ed/fb/6f/f037f9c67102412339c94768d9038b1b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ed/fb/6f/f037f9c67102412339c94768d9038b1b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ed/fb/6f/f037f9c67102412339c94768d9038b1b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ed/fb/6f/f037f9c67102412339c94768d9038b1b.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/f4/d1/aa/12f14be6cb82fdcab835fd359c803ed6.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f4/d1/aa/12f14be6cb82fdcab835fd359c803ed6