0,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.5,"review_count":86,"review_text":"(86)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/fd/6c/1e/713a4f3bc5d555793f4a04e7d4f67114.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1708,"all_time_quantity_sold":669,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch1 style=\"text-align: center;\"\u003eNGŨ CỐC CALBEE VỊ TRÁI CÂY GÓI ĐỎ 800GR \u003cbr /\u003e(TRÁI CÂY \u0026amp; CÁC LOẠI HẠT)\u003c/h1\u003e\n\u003ch2 style=\"text-align: center;\"\u003eMô tả sản phẩm\u003c/h2\u003e\n\u003cp style=\"text-align: center;\"\u003eNgũ cốc là món ăn dinh dưỡng không còn xa lạ trong đời sống chúng ta, thành phần chính của Ngũ cốc bao gồm: các loại yến mạch, lúa mạch đen, bột gạo nâu, bột mì, bột ngô\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003eNgũ cốc Calbee Nhật Bản là loại sản phẩm rất được ưa chuộn tại đất nước Mặt trời mọc. Ngoài những loại Ngũ cốc truyền thống, thì còn có thêm các loại Ngũ cốc mix với Trái cây và các loại hạt. Sản phẩm là các loại hạt sấy khô quyện cùng trái cây chua ngọt rất ngon. Có thể ăn không, trộn cùng sữa tươi, salad hoặc làm bánh ngũ cốc.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/57/71/29/e53adb6e3d0c8c385d4303676d874439.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003eCalbee Nhật Bản với thành phần tươi - sạch cùng quy trình sản xuất khắt khe đúng chuẩn hàng nội địa Nhật, vì vậy sản phẩm được ko chỉ dân bản xứ mà rất nhiều nước khác ưa chuộng vô cùng.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003eCalbee ăn cùng sữa tươi hay yogurt đều rất ngon. Đặc biệt túi zip tiện dụng lắm ạ, ko lo ngũ cốc bị mềm nhe.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/e5/c9/9f/c84d13e09dc9435bd2f59e960ade9fd8.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e5 vị ngũ cốc trái cây Calbee hiện có:\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e️ GÓI ĐỎ 800g: Loại truyền thống ra đời đầu tiên với thành phần chính là dâu tây, táo đỏ, đu đủ, nho tím, bí đỏ, dừa non cùng các loại yến mạch. Ngoài ra còn được bổ sung kèm thêm 4.5gr chuối và 5.0mg rau Bina chân vịt\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e️ GÓI NÂU 700g: Gồm Chocolate, chuối, quả mâm xôi cùng các loại yến mạch.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e️ GÓI CAM 700g: Gồm hạt óc chó,táo đỏ, quả mâm xôi, đậu đỏ, bí đỏ, dừa non cùng các loại yến mạch. Rất tốt cho mẹ bầu.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e️ GÓI TRẮNG 600g: gồm các loại hạt dinh dưỡng nghiền (hạnh nhân, hạt bí đỏ, đậu nành), dâu tây, nho tím cùng các loại yến mạch. Dành cho các bạn ko thích ăn ngọt, và đây cũng là loại thường được khách shop khen ăn ngon nhất ạ.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e️GÓI VÀNG 700g: Đây là loại Ngũ cốc nguyên chất nhất, chủ yếu là các loại yến mạch, lúa mạch đen, bột gạo nâu, bột mì, bột ngô. Ngoài ra còn được bổ sung kèm thêm 4.5gr chuối và 5.0mg rau Bina chân vịt\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/8c/1e/3d/15a5eb0ef64805b71be280d56cd0ced4.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/5e/d3/44/98fb03bc05ccb0c53d086ab8068173dd.jpg\" alt=\"\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003ch3 style=\"text-align: center;\"\u003eXuất xứ\u003c/h3\u003e\n\u003cp style=\"text-align: center;\"\u003eNhật Bản\u003c/p\u003e\n\u003ch3 style=\"text-align: center;\"\u003eThành phần\u003c/h3\u003e\n\u003ch3 style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/44/f8/63/f7a19ddbf31e6b2d3bb1a75c4c6127cc.png\" alt=\"\" width=\"750\" height=\"231\" /\u003e\u003c/h3\u003e\n\u003ch3 style=\"text-align: center;\"\u003eHướng dẫn sử dụng\u003c/h3\u003e\n\u003cp style=\"text-align: center;\"\u003eĂn trực tiếp\u003c/p\u003e\n\u003ch3 style=\"text-align: center;\"\u003eHướng dẫn bảo quản\u003c/h3\u003e\n\u003cp style=\"text-align: center;\"\u003eNơi khô mát, tránh ánh sáng trực tiếp\u003c/p\u003e\n\u003ch3 style=\"text-align: center;\"\u003eHạn sử dụng\u003c/h3\u003e\n\u003cp style=\"text-align: center;\"\u003e7 than1g kể từ ngày sản xuất\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003eBao bì có thể thay đổi theo từng đợt nhập hàng.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/fd/6c/1e/713a4f3bc5d555793f4a04e7d4f67114.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/fd/6c/1e/713a4f3bc5d555793f4a04e7d4f67114.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/fd/6c/1e/713a4f3bc5d555793f4a04e7d4f67114.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fd/6c/1e/713a4f3bc5d555793f4a04e7d4f67114.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fd/6c/1e/713a4f3bc5d555793f4a04e7d