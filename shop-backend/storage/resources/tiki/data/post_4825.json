g trọng.\u003cbr /\u003e- Sản phẩm phù hợp cho sinh viên, giáo viên và giới văn phòng.\u003cbr /\u003e- Thiết kế trẻ trung kiểu dáng mạnh mẽ\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/01/9e/d6/5d2220b386ab02014c5fcbfd9e3e1b52.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/8c/26/05/52c77b3104c835ea18a23e51463f71ac.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/8c/26/05/52c77b3104c835ea18a23e51463f71ac.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/8c/26/05/52c77b3104c835ea18a23e51463f71ac.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8c/26/05/52c77b3104c835ea18a23e51463f71ac.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8c/26/05/52c77b3104c835ea18a23e51463f71ac.jpg"}],"warranty_policy":null,"brand":{"id":25284,"name":"Thiên Long","slug":"thien-long"},"current_seller":{"id":64561,"sku":"5999874235408","name":"Thiên Long Official Store","link":"https://tiki.vn/cua-hang/thien-long-official-store","logo":"41/e5/8c/dc5e87a3f668e1b8fd73203d48ed144a.jpg","price":57000,"product_id":"164436021","store_id":60596,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Thông tin chung","attributes":[{"code":"brand","name":"Thương hiệu","value":"Thiên Long"},{"code":"brand_country","name":"Xuất xứ thương hiệu","value":"Việt Nam"},{"code":"origin","name":"Xuất xứ (Made in)","value":"Vi