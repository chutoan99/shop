f14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/media/catalog/product/8/5/8595249106962_1.u2769.d20161219.t094218.550173.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2630,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch5 style=\"text-align: justify;\"\u003eHiệu suất đun sôi cao\u003c/h5\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eBình Đun Siêu Tốc  SmartCook KES-0696 - 1.8L\u003c/strong\u003e hoạt động với công suất 1850W, cùng công nghệ đốt nóng bằng mâm nhiệt phẳng cho phép đun nước sôi nhanh chóng, giúp bạn tiết kiệm thời gian và điện năng tiêu thụ.\u003c/p\u003e\r\n\u003ch5 style=\"text-align: justify;\"\u003eChất liệu nhựa cao cấp\u003c/h5\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eThân bình được làm từ chất liệu nhựa nguyên sinh cao cấp, cho phép đun sôi nhanh và đảm bảo an toàn vệ sinh cho người sử dụng. Ngoài ra, với chất liệu nhựa nguyên sinh có khả năng cách nhiệt cực tốt, đảm bảo tay không bị bỏng khi tiếp xúc với bình.\u003c/p\u003e\r\n\u003ch5 style=\"text-align: justify;\"\u003eThiết kế nhỏ gọn, đẹp mắt\u003c/h5\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cspan\u003eBình đun nước siêu tốc \u003c/span\u003e\u003cspan\u003eSmartCook KES-0696 chính hãng có thiết kế nhỏ gọn, kiểu dáng hiện đại với màu trắng phối đỏ ở nắp bình và đáy bình, \u003cspan\u003emang lại nét đẹp sang trọng cho không gian sử dụng. \u003c/span\u003e\u003c/span\u003eSản phẩm thiết kế tay cầm tiện dụng, giúp bạn dễ dàng di chuyển, không chiếm nhiều diện tích khi sử dụng.\u003c/p\u003e\r\n\u003ch5 style=\"text-align: justify;\"\u003eThang đo mực nước\u003c/h5\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eBình được thiết kế hiển thị mực nước trong bình và trang bị thước đo tiện dụng, giúp bạn kiểm soát được lượng nước trong bình dễ dàng. Với dung tích lên đến 1.8 lít, sản phẩm cho bạn nấu được nhiều nước hơn để sử dụng khi cần.\u003c/p\u003e\r\n\u003ch5 style=\"text-align: justify;\"\u003eChế độ tự động ngắt điện\u003c/h5\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eBình có chế độ tự động ngắt điện khi nước sôi, ngoài công dụng tiết kiệm năng lượng, còn tránh được tình trạng cạn nước cháy bình, rất an toàn cho người sử dụng.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/media/catalog/product/8/5/8595249106962_1.u2769.d20161219.t094218.550173.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/8/5/8595249106962_1.u2769.d20161219.t094218.550173.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/8/5/8595249106962_1.u2769.d20161219.t094218.550173.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/8/5/8595249106962_1.u2769.d20161219.t094218.550173.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/8/5/8595249106962_1.u2769.d20161219.t094218.550173.jpg"},{"base_url":"https://salt.tikicdn.com/media/catalog/product/8/5/8595249106962_2.u2769.d20161219.t094218.58864