or":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":23000,"discount_rate":21,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/7c/1c/9c/2be4c3a4c8c28c271a169013db8ebba8.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":687,"all_time_quantity_sold":21,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eCờ Tỷ Phú\u003c/strong\u003e là một trò chơi lâu đời ở Việt Nam, như một món ăn tinh thần không thể thiếu của mỗi gia đình. Vào những lúc rảnh rỗi, mọi người bày Cờ Tỷ Phú ra chơi, vừa có được niềm vui, vừa gắn kết các mối quan hệ nhiều hơn. Cờ Tỷ Phú được đánh giá là 1 trong 10 trò chơi mang lại nhiều trí tưởng tượng và phát triển tư duy cho người chơi. \u003cstrong\u003eBàn Cờ Tỷ Phú Phiên Bản Việ Nam\u003c/strong\u003e mang đến cho bé và gia đình những giây phút vui chơi thú vị.\u003c/p\u003e\n\u003cdiv\u003e\u003csource type=\"image/webp\"\u003e\u003c/source\u003e\u003cimg class=\"WebpImg__StyledImg-sc-h3ozu8-0 fWjUGo\" src=\"https://salt.tikicdn.com/ts/tmp/33/b7/c8/96e7f6af0413ded0577c68ec250c2021.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/div\u003e\n\u003cp\u003ePhiên bản Cờ Tỷ Phú mới nhất này mang đậm nét văn hóa của Việt Nam, khi đưa các địa danh thân yêu của chúng ta vào mỗi cạnh của bàn cờ. Người chơi như du lịch một vòng của đất nước hình chữ S xinh đẹp để chiêm ngưỡng thắng cảnh.\u003c/p\u003e\n\u003cdiv\u003e\u003csource type=\"image/webp\"\u003e\u003c/source\u003e\u003cimg class=\"WebpImg__StyledImg-sc-h3ozu8-0 fWjUGo\" src=\"https://salt.tikicdn.com/ts/tmp/18/f4/79/bc4756431615cea35f28f40bda9dd59c.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/div\u003e\n\u003cdiv\u003e\u003csource type=\"image/webp\"\u003e\u003c/source\u003e\u003cimg class=\"WebpImg__StyledImg-sc-h3ozu8-0 fWjUGo\" src=\"https://salt.tikicdn.com/ts/tmp/dd/e4/2f/75b5a7bb0cbd7aa5b6e31a8b3749b55b.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/div\u003e\n\u003cp\u003eNếu các bạn chưa biết cách chơi của Cờ Tỷ Phú thì đừng lo lắng vì trong bộ đồ chơi này đã có sẵn Sách Hướng Dẫn Chơi rất chi tiết và dễ hiểu.\u003c/p\u003e\n\u003cp\u003eCÁCH CHƠI CƠ BẢN:\u003c/p\u003e\n\u003cp\u003e- Trải bàn đồ, chọn quân cờ đại diện người chơi, đặt tại ô Khởi Hành\u003c/p\u003e\n\u003cp\u003e- Chia tiền: Chọn một người làm ngân hàng, cấp cho người chơi khác mỗi người $10.000 làm vốn, phần còn lại Ngân hàng Giữ\u003c/p\u003e\n\u003cp\u003e- Trộn thẻ Khí Vận và đặt úp xuống bàn\u003c/p\u003e\n\u003cp dir=\"ltr\"\u003e- Trộn thẻ Cơ Hội và đặt úp xuống bàn\u003c/p\u003e\n\u003cp dir=\"ltr\"\u003e- Chọn 1 người làm ngân hàng để quản lý Tiền ngân hàng, Nhà, Khế đất. Người làm ngân hàng vẫn có thể  chơi cùng và sẽ có tiền riêng để chơi như người chơi bình thường.\u003c/p\u003e\n\u003cp dir=\"ltr\"\u003e- Sử dụng xúc xắc để chơi và xác định số ô di chuyển: Di chuyển trên bàn cờ và mua càng nhiều đất càng tốt, có nhiều đất bạn sẽ có khả năng thu tiền thuế cao hơn. Khi di chuyển đến ô đất, dựa trên số tiền bạn đang có, bạn quyết định mua ô đất đó thì nó sẽ thành tái sản sở hữu của bạn, khi người chơi khác đi vào đất của bạn, họ phải trả thuế đất theo số tiền hiển thị trên ô đất đó.\u003c/p\u003e\n\u003cp dir=\"ltr\"\u003e- Người chơi sẽ bị phá sản (tức loại khỏi cuộc chơi) khi không còn khả năng trả nợ ngân hàng hoặc nợ người chơi khác.- Người cuối cùng ở lại là người thắng cuộc.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/7c/1c/9c/2be4c3a4c8c28c271a169013db8ebba8.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/7c/1c/9c/2be4c3a4c8c28c271a169013db8ebba8.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/7c/1c/9c/2be4c3a4c8c28c271a169013db8ebba8.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7c/1c/9c/2be4c3a4c8c28c271a169013db8ebba8.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7c/1c/9c/2be4c3a4c8c28c271a169013db8ebba8.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/35/98/6f/e4a9211f5829bcc30e2f34a39ffbaa0b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/35/98/6f/e4a9211f5829bcc30e2f34a39ffbaa0b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/35/98/6f/e4a9211f5829bcc30e2f34a39ffbaa0b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/35/98/6f/e4a9211f5829bcc30e2f34a39ffbaa0b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/35/98/6f/e4a9211f5829bcc30e2f34a39ffbaa0b.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/cb/8a/2e/b8655da8492f95dfc58d5e2b5728a264.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/cb/8a/2e/b8655da8492f95dfc58d5e2b5728a264.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/cb/8a/2e/b8655da8492f95dfc58d5e2b5728a264.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/cb/8a/2e/b8655da8492f95dfc58d5e2b5728a264.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/cb/8a/2e/b8655da8492f95dfc58d5e2b5728a264.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/18/f4/79/6b96f