14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":40000,"discount_rate":10,"rating_average":5,"review_count":3,"review_text":"(3)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/4e/02/21/3f6e7b01a40b890f49ddfeec9ce98e4e.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":413,"all_time_quantity_sold":9,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p>TÍNH NĂNG ƯU VIỆT CỦA BẾP 2 CHIỀU:</p>\n<p>TIỆN DỤNG</p>\n<p>Bếp gas mini NaMilux NH-P2915PS được thiết kế van 2 chiều: Sử dụng được lon gas mini và sử dụng được bình gas lớn các loại 4~13 kg . Người dùng có thể linh động và thuận tiện dùng làm bếp dự phòng trong việc nấu ăn, đặc biệt phù hợp cho những khu vực mà việc cung cấp lon gas mini chưa được phổ biến rộng rãi</p>\n<p>AN TOÀN TUYỆT ĐỐI</p>\n<p>Van an toàn 2 cấp được sản xuất trên dây chuyền tự động và hiện đại đạt tiêu chuẩn quốc tế, đảm bảo độ chính xác cao và an toàn tuyệt đối. Hoạt động van an toàn 2 cấp:</p>\n<p>- An toàn cấp 1: Sử dụng lon gas có áp lực quá cao (thường là lon gas sạc lại) van sẽ tự động ngắt gas và tắt lửa, không cho gas nạp vào van --&gt; Lửa không cháy dù thực hiện nhiều lần động tác đánh lửa.</p>\n<p>- An toàn cấp 2: Nếu áp lực trong lon gas tiếp tục tăng đến giới hạn nguy hiểm do tác động môi trường, nhiệt độ… cầu chì sẽ tự động xả gas trong lon ra ngoài ngăn chặn nổ lon gas</p>\n<p>TIẾT KIỆM</p>\n<p>Hệ thống đầu đốt theo tiêu chuẩn JIA Nhật Bản tối ưu hiệu suất đốt --&gt; tiết kiệm gas Sử dụng bình gas lớn --&gt; tiết kiệm chi phí, và thời gian tìm mua - đổi gas mini</p>\n<p>MỘT SỐ LƯU Ý KHI SỬ DỤNG GAS BÌNH</p>\n<p>- Tuyệt đối không sử dụng cùng lúc 2 loại gas</p>\n<p>- Phải vệ sinh roăn cao su thật sạch trước khi gắn đầu nối ống gas</p>\n<p>- Phải chắc chắn rằng đầu nối ống gas đã được siết chặt bằng tay vào cụm van ở bên hông bếp trong suốt quá trình sử dụng</p>\n<p>- Chờ 10 - 15 giây để gas nạp vào van trước khi đánh lửa để sử dụng</p>\n<p>- Sử dụng gas bình thì ngọn lửa sẽ nhỏ hơn 1 ít so với khi sử dụng lon gas</p>\n<p>THÔNG SỐ KỸ THUẬT</p>\n<p>Mã hàng hoá: NH-P2915PS</p>\n<p>Sử dụng gas: lon gas mini hoặc bình gas lớn 4~13 Kg</p>\n<p>Công suất tối đa: 2.6 kW (2,200 kcal/h) sử dụng lon gas , 2.4kW (2,070 kcal/h) sử dụng bình gas</p>\n<p>Tính năng an toàn: Sử dụng van an toàn 2 cấp</p>\n<p>Khối lượng tịnh: 1.4 Kg</p>\n<p>Kích thước bếp: C102 x D335 x R282 (mm)</p>\n<p>Xuất xứ : Việt Nam</p>\n<p>Áp dụng TCCS: 01:2016/CTY-VINA</p>\n<p>Bảo hành: 12 tháng</p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/4e/02/21/3f6e7b01a40b890f49ddfeec9ce98e4e.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/4e/02/21/3f6e7b01a40b890f49ddfeec9ce98e4e.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/4e/02/21/3f6e7b01a40b890f49ddfeec9ce98e4e.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4e/02/21/3f6e7b01a40b890f49ddfeec9ce98e4e.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4e/02/21/3f6e7b01a40b890f49ddfeec9ce98e4e.png"},{"base_url":"https://salt.tikicdn.com/ts/product/03/f9/71/3add3330d74d3711884d7ff4bb30729a.png","is_gallery":true,"label":null,"large_url":"https://salt.tikic