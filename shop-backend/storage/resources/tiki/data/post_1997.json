n_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":6,"review_text":"(6)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/cd/fb/ae/f1ad1f806428b3740a15c050e8a53049.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":364,"all_time_quantity_sold":142,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cem\u003e“Lãnh đạo có nghĩa là trao quyền kiểm soát thay vì nắm quyền kiểm soát và tạo ra những người lãnh đạo thay vì rèn giũa những người theo sau.” - David Marquet\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003eCuốn sách Xoay chuyển con tàu được xuất bản dựa trên những câu chuyện thực tế từ một Cựu chỉ huy Hải quân Hoa Kỳ - Thuyền trưởng David Marquet. Thuyền trưởng David Marquet đã xoay chuyển thành công con tàu mình chỉ huy USS Santa Fe, từ một tàu ngầm hoạt động kém nhất trong hạm đội trở thành con tàu có hiệu suất tốt nhất. Điều này chứng minh cho sự thành công trong phong cách lãnh đạo của ông, \u003cstrong\u003emô hình Người lãnh đạo - Người lãnh đạo dựa trên nguyên tắc 3C độc đáo: Control (Kiểm soát) - Competence (Năng lực) - Clarity (Minh bạch).\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"//file.hstatic.net/200000632683/file/sach-xoay-chuyen-con-tau-happy-live_581d1f22b6834c1bb8b9d68b85d2dc10_grande.jpg\" width=\"600\" height=\"338\" alt=\"sach-xoay-chuyen-con-tau-happy-live_581d1f22b6834c1bb8b9d68b85d2dc10_grande.jpg\" /\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eSức hút của cuốn sách\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eNếu bạn là nhà quản lý, bạn biết rằng việc không ngừng cải thiện kỹ năng lãnh đạo của mình là rất quan trọng để có thể giữ vững đội nhóm của mình tập trung và đi đúng hướng.\u003c/p\u003e\n\u003cp\u003eNhưng nếu chiến lược của bạn không hiệu quả thì sao? Điều gì sẽ xảy ra nếu nhân viên ngày càng trở nên bơ phờ, không có hứng thú với công việc được giao?\u003c/p\u003e\n\u003cp\u003eCó lẽ đã đến lúc xem xét lại cách bạn lãnh đạo. Qua cuốn sách này, bạn sẽ học được kinh nghiệm trực tiếp của David Marquet, rằng việc khuyến khích nhân viên của mình học cách lãnh đạo khiến bạn trở thành một nhà lãnh đạo tốt hơn, đồng thời sức mạnh của sự trao quyền sẽ thúc đẩy đội nhóm hoạt động tốt hơn và cùng nhau thành công.\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eXuyên suốt cuốn sách, bạn cũng sẽ khám phá ra:\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003e- Tại sao phong cách lãnh đạo từng giúp tiền nhân xây dựng kim tự tháp Ai Cập không còn phù hợp nữa;\u003c/p\u003e\n\u003cp\u003e- Tại sao cách lãnh đạo tốt nhất là cách tạo ra nhiều nhà lãnh đạo thế hệ sau; Và\u003c/p\u003e\n\u003cp\u003e- Tại sao cuộc họp không có chủ đích lại khiến mọi người buồn ngủ thay vì truyền cảm hứng cho họ…\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eVề tác giả \u003c/strong\u003e\u003c/h3\u003e\n\u003cdiv\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"//file.hstatic.net/200000632683/file/sach-xoay-chuyen-con-tau-happy-live-1_df33970a51584fbab7665c9658708863_grande.png\" width=\"600\" height=\"324\" alt=\"sach-xoay-chuyen-con-tau-happy-live-1_df33970a51584fbab7665c9658708863_grande.png\" /\u003e\u003c/p\u003e\n\u003c/div\u003e\n\u003cp\u003eDavid Marquet là cựu học viên xuất sắc của Học viện Hải quân Hoa Kỳ, có nhiều kinh nghiệm trong việc dẫn dắt, chỉ huy tàu ngầm chạy bằng năng lượng. Kể từ khi nghỉ hưu, rời khỏi Hải quân, ông làm việc với các doanh nghiệp trên toàn quốc với tư cách là cố vấn lãnh đạo. \u003c/p\u003e\n\u003cp\u003eTác giả hiện sống ở Florida, là thành viên chính thức của Hội đồng Quan hệ Đối ngoại và là một vận động viên chạy bộ đầy nhiệt huyết.\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eAi nên đọc cuốn sách này?\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eBất kể công việc kinh doanh hay vị trí việc làm của bạn là gì, bạn đều có thể áp dụng những nguyên tắc của Marquet để “xoay chuyển tình thế con tàu” (xoay chuyển tình trạng công việc) của mình. \u003c/p\u003e\n\u003cp\u003ePhần thưởng dành cho bạn: \u003c/p\u003e\n\u003cp\u003e- Một tổ chức, một đội nhóm, một doanh nghiệp nếu nằm lòng bộ nguyên tắc và mô hình làm việc đặc biệt này sẽ có thành công rực rỡ, vững bền. \u003c/p\u003e\n\u003cp\u003e- Một nơi làm việc nơi tất cả mọi người đều có trách nhiệm về hành động của mình, nơi mọi người năng lượng, nhiệt huyết hơn và hạnh phúc, vui vẻ hơn, nơi mọi người đều là người lãnh đạo của chính mình.\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eCùng điểm qua đánh giá của chuyên gia về cuốn sách\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003e\u003cem\u003e“Tôi không nghĩ có một mô hình lãnh đạo kiểu trao quyền nào tốt hơn mô hình của Thuyền trưởng Marquet. Và trong những trang sách này, bạn sẽ tìm thấy một mô hình lãnh đạo - làm việc phù hợp cho bản thân.”  \u003c/em\u003e- Stephen R. Covey, tác giả cuốn sách 7 thói quen hiệu quả \u003c/p\u003e\n\u003cp\u003e\u003cem\u003e“Nếu nói tôi là người hâm mộ David Marquet thôi thì vẫn chưa đủ. Tôi là một người hâm mộ cuồng nhiệt đã được huấn luyện đầy đủ. Ông ấy là kiểu lãnh đạo cả thế hệ mới có một người. Ông ấy không chỉ biết cách lãnh đạo, mà còn biết cách đào tạo ra những người lãnh đạo khác. Những ý tưởng và bài học của ông vô cùng có giá trị cho bất kỳ ai muốn xây dựng một tổ chức trường tồn.”\u003c/em\u003e - Simon Sinek, tác giả cuốn sách Bắt đầu với câu hỏi Tại sao\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eMục lục\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003e\u003cstrong\u003ePHẦN 1: BẮT ĐẦU LẠI TỪ ĐẦU\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eSự thất bại\u003c/p\u003e\n\u003cp\u003eHoạt động như bình thường \u003c/p\u003e\n\u003cp\u003eThay đổi cách giải quyết \u003c/p\u003e\n\u003cp\u003eMất phương hướng \u003c/p\u003e\n\u003cp\u003eKêu gọi hành động\u003c/p\u003e\n\u003cp\u003e“Họ bảo gì tôi làm nấy!”\u003c/p\u003e\n\u003cp\u003e“Tôi tin ở anh!”\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003ePHẦN 2: KIỂM SOÁT\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eThay đổi trong một từ\u003c/p\u003e\n\u003cp\u003e“Chào mừng lên tàu Santa Fe!”\u003c/p\u003e\n\u003cp\u003eRa ngoài khơi trên chiếc tàu năng lượng hạt nhân\u003c/p\u003e\n\u003cp\u003e“Tôi định…”\u003c/p\u003e\n\u003cp\u003eNâng kính tiềm vọng lên!\u003c/p\u003e\n\u003cp\u003eAi là người chịu trách nhiệm?\u003c/p\u003e\n\u003cp\u003e“Một con tàu mới”\u003c/p\u003e\n\u003cp\u003e“Chúng ta có một vấn đề”\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003ePHẦN 3: NĂNG LỰC\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e“Sai lầm bỗng nhiên xảy ra!”\u003c/p\u003e\n\u003cp\u003e“Chúng tôi học hỏi”\u003c/p\u003e\n\u003cp\u003eRa biển San Diego\u003c/p\u003e\n\u003cp\u003eTất cả đều có mặt và đã điểm danh\u003c/p\u003e\n\u003cp\u003eNhững bước chuẩn bị cuối cùng\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003ePHẦN 4: MINH BẠCH HOÁ\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eRa biển cho cuộc triển khai\u003c/p\u003e\n\u003cp\u003eMột kỷ niệm trong chiến tranh\u003c/p\u003e\n\u003cp\u003eLãnh đạo ở mọi cấp độ\u003c/p\u003e\n\u003cp\u003eMột đoạn đường nguy hiểm\u003c/p\u003e\n\u003cp\u003eNhìn xa trông rộng\u003c/p\u003e\n\u003cp\u003eChiến đấu hiệu quả\u003c/p\u003e\n\u003cp\u003eVề nhà\u003c/p\u003e\n\u003cp\u003eMột phương pháp tiếp tế mới \u003c/p\u003e\n\u003cp\u003eNhớ lại\u003c/p\u003e\n\u003cp\u003eLời cuối sách\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát