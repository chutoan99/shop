6e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":90000,"discount_rate":32,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/5f/a8/0e/36a0d6d304e41c7465b95ede8113f28a.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":526,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cem\u003e\u003cstrong\u003eThông số nổi bật\u003c/strong\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eĐầu vào Type C tiện lợi\u003c/li\u003e\n\u003cli\u003eTốc độ truyền dữ liệu dữ liệu 5Gbps\u003c/li\u003e\n\u003cli\u003eĐèn Led hiển thị nhóm thiết bị khi kết nối\u003c/li\u003e\n\u003cli\u003eNhỏ gọn và tiện dụng với chiều dài dây chỉ 15CM\u003c/li\u003e\n\u003cli\u003eChất liệu nhựa ABS độ bền cực cao.\u003c/li\u003e\n\u003cli\u003eMàu sắc đa dạng: đen / trắng / xanh / hồng\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cem\u003e\u003cstrong\u003eGiới Thiệu Sản Phẩm:\u003c/strong\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cstrong\u003eCông Dụng: \u003c/strong\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003eBộ Chia cổng Type C ra 4 cổng USB 3.0 Orico PW4U-C3 (Chia 1 cổng Type C ra 4 cổng USB 3.0) giúp mở rộng\u003c/p\u003e\n\u003cp\u003ethêm 4 cổng USB 3.0 qua cổng TYPEC từ máy tính hay laptop. Giao tiếp USB 3.0 tốc độ max 5Gb/s, hỗ trợ hot-swap, plug \u0026amp; play\u003c/p\u003e\n\u003cp\u003echỉ cắm và sử dụng.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/7d/30/12/a1c7758cde65da7f8554338a2897f3a6.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cstrong\u003eThiết kế nhỏ gọn, tiện lợi \u003c/strong\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003eHub Type C Orico 4 Cổng PW4U-C3 được thiết kế từ chất liệu nhựa ABS cao cấp đem lại độ bền cao, kích thước nhỏ gọn giúp\u003c/p\u003e\n\u003cp\u003ebạn cầm nắm và dễ dàng bỏ túi, balo để di chuyển. Chiều dài cáp 0.15 mét giúp bạn sử dụng thiết bị trong phạm vi gần như kết\u003c/p\u003e\n\u003cp\u003enối điện thoại, laptop, bàn phím\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/da/a2/d8/4114d321d1b4fae23972fefbe8d87160.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cstrong\u003eTốc độ truyền tải nhanh \u003c/strong\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003eVới cổng USB 3.0, tốc độ truyền tải tối đa lên đến 5Gbps, Hub USB 3.0 mang đến cho bạn một trải nghiệm đồng bộ nhanh\u003c/p\u003e\n\u003cp\u003enhư chớp, giúp công việc được xử lý dễ dàng hơn.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/05/a9/ac/732e0d45ee8f13e19131551b1172016d.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cstrong\u003eTối ưu tốc độ so với 2.0, Tương thích ngược với USB 2.0 \u003c/strong\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003eThiết bị hỗ trợ USB 3.0 với tốc độ cao nhanh hơn 2.0 gấp 10 lần có thể cắm vào máy tính, laptop, máy tính bảng mà không\u003c/p\u003e\n\u003cp\u003ecần bất kỳ trình điều khiển hoặc cài bất kì phần mềm khác nào.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/0c/28/bd/982eee2fe9a52c20cd5dc33202a9f34a.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cem\u003e4 cổng đầu ra tiện lợi \u003c/em\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eHub type C Orico 4 cổng PW4U-C3 chính hãng được thiết kế với khả năng đáp ứng dòng điện cho cả 4 thiết bị cùng 1 lúc,\u003c/p\u003e\n\u003cp\u003eđáp ứng tốc độ không bị thay đổi quá nhiều và khả năng bảo vệ khi dòng điện quá tải và bảo vệ ngắn mạch để giữ cho nó\u003c/p\u003e\n\u003cp\u003ekhỏi quá áp, quá dòng, rò rỉ.\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cstrong\u003eKhả năng tương thích với tất cả các thiết bị ngoại vi \u003c/strong\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003eSản phẩm trang bị bộ chia 4 cổng 3.0 giúp kết nối máy tính với các thiết bị ngoại vi như usb, chuột, bàn phím, máy in, điện\u003c/p\u003e\n\u003cp\u003ethoại, laptop, tablet….\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/70/2c/40/d8dabb5a6640abdfbaa262844de724bf.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/5f/a8/0e/36a0d6d304e41c7465b95ede8113f28a.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/5f/a8/0e/36a0d6d304e41c7465b95ede8113f28a.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/5f/a8/0e/36a0d6d304e41c7465b95ede8113f28a.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5f/a8/0e/36a0d6d304e41c7465b95ede8113f28a.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5f/a8/0e/36a0d6d304e41c7465b95ede8113f28a.png"},{"base_url":"https://salt.tikicdn.com/ts/product/83/2c/a4/2e3ff77292cffbb251d8f13b2318a1da.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/83/2c/a