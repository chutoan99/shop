3596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/38/ba/30/cb9498bebba375dc310103f1793aa9d4.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1044,"all_time_quantity_sold":4,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eTHƯƠNG HIỆU: TBOSS\u003c/p\u003e\n\u003cp\u003eSẢN XUẤT TẠI TRUNG QUỐC, CÔNG TY SẢN XUẤT CỦA NHẬT BẢN, CHẤT LƯỢNG TIÊU CHUẨN NHẬT\u003c/p\u003e\n\u003cp\u003eDUNG LƯỢNG: 21V\u003c/p\u003e\n\u003cp\u003eBẢO HÀNH: 1 NĂM, LỖI ĐỔI MỚI TRONG 1 THÁNG\u003c/p\u003e\n\u003cp\u003eCông suất 21V mạnh mẽ giúp máy tăng năng suất Máy sử dụng nhông kim loại Công nghệ xử lý nhiệt chống ẩm ướt\u003c/p\u003e\n\u003cp\u003eTốc độ không tải: 11.000 vòng/phút\u003c/p\u003e\n\u003cp\u003eĐường kính trục: 10mm Đường kính đĩa: 100mm\u003c/p\u003e\n\u003cp\u003eMáy sử dụng vòng bi NSK chuyên dụng cho máy hút bụi nên vòng bi rất bền, Không có tình trạng bị vỡ vòng bi.\u003c/p\u003e\n\u003cp\u003eMáy có công suất lớn nên việc mài góc, cắt sắt hay cắt các loại vật liệu khách hàng cẩn trở nên nhanh chóng, tiện lợi\u003c/p\u003e\n\u003cp\u003eMáy sử dụng ruột lõi ĐỒNG NGUYÊN CHẤT 100%, hoạt động mạnh và ổn định, không hư vặt ruột hay công tắc sau 1 thời gian như các dòng máy khác.\u003c/p\u003e\n\u003cp\u003eHoạt động bền bỉ, hiệu quả RÔ và SA và các phụ kiện của máy mài có sẵn trên thị trường rất nhiều. Nên dễ dàng thay thế khi gặp sự cố hổng hóc.\u003c/p\u003e\n\u003cp\u003eBộ sản phẩm bao gồm: 1 máy mài Makita không chổi than + 2 pin + 1 Sạc pin + 1 tấm chắn bảo vệ + 1 tay cầm phụ + cờ lê tháo lắp + 1 vali đựng bằng nhựa tiện dụng\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTIỆN ÍCH VƯỢT TRỘI\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Chức năng: mài góc, cắt sắt, cắt gỗ, cắt gạch, gia đình hoặc công trình xây dựng\u003c/p\u003e\n\u003cp\u003e- Máy sử dụng động cơ không chổi than nên hoạt động mạnh, êm và tuổi thọ cao hơn các dòng máy có chổi than thông thường.\u003c/p\u003e\n\u003cp\u003e- Ruột lõi đồng nguyên chất 100%, hoạt động mạnh và ổn định, không hư vặt ruột hay công tắc sau 1 thời gian như các dòng máy pha nhôm khác.\u003c/p\u003e\n\u003cp\u003e- Thiết kế tay cầm chống trơn, dễ thao tác, thuận tiện cho người sử dụng.\u003c/p\u003e\n\u003cp\u003e- Máy có tích hợp đèn báo pin, nút điều chỉnh tốc độ 3 cấp tốc độ sử dụng linh hoạt.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eMáy mài góc dùng pin TBOSS 21V  không chổi than\u003c/strong\u003e tiện không dây cho mài \u0026amp; ứng dụng cắt. Với một động cơ chu vi nhỏ với tấm đệm mềm để tăng cường sự thoải mái và kiểm soát rất dễ dàng để sử dụng. Giới hạn hiện tại của điện tử bảo vệ động cơ khỏi quá tải và có một đèn cảnh báo sẽ bật để cảnh báo về tình trạng quá tải sắp xảy ra và cũng cảnh báo pin thấp. Chức năng chống khởi động lại cho an toàn có nghĩa là động cơ sẽ không khởi động nếu pin sạc được lắp với công tắc trên.\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eMáy mài góc dùng pin TBOSS 21V  không chổi than\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003e- dễ sử dụng với rất nhiều tính năng dùng để mài các ba via, làm nhẵn mối hàn, các cạnh sắc ở các vị trí nhỏ hẹp, ngóc ngách. Còn có thể kết hợp với một số phụ kiện thông minh để thực hiện chức năng đánh bóng chi tiết phẳng, đánh bóng trong và ngoài ống, đánh bóng các góc hẹp khó tiếp cận…\u003c/p\u003e\n\u003cp\u003e- \u003cstrong\u003eMáy mài góc dùng pin TBOSS 21V \u003c/strong\u003e\u003cstrong\u003ekhông chổi than \u003c/strong\u003eđược cấu tạo từ vật liệu hợp kim nhôm và nhựa cao cấp, cho kết cấu chắc chắn, máy sử dụng pin 21V. Đá mài rắn chắc cho khả năng mài nhanh, gọn, đẹp mà không làm hư hỏng vật liệu.\u003c/p\u003e\n\u003cp\u003e- Máy có độ rung thấp nhằm tránh cảm giác tê tay. Ngoài ra còn có hệ thống làm mát trực tiếp giảm thiểu tối đa sự quá tải nhiệt khi làm việc liên tục.\u003c/p\u003e\n\u003cp\u003e- Với thiết kế tỉ mỉ, kết cấu chắc chắn, giúp bạn yên tâm sử dụng sản phẩm trong thời gian dài mà không lo hư hỏng như các sản phẩm thông thường.\u003c/p\u003e\n\u003cp\u003e- Báng cầm mềm, êm tay, chống trượt, tránh cảm giác mỏi tay khi làm việc trong thời gian dài. Tay cầm phụ được thiết kế chắc chắn, giúp điều khiển thiết bị dễ dàng, linh hoạt và an toàn.\u003c/p\u003e\n\u003ch3\u003eĐặc điểm nổi bật tạo nên \u003cstrong\u003eMáy mài góc dùng pin TBOSS 21V \u003c/strong\u003e\u003cstrong\u003e không chổi than\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003e- \u003cstrong\u003eMáy mài góc dùng pin TBOSS 21V \u003c/strong\u003e\u003cstrong\u003e không chổi than\u003c/strong\u003e mạnh mẽ, không cần phải cắm điện mới hoạt động được như dòng máy mài thông thường. Do đó quá trinh thực hiện công việc trở lên linh động không quá phụ thuộc vào nguồn điện, người dùng không còn gặp phải tình trạng những chiếc dây điện dài lằng nhằng, những ổ cắm chằng chịt vướng víu , từ đây có thể mang ra nhiều vị trí thi công khác nhau một cách dễ dàng.\u003c/p\u003e\n\u003cp\u003e- \u003cstrong\u003eMáy mài góc dùng pin TBOSS 21V \u003c/strong\u003e có kiểu dáng nhỏ gọn, cầm tay rất tiện lợi nên người dùng có thể thao tác bằng 1 tay hoặc có thể gắn thêm tay cầm để thao tác mài được nhanh và hiệu suất làm việc cao hơn. Máy mài hoạt động với công suất mạnh mẽ giúp người sử dụng nhanh chóng mài nhẵn các góc cạnh kim loại, vết hà đem lại hiệu suất công việc cao.\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/f7/46/a2/6101