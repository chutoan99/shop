n.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/3c/da/6b/b84f21407f50ee356162c606a0df017c.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":938,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eDầu Xả Dưỡng Tóc Dầu Dừa Vỏ Bưởi TABAHA là sản phẩm giúp dưỡng tóc, bảo vệ và phục hồi hư tổn một cách hoàn hảo. Sản phẩm mang lại cho bạn mái tóc mềm mượt và chắc khỏe. Sản phẩm sử dụng tốt cho cả tóc nhuộm.\u003c/p\u003e\n\u003cp\u003eTHÀNH PHẦN CHÍNH:\u003c/p\u003e\n\u003cp\u003e- Dầu dừa: tác dụng dưỡng ẩm sâu, cung cấp dưỡng chất cần thiết nuôi dưỡng tóc và làm tóc sáng bóng.\u003c/p\u003e\n\u003cp\u003e- Dầu olive: tinh chất nuôi dưỡng - phục hồi tóc hư tổn.\u003c/p\u003e\n\u003cp\u003e- Vỏ bưởi: phục hồi và bảo vệ tóc - chống lại các gốc tự do gây hại cho tóc từ môi trường bên ngoài, chăm sóc tóc chắc khỏe, giảm gàu và kích thích tóc nhanh dài hơn.\u003c/p\u003e\n\u003cp\u003e- Thành phần Panthenol ( Pro – Vitamin B5): thành phần này có khả năng làm mầm tóc phân chia, nhanh chóng tái tạo tóc mới, ngoài ra nó còn có tác dụng làm tăng độ ẩm cho tóc, giúp tóc mềm mại, ngăn rụng hữu hiệu.\u003c/p\u003e\n\u003cp\u003eTất cả các thành phần chăm sóc tóc đều có cơ chế tác động chuyên sâu vào tận các lớp tế bào và mô liên kết bên trong, giúp chăm sóc tóc chắc khỏe từ gốc tới ngọn.\u003c/p\u003e\n\u003cp\u003eHƯỚNG DẪN SỬ DỤNG:\u003c/p\u003e\n\u003cp\u003eSau khi gội sạch, dùng lượng vừa đủ Dầu Xả Dưỡng Tóc Dầu Dừa TABAHA massage nhẹ nhàng lên tóc, ủ trong vòng vài phút để thấm sâu vào chân tóc, sau đó xả lại bằng nước sạch.\u003c/p\u003e\n\u003cp\u003eHướng dẫn sử dụng dầu xả Dầu Dừa Vỏ Bưởi Tabaha\u003c/p\u003e\n\u003cp\u003e→ Bước 1: Sau khi gội sạch đầu, bạn vuốt nhẹ cho tóc bớt nước.\u003c/p\u003e\n\u003cp\u003e→ Bước 2: Bạn lấy một ít dầu xả dầu dừa hương nhu Mộc Nhu ra tay, thoa đều lên tóc. Lưu ý: Chỉ bôi dầu xả ở phần thân tóc đến ngọn tóc, hãy để dầu xả cách xa chân tóc từ 2- 3 cm.\u003c/p\u003e\n\u003cp\u003e→ Bước 3: Tiếp đến, massage tóc thật nhẹ nhàng từ 2 - 3 phút, giúp các dưỡng chất trong dầu xả thấm sâu vao tóc. Cuối cùng, bạn hãy xả sạch tóc với nước.\u003c/p\u003e\n\u003cp\u003eĐỐI TƯỢNG SỬ DỤNG:\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eNgười thường xuyên tạo kiểu tóc uốn, nhuộm, duỗi…\u003c/li\u003e\n\u003cli\u003eNgười gặp tình trạng rụng tóc nhiều, tóc mọc chậm, tóc mỏng và yếu.\u003c/li\u003e\n\u003cli\u003eNgười da đầu ngứa ngáy và nhiều gàu.\u003c/li\u003e\n\u003cli\u003eNgười sở hữu mái tóc bị hư tổn: khô xơ, dễ gãy rụng hoặc nhiều dầu, nhanh dính bết.\u003c/li\u003e\n\u003cli\u003eNgười mong muốn tìm được một loại dầu gội thiên nhiên, không chứa một hóa chất nào để thay thế cho dầu gội hóa chất hiện nay.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eLưu ý: Tránh sản phẩm vây vào mắt\u003c/p\u003e\n\u003cp\u003eHạn sử dụng: 3 năm kể từ ngày sản xuất, in trên chai. Mở nắp dùng trong 12 tháng.\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/da/a2/0b/4a2fbf6affdc500537e4d260f6ac9077.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/db/6a/1e/c1949ab9643c912562d15db57c168962.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/c6/02/dc/4cb65f805599dec0fca3c7b2ce2d57e7.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/0e/35/f8/7fb9f71b24d575ff15a657cbc94c7fde.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/3c/da/6b/b84f21407f50ee356162c606a0df017c.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/3c/da/6b/b84f21407f50ee356162c606a0df017c.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/3c/da/6b/b84f21407f50ee356162c606a0df017c.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3c/da/6b/b84f21407f50ee356162c606a0df017c.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3c/da/6b/b84f21407f50ee356162c606a0df017c.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/c6/02/dc/0af41a9eb119ee960fe76e5a13ef18ad.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c6/02/dc/0af41a9eb119ee960fe76e5a13ef18ad.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c6/02/dc/0af41a9eb119ee960fe76e5a13ef18ad.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c6/02/dc/0af41a9eb119ee960fe76e5a13ef18ad.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c6/02/dc/0af41a9eb119ee960fe76e5a13ef18ad.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/da/a2/0b/4c7