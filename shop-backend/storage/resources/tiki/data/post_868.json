,"text_color":"#FFF0F1","background_color":"#D93843","href":null,"text":"9.9"},{"placement":"pdp_badge","code":"is_hero","type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":true,"return_reason":"any_reason"}},"discount":366700,"discount_rate":22,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/69/03/8d/c0770652957123593d75b1c0fc05b61a.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":512,"all_time_quantity_sold":11,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003carticle class=\"4ever-article\"\u003e\n\u003cp\u003eĐèn đường Deco Solar All-in-One streetlight BRC050 LED40/ LED20/ LED10 ( có điều khiển từ xa/ không có điều khiển từ xa) tích hợp với pin lithium ferro phosphate với bộ điều khiển từ xa và bộ sạc tích hợp trong bộ đèn, cảm biển chuyển động để tối ưu hóa sự tự chủ của pin.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eĐiểm đặc biệt\u003c/p\u003e\n\u003cp\u003e• Đèn đường năng lượng mặt trời AIO dành cho khu vực ngoài trời rộng, nơi không thể hoặc khó kết nối điện\u003c/p\u003e\n\u003cp\u003e• Sử dụng dễ dàng\u003c/p\u003e\n\u003cp\u003e• Dễ dàng cài đặt và không cần cáp/đào rãnh\u003c/p\u003e\n\u003cp\u003eLý do chọn sản phẩm\u003c/p\u003e\n\u003cp\u003e• LED10 tương ứng đèn Halogen 100W\u003c/p\u003e\n\u003cp\u003e• LED20 tương ứng đèn Halogen 200W\u003c/p\u003e\n\u003cp\u003e• LED40 tương ứng đèn Halogen 400W\u003c/p\u003e\n\u003cp\u003e• Có thể điều khiển từ xa\u003c/p\u003e\n\u003cp\u003e• Pin và bảng điều khiển được tích hợp trong một bộ đèn duy nhất\u003c/p\u003e\n\u003cp\u003eThông số kỹ thuật chính\u003c/p\u003e\n\u003cp\u003e• Tuổi thọ: LED 15,000 giờ\u003c/p\u003e\n\u003cp\u003e• CRI \u0026gt;70\u003c/p\u003e\n\u003cp\u003e• Cảm biến chuyển động\u003c/p\u003e\n\u003cp\u003e• LiFePO4 Pin 3.2V, 5 Ah ; 3.2V, 8 Ah  \u0026amp; 3.2V, 15 Ah\u003c/p\u003e\n\u003cp\u003e• Công suất panel: 6W, 8W, \u0026amp; 12W\u003c/p\u003e\n\u003cp\u003e• IP65\u003c/p\u003e\n\u003cp\u003e• Màu ánh sáng: ánh sáng trắng\u003c/p\u003e\n\u003cp\u003ePhụ kiện đi kèm\u003c/p\u003e\n\u003cp\u003e• LED10/ LED20/ LED40: 01 bộ đèn, 01 bộ điều khiển từ xa\u003c/p\u003e\n\u003cp\u003e• LED10 KIT / LED20 KIT/ LED40 KIT: 01 bộ đèn, 01 giá đỡ linh hoạt, 01 bộ điều khiển từ xa\u003c/p\u003e\n\u003cp\u003e****Bật/Tắt đối với điều khiển:\u003c/p\u003e\n\u003cp\u003e• Chế độ bật (Bật) /chế độ ngủ (Tắt)— Bật bộ đèn với chế độ làm việc được sử dụng lần gần nhất. Đặt đèn dưới ánh sáng mặt trời đèn cũng sẽ bật, để tắt Đèn vào ban ngày, vui lòng sử dụng công tắc thủ công trên đèn.\u003c/p\u003e\n\u003cp\u003e• Tự động: Đèn sẽ phát hiện hoàng hôn và tự động BẬT ở cường độ 10%. Nếu phát hiện chuyển động, cường độ sẽ tăng lên 100% trong 18 giây\u003c/p\u003e\n\u003cp\u003e• Đầy đủ: Đèn sẽ phát hiện hoàng hôn và tự động BẬT ở cường độ 100% cho đến khi pin yếu\u003c/p\u003e\n\u003cp\u003e• Một phần: Đèn sẽ phát hiện hoàng hôn và tự động BẬT ở cường độ 20% cho đến khi pin yếu\u003c/p\u003e\n\u003cp\u003e• 2H: Đèn sẽ phát hiện hoàng hôn và tự động BẬT ở cường độ 30%. Nếu phát hiện chuyển động, cường độ sẽ tăng lên 100% trong 18 giây. Tắt khi pin yếu, chỉ định sau 2 giờ khi pin đầy.\u003c/p\u003e\n\u003cp\u003e• 4H: Đèn sẽ phát hiện hoàng hôn và tự động BẬT ở cường độ 20%. Nếu phát hiện chuyển động, cường độ sẽ tăng lên 100% trong 18 giây. Tắt khi pin yếu, chỉ định sau 4 giờ khi pin đầy.\u003c/p\u003e\n\u003cp\u003e• 6H: Đèn sẽ phát hiện hoàng hôn và tự động BẬT ở cường độ 10%. Nếu phát hiện chuyển động, cường độ sẽ tăng lên 100% trong 18 giây. Tắt khi pin yếu, chỉ định trong 6 giờ khi pin đầy.\u003c/p\u003e\n\u003cp\u003e• Điều chỉnh độ sáng: (Chế độ điều chỉnh độ sáng khi tắt cảm biến chuyển động) Đèn sẽ phát hiện hoàng hôn và tự động BẬT ở cường độ 40% trong 0,5 giờ đầu tiên, công suất 20% trong 3 giờ tiếp theo, công suất 10% cho đến khi pin yếu.\u003c/p\u003e\n\u003cp\u003e**Chú ý :\u003c/p\u003e\n\u003cp\u003e• Trước khi cài đặt, nhấn nút chuyển đổi cơ học trên đèn trong 2 giây để kích hoạt đèn, điều này sẽ chuyển đèn chiếu sáng khỏi chế độ ngủ và kích hoạt các chức năng từ xa\u003c/p\u003e\n\u003cp\u003e• Để buộc chế độ ngủ (giả sử cho mục đích lưu trữ), nhấn nút vật lý trong 2 giây.\u003c/p\u003e\n\u003cp\u003e• Chế độ làm việc mặc định của thiết bị là tự động\u003c/p\u003e\n\u003cp\u003e• Chỉ định LED trên đèn: màu đỏ (đang sạc), đèn màu xanh lá cây (cảm biến chuyển động hoạt động)\u003c/p\u003e\n\u003cp\u003e#Philips #PhilipslightingVietNam #Nangluongmattroi #Dencamco #Densanvuon #Denduong\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/2e/d2/8a/b9232d11be6d5227e7d516ba26199133.jpg\" alt=\"2ed28a96fab72deba0b2b2389c213a79.jpg\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/e1/df/c4/c6edf4bacc4b28e277006e6ee9208ca7.jpg\" alt=\"e1dfc4894b33b69c6ff404f9612d1675.jpg\" /\u003e\u003cimg src=\