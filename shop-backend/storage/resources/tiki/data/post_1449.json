racking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":20000,"discount_rate":4,"rating_average":5,"review_count":3,"review_text":"(3)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/media/catalog/product/7/7/7700159716144-002.u2683.d20160912.t135638.425746.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":0,"all_time_quantity_sold":74,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: medium; color: #008ab7;\"\u003e\u003cstrong\u003e\u003ciframe src=\"//www.youtube.com/embed/56ndEgi0udw\" width=\"750\" height=\"421\" allowfullscreen=\"allowfullscreen\"\u003e\u003c/iframe\u003e\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003eCách phân biệt Casio thật giả qua con tem Bitex\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: medium; color: #008ab7;\"\u003e\u003cstrong\u003eMáy Tính Casio GX-120B\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eMáy Tính Casio GX-120B\u003c/strong\u003e có thiết kế nhỏ gọn, dễ sử dụng, là dụng cụ hỗ trợ tính toán tiện dụng cho học sinh, sinh viên, nhân viên văn phòng và các cửa hàng kinh doanh. Sản phẩm có màn hình hiển thị lớn giúp bạn dễ dàng đọc dữ liệu. Vỏ máy được làm từ chất liệu nhựa và kim loại cao cấp, bảo vệ tốt máy khi rơi rớt, va đập.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Máy Tính Casio GX-120B\" src=\"http://tikicdn.com/media/catalog/product/7/7/7700159716144-002.u2683.d20160912.t135638.425746.jpg\" alt=\"Máy Tính Casio GX-120B\" width=\"450\" height=\"450\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eThông tin sản phẩm \u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e- Loại sản phẩm: Máy tính.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e- Thương hiệu: Casio.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e- Xuất xứ: Nhật Bản/Trung Quốc.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003e- Chất liệu:\u003c/strong\u003e Vỏ máy được làm từ chất liệu nhựa và kim loại cao cấp, bảo vệ tốt máy khi rơi rớt, va đập.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003e- Thiết kế: \u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e+ Kiểu dáng nhỏ gọn, dễ sử dụng, là dụng cụ hỗ trợ tính toán tiện dụng cho học sinh, sinh viên, nhân viên văn phòng và các cửa hàng kinh doanh.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e+ Màn hình hiển thị lớn giúp bạn dễ dàng đọc dữ liệu.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e+ Nguồn 2 chiều, năng lượng mặt trời được bật khi đủ sáng và chế độ pin được bật khi không đủ sáng.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e+ Ngoài khả năng tính toán cơ bản là cộng, trừ, nhân, chia, máy còn có chức năng tính phần trăm tỷ lệ thông thường, tính chi phí và lợi nhuận.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e+ Sản phẩm hỗ trợ bộ nhớ đệm, không bị mất dữ liệu khi nhập với tốc độ cao.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e+ Bàn phím dẻo, không bị phai màu khi sử dụng, dễ thao tác.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003e- Kích thước\u003c/strong\u003e: 16 x 3.5 x 21 cm.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003e- Thời hạn bảo hành\u003c/strong\u003e: 24 tháng.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003e- Điều Kiện Bảo Hành Miễn Phí Máy Tính Casio\u003c/strong\u003e:\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"text-decoration: underline;\"\u003ea. Đối với những model máy tính trong hộp:\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e+ Sản phẩm phải có phiếu bảo hành 2 năm. Trên thân máy và phiếu bảo hành có in số serial trùng nhau.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e+ Máy phải có tem chống hàng giả CASIO và máy do Công ty BITEX phân phối, tem dán phải còn nguyên vẹn, không bị tháo gỡ hoặc rách, tẩy xoá.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e+ Máy còn trong thời hạn bảo hành:\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cspan style=\"text-decoration: underline;\"\u003eTrường hợp máy còn tem chống hàng giả CASIO và \u003cstrong\u003ecòn phiếu bảo hành\u003c/strong\u003e\u003c/span\u003e: Thời gian bảo hành \u003cstrong\u003e24 tháng\u003c/strong\u003e kể từ ngày mua nhưng không quá \u003cstrong\u003e30 tháng\u003c/strong\u003e kể từ tháng được in trong số serial trên thân máy.\u003c/li\u003e\n\u003cli\u003e\u003cspan style=\"text-decoration: underline;\"\u003eTrường hợp máy còn tem chống hàng giả CASIO nhưng \u003cstrong\u003ekhông còn phiếu bảo hành\u003c/strong\u003e\u003c/span\u003e: Thời gian bảo hành \u003cstrong\u003e20 tháng\u003c/strong\u003e kể từ tháng được in trong số serial trên thân máy.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cem\u003e\u003cstrong\u003eLưu ý: Không bảo hành các bộ phận như vỏ máy hoặc phụ kiện kèm theo máy như pin, dây cáp.\u003c/strong\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"text-decoration: underline;\"\u003eb. Đối với những model máy tính trong vỉ nhựa:\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e+ Sản phẩm phải có phiếu bảo hành 2 năm. Trên phiếu bảo hành có thông tin đầy đủ (tên đại lý, ngày xuất bán …).\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e+ Máy phải có tem chống hàng giả CASIO và máy do Công ty BITEX phân phối, tem dán phải còn nguyên vẹn, không bị tháo gỡ hoặc rách, tẩy xoá.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e+ Thời hạn bảo hành: Bảo hành từ ngày xuất bán được ghi trong phiếu bảo hành.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e\u003cp\u003eSản phẩm này là tài sản cá nhân được bán bởi Nhà Bán Hàng Cá Nhân và không thuộc đối tượng phải chịu thuế GTGT. Do đó hoá đơn VAT không được cung cấp trong trường hợp này.\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/media/catalog/product/7/7/7700159716144-002.u2683.d20160912.t135638.425746.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/7/7/7700159716144-002.u2683.d20160912.t135638.425746.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/7/7/7700159716144-002.u2683.d20160912.t135638.425746.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/7/7/7700159716144-002.u2683.d20160912.t135638.425746.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/7/7/7700159716144-002.u2683.d20160912.t135638.425746.jpg"},{"base_url":"https://salt.tikicdn.com/media/catalog/product/7/7/7700159716144-003.u2683.d20160912.t135638.487007.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/7/7/7700159716144-003.u2683.d20160912.t135638.487007.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/