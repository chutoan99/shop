ext_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":450000,"discount_rate":13,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/db/4b/d7/e85f8720a69e4e44c94bc25253fdcc33.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":248,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003e* Lắp ráp và vận chuyển:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e+ Tại TP.HCM:\u003c/strong\u003e 100% freeship. SIB Decor giao tận nơi, lắp ráp hoàn thiện cho khách hàng tại TP.HCM từ 2-5 ngày (có giao thứ 7, chủ nhật).\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e+ Các tỉnh/Tp khác:\u003c/strong\u003e SIB Decor có giao trực tiếp tại Bình Dương, Đồng Nai và các khu vực lân cận. Vui lòng gửi tin nhắn CHAT để được tư vấn cụ thể.\u003c/p\u003e\n\u003cp\u003e- Vui lòng nhắn với SIB Decor qua kênh chat nếu bạn có nhu cầu hỗ trợ lắp đặt tận nơi tại TP.HCM (dịch vụ có thu phí)\u003c/p\u003e\n\u003cp\u003e- Nếu có lỗi/hư hỏng (kể cả do lỗi vận chuyển), SIB Decor cam kết gửi thay thế phần bị hỏng ngay khi nhận được yêu cầu.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e— — — — — — — — —\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThông số\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Màu sắc: Vân gỗ nâu #548\u003c/p\u003e\n\u003cp\u003e- Kích thước:\u003c/p\u003e\n\u003cp\u003e+ Tủ A: 40x35x190cm (Dài x Rộng x Cao)\u003c/p\u003e\n\u003cp\u003e+ Tủ B: 60x35x190cm (Dài x Rộng x Cao)\u003c/p\u003e\n\u003cp\u003e+ Tủ C: 80x35x190cm (Dài x Rộng x Cao)\u003c/p\u003e\n\u003cp\u003e- Chất liệu tốt: gỗ MDF lõi xanh chống ẩm, độ dày 17mm, bề mặt phủ melamine đồng màu, căng phẳng có khả năng kháng nước, hạn chế trầy xước, lau sạch dễ dàng.\u003c/p\u003e\n\u003cp\u003e- Sản xuất tại: Việt Nam.\u003c/p\u003e\n\u003cp\u003e- Sản phẩm được sản xuất tại: Công ty TNHH Trang Trí Nội Thất Đơn Giản Là Đẹp\u003c/p\u003e\n\u003cp\u003e- Địa chỉ: 2/4/2 Đông Hưng Thuận 10B, phường Đông Hưng Thuận, Quận 12, TP. Hồ Chí Minh.\u003c/p\u003e\n\u003cp\u003e- Thương hiệu: SIB Decor.\u003c/p\u003e\n\u003cp\u003e*Lưu ý: Sản phẩm không bao gồm đồ trang trí.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lpk8tih4msg290\" alt=\"vn-11134208-7r98o-lpk8tih4msg290\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e— — — — — — — — —\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e Điểm nổi bật\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Tủ gỗ được thiết kế đơn giản, chủ yếu tập trung vào hiệu năng và thẩm mỹ, giúp căn phòng vừa đẹp vừa gọn gàng, tiện lợi.\u003c/p\u003e\n\u003cp\u003e- Tủ lớn được phối thêm cửa kính/cửa gỗ hiện đại tùy theo lựa chọn, hệ ray bi 3 tầng của ngăn kéo êm ái dễ sử dụng.\u003c/p\u003e\n\u003cp\u003e- Với nhiều option lựa chọn, sản phẩm sẽ phù hợp đặt tại bất cứ đâu. Có thể tách lẻ hoặc mix với nhau tùy thích.\u003c/p\u003e\n\u003cp\u003e- Sản phẩm còn được kèm theo bộ phụ kiện Pát chống lật có tác dụng chống ngã đổ kệ/tủ, giữ an toàn trong quá trình sử dụng, đặc biệt với gia đình có trẻ nhỏ.\u003c/p\u003e\n\u003cp\u003e- Đặc biệt: chiều rộng lên đến 35cm sẽ cho bạn không gian rộng rãi để lưu trữ sách vở và các vật dụng trang trí.\u003c/p\u003e\n\u003cp\u003e- Có thể dễ dàng lắp ráp và tháo dời khi cần với hệ kết cấu ốc cam, chốt gỗ hiện đại (không phải dạng ke L, bắt vít, bắn đinh thiếu thẩm mỹ và chắc chắn).\u003c/p\u003e\n\u003cp\u003e- Sản phẩm được đóng gói cẩn trọng tránh nguy cơ lỗi do quá trình vận chuyển.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lpk8tih4r05e6f\" alt=\"vn-11134208-7r98o-lpk8tih4r05e6f\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lpk8tih4ttaa34\" alt=\"vn-11134208-7r98o-lpk8tih4ttaa34\" width=\"800\" height=\"800\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lpk8tih4plky6a\" alt=\"vn-11134208-7r98o-lpk8tih4plky6a\" width=\"800\" height=\"800\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lpk8tih4sepu56\" alt=\"vn-11134208-7r98o-lpk8tih4sepu56\" width=\"800\" height=\"800\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lpk8tih4v7uq87\" alt=\"vn-11134208-7r98o-lpk8tih4v7uq87\" width=\"800\" height=\"800\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lpk8tih4wmf616\" alt=\"vn-11134208-7r98o-lpk8tih4wmf616\" width=\"800\" height=\"800\" /\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e— — — — — — — — —\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cstrong\u003eMột số câu hỏi thường gặp\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cstrong\u003eKhi nào tôi nhận được hàng?\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Vận chuyển bởi nhà bán hàng: SIB Decor liên hệ xác nhận ngay sau khi nhận được đơn hàng. Thời gian giao hàng thường từ 0-5 ngày làm việc (có giao thứ 7, chủ nhật).\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Giao hàng tiết kiệm: Thông thường từ 1-5 ngày.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cstrong\u003eSản phẩm còn hàng không?\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Tất cả các sản phẩm đều có hàng sẵn, bạn có thể đặt hàng ngay.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cstrong\u003eCam kết với khách hàng?\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- SIB xử lý các sự cố (nếu có) luôn nhanh nhất và có lợi nhất cho khách hàng.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Bảo hành 1 đổi 1 trong vòng 7 ngày nếu sản phẩm hư hỏng do vận chuyển hoặc do lỗi sản xuất.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Bảo hành chất lượng sản phẩm 24 tháng, bảo trì và chăm sóc trọn đời sản phẩm.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e— — — — — — — — —\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cstrong\u003e Hướng dẫn\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Khi cần làm sạch, chỉ cần dùng khăn ẩm và lau nhẹ (bề mặt phủ melamine có khả năng chống trầy xước, bền màu nên rất dễ làm sạch).\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Hạn chế để nơi có ánh nắng chiếu trực tiếp, nơi ẩm ướt.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e— — — — — — — — —\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cstrong\u003eWelcome to SIB Decor \u0026lt;3\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eChúng tôi phục vụ bạn bằng sự trung thực, luôn sẵn sàng hỗ trợ bạn bất cứ lúc nào. Nếu bạn có bất kỳ câu hỏi nào về việc lắp đặt hoặc bảo hành sản phẩm, vui lòng liên hệ với chúng tôi.\u003c/p\u003e\n\u003cp\u003eHy vọng sản phẩm của SIB Decor sẽ mang lại nhiều hạnh phúc hơn cho cuộc sống của bạn.\u003c/p\u003e\n\u003cp\u003e#sibdecor #sib #decor #tu #tubep #tudanang #ke #kego #kedanang #woods #cabinet #kitchencabinets #woodcabinets #tugo #tugodanang #tủ_gỗ #tutrungbay #decoration #tủ_trưng_bày #tukinh\u003c/p\u003e\n\u003cp\u003e- Hạn chế để nơi có ánh nắng chiếu trực tiếp, nơi ẩm ướt.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e— — — — — — — — —\u003c/p\u003e\n\u003cp\u003eWelcome to SIB Decor \u0026lt;3\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eChúng tôi phục vụ bạn bằng sự trung thực, luôn sẵn sàng hỗ trợ bạn bất cứ lúc nào. Nếu bạn có bất kỳ câu hỏi nào về việc lắp đặt hoặc bảo hành sản phẩm, v