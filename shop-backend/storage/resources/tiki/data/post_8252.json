":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/f9/26/16/593c4126af685d1dd56bca6add64c07d.jpeg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1734,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cdiv\u003e\n\u003cdiv\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/64/60/8e/196a8522741fe78658ca4913139cab37.jpg\" width=\"750\" height=\"562\" /\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv\u003e\n\u003cp\u003eNồi cơm điện tử Panasonic kiểu dáng mềm mại, màu trắng trang nhã, đẹp mắt trong không gian bếp hiện đại\u003c/p\u003e\n\u003cdiv\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/9a/87/b9/e861e7b064ff6d54546cd3b761081d14.jpg\" width=\"750\" height=\"499\" /\u003e\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv\u003eDung tích 1.8 lít phục vụ cho gia đình 4 – 6 người\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv style=\"text-align: justify;\"\u003e\n\u003cdiv\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/d4/2f/8d/679d88b62fd3b365bbf958d5c397b0b2.jpg\" width=\"750\" height=\"451\" /\u003e\u003c/div\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eLòng nồi hợp kim nhôm tráng men chống dính  dày 2.2 mm nấu cơm ngon, chống móp méo tốt, giữ nhiệt lâu, lớp chống dính Ceramic cao cấp, nấu an toàn, dễ vệ sinh\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cdiv\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/2d/8c/10/7472eceeae1445fbd6314de536b88f53.jpg\" width=\"750\" height=\"499\" /\u003e\u003c/div\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eNồi cơm điện nấu cơm chín đều và ngon, tăng thời gian giữ ấm với công nghệ nấu 3D, cấu tạo 1 mâm nhiệt đáy nồi + điện trở quanh thân nồi và từ nắp nồi\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cdiv\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/product/60/46/f3/9e0b443e08f970628869daa3693a4558.jpg\" width=\"730\" height=\"486\" /\u003e\u003c/div\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eBảng điều khiển cảm ứng có màn hình hiển thị dễ dùng\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eNồi đa chức năng nấu với 16 chế độ nấu được cài đặt sẵn, làm phong phú bữa ăn gia đình.Nấu cơm,nấu cháo, lẩu, hâm nóng,làm bánh… trở nên thật đơn giản.\u003c/p\u003e\n\u003cp\u003eChế độ hẹn giờ nấu hữu ích khi bận rộn, giúp cơm chín đúng thời điểm, nóng hổi thơm ngon sẵn sàng cho gia đình thưởng thức.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cdiv\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/5e/37/8d/0530081ef899041a4ce20bcff9058448.jpg\" width=\"750\" height=\"499\" /\u003e\u003c/div\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003eVan thoát hơi thông minh bảo toàn vitamin sẵn có trong gạo, cơm ngon giàu dinh dưỡng hơn\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cdiv\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/53/31/75/fda279c7f1459a9fcf0a5bf34aa32365.jpg\" width=\"750\" height=\"499\" /\u003e\u003c/div\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eNắp trong tổ ong hạn chế đọng hơi nước, giữ cơm lâu hư, có thể tháo rời lau chùi\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cdiv\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/97/ed/fc/246f489424704bad3865edc1565f5f4c.jpg\" width=\"750\" height=\"499\" /\u003e\u003c/div\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eXửng hấp đi kèm cho các món hấp đơn giản như xôi, bánh bao, rau củ thêm dễ làm\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cdiv\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/49/ce/2d/a3ac68e9288f4402699efd43b1989586.jpg\" width=\"750\" height=\"499\" /\u003e\u003c/div\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eNồi cơm điện tử Panasonic 1.8 lít SR-CL188WRAnồi đẹp chất lượng cao, gia tăng hiệu quả phục vụ bữa ăn tại gia đình.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cstrong\u003eTHÔNG SỐ KỸ THUẬT \u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cstrong\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/b3/fb/51/4992fd6b966bcb3628b10d28a4e899ec.png\" alt=\"\" width=\"750\" height=\"290\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e \u003c/p\u003e\n\u003cstrong\u003eTHÔNG TIN THƯƠNG HIỆU \u003cbr /\u003e\u003c/strong\u003ePanasonic thành lập năm 1918 bởi Konosuke Matsushita với khẩu hiệu \"A better life, a better world\" cam kết mang đến cho khách hàng một cuộc sống hiện đại và tốt đẹp hơn. Trong suốt quá trình phát triển, Panasonic từng bước khẳng định thương hiệu qua các sản phẩm được ưa chuộng trên khắp thế giới: lò vi sóng, tivi, máy giặt, tủ lạnh, điều hoà, máy lọc không khí, thiết bị hỗ trợ sức khoẻ và làm đẹp, điện thoại bàn, \u003cstrong\u003e\u003cbr /\u003e\u003c/strong\u003e\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/f9/26/16/593c4126af685d1dd56bca6add64c07d.jpeg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f9/26/16/593c4126af685d1dd56bca6add64c07d.jpeg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f9/26/16/593c4126af685d1dd56bca6add64c07d.jpeg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f9/26/16/593c4126af685d1dd56bca6add64c07d.jpeg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f9/26/16/593c4126af685d1dd56bca6add64c07d.jpeg"},{"base_url":"https://salt.tikicdn.com/ts/product/0a/cf/13/fdc71208091fa184eda7702f38d3bc30.jpeg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0a/cf/13/fdc71208091fa184eda7702f38d3bc30.jpeg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/0a/cf/13/fdc71208091fa184eda7702f38d3bc30.jpeg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0a/cf/13/fdc71208091fa184eda7702f38d3bc30.jpeg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0a/cf/13/fdc71208091fa184eda7702f38d3bc30.jpeg"},{"base_url":"https://salt.tikicdn.com/ts/product/1b/3b/a6/0435b56f0b50037fd417dfda111cbf23.jpeg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/1b/3b/a6/0435b56f0b50037fd417dfda111cbf23.jpe