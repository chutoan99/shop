,"is_hero":false,"return_reason":"any_reason"}},"discount":661000,"discount_rate":29,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/3a/3c/6d/fc7696078c1762eebd4047ad9d85b945.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":804,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch1 style=\"text-align:center;\"\u003eXe lăn tay cơ bản cho người già, Nhiều mẫu lựa chọn - Hàng chính hãng NIKITA \u003c/h1\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e- Khi chăm sóc cho người già, người bệnh thì một chiếc xe lăn là vật dụng hoàn toàn cần thiết. Tùy theo nhu cầu sử dụng mà ta có thể lựa chọn các mẫu xe lăn khác nhau, Ví dụ người cần chăm sóc mỗi ngày chỉ cần đẩy ra ngoài để phơi nắng hít thờ không khí trong lành vào buổi sáng thì chỉ cần một chiếc xe lăn cơ bản là đã đủ để đáp ứng tốt, tuy nhiên với người bệnh cần ngồi xe lăn thường xuyên thì một chiếc xe lăn đa chức năng có đệm ngồi êm ái, có thể ngã lưng thành giường, có tích hợp bô vệ sinh trên xe là hoàn toàn cần thiết\u003c/p\u003e\n\u003cp\u003e-- Vì vậy Shop đã nhập về nhiều mẫu xe lăn khác nhau để quý khách có thể lựa chọn mẫu phù hợp nhất với nhu cầu sử dụng, và gu thẩm mỹ riêng.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e+ N213-1D\u003c/p\u003e\n\u003cp\u003e-- là mẫu xe lăn có đệm ngồi êm ái, có thể ngã lưng 5 cấp độ tối đa có thể ngã thành giường, có kèm bô vệ sinh tại chổ tiện dụng.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/16/a0/3c/45716b519c26992ca05accb2dbb68994.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/12/6c/0a/51638e5cf9e12a0982f6e20a88609a4b.png\" alt=\"\" width=\"750\" height=\"752\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/8c/11/99/07dc33ef4c78010d88076eff843f002e.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e- N213-3D\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e+ Là mẫu xe lăn kèm đệm ngồi êm ái, có kèm bô vệ sinh tại chổ, tuy nhiên lại không có chức năng ngã lưng\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/40/f3/c9/702cb4cb07a2f067f6d88c5997f2a262.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ce/ac/ab/68c7089c85baf3afed9036cb28da2b58.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e-S213-5CR\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e+ Là mẫu xe lăn cơ bản không được tích hợp bô vệ sinh hoặc chức năng ngã lưng, nhưng vẫn có đệm ngồi êm ái\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/db/5a/0c/04f1c2c1e13e2bb8d965241321d9fe10.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/77/43/b0/f55a71d19527123eea12348ca10e51fd.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e- S213-3+D\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e+ Là mẫu xe lăn có đệm, kèm bô vệ sinh, còn có thêm 2 miêng lót tựa lưng và lót đệm ngồi tổ Ong thoáng khí, có thể tháo rời ra để vệ sinh làm sạch khi cần, đặc biệt thiết kế các lỗ tổ Ong thoáng khí nên rất nhanh khô sau khi giặt sạch\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/70/b9/a5/ba1c30cbc1128f77cee9dbaa943bba9b.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/1f/99/5f/eec65d65334589cf6c069a24ac1bfc7d.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e- S213-2\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e+ Là mẫu xe lăn cơ bản nhất, không kèm bô vệ sinh, không đệm, cũng không ngã lưng, mẫu này nhằm phục vụ cho những người có nhu cầu sử dụng xe lăn ít\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/cd/49/6e/5f580ee47d290acde248e17bf07dd3b7.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/6d/7c/87/8818253fa53b1809c4936f34ccf26f52.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/pro