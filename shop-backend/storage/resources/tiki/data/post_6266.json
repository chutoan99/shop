_average":3,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/9c/f2/e6/401a1e79c90335cfaf36a3361a21251d.JPG","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1449,"all_time_quantity_sold":3,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eMáy massage cột sống, cổ và lưng X928 - Hàng Chính Hãng\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003ciframe src=\"//www.youtube.com/embed/XX4-PYtKYAc\" width=\"560\" height=\"314\" allowfullscreen=\"allowfullscreen\"\u003e\u003c/iframe\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/9c/f2/e6/68c7029d770c1ae21ca4e72ddd7c075a.JPG\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eHiện nay, nhu cầu sử dụng  ngày càng trở nên phổ biến. Chúng đóng vai trò quan trọng trong cuộc sống của con người. Một chiếc gối chất lượng không chỉ đem đến cảm giác thoải mái mà còn có tác dụng trong việc chăm sóc sức khỏe\u003c/p\u003e\n\u003cp\u003eSản phẩm massage được nhiều vị trí trên cơ thể như : Cổ, Vai, Lưng dưới, bắp chân, khủy tay, bụng… có thể sử dụng ở bất cứ đâu dù là : Ở nhà, hay văn phòng, xe hơi…\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/d6/9e/92/d32b8b7dd8928e4df6ce16de06f9b4f5.jpg\" alt=\"\" width=\"750\" height=\"1246\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003eThiết kế tựa lưng với đường cong hình chữ S tạo tư thế thoải mái khi massage, bo sát vùng lưng dưới, giúp người dùng trải nghiệm tốt hơn so với đời gối cũ.\u003cbr /\u003eThiết kế massage 3 vùng trên phần lưng thư giãn : Đốt sống trên, Đốt sống dưới, Vùng thắt lưng.\u003cbr /\u003eBa mức độ massage, rung xoa bóp giúp phù hợp hơn với hầu hết mọi lứa tuổi.\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/7b/97/e2/9ae60508839417f0affcdf3b87440403.JPG\" alt=\"\" width=\"610\" height=\"714\" /\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/f2/d3/75/1186300f3dc75d4cd99fcedc1070b6f2.JPG\" alt=\"\" width=\"750\" height=\"746\" /\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003eKích thước: 49x38x17cm\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003eSáu phím bấm bên hông gối, dễ dàng lựa chọn chế độ phù hợp khi sử dụng\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ac/eb/4a/96e4a7d18f426d608d3d4d325b14221d.JPG\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003eChất liệu vải thông thoáng, bao gồm Lưới tổ ong, bề mặt mịn giúp thoáng khí khi sử dụng. Độ đàn hồi cao tránh cho sản phẩm bị biến dạng khi sử dụng thường xuyên\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/e2/a6/73/d2394f84711e02f3e6681701786a22b8.jpg\" alt=\"\" width=\"750\" height=\"1301\" /\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/9c/f2/e6/401a1e79c90335cfaf36a3361a21251d.JPG","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/9c/f2/e6/401a1e79c90335cfaf36a3361a21251d.JPG","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product