tude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.5,"review_count":37,"review_text":"(37)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/9e/69/bb/e5cf476b21d027bb33d893d575bdec12.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1579,"all_time_quantity_sold":207,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/e5/32/77/53b93e3165804ff11e61dfc9c4109186.jpg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/e5/32/77/53b93e3165804ff11e61dfc9c4109186.jpg\" alt=\"\" width=\"750\" height=\"1822\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/d3/9d/59/a18d99c52b0d54e1d0cf984199049005.jpg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/d3/9d/59/a18d99c52b0d54e1d0cf984199049005.jpg\" alt=\"\" width=\"750\" height=\"2100\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/b4/17/a3/9e8072a37441102fb1f18f1d0c52d364.jpg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/b4/17/a3/9e8072a37441102fb1f18f1d0c52d364.jpg\" alt=\"\" width=\"750\" height=\"1363\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eBạn cần thêm không gian để sắp xếp chúng?\u003c/p\u003e\n\u003cp\u003eHãy sử dụng sản phẩm của chúng tôi!!!\u003c/p\u003e\n\u003cp\u003eHộp lưu trữ ngăn chuyên dụng làm bằng chất liệu coplan siêu bền và linh hoạt, rất tiện dụng\u003c/p\u003e\n\u003cp\u003eCùng khám phá chiêc hộp Curve living box có những đường cong mềm mại\u003c/p\u003e\n\u003cp\u003eChất liệu Coplan\u003c/p\u003e\n\u003cp\u003eXuất xứ Korea\u003c/p\u003e\n\u003cp\u003eThiết kế bởi OLIVING\u003c/p\u003e\n\u003cp\u003eĐặc biệt: Xám, Xám đậm\u003c/p\u003e\n\u003cp\u003eSize 2: 42L\u003c/p\u003e\n\u003cp\u003eKích thược bao gồm nắp : Rộng 60cm x dài 42cm x Cao 23.6cm\u003c/p\u003e\n\u003cp\u003eKích thước riêng phần thân : Rộng 49cm x Dài 31cm x Cao 23cm\u003c/p\u003e\n\u003cp\u003eLưu ý\u003c/p\u003e\n\u003cp\u003eBạn có thể không thể trả lại đơn hàng khi bạn đặt đơn hàng lớn\u003c/p\u003e\n\u003cp\u003eTrước khi đặt Đơn hàng lớn vui lòng mua mẫu trước để kiểm tra\u003c/p\u003e\n\u003cp\u003eVui lòng kiểm tra khi mua sản phẩm\u003c/p\u003e\n\u003cp\u003eKhi giao hàng, chúng tôi tháo nắp, thân và cài, bạn cần phải lắp chúng lại\u003c/p\u003e\n\u003cp\u003eSản phẩm có thể sẽ bị thay đổi hình dáng và cong lại khi đậy nắp\u003c/p\u003e\n\u003cp\u003eTrong trường hợp này, bạn đặt quyển sách hoặc chèn đồ dùng nặng lên nắp, có thể tiếp tục dùng như bình thường\u003c/p\u003e\n\u003cp\u003eKhông được hoàn lại hoặc hoàn tiền cho trường hợp này, vui lòng cân nhắc khi mua hàng\u003c/p\u003e\n\u003cp\u003eKhi giao hàng do sản phẩm có thể bị va đập, Hộp đựng có thể thay đổi màu trắng hoặc bị trầy\u003c/p\u003e\n\u003cp\u003eTuy nhiên, do chất liệu sản phẩm làm từ Coplan nên không gẫy và có tính đàn hồi\u003c/p\u003e\n\u003cp\u003eNếu có nhiều Đơn hàng LivingBox, Chúng tôi sẽ gửi từng đơn 1 ( Để biết chi tiết vui lòng kiểm tra Lưu ý)\u003c/p\u003e\n\u003cp\u003eDot Livingbox có nắp và rất hữu ích trong việc cất giữ sản phẩm thường dùng và những vật nặng\u003c/p\u003e\n\u003cp\u003eTip mua hàng\u003c/p\u003e\n\u003cp\u003e- Màu sắc có thể khác nhau tùy thuộc vào màn hình và môi trường.\u003c/p\u003e\n\u003cp\u003e- Sản phẩm có thể chênh lệch khoản 1-2cm\u003c/p\u003e\n\u003cp\u003e- Kích thước sản phẩm được đo theo chiều dài lớn nhất\u003c/p\u003e\n\u003cp\u003e- Tất cả các thùng đều là thùng rỗng, không chia ngăn\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/9e/69/bb/e5cf476b21d027bb33d893d575bdec12.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/9e/69/bb/e5cf476b21d027bb33d893d575bdec12.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/9e/69/bb/e5cf476b21d027bb33d893d575bdec12.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9e/69/bb/e5cf476b21d027bb33d893d575bdec12.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9e/69/bb/e5cf476b21d027bb33d893d575bdec12.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/b3/d6/9a/f2df62fe9a2f2388a4d5b6093e97a8de.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b3/d6/9a/f2df62fe9a2f2388a4d5b6093e97a8de.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b3/d6/9a/f2df62fe9a2f2388a4d5b6093e97a8de.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b3/d6/9a/f2df62fe9a2f2388a4d5b6093e97a8de.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b3/d6/9a/f2df62fe9a2f2388a4d5b6093e97a8de.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/83/03/ab/2ee60e208abe0a9bd607f98e9a07582e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/83/03/ab/2ee60e208abe0a9bd607f98e9a07582e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/83/03/ab/2ee60e208abe0a9bd60