":4.8,"review_count":10,"review_text":"(10)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/61/7a/39/cbb6cab5b01c84545d9e41b86841088d.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":879,"all_time_quantity_sold":40,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align:center;\"\u003e\u003cstrong\u003eLoa Vi Tính SoundMax A-828 2.1 20W - Hàng Chính Hãng\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cstrong\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/b7/3f/d9/fdc71f2d1f2bbd3cad96a2cd06838bd5.jpg\" alt=\"\" width=\"750\" height=\"750\"\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e-SoundMax A-828 là mẫu loa 2.1 nhỏ gọn nhưng “võ nghệ” thì không hề thiếu, loa hỗ trợ chơi nhạc từ hầu hết các nguồn phát phổ thông hiện nay như điện thoại, máy tính, laptop, đầu CD/DVD, Loa hỗ trợ kết nối không dây Bluetooth chuẩn 5.0, chơi nhạc bằng USB, thẻ nhớ (hỗ trợ đến 128GB) và dĩ nhiên không thể thiếu các kết nối có dây cơ bản như AUX.\u003c/p\u003e\n\u003cp\u003e-SoundMax A-828 mang thiết kế góc cạnh, hiện đại tựa như đàn anh SoundMax A-828 của mình, 2 loa vệ tinh được bọc lưới vừa chống bụi vừa tạo nên vẻ thanh lịch, đẹp mắt khi đứng bên cạnh màn hình máy tính, trên tủ TV hoặc trên quầy pha chế ở các quán cà phê nhỏ. Về loa siêu trầm thì màng loa được đặt ngay ở mặt dưới của loa, mặt trước được bố trí các nút chức năng như chuyển bài, tạm dừng và chuyển đổi chế độ phát (M), cổng USB Type A, khe đọc thẻ nhớ SD nằm ở mặt trên loa. Nút điều chỉnh âm lượng tổng, Bass, Treble được đặt ở mặt trước của loa. Ngoài ra, sản phẩm còn có remote đi kèm tạo sự thuận tiện cho người dùng.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e*Thông số kỹ thuật:\u003c/p\u003e\n\u003ctable\u003e\u003ctbody\u003e\u003ctr\u003e\u003ctd\u003eTên sản phẩm\u003c/td\u003e\n\u003ctd\u003eA-828\u003c/td\u003e\n\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003eHệ thống loa\u003c/td\u003e\n\u003ctd\u003e2.1 kênh, thùng loa màu đen\u003c/td\u003e\n\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003eCấu hình\u003c/td\u003e\n\u003ctd\u003e2 loa vệ tinh, 1 loa siêu trầm (Subwoofer)\u003c/td\u003e\n\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003eChống nhiễm từ\u003c/td\u003e\n\u003ctd\u003ecó\u003c/td\u003e\n\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003eTín hiệu ngõ vào\u003c/td\u003e\n\u003ctd\u003eJack RCA. Hỗ trợ USB/SD Card 128GB, Bluetooth 5.0.\u003c/td\u003e\n\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003eTín hiệu ngõ ra\u003c/td\u003e\n\u003ctd\u003ePush Terminal\u003c/td\u003e\n\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003eTương thích ngõ vào 2.1/5.1\u003c/td\u003e\n\u003ctd\u003e2.1\u003c/td\u003e\n\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003eĐiều chỉnh âm thanh\u003c/td\u003e\n\u003ctd\u003eVolume, Bass,Treble,\u003c/td\u003e\n\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003eTổng công suất\u003c/td\u003e\n\u003ctd\u003e20W (RMS)\u003c/td\u003e\n\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003eĐáp ứng tần số\u003c/td\u003e\n\u003ctd\u003e20Hz - 20KHz\u003c/td\u003e\n\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003eMàu loa\u003c/td\u003e\n\u003ctd\u003eMàu Đen\u003c/td\u003e\n\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003eĐiều khiển từ xa\u003c/td\u003e\n\u003ctd\u003eCó\u003c/td\u003e\n\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003eKích thước Loa siêu trầm: (WxDxH,mm)\u003c/td\u003e\n\u003ctd\u003e\n\u003cp\u003e138 x 252 x 200 mm\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003e Kích thước Loa vệ tinh:(WxDxH,mm)\u003c/td\u003e\n\u003ctd\u003e\n\u003cp\u003e90 x 90 x 130 mm\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003eNguồn\u003c/td\u003e\n\u003ctd\u003e220V - 50Hz\u003c/td\u003e\n\