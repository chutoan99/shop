avourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/12/0f/2f/5d43cf43511ac86d8ffdd8a40d58d638.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2162,"all_time_quantity_sold":5,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eNhững nhà lãnh đạo giỏi nhất được sinh ra, không phải do rèn luyện. Những nhà lãnh đạo giỏi nhất luôn biết kiểm soát. Những nhà lãnh đạo giỏi nhất là những người có IQ cao nhất. Điều đó có đúng hay không?\u003c/p\u003e\n\u003cp\u003eCách suy nghĩ xoay quanh việc những gì tạo ra các nhà lãnh đạo vĩ đại nhất ngày càng trở nên lộn xộn bởi các định kiến, những lời hứa hẹn mang tính chất viển vông và giả khoa học. Những nhà lãnh đạo giỏi nhất dựa trên dữ kiện, chứ không phải những sở thích kỳ quặc. Cuốn Những ảo tưởng lãnh đạo thổi tung mớ bùi nhùi đó và đối mặt trực tiếp với các ảo tưởng sai lạc. Jo Owen sử dụng những nghiên cứu đáng tin cậy nhất để phân tích mỗi ảo tưởng, sử dụng các nghiên cứu tình huống kinh doanh quốc tế, lý thuyết về lãnh đạo và những cuộc phỏng vấn đầy kịch tính để phát hiện sự thật.\u003c/p\u003e\n\u003cp\u003eĐây là một sự tìm hiểu hấp dẫn và mang tính thực tế cao về những ý tưởng sai lạc lan rộng về lãnh đạo, điều sẽ giúp bạn đánh giá chính xác những năng lực lãnh đạo của bạn, tạo cảm hứng cho đội nhóm của bạn và trao quyền cho tổ chức của bạn nhờ tư duy khác biệt.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"