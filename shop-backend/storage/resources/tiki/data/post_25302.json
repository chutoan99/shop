"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":70000,"discount_rate":28,"rating_average":4.7,"review_count":22,"review_text":"(22)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/83/52/88/8073abc555e73550f1ea6f96794ffa44.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":799,"all_time_quantity_sold":108,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cdiv class=\"title_module_main heading-bar d-flex justify-content-between align-items-center\"\u003e\n\u003ch2 class=\"heading-bar__title\"\u003eĐẶC ĐIỂM NỔI BẬT\u003c/h2\u003e\n\u003c/div\u003e\n\u003cdiv class=\"rte js-product-getcontent product_getcontent pos-relative\"\u003e\n\u003cdiv class=\"content js-content\"\u003e\n\u003ch2\u003eGiới Thiệu Sản Phẩm Cáp Sạc nhanh Tự Ngắt Gen2 Baseus Explorer Series cho iPhone/ iPad (Type C to IP Auto Power-Off, PD 20W Fast Charging Data Cable )\u003c/h2\u003e\n\u003cp\u003eLà phiên bản Gen2 của dòng sản phẩm \u003cstrong\u003ecáp sạc tự ngắt cho iPhone\u003c/strong\u003e , Baseus Explorer Series mang đến nhiều cải tiến và nâng cấp đáng giá về thiết kế, vật liệu củng như tính năng và độ tương thích . Nhờ cơ chế bảo vệ và tự ngắt thông minh khi sạc đầy \u003cstrong\u003eCáp sạc tự ngắt Gen2 Baseus Explorer Series\u003c/strong\u003e thật sự là một phụ kiện hữu ích giúp cho bạn có thể thoải mái cắm sạc iPhone qua đêm mà không lo ảnh hưởng đến tuổi thọ pin, không làm chay pin . \u003c/p\u003e\n\u003cp class=\"youtube-embed-wrapper\"\u003e \u003c/p\u003e\n\u003ch2\u003eTính năng cơ bản Cáp Sạc nhanh Tự Ngắt Gen2 Baseus Explorer Series cho iPhone/ iPad (Type C to IP Auto Power-Off, PD 20W Fast Charging Data Cable )\u003c/h2\u003e\n\u003cp\u003e-\u003cstrong\u003e \u003c/strong\u003eBaseus đã mang chuẩn kết nối sạc nhanh C to IP lên dòng cáp sạc tự ngắt thế hệ mới của hãng. Phiên bản Gen2 này tương thích hoàn toàn với chuẩn sạc nhanh Power Delivery (PD 20W) trên các dòng iPhone thế hệ mới như iPhone 13/ 12 Series ... (đồng thời củng tương thích tốt với chuẩn PD 18W trên các dòng iPhone 8/ iPhone X/XS Max/ iPhone 11 Series) . \u003c/p\u003e\n\u003cp\u003e- Sản phẩm được trang bị chip quản lý nguồn thế hệ mới với khả năng tự động nhận diện thiết bị, tình trạng pin trên iPhone để có thể điều chỉnh dòng sạc và công suất sạc phù hợp với từng giai đoạn của quá trình sạc pin trên iPhone. Đặc biệt cáp sạc sẽ tự động ngắt hoàn toàn dòng sạc khi sạc đầy . Tính năng này giúp chống chay pin , phù pin , tối ưu tuổi thọ pin của thiết bị . \u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cem\u003eCụ thể : sau khi pin sạc đạt 90% dung lượng chip xử lý sẽ điều chỉnh giảm dần công suất và dòng sạc cho đến khi iPhone được sảc đầy chip xử lý sẽ ngắt hoàn dòng sạc. \u003c/em\u003e\u003c/li\u003e\n\u003cli\u003e\u003cem\u003eSelf-Detection : Sau khoảng 2 giờ kể từ khi ngắt hoàn toàn dòng sạc , Cáp sạc Baseus Explorer Series sẽ tự động kết nối sạc lại . \u003c/em\u003e\u003c/li\u003e\n\u003cli\u003e\u003cem\u003eTính năng này để đảm bảo bạn luôn có 1 chiếc iPhone đầy pin vào sáng hôm sau . Đặc biệt hữu ích với những bạn có thói quen sạc Pin iPhone qua đêm . \u003c/em\u003e\u003cbr /\u003e \u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e- Cáp Sạc Type C to IP Baseus Explorer Series có thiết kế hoàn toàn mới, sang trọng và hiện đại hơn . Đầu cáp trong suốt có thể nhìn được hoàn toàn linh kiện và đèn LED báo hiệu bên trong. Thiết kế này làm tăng tính hiện đại của sản phẩm , tạo cảm giác mới mẻ và lý thú khi sử dụng.\u003c/p\u003e\n\u003cp\u003e- Đầu cáp với chất liệu hợp kim cao cấp siêu bền , đầu cáp và các tiếp điểm được thiết kế lại để đảm bảo bền hơn, chống gảy tốt, tiếp xúc tốt hơn và tương thích tốt hơn với iPhone . Dây cáp được bọc vải dù siêu bền cho tuổi thọ sử dụng lâu hơn.\u003c/p\u003e\n\u003ch2\u003eHình Ảnh Chi Tiết Sản Phẩm Cáp Sạc nhanh Tự Ngắt Gen2 Baseus Explorer Series cho iPhone/ iPad (Type C to IP Auto Power-Off, PD 20W Fast Charging Data Cable )\u003c/h2\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/59/9f/e9/9ca22e4e601f48598ad63acca1f65292.jpg\" alt=\"970x600_b6472eb05f0c4b2fa285414668f3b24c.jpg\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/f4/0e/dc/b3b67dbaa137ce591e9a3f71948ff9e1.jpg\" alt=\"0_01_40e9052dd9994e40946ce36af7edcfad.jpg\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/33/25/9e/8b1264661e83aecec3e28785a313de61.jpg\" alt=\"0_02_740ed9981f624bf5b39c534f75423713.jpg\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/83/d0/f6/b70d363fe32e29e90cc91039a1b24ad3.jpg\" alt=\"0_03_d3a6d86da9b44bca90dc786632283611.jpg\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/7c/b2/75/4d21454fcaee95148d437628c50892b4.jpg\" alt=\"0_04_6aa64a8a86dc4605879526d193e01a12.jpg\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/f1/a4/57/9e603462a46afc492082c5886a023254.jpg\" alt=\"0_05_72b573831a0e4542975c34f07b6af0cb.jpg\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003