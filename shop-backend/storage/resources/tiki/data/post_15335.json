com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":4000,"discount_rate":3,"rating_average":4.7,"review_count":432,"review_text":"(432)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/f7/68/16/0746bf059dd5a42128126d3aa2ac5640.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1576,"all_time_quantity_sold":2285,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: center;\"\u003e\u003cstrong\u003eTrà Tâm Sen (Tim Sen) Sấy Khô DK Harvest\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTrà tâm sen\u003c/strong\u003e là sản phẩm hoàn toàn từ thiên nhiên, là một loại trà thảo dược được nhiều người sử dụng trong việc chăm sóc sức khỏe, đặc biệt sử dụng trà tâm sen giúp bạn có một giấc ngủ ngon, sâu giấc hơn\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTrà tâm sen\u003c/strong\u003e hay còn được gọi với cái tên khác là trà tim sen, đây là phần mầm của cây được nằm bên trong hạt sen, có màu xanh, ngắn và được sấy khô để làm trà. Trà tâm sen được nhiều người biết đến với khả năng giúp người sử dụng an thần, điều trị chứng mất ngủ. Là sản phẩm có nguồn gốc \u003cstrong\u003e100% từ thiên nhiên\u003c/strong\u003e và rất tốt cho sức khỏe. \u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/aa/a5/8e/35ab192e888b9c4801b8f017be49fb00.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003eTrà Tâm Sen DK Harvest\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThành phần của trà tâm sen\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eThành phần: \u003cstrong\u003e100% tâm sen sấy khô\u003c/strong\u003e\u003c/li\u003e\n\u003cli\u003eNguồn gốc: \u003cstrong\u003eViệt Nam\u003c/strong\u003e\u003c/li\u003e\n\u003cli\u003eCông dụng: \u003cstrong\u003eGiúp ngủ ngon giấc, thanh nhiệt, tinh thần sảng khoái\u003c/strong\u003e\u003c/li\u003e\n\u003cli\u003eMùi vị: \u003cstrong\u003eMùi thơm, tính mát, dễ uống\u003c/strong\u003e\u003c/li\u003e\n\u003cli\u003eĐóng gói hũ nhựa 200g\u003c/li\u003e\n\u003cli\u003eBảo quản: Nơi thoáng mát, khô giáo\u003c/li\u003e\n\u003cli\u003eHạn sử dụng: Được in trực tiếp trên bao bì\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/98/d1/7a/bb55df9ea4857af18e215a9006ca5000.jpg\" alt=\"\" width=\"750\" height=\"749\" /\u003e\u003c/p\u003e\n\u003cdiv id=\"articleTop\"\u003e\n\u003cp\u003e\u003cstrong\u003eTác dụng của tâm sen\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eTâm sen hay còn gọi là tim sen, nó nằm trong nhụy của hoa sen. Tâm sen nhỏ như cây tăm, màu xanh và ngắn chỉ khoảng 1cm. Tâm sen có vị đắng, tính hàn và nhiều thành phần dưỡng chất khác tốt cho sức khỏe.\u003c/p\u003e\n\u003cp\u003e\u003cem\u003eTâm sen có nhiều công dụng tuyệt vời cho sức khỏe cơ thể\u003c/em\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003eUống tâm sen giúp an thần và ngủ ngon giấc\u003c/strong\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eTâm sen là một trong những sản phẩm tuyệt vời có tác dụng an thần, điều trị chứng mất ngủ và giúp giấc ngủ được ngon, sâu hơn. Bởi trong tâm sen có chứa các dưỡng chất như asparagin, alkaloid (nelumbin, nuciferin, liensini). Công dụng của những chất này là trấn tĩnh cũng như cải thiện giấc ngủ và điều trị bệnh mất ngủ kinh niên.\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003eTâm sen giúp ổn định huyết áp và tốt cho tim\u003c/strong\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eTheo các chuyên gia chăm sóc sức khỏe cho biết, tâm sen có khả năng điều hòa, giảm cao huyết áp, ổn định nhịp tim hiệu quả. Như vậy, nếu người nào thường trong trạng thái lo lắng, hồi hộp, tim đập nhanh bất thường và hay bị cao huyết áp thì sử dụng tâm sen tỏ ra công hiệu vô cùng.\u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv id=\"articleBottom\"\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003eTâm sen có khả năng thanh nhiệt, giải độc\u003c/strong\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eNhờ có vị đắng, tính hàn mà khi uống tâm sen sẽ giúp thanh nhiệt, giải độc cơ thể. Ngày hè nóng nực uống một ly nước tâm sen sẽ xua tan cái nóng, làm dịu cơ thể nhanh chóng. Đồng thời, nhờ khả năng giải độc mà khi uống tâm sen đều đặn và đúng cách sẽ hỗ trợ chăm sóc làn da láng mịn, sạch mụn, giảm dị ứng da rõ rệt.\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003eTâm sen hỗ trợ trị chứng bí tiểu\u003c/strong\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eBí tiểu là biểu hiện của việc bị mắc tiểu mà không thể đi vệ sinh được. Để cải thiện tình trạng này, người bệnh cần uống tâm sen đều đặn mỗi ngày. Nếu có thể nên kết hợp với cam thảo để đạt kết quả trị bệnh nhanh chóng nhất.\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003eTâm sen chữa bệnh ù tai, di tinh\u003c/strong\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eMột trong những công dụng khác của tâm sen đó là nó còn hỗ trợ điều trị bệnh ù tai, di tinh, di mộng công hiệu. Người già thường sẽ bị ù tai nên nếu uống tâm sen thì có thể cải thiện bệnh và giúp giấc ngủ của người già được ngon giấc hơn.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/76/bf/4b/e3a394937fef03026a4b1c55cd305872.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003c/div\u003e\n\u003cp\u003e\u003cstrong\u003eCách sử dụng tâm sen hợp lý - an toàn\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003ePha trà tâm sen uống đều đặn mỗi ngày tốt cho sức khỏe\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003eTâm sen tuy rất tốt cho sức khỏe, tuy nhiên nếu không biết cách sử dụng hợp lý thì sẽ bị ngộ độc, đôc tố trong tâm sen có thể hủy hoại tế bào não, thận và tim. Ngoài ra, việc lạm dụng tâm sen quá nhiều sẽ gây mệt mỏi, mất trí nhớ, tim đập loạn, giảm ham muốn tình dục.\u003c/p\u003e\n\u003cp\u003eChính vì lẽ đó, để hủy bỏ độc tố trong tâm sen, trước khi dùng cần phải sao tâm sen lên thật kỹ và khô. Sau đó, chỉ cần pha tâm sen với nước sôi để làm nước trà uống mỗi ngày.\u003c/p\u003e\n\u003cp\u003eTâm sen có vị khá đắng nên với nhiều người có thể sẽ không uống được. Nếu muốn vị đắng của nước tâm sen dịu xuống, hãy thêm chút đường vào khuấy đều trước khi dùng.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/88/91/11/f9f6c98064156413f8fc1173c15a8606.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eHƯỚNG DẪN BẢO QUẢN\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eĐể trà nơi khô ráo, tránh ẩm thấp hoặc nhiệt độ quá cao, tránh ánh nắng trực tiếp.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/f7/68/16/0746bf059dd5a42128126d3aa2ac5640.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f7/68/16/0746bf059dd5a42128126