":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":2591000,"discount_rate":50,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/dd/5e/c0/56f59082facbc2baa0a4f51b0388d738.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":676,"all_time_quantity_sold":3,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cdiv class=\"com-struct\"\u003e\n\u003cdiv class=\"com-struct\"\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"J_module\"\u003e\n\u003cdiv class=\"module-detailImageText\"\u003e\n\u003cdiv\u003e\n\u003cdiv\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cstrong\u003eLOA KARAOKE XÁCH TAY PS-K106A\u003c/strong\u003e\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"com-struct\"\u003e\n\u003cdiv class=\"com-struct\"\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"J_module\"\u003e\n\u003cdiv class=\"module-detailImageText\"\u003e\n\u003cdiv\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/dd/5e/c0/1b686b277987af3fd5814b42f5a0c4be.jpg\" alt=\"\" width=\"550\" height=\"550\" /\u003e• Công suất: 180W\u003c/div\u003e\n\u003cdiv\u003e• Loa bass: 6.5 inch ( 1.6 tấc )\u003c/div\u003e\n\u003cdiv\u003e• Kích thước: (39×21,5×21,5)cm\u003c/div\u003e\n\u003cdiv\u003e• Kết nối: Bluetooth, USB, AUX, SD Card, đài FM\u003c/div\u003e\n\u003cdiv\u003e• Bình acquy 12V\u003c/div\u003e\n\u003cdiv\u003e• Micro: đi kèm 2 micro UHF\u003c/div\u003e\n\u003cdiv\u003e• Trọng lượng: 10 kg\u003c/div\u003e\n\u003cdiv\u003e• Phụ kiện bao gồm: Sách hướng dẫn, dây ồ, 2 miscro không dây, pin.\u003c/div\u003e\n\u003cdiv\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/fa/01/38/e728e61da3fb194c034385295dcd2569.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/div\u003e\n\u003cdiv\u003eGiới thiệu chi tiết sản phẩm:\u003c/div\u003e\n\u003cdiv\u003eKích thước và trọng lượng loa nhỏ nhất từ trước đến Dù chơi trong nhà hay ngoài trời PS-K106A đều mang tới chất âm chi tiết sắc nét, dải mid tự nhiên, dải bass mạnh mẽ cho cuộc vui bất tận.\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/6e/1c/22/00788fbbe1e154af47262d9672e9a6c0.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/div\u003e\n\u003cdiv\u003eVề thiết kế bên ngoài\u003c/div\u003e\n\u003cdiv\u003e️ Thiết kế nhỏ gọn chuyên dùng cho Karaoke trên xe hơi 5 chỗ hay 7 chổ ngồi, âm thanh cực hay, chống hú rít khi ngồi hát gần loa. PS-K106A là sự lựa chọn hoàn hảo cho những chuyến đi du lịch.\u003c/div\u003e\n\u003cdiv\u003e️ Chất liệu thùng loa làm bằng gỗ và được sơn nước ba lớp, sơn nhám và vân đá nổi tạo cho loa sự cứng cáp, năng động và cá tính. Màng lưới che loa được làm từ vải mềm với họa tiết sọc caro màu xám đẹp mắt và mềm mại.\u003c/div\u003e\n\u003cdiv\u003e️ Loa được gắn tay x.á bằng nhôm chắc chắn nên dễ dàng di chuyển hay cần thay đổi vị trí đặt loa.\u003c/div\u003e\n\u003cdiv\u003e️ Thiết kế tối giản với kích thước: (39×21,5×21,5) cm và trọng lượng 10 kg nên việc di chuyển mang theo chiếc loa rất thuận tiện.\u003c/div\u003e\n\u003cdiv\u003e️ Thời gian phát của loa được 3 đến 4 tiếng và được xạc đầy bằng ồ điện AC220V trong thời gian 4 tiếng.\u003c/div\u003e\n\u003cdiv\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/e9/d3/d6/540a9f740e226a019c8cc0e7c6d4e3a4.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/div\u003e\n\u003cdiv\u003eVề thiết kế bên trong\u003c/div\u003e\n\u003cdiv\u003e️ Hệ thống loa 2 Way: một loa bass 6,5 inch có củ từ lớn giúp mang lại âm thanh chắc khỏe. Và một loa treble (tweeter) 3 inchs tạo nên dải tần phẳng giúp giọng hát trở nên rõ ràng và lan tỏa khắp không gian rộng lớn\u003c/div\u003e\n\u003cdiv\u003e️ Với chiếc loa Dalton PS-K106A, bạn có thể dễ dàng kết nối đến các thiết bị thông minh một cách nhanh chóng và dễ dàng như điện thoại, laptop, máy tính bảng… thông qua cổng bluetooth 4.0. Ngoài ra loa còn hỗ trợ các cổng kết nối khác như: USB, thẻ nhớ SD, ngỏ vào AUX jack cắm 3.5mm, đài FM. Ngoài micro không dây còn có thể kết nối micro bên ngoài với loa khi cần qua jack cắm 6ly (6mm) trên mặt điều khiển. ️Loa karaoke x.á tay Dalton PS-K106A được thiết kế các nút tinh chỉnh âm thanh đặt phía trên một tấm nhôm phay xước tinh tế và tùy chỉnh chuẩn xác cho âm thanh của loa trong không gian sử dụng.\u003c/div\u003e\n\u003cdiv\u003eĐặc biệt mạch tạo tiếng vang ECHO được sử dụng IC M65831AP của Nhật Bản cho tiếng vang ECHO ấm và trong\u003c/div\u003e\n\u003cdiv\u003eĐiều chỉnh cho micro gồm 3 nút: V.MIC, HI và LOW (âm lượng, treble, bass)\u003c/div\u003e\n\u003cdiv\u003eĐiều chỉnh echo gồm 2 nút: DELAY và ECHO\u003c/div\u003e\n\u003cdiv\u003eĐiều chỉnh nhạc gồm 3 nút: V. MUSIC, HI và LOW (âm lượng, treble, bass)\u003c/div\u003e\n\u003cdiv\u003e️ Ưu điểm nổi bật của loa PS-K106A là có cổng kết nối DC12V bên ngoài, có thể lấy ồn điện 12V từ xe hơi ở cổng tẩ ố trên table xe (car cigarette jack)\u003c/div\u003e\n\u003cdiv\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/81/a0/7d/0da813c4074e7e72eec8818093004686.jpg\" alt=\"\" width=\"750\" height=\"753\" /\u003e\u003c/div\u003e\n\u003cdiv\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/69/36/ba/c573a1c8bf3bfb766c434e9781803871.jpg\" alt=\"\" width=\"750\" height=\"735\" /\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/dd/5e/c0/56f59082facbc2baa0a4f51b0388d738.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/dd/5e/c0/56f59082facbc2baa0a4f51b0388d738.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/dd/5e/c0/56f59082facbc2baa0a4f51b0388d738.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/dd/5e/c0/56f59082facbc2baa0a4f51b0388d738.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/dd/5e/c0/56f59082facbc2baa0a4f51b0388d738.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/fa/01/38/34cd3825764ad58a767531160c97da6e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/fa/01/38/34cd3825764ad58a767531160c97da6e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/fa/01/38/34cd3825764ad58a767531160c97da6e.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fa/01/38/34cd3825764ad58a767531160c97da6e.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fa/01/38/34cd3825764ad58a767531160c97da6e.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/15/14/cc/54520e689c2068bda4075ed82f2c8d98.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/15/14/cc/54520e689c2068bda4075ed82f2c8d98.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/15/14/cc/54