ason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/f7/e7/82/b12fd759b84a973ce2f4bb5baf88f0c0.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":469,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cdiv class=\"thietKe gStyle3 menuViewHightLight\"\u003e\n\u003cdiv class=\"description\"\u003e\u003cstrong\u003eQuạt sạc SUNHOUSE SHD7116\u003c/strong\u003e là mẫu quạt sạc tiên phong tại Việt Nam phong ứng dụng pin sạc Lithium chất lượng cao. Pin sạc Lithium của quạt \u003cstrong\u003eSUNHOUSE SHD7116\u003c/strong\u003e được trang bị\u003cstrong\u003e mạch bảo vệ\u003c/strong\u003e thông minh, giúp pin hoạt động ổn định, tự động ngắt khi điện áp pin sụt giảm xuống dưới mức an toàn hoặc khi sạc đầy. Mạch bảo vệ được SUNHOUSE tích hợp nhằm ngăn chặn vấn đề đoản mạch khi dòng điện không ổn định mùa cao điểm(*), giúp \u003cstrong\u003eQuạt sạc SUNHOUSE SHD7116\u003c/strong\u003e hoạt động bền bỉ, bạn có thể yên tâm sử dụng lâu dài, \u003cbr /\u003eSo sánh với các pin sạc thông thường, pin sạc của SUNHOUSE SHD7116 có thể sạc nhanh gấp 2 lần, tuổi thọ cao vượt trội. Với dung lượng pin 3600mA, \u003cstrong\u003eQuạt sạc SUNHOUSE SHD7116\u003c/strong\u003e có thể làm mát liên tục đến 10 giờ tùy tốc độ gió. Quạt giúp làm mát hiệu quả và mang theo linh hoạt ở nhiều không gian khác nhau trong nhà, khi ở ngoài trời, những khi mất điện hay không sẵn ổ cắm điện. \u003cbr /\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/4f/65/b9/e42abe5409e25ee8052cc402b73ee297.jpeg\" alt=\"image-20230406172510-3.jpeg\" /\u003e\u003cbr /\u003e\u003cem\u003e(*) Lưu ý: Để gia tăng tuổi thọ của quạt và đảm bảo an toàn, bạn tránh vừa sạc vừa để quạt chạy, nên sạc đầy rồi mới sử dụng\u003c/em\u003e\u003cem\u003e.\u003c/em\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eXoay 360 độ làm mát linh hoạt\u003c/strong\u003e\u003c/li\u003e\n\u003c/ul\u003e\u003cstrong\u003eQuạt sạc SUNHOUSE SHD7116\u003c/strong\u003e có phần lồng quạt được thiết kế để có thể dễ dàng xoay quay lên trên hoặc chéo xuống thấp quanh trục cố định, nhờ vậy bạn có thể tùy chỉnh hướng gió mà không cần thay đổi vị trí đặt quạt. Chế độ quay đảo chiều 180 độ nhờ vậy có thể làm mát không gian rộng.\u003cbr /\u003e\u003cstrong\u003eQuạt sạc SUNHOUSE SHD7116\u003c/strong\u003e xoay 360 độ làm mát theo nhu cầu. Tính năng này cũng giúp gió phân tán, phù hợp cho đối tượng là trẻ nhỏ có hệ hô hấp yếu.\u003cbr /\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/4a/20/63/fec33503007e006f74ba60844d08533b.jpeg\" alt=\"image-20230406172510-4.jpeg\" /\u003e\u003cul\u003e\u003cli\u003e\u003cstrong\u003eTùy chỉnh 3 tốc độ gió, đáp ứng nhu cầu của cả gia đình\u003c/strong\u003e\u003c/li\u003e\n\u003c/ul\u003e\nQuạt có 3 tốc độ gió để bạn có thể tùy chỉnh linh hoạt theo nhu cầu sử dụng và nhiệt độ môi trường xung quanh. Công suất quạt 25W, gió tản đều, động cơ hoạt động êm ái, mang đến sự thư thái cho bạn và người thân.\u003cbr /\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/11/05/b5/6e490e9364aae99a969a2be471e348d1.jpeg\" alt=\"image-20230406172510-5.jpeg\" /\u003e\u003cul\u003e\u003cli\u003e\u003cstrong\u003eHệ thống đèn ngủ 2-trong-1 và Đèn báo sạc đầy an toàn\u003c/strong\u003e\u003c/li\u003e\n\u003c/ul\u003e\nĐược trang bị thêm đèn LED phía trên, \u003cstrong\u003eQuạt sạc SUNHOUSE SHD7116\u003c/strong\u003e vừa làm mát hiệu quả, vừa hô biến thành một chiếc đèn ngủ xinh xắn. Không chỉ thế, riêng chế độ sáng quạt cũng có đến 2 chế độ để bạn tùy chỉnh theo nhu cầu, vô cùng tiện lợi.\u003cbr /\u003e\u003cbr /\u003eBên cạnh đèn ngủ, \u003cstrong\u003eQuạt sạc SUNHOUSE SHD7116 \u003c/strong\u003ecòn được trang bị đèn báo khi sạc đầy. Nhờ đó, giúp bạn tiện theo dõi quá trình sạc, đảm bảo không cắm sạc quá lâu. Đèn báo khi sạc đầy góp phần làm tăng độ bền của pin và hệ thống mạch bảo vệ pin, để sử dụng quạt dài lâu. \u003cbr /\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/25/69/b4/7e6fa296a04271f699e43181a7623941.jpeg\" alt=\"image-20230406172510-6.jpeg\" /\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"congNang gStyle3 menuViewHightLight\"\u003e\n\u003cdiv class=\"description\"\u003e\u003cstrong\u003eTHIẾT KẾ NHỎ GỌN – TIỆN LỢI\u003c/strong\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eKiểu dáng nhỏ gọn, thời trang\u003c/strong\u003e\u003c/li\u003e\n\u003c/ul\u003e\nQuạt tích điện mini SUNHOUSE SHD7116 sở hữu vẻ ngoài nhỏ gọn, thời trang, giúp bạn dễ dàng mang theo để làm mát ở mọi nơi trong nhà, những nơi không có sẵn ổ cắm. Đặc biệt nhờ pin sạc nhẹ (chỉ bằng 1/5 trọng lược pin thường có cùng dung lượng) nên vô cùng tiện khi đi du lịch, sử dụng mọi lúc mọi nơi. Chất liệu nhựa cao cấp bền màu, hạn chế trầy xước. Chân đế vững chắc, không lo rung lắc khi đặt trên mặt phẳng dù là dưới sàn hay trên bàn.\u003cbr /\u003eKhông chỉ có chức năng làm mát, với gam màu xanh ngọc tinh tế, SUNHOUSE SHD7116 còn như một vật trang trí xinh xắn cho không gian sống của bạn.\u003cbr /\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/ee/26/4a/bd94d7bb4f8532771b18e47cdfbc2a7b.jpeg\" alt=\"image-20230406172545-7.jpeg\" /\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"thongSoKyThuatSanPham1 menuViewHightLight\"\u003e\n\u003ch2 class=\"title\"\u003eThông số kỹ thuật\u003c/h2\u003e\n\u003cul\u003e\u003cli\u003e\n\u003cdiv class=\"text\"\u003eMàu sắc: Xanh – Trắng\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv class=\"text\"\u003eĐiện áp: 220 V~/ 50 Hz\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003