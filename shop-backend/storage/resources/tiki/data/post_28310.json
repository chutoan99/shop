und_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":31680,"discount_rate":11,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/4a/91/2c/6a160797248daacb0f8ddaa763850f76.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":267,"all_time_quantity_sold":11,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2 class=\"irIKAp\" style=\"text-align:left;\"\u003e\u003cspan style=\"color:#008000;\"\u003eBẢY NGƯỜI CHỒNG CỦA EVELYN HUGO\u003c/span\u003e\u003c/h2\u003e\n\u003cp class=\"irIKAp\" style=\"text-align:left;\"\u003eCông ty phát hành: Công ty CP Sách và Truyền Thông San Hô (San Hô Books)\u003c/p\u003e\n\u003cp class=\"irIKAp\" style=\"text-align:left;\"\u003eThể loại: Tiểu thuyết\u003c/p\u003e\n\u003cp class=\"irIKAp\" style=\"text-align:left;\"\u003eNhan đề: Bảy người chồng của Evelyn Hugo\u003c/p\u003e\n\u003cp class=\"irIKAp\" style=\"text-align:left;\"\u003eTác giả: Taylor Jenkins Reid\u003c/p\u003e\n\u003cp class=\"irIKAp\" style=\"text-align:left;\"\u003eNhà xuất bản: Nxb Thanh Niên\u003c/p\u003e\n\u003cp class=\"irIKAp\" style=\"text-align:left;\"\u003ePhát hành: 2023\u003c/p\u003e\n\u003cp class=\"irIKAp\" style=\"text-align:left;\"\u003eGiá bìa: 288,000 VNĐ\u003c/p\u003e\n\u003cp class=\"irIKAp\" style=\"text-align:left;\"\u003eMã sản phẩm: 893-533-372-009-2\u003c/p\u003e\n\u003cp class=\"irIKAp\" style=\"text-align:left;\"\u003eISBN: 978-604-322-235-7\u003c/p\u003e\n\u003cp class=\"irIKAp\" style=\"text-align:left;\"\u003eSố trang: 408 trang\u003c/p\u003e\n\u003cp class=\"irIKAp\" style=\"text-align:left;\"\u003eKhổ: 16 x 24 cm\u003c/p\u003e\n\u003cp class=\"irIKAp\" style=\"text-align:left;\"\u003e---\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cspan style=\"color:#808000;\"\u003e\u003cstrong\u003eĐối tượng độc giả:\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Người thích đọc văn học Âu Mĩ\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Người thích đọc truyện tình cảm lãng mạn, girl love/đồng tính nữ\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Người quan tâm đến sách truyện chủ đề bình đẳng giới\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e---\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Hình thức trình bày đẹp mắt, chất lượng in ấn tốt.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Nội dung lôi cuốn, giàu cảm xúc, chủ đề hiện đại, được nhiều người quan tâm.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Top 10 Tiểu thuyết bìa mềm bán chạy nhất New York Times Bestseller trong hơn 140 tuần liên tiếp.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Top 6 Tiểu thuyết lịch sử hay nhất do Goodreads bình chọn năm 2017, nhận được hơn 2.5 triệu đánh giá trên Goodreads.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e---\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eEvelyn Hugo là minh tinh màn bạc những năm 1960-1980 ở Hollywood, nổi tiếng với sắc đẹp và ồn ào xoay quanh bảy cuộc hôn nhân tai tiếng. Ở tuổi 79, Evelyn quyết định công bố sự thật đời tư thông qua cô nhà báo quèn Monique Grant.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e---\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eEvelyn Hugo, ngôi sao Hollywood huyền thoại của thập niên 1960, đã làm mưa làm gió khắp giới giải trí với bảy cuộc hôn nhân đầy hào nhoáng, đầy tai tiếng. Sau hàng chục năm, bảy người chồng và vô số đồn đoán, giờ đây bà quyết định công bố sự thật về góc khuất cuộc đời. Ngạc nhiên thay, toàn bộ bí mật trị giá hàng triệu đô la được giao trọn cho cô nhà báo vô danh tiểu tốt Monique Grant. Liệu tất cả có phải ngẫu nhiên?\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eChuyện đời Evelyn Hugo không chỉ chứa đầy âm mưu toan tính, tiền tài danh vọng mà còn là câu chuyện về tình bạn tri kỉ, tình yêu bị ngăn cấm. Càng khám phá những ẩn giấu về cuộc đời của Evelyn Hugo trứ danh, Monique càng hiểu rõ bản thân, cũng như những khát vọng, cảm xúc thầm kín và bi kịch tương giao giữa hai con người tưởng chừng chẳng có bất kì mối dây liên hệ.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e---\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cspan style=\"color:#800000;\"\u003e\u003cstrong\u003eVỀ TÁC GIẢ\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eTaylor Jenkins Reid sinh năm 1983, là tác giả người Mĩ nổi tiếng với những tựa sách ăn khách như Bảy người chồng của Evelyn Hugo, Daisy Jones và bộ sáu (Daisy Jones \u0026amp; the Six), Một tình yêu đích thực (One True Loves),… Tiểu thuyết của cô đã ba lần chiến thắng Giải thưởng Lựa chọn của Goodreads năm 2019, 2021, 2022, nhiều lần lọt vào danh sách New York Times Bestseller và được chuyển thể thành phim.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/4a/91/2c/6a160797248daacb0f8ddaa763850f76.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/4a/91/2c/6a160797248daacb0f8ddaa763850f76.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/4a/91/2c/6a160797248daacb0f8ddaa763850f76.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4a/91/2c/6a160797248daacb0f8ddaa763850f76.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4a/91/2c/6a160797248daacb0f8ddaa763850f76.jpg"},{"ba