height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/6b/69/4e/abbddfb6d1ffe347682867d5c962d075.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":851,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003e\u003cstrong\u003eĐặc điểm nổi bật \u003c/strong\u003e\u003c/h3\u003e\n\u003cul\u003e\u003cli\u003eThân ấm inox 304 an toàn bền đẹp\u003c/li\u003e\n\u003cli\u003eRơ le kép bảo vệ chống cạn và ngắt khi nước sôi an toàn\u003c/li\u003e\n\u003cli\u003eĐế xoay 360 độ và thiết kế không dây tiện lợi\u003c/li\u003e\n\u003cli\u003eThiết kế gọn nhẹ\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/3c/3f/6d/5b038c6600dbea64e8a3212ee3a195b7.png\" alt=\"\" width=\"750\" height=\"750\"\u003e\u003c/p\u003e\n\u003cp\u003eẤm siêu tốc được Goldsun GKT2605 là vật trang trí cho căn bếp nhà bạn thêm rực rỡ. Mặt trong ấm làm từ chất liệu inox 304 có độ bền cao, an toàn sức khỏe, hạn chế tối đa tình trạng gỉ sét. Chất liệu này có khả năng chống ăn mòn tuyệt đối, giảm nguy cơ bóp méo khi xảy ra va đập.\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eMiệng rót tích hợp khe chống cặn\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eẤm siêu tốc được Goldsun GKT2605 được tích hợp khe chống cặn ngay ở nắp ấm giúp lọc cặn, đồng thời ngăn các loại côn trùng như: muỗi, kiến, bọ không lọt vào ấm, đảm bảo an toàn vệ sinh cho người sử dụng.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/e0/6c/88/4453634d3e53126afcfdfffba517c3e1.png\" alt=\"\" width=\"1000\" height=\"1000\"\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eĐèn LED tự động báo hiệu bật/tắt\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eVới thiết kế công tắc bật tích hợp đèn LED ở dưới đế ấm siêu tốc Goldsun GKT2605 giúp bạn biết được quá trình hoạt động của ấm. Khi bật công tắc, đèn sẽ sáng đến khi nước được đun sôi, công tắc nhảy về vị trí tắt, khi đó đèn cũng sẽ tự động tắt, rất tiện lợi cho người dùng.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ce/8d/84/b10a2c38aecef1491866b3914d39f3ac.png\" alt=\"\" width=\"1000\" height=\"564\"\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eĐun sôi siêu tốc, tiết kiệm thời gian và điện năng\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eẤm siêu tốc được Goldsun GKT2605 có công suất mạnh 2000W  dung tích 1.8L giúp thời gian đun sôi nước nhanh chóng, tiết kiệm điện năng tối đa. Sản phẩm an toàn cho người sử dụng vì trong quá trình đun sôi không sản sinh ra các chất độc hại và gây rò rỉ điện.\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eHệ thống an toàn 2 cấp độ\u003c/strong\u003e\u003c/h3\u003e\n\u003cul\u003e\u003cli\u003eTự động tắt khi nước sôi: Nếu bạn quên hoặc bận rộn với các công việc khác thì cũng đừng lo lắng vì ấm siêu tốc Goldsun GKT2605 có chức năng tự động ngắt khi nước sôi, đảm bảo an toàn, chống chập cháy.\u003c/li\u003e\n\u003cli\u003eBảo vệ đun khô, không có nước: Nếu bạn vô tình để ấm siêu tốc hoạt động mà không có nước; chức năng bảo vệ đun khô sẽ tắt nguồn thiết bị. Trong trường hợp này, hãy để ấm siêu tốc nguội hẳn trước khi đổ nước lạnh để đun nước. Tính năng này giúp phòng chống cháy nổ và tăng tuổi thọ sản phẩm.\u003c/li\u003e\n\u003c/ul\u003e\u003ch3\u003e\u003cstrong\u003eĐế rời tiện lợi với thiết kế xoay 360 độ \u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eVới thiết kế độc lập, đế tiếp điện được tách rời khỏi thân ấm siêu tốc, giúp việc đổ nước vào ấm dễ dàng, tiện lợi. Ngoài ra, ấm có thể xoay 360 độ trên đế tiếp điện, bạn có thể đặt hoặc nhấc ấm ở bất kì góc nào, không lo đến việc đặt sao cho khớp, tiện lợi và tiết kiệm thời gian cho người dùng. \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/bc/af/26/92804b82b0973e5e2ebc16bdb5fe6445.png\" alt=\"\" width=\"1000\" height=\"1000\"\u003e\u003c/p\u003e\n\u003cp\u003eVới những tính năng ưu Việt của sản phẩm ấm siêu tốc inox Goldsun GKT2605 chắc chắn sẽ mang lại sự hài lòng tuyệt đối cho khách hàng. Cùng Goldsun chăm sóc gia đình bạn ngay hôm nay!\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eGOLDSUN VIỆT NAM - SẢN PHẨM TIỆN ÍCH, CUỘC SỐNG TIỆN NGHI\u003c/strong\u003e\u003c/h3\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/6b/69/4e/abbddfb6d1ffe347682867d5c962d075.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/6b/69/4e/abbddfb6d1ffe347682867d5c962d075.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/6b/69/4e/abbddfb6d1ffe347682867d5c962d075.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6b/69/4e/abbddfb6d1ffe347682867d5c962d075.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6b/69/4e/abbddfb6d1ffe347682867d5c962d075.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/16/1a/1d/5befa95bb2a8852a26bab83d0e821019.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/16/1a/1d/5befa95bb2a8852a26bab83d0e821019.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/16/1a/1d/5befa95bb2a8852a