":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":7,"review_text":"(7)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/90/3e/8b/6738246612787a5de500300d957f776d.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1266,"all_time_quantity_sold":21,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\n\u003ch3\u003e\u003cspan\u003eTã dán Moony cao cấp NB90/S84/L54 (Nhập khẩu từ Nhật Bản)\u003c/span\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eRa đời từ năm 1981, sản xuất bởi Tập đoàn Unicharm – nhà sản xuất tã em bé số 1 Nhật Bản, Moony tự hào hơn 40 năm đồng hành cùng trẻ em trên toàn thế giới.\u003c/li\u003e\n\u003cli\u003eHiểu rằng tã là nơi tiếp xúc thường xuyên với làn da mỏng manh của bé, bởi vậy chiếc tã của Moony được tạo ra từ những chất liệu mềm mại, lành tính và an toàn nhất.\u003c/li\u003e\n\u003cli\u003eTã dán Moony Blue là dòng tã dán lành tính siêu mềm thoáng. Hơn 90% nữ hộ sinh tại bệnh viện Nhật Bản khuyên dùng sản phẩm tã dán Moony.\u003c/li\u003e\n\u003cli\u003eHạn sử dụng: 4 năm kể từ ngày sản xuất\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003eChất liệu\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eDòng tã Moony Natural và tã dán Moony Blue đạt chuẩn Chứng nhận Oeko-tex quốc tề về Nguyên liệu thô an toàn – chống độc hại ( chứng nhận bởi Viện kiểm nghiệm Hohenstein Đức và Institute für Oekologie, Technik und Innovation ÖTI (Wien/Áo)). Mẹ hoàn toàn an tâm khi lựa chọn Moony làm người bạn đồng hành của bé.\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003eĐặc điểm nổi bật\u003c/h3\u003e\n\u003cp\u003e\u003cstrong\u003eCông nghệ thân thiện với làn da bé\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eBề mặt tã siêu mềm mịn, bổ sung 3 loại tinh dầu thiên nhiên: Dầu Olive, dầu Jojoba, dầu Gạo có tác dụng dưỡng da, kháng viêm, ngăn ngừa hăm tã.\u003c/li\u003e\n\u003cli\u003eThành phần làm tã có nguồn gốc từ thiên nhiên, tính axit yếu, góp phần giúp duy trì lớp màng axit tự nhiên trên da bé, hạn chế sự xâm nhập của vi khuẩn có hạn – một trong những nguyên nhân gây hăm tã.\u003c/li\u003e\n\u003cli\u003eChuẩn chứng nhận OEKO-TEX quốc tế về nguyên liệu thô an toàn, chống độc hại – Tuyệt đối lành tính, an toàn cho làn da nhạy cảm của bé.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eCông nghệ không tràn tã\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eCông nghệ Origami với 2 đường thun đáy êm mềm, ngăn hằn, cùng thiết kế đai chun co giãn linh hoạt, ôm vừa vặn phần lưng, chân và đùi, không tạo khe hở, chống tràn tối đa (Áp dụng với size 3S, NB và S).\u003c/li\u003e\n\u003cli\u003eLõi bông cao cấp siêu thấm hút cùng màng vải thoáng khí, giúp mông bé khô tênh, thoải mái suốt cả ngày.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eCông nghệ mẹ an tâm, bé luôn thoải mái\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eThiết kế Oheso giúp bảo vệ phần rốn sơ sinh non nớt của bé (Áp dụng với size 3S, NB).\u003c/li\u003e\n\u003cli\u003eĐường chỉ thị ướt giúp mẹ dễ dàng kiểm tra và xác định thời gian thay tã..\u003c/li\u003e\n\u003cli\u003eĐã kiểm định không gây kích ứng.\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003eHướng dẫn chọn size\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eTã dán Size NB – Dành cho bé dưới 5kg.\u003c/li\u003e\n\u003cli\u003eTã dán Size S – Dành cho bé từ 4 - 8kg.\u003c/li\u003e\n\u003cli\u003eTã dán Size L – Dành cho bé từ 9 - 14kg.\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003eHướng dẫn sử dụng\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eMở miếng tã ra và tròng vào chân cho bé, kéo cao ngang hông. Mẹ cần điều chỉnh sao cho vùng đai lưng nằm trên rốn của bé.\u003c/li\u003e\n\u003cli\u003eKéo chắc tay phần băng dính để tã vừa khít phần lưng. Phần lưng hoàn toàn có thể co giãn nên mẹ không phải lo tã ôm quá chặt.\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003eHướng dẫn bảo quản\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eBảo quản nơi khô ráo, thoáng mát, tránh ánh nắng mặt trời trực tiếp, xa tầm tay trẻ em.\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003eLưu ý\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eThay tã sau khoảng thời gian đều đặn và thay ngay sau khi bé tiêu bẩn.\u003c/li\u003e\n\u003cli\u003eNgừng sử dụng và hỏi ý kiến bác sĩ nếu xuất hiện bất thường trên da.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/53/29/cb/a75d33c57924750dfe0572856f2c89c9.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/53/85/1d/7c9a8c3f812ce09be88ce1ea40e97a6f.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/e2/d6/43/4433ac66036232c5781805d6e3bb9a6e.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao 