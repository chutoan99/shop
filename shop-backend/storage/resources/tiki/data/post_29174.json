y toàn bộ thuốc trong tuýp lên một đốm trên da. Phải bôi thuốc thật sự lên da chứ không bôi lên lông thú, cẩn thận tránh thuốc dính vào lông thú quá nhiều.\u003c/p\u003e\n\u003cp\u003eTránh tiếp xúc cho đến khi đã khô.\u003cbr /\u003eKhông lặp lại trong vòng 30 ngày.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e\u003cp\u003eSản phẩm này là tài sản cá nhân được bán bởi Nhà Bán Hàng Cá Nhân và không thuộc đối tượng phải chịu thuế GTGT. Do đó hoá đơn VAT không được cung cấp trong trường hợp này.\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/14/8c/d6/4b45ee494d7461297a1be2ac4a8b35aa.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/14/8c/d6/4b45ee494d7461297a1be2ac4a8b35aa.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/14/8c/d6/4b45ee494d7461297a1be2ac4a8b35aa.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/14/8c/d6/4b45ee494d7461297a1be2ac4a8b35aa.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/14/8c/d6/4b45ee494d7461297a1be2ac4a8b35aa.png"},{"base_url":"https://salt.tikicdn.com/ts/product/c8/7f/1b/53cc437bb636db6ad1f37a972cffc4d5.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c8/7f/1b/53cc437bb636db6ad1f37a972cffc4d5.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c8/7f/1b/53cc437bb636db6ad1f37a972cffc4d5.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c8/7f/1b/53cc437bb636db6ad1f37a972cffc4d5.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c8/7f/1b/53cc437bb636db6ad1f37a972cff