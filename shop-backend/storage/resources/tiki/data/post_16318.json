6dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.6,"review_count":31,"review_text":"(31)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/43/2b/d8/1016776e03058ddbb6e061818ccfe267.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1883,"all_time_quantity_sold":362,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eKhi thế giới của tóc không ngừng phát triển, bạn nên cập nhật những xu hướng mới nhất cho kiểu tóc của bạn, đặc biệt không thể bỏ qua vai trò của gôm xịt tóc trong công cuộc làm đẹp cho mái tóc của chính bạn. Một trong những sản phẩm đột phá, ra đời nhằm phá vỡ giới hạn sáng tạo kiểu tóc của nhà Schwarzkopf : Gôm xịt tóc giữ nếp cứng Osis +3 Session 300ml.\u003c/p\u003e\n\u003cp\u003eXuất xứ: Đức\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCông dụng của \u003c/strong\u003e\u003cstrong\u003eGôm xịt tóc Schwarzkopf OSiS + 3 Session Extreme Hold Hairspray 300ml\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eVới khả năng giữ nếp vượt trội, giúp kiểu tóc của bạn vững vàng trong các điều kiện môi trường như vui chơi, học tập hay làm việc. Vẫn là công nghệ vòi xịt cao cấp giúp gôm tán đều là bám lên tóc một cách tự nhiên nhất. Bạn sẽ không phải lo lắng với tình trạng đọng keo như các loại gôm thông thường.\u003c/p\u003e\n\u003cp\u003e+ Màng gôm xịt tóc bao phủ tuyệt đối hỗ trợ sự liên kết giữa các sợi tóc. Dưỡng chất quý trong gôm sẽ chăm sóc tóc bạn khỏe đẹp tự nhiên. Đồng thời hương thơm tinh tế sẽ là điểm 10 tuyệt đối cho siêu phẩm này. Độ bóng ổn định vừa 3/5 sẽ khiến vẻ ngoài của bạn nổi bật hơn. Thiết kế sang chảnh quen thuộc với màu bạc chủ đạo, vỏ đúc khối rất mịn, dung tích 300ml cầm vừa tay và tiện lợi khi di chuyển!\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eMột số lưu ý khi sử dụng gôm Osis +3 Session\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eKhông để sản phẩm ở những nơi có nhiệt độ cao\u003c/p\u003e\n\u003cp\u003eKhông dùng chung với các loại gôm xịt tóc khác\u003c/p\u003e\n\u003cp\u003eNên dùng với sáp vuốt tóc Osis+ là tốt nhất\u003c/p\u003e\n\u003cp\u003eNên gội sạch tóc sau mỗi lần dùng gôm\u003c/p\u003e\n\u003cp\u003eHạn chế việc xịt quá nhiều lên tóc.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003ciframe src=\"//www.youtube.com/embed/gl-oGiPX0LY\" width=\"750\" height=\"480\" frameborder=\"0\" allowfullscreen=\"allowfullscreen\"\u003e\u003c/iframe\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThành phần cấu tạo\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eHydrofluorobarbon 152A, Octylacrylamide/Acrylates/Butylaminoethyl Methacrylate Copolymer, Aminomethyl Propanol, Benzophenone 4, Triethyl Citrate. Các thành phần tạo màu, tạo hương thơm cho sản phẩm. Alcohol Denat, Fragrance, Water (Aqua).\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/59/7b/4e/2890d08e04f8fbab59cdacad21d925a8.jpg\" alt=\"\" width=\"750\" height=\"495\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/d5/46/38/d8514791fcfece655f7838a071e45883.jpg\" alt=\"\" 