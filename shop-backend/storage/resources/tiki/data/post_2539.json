ng","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":11000,"discount_rate":73,"rating_average":4.8,"review_count":18,"review_text":"(18)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/35/f3/08/85f926031d990a0323e8e7cf019b9a7e.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1077,"all_time_quantity_sold":114,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2\u003eSET 5 Dây thun tập gym mini band GoodFit GF911MB\u003c/h2\u003e\n\u003cp\u003eNhững bài tập cùng dây Mini band là sự thay thế tuyệt vời cho những bài tập tạ truyền thống. Bởi giá thành rẻ, linh hoạt trong nhiều bài tập và giúp cơ bắp của bạn được hoạt động một cách khác so với tạ. Nên dây miniband đang là lựa chọn tập luyện của rất nhiều người.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/cf/ba/51/c9e0b29f4f806ac9f5789c58144b395d.jpg\" alt=\"\" width=\"750\" height=\"550\" /\u003e\u003c/p\u003e\n\u003ch2\u003eĐẶC ĐIỂM NỔI BẬT \u003c/h2\u003e\n\u003cp\u003eTập cùng \u003cstrong\u003edây Miniband\u003c/strong\u003e giúp gia tăng sự phối hợp giữa các bộ phận do yêu cầu bạn liên tục phải giữ sự căng thẳng trên các cơ. Nó giúp chỉ với một động tác mà bạn phải hoạt động nhiều nhóm cơ hơn. Dây được làm 100% từ cao su thiên nhiên, không có mùi hôi, thân thiện với môi trường.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/0d/b4/b3/9c79dff9428cec5833fe29c1d514f423.jpg\" alt=\"\" width=\"750\" height=\"487\" /\u003e\u003c/p\u003e\n\u003cp\u003eSợi cao su với đặc tính dai, bền để bạn có thể dùng trong nhiều bài tập mông, đùi hay những bài vật lý trị liệu. Bạn cũng có thể gắn\u003cstrong\u003e dây tập Gym\u003c/strong\u003e vào một cánh cửa và thực hiện động tác đẩy cơ tam đầu. Bạn cũng có thể quấn xung quanh cột hoặc ghế cho các bài tập ngực hoặc xoay vai,…Bạn có tập những bài tập có sẵn hoặc tự sáng tạo ra những động tác yêu thích của mình.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/2f/d2/da/8d5ce80bbceb9ecef0de161d431585a9.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ca/d7/8a/9eb1b286af375ccdc704097f697bc792.jpg\" alt=\"\" width=\"750\" height=\"489\" /\u003e\u003c/p\u003e\n\u003cp\u003eBộ dây tập mông được phân loại thành nhiều cấp độ. Mua miniband dạng set sẽ tiết kiệm chi phí hơn so với mua lẻ từng dây vì mỗi nhóm cơ lại đòi hỏi một mức độ kháng lực khác nhau.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/a1/ab/4b/07e9f416dae20d4edbc45b744aa82290.jpg\" alt=\"\" width=\"750\" height=\"487\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/18/13/06/00c17139117f24ac4d3b2b41b0d1051a.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eSet dây mini band (có túi đựng) chỉ chiếm một diện tích rất nhỏ trong túi đồ tập của bạn. Bạn có thể cất giữ trong tủ đồ hoặc tủ quần áo. Bạn có thể mang chúng theo trong valy du lịch, tập luyện trong phòng khách sạn hay bất cứ không gian nào bạn cảm thấy thoải mái.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/2b/97/aa/2b9ccd2140bb731fe268ba062478084c.jpg\" alt=\"\" width=\"750\" height=\"487\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ac/d4/be/8a774234135cd69efb36ce8a18501c1a.jpg\" alt=\"\" width=\"750\" height=\"570\" /\u003e\u003c/p\u003e\n\u003cp\u003eBất cứ ai cũng có thể sử dụng dây Mini band. Tùy vào cách bạn sử dụng, nó có ích với cả người mới bắt đầu tới những người tập luyện nâng cao hơn. Bạn có thể sử dụng chúng cho những bài tập cơ bản hoặc tăng độ khó cho những bài tập truyền thống.\u003c/p\u003e\n\u003cp\u003eTrên thị trường hiện nay có 2 loại dây kháng lực tập Gym là dây vải và dây cao su. Nếu bạn là người mới, GoodFit khuyên bạn nên sử dụng loại dây cao su, bạn sẽ dễ dàng điều khiển chúng hơn.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/06/28/fc/1874a33b9b4cef806e4f5137c323d99d.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eBên cạnh việc tăng cường sức mạnh của cơ bắp, một số bài tập với dây Mini band như Jumping Jack, nhảy chân trước chân sau, nhảy từ trái qua phải,…sẽ rất tốt cho hệ tim mạch. Cùng tập luyện ngay hôm này thôi!\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/d9/ab/e7/15634a5447f872c2f04635b32cca1b3e.jpg\" alt=\"\" width=\"750\" height=\"590\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/cf/3d/18/982caea7465763ca837f0d8add596f4b.jpg\" alt=\"\" width=\"750\" height=\"481\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/f1/24/ed/77641d72bf3ecb4a47e4f022839b0676.jpg\" alt=\"\" width=\"750\" height=\"386\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/da/8a/c1/2ac751d7baa2b8e3a54bbe820bb4a5b9.jpg\" alt=\"\" width=\"750\" height=\"401\" /\u003e\u003c/p\u003e\n\u003ch2\u003eVỀ THƯƠNG HIỆU GOODFIT \u003c/h2\u003e\n\u003cdiv id=\"attachment_8774\" class=\"wp-caption aligncenter\" style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/46/7a/53/c0ce5a1c86488b48c2bd8252c8cc67af.jpg\" alt=\"\" width=\"750\" height=\"492\" /\u003e\u003cbr /\u003e\n\u003cp id=\"caption-attachment-8774\" class=\"wp-caption-text\"\u003e\u003cem\u003e6 bước để tạo ra các dòng sản phẩm mang thương hiệu GOODFIT\u003c/em\u003e\u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv id=\"attachment_8750\" class=\"wp-caption aligncenter\" style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/80/e5/68/1b95859b016dbd9a4ccf9e040c138938.jpg\" alt=\"\" width=\"750\" height=\"450\" /\u003e\u003cbr /\u003e\n\u003cp id=\"caption-attachment-8750\" class=\"wp-caption-text\"\u003e\u003cem\u003eĐội ngũ GOODFIT\u003c/em\u003e\u003c/p\u003e\n\u003c/div\u003e\n\u003ch2\u003eKHUYẾN CÁO\u003c/h2\u003e\n\u003cp\u003eKính gửi quý đối tác!\u003cbr /\u003eToàn bộ hình ảnh, video sản phẩm trong cửa hàng đều do Công ty chúng tôi sản xuất. Đặc biệt hình ảnh người mẫu có bản quyền và trả phí. Mong quý đối tác nên tôn trọng, không sao chép và chỉnh sửa. Các hành vi sử dụng khi chưa được phép có thể vi phạm pháp luật và đạo đức kinh doanh.\u003c/p\u003e\n\u003cp\u003eXin cảm ơn!\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/35/f3/08/85f926031d990a0323e8e7cf019b9a7e.jpg","is_gallery":true,"label":null,"large_url":"https://s