e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.5,"review_count":97,"review_text":"(97)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/5c/46/6c/4a99845db380608442fea2e1faadbd3b.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":357,"all_time_quantity_sold":549,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<h1><strong>Giới thiệu <em>Kem đánh bóng sơn xe ô tô (Car Cream) Karshine 110g KA-CC110</em></strong></h1>\n<p><em><strong>Kem đánh bóng sơn xe ô tô (Car Cream) Karshine 110g KA-CC110</strong></em> là sản phẩm kem đánh bóng xe sử dụng công nghệ mới nhất đạt tiêu chuẩn Châu Âu. Nó được đặc biệt chế tạo cho việc chăm sóc và bảo dưỡng cho bộ phận của xe được làm từ cờ rôm, sợi thủy tinh. Sản phẩm lưu lại 1 lớp bảo vệ sơn xe khỏi tác động của thời tiết giúp xe luôn đẹp và an toàn hơn.</p>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/da/bc/85/b9f782389df2798624502756a6ea2516.jpg?v&#61;1575013671354\" /></p>\n<h2><strong>Thông tin sản phẩm</strong></h2>\n<ul><li>Tên sản phẩm (VN): <em><strong>Kem đánh bóng sơn xe ô tô (Car Cream) Karshine 110g KA-CC110</strong></em></li><li>Tên sản phẩm (EN): Karshine Car Cream</li><li>Mã hàng: <strong>KA-CC110</strong></li><li>Công dụng: Tăng độ bóng và bảo vệ sơn xe ô tô</li><li>Xuât xứ: Thái Lan</li><li>Thương hiệu: <strong>Karshine</strong></li><li>Dạng: kem</li><li>Dung tích: 110g</li></ul>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/64/b7/cb/a85b1cd74ebe5e22a77b6e30c11b1baf.jpg?v&#61;1575013678242\" /></p>\n<h2><strong>Thông tin nổi bật</strong></h2>\n<ul><li>Giúp phục hồi độ bóng của sơn xe</li><li>Bảo dưỡng nước sơn tối ưu</li><li>Dễ dàng sử dụng, giúp cho xe nhìn sạch và đẹp hơn</li><li>Đảm bảo bề mặt thoáng mát, không có bụi khi bôi kem đánh bóng</li><li>Tạo độ bóng cao, độ bền cao cho cả sơn xe mới và đã qua sử dụng</li><li>Lý tưởng cho việc sử dụng tay và máy</li><li>Bảo vệ cực tím, có thể ngăn chặn các tia UV có hại</li></ul>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/2f/47/db/ec96d66acbfc8b8c721da8f0496f4735.jpg?v&#61;1575013686064\" /></p>\n<h2><strong>Hướng dẫn sử dụng</strong></h2>\n<ul><li>Bước 1: Lau sạch, khô bề mặt sơn cần làm bóng</li><li>Bước 2: Dùng khăn sạch (ưu tiên khăn chuyên dụng cho ô tô) bôi 1 lớp kem.</li><li>Bước 3: Nên bôi kem theo vòng tròn để đạt hiệu quả cao nhất.</li><li>Bước 4: Chùi lại bằng khăn khô, sạch</li><li>Hạn chế rửa xe sau 8h, Lớp bóng giữ được khoảng 6 tháng - 1 năm (tùy mức độ sử dụng)</li><li>Sử dụng ở nơi thoáng mát tránh ánh nắng mặt trời và theo từng bước như trên.</li></ul><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/5c/46/6c/4a99845db380608442fea2e1faadbd3b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/5c/46/6c/4a99845db380608442fea2e1faadbd3b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/5c/46/6c/4a99845db380608442fea2e1faadbd3b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5c/46/6c/4a99845db380608442fea2e1faadbd3b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5c/46/6c/4a99845db38060