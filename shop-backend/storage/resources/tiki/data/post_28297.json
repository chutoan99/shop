t.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/36/ef/3d/bad3782ec6f739c6fecae1c75cf151cf.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":186,"all_time_quantity_sold":13,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e Cập nhật bổ sung Tập 20 mới nhất phát hành 5/4/2024 !!!!\u003c/p\u003e\n\u003cp\u003e-------------\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color:#003300;\"\u003e\u003cstrong\u003eTruyện tranh Dragon Ball Super\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003eDragon Ball Super với cốt truyện của tác giả Akira Toriyama và nét vẽ đầy mới mẻ của họa sĩ Toyotarou là phần tiếp nối của bộ truyện Dragon Ball, kể tiếp câu chuyện còn dang dở sau trận chiến với Ma Buu.\u003c/p\u003e\n\u003cp\u003eSau khi Trái Đất lập lại hòa bình không lâu, có 2 kẻ lạ mặt xuất hiện dò tìm thông tin về Siêu Saiya Thần Thánh, nhưng Goku và nhóm bạn không ai hay biết gì về nhân vật này. Hai bên đã có một màn “đánh chào hỏi” nhưng phe Trái Đất đã thua chóng vánh trước 2 kẻ lạ mặt đó. Tất cả đều không khỏi sốc khi biết họ chính là Thần Hủy Diệt cùng cộng sự, người được cho là mạnh nhất toàn bộ vũ trụ.\u003c/p\u003e\n\u003cp\u003eSự kiện này sau đó cũng mở ra 1 cốt truyện mới vô cùng mở với thế giới 7 viên ngọc rồng, có tận 12 vũ trụ cùng biết bao nhân vật, chiến binh mới. Goku cùng nhóm bạn lại bước vào hành trình chinh phục các giới hạn sức mạnh, chiến đấu với cái ác để bảo vệ những điều thân thương.\u003c/p\u003e\n\u003cp\u003e-----------------------------------\u003c/p\u003e\n\u003cp\u003eTác Giả: Akira Toriyama \u0026amp; Toyotarou\u003c/p\u003e\n\u003cp\u003eDịch Giả: Barbie Ayumi \u0026amp; Admin Kej\u003c/p\u003e\n\u003cp\u003eHình Thức: Bìa Mềm\u003c/p\u003e\n\u003cp\u003eSố Trang: 192/Cuốn\u003c/p\u003e\n\u003cp\u003eKích Thước: 11 x 17 cm\u003c/p\u003e\n\u003cp\u003eNgày Xuất Bản: 2023-2024\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/36/ef/3d/bad3782ec6f739c6fecae1c75cf151cf.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/36/ef/3d/bad3782ec6f739c6fecae1c75cf151cf.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/36/ef/3d/bad3782ec6f739c6fecae1c75cf151cf.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/36/ef/3d/bad3782ec6f739c6fecae1c75cf151cf.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/36/ef/3d/bad3782ec6f739c6fecae1c75cf151cf.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/77/49/ea/4a53affdeb82a060687a7dd6c0eb566c.jpeg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/77/49/ea/4a53affdeb82a060687a7dd6c0eb566c.jpeg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/77/49/ea/4a53affdeb82a060687a7dd6c0eb566c.jpeg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/77/49/ea/4a53affdeb82a060687a7dd6c0eb566c.jpeg","thumbnail_url":"https://salt.tikicdn.com/cache/2