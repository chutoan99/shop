596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.6,"review_count":12,"review_text":"(12)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/c9/d1/b0/6cbe974ed5fd32a368358b09b74b6fd9.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":443,"all_time_quantity_sold":88,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/17/07/0a/1d8fec113115e3f146420b3d3e12380f.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch3\u003eTrà cốm lợi sữa HiPP dành cho phụ nữ cho con bú (5 gói x 8g)\u003c/h3\u003e\n\u003ch3\u003eThông tin sản phẩm\u003c/h3\u003e\n\u003cp\u003e- Model: G5.2348.00\u003cbr /\u003e- Xuất xứ: Thụy sỹ hoặc Hungary (Tùy theo đợt nhập hàng)\u003cbr /\u003e- Dòng sản phẩm: Trà DD HiPP dành cho phụ nữ cho con bú\u003cbr /\u003e- Khối lượng: 5 gói x 8g\u003cbr /\u003e- Hạn sử dụng: 2 năm.\u003cbr /\u003e\u0026#34;Sản phẩm không phải là thuốc và không có chức năng thay thế thuốc chữa bệnh\u0026#34;.\u003c/p\u003e\n\u003ch3\u003eThành phần\u003c/h3\u003e\n\u003cp\u003eDextrose, maltodextrin, hương cỏ chanh, các chiết xuất từ hoa mật, cây tầm ma, cây carum (son dưỡng dầu), cây hồi, thìa là\u003c/p\u003e\n\u003ch3\u003eĐối tượng sử dụng\u003c/h3\u003e\n\u003cp\u003eBà mẹ cho con bú, dành cho mẹ sau sinh\u003c/p\u003e\n\u003ch3\u003eĐặc điểm sản phẩm\u003c/h3\u003e\n\u003cp\u003e- Sản phẩm là thức uống bổ dưỡng dạng cốm cho sản phụ\u003cbr /\u003e- Có tác dụng bồi bổ cơ thể, giải khát, giảm viêm nhiễm, giúp bà mẹ cho con bú ăn ngon miệng, đặc biệt hỗ trợ hoạt động của các tuyến sữa tốt hơn, tăng cường lượng sữa\u003cbr /\u003e- Nên uống ngay sau khi sinh và uống thường xuyên để đem lại hiệu quả lợi sữa tốt nhất\u003cbr /\u003e- Sản phẩm không chứa phẩm màu, hương liệu nhân tạo, chất bảo quản, và đặc biệt không chứa Gluten\u003c/p\u003e\n\u003ch3\u003eHướng dẫn sử dụng\u003c/h3\u003e\n\u003cp\u003e- Mỗi lần uống, pha 200ml nước đun sôi để ấm hoặc nước mát với khoảng 4 thìa trà sản phụ, khuấy cho tan đều rồi uống\u003cbr /\u003e- Uống từ 2-3 cốc (500ml mỗi ngày)\u003cbr /\u003e- Mức pha chuẩn: Pha 4g trà cốm hòa tan với 100 ml nước uống\u003c/p\u003e\n\u003ch3\u003eĐôi nét về thương hiệu\u003c/h3\u003e\n\u003cp\u003eHiPP là một trong những thương hiệu hàng đầu tại Đức, chuyên về các dòng thực phẩm dinh dưỡng hoàn toàn hữu cơ cho mẹ và bé. Chúng tôi thấu hiểu rằng trong giai đoạn đầu đời, các bậc phụ huynh luôn mong muốn đem đến cho con mình những nguồn dinh dưỡng tốt nhất cho sự phát triển khỏe mạnh của bé. Do đó, phương châm làm việc và niềm đam mê của Hipp luôn là mang đến những giá trị sống cũng như chất lượng sản phẩm tốt nhất cho người tiêu dùng. Không chỉ kiểm soát nghiêm ngặt trong quá trình sản xuất, mỗi sản phẩm của HiPP đều trải qua hơn 260 công đoạn kiểm tra gắt gao và hơn 1300 cuộc kiểm nghiệm kỹ càng, từ nguyên liệu đầu vào cho tới sản phẩm trước khi đưa đến tay người tiêu dùng.\u003c/p\u003e\n\u003cp\u003eHiPP sở hữu nhiều loại sản phẩm phong phú, từ sữa công thức, nước quả nguyên chất đến thức ăn dặm và các loại thịt đều được làm từ nguyên liệu siêu sạch, thơm ngon và bổ dưỡng\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/c9/d1/b0/6cbe974ed5fd32a368358b09b74b6fd9.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c9/d1/b0/6cbe974ed5fd32a368358b09b74b6fd9.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c9/d1/b0/6cbe974ed5fd32a368358b09b74b6fd9.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c9/d1/b0/6cbe974ed5fd32a368358b09b74b6fd9.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c9/d1/b0/6cbe974ed5fd32a368358b09b74b6fd9.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/17/07/0a/3d16f9d3890e1ad22fb18f204e46e9e9.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/17/07/0a/3d16f9d3890e1ad22fb18f204e46e9e9.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/17/07/0a/3d16f9d3890e1ad22fb18f204e46e9e9.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/17/07/0a/3d16f9d3890e1ad22fb18f204e46e9e9.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/17/07/0a/3d16f9d3890e1ad22fb18f204e46e9e9.png"},{"base_url":"https://salt.tikicdn.com/ts/product/44/0f/51/750f619300251b30b072cccd8dea2a1b.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/44/0f/51/750f619300251b30b072cccd8dea2a1b.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/44/0f/51/750f619300251b30b072cccd8dea2a1b.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/44/0f/51/750f619300251b30b072cccd8dea2a1b.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/44/0f/51/750f619300251b30b072cccd8dea2a1b.png"},{"base_url":"https://salt.tikicdn.com/ts/product/46/af/c6/8e95e1d5558406f57d1a60686cb9b2cf.jpg","is_gallery":true,"label":null,"large_url":"h