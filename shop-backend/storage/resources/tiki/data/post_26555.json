không? Vậy đâu là các chuẩn mực chuyên nghiệp cần thiết trong những lĩnh vực trọng yếu để có thể đạt thành tựu then chốt trên đường kiến dựng sự nghiệp bản thân và của tổ chức? \u003c/p\u003e \n  \u003cp class=\"text-justify\"\u003eTa chỉ có thể làm chủ những gì tùy thuộc ở bản thân, chứ không thể làm chủ những thứ không thuộc về mình: ta không thể làm chủ được gió nhưng có thể làm chủ cánh buồm. Và khi ta biết định hướng cánh buồm, khác gì điều khiển được gió?! Ta không thể làm chủ khoảng cách giữa nơi đi và chốn đến, nhưng làm chủ được cách mình bước chân. Và khi làm chủ được phương thức đi đứng của mình, khác chi mình đang vẽ lại con đườ \u003c/p\u003e\n \u003c/body\u003e\n\u003c/html\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/37/55/99/94170ea83b39f444dfaa7b575c20f5d2.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/37/55/99/94170ea83b39f444dfaa7b575c20f5d2.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/37/55/99/94170ea83b39f444dfaa7b575c20f5d2.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/37/55/99/94170ea83b39f444dfaa7b575c20f5d2.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/37/55/99/94170ea83b39f444dfaa7b575c20f5d2.jpg"}],"warranty_policy":null,"authors":[{"id":45082,"name":"Tôn Thất Nguyễn Thiêm","slug":"ton-that-nguyen-thiem"}],"current_seller":{"id":193159,"sku":"2952621007548","name":"Cửa hàng sách Nhà Xuất Bản Trẻ","link":"https://tiki.vn/cua-hang/cua-hang-sach-nha-xuat-ban-tre","logo":"https://vcdn.tikicdn.com/ts/seller/24/02/21/fe8f7162e27b6babe88ea6bfd500da46.jpg","price":88000,"product