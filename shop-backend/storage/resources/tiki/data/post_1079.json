"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.5,"review_count":8,"review_text":"(8)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/c9/79/bf/2d3ea9b9fbc4887ad1681bf621805b96.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1246,"all_time_quantity_sold":27,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<h3>Giới thiệu Địu trẻ em Aprica Pitta Beige an toàn tiện dụng cho bé</h3>\n<p><strong>Địu Trẻ Em Aprica Pitta</strong> được làm từ chất liệu sợi đan và mặt lưới polyeste mềm mại và thoáng khí, phù hợp cho trẻ từ sơ sinh đến 3 tuổi (tương đương 15kg). Với thiết kế độc đáo, địu có thể sử dụng theo 4 cách: địu ngang, địu thẳng, địu sau lưng và địu quay mặt ra trước tùy theo từng độ tuổi. Bên cạnh đó, sản phẩm còn có mũ che đầu, nhẹ nhàng bảo vệ đầu của bé và đệm lưng an toàn củng cố vững chắc tư thế của bé. Aprica Pitta trọng lượng nhẹ giúp bạn dễ dàng gấp lại và cất trong túi xách khi ra ngoài.</p>\n<p>Sản phẩm có 3 màu: đen, nâu và tím.</p>\n<p><img src=\"https://salt.tikicdn.com/ts/tmp/b8/97/df/582d3534ea077a8b1b5bf42b903aa718.png\" alt=\"\" width=\"600\" height=\"600\" /></p>\n<h3>Đặc điểm nổi bật</h3>\n<ul><li>Địu Aprica Nhật phù hợp với sự phát triển của trẻ, có thể sử dụng trong thời gian dài từ khi bé mới sinh.</li><li>Vừa vặn, vững chắc và tạo sự an tâm. </li><li>Phù hợp hoàn hảo cho tinh thần và cơ thể bé.</li><li>Đệm lưng an toàn, củng cố vững chắc tư thế của bé khi bé nằm ở tư thế địu ngang.</li><li>Mũ che đầu nhẹ nhàng bảo vệ đầu của bé.</li><li>Đai vai tròn vừa vặn với đường cong của vai mẹ một cách hoàn hảo.</li><li>Đệm hình chữ S ở phần đáy địu duy trì tư thế tự nhiên cho phần hông của bé</li><li>Phần tiếp xúc trực tiếp với da bé được làm từ các sợi đan, đem lại cảm giác mềm mại.</li><li>Địu trẻ em Aprica Pitta Beige thiết kế gọn gàng và trong lượng nhẹ, có thể dễ dàng gấp lại và cất ngay ngắn trong túi xách.</li></ul>\n<p> </p>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/3e/34/8c/35cc0b9bde210031036aac0a31c759b2.jpeg\" alt=\"35cc0b9bde210031036aac0a31c759b2.jpeg\" width=\"750\" height=\"750\" /></p>\n<h3>Hướng dẫn sử dụng</h3>\n<p>4 tư thế địu cho bé từ sơ sinh đến khi bé 3 tuổi (15kg)</p>\n<ul><li>\n<p>Tư thế địu <strong>NGANG</strong> Từ sơ sinh đến khi bé đã có thể tự nâng đầu lên (7kg).</p>\n</li><li>\n<p>Tư thế địu <strong>THẲNG</strong> Từ khi bé đã có thể tự nâng đầu lên (4 tháng tuổi) đến 24 tháng tuổi (13kg).</p>\n</li><li>\n<p><strong>Địu sau lưng</strong> từ khi bé có thể tự nâng đầu lên (4 tháng tuổi) đến 36 tháng tuổi (15kg).</p>\n</li><li>\n<p>Tư thế địu <strong>quay mặt ra trước</strong> từ khi bé có thể ngồi thẳng (7 tháng) đến 24 tháng tuổi (13kg).</p>\n</li></ul>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/d2/a8/88/38434cddffe1a70d0691fe1cca4af43a.jpeg\" alt=\"38434cddffe1a70d0691fe1cca4af43a.jpeg\" width=\"750\" height=\"750\" /></p>\n<h3><strong>Thông số kỹ thuật sản phẩm</strong></h3>\n<ul><li>\n<p>Nhà sản xuất <strong>Aprica</strong> - <strong>Nhật Bản</strong>.</p>\n</li><li>\n<p>Sản xuất Trung Quốc - Nhập khẩu trực tiếp từ Nhật Bản.</p>\n</li><li>\n<p>Màu sắc: 3 màu be, màu tím và màu đen</p>\n</li><li>\n<p>Kích thước <strong>280 x 350 mm</strong>.</p>\n</li><li>\n<p>Chất liệu Sợi đan, mặt lưới polyeste.</p>\n</li><li>\n<p>Độ tuổi sử dụng trẻ từ <strong>sơ sinh đến 36 tháng tuổi</strong>.</p>\n</li></ul>\n<h3>Thông tin thương hiệu</h3>\n<p><strong>Aprica</strong> là thương hiệu sản xuất xe đẩy và các phương tiện di chuyển cho trẻ em danh tiếng đến từ Nhật Bản. Đây cũng là công ty tiên phong trong lĩnh vực nghiên cứu và ứng dụng các tiêu chuẩn an toàn cho trẻ em vào sản phẩm của mình. Tại Nhật Bản, một trong những khách hàng đặc biệt nhất của <strong>Aprica</strong> chính là gia đình Hoàng Gia, đây chính là sự chứng thực rõ ràng cho uy tín và danh tiếng bền vững của thương hiệu. Thiết kế hiện đại đầy phong cách cùng tính năng an toàn và ưu việt là những đặc điểm nổi trội của <strong>Aprica</strong> so với các sản phẩm khác.</p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/c9/79/bf/2d3ea9b9fbc4887ad1681bf621805b96.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c9/79/bf/2d3ea9b9fbc4887ad1681bf621805b96.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c9/79/bf/2d3ea9b9fbc4887ad1681bf621805b96.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c9/79/bf/2d3ea9b9fbc4887ad1681bf621805b96.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c9/79/bf/2d3ea9b9fbc4887ad1681bf621805b96.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/d3/ae/b0/9ef5c353088a7e59a129b0801cdad6d0.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d3/ae/b0/9ef5c353088a7e59a129b0801cdad6d0.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d3/ae/b0/9ef5c353088a7e59a129b0801cdad6d0.jpg","position":null,"small_url":"https://salt.tikicd