l,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":30000,"discount_rate":30,"rating_average":4.8,"review_count":57,"review_text":"(57)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/c9/b2/42/9fb32939f89126b1ea95844ae42cbef5.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1279,"all_time_quantity_sold":277,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003ePhin Nhôm Pha Cà Phê là loại phin được sử dụng loại nhôm cao cấp, thích hợp cho việc giữ nhiệt tốt, tỏa nhiệt đều\u003cbr /\u003eSử dụng công bằng công nghệ anod hoá đảm bảo sức khỏe cho người tiêu dùng và độ thẩm mỹ cao\u003cbr /\u003eBề mặt phin được xử lý bằng công nghệ xi dương cực (Anodizing) giúp chống ăn mòn, bảo vệ bề mặt, sử dụng lâu bền\u003cbr /\u003eCó vạch mức trong thân phin để định lượng 20gr cà phê / tách.\u003cbr /\u003eSản phẩm không bị ố đen, hoen rỉ, bộ lọc không bị oxi hóa khi sử dụng lâu dài, đảm bảo sức khỏe cho người sử dụng và không làm ảnh hưởng đến hương vị cà phê.\u003cbr /\u003eDùng phin cafe nhôm cao cấp này để pha Cà phê, Trang trí, quà tặng hay sưu tầm đều tuyệt đẹp.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003ePha cà phê thoạt nhìn thì có vẻ rất đơn giản, nhưng sự thật không phải như vậy đâu nha. Nếu không có kinh nghiệm trong pha chế món thức uống này, bạn sẽ làm hỏng một cốc cà phê vừa mất công, lại phí phạm. Cách pha cà phê phin ngon không đơn thuần là cho cà phê và đổ nước vào phin là xong đâu, phải thực hiện đúng các bước mới cho ra một ly cà phê thơm ngon đó.\u003c/p\u003e\n\u003ch3\u003e \u003c/h3\u003e\n\u003cp\u003eTrộn đều cà phê và cho vào phin khoảng 20 - 25g bột cà phê. Sau đó, lắc và \u003cstrong\u003egõ nhẹ vào thân phin\u003c/strong\u003e để loại bỏ không khí thừa và khoảng trống bên trong phin.\u003c/p\u003e\n\u003cp\u003eDùng ngón tay \u003cstrong\u003evuốt nhẹ dưới đáy thân phin\u003c/strong\u003e để loại bỏ những hạt cà phê thừa rồi đặt thân phin lên nắp phin.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eMàu sắc khác nhau trong từng đợt đặt hàng.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/c9/b2/42/9fb32939f89126b1ea95844ae42cbef5.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c9/b2/42/9fb32939f89126b1ea95844ae42cbef5.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c9/b2/42/9fb32939f89126b1ea95844ae42cbef5.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c9/b2/42/9fb32939f89126b1ea95844ae42cbef5.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c9/b2/42/9fb32939f89126b1ea95844ae42cbef5.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/d7/fe/3f/df440d60cb30782454111244503785aa.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d7/fe/3f/df440d60cb30782454111244503785aa.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d7/fe/3f/df440d60cb30782454111244503785aa.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d7/fe/3f/df440d60cb30782454111244503785aa.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d7/fe/3f/df440d60cb30782454111244503785aa.jpg"},{"base_url":"https://salt.tikicdn.com/t