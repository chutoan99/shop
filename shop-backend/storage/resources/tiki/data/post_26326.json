roduct/0b/e2/b1/793f570f620cc68c8feb0f7bdf108236.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/82/fb/da/029cbeaba2f740cca6fe599914402dfc.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/82/fb/da/029cbeaba2f740cca6fe599914402dfc.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/82/fb/da/029cbeaba2f740cca6fe599914402dfc.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/82/fb/da/029cbeaba2f740cca6fe599914402dfc.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/82/fb/da/029cbeaba2f740cca6fe599914402dfc.jpg"}],"warranty_policy":null,"brand":{"id":248569,"name":"Deltaplus","slug":"deltaplus"},"current_seller":{"id":190819,"sku":"9105582502655","name":"BHLĐ XSAFE","link":"https://tiki.vn/cua-hang/bhld-xsafe","logo":"","price":165000,"product_id":"111410267","store_id":177852,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Operation","attributes":[{"code":"is_warranty_applied","name":"Sản phẩm có được bảo hành không?","value":"Không"}]},{"name":"Content","attributes":[{"code":"brand","name":"Thương hiệu","value":"Deltaplus"},{"code":"brand_country","name":"Xuất xứ thương hiệu","value":"Pháp"},{"code":"capacity","name":"Dung tích","value":"500ml"},{"code":"chat_lieu","name":"Chất liệu","value":"\u003cp\u003eTròng kính Polycarbonate có khả năng chống va đập và chống vỡ vụn vượt trội so với nhựa CR-39 và thủy tinh.\u003c/p\u003e"},{"code":"huong_dan_bao_quan","name":"Hướng dẫn bảo quản","value":"\u003cp\u003e- Sử dụng hộp đựng dành riêng cho kính khi không sử dụng.\u003c/p\u003e\n\u003cp\u003e- Chuẩn bị khăn mềm để vệ sinh kính thường xuyên, vệ sinh kính ít nhất 1 lần/ngày.\u003c/p\u003e\n\u003cp\u003e- Ngoài lúc sử dụng khi làm việc, bạn không nên để kính ở nơi có nhiệt độ quá cao khiến kính hư hại.\u003c/p\u003e\n\u003cp\u003e- Nên trang bị dung dịch vệ sinh mắt kính để rửa sạch kính thường xuyên hơn.\u003c/p\u003e"},{"code":"huong_dan_su_dung","name":"Hướng dẫn sử dụng","value":"\u003cp\u003eĐể đảm bảo tầm quan trọng của kính bảo hộ, việc sử dụng chúng một cách đúng cách là hết sức quan trọng. Dưới đây, chúng ta sẽ cung cấp hướng dẫn chi tiết để bạn có thể sử dụng kính bảo hộ một cách an toàn và hiệu quả, đảm bảo bảo vệ đôi mắt của mình trong môi trường làm việc:\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCách đeo kính một cách chính xác và thoải mái\u003c/strong\u003e\u003cbr /\u003eĐể đảm bảo rằng kính bảo hộ cao cấp phục vụ mục đích bảo vệ tốt nhất, việc đeo chúng một cách chính xác và thoải mái là điều vô cùng quan trọng. Đầu tiên, bạn cần đảm bảo rằng kính vừa vặn hoàn hảo với khuôn mặt của mình. Một sự vừa vặn hoàn hảo giúp đảm bảo rằng kính không bị lệch, lỏng lẻo, hoặc quá chặt, bởi những vấn đề này có thể làm ảnh hưởng đến tầm nhìn và cảm giác thoải mái khi làm việc. Điều này đặc biệt quan trọng khi bạn đang làm việc trong môi trường đầy nguy cơ, nơi mà bảo vệ đôi mắt của bạn là ưu tiên hàng đầu.\u003c/p\u003e\n\u003cp\u003eHãy chắc chắn rằng bạn đã điều chỉnh kính sao cho chúng vừa vặn với mũi và cầu mắt của bạn. Nếu kính quá chặt, bạn có thể cảm thấy không thoải mái và đau đớn. Ngược lại, nếu chúng quá lỏng, chúng có thể bị mất trong quá trình làm việc hoặc không thể đảm bảo sự bảo vệ cần thiết. Cân nhắc việc điều chỉnh kính để đảm bảo sự thoải mái và an toàn tối ưu.\u003c/p\u003e"},{"code":"item_model_number","name":"Model","value":"Galeras"},{"code":"kich_thuoc","name":"Kích thước (Dài x Rộng x Cao)","value":"15 x 10 x 10"},{"code":"origin","name":"Xuất xứ (Made in)","value":"Trung Quốc"},{"code":"product_weight","name":"Trọng lượng sản phẩm","value":"0.1"}]}],"product_links":[],"gift_item_title":"0 quà tặng kèm","configurable_options":[{"code":"option1","name":"Màu Tròng Kính","position":0,"show_preview_image":true,"values":[{"label":"Khói"},{"label":"Trắng"}]}],"configurable_products":[{"child_id":111410266,"discount_rate":0,"id":