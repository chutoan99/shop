ơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e\u003cp\u003eSản phẩm này là tài sản cá nhân được bán bởi Nhà Bán Hàng Cá Nhân và không thuộc đối tượng phải chịu thuế GTGT. Do đó hoá đơn VAT không được cung cấp trong trường hợp này.\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/dc/b8/61/0e70a55c56ad07995090f776b945d311.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/dc/b8/61/0e70a55c56ad07995090f776b945d311.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/dc/b8/61/0e70a55c56ad07995090f776b945d311.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/dc/b8/61/0e70a55c56ad07995090f776b945d311.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/dc/b8/61/0e70a55c56ad07995090f776b945d311.png"},{"base_url":"https://salt.tikicdn.com/ts/product/a2/10/64/32c872dedf643f412665fb649313f0f6.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a2/10/64/32c872dedf643f412665fb649313f0f6.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a2/10/64/32c872dedf643f412665fb649313f0f6.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a2/10/64/32c872dedf643f412665fb649313f0f6.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a2/10/64/32c872dedf643f412665fb649313f0f6.png"}],"warranty_policy":null,"brand":{"id":165009,"name":"Nexgard","slug":"nexgard"},"current_seller":{"id":288448,"sku":"6684271954736","name":"Shop 24 H","link":"https://tiki.vn/cua-hang/shop-24-h","logo":"https://vcdn.tikicdn.com/ts/seller/a5/20/40/58875178f4fb83995785cadc644640c5.jpg","price":705000,"product_id":"196343317","store_id":275719,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Content","attributes":[{"code":"brand","name":"Thương hiệu","value":"Nexgard"},{"code":"brand_c