56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":65000,"discount_rate":33,"rating_average":5,"review_count":105,"review_text":"(105)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/de/4f/33/3ab516f8a6f50770c31fd937e68706c9.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":747,"all_time_quantity_sold":756,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cdiv class=\"m8h3af8h l7ghb35v kjdc1dyq kmwttqpk gh25dzvf n3t5jt4f\"\u003e\n\u003cdiv\u003eCáp sạc siêu nhanh 100W Remax RC-183c chiều dài 2m\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"l7ghb35v kjdc1dyq kmwttqpk gh25dzvf jikcssrz n3t5jt4f\"\u003e\n\u003cdiv\u003e\n\u003cul\u003e\u003cli\u003eCáp sạc nhanh 100W 2m Remax RC-183c type C to type C 30 phút đầy 74% pin.\u003c/li\u003e\n\u003cli\u003eMã sản phẩm: RC183c\u003c/li\u003e\n\u003cli\u003eCáp dài 2 mét, chống rối, siêu bền\u003c/li\u003e\n\u003cli\u003eCổng sạc Type C to Type C\u003c/li\u003e\n\u003cli\u003eChip sạc thông minh chống quá dòng, quá nhiệt\u003c/li\u003e\n\u003c/ul\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"l7ghb35v kjdc1dyq kmwttqpk gh25dzvf jikcssrz n3t5jt4f\"\u003e\n\u003cdiv\u003e\n\u003cp\u003eVới công suất 100W chuẩn PD và chiều dài 2m, \u003cstrong\u003ecáp sạc nhanh 100W 2m Remax RC-183c\u003c/strong\u003e giúp bạn thoải mái sạc siêu tốc cho nhiều thiết bị như smartphone, laptop hay tablet (có cổng sạc type C). Nếu bạn đang đi tìm một mẫu cáp sạc có độ dài lớn và công suất cao thì hãy cùng iCybernet tìm hiểu mẫu cáp này ngay sau đây.\u003c/p\u003e\n\u003cp\u003e\u003c/p\u003e\n\u003ch2\u003eCáp sạc nhanh 100W 2m Remax RC-183c chuẩn PD\u003c/h2\u003e\n\u003cp\u003eThiết kế 2 đầu sạc ra và vào Type C, Remax RC-183c có thể sử dụng đồng thời 2 chiều vô cùng thuận tiện. Bạn có thể sử dụng cho bất kỳ củ sạc nào có cổng type C chuẩn PD hiện nay trên thị trường. Remax RC-183c hỗ trợ sạc nhanh 100W, bạn có thể sử dụng cáp sạc này cho tất cả các thiết bị có cổng sạc Type C hiện nay như laptop, tablet hay smartphone, tai nghe bluetooth, loa,… vô cùng tiện dụng.\u003c/p\u003e\n\u003cp\u003e\u003c/p\u003e\n\u003cp\u003eThay vì độ dài tiêu chuẩn 1m như các mẫu cáp khác, Remax thiết kế cho mẫu cáp sạc nhanh này chiều dài 2m phù hợp hơn đối với người dùng laptop hay tablet hoặc cần những chiếc cáp có độ dài lớn. Với Remax RC-183c bạn có thể thoải mái sử dụng mà không lo giới hạn về độ dài cũng như công suất sạc.\u003c/p\u003e\n\u003ch2\u003eCáp sạc nhanh 100W 2m Remax RC-183c bền bỉ, chống rối\u003c/h2\u003e\n\u003cp\u003eRemax RC-183c được Remax thiết kế với lõi dẫn điện siêu bền bọc PC và PVC cách điện. PVC cao cấp có độ mềm dẻo cao, đồng thời dây cáp cũng dày dặn, chắc chắn hơn so với những loại cáp sạc thông thường khác. Phần đầu cáp gia cố chắc chắn giúp bạn dễ dàng cầm nắm, thao tác mà không lo đứt gãy ngầm.\u003c/p\u003e\n\u003cp\u003e\u003c/p\u003e\n\u003cp\u003eNgoài ra, cáp cũng được Remax trang bị khả năng chống rối tốt. Bạn có thể thoải mái quấn, gập cáp bỏ túi mà không lo lắng cáp bị rối.\u003c/p\u003e\n\u003cp\u003e\u003c/p\u003e\n\u003ch2\u003eRemax RC-183c sở hữu chip sạc thông minh, truyền dữ liệu siêu tốc\u003c/h2\u003e\n\u003cp\u003eBên cạnh khả năng sạc nhanh 100W tương đương 5A, Remax RC-183 còn được tích hợp khả năng truyền dữ liệu 480mbps, giúp người dùng truyền nhanh khoảng 1GB dữ liệu chỉ mất chưa đầy 5 phút. Đồng thời, Remax RC-183c cũng được trang bị chip sạc thông minh có khả năng nhận diện dòng điện, tự động cho ra công suất điện phù hợp với thiết bị. Nhờ đó việc sạc nhanh smartphone, tablet hay laptop của bạn sẽ luôn an toàn, ổn định, không lo quá nhiệt hay quá dòng.\u003c/p\u003e\n\u003cp\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003eCáp sạc nhanh 100W 2m Remax RC-183c\u003c/em\u003e type C to type C chuẩn PD đang được phân phối chính hãng tại hệ thống iCybernet toàn quốc. Đặc biệt \u003cspan style=\"color:#0000ff;\"\u003e\u003cstrong\u003eiCybernet\u003c/strong\u003e\u003c/span\u003e bảo hành 1 năm, 1 đổi 1 trong tháng đầu, bao xài 7 ngày cho bạn trải nghiệm sản phẩm\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/de/4f/33/3ab516f8a6f50770c31fd937e68706c9.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/de/4f/33/3ab516f8a6f50770c31fd937e68706c9.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/de/4f/33/3ab516f8a6f50770c31fd937e68706c9.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/de/4f/33/3ab516f8a6f50770c31fd937e68706c9.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/de/4f/33/3ab516f8a6f50770c31fd937e68706c9.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/5e/92/86/2bb7fd9aeb7edb7e2349c327bc553100.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/5e/92/86/2bb7fd9aeb7edb7e2349c327bc553100.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/5e/92/86/2bb7fd9aeb7edb7e2349c327bc553100.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5e/92/86/2bb7fd9aeb7edb