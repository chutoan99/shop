dth":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/13/6b/39/fea3c76997c254e603e45ff91757115a.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":559,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003eMáy ép trái cây dùng ép nước triệt để trái cây, rau củ để cho ra những ly nước ép thơm ngon, giàu dinh dưỡng\u003c/h3\u003e\n\u003cp\u003eThiết kế hiện đại, sang trọng, đẹp mắt trong không gian dùng. Thân máy bằng chất liệu nhựa cao cấp sang trọng dễ .\u003c/p\u003e\n\u003ch3\u003eCông suất 300 W ép nhanh chóng\u003c/h3\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch3\u003eLưỡi dao bằng chất liệu thép không gỉ sắc bén nghiền tốt mọi nguyên liệu\u003c/h3\u003e\n\u003ch3\u003eỐng tiếp nguyên liệu lớn \u003c/h3\u003e\n\u003cp\u003eBạn có thể dễ dàng cho một lượng lớn rau củ quả vào máy để xay ép mà không cần phải thái nhỏ nguyên liệu.\u003c/p\u003e\n\u003cp\u003eĐường kính ống nhồi thực phẩm lớn giúp bạn có thể ép nguyên trái đối với các loại củ quả cỡ vừa và nhỏ như cà rốt, dâu,\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch3\u003eSử dụng đơn giản với nút vặn gồm 2 tốc độ\u003c/h3\u003e\n\u003cp\u003e được trang bị 2 tốc độ ép. Với tốc độ số 1 dùng để ép những loại trái cây mềm như: nho, dâu, Tốc độ số 2 dùng để ép những loại trái cây cứng hơn như: táo, ổi, cà rố\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch3\u003eAn toàn khi sử dụng\u003c/h3\u003e\n\u003cp\u003e HR1811 còn có chức năng tự ngắt điện khi động cơ hoạt động quá lâu giúp giảm thiểu các nguy cơ hỏng động cơ và an toàn cho người sử dụng.\u003c/p\u003e\n\u003cp\u003eMáy được trang bị chân đế chống trượt hạn chế rung lắc trong quá trình sử dụng. Bên cạnh đó, khớp khóa an toàn cũng giúp máy chắc chắn, máy chỉ hoạt động khi các bộ phận được lắp đúng và khớp khóa được gài vào.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eLưu ý khi sử dụng máy ép trái cây:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Kiểm tra lại thiết bị và nguồn điện trước khi cho máy hoạt động để đảm bảo chắc chắn các bộ phận của máy đã được lắp ráp chính xác, đúng khớp với nhau và chỉ sử dụng máy trong tình trạng khô ráo, sạch sẽ để tránh chập điện hay cháy nổ.\u003c/p\u003e\n\u003cp\u003e- Không nên ép các loại trái cây mềm nhão như chuối, mít, mãng cầu, vì bã trái cây mềm sẽ bít các lỗ nhỏ li ti trên lưới lọc, không cho ra nước ép.\u003c/p\u003e\n\u003cp\u003e- Nên cho trái cây vào từ từ và chỉ cho lượng vừa đủ để tránh đùn ép nhanh gây kẹt nguyên liệu và bã thải không kịp thoát ra bị giữ lại sẽ gây tình trạng nghẽn ép không ra nước hoặc ít nước.\u003c/p\u003e\n\u003cp\u003e- Những loại máy có công suất lớn cho phép ép luôn cả hạt và vỏ nhưng tốt nhất vẫn nên bỏ hạt, bỏ vỏ cứng trước khi ép để tốt cho máy và không làm ảnh hưởng tới mùi vị nước ép.\u003c/p\u003e\n\u003cp\u003e- Vệ sinh máy ngay sau khi sử dụng để các loại thịt quả và đường ngọt không khô cứng và bám chặt vào các chi tiết máy.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThông số sản phẩm:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Công suất: 350W\u003c/p\u003e\n\u003cp\u003e- Điện áp: 220-240 V\u003c/p\u003e\n\u003cp\u003e- Chất liệu vỏ máy: nhựa PP\u003c/p\u003e\n\u003cp\u003e- Chất liệu nắp: Nhựa kháng vỡ\u003c/p\u003e\n\u003cp\u003e- Tốc độ: 2\u003c/p\u003e\n\u003cp\u003e- Ly đựng nước: 500 ml\u003c/p\u003e\n\u003cp\u003e- Dây điện: 1.2m\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/13/6b/39/fea3c76997c254e603e45ff91757115a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/13/6b/39/fea3c76997c254e603e45ff91757115a.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/13/6b/39/fea3c76997c254e603e45ff91757115a.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/13/6b/39/fea3c76997c254e603e45ff91757115a.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/13/6b/39/fea3c76997c254e603e45ff91757115a.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/5b/dc/11/fd4bd5079290ace6568670df027ad6aa.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/5b/dc/11/fd4bd5079290ace6568670df027ad6aa.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/5b/dc/11/fd4bd5079290ace6568670df027ad6aa.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5b/dc/11/fd4bd5079290ace6568670df027ad6aa.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5b/dc/11/fd4bd5079290ace6568670df027ad6aa.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/3d/97/4e/74692c39d0dfd0cc08becc0c5010d04f.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/3d/97/4e/74692c39d0dfd0cc08becc0c5010d04f.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/3d/97/4e/74692c39d0dfd0cc08becc0c5010d04f.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3d/97/4e/74692c39d0dfd0cc08becc0c5010d04f.jpg","thumbnail_ur