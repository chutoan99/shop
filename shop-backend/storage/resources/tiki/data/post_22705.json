verage":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/71/d4/30/278c69087e13766efc977ac02400180e.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":986,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eThông số kỹ thuật:\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/16/7b/7c/9b51e318fc011ab7cee3391eb692c45e.png\" alt=\"\" width=\"750\" height=\"243\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eƯu điểm nổi bật:\u003c/strong\u003e\u003cbr /\u003e- Công nghệ IGBT\u003cbr /\u003e- Mồi lửa nhanh Hot Start\u003cbr /\u003e- Tự động bù hồ quang Arc Force\u003cbr /\u003e- Công suất đúng 160A\u003cbr /\u003e- Hàn que 3.2mm liên tục. Hàn sướng tay\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/4c/45/c0/59fc32311eddfc9894abdec83010ace2.png\" alt=\"\" width=\"750\" height=\"1060\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eỨng dụng:\u003c/strong\u003e\u003cbr /\u003e- Hàn que 1.6 - 3.2 mm. Hàn liên tục que 3.2mm. Hổ trợ que 4.0 không liên tục\u003cbr /\u003e- Hàn sắt, thép, inox\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cbr /\u003e\u003cstrong\u003eThông tin chi tiết:\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003eMáy hàn điện tử HK 160A được Hồng Ký nghiên cứu và sản xuất ngay tại Việt Nam. Máy nhỏ gọn với trọng lượng 4.6kg, dễ mang vác di chuyển. Được thiết kế công suất phù hợp để sử dụng trong gia đình, xưởng cơ khí nhỏ.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/5c/7c/00/04e07e3f818e5054ae8cd591e71d9cc0.jpeg\" alt=\"\" width=\"750\" height=\"421\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003eHK160A sở hữu nhiều ưu điểm vượt trội, mang lại hiệu quả cao trong quá trình làm việc:\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003e+ Chức năng Mồi lửa nhanh Hot Start:\u003c/strong\u003e Khi chạm que hàn để mồi lửa máy tự động tăng cường dòng điện cực đại giúp dễ dàng mồi lửa và mồi rất nhạy. Đặc biệt giúp hàn tốt trong các điều kiện vật liệu ẩm, que hàn ẩm, bề mặt vật liệu không sạch.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003e+ Chức năng tự động bù hồ quang Arc Force:\u003c/strong\u003e Trong suốt quá trình kéo que hàn sẽ bị ngắt quãng hay bị dính que, máy sẽ tự động cung cấp một dòng điện cực đại để bù hồ quang. Arc Force hỗ trợ ổn định hồ quang, ngăn hồ quang bị ngắt quãng trong khi hàn tạo đường đều đẹp, chống dính que hàn.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e+ Tiết kiệm điện hơn hẳn so với máy hàn que truyền thống.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e+ Hàn dễ dàng, ai cũng có thể sử dụng.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e+ Lắp ráp nhanh chóng, vận hành đơn giản nhờ thiết kế ngoại quan dễ nhìn.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e+ Thời hạn bảo hành 12 tháng, mang đến sự yên tâm cho khách hàng khi sử dụng máy hàn Hồng Ký.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/52/41/50/4ab171d28bd9faa06c83dc3e6574e5d6.png\" alt=\"\" width=\"750\" height=\"410\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003ePhụ kiện đi kèm:\u003c/strong\u003e\u003cbr /\u003e- Kìm hàn 500A\u003cbr /\u003e- Kẹp mát 300A\u003cbr /\u003e- Dây 3m kìm hàn, 2m kẹp mát\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/71/d4/30/278c69087e13766efc977ac02400180e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/71/d4/30/278c69087e13766efc977ac02400180e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/71/d4/30/278c69087e13766efc977ac02400180e.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/71/d4/30/278c69087e13766efc977ac02400180e.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/71/d4/30/278c69087e13766efc977ac02400180e.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/0d/f7/88/4d827ecb98117af62a36abe63c4c32c2.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0d/f7/88/4d827ecb9811