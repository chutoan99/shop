ground_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":2000,"discount_rate":3,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/14/2e/80/5d081ad2ea0f96b9ff5dd9bcd10ae8e3.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":323,"all_time_quantity_sold":5,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<h2><em><strong>Giới thiệu Băng keo cường lực siêu dính 3M khổ 10mm x 10m 4229P-10</strong></em></h2>\n<p><em><strong>Băng keo cường lực siêu dính 3M khổ 10mm x 10m 4229P-10</strong></em> là băng keo của Tập đoàn 3M. </p>\n<p><em><strong>Băng keo cường lực siêu dính 3M khổ 10mm x 10m 4229P-10 </strong></em>là loại băng keo có độ bám dính và đàn hồi rất tốt, chịu được rung động, khả năng kết dính cao, sử dụng trong lắp ráp khung, bộ phận nội ngoại thất ô tô, bảng hiệu, két sắt, phù hợp các bề mặt thép không gỉ, ABS, PVC,…</p>\n<p>Ngoài ra, <em><strong>Băng keo cường lực siêu dính 3M khổ 10mm x 10m 4229P-10</strong></em> còn ứng dụng trong đồ dùng gia đình như dùng dán móc treo tường, dán ốp viền trang trí bàn, ghế...; dán cố định khung tranh lên bàn gỗ, tường gỗ; dán biển số nhà hay các ký tự cho biển quảng cáo...</p>\n<p><em><strong>Sản phẩm được nhập khẩu từ Mỹ  </strong></em></p>\n<p> </p>\n<h2><em><strong>Thông tin sản phẩm</strong></em></h2>\n<ul>\n<li>Tên sản phẩm: <em><strong>Băng keo cường lực siêu dính 3M khổ 10mm x 10m 4229P-10</strong></em></li>\n<li><em>Loại: </em><strong>Băng keo 2 mặt</strong></li>\n<li>Màu sắc: Xám đậm</li>\n<li>Thành phần nguyên liệu chính: Xốp Acrylic</li>\n<li>kích thước: <em><strong>10mm x 10m</strong></em></li>\n<li>Độ dày: <strong>0.76mm</strong></li>\n<li>Đặc điểm nổi bật: \n<ul>\n<li>Chống nhiệt độ (ngắn hạn): 149 °C</li>\n<li>Chống nhiệt độ (dài hạn): 93 °C</li>\n</ul>\n</li>\n<li>Xuất xứ: Nhập khẩu chính hàng từ Mỹ</li>\n<li>Hạn sử dụng: 5 năm kể từ ngày sản xuất.</li>\n</ul>\n<p> </p>\n<p><img src=\"https://salt.tikicdn.com/ts/product/80/c3/c2/43d567cb9b7cdd960a54d2c593468554.jpg?v=1537506187963\" alt=\"tocdo247-com-4229p-3m-68.jpg?v=1537506187963\" /></p>\n<h2> </h2>\n<h2><strong>Hướng dẫn sử dụng</strong></h2>\n<ul>\n<li>Bước 01: Làm sạch kỹ bề mặt cần dán (có thể dùng cồn hay nước lau kính lau sạch và để khô trong 5 phút).</li>\n<li>Bước 02: Cắt băng keo theo chiều dài thích hợp</li>\n<li>Bước 03: Dùng lực ép chặt keo lên bề mặt dán (khoảng <strong>30 - 60 giây</strong>)</li>\n<li>Bước 04: Cố định trong <strong>24h</strong> để đạt hiệu quả cao nhất</li>\n</ul>\n<p> </p>\n<p><img src=\"https://salt.tikicdn.com/ts/product/34/1c/34/1655a58d5c3f95e5ec20c29f5b834e37.jpg?v=1537506186990\" alt=\"tocdo247-com-4229p-3m-67.jpg?v=1537506186990\" /></p>\n<h2> </h2>\n<h2><strong>Lưu ý:</strong></h2>\n<ul>\n<li>Kết dính tốt trên các bề mặt nhựa PVC, ABS, thép không gỉ, nhôm, inox, gốm, gỗ, sứ, sơn.</li>\n<li>Đối với ứng dụng móc treo tường, <strong>không treo vật vào móc trong 24h</strong> để keo bám dính vào bề mặt cho kết quả tốt nhất.</li>\n<li><strong>Không chạm tay vào bề mặt băng keo và bề mặt dán vì mồ hôi tay làm bất hoạt keo dính Acrylic gây nên tình trạng dán dễ bong tróc hay dán không dính như mô tả.</strong></li>\n<li><strong>Độ chịu lực là 100g/cm².</strong></li>\n<li><strong>Không áp dụng trên tường vôi, sơn nước dễ bong tróc, gạch men quá nhẵn bóng và các bề mặt khó dính khác.</strong></li>\n</ul>\n<p> </p>\n<p><strong><img src=\"https://salt.tikicdn.com/ts/product/38/19/85/e8dde3101205f563c77f70d561dcc119.jpg?v=1537506189250\" alt=\"tocdo247-com-4229p-3m-69.jpg?v=1537506189250\" /></strong></p>\n<h2> </h2>\n<h2><strong>Bảo quản: </strong></h2>\n<ul>\n<li><em><strong>Để nơi khô ráo, thoáng mát. Nhiệt độ bảo quản từ 4°C đến 38°C.</strong></em></li>\n<li><em><strong>Tránh ánh nắng trực tiếp, môi trường độ ẩm cao.</strong></em></li>\n</ul><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/14/2e/80/5d081ad2ea0f96b9ff5dd9bcd10ae8e3.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/14/2e/80/5d081ad2ea0f96b9ff5dd9bcd10ae8e3.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/14/2e/80/5d081ad2ea0f96b9ff5dd9bcd10ae8e3.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/14/2e/80/5d081ad2ea0f96b9ff5dd9bcd10ae8e3.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/14/2e/80/5d081ad2ea0f96b9ff5dd9bcd10ae8e3.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/ba/3f/31/d99aeb312bfd9cc8a822170a57d3398b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ba/3f/31/d99aeb312bfd9cc8a822170a57d3398b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ba/3f/31/d99aeb312bfd9cc8a822170a57d3398b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ba/3f/31/d99aeb312bfd9cc8a822170a57d3398b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ba/3f/31/d99aeb312bfd9cc8a822170a57d3398b.jpg"}