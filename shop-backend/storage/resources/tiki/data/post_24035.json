or":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":157000,"discount_rate":37,"rating_average":5,"review_count":217,"review_text":"(217)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/d6/78/4d/6f7d87de5de5b8678ea2ac4fc0b9ac10.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2402,"all_time_quantity_sold":1477,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch1\u003e\u003cstrong\u003eNước khoáng làm dịu da, chống kích ứng Therma Spring Water 300ml\u003c/strong\u003e\u003c/h1\u003e\n\u003cp\u003e\u003cstrong\u003e \u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eXịt khoáng Avene Therma Spring Water với thành phần chủ yếu là nước khoáng thiên nhiên Avène, được lấy trực tiếp từ mạch nước ngầm tại nguồn, hoàn toàn tinh khiết không nhiễm khuẩn, trải qua nhiều công trình nghiên cứu khoa học, nước khoáng làm dịu da chống kích ứng Therma Spring Water đã được chứng minh là có đặc tính làm dịu da, chống kích ứng hiệu quả nhờ thành phần khoáng chất độc đáo và ổn định.\u003c/p\u003e\n\u003cp\u003eChính vì vậy, nước khoáng làm dịu da chống kích ứng Therma Spring Water là sản phẩm làm dịu da chuyên biệt dành cho da nhạy cảm, quá nhạy cảm, kích ứng và dị ứng như da viêm thể tạng, da nhờn - bong vảy, bệnh sùi đỏ da, da nhạy cảm với ánh sáng; hoặc sử dụng cho những làn da đang ở cấp độ kích ứng nhất thời như bỏng nắng, sau phẫu thuật, kích ứng mí mắt, đỏ da, các hình thức trị liệu gây kích ứng da...\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e1. Công dụng:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eKhông chứa các thành phần như parabens, sulfates hay phthalates\u003cbr /\u003eGiúp loại bỏ mồ hôi, muối biển hay chlorine từ hồ bơi trên da\u003cbr /\u003eNhiều kích cỡ 50ml, 150ml, 300ml tiện dụng và tiết kiệm\u003cbr /\u003eỐng phun sương rất mịn và nhẹ nhàng, giúp bạn có thể xịt đều toàn khuôn mặt\u003cbr /\u003eKhông chỉ cung cấp độ ẩm tức thì, sản phẩ còn tạo một màn sương dự trữ nước cho bề mặt da, giúp da luôn mịn màng và tươi mát, đem đến cảm giác êm dịu, sảng khoái, nhanh chóng loại bỏ nguy cơ lão hóa do thiếu độ ẩm.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch4\u003e\u003cstrong\u003eMách nhỏ:\u003c/strong\u003e\u003c/h4\u003e\n\u003cp\u003e-Khác với những gì người ta thường nghĩ, xịt khoáng không hề làm hỏng (nhòe) lớp trang điểm mà nó còn làm lớp trang điểm của bạn được bảo vệ dài lâu hơn. Bạn xịt khoáng sẽ giúp làn da của bạn ăn kem/phấn nền hơn.\u003c/p\u003e\n\u003cp\u003e-Sau khi tẩy trang,bạn nên xịt một chút khoáng chất lên da bởi nó sẽ khiến làm da bạn sạch sẽ hơn. Bên cạnh đó, xịt khoáng sẽ không làm da chúng ta bị mất nước.\u003c/p\u003e\n\u003cp\u003e-Sau khi waxing hay đi ngoài nắng về, da của bạn sẽ có cảm giác bỏng rát, sử dụng xịt khoáng sẽ làm những vùng da này dịu đi và bạn sẽ cảm thấy dễ chịu hơn trông thấy.\u003c/p\u003e\n\u003cp\u003e-Hãy sử dụng xịt khoáng bất kỳ khi nào bạn muốn, nhất là khi bạn thường xuyên phải ngồi trong môi trường điều hòa hay khi phải hoạt động nhiều ngoài trời.\u003c/p\u003e\n\u003cp\u003e-Nước khoáng có tác dụng dưỡng ẩm và làm dịu da rất tốt, tuy nhiên, không thay thế được kem dưỡng ẩm, vì kem dưỡng ẩm ngoài cung cấp độ ẩm cho da còn có tác dụng rất quan trọng là phục hồi hàng rào bảo vệ da. Tốt nhất chúng ta nên xịt nước khoáng trước để cung cấp độ ẩm cho da, sau đó thoa kem dưỡng ẩm để giữ da không bị mất nước\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eTrong quy trình chăm sóc da hàng ngày, nước khoáng làm dịu da chống kích ứng Therma Spring Water đặc biệt phù hợp để dưỡng ẩm da một các nhẹ nhàng và tự nhiên nhất. Bạn nên sử dụng nước khoáng làm dịu da chống kích ứng Therma Spring Water trong các trường hợp sau:\u003c/p\u003e\n\u003cp\u003e1. Sau khi cạo râu.\u003c/p\u003e\n\u003cp\u003e2. Trẻ bị hăm tã.\u003c/p\u003e\n\u003cp\u003e3. Sau khi tẩy trang.\u003c/p\u003e\n\u003cp\u003e4. Trước khi phẫu thuật.\u003c/p\u003e\n\u003cp\u003e5. Khi đi du lịch.\u003c/p\u003e\n\u003cp\u003e6. Sau khi tập thể thao.\u003c/p\u003e\n\u003cp\u003e7. Da bị hư tổn.\u003c/p\u003e\n\u003cp\u003e8. Da mặt bị đỏ.\u003c/p\u003e\n\u003cp\u003e9. Sau khi tẩy lông.\u003c/p\u003e\n\u003cp\u003e10. Khi bị ăn nắng.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://file.hstatic.net/1000097940/file/khoang-lam-diu-da-va-chong-kich-ung-avene-therma-spring-water-2-picare_grande.jpg\" width=\"600\" height=\"215\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e \u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e2. Thành phần:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eAVÈNE THERMAL SPRING WATER, NITROGEN.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e3. Hướng dẫn sử dụng: \u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Giữ vòi xịt cách mặt khoảng 20cm, nhấn giữ vòi xịt sau đó nghiêng mặt hoặc di chuyển chai khoáng sao cho lớp sương được phun đều khắp mặt. Sau đó để khô tự nhiên.\u003c/p\u003e\n\u003cp\u003e- Sản phẩm thích hợp sử dụng hàng ngày hoặc khi thấy da khô, thiếu nước.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e4. Bảo quản:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eNơi khô ráo, thoáng mát\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eQuy cách:\u003c/strong\u003e Chai 300ml\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eBảo quản :\u003c/strong\u003e Nơi khô ráo, thoáng mát.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eXuất xứ :\u003c/strong\u003e Pháp.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eNhà sản xuất:\u003c/strong\u003e Laboratories Dermatologiques Avène - 45 Place Abel – Gance 92100 Boulogne – Paris – France.\u003cbr /\u003e\u003cbr /\u003e\u003cstrong\u003e\u003cem\u003e**Mẫu mã bao bì có thể thay đổi theo quy định của nhãn hàng.\u003c/em\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/d6/78/4d/6f7d87de5de5b8678ea2ac4fc0b9ac10.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d6/78/4d/6f7d87de5de5b8678ea2ac4fc0b9ac10.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d6/78/4d/6f7d87de5de5b8678ea2ac4fc0b9ac10.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d6/78/4d/6f7d87de5de5b8678ea2ac4fc0b9ac10.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d6/78/4d/6f7d87de5de5b8678ea2ac4fc0b9ac10.png"},{"base_url":"https://salt.tikicdn.com/ts/product/dc/5c/82/a3bb660ad7736c60bda2743830b14991.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/dc/5c/82/a3bb660ad7736c60bda2743830b14991.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/dc/5c/82/a3bb660ad7736c60bda2743830b14991.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/dc/5c/82