ad/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.8,"review_count":4,"review_text":"(4)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/39/ee/f4/48795ba9eb865756aa7fb5b3c68de0a6.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1010,"all_time_quantity_sold":24,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e✪ Thông tin sản phẩm\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e==\u0026gt; lọc số 1 Karofi - Cấu tạo cơ bản từ sợi bông xốp nhựa Polyprolen, được nén chặt lại cho đến khi khe hở chỉ còn kích thước 5 micron (~0.005 mm) được đặt ở vị trí đầu tiên trong máy lọc nước Karofi để lọc đi toàn bộ các loại chất bẩn, chất rỉ sét, tạp chất hữu cơ, bùn đất … nằm trong nước. Toàn bộ chất bẩn có kích thước lớn hơn 5 micron sẽ được giữ lại ở lõi lọc này. - Do vậy, lõi lọc số 1 Karofi là lõi lọc được thay thế thường xuyên nhất, thời gian thay thế cũng ngắn nhất. Do vậy, lõi lọc nước Karofi này trong một cốc lọc trong suốt, có thể nhìn xuyên để tiện theo dõi tình trạng lõi lọc.\u003c/p\u003e\n\u003cp\u003e- Thời gian thay thế: - Đối với nguồn nước thông thường (Nước máy, nước mưa): Thời gian thay thế 3 – 6 tháng/lần (Nước cấp đầu vào khoảng 5.500 lít – 10.900 lít) - Đối với nguồn nước cứng, nước nhiễm đá vôi (Nước chứa Ca­­­­­­2+ \u0026amp; Mg2+), nước giếng khoan, giếng khơi hoặc nước đặc thù có thời gian thay thế 1.5 – 3 tháng/ lần (Nước cấp đầu vào khoảng 3.100 lít – 10.400 lít)\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e==\u0026gt; Lõi lọc số 2 Karofi - Cấu tạo: Lõi được cấu tạo bởi vỏ nhựa, chứa bên trong là than gáo dừa được hoạt hóa. Than hoạt tính có tính cấu trúc xốp rỗng, các vết rỗng – nứt vi mạch… đó đó than hoạt tính có tính hấp thụ rất mạnh.\u003c/p\u003e\n\u003cp\u003eChức năng: Hấp thụ mạnh các loại chất nhờn, mùi và hữu cơ hòa tan. Than hoạt tính còn chứng tỏ được hiệu quả trong xử lý asen và amoni.\u003c/p\u003e\n\u003cp\u003eThời gian thay thế lõi lọc này khoảng từ 6-9 tháng.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e==\u0026gt; Lõi lọc số 3 Karofi - Cấu tạo: Lõi số 3 Karofi được cấu tạo bởi sợi bông xốp của nhựa polyprolen, sau đó được nén chặt lại tới khi đạt kích thước khe hở chỉ 1 micron (0.001mm) - Chức năng: Lọc các tạp chất hữu cơ, rỉ xét, bùn đất hay các chất lơ lửng trong nước có kích thước lớn hơn 1 micron -\u003c/p\u003e\n\u003cp\u003eThời gian thay thế: 6-12 tháng/lần - Dùng cho máy lọc nước Karofi đối với nguồn nước thông thường (Nước máy, nước mưa)\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/39/ee/f4/48795ba9eb865756aa7fb5b3c68de0a6.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/39/ee/f4/48795ba9eb865756aa7fb5b3c68de0a6.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/39/ee/f4/48795ba9eb865756aa7fb5b3c68de0a6.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/39/ee/f4/48795ba9eb865756aa7fb5b3c68de0a6.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/39/ee/f4/48795ba9eb865756aa7fb5b3c68de0a6.jpg