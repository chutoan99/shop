ason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/a2/01/e9/d52599c8606a9b5feb069c7b574dd76e.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1444,"all_time_quantity_sold":8,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p><em><strong>Bàn đạp clipless là gì? </strong></em></p>\n<p>Bàn đạp clipless là một hệ thống gồm 2 phần: Phần một là 1 bàn đạp nhỏ với cơ chế khoá lẫy (lò xo) và phần hai là một miếng chêm gắn vào mặt dưới giày đạp của bạn, được gọi là \"can\"/\"cá\" hay \"cleat\", những miếng can này sẽ khoá đôi giày của bạn vào bàn đạp và tạo cho bạn một kết nối an toàn như một thể thống nhất đi liền với xe đạp trong khi đạp xe. Bàn đạp Clipless giúp người đạp chuyển năng lượng tốt hơn, tăng hiệu suất tối đa và an toàn. </p>\n<p>Bộ sản phẩm bàn đạp Jett Road clipless tương thích với xe đạp và giày đạp đua, bao gồm bàn đạp và 1 cặp can gắn kèm ốc. Mặt bàn đạp có thể móc can giúp bạn thuận tiện thao tác hơn trong khi di chuyển. </p>\n<p>Vật liệu nhôm cùng cốt chromoly bền nhẹ</p>\n<p>Chuẩn 9/16\" tương thích với hầu hết các mẫu xe đạp địa hình trên thị trường. </p>\n<p><img style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/a2/01/e9/c3975815702855ce98b04fd4d893bfcb.jpg\" alt=\"\" width=\"600\" height=\"600\" /></p>\n<p style=\"text-align: center;\"><img src=\"https://salt.tikicdn.com/ts/tmp/26/9e/3a/a7681afca37b6cfbdf22207e36a81847.jpg\" alt=\"\" width=\"600\" height=\"600\" /></p>\n<p style=\"text-align: center;\"><img src=\"https://salt.tikicdn.com/ts/tmp/de/67/85/539c03b842e06884fbe75afd8c73cbe2