f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"defective_product"}},"discount":78000,"discount_rate":16,"rating_average":4.8,"review_count":17,"review_text":"(17)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/e1/ca/6d/376931eba7aa63ea9ac1d66983461660.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1114,"all_time_quantity_sold":87,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p><strong>Combo 3 áo lót học sinh phối ren iBasic BRAT003 </strong></p>\n<p><br />Cup áo lót được thiết kế 2 lớp vải, đệm bông ép mềm mại, nhẹ nhàng và thoải mái.</p>\n<p>- Mút cotton vô cùng mềm mại, thấm hút mồ hôi tốt.</p>\n<p>- Bản thun lớn mềm mại, co giãn tốt cho mọi hoạt động.</p>\n<p>- Có nơ phối ren ở chính giữa</p>\n<p><strong>Chất liệu:</strong> vô cùng mịn màng, mềm mại mang đến cảm giác nhẹ nhàng dễ chịu.</p>\n<p>Thành phần: 100% cotton</p>\n<p><img title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/ce/11/45/f9fa8fd5a685277d01ad7e1587c19208.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p><img title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/ea/f9/fa/6e7e311f15e967c361dac5bcbb4a4a71.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p><img title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/ad/b2/84/dd1c86099dfe28939679ae6d3b9b89b7.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p><br /><strong>Mix &amp; Match:</strong> áo có thể kết hợp với nhiều kiểu trang phục khác nhau như: T shirt, áo sơ mi, đồ thể</p>\n<p><strong>Xuất xứ:</strong> Thiết kế và sản xuất tại Việt Nam.</p>\n<p><strong>Thông số sản phẩm:</strong></p>\n<p><img src=\"https://salt.tikicdn.com/ts/tmp/19/38/2b/a22d571bcfdd65997522e55810738edd.jpg\" alt=\"\" width=\"750\" height=\"506\" /></p>\n<p><strong>Hướng dẫn bảo quản sản phẩm</strong></p>\n<p>TIP: Ngâm nước lạnh pha ít muối và giặt với dầu gội cho lần giặt đầu tiên giúp cho sản phẩm bền màu hơn.</p>\n<p>- Không giặt với quần áo khác màu, đồ lót nên được giặt riêng.</p>\n<p>- Sử dụng chất tẩy rửa nhẹ, không có chất tẩy trắng.</p>\n<p>- Giặt bằng nước ấm, 30 - 40 độ là nhiệt độ thích hợp nhất, vò nhẹ bằng tay.</p>\n<p>- Nếu phải giặt máy, bỏ vào túi giặt, chọn nhiệt độ nước và chu kì nhẹ nhàng.</p>\n<p>- Nên phơi ở nơi thông thoáng, tránh ánh nắng mặt trời trực tiếp.</p>\n<p>- Sản phẩm không cần ủi, riêng đối với sản phẩm quần lót có thể ủi ở nhiệt độ nhẹ phần đáy để tiệt trùng trước khi sử dụng.</p>\n<p><strong>Lưu ý:</strong> <br />Nếu khách hàng còn phân vân về size, iBasic khuyến khích khách hàng nhắn tin cho iBasic để được tư vấn kỹ hơn về size, tránh trường hợp đổi hàng không mong muốn.</p>\n<p>Trong trường hợp giao thiếu sản phẩm, quý khách vui lòng cung cấp video không bị cắt đoạn từ khi bắt đầu mở kiện hàng. Ngoại trừ video, iBasic xin phép không duyệt hình ảnh nào về đơn hàng giao thiếu. Sau khi xác nhận video là đúng, iBasic sẽ gửi ngay sản phẩm thiếu và mã Voucher cho lần mua hàng sau.</p>\n<p>Trong trường hợp giao sai sản phẩm, quý khách vui lòng liên hệ với bộ phận Chat và cung cấp hình ảnh sản phẩm giao sai để nhân viên iBasic hỗ trợ xử lý.</p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/e1/ca/6d/376931eba7aa63ea9ac1d66983461660.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1