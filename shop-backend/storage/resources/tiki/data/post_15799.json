êu các tiếng ồn phát ra do ma sát.\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/4f/2a/33/f4854918e35b634c32fc7768a8ad2642.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/4f/2a/33/f4854918e35b634c32fc7768a8ad2642.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/4f/2a/33/f4854918e35b634c32fc7768a8ad2642.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4f/2a/33/f4854918e35b634c32fc7768a8ad2642.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4f/2a/33/f4854918e35b634c32fc7768a8ad2642.jpg"}],"warranty_policy":null,"brand":{"id":153483,"name":"WD-40","slug":"wd-40"},"current_seller":{"id":17423,"sku":"2463371424307","name":"HIBU AUTO","link":"https://tiki.vn/cua-hang/hibu-auto","logo":"41/e5/bd/709a9c7097649221ad27f2fbe4b68e82.jpg","price":89000,"product_id":"32701999","store_id":16812,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Thông tin chung","attributes":[{"code":"brand","name":"Thương hiệu","value":"WD-40"},{"code":"brand_country","name":"Xuất xứ thương hiệu","value":"Mỹ"},{"code":"origin","name":"Xuất xứ (Made in)","value":"Mỹ"},{"code":"capacity","name":"Dung tích","value":"191ml"}]}],"product_links":[],"gift_item_title":"0 quà tặng kèm","services_and_promotions":[],"promitions":[],"stock_item":{"max_sale_qty":1000,"min_sale_qty":1,"preorder_date":null,"qty":1000},"quantity_sold":{"text":"Đã bán 152","value":152},"categories":{"id":8594,"name":"Ô Tô - Xe Máy - Xe Đạp","is_leaf":false},"breadcrumbs":[{"url":"/o-to-xe-m