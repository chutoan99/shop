:114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":3.8,"review_count":5,"review_text":"(5)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/51/12/e0/63b6b31ecb5d51c24c50cf40a6b80237.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2203,"all_time_quantity_sold":84,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<h3>Combo 2 Núm Ti Nuk Cao Su S1 NU66049 Size S dành cho bé từ 0 đến 6 tháng</h3>\n<p>Núm ti bình cổ rộng Premium Choice+ NUK - thiết kế dẹt chỉnh nha độc nhất trên thị trường - mô phỏng y hệt hình dáng đầu ngực mẹ khi cho con bú, là giải pháp tối ưu giúp phát triển răng miệng lành mạnh và đưa bé đến gần hơn cảm giác bú tự nhiên.</p>\n<h3>Chất liệu:</h3>\n<p>Cao su tự nhiên an toàn, siêu mềm và khó rách.</p>\n<h3>Đặc điểm nổi bật:</h3>\n<ul>\n<li>Núm ti dẹt chỉnh nha: Thiết kế độc quyền của NUK, cho phép lưỡi trẻ có đủ không gian để di chuyển. Các động tác liên hoàn mút-nuốt-nhả-nghỉ tạo ra sự phối hợp nhịp nhàng giữa lưỡi, môi, vòm miệng, cơ hàm. Việc rèn luyện thường xuyên này hỗ trợ trẻ sớm phát triển kĩ năng nhai nuốt, giao tiếp; thúc đẩy răng mọc thẳng đẹp, không hô hay xô lệch.</li>\n<li>Lỗ tiết sữa nằm ở mặt trên của núm ti: Tạo cơ chế phun sữa dạng vòng cung lên vòm miệng giúp trẻ tránh giật mình dẫn đến nghẹn sặc, không như các lỗ tiết sữa ở bình thông thường nằm giữa núm ti phun thẳng vào cổ họng bé. Bên cạnh đó, cơ chế phun sữa đặc biệt này còn giúp sữa có đủ thời gian để hòa với enzyme nước bọt của bé giúp tiêu hóa sữa tốt hơn.</li>\n<li>Cổ núm nhỏ: cho phép môi được khép kín, miệng không cần mở rộng để giữ núm ti, không tác động xấu đến cấu trúc của hàm.</li>\n<li>Đầu ti siêu mềm, bầu núm tối ưu: Đặc biệt linh hoạt tương tự như ti mẹ và vừa vặn với miệng bé, giúp bé dễ chấp nhận và giữ chắc núm ti trong miệng.</li>\n<li>Hệ thống van thông khí NUK: Cho phép sữa chảy đều mà bé không nuốt phải khí thừa, hạn chế tối đa hiện tượng chướng bụng, đầy hơi, nôn trớ.</li>\n</ul>\n<h3>Hướng dẫn sử dụng:</h3>\n<ul>\n<li>Quay phần van thông khí và lỗ tiết sữa lên trên khi cho bé bú.</li>\n<li>Luộc sôi 3-5 phút trước lần sử dụng đầu tiên. Lưu ý những lần vệ sinh sau, tiệt trùng bằng cách nhúng qua nước sôi hoặc sử dụng máy tiệt trùng, không luộc/ngâm trong nước nóng.</li>\n<li>Không dùng trong máy rửa bát/lò vi sóng.</li>\n<li>Nên vệ sinh bằng nước rửa bình NUK (công thức enzyme tự nhiên loại bỏ protein trong sữa, cặn bột hay dư lượng nước trái cây).</li>\n</ul>\n<h3>Hướng dẫn bảo quản:</h3>\n<ul>\n<li>Bảo quản nơi khô ráo, không để dưới ánh nắng trực tiếp hoặc nơi gần nguồn nhiệt.</li>\n<li>Không nhúng núm ti vào các chất ngọt hoặc thuốc.</li>\n</ul>\n<h3>Khuyến cáo:</h3>\n<ul>\n<li>Vì mục đích an toàn, núm ti cao su nên thay mới sau 3-4 tuần sử dụng hoặc bất cứ khi nào có dấu hiệu xuống cấp như bóp thấy dính, hoặc xuất hiện vết nứt, rách.</li>\n<li>Sử dụng sữa tươi trong lần luộc đầu tiên nhằm làm dịu bớt mùi của cao su tự nhiên.</li>\n</ul>\n<h3>Bảng kích thước:</h3>\n<p><img src=\"https://salt.tikicdn.com/ts/tmp/a8/43/12/5e9deaf9879a04fe4d182c77d1e484ed.jpg\" alt=\"\" width=\"750\" height=\"642\" /></p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/51/12/e0/63b6b31ecb5d51c24c50cf40a6b80237.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/51/12/e0/63b6b31ecb5d51c24c50cf40a6b80237.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/51/12/e0/63b6b31ecb5d51c24c50cf40a6b80237.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/51/12/e0/63b6b31ecb5d51c24c50cf40a6b80237.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/51/12/e0/63b6b31ecb5d51c24c50cf40a6b80237.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/27/30/c5/e62a9dd8cf33fab59919c02727d5288c.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/27/30/c5/e62a9dd8cf33fab59919c02727d5288c.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/27/30/c5/e62a9dd8cf33fab59919c02727d5288c.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/27/30/c5/e62a9dd8cf33fab59919c02727d5288c.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/27/30/c5/e62a9dd8cf33fab59919c02727d5288c.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/e8/50/2a/bcfa7320701fb379909c74f7a3ffc5ae.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e8/50/2a/bcfa7320701fb379909c74f7a3ffc5ae.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e8/50/2a/bcfa7320701fb379909c74f7a3ffc5ae.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e8/50/2a/bcfa7320701fb379909c74f7a3ffc5ae.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e8/50/2a/bcfa7320701fb379909c74f7a3ffc5ae.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/25/ca/08/83f7c9d5fc84c9