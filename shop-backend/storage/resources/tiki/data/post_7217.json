":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":232000,"discount_rate":25,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/91/98/cd/e1f1ec3dc519c64574209705f9cde7ad.JPG","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1376,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"font-weight: 400;\"\u003e\u003cstrong\u003eReader’s Bank\u003c/strong\u003e là tập hợp những bài đọc tiếng Anh ngắn, thú vị về nhiều chủ đề khác nhau và được phân theo điểm Lexile để phù hợp với năng lực đọc hiểu của học sinh. Mỗi bài đọc đều đi kèm với những câu hỏi kiểm tra về khả năng đọc hiểu văn bản, về từ vựng và kiến thức ngữ pháp. Cuối sách là đáp án và giải thích chi tiết, bài dịch hoàn chỉnh, bài dịch thô và những cấu trúc ngữ pháp cần lưu ý.\u003c/p\u003e\n\u003cul style=\"font-weight: 400;\"\u003e\n\u003cli\u003eNhững \u003cstrong\u003ebài đọc ngắn trong khoảng từ 100 - 200\u003c/strong\u003e từ sẽ khiến việc đọc tiếng Anh không còn là một nhiệm vụ nặng nề hay khó khăn nữa. Con có thể đọc trong giờ nghỉ, giờ chơi, trước giờ đi ngủ như một cách giải trí nhẹ nhàng và bổ ích.\u003c/li\u003e\n\u003cli\u003eNhững bài đọc về nhiều chủ đề khác nhau, phong phú, hấp dẫn và cực kỳ thú vị giúp con vừa giải trí, vừa thu nạp thêm vô số những \u003cstrong\u003ekiến thức bổ ích\u003c/strong\u003e về khoa học, lịch sử, văn hóa, tự nhiên, tâm lý học, các phương pháp học tập hiệu quả…\u003c/li\u003e\n\u003cli\u003eCon không chỉ được học thêm rất nhiều \u003cstrong\u003etừ mới và các cách diễn đạt thường gặp trong tiếng Anh \u003c/strong\u003emà còn ghi nhớ chúng tốt hơn nhờ học trong ngữ cảnh cụ thể.\u003c/li\u003e\n\u003cli\u003eCác \u003cstrong\u003ecấu trúc ngữ pháp quan trọng\u003c/strong\u003e xuất hiện trong bài đọc cũng được phân tích và lý giải cụ thể giúp con không chỉ hiểu mà còn nắm được cách sử dụng đúng và hiệu quả.\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eFile audio với giọng đọc của người bản ngữ\u003c/strong\u003e cho từng bài đọc là món quà dành cho các con muốn cải thiện kỹ năng nghe và khả năng phát âm tiếng Anh của mình.\u003c/li\u003e\n\u003cli\u003ePhần đáp án cuối sách đi kèm với giải thích chi tiết, bài dịch hoàn chỉnh, bài dịch thô và những cấu trúc ngữ pháp cần lưu ý là những thông tin kiến thức bổ ích giúp các em có thể \u003cstrong\u003etự học hiệu quả\u003c/strong\u003e.\u003c/li\u003e\n\u003cli\u003e9 cuốn sách tương ứng với 9 level từ thấp đến cao và được\u003cstrong\u003e xác định bằng điểm Lexile\u003c/strong\u003e giúp người học lựa chọn được cuốn sách phù hợp nhất với năng lực đọc hiểu của bản thân, nhờ đó mà nuôi dưỡng ở các con sự tự tin và dần cải thiện trình độ của mình.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"font-weight: 400;\"\u003eĐó chính là những lý do khiến \u003cstrong\u003eReader’s Bank\u003c/strong\u003e được mệnh danh là “kinh thánh về đọc hiểu tiếng Anh” tại Hàn Quốc với trên 14 triệu bản đã được bán ra. \u003cstrong\u003eReader’s Bank\u003c/strong\u003e là bộ sách cực kỳ thành công của Visang -  một tập đoàn lớn tại Hàn Quốc chuyên cung cấp sách giáo khoa, chương trình/nền tảng học tập thông minh cho cả thị trường trong nước và quốc tế.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/91/98/cd/e1f1ec3dc519c64574209705f9cde7ad.JPG","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/91/98/cd/e1f1ec3dc519c64574209705f9cde7ad.JPG","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/91/98/cd/e1f1ec3dc519c64574209705f9cde7ad.JPG","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/91/98/cd/e1f1ec3dc519c64574209705f9cde7ad.JPG","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/91/98/cd/e1f1ec3dc519c64574209705f9cde7ad.JPG"},{"base_url":"https://salt.tikicdn.com/ts/product/4a/be/6b/93ba549c94fdfa1e1839d9195680ccd3.JPG","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/4a/be/6b/93ba549c94fdfa1e1839d9195680ccd3.JPG","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/4a/be/6b/93ba549c94fdfa1e1839d9195680ccd3.JPG","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4a/be/6b/93ba549c94fdfa1e1839d9195680ccd3.JPG","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4a/be/6b/93ba549c94fdfa1e1839d9195680ccd3.JPG"},{"base_url":"https://salt.tikicdn.com/ts/product/5b/3c/ee/d953ab12a7d9e4fe2b7566107d42a928.JPG","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/5b/3c/ee/d953ab12a7d9e4fe2b7566107d42a928.JPG","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/5b/3c/ee/d953ab12a7d9e4fe2b7566107d42a928.JPG","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5b/3c/ee/d953ab12a7d9e4fe2b7566107d42a928.JPG","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5b/3c/ee/d953ab12a7d9e4fe2b7566107d42a928.JPG"},{"base_url":"https://salt.tikicdn.com/ts/product/8a/f6/24/875a1eb515f515645ef4d76fc5bf7cfe.JPG","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/8a/f6/24