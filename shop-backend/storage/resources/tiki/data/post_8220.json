height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/db/84/10/70fe7c26d057fcb7b4ac562676d1d67d.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":463,"all_time_quantity_sold":76,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003e\u003cstrong\u003eTrà Cốm lợi sữa HiPP cho mẹ sau sinh\u003c/strong\u003e\u003c/h3\u003e\n\u003ch3\u003e\u003cstrong\u003eGiới thiệu \u003c/strong\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cspan style=\"font-weight:400;\"\u003eTrà Cốm lợi sữa HiPP cho mẹ sau sinh là một trong những lựa chọn hàng đầu của các bà mẹ châu Âu. Với thành phần 100% từ thiên nhiên, gồm các loại hạt, thảo mộc quý hiếm, trà cốm HiPP giúp tăng cường sữa mẹ, bổ sung dưỡng chất thiết yếu cho cả mẹ và bé, đồng thời hỗ trợ quá trình hồi phục sau sinh. Sản phẩm được sản xuất theo tiêu chuẩn nghiêm ngặt của Đức, đảm bảo an toàn tuyệt đối cho mẹ và bé.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003e\u003cstrong\u003eThành phần\u003c/strong\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cspan style=\"font-weight:400;\"\u003eĐường glucose, đường lactose, các chiết xuất hoa hồi, tầm ma, hoa thìa là, carum, lá cây thơm và đậu sữa Phương Đông.   \u003c/span\u003e\u003c/li\u003e\n\u003cli\u003e\u003cspan style=\"font-weight:400;\"\u003eKhông chứa phẩm màu, hương liệu nhân tạo, chất bảo quản, đặc biệt không chứa Gluten.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003e\u003cstrong\u003eĐặc điểm nổi bật\u003c/strong\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cspan style=\"font-weight:400;\"\u003eVới hương vị thảo mộc thanh mát, vị ngọt dịu dễ uống, trà sản phụ lợi sữa giúp hỗ trợ tuần hoàn các tuyến sữa và kích thích sữa về nhiều hơn.\u003c/span\u003e\u003c/li\u003e\n\u003cli\u003e\u003cspan style=\"font-weight:400;\"\u003eBên cạnh đó, hương thơm nhẹ từ thảo mộc sẽ giúp mẹ cảm thấy thoải mái và thư giãn đảm bảo tinh thần tốt nhất trong lúc bên cạnh và trò chuyện cùng bé yêu.\u003c/span\u003e\u003c/li\u003e\n\u003cli\u003e\u003cspan style=\"font-weight:400;\"\u003eKhông chất bảo quản, không hương liệu, không phẩm màu… đảm bảo an toàn tuyệt đối, đặc biệt trong thời gian sau sinh khi sức đề kháng của mẹ còn yếu.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003e\u003cstrong\u003eCông dụng\u003c/strong\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cspan style=\"font-weight:400;\"\u003eCó tác dụng bồi bổ cơ thể, giải khát, giảm viêm nhiễm, giúp bà mẹ cho con bú ăn ngon miệng, đặc biệt hỗ trợ hoạt động của các tuyến sữa tốt hơn, tăng cường lượng sữa\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003e\u003cstrong\u003eHướng dẫn sử dụng\u003c/strong\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cspan style=\"font-weight:400;\"\u003ePha 200ml nước đun sôi để ấm hoặc nước mát với khoảng 4 thìa trà lợi sữa Hipp cho sản phụ, uống 2 cốc mỗi ngày.\u003c/span\u003e\u003c/li\u003e\n\u003cli\u003e\u003cspan style=\"font-weight:400;\"\u003eMức pha chuẩn : Pha 2 thìa (8g) trà sản phụ với 100ml nước uống.\u003c/span\u003e\u003c/li\u003e\n\u003cli\u003e\u003cspan style=\"font-weight:400;\"\u003e2-3 ly trà mỗi ngày sẽ mang đến điều kỳ diệu với mẹ.\u003c/span\u003e\u003c/li\u003e\n\u003cli\u003e\u003cspan style=\"font-weight:400;\"\u003eNên uống ngay sau khi sinh và uống thường xuyên để đem lại hiệu quả lợi sữa tốt nhất\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003e\u003cstrong\u003eMất sữa – Ít sữa\u003c/strong\u003e là một trong những vấn đề dễ gây áp lực đối với các bà mẹ, đặc biệt là các mẹ sau sinh. HiPP sẽ mách mẹ những mẹo hay giúp sữa mẹ về nhanh và nhiều hơn nhé:\u003c/span\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cspan style=\"font-weight:400;\"\u003eCho con bú ngay sau khi sinh\u003c/span\u003e\u003c/li\u003e\n\u003cli\u003e\u003cspan style=\"font-weight:400;\"\u003eCho con bú thường xuyên, đều đặn và đúng cách\u003c/span\u003e\u003c/li\u003e\n\u003cli\u003e\u003cspan style=\"font-weight:400;\"\u003eTích cực vắt sữa và trữ sữa\u003c/span\u003e\u003c/li\u003e\n\u003cli\u003e\u003cspan style=\"font-weight:400;\"\u003eTrước khi cho con bú, sử dụng khăn ấm massage đều theo chiều kim đồng hồ toàn bộ bầu ngực\u003c/span\u003e\u003c/li\u003e\n\u003cli\u003e\u003cspan style=\"font-weight:400;\"\u003eGiữ tinh thần thoải mái nhất, tránh căng thẳng, mệt mỏi\u003c/span\u003e\u003c/li\u003e\n\u003cli\u003e\u003cspan style=\"font-weight:400;\"\u003eĂn uống đủ chất dinh dưỡng\u003c/span\u003e\u003c/li\u003e\n\u003cli\u003e\u003cspan style=\"font-weight:400;\"\u003eUống nhiều nước ấm.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/45/a0/7a/841b6ab06f7618f4f08d4aea44483df9.png\" alt=\"\" width=\"750\" height=\"1381\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/db/84/10/70fe7c26d057fcb7b4ac562676d1d67d.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/db/84/10/70fe7c26d057fcb7b4ac5626