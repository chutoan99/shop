2naljf6nrov12\" alt=\"vn-11134202-23030-f2naljf6nrov12\" /\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"irIKAp\"\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"O0-58D\"\u003e\u003cimg class=\"_0O7Vlf uno8xj\" src=\"https://down-vn.img.susercontent.com/file/vn-11134202-23030-nj8f86h6nrove4\" alt=\"vn-11134202-23030-nj8f86h6nrove4\" /\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"irIKAp\"\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"O0-58D\"\u003e\u003cimg class=\"_0O7Vlf uno8xj\" src=\"https://down-vn.img.susercontent.com/file/vn-11134202-23030-lzzolqk6nrovb5\" alt=\"vn-11134202-23030-lzzolqk6nrovb5\" /\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"irIKAp\"\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"O0-58D\"\u003e\u003cimg class=\"_0O7Vlf uno8xj\" src=\"https://down-vn.img.susercontent.com/file/vn-11134202-23030-pqfemzm6nrovee\" alt=\"vn-11134202-23030-pqfemzm6nrovee\" /\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cp class=\"irIKAp\"\u003eTHÔNG TIN SẢN PHẨM\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Tên sản phẩm: Lõi lọc nước thay thế cho bộ lọc nước tại vòi KONKA KPW - LT01\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Năng lực lọc: 2L/phút, thể tích lọc 4000L/năm.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Công nghệ 4 màng lọc cho mức siêu lọc 0.1 um.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Tuổi thọ lõi lọc: 3-6 tháng tùy vào chất lượng nước của từng địa phương.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Sản phẩm không có nước thải và không dùng điện năng, chỉ dựa vào áp lực nước trong nhà để lọc nước sử dụng, áp lực nước càng lớn thì tốc độ lọc càng nhanh. Nếu nước chảy chậm hơn bình thường thì đó hoàn toàn là điều bình thường, không đáng lo ngại.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eHướng dẫn cách lắp đặt và sử dụng:\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Khách hàng cần có sẵn bộ lọc nước tại vòi Konka KPW-LT01, đây chỉ là lõi lọc thay thế\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Gắn trực tiếp bộ lọc vào vòi nước của gia đình bạn.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Cách 3-4 ngày rửa lõi một lần. Nếu lõi lọc chậm thì dùng giấy nhám chà nhẹ vào lõi lọc là được. Sau 3-6 tháng thay lõi để đảm bảo chất lượng nước được sạch nhất\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eChính sách bảo hành:\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Đổi trả: miễn phí trong 7 ngày theo quy định của Tiki\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Bảo hành rơi vỡ khi có video bóc hàng\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/95/0e/ba/27890ba100e01005dc44ab890c082e2f.JPG","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/95/0e/ba/27890ba100e01005dc44ab890c082e2f.JPG","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/95/0e/ba/27890ba100e01005dc44ab890c082e2f.JPG","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/95/0e/ba/27890ba100e01005dc44ab890c082e2f.JPG","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/95/0e/ba/27890ba100e01005dc44ab890c082e2f.JPG"},{"base_url":"https://salt.tikicdn.com/ts/product/de/f4/91/94cb82a8eccb4a847e4fa5305cb82603.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/de/f4/91/94cb82a8eccb4a847e4fa5305cb82603.jpg","medium_url":"https://sa