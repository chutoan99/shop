alt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"freeship_xtra","type":"pdp_icon_badge","index":2,"icon":"https://salt.tikicdn.com/ts/upload/be/67/48/04a82ab8df178e1a13bde38316081865.png","icon_width":91,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":true,"return_reason":"any_reason"}},"discount":46000,"discount_rate":26,"rating_average":4.7,"review_count":61,"review_text":"(61)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/1a/1c/8d/79ad995b06d3daddaf12f6b3d61f762b.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1513,"all_time_quantity_sold":417,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003e1. 7 BƯỚC THIẾT LẬP KẾ HOẠCH CUỘC ĐỜI\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e“Mục tiêu trong cuộc sống của bạn là gì?”\u003c/p\u003e\n\u003cp\u003eNếu hỏi mọi người câu này, bạn chắc chắn sẽ nhận được hằng hà sa số đáp án: tôi muốn xinh đẹp; tôi muốn hạnh phúc; muốn du lịch; trở thành blogger; lương 8 con số,… Vậy hãy hỏi tiếp người ấy: “Bạn sẽ làm gì để đạt được mong muốn?” Chắc chắn rất ít người trong số đó sẽ cho bạn một đáp án chi tiết.\u003c/p\u003e\n\u003cp\u003eTất cả chúng ta đều biết ước mơ, nhưng không nhiều trong số đó biết đặt bút vạch ra kế hoạch cụ thể để biến ước mơ thành hiện thực. Đó là điểm khác biệt lớn nhất giữa người thành công và thất bại, người tự tin và người luôn cảm thấy mơ hồ.\u003c/p\u003e\n\u003cp\u003eSở dĩ, chúng ta mơ hồ vì chúng ta chưa có được tấm bản đồ chỉ dẫn cho cuộc đời mình. Kế hoạch cuộc đời cũng giống như tấm bản đồ lớn mà mỗi người đều cần phải có cho bản thân, dù bạn là ai, bao nhiêu tuổi, đang làm nghề gì.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/05/be/b2/a8060f4aec28307dd6a5e27d2f004369.png\" alt=\"\" width=\"689\" height=\"387\" /\u003e\u003c/p\u003e\n\u003cp\u003e“\u003cem\u003e\u003cstrong\u003e7 bước thiết lập kế hoạch cuộc đời\u003c/strong\u003e\u003c/em\u003e” sẽ giúp bạn phác họa tấm bản đồ đời mình thông qua việc định hướng:\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eBạn cần biết bản thân là ai? Đang đứng ở đâu? Con đường nào để phát triển?\u003c/li\u003e\n\u003cli\u003eGiai đoạn 3 năm, 5 năm, 10 năm sau, bạn nên làm gì?\u003c/li\u003e\n\u003cli\u003eNếu có biến cố,  bạn đã chuẩn bị “kế hoạch B” cho mình?\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eEmma Casey sẽ cùng bạn, từng bước tạo lập một cuộc sống mơ ước, nhờ tập trung vào:\u003c/strong\u003e\u003c/p\u003e\n\u003col\u003e\n\u003cli\u003eThời gian.\u003c/li\u003e\n\u003cli\u003eKế hoạch cho sức khỏe.\u003c/li\u003e\n\u003cli\u003eKế hoạch cho gia đình.\u003c/li\u003e\n\u003cli\u003eKế hoạch cho sự nghiệp.\u003c/li\u003e\n\u003cli\u003eKế hoạch xây dựng mối quan hệ.\u003c/li\u003e\n\u003cli\u003eKế hoạch tài chính.\u003c/li\u003e\n\u003cli\u003eKế hoạch cho đời sống tinh thần.\u003c/li\u003e\n\u003cli\u003eĐích đến cuối cùng: tạo ra di sản.\u003c/li\u003e\n\u003c/ol\u003e\n\u003cp\u003eBắt đầu từ những hành động đơn giản như sắp xếp thời gian, công việc mỗi ngày, chăm sóc gia đình, củng cố các mối quan hệ, đến những việc khó khăn hơn như cân bằng tài chính, tạo ra di sản cá nhân và bồi dưỡng đời sống tinh thần,… mọi kế hoạch đều có trong cuốn sách này, chờ đợi bạn mở ra và bắt tay vào thực hiện.\u003c/p\u003e\n\u003cp\u003eĐÃ ĐẾN LÚC ĐỂ LẠI NHỮNG THÁNG NGÀY MÔNG LUNG VÔ ĐỊNH SAU LƯNG BẰNG CÁCH THIẾT LẬP KẾ HOẠCH CUỘC ĐỜI.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/1f/b2/06/03e41cf14556446ce055928ea4dd03cd.png\" alt=\"\" width=\"656\" height=\"368\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e 2. SƠ LƯỢC VỀ TÁC GIẢ\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eEmma Casey từ nhỏ đã bộc lộ niềm yêu thích với biểu đồ và các con số. Thông qua bố mẹ, cô được tiếp xúc khá sớm với tài chính, nhờ đó định hướng được đam mê và nghề nghiệp của mình.\u003c/p\u003e\n\u003cp\u003eEmma có kinh nghiệm hơn 11 năm trong lĩnh vực tài chính ngân hàng, từng đảm nhận qua nhiều vị trí quản lý các cấp. Bằng kiến thức có sẵn và kinh nghiệm thực tế, cô đã chủ trì nhiều buổi chia sẻ về quản lý dòng tiền cá nhân. Tại đó, cô chia sẻ với mọi người về các phương pháp lập bảng thu chi, tiết kiệm hiệu quả và lập kế hoạch cho tương lai.\u003c/p\u003e\n\u003cp\u003eCác cuốn sách đã phát hành:\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eTiền Và Sự Thật Về Kế Hoạch Hưu Trí.\u003c/li\u003e\n\u003cli\u003eDọn Dẹp Tối Giản - Phép Màu Mang Bạn Và Người Thân Quay Trở Về.\u003c/li\u003e\n\u003cli\u003eDòng Tiền Cá Nhân. \u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/e1/b2/51/a06d296a0de497f8fe88335cd577432d.png\" alt=\"\" width=\"627\" height=\"470\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/1a/1c/8d/79ad995b06d3daddaf12f6b3d61f762b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/1a/1c/8d/79ad995b06d3daddaf12f6b3d61f762b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/1a/1c/8d/79ad995b06d3daddaf12f6b3d61f762b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1a/1c/8d/79ad995b06d3daddaf12f6b3d61f762b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1a/1c/8d/79ad995b06d3daddaf12f6b3d61f762b.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/c2/51/e8/c7c6a96b58c513b1d1d25e1e53316ae2.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c2/51/e8/c7c6a96b58c513b1d1d25e1e53316ae2.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c2/51/e8/c7c6a96b58c513b1d1d25e1e53316ae2.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c2/51/e8/c7c6a96b58c513b1d1d25e1e53316ae2.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c2/51/e8/c7c6a96b58c513b1d1d25e1e53316ae2.jpg"},{"base_url":"https://salt.tikicdn.com/media/catalog/producttmp/08/eb/59/bfd19916244102ef2b771565a6a29510.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/producttmp/08/eb/59/bfd19916244102ef2b771565a6a29510.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/producttmp/08/eb/59/bfd19916244102ef2b771565a6a29510.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/