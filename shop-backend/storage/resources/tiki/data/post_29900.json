b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/3a/28/fd/2b988e86f757934864aff0ed508de5f7.JPG","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1133,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e \u003c/p\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"app__overview__intro\"\u003e\n\u003cdiv class=\"app__layout-container app__layout-container--small app__layout-container--light\"\u003e\n\u003ch2 class=\"app__overview__intro__title light center\"\u003eDEAR BODY, PHIÊN BẢN MỚI CỦA BẠN\u003c/h2\u003e\n\u003cdiv class=\"app__overview__intro__description gc__copy gc__copy--light gc__copy--center gc__copy--large\"\u003e\n\u003cp\u003eChọn lối sống lành mạnh, nghĩa là chọn ưu tiên sức khỏe. Đồng hồ thông minh GPS kích thước nhỏ gọn chính là sự lựa chọn hàng đầu với trọn vẹn các tính năng sức khỏe và thể chất tiên tiến nhất.\u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv class=\"app__overview__intro__icons app__column-layout app__column-layout__column--3\"\u003e\n\u003cdiv class=\"app__feature__card\"\u003e                                                                                                                            \u003cimg class=\"app__feature__card__image\" src=\"https://static.garmincdn.com/gdc/Product_Pages/ICONS/Health_Monitoring.svg\" alt=\"\" width=\"50\" height=\"50\" /\u003e\n\u003cp class=\"app__feature__card__description\" style=\"text-align: center;\"\u003eTheo dõi sát sao các thống kê sức khỏe cụ thế và hiểu rõ hơn về trạng thái thể chất mọi lúc.\u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv class=\"app__feature__card\"\u003e                                                                                                                            \u003cimg class=\"app__feature__card__image\" src=\"https://static.garmincdn.com/gdc/Product_Pages/ICONS/Preloaded_Sports_Apps.svg\" alt=\"\" width=\"50\" height=\"50\" /\u003e\n\u003cp class=\"app__feature__card__description\" style=\"text-align: center;\"\u003e Đa dạng hóa bài tập với hơn 25 bộ môn thể thao được tải sẵn.\u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv class=\"app__feature__card\"\u003e                                                                                                                           \u003cimg class=\"app__feature__card__image\" src=\"https://static.garmincdn.com/gdc/Product_Pages/ICONS/Animated_Workouts.svg\" alt=\"\" width=\"50\" height=\"50\" /\u003e\n\u003cp class=\"app__feature__card__description\" style=\"text-align: center;\"\u003eCá nhân hóa kế hoạch tập luyện theo khả năng của riêng bạn với Garmin Coach. Đồng thời, giãn cơ thú vị hơn với các bài tập động được cài sẵn ngay trên đồng hồ.\u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv class=\"app__feature__card\"\u003e                                                                                                                             \u003cimg class=\"app__feature__card__image\" src=\"https://salt.tikicdn.com/ts/tmp/8e/d3/b6/9d677a6bedc0f0979a5fbb6fbd631157.jpg\" alt=\"\" width=\"50\" height=\"50\" /\u003e\n\u003cp class=\"app__feature__card__description\" style=\"text-align: center;\"\u003e Lưu trữ nhạc trực tiếp trên Venu 2/2S và tự tin bỏ lại chiếc điện thoại cồng kềnh phía sau.\u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv class=\"app__feature__card\"\u003e                                                                                                                            \u003cimg class=\"app__feature__card__image\" src=\"https://static.garmincdn.com/gdc/Product_Pages/ICONS/Battery_Life.svg\" alt=\"\" width=\"50\" height=\"50\" /\u003e\n\u003cp class=\"app__feature__card__description\" style=\"text-align: center;\"\u003e Màn hình AMOLED sắc nét và thời lượng pin lên đến 10 ngày? Siêu ấn tượng, đúng không!\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"app__life-style app__life-style--light\"\u003e\n\u003cdiv class=\"app__img-banner app__life-style__img-con\"\u003e\u003cimg class=\"app__img-banner__img__desktop app__img-banner__img\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/db/58/24/98c20a7acb220aec306dac994006fc94.jpg\" alt=\"\" /\u003e\u003c/div\u003e\n\u003cdiv class=\"app__life-style__text__con app__life-style__text__con--left app__life-style__text__con__mobile--left app__life-style__text__con__mobile--top\"\u003e \u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"app__layout-container app__layout-container--small app__layout-container--light\"\u003e\n\u003cdiv class=\"app__column-layout app__column-layout__column--3\"\u003e\n\u003cdiv class=\"app__feature__card\"\u003e\n\u003ch3 class=\"app__feature__card__title light left\"\u003eKIỂU DÁNG SANG TRỌNG - PHỐI MÀU TINH TẾ\u003c/h3\u003e\n\u003cp class=\"app__feature__card__description\"\u003eMàn hình AMOLED tuyệt đẹp mang lại trải nghiệm sống động vượt mong đợi - ngay cả dưới ánh sáng mặt trời. Chế độ \"Luôn Sáng\" để hiển thị màn hình bất kì lúc nào\u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv class=\"app__feature__card\"\u003e\n\u003ch3 class=\"app__feature__card__title light left\"\u003eĐƯỢC CHẾ TÁC CHO LỐI SỐNG NĂNG ĐỘNG\u003c/h3\u003e\n\u003cp class=\"app__feature__card__description\"\u003eBền bỉ với kính cường lực Corning Gorilla Glass 3, sang trọng cùng viền thép sáng bóng và dây Silicone chất lượng cao - Venu 2 luôn sẵn sàng cho mọi hoạt động.\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"app__life-style app__life-style--dark\"\u003e\n\u003cdiv class=\"app__img-banner app__life-style__img-con\"\u003e\u003cimg class=\"app__img-banner__img__desktop app__img-banner__img\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/f3/56/9e/c11cdc62ab7e582b8fb277551326b5ef.jpg\" alt=\"\" /\u003e\u003c/div\u003e\n\u003cdiv class=\"app__life-style__text__con app__life-style__text__con--left app__life-style__text__con__mobile--left app__life-style__text__con__mobile--top\"\u003e\n\u003ch2 class=\"app__life-style__text\"\u003eTự do tùy biến theo ý thích của bạn\u003c/h2\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"app__layout-container app__layout-container--small app__layout-container--light\"\u003e\n\u003cdiv class=\"app__column-layout app__column-layout__column--3\"\u003e\n\u003cdiv class=\"app__feature__card\"\u003e\u003cimg class=\"app__feature__card__image\" src=\"https://salt.tikicdn.com/ts/product/1f/e9/c1/a0d7275099d906be6dcbb4b00fe8067b.png\" alt=\"\" /\u003e\n\u003ch3 class=\"app__feature__card__title light left\"\u003eTHỐNG KÊ TỔNG QUÁT VỀ SỨC KHỎE\u003c/h3\u003e\n\u003cp class=\"app__feature__card__description\"\u003eNhanh chóng kết nối đồng bộ với cơ thể bạn chỉ với 2 phút để ghi lại các số liệu thống kê chính, bao gồm nhịp tim, thay đổi nhịp tim, Pulse Ox, hô hấp và mức căng thẳng. Từ đó đưa ra thống kê báo cáo chi tiết về các chỉ số thể chất thông qua ứng dụng Garmin Connect trên điện thoại thông minh tương thích.\u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv class=\"app__feature__card\"\u003e\u003cimg class=\"app__feature__card__image\" src=\"https://salt.tikicdn.com/ts/product/d1/14/b7/be691f2d00308ec546eb488835439fcf.png\" alt=\"\" /\u003e\n\u003ch3 class=\"app__feature__card__title light left\"\u003eTHEO DÕI NĂNG LƯỢNG CƠ THỂ - BODY BATTERY\u003c/h3\u003e\n\u003cp class=\"app__feature__card__description\"\u003eCông nghệ Body Battery độc quyền của Garmin với khả năng cập nhật liên tục Mức Năng Lượng Cơ Thể, giúp bạn chủ động lên kế hoạch cho ngày làm việc hiệu suất nhất.\u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv class=\"app__feature__card\"\u003e\u003cimg class=\"app__feature__card__image\" src=\"https://salt.tikicdn.com/ts/product/71/73/9d/f6e085d930b9404958b828f572b54a25.png\" alt=\"\" /\u003e\n\u003ch3 class=\"app__feature__card__title light left\"\u003eCẢM BIẾN PULSE OX\u003c/h3\u003e\n\u003cp class=\"app__feature__card__description\"\u003eSử dụng cảm biến Pulse Ox\u003csup\u003e3\u003c/sup\u003e để kiểm tra độ bão hòa oxy trong máu của bạn tức thời - tại bất kỳ thời điểm nào trong ngày, thâm chí khi bạn đang ngủ.\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"app__column-layout app__column-layout__column--3\"\u003e\n\u003cdiv class=\"app__feature__card\"\u003e\u003cimg class=\"app__feature__card__image\" src=\"https://salt.tikicdn.com/ts/product/0a/72/9c/fceb666a6b95193bcfdb04dd1f908bc7.png\" alt=\"\" /\u003e\n\u003ch3 class=\"app__feature__card__title light left\"\u003eĐO MỨC CĂNG THẲNG\u003c/h3\u003e\n\u003cp class=\"app__feature__card__description\"\u003eHôm nay, tâm trạng bạn thế nào? Công việc quá căng thẳng hay đang thoải mái và năng suất? Venu 2/2s thậm chí sẽ hướng dẫn cách thư giãn với những hơi thở chậm rãi khi nhận biết sự căng thẳng của bạn.\u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv class=\"app__feature__card\"\u003e\u003cimg class=\"app__feature__card__image\" src=\"https://salt.tikicdn.com/ts/product/a3/79/6c/4e48b54cf9676018bcc4b5c6522f7265.png\" alt=\"\" /\u003e\n\u003ch3 class=\"app__feature__card__title light left\"\u003eQUAN SÁT SỨC KHỎE PHỤ NỮ\u003c/h3\u003e\n\u003cp class=\"app__feature__card__description\"\u003eSử dụng ứng dụng Garmin Connect để theo dõi chu kỳ kinh nguyệt hoặc thai sản. Ghi nhật ký các triệu chứng, bài tập, kiến thức dinh dưỡng,...xuyên suốt chu kỳ. Với tính năng Theo Dõi Sức Khỏe Phụ Nữ, bạn có thể xem và ghi lại mọi thông tin trong suốt chu kỳ ngay trên cổ tay.\u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv class=\"app__feature__card\"\u003e\u003cimg class=\"app__feature__card__image\" src=\"https://salt.tikicdn.com/ts/product/84/f2/74/5232640fbc196668e3a8b1a58420914c.png\" alt=\"\" /\u003e\n\u003ch3 class=\"app__feature__card__title light left\"\u003eTHEO DÕI LƯỢNG NƯỚC\u003c/h3\u003e\n\u003cp class=\"app__feature__card__description\"\u003eGhi lại lượng nước đã uống hàng ngày để nhắc nhở bù nước khi cần thiết. Bên cạnh đó, bạn có thể đặt mục tiêu tự động theo giờ để tự nhắc bản thân uống nước (dựa trên lượng mồ hôi tiết ra trong các hoạt động)\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"app__column-layout app__column-layout__column--3\"\u003e\n\u003cdiv class=\"app__feature__card\"\u003e\u003cimg class=\"app__feature__card__image\" src=\"https://salt.tikicdn.com/ts/product/16/03/e3/c940cf82340a2ac6bfd3b1105ed0baf5.png\" alt=\"\" /\u003e\n\u003ch3 class=\"app__feature__card__title light left\"\u003eTHEO DÕI HÔ HẤP\u003c/h3\u003e\n\u003cp class=\"app__feature__card__description\"\u003eTheo dõi cách bạn hít thở suốt cả ngày, trong khi ngủ, trong các bài tập thở và các hoạt động thể chất như yoga.\u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv class=\"app__feature__card\"\u003e\u003cimg class=\"app__feature__card__image\" src=\"https://salt.tikicdn.com/ts/product/6c/77/a8/fd7e189db753d635d13a12f42254d72d.png\" alt=\"\" /\u003e\n\u003ch3 class=\"app__feature__card__title light left\"\u003eTÍNH NĂNG CHẤM ĐIỂM GIẤC NGỦ VỚI CÁC CHỈ SỐ GIẤC NGỦ\u003c/h3\u003e\n\u003cp class=\"app__feature__card__description\"\u003eTheo dõi các giai đoạn ngủ khác nhau cũng như nhịp tim, căng thẳng, Pulse Ox\u003csup\u003e3\u003c/sup\u003e và hô hấp. Ngoài ra, Garmin còn đưa ra điểm số đánh giá chất lượng giấc ngủ của bạn, giúp bạn có cái nhìn tổng quát và cải thiện thời gian nghỉ ngơi.\u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv class=\"app__feature__card\"\u003e\u003cimg class=\"app__feature__card__image\" src=\"https://salt.tikicdn.com/ts/product/3c/21/58/f674e4ee48ec87a3fd33d3d9f0cddd69.png\" alt=\"\" /\u003e\n\u003ch3 class=\"app__feature__card__title light left\"\u003eĐO NHỊP TIM NGAY TRÊN CỔ TAY\u003c/h3\u003e\n\u003cp class=\"app__feature__card__description\"\u003eĐồng hồ liên tục ghi nhận nhịp tim của bạn - đồng thời đưa ra cảnh báo nếu nhịp tim quá cao hoặc quá thấp trong lúc bạn nghỉ ngơi. Công nghệ theo dõi dịp tim cũng giúp đánh giá mức độ hiệu quả tập luyện của bạn, thâm chí là bơi lội.\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"app__column-layout app__column-layout__column--3\"\u003e\n\u003cdiv class=\"app__feature__card\"\u003e\u003cimg class=\"app__feature__card__image\" src=\"https://salt.tikicdn.com/ts/product/14/fc/a0/e2941ab205ff6b747111aeda4a7c90c5.png\" alt=\"\" /\u003e\n\u003ch3 class=\"app__feature__card__title light left\"\u003eTHỞ ĐÚNG CÁCH\u003c/h3\u003e\n\u003cp class=\"app__feature__card__description\"\u003eKhi bạn muốn thư giãn hoặc tập trung, bạn có thể sử dụng tính năng Theo Dõi Hô Hấp. Khi đó, Venu 2/2s sẽ thực hiện theo dõi mức căng thẳng và nhịp thở để giúp bạn hiểu rõ hơn về tình trạng hô hấp của mình.\u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv class=\"app__feature__card\"\u003e\u003cimg class=\"app__feature__card__image\" src=\"https://salt.tikicdn.com/ts/product/31/0d/40/0534b6f73b0da6b0b746625ca826343a.png\" alt=\"\" /\u003e\n\u003ch3 class=\"app__feature__card__title light left\"\u003eTUỔI THỂ CHẤT\u003c/h3\u003e\n\u003cp class=\"app__feature__card__description\"\u003eTừ cường độ luyện tập và thống kê thể chất được đồng hồ ghi nhận, kết hợp với chỉ số BMI,... Venu 2/2s có thể ước tính độ tuổi thể chất của bạn. Độ tuổi thể chất được chính cơ thể bạn phản ánh - không chỉ được đo bằng thời gian.\u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv class=\"app__feature__card\"\u003e\n\u003cp class=\"app__feature__card__description\"\u003e \u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"app__life-style app__life-style--dark\"\u003e\n\u003cdiv class=\"app__img-banner app__life-style__img-con\"\u003e\u003cimg class=\"app__img-banner__img__desktop app__img-banner__img\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/51/0f/6a/55f4f6d0c80a20b806d6afdcc8f9f7fb.jpg\" alt=\"\" /\u003e\u003c/div\u003e\n\u003cdiv class=\"app__life-style__text__con app__life-style__text__con--left app__life-style__text__con__mobile--left app__life-style__text__con__mobile--top\"\u003e\n\u003ch2 class=\"app__life-style__text\"\u003eTập luyện nào!\u003c/h2\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"app__layout-container app__layout-container--small app__layout-container--light\"\u003e\n\u003cdiv class=\"app__column-layout app__column-layout__column--3\"\u003e\n\u003cdiv class=\"app__feature__card\"\u003e\u003cimg class=\"app__feature__card__image\" src=\"https://salt.tikicdn.com/ts/product/8a/37/84/db1d5fc9c9ee1ac1638457c0f52ec1a3.png\" alt=\"\" /\u003e\n\u003ch3 class=\"app__feature__card__title light left\"\u003eCÁC BÀI TẬP ĐỘNG TÁC SINH ĐỘNG ĐỂ LUYỆN TẬP MỌI NƠI\u003c/h3\u003e\n\u003cp class=\"app__feature__card__description\"\u003eCác bài luyện tập tim mạch, sức bền, yoga, Pilates và luyện tập cường độ cao (HIIT) được mô phỏng sống động ngay trên đồng hồ Venu 2/2s giúp dễ dàng theo dõi và tập theo. Những động tác này được tải sẵn trên đồng hồ. Bạn hoàn toàn có thể tải thêm các bài luyện tập khác từ ứng dụng Garmin Connect.\u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv class=\"app__feature__card\"\u003e\u003cimg class=\"app__feature__card__image\" src=\"https://salt.tikicdn.com/ts/product/dd/79/f5/b3420bb8f7370c3bbde9c9acb8a413c5.png\" alt=\"\" /\u003e\n\u003ch3 class=\"app__feature__card__title light left\"\u003eTÍCH HỢP NHIỀU BỘ MÔN THỂ THAO\u003c/h3\u003e\n\u003cp class=\"app__feature__card__description\"\u003eGhi lại mọi chuyển động của bạn với hơn 25 bộ môn thể thao trong nhà và ngoài trời cùng GPS được tải sẵn (chạy bộ, đạp xe, bơi, golf,...)\u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv class=\"app__feature__card\"\u003e\u003cimg class=\"app__feature__card__image\" src=\"https://salt.tikicdn.com/ts/product/be/8f/c3/537e6d83b1b4ba2d90b449e5a3148550.png\" alt=\"\" /\u003e\n\u003ch3 class=\"app__feature__card__title light left\"\u003eHUẤN LUYỆN NÂNG CAO SỨC BỀN\u003c/h3\u003e\n\u003cp class=\"app__feature__card__description\"\u003eDựa vào công nghệ tối tân của Garmin, thiết bị có thể thực hiện các phép đo và xác định sức bền của bạn ngay trên cổ tay. Đồng thời, tính năng này còn cho phép hiển thị minh họa về những nhóm cơ bạn đang tập trung hoạt động.\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"app__column-layout app__column-layout__column--3\"\u003e\n\u003cdiv class=\"app__feature__card\"\u003e\u003cimg class=\"app__feature__card__image\" src=\"https://salt.tikicdn.com/ts/product/35/a8/2b/1d2923c499496849131366bd4353ed7e.png\" alt=\"\" /\u003e\n\u003ch3 class=\"app__feature__card__title light left\"\u003eBÀI TẬP CƯỜNG ĐỘ CAO (HIIT)\u003c/h3\u003e\n\u003cp class=\"app__feature__card__description\"\u003eTrải nghiệm HIIT với nhiều bộ hẹn giờ khác nhau để theo dõi bài tập của bạn, Venu 2/2s sở hữu nhiều loại hình bài tập như AMRAP, EMOM, Tabata,...Ngoài ra, bạn có thể tự do tùy biến về số lần tập, khoảng thời gian tập luyện/nghỉ ngơi,...\u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv class=\"app__feature__card\"\u003e\u003cimg class=\"app__feature__card__image\" src=\"https://salt.tikicdn.com/ts/product/85/ef/46/b052a555ab2734421becbf15672cb637.png\" alt=\"\" /\u003e\n\u003ch3 class=\"app__feature__card__title light left\"\u003eTẠO LỊCH TRÌNH LUYỆN TẬP RIÊNG\u003c/h3\u003e\n\u003cp class=\"app__feature__card__description\"\u003eLựa chọn từ hệ thống \u0026gt;400 bài tập để xây dựng lịch trình tập luyện riêng của bạn từ ứng dụng Garmin Connect trên điện thoại thông minh tương thích. Sau đó tải chúng về đồng hồ.\u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv class=\"app__feature__card\"\u003e\u003cimg class=\"app__feature__card__image\" src=\"https://salt.tikicdn.com/ts/product/bb/ef/86/d92932660c661a28043f40632a81c1ed.png\" alt=\"\" /\u003e\n\u003ch3 class=\"app__feature__card__title light left\"\u003eHUẤN LUYỆN VIÊN GARMIN - GAMRIN COACH\u003c/h3\u003e\n\u003cp class=\"app__feature__card__description\"\u003eDựa vào tình trạng thể chất và khả năng làm việc của bạn, Garmin Coach sẽ đưa ra Giáo Trình Tập Luyện Khuyến Nghị miễn phí, giúp bạn luyện tập cho chặng 5K, 10K hoặc bán Marathon trong thời gian mong muốn.\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"app__column-layout app__column-layout__column--3\"\u003e\n\u003cdiv class=\"app__feature__card\"\u003e\u003cimg class=\"app__feature__card__image\" src=\"https://salt.tikicdn.com/ts/product/96/54/c1/0c5df996b8e2ef9b1b5ec592112b388a.png\" alt=\"\" /\u003e\n\u003ch3 class=\"app__feature__card__title light left\"\u003eSỐ PHÚT LUYỆN TẬP TÍCH CỰC\u003c/h3\u003e\n\u003cp class=\"app__feature__card__description\"\u003eThời điểm nào bạn tập luyện hiệu quả nhất? Hoạt động nào đốt cháy năng lượng tốt nhất? Intensity Minutes sẽ là tính năng đưa đáp án cho bạn. Bạn cũng có thể xem chúng như một trường dữ liệu trong các hoạt động được hẹn giờ trước.\u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv class=\"app__feature__card\"\u003e\n\u003cp class=\"app__feature__card__description\"\u003e \u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv class=\"app__feature__card\"\u003e\n\u003cp class=\"app__feature__card__description\"\u003e \u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"app__life-style app__life-style--dark\"\u003e\n\u003cdiv class=\"app__img-banner app__life-style__img-con\"\u003e\u003cimg class=\"app__img-banner__img__desktop app__img-banner__img\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/28/d8/ef/da9909188903417105d36b794b836939.jpg\" alt=\"\" /\u003e\u003c/div\u003e\n\u003cdiv class=\"app__life-style__text__con app__life-style__text__con--left app__life-style__text__con__mobile--left app__life-style__text__con__mobile--top\"\u003e\n\u003ch2 class=\"app__life-style__text\"\u003eRất dễ dàng để kết nối.\u003c/h2\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"app__layout-container app__layout-container--small app__layout-container--light\"\u003e\n\u003cdiv class=\"app__column-layout app__column-layout__column--3\"\u003e\n\u003cdiv class=\"app__feature__card\"\u003e\u003cimg class=\"app__feature__card__image\" src=\"https://salt.tikicdn.com/ts/product/09/57/97/62b174216cef5ee484f41643b3154237.png\" alt=\"\" /\u003e\n\u003ch3 class=\"app__feature__card__title light left\"\u003eNHẬN THÔNG BÁO, TIN NHẮN THÔNG MINH\u003c/h3\u003e\n\u003cp class=\"app__feature__card__description\"\u003eNhận tin nhắn văn bản và cảnh báo ngay trên đồng hồ của bạn khi được ghép đôi với điện thoại thông minh tương thích. Ngoài ra, Venu 2/2s còn hỗ trợ trả lời tin nhắn văn bản ngay trên đồng hồ nếu bạn sử dụng điện thoại Android.\u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv class=\"app__feature__card\"\u003e\u003cimg class=\"app__feature__card__image\" src=\"https://salt.tikicdn.com/ts/product/bb/5f/17/0688da23bc18ac9b4f1b380dce9ff995.png\" alt=\"\" /\u003e\n\u003ch3 class=\"app__feature__card__title light left\"\u003eÂM NHẠC TRONG TẦM TAY\u003c/h3\u003e\n\u003cp class=\"app__feature__card__description\"\u003eLưu trữ ngay trên đồng hồ các bài hát và playlist yêu thích từ tài khoản Spotify, Deezer hoặc Amazon Music của bạn. Sử dụng tai nghe không dây (được bán rời) để nghe nhạc thoải mái mà không cần điện thoại.\u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv class=\"app__feature__card\"\u003e\u003cimg class=\"app__feature__card__image\" src=\"https://salt.tikicdn.com/ts/product/a7/30/0e/228f5a0666158434cfa2aec1413a2eed.png\" alt=\"\" /\u003e\n\u003ch3 class=\"app__feature__card__title light left\"\u003eDÕI THEO SỰ AN TOÀN CỦA BẠN\u003c/h3\u003e\n\u003cp class=\"app__feature__card__description\"\u003eTrong điều kiện điện thoại và đồng hồ được kết nối, khi thiết bị nhận biết sự cố/va chạm mạnh, đồng hồ sẽ tự động gửi vị trí của bạn có thể được gửi tới các liên hệ khẩn cấp đã được cài đặt sẵn.\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"app__column-layout app__column-layout__column--3\"\u003e\n\u003cdiv class=\"app__feature__card\"\u003e\u003cimg class=\"app__feature__card__image\" src=\"https://salt.tikicdn.com/ts/product/90/c8/21/7a587eb291e70f16afb3adbf5cd9c7e5.png\" alt=\"\" /\u003e\n\u003ch3 class=\"app__feature__card__title light left\"\u003eCỬA HÀNG CONNECT IQ\u003c/h3\u003e\n\u003cp class=\"app__feature__card__description\"\u003eTải xuống các mặt đồng hồ tùy chỉnh, thêm các trường dữ liệu đồng thời cài đặt thêm các ứng dụng từ cửa hàng cực kỳ phong phú. .\u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv class=\"app__feature__card\"\u003e\u003cimg class=\"app__feature__card__image\" src=\"https://salt.tikicdn.com/ts/product/c1/72/c1/d7477b6d29a5c8759a3119e2449110eb.png\" alt=\"\" /\u003e\n\u003ch3 class=\"app__feature__card__title light left\"\u003eĐỒNG BỘ HÓA VỚI GARMIN CONNECT\u003c/h3\u003e\n\u003cp class=\"app__feature__card__description\"\u003eXem toàn bộ thông tin sức khỏe và thể chất của bạn trong cùng một ứng dụng. Ứng dụng Garmin Connect là một cộng đồng trực tuyến phát triển của người dùng Garmin - nơi mà mọi người có thể kết nối, cùng thi đấu và chia sẻ.\u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv class=\"app__feature__card\"\u003e \u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"app__life-style app__life-style--dark\"\u003e\n\u003cdiv class=\"app__img-banner app__life-style__img-con\"\u003e\u003cimg class=\"app__img-banner__img__desktop app__img-banner__img\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/44/a8/0e/b37d6a221d0d86399ae9efe0ba7e6535.jpg\" alt=\"\" /\u003e\u003c/div\u003e\n\u003cdiv class=\"app__life-style__text__con app__life-style__text__con--left app__life-style__text__con__mobile--left app__life-style__text__con__mobile--top\"\u003e\n\u003ch2 class=\"app__life-style__text\"\u003eGiữ kết nối mọi lúc, mọi nơi\u003c/h2\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"app__layout-container app__layout-container--small app__layout-container--light\"\u003e\n\u003cdiv class=\"app__column-layout app__column-layout__column--3\"\u003e\n\u003cdiv class=\"app__feature__card\"\u003e\u003cimg class=\"app__feature__card__image\" src=\"https://salt.tikicdn.com/ts/product/90/c8/21/7a587eb291e70f16afb3adbf5cd9c7e5.png\" alt=\"\" /\u003e\n\u003ch3 class=\"app__feature__card__title light left\"\u003eTHỜI LƯỢNG PIN\u003c/h3\u003e\n\u003cp class=\"app__feature__card__description\"\u003eThời lượng Pin bền bỉ hơn và khả năng sạc nhanh ấn tượng giúp bạn sử dụng liên tục một cách thoải mái. Lên đến 10 ngày ở chế độ đồng hồ thông minh, lên đến 19 giờ ở chế độ GPS và lên đến 7 giờ ở chế độ GPS với âm nhạc.\u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv class=\"app__feature__card\"\u003e\u003cimg class=\"app__feature__card__image\" src=\"https://salt.tikicdn.com/ts/product/36/57/c0/9a2aadabfa5b6d3253c8d85f7a0302a2.png\" alt=\"\" /\u003e\n\u003ch3 class=\"app__feature__card__title light left\"\u003eCHẾ ĐỘ TIẾT KIỆM PIN\u003c/h3\u003e\n\u003cp class=\"app__feature__card__description\"\u003eĐúng vậy! Bạn hoàn toàn có thể kéo dài thời lượng pin tới tối đa bằng cách điều chỉnh các tính năng trong phần cài đặt để tiết kiệm Pin.\u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv class=\"app__feature__card\"\u003e\u003cimg class=\"app__feature__card__image\" src=\"https://salt.tikicdn.com/ts/product/dd/79/f5/183a79119929cbaa252278d293861e79.png\" alt=\"\" /\u003e\n\u003ch3 class=\"app__feature__card__title light left\"\u003eCHỈ SỐ CHỐNG NƯỚC\u003c/h3\u003e\n\u003cp class=\"app__feature__card__description\"\u003eVenu 2/2s sở hữu chỉ số chống nước đến 5ATM để bạn thoải mái bơi lội, đeo đồng hồ cả trong lúc tắm hoặc spa.\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/3a/28/fd/2b988e86f757934864aff0ed508de5f7.JPG","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/3a/28/fd/2b988e86f757934864aff0ed508de5f7.JPG","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/3a/28/fd/2b988e86f757934864aff0ed508de5f7.JPG","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3a/28/fd/2b988e86f757934864aff0ed508de5f7.JPG","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3a/28/fd/2b988e86f757934864aff0ed508de5f7.JPG"},{"base_url":"https://salt.tikicdn.com/ts/product/02/cb/3c/f4b2c4c2cac4eb0e73cd216eac44f720.JPG","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/02/cb/3c/f4b2c4c2cac4eb0e73cd216eac44f720.JPG","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/02/cb/3c/f4b2c4c2cac4eb0e73cd216eac44f720.JPG","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/02/cb/3c/f4b2c4c2cac4eb0e73cd216eac44f720.JPG","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/02/cb/3c/f4b2c4c2cac4eb0e73cd216eac44f720.JPG"},{"base_url":"https://salt.tikicdn.com/ts/product/74/21/e6/1b68e5124eb7aa4da2fc07bb414eb89e.JPG","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/74/21/e6/1b68e5124eb7aa4da2fc07bb414eb89e.JPG","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/74/21/e6/1b68e5124eb7aa4da2fc07bb414eb89e.JPG","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7