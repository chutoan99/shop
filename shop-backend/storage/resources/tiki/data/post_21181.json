und_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":6000,"discount_rate":10,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/8d/41/61/30621a9362e529f907b7cdce8e0afee0.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":651,"all_time_quantity_sold":5,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eDalaHouse dựa trên nghiên cứu, tìm hiểu nhu cầu và đóng góp từ khách hàng, đã nghiên cứu cho ra các loại \u003cstrong\u003ebột rau củ\u003c/strong\u003e dành cho trẻ em. Thật phí phạm nếu như bỏ qua việc chế biến \u003cstrong\u003ebột rau củ \u003c/strong\u003evì cơ thể của trẻ rất cần chất xơ, vitamin, khoáng chất để phát triển não bộ và thể chất.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eBột rau củ \u003c/strong\u003e\u003cstrong\u003echo bé\u003c/strong\u003e của DalaHouse bao gồm 7 loại bột: bột cải xoăn, bột bó xôi, bột bí đỏ, bột khoai lang tím, bột đậu hà lan, bột măng tây, bột chùm ngây.\u003c/p\u003e\n\u003cp\u003eDalahouse là thương hiệu bột rau thuần hữu cơ nổi tiếng của Việt Nam, đạt chuẩn hữu cơ hoa kỳ và được bán trên các kênh TMDK hoa kỳ\u003c/p\u003e\n\u003cp\u003eDalahous là thương hiêu Việt được recommend dành cho trẻ em tại Mỹ muốn tăng cân, bổ sung dinh dưỡng cho trẻ\u003c/p\u003e\n\u003cp\u003eSản phẩm thu hoạch trực tiếp tại nông trại, chế biến ngay, sấy lạnh để giữ dinh dưỡng, tiệt trùng và nghiền mịn nên hoàn toàn không có mối nguy về giun sán ký sinh trùng từ rau tươi\u003c/p\u003e\n\u003cp\u003eCông nghệ sấy lạnh hiện đại giúp giữ được trên 90% diệp lục tố, chất dinh dưỡng và chất sơ. Đồng thời chất dinh dưỡng không bị mất đi theo thời gian nhhuw rau tươi\u003c/p\u003e\n\u003cp\u003eRau được nghiền mịn nên rất dễ sử dụng cho các bé khi ăn hay uống\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/54/63/6a/af8597c5050027c5ec27de3e6a0b4183.jpg\" alt=\"\" width=\"750\" height=\"502\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/e3/a7/63/33427e8d3ec6b4440c994b9bce17a859.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ba/d2/bc/60fe8b964be4e6ff72cdc78f14061042.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/cd/96/c7/149674c232209714050fd0784c1b0f73.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e1 Gói bột rau trọng lượng 3gr tương đương 2 chén rau tươi giúp bổ sung hoàn hảo chất sơ/rau xanh cho bé. Đồng thời giúp mẹ tiết kiệm được rất nhiều thời gian, công sức cũng như mối nguy nhiễm chéo từ thiết bị sơ chế như dao thớt mà vẫn chăm bé được đầy đủ cũng như có thể mang theo bất kỳ chỗ nào, sử dụng mọi lúc mọi nơi \u003c/p\u003e\n\u003cp\u003eĐối tượng sử dụng: Dành cho bé từ 6 tháng đến 10 tuổi\u003c/p\u003e\n\u003cp\u003eHộp sản phẩm bao gồm 7 vị cho mẹ và bé nhiều hơn sự lựa chọn. Bao gồm 7 gói mỗi gói 3gr các vị: \u003c/p\u003e\n\u003cp\u003e- bột măng tây,\u003c/p\u003e\n\u003cp\u003e- bột cải xoăn,\u003c/p\u003e\n\u003cp\u003e- bột đậu hà lan,\u003c/p\u003e\n\u003cp\u003e- bột cải bó xôi\u003c/p\u003e\n\u003cp\u003e- bột khoai lang tím\u003c/p\u003e\n\u003cp\u003e- bột bí đỏ và\u003c/p\u003e\n\u003cp\u003e- bột chùm ngây\u003c/p\u003e\n\u003cp\u003eNgày sản xuất: Xem trên bao bì\u003c/p\u003e\n\u003cp\u003eHạn sử dụng: 12 tháng kể từ ngày sản xuất\u003c/p\u003e\n\u003cp\u003eXuất sứ: Đơn Dương - Lâm Đồng - Việt Nam\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCÁCH DÙNG\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Uống nước: 1 gói 3gr bột + 500ml nước lọc, nên cho vào chai lắc nhẹ sẽ giúp dễ tan\u003c/p\u003e\n\u003cp\u003e- Thức ăn chín như Cháo/Súp, Sau khi nấu chín thì tắt bếp, cho bột rau củ vào và khuấy đều là bé dùng được\u003c/p\u003e\n\u003cp\u003e- Lần đầu tiên, nên cho lượng bằng 1/2 hoặc 1/3 gói cho bé làm quen\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ba/90/23/5061ade6a0bfbd455bd29b613a6b1617.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/39/0b/e6/4ccce3f4fb7fd508c26f320ab6ad771d.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/b4/17/9f/1cab0c612b60b124cb19b7e3ea9c305f.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/8d/41/61/30621a9362e529f907b7cdce8e0afee0.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/8d/41/61/30621a9362e529f907b7cdce8e0afee0.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/8d/41/61/30621a9362e529f907b7cdce8e0afee0.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8d/41/61/30621a9362e529f907b7cdce8e0afee0.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8d/41/61/30621a9362e529f907b7cdce8e0afee0.png"},{"base_url":"https://salt.tikicdn.com/ts/product/36/c2/61/c5f30f91b328a2dc7618dea270b22596.jpeg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w