971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":70400,"discount_rate":21,"rating_average":3.3,"review_count":6,"review_text":"(6)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/b2/bb/f2/1ee34df4606a70f80cd97410506e9ffd.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1643,"all_time_quantity_sold":41,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003eGiới thiệu\u003c/h3\u003e\n\u003cp\u003eLàn da của bé vô cùng non nớt và nhạy cảm. Chính vì thế những sản phẩm vệ sinh cho bé trong những năm tháng đầu đời phải mang những đặc điểm thật riêng biệt và tối ưu phù hợp làn da bé cũng như bảo vệ tốt sức khỏe của bé. Đến từ thương hiệu Unicharm, sản phẩm \u003cstrong\u003eTã dán Bobby size S\u003c/strong\u003e siêu mỏng sẽ giúp bố mẹ yên tâm về những điều trên. Hệ thun co giãn linh hoạt, bề mặt 3D khô thoáng cùng mặt đáy siêu thấm, siêu thoát ẩm, của tã sẽ mang đến cho bé những giờ phút vui chơi cũng như những vận động thật thoải mái và dễ chịu. Bé tự do khám phá thế giới mà không lo bị làm phiền bởi tràn tã hay ngứa rát vì chứng hăm da.\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/b2/bb/f2/047b4177fe9d1bff39b6f9e32f108adf.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eThông tin sản phẩm\u003c/strong\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eXuất xứ : Nhật Bản\u003c/li\u003e\n\u003cli\u003eNơi sản xuất : Việt Nam\u003c/li\u003e\n\u003cli\u003eHạn sử dụng : 4 năm kể từ ngày sản xuất\u003c/li\u003e\n\u003cli\u003eSize S - gói 80 miếng dành cho bé từ 4 - 7kg\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003e\u003cstrong\u003eĐặc điểm nổi bật\u003c/strong\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eBề mặt 3D khô thoáng: Tã dán Bobby size S có bề mặt tã được thiết kế với cấu tạo dạng sóng với vô số rãnh thấm hút siêu nhanh, đẩy hơi nóng ẩm ra ngoài cho bề mặt tã khô thoáng dài lâu.\u003cbr /\u003e\u003cbr /\u003e\u003c/li\u003e\n\u003cli\u003eLớp thấm nhanh siêu tốc: Nhanh chóng dàn đều và giữ sâu chất lỏng, thấm hút thật nhiều mà không lo dày bí, cho làn da bé luôn khô thoáng.\u003cbr /\u003e\u003cbr /\u003e\u003c/li\u003e\n\u003cli\u003eHệ thun Magic Fit: Co giãn linh hoạt theo từng cử động của bé nên miếng tã luôn vừa vặn, thoải mái lại chống tràn hiệu quả hơn.\u003cbr /\u003e\u003cbr /\u003e\u003c/li\u003e\n\u003cli\u003eĐai dính trước bụng Cotton – Soft: Đai dính dạng vải mềm mại, phù hợp với làn da non nớt của bé. Mẹ không lo tã sẽ in hằn gây ngứa rát hay tổn thương khó chịu cho bé.\u003cbr /\u003e\u003cbr /\u003e\u003c/li\u003e\n\u003cli\u003eMàng đáy thoát ẩm đa chiều: Nhanh chóng đẩy hơi nóng ẩm ra ngoài, giúp da hô hấp tự nhiên, ngăn ngừa hăm tã.\u003cbr /\u003e\u003cbr /\u003e\u003c/li\u003e\n\u003cli\u003eTinh chất trà xanh: Tính năng diệt khuẩn và khử mùi nhẹ nhàng mang đến hương thơm mát, ngừa hăm tã hiệu quả.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/df/2f/42/1335fbd065ff2ac99fc0213e9986ff6a.jpg\" alt=\"Tã Dán Bobby Siêu Mỏng Thấm Gói Siêu Lớn L68 (68 Miếng)\" width=\"750\" height=\"2435\" /\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eThông tin thương hiệu\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eBobby là thương hiệu nổi tiếng của công ty Diana, thuộc tập đoàn Unicharm Nhật Bản, chuyên cung cấp những sản phẩm chất lượng cao cấp dành cho trẻ em. Ra mắt thị trường Việt Nam từ năm 2003, Bobby trở thành thương hiệu tã giấy được ưa chuộng và tin dùng bởi sự sáng tạo độc đáo và đầy yêu thương dành cho trẻ em, với thiết kế các loại tã giấy màng đáy thoáng khí dạng vải, đem đến sự khô thoáng và bảo vệ làn da của các bé. Tháng 12 năm 2005, Bobby lại đi tiên phong trên thị trường Việt Nam bằng việc cải tiến sản phẩm tã giấy chống hăm 3 tác động với lõi bông siêu thấm, màng đáy thoáng khí dạng vải và tinh chất trà xanh. Sử dụng dây chuyền sản xuất hiện đại kết hợp với thế mạnh là thành viên của tập đoàn hàng đầu thế giới Unicharm Nhật Bản, công ty Diana luôn đi đầu trong việc ứng dụng các công nghệ hiện đại trong lĩnh vực sản xuất các sản phẩm chăm sóc vệ sinh cá nhân để sáng tạo ra những sản phẩm chất lượng cao nhất, phù hợp nhất và Bobby là một minh chứng cho điều đó.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/b2/bb/f2/1ee34df4606a70f80cd97410506e9ffd.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b2/bb/f2/1ee34df4606a70f80cd97410506e9ffd.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b2/bb/f2/1ee34df4606a70f80cd97410506e9ffd.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b2/bb/f2/1ee34df4606a70f80cd97410506e9ffd.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b2/bb/f2/1ee34df4606a70f80cd97410506e9ffd.png"},{"base_url":"https://salt.tikicdn.com/ts/product/88/3a/2a/e93090ca812ff28f38ee5a5560de112b.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/88/3a/2a/e93090ca812ff28f38ee5a5560de112b.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/88/3a/