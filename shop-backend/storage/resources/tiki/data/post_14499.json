3b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":70000,"discount_rate":15,"rating_average":4.5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/57/95/09/9b482d92bd4e451b1fc528d81e91901d.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":673,"all_time_quantity_sold":22,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cdiv style=\"text-align:justify;\"\u003eCuốn sách ” Các Biểu Mẫu Nhân Sự Khó Tìm Liên Quan Đến Pháp Luật Lao Động ” dễ dàng tra cứu và tìm được các thông tin pháp luật lao động hữu ích và thực tế có liên quan đến công tác nhân sự và quản lý nhân sự trong doanh nghiệp.\u003c/div\u003e\n\u003cdiv style=\"text-align:justify;\"\u003eChia sẻ hơn 20 năm kinh nghiệm tư vấn và cung cấp các giải pháp pháp lý cho cá nhân và doanh nghiệp trong và ngoài nước.\u003c/div\u003e\n\u003cdiv style=\"text-align:justify;\"\u003eDành cho những người trực tiếp làm công tác nhân sự trong doanh nghiệp và những người gián tiếp thực hiện các công việc có liên quan đến nhân sự (ví dụ như ban giám đốc, kế toán) cũng như các luật sư nội bộ đang làm việc tại các doanh nghiệ\u003c/div\u003e\n\u003cdiv style=\"text-align:justify;\"\u003eCung cấp gần như toàn bộ các biểu mẫu nhân sự cần thiết mà pháp luật lao động yêu cầu người sử dụng lao động phải có khi gặp tình huống cần xử lý trong mối quan hệ lao động theo quy định pháp luật.\u003c/div\u003e\n\u003cdiv style=\"text-align:justify;\"\u003eCác biểu mẫu nhân sự về pháp luật lao động được trình bày dưới dạng song ngữ Việt Anh giúp độc giả thuận tiện tham chiếu và áp dụng phù hợp.\u003c/div\u003e\n\u003cdiv style=\"text-align:justify;\"\u003e—\u003c/div\u003e\n\u003cdiv style=\"text-align:justify;\"\u003eQuyển sách gồm có 11 Chương\u003c/div\u003e\n\u003cdiv style=\"text-align:justify;\"\u003e \u003c/div\u003e\n\u003cdiv style=\"text-align:justify;\"\u003eGiới thiệu 11 Chương trong Các biểu mẫu nhân sự khó tìm liên quan đến Pháp luật Lao động.\u003c/div\u003e\n\u003cdiv style=\"text-align:justify;\"\u003e \u003c/div\u003e\n\u003cdiv style=\"text-align:justify;\"\u003e \u003c/div\u003e\n\u003cdiv style=\"text-align:justify;\"\u003eChương 1- Các biểu mẫu về Tuyển dụng lao động và thử việc\u003c/div\u003e\n\u003cdiv style=\"text-align:justify;\"\u003eChương 2- Các biểu mẫu về Hợp đồng lao động\u003c/div\u003e\n\u003cdiv style=\"text-align:justify;\"\u003eChương 3- Các biểu mẫu về Đào tạo nghề\u003c/div\u003e\n\u003cdiv style=\"text-align:justify;\"\u003eChương 4- Các biểu mẫu về Đối thoại tại nơi làm việc\u003c/div\u003e\n\u003cdiv style=\"text-align:justify;\"\u003eChương 5- Các biểu mẫu về Tiền lương\u003c/div\u003e\n\u003cdiv style=\"text-align:justify;\"\u003eChương 6- Các biểu mẫu về Thời giờ làm việc và thời giờ nghỉ ngơi\u003c/div\u003e\n\u003cdiv style=\"text-align:justify;\"\u003eChương 7- Các biểu mẫu về Nội quy lao động và kỷ luật lao động\u003c/div\u003e\n\u003cdiv style=\"text-align:justify;\"\u003eChương 8- Các biểu mẫu về An toàn lao động và vệ sinh lao động\u003c/div\u003e\n\u003cdiv style=\"text-align:justify;\"\u003eChương 9- Các biểu mẫu về Nhóm lao động đặc thù\u003c/div\u003e\n\u003cdiv style=\"text-align:justify;\"\u003eChương 10 – Các biểu mẫu về Thành lập công đoàn cơ sở\u003c/div\u003e\n\u003cdiv style=\"text-align:justify;\"\u003eChương 11 – Các biểu mẫu về Tranh chấp lao động và đình công\u003c/div\u003e\n\u003cdiv style=\"text-align:justify;\"\u003e—–\u003c/div\u003e\n\u003cdiv style=\"text-align:justify;\"\u003eLý do bạn nên sở hữu quyển sổ tay này\u003c/div\u003e\n\u003cdiv style=\"text-align:justify;\"\u003eQuyển sách Các biểu mẫu nhân sự khó tìm liên quan đến Pháp luật Lao động giúp người làm công tác nhân sự giảm thiểu được thời gian tra cứu và soạn thảo các biểu mẫu pháp luật lao động cũng như vận dụng các quy định của pháp luật liên quan đúng và nhanh chóng.\u003c/div\u003e\n\u003cdiv style=\"text-align:justify;\"\u003eCác biểu mẫu không chỉ giúp cho độc giả các sườn tài liệu, mà tùy theo từng tình huống phát sinh cụ thể của từng vụ việc tại từng thời điểm khác nhau trong doanh nghiệp và trong các mối quan hệ lao động mà độc giả sẽ có những điều chỉnh, bổ sung phù hợp cho doanh nghiệp của mình.\u003c/div\u003e\n\u003cdiv style=\"text-align:justify;\"\u003eTiết kiệm thời gian, công sức và tiền bạc cho độc giả trong quá trình tìm kiếm và lựa chọn từ các nguồn tư vấn pháp lý vô cùng đa dạng và phức tạp.\u003c/div\u003e\n\u003cdiv style=\"text-align:justify;\"\u003eThống kê đầy đủ các biểu mẫu nhân sự quan trọng và cần thiết mà được trình bày dưới dạng song ngữ Việt Anh liên quan đến các vấn đề thường phát sinh trong mối quan hệ lao động giữa doanh nghiệp và người lao động.\u003c/div\u003e\n\u003cdiv style=\"text-align:justify;\"\u003e \u003c/div\u003e\n\u003cdiv style=\"text-align:justify;\"\u003e xin trân trọng giới thiệu đến bạn đọc!\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/57/95/09/9b482d92bd4e451b1fc528d81e91901d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/57/95/09/9b482d92bd4e451b1fc528d81e91901d.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/produ