00x280/ts/product/7d/cd/3b/0d679ff307aa61d04bfcc1f6c60b149d.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/ad/5e/de/632a117f27c20ee1d633a91014993c06.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ad/5e/de/632a117f27c20ee1d633a91014993c06.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ad/5e/de/632a117f27c20ee1d633a91014993c06.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ad/5e/de/632a117f27c20ee1d633a91014993c06.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ad/5e/de/632a117f27c20ee1d633a91014993c06.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/a7/4e/b7/9e4c8b31f2a80ca3e35fee1f31ad04ca.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a7/4e/b7/9e4c8b31f2a80ca3e35fee1f31ad04ca.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a7/4e/b7/9e4c8b31f2a80ca3e35fee1f31ad04ca.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a7/4e/b7/9e4c8b31f2a80ca3e35fee1f31ad04ca.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a7/4e/b7/9e4c8b31f2a80ca3e35fee1f31ad04ca.jpg"}],"warranty_policy":null,"brand":{"id":862381,"name":"Ohla","slug":"ohla"},"current_seller":{"id":52943,"sku":"4093528075055","name":"Ohla","link":"https://tiki.vn/cua-hang/ohla","logo":"96/03/c9/55e1107e3588833e1784f66ca021eff2.jpg","price":53000,"product_id":"96815813","store_id":50382,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Content","attributes":[{"code":"brand","name":"Thương hiệu","value":"Ohla"},{"code":"brand_country","name":"Xuất xứ thương hiệu","value":"Việt Nam"},{"code":"expiry_time","name":"Hạn sử dụng","value":"1 năm"},{"code":"huong_dan_bao_quan","name":"Hướng dẫn bảo quản","value":"\u003cul\u003e\n\u003cli\u003e\u003cspan style=\"font-size: 10pt; font-family: Arial; font-style: normal;\" data-sheets-value=\"{\u0026quot;1\u0026quot;:2,\u0026quot;2\u0026quot;:\u0026quot;Từ lâu, những quả dâu tây đỏ mọng nước đã nổi tiếng là nguồn cung cấp vitamin C dồi dào cho cơ thể, nhưng ít người biết tới loại quả này còn rất giàu các chất chống oxy hóa có lợi. Việc ăn dâu tây mỗi ngày giúp ngăn ngừa lão hóa, tăng cường hệ miễn dịch, giảm chứng viêm khớp, phòng ngừa tiểu đường cũng như sự hình thành và lan rộng của các khối u. Đặc biệt, dâu tây còn giúp cơ thể sản sinh các hormore hạnh phúc (dopamine, serotonin) không chỉ chữa chứng trầm cảm còn giúp thúc đẩy máu mang dưỡng chất tới não.\\n\\nHiểu được được tầm quan trọng của dâu tây đối với sức khỏe, Ohla đã sử dụng dây chuyền sản xuất hiện đại của mình để mang đến những quả dâu cô đặc đầy dinh dưỡng trong món Dâu Sấy Dẻo nổi tiếng của mình.\\n\\nĐược sấy bằng công nghệ cao trong dây chuyền khép kín, Dâu sấy dẻo Ohla không chỉ giữ được hàm lượng dinh dưỡng của trái cây tươi, mà còn làm giảm độ chua giúp tăng vị ngọt dịu cho những quả dâu thêm phần thơm ngon. Chính vì vậy, món ăn vặt dinh dưỡng này sẽ là lựa chọn phù hợp cho tất cả các đối tượng từ trẻ em, người lớn cho tới các mẹ bầu. Ngoài ra, sản phẩm được đóng gói nhỏ gọn, đẹp mắt phù hợp cho việc đãi khách, mang theo tới văn phòng, hay những chuyến du lịch xa.\\n\\nKhối lượng tịnh: 30gram\\nĐóng gói: Túi zip\\n\\nĐẶC ĐIỂM NỔI BẬT\\n- Nguyên liệu chính: dâu tây tươi.\\n- Sản phẩm được sơ chế và sấy bằng công nghệ hiện đại, khép kín, đảm bảo đạt chuẩn an toàn vệ sinh thực phẩm.\\n- Là một sản phẩm cô đặc của trái cây tươi, vẫn giữ được hương vị thơm ngon, màu sắc không khô cứng.\\n- Sản phẩm không qua chiên dầu nên không bị hiện tượng thấm dầu và hôi dầu.\\n- Sản phẩm vẫn giữ được các yếu tố như màu sắc, thành phần dinh dưỡng, vitamin và đặc tính đặc trưng riêng của từng loại trái cây.\\n- Bảo quản được lâu hơn so với trái cây tươi và là bữa ăn nhẹ tiện dụng cho những chuyến đi chơi dài.\\n\\nTHÔNG TIN DINH DƯỠNG\\n- Trong 100g dâu tây chứa 8g lượng chất xơ cần thiết để hỗ trợ điều hòa nhu động ruột.\\n- Trong một chén chén dâu tây chứa 51,5mg vitamin C, hàm lượng này đáp ứng 50% nhu cầu hàng ngày của cơ thể\\n- Ngoài vitamin C, các nhà khoa học còn phát hiện trong dâu tây chứa thành phần axit ellagic, lutein và zeathacins có khả năng ngừa ung thư ca..\\n\\nHƯỚNG DẪN BẢO QUẢN\\n- Đóng kín bao bì để giữ khô ráo sản phẩm sau khi sử dụng.\\n- Bảo quản nơi thoáng mát, tránh ánh nắng trực tiếp.\\n- Bảo quản được lâu hơn so với trái cây tươi và là bữa ăn nhẹ tiện dụng cho những chuyến đi chơi dài.\\n\\nOHLA CAM KẾT\\n- Toàn bộ sản phẩm đều có Giấy chứng nhận VSATTP.\\n- Đội ngũ Ohla kiểm tra kĩ sản phẩm trước khi đóng gói.\\n- Chính sách trả hàng/hoàn tiền trong vòng 07 ngày theo quy định của Shopee trong trường hợp sản phẩm bị lỗi do nhà sản xuất.\\n- Tư vấn và phản hồi tin nhắn khách hàng sớm nhất có thể.\\n\\nCảm ơn bạn đã tin tưởng và sử dụng sản phẩm của Ohla. Mọi thắc mắc và cần tư vấn vui lòng liên hệ trực tiếp với đội ngũ Ohla qua hộp tin nhắn!\u0026quot;}\" data-sheets-userformat=\"{\u0026quot;2\u0026quot;:9151,\u0026quot;3\u0026quot;:{\u0026quot;1\u0026quot;:0},\u0026quot;4\u0026quot;:{\u0026quot;1\u0026quot;:2,\u0026quot;2\u0026quot;:16777215},\u0026quot;5\u0026quot;:{\u0026quot;1\u0026quot;:[{\u0026quot;1\u0026quot;:2,\u0026quot;2\u0026quot;:0,\u0026quot;5\u0026quot;:{\u0026quot;1\u0026quot;:2,\u0026quot;2\u0026quot;:0}},{\u0026quot;1\u0026quot;:0,\u0026quot;2\u0026quot;:0,\u0026quot;3\u0026quot;:1},{\u0026quot;1\u0026quot;:1,\u0026quot;2\u0026quot;:0,\u0026quot;4\u0026quot;:1}]},\u0026quot;6\u0026quot;:{\u0026quot;1\u0026quot;:[{\u0026quot;1\u0026quot;:2,\u0026quot;2\u0026quot;:0,\u0026quot;5\u0026quot;:{\u0026quot;1\u0026quot;:2,\u0026quot;2\u0026quot;:0}},{\u0026quot;1\u0026quot;:0,\u0026quot;2\u0026quot;:0,\u0026quot;3\u0026quot;:1},{\u0026quot;1\u0026quot;:1,\u0026quot;2\u0026quot;:0,\u0026quot;4\u0026quot;:1}]},\u0026quot;7\u0026quot;:{\u0026quot;1\u0026quot;:[{\u0026quot;1\u0026quot;:2,\u0026quot;2\u0026quot;:0,\u0026quot;5\u0026quot;:{\u0026quot;1\u0026quot;:2,\u0026quot;2\u0026quot;:0}},{\u0026quot;1\u0026quot;:0,\u0026quot;2\u0026quot;:0,\u0026quot;3\u0026quot;:1},{\u0026quot;1\u0026quot;:1,\u0026quot;2\u0026quot;:0,\u0026quot;4\u0026quot;:1}]},\u0026quot;8\u0026quot;:{\u0026quot;1\u0026quot;:[{\u0026quot;1\u0026quot;:2,\u0026quot;2\u0026quot;:0,\u0026quot;5\u0026quot;:{\u0026quot;1\u0026quot;:2,\u0026quot;2\u0026quot;:0}},{\u0026quot;1\u0026quot;:0,\u0026quot;2\u0026quot;:0,\u0026quot;3\u0026quot;:1},{\u0026quot;1\u0026quot;:1,\u0026quot;2\u0026quot;:0,\u0026quot;4\u0026quot;:1}]},\u0026quot;10\u0026quot;:0,\u0026quot;11\u0026quot;:4,\u0026quot;12\u0026quot;:0,\u0026quot;16\u0026quot;:10}\"\u003eĐóng kín bao bì để giữ khô ráo sản phẩm sau khi sử dụng.\u003c/span\u003e\u003c/li\u003e\n\u003cli\u003e\u003cspan style=\"font-size: 10pt; font-family: Arial; font-style: normal;\" data-sheets-value=\"{\u0026quot;1\u0026quot;:2,\u0026quot;2\u0026quot;:\u0026quot;Từ lâu, những quả dâu tây đỏ mọng nước đã nổi tiếng là nguồn cung cấp vitamin C dồi dào cho cơ thể, nhưng ít người biết tới loại quả này còn rất giàu các chất chống oxy hóa có lợi. Việc ăn dâu tây mỗi ngày giúp ngăn ngừa lão hóa, tăng cường hệ miễn dịch, giảm chứng viêm khớp, phòng ngừa tiểu đường cũng như sự hình thành và lan rộng của các khối u. Đặc biệt, dâu tây còn giúp cơ thể sản sinh các hormore hạnh phúc (dopamine, serotonin) không chỉ chữa chứng trầm cảm còn giúp thúc đẩy máu mang dưỡng chất tới não.\\n\\nHiểu được được tầm quan trọng của dâu tây đối với sức khỏe, Ohla đã sử dụng dây chuyền sản xuất hiện đại của mình để mang đến những quả dâu cô đặc đầy dinh dưỡng trong món Dâu Sấy Dẻo nổi tiếng của mình.\\n\\nĐược sấy bằng công nghệ cao trong dây chuyền khép kín, Dâu sấy dẻo Ohla không chỉ giữ được hàm lượng dinh dưỡng của trái cây tươi, mà còn làm giảm độ chua giúp tăng vị ngọt dịu cho những quả dâu thêm phần thơm ngon. Chính vì vậy, món ăn vặt dinh dưỡng này sẽ là lựa chọn phù hợp cho tất cả các đối tượng từ trẻ em, người lớn cho tới các mẹ bầu. Ngoài ra, sản phẩm được đóng gói nhỏ gọn, đẹp mắt phù hợp cho việc đãi khách, mang theo tới văn phòng, hay những chuyến du lịch xa.\\n\\nKhối lượng tịnh: 30gram\\nĐóng gói: Túi zip\\n\\nĐẶC ĐIỂM NỔI BẬT\\n- Nguyên liệu chính: dâu tây tươi.\\n- Sản phẩm được sơ chế và sấy bằng công nghệ hiện đại, khép kín, đảm bảo đạt chuẩn an toàn vệ sinh thực phẩm.\\n- Là một sản phẩm cô đặc của trái cây tươi, vẫn giữ được hương vị thơm ngon, màu sắc không khô cứng.\\n- Sản phẩm không qua chiên dầu nên không bị hiện tượng thấm dầu và hôi dầu.\\n- Sản phẩm vẫn giữ được các yếu tố như màu sắc, thành phần dinh dưỡng, vitamin và đặc tính đặc trưng riêng của từng loại trái cây.\\n- Bảo quản được lâu hơn so với trái cây tươi và là bữa ăn nhẹ tiện dụng cho những chuyến đi chơi dài.\\n\\nTHÔNG TIN DINH DƯỠNG\\n- Trong 100g dâu tây chứa 8g lượng chất xơ cần thiết để hỗ trợ điều hòa nhu động ruột.\\n- Trong một chén chén dâu tây chứa 51,5mg vitamin C, hàm lượng này đáp ứng 50% nhu cầu hàng ngày của cơ thể\\n- Ngoài vitamin C, các nhà khoa học còn phát hiện trong dâu tây chứa thành phần axit ellagic, lutein và zeathacins có khả năng ngừa ung thư ca..\\n\\nHƯỚNG DẪN BẢO QUẢN\\n- Đóng kín bao bì để giữ khô ráo sản phẩm sau khi sử dụng.\\n- Bảo quản nơi thoáng mát, tránh ánh nắng trực tiếp.\\n- Bảo quản được lâu hơn so với trái cây tươi và là bữa ăn nhẹ tiện dụng cho những chuyến đi chơi dài.\\n\\nOHLA CAM KẾT\\n- Toàn bộ sản phẩm đều có Giấy chứng nhận VSATTP.\\n- Đội ngũ Ohla kiểm tra kĩ sản phẩm trước khi đóng gói.\\n- Chính sách trả hàng/hoàn tiền trong vòng 07 ngày theo quy định của Shopee trong trường hợp sản phẩm bị lỗi do nhà sản xuất.\\n- Tư vấn và phản hồi tin nhắn khách hàng sớm nhất có thể.\\n\\nCảm ơn bạn đã tin tưởng và sử dụng sản phẩm của Ohla. Mọi thắc mắc và cần tư vấn vui lòng liên hệ trực tiếp với đội ngũ Ohla qua hộp tin nhắn!\u0026quot;}\" data-sheets-userformat=\"{\u0026quot;2\u0026quot;:9151,\u0026quot;3\u0026quot;:{\u0026quot;1\u0026quot;:0},\u0026quot;4\u0026quot;:{\u0026quot;1\u0026quot;:2,\u0026quot;2\u0026quot;:16777215},\u0026quot;5\u0026quot;:{\u0026quot;1\u0026quot;:[{\u0026quot;1\u0026quot;:2,\u0026quot;2\u0026quot;:0,\u0026quot;5\u0026quot;:{\u0026quot;1\u0026quot;:2,\u0026quot;2\u0026quot;:0}},{\u0026quot;1\u0026quot;:0,\u0026quot;2\u0026quot;:0,\u0026quot;3\u0026quot;:1},{\u0026quot;1\u0026quot;:1,\u0026quot;2\u0026quot;:0,\u0026quot;4\u0026quot;:1}]},\u0026quot;6\u0026quot;:{\u0026quot;1\u0026quot;:[{\u0026quot;1\u0026quot;:2,\u0026quot;2\u0026quot;:0,\u0026quot;5\u0026quot;:{\u0026quot;1\u0026quot;:2,\u0026quot;2\u0026quot;:0}},{\u0026quot;1\u0026quot;:0,\u0026quot;2\u0026quot;:0,\u0026quot;3\u0026quot;:1},{\u0026quot;1\u0026quot;:1,\u0026quot;2\u0026quot;:0,\u0026quot;4\u0026quot;:1}]},\u0026quot;7\u0026quot;:{\u0026quot;1\u0026quot;:[{\u0026quot;1\u0026quot;:2,\u0026quot;2\u0026quot;:0,\u0026quot;5\u0026quot;:{\u0026quot;1\u0026quot;:2,\u0026quot;2\u0026quot;:0}},{\u0026quot;1\u0026quot;:0,\u0026quot;2\u0026quot;:0,\u0026quot;3\u0026quot;:1},{\u0026quot;1\u0026quot;:1,\u0026quot;2\u0026quot;:0,\u0026quot;4\u0026quot;:1}]},\u0026quot;8\u0026quot;:{\u0026quot;1\u0026quot;:[{\u0026quot;1\u0026quot;:2,\u0026quot;2\u0026quot;:0,\u0026quot;5\u0026quot;:{\u0026quot;1\u0026quot;:2,\u0026quot;2\u0026quot;:0}},{\u0026quot;1\u0026quot;:0,\u0026quot;2\u0026quot;:0,\u0026quot;3\u0026quot;:1},{\u0026quot;1\u0026quot;:1,\u0026quot;2\u0026quot;:0,\u0026quot;4\u0026quot;:1}]},\u0026quot;10\u0026quot;:0,\u0026quot;11\u0026quot;:4,\u0026quot;12\u0026quot;:0,\u0026quot;16\u0026quot;:10}\"\u003eBảo quản nơi tho