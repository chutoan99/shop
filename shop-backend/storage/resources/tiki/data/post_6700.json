null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":3.5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/cc/9d/32/f7b8c0d71d1f156677c48468597a429c.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1628,"all_time_quantity_sold":4,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eTấm lọc Nano bạc tích hợp than hoạt tính được gắn vào phía sau quạt điều hòa không khí Rapido 9000D/9000M, Fresh 9000M/9000D, Lucky 9000D/9000M hoặc Everest 9000D/9000M giúp lọc sạch các tác nhân gây bệnh như bụi mịn, nấm mốc,… giúp không khí trong sạch hơn. Ngoài ra việc này còn giúp bảo vệ các thiết bị bên trong chống lại sự xâm nhập trực tiếp của bụi bẩn, nấm mốc, hỗ trợ tăng tuổi thọ của máy.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTấm lọc không khí cho hiệu quả làm sạch tối đa\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eThêm một tiện ích đặc biệt mới được bổ sung vào quạt điều hòa không khí Rapido  để biến nó trở thành một thiết bị lọc không khí hoàn hảo đó là hệ thống tấm lọc lắp thêm phía sau quạt. Đây là hệt thống tấm lọc tích hợp gồm lớp lọc than hoạt tính và lớp lọc Nano bạc.\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"aligncenter wp-image-2036 lazy-load-active\" style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://rapido.vn/wp-content/uploads/2019/05/tam-loc-da-cap-do.jpg\" alt=\"\" width=\"676\" height=\"241\" data-src=\"https://rapido.vn/wp-content/uploads/2019/05/tam-loc-da-cap-do.jpg\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cstrong\u003eTấm lọc than hoạt tính khử mùi, lọc bụi, khử độc\u003c/strong\u003e\u003c/em\u003e\u003cimg class=\"aligncenter wp-image-2037 lazy-load-active\" style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://rapido.vn/wp-content/uploads/2019/05/tam-loc-than-hoat-tinh.jpg\" alt=\"\" width=\"500\" height=\"228\" data-src=\"https://rapido.vn/wp-content/uploads/2019/05/tam-loc-than-hoat-tinh.jpg\" /\u003e\u003c/p\u003e\n\u003cp\u003eLọc than hoạt tính là tập hợp của những lỗ nhỏ liti được lấp đầy bằng các hạt than hoạt tính gáo dừa – một loại than hoạt tính tốt nhất hiện nay. Với thiết kế đặc biệt này tấm lọc than hoạt tính của Rapido có bề mặt hấp thụ vô cùng lớn, giúp chúng có thể dễ dàng tiếp xúc và khử mùi hôi, khó độc và các phân tử hữu cơ độc hại như Formaldehyl, benzen,…\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cstrong\u003eTấm lọc Nano diệt tới 99.98% vi khuẩn nấm mốc.\u003c/strong\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"aligncenter wp-image-2038 lazy-load-active\" style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://rapido.vn/wp-content/uploads/2019/05/tam-loc-nano-bac.jpg\" alt=\"\" width=\"500\" height=\"232\" data-src=\"https://rapido.vn/wp-content/uploads/2019/05/tam-loc-nano-bac.jpg\" /\u003e\u003c/p\u003e\n\u003cp\u003eMàng lọc được tráng các hạt nano bạc hình cầu đường kính nhỏ hơn 20nm, có tác dụng lọc bụi, diệt nấm mốc, diệt khuẩn thậm chí diệt được cả các vi khuẩn kháng thuốc. Các ion bạc này sẽ tấn công vào tế bào của sinh vật gây hại ngăn cản sự sinh sôi và tiêu diệt chúng. Đây là sản phẩm an toàn và thân thiện với môi trường với tỉ lệ kháng khuẩn lên tới 99.98%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eLưu ý:\u003c/strong\u003e Sản phẩm này chỉ phù hợp với quạt điều hòa Rapido Turbo 9000M/6000D - Fresh 9000M/6000D- Lucky 9000D/9000M hoặc Everest9000D/9000M\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/cc/9d/32/f7b8c0d71d1f156677c48468597a429c.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/cc/9d/32/f7b8c0d71d1f156677c48468597a429c.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/cc/9d/32/f7b8c0d71d1f156677c48468597a429c.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/cc/9d/32/f7b8c0d71d1f156677c48468597a429c.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/cc/9d/32/f7b8c0d71d1f156677c48468597a429c.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/61/13/87/c236cd2a1e35ac4ff633e24a01879b88.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/61/13/87/c236cd2a1e35ac4ff633e24a01879b88.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/61/13/87/c236cd2a1e35ac4ff633e24a01879b88.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/61/13/87/c236cd2a1e35ac4ff633e24a01879b88.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/61/13/87/c236cd2a1e35ac4ff633e24a01879b88.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/78/b7/dd/8ef32cb4e67b791034d92d3c3daed030.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/78/b7/dd/8ef32cb4e67b791034d92d3c3daed030.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/78/b7/dd/8ef32cb4e67b791034d92d3c3daed030.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/78/b7/dd/8ef32cb4e67b791034d92d3c3daed030.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x2