"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.5,"review_count":19,"review_text":"(19)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/23/8c/94/1fe3cf4aec3facafdeccc7718c2b4d72.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1,"all_time_quantity_sold":71,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eBỘ ĐIỀU KHIỂN HUNONIC IR SMART – ĐIỀU KHIỂN TOÀN BỘ THIẾT BỊ HỒNG NGOẠI TRONG NHÀ CHỈ BẰNG MỘT CHIẾC ĐIỆN THOẠI.\u003c/p\u003e\n\u003cp\u003e\u0026#43; Bạn có thấy phiền khi đi kèm với mỗi cái Tivi, máy lạnh là một cái remote?\u003c/p\u003e\n\u003cp\u003e\u0026#43; Bạn có khó chịu mỗi khi phải đi tìm remote, hoặc ức chế hơn là đang cần thì remote lại hết pin?\u003c/p\u003e\n\u003cp\u003e Thứ bạn cần là một bộ điều khiển hồng ngoại Hunonic IR Smart.\u003c/p\u003e\n\u003cp\u003e Sản phẩm có chức năng như một remote điều khiển hàng loạt các thiết bị từ xa qua điện thoại.\u003c/p\u003e\n\u003cp\u003e Thay vì 10 cái remote bạn chỉ cần một chiếc điện thoại là đủ. Đây là giải pháp thông minh giúp cho cuộc sống của bạn trở nên đơn giản và tiện lợi hơn\u003c/p\u003e\n\u003cp\u003e️ Tính năng sản phẩm:\u003c/p\u003e\n\u003cp\u003e \u0026#43; Hunonic Ir Smart sử dụng cơ chế điều khiển bằng hồng ngoại.\u003c/p\u003e\n\u003cp\u003e \u0026#43; Chỉ cần điện thoại của bạn có kết nối Internet, bạn có thể điều khiển được toàn bộ thiết bị hồng ngoại trong nhà như: Tivi, máy lạnh, điều hoà, quạt, đầu kỹ thuật số,…\u003c/p\u003e\n\u003cp\u003e \u0026#43; Bạn cũng có thể điều chỉnh nhiệt độ, chế độ của điều hoà, bật/tắt tivi, chuyển kênh, tăng giảm âm lượng…dù bạn ở bất kỳ nơi đâu\u003c/p\u003e\n\u003cp\u003e \u0026#43; Hẹn giờ tự động ️ cho phép bạn lên lịch bật/ tắt các thiết bị theo nhu cầu , thói quen sinh hoạt của gia đình. Hoặc hẹn giờ để tắt thiết bị sau một khoảng thời gian hoạt động nhất định giiúp tiết kiệm điện năng, bảo vệ sức khoẻ.\u003c/p\u003e\n\u003cp\u003e \u0026#43; Điều khiển giọng nói nhờ hỗ trợ của Alexa, Google Assistant.\u003c/p\u003e\n\u003cp\u003e \u0026#43; Hunonic IR Smart cho phép nhiều thiết bị thông minh bật tắt cùng lúc. Ví dụ như đèn, nóng lạnh, tivi,… kết hợp bật/tắt cùng lúc qua điện thoại mà không gặp trở ngại gì.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"//\" /\u003e\u003c/p\u003e\n\u003cp\u003e️ Ưu điểm:\u003c/p\u003e\n\u003cp\u003e \u0026#43; Khả năng phản hồi nhanh, chính xác với góc phát 360º. ️ Hunonic IR Smart có 6 mặt hồng ngoại xếp thành hình lục giác, hướng hồng ngoại đa chiều, đảm bảo lệnh phát đi được thiết bị tiếp nhận nhanh, chính xác, phản hồi ngay tức thì.\u003c/p\u003e\n\u003cp\u003e \u0026#43; Khả năng học lệnh từ nhiều remote, tương thích tất cả các thiết bị hồng ngoại trên thị trường. ️ Bạn chỉ cần một chiếc điện thoại là có thể điều khiển được tất cả các thiết bị hồng ngoại trong nhà.\u003c/p\u003e\n\u003cp\u003e \u0026#43; Hỗ trợ hơn 80 thiết bị, có thể học và ghi nhớ lên đến 1000 lệnh từ nhiều remote của nhiều thiết bị khác nhau.\u003c/p\u003e\n\u003cp\u003e\u0026#43; Kích thước nhỏ gọn, thiết kế hợp xu hướng. ️ Bạn có thể đặt bộ điều khiển hồng ngoại ở bất kỳ nơi đâu trong ngôi nhà của mình, thậm chí là dán chúng dưới mặt bàn. Sản phẩm này giúp nâng cao đời sống và rất phù hợp với cuộc sống hiện đại ngày nay mà mọi gia đình cần có.\u003c/p\u003e\n\u003c