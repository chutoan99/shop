).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/69/89/27/5f464d057b60bea870eafaa9fc867f95.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/69/89/27/5f464d057b60bea870eafaa9fc867f95.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/69/89/27/5f464d057b60bea870eafaa9fc867f95.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/69/89/27/5f464d057b60bea870eafaa9fc867f95.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/69/89/27/5f464d057b60bea870eafaa9fc867f95.jpg"}],"warranty_policy":null,"authors":[{"id":167343,"name":"Raymond Chandler","slug":"raymond-chandler"}],"current_seller":{"id":116426,"sku":"8493124750050","name":"Phúc Minh Books","link":"https://tiki.vn/cua-hang/phuc-minh-books","logo":"4a/f0/69/3d0d671d31eb21c593f25d165e623c93.png","price":28710,"product_id":"52155963","store_id":107665,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Thông tin chung","attributes":[{"code":"publisher_vn","name":"Công ty phát hành","value":"Phúc Minh Books"},{"code":"publication_date","name":"Ngày xuất bản","value":"2018-08-22 00:00:00"},{"code":"dimensions","name":"Kích thước","value":"\u003cp\u003e14.5 x 20.5 cm\u003c/p\u003e"},{"code":"book_cover","name":"Loại bìa","value":"Bìa mềm"},{"code":"number_of_page","name":"Số trang","value":"376"},{"code":"manufacturer","name":"Nhà xuất bản","value":"Nhà Xuất Bản Văn Học"}]}],"product_links":[],"gift_item_title":"0 quà tặng kèm","highlight":{"items":["Cốt truyện gây hứng thú và bất ngờ, đầy tình tiết ly kỳ.","Mô tả chân thực về không gian và thời gian Los Angeles.","Ngôn ngữ sắc sảo, tạo nên sự hấp dẫn và cuốn hút."],"title":"Đặc điểm nổi bật"},"services_and_promotions":[],"promitions":[],"stock_item":{"max_sale_qty":1000,"min_sale_qty":1,"preorder_date":null,"qty":1000},"quantity_sold":{"text":"Đã bán 782","value":782},"ca