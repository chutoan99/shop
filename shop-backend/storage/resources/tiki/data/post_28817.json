g_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/af/58/44/62ccbd4bb0a31209d7105d5aa48574d4.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1622,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003e\u003ciframe src=\"//www.youtube.com/embed/jnsLi2UO3m4\" width=\"560\" height=\"314\" allowfullscreen=\"allowfullscreen\"\u003e\u003c/iframe\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTHIẾT KẾ DÀNH RIÊNG CHO KHÔNG GIAN CỦA BẠN\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eMáy in HP có thiết kế với lớp vỏ màu trắng cùng logo HP nổi bật phía trước, kích thước nhỏ gọn và trọng lượng nhẹ chỉ hơn 3KG phù hợp sử dụng ở gia đình hoặc văn phòng vừa và nhỏ\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/af/58/44/a743206ef9d76d57e90804eb7c303e6e.jpg\" alt=\"\" width=\"600\" height=\"600\" /\u003e\u003c/p\u003e\n\u003cp\u003e Với thiết kế nhỏ gọn và nhẹ nhàng, chiếc máy in phù hợp đặt ở mọi ngóc ngách trong gia đình cũng như văn phòng của bạn mà không tốt diện tích lớn hoặc không gian rộng.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eMÁY IN NHỎ - CÔNG NĂNG CỰC TO\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eVới công nghê số 1 thế giới về in ấn HP đã tích hợp rất nhiều sự hiện đại và cải tiến vượt bậc lên chiếc máy in này khi nó có thể in được 20 trang/ phút kèm với công suất in khủng lên đến 10,000 trang/ tháng cho bạn in ấn thoải mái, giải quyết công việc nhanh chóng và gọn lẹ.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/55/47/a0/b130392921e0a2b5f39729ce16ece8dd.jpg\" alt=\"\" width=\"600\" height=\"600\" /\u003e\u003c/p\u003e\n\u003cp\u003eMáy trang bị công nghệ in WIFI giúp bạn thoải mái in ấn di động bằng những thiết bị di động của mình dễ dàng và cực kỳ linh hoạt.\u003c/p\u003e\n\u003cp\u003eNơi đặt khay mực được cải tiến giúp bạn dễ dàng thay mực cho máy khi hết mực\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCHẤT L\u003c/strong\u003e\u003cstrong\u003eƯ\u003c/strong\u003e\u003cstrong\u003eỢNG TUYỆT VỜI\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eĐộ phân giải của máy có thể lên đến tối đa 1200X1200 dpi cho bản in trắng – đen cực kỳ sắc nét, vượt trội hơn hẳn so với những máy in cùng phân khúc và thậm chí có thể vượt ngoài sự mong đợi của người tiêu dùng\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/df/f3/99/fb541abd82d429ce6fa6a00d23fcc955.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eĐặc biệt khi kết hơp cùng mực in chính hãng HP 107A sẽ giúp bạn cho ra những bản in tuyệt vời và hơn thế nữa là một tuổi thọ sử dụng máy cực kỳ cao\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eKẾT NỐI DỄ DÀNG – KHAY GIẤY LỚN\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eĐược trang bị cổng kết nối USB 2.0 và cả kết nối Wifi tạo điều kiện dễ dàng cho bạn kết nối vào bất kỳ thiết bị nào tương thích.\u003c/p\u003e\n\u003cp\u003eKhay giấy vào 150 trang ra 100 trang tạo điều kiện thuận lợi cho công cuộc in ấn của bạn không bị gián đoạn\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/47/e6/13/792566830c7a60b0ac2b6f8e6e2f0d7b.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eVới các tính năng trên - Chiếc máy in 107W mang đến cho bạn một công năng tuyệt vời trong một mức giá rất hợp lý mà bạn khó có thể tìm kiếm một mẫu mã tương tự. \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/f1/eb/03/9c0322f8d18f64cc1539217171218610.JPG\" alt=\"\" width=\"750\" height=\"371\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003ciframe src=\"//www.youtube.com/embed/7uYz0cKymj0\" width=\"560\" height=\"314\" allowfullscreen=\"allowfullscreen\"\u003e\u003c/iframe\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/af/58/44/62ccbd4bb0a31209d7105d5aa48574d4.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/af/58/44/62ccbd4bb0a31209d7105d5aa48574d4.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/af/58/44/62ccbd4bb0a31209d7105d5aa48574d4.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/af/58/44/62ccbd4bb0a31209d7105d5aa48574d4.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/af/58/44/62ccbd4bb0a31209d7105d5aa48574d4.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/46/3f/0b/78f3b3ed3df934f78eb71b3af85d5919.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/46/3f/0b/78f3b3ed3df934f78eb71b3af85d5919.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/46/3f/0b/78f3b3ed3df934f78eb71b3af85d5919.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/46/3f/0b/78f3b3ed3df934f78eb71b3af85d5919.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/46/3f/0b/78f3b3ed3df934f78eb71b3af85d5919.png"},{"base_url":"https://salt.tikicdn.com/ts/product/55/47/a0/467c8e6739732e6592ff6c0ad34f3900.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/55/47/a0/467c8e6739732e6592ff6c0ad34f3900.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/55/47/a0/467c8e6739732e6592ff6c0ad34f3900.jpg","position":null,"s