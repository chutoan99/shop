idth":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":291000,"discount_rate":20,"rating_average":4.8,"review_count":39,"review_text":"(39)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/7d/ba/88/00b5f535c2b6dd84d9706b1a8de10f8f.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1037,"all_time_quantity_sold":88,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e- Tiện lợi cất giữ nhiều vật dụng của gia đình\u003c/p\u003e\n\u003cp\u003e- Kiểu dáng trang nhã, họa tiết bắt mắt\u003c/p\u003e\n\u003cp\u003e- Có khả năng chịu lực cao\u003c/p\u003e\n\u003cp\u003e- Đảm bảo an toàn cho sức khỏe\u003c/p\u003e\n\u003cp\u003eThiết kế tiện lợi, dễ sử dụng\u003c/p\u003e\n\u003cp\u003eTủ Tabi Duy Tân 5 Ngăn với thiết kế gọn nhẹ và chắc chắn, bạn có thể tháo lắp các ngăn kéo dễ dàng để sử dụng hoặc di chuyển tủ sang vị trí mong muốn mà không tốn quá nhiều sức như các tủ thông thường khác.\u003c/p\u003e\n\u003cp\u003eTủ có 5 tầng và tầng trên cùng được chia làm 2 ngăn kéo nhỏ có khóa, tiện lợi để bạn lưu trữ hồ sơ, giấy tờ quan trọng hoặc sắp xếp quần áo, vật dụng cho các thành viên trong gia đình một cách gọn gàng, ngăn nắp.\u003c/p\u003e\n\u003cp\u003eNgăn kéo được thiết kế rộng rãi để bạn có thể đựng chăn và các đồ dùng của bé, đặc biệt phù hợp với các gia đình có trẻ nhỏ.\u003c/p\u003e\n\u003cp\u003eChất liệu an toàn, bền bỉ\u003c/p\u003e\n\u003cp\u003eTủ Tabi Duy Tân được làm từ nhựa PP/ABS không độc hại, không gây mùi khó chịu trong quá trình sử dụng, đảm bảo an toàn cho sức khỏe của bạn và gia đình.\u003c/p\u003e\n\u003cp\u003eChất liệu nhựa này mang đến độ bền cao và khả năng chịu lực tốt, không bị cong vênh hoặc biến dạng dưới tác động của thời tiết để bạn có thể sử dụng lâu dài, bền bỉ mà không cần đổi mới gây tốn kém.\u003c/p\u003e\n\u003cp\u003eThích hợp với mọi không gian\u003c/p\u003e\n\u003cp\u003eSản phẩm có thiết kế trang nhã, họa tiết đáng yêu cùng nhiều màu sắc để bạn lựa chọn tủ phù hợp với không gian nhà bạn.\u003c/p\u003e\n\u003cp\u003eTủ có thể đặt trong phòng khách, phòng ngủ hoặc nơi bạn mong muốn mà không tốn nhiều diện tích.\u003c/p\u003e\n\u003cp\u003eBạn có thể sử dụng tủ để lưu trữ hồ sơ, giấy tờ hoặc đựng giày dép, quần áo của bé và các vật dụng khác của thành viên trong gia đình một cách gọn gàng, gia đình bạn cũng sẽ không mất nhiều thời gian để tìm kiếm quần áo, đồ dùng khi cần thiết.\u003c/p\u003e\n\u003cp\u003eNgoài ra, tủ được thiết kế bế mặt trơn láng, hạn chế bám bẩn và bạn có thể lau chùi dễ dàng để vệ sinh sản phẩm một cách nhanh chóng, tiện lợi.\u003c/p\u003e\n\u003cp\u003eHướng dẫn sử dụng\u003c/p\u003e\n\u003cp\u003eĐọc kỹ hướng dẫn lắp ráp kèm theo trước khi lắp ráp hoặc tháo lắp khi vệ sinh tủ\u003c/p\u003e\n\u003cp\u003eChỉ nên sử dụng để đựng đồ bình thường, không sử dụng đựng hóa chất hay chất dễ cháy\u003c/p\u003e\n\u003cp\u003eKhông nên cất giữ những đồ vật quá nặng, làm giảm tuổi thọ của tủ\u003c/p\u003e\n\u003cp\u003eTránh va đập mạnh và tránh ánh nắng trực tiếp\u003c/p\u003e\n\u003cp\u003eTránh dùng những vật sắc nhọn ma sát trực tiếp vào tủ\u003c/p\u003e\n\u003cp\u003eKhi kéo ra vào bạn nên không nên giật quá mạnh tay\u003c/p\u003e\n\u003cp\u003eThường xuyên vệ sinh tủ theo định kỳ để tủ luôn mới và sạch sẽ\u003c/p\u003e\n\u003cp\u003eCách vệ sinh tủ Duy Tân để luôn luôn mới\u003c/p\u003e\n\u003cp\u003eBạn dùng kem đánh răng lấy một ít thoa nhẹ lên tủ nhựa\u003c/p\u003e\n\u003cp\u003eTiếp đến bạn dùng chiếc khăn mềm đánh bóng nhẹ chiếc tủ nhựa trong vòng 10 đến 15 phút. Sau đó bạn dùng khăn ẩm lau sạch vài lần chiếc tủ của mình bạn sẽ có một chiếc tủ sáng bóng như mới\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e\u003cp\u003eSản phẩm này là tài sản cá nhân được bán bởi Nhà Bán Hàng Cá Nhân và không thuộc đối tượng phải chịu thuế GTGT. Do đó hoá đơn VAT không được cung cấp trong trường hợp này.\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/7d/ba/88/00b5f535c2b6dd84d9706b1a8de10f8f.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/7d/ba/88/00b5f535c2b6dd84d9706b1a8de10f8f.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/7d/ba/88/00b5f535c2b6dd84d9706b1a8de10f8f.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7d/ba/88/00b5f535c2b6dd84d9706b1a8de10f8f.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7d/ba/88/00b5f535c2b6dd84d9706b1a8de10f8f.jpg"}],"warranty_policy":null,"brand":{"id":50655,"name":"Duy Tân","slug":"duy-tan"},"current_seller":{"id":238272,"sku":"4514826787971","name":"PHÚ MỸ furniture","link":"https://tiki.vn/cua-hang/phu-my-furniture","logo":"https://vcdn.tikicdn.com/ts/seller/8c/2d/df/4cec92728bbaee097f32eb34cf2ead43.jpg","price":1199000,"product_id":"275486403","store_id":225304,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Content","attributes":[{"code":"brand","name":"Thương hiệu","value":"Duy Tân"},{"code":"brand_country","name":"Xuất xứ thương hiệu","value":"Việt Nam"},{"code":"material","name":"Chất liệu","value":"Nhựa"},{"code":"origin","name":"Xuất xứ (Made in)","value":"Việt Nam"}]},{"name":"Operation","attributes":[{"code":"is_warranty_applied",