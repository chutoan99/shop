olor":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":70000,"discount_rate":29,"rating_average":5,"review_count":6,"review_text":"(6)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/5a/de/b4/5d1361c674b57b0e141491d3de08f070.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":425,"all_time_quantity_sold":54,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eSÁCH TRÒ CHUYỆN VỚI NHÀ THẦN BÍ ( MIDNIGHT WITH THE MYSTIC TÁC GIẢ ) - SÁCH TÔN GIÁO TÂM LINH, NGHỆ THUẬT SỐNG - Á CHÂU BOOKS, BÌA CỨNG IN MÀU\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eSADHGURU LÀ AI?\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/07/ea/76/872bf4b3ab3bcfeb6ef4c1ea331efa42.jpg\" alt=\"\" width=\"700\" height=\"562\" /\u003e\u003c/p\u003e\n\u003cp\u003eHành giả yogi, nhà thần bí, Sadhguru là một bậc thầy tâm linh với sự khác biệt.\u003c/p\u003e\n\u003cp\u003eLà một trong 50 người có ảnh hưởng nhất của Ấn Độ, Sadhguru đã chạm đến cuộc sống của hàng triệu người trên toàn thế giới thông qua các chương trình chuyển hoá nội tâm của ông.\u003c/p\u003e\n\u003cp\u003eSadhguru đã thành lập Quỹ Isha, một tổ chức tình nguyện phi lợi nhuận hoạt động tại hơn 300 trung tâm và được hỗ trợ bởi hơn 11 triệu tình nguyện viên trên toàn thế giới\u003c/p\u003e\n\u003cp\u003eLà người sáng lập Trung tâm Yoga Isha ở Coimbatore, Ấn Độ và Viện Khoa học Nội tâm Isha trên Cao nguyên Cumberland ở miền trung Tennessee.\u003c/p\u003e\n\u003cp\u003eSadhguru đã từng là diễn giả chính tại Đại hội đồng Liên hợp quốc và một số diễn đàn khác của Liên hợp quốc. Ông cũng thường xuyên được mời phát biểu tại các tổ chức như Diễn đàn Kinh tế Thế giới, Ngân hàng Thế giới, House of Lords, Đại học Oxford, MIT, Google và Microsoft,\u003c/p\u003e\n\u003cp\u003eSadhguru đã khởi xướng các sáng kiến ​​sinh thái quy mô lớn như Rally for Rivers và Cauvery Calling, để hồi sinh các con sông đang cạn kiệt nghiêm trọng của Ấn Độ.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCÓ GÌ ĐẶT BIỆT TRONG CUỘC TRÒ CHUYỆN VỚI NHÀ THẦN BÍ?\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/19/8b/8b/ed9a62054cb93fd0372ea7ed236d3011.jpeg\" alt=\"nhà thần bí\" width=\"750\" height=\"1000\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/4e/44/70/ebd3c9e02f687428041981c24d2e8dc4.jpeg\" alt=\"nhà thần bí\" width=\"750\" height=\"562\" /\u003e\u003c/p\u003e\n\u003cp\u003eCuốn sách dẫn dắt bạn đi từ bất ngờ này tới bất ngờ khác, khám phá những bí mật ẩn sâu những điều làm nên một nhà tâm linh huyền thoại.\u003c/p\u003e\n\u003cp\u003eTuổi thơ, gia đình và tiền kiếp của Nhà thần bí Sadhguru, bí ẩn về gia đình ông có liên quan đến sứ mệnh cuộc đời và hành trình giác ngộ mà bạn chưa từng biết đến.\u003c/p\u003e\n\u003cp\u003eKhoa học bên trong là gì? Câu trả lời sẽ được Sadhguru giải thích tường tận. Bí kíp để nắm giữ vận mệnh và làm chủ cuộc đời mà ai cũng có thể học và thực hành\u003c/p\u003e\n\u003cp\u003eSadhguru nói gì về tình yêu về hôn nhân và cuộc sống, làm thức tỉnh bạn. Điều gì làm nên con người bạn?\u003c/p\u003e\n\u003cp\u003eDyanylinga: Bí ẩn về việc tạo ra một dạng năng lượng giàu tiềm năng nhất thế giới qua nhiều kiếp và Sadhguru là người cuối cùng hoàn thành, hé lộ công việc của Sadhguru từ các kiếp trước.\u003c/p\u003e\n\u003cp\u003eYoga: Một công nghệ sử dụng năng lượng bên trong để đạt tới những khả năng cao hơn. Yoga này là gì? bạn có muốn kích hoạt năng lượng tiềm ẩn bên trong bạn?\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/b2/96/40/b66002b8ace2e09b01e3421df7d81c85.jpeg\" alt=\"\" width=\"750\" height=\"562\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/30/3f/9d/62c33a5bbb259572d53dea1c65409acc.jpeg\" alt=\"\" width=\"750\" height=\"562\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCON NGƯỜI LUÔN KHÁT KHAO VẬN HÀNH Ở ĐỈNH CAO CỦA CƠ THỂ, TÂM TRÍ VÀ NĂNG LƯỢNG\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ef/9d/d8/05a1d8e7c90313fe3a0fadfb8b60d3e3.jpeg\" alt=\"nhà thần bí\" width=\"750\" height=\"1000\" /\u003e\u003c/p\u003e\n\u003cp\u003eChúng ta không cần thêm các tín đồ Hindu, Công giáo hay Hồi giá Chung ta cần hơn đến những vị Phật, những J những bậc giác ngộ thực sự, và còn sống. Tiềm năng đó có sẵn trong tất cả mọi người, bạn đã sẵn sàng chưa?\u003c/p\u003e\n\u003cp\u003eChúng ta luôn không bao giờ biết đủ, luôn khát khao hướng đến thứ gì đó. Đó là khát khao đến cái vô hạn, cái bản chất vô cùng của chính mình.\u003c/p\u003e\n\u003cp\u003eChỉ khi hạnh phúc và chất lượng cuộc sống của bạn không phụ thuộc vào ai hay bất cứ điều gì, khi đó bạn mới được tự do.\u003c/p\u003e\n\u003cp\u003eTrò chuyện với nhà thần bí: Đừng bỏ lỡ vận may hiếm có này. Hãy ngồi xuống, thư thái, nhấc chân lên, rồi lắng nghe những lời vàng ý ngọc từ bậc thánh nhân này!\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/fc/66/69/a7006de474200777fff63da7ee8da238.jpeg\" alt=\"\" width=\"750\" height=\"562\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/51/a5/36/1cd4039cc2cd714510b2c77093f28fd9.jpeg\" alt=\"\" width=\"750\" height=\"1000\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eNHỮNG CÂU NÓI TRUYỀN CẢM HỨNG\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e“Mọi ý kiến ​​của bạn về bất cứ điều gì đều có thể là một giới hạn bản thể của bạn.”\u003c/p\u003e\n\u003cp\u003e“Cheryl, tôi muốn bạn hiểu rằng cuộc sống xung quanh bạn sẽ phản hồi và tự tạo ra để phù hợp với con người bạn chứ không phải cách bạn hay những người xung quanh bạn nghĩ về bạn. Những gì bạn nghĩ về bản thân là không liên quan tồn tại.\u003c/p\u003e\n\u003cp\u003eNếu chúng ta thay đổi ý tưởng về một cuộc sống thành công thành một cuộc sống vui vẻ, chúng ta sẽ thấy nhu cầu về tiền của mình sẽ giảm đi đáng kể.\u003c/p\u003e\n\u003cp\u003eLúc đồng nhất mình với những thứ không phải mình là lúc bạn không thể ngừng những suy nghĩ. Khi bạn trở thành một cá thể thực thụ, không còn đồng nhất mình với bất cứ thứ gì, thì định mệnh của bạn nằm trong tay bạn.\u003c/p\u003e\n\u003cp\u003eQuá khứ chỉ có thể được nhớ về. Hiện tại chỉ có thể được trải nghiệm. Còn Tương lai thì phải được tạo ra.\u003c/p\u003e\n\u003cp\u003eNếu không thực sự thẳng thắn với bản thân, bạn có thể mất cả đời để đối đầu với những thứ nhỏ nhặt gây phiền não cho bạn.\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/57/5a/dd/8f1e53b47527f7d3ae9e0e850ca71547.jpg\" alt=\"\" width=\"750\" height=\"1000\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/28/38/8a/c2ff8bf9a8e4323b5d58e2e3251e4faa.jpg\" alt=\"\" width=\"750\" height=\"562\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/61/a3/d7/9886189a3b3041ff90060b085934a44b.jpg\" alt=\"\" width=\"750\" height=\"1000\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTẠI SAO CUỐN SÁCH NÀY LẠI HẤP DẪN ĐẾN VẬY?\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eLà cuốn sách thuộc top Bestseller của Newyork Times và được đánh giá 5 sao trên Amazon.\u003c/p\u003e\n\u003cp\u003eNội dung hấp dẫn, kích thích am muốn khám phá bản thân; nhất là những bạn bạn đọc đang trên hành trình phát triển tâm linh, tìm kiếm một bậc thầy sống động.\u003c/p\u003e\n\u003cp\u003eLiệu đây có phải chỉ là cuộc trò chuyện với bậc thầy tâm linh, hay sẽ là cánh cửa mở ra sự chuyển hóa và thay đổi của toàn bộ con người bạn?\u003c/p\u003e\n\u003cp\u003eNhững câu chuyện li kì về cuộc đời của một hành giả Yoga, bậc thầy giác ngộ, người truyền cảm hứng sống cho hàng tỉ người trên trái đất hiện nay.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/66/9b/4b/75c69045bf024fa8d1620b7cf1467d74.jpg\" alt=\"nhà thần bí\" width=\"750\" height=\"562\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTHÔNG TIN VỀ SÁCH TRÒ CHUYỆN VS NHÀ THẦN BÍ\u003c/strong\u003e\u003cbr /\u003eTác giả: Sadhguru \u0026amp; Cheryl Simone\u003cbr /\u003eSố trang: 312 trang\u003cbr /\u003eKhổ 14 * 20,5 cM\u003c/p\u003e\n\u003cp\u003eDịch giả: Ngoan Nguyễn\u003cbr /\u003eNXB  Lao động\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eNHÀ SÁCH GIÁO DỤC QUỐC TẾ CAM KẾT\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Sách thật chính h.ãng , hoàn tiền ngay 200% nếu phát hiện sách gi.ả.\u003c/p\u003e\n\u003cp\u003e- Sách nhập nguyên kiện từ nhà xuất bản, đảm bảo chất lượng nguyên vẹn.\u003c/p\u003e\n\u003cp\u003e- 100% là sách m.ới, còn thơm nguyên mùi giấy.\u003c/p\u003e\n\u003cp\u003e- Hàng luôn có sẵn, giao ngay khi nhận được đơn.\u003c/p\u003e\n\u003cp\u003e- Sản phẩm được kiểm tra kỹ càng, đóng gói chắc chắn, cẩn thận trước khi giao cho Quý khách.\u003c/p\u003e\n\u003cp\u003e- Chính sách đổi trả: Hỗ trợ đổi trả theo quy định của TIKI.\u003c/p\u003e\n\u003cp\u003e- Do màn hình và điều kiện ánh sáng khác nhau, màu sắc thực tế của sản phẩm có thể chênh lệch khoảng 3-5%.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/5a/de/b4/5d1361c674b57b0e141491d3de08f070.png","