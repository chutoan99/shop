_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/15/25/66/b9422551064ef6e131992fb56a30654b.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1435,"all_time_quantity_sold":366,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cdiv class=\"col-lg-9 col-md-12 col-sm-12 col-xs-12\"\u003e\n\u003cdiv class=\"tab_h\"\u003e\n\u003cdiv class=\"col-xs-12 col-lg-12 col-sm-12 col-md-12 no-padding\"\u003e\n\u003cdiv class=\"product-tab e-tabs\"\u003e\n\u003cdiv class=\"tab-content current\"\u003e\n\u003cdiv class=\"rte\"\u003e\n\u003cdiv class=\"product-well expanded\"\u003e\n\u003cp\u003e\u003cstrong\u003eCháo tươi yến hạt sen lá dứa\u003c/strong\u003e thương hiệu Cây Thị là sản phẩm hoàn toàn mới được chế biến trên dây chuyền công nghệ hiện đại, giữ nguyên được hương vị tươi ngon, đảm bảo hàm lượng dinh dưỡng và an toàn cho người tiêu dùng. Cháo tươi thương hiệu Cây Thị được đóng gói trong bao bì chuyên dụng rất dễ dàng bảo quản và sử dụng.\u003c/p\u003e\n\u003cp\u003eTrong tổ yến chứa 42,8% - 52,9% protein; nhiều glucose; các acid amin khó thay thế cystein, phenyllamin,tyrosin,...; các vitamin B,C,E,PP; các muối natri, sắt, phosphor và các nguyên tố vị lượng.\u003c/p\u003e\n\u003cp\u003eCháo Tươi Yến Hạt Sen nay đã thay đổi diện mạo mới, từ nay khách hàng ăn chay đã có thể dùng được vị yến hạt lá dứa thơm ngon, bổ dưỡng. (Bao bì thay đôi theo từng đợt nhập hàng)\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/a4/a6/25/bf7cce995116de50dc3efc1133ca6cef.jpg\" alt=\"\" width=\"550\" height=\"550\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003eHình ảnh bao bì mới\u003c/p\u003e\n\u003cp s