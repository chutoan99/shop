_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/bd/10/3b/3b1166686e7eb932d303eef2fe1ddb57.png","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":52,"all_time_quantity_sold":5,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003carticle class=\"4ever-article\"\u003e\n\u003cp\u003eTHÔNG SỐ KỸ THUẬT\u003c/p\u003e\n\u003cp\u003eKích thước | Cân nặng: 43,75 x 13,3 x 1,73 cm | 850g\u003c/p\u003e\n\u003cp\u003eKết nối: Bluetooth 5.1 | Receiver 2.4G | Cable (5 thiết bị luân phiên)\u003c/p\u003e\n\u003cp\u003eLayout: Fullsize\u003c/p\u003e\n\u003cp\u003eThời gian sử dụng: 25 ngày\u003c/p\u003e\n\u003cp\u003eCổng sạc: Type C\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eBàn phím không dây HyperWork SilentKey\u003c/p\u003e\n\u003cp\u003eLayout Fullsize\u003c/p\u003e\n\u003cp\u003eLayout fullsize hỗ trợ thực hiện đầy đủ các chức năng và tác vụ.\u003c/p\u003e\n\u003cp\u003eLayout này phù hợp với người người dùng đặc thù (kế toán, nhập liệu,...) hoặc người dùng ưa chuộng thiết kế đầy đủ phím, không cần ghi nhớ các tổ hợp phím như khi sử dụng các layout 80%, 75%,...\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/bd/10/3b/4d04496d3e25c6cb76967b6a3cd45dac.png\" alt=\"bd103ba6dbf178bfe1c1ea16e0159140.png\" /\u003e\u003c/p\u003e\n\u003cp\u003e3 chế độ kết nối, kết nối tối đa 5 thiết bị\u003c/p\u003e\n\u003cp\u003eMáy tính để bàn không hỗ trợ Bluetooth hay các cổng USB đều trong tình trạng bận...? SilentKey hỗ trợ cả kết nối có dây, thân thiện với mọi thiết bị, tiện dụng cho người dùng.\u003c/p\u003e\n\u003cp\u003eKết nối tối đa 5 thiết bị bao gồm 3 thiết bị qua Bluetooth, 2 thiết bị qua receiver 2.4 Ghz và dây kết nối.\u003c/p\u003e\n\u003cp\u003eKết nối liền mạch, tối đa hiệu suất\u003c/p\u003e\n\u003cp\u003eTương thích, tự động nhận diện OS\u003c/p\u003e\n\u003cp\u003eSilentKey hỗ trợ đa hệ điều hành như MacOS, Windows, Android... tích hợp tất cả trong một chiếc bàn phím.\u003c/p\u003e\n\u003cp\u003eTự động nhận diện hệ điều hành nhanh chóng.\u003c/p\u003e\n\u003cp\u003e*Lưu ý, tính năng này chỉ hoạt động ở chế độ kết nối Bluetooth.\u003c/p\u003e\n\u003cp\u003eChuyển đổi nhanh\u003c/p\u003e\n\u003cp\u003eThao tác chuyển đổi nhanh chóng giữa các chế độ kết nối được thực hiện bằng cần gạt BT/2.4G và Cable (kết nối dây).\u003c/p\u003e\n\u003cp\u003eNgười dùng có thể giữ tổ hợp phím tắt FN+1/2/3 hoặc FN+2.4G để luân phiên kết nối các thiết bị.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/fa/72/a1/231db1beafe8af5983d34335443371d9.jpg\" alt=\"fa72a1ca603b8b938d70b2d2a521fa0e.jpg\" /\u003e\u003c/p\u003e\n\u003cp\u003eBổ sung sạc USB-C\u003c/p\u003e\n\u003cp\u003eSử dụng bàn phím không lo gián đoạn, bổ sung cáp sạc USB-C trực tiếp sạc khi sử dụng (thời gian sạc: 60 phút).\u003c/p\u003e\n\u003cp\u003eBàn phím vào trạng thái ngủ (sleep) sau 30 phút không sử dụng để tiết kiệm pin.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/ce/34/00/5efc60d51914922a4318d3e223b02971.jpg\" alt=\"ce340066dd6ec635da4c573775ed140e.jpg\" /\u003e\u003c/p\u003e\n\u003cp\u003eKết cấu phím X-Scissors cải tiến\u003c/p\u003e\n\u003cp\u003eKết cấu cắt kéo cải tiến tạo ra trải nghiệm gõ êm ái, giảm tiếng ồn tới 40% so với các loại bàn phím cao su thông thường, phù hợp nhu cầu cần làm việc yên tĩnh của người dùng.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/b5/50/bd/b34d7fd636b48ef73f6c59a0532f43ec.jpg\" alt=\"b550bd7172d879f2a0acb28b7fbdcd3d.jpg\" /\u003e\u003c/p\u003e\n\u003cp\u003eTích hợp tiện ích\u003c/p\u003e\n\u003cp\u003eReceiver 2.4 GHz nam châm tích hợp ở mặt sau bàn phím, hạn chế tình trạng thất lạc.\u003c/p\u003e\n\u003cp\u003eNgoài ra, nếu có thói quen đặt bàn phím ở góc nghiêng nhỏ so với mặt phẳng bàn, bạn có thể chống 2 chân đế phía sau SilentKey. Cách đặt bàn phím như này có thể cải thiện tốc độ gõ nhanh hơn do người dùng có thể cảm nhận phím rõ ràng hơn.\u003c/p\u003e\n\u003c/article\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/bd/10/3b/3b1166686e7eb932d303eef2fe1ddb57.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/bd/10/3b/3b1166686e7eb932d303eef2fe1ddb57.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/bd/10/3b/3b1166686e7eb932d303eef2fe1ddb57.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/bd/10/3b/3b1166686e7eb932d303eef2fe1ddb57.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/bd/10/3b/3b1166686e7eb932d303eef2fe1ddb57.png"},{"base_url":"https://salt.tikicdn.com/ts/product/30/20/44/6ed6f0db866705b436515f2ac0ea8771.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/30/20/44/6ed6f0db866705b436515f2ac0ea8771.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/30/20/44/6ed6f0db866705b436515f2ac0ea8771.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/30/20/44/6ed6f0db866705b436515f2ac0ea8771.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/30/20/44/6ed6f0db866705b436515f2ac0ea8771.png"},{"base_url":"https://salt.tikicdn.com/ts/product/29/c0/11/22f22820f382cd012cfc057b6df8f4c7.png","is_gallery":tru