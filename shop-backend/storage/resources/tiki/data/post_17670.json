hentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"defective_product"}},"discount":200000,"discount_rate":8,"rating_average":5,"review_count":3,"review_text":"(3)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/35/75/87/52ac697c698208f487245988c272643b.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1883,"all_time_quantity_sold":19,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"margin-bottom:1.3em;margin-top:0px;color:#0a0a0a;font-family:Roboto, sans-serif;font-size:16px;\"\u003eNhóm nước hoa: Hương gỗ thơm\u003c/p\u003e\n\u003cp style=\"margin-bottom:1.3em;margin-top:0px;color:#0a0a0a;font-family:Roboto, sans-serif;font-size:16px;\"\u003eGiới tính: Nam\u003c/p\u003e\n\u003cp style=\"margin-bottom:1.3em;margin-top:0px;color:#0a0a0a;font-family:Roboto, sans-serif;font-size:16px;\"\u003eNăm ra mắt: 2019\u003c/p\u003e\n\u003cp style=\"margin-bottom:1.3em;margin-top:0px;color:#0a0a0a;font-family:Roboto, sans-serif;font-size:16px;\"\u003eNồng độ: EDP\u003c/p\u003e\n\u003cp style=\"margin-bottom:1.3em;margin-top:0px;color:#0a0a0a;font-family:Roboto, sans-serif;font-size:16px;\"\u003ePhong Cách: Tự Tin, Nam Tính, Lôi Cuốn.\u003c/p\u003e\n\u003cp style=\"margin-bottom:1.3em;margin-top:0px;color:#0a0a0a;font-family:Roboto, sans-serif;font-size:16px;\"\u003eHương Đầu: Cam Bergamot, Hồng tiêu, Cây đơn sâm\u003c/p\u003e\n\u003cp style=\"margin-bottom:1.3em;margin-top:0px;color:#0a0a0a;font-family:Roboto, sans-serif;font-size:16px;\"\u003eHương giữa: Da thuộc, Cỏ hương bài Haiti\u003c/p\u003e\n\u003cp style=\"margin-bottom:1.3em;margin-top:0px;color:#0a0a0a;font-family:Roboto, sans-serif;font-size:16px;\"\u003eHương cuối: Lá cây hoắc hương Indo, Quả Ca cao, Akigalawood, Hương Ambroxan\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eNước Hoa Montblanc Explorer Được khơi gợi cảm hứng từ những nhà thám hiểm luôn không ngừng chinh phục những đỉnh cao mới, Montblanc Explorer sở hữu nốt hương đầu mang cảm giác sảng khoái với cam Bergamot tươi mát. Với những Quý Ông sành về nước hoa có thể cảm nhận ngay mùi hương quyến rũ của cỏ hương bài ở tầng giữa và khi lắng xuống ở nốt cuối cùng là mùi hương nổi bật của hoắc hương \u0026amp; hương gỗ nam tính.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg class=\"aligncenter wp-image-35935\" title=\"Montblanc Explorer Mont Blanc EDP 1 - Nuochoarosa.com - Nước hoa cao cấp, chính hãng giá tốt, mẫu mới\" src=\"https://nuochoarosa.com/wp-content/uploads/2019/05/z2967244621877_5fb081c595583525eb8f30493862298a-min.jpg\" alt=\"z2967244621877 5fb081c595583525eb8f30493862298a min - Nuochoarosa.com - Nước hoa cao cấp, chính hãng giá tốt, mẫu mới\" width=\"600\" height=\"600\" /\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eNước hoa Montblanc Explorer sở hữu mùi hương mạnh mẽ, thoảng chút cay nồng, được đóng trong chai hình trụ tròn với vỏ bọc tay áo bằng da màu đen – phụ kiện không thể thiếu của những tay chơi mạo hiểm cùng biểu tượng loài hoa tuyết sáu cánh đặc trưng của hãng.\u003c/li\u003e\n\u003cli\u003eNước hoa Montblanc Explorer đại diện cho tinh thần phóng khoáng, yêu cuộc sống tự do và luôn tiên phong, dẫn đầu xu hướng hệt như những nhà thám hiểm chân chính. Từ đỉnh núi cheo leo hay đến bốn ngóc ngách của trái đất, Quý ông Montblanc Explorer đam mê khám phá luôn hướng đến việc nắm bắt cơ hội và kiến tạo để đạt được những điều tuyệt vời nhất.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg class=\"aligncenter wp-image-35934\" title=\"Montblanc Explorer Mont Blanc EDP 2 - Nuochoarosa.com - Nước hoa cao cấp, chính hãng giá tốt, mẫu mới\" src=\"https://nuochoarosa.com/wp-content/uploads/2019/05/z2967244618312_889b5c0e9ae017a287a84c919ebcb7a3-min.jpg\" alt=\"z2967244618312 889b5c0e9ae017a287a84c919ebcb7a3 min - Nuochoarosa.com - Nước hoa cao cấp, chính hãng giá tốt, mẫu mới\" width=\"600\" height=\"738\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/35/75/87/52ac697c698208f487245988c272643b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/35/75/87/52ac697c698208f487245988c272643b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/35/75/87/52ac697c698208f487245988c272643b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/35/75/87/52ac697c698208f487245988c272643b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/35/75/87/52ac697c698208f487245988c272643b.jpg"}],"warranty_policy":null,"brand":{"id":150700,"name":"Montblanc","slug":"montblanc"},"current_seller":{"id":40786,"sku":"7799330591885","name":"Rosa Perfume","link":"https://tiki.vn/cua-hang/rosa-perfume","logo":"3e/99/67/a9c8b85e45561502767cf8023c529867.jpg","price":2250000,"product_id":"22979591","store_id":39803,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Content","attributes":[{"code":"brand","name":"Thương hiệu","value":"Montblanc"},{"code":"brand_country","name":"Xuất xứ thương hiệu","value":"Pháp"},{"code":"origin","name":"Xuất xứ (Made in)","value":"Ph