png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":20000,"discount_rate":8,"rating_average":5,"review_count":70,"review_text":"(70)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/15/00/27/f64915f2ddb6365326ba2f6406541556.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1983,"all_time_quantity_sold":254,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp class=\"MsoNormal\" style=\"text-align:justify;line-height:normal;background:white;margin:3.75pt 0in 9pt 0in\"\u003e\u003cstrong\u003e\u003cem\u003e\u003cspan style=\"font-size:15pt;font-family:\u0026#39;times new roman\u0026#39; , serif;color:black\"\u003eMũ Bảo Hiểm 1/2 đầu Protec Rosa không kính RLW (Size L)\u003c/span\u003e\u003c/em\u003e\u003c/strong\u003e\u003cspan style=\"font-size:12pt;font-family:\u0026#39;times new roman\u0026#39; , serif;color:black\"\u003e thuộc dòng Rosa - dòng sản phẩm nằm trong top bán chạy của Protec. Kích thước mũ vừa vặn, được thiết kế đặc biệt dành cho người châu Á. \u003c/span\u003e\u003cspan style=\"font-family:\u0026#39;times new roman\u0026#39; , serif;font-size:12pt\"\u003e8 khe thông gió khoa học được nghiên cứu kỹ mang lại cảm giác thông thoáng ngay cả trong ngày hè oi bức, rất phù hợp với khí hậu nóng ẩm tại Việt Nam.\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\" style=\"text-align:justify;line-height:normal;background:white;margin:3.75pt 0in 9pt 0in\"\u003e\u003cspan style=\"font-family:\u0026#39;times new roman\u0026#39; , serif;font-size:12pt\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ec/38/3a/79d8f03c01adb99cb1f172bf6be0b3be.JPG\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\" style=\"margin-left:0.25in;text-align:justify;line-height:normal\"\u003e\u003cspan style=\"font-size:12pt;font-family:\u0026#39;times new roman\u0026#39; , serif\"\u003eMũ được chứng nhận đạt quy chuẩn kỹ thuật quốc gia QCVN 2:2008/BKHCN (tem chứng nhận CR được dán phía sau mũ khẳng định chất lượng sản phẩm).\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\" style=\"margin-left:0.25in;text-align:justify;line-height:normal\"\u003e\u003cspan style=\"font-size:12pt;font-family:\u0026#39;times new roman\u0026#39; , serif\"\u003eMũ Protec đã thông qua các quy trình kiểm định nghiêm ngặt về độ va đập, độ đâm xuyên và độ ổn định của khóa mũ.\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\" style=\"margin-left:0.25in;text-align:justify;line-height:normal\"\u003e\u003cspan style=\"font-size:12pt;font-family:\u0026#39;times new roman\u0026#39; , serif\"\u003eVỏ bằng nhựa ABS cao cấp, chịu được lực va đập lớn và nhiệt độ cao, giúp chống lại nhiều tác động bên ngoài.\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\" style=\"margin-left:0.25in;text-align:justify;line-height:normal\"\u003e\u003cspan style=\"font-size:12pt;font-family:\u0026#39;times new roman\u0026#39; , serif\"\u003eLõi xốp mũ là bộ phận quan trọng có tác dụng giảm chấn động tới đầu người đội và bảo vệ bộ não. Lõi với chất liệu chính là EPS, nén bằng nhiều lớp xốp rắn chắc, các hạt xốp nhỏ, đều mịn nhẹ, thoáng và hấp thu xung động tốt khi xảy ra tai nạn. Lớp mút này có thể tháo ra dễ dàng để giặt hay vệ sinh khi cần.\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\" style=\"margin-left:0.25in;text-align:justify;line-height:normal\"\u003e\u003cspan style=\"font-size:12pt;font-family:\u0026#39;times new roman\u0026#39; , serif\"\u003eMũ có trọng lượng rất nhẹ, chỉ khoảng 440gram khiến bạn cảm thấy nhẹ nhàng trong thời gian dài sử dụng.\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\" style=\"margin-left:0.25in;text-align:justify;line-height:normal\"\u003e\u003cspan style=\"font-size:12pt;font-family:\u0026#39;times new roman\u0026#39; , serif\"\u003eBố trí 8 lỗ thoát khí khoa học mang lại cảm giác thoải mái, thoáng mát khi đội.\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\" style=\"margin-left:0.25in;text-align:justify;line-height:normal\"\u003e\u003cspan style=\"font-size:12pt;font-family:\u0026#39;times new roman\u0026#39; , serif\"\u003eDây mũ được thiết kế đặc biệt, chịu được lực kéo, lực văng lớn. Đồng thời giúp ôm gọn vòng đầu tốt hơn nhưng không gây khó chịu. Dây mũ có thể điều chỉnh độ dài ngắn dễ dàng.\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\" style=\"margin:3.75pt 0in 9pt;text-align:justify;line-height:normal\"\u003e \u003c/p\u003e\n\u003cp class=\"MsoNormal\" style=\"margin-left:0.25in;text-align:justify;line-height:normal\"\u003e\u003cspan style=\"font-size:12pt;font-family:\u0026#39;times new roman\u0026#39; , serif\"\u003eMũ Protec Rosa còn được thiết kế thêm bộ chỉnh size bên trong mũ cho người sử dụng, đảm bảo sự vừa vặn phù hợp nhất đối với người sử dụng mà vẫn thoải mái khi đội.\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\" style=\"margin-left:0.25in;text-align:justify;line-height:normal\"\u003e\u003cspan style=\"font-size:12pt;font-family:\u0026#39;times new roman\u0026#39; , serif\"\u003eThiết kế một màu trơn, vừa đơn giản, hiện đại nhưng vẫn hợp thời trang, phù hợp với cả nam và nữ.\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\" style=\"margin-left:0.25in;text-align:justify;line-height:normal\"\u003e\u003cspan style=\"font-size:12pt;font-family:\u0026#39;times new roman\u0026#39; , serif\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/41/7c/ce/6c21de2b0b7bb3fed8146c5e2a8df154.JPG\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\" style=\"margin-bottom:0.0001pt;text-align:justify;line-height:normal\"\u003e\u003cstrong\u003e\u003cem\u003e\u003cu\u003e\u003cspan style=\"font-size:12pt;font-family:\u0026#39;times new roman\u0026#39; , serif\"\u003eLưu ý trong sử dụng và bảo quản:\u003c/span\u003e\u003c/u\u003e\u003c/em\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\" style=\"margin-bottom:0.0001pt;text-align:justify;line-height:normal\"\u003e\u003cspan style=\"font-size:12pt;font-family:\u0026#39;times new roman\u0026#39; , serif\"\u003eDùng khăn ẩm (không dùng xăng hoặc chất tẩy rửa mạnh) để lau nón. Nên thay nón mới sau tai nạn hoặc va đập mạnh vì lớp EPS không thể bảo vệ bạn nếu nó đã bị va đập. Không nên để nón ở nơi có nhiệt độ cao để đảm bảo độ bền của nón. Protec khuyên khách hàng nên thay nón sau thời gian sử dụng từ 2-3 năm.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/4d/04/23/5e75749e7e33286bae7b4dd82967bc4d.png\" alt=\"\" width=\"718\" height=\"533\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/15/00/27/f64915f2ddb6365326ba2f6406541556.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/15/00/27/f64915f2ddb6365326ba2f6406541556.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/15/00/27/f64915f2ddb6365326ba2f6406541556.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/15/00/27/f64915f2ddb6365326ba2f6406541556.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/15/00/27/f64915f2ddb6365326ba2f6406541556.jpg"},{"base_