49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":460000,"discount_rate":48,"rating_average":4.8,"review_count":25,"review_text":"(25)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/32/34/5c/dd6d60102cf466b5f648615e51ae0541.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1478,"all_time_quantity_sold":228,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p><em><strong>Máy tăm nước du lịch cầm tay H2ofloss HF-6</strong></em> là máy tăm nước cầm tay bản nâng cấp nhiều hơn về thiết kế và tính năng so với HF-5. HF-6 có 5 chế độ tùy chỉnh tốc độ nước trong khi hầu hết các máy trên thị trường chỉ có 3 chế độ. <em><strong>Máy tăm nước du lịch cầm tay H2ofloss HF-6</strong></em> còn có dải áp lực nước tùy chỉnh từ 20-110 PSI cùng với ống hút trọng lực có thể xoay chiều giúp hút sạch nước trong bình ở mọi tư thế cầm máy. Đi kèm với máy là 5 đầu tăm thay thế và túi du lịch. Dung tích bình chứa nước của HF-6 là 300ml giúp tiết kiệm thời gian thêm nước khi sử dụng (các máy khác trên thị trường dung tích chứa chỉ 150-200ml).</p>\n<p> </p>\n<p><img style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/32/cb/2f/f23c8a51db8b15b00536d20c55be35dc.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p> </p>\n<p><em><strong>Máy tăm nước du lịch cầm tay H2ofloss HF-6</strong></em> sử dụng pin lithium-ion dung lượng lớn 2150 mAh có thể sạc lại. Sau khi sạc đầy pin máy có thể sử dụng khoảng 7-15 ngày theo nhu cầu thông thường. Dây sạc của HF-6 là cổng USB dùng chung với củ sạc điện thoại, sạc dự phòng, laptop,…</p>\n<p> </p>\n<p><strong>THÔNG SỐ KỸ THUẬT  MÁY TĂM NƯỚC H2OFLOSS HF-6</strong></p>\n<p>- Dòng máy: du lịch, pin lithium-ion 2150 mAh có thể sạc lại</p>\n<p>- Thời gian sạc: 3-5 tiếng</p>\n<p>- Dung tích bình nước: 300ml</p>\n<p>- 5 chế độ điều chỉnh tốc độ</p>\n<p>- Chống nước: IPX7</p>\n<p>- 5 đầu tăm có sẵn đi kèm</p>\n<p>- Vòi xoay 360 độ</p>\n<p> </p>\n<p><img style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/3e/60/dd/b77f7488f2defb9843281fda3e8e2f00.jpg\" alt=\"\" width=\"750\" height=\"793\" /></p>\n<p> </p>\n<p><strong>CÁCH SỬ DỤNG MÁY TĂM NƯỚC H2OFLOSS HF-6</strong></p>\n<p>- Lắp đầu tăm phù hợp theo nhu cầu vào máy. Để tháo đầu tăm cần ấn nút bên cạnh và kéo đầu tăm ra ngoài.</p>\n<p>- Cho nước sạch vào bình và đậy kín nắp.</p>\n<p>- Ấn nút “M” để chọn và điều chỉnh tốc độ phù hợp.</p>\n<p>- Ấn nút nguồn để mở và tắt máy.</p>\n<p>- Đổ bỏ hoặc mở máy để hút hết nước thừa sau khi sử dụng.</p>\n<p> </p>\n<p><img style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/32/34/5c/d3c9929c4a53cec4c6cb74e92cddbe06.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p> </p>\n<p><strong>BỘ SẢN PHẨM MÁY TĂM NƯỚC H2OFLOSS HF-6</strong> </p>\n<p>- Máy tăm nước HF-6</p>\n<p>- 1 dây sạc</p>\n<p>- Hướng dẫn sử dụng và bảo hành (tiếng Anh + tiếng Việt)</p>\n<p>- 5 đầu tăm</p>\n<p>- 1 túi du lịch</p>\n<p><img style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/22/30/39/468acf2136c8be2dd0c9725818ab2a40.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<h3 class=\"_2jrvqA\"> </h3>\n<h3 class=\"_2jrvqA\">Sản phẩm được phân phối chính hãng tại Công ty Phương Linh với dịch vụ chăm sóc khách hàng và bảo hành sản phẩm tốt nhất.</h3>\n<h2 class=\"_2jrvqA\">Bảo hành</h2>\n<p class=\"_2jrvqA\">Bảo hành chính hãng 12 tháng</p>\n<p class=\"_2jrvqA\">Bảo hành 1 đổi 1 (Đối với lỗi từ nhà sản xuất)</p>\n<p class=\"_2jrvqA\">Bảo hành thông qua mã đơn mua hàng trên sàn Tiki, không cần hóa đơn.</p>\n<p class=\"_2jrvqA\">Tất cả sản phẩm công ty phân phối đều bảo hành qua mã đơn hàng, khách hàng ở tỉnh nếu không đến trực tiếp có thể gửi qua đường bưu điện, bên công ty sẽ gửi hàng bảo hành tận nơi cho các bạn.</p>\n<p class=\"_2jrvqA\">Trung tâm bảo hành: Phường An Phú, Quận 2, HCM.</p>\n<h3 class=\"_2jrvqA\"><strong>Điều kiện bảo hành:</strong> Vui lòng giữ lại HỘP của sản phẩm và khi cần bảo hành vui lòng chat với Shop qua app Tiki.</h3>\n<h2 class=\"_2jrvqA\"> Hỗ trợ khách hàng</h2>\n<p class=\"_2jrvqA\">Hỗ trợ tư vấn qua khung chat với Shop trên app Tiki</p>\n<p class=\"_2jrvqA\">Thời gian làm việc: 8h - 12h00 và 13h30 - 17h00 (Từ thứ 2 đến thứ 6, trừ các ngày Lễ/Tết).</p>\n<h3 class=\"_2jrvqA\"> Vui lòng QUAY VIDEO khui gói hàng trước khi mở gói hàng để đảm bảo SHOP giao đúng và đủ đơn hàng. Cảm ơn quý khách đã ủng hộ!</h3><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/32/34/5c/dd6d60102cf466b5f648615e51ae0541.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/32/34/5c/dd6d60102cf466b5f648615e51ae0541.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/32/34/5c/dd6d60102cf466b5f648615e51ae0541.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/32/34/5c/dd6d60102cf466b5f648615e51ae0541.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/32/34/5c/dd6d60102cf466b5f648615e51ae0541.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/3e/60/dd/fc945bea94a3a474800c5a59bae151b8.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/produc