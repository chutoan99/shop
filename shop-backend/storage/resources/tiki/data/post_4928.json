hentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/89/99/5b/5f3d7123c39df5d63252548323bc6b4d.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":556,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\n  \u003cp\u003eĐẶC ĐIỂM NỔI BẬT:\u003c/p\u003e\n   \u003cp\u003eĐa chức năng: Lẩu, Xào, Chiên, Rán…\u003c/p\u003e\n   \u003cp\u003eLòng nồi chống dính cao cấp, dễ dàng vệ sinh\u003c/p\u003e\n   \u003cp\u003eTự ngắt khi quá nhiệt hoặc sôi khô an toàn sử dụng\u003c/p\u003e\n   \u003cp\u003eĂn lẩu tại gia ngày càng trở nên quen thuộc với các gia đình Việt. Không những đổi vị bữa cơm gia đình, quây quần bên nồi lẩu còn là khoảng thời gian vàng để các thành viên thêm gắn kết. Thấu hiểu được nhu cầu đó, SUNHOUSE cho ra đời Nồi lẩu điện SUNHOUSE SHD4527 với thiết kế trang nhã và công suất nấu mạnh mẽ, chế biến được nhiều loại thức ăn khác nhau, sử dụng đơn giản, tiện dụng hơn cho công việc nội trợ.\u003c/p\u003e\n   \u003cp\u003eThiết kế trang nhã, gọn nhẹ\u003c/p\u003e\n   \u003cp\u003eNồi lẩu điện SUNHOUSE SHD4527 có thân nồi làm từ chất liệu tôn sơn tĩnh điện, có khả năng chịu nhiệt cao và ít bị ảnh hưởng bởi môi trường. Đây cũng là chất liệu không bong tróc, dễ dàng vệ sinh, tiết kiệm thời gian cho người sử dụng. Màu xanh ngọc trang nhã, tinh tế, làm tôn lên vẻ đẹp cho căn bếp của gia đình bạn.\u003c/p\u003e\n   \u003cp\u003eVung nồi được làm bằng chất liệu nhôm an toàn, chịu lực tốt, hạn chế ám mùi, vô cùng tiện lợi. Núm vung, tay cầm bằng nhựa cao cấp, chịu nhiệt siêu bền giúp việc mở nắp và di chuyển dễ dàng và an toàn.\u003c/p\u003e\n   \u003cp\u003eLòng nồi chống dính Whitford (USA)\u003c/p\u003e\n   \u003cp\u003eLòng nồi được làm từ hợp kim nhôm dày giúp giữ nhiệt lâu hơn. Không những thế, lòng nồi còn được tráng một lớp chống dính cao cấp siêu bền, an toàn cho sức khỏe, không làm phát sinh chất độc hại khi tiếp xúc dưới nhiệt độ cao, tránh bám dính thức ăn và dễ dàng vệ sinh sau khi sử dụng.\u003c/p\u003e\n   \u003cp\u003eNồi lẩu đa chức năng\u003c/p\u003e\n   \u003cp\u003eDung tích nồi lớn 3.5 lít phù hợp cho cả gia đình 2 – 4 người trong những buổi liên hoan, họp mặt. Không chỉ nấu lẩu, nồi còn có thể dùng để xào, rán, hầm… rất tiện dụng. Nồi có thể thay thế bếp gas tiện lợi, tiết kiệm năng lượng.\u003c/p\u003e\n   \u003cp\u003eCông suất lớn, nấu chín nhanh\u003c/p\u003e\n   \u003cp\u003eLẩu điện có một mâm nhiệt lớn giúp truyền nhiệt nhanh và đều, cùng công suất cao 1300W giúp nấu chín thức ăn nhanh chóng, tiết kiệm thời gian nấu nướng.\u003c/p\u003e\n   \u003cp\u003eDễ dàng vệ sinh\u003c/p\u003e\n   \u003cp\u003eCác bộ phận nồi có thể dễ dàng tháo lắp nên việc vệ sinh, lau chùi rất đơn giản và nhẹ nhàng.\u003c/p\u003e\n   \u003cp\u003eThông số kỹ thuật:\u003c/p\u003e\n   \u003cp\u003eMàu sắc: Xanh ngọc\u003c/p\u003e\n   \u003cp\u003eĐiện áp: 220V~/50HZ\u003c/p\u003e\n   \u003cp\u003eCông suất: 1300 W\u003c/p\u003e\n   \u003cp\u003eTrọng lượng: 2.2 kg\u003c/p\u003e\n   \u003cp\u003eChức năng: Lẩu, nấu canh, chiên, xào…\u003c/p\u003e\n   \u003cp\u003eThân nồi: Tôn sơn tĩnh điện\u003c/p\u003e\n   \u003cp\u003eLòng nồi: Hợp kim nhôm phủ chống dính\u003c/p\u003e\n   \u003cp\u003eCó thể tháo rời\u003c/p\u003e\n   \u003cp\u003eVung/nắp: Nhôm sơn tĩnh điện\u003c/p\u003e\n   \u003cp\u003eMàn hình: Không\u003c/p\u003e\n   \u003cp\u003eHẹn giờ: Không\u003c/p\u003e\n   \u003cp\u003eKhóa trẻ em: Không\u003c/p\u003e\n   \u003cp\u003eThương hiệu: SUNHOUSE\u003c/p\u003e\n   \u003cp\u003eXuất xứ: Việt Nam\u003c/p\u003e\n   \u003cp\u003eBảo hành: 12 tháng\u003c/p\u003e\n  \u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/89/99/5b/5f3d7123c39df5d63252548323bc6b4d.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/89/99/5b/5f3d7123c39df5d63252548323bc6b4d.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/89/99/5b/5f3d7123c39df5d63252548323bc6b4d.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/89/99/5b/5f3d7123c39df5d63252548323bc6b4d.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/89/99/5b/5f3d7123c39df5d63252548323bc6b4d.png"},{"base_url":"https://salt.tikicdn.com/ts/product/9d/0c/ed/f72f8310d8f012a7e64a305fb24c63b5.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/9d/0c/ed/f72f8310d8f012a7e64a305fb24c63b5.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/9d/0c/ed/f72f8310d8f012a7e64a305fb24c63b5.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9d/0c/ed/f72f8310d8f012a7e64a305fb24c63b5.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9d/0c/ed/f72f8310d8f012a7e64a305fb24c63b5.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/b4/ab/03/dcb65f903c33968ccffcf0c248cbc1c5.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b4/ab/03/dcb65f903c3396