c giá cực tốt cho một mẫu giày đa dụng\u003c/p\u003e\n\u003cp\u003eSize: 36 – 44\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/b4/1a/9f/195e0e80feba5bc8fbad13751b05106d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b4/1a/9f/195e0e80feba5bc8fbad13751b05106d.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b4/1a/9f/195e0e80feba5bc8fbad13751b05106d.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b4/1a/9f/195e0e80feba5bc8fbad13751b05106d.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b4/1a/9f/195e0e80feba5bc8fbad13751b05106d.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/c3/c2/e0/a2625d742a65f173c19f5245673ca516.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c3/c2/e0/a2625d742a65f173c19f5245673ca516.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c3/c2/e0/a2625d742a65f173c19f5245673ca516.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c3/c2/e0/a2625d742a65f173c19f5245673ca516.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c3/c2/e0/a2625d742a65f173c19f5245673ca516.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/1c/a7/f1/7496123433ab726351a10e1cd5c18461.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/1c/a7/f1/7496123433ab726351a10e1cd5c18461.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/1c/a7/f1/7496123433ab726351a10e1cd5c18461.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/2