s_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":1000,"discount_rate":2,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/media/catalog/product/8/9/8948_1.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":3193,"all_time_quantity_sold":36,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: medium; color: #008ab7;\"\u003e\u003cstrong\u003eBút Bi Nước Bấm Pentel 1mm - BL60\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eBút Bi Nước Bấm Pentel 1mm - BL60 \u003c/strong\u003ecó thiết kế đầu bi 1mm, thường sử dụng để ký giấy tờ, sử dụng loại mực cao cấp, không lem, không phai màu. Mực nước dạng lỏng, trơn đều và nhanh khô. Tay cầm bằng cao su mang lại sự thoải mái ngay cả khi bạn phải viết trong thời gian dài. Sản phẩm có hai màu xanh và đen cho bạn lựa chọn.\u003c/p\u003e\r\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"http://tikicdn.com/media/catalog/product/8/8/8877.jpg\" alt=\"\" width=\"800\" height=\"800\" /\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eThông tin sản phẩm\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eChất liệu chất lượng\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eCám cầm bút bi được làm bằng cao su mềm mại, mang lại sự thoải mái ngay cả khi bạn phải viết hàng giờ liền. Chất liệu mực nước cao cấp, nhanh khô và không phai màu sau thời gian dài sử dụng. Chất liệu này không chứa hóa chất độc hại nên rất an toàn cho người sử dụng.\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eThiết kế đẹp mắt\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eĐầu bi được làm bằng hợp kim có kích cỡ 1mm, giúp bạn có những nét bút đậm và rõ ràng. Thân bút được thiết kế tròn dài, tạo cảm giác thoải mái, vừa vặn, khi dùng lâu sẽ không làm đau hay tê cứng các ngón tay.\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eSản phẩm có 2 màu\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eSản phẩm có hai màu xanh và đen cho bạn lựa chọn. Màu sắc đa dạng giúp cho việc ghi chép của bạn đạt hiệu quả tốt hơn.\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eThương hiệu uy tín\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eTrong gần 70 năm kể từ khi thành lập, Pentel luôn là thương hiệu Nhật Bản cực kỳ uy tín, cung cấp các công cụ văn phòng phẩm có chất lượng cao nhất trên toàn thế giới.\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003ePentel là công ty sản xuất công cụ viết duy nhất nhận được giải thưởng Deming cho các sản phẩm chất lượng cao của mình.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e\u003cp\u003eSản phẩm này là tài sản cá nhân được bán bởi Nhà Bán Hàng Cá Nhân và không thuộc đối tượng phải chịu thuế GTGT. Do đó hoá đơn VAT không được cung cấp trong trường hợp này.\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/media/catalog/product/8/9/8948_1.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/8/9/8948_1.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/8/9/8948_1.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/8/9/8948_1.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/8/9/8948_1.jpg"},{"base_url":"https://salt.tikicdn.com/media/catalog/product/8/9/8951_1.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/8/9/8951_1.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/8/9/8951_1.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/8/9/8951_1.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/8/9/8951_1.jpg"},{"base_url":"https://salt.tikicdn.com/media/catalog/product/8/9/8952_1.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/8/9/8952_1.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/8/9/8952_1.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/8/9/8952_1.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/8/9/8952_1.jpg"}],"warranty_policy":null,"brand":{"id":27896,"name":"Pentel","slug":"pentel"},"current_seller":{"id":3644,"sku":"1490056384657","name":"Hoành Gia store","link":"https://tiki.vn/cua-hang/hoanh-gia-store","logo":"a5/06/d0/0383764c3cc03b278857bb5fd53837cf.jpg","price":44000,"product_id":"47972699","store_id":3594,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[{"id":291107,"name":"An Vy store","link":"http