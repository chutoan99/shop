3b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":102000,"discount_rate":34,"rating_average":4.3,"review_count":3,"review_text":"(3)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/31/46/87/908704355e7ca28068674eee61fe0c95.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2154,"all_time_quantity_sold":27,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eBergamo\u003c/strong\u003e là thương hiệu mỹ phẩm chất lượng cao của Hàn Quốc được biết đến với các dòng sản phẩm trang điểm chất lượng cao. Sản phẩm của Bergamo mang đến các tông màu tự nhiên, tươi trẻ, phù hợp với nhiều lứa tuổi nên được nhiều đối tượng khách hàng tại Hàn Quốc và nhiều nước trên thế giới yêu thích và lựa chọn sử dụng. \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eBergamo White Vita 120ml\u003c/strong\u003e là một sản phẩm cao cấp đến từ Hàn Quốc, cung cấp dưỡng chất giúp làn da bạn ngày càng trắng sáng lên trông thấy. Khi thoa tinh chất lên da, các tinh chất này sẽ cơ cấu và cung cấp chất dưỡng ẩm cho da làm cho da mềm mịn , nuôi dưỡng và tái tạo lại làn da lão hóa. Ngoài tác dụng dưỡng ẩm và tăng độ đàn hồi cho da, tinh chất collagen còn tái tạo làn da già nua do tuổi tác, làm trẻ hoá làn da. Sau 7 ngày sử dụng, các nàng sẽ thấy 1 làn da mềm mịn, trắng sáng và căng tràn sức sống.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCông dụng:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eTinh chất dưỡng trắng và giữ ẩm, giúp cải thiện tone da. Cho bạn làn da mịn màng và trắng bật tone. Giúp se khít lỗ chân lông và làm mờ vết thâm nám\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003e– Thành phần chính: collagen, tổng hợp vitamin, axitamin, B5,...\u003c/p\u003e\n\u003cp\u003e– Cải thiện tone da. Cho bạn làn da mịn màng và trắng bật tone (không tạo trắng ảo như các dạng cream thông thường). Sử dụng thời gian dài còn giúp se khít lỗ chân lông và làm mờ vết thâm nám, tái tạo làn da bị lão hoá.\u003c/p\u003e\n\u003cp\u003e– Nên sử dụng vào mỗi buổi tối\u003c/p\u003e\n\u003cstrong\u003eHướng dẫn sử dụng\u003c/strong\u003e\u003c/li\u003e\n\u003cli\u003eSau khi rửa mặt cho 1-2 giọt thoa đều trên mặt và cổ của bạn, sau đó mát xa nhẹ nhàng để tinh chất hấp thu vào sâu bên trong da sau khi làm sạch mặt.\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eĐể có kết quả tốt nhất, sử dụng vào buổi sáng và buổi tối, có thể dùng kết hợp với kem dưỡng trắng Bergamo Whitening Ex để giúp đạt hiệu quả nhanh hơn, giúp bạn nhanh chóng lấy lại được làn da tươi trẻ, trắng sáng mịn màng chỉ sau thời gian ngắn sử dụng.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eBảo quản sản phẩm nơi thoáng mát, tránh lưu trữ ở nhiệt độ cao\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/31/46/87/908704355e7ca28068674eee61fe0c95.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/31/46/87/908704355e7ca28068674eee61fe0c95.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/31/46/87/908704355e7ca28068674eee61fe0c95.jpg","position":null,"small_url":"https://salt.tikicdn