3b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/0b/db/1c/25beca9928b19e0677462fa0188ea291.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":315,"all_time_quantity_sold":56,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<article class=\"4ever-article\">\n<h2>Gạc rơ lưỡi thảo dược Elemis bảo vệ răng nướu cho bé hằng ngày</h2>\n<p>Đôi khi người lớn nghĩ rằng là trẻ sơ sinh cũng cần được vệ sinh răng miệng 2 ngày một lần. Tuy nhiên việc vệ sinh răng miệng cho bé hằng ngày sẽ giúp bé phòng tránh các bệnh về răng miệng sau này. Và sự lựa chọn hoàn hảo nhất cho bé là gặc rơ lưỡi thảo dược Elemis. </p>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/0b/db/1c/87038703a1a54362616d5313be804095.jpg\" alt=\"0bdb1cefc73e0af6d00c0768050bdeec.jpg\" /></p>\n<p> </p>\n<p>Gạc rơ lưỡi Elemis 30pcs</p>\n<h3>Đặc điểm nổi bật của gạc rơ lưỡi Elemis</h3>\n<p>- Gạc vệ sinh răng miệng cho bé được tẩm thành phần thảo dược với tác dụng làm là sạch, phòng chống bệnh về răng miệng (nấm miệng, tưa lưỡi, viêm nướu,..)</p>\n<p>- Gạc làm bằng chất liệu sợi Poplyester mềm mại, cao cấp hình ống tay tiện lợi, dễ dàng tiện lợi cho mẹ vệ sinh cho bé mỗi ngày.</p>\n<p>- Gạc rơ lưỡi Elemis được tiệt trùng 2 lần, gạc vô khuẩn được đóng bọc bao bì độc lập từng chiếc, ngăn chặn tối ưu vi khuẩn xâm nhập.</p>\n<p>- Gạc hấp tiết trùng và tiệt trùng bằng gia Gamma, gạc Elemis vô khuẩn được đóng bọc bao bì độc lập từng chiếc, ngăn chặn tối ưu vi khuẩn xâm nhập, đảm bảo an toàn vệ sinh. </p>\n<p>- Gạc có vị ngọt dịu, phù hợp cho cả trẻ sơ sinh và trẻ nhỏ.</p>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/15/16/fb/88c36c71adbce740bc25d67399be01f1.jpg\" alt=\"1516fbe9164de723b731611781720549.jpg\" /></p>\n<p> </p>\n<p>Đối với trẻ em đang là những mầm non nhỏ bé cần được nâng niu, hiểu được điều đó Dk Pharma đã tạo ra những sản phẩm an toàn, chất lượng cao cấp nhất và mang đến những sự tiện dụng nhất cho ba mẹ. Gạc rơ lưỡi Elemis được tạo ra để mang đến sự mềm mại, dịu nhẹ cho bé  giúp bé có cảm giác thoải mái khi vệ sinh răng miệng, vừa tốt cho con, vừa tiện dụng cho mẹ.</p>\n<h3>Thành phần xanh và lành của gạc rơ lưỡi thảo dược Elemis</h3>\n<p>Mỗi rơ lưỡi Elemis được tẩm bởi: Dịch chiết rau ngót, Dịch chiết chè xanh, Dịch chiết hẹ, Hương dưa lưới, Xylitol, NaCl, NaHCO3.</p>\n<p>- Dịch chiết rau ngót (Sauropus androgynus extract): có tác dụng kháng khuẩn, chống viêm, loại bỏ vi khuẩn trong khoang miệng</p>\n<p>- Dịch chiết chè xanh (Camellia sinensis extract): Làm sạch, kháng khuẩn và phòng chống tưa lưỡi</p>\n<p>- Dịch chiết hẹ (Allium ramosum extract): có tác dụng chống tưa lưỡi, nấm miệng, viêm nướu</p>\n<p>- Hương dưa lưới (Hami melon flavour): mùi thơm dễ chịu giúp bé “hợp tác hơn”</p>\n<p>- Xyliton: Chống sâu răng, sún răng, làm sạch mảng bám trong miệng</p>\n<p>- NaCl: Có tác dụng làm sạch các mảng bám, cặn sữa, thức ăn</p>\n<p>- NaHCO3: Chống nấm giúp chữa nấm lưỡi, nấm miệng</p>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/0b/db/1c/87038703a1a54362616d5313be804095.jpg\" alt=\"0bdb1cefc73e0af6d00c0768050bdeec.jpg\" /></p>\n<p> </p>\n<h3>Công dụng sản phẩm:</h3>\n<p>- Gạc vệ sinh răng miệng giúp làm sạch khoang miệng, hạn chế các vấn đề về răng miệng gồm: lưỡi, nướu, răng, túi má cho trẻ từ sơ sinh. Hỗ trợ các vấn đề về răng miệng như nấm lưỡi, tưa lưỡi, hôi miệng, sưng đỏ nướu,…</p>\n<p>- Loại bỏ mảng bám, cặn sữa, thức ăn và vi khuẩn trong khoang miệng, sâu răng, mủn răng cho bé.</p>\n<p>- Giúp nướu khỏe, giảm cảm giác đau khi mọc răng ở trẻ hạn chế tình trạng răng của bé mọc lên không đều sau này.</p>\n<h3>Đối tượng sử dụng:</h3>\n<p>- Trẻ sơ sinh và trẻ nhỏ đang ăn sữa, ăn dặm có nguy cơ gặp các vấn đề về răng miệng.</p>\n<p>- Trẻ đang mọc răng hoặc đã mọc răng nhưng chưa biết tự vệ sinh răng miệng.</p>\n<p><img src=\"https://salt.tikicdn.com/ts/product/1e/bb/68/25188bc4d4e180b0cef207407cffeb1c.jpg\" alt=\"1ebb681f89d8f0497772fe867fa3e43e.jpg\" /></p>\n<h3>Hướng dẫn sử dụng:</h3>\n<p>Bước 1: Rửa sạch tay bằng xà phòng trước khi sử dụng.</p>\n<p>Bước 2: Cho ngón tay trỏ vào bên trong gạc. Nhẹ nhàng vệ sinh khoang miệng cho bé, từ lưỡi, nướu, răng, đến 2 bên túi má.</p>\n<p>Lưu ý khi sử dụng gạc rơ lưỡi Elemis</p>\n<p>- Sử dụng ngay khi mở bao bì và không tái sử dụng</p>\n<p>- Để ngoài tầm với của trẻ</p>\n<p>Bảo quản gạc rơ lưỡi Elemis </p>\n<p>- Bảo quản nơi khô ráo, thoáng mát, tránh ánh nắng mặt trời trực tiếp</p>\n<p>Tên sản phẩm: Gạc Rơ Lưỡi Thảo Dược Elemis – Dk Pharma</p>\n<p>Thương hiệu: Dk Pharma</p>\n<p>Đóng gói: Hộp 30 gói</p>\n<p>Bảo quản: Nơi khô ráo, thoáng mát, tránh ánh nắng trực tiếp</p>\n<p>Hạn sử dụng: 24 tháng</p>\n<p>Xuất xứ: Việt Nam</p>\n</article><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/0b/db/1c/25beca9928b19e0677462fa0188ea291.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0b/db/1c/25beca9928b19e0677462fa0188ea291.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/0b/db/1c/25beca9928b19e0677462fa0188e