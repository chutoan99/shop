20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":2401000,"discount_rate":44,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/media/catalog/product/c/r/crp-g1015m.u2769.d20160929.t153933.489866.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":0,"all_time_quantity_sold":8,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003eKiểu dáng năng động, hiện đại\u003c/h3\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eNồi cơm áp suất điện tử Cuckoo CRP-G1015M có thiết kế màu đỏ - trắng năng động, kiểu dáng hiện đại, mang đến sự sang trọng và tiện nghi cho không gian bếp của bạn. Thiết kế vỏ nồi dày bằng nhựa trơn bóng, hạn chế sự bám bẩn và bụi, giúp bạn vệ sinh dễ dàng sau khi sử dụng.\u003c/p\u003e\r\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Nồi Cơm Áp Suất Điện Tử Cuckoo CRP-G1015M - 1.8L (Đỏ)\" src=\"http://tikicdn.com/media/catalog/product/1/8/1891670758372-1.u3060.d20170118.t165826.791029.jpg\" alt=\"Nồi Cơm Áp Suất Điện Tử Cuckoo CRP-G1015M - 1.8L (Đỏ)\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\r\n\u003ch3\u003eLòng nồi bằng gang chống dính\u003c/h3\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eRuột nồi được làm từ chất liệu gang tráng men chống dính, chắc chắn, bền bỉ và tuyệt đối an toàn cho sức khỏe người dùng. Chất liệu có khả năng truyền nhiệt tốt, giúp nấu cơm ngon, hạt cơm chín đều, không dính vào lòng và thành nồi.\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eHai bên thành còn được trang bị tay cầm cách nhiệt, giúp bạn dễ dàng di chuyển nồi cơm một cách dễ dàng.\u003c/p\u003e\r\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Nồi Cơm Áp Suất Điện Tử Cuckoo CRP-G1015M - 1.8L (Đỏ)\" src=\"http://tikicdn.com/media/catalog/product/1/8/1891670758372-2.u3060.d20170118.t165826.825591.jpg\" alt=\"Nồi Cơm Áp Suất Điện Tử Cuckoo CRP-G1015M - 1.8L (Đỏ)\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\r\n\u003ch3\u003eDung tích 1.8L và nhiều chế độ nấu\u003c/h3\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eNồi cơm áp suất điện tử Cuckoo CRP-G1015M có dung tích 1.8 lít, tương ứng với 2.4kg gạo, đáp ứng nhu cầu sử dụng cho gia đình từ 4 - 6 thành viên. Bên cạnh đó, nồi cơm chính hãng Cuckoo còn trang bị nhiều chế độ nấu khác nhau, không chỉ nấu được cơm mà còn có thể nấu cháo, hâm nóng, hầm thịt,... vô cùng tiện lợi và tiết kiệm thời gian.\u003c/p\u003e\r\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Nồi Cơm Áp Suất Điện Tử Cuckoo CRP-G1015M - 1.8L (Đỏ)\" src=\"http://tikicdn.com/media/catalog/product/1/8/1891670758372-3.u3060.d20170118.t165826.856308.jpg\" alt=\"Nồi Cơm Áp Suất Điện Tử Cuckoo CRP-G1015M - 1.8L (Đỏ)\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\r\n\u003ch3\u003e3 mâm nhiệt với công suất 1150W\u003c/h3\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eVới công suất hoạt động 1150W và hệ thống 3 mâm nhiệt: từ nắp nồi xuống, từ dưới lên và quanh thành nồi giúp cơm nấu nhanh, chín đều, hạt cơm không bị nát, tơi xốp, thơm ngon.\u003c/p\u003e\r\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Nồi Cơm Áp Suất Điện Tử Cuckoo CRP-G1015M - 1.8L (Đỏ)\" src=\"http://tikicdn.com/media/catalog/product/1/8/1891670758372-4.u3060.d20170118.t165826.890535.jpg\" alt=\"Nồi Cơm Áp Suất Điện Tử Cuckoo CRP-G1015M - 1.8L (Đỏ)\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\r\n\u003ch3\u003eBảng điều khiển điện tử tiện lợi\u003c/h3\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eSản phẩm trang bị bảng điều khiển điện tử tiện lợi, giúp bạn dễ dàng quan sát quá trình nấu để lựa chọn các chức năng, chế độ phù hợp. Ngoài ra, màn hình hiển thị thời gian vô cùng hiện đại, bạn có thể biết được món ăn đã nấu được bao lâu và khi nào thì kết thúc quá trình nấu.\u003c/p\u003e\r\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Nồi Cơm Áp Suất Điện Tử Cuckoo CRP-G1015M - 1.8L (Đỏ)\" src=\"http://tikicdn.com/media/catalog/product/1/8/1891670758372-5.u3060.d20170118.t165826.918291.jpg\" alt=\"Nồi Cơm Áp Suất Điện Tử Cuckoo CRP-G1015M - 1.8L (Đỏ)\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\r\n\u003ch3\u003eChế độ hẹn giờ nấu\u003c/h3\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eNồi cơm áp suất điện tử Cuckoo CRP-G1015M còn trang bị chế độ cài đặt giờ, chế độ hẹn giờ nấu, giúp bạn tiết kiệm nhiều thời gian cho cuộc sống.\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eMột tính năng nổi trội nữa của dòng sản phẩm này đó chính là chức năng nấu cơm nhanh, nên bất kể dù bận rộn bạn vẫn có thể chuẩn bị bữa ăn ngon cho gia đình.\u003c/p\u003e\r\n\u003ch3\u003eMột số đặc điểm tiện dụng khác\u003c/h3\u003e\r\n\u003cp\u003e- Nắp thoát hơi chống tràn thông minh, giữ lại nhiều vitamin có sẵn trong gạo.\u003c/p\u003e\r\n\u003cp\u003e- Khóa an toàn không cho phép người dùng mở nắp khi đang nấu hoặc còn áp suất trong nồi.\u003c/p\u003e\r\n\u003cp\u003e- Ngăn chứa nước thừa dễ dào tháo rời và vệ sinh.\u003c/p\u003e\r\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;