reeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":3,"review_text":"(3)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/2a/f0/5d/eb4b42bb073a51ef45f63d63cb80d6ba.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":546,"all_time_quantity_sold":41,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e \u003c/p\u003e\n\u003ch1 style=\"text-align:center;\"\u003e\u003cstrong\u003eFlashcard 100 đoạn hội thoại song ngữ Anh – Việt\u003c/strong\u003e\u003c/h1\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/e8/3e/24/e6d66aea78b8eb262baec088d10c1632.png\" alt=\"\" width=\"750\" height=\"826\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eTiếng Anh được xem là ngôn ngữ phổ biến nhất tuy nhiên việc học tiếng Anh sao cho hiệu quả lại là vấn đề của rất nhiều người Việt Nam.\u003c/p\u003e\n\u003cp\u003e• Bạn học tiếng Anh nhiều năm nhưng vẫn chưa biết cách giao tiếp?\u003c/p\u003e\n\u003cp\u003e• Bạn chưa phản xạ nhanh nhạy, chưa biết cách áp dụng vào thực tế?\u003c/p\u003e\n\u003cp\u003e• Bạn không biết nói sao để phù hợp với ngữ cảnh?\u003c/p\u003e\n\u003cp\u003eVới bộ thẻ học Flashcard 100 đoạn hội thoại song ngữ Anh – Việt, học tiếng Anh chưa bao giờ đơn giản đến vậy. Sản phẩm được Kỷ lục gia Siêu trí nhớ Thế giới, Chủ tịch Tổ chức Trí nhớ Việt Nam, Thầy Nguyễn Phùng Phong biên soạn, bao gồm 100 mẫu hội thoại thông dụng với nhiều chủ đề thường gặp trong cuộc sống. Flashcard 100 đoạn hội thoại song ngữ Anh – Việt với những ưu điểm nổi bật sẽ giúp chúng ta:\u003c/p\u003e\n\u003cp\u003e• Học nhanh chóng và dễ dàng ứng dụng vào những tình huống giao tiếp thực tế\u003c/p\u003e\n\u003cp\u003e• Chủ đề với độ khó tăng dần, giúp cải thiện kĩ năng, vận dụng các kĩ thuật ghi nhớ vào quá trình học tiếng Anh\u003c/p\u003e\n\u003cp\u003e• Dễ dàng học tập, tra cứu nhờ kết hợp song ngữ Anh - Việt mà không cần sử dụng thêm một công cụ khác\u003c/p\u003e\n\u003cp\u003e• Cách trình bày khoa học, ngắn gọn, dễ hiểu, hình thức trình bày đẹp mắt với những bức tranh minh họa gần gũi, sinh động tạo cảm hứng học tập.\u003c/p\u003e\n\u003cp\u003eSản phẩm do Nhà xuất bản Đại học Quốc gia TP Hồ Chí Minh xuất bản.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/2a/f0/5d/eb4b42bb073a51ef45f63d63cb80d6ba.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/2a/f0/5d/eb4b42bb073a51ef45f63d63cb80d6ba.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/2a/f0/5d/eb4b42bb073a51ef45f63d63cb80d6ba.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2a/f0/5d/eb4b42bb073a51ef45f63d63cb80d6ba.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2a/f0/5d/eb4b42bb073a51ef45f63d63cb80d6ba.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/e8/3e/24/6c4f7a7271ae59a35ae832c0f1facff9.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e8/3e/24/6c4f7a7271ae59a35ae832c0f1facff9.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e8/3e/24/6c4f7a7271ae59a35ae832c0f1facff9.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e8/3e/24/6c4f7a7271ae59a35ae832c0f1facff9.p