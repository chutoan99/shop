t_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/7a/03/a5/824f04899d8405e3a572183de16f5cce.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1169,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003e\u003cem\u003e*Lưu ý: Bao bì sản phẩm có thể thay đổi theo từng đợt nhập hàng và Sản phẩm được giao mẫu bao bì ngẫu nhiên.\u003c/em\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cstrong\u003eSữa rửa mặt Senka dành cho da mụn Perfect Whip Acne Care 100g\u003c/strong\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003eCó công thức cải tiến tạo bọt cực mịn và đàn hồi như một mạng lưới giúp rửa sạch hoàn hảo trên bề mặt da và cả bên trong lỗ chân lông, cho làn da sạch tinh khiết, trắng sáng. Ngoài ra, sản phẩm còn chứa chiết xuất hoa Cúc Cam vùng Kyoto Nhật Bản giúp da kháng khuẩn, chống oxy hóa, cung cấp độ ẩm cần thiết và trả lại sự mịn màng cho làn da. Sản phẩm được chứng minh lâm sàng, giảm mụn đáng kể chỉ sau 4 tuần.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/05/ec/48/cbdc708616ca58c4f02818f0c62c704c.jpg\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTHÔNG TIN SẢN PHẨM\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e*Công dụng\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Làm sạch bụi bẩn, bã nhờn, tế bào da chết nằm sâu trong lỗ chân lông, giúp giảm nhờn, bóng dầu, bảo vệ da trước những tác nhân gây mụn\u003c/p\u003e\n\u003cp\u003e- Giúp da kháng khuẩn, chống oxi hóa, thanh lọc làn da\u003c/p\u003e\n\u003cp\u003e- Cung cấp độ ẩm cho làn da sạch thoáng, ẩm mịn \u0026amp; sáng rạng rỡ\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/1c/96/10/c3d0bf6f1891402a7e85ff4022e2b1f4.jpg\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e*Thành phần:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Salicylic Acid: Làm sạch sâu và cuốn sạch bụi bẩn, bã nhờn, tế bào chết, phấn trang điểm bịt kín lỗ chân lông và gây mụn cho làn da sạch, rạng rỡ.\u003c/p\u003e\n\u003cp\u003e- Chiết xuất từ Cúc Cam Kyoto giúp chống viêm nhiễm và oxi hóa, ngăn chặn tác nhân gây hại, làm dịu da và tăng sức đề kháng cho da.\u003c/p\u003e\n\u003cp\u003e- Tinh chất tơ tằm trắng cùng với công thức gấp đôi Hyaluronic acid duy trì lớp màng dưỡng ẩm tự nhiên giúp da sáng mịn và mềm mượt\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e*Loại da thích hợp:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Thích hợp cho da mụn, dầu\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e*Hướng dẫn sử dụng:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Lấy một lượng vừa đủ (khoảng 3-4 lần ấn) ra lòng bàn tay\u003c/p\u003e\n\u003cp\u003e- Mát-xa mặt với bọt\u003c/p\u003e\n\u003cp\u003e- Rửa lại thật sạch với nước\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/24/48/5e/f504d56e5c28893e51f02256b04aad18.jpg\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e*Hướng dẫn bảo quản:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Không sử dụng sản phẩm đã hết hạn.\u003c/p\u003e\n\u003cp\u003e- Rửa ngay với nước nếu sản phẩm rơi vào mắt.\u003c/p\u003e\n\u003cp\u003e- Ngưng sử dụng và hỏi ý kiến bác sĩ da liễu nếu da kích ứng.\u003c/p\u003e\n\u003cp\u003e- Không để sản phẩm trực tiếp dưới nắng.\u003c/p\u003e\n\u003cp\u003eNgày sản xuất: Xem NSX trên bao bì sản phẩm (Ngày/Tháng/Năm)\u003c/p\u003e\n\u003cp\u003eHạn sử dụng: 3 năm kể từ NSX\u003c/p\u003e\n\u003cp\u003eXuất xứ thương hiệu: Nhật Bản\u003c/p\u003e\n\u003cp\u003eNơi sản xuất: Nhật Bản\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTHÔNG TIN THƯƠNG HIỆU\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eRa đời năm 2002 tại Nhật Bản, nhãn hiệu Senka thừa hưởng lịch sử 140 năm của Tập đoàn Shiseido để mang đến những sản phẩm dưỡng da hiệu quả và an toàn với làn da phụ nữ châu Á. Với sản phẩm đại diện Senka Perfect Whip đứng đầu thị trường sữa rửa mặt Nhật Bản trong 7 năm liền (từ 2008 đến 2015), Senka mong muốn chăm sóc những người phụ nữ bận rộn một cách hiệu quả và tinh tế nhất.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/f8/47/dc/bbe240576969a28baddaa2e1de14abae.jpg\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/7a/03/a5/824f04899d8405e3a572183de16f5cce.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/7a/03/a5/824f04899d8405e3a572183de16f5cce.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/7a/03/a5/824f04899d8405e3a572183de16f5cce.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7a/03/a5/824f04899d8405e3a572183de16f5cce.jpg","thum