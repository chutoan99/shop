ement":"pdp_badge","code":"text_badge","type":"text_badge","index":0,"icon":null,"icon_width":0,"icon_height":0,"text_color":"#FFF0F1","background_color":"#D93843","href":null,"text":"9.9"},{"placement":"pdp_badge","code":"is_hero","type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"freeship_xtra","type":"pdp_icon_badge","index":2,"icon":"https://salt.tikicdn.com/ts/upload/be/67/48/04a82ab8df178e1a13bde38316081865.png","icon_width":91,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":true,"return_reason":"any_reason"}},"discount":158000,"discount_rate":35,"rating_average":4.8,"review_count":141,"review_text":"(141)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ca/e4/99/8dc28b0c8068327faa2fb9a593854a1e.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1188,"all_time_quantity_sold":678,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eTruyện ngắn Nguyễn Huy Thiệp (Với minh họa của các họa sĩ) được in lại theo bản năm 2007 cũng do Đông A xuất bản, nhân kỷ niệm 70 năm ngày sinh tác giả (1950 - 2020). Các truyện trong sách do chính nhà văn tuyển lựa, sắp xếp theo thứ tự thời gian. Trong bản in năm 2007, nhà văn Nguyễn Huy Thiệp đã liên tài, mời nhiều họa sĩ đương đại vẽ minh họa cho tập sách. Trong bản in mới năm 2020, bạn đọc sẽ gặp lại đa phần minh họa của các họa sĩ đương đại Việt Nam. Ngoài ra, để làm mới cuốn sách, chúng tôi quyết định mời thêm một số họa sĩ vẽ minh họa mới cho các truyện ngắn vốn rất nổi tiếng của nhà văn Nguyễn Huy Thiệp, đồng thời lược bỏ một vài minh họa trong bản in trước.\u003c/p\u003e\n\u003cp\u003eĐặc biệt khác hơn, phần cuối sách có thêm bài Nói chuyện một mình. Đây là bài được nhà văn Nguyễn Huy Thiệp viết trước Tết Nguyên đán Canh Tý (2020), ở đó, thông qua việc trả lời những câu hỏi, ông gửi gắm suy nghiệm về nghề văn của mình:\u003c/p\u003e\n\u003cp\u003e“Hỏi: Anh là ai?\u003c/p\u003e\n\u003cp\u003eĐáp: Tôi là một dạng ăn may, một nhà văn may mắn gặp thời. Tôi gặp được toàn những người rất tốt. Tôi ăn may…”\u003c/p\u003e\n\u003cp\u003eTruyện ngắn Nguyễn Huy Thiệp (Ấn bản kỷ niệm 70 năm ngày sinh tác giả - Với minh họa của các họa sĩ) gồm 42 tác phẩm, xếp theo trình tự thời gian sáng tác, bắt đầu từ “Những ngọn gió Hua Tát” (Mười truyện trong bản nhỏ, sáng tác 1971 - 1986), kết thúc với “Quan Âm chỉ lộ” sáng tác năm 2004. Tập truyện cho thấy sở trường truyện ngắn của nhà văn Nguyễn Huy Thiệp với mảng đề tài đa dạng gồm lịch sử và văn học, hơi hướng huyền thoại và cổ tích, xã hội Việt Nam đương đại, xã hội làng quê và những người lao động.\u003c/p\u003e\n\u003cp\u003eSách in bìa cứng, có bìa áo metalize, khổ lớn 18,5 x 26,5 cm. Bìa sách được thực hiện theo ý tưởng là một bảng màu với các chấm xen kẽ những trích đoạn tranh minh họa của 13 họa sĩ đương đại Việt Nam.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ca/e4/99/8dc28b0c8068327faa2fb9a593854a1e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ca/e4/99/8dc28b0c8068327faa2fb9a593854a1e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ca/e4/99/8dc28b0c8068327faa2fb9a593854a1e.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ca/e4/99/8dc28b0c8068327faa2fb9a593854a1e.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ca/e4/99/8dc28b0c8068327faa2fb9a593854a1e.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/90/a2/24/508a23e10b6fcb09471f5c2486959b59.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/90/a2/24/508a23e10b6fcb09471f5c2486959b59.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/90/a2/24/508a23e10b6fcb09471f5c2486959b59.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/90/a2/24/508a23e10b6fcb09471f5c2486959b59.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/90/a2/24/508a23e10b6fcb09471f5c2486959b59.jpg"}],"warranty_policy":null,"authors":[{"id":10474,"name":"Nguyễn Huy Thiệp","slug":"nguyen-huy-thiep"}],"current_seller":{"id":1,"sku":"5629865815143","name":"Tiki Trading","link":"https://tiki.vn/cua-hang/tiki-trading","logo":"d1/3f/ae/13ce3d83ab6b6c5e77e6377ad61dc4a5.jpg","price":292000,"product_id":"104935829","store_id":40395,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[{"id":670,"name":"Cá Chép Bookstore","link":"https://tiki.vn/cua-hang/ca-chep-bookstore","logo":"0a/89/1c/28dd476ede7a32391ad449d0f0c9c403.jpg"