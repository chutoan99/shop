count":0,"discount_rate":0,"rating_average":4.2,"review_count":6,"review_text":"(6)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/bd/08/51/da06acd3cfa862aa4fa8db5deba6fb4b.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":0,"all_time_quantity_sold":86,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align:justify;\"\u003e\u003cspan style=\"color:#ff6600;font-size:medium;\"\u003e\u003cstrong\u003eThông Minh Cảm Xúc Thế Kỷ 21 (Phiên Bản Mới Của EQ 2.0)\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\"Một quyển sách súc tích với những câu chuyện đầy sức thuyết phục cùng nội dung hấp dẫn giúp bạn thấu hiểu và cải thiện mình\" - \u003cstrong\u003eNewsweek\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\"Các phương pháp rất đáng xem về những kỹ năng trí tuệ cảm xúc đã biến cuốn sách này thành cuốn cẩm nang nổi bật nhất trong tuần cảu chúng tôi. Thật vui khi biết rằng chỉ số thông minh (IQ) trung bình của một người không giới hạn người đó ở mức thành tích trung bình\" - \u003cstrong\u003eNewsday\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\"Trí tuệ cảm xúc là một kỹ năng đặc biệt quan trọng để thành công trong sự nghiệp và cuộc sống. Đây là một quyển sách tuyệt vời mà bạn nên đọc\" - \u003cstrong\u003eKen Blanchard\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e15 phương pháp giúp bạn nâng cao kỹ năng tự nhận thức\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e17 phương pháp giúp bạn rèn luyện kỹ năng làm chủ bản thân\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e17 phương pháp giúp bạn mài giũa kỹ năng nhận thức xã hội\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e17 phương pháp giúp bạn tăng cường kỹ năng làm chủ mối quan hệ\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003eCó cả thảy 66 phương pháp cho bạn thỏa sức áp dụng vào cuộc sống hàng ngày, và quan sát EQ của mình tăng dần tăng dần để gặt hái những thành quả xứng đáng. Muốn thực hành tốt thì phải hiểu, do đó, cuốn sách \u003cstrong\u003eThông Minh Cảm Xúc\u003c/strong\u003e của hai tác giả \u003cstrong\u003eTravis Bradberry \u0026amp; Jean Greaves\u003c/strong\u003e là bộ cẩm nang toàn tập không thể thiếu cho những ai muốn hạnh phúc và thành công hơn thông qua việc tăng cường EQ của mình.\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/bd/08/51/da06acd3cfa862aa4fa8db5deba6fb4b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/bd/08/51/da06acd3cfa862aa4fa8db5deba6fb4b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/bd/08/51/da06acd3cfa862aa4fa8db5deba6fb4b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/bd/08/51/da06acd3cfa862aa4fa8db5deba6fb4b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/bd/08/51/da06acd3cfa862aa4fa8db5deba6fb4b.jpg"},{"base_url":"https://salt.tikicdn.com/media/catalog/product/t/h/thong-minh-cam-xuc.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/t/h/thong-minh-cam-xuc.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/t/h/thong-minh-c