ll,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.7,"review_count":229,"review_text":"(229)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/1f/7d/1f/801a353ae123e27bfb4e49375e52f83d.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1813,"all_time_quantity_sold":952,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch1 class=\"item-name\" style=\"text-align:center;\"\u003e\u003cspan style=\"color:#ff0000;\"\u003eKính Bơi Nam Nữ Cao Cấp miDoctor\u003c/span\u003e\u003c/h1\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cspan style=\"color:#0000ff;\"\u003eHàng Chính Hãng Đảm Bảo Tuyệt Đối Chất Lượng \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003eBộ sản phẩm đầy đủ gồm 01 kính bơi và 01 đôi nhét tai chống nước, 1 hộp đựng kính bơi cao cấ\u003c/p\u003e\n\u003cp\u003eCó 2 loại: \u003cstrong\u003eKính Bơi có bịt tai\u003c/strong\u003e và \u003cstrong\u003eKính Bơi Không có bịt tai\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eKính Bơi cao cấp miDoctor\u003c/strong\u003e là sản phẩm chuyên dùng cho bộ môn bơi lội với khả năng chống mờ, tia UV bảo vệ đôi mắt của bạn tối đa khi sử dụng. Chất liệu nhựa cứng Polycarbonat cùng với silicone mềm dẻo, không độc hại đối với sức khoẻ của người dùng. Thiết kế của kính bơi đẹp mắt với  những đường vát cong tinh tế, phù hợp để sử dụng trong thi đấu, bơi lội thông thường khi đi biển, du lịch.\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eLớp tráng phủ chống mờ và tia UV gây hại cho mắt\u003c/li\u003e\n\u003cli\u003eChất liệu nhựa Polycarbonat cùng silicone mềm dẻo\u003c/li\u003e\n\u003cli\u003eThiết kế cao cấp, tiện ích\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e \u003c/p\u003e\n\u003cul\u003e\u003cli style=\"text-align:center;\"\u003e\u003ciframe src=\"//www.youtube.com/embed/gGFBh6OxqQo\" width=\"560\" height=\"314\" allowfullscreen=\"\"\u003e\u003c/iframe\u003e\u003c/li\u003e\n\u003c/ul\u003e\u003cp style=\"text-align:center;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cstrong\u003eBề mặt của kính được tráng phủ một lớp chất liệu đặc biệt có khả năng chống mờ bởi hơi nước, giữ cho kính luôn được trong suốt, đảm bảo tầm nhìn khi bơi lặn. Lớp tráng phủ còn có khả năng phản chiếu được tia UV gây hại cho mắt, từ đó hạn chế tình trạng mắt bị chói và khó chịu trong khi bơi\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cstrong\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ea/31/a0/a5b0025e52661dd162c2f703ae074a82.jpg\" alt=\"\" width=\"750\" height=\"1050\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/26/28/5f/509df1f41eaa45d74b7009201d9540e5.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cstrong\u003eKính bơi miDoctor được đựng trong hộp nhựa cao cấp\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003eMở nắp hộp với Kính bơi thường bằng nút gờ ở giữa hộp, Đối với hộp kính bịt tai thì xoay nút vặn đen ở phần ngoài nắp hộp kính\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cstrong\u003eSản phẩm có phần tròng kính được làm từ chất liệu nhựa trong suốt Polycarbonat cho độ bền cao, độ trong suốt của kính sẽ đảm bảo được tầm nhìn rõ ràng của bạn trong khi bơi. Các chi tiết như dây đeo, vành bảo vệ được làm từ chất liệu silicone dùng trong y khoa, mềm dẻo và đảm bảo an toàn, không gây kích ứng đáng kể cho cả người có làn da nhạy cảm\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cstrong\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/9e/8e/24/fe8f54d7fcb534cfd8ec731a0c5a5004.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/9e/8e/24/96554b9583c56f9d57c39b80437ba541.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/17/60/7d/0044574ea8f1c4818290fbd840fd0a34.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/b1/48/7b/6cf6241c94f2174da7c50c2cec3f2646.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cstrong\u003eKính Bơi miDoctor dẻo dai tuyệt đối\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/e9/2f/1b/779ba23e146848ce2efbe2b45757057a.PNG\" alt=\"\" width=\"750\" height=\"388\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/72/39/97/fa5900f049ee79521f014d09aff0730e.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align