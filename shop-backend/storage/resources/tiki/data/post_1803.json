_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":58000,"discount_rate":50,"rating_average":5,"review_count":38,"review_text":"(38)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/b0/f9/dc/257e0d39c5fd59cc7a82417c25475707.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1000,"all_time_quantity_sold":284,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003e★\u003c/strong\u003e\u003cstrong\u003e \u003c/strong\u003e\u003cstrong\u003eĐứng đầu dòng sách tản văn năm 2020 tại Hàn Quốc\u003c/strong\u003e\u003cbr /\u003e\u003cstrong\u003e★\u003c/strong\u003e\u003cstrong\u003e \u003c/strong\u003e\u003cstrong\u003eVượt hơn 200.000 bản năm 2020\u003c/strong\u003e\u003cbr /\u003e\u003cstrong\u003e★\u003c/strong\u003e\u003cstrong\u003e \u003c/strong\u003e\u003cstrong\u003eĐã được mua bản quyền tại 5 quốc gia như Nhật Bản, Đài Loan, Thái Lan…\u003cbr /\u003e★ Quyển sách Yunho (DBSK - TVXQ) luôn mang bên mình\u003cbr /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eĐạt được 1.000% tài trợ của dự án Tumplbug! Quyển sách đã gây được tiếng vang lớn từ trước khi được xuất bản!\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eCó rất nhiều thứ ta cần trong xã hội này để cảm thấy hạnh phúc: một trường đại học tốt, một công ty tiếng tăm, một mức lương khá, một gia đình ổn định… Chưa hết nha, đến đời con cái cháu chắt chút chít, ta cũng phải xoay sở cho nó vào được một trường đại học tốt, rồi một công ty tiếng tăm, một mức lương khá… Những điều này, liệu mấy ai có khả năng làm được?\u003c/p\u003e\n\u003cp\u003e\u003cem\u003eMột chàng trai sắp lấy vợ, đã ngót nghét 30 tuổi nhưng không có gì trong tay ngoài một khoản tiền vay, và một cô gái 26 tuổi làm công việc freelancer đã ở nhà suốt 2 năm trời \u003c/em\u003e\u003c/p\u003e\n\u003cp\u003eNếu cứ chịu đựng thì điều gì đến rồi cũng sẽ đến, ta biết chứ, thế nên phải hạ quyết tâm thôi: “Chỉ khi nó chấm dứt…”. Nhưng rốt cuộc lúc ta quyết tâm cũng là lúc ta kiệt sức, và cơn trầm cảm quay trở lại. Ta nhận ra rằng chưa có gì chấm dứt thì cũng không sao, ta hãy vui cười mà sống.\u003c/p\u003e\n\u003cp\u003eĐiều mà ta muốn tìm có phải như thế không?\u003c/p\u003e\n\u003cp\u003eNiềm hạnh phúc nhỏ bé khi thoát khỏi hiện thực đúng 1cm. Đây là cách vui cười mà sống bằng những nỗ lực tối thiểu và rủi ro tối thiểu. Chúng ta cùng nhau thực hiện dự án “1cm diving – 1cm đến hạnh phúc” nhé!\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eĐÔI LỜI TỪ CHUYÊN GIA VỀ SÁCH (BOOK SOMMELIER)\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eCuốn sách này là câu chuyện tôi muốn giới thiệu đến những ai đang kiếm tìm hạnh phúc, những ai đang không biết phải làm gì, hay những ai đang cảm thấy “đời mình chẳng có gì vui”, và cả những ai đang phải chịu đựng mớ cảm xúc hỗn độn bên trong mình. Bằng cách trả lời 23 câu hỏi, tôi đã tìm ra chính mình. Và tôi nhận ra là, tôi đã bỏ lỡ “những điều nhỏ bé tưởng chẳng là gì”. Thông qua quyển sách này, tôi muốn hỏi bạn, có phải bạn chỉ đang chịu đựng mà sống không? Gửi đến bạn một thông điệp rằng, nếu không bỏ lỡ “những điều nhỏ bé tưởng chẳng là gì”, có lẽ bạn sẽ trở nên hạnh phúc hơn.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/2e/7f/09/25a32222b7a425e4b7745b4aed651a4f.png\" alt=\"\" width=\"750\" height=\"4110\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/b0/f9/dc/257e0d39c5fd59cc7a82417c25475707.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b0/f9/dc/257e0d39c5fd59cc7a82417c25475707.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b0/f9/dc/257e0d39c5fd59cc7a82417c25475707.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b0/f9/dc/257e0d39c5fd59cc7a82417c25475707.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b0/f9/dc/257e0d39c5fd59cc7a82417c25475707.png"},{"base_url":"https://salt.tikicdn.com/ts/product/ba/e6/60/8c432f2e3d89535eb59a77768592b55a.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ba/e6/60/8c432f2e3d89535eb59a77768592b55a.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ba/e6/60/8c432f2e3d89535eb59a77768592b55a.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ba/e6/60/8c432f2e3d89535eb59a77768592b55a.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ba/e6/60/8c432f2e3d89535eb59a77768592b55a.png"},{"base_url":"https://salt.tikicdn.com/ts/product/ef/8e/7c/c831c5e14e2b83173f163fa2130463bb.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ef/8e/7c/c831c5e14e2b83173f163fa2130463bb.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ef/8e/7c/c831c5e14e2b83173f163fa2130463bb.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ef/8e/7c/c831c5e14e2b83173f163fa2130463bb.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ef/8e/7c/c831c5e14e2b83173f163fa2130463bb.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/99/aa/