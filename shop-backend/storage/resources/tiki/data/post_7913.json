"code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":26000,"discount_rate":12,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/fb/a4/c4/06dde5027165e5fe239723372f30aa94.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1242,"all_time_quantity_sold":16,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eĐẶC ĐIỂM NỔI BẬT CỦA SẢN PHẨM\u003c/strong\u003e\u003c/p\u003e\n\u003cul style=\"text-align: justify;\"\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cstrong\u003eBột Diếp Cá Quảng Thanh\u003c/strong\u003e\u003cspan style=\"font-weight: 400;\"\u003e có nguồn gốc từ trang trại sinh học VietGAP, được trải qua quy trình sấy lạnh hiện đại và nghiền siêu mịn nhằm giữ nguyên vẹn những giá trị quý của diếp cá tươi.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eBột diếp cá rất thơm ngon, vị hơi chua, dễ uống hơn vì không quá hăng và không tanh như khi uống rau diếp cá tươi. Bột được trải qua quy trình tiệt trùng an toàn, đảm bảo không ký sinh trùng và giun sán gây hại. Đặc biệt, em bé từ giai đoạn biết ăn dặm có thể dùng được. \u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cstrong\u003eBột diếp cá Quảng Thanh\u003c/strong\u003e\u003cspan style=\"font-weight: 400;\"\u003e không chứa chất bảo quản, không pha trộn thêm bất kỳ thành phần phụ gia hóa học nào, đảm bảo an toàn tuyệt đối sức khỏe của người dùng.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003e\u003cspan style=\"font-weight: 400;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/3b/2c/05/5d79141250decd910058e32e80d49cb2.png\" alt=\"Bột Diếp Cá Quảng Thanh gói 100g\" width=\"750\" height=\"750\" /\u003e\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003e\u003cspan style=\"font-weight: 400;\"\u003eBột Diếp Cá Quảng Thanh giữ nguyên vẹn những giá trị quý của diếp cá tươi\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eCÔNG DỤNG CỦA SẢN PHẨM\u003c/strong\u003e\u003c/p\u003e\n\u003cul style=\"text-align: justify;\"\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cstrong\u003eBột Diếp Cá Quảng Thanh\u003c/strong\u003e\u003cspan style=\"font-weight: 400;\"\u003e thanh nhiệt, giải độc, cầm máu.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eKhuyên dùng trong trường hợp bị sốt xuất huyết.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eKháng khuẩn, kháng viêm, chống oxy hóa.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eChữa táo bón, mụn nhọt, lở ngứa, trẻ con lên sởi.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eHỗ trợ điều ngăn ngừa bệnh viêm phổi hoặc phổi có mủ.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eDùng cho người bị viêm tai giữa.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eChữa đau mắt đỏ, đau mắt do nhiễm trực khuẩn mủ xanh.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003e\bGiảm trĩ hiệu quả.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eChữa bệnh viêm ruột, kiết lỵ, bí tiểu tiện, kinh nguyệt không đều ở phụ nữ.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eTăng tiết sữa cho mẹ sau sinh, ngăn ngừa sưng tắc tia sữa.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cstrong\u003eBột Diếp Cá Quảng Thanh \u003c/strong\u003e\u003cspan style=\"font-weight: 400;\"\u003edùng cho bệnh nhân viêm xoang mãn tính và polyp mũi.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eKháng virus: diếp cá ức chế virus cúm, virus gây suy giảm miễn dịch ở người loại 1 (HIV-1) nhờ vào các thành phần xeton methyl n-nonyl, aldehyde lauryl và aldehyde capryl.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003e\u003cspan style=\"font-weight: 400;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/e3/6f/ed/6f8d0e0fcf6a8120f7df27e8e0a17645.jpg\" alt=\"Bột Diếp Cá Quảng Thanh gói 100g\" width=\"750\" height=\"750\" /\u003e\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003e\u003cspan style=\"font-weight: 400;\"\u003eBột diếp cá Quảng Thanh kháng viêm, tăng cường tiết sữa\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eTHÔNG TIN CHUNG\u003c/strong\u003e\u003c/p\u003e\n\u003cul style=\"text-align: justify;\"\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eThành phần: 100% lá diếp cá tươi, sấy lạnh tiệt trùng và nghiền siêu mịn.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eHàm lượng chất xơ: trên 10%\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eĐộ ẩm: dưới 5%\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eNgày sản xuất: xem trên bao bì\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eHạn sử dụng: 1 năm kể từ ngày sản xuất\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eCÁCH DÙNG\u003c/strong\u003e\u003c/p\u003e\n\u003cul style=\"text-align: justify;\"\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eDùng để uống: Lấy 2g bột trộn trước với 2 muỗng đường (dùng muỗng sữa chua), thêm một ít nước lọc và khuấy đều cho bột thấm nước và tan. Thêm tiếp đến khi đủ 200ml rồi cho vào ít đá và thưởng thức. Mỗi ngày dùng 2 ly là vừa, trong khi ăn hoặc ngay sau khi ăn. Hạn chế dùng sáng sớm và tối, vì diếp cá có tính mát, dễ làm hạ thân nhiệt. 1 túi 100g pha được 50 ly diếp cá 200ml. (CHÚ Ý: PHA VỚI SỮA ĐẶC SẼ LÀM TĂNG HƯƠNG VỊ, PHA VỚI SỮA TƯƠI LÀM ÁT VỊ DIẾP CÁ.)\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eDùng để đắp mặt: Trộn bột với nước theo tỉ lệ 1: 3 hoặc bột với sữa chua KHÔNG đường theo tỉ lệ 1:2. Đắp buổi tối, tuần 3 lần, mỗi lần 15 phút, sau đó rửa lại bằng nước ấm để mau sạch và không để qua đêm.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eLIỀU DÙNG CHO NGƯỜI LỚN: 1 gram bột pha với 100ml nước, người lớn: 2-4 ly 200ml/ngày\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eLIỀU DÙNG CHO TRẺ:\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"padding-left: 40px; text-align: justify;\"\u003e\u003cspan style=\"font-weight: 400;\"\u003e- Bé 8 tháng đến \u0026lt;1t: 50 – 100ml/ngày.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"padding-left: 40px; text-align: justify;\"\u003e\u003cspan style=\"font-weight: 400;\"\u003e- Bé 1- 3t: 200 – 300ml/ngày.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"padding-left: 40px; text-align: justify;\"\u003e\u003cspan style=\"font-weight: 400;\"\u003e- Bé \u0026gt;3t: 400 – 500ml/ngày. Bé \u0026gt;6t: 600ml/ngày.\u003c/span\u003e\u003c/p\u003e\n\u003cul style=\"text-align: justify;\"\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cem\u003e\u003cspan style=\"font-weight: 400;\"\u003eKHUYẾN CÁO:\u003c/span\u003e\u003c/em\u003e \u003cem\u003e\u003cspan style=\"font-weight: 400;\"\u003ePhụ nữ mang thai 3 tháng đầu không nên dùng diếp cá và rau má do đặc tính mát của 2 loại rau này, trong những tháng tiếp theo có thể dùng để bổ sung chất xơ giảm táo bón, và tốt nhất nên tham khảo ý kiến bác sĩ.\u003c/span\u003e\u003c/em\u003e \u003cem\u003e\u003cspan style=\"font-weight: 400;\"\u003eTránh uống sáng sớm và tối muộn gây lạnh bụng.\u003c/span\u003e\u003c/em\u003e \u003cem\u003e\u003cspan style=\"font-weight: 400;\"\u003eDùng liên tục trong 1 tháng rồi nghỉ 1 tuần là có thể tiếp tục sử dụng sản phẩm.\u003c/span\u003e\u003c/em\u003e\u003cem\u003e\u003cspan style=\"font-weight: 400;\"\u003e \u003c/span\u003e\u003c/em\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cem\u003e\u003cspan style=\"font-weight: 400;\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/6d/a7/00/8d8a05b06f1d3d8892f30a134b6d9f13.jpg\" alt=\"Bột Diếp Cá Quảng Thanh gói 100g\" width=\"750\" height=\"750\" /\u003e\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003e\u003cspan style=\"font-weight: 400;\"\u003eBột Diếp Cá Quảng Thanh bạn của mọi nhà\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eBẢO QUẢN\u003c/strong\u003e\u003c/p\u003e\n\u003cul style=\"text-align: justify;\"\u003e\n\u003cli style=\"font-weight: 400; text-align: justify;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eNơi khô thoáng, tránh tác động của ánh sáng và nhiệt. Tốt nhất nên bảo quản trong ngăn mát tủ lạnh. \u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400; text-align: justify;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eKhóa kín miệng túi sau khi sử dụng. Không nên sang chiết sản phẩm sang hũ nhựa hay lọ thủy tinh để giúp bột không bị biến chất, đảm bảo chất lượng tốt nhất với thời hạn sử dụng được lâu.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/fb/a4/c4/06dde5027165e5fe239723372f30aa94.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/fb/a4/c4/06dde5027165e5fe239723372f30aa94.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/fb/a4/c4/06dde5027165e5fe239723372f30aa94.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x2