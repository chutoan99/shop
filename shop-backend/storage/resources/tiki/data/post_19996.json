ground_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/3b/ab/84/d12e1c2ef568881894781089ac6b1e1b.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":624,"all_time_quantity_sold":15,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eMáy mài góc dùng pin 118V dùng loại pin lithium-ion để hoạt động, model này có khả năng mài/cắt kim loại mạnh mẽ không hề thua kèm các máy dùng điện. Máy mài góc pin có phần tay cầm gọn, ôm trọn lòng bàn tay mang lại cảm giác thoải mái khi sử dụng trong 1 thời gian dài, lớp vỏ của máy được làm từ nhựa cao cấp, có thể chịu lực tốt, nếu chẳng may làm rơi máy xuống đất thì cũng chẳng sao.\u003c/p\u003e\n\u003cp\u003e1. ƯU ĐIỂM CỦA DÒNG MÁY MÀI GÓC DÙNG PIN 118V LÀ:\u003c/p\u003e\n\u003cp\u003e- Sử dụng động cơ BL Motor (không chổi than) giúp máy luôn hoạt động mạnh mẽ và có tuổi thọ sử dụng cao.\u003c/p\u003e\n\u003cp\u003e- Máy mài pin 118V có tốc độ không tải từ 3000 - 8500 vòng/phút đáp ứng được nhu cầu sử dụng chuyên nghiệp.\u003c/p\u003e\n\u003cp\u003e- Khỏi động êm\u003c/p\u003e\n\u003cp\u003e- Sử dụng pin Lithium-Ion\u003c/p\u003e\n\u003cp\u003e- Pin có báo đèn\u003c/p\u003e\n\u003cp\u003e- Đế sạc tiện lợi\u003c/p\u003e\n\u003cp\u003e- Đường kính đĩa mài/cắt: 100mm\u003c/p\u003e\n\u003cp\u003e- Tốc độ không tải: 3000-8500v/p\u003c/p\u003e\n\u003cp\u003e- Bảo hành: 12 tháng thân máy\u003c/p\u003e\n\u003cp\u003e- Trọng lượng máy: ~2.2 kg\u003c/p\u003e\n\u003cp\u003e- Xuất xứ: Trung Quốc theo dây chuyển của (JAPAN)\u003c/p\u003e\n\u003cp\u003e- Bảo hành 12 tháng\u003c/p\u003e\n\u003cp\u003eMáy mài góc dùng pin 118V là loại máy mài pin không chổi than sử dụng pin Lithium-ion siêu bền, thời gian sạc 60 phút là có thể sử dụng đáp ứng được nhu cầu sử dụng liên tục, thời gian hoạt động pin dài lâu, sạc nhanh ít gián đoạn khi làm việc.\u003c/p\u003e\n\u003cp\u003eĐặc biệt, trọn bộ sản phẩm bao gồm 2 pin giúp bạn có thể thay thế để sạc và sử dụng, đảm bảo tính liên tục trong công việc, không gây gián đoạn giữa chừng, đảm bảo hiệu suất làm việc.\u003c/p\u003e\n\u003cp\u003e2. THÔNG TIN BẢO HÀNH:\u003c/p\u003e\n\u003cp\u003e- Sản phẩm được bảo hành đổi mới 10 ngày nếu lỗi, đảm bảo 1 đổi 1, không sửa chữa.\u003c/p\u003e\n\u003cp\u003e- Bảo hành thân máy 12 tháng đối với lỗi của nhà sản xuất.\u003c/p\u003e\n\u003cp\u003e- Bán hàng, giao hàng tận nơi\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/3b/ab/84/e59a2d92ca8943bb2c7bf765f0578091.jpg\" alt=\"\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/ed/f3/12/8295cb3a36c208486bb3fa0a59923312.png\" alt=\"\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/57/a7/a8/9db1f6ceceb08a8aa13cd8d1162c53b9.jpeg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/8c/ee/a5/d3a6c8c470c8d8a04527130d45c97537.jpg\" alt=\"\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/ef/68/5e/60ca1dd675c03b4170d6355d8f4c84fa.jpg\" alt=\"\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/92/f5/c4/0f46e68828adf7bad0f3a1f2523245e5.jpg\" alt=\"\" width=\"750\" height=\"610\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/e7/92/89/072ea8492fc08db24fda0bc7703876e5.jpg\" alt=\"\" width=\