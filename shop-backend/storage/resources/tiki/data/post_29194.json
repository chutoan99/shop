8be27d7b88c5a290859ea7\" alt=\"3aff058cd78be27d7b88c5a290859ea7\" width=\"1024\" height=\"1085\" /\u003e\u003cimg src=\"https://img.sp.mms.shopee.sg/17d0ebe812a0854bb1d5d1561e7027c9\" alt=\"17d0ebe812a0854bb1d5d1561e7027c9\" width=\"1024\" height=\"1123\" /\u003e\u003cimg src=\"https://img.sp.mms.shopee.sg/d7cca5031e7fb2c9f533cbc96700b8c0\" alt=\"d7cca5031e7fb2c9f533cbc96700b8c0\" width=\"946\" height=\"1096\" /\u003e\u003cimg src=\"https://img.sp.mms.shopee.sg/5b26dec690c0a0e1d3ff4050d34fd87f\" alt=\"5b26dec690c0a0e1d3ff4050d34fd87f\" width=\"1024\" height=\"1010\" /\u003e\u003cimg src=\"https://img.sp.mms.shopee.sg/79583c80ea2c99b01392175ed1ad2e8e\" alt=\"79583c80ea2c99b01392175ed1ad2e8e\" width=\"1024\" height=\"997\" /\u003e\u003cimg src=\"https://img.sp.mms.shopee.sg/d5f5ae09c5ed79f89621b6b2fa58a0dd\" alt=\"d5f5ae09c5ed79f89621b6b2fa58a0dd\" width=\"850\" height=\"898\" /\u003e\u003cimg src=\"https://img.sp.mms.shopee.sg/08a64b7517e70f3e2164ec0c163c467f\" alt=\"08a64b7517e70f3e2164ec0c163c467f\" width=\"1024\" height=\"1235\" /\u003e\u003cimg src=\"https://img.sp.mms.shopee.sg/a0705f9cdc460df1c6269f4fdac598fe\" alt=\"a0705f9cdc460df1c6269f4fdac598fe\" width=\"1024\" height=\"852\" /\u003e\u003cimg src=\"https://img.sp.mms.shopee.sg/fd3423511bf602b4b9dde4d00ed2abed\" alt=\"fd3423511bf602b4b9dde4d00ed2abed\" width=\"879\" height=\"1000\" /\u003e\u003c/p\u003e\n\u003cp\u003eMáy lọc không khí Xiaomi Mi Air Purifier 4 có thiết kế hoàn toàn mới, sử dụng hệ thống lọc 3 trong 1, đơn giản, thanh lịch, đẹp mắt, giống như đồ nội thất gia đình hơn máy lọc không khí, với kích thước nhỏ gọn, bạn dễ dàng để ở bất cứ nơi nào hay di chuyển vào vị trí nào trong ngôi nhà một cách nhẹ nhàng và nhanh chóng.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eHệ thống lõi lọc thế hệ mới\u003c/p\u003e\n\u003cp\u003eThiết kế bộ lọc HEPA thế hệ mới với 5 lớp lọc giúp làm sạch bụi bẩn, khử mùi hiệu quả cao. Lớp lọc đầu tiên lọc các hạt lớn cũng như khói bụi, bụi giấy, bụi gỗ, sợi vải, tóc và lông thú cưng. Lớp thứ hai và thứ ba giúp lọc loại bỏ 99.99% các loại virut và kháng khuẩn như H1N1, Ecoli hay Tụ cầu vàng. Tiếp đến lớp thứ tư là bộ lọc HEPA lọc hạt có đường kính 0,3μm trở lên, bao gồm hạt PM2.5, khói, vẩy da thú cưng, phấn hoa, bông và thậm chí cả vi khuẩn gây bệnh. Lớp cuối cùng được làm bằng than hoạt tính chất lượng cao giúp hấp thụ formaldehyd và các hóa chất độc hại khác, cũng như có thể khử mùi hôi.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eMáy Lọc Không Khí Xiaomi Mi Air Purifier 4 được thiết kế với công suất lọc CADR (Clean Air Delivery Rate) cao, lên đến 400 m3/h cho tốc độ lọc nhanh, lượng không khi sạch mỗi phút đạt 6660L, giúp bạn đã có một bầu không khí trong lành, tươi mát, đem đến cảm giác thoải mái, tỉnh táo, thư giãn tinh thần cho bạn.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eDễ dàng vệ sinh máy lọc nhanh chóng\u003c/p\u003e\n\u003cp\u003eChỉ bằng các thao tác đơn giản, bạn có thể dễ dàng vệ sinh máy lọc một cách nhanh chóng sau một thời gian sử dụng. Bạn chỉ cần dùng tua vít tháo nhẹ phần nắp bảo vệ phía trên và dùng khăn để lau phần cánh quạt một cách dễ dàng, sau đó bạn chỉ cần lắp đặt lại nắp bảo vệ máy lọc là có thể hoàn thành công việc vệ sinh máy.\u003c/p\u003e\n\u003cp\u003eHệ thống màn hình OLED thế hệ mới\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eMáy lọc không khí Mi Air Purufier 4 thế hệ mới kết hợp một màn hình hiển thị chất lượng không khí trong phòng, màn hình OLED để hiển thị nồng độ PM 2.5, nhiệt độ và độ ẩm, kết nối wifi và các chức năng khác cho phép bạn cảm nhận nhiệt độ và độ ẩm một cách trực quan nhất.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eĐể giúp người dùng nắm được thông tin tình trạng không khí trong khu vực phòng, sản phẩm được thiết kế đèn báo hiệu màu tương ứng với 3 cấp độ không khí\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eCảm biến Laser thế hệ mới\u003c/p\u003e\n\u003cp\u003eMáy lọc không khí Mi Air Purifier 4 đã có thêm một cảm biến laser có độ chính xác cao, cảm biến laser trên máy còn có khả năng phát hiện ra những loại bụi bẩn có kích thước chỉ 0.3 micro mét từ đó giúp máy có thể lọc bụi một cách hiệu quả\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/f2/3b/db/f0641ac60d76fc020fdba2a4eb0bdf14.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f2/3b/db/f0641ac60d76fc020fdba2a4eb0bdf14.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f2/3b/db/f0641ac60d76fc020fdba2a4eb0bdf14.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f2/3b/db/f0641ac60d76fc020fdba2a4eb0bdf14.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f2/3b/db/f0641ac60d76fc020fdba2a4eb0bdf14.png"},{"base_url":"https://salt.tikicdn.com/ts/product/66/20/1d/0cefbed17cb8163a9859f1736ba99d42.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/66/20/1d/0cefbed17cb8163a9859f1736ba99d42.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/66/20/1d/0cefbed17cb8163a9859f1736ba99d42.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/66/20/1d/0cefbed17cb8163a9859f1736ba99d42.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/66/20/1d/0cefbed17cb8163a9859f1736ba99d42.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/4f/ff/70/c51af199c66e1023e90692248cd72ca6.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/4f/ff/70/c51af199c66e1023e90692248cd72ca6.jpg","medium_url":"https://salt.tikicdn.com/ca