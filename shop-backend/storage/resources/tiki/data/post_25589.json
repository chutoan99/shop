"index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":true,"return_reason":"any_reason"}},"discount":10000,"discount_rate":6,"rating_average":4.6,"review_count":118,"review_text":"(118)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/77/ed/11/5777ca32ccc0543e5534c16fefb2f234.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1017,"all_time_quantity_sold":543,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eSữa tắm nam hương nước hoa Bergami Savage\u003c/p\u003e\n\u003cp\u003e---------------------------\u003c/p\u003e\n\u003cp\u003eTHƯƠNG HIỆU BERGAMI\u003c/p\u003e\n\u003cp\u003eThương hiệu BERGAMI đã được đăng ký và cấp phép bởi Bộ công thương , đáp ứng đầy đủ các tiêu chuẩn về an toàn, thích hợp với mọi loại da. Thông tin sản phẩm - xuất xứ - sản xuất rõ ràng\u003c/p\u003e\n\u003cp\u003e“SỮA TẮM NƯỚC HOA NAM - 3 TẦNG HƯƠNG BERGAMI SAVAGE SHOWER GEL”\u003c/p\u003e\n\u003cp\u003eTHÀNH PHẦN NỔI BẬT:\u003c/p\u003e\n\u003cp\u003eChamomilla Recutita Flower (cúc la mã), Camellia Sinensis Leaf (chiết xuất trà xanh), niacinamide, Cocamidopropyl Betaine ( chiết xuất dừa), Pearl Powder: Bột ngọc trai - cùng với một số loại thảo dược quý hiếm khá\u003c/p\u003e\n\u003cp\u003eVÌ SAO BẠN SẼ THÍCH?\u003c/p\u003e\n\u003cp\u003eĐặc biệt đây là dòng sản phẩm sữa tắm nam đầu tiên trên thị trường, được chiết xuất 100% từ thiên nhiên và thảo dược quý hiếm, cùng mùi hương nước hoa kiểu Pháp lôi cuốn.\u003c/p\u003e\n\u003cp\u003eDòng sữa tắm Bergami For Man với hai mùi hương phong cách:\u003c/p\u003e\n\u003cp\u003e► Savage: mùi hương nam tính với mùi gỗ mạnh mẽ, phừng phừng khí chất đại trượng phu, để bạn thêm tự tin thể hiện phong cách lịch lãm ở bất cứ nơi đâu.\u003c/p\u003e\n\u003cp\u003e► Shocking man: mùi hương tươi mát, cuốn hút, thuộc hương hoa cỏ phương Đông phù hợp cho những ngày hè sôi động.\u003c/p\u003e\n\u003cp\u003eƯU ĐIỂM NỔI BẬT\u003c/p\u003e\n\u003cp\u003eCảm hứng từ xạ hương lịch lãm và sang trọng. Để diễn tả về mùi xạ hương, không gì hợp hơn sử dụng những hình ảnh phảng phất chút trầm buồn, nhưng lại vô cùng gây ấn tượng mạnh.\u003c/p\u003e\n\u003cp\u003eSữa tắm SAVAGE giúp phái mạnh lưu dấu ấn đặc trưng cùng ấn tượng nam tính. Bên cạnh đó, còn là bản mix tài tình giữa gỗ, bạch đậu khấu thêm chút hồng hơi khô cằn - Thứ mùi đầy lịch lãm nhưng không phô trương và vô cùng đứng đắn.\u003c/p\u003e\n\u003cp\u003eHIỆU QUẢ SỬ DỤNG\u003c/p\u003e\n\u003cp\u003e️ Làm sạch da nhờ chiết xuất từ dừa, trà xanh, cúc la mã, an toàn không gây kích ứng.\u003c/p\u003e\n\u003cp\u003e️ Hỗ trợ điều trị mụn lưng nhờ tinh chất như Niacinamide, Sodium Chloride,\u003c/p\u003e\n\u003cp\u003e️ Bổ sung thành phần dưỡng ẩm từ lô hội cho bạn một làn da thật mịn màng đầy sức sống.\u003c/p\u003e\n\u003cp\u003e️ Mùi hương quyến rũ cho nam giới thêm phần tự tin thể hiện bản lĩnh.\u003c/p\u003e\n\u003cp\u003eHƯỚNG DẪN SỬ DỤNG\u003c/p\u003e\n\u003cp\u003eLàm ướt toàn thân bằng nước sạch\u003c/p\u003e\n\u003cp\u003eCho 1 ít sữa tắm vào lòng bàn tay hoặc bông tắm và tạo bọt\u003c/p\u003e\n\u003cp\u003eThoa đều và massage sữa tắm đã tạo bọt nhẹ nhàng khắp cơ thể\u003c/p\u003e\n\u003cp\u003eTắm lại bằng nước sạch\u003c/p\u003e\n\u003cp\u003eXuất xứ: Việt Nam\u003c/p\u003e\n\u003cp\u003eHSD: 2 Năm\u003c/p\u003e\n\u003cp\u003eNgày sản xuất: Xem trên Bao bì\u003c/p\u003e\n\u003cp\u003e**Bao bì thay đổi theo từng đợt nhập hàng\u003c/p\u003e\n\u003cp\u003e-------\u003c/p\u003e\n\u003cp\u003e#suatam #suatamnam #suatamnuochoa #suatamnuochoanam #suatamnamgioi #suatamluuhuong #nuochoanam\u003c/p\u003e\n\u003cp\u003e✩ Thương hiệu chuyên phân phối các dòng nước hoa, mỹ phẩm, sản phẩm làm đẹp cao cấp tại Việt Nam.\u003c/p\u003e\n\u003cp\u003eShip COD toàn quốc\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/77/ed/11/5777ca32ccc0543e5534c16fefb2f234.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/77/ed/11/5777ca32ccc0543e5534c16fefb2f234.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/77/ed/11/5777ca32ccc0543e5534c16fefb2f234.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/77/ed/11/5777ca32ccc0543e5534c16fefb2f234.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/77/ed/11/5777ca32ccc0543e5534c16fefb2f234.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/8b/d0/8c/4d8d56a7aef1f371428b3e6a951e0fc2.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/8b/d0/8c/4d8d56a7aef1f371428b3e6a951e0fc2.jpg","medium_u