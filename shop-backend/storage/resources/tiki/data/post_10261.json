":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/d8/ca/6a/ba8c6bd3008c30efc3ab0e5caa19f177.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":607,"all_time_quantity_sold":3,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p>Thương hiệu JJ (hay còn gọi Jia Jia) là một tập đoàn kinh doanh &amp; sản xuất các sản phẩm nước giải khát truyền thống của châu Á nổi tiếng ở Singapore với hơn 30 năm kinh nghiệm nghiên cứu và không ngường sáng tạo các sản phẩm có chất lượng tốt nhất nhằm phục vụ thị trường nội địa Singapore &amp; các nước lân cận</p>\n<p>TRÀ CHANH JJ thơm ngon, dễ uống, ra đời với mục đích mang lại sự thuận tiện cho các khách hàng cần nước giải khát nhưng không thích sử dụng các loại nước có ga. Nhẹ nhàng sảng khoái với vị chua nhẹ của chanh &amp; là một thức uống bổ dưỡng được mọi lứa tuổi yêu thích.</p>\n<p> Pha chế theo công thức truyền thống để giữ lại hương vị tự nhiên, được nấu &amp; ủ từ trà đen chất lượng cao nhằm lưu giữ hàm lượng chất chống oxy hóa tự nhiên có trong trà và giúp cho trà có hương vị đậm đà.</p>\n<p> Thành phần: nước; đường mía; chiết xuất trà đen (0.5%); hương chanh tổng hợp; chất điều chỉnh độ acid, vitamin C, phẩm màu tổng hợp, chất tạo ngọt tổng hợp.</p>\n<p> Công dụng: giúp hỗ trợ chứ năng tim khỏe mạnh, giảm huyết áp thấp và cholesterol, giảm các bệnh về mắt và gan, giàu chất chống oxy hóa tự nhiê</p>\n<p> Hướng dẫn sử dụng: lắc đều trước khi uống, ngon hơn khi uống lạnh</p>\n<p> Bảo quản nơi khô ráo, tránh ánh nắng trực tiếp</p>\n<p> Hạn sử dụng: 2 năm kể từ ngày sản xuất</p>\n<p> Sản phẩm không sử dụng chất bảo quản, ít ngọt hơn 25% đường so với các sản phẩm khác, có chứng nhận Hallah và các chứng nhận quốc tế ISO9001, HACCP, HEALTHIER CARE</p>\n<p>Thương hiệu: JJ – Singapore<br />Xuất xứ: Singapore<br />Loại đóng gói: 300ml/lon – Thùng 24 lon</p>\n<p>#trachanh #trachanh #trachanhJJ #JJ</p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/d8/ca/6a/ba8c6bd3008c30efc3ab0e5caa19f177.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d8/ca/6a/ba8c6bd3008c30efc3ab0e5caa19f177.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d8/ca/6a/ba8c6bd3008c30efc3ab0e5caa19f177.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d8/ca/6a/ba8c6bd3008c30efc3ab0e5caa19f177.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d8/ca/6a/ba8c6bd3008c30efc3ab0e5caa19f177.png"},{"base_url":"https://salt.tikicdn.com/ts/product/26/b2/20/199cfba14947b413cf38b76486b6f3e3.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/26/b2/20/199cfba14947b413cf38b76486b6f3e3.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/26/b2/20/199cfba14947b413cf38b76486b6f3e3.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/26/b2/20/199cfba14947b413cf38b76486b6f3e3.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/26/b2/20/199cfba14947b413cf38b76486b6f3e3.png"},{"base_url":"https://salt.tikicdn.