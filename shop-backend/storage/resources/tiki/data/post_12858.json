l,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":82000,"discount_rate":20,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/10/0e/79/c6233141f25dd5b272541ebcb2da1a12.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":814,"all_time_quantity_sold":6,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eBộ đôi Dầu Gội + Dầu Xả vỏ bưởi \u0026amp; Bồ Kết Herbario\u003c/strong\u003e phát huy tác dụng cao với tóc, giúp tóc ngày càng chắc khỏe và suôn mượt hơn.\u003cbr /\u003eDầu gội vỏ bưởi \u0026amp; bồ kết HERBARIO giúp giảm rụng tóc, nuôi dưỡng tóc từ sâu bên trong, cung cấp dưỡng chất giúp tóc chắc khỏe, phục hồi tóc hư tổn do tác động của môi trường và hóa chất, giúp tóc luôn khỏe mạnh, suôn mượt và mềm mại.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eDầu xả vỏ bưởi \u0026amp; bồ kết HERBARIO\u003c/strong\u003e giúp giảm rụng tóc,nuôi dưỡng tóc óng ả mềm mại, cung cấp dưỡng chất giúp tóc chắc khỏe, phục hồi hư tổn do tác động của môi trường và hóa chất, kéo dài thời gian khỏe đẹp của mái tóc.\u003cbr /\u003e\u003cbr /\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/eb/9f/38/bdf92a8fb2dd4f9bdc40c98de5e16b5a.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003cbr /\u003e\u003cstrong\u003eLIỆU PHÁP GIẢM RỤNG TÓC TỰ NHIÊN\u003c/strong\u003e\u003cbr /\u003e\u003cstrong\u003e- NUÔI DƯỠNG TÓC ÓNG Ả \u0026amp; MỀM MẠI -\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThông tin về sản phẩm dầu gội:\u003c/strong\u003e\u003cbr /\u003eTên sản phẩm: Dầu gội vỏ bưởi \u0026amp; bồ kết HERBARIO\u003cbr /\u003eThương hiệu: HERBARIO\u003cbr /\u003eThể tích: 300ml\u003cbr /\u003eThành phần: Aqua, Sodium laureth sulfate, Cocamidopropyl betaine, Glycerin, Sodium peg-7 olive oil carboxylate, Peg-7 Glyceryl cocoate, Panthenol, Propanediol, Peg-120 methyl glucose dioleate, Acrylates copolymer, Hydroxyproryl oxidized starch pg-trimonium chloride, Sodium lactate, Sodium gluconate, Quaternium 98, Citrus maxima (BƯỞI) peel oil, Gleditsia australis (BỒ KẾT) seed extract, Sodium chloride, Urea, Triethanolamine, Tocopheryl acetate, Polyquaternium 10, Lactic acid, Phenoxyethanol, Ethylhexylglycerin, Disodium edta.\u003cbr /\u003eCông dụng: giúp giảm rụng tóc,nuôi dưỡng tóc từ sâu bên trong, cung cấp dưỡng chất giúp tóc chắc khỏe, phục hồi tóc\u003cbr /\u003eCách dùng: Lấy một lượng dầu gội vừa đủ cho vào lòng bàn tay, thoa đều lên tóc, tạo bọt và mát-xa nhẹ nhàng, xả lại với nước.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/3e/6f/12/5edbac9b48405726b1bb5bf36479d624.jpg\" alt=\"Dầu gội vỏ bưởi \u0026amp; bồ kết HERBARIO\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThông tin về sản phẩm dầu xả:\u003c/strong\u003e\u003cbr /\u003eTên sản phẩm: Dầu xả vỏ bưởi \u0026amp; bồ kết HERBARIO\u003cbr /\u003eThương hiệu: HERBARIO - Thể tích: 300ml\u003cbr /\u003eThành phần: Aqua, Glycerin, cetearyl alcohol, cocos nucifera (dừa) oil, behentrimonium chloride, Sodium lactate, Sodium gluconate, Citrus maxima (BƯỞI) peel oil, Gleditsia australis (BỒ KẾT) seed extract, panthenol,propanediol, Polyquaternium 10, Phenoxyethanol, Ethylhexylglycerin.\u003cbr /\u003eCông dụng chính: giảm rụng tóc, nuôi dưỡng tóc óng ả mềm mại\u003cbr /\u003eCách dùng: Sau khi gội đầu, lấy một lượng dầu xả thoa đều từ thân tóc đến ngọn tóc, cách chân tóc khoảng 2 - 3cm, mát xa nhẹ nhàng khoảng 2 - 3 phút rồi xả lại với nước.\u003cbr /\u003eLưu ý: Tránh sản phẩm vây vào mắt\u003cbr /\u003eBảo quản nơi thoáng mát, khô ráo\u003c/p\u003e\n\u003cp\u003eCông dụng:\u003cbr /\u003e+ Giảm rụng tóc, nuôi dưỡng tóc óng ả mềm mại đồng thời cung cấp dưỡng chất giúp tóc chắc khỏe\u003cbr /\u003e+ Công thức chứa tinh chất vỏ bưởi và bồ kết, phục hồi và tái tạo tóc một cách hiệu quả\u003cbr /\u003e+ Nuôi dưỡng từng sợi tóc, cho mái tóc suôn mượt vào nếp\u003cbr /\u003e+ Phục hồi hư tổn tóc do tác động của môi trường và hóa chất\u003cbr /\u003e+ Kéo dài thời gian trẻ của mái tóc\u003c/p\u003e\n\u003cp\u003eSức mạnh kết hợp dầu gội và dầu xả HERBARIO chiết xuất vỏ bưởi \u0026amp; bồ kết\u003c/p\u003e\n\u003cp\u003eSử dụng \u003cstrong\u003edầu xả HERBARIO\u003c/strong\u003e kèm với dầu gội sẽ giúp tóc được cung cấp các dưỡng chất phù hợp và cần thiết. Sự kết hợp giữa bộ đôi Dầu gội và Dầu xả HERBARIO với nhau giúp tăng hiệu quả dưỡng tóc lên 3 lần và khiến phần lớn người dùng cảm thấy hài lòng.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThông tin nổi bật sản phẩm\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eCông thức cổ truyền siêu giàu dưỡng chất: Thành phần vỏ bưởi và bồ kết trong dầu xả được nghiên cứu, chỉ thu lại tinh chất nên siêu giàu dưỡng chất.\u003c/p\u003e\n\u003cp\u003eHương thơm nhẹ nhàng: Mùi thơm bưởi hòa quyện cùng mùi bồ kết tạo nên cảm giác thư giãn và thoải mái.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/10/0e/79/c6233141f25dd5b272541ebcb2da1a12.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/10/0e/79/c6233141f25dd5b272