x":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.8,"review_count":66,"review_text":"(66)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/94/d5/ac/e35a97c0ac14e9e046dfbbce292e9164.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1631,"all_time_quantity_sold":171,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/6c/e9/3f/b0457cfffc795f13f292aaee5e7570f3.jpg\" alt=\"\" width=\"700\" height=\"412\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/c7/90/04/eabdceffb5e7ddfa22b86f6b3acb976c.jpg\" alt=\"\" width=\"700\" height=\"320\" /\u003e\u003c/p\u003e\n\u003cp\u003e- \u003cem\u003e\u003cstrong\u003eNón bảo hiểm Kính Âm Royal M139\u003c/strong\u003e \u003c/em\u003elà \u003cstrong\u003enón 3/4 kính âm\u003c/strong\u003e đầu tiên của Việt Nam sản xuất. Là 1 trong những dòng \u003cstrong\u003enón 3/4\u003c/strong\u003e có kính thời trang nhất với thiết kế kính âm thanh lịch, độc đáo.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/product/26/08/9e/b1d15aca4bc83ef86fe3d7156d2cde5a.png\" alt=\"\" width=\"750\" height=\"299\" /\u003e\u003c/p\u003e\n\u003cp\u003e- Vỏ nón cũng như các mã nón khác được làm từ nhựa ABS nguyên sinh, là vật liệu dùng cho các sản phẩm yêu cầu cao như vỏ các thiết bị y tế, vỏ máy độ bền cao, chống chịu lực va chạm mạnh\u003c/p\u003e\n\u003cp\u003e- Lớp mút nón được làm từ vật liệu EPS hấp thụ lực tốt, cùng với vỏ nón là 2 phần quan trọng nhất cấu thành 1 chiếc nón bảo hiểm.\u003c/p\u003e\n\u003cp\u003e- Ốp tai và lớp lót là xốp êm bọc vải cực kì êm ái, được xử lý chống khuẩn và mùi hôi,cải tiến có thể tháo rời hoàn toàn để vệ sinh.\u003c/p\u003e\n\u003cp\u003e- Điều đặc biệt nhất ở chiếc nón này chính là phần \u003cem\u003e\u003cstrong\u003ekính âm\u003c/strong\u003e\u003c/em\u003e, khi thu gọn trở thành chiếc lưỡi trai trang trí hợp mốt đồng thời giúp bảo vệ kính tránh trầy xước khi không sử dụng. Còn khi sử dụng bạn chỉ việc kéo phần lưỡi trai xuống là lớp kính âm chắn gió bụi sẽ hiện ra với 3 nấc điều chỉnh tùy theo nhu cầu sử dụng. Khi kéo hết, kính sẽ trở thành 1 tấm khiên che chắn bạn khỏi gió, bụi, mưa, côn trù đồng thời còn giúp chống chói rất hiệu quả.\u003c/p\u003e\n\u003cp\u003eBộ sản phẩm gồm 1 nón + 1 túi\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/94/d5/ac/e35a97c0ac14e9e046dfbbce292e9164.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/94/d5/ac/e35a97c0ac14e9e046dfbbce292e9164.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/94/d5/ac/e35a97c0ac14e9e046dfbbce292e9164.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/94/d5/ac/e35a97c0ac14e9e046dfbbce292e9164.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/94/d5/ac/e35a97c0ac14e9e046dfbbce292e9164.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/56/a8/b2/50c0e71cf1f63cf40a2ff525612665cc.jpg","is_gallery":true,"label":null,"large_url":"htt