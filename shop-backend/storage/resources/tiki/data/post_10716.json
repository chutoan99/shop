/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":11000,"discount_rate":6,"rating_average":4.6,"review_count":112,"review_text":"(112)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/d9/54/38/cf96b2ea158bc102a6073f36189d57e4.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2109,"all_time_quantity_sold":724,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p style=\"text-align: center;\"><strong>PLEXTONE GS3 4 IN 1 VERSION 2021</strong></p>\n<p style=\"text-align: left;\"><strong>Đây là phiên bản 4in1 được nâng cấp đầu năm 2021, lần đầu được phân phối tại Việt Nam bởi Công Nghệ Việt</strong></p>\n<p style=\"text-align: left;\"><strong>Giới thiệu sản phẩm:</strong></p>\n<p style=\"text-align: left;\">1.【ỨNG DỤNG RỘNG】: Được thiết kế cho các thiết bị giắc cắm chuẩn 3,5mm như tai nghe trùm đầu, tai nghe nhét tai. Sản phẩm cũng thích hợp cho card âm thanh trong máy tính / máy tính xách tay / máy tính để bàn hoặc máy tính mất kết nối với bo mạch chủ. Bạn cũng có thể sử dụng mic và tai nghe cùng nhau trên các thiết bị iMac / Mac Mini với Plextone GS3</p>\n<p style=\"text-align: left;\">2.【Âm thanh lớn hơn】Nâng cao chất lượng âm thanh mà máy tính không thể tự làm được, tạo hiệu ứng âm thanh vòm (7.1) sẽ mang lại cho bạn cảm giác tuyệt vời hơn. Hỗ trợ âm thanh nổi (stereo) cho tai nghe nhét tai, headphone hoặc micrô thông thường với giắc cắm 3,5mm như Raspberry Pi 2/3 Xbox PS4 Surface Tablet Laptop, đặc biệt là cho các tai nghe chơi game.</p>\n<p style=\"text-align: left;\">3.【KHÔNG CÓ Drivers】 Dễ sử dụng, không cần cài đặt thêm trình điều khiển gì. Cắm và phát lại âm thanh ngay lập tức. Thiết kế đổi của Micrô/Tai nghe dễ dàng giúp chế độ tai nghe và loa chuyển đổi dễ dàng mà không cần rút bất kỳ thứ gì ra khỏi máy tính. Âm lượng âm thanh đầu ra có thể được điều chỉnh bằng con lăn dàng, thuận tiện.</p>\n<p style=\"text-align: left;\">4.【Chức năng Mixer】 Chức năng mixer(hoà trộn) có thể điều chỉnh mức đầu ra điện tử. Các phím chức năng bao gồm tắt tiếng micrô, tắt tiếng loa và con lăn tăng giảm âm lượng. Đèn LED mini và âm thanh vòm có thể cải thiện mức độ âm thanh chơi game. Hai giắc tai nghe với một giắc micrô có thể đáp ứng mọi nhu cầu của bạn cho bộ chuyển đổi card âm thanh ngoài. 【Tương thích】Sản phẩm được tích hợp USB 2.0 bên ngoài có thể hoạt động với tất cả các hệ điều hành phổ biến như Windows 98SE / ME / 2000 / XP / Server 2003 / Vista / Windows 7,8,10/ Linux, Mac OS, v.v. Kích thước nhẹ và tính di động giúp thuận tiện mang đi khắp nơi.</p>\n<p style=\"text-align: center;\"><iframe src=\"//www.youtube.com/embed/Xu9a049B7So\" width=\"560\" height=\"314\" allowfullscreen=\"allowfullscreen\"></iframe></p>\n<p><img id=\"https://salt.tikicdn.com/ts/tmp/d9/54/38/f8fa6c51ef6aa68f5bdac0eb032aab34.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/d9/54/38/f8fa6c51ef6aa68f5bdac0eb032aab34.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p><img id=\"https://salt.tikicdn.com/ts/tmp/af/bd/d2/dcb6b8948b8944a31eeb2b3d0eeb6bfb.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/af/bd/d2/dcb6b8948b8944a31eeb2b3d0eeb6bfb.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p><img id=\"https://salt.tikicdn.com/ts/tmp/ae/b3/35/ad8d477f7f2b02ce04b00a1d36bcec3c.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/ae/b3/35/ad8d477f7f2b02ce04b00a1d36bcec3c.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p><img id=\"https://salt.tikicdn.com/ts/tmp/64/a2/2f/707f5d878fcce3405695205be92fd478.j