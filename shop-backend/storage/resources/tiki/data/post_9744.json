tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":98999,"discount_rate":50,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/05/cb/97/9a4e88b0994047c74f32beafb78c4666.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":659,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\n  \u003cul\u003e\u003cli\u003e\u003cp\u003evệ sinh máy rửa chén bát Finish vỉ 3 viên \u0026#43;Tinh dầu treo khử mùi máy rửa chén Finish\u003c/p\u003e\n   \u003cp\u003e- Tác dụng của máy rửa bát Finish: Làm sạch vệ sinh lòng máy, vệ sinh hệ thống đường ống dẫn nước và xả thải\u003c/p\u003e\n   \u003cp\u003e- Cách sử vệ sinh máy rửa bát Finish: Sử dụng 1 viên i/lần vệ sinh, Khoảng 1 tháng vệ sinh máy một lần\u003c/p\u003e\n   \u003cp\u003e- Bảo quản nơi khô ráo, tránh ánh nắng trực tiếp và nhiệt độ \u0026gt;40C. Để xa tầm tay trẻ em\u003c/p\u003e\n   \u003cp\u003e- Hàng xuất xứ Châu Âu. Cam kết 100% chính hãng\u003c/p\u003e\n   \u003cp\u003eLưu ý: Mẫu mã bao bì có thể thay đổi theo từng lô hàng, nhưng chất lượng không thay đổi\u003c/p\u003e\n   \u003cp\u003e------------------------------------\u003c/p\u003e\n   \u003cp\u003eTinh dầu treo khử mùi máy rửa chén Finish Dishwasher Freshener Citron \u0026amp; Limeta (là tinh dầu treo khử mùi cao cấp chuyên dùng cho máy rửa chén). Xuất xứ: Ba Lan (EU)\u003c/p\u003e\n   \u003cp\u003e- Nhà sản xuất: Reckitt Benckiser\u003c/p\u003e\n   \u003cp\u003e- Trọng lượng: 22g\u003c/p\u003e\n   \u003cp\u003e- Kích thước: 9x3x18 cm\u003c/p\u003e\n   \u003cp\u003e- Thông tin tinh dầu: Citron/Lemon (chanh vàng), Limeta/Lime (chanh xanh)\u003c/p\u003e\n   \u003cp\u003eMUA 2 MIẾNG TINH DẦU BẠN TREO KHỬ MÙI CÁC BẠN TIẾT KIỆM ĐƯỢC 50% SO VỚI MUA LẺ TỪNG MIẾNG\u003c/p\u003e\n   \u003cp\u003eHãy để tinh dầu treo khử mùi máy rửa chén Finish Dishwasher Freshener Citron \u0026amp; Limeta là sự lựa chọn hoàn hảo, cần thiết để đảm bảo rằng máy rửa chén của bạn luôn sạch và lưu lại hương thơm tươi mát dài lâu.\u003c/p\u003e\n   \u003cp\u003eCông dụng:\u003c/p\u003e\n   \u003cp\u003e- Tinh dầu treo khử mùi máy rửa chén Finish Dishwasher Freshener Citron \u0026amp; Limeta đáp ứng tiêu chuẩn Châu Âu không gây độc hại, dị ứng, đảm bảo an toàn sức khoẻ, thân thiện với môi trường.\u003c/p\u003e\n   \u003cp\u003e- Thiết kế 2 khoang đặc biệt kết hợp hương chanh vàng và hương chanh xanh nhiệt đới hiệu quả gấp đôi trung hòa mùi khó chịu, diệt khuẩn, lưu lại hương thơm dài lâu.\u003c/p\u003e\n   \u003cp\u003e- Đơn giản, thuận tiện, dễ sử dụng, đảm bảo máy rửa chén, bát đĩa và dụng cụ nhà bếp luôn thơm mát dễ chịu (bạn chỉ việc treo tinh dầu treo khử mùi máy rửa chén Finish vào bên trong máy).\u003c/p\u003e\n   \u003cp\u003e- Tinh dầu treo khử mùi máy rửa chén Finish có thể sử dụng lên đến 60 lần, rất tiết kiệm và hiệu quả.\u003c/p\u003e\n   \u003cp\u003eHướng dẫn sử dụng:\u003c/p\u003e\n   \u003cp\u003e- Cài vào giá trên trong khu vực rửa chén (cài cố định trong máy rửa chén cho đến khi hết tinh dầu, không phải gỡ tinh dầu treo khử mùi máy rửa chén Finish trong mỗi lần rửa chén).\u003c/p\u003e\n   \u003cp\u003eChú ý:\u003c/p\u003e\n   \u003cp\u003e- Xem thêm hướng dẫn sử dụng trên vỏ hộp\u003c/p\u003e\n   \u003cp\u003e- Bảo quản nơi khô ráo và thoáng mát, tránh xa tầm tay trẻ em\u003c/p\u003e\n  \u003c/li\u003e\u003c/ul\u003e\n \u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e\u003cp\u003eSản phẩm này là tài sản cá nhân được bán bởi Nhà Bán Hàng Cá Nhân và không thuộc đối tượng phải chịu thuế GTGT. Do đó hoá đơn VAT không được cung cấp trong trường hợp này.\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/05/cb/97/9a4e88b0994047c74f32beafb78c4666.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/05/cb/97/9a4e88b0994047c74f32beafb78c4666.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/05/cb/97/9a4e88b0994047c74f32beafb78c4666.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/05/cb/97/9a4e88b0994047c74f32beafb78c4666.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/05/cb/97/9a4e88b0994047c74f32beafb78c4666.png"},{"base_url":"https://salt.tikicdn.com/ts/product/0c/43/5e/29e53067eb038ae6e48c7540ff992ba8.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0c/43/5e/29e53067eb038ae6e48c7540ff992ba8.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/0c/43/5e/29e53067eb038ae6e48c7540ff992ba8.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0c/43/5e/29e53067eb038ae6e48c7540ff992ba8.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0c/43/5e/29e53067eb038ae6e48c7540ff992ba8.png"},{"base_url":"https://salt.tikicdn.com/ts/product/e1/a5/61/bf77ffe60eddf6bf4af98949f5ed21ee.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e1/a5/61/bf77ffe60eddf6bf4af98949f5ed21ee.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e1/a5/61/bf77ffe60eddf6bf4af98949f5ed21ee.jpg","position":null,"small_url":"https://