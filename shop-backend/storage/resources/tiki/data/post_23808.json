n_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.7,"review_count":10,"review_text":"(10)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/4a/53/b5/208debbdc62386367618e700ed853423.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1234,"all_time_quantity_sold":33,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eMotul 5100 4T 10W30 công nghệ Ester tổng hợp 100% API SM, MA2 - dùng đường phố đường trường, thích hợp cho xe đời mới.\u003cbr /\u003eVới công nghệ Ester thì sản phẩm có chất lượng gần tương đương sản phẩm Motul H-tech, Motul 7100.\u003cbr /\u003eỨNG DỤNG:\u003cbr /\u003eSản phẩm sử dụng cho động cơ xe máy 4 thì như các dòng xe đường trường, xe địa hình,  có trang bị ly hợp khô hoặc ướt, có hộp số hoặc không có hộp số, các động cơ được khuyến nghị sử dụng độ nhớt thấp đáp ứng tiêu chuẩn Euro 2 và Euro 3, có trang bị bộ xử lý khí thải.\u003c/p\u003e\n\u003cp\u003eSản phẩm được khuyến nghị sử dụng cho các dòng xe máy HONDA, YAMAHA yêu cầu cấp độ nhớt 10W30.\u003c/p\u003e\n\u003cp\u003eSản phẩm cũng có thể sử dụng cho các xe không có bộ xử lý khí thải, xe tay ga, ATV’s, UTV’\u003c/p\u003e\n\u003cp\u003eƯU ĐIỂM:\u003cbr /\u003eĐặc tính bảo vệ\u003c/p\u003e\n\u003cp\u003eDầu nhớt bán tổng hợp công nghệ Technosynthese được tăng cường dầu gốc Ester giúp bảo vệ chống mài mòn hoàn hảo và kéo dài tuổi thọ hộp số.\u003cbr /\u003eCải thiện độ bền màng dầu ở nhiệt độ cao giúp kéo dài tuổi thọ động cơ.\u003cbr /\u003eHàm lượng photpho và sunfua được tối ưu hóa (JASO MA2 \u0026lt; 1200 ppm) tương thích hơn với bộ xử lý khí thải.\u003c/p\u003e\n\u003cp\u003eHệ phụ gia chống mài mòn tiên tiến giúp bảo vệ hoàn hảo hộp số. Kết quả phép thử FZG: Đạt FLS 14. Phương pháp FZG xác định mức luân chuyển và bảo vệ chống mài mòn bánh răng của dầu nhớt theo từng cấp tải trọng khác nhau.\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003eĐạt tiêu chuẩn JASO MA2\u003c/p\u003e\n\u003cp\u003eTiêu chuẩn JASO được phát triển dành cho động cơ xe máy 4 thì - JASO T903 bao gồm 3 cấp độ MA, MA1 và MA2\u003cbr /\u003eTiêu chuẩn JASO MA2 với độ ma sát tối ưu giúp duy trì khóa cứng ly hợp ở mọi chế độ vận hành như khi khởi động, tăng tốc và giữ tốc.\u003c/p\u003e\n\u003cp\u003eLOẠI ĐỘNG CƠ: 4 thì\u003cbr /\u003eCHẤT LƯỢNG: Tổng hợp 100%\u003cbr /\u003eBAO BÌ: Bình 1L, 800ML\u003cbr /\u003eSẢN PHẨM: Xe máy\u003cbr /\u003eĐỘ NHỚT: 10W30\u003cbr /\u003eJASO TIÊU CHUẨN: JASO MA2 M065MOT049\u003cbr /\u003eSẢN PHẨM ĐƯỢC PHÂN PHỐI CHÍNH HÃNG BỞI NK LUBE CENTER SHOP.\u003cbr /\u003e#motul #motulchinhhang #motul5100 #nhotmotul #motulxeso #nhotmotulxeso #xe #exciter #xemoi #xemoto #xepkl #nhotchinhhang #motulnhapkhau #5100 #winnerx #wave #sirus #nhotxe\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/4a/53/b5/208debbdc62386367618e700ed853423.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/4a/53/b5/208debbdc62386367618e700ed853423.j