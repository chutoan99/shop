l,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/38/1c/d8/d3b4767a668775ee07b44efcb272ee83.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":846,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eMÁY XAY SINH TỐ LEBENLANG GỒM 2 CỐI XAY TÍCH HỢP BÌNH CHỨA DUNG TÍCH 300-600ML,\u003c/p\u003e\n\u003cp\u003eCÔNG SUẤT 350W, MODEL LBSP8648\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/e3/52/bd/7964bb68a4af633e4dc3c05278c74c34.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eThông số kỹ thuật - Công suất: 350W\u003c/p\u003e\n\u003cp\u003e- Model: LBSP8648\u003c/p\u003e\n\u003cp\u003e- Điện áp: 220V AC/50-60Hz\u003c/p\u003e\n\u003cp\u003e- Chất liệu bình/cối xay: nhựa cao cấp - Lưỡi dao: Inox 304\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/5d/ba/b1/01e0d3c7519dde4fae2c706dc0f138e3.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e- Cấu tạo: 2 cối xay/bình chứa\u003c/p\u003e\n\u003cp\u003e- Dung tích cối xay lớn: 600ml\u003c/p\u003e\n\u003cp\u003e- Dung tích cối xay nhỏ: 300ml\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/af/e5/6d/d1fd96840293750b4e9ea40098d46d42.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eĐặc tính sản phẩm Động cơ bền bỉ, công suất cao giúp tiết kiệm tối đa thời gian xay\u003c/p\u003e\n\u003cp\u003eMáy xay sinh tố LEBENLANG có cấu tạo động cơ được quần bằng đồng nguyên chất, có tác dụng xay nhanh và mạnh mẽ, giúp tiết kiệm tối đa thời gian chế biến. So với các loại động cơ khác, động cơ đồng còn có độ bền và tuổi thọ cao.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/09/e9/92/b9f20e12c13b9c928f731d90d2d2496a.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eMặt khác, nhờ sử dụng động cơ quấn bằng đồng mà máy chạy êm ái hơn, giảm thiểu tiếng ồn. Máy xay sinh tố LEBENLANG hoạt động với công suất cao, lên tới 350W có thể xay nhanh, nhuyễn, thực phẩm không có tình trạng bị vón cục và vẫn bảo toàn được hương vị cũng như dinh dưỡng của các loại thực phẩm. Bạn vừa có thể xay sinh tố, vừa có xay khô với một chiếc Máy xay sinh tố LEBENLANG vô cùng tiện lợi.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/e1/d4/27/82193bfc3c5954be8da94271a68bd75a.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eNgoài ra, cả 2 cối xay đều được làm từ nhựa cao cấp, giúp đảm bảo vệ sinh an toàn thực phẩm, có khả năng chịu va đập cao và an toàn khi sử dụng. Lưỡi dao làm bằng inox 304 tuyệt đối an toàn Với lưỡi dao sắc bén 4 cánh, 3 chiều làm từ inox 304, có thể xay nhuyễn mọi loại thực phẩm một cách nhanh chóng.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/0a/de/5d/89d514ffcab399e0a79bfef7fc0432c4.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eMặt khác, inox 304 là chất liệu được dùng trong y tế nên đảm bảo tuyệt đối an toàn cho sức khỏe, sử dụng bền lâu và có thể tháo rời dễ dàng khi vệ sinh máy.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/0c/5b/4b/1fbec8ec540e68702568fee94cb9b653.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/38/1c/d8/d3b4767a668775ee07b44efcb272ee83.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/38/1c/d8/d3b4767a668775ee07b44efcb272ee83.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/38/1c/d8/d3b4767a668775ee07b44efcb272ee83.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/38/1c/d8/d3b4767a668775ee07b44efcb272ee83.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/38/1c/d8/d3b4767a668775ee07b44efcb272ee83.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/60/98/82/1a0816aad2bc304349bc0a844d26c2ea.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/60/98/82/1a0816aad2bc304349bc0a844d26c2ea.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/60/98/82/1a0816aad2bc304349bc0a844d26c2ea.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/60/98/82/1a0816aad2bc304349bc0a844d26c2ea.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/60/98/82/1a0816aad2bc304349bc0a844d26c2ea.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/ee/d2/06/ccd861ce6d6dc75f11cff7ff5c194d09.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ee/d2/06/ccd861ce6d6dc75f11cff7ff5c194d09.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ee/d2/06/ccd861ce6d6dc75f11cff7ff5c194d09.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ee/d2/06/ccd861ce6d6dc75f11cff7ff5c194d09.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ee/d2/06/ccd861ce6d6dc75f11cff7ff5c194d09.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/35/5b/75/5a38d6501be05f