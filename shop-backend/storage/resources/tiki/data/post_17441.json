_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":195000,"discount_rate":24,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/5f/af/9d/5cf584b6af6d3f444ceeba29eb902b02.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":365,"all_time_quantity_sold":4,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align:center;\"\u003e\u003cstrong\u003eVIÊN UỐNG SẮC NGỌC KHANG VI TẢO LỤC NGĂN NGỪA NÁM\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cstrong\u003eKHỎE TRONG ĐẸP NGOÀI, GIỮ HOÀI THANH XUÂN\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003eXuất xứ : Việt Nam\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003eXuất xứ thương hiệu : Sắc Ngọc Khang\u003c/p\u003e\n\u003col\u003e\n\u003cli\u003e\u003cstrong\u003eThành phần: \u003c/strong\u003e\u003c/li\u003e\n\u003c/ol\u003e\n\u003cp\u003eAstaxanthin (Vi tảo lục Nhật Bản)                              6 mg\u003c/p\u003e\n\u003cp\u003eTinh chất mầm đậu tương (isoflavones 80%)             30 mg\u003c/p\u003e\n\u003cp\u003eCao khô Quy râu                                                         23.2 mg\u003c/p\u003e\n\u003cp\u003eCao khô Ngưu tất                                                        23.2 mg\u003c/p\u003e\n\u003cp\u003eCao khô Thục địa                                                        32 mg\u003c/p\u003e\n\u003cp\u003eCao khô Ích mẫu                                                         8 mg\u003c/p\u003e\n\u003cp\u003eDầu gấc                                                                       20 mg\u003c/p\u003e\n\u003cp\u003eL-cystin                                                                       300 mg\u003c/p\u003e\n\u003cp\u003eTá dược: Magie stearate, tale,                                 vừa đủ 1 viên\u003c/p\u003e\n\u003col start=\"2\"\u003e\n\u003cli\u003e\u003cstrong\u003eCông dụng sản phẩm:\u003c/strong\u003e\u003c/li\u003e\n\u003c/ol\u003e\n\u003cp\u003e- Hỗ trợ giảm nám da, sạm da, tàn nhang.\u003c/p\u003e\n\u003cp\u003e- Chống oxy hóa, giúp ngăn ngừa lão hóa da và cơ thể.\u003c/p\u003e\n\u003cp\u003e- Giúp bổ huyết, hoạt huyết, giảm các triệu chứng thời kỳ sắp mãn kinh.\u003c/p\u003e\n\u003cp\u003e- Viên dạng nang mềm, dễ uống và hấp thu nhanh vào cơ thể\u003c/p\u003e\n\u003col start=\"3\"\u003e\n\u003cli\u003e\u003cstrong\u003eHướng dẫn sử dụng:\u003c/strong\u003e\u003c/li\u003e\n\u003c/ol\u003e\n\u003cp\u003e- Tháng đầu sử dụng: Sáng 3 viên – chiều 3 viên. Uống trước hoặc sau ăn 30 phút\u003c/p\u003e\n\u003cp\u003e- Sử dụng liều duy trì: Sáng 2 viên – chiều 2 viên. Uống trước hoặc sau ăn 30 phút\u003c/p\u003e\n\u003cp\u003e- Thời gian sử dụng tối thiểu 3 tháng.\u003c/p\u003e\n\u003cp\u003e- Có thể dùng thường xuyên để duy trì làn da khỏe đẹp.\u003c/p\u003e\n\u003col start=\"4\"\u003e\n\u003cli\u003e\u003cstrong\u003eĐối tượng sử dụng:\u003c/strong\u003e\u003c/li\u003e\n\u003c/ol\u003e\n\u003cul\u003e\n\u003cli\u003ePhụ nữ có các triệu chứng khó chịu thời kỳ tiền kinh nguyệt, tiền mãn kinh và mãn kinh.\u003c/li\u003e\n\u003cli\u003ePhụ nữ bị sạm, nám da, khô da, lão hóa da\u003c/li\u003e\n\u003cli\u003ePhụ nữ có nhu cầu làm đẹp da\u003c/li\u003e\n\u003c/ul\u003e\n\u003col start=\"5\"\u003e\n\u003cli\u003e\u003cstrong\u003eHạn sử dụng:\u003c/strong\u003e\u003c/li\u003e\n\u003c/ol\u003e\n\u003cp\u003e- 3 năm kế từ ngày sản xuất (Ngày sản xuất xem trên bao bì).\u003c/p\u003e\n\u003col start=\"6\"\u003e\n\u003cli\u003e\u003cstrong\u003eBảo quản:\u003c/strong\u003e\u003c/li\u003e\n\u003c/ol\u003e\n\u003cp\u003e- Nơi khô mát, tránh ánh sáng trực tiếp.\u003c/p\u003e\n\u003col start=\"7\"\u003e\n\u003cli\u003e\u003cstrong\u003eQuy cách đóng gói:\u003c/strong\u003e\u003c/li\u003e\n\u003c/ol\u003e\n\u003cp\u003e- Viên uống Sắc Ngọc Khang Vi tảo lục hộp 180 viên\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eLưu ý :\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eThực phẩm này chỉ là thực phẩm chức năng bổ sung, hiệu quả tùy thuộc cơ địa của từng người.\u003c/li\u003e\n\u003cli\u003eTạm ngưng sử dụng khi có kinh nguyệt.\u003c/li\u003e\n\u003cli\u003eKhông dùng cho phụ nữ có thai hoặc phụ nữ cho con bú\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eSản phẩm không phải là thuốc và không thay thế thuốc chữa bệnh\u003c/strong\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/5f/af/9d/5cf584b6af6d3f444ceeba29eb902b02.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/5f/af/9d/5cf584b6af6d3f444ceeba29eb902b02.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/5f/af/9d/5cf584b6af6d3f444ceeba29eb902b02.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5f/af/9d/5cf584b6af6d3f444ceeba29eb902b02.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5f/af/9d/5cf584b6af6d3f444ceeba29eb902b02.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/37/78/68/792a1f19f1