":"pdp_badge","code":"is_hero","type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":true,"return_reason":"any_reason"}},"discount":1292000,"discount_rate":35,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/28/ae/43/5b33212b2ac0cefd1ac8c7bacd5dae5f.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":398,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"Giày thể thao nam Under Armour Hovr Sonic 6 - 3026121-005\n\u003cbr /\u003eĐặc điểm nổi bật: GIÀY CHẠY BỘ NAM UNDER ARMOUR HOVR SONIC 6Được thiết kế cực kỳ nhẹ và hỗ trợ để không có gì có thể cản trở bạn khi huấn luyện viên thổi còi. Đôi giày HOVR Sonic 6 kết hợp với đệm UA HOVR mềm mại, đàn hồi đẩy bạn về phía trước—mang đến cho bạn nguồn năng lượng sẵn sàng chinh phụ mọi thử thách. THÔNG SỐ\n\u003cbr /\u003eĐộ lệch: 8mm\n\u003cbr /\u003eTrọng lượng: 9,9 oz. 280 gam\n\u003cbr /\u003ePhù hợp cho việc chạy hàng ngày với cảm giác nhẹ nhàng \n\u003cbr /\u003eThiết kế lưới ở phần trên (upper) với bàn chân trước liền mạch để tạo sự thoải mái và thoáng khí \n\u003cbr /\u003eMiếng lót giày đúc 3D nâng đỡ bàn chân để tăng cường sự thoải mái khi bước vào \n\u003cbr /\u003eĐệm UA HOVR có khả năng phản hồi giúp giảm tác động, hoàn trả năng lượng \u0026amp; giúp đẩy bạn về phía trước \n\u003cbr /\u003eSự kết hợp của cao su carbon \u0026amp; cao su thổi ở đế ngoài cung cấp độ bền và khả năng phục hồi nhẹ \n\u003cbr /\u003eThiết kế đế ngoài được cải tiến có tính linh hoạt khi bạn cần và phân tán tác động hiệu quả để có một chuyến đi suôn sẻ\n\u003cbr /\u003eMã sản phẩm: 3026121-005\n\u003cp\u003e\u003cbr /\u003eNơi sản xuất: Hàng sản xuất ở nước thứ 3 tùy từng lô hàng (Việt Nam, Trung Quốc, Ấn Độ, C)\u003c/p\u003e\n\u003cp\u003eHướng dẫn bảo quản:\u003cbr /\u003e• Hạn chế không nên để sản phẩm tiếp xúc nhiều với chất bẩn, đặc biệt là các chất bẩn cứng đầu như máu, cà phê, nhựa trái cây…\u003cbr /\u003e• Bảo quản sản phẩm ở nơi khô ráo, thoáng mát… để tránh các loại nấm mốc. (Nếu không sử dụng thường xuyên thì nên bỏ vào bao ni lông bịt kín hoặc hộp đựng.)\u003cbr /\u003e• Nên sử dụng khuôn hoặc nhét giấy báo cũ vào bên trong để luôn giữ được hình dạng ban đầu (đối với sản phẩm giày dép)\u003cbr /\u003e• Không nên phơi sản phẩm dưới nắng quá gắt. \u003c/p\u003e\n\u003cp\u003eChính sách đổi trả: Áp dụng theo chính sách của sàn\u003c/p\u003e\n\u003cp\u003eChính sách bảo hành: Không bảo hành\u003c/p\u003e\n\u003cp\u003eXuất xứ thương hiệu: Mỹ\u003c/p\u003e\n\u003cp\u003eThông Tin Thương Hiệu:\u003cbr /\u003eUnder Amour là một công ty của Mỹ chuyên về các sản phẩm giày dép, quần áo, đồ dùng thể thao, đang phát triển cực kỳ mạnh mẽ tại thị trường Mỹ hiện nay. Được sáng lập năm 1996 bới cựu cầu thủ bóng đá trường đại học Maryland Kevin Plank, Under Armour là nguyên mẫu khời nguồn của hàng loạt quần áo hàng hiệu – giúp cho người chơi thể thao luôn thoáng mát, khô và nhẹ mặc dù mang đến hết trận đấu.\u003cbr /\u003eThông Tin Nhà Phân Phối:\u003cbr /\u003eSupersports là hệ thống bán lẻ hàng đầu và chuyên phân phối các mặt hàng về thể thao tại Thái Lan và là hệ thống thuộc tập đoàn Central Retail. Supersports mang đến rất nhiều lựa chọn về giày dép và quần áo, máy tập thể dục và phụ kiện thể thao từ các thương hiệu nổi tiếng thế giới. Supersports tự hào mang đến sản phẩm chất lượng tốt và dịch vụ đặc biệt cho Việt Nam.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/28/ae/43/5b33212b2ac0cefd1ac8c7bacd5dae5f.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/28/ae/43/5b33212b2ac0cefd1ac8c7bacd5dae5f.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/28/ae/43/5b33212b2ac0cefd1ac8c7bacd5dae5f.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/28/ae/43/5b33212b2ac0cefd1ac8c7bacd5dae5f.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/28/ae/43/5b33212b2ac0cefd1ac8c7bacd5dae5f.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/f8/18/49/268554743f8f7f071458d26178d907de.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f8/18/49/268554743f8f7f071458d26178d907de.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f8/18/49/268554743f8f7f071458d26178d907de.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f8/18/49/268554743f8f7f071458d26178d907de.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f8/18/49/268554743f8f7f071458d26178d907