width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":2500000,"discount_rate":47,"rating_average":4.6,"review_count":12,"review_text":"(12)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/6c/68/32/aed4b1ea7ca2cf2fb50a034f144fb515.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":510,"all_time_quantity_sold":62,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003ciframe src=\"//www.youtube.com/embed/mw3w8PO1kU4\" width=\"750\" height=\"450\" allowfullscreen=\"\"\u003e\u003c/iframe\u003e\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eBài đánh giá két sắt vân tay thông minh Xiaomi Mijia\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003e là một trong những thiết bị thông minh giúp bảo vệ tài sản quý giá, giấy tờ quan trọng cho gia đình bạn một cách an toàn nhất. Một dòng sản phẩm đến từ thương hiệu nổi tiếng Xiaomi hứa hẹn sẽ mang đến cho gia đình bạn những điều tuyệt vời nhất\u003c/p\u003e\n\u003ch3\u003eKét sắt thông minh mini giúp bảo quản tài sản\u003c/h3\u003e\n\u003cp\u003e\u003cstrong\u003eKét sắt mini\u003c/strong\u003e được Thiết kế tinh tế, tông màu đen sang trọng, gọn đẹp, không chiếm quá nhiều không gian. Thiết kế kiểu hình hộp chữ nhật có 2 ngăn chứa rộng rãi, phù hợp với nhiều không gian khác nhau, đáp ứng mọi nhu cầu cất giữ bảo mật những thông tin tài sản quan trọng như: tiền mặt, trang sức, giấy tờ quan trọng,…\u003c/p\u003e\n\u003ch3\u003e \u003c/h3\u003e\n\u003cp\u003e\u003cimg class=\"entered lazyloaded\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/0e/ea/c5/8d1ab721ebbf3c91315f5991da234dbc.jpg\" alt=\"Két sắt mini Xiaomi có kiểu dáng nhỏ gọn, tinh tế\" width=\"750\" height=\"562\" /\u003e\u003c/p\u003e\n\u003ch3\u003eChất liệu có độ bền cao, đảm bảo an toàn tối ưu\u003c/h3\u003e\n\u003cp\u003e\u003cstrong\u003eKét sắt chống cháy\u003c/strong\u003e được cấu tạo từ các vật liệu cao cấp chắc chắn và bền bỉ. Đặc biệt, là phần cài đặt khóa và phần bu lông khóa được tích hợp sẵn bằng tấm thép chống khoan 65Mn, giúp bảo vệ an toàn cho tài sản cũng như chống trộm rất tốt khi gặp phải trường hợp khoan, phá két.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"entered lazyloaded\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/4e/e5/19/6c6f19d010014e74ffb94c9e9cda00bd.jpg\" alt=\"Chất liệu két sắt mini làm từ thép dày 2 lớp giúp két săt chống cháy, bền bỉ\" width=\"750\" height=\"562\" /\u003e\u003c/p\u003e\n\u003ch3\u003eKét sắt mini có độ bảo mật cao đảm bảo an toàn cho tài sản\u003c/h3\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"entered lazyloaded\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/d2/29/4d/168c7d66e42111a9c74a656bb3f21028.jpg\" alt=\"Két sắt thông minh giúp bảo mật tuyệt đối với 6 cách mở khóa đa năng\" width=\"750\" height=\"562\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eKét sắt mini thông minh\u003c/strong\u003e có hỗ trợ thêm 6 cách đa năng, trong đó bằng vân tay với tỷ lệ nhận dạng vân tay chính xác lên tới 97,44%. Để cài đặt vân tay, bạn cần lắp pin cho két sắt, cũng như kết nối với app Mi home để cài đặt vân tay chính xác, an toàn và bảo mật tối ưu.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"entered lazyloaded\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/f2/2d/03/f9f75f9c0cf0bf6e08c24d1cde0c09b8.jpg\" alt=\"Két săt điện tử có tính năng mở khóa vân tay siêu chính xác\" width=\"750\" height=\"562\" /\u003e\u003c/p\u003e\n\u003ch3\u003eHỗ trợ mật khẩu ảo gồm 20 chữ số và có thể cấp mật khẩu tạm thời từ xa\u003c/h3\u003e\n\u003cp\u003eBạn có thể nhập mã cắt xén ảo trước và sau khi mật khẩu thực theo ý muốn để ngăn chặn vấn đề nhìn trộm và bảo vệ mật khẩu thật an toàn. Đồng thời, người dùng cũng có thể cấp mật khẩu tạm thời từ xa thông qua App Mi Home.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"entered lazyloaded\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/9f/37/1b/b96df638e4058beaca23a0b4ea214c03.jpg\" alt=\"Két sắt thông minh hỗ trợ mật khẩu ảo 20 chữ số\" width=\"750\" height=\"562\" /\u003e\u003c/p\u003e\n\u003ch3\u003eĐiều khiển thông minh thông qua App Mi Home\u003c/h3\u003e\n\u003cp\u003eVới \u003cstrong\u003ekét sắt vân tay Xiaomi Mijia\u003c/strong\u003e người dùng có thể kết nối với app Mihome thông qua công nghệ Bluetooth 5.0, giúp điều khiển và thiết lập các tính năng của \u003cstrong\u003ekét sắt Xiaomi\u003c/strong\u003e như: thiết lập vân tay, tự động, cấp mật khẩu 1 lần, … hiệu quả và đa dụng.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"entered lazyloaded\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/5e/6a/3e/6909c649716368c5e51812dc0ada7039.jpg\" alt=\"Điều khiển két sắt mini hiện đại thông qua App Mihome\" width=\"750\" height=\"562\" /\u003e\u003c/p\u003e\n\u003cp\u003eĐặc biệt, nhằm tránh trường hợp người khác tự di chuyển két sắt vân tay với tính năng báo động đồng thời gửi thông báo thông qua app.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"entered lazyloaded\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/33/a7/51/45d0d68a6c6bb9498531f54e4f695950.jpg\" alt=\"Két sắt chính hãng có tính năng báo động an toàn\" width=\"750\" height=\"562\" /\u003e\u003c/p\u003e\n\u003ch3\u003eTích hợp chip bảo mật tùy chỉnh Mijia, chuyên nghiệp và đảm bảo độ bảo mật dữ liệu\u003c/h3\u003e\n\u003cp\u003eTất cả những liên lạc giữa \u003cstrong\u003ekét sắt gia đình\u003c/strong\u003e \u003cstrong\u003eMijia\u003c/strong\u003e và điện thoại của người dùng đều được bảo mật xác thực với mã hóa để đảm bảo an toàn thông tin cho đường truyền.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"entered lazyloaded\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/6c/13/1e/629b707f76f654cdb0b8ca6f7a23a116.jpg\" alt=\"Két sắt công nghệ cao được tích hợp chip bảo mật tùy chỉnh\" width=\"750\" height=\"562\" /\u003e\u003c/p\u003e\n\u003ch3\u003eKhóa tiêu chuẩn cao vô cùng an toàn\u003c/h3\u003e\n\u003cp\u003eKét sắt thông minh được trang bị xi lanh khóa chặn cấp C*, tiêu chuẩn cao nhất hiện tại trong ngành bảo mật két sắt. Ngay cả khi bảng điều khiển bị phá vỡ dữ dội, ngay cả khi nó bị vỡ, lõi bên trong vẫn có thể đảm bảo an toàn cho vật phẩm an toàn và không bị trộm. Đồng thời, két cũng có khả năng chống cháy tuyệt vời, hỗ trợ thêm bảo quản tài sản tối ưu.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"entered lazyloaded\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/9a/0c/f0/291a7778989f68abf8a0f6f9649880a3.jpg\" width=\"750\" height=\"562\" /\u003e\u003c/p\u003e\n\u003ch3\u003eKhay ngăn di chuyển linh hoạt\u003c/h3\u003e\n\u003cp\u003eBên trong két Xiaomi được trang bị một khay ngăn cùng các chốt đỡ giúp người dùng có thể phân chia các khu vực lưu trữ và thay đổi kích thước các ngăn tiện lợi hơn khi sử dụng.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"entered lazyloaded\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/3f/3d/67/be79dffab2bfc65bc63b7a50db6372b5.jpg\" alt=\"Ngăn lữu trữ lớn, khoa học giúp két sắt đựng được nhiều tài sản\" width=\"750\" height=\"562\" /\u003e\u003c/p\u003e\n\u003ch3\u003eDung lượng pin lớn, có thể hoạt động ở chế độ chờ lên tới 12 tháng\u003c/h3\u003e\n\u003cp\u003e\u003cstrong\u003eKét sắt Xiaomi MIJIA Smart Safe\u003c/strong\u003e được cung cấp năng lượng bởi 4 viên pin AA. Công nghệ cấp nguồn điện khẩn cấp thông qua cổng Type-C tiện lợi, giúp bạn yên tâm hơn khi hết pin.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"entered lazyloaded\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/37/ef/26/4e7324997f144b606646c976b3851af1.jpg\" alt=\"Két sắt thông minh sử dụng pin dung lượng lớn\" width=\"750\" height=\"562\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eKét sắt vân tay Xiaomi Mijia\u003c/strong\u003e là sản phẩm két sắt cá nhân phù hợp với các hộ gia đình để bảo vệ tài sản luôn luôn an toàn. Tích hợp thêm nhiều chức năng bảo mật hiện đại, hỗ trợ bảo vệ tài sản an toàn tối ưu, đây chắc chắn là một sự lựa chọn tuyệt vời để bảo vệ tài sản quan trọng.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"entered lazyloaded\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/8f/b6/ec/683f5363ffe0eed365194c7aa7486847.jpg\" alt=\"Thông số kỹ thuật két sắt vân tay thông minh Xiaomi Mijia\" width=\"750\" height=\"562\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/6c/68/32/aed4b1ea7ca2cf2fb50a034f144fb515.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/6c/68/32/aed4b1ea7ca2cf2fb50a034f144fb515.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/6c/68/32/aed4b1ea7ca2cf2fb50a034f144fb515.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6c/68/32/