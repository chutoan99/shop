ull,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.8,"review_count":85,"review_text":"(85)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/64/e7/27/5c90adb6b0b55e7d17c3652516f189c4.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1219,"all_time_quantity_sold":715,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eTRỌNG TẢI 60KG\u003c/p\u003e\n\u003cp\u003eĐẾ LÓT CHẬU CÂY CÓ BÁNH XE THƯƠNG HIỆU MONROVIA - TIÊU CHUẨN CHÂU ÂU\u003c/p\u003e\n\u003cp\u003eBạn có muốn có một đế đẩy chậu cây di động bằng gỗ chất lượng hoàn thiện tuyệt vời? Bạn muốn sản phẩm cao cấp, tiện lợi trong việc di chuyển, đa năng dùng được cả trong nhà và ngoài trời?\u003c/p\u003e\n\u003cp\u003e\u003cem\u003eĐẾ ĐẨY CHẬU CÂY DI ĐỘNG MONROVIA - THƯƠNG HIỆU CHÂU ÂU - SẢN PHẨM CÓ THỂ THAY ĐỔI HOÀN TOÀN SUY NGHĨ CỦA BẠN!\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003eNguyên liệu tuyển chọn theo MONROVIA Châu Âu, đáp ứng tiêu chuẩn xuất khẩu. Chất liệu 100% gỗ tràm tự nhiên, tuổi thọ từ 10 năm tuổi trở lên. Màu sắc đồng đều, chắc chắn, độ đặc của lõi cao so với cây non. Gỗ rừng trồng, nguồn gốc xuất xứ rõ ràng, được tuyển chọn theo tiêu chuẩn MONROVIA Châu Âu, có khả năng tái tạo nên mang tính bền vững, thân thiện với môi trường. Thích hợp sử dụng ở nhiều vị trí như ban công, trong nhà, ngoài trời \u0026amp; sân vườn,...\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/06/b5/5d/704ad993779d31a847a7c934f1d7180b.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/62/92/dc/463d8b25f2dc63c372e8abf6dca1b980.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/14/06/1c/9cdd986a7a8fc5540982231535c333e9.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003col\u003e\u003cli\u003e\u003cstrong\u003e THÔNG TIN SẢN PHẨM\u003c/strong\u003e\u003c/li\u003e\n\u003c/ol\u003e\u003cul\u003e\u003cli\u003eKích thước: 30cm x 30cm x 8,5cm\u003c/li\u003e\n\u003cli\u003eKích thước hộp: 31cm x 31cm x 9cm\u003c/li\u003e\n\u003cli\u003eChất liệu: 100% gỗ tràm bông vàng, trên 10 năm tuổi\u003c/li\u003e\n\u003cli\u003eMàu sắc: Gỗ tự nhiên\u003c/li\u003e\n\u003cli\u003eBao gồm: Hộp đựng cao cấp, đế đẩy chậu cây, 4 bánh xe\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/7f/26/93/ddd0d34cf9e5d33bb058d6acc653608b.jpg\" alt=\"\" width=\"750\" height=\"722\" /\u003e\u003c/p\u003e\n\u003col start=\"2\"\u003e\u003cli\u003e\u003cstrong\u003e TẠI SAO BẠN NÊN CHỌN Đế đẩy chậu cây di động MONROVIA ? \u003c/strong\u003e\u003c/li\u003e\n\u003c/ol\u003e\u003cul\u003e\u003cli\u003eSản xuất được thực hiện tự động hoàn toàn qua hệ thống cắt CNC tự động\u003c/li\u003e\n\u003cli\u003eSản phẩm được mài nhẵn cả hai bề mặtHai lớp sơn phủ, sơn lót giúp nâng cao tuổi thọ của các nan gỗ\u003c/li\u003e\n\u003cli\u003eThiết kế 4 bánh xe bằng nhựa dày, xoay chiều 360 độ, khóa an toàn\u003c/li\u003e\n\u003cli\u003eIn nhiệt logo thương hiệu Monrovia, đảm bảo chất lượng xuất xưởng\u003c/li\u003e\n\u003cli\u003eĐóng gói hoàn thiện trong hộp chính hãng cao cấp thương hiệu MONROVIA\u003c/li\u003e\n\u003c/ul\u003e\u003col start=\"3\"\u003e\u003cli\u003e\u003cstrong\u003e CHẤT LIỆU VÀ MÀU SẮC \u003c/strong\u003e\u003c/li\u003e\n\u003c/ol\u003e\u003cul\u003e\u003cli\u003eGỗ tràm bền, chắc, ít cong vênh đàn hồi tốt\u003c/li\u003e\n\u003cli\u003eChất lượng sơn phủ, lót bám dính cao\u003c/li\u003e\n\u003cli\u003eDễ dàng vệ sinh, hạn chế bám bẩn so với các loại sơn phủ khác 100% gỗ tràm bông vàng tự nhiên trên 10 năm tuổi, màu sắc đồng đều\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/ed/9a/63/2d4c4ddff8ad62cbcde5678ce3ebbba5.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003col start=\"4\"\u003e\u003cli\u003e\u003cstrong\u003e KÍCH THƯỚC HOÀN HẢO \u0026amp; TẢI TRỌNG LÊN ĐẾN 80KG\u003c/strong\u003e\u003c/li\u003e\n\u003c/ol\u003e\u003cp\u003eĐường kính 30 cm của đế đẩy chậu cây di động MONROVIA phù hợp với đa số các loại chậu từ nhỏ, trung đến kích thước lớn. Sử dụng ngay khi mở hộp\u003c/p\u003e\n\u003col start=\"5\"\u003e\u003cli\u003e\u003cstrong\u003e CHẮC CHẮN, DỄ BẢO QUẢN\u003c/strong\u003e\u003c/li\u003e\n\u003c/ol\u003e\u003cp\u003eSản phẩm đế đẩy chậu cây di động Monrovia được chọn lựa từ những cây tràm đủ tiêu chuẩn xuất khẩu, trên 10 năm tuổi, độ đặc của lõi cao, thanh gỗ dày\u003c/p\u003e\n\u003cp\u003eThiết kế 4 bánh xe chịu lực nặng có tuổi thọ cao, cho phép tải trọng lên đến 80kg\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/ae/dc/90/9165af7cd8502d94c00c1f62aea1cf21.jpg\" alt=\"de-day-chau-cay-co-banh-xe\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003col start=\"6\"\u003e\u003cli\u003e\u003cstrong\u003e DỄ DÀNG DI CHUYỂN\u003c/strong\u003e\u003c/li\u003e\n\u003c/ol\u003e\u003cp\u003eĐế đẩy chậu cây di động MONROVIA có bánh xe xoay 360 độ giúp dễ dàng di chuyển chậu cây nặng, lọ hoa lớn theo bất kỳ hướng nào. Đế lót giúp di chuyển các chậu cây một cách dễ dàng, nhanh chóng, ngay cả đối với phái nữ\u003c/p\u003e\n\u003cp\u003eBên cạnh đó, 4 bánh xe có khóa có thể giữ cho chậu hoa của bạn ở đúng vị trí và chống trượt. Di chuyển dễ dàng khi cần vệ sinh.\u003c/p\u003e\n\u003cp\u003eBánh xe chất liệu nhựa chống trầy xước cho sàn gỗ, bê tông và thảm. Sản phẩm với màu gỗ tự nhiên có thể để trong nhà, ngoài trời tạo nên sự sang trọng, tinh tế cho ngôi nhà.\u003c/p\u003e\n\u003col start=\"7\"\u003e\u003cli\u003e\u003cstrong\u003e TIỆN DỤNG\u003c/strong\u003e\u003c/li\u003e\n\u003c/ol\u003e\u003cp\u003eVới thiết kế có bánh xe và khóa an toàn chắc chắn, thuận tiện di chuyển nhiều đồ vật trong nhà. Đế lót chịu nhiệt độ cao, chống tia cực tím, chống thấm nước, mạnh mẽ và bền bỉ theo thời gian. Ngoài chức năng lót chậu cây, sản phẩm còn có thể được sử dụng như kệ đỡ hoa di động, kệ trang trí, kệ đỡ loa.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/65/06/5c/4128e3482f6fe6d55e89ac5d9ba7e156.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eMONROVIA Việt Nam Cam kết\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eHàng cao cấp chính hãng, tiêu chuẩn Châu Âu\u003c/p\u003e\n\u003cp\u003eĐế đẩy chậu cây di động MONROVIA được đóng gói trong hộp carton cao cấp mang chất lượng và vẻ đẹp thẩm mỹ tốt nhất khi đến tay người sử dụng\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/64/e7/27/5c90adb6b0b55e7d17c3652516f189c4.j