t":"pdp_badge","code":"is_hero","type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"freeship_xtra","type":"pdp_icon_badge","index":2,"icon":"https://salt.tikicdn.com/ts/upload/be/67/48/04a82ab8df178e1a13bde38316081865.png","icon_width":91,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":true,"return_reason":"any_reason"}},"discount":91000,"discount_rate":38,"rating_average":4.5,"review_count":4,"review_text":"(4)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/8f/78/8d/e8efad3eaf751af7fb28c6e95914c0ca.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":641,"all_time_quantity_sold":21,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: justify;\"\u003eBài tập bổ trợ nâng cao kỹ năng Hóa học dành cho học sinh khối Trung học Phổ thông là bộ sách giúp các em có một tài liệu để tự ôn luyện và nâng cao kỹ năng làm bài môn Hóa học và chuẩn bị cho các bài kiểm tra trên lớp cũng như chuẩn bị cho kì thi THPT Quốc Gia\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/a2/75/86/9a3c6f29ff8071d439d6f1beb972fb04.jpg\" alt=\"\" width=\"750\" height=\"323\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eCombo Bài tập bổ trợ nâng cao kỹ năng Hóa học Lớp 10 gồm 2 cuốn tập 1 và tập 2\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cspan class=\"TextRun SCXW110240470 BCX0\" lang=\"VI-VN\" xml:lang=\"VI-VN\" data-contrast=\"auto\"\u003e\u003cspan class=\"NormalTextRun SCXW110240470 BCX0\"\u003eĐiểm nổi bật đặc biệt của sách:\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e1. Bài tập bổ trợ đa dạng, nâng cao theo chủ đề\u003c/p\u003e\n\u003cul\u003e\n\u003cli style=\"text-align: justify;\"\u003eHệ thống các bài tập trắc nghiệm theo chủ đề của từng chương, bám sát chương trình học trên lớp, giúp các em có thể thực hành, vận dụng kiến thức đã được học trên lớp vào các bài tập cụ thể.\u003c/li\u003e\n\u003cli style=\"text-align: justify;\"\u003eMỗi đề luyện tập bao gồm các câu hỏi trắc nghiệm bao trùm toàn bộ kiến thức đã được học trong một chủ đề. Việc luyện tập thường xuyên ngay sau khi học bài trên lớp sẽ giúp các em có một nền tảng kiến thức vững chắc.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align: justify;\"\u003e2. Đề kiểm tra giữa kỳ và Đề kiểm tra cuối kỳ bám sát đề kiểm tra\u003c/p\u003e\n\u003cul\u003e\n\u003cli style=\"text-align: justify;\"\u003eCác bài tập chuyên sâu đa dạng, bám sát đề kiểm tra, giúp các em chinh phục các điểm 8+ trong kì thi giữa kì và cuối kì.\u003cbr /\u003eBài tập mang tính chất tổng hợp những kiến thức đã được học trong nửa kỳ và cả học kỳ. Việc luyện đề sẽ giúp các em chuẩn bị đủ kiến thức và tâm lý cho hai kỳ thi quan trọng trong kỳ học, tự tin chinh phục điểm 8+.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align: justify;\"\u003e3. Đáp án chi tiết\u003c/p\u003e\n\u003cul\u003e\n\u003cli style=\"text-align: justify;\"\u003eHệ thống lời giải chi tiết, các em có thể dễ dàng kiểm tra và đánh giá năng lực bản thân. Bên cạnh đó, những ghi chú kiến thức giúp người học dễ dàng ghi nhớ những phần kiến thức quan trọng.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align: justify;\"\u003eMegabook hy vọng rằng, bộ sách này sẽ là một người bạn đồng hành hữu ích để cùng các em học tốt môn Hóa học, sẽ giúp các em nắm chắc kiến thức cũng như chuẩn bị hành trang thật kỹ lưỡng cho chặng đường chinh phục kì thi THPT Quốc gia môn Hóa học sau này.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/8f/78/8d/e8efad3eaf751af7fb28c6e95914c0ca.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/8f/78/8d/e8efad3eaf751af7fb28c6e95914c0ca.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/8f/78/8d/e8efad3eaf751af7fb28c6e95914c0ca.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8f/78/8d/e8efad3eaf751af7fb28c6e95914c0ca.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8f/78/8d/e8efad3eaf751af7fb28c6e95914c0ca.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/be/bf/33/e4f6ba4cf4a4f70942f9b06df26b21f7.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/be/bf/33/e4f6ba4cf4a4f70942f9b06df26b21f7.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/be/bf/33/e4f6ba4cf4a4f70942f9b