e877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":true,"return_reason":"any_reason"}},"discount":25200,"discount_rate":35,"rating_average":5,"review_count":75,"review_text":"(75)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/0f/f9/70/e273b6980de4f6f550329aafe91578d8.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":467,"all_time_quantity_sold":1195,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003e\u003cstrong\u003eBúp Sen Xanh\u003c/strong\u003e\u003c/h3\u003e\n\u003ch3\u003e\u003cstrong\u003eGiới thiệu tác giả\u003c/strong\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eNhà văn Sơn Tùng, sinh năm 1928 tại Diễn Châu, Nghệ An. Ông được Nhà nước phong tặng danh hiệu Anh hùng Lao động thời kì đổi mới, năm 2011. Ông là nhà văn Việt Nam với nhiều tác phẩm về lãnh tụ Hồ Chí Minh và các danh nhân cách mạng, danh nhân văn hóa Việt Nam, trong đó nổi tiếng nhất là tiểu thuyết Búp sen xanh viết về cuộc đời Hồ Chí Minh.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003e\u003cstrong\u003eLời nói đầu/Giới thiệu sách\u003c/strong\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003e“Búp Sen Xanh” là cuốn tiểu thuyết nổi tiếng nhất của nhà văn Sơn Tùng - người đã dành trọn cuộc đời mình để viết về Bác Hồ và các vị anh hùng, những nhà cách mạng lỗi lạc của dân tộc. Tác phẩm “Búp Sen Xanh” kể về thời thơ ấu và một phần tuổi trẻ của cậu bé Nguyễn Sinh Cung ở làng quê Nghệ An, rồi kinh đô Huế - nơi đã nuôi dưỡng ý chí, tâm hồn và nhân cách của một nhà hoạt động cách mạng vĩ đại.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003e“Không hiểu sao, mỗi lần nhớ đến nhà văn Sơn Tùng, tôi lại nghĩ ông như một quả dừa khô, tích nắng, tích nước để cuối cùng bật lên một chồi cây xanh, sắc và đẹp như một lưỡi mác.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eCả cuộc đời mình, nhà văn Sơn Tùng đã không ngừng tích lũy, tìm kiếm tư liệu, vượt lên thương tật để nghiên cứu, viết về Chủ tịch Hồ Chí Minh. Ông có những hiểu biết, tư liệu về lãnh tụ mà không phải bất cứ một nhà nghiên cứu nào cũng có được…” - Nhà văn Nguyễn Trí Huân\u003c/span\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eĐối tượng sử dụng\u003c/strong\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003ePhù hợp với nhiều độ tuổi\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003e\u003cstrong\u003eTóm tắt nội dung\u003c/strong\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cstrong\u003e\"Búp Sen Xanh\"\u003c/strong\u003e\u003cspan style=\"font-weight: 400;\"\u003e là một bức tranh sinh động về thời niên thiếu của Nguyễn Sinh Cung tại làng Sen quê ngoại. Tác giả Sơn Tùng đã rất tài tình khi khắc họa một cậu bé thông minh, hiếu học, sớm ý thức được nỗi đau của đất nước và nung nấu ý chí cứu nước. Qua ngòi bút của nhà văn, chúng ta được sống lại những khoảnh khắc đáng nhớ trong cuộc đời của Bác, từ những trò chơi dân gian, những câu chuyện truyền miệng của bà con làng xóm, đến những suy tư sâu sắc về đất nước và con người.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eCuốn sách không chỉ đơn thuần là một tiểu thuyết lịch sử, mà còn là một tác phẩm văn học nghệ thuật. Ngôn ngữ trong sáng, giàu hình ảnh, cùng với những chi tiết sinh động đã giúp \"Búp Sen Xanh\" trở thành một cuốn sách được nhiều thế hệ bạn đọc yêu thích. Qua đó, tác giả đã khơi gợi trong lòng độc giả tình yêu kính trọng đối với Bác Hồ, vị lãnh tụ vĩ đại của dân tộc Việt Nam.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003e\u003cstrong\u003eTrích đoạn\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/8a/7d/2b/131e66b917a1c133db3b13ac52b63cc8.jpg\" alt=\"\" width=\"750\" height=\"564\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/3b/8f/f6/4e18c9b119c1c9ad3bc756dcbd604a98.jpg\" alt=\"\" width=\"750\" height=\"890\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eTrích đánh giá và nhận xét\u003c/strong\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003e“\u003c/span\u003e\u003cspan style=\"font-weight: 400;\"\u003eSách rất hay, rất đáng đọc ạ. Khi đọc cuốn sách này, em được biết đến những khía cạnh mà trước đây em chưa được biết, em được hiểu về gốc gác của họ nhà Bác... Tuy chưa đọc hết, nhưng em cảm thấy rất may mắn khi đọc cuốn sách này, hy vọng cuốn sách sẽ được nhiều bạn biết đến hơn” - Trích độc giả\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003e\u003cstrong\u003eƯu điểm\u003c/strong\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cstrong\u003eMiêu tả chân thực về tuổi thơ của Bác:\u003c/strong\u003e\u003cspan style=\"font-weight: 400;\"\u003e Cuốn sách tái hiện một cách sinh động và chân thực về tuổi thơ đầy khó khăn nhưng cũng rất đẹp đẽ của Chủ tịch Hồ Chí Minh. Qua đó, độc giả nhỏ tuổi có thể hiểu rõ hơn về cuộc đời và sự nghiệp cách mạng vĩ đại của Bác.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cstrong\u003eNgôn ngữ giản dị, dễ hiểu:\u003c/strong\u003e\u003cspan style=\"font-weight: 400;\"\u003e Ngôn ngữ của tác phẩm rất trong sáng, gần gũi với trẻ em, giúp các em dễ dàng tiếp cận và hiểu được những câu chuyện lịch sử.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cstrong\u003eGiá trị giáo dục cao:\u003c/strong\u003e\u003cspan style=\"font-weight: 400;\"\u003e Búp Sen Xanh không chỉ là một cuốn truyện hay mà còn là một bài học sinh động về lòng yêu nước, tinh thần cách mạng, sự kiên trì và nghị lực của Bác Hồ.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cstrong\u003eMinh họa đẹp mắt:\u003c/strong\u003e\u003cspan style=\"font-weight: 400;\"\u003e Những bức tranh minh họa trong sách rất sinh động và màu sắc, giúp các em hình dung rõ hơn về các nhân vật và sự kiện trong truyện.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eCác tác phẩm của tác giả Sơn Tùng:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eBên khung cửa sổ (NXB Lao động, 1974)\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eNhớ nguồn (NXB Phụ nữ, 1975)\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eCon người và con đường (NXB Phụ nữ, 1976)\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eTrần Phú (NXB Thanh niên, 1980)\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eNguyễn Hữu Tiến (NXB Thanh niên, 1981)\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eBúp sen xanh (NXB Kim Đồng, 1982)\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eBông sen vàng (NXB Đà Nẵng, 1990)\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eTrái tim quả đất (NXB Thanh niên, 1990)\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eHoa râm bụt (NXB Công an Nhân dân, 1990)\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eMẹ về (NXB Phụ nữ, 1990)\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eVườn nắng (NXB Thanh niên, 1997)\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eSáng ánh tâm đăng Hồ Chí Minh (NXB Công an Nhân dân, 2005)\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eBác ở nơi đây (NXB Thanh niên, 2005)\u003c/span\u003e\u003c