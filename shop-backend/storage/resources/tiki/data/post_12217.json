71483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":101000,"discount_rate":12,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/f2/29/08/6bf0dcf49f54db0efcd549b6603369fa.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":475,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<h2>Thông số kỹ thuật:</h2>\n<p>Kiểu đeo: Móc vành, dẫn truyền không khí</p>\n<p>Trình điều khiển: Dynamic 16.2mm</p>\n<p>Thời lượng pin: 16 giờ</p>\n<p>Kết nối: Bluetooth 5.3 hỗ trợ codec SBC/AAC</p>\n<p>Trọng lượng: 28g</p>\n<p>Chuẩn kháng nước: IPX4</p>\n<p> </p>\n<p><img style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/b3/88/bb/f8f76b4dba8903028f94d2c648072712.jpg\" alt=\"\" width=\"750\" height=\"375\" /></p>\n<p> </p>\n<h2>Tai nghe Soundpeats RunFree Lite</h2>\n<h3 class=\"irIKAp\">Thiết Kế Open – Ear</h3>\n<p class=\"irIKAp\">Với thiết kế dạng Open-ear, tai nghe có thể nằm nhẹ nhàng và ôm khít tai mà không lọt vào ống tai. Không có hiện tượng chèn ép vành tai, không gây tắc nghẽn ống tai và không gây đau hay tổn thương thính giác. Bạn có thể vừa tập luyện, vừa tận hưởng âm nhạc, vừa lắng nghe cuộc sống đang diễn ra xung quanh cùng tai nghe Bluetooth thể thao SoundPEATS RunFree Lite.</p>\n<p class=\"irIKAp\"> </p>\n<p class=\"irIKAp\"><img style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/55/7f/38/dcaf4dc81ff6f155f3be625e24d4b1a6.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p class=\"irIKAp\"> </p>\n<h3 class=\"irIKAp\">Vừa Vặn, Nhẹ &amp; An Toàn</h3>\n<p class=\"irIKAp\">Chất liệu silicon thân thiện với da và thiết kế gọng Titan tiện dụng giúp tai nghe không dây thể thao SoundPEATS Runfree Lite ổn định và giữ đúng vị trí trong quá trình luyện tập cường độ cao. Trọng lượng siêu nhẹ 27g và thiết kế nhỏ gọn đảm bảio vừa vặn và thoải mái, có thể đeo cả ngày mà không mỏi tai, nặng tai.</p>\n<p class=\"irIKAp\"> </p>\n<p class=\"irIKAp\"><img style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/8e/e6/0e/3beac1eaf130e5526b4ce15a37341978.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p class=\"irIKAp\"> </p>\n<h3 class=\"irIKAp\">Chất Lượng Âm Thanh Cao Cấp</h3>\n<p class=\"irIKAp\">Trang bị Driver lớn 16,2mm kết hợp cùng công nghệ tăng cường âm trầm, tai nghe thể thao SoundPEATS RunFree Lite mang đến trải nghiệm nghe tốt nhất với âm thanh rõ ràng, âm lượng mạnh mẽ và âm trầm phong phú.</p>\n<p class=\"irIKAp\"> </p>\n<p class=\"irIKAp\"><img style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/1d/39/a1/fd0bc95e0b9f75f1a7a19fefef2fda97.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p> </p>\n<h3 class=\"irIKAp\">Ngăn Chặn Rò Rỉ Âm Thanh</h3>\n<p class=\"irIKAp\">Sử dụng truyền âm thanh rung trong không khí, âm thanh vòm nổi, sảng khoái, bạn có thể âm thanh trọn vẹn và thoải mái. Lỗ âm thanh trên tai nghe áp dụng công nghệ truyền âm thanh định hướng đặc biệt, giảm rò rỉ âm thanh hiệu quả hơn và mang lại sự riêng tư cao hơn.</p>\n<p class=\"irIKAp\"> </p>\n<p class=\"irIKAp\"><img style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/68/95/1c/db3dbc0fe86410364960d7eb19c5b09f.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<h3 class=\"irIKAp\">Thời Gian Sử Dụng Lâu Dài</h3>\n<p class=\"irIKAp\">Thời gian chơi 17 giờ cho mỗi lần sạc. Tận hưởng 17 giờ nghe nhạc, gọi điện và nghe podcast liên tục với tai nghe bluetooth thể thao RunFree Lite.</p>\n<p class=\"irIKAp\"> </p>\n<p><img style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/ef/64/ff/65384c44ef6f550e79f6da02f17f101d.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p> </p>\n<h3 class=\"irIKAp\">Kết Nối Đồng Thời Hai Thiết Bị</h3>\n<p class=\"irIKAp\">Với kết nối kép của tai nghe, hỗ trợ mọi sự kết hợp giữa điện thoại thông minh, máy tính bảng, PC và các thiết bị hỗ trợ Bluetooth khác. Xem video trên máy tính bảng của bạn trong khi nhận cuộc gọi từ điện thoại thông minh của bạn.</p>\n<p class=\"irIKAp\"> </p>\n<p class=\"irIKAp\"><img style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/ed/84/cc/1364292a88b27e51829f4e5c43f99df8.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<h3 class=\"irIKAp\">Điều Khiển Nút Dễ Dàng</h3>\n<p class=\"irIKAp\">Các nút trên tai nghe giúp bạn dễ dàng điều khiển trả lời/từ chối/ngắt cuộc gọi, phát/tạm dừng, bài hát trước/tiếp theo, điều chỉnh âm lượng, trợ lý giọng nói, v.v.</p>\n<p class=\"irIKAp\"> </p>\n<p class=\"irIKAp\"><img style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/36/fd/dd/385c46435e41e825b905e41e971f0cff.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p class=\"irIKAp\"> </p>\n<h2 class=\"irIKAp\">SoundPEATS RunFree Lite hỗ trợ kết nối App SoundPEATS</h2>\n<p class=\"irIKAp\">- Hiển thị dung lượng pin còn lại của tai nghe.</p>\n<p class=\"irIKAp\">- Điều chỉnh âm lượng trên tai nghe</p>\n<p class=\"irIKAp\">- Quản lý chế độ tai nghe, âm trầm, âm bổng và âm trung.</p>\n<p class=\"irIKAp\">- Reset: Dễ dàng xóa tất cả các bản ghi ghép nối bằng chức năng Đặt lại.</p>\n<p class=\"irIKAp\">- Nâng cấp phần mềm: Để nâng cấp chương trình cơ sở mới nhất thông qua APP.</p>\n<p class=\"irIKAp\">- Hỗ trợ Adaptive EQ và Gamemode.</p>\n<p class=\"irIKAp\"> </p>\n<p class=\"irIKAp\"><img style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/f6/8d/bf/cf0a2e0a39eb38ef77d6f606612712cb.jpg\" alt=\"\" width=\"750\" height=\"306\" /></p>\n<h3 class=\"irIKAp\">Bộ sản phẩm SoundPEATS RunFree Lite bao gồm:</h3>\n<p class=\"irIKAp\">1x RunFree Lite Earphones</p>\n<p class=\"irIKAp\">1x Dây sạc</p>\n<p class=\"irIKAp\">1x HDSD</p>\n<p class=\"irIKAp\"><img style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/61/e6/5d/ce312d764eaccb079c495cafc384d1e6.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<h3 class=\"_2jrvqA\">Sản phẩm được phân phối chính hãng tại SoundPEATS Vietnam với dịch vụ chăm sóc khách hàng và bảo hành sản phẩm tốt nhất.</h3>\n<h2 class=\"_2jrvqA\">Bảo hành</h2>\n<p class=\"_2jrvqA\">Bảo hành chính hãng 12 tháng</p>\n<p class=\"_2jrvqA\">Bảo hành 1 đổi 1 (Đối với lỗi từ nhà sản xuất)</p>\n<p class=\"_2jrvqA\">Bảo hành thông qua mã đơn mua hàng trên sàn Tiki, không cần hóa đơn.</p>\n<p class=\"_2jrvqA\">Tất cả sản phẩm công ty phân phối đều bảo hành qua mã đơn hàng, khách hàng ở tỉnh nếu không đến trực tiếp có thể gửi qua đường bưu điện, bên công ty sẽ gửi hàng bảo hành tận nơi cho các bạn.</p>\n<p class=\"_2jrvqA\">Trung tâm bảo hành SoundPEATS Vietnam: Phường An Phú, Quận 2, HCM.</p>\n<h3 class=\"_2jrvqA\"><strong>Điều kiện bảo hành:</strong> Vui lòng giữ lại HỘP của sản phẩm và khi cần bảo hành vui lòng chat với Shop qua app Tiki.</h3>\n<h2 class=\"_2jrvqA\"> Hỗ trợ khách hàng</h2>\n<p class=\"_2jrvqA\">Hỗ trợ tư vấn qua khung chat với Shop trên app Tiki</p>\n<p class=\"_2jrvqA\">Thời gian làm việc: 8h - 12h00 và 13h30 - 17h00 (Từ thứ 2 đến thứ 6, trừ các ngày Lễ/Tết).</p>\n<h3 class=\"_2jrvqA\"> Vui lòng QUAY VIDEO khui gói hàng trước khi mở gói hàng để đảm bảo SHOP giao đúng và đủ đơn hàng. Cảm ơn quý khách đã ủng hộ!</h3><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/f2/29/08/6bf0dcf49f54db0efcd549b6603369fa.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f2/29/08/6bf0dcf49f54db0efcd549b6603369fa.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f2/29/08/6bf0dcf49f54db0efcd549b6603369fa.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f2/29/08/6bf0dcf49f54db0efcd549b6603369fa.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f2/29/08/6bf0dcf49f54db0efcd549b6603369fa.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/87/2e/79/46812d7987acab877d6e947618eb0ba1.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/87/2e/79/46812d7987acab877d6e947618eb0ba1.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/87/2e/79/46812d7987acab877d6e947618eb0ba1.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/87/2e/79/46812d7987acab877d6e947618eb0ba1.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/87/2e/79/46812d7987acab877d6e947618eb0ba1.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/48/1b/89/f8802c0ff4c48bfa451fdfd687fb18df.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/48/1b/89/f8802c0ff4c48bfa451fdfd687fb18df.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/48/1b/89/f8802c0ff4c48bfa451fdfd687fb18df.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/48/1b/89/f8802c0ff4c48bfa451fdfd687fb18df.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/48/1b/89/f8802c0ff4c48bfa451fdfd687fb18df.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/cf/eb/3d/3c4d0911539363eb665830c9ee085f4f.jpg","is_gallery":true,"label":null,"large_url":