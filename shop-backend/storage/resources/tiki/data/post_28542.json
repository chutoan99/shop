6ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/45/07/07/55f5e0e2b4c5fd3ec5f8c1129e47b96c.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":88,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003chtml\u003e\n \u003chead\u003e\u003c/head\u003e\n \u003cbody\u003e\n  \u003cp\u003eTHÔNG TIN TÁC PHẨM\u003c/p\u003e\n  \u003cp\u003e- Tên tác phẩm: Bé Học Xác Định Vị Trí Tập 3\u003c/p\u003e\n  \u003cp\u003e- Tác giả/Dịch giả: Hoa Mai\u003c/p\u003e\n  \u003cp\u003e- Thương hiệu: SBOOKS-KID\u003c/p\u003e\n  \u003cp\u003e- Nhà xuất bản: Hồng Đức\u003c/p\u003e\n  \u003cp\u003e- Năm xuất bản: 2018\u003c/p\u003e\n  \u003cp\u003e- Loại bìa: Bìa mềm\u003c/p\u003e\n  \u003cp\u003e- Khổ: 17x24 cm\u003c/p\u003e\n  \u003cp\u003e- Số trang: 24 trang\u003c/p\u003e\n  \u003cp\u003e________________________\u003c/p\u003e\n  \u003cp\u003eGIỚI THIỆU TÁC PHẨM\u003c/p\u003e\n  \u003cp\u003eBỘ SÁCH 06 CUỐN BÉ VUI HỌC TOÁN tích hợp nhiều dạng kiến thức và bài tập cho bé làm quen với các khái niệm trong toán học: So sánh to hơn, nhỏ hơn,, xác định vị trí: trước- sau, bên phải- bên trái, nhận diện, phân biệt hình dạng và màu sắộ sách có nhiều hình ảnh thân thuộc, gần gũi, màu sắc sống động mang lại cảm giác tò mò và hứng thú giúp bé vừa học, vừa chơi, vừa rèn luyện khả năng quan sát, rèn khả năng tập trung và tính toán.\u003c/p\u003e\n  \u003cp\u003eTrọn bộ 06 cuốn dành cho các bé từ 3- 6 tuổi. Đây là thời gian vàng giúp thúc đẩy và phát triển sự nhận biết, ghi nhớ mọi thứ xung quanh và tập nói của các bé, vì thế bố mẹ nên dành thời gian nhiều hơn cho con, đồng hành và sánh bước cùng con trên mọi trận đường. Bộ sách được biên soạn khoa học phù hợp với lứa tuổi mầm non giúp trẻ phát triển tư duy logic về toán học, đồng thời khuyến khích lối tư duy tích cực linh hoạt, nhanh nhạy.\u003c/p\u003e\n  \u003cp\u003eEm học Toán thật vui với bộ sách: Bé học so sánh tập 1, tập 2; Bé học xác định vị trí tập 3, tập 4; Bé học hình dạng tập 5 và Bé học màu sắc tập 6.\u003c/p\u003e\n  \u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/product/9b/14/c1/cc7b4e104ce7bd038f2fb2cb84b73b4f.jpg\" width=\"3024\" height=\"3024\"\u003e\u003c/p\u003e\n  \u003cp\u003eTập 3- 4: Bé học xác định vị trí\u003c/p\u003e\n  \u003cp\u003eHai tập sách này giúp bé xác định được các vị trí cơ bản: phía trước- phía sau, bên phải- bên trái, phía trên- phía dưới,ủa vật so với bản thân hoặc đồ vật khác. Rèn luyện kỹ năng quan sát, định hướng trong không gian và chú ý, tập trung cho các bé.\u003c/p\u003e\n  \u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/product/45/07/07/ef257f32b6154c06651cbc9402e9b686.jpg\" width=\"3024\" height=\"3024\"\u003e\u003c/p\u003e\n  \u003cp\u003eTỦ SÁCH GIÁO DỤC SBOOKS - KID CAM KẾT:\u003c/p\u003e\n  \u003cp\u003e- Mọi đơn hàng đều được đóng gói tỉ mỉ và cẩn thận.\u003c/p\u003e\n  \u003cp\u003e- Sbooks luôn có chương trình tốt cho mọi đơn hàng.\u003c/p\u003e\n  \u003cp\u003e- Đổi trả sản phẩm trong vòng 7 ngày nếu lỗi từ nhà sản xuất.\u003c/p\u003e\n \u003c/body\u003e\n\u003c/html\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"ba