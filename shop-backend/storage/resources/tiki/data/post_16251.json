,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":74000,"discount_rate":20,"rating_average":4.5,"review_count":86,"review_text":"(86)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/8e/a1/ff/ec5eb1b7863889d4b2c8cc51103eb0bc.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1374,"all_time_quantity_sold":451,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/52/96/3f/36e00c6e222fe1547e0e0351d773d137.jpg\" alt=\"\" width=\"750\" height=\"375\" /\u003e\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eThành phần Hàu Biển OB New:\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003eThành phần cho 1 viên nén:\u003c/p\u003e\n\u003cp\u003eo    Bột Hàu Biển …………………………………………… 500mg\u003c/p\u003e\n\u003cp\u003eo    Cao Nhân Sâm ………………………………………… 300mg\u003c/p\u003e\n\u003cp\u003eo    Bột chiết xuất Hải Sâm …………………………… 150mg\u003c/p\u003e\n\u003cp\u003ePhụ liệu: Lactose, Tinh bột, Magnesium stearate, Titan Dioxyd, Hydroxypropyl Methylcellulose, Polyethylene Glycol vừa đủ 1 viên nén.\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eCông dụng:\u003c/strong\u003e\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cp\u003eGiúp bổ thận, hỗ trợ tăng cường sinh lực nam.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003eLàm chậm quá trình mãn duc nam và gia tăng ham muốn.\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eHỗ trợ vấn đề yếu sinh lý, xuất sớm\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eHỗ trợ tình trạng vô sinh, hiếm muộn thông qua cải thiện số lượng và chất lượng tinh trùng khỏe mạnh.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eHỗ trợ tăng Testosteron nội sinh\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch2\u003eBạn bị yếu sinh lý, xuất sớm, rối loạn cương, tinh trùng yếu là do:\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cp\u003eSuy giảm Testosteron.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eThường xuyên bị stress, căng thẳng tâm lý.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eThể chất yếu, hay mệt mỏi vai gối, suy nhược cơ thể do thận yếu.\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch2\u003e\u003cstrong\u003eCách sử dụng Hàu biển OB New\u003c/strong\u003e\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cp\u003eUống 2 viên/ngày, sau ăn sáng. \u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003eKhông nên uống vào buổi tối, do có thành phần Nhân sâm - giúp tỉnh táo, khó ngủ.\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eMỗi đợt sử dụng liên tục từ 1-3 tháng. Sản phẩm an toàn nên có thể sử dụng thường xuyên.\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eLưu ý: Người có tiền sử dị ứng hàu nên thận trọng khi sử dụng\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eChống chỉ định\u003c/strong\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cp\u003eThành phần chính yếu của sản phẩm này là hàu sữa tự nhiên, hải sâm, nhân sâm. Mặc dù là thực phẩm bổ dưỡng, “thần dược tình yêu” nhưng có không ít người dị ứng. Cho nên nếu đấng mày râu mẫn cảm với hải sản hay bất kì thành phần nào thì không nên sử dụng Hàu Biển OB New.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eNgoài ra, hãy thận trọng khi sử dụng loại Hàu Biển OB New này cho những người bị bệnh tiểu đường, huyết áp cao, bệnh tim mạch, theo dõi kỹ biểu hiện và điều chỉnh liều lượng phù hợp.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eKhông sử dụng Hàu Biển OB New tăng cường sinh lý nam cho trẻ dưới 18 tuổi và phụ nữ.\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eQuy cách đóng gói và chất liệu bao bì:\u003c/strong\u003e Vỉ 10 viên. Hộp 2 vỉ\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eSố đăng ký:\u003c/strong\u003e 9362/2020/ĐKSP\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eSản xuất tại\u003c/strong\u003e: Công ty TNHH Dược Phẩm USAPHA – Khu công nghiệp Tiên Sơn, xã Hoàn Sơn, huyện Tiên Du, Tỉnh Bắc Ninh, Việt Nam\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/8e/a1/ff/ec5eb1b7863889d4b2c8cc51103eb0bc.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/8e/a1/ff/ec5eb1b7863889d4b2c8cc51103eb0bc.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/8e/a1/ff/ec5eb1b7863889d4b2c8cc51103eb0bc.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8e/a1/ff/ec5eb1b7863889d4b2c8cc51103eb0bc.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8e/a1/ff/ec5eb1b7863889d4b2c8cc51103eb0bc.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/24/ff/e7/746e40c25dc7925270de2395860d7b8e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/24/ff/e7/746e40c25dc7925270de2395860d7b8e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/24/ff/e7/746e40c25d