.\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/da/0d/c1/b46a05ba5464b58b504ecda438761587.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/da/0d/c1/b46a05ba5464b58b504ecda438761587.jpg\" alt=\"\" width=\"undefined\" height=\"undefined\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/8f/18/6f/17709d44d4ee34e4ba439cd2d3449143.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/8f/18/6f/17709d44d4ee34e4ba439cd2d3449143.jpg\" alt=\"\" width=\"undefined\" height=\"undefined\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/69/8a/07/a947f91896dfbada3c4456aa2f7ab83f.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/69/8a/07/a947f91896dfbada3c4456aa2f7ab83f.jpg\" alt=\"\" width=\"undefined\" height=\"undefined\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/27/ad/ce/330757af250d6d6fe33d2ef296745782.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/27/ad/ce/330757af250d6d6fe33d2ef296745782.jpg\" alt=\"\" width=\"undefined\" height=\"undefined\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/e7/c7/d5/7fae7620914c0c51317ba9874f758564.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/e7/c7/d5/7fae7620914c0c51317ba9874f758564.jpg\" alt=\"\" width=\"undefined\" height=\"undefined\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/b0/bc/2a/18f8c6a117cad545c2870cd2411cb57c.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/b0/bc/2a/18f8c6a117cad545c2870cd2411cb57c.jpg\" alt=\"\" width=\"undefined\" height=\"undefined\" /\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/cf/27/9f/921f76fd35b239ede7edebe8706b9288.jpeg\" alt=\"\" width=\"750\" height=\"562\" /\u003e\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003e\u003cstrong\u003eHướng dẫn bảo quản :\u003c/strong\u003e\u003c/p\u003e\n\u003c