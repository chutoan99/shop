icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":80000,"discount_rate":24,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/88/02/34/cf714a7cd28cc532780eb429db351e2f.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":183,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eCốc Giữ Nhiệt UNIE UMC460: Tạo dấu ấn riêng với cốc giữ nhiệt thế hệ mới.\u003c/p\u003e\n\u003cp\u003eVới thiết kế đẹp mắt cùng những tiêu chuẩn cách nhiệt vượt trội, Cốc giữ nhiệt UNIE UMC460 trở thành sự lựa chọn tuyệt vời đáp ứng đầy đủ các yêu cần về an toàn cho sức khỏe và sự tiện lợi.\u003c/p\u003e\n\u003cp\u003eCách nhiệt chân không\u003c/p\u003e\n\u003cp\u003eMột trong những đặc điểm nổi bật của Cốc UNIE UMC460 là công nghệ cách nhiệt chân không. Được thiết kế với lớp chân không đặc biệt, chiếc cốc này giúp giữ nhiệt hoặc lạnh tối đa trong thời gian dài.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lq1qam5cllx37f\" width=\"2048\" height=\"2048\" alt=\"vn-11134208-7r98o-lq1qam5cllx37f\" /\u003e\u003c/p\u003e\n\u003cp\u003eBạn có thể tận hưởng nước nóng vào mùa đông hoặc đá lạnh vào mùa hè mà không cần lo lắng về nhiệt độ bên ngoài.\u003c/p\u003e\n\u003cp\u003eInox 304 an toàn cho sức khỏe\u003c/p\u003e\n\u003cp\u003eCốc UNIE UMC460 được làm từ chất liệu inox 304 cao cấp, không chỉ an toàn cho sức khỏe mà còn dễ vệ sinh và bảo quản.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lq1qam5cn0hj12\" width=\"2500\" height=\"2500\" alt=\"vn-11134208-7r98o-lq1qam5cn0hj12\" /\u003e\u003c/p\u003e\n\u003cp\u003eQuai xách và nắp rời tiện lợi\u003c/p\u003e\n\u003cp\u003eVới quai xách tiện lợi, bạn có thể dễ dàng cầm theo cốc giữ nhiệt UNIE UMC460 đi muôn nơi. Nắp rời với thiết kế thông minh, tiện lợi giúp bạn lấy nước hoặc vệ sinh cốc một cách nhanh chóng và hiệu quả, tiết kiệm thời gian và tránh rò rỉ nước.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lq1qam5cof1z81\" width=\"2500\" height=\"2500\" alt=\"vn-11134208-7r98o-lq1qam5cof1z81\" /\u003e\u003c/p\u003e\n\u003cp\u003eĐế chống trượt\u003c/p\u003e\n\u003cp\u003eĐể đảm bảo an toàn và ổn định, Cốc UNIE UMC460 được trang bị đế chống trượt giúp người dùng dễ dàng đặt cốc trên bất kỳ bề mặt phẳng nào mà không phải lo lắng về việc nó sẽ trượt hay đổ đựng. \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lq1qam5cptmfe4\" width=\"2048\" height=\"2048\" alt=\"vn-11134208-7r98o-lq1qam5cptmfe4\" /\u003e\u003c/p\u003e\n\u003cp\u003eTHÔNG SỐ KỸ THUẬT\u003c/p\u003e\n\u003cp\u003eMàu: Be\u003c/p\u003e\n\u003cp\u003eNắp: Rời\u003c/p\u003e\n\u003cp\u003eChất liệu: inox 304, nhựa PP\u003c/p\u003e\n\u003cp\u003eDung tích: 460ml\u003c/p\u003e\n\u003cp\u003eKhối lượng tịnh: 300g\u003c/p\u003e\n\u003cp\u003eKích thước: 17.5 x 9cm\u003c/p\u003e\n\u003cp\u003eBảo hành: 12 tháng\u003c/p\u003e\n\u003cp\u003ePhụ kiện: Ống hút, quai xách\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lq1qam5cr86v74\" width=\"2500\" height=\"2500\" alt=\"vn-11134208-7r98o-lq1qam5cr86v74\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e#binhgiunhiet #binhunie #unie #binhgiunhietcoonghut\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/88/02/34/cf714a7cd28cc532780eb429db351e2f.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/88/02/34/cf714a7cd28cc532780eb429db351e2f.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/88/02/34/cf714a7cd28cc532780eb429db351e2f.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/88/02/34/cf714a7cd28cc532780eb429db351e2f.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/88/02/34/cf714a7cd28cc532780eb429db351e2f.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/cf/02/a1/77250e3dc59e5578a7e1a4dc4fff87bd.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/cf/02/a1/77250e3dc59e5578a7e1a4dc4fff87bd.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/cf/02/a1/77250e3dc59e5578a7e1a4dc4fff87bd.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/cf/02/a1/77250e3dc59e5578a7e1a4dc4fff87bd.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/cf/02/a1/77250e3dc59e5578a7e1a4dc4fff87bd.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/d2/e9/a8/f5d89ce9ee5586b176a2b894c9c7e7db.jpg","is_gallery":true,"label