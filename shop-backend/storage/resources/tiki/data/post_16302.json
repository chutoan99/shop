ull,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.6,"review_count":304,"review_text":"(304)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ca/03/63/5c3887a85fac606cf4080ec63e3b446a.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1879,"all_time_quantity_sold":1521,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eSáp tạo kiểu tóc nam cứng mờ Aurane Cool Stylish Clay 80ml\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eSáp tạo kiểu mờ Aurane Cool Stylish Clay là sản phẩm tạo kiểu tóc sử dụng công thức dạng sáp cứng cấp độ 5, dễ dàng bám đều trên từng sợi tóc, giúp tóc vào nếp, định hình kiểu tóc như ý muốn và duy trì mái tóc đẹp tự nhiên trong nhiều giờ.`\u003c/p\u003e\n\u003cp\u003eCông thức hòa tan đặc biệt, có thể tạo tóc rối phồng, giúp tạo hình cho mái tóc. Chứa đựng thành phần bùn thiên nhiên, sản phẩm chăm sóc mái tóc, giúp tóc được tạo hình lâu, dễ dàng tạo các kiểu tóc đứng thời thượng.\u003c/p\u003e\n\u003cp\u003eSáp tạo kiểu cứng mờ Aurane Cool Stylish Clay\u003c/p\u003e\n\u003cp\u003eDạng sáp mềm dễ dàng bám đều trên từng sợi tóc\u003c/p\u003e\n\u003cp\u003eTạo kiểu dễ dàng, bền lâu.\u003c/p\u003e\n\u003cp\u003eMùi hương thơm lôi cuốn\u003c/p\u003e\n\u003cp\u003eHiệu ứng bóng mờ, giữ ẩm và có chất nuôi dưỡng tóc\u003c/p\u003e\n\u003cp\u003eVi hạt khoáng chất chống tia tử ngoại hiệu quả, mùi hương dễ chịu, cảm giác thoải mái không dính bệt, không bắt bụi và rất nhẹ tóc. Với mái tóc đẹp thêm phần tự tin giúp bạn dễ dàng chinh phục các cô gái.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eHướng dẫn sử dụng và bảo quản\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eLấy một lượng vừa đủ thoa đều lên tóc\u003c/p\u003e\n\u003cp\u003eDùng lược hoặc ngón tay tạo kiểu theo ý muốn\u003c/p\u003e\n\u003cp\u003eBảo quản nơi khô ráo, thoáng mát, tránh ánh nắng trực tiếp và nhiệt độ cao\u003c/p\u003e\n\u003cp\u003eĐể xa tầm tay trẻ em\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/ca/d2/0d/9c79e5da1effd67c2e95abb933ed4069.jpg\" alt=\"\" width=\"750\" height=\"276\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThông tin thương hiệu\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eAurane là thương hiệu chăm sóc tóc đến từ nước Pháp. Tên gọi Aurane được đặt theo tên cô con gái của nhà sáng lập khi cả gia đình chuyển đến thị trấn nhỏ ở miền Trung nước Pháp vào đầu thế kỷ trước. Đây là vùng đất được thiên nhiên ưu đãi với nhiều loại thực vật và hoa cỏ. Bắt đầu từ mong muốn nghiên cứu tác dụng của các loại thực vật tự nhiên đối với chăm sóc tóc, Aurane đã dần hình thành và trở thành cái tên được biết đến rộng rãi như một thương hiệu chuyên nghiệp nhờ công thức dưỡng tóc an toàn, dịu nhẹ. \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/b8/b7/c8/68e947942432273fcb0bd64b0aa67471.jpg\" alt=\"\" width=\"750\" height=\"584\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/c5/85/a6/0222e1f820ab360e3c2b1bc0a3efd524.jpg\" alt=\"\" width=\"750\" height=\"483\" /\u003e\u003c/p\u00