r":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.3,"review_count":13,"review_text":"(13)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/e4/0b/e1/e3c36669b94e5a3b497bd98336c0fb7c.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":300,"all_time_quantity_sold":162,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cul\u003e\u003cli\u003eTên sản phẩm: \u003cstrong\u003eBánh KitKat Trà Xanh\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eQuy cách: Bịch 12 gói\u003c/li\u003e\u003cli\u003eXuất xứ: \u003cstrong\u003eNhật Bản, Hãng SX Nestle\u003c/strong\u003e\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/75/f0/a8/d424f49b888b40184df00ae565178261.jpg\" alt=\"\" width=\"750\" height=\"742\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eNếu nhắc đến các loại bánh kẹo ở Nhật Bản thì không thể quên nhắc đến loại \u003cstrong\u003ebánh Kit Kat\u003c/strong\u003e của Nestle. Kitkat đã mang đến sự hài lòng cho người tiêu dùng trên toàn thể giới nói chung và Việt Nam nói riêng.\u003c/p\u003e\n\u003cdiv id=\"attachment_367\" class=\"wp-caption aligncenter\"\u003eBánh KitKat trà xanh 12 gói của Nhật Bản\u003c/div\u003e\n\u003cdiv class=\"wp-caption aligncenter\"\u003e \u003c/div\u003e\n\u003cdiv class=\"wp-caption aligncenter\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/48/aa/09/6510e008478c58d189f47970b82f9d38.jpg\" alt=\"\" width=\"600\" height=\"600\" /\u003e\u003c/div\u003e\n\u003cdiv class=\"wp-caption aligncenter\"\u003e \u003c/div\u003e\n\u003cdiv id=\"attachment_366\" class=\"wp-caption aligncenter\"\u003e\n\u003cp id=\"caption-attachment-366\" class=\"wp-caption-text\" style=\"text-align:center\"\u003eBánh KitKat trà xanh 12 gói ảnh thật\u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv id=\"attachment_364\" class=\"wp-caption aligncenter\"\u003e\n\u003cp id=\"caption-attachment-364\" class=\"wp-caption-text\" style=\"text-align:center\"\u003e \u003c/p\u003e\n\u003c/div\u003e\n\u003ch2\u003e\u003cstrong\u003eĐặc điểm nổi bật của Bánh Kikat trà xanh của Nhật Bản:\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003e\u003cstrong\u003eBánh Kitkat trà xanh\u003c/strong\u003e là loại bánh được làm từ cây trà xanh,vì vậy nó không hề tẩm hóa chất độc hại. Bánh Kitkat là loại bánh dạng xốp được phủ 1 lớp chocolate trà xanh, bánh mang hương vị trà xanh thơm ngon độc đáo, đặc trưng của Nhật. Vị ngọt ngọt,thơm thơm ngậy ngậy. Loại bánh này được nhiều bạn trẻ ưa chuộng.\u003c/p\u003e\n\u003cp\u003eVà chắc có lẽ nhiều người vẫn chưa biết rằng bánh Kitkat trà xanh của Nhật không chỉ là loại bánh kẹo ăn thường ngày mà còn có nhiều lợi ích khác. Bánh Kitkat trà xanh có thể tăng khả năng kháng khuẩn của cơ thể, ngăn ngừa căn bệnh ung thư nguy giảm Cholesterol và hỗ trợ bệnh tim mạch. Đây là những lợi ích không ngờ từ Kitkat trà xanh.\u003c/p\u003e\n\u003cp\u003eMột gói gồm 12 bánh được gói trong từng túi nhỏ, dễ dàng cho bạn sử dụng.\u003c/p\u003e\n\u003cp\u003eThưởng thức một thanh \u003cstrong\u003eKit Kat\u003c/strong\u003e không chỉ đem lại một khoảnh khắc tuyệt vời cho đời sống mà còn góp phần hoàn hảo cho một chế độ ăn cân bằng dinh dưỡng.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/e4/0b/e1/e3c36669b94e5a3b497bd98336c0fb7c.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e4/0b/e1/e3c36669b94e5a3b497bd98336c0fb7c.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e4/0b/e1/e3c36669b94e5a3b497bd98336c0fb7c.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e4/0b/e1/e3c36669b94e5a3b497bd98336c0fb7c.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e4/0b/e1/e3c36669b94e5a3b497bd98336c0fb7c.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/8b/dc/c0/2f9cc60c72ac6b2ab0cb5da8603f8694.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/8b/dc/c0/2f9cc60c72ac6b2ab0cb5da8603f8694.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/8b/dc/c0/2f9cc60c72ac6b2ab0cb5da8603f8694.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8b/dc/c0/2f9cc60c72ac6b2ab0cb5da8603f8694.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8b/dc/c0/2f9cc60c72ac6b2ab0cb5da8603f8694.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/48/aa/09/7fb164adee8114ddaa8f174827151a17.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/48/aa/09/7fb164adee8114ddaa8f174827151a17.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/48/aa/09/7fb164adee8114ddaa8f174827151a17.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/48/aa/09/7fb164adee8114ddaa8f174827151a17.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/48/aa/09/7fb164adee8114ddaa8f174827151a17.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/20/4b/b1/ee3b947570507fe3058cc059f8122ff0.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/20