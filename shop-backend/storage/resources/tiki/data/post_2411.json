m/cache/280x280/ts/product/66/88/fd/613545e8a3f8f9d5c14a1ae7f630ca10.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2058,"all_time_quantity_sold":74,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e“Hán Sở tranh hùng” còn có tên gọi là “Tây Hán thông tục diễn nghĩa” hay “Tây Hán diễn nghĩa truyện”. Tác phẩm tái hiện một giai đoạn lịch sử đầy sóng gió của đất nước Trung Hoa, mở đầu là việc Doanh Chính đánh bại 7 nước, thống nhất Trung Hoa, nhưng dân chúng bất mãn với chính sách hà khắc của nhà Tần, nổi dậy nhiều nơi, về sau thế lực của Lưu Bang và Hạng Vũ mạnh lên, tạo thành cục diện Hán Sở tranh hùng. Cuối cùng, nhờ sự giúp sức của nhiều danh tướng, Lưu Bang thắng lợi, lập ra triều Hán. Tuy vậy, sau khi lên ngôi hoàng đế, Lưu Bang lại dung túng cho Lã Hậu tru diệt các công thần.\u003c/p\u003e\n\u003cp\u003eXuyên suốt “Hán Sở tranh hùng”, người đọc không chỉ thấy: “Cái mạnh yếu của Lưu Hạng, sự hưng vong của Hán Sở”, mà còn nhiều lần được chiêm nghiệm sức mạnh của nhân nghĩa khi những thế lực tàn bạo như Tần triều hay kiêu mạn như Hạng Vương đều lần lượt thất bại. “Hán Sở tranh hùng” đâu chỉ là chuyện binh đao, chuyện đế vương giành thiên hạ. Ẩ đằng sau đó còn là những bài học đạo lý của lòng nhân, là những tấm gương trí, trung, dũng của bậc anh hùng thời cổ.\u003c/p\u003e\n\u003cp\u003eTruyện Hán Sở Tranh Hùng là một minh họa có sức thuyết phục cho chân lý ấy .\u003c/p\u003e\n\u003cp\u003eTần Thủy Hoàng dùng sức mạnh thâu tóm lục quốc. Nhưng vì chỉ biết lấy bạo lực, không biết lấy nhân nghĩa thu phục lòng người mà lòng người rời bỏ, rốt cuộc bị Hạng Vũ tiêu diệt. Nhưng thắng Tần rồi Hạng Vũ lại lầm đường đi vào vết xe đổ nên đã bị Lưu bang trừ khử.\u003c/p\u003e\n\u003cp\u003eLưu Bang tức Hán Cao Tổ đã thấy sức mạnh và độ bền của Nhân, Nghĩa, biết dùng Nhân Nghĩa làm keo sơn gắn bó lòng người nên đã củng cố Hán tộc được khá lâu dài.\"\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/66/88/fd/613545e8a3f8f9d5c14a1ae7f630ca10.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/66/88/fd/613545e8a3f8f9d5c14a1ae7f630ca10.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/66/88/fd/613545e8a3f8f9d5c14a1ae7f630ca10.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/66/88/fd/613545e8a3f8f9d5c14a1ae7f630ca10.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/66/88/fd/613545e8a3f8f9d5c14a1ae7f630ca10.jpg"}],"warranty_policy":null,"authors":[{"id":280229,"name":"Chân Vĩ","slug":"chan-vi"}],"current_seller":{"id":9988,"sku":"2041110996485","name":"AHABOOKS","link":"https://tiki.vn/cua-hang/ahabooks","logo":"7c/b8/e1/357f6a5d18da8daa4e9060a6b7eb9d5f.png","price":149630,"product_id":"58846108","store_id":9778,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[{"id":15583,"name":"NhatPham0356","link":"https://tiki.vn/cua-hang/nhatpham0356","logo":"68/14/5f/42ed646f43651029fc86dcc59d411c16.jpg","price":131000,"product_id":"10717215","store_id":15041},{"id":10984,"name":"Minhhabooks","link":"https://tiki.vn/cua-hang/minhhabooks","logo":"90/e2/81/710a7373c42be1565897d82ccbc00579.png","price":114000,"product_id":"12017241","store_id":10718},{"id":26874,"name":"Phương Đông Books","link":"https://tiki.vn/cua-hang/phuong-dong-books","logo":"2e/85/b7/e76104ae5f1beaf244f319e2f0d2d413.jp