//salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":22775,"discount_rate":21,"rating_average":5,"review_count":235,"review_text":"(235)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/fc/ec/79/65b4aa87c1737cdfe71c425961f1f56b.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1505,"all_time_quantity_sold":4698,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eCÀ PHÊ HÒA TAN RANG XAY 3IN1 CAFE SỮA ĐÁ – HỘP 9 GÓI X 25GR\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eBỘ SẢN PHẨM BAO GỒM: \u003cbr /\u003eHộp 9 gói x 25gr \u003cbr /\u003e\u003cbr /\u003eĐẶC ĐIỂM NỔI BẬT:\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eNhững hạt cà phê được lựa chọn từ 2 vùng nguyên liệu tốt nhất tại Việt Nam: Arabica Cầu Đất + Robusta Buôn Ma Thuột.\u003c/li\u003e\n\u003cli\u003eSản phẩm được rang đậm theo kiểu rang truyền thống huyền bí phương Đông không thể sao chép (công thức riêng của Trung Nguyên).\u003c/li\u003e\n\u003cli\u003eCông nghệ Nano giữ hương vị cà phê tươi nguyên trọn vẹn. Cho bạn thưởng thức đúng vị cà phê sữa đá thơm ngon như cà phê sữa đá pha phin.\u003c/li\u003e\n\u003cli\u003eSữa đặc sấy phun được phát triển riêng cho Trung Nguyên.\u003c/li\u003e\n\u003cli\u003eHỗn hợp cà phê (cà phê hòa tan và cà phê rang xay mịn) 20%.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cbr /\u003eTHÀNH PHẦN: \u003cbr /\u003e- Đường, bột kem (có chứa đạm sữa), hỗn hợp cà phê hòa tan (18,5 % cà phê Robusta, 0,8 % đậu nành), bột sữa (5 %), maltodextrin, cà phê rang xay nhuyễn (0,7 %), muối i-ốt, chất tạo ngọt tổng hợp 950, chất điều chỉnh độ acid 500(ii), hương liệu tổng hợp dùng trong thực phẩm (hương Cà Phê và hương Sữa).\u003cbr /\u003e- Sản phẩm có chứa sữa, đậu nành.\u003cbr /\u003e\u003cbr /\u003eTHÔNG TIN CẢNH BÁO AN TOÀN:\u003cbr /\u003e• Không dùng cho người dị ứng với thành phần của sản phẩm.\u003cbr /\u003e• Bột cà phê rang xay nhuyễn có thể lắng dưới đáy ly và an toàn khi sử dụng.\u003cbr /\u003e\u003cbr /\u003eHƯỚNG DẪN SỬ DỤNG: \u003cbr /\u003eHòa 1 gói cà phê với 50 ml nước nóng (80ºC - 100ºC), khuấy đều, cho thêm khoảng 100g đá vào và thưởng thức.\u003cbr /\u003e\u003cbr /\u003eThương hiệu: Trung Nguyên Legend\u003c/p\u003e\n\u003cp\u003eNgành hàng: cà phê\u003c/p\u003e\n\u003cp\u003eNhà sản xuất: Trung Nguyên\u003c/p\u003e\n\u003cp\u003eXuất xứ: Việt Nam\u003c/p\u003e\n\u003cp\u003eNơi sản xuất: Việt Nam\u003c/p\u003e\n\u003cp\u003eNgày sản xuất: In trên bao bì sản phẩm\u003c/p\u003e\n\u003cp\u003eHạn sử dụng: 2 năm kể từ ngày sản xuất\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eCÁCH BẢO QUẢN:\u003c/p\u003e\n\u003cp\u003eBảo quản sản phẩm nơi khô ráo, thoáng mát, tránh ánh nắng trực tiếp.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eLƯU Ý:\u003c/p\u003e\n\u003cp\u003eKhông dùng cho người dị ứng với các thành phần của sản phẩm.\u003c/p\u003e\n\u003cp\u003eBột cà phê rang xay nhuyễn có thể lắng dưới đáy ly và an toàn khi sử dụng.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eTHỜI GIAN GIAO HÀNG\u003c/p\u003e\n\u003cp\u003eSản phẩm của gian hàng đã được gửi sẵn ở kho Tiki, vì vậy đơn hàng sẽ được giao theo thời gian dự kiến trên đơn hàng.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eCHÍNH SÁCH BẢO HÀNH:\u003c/p\u003e\n\u003cp\u003eSản phẩm được đổi trả theo đúng quy định của Tiki.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eĐể biết thêm thông tin chi tiết của sản phẩm hoặc chính sách giá tốt, giá sỉ vui lòng inbox cho shop.\u003c/p\u003e\n\u003cp\u003eChân thành cảm ơn quý khách hàng!\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e#trungnguyen #trung_nguyen #trung_nguyên #trung_nguyen_legend #trung_nguyên_legend #trungnguyenlegend #trungnguyenlegendofficial #trung_nguyen_legend_official #trung_nguyên_legend_official #caphe #ca_phe #cà_phê #caphetrungnguyen #cà_phê_hòa_tan #cà_phê_sữa #ca_phe_trung_nguyen #cà_phê_trung_nguyên #Cà_phê_sữa_hòa_tan #Cà_phê_nguyên_chất #G73in1 #G7_3in1 #cà_phê_3in1 #cà_phê_sữa_đá\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e*Bao bì thực tế sẽ thay đổi theo từng đợt nhập hàng\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/fc/ec/79/65b4aa87c1737cdfe71c425961f1f56b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/fc/ec/79/65b4aa87c1737cdfe71c425961f1f56b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/fc/ec/79/65b4aa87c1737cdfe71c425961f1f56b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fc/ec/79/65b4aa87c1737cdfe71c425961f1f56b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fc/ec/79/65b4aa87c1737cdfe71c425961f1f56b.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/7d/d6/9f/43e41d6cb69c7d003feaaa10ff4465c8.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/7d/d6/9f/43e41d6cb69c7d003feaaa10ff4465c8.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/7d/d6/9f/43e41d6cb69c7d003feaaa10ff4465c8.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/prod