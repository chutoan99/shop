round_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/89/e6/60/75e0eb5cd98ef7d76628779cf52322c5.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":707,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eLoa siêu trầm Edifier T5 có thể cung cấp âm thanh mà không bị biến dạng. Bổ sung cho dàn âm thanh, ngoài dải cao và trung là âm trầm mà bạn thực sự có thể cảm nhận được. Tần số có thể xuống tới 38Hz là tần số thấp nhất cho dàn âm thanh dân dụng. Nghe tiếng bass sôi động, mà không có cảm giác đau đầu hay mệt mỏi khi nghe lâu. Loa subwoofer kết hợp đồng bộ với các model loa active như R1700BTs, R1855DB hay R1280DBs.\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003eTHÔNG SỐ KỸ THUẬT:\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e• Thương hiệu: Edifier\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e• Xuất xứ thương hiệu: Canada\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e• Nhập khẩu \u0026amp; Phân phối: DALITO VIỆT NAM\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e• Mã sản phẩm: Loa subwoofer T5\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e• Model: T5\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e• Kiểu loa: Loa siêu trầm\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e• Công suất: 70W\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e• Độ nhạy: 50±20mV\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e• Driver: Bass 8 inch\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e• Bluetooth: Không\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e• Mic : Không\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e• Tự tắt thông minh : Có\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e• Kich thuoc: 278x300x336\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e• Tần số: 38HZ-200HZ\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e• Trọng lượng: 11.5kg\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e \u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003eƯU ĐIỂM SẢN PHẨM:\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e- Công nghệ xử lý tín hiệu số DSP giúp tiếng bass mà loa siêu trầm T5 tạo ra rất ổn định, mạnh mẽ và chắc. Những âm trầm sâu, không hề bị méo tiếng hay bị tune kiểu điện tử. Driver bass có kích thước lên đến 8 inch, và tổng công suất 70W, có thể đáp ứng đầy đủ yêu cầu của dàn âm thanh 2.0 sẵn có\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e \u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e \u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e- Một tính năng khá thú vị của mẫu T5 là tự động vào chế độ chờ, đảm bảo thiết bị không lãng phí năng lượng khi không sử dụng. Ngoài ra có giúp tăng độ bền cho loa, tiện lợi hơn trong thao tác vận hành.\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e- Sự cộng hưởng là tuyệt vời khi căn phòng của bạn rung lên vì âm trầm, không quá nhiều khi loa siêu trầm tạo hiệu ứng tốt như vậy. Thùng loa Edifier T5 có chất liệu là gỗ MDF chất lượng cao, mật độ trung bình giúp giảm cộng hưởng của thùng loa cho âm thanh trong trẻo nhất xung quanh.\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e- Loa Edifier T5 có thế thay đổi âm lượng âm trầm một cách nhanh chóng bằng một núm vặn thuận tiện nằm ở mặt sau của thiết bị. Một núm bên cạnh điều khiển dải tần của loa siêu trầm, cho phép bạn tăng hoặc giảm tần số mà nó bắt đầu lọc âm thanh.\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e \u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003eBỘ SẢN PHẨM GỒM:\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e• Loa siêu trầm\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e• Sách HDSD\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e• Cáp AV RCA-3.5mm\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e• Cáp AV RCA-RCA\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e \u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003eCHÍNH SÁCH BẢO HÀNH:\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e12 tháng\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003eĐổi mới trong 30 ngày lỗi nhà sản xuất\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003eBảo hành điện tử theo serial number\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e(Vui lòng giữ đủ vỏ hộp, phụ kiện tai nghe)\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/89/e6/60/75e0eb5cd98ef7d76628779cf52322c5.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/89/e6/60/75e0eb5cd98ef7d76628779cf52322c5.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/89/e6/60/75e0eb5cd98ef7d76628779cf52322c5.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/89/e6/60/75e0eb5cd98ef7d76628779cf52322c5.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/89/e6/60/75e0eb5cd98ef7d76628779cf52322c5.png"},{"base_url":"https://salt.tikicdn.com/ts/product/1c/d6/8f/231a41755e7b5dec910dbcf85746f208.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/1c/d6/8f/231a41755e7b5dec910dbcf85746f208.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/1c/d6/8f/231a41755e7b5dec910dbcf85746f208.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1c/d6/8f/231a41755e7b5dec910dbcf85746f208.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1c/d6/