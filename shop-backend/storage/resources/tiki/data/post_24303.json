83596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.7,"review_count":10,"review_text":"(10)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/f6/b7/8c/b3197e15c799dd76df7b2a5bca57c8cd.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1450,"all_time_quantity_sold":49,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eViên uống Focus Factor của Mỹ giúp tăng cường trí nhớ - giảm stress 180 viên\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eGiống như các bộ phận khác trên cơ thể, bộ não con người cũng cần được cung cấp đầy đủ dưỡng chất để phát triển khỏe mạnh. Focus Factor là dạng viên uống bổ sung dinh dưỡng cho não, bao gồm các thành phần chính là các loại Vitamin, khoáng chất, các chất chống Oxi hoá, Omega 3.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/fa/17/39/3ca4c99e93e4a019a562c9f615814983.jpg\" alt=\"\" width=\"680\" height=\"680\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCông dụng:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eCác vitamin chứa trong Focus factor 150 viên có tác dụng hỗ trợ trí nhớ, và duy trì chức năng, hoạt động của cơ thể. Những vitamin này rất cần thiết đối với các quá trình sinh lý cũng như những phản ứng sinh hóa trong cơ thể người. Chúng đóng vai trò là chất hỗ trợ cho các enzyme và vận chuyển các electron giữa các quá trình trao đổi chất diễn ra trong cơ thể người.\u003c/p\u003e\n\u003cp\u003eNguyên tố sắt có vai trò bảo vệ hàng rào máu não, ngăn chặn sự xâm nhập của các nguyên tố kim loại nặng vào não bộ. Khi các kim loại nặng như cadmium hay chì xâm nhập vào não, chúng sẽ gây tổn thương các dây thần kinh cũng như các tế bào não.\u003cbr /\u003ecanxi cũng là chất cần thiết cho hoạt động của não bộ vì chúng ảnh hưởng tới các chất dẫn truyền thần kinh.\u003c/p\u003e\n\u003cp\u003eMagie là chất cần thiết đối với một số phản ứng sinh hóa diễn ra trong não bộ. Lượng magie trong não thấp có thể dẫn đến hiện tượng trầm cảm.\u003c/p\u003e\n\u003cp\u003eMangan có ảnh hưởng tới các nhóm enzym chống Oxy hóa trong cơ thể người. Đồng là nguyên tố cần thiết cho sự dẫn truyền oxy và electron trong cơ thể. Giống như mangan, đồng là khoáng chất cần thiết cho hoạt động của các enzyme chống Oxy hóa như superoxide dismutase…\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/50/93/35/f74891dc0a21111fbde18e8bd86b26af.jpg\" alt=\"\" width=\"500\" height=\"670\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eSử dụng:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eUống 4 viên Focus factor vào buổi sáng sau khi ăn. Để thích nghi với thể trạng, cường độ lao động và áp lực, sử dụng thêm thuốc vào buổi chiều. Không sử dụng quá 8 viên/ ngày.\u003c/p\u003e\n\u003cp\u003eBảo quản thuốc ở nơi khô ráo và thoáng mát, tránh xa tầm tay trẻ em\u003c/p\u003e\n\u003cp\u003eHãy hỏi ý kiến thầy thuốc trước khi sử dụng nếu bạn đang có thai, cho con bú hoặc đang trong giai đoạn điều trị bệnh\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/8c/ca/32/c795a42e727fc972cc98f8cc916de4e2.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e",