n_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ff/e4/4a/884c3370f33db6432947554922542890.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1068,"all_time_quantity_sold":5,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eĐặc điểm nổi bật của Máy pha café Zamboo ZB-99 PRO:\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eLà dòng máy pha gia đình và quán nhỏ nhưng mang phong cách chuyên nghiệp với phin 58mm, có đồng hồ hiển thị thời gian pha, áp lực bơm max 15 bar, thiết kế sang trọng, chắc chắn và cao cấp.\u003c/li\u003e\n\u003cli\u003eFilter 58mm chắc chắn với phin 1 cup (10-12g cafe) và 2 cup (20-25g cafe), khách hàng có thể tùy chỉnh pha 1 ly hay 2 ly cà phê cùng lúc\u003c/li\u003e\n\u003cli\u003eCông suất 1450W - Bơm Ulka của Italy với áp suất tối đa 15 bar - tiêu chuẩn 8 - 10 bar đảm bảo cà phê được chiết xuất thơm ngon nhất\u003c/li\u003e\n\u003cli\u003eCó thể pha Espresso và Cappuccino – Latte…\u003c/li\u003e\n\u003cli\u003eCó đồng hồ Led thể hiện thời gian pha cà phê, thời gian đánh sữa. Đồng hồ này mình có thể tùy chỉnh theo nhu cầu sử dụng\u003c/li\u003e\n\u003cli\u003eMáy có chế độ tự tắt khi khách hàng không có nhu cầu sử dụng nữa mà quên tắt máy.\u003c/li\u003e\n\u003cli\u003eVòi đánh hơi mạnh mẽ, di chuyển 360 chuyên nghiệp, có vòi lấy nước nóng riêng biệt\u003c/li\u003e\n\u003cli\u003eBình chứa nước 1.7 lít có thể tháo rời dễ dàng, van an toàn hoạt động linh hoạt giúp bạn khi tháo bình mà không bị tràn nước.\u003c/li\u003e\n\u003cli\u003eHệ thống sưởi ấm Thermoblock hiện đại, giúp bạn nhanh chóng sấy khô ly tách - Hệ thống kiểm soát nhiệt điện tử đảm bảo cà phê luôn được pha ở nhiệt độ chính xác nhất - -\u003c/li\u003e\n\u003cli\u003eKhay hứng nước nhỏ giọt có thể tháo rời để dễ dàng vệ sinh. - Thời gian pha (lượng nước) có thể điều chỉnh theo cá nhân.\u003c/li\u003e\n\u003cli\u003ePhụ kiện đi kèm: tay cầm, phin đơn, đôi, phin mù (để vệ sinh), tamper nén inox, chổi vệ sinh, tamper mat.\u003c/li\u003e\n\u003cli\u003e \u003c/li\u003e\n\u003cli\u003eCách sử dụng vô cùng đơn giản:\u003c/li\u003e\n\u003cli\u003eBật nút nguồn - chờ cho nước đun đủ nóng (Đèn báo không nhấp nháy nữa)\u003c/li\u003e\n\u003cli\u003eĐối với cà phê pha máy khách nên sử dụng cà phê rang mộc, như vậy sẽ cảm nhận được hết vị của hạt cà phê. Dùng muỗng múc cà phê vào filter, nếu pha 1 cup thì sử dụng phin 1 cup với 10-12g cà phê, nếu pha 2 cup thì sử dụng phin 2 cup với 20-25g cà phê\u003c/li\u003e\n\u003cli\u003eSau đó lắp tay cầm vào máy, bấm nút pha cà phê. (Lưu ý: Thời gian mặc định ban đầu là 25 - 30s, Khách có thể điều chỉnh theo lượng nước (thời gian) thường xuyên uống thì bấm giữ nút pha và điều chỉnh tới lượng thời gian của mình - từ lần tiếp theo, máy sẽ tự ngắt theo thời gian đã lựa chọn) - Cà phê đã sẵn sàng, Anh Chị có thể thêm đường/ sữa hoặc uống cf đen và thưởng thức. Còn Anh Chị muốn sử dụng chức năng đánh sữa, bạn gạt công tắc đánh sữa, chờ đèn báo sẵn sàng sử dụng, sau đó vặn núm đánh sữa ở bên hông máy để sử dụng. Lưu ý: \u003cu\u003eSử dụng sữa tươi Thanh Trùng Không Đường \u003c/u\u003ethì mới lên bọt\u003c/li\u003e\n\u003cli\u003eThông số kỹ thuật Máy pha cà phê Zamboo ZB-99 PRO\u003c/li\u003e\n\u003cli\u003e- Model: ZB-99 PRO - Model 2021\u003c/li\u003e\n\u003cli\u003e- Công suất: 1450W\u003c/li\u003e\n\u003cli\u003e- Áp lực bơm: 15 bar\u003c/li\u003e\n\u003cli\u003e- Loại cà phê: Café bột nguyên chất\u003c/li\u003e\n\u003cli\u003e- Bình chứa nước: 1.7 lít\u003c/li\u003e\n\u003cli\u003e- KT phin: 58mm\u003c/li\u003e\n\u003cli\u003e- Kích thước: 22x29x31cm\u003c/li\u003e\n\u003cli\u003e- Vỏ máy: Kim loại + nhựa - Bơm: Ulka\u003c/li\u003e\n\u003cli\u003e- Vòi đánh sữa: Có - Chức năng chính: Pha Espresso\u003c/li\u003e\n\u003cli\u003e- Có thể pha Cappuccino, Latte\u003c/li\u003e\n\u003cli\u003e- Có vòi lấy nước nóng riêng biệtt - Thương hiệu: Việt Nam - SX tại: TQ - Bảo hành 12 tháng\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ff/e4/4a/884c3370f33db6432947554922542890.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ff/e4/4a/884c3370f33db6432947554922542890.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ff/e4/4a/884c3370f33db6432947554922542890.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ff/e4/4a/884c3370f33db6432947554922542890.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ff/e4/4a/884c3370f33db6432947554922542890.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/02/2f/68/7c0ca013cdd87f120d9b288832f067a6.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/02/2f/68/7c0ca013cdd87f120d9b288832f067a6.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/02/2f/68/7c0ca013cdd87f120d9b288832f067a6.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/02/2f/68/7c0ca013cdd87f120d9b288832f067a6.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/02/2f/68/7c0ca013cdd87f120d9b288832f067a6.j