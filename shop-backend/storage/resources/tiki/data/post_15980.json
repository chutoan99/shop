_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":681000,"discount_rate":54,"rating_average":4.7,"review_count":21,"review_text":"(21)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/12/79/85/d66ec78931da7c85305f67305f0f6690.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":901,"all_time_quantity_sold":101,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2\u003eCÔNG DỤNG CỦA GỐI CHỐNG GIÃN TĨNH MẠCH CHÂN EMA\u003c/h2\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/6f/98/12/62fab141df209ce5ffadf94c1f4a4190.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eTăng tuần hoàn máu từ chân về tim, giúp máu dễ dàng lưu thông qua tĩnh mạch về tim -\u0026gt; giảm tình trạng suy giãn tĩnh mạch chân, tăng cường phục hồi tĩnh mạch chân\u003c/li\u003e\n\u003cli\u003eKhi kê chân trên gối chống giãn tĩnh mạch Ema sẽ tạo góc nghỉ cho đầu gối, từ đó giảm áp lực lên khớp gối. Tư thế này còn giúp giảm căng tức cơ ở ba vị trí: Bắp chân, Đầu gối \u0026amp; Thắt lưng đồng thời giảm áp lực lên cột sống và vùng thắt lưng\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/7b/93/32/65870841c56ee45898a4581bf27ccb75.jpg\" alt=\"\" width=\"750\" height=\"421\" /\u003e\u003c/p\u003e\n\u003ch2\u003eGỐI KÊ CHÂN EMA CHỐNG GIÃN TĨNH MẠCH NHƯ THẾ NÀO?\u003c/h2\u003e\n\u003cp\u003eGối kê chân Ema giúp tạo độ dốc liên tục từ bàn chân tới bắp đùi, lợi dụng trọng lực đưa máu từ khắp chân về tim dễ dàng. Nhờ đó, gối kê chân Ema giúp giảm các triệu chứng của suy giãn tĩnh mạch chân:\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/10/20/e6/35760d04a908b1a2360f87bc044714d2.jpg\" alt=\"\" width=\"750\" height=\"421\" /\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eSưng, phù nề, cảm giác tức nặng ở chân khi đứng hoặc ngồi lâu\u003c/li\u003e\n\u003cli\u003eĐau chân do máu ứ đọng\u003c/li\u003e\n\u003cli\u003eĐặc biệt giảm chuột rút (vọp bẻ) ban đêm do suy giãn tĩnh mạch chân\u003c/li\u003e\n\u003cli\u003eGiảm nguy cơ biến chứng tắc mạc, loét mạch do hình thành cục máu đông ở chân khi máu bị ứ đọng lâu\u003c/li\u003e\n\u003c/ul\u003e\u003ch2\u003eĐIỂM NỔI BẬT CỦA GỐI CHỐNG GIÃN TĨNH MẠCH EMA\u003c/h2\u003e\n\u003cul\u003e\u003cli\u003eHính dáng, chiều cao chuẩn theo châu Âu với chiều cao 20cm tương đương 8 inch - đây là độ cao được áp dụng cho mọi gối kê chân ở Mỹ, châu Âu\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/a7/59/83/9475a1d128bddb62591359ec9e32b900.jpg\" alt=\"\" width=\"750\" height=\"421\" /\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eChiều cao vừa phải 20cm đảm bảo cân bằng 2 chiều lưu thông máu: đủ đề giúp máu từ chân về tim dễ hơn nhưng không quá cao để gây cản trở tim bơm máu đến chân. \u003cstrong\u003eLưu ý KHÔNG NÊN DÙNG CÁC LOẠI GỐI CAO TỪ 25-28CM\u003c/strong\u003e\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/17/06/84/e7bb1cc238352f92b0696eab487368cf.jpg\" alt=\"\" width=\"750\" height=\"421\" /\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eThiết kế mặt dốc phẳng hoàn toàn cùng chiều rộng lên đến 50cm (lớn nhất hiện nay) giúp chân bạn tự do xoay trở thoải mái trên gối dù bạn đang nằm ngửa hay nằm nghiêng\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/52/fe/4f/ce882dda3ca1701d72b9b2681c932b1c.jpg\" alt=\"\" width=\"750\" height=\"421\" /\u003e\u003c/p\u003e\n\u003ch2\u003eMÔ TẢ CHI TIẾT GỐI CHỐNG GIÃN TĨNH MẠCH EMA\u003c/h2\u003e\n\u003cp\u003e\u003cstrong\u003eKích thước:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eLoại 1: Dài 60 cm rộng 50 cm cao 20cm với mặt đặt chân dốc\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/54/86/d3/4957b9652cf834ec56144618f219a64b.jpg\" alt=\"\" width=\"750\" height=\"421\" /\u003e\u003c/p\u003e\n\u003cp\u003eLoại 2: Dài 60 cm rộng 50 cm cao 16cm với mặt đặt chân ngang\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/a2/b0/b4/ca677ae26cb91cd18d75936b7b53b045.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eChất liệu ruột:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eRuột gối làm từ mút PU tỉ trọng rất cao, đàn hồi rất tốt giúp gối dùng vừa êm và độ bền từ 5-7 năm\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/50/7c/cd/714f32ebdde86499d3d9f86110b733a6.jpg\" alt=\"\" width=\"750\" height=\"421\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eChất liệu vỏ:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eVỏ gối làm từ vải gấm xốp nhập khẩu, co giãn, thoáng khí, thấm hút mồ hôi tốt nên bạn sẽ không cảm thấy nóng bức vào mùa hè. Vỏ gối có khóa kéo giúp bạn có thể thay giặt, vệ sinh dễ dàng\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/f0/2a/ce/794b2333e6eac3e648aa9e4274af1f77.jpg\" alt=\"\" width=\"750\" height=\"421\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eMẫu mã: \u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eGối có nhiều mẫu mã, màu sắc phù hợp với tất cả mọi lứa tuổi, cửa hàng thường xuyên thay đổi mẫu nên quý khách nếu muốn chọn mẫu vỏ \u003cstrong\u003evui lòng chat trực tiếp với cửa hàng\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/17/a7/2e/e861a9634da3a291f42baa87e610453f.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/ca/07/37/bb1f32eb02b5300a86e5f200fd8db98b.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/32/8f/61/d70d3bfc91a3a8f2cd7ef44a473e3c25.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/dd/c8/68/4c7169af4762f84310a01a332b8a4f6e.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch2\u003eHÌNH ẢNH THỰC TẾ GỐI CHỐNG GIÃN TĨNH MẠCH EMA\u003c/h2\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/c4/f0/a5/a923d01fd7ed9aad19483d37dab024b6.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/01/8f/7e/77fcc51b89aef8e6f050fd6e63bd4942.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/19/35/15/e80500e9ebf4f2d3052ab6eb9c6d336b.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicd