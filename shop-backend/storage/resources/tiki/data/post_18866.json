ịa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/7e/36/c1/5590ea398b9b6faa92dabea7aef2cc99.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/7e/36/c1/5590ea398b9b6faa92dabea7aef2cc99.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/7e/36/c1/5590ea398b9b6faa92dabea7aef2cc99.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7e/36/c1/5590ea398b9b6faa92dabea7aef2cc99.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7e/36/c1/5590ea398b9b6faa92dabea7aef2cc99.jpg"}],"warranty_policy":null,"authors":[{"id":4024,"name":"Hoàng Liên","slug":""}],"current_seller":{"id":281062,"sku":"7982172587171","name":"Bamboo Books","link":"https://tiki.vn/cua-hang/bamboo-books","logo":"46/9a/b3/e4fbfd97e7607ea4d2ff8e9ad769121b.jpg","price":45000,"product_id":"269959081","store_id":268132,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[{"id":62303,"name":"Tiệm Sách Minh Vân","link":"https://tiki.vn/cua-hang/tiem-sach-minh-van","logo":"https://vcdn.tikicdn.com/ts/seller/3b/a8/12/9ed725b43ccb5523a205e6c14c8725ad.jpg","price":40500,"product_id":"274044698","store_id":58603}],"specifications":[{"name":"Thông tin chung","attributes":[{"code":"publisher_vn","name":"Công ty phát hành","value":"NXB Kim Đồng"},{"code":"publication_date","name":"Ngày xuất bản","value":"2023-05-01 00:00:00"},{"code":"dimensions","name":"Kích thước","value":"14.5 x 20.5 cm"},{"code":"book_cover","name":"Loại bìa","value":"Bìa mềm"},{"code":"number_of_page","name":"Số trang","value":"128"},{"code":"manufacturer","name":"Nhà xuất bản","value":"Nhà Xuất Bản Kim Đồng"}]}],"price_comparison":{"sub_title":"Giá từ 40.500 ₫","title":"So sánh 1 nhà bán khác"},"product_lin