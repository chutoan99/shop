null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":176000,"discount_rate":61,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/22/78/21/dc30dccfde6ece4d17aa46cb672609a3.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":295,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2\u003eMÔ TẢ SẢN PHẨM\u003c/h2\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/cc/a9/3e/7030d1616704d2c7f5dd028f4ae477f8.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/98/f4/da/4954e414bd70827ca7acbc3c2862168e.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch2\u003eHƯỚNG DẪN SỬ DỤNG\u003c/h2\u003e\n\u003cp\u003eCực Dương của đèn hướng vào phía trong (Phía Đầu Đèn) Cực âm hướng ra ngoài (Đuôi Đèn)\u003c/p\u003e\n\u003cp\u003eCông Tắc Bên Cạnh để chuyển đổi chức năng chiếu sáng của đèn\u003c/p\u003e\n\u003cp\u003eĐèn pin đội đầu T6 áp dụng công nghệ chiếu sáng tiên tiến điện áp ổn định, có thể giải quyết hiệu quả các yêu cầu của đèn pin LED về điện áp và dòng điện không đổi;\u003c/p\u003e\n\u003cp\u003eKhông sử dụng điện áp vượt quá 4,2V điện cực dương của pin hướng về phía trước, không được đảo ngược, nếu không sẽ làm cháy bo mạch\u003c/p\u003e\n\u003cp\u003eChú ý kiểm soát sự thay đổi nhiệt độ của đèn pin để đảm bảo tản nhiệt\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/bf/6e/ab/38c09b0efe22ee13250ec5ad51f22659.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch2\u003eCHÚ Ý:\u003c/h2\u003e\n\u003cp\u003e- Khi nhận hàng bạn nên sạc Pin 5h. Từ lần thứ 2 trở đi chỉ nên sạc dưới 5h sau đó Pin chỉ cần bật đèn xanh của bộ sạc là được. Không nên nạp quá nhiều\u003c/p\u003e\n\u003cp\u003e-Tốc độ xả tự nhiên của PIN Lithium sẽ giải phóng 1% hoặc ít hơn lượng sạc mỗi ngày khi không sử dụng\u003c/p\u003e\n\u003cp\u003e- Chú ý PIN cần được chống cẩm và chống va chạm mạnh\u003c/p\u003e\n\u003cp\u003e- Nếu PIN không sử dụng trong thời gian dài nên sạc đầy và bảo quản riêng\u003c/p\u003e\n\u003cp\u003e- Không sử dụng pin khác loại cho đèn Pin\u003c/p\u003e\n\u003cp\u003e- Khi Đang sử dụng, khi độ sáng của đèn pin bị mờ đi, và phải sạc ngay lập tức\u003c/p\u003e\n\u003cp\u003e- Trong quá trình sử dụng đèn pin, đảm bảo tản nhiệt. Nên tản nhiệt hoặc tắt kịp thời tùy theo độ nóng của đèn pin khi bật và tắt, sau đó bật lại sau khi nhiệt độ giảm để dễ tản nhiệt;\u003c/p\u003e\n\u003cp\u003e- Giữ thành bên trong cốc đèn Sạch sẽ, không lau bằng tay hoặc vật cứng; để loại bỏ dấu vân tay trên thấu kính, hãy dùng tăm bông có dung dịch tẩy rửa thấu kính để lau nhẹ;\u003c/p\u003e\n\u003cp\u003e- Nếu đèn pin không được sử dụng trong thời gian dài, vui lòng tháo pin (từ một tháng trở lên) để tránh ăn mòn hóa học.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/b5/5b/70/6704bcd082fbf6e6f1ca22747e93e1d8.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/8d/55/01/9783159234902e372e0b721518df3a8c.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/1a/23/f8/211599f781dd3f25f4c2ce82f49ead41.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/22/78/21/dc30dccfde6ece4d17aa46cb672609a3.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/22/78/21/dc30dccfde6ece4d17aa46cb672609a3.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/22/78/21/dc30dccfde6ece4d17aa46cb672609a3.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/22/78/21/dc30dccfde6ece4d17aa46cb672609a3.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/22/78/21/dc30dccfde6ece4d17aa46cb672609a3.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/6e/0f/c3/8a262bb0f6d23e01956df242b3756674.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/6e/0f/c3/8a262bb0f6d23e01956df242b3756674.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/6e/0f/c3/8a262bb0f6d23e01956df242b3756674.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6e/0f/c3/8a262bb0f6d23e01956df242b3756674.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6e/0f/c3/8a262bb0f6d23e01956df242b3756674.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/f3/70/d4/fd513e2ae40a04916fca2f84457bef12.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f3/70/d4/fd513e2ae40a04916fca2f84457bef12.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f3/70/d4/fd513e2ae40a04916fca2f84457bef12.jpg","position":null,"small_url":"https://salt.tikicdn.