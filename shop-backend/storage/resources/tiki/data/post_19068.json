on_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":3,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/5f/01/02/485fa54fd0210839322aad5a25b7e057.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2209,"all_time_quantity_sold":15,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch5\u003eTổng quan sản phẩm\u003c/h5\u003e\n\u003cp\u003e\u003cstrong\u003eDây Cáp Sạc Type C Hoco X14 (1m)\u003c/strong\u003e là một chiếc cáp đến từ nhà sản xuất phụ kiện uy tín Hoco, hỗ trợ cho các dòng điện thoại sử dụng cổng Type-C làm cổng giao diện chính. Về thiết kế bên ngoài, cáp Type – C Hoco X14 có thiết kế khá đơn giản và nhã nhặn. Đầu USB và Type-C của cáp được gia công kỹ lưỡng bằng hợp kim nhôm nguyên chất và xử lý bề mặt anodize, giúp làm tăng tính thẩm mỹ và cao cấp cho sản phẩm.\u003c/p\u003e\n\u003cp\u003eCác chi tiết, dù là nhỏ nhất trên cáp đều được chăm chút tỉ mỉ nên đều đạt độ hoàn thiện cao. Bên cạnh đó, hai đầu sạc của cáp có khả năng chống oxy hóa, ăn mòn và vô cùng bền bỉ, có thể chịu được tác động từ ngoại lực trong một giới hạn nhất định.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/3a/ad/90/d8c23eee4383e51b0516a626011c0ed2.jpg\" alt=\"Dây Cáp Sạc Type C Hoco X14 (1m)\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003ch5\u003eChất liệu TPE thân thiện với môi trường\u003c/h5\u003e\n\u003cp\u003eDây cáp với chiều dài tùy chọn, một loại 1m và một loại 2m giúp bạn thoải mái lựa chọn sao cho phù hợp với nhu cầu sử dụng của mình. Dây cáp Type-C Hoco X14 được làm từ chất liệu nhựa TPE thân thiện với môi trường được bọc ngoài bằng sợi nylon dệt kim, giúp tăng tính bền cho dây cũng như hạn chế tình trạng dây bị rối, hay đứt gãy trong quá trình sử dụng.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/67/7f/46/4d92a31f6e444d8f914cea41784dab10.jpg\" alt=\"Dây Cáp Sạc Type C Hoco X14 (1m)\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003ch5\u003eLõi dây bằng đồng cao cấp\u003c/h5\u003e\n\u003cp\u003eLõi dây được làm bằng các sợi đồng cao cấp, không những giúp tăng độ bền cho dây mà còn đảm bảo tối ưu hóa tốc độ truyền điện trong sợi cáp. Chính vì vậy, Cáp Type-C Hoco X14 có thể chịu được dòng điện lớn và cho hiệu suất chuyển tải điện nhanh chóng. Cáp bên cạnh khả năng sạc cho thiết bị còn có khả năng truyền dữ liệu từ điện thoại lên máy tính hay tablet với hiệu năng vô cùng đảm bảo.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ac/44/90/b582de37ea5d2e8acd86b18508897397.jpg\" alt=\"Dây Cáp Sạc Type C Hoco X14 (1m)\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003ch5\u003eTrang bị công nghệ sạc nhanh Quick Charge\u003c/h5\u003e\n\u003cp\u003eCáp Type-C Hoco X14 được trang bị công nghệ sạc nhanh Quick Charge cho dòng ra ổn định 5V – 2.4A, đảm bảo tính năng sạc nhanh cho thiết bị. Đồng thời, chip cân bằng được trang bị bên trong cáp sẽ giúp tự động điều chỉnh dòng điện bên trong cáp để tránh các tình trạng đoản mạch, chập điện hay quá dòng, quá áp. Từ đó, đảm bảo an toàn tối đa cho thiết bị sạc của bạn.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/74/05/ee/1b23c2ed3320897472a8cd05528b09bc.jpg\" alt=\"Dây Cáp Sạc Type C Hoco X14 (1m)\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThông số kỹ thuật:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eHãng sản xuất: Hoco\u003c/li\u003e\n\u0