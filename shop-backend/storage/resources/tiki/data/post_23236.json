m/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/d5/3e/6b/c5649ebb29bb2422dfd03d10290e8a52.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1259,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eMáy lọc nước ion kiềm điện giải Impart Excel-FX (MX-99) - Hàng chính hãng\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eMáy lọc nước ion kiềm điện giải Impart Excel-FX (MX-99) là sản phẩm sở hữu nhiều tính năng cao cấp đến từ tập đoàn Impart International được nhiều người tiêu dùng ưa chuộng. Với khả năng tạo ra nhiều loại nước chức năng trong đó có nước ion siêu kiềm và ion siêu axit kèm theo dải pH rộng hàng đầu ngành ion kiềm. Bên cạnh đó, Impart Excel-FX (MX-99) còn được trang bị tấm điện cực nguyên khối Titan phủ Platinum siêu lớn thúc đẩy hiệu suất điện phân mạnh mẽ.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003e\u003cspan style=\"font-weight: 400;\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/a9/8b/4c/1d278b22d1b79650171b3725b2154efb.png\" alt=\"Máy lọc nước ion kiềm điện giải  Impart Excel-FX (MX-99) chinh phục người tiêu dùng nhờ khả năng tạo ra 8 loại nước chức năng\" width=\"640\" height=\"427\" /\u003eMáy lọc nước ion kiềm điện giải  Impart Excel-FX (MX-99) chinh phục người tiêu dùng nhờ khả năng tạo ra 8 loại nước chức năng\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003col style=\"text-align: justify;\"\u003e\n\u003cli\u003e\u003cstrong\u003e Tính năng nổi bật của máy lọc nước ion kiềm Excel-FX (MX-99)\u003c/strong\u003e\u003c/li\u003e\n\u003c/ol\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003e1.1. Thiết bị chăm sóc sức khỏe giá tốt thuộc tập đoàn Impart International \u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eImpart International là tập đoàn thành lập vào năm 1985, với đội ngũ kỹ sư có trình độ chuyên môn bậc nhất góp phần phát triển nên ngành công nghệ điện giải Nhật Bản. \u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eImpart Excel-FX (MX-99) là máy lọc nước ion kiềm được sản xuất bởi tập đoàn Impart theo công nghệ điện giải hoàn nguyên chính thống tại Nhật, sở hữu công nghệ và tính năng mạnh mẽ, xứng đáng là lựa chọn tối ưu để chăm sóc và bảo vệ sức khỏe. \u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003e\u003cspan style=\"font-weight: 400;\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/d4/34/21/3a9c1f29d6829d46ab2eaebb0e0f46e3.png\" alt=\"Impart luôn trung thành với công nghệ điện giải Nhật Bản chính thống\" width=\"640\" height=\"640\" /\u003eImpart luôn trung thành với công nghệ điện giải Nhật Bản chính thống\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003e1.2. Trang bị 5 tấm điện cực nguyên khối siêu lớn làm từ Titan phủ Platinum quý giá\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eTấm điện cực là “trái tim” của máy điện giải điện giải ion kiềm. Vì thế mà các nhà sản xuất chưa bao giờ ngừng nghỉ trong cuộc chạy đua công nghệ điện cực, trong đó có tập đoàn Impart. Tiền thân là doanh nghiệp thu mua và sản xuất bạch kim nên tấm điện cực máy điện giải Impart luôn đạt chuẩn chất lượng với kích thước lớn. \u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eImpart Excel-FX (MX-99) được trang bị 5 tấm điện cực Titan  phủ Platinum với tổng diện tích bề mặt tiếp xúc lên đến 750 cm2. Với kích thước lớn hàng đầu trong ngành, tấm điện cực của Impart có tuổi thọ lên đến 25 năm, làm tăng độ rộng của dải pH và nồng độ hydro trong nước.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003e\u003cspan style=\"font-weight: 400;\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/76/a2/72/e603dc4261d3bb1fa6679e9942a5531f.png\" alt=\"Tấm điện cực của máy lọc nước ion kiềm Impart Excel-FX(MX-99 được làm từ Titan phủ Platinum nguyên chất\" width=\"640\" height=\"640\" /\u003eTấm điện cực của máy lọc nước ion kiềm Impart Excel-FX(MX-99 được làm từ Titan phủ Platinum nguyên chất\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003e1.3. Tạo ra 8 loại nước quý đáp ứng đa dạng nhu cầu sử dụng với dải pH siêu rộng\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eMáy lọc nước ion kiềm Impart Excel-FX(MX-99) có khả năng tạo đến 8 loại nước chức năng với dải pH ~2.4 đến 11.6 phục vụ đa dạng nhu cầu sử dụng hằng ngày. Cụ thể như sau:\u003c/span\u003e\u003c/p\u003e\n\u003cul style=\"text-align: justify;\"\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eNước ion kiềm cấp 1 (pH ~8.5): Nước dành cho người mới bắt đầu.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eNước ion kiềm cấp 2 (pH ~9.0): Nước uống dành đã quen dùng nước ion kiềm.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eNước ion kiềm cấp 3 (pH ~9.5):  Nước uống hằng ngày, pha trà, nấu súp và hầm.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eNước ion kiềm cấp 4 ((pH 9.5+): Có thể tăng cường pH lên mức 9.55 – 9.85 (tùy thuộc nguồn nước đầu vào),  sử dụng khi cơ thể hấp thụ lượng lớn thực phẩm có tính axit mạnh.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eNước ion kiềm mạnh (pH ~11.6): Dùng rửa rau, củ, quả để loại bỏ chất bảo quản, thuốc trừ sâu. Hoặc có thể dùng để loại bỏ vết dầu mỡ trên đồ dùng, quần áo.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eNước lọc trung tính (pH ~7.0): Dùng để uống sau khi ăn, sử dụng khi uống thuốc tây, pha sữa và nấu ăn cho em bé.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eNước ion axit yếu (pH ~5.5): Để chăm sóc da và tóc, se khít lỗ chân lông.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eNước ion axit mạnh (pH ~2.4): Sử dụng để vệ sinh, sát trùng và khử khuẩn hiệu quả.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eĐặc biệt, với nước ion kiềm cấp 4  (pH 9.5+) được xem là cải tiến mới, chỉ có những dòng máy điện giải ion kiềm cao cấp mới có được. Ở cấp này còn có thể tăng cường pH lên mức 9.55 – 9.85 (tùy vào điều kiện nước đầu vào). Một số khu vực nước máy có tính axit thì chức năng Alkaline 4 sẽ giúp tăng tính kiềm trong nước lên dễ dàng.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003e\u003cspan style=\"font-weight: 400;\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/45/42/74/a3da136de1bce0c89f9a99dac42f333a.png\" alt=\"Máy lọc nước ion kiềm  Impart Excel-FX(MX-99) tạo nước ion kiềm giàu hydro tốt cho sức khỏe\" width=\"640\" height=\"640\" /\u003eMáy lọc nước ion kiềm  Impart Excel-FX(MX-99) tạo nước ion kiềm giàu hydro tốt cho sức khỏe\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003e1.5. Tuổi thọ lõi lọc cao lên đến 12,000 lít tiết kiệm chi phí\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eMáy điện giải ion kiềm Excel-FX (MX-99) có lõi lọc tinh gồm 6 tầng lọc hiệu suất cao, tuổi thọ lên đến 12,000 lít. Nguồn nước khi đi qua lõi lọc sẽ loại bỏ căn bản 13 loại tạp chất theo tiêu chuẩn JIS và 6 chất độc hại theo chuẩn JWPA Nhật Bản. \u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eCông suất lọc này so với một số dòng máy tương đồng vẫn cao hơn rất nhiều. Điều này giúp người dùng tiết kiệm chi phí đáng kể vì không phải thay lõi lọc thường xuyên. Đặc biệt, nước sau khi lọc sẽ có thêm nhiều khoáng chất có lợi cho cơ thể như Ca, Na, K, Mg,... từ các loại đá khoáng thiên nhiên, mang đến nguồn nước đầu ra có vị tự nhiên như các nguồn suối khoáng thiên nhiên.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003e\u003cspan style=\"font-weight: 400;\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/07/da/26/9b3117a7887181d5a7d797e98ecd0ac3.png\" alt=\"Tuổi thọ lõi lọc cao của  máy lọc nước ion kiềm Impart Excel-FX (MX-99)giúp mọi người tiết kiệm chi phí, không phải thay lõi lọc thường xuyên\" width=\"640\" height=\"640\" /\u003eTuổi thọ lõi lọc cao của  máy lọc nước ion kiềm Impart Excel-FX (MX-99)giúp mọi người tiết kiệm chi phí, không phải thay lõi lọc thường xuyên\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003e1.4. Thiết kế tối giản và thân thiện với người dùng\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eMáy điện giải Impart Excel-FX (MX-99) được thiết kế gọn nhẹ, không cầu kỳ. Sản phẩm khoác lên màu trắng trang nhã, các cạnh bo góc uyển chuyển thích hợp với mọi không gian. Bên cạnh đó, Impart Excel-FX (MX-99) còn là máy lọc nước ion kiềm dễ sử dụng với các nút bấm cơ học, màn LCD trực quan hiển thị đầy đủ các thông số cần thiết khi sử dụng như: độ pH, ORP, thời hạn lõi lọc… Kèm theo chế độ tự động vệ sinh buồng điện phân.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003e\u003cspan style=\"font-weight: 400;\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/fd/2f/21/ec9e1d9bab87e29f6eeebd352ede0504.png\" alt=\"Máy lọc nước ion kiềm Excel-FX (MX-99) được thiết kế theo phong cách tối giản, các thông số được hiển thị minh bạch\" width=\"640\" height=\"400\" /\u003eMáy lọc nước ion kiềm Excel-FX (MX-99) được thiết kế theo phong cách tối giản, các thông số được hiển thị minh bạch\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eNgoài ra, ống đựng muối được thiết kế kiểu rời, khi nào cần tạo nước ion axit mạnh và ion kiềm mạnh thì mới gắn vào giúp đảm bảo an toàn tuyệt đối cho người già và trẻ em.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003e1.6.  Đảm bảo chất lượng với các chứng nhận danh giá\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eMáy lọc nước ion kiềm Impart Excel-FX (MX-99) đạt chuẩn chất lượng với các chứng nhận danh giá như: \u003c/span\u003e\u003c/p\u003e\n\u003cul style=\"text-align: justify;\"\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eChứng nhận thiết bị y tế tại Nhật JET - 219AKBZX00147000\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eChứng nhận ngành sản xuất đạt chuẩn thiết bị y tế tại Nhật số: 27BZ006081 (áp dụng cho nhà sản xuất).\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eChứng nhận JIS: Loại bỏ 13 chất độc theo quy định Tiêu chuẩn công nghiệp Nhật.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eChứng nhận JWPA: Loại bỏ 6 chất độc hại theo quy định của Hiệp hội máy lọc nước Nhật Bản.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eChứng nhận SGS Thụy Sĩ kiểm định chất lượng lọc nước.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003col style=\"text-align: justify;\" start=\"2\"\u003e\n\u003cli\u003e\u003cstrong\u003e Giá máy lọc nước ion kiềm  Impart Excel-FX (MX-99) bao nhiêu có tốt không?\u003c/strong\u003e\u003c/li\u003e\n\u003c/ol\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eMáy lọc nước ion kiềm Impart Excel-FX (MX-99) hiện có giá khoảng 70 - 80 triệu đồng. Sản phẩm sở hữu công nghệ điện giải vượt trội nhưng lại có giá vô cùng ưu đãi nên được người tiêu dùng tin chọn.\u003c/span\u003e\u003c/p\u003e\n\u003col style=\"text-align: justify;\" start=\"3\"\u003e\n\u003cli\u003e\u003cstrong\u003e Thông số kỹ thuật quan trọng của máy lọc nước ion kiềm Impart Excel-FX (MX-99)\u003c/strong\u003e\u003c/li\u003e\n\u003c/ol\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"font-weight: 400;\"\u003e -Thương hiệu: Impart.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"font-weight: 400;\"\u003e- Nơi sản xuất: Nhật Bản.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"font-weight: 400;\"\u003e- Model: Impart Excel-FX (MX-99).\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"font-weight: 400;\"\u003e- Số tấm điện cực: 5 tấm.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"font-weight: 400;\"\u003e - Cấu tạo điện cực: Titan phủ Platinum.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"font-weight: 400;\"\u003e- Tuổi thọ tấm điện cực: 25 năm.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"font-weight: 400;\"\u003e- 8 loại nước chức năng:\u003c/span\u003e\u003c/p\u003e\n\u003cul style=\"text-align: justify;\"\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eNước ion kiềm cấp 1 (pH ~8.5): Nước dành cho người mới bắt đầu.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eNước ion kiềm cấp 2 (pH ~9.0): Nước uống dành đã quen dùng nước ion kiềm.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eNước ion kiềm cấp 3 (pH ~9.5):  Nước uống hằng ngày, pha trà, nấu súp và hầm.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eNước ion kiềm cấp 4 ((pH 9.5+): Có thể tăng cường pH lên mức 9.55 – 9.85 (tùy thuộc nguồn nước đầu vào),sử dụng khi cơ thể hấp thụ lượng lớn thực phẩm có tính axit mạnh.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eNước ion kiềm mạnh (pH ~11.6): Dùng rửa rau, củ, quả để loại bỏ chất bảo quản, thuốc trừ sâu. Hoặc có thể dùng để loại bỏ vết dầu mỡ trên đồ dùng, quần áo.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eNước lọc trung tính (pH ~7.0): Dùng để uống sau khi ăn, sử dụng khi uống thuốc tây, pha sữa và nấu ăn cho em bé.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eNước axit yếu (pH ~5.5): Để chăm sóc da và tóc, se khít lỗ chân lông.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eNước axit mạnh (pH ~2.4): Sử dụng để vệ sinh, sát trùng và khử khuẩn hiệu quả.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"font-weight: 400;\"\u003e- Dải pH:  ~2.4 đến 11.6.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"font-weight: 400;\"\u003e- Cấu tạo lõi lọc tinh: 1 lõi lọc đá khoáng thiên nhiên, gồm 6 tầng lọc.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"font-weight: 400;\"\u003e- Kích thước: W 250mm × H 309mm × D 133.6mm.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"font-weight: 400;\"\u003e- Khối lượng: 3.2 kg (khi chưa chứa nước).\u003c/span\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/d5/3e/6b/c5649ebb29bb2422dfd03d10290e8a52.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d5/3e/6b/c5649ebb29bb2422dfd03d10290e8a52.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d5/3e/6b/c5649ebb29bb2422dfd03d10290e8a52.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d5/3e/6b/c5649ebb29bb2422dfd03d10290e8a52.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d5/3e/6b/c5649ebb29bb2422dfd03d10290e8a52.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/09/f2/55/d589549c16442172b60eab3e7790911f.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/09/f2/55/d589549c16442172b60eab3e7790911f.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/09/f2/55/d589549c16442172b60eab3e7790911f.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/09/f2/55/d589549c16442172b60eab3e7790911f.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/09/f2/55/d589549c16442172b60eab3e7790911f.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/14/f6/49/e162b2ecb027a58156c22bc110ba58bf.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/14/f6/49/e162b2ecb027a58156c22bc110ba58bf.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/14/f6/49/e162b2ecb027a58156c22bc110ba58bf.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/14/f6/49/e162b2ecb027a58156c22bc110ba58bf.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/14/f6/49/e162b2ecb027a58156c22bc110ba58bf