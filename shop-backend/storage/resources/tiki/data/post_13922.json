dge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":18,"review_text":"(18)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/46/b7/52/e0003e0c64f813c9b7434331520edf5b.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1631,"all_time_quantity_sold":179,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003eGiới thiệu\u003c/h3\u003e\n\u003cp\u003eTiên phong trong nghiên cứu, Nutricare đã thành công nghiên cứu và phát triển dòng sản phẩm chuyên biệt dành cho người bệnh suy thận - Nutricare Kidney 1: Dinh dưỡng chuyên biệt cho người suy thận, tiền chạy thận nhân tạo.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/cf/16/78/c176bd0dd6641763f8ec1fe148a5a05c.jpg\" alt=\"c176bd0dd6641763f8ec1fe148a5a05c.jpg\" width=\"750\" height=\"277\" /\u003e\u003c/p\u003e\n\u003ch3\u003eCông dụng\u003c/h3\u003e\n\u003cdiv class=\"desc-otp1 col-md-12\"\u003e\n\u003cdiv class=\"desc-otp3 col-md-12\"\u003e\n\u003cdiv class=\"desc-otp4 col-md-12\"\u003e\n\u003ch4\u003eGiảm protein \u0026amp; giúp cân bằng điện giải\u003c/h4\u003e\n\u003cp\u003eProtein thấp giúp giảm Urê máu, giảm tải cho hoạt động của thận.\u003c/p\u003e\n\u003cp\u003eÍt Natri - Kali - Phốt pho giúp cân bằng điện giải, giảm tải hoạt động cho thận, giảm tình trạng tăng huyết áp, phù nề, loãng xương do dư thừa Natri, Kali, Phốt pho gây nên.\u003c/p\u003e\n\u003cp\u003eĐặc biệt, công thức pha phù hợp giúp đảm bảo tối thiểu lượng nước cung cấp vào cơ thể*.\u003c/p\u003e\n\u003ch4\u003eDễ tiêu hóa, tốt cho tim mạch\u003c/h4\u003e\n\u003cp\u003eTinh chất dầu Olive cùng MUFA, PUFA giúp giảm rối loạn chuyển hóa lipid, giảm tình trạng xơ vữa động mạch, tốt cho tim mạch.\u003cbr /\u003e100% chất xơ hòa tan Polydextrose và không chứa đường Lactose giúp dễ tiêu hóa.\u003c/p\u003e\n\u003ch4\u003eKiểm soát đường huyết\u003c/h4\u003e\n\u003cp\u003eHệ bột đường Palatinose, Isomalt được EFSA CHÂU ÂU công nhận có chỉ số đường huyết thấp giúp kiểm soát đường huyết, dùng được cho người tiểu đường.\u003c/p\u003e\n\u003ch4\u003eGiảm thiếu máu, tăng cường sức khỏe\u003c/h4\u003e\n\u003cp\u003eGiàu dinh dưỡng, năng lượng cao và bổ sung đầy đủ vitamin \u0026amp; khoáng chất giúp tăng cường sức khỏe.\u003cbr /\u003eSắt, axit Folic, Vitamin B12 giúp giảm tình trạng thiếu máu.\u003c/p\u003e\n\u003ch3\u003eThành phần\u003c/h3\u003e\n\u003cp\u003eMột ly sữa chuẩn Nutricare Kidney 1 - 179kcal/ly/125ml\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eProtein: ..................... 4,4g\u003c/li\u003e\u003cli\u003eLipid: ....................... 10,9g\u003c/li\u003e\u003cli\u003eCarbohydrate: ............ 22g\u003c/li\u003e\u003c/ul\u003e\n\u003ch3\u003eĐối tượng sử dụng\u003c/h3\u003e\n\u003cul\u003e\u003cli\u003eBệnh nhân suy thận giai đoạn trước chạy thận nhân tạo, người cần chế độ ăn giảm Protein.\u003c/li\u003e\u003cli\u003eCó thể dùng cho cả bệnh nhân tiểu đường.\u003c/li\u003e\u003cli\u003eKhông dùng cho trẻ em dưới 2 tuổi.\u003c/li\u003e\u003c/ul\u003e\n\u003ch3\u003eHướng dẫn sử dụng\u003c/h3\u003e\n\u003cul\u003e\u003cli\u003eCách pha: Cho từ từ 40g Nutricare Kidney 1 (4 muỗng gạt) vào 95 ml nước đun sôi để ấm khoảng 45-50°C, khuấy đều được 125 ml dung dịch cung cấp 179 kcal.\u003c/li\u003e\u003cli\u003eLiều dùng khuyến cáo: 2 – 3 ly/ngày. Nutricare Kidney 1 sử dụng hết trong vòng 3 giờ sau khi pha.\u003c/li\u003e\u003cli\u003eHỗn hợp sau khi pha sử dụng hết trong vòng 3 giờ.\u003c/li\u003e\u003c/ul\u003e\n\u003ch3\u003eBảo quản\u003c/h3\u003e\n\u003c/div\u003e\n\u003cdiv class=\"desc-otp4 col-md-12\"\u003e\n\u003cul\u003e\u003cli\u003eĐậy kín nắp sau mỗi lần sử dụng. Sản phẩm đã mở nắp sử dụng hết trong vòng 3 tuần.\u003c/li\u003e\u003cli\u003eBảo quản ở nơi khô ráo, sạch sẽ, thoáng mát, tránh ánh nắng trực tiếp.\u003c/li\u003e\u003c/ul\u003e\n\u003ch3\u003eCác phân loại đóng gói\u003c/h3\u003e\n\u003cul\u003e\u003cli\u003eHộp 400g\u003c/li\u003e\u003cli\u003eHộp 900g\u003c/li\u003e\u003c/ul\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/46/b7/52/e0003e0c64f813c9b7434331520edf5b.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/46/b7/52/e0003e0c64f813c9b7434331520edf5b.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/46/b7/52/e0003e0c64f813c9b7434331520edf5b.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/46/b7/52/e0003e0c64f813c9b7434331520edf5b.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/46/b7/52/e0003e0c64f813c9b7434331520edf5b.png"},{"base_url":"https://salt.tikicdn.com/ts/product/3d/41/4a/726b1e0da28cf7283d583e887ed21d08.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/3d/41/4a/726b1e0da28cf7283d583e887ed21d08.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/3d/41/4a/726b1e0da28cf7283d583e887ed21d08.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3d/41/4a/726b1e0da28