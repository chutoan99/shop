m kinh điển của Ali về tình yêu, khắc họa bức tranh tổng hợp phức tạp về nhiều mặt của cuộc sống, trao cho bạn đọc chiếc chìa khóa để mở ra những điều lý thú, những điều bổ ích.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/64/01/ac/8ce3f4bbfc3385c8bcbff93d0fed9fdf.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/64/01/ac/8ce3f4bbfc3385c8bcbff93d0fed9fdf.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/64/01/ac/8ce3f4bbfc3385c8bcbff93d0fed9fdf.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/64/01/ac/8ce3f4bbfc3385c8bcbff93d0fed9fdf.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/64/01/ac/8ce3f4bbfc3385c8bcbff93d0fed9fdf.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/2a/f8/29/912b0279924862df2766faa3ad79f1ad.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/2a/f8/29/912b0279924862df2766faa3ad79f1ad.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/2a/f8/29/912b0279924862df2766faa3ad79f1ad.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2a/f8/29/912b0279924862df2766faa3ad79f1ad.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2a/f8/29/912b0279924862df2766faa3ad79f1ad.jpg"}],"warranty_policy":null,"authors":[{"id":47869,"name":"Sabahattin Ali","slug":"sabahattin-ali"}],"current_seller":{"id":112977,"sku":"8717250987082","name":"Liên Việt Official Store","link":"https://tiki.vn/cua-hang/lienvietbooks","logo":"https://vcdn.tikicdn.com/ts/seller/88/56/24/80e4a0e582e2e1fdd9bd6924