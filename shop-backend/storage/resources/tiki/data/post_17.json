ackground_color":"#D93843","href":null,"text":"9.9"},{"placement":"pdp_badge","code":"is_hero","type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"freeship_xtra","type":"pdp_icon_badge","index":2,"icon":"https://salt.tikicdn.com/ts/upload/be/67/48/04a82ab8df178e1a13bde38316081865.png","icon_width":91,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":true,"return_reason":"any_reason"}},"discount":20900,"discount_rate":21,"rating_average":4.8,"review_count":1590,"review_text":"(1590)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/3a/f9/10/074f96d82e4a6e94e8a7919fba2664f1.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2686,"all_time_quantity_sold":29514,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eDầu gội chống gàu Selsun 100ml\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eDầu gội thông thường sẽ không giúp bạn giải quyết được nguyên nhân gây gàu - vi nấm Malassezia một cách hiệu quả. Thứ bạn cần là sản phẩm có thành phần chuyên biệt như Selenium Sulfide có trong Selsun.\u003c/p\u003e\n\u003cp\u003e- Vi nấm Malassezia là loại vi nấm luôn thường trực trên da đầu. Thời tiết nóng ẩm, thay đổi thất thường là điều kiện thuận lợi để chúng sinh sôi nhanh chóng. Vi nấm sẽ ăn bã nhờn trên da đầu tạo ra axit béo Axit Oleic (AO). AO này thấm vào lớp trên cùng của biểu bì và làm mất sự ổn định ở môi trường da đầu, từ đó hiện tượng viêm ngứa xuất hiện cùng lớp sừng bong ra nhiều hơn tạo thành gàu.\u003c/p\u003e\n\u003cp\u003e- Nếu không “ức chế” sự phát triển của vi nấm Malassezia này, tình trạng gàu ngứa sẽ luôn tiếp diễn.\u003c/p\u003e\n\u003cp\u003eDầu gội Selsun chống gàu, sạch gàu \u0026amp; hết ngứa da đầu với 1% Selenium Sulfide mang hiệu quả vượt trội trong việc ngăn nấm gây gàu và an toàn, đồng thời giúp giảm ngứa nhanh chóng nhờ thành phần Dipotassium Glycyrrhizate. Sản phẩm phù hợp cho người bị gàu nặng \u0026amp; dai dẳng\u003c/p\u003e\n\u003cp\u003e- Hỗ trợ làm sạch vi nấm gây gàu Malassezia.\u003c/p\u003e\n\u003cp\u003e- Hỗ trợ làm sạch vảy gàu, giúp hết ngứa, khó chịu.\u003c/p\u003e\n\u003cp\u003e- Hỗ trợ cân bằng bã nhờn, không tạo điều kiện cho vi nấm phát triển.\u003c/p\u003e\n\u003cp\u003eVới 94% người sử dụng đánh giá cao hiệu quả làm sạch gàu chỉ sau 2 tuần, dầu gội Selsun với 1% Selenium Sulfide và Dipotassium Glycyrrhizate mang đến hiệu quả sạch gàu, hết ngứa tối ưu mà an toàn sẽ giúp bạn nói “không” với gàu để nói “có” với mái tóc khỏe đẹp. Đặc biệt, dầu gội Selsun đã được kiểm nghiệm về tính an toàn, lành tính cho da đầu, kể cả da nhạy cảm.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eHướng dẫn sử dụng:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Lắc kỹ trước khi dùng. Thoa đều dầu gội lên tóc và da đầu ướt, để 2-3 phút cho kết quả tốt nhất. Xả sạch lại với nước.\u003c/p\u003e\n\u003cp\u003e- Để chống gàu hiệu quả, dùng dầu gội Selsun đều đặn 2 lần 1 tuần cho đến khi gàu hết hẳn.\u003c/p\u003e\n\u003cp\u003e- Sau đó nên dùng mỗi tuần 1 lần để ngăn ngừa gàu quay trở lại.\u003c/p\u003e\n\u003cp\u003eThông tin thương hiệu:\u003c/p\u003e\n\u003cp\u003e- Thương hiệu Selsun thuộc công ty TNHH Rohto-Mentholatum Việt Nam\u003cbr /\u003e- Xuất xứ thương hiệu: Nhật Bản.\u003cbr /\u003e- Nơi sản xuất: Việt Nam.\u003cbr /\u003e- Hạn sử dụng: 4 năm kể từ ngày sản xuất.\u003cbr /\u003e- Ngày hết hạn \u0026amp; số lô: Xem chi tiết trên bao bì.\u003c/p\u003e\n\u003cp\u003e* Bao bì có thể thay đổi tùy theo đợt nhập hàng.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/3a/f9/10/074f96d82e4a6e94e8a7919fba2664f1.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/3a/f9/10/074f96d82e4a6e94e8a7919fba2664f1.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/3a/f9/10/074f96d82e4a6e94e8a7919fba2664f1.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3a/f9/10/074f96d82e4a6e94e8a7919fba2664f1.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3a/f9/10/074f96d82e4a6e94e8a7919fba2664f1.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/7c/9c/a5/4bd1312c3bcdbe0475df20cffee3c5a6.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/7c/9c/a5/4bd1312c3bcdbe0475df20cffee3c5a6.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/7c/9c/a5/4bd1312c3bcdbe0475df20cffee3c5a6.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7c/9c/a5/4bd1312c3bcdbe0475df20cffee3c5a6.jpg","