c và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/b4/59/47/5d5f55a6d841b33d04cf461e4bb21db8.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b4/59/47/5d5f55a6d841b33d04cf461e4bb21db8.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b4/59/47/5d5f55a6d841b33d04cf461e4bb21db8.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b4/59/47/5d5f55a6d841b33d04cf461e4bb21db8.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b4/59/47/5d5f55a6d841b33d04cf461e4bb21db8.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/df/88/10/3c69f8dbcd0d50af22623fd6ddd04573.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/df/88/10/3c69f8dbcd0d50af22623fd6ddd04573.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/df/88/10/3c69f8dbcd0d50af22623fd6ddd04573.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/df/88/10/3c69f8dbcd0d50af22623fd6ddd04573.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/df/88/10/3c69f8dbcd0d50af22623fd6ddd04573.jpg"}],"warranty_policy":null,"brand":{"id":85251,"name":"Phú Sĩ","slug":"phu-si"},"current_seller":{"id":152276,"sku":"4624557328750","name":"Ajinomoto Official Store","link":"https://tiki.vn/cua-hang/ajinomoto-official-store","logo":"94/58/a8/d2be3ebf7e941f2028ec5df1075d3c87.jpg","price":144000,"product_id":"151547035","store_id":140482,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Content","attributes":[{"code":"brand","name":"Thương hiệu","value":"Phú Sĩ"},{"code":"brand_country","name":"Xuất xứ thương hiệu","value":"Nhật Bản"},{"code":"expiry_time