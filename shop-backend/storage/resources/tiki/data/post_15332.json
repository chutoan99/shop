lor":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.7,"review_count":13,"review_text":"(13)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/6d/6f/88/a5f2b730e4dc8d0b893e71404b3227c9.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1260,"all_time_quantity_sold":98,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: center;\"\u003e\u003cstrong\u003eHạt dẻ cười DK Harvest\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003eHạt dẻ cười (hay quả hồ trăn) thường được bắt gặp trên các mâm mứt bánh kẹo ngày Tết hay trong gian bếp của nhiều gia đình Việt.\u003cbr /\u003eĐây là một loại quả hạch đơn hạt, màu xanh lục với hương vị bùi béo, thơm dịu, nằm bên trong lớp áo màu hồng và lớp vỏ cứng sẽ nứt đôi khi quả chín\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eMÔ TẢ SẢN PHẨM:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eThương hiệu: DK Harvest.\u003c/li\u003e\n\u003cli\u003eXuất xứ: USA.\u003c/li\u003e\n\u003cli\u003eĐóng gói tại: Việt Nam.\u003c/li\u003e\n\u003cli\u003eThành phần: 100% hạt dẻ cười còn vỏ.\u003c/li\u003e\n\u003cli\u003eTrọng lượng: 450g\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/6a/b1/7e/b00b0af19b3cf285df85942d83813971.jpg\" alt=\"\" width=\"750\" height=\"495\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003eHạt dẻ cười DK Harvest\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTHÔNG TIN SẢN PHẨM HẠT DẺ:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eHạt dẻ cười DK Harvest được nhập khẩu từ USA.\u003c/li\u003e\n\u003cli\u003eHạt dẻ cười được chứng minh là có thể làm giảm LDL (cholesterol “xấu”) và tăng HDL (cholesterol “tốt”).\u003c/li\u003e\n\u003cli\u003eHàm lượng cao các chất chống oxy hóa như vitamin A và E có thể giúp cơ thể chống lại chứng viêm, bảo vệ mạch máu và làm giảm nguy cơ bị bệnh tim.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cem\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/52/bf/f6/dd4756fdf6b85956cc1c1b14a879f762.jpg\" alt=\"\" width=\"750\" height=\"1123\" /\u003e\u003cbr /\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003eHạt dẻ cười DK Harvest\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003eTheo USDA – United states Department of Agriculture  1 ounce (\u0026gt;28gr)  khoảng 49 hạt hẻ cười chứa:\u003c/p\u003e\n\u003cp\u003eCalo: 159\u003c/p\u003e\n\u003cp\u003eProtein: 5,72 gr\u003cbr /\u003eChất béo: 12,85 gr\u003cbr /\u003eCarbonhydrate: 7,70gr\u003cbr /\u003eChất xơ: 3 gr\u003cbr /\u003eĐường: 2,17 gr.\u003cbr /\u003eMagiê: 34 mg\u003cbr /\u003eKali: 291 mg\u003cbr /\u003ePhotpho: 139 mg\u003cbr /\u003eThiamin: 0.247 mg.\u003c/p\u003e\n\u003cp\u003eMột phần hạt dẻ cười cung cấp khoảng 37 % lượng vitamin B6 ~ 1,3mg cơ thể người lớn cần mỗi ngày.\u003c/p\u003e\n\u003cp\u003eVitamin B6 đóng vai trò quan trọng trong cơ thể liên quan đặc biệt tới việc chuyển hóa protein và phát triển nhận thức.\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/e9/cf/68/9f1cfedf42b58d0b67d51fc4def2346e.jpg\" alt=\"\" width=\"750\" height=\"1123\" /\u003e\u003cbr /\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003eHạt dẻ cười DK Harvest\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eHƯỚNG DẪN SỬ DỤNG HẠT DẺ:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eBóc vỏ, dùng trực tiếp hoặc thêm vào bánh\u003c/li\u003e\n\u003cli\u003eHạn sử dụng: 12 tháng.\u003c/li\u003e\n\u003cli\u003eBảo quản: nơi khô ráo, thoáng mát, tránh xa các vùng hơi nóng trực tiếp hoặc gián tiếp.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eĐội ngũ DK Harvest trẻ đầy nhiệt huyết và có niềm đam mê với các loại siêu thực phẩm. DK Harvest sẵn sàng mang lại giá trị hàng đầu cho bạn. Bằng việc bỏ qua nhà phân phối trung gian, DK Harvest có thể cung cấp sản phẩm với giá cả phải chăng hơn.\u003c/p\u003e\n\u003cp\u003eBạn có biết việc bổ sung siêu thực phẩm hàng ngày là một xu hướng trên thế giới. Hãy là người tiêu dùng thông thái để bắt kịp xu hướng này.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/6d/6f/88/a5f2b730e4dc8d0b893e71404b3227c9.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/6d/6f/88/a5f2b730e4dc8d0b893e71404b3227c9.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/6d/6f/88/a5f2b730e4dc8d0b893e71404b3227c9.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6d/6f/88/a5f2b730e4dc8d0b893e71404b3227c9.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6d/6f/88/a5f2b730e4dc8d0b893e71404b3227c9.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/7d/4d/ba/3f8dbc7085b18505fe31a02c2316d45c.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/7d/4d/ba/3f8dbc7085b18505fe31a02c2316d45c.jpg",