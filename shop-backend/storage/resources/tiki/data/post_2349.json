de":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":5,"review_text":"(5)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/52/27/ff/797f4f319355983dac60c9f54d1746f3.jpeg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1132,"all_time_quantity_sold":26,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e \u003c/p\u003e\n\u003cul\u003e\u003cli style=\"list-style-type:none;\"\u003e\n\u003cul\u003e\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eĐộ cứng mềm: \u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003eMềm\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eThời gian bảo hành: \u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e1 năm\u003c/span\u003e\u003cstrong\u003e \u003c/strong\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eChất liệu:\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e Memory Foam\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eMàu sắc:\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e Màu trắng\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eVỏ áo nệm: \u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003eCooling Ice\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eChứng chỉ: \u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003eCertiPUR-US, OEKO-TEX STANDARD 100\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eLưu ý\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e: Màu sắc sản phẩm có thể bị sai lệch do ánh sáng và không gian nơi chụp ảnh\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eCARINA - BỒNG BỀNH NHẸ NHÀNG TỰA MÂY TRÔI\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eĐâu đó giữa vũ trụ bao la, có một tinh vân đang tỏa sáng rực rỡ giữa khoảng không u tối. Và, vẻ đẹp bồng bềnh phiêu lãng của tinh vân ấy chính là nguồn cảm hứng để một sản phẩm mới ra đời. Sản phẩm ấy chính là TOPPER CARINA.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/52/27/ff/10b808e4ea7d0029df77a6b8d3b58b19.jpeg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eChất liệu Memory Foam\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eTopper Carina được làm từ Memory Foam. Chất liệu này có khả năng nâng đỡ đường cong cơ thể một cách hoàn hảo. Còn gì tuyệt vời hơn khi sau một ngày làm việc mệt mỏi, bạn được ngả mình trên một chiếc topper bồng bềnh êm ái tựa mây trên trời.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTinh chất trà xanh\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eBên cạnh việc mang lại cảm giác bồng bềnh êm ái, Carina còn có khả năng loại bỏ độ ẩm và ngăn chặn các tác nhân gây mùi, tất cả là nhờ vào tinh chất trà xanh.  \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/64/0a/c0/7f06a30eb09b9c47b887318fa5266221.jpeg\" alt=\"\" width=\"750\" height=\"749\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eVỏ nệm vải lạnh Icool\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eBao bọc bên ngoài lớp Foam mềm mại êm ái là lớp vỏ nệm vải lạnh Icool thông thoáng, mát mẻ. Đây sẽ là lựa chọn thích hợp cho những ai có sở thích ngủ ở những nơi thời tiết nóng nực. \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eMặt đáy vải Canvas chống trượt\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eMặt dưới sản phẩm được trang bị thêm 1 lớp vải Canvas để giúp hạn chế tình trạng xê dịch khi sử dụng sản phẩm.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eChứng chỉ CertiPUR-US\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eChất liệu Foam thân thiện với môi trường, không chứa những chất gây hại cho sức khỏe.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/52/56/2c/30504d0ff00492a9958fbbb301f488c7.jpeg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eChứng chỉ OEKO-TEX STANDARD 100\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eKhông chứa các chất độc hại. Đảm bảo an toàn cho sức khỏe.\u003c/p\u003e\n\u003cp\u003e#topper #topperdanang #toppermemoryfoam #topperGoodnight #topperchinhhang #muatoppertaiHanoi #muatoppertaiHCM #tambaovenem\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/52/27/ff/797f4f319355983dac60c9f54d1746f3.jpeg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/52/27/ff/797f4f319355983dac60c9f54d1746f3.jpeg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/52/27/ff/797f4f319355983dac60c9f54d1746f3.jpeg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/52/27/ff/797f4f319355983dac60c9f54d1746f3.jpeg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/52/27/ff/797f4f319355983dac60c9f54d1746f3.jpeg"},{"base_url":"https://salt.tikicdn.com/ts/product/3c/00/7d/d814c613f473d7ee895f1fa0079e853e.jpg","is_gallery":true,"label":null,"large_url":"htt