:null,"background_color":null,"href":null,"text":null}],"badges_v3":[{"placement":"pdp_badge","code":"text_badge","type":"text_badge","index":0,"icon":null,"icon_width":0,"icon_height":0,"text_color":"#FFF0F1","background_color":"#D93843","href":null,"text":"9.9"},{"placement":"pdp_badge","code":"is_hero","type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":true,"return_reason":"any_reason"}},"discount":45000,"discount_rate":10,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/6c/cc/4a/fb879099e5e310adedfd3e396f4203c6.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":265,"all_time_quantity_sold":4,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eSandal Thể Thao Eva Phun Nam Biti's Hunter HEM000700 là một sản phẩm rất được phái nam ưa chuộng, vậy, sản phẩm có những ưu điểm như thế nào? Hãy cùng tìm hiểu ngay dưới đây nhé!\u003c/p\u003e\n\u003ch2\u003eĐế Sandal \u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003eĐế Sandal Thể Thao Eva Phun Nam Biti's Hunter HEM000700 được làm từ chất liệu Ip uốn gấp đàn hồi tốt, được xử lý và kiểm tra theo quy trình tiêu chuẩn, nhằm bảo đảm chất lượng bền lâu nhất cho người sử dụng. \u003c/li\u003e\n\u003cli\u003eBên cạnh đó, đế Ip uốn gấp đàn hồi tốt còn có vô số ưu điểm như có khả năng chống mài mòn, trơn trượt, độ đàn hồi cao, ít bị cong vênh khi tác động lực, hạn chế bám bụi bẩn, dễ dàng vệ sinh… Đế có độ cao có thể nâng chiều cao của người dùng một cách tinh tế.\u003c/li\u003e\n\u003cli\u003eBên dưới đế thiết kế thêm rãnh chống trượt dày đặc, phân bổ khắp toàn bộ bề mặt, giúp bảo đảm an toàn cho người dùng trong từng chuyển động.\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch2\u003eQuai sandal\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003eSản phẩm có phần quai Si Nubucks cao cấp, mềm mại, có độ bền màu cao.\u003c/li\u003e\n\u003cli\u003eQuai da được thiết kế với logo của Bitis vô cùng đẹp mắt.\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch2\u003eMàu sắc\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003eSandal Thể Thao Eva Phun Nam Biti's Hunter HEM000700 hiện có màu kem, xám, xanh nhớt. Khách hàng có thể lựa chọn màu sắc tùy theo sở thích và nhu cầu để được màu ưng ý nhất.\u003c/li\u003e\n\u003cli\u003eMàu sắc thực tế có thể chênh lệch 3 - 5 % tùy theo điều kiện ánh sáng.\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch2\u003eSize sandal\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003eSandal Thể Thao Eva Phun Nam Biti's Hunter HEM000700 có các size từ size 39, size 40, size 41, size 42, size 43, size 44, phù hợp với cỡ chân trung bình của các khách hàng nam. Quý khách có thể liên hệ nhân viên Biti’s để được hỗ trợ chọn size thích hợp nhất.\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch2\u003eBảo hành\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003eSản phẩm được bảo hành trong vòng 3 tháng kể từ thời điểm mua hàng. Ngoài ra sản phẩm còn được bảo hành trọn đời với lỗi bong keo, đứt chỉ (vật tư của sản phẩm đủ điều kiện tái chế không bị rách,…).\u003c/li\u003e\n\u003cli\u003eĐổi size trong vòng 7 ngày, đổi sản phẩm lỗi trong vòng 7 ngày, kể từ thời điểm mua hàng, nếu sản phẩm vẫn đáp ứng chính sách đổi trả. Điều kiện và quy định đổi trả, quý khách vui lòng tham khảo trên website chính thức.\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch2\u003eTính năng và lợi ích nổi bật\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003eThiết kế thời trang, nam tính và năng động, dễ phối đồ.\u003c/li\u003e\n\u003cli\u003eThân trên được thiết kế với màu sắc hài hòa, đường chỉ may tinh tế, chắc chắn.\u003c/li\u003e\n\u003cli\u003eCó thể sử dụng cho nhiều mục đích hàng ngày khác nhau như đi làm, đi chơi, đi học…\u003c/li\u003e\n\u003cli\u003eGiá thành tốt, chất lượng cao, kèm nhiều chương trình khuyến mãi hấp dẫn.\u003c/li\u003e\n\u003cli\u003eĐa dạng màu sắc và kích cỡ, đáp ứng tốt hầu hết mọi nhu cầu của khách hàng.\u003c/li\u003e\n\u003cli\u003eChất liệu đế dép, quai dép được chọn lọc và xử lý cẩn thận, tỉ mỉ.\u003c/li\u003e\n\u003cli\u003eChế độ bảo hành uy tín.\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch2\u003eSản phẩm bao gồm\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003eHộp giấy bìa cứng cáp.\u003c/li\u003e\n\u003cli\u003eSandal\u003c/li\u003e\n\u003cli\u003eTúi chống ẩm.\u003c/li\u003e\n\u003cli\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/4f/36/4b/3c75014988de6b30ef8061f6ef29bac0.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/6c/cc/4a/fb879099e5e310adedfd3e396f4203c6.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/c