icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/b9/9b/2b/de8149ce4c0bbcbffb767e41537ee9be.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":679,"all_time_quantity_sold":10,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eTHÔNG TIN SẢN PHẨM:\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eChất liệu: Nhựa trong suốt nhẹ với cấu trúc tuyến tính\u003c/li\u003e\n\u003cli\u003eCạnh vải mềm mại tạo sự thoải mái và bảo vệ vòng khỏi bị sước sát\u003c/li\u003e\n\u003cli\u003eMàu sắc: Trắng, trong suốt.\u003c/li\u003e\n\u003cli\u003eCấu trúc làm cho nó có thể phù hợp với các kích cỡ khác nhau của vật nuôi\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eKÍCH THƯỚC\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eSố 2  Dành cho cổ 32-39cm Độ rộng 20cm\u003c/li\u003e\n\u003cli\u003eSố 3  Dành cho cổ 28-34cm Độ rộng 13.5cm\u003c/li\u003e\n\u003cli\u003eSố 4  Dành cho cổ 26-31cm Độ rộng 13cm\u003c/li\u003e\n\u003cli\u003eSố 5  Dành cho cổ 23-28cm Độ rộng 12cm\u003c/li\u003e\n\u003cli\u003eSố 6  Dành cho cổ 18-22cm Độ rộng 11cm\u003c/li\u003e\n\u003cli\u003eSố 7  Dành cho cổ 13-19cm Độ rộng 8cm\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eCÔNG DỤNG:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eDo sử dụng chất liệu nhựa mềm mại, bền bỉ, chống trầy xước và thiết kế nhẹ, thoáng khí giúp thú cưng của bạn không cảm thấy khó chịu khi đeo vào.\u003c/li\u003e\n\u003cli\u003eĐược gọi với những cái tên khác nhau như vòng chống liếm, loa chống liếm, Sản phẩm này có dạng giống như một chiếc loa hình nón bằng nhựa được bao quanh cổ, được sử dụng để giải quyết vấn đề về bảo vệ vết thương, tránh tự làm trấn thương, ngăn chặn tình trạng cắn người lạ, \u003c/li\u003e\n\u003cli\u003eHầu hết thú cưng đều có một thói quen là liếm vào vết thương của chúng khi chúng bị thương, vuốt ve đôi tai ngứa ngáy của chúng , dụi mắt bị kích thích và nói chung là gãi và nhai các bộ phận cơ thể mà chúng không nên. Điều này có thể gây ra tình trạng nhiễm trùng vào các vết thương, khiến chúng trầm trọng hơn nhiều. Bởi vậy, đây chính là lý do vì sao bạn nên sử dụng vòng chống liếm cho thú cưng.\u003c/li\u003e\n\u003cli\u003eCũng do bản năng hay liếm và nhằn những bộ phận trên cơ thể nên để tránh trường hợp thú cưng của bạn liếm thuốc, bạn nên mua ngay một chiếc loa chống liếm tiện dụng này\u003c/li\u003e\n\u003cli\u003eMột lợi ích khác của vòng chống liếm đó chính là ngăn chặn các bé cắn người lạ.\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/db/c2/f3/d003017567b036714e335e6b9e6d597a.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/01/be/6f/0cb29f5743ff5c1d8ba5f48516f3c8ea.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e\u003cp\u003eSản phẩm này là tài sản cá nhân được bán bởi Nhà Bán Hàng Cá Nhân và không thuộc đối tượng phải chịu thuế GTGT. Do đó hoá đơn VAT không được cung cấp trong trường hợp này.\u003c/p\u003e","images":[{"base_u