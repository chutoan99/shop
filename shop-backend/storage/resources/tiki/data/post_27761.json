color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":290000,"discount_rate":37,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/e0/08/00/ec7cfb0c10b4c07e09dc051506f38890.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":298,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eTrong cuộc sống hiện đại, việc duy trì lối sống lành mạnh và tiết kiệm thời gian trở nên quan trọng hơn bao giờ hết. Đó chính là lý do tại sao Máy Vắt Cam trở thành món đồ gia dụng được tìm kiếm nhiều trong thời gian qua.\u003c/p\u003e\n\u003cp\u003eVới nhiều điểm mạnh ấn tượng, máy vắt cam Unie UJ550 không chỉ giúp việc vắt cam, chanh một cách hiệu quả mà còn có thể tạo những ly nước ép trái cây thơm ngon.\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003e5 Cối Ép Cho Đa Dạng Trái Cây\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003eMáy Vắt Cam UJ550 được thiết kế với 5 cối ép đa dạng, cho phép bạn tận hưởng nước ép tươi ngon từ nhiều loại trái cây như cam, chanh,… Đặc biệt, máy còn có thể ép nước với những loại trái cây mọng nước như dưa hấu, lựa, nho,… Chỉ cần nhấn và xoay nhẹ trái cây trên đầu vắt là bạn đã có 1 ly nước thơm ngon, bổ dưỡng.\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"aligncenter size-full wp-image-12727 lazy-load-active\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/0b/62/a4/7d5f36aea69f968f8d64481bf4910a46.jpeg\" alt=\"\" width=\"2000\" height=\"2000\" /\u003e\u003c/p\u003e\n\u003cp\u003eNgoài ra, tốc độ ép nhanh và thao tác nhấn nhẹ nhàng, có thể sử dụng 1 tay, ít tác động nhiều lực lên vỏ trái cây ép sẽ không làm vỏ tiết nhiều tinh dầu, gây đắng nước ép như vắt bằng tay.\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eVắt Kiệt Nước \u0026amp; Ép Kiệt Bã\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003eThiết kế của máy với các đầu vắt cam và đầu ép đảm bảo việc ép nước trái cây kiệt bã nhất có thể. Phần nắp lọc của máy bố trí các khe, rãnh nhỏ đều nhau giúp giữ trọn phần xác và hạt cam, mang lại những ly nước cam tươi ngon. \u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"aligncenter size-full wp-image-12728 lazy-load-active\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/f9/12/24/063516f4445235629b5e2e723c6ac9ca.jpeg\" alt=\"\" width=\"2000\" height=\"2000\" /\u003e\u003c/p\u003e\n\u003cp\u003eNgoài ra, chất liệu nhựa PP an toàn trong vệ sinh thực phẩm, bền bỉ giúp bạn hoàn toàn yên tâm sử dụng trong thời gian dài.\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eĐảo Chiều Tự Động Tối Ưu Lượng Nước Ép\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003eMột trong những điểm độc đáo của chiếc máy chính là khả năng đảo chiều tự động để tối ưu hóa lượng nước ép. Sau mỗi lần ấn, máy sẽ tự động đổi chiều xoay đầu vắt theo hướng ngược lại, giúp vắt kiệt từng tép cam và cho lượng nước ép nhiều hơn so với việc vắt bằng tay.\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"aligncenter size-full wp-image-12730 lazy-load-active\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/6d/69/e5/ea5f9b6e42c807c3516741a99b0e11da.jpeg\" alt=\"\" width=\"2000\" height=\"2000\" /\u003e\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eDễ Dàng Thao Tác Và Vệ Sinh\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003eCác bộ phận có thể tháo rời giúp bạn dễ dàng lau chùi và bảo quản máy sau mỗi lần sử dụng. Đặc biệt các bộ phận đầu vắt và nắp lọc, cốc đựng đều có thể vệ sinh trong máy rửa chén, vô cùng tiện lợi.\u003c/p\u003e\n\u003cp\u003eNếu bạn đang tìm kiếm một sản phẩm máy vắt cam đa năng, hiệu quả và tiện lợi, thì không thể bỏ qua máy  vắt cam Unie UJ550. \u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"aligncenter size-full wp-image-12729 lazy-load-active\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/5c/20/cd/da0e2538c801292aa0e68c371df53ced.jpeg\" alt=\"\" width=\"2000\" height=\"2000\" /\u003e\u003c/p\u003e\n\u003cp\u003eLưu ý khi sử dụng:\u003c/p\u003e\n\u003cp\u003e– Không nhúng bộ phận động cơ vào nước hoặc bất kỳ chất lỏng nào khác.\u003c/p\u003e\n\u003cp\u003e– Luôn đặt thiết bị trên bề mặt ngang và bằng phẳng.\u003c/p\u003e\n\u003cp\u003e– Không nên cho máy hoạt động quá 10 phút mỗi lần.\u003c/p\u003e\n\u003cp\u003e– Nên vệ sinh lưới lọc thường xuyên, để lượng nước ép lấy ra được tối ưu.\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eThông tin kỹ thuật\u003c/strong\u003e\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003eTên sản phẩm: Máy vắt cam\u003c/li\u003e\n\u003cli\u003eModel: UJ550\u003c/li\u003e\n\u003cli\u003eĐiện áp: 220V/50Hz\u003c/li\u003e\n\u003cli\u003eDung tích: 700ML\u003c/li\u003e\n\u003cli\u003eCông suất: 35W\u003c/li\u003e\n\u003cli\u003eKích thước sản phẩm: 192 x 155 x 238 mm\u003c/li\u003e\n\u003cli\u003eTrọng lượng: 0.86 kg\u003c/li\u003e\n\u003cli\u003eBảo hành: 12 tháng\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg class=\"aligncenter size-full wp-image-12731 lazy-load-active\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/f6/9c/0a/59e291eaf693c2649b49313e86a6ddc1.jpeg\" alt=\"\" width=\"2000\" height=\"2000\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/e0/08/00/ec7cfb0c10b4c07e09dc051506f38890.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e0/08/00/ec7cfb0c10b4c07e0