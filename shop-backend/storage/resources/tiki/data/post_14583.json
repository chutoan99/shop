"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/27/66/fc/075295f084d18671a9b96354d22c3a45.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":551,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eTrà Sam Hồng 500gram được sản xuất và phân phối bởi Công Ty TNHH Chăm Sóc Sức Khỏe Trà VG Việt Nam, sản phẩm được biết đến là loại thảo mộc bổ mát số 1 thế giới, mọc ở vùng núi cao như Lào Cai, Hà Giang, Yên Bái, Thái Nguyên… Trà Sam Hồng hỗ trợ chữa bệnh mất ngủ, giải độc gan hạ men gan, tốt cho người bị đau dạ dày và tiểu đường.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch3\u003eTại sao Trà Sam Hồng lại được yêu thích?\u003c/h3\u003e\n\u003cp\u003eTrà Sam Hồng 500gram  là hương vị yêu thích của nhiều người yêu sức khỏe cho gia đình, Trà sam hồng từ lâu đã được biết đến như một loại thảo dược với nhiều công dụng như giúp tăng cường hệ tiêu hóa, giảm bớt cholesteron và co thắt dạ dày. Trà sam hồng là món đồ uống thơm ngon và bổ dưỡng giúp giảm đau đầu, chóng mặt, ngủ ngon, chống cảm lạnh, chữa khó tiêu… chứa vitamin B, canxi và kali giúp tăng cường hệ miễn dịch trong cơ thể.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch2\u003eCông Dụng Trà Sam Hồng\u003c/h2\u003e\n\u003cp\u003e rất tốt trong việc chống hôi miệng do hút thuốc, uống rượu bia hằng ngày. Đây là lý do tại sao trà sam hồng cũng là một thành phần quan trọng, đồng hành trong cuộc sống chúng ta hằng ngày. Uống Trà sam hồng mỗi ngày là biện pháp cứu trợ tuyệt vời khi bị ho và cảm lạnh. Nó giúp chữa đau họng, cũng như giảm tình trạng ho khan. Đồng thời có tác dụng rất tốt trong việc cải thiện các triệu nóng gan, mỡ trong máu. Bất kỳ loại chứng ợ hơi hoặc các bệnh về dạ dày liên quan đến việc ăn thực phẩm hỏng có thể được chữa khỏi đơn giản bằng cách uống trà sâm hồng mỗi ngày. Uống trà sam hồng thường xuyên cũng giúp cải thiện hệ tiêu hóa, chống lại đầy hơi và ợ hơi.Trà sam hồng gói lớn giúp làm giảm cảm giác buồn nôn và nôn, đặc biệt là trong thời gian mang thai và sau khi hóa trị. Nó có đặc tính nhẹ nhàng tự nhiên cho cơ thể. Uống trà sam hồng trước khi đi ngủ sẽ giúp cơ bắp của bạn thư giãn và đi vào giấc ngủ một cách dễ dàng hơn.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eTrà sam hồng có đặc tính ức chế cảm giác ngon miệng, từ đó giúp bạn tránh ăn quá nhiều. Khi kết hợp với trà xanh, trà sam hồng làm tăng tốc độ trao đổi chất, do đó giúp bạn cắt giảm lượng mỡ dư thừa, hỗ trợ giảm cân hiệu quả. Bên cạnh đó, trà sam hồng có khả năng giải quyết vấn đề nội tiết tố trong cơ thể, do đó làm giảm mụn trứng cá và làm sạch da. Một số người thường thêm trà sam hồng vào nước tắm để làm dịu da, chữa bỏng và chứng phát ban.\u003c/p\u003e\n\u003ch3\u003e\u003cem\u003e\u003cstrong\u003eQuy cách đóng gói Trà Sam Hồng:\u003c/strong\u003e\u003c/em\u003e\u003c/h3\u003e\n\u003cp\u003eTrà sam hồng được sấy khô qua nhiệt điện, không sử dụng hóa chất và chất bảo quản, an toàn cho sức khỏe. Có thể dùng để phối hợp với các loại trà khác của Trà sam hồng hương vị ngọt tự nhiên. Sản phẩm được đóng túi bạc, dễ bảo quản, thân thiện với môi trường, mẫu mã hình thức đẹp thích hợp dùng để trưng bày và làm quà biếu.\u003c/p\u003e\n\u003ch4\u003e\u003cstrong\u003eHướng dẫn sử dụng:\u003c/strong\u003e\u003c/h4\u003e\n\u003cul\u003e\u003cli\u003eCho khoảng 15g-20gram trà vào bình, dùng một ít nước sôi tráng trà trước khi pha.\u003c/li\u003e\n\u003cli\u003eDùng khoảng 1.500ml-\u0026gt;2.000ml nước đun sôi ở nhiệt độ 96-\u0026gt;100 độ\u003c/li\u003e\n\u003cli\u003eHãm trà trong bình 5-10 phút để trà ngấm dần\u003c/li\u003e\n\u003cli\u003eCó thể dùng nóng hoặc lạnh tùy theo sở thích\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eBảo Quản: \u003c/strong\u003eBảo quản nơi khô ráo thoáng mát,tránh nơi ẩm ướt, đậy kín nắp sau khi mở nắp.\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e\u003cem\u003eTrà Sam Hồng Cam Kết:\u003c/em\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e=\u0026gt;\u003c/strong\u003eHoàn tiền 100% nếu sản phẩm không đạt chuẩn mô tả\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e=\u0026gt;\u003c/strong\u003eĐổi trả trong vòng 30 ngày\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e=\u0026gt;\u003c/strong\u003eGiao hàng nhanh toàn quốc\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/27/66/fc/075295f084d18671a9b96354d22c3a45.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/27/66/fc/075295f084d18671a9b96354d22c3a45.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/27/66/fc/075295f084d18671a9b96354d22c3a45.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/27/66/fc/075295f084d18671a9b96354d22c3a45.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/27/66/fc/075295f084d18671a9b96354d22c3a45.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/d6/83/8b/570d0540408808aeea18bc8cb0389308.jpeg","is_g