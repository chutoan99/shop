":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/7f/a3/c8/193cc687ea60a860e2a44c225d7bcf07.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1778,"all_time_quantity_sold":28,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2\u003e\u003cstrong\u003eNước Hoa Hồng Dưỡng Ẩm, Chống Viêm Không Mùi Dành Cho Da Nhạy Cảm Klairs Supple Preparation Unscented Toner 180ml\u003cbr /\u003e\u003cbr /\u003eThương hiệu: Klairs\u003cbr /\u003e\u003cbr /\u003eXuất xứ: Hàn Quốc\u003c/strong\u003e\u003c/h2\u003e\n\u003chr /\u003e\u003chr /\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/b9/40/8c/440cced2f6317e9081cce272ea33ccba.jpg\" alt=\"\" width=\"750\" height=\"563\" data-cke-saved-src=\"https://salt.tikicdn.com/cache/w750/ts/product/b9/40/8c/440cced2f6317e9081cce272ea33ccba.jpg\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003e\u003cbr /\u003eMọi người thường lầm tưởng nước hoa hồng là sản phẩm không cần thiết và có thể bỏ qua để đơn giản hoá chu trình dưỡng da. Tuy nhiên, nước hoa hồng mang lại nhiều lợi ích cho làn da. Đặc biệt cách sử dụng nước hoa hồng sẽ ảnh hưởng trực tiếp đến kết quả dưỡng da.\u003cbr /\u003e\u003cbr /\u003eNước Hoa Hồng Dear,Klairs Supple Preparation Unscented Toner là bước quan trọng trong quy trình chăm sóc da hàng ngày, giúp làm sạch sâu bụi bẩn và bã nhờn sâu trong da mà bước rửa mặt chưa làm sạch được hết, đồng thời giúp cân bằng độ pH, hỗ trợ làm dịu và giúp bảo vệ da trước những nguy cơ gây kích ứng từ bên ngoài môi trường.\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" alt=\"\" width=\"750\" height=\"750\" data-cke-saved-src=\"\" /\u003e\u003cbr /\u003e\u003cbr /\u003e\u003c/p\u003e\n\u003cp\u003eDear, Klairs là thương hiệu mỹ phẩm đến từ Hàn Quốc được thành lập vào năm 2010, trực thuộc By Wishtrend. Klairs tập trung vào các sản phẩm lành tính phù hợp với làn da nhạy cảm, đồng thời hãng cũng đề cao sự uy tín trách nhiệm với khách hàng với cam kết \"dùng tốt cho tất cả những khách hàng có làn da nhạy cảm\". Thành phần lành tính vượt trội, không thử nghiệm trên động vật và không chứa hương liệu.\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/59/30/bf/c5a8d0cb70eedd322471209713c2d2ba.jpg\" alt=\"\" width=\"750\" height=\"703\" data-cke-saved-src=\"https://salt.tikicdn.com/cache/w750/ts/product/59/30/bf/c5a8d0cb70eedd322471209713c2d2ba.jpg\" /\u003e\u003cbr /\u003e\u003cbr /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eĐặc tính nổi bật\u003c/strong\u003e\u003cbr /\u003e\u003cbr /\u003e- Nước hoa hồng Klairs Supple Preparation Unscented giúp loại bỏ bụi bẩn và bã nhờn dư thừa trên da sau khi rửa mặt đồng thời cân bằng độ pH để các bước skincare tiếp theo đạt hiệu quả hơn.\u003cbr /\u003e\u003cbr /\u003e- Khi sử dụng toner Klairs, các loại serum và kem dưỡng sẽ hấp thụ vào da tốt hơn 20% so với các loại toner thông thường khác. Đối với da khô, sử dụng liên tục 2 - 3 lần để giúp giảm khô căng cho da. Cùng với khả năng điều tiết bã nhờn và tăng hấp thụ, em ấy phù hợp cho da nhờn bất kể thời tiết.\u003cbr /\u003e\u003cbr /\u003e- Nước hoa hồng của Klairs sử dụng cho da nhạy cảm nhất.\u003cbr /\u003e\u003cbr /\u003e- 100% không chứa alcohol, đem lại 100% khả năng làm sạch những bụi bẩn còn sót lại, se lỗ chân lông, tăng cường độ ẩm của 1 toner “đúng chuẩn”,\u003cbr /\u003e\u003cbr /\u003e- Không những thế còn tăng cường thêm hydration và độ mịn da như em bé tác dụng chống viêm và sần đỏ do mụn gây ra\u003cbr /\u003e\u003cbr /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/c1/9f/87/0cae806f0004cb8d19eb143569d8c701.jpg\" alt=\"\" width=\"750\" height=\"750\" data-cke-saved-src=\"https://salt.tikicdn.com/cache/w750/ts/product/c1/9f/87/0cae806f0004cb8d19eb143569d8c701.jpg\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003e\u003cstrong\u003eCông dụng\u003c/strong\u003e\u003cbr /\u003e\u003cbr /\u003e- Giúp cân bằng PH của da, cải thiện hiệu quả chăm sóc da.\u003cbr /\u003e\u003cbr /\u003e- Dưỡng ẩm và hạn chế tình trạng da khô ráp và bị bong tróc.\u003cbr /\u003e\u003cbr /\u003e- Chống viêm, giúp giảm mẩn đỏ trên da, ngăn ngừa mụn trứng cá.\u003cbr /\u003e\u003cbr /\u003e- Sản phẩm không mùi, không hương hiệu, phù hợp cho những làn da nhạy cảm.\u003cbr /\u003e\u003cbr /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/79/4e/5a/2c23cedf25835d5d388248fdb51d1155.jpg\" alt=\"\" width=\"750\" height=\"500\" data-cke-saved-src=\"https://salt.tikicdn.com/cache/w750/ts/product/79/4e/5a/2c23cedf25835d5d388248fdb51d1155.jpg\" /\u003e\u003cbr /\u003e\u003cbr /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eHướng dẫn sử dụng\u003c/strong\u003e\u003cbr /\u003e\u003cbr /\u003e- Sau khi rửa mặt sạch, cho 1 lượng toner vừa đủ ra bông tẩy trang thấm nhẹ lên mặt theo chiều vòng tròn.\u003cbr /\u003e\u003cbr /\u003e- Chờ khoảng thời gian cho toner hoạt động xong thì dùng tinh chất, sữa dưỡng và kem dưỡng theo nhu cầu da.\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/80/22/1b/5db20a9ba202eb21940f653b1dc46f8b.jpg\" alt=\"\" width=\"750\" height=\"421\" data-cke-saved-src=\"https://salt.tikicdn.com/cache/w750/ts/product/80/22/1b/5db20a9ba202eb21940f653b1dc46f8b.jpg\" /\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/32/57/d4/d13adbb6b0173dff5a282a7cda82ac4b.jpg\" alt=\"\" width=\"750\" height=\"421\" data-cke-saved-src=\"https://salt.tikicdn.com/cache/w750/ts/product/32/57/d4/d13adbb6b0173dff5a282a7cda82ac4b.jpg\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/7f/a3/c8/193cc687ea60a860e2a44c225d7bcf07.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/7f/a3/c8/193cc687ea60a860e2a44c225d7bcf07.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/7f/a3/c8/193cc687ea60a860e2a44c225d7bcf07.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7f/a3/c8/193cc687ea60a860e2a44c225d7bcf07.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7f/a3/c8/193cc687ea60a860e2a44c225d7bcf07.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/18/7f/44/2188fb0e3083f82188d802e88622f778.jpg","is_gallery":true,"label":null,"large_url":"htt