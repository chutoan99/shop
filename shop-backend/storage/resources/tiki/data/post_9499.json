t":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":33250,"discount_rate":35,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/64/49/29/18e2c05152088fbee31a2038032182f4.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1735,"all_time_quantity_sold":37,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"box-sizing: border-box; color: #242424; font-family: Roboto,Helvetica,Arial,sans-serif; font-size: 13px; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px; margin: 5px 0px 12px 0px;\"\u003e\u003cstrong style=\"box-sizing: border-box; font-weight: 500;\"\u003eTự Học Tiếng Hàn Dành Cho Người Mới Bắt Đầu (Kèm CD Hoặc Tải App) - Tái Bản\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; color: #242424; font-family: Roboto,Helvetica,Arial,sans-serif; font-size: 13px; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px; margin: 5px 0px 12px 0px;\"\u003e\u003cstrong style=\"box-sizing: border-box; font-weight: 500;\"\u003eTrình độ người học\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; color: #242424; font-family: Roboto,Helvetica,Arial,sans-serif; font-size: 13px; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px; margin: 5px 0px 12px 0px;\"\u003eSách được xây dựng từ cơ bản dành cho những người chưa từng học qua tiếng Hàn đều có thể học được. Cuốn sách được chia thành 2 phần tối ưu cho người tự học:\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; color: #242424; font-family: Roboto,Helvetica,Arial,sans-serif; font-size: 13px; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px; margin: 5px 0px 12px 0px;\"\u003ePhần 1 - Hướng dẫn phát âm tiếng Hàn Nguyên âm, phụ âm, phụ âm cuối, quy tắc viết chữ, quy tắc phát âm. Đây là những bài học cơ bản nhất và được trình bày rất rõ ràng, dễ hiểu.\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; color: #242424; font-family: Roboto,Helvetica,Arial,sans-serif; font-size: 13px; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px; margin: 5px 0px 12px 0px;\"\u003ePhần 2 - Luyện nghe nói Hướng dẫn từng mẫu câu và từ vựng cơ bản cho các chủ đề gần gũi trong cuộc sống như chào hỏi, phương hướng, giá cả, thời gian, ngày tháng, thời tiết, nhà hàng, mua sắ\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; color: #242424; font-family: Roboto,Helvetica,Arial,sans-serif; font-size: 13px; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px; margin: 5px 0px 12px 0px;\"\u003e\u003cstrong style=\"box-sizing: border-box; font-weight: 500;\"\u003ePhiên âm\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; color: #242424; font-family: Roboto,Helvetica,Arial,sans-serif; font-size: 13px; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px; margin: 5px 0px 12px 0px;\"\u003eVới phần phiên âm, sách đưa ra cả âm chuẩn lẫn âm bồi tiếng Việt để người tự học dễ dàng tiếp thu và thực hành theo.\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; color: #242424; font-family: Roboto,Helvetica,Arial,sans-serif; font-size: 13px; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px; margin: 5px 0px 12px 0px;\"\u003eCuốn sách không áp đặt cách học vẹt khi luôn đưa ra đầy đủ lý do cho ngữ pháp hay cách phát âm, ví dụ như cùng một âm tiết nhưng cách phát âm sẽ khác nhau do có phụ âm cuối khác nhau.\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; color: #242424; font-family: Roboto,Helvetica,Arial,sans-serif; font-size: 13px; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px; margin: 5px 0px 12px 0px;\"\u003eCuốn sách còn có sự hỗ trợ đắc lực từ đĩa CD do các giáo viên Hàn Quốc thể hiện, giúp bạn học cách phiên âm, giọng điệu đúng chuẩn.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/64/49/29/18e2c05152088fbee31a2038032182f4.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/64/49/29/18e2c05152088fbee31a2038032182f4.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/64/49/29/18e2c05152088fbee31a2038032182f4.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/64/49/29/18e2c05152088fbee31a2038032182f4.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/64/49/29/18e2c05152088fbee31a2038032182f4.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/1d/ca/61/29471e0647887b1cfc4d485b54a32c3e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/1d/ca/61/29471e0647887b1cfc4d485b54a32c3e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/1d/ca/61/29471e0647887b1cfc4d485b54a32c3e.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1d/ca/61/29471e0647887b1cfc4d485b54a32c3e.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1d/ca/61/29471e0647887b1cfc4d485b54a32c3e.jpg"}],"warranty_policy":null,"current_seller":{"id":285428,"sku":"6067276628282","name":"MCBooks Sài Gòn","link":"https://tiki.vn/cua-hang/mcbooks-sai-gon","logo":"ac/6f/a9/9b14150ee8e9bd706b6140c4924b6a28.jpg","price":61750,"product_id":"217140575","store_id":272531,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[{"id":272162,"name":"Sách TKBooks ","link":"https://tiki.vn/cua-hang/sach-mcbook","logo":"f2/26/da/8aba6802a062bbf82377e946ab1a225f.jpg","price":75460,"product_id":"174599032","store_id":259207},{"id":264333,"name":