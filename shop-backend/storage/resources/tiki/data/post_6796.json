e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":244624,"discount_rate":40,"rating_average":4.7,"review_count":37,"review_text":"(37)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/58/14/2b/382e09f35f9b08dd73a0ebd7b3331d9a.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":719,"all_time_quantity_sold":146,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eCetaphil là một dòng chăm sóc da thuộc Galderma Laboratories, một công ty dược nổi tiếng của châu Âu, sản xuất ở Canada với những sản phẩm sáng tạo, được nghiên cứu khoa học, y tế nhằm đáp ứng nhu cầu của người tiêu dùng trên toàn thế giới.\u003c/p\u003e\n\u003cp\u003eThương hiệu này đã cho ra đời biết bao sản phẩm chăm sóc da nổi tiếng, trong đó nổi tiếng nhất là Sữa Rửa Mặt Cetaphil được sáng chế bởi một dược sĩ vào năm 1947 - Dòng sữa rửa mặt được các chuyên gia da liễu bào chế với thành phần an toàn, giúp da mềm mại hoàn toàn không gây kích ứng với cả những làn da nhạy cảm.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eTHÀNH PHẦN:\u003c/p\u003e\n\u003cp\u003e+ Glycerin giúp ngăn ngừa hiện tượng khô da\u003c/p\u003e\n\u003cp\u003e+ Niacinamide (B3) giúp củng cố hàng rào bảo vệ da\u003c/p\u003e\n\u003cp\u003e+ Panthenol (B5) giúp làm dịu và phục hồi làn da\u003c/p\u003e\n\u003cp\u003e+ 6 KHÔNG: Không xà phòng, không paraben, không sulfat, không hương liệu, không dầu khoáng \u0026amp; không thử nghiệm trên động vật.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eĐẶC ĐIỂM NỔI BẬT:\u003c/p\u003e\n\u003cp\u003e- Nếu bạn có làn da nhạy cảm, lỗ chân lông to, hay ngứa rát và mẩn đỏ, da bỏng nắng, nám và tàn nhang thì Cetaphil Gentle Skin Cleanser cũng sẽ giải quyết triệt để mọi vấn đề.\u003c/p\u003e\n\u003cp\u003e- Sữa rửa mặt Cetaphil Gentle Skin Cleanser sẽ là sản phẩm tuyệt vời để chăm sóc da mụn, làm khô nhân mụn, làm liền sẹo, làm mờ thâm.\u003c/p\u003e\n\u003cp\u003e- Cetaphil Gentle Skin Cleanser còn dùng cho nam giới thay kem cạo râu, tắm khô cho sản phụ sau sinh, bệnh nhân hậu phẫu, bệnh nhân cần tránh nhiễm lạnh hoặc làn da thường xuyên bị kích ứng\u003c/p\u003e\n\u003cp\u003e- Sữa rửa mặt Cetaphil phù hợp với da em bé, bạn có thể dùng sữa rửa mặt Cetaphil để rửa tay hay xoa lên những vết rôm sảy của trẻ con hay tắm hàng ngày cho bé, Cetaphil sẽ làm rất tốt nhiệm vụ là làm dịu những vết mẩn, làm lành da lại cực kỳ an toàn\u003c/p\u003e\n\u003cp\u003e- Sản phẩm không mùi, không chứa kiềm, không chứa hương liệu nên rất lành tính, thích hợp với mọi loại da, da khô, da dầu, da mẩn đỏ, da chàm, da mụn, da bị vẩy nến, và đặc biệt là da nhạy cảm.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eTHÔNG TIN SẢN PHẨM:\u003c/p\u003e\n\u003cp\u003e- Tên sản phẩm: Sữa rửa mặt Cetaphil Skin Cleanser\u003c/p\u003e\n\u003cp\u003e- Dung tích: 500ml\u003c/p\u003e\n\u003cp\u003e- Sản xuất tại Canada\u003c/p\u003e\n\u003cp\u003e- Bác sỹ da liễu khuyên dùng\u003c/p\u003e\n\u003cp\u003e- HSD: 30 tháng\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eHƯỚNG DẪN SỬA DỤNG:\u003c/p\u003e\n\u003cp\u003e- Có thể dùng khô được. Sau khi làm ướt da mặt, cho lượng nhỏ vừa đủ, massage lên da mặt và rửa lại sạch với nước.\u003c/p\u003e\n\u003cp\u003e- Ngày dùng : 1-2 lần/ ngày.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eMEDIFA CAM KẾT\u003c/p\u003e\n\u003cp\u003e- Sản phẩm chính hãng, nguyên tem mác và phụ kiện đi kèm. \u003c/p\u003e\n\u003cp\u003e- MEDIFA chịu phí ship hoàn hàng nếu sản phẩm không như cam kết (Quý khách vui lòng quay clip mở hàng để đảm bảo quyền lợi hoàn hàng).\u003c/p\u003e\n\u003cp\u003e- Hình ảnh sản phẩm thực tế có thể không giống với hình ảnh trên sàn, do bao bì sản phẩm có thể thay mà không cần thông báo trước tùy vào lô sản xuất từ nhà cung cấp.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/58/14/2b/382e09f35f9b08dd73a0ebd7b3331d9a.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/58/14/2b/382e09f35f9b08dd73a0ebd7b3331d9a.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/58/14/2b/382e09f35f9b08dd73a0ebd7b3331d9a.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/58/14/2b/382e09f35f9b08dd73a0ebd7b3331d9a.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/58/14/2b/382e09f35f9b08dd73a0ebd7b3331d9a.png"},{"base_url":"https://salt.tikicdn.com/ts/product/39/68/47/8dea854789ae138b36f7f9dc2a83d88e.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/39/68/47/8dea854789ae138b36f7f9dc2a83d88e.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/39/68/47/8dea854789ae138b36f7f9dc2a83d88e.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/39/68/47/8dea854789ae138b36f7f9dc2a83d88e.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/39/68/47/8dea854789ae138b36f7f9dc2a83d88e.png"},{"base_url":"https://salt.tikicdn.com/ts/product/54/eb/3d/37bb0c2eba89efb75c92d8c23e88a2cc.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/54/eb/3d/37bb0c2eba89efb75c92d8c23e88a2cc