ound_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/da/a9/98/3500ee3bc3c9fe4e25a0f5387c15134d.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1142,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cdiv class=\"content-end\"\u003e\n\u003cdiv class=\"content-detail\"\u003e\n\u003cp\u003eLà dòng serum hàng đầu được sản xuất bởi công nghệ Nano có \u003cstrong\u003ekhả năng thẩm thấu sâu\u003c/strong\u003e vào hạ bì da đầu nhờ vào kích thước phân tử siêu nhỏ, xâm nhập vào tận cùng gốc rễ ổ nấm. Đồng thời những hạt Nano Bạc (+Ag) có trong serum đồng loạt phá vỡ các liên kết tế bào nấm, ức chế sự phát triển và phá hủy chúng.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/0e/7d/a0/0417833546822959a26ee19acf362e17.jpg?v=140918\" width=\"600\" height=\"600\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u0026gt;\u0026gt;\u0026gt;Cơ chế hoạt động độc đáo của Serum Gừng đen Nano Mộc Nhu\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eLàm chậm và ngăn quá trình phát triển và lan rộng của tế bào nấm: \u003c/strong\u003eHoạt chất Artemisinin có Serum Gừng Đen Nano Mộc Nhu sẽ thẩm thấu sâu vào lớp hạ bì, nhanh chóng ngăn chặn sự phát triển, lây lan của vết nấm nhờ khả năng chống oxy hóa mạnh, kháng viêm cũng như ức chế quá trình tế bào vi nấm sản sinh.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eĐào thải gốc nấm bám ngay dưới da nhờ hoạt chất của phân tử Nano (+Ag): \u003c/strong\u003eSerum Gừng Đen Nano sẽ nhanh chóng phá hủy mạnh tế bào gốc tự do, vô hiệu hóa liên kết tế bào nấm và đào thải theo cơ chế tự nhiên của cơ thể. Nhờ đó vết nấm sẽ mờ dần và mất hẳn chỉ sau một thời gian ngắn.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003ePhục hồi da đầu và tóc chắc khỏe: \u003c/strong\u003eSự kết hợp hoàn hảo của bộ đôi Rosemary và Lavender chứa hàm lượng axit béo và dưỡng chất cực kì cao sẽ thúc đẩy sản sinh collagen và kích thích tái tạo tế bào da mới giúp da đầu bị hư tổn, mỏng yếu nhanh chóng được phục hồi, săn chắc và khỏe mạnh tự nhiên. Đồng thời, tinh dầu Bưởi và tinh dầu ngọc lan tây có trong sản phẩm sẽ cung cấp độ ẩm, kiểm soát dầu, cải thiện kết cấu da đầu chống gãy rụng giúp lưu thông máu tốt, giảm stress.\u003c/p\u003e\n\u003ch3 id=\"mcetoc_1ev8vc3ec1\"\u003e \u003c/h3\u003e\n\u003cp\u003eThành phần\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"content-end\"\u003e\n\u003cdiv class=\"content-detail\"\u003e\n\u003cp\u003e\u003cstrong\u003eBảng thành phần thảo dược “ quý hiếm “ của Serum Gừng Đen Nano Mộc Nhu\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eGừng đen (Distichochlamys):\u003c/strong\u003e là một loại thuốc quý trong dân gian có tác dụng tăng cường miễn dịch, tăng sức đề kháng cho cơ thể. Ngoài ra hoạt chất sinh học \u003cstrong\u003eMethoxy Luteolin\u003c/strong\u003e có tác dụng kháng khuẩn rất mạnh giúp ngăn bệnh dị ứng, kháng nấm cực tốt.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eLavender\u003c/strong\u003e thúc đẩy sự phát triển của nang tóc mà không gây kích ứng da đầu, ngăn ngừa rụng tóc, giữ độ ẩm cho da đầu.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCedarwood\u003c/strong\u003e giúp cân bằng các tuyến bã nhờn trên da đầu, cân bằng độ pH cần thiết cho tóc.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eLemongrass\u003c/strong\u003e có khả năng kháng khuẩn, nấm phổ rộng với 22 chuẩn khác nhau, giảm gàu sau 1 tuần.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eRosemary\u003c/strong\u003e là một phương pháp kích mọc tóc ít tác dụng phụ, chống nấm gàu và làm đen tóc.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTea tree \u003c/strong\u003ekích thích và tăng lưu thông máu, cải thiện tình trạng nang tóc, thúc đẩy tóc phát triển mạnh, kháng khuẩn mạnh mẽ giúp sạch gàu 40% sau 4 tuần.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eYlang - Ylang\u003c/strong\u003e giúp kiểm soát dầu và cải thiện kết cấu chân tóc, chống gãy rụng hiệu quả.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTinh dầu bưởi\u003c/strong\u003e kích thích mọc tóc, bảo vệ tóc khỏi tia UV và tác động từ nhiệt lượng.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"content-end\"\u003e\u003cspan class=\"enner-heact\"\u003eHướng dẫn sử dụng\u003c/span\u003e Serum Gừng Đen Nano Mộc Nhu để đạt hiệu quả cao nhất:\n\u003cdiv class=\"content-detail\"\u003e\n\u003cul\u003e\n\u003cli aria-level=\"1\"\u003eBước 1: Làm sạch da đầu trước khi sử dụng serum, giúp tạo nền tảng tốt để dưỡng chất dễ dàng thẩm thấu sâu vào bên trong.\u003c/li\u003e\n\u003cli aria-level=\"1\"\u003eBước 2: Bôi trực tiếp tinh chất lên chân tóc, massage thật nhẹ nhàng để tinh chất thẩm thấu sâu vào bên trong.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eLưu ý: Sử dụng hơn 2 lần/ngày để đạt được hiệu quả cao nhất.\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/da/a9/98/3500ee3bc3c9fe4e25a0f5387c15134d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/da/a9/98/3500ee3bc3c9