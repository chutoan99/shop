 loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/bc/ab/37/bc3949bd52645e64014509b96676afef.gif","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/bc/ab/37/bc3949bd52645e64014509b96676afef.gif","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/bc/ab/37/bc3949bd52645e64014509b96676afef.gif","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/bc/ab/37/bc3949bd52645e64014509b96676afef.gif","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/bc/ab/37/bc3949bd52645e64014509b96676afef.gif"},{"base_url":"https://salt.tikicdn.com/ts/product/6b/b8/8a/68fc3d69d4c8b7912099cd08d990c7c8.gif","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/6b/b8/8a/68fc3d69d4c8b7912099cd08d990c7c8.gif","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/6b/b8/8a/68fc3d69d4c8b7912099cd08d990c7c8.gif","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6b/b8/8a/68fc3d69d4c8b7912099cd08d990c7c8.gif","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6b/b8/8a/68fc3d69d4c8b7912099cd08d990c7c8.gif"}],"warranty_policy":null,"authors":[{"id":105,"name":"Kerry Patterson","slug":"kerry-patterson"},{"id":3680,"name":"Al Switzler","slug":""},{"id":3702,"name":"Joseph Grenny","slug":""}],"current_seller":{"id":126688,"sku":"3285974016442","name":"info book","link":"https://tiki.vn/cua-hang/info-book","logo":"https://vcdn.tikicdn.com/ts/seller/66/49/ce/c528ff3a6e4022b080c1f8c6fe7bc541.jpg","price":134100,"product_id":"275534665","store_id":117060,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[{"id":127989,"name":"Times Books","link":"https://tiki.vn/cua-h