ng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/f9/8a/1d/5050dfd9790d5aac01d33f893a0f851c.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f9/8a/1d/5050dfd9790d5aac01d33f893a0f851c.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f9/8a/1d/5050dfd9790d5aac01d33f893a0f851c.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f9/8a/1d/5050dfd9790d5aac01d33f893a0f851c.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f9/8a/1d/5050dfd9790d5aac01d33f893a0f851c.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/0f/f3/61/ef207d36fdbef23c9f05b263fd0d38a9.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0f/f3/61/ef207d36fdbef23c9f05b263fd0d38a9.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/0f/f3/61/ef207d36fdbef23c9f05b263fd0d38a9.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0f/f3/61/ef207d36fdbef23c9f05b263fd0d38a9.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0f/f3/61/ef207d36fdbef23c9f05b263fd0d38a9.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/1b/88/1d/8a87b2d0bf1a84b2cd06805cd1dfb74a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/1b/88/1d/8a87b2d0bf1a84b2cd06805cd1dfb74a.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/1b/88/1d/8a87b2d0bf1a84b2cd06805cd1dfb74a.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1b/88/1d/8a87b2d0bf1a84b2cd06805cd1dfb74a.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1b/88/1d/8a87b2d0bf1a84b2cd06805cd1dfb74a.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/58/8d/5f/a679724288fab8a188c8de944a397e7e.jpg","is_gallery":true,"label":null,