":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/dd/32/f5/5b158b29f63a45263fb6fd4201dc4c81.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2185,"all_time_quantity_sold":12,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: center;\"\u003e\u003ciframe src=\"//www.youtube.com/embed/MWG5oEzGgxQ\" width=\"560\" height=\"314\" allowfullscreen=\"allowfullscreen\"\u003e\u003c/iframe\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003eBộ Tưới Nhỏ Giọt Aqua-Magic System 8063\u003c/strong\u003e Không sử dụng điện hay dùng pin như những dòng sản phẩm thông thường, bộ hệ thống thiết bị tưới tự động năng lượng mặt trời Aqua-magic System của Thiết bị tưới được xem là một hệ thống tưới nhỏ giọt độc lập tốt nhất trên thị trường hiện nay.\u003c/li\u003e\n\u003cli\u003eSản phẩm được làm bằng chất liệu cao cấp, thiết kế thông minh, có khả năng tự động không phụ thuộc nguồn nước và nguồn điện.\u003c/li\u003e\n\u003cli\u003eNgoài ra, bộ hẹn giờ tự động của Aqua-magic System còn tích hợp tấm chuyển hóa quang điện và 1 bơm bên trong giúp lấy nước từ bể chứa, lọc và dẫn nước đến 20 béc tưới nhỏ giọt.\u003c/li\u003e\n\u003cli\u003eĐặc biệt, tấm chuyển hóa quang điện khi được đặt ở vị trí có ánh nắng mặt trời trực tiếp sẽ chuyển hóa ánh sáng thành năng lượng điện giúp sản phẩm hoạt động.\u003c/li\u003e\n\u003cli\u003eSản phẩm sở hữu chế độ tưới ngẫu hứng: 100 ml / mỗi đầu tưới (chương trình đã cài đặt vẫn được lưu) và có thể dùng bất cứ loại thùng, bể chứa nào để cấp nước. Đặc biệt,  Aqua-magic System không cần nguồn điện, không cần vòi nước mà sử dụng 2 pin sạc, nạp điện bởi năng lượng mặt trời giúp tiết kiệm chi phí đáng kể.\u003c/li\u003e\n\u003cli\u003eSản phẩm được thiết kế thông minh, có đèn led biểu thị mức đầy của pin và 54 chương trình tưới được cài đặt chỉ với 2 nút vặn đơn giản. Một nút điều chỉnh tần suất (từ 1 đến 7 ngày), nút còn lại điều chỉnh lưu lượng nước ra cho mỗi béc tưới nhỏ giọt (từ 40 ml đến 200 ml). Tích hợp máy bơm mini bên trong để bơm nước tưới cho cây từ thùng chứa với 54 chương trình tưới được lập trình sẵn, thoải mái lựa chọn chỉ với 2 nút vặn đơn giản.\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/dd/32/f5/5b158b29f63a45263fb6fd4201dc4c81.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/dd/32/f5/5b158b29f63a45263fb6fd4201dc4c81.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/dd/32/f5/5b158b29f63a45263fb6fd4201dc4c81.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/dd/32/f5/5b158b29f63a45263fb6fd4201dc4c81.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/dd/32/f5/5b158b29f63a45263fb6fd4201dc4c81.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/6b/29/25/11a0d1d0927c86c7227b7d17233a03a0.jpeg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/6b/29/25/11a0d1d0927c86c7227b7d17233a03a0.jpeg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/