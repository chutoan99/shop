ll,"text":null}],"badges_v3":[{"placement":"pdp_badge","code":"text_badge","type":"text_badge","index":0,"icon":null,"icon_width":0,"icon_height":0,"text_color":"#FFF0F1","background_color":"#D93843","href":null,"text":"9.9"},{"placement":"pdp_badge","code":"is_hero","type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"freeship_xtra","type":"pdp_icon_badge","index":2,"icon":"https://salt.tikicdn.com/ts/upload/be/67/48/04a82ab8df178e1a13bde38316081865.png","icon_width":91,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":true,"return_reason":"any_reason"}},"discount":400000,"discount_rate":33,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/be/58/7e/fada7c57821c41c62da55285a6e2fab6.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":321,"all_time_quantity_sold":12,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003carticle class=\"4ever-article\"\u003e\n\u003cp\u003e\u003cstrong\u003eẤm siêu tốc BlueStone KTB-3466\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eẤm đun siêu tốc BlueStone KTB-3466\u003c/strong\u003e dung tích 1.5 lít, công suất lớn 2200W, thiết kế đen nhám nguyên khối cực đẹp, cảm ứng có đèn led, có thể tự ngắt khi nước sôi, khi cạn nước hoặc quá nhiệt, inox 304 an toàn sức khỏe, là lựa chọn tối ưu cho gian bếp nhà bạn.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://file.hstatic.net/200000700229/file/untitled-4-01_6068437ce71f4e0d92e9621a975b5b68.png\" alt=\"untitled-4-01_6068437ce71f4e0d92e9621a975b5b68.png\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e1. Thiết kế nguyên khối chắc chắn, có đèn led, cảm ứng dễ dàng điều khiển\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003ca href=\"https://www.bluestone.com.vn/collections/am-dun\" target=\"_blank\" rel=\"noreferrer noopener\"\u003eẤm đun\u003c/a\u003e nước siêu tốc KTB-3466 có dung tích bình đun \u003cstrong\u003e1.5 lít \u003c/strong\u003ephù hợp sử dụng gia đình từ \u003cstrong\u003e2 – 4 thành viên,\u003c/strong\u003e đáp ứng tốt các nhu cầu như pha sữa, trà, nấu mì,…\u003c/p\u003e\n\u003cp\u003eThiết kế dáng hình trụ nguyên khối, màu đen nhám sang trọng, tinh tế. Thân ấm làm từ \u003cstrong\u003enhựa PP\u003c/strong\u003e cao cấp với lớp ngoài cách nhiệt, tránh trường hợp gây bỏng trong quá trình sử dụng, dễ vệ sinh. Lớp trong lòng bình được làm từ\u003cstrong\u003e INOX 304\u003c/strong\u003e chống bám cặn, an toàn cho sức khỏe.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://file.hstatic.net/200000700229/file/untitled-4-07_eac93e7659dd47b98cbdc2b3fe3398a8.png\" alt=\"untitled-4-07_eac93e7659dd47b98cbdc2b3fe3398a8.png\" /\u003e\u003c/p\u003e\n\u003cp\u003eẤm đun siêu tốc điều khiển bằng nút chạm cảm ứng, đèn led hiển thị nhiệt độ trên thân ấm để bạn dễ dàng quan sát nhiệt độ nước trong ấm. Ấm đun nhỏ gọn, dễ dàng di chuyển cũng như sử dụng ở mọi gian bếp, không tốn hao diện tích.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://file.hstatic.net/200000700229/file/untitled-4-04_5b03588dde6a4a5a842f5cfb49c6e611.png\" alt=\"untitled-4-04_5b03588dde6a4a5a842f5cfb49c6e611.png\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e2. Công suất mạnh mẽ lên đến 2200 W đun sôi nước chỉ trong 5 – 7 phút.\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eStrix \u003c/strong\u003e- Bộ điều khiển cao cấp đến từ Anh Quốc giúp kiểm soát nhiệt độ chính xác, làm tăng độ bền cho ấm đun lên đến \u003cstrong\u003e10,000 lần đun\u003c/strong\u003e.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://file.hstatic.net/200000700229/file/untitled-4-03_ccfab5fe49b1428fb5a6f2debe5a7f9c.png\" alt=\"untitled-4-03_ccfab5fe49b1428fb5a6f2debe5a7f9c.png\" /\u003e\u003c/p\u003e\n\u003cp\u003eẤm đun nước siêu tốc công suất \u003cstrong\u003e2200W \u003c/strong\u003eđun nước nhanh sôi, sau \u003cstrong\u003e2 - 5 phút\u003c/strong\u003e có nước nóng sẵn sàng sử dụng.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://file.hstatic.net/200000700229/file/untitled-4-05_8c5c4512b128450dbb293eeb2c6b07f0.png\" alt=\"untitled-4-05_8c5c4512b128450dbb293eeb2c6b07f0.png\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e3. Đa dụng với 5 cài đặt nhiệt độ và giữ ấm trong 2 giờ\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eCác mức nhiệt độ đun nước tương ứng, phù hợp với nhu cầu như 40 độ pha sữa, 50 độ pha chế đa dạng thức uống, 80 độ pha trà, 90 độ pha cà phê, 100 độ pha chế và chế biến thực phẩm.\u003c/p\u003e\n\u003cp\u003eSau khi đun sôi nước, bạn có thể bật chế độ giữ ấm nước ở nhiệt độ như 40, 55, 80 hoặc 90 độ C, tùy thuộc vào nhu cầu.\u003c/p\u003e\n\u003cp\u003eĐặc biệt, Ấm đun siêu tốc KTB-3466 có thể giữ ấm trong 2 giờ, giúp tiết kiệm điện năng cũng như thời gian đun sôi lại nước. Bạn có thể pha thức uống ngay mà không cần mất thời gian chờ đợi nước sôi.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://file.hstatic.net/200000700229/file/untitled-4-02_aa79915dbff94bd6b733af1cd0ac7999.png\" alt=\"untitled-4-02_aa79915dbff94bd6b733af1cd0ac7999.png\" /\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003e4. Chức năng an toàn\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eẤm siêu tốc BlueStone sẽ tự động tắt khi nước sôi, khi nước trong ấm bị cạn hoặc khi quá nhiệt vô cùng an toàn cho người tiêu dùng.\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003e5. Thông số kỹ thuật\u003c/strong\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eCông suất: 1850 – 2200 W\u003c/li\u003e\n\u003cli\u003eVỏ ấm: Nhựa PP\u003c/li\u003e\n\u003cli\u003eRuột ấm: Inox 304\u003c/li\u003e\n\u003cli\u003eBộ điều khiển: Strix\u003c/li\u003e\n\u003cli\u003eTiện ích: 5 mức cài đặt nhiệt độ và 4 mức giữ ấm\u003c/li\u003e\n\u003cli\u003eNhiệt độ đun: 40, 55, 80, 90, 100 độ C\u003c/li\u003e\n\u003cli\u003eMức giữ ấm: 40, 55, 80, 90 độ C\u003c/li\u003e\n\u003c/ul\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv\u003e\n\u003cp\u003e\u003cimg src=\"https://file.hstatic.net/200000700229/file/untitled-4-08_b3478bc428d94b0cac9c682625dd3517.png\" alt=\"untitled-4-08_b3478bc428d94b0cac9c682625dd3517.png\" /\u003e\u003c/p\u003e\n\u003c/div\u003e\n\u003ch3\u003e\u003cstrong\u003e6. Chế độ bảo hành\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eẤm đun siêu tốc KTB-3466 bảo hành chính hãng đến 24 tháng tại các Trạm bảo hành ủy quyền của BlueStone trên toàn quốc.\u003c/p\u003e\n\u003cp\u003eNếu có bất kì vấn đề nào cần giải đáp, vui lòng liên hệ hotline \u003cstrong\u003e\u003ca href=\"tel:1800545494\"\u003e1800545494\u003c/a\u003e\u003c/strong\u003e hoặc Email \u003cstrong\u003e\u003ca href=\"mailto:1800545494@tara.com.vn\"\u003e1800545494@tara.com.vn\u003c/a\u003e\u003c/strong\u003e ngay bạn nhé!\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://file.hstatic.net/200000700229/file/untitled-4-09_78f68069313342098c367e7d0777f741.png\" alt=\"untitled-4-09_78f68069313342098c367e7d0777f741.png\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003e\u003cbr /\u003e\u003c/p\u003e\n\u003c/article\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/be/58/7e/fada7c57821c41c62da55285a6e2fab6.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/be/58/7e/fada7c57821c41c62da55285a6e2fab6.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/be/58/7e/fada7c57821c41c62da55285a6e2fab6.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/be/58/7e/fada7c57821c41c62da55285a6e2fab6.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/be/58/7e/fada7c57821c41c62da55285a6e2fab6.png"},{"base_url":"https://salt.tikicdn.com/ts/product/5d/aa/39/187cabfac5b925dfc09943578d43ca10.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/5d/aa/39/187cabfac5b925dfc09943578d43ca10.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/5d/aa/39/187cabfac5b925dfc09943578d43ca10.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5d/aa/39/187cabfac5b925dfc09943578d43ca10.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5d/aa/39/187cabfac5b925dfc09943578d43ca10.png"},{"base_url":"https://salt.tikicdn.com/ts/product/7f/b3/fd/7db8a858dde7d0293905ce0d5b0c8991.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/7f/b3/fd/7db8a858dde7d0293905ce0d5b0c8991.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/7f/b3/fd/7db8a858dde7d0293905ce0d5b0c8991.png","position":null,"small_url":"https://salt.t