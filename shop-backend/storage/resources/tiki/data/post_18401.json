t_rate":20,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/b3/43/d3/0ca525fcb201a1284b8a6fafae126b58.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":81,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cdiv class=\"description-productdetail\"\u003e\n\u003cp style=\"text-align:justify;\"\u003eTác giả: Takashi Ishii, Katsumi Nishimura\u003cbr /\u003eNgôn Ngữ: Tiếng Việt\u003cbr /\u003eNăm xuất bản: 2018\u003cbr /\u003eSố trang: 1960\u003cbr /\u003eNhà phát hành: An Phước Books\u003cbr /\u003eNhà xuất bản: Dân Trí\u003cbr /\u003eKích Thước: 20.5 x 14.5 cm\u003cbr /\u003eHình thức: Bìa Mềm\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003eCombo Siêu Trí Tuệ không chỉ giúp bạn rèn luyện để có một tư duy nhanh nhạy, suy nghĩ thấu đáo và giải quyết được mọi vấn đề chỉ trong 1 PHÚT. Mà những kỹ năng mà combo sách còn này mang lại cho bạn các phương pháp tinh gọn như người Nhật như:\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003eBạn có thể học được thêm rất nhiều bài học bổ ích để sau này ra đời không còn bỡ ngỡ nữa\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cbr /\u003eĐưa ra quyết định nhanh chóng và sáng suốt, giải quyết mọi vấn đề chỉ trong một phút\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cbr /\u003eGhi nhớ và ghi chép cực nhanh, có khoa học\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cbr /\u003eLưu giữ được những ý tưởng nảy ra bất chợt, giúp bạn trở thành một người có khả năng sáng tạo vô bờ bến\u003cbr /\u003eBiết cách lập kế hoạch, đưa ra chiến lược phát triển thông minh nhất trong kinh doanh\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cbr /\u003eNhìn vấn đề ở một cách tổng thể, lường trước được những gì mình sẽ gặp phải, ví dụ trực quan từ những doanh nghiệp nổi tiếng\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cbr /\u003eTrở thành một người giỏi nói chuyện, mỗi câu nói đều lôi cuốn và thuyết phục, dễ dàng chiếm được lòng tin của người nghe\u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv class=\"description-btn\" style=\"text-align:justify;\"\u003e \u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/b3/43/d3/0ca525fcb201a1284b8a6fafae126b58.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b3/43/d3/0ca525fcb201a1284b8a6fafae126b58.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b3/43/d3/0ca525fcb201a1284b8a6fafae126b58.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b3/43/d3/0ca525fcb201a1284b8a6fafae126b58.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b3/43/d3/0ca525fcb201a1284b8a6fafae126b58.png"},{"base_url":"https://salt.tikicdn.com/ts/product/d5/c4/f5/2f1ea50b53a59d0cec8bd97ddf2c4993.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d5/c4/f5/2f1ea50b53a59d0cec8bd97ddf2c4993.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d5/c4/f5/2f1ea50b53a59d0cec8bd97ddf2c4993.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d5/c4/f5/2f1ea50b53a59d0cec8bd97ddf2c4993.jpg","thumbnail_url":"https://salt.tikicdn