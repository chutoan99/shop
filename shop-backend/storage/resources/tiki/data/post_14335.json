_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/50/0c/17/26d1eb7362763bef94fd537c79bdb6f3.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1779,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eSẢN PHẨM ĐƯỢC NHẬP KHẨU CHÍNH HÃNG VÀ PHÂN PHỐI BỞI CÔNG TY CỔ PHẦN TẦM NHÌN\u003c/strong\u003e   \u003c/p\u003e\n\u003cp\u003eVòi tưới quay Gardena 01837-20 được sản xuất bằng chất lượng nhựa cao cấp chịu được va chạm mạnh, phù hợp để tưới cây cảnh, ruộng hoa màu.\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/2b/6c/5c/9764c2f1d8dfbb5bb3d66f64e9ec87b6.jpg\" alt=\"\" width=\"500\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003eTùy thuộc vào diện tích phun tưới, bạn có thể điều chỉnh được dạng phun tưới theo yêu cầu. Vòi tưới quay có thể tưới xoay 360 độ, trong khoảng diện tích đến 70m2.\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/c1/ea/c4/628d05c73a23f294f9db240ec86707eb.jpg\" alt=\"\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp\u003eCHỈ NHỮNG PHẦN MÀU CAM TRÊN SẢN PHẨM LÀ CÓ THỂ ĐIỀU CHỈNH DI CHUYỂN ĐƯỢC (XOAY/ẤN/VẶN/KÉO).\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTHÔNG TIN THƯƠNG HIỆU \u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eGARDENA là Thương hiệu dẫn đầu thế giới với hơn 60 năm kinh nghiệm trong lĩnh vực sản xuất dụng cụ và thiết bị chăm sóc sân vườn tại Châu Âu, được thành lập năm 1961 tại Đức bởi Werner Kress và Eberhard Kastner. Sản phẩm Gardena đã có mặt tại hơn 80 quốc gia thông qua các Nhà Nhập khẩu và Phân phối. Kể từ năm 2006, Gardena thuộc quyền sở hữu của Tập đoàn Husqvarna AB Thụy Điển. Gardena đã trở thành Thương hiệu ưa thích của hàng triệu chủ sở hữu nhà và vườn trên toàn thế giới bởi các sản phẩm đa dạng cùng chất lượng tuyệt vời.\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/50/0c/17/26d1eb7362763bef94fd537c79bdb6f3.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/50/0c/17/26d1eb7362763bef94fd537c79bdb6f3.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/50/0c/17/26d1eb7362763bef94fd537c79bdb6f3.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/50/0c/17/26d1eb7362763bef94fd537c79bdb6f3.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/50/0c/17/26d1eb7362763bef94fd537c79bdb6f3.jpg"},{"base_url":"https://salt.tikicdn.com/media/catalog/producttmp/c1/ea/c4/2ecb94bcfeed13b3128eb925f7ddf5b3.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/producttmp/c1/ea/c4/2ecb94bcfeed13b3128eb925f7ddf5b3.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/producttmp/c1/ea/c4/2ecb94bcfeed13b3128eb925f7ddf5b3.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/producttmp/c1/ea/c4/2ecb94bcfeed13b3128eb925f7ddf5b3.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product