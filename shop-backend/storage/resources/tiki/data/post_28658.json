{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/8b/1a/da/ed4efb0ef9f9a464e6c2af7b3acc31a3.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":572,"all_time_quantity_sold":30,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch1 style=\"text-align:center;\"\u003eThuốc sổ giun Endogard 10\u003c/h1\u003e\n\u003ch2\u003e\u003cspan style=\"color:#ff99cc;\"\u003eĐặc điểm nổi bật\u003c/span\u003e\u003c/h2\u003e\n\u003cul\u003e\u003cli style=\"text-align:justify;\"\u003eTiêu diệt giun tròn, sán dây, sán lá… trên cơ thể vật nuôi hiệu quả.\u003c/li\u003e\n\u003cli style=\"text-align:justify;\"\u003eSản xuất từ các thành phần cao cấp, an toàn với sức khỏe vật nuôi.\u003c/li\u003e\n\u003cli style=\"text-align:justify;\"\u003eCó mùi thơm hấp dẫn nên việc cho thú cưng sử dụng trở nên dễ dàng hơn.\u003c/li\u003e\n\u003cli style=\"text-align:justify;\"\u003eMỗi hộp có 2 viên thuốc và xuất xứ từ Pháp.\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"\" alt=\"thu_c_s__giun_grande.jpg\" /\u003e\u003c/p\u003e\n\u003ch2 style=\"text-align:justify;\"\u003e\u003cspan style=\"color:#ff99cc;\"\u003eThông tin chi tiết\u003c/span\u003e\u003c/h2\u003e\n\u003cul\u003e\u003cli style=\"text-align:justify;\"\u003eThuốc sổ giun Endogard 10 là thuốc sổ giun sán dùng qua đường uống dành cho vật nuôi. Thuốc có khả năng tiêu diệt giun tròn, sán dây, sán lá… trên cơ thể vật nuôi hiệu quả.\u003c/li\u003e\n\u003cli style=\"text-align:justify;\"\u003eThuốc được sản xuất từ các thành phần cao cấp, an toàn với sức khỏe vật nuôi. Do đó, bạn có thể sử dụng thuốc cho tất cả các giống chó, mèo ở mọi lứa tuổi kể cả đang mang thai, mà không cần phải lo lắng về việc thú cưng bị rối loạn tiêu hóa hay các tác dụng phụ khác.\u003c/li\u003e\n\u003c/ul\u003e\u003cp style=\"text-align:justify;\"\u003e\u003cem\u003e\u003cstrong\u003eSản phẩm có mùi thơm hấp dẫn nên việc cho thú cưng sử dụng trở nên dễ dàng hơn. Bạn có thể cho vật nuôi uống thuốc riêng hoặc trộn cùng thức ăn.\u003c/strong\u003e\u003c/em\u003e\u003c/p\u003e\n\u003ch2 style=\"text-align:justify;\"\u003e\u003cspan style=\"color:#ff99cc;\"\u003eHướng dẫn sử dụng\u003c/span\u003e\u003c/h2\u003e\n\u003cul\u003e\u003cli style=\"text-align:justify;\"\u003e1 viên Endogard 10 dùng cho 10kg cân nặng.\u003c/li\u003e\n\u003cli style=\"text-align:justify;\"\u003eBạn có thể chia nhỏ viên thuốc để điều chỉnh liều dùng phù hợp với cân nặng của vật nuôi.\u003c/li\u003e\n\u003cli style=\"text-align:justify;\"\u003eCó thể dùng định kỳ hàng tháng.\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eLưu ý:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eEndogard 10 chỉ được sử dụng cho chó, không dùng cho các loài động vật khác.\u003c/li\u003e\n\u003cli\u003eKhông sử dụng sản phẩm cho chó đang mang thai hoặc đang cho con bú.\u003c/li\u003e\n\u003cli\u003eTránh cho chó ăn quá nhiều thức ăn trước khi sử dụng sản phẩm.\u003c/li\u003e\n\u003cli\u003eNếu có bất kỳ dấu hiệu phản ứng phụ nào sau khi sử dụng sản phẩm, hãy liên hệ với bác sĩ thú y ngay lập tức.\u003c/li\u003e\n\u003cli\u003eKhông dùng chung với các hợp chất piperazine.\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/b3/4c/21/c71b648da773a9b55ae4b33680df9e70.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e\u003cp\u003eSản phẩm này là tài sản cá nhân được bán bởi Nhà Bán Hàng Cá Nhân và không thuộc đối tượng phải chịu thuế GTGT. Do đó hoá đơn VAT không được cung cấp trong trường hợp này.\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/8b/1a/da/ed4efb0ef9f9a464e6c2af7b3acc31a3.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/8b/1a/da/ed4efb0ef9f9a464e6c2af7b3acc31a3.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/8b/1a/da/ed4efb0ef9f9a464e6c2af7b3acc31a3.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8b/1a/da/ed4efb0ef9f9a464e6c2af7b3acc31a3.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8b/1a/da/ed4efb0ef9f9a464e6c2af7b3acc31a3.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/b3/4c/21/6d3740d353600c466d8ec37de2a9ad6b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b3/4c/21/6d3740d353600c466d8ec37de2a9ad6b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b3/4c/21/6d3740d353600c466d8ec37de2a9ad6b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b3/4c/21/6d3740d353600c466d8ec37de2a9ad6b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b3/4c/21/6d3740d353600c466d8ec37de2a9ad6b.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/6c/c1/07/a84420f9847b4ec7dd0aaff98acd7131.jpg","is_gallery":true,"label":null,"large_url":"https://salt