/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":181500,"discount_rate":11,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/1d/98/fe/3b5a3dc50a4b9cabf5a4de82dce637ca.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":630,"all_time_quantity_sold":5,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eVali vải VLM200 là mẫu vali thời trang được cải tiến với chất liệu siêu bền, thiết kế sang trọng, mang phong cách trẻ trung. \u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eTHIẾT KẾ ĐƠN GIẢN\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eVali vải Mr Vui VLM200 được thiết kế đơn giản nhưng không kém phần chắc chắn, kết hợp với các gam màu đơn sắc phù hợp với các lứa tuổi tạo phong thái sang trọng, lịch lãm cho người sử dụng.\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003e\u003cbr /\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/c9/05/a5/f2f53dbff594709fe3bf3aef70745ae8.jpg?v\u0026#61;1671088714437\" width=\"750\" height=\"750\" /\u003e\u003cbr /\u003e \u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eCHẤT LIỆU ĐƯỢC CẢI TIẾN\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003e\u003cstrong\u003eChất liệu bền, nhẹ:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eBề mặt ngoài của vali được làm từ vải 1680 pu ép mút EVA ít bám bẩn, không bị biến dạng khi giặt  và độ bền cao. Bên trong vali được lót bằng vải poly-Oxford hạn chế chống  thấm nước tiện lợi, giúp người sử dụng không lo lắng khi đi mưa.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/31/9c/82/c6c6b5aa9ff960e84c7ad640d0b48a85.jpg?v\u0026#61;1671088697411\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCần kéo và dây kéo chống rỉ sét:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eCần kéo kim loại ngoại nhập chống rỉ sét, người sử dụng có thể tùy chỉnh theo từng vóc dáng và tùy mọi địa hình khác nhau.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/75/a5/dc/8f3c19149e1832477b8aaa920abb9d03.jpg?v\u0026#61;1671088738463\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eDây kéo của sản phẩm VLM200 được thiết kế bảng to, chắc chắn với 2 đầu khoá kéo bảo vệ hành lý an toàn trong suốt chuyến đi.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eKhóa số đảm bảo an toàn:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eVali vải VLM200 là dòng vali hiện đại được cải tiến khóa số TSA chuẩn An ninh Hoa Kỳ có độ bảo mật cao, dễ sử dụng bảo vệ an toàn cho vali trong mỗi chuyến đi.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/f8/18/f7/c212c850fe4208b1abd5d87c5f7aa2d0.jpg?v\u0026#61;1671088766085\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eBánh xe bạc thép, chịu lực tốt:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eBánh xe đơn bạc đạn thép bọc nhựa xoay 360 độ chịu lực tốt và hạn chế tiếng ồn khi sử dụng giúp người sử dụng di chuyển dễ dàng không vướng, không vấp.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eNgăn chứa rộng rãi \u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eNgăn chính được thiết kế rộng rãi và các ngăn phụ đi kèm giúp người sử dụng có thể phân chia quần áo và các vật dụng dễ dàng thao tác trong việc tìm kiếm đồ.\u003c/p\u003e\n\u003cp\u003eNgoài ra, bên trong vali có dây gàng thun chắc chắn có nhiệm vụ giữ quần áo, vật dụng cá nhân không bị xáo trộn trong quá trình di chuyển.\u003c/p\u003e\n\u003cp\u003eNgoài ngăn chính được thiết kế rộng rãi, vali còn được thiết kế  thêm 1 ngăn nới rộng để thích hợp với lượng hành lí khác nhau của người sử dụng. Bên trong vali có 2 dây ràng chắc chắn, giúp giữ hành lí ngay ngắn trong suốt quá trình vận chuyển của chuyến đi.\u003c/p\u003e\n\u003cp\u003eTay cầm thiết kế nối liền với vali ở 2 chiều : chiều ngang và chiều dọc, tạo cảm giác chắc chắn và giúp người sử dụng có thể mang vali theo cách khác nhau tùy mọi địa hình và tình huống.\u003cbr /\u003e\u003cbr /\u003e \u003c/p\u003e\n\u003cdiv id=\"eJOY__extension_root\" class=\"eJOY__extension_root_class\"\u003e \u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/1d/98/fe/3b5a3dc50a4b9cabf5a4de82dce637ca.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/1d/98/fe/3b5a3dc50a4b9cabf5a4de82dce637ca.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/1d/98/fe/3b5a3dc50a4b9cabf5a4de82dce637ca.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1d/98/fe/3b5a3dc50a4b9cabf5a4de82dce637ca.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1d/98/fe/3b5a3dc50a4b9cabf5a4de82dce637ca.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/c9/0