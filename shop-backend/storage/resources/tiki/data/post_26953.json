:null,"text":null}],"badges_v3":[{"placement":"pdp_badge","code":"text_badge","type":"text_badge","index":0,"icon":null,"icon_width":0,"icon_height":0,"text_color":"#FFF0F1","background_color":"#D93843","href":null,"text":"9.9"},{"placement":"pdp_badge","code":"is_hero","type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"freeship_xtra","type":"pdp_icon_badge","index":2,"icon":"https://salt.tikicdn.com/ts/upload/be/67/48/04a82ab8df178e1a13bde38316081865.png","icon_width":91,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":true,"return_reason":"any_reason"}},"discount":172000,"discount_rate":43,"rating_average":4,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/a2/0b/f5/f2355b8cb5336a88497fa10dc474f2e7.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":448,"all_time_quantity_sold":14,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eQUẠT ĐIỀU HOÀ ĐEO CỔ 360 ĐỘ KẾT HỢP CÔNG NGHỆ SÒ LẠNH SAU GÁY - MANG LẠI CẢM GIÁC MÁT LẠNH CHO NGÀY HÈ OI BỨC\u003c/p\u003e\n\u003cp\u003e- Thời tiết nóng nực làm cho chúng ta chỉ muốn ở trong phòng máy lạnh để trốn nóng. Nhưng nếu phải đi ra ngoài ở môi trường không có máy lạnh thì rất khó chịu vì nhiệt độ ngoài trời quá cao.\u003c/p\u003e\n\u003cp\u003e-Các loại quạt cổ không có tính năng sò lạnh thường không quải quyết được cơn nóng. Hầu hết đều có đánh giá chưa tốt.\u003c/p\u003e\n\u003cp\u003e- Quạt thông thường chỉ có thể thổi hơi nóng vào người gây khó chịu. Quạt hơi nước có làm giảm nhiệt độ , nhưng khó có thể mang ra ngoài. Quạt đeo cổ với công nghệ chip điện lạnh làm lạnh tức thời vùng da tiếp xúc kết hợp quạt là giải pháp\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lryj4yuytvwke9\" width=\"1920\" height=\"1920\" alt=\"vn-11134208-7r98o-lryj4yuytvwke9\" /\u003e\u003c/p\u003e\n\u003cp\u003e- Quạt đeo cổ Half Horse 2023 công nghệ đặc biệt với chip điện lạnh ( semiconductor refrigiration temperature). Được cấu tạo bởi chất bán dẫn đặc biệt có thể hạ nhiệt độ lên tới 20 độ C bằng cách cấp điện chạy qua. Bằng cách này khi tiếp xúc với cơ thể sẽ mang lại cảm giác mát lạnh lập tức và giải toả cơn nóng. Các quạt không có cục sò lạnh chỉ có thể thổi hơi nóng vào người hoàn toàn không mang lại cảm giác mát mẻ mà còn có thể gây mệt mỏi cơ thể vì lượng gió thổi vào liên tục.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lryj4yuyzi6cda\" width=\"2500\" height=\"2500\" alt=\"vn-11134208-7r98o-lryj4yuyzi6cda\" /\u003e\u003c/p\u003e\n\u003cp\u003e-Quạt đeo cổ thuận tiện , rảnh tay. không cần phải cầm trên tay để có tác dụng làm mát. Cực kì hữu ích khi hoạt động ngoài trời\u003c/p\u003e\n\u003cp\u003e- 2 quạt công suất lớn kết hợp với sò lạnh giúp giải toả cơn nóng tức thì. Không quá mát như ngồi trong phòng máy lạnh nhưng tốt hơn rất nhiều lần chỉ có quạt thổi hơi nóng vào người.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lryj4yuz0wqs9c\" width=\"1920\" height=\"1920\" alt=\"vn-11134208-7r98o-lryj4yuz0wqs9c\" /\u003e\u003c/p\u003e\n\u003cp\u003e- Phụ kiện không thể thiếu khi ra ngoài giữa thời tiết nóng nực. Có thể sử dụng ở nhiều mục đích khác nhau : shoping, đi dạo, tập thể dục, chạy bộ, chơi thể thao...\u003c/p\u003e\n\u003cp\u003e-Hơn cả 1 phụ kiện giúp giảm cơn nóng. Quạt đeo cổ Half Horse còn rất thời trang.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lryj4yuz2bb813\" width=\"2500\" height=\"2500\" alt=\"vn-11134208-7r98o-lryj4yuz2bb813\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eTính năng sản phẩm\u003c/p\u003e\n\u003cp\u003e-Kết hợp công nghệ làm lạnh mới nhất 2023 với tấm bán dẫn giảm nhiệt độ xuống còn 20 độ C trong 3 giây.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lryj4yuz6j0k7e\" width=\"1920\" height=\"1920\" alt=\"vn-11134208-7r98o-lryj4yuz6j0k7e\" /\u003e\u003c/p\u003e\n\u003cp\u003e-Chất liệu nhựa ABS cao cấp thoải mái khi đeo, trọng lượng chỉ 300 gram. Bạn gần như không cảm thấy mình đang đeo quạt chỉ sau vài phút sử dụng.\u003c/p\u003e\n\u003cp\u003e-Pin lithium ion dung lượng 4000 mAh , cho thời gian sử dụng lên tới 6 giờ liên tục. Đối với bản chỉ dùng quạt, pin có dung lượng 2000 mAh\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lryj4yuz7xl0d4\" width=\"1920\" height=\"1920\" alt=\"vn-11134208-7r98o-lryj4yuz7xl0d4\" /\u003e\u003c/p\u003e\n\u003cp\u003e-Động cơ 2 tua bin mạnh mẽ, tốc độ gió tối đa 7m/s\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e- Sạc type C thời thượng\u003c/p\u003e\n\u003cp\u003e- Cánh quạt được bảo vệ, tránh cuốn vào tóc\u003c/p\u003e\n\u003cp\u003e- Điều chỉnh được độ đóng mở của 2 thanh quạt, phù hợp với tất cả mọi người.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lryj90tba6xl22\" width=\"1920\" height=\"1920\" alt=\"vn-11134208-7r98o-lryj90tba6xl22\" /\u003e\u003c/p\u003e\n\u003cp\u003eHoạt động\u003c/p\u003e\n\u003cp\u003e- Chỉ dùng sò lạnh, chỉ dùng quạt, hoặc kết hợp cả 2.\u003c/p\u003e\n\u003cp\u003e- Quạt có 3 cấp độ gió với cấp số 3 7m/s\u003c/p\u003e\n\u003cp\u003eCấp 1 : 2.3m/s - tiếng ồn cực thấp chỉ 35 db, có thể dùng trong thư viện\u003c/p\u003e\n\u003cp\u003eCấp 2 :4.5m/s - Gió tự nhiên, thích hợp cho làm công việc nhà hàng ngày và văn phòng\u003c/p\u003e\n\u003cp\u003eCấp 3 :7.5m/s - mức gió cao nhất, mang lại trải nghiệm như gió mạnh ngoài trời.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lryj90tbbli1e7\" width=\"2500\" height=\"2500\" alt=\"vn-11134208-7r98o-lryj90tbbli1e7\" /\u003e\u003c/p\u003e\n\u003cp\u003e-Chip làm lạnh bán dẫn hiệu suất cao, với vật liệu dẫn nhiệt bằng hợp kim Nhôm Kẽm.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lryj90tbd02hde\" width=\"2500\" height=\"2500\" alt=\"vn-11134208-7r98o-lryj90tbd02hde\" /\u003e\u003c/p\u003e\n\u003cp\u003e-Hệ thống tản nhiệt quạt kép với độ dẫn nhiệt cao, kiểm soát nhiệt độ tốt và tốc độ linh hoạt.\u003c/p\u003e\n\u003cp\u003e-4 kênh hướng gió độc lập, mạnh mẽ.\u003c/p\u003e\n\u003cp\u003e- Làm lạnh gần như tức thì chỉ sau 1 giây, sau 3 giây có thể giảm nhiệt độ tới 15 độ C\u003c/p\u003e\n\u003cp\u003eHướng dẫn sử dụng\u003c/p\u003e\n\u003cp\u003e-Sạc no pin khi nhận máy\u003c/p\u003e\n\u003cp\u003e-Bật nút dưới hình hoa tuyết cho sò lạnh, nút nguồn cho quạt. Bật cả 2 khi muốn kết hợp vừa sò lạnh vừa quạt. Sử dụng 2 chế độ khi muốn hiệu quả cao nhất\u003c/p\u003e\n\u003cp\u003e- Sản phẩm có thể thay đổi độ ôm, phù hợp tất cả mọi người\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lryj90tbeemx0c\" width=\"2500\" height=\"2500\" alt=\"vn-11134208-7r98o-lryj90tbeemx0c\" /\u003e\u003c/p\u003e\n\u003cp\u003e-Điều chỉnh vị trí cho cục sò lạnh tiếp xúc với da để làm làm mát\u003c/p\u003e\n\u003cp\u003e- Sau khi tắt máy, quạt tản nhiệt của sò lạnh vẫn bật khoảng vài giây để làm nguội chip điện lạnh.\u003c/p\u003e\n\u003cp\u003e- Pin sẽ tự giảm dung lượng dù không sử dụng. Khi không sử dụng trong 1 thời gian dài, vẫn phải thường xuyên sạc mỗi tuần để tránh hư pin.\u003c/p\u003e\n\u003cp\u003e- Quạt có tính năng kháng mồ hôi nhe. Tuy nhiên không sử dụng dưới trời mưa.\u003c/p\u003e\n\u003cp\u003e- Hàng chính hãng nhập khẩu. Giá đã bao gồm hoá đơn.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/a2/0b/f5/f2355b8cb5336a88497fa10dc474f2e7.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a2/0b/f5/f2355b8cb5336a88497fa10dc474f2e7.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a2/0b/f5/f2355b8cb5336a88497fa10dc474f2e7.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a2/0b/f5/f2355b8cb5336a88497fa10dc474f2e7.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a2/0b/f5/f2355b8cb5336a88497fa10dc474f2e7.jpg"}],"warranty_policy":null,"brand":{"id":8195827,"name":"half horse","slug":"half-horse"},"current_seller":{"id":211062,"sku":"8317659422637","name":"Tăm nước Sài Gòn","link":"https://tiki.vn/cua-hang/tam-nuoc-sai-gon","logo":"https://vcdn.tikicdn.com/ts/seller/17/0a/17/e4e1d1960c098dcfa3e555437d069e41.jpg","price":228000,"product_id":"272184346","store_id":198094,"is_best_store":false,"is_offline_installment_supported":null},"other_sell