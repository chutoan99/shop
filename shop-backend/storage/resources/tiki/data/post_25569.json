//salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":true,"return_reason":"any_reason"}},"discount":20700,"discount_rate":30,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/e8/e7/c2/bdc987e0852e7ab009eb54386da8fd86.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2330,"all_time_quantity_sold":14,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp class=\"MsoNormal\"\u003e\u003cstrong\u003eTự Nảy Mầm, Tự Vươn Lên\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\"\u003eNếu bạn là một một phụ huynh có con trong độ tuổi đến trường và đang đau đầu với chuyện học hành của con, cũng như còn băn khoăn trong việc lựa chọn phương pháp nuôi dạy con phù hợp thì “Tự nảy mầm, tự vươn lên” chính là cuốn sách dành cho bạn.\u003c/p\u003e\n\u003cp class=\"MsoNormal\"\u003eĐây là cuốn sách viết về giáo dục gia đình của Ohame Kenichi, một người thành công cả trong sự nghiệp công việc lẫn trách nhiệm làm cha. Cuốn sách sẽ giúp bạn lý giải tốt hơn những băn khoăn mà bản thân đang đặt ra trước tình trạng giáo dục hiện tại và tiếp thêm cho bạn cảm hứng, niềm tin và sức mạnh trên hành trình làm cha mẹ.\u003c/p\u003e\n\u003cp class=\"MsoNormal\"\u003eTrong cuốn sách này, Ohmae đề cập đến cách dạy con của mình, ông luôn chú ý dạy con trở thành người có trách nhiệm, trong khi đây không phải chuyện dễ dàng trong thời đại ngày nay. Xung quanh chúng ta có rất nhiều phụ huynh quan tâm, bảo hộ con quá mức đã vô tình biến con thành người ích kỉ và mất đi năng lực sống. Những đứa trẻ được yêu thương quá mức, sẽ chỉ biết đến bản thân khi lớn lên rất dễ trở thành những người vô trách nhiệm.\u003c/p\u003e\n\u003cp class=\"MsoNormal\"\u003eBên cạnh việc dạy cho con có “năng lực sinh tồn” và những kĩ năng sống quan trọng và cần thiết khác, Ohmae Kenichi cũng truyền cảm hứng tới độc giả những nguyên tắc để giữ cho gia đình luôn hạnh phúc dù cho ông là người “bận rộn nhất thế giới”\u003c/p\u003e\n\u003cp\u003e“Tự nảy mầm, tự vươn lên” là một trong số rất nhiều cuốn sách của Ohmae Kenichi, người được bình chọn là một trong năm người có tầm ảnh hưởng toàn thế giới do Tạp chí Doanh nhân của Vương quốc Anh bình chọn năm 1994, đây chắc chắn sẽ là một món quà tuyệt vời cho cha mẹ.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/e8/e7/c2/bdc987e0852e7ab009eb54386da8fd86.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e8/e7/c2/bdc987e0852e7ab009eb54386da8fd86.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e8/e7/c2/bdc987e0852e7ab009eb54386da8fd86.jpg","