verage":5,"review_count":7,"review_text":"(7)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/28/d5/9f/1b75ed611a9b1616281c3ca4fdc6dfbf.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1538,"all_time_quantity_sold":21,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cdiv id=\"content-feature\" class=\"real-width infor-detail-pro\"\u003e\n\u003cdiv class=\"product_detail\"\u003e\n\u003cdiv class=\"tinh_nang\"\u003e\n\u003cdiv class=\"info_tinhnang\"\u003e\n\u003ch3 class=\"title_tn\"\u003e\u003cstrong\u003eMÁY NƯỚC NÓNG TRỰC TIẾP AMORE GSN 4.500W -HÀNG CHÍNH HÃNG \u003c/strong\u003e\u003c/h3\u003e\n\u003ch3 class=\"title_tn\"\u003eNÚM XOAY ĐIỀU CHỈNH NHIỆT ĐỘ\u003c/h3\u003e\n\u003cp\u003eNúm xoay nhỏ xinh vận hàng mượt mà giúp cài đặt nhiệt độ nước theo ý muốn. \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://ferroli.com.vn/wp-content/uploads/2018/09/num-xoay-dieu-chinh-toc-do.png\" width=\"302\" height=\"265\" /\u003e\u003c/p\u003e\n\u003ch3 class=\"title_tn\"\u003eCHẾ ĐỘ BẢO VỆ AN TOÀN ĐA CẤP\u003c/h3\u003e\n\u003cp\u003eCông nghệ làm nóng tách điện và nước riêng biệt, chế độ bảo vệ tiếp đất an toàn, chế độ bảo vệ rò rỉ độc lập, chế độ tự phát hiện lỗi, chế độ bảo vệ chống quá nhiệt, chống cháy khô, chế độ bảo vệ khi nước trong bình thấp, bộ lọc nâng cao chất lượng nước và kéo dài tuổi thọ cho thiết bị.\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"tinh_nang\"\u003e\u003cimg class=\"img_tinhnang\" style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://ferroli.com.vn/wp-content/uploads/2015/11/che-do-bao-ve-an-toan-da-cap.jpg\" alt=\"\" width=\"341\" height=\"240\" /\u003e\n\u003cdiv class=\"info_tinhnang\"\u003e\n\u003ch3 class=\"title_tn\"\u003eCÔNG TẮC KIỂM SOÁT DÒNG CHẢY\u003c/h3\u003e\n\u003cp\u003eKiểm soát dòng chảy của nước, đảm bảo lượng nước đều và liên tục trong quá trình sử dụng. Chỉ một thao tác mở-tắt công tắc, người sử dụng có thể dễ dàng điều chỉnh mở-tắt hoạt động của máy nóng lạnh trực tiếp (có dòng nước chảy qua, máy nóng lạnh trực tiếp mới hoạt động và ngược lại)\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"tinh_nang\"\u003e\u003cimg class=\"img_tinhnang\" style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://ferroli.com.vn/wp-content/uploads/2015/12/mmm.jpg\" alt=\"\" width=\"335\" height=\"235\" /\u003e\u003c/div\u003e\n\u003cdiv class=\"tinh_nang\"\u003e\n\u003ch3 class=\"title_tn\"\u003eTHANH ĐỐT BẰNG ĐỒNG NGUYÊN CHẤT HIỆU SUẤT CAO, TIẾT KIỆM ĐIỆN\u003c/h3\u003e\n\u003cp\u003eThanh đốt hiệu suất cao bằng đồng tinh khiết đảm bảo độ bền cao, làm nóng siêu tốc. Bình chứa bằng sợi thủy tinh, giữ nhiệt tốt, tiết kiệm điện năng.\u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv class=\"tinh_nang\"\u003e\u003cimg class=\"img_tinhnang\" style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://ferroli.com.vn/wp-content/uploads/2015/11/hieu-suat-cao-tiet-kiem-dien.png\" alt=\"\" width=\"311\" height=\"194\" /\u003e\n\u003cdiv class=\"info_tinhnang\"\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch3 class=\"title_tn\"\u003eTAY SEN ĐI KÈM 3 CHỨC NĂNG\u003c/h3\u003e\n\u003cp\u003eTay sen với 3 chức năng cho trải nghiệm tắm thư giãn và hoàn hảo hơn, tay sen mạ crom sang trọng, thiết kế hiện đại, dễ lau rửa, vệ sinh an toàn cho sức khỏe\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"tinh_nang\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://cdn.nguyenkimmall.com/images/thumbnails/600/336/detailed/672/10038292-may-nuoc-nong-ferroli-amore-gsp-4500w-3.jpg\" alt=\"Máy Nước Nóng Ferroli Amore GSP 4500W | Nguyễn Kim\" width=\"600\" height=\"336\" /\u003e\u003cbr /\u003e\n\u003cdiv class=\"info_tinhnang\"\u003e\n\u003ch3 class=\"title_tn\"\u003eTHIẾT KẾ MẶT KÍNH ĐEN SANG TRỌNG\u003c/h3\u003e\n\u003cp\u003eThiết kế sang trọng cùng mặt kính cường lực màu đen chống bám bụi, chống va đập.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://ferroli.com.vn/wp-content/uploads/2018/09/GSN.png\" width=\"285\" height=\"365\" /\u003e\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"tinh_nang\"\u003e\n\u003cdiv class=\"info_tinhnang\"\u003e\n\u003ch3 class=\"title_tn\"\u003eVAN ĐIỀU CHỈNH LƯU LƯỢNG THUẬN TIỆN, CHẤT LƯỢNG\u003c/h3\u003e\n\u003cp\u003eVan điều chỉnh lưu lượng đặc biệt, dễ dàng điều chỉnh lưu lượng nước như ý muốn, có độ bền cao.\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"tinh_nang\"\u003e\u003cimg class=\"img_tinhnang\" style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://ferroli.com.vn/wp-content/uploads/2015/11/van-dieu-chinh-am-luong.jpg\" alt=\"\" width=\"272\" height=\"350\" /\u003e\u003c/div\u003e\n\u003cdiv class=\"tinh_nang\"\u003e \u003c/div\u003e\n\u003cdiv class=\"tinh_nang\"\u003e\n\u003cp\u003e\u003cstrong\u003eShop hỗ trợ lắp miễn phí cho quý khách hàng khu vực Thành Phố Hồ Chí Minh:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eShop \u003cstrong\u003eMIỄN PHÍ\u003c/strong\u003e lắp đặt cho khách hàng trong phạm vi Thành Phố Hồ Chí Minh (Huyện Cần giờ và Huyện Củ Chi lắp đặt theo thỏa thuận chi phí đi lại của kỹ tuật và khách) khách hàng có nhu cầu sau khi nhận hàng vui lòng liên hệ Tiki để tiki báo shop hoặc sử dụng ứng dụng chát trực tiếp với shop để lên lịch lắp đặt với kỹ thuật.\u003c/p\u003e\n\u003cp\u003eĐể đảm bảo kỹ thuật tới lắp được quý khách phải hoàn thiện đường nước có đầu chờ nước phi 21 răng ngoài, điện, nước đã hoàn thiện và vật tư 