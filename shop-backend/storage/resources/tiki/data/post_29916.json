iá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/a0/ac/e9/7c7f2f3aca9dda39cb0bc8c95fb44e6d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a0/ac/e9/7c7f2f3aca9dda39cb0bc8c95fb44e6d.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a0/ac/e9/7c7f2f3aca9dda39cb0bc8c95fb44e6d.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a0/ac/e9/7c7f2f3aca9dda39cb0bc8c95fb44e6d.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a0/ac/e9/7c7f2f3aca9dda39cb0bc8c95fb44e6d.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/bf/df/aa/943007cd37299121cc228a77ee5b956c.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/bf/df/aa/943007cd37299121cc228a77ee5b956c.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/bf/df/aa/943007cd37299121cc228a77ee5b956c.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/bf/df/aa/943007cd37299121cc228a77ee5b956c.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/bf/df/aa/943007cd37299121cc228a77ee5b956c.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/6d/09/55/8a342bf6dccb97175edc9bc9d8a33ee3.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/6d/09/55/8a342bf6dccb97175edc9bc9d8a33ee3.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/6d/09/55/8a342bf6dccb97175edc9bc9d8a33ee3.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6d/09/55/8a342bf6dccb97175edc9bc9d8a33ee3.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6d/09/55/8a342bf6dccb97175edc9bc9d8a33ee3.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/c8/89/29/c1881d051768dedca9b1a614ec255d35.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c8/8