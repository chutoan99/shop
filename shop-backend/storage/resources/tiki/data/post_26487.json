olor":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/b9/6e/29/a409197e0a018e94c9b16b847a679ad9.png","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":29,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eTiện lợi, nhanh chóng và dễ dàng khi sử dụng, với viên giặt, bạn không cần phải đong đếm lượng bột giặt, nước giặt như trước vẫn đảm bảo quần áo sạch sẽ, thơm tho\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/8e/41/20/023bb2d4ee424ad44e85508706292e0a.jpg\" alt=\"\" width=\"671\" height=\"671\" /\u003e\u003cbr /\u003eViên giặt 3D thiết kế thông minh, công thức ít bọt, không làm trào bọt, làm hư hỏng các vi mạch điện, gia tăng tuổi thọ cho máy giặt.\u003cbr /\u003eViên giặt này có thể sử dụng cho tất cả các loại máy giặt với độ an toàn tuyệt đối cho người sử dụng.\u003cbr /\u003eSử dụng được cho quần áo của trẻ em, quần áo màu, khăn,\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/51/61/48/64b06aef49412f28c3a1eebe02eb37e3.png\" alt=\"\" width=\"609\" height=\"505\" /\u003e\u003cbr /\u003eĐặc tính kháng khuẩn khử mùi cực tốt, thích hợp sử dụng cho những nơi ít nắng, mưa nhiều, không lo quần áo bị ẩm mốc, hôi mùi khó chịu.\u003cbr /\u003eCó các loại viên giặt xả phù hợp với nhu cầu sử dụng của bạn. Thiết kế hộp nhựa đựng an toàn, đảm bảo cho bảo quản tốt.\u003cbr /\u003eƯớc tính 2 viên cho 1 lần giặt để giặt được 30 chiếc quần áo bẩn (~ 6kg quần áo khô).\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/51/9c/78/6b515cc3e089dea990f969aa1c973c81.png\" alt=\"\" width=\"647\" height=\"543\" /\u003e\u003c/p\u003e\n\u003cp\u003eSẢN PHẨM BÁN THEO BỊCH /30v\u003c/p\u003e\n\u003cp\u003e HƯỚNG DẪN SỬ DỤNG\u003cbr /\u003e Sử dụng như nước giặt thông thường.\u003cbr /\u003e Thả 2 viên thẳng vào lồng máy giặt (nilon này tự tiêu hủy).\u003cbr /\u003e Mỗi 1 viên đã bao gồm nước giặt và nước xả vải (2 trong 1), sẽ giúp cho việc giặt giũ trở nên cực kỳ đơn giản tiết kiệm thời gian cho các mẹ mà lại hiệu quả\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/cd/e8/23/ce2f21678563c59634dfee36c824c690.jpg\" alt=\"\" width=\"640\" height=\"640\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e\u003cp\u003eSản phẩm này là tài sản cá nhân được bán bởi Nhà Bán Hàng Cá Nhân và không thuộc đối tượng phải chịu thuế GTGT. Do đó hoá đơn VAT không được cung cấp trong trường hợp này.\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/b9/6e/29/a409197e0a018e94c9b16b847a679ad9.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b9/6e/29/a409197e0a018e94c9b16b847a679ad9.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b9/6e/29/a409197e0a018e94c9b16b847a679ad9.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b9/6e/29/a409197e0a018e94c9b16b847a679ad9.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b9/6e/29/a409197e0a018e94c9b16b847a679ad9.png"},{"base_url":"https://salt.tikicdn.com/ts/product/c5/a5/29/ed88f43d8a3483b7cfaf6a339111367a.jpg","is_