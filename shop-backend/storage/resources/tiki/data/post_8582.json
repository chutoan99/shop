y_reason"}},"discount":15000,"discount_rate":22,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/d6/ce/fc/2e2a1926d1ab0f4a61eb7d7c5c6ed70e.png","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":579,"all_time_quantity_sold":215,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2 class=\"irIKAp\"\u003e\u003cstrong\u003eGel bôi trơn quan hệ cao cấp Feelex Personal Lubricant dung tích 50ml \u003c/strong\u003e\u003c/h2\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cstrong\u003eTHÔNG TIN SẢN PHẨM\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e✪ Tên sản phẩm: Gel bôi trơn Feelex Personal Lubricant \u003cbr /\u003e\u003cbr /\u003e✪ Thương hiệu: Feelex \u003cbr /\u003e\u003cbr /\u003e✪ Xuất xứ: Việt Nam\u003cbr /\u003e\u003cbr /\u003e✪ Quy cách: Tuýp 50ml \u003cbr /\u003e\u003cbr /\u003e✪ Chủng loại: Lạnh (Cooling), Ấm (Warming), Hương cam (Orange) \u003cbr /\u003e\u003cbr /\u003e✪Thành phần: 100% từ thảo dược tự nhiên \u003cbr /\u003e\u003cbr /\u003e✪ NSX: In trên bao bì sản phẩm \u003cbr /\u003e\u003cbr /\u003e✪ HSD: 5 năm kể từ ngày sản xuất\u003cbr /\u003e\u003cbr /\u003e\u003c/p\u003e\n\u003cp\u003e      Feelex là một thương hiệu về các sản phẩm hỗ trợ các cuộc yêu thuộc sở hữu của Công ty TNHH Thương mại và Dịch vụ OZOVN. Tất cả sản phẩm được gia công tại những nhà máy hàng đầu về trình độ gia công, đạt chuẩn ISO, bên cạnh đó chất lượng luôn luôn là yếu tố được đặt lên hàng đầu do vậy những sản phẩm ra mắt đang ngày càng lấy được thiện cảm của người tiêu dùng. Cùng với đó là sự đa dạng về chủng loại cũng như mức độ hoàn thiện, lắng nghe ý kiến khách hàng, những sản phẩm của Feelex ra mắt luôn được người tiêu dùng đón nhận và yêu mến. Công ty chúng tôi luôn không ngừng cập nhật, cố gắng mang những sản phẩm chất lượng nhất đến tay quý khách hàng\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/1c/2e/6a/97630c1bdc0a8ed148a58e6b0365a003.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e      Gel bôi trơn Feelex Personal Lubircant là một sản phẩm nằm trong hệ sinh thái các sản phẩm 18\u0026#43; của thương hiệu Feelex. Sản phẩm được gia công tại một trong những nhà máy hàng đầu thế giới trong lĩnh vực sản xuất các sản phẩm bao cao su, gel bôi trơn, hơn nữa được đặt sản xuất theo đơn hàng độc quyền của Công ty TNHH Thương mại và dịch vụ OZOVN nên sản phẩm đã được tối ưu hoá để phù hợp với cơ địa người Việt Nam gần như tuyệt đối.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eĐẶC ĐIỂM NỔI BẬT\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Gel bôi trơn dịu nhẹ, thuần gốc nước cho khoái cảm dâng trào; giảm bớt sự khó chịu do “cô bé” bị khô.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Dễ dàng rửa sạch khi đã hoàn toàn dứt điểm, không nhờn dính\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Đơn giản nhưng vô cùng mạnh mẽ, cho cuộc yêu mượt mà như là mơ.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Gel bôi trơn thuần gốc nước được thiết kế để lứa đôi trải nghiệm yêu mượt mà hơn bao hết. Sử dụng vài giọt để tăng độ trơn mượt khi quan hệ và làm giảm sự khó chịu do “cô bé” khô.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Dịu nhẹ cho toàn thân, bạn có thể an tâm sử dụng với bất kỳ kiểu mây mưa nào: bằng miệng, cửa trước, cửa hậu, cũng như khi sử dụng cùng bao cao su.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- An toàn khi sử dụng cùng bao cao su.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Gel có nhiều chủng loại mùi hương khác nhau : Lạnh (Cooling), Ấm (Warming), Hương cam (Orange)\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/d4/80/39/798a5802749f56148a5971f1d016a8d4.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eHƯỚNG DẪN SỬ DỤNG\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Mở nắp chai gel, lấy một lượng vừa đủ\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Nhẹ nhàng thoa gel và massage, bên trong, bên ngoài cô bé, cậu nhỏ, đặc biệt là khu vực tiếp xúc khi quan hệ\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Đóng nắp sau khi sử dụng\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/0b/07/73/3647aa137a0372c3113e9d548d7026a8.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eBẢO QUẢN\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Bảo quản nơi khô ráo, thoáng mát, tránh ánh nắng trực tiếp chiếu vào\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Gel bôi trơn sau khi sử dụng nên sử dụng hết trong vòng 6 tháng.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eCHÍNH SÁCH HẬU MÃI\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Quý khách hàng sau khi nhận hàng có bất cứ vấn đề gì vui lòng liên hệ shop, chúng tôi sẽ hỗ trợ ở mức tối đa.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Sản phẩm kể cả khi sử dụng vẫn có thể hỗ trợ đổi trả\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/8e/17/6d/fa2cc12f2c0fba9bf4b6b01f89f9b94c.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e#gel #gelboitron #boitron #lubricant #feelex #baocaosu #bcs#bao #cao #su #baocaosu #BCS #sieumong #0.01 #gocnuoc #keodai #benbi #antoan #chatluong #nam #nu #quanhe #tinhduc #baove #chinhhang #omsat #nhaycam #tunhien #gel #dau #boi #tron #olo#daurong #cockring #rung #gangai #baocaosugai#gelboitron #nu\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cdiv class=\"irIKAp\"\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/d6/ce/fc/2e2a1926d1ab0f4a61eb7d7c5c6ed70e.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d6/ce/fc/2e2a1926d1ab0f4a61eb7d7c5c6ed70e.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d6/ce/fc/2e2a1926d1ab0f4a61eb7d7c5c6ed70e.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d6/ce/fc/2e2a1926d1ab0f4a61eb7d7c5c6ed70e.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d6/ce/fc/2e2a1926d1ab0f4a61eb7d7c5c6ed70e.png"},{"base_url":"https://salt.tikicdn.com/ts/product/d4/80/39/50145b4fe031ae3cc0d7e5c9e8c78f7e.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d4/80/39/50145b4fe031ae3cc0d7e5c9e8c78f7e.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d4/80/39/50145b4fe031ae3cc0d7e5c9e8c78f7e.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d4/80/39/50145b4fe031ae3cc0d7e5c9e8c78f7e.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d4/80/39/50145b4fe031ae3cc0d7e5c9e8c78f7e.png"},{"base_url":"https://salt.tikicdn.com/ts/product/9c/e8/be/121fa19764410c674eef349f340cff85.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/9c/e8/be/121fa19764410c674eef349f340cff85.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/9c/e8/be/121fa19764410c674eef349f340cff85.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9c/e8/be/121fa19764410c674eef349f34