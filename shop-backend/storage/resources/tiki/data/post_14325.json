":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/f8/5b/04/358d3637ec7ecdeb464af343ab47185f.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":831,"all_time_quantity_sold":3,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2\u003e\u003cstrong\u003eSẢN PHẨM ĐƯỢC NHẬP KHẨU CHÍNH HÃNG VÀ PHÂN PHỐI BỞI CÔNG TY CỔ PHẦN TẦM NHÌN\u003c/strong\u003e   \u003c/h2\u003e\n\u003cp\u003e\u003cstrong\u003eBỘ DÂY TƯỚI XOẮN ỐC GARDEN CITY PHÙ HỢP CHO BAN CÔNG, SÂN THƯỢNG\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eBộ dây tưới xoắn ốc Garden City 18411-20 chiều dài 7,5 mét, phù hợp cho các khu vực có diện tích nhỏ, ban công hoặc sân thượng.\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eBộ dây gồm: \u003c/p\u003e\n\u003cp\u003e- 7.5m dây, đường kính 9mm:\u003c/p\u003e\n\u003cp\u003e- 1 cút nối vòi phun (màu đen cam)\u003c/p\u003e\n\u003cp\u003e- 1 cút nối dây (màu xám cam)\u003c/p\u003e\n\u003cp\u003e- 1 cút nối vòi gạt, ren 27mm (3/4'') và 33mm (1'') (màu xám - kết nối trực tiếp với vòi gạt nước)\u003c/p\u003e\n\u003cp\u003e- 1 vòi phun loe (1 chế độ phun loe)\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/82/64/f9/c7284314237e3b4c9dae4bb98052602f.jpg\" alt=\"\" width=\"750\" height=\"422\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eBộ dây tưới xoắn ốc được trang bị đầy đủ phụ kiện để kết nối và sử dụng, có khả năng trở về hình dạng ban đầu sau khi sử dụng xong\u003c/p\u003e\n\u003cp\u003eVòi tưới phun mưa nhẹ nhàng giúp cho việc tưới cây trên ban công chung cư hay sân thượng được hiệu quả. tránh làm ảnh hưởng đến phía dưới nếu nước có bị văng ra ngoài. \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/76/e0/df/2b032d68fad73350ca589f76fd4262d7.jpg\" alt=\"\" width=\"750\" height=\"422\" /\u003e\u003c/p\u003e\n\u003cp\u003eCũng như các sản phẩm vòi tưới cao cấp khác của Gardena, bạn có thể dễ dàng thay đầu vòi tưới khác nếu bạn cần phun tưới mạnh hoặc tưới nhiều kiểu khác nhau.\u003c/p\u003e\n\u003cp\u003eBộ dây tưới xoắn ốc Gardena city 18411-20 sản xuất tại Đức với chất lượng và độ tin cậy cao.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eLưu ý: Chiều cao của vòi nước so với mặt đất tối thiểu là 50cm để đảm bảo treo được bộ dây tưới. \u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eCHỈ NHỮNG PHẦN MÀU CAM TRÊN SẢN PHẨM LÀ CÓ THỂ ĐIỀU CHỈNH DI CHUYỂN ĐƯỢC (XOAY/ẤN/VẶN/KÉO).\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTHÔNG TIN THƯƠNG HIỆU \u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eGARDENA là Thương hiệu dẫn đầu thế giới với hơn 60 năm kinh nghiệm trong lĩnh vực sản xuất dụng cụ và thiết bị chăm sóc sân vườn tại Châu Âu, được thành lập năm 1961 tại Đức bởi Werner Kress và Eberhard Kastner. Sản phẩm Gardena đã có mặt tại hơn 80 quốc gia thông qua các Nhà Nhập khẩu và Phân phối. Kể từ năm 2006, Gardena thuộc quyền sở hữu của Tập đoàn Husqvarna AB Thụy Điển. Gardena đã trở thành Thương hiệu ưa thích của hàng triệu chủ sở hữu nhà và vườn trên toàn thế giới bởi các sản phẩm đa dạng cùng chất lượng tuyệt vời.\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"h