dth":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":600000,"discount_rate":36,"rating_average":4.7,"review_count":21,"review_text":"(21)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/16/33/73/e4cba571dbf0a49d2825c04b8ea6d900.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2582,"all_time_quantity_sold":77,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p class=\"_2jrvqA\">1.THÔNG SỐ KỸ THUẬT SẢN PHẨM:</p>\n<p class=\"_2jrvqA\"> </p>\n<div class=\"_2jrvqA\">\n<div>\n<div class=\"_3iW6K2\"><img class=\"_2qyaZL _3DKwBj\" src=\"https://cf.shopee.vn/file/438475a2825f5ce50ae657349cc56e15\" alt=\"438475a2825f5ce50ae657349cc56e15\" /></div>\n</div>\n</div>\n<p class=\"_2jrvqA\"> </p>\n<p class=\"_2jrvqA\">2.THÔNG TIN SẢN PHẨM</p>\n<p class=\"_2jrvqA\">Nồi áp suất CM6151 - Dung tích 6L là một thiết bị điện gia dụng giúp hỗ trợ người dùng chế biến thực phẩm nhanh chóng mà vẫn đảm bảo độ tươi ngon, rất thích hợp cho các món hầm/ninh bồi bổ sức khỏe mà lại nhanh chóng, tiện lợi. Đây thật sự là một trong những giải pháp thông minh giúp người dùng vừa có thể tiết kiệm thời gian nấu nướng mà vẫn giữ được chất dinh dưỡng của sản phẩm.</p>\n<p class=\"_2jrvqA\">Từ trước đến nay, những chiếc nồi áp suất luôn được ưa chuộng, nhờ có nhiều ưu điểm như lòng nồi kín giữ áp suất tối đa , đa dạng chế độ nấu,dung tích lớn… Tuy có nhiều tính năng ưu việt, nhưng việc chọn lựa và mua nồi phù hợp chưa bao giờ là dễ dàng. Cùng điểm qua các chức năng của Nồi áp suất 6L CM6151</p>\n<p class=\"_2jrvqA\"> </p>\n<div class=\"_2jrvqA\">\n<div>\n<div class=\"_3iW6K2\"><img class=\"_2qyaZL _3DKwBj\" src=\"https://cf.shopee.vn/file/41acf2b21400c5645244a900bea09290\" alt=\"41acf2b21400c5645244a900bea09290\" /></div>\n</div>\n</div>\n<p class=\"_2jrvqA\"> </p>\n<p class=\"_2jrvqA\">3.ĐẶC ĐIỂM SẢN PHẨM:</p>\n<p class=\"_2jrvqA\">- Gia nhiêt nhanh - Hơi nóng lưu thông đều trong lòng nồi kín</p>\n<p class=\"_2jrvqA\">- Núm điều khiển nhiệt độ đơn giản và dễ vận hành</p>\n<p class=\"_2jrvqA\">- Dung tích 6L, dễ dàng đáp ứng cho bữa tối của gia đình.</p>\n<p class=\"_2jrvqA\">- Dễ vệ sinh.</p>\n<p class=\"_2jrvqA\">- Nhiều chế độ nấu khác nhau</p>\n<p class=\"_2jrvqA\"> </p>\n<div class=\"_2jrvqA\">\n<div>\n<div class=\"_3iW6K2\"><img class=\"_2qyaZL _3DKwBj\" src=\"https://cf.shopee.vn/file/99da6c3614bd24b46990e924f11ea057\" alt=\"99da6c3614bd24b46990e924f11ea057\" /></div>\n</div>\n</div>\n<p class=\"_2jrvqA\"> </p>\n<p class=\"_2jrvqA\">4.CÔNG DỤNG VÀ CHỨC NĂNG CỦA SẢN PHẨM:</p>\n<p class=\"_2jrvqA\">- Núm điều khiển đơn giản, dễ nấu nướng.</p>\n<p class=\"_2jrvqA\">- Lòng nồi hợp kim tráng chống dính - có thể tháo rời và vệ sinh dễ dàng</p>\n<p class=\"_2jrvqA\">- Nhiều thực đơn, giúp bạn trở thành đầu bếp ngay lập tức.</p>\n<div class=\"_2jrvqA\">\n<div>\n<div class=\"_3iW6K2\"><img class=\"_2qyaZL _3DKwBj\" src=\"https://cf.shopee.vn/file/sg-11134202-22100-whdlbicrv9hv90\" alt=\"sg-11134202-22100-whdlbicrv9hv90\" /></div>\n</div>\n</div>\n<p class=\"_2jrvqA\"> </p>\n<p class=\"_2jrvqA\">5.CHI TIẾT &amp; CHẤT LIỆU SẢN PHẨM:</p>\n<p class=\"_2jrvqA\">- Vật liệu phần lòng nồi: Hợp kim phủ chống dính</p>\n<p class=\"_2jrvqA\">- Nắp &amp; vỏ thân : inox &amp; Nhựa ABS cao cấp</p>\n<div class=\"_2jrvqA\">\n<div>\n<div class=\"_3iW6K2\"><img class=\"_2qyaZL _3DKwBj\" src=\"https://cf.shopee.vn/file/f871cbd894e6dc0b62c5a1e6ff95ad75\" alt=\"f871cbd894e6dc0b62c5a1e6ff95ad75\" /></div>\n</div>\n</div>\n<p class=\"_2jrvqA\"> </p>\n<p class=\"_2jrvqA\">6.PHỤ KIỆN ĐI KÈM:</p>\n<p class=\"_2jrvqA\">- Hướng dẫn (bản sao): 1</p>\n<p class=\"_2jrvqA\">- Phiếu bảo hành : 1</p>\n<p class=\"_2jrvqA\">- Nguồn cắm điện: VDE</p>\n<p class=\"_2jrvqA\">- Lòng nồi</p>\n<p class=\"_2jrvqA\">- Dây nguồn - Muỗng xới - cốc đong</p>\n<p class=\"_2jrvqA\"> </p>\n<div class=\"_2jrvqA\">\n<div>\n<div class=\"_3iW6K2\"><img class=\"_2qyaZL _3DKwBj\" src=\"https://cf.shopee.vn/file/b4d905a093589304bb88c7213c8e0825\" alt=\"b4d905a093589304bb88c7213c8e0825\" /></div>\n</div>\n</div>\n<p class=\"_2jrvqA\">7.CHẾ ĐỘ BẢO HÀNH:</p>\n<p class=\"_2jrvqA\"> </p>\n<p class=\"_2jrvqA\">- Bảo hành 1 năm.</p>\n<p class=\"_2jrvqA\">- Đổi mới hoàn toàn trong 1 năm nếu lỗi do nhà sản xuất.</p>\n<p class=\"_2jrvqA\">- Bảo hành sản phẩm tận nhà (Áp dụng khu vực TP.HCM)</p>\n<div class=\"_2jrvqA\">\n<div class=\"_3iW6K2\"> </div>\n</div>\n<p class=\"_2jrvqA\">8.THÔNG TIN THƯƠNG HIỆU:</p>\n<div class=\"_2jrvqA\">\n<div>\n<div class=\"_3iW6K2\"><img class=\"_2qyaZL _3DKwBj\" src=\"https://cf.shopee.vn/file/24da9edbfb8909b66c19fdd800ad225c\" alt=\"24da9edbfb8909b66c19fdd800ad225c\" /></div>\n</div>\n</div><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/16/33/73/e4cba571dbf0a49d2825c04b8ea6d900.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/16/33/73/e4cba571dbf0a49d2825c04b8ea6d900.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/16/33/73/e4cba571dbf0a49d2825c04b8ea6d900.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/16/33/73/e4cba571dbf0a49d2825c04b8ea6d900.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/16/33/73/e4cba571dbf0a49d2825c04b8ea6d900.jpg"},{"base_url":"ht