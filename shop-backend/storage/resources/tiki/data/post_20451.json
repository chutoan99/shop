":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":600,"discount_rate":5,"rating_average":4.8,"review_count":5,"review_text":"(5)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/media/catalog/product/d/s/dsc_9108.u634.d20160418.t131116.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":0,"all_time_quantity_sold":33,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: medium; color: #008ab7;\"\u003e\u003cstrong\u003eViết Xóa Remo Kim\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eViết Xóa Remo Kim \u003c/strong\u003ecó thiết kế đầu kim mảnh, linh động, cho mực xoá ra đều theo ý muốn, giúp tẩy xóa sạch vết mực nhẹ nhàng. Mực xoá có độ phủ tốt, nhanh khô, vết mực mới chồng lên rõ ràng, cho trang giấy của bạn vẫn sạch đẹp dù tẩy xoá nhiều lần. Phần tay cầm chắc chắn, chống trơn trượt, bạn có thể dễ dàng điều khiển lượng mực xoá cần dùng.\u003c/p\u003e\r\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Viết Xóa Remo Kim\" src=\"http://tikicdn.com/media/catalog/product/d/s/dsc_9108.u634.d20160418.t131116.jpg\" alt=\"Viết Xóa Remo Kim\" width=\"600\" height=\"600\" /\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eThông tin sản phẩm\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eTẩy sạch nhẹ nhàng\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eViết Xóa Remo Kim\u003cstrong\u003e \u003c/strong\u003ecó thiết kế đầu kim mảnh, bền, linh động, cho mực xoá ra đều theo ý muốn. Sản phẩm giúp tẩy xóa sạch vết mực nhẹ nhàng.\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eMực xoá nhanh khô\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eMực xoá có độ phủ tốt, nhanh khô, vết mực mới chồng lên rõ ràng, cho trang giấy của bạn vẫn sạch đẹp dù tẩy xoá nhiều lần. Dung lượng mực xoá nhiều, có thể sử dụng lâu dài, rất tiết kiệm.\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eThiết kế hiện đại\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003ePhần tay cầm chắc chắn, chống trơn trượt, bạn có thể dễ dàng điều khiển lượng mực xoá cần dùng. Nắp búp chắc chắn, giúp bảo vệ đầu kim một cách tối ưu. Kiểu dáng bút hiện đại, trẻ trung, thích hợp sử dụng trong văn phòng, sinh viên, học sinh.\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eChất liệu cao cấp, an toàn\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eSản phẩm được làm bằng chất liệu nhựa cao cấp, có độ bền cao và hạn chế nứt vỡ khi rơi hoặc va chạm mạnh. Phần mực xoá được làm từ chất liệu an toàn, không chứa hoá chất độc hại gây ảnh hưởng đến sức khoẻ người dùng.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/media/catalog/product/d/s/dsc_9108.u634.d20160418.t131116.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/d/s/dsc_9108.u634.d20160418.t131116.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/d/s/dsc_9108.u634.d20160418.t131116.jp