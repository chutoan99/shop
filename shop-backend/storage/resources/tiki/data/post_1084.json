n_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/4c/4f/b3/cfd1da0094ac1eb0e9aadbc10f3290d5.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":571,"all_time_quantity_sold":12,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<article class=\"4ever-article\">\n<h3>Nước tắm thảo dược cho bé SACHI 250ml</h3>\n<h3><strong>Giới thiệu</strong></h3>\n<ul>\n<li style=\"font-weight:400;\"><strong>Nước tắm thảo dược SACHI</strong><span style=\"font-weight:400;\"> - Bảo vệ làn da bé yêu bằng thiên nhiên! Với thành phần từ thảo dược tự nhiên, sản phẩm làm sạch nhẹ nhàng, dịu mát, không gây kích ứng, bảo vệ làn da nhạy cảm của bé khỏi các tác nhân gây hại.</span></li>\n</ul>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/25/9c/f7/d55a29f6dc7d42984fc4ac867857b551.jpg\" alt=\"259cf71150cbf06945f1317477c770f4.jpg\" width=\"750\" height=\"750\" /></p>\n<h3><strong>Thành phần</strong></h3>\n<ul>\n<li style=\"font-weight:400;\"><span style=\"font-weight:400;\">Chiết xuất cúc la mã</span></li>\n<li style=\"font-weight:400;\"><span style=\"font-weight:400;\">Chiết xuất lá tre</span></li>\n<li style=\"font-weight:400;\"><span style=\"font-weight:400;\">Chiết xuất khổ qua </span></li>\n<li style=\"font-weight:400;\"><span style=\"font-weight:400;\">Chiết xuất rau má </span></li>\n<li style=\"font-weight:400;\"><span style=\"font-weight:400;\">Chiết xuất đu đủ</span></li>\n</ul>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/fd/54/c7/f93b42792008aa0cc08be5344f85657a.jpg\" alt=\"fd54c76d014b050166d879a2a9043450.jpg\" /></p>\n<h3><strong>Đặc điểm nổi bật</strong></h3>\n<ul>\n<li style=\"font-weight:400;\"><span style=\"font-weight:400;\">Được chiết xuất 100% thiên nhiên lá tre non &amp; 9 loại thảo dược: Dịch chiết cúc la mã, đu đủ, khổ qua, rau má, trà xanh, sài đất, lá khế, cỏ mần trầu, kim ngân hoa.</span></li>\n<li style=\"font-weight:400;\"><span style=\"font-weight:400;\">Không kích ứng da, không xà phòng, không chất hóa học, không hương liệu, không cay mắt, bảo vệ “hàng rào tự nhiên” của da bé</span></li>\n<li style=\"font-weight:400;\"><span style=\"font-weight:400;\">An toàn cho trẻ từ sơ sinh, dịu mát da; hỗ trợ phòng hăm da, mụn nhọt, mẩn ngứa, rôm sảy, mề đay, ngừa muỗi đốt, côn trùng cắn.</span></li>\n<li style=\"font-weight:400;\"><span style=\"font-weight:400;\">Có tinh dầu tràm trà dễ chịu, làm ấm, hỗ trợ chống cảm lạnh &amp; cảm cúm</span></li>\n<li style=\"font-weight:400;\"><span style=\"font-weight:400;\">Có diệp lục tố tạo màu tự nhiên; tác dụng chống oxy hóa và bảo vệ cơ thể khỏi các tác nhân có hại.</span></li>\n</ul>\n<p><strong>SẢN PHẨM 3 KHÔNG :</strong></p>\n<ul>\n<li style=\"font-weight:400;\"><span style=\"font-weight:400;\">Không chứa các chất tẩy rửa tổng hợp ( Parapen, corticoid) </span></li>\n<li style=\"font-weight:400;\"><span style=\"font-weight:400;\">Không có chất tạo màu tổng hợp</span></li>\n<li style=\"font-weight:400;\"><span style=\"font-weight:400;\">Không hương liệu tổng hợp</span></li>\n</ul>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/bc/16/18/59035a0d215528e89a7f5069b53c449a.jpg\" alt=\"bc1618ab83abcf175d61e3cfac8d020e.jpg\" /></p>\n<h3><strong>Công dụng</strong></h3>\n<ul>\n<li style=\"font-weight:400;\"><span style=\"font-weight:400;\">Giúp khử mùi, làm sạch nhẹ nhàng và làm dịu mát da.</span></li>\n<li style=\"font-weight:400;\"><span style=\"font-weight:400;\">Bảo vệ làn da trước các tác nhân gây dị ứng và hỗ trợ trong việc phòng một số trường hợp viêm nhiễm ngoài da ở trẻ sơ sinh và trẻ nhỏ như hăm da, mụn nhọt,mẩn ngứa, rôm sảy…</span></li>\n<li style=\"font-weight:400;\"><span style=\"font-weight:400;\">Làm sạch và ngăn ngừa các mảng bám trên da đầu.</span></li>\n<li style=\"font-weight:400;\"><span style=\"font-weight:400;\">Giúp hỗ trợ phòng ngừa muỗi, côn trùng cắn. </span></li>\n</ul>\n<p><img src=\"https://salt.tikicdn.com/ts/product/4c/4f/b3/d1d568f1fba924fbee679090ab5ce2f6.png\" alt=\"4c4fb3974cde06f8aafbaa8153ff7c3e.png\" /></p>\n<h3><strong>Hướng dẫn sử dụng</strong></h3>\n<ul>\n<li style=\"font-weight:400;\"><span style=\"font-weight:400;\">Dùng tắm hàng ngày cho trẻ sơ sinh trở lên, đặc biệt cho trẻ có làn da nhạy cảm từ 0-3 tuổi.</span></li>\n<li style=\"font-weight:400;\"><span style=\"font-weight:400;\">Pha dung dịch vào nước tắm theo tỷ lệ 5ml nước tắm thảo dược vào trong 5ml nước ấm.</span></li>\n<li style=\"font-weight:400;\"><strong>Cách tắm:</strong><span style=\"font-weight:400;\"> Dung dịch dùng tắm gội toàn thân. Rửa mặt, gội đầu và ngâm người bé trong nước tắm.</span></li>\n<li style=\"font-weight:400;\"><strong>Trong trường hợp rôm sảy, mụn nhọt:</strong><span style=\"font-weight:400;\"> Xoa trực tiếp nước tắm thảo dược lên vùng da bị rôm sảy, mụn nhọt khoảng 1-2 phút, sau đó tắm trong nước tắm đã pha.</span></li>\n<li style=\"font-weight:400;\"><span style=\"font-weight:400;\">Tắm, gội xong lau khô người, không cần tráng lại bằng nước thông thường</span></li>\n</ul>\n<h3><strong>Hướng dẫn bảo quản</strong></h3>\n<ul>\n<li style=\"font-weight:400;\"><span style=\"font-weight:400;\">Bảo quản nơi khô ráo, thoáng mát; để xa tầm tay trẻ em; đọc kỹ hướng dẫn sử dụng trước khi dùng</span></li>\n</ul>\n</article><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/4c/4f/b3/cfd1da0094ac1eb0e9aadbc10f3290d5.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/4c/4f/b3/cfd1da0094ac1eb0e9aadbc10f3290d5.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/4c/4f/b3/cfd1da0094ac1eb0e9aadbc10f3290d5.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4c/4f/b3/cfd1da0094ac1eb0e9aadbc10f3290d5.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4c/4f/b3/cfd1da0094ac1eb0e9aadbc10f3290d5.png"},{"base_url":"https://salt.tikicdn.com/ts/product/60/31/6e/36979b0dbcbee5aae2137788408dc65a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/60/31/6e/36979b0dbcbee5aae2137788408dc65a.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/60/31/6e/36979b0dbcbee5aae2137788408dc65a.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/60/31/6e/36979b0dbcbee5aae2137788408dc65a.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/60/31/6e/36979b0dbcbee5aae2137788408dc65a.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/bc/16/18/cb922459885a58aebec3d26bc7405b93.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/bc/16/18/cb922459885a58aebec3d26bc7405b93.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/bc/16/18/cb922459885a58aebec3d26bc7405b93.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/bc/16/18/cb922459885a58aebec3d26bc7405b93.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/bc/16/18/cb922459885a58aebec3d26bc7405b93.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/fd/54/c7/a57dbc39088a084d8289f0f9dbaccdb0.jpg","is_gallery":true,