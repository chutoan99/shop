ll}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/media/catalog/product/0/0/0080.u634.d20160418.t091541.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":0,"all_time_quantity_sold":29,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: medium; color: #008ab7;\"\u003e\u003cstrong\u003eViết Nước Bấm U-Knock Đỏ\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eViết Nước Bấm U-Knock Đỏ \u003c/strong\u003echo màu mực đỏ, nổi bật và rõ ràng trên nhiều chất liệu giấy. Đặc biệt, mực có độ bám cao, nhanh khô và rất bền màu. Đầu bi trơn, viết êm, không bị nghẹt, cho nét mực đậm và không lem.\u003c/p\u003e\r\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Viết Nước Bấm U-Knock Đỏ\" src=\"http://tikicdn.com/media/catalog/product/0/0/0080.u634.d20160418.t091541.jpg\" alt=\"Viết Nước Bấm U-Knock Đỏ\" width=\"600\" height=\"600\" /\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eThông tin sản phẩm\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eĐầu bi mượt, cho mực đậm đều\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eĐầu bi trơn, viết êm, không bị nghẹt, cho nét mực đậm và không lem. Khi viết nhanh, mực vẫn xuống đều, rõ nét. Ngoài ra, bạn có thể dùng bút để viết chữ kiểu hoặc viết nét thanh nét đậm đều đẹp.\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eMàu mực bóng sáng, bền màu\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eViết Nước Bấm U-Knock Đỏ cho màu mực đỏ, nổi bật và rõ ràng trên nhiều chất liệu giấy. Đặc biệt, mực có độ bám cao, nhanh khô và rất bền màu. Mực dạng nước, không chứa hoá chất độc hại cho người sử dụng.\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eThiết kế tiện lợi\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eThân bút bằng nhựa trong, bạn có thể dễ dàng nhìn thấy được lượng mực. Thân bút có lớp mút nhựa êm, giúp tránh trơn trượt, dễ cầm nắm và chống mỏi tay cho bạn. Lò xo bấm nhẹ nhàng, hạn chế tiếng ồn nơi công cộng. Kiểu dáng bút trẻ trung, hiện đại, thích hợp sử dụng cho nhân viên văn phòng hoặc học sinh.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/media/catalog/product/0/0/0080.u634.d20160418.t091541.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/0/0/0080.u634.d20160418.t091541.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/0/0/0080.u634.d20160418.t091541.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/0/0/0080.u634.d20160418.t091541.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/0/0/0080.u634.d20160418.t091541.jpg"}],"warranty_policy":null,"brand":{"id":45837,"name":"Uyên Loan","slug":"uyen-loan"},"current_seller":{"id":179476,"sku":"4219889580380","name":"VPP Sài Gò