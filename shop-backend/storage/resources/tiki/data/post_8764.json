a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":4800000,"discount_rate":49,"rating_average":4.5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ed/12/2b/aa67cf1ed34c0d217050f69796eebeed.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":410,"all_time_quantity_sold":10,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003e\u003cstrong\u003eKhách hàng lưu ý: Màn Hình Cong Máy Tính Xiaomi Gaming Mi Curved Gaming Monitor 30 Inch là phiên bản nội địa Trung Quốc nhập khẩu, ngôn ngữ mặc định nội địa có thể chuyển sang ngôn ngữ \"Tiếng Anh\" và sử dụng bình thường.\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003e\u003cstrong\u003eBảo Hành: Màn Hình 30 Inch bảo hành màn hình 6 tháng, bảo hình phần mềm cháy chập do nhà máy sản xuất là 12 tháng. Khách hàng lưu ý.\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eMàn hình XIAOMI REDMI  - 30Inch| 200HZ| CONG 1800R| 21:9| VA| 4m là một mẫu màn hình ultrawide 21:9 có giá thành rẻ, trang bị nhiều ưu điểm phù hợp với anh em game thủ.\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003ciframe src=\"//www.youtube.com/embed/1kyYxeoUCKI\" width=\"750\" height=\"750\" allowfullscreen=\"\"\u003e\u003c/iframe\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eXiaomi mới đây đã giới thiệu một mẫu màn hình giá rẻ mới nhưng có phần cứng khá hấp dẫn đối với các anh em game thủ. Chiếc màn hình này có tên gọi đầy đủ là Xiaomi Redmi Curved Monitor 30 inch, và đúng như tên gọi, đây là một chiếc màn hình ultrawide với kích thước 30 inch. Tuy chỉ có màn hình 30 inch nhưng Xiaomi cũng thiết kế màn hình dạng cong để game thủ có được một trải nghiệm “ngon” nhất trong quá trình chơi game.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/73/27/e4/478325361e9c6a11992780bfe4d561b1.jpg\" alt=\"\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp\u003eDo là màn hình ultrawide với tỷ lệ hiển thị là 21:9 nên dù có kích thước 30 inch nhưng Redmi Curved Monitor chỉ có chiều rộng bằng với một chiếc màn hình 24 inch với tỷ lệ 16:9 thông thường. Bởi vậy màn hình này không quá chiếm diện tích khi đặt trên bàn làm việc.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/6c/a6/4a/b27b68e64f1ef8827232c0eb91f1e956.jpeg\" alt=\"90e1b75dly4h179httrcjj20u00k0x3g.jpeg\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp\u003eThiết kế tổng thể của Redmi Curved Monitor cũng khá đẹp và tối giản. Mặt trước viền mỏng ở ba cạnh, dày hơn một chút ở cạnh dưới nhưng không phải là nơi đặt logo, mặt sau có thiết kế dạng nhựa mờ, đặt logo “Redmi” và có thiết kế có vẻ như được Xiaomi lấy cảm hứng từ các dòng màn hình Dell.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/b4/82/fd/e176be924b84c6b09244bbcdee4e96d4.jpg\" alt=\"\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/5d/fa/b6/1f16c74713cba4c0229134f58df46bc8.jpg\" alt=\"\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp\u003eChân đế của màn hình được hoàn thiện từ kim loại chắc chắn. Đây là chân đế chữ V và cũng không hề chiếm diện tích bàn làm việc nhiều. Tuy nhiên nếu không muốn sử dụng chân đế này thì người dùng có thể nối màn hình vào một tay Arm bên thứ 3 do có hỗ trợ ngàm VESA phổ thông.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/27/54/b7/0faf4f117241fef9d87134f78e483800.jpg\" alt=\"\" width=\"750\" height=\"500\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/98/be/af/9300268fa24df20c8e5dc61a60f2c960.jpg\" alt=\"\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp\u003eMặt sau của màn hình được thiết kế tối giản khi không để lộ bất cứ cổng kết nối nào. Các cổng kết nối được đặt bên trong một khu vực có nắp che bảo vệ. Nắp đậy này được thiết kế để chắn bụi lọt vào, đồng thời cũng là để người dùng sắp xếp các dây nối gọn gàng hơn, đi xuyên qua lỗ ở chân đế.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/2a/3a/df/b5e382621a94965a6e3fd69023cf3496.jpg\" alt=\"\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp\u003eVề khả năng hiển thị, như đã đề cập, màn hình Redmi Curved Monitor mới có kích thước 30 inch, tỷ lệ hiển thị là 21:9 và đây là màn hình với độ cong 1800R. Màn hình này sử dụng tấm nền VA chứ không phải IPS, có độ phân giải Full HD và có tần số quét 200Hz. Độ bao phủ màu sắc đạt 126% dải màu sRGB. Thông số này có lẽ phù hợp với những game thủ thay vì người dùng phổ thông. Xiaomi hỗ trợ tính năng FreeSync và G-Sync tích hợp sẵn trên màn hình.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/92/67/b0/518d847d893cd9dd3b626ee740417954.jpg\" alt=\"\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/54/ce/75/ffa954c05166186526c64fdd703fe6db.jpg\" alt=\"\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp\u003eVới những ai hay chơi game, đặc biệt là các tựa game bắn súng cần phản xạ nhanh, độ phân giải Full HD và tần số quét cao có lẽ là một yếu tố quan trọng ảnh hưởng tới quá trình chơi game. Chính bởi vậy Redmi Curved Monitor 30 inch là chiếc màn hình phù hợp để chơi game nhất, đặc biệt là chơi game FPS/TPS trong phân khúc giá rẻ.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/60/81/df/60ad9cdec6e89e724f7a7cb4b8c5964a.jpg\" alt=\"\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp\u003eXiaomi cho biết độ sáng tối đa cảu màn hình này là 300 nits, giá trị độ sáng cao nhất được đo đạ thực tế là 286.32 nits, độ tương phản 3000:1 và có giá trị thực tế là 4079:1, ổn so với mức giá của sản phẩm.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/e4/f9/49/99558672665f8c6185e856c34687111b.jpg\" alt=\"\" width=\"750\" height=\"499\" /\u003e\u003c/p\u003e\n\u003cp\u003eMàn hình Redmi ultrawide có các cổng kết nối gồm: DP 1.2, HDMI 1.4, HDMI 2.1, tuy nhiên trải nghiệm thực tế cho thấy băng thông truyền tải của cổng 2.1 này chỉ tương đương 2.0. Màn hình có thêm jack cắm 3.5mm, không có cổng USB-C.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/30/54/41/3e5512f63e3d2bb2ffd83ccc071e0872.jpg\" alt=\"\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp\u003eMàn hình XIAOMI REDMI - 30Inch| 2K| 200HZ| CONG 1800R| 21:9| VA| 4ms hiện tại đang được bán ra tại thị trường Trung Quốc với mức giá chỉ 1499 tệ, tương đương 5.4 triệu đồng. Đây là một mức giá tương đối hấp dẫn bởi trong phân khúc này hiếm có chiếc màn hình ultrawide 21:9 nào có được một tần số quét 200Hz cao như vậy, chưa kể thiết kế cũng có phần đẹp mắt.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng)..