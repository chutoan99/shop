average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/13/ac/26/da7ea30a8942e57e58c8e8131545d668.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":572,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align:justify;\"\u003e\u003cspan style=\"color:#ff0000;\"\u003e\u003cstrong\u003e1. Giận - Thích Nhất Hạnh\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003eGiận\u003c/strong\u003e được xuất bản tại Hoa Kỳ ngày 10.9.2001, trước biến cố 11.9.2001 có một ngày. Vì thế Giận đã trở thành quyển sách bán chạy nhất Hoa Kỳ - 50.000 bản mỗi tuần - trong vòng 9 thá\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003eTại Hàn Quốc, quyển sách này đã bán được 1 triệu bản trong vòng 11 tháng. Rất nhiều độc giả nhờ đọc sách này mà đã điều phục được tâm mình, sử dụng ái ngữ lắng nghe để hoà giải với người thân, đem lại hạnh phúc trong gia đình và trong cộng đồng của họ.\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cspan style=\"color:#ff0000;\"\u003e\u003cstrong\u003e2. Gieo Trồng Hạnh Phúc\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cspan style=\"color:#000000;\"\u003eThực tập chánh niệm (smrti) đưa đến định (samadhi) và định đưa đến tuệ (prajna). Tuệ giác mà ta đạt được từ sự thực tập chánh niệm có khả năng giải phóng chúng ta ra khỏi những tình trạng sợ hãi, lo âu, tuyệt vọng và đem lại hạnh phúc đích thực cho ta. Chúng ta có thể sử dụng những đối tượng đơn giản như bông hoa để thực tập chánh niệm. Khi cầm bông hoa trong tay, chúng ta ý thức về bông hoa. Hơi thở vào ra giúp ta duy trì ý thức. Thay vì để cho những suy nghĩ trấn ngự hoặc lôi kéo, ta trở về có mặt cho bông hoa và thưởng thức vẻ đẹp của bông hoa. Định lực sẽ trở thành nguồn suối phát sinh niềm vui trong ta.\u003c/span\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/13/ac/26/da7ea30a8942e57e58c8e8131545d668.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/13/ac/26/da7ea30a8942e57e58c8e8131545d668.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/13/ac/26/da7ea30a8942e57e58c8e8131545d668.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/13/ac/26/da7ea30a8942e57e58c8e8131545d668.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/13/ac/26/da7ea30a8942e57e58c8e8131545d668.png"},{"base_url":"https://salt.tikicdn.com/ts/product/20/34/17/1ab238bb31f6a54fccd0a722d25b28d4.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/20/34/17/1ab238bb31f6a54fccd0a722d25b28d4.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/20/34/17/1ab238bb31f6a54fccd0a722d25b28d4.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/20/34/17/1ab238bb31f6a54fccd0a722d25b28d4.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/20/34/17/1ab238bb31f6a54fccd0a722d25b28d4.png"},{"base_url":"https://salt.tikicdn.com/ts/product/82/b1/45/242f21542bcd4d81c16a44e38718d0cc.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/82/b1/45/242f21542bcd4d81c16a44e38718d0cc