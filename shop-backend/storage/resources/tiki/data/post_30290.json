con_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/8a/3a/25/968a55e44df977b2e4a634256367385c.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":324,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003ePHIÊN BẢN SẢN PHẨM\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e01 Sổ tay chép kinh Địa Tạng Bồ Tát Bổn Nguyện tặng kèm 01 bút line kháng nước chép kinh không nhòe và 01 hướng dẫn chép kinh\u003c/p\u003e\n\u003cp\u003e_________________________\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eTHÔNG TIN SẢN PHẨM\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eTên tác phẩm: Sổ tay chép kinh Địa Tạng Bồ Tát Bổn Nguyện\u003c/p\u003e\n\u003cp\u003eBiên soạn: Tuệ Lâm\u003c/p\u003e\n\u003cp\u003eThể loại: Sổ\u003c/p\u003e\n\u003cp\u003eThương hiệu: Kira Books\u003c/p\u003e\n\u003cp\u003eNhà xuất bản: NXB Hồng Đức\u003c/p\u003e\n\u003cp\u003eNăm xuất bản: 2023\u003c/p\u003e\n\u003cp\u003eMã ISBN: 9786044763767\u003c/p\u003e\n\u003cp\u003eLoại bìa: Mềm giấy bồi dày\u003c/p\u003e\n\u003cp\u003eKhổ: 20.5 x 28.5 cm\u003c/p\u003e\n\u003cp\u003eSố trang: 128 trang\u003c/p\u003e\n\u003cp\u003e_________________________\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eGIỚI THIỆU SẢN PHẨM\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eSổ tay chép Kinh ĐỊA TẠNG BỒ TÁT BỔN NGUYỆN in chữ mờ do Kira Books phát hành đã được cấp giấy phép xuất bản của Nhà xuất bản Hồng Đức:\u003c/p\u003e\n\u003cp\u003e- Trọn bộ 4 quyển Kinh Địa Tạng được in trong 1 ấn phẩm duy nhất, bao gồm: Kinh Địa Tạng Bồ Tát Bổn Nguyện quyển thượng, quyển trung, quyển hạ và Kinh Địa Tạng phẩm hồi hướng.\u003c/p\u003e\n\u003cp\u003e- Sổ tay được in sẵn nét mờ để quý vị đồ theo thuận tiện, nét chữ đẹp ngay ngắn, hạn chế việc chép sai.\u003c/p\u003e\n\u003cp\u003e- Bìa dày cứng; chất liệu giấy chép mỹ thuật cao cấp, dày mịn\u003c/p\u003e\n\u003cp\u003e- Tặng kèm 01 bút chép kinh kháng nước không nhòe và 01 tờ hướng dẫn chép kinh.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eChép Kinh là một cách để tu tập - hạnh nguyện lan tỏa chánh Pháp, công đức đó là vô cùng quý báu!\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eKinh Địa Tạng có dạy rằng: “Người thiện nam, người thiện nữ nào tự mình biên chép Kinh này, hoặc bảo người biên chép, hoặc tự mình đắp vẽ hình tượng của Bồ Tát, cho đến bảo người khác đắp vẽ, thì quả báo mà người đó thọ nhận tất được lợi ích lớn.”\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eCông đức của việc chép Kinh Địa Tạng được nêu rõ trong Phẩm 6 của Kinh Địa Tạng như: tiêu trừ tội chướng, thân xinh đẹp, siêu độ vong linh, sinh con dễ nuôi,\u003c/p\u003e\n\u003cp\u003e● Nhờ chép kinh mà chuyển hóa được nghiệp, thân tâm trở nên an ổn, nhẹ nhàng, công việc tình duyên thuận lợi.\u003c/p\u003e\n\u003cp\u003e● Nắn nót chép Kinh giúp mình rèn chữ, ghi nhớ và hiểu rõ lời Kinh.\u003c/p\u003e\n\u003cp\u003e● Chép Kinh phước lớn lắm, nhờ phước này mình được các vị long thần hộ pháp, chư Phật bảo trợ. Đời sau này còn có duyên gặp lại Kinh Điển để tu học.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eAn trú trong hiện tại, sống sâu sắc từng giây, từng phút với năng lượng chánh niệm là một điều mà ai cũng có thể làm được. Chúc bạn được sống trong sự an lạc và công đức vô lượng.\u003c/p\u003e\n\u003cp\u003e_________________________\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eHƯỚNG DẪN CHÉP KINH\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e- Bản chép có thể mang theo đến chỗ làm, đi du lịch, thuận tiện để chép ở mọi nơi, mọi lúc, giờ nghỉ trưa, hay giờ giải lao…\u003c/p\u003e\n\u003cp\u003e- Trước khi chép, cần làm sạch mặt bàn, khi chép nếu tay ra mồ hôi, xin kê 1 tấm giấy lên. Đọc lời nguyện trước mỗi buổi chép Kinh.\u003c/p\u003e\n\u003cp\u003e- Khi chép nên đặt tâm vào nét chữ, nếu suy nghĩ đến chuyện khác, nên hướng tâm lại vào nét chữ.\u003c/p\u003e\n\u003cp\u003e- Khi chép xong, nên bảo quản sổ ở nơi khô ráo, sạch sẽ, không đè các đồ vật khác lên trên. Đọc lời nguyện sau mỗi buổi chép Kinh.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/8a/3a/25/968a55e44df977b2e4a634256367385c.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/8a/3a/25/968a55e44df977b2e4a634256367385c.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/8a/3a/25/968a55e44df977b2e4a634256367385c.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8a/3a/25/968a55e44df977b2e4a634256367385c.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8a/3a/25/968a55e44df977b2e4a634256367385c.png"},{"base_url":"https://salt.tikicdn.com/ts/product/05/e1/4d/4e3e30140bd1201bf3b7943d9552e633.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/05/e1/4d/4e3e30140bd1201bf3b7943d9552e633.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/05/e1/4d/4e3e30140bd1201bf3b7943d9552e633.jpg","position":null,"s