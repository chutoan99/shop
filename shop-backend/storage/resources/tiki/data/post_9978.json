"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/8a/e5/ae/721609c41e769c4ab51927de33d37810.png","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":122,"all_time_quantity_sold":5,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eIM LẶNG, THOẢI MÁI VÀ DỄ DÀNG\u003c/p\u003e\n\u003cp\u003eHãy làm quen với M240 Silent, con chuột Bluetooth đáng tin cậy giúp giải phóng không gian làm việc của bạn, kết nối trong vài giây và mang lại năng suất cực kỳ yên tĩnh kéo dài. Hình dáng đường nét, điêu khắc và thời lượng pin 18 tháng cho phép bạn tập trung vào những gì bạn làm tốt nhất.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7qukw-lh35wyjdu8mq1a\" width=\"1001\" height=\"506\" alt=\"vn-11134208-7qukw-lh35wyjdu8mq1a\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eBLUETOOTH NHANH CHÓNG, DỄ DÀNG\u003c/p\u003e\n\u003cp\u003eM240 Silent kết nối trong vài giây với một cặp đáng tin cậy và phát kết nối Bluetooth—không cần dongle hoặc cổng. Hoạt động với Windows, macOS, Chrome OS, Linux, Android.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7qukw-lh35wyjdvn7635\" width=\"818\" height=\"438\" alt=\"vn-11134208-7qukw-lh35wyjdvn7635\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eÍT TIẾNG ỒN, TẬP TRUNG HƠN\u003c/p\u003e\n\u003cp\u003eCông nghệ SilentTouch giảm 90% âm thanh nhấp chuột, nhưng vẫn giữ cảm giác bấm quen thuộc mà bạn biết và yêu thích. Vì vậy, bạn cảm thấy từng cú nhấp chuột, nhưng hầu như không nghe thấy gì. Ít tiếng ồn hơn, hiệu suất tuyệt vời—và những người hàng xóm trong quán cà phê của bạn sẽ cảm ơn bạn.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7qukw-lh35wyjdx1rmf6\" width=\"797\" height=\"449\" alt=\"vn-11134208-7qukw-lh35wyjdx1rmf6\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eTUỔI THỌ PIN BẠN CÓ THỂ TIN TƯỞNG\u003c/p\u003e\n\u003cp\u003eTuổi thọ pin 18 tháng với chế độ ngủ tự động, do đó bạn sẽ sử dụng được lâu hơn giữa các lần thay pin. Bạn có thể quên pin—một cục pin AA được lắp sẵn.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7qukw-lh35wyjdygc26b\" width=\"797\" height=\"449\" alt=\"vn-11134208-7qukw-lh35wyjdygc26b\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eCHẤT LƯỢNG BẠN CÓ THỂ TIN CẬY\u003c/p\u003e\n\u003cp\u003eChuột được chế tạo bằng cách sử dụng cùng các tiêu chuẩn chất lượng cao đã đưa Logitech trở thành công ty hàng đầu thế giới về chuột và bàn phím.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7qukw-lh35wyjdzuwi8f\" width=\"969\" height=\"452\" alt=\"vn-11134208-7qukw-lh35wyjdzuwi8f\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eHÌNH DÁNG THOẢI MÁI, THIẾT KẾ NHỎ GỌN\u003c/p\u003e\n\u003cp\u003eDuy trì năng suất làm việc lâu hơn với hình dáng thoải mái, có đường viền theo đường cong tự nhiên của bàn tay bạn. Nhỏ gọn và không dây, chuột dễ dàng vừa với máy tính xách tay của bạn trong một chiếc túi—vì vậy bạn có thể mang nó đi bất cứ đâu bạn làm việc. M240 Silent được thiết kế để tạo sự thoải mái như nhau cho cả người dùng thuận tay trái và tay phải.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7qukw-lh386uqj9v0211\" width=\"797\" height=\"449\" alt=\"vn-11134208-7qukw-lh386uqj9v0211\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eĐIỀU HƯỚNG DỄ DÀNG, KIỂM SOÁT CHÍNH XÁC\u003c/p\u003e\n\u003cp\u003eĐiều hướng dễ dàng hơn với trải nghiệm cuộn theo từng dòng được kiểm soát. Không còn những cú nhấp chuột bị bỏ lỡ khó chịu nữa - hãy tận hưởng khả năng điều khiển con trỏ mượt mà và chính xác trên hầu hết mọi bề mặt.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7qukw-lh386uqjb9ki0b\" width=\"797\" height=\"449\" alt=\"vn-11134208-7qukw-lh386uqjb9ki0b\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/8a/e5/ae/721609c41e769c4ab51927de33d37810.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/8a/e5/ae/721609c41e769c4ab51927de33d37810.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/8a/e5/ae/721609c41e769c4ab51927de33d37810.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8a/e5/ae/721609c41e769c4ab51927de33d37810.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8a/e5/ae/721609c41e769c4ab51927de33d37810.png"},{"base_url":"https://salt.tikicdn.com/ts/product/b6/55/40/1446e5bae4f58118316c97b7d3d5ebbd.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b6/55/40/1446e5bae4f58118316c97b7d3d5ebbd.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b6/55/40/1446e5bae4f58118316c97b7d3d5ebbd.png","position":null,"small_url":"https://salt.tikicdn.