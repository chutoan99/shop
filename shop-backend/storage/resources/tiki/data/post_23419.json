b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":14000,"discount_rate":5,"rating_average":5,"review_count":9,"review_text":"(9)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/68/67/ef/5ca19a59ffa8d3cb8ee491406e502da3.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1121,"all_time_quantity_sold":30,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2\u003eGIỚI THIỆU SẢN PHẨM.\u003c/h2\u003e\n\u003ch3\u003e\u003cstrong\u003eTrong cuộc sống hiện đại việc sở hữu một chiếc ấm đun nước siêu tốc trong mỗi gia đình Việt là điều không thể thiếu và ấm đun nước siêu tốc thủy tinh CTFAST\u003c/strong\u003e\u003cstrong\u003e với nhiều công dụng và tính năng ưu việt, chắc chắn sẽ là trợ thủ đắc lực không thể thiếu đem lại tiện ích cho gia đình bạn .\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/68/67/ef/581a1e9121ce466ab6c2d71d1bb63c44.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/68/d7/1b/4ec52905a4ea96f03a4f8a03014ed83c.jpg\" alt=\"\" width=\"750\" height=\"411\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cem\u003eẤm đun nước siêu tốc thủy tinh CTFAST - 01 ( 1.8 Lít ):sở hữu những đặc điểm nổi bật so với các dòng sản phẩm cùng loại đem lại chất lượng tốt nhất đến quý khách hàng .\u003c/em\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003ch3\u003e1. Thiết kế tinh tế sang trọng.\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eẤm đun nước siêu tốc thủy tinh CTFAST với dung tích lên tới 1.8 lít nhưng lại được thiết kế khá nhỏ gọn, sang trọng và hiện đại, thân bình làm từ chất liệu thuỷ tinh Borosilicate chịu nhiệt đến 400 độ C, an toàn cho sức khoẻ của cả gia đình bạn.\u003c/li\u003e\n\u003cli\u003eCác bộ phận tiếp xúc với nước, nắp ấm, tấm gia nhiệt đều đươc làm bằng thép không gỉ: an toàn khi sử dụng\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/cd/3f/a1/b0f98d90c12fa26b3c0185a33d6449f6.jpg\" alt=\"\" width=\"750\" height=\"1272\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/43/cf/c5/08d0117ae693035cd6d49c421aee0668.jpg\" alt=\"\" width=\"750\" height=\"1255\" /\u003e\u003c/p\u003e\n\u003ch3\u003e2. Sử dụng chất liệu an toàn , độ bền cao.\u003c/h3\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/71/d2/d0/3f23c96445880cd9b1778b770f714c7a.jpg\" alt=\"\" width=\"750\" height=\"1085\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/19/f1/9b/f1a6d4224456b23ff6fa78fb1ce66ea5.jpg\" alt=\"\" width=\"750\" height=\"1150\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/ed/81/24/fe2c57a4f5a589ba5197fba75bddc4e2.jpg\" alt=\"\" width=\"750\" height=\"1272\" /\u003e\u003c/p\u003e\n\u003ch3\u003e3. Kiểm soát nhiệt độ chính xác an toàn khi sử dụng.\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eBình đun siêu tốc được tích hợp chế độ ngắt điện tự động khi nước sôi hoặc khi cạn nước. Bên cạnh đó, thân bình bằng thuỷ tinh trong suốt nên bạn dễ dàng quan sát quá trình đun nước đang diễn ra.\u003c/li\u003e\n\u003cli\u003eBình đun còn trang bị thêm lưới lọc cạn tại phần miệng, giúp loại bỏ cặn bẩn tích tụ trong nước, mang lại nguồn nước uống sạch và tinh khiết hơn. Với chức năng khử trùng sau khi đun sôi nước đến 100 độ C, sẽ giúp loại bỏ hầu hết vi khuẩn và hàm lượng các chất có hại giảm xuống ở hàm lượng cho phép. Đem lại sự an toàn tuyệt đối cho gia đình bạn.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/00/e8/51/1a6ba43c6bc27353c669761f711845da.jpg\" alt=\"\" width=\"750\" height=\"1173\" /\u003e\u003c/p\u003e\n\u003ch3\u003e4. Tính năng đổi màu độc đáo dễ dàng vệ sinh sau khi sử dụng.\u003c/h3\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/1c/23/a6/a2fbd8a62b375be1285a885dcbca8cd1.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/6d/a1/de/0306d559d4ef72c07ab89a97413fffa1.jpg\" alt=\"\" width=\"750\" height=\"1140\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/e2/02/86/8cbc0bfeed58a353ec6f22e5cce240ff.jpg\" alt=\"\" width=\"750\" height=\"949\" /\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003e5.Thông số kỹ thuật sản phẩm .\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/dc/6e/61/5ec18cb848e55a06cfaab3b1544f7b48.jpg\" alt=\"\" width=\"750\" height=\"1414\" /\u003e\u003c/strong\u003e\u0