s_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":7,"review_text":"(7)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ad/a9/a4/b88c9c291613d17e52fb388deee22393.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1114,"all_time_quantity_sold":34,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch1\u003eNón Bảo Hiểm 1/2 Đầu Không Kính Protec Disco DLWF (Size L), Phối 2 Màu Thời Trang\u003c/h1\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/e8/16/aa/2bcc2efc58bde56ae844e11e6709b2d2.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e Được sản xuất trên dây chuyền công nghiệp hiện đại, được phối màu sắc sảo, mềm mại. Kiểu dáng mửa đầu gọn gàng cùng trọng lượng nhẹ, tạo sự thoải mái cho người dùng.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/61/3a/b8/a0ff5b4f309aff294f395d979ce79d80.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eBố trí 6 lỗ thoát khí khoa học nhưng rất thời trang, mang lại cảm giác thoải mái, thoáng mát khi đội nhưng cũng rất cá tính.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/b3/05/ba/d2125e3a3a7c30386a87c94f6c017196.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eVỏ bằng nhựa ABS cao cấp, chịu được lực va đập lớn và nhiệt độ cao, giúp chống lại nhiều tác động bên ngoài.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/de/c4/82/2a798d944c073595d5fce7740562efcb.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eLõi xốp mũ là bộ phận quan trọng có tác dụng giảm chấn động tới đầu người đội và bảo vệ bộ não. Lõi với chất liệu chính là EPS, nén bằng nhiều lớp xốp rắn chắc, các hạt xốp nhỏ, đều mịn nhẹ, thoáng và hấp thu xung động tốt khi xảy ra tai nạn. Lớp mút này có thể tháo ra dễ dàng để giặt hay vệ sinh khi cần.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/fd/b9/52/296877e3a02a8309da9937a4d89d446e.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eMũ có trọng lượng rất nhẹ, chỉ khoảng 458 - 490 gram khiến bạn luôn cảm thấy nhẹ nhàng trong thời gian dài sử dụng.\u003c/li\u003e\n\u003cli\u003eDây mũ được thiết kế đặc biệt, chịu được lực kéo, lực văng lớn. Đồng thời giúp ôm gọn vòng đầu tốt hơn nhưng không gây khó chịu. Dây mũ có thể điều chỉnh độ dài ngắn dễ dàng.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/a0/07/ab/faf62e56c1572cf24f783500921cd7ab.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eHƯỚNG DẪN XÁC ĐỊNH CỠ MŨ PHÙ HỢP:\u003c/p\u003e\n\u003cp\u003e+ Vòng 1 sợi dây quanh đầu, phía trên lông mày và tai khoảng 2cm. Xiết sợi dây sao cho ôm vừa đủ thoải mái lấy đầu và ghi lại số đo đó. Lặp lại như vậy để tìm được số đo mà bạn thấy dễ chịu nhất. Đó chính là size đầu của bạn. So sánh với kích cỡ mũ để lựa chọn size mũ phù hợp.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/4d/04/23/1d6040ebbe026ae95e120a64201fe188.png\" alt=\"\" width=\"0\" height=\"0\" /\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/4d/04/23/5ecc351a4767bb702e91ba22ba65599b.png\" alt=\"\" width=\"687\" height=\"510\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ad/a9/a4/b88c9c291613d17e52fb388deee22393.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ad/a9/a4/b88c9c291613d17e52fb388deee22393.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ad/a9/a4/b88c9c291613d17e52fb388deee22393.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ad/a9/a4/b88c9c291613d17e52fb388deee22393.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ad/a9/a4/b88c9c291613d17e52fb388deee22393.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/10/72/92/58cb21146e23e5ded84bd66a022569f4.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/10/72/92/58cb21146e23e5ded84bd66a022569f4.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/10/72/92/58cb21146e23e5ded84bd66a022569f4.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/10/72/92/58cb21146e23e5ded84bd66a022569f4.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/10/72/92/58cb21146e23e5ded84bd66a022569f4.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/fd/fe/64/90180e1902cf2f648cdf3e769cbd2b4a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/fd/fe/64/90180e1902cf2f648cdf3e769cbd2b4a.