,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":55000,"discount_rate":10,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/7a/d6/48/0687365115a95f86b5fbf42af4da756e.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":554,"all_time_quantity_sold":8,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e Tính năng nổi bật:\u003c/p\u003e\n\u003cp\u003e● Độ phân giải 8K 60Hz(Single screen)/4K 60Hz(Dual-screen)\u003c/p\u003e\n\u003cp\u003e● Chất liệu: Hợp kim nhôm + Nylon\u003c/p\u003e\n\u003cp\u003e● Công suất: 20V/5A 100W\u003c/p\u003e\n\u003cp\u003e● Hỗ trợ sạc PD 100W\u003c/p\u003e\n\u003cp\u003e● Chứng chỉ INTEL\u003c/p\u003e\n\u003cp\u003e● Tương thích Thunderbolt 3\u003c/p\u003e\n\u003cp\u003e GIỚI THIỆU SẢN PHẨM\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eTốc độ truyền lên đến 40Gbps\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eCáp Thunderbolt 4 Orico TBZ4 Tốc độ truyền dữ liệu của cáp USB-C Thunderbolt 4 lên đến 40Gbps. Đó là gấp 4 lần so với USB Loại C Gen 2 và nhanh hơn gấp 8 lần so với Loại C 3.0. Hãy LƯU Ý rằng tốc độ truyền dữ liệu sẽ vẫn phụ thuộc vào cổng bạn đang sử dụng. USB 3.1 thế hệ 2 (10 Gbps) USB 3.1 thế hệ 1 / 3.0 (5 Gbps) Truyền phim 4K trong vòng chưa đầy 30 giây. Lưu ý: Thiết bị truyền dữ liệu cần hỗ trợ truyền dữ liệu 40 Gbps.Với hiệu suất lên đến 40Gb / giây, cáp Thunderbolt 4 lý tưởng để sử dụng với đế cắm Thunderbolt, đế cắm USB-C, eGPU, SSD, bộ lưu trữ RAID, thiết bị AR / VR và hơn thế nữa.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/4d/1e/b4/62cf9691ab01f3977ae522da60dcf3bd.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eHỗ trợ 8K 60Hz(Single screen)/4K 60Hz(Dual-screen) màn hình kép 4K hoặc màn 8K\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eNếu như máy tính hỗ trợ Thunderbolt 3 chỉ hỗ trợ 1 màn hình 4K@60hz. Phiên bản Thunderbolt4 đã hỗ trợ 2 x màn hình 4K@60hz hoặc 1 màn hình .\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/3f/86/fb/c34f08f899b417d66bca82d365550bdd.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eSạc 100W\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eOrico TBZ4 sở hữu công suất đến 100W, lý tưởng để sử dụng với các thiết bị Thunderbolt 4, Thunderbolt 3, USB4 hoặc USB-C có thể cung cấp điện cho máy tính xách tay. Cho dù được kết nối với đế cắm hoặc bất kỳ thiết bị cấp nguồn USB-C nào khác, cáp đa chức năng cao cấp này được chế tạo để cung cấp năng lượng một cách đáng tin cậy cho nhu cầu cuộc sống kỹ thuật số của bạn.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/1d/7a/4f/9631519b496aaabd81ffdbf0b7f6504e.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e CHỨNG CHỈ THUNDERBOLT 4 VÀ TƯƠNG THÍCH CÁC THIẾT BỊ USB-C KHÁC\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eNgoài quá trình kiểm tra chất lượng nghiêm ngặt mà tất cả các loại cáp của chúng tôi phải trải qua, cáp này cũng đã được kiểm tra để tuân thủ các tiêu chuẩn Thunderbolt do Intel cung cấp. Được kiểm tra về độ bền và chức năng duy trì, hỗ trợ tương thích với Thunderbolt 3 với chất lượng mà bạn mong đợi từ một công ty hàng đầu trong ngành với hơn 35 năm kinh nghiệm.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/70/d2/df/9af995e4a6b0f4456911549021ddbe1e.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e Tương thích hầu hết các thiết bị hiện này như MB, dell XPS\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eKhả năng tương thích hơn: Đầu nối USB Type-C tương thích với tất cả các tiện ích Thunderbolt 4, Thunderbolt 3 và USB C như bộ điều hợp Ethernet, USB hub, Docking Station, eGPU, PCI-E, Razer Core và Windows DELL XPS15, Microsoft Surface Book, Google Chromebook Pixel, MB pro15 / 17/18, HP, Samsung Galaxy S8 + Tab Pro, Acer Switch Alpha 12 mới, Acer Spin,\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/f2/13/49/149e0b16cdd5bfbeb1172c7cbdd6b687.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/7a/d6/48/0687365115a95f86b5fbf42af4da756e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/7a/d6/48/0687365115a95f86b5fbf42af4da756e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/7a/d6/48/0687365115a95f86b5fbf42af4da756e.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7a/d6/48/0687365115a95f86b5fbf42af4da756e.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7a/d6/48/0687365115a95f86b5fbf42af4da756e.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/c2/0a/20/0de07766334b9d1039db69c8f82b4c30.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c2/0a/20/0de07766334b9d1039db69c8f82b4c30.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c2/0a/20/0de07766334b9d1039db69c8f82b4c