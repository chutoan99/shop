bde38316081865.png","icon_width":91,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/1f/d9/92/923968852876fe937eb2092e2d1114a3.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":749,"all_time_quantity_sold":10,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<h1><em><strong>Giới thiệu Nước rửa kính lái đậm đặc tỉ lệ 1:100 Sonax 371141 250ml</strong></em></h1>\n<p>Đối với những người sử dụng ô tô thì chắc hẵn đã không ít lần bạn cảm thấy phiền toái với những vấn đề khách quan khó tránh khỏi trên chiếc ô tô chẵng hạn như kính lái xe bị ố, dính bẩn gây cản trở tầm nhìn của ban. Đây lại là một vấn đề rất khó để xử lý ổn thoả. Trong trường hợp thế này thì <em><strong>Nước rửa kính lái đậm đặc tỉ lệ 1:100 Sonax 371141 250ml </strong></em>sẽ là phương pháp tốt nhất để làm sạch kính ô tô của bạn.</p>\n<p><em><strong>Nước rửa kính lái đậm đặc tỉ lệ 1:100 Sonax 371141 250ml </strong></em>thuộc thương hiệu <em><strong>Sonax</strong></em>, Sản phẩm được sản xuất tại <em><strong>Đức</strong></em></p>\n<p> </p>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/6e/fd/61/4bf3d74af85f5411ae09ae1591f31f58.jpg?v=1660635556082\" alt=\"371141-nd1.jpg?v=1660635556082\" /></p>\n<h2> </h2>\n<h2><strong>Thông tin sản phẩm</strong></h2>\n<ul><li>Tên sản phẩm: <em><strong>Nước rửa kính lái đậm đặc tỉ lệ 1:100 Sonax 371141 250ml </strong></em></li>\n<li><em>Tên sản phẩm (EN): <strong>Sonax Clear View Vision Clara 1:100 Concentrate</strong></em></li>\n<li>Mã hàng: <em><strong>SO-371141</strong></em></li>\n<li>Công dụng: tẩy rửa vết bẩn, vết ố, dầu mỡ, vết côn trùng trên kính lái xe ô tô</li>\n<li><strong>Xuất xứ: Đức</strong></li>\n<li>Dạng: dung dịch</li>\n<li>Dung tích: 250ml</li>\n<li>Hạn sử dụng: 5 năm</li>\n</ul><p> </p>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/25/02/31/68d3a1cc6941fb221fd760a6ade9a830.jpg?v=1660635563258\" alt=\"371141-nd2.jpg?v=1660635563258\" /></p>\n<h2> </h2>\n<h2><strong>Thông tin nổi bật</strong></h2>\n<ul><li>Siêu đậm đặc, dễ dàng vận chuyển, cất giữ và chi phí thấp mỗi lần thay.</li>\n<li>Công thức thiên nhiên, không độc hại và có hương chanh thơm nhẹ.</li>\n<li>Loại trừ các vết bẩn dính và chất dầu mỡ bám trên kính lái từ khói xe trên đường.</li>\n<li>Bảo vệ, làm mềm, bôi trơn, kéo dài tuổi thọ và hiệu năng hoạt động của lưỡi cao su gạt mưa.</li>\n<li>Tạo lớp bảo vệ ngăn bụi và dầu mỡ có trong không khí từ khói xe.</li>\n<li>Ngăn chặn côn trùng như kiến, gián, bọ…</li>\n<li>Không tạo vết ố nước sau khi lau</li>\n<li>Tác dụng lâu dài, không làm hại sơn</li>\n<li>Sản xuất trên dây chuyền công nghệ hiện đại của Đức</li>\n</ul><p> </p>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/95/8e/92/478912de612b3c3f325f9a042e334c23.jpg?v=1660635571145\" alt=\"371141-nd3.jpg?v=1660635571145\" /></p>\n<h2> </h2>\n<h2><strong>Hướng dẫn sử dụng</strong></h2>\n<ul><li>Bước 1: lắc đều chai <em><strong>Nước rửa kính lái đậm đặc tỉ lệ 1:100 Sonax 371141 250ml </strong></em></li>\n<li>Bước 2: Pha với nước theo tỉ lệ 1:100 để lau trực tiếp với khăn </li>\n<li>Bước 3: Hoặc đổ trực tiếp lọ dung dịch vào bình chứa nước rửa kính của xe</li>\n</ul><p> </p>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/d9/f3/a9/9d65df2611ed42972285ce8cb06de097.jpg?v=1660635581519\" alt=\"371141-nd4.jpg?v=1660635581519\" /></p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/1f/d9/92/923968852876fe937eb2092e2d1114a3.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/1f/d9/92/923968852876fe937eb2092e2d1114a3.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/1f/d9/92/923968852876fe937eb2092e2d1114a3.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1f/d9/92/923968852876fe937eb2092e2d1114a3.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1f/d9/92/923968852876fe937eb2092e2d1114a3.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/f6/c5/04/444875b5bcda7b52498bef37b2f5942d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f6/c5/04/444875b5bcda7b52498bef37b2f5942d.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f6/c5/04/444875b5bcda7b52498bef37b2f5942d.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f6/c5/04/444875b5bcda7b52498bef37b2f5942d.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f6/c5/04/444875b5bcda7b52498bef37b2f5942d.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/e6/05/e3/d2ec