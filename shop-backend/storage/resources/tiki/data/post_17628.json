:null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":3580,"discount_rate":2,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/d0/1f/90/fcfb2878bccc36b2b8321323e33ac0ba.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":247,"all_time_quantity_sold":8,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2 style=\"text-align:center;\"\u003eTúi Xe Đạp gắn cốt yên BS-067 sẵn dụng cụ vá săm lốp xe đạp mini nhiều món, lắp đặt dễ dàng, dung tích 1 Lít - Mai Lee\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003eKích thước nhỏ: Túi yên xe đạp nhỏ và nhẹ, có thể dễ dàng mang theo.\u003c/li\u003e\n\u003cli\u003eThích hợp để đi xe đạp, leo núi, MTB, \u003c/li\u003e\n\u003cli\u003eSản phẩm Túi yên xe đạp được làm từ chất liệu chống thấm nước, 2 lớp, chống thấm bên trong, có thể bảo vệ đồ đạc của bạn khỏi mưa nắng một cách hiệu quả, phù hợp với mọi thời tiết\u003c/li\u003e\n\u003cli\u003eThiết kế dải phản quang bên hông 2 bên, giúp đảm bảo an toàn khi đạp xe ban đêm khi xe khác chiếu đèn pha.\u003c/li\u003e\n\u003cli\u003eChất liệu: Vải oxford 1680D và chất liệu chống mài mòn, đảm bảo tuổi thọ sử dụng lâu hơn.\u003c/li\u003e\n\u003cli\u003eKích thước: 17 x 8,5 x 12 cm\u003c/li\u003e\n\u003cli\u003eDung tích: ~1 lít\u003c/li\u003e\n\u003cli\u003ePhù hợp cất trữ những thứ nhỏ gọn: thì móc chìa khóa, điện thoại, khăn mặt và ví là những thứ cần thiết\u003c/li\u003e\n\u003cli\u003eSản phẩm gồm túi gắn cốt yên bên ngoài và các sản phẩm dụng cụ sửa chữa mini vá săm xe đạp kèm theo như hình\u003c/li\u003e\n\u003cli\u003eThiết kế dễ dàng tháo và lắp đặt dễ dàng, thuận tiện.\u003c/li\u003e\n\u003cli\u003e2 model lựa chọn: BS-SH-06 (6 món - như hình hoặc video) và BS-LX-07 (7 món - như hình hoặc video)\u003c/li\u003e\n\u003cli\u003e\u003cem\u003eLưu ý: sản phẩm ko kèm đèn đuôi (chỉ là hình minh họa), Thanh nạy lốp nhựa màu đen BS-SH-06 nhỏ hơn thanh nạy lốp nhựa của model BS-LX-07\u003c/em\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/48/b5/71/f0ad813bc19ce1b32472733c63afd4aa.jpg\" alt=\"Tui-Dung-Cu-Va-Sam-Kem-Dung-Cu-Gan-Yen-Xe-Dap-BS-Nhieu-Mon-1 copy\" width=\"750\" height=\"3124\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/de/1f/62/78127af865e99f17f57cfb15fc2e64ce.jpg\" alt=\"Tui-Dung-Cu-Va-Sam-Kem-Dung-Cu-Gan-Yen-Xe-Dap-BS-Nhieu-Mon-2 copy\" width=\"750\" height=\"3124\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/d0/1f/90/fcfb2878bccc36b2b8321323e33ac0ba.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d0/1f/90/fcfb2878bccc36b2b8321323e33ac0ba.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d0/1f/90/fcfb2878bccc36b2b8321323e33ac0ba.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d0/1f/90/fcfb2878b