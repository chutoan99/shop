 nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/46/b7/0f/90ffc754c73f9bcde0a42249459b0909.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/46/b7/0f/90ffc754c73f9bcde0a42249459b0909.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/46/b7/0f/90ffc754c73f9bcde0a42249459b0909.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/46/b7/0f/90ffc754c73f9bcde0a42249459b0909.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/46/b7/0f/90ffc754c73f9bcde0a42249459b0909.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/00/9c/d6/5bc87ed77558a137b4ac8901309b6472.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/00/9c/d6/5bc87ed77558a137b4ac8901309b6472.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/00/9c/d6/5bc87ed77558a137b4ac8901309b6472.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/00/9c/d6/5bc87ed77558a137b4ac8901309b6472.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/00/9c/d6/5bc87ed77558a137b4ac8901309b6472.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/1d/c8/e0/a613bba4020323c94bd4ccef6ac268ee.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/1d/c8/e0/a613bba4020323c94bd4ccef6ac268ee.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/1d/c8/e0/a613bba4020323c94bd4ccef6ac268ee.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1d/c8/e0/a613bba4020323c94bd4ccef6ac268ee.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1d/c8/e0/a613bba4020323c94bd4ccef6ac268ee.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/65/b3/28/7111394623dc8ba0c32d5fe4895beb8c.jpg","is_gallery":true,"label":null,"large_url":"