u (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/f9/02/ef/4b77ab2019ecf2d6056f5cb5196a2d6e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f9/02/ef/4b77ab2019ecf2d6056f5cb5196a2d6e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f9/02/ef/4b77ab2019ecf2d6056f5cb5196a2d6e.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f9/02/ef/4b77ab2019ecf2d6056f5cb5196a2d6e.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f9/02/ef/4b77ab2019ecf2d6056f5cb5196a2d6e.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/47/73/b1/05385aaa669e0cc65259daebf013c9bd.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/47/73/b1/05385aaa669e0cc65259daebf013c9bd.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/47/73/b1/05385aaa669e0cc65259daebf013c9bd.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/47/73/b1/05385aaa669e0cc65259daebf013c9bd.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/47/73/b1/05385aaa669e0cc65259daebf013c9bd.png"},{"base_url":"https://salt.tikicdn.com/ts/product/a6/d1/30/bb0625b6aefc47b0fbbd38d7807dc710.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a6/d1/30/bb0625b6aefc47b0fbbd38d7807dc710.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a6/d1/30/bb0625b6aefc47b0fbbd38d7807dc710.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a6/d1/30/bb0625b6aefc47b0fbbd38d7807dc710.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a6/d1/30/bb0625b6aefc47b0fbbd38d7807dc710.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/53/43/e9/5e955dc7f306e4e1be6c0ad96941fccb.jpg","is_gallery":true,"label":null,"large_url":"https://s