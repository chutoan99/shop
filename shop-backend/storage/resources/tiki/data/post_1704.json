s_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":40000,"discount_rate":20,"rating_average":4.5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/27/6d/23/2f651335f05089fb53f87a67be82f04c.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1006,"all_time_quantity_sold":11,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/7b/da/19/36bb1b6b5c1e4ac73c3c78cbec367e40.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eBạn đam mê chơi cờ, thích sưu tập sở hữu các loại cờ thì không thể bỏ lỡ Combo đồ chơi Boardgame, bộ sưu tập cờ dành cho các bé và gia đình cùng nhau giải trí đấu trí với nhau trong những ngày nghỉ lễ: Combo gồm có 6 loại sản phẩm được làm từ gỗ tự nhiên, xuất xứ Việt Nam mọi người có thể lựa chọn mua theo phân loại có sẵn: Cờ búng xuyên lỗ; Cờ búng bóng đá; Cờ ô ăn quan phiên bản 2 ông quan lộc thọ; Cờ caro; Cờ cá ngựa; Hộp cờ đa năng 4 trong 1 tích hợp 4 loại cờ trong 1 sản phẩm\u003c/p\u003e\n\u003cp\u003e1. Cờ búng xuyên lỗ\u003c/p\u003e\n\u003cp\u003eSản xuất bằng gỗ thuần mộc\u003c/p\u003e\n\u003cp\u003eKích thước: 34x22x5cm\u003c/p\u003e\n\u003cp\u003eSản xuất tại Việt Nam\u003c/p\u003e\n\u003cp\u003eTiện lợi mang theo du lịch\u003c/p\u003e\n\u003cp\u003eCách chơi thú vị vui nhộn\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/07/93/8c/0f01f66a1383289e2fc5ace5e7c25cfc.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e2. Cờ búng bóng đá\u003c/p\u003e\n\u003cp\u003eBàn cờ và quân cờ được làm từ gỗ an toàn\u003c/p\u003e\n\u003cp\u003eĐược bo  cạnh và góc nhọn, đảm bảo an toàn\u003c/p\u003e\n\u003cp\u003eNhỏ gọn, dễ dàng mang theo bên người, thích hợp với những buổi dã ngoại, du lịch, tụ họp cùng bạn bè và người thân.\u003c/p\u003e\n\u003cp\u003eLuật chơi đơn giản, cuốn hút và hồi hộp.\u003c/p\u003e\n\u003cp\u003eKích thước:35x22x3cm\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/84/67/6c/de29d1a55ef20c875e05fd13f559c945.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e3. Bộ bàn chơi Ô ăn quan\u003c/p\u003e\n\u003cp\u003eTrò chơi dân gian Ô ăn quan đã quen thuộc với nhiều thế hệ\u003c/p\u003e\n\u003cp\u003ePhiên bản bàn gỗ, tiện lợi khi mang di chuyển\u003c/p\u003e\n\u003cp\u003eThiết kế gọn nhẹ, chắc chắn, các hạt bằng gỗ thông được mài tròn, mịn, đảm bảo an toàn khi chơi\u003c/p\u003e\n\u003cp\u003eTăng sự tương tác giữa các thành viên trong gia đình, ông bà, cha mẹ dạy trẻ cách chơi\u003c/p\u003e\n\u003cp\u003eKích thước: 58x22 cm\u003c/p\u003e\n\u003cp\u003eSản xuất tại Việt Nam\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/e5/cd/11/fa8300b4675cd77c344786962b501e8f.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/28/f2/59/bb7b970ef2b56760893de38872ac7ebe.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e4. Cờ Caro kích thước 25x22cm\u003c/p\u003e\n\u003cp\u003eCờ được làm bằng gỗ tự nhiên\u003c/p\u003e\n\u003cp\u003eBàn cờ có 80 quân cờ X và O,  kèm cột chia tỷ số cho 2 đội\u003c/p\u003e\n\u003cp\u003eĐược sản xuất bằng công nghệ CNC Laser hiện đại\u003c/p\u003e\n\u003cp\u003eKích thước bàn cờ: 22x25xm\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/18/dc/2e/cf6fdf5228ebf0c9783928fd63738d5f.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e5. Cờ cá ngựa bằng gỗ\u003c/p\u003e\n\u003cp\u003eBộ đồ chơi có thể cho 2 đến 4 bé chơi cùng lúc\u003c/p\u003e\n\u003cp\u003eSản phẩm gồm 1 bàn cờ, các quân cờ với nhiều màu sắc xanh lá, xanh dương, vàng, đỏ, 2 xí ngầu\u003c/p\u003e\n\u003cp\u003eChất gỗ tự nhiên\u003c/p\u003e\n\u003cp\u003eSản xuất tại Việt Nam\u003c/p\u003e\n\u003cp\u003eKích thước: 26x26x3cm\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/27/6d/23/fff52e4c51908c1bba176075e4698501.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e6. Hộp cờ đa năng 4 in 1\u003c/p\u003e\n\u003cp\u003eBàn cờ bằng gỗ, gọn nhẹ bàn cờ kiêm hộp đựng có chốt cài tiện lợi\u003c/p\u003e\n\u003cp\u003eBộ đồ chơi kết hợp \u003cstrong\u003eCờ Búng,Cờ vây, Cờ Đua Ngựa Kết Hợp Cờ Caro\u003c/strong\u003e\u003cstrong\u003e \u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eXuất xứ: Việt Nam\u003c/p\u003e\n\u003cp\u003eKích thước khi gấp:30x30x5cm\u003c/p\u003e\n\u003cp\u003eKích thước khi mở:60x30x2,5cm\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/32/16/a6/30c536e0f46f3a4f5c880a9bd65a87d3.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/27/6d/23/2f651335f05089fb53f87a67be82f04c.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/27/6d/23/2f651335f05089fb53f87a67be82f04c.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/27/6d/23/2f651335f05089fb53f87a67be82f04c.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/27/6d/23/2f651335f05089fb53f87a67be82f04c.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/27/6d/23/2f6513