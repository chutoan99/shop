width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.6,"review_count":89,"review_text":"(89)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/52/db/fb/0a0aa76d01de54d003c55587c9623c04.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":642,"all_time_quantity_sold":517,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch1 style=\"text-align:center;\"\u003eKìm Bóp Tay Pro Đếm Số Điện Tử - Chọn Màu - Dụng Cụ Tập Gym Tập Cơ Bắp Cổ Tay Cao Cấp Tại Nhà Điều Chỉnh Lực Từ 10-100kg Chính Hãng Dododios\u003c/h1\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/65/b9/c3/476cd611988a98cfdaa476f5abc6b121.jpg\" alt=\"Kìm Bóp Tay Pro chính hãng dododios\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch3 style=\"background:#FFFFFF;text-align:center;\"\u003eKìm bóp tay điều chỉnh lực là dụng cụ tập cơ tay giúp hỗ trợ đắc lực cho việc tập cơ bàn tay và ngón tay, phòng chống các bệnh xương khớp, thích hợp cho người tập võ, tập thể lực hoặc cho nhân viên văn phòng muốn luyện tập cơ tay do gõ bàn phím nhiều\u003c/h3\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/96/45/63/a1b3a51c183613b01c6cdcf059cc163c.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/ba/0c/67/b467fc9c48db702f5695483bbd293137.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/16/60/cb/83c65d1be6c34f0b393702e317984346.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/88/54/80/33a8ecbf9c0782756beb90af53e28260.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch3 style=\"background:#FFFFFF;text-align:center;\"\u003eSử dụng kìm bóp tay thường xuyên sẽ giúp bạn giữ tạ lâu hơn khi tập thể hình; tăng sức mạnh vung vợt lên đáng kể khi chơi cầu lông, Tennis; giúp ích khi tập luyện thể dục dụng cụ hoặc tập leo núi,\u003c/h3\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/e7/61/79/0f0bc4ac25002ba23881d4fe42022c71.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch3 style=\"background:#FFFFFF;text-align:center;\"\u003eTheo nhiều huấn luyện viên thể hình, nếu muốn cổ tay ấn tượng hơn và to hơn người khác thì bạn nên tập luyện với kìm bóp tay thường xuyên – cải thiện ngoại hình bắp tay – gân guốc hơn.\u003c/h3\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/f6/cf/64/6ec6060c3b523c1afe80109e19a7a1cd.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch3 style=\"background:#FFFFFF;text-align:center;\"\u003eKìm bóp tay giúp cho ngón tay dẻo hơn, chắc chắn, độc lập hơn – giúp ngón tay sử dụng được khéo hơn – Tăng độ dẻo dai của bắp tay hơn so với lúc chưa tập.\u003c/h3\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/f2/b7/0a/230e3a788b30c561f5b228081065619c.jpg\" alt=\"kìm bóp tay cao cấp chính hãng\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch3 style=\"background:#FFFFFF;text-align:center;\"\u003eNgoài ra kìm bóp tay Pro giúp tuần hoàn máu, giảm stress hiệu quả, và đồng thời giúp tăng cường sức khỏe người dùng.\u003c/h3\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/c3/3b/85/cd8d44823ee91beb31cd073bc749b058.jpg\" alt=\"kìm bóp tay cao cấp\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch3 style=\"background:#FFFFFF;text-align:center;\"\u003eNúm của Kìm có thể điều chỉnh lực bóp từ 10 – 100kg – phù hợp với nhiều đối tượng sử dụng\u003c/h3\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/52/db/fb/0a0aa76d01de54d003c55587c9623c04.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/52/db/fb/0a0aa76d01de54d003c55587c9623c04.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/52/db/fb/0a0aa76d01de54d003c55587c9623c04.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/52/db/fb/0a0aa76d01de54d003c55587c9623c04.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/52/db/fb/0a0aa76d01de54d003c55587c9623c04.png"},{"base_url":"https://salt.tikicdn.com/ts/product/f5/15/cf/f3dcb85b947ce0f16e26cbfba1eddb2c.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f5/15/cf/f3dcb85b947ce0f16e26cbfba1eddb2c.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f5/15/cf/f3dcb85b947ce0f16e26cbfba1eddb2c.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f5/15/cf/f3dcb85b947ce0f16e26cbfba1eddb2c.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/produ