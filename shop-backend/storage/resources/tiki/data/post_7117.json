,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/09/32/c3/0740b97ae946dc7de970bad5b273cb9f.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":931,"all_time_quantity_sold":9,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003eViên Uống Tăng Cường Nội Tiết KIỀU XUÂN Bổ Sung Collagen Giảm Lão Hóa, Giúp Da Sáng Và Mịn Màng Hơn Hộp 20 Viên\u003c/strong\u003e\u003c/p\u003e\n\u003carticle class=\"4ever-article\"\u003e\n\u003cp\u003e[ LÔ HSD: T6/2025]\u003c/p\u003e\n\u003c/article\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cstrong\u003e \u003cimg src=\"https://salt.tikicdn.com/ts/tmp/12/d1/26/5b9252a6ba062ab126aa0fe90c2bed7e.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003e1. THÔNG TIN SẢN PHẨM\u003c/strong\u003e\u003cbr /\u003e- Tên sản phẩm: Viên Uống Tăng Cường Nội Tiết KIỀU XUÂN\u003cbr /\u003e- Thương hiệu: KIỀU XUÂN\u003cbr /\u003e- Xuất xứ: Việt Nam\u003cbr /\u003e- Quy cách hộp: 2 vỉ x 10 viên\u003cbr /\u003e- Hạn sử dụng: 36 tháng\u003cbr /\u003e- Sản phẩm hỗ trợ tăng cường nội tiết nữ, giúp làm chậm quá trình lão hóa tự nhiên, bổ sung collagen da sáng mịn và căng mượt.\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/6d/14/ec/124f2f82f9305a3c56cb3cdeb49a38f1.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003e2. THÀNH PHẦN\u003c/strong\u003e\u003cbr /\u003e- EstroG-100 (hỗn hợp thảo dược đương qui, tục đoạn, cách sơn tiêu), Gama-Oryzanol, Glutathione, DHEA, Pregnenolone Acetat (chiết xuất từ củ mài đắng), Collagen, Cao củ sắn dây, Curcumin\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003e3. CÔNG DỤNG\u003c/strong\u003e\u003cbr /\u003e- Viên uống kiều xuân giúp tăng cường các nội tiết tố nữ, cải thiện các biểu hiện suy giảm nội tiết tố nữ.\u003cbr /\u003e- Bổ sung collagen và glutathione giúp da được sáng mịn săn chắc giảm lão hoá da.\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/cd/e6/ac/273201da9c6357a8842bf7f4eca25b24.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003e4. CÁCH DÙNG\u003c/strong\u003e\u003cbr /\u003e- Ngày uống 2 viên, chia 2 lần\u003cbr /\u003e- Nên uống trước bữa ăn 30 phút hoặc sau khi ăn 1 giờ.\u003cbr /\u003e- Sử dụng liên tục 3-6 tháng để đạt kết quả trông thấy. Nên sử dụng thường xuyên, lâu dài để làm đẹp da, duy trì nét thanh xuân và nữ tính.\u003cbr /\u003e- Không sử dụng cho người mẫn cảm với bất kỳ thành phần nào của sản phẩm. Người đang bị u xơ tử cung, u cục ở vú, tham khảo ý kiến chuyên gia trước khi dùng.\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/a3/90/1f/1a25648228b2548f6105fdce5447de4b.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003e5. ĐỐI TƯỢNG SỬ DỤNG\u003c/strong\u003e\u003cbr /\u003e- Phụ nữ trưởng thành bị suy giảm nội tiết tố nữ với biểu hiện như mệt mỏi, cơn bốc hoả, mất ngủ, rối loạn kinh nguyệt, giảm sinh lý nữ, da khô.\u003cbr /\u003e- Phụ nữ thời kỳ tiền mãn kinh và mãn kinh.\u003cbr /\u003e- Phụ nữ bị lão hoá da, sạm da, nám da, da kém đàn hồi.\u003cbr /\u003e- Phụ nữ có nhu cầu làm đẹp da.\u003cbr /\u003e#kieuxuan #vienuongkieuxuan #trangda #depda #laohoa #suygiamnoitietto#vien#uong#kieu#xuan\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/09/32/c3/0740b97ae946dc7de970bad5b273cb9f.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/09/32/c3/0740b97ae946dc7de970bad5b273cb9f.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/09/32/c3/0740b97ae946dc7de970bad5b273cb9f.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/09/32/c3/0740b97ae946dc7de970bad5b273cb9f.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/09/32/c3/0740b97ae946dc7de970bad5b273cb9f.png"},{"base_url":"https://salt.tikicdn.com/ts/product/b9/bd/0e/5eb712b804a95fdde003587a0978c027.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b9/bd/0e/5eb712b804a95fdde003587a0978c027.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b9/bd/0e/5eb712b804a95fdde003587a0978c027.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b9/bd/0e/5eb712b804a95fdde003587a0978c027.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b9/bd/0e/5eb712b804a95fdde003587a0978c027.png"},{"base_url":"https://salt.tikicdn.com/ts/product/5a/f0/73/801c0aa48d58c862a8a53f88faeb3d8e.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/5a/f0/73/801c0aa48d58c862a8a53f88faeb3d8e.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/5a/f0/73/801c0aa48d58c862a8