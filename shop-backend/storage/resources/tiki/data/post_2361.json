":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":true,"return_reason":"any_reason"}},"discount":231000,"discount_rate":40,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/d7/1b/92/8e9dbd25bf69b81b216a1ef772881fee.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":407,"all_time_quantity_sold":5,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eBạn đang tìm kiếm một sản phẩm phù hợp với thói quen gối thấp hoặc nằm sấp mà vẫn sở hữu sự nâng đỡ hoàn hảo? Gummi Pudding chính là lựa chọn lý tưởng với chiều cao 4,5 - 6cm cùng thiết kế công thái học hỗ trợ tối ưu đường cong cổ vai gáy.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/be/86/7b/a038e6ea7c8221fa3371977881d105ef.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch3\u003eLợi ích sản phẩm\u003c/h3\u003e\n\u003cp\u003e\u003cstrong\u003eCao su nguyên khối đàn hồi vượt trội\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eGummi Pudding cho cảm giác được nâng niu êm ái, đàn hồi tối đa nhờ chất liệu cao su thiên nhiên nguyên khối. Đặc tính này giúp giải phóng áp lực đè nén khi phần đầu tiếp xúc với gối, giúp xoa dịu nhức mỏi tốt hơn.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/e3/13/ca/f87aa995dc3c28d427613a8f1751955c.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eNâng đỡ chính xác với thiết kế lượn sóng\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eĐường cong cổ-vai-gáy được ôm sát và chăm sóc tối ưu hơn nhờ thiết kế lượn sóng (contour). Gối có 2 đầu với 2 độ cao khác nhau là 4,5cm và 6cm cho bạn sự lựa chọn linh hoạt. Độ cao trung bình thấp này an toàn cho người thích nằm sấp, giảm tải nguy cơ gặp phải các vấn đề về thoái hóa đốt sống cổ.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/7e/16/d6/a54b446460e747668f94445f707c962c.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCông nghệ thoáng khí gấp 2\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eGummi Pudding được ứng dụng công nghệ xử lý tân tiến cho cấu trúc cao su thoáng khí tối ưu. Đồng thời, thiết kế bề mặt có hệ thống lỗ thoáng khí giúp lưu thông không khí, thấm hút mồ hôi tốt, hạn chế ẩm mốc và mùi khó chịu trong mọi thời tiết.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/84/be/33/fa5ee0778d6401e787a2c172eae2ae2c.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/6b/8a/69/74d2c1849839bc5ec757e70196255be1.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eChất liệu an toàn cho sức khỏe\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eGối cao su Gummi Pudding an toàn cho mọi đối tượng nhờ chất liệu có nguồn gốc thiên nhiên cùng sợi vải đã đạt các chứng nhận kiểm định chặt chẽ.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/1f/1f/df/5430adbce5c323c2f80b2a0944821cbf.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eSản phẩm đã đạt Chứng nhận hợp quy và SGS Test.\u003c/strong\u003e\u003c/p\u003e\n\u003ch3\u003eThương hiệu Gummi - Bản giao hưởng giữa thiên nhiên và công nghệ\u003c/h3\u003e\n\u003cp\u003eGummi là thương hiệu nệm - phụ kiện với hơn 14 năm phát triển, tiên phong ứng dụng những công nghệ tân tiến trên nền vật liệu cao su 100% thiên nhiên để cải thiện chất lượng cuộc sống.\u003c/p\u003e\n\u003ch3\u003eHướng dẫn sử dụng và bảo quản\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eKhông giặt ruột gối, không dùng lực quá mạnh, không phơi gối dưới ánh nắng mặt trời\u003c/li\u003e\n\u003cli\u003eTuyệt đối không sử dụng máy giặt, dù là để chế độ giặt nhẹ nhất\u003c/li\u003e\n\u003cli\u003eGiặt áo gối với xà phòng phơi khô dưới nắng\u003c/li\u003e\n\u003cli\u003eKhông sử dụng bột giặt có chất tẩy rửa mạnh\u003c/li\u003e\n\u003cli\u003ePhơi gối cao su ở những nơi thoáng mát, tránh nơi có ánh sáng trực tiếp hoặc nơi có nhiệt độ cao. Có thể phơi trước quạt nếu trong nhà không có nơi phơi gối phù hợp. \u003c/li\u003e\n\u003cli\u003eNên vệ sinh gối cao su bằng khăn ướt ít nhất 2 - 3 tuần 1 lần hoặc khi gối bị bẩn/ có mùi hôi.\u003c/li\u003e\n\u003cli\u003eĐặt gối trên bề mặt phẳng để tránh gây ảnh hưởng đến cấu trúc gối\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/d7/1b/92/8e9dbd25bf69b81b216a1ef772881fee.jpg","is_gallery":true,"l