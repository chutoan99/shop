ps://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":true,"return_reason":"any_reason"}},"discount":1349400,"discount_rate":26,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/34/0e/5c/7b8c4533d63ee8df10929c582048ab1d.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1044,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eBộ Kit gồm:\u003cbr /\u003e- 3 bóng đèn màu thông minh Philips Hue White and Color Ambiance 9W A60 E27 \u003cbr /\u003e- 1 thiết bị điều khiển trung tâm Philips Hue Bridge\u003c/p\u003e\n\u003cp\u003eĐiều chỉnh màu sắc đèn lên tới 16 triệu màu\u003cbr /\u003eHệ thống dải màu từ 2000K – 6500K, Hue White and Color Ambiance E27 cho phép người dùng tự điều chỉnh mọi màu sắc đèn tuỳ thích. Mọi màu sắc đều lên màu đậm nét, nhanh nhạy và ổn định. Người dùng còn có thể dễ dàng điều chỉnh độ sáng đèn chỉ qua một vài thao tác đơn giản.\u003c/p\u003e\n\u003cp\u003eChức năng tạo ngữ cảnh đa dạng\u003cbr /\u003eVới bóng đèn màu thông minh, bạn hoàn toàn có thể cài đặt các ngữ cảnh riêng cho mình. Ngoài một số ngữ cảnh mặc định, bạn có thể tự tạo ngữ cảnh như: đèn đọc sách, đèn bữa tối, đèn cho tiệc tùng,…. Các ngữ cảnh này đều có thể dễ dàng thiết lập qua ứng dụng Hue. Bóng đèn Color Ambiance được thiết kế chính cho giải trí và tạo điểm nhấn.\u003c/p\u003e\n\u003cp\u003eĐiều khiển tiện ích qua giọng nói\u003cbr /\u003eĐã không còn thời kì bạn phải điều chỉnh đèn bằng tay. Với bóng đèn màu thông minh, ngoài việc điều khiển bằng điện thoại. Bạn còn có thể điều chỉnh thông qua giọng nói (Siri, Google Assistant, Alexa,…) chỉ nhờ vào một chiếc loa thông minh đơn giản.\u003c/p\u003e\n\u003cp\u003eKết hợp tự động hoá (Automation) với hệ sinh thái Philips Hue\u003cbr /\u003eVới việc trang bị một Trung tâm điều khiển Hue Bridge, đèn Hue White and Color Ambiance sẽ có chức năng hơn cả một đèn màu thông thường. Bạn có thể thêm tối đa 50 đèn thông minh để điều khiển trong nhà. Hẹn giờ và tạo ngữ cảnh để tự động hóa toàn bộ đèn. Kiểm soát đèn của bạn trong khi xa nhà. Hoặc thêm các phụ kiện như cảm biến chuyển động và Dimmer.\u003c/p\u003e\n\u003cp\u003eVới ứng dụng Hue, bạn có thể điều khiển các bóng đèn từ bất cứ nơi đâu. Thiết lập bật tắt tự động theo lịch trình và thay đổi cường độ chiếu sáng. Một số tự động hoá bạn có thể tạo như:\u003cbr /\u003e- Bật đèn trước khi về nhà vào tối muộn.\u003cbr /\u003e- Không còn lo lắng quên tắt đèn khi ra khỏi nhà.\u003cbr /\u003e- Tự động bật đèn vào 7h sáng và tắt đèn vào 11h tối.\u003c/p\u003e\n\u003cp\u003eTính năng:\u003cbr /\u003e- Sáng tạo với 16 triệu màu sắc.\u003cbr /\u003e- Đồng bộ với nhạc và phim.\u003cbr /\u003e- Tăng cảm xúc khi chơi game.\u003cbr /\u003e- Thức giấc và đi ngủ một cách tự nhiên.\u003cbr /\u003e- Tạo không gian với ánh sáng từ vàng ấm đến trắng sáng.\u003cbr /\u003e- Các chế độ ánh sáng thư giản, đọc sách, tập trung hay tràn đầy năng lượng.\u003cbr /\u003e- Quản lý thông minh, điều khiển tại nhà và xa nhà.\u003cbr /\u003e- Đặt hẹn giờ để tăng tự tiện dụng của bạn.\u003cbr /\u003e- Thay đổi độ sáng dễ dàng.\u003cbr /\u003e- Điều khiển bằng nhiều cách qua điện thoại, remote, cảm biến, giọng nói.\u003c/p\u003e\n\u003cp\u003eTHÔNG SỐ KỸ THUẬT\u003cbr /\u003eBóng đèn Hue White and Color Ambiance:\u003cbr /\u003e- Màu ánh sáng: 2000K-6500K +16 triệu màu.\u003cbr /\u003e- Độ sáng: 806lm tại độ sáng 4000K\u003cbr /\u003e- Thay đổ độ sáng: Bằng Dimmer Switch\u003cbr /\u003e- Kết nối: Zigbee + Bluetooth\u003cbr /\u003e- Công suất: 9W\u003cbr /\u003e- Nguồn điện: 220V-240V 50/60Hz\u003cbr /\u003e- Tuổi thọ: 25,000 giờ\u003cbr /\u003e- Số lần bật/tắt: 50,000\u003cbr /\u003e- Kích thước: A60\u003cbr /\u003e- Đuôi đèn: E27\u003cbr /\u003e- Độ hoàn màu: CRI\u0026gt;80\u003c/p\u003e\n\u003cp\u003eTrung tâm điều khiển Hue Bridge:\u003cbr /\u003e- Nguồn điện: Dùng Adaptor\u003cbr /\u003e- Điện vào Adaptor: 100-240V 50/60Hz\u003cbr /\u003e- Số lượng đèn tối đa: 50\u003cbr /\u003e- Số lượng phụ kiện tối đa: 12\u003cbr /\u003e- Kết nối: Zigbee + RJ45\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/34/0e/5c/7b8c4533d63ee8df10929c582048ab1d.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/34/0e/5c/7b8c4533d63ee8df10929c582048ab1d.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/34/0e/5c/7b8c4533d63ee8df10929c582048ab1d.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/34/0e/5c/7b8c4533d63ee8df10929c582048ab1d.png","thumbnail_url":"https://salt.tikicdn.com/cache