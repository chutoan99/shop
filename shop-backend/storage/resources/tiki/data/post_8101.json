êm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/42/b8/05/5f6873efba334e0adb2a3a36960c533b.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/42/b8/05/5f6873efba334e0adb2a3a36960c533b.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/42/b8/05/5f6873efba334e0adb2a3a36960c533b.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/42/b8/05/5f6873efba334e0adb2a3a36960c533b.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/42/b8/05/5f6873efba334e0adb2a3a36960c533b.png"},{"base_url":"https://salt.tikicdn.com/ts/product/72/20/c4/d6566f041c1099cf7a1d0a548b9054a7.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/72/20/c4/d6566f041c1099cf7a1d0a548b9054a7.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/72/20/c4/d6566f041c1099cf7a1d0a548b9054a7.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/72/20/c4/d6566f041c1099cf7a1d0a548b9054a7.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/72/20/c4/d6566f041c1099cf7a1d0a548b9054a7.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/ad/c0/fd/332d654fe2006ef168e223c7506cd45d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ad/c0/fd/332d654fe2006ef168e223c7506cd45d.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ad/c0/fd/332d654fe2006ef168e223c7506cd45d.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ad/c0/fd/332d654fe2006ef168e223c7506cd45d.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ad/c0/fd/332d654fe2006ef168e223c7506cd45d.jpg"}],"warranty_policy":null,"brand":{"id":47686,"name":"Mitsubishi","slug":"mits