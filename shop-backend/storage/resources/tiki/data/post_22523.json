ht":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":28000,"discount_rate":21,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/b5/68/46/275b9e76109d91f5cc4753238630926d.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":264,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eTHÔNG TIN CHI TIẾT\u003c/p\u003e\n\u003cp\u003e- Chất liệu: Khung thép cao cấp sơn tĩnh điện, Đệm xốp eva.\u003c/p\u003e\n\u003cp\u003e-Màu sắc: Xanh Dương, Đen, Đỏ\u003c/p\u003e\n\u003cp\u003e-Khối lượng: 800g\u003c/p\u003e\n\u003cp\u003e-Kích thước: 26 x 12,7 x 15 cm. Đường kính mỗi đế hút 12,5cm\u003c/p\u003e\n\u003cp\u003e- Thiết kế nhỏ gọn giúp bạn chủ động luyện tập mọi lúc, mọi nơi.\u003c/p\u003e\n\u003cp\u003eCÁCH DÙNG:\u003c/p\u003e\n\u003cp\u003e- Lau sạch mặt phẳng sàn, đặt dụng cụ xuống sàn, gạt cần cố định và bắt đầu trải nghiệm\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/a2/d6/37/3388d1fa85209912b5ea2aa3b6ceb569.png\" alt=\"\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/92/58/d7/cfd99e95983bc716992b8cd4243d3848.png\" alt=\"\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/d5/13/fe/0c2819fb139b9a1ba985ad8c0c001451.png\" alt=\"\" /\u003e\u003c/p\u003e\n\u003cp\u003e--------------------\u003c/p\u003e\n\u003cp\u003eTập thể dục là cách hiệu quả nhất giúp bạn có được một cơ thể khỏe mạnh và vóc dáng cân đối. Không chỉ thế, việc luyện tập thể dục còn giúp bạn thư giãn, cân bằng cuộc sống sau ngày dài lao động mệt nhọc. Thế nhưng, không phải ai cũng có điều kiện đến các phòng gym, yoga đầy đủ tiện nghi và tập theo phương pháp khoa học nhất.\u003c/p\u003e\n\u003cp\u003e- Chúng tôi mang đến cho bạn cơ hội sở hữu dụng cụ tập thể dục đa năng eo thon lưng bọ ngựa, giảm mỡ bụng hiểu quả qua các bài tập có kèm video hướng dẫn.\u003c/p\u003e\n\u003cp\u003e- Việc luyện tập thể dục của bạn sẽ trở nên thoải mái và dễ dàng hơn bao giờ hết.\u003c/p\u003e\n\u003cp\u003e---------------------\u003c/p\u003e\n\u003cp\u003eCÔNG DỤNG:\u003c/p\u003e\n\u003cp\u003e- Dụng cụ hỗ trợ cho các bài tập mông eo bụng, Mang lại vóc dáng chuẩn, tác động tích cực lên phần vai, eo, mông.\u003c/p\u003e\n\u003cp\u003e- Bài tập cơ bản dành cho eo và bụng: Các bạn lên tham khảo thêm video và hình ảnh.\u003c/p\u003e\n\u003cp\u003e- Ngồi gập người, chân duỗi thẳng về phía trước. Từ từ hạ người về phía sau cho đến khi đầu chạm đến sàn nhà rồi trở lại tư thế ngồi.\u003c/p\u003e\n\u003cp\u003e- Nằm thẳng người trên sàn nhà, chân duỗi thẳng hướng lên trần nhà. Giữ lưng thẳng và cố định trên sàn nhà.\u003c/p\u003e\n\u003cp\u003e- Các bài tập hỗ trợ giúp bạn nhanh chóng lấy lại vòng eo thon gọn, cơ thể săn chắc. Không chỉ thế, những bài tập tổng hợp này còn giúp bạn xua tan cơn nhức mỏi, lưu thông máu huyết, tăng cường sức khỏe và sự dẻo dai cho cơ thể.\u003c/p\u003e\n\u003cp\u003e- Giá thành cạnh tranh phù hợp với mọi nhu cầu khách hàng.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/65/f1/81/0cb4840a63c450bc55df29a9237efe68.jpg\" alt=\"\" width=\"622\" height=\"561\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/b5/68/46/275b9e76109d91f5cc4753238630926d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b5/68/46/275b9e76109d91f5cc4753238630926d.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b5/68/46/275b9e76109d91f5cc4753238630926d.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b5/68/46/275b9e76109d91f5cc4753238630926d.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b5/68/46/275b9e76109d91f5cc4753238630926d.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/0d/52/90/4b3c8d0e87a2767ba9b736347ac253c9.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0d/52/90/4b3c8d0e87a2767ba9b736347ac253c9.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/0d/52/90/4b3c8d0e87a2767ba9b736347ac253c9.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0d/52/90/4b3c8d0e87a2767ba9b736347ac253c9.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0d/52/90/4b3c8d0e87a2767ba9b736347ac253c9.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/f0/7b/61/b53d4969e7728a9c1960732554f641dc.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f0/7b/61/b53d4969e7728a9c1960732554f641dc.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f0/7b/61/b53d4969e7728a9c1960732554f641dc.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f0/7b/61/b53d4969e7728a9c1960732554f641dc.jpg","thumbnail_url":"https://salt.tikicdn.c