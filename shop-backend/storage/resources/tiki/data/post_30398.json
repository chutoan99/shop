ư: màu đen hoặc màu nâu phù hợp với hầu hết cách trang trí và có thể nâng tầm vẻ ngoài của bất kỳ không gian làm việc nào.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/d9/d9/e5/0a6e4b1f8aee2670fb8f6339d4295872.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d9/d9/e5/0a6e4b1f8aee2670fb8f6339d4295872.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d9/d9/e5/0a6e4b1f8aee2670fb8f6339d4295872.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d9/d9/e5/0a6e4b1f8aee2670fb8f6339d4295872.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d9/d9/e5/0a6e4b1f8aee2670fb8f6339d4295872.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/c8/73/6a/2d0718854ce4f28f36cdbcf76d9dc2b9.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c8/73/6a/2d0718854ce4f28f36cdbcf76d9dc2b9.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c8/73/6a/2d0718854ce4f28f36cdbcf76d9dc2b9.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c8/73/6a/2d0718854ce4f28f36cdbcf76d9dc2b9.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c8/73/6a/2d0718854ce4f28f36cdbcf76d9dc2b9.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/74/25/ff/fedd088077da5f8cd0f0b9a81d23d05a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/74/25/ff/fedd088077da5f8cd0f0b9a81d23d05a.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/74/25/ff/fedd088077da5f8cd0f0b9a81d23d05a.jpg","position":null,"sm