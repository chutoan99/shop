iew_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/media/catalog/product/c/h/chuan-bi-cho-be-vao-lop-1.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2754,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: medium; color: #ff6600;\"\u003e\u003cstrong\u003eChuẩn Bị Cho Bé Vào Lớp Một (Túi 5 Cuốn)\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eTủ sách \u003cstrong\u003eChuẩn Bị Cho Bé Vào Lớp Một\u003c/strong\u003e gồm 5 cuốn, được biên soạn nhằm mục đích trang bị một số kỹ năng cơ bản cho các em học sinh mẫu giáo và chuẩn bị vào lớp một. Sách đồng thời cũng là tài liệu tham khảo hữu ích cho các giáo viên và phụ huynh học sinh khi hướng dẫn trẻ học tập ở lớp và ở nhà.\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eSách được biên soạn theo chương trình Giáo dục mầm non được Bộ Giáo dục và Đào tạo ban hành.\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eKhi hướng dẫn trẻ sử dụng sách, thầy cô giáo và các bậc cha mẹ cần chú ý một số điểm sau:\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e- Chọn thời gian phù hợp để trẻ có hứng thú thực hiện các bài tập.\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e- Dạy trẻ nhận biết các chữ cái và đọc đúng âm của chữ đó.\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e- Dạy trẻ học ghép vần, tập đọc.\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e- Dạy trẻ tập tô, tập viết theo mẫu chữ thường nhằm giúp trẻ thực hành khả năng phối hợp mắt, chân tay.\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eVai trò của giáo viên và các bậc phụ huynh trong việc hướng dẫn trẻ thực hành các bài tập trong cuốn sách này rất là quan trọng, vì sẽ từng bước giúp trẻ có được những kỹ năng cần thiết trước khi vào lớp một bậc tiểu học.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/media/catalog/product/c/h/chuan-bi-cho-be-vao-lop-1.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/c/h/chuan-bi-cho-be-vao-lop-1.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/c/h/chuan-bi-cho-be-vao-lop-1.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/c/h/chuan-bi-cho-be-vao-lop-1.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/c/h/chuan-bi-cho-be-vao-lop-1.jpg"}],"warranty_policy":null,"authors":[{"id":17459,"name":"Lê Hồng Đăng","slug":"le-hong-dang"},{"id":17460,"name":"Lê Thị Ngọc Ánh","slug":"le-thi-ngoc-anh"}],"current_seller":{"id":62303,"sku":"7223185665179","name":"Tiệm Sách Minh Vân","link":"https://tiki.vn/cua-hang/tiem-sach-minh-van","logo":"3b/a8/12/9ed725b43ccb5523a205e6c14c8725ad.jpg","price":61500,"product_id":"161912598","store_id":58603,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Thông tin chung","attributes":[{"code":"publisher_vn","name":"Công ty phát hành","value":"Minh Long"},{"code":"publication_date","name":"Ngày xuất bản","value":"2012-06-11 00:00:00"},{"code":"dimensions","name":"Kích thước","value":"17 x 24 cm"},{"code":"book_cover","name":"Loại bìa","value":"Bìa mềm"},{"code":"number_of_pa