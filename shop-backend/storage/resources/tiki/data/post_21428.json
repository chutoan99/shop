l,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":5,"review_text":"(5)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/3c/9b/d4/7c875fe92f3f29eb015a049b2f20f84e.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":896,"all_time_quantity_sold":30,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eKệ gỗ treo tường để chậu cây, hoa, giá gỗ thông treo tường trang trí ban công, ngoại thất đẹp, treo chậu cây, chậu hoa\u003c/p\u003e\n\u003cp\u003eSản phẩm bao gồm 1 hàng rào kích thước 200cmx40cm( 04 tấm liếp 50cmx40cm), 8 thanh ngang kích thước( 40cmx18cm hoặc 40cmx15cm hoặc 40cmx12cm)kèm theo đầy đủ phụ kiện đi kèm.\u003c/p\u003e\n\u003cp\u003eSản phẩm sau khi hoàn thiện được sơn phủ bóng đảm bảo chống ẩm mốc, mối mọt, chịu được mưa, nắng\u003c/p\u003e\n\u003cp\u003eChất liệu: được làm từ gỗ thông cực kỳ bền, đẹp và nhẹ, thân thiện với môi trường\u003c/p\u003e\n\u003cp\u003eCÔNG DỤNG:\u003c/p\u003e\n\u003cp\u003e- Kệ gỗ dùng để trang trí, để các đồ lưu niệm, phụ kiện, chậu hoa, chậu cây ban công\u003c/p\u003e\n\u003cp\u003eHƯỚNG DẪN SỬ DỤNG:\u003c/p\u003e\n\u003cp\u003e - Sản phẩm tự lắp ráp, nguyên kiện bao gồm bộ dụng cụ lắp ráp, hình ảnh \u0026amp; Video hướng dẫn sử dụng.\u003c/p\u003e\n\u003cp\u003e- Hạn chế tiếp xúc với ánh nắng mặt trời, nơi ẩm ướt. Sử dụng các chất tẩy rửa chuyên dụng để không làm mất độ thẩm mỹ của gỗ.\u003c/p\u003e\n\u003cp\u003eGHI CHÚ: Sản phẩm chỉ bao gồm kệ gỗ, phụ kiện vít, nở nhựa ( không bao gồm các đồ dùng trang trí).\u003c/p\u003e\n\u003cp\u003eCÁCH LẮP:\u003c/p\u003e\n\u003cp\u003e- Bước 1: ướm kệ lên vị trí muốn lắp đặt, đánh dấu vị trí 2 lỗ khoan\u003c/p\u003e\n\u003cp\u003e- Bước 2: Khoan 2 lỗ vào vị trí đã đánh dấu, đóng nở vào 2 lỗ khoan\u003c/p\u003e\n\u003cp\u003e- Bước 3: đóng 2 thanh ren vào 2 nở(đóng ngập 1/3 thanh ren)\u003c/p\u003e\n\u003cp\u003e- Bước 4: xỏ kệ vào 2/3 thanh ren còn lại\u003c/p\u003e\n\u003cp\u003eGHI CHÚ: Sản phẩm là bộ kệ gỗ treo tường + phụ kiện vít, nở nhựa để lắp đặt\u003c/p\u003e\n\u003cp\u003eCHÍNH SÁCH BẢO HÀNH:\u003c/p\u003e\n\u003cp\u003e- Bảo hành 1 đổi 1 miễn phí trong vòng 7 ngày nếu sản phẩm có lỗi kĩ thuật.\u003c/p\u003e\n\u003cp\u003e- Bảo hành chất lượng sản phẩm 12 tháng.\u003c/p\u003e\n\u003cp\u003e- Chăm sóc \u0026amp; tư vấn trọn đời.\u003c/p\u003e\n\u003cp\u003eMẸO QUAN TRỌNG: - Hãy quay video lúc mở sản phẩm để đảm bảo quyền lợi KH khi có sự cố phải đổi trả.\u003c/p\u003e\n\u003cp\u003e- Hãy để lại vài lời đánh giá chân thành về chất lượng sản phẩm/dịch vụ để được nhận thêm ƯU ĐÃI.\u003c/p\u003e\n\u003cp\u003e* Tổng kích thước kệ gỗ treo ban công:\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/8a/b4/0d/65d7161b3dfdabe4bd9630f22780cbe4.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e* Kích thước kệ gỗ thanh ngang:\u003c/p\u003e\n\u003cp\u003e1. Kệ gỗ thanh ngang 40cmx18cm\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/8b/bb/1a/6efbae9d50fcd89123cafd0cf2344f81.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e2. Kệ gỗ thanh ngang 40cmx15cm\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/42/84/e4/a7b0eee482e264a9b56620563c33224f.jpg\" 