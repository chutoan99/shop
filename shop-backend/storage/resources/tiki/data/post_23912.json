_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":3,"review_text":"(3)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/aa/67/50/1ed04822db131322de3b2fb5ca409145.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1038,"all_time_quantity_sold":15,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch1\u003eVới sự phát triển của xã hội hiện đại ngày nay việc làm đẹp và chăm sóc da của các chị em rất được quan tâm. Bởi một phần do tác động của tự nhiên khi không khí ngày một ô nhiễm. Hay công việc gặp đối tác trong công việc cần phải chỉnh chu hơn về ngoại hình vì đó sẽ là một phần nhỏ để được một cái nhìn chuyên nghiệp hơn hay giúp các chị em tự tin hơn trong công việc cũng như đời sống thường ngày.\u003c/h1\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/8f/64/94/613e18e4290c6a4cf4ede93f70edaf76.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch1\u003eNhưng do các tác động xấu từ bên ngoài ảnh hưởng khá nhiều đến làn da của chị em. Do sở hưu một làn da nhạy cảm lại thường xuyên bị ảnh hưởng do ô nghiễm không khí ở đô thị. Khiến làn da của chị em bị lão hóa nhanh tróng, các nết nhăn bắt đầu xuất hiện ngày càng nhiều và gây khô da khiến làn da mất đi sự mịn màng vốn có.\u003c/h1\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/c8/dd/3a/a7c2b76ddb9ec119013110a589d313b1.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch1\u003eHãy sử dụng dạng sảm phẩm Goodndoc Snail Ultra Moisture Cream. Một dòng sảm phẩm bắt nguồn từ Hàn Quốc một đất nước xinh đẹp và nổi tiếng với các sảm phẩm làm đẹp chất lượng.\u003c/h1\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/aa/67/50/0a9391b90aad52c22f1ae1ec720f6944.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch1\u003e\u003cstrong\u003eTác dụng của Goodndoc Snail Ultra Moisture Cream\u003c/strong\u003e\u003c/h1\u003e\n\u003ch1\u003eSảm phẩm có thành phần chính từ dịch nhầy của ốc sên chiếm 67,69%. Một loại dưỡng chất chứa nhiều Hyaluronic acid được kiểm định là rất tốt cho làn da, khiến cho nàn da có thể hồi phục do sẹo xóa sạch các vết thâm do mụn và các nết nhăn, hồi phục làn da nhanh tróng.\u003c/h1\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/9f/5c/64/31735ebeef58f85b9aa22fb9a800530b.jpg\" alt=\"\" width=\"640\" height=\"640\" /\u003e\u003c/p\u003e\n\u003ch1\u003eĐồng thời Snail Ultra Moisture Cream còn giúp dưỡng ẩm cho da rất tốt. Kích thích quá trình tăng collagen cho da khỏe mạnh và căng tràn sức sống.\u003c/h1\u003e\n\u003ch1\u003e\u003cstrong\u003eHướng dẫn sử dụng\u003c/strong\u003e\u003c/h1\u003e\n\u003col\u003e\n\u003cli\u003e\n\u003ch1\u003eHãy vệ sinh da tay thật kĩ bằng nước nóng\u003c/h1\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003ch1\u003eSau đó chấm một lượng kem vừa đủ lên chán, 2 bên má và cằm.\u003c/h1\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003ch1\u003ethoa đều và massage nhẹ nhàng.\u003c/h1\u003e\n\u003c/li\u003e\n\u003c/ol\u003e\n\u003ch1\u003e \u003c/h1\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/aa/67/50/1ed04822db131322de3b2fb5ca409145.jpg","is_gallery":true,"label":null,"la