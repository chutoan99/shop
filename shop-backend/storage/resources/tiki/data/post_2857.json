d_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.8,"review_count":9,"review_text":"(9)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/17/2e/5c/ede3b9394ed35df0aac9aa9509ec76cb.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1999,"all_time_quantity_sold":76,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch1 id=\"product-name\" class=\"item-name\" style=\"box-sizing: border-box; margin: 16px 0px 5px; font-family: Roboto, Helvetica, Arial, sans-serif; font-weight: 300; line-height: 30px; color: #333333; font-size: 24px;\"\u003e\u003cstrong\u003eKem Đánh Răng Aquafresh Hương Chanh- Nội Địa Nhật Bản\u003c/strong\u003e\u003c/h1\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/67/42/65/2fd087aad7bf520475ab9e4da265cfe7.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eXuất xứ :\u003c/strong\u003e Nhật Bản.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTrọng lượng :\u003c/strong\u003e 160g\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCông dụng: \u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eGiúp làm sạch răng\u003c/p\u003e\n\u003cp\u003eNgăn ngừa sâu răng\u003c/p\u003e\n\u003cp\u003eGiúp răng chắc khỏe và sáng bóng\u003c/p\u003e\n\u003cp\u003eCông thức bảo vệ độc quyền với 3 hoạt chất với tỷ lệ flo cao, thâm nhập sâu vào bề mặt men răng giúp răng chắc khỏe.\u003c/p\u003e\n\u003cp\u003eKem đánh răng bổ sung các khoáng chất cần thiết để ngăn chặn sự xói mòn của răng do axit.\u003c/p\u003e\n\u003cp\u003eGiúp chăm sóc và bảo vệ răng miệng, cho bạn hàm răng chắc khỏe, trắng sáng.\u003c/p\u003e\n\u003cp\u003eKem có vị nhẹ dịu, hương bạc hà dễ chịu mang đến cho bạn hơi thở thơm tho để luôn tự tin trong giao tiếp.\u003c/p\u003e\n\u003cp\u003eKhi bạn bắt đầu đánh răng, các sọc đậm nhưng chóng biến thành bọt vi hoạt động giúp làm trắng, ngăn ngừa sâu răng, hôi miệng, làm sạch toàn bộ khoang miệng và tiêu diệt vi khuẩn ở những nơi bàn chải không đến được, thậm chí cả mặt sau của lưỡi.\u003c/p\u003e\n\u003cp\u003eCho bạn cảm giác sạch sẽ, hơi thở thơm mát dài lâu và hàm răng trắng bóng, chắc khoẻ.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eHướng dẫn sử dụng\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eChải sạch răng với kem đánh răng Aquafresh sau mỗi bữa ăn, ít nhất 2 lần một ngày để bảo vệ răng tối ưu.\u003c/p\u003e\n\u003cp\u003eTrẻ dưới 2 tuổi nên tham khảo sự chỉ định của nha sĩ hoặc bác sĩ.\u003c/p\u003e\n\u003cp\u003eTrẻ em dưới 6 tuổi chỉ sử dụng một lượng kem nhỏ bằng hạt đậu và phải có sự giám sát của người lớn.\u003c/p\u003e\n\u003cp\u003eTrong trường hợp nuốt phải cần tham khảo ngay ý kiến của bác sĩ hoặc nha sĩ. Để sản phẩm xa tầm tay với của trẻ em.\u003c/p\u003e\n\u003cp\u003eĐể xa tầm tay trẻ em dưới 6 tuổi.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eNhập khẩu trực tiếp từ Nhật. Sản xuất tại Nhật. Sản phẩm đảm bảo tiêu chuẩn chất lượng Nhật Bản\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/17/2e/5c/ede3b9394ed35df0aac9aa9509ec76cb.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200