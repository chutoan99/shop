ight":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.8,"review_count":16,"review_text":"(16)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/83/5e/cd/50868101f726daff29d9f0f8f035217e.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1659,"all_time_quantity_sold":78,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<h1><em><strong>Giới thiệu Ống tay thun lạnh co giãn 4 chiều chống nắng và tia UV 3M PS2000</strong></em></h1>\n<p><em><strong>Ống tay thun lạnh co giãn 4 chiều chống nắng và tia UV 3M PS2000</strong></em> co giãn tốt, rất thích hợp cho các hoạt động ngoài trời cũng như dùng để che nắng rất tiện lợi, có độ đàn hồi và co giãn tốt, vô cùng thoải mái và dễ chịu kể cả khi sử dụng lâu.</p>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/07/0f/bd/ba38a07712148da1afb6df798c5d9f3f.jpg?v=1581664596967\" data-thumb=\"original\" /></p>\n<h2><strong>Thông tin sản phẩm</strong></h2>\n<ul>\n<li>Tên sản phẩm: <em><strong>Ống tay thun lạnh co giãn 4 chiều chống nắng và tia UV 3M PS2000</strong></em></li>\n<li>Mã sản phẩm: <em><strong>PS2000</strong></em></li>\n<li><strong>Thương hiệu: 3M</strong></li>\n<li><strong>Sản xuất: tại Hàn Quốc</strong></li>\n<li>Công dụng: Chống nắng, chống tia UV</li>\n<li>Kích thước: Free Size</li>\n<li>Thành phần: Thun lạnh co giãn 4 chiều (Nylon 90%, Polyurethane 10%)</li>\n<li>Hạn sử dụng: 5 Năm</li>\n</ul>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/eb/7b/29/4f136e592b8ec83ce67746f2a7950f48.jpg?v=1581664607221\" data-thumb=\"original\" /></p>\n<h2><strong>Thông tin nổi bật</strong></h2>\n<ul>\n<li>Công nghệ Mipan Aqua-X độc quyền của Hàn Quốc tạo cảm giác mát mẻ khi mang.</li>\n<li>Sợi vải có khả năng hút ẩm cao và khô nhanh chóng</li>\n<li>Bảo vệ đôi tay khỏi ánh nắng mặt trời khi tham gia các hoạt động như chơi thể thao.</li>\n<li>Form ôm sát cánh tay vừa vặn đem tới phong cách trẻ trung, cá tính cho người dùng, tạo cảm giác cực thoải mái khi sử dụng.</li>\n<li>Chống các tác nhân gây hại như tia cực tím, tia UV của mặt trời, ngăn chặn tia UVA (gây lão hóa da) và tia UVB, giảm thiểu cảm giác nóng rát khi hoạt động hoặc di chuyển lâu dưới trời nắng.</li>\n</ul>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/eb/9d/ec/cc736fa467c9de1875d3a4d80feed4e4.jpg?v=1581664615301\" data-thumb=\"original\" /></p>\n<h2><strong>Hướng dẫn giặt</strong></h2>\n<p>Giặt máy, nước mát, sấy thông thường, nhiệt độ thấp, không dùng thuốc tẩy, không giặt khô.</p>\n<p> </p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/83/5e/cd/50868101f726daff29d9f0f8f035217e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/83/5e/cd/50868101f726daff29d9f0f8f035217e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/83/5e/cd/50868101f726daff29d9f0f8f035217e.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/83/5e/cd/50868101f7