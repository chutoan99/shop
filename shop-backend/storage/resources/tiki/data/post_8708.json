71483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/e2/e5/9b/35250e3b0272fabb13c35eb38ae2b1b7.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":322,"all_time_quantity_sold":29,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cdiv class=\"pdp-block pdp-section\" style=\"margin:10px 0px 0px;padding:0px;background-color:#ffffff;color:#333333;font-family:'system-ui', '-apple-system', BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;font-size:12px;font-style:normal;font-weight:400;letter-spacing:normal;text-indent:0px;text-transform:none;white-space:normal;word-spacing:0px;\"\u003e\n\u003cdiv class=\"pdp-block module\" style=\"margin:0px;padding:0px;\"\u003e\n\u003cdiv class=\"lazyload-wrapper\" style=\"margin:0px;padding:0px;\"\u003e\n\u003cdiv class=\"pdp-product-desc\" style=\"margin:0px 0px 14px;padding:0px;background-color:#ffffff;\"\u003e\n\u003cdiv class=\"pdp-product-desc-inner\" style=\"margin:0px;padding:12px 14px;\"\u003e\n\u003cdiv class=\"pdp-long-description\" style=\"margin:0px;padding:0px;\"\u003e\n\u003cdiv style=\"margin:0px;padding:0px;\"\u003e\n\u003cp style=\"margin:0px;padding:0px;line-height:25px;\"\u003eTERTIUM ORGANUM (ĐỆ TAM CẤU THỨC LUẬN – CHÌA KHÓA VÀO HUYỀN NHIỆM VŨ TRỤ): MỘT TRONG NHỮNG CUỐN SÁCH TRIẾT HỌC-HUYỀN HỌC VĨ ĐẠI NHẤT MỌI THỜI\u003c/p\u003e\n\u003cp style=\"margin:0px;padding:0px;line-height:25px;\"\u003eĐạo sư Osho từng nói về cuốn sách Tertium Organum (Đệ Tam Cấu Thức Luận – Chìa Khóa Vào Huyền Nhiệm Vũ Trụ): “Đó là một trong những cuốn sách vĩ đại nhất trong bất kỳ ngôn ngữ nào trên thế giới”.\u003c/p\u003e\n\u003cp style=\"margin:0px;padding:0px;line-height:25px;\"\u003eThời sinh viên, Osho từng dốc hết tiền túi và nhịn đói nhiều ngày, thậm chí còn bị đuổi khỏi nhà trọ chỉ để mua được cuốn sách này: “tôi đã trả cho người bán sách toàn bộ số tiền lương của tôi. Bạn khó mà hiểu được, vì cuốn sách đó mà tôi phải đói ăn cả tháng. Nhưng điều đó thật xứng đáng. Tôi nhớ rằng đó là một tháng tuyệt vời: không thực phẩm, không quần áo – thậm chí không nơi trú ngụ; bởi vì tôi không thể trả tiền thuê phòng trọ, tôi bị đuổi ra khỏi căn phòng trọ tồi tàn của mình. Nhưng tôi lại vui sướng với Tertium Organum dưới bầu trời. Tôi đọc cuốn sách đó dưới ánh đèn đường – tôi thú thật như vậy – và tôi đã sống với cuốn sách đó. Cuốn sách đó quá tuyệt vời” (trích Những Cuốn Sách Tôi Yêu).\u003c/p\u003e\n\u003cp style=\"margin:0px;padding:0px;line-height:25px;\"\u003eĐây là quyển sách cải biến toàn bộ nhận thức. Organum của Aristotle trình bày những quy luật dưới sự suy tư của chủ thể; quyển Organum thứ hai của Bacon đề cập đến những quy luật của cái mà chủ thể có thể tri nhận được; nhưng thậm chí bản Organum thứ ba còn xuất hiện trước cả hai quyển trên; và cần lưu ý rằng những quy luật của nó không biện hộ cho sự xúc phạm ấy. Tertium Organum sẽ dẫn lối và chi phối tư tưởng nhân loại từ nay về sau.\u003c/p\u003e\n\u003cp style=\"margin:0px;padding:0px;line-height:25px;\"\u003e“Theo một quan điểm nào đó, đây là một quyển sách hãi hùng - hãi hùng vì trong nó là sức công phá của cuộc cách mạng - cuộc cách mạng của mỗi cực tư tưởng. Và nó sẽ tước đoạt những ảo tưởng trìu mến, cắt lìa mặt đất dưới chân ta. Nó kí thác cho Hố thẳm. Nó là kẻ hủy diệt vĩ đại, kẻ hủy diệt lòng tự mãn. Vâng! Đây là một quyển sách nguy hiểm - và sau nữa, đời phải là như thế.” (Claude Bragdon)\u003c/p\u003e\n\u003cp style=\"margin:0px;padding:0px;line-height:25px;\"\u003eVỀ TÁC GIẢ:\u003c/p\u003e\n\u003cp style=\"margin:0px;padding:0px;line-height:25px;\"\u003ePeter D. Ouspensky (1878 - 1947) là một triết gia, nhà huyền môn người Nga nổi tiếng với những giải thích về lời dạy của bậc thầy huyền môn người Hy Lạp-Armenia là George Gurdjieff.\u003c/p\u003e\n\u003cp style=\"margin:0px;padding:0px;line-height:25px;\"\u003e- Nhà xuất bản Đà Nẵng\u003c/p\u003e\n\u003cp style=\"margin:0px;padding:0px;line-height:25px;\"\u003e- Dịch giả: Võ Quốc Việt\u003c/p\u003e\n\u003cp style=\"margin:0px;padding:0px;line-height:25px;\"\u003e- Kích thước: 15,5 x 23,5 cm\u003c/p\u003e\n\u003cp style=\"margin:0px;padding:0px;line-height:25px;\"\u003e- Hình thức: Bìa mềm\u003c/p\u003e\n\u003cp style=\"margin:0px;padding:0px;line-height:25px;\"\u003e- Số trang: 580 trang\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"pdp-block pdp-section\" style=\"margin:10px 0px 0px;padding:0px;background-color:#ffffff;color:#333333;font-family:'system-ui', '-apple-system', BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;font-size:12px;font-style:normal;font-weight:400;letter-spacing:normal;text-indent:0px;text-transform:none;white-space:normal;word-spacing:0px;\"\u003e\n\u003cdiv class=\"pdp-block module\" style=\"margin:0px;padding:0px;\"\u003e\n\u003cdiv class=\"lazyload-wrapper\" style=\"margin:0px;padding:0px;\"\u003e \u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"pdp-block module\" style=\"margin:0px;padding:0px;color:#333333;font-family:'system-ui', '-apple-system', BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;font-size:12px;font-style:normal;font-weight:400;letter-spacing:normal;text-indent:0px;text-transform:none;white-space:normal;word-spacing:0px;background-color:#f8f8f8;\"\u003e\n\u003cdiv class=\"lazyload-wrapper\" style=\"marg