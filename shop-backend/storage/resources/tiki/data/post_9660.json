f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":69300,"discount_rate":35,"rating_average":5,"review_count":4,"review_text":"(4)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/74/d5/77/d58aeed322b6f056167b3912aaa07b53.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":762,"all_time_quantity_sold":47,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2\u003e\u003cspan class=\"ez-toc-section\"\u003e\u003cstrong\u003eGiới thiệu sách Chinh phục toàn diện Ngữ pháp tiếng Anh bằng Infographic\u003c/strong\u003e\u003c/span\u003e\u003c/h2\u003e\n\u003cp\u003eChinh phục toàn diện ngữ pháp tiếng Anh bằng Infographic là bộ sách đầu tiên gói gọn 20 chuyên đề ngữ pháp tiếng Anh thông qua các hình ảnh trực quan. Các bài học được thể hiện bằng nhiều hình ảnh, sơ đồ, màu sắc bắt mắt làm kích thích khả năng tiếp thu của não bộ, mang lại cảm hứng học tập tích cực, giúp bạn tiết kiệm tối đa thời gian.\u003c/p\u003e\n\u003cp\u003eSách gồm 20 chuyên đề ngữ pháp được chia thành 2 phần kiến thức cơ bản và kiến thức nâng cao để các bạn dễ dàng tiếp cận, chọn lọc theo nhu cầu, đạt được kết quả mong muốn.\u003c/p\u003e\n\u003cp\u003eSau mỗi một chuyên đề sẽ có hệ thống bài tập tự luyện đi kèm, cũng được chia thành hai mức độ cơ bản và nâng cao.\u003c/p\u003e\n\u003cp\u003eCuối sách sẽ có thêm phần phụ lục bao gồm:\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eBảng phiên âm quốc tế.\u003c/li\u003e\n\u003cli\u003eBảng động từ bất quy tắc.\u003c/li\u003e\n\u003cli\u003eBảng tục ngữ tiếng Anh.\u003c/li\u003e\n\u003cli\u003eBảng cụm từ kết hợp thường gặp trong tiếng Anh.\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eChinh phục toàn diện ngữ pháp tiếng Anh bằng Infographic chính là người bạn đồng hành không thể thiếu của bạn trước những kì thi hay trong công việc.\u003c/p\u003e\n\u003ch2\u003e\u003cspan class=\"ez-toc-section\"\u003e\u003cstrong\u003eNội dung sách Chinh phục toàn diện Ngữ pháp tiếng Anh bằng Infographic – Tập 1\u003c/strong\u003e\u003c/span\u003e\u003c/h2\u003e\n\u003cp\u003eChinh phục Ngữ pháp tiếng Anh bằng Infographic Tập 1 có 10 chuyên đề bao gồm:\u003c/p\u003e\n\u003cp\u003e1- Nouns: Danh từ\u003c/p\u003e\n\u003cp\u003e2- Pronouns : Đại từ.\u003c/p\u003e\n\u003cp\u003e3- Adjectives: Tính từ.\u003c/p\u003e\n\u003cp\u003e4- Articles: Mạo từ.\u003c/p\u003e\n\u003cp\u003e5- Tense: Các thì trong tiếng Anh.\u003c/p\u003e\n\u003cp\u003e6- Modal verbs: Động từ khuyết thiếu.\u003c/p\u003e\n\u003cp\u003e7-Gerund \u0026amp; Infinitives: Danh động từ \u0026amp; động từ nguyên thể.\u003c/p\u003e\n\u003cp\u003e8- Adverbs: Trạng từ.\u003c/p\u003e\n\u003cp\u003e9- Comparisons : So sánh.\u003c/p\u003e\n\u003cp\u003e10- Prepositions: Giới từ.\u003c/p\u003e\n\u003cp\u003e11- Key \u0026amp; Explanation: Đáp án \u0026amp; giải thích\u003c/p\u003e\n\u003ch2\u003e\u003cspan class=\"ez-toc-section\"\u003e\u003cstrong\u003eNội dung sách Chinh phục toàn diện Ngữ pháp tiếng Anh bằng Infographic – Tập 2\u003c/strong\u003e\u003c/span\u003e\u003c/h2\u003e\n\u003cp\u003eCấu trúc cuốn sách Chinh phục toàn diện ngữ pháp tiếng Anh bằng Infographic tập 2 gồm 3 phần:\u003c/p\u003e\n\u003ch3\u003e\u003cspan class=\"ez-toc-section\"\u003e\u003cem\u003e\u003cstrong\u003ePhần 1: Lý thuyết và bài tập: chia thành 10 chuyên đề:\u003c/strong\u003e\u003c/em\u003e\u003c/span\u003e\u003c/h3\u003e\n\u003cul\u003e\u003cli\u003eCụm động từ\u003c/li\u003e\n\u003cli\u003eThể bị động\u003c/li\u003e\n\u003cli\u003eLiên từ\u003c/li\u003e\n\u003cli\u003eSự hòa hợp giữa chủ ngữ \u0026amp; động từ\u003c/li\u003e\n\u003cli\u003eGiả định thức\u003c/li\u003e\n\u003cli\u003eCâu gián tiếp\u003c/li\u003e\n\u003cli\u003eMệnh đề\u003c/li\u003e\n\u003cli\u003eĐảo ngữ\u003c/li\u003e\n\u003cli\u003eCâu hỏi\u003c/li\u003e\n\u003cli\u003eCấu tạo từ\u003c/li\u003e\n\u003c/ul\u003e\u003ch3\u003e\u003cspan class=\"ez-toc-section\"\u003e\u003cem\u003e\u003cstrong\u003ePhần 2: Phụ lục: Trình bày các nội dung thường cần tra cứu trong quá trình học tiếng Anh:\u003c/strong\u003e\u003c/em\u003e\u003c/span\u003e\u003c/h3\u003e\n\u003cul\u003e\u003cli\u003eBảng phiên âm quốc tế\u003c/li\u003e\n\u003cli\u003eBảng động từ bất quy tắc\u003c/li\u003e\n\u003cli\u003eTục ngữ thường dùng\u003c/li\u003e\n\u003cli\u003eCụm từ kết hợp thường dùng\u003c/li\u003e\n\u003c/ul\u003e\u003ch3\u003e\u003cspan class=\"ez-toc-section\"\u003e\u003cem\u003e\u003cstrong\u003ePhần 3: Đáp án \u0026amp; giải thích: trình bày đáp án, dịch nghĩa, phân tích và giải thích chi tiết.\u003c/strong\u003e\u003c/em\u003e\u003c/span\u003e\u003c/h3\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/74/d5/77/d58aeed322b6f056167b3912aaa07b53.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/74/d5/77/d58aeed322b6f056167b3912aaa07b53.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/74/d5/77/d58aeed322b6f056167b3912aaa07b53.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/74/d5/77/d58aeed322b6f056167b3912aaa07b53.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/74/d5/77/d58aeed322b6f056167b3912aaa07b53.png"},{"base_url":"http