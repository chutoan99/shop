b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":4,"review_text":"(4)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/8a/7b/e0/124e24a121b5c483408e831005ffc96a.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":281,"all_time_quantity_sold":62,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"margin:0px;padding:0px;line-height:25px;color:#333333;font-family:'system-ui', '-apple-system', BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;font-size:12px;font-style:normal;font-weight:400;letter-spacing:normal;text-indent:0px;text-transform:none;white-space:normal;word-spacing:0px;background-color:#ffffff;\"\u003e“Ý THỨC LÀ TẤT CẢ” – SỰ THẬT HUY HOÀNG VỀ CHÍNH BẢN THÂN BẠN: CUỐN SÁCH KINH ĐIỂN VỀ Ý THỨC VÀ TÁNH BIẾT\u003c/p\u003e\n\u003cp style=\"margin:0px;padding:0px;line-height:25px;color:#333333;font-family:'system-ui', '-apple-system', BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;font-size:12px;font-style:normal;font-weight:400;letter-spacing:normal;text-indent:0px;text-transform:none;white-space:normal;word-spacing:0px;background-color:#ffffff;\"\u003e“Ý Thức Là Tất Cả” trình bầy cái Thấy của một người từ bên trong nhìn ra, từ bỉ ngạn nhìn về. Đây là một báu vật cho các nhà Duy Thức học Đông Phương, là một ngạc nhiên đầy sửng sốt cho các nhà Tâm Lý học Tây Phương, và là nước cam lồ cho những ai khát khao tìm cầu Chân Lý.\u003c/p\u003e\n\u003cp style=\"margin:0px;padding:0px;line-height:25px;color:#333333;font-family:'system-ui', '-apple-system', BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;font-size:12px;font-style:normal;font-weight:400;letter-spacing:normal;text-indent:0px;text-transform:none;white-space:normal;word-spacing:0px;background-color:#ffffff;\"\u003e \u003c/p\u003e\n\u003cp style=\"margin:0px;padding:0px;line-height:25px;color:#333333;font-family:'system-ui', '-apple-system', BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;font-size:12px;font-style:normal;font-weight:400;letter-spacing:normal;text-indent:0px;text-transform:none;white-space:normal;word-spacing:0px;background-color:#ffffff;\"\u003eBằng một loại ngôn ngữ rất đời thường và một phong cách hiện đại, tác giả đã đưa cái Hiểu đến với mọi người dù trình độ nhận thức khác nhau. Với một bút pháp sắc sảo và những lập luận sắc bén, Peter Francis Dziuban đã đâm toạc tấm màn vô minh, cho chúng ta thấy rõ Sự Thật Cuối Cùng không thể phủ nhận: Ý Thức là Chính TA.\u003c/p\u003e\n\u003cp style=\"margin:0px;padding:0px;line-height:25px;color:#333333;font-family:'system-ui', '-apple-system', BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;font-size:12px;font-style:normal;font-weight:400;letter-spacing:normal;text-indent:0px;text-transform:none;white-space:normal;word-spacing:0px;background-color:#ffffff;\"\u003e \u003c/p\u003e\n\u003cp style=\"margin:0px;padding:0px;line-height:25px;color:#333333;font-family:'system-ui', '-apple-system', BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;font-size:12px;font-style:normal;font-weight:400;letter-spacing:normal;text-indent:0px;text-transform:none;white-space:normal;word-spacing:0px;background-color:#ffffff;\"\u003eChân thành chia sẻ và phổ biến đến những ai đang lặn lội đi tìm cái TA đích thực của chính mình.” (Người dịch)\u003c/p\u003e\n\u003cp style=\"margin:0px;padding:0px;line-height:25px;color:#333333;font-family:'system-ui', '-apple-system', BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;font-size:12px;font-style:normal;font-weight:400;letter-spacing:normal;text-indent:0px;text-transform:none;white-space:normal;word-spacing:0px;background-color:#ffffff;\"\u003eVỀ TÁC GIẢ:\u003c/p\u003e\n\u003cp style=\"margin:0px;padding:0px;line-height:25px;color:#333333;font-family:'system-ui', '-apple-system', BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;font-size:12px;font-style:normal;font-weight:400;letter-spacing:normal;text-indent:0px;text-transform:none;white-space:normal;word-spacing:0px;background-color:#ffffff;\"\u003ePeter Francis Dziuban (phát âm là Jubin) là tác giả và cũng là diễn giả về Ý Thức, Tánh Biết và tâm linh. Ông bắt đầu quan tâm đến tâm linh và triết học khi còn là sinh viên trường Đại Học Notre Dame thành phố South Bend, Tiểu bang Indiana, Hoa Kỳ. Peter Francis Dziuban biết đến Thực Tại Tuyệt Đối qua các tác phẩm của Tiến Sĩ Alfred Aiken, người đã viết rất nhiều sách về Ý Thức hay Thực Tại.\u003c/p\u003e\n\u003cp style=\"margin:0px;padding:0px;line-height:25px;color:#333333;font-family:'system-ui', '-apple-system', BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;font-size:12px;font-style:normal;font-weight:400;letter-spacing:normal;text-indent:0px;text-transform:none;white-space:normal;word-spacing:0px;background-color:#ffffff;\"\u003eSau đó ông nghiên cứu rất nhiều giáo pháp tâm linh và huyền bí của các truyền thống Đông Phương lẫn Thiên Chúa Giáo. Tác phẩm đầu tay của Peter, Ý Thức là Tất Cả, và những trước tác khác của ông là kết quả của công trình nghiên cứu sâu rộng về chủ đề này. Các bài viết của ông thiên về kinh nghiệm chủ nghĩa, giúp người đọc có thể tự chứng nghiệm cho chính mình. Ông thuyết giảng khắp nước Mỹ. Các khóa hội thảo chuyên đề và ẩn tu do ông tổ chức chủ yếu là về tánh biết - nhưng không phải như một khái niệm hay lý thuyết suông - mà là thực chứng.\u003c/p\u003e\n\u003cp style=\"margin:0px;padding:0px;line-height:25px;color:#333333;font-family:'system-ui', '-apple-system', BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;font-size:12px;font-style:normal;font-weight:400;letter-spacing:normal;text-indent:0px;text-transform:none;white-space:normal;word-spacing:0px;background-color:#ffffff;\"\u003e- Nhà xuất bản Hồng Đức\u003c/p\u003e\n\u003cp style=\"margin:0px;padding:0px;line-height:25px;color:#333333;font-family:'system-ui', '-apple-system', BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;font-size:12px;font-style:normal;font-weight:400;letter-spacing:normal;text-indent:0px;text-transform:none;white-space:normal;word-spacing:0px;background-color:#ffffff;\"\u003e- Tác giả: Peter Francis Dziuban\u003c/p\u003e\n\u003cp style=\"margin:0px;padding:0px;line-height:25px;color:#333333;font-family:'system-ui', '-apple-system', BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;font-size:12px;font-style:normal;font-weight:400;letter-spacing:normal;text-indent:0px;text-transform:none;white-space:normal;word-spacing:0px;background-color:#ffffff;\"\u003e- Dịch giả: Vũ Toàn\u003c/p\u003e\n\u003cp style=\"margin:0px;padding:0px;line-height:25px;color:#333333;font-family:'system-ui', '-apple-system', BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;font-size:12px;font-style:normal;font-weight:400;letter-spacing:normal;text-indent:0px;text-transform:none;white-space:normal;word-spacing:0px;background-color:#ffffff;\"\u003e- Kích thước: 15.5 x 23.5cm\u003c/p\u003e\n\u003cp style=\"margin:0px;padding:0px;line-height:25px;color:#333333;font-family:'system-ui', '-apple-system', BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;font-size:12px;font-style:normal;font-weight:400;letter-spacing:normal;text-indent:0px;text-transform:none;white-space:normal;word-spacing:0px;background-color:#ffffff;\"\u003e- Hình thức: Bìa mềm\u003c/p\u003e\n\u003cp style=\"margin:0px;padding:0px;line-height:25px;color:#333333;font-family:'system-ui', '-apple-system', BlinkMacSystemFont, 'Helv