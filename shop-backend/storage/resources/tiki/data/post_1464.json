r":"#D93843","href":null,"text":"9.9"},{"placement":"pdp_badge","code":"is_hero","type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":true,"return_reason":"any_reason"}},"discount":91000,"discount_rate":9,"rating_average":3.3,"review_count":3,"review_text":"(3)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/c8/93/16/c160ff1caeba2b69d20eb90edf769b93.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1230,"all_time_quantity_sold":9,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eMàng Lọc Chuyên Sâu 3in1 Máy Lọc Không Khí Nagakawa NAG3501M - Hàng Chính Hãng\u003c/strong\u003e được tích hợp cùng Màng lọc 3 trong 1 cho hiệu suất lọc được tốt hơn. Tuy nhiên trong quá trình sử dụng, màng lọc hoạt động hiệu quả và thường xuyên sẽ cần được thay thế để đảm bảo không khí luôn được trong lành và nâng cao độ bền, hoạt động của máy.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eBộ lọc 3 trong 1 chuyên sâu\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eBộ lọc tích hợp 3 trong 1 (hepa, kháng khuẩn, than hoạt tính) là 3 trong 5 bước lọc của máy lọc không khí NAG3501M với các màng lọc và vai trò khác nhau:\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eMàng lọc kháng khuẩn (Anti-bacterial), có tác dụng lọc, loại bỏ những loại bụi bẩn có kích thước lớn, lông động vật, hạt bụi to và phân lập các vi khuẩn, viruss…\u003c/li\u003e\n\u003cli\u003eMàng lọc HEPA H11, loại bỏ các hạt ô nhiễm trong không khí như khói bụi mịn và các hạt bụi siêu mịn, giúp loại bỏ đến 97% các hạt bụi nhỏ lên đến 0.3μm cho không khí thêm trong lành đảm bảo sức khỏe cho người sử dụng.\u003c/li\u003e\n\u003cli\u003eMàng lọc than hoạt tính (Carbon filter), khử mùi hôi và loại bỏ nhanh chóng các khí độc hại.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eBảo trì và thay thế dễ dàng\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eViệc bảo trì trở nên đơn giản, nhanh chóng mà không cần dịch chuyển khỏi tường với NAG3501M. Không cần đến chuyên gia tháo lắp, bạn có thể dễ dàng tháo rời, thay thế, vệ sinh phần ốp phía trước và bộ lọc 3 trong 1.\u003c/p\u003e\n\u003cp\u003eBộ lọc 3 trong 1 được khuyến nghị khoảng 9-12 tháng/lần tuỳ thuộc vào tần suất sử dụng và chất lượng không khí tại khu vực thiết bị làm việc dựa vào cảnh báo bằng cách để ý đèn tình trạng bộ lọc.\u003c/p\u003e\n\u003cp\u003eKhi vệ sinh, bảo trì máy cần lưu ý các điểm sau:\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eTắt máy và rút phích cắm khỏi ổ điện trước và trong khi tiến hành vệ sinh máy lọc không khí.\u003c/li\u003e\n\u003cli\u003eKhông vệ sinh thiết bị bằng cách phun nước trực tiếp hoặc nhúng vào nước.\u003c/li\u003e\n\u003cli\u003eTuyệt đối không dùng nước để vệ sinh bộ lọc 3 trong 1.\u003c/li\u003e\n\u003cli\u003eKhông sử dụng các vật dụng cứng để vệ sinh máy vì nó sẽ làm trầy xước hoặc hư hỏng bề mặt thiết bị.\u003c/li\u003e\n\u003cli\u003eKhông vệ sinh máy lọc không khí bằng các loại chất tẩy rửa có chứa kiềm hoặc axit…\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/c8/93/16/c160ff1caeba2b69d20eb90edf769b93.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c8/93/16/c160ff1caeba2b69d20eb90edf769b93.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c8/93/16/c160ff1caeba2b69d20eb90edf769b93.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c8/93/16/c160ff1caeba2b69d20eb90edf769b93.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c8/93/16/c160ff1caeba2b69d20eb90edf769b93.png"},{"base_url":"https://salt.tikicdn.com/ts/product/ea/62/2d/5e2cd15080c74dba3b1b81d54edef60f.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ea/62/2d/5e2cd15080c74dba3b1b81d54edef60f.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ea/62/2d/5e2cd15080c74dba3b1b81d54edef60f.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ea/62/2d/5e2cd15080c74dba3b1b81d54edef60f.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ea/62/2d/5e2cd15080c74dba3b1b81d54edef60f.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/64/c3/db/f816a22975345cd067cbc8d1aa8e3331.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/64/c3/db/f816a22975345cd067cbc8d1aa8e3331.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/64/c3/db/f816a22975345cd067cbc8d1aa8e3331.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts