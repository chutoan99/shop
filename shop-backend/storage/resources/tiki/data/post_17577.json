son":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/f0/03/43/847e492d4fa13a14fa6caadaeafca17f.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":488,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2 style=\"text-align:center;\"\u003e\u003cstrong\u003eTAI NGHE SIÊU NHỎ GỌN LYPERTEK SOUNDFREE S10\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/d7/dd/40/e34331235387f856ecf6aa04d48ad30e.jpg\" alt=\"\" width=\"600\" height=\"338\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cem\u003e\u003cstrong\u003eNhỏ gọn đến mức có thể dùng đi ngủ\u003c/strong\u003e\u003c/em\u003e\u003c/h3\u003e\n\u003cp\u003eSoundfree S10 là sản phẩm mới nhất từ Lypertek, bên cạnh những màu sắc pastel đẹp mắt thì cặp tai nghe này còn có phần đeo tai cực kỳ nhỏ gọn. Cặp tai nghe này khi được đeo lên sẽ vừa khít với vành tai của người nghe, từ đó không gây cấn, cộm khi đội mũ bảo hiểm loại full-helmet, đặc biệt là còn có thể sử dụng để thưởng thức nhạc, nghe podcast, ASMR khi đi ngủ.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/1e/9f/bf/24a478e5b590129f505784f2d507cd08.jpg\" alt=\"\" width=\"600\" height=\"600\" /\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cem\u003e\u003cstrong\u003eChống ồn chủ động ANC\u003c/strong\u003e\u003c/em\u003e\u003c/h3\u003e\n\u003cp\u003eTai nghe được trang bị công nghệ chống ồn chủ động ANC để bạn thưởng thức nhạc mà không bị những xao nhãng bên ngoài, bên cạnh đó cũng là cách để bạn chìm sâu vào giấc ngủ tốt hơn nếu đeo đi ngủ. Bên cạnh đó là tính năng Ambient Sound để bạn nhanh chóng nghe môi trường bên ngoài mà không cần phải tháo tai nghe ra.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/c0/1b/08/0b7190141b91dc641676c97491eac76d.jpg\" alt=\"\" width=\"600\" height=\"600\" /\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cem\u003e\u003cstrong\u003eThời lượng sử dụng 20 tiếng và kháng nước IPX4\u003c/strong\u003e\u003c/em\u003e\u003c/h3\u003e\n\u003cp\u003eTai nghe trong một lần sạc đầy có thể sử dụng liên tục được trong 5 tiếng độc lập và 20 tiếng nếu sử dụng chung với hộp sạc, sạc lại bằng dây USB Type-C hoặc không dây bằng chuẩn Qualcomm Qi.\u003c/p\u003e\n\u003cp\u003eKhông chỉ sử dụng khi đi ngủ, Soundfree S10 còn sẵn sàng đồng hành với bạn trong những buổi tập chạy, tập thể dục nhờ chuẩn kháng nước IPX4.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cdiv class=\"tab-title\"\u003e\u003cstrong\u003eTHÔNG SỐ KỸ THUẬT:\u003c/strong\u003e\u003c/div\u003e\n\u003cdiv class=\"tab-content\"\u003e\n\u003cul\u003e\u003cli\u003eMàng loa Dynamic\u003c/li\u003e\n\u003cli\u003eTần số đáp ứng: 20Hz - 20kHz \u003c/li\u003e\n\u003cli\u003eChuẩn Bluetooth 5.2 độ trễ thấp\u003c/li\u003e\n\u003cli\u003eThời lượng sử dụng độc lập 5 tiếng\u003c/li\u003e\n\u003cli\u003eThời lượng sử dụng với hộp 20 tiếng\u003c/li\u003e\n\u003cli\u003eChuẩn kháng nước IPX4\u003c/li\u003e\n\u003cli\u003eBảo hành 12 tháng\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eShop là cửa hàng bán lẻ, KHÔNG XUẤT ĐƯỢC HÓA ĐƠN.\u003c/strong\u003e\u003c/li\u003e\n\u003c/ul\u003e\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ n