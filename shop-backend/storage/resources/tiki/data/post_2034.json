und_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":34000,"discount_rate":45,"rating_average":4.7,"review_count":89,"review_text":"(89)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/5b/9c/75/1aafea7e7ed2d55d0b60945acf6166a2.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1168,"all_time_quantity_sold":647,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eNước mắm\u003c/strong\u003e nhỉ cá cơm vàng Làng Chài Xưa là một trong những loại \u003cstrong\u003enước mắm\u003c/strong\u003e được nhiều khách tin tưởng lựa chọn và đặc biệt ngon khó cưỡng của bảo tàng nước mắm Làng Chài Xưa, được làm từ loại cá cơm vàng ruột đỏ - \u003cstrong\u003ecá ngon vùng nước trồi\u003c/strong\u003e và muối tinh khiết, được ủ chượp cho ra hượng vị ngon sánh vị.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/67/a5/2e/86e3f24e5f9c4e3ecc831fe1debd514c.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cstrong\u003eCÁ CƠM VÀNG RUỘT ĐỎ VÙNG NƯỚC TRỒI !\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eLoại cá cơm này có thịt màu vàng nhạt và ruột màu đỏ nên cũng thường được ngư dân gọi là cá cơm vàng ruột đỏ. Cá cơm vàng ruột đỏ có tên gọi tiếng Anh là Apogen Anchovy. Chúng xuất hiện từ tháng 5 cho đến tháng 9 hàng năm với số lượng ít nên khai thác không nhiều. Sự ít ỏi về sản lượng này là do chúng chỉ xuất hiện khi có hiện tượng nước trồi ở vùng biển Phan Thiết. Đây là một trong 18 \"vùng biển nước trồi\" trên thế giới có dòng nước từ đáy đưa phù du trồi lên bề mặt vào mùa gió Tây Nam hàng năm giúp cung cấp thức ăn cho cá cơm vốn sống ở tầng nổi.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/c4/8b/29/e574121d472756426e0f7a8bf26de0bc.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eCũng chính hiện tương nước trồi đã cung cấp lượng dinh dưỡng lớn khiến cá cơm vàng ruột đỏ to béo vượt trội. Khi làm \u003cstrong\u003enước mắm\u003c/strong\u003e, cá cơm vàng ruột đỏ cho ít nước nhưng lại có màu trà đỏ rất đẹp, thơm vị thịt chín, cho đạm cao và hậu vị ngọt. Chính vì sự hiếm có và đặc biệt đó khiến cho giá cá cơm vàng ruột đỏ cao hơn các loại cá cơm khác trên thị trường và vì vậy nước mắm làm từ cá cơm vàng ruột đỏ cũng có giá thành cao nhưng mang lại chất lượng khác biệt.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cstrong\u003e QUY TRÌNH SẢN XUẤT NƯỚC MẮM TRUYỀN THỐNG\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eBước 1: Chọn muối tinh khiết và cá cơm vàng ruột đỏ Muối tinh khiết: Muối để làm nước mắm ngon là những hạt muối tinh khiết, hàm lượng NaCl lớn hơn 95% rồi sau đó phải được cất trong kho ít nhất khoảng một năm để lắng và triệt tiêu vị chát rồi mới có thể đem ra dùng ủ với cá cơm.\u003c/p\u003e\n\u003cp\u003eBước 2: Trộn cá và muối theo tỷ lệ 3 cá: 1 muối Cá cơm vàng ruột đỏ tươi sẽ được chọn lọc thật, đem rửa sạch rồi trộn đều với muối biển theo tỉ lệ 3 cá : 1 muối. Nghĩa là cứ 3 tấn cá sẽ được trộn với 1 tấn muối biển sạch. Sau khi trộn cá và muối theo tỉ lệ trên sẽ cho tất cả vào thùng chượp bằng gỗ bời lời, được gia cố bởi những sợi dây thừng to làm bằng cây mây rừng.\u003c/p\u003e\n\u003cp\u003eBước 3: Sau gần 12-24 tháng ủ chượp cá và muối sẽ chín, nước bổi khi kéo rút ra sẽ có mùi thơm nồng, trong khi soi (cẩn), nước mắm có màu cánh gián. Những giọt nước mắm nhỉ đầu tiên này được gọi là mắm rin hay mắm cốt, những đợt sau gọi là mắm nhất, mắm nhì… \u003cstrong\u003eNước mắm rin\u003c/strong\u003e có thể dùng để ăn ngay\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/20/51/61/098f41d96f0dff053a32063f76ca4f35.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eBảo Tàng Nước Mắm Làng Chài Xưa: Đây là sản phẩm chất lượng cao của Bảo Tàng nước mắm Làng Chài Xưa, là bảo tàng nước mắm đầu tiên và duy nhất tại Việt Nam.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/5b/9c/75/1aafea7e7ed2d55d0b60945acf6166a2.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/5b/9c/75/1aafea7e7ed2d55d0b60945acf6166a2.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/5b/9c/75/1aafea7e7ed2d55d0b60945acf6166a2.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5b/9c/75/1aafea7e7ed2d55d0b60945acf6166a2.jpg","thumbnail_url":"https://salt.tikicdn.