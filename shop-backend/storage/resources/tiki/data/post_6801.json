icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":79000,"discount_rate":19,"rating_average":4.8,"review_count":1079,"review_text":"(1079)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/df/ce/6b/38f02edcf9bd576b8e90a77703f4ecd3.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2429,"all_time_quantity_sold":7175,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align:left;\"\u003e\u003cem\u003e\u003cstrong\u003e***Thông báo về việc không có màng nhựa bảo vệ sản phẩm\u003c/strong\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003ePicare cùng nhãn hàng Gaderma xin thông báo kể từ ngày 17 tháng 9 năm 2021, vì tình hình dịch Covid-19 diễn biến phức tạp và nguồn lực hạn chế do tình trạng giãn cách xã hội kéo dài, các sản phẩm Cetaphil của nhãn hàng Galderma (Singapore) do Công ty TNHH DKSH Việt Nam phân phối sẽ tạm thời không có màng co nhựa (lớp bảo vệ) trên nắp chai như hình ảnh đính kèm.\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003eNhãn hàng Galderma cam kết các mặt hàng Cetaphil vẫn đảm bảo chất lượng và tuân thủ theo các quy định khi lưu hành sản phẩm trên thị trường.\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003eKính mong Quý Khách Hàng thông cảm và tiếp tục đồng hành cùng nhãn hàng Cetaphil - Picare.\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ae/67/c0/7337d794263ffd736044b2c01df39daf.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e\u003cstrong\u003eSữa Rửa Mặt Dịu Nhẹ Cetaphil Gentle Skin Cleanser 500ml\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003eNếu chẳng may bạn đang phải sở hữu làn da nhạy cảm vô cùng kích ứng, hay ngứa rát và mẫn đỏ thì Cetaphil Gentle Skin Cleanser sẽ là sự lựa chọn phù hợp đối với bạn. Cetaphil Gentle Skin Cleanser với ưu điểm vượt trội là độ pH chuẩn 5.5 giúp nhẹ nhàng làm sạch, loại bỏ mọi bụi bẩn, vừa cung cấp độ ẩm cho làn da luôn mềm mại và mịn màng. Sản phẩm vô cùng dịu nhẹ, phù hợp với cả làn da em bé, cực kỳ an toàn.\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eCetaphil là một dòng chăm sóc da thuộc Galderma Laboratories, một công ty dược nổi tiếng của châu Âu, sản xuất ở Canada với những sản phẩm sáng tạo, được nghiên cứu khoa học, y tế nhằm đáp ứng nhu cầu của người tiêu dùng trên toàn thế giới. Các sản phẩm của Galderma luôn đạt tiêu chuẩn về y tế và da liễu, được các bác sỹ da liễu trên toàn thế giới khuyên dùng. Thương hiệu này đã cho ra đời biết bao sản phẩm chăm sóc da nổi tiếng, trong đó nổi tiếng nhất là Sữa Rửa Mặt Cetaphil được sáng chế bởi một dược sĩ vào năm 1947 - Dòng sữa rửa mặt được các chuyên gia da liễu bào chế với thành phần an toàn, giúp da mềm mại hoàn toàn không gây kích ứng với cả những làn da nhạy cảm.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://file.hstatic.net/1000097940/file/sua-rua-mat-diu-nhe-cetaphil_8db23fffff6e40f3b1e66ae9a65e39c1_grande.png\" width=\"600\" height=\"600\" alt=\"sua-rua-mat-diu-nhe-cetaphil_8db23fffff6e40f3b1e66ae9a65e39c1_grande.png\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eSữa Rửa Mặt Dịu Nhẹ Cetaphil Gentle Skin Cleanser 500ml \u003c/strong\u003evới công thức đặc biệt để loại bỏ chất nhờn trên mặt, tẩy sạch bụi bẩn và trang điểm mà không làm cho da bạn bị khô ráp. Sản phẩm sẽ cho bạn cảm giác sảng khoái, tươi mát và sạch sẽ. Với công thức chuyên biệt có thể dùng cho tất cả các loại da: da thường, da hỗn hợp và da dầu; cả da mặt, tay và chân luôn nhé!\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://file.hstatic.net/1000097940/file/sua-rua-mat-diu-nhe-cetaphil-1_9ed6d8776fd14cd8b5ca5c5148cbe587_grande.jpg\" width=\"600\" height=\"399\" alt=\"sua-rua-mat-diu-nhe-cetaphil-1_9ed6d8776fd14cd8b5ca5c5148cbe587_grande.jpg\" /\u003e\u003cbr /\u003e\u003cbr /\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e1. Công dụng Sữa Rửa Mặt Dịu Nhẹ Cetaphil Gentle Skin Cleanser 500ml\u003c/strong\u003e\u003cbr /\u003e- Làm sạch nhẹ nhàng, giúp loại bỏ bụi bẩn, phấn trang điểm nhưng vẫn duy trì độ ẩm tự nhiên của da.\u003cbr /\u003e- Không gây tình trạng dị ứng, kích ứng da, có thể dùng cho cả mặt, tay và toàn thân. Không chứa xà phòng, không chứa hương liệu, không gây khô da và kích ứng.\u003cbr /\u003e- Cung cấp độ ẩm cần thiết cho làn da luôn mềm mại, mịn màng và khỏe mạnh. Giúp làn da luôn tươi sáng, đầy sức sống, cân bằng lượng dầu thừa trên da.\u003cbr /\u003e- Bổ sung các dưỡng chất giúp nuôi dưỡng và phục hồi tế bào da hư tổn. Sản phẩm được các bác sĩ da liễu và nhi khoa khuyên dùng.\u003cbr /\u003e- Độ pH cân bằng, giúp duy trì hàng rào bảo vệ da. Có thể dùng với nước hoặc dùng khô.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://file.hstatic.net/1000097940/file/b1_21373473f1414edaa6588c8935da83e9_grande.jpg\" width=\"600\" height=\"396\" alt=\"b1_21373473f1414edaa6588c8935da83e9_grande.jpg\" /\u003e\u003cbr /\u003e\u003cbr /\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e2. Thành phần Sữa Rửa Mặt Dịu Nhẹ Cetaphil Gentle Skin Cleanser 500ml\u003c/strong\u003e\u003cbr /\u003eWater, Cetyl Alcohol, Propylene Glycol, Sodium Lauryl Sulfate, Stearyl Alcohol, Methylparaben, Propylparaben, Butylparaben\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e3. Hướng dẫn sử dụng Sữa Rửa Mặt Dịu Nhẹ Cetaphil Gentle Skin Cleanser 500ml\u003c/strong\u003e\u003cbr /\u003e- Dùng với nước: Thoa đều lên vùng mặt và mát xa nhẹ nhàng. Sau đó rửa sạch với nước. Dùng: 1-2 lần/ ngày\u003cbr /\u003e- Rửa khô: Thoa đều lên vùng mặt và mát xa nhẹ nhàng. Loại bỏ phần dư thừa bằng khăn mềm.\u003cbr /\u003e\u003cbr /\u003e\u003cstrong\u003eLoại da phù hợp:\u003c/strong\u003e\u003cbr /\u003eSản phẩm thích hợp với mọi loại da, da khô, da dầu, da mẩn đỏ, da chàm, da mụn, da bị vẩy nến, và đặc biệt là da nhạy cảm.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/c9/ec/a0/e32ee5fafdff28ae4e980bc8da4d632f.jpg\" alt=\"\" width=\"750\" height=\"749\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eBảo quản:\u003c/strong\u003e\u003cbr /\u003eNơi khô ráo, thoáng mát.\u003cbr /\u003eTránh ánh nắng trực tiếp, nơi có nhiệt độ cao hoặc ẩm ướt.\u003cbr /\u003eĐậy nắp kín sau khi sử dụng.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eThương hiệu: Cetaphil\u003cbr /\u003eXuất xứ: Canada\u003cbr /\u003eDung tích: 500ml\u003cbr /\u003e\u003cbr /\u003e\u003cstrong\u003e*** Mẫu mã bao bì có thể thay đổi theo qui định của nhãn hàng.\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng 