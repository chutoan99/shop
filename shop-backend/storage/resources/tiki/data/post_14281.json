ght":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.7,"review_count":47,"review_text":"(47)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ba/56/ef/0a2a6f069347e8444e9bd48ce4747339.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1201,"all_time_quantity_sold":733,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eGạo tấm thơm ST25 là những hạt gạo bị vỡ ra trong quá trình xay, xát, gạo tấm có các phôi và cám gạo chứa nhiều giá trị dinh dưỡng. Khi nấu, gạo tấm cho cơm thơm, ngọt, hàm lượng tinh bột cao. Đặc biệt, cơm nấu từ gạo tấm vẫn ngon ngay cả khi đã nguội.\u003c/p\u003e\n\u003cp\u003eDùng nấu cháo dinh dưỡng cho người già và trẻ nhỏ, nấu cơm ăn dặm cho bé, cơm tấm gia đình\u003c/p\u003e\n\u003cp\u003eGạo tấm thích hợp để làm các món cơm tấm hoặc nấu các món cháo thơm ngon, nhiều dinh dưỡng.\u003c/p\u003e\n\u003cp\u003eĐặc tính gạo tấm:\u003cbr /\u003eHạt gạo nhỏ, màu trắng , khô ráo. Cơm có mùi thơm, ngọt, độ dính cao.\u003c/p\u003e\n\u003cp\u003e- Đặc điểm\u003cbr /\u003e+ Gạo tấm thơm, dẻo, có vị ngọt và mùi thơm đặc trưng\u003cbr /\u003e+ Tuyệt vời hơn khi nấu cháo dinh dưỡng cho bé\u003cbr /\u003e+ Gạo mùa 1 năm 1 vụ\u003cbr /\u003e+ Gạo đúng chuẩn và nấu rất thơm ngon\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eTự hào tiêu chuẩn 5 không:\u003cbr /\u003e1. Không sử dụng phân bón hóa học.\u003cbr /\u003e2. Không sử dụng thuốc bảo vệ thực vật.\u003cbr /\u003e3. Không chất bảo quản, chất tẩy trắng, thuốc chống mối mọt.\u003cbr /\u003e4. Không giống biến đổi gen.\u003cbr /\u003e5. Không đấu trộn.\u003c/p\u003e\n\u003cp\u003eGạo tấm là hạt gạo trong quá trình xay xát bị vỡ ra, còn nguyên lớp phôi và cám, rất giàu dinh dưỡng.Với hương thơm tự nhiên và vị đặc trưng, gạo tấm trắng chứa đa dạng các hoạt chất sinh học, mang lại giá trị dinh dưỡng cao và nhiều lợi ích cho sức khỏe. Sử dụng gạo tấm để chế biến ăn dặm cho bé vừa đảm bảo dinh dưỡng vừa giúp mẹ rút ngắn thời gian nha.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ba/56/ef/0a2a6f069347e8444e9bd48ce4747339.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ba/56/ef/0a2a6f069347e8444e9bd48ce4747339.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ba/56/ef/0a2a6f069347e8444e9bd48ce4747339.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ba/56/ef/0a2a6f069347e8444e9bd48ce4747339.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ba/56/ef/0a2a6f069347e8444e9bd48ce4747339.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/68/71/56/360329b281115a8664f17b2ff3d2cdb3.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/68/71/56/360329b281115a8664f17b2ff3d2cdb3.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/68/71/56/360329b281115a8664f17b2ff3d2cdb3.jpg","posi