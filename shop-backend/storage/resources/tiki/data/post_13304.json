background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.8,"review_count":74,"review_text":"(74)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/f9/5e/6b/8fecfa900f000862f5ba5d4352ce219b.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1875,"all_time_quantity_sold":200,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cul\u003e\n\u003cli\u003e\n\u003cp\u003eNón bảo hiểm Sunda 136 là sản phẩm của Công Ty TNHH LongHuei Việt Nam, một cty chuyên sản xuất nón bảo hiểm cao cấp với gần ba mươi năm kinh nghiệm phục vụ cho thị trường quốc tế. 90% các sản phẩm của cty được xuất khẩu đi nước ngoài, đảm bảo các yêu cầu khắt khe về tiêu chuẩn và chất lượng.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eMũ và kính mũ được hoàn thiện với chất lượng rất cao, các chi tiết và phụ kiện đi kèm như ốc, vít, dây quai, khóa cài, lót mũ đều sử dụng các vật liệu tốt và có chất lượng cao. Mũ SUNDA thuộc phân khúc cao cấp so với các thương hiệu khác trên thị trường Việt Nam hiện nay.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eCác nhãn hiệu mũ của công ty LongHuei tại Việt Nam: ZEUS, ANDES, SUNDA, CROMO, trong đó thương hiệu mũ ANDES đã rất quen thuộc với người dùng từ hàng chục năm nay.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eLong Huei là cty tại VN có phòng thử nghiệm hiện đại, đạt tiêu chuẩn quốc tế, đảm bảo chất lượng sản phẩm đáp ứng các tiêu chuẩn an toàn của Việt Nam và quốc tế.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eNhững sản phẩm của cty LongHuei đều đạt tiêu chuẩn VN và tiêu chuẩn “DOT, ECE,CNS,SNI,JIS” đáp ứng được các yêu cầu của hầu hết các thị trường quốc tế khó tính.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eVỏ Nón: Sản phẩm mũ bảo hiễm Sunda cam kết luôn sử dụng Nhựa ABS nguyên sinh 100% được nhập khẩu từ các nhà cung ứng uy tín như Hàn Quốc, Malaysia, Thái , Nhật, chịu được độ va đập cao\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eMút xốp: là bộ phận cực kỳ quan trọng để bảo vệ não bộ, hấp thụ xung động khi xảy ra tai nạn, Sunda luôn sử dụng xốp nguyên sinh trong tất cả các sản phẩm\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eVải lót cao cấp được xử lý kháng khuẩn, thấm hút tốt, mau khô, giúp hạn chế nguy cơ mắc các bệnh về tóc và da đầu. Vải lót Sunda có kết cấu màng lưới lớn độc quyền trên các sản phẩm của cty LongHuei, cho phép không khí lưu thông dễ dàng vào bên trong, tạo cảm giác thoáng mát dễ chịu\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eKhóa bằng inox và dây đai chịu được lực kéo mạnh, chắc chắn, luôn bám sát vào đầu đảm bảo an toàn tốt.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eKính chắn gió được làm từ vật liệu chất lượng cao, đã qua xử lý đặc biệt, cho góc quan sát rộng, hình ảnh rõ nét, trung thực, không bị chói đèn, chống tia UV400, chắn gió, để bạn tập trung lái xe. Kính nâng lên hạ xuống dễ dàng, êm ái.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eMũ được sơn bằng nguyên liệu ngoại nhập, độ bền cao, chống trầy rất tốt.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003eMũ phù hợp với nam nữ trưởng thành có vòng đầu trung bình, size phổ biến của người Việt Nam.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003e*** Hướng dẫn xác định cỡ mũ phù hợp:\u003c/strong\u003e Vòng 1 sợi dây quanh đầu, phía trên lông mày và tai khoảng 2cm. Xiết sợi dây sao cho ôm vừa đủ thoải mái lấy đầu và ghi lại số đo đó. Lặp lại như vậy để tìm được số đo mà bạn thấy đầu dễ chịu nhất. Đó chính là size đầu của bạn. So sánh với kích cỡ mũ để lựa chọn size mũ phù hợp nhất.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/6f/2b/77/6a32569daa57daa4cbed2b281787d047.jpg\" alt=\"\" width=\"750\" height=\"530\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/f9/5e/6b/8fecfa900f000862f5ba5d4352ce219b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f9/5e/6b/8fecfa900f000862f5ba5d4352ce219b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f9/5e/6b/8fecfa900f000862f5ba5d4352ce219b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f9/5e/6b/8fecfa900f000862f5ba5d4352ce219b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f9/5e/6b/8fecfa900f000862f5ba5d4352ce219b.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/01/1b/1e/14e755c8d55a1e591dad48afc93b9ce9.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/01/1b/1e/14e755c8d55a1e591dad48afc93b9ce9.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/01/1b/1e/14e755c8d55a1e591dad48afc93b9ce9.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/01/1b/1e/14e755c8d55a1e591dad48afc93b9ce9.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/01/1b/1e/14e755c8d55a1e591dad48afc93b9ce9.jpg"}],"warranty_policy":null,"brand":{"id":204881,"name":"SUNDA","slug":"sunda"},"current_seller":{"id":6612,"sku":"3639751681915","name":"Mũ 