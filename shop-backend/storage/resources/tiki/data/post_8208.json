":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/d6/c4/3c/4daf3f067a1f95bbf282a6f9e4552c8c.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":298,"all_time_quantity_sold":14,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/9f/14/bd/c86d043fcb45f21567b456ad75de8c7c.jpg\" alt=\"\" width=\"750\" height=\"686\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/f6/80/18/620a2c4e97cd1a19bcb87095e1ef4540.jpg\" alt=\"\" width=\"750\" height=\"638\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/2a/17/b3/7f165bc083befb27223231003d0c2df0.jpg\" alt=\"\" width=\"750\" height=\"798\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/d1/29/72/48dcf7652d14d780003e988baf055506.jpg\" alt=\"\" width=\"750\" height=\"1053\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/91/28/53/12d532dc1558b420a615d2e7af2ec20f.jpg\" alt=\"\" width=\"750\" height=\"692\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/e7/3a/76/cfaff69470c01d068935dd87aa9d6c87.jpg\" alt=\"\" width=\"750\" height=\"234\" /\u003e\u003c/p\u003e\n\u003ch3\u003eĐặc điểm nổi bật\u003c/h3\u003e\n\u003cp\u003e\u003cstrong\u003eNúm ty mô phỏng tự nhiên mới SCY962\u003c/strong\u003e giúp con bạn có thể tự mình kiểm soát tốc độ chảy của sữa, giúp làm giảm hiện tượng bú quá nhiều và bị trào. Vòng bao độc đáo có thể gập lại để cho không khí vào bình sữa, giúp bé bú chủ động, có lợi cho sức khỏe, giảm la hét và đầy hơi. Hơn nữa, núm vú được thiết kế độc đáo với 2 van khí hai bên giúp hạn chế tối đa tình trạng đầy hơi của bé.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eNúm vú chỉ tiết sữa khi bé chủ động bú\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eNúm vú phản ứng tự nhiên hoạt động theo nhịp bú tự nhiên của bé, giúp bạn dễ dàng kết hợp cho bé bú mẹ và bú bình. Núm vú có lỗ mở độc đáo chỉ tiết sữa khi bé chủ động bú. Vì vậy, khi bé tạm dừng để nuốt và thở, sữa cũng tạm dừng chảy.\u003c/p\u003e\n\u003cp class=\"p-heading-04-large p-heading-bold p-feature-title\"\u003e\u003cstrong\u003eNúm vú được thiết kế theo dáng bầu ngực để bé bú mút tự nhiên\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eNúm vú rộng, mềm và đàn hồi được thiết kế theo dáng bầu ngực, giúp bé ngậm và bú thoải mái.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eĐược thiết kế để làm giảm hiện tượng đầy hơi và quấy khóc\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eVan chống đầy hơi được thiết kế để không khí đi vào trong bình sữa chứ không vào dạ dày của bé trong khi bé bú bình, giúp giảm hiện tượng đầy hơi và quấy khóc.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThiết kế núm vú không nhỏ giọt ngăn sữa chảy tràn và mất sữa\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eLỗ núm vú được thiết kế để chỉ tiết sữa khi bé bú. Vì vậy, bạn có thể tự tin tránh mất sữa dù ở nhà hay đang di chuyển.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eNúm vú phản ứng tự nhiên và bình sữa không chứa BPA*\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eBình sữa và núm vú thiết kế Tự nhiên Philips Avent được làm từ chất liệu không chứa BPA*.\u003c/p\u003e\n\u003ch3\u003eThông tin thương hiệu\u003c/h3\u003e\n\u003cp\u003ePhilip Avent được thành lập vào năm 1984 tại Anh Quốc. Sản phẩm của Philip Avent được các bà mẹ khuyên dùng số 1 tại Châu Âu, bởi vì đây là nhóm sản phẩm chất lượng đẳng cấp quốc tế, hoàn toàn không có chất BPA.\u003c/p\u003e\n\u003cp\u003ePhilips AVENT được sản xuất theo tiêu chuẩn Châu Âu dưới sự quản lý nghiêm ngặt về chất lượng, đạt đầy đủ các chỉ số an toàn cho sức khỏe con người và đảm bảo hoàn toàn không có chất BPA độc hại.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/d6/c4/3c/4daf3f067a1f95bbf282a6f9e4552c8c.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d6/c4/3c/4daf3f067a1f95bbf282a6f9e4552c8c.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d6/c4/3c/4daf3f067a1f95bbf282a6f9e4552c8c.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d6/c4/3c/4daf3f067a1f95bbf282a6f9e4552c8c.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d6/c4/3c/4daf3f067a1f95bbf282a6f9e4552c8c.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/62/6d/d6/5f3f8b2aad2fb16462cbe998b6a08829.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/62/6d/d6/5f3f8b2aad2fb16462cbe998b6a08829.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/62/6d/d6/5f3f8b2aad2fb16462cbe998b6a08829.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/62/6d/d6/5f3f8b2aad2fb16462cbe998b6a08829.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/62/6d/d6/5f3f8b2aad2fb16462cbe998b6a08829.png"},{"base_url":"https://salt.tikicdn.com/ts/product/84/34/65/3f30156e456434a19ba909f461c17f37.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/84/34/65/3f30156