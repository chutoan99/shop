":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.3,"review_count":10,"review_text":"(10)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/42/c2/cf/b0e7ace7854bdc5f9be3102b1c3bcb7e.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2015,"all_time_quantity_sold":99,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p class=\"MsoNormal\" style=\"margin-bottom: 4.0pt; text-align: justify; line-height: 14.0pt; mso-pagination: none;\"><span style=\"font-size: 13.0pt; font-family: 'Times New Roman','serif';\"><span style=\"mso-spacerun: yes;\">        </span>Hiện nay công tác kế toán hành chính sự nghiệp được thực hiện theo Thông tư số 107/2017/TT-BTC ban hành ngày 10/10/2017 của Bộ Tài chính về việc hướng dẫn chế độ kế toán HCSN. </span></p>\n<p class=\"MsoNormal\" style=\"margin-bottom: 4.0pt; text-align: justify; text-indent: 22.7pt; line-height: 14.0pt; mso-pagination: none;\"><span style=\"font-size: 13.0pt; font-family: 'Times New Roman','serif';\">Với việc áp dụng CĐKT theo Thông tư số 107 đã làm thay đổi khá căn bản nội dung và phương pháp kế toán ở các đơn vị HCSN của nước ta. Những thay đổi này phù hợp với định hướng chuyển sang áp dụng cơ sở dồn tích cho kế toán Hành chính sự nghiệp và đã có sự tương thích khá cao với CMKT công quốc tế (IPSAS). Qua việc áp dụng chế độ kế toán này sẽ giúp cho thông tin kế toán do các đơn vị HCSN cung cấp nâng cao được tính minh bạch và tính hữu dụng cho các đối tượng sử dụng có liên quan. Chính điều này sẽ đảm bảo cho sự chấp nhận rộng rãi của các đối tượng sử dụng trong nước và quốc tế đối với thông tin do đơn vị HCSN cung cấp.</span></p>\n<p class=\"BodyText1\">Nhằm giúp các bạn đang công tác kế toán tại các đơn vị HCSN cũng như các bạn sinh viên học chuyên ngành kế toán có các tài liệu tham khảo để thực hành Kế toán HCSN theo CĐKT mới,  <span style=\"mso-bidi-font-size: 13.0pt;\">cùng biên soạn cuốn sách: “</span><strong style=\"mso-bidi-font-weight: normal;\">”.</strong></p>\n<p class=\"BodyText1\"><span style=\"mso-bidi-font-size: 13.0pt;\">Sách do </span><span style=\"mso-bidi-font-size: 13.0pt; font-family: 'Arial','sans-serif';\">nhà xuất bản Tài Chính xuất bản</span><span style=\"mso-bidi-font-size: 13.0pt;\"> bao gồm 2 phần: </span></p>\n<p class=\"MsoNormal\" style=\"margin-bottom: 4.0pt; text-align: justify; text-indent: 22.7pt; line-height: 14.0pt; mso-pagination: none;\"><em style=\"mso-bidi-font-style: normal;\"><span style=\"font-size: 13.0pt; font-family: 'Times New Roman','serif'; mso-no-proof: yes;\">Phần I. Hướng dẫn thực hành kế toán theo các khoản mục của báo cáo tài chính &amp; theo các tài khoản có liên quan (gồm cả sơ đồ kế toán &amp; ví dụ minh họa)</span></em></p>\n<p class=\"MsoNormal\" style=\"margin-bottom: 4.0pt; text-align: justify; text-indent: 22.7pt; line-height: 14.0pt; mso-pagination: none;\"><em style=\"mso-bidi-font-style: normal;\"><span style=\"font-size: 13.0pt; font-family: 'Times New Roman','serif'; mso-no-proof: yes;\">Phần II. Giới thiệu hệ thống báo cáo tài chính &amp; báo cáo quyết toán</span></em></p>\n<p class=\"MsoNormal\" style=\"margin-bottom: 4.0pt; text-align: justify; text-indent: 22.7pt; line-height: 14.0pt; mso-pagination: none;\"><em style=\"mso-bidi-font-style: normal;\"><span style=\"font-size: 13.0pt; font-family: 'Times New Roman','serif';\">H</span></em><span style=\"font-size: 13.0pt; font-family: 'Times New Roman','serif';\">y vọng cuốn sách này là tài liệu tham khảo hữu ích cho các bạn có nhu cầu sử dụng.</span></p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/42/c2/cf/b0e7ace7854bdc5f9be3102b1c3bcb7e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/42/c2/cf/b0e7ace7854bdc5f9be3102b1c3bcb7e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/42/c2/cf/b0e7ace7854bdc5f9be3102b1c3bcb7e.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/42/c2/cf/b0e7ace7854bdc5f9be3102b1c3bcb7e.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/42/c2/cf/b0e7ace7854bdc5f9be3102b1c3bcb7e.jpg"}],"warranty_policy":null,"current_seller":{"id":37,"sku":"7943494959771","name":"Nhà Sách Lao Động","link":"https://tiki.vn/cua-hang/nha-sach-lao-dong","logo":"5d/4a/3e/5d4a3e7b2eb80cfff65b3be51f8573c4.jpg","price":230000,"product_id":"11860075","store_id":61,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[{"id":18557,"name":"NHÀ SÁCH CHÍNH TRỊ PHÁP LUẬT KIỂM TOÁN TÀI CHÍNH","link":"https://tiki.vn/cua-hang/nha-sach-chinh-tri-phap-luat-kiem-toan-tai-chinh","logo":"","price":350000,"product_id":"11314517","store_id":17934}],"specifications":[{"name":"Thông tin chung","attributes":[{"code":"publisher_vn","name":"Công ty phát hành","value":"TT Giới Thiệu Sách TP. HCM"},{"code":"dimensions","name":"Kích thước","value":"<p>20X28CM</p>"},{"code":"book_cover","name":"Loại bìa","value":"Bìa mềm"},{"code":"number_of_page","name":"Số trang","value":"400"},{"code":"manufacturer","name":"Nhà xuất bản","value":"Nhà Xuất Bản Tài Chính"}]}],"price_comparison":{"sub_title":"Giá từ 350.000 ₫","title":"So sánh 1 nhà bán khác"},"product_links":[],"gift_item_title":"0 quà tặng kèm","services_and_promotions":[],"promitions":[],"stock_item":{"max_sale_qty":1000,"min_sale_qty":1,"preorder_date":null,"qty":1000},"quantity_sold":{"text":"Đã bán