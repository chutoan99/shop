ount":28350,"discount_rate":15,"rating_average":5,"review_count":54,"review_text":"(54)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/db/f7/87/3bb4f2fc9f339bafdb7ad8b61dd55518.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1603,"all_time_quantity_sold":301,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cspan style=\"color:#0000ff;\"\u003e\u003cstrong\u003eCombo D.Trump. Nghệ Thuật Đàm Phán và D. Trump - Đừng Bao Giờ Bỏ Cuộc \u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color:#ff0000;\"\u003e\u003cstrong\u003eD.Trump. Nghệ Thuật Đàm Phán\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003eQuyển  sách cho chúng ta thấy cách Trump  làm việc  mỗi ngày - cách ông điều hành công việc kinh doanh và cuộc sống - cũng như cách ông trò chuyện với bạn bè và gia đình, làm ăn với đối thủ, mua thành công những sòng bạc hàng đầu ở thành phố Atlantic, thay đổi bộ mặt của những cao ốc ở thành phố New York… và xây dựng những tòa nhà chọc trời trên thế giới.\u003cbr /\u003e\u003cbr /\u003eQuyển sách đi sâu vào đầu óc của một doanh nhân xuất sắc và khám phá một cách khoa học chưa từng thấy về cách đàm phán một thương vụ thành công. Đây là một cuốn sách thú vị về đàm phán và kinh doanh – và là một cuốn sách nên đọc cho bất kỳ ai quan tâm đến đầu tư, bất động sản và thành công.\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color:#ff0000;\"\u003e\u003cstrong\u003eD. Trump - Đừng Bao Giờ Bỏ Cuộc\u003c/strong\u003e\u003c/span\u003e\u003cstrong\u003e\u003cbr /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eTrump - doanh nhân nổi tiếng nhất thế giới này thẳng thắn giãi bày những thách thức to lớn nhất, những giây phút tệ hại nhất, và những cuộc chiến khốc liệt nhất - và cách ông biến những nghịch cảnh đó thành các thành công mới.\u003c/p\u003e\n\u003cp\u003eCuốn sách còn đưa ra những lời khuyên đắt giá trong kinh về: cách phản biện  khi gặp thất bại và trở ngại; biến những vấn đề lớn thành những cơ hội thậm chí còn lớn hơn; cách biến kẻ thù và địch thủ thành bạn bè và đồng minh; cách tận dụng những thất bại trước mắt làm động lực cho bản thân bạn - và khiến bạn kiên cường hơn.\u003c/p\u003e\n\u003cp\u003eQua những câu chuyện và trải nghiệm sâu sắc từ một nhà kinh doanh bậc thầy sẽ giúp bạn tự tin vào bản thân khi phải đối mặt với những khó khăn, vượt qua trở ngại để hiện thực hóa những giấc mơ.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/db/f7/87/3bb4f2fc9f339bafdb7ad8b61dd55518.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/db/f7/87/3bb4f2fc9f339bafdb7ad8b61dd55518.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/db/f7/87/3bb4f2fc9f339bafdb7ad8b61dd55518.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/db/f7/87/3bb4f2fc9f339bafdb7ad8b61dd55518.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/db/f7/87/3bb4f2fc9f339bafdb7ad8b61dd55518.jpg"}],"warranty_policy":null,"authors":[{"id":74270,"name":"Donald J.Trump \u0026 Tony Schwartz","slug":"donald-j-trump-tony-schwartz"},{"id":496059,"name":"`","slug":""}],"current_seller":{"id":7734,"sku":"5094382947560","name":"NHBook","link":"https://tiki.vn/cua-hang/nhbook","logo":"49/49/f3/973a1913dac7a3cbaa379403203cb8b7.jpg","price":160650,"product_id":"5324506