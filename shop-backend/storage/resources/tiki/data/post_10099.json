son"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/8b/6c/64/1ba5ee045ab654c4b80f1815b4e6d357.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2100,"all_time_quantity_sold":15,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<h5><strong><span style=\"font-size: 13.0pt; mso-bidi-font-weight: bold;\">Mua sách </span><span lang=\"PT-BR\" style=\"font-size: 14.0pt; mso-ansi-language: PT-BR;\">Bình luận Luật Hôn nhân và gia đình </span><span lang=\"PT-BR\" style=\"font-size: 14.0pt; mso-ansi-language: PT-BR; mso-bidi-font-weight: bold;\">trên TiKi với giá ưu đãi nhất.</span></strong></h5>\n<div style=\"text-align: justify;\"><span style=\"font-size: 14pt; text-indent: 0in;\">     Luật Hôn nhân và gia đình được Quốc hội khóa XIII kỳ họp thứ 7 thông qua ngày 19-6-2014, Luật này thay thế cho Luật Hôn nhân và gia đình năm 2000 và có hiệu lực thi hành từ ngày 01-01-2015.</span></div>\n<p style=\"margin-top: 0in; text-indent: 22.7pt; line-height: 15pt; text-align: justify;\"><span lang=\"PT-BR\" style=\"font-size: 14.0pt; mso-ansi-language: PT-BR; mso-bidi-font-weight: bold;\">Luật Hôn nhân và gia đình</span><span lang=\"PT-BR\" style=\"font-size: 14.0pt; mso-ansi-language: PT-BR;\"> năm 2014 ngoài việc kế thừa các quy định của <span style=\"mso-bidi-font-weight: bold;\">Luật Hôn nhân và gia đình năm 2000 và loại bỏ những quy định không còn phù hợp, thì đồng thời cũng được bổ sung một số quy định mới mà đặc biệt là quy định về mang thai hộ vì mục đích nhân đạo và được bố cục lại cho phù hợp với từng nhóm quan hệ nhằm bảo đảm tính logic, hợp lý.</span></span></p>\n<p style=\"margin-top: 0in; text-indent: 22.7pt; line-height: 15pt; text-align: justify;\"><span lang=\"PT-BR\" style=\"font-size: 14.0pt; mso-ansi-language: PT-BR; mso-bidi-font-weight: bold;\">Nhằm giúp bạn đọc nói chung, những người làm công tác pháp luật nói riêng thuận tiện trong việc nghiên cứu và áp dụng Luật Hôn nhân và gia đình mới, </span><span lang=\"PT-BR\" style=\"font-size: 14.0pt; mso-ansi-language: PT-BR;\">Nhà Sách Pháp Luật phối hợp với Nhà xuất bản Lao Động cho xuất bản cuốn sách<span style=\"mso-bidi-font-weight: bold;\">:</span></span></p>\n<h5 style=\"text-align: center;\"><strong><span lang=\"PT-BR\" style=\"font-size: 14.0pt; mso-ansi-language: PT-BR;\">Bình luận Luật Hôn nhân và gia đình </span></strong><strong style=\"mso-bidi-font-weight: normal;\"><span lang=\"PT-BR\" style=\"font-size: 14.0pt; mso-ansi-language: PT-BR;\">(Biên soạn theo các tài liệu mới nhất)</span></strong></h5>\n<p style=\"margin-top: 0in; text-align: justify; text-indent: 22.7pt; line-height: 15.0pt; mso-pagination: none;\"><span lang=\"PT-BR\" style=\"font-size: 14.0pt; mso-ansi-language: PT-BR; mso-bidi-font-weight: bold;\">Sách do luật sư <strong>Nguyễn Thị Chi</strong> biên soạn và hệ thống.</span></p>\n<p style=\"margin-top: 0in; text-align: justify; text-indent: 22.7pt; line-height: 15.0pt; mso-pagination: none;\"><span lang=\"PT-BR\" style=\"font-size: 14.0pt; mso-ansi-language: PT-BR; mso-bidi-font-weight: bold;\">Với cách biên soạn mới và dễ hiểu, kết hợp với việc bổ sung các thuật ngữ pháp lý cũng như các quy định mới của pháp luật có liên quan, cuốn sách giúp cho người đọc thuận tiện khi nghiên cứu và áp dụng luật. </span></p>\n<p class=\"MsoNormal\" style=\"margin-bottom: 5.0pt; text-align: justify; text-indent: 22.7pt; line-height: 15.0pt; mso-pagination: none;\"><span lang=\"PT-BR\" style=\"font-size: 14.0pt; mso-ansi-language: PT-BR;\">Ngoài ra cuốn sách còn in các văn bản pháp luật về hôn nhân và gia đình mới nhất và các văn bản có liên quan. Bên canh đó cuốn sách cũng cung cấp cho bạn đọc một số tập quán hôn nhân gia đình của một số dân tộc ở Việt Nam để bạn đọc tham khảo và áp dụng trong công việc, chuyên môn.</span></p>\n<p class=\"MsoNormal\"><span lang=\"PT-BR\" style=\"font-size: 14.0pt; mso-ansi-language: PT-BR;\">Sách có độ dày 400 trang,giá bìa 365.00đ/1 quyển </span></p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/8b/6c/64/1ba5ee045ab654c4b80f1815b4e6d357.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/8b/6c/64/1ba5ee045ab654c4b80f1815b4e6d357.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/8b/6c/64/1ba5ee045ab654c4b80f1815b4e6d357.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8b/6c/64/1ba5ee045ab654c4b80f1815b4e6d357.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8b/6c/64/1ba5ee045ab654c4b80f1815b4e6d357.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/ad/f4/f6/52190fdb436b3226f03e22bc8a9944c6.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ad/f4/f6/52190fdb436b3226f03e22bc8a9944c6.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ad/f4/f6/52190fdb436b3226f03e22bc8a9944c6.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ad/f4/f6/52190fdb436b3226f03e22bc8a9944c6.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ad/f4/f6/52190fdb436b3226f03e22bc8a9944c6.jpg"}],"warranty_policy":null,"authors":[{"id":149808,"name":"Nguyễn Thị Chi","slug":"nguyen-thi-chi"}],"current_seller":{"id":37,"sku":"3899963151525","name":"Nhà Sách Lao Động","link":"https://tiki.vn/cua