ạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/d2/b0/93/2a5d93499626d454dfd69c85dad1a18d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d2/b0/93/2a5d93499626d454dfd69c85dad1a18d.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d2/b0/93/2a5d93499626d454dfd69c85dad1a18d.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d2/b0/93/2a5d93499626d454dfd69c85dad1a18d.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d2/b0/93/2a5d93499626d454dfd69c85dad1a18d.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/7b/9b/09/f1d1864bc6696549538eda2ccbd42915.jpeg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/7b/9b/09/f1d1864bc6696549538eda2ccbd42915.jpeg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/7b/9b/09/f1d1864bc6696549538eda2ccbd42915.jpeg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7b/9b/09/f1d1864bc6696549538eda2ccbd42915.jpeg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7b/9b/09/f1d1864bc6696549538eda2ccbd42915.jpeg"},{"base_url":"https://salt.tikicdn.com/ts/product/5b/41/b7/c2891f7923a9faa1731c608069306755.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/5b/41/b7/c2891f7923a9faa1731c608069306755.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/5b/41/b7/c2891f7923a9faa1731c608069306755.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5b/41/b7/c2891f7923a9faa1731c608069306755.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5b/41/b7/c2891f7923a9faa1731c608069