á trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/8c/a3/f4/c63fa4281f9715608d53f4ed33df5ea2.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/8c/a3/f4/c63fa4281f9715608d53f4ed33df5ea2.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/8c/a3/f4/c63fa4281f9715608d53f4ed33df5ea2.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8c/a3/f4/c63fa4281f9715608d53f4ed33df5ea2.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8c/a3/f4/c63fa4281f9715608d53f4ed33df5ea2.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/68/96/b9/0b9050c45628fc2951c17522b605ba84.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/68/96/b9/0b9050c45628fc2951c17522b605ba84.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/68/96/b9/0b9050c45628fc2951c17522b605ba84.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/68/96/b9/0b9050c45628fc2951c17522b605ba84.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/68/96/b9/0b9050c45628fc2951c17522b605ba84.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/8f/6d/ec/c25a5ec4701bd98865727a88c9d090e7.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/8f/6d/ec/c25a5ec4701bd98865727a88c9d090e7.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/8f/6d/ec/c25a5ec4701bd98865727a88c9d090e7.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8f/6d/ec/c25a5ec4701bd98865727a88c9d090e7.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8f/6d/ec/c25a5ec4701bd98865727a88c9d090e7.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/98/85/fe/0f23125a6f2c925e5ba3e69e4aec9b24.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/98/85