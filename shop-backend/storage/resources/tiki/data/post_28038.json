th":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":204000,"discount_rate":57,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ec/98/01/cc69ad7dc812e423ec423c9e0ea9998e.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":905,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003chtml\u003e\n \u003chead\u003e\u003c/head\u003e\n \u003cbody\u003e\n  \u003cul\u003e\n   \u003cp\u003eMô tả sản phẩm:\u003c/p\u003e\n   \u003cp\u003e \u003c/p\u003e\n   \u003cp\u003e \u003c/p\u003e\n   \u003cp\u003eSản phẩm đã được kiểm nghiệm da liễu. An toàn cho mọi loại da.\u003c/p\u003e\n   \u003cp\u003e \u003c/p\u003e\n   \u003cp\u003eTinh chất Numee kiềm dầu, thu nhỏ lỗ chân lông 30ML\u003c/p\u003e\n   \u003cp\u003e \u003c/p\u003e\n   \u003cp\u003eCông dụng:\u003c/p\u003e\n   \u003cp\u003e \u003c/p\u003e\n   \u003cp\u003e+ Hoạt chất Pore Reductyl (3%) có trong chiết xuất nấm (Fomes officinalis): Là chất se khít lỗ chân lông tự nhiên dành cho da dầu và da hỗn hợp, khắc phục tình trạng tiết bã quá mức, làm mịn, căng mướt và giữ ẩm cho da.\u003c/p\u003e\n   \u003cp\u003e \u003c/p\u003e\n   \u003cp\u003e \u003c/p\u003e\n   \u003cp\u003e+ Muối kẽm (1%): giúp điều tiết lượng bã nhờn dư thừa.\u003c/p\u003e\n   \u003cp\u003e \u003c/p\u003e\n   \u003cp\u003eThành phần:\u003c/p\u003e\n   \u003cp\u003e \u003c/p\u003e\n   \u003cp\u003eAqua, Propanediol, Glycerin, Alcohol Denat., Glycereth-26, Salicylic Acid, Butylene Glycol, Sodium Hydroxide, Zinc Gluconate, Xanthan Gum, Fomes Officinalis Extract, Disodium EDTA, PEG-40 Hydrogenated Castor Oil, Phenoxyethanol.\u003c/p\u003e\n   \u003cp\u003e \u003c/p\u003e\n   \u003cp\u003eSản phẩm giúp giảm tiết bã nhờn trên da, cân bằng và giữ ẩm, giúp da mềm mại, tươi sáng\u003c/p\u003e\n   \u003cp\u003e \u003c/p\u003e\n   \u003cp\u003eHướng dẫn sử dụng:\u003c/p\u003e\n   \u003cp\u003e \u003c/p\u003e\n   \u003cp\u003eLấy 2-3 giọt ampoule và nhẹ nhàng thoa lên da theo chiều từ trong ra ngoài, bắt đầu từ cằm đến trán, mũi, miệng và cổ. Massage toàn bộ khuôn mặt sau đó vỗ nhẹ bằng lòng bàn tay để các dưỡng chất được thẩm thấu tốt nhất.\u003c/p\u003e\n   \u003cp\u003e \u003c/p\u003e\n   \u003cp\u003eBảo quản: Bảo quản nơi thoáng mát, tránh ánh nắng trực tiếp của mặt trời và tầm tay trẻ em.\u003c/p\u003e\n   \u003cp\u003e \u003c/p\u003e\n   \u003cp\u003eXuất xứ: Tây Ban Nha\u003c/p\u003e\n   \u003cp\u003e \u003c/p\u003e\n   \u003cp\u003eThông tin thương hiệu:\u003c/p\u003e\n   \u003cp\u003e \u003c/p\u003e\n   \u003cp\u003eNUMEE – VẺ ĐẸP MỚI CHO LÀN DA\u003c/p\u003e\n   \u003cp\u003e \u003c/p\u003e\n   \u003cp\u003eNumee hiện đang trở thành thương hiệu làm đẹp được yêu thích tại Tây Ban Nha và tạo nên những xu hướng mới lan rộng trên toàn thế giới, trong đó có Việt Nam. Mục đích lớn nhất của Numee chính là giúp khách hàng có thể tiếp cận được với mỹ phẩm SẠCH, thành phần thiên nhiên cùng công thức tuyệt vời với giá thành hợp lý nhất.\u003c/p\u003e\n   \u003cp\u003e \u003c/p\u003e\n   \u003cp\u003eĐặc biệt, sản phẩm từ Numee sẽ giúp bạn có các giải pháp chăm sóc da an toàn, dịu nhẹ và rất thân thiện với môi trường. Đây cũng chính là điều tuyệt vời thể hiện sự trân trọng, góp phần bảo vệ môi trường sống ngày càng tốt đẹp hơn. Bên cạnh đó, Numee rất chú trọng về màu sắc, thiết kế để tạo nên những sản phẩm đẹp về hình thức cùng chất lượng vượt trội.\u003c/p\u003e\n   \u003cp\u003e \u003c/p\u003e\n   \u003cp\u003eCó mặt tại Việt Nam từ cuối năm 2021 do DaiLinh Group tiên phong phân phối độc quyền trên thị trường Việt, các sản phẩm chăm sóc da của Numee hứa hẹn sẽ trở thành một trong những thương hiệu làm đẹp chất lượng, uy tín và được khách hàng tin dùng.\u003c/p\u003e\n  \u003c/ul\u003e\n \u003c/body\u003e\n\u003c/html\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ec/98/01/cc69ad7dc812e423ec423c9e0ea9998e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ec/98/01/cc69ad7dc812e423ec423c9e0ea9998e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ec/98/01/cc69ad7dc812e423ec423c9e0ea9998e.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ec/98/01/cc69ad7dc812e423ec423c9e0ea9998e.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ec/98/01/cc69ad7dc812e423ec423c9e0ea9998e.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/90/a4/a4/1510c8fa777c47a4ce770b49343f1a56.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/90/a4/a4/1510c8fa777c47a4ce770b49343f1a56.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/90/a4/a4/1510c8fa777c47a4ce770b49343f1a56.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/90/a4/a4/1510c8fa777c47a4ce770b49343f1a56.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/90/a4/a4/1510c8fa777c47a4ce770b49343f1a56.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/ff/31/99/05101a3555799d63c9811d93df3ecad6.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ff/31/99/05101a3555799d63c9811d93df3ecad6.jpg","medium_url":"https://sal