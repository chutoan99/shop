t_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":5550000,"discount_rate":65,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/18/4d/33/0247d9d9c698bd364b5c09aaac7482e2.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":99,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eVali IT Luggage IT12-2644-E08 - Bước đột phá của thương hiệu Anh Quốc. IT12-2644-E08 với thiết kế độc đáo, và chất liệu mới lạ - chính là siêu phẩm mới của ngành hành lý, một sản phẩm thân thiện với môi trường.\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/91/7f/a6/9ae5b89a2a779d2b908fb0c0d8f02e03.png\" alt=\"\" width=\"750\" height=\"1061\" /\u003e\u003c/p\u003e\n\u003cp\u003eIT12-2644-E08 được gọi là vali thân thiện với môi trường, vì nó được làm từ chất liệu vải có nguồn gốc từ chai nhựa PET dùng một lần. Sau khi được tái chế, chúng sẽ trở thành một loại vải polyester bền, mang lại sức sống mới dưới hình dạng một chiếc vali IT12-2644-E08. Tem chứng nhận GRS được khâu một cách nổi bật bên ngoài như minh chứng cho sự uy tín của thương hiệu.\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/a8/3e/df/5933fa83b66fe3266354e46dc324ee1a.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eMột ưu điểm không thể không nhắc đến của các vali thương hiệu quốc tế, đó chính là khóa số TSA bảo mật an toàn. Ngăn mở rộng của IT12-2644-E08 được thiết kế bên dưới không chỉ giúp vali thêm phần thẩm mỹ mà còn giúp cung cấp thêm không gian mà không ảnh hưởng đến độ ổn định của sản phẩm.\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/b8/27/1a/f68d5219a05506cf8c01cbbe230c739c.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eHệ thống 8 bánh xe được thiết kế thông minh giúp dễ dàng kiểm soát, di chuyển êm mượt trên mọi hành trình.\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/d9/cc/93/c4ed00fef543ddf658b53da66b347e8c.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eNgăn nội thất được phân chia khoa học hợp lý, với 1 ngăn chính và 2 ngăn phụ có lớp lót đầy đủ chống thấm. Sở hữu 2 dây đai vải chống giãn thông minh giúp cố định quần áo.\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/50/66/81/df5727a229ba849631905043a4517945.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eVới tất cả những ưu điểm này, IT12-2644-E08 sẽ mang lại niềm vui cho chuyến du lịch của bạn!\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/18/4d/33/0247d9d9c698bd364b5c09aaac7482e2.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/18/4d/33/0247d9d9c698bd364b5c09aaac7482e2.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/18/4d/33/0247d9d9c698bd364b5c09aaac7482e2.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/18/4d/33/0247d9d9c698bd364b5c09aaac7482e2.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/18/4d/33/0247d9d9c698bd364b5c09aaac7482e2.png"},{"base_url":"https://salt.tikicdn.com/ts/product/dc/01/c0/ab8b182a09ff2357a86765ea795b4b47.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/dc/01/c0/ab8b182a09ff2357a86765ea795b4b47.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/dc/01/c0/ab8b182a09ff2357a86765ea795b4b47.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/dc/01/c0/ab8b182a09ff2357a86765ea795b4b47.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/dc/01/c0/ab8b182a09ff2357a86765ea795b4b47.png"},{"base_url":"https://salt.tikicdn.com/ts/product/53/0b/b2/bfa069bc9d185f27a3a2d5ffe743b3df.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/53/0b/b2/bfa069bc9d185f27a3a2d5ffe743b3df.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/53/0b/b2/bfa069bc9d185f27a3a2d5ffe743b3df.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/53/0b/b2/bfa069bc9d185f27a3a2d5ffe743b3df.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/53/0b/b2/bfa069bc9d185f27a3a2d5ffe743b3df.png"},{"base_url":"https://salt.tikicdn.com/ts/product/50/d2/72/291f14bbc2f229735b6167d506d75eff.png","is_gallery":true,"label":null,"large_url":"ht