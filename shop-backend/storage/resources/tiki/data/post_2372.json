null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":158700,"discount_rate":30,"rating_average":4,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/cc/dd/05/3b3048fc7db6473eed94516781e58957.jpeg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1391,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eKem Chống Nắng Cho Da Mụn, Nhạy Cảm FIXDERMA Shadow SPF 30 Transparent Silicone Gel 30g Mỏng Nhẹ, Chống Nước - Hùng Lợi\u003c/p\u003e\n\u003cp\u003eCÔNG DỤNG CHÍNH\u003c/p\u003e\n\u003cp\u003eFixderma Shadow SPF 30 Transparent Silicone là Gel chống nắng chống trôi, trong suốt, có tác dụng chống nắng hiệu quả, bảo vệ làn da khỏi tác hại của ánh nắng mặt trời.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eĐẶC TÍNH NỔI BẬT\u003c/p\u003e\n\u003cp\u003e- Gel 100% trong suốt là điểm cộng rất tuyệt vời của sản phẩm\u003c/p\u003e\n\u003cp\u003e- Không hương liệu\u003c/p\u003e\n\u003cp\u003e- Không bết dính, không nhờn dính và nhanh chóng tán đều.\u003c/p\u003e\n\u003cp\u003e- Lý tưởng cho da dầu và da thường\u003c/p\u003e\n\u003cp\u003e- Khả năng bảo vệ và chống tia cực tím cao\u003c/p\u003e\n\u003cp\u003e- Cung cấp khả năng chống nắng tuyệt vời và không để lại cặn trên da.\u003c/p\u003e\n\u003cp\u003e- Khả năng chống nước, chống trôi, bám sâu\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eTHÀNH PHẦN CHÍNH\u003c/p\u003e\n\u003cp\u003e Octyl methoxycinnamate:\u003c/p\u003e\n\u003cp\u003e- Là hoạt chất chống nắng lâu đời và phổ biến nhất được sử dụng để bảo vệ da, chủ yếu chống lại tia UVB\u003c/p\u003e\n\u003cp\u003e- Hấp thụ bức xạ UVB ở bước sóng 280-320 nm\u003c/p\u003e\n\u003cp\u003e- Bảo vệ da khỏi tác hại của tia UVB\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e Avobenzone:\u003c/p\u003e\n\u003cp\u003e- Ngăn chặn tia UVA và UVB\u003c/p\u003e\n\u003cp\u003e- Bảo vệ da khỏi tác động của ánh nắng mặt trời\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e Benzophenone-3:\u003c/p\u003e\n\u003cp\u003e- Hấp thụ tia UV và phân tán dưới dạng nhiệt\u003c/p\u003e\n\u003cp\u003e- Chống nắng và bảo vệ da khỏi các tổn thương bởi tia UV gây ra\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e Coffea Arabica (Coffee) Seed Oil:\u003c/p\u003e\n\u003cp\u003e- Là dầu hạt cà phê arabica, có nồng độ cao các axit béo thiết yếu, sterol và vitamin E\u003c/p\u003e\n\u003cp\u003e- Chống oxy hóa mạnh, có thể bảo vệ chống lại tổn thương da như hình thành tế bào cháy nắng\u003c/p\u003e\n\u003cp\u003e- Hỗ trợ ngăn ngừa sự phát triển của các rối loạn lão hóa da và viêm da\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eHƯỚNG DẪN SỬ DỤNG\u003c/p\u003e\n\u003cp\u003e- Dùng đầu ngón tay thoa gel lên mặt, cổ và ngực 15 phút trước khi ra nắng.\u003c/p\u003e\n\u003cp\u003e- Thoa lại sau khi bơi, đổ nhiều mồ hôi, hoạt động thể chất hoặc khi cần thiết\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eCÁCH BẢO QUẢN:\u003c/p\u003e\n\u003cp\u003eHướng dẫn bảo quản: Giữ sản phẩm ở nơi khô và mát. Tránh làm đông lạnh.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eQuy cách đóng gói: Tuýp 30g\u003c/p\u003e\n\u003cp\u003eThương hiệu: Fixderma\u003c/p\u003e\n\u003cp\u003eXuất xứ thương hiệu: USA – Mỹ\u003c/p\u003e\n\u003cp\u003eNơi sản xuất: Ấn Độ\u003c/p\u003e\n\u003cp\u003e----\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eThông tin Thương hiệu\u003c/p\u003e\n\u003cp\u003eFIXDERMA có trụ sở tại Delaware - Mỹ và có nhà máy đặt tại Ấn Độ. Mục tiêu phát triển công nghệ chăm sóc da chuyên về da liễu. Luôn ứng dụng cá