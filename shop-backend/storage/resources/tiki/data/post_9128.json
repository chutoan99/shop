:null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":103000,"discount_rate":23,"rating_average":4.8,"review_count":12,"review_text":"(12)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/78/d1/62/3da31d1d08b95b4d279304e9bb4f3d2c.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":666,"all_time_quantity_sold":50,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cdiv class=\"ui-title-bar__heading-group\"\u003e\n\u003ch2\u003eGiới Thiệu Cáp Sạc Nhanh Đa Năng 2 to 3 Baseus Flash Series Ⅱ 100W (USB + Type C to Type C + Iphone + Micro USB, 1.2m Fast Charge Cable)\u003c/h2\u003e\n\u003ch1 class=\"ui-title-bar__title\"\u003e \u003c/h1\u003e\n\u003cp\u003e- Là phiên bản nâng cấp nhẹ của dòng Cáp sạc nhanh 3 đầu Baseus Flash Series . Sản phẩm được trang bị thêm 1 đầu chuyển USB sang Type C ở ngỏ vào giúp gia tăng đáng kể khả năng tương thích của cáp . Cáp sạc nhanh 3 đầu Baseus Flash Series 6in1 thật sự là một sợi cáp đa năng vì nó gần như có thể sử dụng được cho hầu hết các thiết bị số từ các model cũ đến các model mới nhất hiện nay.\u003c/p\u003e\n\u003cp\u003e- Với 1 đầu chuyển đổi usb A \u0026amp; usb C cho phép bạn sử dụng bất cứ củ sạc phổ biến hiện này không cần phải mang theo nhiều cáp sạc như trước. Đặc biệt với công suất sạc siêu nhanh lên đến 100W giúp bạn có thể sạc tất cả thiết bị số hiện nay như : Macbook, Laptop, Tablet, Smartphone, bạn còn có thể truyền dữ liệu với 2 cổng type c, iphone với tốc độ truyền 480mbps\u003c/p\u003e\n\u003cp\u003e- Đầu nối và giao diện cắm được gia công từ vật liệu hợp kim nhôm, nhựa cao cấp không chỉ cho độ bền cực kì cao mà còn đảm bảo được tính an toàn và thân thiện với môi trường. Chất liệu nylon dệt kim bao bọc bên ngoài góp phần ngăn chặn tình trạng rối dây, gãy gập và cách điện hiệu quả.\u003c/p\u003e\n\u003cp\u003e- Cáp sạc với chiều dài tiêu chuẩn là 1.2m, dài hơn so với những sợi cáp thông thường giúp bạn thuận tiện sạc pin ở khoảng cách xa mà không gặp bất kì vướng víu nào. Ngoài ra, kết cấu nhỏ gọn cũng giúp người dùng dễ dàng bỏ túi mang theo sử dụng trong những chuyến đi du lịch, công tác xa.\u003c/p\u003e\n\u003cp\u003e- Cáp sạc nhanh 3 đầu Baseus Flash Series 6 in 1 còn được trang bị đèn LED báo tình trạng và tốc độ sạc pin, giúp sử dụng thuận tiện hơn.\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e(Lưu ý : Sản phẩm không hỗ trợ sạc pin và đồng bộ dữ liệu từ Macbook sang Smartphone)\u003c/em\u003e3 Baseus Flash Series Ⅱ 100W (USB + Type C to Type C + iphone + Micro USB, 1.2m Fast Charge Cable)\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://file.hstatic.net/1000152881/file/0_01_986a37c9496e4261a87b6c4a4da13183.jpg\" alt=\"0_01_986a37c9496e4261a87b6c4a4da13183.jpg\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://file.hstatic.net/1000152881/file/0_02_099f5a8c42e6411f873383ca1ee6e4c3.jpg\" alt=\"0_02_099f5a8c42e6411f873383ca1ee6e4c3.jpg\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://file.hstatic.net/1000152881/file/0_03_0dfc1af096e1413fb080af20da68cf86.jpg\" alt=\"0_03_0dfc1af096e1413fb080af20da68cf86.jpg\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://file.hstatic.net/1000152881/file/0_04_cb13e0dbcc7f4508863dd8b5f7e846e3.jpg\" alt=\"0_04_cb13e0dbcc7f4508863dd8b5f7e846e3.jpg\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://file.hstatic.net/1000152881/file/0_05_5877c3a