xt_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"defective_product"}},"discount":400000,"discount_rate":13,"rating_average":4,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/2a/cb/98/a8cd7e15caedcfbf77bc7bf48f4063db.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":157,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eNhóm nước hoa: Hương Thơm Biển\u003c/p\u003e\n\u003cp\u003eGiới tính: Nam\u003c/p\u003e\n\u003cp\u003eNăm ra mắt: 2022\u003c/p\u003e\n\u003cp\u003eNồng độ: Eau De Parfum (EDP)\u003c/p\u003e\n\u003cp\u003ePhong Cách: Hấp Dẫn, Tươi Mát Tinh Tế, Nam Tính\u003c/p\u003e\n\u003cp\u003eHương đầu: Hương Biển, Cam, Quýt\u003c/p\u003e\n\u003cp\u003eHương giữa: Hoa Oải Hương, Hoa Phong Lữ, Thảo Mộc, Hổ Phách\u003c/p\u003e\n\u003cp\u003eHương cuối: Đá Khoáng, Cỏ Vetiver, Hoắc Hương.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cdiv class=\"kvgmc6g5 cxmmr5t8 oygrvhab hcukyx3x c1et5uql ii04i59q\"\u003e\n\u003cdiv style=\"text-align:center\"\u003eGiorgio Armani Acqua Di Gio Eau De Parfum Pour Homme New 2022 – Giò Trắng EDP\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv\u003eNếu bạn yêu thích mùi hương tươi mát, không tuổi của Acqua Di Giò nhưng vẫn lăn tăn về độ bám toả không được tốt lắm thì Lợi đã về bản Giorgio Armani Acqua Di Gio Eau De Parfum với nồng độ được nâng cấp lên thành EDP so với EDT trước đó thì ngon hơn, thơm hơn, đậm và bám toả tốt hơn là điều không thể tránh khỏi.\u003c/div\u003e\n\u003cdiv class=\"kvgmc6g5 cxmmr5t8 oygrvhab hcukyx3x c1et5uql ii04i59q\"\u003e\n\u003cdiv\u003e\u003cimg class=\"aligncenter wp-image-38031\" style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/5d/17/2a/9fc3c865c353ec10923143638a74ac3b.jpg\" alt=\"Giorgio Armani Acqua Di Gio Pour Homme EDP 1 3 - N - Nước hoa cao cấp, chính hãng giá tốt, mẫu mới\" width=\"550\" height=\"555\" /\u003e\u003c/div\u003e\n\u003cdiv\u003e\n\u003cp\u003eGiorgio Armani Acqua Di Gio Eau De Parfum mô tả về một không gian rộng lớn và vô tận như đang đắm mình vào biển cả, không giới hạn, không chút áp lực và không có sự hạn chế. Hương thơm của Khoáng chất kết hợp cùng Quýt xanh, dịu ngọt nhưng cực tươi mát, lại càng nhấn mạnh vẻ đẹp của biển cả. Càng về sau, hương thơm càng nồng ấm, hoang dại của Xô thơm lẫn trong cái kết cấu phức tạp của Chi Mỏ hạc, tạo nên cái trầm lắng bên trong mỗi quý ông.\u003c/p\u003e\n\u003cp\u003eĐể rồi người đàn ông ấy quyến luyến mọi cô gái bằng sự phóng khoáng, lơ đãng của mình. Thoảng hoặc theo đó chút Cỏ Hương bài, chút Hoắc hương nồng đượm hương Gỗ đặc trưng. Những nốt hương trong Giorgio Armani Acqua di Gio EDP đan xen tựa hệt cảm xúc biến chuyển của một gã trai hiện đại, và bên trong họ là những phần tâm hồn tươi tắn, phóng khoáng.\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"cxmmr5t8 oygrvhab hcukyx3x c1et5uql o9v6fnle ii04i59q\"\u003e\n\u003cdiv\u003e\u003cimg class=\"aligncenter wp-image-38030\" style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/11/63/c4/56a833650677cc244bcdc0c9db42dd1d.jpg\" alt=\"Giorgio Armani Acqua Di Gio Pour Homme EDP 14 - N - Nước hoa cao cấp, chính hãng giá tốt, mẫu mới\" width=\"600\" height=\"374\" /\u003e\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"cxmmr5t8 oygrvhab hcukyx3x c1et5uql o9v6fnle ii04i59q\"\u003e\n\u003cdiv\u003eNhìn chung, Giorgio Armani Acqua Di Gio Eau De Parfum là một phiên bản hương thơm được hoàn thiện tốt, kế thừa và phát huy DNA timeless sẵn có của nguyên bản Acqua Di Gio. Một phiên bản hiện đại hơn so với bản gốc, và cho ta có cảm giác giản dị hơn. Đây không phải là sự thay thế cho EDT, nhưng sẽ là một phiên bản chất lượng, một sự bổ sung hữu ích cho collection Acqua Di Gio của hãng.\u003c/div\u003e\n\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/2a/cb/98/a8cd7e15caedcfbf77bc7bf48f4063db.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/2a/cb/98/a8cd7e15caedcfbf77bc7bf48f4063db.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/2a/cb/98/a8cd7e15caedcfbf77bc7bf48f4063db.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2a/cb/98/a8cd7e15caedcfbf77bc7bf48f4063db.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2a/cb/98/a8cd7e15caedcfbf77bc7bf48f4063db.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/cc/ed/4f/57d726bb7359fd4608793c1ff4636f15.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/cc/ed/4f/57d726bb7359fd4608793c1ff4636f15.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/cc/ed/4f/57