//salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/14/46/6a/b6ec8e3ce79ff6a6ccdcae0807d9d010.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":306,"all_time_quantity_sold":16,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3 class=\"irIKAp\"\u003e\u003cstrong\u003eGiới thiệu\u003c/strong\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli class=\"irIKAp\"\u003eHegen là thương hiệu hàng đầu hiện nay, chuyên cung cấp các dòng sản phẩm dành cho mẹ và bé, thương hiệu Hegen rất được các mẹ quan tâm và yêu thích vì chất lượng sản phẩm theo tiêu chuẩn Châu Âu. Bình sữa Hegen – bình sữa duy nhất LỚN LÊN CÙNG CON với thiết kế núm ti thay đổi qua các bước: núm ti được thiết kế theo hình elip mô phỏng giống như ti mẹ, giúp bé có thể chuyển đổi từ ti mẹ sang ti bình một cách dễ dàng, các kích thước núm ti cho bé từ 0+ và 3+ chuyển sang núm ti cho bé 6+. Bình sữa Hegen mang đến giải pháp hoàn hảo giúp bé chuyển đổi từ bú mẹ qua bú bình dễ dàng.\u003c/li\u003e\n\u003cli class=\"irIKAp\"\u003eBình sữa Hegen là một sản phẩm mang tính cách mạng độc đáo trên thế giới với thiết kế ấn để đóng - xoay nhẹ để mở, không thiết kế nắp xoay/vặn như các loại bình sữa khác. Hegen luôn muốn dành những điều tốt đẹp nhất cho mẹ và bé, nên tất cả sản phẩm đều được nghiên cứu và chọn lựa một cách kỹ lưỡng.\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003eChất liệu\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cp\u003e\u003cstrong\u003eChất liệu nhựa PPSU (Polyphenylsulfone)\u003c/strong\u003e: Bình sữa Hegen thường được làm từ chất liệu nhựa PPSU, có khả năng chịu nhiệt và độ bền cao. Nhựa PPSU cũng không chứa BPA (Bisphenol A), phthalates và các chất độc hại khác, đảm bảo an toàn cho sức khỏe của bé.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003e\u003cstrong\u003eDung tích đa dạng\u003c/strong\u003e: Bình sữa Hegen có thể có dung tích 150ml, 240ml hoặc 330ml, giúp bạn lựa chọn dung tích phù hợp với nhu cầu và giai đoạn phát triển của bé.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003e\u003cstrong\u003eNúm ty silicone mềm mại\u003c/strong\u003e: Núm ty của bình sữa Hegen thường được làm từ silicone mềm mại, giúp bé bú dễ dàng và tự nhiên hơn.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003e\u003cstrong\u003eDễ vệ sinh và bảo quản\u003c/strong\u003e: Bình sữa Hegen có thiết kế không góc cạnh, dễ dàng làm sạch và vệ sinh. Đồng thời, chúng cũng dễ dàng lắp ráp và tháo rời để bảo quản và di chuyển.\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003eĐặc điểm nổi bật\u003c/h3\u003e\n\u003cul\u003e\n\u003cli class=\"irIKAp\"\u003eBình sữa Hegen được thiết kế độc đáo, chỉ cần ấn để đóng và xoay nhẹ để mở, tránh gây sự bất tiện cho bố mẹ khi đang một tay bế bé và một tay mở nắp bình sữa.\u003c/li\u003e\n\u003cli class=\"irIKAp\"\u003eThiết kế bình sữa hình vuông mềm mại độc quyền của Hegen giúp tránh ngã đỗ bình sữa.\u003c/li\u003e\n\u003cli class=\"irIKAp\"\u003eĐặc biệt, với thiết kế thông minh và đơn giản của van chống sặc, tránh nguy cơ mắc các bệnh đường ruột ở bé. Hệ thống van thông khí phân phối lượng sữa cho bé, giảm tình trạng nổi bọt khí ở sữa làm mất các chất dinh dưỡng trong sữa và tránh tình trạng gây đau bụng cho bé.\u003c/li\u003e\n\u003cli class=\"irIKAp\"\u003eThiết kế núm ti hình elips mô phỏng giống như ti mẹ, giúp bé có thể chuyển đổi từ ti mẹ sang ti bình một cách dễ dàng, núm ti được thiết kế về một bên để bé có thể ti ở tư thế thẳng, tự nhiên.\u003c/li\u003e\n\u003cli class=\"irIKAp\"\u003eBình sữa Hegen được thiết kế với cổ bình rộng, bề mặt bên trong bình trơn lán, và các chi tiết khác được thiết kế tối ưu, giúp các mẹ vệ sinh bình sữa vô cũng dễ dàng, đỡ mất nhiều thời gian.\u003c/li\u003e\n\u003cli class=\"irIKAp\"\u003eNúm ti Hegen có nhiều kích cỡ khác nhau (được bán riêng) để các mẹ có thể thay đổi và lựa chọn các size núm ti (chậm, trung bình, nhanh, dành cho thức ăn sệt) phù hợp cho bé theo từng giai đoạn.\u003c/li\u003e\n\u003cli class=\"irIKAp\"\u003eNắp trữ sữa (được bán riêng) để mẹ có thể dễ dàng thay đổi phụ kiện bình sữa sang bình trữ sữa để kín khít để bảo quản sữa an toàn tuyệt đối.\u003c/li\u003e\n\u003cli class=\"irIKAp\"\u003eBình sữa Hegen cùng bé lớn lên theo từng giai đoạn phát triển của bé, bình Hegen ngoài việc là bình sữa cho bé ti mà còn có thể sử dụng như một cốc đựng đồ ăn dặm, thức ăn sệt, bánh quy, trái cây hoặc nước trái cây.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp class=\"irIKAp\"\u003eSize núm phù hợp với từng giai đoạn\u003c/p\u003e\n\u003cul\u003e\n\u003cli class=\"irIKAp\"\u003eBình 60ml đi kèm Núm số 0: cho bé sơ sinh ti chậm/ bé sinh sớm\u003c/li\u003e\n\u003cli class=\"irIKAp\"\u003eBình 150ml đi kèm Núm số 1: 0-3 tháng\u003c/li\u003e\n\u003cli class=\"irIKAp\"\u003eBình 240ml đi kèm Núm số 2: 3-6 tháng\u003c/li\u003e\n\u003cli class=\"irIKAp\"\u003eBình 330ml đi kèm Núm số 3: 6 tháng +\u003c/li\u003e\n\u003cli class=\"irIKAp\"\u003eNúm Y: 12m++ hoặc bé ăn bột dặm, sữa đêm\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003eHướng dẫn sử dụng\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eTrước khi sử dụng lần đầu tiên, rửa sạch bình, núm ti và ngâm trong nước nóng 5 phút để đảm bảo vệ sinh tuyệt đối\u003c/li\u003e\n\u003cli\u003eCho sữa mẹ hoặc sữa bột vào bình\u003c/li\u003e\n\u003cli\u003eLắp chặt nắp, cổ bình/núm ti vào bình và cho bé bú\u003c/li\u003e\n\u003cli\u003eKhi trẻ bú xong, cần tháo và rửa sạch toàn bộ các bộ phận của bình sữa\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eLưu ý:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eRửa sạch tay trước khi lắp bình\u003c/li\u003e\n\u003cli\u003eNhiệt độ sữa nên ở 37 độ C\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003eHướng dẫn bảo quản\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eBảo quản nơi khô ráo, thoáng mát\u003c/li\u003e\n\u003cli\u003eVệ sinh sạch sẽ và tiệt khuẩn trước và sau khi sử dụng\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eLưu ý:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eKhuyến khích nên tiệt trùng sản phẩm bằng nước ấm, trụng nước sôi hoặc máy tiệt trùng UV.\u003c/li\u003e\n\u003cli\u003eKhông nên đun sôi sản phẩm trên bếp hoặc tiệt trùng bằng hơi nước.\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/14/46/6a/b6ec8e3ce79ff6a6ccdcae0807d9d010.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/14/46/6a/b6ec8e3ce79ff6a6ccdcae0807d9d010.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/14/46/6a/b6ec8e3ce79ff6a6ccdcae0807d9d010.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/14/46/6a/b6ec8e3ce79ff6a6ccdcae0807d9d010.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/14/46/6a/b6ec8e3ce79ff6a6ccdcae0807d9d010.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/20/48/2a/7baf4afedd9e5e941ae6c14e65e37f6b.jpg","is_gallery":true,"label":null,"large_url":"https:/