e":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.6,"review_count":249,"review_text":"(249)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/18/dc/d1/654aaed939f80680bffa69207192cf36.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1778,"all_time_quantity_sold":1053,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2 style=\"text-align: center;\"\u003eThảm Tập Yoga Định Tuyến Chính Hãng Amalife + Bao Thảm Tập Yoga Định Tuyến + Dây Buộc Thảm\u003c/h2\u003e\n\u003cp style=\"text-align: center;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cstrong\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/a4/71/47/25ad9cc619d1b2a0f843238cba5e2d2d.jpg\" alt=\"Thảm Tập yoga Định Tuyến\" width=\"750\" height=\"750\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003ch2\u003e \u003c/h2\u003e\n\u003ch2\u003e\u003cstrong\u003eƯu điểm của Thảm Tập Yoga Định Tuyến Chính Hãng Amalife 2 lớp TPE so với các loại thảm thông thường:\u003c/strong\u003e\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cp\u003e\u003cstrong\u003eNguồn gốc xuất sứ \u003c/strong\u003eChính hãng Amalife - rõ ràng, đảm bảo và yên tâm.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003e\u003cstrong\u003eThiết kế: \u003c/strong\u003eThảm Tập Yoga Định Tuyến Chính Hãng Amalife được ứng dụng hệ thống kẻ định tuyến tiên tiến, tương tự như một công cụ điều hướng giúp bạn thực hiện các tư thế Yoga chuẩn xác nhất. Các đường kẻ trên thảm giúp tay và chân đều nhau khi tập luyện các tư thế, bảo vệ cho xương sống của bạn.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003e\u003cstrong\u003eĐường Định Tuyến Sắc Nét:\u003c/strong\u003e Thảm tập có 4 điểm đảo chiều được định vị sẵn trên thảm hỗ trợ định tuyến tay và chân khi bạn tập động tác ngửa người ra phía sau. Đường kẻ trung tâm định tuyến cân bằng chiều rộng hai bên thảm, có định vị trung tâm thảm bằng vị trí hoa sen.\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/e2/a5/39/0417d212202ce04cea5465656a64be08.png\" alt=\"Thảm Tập Yoga Định Tuyến\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cp\u003e\u003cstrong\u003eChất liệu:\u003c/strong\u003e Thảm được làm bằng chất liệu TPE, một loại mút xốp đàn hồi nhiệt dẻo thay thế cho dòng thảm làm bằng chất liệu PVC, giúp thảm có độ mềm mại và độ bám dính tốt, không độc  hại, không kích ứng da, thân thiện với môi trường.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003e\u003cstrong\u003eĐộ bám sàn:\u003c/strong\u003e Thảm có độ bám sàn cao, rất chắc chắn,  không gây trơn trượt nguy hiểm cho người tập, hỗ trợ tối đa cho các động tác khó. Sản phẩm được thiết kế giúp người tập có thể tập trung vào các động tác khó, kiểm soát được nhịp thở. Nhờ độ mềm mại và độ bám sàn cao, thảm còn giúp hỗ trợ tối ưu cho các tư thế thăng bằng và tư thế đứng.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003e\u003cstrong\u003eCất giữ và vận chuyển:\u003c/strong\u003e Thảm có kèm theo dây buộc và Bao đựng chuyên dụng, Khi tập xong, người tập chỉ việc cuộn thảm, dùng dây buộc lại là có thể cất thảm gọn gàng, sau đó bỏ vào bao đứng có quoai đeo vai nên dễ dàng vận chuyển đến các địa điểm khác nhau, thuận tiện mang đến nơi tập và mang về nhà.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003e\u003cstrong\u003eVệ sinh làm sạch:\u003c/strong\u003e Dễ dàng làm sạch thảm bằng cách sử dụng mút xốp để lau, sau đó phơi khô bằng không khí.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003e\u003cstrong\u003eKích thước:\u003c/strong\u003e 2 Kích Thước để Lựa Chọn: \u003cstrong\u003e0,8 x 183 x 60 cm và 0,6 x 183 x 60 cm\u003c/strong\u003e. Kích thước lớn đảm bảo diện tích tập luyện rộng rãi, thoải mái nhất. Độ dày tối ưu đảm bảo độ êm ái tốt nhất khi sử dụng.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003e\u003cstrong\u003eHình thức:\u003c/strong\u003e Thảm được làm bằng 2 lớp kết dính chắc chắn, màu sắc tinh tế, 2 mặt 2 màu khác nhau, tạo cảm hứng tập luyện.\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/14/5e/f3/65638cea6566e74f53894a866eafe75c.png\" alt=\"Thảm tập yoga định tuyến\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/25/ec/4c/409a5487ade154a260adf24e0c861ef0.png\" alt=\"Thảm tập Yoga Định Tuyến\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/f1/cc/5d/f94e03eacb269f20429cefce6971d7bc.png\" alt=\"Thảm tập yoga định tuyến\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eBao đựng thảm rộng rãi, có quai đeo vai tiện dụng khi mang thảm đến lớp tập:\u003c/strong\u003e\u003c/h2\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cstrong\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/6c/c0/c6/4e0c05d33644a9195b508a6c5f131320.jpg\" alt=\"Thảm tập yoga định tuyến\" width=\"750\" height=\"750\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eNhiều màu ngẫu nhiên:\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/1d/35/5e/5788c1da5d8f2e482723f9a4d2e2f2e8.png\" alt=\"Thảm tập Yoga Định Tuyến\" width=\"750\" height=\"750\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eHƯỚNG DẪN VỆ SINH THẢM TẬP YOGA ĐỊNH TUYẾN 2 Lớp TPE CHÍNH HÃNG:\u003c/strong\u003e\u003c/h2\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cstrong\u003e\u003cem\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/47/bb/0f/a3f3716848769065c54e15b4a0751727.jpg\" alt=\"Thảm Tập Yoga Định Tuyến\" width=\"700\" height=\"197\" /\u003e\u003c/em\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003ch2 style=\"text-align: left;\"\u003e\u003cstrong\u003e\u003cem\u003eLưu Ý Khi Vệ Sinh Thảm Yoga:     \u003c/em\u003e\u003c/strong\u003e\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cp\u003eKhi giặt sản phẩm thì bạn nên hòa loãng xà phòng cùng với một chút nước ấm sau đó chà qua thảm nhưng không dùng bàn chải sau đó mang thảm ra phơi ngoài nắng. Ngoài ra nếu bạn giặt bằng máy giặt thì nên để ở chế độ vừa phải.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eHầu hết các thảm trong lần đầu sử dụng đều có những mủn nhỏ bay ra và bạn có thể lau sạch nó bằng một miếng giẻ ướt. Nếu không bạn cứ sử dụng sau một thời gian những mủn đó sẽ tự hết. Tuy nhiên bạn không nên giặt quá nhiều xà phòng để tẩy.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eNếu trong trường hợp thảm của bạn chỉ bị bẩn nhẹ thì bạn chỉ cần xịt nhẹ một chút nước bằng chai xịt hay miêng vải ướt để lau rồi phơi khô trong không khí tự nhiên (Không phơi dưới ánh nắng mặt trời). Do được cấu tạo bằng chất cao su thiên nhiên nên chỉ cần một quá trình sử dụng sản phẩm có độ sáng lên rõ rệt và không còn mùi khó chịu.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eĐể rút ngắn thời gian phơi sản phẩm thì bạn dùng một chiếc khăn khô lau rồi mang ra phơi. Càng sử dụng các bạn càng thấy sản phẩm mềm hơn và có độ dai hơn\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/e5/26/63/63eec15f8c8ebd6eea8693ae7bf303d5.png\" alt=\"Thảm tập Yoga Định Tuyến\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/7f/f1/f3/f64add46b0d30fcebe30e27f07490ca2.png\" alt=\"Thảm Tập yoga Định Tuyến\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch3 style=\"text-align: center;\"\u003e\u003cspan style=\"color: #0000ff;\"\u003e\u003cem\u003e\u003cstrong\u003eSử dụng hàng chính hãng để tránh hàng giả, hàng nhái, hàng kém chất lượng.\u003c/strong\u003e\u003c/em\u003e\u003c/span\u003e\u003c/h3\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/18/dc/d1/654aaed939f80680bffa69207192cf36.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/18/dc/d1/654aaed939f80680bffa69207192cf36.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/18/dc/d1/654aaed939f80680bffa69207192cf36.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/18/dc/d1/654aaed939f80680bffa69207192cf36.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/18/dc/d1/654aaed939f80680bffa69207192cf36.png"},{"base_url":"https://salt.tikicdn.com/ts/product/91/5b/c0/8252bfb83b1616e48bd22c60f6d990c9.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/91/5b/c0/8252bfb83b1616e48bd22c60f6d990c9.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/91/5b/c0/8252bfb83b