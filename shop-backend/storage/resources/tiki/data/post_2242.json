,"icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.3,"review_count":78,"review_text":"(78)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/13/36/9f/e1b317ac4b41ec75ce6a8601bf2d400b.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1548,"all_time_quantity_sold":343,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eBỔ THẬN NAM TĂNG CƯỜNG SINH LÝ NAM, BỔ THẬN TRÁNG DƯƠNG\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eBổ thận, tráng dương, sinh tinh, tăng chất lượng tinh trùng\u003c/li\u003e\n\u003cli\u003eTăng cường khả năng sinh lý nam giới\u003c/li\u003e\n\u003cli\u003eTăng ham muốn, kéo dài thời gian quan hệ\u003c/li\u003e\n\u003cli\u003eHỗ trợ cải thiện khả năng sinh sản ở nam giới\u003c/li\u003e\n\u003cli\u003eTăng testosterone, giảm quá trình mãn dục ở nam giới\u003c/li\u003e\n\u003cli\u003eMạnh gân cốt, giảm đau lưng mỏi gối\u003c/li\u003e\n\u003cli\u003eGiúp cho nam giới luôn sung mãn, cuộc sống như ý\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/a0/45/fe/17d9d188ebf7cf22901a7ac5eb54e2a2.jpg\" alt=\"tăng cường sinh lý nam bổ thận nam\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eƯU DIỂM CỦA TĂNG CƯỜNG SINH LÝ NAM BỔ THẬN NAM\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/5e/f1/7d/3929ebb4b300c511233f522cc4101fc7.jpg\" alt=\"tăng cường sinh lý nam bổ thận nam\" width=\"750\" height=\"545\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003e\u003cstrong\u003eTHÀNH PHẦN CHÍNH VÀ CÔNG DỤNG BỔ THẬN NAM\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli style=\"text-align: left;\"\u003eThục địa: là vị chủ lực của nhiều sản phẩm bổ thận, hiệu quả tăng cường sức khỏe, đặc biệt sức khỏe sinh lý. Tăng tác dụng bổ thận, bổ huyết, hiệu quả trong cải thiện tình trạng sinh lý yếu, yếu thận, mệt mỏi, di tinh, mộng tinh.\u003c/li\u003e\n\u003cli style=\"text-align: left;\"\u003eBa kích: Tác dụng ôn thận, trợ dương, mạnh gân cốt. Hỗ trợ chữa chứng đau lưng, tê chân, mỏi gối.\u003c/li\u003e\n\u003cli style=\"text-align: left;\"\u003eTục đoạn: Chữa thận hư, lưng đau, chân yếu, gẫy xương.\u003c/li\u003e\n\u003cli style=\"text-align: left;\"\u003eCâu kỳ tử: dược liệu bổ toàn thân, bổ can thận, mạnh gân cốt. Chữa chân tay yếu mỏi, mắt mờ, di mộng tinh.\u003c/li\u003e\n\u003cli style=\"text-align: left;\"\u003eNhục thung dung: Tác dụng bổ thận,ích tinh, huyết. Dùng cho nam giới liệt dương, lưng gối lạnh đau, cơ bắp không có sức, huyết khô, tiện bí…\u003c/li\u003e\n\u003cli style=\"text-align: left;\"\u003eNhân sâm: chứa nhiều ginsenoside giúp cải thiện và tăng đáng kể hàmlượng testosterone ở nam giới, làm tăng cảm giác hung phấn, tăng cường sinh lý nam.\u003c/li\u003e\n\u003cli style=\"text-align: left;\"\u003eNhung hươu: Bổ thận, cường dương, sinh tinh. Tăng cường sức mạnh cơ bắp.\u003c/li\u003e\n\u003cli style=\"text-align: left;\"\u003eCao Ban long: Tăng cường chức năng sinh lý, cường dương, sinh tinh, chữa di tinh, mộng tinh, xuất tinh sớm. Mạnh gân cốt.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/64/9b/75/19314d44c3eba76ac442af542ab2919c.jpg\" alt=\"bổ thận nam tăng cường sinh lý nam\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eĐỐI TƯỢNG SỬ DỤNG\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eNam giới trưởng thành yếu sinh lý, mãn dục nam sớm. Nam giới có chức năng thận yếu.\u003c/li\u003e\n\u003cli\u003eNgười hay ay đau lưng, mỏi gối, tiểu nhiều lần, tiểu rắt, tiểu không tự chủ.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eCÁCH SỬ DỤNG HIỆU QUẢ\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eUống tăng cường : Uống 2 viên/lần, 2 lần/ngày.\u003c/li\u003e\n\u003cli\u003eUống duy trì : 1 viên/ lần, 2 lần/ngày\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eLƯU Ý KHI SỬ DỤNG\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eBảo quản nơi khô ráo thoáng mát, tránh ánh nắng\u003c/li\u003e\n\u003cli\u003eThực phẩm này không phải là thuốc, không có tác dụng thay thế thuốc chữa bệnh\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/13/36/9f/e1b317ac4b41ec75ce6a8601bf2d400b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/13/36/9f/e1b317ac4b41ec75ce6a8601bf2d400b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/13/36/9f/e1b317ac4b41ec75ce6a8601bf2d400b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/13/36/9f/e1b317ac4b41ec75ce6a8601bf2d400b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/pr