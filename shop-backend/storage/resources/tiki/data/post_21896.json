_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":10000,"discount_rate":7,"rating_average":4,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/79/47/4d/86c579476c67f7659012ea455848db0e.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":109,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\n\u003cp\u003e\u003cspan\u003eĐèn học LED 3 loại ánh sáng bảo vệ mắt chống cận cảm ứng Rhino L205, tích điện đa năng làm việc, để bàn học, đọc sách, đèn ngủ nhiều chế độ sáng, đèn LED chính hãng\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/da/2f/61/7378953120b9d10ebff04833b2a3be63.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003cbr /\u003e1. Thông tin chi tiết\u003cbr /\u003e\u003cbr /\u003eĐèn học, đèn làm việc, đèn đọc sách, đèn ngủ có 3 chế độ ánh sáng: Ánh sáng trắng, ánh sáng vàng, ánh sáng ấm( trắng vàng) có cơ chế tích điện bền bỉ, thời gian sử dụng lâu dài.\u003cbr /\u003eĐiều khiển bằng cảm ứng lâu hỏng, thiết kế dạng vuông vắn, có thể gập tiện lợi, có cảm giác sang trọng gắn kèm hỗ trợ giá đỡ điện thoại phù hợp là quà tặng cho người bạn yêu thương.\u003cbr /\u003e\u003cbr /\u003e2. Thông số sản phẩm\u003cbr /\u003e\u003cbr /\u003e- Ánh sáng: Trắng, Vàng, Ấm chống cận thị\u003cbr /\u003e- 3 chế độ sáng: sáng nhẹ, sáng vừa và sáng mạnh, Chạm giữ nút nguồn để điều chỉnh tỉ lệ sáng mạnh yếu theo ý muốn\u003cbr /\u003e- Thời gian sạc : 1 giờ\u003cbr /\u003e- Thời gian sử dụng :1 giờ\u003cbr /\u003e- Nguồn điện: 5V (có thể cắm điện dùng trực tiếp)\u003cbr /\u003e- Cổng giao tiếp: USB - Micro\u003cbr /\u003e- Công suất: 10w\u003cbr /\u003e- Chất liệu: nhựa ABS\u003cbr /\u003e-Kích thước đèn: độ dài đèn - chiều cao thân đèn - chiều rộng đế: 46cm - 34cm - 13cm\u003cbr /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/3b/12/89/87b3dab415c1c9b619507977285f2489.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003cbr /\u003e3. Hướng dẫn sử dụng\u003cbr /\u003e\u003cbr /\u003e- Cắm dây sạc vào đèn, đầu usb còn lại cắm vào máy tính, laptop, củ sạc, sạc dự phòng,\u003cbr /\u003e- Cách sạc khi bắt đầu sử dụng:\u003cbr /\u003e+ Đối với loại tích điện: cắm sạc cảm ứng nút nguồn sử dụng như đèn bình thường, pin được sạc đầy từ 30p - 1h giờ, sử dụng tích điện trong 1h-1h30p. đèn sẽ yếu khi sắp hết tích điện.\u003cbr /\u003e+ Đối với loại không tích điện: cắm sạc 1 phút rồi cảm ứng nút nguồn bật đèn lên sử dụng.\u003cbr /\u003e- Ấn nút nguồn 1 lần để bật đèn\u003cbr /\u003e+ Ấn 1 lần tiếp theo để thay đổ ánh sáng. Bấm tiếp để tắt đèn.\u003cbr /\u003e+ Ấn giữ nút nguồn để thay đổi độ sáng, thả tay ấn giữ lần nữa để thay đổi độ sáng ngược lại.\u003cbr /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/0e/96/a8/889648ceb5bac1e04eb78d05c593b8a9.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003cbr /\u003e4. Cam kết\u003cbr /\u003e\u003cbr /\u003e- 100% sản phẩm chính hãng, nguồn gốc xuất xứ rõ ràng\u003cbr /\u003e- Sản phẩm đẹp, chất lượng\u003cbr /\u003e- Được kiểm định chất lượng giúp người dùng yên tâm khi mua hàng\u003cbr /\u003e- Đóng gói, bọc kĩ càng khi vận chuyển đến tay người dùng một cách cẩn thận nhất\u003cbr /\u003e\u003cbr /\u003e\u003cbr /\u003e#rhino #Rhinostore #Rhinostoreofficial #denL205 #L205 #denhoc #dencamung #dendocsach #denngu # denhoccamung #denleddocsach #den3chedo #denhocled #dennguled #dengapgon #denchinhhang #dengiatot #denhocgiare #dentichdien #denhoctichdien #denledtichdien\u003cbr /\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/79/47/4d/86c579476c67f7659012ea455848db0e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/79/47/4d/86c579476c67f7659012ea455848db0e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/79/47/4d/86c579476c67f7659012ea455848db0e.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/79/47/4d/86c579476c67f7659012ea455848db0e.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/79/47/4d/86c579476c67f7659012ea455848db0e.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/11/bb/56/f98d9d8416d0df4a49112dea6eaaa684.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/11/bb/56/f98d9d8416d0df4a49112dea6eaaa684.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/11/bb/56/f98d9d8416d0df4a49112dea6eaaa684.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/11/bb/56/f98d9d8416d0df4a49112dea6eaaa684.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/11/bb/56/f98d9d8416d0df4a49112dea6eaaa684.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/f7/f6/05/503ace82c506f4c7510e2412d175f081.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f7/f6/05/503ace82c506f4c7510e2412d175f081.jpg","medium_url":"https://sal