t":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/8d/b9/39/6cb5a2f2dd89e0392d7fc9ae91fab673.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":21,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch1 class=\"product-title product_title entry-title\"\u003eĐồng tiền lên ngôi\u003c/h1\u003e\n\u003cdiv class=\"product-short-description\"\u003e\n\u003cp\u003e\u003cstrong\u003eTác\u003c/strong\u003e \u003cstrong\u003egiả\u003c/strong\u003e\u003cstrong\u003e: \u003c/strong\u003eNiall Ferguson\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eLĩnh\u003c/strong\u003e \u003cstrong\u003evực\u003c/strong\u003e\u003cstrong\u003e: \u003c/strong\u003eKinh tài học\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eLoại\u003c/strong\u003e \u003cstrong\u003ebìa\u003c/strong\u003e\u003cstrong\u003e: \u003c/strong\u003eBìa mềm\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eSố\u003c/strong\u003e \u003cstrong\u003etrang\u003c/strong\u003e\u003cstrong\u003e: \u003c/strong\u003e630\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eMô\u003c/strong\u003e \u003cstrong\u003etả\u003c/strong\u003e\u003cstrong\u003e:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eTiền thực sự là gì? Tiền từ đâu đến? Và chúng sẽ đi về đâu? Đồng tiền có bẩn thỉu như chúng ta vẫn thành kiến? Bất chấp tất cả, đồng tiền đã lên ngôi, và sự lên ngôi của đồng tiền là thiết yếu cho sự lên ngôi của loài người, đưa con người từ mức sống khốn khổ lên đỉnh cao của sự thịnh vượng vật chất.\u003c/p\u003e\n\u003cp\u003eQua những sự kiện lịch sử vừa vinh quang vừa tăm tối, cùng những nhân vật lẫy lừng vừa có khả năng sáng tạo vừa có khả năng hủy diệt trong thế giới tài chính, “Đồng tiền lên ngôi” kể câu chuyện hấp dẫn về tiền tệ và tín dụng, thị trường trái phiếu và cổ phiếu, về bảo hiểm và bất động sản – những thành tố then chốt của nền tài chính – từ thời Lưỡng hà cổ đại tới đầu thế kỉ 21, với những cuộc khai sinh, bước tiến đến đỉnh cao, những cơn khủng hoảng và bài học đắt giá.\u003c/p\u003e\n\u003cp\u003eCuốn sách cho thấy lĩnh vực tài chính gắn bó mật thiết, tác động lớn lao, lâu dài đến chúng ta ra sao: các thị trường tài chính là tấm gương của nhân loại, hé lộ về từng ngày từng giờ về cách chúng ta định giá bản thân và những tài nguyên xung quanh.\u003c/p\u003e\n\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/8d/b9/39/6cb5a2f2dd89e0392d7fc9ae91fab673.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/8d/b9/39/6cb5a2f2dd89e0392d7fc9ae91fab673.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/8d/b9/39/6cb5a2f2dd89e0392d7fc9ae91fab673.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8d/b9/39/6cb5a2f2dd89e0392d7fc9ae91fab673.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8d/b9/39/6cb5a2f2dd89e0392d7fc9ae91fab673.jpg"}],"warranty_policy":null,"authors":[{"id":4292865,"name":" Niall Ferguson","slug":"niall-ferguson"}],"current_seller":{"id":179268,"sku":"9991017555259","name":"Trung Nguyên Legend Official","link":"https://tiki.vn/cua-hang/trung-nguyen-franchising","logo":"https://vcdn.tikicdn.com/ts/s