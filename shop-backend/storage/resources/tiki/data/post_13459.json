0b3fe75fe758.jpg\" alt=\"\" width=\"750\" height=\"889\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/77/72/f4/45190592c52a92a4c1d4771e4992672f.jpg\" alt=\"\" width=\"750\" height=\"549\" /\u003e\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cp class=\"irIKAp\"\u003eThiết kế Công thái học. Tốt cho sức khoẻ\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003ePiston điều chỉnh độ cao thấp của ghế, đạt tiêu chuẩn BIFMA của Mỹ.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eKhung lưng bằng nhựa nylon PA. Tựa lưng bọc vải lưới cao cấp. Đệm đỡ lưng điều chỉnh độ cao thấp, ôm sát lưng người ngồi.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eTựa tay bằng nhựa PA cố định\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eĐệm ngồi bằng mút định hình mật độ cao, bọc vải nỉ cao cấp, dày 7cm, có đế đỡ chắc chắn.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eMâm ghế có cơ chế ngả sau, khóa cố định 1 vị trí.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eChân ghế #340 bằng nhựa nylon. Bánh xe #60 bằng nhựa PU bền dẻo, chống sóc\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Hướng dẫn lắp đặt: Video lắp đặt gửi kèm khi mua sản phẩm.\u003c/p\u003e\n\u003cdiv class=\"irIKAp\"\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"_7eojrG\"\u003e\u003cimg class=\"_0O7Vlf _0dg1Q+\" src=\"https://down-vn.img.susercontent.com/file/vn-11134208-7qukw-lfyy5paxs5br91\" alt=\"vn-11134208-7qukw-lfyy5paxs5br91\" /\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cp class=\"irIKAp\"\u003e- Chính sách Bảo hành:\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e+ 1 đổi 1 miễn phí trong vòng 7 ngày.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e+ Bảo hàng 24 tháng phần cơ khí.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e+ Sản phẩm lỗi từ nhà sản xuất trong quá trình sản xuất.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e+ Sản phẩm hư hỏng trong quá trình vận chuyển.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e+ Chăm sóc, hỗ trợ và tư vấn trọ