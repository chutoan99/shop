w_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/media/catalog/product/t/o/tomi_tomican (1).u2566.d20160802.t115819.469914.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2668,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cspan style=\"font-size: medium; color: #0078ab;\"\u003e \u003cstrong\u003e Tủ Tomi Nhỏ Duy Tân 3 Ngăn - Nhiều Màu \u003c/strong\u003e \u003c/span\u003e với thiết kế nhỏ gọn, gồm 2 ngăn kéo và 1 ngăn phụ có nắp đậy cùng màu sắc trang nhã, sẽ giúp bạn cất giữ và bảo quản những     vật dụng nhỏ dễ bị thất lạc như chìa khóa, trang sức, phụ kiện… gọn gàng, ngăn nắp. Sản phẩm được làm từ nhựa cao cấp có     độ bền và khả năng chịu lực tốt, cho bạn thời gian sử dụng lâu dài. Sản phẩm gồm các màu: Xanh Lá, Hồng, Cam, Trắng.\u003c/p\u003e\r\n\u003cul\u003e\r\n\u003cli\u003e Tủ có 2 ngăn kéo và 1 ngăn phụ có nắp đậy phía trên, tiện lợi để bạn lưu trữ chìa khóa, dụng cụ y tế, văn phòng phẩm hoặc         các phụ kiện nhỏ, trang sức… một cách gọn gàng, ngăn nắp và tránh thất lạc. \u003c/li\u003e\r\n\u003cli\u003e Tủ được làm từ nhựa PP/ABS không độc hại, không gây mùi khó chịu trong quá trình sử dụng, đảm bảo an toàn cho sức khỏe người         sử dụng. Chất liệu nhựa này mang đến độ bền cao và khả năng chịu lực tốt, không bị cong vênh hoặc biến dạng dưới tác động         của thời tiết để bạn có thể sử dụng lâu dài, bền bỉ mà không cần đổi mới gây tốn kém. \u003c/li\u003e\r\n\u003cli\u003e Tủ có thể đặt trên bàn làm việc, bàn trang điểm hoặc phòng ngủ… mà không tốn nhiều diện tích. \u003c/li\u003e\r\n\u003cli\u003e Ngoài ra, tủ được thiết kế bế mặt trơn láng, hạn chế bám bẩn và bạn có thể lau chùi dễ dàng để vệ sinh sản phẩm một cách         nhanh chóng, tiện lợi. \u003c/li\u003e\r\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/media/catalog/product/t/o/tomi_tomican (1).u2566.d20160802.t115819.469914.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/t/o/tomi_tomican (1).u2566.d20160802.t115819.469914.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/t/o/tomi_tomican (1).u2566.d20160802.t115819.469914.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/t/o/tomi_tomican (1).u2566.d20160802.t115819.469914.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/t/o/tomi_tomican (1).u2566.d20160802.t115819.469914.jpg"},{"base_url":"https://salt.tikicdn.com/media/catalog/product/t/o/tomi_tomican (0).u2566.d20160802.t115819.428120.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/t/o/tomi_tomican (0).u2566.d20160802.t115819.428120.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/t/o/tomi_tomican (0).u2566.d20160802.t115819.428120.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/t/o/tomi_tomican (0).u2566.d20160802.t115819.428120.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/t/o/tomi_tomican (0).u2566.d20160802.t115819.428120.jpg"},{"base_url":"https://salt.tikicdn.com/media/catalog/product/t/o/tomi_la (1).u2566.d20160802.t115819.445486.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tik