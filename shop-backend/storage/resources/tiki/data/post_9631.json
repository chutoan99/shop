h tuyệt vời------- Trình điều khiển âm thanh lớn 13mm, tạo ra âm trầm tuyệt vời và chất lượng âm thanh tuyệt vời. -------Có micro------- Tai nghe nhét tai có micro và hỗ trợ cuộc gọi HD, lớp học trực tuyến và hội nghị web.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/e3/c1/b8/85126769ea34d8819cd7c6156b5ceaa9.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e3/c1/b8/85126769ea34d8819cd7c6156b5ceaa9.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e3/c1/b8/85126769ea34d8819cd7c6156b5ceaa9.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e3/c1/b8/85126769ea34d8819cd7c6156b5ceaa9.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e3/c1/b8/85126769ea34d8819cd7c6156b5ceaa9.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/47/30/75/f98eb6338052f20a02c01d650b78fb09.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/47/30/75/f98eb6338052f20a02c01d650b78fb09.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/47/30/75/f98eb6338052f20a02c01d650b78fb09.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/47/30/75/f98eb6338052f20a02c01d650b78fb09.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/47/30/75/f98eb6338052f20a02c01d650b78fb09.jpg"}],"warranty_policy":null,"brand":{"id":18604,"name":"Lenovo","slug":"lenovo"},"current_seller":{"id":283233,"sku":"1993835989351","name":"HÀ NỘI DIGITAL SHOP","link":"https://tiki.vn/cua-hang/ha-noi-digital-shop","logo":"https://vcdn.tikicdn.com/ts/seller/4b/54/1