l,"icon_width":0,"icon_height":0,"text_color":"#FFF0F1","background_color":"#D93843","href":null,"text":"9.9"},{"placement":"pdp_badge","code":"is_hero","type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":true,"return_reason":"any_reason"}},"discount":741000,"discount_rate":44,"rating_average":5,"review_count":5,"review_text":"(5)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/94/02/b7/a42c2d44b3d300e41f69b5f24acd845e.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":330,"all_time_quantity_sold":37,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<h3 class=\"irIKAp\">Thông số kỹ thuật</h3>\n<p class=\"irIKAp\">Mẫu mã: SoundpPEATS Air4</p>\n<p class=\"irIKAp\">Màu sắc: Đen</p>\n<p class=\"irIKAp\">Phiên bản Bluetooth: V5.3</p>\n<p class=\"irIKAp\">Giao thức Bluetooth: HSP, HFP, A2DP, AVRCP</p>\n<p class=\"irIKAp\">Bộ giải mã Bluetooth được hỗ trợ: aptX Lossless/AAC/SBC</p>\n<p class=\"irIKAp\">Chipset: Qualcomm QCC3071</p>\n<p class=\"irIKAp\">Driver Dynamic: 13mm</p>\n<p class=\"irIKAp\">Pin tai nghe: 35mAh*2</p>\n<p class=\"irIKAp\">Thời gian sạc tai nghe: 1-2 giờ</p>\n<p class=\"irIKAp\">Số lần sạc được hỗ trợ: 3 lần</p>\n<p class=\"irIKAp\">Thời gian sử dụng tai nghe: 6.5 giờ</p>\n<p class=\"irIKAp\">Tổng thời gian sử dụng bao gồm hộp sạc: 26 giờ</p>\n<p class=\"irIKAp\">Thời gian chờ: 40 giờ</p>\n<p class=\"irIKAp\">Pin hộp sạc: 330 mAh</p>\n<p class=\"irIKAp\">ANC: Có (45dB)</p>\n<p class=\"irIKAp\">Khử tiếng ồn cuộc gọi: 3 Mic</p>\n<p class=\"irIKAp\">Chống nước: IPX4</p>\n<p class=\"irIKAp\">Game mode: 88ms</p>\n<p class=\"irIKAp\">Đa kết nối: Có</p>\n<p class=\"irIKAp\">ỨNG DỤNG SoundPEATS: Có</p>\n<p class=\"irIKAp\">Đầu vào sạc: 5V/1A</p>\n<p class=\"irIKAp\">Đáp ứng tần số: 20Hz—40KHz</p>\n<p class=\"irIKAp\">Trở kháng driver: 12Ω±15%</p>\n<p class=\"irIKAp\">Kích thước tai nghe (L*W*H): 18,3*19,1*34,4mm</p>\n<p class=\"irIKAp\">Kích thước case (L*W*H): 53,5*24*58mm</p>\n<p class=\"irIKAp\"> </p>\n<p class=\"irIKAp\"><img style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/73/2a/39/3b316dbed6ec83f12a890eabec687c69.jpg\" alt=\"\" width=\"750\" height=\"353\" /></p>\n<h3 class=\"irIKAp\">Tai Nghe True Wireless SoundPEATS Air4 (Bản nâng cấp SoundPEATS Air3)</h3>\n<p class=\"irIKAp\">SoundPEATS Air4 là tai nghe phiên bản nâng cấp của SoundPEATS Air3, housing được làm công thái học hơn, kiểu dáng tinh gọn hơn trước. Chipset được nâng cấp lên Qualcomm QCC3071 hỗ trợ APTX Lossless chất lượng âm thanh CD. Đây cũng là mẫu earbuds kiểu dáng semi-inear đầu tiên được trang bị chống ồn ANC 45dB. Các tính năng nâng cấp khác như: chống ồn cuộc gọi CVC 6Mic, kết nối 2 thiết bị.</p>\n<h3 class=\"irIKAp\">AptX Lossless</h3>\n<p class=\"irIKAp\">AptX Lossless là codec Bluetooth đầu tiên và duy nhất có khả năng truyền phát âm thanh chất lượng CD mà không mất dữ liệu và nó là một phần của công nghệ âm thanh Qualcomm có tên là Snapdragon Sound. Chất lượng âm thanh truyền qua Bluetooth của aptX Lossless sẽ là 16-bit/44.1kHz, cao hơn các codec aptX khác nhưng thấp hơn LDAC. Với codec này, người dùng cũng sẽ được trải nghiệm âm nhạc tuyệt vời với chất lượng âm thanh đỉnh cao. Dĩ nhiên để có được trải nghiệm như vậy thì cả smartphone và tai nghe không dây đều phải hỗ trợ Snapdragon Sound.</p>\n<p class=\"irIKAp\"> </p>\n<p class=\"irIKAp\"><img style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/a7/f3/be/6cd6e7ba2387c2c964ecd2de769c0faf.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<h3 class=\"irIKAp\">Adaptive Hybrid Active Noise Cancellation</h3>\n<p class=\"irIKAp\">SoundPEATS Air4 là tai nghe Semi-in-ear đầu tiên của SoundPEATS được trang bị công nghệ chống ồn chủ động. Nếu như trước đây khả năng chống ồn của các dạng tai Semi-in-ear được đánh giá thấp hơn so với tai in-ear do thiết kế không nhét sâu vào tai và không có tips tai. Thì giờ đây, với sự phát triển vượt bậc trong công nghệ, SoundPEATS Air4 đã trở thành mẫu tai nghe không dây semi-in-ear chống ồn lý tưởng cho những ai không đeo được tai nghe có tips.Với khả năng chống ồn chủ động thích ứng theo thời gian và môi trường xung quanh, SoundPEATS Air4 có khả năng giảm được tiếng ồn lên lên 45dB. Trải nghiệm đeo hoàn toàn khác biệt so với các phiên bản True Air2 hay Air3 trước đó.</p>\n<p class=\"irIKAp\"> </p>\n<p class=\"irIKAp\"><img style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/cb/04/06/6dc30dc15c02005576adfd92713c32f7.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<h3 class=\"irIKAp\">6 Mic &amp; Công nghệ giảm ồn cuộc gọi Al</h3>\n<p class=\"irIKAp\">SoundPEATS Air4 được trang bị thêm 6 mic chống ồn để hỗ trợ đàm thoại. Kết hợp cùng công nghệ giảm tiếng ồn cuộc gọi Al, lọc và giảm tạp âm, tiếng ồn xung quanh để mang đến những cuộc gọi rõ ràng, chính xác đến từng chi tiết. Bộ ba mic phản hồi, mic giao tiếp, mic ngưng tụ trên mỗi tai nghe đóng vai trò tiếp nhận, lọc ồn và đưa thông tin chính xác, rõ ràng nhất đến tai của người dùng và ngược lại.</p>\n<p class=\"irIKAp\"> </p>\n<p class=\"irIKAp\"><img style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/6b/0d/ff/b5a33de21153ac061930496aec93c340.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<h3 class=\"irIKAp\">Kết nối đa điểm</h3>\n<p class=\"irIKAp\">Ở phiên bản SoundPEATS Air4, người dùng có thể đồng thời kết nối 2 thiết bị cùng lúc. Linh hoạt chuyển đổi giữa hai thiết bị khi cần thiết mà không cần phải ngắt kết nối trên thiết bị này và bật kết nối với thiết bị kia, mang lại trải nghiệm âm thanh liền mạch và thuận tiện.</p>\n<p class=\"irIKAp\"> </p>\n<p class=\"irIKAp\"><img style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/37/2f/98/5b965455d61e86c2df045cac9a1829bb.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<h3 class=\"irIKAp\">Driver 13mm cho âm trầm mạnh mẽ</h3>\n<p class=\"irIKAp\">Âm trầm sống động và mạnh mẽ nhờ được trang bị Driver Dynamic lên đến 13mm. Có khả năng tái tạo dải bass mạnh hơn, sâu hơn, có lực hơn và âm thanh cũng chi tiết hơn.</p>\n<p class=\"irIKAp\"> </p>\n<p class=\"irIKAp\"><img style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/46/0e/22/48aeaed6c8568b6e7ec3841bf48adcd5.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<h3 class=\"irIKAp\">Pin dùng lâu dài</h3>\n<p class=\"irIKAp\">SoundPEATS Air4 cho phép người dùng có thể sử dụng tai nghe trong vòng 26 giờ liên tục khi kèm hộp sạc. Với tai nghe đơn, bạn có thể nghe nhạc, xem phim trong 6.5 giờ ở mức âm lượng 60% và tắt ANC. </p>\n<p class=\"irIKAp\"> </p>\n<p class=\"irIKAp\"><img style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/e1/18/ea/0d97456f764d507e32e03fe9b1d25ac2.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<h3 class=\"irIKAp\">Game Mode độ trễ thấp</h3>\n<p class=\"irIKAp\">SoundPEATS Air4 không chỉ nổi bật với chất lượng âm thanh và khả năng chống ồn hiệu quả. Người dùng hoàn toàn có thể trải nghiệm những tựa game Mobile kinh điển như PUBG, FreeFire, Liên Quân Mobile…</p>\n<p class=\"irIKAp\"> </p>\n<p class=\"irIKAp\"><img style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/3f/23/2d/6352d74b04c8e5883311c8279b8921ce.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<h3 class=\"irIKAp\">Điều khiển bằng App dễ dàng</h3>\n<p class=\"irIKAp\">Ngoài hỗ trợ điều khiển thông qua cảm ứng, SoundPEATS Air4 cũng được tích hợp với app SoundPEATS để người dùng tùy chỉnh các tác vụ như reset, bật/tắt các chế độ, điều chỉnh EQ, update phần mềm, xem phần trăm pin… một cách đơn giản hơn.</p>\n<h3 class=\"irIKAp\">Thiết kế sang trọng, trọng lượng siêu nhẹ</h3>\n<p class=\"irIKAp\">SoundPEATS Air4 có điểm nhấn mạ vàng ở phần logo chữ S, tăng thêm sự sang trọng và đẳng cấp cho tai nghe.Trọng lượng mỗi bên tai là 4g, siêu nhẹ, hoàn toàn không có cảm giác nặng hay chèn ép trên tai dù đeo suốt cả ngày dài.</p>\n<p class=\"irIKAp\"> </p>\n<p class=\"irIKAp\"><img style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/2d/7c/28/9d03f760f92bcfda03aba80a6c5a5c75.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<h3 class=\"irIKAp\">Bluetooth 5.3 hiện đại</h3>\n<p class=\"irIKAp\">SoundPEATS Air4 có khả năng kết nối linh hoạt và ổn định với các thiết bị thông minh thông qua công nghệ Bluetooth 5.3. Tín hiệu đường truyền được giữ ổn định, không giật lag, không có độ trễ trong phạm vi bán kính 10m (không có vật cản).</p>\n<p class=\"irIKAp\"> </p>\n<p class=\"irIKAp\"><img style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/e1/58/e3/a8ac11003df17454427f5891e812b4aa.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p class=\"irIKAp\"> </p>\n<h3 class=\"irIKAp\">Bộ sản phẩm bao gồm:</h3>\n<p class=\"irIKAp\">1 x Tai nghe SoundPEATS Air4</p>\n<p class=\"irIKAp\">1 x Cáp sạc Type-C</p>\n<p class=\"irIKAp\">1 x HDSD Nhiều ngôn ngữ</p>\n<p class=\"irIKAp\"><img style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/51/d0/c4/ba239acd6fcd7fc191ed1560e52afbac.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<h3 class=\"_2jrvqA\">Sản phẩm được phân phối chính hãng tại SoundPEATS Vietnam với dịch vụ chăm sóc khách hàng và bảo hành sản phẩm tốt nhất.</h3>\n<h2 class=\"_2jrvqA\">Bảo hành</h2>\n<p class=\"_2jrvqA\">Bảo hành chính hãng 12 tháng</p>\n<p class=\"_2jrvqA\">Bảo hành 1 đổi 1 (Đối với lỗi từ nhà sản xuất)</p>\n<p class=\"_2jrvqA\">Bảo hành thông qua mã đơn mua hàng trên sàn Tiki, không cần hóa đơn.</p>\n<p class=\"_2jrvqA\">Tất cả sản phẩm công ty phân phối đều bảo hành qua mã đơn hàng, khách hàng ở tỉnh nếu không đến trực tiếp có thể gửi qua đường bưu điện, bên công ty sẽ gửi hàng bảo hành tận nơi cho các bạn.</p>\n<p class=\"_2jrvqA\">Trung tâm bảo hành SoundPEATS Vietnam: Phường An Phú, Quận 2, HCM.</p>\n<h3 class=\"_2jrvqA\"><strong>Điều kiện bảo hành:</strong> Vui lòng giữ lại HỘP của sản phẩm và khi cần bảo hành vui lòng chat với Shop qua app Tiki.</h3>\n<h2 class=\"_2jrvqA\"> Hỗ trợ khách hàng</h2>\n<p class=\"_2jrvqA\">Hỗ trợ tư vấn qua khung chat với Shop trên app Tiki</p>\n<p class=\"_2jrvqA\">Thời gian làm việc: 8h - 12h00 và 13h30 - 17h00 (Từ thứ 2 đến thứ 6, trừ các ngày Lễ/Tết).</p>\n<h3 class=\"_2jrvqA\"> Vui lòng QUAY VIDEO khui gói hàng trước khi mở gói hàng để đảm bảo SHOP giao đúng và đủ đơn hàng. Cảm ơn quý khách đã ủng hộ!</h3><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/94/02/b7/a42c2d44b3d300e41f69b5f24acd845e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/p