urite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/8b/48/f0/29abee0425c1344b5eb08c975e3551f7.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1583,"all_time_quantity_sold":7,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eSản phẩm ấm sắc thuốc Trường Thọ 5 Lít tự động, do Công Ty Bình An sản xuất tại Việt Nam, sản phẩm hiện đang được người tiêu dùng lựa chọn nhiều nhất trên thị trường.\u003cbr /\u003eBình ấm sắc thuốc, được làm từ chất liệu sứ Bát Tràng, sứ được nung ở nhiệt độ 1300 độ, ở nhiệt độ này giúp khử hết chì, tạp chất cũng như kim loại nặng tồn dư trong đất như Al, Fe, C\u003cbr /\u003eẤm có dung tích lớn lên đến 5 Lít phù hợp để sắc những thang thuốc lớn, yêu cầu giữ lại nhiều nước. Trên thân ấm có in chữ Trường Thọ, vung ấm có mấu bên trong để cố định, giúp khi nghiêng bình rót không bị rơi vung ấm ra ngoài, vòi ấm thiết kế theo kiểu bình trà tôn thêm vẻ đẹp truyền thống.\u003cbr /\u003eẤm tự động ngắt khi còn lại khoảng 1 bát nước. Khi thuốc trong ấm nguội, ấm sẽ tự động nhảy nút hâm nóng giữ ấm thuốc ở nhiệt độ 70 độ. Dù vậy, nếu vô tình bạn quên rót thuốc, bạn yên tâm rằng thuốc sẽ không bị cháy, mà ấm sẽ tự ngắt.\u003cbr /\u003eSản phẩm chính hãng và được bảo hành trong vòng 1 năm.\u003c/p\u003e\n\u003cp\u003eĐổi mới trong vòng 3 tháng sử dụng nếu có lỗi của NSX : ví dụ như ấm không vào điện,không nhảy nút,không nóng,không sôi,ấm rạn chân chim.Không bảo hành các trường hợp chập cháy do phía người dùng hay ấm vỡ dã bị tháo ra sửa chữa.\u003cbr /\u003eBảo hành sửa chữa trong 9 tháng tiếp theo\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/17/f4/f3/f1bf07f29feda540919d1c9d810b1ee5.jpg\" alt=\"\" widt