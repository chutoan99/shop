,"type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":50000,"discount_rate":31,"rating_average":5,"review_count":10,"review_text":"(10)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/84/e1/45/0036f4f0d7f61f5cdf26ec935a8b1f09.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":869,"all_time_quantity_sold":92,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cspan style=\"color:#0000ff\"\u003e\u003cstrong\u003ePhilips\u003c/strong\u003e\u003c/span\u003e là một trong những \u003cstrong\u003ethương hiệu chiếu sáng\u003c/strong\u003e đáng tin cậy hàng đầu trên toàn thế giới. Với đến công nghệ luôn được cải tiến, chất lượng sản phẩm vượt trội, giá thành hợp lý giúp cải thiện và nâng cao chất lượng sống của con người.\u003c/p\u003e\n\u003cp\u003eCác dòng sản phẩm chiếu sáng thương hiệu \u003cspan style=\"color:#0000ff\"\u003e\u003cstrong\u003ePhilips \u003c/strong\u003e\u003c/span\u003eđược Nhập khẩu và Phân phối chính hãng tại thị trường Việt Nam, đáp ứng các tiêu chuẩn an toàn Quốc tế mang lại sự tin cậy cho người dùng.\u003c/p\u003e\n\u003cp style=\"text-align:center\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/16/5f/46/96ca10487ce8edc8f9f8f0e902a1f800.jpg\" alt=\"Thương hiệu Philips\" width=\"750\" height=\"550\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:left\"\u003eBóng \u003cstrong\u003eMaster LED PHILIPS\u003c/strong\u003e là sản phẩm với \u003cstrong\u003echất lượng ánh sáng cực cao\u003c/strong\u003e \u003cspan style=\"color:#ff6600\"\u003e\u003cstrong\u003eCRI 90 \u003c/strong\u003e\u003c/span\u003ethay thế hoàn hảo cho đèn Halogen truyền thống, thích hợp dùng để trang trí, rọi tranh, chiếu điểm tại các Showroom, Cửa hàng, Nhà hàng, Khách sạn, Hộ gia đình. Sản phẩm được trang bị công nghệ \u003cspan style=\"color:#ff6600\"\u003e\u003cstrong\u003eDimmer\u003c/strong\u003e \u003c/span\u003egiúp đáp ứng nhu cầu chiếu sáng khắc khe, tiết kiệm năng lượng, chất lượng ánh sáng đáng tin cậy và tính thẩm mỹ cực cao.\u003c/p\u003e\n\u003cp style=\"text-align:center\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ce/6f/e0/8569b225f2fcdab224e1798593a8fe47.jpg\" alt=\"Bóng đèn Master LED Philips\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eBóng đèn Master LED PHILIPS \u003c/strong\u003ecó 2 màu ánh sáng Ánh sáng Vàng (3000K) và Ánh sáng Trung tính (4000K): Tạo môi trường sang trọng, ấm cúng thích hợp dùng trong nhà hàng, khách sạn.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTHÔNG SỐ KỸ THUẬT\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eCông suất: 4.9W\u003c/li\u003e\u003cli\u003eĐộ sáng: 410 lm (3000K), 420 lm (4000K)\u003c/li\u003e\u003cli\u003eNhiệt độ màu: Vàng (3000K), Trung tính (4000K)\u003c/li\u003e\u003cli\u003eĐiều chỉnh độ sáng: Có\u003c/li\u003e\u003cli\u003eĐộ trung thực màu CRI: \u003cspan style=\"color:#ff6600\"\u003e\u003cstrong\u003e90\u003c/strong\u003e\u003c/span\u003e\u003c/li\u003e\u003cli\u003eKích thước: Ø50 x 54 mm\u003c/li\u003e\u003cli\u003eChất liệu: Bóng thủy tinh\u003c/li\u003e\u003cli\u003eTiêu chuẩn bảo vệ: IP20\u003c/li\u003e\u003cli\u003eTiêu chuẩn năng lượng: A\u0026#43;\u003c/li\u003e\u003cli\u003eĐiện áp: 220 - 240V/ 50 – 60Hz\u003c/li\u003e\u003cli\u003eTuổi thọ: 25,000 Giờ\u003c/li\u003e\u003cli\u003eSố lần bật tắt: 100,000 lần\u003c/li\u003e\u003cli\u003eĐui đèn: GU10\u003c/li\u003e\u003cli\u003eNhập Khẩu Chính Hãng\u003c/li\u003e\u003c/ul\u003e\u003cp style=\"text-align:center\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/4c/be/e7/296550e58fb8f1bb027b8546940903fb.jpg\" alt=\"Vì sao nên chọn đèn LED Philips\" width=\"750\" height=\"304\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/e5/33/c0/20f6c5ec3eaaf38971366b9637f3fde5.jpg\" alt=\"Thông tin liên hệ\" width=\"750\" height=\"238\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/84/e1/45/0036f4f0d7f61f5cdf26ec935a8b1f09.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/84/e1/45/0036f4f0d7f61f5cdf26ec935a8b1f09.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/84/e1/45/0036f4f0d7f61f5cdf26ec935a8b1f09.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/84/e1/45/0036f4f0d7f61f5cdf26ec935a8b1f09.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/84/e1/45/0036f4f0d7f61f5cdf26ec935a8b1f09.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/35/ff/10/6ce475b7ff9604231ed45fb63fd275fa.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/35/ff/10/6ce475b7ff9604231ed45fb63fd275fa.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/35/ff/10/6ce475b7ff9604231ed45fb63fd275fa.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/35/ff/10/6ce475b7ff9604231ed45fb63fd275fa.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/35/ff/10/6ce475b7ff9604231ed45fb63fd275fa.jpg"},{"