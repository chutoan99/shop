dp_badge","code":"is_hero","type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"freeship_xtra","type":"pdp_icon_badge","index":2,"icon":"https://salt.tikicdn.com/ts/upload/be/67/48/04a82ab8df178e1a13bde38316081865.png","icon_width":91,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":true,"return_reason":"any_reason"}},"discount":33000,"discount_rate":15,"rating_average":5,"review_count":73,"review_text":"(73)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/68/93/1f/221d5b60fffb4f69dd1e764179dab0e0.png","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":535,"all_time_quantity_sold":341,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2\u003eỔ cắm điện Wifi thông minh TP-Link Tapo P100 / P105 – Chất liệu an toàn, nhiều tính năng thông minh\u003c/h2\u003e\n\u003cp\u003e\u003cstrong\u003e* PHÂN BIỆT 2 PHIÊN BẢN P100 / P105:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- P100: ổ cắm chuôi tròn, công suất 2300W, AC 220-240 V~50/60 Hz 10A\u003c/p\u003e\n\u003cp\u003e- P105: ổ cắm chuôi dẹt, công suất 1800W, AC 100-125 V~ 50/60 Hz 15A\u003c/p\u003e\n\u003cp\u003e- P110M: ổ cắm chuôi tròn, công suất 3680W, AC 100-240V~ 50/60Hz 16A\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/33/c2/cb/ab7fb2100ddd1385343ed7ba15246790.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/de/93/f3/2595d75a7e71ca94634eb169ca1ce4b7.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eỔ cắm điện thông minh đang là từ khóa liên quan về phụ kiện thông minh dành cho gia dụng hot nhất vừa qua. TP-Link – nhà sản xuất chuyên về thiết bị mạng cũng không bỏ qua thị trường này bằng cách cho ra mắt sản phẩm\u003cstrong\u003e ổ cắm điện Wifi thông minh TP-Link Tapo P100\u003c/strong\u003e. Hãy cùng đón xem sản phẩm này có gì độc đáo nhé.\u003c/p\u003e\n\u003ch3\u003eKích thước chỉ 51x72x40 mm, hoàn thiện từ nhựa PC, bảo vệ an toàn\u003c/h3\u003e\n\u003cp\u003eỔ cắm điện Wifi thông minh TP-Link Tapo P100 mang thiết kế nhỏ gọn, bằng chứng là nó chỉ có kích thước 51 x 72 x 40 mm. Qua đó, người dùng có thể mang nó đi khắp mọi nơi, không bị chiếm diện tích nhiều trong balo hay túi xách, hơn nữa, khi sử dụng nó sẽ không chiếm luôn không gian của lỗ cắm bên cạnh.\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"cpslazy loaded\" style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/7d/a4/a6/ed1fa945c9fa3e15819cd5bc7a4944bf.jpg\" alt=\"\" width=\"750\" height=\"1316\" /\u003e\u003c/p\u003e\n\u003cp\u003eỔ cắm điện Wifi thông minh TP-Link Tapo P100 được hoàn thiện chủ yếu đến từ nhựa PC. Đây là vật liệu nổi tiếng với độ bền cao và cho khả năng chống cháy, thường được sử dụng trên những đồ điện, điện tử. Do đó, bạn hoàn toàn yên tâm về độ thẩm mỹ của sản phẩm và cả độ an toàn cho thiết bị.\u003c/p\u003e\n\u003cp\u003eNhằm tránh những tai nạn không đáng có, đặc biệt là bảo vệ an toàn cho trẻ em, hãng TP-Link còn cẩn thận trang bị cho thiết bị một vách ngăn thao tác trượt ngăn ngừa điện giật. Khi sử dụng bạn chỉ cần mở nắp ngăn này lên.\u003c/p\u003e\n\u003ch3\u003eNhiều tính năng thông minh: điều khiển từ xa, đặt lịch hoạt động, đếm thời gian\u003c/h3\u003e\n\u003cp\u003eỔ cắm điện Wifi thông minh TP-Link Tapo P100 được tích hợp rất nhiều công nghệ thông minh nhằm phục vụ cho cuộc sống tiện nghi của người dùng.\u003c/p\u003e\n\u003cp\u003eĐầu tiên là công nghệ điều khiển từ xa. Bằng cách kết nối với điện thoại thông qua ứng dụng mang tên Tapo có sẵn trên CH Play và Appstore, cho phép bạn điều khiển các thiết bị mà bạn đã cắm với ổ cắm trước đó. Điều này thật tiện lợi khi bạn không cần phải đến tận nơi để rút phích cắm ra.\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"cpslazy loaded\" style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/9c/f4/11/f6bedb7b4abe09c6bec1e4523d5872cf.jpg\" alt=\"\" width=\"750\" height=\"421\" /\u003e\u003c/p\u003e\n\u003cp\u003eTiếp theo là tính năng đặt lịch hẹn và đếm thời gian cho phép người dùng lập kế hoạch trước và các thiết bị điện tử mà bạn đã cắm vào ổ cắm sẽ hoạt động theo lịch bạn cài đặt. Điều này giúp bạn không bỏ sót điều gì và tiết kiệm cả năng lượng cho ngôi nhà của bạn.\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"cpslazy loaded\" style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/5f/13/41/bcb1f2f0d9e0dbcea219cf03e2cb20cf.jpg\" alt=\"\" width=\"331\" height=\"286\" /\u003e\u003c/p\u003e\n\u003cp\u003eĐiểm làm nên khác biệt với các sản phẩm khác nằm ở tính năng hỗ trợ điều khiển giọng nói. TP-Link Tapo P100 cho khả năng kết nối với trợ lý ảo thông minh là Alexa và Google Assistant. Sử dụng nói từ khóa như “Turn on the light” để mở đèn hoặc “Turn off the TV” để tắt TV.  \u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"cpslazy loaded\" style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/9d/5e/ff/6d075f6bbf72f5b40f4bc90a60149db7.jpg\" alt=\"\" width=\"750\" height=\"375\" /\u003e\u003c/p\u003e\n\u003cp\u003eChưa hết, với trường hợp gia đình bạn đi du lịch hay đi công tác xa vài ngày, TP-Link Tapo P100 có chế độ ở xa phù hợp cho bạn. Đây là chế độ giả lập như đang có người ở nhà vậy, thực hiện thao tác mở và tắt đèn đã được lên lịch trước đó, để tránh kẻ gian dòm ngó.\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"cpslazy loaded\" style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/f7/01/c4/3ec6ea1a55760fbf26adc5dadb8319e5.jpg\" alt=\"\" width=\"746\" height=\"605\" /\u003e\u003c/p\u003e\n\u003ch2\u003eMua ngay ổ cắm điện Wifi thông minh TP-Link Tapo P100 chính hãng\u003c/h2\u003e\n\u003cp\u003eBạn đang không biết chọn ổ cắm nào để sử dụng cho ngôi nhà thông minh của mình? Đừng tìm đâu xa, ổ cắm điện Wifi thông minh TP-Link Tapo P100 là sản phẩm phù hợp nhất, không chỉ có thiết kế an toàn, nó còn trang bị nhiều tính năng hỗ trợ cho cuộc sống người dùng thêm tiện nghi.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/68/93/1f/221d5b60fffb4f69dd1e764179dab0e0.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/68/93/1f/221d5b60fffb4f69dd1e764179dab0e0.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/68/93/1f/221d5b60fffb4f69dd1e764179dab0e0.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/68/93/1f/221d5b60fffb4f69dd1e764179dab0e0.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/68/93/1f/221d5b60fff