rating_average":4.7,"review_count":10,"review_text":"(10)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/be/f2/5d/8be5d916afaf59746edb091832ba1798.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1036,"all_time_quantity_sold":43,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eNƯỚC KHOÁNG KIỀM THIÊN NHIÊN VIKODA pH 9,0 TỐT CHO SỨC KHỎE VÀ HỆ TIÊU HÓA\u003c/p\u003e\n\u003cp\u003eNằm sâu dưới chân núi Hòn Chuông thuộc dãy Trường Sơn, nguồn khoáng kiềm Đảnh Thạnh là món quà vô giá của thiên nhiên ban tặng cho vùng đất Khánh Hoà, Việt Nam. Các kết quả nghiên cứu từ 1977 đến 1999 đã chỉ ra Đảnh Thạnh là nguồn nước thiên nhiên có tính khoáng kiềm tự nhiên hoàn hảo, hàm lượng khoáng nhẹ và độ kiềm pH = 9.0, phù hợp uống bổ trợ sức khoẻ hàng ngày. \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/e5/84/f8/5274e47324cbc3472f76fb7010243679.jpg\" alt=\"\" width=\"592\" height=\"320\" /\u003e\u003c/p\u003e\n\u003cp\u003eNước khoáng kiềm thiên nhiên Vikoda bảo toàn vẹn nguyên tinh túy từ nguồn khoáng kiềm Đảnh Thạnh quý hiếm.  Nước khoáng kiềm thiên nhiên Vikoda được khai thác từ mỏ đi lên được đưa thẳng vào nhà máy chiết và chỉ qua quá trình lọc thô, lọc bằng tia cực tím (UV). Sản phẩm sở hữu vị ngọt thanh mát và độ kiềm hoàn hảo pH = 9.0 100% tự nhiên cùng với các khoáng chất giúp trung hòa axit dạ dày dư thừa, đưa cơ thể trở về trạng thái cân bằng khoẻ mạnh tự nhiên. Uống Vikoda mỗi ngày sẽ hỗ trợ tích cực cho hệ tiêu hóa và sức khỏe.\u003c/p\u003e\n\u003cp\u003eUống nước khoáng kiềm thiên nhiên Vikoda mang đến những lợi ích tích cực cho hệ tiêu hóa và sức khỏe!\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/be/f2/5d/8be5d916afaf59746edb091832ba1798.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/be/f2/5d/8be5d916afaf59746edb091832ba1798.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/be/f2/5d/8be5d916afaf59746edb091832ba1798.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/be/f2/5d/8be5d916afaf59746edb091832ba1798.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/be/f2/5d/8be5d916afaf59746edb091832ba1798.png"},{"base_url":"https://salt.tikicdn.com/ts/product/8f/ec/4e/4338c3d437d61a83e5ab6709c29549e7.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/8f/ec/4e/4338c3d437d61a83e5ab6709c29549e7.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/8f/ec/4e/4338c3d437d61a83e5ab6709c29549e7.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8f/ec/4e/4338c3d437d61a83e5ab6709c29549e7.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8f/ec/4e/4338c3d437d61a83e5ab6709c29549e7.png"},{"base_url":"https://salt.tikicdn.com/ts/product/9e/55/46/2a24031163f8bdc2cf070df0536380c1.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/9e/55/46/2a24031163f8bdc2cf070df0536380c1.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/9e/55/46/2a24031163f8bdc2cf070df0536380c1.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9e/55/46/2a24031163f8bdc2cf070df0536380c1.jpg","thu