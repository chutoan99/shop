href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":26250,"discount_rate":25,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/90/63/e6/4857930851b77093b1b1be6d41465af2.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":113,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eGIỚI THIỆU TÁC GIẢ:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eTỐNG NGỌC\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eTống Ngọc là cái tên không còn xa lạ với những ai yêu thích thể loại truyện kinh dị, tâm linh. Xuất thân là một tác giả mạng và trải qua nhiều năm miệt mài sáng tác, Tống Ngọc hiện đã khẳng định tài năng và vị trí của mình trong lòng độc giả bằng hàng loạt tác phẩm ăn khách.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eTiếp nối thành công vang dội của các tác phẩm trước, Tống Ngọc quay trở lại với tác phẩm mới thuộc thể loại kinh dị, tâm linh mang tựa đề: GIẾNG ĐỘC.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eGIỚI THIỆU TÁC PHẨM:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eGIẾNG ĐỘC\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cspan style=\"font-weight:400;\"\u003eRồng rắn lên mây\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cspan style=\"font-weight:400;\"\u003eCó thây người mất\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cspan style=\"font-weight:400;\"\u003eThêm vệt máu khô\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cspan style=\"font-weight:400;\"\u003eCùng cô con gái\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cspan style=\"font-weight:400;\"\u003eVới cái giếng hoang\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cspan style=\"font-weight:400;\"\u003eMấy mạng chết oan\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cspan style=\"font-weight:400;\"\u003eBắt ai thế chỗ\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003e------\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eGiếng Độc mở đầu bằng hai đám tang trong cùng một ngày, của cùng một gia đình. Từ sự bất thường ấy mà chính người nhà rồi đến người làng hồ hởi khơi lại quá khứ để lục tìm manh mối, xem cớ vì sao lại có chuyện trùng hợp đáng sợ đến thế xảy ra? \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eNgười chết sẽ không bao giờ biết bản thân họ trong miệng lời người sống có thể biến dạng tới mức nào. Qua miệng lưỡi của đám đông, một chuyện thành hai, hai lại thành ba, rồi cứ nhân lên mãi, mớ tàn tro âm ỉ bỗng chốc lại được thổi bùng lên thành một đám cháy lớn. \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eNgười đọc sẽ chọn tin vào câu chuyện nào, hoặc là tự tìm kiếm manh mối trong chính những con chữ hiện ra, để sắp xếp lại thành một câu chuyện hoàn chỉnh cho mình. \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eNhưng, chỉ một nửa sự thật thì không phải là sự thật nữa.\u003c/span\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/90/63/e6/4857930851b77093b1b1be6d41465af2.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/90/63/e6/4857930851b77093b1b1be6d41465af2.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/90/63/e6/4857930851b77093b1b1be6d41465af2.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/90/63/e6/4857930851b77093b1b1be6d41465af2.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/90/63/e6/4857930851b77093b1b1be6d41465af2.png"},{"base_url":"https://salt.tikicdn.com/ts/product/cd/76/46/b11b8de15c291b90303f59a0407e2120.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/cd/76/46/b11b8de15c291b90303f59a0407e2120.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/cd/76/46/b11b8de15c291b90303f59a0407e2120.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/cd/76/46/b11b8de15c291b90303f59a0407e2120.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/cd/76/46/b11b8de15c291b90303f59a0407e2120.png"},{"base_url":"https://salt.tikicdn.com/ts/product/1d/f2/9e/50608afcf359fff9626cd0c1da64340e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/1d/f2/9e/50608afcf359fff9626cd0c1da64340e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/1d/f2/9e/50608afcf359fff9626cd0c1da64340e.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1d/f2/9e/50608afcf359fff9626cd0c1da64340e.jpg","thumbnail_url":"https://salt.tikicd