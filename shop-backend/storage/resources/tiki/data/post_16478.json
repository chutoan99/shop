ã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/6c/9d/34/d71efa6be65698e7b34d13615000be92.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/6c/9d/34/d71efa6be65698e7b34d13615000be92.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/6c/9d/34/d71efa6be65698e7b34d13615000be92.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6c/9d/34/d71efa6be65698e7b34d13615000be92.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6c/9d/34/d71efa6be65698e7b34d13615000be92.jpg"}],"warranty_policy":null,"brand":{"id":18806,"name":"Canon","slug":"canon"},"current_seller":{"id":20850,"sku":"5533308696202","name":"THÀNH CÔNG CAMERA","link":"https://tiki.vn/cua-hang/thanh-cong-camera","logo":"2a/da/b5/0b0baa6eb97d8a835780f6b30f4bc37a.jpg","price":310000,"product_id":"275275122","store_id":20313,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Content","attributes":[{"code":"brand","name":"Thương hiệu","value":"Canon"},{"code":"brand_country","name":"Xuất xứ thương hiệu","value":"Nhật Bản"},{"code":"origin","name":"Xuất xứ (Made in)","value":"Hàn Quốc / Trung Quốc"}]},{"name":"Operation","attributes":[{"code":"is_warranty_applied","name":"Sản phẩm có được bảo hành không?","value":"Không"}]}],"product_links":[],"gift_item_title":"0 quà tặng kèm","configurable_options":[{"code":"option1","name":"Màu (Color)","position":0,"show_preview_image":true,"values":[{"label":"Bộ 4 màu (BK/C/Y/M)"},{"label":"Vàng (Yellow)"},{"label":"Xanh (Cyan)"},{"label":"Đen (Black)"},{"label":"Đỏ (Magenta)"}]}],"configurable_products":[{"child_id":2