ại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/e1/7a/da/113f432b791f001960b43673e97a617e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e1/7a/da/113f432b791f001960b43673e97a617e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e1/7a/da/113f432b791f001960b43673e97a617e.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e1/7a/da/113f432b791f001960b43673e97a617e.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e1/7a/da/113f432b791f001960b43673e97a617e.jpg"},{"base_url":"https://salt.tikicdn.com/media/catalog/producttmp/ab/2d/ea/8c1ec07c0f5f3adf7276ab0568dd52eb.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/producttmp/ab/2d/ea/8c1ec07c0f5f3adf7276ab0568dd52eb.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/producttmp/ab/2d/ea/8c1ec07c0f5f3adf7276ab0568dd52eb.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/producttmp/ab/2d/ea/8c1ec07c0f5f3adf7276ab0568dd52eb.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/producttmp/ab/2d/ea/8c1ec07c0f5f3adf7276ab0568dd52eb.jpg"}],"warranty_policy":null,"authors":[{"id":13660,"name":"Lê Lựu","slug":"le-luu"}],"current_seller":{"id":3860,"sku":"5176631662186","name":"Nhà sách 30 Hàn Thuyên","link":"https://tiki.vn/cua-hang/nha-sach-30-han-thuyen","logo":"24/42/53/83f2f4b7977a4d8041790ba04aea79d7.jpg","price":70000,"product_id":"2720385","store_id":3809,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Thông tin chung","attributes":[{"code":"publisher_vn","name":"Công ty phát hành","value":"Nhà Sác