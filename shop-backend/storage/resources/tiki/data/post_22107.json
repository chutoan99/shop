0,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":116000,"discount_rate":28,"rating_average":5,"review_count":10,"review_text":"(10)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/0c/c6/14/17f0aa6b05e7715e91adabb0113160da.png","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":805,"all_time_quantity_sold":55,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/fa/10/e0/fa4b5915585c6643692aee4bf3b9d6eb.png\" alt=\"\" width=\"750\" height=\"749\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eMÔ TẢ SẢN PHẨM\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e- CHUẨN SẠC NHANH PD 3.0: Dây cáp chuẩn PD 3.0 Type-C to Light.ning MFI, sạc nhanh cho iPhone đến 20W và cho iPad đến 30W\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e- TRANG BỊ CHIP SẠC THÔNG MINH: Dây cáp được trang bị chip sạc thông minh mới nhất hiện nay, cho khả năng sạc cực kỳ ổn định, tự động nhận dạng điều chỉnh các dòng điện phù hợp.\u003c/p\u003e\n\u003cp\u003eGiúp bảo vệ thiết bị, chống quá tải nhiệt độ, điện áp, chống quá dòng, chống cháy nổ hiệu quả. tạo cho độ an toàn và tin tưởng gần như tuyệt đối.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eĐạt tốc độ truyền tải sắp xỉ 480Mbps, bạn sẽ nhanh chóng truyền đi 1GB dữ liệu chỉ trong 1 cái chớp mắt. Tốc độ nhanh chưa từng có hiện nay.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://cf.shopee.vn/file/ade427beed81e717f90c270e93978c5b\" alt=\"ade427beed81e717f90c270e93978c5b\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e- CÔNG NGHỆ SR CHỐNG GÃY ĐẦU CÁP: Với công nghệ SR mới nhất hiện nay, chiếc cáp có thể bẻ cong một góc 30 độ mà vẫn không bị gì, giúp khắc phục được những nhược điểm hay bị gãy đầu của những thế hệ cáp cũ.\u003c/p\u003e\n\u003cp\u003eGấp 12x lần các loại cáp cũ, vượt qua hơn 10000 lần test thử.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e- LÕI ĐƯỢC NÂNG CẤP: Với phần lõi đồng bên trong được nâng cấp với 4 lõi nhỏ, giúp cho tốc độc sạc cũng như truyền dữ liệu được nhanh hơn. Không những vậy, bên ngoài còn được bảo vệ bởi các lớp vỏ kim loại, vỏ cách nhiệt, giúp đảm bảo an toàn khi sạc.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e- HỖ TRỢ NHIỀU DÒNG MÁY: Bạn có thể sử dụng Dây cáp sạc nhanh CHOETECH IP0040 dành cho iPhone Series 6, 7, 8, X, XS, XR, 11, 12, 13, 14. Và cho iPad Series có cổng sạc Light.ning.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e- Lưu ý: Bạn nên sử dụng với củ sạc nhanh có cổng sạc Type-C để tương thích với dây cáp.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e- ĐỘ DÀI DÂY 1.2M: Với độ dài 1.2m giúp bạn dễ dàng làm việc và thuận tiện khi sạc các thiết bị không bị giới hạn khoảng cách. Bạn có thể sạc thoải mái mọi lúc mọi nơi trong mọi tư thế.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://cf.shopee.vn/file/c4497ec925bb7a9cff1ea8505650e52f\" alt=\"c4497ec925bb7a9cff1ea8505650e52f\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eTHÔNG TIN SẢN PHẨM\u003c/p\u003e\n\u003cp\u003e- Thương hiệu: CHOETECH\u003c/p\u003e\n\u003cp\u003e- Mã sản phẩm: IP0040\u003c/p\u003e\n\u003cp\u003e- Chuẩn MFI\u003c/p\u003e\n\u003cp\u003e- Tính năng: Cáp Type-C to Light.ning (cho iPhone, cho iPad)\u003c/p\u003e\n\u003cp\u003e- Công suất: cho iPhone 20W, cho iPad 30W\u003c/p\u003e\n\u003cp\u003e- Tốc độ truyền tải: khoảng 480Mbps\u003c/p\u003e\n\u003cp\u003e- Chiều dài dây: 1.2m\u003c/p\u003e\n\u003cp\u003e- Màu sắc: trắng\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/0c/c6/14/17f0aa6b05e7715e91adabb0113160da.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0c/c6/14/17f0aa6b05e7715e91adabb0113160da.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/0c/c6/14/17f0aa6b05e7715e91adabb0113160da.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0c/c6/14/17f0aa6b05e7715e91adabb0113160da.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0c/c6/14/17f0aa6b05e7715e91adabb0113160da.png"},{"base_url":"https://salt.tikicdn.com/ts/product/fa/10/e0/c4f637b90c3147c78dba4dc79d68a533.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/fa/10/e0/c4f637b90c3147c78dba4dc79d68a533.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/fa/10/e0/c4f637b90c3147c78dba4dc79d68a533.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fa/10/e0/c4f637b90c3147c78dba4dc79d68a533.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fa/10/e0/c4f637b90c3147c78dba4dc79d68a533.png"},{"base_url":"https://salt.tikicdn.com/ts/product/6d/ff/35/5152cacfeaa7038dc4a172013ce62b13.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/6d/ff