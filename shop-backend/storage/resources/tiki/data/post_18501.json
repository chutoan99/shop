ode":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":2000,"discount_rate":1,"rating_average":4.7,"review_count":59,"review_text":"(59)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/3d/6b/3b/c72b419b02cc6311d1afb593faa6984d.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1801,"all_time_quantity_sold":308,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch1 id=\"product-name\" class=\"item-name\" style=\"text-align: center;\"\u003e\u003cspan style=\"color: #ff0000;\"\u003eThảm Yoga 2 Lớp + Gạch Yoga + Bao Đựng Thảm Yoga\u003c/span\u003e\u003c/h1\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cstrong\u003e\u003cspan style=\"color: #0000ff;\"\u003eChính Hãng miDoctor\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cstrong\u003e\u003cspan style=\"color: #0000ff;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/4b/1a/b3/32229a83026fe9199d0e958198118b3e.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cstrong\u003e\u003cspan style=\"color: #0000ff;\"\u003e\u003ciframe src=\"//www.youtube.com/embed/Q06wLkOxZvc\" width=\"560\" height=\"314\" allowfullscreen=\"allowfullscreen\"\u003e\u003c/iframe\u003e\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e \u003c/p\u003e\n\u003cp style=\"font-weight: 400;\"\u003e\u003cstrong\u003eƯu điểm của Thảm TPE 2 lớp miDoctor so với các loại thảm thông thường:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli style=\"font-weight: 400;\"\u003eChất liệu: Thảm được làm bằng chất liệu TPE, một loại mút xốp đàn hồi nhiệt dẻo thay thế cho dòng thảm làm bằng chất liệu PVC, giúp thảm có độ mềm mại và độ bám dính tốt, không độc  hại, không kích ứng da, thân thiện với môi trường.\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\"\u003eĐộ bám sàn: Thảm có độ bám sàn cao, rất chắc chắn,  không gây trơn trượt nguy hiểm cho người tập, hỗ trợ tối đa cho các động tác khó. Sản phẩm được thiết kế giúp người tập có thể tập trung vào các động tác khó, kiểm soát được nhịp thở. Nhờ độ mềm mại và độ bám sàn cao, thảm còn giúp hỗ trợ tối ưu cho các tư thế thăng bằng và tư thế đứng.\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\"\u003eCất giữ và vận chuyển: Thảm có kèm theo dây buộc, Khi tập xong, người tập chỉ việc cuộn thảm, dùng dây buộc lại là có thể cất thảm gọn gàng hoặc vận chuyển đến các địa điểm khác nhau, thuận tiện mang đến nơi tập và mang về nhà.\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\"\u003eVệ sinh làm sạch: Dễ dàng làm sạch thảm bằng cách sử dụng mút xốp để lau, sau đó phơi khô bằng không khí.\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\"\u003eKích thước: Kích thước tiêu chuẩn 183 x 61 cm, dày 0,6cm.\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\"\u003eCân nặng của thảm gần 1,4kg (khác với các loại thảm kích thước nhỏ 175 cm x 61 cm và cân nặng chỉ 0,8 -1kg).\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\"\u003eHình thức: Thảm được làm bằng 2 lớp kết dính chắc chắn, màu sắc tinh tế, tạo cảm hứng tập luyện\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align: center;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/7d/ba/47/63185e91848b5192a4f59557f5a4832c.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/34/d5/2f/2c421c11a237ec797ccb4485f706dd28.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/4e/05/d8/67c4630b759eb6479d07e7db4e00d819.jpg\" alt=\"\" width=\"749\" height=\"378\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ad/f9/d2/01e6173a3fc72c0f17e4c4e61a713300.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cstrong\u003eBao đựng thảm rộng rãi, có quoai đeo vai tiện dụng khi mang thảm đến lớp tập\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cstrong\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/35/e6/30/93082b3cc8ac5bb609a42a5b8f72a385.png\" alt=\"\" width=\"500\" height=\"500\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cstrong\u003eHƯỚNG DẪN VỆ SINH THẢM TẬP YOGA\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cstrong\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/product/47/bb/0f/a3ad85d587f1839251a30cebb6a6b185.jpg\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e \u003c/p\u003e\n\u003cp style=\"font-weight: 400;\"\u003eKhi giặt sản phẩm thì bạn nên hòa loãng xà phòng cùng với một chút nước ấm sau đó chà qua thảm nhưng không dùng bàn chải sau đó mang thảm ra phơi ngoài nắng. Ngoài ra nếu bạn giặt bằng máy giặt thì nên để ở chế độ vừa phải.\u003c/p\u003e\n\u003cp style=\"font-weight: 400;\"\u003eHầu hết các thảm trong lần đầu sử dụng đều có những mủn nhỏ bay ra và bạn có thể lau sạch nó bằng một miếng giẻ ướt. Nếu không bạn cứ sử dụng sau một thời gian những mủn đó sẽ tự hết. Tuy nhiên bạn không nên giặt quá nhiều xà phòng để tẩy.\u003c/p\u003e\n\u003cp style=\"font-weight: 400;\"\u003eNếu trong trường hợp thảm của bạn chỉ bị bẩn nhẹ thì bạn chỉ cần xịt nhẹ một chút nước bằng chai xịt hay miêng vải ướt để lau rồi phơi khô trong không khí tự nhiên (\u003cstrong style=\"font-weight: 500;\"\u003eKhông phơi dưới ánh nắng mặt trời\u003c/strong\u003e) . Do được cấu tạo bằng chất cao su thiên nhiên nên chỉ cần một quá trình sử dụng sản phẩm có độ sáng lên rõ rệt và không còn mùi khó chịu.\u003c/p\u003e\n\u003cp style=\"font-weight: 400;\"\u003eĐể rút ngắn thời gian phơi sản phẩm thì bạn dùng một chiếc khăn khô lau rồi mang ra phơi. Càng sử dụng các bạn càng thấy sản phẩm mềm hơn và có độ dai hơn\u003c/p\u003e\n\u003cp style=\"font-weight: 400; text-align: center;\"\u003e\u003cspan style=\"color: #ff0000;\"\u003e\u003cstrong\u003eSỬ DỤNG SẢN PHẨM CHÍNH HÃNG ĐỂ ĐẢM BẢO CHẤT LƯỢNG TỐT NHẤT TỚI TAY NGƯỜI TIÊU DÙNG THÔNG MINH\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/3d/6b/3b/c72b419b02cc6311d1afb593faa6984d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/3d/6b/3b/c72b419b02cc6311d1afb593faa6984d.jpg","medium_url":"https://salt.tiki