_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/91/3f/ab/1435c2a20269321c655c4ac8d5e526a5.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":489,"all_time_quantity_sold":3,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2\u003e\u003cem\u003eNón bảo hiểm nửa đầu màu đen chuyên phượt HT HELMET HP01, mũ bảo hiểm cá tính kèm kính phi công, UV thời trang, cá tính - Hàng chính hãng\u003c/em\u003e\u003c/h2\u003e\n\u003cp\u003e\u003cem\u003e* Freesize : \u003c/em\u003e\u003cstrong\u003edành cho vòng đầu 54-58.5cm \u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/20/d7/b7/8ec1589a25b3e7d49328e58f5a03deff.jpg\" alt=\"\" width=\"640\" height=\"640\" /\u003e\u003cbr /\u003eMũ bảo hiểm HT Helmet mang đến cho các bạn trẻ một dòng sản phẩm mũ bảo hiểm nửa đầu hay còn gọi là mũ bảo hiểm phượt 1/2 dành cho cả nam và nữ, với những màu sắc được in nước cẩn thận, không phai theo thời gian đồng hành trọn đời với khách hàng.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/12/83/40/46f19300c4539bfa8f99678427673a04.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eThân nón hay còn gọi là vỏ nón: được làm từ nhựa ABS chính phẩm,nguyên sinh chưa qua sử dụng nên chất lượng cao, không mùi như các loại mũ chất lượng kém.\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/62/79/b4/50284b0e55e4db0b6696c059b79e6988.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eLớp đệm mút xốp EPS (Foam): có độ cứng vững rất tốt, vừa vặn và bám chặt vào thân nón có tác dụng hấp thụ xung động cao.\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/14/eb/59/f11de82a6ce094a7211c5334298380c5.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eDây đeo và khóa mũ: chắc chắn, với khóa mũ là khóa rút cao cấp, dễ dàng tháo lắp, bền với thời gian.\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/28/b5/8a/007fb42757e577a970619a2fdbe2e39e.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eNước sơn: được sơn bằng công nghệ hiện đại, tạo bề mặt sáng, bóng, nhẵn mịn, không ngả màu.\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/60/45/bd/4225c3929d89d29f697ff99e545a6349.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eĐược kiểm định độ bền và chất lượng kĩ lưỡng trước khi xuất xưởng.\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/34/1e/91/82d88d485079ba7e29c18bb0961627db.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cem\u003e\u003cstrong\u003eLưu ý: Hãy trang trí thêm những chiếc kính UV hay kính phi công để thêm phần thời trang nhé. \u003c/strong\u003e\u003c/em\u003e\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cem\u003e\u003cimg