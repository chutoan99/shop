icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":7,"review_text":"(7)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/08/2d/85/6be218309dcd82c204e8b823e695f49a.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":378,"all_time_quantity_sold":65,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cdiv class=\"ewa-rteLine\"\u003e\u003cstrong\u003eBAO BÌ THAY ĐỔI THEO TỪNG ĐỢT NHẬP HÀNG\u003c/strong\u003e\u003c/div\u003e\n\u003cdiv class=\"ewa-rteLine\"\u003e\u003cstrong\u003e\u003cbr /\u003eBetter For The Planet! Tất cả sản phẩm LISTERINE nay đã được chuyển đổi hoàn toàn thành BAO BÌ TÁI CHẾ \u0026amp; AN TOÀN CHO DÒNG NƯỚC, sự cải tiến ra đời vì mục tiêu chung bảo vệ hành tinh, khuyến khích lối sống phát triển bền vững. Listerine mong muốn được góp phần giải quyết vấn đề rác thải bao bì ra môi trường, đặc biệt là bao bì nhựa ngày càng tăng. Tham khảo thêm về chương trình Bao Bì Tái Chế - Bảo Vệ Hành Tinh tại trang chủ.\u003c/strong\u003e\u003c/div\u003e\n\u003cdiv class=\"ewa-rteLine\"\u003e\u003cstrong\u003e- Giảm mảng bám GẤP 5 LẦN so với chải răng thông thường\u003c/strong\u003e\u003c/div\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/2a/eb/79/6ef8dc68b881c3e3ddafed81a30d5f71.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/d1/46/b0/c5fef647e8c7326ab9279a965662ef32.png\" alt=\"\" /\u003e\u003c/p\u003e\n\u003cp\u003eTHÔNG TIN CHI TIẾT\u003cbr /\u003eNước súc miệng dành cho răng nhạy cảm Listerine Total Care đặc biệt dùng cho răng nhạy cảm với tính làm sạch dịu nhẹ, hoàn toàn không cay rát. Vị bạc hà thanh mát với 6 công dụng trong 1 sản phẩm, được chứng minh lâm sàng làm sạch toàn bộ khoang miệng của bạn và bảo vệ hiệu quả cho vùng răng bị nhạy cảm.\u003c/p\u003e\n\u003cp\u003eCông dụng chính: Dòng nước súc miệng với 10 in 1 công dụng giúp bảo vệ khoang miệng toàn diện khỏi các vấn đề răng nướu.\u003c/p\u003e\n\u003cdiv class=\"ewa-rteLine\"\u003eCông dụng của thành phần:\u003c/div\u003e\n\u003cdiv class=\"ewa-rteLine\"\u003e\u0026gt;99% nhằm tăng cường chăm sóc răng miệng\u003c/div\u003e\n\u003cdiv class=\"ewa-rteLine\"\u003e\u0026lt;1% tạo màu và mùi\u003c/div\u003e\n\u003cdiv class=\"ewa-rteLine\"\u003e\u0026lt;1% ổn định công thức sản phẩm\u003c/div\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/d4/c7/68/f9814bf58461b0370ea579633976412a.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/c9/da/37/40a241f4ff9802b9ef6d1df7cd97a87f.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/d3/16/de/f7f1670673abd80b7e308367b07d8e0d.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/57/ef/36/517b395e8b67006c7b7317d970ff9eb6.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003e1. Giúp diệt 99,9% vi khuẩn - nguyên nhân gây hôi miệng, mảng bám và các vấn đề về nướu\u003cbr /\u003e2. Bảo vệ khoang miệng khỏi vi khuẩn suốt 24 giờ.\u003cbr /\u003e3. Bảo vệ nướu chắc khỏe \u003cbr /\u003e4. Ngăn ngừa sâu răng\u003cbr /\u003e5. Bổ sung Flouride giúp răng chắc khỏe hơn\u003cbr /\u003e6. Giảm sự hình thành mảng bám\u003cbr /\u003e7. Giảm vôi răng giúp răng trắng sáng tự nhiên\u003cbr /\u003e8. Giúp làm sạch trên và giữa nướu răng\u003cbr /\u003e9. Giữ hơi thở thơm mát dài lâu\u003cbr /\u003e10. Khoang miệng sạch toàn diện\u003c/p\u003e\n\u003cp\u003eHướng dẫn sử dụng:\u003cbr /\u003e- Sử dụng 2 lần mỗi ngày sau khi đánh răng\u003cbr /\u003e- Súc miệng với 20ml Listerine trong 30 giây rồi nhổ đi. Không được nuốt.\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003e*Nước súc miệng này không nhằm mục đích thay thế việc đánh răng hoặc dùng chỉ nha khoa\u003cbr /\u003e*Thời tiết lạnh có thể làm mờ sản phẩm này. Tính chất sát trùng không bị ảnh hưởng.\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003eLƯU Ý: Dùng với sự giám sát của người lớn. Không dùng cho trẻ dưới 6 tuổi. Có chứa Sodium Flouride. Nếu có tác dụng không mong muốn xảy ra hoặc nuốt nhầm nước súc miệng, ngừng sử dụng và tư vấn với chuyên gia. Sản phẩm có thể gây ố bề mặt răng tạm thời và có thể ngăn ngừa bằng đánh răng hoặc nhờ nha sĩ hỗ trợ\u003c/p\u003e\n\u003cp\u003eHướng dẫn bảo quản:\u003cbr /\u003e- Bảo quản ở nhiệt độ phòng\u003cbr /\u003e- Nơi khô ráo, tránh ánh nắng trực tiếp.\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003eThành phần chi tiết: Xem trên bao bì sản xuất\u003cbr /\u003eThương hiệu: LISTERINE\u003cbr /\u003eNơi sản xuất: Thái Lan\u003cbr /\u003eNgày sản xuất: Xem trên bao bì sản phẩm\u003cbr /\u003eHạn sử dụng: 3 năm từ ngày sản xuất\u003c/p\u003e\n\u003cp\u003eTHÔNG TIN THƯƠNG HIỆU\u003c/p\u003e\n\u003cp\u003eListerine là nhãn hiệu dung dịch vệ sinh răng miệng của Mỹ được nhà hóa học Joseph Lawrence phát triển vào năm 1879 tại thành phố St. Louis, Missouri. Tên hãng được đặt tên theo bác sĩ Joseph Lister, người đi tiên phong trong vấn đề khử trùng khi phẫu thuật (bệnh viên Hoàng gia Glasgow, Scotland). Thông qua các dòng nước súc miệng của mình, Listerine đã giúp bảo vệ sức khỏe răng miệng cho hơn một tỷ người tiêu dùng trong hơn 140 năm qua và sở hữu hơn 50 thử nghiệm lâm sàng. Listerine sẽ tiếp tục phát triển duy trì các chuẩn mực kinh doanh bền vững, đồng hành cùng tất cả mọi người hình thành thói quen bảo vệ sức khỏe răng miệng.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/08/2d/85/6be218309dcd82c204e8b823e695f49a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/08/2d/85/6be218309dcd82c204e8b823e695f49a.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/08/2d/85/6be218309dcd82c204e8b823e695f49a.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/08/2d/85/6be218309dcd82c204e8b823e695f49a.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/08/2d/85/6be218309dcd82c204e8b823e695f49a.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/89/a4/c7/ef485b9641c794090e2a58cba6da1058.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/89/a4/c7/ef485b9641c794090e2a58cba6da1058.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/89/a4/c7/ef485b9641c794090e2a58cba6da1058.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/89/a4/c7/ef485b9641c794090e2a58cba6da1058.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/89/a4/c7/ef485b9641c794090e2a58cba6da1058.png"},{"base_url":"https://salt.tikicdn.com/ts/product/f3/0e/d9/1ce70372e49221e6e4d7f5ebadf68b22.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f3/0e/d9/1ce70372e49221e6e4d7f5ebadf68b22.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f3/0e/d9/1ce70372e49221e6e4d7f5ebadf68b22.png","position":null,"small_url":"https://salt.tikicdn.com/c