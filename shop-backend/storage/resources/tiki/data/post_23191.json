":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ef/98/e4/0c990fcfac9926aaf3e5244e133a19b1.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1185,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eCông ty phát hành: Wabooks\u003c/p\u003e\n\u003cp\u003eNhà xuất bản: NXB Lao động - Xã hội\u003c/p\u003e\n\u003cp\u003eTác giả: Misaki Kirimaru\u003c/p\u003e\n\u003cp\u003eLoại bìa: Bìa mềm\u003c/p\u003e\n\u003cp\u003eSố trang: 28 trang\u003c/p\u003e\n\u003cp\u003eMực in màu chiết xuất dầu đậu nành nhập khẩu Nhật Bản an toàn cho bé\u003c/p\u003e\n\u003cp\u003eGiấy C150 dày khó nhàu rách\u003c/p\u003e\n\u003cp\u003eNăm xuất bản: 6/2020\u003c/p\u003e\n\u003cp\u003eHướng dẫn bố mẹ phương pháp đọc Ehon được in ở đầu mỗi cuốn sách.\u003cbr /\u003e\u003cbr /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\"Bộ SáCh Ehon Tớ Là Em Bé Ngoan\"\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e“Tớ là em bé ngoan” là bộ sách Ehon gồm 4 cuốn “Chúng mình xin lỗi bạn nhé!”; “Để chúng mình giúp bạn!”; “Cảm ơn bạn cảnh sát hành tây!”; “Thức dậy nào! Thức dậy nào!”. Bộ sách phù hợp với trẻ từ 2 tuổi và thông qua các từ láy, từ tượng thanh, bộ sách sẽ góp phần phát triển Thùy Thái Dương, phần não ảnh hưởng đến khả năng ngôn ngữ của con đấy.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eĐi cùng với bộ sách, các bé sẽ học được những câu chuyện ứng xử rất đỗi đời thường, nhưng lại là hành trang vô cùng quan trọng để hình thành nên nhân cách và tính cách của trẻ sau này. Ở mỗi cuốn sách, bé sẽ tìm hiểu được cách bày tỏ sự biết ơn, cách nói lời xin lỗi hoặc bộc lộ đức tính luôn sẵn sàng giúp đỡ mọi người xung quanh. Những kiến thức sẽ được lồng ghép trong câu chuyện và tình huống thực tế nhưng không kém phần ngộ nghĩnh, sẽ giúp trẻ thực hành tốt hơn\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/db/8b/a1/db88db8a3950acea2f1fef802644a2f3.png\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/db/8b/a1/db88db8a3950acea2f1fef802644a2f3.png\" alt=\"\" width=\"750\" height=\"356\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/04/65/c4/fce7c82bbabe2b6e47177911c3929520.png\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/04/65/c4/fce7c82bbabe2b6e47177911c3929520.png\" alt=\"\" width=\"750\" height=\"356\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/37/16/81/10d33230600e74c5199a5c85f5f678c1.png\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/37/16/81/10d33230600e74c5199a5c85f5f678c1.png\" alt=\"\" width=\"750\" height=\"356\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/23/bc/d1/5557d2c742a3aa795c44f03e86ee47f2.png\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/23/bc/d1/5557d2c742a3aa795c44f03e86ee47f2.png\" alt=\"\" width=\"750\" height=\"356\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/5d/ac/d0/046ad7c4a504dbd12f3dca420562e2b6.png\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/5d/ac/d0/046ad7c4a504dbd12f3dca420562e2b6.png\" alt=\"\" width=\"750\" height=\"356\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/0b/1d/5d/8487a79623f8bfee5e92afddbcca5d4d.png\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/0b/1d/5d/8487a79623f8bfee5e92afddbcca5d4d.png\" alt=\"\" width=\"750\" height=\"356\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/8b/aa/02/42622dd46c903faafba873c400c6ad72.png\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/8b/aa/02/42622dd46c903faafba873c400c6ad72.png\" alt=\"\" width=\"750\" height=\"356\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/af/c0/79/8fdb26de48b9dabcb6d0893021a03144.png\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/af/c0/79/8fdb26de48b9dabcb6d0893021a03144.png\" alt=\"\" width=\"750\" height=\"356\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eBộ sách Ehon “Chúng mình lớn rồi” dành cho trẻ từ 3 - 6 tuổi\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e“Chúng mình lớn rồi” là bộ sách Ehon 4 cuốn gồm “Dọn đồ chơi nào!”, “Đi câu cá với bố”, “Trường mẫu giáo của tớ”, “Chị và em bé” dành cho trẻ từ 3-6 tuổi. Những câu chuyện Ehon này sẽ giúp phát triển Thùy Đỉnh – phần não có chức năng điều khiển các chức năng vận động toàn thân, sự linh hoạt của cơ thể, nâng cao thể chất cho trẻ, tạo tiền đề phát triển tối đa trí tuệ và sức khỏe. Từ các câu chuyện hằng ngày đơn giản, bé được rèn tính tự lập và trách nhiệm qua những kỹ năng bổ ích. Bé còn được trau dồi tình yêu gia đình, sự cảm thông, chia sẻ với những người xung quanh.\u003c/p\u003e\n\u003cp\u003eTrẻ em dù bé tí xíu xiu nhưng trong suy nghĩ của con sẽ luôn tò mò và mong muốn trở thành người lớn. Đối với trẻ, thế giới của người lớn thật nhiệm màu, tự do và cả trách nhiệm nữa. Đặc biệt ở giai đoạn mẫu giáo, con sẽ lớn rất nhanh về cả suy nghĩ và thể chất. Vì vậy, vai trò của bố mẹ trong thời kỳ này rất quan trọng để giúp định hình tính cách và nuôi dưỡng tâm hồn các bé trở thành những em bé có trách nhiệm, tự lập và giàu lòng yêu thương đấy. Dù cuộc sống bộn bề nhưng bố mẹ hãy dành vài phút đọc sách Ehon cùng con để nuôi dưỡng tâm hồn và trí tuệ bé ngày một lớn khôn nhé!\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/9a/aa/a5/ca27f17e91e6b0b47a4fc035d2d826f5.png\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/9a/aa/a5/ca27f17e91e6b0b47a4fc035d2d826f5.png\" alt=\"\" width=\"750\" height=\"356\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/81/78/5d/7f1a9a93f53d8c14fbc8da76d5732b47.png\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/81/78/5d/7f1a9a93f53d8c14fbc8da76d5732b47.png\" alt=\"\" width=\"750\" height=\"356\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/cf/02/5a/99d1ca4392ae2561b897b5eb929ca315.png\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/cf/02/5a/99d1ca4392ae2561b897b5eb929ca315.png\" alt=\"\" width=\"750\" height=\"356\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/1a/23/26/4380869c22ea36d71758d1d888e86e92.png\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/1a/23/26/4380869c22ea36d71758d1d888e86e92.png\" alt=\"\" width=\"750\" height=\"356\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/4d/b0/54/582f39b0d0207a3977684beedd6fe4a1.png\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/4d/b0/54/582f39b0d0207a3977684beedd6fe4a1.png\" alt=\"\" width=\"750\" height=\"356\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/5c/f0/e8/7e57484c92c9e0c37d8a258282783811.png\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/5c/f0/e8/7e57484c92c9e0c37d8a258282783811.png\" alt=\"\" width=\"750\" height=\"356\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\"Bộ SáCh Ehon Những câu chuyện vụn vặt của Maru\"\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eBộ ehon Những mẩu chuyện vụn vặt của Maru phù hợp cho trẻ từ 24 tháng tuổi trở lên, gồm có 6 cuốn, chia thành 2 bộ nhỏ hơn là Maru lớn rồi (gồm \"Maru rụng răng\", \"Maru một ngày xui xẻo\", \"Maru và hạt dưa”) và Maru giúp mẹ (gồm \" Maru đi vệ sinh\", \"Maru quét nhà\", \"Maru tập rửa bát\"), chú trọng về việc dạy trẻ các kỹ năng tư duy khi quan sát những sự việc xảy ra xung quanh hằng ngày.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eBạn mèo nhỏ Maru trong bộ truyện này cũng là một em bé giống như các con thôi, và bạn ấy tự nhận thấy mình đã lớn và cần phải học cách làm người lớn với việc tập làm việc nhà và quan sát những biến đổi trong cơ thể của mình. Bạn nhỏ Maru sẽ cùng các con đồng hành trong quá trình học làm người lớn này đấy, vậy nên lỡ có điều gì chưa đúng thì cũng đừng cười Maru nhé, chúng mình học hỏi nhau để cùng lớn lên mà.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eMaru cũng như bao bạn nhỏ khác, có những thắc mắc về chính bản thân mình và về thế giới xung quanh mà bạn ấy hỏi khắp mọi nơi, khám phá đủ mọi thứ để tìm câu trả lời. Những thắc mắc bé xíu trong con nếu không được trả lời một cách rõ ràng, hợp lý thì sẽ trở thành những “nỗi niềm” mà con không biết chia sẻ cùng ai. Vậy nên, bố mẹ hãy để bạn Maru làm bạn với con trẻ để cùng con giải quyết gọn những vấn đề đó nhé!\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eMaru cũng có lúc từng thắc mắc rằng tại sao khi Maru đang thích ăn cả thế giới thì bạn răng lại bỏ mình mà đi, làm Maru lo lắng biết bao rằng sẽ không còn răng để nhai đồ ăn, không còn răng để cười thật tươi nữa. Bạn ấy nghĩ đó là một điều khiến bạn ấy xấu hổ biết bao. Nhưng thật may mắn, nhờ những người bạn thân thiết chọc cười, Maru mới nhận ra rằng thực ra rụng răng không có gì là xấu, thậm chí các bạn khác còn ngưỡng mộ biết bao khi thấy Maru đã có dấu hiệu trở thành người lớn.\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/8e/b8/79/24b0a3810cab381664ee239ac2b45f57.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/8e/b8/79/24b0a3810cab381664ee239ac2b45f57.jpg\" alt=\"\" width=\"750\" height=\"375\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/7e/ba/32/968b9277b878339775384a99d8ffc9c8.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/7e/ba/32/968b9277b878339775384a99d8ffc9c8.jpg\" alt=\"\" width=\"750\" height=\"375\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u00