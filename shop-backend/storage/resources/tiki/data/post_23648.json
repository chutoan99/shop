.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":3598000,"discount_rate":20,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/8a/53/68/2535b6872099d51a9e03190bb9d9b487.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":565,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2 style=\"text-align:center;\"\u003e\u003cstrong\u003eLoa karaoke công suất lớn 2200W TS-15A6000\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/8a/53/68/a10049d983a4db55753920a5b9b98bb3.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eCông suất: 2200W\u003c/li\u003e\n\u003cli\u003eLoa bass: 15 inch x 2 (2 loa 4 tấc)\u003c/li\u003e\n\u003cli\u003eLoa treb: 1.5 inch x 2 (2 loa treb còi 5 inch)\u003c/li\u003e\n\u003cli\u003eKết nối: Bluetooth, USB, AUX, SD Card, đài FM\u003c/li\u003e\n\u003cli\u003eNguồn điện: 220V/50Hz - 60Hz\u003c/li\u003e\n\u003cli\u003eBình acquy: không, sử dụng nguồn điện 220V trực tiếp\u003c/li\u003e\n\u003cli\u003eMicro: đi kèm 2 micro UHF\u003c/li\u003e\n\u003cli\u003eKích thước: (82 x 95 x 40) cm\u003c/li\u003e\n\u003cli\u003eTrọng lượng: 58 kg\u003c/li\u003e\n\u003cli\u003ePhụ kiện bao gồm: Sách hướng dẫn, dây nguồn, 2 miscro không dây, pin.\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/e3/0b/9f/f2d1085eae1b4a0f040ace577ec3c3ed.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan\u003e Về thiết kế bên ngoài\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e️ Một sự đột phá mới trong thiết kế của Dalton. Dòng loa kéo có thiết kế dạng tủ đầu tiên của Dalton được ra đời trong năm 2021.\u003c/p\u003e\n\u003cp\u003eLoa kéo tủ Dalton TS-15A6000 với chất liệu thùng gỗ MDF 15mm sơn nhám chắc chắn giúp gia tăng hiệu suất khuếch đại âm thanh và thiết kế dạng tủ giúp loa phát huy được hết công suất, âm thanh lan tỏa rộng hơn.\u003c/p\u003e\n\u003cp\u003e️ Mặt lưới loa TS-15A6000 được Da\u003c/p\u003e\n\u003cp\u003e\u003cspan\u003e Về thiết kế bên trong\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e️ Loa kéo điện Dalton TS-15A6000 sử dụng mạnh công suất A-B giúp đem đến chất âm trung thực nhất.\u003c/p\u003e\n\u003cp\u003e️ Loa được trang bị hệ thống 4 loa 2 đường tiếng (2 ways) gồm:\u003c/p\u003e\n\u003cp\u003e+ 02 loa bass (sub woofer) 4 tấc (15 inch)\u003c/p\u003e\n\u003cp\u003e+ 02 loa treb còi 1.5 inch\u003c/p\u003e\n\u003cp\u003e️ Loa sử dụng ồn điện 220V, không có bình acquy bên trong. Việc sử dụng ồn điện 220V giúp cho loa đạt được công suất mạnh mẽ nhất và hoạt động ổn định hơn. Chính vì vậy mà giúp loa đạt đến công suất 2200W. Có thể nói loa giống như một dàn nhạc sống khủng ngoài trời, loa thích hợp cho các không gian rộng lớn, bữa tiệc ngoài trời.\u003c/p\u003e\n\u003cp\u003e TS-15A6000 chính là tâm điểm mọi cuộc chơi.\u003c/p\u003e\n\u003cp\u003eLoa kéo TS-15A6000 cũng đi kèm là 02 micro không dây sóng UHF. Việc sử dụng tần số UHF giúp cho việc kết nối và truyền tín hiệu micro được chuẩn và mạnh mẽ hơn. Đặc biệt micro không dây có khả năng chỉnh được tần số kết nối. Việc này giúp cho loa tránh trường hợp trùng lặp tần số micro với các loa khác ở gần. Thân micro được thiết kế bằng chất liệu kim loại cứng cáp, sơn tĩnh điện màu vàng cùng họa tiết gấp sóng giúp tạo nét thẩm mỹ và sự sang trọng cho micro.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/5b/3c/e7/85e4d17976ab74505e52b1ad358ba328.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003elton sử dụng chất liệu thép sơn tĩnh điện màu đồng ánh kim rất đẹp và tạo độ sang trọng cho sản phẩm. Các họa tiết trên mặt lưới cũng giúp tăng thêm tính thẩm mỹ cho loa.\u003c/p\u003e\n\u003cp\u003e️ Đặc biệt với kiểu thiết kế dạng tủ, loa kéo điện Dalton TS-15A6000 có bảng nút chỉnh được đưa ra phía mặt trước, các hàng nút chỉnh cũng được Dalton sắp xếp vị trí chuẩn mực và phù hợp nhất giúp thuận tiện và dễ sử dụng hơn.\u003c/p\u003e\n\u003cp\u003e️ Loa được thiết kế 4 bánh xe cỡ lớn cứng cáp có thể xoay 360 độ giúp cho việc di chuyển loa được dễ dàng. Hai bên thành loa có bố trí tay vị phục vụ cho việc khiêng nhấc.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/d8/c7/a0/b6e1a711698a56cbd8eec9e1e39b41c9.jpg\" alt=\"\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/a9/8d/d6/8345e88005b29902fc0e8f8cdd93557f.jpg\" alt=\"\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/71/6b/d2/f10eddd9f16dc8c25fea2f71043fd3e6.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts