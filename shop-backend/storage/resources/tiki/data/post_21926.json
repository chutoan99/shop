_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":65000,"discount_rate":19,"rating_average":4.5,"review_count":4,"review_text":"(4)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/68/69/a7/de10d8acfd898fdb3513f943b52dc750.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":967,"all_time_quantity_sold":24,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eMáy massage cầm tay Rhino MG201 - 6 cấp độ, 4 đầu tiện dụng, pin sạc type C, hỗ trợ mát xa tại nhà, giảm đau, nhức mỏi cơ, cứng khớp - Hàng chính hãng\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/39/a4/22/105757bb6da2dac8cded3e8dcc468992.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eDân văn phòng luôn đau cổ,vai gáy, t,ê bì chân tay do ngồi lâu, người chơi thể thao hoặc lao động mạnh cũng không tránh khỏi cứng cơ thậm chí chuột rút. \u003cbr /\u003eĐặc biệt là người cao tuổi, người có tiền sử chấn thương khi thay đổi thời tiết khiến cơ thể đau nhức đừng cam chịu \"sống chung với lũ\" nữa.\u003cbr /\u003eMáy Massage cầm tay Rhino MG201 sẽ là câu trả lời hoàn hảo cho các vấn đề mà bạn đang gặp phải\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/4a/55/58/7f1ffc619c4616c50d4a8fd6c0541927.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eI. THÔNG TIN CHI TIẾT\u003c/strong\u003e\u003cbr /\u003e- Đối tượng: Cả nam và nữ, trẻ em từ 10 tuổi trở lên\u003cbr /\u003e- Chức năng: Rung massage với 4 đầu, 6 chế độ \u003cbr /\u003e- Kích thước: 12,8 x 4,2 x 13 cm\u003cbr /\u003e- Trọng lượng: 430 gram\u003cbr /\u003e- Chất liệu vỏ: Nhựa ABS\u003cbr /\u003e- Màu sắc: Đen/Xám/Hồng/Đỏ\u003cbr /\u003e- Nguồn điện: Pin sạc 7,4V\u003cbr /\u003e- Cổng sạc: Type C\u003cbr /\u003e- Dung lượng pin: 1500mah\u003cbr /\u003e- Công suất: 30W\u003cbr /\u003e- Tần số: 9-20Hz\u003cbr /\u003e- Tốc độ: 1800-3200 vòng/phút\u003cbr /\u003e- Trọng lượng tổng: 0,8kg\u003cbr /\u003e- Bảo hành: 90 ngày\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/35/e5/be/627e38bbba55c5d3d04b846683d42d0b.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eII. ĐẶC ĐIỂM NỔI BẬT:\u003c/strong\u003e\u003cbr /\u003e- 6 CẤP ĐỘ MASSAGE: Máy massage cầm tay Rhino MG201 bao gồm 6 lựa chọn tốc độ cho bạn, giúp cơ bắp được massage sâu, lý tưởng để phục hồi cơ bắp sau khi tập thể dục hoặc sau một ngày làm việc mệt mỏi. \u003cbr /\u003e- HIỆU SUẤT PIN CAO: Sản phẩm sử dụng Pin lithium-ion có thể sạc, Công suất 1500mah giúp bạn sử dụng trong thời gian dài mà không lo hết pin\u003cbr /\u003e- HOẠT ĐỘNG YÊN TĨNH: Động cơ mô-men xoắn cao mạnh mẽ, có tần số cao với xung động từ 1800 - 3200 vòng/phút (tùy chỉnh), Rhino MG101 sẽ dễ dàng massage cực sâu bên trong, đốt cháy cacbonhydrat giúp giảm nhanh mỡ thừa, lấy lại vóc dáng săn chắc. Công nghệ lướt nhẹ, siêu im lặng khi mát xa.\u003cbr /\u003e- AN TOÀN: Vỏ máy được làm bằng vật liệu nhựa ABS an toàn với cơ thể, thiết kế bảo vệ thông minh. Tay cầm của máy massage rất tiện dụng, chống trơn trượt.\u003cbr /\u003e- ĐẦU MASSAGE CÓ THỂ THÁO RỜI: Rhino MG201 có sẵn 4 loại đầu massage để đáp ứng nhu cầu của các cơ khác nhau. Đầu massage có thể được tháo ra để dễ dàng lắp đặt và vệ sinh.\u003cbr /\u003e+ ĐẦU NỐI HÌNH CẦU: Massage toàn thân, bụng, các nhóm cơ lớn, bắp tay/chân\u003cbr /\u003e+ ĐẦU NỐI CHỮ U: Massage đốt sống cổ, cột sống và các khớp\u003cbr /\u003e+ ĐẦU NỐI HÌNH NÓN: Massage các kinh mạch, lòng bàn tay, bàn chân\u003cbr /\u003e+ ĐẦU NỐI DẠNG GAI: Massage tạo dáng tại các vùng chân, tay, mông\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/4e/11/6a/bbe7a38c3dfb1e78a7f879ac07095bcf.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eIII. HƯỚNG DẪN SỬ DỤNG\u003c/strong\u003e \u003cbr /\u003e- Nhấn giữ nút nguồn 2 giây để bật/tắt máy, nhấn để chọn tốc độ\u003cbr /\u003e- Sử dụng sau khi hoạt động thể thao, làm việc, lao động giúp thư giãn cơ thể, vóc dáng săn chắc\u003cbr /\u003e- Sử dụng 3-4 lần/ngày, mỗi lần 10-15 phút để đạt hiệu quả tốt nhất\u003cbr /\u003e- Bảo quản nơi khô ráo, thoáng mát, không để máy tiếp xúc với nước, lửa\u003cbr /\u003e- KHÔNG sử dụng máy khi đang sạc pin\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/65/c4/79/59c0fac4df1de2ad46e13379e7647782.jpg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/65/c4/79/59c0fac4df1de2ad46e13379e7647782.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/76/1a/dc/eae