"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":28000,"discount_rate":30,"rating_average":5,"review_count":27,"review_text":"(27)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/a9/d0/58/1b5291c9cbd835b384de1a4334fa6bd4.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":453,"all_time_quantity_sold":480,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cspan style=\"color:#0000ff;\"\u003e\u003cstrong\u003ePhilips\u003c/strong\u003e\u003c/span\u003e là một trong những \u003cspan style=\"color:#ffcc00;\"\u003e\u003cstrong\u003ethương hiệu chiếu sáng\u003c/strong\u003e\u003c/span\u003e đáng tin cậy hàng đầu trên toàn thế giới. Với đến công nghệ luôn được cải tiến, chất lượng sản phẩm vượt trội, giá thành hợp lý giúp cải thiện và nâng cao chất lượng sống của con người.\u003c/p\u003e\n\u003cp\u003eCác dòng sản phẩm chiếu sáng thương hiệu \u003cspan style=\"color:#0000ff;\"\u003e\u003cstrong\u003ePhilips \u003c/strong\u003e\u003c/span\u003eđược Nhập khẩu và Phân phối chính hãng tại thị trường Việt Nam, đáp ứng các tiêu chuẩn an toàn Quốc tế mang lại sự tin cậy cho người dùng.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/16/5f/46/96ca10487ce8edc8f9f8f0e902a1f800.jpg\" alt=\"Thương hiệu Philips\" width=\"750\" height=\"550\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eBộ 2 bóng đèn LED Bulb \u003c/strong\u003e\u003cstrong\u003eEssential\u003c/strong\u003e\u003cstrong\u003e Philips\u003c/strong\u003e là dòng sản phẩm với giá thành cực tốt, hiệu suất phát sáng cao hoạt động tốt trong môi trường có điện áp không ổn định 100 - 270V.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/92/2d/e8/c5c21b9292bef5d06c1a2a4946c70bb2.jpg\" alt=\"Bóng LED Bulb Philips\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eSản phẩm được ứng dụng thay thế bóng Compact 3U, bóng xoắn gắn trong các chóa đèn lon âm trần, đèn lon nổi truyền thống, đèn bàn học, đèn trang trí sử dụng \u003cstrong\u003eđui đèn xoắn chuẩn E27\u003c/strong\u003e. Mang lại không gian chiếu sáng hoàn hảo cho ngôi nhà của bạn với kinh phí thấp nhất.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/9b/ee/b0/ec3da6b6410f722322bd05aaf02677ce.jpg\" alt=\"Thông số kỹ thuật bóng LED Bulb\" width=\"750\" height=\"650\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eBóng đèn LED Bulb \u003c/strong\u003e\u003cstrong\u003eEssential\u003c/strong\u003e\u003cstrong\u003e Philips\u003c/strong\u003e có 2 màu ánh sáng cơ bản:\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e- Ánh sáng Trắng:\u003c/strong\u003e Tạo môi trường năng động, hứng khởi cho các hoạt động sinh hoạt hằng ngày, thích hợp cho các môi trường làm việc, sinh hoạt như nhà ở, cửa hàng, văn phòng.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e- Ánh sáng Vàng:\u003c/strong\u003e Tạo môi trường sang trọng, ấm cúng và có phần lãng mạn, thích hợp dùng trong nhà hàng, khách sạn.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/77/bc/72/b164791a9962ef59c42b305d0412589e.jpg\" alt=\"So sánh bóng LED Bulb Essential\" width=\"750\" height=\"254\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/4c/be/e7/097fb91220882884add2944a5de8ef2d.jpg\" alt=\"Vì sao chọn đèn Philips\" width=\"750\" height=\"304\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/e5/33/c0/2c0fd5d3bf8027d165e4faf78f66b5a4.jpg\" alt=\"Hỗ trợ mua đèn LED Philips\" width=\"750\" height=\"238\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/a9/d0/58/1b5291c9cbd835b384de1a4334fa6bd4.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a9/d0/58/1b5291c9cbd835b384de1a4334fa6bd4.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a9/d0/58/1b5291c9cbd835b384de1a4334fa6bd4.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a9/d0/58/1b5291c9cbd835b384de1a4334fa6bd4.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a9/d0/58/1b5291c9cbd835b384de1a4334fa6bd4.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/7a/4f/51/f602109b631035316396ce94b020420c.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/7a/4f/51/f602109b631035316396ce94b020420c.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/7a/4f/51/f602109b631035316396ce94b020420c.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7a/4f/51/f602109b631035316396ce94b020420c.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7a/4f/51/f602109b631035316