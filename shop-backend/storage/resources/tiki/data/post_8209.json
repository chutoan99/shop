:"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.8,"review_count":8,"review_text":"(8)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/5e/d8/ac/4f08ed5612596bc90ad0f874b24cdbb7.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1170,"all_time_quantity_sold":47,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003eGiới Thiệu\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eTy ngậm Philips Avent hình thú dành cho bé 0-6 tháng tuổi. Với thiết kế siêu thoáng khí, sản phẩm không chỉ mang đến cảm giác thoải mái cho bé khi sử dụng, mà còn hỗ trợ phát triển cấu trúc răng miệng khỏe mạnh.\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003eChất Liệu\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eChất liệu sản phẩm: Silicon không chứa BPA\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003eĐặc Điểm Nổi Bật\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eTy ngậm thông khí Lime: Ty ngậm nhẹ, thông khí\u003c/li\u003e\n\u003cli\u003eNúm ty nhẹ, có các lỗ thoát khí lớn, nhẹ nhàng thông hơi, giúp làn da bé được mềm mại, khô thoáng.\u003c/li\u003e\n\u003cli\u003eChất liệu lý tưởng cho cảm giác thoải mái: Tất cả mọi chi tiết của ty ngậm thông khí Ultra air đều được thiết kế để mang đến cho bé cảm giác nhẹ nhàng thoải mái, đặc biệt là phần đầu ty dài và mềm.\u003c/li\u003e\n\u003cli\u003eHỗ trợ quá trình phát triển răng miệng của trẻ với ty ngậm đối xứng, giữ nguyên hình dáng tự nhiên của vòm miệng, răng và nướu của bé.\u003cbr /\u003eKhử trùng và bảo quản trong hộp đựng tiện dụng: Hộp đựng ty ngậm thông khí ultra air khi di chuyển cũng có tác dụng như một hộp khử trùng, vì vậy tất cả những gì bạn cần làm là cho thêm nước và để vào lò vi sóng. Bạn sẽ chẳng còn phải bận tâm bởi ty ngậm sẽ hoàn toàn sạch sẽ cho lần dùng tiếp theo.\u003c/li\u003e\n\u003cli\u003eVòng tay cầm an toàn, dễ tháo: Vòng tay cầm an toàn của Philips Avent cho phép bạn dễ dàng tháo ty ngậm bất cứ lúc nào. Thậm chí bàn tay bé nhỏ của trẻ cũng có thể cầm nắm tốt.\u003c/li\u003e\n\u003cli\u003eDễ khử trùng, đảm bảo vệ sinh: Vệ sinh ty ngậm rất dễ dàng, chỉ cần cho ty ngậm vào máy khử trùng hoặc ngâm trong nước ấm.\u003c/li\u003e\n\u003cli\u003eThiết kế kiểu dáng và màu sắc hợp thời trang: Ty ngậm thông khí ultra air luôn bắt kịp xu hướng thiết kế tươi sáng và đầy màu sắc, để bạn và bé luôn cảm thấy vui vẻ trải nghiệm những phong cách mới nhất.\u003c/li\u003e\n\u003cli\u003eCó thể vệ sinh bằng máy rửa chén\u003c/li\u003e\n\u003cli\u003eKhông có BPA*\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003eHướng Dẫn Sử Dụng\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eTrước khi cho trẻ ngậm ti giả, ba mẹ nên tiệt trùng bằng cách trụng nước sôi khoảng 5 phút, hoặc đặt ty ngậm đã rửa sạch vào hộp đựng, thêm 25 ml nước rồi cho vào lò vi sóng, chỉnh công suất 750 – 1000 W, hẹn giờ 3 phút. Sau đó, để nguội trong 5 phút, đổ nước ra và lấy ty ngậm ra dùng.\u003c/li\u003e\n\u003cli\u003eKhông khử trùng ti giả với nhiệt độ quá cao trên 100 độ C sẽ làm biến dạng ti giả.\u003c/li\u003e\n\u003cli\u003eĐể đảm bảo vệ sinh nên thay ti giả cho bé sau 1 – 3 tháng.\u003c/li\u003e\n\u003cli\u003eSản phẩm chịu được nhiệt độ ở 100 độ C kèm hộp đựng có thể khử trong lò vi sóng.\u003c/li\u003e\n\u003cli\u003eHạn sử dụng: 5 năm kể từ ngày sản xuất\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/ee/5e/9f/2edd7ca49b621b63ac800b17c0b9f5db.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/6b/a1/93/bd3db40549f9138ea92b074882077561.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/e1/ae/82/773559aa56756f3b1bf72c7efcc1013b.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/5e/d8/ac/4f08ed5612596bc90ad0f874b24cdbb7.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/5e/d8/ac/4f08ed5612596bc90ad0f874b24cdbb7.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/5e/d8/ac/4f08ed5612596bc90ad0f874b24cdbb7.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5e/d8/ac/4f08ed5612596bc90ad0f874b24cdbb7.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5e/d8/ac/4f08ed5612596bc90ad0f874b24cdbb7.png"},{"base_url":"https://salt.tikicdn.com/ts/product/32/7e/9f/733fec5d69058feee2ecd7e056826ac2.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/32/7e/9f/733fec5d69058feee2ecd7e056826ac2.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/32/7e/9f/733fec5d69058feee2ecd7e056826ac2.png","position":null,"small_url":"https://salt.tikicdn.com/cache/2