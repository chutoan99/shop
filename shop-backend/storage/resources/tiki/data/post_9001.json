” sẽ giúp các em hiểu và yêu thêm lịch sử nước nhà.\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/26/3b/52/5d459f3af27fac4549cdc01be44b2d0e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/26/3b/52/5d459f3af27fac4549cdc01be44b2d0e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/26/3b/52/5d459f3af27fac4549cdc01be44b2d0e.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/26/3b/52/5d459f3af27fac4549cdc01be44b2d0e.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/26/3b/52/5d459f3af27fac4549cdc01be44b2d0e.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/06/7a/21/0bd0cd2a50b364e5dca0d887003d079f.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/06/7a/21/0bd0cd2a50b364e5dca0d887003d079f.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/06/7a/21/0bd0cd2a50b364e5dca0d887003d079f.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/06/7a/21/0bd0cd2a50b364e5dca0d887003d079f.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/06/7a/21/0bd0cd2a50b364e5dca0d887003d079f.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/12/58/19/e3d55ae3cdcc4ee25116e22b88b935a2.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/12/58/19/e3d55ae3cdcc4ee25116e22b88b935a2.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/12/58/19/e3d55ae3cdcc4ee25116e22b88b935a2.jpg","position":null,"small_url":"https://salt.tikicdn.co