icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":61000,"discount_rate":12,"rating_average":2,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/e7/07/61/e6357cc95762101b7315accf41187aec.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1153,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<h1 style=\"text-align: center;\"><strong>CẶP ĐA NĂNG SIMPLEX TÙY BIẾN THÔNG MINH</strong></h1>\n<p style=\"text-align: justify;\"><em>SIMPLEX là bộ sưu tập Cặp đa năng dành cho học sinh thuộc nhãn hàng STARGO. Nhanh nhẹn tùy biến thành balo năng động, cặp đeo chéo tiện lợi hay túi xách lịch lãm, tất cả đều được gói gọn trong chiếc cặp đa năng SIMPLEX. Ngoài yếu tố tiện dụng từ sự đa năng, dòng cặp đa năng SIMPLEX còn chinh phục người dùng bởi chất liệu trượt nước vượt trội cùng thiết kế đơn giản nhưng bền bỉ cùng thời gian.</em></p>\n<h2 style=\"text-align: center;\"><strong>Gói gọn sự tiện dụng và xu hướng hiện đại</strong></h2>\n<p style=\"text-align: center;\"><strong><img src=\"https://salt.tikicdn.com/ts/tmp/b7/bf/f8/06f13210aa77d5ce3459b7545cfef42f.png\" alt=\"\" width=\"478\" height=\"478\" /></strong></p>\n<p>STARGO SIMPLEX sử dụng chất liệu Polyester kết hợp Nylon tạo nên những tính năng vượt trội. Chống nước, hút ẩm, bền chắc cùng thời gian xua tan cảm giác lo lắng về vấn đề dính nước mưa làm hư hại các thiết bị bên trong.</p>\n<p><img style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/1b/0d/15/42a3033f871d839636087e593e0854c0.png\" alt=\"\" width=\"489\" height=\"489\" /></p>\n<p>Ngoài chức năng là một chiếc balo laptop, SIMPLEX còn là một chiếc túi đeo chéo cho học sinh hay cặp xách tay cho các chuyến đi công tác ngăn ngày của dân văn phòng.</p>\n<p><img style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/82/dc/36/a466e674d8043b70a504fba5d2800140.png\" alt=\"\" width=\"454\" height=\"454\" /></p>\n<h2 style=\"text-align: center;\"><strong>Thiết kế đa năng, phù hợp với nhiều mục đích</strong></h2>\n<p><strong><img style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/a6/ac/16/6316283bb98900b6d94cace159bf668b.png\" alt=\"\" width=\"529\" height=\"529\" /></strong></p>\n<p>Cặp đa năng STARGO SIMPLEX có phân ngăn thông minh mang lại tiện ích vượt trội. Ngăn đựng laptop vừa vặn với các dòng máy có kích thước lên đến 15 inch.</p>\n<p><img style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/4b/8f/0b/fa67f7f5c92b2149baa6cc60a2a97c46.png\" alt=\"\" width=\"422\" height=\"422\" /></p>\n<p>Ngăn chính ở giữa thích hợp mang theo sách vở, quần áo hay các phụ kiện cần thiết. Hai ngăn phụ ngoài cùng mang đến sự tiện dụng trong việc phân chia các vật dụng một cách nhanh chóng, đảm bảo an toàn cho đồ dùng.</p>\n<p><img style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/1e/6f/b8/77fb37d08db92db0ee54906b520d915e.png\" alt=\"\" width=\"499\" height=\"499\" /></p>\n<p>Kiểu dáng hiện đại, thời trang cùng sự tinh tế trong từng đường kim mũi chỉ phù hợp với nhiều mục đích từ đi học, đi làm đến du lịch, dã ngoại.</p>\n<h2 style=\"text-align: center;\"><strong>Bảo vệ sức khỏe người dùng</strong></h2>\n<p style=\"text-align: justify;\">Quai xách cặp đa năng SIMPLEX được thiết kế ở phần cao nhất của chiếc túi, to bản, dày, bảo vệ da tay cho người sử dụng. Quai xách còn cần thiết trong những trường hợp treo balo lên giá đỡ hoặc móc treo khác…</p>\n<p><img style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/8f/2a/94/a7c32e37e5b14dab59bd7486f760e110.png\" alt=\"\" width=\"484\" height=\"484\" /></p>\n<p>Quai đeo chắc chắn kết hợp đệm lưới EVA mang đến cảm giác dễ chịu, không bị mỏi vai trong thời gian sử dụng lâu dài. Quai đeo có thể linh hoạt thay đổi chiều dài để phù hợp với vóc dáng.</p>\n<p><img style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/4d/67/6b/3bb066cc55e34d763bd41de4e86d438b.png\" alt=\"\" width=\"538\" height=\"538\" /></p>\n<p>Phần lưng balo có bố trí 2 phần lớp đệm lưới EVA dày, khả năng thoát khí, chống thấm mồ hôi hiệu quả. Phần đệm quai và đệm lưng khiến bạn luôn thoải mái khi balo tiếp xúc trực tiếp với cơ thể của mình.</p>\n<p><strong><em>Cặp đa năng STRAGO SIMPLEX –  giải pháp mang đến tiện ích tối ưu.</em></strong></p>\n<p> </p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/e7/07/61/e6357cc95762101b7315accf41187aec.png","is_gallery":true,"label":null,"large_url":"https://sa