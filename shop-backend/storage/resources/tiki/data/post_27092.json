or":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":47000,"discount_rate":20,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/d3/0f/19/10fa21d482b434c761bf2a33fc60a09d.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1073,"all_time_quantity_sold":21,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eCó một sự thật là trẻ con rất thích nghe đọc thơ, nhất là những bài thơ có vần điệu, ngắn và dễ nhớ, dễ thuộc. Trong lúc chờ đợi, di chuyển trên xe ô tô hoặc trước giờ đi ngủ bố mẹ có thể đọc cho con một vài bài thơ bố mẹ đã thuộc, hoặc đọc từ một cuốn sách nào đó, vừa làm giàu ngôn ngữ cho các bạn, lại có những giây phút tương tác vui vẻ với con.\u003c/p\u003e\n\u003ch2\u003eCombo 6 cuốn thơ chủ đề Đạo đức - Kỹ năng sống cho bé\u003c/h2\u003e\n\u003cp\u003eNhân vật chính là Gia đình Bé Bỏng, 3 cuốn đầu có nội dung đơn giản xoay quanh những người thân thương là ba mẹ, ông bà, từ đó giúp bé xây dựng những cảm xúc yêu thương bền chặt với gia đình. 3 cuốn sau cùng gia đình Bé Bỏng đi Du lịch, đi chơi, đi trải nghiệm ở những vùng đất mới, qua đó lồng ghép các bài học nhỏ về cư xử văn minh, lịch sự, tôn trọng mọi người khi tham gia các phương tiện công cộng như máy bay, tàu hỏa, \u003c/p\u003e\n\u003cdiv class=\"o9v6fnle cxmmr5t8 oygrvhab hcukyx3x c1et5uql ii04i59q\"\u003e\n\u003cul\u003e\n\u003cli dir=\"auto\"\u003eCuốn \"\u003cstrong\u003eCon thương mẹ nhất!\u003c/strong\u003e\" Để em bé ngoan biết thương yêu, đồng cảm, tự lập, giúp đỡ ba việc nhà, chăm sóc mẹ khi mẹ ốm.\u003c/li\u003e\n\u003cli dir=\"auto\"\u003eCuốn \"\u003cstrong\u003eCon yêu bố vô cùng!\u003c/strong\u003e\" Gắn kết tình cảm, xây dựng niềm tự hào của em bé đối với ba qua những mẩu chuyện cực đáng yêu.\u003c/li\u003e\n\u003cli dir=\"auto\"\u003eCuốn \"\u003cstrong\u003eCon nhớ ông bà lắm!\u003c/strong\u003e\" Gắn kết yêu thương giữa em bé và ông bà qua hành trình khám phá miền quê đầy thú vị.\u003c/li\u003e\n\u003cli dir=\"auto\"\u003eCuốn \"\u003cstrong\u003eVèo vèo Hội An\u003c/strong\u003e\" Lên máy bay, bay vào Hội An - nơi có vô vàn món ăn ngon.\u003c/li\u003e\n\u003cli dir=\"auto\"\u003eCuốn \u003cstrong\u003e\"Xình xịch đến Huế\" \u003c/strong\u003eCùng ghé Huế chơi - nơi có rất nhiều danh lam, thắng cảnh đẹp tuyệt vời.\u003c/li\u003e\n\u003cli dir=\"auto\"\u003eCuốn \"\u003cstrong\u003eTu tu ra khơi!\u003c/strong\u003e\" Ra khơi tại Nha Trang để có thật nhiều trải nghiệm vui mà bé mê ơi là mê.\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/d3/0f/19/10fa21d482b434c761bf2a33fc60a09d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d3/0f/19/10fa21d482b434c761bf2a33fc60a09d.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d3/0f/19/10fa21d482b434c761bf2a33fc60a09d.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d3/0f/19/10fa21d482b434c761bf2a33fc60a09d.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d3/0f/19/10fa21d482b434c761bf2a33fc60a09d.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/1e/cf/25/fc0a0b2fdb10c7f978e6db7d39524301.jpg","is_galler