l,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":50000,"discount_rate":35,"rating_average":5,"review_count":9,"review_text":"(9)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/60/01/5d/55898daa002b7d21d3014eedd3dba090.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1511,"all_time_quantity_sold":59,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align:center;\"\u003e\u003cstrong\u003eNước tẩy trang Sắc Ngọc Khang 145ml\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cstrong\u003eMicellar Cleasing Water\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cstrong\u003eTẩy sạch sâu – Dưỡng mịn da\u003c/strong\u003e\u003c/p\u003e\n\u003col\u003e\u003cli\u003e\u003cstrong\u003e Thành phần chính\u003c/strong\u003e\u003c/li\u003e\n\u003c/ol\u003e\u003cp\u003e\u003cstrong\u003e- Chiết xuất Rễ cam thảo\u003c/strong\u003e:  thẩm thấu mạnh mẽ vào sâu trong da, giúp vô hiệu hoá các \u003ca href=\"https://www.bachhoaxanh.com/kinh-nghiem-hay/goc-tu-do-la-gi-va-chung-co-tac-hai-the-nao-den-lan-da-suc-khoe-cua-ban-1137668\"\u003egốc tự do\u003c/a\u003e, ngăn chặn quá trình sản sinh \u003ca href=\"https://www.bachhoaxanh.com/kinh-nghiem-hay/sac-to-melanin-la-gi-tim-hieu-hinh-thanh-tham-nam-do-melanin-gay-ra-1137600\"\u003esắc tố melanin\u003c/a\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e- Chiết xuất Hoa Hồng:\u003c/strong\u003e cung cấp độ ẩm cho da, làm mát dịu da đồng thời còn làm sạch bã nhờ trong các lỗ chân lông\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e- Chiết xuất hoa Anh Đào:\u003c/strong\u003e chống oxi hóa, giảm viêm da, thúc đẩy sản xuất Collagen và elastin, giúp cải thiện độ đàn hồi, săn chắc cho làn da, cải thiện tình trạng nám da, giúp da mịn màng, trắng sáng\u003c/p\u003e\n\u003col start=\"2\"\u003e\u003cli\u003e\u003cstrong\u003e Công dụng\u003c/strong\u003e\u003c/li\u003e\n\u003c/ol\u003e\u003cp\u003e- Nước tẩy trang giúp rửa trôi những bụi bẩn và lớp nhờn do tuyến dầu sâu bên trong chân lông gây ra. Nhờ đó bạn có thể hạn chế tình trạng bít tắc da, giúp hấp thu dưỡng chất dễ dàng hơn và tránh gây nên mụn.\u003c/p\u003e\n\u003cp\u003e- Kết cấu dạng nước và sử dụng rất tiện lợi vì bạn chỉ cần dùng bông tẩy trang thấm dung dịch và lau trực tiếp lên mặt là được\u003c/p\u003e\n\u003col start=\"3\"\u003e\u003cli\u003e\u003cstrong\u003e Cách dùng \u003c/strong\u003e\u003c/li\u003e\n\u003c/ol\u003e\u003cp\u003e- Dùng trước khi dùng sữa rửa mặt: Lấy bông tẩy trang thấm sản phẩm tẩy trang vùng mắt và môi trước\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e- Tẩy trang mắt:\u003c/strong\u003e giữ bông khoảng 5 – 10 giây để nước tẩy trang Sắc Ngọc Khang có thể cuốn trôi đi lớp make up trên măt, vuốt nhẹ nhàng theo chiều từ trên hốc mắt xuống\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e- Tẩy trang môi:\u003c/strong\u003e lau nhẹ nhàng, tránh chà xát làm tróc da môi\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e- Tẩy trang da mặt\u003c/strong\u003e: với vùng mặt bạn dùng bông bôi nhẹ theo chiều từ dưới lên trên, từ trong ra ngoài\u003c/p\u003e\n\u003cp\u003e- Đừng quên tẩy trang cho cả vùng cổ nhé\u003c/p\u003e\n\u003col start=\"4\"\u003e\u003cli\u003e\u003cstrong\u003e Ưu điểm\u003c/strong\u003e\u003c/li\u003e\n\u003c/ol\u003e\u003cp\u003e- Không cồn\u003c/p\u003e\n\u003cp\u003e- Không paraben\u003c/p\u003e\n\u003cp\u003e- Phù hợp với mọi loại da\u003c/p\u003e\n\u003cp\u003e- Công nghệ Micellar tẩy sạch được lớp\u003cstrong\u003e\u003ca href=\"https://hasaki.vn/danh-muc/trang-diem-c23.html\"\u003e makeup\u003c/a\u003e\u003c/strong\u003e nhẹ\u003c/p\u003e\n\u003cp\u003e-  Chiết xuất Rễ cam thảo có khả năng thẩm thấu cực kỳ tốt và phù hợp sử dụng cho các loại da dầu vì sẽ không làm bít tắc lỗ chân long, giúp da luôn thông thoáng, dế chịu\u003c/p\u003e\n\u003cp\u003e- Giá thành phù hợp\u003c/p\u003e\n\u003col start=\"5\"\u003e\u003cli\u003e\u003cstrong\u003e Hạn sử dụng\u003c/strong\u003e\u003c/li\u003e\n\u003c/ol\u003e\u003cp\u003e- 3 năm kể từ ngày sản xuất (Ngày sản xuất xem trên bao bì sản phẩm)\u003c/p\u003e\n\u003cp\u003e- Hạn mở nắp: 9 tháng\u003c/p\u003e\n\u003col start=\"6\"\u003e\u003cli\u003e\u003cstrong\u003e Bảo quản\u003c/strong\u003e\u003c/li\u003e\n\u003c/ol\u003e\u003cp\u003e- Tránh ánh nắng trực tiếp\u003c/p\u003e\n\u003cp\u003e- Để ở nơi thoáng mát, khô ráo\u003c/p\u003e\n\u003col start=\"7\"\u003e\u003cli\u003e\u003cstrong\u003e Quy cách đóng gói\u003c/strong\u003e\u003c/li\u003e\n\u003c/ol\u003e\u003cp\u003e- Nước tẩy trang Sắc Ngọc Khang chai 145 ml\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eLưu ý khi sử dụng:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Nước tẩy trang Sắc Ngọc Khang Chỉ dùng ngoài da\u003c/p\u003e\n\u003cp\u003e- Tránh tiếp xúc với mắt. Để xa tầm tay trẻ em\u003c/p\u003e\n\u003cp\u003e- Quy trình các bước làm sạch da: Nước tẩy trang → Sữa rửa mặt → Toner/Nước hoa hồng\u003c/p\u003e\n\u003cp\u003e- Ngưng sử dụng khi có dấu hiệu dị ứng\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/8a/ce/b0/e1994e362b2fb54fd156c94d65a0199c.jpg\" alt=\"nuoc tay trang 145ml sac ngoc khang\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/p