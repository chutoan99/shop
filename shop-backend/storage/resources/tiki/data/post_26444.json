t":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.7,"review_count":84,"review_text":"(84)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/b8/d3/d3/49ab2bfe9b9d44e22663654de9ddfa9e.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":968,"all_time_quantity_sold":229,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2\u003eMũ bảo hiểm GRO 3/4 đầu ST06 (T818) hai mẫu kính, thiết kế phong cách trẻ trung, nhiều màu, thời trang cho nam và nữ- Hàng chính hãng\u003c/h2\u003e\n\u003cp\u003eSản xuất trên dây chuyền công nghệ hiện đại, \u003cstrong\u003eMũ Bảo Hiểm Gro Chính Hãng\u003c/strong\u003e được làm chủ yếu từ nhựa ABS, với đặc tính chịu va đập và chịu mài mòn rất tốt, khu vực bảo vệ của mũ bao gồm phần đầu và phần thái dương người đội. Size: Dành cho vòng đầu 54-56cm\u003c/p\u003e\n\u003cp data-spm-anchor-id=\"a2o4n.pdp_revamp.product_\"\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/c5/f5/b6/3345a13fdd58bab23d322e0f994a4c0f.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e Mũ Bảo Hiểm Gro Chính Hãng \u003c/strong\u003eđược thiết kế một kính chống bụi rất tiện dụng. Kính được thiết kế là kính dâm có tác dụng chống chói và mỏi mắt khi đi ban ngày, cùng với đó là tính năng chống xước bề mặt kính.\u003c/p\u003e\n\u003cp data-spm-anchor-id=\"a2o4n.pdp_revamp.product_\"\u003eTrọng lượng: 950g ± 50g\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/80/0a/02/8a05958dfc46068b81f2cb6f0dfa4fc3.jpg\" alt=\"\" width=\"522\" height=\"522\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/19/10/c2/fd6049464b2d871ed6b52437c72fe822.jpg\" alt=\"\" width=\"521\" height=\"521\" /\u003e\u003c/p\u003e\n\u003cp\u003eMút xốp mũ rất dầy dặn ôm sát phần đầu của người đội, cùng với đó là tính năng kháng khuẩn của mút giúp cho việc đội mũ rất thông thoáng không bị ám mùi và thấm hút mồ hôi tốt.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/c4/27/0b/a1215b0bd17903f438039b50ffa82c86.jpg\" alt=\"\" width=\"559\" height=\"559\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/80/28/3c/b2f578bdfbd6b3b4e583bafe93319791.jpg\" alt=\"\" width=\"552\" height=\"552\" /\u003e\u003c/p\u003e\n\u003cp\u003eQuai mũ bền chắc phần khóa của quai được làm từ chất liệu nhựa nhập khẩu, rất cứng chắc và sử dụng thuận tiện.\u003c/p\u003e\n\u003cp\u003e Màu sắc vô cùng bắt mắt để các bạn có thể chọn cho mình một chiếc ưng ý.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/bf/3b/1d/ce876948969befe6b492b391834967e6.jpg\" alt=\"\" width=\"508\" height=\"508\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/f3/39/e7/8be90f787790c7e76d87052fdfa3c84f.jpg\" alt=\"\" width=\"502\" height=\"502\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/fb/5b/11/059a669ad63c8c19b7c2fae96c56ec40.jpg\" alt=\"\" width=\"551\" height=\"551\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/cc/78/62/e41fb0de8d6fc8f9779030a6d863ce33.jpg\" alt=\"\" width=\"556\" height=\"556\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/a9/17/2c/8634d1534cc27cf7569517f833f5936f.jpg\" alt=\"\" width=\"518\" height=\"518\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/b9/9f/f3/a11fa8520e68043f343fa8e2bc2753c0.jpg\" alt=\"\" width=\"516\" height=\"516\"