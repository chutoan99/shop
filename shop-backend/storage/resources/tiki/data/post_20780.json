uffet\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e- Dung tích 8L\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e- Nhập khẩu EAST\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eThiết kế khung inox, có mặt kính nhìn vào bên trong, loại chân thẳng \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/69/da/65/c9f9bd2f4596da5c741c08c7a1b166f7.JPG","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/69/da/65/c9f9bd2f4596da5c741c08c7a1b166f7.JPG","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/69/da/65/c9f9bd2f4596da5c741c08c7a1b166f7.JPG","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/69/da/65/c9f9bd2f4596da5c741c08c7a1b166f7.JPG","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/69/da/65/c9f9bd2f4596da5c741c08c7a1b166f7.JPG"},{"base_url":"https://salt.tikicdn.com/ts/product/eb/a6/6b/eb3d743d95ced72843b10ef43e816192.JPG","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/eb/a6/6b/eb3d743d95ced72843b10ef43e816192.JPG","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/eb/a6/6b/eb3d743d95ced72843b10ef43e816192.JPG","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/eb/a6/6b/eb3d743d95ced72843b10ef43e816192.JPG","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/eb/a6/6b/eb3d743d95ced72843b10ef43e816192.JPG"},{"base_url":"https://salt.tikicdn.com/ts/product/30/ae/99/4e7e47db3019810c4c452b17656b8d5a.JPG","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/30/ae/99/4e7