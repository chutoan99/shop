/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":19900,"discount_rate":10,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/1c/a0/d3/d22afc5bc83a340a70bfbf1c05d51c72.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":317,"all_time_quantity_sold":22,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align:center;\"\u003e\u003cspan style=\"color:#003300;\"\u003e- Bạn là một Gamer, muốn tìm một cuốn sách cho mình để đọc? \u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cspan style=\"color:#003300;\"\u003e- Bạn là nhà làm game, muốn hiểu tâm lý học của người chơi hơn nữa, cải thiện đáp ứng được nhu cầu trải nghiệm của người chơi? \u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cspan style=\"color:#003300;\"\u003e- Bạn là phụ huynh, muốn hiểu rằng tại sao trò chơi lại thu hút con em mình và chọn game hướng cho con mình chơi một cách bổ ích sau mỗi giờ học? \u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cspan style=\"color:#003300;\"\u003e- Bất kỳ ai cũng đã từng chơi hay biết tới 1 trò chơi điện tử bất kỳ nào đó, vậy bạn có bao giờ tự hỏi rằng tại sao GAME lại khiến chúng ta bị thu hút như vậy chưa?\u003c/span\u003e\u003c/p\u003e\n\u003ch3 style=\"text-align:center;\"\u003e\u003cspan style=\"color:#ff6600;\"\u003e\u003cspan style=\"color:#800080;\"\u003eCUỐN SÁCH NÀY DÀNH CHO MỌI NGƯỜI\u003c/span\u003e \u003c/span\u003e\u003c/h3\u003e\n\u003ch3 style=\"text-align:center;\"\u003e\u003cspan style=\"color:#ff6600;\"\u003e\u003c/span\u003e\u003c/h3\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cbr /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/4e/c7/e3/1cf477d587ce2d78f9235eea94187a14.jpg\" alt=\"\" width=\"750\" height=\"498\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003eMột trong những yếu tố lớn quyết định đến sự thành công hay thất bại của một tựa game chính là tâm lý của người chơi game. Theo dòng chảy của thời gian, nhu cầu và tâm lý của các game thủ cũng có những thay đổi, đòi hỏi các nhà sản xuất phải liên tục sáng tạo để sản phẩm mới của mình không bị lỗi thời. Cuốn sách đã đưa ra kiến thức căn bản để những nhà sản xuất game có thể vận dụng sáng tạo trong thiết kế game dựa trên những thử nghiệm của các nhà sản xuất game chuyên nghiệp trên thế giới (như Zynga Inc., Sidney K. “Sid” Meier…).\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e“Thế hệ 8X của tôi lớn lên với điện tử thùng, máy game 4 nút, rồi đến những tháng ngày rủ nhau ra quán chơi Play Station, Xbox, Game Online… Trong lòng tôi, đó là một thời tuổi trẻ tươi đẹp. Vì vậy tôi viết cuốn sách này dành cho những người có cùng tình yêu đối với game như mình, và để dành tặng cho tuổi trẻ của tôi.”\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003e----------\u003c/p\u003e\n\u003cp\u003eTên sách: Đừng trách tôi mê game - Là do người làm game quá hiểu tâm lý học!\u003c/p\u003e\n\u003cp\u003eThể loại: Hiểu ngành - Giỏi nghề\u003c/p\u003e\n\u003cp\u003eTác giả: Puella\u003c/p\u003e\n\u003cp\u003eKhổ sách: 16x24 cm\u003c/p\u003e\n\u003cp\u003eSố trang: 292\u003c/p\u003e\n\u003cp\u003eHình thức: Bìa mềm\u003c/p\u003e\n\u003cp\u003eĐơn vị liên kết: Tri Thức Trẻ Books \u0026amp; Nxb. Dân trí\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/1c/a0/d3/d22afc5bc83a340a70bfbf1c05d51c72.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/1c/a0/d3/d22afc5bc83a340a70bfbf1c05d51c72.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/1c/a0/d3/d22afc5bc83a340a70bfbf1c05d51c72.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1c/a0/d3/d22afc5bc83a340a70bfbf1c05d51c72.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1c/a0/d3/d22afc5bc83a340a70bfbf1c05d51c72.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/b3/a0/a8/4a9fc8969ea6f59b80d10fb5844809ec.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b3/a0/a8/4a9fc8969ea6f59b80d10fb5844809ec.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b3/a0/a8/4a9fc8969ea6f59b80d10fb5844809ec.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b3/a0/a8/4a9fc8969ea6f59b80d10fb5844809ec.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b3/a0/a8/4a9fc8969ea6f59b80d10fb5844809ec.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/83/24/2e/098a955a903144f8435042c820cc6ca9.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/83/24/2e/098a955a903144f8435042c820cc6ca9.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/83/24/2e/098a955a903144f8435042c820cc6ca9.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/83/24/2e/098a955a903144f8435042c820cc6ca9.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/83/24/2e/098a955a903144f8435042c820cc6ca9.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/4e/c7/e3/f1adca1