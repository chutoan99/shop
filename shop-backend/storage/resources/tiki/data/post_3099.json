icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.8,"review_count":221,"review_text":"(221)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/fb/00/fd/74dbeceae99167b6065520090d7caab2.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1357,"all_time_quantity_sold":1370,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003ePhin pha cà phê nhôm Trung Nguyên( Không Hoa Văn)\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003ePhin cà phê Trung Nguyên được sản xuất dựa trên tiêu chuẩn kỹ thuật của các chuyên gia cà phê để tạo ra những ly cà phê tuyệt hảo.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/59/f9/67/22f94d023f6344ddac32f1b8c7b5dcc4.jpg\" alt=\"\" width=\"750\" height=\"638\" /\u003e\u003c/p\u003e\n\u003cp\u003ePhin cà phê là một vật dụng không thể thiếu đối với những người yêu – đam mê cà phê. Nhưng bạn có biết đâu mới là một chiếc phin tốt nhất để cho ra những ly cà phê tuyệt hảo nhất?\u003c/p\u003e\n\u003cp\u003eSau rất nhiều thử nghiệm, các chuyên gia Trung Nguyên đã đưa ra tiêu chuẩn cơ bản như sau:\u003c/p\u003e\n\u003cp\u003e- Thể tích đạt tiêu chuẩn của phin khoảng 170ml.\u003c/p\u003e\n\u003cp\u003e- Chất liệu nhôm thích hợp nhất cho một chiếc phin lọc cà phê. Vì nó có có thể giữ nhiệt tốt hơn các chất liệu khác và không gây hại tới sức khỏe khi sử dụng.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/60/8f/b5/cf43eaa782c2d4624df3569daa8f782f.jpg\" alt=\"\" width=\"750\" height=\"624\" /\u003e\u003c/p\u003e\n\u003cp\u003e- Số lượng lỗ trên thân phin, đĩa phin phải bằng nhau và phân bổ đồng đều để cà phê có thể lọc tốt nhất. Kích thước lỗ phải tương thích với kích thước hạt của hạt cà phê xay, để có thể cho khoảng 55-60 giọt cà phê/ 1 phút.\u003c/p\u003e\n\u003cp\u003e- Lỗ trên lược gài (nắp gài) cũng phải được phân bổ đồng đều và có mật độ dày hơn mật độ lỗ trên thân và đĩa phin để nước thấm xuống cà phê tốt hơn.\u003c/p\u003e\n\u003cp\u003e- Tiện lợi cho người sử dụng: Có vạch mức bên trong thân phin để định lượng cà phê theo tiêu chuẩn của Trung Nguyên.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/fb/00/fd/74dbeceae99167b6065520090d7caab2.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/fb/00/fd/74dbeceae99167b6065520090d7caab2.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/fb/00/fd/74dbeceae99167b6065520090d7caab2.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fb/00/fd/74dbeceae99167b6065520090d7caab2.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fb/00/fd/74dbeceae99167b6065520090d7caab2.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/7b/7e/8b/fe42e28ad9a468575514a38640a2a5a6.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/7b/7e/8b/fe42e28ad9a468575514a38640a2a5a6.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/7b/7e/8b/fe42e28ad9a468575514a38640a2a5a6.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x28