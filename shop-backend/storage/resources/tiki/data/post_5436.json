ước rửa bát Kao vào bát và pha với nước theo tỷ lệ 0.75ml nước rửa bát Kao với 1 lít nước\u003c/p\u003e\n\u003cp\u003eBên cạnh việc sử dụng để rửa bát, nước rửa chén Kao còn dùng để rửa rau, trái cây, bát đĩa, đồ dùng nhà bếp\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/fc/20/7e/4f4bef1c3fc1c8b319b3eb2343f1ae7d.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/fc/20/7e/4f4bef1c3fc1c8b319b3eb2343f1ae7d.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/fc/20/7e/4f4bef1c3fc1c8b319b3eb2343f1ae7d.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fc/20/7e/4f4bef1c3fc1c8b319b3eb2343f1ae7d.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fc/20/7e/4f4bef1c3fc1c8b319b3eb2343f1ae7d.png"},{"base_url":"https://salt.tikicdn.com/ts/product/7e/fe/a8/20293c70c14c2344abc613ca678a17ac.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/7e/fe/a8/20293c70c14c2344abc613ca678a17ac.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/7e/fe/a8/20293c70c14c2344abc613ca678a17ac.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7e/fe/a8/20293c70c14c2344abc613ca678a17ac.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7e/fe/a8/20293c70c14c2344abc613ca678a17ac.jpg"}],"warranty_policy":null,"brand":{"id":216475,"name":"KAO","slug":"kao"},"current_seller":{"id":84406,"sku":"7747645222673","name":"QUÝ KHANG MART","link":"https://tiki.vn/cua-hang/quy-khang-mart","logo":"https://vcdn.tikicdn.com/ts/seller/c1/a6/86/ac5f99f91a9