":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":281000,"discount_rate":18,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/f9/da/08/b5a3388e46f6569d0bee97719788348d.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2668,"all_time_quantity_sold":9,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch5\u003eThời gian lên men nhanh\u003c/h5\u003e\n\u003cp\u003e\u003cstrong\u003eMáy làm tỏi đen Tiross TS904 90W 5L\u003c/strong\u003e là một sáng tạo tiên tiến giúp bạn có được sức khỏe cân bằng cũng như có thể chống lại được một số nguy cơ bệnh tật. Máy có thiết kế đơn giản nhưng có cơ chế lên men tự động trong vòng 12 ngày với công suất 90W và tỷ lệ thành công lên đến 99% giúp bạn có được thực phẩm bổ ích cho sức khỏe gia đình lại tiết kiệm điện và thời gian.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/7c/70/81/658302b3982791a64ca4da0129230561.jpg\" alt=\"Máy Làm Tỏi Đen TIROSS TS904 - Hàng chính hãng\" width=\"690\" height=\"1244\" /\u003e\u003c/p\u003e\n\u003ch5\u003eThiết kế đơn giản, hiệu quả\u003c/h5\u003e\n\u003cp\u003eMáy làm tỏi đen Tiross TS904 90W 5L được thiết kế với những ưu điểm vượt trội bởi với cơ chế toàn bộ quá trình lên men sẽ diễn ra với một nút ấn đơn giản, giúp bạn thuận tiện và dễ dàng hơn khi làm tỏi đen. \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/c5/6a/87/43a20a9cb5e4b8895ae3145f833634fe.jpg\" alt=\"Máy Làm Tỏi Đen TIROSS TS904 - Hàng chính hãng\" width=\"690\" height=\"1244\" /\u003e\u003c/p\u003e\n\u003ch5\u003eCông nghệ phát nhiệt ba chiều\u003c/h5\u003e\n\u003cp\u003eCông nghệ phát nhiệt ba chiều giúp quá trình lên men nhanh và đều hơn. Lòng nồi được thiết kế 3 lớp chống dính an toàn. Đặc biệt, khi mất điện máy sẽ tự động lưu chương trình và hoạt động trở lại sau khi có điện. Phát nhiệt được điều khiển bởi bộ vi mạch thông minh, có thể kiểm soát nhiệt độ tự động và an toàn.\u003c/p\u003e\n\u003ch5\u003eSử dụng dễ dàng\u003c/h5\u003e\n\u003cp\u003eChỉ cần nhấn nút toàn bộ quá trình lên men sẽ diễn ra tự động, máy sẽ làm việc cho đến khi tỏi đen đều màu, quy trình hoạt động trong vòng 12 ngày liên tục, hiệu suất tăng cao cho ra những thành phẩm như bạn mong đợi. Tiross TS904 còn được tích hợp bộ nhớ lưu trữ chương trình nấu (nhiệt độ, khoảng thời gian) khi bị mất điện và hoạt động trở lại khi có điện \u003c/p\u003e\n\u003ch5\u003eCông dụng của tỏi đen\u003c/h5\u003e\n\u003cul\u003e\n\u003cli\u003eTỏi đen được biết đến như một loại thực phẩm chức năng có rất nhiều công dụng trong việc phòng và chữa các căn bệnh nguy hiểm.\u003c/li\u003e\n\u003cli\u003eĐiều hòa đường huyết, góp phần điều trị tiểu đường.\u003c/li\u003e\n\u003cli\u003eGiảm Cholesterol, giảm mỡ máu.\u003c/li\u003e\n\u003cli\u003eBảo vệ tim mạch, giảm tiến trình xơ cứng động mạch.\u003c/li\u003e\n\u003cli\u003eBảo vệ tế bào gan, dùng trong trường hợp: viêm gan, xơ gan, gan nhiễm mỡ.\u003c/li\u003e\n\u003cli\u003ePhòng ngừa tai biến mạch máu não.\u003c/li\u003e\n\u003cli\u003eTăng cường khả năng miễn dịch, tăng sức đề kháng.\u003c/li\u003e\n\u003cli\u003eHoạt tính quét gốc tự do, hỗ trợ điều trị và ngăn ngừa ung thư.\u003c/li\u003e\n\u003cli\u003eChống oxi hóa máu, phòng ngừa ung thư máu.\u003c/li\u003e\n\u003cli\u003eNâng cao thể trạng, bồi bổ cơ thể, đặc biệt ở người cao tuổi.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/eb/34/2f/35094657fd5460095f52bd2588c81e2f.jpg\" title=\"Máy Làm Tỏi Đen TIROSS TS904 - Hàng chính hãng\" src=\"https://salt.tikicdn.com/ts/tmp/eb/34/2f/35094657fd5460095f52bd2588c81e2f.jpg\" alt=\"Máy Làm Tỏi Đen TIROSS TS904 - Hàng chính hãng\" width=\"undefined\" height=\"undefined\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/22/6f/eb/4278e7aee14321d3c197eac59777fc3a.jpg\" title=\"Máy Làm Tỏi Đen TIROSS TS904 - Hàng chính hãng\" src=\"https://salt.tikicdn.com/ts/tmp/22/6f/eb/4278e7aee14321d3c197eac59777fc3a.jpg\" alt=\"Máy Làm Tỏi Đen TIROSS TS904 - Hàng chính hãng\" width=\"undefined\" height=\"undefined\" /\u003e\u003c/p\u003e\n\u003ch5\u003eHướng dẫn sử dụng máy làm tỏi đen Tiross:\u003c/h5\u003e\n\u003cul\u003e\n\u003cli\u003eBước 1: Chọn những loại tỏi có chất lượng cao, không nảy mầm, mốc hay ngấm nước.\u003c/li\u003e\n\u003cli\u003eBước 2: Vệ sinh sạch nồi và giá để tỏi.\u003c/li\u003e\n\u003cli\u003eBước 3: Xếp tỏi vào đầy giá để tỏi (như hình), cho giá vào nồi và đậy nắp lại.\u003c/li\u003e\n\u003cli\u003eBước 4: Ấn và giữ nút On/Off trong vòng 2 giây.\u003c/li\u003e\n\u003cli\u003eBước 5: Màn hình hiển thị số 288 và bắt đầu đếm ngược quá trình lên men trong vòng 12 ngày.\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/f9/da/08/b5a3388e46f6569d0bee97719788348d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f9/da/08/b5a3388e46f6569d0bee97719788348d.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f9/da/08/b5a3388e46f6569d0bee97719788348d.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f9/da/08/b5a3388e46f6569d0bee97719788348d.jpg","thumbnail_url":"