":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":5,"review_text":"(5)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/86/a8/f8/43e857a5d70fa45255b651ce52943b49.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":916,"all_time_quantity_sold":64,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2\u003eVì sao bạn cần bổ sung chất điện giải từ viên uống GU Roctane Electrolyte?\u003c/h2\u003e\n\u003cp\u003eKhi bạn tham gia các hoạt động thể lực với cường độ cao và kéo dài, đặc biệt trong điều kiện môi trường xung quanh nóng và ẩm, cơ thể bạn sẽ dễ bị mất nước. Khi bạn bị mất nước, bạn sẽ cảm thấy nhanh mệt, bạn có thể bị chuột rút hoặc đau đầu, dẫn đến hiệu suất luyện tập của bạn sẽ giảm.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/5f/39/91/6351182eec00fb7fded065847907281e.jpg\" width=\"750\" height=\"421\" data-cke-saved-src=\"//\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003eCơ thể rất cần chất điện giải, đặc biệt nếu bạn là người thường xuyên luyện tập thể thao.\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003eQuá trình Hydrate hóa, nghĩa là hấp thu nước và hòa tan, rất cần đến các chất điện giải. Khi cơ thể có nồng độ các chất điện giải ở mức hợp lý, quá trình giữ nước và sử dụng nước nội môi sẽ hiệu quả hơn. Đó là lý do vì sao cơ thể bạn rất cần đến chất điện giải, đặc biệt nếu bạn là người thường xuyên luyện tập thể thao.\u003c/p\u003e\n\u003ch3\u003eCó gì trong mỗi viên GU Roctane Electrolyte?\u003c/h3\u003e\n\u003cp\u003e\u003cem\u003e\u003cstrong\u003eViên uống chất điện giải GU Roctane Electrolyte\u003c/strong\u003e\u003c/em\u003e được sản xuất dưới dạng viên nang dễ sử dụng. Mỗi hộp sản phẩm chứa 50 viên với đầy đủ các loại khoáng chất giúp bổ sung chất điện giải dồi dào. Lượng chất điện giải này sẽ giúp bù đắp lượng vật chất mất đi trong quá trình bạn đổ mồ hôi lúc luyện tập, giúp bạn duy trì cảm giác khỏe khoắn và sảng khoái.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/2d/00/21/cc6415aa1a013d56fd8c898682db7502.jpg\" width=\"750\" height=\"421\" data-cke-saved-src=\"//\" /\u003e\u003c/p\u003e\n\u003cp\u003eGU Roctane được sản xuất dưới dạng viên nang dễ sử dụng.\u003c/p\u003e\n\u003cp\u003eCác chất điện giải có trong thành phần của GU Roctane Electrolyte bao gồm Natri, Magiê và các muối Clorua giúp duy trì quá trình Hydrate hóa bằng cách cân bằng lượng nước trong dịch nội bào và môi trường ngoại bào cũng như huyết tương.\u003c/p\u003e\n\u003ch3\u003eNguồn Vitamin tối quan trọng\u003c/h3\u003e\n\u003cp\u003eĐầu tiên, không thể thiếu và rất quan trọng, đó chính là . Ngoài tác dụng cơ bản giúp tăng cường hoạt động của hệ miễn dịch, Vitamin D còn hỗ trợ cơ thể hấp thu Canxi, tăng cường sức khỏe và hoạt động của xương khớp, rất cần cho người vận động thường xuyên.\u003c/p\u003e\n\u003cp\u003eVitamin B6 giúp cải thiện quá trình chuyển hóa năng lượng cung cấp cho các hoạt động thể lực. Đặc biệt, khi bạn rơi vào trạng thái kiệt sức hoặc quá sức, rất có thể bạn sẽ cảm thấy cồn cào và buồn nôn. Triệu chứng này rất dễ thấy ở các vận động viên hoặc những người thường xuyên luyện tập môn đạp xe hoặc chạy bộ. Vitamin B6 có trong viên uống điện giải GU Roctane Electrolyte sẽ giải quyết triệt để vấn đề này.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/1a/5a/23/7f124fd00b0aa983b4f215d1b7176edc.jpg\" width=\"750\" height=\"421\" data-cke-saved-src=\"//\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003eNguồn Vitamin tối quan trọng.\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003eMột đặc điểm khác biệt đó chính là trong thành phần của GU Roctane Electrolyte không chứa Kali. GU Energy đã mở rộng nghiên cứu và đưa ra kết luận rằng thành phần Ion Kali không gây hại nhưng cũng không đem lại kết quả nào đáng kể cho việc luyện tập thể thao và vận động cơ bắp. Chính vì thế, nhà sản xuất đã loại bỏ thành phần này trong sản phẩm của họ.\u003c/p\u003e\n\u003cp\u003eGU Energy cũng cam kết trong thành phần \u003cstrong\u003eviên uống bù nước, chất điện giải Roctane Electrolyte\u003c/strong\u003e không chứa Gluten.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/86/a8/f8/43e857a5d70fa45255b651ce52943b49.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/86/a8/f8/43e857a5d70fa45255b651ce52943b49.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/86/a8/f8/43e857a5d70fa45255b651ce52943b49.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/86/a8/f8/43e857a5d70fa45255b651ce52943b49.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/86/a8/f8/43e857a5d70fa45255b651ce52943b49.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/06/9f/50/f578ab6755202c04ad2888b08e40010d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/06/9f/50/f578ab6755202c04ad2888b08e40010d.jpg","medium_u