erage":5,"review_count":9,"review_text":"(9)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/0b/34/53/8b8e12b8a71039ff5517bba869f7b773.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":727,"all_time_quantity_sold":97,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<html>\n <head></head>\n <body>\n  <p style=\"text-align: justify;\">Như cơn gió thoảng - Nghĩ về những qui luật cuộc sống được giáo sư Nguyễn Văn Tuấn viết trong thời gian phong tỏa từ đầu tháng 7 đến giữa tháng 10 (năm 2021). Dưới góc nhìn của một nhà khoa học mang tinh thần Phật giáo, những vấn đề vốn chủ quan và cảm tính đều được tác giả nhìn dưới góc độ khoa học với lối viết dễ hiểu, dễ cảm và đáng tin cậy. Đồng thời những bài viết ấy cũng sâu sắc và tự nhiên với cái nhìn thế sự như gió thoảng mây trôi bỗng chốc hóa vô thường. Bàng bạc trong cả tác phẩm là một thái độ bình thản đối diện, trút bỏ mọi ảo vọng ở đời để giữ vững ý chí và không quên tâm nguyện thuở ban đầu. </p> \n  <p style=\"text-align: justify;\">Tác phẩm gồm bốn phần: ở đời, thói đời, thiên kiến và qui luật sống. Trong phần một, tác giả bàn về những điều làm cho chúng ta hạnh phúc và khiến ta bị “mắc kẹt” cùng những bài học hay ở đời. Phần hai cuốn sách nói đến tật và thói mang tính tiêu cực của con người, cùng nhận xét của người ngoại quốc và tiền nhân về người Việt. Phần ba là những hiện tượng tâm lí chúng ta hay thấy trong cuộc sống như thiên kiến tiêu cực, thiên kiến một chiều, thiên kiến chứng thực,  Phần sau cùng tác giả bàn về qui luật phổ quát của thành công và sự khác biệt giữa sếp và lãnh đạo. </p>\n </body>\n</html><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/0b/34/53/8b8e12b8a71039ff5517bba869f7b773.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0b/34/53/8b8e12b8a71039ff5517bba869f7b773.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/0b/34/53/8b8e12b8a71039ff5517bba869f7b773.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0b/34/53/8b8e12b8a71039ff5517bba869f7b773.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0b/34/53/8b8e12b8a71039ff5517bba869f7b773.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/f7/00/25/42bbeaa4a21af73bce19246ca1d1eb04.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f7/00/25/42bbeaa4a21af73bce19246ca1d1eb04.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f7/00/25/42bbeaa4a21af73bce19246ca1d1eb04.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f7/00/25/42bbeaa4a21af73bce19246ca1d1eb04.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f7/00/25/42bbeaa4a21af73bce19246ca1d1eb04.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/ba/c3/b6/29e65206e189fe9f8bfe703b36a452a1.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ba/c3/b6/29e65206e189fe9f8bfe703b36a452a1.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ba/c3/b6/29e65206e189fe9f8bfe703b36a452a1.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ba/c3/b6/29e65206e189fe9f8bfe703b36a452a1.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ba/c3/b6/29e65206e189fe9f8bfe703b36a452a1.jpg"},{"base_url":"https://salt.tikicdn.