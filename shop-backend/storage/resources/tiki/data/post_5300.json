d_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":820000,"discount_rate":19,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/b3/23/29/549a077ebe94c3b94dabd88fa814e2dd.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":0,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch5\u003eThiết kế nhỏ gọn, hiện đại\u003c/h5\u003e\n\u003cp\u003e\u003cstrong\u003eNồi cơm điện tử Tiger JBV-S18W\u003c/strong\u003e có kiểu dáng nhỏ gọn, hiện đại với màu sắc trang nhã, mang đến sự tiện nghi cho không gian bếp. Nồi được thiết kế với dung tích 1.8 lít tương đương 1.5 kg gạo là sự lựa chọn phù hợp cho gia đình có từ 4 - 6 người. Sản phẩm thiết kế quai xách tiện lợi, chất liệu bền bỉ giúp việc di chuyển dễ dàng hơn.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/69/d8/e4/458e590ebe97fb292ad3f13fccd4ba6d.jpg\" alt=\"Nồi Cơm Điện Tử Tiger JBV-S18W - 1.8L\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003ch5\u003eLòng nồi tráng men chống dính\u003c/h5\u003e\n\u003cp\u003eNồi cơm điện tử Tiger JBV-S18W được tráng men chống dính bằng tia hồng ngoại, giúp cơm nấu được ngon hơn, hạn chế sự lãng phí do bám dính, đặc biệt dễ dàng vệ sinh sau khi sử dụng. Ngoài ra, công suất mạnh lên đến 790W và mâm nhiệt rộng giúp cơm chín nhanh, đều, đảm bảo bữa ăn đầy ấm cúng cho gia đình bạn.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/af/c1/a0/d9e712a69dee4a794b85ef59cf70c006.jpg\" alt=\"Nồi Cơm Điện Tử Tiger JBV-S18W - 1.8L\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003ch5\u003eCông nghệ Fuzzy Logic thông minh\u003c/h5\u003e\n\u003cp\u003eCông nghệ Fuzzy Logic cảm ứng nhiệt thông minh giúp điều chỉnh nhiệt độ và thời gian nấu thích hợp, nên chất lượng món ăn luôn được đảm bảo.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/8c/70/52/2e3ae43f7d416f6294bc4c456b7744bc.jpg\" alt=\"Nồi Cơm Điện Tử Tiger JBV-S18W - 1.8L\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003ch5\u003eTính năng Tacook\u003c/h5\u003e\n\u003cp\u003eTính năng Tacook là sự kết hợp hoàn hảo 2 trong 1 khi người nội trợ vừa có thể nấu cơm, vừa có thể hâm nóng lại thức ăn hoặc hấp bánh bao, hấp cách thủy, nấu xôi,… cùng một lúc giúp tiết kiệm thời gian hơn. \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/0b/22/62/0fdc73689a5f073efe1088ffb3de4207.jpg\" alt=\"Nồi Cơm Điện Tử Tiger JBV-S18W - 1.8L\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003ch5\u003eĐa chức năng nấu\u003c/h5\u003e\n\u003cp\u003eTiger JBVS18W ứng dụng những công nghệ thông minh tiên tiến của Nhật Bản cho hoạt động chính xác và đa năng. Ngoài nấu cơm, nồi cơm còn có nhiều chế độ như hầm cháo, sẽ giúp cơm luôn ấm nóng, thơm ngon.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/50/8d/d4/78f3edfe75c43804beeb100d97663609.jpg\" alt=\"Nồi Cơm Điện Tử Tiger JBV-S18W - 1.8L\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003ch5\u003eĐiều khiển thông minh\u003c/h5\u003e\n\u003cp\u003eNồi cơm điện tử Tiger JBVS18W sử dụng cực kỳ đơn giản với bảng điều khiển điện tử chìm, hiển thị đầy đủ chức năng, bạn có thể tùy chọn chức năng nấu theo nhu cầu sử dụng. Ngoài ra chức năng hẹn giờ nấu giúp người nội trợ chủ động được thời gian sắp xếp công việc gia đình một cách hợp lý nhất.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/27/3c/a7/0dc1625012167291dbbf1656ae6989bb.jpg\" alt=\"Nồi Cơm Điện Tử Tiger JBV-S18W - 1.8L\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/b3/23/29/549a077ebe94c3b94dabd88fa814e2dd.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b3/23/29/549a077ebe94c3b94dabd88fa814e2dd.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b3/23/29/549a077ebe94c3b94dabd88fa814e2dd.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b3/23/29/549a077ebe94c3b94dabd88fa814e2dd.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b3/23/29/549a077ebe94c3b94dabd88fa814e2dd.jpg"},{"base_url":"https://salt.tikicdn.com/media/catalog/product/j/b/jbv-s18w_2.u2769.d20161101.t152036.445632.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/j/b/jbv-s18w_2.u2769.d20161101.t152036.445632.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/j/b/jbv-s18w_2.u2769.d20161101.t152036.445632.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/j/b/jbv-s18w_2.u2769.d20161101.t152036.445632.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/j/b/jbv-s18w_2.u2769.d20161101.t152036.445632.jpg"},{"base_url":"https://salt.tikicdn.