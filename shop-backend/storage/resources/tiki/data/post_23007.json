":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.8,"review_count":4,"review_text":"(4)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/69/01/a8/6144edf5d51d43a1068708738861db91.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":781,"all_time_quantity_sold":62,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cdiv class=\"content\"\u003e\n\u003cdiv class=\"ToggleContent__Wrapper-sc-1dbmfaw-1 cqXrJr\"\u003e\n\u003cdiv class=\"ToggleContent__View-sc-1dbmfaw-0 wyACs\"\u003e\n\u003cdiv\u003e\n\u003cp\u003eGOR là thương hiệu ốp lưng, kính cường lực mới nổi gần đây, tuy nhiên các sản phẩm của GOR rất đáng được khích lệ vì có chất lượng cao và đáp ứng cho thị trường sản phẩm cho các dòng máy mới nhanh chóng. \u003c/p\u003e\n\u003cp\u003eVới thiết kế đơn giản và tinh tế , chất liệu cao cấp, mỏng nhẹ và vừa khít, ôm chặt lấy máy, ốp lưng GOR là sản phẩm hoàn thiện rất tốt. Chiếc điện thoại với ốp lưng bảo vệ nhưng vẫn mỏng nhẹ hợp thời trang. Điện thoại bạn được bảo vệ mỗi ngày nhằm giảm thiểu trầy xước hay bể nứt ngoài mong muốn.\u003c/p\u003e\n\u003cp\u003eỐp lưng sử dụng chất liệu dẻo ( TPU) cao cấp giúp cầm tay chắn chắn, không trơn tuột, bảo vệ tốt với độ bền cao. Chất liệu nhựa tốt, không độc hại, không mùi và được sơn phủ lớp bảo vệ cao cấp, bề mặt láng mịn và khó trầy xước trong quá trình sử dụng.\u003c/p\u003e\n\u003cp\u003eỐp lưng TPU dẻo trong suốt GOR với thiết kể đơn giản nhưng không kém phần tinh tế, giữ lại vẻ đẹp gốc, màu tự nhiên của điện thoại.\u003c/p\u003e\n\u003cp\u003eỐp lưng được đúc với khuôn đúc có độ hoàn thiện cao, tạo ra sản phẩm chính xác, vừa vặn, các khe và các vị trí ở cổng kết nối, tai nghe, nút åm lượng, chính xác. Thiết kế vô cùng mỏng nhẹ như đang dùng chính chiếc điện thoại của bạn với kiểu dáng sang trọng, tinh tế.\u003c/p\u003e\n\u003ch3\u003eThông số kỹ thuật\u003c/h3\u003e\n\u003cp\u003e- Nhãn hiệu: GOR\u003c/p\u003e\n\u003cp\u003e- Chất liệu : Chất liệu nhựa dẻo mỏng nhẹ, chịu tác động tốt\u003c/p\u003e\n\u003cp\u003e- Chức năng : Ốp lưng vừa vặn, giữ chặt form máy \u003c/p\u003e\n\u003cp\u003e- Vị trí camera có phần Silicone bảo vệ\u003c/p\u003e\n\u003cp\u003e- Dùng cho dòng iPhone 11/12/13 Series\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003c/p\u003e\u003csource type=\"image/webp\"\u003e\u003c/source\u003e\u003cimg class=\"WebpImg__StyledImg-sc-h3ozu8-0 fWjUGo\" src=\"https://salt.tikicdn.com/ts/product/3d/17/c6/d5b1736e18c8f7e422042c70bf6d9aa0.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003cp\u003e\u003c/p\u003e\u003csource type=\"image/webp\"\u003e\u003c/source\u003e\u003cimg class=\"WebpImg__StyledImg-sc-h3ozu8-0 fWjUGo\" src=\"https://salt.tikicdn.com/ts/product/96/6d/71/3037b47ffbefe212e610ccce50d47983.jpg\" alt=\"\" width=\"750\" height=\"990\" /\u003e\u003cp\u003e\u003c/p\u003e\u003csource type=\"image/webp\"\u003e\u003c/source\u003e\u003cimg class=\"WebpImg__StyledImg-sc-h3ozu8-0 fWjUGo\" src=\"https://salt.tikicdn.com/ts/product/5a/83/ee/4afffca5e932df1b958862299d20636a.jpg\" alt=\"\" width=\"750\" height=\"857\" /\u003e\u003cp\u003e\u003c/p\u003e\u003csource type=\"image/webp\"\u003e\u003c/source\u003e\u003cimg class=\"WebpImg__StyledImg-sc-h3ozu8-0 fWjUGo\" src=\"https://salt.tikicdn.com/ts/product/11/b0/c9/73bd468afaffadd073ba6a0737efb828.jpg\" alt=\"\" width=\"750\" height=\"916\" /\u003e\u003cp\u003e\u003