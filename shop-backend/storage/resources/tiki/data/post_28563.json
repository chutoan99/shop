r":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":99000,"discount_rate":50,"rating_average":4.5,"review_count":310,"review_text":"(310)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/61/e5/30/342e31ec793af792f843b31267476994.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":867,"all_time_quantity_sold":1529,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2\u003eMÔ TẢ SẢN PHẨM\u003c/h2\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/af/64/ee/cca68d6dc3873421230e99e8e8252cf0.jpg\" alt=\"\" width=\"750\" height=\"750\"\u003e\u003c/p\u003e\n\u003cp\u003e- Đèn pin siêu sáng Ultrafire XML T6 là sự kết hợp tuyệt vời giữa công suất chiếu sáng cao, trở thành một công cụ đáng tin cậy không thể thiếu trong các tình huống khẩn cấp, tìm kiếm, tuần tra, câu cá đêm, cắm trại… đi phượt hay cúp điện.\u003c/p\u003e\n\u003cp\u003e- Đèn pin siêu sáng XML T6 là loại đèn pin đầu tiên sử dụng công nghệ chip LED ánh sáng trắng trung lập CREE XM-L2 (T6) và cho ánh cao hơn 25% công nghê chip LED cũ\u003c/p\u003e\n\u003cp\u003e- Thời gian sử dụng 100.000 GIỜ Sử dụng chip led XML-T6 được nhập khẩu từ Hoa Kỳ, cho độ sáng cao 1000 lumens (đơn vị đo ánh sáng)\u003c/p\u003e\n\u003cp\u003e-  Ống kính do Hawkeye sản xuất với hiệu suất truyền ánh sáng từ chip LED qua thấu kính cũng như cường độ chiếu sáng được tối ưu, ron được làm bằng nhôm nhằm bảo vệ ống kính tối đa.\u003c/p\u003e\n\u003cp\u003e- 5 CHẾ ĐỘ CHIẾU SÁNG Linh hoạt trong mọi tình huống với 3 chế độ: Mạnh / Vừa / Nhấp nháy  (Tín hiệu cầu cứu).\u003c/p\u003e\n\u003cp\u003e- Chức năng phóng to, phóng đại hoặc chiếu xa gần dễ sử dụng trong các tình huống khác nhau khoảng cách chiếu xa từ 100 -\u0026gt; 150M NÚT BẤM CAO SU\u003c/p\u003e\n\u003cp\u003e- Sử dụng Pin Sạc ,Pin sạc Lithium dung lượng lớn lên đến 4800mAh hiệu năng 3.7V cho cường độ chiếu sáng mạnh mẽ.\u003c/p\u003e\n\u003cp\u003e- VỎ NHÔM CỨNG CÁP Sử dụng nhôm nguyên khối, công nghệ chạm khắc CNC 3D cho chất lượng hoàn thiện tuyệt vời CHỐNG NƯỚC TUYỆT ĐỐI\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/fa/1b/cb/021d39fa57ef2eb406740514a06c76e4.jpg\" alt=\"\" width=\"750\" height=\"752\"\u003e\u003c/p\u003e\n\u003ch2\u003eTHÔNG TIN SẢN PHẨM\u003c/h2\u003e\n\u003cp\u003eChip LED XML T6\u003c/p\u003e\n\u003cp\u003eĐộ sáng 1000 lumens\u003c/p\u003e\n\u003cp\u003eNhiệt độ màu 6000k\u003c/p\u003e\n\u003cp\u003eVật liệu ống kính: Thấu kính lồi quang\u003c/p\u003e\n\u003cp\u003eThu phóng - Zoomx1, x250, x500, x1000, x2000\u003c/p\u003e\n\u003cp\u003eKhung bảo vệ: Hợp kim nhôm\u003c/p\u003e\n\u003cp\u003eÁnh sáng phát ra: Màu trắng\u003c/p\u003e\n\u003cp\u003eChế độ chiếu sáng: Mạnh nhất / Mạnh / Vừa / Nhấp nháy / SOS\u003c/p\u003e\n\u003cp\u003ePin 18650\u003c/p\u003e\n\u003cp\u003eĐiện áp 3.7V\u003c/p\u003e\n\u003cp\u003eThời gian sạc: 6 tiếng\u003c/p\u003e\n\u003cp\u003eCông suất: 10W\u003c/p\u003e\n\u003cp\u003eKích thước: 138 x 39 x 27mm\u003c/p\u003e\n\u003cp\u003eMàu sắc: Đen\u003c/p\u003e\n\u003cp\u003eTrọng lượng:133 gram\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/7b/ed/41/d7b814ed95ee535fa4b53d2b869307fe.jpg\" alt=\"\" width=\"750\" height=\"751\"\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/b6/f1/cd/dd855f0229db4350c9cc768577a45e7b.jpg\" alt=\"\" width=\"750\" height=\"750\"\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác n