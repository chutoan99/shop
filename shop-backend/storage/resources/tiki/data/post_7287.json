ref":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":13,"review_text":"(13)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/6e/be/f9/4b1b516d225f5557ae248397d43c25f4.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1212,"all_time_quantity_sold":110,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cdiv class=\"kvgmc6g5 cxmmr5t8 oygrvhab hcukyx3x c1et5uql ii04i59q\"\u003e\n\u003cdiv dir=\"auto\" style=\"text-align: center;\"\u003e\u003cstrong\u003eBỘ SÁCH DÀNH CHO GIÁO VIÊN YOGA CƠ BẢN\u003c/strong\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"o9v6fnle cxmmr5t8 oygrvhab hcukyx3x c1et5uql ii04i59q\"\u003e\n\u003cdiv dir=\"auto\"\u003eBạn là một giáo viên Yoga, hay đơn giản bạn là người thực hà Bạn đang gặp khó khăn trong việc xây dựng giáo án của mình. Bộ sách này sẽ giúp bạn hoàn thiện mỗi ngày về chỉnh sửa hướng dẫn tư thế, xây dựng chuỗi bài, giáo án theo từng chủ đề đa dạng. \u003c/div\u003e\n\u003cdiv dir=\"auto\"\u003e \u003c/div\u003e\n\u003cdiv dir=\"auto\"\u003e\n\u003cdiv class=\"bi6gxh9e\"\u003e\u003cstrong\u003e\u003cspan class=\"d2edcug0 hpfvmrgz qv66sw1b c1et5uql rrkovp55 jq4qci2q a3bd9o3v knj5qynh oo9gr5id\"\u003e1. SÁCH HƯỚNG DẪN KHỞI ĐỘNG \u0026amp; 200 TƯ THẾ YOGA\u003c/span\u003e\u003c/strong\u003e\u003c/div\u003e\n\u003cdiv class=\"bi6gxh9e\"\u003eCuốn sách hướng dẫn chi tiết kỹ thuật thực hành tư thế từ cơ bản tới nâng cao, chỉnh sửa định tuyến tư thế đúng. Đồng thời có 45 chuỗi khởi động theo từng chủ đề. Là cuốn sách phù hợp cho người mới tập, tự tập tại nhà và giáo viên Yoga.\u003c/div\u003e\n\u003cdiv class=\"bi6gxh9e\"\u003eSách 308 trang, in khổ to A4.\u003c/div\u003e\n\u003cdiv class=\"bi6gxh9e\"\u003e \u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv dir=\"auto\"\u003e\u003cstrong\u003e2. SÁCH GIÁO ÁN GIẢNG DẠY YOGA TRỊ LIỆU\u003c/strong\u003e\u003c/div\u003e\n\u003cdiv dir=\"auto\"\u003e\n\u003cp\u003eNội dung sách được xây dựng bài bản, chi tiết và khoa học. Sách trình bày 23 bệnh lý cụ thể với hơn 50 giáo án được biên soạn. Mỗi bệnh lý cung cấp nhiều kiến thức, quan trọng đưa ra được nguyên tắc xây dựng giáo án trị liệu kết hợp với hơi thở và sử dụng ngôn ngữ trị liệu trong từng giáo án là một điểm đặc biệt mà chưa có cuốn sách nào khai thác.\u003c/p\u003e\n\u003cdiv class=\"text_exposed_show\"\u003e\n\u003cp\u003eSách với 4 phần và 27 chương:\u003c/p\u003e\n\u003cp\u003e- Kiến thức tổng quát về Yoga trị liệu\u003c/p\u003e\n\u003cp\u003e- Giáo án các bài tập Yoga hỗ trợ trị liệu các bệnh về cột sống và xương khớp\u003c/p\u003e\n\u003cp\u003e- Giáo án các bài tập Yoga hỗ trợ trị liệu các bệnh khác\u003c/p\u003e\n\u003cp\u003e- Sơ cứu và xử lý chấn thương thường gặp trong lớp tập yoga.\u003c/p\u003e\n\u003cp\u003eSách day 415 trang in màu giấy bóng mịn chất lượng.\u003c/p\u003e\n\u003cstrong\u003e3. SÁCH HỆ THỐNG 1500 BIẾN THỂ TƯ THẾ \u0026amp; 100 CHUỖI BÀI YOGA LIÊN HOÀN\u003c/strong\u003e\n\u003cp\u003eMột cuốn sách chuyên về chuỗi bài tập. Chìa khóa thành công cho giờ học, giờ dạy.\u003c/p\u003e\n\u003cp\u003eSách với những nội dung chính sau:\u003c/p\u003e\n\u003cp\u003e- 50 biến thể Chào mặt trời, Chào mặt trăng\u003c/p\u003e\n\u003cp\u003e- Ứng dụng Chào mặt trời và Chào mặt trăng trong xây dựng các chuỗi bài lên lớp\u003c/p\u003e\n\u003cp\u003e- Cách xây dựng chuỗi bài để hướng tới các tư thế đỉnh (tư thế nâng cao)\u003c/p\u003e\n\u003cp\u003e- 62 tư thế và hơn 1500 biến thể, trong đó các tư thế Yoga đôi luôn được chúng tôi lưu tâm.\u003c/p\u003e\n\u003cp\u003e- 100 chuỗi bài Yoga liên hoàn với nhiều chủ đề đa dạng như: mở khớp vai, mở khớp hông, săn chắc cơ bụng, thải độ và các chuỗi bài theo dòng phái đa dạ\u003c/p\u003e\n\u003cp\u003eSách dày 496 trang in khổ ngang A4.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e4. SÁCH NHỮNG BÀI DẪN THIỀN HAY DÀNH CHO GIÁO VIÊN YOGA\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eThực tế cho thấy, 60% giáo viên yoga hiện nay dường như chỉ cho học viên nằm thư giãn ở tư thế Shavasana với nhạc thiền tĩnh tâm mà ít có sự dẫn dắt về thiền. Khi giáo viên trực tiếp dẫn thiền tôi cảm thấy sự gần gũi, nhẹ nhàng, thoải mái hơn và cảm thấy mình được kết nối thực sự và quan trọng hơn nữa là tôi nhận ra rằng mình đang được quan tâm. Để giải quyết khó khăn cho giáo viên thì cuốn sách này thực sự cần thiết.\u003c/p\u003e\n\u003cp\u003eTổng quan về thư giãn sâu, nghệ thuật thư giãn kết hợp dẫn thiền.\u003c/p\u003e\n\u003cp\u003eHệ thống 70 bài dẫn thiền theo từng chủ đề. Bạn có thể dẫn theo từng chủ đề riêng, theo từng đối tượng phù hợp. \u003c/p\u003e\n\u003cp\u003eSách dày 254 trang in khổ 16 x 24.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv dir=\"auto\"\u003e \u003c/div\u003e\n\u003cdiv dir=\"auto\"\u003e\n\u003cdiv class=\"bi6gxh9e\"\u003e \u003c/div\u003e\n\u003cdiv class=\"bi6gxh9e\"\u003e \u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/6e/be/f9/4b1b516d2