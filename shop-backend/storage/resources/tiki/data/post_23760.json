:20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/51/6c/cc/2fdb811d31fc81effee556197a5ad6bc.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":875,"all_time_quantity_sold":7,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eBAO BÌ CÓ THỂ THAY ĐỔI TÙY THEO ĐỢT NHẬP HÀNG\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTHÀNH PHẦN:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eNatri clorua (NaCl) ………………… 0,9 g\u003cbr /\u003eNước tinh khiết ……………. …………………… qsp 100 ml\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCÔNG DỤNG:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eNước muối sinh lý vô trùng Physiodose Round từ nhà máy sản xuất Gilbert lớn nhất thế giới được sử dụng để làm sạch mũi, mắt và tai .\u003c/p\u003e\n\u003cp\u003eNiêm mạc mũi có thể bị tắc nghẽn và dẫn đến các bện.h lý đường hô hấp trên như tai mũi họng. Việc nhỏ dung dịch nước muối vô trùng Physiodose Gilbert sẽ \u003cstrong\u003erửa\u003c/strong\u003e sâu các hốc mũi bị tắc nghẽn và làm sạch các tạp chất, giúp bé cải thiện các triệu chứng rõ rệt.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eHƯỚNG DẪN SỬ DỤNG\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eLiều dùng: 1-3 lần/ngày sử dụng 1 liều đơn 5ml cho vệ sinh mũi mắt cho bé.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eVệ sinh mũi:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eMở ống Nước muối sinh lý vô trùng Physiodose Round bằng cách xoay nắp nhựa.\u003c/p\u003e\n\u003cp\u003eĐặt trẻ nằm ngang và giữ đầu nghiêng sang một bên. Đưa đầu ống vào mũi\u003c/p\u003e\n\u003cp\u003eBóp nhẹ thành từng giọt để có được liều cần thiết. Lặp lại quá trình trên với mũi còn lại. Đối với trẻ sơ sinh, bóp nhẹ vào thành ống để dung dịch vào mũi với áp lực nhẹ vừa phải để tránh nguy cơ viêm tai giữa.\u003c/p\u003e\n\u003cp\u003eĐể trẻ nằm yên một lát rồi cho trẻ ngồi dậy. Nâng cao đầu trẻ và lau dịch chảy ra (nếu có).\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eVệ sinh mắt:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eĐể vệ sinh hàng ngày, sử dụng một miếng gạc ướt thấm Nước muối sinh lý vô trùng Physiodose Round rồi lau nhẹ.\u003c/p\u003e\n\u003cp\u003eĐể làm sạch trong trường hợp viêm kết mạc hoặc khó chịu, nhỏ vào mắt và lau khô bằng một miếng gạc vô trùng. Dùng miếng gạc khác cho mắt còn lại.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eQUY CÁCH ĐÓNG GÓI: \u003c/strong\u003eHộp 40 liều đơn 5 ml\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eLƯU Ý:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eKhông sử dụng cùng một liều duy nhất cho các mục đích sử dụng khác nhau.\u003c/li\u003e\n\u003cli\u003eĐể sử dụng cá nhân và đơn lẻ.\u003c/li\u003e\n\u003cli\u003eTách một liều duy nhất và mở nó bằng cách xoay phần trên.\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eHÃNG SẢN XUẤT:  LABORATOIRES GILBERT\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eNƯỚC SẢN XUẤT: PHÁP\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCAM KẾT CỦA BABY THIÊN PHÚC:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eCác sản phẩm đều có tem phụ Tiếng Việt của nhà phân phối, đảm bảo tính pháp lý cũng như chất lượng của sản phẩm.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/51/6c/cc/2fdb811d31fc81effee556197a5ad6bc.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/51/6c/cc/2fdb811d31fc81effee556197a5ad6bc.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/51/6c/cc/2fdb811d31fc81effee556197a5ad6bc.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/51/6c/cc/2fdb811d31fc81effee556197a5ad6bc.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/51/6c/cc/2fdb811d31fc81effee556197a5ad6bc.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/f8/12/9e/60d235023f48fe8b4295dfe8417cadfd.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f8/12/9e/60d235023f48fe8b4295dfe8417cadfd.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f8/12/9e/60d235023f48fe8b4295dfe8417cadfd.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f8/12/9e/60d235023f48fe8b4295dfe8417cadfd.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f8/12/9e/60d235023f48fe8b4295dfe8417cadfd.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/d4/06/19/b18eb13361dc37b905006b776013ecaf.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d4/06/19/b18eb13361dc37b905006b776013ecaf.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d4/06/19/b18eb13361dc37b905006b776013ecaf.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d4/06/19/b18eb13361dc37b905006b776013ecaf.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d4/06/19/b18eb13361dc37b905006b776013ecaf.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/37