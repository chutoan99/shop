":"9.9"},{"placement":"pdp_badge","code":"is_hero","type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":true,"return_reason":"any_reason"}},"discount":82000,"discount_rate":35,"rating_average":5,"review_count":24,"review_text":"(24)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/7a/d5/11/2b002d3bb061f330e4cc53acd03cdf94.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1183,"all_time_quantity_sold":80,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003eGiới thiệu\u003c/h3\u003e\n\u003cp\u003e Bình sữa Pigeon PP Plus họa tiết xanh 240 ml được làm từ chất liệu nhựa PP cao cấp, an toàn, đi đầu trong việc mang đến cho bé trải nghiệm thật như bú mẹ thông qua núm ty mô phỏng bầu ti mẹ, giúp bé chuyển từ bú mẹ sang bú bình dễ dàng hơn.\u003c/p\u003e\n\u003cp\u003eVới hơn 60 năm qua trải qua rất nhiều nghiên cứu chuyên sâu về cử động bú mẹ tự nhiên của các em bé trên toàn cầu, các chuyên gia R\u0026amp;D của Pigeon đã phát triển ra rất nhiều dòng bình sữa và núm ty phù hợp với bé\u003c/p\u003e\n\u003ch3\u003eĐặc điểm nổi bật\u003c/h3\u003e\n\u003cul\u003e\u003cli\u003eNhựa PP cao cấp, trong suốt. Trên thân bình có vạch chia dung tích rõ ràng, thuận tiện khi mẹ pha sữa cũng như theo dõi lượng sữa mỗi lần bé bú.\u003c/li\u003e\u003cli\u003eKhả năng chịu nhiệt cao đến 110℃\u003c/li\u003e\u003cli\u003eNúm: Silicon siêu mềm, mô phỏng bầu ti mẹ\u003c/li\u003e\u003cli\u003eBình cổ rộng dễ dàng súc rửa, thiết kế thon gọn và uốn cong giúp bé có thể tự cầm bình khi bú\u003c/li\u003e\u003cli\u003eHệ thống van thông khí AVS điều chỉnh áp suất trong bình, điều tiết lượng sữa chảy ra, hạn chế tình trạng đầy hơi, khó tiêu của bé.\u003c/li\u003e\u003cli\u003eKhông chứa BPA, BPS\u003c/li\u003e\u003cli\u003eMàu sắc và họa tiết xinh xắn kích thích thị giác khi bé bú sữa\u003c/li\u003e\u003c/ul\u003e\n\u003ch3\u003eĐối tượng sử dụng\u003c/h3\u003e\n\u003cp\u003eDành cho bé từ 3 tháng tuổi\u003c/p\u003e\n\u003ch3\u003eHướng dẫn sử dụng\u003c/h3\u003e\n\u003cul\u003e\u003cli\u003eBình sữa sử dụng núm vú nhu động siêu mềm. Được thiết kế dựa trên chuyển động 3 bước: tăng độ bám giúp môi bé giữ chặt với núm vú, phù hợp với lực hút của bé, giúp lượng sữa chảy ra đều đặn.\u003c/li\u003e\u003cli\u003eBình có khả năng chịu nhiệt rất cao (110oC) khi tiệt trùng.\u003c/li\u003e\u003c/ul\u003e\n\u003ch3\u003eLưu ý \u003c/h3\u003e\n\u003cul\u003e\u003cli\u003eLuôn rửa sạch và tiệt trùng bình sữa trước khi cho bé bú. Vệ sinh bình sữa, núm ty bằng dung dịch súc rửa chuyên dụng, nước sôi hoặc máy tiệt trùng.\u003c/li\u003e\u003cli\u003eThực hiện đúng hướng dẫn vệ sinh, tiệt khuẩn. Việc sử dụng bình bú có thể làm cho trẻ bỏ bú mẹ và có nguy cơ bị tiêu chảy. Sử dụng vú ngậm nhân tạo ảnh hưởng không tốt tới việc nuôi trẻ bằng sữa mẹ.\u003c/li\u003e\u003c/ul\u003e\n\u003ch3\u003eChất liệu\u003c/h3\u003e\n\u003cul\u003e\u003cli\u003ePhần thân: nhựa Polypropylence (PP)\u003c/li\u003e\u003cli\u003eNúm vú: Silicone\u003c/li\u003e\u003cli\u003ePhần nắp bình, cổ bình: nhựa Polypropylence (PP)\u003c/li\u003e\u003c/ul\u003e\n\u003ch3\u003eThông tin sản phẩm\u003c/h3\u003e\n\u003cul\u003e\u003cli\u003eXuất xứ: Indonesia\u003c/li\u003e\u003cli\u003eHSD: 5 năm kể từ ngày SX\u003c/li\u003e\u003cli\u003eBình đi kèm núm vú Silicon siêu mềm Plus size M (3 tháng \u0026#43;)\u003c/li\u003e\u003cli\u003eMàu sắc: Xanh dương/ Hồng\u003c/li\u003e\u003cli\u003eDung tích: 240ml\u003c/li\u003e\u003cli\u003eTrọng lượng: 100g\u003c/li\u003e\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/7a/d5/11/2b002d3bb061f330e4cc53acd03cdf94.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/7a/d5/11/2b002d3bb061f330e4cc53acd03cdf94.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/7a/d5/11/2b002d3bb061f330e4cc53acd03cdf94.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7a/d5/11/2b002d3bb061f330e4cc53acd03cdf94.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7a/d5/11/2b002d3bb061f330e4cc53acd03cdf94.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/c0/26/91/583ff74f4b8dae8771ed8fe68a1a0b6a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c0/26/91/583ff74f4b8dae8771ed8fe68a1a0b6a.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c0/26/91/583ff74f4b8dae8771ed8fe68a1a0b6a.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c0/26/91/583ff74f4b8dae8771ed8fe68a1a0b6a.jpg","thumbnail_url":"https://salt.tikicdn.com/ca