erage":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ec/b0/a2/5109f79ab51f010b14d57b4b83469bef.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":705,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cdiv class=\"thietKe gStyle3 menuViewHightLight\"\u003e\n\u003cdiv class=\"description\"\u003e\u003cstrong\u003eTHIẾT KẾ: SANG TRỌNG VÀ HIỆN ĐẠI\u003c/strong\u003e\n\u003cul\u003e\u003cli\u003eKiểu dáng sang trọng\u003c/li\u003e\n\u003c/ul\u003e\nBếp đôi điện từ SUNHOUSE SHB9101S có kiểu dáng sang trọng với mặt kính đen toàn phần cùng với viền bạc bo 4 cạnh, các chi tiết trên bề mặt bếp được tối giản, tinh tế. Không chỉ vậy, thiết kế lắp âm còn giúp tăng phần hiện đại, đẩy cao tính thẩm mỹ cho không gian nấu nướng.Mặt kính cao cấp siêu bền\u003cbr /\u003eMặt bếp làm bằng kính cao cấp, dày 4mm, cực bền, khó bị nứt vỡ trong quá trình sử dụng. Đặc biệt, chất liệu này còn mang đến độ sáng bóng cho mặt kính và có thể dễ dàng vệ sinh sau khi sử dụng.\n\u003cul\u003e\u003cli\u003eBảng điều khiển cảm ứng\u003c/li\u003e\n\u003c/ul\u003e\nSản phẩm được trang bị bảng điều khiển cảm ứng hiện đại kèm màn hình hiển thị đa thông tin, hoạt động độc lập cho từng vùng bếp nên rất dễ thao tác. Chỉ vài thao tác chạm nhẹ tay trên sản phẩm, bạn đã lựa chọn được chế độ hoạt động mong muốn.\u003cbr /\u003e \u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"congNang gStyle3 menuViewHightLight\"\u003e\n\u003cdiv class=\"description\"\u003e\u003cstrong\u003eCÔNG NĂNG: NẤU NƯỚNG NHANH VÀ TIẾT KIỆM ĐIỆN\u003c/strong\u003e\n\u003cul\u003e\u003cli\u003eHai vùng nấu tiện lợi\u003c/li\u003e\n\u003c/ul\u003e\nBếp đôi điện từ SUNHOUSE SHB9101S với 2 vùng nấu ăn tiện lợi, giúp bạn có thể thỏa thích nấu nhiều món ăn cùng lúc mà không lo chế biến lâu.\n\u003cul\u003e\u003cli\u003eKhả năng làm nóng cực nhanh\u003c/li\u003e\n\u003c/ul\u003e\nVới công suất lớn và khả năng làm nóng nhanh gấp 2 lần bếp thường, SHB9101S nhanh chóng làm nóng nồi chảo để làm chín thực phẩm, giúp bạn tiết kiệm thời gian nấu nướng và tiết kiệm điện năng cho gia đình.\n\u003cul\u003e\u003cli\u003eTuổi thọ cao\u003c/li\u003e\n\u003c/ul\u003e\nBếp đôi điện từ SUNHOUSE SHB9101S với mâm từ được làm bằng 100% dây đồng siêu bền, giúp truyền nhiệt tốt và tăng tuổi thọ của bếp.\n\u003cul\u003e\u003cli\u003eNhiều tính năng hiện đại\u003c/li\u003e\n\u003c/ul\u003e\nBếp đôi điện từ SUNHOUSE SHB9101S được trang bị nhiều tính năng hiện đại như hẹn giờ, khóa trẻ em và cảm ứng nhiệt, tự động ngắt khi quá tải giúp đảm bảo an toàn cho người sử dụng và nâng cao độ bền cho bếp.\n\u003cul\u003e\u003cli\u003eAptomat riêng biệt, an toàn cho người dùng\u003c/li\u003e\n\u003c/ul\u003e\nBếp đôi điện từ SUNHOUSE SHB9101S không sử dụng phích cắm trực tiếp vào nguồn điện chung trong gia đình mà kết nối thông qua 1 aptomat riêng biệt. Bởi bếp hoạt động với công suất cao, lên tới 3600W, nếu sử dụng phích cắm thông thường sẽ rất dễ gây chập, cháy nổ, mất an toàn. Vì vậy, thiết kế đặc biệt của SUNHOUSE giúp mang lại khả năng vận hành ổn định cho bếp và sự an toàn tuyệt đối cho người sử dụng.\n\u003cul\u003e\u003cli\u003eChế độ hậu mãi hàng đầu – Bảo hành 36 tháng\u003c/li\u003e\n\u003c/ul\u003e\nSản phẩm Bếp đôi điện từ SUNHOUSE SHB9101S được áp dụng chế độ hậu mãi hàng đầu với mạng lưới bảo hành trên cả nước và nhân viên kĩ thuật chuyên nghiệp từ SUNHOUSE. Đặc biệt, thời gian bảo hành của sản phẩm là 36 tháng và được áp dụng chế độ bảo hành tại nhà, giúp người dùng an tâm tuyệt đối về chất lượng và dịch vụ.\u003cbr /\u003e \u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"thongSoKyThuatSanPham1 menuViewHightLight\"\u003e\n\u003ch2 class=\"title\"\u003eThông số kỹ thuật\u003c/h2\u003e\n\u003cul\u003e\u003cli\u003e\n\u003cdiv class=\"text\"\u003eModel: SHB9101S\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv class=\"text\"\u003eSố vùng nấu: 2\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv class=\"text\"\u003eCông suất bếp bên trái: 2000W\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv class=\"text\"\u003eCông suất bếp bên phải: 2000W\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv class=\"text\"\u003eTổng công suất: 3600W\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv class=\"text\"\u003eĐiện áp: 220V – 240V / 50Hz\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv class=\"text\"\u003eChất liệu mặt kính: Kính tôi chịu nhiệt\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv class=\"text\"\u003eĐộ dày mặt kính: 4mm\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv class=\"text\"\u003eChất liệu mâm từ: Đồng\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv class=\"text\"\u003eBảng điều khiển: Cảm ứng\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv class=\"text\"\u003eLoại nồi thích hợp: Nồi chảo có đáy nhiễm từ\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv class=\"text\"\u003eHẹn giờ: Có\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv class=\"text\"\u003eKhóa trẻ em: Có\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv class=\"text\"\u003eKích thước sản phẩm: 730 x 430 x 85 mm\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv class=\"text\"\u003eKích thước mặt bếp: 730 x 430 mm\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003ekích thước cắt đá: 68*39mm\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv class=\"text\"\u003eKhối lượng: 9.1kg\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv class=\"text\"\u003eThương hiệu: SUNHOUSE\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv class=\"text\"\u003eBảo hành: 36 th