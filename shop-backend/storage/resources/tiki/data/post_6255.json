_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.2,"review_count":12,"review_text":"(12)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/05/d2/4e/986b5d4025e8b86010aca0394ab18073.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1011,"all_time_quantity_sold":50,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eTình trạng mệt mỏi, đau nhức cơ thể do phải ngồi lâu để làm việc, học tập… Khiến cơ thể của bạn đau nhức gây ảnh hưởng đến cuộc sống, sinh hoạt hàng ngày. Gối Massage Lưng Và Cổ được trang bị 16 đầu bi massage cùng chế độ rung tần số cao hỗ trợ làm giảm mệt mỏi, đau nhức cơ thể và đem lại tinh thần thoải mái, sảng khoái nhất.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/cb/4b/ff/0b1241233dbec853c6e8856db6872757.jpg\" alt=\"\" width=\"750\" height=\"1190\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e✥\u003c/strong\u003e\u003cstrong\u003e Ưu điểm của gối massage hồng ngoại 16 bi\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e - \u003cstrong\u003eMô phòng giống nhân viên massage: \u003c/strong\u003eĐược mô phỏng giống như nhân viên massage với 6 thao tác mát xa kết hợp, giúp thư giãn, giảm căng thẳng mệt mỏi hiệu quả. Hỗ trợ trị liệu đau mỏi cổ, đau vai gáy, căng cơ,\u003c/p\u003e\n\u003cp\u003e - \u003cstrong\u003eTính năng hồng ngoại:\u003c/strong\u003e Với tính năng hồng ngoại giúp cải thiện sự trao đổi chất giữa các tế bào, hỗ trợ tăng lưu thông khí huyết, hỗ trợ giảm căng thẳng mệt mỏi được hiệu quả, cho giấc ngủ ngon và ngủ sâu giấc hơn\u003c/p\u003e\n\u003cp\u003e - \u003cstrong\u003eĐược trang bị 16 bi:\u003c/strong\u003e\u003cstrong\u003e \u003c/strong\u003e16 quả cầu lắp trong chuyển động liên tục mát xa vào các cơ, xoa bóp vào các vùng bị đau nhức giúp bạn thư giãn, hỗ trợ giảm tình trang đau cứng cơ, đau mỏi cổ được cải thiện tốt hơn\u003c/p\u003e\n\u003cp\u003e - \u003cstrong\u003eThiết kế thông minh:\u003c/strong\u003e Phù hợp với đường cong tự nhiên, ôm khít phần cổ, vai gáy, giúp nâng đỡ, làm giảm áp lực tì đè lên vai cổ. hỗ trợ tăng cường lưu thông tuần hoàn khí huyết được tốt hơn, cho bạn giấc ngủ sâu sau mỗi lần sử dụng\u003c/p\u003e\n\u003cp\u003e - \u003cstrong\u003eChất liệu tốt:\u003c/strong\u003e Phần thân gối được làm từ cao su tự nhiên với độ đàn hồi cao. Phần đầu của gối có chiều cao thấp hơn, tạo cảm giác thoải mái khi nằm và làm giảm áp lực cho đốt sống cổ\u003c/p\u003e\n\u003cp\u003e - \u003cstrong\u003eMassage 6D:\u003c/strong\u003e\u003cstrong\u003e \u003c/strong\u003e6 tính năng massage bao gồm: 3 mức cấp độ massage khác nhau, tính năng hồng ngoại, tính năng đảo chiều, tính năng tiết kiệm năng lượng, tính năng chuyển đổi 3 chế độ, nút ON/OFF được tích hợp ngay trên thân máy rất tiện dụng\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/05/d2/4e/b3a7f82124525ec2a7a404620559cf73.jpg\" alt=\"\" width=\"750\" height=\"1000\" /\u003e\u003c/p\u003e\n\u003ch4\u003e\u003cstrong\u003eTác dụng của gối massage hồng ngoại cao cấp mang lại:\u003c/strong\u003e\u003c/h4\u003e\n\u003cp\u003e\u003cstrong\u003eLà máy massage đa năng, cao cấp mang lại nhiều tác dụng, là giải pháp hồi phục sức khoẻ nhanh chóng, lấy lại tinh thần thư giãn thoải mái\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eChức năng sưởi nóng bằng tia hồng ngoại\u003c/li\u003e\n\u003cli\u003eMassage thường \u0026amp; Massage hồng ngoại (kết hợp trị liệu vật lý \u0026amp; trị liệu hồng ngoại)\u003c/li\u003e\n\u003cli\u003eCải thiện tuần hoàn máu, tăng cường sự trao đổi chất của các tế bào\u003c/li\u003e\n\u003cli\u003eGiảm đau, giảm tình trạng căng cơ, xua tan những cơn mệt mỏi\u003c/li\u003e\n\u003cli\u003eTrang bị với 16 quả cầu lắp trong, massage xoa bóp vào các cơ và huyệt\u003c/li\u003e\n\u003cli\u003eCó thể dùng để massage cho nhiều vị trí trên cơ thể:\n\u003cul\u003e\n\u003cli\u003eCó thể dùng gối massage cổ, lưng, bụng, tay chân,…giải trừ đau nhức mỏi cơ, khớp\u003c/li\u003e\n\u003cli\u003eCó thể dùng gối massage bụng, đùi…giúp đánh tan mỡ bụng, giúp vòng eo và cơ thể ngày càng săn chắc, gọn gàng\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/li\u003e\n\u003cli\u003eGọn nhẹ, dễ sử dụng mọi lúc mọi nơi, có bảng điều khiển giúp dễ dàng điều chỉnh chế độ massage.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eCác đầu bi xoay chuyển 360 độ đảo chiều liên tục tạo ra các xung điện nhịp nhàng, tác động các mô tế bào, vùng huyệt đạo ở vai, gáy, cổ, lưng … thúc đẩy lưu thông tuần hoàn máu, đả thông kinh mạch, giãn nở vùng cơ, giảm triệu chứng căng cơ, điều trị bệnh xương khớp nhức mỏi ở người già.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/d2/13/a9/5bf4611205947ee0723fe588968b8974.jpg\" alt=\"\" width=\"750\" height=\"1758\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/14/dd/dd/4f201a442b7c37645ba60917fedf13c8.jpg\" alt=\"\" width=\"750\" height=\"955\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/15/1e/16/8ea04cef1299e9d5a4e9ccd6f35ce8b6.jpg\" alt=\"\" width=\"750\" height=\"1452\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/c7/cb/44/a8ef18e894552432c291fafd360427ba.jpg\" alt=\"\" width=\"750\" height=\"1360\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/d3/4c/1a/c80b72f027fe3ab5e20dc625b37a43eb.jpg\" alt=\"\" width=\"750\" height=\"1175\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/a4/2c/b2/1335f6a8f580e230f4e39d8de07bf972.jpg\" alt=\"\" width=\"750\" height=\"1527\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTHÔNG TIN SẢN PHẨM\u003c/strong\u003e\u003c/p\u003e\n\u003cdiv id=\"LIST_PARAGRAPH38\" class=\"ladi-element\"\u003e\n\u003cdiv class=\"ladi-list-paragraph\"\u003e\n\u003cul\u003e\n\u003cli class=\"\"\u003eChất liệu: Vải lưới tổ ong, thoáng khí, không gây cảm giác ngột ngạt. Vải mềm mại thân thiện với làn da\u003c/li\u003e\n\u003cli class=\"\"\u003eĐiện áp đầu vào: 220V,50-60HZ\u003c/li\u003e\n\u003cli class=\"\"\u003eMàu sắc: Trắng Đỏ Sang Trọng\u003c/li\u003e\n\u003cli class=\"\"\u003eHình dạng: Hình thang chữ nhật\u003c/li\u003e\n\u003cli class=\"\"\u003eKỹ thuật xoa bóp: Xoa bóp, Bấm huyệt...\u003c/li\u003e\n\u003cli class=\"\"\u003eBộ phận áp dụng: Cổ, Lưng, Eo, Bắp đùi, bụng...\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv id=\"HEADLINE39\" class=\"ladi-element\"\u003e\n\u003ch3 class=\"ladi-headline\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/8b/ce/d9/df65002a09c5ad7a1832c46d7d0bde6b.jpg\" alt=\"\" width=\"750\" height=\"482\" /\u003e\u003c/h3\u003e\n\u003cp\u003e✥ LƯU Ý khi dùng Gối Massage Hồng Ngoại, gối mát xa cổ\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eCó thể tăng thời gian sử dụng sau khi đã quen với máy.\u003c/li\u003e\n\u003cli\u003eDùng ít hơn 30 phút mỗi lần.\u003c/li\u003e\n\u003cli\u003eSau khi dùng xong nhớ tắt nguồn, rút phích điện.\u003c/li\u003e\n\u003cli\u003eSử dụng bông mềm và chất tẩy rửa trung tính để lau chùi máy.\u003c/li\u003e\n\u003cli\u003eKhông đặt gần bếp, nguồn nhiệt.\u003c/li\u003e\n\u003cli\u003eTốt nhất nên uống 500 cc nước ấm trước và sau khi dùng máy.\u003c/li\u003e\n\u003cli\u003eKhông dùng cho phụ nữ mang thai ở những vùng cơ thể dễ bị tổn thương như bụng, sẽ ảnh hưởng không tốt đến thai nhi\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình t