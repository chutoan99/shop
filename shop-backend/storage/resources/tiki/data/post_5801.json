ckground_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":683000,"discount_rate":39,"rating_average":4.8,"review_count":189,"review_text":"(189)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/10/31/04/859987c7d8e21958f613c2f733f9c493.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1231,"all_time_quantity_sold":713,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/c6/e2/0c/23761e0b65c0faabb118e2b6b6c5a20a.jpg\" alt=\"\" width=\"750\" height=\"231\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color:#008080;\"\u003e\u003cstrong\u003eCâu chuyện của KingTech:\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003eChúng tôi cũng như các bạn - Đều đang phải chung sống với những vấn đề hằng ngày như: đi làm xa, làm việc trên máy tính nhiều giờ, trông trẻ sơ sinh, làm việc nhà ... tất cả những việc đó thực sự gây áp lực cho cơ thể. Bạn thường xuyên bị nhức mỏi cổ, vai gáy, lưng hoặc chân? Hãy lấy lại cân bằng trong cuộc sống. Tại KingTech, chúng tôi cung cấp những giải pháp massage giúp phục hồi cơ bắp, giải quyết chứng đau nhức thường xuyên của bạn bằng một trong nhiều sản phẩm. Chúng tôi tự tin sản phẩm của mình hiệu quả và hạnh phúc khi nhiều hàng nói với chúng tôi rằng KingTech đã làm cho cuộc sống của họ trở nên thoải mái hơn.\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color:#008080;\"\u003e\u003cstrong\u003eĐiều gì khiến sản phẩm của KingTech trở nên độc đáo?\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003eSản phẩm của KingTech đã trải qua quá trình kiểm tra, thử nghiệm về hiệu quả và độ bền bỉ. Chúng tôi đưa phương pháp Shiatsu và kỹ thuật nhào bóp vào những sản phẩm có thiết kế hiện đại, hiệu năng cao. Động cơ của mỗi sản phẩm đều được hiệu chỉnh cẩn thận để bất kỳ ai cũng có thể dễ dàng thưởng thức nghệ thuật mát-xa ngay tại nhà mình.\u003c/p\u003e\n\u003cp\u003e\u003ciframe src=\"//www.youtube.com/embed/awqjK7xzvHU?t=39s\" width=\"560\" height=\"314\" allowfullscreen=\"\"\u003e\u003c/iframe\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cstrong\u003e-----------------------------------\u003c/strong\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color:#008080;\"\u003e\u003cstrong\u003e- ĐẶC ĐIỂM NỔI BẬT MÁY MASSAGE LUX900:\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli class=\"p1\"\u003e\u003cstrong\u003e6 ĐẦU MASSAGE SÂU VÀ MẠNH MẼ:\u003c/strong\u003e Bạn muốn thoát khỏi cơn đau lưng hoặc những cơn đau không thể chịu đựng được ở vai gáy? Bạn đã từng sử dụng máy massage khác và thấy chúng mỏng manh và yếu ớt. Máy mát xa cầm tay KINGTECH LUX900 sẽ là lựa chọn thật hoàn hảo.\u003cspan class=\"Apple-converted-space\"\u003e  \u003c/span\u003eĐộng cơ mạnh mẽ kèm 6 đầu massage chuyên biệt thích hợp cho nhiều vùng trên cơ thể giúp tăng tuần hoàn máu \u0026amp; thư giãn cơ bắp hiệu quả - Giảm đau nhức chỉ trong vài giây.\u003c/li\u003e\n\u003cli class=\"p1\"\u003e\u003cstrong\u003eĐỘNG CƠ PERCUSSION 3600 nhịp/phút SIÊU MẠNH MẼ:\u003c/strong\u003e Hãy tưởng tượng khi bạn đang trong cơn căng cứng cơ bắp và có sẵn chiếc máy massage này. Máy mát xa KINGTECH LUX-900 sẽ kích thích 3.600 nhịp xung động vào cơ bắp của bạn mỗi phút. Chắc chắn bạn sẽ ước mình sở hữu nó sớm hơn!\u003c/li\u003e\n\u003cli class=\"p1\"\u003e\u003cstrong\u003eTHIẾT KẾ CÔNG THÁI HỌC - SANG TRỌNG:\u003c/strong\u003e Máy có thiết kế sang trọng hiện đại, sử dụng sạc pin. Bạn có thể mang theo và sử dụng nó ở bất cứ đâu, phù hợp với nhu cầu lối sống của bạn. LUX-900 có tay cầm dài, thiết kế cong giúp máy dễ dàng tiếp cận tới bất cứ vị trí khó khăn nào phía sau lưng, vai gáy của bạn.\u003c/li\u003e\n\u003cli class=\"p1\"\u003e\u003cstrong\u003ePIN DUNG LƯỢNG CAO - SẠC SIÊU TỐC ĐỘ:\u003c/strong\u003e Được chế tạo với pin sạc Lithium-ion mạnh mẽ sử dụng trong ô tô điện, pin sẽ giúp máy hoạt động trong hơn 140 phút chỉ với một lần sạc! Thời gian sạc là 2 tiếng! (Lưu ý, Cơ chế an toàn của máy sẽ tự động ngắt nguồn sau mỗi 20 phút để tránh tình trạng quá nóng)\u003c/li\u003e\n\u003cli class=\"p3\"\u003e\u003cstrong\u003eDỊCH VỤ HẬU BÁN TỐT - QUÀ TẶNG LÝ TƯỞNG:\u003c/strong\u003e KINGTECH nổi tiếng với các sản phẩm Massage chất lượng, dịch vụ khách hàng tốt. Mỗi máy xa mát của KINGTECH đều sử dụng một hộp và HDSD tiếng Việt riêng, có độ hoàn thiện rất cao. Máy Massage KINGTECH LUX-900 sẽ là món quà lý tưởng cho bố mẹ ,vợ , chồng và bạn bè của bạn. Mua hàng KHÔNG rủi ro, Hãy \"THÊM VÀO GIỎ HÀNG\" ngay hôm nay!\u003c/li\u003e\n\u003c/ul\u003e\u003cdiv class=\"head_box clearfix padding-bottom-15\"\u003e\n\u003ch3 class=\"title\"\u003e\u003cspan style=\"color:#008080;\"\u003e- THÔNG TIN CHI TIẾT: \u003c/span\u003e\u003c/h3\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/e5/eb/4f/f3c6150f0f478bbf5e69ad3e9b67e946.png\" alt=\"\" width=\"750\" height=\"249\" /\u003e\u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv class=\"head_box clearfix padding-bottom-15\"\u003e \u003c/div\u003e\n\u003cdiv class=\"head_box clearfix padding-bottom-15\"\u003e\u003cem\u003e\u003cstrong\u003e    Máy mát xa bộ gõ KINGTECH LUX-900 có động cơ mạnh mẽ, pin Li-ion lâu dài, bề ngoài được làm từ nhựa ABS chất lượng cao. Máy có thể giúp bạn giảm đau nhức, khó chịu ở vai, cổ, lưng, khớp, bàn chân và bắp chân một cách hiệu quả. LUX-900 cũng hữu ích nếu bạn cần tăng tốc độ phục hồi cơ bắp hoặc đơn giản là muốn thư giãn. Lý tưởng để sử dụng bất kỳ thời gian nào trong ngày, đặc biệt là sau khi làm việc hoặc sau khi chơi thể thao.\u003c/strong\u003e\u003c/em\u003e\u003c/div\u003e\n\u003cdiv class=\"entry-content\"\u003e\n\u003ch2\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/63/a3/ae/331f534607be95dfa6c07374a6d6efd2.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/h2\u003e\n\u003cp\u003e\u003cstrong\u003e- Động Cơ Mátxa Mạnh Mẽ:\u003c/strong\u003e\u003cbr /\u003eĐộng cơ máy LUX-900 có thể thực hiện thao tác massage Shiatsu, mang đến nhiều trải nghiệm mát xa khác nhau như một người đấm bóp thực thụ, giúp giảm đau hiệu quả và thúc đẩy lưu thông máu.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/33/59/24/9f4ade545bc248eb6ccd03999f621ff9.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eMassage Không Dây, Có Thể Sạc Lại:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003ePin bên trong của LUX-900 là 2 pin 18650 cell - 2600mAh, thời gian sử dụng liên tục có thể lên đến 140 phút. Một lần sạc đầy mất khoảng 2 giờ. Thiết kế không dây tiện lợi cho phép bạn mang máy đến bất cứ đâu.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTính Năng An Toàn:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eTự động tắt an toàn sau 20 phút sử dụng liên tục giúp máy mát xa không bị quá nhiệt.\u003cbr /\u003eSau khi tắt, để máy mát xa nguội trước khi sử dụng lại.\u003c/p\u003e\n\u003ch2\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/b7/1c/4f/628b078f09e21a98be53f11b89ad8705.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/h2\u003e\n\u003cp\u003e\u003cstrong\u003eDễ dàng sử dụng:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eI\u003c/strong\u003e, Bảng điều khiển đơn giản với 3 phím bấm:\u003cbr /\u003e1, Nút ON/OFF \u003cbr /\u003e- Bật: Nhấn giữ\u003cbr /\u003e- Tắt: Nhấn nhanh\u003cbr /\u003e2, Nút chế độ (Mode) : Chọn chế độ mà bạn thích nhất\u003cbr /\u003e3, Nút chọn tốc độ (Speed): Tăng hoặc giảm công suất massage\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003e\u003cstrong\u003eII\u003c/strong\u003e, LUX-900 có tay cầm dài hơn với thiết kế công thái học giúp bạn có thể dễ dàng tiếp cận bất kỳ vùng nào phía sau lưng.\u003c/p\u003e\n\u003cp\u003e \u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/d5/63/b1/a8e192a2970c08eafa3460b5153f8e4e.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/8e/64/1d/c7d855feb03b4b58dc245e67a7c52153.jpeg\" alt=\"\" width=\"750\" height=\"901\" /\u003e \u003c/p\u003e\n\u003ch2\u003e\u003cimg class=\"aligncenter size-full wp-image-3110 lazyloaded\" style=\"margin-left:auto;margin-right:auto;\" src=\"https://cdn.shortpixel.ai/client/q_glossy,ret_img,w_970,h_970/https://kingtechcare.vn/wp-content/uploads/2021/04/7-33.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/h2\u003e\n\u003ch2\u003e\u003ca href=\"https://kingtechcare.vn/shop/kingtech-lux-900/\"\u003e\u003cimg class=\"aligncenter wp-image-3112 size-full lazyloaded\" style=\"margin-left:auto;margin-right:auto;\" src=\"https://cdn.shortpixel.ai/client/q_glossy,ret_img,w_970,h_995/https://kingtechcare.vn/wp-content/uploads/2021/04/9-22.jpg\" alt=\"Máy Massage Cầm tay Đa Năng Cao Cấp KINGTECH LUX-900\" width=\"750\" height=\"769\" /\u003e\u003c/a\u003e\u003cimg class=\"aligncenter size-full wp-image-3113 lazyloaded\" style=\"margin-left:auto;margin-right:auto;\" src=\"https://cdn.shortpixel.ai/client/q_glossy,ret_img,w_970,h_1023/https://kingte