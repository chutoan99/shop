/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.8,"review_count":12,"review_text":"(12)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/02/7b/66/5de6230929da79018b2dc22c41afcae6.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":525,"all_time_quantity_sold":104,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p><strong>THÔNG TIN SẢN PHẨM :</strong><br />Novasol Curcumin nhập khẩu từ Đức<br />Chiết xuất Lá Tía Tô nhập khẩu từ Nhật<br /><strong>CÔNG DỤNG :</strong><br />Hỗ trợ giảm acid dịch vị. Hỗ trợ giảm triệu chứng do viêm loét dạ dày, tá tràng: ợ hơi, ợ chua, đau thượng vị.<br /><strong>ĐỐI TƯỢNG SỬ DỤNG :</strong><br />Trẻ từ 12 tuổi trở lên và người lớn viêm loát dạ dày, tá tràng.<br /><strong>CÁCH DÙNG :</strong><br />Trẻ từ 12 tuổi và người lớn: Uống 20ml/ lần x 1-2 lần/ ngày.<br /><strong>BẢO QUẢN</strong><br />Nơi khô ráo, thoáng mát, tránh ánh nắng trực tiếp. <br />Để xa tầm tay trẻ em.<br /><strong>Chú ý:</strong><br />• Thực phẩm này không phải là thuốc, không có tác dụng thay thế thuốc chữa bệnh.<br />• Không sử dụng cho người suy thận nặng, các trường hợp mẫn cảm với các thuốc chống acid chứa magnesi, phụ nữ có thai, cho con bú, người mẫn cảm, kiêng kỵ với bất kỳ thành phần nào của sản phẩm. <br />• Người đang dùng thuốc tham khảo ý kiến của chuyên gia y tế trước khi sử dụng.<br /><strong>THÀNH PHẦN:</strong> Trong 20ml có chứa:<br />Cao Chè dây 150mg, <br />Magnesium hydroxide 150mg, <br />Chiết xuất nghệ cấu trúc Micelle dạng lỏng sánh (Novasol Curcumin) (Bulk) (Nhập khẩu từ Đức) 100mg (Tương đương 6mg Curcuminnoids), <br />Bột Ô tặc cốt (Sepia esculenta) 100mg, <br />Mật ong (Mel) 100mg, <br />Chiết xuất Lá Tía tô (Perilla frutescens) 20mg, <br />Curcumin 95% (3 peak)(Nhập khẩu từ Ấn Độ) 20mg (Tương đương 19mg Curcuminnoids), <br />Immunepath-IP (PT) 5000mcg (Thành phần: Vách tế bào Lactobacillus paracasei; Maltodextrin), <br />Piperin (Chiết xuất từ hồ tiêu) 500mcg<br />Phụ liệu: Chất tạo ngọt tổng hợp (Sorbitol 70%), hương liệu tổng hợp (Hương dưa lưới, dâu, việt quất), chất bảo quản (Nipazil, kali sorbat), nước tinh khiết. (*) Tỷ lệ cao, chiết xuất/nguyên liệu: 1/10</p>\n<p><img src=\"https://salt.tikicdn.com/ts/tmp/a6/f5/dc/70e34149d2fa3bd8e6f4182688fd677d.png\" alt=\"\" width=\"750\" height=\"750\" /></p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/02/7b/66/5de6230929da79018b2dc22c41afcae6.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/02/7b/66/5de6230929da79018b2dc22c41afcae6.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/02/7b/66/5de6230929da79018b2dc22c41afcae6.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/02/7b/66/5de6230929da79018b2dc22c41afcae6.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/02/7b/66/5de6230929da79