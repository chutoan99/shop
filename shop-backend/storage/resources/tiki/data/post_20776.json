003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ac/02/8a/6c17923f0c6e333a650e8e0134cea74d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ac/02/8a/6c17923f0c6e333a650e8e0134cea74d.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ac/02/8a/6c17923f0c6e333a650e8e0134cea74d.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ac/02/8a/6c17923f0c6e333a650e8e0134cea74d.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ac/02/8a/6c17923f0c6e333a650e8e0134cea74d.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/ff/59/88/1910a7e94bba4adc28e38bb0e39f6833.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ff/59/88/1910a7e94bba4adc28e38bb0e39f6833.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ff/59/88/1910a7e94bba4adc28e38bb0e39f6833.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ff/59/88/1910a7e94bba4adc28e38bb0e39f6833.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ff/59/88/1910a7e94bba4adc28e38bb0e39f6833.jpg"}],"warranty_policy":null,"brand":{"id":601583,"name":"EAST","slug":"east"},"current_seller":{"id":107983,"sku":"6201694954203","name":"Đồ Dùng Khách Sạn Phúc Hòa","link":"https://tiki.vn/cua-hang/do-dung-khach-san-phuc-hoa","logo":"75/1c/f1/f3a7f514ea36d07eb7835dca285ab6ef.png","price":4345000,"product_id":"77117084","store_id":99971,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":