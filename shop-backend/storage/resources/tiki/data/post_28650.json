","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/e5/7d/78/da7423254ffccddd6481c56906462912.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":621,"all_time_quantity_sold":8,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch4\u003eSữa tắm tinh dầu Show Queen 500ml Cao cấp cho chó mèo Đúng như cái tên, đánh bật mọi sữa tắm về Độ thơm và Dưỡng lông ️\u003c/h4\u003e\n\u003cul\u003e\u003cli\u003eThành phần có chứa tinh dầu Marocco-argan giúp giải phóng hương thơm và lưu lại trên người thú cưng từ 7-10 ngày\u003c/li\u003e\n\u003cli\u003eTắm thôi mà cứ ngỡ xịt nước hoa\u003c/li\u003e\n\u003cli\u003eSữa tắm Show Queen là sản phẩm sữa tắm nước hoa cao cấp giúp cho thú cưng trở nên xinh đẹp và quyến rũ hơn. Thành phẩn có chứa tinh dầu Marocco-argan giúp chăm sóc bề mặt da và lông thú hiệu quả.\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eSữa tắm tinh dầu Show Queen 500ml chó 4 loại với các hương và tác dụng khác nhau:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eMàu Tím:\u003c/strong\u003e Dành cho lông trắng tác dụng sáng màu lông cho những dòng chó mèo sáng màu\u003c/li\u003e\n\u003cli\u003e\u003cspan\u003e\u003cstrong\u003eMàu Cam:\u003c/strong\u003e Dưỡng mượt lông dành cho những dòng chó mèo lông dài muốn có 1 bộ lông mềm mại óng ả \u003c/span\u003e\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eMàu Xanh Lá:\u003c/strong\u003e Bóng lông, tạo kiểu dành cho nhưng dòng chó lông xù, poodle muốn có bộ lông bồng bềnh\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eMàu Hồng:\u003c/strong\u003e Dành cho lông màu làm đậm màu lông cho những dòng chó lông đậm màu\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e\u003cem\u003eLà dòng sữa tắm nước hoa cao cấp giúp cho thú cưng trở nên xinh đẹp và quyến rũ hơn. Thành phẩn có chứa tinh dầu Marocco-argan để đạt hiệu quả chăm sóc thú cưng 1 cách chuyên nghiệp nhát. Sử dụng công nghệ tiên tiến có thể giải phóng hương thơm từ người thú cưng của bạn lâu dài và lưu lại hương thơm 7 – 10 ngày.\u003c/em\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTác dụng:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003ePhục hồi các tế bao da mới tối ưu,loại bỏ da chết,giúp duy trì da của thú cưng luôn khỏe mạnh.\u003c/li\u003e\n\u003cli\u003eỔn định, tăng cường sức đề kháng cho cún và phòng chống viêm nhiễm, giảm sung tấy trên da.\u003c/li\u003e\n\u003cli\u003eChăm sóc những phần lông bị hư tổn, đồng thời, phục hồi độ bóng sáng của bộ lông cún.\u003c/li\u003e\n\u003cli\u003eGiúp kích thích mọc lông, nuôi dưỡng lông một cách tự nhiên.\u003c/li\u003e\n\u003cli\u003eCông thức đặc biệt giúp lông sáng màu, giảm ố và bóng khoẻ.\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/83/96/fa/77eaf1f8eaaaca4fa619d3e89f97fa7b.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/87/1b/e8/8465019a7de96b9081be7c965170254e.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e\u003cp\u003eSản phẩm này là tài sản cá nhân được bán bởi Nhà Bán Hàng Cá Nhân và không thuộc đối tượng phải chịu thuế GTGT. Do đó hoá đơn VAT không được cung cấp trong trường hợp này.\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/e5/7d/78/da7423254ffccddd6481c56906462912.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e5/7d/78/da7423254ffccddd6481c56906462912.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e5/7d/78/da7423254ffccddd6481c56906462912.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e5/7d/78/da7423254ffccddd6481c56906462912.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e5/7d/78/da7423254ffccddd6481c56906462912.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/16/2b/af/207a6deff58c20400af4f5ba5abfe0dd.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/16/2b/af/207a6deff58c20400af4f5ba5abfe0dd.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/16/2b/af/207a6deff58c20400af4f5ba5abfe0dd.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/16/2b/af/207a6deff58c20400af4f5ba5abfe0dd.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/16/2b/af/207a6deff58c20400af4f5ba5abfe0dd.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/83/96/fa/db4f4c7395fe1d5f220418c576f193b4.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/83/96/fa/db4f4c7395fe1d5f220418c576f193b4.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/83/96/fa/db4f4c7395fe1d5f220418c576f193b4.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/83/96/fa/db4f4c7395fe1d5f220418c576f193b4.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/83/96/fa/db4f4c7395fe1d5f220418c576f193b4.jpg"},{"base_url":"