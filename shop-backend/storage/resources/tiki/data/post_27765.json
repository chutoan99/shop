con":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":70000,"discount_rate":25,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/40/a8/13/36403cbb5c7ba0ae6842bf436bc3eb6c.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":365,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eUnie US5200 là rổ quay rau ly tâm bằng nhựa ABS/PP giúp bạn nhanh chóng làm khô ráo thực phẩm không sợ bị dập nát, giữ rau củ quả luôn sạch và tươi lâu hơn.\u003c/p\u003e\n\u003cp\u003eDung tích 5,2L\u003c/p\u003e\n\u003cp\u003eVới dung tích lớn 5,2L, Unie US5200 đáp ứng tốt nhu cầu của gia đình lớn hoặc khi bạn muốn chế biến một lượng lớn rau củ quả một lúc. Ngoài qua rau, dụng cụ có thể dùng để trộn và chế biến Salad.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-llfuopinn3ygbd\" width=\"2000\" height=\"2000\" alt=\"vn-11134208-7r98o-llfuopinn3ygbd\" /\u003e\u003c/p\u003e\n\u003cp\u003eLàm khô thực phẩm nhanh chóng không bị dập nát\u003c/p\u003e\n\u003cp\u003eThiết kế thông minh quay vắt tiện lợi, rổ quay rau Unie US5200 giúp bạn dễ dàng làm ráo nước các loại rau củ quả và các loại thịt, cá,…sau khi rửa. Khi quay, lực ly tâm sẽ làm cho thực phẩm quay nhanh trong rổ, từ đó giúp đẩy nước ra ngoài chậu trong suốt và làm khô một cách hiệu quả. Do lực quay bằng tay nên dễ dàng kiểm soát tốc độ và lực quay cho từng loại thực phẩm đảm bảo không dập nát.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-llfuopinoiiwcd\" width=\"1200\" height=\"1200\" alt=\"vn-11134208-7r98o-llfuopinoiiwcd\" /\u003e\u003c/p\u003e\n\u003cp\u003eRổ trong suốt dễ quan sát mức độ ráo nước\u003c/p\u003e\n\u003cp\u003eChậu trong suốt của dụng cụ giúp bạn kiểm tra mức độ khô của thực phẩm một cách thuận tiện, đảm bảo rau củ quả đạt độ khô mong muốn.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-llfuopinpx3ce4\" width=\"1200\" height=\"1200\" alt=\"vn-11134208-7r98o-llfuopinpx3ce4\" /\u003e\u003c/p\u003e\n\u003cp\u003eThao tác đơn giản bằng tay \u003c/p\u003e\n\u003cp\u003eThao tác đơn giản bằng tay đơn giản dễ sử dụng cho phụ nữ, người già và trẻ nhỏ. Chỉ cần bỏ các loại rau củ quả vào rổ, đậy chặt nắp, sau đó cầm tay quay xoay theo chiều kim đầu hồ. Sau khi hoàn thành quá trình quay, bạn có thể lấy rau củ quả khô và sẵn sàng để sử dụng trong các món ăn.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-llfuopinrbns44\" width=\"1200\" height=\"1200\" alt=\"vn-11134208-7r98o-llfuopinrbns44\" /\u003e\u003c/p\u003e\n\u003cp\u003eChất liệu nhựa ABS/PP bền đẹp, an toàn tuyệt đối cho sức khỏe\u003c/p\u003e\n\u003cp\u003eDụng cụ được làm từ chất liệu nhựa ABS/PP cao cấp, đảm bảo độ bền đẹp trong suốt quá trình sử dụng. Chất liệu nhựa an toàn tuyệt đối cho sức khỏe, không gây độc hại hay tác động xấu đến thực phẩm, giúp cho bạn hoàn toàn yên tâm khi sử dụng.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-llfuopinsq88d0\" width=\"1200\" height=\"1200\" alt=\"vn-11134208-7r98o-llfuopinsq88d0\" /\u003e\u003c/p\u003e\n\u003cp\u003eThông số kỹ thuật\u003c/p\u003e\n\u003cp\u003e \u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-llfux37pwtl46a\" width=\"1200\" height=\"1200\" alt=\"vn-11134208-7r98o-llfux37pwtl46a\" /\u003e\u003c/p\u003e\n\u003cp\u003eKhối lượng tịnh: 0,637 kg\u003c/p\u003e\n\u003cp\u003eDung tích: 5,2L\u003c/p\u003e\n\u003cp\u003eChất liệu: PP+PS\u003c/p\u003e\n\u003cp\u003eKích thước: 24 x 24 x 18.5 cm\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eRổ quay rau ly tâm Unie US5200 là một lựa chọn hoàn hảo cho những ai muốn giữ nguyên chất lượng của thực phẩm, tiết kiệm thời gian và công sức trong việc quay và vắt rau, củ, quả và các loại thực phẩm khác. Với những ưu điểm vượt trội và thiết kế thông minh, sản phẩm hứa hẹn sẽ là người bạn đồng hành đáng tin cậy của bạn trong bếp!\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/40/a8/13/36403cbb5c7ba0ae6842bf436bc3eb6c.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/40/a8/13/36403cbb5c7ba0ae6842bf436bc3eb6c.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/40/a8/13/36403cbb5c7ba0ae6842bf436bc3eb6c.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/40/a8/13/36403cbb5c7ba0ae6842bf436bc3eb6c.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/40/a8/13/36403cbb5c7ba0ae6842bf436bc3eb6c.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/b7/90/b3/db53ec17fc486b43feaba8413475506b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b7/90/b3/db53ec1