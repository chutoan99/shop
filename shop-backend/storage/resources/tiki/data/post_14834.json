96ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/e7/c5/89/f225bd6f0b1c6a0a2d455fea6e9bbe41.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":838,"all_time_quantity_sold":12,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003ePhấn nền là sản phẩm không thể thiếu mang lại lớp trang điểm mịn mướt, tự nhiên và lâu trôi suốt ngày dài. Một bước hiệu chỉnh lớp nền hoàn hảo cuối cùng sau khi bạn sử dụng các sản phẩm kem nền, BB,… và tiêu chí hàng đầu cho 1 sản phẩm phấn nền chính là mang đến lớp nền mỏng mịn, không cakey, che phủ khuyết điểm tốt và lâu trôi suốt ngày dài. Xin giới thiệu với bạn Naris Ailus Lasting Smooth Powder Foundation – Phấn nền siêu mịn lâu trôi Ailus của thương hiệu mỹ phẩm hàng đầu Nhật Bản Naris Cosmetic chính là lựa chọn hàng đầu cho vẻ ngoài rạng rỡ, tự tin suốt ngày dài mà bạn đang tìm kiếm.\u003c/p\u003e\n\u003ch2\u003eThành phần chính\u003c/h2\u003e\n\u003cul\u003e\u003cli\u003eChiết xuất Hoa Hồng Centifolia giúp nuôi dưỡng da sáng hồng, dưỡng ẩm cao.\u003c/li\u003e\n\u003cli\u003eChiết xuất tinh dầu Jojoba dưỡng ẩm cao, kháng viêm, ngăn ngừa lão hóa.\u003c/li\u003e\n\u003cli\u003eChiết xuất vitamin từ các loại trái cây tự nhiên như Chanh, Cam, Táo,… giúp chống oxy hóa, dưỡng ẩm cao, điều tiết bã nhờn, ngăn ngừa lão hóa và bảo vệ da trước tác động của môi trường.\u003c/li\u003e\n\u003c/ul\u003e\u003ch2\u003eSản phẩm\u003c/h2\u003e\n\u003cp\u003ePhấn nền trang điểm siêu mịn lâu trôi Naris Ailus Lasting Smooth Powder Foundation giúp hiệu chỉnh lớp nền trở nên mịn mướt, tự nhiên, che phủ khuyết điểm tốt mà không gây hiện tượng cakey. Với các hạt phấn siêu mịn dạng cotton giúp thấm hút dầu thừa và mồ hôi tối ưu, mang đến hiệu quả chống oxy hóa và lâu trôi suốt ngày dài. Với các thành phần Vitamin từ các loại trái cây tự nhiên giúp cung cấp độ ẩm và ngăn ngừa lão hóa, mang đến cho bạn lớp nền siêu mịn, rạng rỡ lâu trôi suốt ngày dài\u003cbr /\u003eMã màu: có rất nhiều tông màu cho khách hàng lựa chọn\u003cbr /\u003e#140 : sắc trắng ánh hồng ( thích hợp với tông màu da thường, trắng xanh )\u003cbr /\u003e#530 : sắc trắng tự nhiên ( thích hợp với tông màu da thường, trung tính )\u003cbr /\u003e#730 : sắc trắng ánh vàng ( thích hợp làn da thiên dầu, xỉn màu, tông da ngăm )\u003cbr /\u003e\u003cem\u003eLoại da phù hợp:\u003c/em\u003e\u003cbr /\u003eSản phẩm thích hợp với mọi làn da\u003c/p\u003e\n\u003ch2\u003eCông dụng\u003c/h2\u003e\n\u003cul\u003e\u003cli\u003eChất phấn mềm mịn, hút dầu tối ưu\u003c/li\u003e\n\u003cli\u003eGiúp giữ lớp nền suốt nhiều giờ, chống oxy hóa và ngăn ngừa hiện tượng xỉn màu\u003c/li\u003e\n\u003cli\u003eHạt phấn mỏng mịn, bám bền, giữ ẩm tốt , không gây hiện tượng cakey\u003c/li\u003e\n\u003cli\u003eLàm đều màu da, che khuyết điểm trên da hiệu quả\u003c/li\u003e\n\u003cli\u003eĐộ che phủ tốt, có khả năng làm mờ lỗ chân lông cho làn da mềm mịn\u003c/li\u003e\n\u003c/ul\u003e\u003ch2\u003eBảo quản\u003c/h2\u003e\n\u003cp\u003eNơi khô ráo, thoáng mát.\u003cbr /\u003eTránh ánh nắng trực tiếp, nơi có nhiệt độ cao hoặc ẩm ướt.\u003cbr /\u003eĐậy nắp kín sau khi sử dụng.\u003cbr /\u003e\u003cstrong\u003eDung tích:\u003c/strong\u003e 10gr\u003cbr /\u003e\u003cstrong\u003eXuất xứ thương hiệu:\u003c/strong\u003e Nhật Bản\u003cbr /\u003e\u003cstrong\u003eSản xuất tại:\u003c/strong\u003e Nhật Bản\u003cbr /\u003e\u003cstrong\u003eThương hiệu:\u003c/strong\u003e Naris Cosmetic\u003c/p\u003e\n\u003ch2\u003eHướng dẫn sử dụng\u003c/h2\u003e\n\u003cp\u003eSau khi sử dụng kem nền ( hoặc kem chống nắng), lấy bông mút chấm 1 lượng phấn vừa đủ và thoa nhẹ nhàng trên bề mặt da. Có thể dặm lại nhiều lần trong ngày để lớp nền thêm rạng rỡ, bền màu.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/e7/c5/89/f225bd6f0b1c6a0a2d455fea6e9bbe41.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e7/c5/89/f225bd6f0b1c6a0a2d455fea6e9bbe41.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e7/c5/89/f225bd6f0b1c6a0a2d455fea6e9bbe41.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e7/c5/89/f225bd6f0b1c6a0a2d455fea6e9bbe41.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e7/c5/89/f225bd6f0b1c6a0a2d455fea6e9bbe41.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/7d/1b/d1/7bcf2165ca14d219ccc03e41333ee0c0.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/7d/1b/d1/7bcf2165ca14d219ccc03e41333ee0c0.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/7d/1b/d1/7bcf2165ca14d219ccc03e41333ee0c0.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7d/1b/d1/7bcf2165ca14d219ccc03e41333ee0c0.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7d/1b/d1/7bcf2165ca14d219ccc03e41333ee0c0.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/7d/1b/d1/2839daf5213a356705fff0a706f403c5.jpg","is_gallery":true,"label":null,"large_url":"https://salt.t