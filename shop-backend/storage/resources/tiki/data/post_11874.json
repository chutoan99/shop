":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":81000,"discount_rate":11,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/94/b4/9d/214479dabb1976fcc3e956c78e3a7027.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":309,"all_time_quantity_sold":4,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p class=\"irIKAp\"><strong>***Balo laptop Stargo Estanda: TỐI GIẢN VÀ NĂNG ĐỘNG***</strong></p>\n<p class=\"irIKAp\">Hướng đến giới trẻ hiện đại đầy năng động, cá tính, yêu thích phiêu lưu và khám phá những điều mới lạ,  chính thức giới thiệu dòng balo laptop Stargo Estanda hoàn toàn mới. Đây là dòng balo laptop sở hữu vẻ đẹp tối giản nhưng lại gây ấn tượng với kích thước nhỏ gọn, trọng lượng nhẹ cùng các ngăn chứa thông minh chắc chắn sẽ làm hài lòng chủ nhân sở hữu.</p>\n<p class=\"irIKAp\"><strong>1. THÔNG SỐ CỦA SẢN PHẨM</strong></p>\n<p class=\"irIKAp\">- Thương hiệu: Stargo</p>\n<p class=\"irIKAp\">- Màu sắc: Đen, Đỏ, Xanh Navy</p>\n<p class=\"irIKAp\">- Ngăn laptop: 15.6 inch</p>\n<p class=\"irIKAp\">- Chất liệu: 100% Vải Polyester độ bền cao</p>\n<p class=\"irIKAp\">- Trọng lượng: 0.8 kg</p>\n<p class=\"irIKAp\">- Kích thước (DxRxC): 28 x 13 x 41 cm</p>\n<p class=\"irIKAp\">- Tải trọng: 15 kg</p>\n<p class=\"irIKAp\">- Bảo hành: chính hãng 01 năm</p>\n<p class=\"irIKAp\"><strong>2. CHI TIẾT SẢN PHẨM</strong></p>\n<p class=\"irIKAp\">- Phong cách hiện đại, thiết kế cá tính, trẻ trung.</p>\n<p class=\"irIKAp\">- Chất liệu Polyester cao cấp bền bỉ, trượt nước, chống bám bụi và dễ dàng vệ sinh.</p>\n<p class=\"irIKAp\">- Ngăn laptop lên đến 15.6 inch với lớp lót chống sốc cao cấp.</p>\n<p class=\"irIKAp\">- Phân ngăn khoa học, ngăn chính rộng rãi, nhiều ngăn phụ tiện lợi.</p>\n<p class=\"irIKAp\">- Dây kéo trơn mượt, chống rạch, chống nước.</p>\n<p class=\"irIKAp\">- Dây đeo to bản, chống hằn, chống mỏi vai, linh hoạt điều chỉnh theo vóc dáng người dùng.</p>\n<p class=\"irIKAp\">- Vải lót 3 tính năng: Chống thấm, hút ẩm, kháng khuẩn.</p>\n<p class=\"irIKAp\"> </p>\n<p class=\"irIKAp\">Khi đơn giản lại là điều tốt nhất!</p>\n<p class=\"irIKAp\">- Stargo Estanda là một chiếc balo laptop theo đuổi phong cách hiện đại, thiết kế đơn giản nhưng mang tính ứng dụng cao và tiện ích đa dạng, cực kỳ phù hợp để trở thành bạn đồng hành của những tín đồ yêu chủ nghĩa tối giản trong mọi chuyến đi: Đi học, đi làm, đi du lịch,…</p>\n<p class=\"irIKAp\">- Chiếc balo có phom dáng cứng cáp cùng các đường nét mạnh mẽ phối hợp với gam màu xám đen viền đỏ đầy độc đáo, khéo léo giúp chủ nhân sở hữu thể hiện cá tính, tự tin vững bước trên hành trình khám phá thế giới, phát triển bản thân và chạm đến ước mơ trong tương lai.</p>\n<p class=\"irIKAp\">- Với chất liệu Polyester cao cấp, bền bỉ, trượt nước, chống bám bụi và dễ dàng vệ sinh, Stargo Estanda vừa bảo vệ hiệu quả đồ dùng bên trong dưới mọi thời tiết, vừa có độ bền dài lâu theo thời gian. Ngoài ra, Stargo Estanda được trang bị lớp vải lót với 3 tính năng nổi bật như chống thấm, hút ẩm và kháng khuẩn, từ đó giúp tăng cường sức mạnh bảo vệ bên ngoài lẫn bên trong.</p>\n<p class=\"irIKAp\"> </p>\n<div class=\"irIKAp\">\n<div>\n<div class=\"cxDtMn\"><img class=\"_0O7Vlf bgImIg\" src=\"https://down-vn.img.susercontent.com/file/vn-11134208-7qukw-ljo1qo727ees5d\" alt=\"vn-11134208-7qukw-ljo1qo727ees5d\" /></div>\n</div>\n</div>\n<p class=\"irIKAp\"> </p>\n<div class=\"irIKAp\">\n<div>\n<div class=\"cxDtMn\"><img class=\"_0O7Vlf bgImIg\" src=\"https://down-vn.img.susercontent.com/file/vn-11134208-7qukw-ljo1qo8g5dboab\" alt=\"vn-11134208-7qukw-ljo1qo8g5dboab\" /></div>\n</div>\n</div>\n<p class=\"irIKAp\"> </p>\n<p class=\"irIKAp\">Phân ngăn khoa học, tiện ích hiện đại</p>\n<p class=\"irIKAp\">- Để mở rộng không gian sử dụng và hỗ trợ người dùng có thể sắp xếp đồ dùng thuận tiện, ngăn nắp, balo laptop Stargo Estanda được phân bổ hệ thống ngăn chứa khoa học với ngăn chính rộng rãi và nhiều ngăn phụ có kích thước lớn nhỏ vô cùng tiện lợi.</p>\n<p class=\"irIKAp\">- Đặc biệt, để đáp ứng một cách an toàn và tối ưu nhất mọi nhu cầu dịch chuyển với các thiết bị điện tử hiện đại như laptop, tablet, Stargo Estanda sở hữu thiết kế ngăn chứa laptop lên đến 15.6 inch với lớp chống sốc chất lượng cao.</p>\n<p class=\"irIKAp\"> </p>\n<div class=\"irIKAp\">\n<div>\n<div class=\"cxDtMn\"><img class=\"_0O7Vlf bgImIg\" src=\"https://down-vn.img.susercontent.com/file/vn-11134208-7qukw-ljo1qo728sz840\" alt=\"vn-11134208-7qukw-ljo1qo728sz840\" /></div>\n</div>\n</div>\n<div class=\"irIKAp\">\n<div>\n<div class=\"cxDtMn\"><img class=\"_0O7Vlf bgImIg\" src=\"https://down-vn.img.susercontent.com/file/vn-11134208-7qukw-ljo1qo72a7jo5c\" alt=\"vn-11134208-7qukw-ljo1qo72a7jo5c\" /></div>\n</div>\n</div>\n<p class=\"irIKAp\"> </p>\n<p class=\"irIKAp\">Khám phá hành trình tuổi trẻ, tận hưởng chuyến đi nhẹ nhàng</p>\n<p class=\"irIKAp\">- Trong mỗi sản phẩm hành lý đều đạt những tiêu chuẩn nghiêm ngặt về mặt sức khỏe của người dùng, đặc biệt là các dòng balo, vì đây là sản phẩm có mật độ tiếp xúc trực tiếp với cơ thể con người nhiều nhất.</p>\n<p class=\"irIKAp\">- Chính vì vậy, Stargo Estanda được trang bị phần quai đeo và đệm lưng chất lượng cao để đảm bảo trải nghiệm hành trình của người dùng luôn được êm ái, thoải mái, bảo vệ cột sống và hạn chế nóng vai, lưng trong những ngày thời tiết nóng nực.</p>\n<p class=\"irIKAp\">- Quai đeo to bản, được trang bị đệm mút dày, chống hằn, chống đau vai khi đeo balo trong nhiều giờ, dây đeo dễ dàng được điều chỉnh kích thước để phù hợp với vóc dáng người dùng bởi tăng đơ tiện lợi. Kết hợp với phần đệm lưng có nhiều lỗ nhỏ li ti dạng lưới thoát khí, thoáng khí, chống nóng và chống thấm mồ hôi hiệu quả.</p>\n<p class=\"irIKAp\">- Stargo Estanda sẽ cùng bạn chinh phục những chặng đường mới, đạt đến những thành tựu mới trong tương lai. Hãy cứ tự tin theo đuổi đam mê của mình vì đã có Stargo Estanda – Chiếc balo laptop thời trang và cá tính, luôn ủng hộ, đồng hành và tiếp thêm sức mạnh vững chãi cho hành trình của bạn.</p>\n<p class=\"irIKAp\"> </p>\n<div class=\"irIKAp\">\n<div>\n<div class=\"cxDtMn\"><img class=\"_0O7Vlf bgImIg\" src=\"https://down-vn.img.susercontent.com/file/vn-11134208-7qukw-ljo1qo72bm44a1\" alt=\"vn-11134208-7qukw-ljo1qo72bm44a1\" /></div>\n</div>\n</div>\n<div class=\"irIKAp\">\n<div>\n<div class=\"cxDtMn\"><img class=\"_0O7Vlf bgImIg\" src=\"https://down-vn.img.susercontent.com/file/vn-11134208-7qukw-ljo1qo72d0okde\" alt=\"vn-11134208-7qukw-ljo1qo72d0okde\" /></div>\n</div>\n</div>\n<p class=\"irIKAp\"><strong>3. CAM KẾT VỚI KHÁCH HÀNG</strong></p>\n<p class=\"irIKAp\">- 1 ĐỔI 1 trong vòng 07 ngày sản phẩm bị lỗi do nhà sản xuất (nhắn tin cho Shop để được hỗ trợ nhanh nhất).</p>\n<p class=\"irIKAp\">- BẢO HÀNH chính hãng theo chính sách </p>\n<p class=\"irIKAp\"><strong>4. DỊCH VỤ </strong></p>\n<p class=\"irIKAp\">- Các sản phẩm  khi giao đến tay khách hàng thân yêu &lt;3 đều được kèm theo Phiếu Bảo Hành chính hãng </p>\n<p class=\"irIKAp\">- Gói hàng cẩn thận trước khi giao cho khách.</p>\n<p class=\"irIKAp\"> Hỗ trợ tư vấn chăm sóc khách hàng 24/7 </p>\n<p class=\"irIKAp\"><strong>___KHÁCH HÀNG B2B - QUÀ TẶNG DOANH NGHIỆP VUI LÒNG NHẮN TIN CHO SHOP ĐỂ ĐƯỢC HỖ TRỢ MỨC TỐT NHẤT___</strong></p><p>Giá sản phẩm trên Tiki 