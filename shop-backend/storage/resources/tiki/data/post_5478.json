"#FFF0F1","background_color":"#D93843","href":null,"text":"9.9"},{"placement":"pdp_badge","code":"is_hero","type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":true,"return_reason":"any_reason"}},"discount":10000,"discount_rate":4,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/50/27/64/3788dad2c1465615d055b7fa04d4db7f.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":50,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eThông tin sản phẩm\u003c/p\u003e\n\u003cp\u003eSữa Dừa Hoàng Kim ( Fresh coconut milk with salted egg yolk )\u003c/p\u003e\n\u003cp\u003eThành phần: Dừa (60%), lòng đỏ trứng muối (10%), sữa (8%), đường, đường ăn kiêng, đường tảo biển, bột mì, mạch nha, dầu, muối, chất bảo quản (INS 202).\u003c/p\u003e\n\u003cp\u003eKhối lương: 150g (1 trứng)\u003c/p\u003e\n\u003cp\u003eKhoai Môn Sữa Hoàng Gia ( Royal Taro with salted egg yolk )\u003c/p\u003e\n\u003cp\u003eThành phần: Khoai môn (50%), lòng đỏ trứng muối (10%), sữa (8%), đường, đường ăn kiêng, đường tảo biển, bột mì, mạch nha, dầu, muối, chất bảo quản (INS 202).\u003c/p\u003e\n\u003cp\u003eKhối lương: 150g (1 trứng)\u003c/p\u003e\n\u003cp\u003eTrà Ô long tứ quý mộc hoa (Four Seasons Oolong Tea)\u003c/p\u003e\n\u003cp\u003eThành phần: Búp trà ô long 98%. Quế hoa 2%. Ướp sấy tự nhiên. Không hương liệu. Không chất bảo quản.\u003c/p\u003e\n\u003cp\u003eKhối lương: 30g\u003c/p\u003e\n\u003cp\u003eTặng thiệp chúc mừng” Mở thức quà ngon- đón thu trọn lành”, bộ dao cắt bánh\u003c/p\u003e\n\u003cp\u003eLý do chọn bánh trung thu Nonglamfood:\u003c/p\u003e\n\u003cp\u003e​ Nhân bánh cao cấp thượng hạng với Vi cá mập (Dành cho vua chúa); Yến tươi (sản vật biển quý giá); Đông trùng hạ thảo (Dược liệu quý hiếm); saffron (vàng đỏ Trung Đông); hồng sâm (thần dược Hàn Quốc), Trà xanh matcha (tinh hoa Nhật Bản).\u003c/p\u003e\n\u003cp\u003e​ Được phối trộn tỉ mỉ tinh tế từ nghệ nhân bánh Trung thu với hơn 30 năm kinh nghiệm cho vị đậm đà truyền thống theo thời gian.\u003c/p\u003e\n\u003cp\u003e​ Hơn 30 vị bánh tươi mới, ít ngọt có sử dụng đường ăn kiêng isomalt vì sức khỏe người tiêu dùng (bánh được sản xuất tươi mới theo đơn đặt hàng không sản xuất sẵn trữ đông nhờ đó mang đến sự tươi ngon và thanh thuần cho từng chiếc bánh )\u003c/p\u003e\n\u003cp\u003e​ Quy trình khép kín và chuẩn-chỉnh-từng-bước theo ISO 22000:2018, HACCP từ khâu chọn nguyên liệu, sơ chế, sản xuất và đóng gói.\u003c/p\u003e\n\u003cp\u003e​ Hơn 20 mẫu hộp thiết kế độc đáo, sang trọng, tinh tế mang câu chuyện và dấu ấn riêng.\u003c/p\u003e\n\u003cp\u003e Dịch vụ cá nhân hóa thể hiện tính độc bản của thương hiệu doanh nghiệp\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eHướng dẫn sử dụng:\u003c/p\u003e\n\u003cp\u003e️ Đối với bánh trung thu Nonglamfood, bánh tươi có thời hạn sử dụng trong vòng 35 ngày, nhà sản xuất khuyến khích khách hàng sử dụng bánh ngay khi mở bao bì và trong thời gian cho phép của bánh.\u003c/p\u003e\n\u003cp\u003e️ Nếu chưa dùng hết, đặt sản phẩm trong hộp nhựa vào ngăn mát tủ lạnh để giữ bánh không bị khô.\u003c/p\u003e\n\u003cp\u003e️ Khách hàng mang bánh về nếu chưa ăn ngay nên bỏ bánh trong tủ lạnh (ngăn mát) cho bánh tươi, giữ giá trị dinh dưỡng tốt hơn.\u003c/p\u003e\n\u003cp\u003e️ Bánh sử dụng ngon nhất trong vòng 15-25 ngày kể từ ngày sản xuất.\u003c/p\u003e\n\u003cp\u003e️ Trong mỗi gói bánh có 1 gói hút ẩm không ăn được.\u003c/p\u003e\n\u003cp\u003e️ Rửa tay thật sạch trước khi tiến hành cắt, chia bánh và thưởng thức bánh.\u003c/p\u003e\n\u003cp\u003e️ Vỏ bánh nướng mới ra lò sẽ giòn giòn, sau 3 ngày ra lò bỏ bánh sẽ hòa quyện cùng với nhân bánh đạt hương vị đặc trưng thơm ngon. \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eHướng dẫn bảo quản: \u003c/p\u003e\n\u003cp\u003e️ Bánh tươi mới cần bảo quản ở nhiệt độ ổn định, tránh sốc nhiệt khi di chuyển từ nơi này sang nơi khác sẽ ảnh hưởng đến bánh.\u003c/p\u003e\n\u003cp\u003e️ Bảo quản nơi thoáng mát, tránh nơi lạnh hoặc ánh nắng chiếu trực tiếp sản phẩm, tránh những nơi ẩm ướt.\u003c/p\u003e\n\u003cp\u003e️ Che đậy cẩn thận tránh để nơi có côn trùng. \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lxtgysxvxvq339\" width=\"2560\" height=\"1284\" alt=\"vn-11134208-7r98o-lxtgysxvxvq339\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/50/27/64/3788dad2c1465615d055b7fa04d4db7f.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/50/27/64/3788dad2c1465615d0