lor":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.5,"review_count":5,"review_text":"(5)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/fd/21/ec/3a7720c6b2ec9b1f8f64d487b5ebfd92.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1505,"all_time_quantity_sold":30,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<h1><strong>Giới thiệu Keo dán giày, gỗ, nhựa đa năng siêu dính 3M Scotch AD113</strong></h1>\n<p>Nhờ những đặc tính siêu dính, siêu chắc, khô nhanh nên <em><strong>Keo dán giày, gỗ, nhựa đa năng siêu dính 3M Scotch AD113</strong></em> thường dùng dán đồ thể thao (giày, dép), dụng cụ thể thao và vật dụng gia đình, Với đặc tính trên <em><strong>Keo dán giày, gỗ, nhựa đa năng siêu dính 3M Scotch AD113</strong></em> có thể sử dụng được cho các bề mặt khó dính như gỗ, kim loại, gốm sứ, cao su,…<img src=\"https://salt.tikicdn.com/cache/w750/ts/product/17/5e/20/f28eb8daf475a18039524300cc92cbe6.jpg?v=1569835601415\" data-thumb=\"original\" /><br /><strong>Thông tin sản phẩm</strong></p>\n<ul>\n<li>Tên sản phẩm: <em><strong>Keo dán giày, gỗ, nhựa đa năng siêu dính 3M Scotch AD113</strong></em></li>\n<li>Mã hàng: <strong>AD113</strong></li>\n<li>Công dụng: Dán các vật dụng lại với nhau.</li>\n<li><strong>Xuất xứ: Đài Loan </strong></li>\n<li>Màu sắc: trong suốt</li>\n<li>Trọng lượng: 2g</li>\n</ul>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/36/34/64/df335996b87e54bea4075bde3fd384f7.jpg?v=1569835613746\" data-thumb=\"original\" /></p>\n<h2><strong>Thông tin nổi bật</strong></h2>\n<ul>\n<li>Siêu dính, siêu bền với lực dính cao, keo dính kết dính chắc chắn</li>\n<li>Keo trong suốt, tạo tính thẩm mỹ cao</li>\n<li>Keo có khả năng chịu lực cao</li>\n<li>Keo dạng loãng, mau khô, dễ dàng sử dụng, dễ phủ bề mặt, dẻo khi kết dính</li>\n<li>An toàn khi sử dụng</li>\n<li>Đặc biệt KHÔNG hóa trắng, cháy, khô, cứng như keo thông thường</li>\n<li>Thiết kế đầu nhọn, giúp dễ dàng sử dụng và nhỏ keo chính xác vị trí.</li>\n<li>Dán tốt hầu hết các vật dụng cần thiết trong gia đình như giày, dép, tủ nhựa, kim loại, cao su, gỗ, da, đồ gốm, thủy tinh, trang sứ</li>\n</ul>\n<p><img src=\"https://salt.tikicdn.com/ts/product/3b/79/23/82abfe4feb6960418ee9c947cb2f640f.jpg?v=1569836647355\" data-thumb=\"original\" /></p>\n<h2><strong>Cách bảo quản</strong></h2>\n<p>Tránh ánh nắng trực tiếp, đậy nắp sau khi sử dụng để bảo quản sản phẩm được lâu.</p>\n<h2><strong>Cách sử dụng</strong></h2>\n<p>Sử dụng đơn giản như keo dán sắt thông thường, bề mặt cần dán cần sạch và khô.</p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/fd/21/ec/3a7720c6b2ec9b1f8f64d487b5ebfd92.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/fd/21/ec/3a7720c6b2ec9b1f8f64d487b5ebfd92.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/fd/21/ec/3a7720c6b2ec9b1f8f64d487b5ebfd92.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fd/21/ec/3a7720c6b2ec9b1f8f64d487b5ebfd92.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fd/21/ec/3a7720c6b2ec9b1f8f64d487b5ebfd92.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/01/84/9f/df8660fb0acd4639057ca30ac4a963d1.jpg","is_ga