\" width=\"750\" height=\"330\" /\u003e\u003c/p\u003e\n\u003cp\u003e#sách #sach #sachnhanam #nhanam\u003c/p\u003e\n\u003cp\u003e#HigashinoKeigo #keigo #vanhoc #nhatban #trinhtham #hot\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/1e/55/dc/3aed61f45235b54d54f694f79e5a2079.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/1e/55/dc/3aed61f45235b54d54f694f79e5a2079.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/1e/55/dc/3aed61f45235b54d54f694f79e5a2079.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1e/55/dc/3aed61f45235b54d54f694f79e5a2079.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1e/55/dc/3aed61f45235b54d54f694f79e5a2079.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/cd/c0/35/88633bd1ce6e293923203b0db9abf222.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/cd/c0/35/88633bd1ce6e293923203b0db9abf222.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/cd/c0/35/88633bd1ce6e293923203b0db9abf222.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/cd/c0/35/88633bd1ce6e293923203b0db9abf222.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/cd/c0/35/88633bd1ce6e293923203b0db9abf222.jpg"}],"warranty_policy":null,"authors":[{"id":4406,"name":"Higashino Keigo","slug":"higashino-keigo"}],"current_seller":{"id":7734,"sku":"7611960950339","name":"NHBook","link":"https://tiki.vn/cua-hang/nhbook","logo":"49/49/f3/973a1913dac7a3cbaa379403203cb8b7.jpg","price":113100,"product_id":"275066641","