null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":29800,"discount_rate":20,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/99/34/19/89029241cdc8fd4de659aa839bbf4f44.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":603,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eƯU ĐIỂM NỔI BẬT:\u003cbr /\u003e- Sử dụng pin Lithium cao cấp nhất hiện nay, kích thước nhỏ, dung lượng lớn: 2000 mAh. \u003cbr /\u003e- Sản phẩm có thể sử dụng được dưới Mưa\u003cbr /\u003e- Sản phẩm có tặng kèm bộ sạc tiện dụng, dùng để sạc cho sản phẩm khi sản phẩm sắp cạn pin.\u003cbr /\u003e- Dây đeo có thể điều chỉnh kích thước theo nhu cầu sử dụng\u003cbr /\u003e- Bóng led 2W công suất cao, áp dụng công nghệ led SMD mới, siêu sáng\u003cbr /\u003e- Đặc biệt: Sản phẩm có tặng kèm chụp đèn rời, giúp đổi màu ánh sáng của đèn từ TRẮNG sang VÀNG =\u0026gt; Chỉ cần sở hữu duy nhất sản phẩm này, bạn có thể sử dụng cả 2 loại ánh sáng trắng, hoặc vàng, tuỳ vào nhu cầu sử dụng\u003cbr /\u003e- Có 2 chế độ chiếu sáng: Cốt và Pha, giúp bạn điều chỉnh cường độ chiếu sáng, phạm vi chiếu sáng phù hợp nhất với mục đích sử dụng\u003cbr /\u003e- Có thể điều chỉnh góc chiếu cho đèn, giúp bạn điều chỉnh góc chiếu sáng theo nhu cầu sử dụng.\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/44/7e/2c/45cf5bd93271e8debbf13443df7a87e2.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003e\u003cbr /\u003eTHÔNG SỐ KỸ THUẬT:\u003cbr /\u003e- Công suất 2W (sử dụng bóng Led công suất cao)\u003cbr /\u003e- Sử dụng pin Lithium cao cấp , kích thước nhỏ , dung lượng lớn 2000mAh\u003cbr /\u003e- Thời gian chiếu sáng: \u003cbr /\u003e+ Có thể lên đến 6 giờ liên tục với mức ánh sáng mạnh \u003cbr /\u003e+ Có thể lên đến 12 giờ liên tục với mức ánh sáng thấp \u003cbr /\u003e- Pin siêu bền , chu kỳ nạp xả có thể lên đến 1000 lần.\u003cbr /\u003e- Sử dụng Công nghệ mạch bảo vệ quá sạc , bảo vệ pin hiệu quả.\u003cbr /\u003e- Thời gian sạc: Từ 8 giờ đến 10 giờ\u003cbr /\u003e- Kích thước sản phẩm: 73 x 65 x 53 (mm)\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/12/54/9e/6744db21fb54d54ab36adbda228a0c57.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e\u003cbr /\u003e\u003cbr /\u003eHƯỚNG DẪN SỬ DỤNG:\u003cbr /\u003e* Sạc pin cho sản phẩm:\u003cbr /\u003e- Cắm bộ sạc đi kèm theo sản phẩm vào ổ cắm điện nguồn (AC 220V - 50Hz), đèn Led trên bộ sạc sẽ báo sạc với sáng màu xanh.\u003cbr /\u003e- Cắm đầu sạc DC của bộ sạc, vào cổng sạc trên sản phẩm, đèn báo sạc của bộ sạc sẽ chuyển sang ánh sáng màu đỏ.\u003cbr /\u003e- Khi pin được sạc đầy, đèn báo sạc của bộ sạc sẽ chuyển sang màu xanh =\u0026gt; Hãy rút đầu sạc DC ra khỏi sản phẩm, và, Rút bộ sạc ra khỏi ổ cắm điện.\u003cbr /\u003e* Sử dụng sản phẩm:\u003cbr /\u003e- Nhấn nút nguồn màu vàng lần đầu là bật ánh sáng mạnh\u003cbr /\u003e- Nhấn lần thứ hai là sử dụng ánh sáng yếu \u003cbr /\u003e- Nhấn lần thứ ba là tắt.\u003cbr /\u003e- Vui lòng sạc đầy pin cho sản phẩm khi sử dụng lần đầu tiên\u003cbr /\u003e- Vui lòng sạc lại pin khi luồng ánh sáng bị yếu đi, KHÔNG NÊN sử dụng đến hết pin mới sạc, để bảo vệ độ bền của pin sạc\u003cbr /\u003e- Sử dụng bộ sạc đi theo sản phẩm, không sử dụng các bộ sạc không phù hợp.\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/1a/c3/0d/e21c8458b066dda6075e7aa97bbe9a52.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e\u003cbr /\u003e\u003cbr /\u003eXin vui lòng LƯU Ý KỸ nguyên lý kỹ thuật của sản phẩm sử dụng pin sạc:\u003cbr /\u003ePin sạc trong sản phẩm sẽ HỎNG, hoặc không còn lưu điện tốt, NẾU sản phẩm không được sạc điện trong suốt thời gian 02 tháng (trường hợp sản phẩm còn mới 100%, chưa sử dụng, cũng phải được cắm điện sạc lại Pin định kỳ 2 tháng/ 1 lần để bảo vệ pin sạc)\u003cbr /\u003eVui lòng nhớ cắm điện sạc lại pin cho sản phẩm ít nhất 2 tháng/ một lần để bảo vệ pin sạc.\u003cbr /\u003eKhông sử dụng sản phẩm khi đang cắm sạc để bảo vệ pin sạc\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/f6/8b/24/d27f5c265f7dac2a7c1166cf72a1f7f4.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/a8/1c/bd/e0bc9a9572af123263346d8055b5d8b5.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/f7/86/c7/cf45f0bf8c15fd3a662be39a278a965d.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/12/dc/ca/765f77b2906629c5dd600f0b0e9059e5.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/d8/9b/22/eed2eb1ac2a7fd83c7b7