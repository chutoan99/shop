4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":57000,"discount_rate":19,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/43/68/4e/47cad053a2533ef38356b48a3dbf2300.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":27,"all_time_quantity_sold":3,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eTác phẩm: \u003cstrong\u003e“DIGITAL MARKETING DÀNH CHO NGƯỜI MỚI” \u003c/strong\u003e(Digital marketing quickstart guide)\u003cbr /\u003eTác giả: \u003cstrong\u003eBenjamin Sweeney\u003c/strong\u003e\u003cbr /\u003eNgười dịch: Hoàng Huấn\u003cbr /\u003e\u003cstrong\u003ePACE BOOKs phát hành | NXB Tổng Hợp TP.HCM\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cstrong\u003eDIGITAL MARKETING DÀNH CHO NGƯỜI MỚI\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cstrong\u003eDigital marketing quickstart guide\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cem\u003eHướng dẫn đơn giản cho người mới bắt đầu\u003c/em\u003e\u003cem\u003e\u003cbr /\u003eđể phát triển chiến lược digital marketing nhằm\u003cbr /\u003emở rộng khách hàng và gia tăng lợi nhuận\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eTương lai của sự phát triển kinh doanh là Digital. Bạn đã sẵn sàng chưa?\u003c/p\u003e\n\u003cp\u003eTrong kỷ nguyên kỹ thuật số, việc nắm vững Digital Marketing là chìa khóa để đạt được sự phát triển và thành công bền vững. Giờ đây, chiến lược Digital marketing là chìa khóa cho các thương hiệu mới nổi, các doanh nhân mới và kỳ cựu, cũng như các doanh nghiệp thuộc mọi quy mô để chuyển đổi khách hàng trong không gian kỹ thuật số.\u003c/p\u003e\n\u003cp\u003eVới các hình thức quảng cáo tiết kiệm chi phí, tiếp thị nội dung, tiếp thị truyền thông xã hội, tiếp thị qua email và nhiều hơn nữa, chưa bao giờ có thời điểm nào tốt hơn để kết nối với khách hàng của bạn và phát triển doanh nghiệp của bạn.\u003c/p\u003e\n\u003cp\u003eTrong cuốn sách “Digital marketing dành cho người mới”, tác giả và nhà tiếp thị kỳ cựu Benjamin Sweeney đã chắt lọc kinh nghiệm tiếp thị hơn một thập kỷ của mình để đưa vào khóa học cấp tốc bao hàm mọi vấn đề từ marketing căn bản tới chiến lược digital marketing phức tạp.\u003c/p\u003e\n\u003cp\u003eĐây là một cuốn sách hoàn hảo cho:\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eCác doanh nhân muốn kiểm soát hoạt động tiếp thị và phát triển hoạt động kinh doanh của mình;\u003c/li\u003e\n\u003cli\u003eNhững người làm việc tự do muốn đa dạng hóa các dịch vụ;\u003c/li\u003e\n\u003cli\u003eSinh viên ngành kinh doanh và marketing cần nâng cao lợi thế của mình trên thị trường lao động;\u003c/li\u003e\n\u003cli\u003eNhững người có ảnh hưởng, nghệ sĩ, người sáng tạo nội dung và bất kỳ ai cần bán hàng hoặc kết nối với nhiều người hơn trong không gian kỹ thuật số.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eCuốn sách sẽ giúp bạn nắm vững các nội dung như:\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eNhững nguyên tắc cơ bản về tiếp thị hiện đại: Cách các nguyên tắc tiếp thị cổ điển có thể được tái sử dụng cho không gian kỹ thuật số;\u003c/li\u003e\n\u003cli\u003eXây dựng bộ công cụ tiếp thị kỹ thuật số của riêng bạn: Chính xác cách các công cụ tiếp thị kỹ thuật số hoạt động và cách sử dụng chúng;\u003c/li\u003e\n\u003cli\u003eTiếp thị kỹ thuật số trong thực tế: Cách tổ chức và thực hiện các chiến dịch tiếp cận và chuyển đổi quy mô lớn;\u003c/li\u003e\n\u003cli\u003eThiết kế chiến lược kỹ thuật số: Cách cấu trúc chiến lược tiếp thị kỹ thuật số của bạn để tiết kiệm tiền và đạt được kết quả;\u003c/li\u003e\n\u003cli\u003eCác khái niệm cốt lõi về tiếp thị kỹ thuật số: Sử dụng mạng xã hội, email, quảng cáo tiết kiệm chi phí, làm chủ SEO và nhiều hơn nữa.\u003c/li\u003e\n\u003cli\u003eĐặc biệt, cuốn sách còn đi kèm với quyền truy cập miễn phí suốt đời đến các tài nguyên như hướng dẫn SEO hoàn chỉnh, bản vẽ thành công của Copywriting, và bộ công cụ tiếp thị kỹ thuật số.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eTóm lại, “Digital marketing dành cho người mới” sẽ trang bị cho bạn các kỹ năng và chiến lược cần thiết để tiếp cận và chuyển đổi khách hàng trong không gian kỹ thuật số, giúp bạn phát triển doanh nghiệp hiệu quả.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/c9/55/97/4f53e5c47ab91aac1e46f5309c4b41ad.jpg\" alt=\"\" width=\"750\" height=\"632\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/43/68/4e/47cad053a2533ef38356b48a3dbf2300.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/43/68/4e/47cad053a2533ef38356b48a3dbf2300.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/43/68/4e/47cad053a2533ef38356b48a3dbf2300.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/43/68/4e/47cad053a2533ef38356b48a3dbf2300.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x