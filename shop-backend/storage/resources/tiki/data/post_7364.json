tra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/8c/65/d1/991732255308e6e0f433002ad22e38ec.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1782,"all_time_quantity_sold":4,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: center;\"\u003e\u003cstrong\u003eVừa qua \u003c/strong\u003e\u003cstrong\u003eProSing đã cho ra mắt mẫu loa di động mới W-15 SUPER\u003c/strong\u003e.\u003c/p\u003e\n\u003cp class=\"has-medium-font-size\"\u003eLà mẫu loa được xem là cao cấp nhất trong dòng loa 4 tấc của ProSing, W-15 Super sở hữu công suất siêu mạnh lên đến 8000W. Ngoài ra không chỉ chú trọng vào sức mạnh, W-15 Super còn được trau chuốt kĩ lưỡng về mặt âm thanh khi được áp dụng những cải tiến kĩ thuật mới giúp mang lại âm thanh trong trẻo, không bị đục đồng thời vẫn thể hiện chính xác giọng của người hát.   \u003c/p\u003e\n\u003cp class=\"has-medium-font-size\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/47/c4/8b/d55af7a31d6a9b250e9533d5be075898.png\" alt=\"\" width=\"750\" height=\"1122\" /\u003e\u003c/p\u003e\n\u003cp class=\"has-medium-font-size\"\u003e\u003cimg class=\"wp-image-9981 aligncenter\" src=\"https://salt.tikicdn.com/ts/product/fe/8b/a7/41f9342c2ce9f8af07f63ba16100d47f.jpg\" sizes=\"(max-width: 449px) 100vw, 449px\" srcset=\"https://salt.tikicdn.com/ts/product/fe/8b/a7/3cf03cda652cf8f0f7e1a08350948ef3.jpg 176w, https://salt.tikicdn.com/ts/product/00/9a/d5/c9662ce866730a6d132e7357937d8a2a.jpg 600w\" alt=\"\" width=\"449\" height=\"765\" /\u003eNếu như những phiên bản khác của seri W-15 thường chỉ phù hợp trong không gian gia đình hoặc sân vườn, khi đem tới những không gian rộng như bãi biển hay những nơi đông người thì không thể hiện hết được khả năng của mình thì với loa W-15 Super đây lại là một điều đơn giản. Do được thiết kế với sức mạnh không thua gì những dòng loa lớn 5 tấc và 4 tấc đôi, cả về chất âm lẫn khả năng xử lý giọng hát đều không hề thua kém, W-15Super hứa hẹn sẽ là phiên bản thu nhỏ của W-18A.\u003c/p\u003e\n\u003cp class=\"has-medium-font-size\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/00/9a/d5/f144803f9887e18f95a481babece04d9.jpg\" alt=\"\" width=\"600\" height=\"1024\" /\u003e\u003c/p\u003e\n\u003cp class=\"has-medium-font-size\"\u003eNếu như lúc trước bạn phải thật khó khăn để lựa chọn giữa dòng loa 4 tấc nhỏ gọn với những loa 5 tấc tuy cồng kềnh nhưng lại có công suất khủng .Thì nay bạn hoàn toàn có thể sở hữu cả 2 điều đó trong chỉ 1 chiếc loa W-15 Super .\u003cimg class=\"wp-image-6724\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/fa/83/3c/8cf1747317967f3fbc99570a1016fcf4.jpg\" sizes=\"(max-width: 860px) 100vw, 860px\" srcset=\"https://salt.tikicdn.com/cache/w750/ts/product/fa/83/3c/8cf1747317967f3fbc99570a1016fcf4.jpg 860w, https://salt.tikicdn.com/ts/product/d8/e5/03/7171b115a910ff24903ddc269372b497.jpg 252w, https://salt.tikicdn.com/cache/w750/ts/product/8f/0e/68/a45934882764080cd94477ac7ac013db.jpg 768w, https://salt.tikicdn.com/ts/product/06/63/17/a45e37e0ac79b249a90a64b1f2eedc20.jpg 600w\" alt=\"\" data-id=\"6724\" data-link=\"http://prosing.com.vn/?attachment_id=6724\" /\u003e\u003c/p\u003e\n\u003cp class=\"has-medium-font-size\"\u003eKhông chỉ được chú trọng vào khả năng âm thanh, W-15Super còn gây ấn tượng nhờ vẻ ngoài cực kì sang trọng. Không còn được bo cong các góc như những mẫu W-15 khác, W-15 Super được thiết kế vuông vức, góc cạnh nhằm mang lại vẻ mạnh mẽ mà sang trọng. Mặt lưới với 2 phiên bản xám hoặc vàng được làm 1 cách tỉ mỉ với từng chi tiết hoàn toàn có thể tôn lên nét đẹp cho căn phòng nhà bạn \u003c/p\u003e\n\u003cp class=\"has-text-color has-medium-font-size has-luminous-vivid-orange-color\"\u003eVới tất cả những ưu điểm kể trên, bạn còn chần chừ gì nữa mà không liên hệ ngay với ProSing để có thể sở hữu cho mình mẫu loa mới nhất và hay nhất của Seri W-15 đi nào .\u003c/p\u003e\n\u003cp class=\"has-text-color has-medium-font-size has-luminous-vivid-orange-color\"\u003eLoa Thùng gỗ 8000 W\u003cbr /\u003eBass 4 tấc- từ 190-coil 75, Treble 450\u003cbr /\u003eBình 14A\u003cbr /\u003e2 Micro UHF chỉnh tần số\u003cbr /\u003eKích thước : 612x570x915 (W-L-H) .\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/8c/65/d1/991732255308e6e0f433002ad22e38ec.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/8c/65/d1/991732255308e6e0f433002ad22e38ec.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/8c/65/d1/991732255308e6e0f433002ad22e38ec.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8c/65/d1/991732255308e6e0f433002ad22e38ec.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8c/65/d1/991732255308e6e0f433002ad22e38ec.png"},{"base_url":"https://salt.tikicdn.com/ts/product/22/35/fb/58e43003fdd2cadb26d7530a54410542.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/22/35/fb/58e43003fdd2cadb26d7530a54410542.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/22/35/fb/58e43003fdd2cad