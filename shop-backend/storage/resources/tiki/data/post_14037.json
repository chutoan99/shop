count":350000,"discount_rate":44,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ab/77/c7/4269eb3dc7057ac069353e948cf94e37.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":106,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eTúi Xách Nữ Thời Trang JUNO Cỡ Nhỏ Top Handle Logo Chữ Kí TXN812\u003c/p\u003e\n\u003cp\u003eMã sản phẩm: TXN812\u003c/p\u003e\n\u003cp\u003eMàu sắc: Kem-Xanh-Đen\u003c/p\u003e\n\u003cp\u003eKiểu dáng: Túi xách thời trang\u003c/p\u003e\n\u003cp\u003eChất liệu: Da tổng hợp\u003c/p\u003e\n\u003cp\u003eXuất xứ: Trung Quốc\u003c/p\u003e\n\u003cp\u003eKích cỡ: 18cmx15cmx6cm\u003c/p\u003e\n\u003cp\u003eGiá đã bao gồm VAT\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eTúi Xách Nhỏ Top Handle Logo Chữ Kí trẻ trung, phá cách\u003c/p\u003e\n\u003cp\u003eLogo chữ kí kim loại trang trí nổi bật\u003c/p\u003e\n\u003cp\u003eCó thể kết hợp với dây đeo thay đổi mục đích sử dụng\u003c/p\u003e\n\u003cp\u003eKhoá kéo kim loại mượt mà, chắc chắn\u003c/p\u003e\n\u003cp\u003eForm dáng túi xinh xắn, độc đáo\u003c/p\u003e\n\u003cp\u003eSản phẩm phù hợp với đa dạng phong cách và mục đích sử dụng\u003c/p\u003e\n\u003cp\u003eCó 03 phối màu cá tính giúp nàng thêm sự lựa chọn\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/sg-11134202-7rd57-lvsu87ge7qspb7\" width=\"700\" height=\"700\" alt=\"sg-11134202-7rd57-lvsu87ge7qspb7\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lvttxprho6ahc4\" width=\"900\" height=\"1133\" alt=\"vn-11134208-7r98o-lvttxprho6ahc4\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lvttxprhsdzt69\" width=\"900\" height=\"1133\" alt=\"vn-11134208-7r98o-lvttxprhsdzt69\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lvttxprhpkuxe7\" width=\"900\" height=\"1133\" alt=\"vn-11134208-7r98o-lvttxprhpkuxe7\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lvttxprhqzfdfe\" width=\"900\" height=\"1133\" alt=\"vn-11134208-7r98o-lvttxprhqzfdfe\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lvttxprhtsk95a\" width=\"900\" height=\"1133\" alt=\"vn-11134208-7r98o-lvttxprhtsk95a\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lvttxprhv74p7a\" width=\"900\" height=\"1133\" alt=\"vn-11134208-7r98o-lvttxprhv74p7a\" /\u003e\u003c/p\u003e\n\u003cp\u003eHƯỚNG DẪN BẢO QUẢN TÚI XÁCH:\u003c/p\u003e\n\u003cp\u003eSử dụng:\u003c/p\u003e\n\u003cp\u003eTrên bề mặt sạch, trên bàn. Tránh đặt nơi đất bẩn.\u003c/p\u003e\n\u003cp\u003eTránh treo túi bằng quai vì trọng lượng có thể phải hư quai và dáng túi.\u003c/p\u003e\n\u003cp\u003eTránh để túi tiếp xúc trực tiếp ánh mặt trời quá lâu.\u003c/p\u003e\n\u003cp\u003eKhông để các vật sắc nhọn như dao, bấm móng tay vào túi.\u003c/p\u003e\n\u003cp\u003eTránh để trực tiếp các vật có thể lem màu (viết mực, mỹ phẩm) vào lòng túi.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eVệ sinh:\u003c/p\u003e\n\u003cp\u003eLau túi theo chiều dọc, nhẹ nhàng, tránh chất tẩy mạnh, cồn, nước, khăn ướt vì khiến túi phai màu, khô da.\u003c/p\u003e\n\u003cp\u003eDùng dung dịch hỗ trợ chuyên dụng chống thấm dầu và nước để giảm thiểu khả năng bám bẩn.\u003c/p\u003e\n\u003cp\u003eKhông mang túi đi giặt và sử dụng các dụng cụ có nhiệt độ cao để làm khô túi.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eCất giữ:\u003c/p\u003e\n\u003cp\u003eTháo dây đeo cất vào bên trong túi, cho vào bao chân hoặc tủ, giữ túi xách không bị bám bụi khi ít sử dụng.\u003c/p\u003e\n\u003cp\u003eGiữ dáng túi bằng cách nhồi giấy hoặc túi nilon.\u003c/p\u003e\n\u003cp\u003eLưu ý, không dùng giấy báo vì mực có thể dính vào túi và gây mùi khó chịu.\u003c/p\u003e\n\u003cp\u003eDùng gói hút ẩm có sẵn trong túi để ngăn chặn mùi hôi.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eChính sách đổi trả, bảo hành áp dụng trên toàn hệ thống JUNO\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eThời gian đổi/trả:\u003c/p\u003e\n\u003cp\u003e07 ngày (theo quy định Tiki) đối với hàng khuyến mãi.\u003c/p\u003e\n\u003cp\u003e30 ngày đối với hàng nguyên giá.\u003c/p\u003e\n\u003cp\u003e*Thời gian đổi/ trả được tính kể từ ngày nhận hàng\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eĐiều kiện đổi trả:\u003c/p\u003e\n\u003cp\u003e- Đổi trả khi có lỗi sản xuất hoặc hàng chưa sử dụng và sửa chữa (còn tem, nhãn).\u003c/p\u003e\n\u003cp\u003e- Sản phẩm chưa qua sử dụng, còn nguyên vẹn\u003c/p\u003e\n\u003cp\u003e- Sản phẩm không bị hư hỏng, bể vỡ\u003c/p\u003e\n\u003cp\u003e- Tem, mạc niêm phong còn nguyên vẹn, không bị rách và trầy xước\u003c/p\u003e\n\u003cp\u003e- Sản phẩm còn đầy đủ phụ kiện / quà tặng đi kèm (nếu có)\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eBảo hành: Bảo hành giày túi trong 6 tháng kể từ ngày mua hàng (căn cứ thông tin mua hàng/ hóa đơn)\u003c/p\u003e\n\u003cp\u003eKhông bảo hành phụ kiện và dép tông\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e*Lưu ý: Nếu cần hỗ trợ thêm thông tin Quý Khách Hàng vui lòng inbox chat box JUNO.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e#tuinho #tuixachmini #tuinhodethuong #tuixach #tuimini #tuijuno #TXN812\u003c/p\u003e\n\u003cp\u003e#juno #JUNO #Duno #zuno #despnu #giafynu #de2p #gia3ynu #tusinu #tu2inu\u003c/p\u003e\n\u003cp\u003e#giayjuno #tuijuno #balojuno #vijuno # matkinhjuno #sneakerjuno #sandaljuno #thoitrangnu #thoitrangjuno #giaythethaojuno\u003c/p\u003e\n\u003cp\u003e#cao_got_juno #giay_juno #tui_juno #balo_juno #vi_juno #may_kinh_juno #sneaker_juno #sandal_juno #giaythethao_juno\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ab/77/c7/4269eb3dc7057ac069353e948cf94e37.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ab/77/c7/4269eb3dc7057ac069353e948cf94e37.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ab/77/c7/4269eb3dc7057ac069353e948cf94e37.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ab/77/c7/4269eb3dc7057ac069353e948cf94e37.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ab/77/c7/4269eb3dc7057ac069353e948cf94e37.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/e1/e8/68/9a7cbffa0385a22f1a5ed2b75083692a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e1/e8/68/9a7cbffa0385a22f1a5ed2b75083692a.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e1/e8/68/9a7cbffa0385a22f1a5ed2b75083692a.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e1/e8/68/9a7cbffa0385a22f1a5ed2b75083692a.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e1/e8/68/9a7cbffa0385a22f1a5ed2b75083692a.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/12/da/56/6214a63fe635518a69f13b652b3c3d6e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/12/da/56/6214a63fe635518a69f13b652b3c3d6e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/12/da/56/6214a63fe635518a69f13b652b3c3d6e.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/12/da/56/6214a63fe635518a69f13b652b3c3d6e.jpg","thumbnail_url":"https://salt.tikicdn.com/