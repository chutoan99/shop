ype":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":true,"return_reason":"any_reason"}},"discount":51000,"discount_rate":23,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/2f/eb/d6/736bac677cabeb502d7d9530086ed36b.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":287,"all_time_quantity_sold":22,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\n\u003cp\u003e\u003cspan\u003eTừ trước đến nay, chúng ta thường chỉ nói về “Viết content”. Có lẽ vì vậy mà ít ai biết đến khái niệm “Viết thương mại” và những tiềm năng mà ngách viết này mang lại cho nghề viết tại Việt Nam. Hãy cùng “COMMERCIAL WRITING - Viết thương mại tại Việt Nam\" - số thứ hai của P.E.N thuộc series ấn phẩm chuyên nghiệp đầu tiên dành cho người viết tại Việt Nam khám phá chủ đề này nhé!\u003cbr /\u003e\u003cbr /\u003eĐược chủ biên bởi cây viết chuyên nghiệp Linh Phan và góp bút bởi đội ngũ biên soạn nội dung giàu kinh nghiệm, “COMMERCIAL WRITING - Viết thương mại tại Việt Nam\" - Cuốn sách đầu tiên định hướng nghề viết thương mại cho người mới bắt đầu sẽ cùng bạn đọc tìm hiểu về lĩnh vực viết thương mại qua ba chương:\u003cbr /\u003e\u003cbr /\u003eChương một - Mastering Skills: Bạn sẽ được hướng dẫn những kỹ năng viết từ cơ bản tới nâng cao, giúp phát triển và hoàn thiện mình trong vai trò một người viết thương mại. Những kiến thức và minh họa cụ thể về việc sử dụng các công nghệ tiên tiến như trí tuệ nhân tạo (AI), ứng dụng mô hình Design Thinking, hiểu về UI/UX cũng như xây dựng khả năng nắm bắt xu hướng trong mảng viết thương mại sẽ được đề cập chi tiết trong cuốn sách. \u003cbr /\u003e\u003cbr /\u003eKhông chỉ giới thiệu về công nghệ, ấn phẩm cũng trang bị tư duy thẩm mỹ, giúp bạn hiểu và áp dụng những yếu tố thiết kế cơ bản để làm phần nội dung trở nên hấp dẫn hơn; cùng với đó là chia sẻ với bạn những nguyên tắc quan trọng để tổ chức nội dung sao cho dễ tương tác.\u003cbr /\u003e\u003cbr /\u003eChương hai - Making Money: Bạn sẽ được thăm quan hành trình trở thành một cây viết thương mại thành công từ việc xây dựng dịch vụ, định giá, thu hút khách hàng tiềm năng, từ đó giúp thu nhập trở nên ổn định để có thể theo đuổi lâu dài công việc viết thương mại. \u003cbr /\u003e\u003cbr /\u003eThông qua bài phỏng vấn những gương mặt nổi danh trong ngành, bạn sẽ tìm thấy nhiều bí quyết, bài học cũng như kinh nghiệm để vượt qua những khó khăn và có cái nhìn thực tế về cách xây dựng sự nghiệp cho chính mình.\u003cbr /\u003e\u003cbr /\u003eChương ba - Bạn còn rối, P.E.N chỉ lối: Qua 07 câu hỏi đáp, bạn có thể kết nối với P.E.N để được cập nhật thông tin và giải đáp những thắc mắc về Viết và Nghề Viết tại Việt Nam.\u003cbr /\u003e\u003cbr /\u003eHy vọng bạn sẽ tìm thấy sự khích lệ, những hướng dẫn đắt giá và những bài học giá trị từ cuốn sách này. Hãy tin rằng bạn sẽ không chỉ trở thành một cây viết xuất sắc trong lĩnh vực thương mại, mà còn có khả năng tạo ra sự nghiệp thành công với thu nhập ổn định và bền vững. \u003cbr /\u003e\u003cbr /\u003eSở hữu cuốn sách ngay bây giờ để cùng khám phá thế giới Viết Thương Mại đầy tiềm năng và cơ hội, bạn nhé!\u003cbr /\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/2f/eb/d6/736bac677cabeb502d7d9530086ed36b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/2f/eb/d6/736bac677cabeb502d7d9530086ed36b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/2f/eb/d6/736bac677cabeb502d7d9530086ed36b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2f/eb/d6/736bac677cabeb502d7d9530086ed36b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2f/eb/d6/736bac677cabeb502d7d9530086ed36b.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/70/36/39/9a080767a446fe5fc428f0fd19c43a56.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/70/36/39/9a080767a446fe5fc428f0fd19c43a56.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/70/36/39/9a080767a446fe5fc428f0fd19c43a56.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/70/36/39/9a080767a446fe5fc428f0fd19c43a56.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/70/36/39/9a080767a446fe5fc428f0fd19c43a56.png"},{"base_url":"https://salt.tikicdn.com/ts/product/bb/85/9b/64dc77f5c55dc329d08f86e9c710b90b.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/bb/85/9b/64dc77f5c55dc329d08f86e9c710b90b.