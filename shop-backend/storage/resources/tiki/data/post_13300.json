 jungle lodge in South America? A (grounded) jumbo jet or old gaol complete with cells? From luxury to budget, traditional to quirky; some have the wow factor, others novelty value. All are bound to stimulate the imagination and inspire your future travels.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/media/catalog/product/9/7/9780753726969.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/9/7/9780753726969.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/9/7/9780753726969.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/9/7/9780753726969.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/9/7/9780753726969.jpg"}],"warranty_policy":null,"current_seller":{"id":6337,"sku":"7216280656681","name":"Foreignbooks","link":"https://tiki.vn/cua-hang/foreignbooks","logo":"93/ba/f8/a08e6337f91ea64554cb27833f112e04.jpg","price":369000,"product_id":"12668098","store_id":6194,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Thông tin chung","attributes":[{"code":"publisher_vn","name":"Công ty phát hành","value":"Hachette Book Group"},{"code":"manufacturer","name":"Nhà xuất bản","value":"Hachette Book Group"},{"code":"publication_date","name":"Ngày xuất bản","value":"2014-09-18 00:00:00"},{"code":"isbn13","name":"ISBN-13","value":"9780753726969"},{"code":"book_cover","name":"Loại bìa","value":"Paperback"}]}],"product_links":[],"gift_item_title":"0 quà tặng kèm","services_and_promotions":[],"promitions":[],"stock_item":{"max_sale_