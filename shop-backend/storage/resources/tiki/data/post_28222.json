ge":5,"review_count":10,"review_text":"(10)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/4a/96/33/65914d27e073d128e12f04d33700f858.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1862,"all_time_quantity_sold":172,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"Bạn học tiếng Trung nhưng những vấn đề trên lại đang cản bước bạn chinh phục ngôn ngữ này. Bạn có muốn tìm ra giải quyết những vấn đề này càng sớm càng tốt không? Nếu có hãy học ngay với cuốn sách “Giáo trình Hán ngữ tập 2 phiên bản mới” của Đại học ngôn ngữ Bắc Kinh.\u003cbr /\u003e\n\u003cbr /\u003e\nVì sao các bạn nên học cùng cuốn sách này?\u003cbr /\u003e\n\u003cbr /\u003e\nTrình bày khoa học phù hợp với các bạn tự nghiên cứu\u003cbr /\u003e\n\u003cbr /\u003e\nVới những bạn đang tự học tiếng Trung hoặc tự ôn luyện sau những giờ học trên lớp thì cuốn sách này hoàn toàn phù hợp. Các bài học được biên soạn theo chương trình thống nhất, phù hợp với trình độ Sơ cấp, các kiến thức đều ở mức cơ bản nhất.\u003cbr /\u003e\n\u003cbr /\u003e\nBài khóa\u003cbr /\u003e\nTừ mới\u003cbr /\u003e\nChú thích\u003cbr /\u003e\nNgữ pháp, ngữ âm\u003cbr /\u003e\nLuyện tập\u003cbr /\u003e\nHệ thống ngữ pháp và từ mới theo từng bài\u003cbr /\u003e\n\u003cbr /\u003e\nSo với tập 1, tập 2 với hệ thống ngữ pháp khó hơn và lượng từ mới nhiều hơn rất nhiều. Hệ thống từ vựng bám sát theo từng chủ đề, mỗi bài các bạn được học từ 30 – 40 từ vựng liên quan đến chủ đề. Ngoài ra ở cuối sách còn có bảng từ vựng cung cấp gần 372 từ vựng đủ cho những người mới học.\u003cbr /\u003e\n\u003cbr /\u003e\nGiúp người học phát triển đồng thời cả 4 kỹ năng\u003cbr /\u003e\n\u003cbr /\u003e\nSau khi học xong tập 1 các bạn đã nắm chắc được các kỹ năng phát âm cơ bản. Tập 2 này các bạn sẽ được ứng dụng các kiến thức đã học một cách tối đa qua các đoạn hội thoại có độ dài và khó cao hơn tập 1.\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/4a/96/33/65914d27e073d128e12f04d33700f858.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/4a/96/33/65914d27e073d128e12f04d33700f858.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/4a/96/33/65914d27e073d128e12f04d33700f858.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4a/96/33/65914d27e073d128e12f04d33700f858.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4a/96/33/65914d27e073d128e12f04d33700f858.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/12/70/5a/75737371dad2e3f21ab7d97ac1a7faf3.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/12/70/5a/75737371dad2e3f21ab7d97ac1a7faf3.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/12/70/5a/75737371dad2e3f21ab7d97ac1a7faf3.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/12/70/5a/75737371dad2e3f21ab7d97ac1a7faf3.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/12/70/5a/75737371dad2e3f21ab7d97ac1a7faf3.jpg"}],"warranty_policy":null,"authors":[{"id":633897,"name":" Đại Học Ngôn Ngữ Bắc Kinh","slug":"dai-hoc-ngon-ngu-bac-kinh"}],"current_seller":{"id":260511,"sku":"5494587855254","name":"MCBooks Hạnh Phúc","link":"https://tiki.vn/cua-hang/bizbooks-h","logo":"3f/e2/87/ac146e4b35276aaf30cec0797b5ed523.jpg","price":86000,"product_id":"167473772","st