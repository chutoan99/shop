,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":17000,"discount_rate":10,"rating_average":5,"review_count":11,"review_text":"(11)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/09/42/83/bad654740e2ec16997bad5ec2e9c6520.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1243,"all_time_quantity_sold":44,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003eĐẶC ĐIỂM NỔI BẬT CỦA SẢN PHẨM\u003c/strong\u003e\u003c/p\u003e\n\u003cul style=\"text-align:justify;\"\u003e\n\u003cli\u003e\u003cstrong\u003eBột Chùm Ngây Quảng Thanh \u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003enguyên liệu từ trang trại sinh học VietGAP\u003c/span\u003e\u003c/li\u003e\n\u003cli\u003e\u003cspan style=\"font-weight:400;\"\u003eCam kết KHÔNG sử dụng thuốc BVTV, thuốc diệt cỏ và thuốc kích thích\u003c/span\u003e\u003c/li\u003e\n\u003cli\u003e\u003cspan style=\"font-weight:400;\"\u003eBí quyết sử dụng công nghệ sấy lạnh tiệt trùng tiên tiến\u003c/span\u003e\u003c/li\u003e\n\u003cli\u003e\u003cspan style=\"font-weight:400;\"\u003eGiữ nguyên vẹn hương vị gốc và màu sắc tự nhiên\u003c/span\u003e\u003c/li\u003e\n\u003cli\u003e\u003cspan style=\"font-weight:400;\"\u003eNói KHÔNG với phẩm màu và mọi hóa chất độc hại\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/09/42/83/823d1bf3be4a9d573809afde1027b852.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cem\u003e\u003cspan style=\"font-weight:400;\"\u003eBột chùm ngây Quảng Thanh phòng ngừa ung thư, ổn định đường huyết\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003eCÔNG DỤNG CỦA SẢN PHẨM\u003c/strong\u003e\u003c/p\u003e\n\u003cul style=\"text-align:justify;\"\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eBột Chùm Ngây Quảng Thanh \u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003ebổ sung vitamin và nguồn dinh dưỡng thiết yếu, dồi dào, chống suy nhược cơ thể, chống còi xương. Món ăn làm từ bột chùm ngây giúp cải thiện sự mất ngủ, giảm căng thẳng, lo âu, rất tốt cho trẻ nhỏ, người già và phụ nữ sau sinh. Tăng cường khả năng làm việc liên tục trong thời gian dài, tăng sức chịu đựng , giảm mệt mỏi về tinh thần và thể chất. Phù hợp cho các vận động viên thường xuyên vận động và người làm việc trí óc nhiều giờ hoặc lao lực.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eBột Chùm Ngây Quảng Thanh \u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003emang l\u003c/span\u003e\u003cspan style=\"font-weight:400;\"\u003eại hiệu quả lớn trong hỗ trợ đái tháo đường, cao huyết áp, chứng táo bón, bệnh thiếu máu, viêm loét.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eDùng làm thực phẩm giàu dinh dưỡng: trong chùm ngây có chứa nhiều hợp chất quý hiếm như: zeatin, quercetin, alpha-sitosterol, caffeoylquinic acid và kaempferol,…cùng hơn 90 chất dinh dưỡng tổng hợp, liều lượng lớn các chất chống viêm nhiễm, các chất kháng sinh, kháng độc tố, ngăn ngừa ung thư, u xơ tiền liệt tuyến, giúp ổn định huyết áp, hạ cholesterol, bảo vệ gan.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eBột Chùm Ngây Quảng Thanh \u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003ephòng ngừa nhiều bệnh nguy hiểm: bệnh ung thư, tiểu đường, thiếu máu, còi xương, tim mạch, kinh phong, sưng tấy, viêm nhiễm, mỡ máu, đau dạ dày, ngừa thai, ung loét, lão hóa, suy nhược cơ thể, suy nhược thần kinh,tăng cường khả năng ham muốn tình dục.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eChống lão hóa mạnh mẽ: hợp chất zeatin chống lão hóa cực tốt chứa đựng trong lá cây chùm ngây cao gấp nhiều lần so với bất cứ loại cây nào, do đó, bột chùm ngây được xem là “thần dược” giúp chị em phụ nữ gìn giữ nét xuân.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cem\u003e\u003cspan style=\"font-weight:400;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/73/83/8b/2a72e211e10398001ad06347538a92b7.jpg\" alt=\"Bột Chùm Ngây Quảng Thanh\" width=\"750\" height=\"750\" /\u003e\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cem\u003e\u003cspan style=\"font-weight:400;\"\u003eBột Chùm Ngây Quảng Thanh giữ nguyên vẹn những giá trị quý của lá chùm ngây tươi\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003eTHÔNG TIN CHUNG\u003c/strong\u003e\u003c/p\u003e\n\u003cul style=\"text-align:justify;\"\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eThành phần\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e: 100% lá chùm ngây tươi, sấy lạnh tiệt trùng và nghiền siêu mịn\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eĐộ ẩm\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e: dưới 5%\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eNgày sản xuất:\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e xem trên bao bì\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eHạn sử dụng:\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e 1 năm kể từ ngày sản xuất\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eSố XNCB:\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e 005-2019/CBHQ-TNV\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003eCÁCH DÙNG\u003c/strong\u003e\u003c/p\u003e\n\u003cul style=\"text-align:justify;\"\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eDùng làm thức uống: có thể pha 1/4 muỗng bột chùm ngây Quảng Thanh với đường hoặc sữa đặc, dùng uống hàng ngày thay nước, vừa giải khát lại thanh lọc cơ thể rất tốt trong thời tiết oi bức.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eDùng làm đồ ăn: Bột chùm ngây Quảng Thanh\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e có vị ngọt ngọt gần như bột ngọt (mì chính), vì thế, chúng có thể làm nguyên liệu để thêm vào cháo, canh hay rắc lên các món ăn như một gia vị. Liều lượng bột chùm ngây thích hợp nhất cho cơ thể người lớn là 10gr/ngày và trẻ em dưới 6 tuổi là 5gr/ngày.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cem\u003e\u003cspan style=\"font-weight:400;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/1a/57/65/4f9379edcbfd5ebf1489b8b596ff2661.jpg\" alt=\"Bột Chùm Ngây Quảng Thanh\" width=\"750\" height=\"750\" /\u003e\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cem\u003e\u003cspan style=\"font-weight:400;\"\u003eBột chùm ngây Quảng Thanh bổ sung chất dinh dưỡng\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003eBẢO QUẢN\u003c/strong\u003e\u003c/p\u003e\n\u003cul style=\"text-align:justify;\"\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eBảo quản \u003c/span\u003e\u003cstrong\u003eBột chùm ngây Quảng Thanh\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e ở khô thoáng, tránh tác động của ánh sáng và nhiệt. Tốt nhất nên bảo quản trong ngăn mát tủ lạnh. \u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eKhóa kín miệng túi sau khi sử dụng. Không nên sang chiết sản phẩm sang hũ nhựa hay lọ thủy tinh để giúp bột không bị biến chất, đảm bảo thời hạn sử dụng được lâu.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align:justify;\"\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/09/42/83/bad654740e2ec16997bad5ec2e9c6520.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/09/42/83/bad654740e2ec16997bad5ec2e9c6520.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/09/42/83/bad654740e2ec16997bad5ec2e9c6520.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/09/42/83/bad654740e2ec16997bad5ec2e9c6520.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/09/42/83/bad654740e2ec16997bad5ec2e9c6520.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/31/b1/cf/0f780f9f20b6f23ef7c6a5eed1313057.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/31/b1/cf/0f780f9f20b6f23ef7c6a5eed1313057.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/31/b1/cf/0f780f9f20b6f23ef7c6a5eed1313057.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/31/b1/cf/0f780f9f20b6f23ef7c6a5eed1313057.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/31/b1/cf/0f780f9f20b6f23ef7c6a5eed1313057.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/73/