ype":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.5,"review_count":31,"review_text":"(31)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/e1/3f/43/75767122774261c0a82ca65601c1cb1a.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":889,"all_time_quantity_sold":163,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3 style=\"text-align:justify;\"\u003eXe ô tô điều khiển từ xa KAVY 058 bằng cử chỉ có nhạc, đèn phun được khói xoay 360 độ cao\u003c/h3\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003eGiới thiệu\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003eXe ô tô điều khiển từ xa bằng cử chỉ, có 2 thiết bị điều khiển từ xa: Đồng hồ đeo tay và điều khiển\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003eĐặc điểm nổi bật\u003c/strong\u003e\u003c/p\u003e\n\u003cul style=\"list-style-type:disc;text-align:justify;\"\u003e\n\u003cli\u003eChất liệu nhựa ABS cấu thành lên xe rất chắc chắn bền bỉ\u003c/li\u003e\n\u003cli\u003eCó đèn và nhạc có thể chơi vào ban đêm rất thích thú\u003c/li\u003e\n\u003cli\u003eXe phun được khói mô tả chân thực nhất động cơ hoạt động như chiếc xe ngoài đời thực ( chỉ cần đổ nước vào xe là hệ thống phun khói)\u003c/li\u003e\n\u003cli\u003eLoại pin theo xe là pin Lithium chơi lâu hơn, sạc nhanh hơn an toàn môi trường và tuổi thọ cao ( thời gian chơi : 25 phút liên tục, sạc : 90 phút ) ( pin các loại xe trên thị trường là niken- crom,tuổi thọ ngắn, thời gian sử dụng ít)\u003c/li\u003e\n\u003cli\u003eSản phẩm chống chịu va đập tốt, cứng và rắn các chi tiết được bo cong mềm mại không sắc nhọn giúp tạo thuận lợi tối đa cho việc cầm nắm của trẻ\u003c/li\u003e\n\u003cli\u003eĐiều khiển bằng cử chỉ tay – Xe biến hình, bất luận là tăng tốc, rẽ trái/ phải, giảm tốc hay phanh gấp, chỉ cần cử động cổ tay là được\u003c/li\u003e\n\u003cli\u003eChống nhiễu, dễ vận hành: hệ thống điều khiển không dây 2,4 GHz có hiệu quả chống nhiễu tốt.\u003c/li\u003e\n\u003cli\u003eKhoảng cách điều khiển từ xa là khoảng 35 mét, có thể chơi cùng lúc nhiều xe mà không cần lo nhiễu sóng\u003c/li\u003e\n\u003cli\u003eTrong quá trình điều khiển, có thể tự do kết hợp các thao tác tiến, lùi, rẽ trái/ phải, chuyển hướng.\u003c/li\u003e\n\u003cli\u003eChuyển đổi chỉ bằng một nút ấn - vận hành trên mọi địa hình. Chỉ cần ấn vào công tắc trên điều khiển, thân xe sẽ uốn cong, bốn bánh xe gần nhau hơn và mặt đất sẽ trở nên ổn định. Xe sẽ thay đổi từ một chiếc xe phẳng sang một chiếc xe địa hình.\u003cbr /\u003eThích hợp chơi cả trong nhà và ngoài trời, mặt phẳng và đồi núi: động lực mạnh mẽ, tốc độ cao 15 km/h, có thể vận hành trên các bề mặt trong nhà và ngoài trời như sàn bê tông, sàn lát gạch, việt dã.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align:justify;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e \u003c/p\u003e\n\u003cpre\u003e\u003cstrong\u003e\u003c/strong\u003e\u003c/pre\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/15/4b/7e/a0974df90284252b652cf225ce7c6177.jpg\" alt=\"\" width=\"700\" height=\"601\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/b0/25/ef/63ac665a5742bd6061e99e042d9eec01.jpg\" alt=\"\" width=\"750\" height=\"869\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/75/2a/6c/1de1538f0c881d08878c1cd711a2b890.jpg\" alt=\"\" width=\"720\" height=\"1774\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/75/7b/11/84141c2e5f6bcd0010aa4981b8c339fc.jpg\" alt=\"\" width=\"750\" height=\"1119\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003eThông số sản phẩm\u003c/strong\u003e\u003c/p\u003e\n\u003cul style=\"list-style-type:disc;\"\u003e\n\u003cli style=\"text-align:justify;\"\u003eTay điều khiển: Pin AA 2*1.5V và đồng hồ điều khiển cử chỉ\u003c/li\u003e\n\u003cli style=\"text-align:justify;\"\u003ePin theo xe: 3.7 V 500mAh Pin Lithium\u003c/li\u003e\n\u003cli style=\"text-align:justify;\"\u003eChất liệu : nhựa ABS\u003c/li\u003e\n\u003cli style=\"text-align:justify;\"\u003eCó đèn, nhạc và phun được khói\u003c/li\u003e\n\u003cli style=\"text-align:justify;\"\u003eThời gian chạy: 20-25 phút\u003c/li\u003e\n\u003cli style=\"text-align:justify;\"\u003eThời gian sạc: 90 phút\u003c/li\u003e\n\u003cli style=\"text-align:justify;\"\u003eKích thước xe : 28 cm x 17.5 cm x 6.5 cm, kích thước đóng gói : 30 x 20 x 8 cm\u003c/li\u003e\n\u003cli style=\"text-align:justify;\"\u003eSản phẩm gồm : Xe ô tô, tay cầm điều khiển , pin sạc, dây cáp sạc, đồng hô cử chỉ điều khiển\u003c/li\u003e\n\u003cli style=\"text-align:justify;\"\u003eMàu sắc : Xanh lá và xanh lam\u003c/li\u003e\n\u003cli style=\"text-align:justify;\"\u003eXuất xứ : Trung Quốc\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u