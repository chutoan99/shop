nd_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":24500,"discount_rate":10,"rating_average":4.5,"review_count":8,"review_text":"(8)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/02/aa/2d/8dd1f0bb0985b5890ebec1876b4458c6.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":914,"all_time_quantity_sold":398,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e- Bột cỏ lúa mì DALA HOUSE được sản xuất từ cỏ lúa mì tươi với công nghệ sấy lạnh hiện đại và công nghệ nghiền thực phẩm ở nhiệt độ thấp giúp bảo quản enzym và các chất dinh dưỡng có trong cỏ lúa mì.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e- Cỏ lúa mì rất giàu dinh dưỡng và có nhiều lợi ích cho sức khỏe có chứa khoảng 13 vitamin, 10 khoáng chất, 17 axit amin và hơn một trăm enzyme có lợi cho sức khỏe con người. Những chất này đều rất cần thiết cho quá trình chuyển hóa trong cơ thể, giúp tăng cường sức khỏe, sức đề kháng, hỗ trợ tiêu hóa, kháng viêm, đặc biệt đối với trẻ nhỏ thì bột lúa mì không chỉ cung cấp đầy đủ dưỡng chất thiết yếu giúp trẻ phát triển toàn diện và còn giúp trẻ tăng cường hệ miễn dịch, phòng chống bệnh, tăng sức đề kháng, giúp trẻ luôn khỏe mạnh.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e- Bột cỏ lúa mì phòng ngừa và điều trị bệnh như ung thư, thiếu máu, tăng hệ miễn dịch,giảm cân, đẹp đặc biệt là bột cỏ lúa mì giúp thanh lọc cơ thể, bảo vệ gan hiệu quả.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e- Trong cỏ lúa mì chứa nhiều chất Chlorophyll, chất này có tác dụng bảo vệ và phục hồi gan, hóa giải và tiêu trừ các chất gây hại trong máu. Ngoài ra cỏ lúa mì cũng có khả năng tái tạo hồng huyết cầu nhanh chóng cho cơ thể và cải thiện chức năng gan cùng tim mạch trong hệ thống tuần hoàn một cách tự nhiên.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e- Bột cỏ lúa mì có rất nhiều dinh dưỡng nhưng lại rất ít calo và chất béo vì vậy mà bột cỏ lúa mì được xem là một thực phẩm bổ sung tuyệt vời trong giảm cân. Nó giúp cho cơ thể vẫn đủ dinh dưỡng, không mệt mỏi trong quá trình kiêng ăn. Ngoài ra các chất xơ trong bột cỏ lúa mì tạo cảm giác no, giúp quá trình giảm cân được hiệu quả.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e- Bột cỏ lúa mì còn rất tốt cho lớp da bên ngoài và lớp biểu bì dưới da, giúp trị mụn trứng cá và thậm chí còn giúp loại bỏ những vết sẹo trên da.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e- Ngoài những công dụng trong việc giúp cải thiện hệ miễn dịch, thanh lọc cơ thể, giảm cân, làm đẹp da thì bột cỏ lúa mì còn giúp phòng ngừa và điều trị một số bệnh như ung thư, thiếu máu và bệnh tiểu đường. Mỗi khi sử dụng bột cỏ lúa mì trước mỗi bữa ăn, chất xơ sẽ kiểm soát hấp thụ đường và cholesterol từ thực phẩm. Điều này giúp ngăn chặn sự tăng trưởng đường huyết đột ngột của bệnh nhân đái tháo đường sau mỗi bữa ăn .\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e- Bột cỏ lúa mì có mùi và vị đặc trưng từ cỏ lúa mì,  không đắng, người mới sử dụng có thể pha thêm các loại thức uống khác để tạo cảm giác \"ngon\" hơn như dứa, táo, nho, bạc hà,\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e- Sản phẩm nguyên chất 100% từ cỏ lúa mì tươi, không chất bảo quản, không chất phụ gia, tan trong nước rất tiện sử dụng.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eCÔNG DỤNG: \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eTăng cường hệ miễn dịch\u003c/li\u003e\n\u003cli\u003eThanh lọc cơ thể, mát gan\u003c/li\u003e\n\u003cli\u003ePhòng và điều trị bệnh ung thư\u003c/li\u003e\n\u003cli\u003eĐiều trị thiếu máu\u003c/li\u003e\n\u003cli\u003eNgăn ngừa và chữa trị bệnh tiểu đường\u003c/li\u003e\n\u003cli\u003eHỗ trợ hệ tiêu hóa, ngăn ngừa và trị táo bón\u003c/li\u003e\n\u003cli\u003ePhục hồi vết thương\u003c/li\u003e\n\u003cli\u003eGiảm cân\u003c/li\u003e\n\u003cli\u003eKhử mùi hôi cơ thể\u003c/li\u003e\n\u003cli\u003eLàm đẹp da, chống lão hóa da\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e- Hướng dẫn sử dụng: Làm đồ uống, trộn trong sinh tố, tạo màu cho nguyên liệu trong các món ăn. Làm bột ăn dặm cho bé.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e- Bảo quản: Đóng kín túi sau khi sử dụng, tránh ánh nắng trực tiếp\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e- Hạn sử dụng: 12 tháng kể từ ngày sản xuất\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e- Xuất xứ: Việt Nam\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e- Lưu ý: Không pha bột chung với cam, chanh vì sẽ làm mất các enzyme. Không nên pha bột lúa mì với nước quá nóng vì sẽ làm mất hoặc giảm nhiều chất có trong bột cỏ lúa mì.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/50/2a/8b/f5c71e169c6525f9a5af1fe389d1ace3.jpg\" alt=\"\" width=\"225\" height=\"225\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/64/7a/55/d2d5aa874610fee713e93139ff170c51.jpg\" alt=\"\" width=\"750\" height=\"933\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.co