":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":5000,"discount_rate":2,"rating_average":4.8,"review_count":18,"review_text":"(18)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/92/bb/b5/b97b218e759a97a94bf49d52fd00efac.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1035,"all_time_quantity_sold":54,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2 style=\"text-align: center;\"\u003eQuạt tản nhiệt MEMO DL05\u003c/h2\u003e\n\u003cp\u003eNếu yêu thích dòng phụ kiện Gaming Gear chắc hẳn bạn không thể bỏ lỡ siêu phẩm vừa mới được ra mắt trong năm 2021. \u003cstrong\u003eQuạt tản nhiệt MEMO DL05\u003c/strong\u003e là phiên bản nâng cấp toàn diện của dòng Memo sò lạnh. Sở hữu những tính năng ấn tượng mang lại trải nghiệm chơi game an toàn và chuyên nghiệp. Còn chần chờ gì nữa mà không cùng Linh Kiện Store khám phá dòng sản phẩm này ngay bài viết bên dưới nào!\u003c/p\u003e\n\u003ch2\u003eThiết kế độc đáo của Quạt tản nhiệt MEMO DL05\u003c/h2\u003e\n\u003cp\u003eMEMO DL05 Version 2 sở hữu thiết kế cool ngầu đậm chất Gaming. Phía trước có màn hình LCD giúp hiển thị nhiệt độ. Thuận tiện cho người chơi theo dõi trực tiếp ngay cả khi đang chiến game.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/68/f8/3c/7ef5d3862aa21eda330879a780006916.jpg\" alt=\"Vẻ ngoải mạnh mẽ, cá tính Quạt tản nhiệt MEMO DL05\" width=\"800\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003eVẻ ngoải mạnh mẽ, cá tính\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003eKẹp quạt tản nhiệt được làm từ chất liệu cao su không gây trầy xước viền điện thoại. Có khả năng lắp đặt 2 chiều ngang dọc linh hoạt nên tương thích với hầu hết các dòng Smartphone đang có mặt trên thị trường hiện nay.  \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/e0/38/17/266c34d4041487d5b9cb1736d167d35b.jpg\" alt=\"Kẹp co giãn 2 chiều tiện lợi Quạt tản nhiệt MEMO DL05\" width=\"800\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003eKẹp co giãn 2 chiều tiện lợi\u003c/em\u003e\u003c/p\u003e\n\u003ch2\u003eTính năng nổi bật của quạt tản nhiệt MEMO DL05\u003c/h2\u003e\n\u003cp\u003eThiết bị tích hợp đèn Led RGB tạo nên không gian ánh sáng cực ấn tượng và mạnh mẽ. Giúp bạn có thể hòa mình và tập trung toàn lực vào trận đấu.\u003c/p\u003e\n\u003cp\u003e\u003cem\u003eLưu ý:\u003c/em\u003e Đèn đỏ sáng khi kết nối điện, đèn xanh sáng khi nhấp công tắc, làm mát hoặc chuyển chế độ.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/42/71/dc/94a423de215ad8803c4c7675f0d41207.jpg\" alt=\"Cung cấp đèn Led nhiều màu Quạt tản nhiệt MEMO DL05\" width=\"800\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003eCung cấp đèn Led nhiều màu\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003eHãng đã loại bỏ cần gạt ON/OFF để nâng cấp thành nút bấm tiện dụng hơn. Đồng thời, sử dụng sò lạnh công suất cao có đế tản nhiệt lớn và vật liệu tản nhiệt nhôm cao cấp tốt hơn phiên bản cũ.\u003c/p\u003e\n\u003cp\u003eTản nhiệt có diện tích lớn hỗ trợ giảm nhiệt độ của thiết bị. Kết hợp tốc độ lên đến 7500 vòng/phút làm mát siêu nhanh chóng và hiệu quả.\u003c/p\u003e\n\u003cp\u003eBạn có thể yên tâm khi chơi những game cấu hình mạnh, dung lượng lớn như PUBG, Tốc Chiến, Free Fire. Không lo sợ thiết bị điện thoại quá nóng làm giảm tuổi thọ, độ bền thậm chí phát nổ.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/21/e5/e3/1cebf2aa78f92465d48cf80290d5945a.jpg\" alt=\" Tốc độ tản nhiệt lên đến 7500 vòng/phút Quạt tản nhiệt MEMO DL05\" width=\"800\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e Tốc độ tản nhiệt lên đến 7500 vòng/phút\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003eSản phẩm còn được trang bị dây Type C thuận tiện để cắm và rút phích cắm. Người dùng thõa sức cắm và chơi không cần gắn sạc mà vẫn đảm bảo dòng điện đầu vào ổn định.\u003c/p\u003e\n\u003ch2\u003eMột số hình ảnh thực tế của MEMO DL05\u003c/h2\u003e\n\u003cp\u003e \u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/5d/d1/11/14d23c5cea65c138ec1057bd1af1084b.jpg\" alt=\"Quat-tan-nhiet-memo-dl05 (3)\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/ed/53/d0/2f97a837fba38683355856ff0dd37492.jpg\" alt=\"Quat-tan-nhiet-memo-dl05 (2)\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/f8/dc/56/1a4e065f5199938ee299ab3c2efc6c2a.jpg\" alt=\"Quat-tan-nhiet-memo-dl05 (1)\" /\u003e\u003c/p\u003e\n\u003ch2\u003eThông số kĩ thuật quạt tản nhiệt MEMO DL05\u003c/h2\u003e\n\u003cp\u003eMàn hình LED RGB\u003c/p\u003e\n\u003cp\u003eTốc độ quạt: 7500 vòng/phút\u003c/p\u003e\n\u003cp\u003eDòng điện: 1.5-2A\u003c/p\u003e\n\u003cp\u003eĐộ mở rộng: 65-85mm\u003c/p\u003e\n\u003cp\u003eKích thước: 84 X 65 X 35mm\u003c/p\u003e\n\u003cp\u003eCổng nguồn: Type C (1.5m)\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/92/bb/b5/b97b218e759a97a94bf49d52fd00efac.jpg","is_gallery":t