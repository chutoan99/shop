nt_rate":4,"rating_average":5,"review_count":34,"review_text":"(34)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/d7/76/a9/04648a6405adff12f908ba97bf79a0f1.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":784,"all_time_quantity_sold":214,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2 data-spm-anchor-id=\"a2o4n.pdp_revamp.product_detail.i2.3edb5752uSLYpA\"\u003eGIỚI THIỆU WILLEN, DÒNG LOA DI ĐỘNG CỰC KỲ NHỎ GỌN VÀ TIỆN LỢI, MANG ÂM THANH SỐNG ĐỘNG THEO BẠN ĐI KHẮP MỌI NƠI. ĐỪNG BỊ ĐÁNH LỪA BỞI KÍCH THƯỚC – WILLEN TUY NHỎ GỌN NHƯNG LẠI CÓ KHẢ NĂNG KHUẾCH ĐẠI ÂM THANH CỰC KỲ MẠNH MẼ.\u003c/h2\u003e\n\u003cp\u003eBạn sẽ luôn sẵn sàng mang theo Willen trên mọi cung đường bởi Willen đạt tiêu chuẩn IP67 với khả năng kháng nước và bụi đáng ngạc nhiên. Willen là dòng loa với thiết kế tinh tế mang tính biểu tượng của Marshall và chất liệu bền bỉ vượt qua mọi giới hạn. Ngoài ra, với dây đeo chắc chắn đính kèm sau lưng và thời gian nghe nhạc lên đến hơn 15 giờ cho một lần sạc, Willen luôn sẵn sàng cho mọi cuộc vui, bất chấp mọi địa hình.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/29/85/d7/69d7662b240f3117de515fa604ebef0f.jpg\" alt=\"\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003ch2\u003eXÁCH WILLEN LÊN VÀ ĐI!\u003c/h2\u003e\n\u003cp\u003eWillen là dòng loa di động nhỏ gọn và tiện lợi, dễ dàng mang theo khi đi du lịch. Được trang bị 2 drivers toàn dải 2\" 10 Watt kết hợp với 2 màng rung thụ động tăng bass, Willen mang đến chất âm mạnh mẽ đúng với tinh thần Rock'n'Roll lâu đời của Marshall. Vượt trội hơn cả là chất lượng âm thanh trung thực, sống động và rõ nét từ các loại nhạc cụ, Willen sẽ mang âm thanh đặc trưng từ Marshall đi cùng bạn mọi lúc, mọi nơi.\u003c/p\u003e\n\u003ch2\u003eCHẤT LIỆU BỀN BỈ, THIẾT KẾ VỮNG CHẮC\u003c/h2\u003e\n\u003cp\u003eVới khả năng kháng bụi và nước chuẩn IP67, Willen chẳng lo trời mưa, chẳng ngại bụi đường. Tất cả chỉ là bạn và âm nhạc trên mọi cung đường. Với thiết kế vững chắc, Willen luôn sẵn sàng lên đường cùng bạn bất chấp mọi điều kiện thời tiết, vượt qua mọi giới hạn.\u003c/p\u003e\n\u003ch2\u003eTHỜI LƯỢNG PIN KHÔNG LÀM BẠN THẤT VỌNG\u003c/h2\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/04/ce/e4/9c2c1866c4bf9cefb9b11832fcfd26cd.jpg\" alt=\"\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp\u003eWillen có thể phát nhạc liên tục lên đến hơn 15 giờ chỉ với 1 lần sạc. Và chỉ với 3 giờ sạc, Willen sẽ trở lại trạng thái đầy năng lượng. Nếu bạn không đủ kiên nhẫn, chỉ cần cắm sạc trong 20 phút và bạn sẽ có thể tận hưởng âm nhạc lên đến 3 tiếng – Quá phù hợp để chúng ta mang theo khi đi phượt có phải không?\u003c/p\u003e\n\u003ch2\u003eWILLEN ĐƯỢC TRANG BỊ DÂY ĐEO PHÍA SAU LƯNG\u003c/h2\u003e\n\u003cp\u003eWillen là dòng loa đa năng, linh hoạt khi được đặt ở bất kỳ vị trí nào, dù đặt loa đứng hay nằm, gắn hay treo lên các vật dụng khác với dây đeo bằng cao su phía sau lưng. Hãy treo Willen ở bất kỳ đâu, bạn vẫn có thể đắm chìm trong âm nhạc ở bất kỳ địa hình nào.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/3c/68/47/b279bbe040909639fb830a9c152baf68.jpg\" alt=\"\" width=\"750\" height=\"417\" /\u003e\u003c/p\u003e\n\u003ch2\u003eKẾT NỐI VÀ BẬT LÊN ÂM THANH SỐNG ĐỘNG\u003c/h2\u003e\n\u003cdiv\u003eKhoảng cách ngắn nhất từ bạn đến âm nhạc là Willen – đơn giản chỉ cần kết nối và tận hưởng âm nhạc. “Say no” với mọi kết nối phức tạp! Ngoài ra, bạn còn có thể kết nối với Marshall Bluetooth app để tùy chỉnh các biên độ âm thanh, hoặc tùy chọn với 3 cài đặt có sẵn trong app.\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cp\u003eKết nối với Bluetooth 5.1 và điều khiển âm nhạc của bạn trong app hoặc tận hưởng các trải nghiệm thực tế chỉ với nút điều khiển đa hướng được gắn phía trước loa. Bạn sẽ tìm thấy mọi thứ bạn cần ngay phía trước loa, bao gồm cả nút kết nối Bluetooth và đèn LED chỉ báo pin.\u003c/p\u003e\n\u003cp\u003eNút kết nối Bluetooth cũng là nơi kích hoạt tính năng “Stack Mode” – cho phép bạn kết nối âm thanh với các loa Willen khác. Với Willen, mọi việc sẽ thật dễ dàng chỉ với kết nối và tận hưởng âm nhạc.\u003c/p\u003e\n\u003ch2\u003e“STACK MODE” – TÍNH NĂNG KẾT NỐI NHIỀU LOA WILLEN\u003c/h2\u003e\n\u003cp\u003eTính năng “Stack Mode“ giúp khuếch đại âm thanh với khả năng hỗ trợ kết nối cùng lúc nhiều loa có chế độ Stack Mode với nhau. Bạn có thể kích hoạt tính năng “Stack Mode” với nút kết nối Bluetooth phía trước loa. Chỉ cần kết nối và bật nhạc và bữa tiệc âm nhạc sẽ sẵn sàng! Kết nối nhiều loa cùng lúc và đặt tại các vị trí khác nhau, bạn sẽ tạo nên một không gian âm nhạc sống động, với công suất âm thanh cực mạnh mẽ như ở trên sân khấu.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/9e/87/10/86a0522e2eb53ee309a3cc0ae3ec900e.jpg\" alt=\"\" width=\"750\" height=\"562\" /\u003e\u003c/p\u003e\n\u003ch2\u003eTÍCH HỢP MICROPHONE – ĐÀM THOẠI RẢNH TAY\u003c/h2\u003e\n\u003cp\u003eWillen được tích hợp microphone ngay trên loa, giúp bạn trả lời và từ chối cuộc gọi chỉ với 1 chạm trên nút điều khiển đa hướng. Bất kể là một cuộc gọi ngắn cho công việc, hay tán gẫu với bạn bè, Willen sẽ đảm bảo giọng nói của bạn luôn được truyền đạt rõ ràng.\u003c/p\u003e\n\u003ch2\u003eTẬN HƯỞNG ÂM NHẠC – BẢO VỆ MÔI TRƯỜNG\u003c/h2\u003e\n\u003cp\u003eSẽ càng ngạc nhiên hơn nếu bạn hiểu rõ về quy cách sản xuất của Willen. Đây là dòng loa được sản xuất với nhựa không có PVC và 60% nhựa tái chế từ các thiết bị điện tử đã qua sử dụng. Willen là một lời cam kết phát triển bền vững từ Marshall, nhưng vẫn giữ được thiết kế tinh tế và đặc trưng mang tính biểu tượng của Marshall.\u003c/p\u003e\n\u003carticle class=\"4ever-article\" data-clipboard-cangjie=\"[\u0026quot;root\u0026quot;,{\u0026quot;copyFrom\u0026quot;:33891801},[\u0026quot;p\u0026quot;,{\u0026quot;jc\u0026quot;:\u0026quot;left\u0026quot;,\u0026quot;ind\u0026quot;:{},\u0026quot;spacing\u0026quot;:{}},[\u0026quot;span\u0026quot;,{\u0026quot;data-type\u0026quot;:\u0026quot;text\u0026quot;},[\u0026quot;span\u0026quot;,{\u0026quot;bold\u0026quot;:true,\u0026quot;sz\u0026quot;:16,\u0026quot;szUnit\u0026quot;:\u0026quot;pt\u0026quot;,\u0026quot;data-type\u0026quot;:\u0026quot;leaf\u0026quot;},\u0026quot;BẢO HÀNH 1 ĐỔI 1 TRONG VÒNG 1 NĂM ĐỐI VỚI LỖI TỪ NHÀ SẢN XUẤT\u0026quot;]]],[\u0026quot;p\u0026quot;,{\u0026quot;jc\u0026quot;:\u0026quot;left\u0026quot;,\u0026quot;ind\u0026quot;:{},\u0026quot;spacing\u0026quot;:{}},[\u0026quot;span\u0026quot;,{\u0026quot;data-type\u0026quot;:\u0026quot;text\u0026quot;},[\u0026quot;span\u0026quot;,{\u0026quot;data-type\u0026quot;:\u0026quot;leaf\u0026quot;},\u0026quot;\u0026quot;]]]]\"\u003e\n\u003ch2\u003e\u003cstrong\u003eBẢO HÀNH 1 ĐỔI 1 TRONG VÒNG 1 NĂM ĐỐI VỚI LỖI TỪ NHÀ SẢN XUẤT\u003c/strong\u003e\u003c/h2\u003e\n\u003c/article\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/d7/76/a9/04648a6405adff12f908ba97bf79a0f1.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d7/76/a9/04648a6405adff12f908ba97bf79a0f1.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d7/76/a9/04648a6405adff12f908ba97bf79a0f1.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d7/76/a9/04648a6405adff12f908ba97bf79a0f1.jpg","thumbnail_url":"https://salt.tikicdn.com/ca