_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ab/75/d1/b5c6a773ba627358f7417d15d3421579.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":617,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cdiv class=\"d9FyLd\"\u003eSumico - Thương hiệu âm thanh karaoke \u003cstrong\u003eViệt Nam\u003c/strong\u003e\u003c/div\u003e\n\u003cp\u003e\u003cspan class=\"hgKElc\"\u003eHãng được thành lập vào năm 2015 và phát triển bởi nhóm kỹ sư Hàn Quốc giàu kinh nghiệm trong thiết kế các thiết bị karaoke. Tại thị trường Việt Nam, loa Sumico được nhập khẩu và phân phối chính thức tại Việt Nam \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan class=\"hgKElc\"\u003eLoa di động kết nối blutooth Sumico BT-S52 được thiết kế có tính thẩm mỹ cao mà bất kỳ ai nhìn vào đều công nhận đẹp. Loa có công suất mạnh mẽ với 100W cho 2 kênh stereo với loa tweeter nam châm Neodymium cho âm tần số cao trong treo mượt mà. Vỏ ngoài bọc da PU cao cấp màu nâu cộng với thiết kế hoài cổ giống các đồ vật ở thập niên 50 thế kỷ trước. Loa cũng bố trí đầy đủ các ngõ vào như HDMI, Optical, AUx, cho phép chúng ta kết nối với bất kỳ thiết bị nào. Đặc biệt hơn nữa loa đi kèm với 2 micro cao cấp, cho phép chúng ta có thể ca hát vui vẻ với gia đình và bạn bè. Đây thực sự là một chiếc loa cho mọi nhà. \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/eb/c6/e2/9314ea3154cce15a94f1165f227185ec.png\" alt=\"\" width=\"600\" height=\"300\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThiết kế thẩm mỹ cao\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eSumico BT-S52 có thiết kế thẩm mỹ cao, hướng đến người tiêu dùng khó tính nhất. Loa được bọc chất liệu da công nghiệp PU cao cấp màu sa huỳnh rất sang trọng. 8 góc cạnh được bọc cao su chống va đập sờn góc vừa tôn lên vẻ đẹp độc đáo và khác biệt. Lưới e-căng chất liệu cao cấp bằng linen được chọn lọc để hợp tông màu với da loa. Hàng nút chỉnh đầy đủ chức năng cho âm nhạc và ca hát.\u003c/p\u003e\n\u003cp\u003eThiết kế quai xách bọc da với chỉ may nổi rất phong cách. \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/f3/6b/1e/957ab49cf88c670beb826cecd3fb4fb5.png\" alt=\"\" width=\"600\" height=\"300\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTính năng kỹ thuật\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eLoa di động ưu việt nhất trong tầm giá. Sumico BTS52 là loa di động được thiết kế với tiêu chí hướng tới người sử dụng có yêu cầu cao về chất lượng âm thanh. \u003c/p\u003e\n\u003cp\u003eTổng công suất thực 100W rms với 2 kênh stereo. \u003c/p\u003e\n\u003cp\u003eTrang bị 4 củ loa: 2 loa bass 5.2”, 2 loa treble dome neo.\u003c/p\u003e\n\u003cp\u003eBố trí vị trí 2 loa treble 2 bên giúp tăng hiệu ứng stereo.\u003c/p\u003e\n\u003cp\u003eTrang bị các đường vào đa dạng đáp ứng thoả mãn mọi yêu cầu kết nối của khách hàng bao gồm: Bluethooth 5.0, Opical, HDMI, USB, SD Card, guitar, jack 6mm cho micro ngoài. \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/1b/fd/c3/6a105388bb27950a832a3470d6efce26.png\" alt=\"\" width=\"600\" height=\"300\" /\u003e\u003c/p\u003e\n\u003cp\u003eNgõ tín hiệu ra analog 3mm giúp dễ dàng kết nối loa với một loa khác để tăng công suất phục vụ.\u003c/p\u003e\n\u003cp\u003eNgoài khả năng xách tay di động loa còn có thể sử dụng như một dàn âm thanh cao cấp tại gia. Dễ dàng kết nối với smart tivi để xem phim và nghe nhạc. \u003c/p\u003e\n\u003cp\u003eĐược trang bị 2 micro  không dây chất lượng cao cùng hiệu ứng echo và cả reverb giúp bạn dễ dàng ca hát. \u003c/p\u003e\n\u003cp\u003eLoa có tay xách giúp dễ cầm nắm khi di chuyển.\u003c/p\u003e\n\u003cp\u003eBao bọc bằng một lớp da cao cấp đẹp mắt sang trọng nổi bật và hơn thế nữa loa được bảo vệ bởi 4 ốp góc giúp bảo vệ vỏ da và góc thùng loa. Đây là điểm vượt trội khi so sánh với các sản phẩm cùng tầm giá. \u003c/p\u003e\n\u003cp\u003eMột tiện ích vô cùng hữu dụng khi sử dụng là loa được trang bị 2 lỗ cắm micro giúp dễ dàng cất mic khi không sử dụng và khi di chuyển. \u003c/p\u003e\n\u003cdiv\u003eCó điều khiển từ xa đi k\u003c/div\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eÂm thanh của Sumico BT-S52 là một ưu điểm vượt trội. Âm bass mạnh mẽ sống động nhưng không bị ù dư bass như một số loa khác. Trung âm sáng rõ trung thực, tiếng treble mượt dịu không chói tai nhờ 2 củ loa treble dome\u003cstrong\u003e neodimyum \u003c/strong\u003echất lượng cao cấp dành cho audiophile.\u003c/p\u003e\n\u003cp\u003eLoa được trang bị nút Bass Boost giúp bạn thăng hoa với những bản nhạc remix, nhấn nút boost bạn sẽ có tiếng bass như sub 3 tấc. \u003c/p\u003e\n\u003cp\u003eNút MicPri ưu tiên giọng nói giúp loa sử dụng tốt cho việc thuyết trình hay dẫn chương trình cho event nhỏ. Nhấn nút MicPri tiếng nhạc sẽ tự nhỏ lại khi có tiếng nói vào micro. \u003c/p\u003e\n\u003cp\u003eLoa được trang bị pin lithium với thời lượng lên tới 8h sử dụng.\u003c/p\u003e\n\u003cp\u003eĐặc biệt hơn, cục pin có thể tháo rời giúp dễ dàng thay thế và tiện mang đi theo những chuyến bay của bạn. \u003c/p\u003e\n\u003cp\u003eTóm lại Sumico BT-S52 là một chiếc loa di động với nhiều điểm ưu việt vượt trội mà không có loại loa nào trên thì trường hội tụ đầy đủ những ưu điểm như loa này. \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cdiv\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/9f/6a/54/20bf6bec53529f1c69632cda4b118822.png\" alt=\"\" width=\"600\" height=\"300\" /\u003eC\u003c/div\u003e\n\u003cdiv\u003e \u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/9e/df/f3/9b71b9d049fa7168823687a079fb4b02.png\" alt=\"\" width=\"558\" height=\"279\" /\u003e\u003c/div\u003e\n\u003cdiv\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/5b/ee/7e/824b2e1f5159d7ee997d2d46d2a95c4c.jpg\" alt=\"\" width=\"600\" height=\"338\" /\u003e\u003c/div\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cdiv\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/f6/b1/04/d27e3ed38c352da5020c48b8db878a61.png\" alt=\"\" width=\"600\" height=\"300\" /\u003e\u003c/div\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/b6/18/62/feada076144061f1ca718ca98896b0bd.png\" alt=\"\" width=\"600\" height=\"300\" /\u003e\u003c/p\u003e\n\u003cdiv\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/97/ce/42/3a7ed510f30fdf99400a8bcf9b3663f2.png\" alt=\"\" width=\"600\" height=\"300\" /\u003e\u003ch2 dir=\"ltr\"\u003e\u003cstrong\u003eThông số kỹ thuật Sumico BT-S52\u003c/strong\u003e\u003c/h2\u003e\n\u003cul\u003e\u003cli dir=\"ltr\"\u003e\n\u003cp dir=\"ltr\"\u003eModel: BT-S52\u003c/p\u003e\n\u003c/li\u003e\n\u003cli dir=\"ltr\"\u003e\n\u003cp dir=\"ltr\"\u003eThương hiệu: Sumico - Việt Nam\u003c/p\u003e\n\u003c/li\u003e\n\u003cli dir=\"ltr\"\u003e\n\u003cp dir=\"ltr\"\u003eLoại: loa di động\u003c/p\u0