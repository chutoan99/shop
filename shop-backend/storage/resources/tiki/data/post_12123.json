con_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":95000,"discount_rate":15,"rating_average":4.7,"review_count":45,"review_text":"(45)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/30/5e/ae/e96dbdb2e4117bdf9acffe3bbffd35f6.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2623,"all_time_quantity_sold":560,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<h3>Chất liệu cao cấp</h3>\r\n<p>Nồi cơm điện Midea CM06SA có kiểu dáng nhỏ gọn, hiện đại, mang lại nét tinh tế cho không gian bếp. Thiết kế lòng nồi làm bằng chất liệu hợp kim nhôm cao cấp dày 1.0mm , bền và truyền nhiệt nhanh, ít tốn điện. Lòng nồi được phủ lớp chống dính nên việc vệ sinh nồi sẽ dễ dàng hơn vì cơm không bị cháy khét hay bám dính vào nồi.</p>\r\n<p style=\"text-align: center;\"><img title=\"Nồi Cơm Điện Midea CM06SA\" src=\"http://tikicdn.com/media/catalog/product/c/h/chat-lieu-cao-cap.u2769.d20161010.t101425.157016.jpg\" alt=\"Nồi Cơm Điện Midea CM06SA\" width=\"650\" height=\"433\" /></p>\r\n<h3>Dung tích 0.6L</h3>\r\n<p>Dung tích 0.6 lít hoàn toàn phù hợp cho những gia đình nhỏ hoặc những ai độc thân.</p>\r\n<p style=\"text-align: center;\"><img title=\"Nồi Cơm Điện Midea CM06SA\" src=\"http://tikicdn.com/media/catalog/product/d/u/dung-tich-0.u2769.d20161010.t101425.221445.jpg\" alt=\"Nồi Cơm Điện Midea CM06SA\" width=\"650\" height=\"433\" /></p>\r\n<h3>Sử dụng đơn giản, nấu hâm tự động</h3>\r\n<p>Nồi cơm điện Midea CM06SA hoạt động đơn giản với chỉ một nút bấm. Tự động giới hạn nhiệt, tự động giữ ấm, giữ ấm ở thời gian dài duy trì dưỡng chất tốt nhất của hạt cơm.</p>\r\n<p style=\"text-align: center;\"><img title=\"Nồi Cơm Điện Midea CM06SA\" src=\"http://tikicdn.com/media/catalog/product/h/o/hoat-dong-don-gian.u2769.d20161010.t101425.250758.jpg\" alt=\"Nồi Cơm Điện Midea CM06SA\" width=\"650\" height=\"433\" /></p>\r\n<h3>Công nghệ Fuzzy logic giữ nguyên 100% chất dinh dưỡng</h3>\r\n<p>Nồi sử dụng công nghệ hiện đại Fuzzy Logic cùng hệ thống kiểm soát nhiệt độ và thời gian, tạo “áp suất thấp, nhiệt độ cao”, nấu cơm nhanh hơn và giữ nguyên 100% dinh dưỡng của gạo.</p>\r\n<p style=\"text-align: center;\"><img title=\"Nồi Cơm Điện Midea CM06SA\" src=\"http://tikicdn.com/media/catalog/product/c/o/cong-nghe-fuzzy-logic.u2769.d20161010.t101425.196046.jpg\" alt=\"Nồi Cơm Điện Midea CM06SA\" width=\"650\" height=\"433\" /></p>\r\n<p style=\"text-align: center;\"><strong><span style=\"color: #ff9900;\">GIÁ SẢN PHẨM ĐÃ BAO GỒM VAT, BẢO HÀNH 12 THÁNG</span></strong></p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/30/5e/ae/e96dbdb2e4117bdf9acffe3bbffd35f6.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/30/5e/ae/e96dbdb2e4117bdf9acffe3bbffd35f6.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/30/5e/ae/e96dbdb2e4117bdf9acffe3bbffd35f6.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/30/5e/ae/e96dbdb2e4117bdf9acffe3bbff