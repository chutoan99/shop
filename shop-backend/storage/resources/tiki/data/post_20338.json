l,"text":"9.9"},{"placement":"pdp_badge","code":"is_hero","type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":true,"return_reason":"any_reason"}},"discount":795000,"discount_rate":50,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/2e/fd/57/9f0644a9ff39b1e0b2320325f73e2e16.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":401,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"Quần dài thể thao nam Venum Assassin'S Creed (Tbc) - VENUM-04486-001\n\u003cbr /\u003eĐặc điểm nổi bật: QUẦN DÀI NAM VENUM ASSASSIN'S CREED (TBC)\n\u003cbr /\u003eQuần jogger Venum x Assassin’s Creed là tất cả về thời trang dạo phố với phong cách Venum hoàn hảo.\n\u003cbr /\u003eSử dụng chất liệu thoải mái, đường cắt vừa vặn và những nét chấm phá về màu sắc tinh tế mang đến cho sản phẩm một phong cách tinh tế, độc đáo. Người chạy bộ được giữ ở tư thế thoải mái nhờ dây thắt lưng co giãn.\n\u003cbr /\u003eNhững chiếc quần thể thao này sẽ kết hợp hoàn hảo với các sản phẩm khác trong bộ sưu tập.\n\u003cbr /\u003eTHÔNG SỐ \n\u003cp\u003eKiểu dáng vừa vặn (slim fit)\u003cbr /\u003eThắt lưng co giãn thoải mái\u003cbr /\u003eDây rút điều chỉnh sự vừa vặn\u003cbr /\u003eNhãn Assassin’s Creed by Venum bằng chất liệu giả da, khâu trên túi\u003cbr /\u003eGiặt ở nhiệt độ 30°C - không sấy khô\u003cbr /\u003eChất liệu: cotton polyester\u003cbr /\u003eMã sản phẩm: VENUM-04486-001\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eNơi sản xuất: Hàng sản xuất ở nước thứ 3 tùy từng lô hàng (Việt Nam, Trung Quốc, Ấn Độ, C)\u003c/p\u003e\n\u003cp\u003eHướng dẫn bảo quản:\u003cbr /\u003e• Hạn chế không nên để sản phẩm tiếp xúc nhiều với chất bẩn, đặc biệt là các chất bẩn cứng đầu như máu, cà phê, nhựa trái cây…\u003cbr /\u003e• Bảo quản sản phẩm ở nơi khô ráo, thoáng mát… để tránh các loại nấm mốc. (Nếu không sử dụng thường xuyên thì nên bỏ vào bao ni lông bịt kín hoặc hộp đựng.)\u003cbr /\u003e• Nên sử dụng khuôn hoặc nhét giấy báo cũ vào bên trong để luôn giữ được hình dạng ban đầu (đối với sản phẩm giày dép)\u003cbr /\u003e• Không nên phơi sản phẩm dưới nắng quá gắt. \u003c/p\u003e\n\u003cp\u003eChính sách đổi trả: Áp dụng theo chính sách của sàn\u003c/p\u003e\n\u003cp\u003eChính sách bảo hành: Không bảo hành\u003c/p\u003e\n\u003cp\u003eXuất xứ thương hiệu: Hồng Kong\u003c/p\u003e\n\u003cp\u003eThông Tin Thương Hiệu:\u003cbr /\u003eMùa hè năm 2005, Franck Dupuis giới thiệu một thương hiệu mới. Thương hiệu này sẽ cung cấp những gì mà thế giới thể thao chiến đấu còn thiếu: chất lượng và những thiết kế nguyên bản. Venum ra đời. Venum đã cho ra đời nhiều bộ sưu tập trong thi đấu, tập luyện với thiết kế độc đáo và sáng tạo. Một thương hiệu táo bạo theo tiêu chuẩn công nghiệp hàng đầu, nhưng điều khác biệt của Venum so với các đối thủ cạnh tranh là khả năng cải tiến, đổi mới luôn nằm trong tâm, nằm trong DNA của thương hiệu.\u003cbr /\u003eThông Tin Nhà Phân Phối:\u003cbr /\u003eSupersports là hệ thống bán lẻ hàng đầu và chuyên phân phối các mặt hàng về thể thao tại Thái Lan và là hệ thống thuộc tập đoàn Central Retail. Supersports mang đến rất nhiều lựa chọn về giày dép và quần áo, máy tập thể dục và phụ kiện thể thao từ các thương hiệu nổi tiếng thế giới. Supersports tự hào mang đến sản phẩm chất lượng tốt và dịch vụ đặc biệt cho Việt Nam.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/2e/fd/57/9f0644a9ff39b1e0b2320325f73e2e16.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/2e/fd/57/9f0644a9ff39b1e0b2320325f73e2e16.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/2e/fd/57/9f0644a9ff39b1e0b2320325f73e2e16.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2e/fd/57/9f0644a9ff39b1e0b2320325f73e2e16.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2e/fd/57/9f0644a9ff39b1e0b2320325f73e2e16.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/78/b8/0f/29ef0954b14cd397c0f5c7fdc6b80e70.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/78/b8/0f/29ef0954b14cd397c0f5c7fdc6b80e70.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/78/b8/0f/29ef0954b14cd397c0f5c7fdc6b80e70.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/78/b8/0f/29ef0954b14cd397c0f5c7fdc6b80e70.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/78/b8/0f/29ef0954b14cd397c0f5c7fdc6b80e70.jpg"},{"base_url":"https://sal