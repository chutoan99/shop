p_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/59/07/6f/2a1de74a0aa2624a7f27db3a131266dd.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":867,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eSerum Sáng Da Ngừa Mụn EKSEPTION Hyaluronic Niacin phù hợp với mọi loại da, đặc biệt có lợi cho da lão hóa hoặc mụn nhẹ. Serum này thích hợp cho những ai đang muốn tái tạo sức sống cho làn da, nuôi dưỡng và giảm các dấu hiệu lão hóa.\u003c/p\u003e\n\u003cp\u003eSerum chứa thành phần Axit Hyaluronic XS, một HA trọng lượng phân tử thấp đi sâu vào lớp biểu bì và sự pha trộn của các axit trái cây tự nhiên giúp chống lại các dấu hiệu lão hóa một cách hiệu quả.\u003c/p\u003e\n\u003cp\u003eKết hợp với Niacinamide 5% được chứng minh có tác dụng ngừa mụn tương tự như Clindamycin – một chất kháng sinh phổ biến hiệu quả trong việc tr ị mụn trứng cá được bác sĩ tin dùng.\u003c/p\u003e\n\u003cp\u003eMang lại cảm giác phong phú và giàu dinh dưỡng mặc dù nó không chứa dầu và có cảm giác mịn màng và không bết dính sau khi thoa.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/a5/d2/5d/5934fdd269d5674a1ee4a26ac91a9e86.jpg\" alt=\"\" width=\"750\" height=\"750\"\u003e\u003c/p\u003e\n\u003ch4\u003e\u003cstrong\u003e CÔNG DỤNG\u003c/strong\u003e\u003c/h4\u003e\n\u003cp\u003eSerum Sáng Da Ngừa Mụn EKSEPTION Hyaluronic Niacin hỗ trợ:\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eCung cấp độ ẩm, chống lão hóa.\u003c/li\u003e\n\u003cli\u003eCải thiện làn da bị vấn đề sắc tố, không đều màu.\u003c/li\u003e\n\u003cli\u003ePhục hồi hàng rào bảo vệ da.\u003c/li\u003e\n\u003cli\u003eGiảm tình trạng mụn và thu nhỏ lỗ chân lông.\u003c/li\u003e\n\u003cli\u003eLàm dịu da bị kích ứng, giảm mẩn đỏ.\u003c/li\u003e\n\u003cli\u003eDành cho tất cả các loại da.\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e THÀNH PHẦN Serum Sáng Da Ngừa Mụn EKSEPTION Hyaluronic Niacin\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003e5% Niacinamide\u003c/strong\u003e: Làm trắng sáng da, giảm đỏ, giảm kích ứng và tăng cường phục hồi cấp ẩm cho làn da; hỗ trợ giảm thâm sau mụn; đặc biệt các nốt thâm đỏ, tăng sắc tố; còn được chứng minh ngăn ngừa mụn break-out, kích ứng, an toàn cho làn da nhạy cảm\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003e2% Hyaluronic Acid\u003c/strong\u003e: Tăng cường giữ ẩm, làm mềm mịn và căng bóng da.\u003c/li\u003e\n\u003c/ul\u003e\u003ch4\u003e\u003cstrong\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/e1/e8/c3/4efbb621a48189a874cb905d43e19d74.png\" alt=\"\" width=\"750\" height=\"750\"\u003e\u003c/strong\u003e\u003c/h4\u003e\n\u003ch4\u003e\u003cstrong\u003e CÁCH SỬ DỤNG\u003c/strong\u003e\u003c/h4\u003e\n\u003cul\u003e\u003cli\u003eRửa mặt sạch trước khi sử dụng.\u003c/li\u003e\n\u003cli\u003eLấy một lượng serum vừa đủ ra lòng bàn tay, Chấm 5 điểm và thoa đều khắp mặt sau đó vỗ nhẹ cho serum thẩm thấu sâu vào da (tránh tiếp xúc với vùng viền mắt và mí mắt trên).\u003c/li\u003e\n\u003cli\u003eSử dụng 2 lần vào buổi sáng và tối.\u003c/li\u003e\n\u003c/ul\u003e\u003ch4\u003e\u003cstrong\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/de/b4/f0/606c9897c555e94be9fe0f3353563345.jpg\" alt=\"\" width=\"750\" height=\"621\"\u003e\u003c/strong\u003e\u003c/h4\u003e\n\u003ch4\u003e\u003cstrong\u003e LƯU Ý KHI SỬ DỤNG SẢN PHẨM\u003c/strong\u003e\u003c/h4\u003e\n\u003cul\u003e\u003cli\u003eChống chỉ định các trường hợp mụn viêm năng, nhiễm khuẩn, mụn quá phát chưa kiểm soát\u003c/li\u003e\n\u003cli\u003eTác dụng có thể khác nhau tùy cơ địa khác nhau của người dùng\u003c/li\u003e\n\u003cli\u003eTránh cho dung dịch tiếp xúc với niêm mạc hoặc các vết thương hở\u003c/li\u003e\n\u003cli\u003eTránh xa tầm tay của trẻ em\u003c/li\u003e\n\u003cli\u003eTránh tiếp xúc trực tiếp với ánh nắng mặt trời, bảo quản nơi khô ráo thoáng mát\u003c/li\u003e\n\u003cli\u003eTránh tiếp xúc với mắt\u003c/li\u003e\n\u003c/ul\u003e\u003ch4\u003e\u003cstrong\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/aa/d2/ba/47dd8e5e66a0560da6d24d35fabaa6ee.png\" alt=\"\" width=\"750\" height=\"750\"\u003e\u003c/strong\u003e\u003c/h4\u003e\n\u003ch4\u003e\u003cstrong\u003e THÔNG TIN SẢN PHẨM\u003c/strong\u003e\u003c/h4\u003e\n\u003cul\u003e\u003cli\u003eTên sản phẩm: Ekseption Hyaluronic Niacin\u003c/li\u003e\n\u003cli\u003eThương hiệu: Ekseption\u003c/li\u003e\n\u003cli\u003eXuất xứ: Tây Ban Nha\u003c/li\u003e\n\u003cli\u003eDung tích: 50ml\u003c/li\u003e\n\u003cli\u003eHạn sử dụng: Xem trên bao bì\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/0e/dd/b6/97d2af399e9bc68f77012b348cc9c923.jpg\" alt=\"\" width=\"700\" height=\"400\"\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/59/07/6f/2a1de74a0aa2624a7f27db3a131266dd.jpg","is_gallery":true,"label":null,"