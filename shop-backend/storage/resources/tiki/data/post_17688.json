:null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"defective_product"}},"discount":500000,"discount_rate":21,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/13/2f/c9/f75709541e2115df740182c185b27889.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":157,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eNhóm nước hoa: Hương Woody Aquatic\u003c/p\u003e\n\u003cp\u003eGiới tính: Nam\u003c/p\u003e\n\u003cp\u003eNăm ra mắt: 2023\u003c/p\u003e\n\u003cp\u003eNồng độ: Parfum\u003c/p\u003e\n\u003cp\u003ePhong Cách: Hấp Dẫn, Tươi Mát Tinh Tế, Sang Trọng\u003c/p\u003e\n\u003cp\u003eHương Đầu: Hương Biển, Cam Bergamot\u003c/p\u003e\n\u003cp\u003eHương Giữa: Hương Thảo, Cây Xô Thơm, Hoa Phong Lữ\u003c/p\u003e\n\u003cp\u003eHương Cuối: Tinh Dầu Trầm Hương, Hoắc Hương.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eGiorgio Armani Acqua Di Gio Parfum truyền đạt cảm giác về chiều sâu và sức mạnh, tạo ra một hình ảnh mạnh mẽ về thiên nhiên.\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"aligncenter wp-image-46452\" style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/eb/97/25/10e39e40c115e55ab4498e1012d49445.jpg\" alt=\"Giorgio Armani Acqua Di Gio Parfum - N - Nước hoa cao cấp, chính hãng giá tốt, mẫu mới\" width=\"500\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp\u003eGiorgio Armani Acqua Di Gio Parfum mang đến một hương thơm nam tính, thân thiện và dễ gần. Với hương đầu của Hương biển và cam bergamot, mang đến cảm giác mát lạnh như làn nước biển trong xanh, đầy sự sảng khoái.\u003c/p\u003e\n\u003cdiv class=\"x11i5rnm xat24cr x1mh8g0r x1vvkbs xtlvy1s x126k92a\"\u003e\n\u003cdiv\u003eTầng hương giữa của Giorgio Armani Acqua Di Gio Parfum gợi lên những tươi mát và năng động của hương thảo, một ít hoa phong lữ cùng với cây xô thơm tạo ra một tầng hương độc đáo, cuốn hút và hấp dẫn.\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"x11i5rnm xat24cr x1mh8g0r x1vvkbs xtlvy1s x126k92a\"\u003e\n\u003cdiv\u003eCuối cùng, tinh dầu trầm hương kết hợp với hoắc hương để tạo nên sự ấm áp, sâu lắng và đầy cảm súc. Tất cả những thành phần này hòa quyện với nhau, tạo nên một Giorgio Armani Acqua Di Gio Parfum tự nhiên, tinh tế và gợi cảm, đem lại cho người dùng một cảm giác thanh tao và sảng khoái và tươi mát.\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv\u003e\u003cimg class=\"aligncenter wp-image-46453\" style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/b2/1f/23/a66570042c149142b827d356f4b98df0.jpg\" alt=\"Giorgio Armani Acqua Di Gio Parfum 3 - N - Nước hoa cao cấp, chính hãng giá tốt, mẫu mới\" width=\"500\" height=\"667\" /\u003e\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/13/2f/c9/f75709541e2115df740182c185b27889.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/13/2f/c9/f75709541e2115df740182c185b27889.png","medium_ur