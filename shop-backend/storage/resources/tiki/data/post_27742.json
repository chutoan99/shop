lor":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":490000,"discount_rate":50,"rating_average":4,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ae/5e/33/95324659542a90b77206332c57873a34.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":551,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\n  \u003cp\u003eSở hữu những tính năng cải tiến mới nhất 2023 cùng thiết kế và màu sắc bắt mắt, nồi nấu chậm Unie USC08W chắc chắn sẽ là một trợ thủ bếp núc tuyệt vời giúp bạn nấu nhanh và tiện những món ngon dinh dưỡng.\u003c/p\u003e\n   \u003cp\u003ePhương pháp nấu cách thủy: Giữ trọn vẹn dưỡng chất\u003c/p\u003e\n   \u003cp\u003ePhương pháp nấu chậm được rất nhiều gia đình sử dụng, đặc biệt là với những gia đình có trẻ nhỏ hoặc người già, thường xuyên nấu những món ăn dinh dưỡng như: cháo, yến chưng hay các món hấp, tiềm, kho,…\u003c/p\u003e\n   \u003cp\u003e6 chức năng: Nấu đa dạng món ngon dinh dưỡng\u003c/p\u003e\n   \u003cp\u003eCác tính năng tự động của USC08W gồm có:\u003c/p\u003e\n   \u003cp\u003eNấu cháo: 1,5 giờ\u003c/p\u003e\n   \u003cp\u003eHầm canh: 2,5 giờ\u003c/p\u003e\n   \u003cp\u003eChưng yến: 1,0 giờ \u003c/p\u003e\n   \u003cp\u003eTrứng hấp: 0,4 giờ\u003c/p\u003e\n   \u003cp\u003eSúp: 0,8 giờ\u003c/p\u003e\n   \u003cp\u003eGiữ ấm\u003c/p\u003e\n   \u003cp\u003eHẹn giờ tới 12 tiếng: Nấu nướng rảnh tay hơn\u003c/p\u003e\n   \u003cp\u003eChất liệu cao cấp: An toàn và bền bỉ\u003c/p\u003e\n   \u003cp\u003eThố nấu gốm ceramic chất lượng cao, không chỉ an toàn cho sức khỏe mà còn có khả năng chống dính, không lo bám bẩn hay cháy khét. Với dung tích 800ml, chiếc nồi này hoàn toàn có thể phục vụ tốt cho những bữa cháo dinh dưỡng, những tô yến chưng, chim tiềm, bò hầm bổ dưỡng cho 1-2 người thưởng thức.\u003c/p\u003e\n   \u003cp\u003eThố sứ còn được thiết kế thêm với quai cầm chống nóng, giúp việc lấy đồ ăn ra trở nên dễ dàng và an toàn hơn, không lo nóng, bỏng.\u003c/p\u003e\n   \u003cp\u003eTính năng hấp tiện lợi\u003c/p\u003e\n   \u003cp\u003eNgoài chức năng nấu cách thủy, nồi nấu chậm Unie USC08W còn cải tiến thêm tính năng hấp tiện lợi.\u003c/p\u003e\n   \u003cp\u003eVới phụ kiện xửng hấp trứng đi kèm, bạn có thể làm món trứng hấp dễ dàng hoặc hấp bánh, hấp khoai,… nhanh chóng, tiện lợi. Chất liệu nhựa an toàn chịu nhiệt mang đến sự an toàn và chất lượng tuyệt đối cho mọi món ăn.\u003c/p\u003e\n   \u003cp\u003eThiết kế nhỏ gọn, xinh xắn\u003c/p\u003e\n   \u003cp\u003eNồi nấu chậm Unie USC08W được đánh giá là mẫu nồi có thiết kế nhỏ gọn và trendy nhất trên thị trường. Với kiểu dáng bắt mắt, màu sắc nhẹ nhàng, trang nhã, USC08W chắc chắn phù hợp với mọi căn bếp và tô điểm thêm cho không gian nấu nướng thêm phần cảm hứng.\u003c/p\u003e\n   \u003cp\u003eThông số kỹ thuật\u003c/p\u003e\n   \u003cp\u003eModel: USC08W \u003c/p\u003e\n   \u003cp\u003eĐiện áp: 220V-240V/50Hz \u003c/p\u003e\n   \u003cp\u003eCông suất: 200W \u003c/p\u003e\n   \u003cp\u003eDung tích : 800ml \u003c/p\u003e\n   \u003cp\u003eKích thước: 187x187x211mm\u003c/p\u003e\n   \u003cp\u003eBảo hành: 12 tháng\u003c/p\u003e\n  \u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ae/5e/33/95324659542a90b77206332c57873a34.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ae/5e/33/95324659542a90b77206332c57873a34.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ae/5e/33/95324659542a90b77206332c57873a34.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ae/5e/33/95324659542a90b77206332c57873a34.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ae/5e/33/95324659542a90b77206332c57873a34.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/82/b1/fd/c5495007605cc2821b328fe063242fd0.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/82/b1/fd/c5495007605cc2821b328fe063242fd0.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/82/b1/fd/c5495007605cc2821b328fe063242fd0.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/82/b1/fd/c5495007605cc2821b328fe063242fd0.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/82/b1/fd/c5495007605cc2821b328fe063242fd0.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/d2/ba/fc/024ce19b3099d2568aafd035b2aaeebe.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d2/ba/fc/024ce19b3099d2568aafd035b2aaeebe.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d2/ba/fc/024ce19b3099d2568aafd035b2aaeebe.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d2/ba/fc/024ce19b3099d2568aafd035b2aaeebe.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d2/ba/fc/024ce19b3099d2568aafd035b2aaeebe.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/8e/a2/19/6d19ce56aa7928be51612a2cc055e110.jpg","is_galle