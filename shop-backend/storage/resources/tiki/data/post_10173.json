4.1,"review_count":8,"review_text":"(8)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/media/catalog/product/i/m/img107.u547.d20170223.t143316.223415.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2753,"all_time_quantity_sold":215,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p style=\"text-align:justify;\"><span style=\"font-size:medium;color:#ff6600;\"><strong>Hướng Dẫn Sửa Chữa - Bảo Trì  Xe Ô Tô Đời Mới</strong></span></p>\n<p style=\"text-align:justify;\"><strong>Hướng dẫn sữa chữa - bảo trì xe hơi đời mới</strong> . Sách gồm 10 Chương.</p>\n<p style=\"text-align:justify;\">Chương 1: Những điều cơ bản. Chương 2: Hệ thống nhiên liệu. Chương 3: Động cơ. Chương 4: Hệ thống điện. Chương 5: Hệ thống làm nguội. Chương 6: Hệ thống truyền động. Chương 7: Hệ thống treo và lái. Chương 8: Vỏ xe và mâm bánh xe. Chương 9: Thắng. Chương 10: Hệ thống xả.</p>\n<p style=\"text-align:justify;\">Hy vọng cuống sách sẽ giúp bạn tự chăm sóc chiếc xe của mình, giúp bạn tiết kiệm được số tiền do việc tự bảo trì và sửa chữa những sự cố đơn giản chắc chắn không nhỏ. Qua đó, bạn sẽ phát hiện sớm những hư hỏng sắp xảy ra, ngăn chặn các hư hỏng lớn, hạn chế tình huống nằm đường đến mức thấp nhất.</p>\n<p style=\"text-align:justify;\">Sách được viết dưới dạng cẩm nang dành cho tài xế, gồm 46 bài thực hành và các lý thuyết cơ bản, có thể giúp các bạn chẩn đoán, sửa chữa và bảo trì chiếc xe thân yêu của mình.</p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/media/catalog/product/i/m/img107.u547.d20170223.t143316.223415.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/i/m/img107.u547.d20170223.t143316.223415.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/i/m/img107.u547.d20170223.t143316.223415.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/i/m/img107.u547.d20170223.t143316.223415.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/i/m/img107.u547.d20170223.t143316.223415.jpg"}],"warranty_policy":null,"authors":[{"id":110989,"name":"Tăng Văn Mùi - Trần Duy Nam","slug":"tang-van-mui-tran-duy-nam"}],"current_seller":{"id":39,"sku":"2445622030635","name":"Trí Dân","link":"https://tiki.vn/cua-hang/tri-dan","logo":"30/d2/46/30d24691868937032a55d28471d2aca0.jpg","price":65000,"product_id":"581993","store_id":62,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Thông tin chung","attributes":[{"code":"publisher_vn","name":"Công ty phát hành","value":"Trí Dân"},{"code":"publication_date","name":"Ngày xuất bản","value":"2010-09-12 00:00:00"},{"code":"dimensions","name":"Kích thước","value":"19 x 27 cm "},{"code":"book_cover","name":"Loại bìa","value":"Bìa mềm"},{"code":"number_of_page","name":"Số trang","value":"149"},{"code":"manufacturer","name":"Nhà xuất bản","value":"Nhà Xuất Bản Khoa học và Kỹ thuật"}]}],"product_links":[],"gift_item_title":"0 quà tặng kèm","services_and_promotions":[],"promitions":[],"stock_item":{"max_sale_qty":1000,"min_sale_qty":1,"preorder_date":null,"qty":1000},"quantity_sold":{"text":"Đã bán 215","value":215},"categories":{"id":67886,"name":"Kỹ Thuật Ô Tô - Xe máy","is_leaf":true},"breadcrumbs":[{"url":"/nha-sach-tiki/c8322","name":"Nhà Sách Tiki","category_id":8322},{"url":"/sach-truyen-tieng-viet/c316","