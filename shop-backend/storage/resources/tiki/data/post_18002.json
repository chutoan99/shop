_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/c2/7e/ec/2f40e5ca9550eeef230a1bad43b25f06.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1178,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch4\u003e\u003cstrong\u003eSự lựa chọn hoàn hảo\u003c/strong\u003e\u003cbr /\u003eRazer Orochi V2 — chuột gaming không dây siêu gọn nhẹ có thời lượng pin ấn tượng,trọng lượng siêu nhẹ 59g, lên đến 900 giờ sử dụng chỉ với duy nhất một pin AA. Được trang bị công nghệ không dây Razer HyperSpeed có độ trễ cực thấp và switch cơ học Razer Mechanical Mouse thế hệ thứ 2, Orochi V2 kết hợp hiệu năng và trải nghiệm thoải mái trong một thiết kế nhỏ gọn, lý tưởng cho các game thủ chuyên dùng notebook.\u003c/h4\u003e\n\u003ch4\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/be/42/cf/438a72b29f99bcf973106b94ebdadf8b.jpg\" alt=\"\" /\u003e\u003c/h4\u003e\n\u003ch4\u003e \u003c/h4\u003e\n\u003ch4\u003e\u003cstrong\u003eThiết kế gọn nhẹ\u003c/strong\u003e\u003c/h4\u003e\n\u003ch4\u003eVới trọng lượng chưa đến 60 gram (chưa bao gồm pin), thiết kế siêu nhẹ của Orochi V2 được tạo ra bởi đội ngũ kỹ sư chuyên môn cao của Razer. Hãng không ngừng cải tiến từ những phản hồi của cộng đồng đam mê chuột gaming để cho ra đời một thiết kế chuột đối xứng, phù hợp với đa dạng kiểu cầm nắm. Razer mang đến cho các game thủ một dòng chuột gaming xách tay tiện dụng, hiệu năng cao mà vẫn gọn nhẹ, vừa đủ để cất vào túi quần hay balo. Công nghệ Razer HyperSpeed hỗ trợ kết nối đa thiết bị, cho phép các game thủ kết nối Razer Orochi V2 và thêm một bàn phím không dây khác với máy chủ chỉ qua một USB dongle, tiết kiệm một cổng USB còn lại cho các mục đích sử dụng khác.\u003c/h4\u003e\n\u003ch4\u003e\u003cimg id=\"MTYyNDA0NzY3MS4xNTUy\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/f8/25/7e/b367397c70add624ad5b5ef706fe38d7.jpg\" alt=\"\" /\u003e\u003c/h4\u003e\n\u003ch4\u003e \u003c/h4\u003e\n\u003ch4\u003e\u003cstrong\u003ePhù hợp với mọi kiểu cầm chuột\u003c/strong\u003e\u003c/h4\u003e\n\u003ch4\u003eĐuôi chuột thuôn nhọn, đem lại cảm giác cầm nắm chắc chắn, cho thao tác lướt nhanh và dễ kiểm soát. Trong khi đó, lưng chuột thiết kế hình vòm, nhô cao nâng đỡ lòng bàn tay, cho phép người dùng chơi game lâu mà không bị mỏi. Chuột Orochi V2 còn được thiết kế lõm nhẹ ở vị trí đặt ngón cái giúp bám chuột tốt hơn. Ngoài ra, các nút bên hông chuột được bố trí hợp lý để người dùng sử dụng một cách dễ dàng, kể cả trong công việc hay giải trí với game.\u003c/h4\u003e\n\u003ch4\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/46/58/7e/93773df40aac0fd10d8d939a851b7d9e.jpg\" alt=\"\" /\u003e\u003c/h4\u003e\n\u003ch4\u003e \u003c/h4\u003e\n\u003ch4\u003e\u003cstrong\u003eHiệu năng bền bỉ\u003c/strong\u003e\u003c/h4\u003e\n\u003ch4\u003eChỉ cần thêm một pin AA hoặc AAA, chuột Orochi V2 có sẵn khe cắm pin kép nhằm tối ưu hóa việc phân bổ trọng lượng. Thiết bị cho hiệu suất lên đến 900 giờ sử dụng liên tục với chế độ kết nối Bluetooth, một sự lựa chọn lý tưởng khi sử dụng các thiết bị di động. Ngoài ra, game thủ có thể lựa chọn công nghệ Razer HyperSpeed Wireless, cho phép trải nghiệm game liên tục trong 425 giờ mà không bị giật hay gián đoạn.\u003c/h4\u003e\n\u003ch4\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/5f/c9/30/80a3e0e9732564c2a29caa61e30304e9.jpg\" alt=\"\" /\u003e\u003c/h4\u003e\n\u003ch4\u003e \u003c/h4\u003e\n\u003ch4\u003e\u003cstrong\u003eCông nghệ tiên tiến\u003c/strong\u003e\u003c/h4\u003e\n\u003ch4\u003eChuột Orochi V2 được trang bị Switch cơ học Razer thế hệ thứ hai, với các điểm tiếp xúc được mạ vàng giúp sản phẩm không bị xuống cấp và có tuổi thọ đạt đến 60 triệu lần bấm, mang đến trải nghiệm chơi game ổn định và sống động trên từng cú nhấp chuột. Bên cạnh đó, chuột Orochi V2 còn trang bị chân đế sản xuất từ 100% Teflon (PTFE) và cảm biến quang học 5G siêu nhạy, bổ trợ hoàn hảo cho bất kỳ người dùng máy tính xách tay nào có nhu cầu sử dụng chuột hiệu năng cao.\u003c/h4\u003e\n\u003ch4\u003e\u003cimg id=\"MTYyNDA0NzY3NC4xNTUy\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/4b/1b/c7/a38eef93c0d1e960f1017cc75b71901c.jpg\" alt=\"\" /\u003e\u003c/h4\u003e\n\u003ch4\u003e\u003cstrong\u003e---------------------------------------------------------\u003c/strong\u003e\u003c/h4\u003e\n\u003ch4\u003e\u003cu\u003e\u003cstrong\u003e3)Thông Số Kỹ Thuật\u003c/strong\u003e\u003c/u\u003e\u003c/h4\u003e\n\u003ctable class=\"table table-bordered\" border=\"1\" cellspacing=\"1\" cellpadding=\"1\"\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd\u003e\n\u003ch4\u003eThương hiệu\u003c/h4\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003ch4\u003eRazer\u003c/h4\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\n\u003ch4\u003eModel\u003c/h4\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003ch4\u003eRazer Orochi V2 - Black\u003c/h4\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\n\u003ch4\u003eKết nối\u003c/h4\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003ch4\u003eChế độ không dây kép (2.4GHz and BLE)\u003c/h4\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\n\u003ch4\u003eThời lượng pin\u003c/h4\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003ch4\u003eLên tới 425 giờ sử dụng (2.4Ghz), 950 giờ (BLE) kèm pin AA\u003c/h4\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\n\u003ch4\u003eSố nút\u003c/h4\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003ch4\u003eSáu nút nhấn có thể lập trình độc lập\u003c/h4\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003