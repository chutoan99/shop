/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":241000,"discount_rate":2,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/8f/d3/f4/a624755ec136394527290bb517682beb.jpeg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":798,"all_time_quantity_sold":30,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align:center;\"\u003e\u003cspan style=\"background-color:#ccffcc;\"\u003e\u003cstrong\u003eĐàn Piano điện/ Mobile Digital Piano - Artesia PA-88H+ (PA 88H+) - Màu đen - Hàng chính hãng\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003eĐàn piano Artesia PA-88H+ là một nhạc cụ tuyệt vời cho tất cả người chơi - từ người mới bắt đầu đến chơi chuyên nghiệp trên sân khấu!\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003ePA-88H+ có 88 phím kích thước và trọng lượng chuẩn mang lại cảm giác như thể bạn đang chơi một cây đàn piano cơ đích thực. Bàn phím này được thiết kế có tính đến tính linh động để đảm bảo trải nghiệm chơi chuyên nghiệp cho dù bạn cần luyện tập hay biểu diễn ở bất kì nơi đâu.\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003eKết nối với máy tính xách tay và máy tính bảng của bạn thật nhanh chóng và dễ dàng với USB MIDI Out, cho phép bạn kết nối với phần mềm ghi âm hoặc ứng dụng giáo dục yêu thích của mình.\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003ePA-88H+ cho phép bạn tùy chọn kết nối 1 pedal duy trì hay bộ 3 pedal.\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003eCác tính năng kết nối Line Out cho phép bạn kết nối với các loa bổ sung để biểu diễn trực tiếp hoặc kết nối tai nghe để chơi riêng tư hoặc luyện tập!\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/88/bd/03/39948b71da84a064b429e5088e183f31.jpg\" alt=\"\" width=\"750\" height=\"327\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e\u003cspan style=\"background-color:#ccffcc;\"\u003eProfessional Touch \u0026amp; Sound\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003eĐược trang bị 88 phím có trọng lượng và kích thước chuẩn, cảm giác âm thanh thực sự của bàn phím này mang lại phản hồi tốt với cảm giác bấm cực kỳ tự nhiên để mang lại khả năng chơi chuyên nghiệp được tối ưu. Các mẫu âm thanh 3D được ghi lại từ các nhạc cụ acoustic sẽ khiến bạn kinh ngạc với âm sắc phong phú, chất lượng cao. Chọn 1 trong 16 âm thanh của nhạc cụ chuẩn.\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/2e/34/39/52a35ef28a3b7d8260148d6dcdc56325.jpg\" alt=\"\" width=\"750\" height=\"600\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e\u003cspan style=\"background-color:#ccffcc;\"\u003e3-Pedal Option\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003ePA-88H+ cho phép bạn kết nối 1 bàn đạp duy trì hoặc bàn đạp ASP-3X3 của Artesia. ASP-3X3 là hệ thống 3 bàn đạp tiêu chuẩn với các chức năng Sustain, Soft và Sostenuto dành cho đàn piano của bạn.\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/7f/4f/a7/91ab87b29008c4161339adbfdfbfb486.jpg\" alt=\"\" width=\"750\" height=\"600\" /\u003e\u003cspan style=\"background-color:#ccffcc;\"\u003eUSB MIDI Connectivity\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003eKết nối với máy tính xách tay, máy tính bảng hoặc điện thoại thông minh của bạn để có vô số cơ hội trải nghiệm âm nhạc! Với cổng USB to Host MIDI, bạn có thể kết nối đàn piano của mình với nhiều loại ứng dụng học tập và phần mềm máy trạm âm thanh kỹ thuật số (DAW) để cho phép người dùng tham gia vào các hoạt động học tập hoặc ghi âm nhạc. Ghi một bài hát trực tiếp từ Artesia Piano thẳng vào máy tính xách tay của bạn!\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e\u003cbr /\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/d7/0c/42/fc31f92291805775f31e67ab51db0ba7.jpg\" alt=\"\" width=\"750\" height=\"600\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e\u003cspan style=\"background-color:#ccffcc;\"\u003eBult-in Sounds\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003eArtesia PA-88H+ được tích hợp sẵn 16 âm thanh và âm sắc để đảm bảo rằng bạn sẽ không phải lựa chọn khi sáng tạo! Chọn từ các âm thanh khác nhau, từ đại dương cầm âm thanh nổi cổ điển đến các loại đàn organ khác nhau, piano điện, đàn hạc, ghi-ta thép \u0026amp; nylon, đàn dây, hợp xướng, bass điện, v.v. Nó cũng bao gồm các chức năng reverb, chorus, metronome \u0026amp; tempo. Hãy để khả năng sáng tạo của bạn bay bổng với tất cả âm thanh có trong cây đàn này!\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/92/a3/ca/2a4f3b638fc33f9afe608b122f300303.jpg\" alt=\"\" width=\"750\" height=\"600\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/8f/d3/f4/a624755ec136394527290bb517682beb.jpeg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/8f/d3/f4/a624755ec136394527290bb517682beb.jpeg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/8f/d3/f4/a624755ec136394527290bb517682beb.jpeg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8f/d3/f4/a624755ec136394527290bb517682beb.jpeg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8f/d3/f4/a624755ec136394527290bb517682beb.jpeg"},{"base_url":"https://salt.tikicdn.com/ts/product/4d/25/4d/960f36718968209ef35f90edcf809e93.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/4d/25/4d/960f36718968209ef35f90edcf809e93.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/4d/25/4d/960f36718968209ef35f90edcf809e93.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4d/25/4d/960f36718968209ef35f90edcf809e93.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4d/25/4d/960f36718968209ef35f90edcf809e93.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/6a/e5/0f/d726f12297005c69d2a036a85cea1d7e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/6a/e5/0f/d726f12297005c69d2a036a85cea1d7e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/6a/e5/0f/d726f12297005c69d2a036a85cea1d7e.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6a/e5/0f/d726f12297005c69d2a036a85cea1d7e.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6a/e5/0f/d726f12297005c69d2a036a85cea1d7e.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/fc/a9/ff/69088d003ff28b1a8a17ed050d5394b5.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1