/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":640000,"discount_rate":26,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/26/f8/5a/eeeddfc0804387fe23a4be01ab288d45.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":415,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp class=\"irIKAp\"\u003e\u003cstrong\u003eLắp ráp và vận chuyển:\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Bộ sản phẩm được đóng gói dạng rời gồm các tấm gỗ được dán nhãn và đánh số kèm theo sơ đồ lắp ráp, đầy đủ phụ kiện, video. Bạn sẽ tiến hành lắp ráp theo hướng dẫn.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Trường hợp bạn không muốn thực hiện việc lắp ráp này, KEGODA có lựa chọn \"Ráp hoàn thiện sẵn\", vui lòng đặt mua \u003ca title=\"tại đây\" href=\"https://tiki.vn/tu-ban-phan-trang-diem-toi-gian-tinh-te-kegoda-p273376941.html?spid=273376957\"\u003etại đây\u003c/a\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Nếu có lỗi/hư hỏng (kể cả do lỗi vận chuyển), KEGODA cam kết gửi thay thế phần bị hỏng ngay khi nhận được yêu cầu.\u003c/p\u003e\n\u003cp\u003e— — — — — — — — —\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThông số: \u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Chất liệu: MDF bề mặt phủ Melamine kháng nước, bền màu, an toàn và sử dụng lâu dài.\u003c/p\u003e\n\u003cp\u003e- Màu sắc: Trắng; Vân gỗ sồi.\u003c/p\u003e\n\u003cp\u003e- Kích thước: 164 x 40 x 37.5 (Cao x Dài x Rộng).\u003c/p\u003e\n\u003cp\u003e- Thương hiệu: Kegoda.\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/28/9b/75/b42689e803e246c5a4ce56128e01ad44.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/18/92/de/19e4668f1c5ebfc426b2faaf31d82079.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e— — — — — — — — —\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cstrong\u003eĐiểm nổi bật:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Tủ gỗ được thiết kế với nhiều ngăn đa năng phối kèm gương trang điểm phía trên độc đáo và tiện lợi.\u003c/p\u003e\n\u003cp\u003e- Tủ trên rộng \u003cstrong\u003e13.5cm (sau gương) \u003c/strong\u003eđược chia nhiều ngăn giúp bạn có thể để mỹ phẩm, vật dụng make up cho bạn. Tủ dưới rộng đến \u003cstrong\u003e37.5cm sẽ \u003c/strong\u003echo không gian lưu trữ rộng rãi thoải mái.\u003c/p\u003e\n\u003cp\u003e- Ngăn kéo phía trên và tủ kéo phía dưới giúp bạn có thể lưu trữ các loại vật dụng gia đình, sách vở, đồ trang trí, \u003c/p\u003e\n\u003cp\u003e- Phù hợp đặt tại nhiều nơi: phòng khách, phòng ngủ. Tủ gương trang điểm sẽ là vật dụng trang trí phù hợp và cần thiết cho ngôi nhà của bạn.\u003c/p\u003e\n\u003cp\u003e- Các cạnh trước \u0026amp; sau, trên \u0026amp; dưới đều được xử lý đẹp, đảm bảo an toàn và lâu bền trong quá trình sử dụng. \u003c/p\u003e\n\u003cp\u003e- Dễ dàng lắp đặt: Tủ gỗ sẽ đi kèm đầy đủ phụ kiện và hướng dẫn lắp đặt, kệ được khoan sẵn các mối liên kết (các thanh kệ được đánh dấu sẵn để bạn lắp theo thứ tự).\u003c/p\u003e\n\u003cp\u003e- Sử dụng lâu dài: Chất liệu MDF bề mặt phủ melamine loại tốt (căng, phẳng, dày và đồng màu).\u003c/p\u003e\n\u003cp\u003e- Sản phẩm sẽ được đóng gói cẩn thận \u0026amp; dày dặn đảm bảo an toàn trong quá trình vận chuyển.\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/03/e5/02/bc260cb06118159c88bdb7ea7c15192e.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/c4/8d/98/43dd10addd9a1ac04d0cc4e24076e7d5.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e- Màu sắc hiện đại và dễ dàng phối với nhiều phong cách khác nhau.\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/49/66/b9/b7edffca1b0b2b269b2b899c386437cf.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/64/1f/41/d27ff566a6de92767b76ffee3866e6c0.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/4d/25/31/7694ea1d31e50e331658011f59d946f9.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e— — — — — — — — —\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e\u003cstrong\u003e Hướng dẫn:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e- \u003c/strong\u003eGiấy hướng dẫn lắp ráp chi tiết và phụ kiện đi kèm trong sản phẩm.\u003c/p\u003e\n\u003cp\u003e- Video hướng dẫn lắp ráp xem tại đây:\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003ciframe src=\"//www.youtube.com/embed/1H5ht2psCME\" width=\"560\" height=\"314\" allowfullscreen=\"\"\u003e\u003c/iframe\u003e\u003c/p\u003e\n\u003cp\u003e- Hạn chế để kệ tiếp xúc trực tiếp với ánh nắng trực tiếp, nơi ẩm ướt. Nên lau khô ngay khi sản phẩm tiếp xúc với nước.\u003c/p\u003e\n\u003cp\u003e- Sử dụng các chất tẩy rửa chuyên dụng để không làm mất độ thẩm mỹ của bề mặt.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eDịch vụ sau bán hàng:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Bảo hành 1 đổi 1 miễn phí theo chính sách của tiki nếu sản phẩm có lỗi kĩ thuật hoặc do lỗi vận chuyển\u003c/p\u003e\n\u003cp\u003e- Bảo hành chất lượng sản phẩm 24 tháng. Bảo trì và hỗ trợ khách hàng trọn đời.\u003c/p\u003e\n\u003cp\u003e— — — — — — — — —\u003c/p\u003e\n\u003cdiv\u003e\n\u003cp\u003e- Sản phẩm được sản xuất tại: Công ty TNHH Trang Trí Nội Thất Đơn Giản Là Đẹp\u003c/p\u003e\n\u003cp\u003e- Xuất xứ: Việt Nam\u003c/p\u003e\n\u003carticle class=\"4ever-article\"\u003e\n\u003cp\u003e\u003cstrong\u003e Welcome to KEGODA\u003c/strong\u003e\u003c/p\u003e\n\u003c/article\u003e\n\u003cp\u003eKEGODA là thương hiệu thuộc Công ty TNHH Trang Trí Nội Thất Đơn Giản Là Đẹp, cam kết mang đến cho bạn những sản phẩm đồ gỗ nội thất chất lượng cao với chi phí tiết kiệm. Chúng tôi luôn sẵn sàng lắng nghe và làm việc chăm chỉ để có thể phục vụ bạn tốt hơn mỗi ngày. Bạn luôn được chào đón.\u003c/p\u003e\n\u003carticle class=\"4ever-article\"\u003e\n\u003cp\u003e\u003cstrong\u003eNếu bạn hài lòng với sản phẩm của KEGODA, hy vọng bạn có thể dành tặng KEGODA đánh giá tốt 5 sao.\u003c/strong\u003e\u003c/p\u003e\n\u003c/article\u003e\n\u003c/div\u003e\n\u003cdiv class=\"preview-container\"\u003e\n\u003cdiv class=\"panel\"\u003e\n\u003cdiv class=\"panel-content\"\u003e\n\u003cdiv class=\"preview-container\"\u003e\n\u003cdiv class=\"panel\"\u003e\n\u003cdiv class=\"panel-content\"\u003e#kegoda #decor #kego #bango #bàn #bantrangdiem #bàn_trang_điểm #banphan #bàn_phấn #hiendai #MDF #wooden #makeuptable #chalkboard #woodtable #tủ #shelves\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao 