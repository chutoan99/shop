f":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"defective_product"}},"discount":620000,"discount_rate":26,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/c4/cf/ca/76347f4398199e822a1229179e3ab851.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2001,"all_time_quantity_sold":11,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eNhóm nước hoa: Hương hoa cỏ phương đông\u003c/p\u003e\n\u003cp\u003eGiới tính: Nữ\u003c/p\u003e\n\u003cp\u003eNăm ra mắt: 2011\u003c/p\u003e\n\u003cp\u003eNồng độ: EDP\u003c/p\u003e\n\u003cp\u003ePhong Cách: Tươi Mát, Gợi Cảm, Tinh Tế.\u003c/p\u003e\n\u003cp\u003ePhong cách: Lãng mạn , Chững chạc , Gần gũi\u003c/p\u003e\n\u003cp\u003eHương Đầu: Quả chanh vàng Amalfi, Quả Yuzu, Hương trái cây\u003c/p\u003e\n\u003cp\u003eHương giữa: Hoa nhài, Hoa cam Châu Phi, Hoa sen\u003c/p\u003e\n\u003cp\u003eHương cuối: Gỗ đàn hương, Cây hoắc hương, Gỗ tuyết tùng Virginia, Hương Va ni (Vanille)\u003c/p\u003e\n\u003cdiv class=\"x11i5rnm xat24cr x1mh8g0r x1vvkbs xdj266r x126k92a\"\u003e\n\u003cdiv\u003eTrussardi Donna – Đẹp như tranh, thơm ngất ngây, Sự lan tỏa của hương thơm đậm CHẤT Á\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"x11i5rnm xat24cr x1mh8g0r x1vvkbs xtlvy1s x126k92a\"\u003e\n\u003cdiv\u003eKhơi dậy mọi giác quan và sự tò mò của những người xung quanh, Trussardi Donna, một sự tội lỗi đầy ngọt ngào đến từ thương hiệu Trussardi. Hãy tưởng tượng khi bạn bước đi thênh thang trong những khu vườn lan tuyệt sắc, hãy để bản thân cảm nhận và đắm chìm trong cái cái cảm giác bay bổng đầy lãng mạn của tình yêu với Trusardi…\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv\u003e\u003cimg class=\"aligncenter wp-image-43503\" src=\"https://nuochoarosa.com/wp-content/uploads/2018/06/Trussardi-Donna-5.jpg\" alt=\"Trussardi Donna 5 - Nuochoarosa.com - Nước hoa cao cấp, chính hãng giá tốt, mẫu mới\" width=\"600\" height=\"428\" /\u003e\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv class=\"x11i5rnm xat24cr x1mh8g0r x1vvkbs xtlvy1s x126k92a\"\u003e\n\u003cdiv\u003eVới tông mùi cam chanh và hoa trắng giữ vai trò chủ đạo, mở đầu của Trussardi Donna là một mùi hương trái cây đầy mạnh mẽ với chanh Amalfi, quýt nhật và các loại trái mọng nước. Tiếp đến là một mùi hương hoa cỏ bùng nổ, đầy tươi mới và ngọt ngào khi các loài hoa màu trắng như hoa sen, hoa cam Châu Phi và hoa lài dần xuất hiện và lấn át. Mang đến sự kết thúc cho Trussardi Donna sẽ là sự kết hợp của vani, uyết tùng Virginia, hoắc hương và gỗ đàn hương đầy quyến rũ…\u003c/div\u003e\n\u003cdiv\u003e\u003cimg class=\"aligncenter wp-image-43504\" src=\"https://nuochoarosa.com/wp-content/uploads/2018/06/Trussardi-Donna-3.jpg\" alt=\"Trussardi Donna 3 - Nuochoarosa.com - Nước hoa cao cấp, chính hãng giá tốt, mẫu mới\" width=\"500\" height=\"625\" /\u003e\u003c/div\u003e\n\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/c4/cf/ca/76347f4398199e822a1229179e3ab851