ackground_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.7,"review_count":60,"review_text":"(60)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/e5/41/2e/b53362d4a3ff0e4146921669f17462b7.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1673,"all_time_quantity_sold":250,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch1 style=\"text-align: center;\"\u003e\u003cstrong\u003eNGŨ CỐC CALBEE SUGAR OFF GÓI TRẮNG 600GR \u003cbr /\u003e(GIẢM 25% ĐƯỜNG)\u003c/strong\u003e\u003c/h1\u003e\n\u003ch2 style=\"text-align: center;\"\u003eMô tả sản phẩm\u003c/h2\u003e\n\u003cp style=\"text-align: center;\"\u003eNgũ cốc là món ăn dinh dưỡng không còn xa lạ trong đời sống chúng ta, thành phần chính của Ngũ cốc bao gồm: các loại yến mạch, lúa mạch đen, bột gạo nâu, bột mì, bột ngô\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003eNgũ cốc Calbee Nhật Bản là loại sản phẩm rất được ưa chuộn tại đất nước Mặt trời mọc. Ngoài những loại Ngũ cốc truyền thống, thì còn có thêm các loại Ngũ cốc mix với Trái cây và các loại hạt. Sản phẩm là các loại hạt sấy khô quyện cùng trái cây chua ngọt rất ngon. Có thể ăn không, trộn cùng sữa tươi, salad hoặc làm bánh ngũ cốc.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/59/c4/fd/6e6411e1b7a38137bc436ae17bfc2645.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/59/c4/fd/6e6411e1b7a38137bc436ae17bfc2645.jpg\" alt=\"\" width=\"750\" height=\"490\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/b6/91/92/125e8b8fe3a55ba5ea495a4a9dbfe13f.jpeg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/b6/91/92/125e8b8fe3a55ba5ea495a4a9dbfe13f.jpeg\" alt=\"\" width=\"750\" height=\"529\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003eCalbee Nhật Bản với thành phần tươi - sạch cùng quy trình sản xuất khắt khe đúng chuẩn hàng nội địa Nhật, vì vậy sản phẩm được ko chỉ dân bản xứ mà rất nhiều nước khác ưa chuộng vô cùng.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003eCalbee ăn cùng sữa tươi hay yogurt đều rất ngon. Đặc biệt túi zip tiện dụng lắm ạ, ko lo ngũ cốc bị mềm nhe.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/2e/c8/0c/afa0992cd73b62be5b5404314d19320a.jpg\" alt=\"\" width=\"638\" height=\"425\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e5 vị ngũ cốc trái cây Calbee hiện có:\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e️ GÓI ĐỎ 800g: Loại truyền thống ra đời đầu tiên với thành phần chính là dâu tây, táo đỏ, đu đủ, nho tím, bí đỏ, dừa non cùng các loại yến mạch. Ngoài ra còn được bổ sung kèm thêm 4.5gr chuối và 5.0mg rau Bina chân vịt\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e️ GÓI NÂU 700g: Gồm Chocolate, chuối, quả mâm xôi cùng các loại yến mạch.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e️ GÓI CAM 700g: Gồm hạt óc chó,táo đỏ, quả mâm xôi, đậu đỏ, bí đỏ, dừa non cùng các loại yến mạch. Rất tốt cho mẹ bầu.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e️ GÓI TRẮNG 600g: gồm các loại hạt dinh dưỡng nghiền (hạnh nhân, hạt bí đỏ, đậu nành), dâu tây, nho tím cùng các loại yến mạch. Dành cho các bạn ko thích ăn ngọt, và đây cũng là loại thường được khách shop khen ăn ngon nhất ạ.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e️GÓI VÀNG 700g: Đây là loại Ngũ cốc nguyên chất nhất, chủ yếu là các loại yến mạch, lúa mạch đen, bột gạo nâu, bột mì, bột ngô. Ngoài ra còn được bổ sung kèm thêm 4.5gr chuối và 5.0mg rau Bina chân vịt\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/6a/0b/fa/a9d4ae152b306b90b620046275a3f25e.jpg\" alt=\"\" width=\"750\" height=\"421\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/61/75/c9/8b2b9591797c770023c983ed353919f8.jpg\" alt=\"\" width=\"650\" height=\"433\" /\u003e\u003c/p\u003e\n\u003ch3 style=\"text-align: center;\"\u003eXuất xứ\u003c/h3\u003e\n\u003cp style=\"text-align: center;\"\u003eNhật Bản\u003c/p\u003e\n\u003ch3 style=\"text-align: center;\"\u003eThành phần\u003c/h3\u003e\n\u003cp style=\"text-align: center;\"\u003eYến mạch, lúa mạch đen, đường, trái cây sấy khô (đu đủ, nho khô, táo, dâu tây), dừa, dầu thực vật, bột mì, dextrin, chất xơ hòa tan trong nước (dextrin khó tiêu), gạo, ngô, hạt bí ngô, hạnh nhân, muối, cám lúa mì, gạo nâu, glycerin, tinh bột biến tính, sắt citrate Na, chất nhũ hóa (bao gồm sữa), axit hóa, chất chống oxy hóa (vitamin E, chiết xuất hương thảo), niacin, axit pantothenic Ca, vitamin B1, vitamin B6, vitamin A, axit folic, vitamin D, vitamin B12\u003c/p\u003e\n\u003ch3 style=\"text-align: center;\"\u003eHướng dẫn sử dụng\u003c/h3\u003e\n\u003cp style=\"text-align: center;\"\u003eĂn trực tiếp\u003c/p\u003e\n\u003ch3 style=\"text-align: center;\"\u003eHướng dẫn bảo quản\u003c/h3\u003e\n\u003cp style=\"text-align: center;\"\u003eNơi khô mát, tránh ánh sáng trực tiếp\u003c/p\u003e\n\u003ch3 style=\"text-align: center;\"\u003eHạn sử dụng\u003c/h3\u003e\n\u003cp style=\"text-align: center;\"\u003e6 tháng kể từ ngày sản xuất\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/e5/41/2e/b53362d4a3ff0e4146921669f17462b7.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e5/41/2e/b53362d4a3ff0e4146921669f17462b7.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e5/41/2e/b53362d4a3ff0e4146921669f17462b7.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e5/41/2e/b53362d4a3ff0e4146921669f17462b7.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e5/41/2e/b53362d4a3ff0e4146921669f17462b7.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/14/ad/3d/aa0109e4c950a37386c0194ddbd263fa.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/14/ad/3d/aa0109e4c950a37386c0194ddbd263fa.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/14/ad/3d/aa0109e4c950a37386c0194ddbd263fa.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/14/ad/3d/aa0109e4c950a37386c0194ddbd263fa.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/14/ad/3d/aa0109e4c950a37386c0194ddbd263fa.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/28/19/df/2bde9ae899a895a50864dbe295a249ad.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/28/19/df/2bde9ae899a895a50864dbe295a249ad.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/28/19/df/2bde9ae899a895a50864dbe295a249ad.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/28/19/df/2bde9ae899a895a50864dbe295a249ad.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/28/19/df/2bde9ae899a895a50864dbe295a249ad.png"},{"base_url":"https://salt.tikicdn.com/ts/product/72/54/ca/190caf7e515e81a58b99645153b2fe60.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/72/54/ca/190caf7e515e81a58