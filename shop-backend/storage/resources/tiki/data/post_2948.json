om/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":34200,"discount_rate":18,"rating_average":5,"review_count":258,"review_text":"(258)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/e5/ee/c6/e7ec27b5cf89c816c4eefad2f271ec8e.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2140,"all_time_quantity_sold":1216,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eNgữ Pháp Tiếng Anh Bằng Sơ Đồ Tư Duy\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e5 Sai lầm khi học khiến ngữ pháp tiếng Anh của bạn MÃI KHÔNG KHÁ LÊN NỔI!\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eQuá chú trọng vào công thức\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003ePhương pháp này rất hữu hiệu cho các bạn học ngữ pháp chỉ để đi thi với điều kiện bạn thuộc …chính xác. Bạn có thể làm bài với tốc độ “siêu nhân” nếu có một bộ não cũng “siêu nhân” để có thể nhớ hết khối lượng cấu trúc ngữ pháp đồ sộ mà không bị “râu ông nọ cắm cằm bà kia”.\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eChỉ học lý thuyết\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eSuốt ngày cắm đầu vào lý thuyết và chỉ làm những bài tập mang tính bổ trợ cho lý thuyết là lí do to đùng khiến bạn “hùng hục” học ngữ pháp nhưng vẫn không làm nổi bài tập. Vì thực tế là các dạng đặc biệt, bất quy tắc chứ không đơn thuần như trong lý thuyết.\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eCho rằng không nên học ngữ pháp tiếng Anh?\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eNhiều ý kiến cho rằng học tiếng Anh thì chỉ nên học giao tiếp, ngữ pháp sẽ làm quá trình nói ngoại ngữ của bạn chậm đi. Nhưng đó không phải là cách học ngoại ngữ hiệu quả vì ta không thể cứ nói bừa hay không theo một cấu trúc ngữ pháp nào cả.\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eHọc ngữ pháp “chết”!\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eThói quen viết ra một danh sách các công thức riêng lẻ, chép đi chép lại để ghi nhớ. Các bạn có thể đưa lượng ngữ pháp tiếng Anh ấy vào trí nhớ ngắn hạn nhưng sau một thời gian ngắn bạn quên hết những gì đã học. Bạn nhớ cấu trúc nhưng không thể áp dụng để nói, khi giao tiếp bạn không nhớ nổi mình đã học cái gì.\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eCảm thấy nhàm chán\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eNhững bài học ngữ pháp tiếng Anh luôn là một thứ gì đó ngán ngẩm đối với bạn. Chính vì vậy, việc học những bài học về ngữ pháp tiếng Anh này luôn khiến bạn cảm thấy nhàm chán, không hứng thú hay tập trung cho nó được.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ec/f1/dd/9576cb8a5cfcfc9a566800d8b6b44337.jpg\" alt=\"Mindmap English Grammar - Ngữ Pháp Tiếng Anh Bằng Sơ Đồ Tư Duy\" width=\"750\" height=\"499\" /\u003e\u003c/p\u003e\n\u003cp\u003eLàm cách nào để nâng cao trình độ? Học thế nào để nhớ nhanh, ngấm lâu?\u003c/p\u003e\n\u003cp\u003eSơ đồ tư duy được mệnh danh là \" CÔNG CỤ VẠN NĂNG CHO BỘ NÃO\" - một phương pháp trình bày ý tưởng, kiến thức bằng những từ khóa chính, hình ảnh và màu sắc, giúp não bộ phát huy tối đa khả năng ghi nhớ. Phương pháp này hiện nay được hơn 250 triệu người trên thế giới sử dụng, đã và đang đem lại những hiệu quả thực sự nhất là ngữ pháp tiếng Anh bởi: \u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eGiúp bạn nắm được bức tranh toàn cảnh của chủ để nghiên cứu\u003c/li\u003e\n\u003cli\u003ePhương pháp ghi nhớ tối ưu hiệu quả, tăng khả năng tập trung khi học  \u003c/li\u003e\n\u003cli\u003eCải thiện khả năng khai thác chi tiết thông tin , giải quyết triệt để quá tải dữ liệu\u003c/li\u003e\n\u003cli\u003eCải thiện kỹ năng nghe qua các ví dụ hội thoại, tăng tính ứng dụng thực tế\u003c/li\u003e\n\u003cli\u003eĐột phá tư duy qua các sơ đồ mindmap, các hình ảnh giúp bạn dễ dàng hình dung\u003c/li\u003e\n\u003cli\u003eKích thích sự phát triển của bộ não trong quá trình học, khơi dậy niềm đam mê học\u003c/li\u003e\n\u003cli\u003eGiúp bạn tổ chức thông tin vào các nhánh dễ nhớ, nắm trọn ngữ pháp từ a đến z\u003c/li\u003e\n\u003cli\u003eGia tăng khả năng xử lý các vấn đề phức tạp, rút ngắn được thời gian học\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ee/2b/63/838bdbeacd9c52168b0da158270bba6a.jpg\" alt=\"Mindmap English Grammar - Ngữ Pháp Tiếng Anh Bằng Sơ Đồ Tư Duy\" width=\"750\" height=\"499\" /\u003e\u003c/p\u003e\n\u003cp\u003eBạn cũng biết rằng ngữ pháp tiếng Anh là nền tảng cho các kỹ năng nghe - nói -đọc -viết, nhưng lại thật khó nhớ vì ngữ pháp có quá nhiều kiến thức khô khan, cấu trúc cứng nhắc, giải thích dài dòng. Giờ đây với cuốn sách bạn đang cầm trên tay, bạn sẽ được trải nghiệm một phương pháp học ngữ pháp rất dễ dàng và thú vị. Toàn bộ kiến thức ngữ pháp được thiết kế dưới dạng sơ đồ tư duy Mind map kết hợp với hình ảnh sinh động, giải thích cách sử dụng qua những từ khóa chính giúp bạn ghi nhớ nhanh và hiệu quả hơn. Cuốn sách không chỉ giúp bạn chinh phục ngữ pháp tiếng anh cấp tốc mà còn giúp bạn phát triển khả năng tư duy sáng tạo. Hãy học tập và trải nghiệm!\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eNOUN - Danh từ\u003c/li\u003e\n\u003cli\u003eARTICLE - Mạo từ \u003c/li\u003e\n\u003cli\u003ePRONOUN - Đại từ \u003cbr /\u003e\u003cbr /\u003e\u003c/li\u003e\n\u003cli\u003eTENSES - Thì \u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003ePASSIVE VOICE - Câu bị động\u003c/p\u003e\n\u003cp\u003e\u003ciframe src=\"//www.youtube.com/embed/Uf9OVBP0bIM\" width=\"560\" height=\"314\" allowfullscreen=\"allowfullscreen\"\u003e\u003c/iframe\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eBạn Quách Thu Thủy bật mí cách chinh phục ngữ pháp tiếng Anh nhờ cuốn sách Mind map English Grammar\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003ciframe src=\"//www.youtube.com/embed/O9fYt8iZRhM\" width=\"560\" height=\"314\" allowfullscreen=\"allowfullscreen\"\u003e\u003c/iframe\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eBạn Nguyễn Giang Thúy chia sẻ cách học và dạy cho học sinh học nhanh ngữ pháp tiếng Anh nhờ cuốn sách Mind map English Grammar\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/e5/ee/c6/e7ec27b5cf89c816c4eefad2f271ec8e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e5/ee/c6/e7ec27b5cf89c816c4eefad2f271ec8e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e5/ee/c6/e7ec27b5cf89c816c4eefad2f271ec8e.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e5/ee/c6/e7ec27b5cf89c816c4eefad2f271ec8e.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e5/ee/c6/e7ec27b5cf89c816c4eefad2f271ec8e.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/56/4f/33/57c64ca824b855a4a8a6e9fe17b6abe7.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/56/4f/33/57c64ca824b855a4a8a6e9fe17b6abe7.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/56/4f/33/57c64ca824b855a4a8a6e9fe17b6abe7.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/56/4f/33/57c64ca824b855a4a8a6e9fe17b6abe7.jpg","thumbna