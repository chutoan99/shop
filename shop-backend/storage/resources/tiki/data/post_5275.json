null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":1930000,"discount_rate":45,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/media/catalog/product/j/b/jbv-s10w_1.u2769.d20161101.t142035.44245.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":0,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003eDung tích 1 lít\u003c/h3\u003e\r\n\u003cp\u003eNồi cơm điện tử Tiger JBV-S10W được thiết kế với dung tích 1 lít là sự lựa chọn phù hợp cho gia đình có từ 2 - 4 người. Sản phẩm thiết kế quai xách tiện lợi, chất liệu bền bỉ giúp việc di chuyển dễ dàng hơn.\u003c/p\u003e\r\n\u003cp style=\"text-align: center;\"\u003e\u003cimg title=\"Nồi Cơm Điện Tử Tiger JBV-S10W - 1L\" src=\"http://tikicdn.com/media/catalog/product/j/b/jbv-s10w_5.u2769.d20161101.t142035.195417.jpg\" alt=\"Nồi Cơm Điện Tử Tiger JBV-S10W - 1L\" width=\"650\" height=\"433\" /\u003e\u003c/p\u003e\r\n\u003ch3\u003eLòng nồi chống dính cao cấp\u003c/h3\u003e\r\n\u003cp\u003eNồi cơm điện tử chính hãng được tráng men chống dính bằng tia hồng ngoại, giúp cơm nấu được ngon hơn, hạng chế sự lãng phí do bám dính, đặc biệt dễ dàng vệ sinh sau khi sử dụng. Ngoài ra, công suất mạnh lên đến 564W và mâm nhiệt rộng giúp cơm chín nhanh, đều, đảm bảo bữa ăn đầy ấm cúng cho gia đình bạn.\u003c/p\u003e\r\n\u003ch3\u003eCông nghệ Fuzzy Logic thông minh\u003c/h3\u003e\r\n\u003cp\u003eCông nghệ Fuzzy Logic cảm ứng nhiệt thông minh giúp điều chỉnh nhiệt độ và thời gian nấu thích hợp, nên chất lượng món ăn luôn được đảm bảo.\u003c/p\u003e\r\n\u003ch3\u003eTính năng Tacook\u003c/h3\u003e\r\n\u003cp\u003eTính năng Tacook là sự kết hợp hoàn hảo 2 trong 1 khi người nội trợ vừa có thể nấu cơm, vừa có thể hâm nóng lại thức ăn hoặc hấp bánh bao, hấp cách thủy, nấu xôi,… cùng một lúc giúp tiết kiệm thời gian hơn.\u003c/p\u003e\r\n\u003cp style=\"text-align: center;\"\u003e\u003cimg title=\"Nồi Cơm Điện Tử Tiger JBV-S10W - 1L\" src=\"http://tikicdn.com/media/catalog/product/j/b/jbv-s10w_2.u2769.d20161101.t142035.86263.jpg\" alt=\"Nồi Cơm Điện Tử Tiger JBV-S10W - 1L\" width=\"650\" height=\"650\" /\u003e\u003c/p\u003e\r\n\u003ch3\u003eĐiều khiển điện tử đơn giản\u003c/h3\u003e\r\n\u003cp\u003eNồi cơm được điều khiển bằng nút bấm điện tử chìm và màn hình hiển thị đầy đủ các chức năng. Bạn chỉ việc chọn chức năng nấu theo nhu cầu sử dụng đã được thiết lập sẵn, nồi sẽ tự đổng chuyển chế độ giữ nóng khi cơm chín.\u003c/p\u003e\r\n\u003cp style=\"text-align: center;\"\u003e\u003cimg title=\"Nồi Cơm Điện Tử Tiger JBV-S10W - 1L\" src=\"http://tikicdn.com/media/catalog/product/j/b/jbv-s10w_3.u2769.d20161101.t142035.119703.jpg\" alt=\"Nồi Cơm Điện Tử Tiger JBV-S10W - 1L\" width=\"600\" height=\"600\" /\u003e\u003c/p\u003e\r\n\u003cp\u003eNgoài ra, chức năng hẹn giờ cho phép bạn chủ động thời gian để sắp xếp các công việc khác mà không cần thiết phải luôn ghi nhớ đến việc nấu cơm.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/media/catalog/product/j/b/jbv-s10w_1.u2769.d20161101.t142035.44245.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/j/b/jbv-s10w_1.u2769.d20161101.t142035.44245.jpg","medium_url":"https://sa