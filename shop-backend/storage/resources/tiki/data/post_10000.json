596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/dd/93/5c/0ee740afac8bd3d910209264e25dded5.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":361,"all_time_quantity_sold":6,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\n<p><strong>THÔNG SỐ KỸ THUẬT</strong></p>\n<ul><li>\n<div>Kết nối: không dây</div>\n</li><li>\n<div>Cảm biến: HERO 2</div>\n</li><li>\n<div>Số nút: 5</div>\n</li><li>\n<div>Switch: hybrid LIGHTFORCE</div>\n</li><li>\n<div>Độ phân giải: 100 – 32.000 DPI</div>\n</li><li>\n<div>Tốc độ phản hồi: 2K (0.5 ms)</div>\n</li><li>\n<div>Tăng tốc tối đa: &gt;40G</div>\n</li><li>\n<div>Tốc độ tối đa: &gt;500 IPS</div>\n</li><li>\n<div>Thời lượng Pin: lên tới 95 giờ cho một lần sạc ( USB-C )</div>\n</li><li>\n<div>Kích thước: 125 x 63.5 x 40mm</div>\n</li><li>\n<div>Trọng lượng: 60g</div>\n</li></ul>\n<h2>PRO X SUPERLIGHT 2</h2>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/7b/19/15/8fb6e58652d900ad0d80a744217b1a14.png\" alt=\"7b191550fb62d24002268edbc667b9ef.png\" /></p>\n<p> </p>\n<h3>SWITCH HYBRID LIGHTFORCE</h3>\n<p>Công nghệ phím switch quang học-cơ học kết hợp độc quyền của chúng tôi kết hợp tốc độ và độ tin cậy của phím switch quang học với mức tiêu thụ điện năng thấp và cảm giác nhấp chuột thỏa mãn của micro witch điện truyền thống (hoặc cơ học). Sở hữu hiệu suất mà các chuyên gia cần mà không ảnh hưởng tới thời lượng pin.</p>\n<h3><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/bd/b0/29/724b8ea3c0ef7ea7288497ac06fedddd.png\" alt=\"bdb029860171b8cd107021706b1eab6d.png\" /></h3>\n<p> </p>\n<h3>CẢM BIẾN HERO 2</h3>\n<p>Độ chính xác cấp độ chuyên nghiệp với cảm biến tiên tiến nhất trong trò chơi. Trải nghiệm độ tin cậy của việc theo dõi trên 500&#43; IPS và lên tới 32.000 DPI.</p>\n<p> </p>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/2a/97/67/17700fd708009070d4aca9a98b9635ce.png\" alt=\"2a9767442b09d478619e0cbb932fd797.png\" /></p>\n<p> </p>\n<h3>LIGHTSPEED KHÔNG DÂY</h3>\n<p>Độ tin cậy của LIGHTSPEED — giờ đây tự tin với tốc độ báo cáo nhanh hơn thế hệ trước.</p>\n<p> </p>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/59/95/57/f8e30f7665ca3362e32f6d2e61fd0e87.png\" alt=\"599557a73befee26e3b842f1249c78d8.png\" /></p>\n<p> </p>\n<h3>CÔNG NGHỆ ĐẲNG CẤP CHUYÊN NGHIỆP</h3>\n<p>Con chuột thể thao điện tử phổ biến nhất, được tinh chỉnh. Với tính năng thăm dò 2K, USB-C, thời lượng pin 95 giờ và khả năng tương thích với sạc không dây POWERPLAY.</p>\n<p> </p>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/7c/0b/42/2614d21f2736db3d2acb5bb3b15aa2bd.png\" alt=\"7c0b42e3b3a01a4d3bb476bad56fcac5.png\" /></p>\n<h3>HIỆU CHỈNH CẢM BIẾN CHÍNH XÁC</h3>\n<p>Việc cân chỉnh cảm biến chính xác cho phép điều chỉnh độc lập, chính xác các trục X và Y, có thể điều chỉnh dung sai độ nâng để phù hợp với tay cầm và chuyển động của bạn, đồng thời dễ dàng đồng bộ hóa với các cài đặt độ nhạy của con chuột khác — tất cả thông qua Logitech G HUB.</p>\n<p> </p>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/77/d2/42/852fa94a033061cdb916a8cfb33ae7d5.png\" alt=\"77d242344a0af3d93315ad8d39b3be54.png\" /></p>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/9d/45/89/d7ef5f40240be1a412cb50507b43e004.png\" alt=\"9d4589b479f4d95669059ac2c262913a.png\" /></p>\n<p> </p>\n<p> </p>\n<p> </p>\n<p> </p>\n<p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/dd/93/5c/0ee740afac8bd3d910209264e25dded5.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/dd/93/5c/0ee740afac8bd3d910209264e25dded5.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/dd/93/5c/0ee740afac8bd3d910209264e25dded5.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/dd/93/5c/0ee740afac8bd3d910209264e25dded5.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/dd/93/5c/0ee740afac8bd3d910209264e25dded5.png"},{"base_url":"https://salt.tikicdn.com/ts/product/e4/4d/c4/203ce8d90016c35defa1618b333fbf54.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e4/4d/c4/203ce8d90016c35defa1618b333fbf54.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e4/4d/c4/203ce8d90016c35defa1618b333fbf54.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e4/4d/c4/203ce8d90016c35defa1618b333fbf54.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e4/4d/c4/203ce8d90016c35defa1618b333fbf54.png"},{"base_url":"https://salt.tikicdn.com/ts/product/f7/37/1b/55358f429dc706fb9f3a0a20270a70cd.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f7/37/1b/55358f429dc706fb9f3a0a20270a70cd.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f7/37/1b/55358f429dc706fb9f3a0a20270a70cd.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f7/37/1b/55358f429dc706fb9f3a0a20270a70cd.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f7/37/1b/5535