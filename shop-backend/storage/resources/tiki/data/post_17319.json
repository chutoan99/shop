tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":true,"return_reason":"no_return"}},"discount":20000,"discount_rate":0,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/94/73/88/086df6dd144c5864871d78264d988e83.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":306,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cbr /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/95/01/b8/e874f757739ce4a3806fb56ba06c67c9.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/f7/28/93/922805c8b289ad0d2bd7b8b7dc83bf68.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003cbr /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/38/5f/27/68569cbe6f57cd5fcc1006b9e7d0b4c6.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003cbr /\u003eNgày 4/11/2023, Công ty Honda Việt Nam (HVN) chính thức giới thiệu mẫu xe tay ga hoàn toàn mới Vario 125.\u003c/p\u003e\n\u003cp\u003eVario 125 sở hữu thiết kế mang đậm chất thể thao, thon gọn và linh hoạt. Phần đầu xe gây ấn tượng với những đường nét góc cạnh, tích hợp hốc gió khí động học. Phần đầu đèn được thiết kế vuốt nhọn về phía trước, cùng hệ thống đèn pha chiếu sáng trước và dãy đèn trang trí LED đẹp mắt.\u003cbr /\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/product/5c/18/e4/832e54c60839385b9cc7a045ad55b7df.png\" alt=\"vario125_moi3_b7ad5bd149d54d4981e9d66c51f92486_grande.png\" /\u003e\u003c/p\u003e\n\u003cp\u003eĐuôi xe được thiết kế cân xứng với dàn đầu xe. Đèn sau được trang bị đồng bộ LED. Đèn xi nhan sau tách rời.\u003c/p\u003e\n\u003cp\u003eVario 125 sở hữu phanh đĩa phía trước lượn sóng, bộ vành với thiết kế thể thao, đi cùng lốp xe không săm kích thước rộng. Vario 125 được trang bị cụm đồng hồ hiển thị màn hình LCD.\u003cbr /\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/product/c0/49/c8/0409ec82d8c39ac481c5bb9bae49006a.jpg\" alt=\"honda_vario_125_new1_9aca8f55ab024cf9a630988a3084af5c_grande.jpg\" /\u003e\u003c/p\u003e\n\u003cp\u003eMàu sắc của Vario 125 sử dụng tông lạnh chủ đạo với hai màu Đen và Xanh đen.\u003c/p\u003e\n\u003cp\u003eỞ phiên bản Đặc biệt, toàn bộ xe được phủ lớp sơn đen nhám, tăng điểm nhấn bằng sọc màu vàng đậm phần thân xe. Dòng chữ “VARIO” tông vàng được đúc nổi góc cạnh.\u003cbr /\u003e\u003cem\u003eXem thêm\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003ePhiên bản Thể thao sử dụng màu Xanh đen kết hợp với bộ tem xe tương phản cao và vành xe màu vàng đồng nổi bật.\u003cbr /\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/product/bd/d0/58/cd6444aad7e8399a1582004ab8378719.png\" alt=\"vario125_moi_0e1167f6a579445190faf4e0aa053afc_grande.png\" /\u003e\u003c/p\u003e\n\u003cp\u003eVario 125 sử dụng cụm động cơ 125cc cùng hệ thống ngắt động cơ tạm thời (Idling Stop).\u003c/p\u003e\n\u003cp\u003eVario 125 được trang bị cổng sạc USB tiện lợi (Loại A, cường độ 2.1A) ở hộc đựng đồ phía trước giúp việc sạc điện thoại trở nên tiện lợi.\u003cbr /\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/product/f1/ce/e9/c16a6b4dbe5da16709dc09eed1e89967.jpg\" alt=\"honda_vario_125_new_065fd5ad94c44a53a9f833077a81126d_grande.jpg\" /\u003e\u003c/p\u003e\n\u003cp\u003eHộc đựng đồ dưới yên có dung tích lên đến 18 lít. Hệ thống khóa thông minh Honda SMART Key vận hành đơn giản, tích hợp nhiều tính năng giúp xác định vị trí xe và mở xe từ xa tiện lợi cùng chức năng báo động.\u003c/p\u003e\n\u003cp\u003eSàn để chân phẳng và rộng rãi.\u003c/p\u003e\n\u003cp\u003eVario 125cc mới sẽ được chính thức bán ra thị trường từ ngày 7 tháng 11 năm 2023 tại HEAD Khánh An\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/94/73/88/086df6dd144c5864871d78264d988e83.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/94/73/88/086df6dd144c5864871d78264d988e83.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/94/73/88/086df6dd144c5864871d78264d988e83.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/94/73/88/086df6dd144c5864871d78264d988e83.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/94/73/88/086df6dd144c5864871d78264d988e83.png"}],"warranty_policy":null,"brand":{"id":152855,"name":"Honda","slug":"honda"},"current_seller":{"id":35638,"sku":"7277546982531","name":"Hệ thống HEAD Khánh An","link":"https://tiki.vn/cua-hang/he-thong-head-khanh-an","logo":"https://vcdn.tikicdn.com/ts/seller/40/fd/6f/56fedb8b1842fc447a0c4076ca6c6cf8.jpg","price":43530000,"product_id":"273297710","store_id":34923,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Thông tin chung","attributes":[{"code":"brakes","name":"Phanh","value":"Phanh đĩa"},{"code":"loai_chia_khoa","name":"Loại chìa khóa","value":"Smartkey"},{"code":"brand","name":"Thương hiệu","value":"Honda"},{"code":"brand_country","name":"Xuất xứ thương hiệu","value":"Nhật Bản"},{"code":"origin","name":"Xuất xứ (Made in)","value":"Việt Nam"},{"code":"se