o","type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":true,"return_reason":"any_reason"}},"discount":28000,"discount_rate":31,"rating_average":4.5,"review_count":52,"review_text":"(52)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ab/b4/12/6f09bacafbc586b22f3dc3a81a51d517.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1611,"all_time_quantity_sold":253,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eHiện nay, chất lượng nước đang là mối quan tâm hàng đầu của các gia đình. Nhưng với mật độ công nghiệp hóa và ô nhiễm môi trường, đặc biệt ở thành phố thì vấn đề nước sạch luôn được quan tâm.\u003c/p\u003e\n\u003cp\u003eBộ lọc nước - lõi lọc nước trực tiếp tại vòi:\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/73/11/bc/7a9f05bfdf49a94f57a9473c5617acb8.jpg\" alt=\"\" width=\"361\" height=\"361\" /\u003e\u003c/p\u003e\n\u003cp\u003eVới Bảy chế độ lọc: Hạt Alkaline, Than hoạt tính, đá Maifan, Tourmaline, CaSo3, Vải cotton không dệt, Lưới lọc loại bỏ vi khuẩn, vi sinh, các chất độc hại, clo, kim loại nặng, thuốc trừ sâu, rong rêu trong nước, đồng thời khử mùi, giúp nguồn nước trong lành, tươi mát và mềm mại hơn bao giờ hết. An toàn cho việc ăn uống và nấu nướng.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/62/39/76/548c49648bb88d57b20ab57df01cce39.jpg\" alt=\"\" width=\"750\" height=\"690\" /\u003e\u003c/p\u003e\n\u003cp\u003eThiết kế riêng rẽ từng phần, giúp người sử dụng dễ dàng lắp đặt, thay thế cũng như súc rửa vệ sinh sản phẩm.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/c0/3e/68/fe050efb48d90e2496f7046844ce1e7a.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eThông số kỹ thuật:\u003c/p\u003e\n\u003cp\u003eLưu lượng nước: 1.0L/phút\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/6c/67/00/286086a081404a23d2cd47b6c758714d.jpg\" alt=\"\" width=\"750\" height=\"592\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ab/28/3d/1226b5a0b3d74f8c63e1423b49af352d.jpg\" alt=\"\" width=\"750\" height=\"442\" /\u003e\u003c/p\u003e\n\u003cp\u003eÁp suất vận hành: 0.1Mpa – 0.4Mpa\u003c/p\u003e\n\u003cp\u003eKích thước: 115x150x65 mm\u003c/p\u003e\n\u003cp\u003eBộ sản phẩm gồm: Đầu lọc nước, lõi lọc và các đầu nối bộ lọc khác nhau như hình bên dưới Sản phẩm được đóng gói xốp chống sốc tránh va đập khi vận chuyển\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/9d/db/91/a6ff881bf1412920e0d3835a381f9fae.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eƯu điểm nổi bật:\u003c/p\u003e\n\u003cp\u003eKích thước nhỏ gọn, dễ dàng lắp đặt thêm vào các vòi nước sẵn có trong gia đình.\u003c/p\u003e\n\u003cp\u003eLắp đặt được trên nhiều loại vòi nước khác nhau.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/e6/cd/1e/b3e997fdd2dcfa2e1fbaf99d92145e49.jpeg\" alt=\"\" width=\"593\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/ff/b1/7d/319fb86158a407e51c91872978de3930.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/ff/b1/7d/319fb86158a407e51c91872978de3930.jpg\" alt=\"\" width=\"750\" height=\"434\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/0f/dc/ca/244dbf6c7299c61a07a6f2ef5c6a47a2.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/0f/dc/ca/244dbf6c7299c61a07a6f2ef5c6a47a2.jpg\" alt=\"\" width=\"750\" height=\"403\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/b0/13/3b/81b1ac341454843778d2a43059108ed2.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/b0/13/3b/81b1ac341454843778d2a43059108ed2.jpg\" alt=\"\" width=\"750\" height=\"393\" /\u003e\u003c/p\u003e\n\u003cp\u003eKhả năng lọc sạch vi khuẩn làm trong nguồn nước cực kỳ hiệu quả.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/af/e2/64/12c9dcaa6751fcf51762b74a06642efb.jpg\" alt=\"\" width=\"750\" height=\"486\" /\u003e\u003c/p\u003e\n\u003cp\u003eDễ dang thay thế vệ sinh lõi lọc sau 1 thời gian sử dụng.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/b8/38/98/c61b656265d4b0934f31a7ea97e1a37d.jpg\" alt=\"\" width=\"750\" height=\"541\" /\u003e\u003c/p\u003e\n\u003cp\u003eBộ lọc nhanh và đơn giản\u003c/p\u003e\n\u003cp\u003eGiúp bạn yên tâm về nguồn nước mình sử dụng hàng ngày\u003c/p\u003e\n\u003cp\u003eChú ý: Nên nắp đặt trên vời nước có nguồn đủ mạnh để chức năng lọc nước đạt được hiệu quả tốt nhất.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ab/b4/12/6f09bacafbc586b22f3dc3a81a51d517.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ab/b4/12/6f09bacafbc586b22f3dc3a81a51d517.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ab/b4/12/6f09bacafbc586b22f3dc3a81a51d517.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ab/b4/12/6f09bacafbc586b22f3dc3a81a51d517.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ab/b4/12/6f09bacafbc586b22f3dc3a81a51d517.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/e4/69/9c/75c0b01aee1ad5e2136749773aaa0683.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e4/69/9c/75c0b01aee1ad5e2136749773aaa0683.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e4/69/9c/75c0b01aee1ad5e2136749773aaa0683.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e4/69/9c/75c0b01aee1ad5e2136749773aaa0683.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e4/69/9c/75c0b01aee1ad5e2136749773aaa0683.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/62/39/76/aa17f8dfd1b753ac50bfabcdf5f6c783.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/62/39/76/aa17f8dfd1b753ac50bfabcdf5f6c783.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/62/39/76/aa17f8dfd1b753ac50bfabcdf5f6c783.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/62/39/76/aa17f8dfd1b753ac50bfabcdf5f6c783.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/62/39/76/aa17f8dfd1b753ac50bfabcdf5f6c783.jpg"}],"warranty_policy":null,"brand":{"id":212647,"name":"SMY","slug":"smy"},"current_seller":{"id":8413,"sku":"7045348263222","name":"SMY (Tp.HCM)","link":"https://tiki.vn/cua-hang/smy-tphcm","logo":"58