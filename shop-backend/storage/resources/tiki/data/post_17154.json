type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/42/42/80/07e067846e22587af3fbb82efe4771a5.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1449,"all_time_quantity_sold":7,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch1 style=\"text-align: justify;\"\u003e\u003cstrong\u003eTúi chống nước cao cấp cho điện thoại 7.2 inch trở xuống chuẩn chống nước IPx8 hiệu Baseus Let'sGo \u003c/strong\u003e\u003cstrong\u003ecảm ứng nhạy chụp ảnh nét trang bị khả năng c\u003c/strong\u003e\u003cstrong\u003ehống nước sâu 30m, bảo vệ 4 lớp, độ trong HD\u003c/strong\u003e\u003c/h1\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e \u003c/p\u003e\n\u003cdiv class=\"pdp-product-detail\" data-spm=\"product_detail\"\u003e\n\u003cdiv class=\"pdp-product-desc \"\u003e\n\u003cdiv class=\"html-content detail-content\" style=\"text-align: justify;\"\u003e\n\u003cp style=\"text-align: center;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/88/5e/d6/7497834ab35cc2b11c40260bc9c30659.jpg\" alt=\"\" width=\"930\" height=\"1766\" /\u003e\u003c/p\u003e\n\u003ch2 style=\"text-align: justify;\"\u003e\u003cstrong\u003e \u003c/strong\u003e\u003c/h2\u003e\n\u003ch2 style=\"text-align: justify;\"\u003e\u003cstrong\u003eTHIẾT KẾ CẢI TIẾN\u003c/strong\u003e\u003c/h2\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eTúi chống nước Điện thoại hiệu Baseus (7.2 Inch trở xuống)\u003c/strong\u003e, an toàn khi đi bơi, đi tắm biển hoặc khi trời mưa to (chụp hình, nhắn tin dưới nước được)\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003eKích thước rộng, đựng vừa Smartphone màn hình 7.2\"\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e \u003cstrong\u003eTúi chống nước điện thoại cao cấp \u003c/strong\u003egiúp bạn sử dụng điện thoại khi trời mưa hoặc trong những chuyến đi biển cùng gia đình và bạn bè.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003eNó giúp bạn nghe điện thoại dễ dàng, chụp hình trong trời mưa hoặc khi đang tắm biển mà không lo điện thoại bị vô nước.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eTúi chống nước cao cấp\u003c/strong\u003e được thiết kế một cách toàn diện với lớp vỏ được làm từ nilon cao cấp chống nước tuyệt đối, không bị bị ố vàng theo thời gian, phần trên được chống nước 4 lớp cực kỳ an toàn với zipper kéo và chốt gài hai bên ngăn nước vào một cách triệu để.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/9c/1f/45/9beb5b9265813426f23e12a2d4c5d10a.jpg\" alt=\"\" width=\"930\" height=\"1944\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e \u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eCHỐNG NƯỚC Ở ĐỘ SÂU 30M\u003c/strong\u003e\u003c/h2\u003e\n\u003cp style=\"text-align: justify;\"\u003eCó khả năng chống nước ở độ sâu dưới 30m, thao tác cảm ứng một cách dễ dàng, hỗ trợ chụp hình dưới nước. Chuẩn chống nước IPx8 an toàn tuyệt đối cho thiết bị của bạn.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/b2/86/0f/d7bcd72b8fc240f955d9d5e1af2fd18b.jpg\" alt=\"\" width=\"930\" height=\"1817\" /\u003e\u003c/p\u003e\n\u003ch2\u003e \u003c/h2\u003e\n\u003ch2\u003e\u003cstrong\u003eAN TOÀN TUYỆT ĐỐI\u003c/strong\u003e\u003c/h2\u003e\n\u003cp style=\"text-align: justify;\"\u003eNgoài Có khả năng chống nước ở độ sâu dưới 30m, thao tác cảm ứng một cách dễ dàng, Túi chống nước Baseus kết hợp công nghệ túi khí giúp cho chiếc điện thoại của bạn không thể chìm và sẽ nổi trên mặt nước khi bạn sơ ý làm rơi túi khi dưới nước.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/71/6c/95/ce2fb74370421016f247b301f82bd481.jpg\" alt=\"\" width=\"930\" height=\"1973\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e \u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eKHÔNG GÂY KHÓ CHỊU\u003c/strong\u003e\u003c/h2\u003e\n\u003cp style=\"text-align: justify;\"\u003eBao chống nước được trang bị thêm dây đeo cổ và dây đe tay vô cùng chắc chắn giúp bạn không lo dây đứt hay sóng vập làm rơi chiếc điện thoại của bạn. Ngoài ra còn có thêm dây để gắn tay tiện lợi hơn gọn hơn. Thiết kế bằng dây vải mịn còn không gây ra khó chịu hay dị ứng, ngứa cho bạn khi đeo.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003eVới chuẩn chống nước IPx8 cho bạn thỏa thích đi bơi mà không phải lo lắng gì.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/d2/ee/84/112c32c958feec4271817eb32254a395.jpg\" alt=\"\" width=\"930\" height=\"1686\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e \u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/51/7e/89/8ffca2d45558ff11a9d543f7de136228.jpg\" alt=\"\" width=\"930\" height=\"500\" /\u003e\u003c/p\u003e\n\u003ch2\u003e \u003c/h2\u003e\n\u003ch2\u003e\u003cstrong\u003eKHÔNG ẢNH HƯỞNG ĐẾN FACE ID \u0026amp; CẢM ỨNG\u003c/strong\u003e\u003c/h2\u003e\n\u003cp style=\"text-align: justify;\"\u003eBằng chất liệu tuyệt vời, tạo nên độ trong hoàn hảo cho chiếc túi này, bạn có thể dễ dàng chụp ảnh, hay mở bằng face ID vẫn sẽ không có chút vấn đề gì.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003eBạn vẫn có thể cảm ứng dễ dàng khi tiếp xúc với nước. Quẳng đi nôi lo lăng về việc không thể sử dụng chiếc điện thoại của mình khi tiếp xúc với nước. Bên canh đó bề mặt TPU trong suốt cho màu sắc hiển thị không thua gì khi bỏ vào túi.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/58/d2/d5/cdc75764f7ea8e28b3e8c9a21bf0ebb5.jpg\" alt=\"\" width=\"930\" height=\"1644\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e \u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eBẢO VỆ 4 LỚP\u003c/strong\u003e\u003c/h2\u003e\nChiếc túi chống nước thế hệ mới của Baseus với 4 lớp chống nước ngay ở miệng túi được làm tứ vật liệu cao cấp, vượt hẳn các loại túi thông thường chỉ có 2 lớp.\n\u003cp style=\"text-align: justify;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/93/3f/5f/b193b37010c9aa0feb8022feb5ec27f5.jpg\" alt=\"\" width=\"930\" height=\"1954\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e \u003c/p\u003e\n\u003ch2 style=\"text-align: justify;\"\u003e\u003cstrong\u003eQUAY PHIM \u0026amp; CHỤP HÌNH HOÀN HẢO\u003c/strong\u003e\u003c/h2\u003e\n\u003cp style=\"text-align: justify;\"\u003eTúi chống nước giúp bạn có thể chụp hình, quay phim dưới nước ngoài ra bạn có thể nghe điện thoại ngay trong bao chống nước một cách dễ dàng.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e Một ưu điểm trên chiếc túi chống nước này chính là việc khi dùng túi chống nước vẫn có thể sử dụng cảm ứng một cách dễ dàng và đặc biệt màn hình vẫn nhìn rất dễ để bạn có thể chụp hình đẹp.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e Bao chống nước điện thoại là dụng cụ không thể thiếu trong những chuyến đi du lịch, đi nghĩ dưỡng ở biển nó giúp bạn không lo bị mất điện thoại khi tắm biển mà còn giúp bạn có những tấm hình đẹp cũng với biển cúng bạn bè mình.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/51/6f/e2/dd578faf0b469e87c576bc685413bc53.jpg\" alt=\"\" width=\"930\" height=\"1865\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e \u003c/p\u003e\n\u003ch2 style=\"text-align: justify;\"\u003e\u003cstrong\u003eTƯƠNG THÍCH CAO\u003c/strong\u003e\u003c/h2\u003e\n\u003cp style=\"text-align: justify;\"\u003eVới thiết kế có thể bỏ vừa các điện thoại từ 7.2 inch trở xuống, Bạn không còn phải lo lăng việc điện thoại của bạn có thể bỏ vừa vào túi chống nước Baseus hay không.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003eBên cạnh đó, bề mặt  thiết kế được thiết kế phù hợp với tất cả thiết kế camera hiện nay.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/42/d5/1d/d221fd4fffbb77c1865a5913923debb7.jpg\" alt=\"\" width=\"930\" height=\"1917\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e \u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eHÌNH ẢNH THỰC TẾ SẢN PHẨM\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/2a/de/c8/82c9639dfd60d43b581dec5110fed0c3.jpg\" alt=\"\" width=\"930\" height=\"1170\" /\u003e\u003c/p\u003e\