l,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":60000,"discount_rate":30,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/9b/14/08/ef6dd3f316a22ed33166a9eeb8f89e6b.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":97,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003ePHIÊN BẢN SÁCH\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eBản thường: Sách \u0026#43; 01 Bookmark\u003c/p\u003e\n\u003cp\u003eBản đặc biệt: Sách \u0026#43; 01 Bookmark \u0026#43; 01 Postcard \u0026#43; 01 Standee chibi acrylic\u003c/p\u003e\n\u003cp\u003e________________________________\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eTHÔNG TIN TÁC PHẨM\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eTên tác phẩm: Trường Phong Độ 2\u003c/p\u003e\n\u003cp\u003eTác giả: Mặc Thư Bạch\u003c/p\u003e\n\u003cp\u003eNgười dịch: Linh Bảo\u003c/p\u003e\n\u003cp\u003eThể loại: Tiểu thuyết\u003c/p\u003e\n\u003cp\u003eNhãn hiệu: Sunday Books (thuộc Timebooks)\u003c/p\u003e\n\u003cp\u003eNhà xuất bản: NXB Hà Nội\u003c/p\u003e\n\u003cp\u003eNăm xuất bản: 2024\u003c/p\u003e\n\u003cp\u003eMã ISBN: 978-604-44-1586-4\u003c/p\u003e\n\u003cp\u003eLoại bìa: Mềm\u003c/p\u003e\n\u003cp\u003eKhổ: 14,5 x 20,5 cm\u003c/p\u003e\n\u003cp\u003eSố trang: 496 trang\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e____________________________\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eGIỚI THIỆU TÁC GIẢ\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eMặc Thư Bạch - Tác giả của mạng văn học Tấn Giang, được đông đảo độc giả yêu thích bởi tài năng viết lách sắc bén, cảm xúc tinh tế và xây dựng nhân vật sâu sắc. Tác phẩm nổi bật: Sơn Hà Chẩm, Trường Phong Độ, Trưởng Công Chúa, Thiên Hành Vãn…\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eTrong đó Trường Phong Độ đã được chuyển thể thành phim cùng tên do Bạch Kính Đình và Tống Dật đóng chính, phát sóng vào mùa\u003c/p\u003e\n\u003cp\u003ehè 2023.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e___________________________\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eGIỚI THIỆU TÁC PHẨM\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eTRƯỜNG PHONG ĐỘ (tập 2)\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eSau khi giúp Phạm Hiên giải quyết nỗi lo về tiền bạc, Cố Cửu Tư tiếp tục phải đối mặt với một vấn đề khác, đó là phải thu gom đủ ba mươi vạn thạch lương thực chỉ trong vòng ba tháng.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eĐể giúp Cố Cửu Tư giải quyết ưu phiền, đồng thời mở rộng chi nhánh của Hoa Dung, Liễu Ngọc Như quyết định thành lập thương đội, lập quân lệnh trạng, tự mình đi đến Thương Châu, Thanh Châu và Dương Châu để thu mua lương thực.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eTrải qua bao sóng gió, cuối cùng Cố Cửu Tư và Liễu Ngọc Như cũng đã nhận ra được tình cảm của mình dành cho đối phương.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eCố Cửu Tư cười khẽ: “Nếu ta bảo cả đời này của ta chỉ có một mình nàng, nàng có tin không?”\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e“Chàng\u003c/p\u003e\n\u003cp\u003ekhông cần phải nói.” Liễu Ngọc Như cất giọng dịu dàng, “Ta nhìn cả đời là sẽ biết thôi mà.”\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/9b/14/08/ef6dd3f316a22ed33166a9eeb8f89e6b.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/9b/14/08/ef6dd3f316a22ed33166a9eeb8f89e6b.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/9b/14/08/ef6dd3f316a22ed33166a9eeb8f89e6b.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9b/14/08/ef6dd3f316a22ed33166a9eeb8f89e6b.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9b/14/08/ef6dd3f316a22ed33166a9eeb8f89e6b.png"},{"base_url":"https://salt.tikicdn.com/ts/product/cd/13/8f/36fa3eb99fe97ee6a76ebf96afb00bbf.JPG","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/cd/13/8f/36fa3eb99fe97ee6a76ebf96afb00bbf.JPG","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/cd/13/8f/36fa3eb99fe97ee6a76ebf96afb00bbf.JPG","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/cd/13/8f/36fa3eb99fe97ee6a76ebf96afb00bbf.JPG","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/cd/13/8f/36fa3eb99fe97ee6a76ebf96afb00bbf.JPG"},{"base_url":"https://salt.tikicdn.com/ts/product/47/4c/e7/438d79065e1daf99b890f06b8eea44f2.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/47/4c/e7/438d79065e1daf99b890f06b8eea44f2.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/47/4c/e7/438d79065e1daf99b890f06b8eea44f2.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/47/4c/e7/438d79065e1daf99b890f06b8eea44f2.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/47/4c/e7/438d79065e1daf99b890f06b8eea44f2.png"},{"base_url":"https://salt.tikicdn.com/ts/product/26/80/5e/ed424681fae38207dcf923a957dac165.png","is_gallery":true,"label":null,"large