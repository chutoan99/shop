ull,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":4000,"discount_rate":3,"rating_average":4.7,"review_count":171,"review_text":"(171)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/dd/85/7c/7b494c3240dca0d7640709f5c5e0b865.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2136,"all_time_quantity_sold":3021,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cul style=\"font-family:Arial;padding:0px;color:#555555;font-size:12px;margin:0px 0px 0px 0px;\"\u003e\u003cli style=\"text-align:justify;\"\u003e\u003cspan style=\"font-weight:bold;\"\u003eXuất xứ: Nhập khẩu trực tiếp tại Nhật Bản và phân phối chính hãng toàn Việt Nam\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"text-align:justify;\"\u003e\u003cspan style=\"font-weight:bold;\"\u003eHàng về liên tục, date sản phẩm luôn dài.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"text-align:justify;\"\u003e\u003cspan style=\"font-weight:bold;\"\u003eQuy cách: Gói 750gr\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\u003cp style=\"text-align:justify;\"\u003eNgũ cốc Calbee Nhật bản có chứa rất nhiều loại hạt và trái cây có giá trị dinh dưỡng cao, không thêm gia vị mà tận dụng những hương vị vốn có của loại trái cây đó. Từ trẻ nhỏ đến người già, ngay cả người bệnh tiểu đường cũng rất rất thích thú với loại ngũ cốc Calbee của Nhật bởi nó rất bổ dưỡng và thơm ngon. Chứa nhiều loại trái cây và hạt được sấy khô như là yến mạch, lúa mạch, táo, nho, đu đủ, dâu tây, dừa, ngô, bí ngô, hạnh nhân, gạo nâu, sữa…\u003c/p\u003e\n\u003cdiv class=\"tab-content clearfix ui-tabs-panel ui-widget-content ui-corner-bottom fix-lineheight\" style=\"font-family:Arial;color:#555555;font-size:15px;font-style:normal;font-weight:400;letter-spacing:normal;text-indent:0px;text-transform:none;white-space:normal;word-spacing:0px;background-color:#ffffff;\"\u003e\u003cstrong style=\"font-family:Arial;font-weight:bold;\"\u003eNgũ cốc sấy khô Calbee Nhật\u003c/strong\u003e \u003cstrong style=\"font-family:Arial;font-weight:bold;\"\u003enội địa\u003c/strong\u003e bạn luôn yên tâm về chất lượng cũng như giá trị dinh dưỡng đã được công bố. Giàu canxi, chất xơ và các loại Vitamin B6, Vitamin A, Vitamin D, Vitamin B12 và cả Axit Folic rất tốt cho bà bầu và những bà mẹ đang cho con bú.\n\u003cp style=\"text-align:justify;\"\u003eNgũ cốc có hàm lượng chất béo rất thấp nhưng lại có hàm lượng vitamin và khoáng chất cao, giúp cung cấp đầy đủ các dưỡng chất cho cơ thể. Vì lý do này, mỗi bữa sáng với ngũ cốc giúp giảm cân là cực kỳ hiệu quả mà không gây tác dụng phụ.\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003eNgũ cốc giàu chất xơ có lợi cho hệ tiêu hóa, không gây chướng bụng, đầy hơi như nhiều thực phẩm dinh dưỡng khác. Đối với những người có hàm lượng cholesteron trong máu cao, sử dụng bột ngũ cốc thường xuyên duy trì sức khỏe tốt nhất mà không gây tăng cân, không ảnh hưởng tới hiện tượng tích tụ mỡ và đường trong máu.\u003c/p\u003e\n\u003cp style=\"line-height:1.2;font-family:Arial;margin:0px 0px 0px 0px;\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/98/86/59/7d1eb212808ebff39dcd10b1e88bc315.jpg\" alt=\"\" width=\"750\" height=\"534\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003eỞ Việt Nam có rất nhiều loại ngũ cốc, phổ biến như: gạo, ngô, các loại đậu, sen, vừng, lạc… Nhưng thường thì ít được mọi người ưa thích vì nhạt nhẽo, đơn giản và khó ngon.\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003eNgũ cốc Calbee thì khác, nó chứa rất nhiều loại hạt và trái cây có giá trị dinh dưỡng cao, không thêm gia vị mà tận dụng những hương vị vốn có của loại trái cây đó. Từ trẻ nhỏ đến người già, ngay cả người bệnh tiểu đường cũng rất rất thích thú với loại ngũ cốc Calbee của Nhật bởi nó rất bổ dưỡng và thơm ngon. Nó như là một loại ngũ cốc giàu chất dinh dưỡng, chứa nhiều loại trái cây và hạt được sấy khô như là yến mạch, lúa mạch, táo, nho, đu đủ, dâu tây, dừa, ngô, bí ngô, hạnh nhân, gạo nâu, sữa….\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003eNgũ cốc Calbee thật sự rất ngon và không ngấy, hãy mua nó và trút ra những cái lọ thủy tinh như một cách trang trí cho gian bếp nhà bạn, và là một thực phẩm có giá trị dinh dưỡng cao, giúp bổ sung chất xơ và chất sắt cho cả gia đình.\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003eBạn cũng có thể dùng ngũ cốc Calbee để làm những loại bánh nướng thật ngon, bánh pizza, kem hay ăn “mộc” cũng không chê vào đâu được!\u003cbr style=\"font-family:Arial;\" /\u003e---\u0026gt;\u0026gt; Rất rễ ăn và ngon lắm lắm \u003c/p\u003e\n\u003ch4 style=\"text-align:justify;\"\u003eHƯỚNG DẪN SỬ DỤNG\u003c/h4\u003e\n\u003cp style=\"font-family:Arial;line-height:1.2;margin:0px 0px 0px 0px;\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/51/2f/da/90a38483f0b3e55b6546456dd0a9fc27.jpg\" alt=\"\" width=\"720\" height=\"541\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cbr style=\"font-family:Arial;\" /\u003e– Bánh ngũ cốc Calbee dùng để ăn sáng cùng với sữa tươi nguyên chất; sữa chua; sữa đậu nành, sữa công thức, kem, salad đều tuyệt vời.\u003cbr style=\"font-family:Arial;\" /\u003e– Túi bánh tiện lợi, có thể mở ra và ăn liền.\u003cbr style=\"font-family:Arial;\" /\u003e– Rắc bánh lên hộp sữa chua, hoặc trộn với sữa tươi, kem, … và thưởng thức hương vị thơm ngon của bánh.\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e \u003c/p\u003e\n\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/dd/85/7c/7b494c3240dca0d7640709f5c5e0b865.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/dd/85/7c/7b494c3240dca0d7640709f5c5e0b865.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/dd/85/7c/7b494c3240dca0d7640709f5c5e0b865.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/dd/85/7c/7b494c3240dca0d7640709f5c5e0b865.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/dd/85/7c/7b494c3240dca0d7640709f5c5e0b865.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/ca/73/53/424a355b794293de252728501cbb2534.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ca/73/53/424a355b794293de252728501cbb2534.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ca/73/53/424a355b794293de252728501cbb2534.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ca/73/53/424a355b794293de252728501cbb2534.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ca/73/53/424a355b794293de252728501cbb2534.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/3c/d9/b8/9ff09755d6c00bd34fa5da9fe4d4e05d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/3c/d9/b8/9ff09755d6c00bd34fa5da9fe4d4e05d.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/3c/d9/b8/9ff09755d6c00bd34fa5da9fe4d4e05d.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3c/d9/b8/9ff09755d6c00bd34fa5da9fe4d4e05d.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3c/d9/b8/9f