olor":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.6,"review_count":23,"review_text":"(23)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/4a/64/4a/63b86f45286ff46ac44301e9cf812035.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":746,"all_time_quantity_sold":136,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<h1><em><strong>Giới thiệu Băng keo 2 mặt cường lực siêu dính màu xám VHB GPL-110 3M</strong></em></h1>\n<p>Thay thế các mối hàn, đinh tán và ốc vít cơ khí khác… Băng keo acrylic có thể làm nâng cao năng suất, làm giảm độ rung và tăng cường tính thẩm mỹ sản phẩm. Giúp gia tăng năng suất, hiệu quả thi công. Khả năng chịu nhiệt độ lên đến 149 độ C.</p>\n<p><em><strong>Băng keo 2 mặt cường lực siêu dính màu xám VHB GPL-110 3M</strong></em> là một trong những sản phẩm nổi bật nhất của dòng băng keo 2 mặt cường lực 3M.</p>\n<p> </p>\n<h2><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/4a/64/4a/9955b24ef86acbaca88696a36ac769bc.jpg?v&#61;1661498127000\" /></h2>\n<h2> </h2>\n<h2><em><strong>Thông tin sản phẩm </strong></em></h2>\n<ul><li>Tên sản phẩm: <em><strong>Băng keo 2 mặt cường lực siêu dính màu xám VHB GPL-110 3M</strong></em></li><li>Loại: Băng keo cường lực 2 mặt</li><li>Màu sắc thịt keo: Xám đậm</li><li>Thành phần nguyên liệu chính: 100% là  xốp Acrylic</li><li>Kích thước:<em><strong> dài 11met (rộng: 8mm, 10mm, 12mm, 20mm, 24mm hoặc cắt theo yêu cầu)</strong></em></li><li>Thương hiệu:<em><strong> 3M</strong></em></li><li>Xuất xứ: <em><strong>Mỹ </strong></em></li><li>Chịu nhiệt ngắn hạn tới 149 độ C</li><li>Chịu nhiệt dài hạn tới 90 độ C </li><li>Độ dày: 1.1mm</li><li>Hạn sử dụng: 5 năm kể từ ngày sản xuất.</li></ul><p><strong><em>Nhập khẩu chính hãng tại 3M – Mỹ </em></strong></p>\n<p> </p>\n<h2><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/94/a4/1a/d56196a5cfb9beffabd2139016bfae0e.jpg?v&#61;1554798640271\" /></h2>\n<h2> </h2>\n<h2><em><strong>Thông tin nổi bật </strong></em></h2>\n<ul><li>Chuyên dùng dán ứng dụng cần có độ dính cao như logo, kính,...</li><li>Liên kết với nhiều loại vật liệu bao gồm cả kim loại,thủy tinh, bề mặt được sơn.</li><li>Giúp gia tăng năng suất, hiệu quả thi công</li><li>Tăng tính thẩm mỹ cho ứng dụng.</li><li>Sử dụng keo dán acrylic cải tiến ở cả hai mặt, tạo độ bám dính tốt trên nhiều loại chất liệu bề mặt. </li><li>Kết hợp và bám dính tốt trên hầu hết các bề mặt sản phẩm đặc biệt cho kim loại, thủy tinh, nhựa như polycarbonate và acrylic</li><li>Ứng dụng trong nhiều các ngành công nghiệp như chế biến nhựa, vận tải, thiết bị gia dụng, xe hơi, giao thông</li><li>Chống oxi hóa, chống các loại hóa chất tốt, không thấm nước và dộ ẩm.</li><li>Kết dính nhanh chóng, dễ sử dụng cung cấp độ bền cao và độ bền lâu dài.</li><li>Chịu cường lực tốt khi va đập, rung lắc hoặc nén.</li><li>Có khả năng chịu nhiệt ngắn hạn lên đến 149 độ C</li></ul><p> </p>\n<h2><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/57/b6/65/c83e65868af8b7643ebeb93f44686e6d.jpg?v&#61;1554798567753\" /></h2>\n<h2> </h2>\n<h2><em><strong>Hướng dẫn sử dụng </strong></em></h2>\n<ul><li>Bước 1: Làm sạch kỹ bề mặt cần dán (có thể dùng cồn lau sạch và để khô trong 5 phút).</li><li>Bước 2: Cắt băng keo theo chiều dài thích hợp</li><li>Bước 3: Dùng lực ép chặt keo lên bề mặt dán (khoảng 30 - 60 giây)</li><li>Bươc 4: Cố định trong 24h để đạt hiệu quả cao nhất </li></ul><p> </p>\n<p><em><strong>Lưu ý :<br />Không chạm tay vào bề mặt băng keo và bề mặt dán vì mồ hôi tay làm bất hoạt keo dính Acrylic gây nên tình trạng dán dễ bong tróc hay dán không dính như mô tả.<br />Độ chịu lực là 0.69g/cm²</strong></em><br />Không áp dụng trên tường vôi, sơn nước dễ bong tróc, gạch men quá nhẵn bóng và các bề mặt khó dính khác.</p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/4a/64/4a/63b86f45286ff46ac44301e9cf812035.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/4a/64/4a/63b86f45286ff46ac44301e9cf812035.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/4a/64/4a/63b86f45286ff46ac44301e9cf812035.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4a/64/4a/63b86f45286ff46ac44301e9cf812035.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4a/64/4a/63b86f45286ff46ac44301e9cf812035.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/8e/bf/ed/9e02270edeb4008494d7c5be08a4ecdc.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/8e/bf/ed/9e02270edeb4008494d7c5be08a4ecdc.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/8e/bf/ed/9e02270edeb4008494d7c5be08a4ecdc.jpg","position":null,"small_url":"https://salt.ti