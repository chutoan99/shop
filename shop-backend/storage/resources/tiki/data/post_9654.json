icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":58800,"discount_rate":35,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/3b/85/e5/e18f37bf8c29b59c0a7d2ff94cf2ba6e.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":285,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cdiv class=\"product-detail page-product__detail\"\u003e\n\u003csection class=\"U9rGd1\"\u003e\n\u003cdiv class=\"MCCLkq\"\u003e\n\u003cdiv class=\"f7AU53\"\u003e\n\u003cp class=\"irIKAp\"\u003eSách - Hướng Dẫn Xây Kênh Podcast Từ A - Z - MCBooks\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cdiv class=\"irIKAp\"\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"cxDtMn\"\u003e\u003cimg class=\"_0O7Vlf bgImIg\" src=\"https://down-vn.img.susercontent.com/file/vn-11134208-7r98o-lop7qc36cqj467\" alt=\"vn-11134208-7r98o-lop7qc36cqj467\" /\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eNội dung cuốn Sách Hướng Dẫn Xây Kênh Podcast Từ A - Z - MCBooks\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eTrong thời đại công nghệ số, podcast nổi lên như một hình thức truyền thông phát triển nhanh nhất hiện nay. Thế nhưng không phải ai làm podcast cũng gặt hái thành công. Từ lúc ấp ủ đến khi thực hiện là cả một quá trình khó khăn. Vậy làm thế nào để có thể xây dựng, duy trì và quảng bá kênh podcast hiệu quả?\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eKristen Meinzer - nhà sản xuất và dẫn chương trình podcast có hơn 10 triệu người nghe đã chia sẻ những kinh nghiệm của mình thông qua cuốn sách Hướng dẫn xây kênh Podcast từ A - Z. \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eĐây giống như một cuốn\"cẩm nang\" dành cho những người mới bắt đầu làm podcast và cả những người đang thực hiện công việc này. Cuốn sách sẽ cung cấp cho bạn lộ trình từng bước để tạo ra một kênh podcast giải trí và giàu thông tin, từ lúc ấp ủ giấc mơ đến khi biến giấc mơ thành sự thật.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eNội dung sách Hướng dẫn xây kênh từ A - Z\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003ePhần 1: Mơ về Podcast\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003ePhần 2: Viết Podcast\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003ePhần 3: Dẫn dắt Podcast\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003ePhần 4: Tuyển chọn Podcast\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003ePhần 5: Làm nên Podcast\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003ePhần 6: Chia sẻ Podcast\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003ePhần 7: Phát triển Podcast\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eNhững con số biết nói về việc thực hiện các chương trình podcast thông qua nghiên cứu Người tiêu dùng podcast năm 2018 cho thấy:\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- 70% người nghe podcast nằm trong độ tuổi từ 18 - 54\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Tỷ lệ nam và nữ gần như cân bằng\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Những người nghe podcast có xu hướng đạt được trình độ học vấn cao hơn những người không nghe.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- 34% khán giả có bằng cấp đại học hoặc chứng chỉ so với 23% những người không nghe.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- 51% người nghe podcast có thu nhập từ 75.000 USD đến 150.000 USD mỗi năm.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Vì sao lại là podcast?\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eMột câu hỏi tưởng chừng đơn giản nhưng rất khó trả lời, đó là :Tại sao bạn muốn bắt đầu một podcast?\" Vì mọi người đang làm nên bạn cũng phải làm hay một nguyên nhân khác cá nhân hơn, bạn thích kể chuyện bằng chính giọng nói của mình và muốn bắt đầu chương trình của riêng mình.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eNếu muốn thế giới lắng nghe nội dung của bạn, hãy kể câu chuyện một cách chân thực và truyền tải thông điệp thật đẹp đẽ.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eNội dung ấy có thể được chia sẻ theo nhiều dạng podcast khác nhau nhưng phải đảm bảo sự ấn tượng và thu hút.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eCác dạng podcast phổ biến gồm: phỏng vấn, bàn tròn, tin tức hàng ngày, danh sách, lời khuyên, tóm tắt, phim tài liệu nhiều tập, phim tài liệu theo mùa, điều tra, tạp chí, game show, truyện ngắn tự sự, tiểu thuyết nhiều phần... Đa phần mọi người làm podcast sẽ sử dụng định dạng này. Tuy nhiên, bạn có thể tự tạo một định dạng của riêng mình, miễn là định dạng ấy đặc biệt, thú vị và thu hút người nghe.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eMất bao lâu để người nghe hứng thú với podcast của bạn?\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eTuy nhiên, giống như một quyển sách, nếu phần mở đầu hấp dẫn, độc giả mới có hứng thú để lật mở những trang tiếp theo.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eVì vậy, năm phút đầu tiên của một podcast cũng nên được đề cao.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eTrên thực tế, tỷ lệ người nghe bỏ cuộc trong 5 phút đầu tiên của một tập podcast cao hơn so với bất kỳ thời điểm nào khác. Do đó, những người làm podcast nên dành 50 giờ để thành thạo 5 phút đầu tiên của một tập phát thanh. Chỉ cần có đủ sự kiên trì, những nỗ lực của bạn sẽ được đền đáp xứng đáng.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eNên viết những câu ngắn hay câu phức tạp?\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eCái hay của podcast là bạn có thể tạo ra cả một vũ trụ mà không cần đến hàng triệu USD hay phí thuê nhà hát. Đa số độc giả đến với podcast để lắng nghe những câu chuyện, ngược lại, nếu chỉ muốn sự thật, họ sẽ đọc báo hoặc bách khoa toàn thư. Vì vậy, nếu muốn có một chương trình podcast hay, hãy trở thành người kể chuyện xuất sắc.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eNhưng thay vì đưa ra những sự thật hiển nhiên, bạn hãy tập trung kể câu chuyện của riêng mình. Khi kể, bạn đừng quên minh họa bằng từ ngữ giàu hình ảnh và cảm xúc để người nghe nhìn thấy trải nghiệm và hành động của nhân vật bằng trí tưởng tượng. \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eNgười làm podcast đang viết những câu chuyện cho đôi tai chứ không phải cho mắt nhìn. Khi viết cho tai nghĩa là bạn đang viết cho hơi thở, làm sao để khi kể chuyện có thể dễ đọc hơn và dễ nghe hơn. Do vậy, kịch bản podcast cần những câu ngắn gọn, từ ngữ ít âm tiết, ít vòng vo và đi thẳng vào vấn đề. \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eThông tin chi tiết cuốn sách Sách Hướng Dẫn Xây Kênh Podcast Từ A - Z - MCBooks\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Năm xuất bản         : 2023\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Nhà xuất bản          : Hồng Đức\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Tác giả                    : Kristen Meinzer\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Số trang  