con_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":4000,"discount_rate":2,"rating_average":4.5,"review_count":58,"review_text":"(58)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/a9/ca/7f/17cb24e359275cdfff8dd55039c5c644.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":839,"all_time_quantity_sold":249,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<h1><span style=\"color:#339966;\">Mền lông cừu caro cao cấp A kích thước 1m8 x 2m</span></h1>\n<p>Màu sắc đẹp như ảnh, sợi lông mềm mịn tay, ko bị nóng bức, tạo cảm giác dễ chịu khi đắp, nâng cao chất lượng giấc ngủ</p>\n<p>Giặt tay hay giặt máy vô tư ko lo mền bị xù lông, khuyên dùng với gói nước xả Comfort để vải lông mềm mịn xài bền theo năm tháng.</p>\n<p><strong>Thông tin cơ bản:</strong></p>\n<ul><li>Kích thước: 1m8 x 2m</li>\n<li>Chất liệu: lông cừu tổng hợp</li>\n<li>Màu sắc: đỏ / xám / xanh dương</li>\n<li>Thương hiệu A</li>\n<li>Xuất xứ: Việt Nam</li>\n</ul><p><img src=\"https://salt.tikicdn.com/ts/tmp/a0/06/c3/7b6cdf6f9e320a7566ade47546ef521c.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p><em>Mền lông cừu caro cao cấp A kích thước 1m8 x 2m</em></p>\n<h4><strong>Đặc điểm chung:</strong></h4>\n<ul><li>\n<p>Mền mỏng nhẹ tiện lợi xếp gọn khi đi xa</p>\n</li>\n<li>\n<p>Sợi lông siêu nhỏ, mềm mịn tay, giúp chăn giữ ấm tốt nhưng luôn thông thoáng, tạo cảm giác dễ chịu khi đắp, nâng cao chất lượng giấc ngủ</p>\n</li>\n<li>\n<p>Mát vào mùa hè, thích hợp khi tiết trời se se lạnh</p>\n</li>\n<li>\n<p>Không xù lông, không phai màu, bền theo thời gian</p>\n</li>\n<li>Màu sắc trang nhã, sang trọng, phù hợp với nhiều kiểu không gian</li>\n<li>Thích hợp với làn da trẻ em, nhạy cảm.</li>\n<li>Đem lại trải nghiệm giấc ngủ tuyệt vời.</li>\n</ul><p><img src=\"https://salt.tikicdn.com/ts/tmp/12/f4/c6/08da628a99bece201957e4c49346ea9b.jpg\" alt=\"\" width=\"750\" height=\"1000\" /></p>\n<p><em>Mền lông cừu caro cao cấp A với mẫu caro bắt mắt, tạo sự mới mẻ cho căn phòng của bạn</em></p>\n<p><strong>5 ĐẶC TÍNH VƯỢT TRỘI:</strong></p>\n<ul><li>MỀM</li>\n<li>MỊN</li>\n<li>BỀN</li>\n<li>GỌN NHẸ</li>\n<li>TIỆN LỢI</li>\n</ul><h4>LÝ DO NÊN LỰA CHỌN MỀN LÔNG CỪU CARO CAO CẤP A?</h4>\n<ul><li>Màu sắc hiện đại, sang trọng. Phù hợp nhiều không gian và phong cách sống.</li>\n<li><strong>Mền lông cừu</strong> với cấu trúc đan khít nên có khả năng làm ấm nhanh, giữ nhiệt lâu, mang lại sự ấm áp tức thì, bạn có thể nhanh chóng chìm vào giấc ngủ ngon.</li>\n<li>Chất liệu lông mềm mịn êm ái tuyệt đối, không gây dị ứng da, thô ráp hay khó chịu, mang lại sự dễ chịu và an toàn tuyệt đối cho làn da bạn.</li>\n<li>Đường may trau chuốt tỉ mỉ, sợi lông mềm mịn tay, tạo cảm giác dễ chịu khi đắp.</li>\n<li>Đặc tính mỏng nhẹ, có thể mang theo và sử dụng bất cứ nơi đâu mà bạn muốn: sofa, du lịch, giường, xe hơi.</li>\n</ul><p><img src=\"https://salt.tikicdn.com/ts/tmp/22/0e/cc/cffa2f67235c6a458310336d1c6a1423.jpg\" alt=\"\" width=\"750\" height=\"562\" /></p>\n<p><em>Mền lông cừu caro cao cấp A cấu trúc đan khít nhưng không gây bí bức</em></p>\n<p>Lưu ý:</p>\n<ul><li>Giặt tay hoặc giặt máy nhẹ nhàng</li>\n<li>Nên phơi dưới trời nắng nhẹ</li>\n<li>Không sử dụng chất tẩy</li>\n</ul><h4><strong>HƯỚNG DẪN GIẶT MÁY ĐÚNG CÁCH:</strong></h4>\n<p>– Đặt mền trong máy giặt và đảm bảo kích thước của chăn phù hợp với máy giặt.</p>\n<p>– Điều chỉnh nhiệt độ nước làm mát và chu kỳ máy để nhẹ nhàng.</p>\n<p>– Thêm vừa đủ chất tẩy rửa cần thiết và khởi động máy giặt.</p>\n<p>– Giặt mền ở chế độ giặt nhẹ nhàng và lặp lại 2 lần để đảm bảo mền được sạch hoàn toàn, không nên đặt chế độ giặt quá mạnh để tránh lông cừu trở nên thô cứng.</p>\n<p>– Lấy chăn từ máy giặt, lắc nhẹ nhàng để loại bỏ các nếp nhăn sau đó treo trên giá đỡ khô và để khô tự nhiên.</p>\n<h1>CẢM ƠN BẠN ĐÃ TIN TƯỞNG VÀ SỬ DỤNG SẢN PHẨM CỦA CHÚNG TÔI.</h1><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/a9/ca/7f/17cb24e359275cdfff8dd55039c5c644.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a9/ca/7f/17cb24e359275cdfff8dd55039c5c644.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a9/ca/7f/17cb24e359275cdfff8dd55039c5c644.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a9/ca/7f/17cb24e359275cdfff8dd55039c5c644.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a9/ca/7f/17cb24e359275cdfff8dd55039c5c644.png"},{"base_url":"https://salt.tikicdn.com/ts/product/12/f4/c6/5f10027a5219725bb7e1e0a028bc6b7c.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/12/f4/c6/5f10027a5219725bb7e1e0a028bc6b7c.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/12/f4/c6/5f10027a5219725bb7e1e0a028bc6b7c.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/12/f4/c6/5f10027a5219725bb7e1e0a028bc6b7c.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/12/f4/c6/5f10027a5219725bb7e1e0a028bc6b7c.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/6a/d0/2d/3d42d09db0a3a1cd13494de93dfece58.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/6a/d0/2d/3d42d09db0a3a1cd13494de