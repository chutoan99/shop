f14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":24000,"discount_rate":20,"rating_average":5,"review_count":3,"review_text":"(3)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/1e/e3/66/66203295befd440621504535e364dbe2.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":770,"all_time_quantity_sold":25,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e     Giáo trình 301 câu đàm thoại tiếng Hoa là một giáo trình khá quen thuộc đối với người học tiếng Hoa ở Việt Nam. Nhằm giúp cho người học tiếng Hoa, nhất là những người đang sử dụng giáo trình 301 câu đàm thoại tiếng Hoa, củng cố kiến thức đã học và luyện tập để làm quen với kỳ thi HSK trình độ sơ cấp (cấp 1 - 2), chúng tôi đã biên soạn quyển Bài tập 301 câu đàm thoại tiếng Hoa - Luyện thi HSK cấp 1 - 2 này.\u003cbr /\u003e     Khác với quyển Bài tập 301 câu đàm thoại tiếng Hoa đã xuất bản, quyển sách bài tập này được biên soạn nhằm mục đích “luyện thi HSK”, cho nên các bài tập trong sách đa phần được mô phỏng theo các dạng đề HSK cấp 1 - 2. Sách cũng gồm 40 bài theo những chủ đề trong giáo trình 301 câu đàm thoại tiếng Hoa, cụ thể như sau:\u003cbr /\u003e       - Từ bài 1-5 chủ yếu là những bài tập về ngữ âm (đọc từ; nghe ghi âm viết thanh mẫu, vận mẫu, dấu giọng; phiên âm cho từ), chữ Hán (viết chữ Hán dựa theo phiên âm), nhìn hình chọn đáp án (chọn từ ngữ, đối thoại tương ứng với hình).\u003cbr /\u003e       - Từ bài 6 - 40, bài tập được chia làm 4 phần: Nghe, Đọc, Ngữ âm, Chữ Hán.\u003cbr /\u003e         • Bài tập ở phần Nghe và phần Đọc của bài 6 - 25 được mô phỏng theo các dạng đề HSK cấp 1 (nghe từ hoặc ngữ, phán đoán đúng sai; nghe đối thoại, chọn hình phù hợp với nội dung đối thoại; nghe câu, chọn đáp án đúng; xem từ ngữ, phán đoán hình đúng sai; phối hợp câu hỏi với câu trả lời; xem câu/đối thoại, chọn từ điền trống).\u003cbr /\u003e         • Bài tập ở phần Nghe và phần Đọc của bài 26 - 40 được mô phỏng theo các dạng đề HSK cấp 2 (nghe câu, phán đoán đúng sai; nghe đối thoại, chọn hình phù hợp với nội dung đối thoại; nghe đối thoại, chọn đáp án đúng; xem câu, phối hợp hình; xem câu/đối thoại, chọn từ điền trống; xem câu, phán đoán đúng sai; xem xong phối hợp câu). Các bài tập ở phần Nghe từ bài 6 - 40 đều có văn bản ghi âm (ở phần sau quyển sách).\u003cbr /\u003e         • Bài tập ở phần Ngữ âm chủ yếu có dạng nghe ghi âm chọn từ ngữ, đánh dấu giọng, chú ý trọng âm và điệu lên xuống cuối câu.\u003cbr /\u003e         • Bài tập ở phần chữ Hán chủ yếu kiểm tra về thiên bàng/bộ thủ và từ vựng (xem nghĩa từ, viết ra chữ Hán và phối hợp với hình ảnh).\u003cbr /\u003e     Sau khi làm xong bài tập, người học có thể đối chiếu với phần “Đáp án tham khảo” ở cuối sách để biết về tình hình làm bài của mình. Qua những bài tập này, người học có thể củng cố lại những kiến thức đã học và làm quen với các dạng đề HSK cấp 1 - 2. Phần đầu quyển sách còn có bài “Giới thiệu về kỳ thi HSK (cấp 1 và cấp 2)” giúp người học nắm được những thông tin cơ bản về kỳ thi HSK cấp 1-2 để có sự chuẩn bị tốt cho kỳ thi.\u003cbr /\u003ePhần nghe của tài liệu cũng được cung cấp dưới 3 hình thức: 1-Bài nghe trực tuyến ở dạng trang web. 2-Nghe trực tuyến bằng cách quét mã QR. 3- Tải file nghe về máy để nghe không cần có internet. Dạng đầu tiên là ưu việt nhất. Người học chỉ cần có máy tính, điện thoại hay máy tính bảng có nối internet là có thể nghe được các bài đọc một cách thuận tiện nhất trong quá trình làm bài.\u003cbr /\u003e     Ngoài ra, trang web  của chúng tôi có một trang hỗ trợ cho cuốn sách này. Trên trang có những liên kết đến rất nhiều các phụ lục, thông tin cần thiết cho việc học tập, đồng thời trang còn có một thư viện các đề thi HSK cấp 1, 2 giúp người học ôn luyện cho kỳ thi. Đặc biệt, chúng tôi đã thiết kế một khoá học gồm một số đề thi mô phỏng để người học làm bài thi trực tuyến.\u003c/p\u003e\n\u003cp\u003e     Hy vọng đây sẽ là một cuốn sách có ích cho những người mới học tiếng Hoa muốn nâng cao trình độ tiếng Hoa của mình, đặc biệt là những người có ý định tìm hiểu hoặc chuẩn bị tham gia kỳ thi HSK cấp 1 - 2.\u003c/p\u003e\n\u003cp\u003e      Sách bìa mềm, 328 trang.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/1e/e3/66/66203295befd440621504535e364dbe2.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/1e/e3/66/66203295befd440621504535e364dbe2.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/1e/e3/66/66203295befd440621504535e364dbe2.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1e/e3/66/66203295befd440621504535e364dbe2.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1e/e3/66/66203295befd440621504535e364dbe2.png"},{"base_url":"https://salt.tikicdn.com/ts/product/69/c3/fd/334a4d615646568d7db27bce67826633.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/69/c3/fd/334a4d615646568d7db27bce67826633.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/69/c3/fd/334a4d615646568d7db27bce67826633.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/69/c3/fd/334a4d615646568d7db27bce6782