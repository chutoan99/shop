f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.8,"review_count":4,"review_text":"(4)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/e7/bb/dd/b9936e2d0959246d09b4534248c0070b.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1176,"all_time_quantity_sold":32,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eBộ sách “\u003cstrong\u003eChu du cùng những người bạn thú vị\u003c/strong\u003e” là sản phẩm thuộc dòng sách “\u003c/span\u003e\u003cstrong\u003eCả nhà cùng đọc to\u003c/strong\u003e\u003cspan style=\"font-weight: 400;\"\u003e” dành riêng cho trẻ em từ 0 - 6 tuổi của Lionbooks được xuất hiện lần đầu tiên trên thị trường. \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/d8/87/21/ca7fc29f35e5289958fa646a89101be3.JPG\" alt=\"\" width=\"600\" height=\"395\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eNhững cuốn sách “cả nhà cùng đọc to” mà Lionbooks thực hiện dựa trên triết lý: với trẻ em, một cuốn sách hay là cuốn sách được đọc cùng những người thương yêu nhất. \u003c/span\u003e\u003cspan style=\"font-weight: 400;\"\u003eĐây cũng là cơ sở cho việc hình thành mối liên kết bền chặt giữa em bé với mọi người thân thương xung quanh, giữa bé với thiên nhiên muôn màu đầy những háo hức.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/5f/2b/4d/8dfbdd6fa5b8b1df568d16743aad66d2.JPG\" alt=\"\" width=\"599\" height=\"399\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003e“\u003cstrong\u003eCả nhà cùng đọc to\u003c/strong\u003e” được ra đời với định hướng cốt lõi đó, nội dung đơn giản, hình thức gần gũi, dễ tiếp cận, từ đó xây dựng những ký ức quý giá để phát triển trí tuệ cảm xúc và trí tưởng tượng muôn màu ở mỗi em bé, đồng hành cùng ba mẹ trong hành trình nuôi dưỡng nên những em bé hạnh phúc.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e“Chu du cùng những người bạn thú vị”\u003c/strong\u003e \u003cspan style=\"font-weight: 400;\"\u003egồm nhiều câu chuyện nhỏ đáng yêu được biên soạn gồm 3 cuốn, giúp bé nhận biết được đặc điểm, tên gọi của các loại quả khác nhau, lồng ghép vào từng trang sách là  những bài học thú vị về sự ngăn nắp, sự giúp đỡ Từ đó kết nối mỗi em bé đến với thế giới muôn màu đầy những háo hức. \u003c/span\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eBộ sách gồm 3 cuốn:\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003e Cuốn “Bơ bụ bẫm nghịch ngợm”: Cùng bé làm quen với bạn Bơ Bụ Bẫm để khám phá thật nhiều món ngon biến hóa từ bạn Bơ siêu thơm ngon.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/11/0a/90/da174a62757ff64de39eed27f07fda99.JPG\" alt=\"Bơ Bụ Bẫm nghịch ngợm\" width=\"601\" height=\"394\" /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003e Cuốn “Gia đình táo đâu rồi?”: Bạn Táo nhỏ đi lạc, bé giúp bạn tìm lại gia đình và nhận biết thêm nhiều “gia đình trái cây” thú vị khác nữa nhé!\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/47/eb/d4/b0a66b47e885363f766334c45bfe5a3e.JPG\" alt=\"Gia đình táo đâu rồi?\" width=\"602\" height=\"392\" /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003e Cuốn “Dâu Dịu Dàng và những người bạn ở nông trại”: Cùng bạn Dâu Dịu Dàng trải qua một ngày tại nông trại để khám phá thế giới nhỏ ấy tươi vui đến nhường nào.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/6b/fa/07/6afcc1ee809cbe963dc405df80773a6e.JPG\" alt=\"\" width=\"603\" height=\"385\" /\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/e7/bb/dd/b9936e2d0959246d09b4534248c0070b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e7/bb/dd/b9936e2d0959246d09b4534248c0070b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e7/bb/dd/b9936e2d0959246d09b4534248c0070b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e7/bb/dd/b9936e2d0959246d09b4534248c0070b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e7/bb/dd/b9936e2d0959246d09b4534248c0070b.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/23/30/16/cd35e9c9d9c86b7e3e425ae7e83b191e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/23/30/16/cd35e9c9d9c86b7e3e425ae7e83b191e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/23/30/16/cd35e9c9d9c86b7e3e425ae7e83b191e.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/23/30/16/cd35e9c9d9c86b7e3e425ae7e83b191e.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/23/30/16/cd35e9c9d9c86b7e3e425ae7e83b191e