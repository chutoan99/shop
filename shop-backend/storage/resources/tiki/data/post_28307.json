/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":42900,"discount_rate":13,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/00/08/e7/8bc46c239305308bad6264b990b1894e.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":180,"all_time_quantity_sold":3,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cspan style=\"color:#993366;\"\u003e\u003cstrong\u003eNHẬN DIỆN 5 TỔN THƯƠNG\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003eCuốn sách mô tả những quan sát của tác giả trong hình thể, ngôn ngữ và lời nói của những người đang tái diễn tổn thương (với tổn thương nhục nhã, bị bỏ rơi, bị phủ nhận, bị phản bội, bị đối xử bất công).\u003c/p\u003e\n\u003cp\u003eNhờ những miêu tả trực giác này của tác giả mà chúng ta có thể phán đoán được một người đang bị ảnh hưởng nhiều bởi chấn thương cảm xúc nào, và việc tự đánh đồng chấn thương cảm xúc đầu đời ấy đã tác động lên cuộc đời họ, cách họ sinh hoạt, nói năng, cách họ đưa ra các lựa chọn của đời mình, và rồi được biểu hiện qua cơ thể ra sao. Qua những tổn thương đó, chúng ta thấy được mối quan hệ giữa mặt nạ vô thức ta mang trong quá trình đối phó với những tổn thương và biểu hiện của chúng trên cơ thể ta.\u003c/p\u003e\n\u003cp\u003eThông qua cuốn sách, chúng ta dần thấu hiểu tâm thức của con người và có thể rút ra được bài học cho chính mình trên hành trình “thành nhân” (theo cách nói của Carl Rogers) hay “thành toàn tự ngã” (theo cách nói của Carl Jung) của mỗi chúng ta.\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color:#ff9900;\"\u003e\u003cstrong\u003eCHỮA LÀNH 5 TỔN THƯƠNG\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003eĐây là cuốn sách rất được mong chờ sau thành công của Lise Bourbeau với cuốn sách “Nhận diện 5 tổn thương” được hàng nghìn người trên thế giới đón nhận.\u003c/p\u003e\n\u003cp\u003eTrong cuốn sách này, bạn sẽ học được cách nhận ra cơ chế của những tổn thương và biết được khi nào thì chúng bị kích hoạt. Để chữa lành được tổn thương thì chúng ta nhất định phải nhận ra vô vàn các trường hợp mà cái tôi (mặt nạ nguỵ trang của chúng ta) dẫn dắt suy nghĩ, lời nói và hành động của chúng ta.\u003c/p\u003e\n\u003cp\u003eTrong khi áp dụng những gợi ý được đưa ra trong cuốn sách này, bạn sẽ nhận ra tác động của những tổn thương này sẽ giảm dần và từng chút một bạn sẽ làm chủ cuộc sống của mình. Và điều này cho phép bạn bộc lộ những nhu cầu căn bản nhất của linh hồn mình và đạt được bình yên trong tâm hồn. \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cem\u003e\u003cu\u003eGiới thiệu tác giả:\u003c/u\u003e\u003c/em\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eLise Bourbeau\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eLise Bourbeau là tác giả nổi tiếng toàn cầu, bà đã viết 20 cuốn sách, trong đó có nhiều đầu sách best-seller về chủ đề lắng nghe cơ thể và nhận diện những tổn thương bên trong. Sách của bà được dịch ra gần 20 ngôn ngữ trên thế giới. Từ khi thành lập trường phái nghiên cứu của mình vào năm 1982, những tư tưởng của bà đã giúp đỡ rất nhiều người cải thiện chất lượng cuộc sống và tạo ra những thay đổi bền vững hàng ngày. Lắng nghe cơ thể bạn, trường phái phát triển bản thân có sức ảnh hưởng lớn nhất ở Quebec, đã được truyền bá trong các buổi hội thảo trên hơn 20 quốc gia và trong 10 thứ ngôn ngữ.\u003c/p\u003e\n\u003cp\u003eBộ sách “Nhận diện 5 tổn thương” và “Chữa lành 5 tổn thương” là hai trong số rất nhiều đầu sách best-seller của bà.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/00/08/e7/8bc46c239305308bad6264b990b1894e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/00/08/e7/8bc46c239305308bad6264b990b1894e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/00/08/e7/8bc46c239305308bad6264b990b1894e.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/00/08/e7/8bc46c239305308bad6264b990b1894e.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/00/08/e7/8bc46c239305308bad6264b990b1894e.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/62/0d/6d/1f3a2e67f3d1e8c07ef8f1ac98c59230.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/62/0d/6d/1f3a2e67f3d1e8c07ef8f1ac98c59230.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/62/0d/6d/1f3a2e67f3d1e8c07ef8f1ac98c59230.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/62/0d/6d/1f3a2e67f3d1e8c07ef8f1ac98c59230.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/62/0d/6d/1f3a2e67f3d1e8c07ef8f1ac98c59230.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/a2/3a/e9/da40ff52bd892278593f143bea7b75ce.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a2/3a/e9/da40ff52bd892278593f143bea7b75ce.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a2/3a/e9/da40ff52bd892278593f143bea7b75ce.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a2/3a/e9