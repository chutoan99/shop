.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":805740,"discount_rate":19,"rating_average":4.5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/64/50/0f/fff2f3b567c90869f7aef41af729b50a.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":880,"all_time_quantity_sold":4,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2\u003eMô Tả Sản Phẩm\u003c/h2\u003e\n\u003cdiv\u003e\n\u003cdiv\u003e\n\u003cdiv\u003e\n\u003cdiv\u003e\n\u003ch3\u003eThiết kế sang trọng\u003c/h3\u003e\n\u003cp\u003e\u003cstrong\u003eNồi cơm điện cao tần Sharp 1.8 lít KS-IH191V\u003c/strong\u003e có thiết kế vô cùng hiện đại và sang trọng. Ngoài ra, sản phẩm có thiết kế cực kỳ thông minh. Lòng nồi được phủ lớp chống dính giúp hạn chế trường hợp cơm bị cháy xén đồng thời giúp việc vệ sinh nồi được dễ dàng hơn. Nắp nồi được thiết kế với khả năng ngăn hơi nước đóng tụ giúp cơm không bị nhão mà vẫn chín đều. Màn hình hiển thị thông số cùng các nút bấm chọn chế độ nấu giúp bạn thuận tiện với các thao tác khi sử dụng và quai xách chắc chắn giúp bạn thuận tiện khi di chuyển nồi đến nơi bạn muốn.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cdiv\u003e\n\u003cdiv\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv\u003e\n\u003cdiv\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/ee/01/bd/30dd4c6a74ad6fe9b2ddb070cd2d2130.jpg\" alt=\"ee01bd19e95f0b487f92749c95b894dd.jpg\" width=\"750\" height=\"1000\"\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eCông nghệ nấu cảm ứng từ IH cho cơm thơm ngon, mềm dẻo\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eSharp KS-IH191V-GL trang bị công nghệ cao tần IH cùng công suất 1300W giúp làm nóng nồi cơm trực tiếp, không qua mâm nhiệt giúp cơm ngon và bảo toàn dưỡng chất trong gạo.\u003c/p\u003e\n\u003ch3\u003eCông nghệ nhiệt 3D giúp cơm chín đều, giữ ấm lâu\u003c/h3\u003e\n\u003cp\u003eNhiệt tỏa ra cả bên hông và trên nắp giúp cơm được cung cấp đầy đủ nhiệt và chín đều. Khả năng duy trì độ ấm và hẹn giờ liên tục đến 24 giờ.\u003c/p\u003e\n\u003ch3\u003eLòng nồi 6 lớp, phủ lớp chống dính cao cấp\u003c/h3\u003e\n\u003cp\u003eLòng nồi có 6 lớp giúp truyền nhiệt vào tận lõi của hạt gạo, giúp cơm chín đều, hạt cơm mềm dẻo và thơm ngon. Gồm có lớp phủ chống dính, lớp phủ, lớp nhôm, lớp thép không gỉ, lớp phủ chịu nhiệt, chống ăn mòn và silicone chống mài mòn và lớp ngoài phủ chịu nhiệt, chống ăn mòn và silicone chống mài mòn.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cdiv\u003e\n\u003cdiv\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv\u003e\n\u003cdiv\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/66/29/42/e50782b22a139ab07761515ff1714330.jpg\" alt=\"66294265a5bf3046a1c09feb45ecf9a7.jpg\"\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch3\u003eBảng điều khiển cảm ứng chạm dễ sử dụng\u003c/h3\u003e\n\u003cp\u003eNồi Cơm Điện Cao Tần Sharp KS-IH191V trang bị bảng điều khiển cảm ứng hiện đại dễ hiểu, dễ dùng, điều khiển đa chức năng nấu của nồi từ nấu cơm, nấu cháo, nấu cơm trộn, nấu cơm nồi đất, nấu súp, hấp, làm bánh.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cdiv\u003e\n\u003cdiv\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv\u003e\n\u003cdiv\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/7b/4f/54/1833af94e150a5e3c1fd56e776311bf3.jpg\" alt=\"7b4f5425a8e107d6fc46cfeb8552d78e.jpg\"\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eNồi có hẹn giờ nấu xong tiện dụng, hỗ trợ người dùng nấu ăn ngay cả những lúc bận rộn.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cdiv\u003e\n\u003cdiv\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv\u003e\n\u003cdiv\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/1b/4f/a5/93cc665e92b99613c915a1e1400364ff.jpg\" alt=\"1b4fa5ecd9b9f28077f5792ab5bf3e36.jpg\"\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eVan thoát hơi thông minh giữ hơi nước ổn định trong quá trình nấu, bảo toàn vitamin sẵn có trong gạo, cho cơm ngon dinh dưỡng trọn vẹn.\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/64/50/0f/fff2f3b567c90869f7aef41af729b50a.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/64/50/0f/fff2f3b567c90869f7aef41af729b50a.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/64/50/0f/fff2f3b567c90869f7aef41af729b50a.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/64/50/0f/fff2f3b567c90869f7aef41af729b50a.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/64/50/0f/fff2f3b567c90869f7aef41af729b50a.png"},{"base_url":"https://salt.tikicdn.com/ts/product/0a/9c/9f/0ae46ffe42230e20b4f78a7f888ab03e.png","is_gallery":true,"label":null,"large_url":"https://salt.