xt_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":7000,"discount_rate":20,"rating_average":4.5,"review_count":46,"review_text":"(46)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/61/de/38/0a8a4fe9bf35ff9213911db2e4bb6ca3.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1933,"all_time_quantity_sold":428,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eCác em nhỏ ai chẳng yêu mến và muốn được khám phá cuộc sống của các loài động vật xung quanh mình, đặc biệt là câu chuyện về loài chó - vốn là con vật nuôi gần gũi với chúng ta luôn cuốn hút sự tò mò của các em phải không nào?\u003c/p\u003e\n\u003cp\u003eVì sao lại là chó, mà không phải là các con vật khác? Câu trả lời thật đơn giản và dễ hiểu, bởi vì chú chó thật thông minh, thật tốt bụng nên em nhỏ nào cũng yêu quý và muốn khám phá cuộc sống của loài động vật thân thuộc với các em.\u003c/p\u003e\n\u003cp\u003eThấu hiểu được mong muốn đó, tác giả Việt An đã dành nhiều thời gian biên soạn và ấn hành cuốn truyện tranh đặc biệt, một siêu phẩm độc đáo và vô cùng ấn tượng về cuộc sống của chú chó có tên là BÉC-LA.\u003c/p\u003e\n\u003cp\u003eThật là đặc biệt các em ạ, BÉC-LA là chú chó vô cùng tinh khôn. Chú không chỉ trông nhà giỏi, mà còn có tài diệt chuột. BÉC-LA có chiếc mũi rất thính và đôi tai rất tinh nên đánh hơi chuột rất tài. Chỉ cần họ hàng nhà chuột mon men tới gần hay còn đang ẩn nấp ở phía xa, BÉC-LA cũng phát hiện ra ngay.\u003c/p\u003e\n\u003cp\u003eVì sao chú chó BÉC-LA lại bắt chuột tài tình như vậy? Và vì sao bọn chuột lại sợ chú chó BÉC-LA hơn chị mèo MÉC-LA? Các em hãy cùng đọc và khám phá cuốn truyện tranh về \u003cstrong\u003eCHÚ CHÓ THÔNG MINH VÀ TỐT BỤNG\u003c/strong\u003e được phác thảo bởi họa sĩ Kim Dung, cùng cây bút đặc sắc chuyên truyện thiếu nhi – tác giả Việt An, cuốn truyện tranh \u003cstrong\u003eCHÚ CHÓ THÔNG MINH VÀ TỐT BỤNG\u003c/strong\u003e thực sự là người bạn thân thiết và không thể thiếu của các em nhỏ.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/61/de/38/0a8a4fe9bf35ff9213911db2e4bb6ca3.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/61/de/38/0a8a4fe9bf35ff9213911db2e4bb6ca3.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/61/de/38/0a8a4fe9bf35ff9213911db2e4bb6ca3.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/61/de/38/0a8a4fe9bf35ff9213911db2e4bb6ca3.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/61/de/38/0a8a4fe9bf35ff9213911db2e4bb6ca3.jpg"},{"base_url":"https://salt.tikicdn.com/media/catalog/producttmp/a6/c7/71/059ad34bb0f55242d79615c3adcdfaab.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/producttmp/a6/c7/71/059ad34bb0f55242d79615c3adcdfaab.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/producttmp/a6/c7/71/059ad34bb0f55242d79615c3adcdfaab.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/producttmp/a6/c7/71/059ad34bb0f55242d79615c3adcdfaab.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/producttmp/a6/c7/71/059ad34bb0f55242d79615c3adcdfaab.jpg"},{"base_url":"http