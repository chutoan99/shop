 thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/21/09/44/b2c774f01c284156913ee0cd361e5af1.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/21/09/44/b2c774f01c284156913ee0cd361e5af1.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/21/09/44/b2c774f01c284156913ee0cd361e5af1.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/21/09/44/b2c774f01c284156913ee0cd361e5af1.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/21/09/44/b2c774f01c284156913ee0cd361e5af1.jpg"}],"warranty_policy":null,"authors":[{"id":4043,"name":"Nhiều Tác Giả","slug":"nhieu-tac-gia"}],"current_seller":{"id":171251,"sku":"3887267236201","name":"Nhà Sách Nam MeKong","link":"https://tiki.vn/cua-hang/nha-sach-nam-mekong","logo":"93/c1/04/91291f5c58c7070b9ce4a5278a507573.jpg","price":24600,"product_id":"101477691","store_id":158287,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[{"id":140393,"name":"Nhà Sách Dân Tiếng Trung","link":"https://tiki.vn/cua-hang/nha-sach-dan-tieng-trung","logo":"d8/8b/1e/2647540bbb1b477a1f68add126b8634e.jpg","price":29000,"product_id":"101257200","store_id":129622}],"specifications":[{"name":"Thông tin chung","attributes":[{"code":"publisher_vn","name":"Công ty phát hành","value":"Nhà Sách Hải Hà"},{"code":"publication_date","name":"Ngày xuất bản","value":"2014-04-01 00:00:00"},{"code":"dimensions","name":"Kích thước","value":"14.5 x 20.5 cm"},{"code":"book_cover","name":"Loại bìa","value":"Bìa cứng"},{"code":"number_of_page","name":"Số trang","value":"111"},{"code":"manufacturer","name":"Nhà xuất bản","value":"Nhà Xuất Bản Đại Học Sư Phạm TPHCM"}]}],"price_comparison":{"sub_title":"Giá từ 29.000 ₫","title":