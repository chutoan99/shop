ht":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":3,"review_text":"(3)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/fe/ac/95/d237b10853f9c46e1e480ccc2f625bca.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1482,"all_time_quantity_sold":5,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: left;\"\u003e\u003cstrong\u003eVài nét về thương hiệu Nature's Way Úc:\u003c/strong\u003e\u003cbr /\u003eNature’s Way là thương hiệu cung cấp các sản phẩm chăm sóc sức khỏe cho cả gia đình nổi tiếng thế giới và hàng đầu của Úc được thành lập từ năm 1943 - Nature's Way có trên 200 sản phẩm, cung cấp vô cùng đa dạng cho các đối tượng: trẻ sơ sinh, trẻ em, phụ nữ, nam giới, người cao tuổi với nhiều nhu cầu khác nhau như: bổ sung vitamin, khoáng chất, giảm cân, làm đẹp, ) - Nature’s Way hiện ở hơn 10.000 nhà thuốc, siêu thị trên hàng trăm nước toàn thế giới ( Châu Á, Châu Âu, Châu Mỹ, ) và được hàng triệu gia đình tin yêu và sử dụng\u003cbr /\u003e\u003cbr /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/21/9b/ff/6d89bd973e05b74750c31d3f6c76de71.jpeg\" alt=\"\" width=\"750\" height=\"421\" /\u003e\u003c/p\u003e\n\u003ch2\u003eVÌ SAO CẦN BỔ SUNG DHA CHO BÉ?\u003c/h2\u003e\n\u003cp style=\"text-align: left;\"\u003eHiểu được tầm quan trọng của DHA đối với sự phát triển trí tuệ cho bé yêu, Nature’s way đã điều chế riêng sản phẩm bổ sung DHA dưới dạng viên kẹo nhai để bé bổ sung mỗi ngày. \u003cstrong\u003eViên nhai Nature’s Way Kids Smart DHA 300mg \u003c/strong\u003echứa hàm lượng DHA cao (300mg) giúp bé thông minh hơn, phát triển trí não toàn diện, kích thích khả năng học hỏi, ghi nhớ. Sản phẩm được điều chế an toàn cho trẻ em trên 1 tuổi đã được nhiều bà mẹ tin dùng.\u003cbr /\u003e\u003cbr /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/89/ee/a0/7819f46e0748241295d850100fa4b56e.png\" alt=\"\" width=\"714\" height=\"503\" /\u003e\u003c/p\u003e\n\u003cp\u003eTrẻ em giai đoạn những năm đầu đời rất cần nguồn dưỡng chất đầy đủ để phát triển cả về thể chất lẫn trí tuệ. Nếu như các loại vitamin, chất đạm cung cấp năng lượng và tăng cường sức khỏe cho bé, thì DHA đóng vai trò không hề nhỏ trong việc phát triển trí não, giúp bé thông minh.\u003cbr /\u003eDHA là thành phần đặc biệt quan trọng trong não bộ, chiếm tỷ lệ cao trong chất xám, nơ ron thần kinh và giác mạc mắt. DHA là có nhiều trong các loại cá mòi, cá trích, cá cơm, nhưng nếu bé không thích ăn cá hoặc cơ địa hấp thu kém thì bổ sung DHA qua viên nhai là lý tưởng nhất. Hàm lượng DHA khuyến cáo được chuyên gia khuyến nghị bổ sung cho bé là 200 - 300mg.\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003e\u003cbr /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/fe/ac/95/d237b10853f9c46e1e480ccc2f625bca.jpg","is_gallery