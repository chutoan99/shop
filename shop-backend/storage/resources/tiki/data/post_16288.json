ng\u003e\u003c/h2\u003e\n\u003cp\u003eTránh tiếp xúc trực tiếp với mắt. Trường hợp có tiếp xúc trực tiếp với mắt, phải rửa ngay với nhiều nước sạch. Tóc khô và gãy cần thời gian ủ dầu xả trên tóc lâu hơn. Không nên dùng lượng dầu xả quá nhiều, xả không sạch, để dầu xả dính vào chân tóc có thể gây bết tóc và gây ngứa da dầu\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ee/2d/b8/fde6c21d2fc7d73341031443a6bf96cc.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ee/2d/b8/fde6c21d2fc7d73341031443a6bf96cc.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ee/2d/b8/fde6c21d2fc7d73341031443a6bf96cc.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ee/2d/b8/fde6c21d2fc7d73341031443a6bf96cc.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ee/2d/b8/fde6c21d2fc7d73341031443a6bf96cc.png"}],"warranty_policy":null,"brand":{"id":185875,"name":"Sao Thái Dương","slug":"sao-thai-duong"},"current_seller":{"id":19898,"sku":"6237190873900","name":"Sao Thái Dương","link":"https://tiki.vn/cua-hang/sao-thai-duong","logo":"https://vcdn.tikicdn.com/ts/seller/ef/65/c3/d9fba0d59e8bee7abf8a4e3468e47709.jpg","price":60000,"product_id":"273098413","store_id":19394,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Operation","attributes":[{"code":"is_warranty_applied","name":"Sản phẩm có được bảo hành không?","value":"Không"}]},{"name":"Content","attributes":[{"code":"brand","name":"Thương hiệu","value":"Sao Thái Dương"},{"code":"origin","name":"Xuất xứ (Made in)","value":"Việt Na