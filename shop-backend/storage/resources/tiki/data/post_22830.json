o từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/f0/f0/ab/dd0ff85e2e41a75c460760ab57950f7e.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f0/f0/ab/dd0ff85e2e41a75c460760ab57950f7e.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f0/f0/ab/dd0ff85e2e41a75c460760ab57950f7e.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f0/f0/ab/dd0ff85e2e41a75c460760ab57950f7e.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f0/f0/ab/dd0ff85e2e41a75c460760ab57950f7e.png"},{"base_url":"https://salt.tikicdn.com/ts/product/bd/7d/af/ccf024862ac43846b583a668a7dd1c63.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/bd/7d/af/ccf024862ac43846b583a668a7dd1c63.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/bd/7d/af/ccf024862ac43846b583a668a7dd1c63.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/bd/7d/af/ccf024862ac43846b583a668a7dd1c63.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/bd/7d/af/ccf024862ac43846b583a668a7dd1c63.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/23/38/bb/b5556912bf2ba0709b4ce90ff2c5b125.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/23/38/bb/b5556912bf2ba0709b4ce90ff2c5b125.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/23/38/bb/b5556912bf2ba0709b4ce90ff2c5b125.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/23/38/bb/b5556912bf2ba0709b4ce90ff2c5b125.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/23/38/bb/b5556912bf2ba0709b4ce90ff2c5b125.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/e0/89/95/e145b62340e2b56788525190137c4055.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w