_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/0c/10/61/57870bc9e8f77a115a5c7f13cf1a2b30.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":837,"all_time_quantity_sold":10,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p><strong>Thông tin xuất bản:</strong></p>\n<p>Tên sách: Ehon Châu Âu – Người Mẹ tuyệt vời nhất</p>\n<p>Tác giả: Stephanie Moss</p>\n<p>Người dịch: Phương Nhung</p>\n<p>Khổ sách: 23x23 cm</p>\n<p>Số trang: 24</p>\n<p>Giá bìa: 35.000 đ</p>\n<p>Code: 8935210302144</p>\n<p>Bản quyền tiếng Việt thuộc Công ty CP Văn hóa và Giáo dục Tân Việt. Công ty Tân Việt liên kết xuất bản với NXB Mỹ thuật</p>\n<p><strong><em>Người Mẹ tuyệt vời nhất</em></strong></p>\n<p>Bất cứ bà mẹ nào cũng dành cho con mình một tình yêu vô bờ bến. Mẹ luôn ở bên lo lắng, động viên, giúp đỡ khi các con gặp khó khăn, đơn độc. Bất cứ người mẹ nào cũng là người mẹ tuyệt vời nhất. Qua những câu văn đong đầy tình cảm cùng các hình minh họa tuyệt đẹp trong cuốn sách này, bé sẽ cảm nhận được tình yêu thương đó đấy.</p>\n<p>Được mệnh danh là “thực phẩm nuôi dưỡng tâm hồn trẻ thơ” – Bộ sách “Ehon Châu Âu” giống như một thế giới diệu kỳ mà mỗi đứa trẻ đều từng đi qua, chơi đùa thỏa thích, tự do suy tưởng về vô vàn những điều lý thú xung quanh. Bộ sách như một cánh cửa không thể thiếu để con có thể tiến gần hơn với tri thức rộng lớn bao la ngoài kia, là khởi nguồn cho những đam mê, và thói quen đọc sách.</p>\n<p><img src=\"https://salt.tikicdn.com/ts/tmp/0c/10/61/13f16012f5de2953b2a9e38165c2d380.jpg\" alt=\"\" width=\"750\" height=\"757\" /></p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/0c/10/61/57870bc9e8f77a115a5c7f13cf1a2b30.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0c/10/61/57870bc9e8f77a115a5c7f13cf1a2b30.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/0c/10/61/57870bc9e8f77a115a5c7f13cf1a2b30.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0c/10/61/57870bc9e8f77a115a5c7f13cf1a2b30.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0c/10/61/57870bc9e8f77a115a5c7f13cf1a2b30.jpg"}],"warranty_policy":null,"current_seller":{"id":1308,"sku":"2039941752539","name":"Tazano Official Store","link":"https://tiki.vn/cua-hang/sachbanchay","logo":"95/08/28/6d2a2db44eb4b71b91fb2a1d9d60d863.jpg","price":26000,"product_id":"187746738","store_id":1265,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[{"id":96,"name":"Tân Việt","link":"https://tiki.vn/cua-hang/tan-viet","logo":"d8/12/e0/e7061e413e232fe8ffb9182b424a5f0a.jpg","price":35000,"product_id":"183501169","store_id":88},{"id":10984,"name":"Minhhabooks","link":"https://tiki.vn/cua-hang/minhhabooks","logo":"90/e2/81/710a7373c42be1565897d82ccbc00579.png","price":29000,"product_id":"187787853","store_id":10718},{"id":279977,"name":"Tiệm sách Minh Hằng","link":"https://tiki.vn/cua-hang/tiem-sach-minh-hang","logo":"72/e9/31/97b276a4c1d9e00bf2bac4f286c5b7c9.jpg","price":35000,"product_id":"189080984","store_id":267047},{"id":247391,"name":"Sunbooks Group","link":"https://tiki.vn/cua-hang/sunbooks-group","logo":"5c/63/2d/d8ddef7669aa8272faf6462fe1d02647.jpg","price":29000,"product_id":"240255567","store_id":234423}],"specifications":[{"name":"Thông tin chung","attributes":[{"code":"publisher_vn","name":"Công ty phát hành","value":"Công ty Cổ Phần V