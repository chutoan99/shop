xt_badge","type":"text_badge","index":0,"icon":null,"icon_width":0,"icon_height":0,"text_color":"#FFF0F1","background_color":"#D93843","href":null,"text":"9.9"},{"placement":"pdp_badge","code":"is_hero","type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":true,"return_reason":"any_reason"}},"discount":2601000,"discount_rate":58,"rating_average":5,"review_count":6,"review_text":"(6)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/b8/cc/18/2c891c7ff551034f9483a5b9d1bfc161.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":480,"all_time_quantity_sold":29,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cem\u003e\"Sản phẩm chỉ bán độc quyền trên kênh Online, TMĐT Vua Nệm\"\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003eNệm truyền thống quá cứng khiến bạn đau lưng? Bạn ngại đổi chỉ vì chúng gọn nhẹ, tiết kiệm chi phí và không gian?\u003c/p\u003e\n\u003cp\u003eVua Nệm cho ra mắt sản phẩm mới - Sự lựa chọn 2 trong 1 mang đến giấc ngủ vừa êm ái, vừa cải thiện cột sống lại tối ưu chi phí - không gian với thiết kế gấp 3 thông minh mang tên Goodnight Akita là lời giải đáp số 1 cho giấc ngủ ngon thật dễ dàng!\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://lzd-img-global.slatic.net/g/p/7754a2d9e2559da5facb73ee00f159af.png_2200x2200q80.png_.webp\" alt=\"7754a2d9e2559da5facb73ee00f159af.png_2200x2200q80.png_.webp\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eHình thức đóng gói: Nệm cuộn trong thúng carton\u003c/p\u003e\n\u003cp\u003eChính sách bảo hành: 10 năm\u003c/p\u003e\n\u003cp\u003eLõi nệm: PU Foam \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eLợi ích khi sử dụng nệm foam Goodnight Akita\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eĐàn hồi êm ái cải thiện sức khỏe cột sống\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eGoodnight Akita là dòng nệm foam Goodnight cải thiện hiệu quả tình trạng đau lưng, nhức mỏi nhờ sở hữu độ đàn hồi cao từ PU Foam. Chất liệu được xử lý trên dây chuyền hiện đại của Nhật giúp nâng đỡ trọn vẹn đường cong cơ thể, bảo vệ cột sống cân bằng, để cơ thể cảm nhận được sự mềm mại mà không lún trũng cho giấc ngủ thoải mái hàng đêm.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://lzd-img-global.slatic.net/g/p/338f711538d0a6298885111070d42dd8.png_2200x2200q80.png_.webp\" alt=\"338f711538d0a6298885111070d42dd8.png_2200x2200q80.png_.webp\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTiện lợi với thiết kế gấp 3 và chống trượt\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eLà một trong số ít dòng nệm foam có thiết kế gấp 3, nệm Akita gọn nhẹ và tiện lợi tiện lợi cho việc vận chuyển và cất trữ, giúp tiết kiệm tối đa diện tích phòng ngủ và bảo quản dễ dàng hơn.\u003c/p\u003e\n\u003cp\u003eĐáy nệm Akita được thiết kế bằng vải chống trượt, giữ cho nệm cố định phù hợp với gia đình có trẻ nhỏ; đồng thời chống mài mòn giúp gia tăng tuổi thọ cho sản phẩm.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eGia tăng thoáng khí \u0026amp; kháng khuẩn vượt trội\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eNệm foam Goodnight Akita cho giấc ngủ khô thoáng và sạch khuẩn trong mọi thời tiết với lớp vải bọc kép.\u003c/p\u003e\n\u003cp\u003eÁo nệm bên trong là vải thun với độ co giãn tốt để thông khí và bảo vệ lõi PU Foam. Vải ga ngoài Polyester dày dặn với lớp bông chần sát khuẩn được xử lý bằng công nghệ ép nhiệt, cho khả năng chống bụi khuẩn, thấm hút mồ hôi và bền bỉ tối ưu\u003c/p\u003e\n\u003cp\u003eBên cạnh đó, PU Foam tỷ trọng cao cũng hỗ trợ chống rung tốt, cung cấp sự thoải mái và riêng tư.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://lzd-img-global.slatic.net/g/p/549bac5df1e7fefac709b11a4e1e23c2.png_2200x2200q80.png_.webp\" alt=\"549bac5df1e7fefac709b11a4e1e23c2.png_2200x2200q80.png_.webp\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eNệm gấp gọn nhẹ và linh hoạt\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eXua tan nỗi lo mỗi khi chuyển nhà, nệm foam Goodnight có thể gấp lại làm ba và được hút cuộn chân không trong hộp nhỏ gọn nên rất tiện lợi cho việc vận chuyển và cất trữ. Nhờ công nghệ đặc biệt này mà sản phẩm tối ưu hơn các dòng nệm truyền thống, giúp tiết kiệm tối đa diện tích phòng ngủ và việc bảo quản cũng trở nên dễ dàng hơn.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eChế độ bảo hành\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eNệm foam Goodnight Akita được bảo hành chính hãng 10 năm.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://lzd-img-global.slatic.net/g/p/5252a92f05e77a9879361189ac39e771.png_2200x2200q80.png_.webp\" alt=\"5252a92f05e77a9879361189ac39e771.png_2200x2200q80.png_.webp\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThương hiệu Goodnight - Đưa giấc ngủ trở về nguyên bản\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eNệm Goodnight - Đơn giản để ngủ ngon! Bỏ qua sự bối rối khi phải lựa chọn giữa vô vàn chiếc nệm khác nhau, đơn giản là đỉnh cao của sự chắt lọc và tinh tế, điều mà các chuyên gia của Goodnight đã chuẩn bị một cách tỉ mỉ nhất cho những khách hàng trân quý của mình. Mỗi sản phẩm Goodnight là một lời chúc ngủ ngon, một lời hứa cho giấc ngủ trọn vẹn nguyên bản.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eHướng dẫn sử dụng và bảo quản\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e1. Luôn đặt sản phẩm trên bề mặt bằng phẳng ổn định, không lồi lõm hoặc bị cong để tránh gây biến dạng, hư hỏng.\u003c/p\u003e\n\u003cp\u003e2. Đặt sản phẩm ở nơi thoáng khí, tránh ánh nắng trực tiếp chiếu vào.\u003c/p\u003e\n\u003cp\u003e3. Nên dùng kèm ga/drap để giúp cho sản phẩm luôn sạch sẽ và thoáng mát.\u003c/p\u003e\n\u003cp\u003e4. Không đặt vật nặng lên sản phẩm trong thời gian dài, không dùng ngoại lực mạnh và tập trung tác động lên sản phẩm dưới mọi hình thức.\u003c/p\u003e\n\u003cp\u003e5. Tuyệt đối không được lôi kéo, đẩy, bẻ cong tấm sản phẩm, vì có thể làm rách áo sản phẩm, gây hư hỏng, xô lệch kết cấu của lõi sản phẩm.\u003c/p\u003e\n\u003cp\u003e6. Không được là (ủi) trên sản phẩm hoặc đặt vật nóng lên sản phẩm\u003c/p\u003e\n\u003cp\u003e7. Tránh đổ các loại hóa chất, dung môi, chất lỏng lên sản phẩm và để gần các thiết bị tỏa nhiệt.\u003c/p\u003e\n\u003cp\u003e8. Không được giặt và phơi sản phẩm dưới ánh nắng trực tiếp\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/b8/cc/18/2c891c7ff551034f9483a5b9d1bfc161.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b8/cc