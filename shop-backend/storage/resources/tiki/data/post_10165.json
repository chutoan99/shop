.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":116750,"discount_rate":25,"rating_average":5,"review_count":54,"review_text":"(54)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/41/52/4f/16b63f503043879ffff8e35af935f355.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1280,"all_time_quantity_sold":261,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<div> </div>\n<div><span style=\"color: #ff0000;\"><strong>TẠI SAO NÊN CHỌN Cà Phê Thải Độc Happy Life VN để làm enema?</strong></span></div>\n<ul>\n<li>Sản phẩm được sản xuất từ nguồn nguyên liệu 100% cà phê sạch Robusta Buôn Ma Thuột. Được trồng ở độ cao 536m.</li>\n<li>Sản xuất theo mô hình khép kín từ nông trang cho đến thành phẩm.</li>\n<li>Lựa chọn những hạt cà phê chín bằng phương pháp thủ công (loại bỏ rác, cà phê lép, sâu mọt, rác..).</li>\n<li>Rửa sạch. Phơi khô dưới nắng tự nhiên.</li>\n<li>Dùng máy lựa cà phê qua sàn 2 lần (đảm bảo chọn hạt cà phê chín 90-99%).</li>\n<li>Độ rang đã thay đổi từ rang cháy sang rang vừa chín để phù hợp với liệu trình enema nhất.</li>\n<li>Loại cà phê Robusta là phù hợp nhất để làm enema/ thải độc đại tràng bằng cà phê qua đường hậu môn.</li>\n</ul>\n<p><img style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/0e/eb/2f/608b61cce17ba39d15df059bf4518317.jpg\" alt=\"\" width=\"750\" height=\"535\" /></p>\n<div style=\"text-align: justify;\">Thải độc cà phê là phương pháp được tiến sĩ Max Gerson nghiên cứu, phát minh và được đặt theo tên của ông. Phương pháp này có lịch sử lên đến hơn 70 năm và theo vị khoa học này thì cafein có trong cà phê sẽ có tác dụng tích cực đối với bàng quang, gan, túi mật… Cơ chế của caffeine được mô tả là đi lên hậu môn, tiếp đó đến tĩnh mạch cửa và cuối cùng là gan. Chính vì thế, thải độc cà phê có thể giúp phân giải độc tố trong máu, giải độc gan, cải thiện sức khỏe của những bệnh nhân bị bệnh ung thư, lao…</div>\n<div style=\"text-align: justify;\">Khác với việc uống cà phê sẽ làm ảnh hưởng tiêu cực đến các vi khuẩn có lợi trong ruột, phương pháp thải độc qua đại tràng bằng cà phê sẽ đem đến nhiều lợi ích bất ngờ:</div>\n<ul style=\"text-align: justify;\">\n<li>Đối với những người lớn tuổi, chức năng hệ tiêu hóa kém, những người thường xuyên gặp phải tình trạng táo bón thì nên sử dụng phương pháp này. Thải độc cà phê có tác dụng thúc đẩy hoạt động cơ quan tiêu hóa, đào thải các chất cặn bã tích tụ lâu ngày trong đại tràng ra khỏi cơ thể. Bên cạnh đó cà phê còn có tác dụng loại bỏ các chất bẩn trong đại tràng giúp cải thiện hệ tiêu hóa. Nhờ có quá trình thải độc mà cơ quan tiêu hóa được làm sạch, giúp người bệnh đại tiện dễ dàng.</li>\n<li>Thải độc đại tràng bằng cà phê đem đến hiệu quả tích cực đối với những người có chức năng gan suy giảm. Thải độc cà phê thúc đẩy đào thải các chất độc tích tụ trong gan ra khỏi cơ thể từ đó tăng cường chức năng gan, mật.</li>\n<li>Thải độc cà phê có tác dụng trong việc giảm cân. Làm thải độc cà phê một thời gian cơ thể sẽ giảm từ 5 đến 7kg, người giảm ít nhất cũng 1 đến 2 kg đặc biệt hơn vòng bụng của bạn sẽ giảm từ 5 đến 8cm.</li>\n<li>Làm thải độc cà phê da trắng sáng, mịn màng hơn: Những ai làm thải độc cà phê sau 3 tuần đều cảm nhận làn da trắng sáng và mịn màng hơn, người có tàn nhang, mụn cũng dần dần mất đi.</li>\n</ul>\n<p style=\"text-align: center;\"><img src=\"https://salt.tikicdn.com/ts/tmp/04/9f/21/9019e117c95b6b09c1b2b36763d7eef4.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p style=\"text-align: left;\"><strong>Đối tượng nên sử dựng phương pháp thải độc đại tràng bằng cà phê:</strong></p>\n<ul>\n<li style=\"text-align: justify;\">Người bị táo bón, hệ tiêu hóa kém</li>\n<li style=\"text-align: justify;\">Đau dạ dày đại tràng, ung thư</li>\n<li style=\"text-align: justify;\">Người luôn cảm thấy mệt mỏi, ăn không ngon, ngủ không sâu.</li>\n<li style=\"text-align: justify;\">Người muốn giảm cân, giảm mỡ vùng bụng, giảm eo.</li>\n<li style=\"text-align: justify;\">Người muốn cải thiện làn da. Sau 3 tuần sử dụng cảm nhận da trắng sáng và mịn màng hơn.</li>\n<li style=\"text-align: justify;\">Người bình thường muốn thải độc tố trong cơ thể</li>\n<li style=\"text-align: justify;\">Đối tượng không nên sử dụng: Trẻ em dưới 12 tuổi, phụ nữ mang thai và cho con bú ( Con dưới 6 tháng tuổi ), người đang có bệnh hỏi ý kiến bác sĩ trước khi làm.</li>\n</ul>\n<p><img style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/64/5e/a0/80fa1ad96812aba2d3f010d1fd337057.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\"><strong>TẶNG NGAY MÓC DÁN TƯỜNG SIÊU DÍNH KHI MUA BỘ THẢI ĐỘC ĐẠI TRÀNG - LIỆU TRÌNH 10 NGÀY</strong></span></p>\n<p><img style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/5a/f9/3e/eb28194ecb693267215fc93829670069.jpg\" alt=\"\" width=\"750\" height=\"450\" /></p>\n<p style=\"text-align: center;\"><img src=\"https://salt.tikicdn.com/ts/tmp/bf/18/f0/9e9bdcb7472341bf5d0874af5407b506.jpg\" alt=\"\" width=\"750\" height=\"530\" /></p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://sal