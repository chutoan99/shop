83596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":610000,"discount_rate":13,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/51/47/82/aa1469a9d78b586b28f62d68eb4d8b93.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2351,"all_time_quantity_sold":4,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch5\u003eThiết kế sang trọng, hiện đại\u003c/h5\u003e\n\u003cp\u003e\u003cstrong\u003eMáy Nước Nóng Lạnh Toshiba RWF-W1669BV(W1)\u003c/strong\u003e có thiết kế bắt mắt, gọn gàng, gam màu trắng sang trọng phù hợp mọi không gian nội thất như văn phòng, nhà bếp. Được làm bằng chất liệu nhựa bền chắc, không chứa chất độc hại mang lại nguồn nước sạch an toàn cho sức khỏe người sử dụng.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://vcdn.tikicdn.com/ts/product/6b/04/1e/cab6e56e219759674149b14b06273b14.jpg\" alt=\"\" width=\"750\" height=\"577\" /\u003e\u003c/p\u003e\n\u003ch5\u003eCông suất làm nóng, lạnh mạnh mẽ\u003c/h5\u003e\n\u003cp\u003eCây nước nóng lạnh có nhiệt độ làm nóng nước từ 85 - 90 độ C, làm lạnh nước từ 6 - 8 độ C. Lượng nước làm nóng đạt 4 lít/h, lượng nước làm lạnh đạt 2 lít/h, công suất làm nóng 550 W, làm lạnh 120 W cho lượng nước nóng, lạnh dồi dào đáp ứng nhu cầu uống nước mát giải nhiệt, pha trà, chế mì, pha sữ của mọi người dùng.\u003c/p\u003e\n\u003cp\u003eSản phẩm làm lạnh nước bằng máy nén cho độ lạnh sâu, sử dụng tiết kiệm điện. Bình chứa nước nóng, lạnh làm bằng chất liệu inox 304 chống rỉ sét, độ bền cao, an toàn cho sức khỏe người dùng.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://vcdn.tikicdn.com/ts/product/fb/b6/ed/9c9f02c6ab35a93c7714679b4c23888b.jpg\" alt=\"\" width=\"750\" height=\"541\" /\u003e\u003c/p\u003e\n\u003ch5\u003eTích hợp vòi nóng lạnh tiện lợi \u003c/h5\u003e\n\u003cp\u003eThiết bị được trang bị 2 nguồn nước nóng và lạnh với hệ thống làm lạnh bằng máy nén cho độ làm lạnh sâu hơn. Cùng với dung tích lớn, cung cấp lượng nước yêu cầu người sử dụng trong tích tắc. Sản phẩm sử dụng gas lạnh R134A thân thiện với môi trường và tiết kiệm điện năng hiệu quả.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://vcdn.tikicdn.com/ts/product/1e/53/f6/8671b6202486e04e0d8fd598611f61b5.jpg\" alt=\"\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003ch5\u003eVòi nước khóa an toàn\u003c/h5\u003e\n\u003cp\u003eMáy nước nóng lạnh Toshiba có nhiệt độ làm nóng trên 85 độ, nhiệt độ làm lạnh dưới 10 độ giúp đáp ứng nhu cầu của người dùng. Đặc biệt, sản phẩm còn trang bị khóa nước nóng, khi khóa được kích hoạt, trẻ nhỏ có táy máy bấm vào vòi, nước nóng cũng không chảy ra ngoài gây nguy hiểm cho trẻ, giúp đảm bảo an toàn cho gia đình bạn hiệu quả.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://vcdn.tikicdn.com/ts/product/94/f8/76/d07e16250bb4e2b0445080cd6b6723c9.jpg\" alt=\"\" width=\"750\" height=\"492\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://vcdn.tikicdn.com/ts/product/a2/86/b1/4cec5ba79a6b0726f0bd5df205e31f06.jpg\" alt=\"\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003ch5\u003eTiện lợi khi sử dụng\u003c/h5\u003e\n\u003cp\u003eThân dưới cây nước nóng lạnh có thiết kế khoang chứa ly tách giúp bạn bảo quản ly tách gọn sạch, giữ vệ sinh tốt. Đèn báo chế độ nước nóng, nước lạnh và đèn báo nguồn giúp bạn theo dõi quá trình làm nóng, làm lạnh nước dễ dàng. Khay hứng nước thừa ngăn nước rơi, đổ xung quanh cây nước, khay có thể tháo rời, làm sạch thuận tiện.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"h