"}},"discount":0,"discount_rate":0,"rating_average":4.8,"review_count":17,"review_text":"(17)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/c3/d1/f7/79f626289fbaa7d5aad3a7e5eb33af4b.png","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2022,"all_time_quantity_sold":50,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"color:#444444;font-family:Arial, Helvetica, sans-serif;text-align:justify;\"\u003eLời Nói Đầu  Cuốn Ngữ âm và cách diễn đạt tiếng Anh Quốc tế cấp độ Nâng cấp là cấp độ kế tiếp của cuốn Sách Ngữ âm tiếng Anh Quốc tế cấp độ Trung cấp của tác giả Lê Thị Hiệp và Giáo sư ngài Stuart Kewley. \u003c/p\u003e\n\u003cp style=\"color:#444444;font-family:Arial, Helvetica, sans-serif;text-align:justify;\"\u003eĐể tiếp cận với môi trường nói tiếng Anh nói nhanh, chuẩn, tự tin, tự biết đánh dấu trọng âm của các loại từ, các loại câu khác nhau, tự phát âm lên giống như người bản xứ. Tác giả Lê Thị Hiệp đồng tác giả Giáo sư, Tiến sĩ, Diễn giả Ngài Stuart Kewley đến từ Đại học Oxford tại Vương Quốc Anh kết hợp biên soạn giáo trình này nhằm hỗ trợ thúc đẩy các học viên tiếp cận với môi trường giáo dục, học tập, thương mại, kinh tế Quốc tế có sử dụng tiếng Anh một cách tự tin nhất. \u003c/p\u003e\n\u003cp style=\"color:#444444;font-family:Arial, Helvetica, sans-serif;text-align:justify;\"\u003eTrong ấn phẩm này gồm có 3 chương, 12 bài và 3 bài ôn tập cùng các mẫu thuyết trình thực tế từ diễn giả cao cấp Giáo sư Stuart Kewley và diễn giả Lê Thị Hiệp, cùng cách diễn đạt tiếng Anh, để đánh giá lại kiến thức cũ đã học trước đó. Cuốn sách có giới thiệu và hướng dẫn cách chuẩn bị cho một bài thuyết trình bằng tiếng Anh trước công chúng cả về thể, tâm, trí, khí chất. \u003c/p\u003e\n\u003cp style=\"color:#444444;font-family:Arial, Helvetica, sans-serif;text-align:justify;\"\u003eMục đích giúp các bạn nhận thức được giá trị của văn hoá, ngôn ngữ, thể chất, khí chất, tính cách của bản thân hoặc con, học viên của mình để uốn nắn họ trở nên chuyên nghiệp hơn. Từ đó đưa ra những giải pháp tối ưu cho mục đích giao tiếp, nâng tầm bản thân xứng với vị trí, hợp  với thời đại mới và hội nhập Quốc tế.  \u003c/p\u003e\n\u003cp style=\"color:#444444;font-family:Arial, Helvetica, sans-serif;text-align:justify;\"\u003eChúc các bạn thành công! \u003c/p\u003e\n\u003cp style=\"color:#444444;font-family:Arial, Helvetica, sans-serif;text-align:justify;\"\u003eChủ tịch AIED  Lê Thị Hiệp\u003c/p\u003e\n\u003cp style=\"color:#444444;font-family:Arial, Helvetica, sans-serif;text-align:justify;\"\u003e-------------------------------------------------\u003c/p\u003e\n\u003cp style=\"color:#444444;font-family:Arial, Helvetica, sans-serif;text-align:justify;\"\u003eP/s: Không áp dụng chính sách đổi trả cho sản phẩm giảm giá từ 30% trở lên.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/c3/d1/f7/79f626289fbaa7d5aad3a7e5eb33af4b.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c3/d1/f7/79f626289fbaa7d5aad3a7e5eb33af4b.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c3/d1/f7/79f626289fbaa7d5aad3a7e5eb33af4b.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c3/d1/f7/79f626289fbaa7d5aad3a7e5eb33af4b.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c3/d1/f7/79f626289fbaa7d5aad3a7e5eb33af4b.p