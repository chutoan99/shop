/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/75/03/fe/859087d66c2f949c15d32dae43fddecf.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2685,"all_time_quantity_sold":10,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch5\u003e\u003cstrong\u003eThiết kế hiện đại và trang nhã\u003cbr /\u003e\u003c/strong\u003e\u003c/h5\u003e\n\u003cp\u003e\u003cstrong\u003eNồi Cơm Điện Tử Toshiba RC-18NMFVN(WT) \u003c/strong\u003evới thiết kế nắp liền, kiểu dáng hiện đại cùng tông màu tươi tắn sẽ khiến cho không gian nhà bếp của bạn thêm phần sang trọng và tiện nghi.\u003c/p\u003e\n\u003ch5\u003e\u003cstrong\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Nồi Cơm Điện Tử Toshiba RC-18NMFVN(WT) (1.8 lít) - Trắng\" src=\"http://tikicdn.com/media/catalog/product/t/o/toshiba1.u3059.d20170614.t164121.487339.jpg\" alt=\"Nồi Cơm Điện Tử Toshiba RC-18NMFVN(WT) (1.8 lít) - Trắng\" width=\"1000\" height=\"667\" /\u003e\u003c/strong\u003e\u003c/h5\u003e\n\u003cdiv\u003e\u003cspan style=\"text-align: center;\"\u003eNồi được thiết kế quai xách chắc chắn giúp bạn dễ dàng khuân chuyển mà không lo bị bỏng. Bên cạnh đó, với dung tích lên đến 1.8 lít, nồi thích hợp cho những gia đình từ 4 - 6 thành viên.\u003c/span\u003e\u003c/div\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg title=\"Nồi Cơm Điện Tử Toshiba RC-18NMFVN(WT) (1.8 lít) - Trắng\" src=\"http://tikicdn.com/media/catalog/product/t/o/toshiba2.u3059.d20170614.t164121.534838.jpg\" alt=\"Nồi Cơm Điện Tử Toshiba RC-18NMFVN(WT) (1.8 lít) - Trắng\" width=\"1000\" height=\"667\" /\u003e\u003c/p\u003e\n\u003ch5\u003e\u003cstrong\u003eLòng nồi bằng hợp kim nhôm tráng lớp chống dính bền bỉ\u003c/strong\u003e\u003c/h5\u003e\n\u003cp\u003eNồi cơm điện tử Toshiba RC-18NMFVN(WT) có lòng nồi sử dụng chất liệu hợp kim cao cấp, tráng lớp Diamond Titanium, giúp cho cơm không bị bám dính hay cháy khét, từ đó công việc chùi rửa sau khi sử dụng cũng thuận tiện và ít tốn sức lực hơn.\u003c/p\u003e\n\u003cp\u003eChất liệu này còn gia tăng độ bền cho nồi, ngăn chặn trầy xước, rạn nứt khi bị va đập hay bị oxi hóa, mài mòn, từ đó đảm bảo cơm nấu được chín đều, thơm ngon và an toàn cho sức khỏe.\u003c/p\u003e\n\u003cp\u003eMặt trước của lòng nồi có thang đo chia vạch giúp bạn tùy chỉnh mực nước cho phù hợp để cơm chín ngon, không bị khô, nhão.\u003cbr /\u003e\u003cbr /\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://vcdn.tikicdn.com/ts/tmp/55/23/c2/50c6402d97c0356c8a2c381aee6ce0c5.jpg\" alt=\"\" width=\"1000\" height=\"667\" /\u003e\u003c/p\u003e\n\u003ch5\u003e\u003cstrong\u003eCông suất lớn 800W với 3 mâm nhiệt thông minh\u003c/strong\u003e\u003c/h5\u003e\n\u003cp style=\"text-align: left;\"\u003eNồi có công suất lớn 800W cùng thiết kế 3 mâm nhiệt ở đáy, xung quanh thân và trên nắp tạo sự tuần hoàn nhiệt bao phủ khắp nồi, giúp cơm chín đều từ trong ra ngoài, tơi xốp, dẻo mềm, không bị khô hay nhão.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://vcdn.tikicdn.com/ts/tmp/f6/d0/fe/375e58ce159df392565bfe7b069a4381.jpg\" alt=\"\" width=\"1000\" height=\"667\" /\u003e\u003c/p\u003e\n\u003ch5\u003e\u003cstrong\u003eBảng điều khiển điện tử hiện đại dễ thao tác\u003c/strong\u003e\u003c/h5\u003e\n\u003cp\u003eMặt trước của nồi cơm điện tử Toshiba RC-18NMFVN(WT) trang bị bảng điều khiển điện tử với chỉ số hiển thị to rõ, nút bấm êm và chú thích chức năng rõ ràng, dễ hiểu giúp người dùng thao tác được dễ dàng.\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"text-align: center;\"\u003eNồi còn có tính năng hẹn giờ: Giữ ấm đến 30 giờ, hẹn giờ nấu đến 24 giờ giúp người dùng linh hoạt lựa chọn thời gian nấu, đảm bảo cơm luôn ấm và thơm ngon.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg title=\"Nồi Cơm Điện Tử Toshiba RC-18NMFVN(WT) (1.8 lít) - Trắng\" src=\"http://tikicdn.com/media/catalog/product/t/o/toshiba5.u3059.d20170615.t090657.584970.jpg\" alt=\"Nồi Cơm Điện Tử Toshiba RC-18NMFVN(WT) (1.8 lít) - Trắng\" width=\"1000\" height=\"667\" /\u003e\u003c/p\u003e\n\u003ch5 style=\"text-align: left;\"\u003e\u003cstrong\u003eNhiều chế độ nấu ăn đa dạng\u003c/strong\u003e\u003c/h5\u003e\n\u003cp\u003eNgoài nấu cơm thông thường, bạn còn có thể sử dụng nồi cơm điện tử Toshiba RC-18NMFVN(WT) để hấp bánh bao, luộc trứng, nấu cháo, nấp súp, nấu canh, nhằm đa dạng món ăn và bổ sung đầy đủ chất dinh dưỡng cho các bửa cơm hằng ngày của gia đình.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Nồi Cơm Điện Tử Toshiba RC-18NMFVN(WT) (1.8 lít) - Trắng\" src=\"http://tikicdn.com/media/catalog/product/t/o/toshiba6.u3059.d20170614.t171637.629703.jpg\" alt=\"Nồi Cơm Điện Tử Toshiba RC-18NMFVN(WT) (1.8 lít) - Trắng\" width=\"1000\" height=\"667\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/75/03/fe/859087d66c2f949c15d32dae43fddecf.jpg","is_gallery":true,"label":null,"large_url":"http