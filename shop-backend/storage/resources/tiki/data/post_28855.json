idth":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/c1/3f/6c/878452d15e21eb748cb67bfa59347f74.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":797,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eSVR Sebiaclear Mat+Pores được nghiên cứu và điều chế bởi các chuyên gia da liễu để góp thêm một sản phẩm vào danh sách chăm sóc da hiệu quả dành cho phái đẹp. Với các thành phần chiết xuất từ các thành phần dược, Sebiaclear Mat + Pores sẽ giúp cải thiện kết cấu da để xóa đi các vấn đề về mụn, đồng thời làm giảm vết thâm, làm dịu da và ngăn chặn sự hình thành của mụn.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e Thành phần và công dụng:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Sebiaclear Mat + Pores là dung dịch kết hợp giữa ngăn mụn và dưỡng da để mang đến cho bạn làn da sáng khỏe đầy tự tin.\u003c/p\u003e\n\u003cp\u003e- Kem có chứa thành phần Gluconolactone (14%) và Acid salicylic giúp cải thiện kết cấu da, giảm vết thâm và ngăn chặn sự hình thành của mụn.\u003c/p\u003e\n\u003cp\u003e- Thành phần Niacinamide chiếm 4% sẽ giới hạn sự phát triển của vi khuẩn, giảm mụn và làm dịu vùng da bị ửng đỏ.\u003c/p\u003e\n\u003cp\u003e- Mat SR (2%) giúp điều hoà và bình thường hóa sự điều tiết chất nhờn.\u003c/p\u003e\n\u003cp\u003e- Kem đem lại hiệu quả tẩy da chết dịu nhẹ không chứa AHA với độ dung nạp tối ưu giúp cải thiện chất da và điều tiết lượng bã nhờn dư thừa.\u003c/p\u003e\n\u003cp\u003e- Kem có kết cấu mỏng mịn, thẩm thấu nhanh, không gây bết dính mang đến cho bạn cảm giác khô thoáng khi sử dụng, dưỡng ẩm dài lâu lên đến 72h.\u003c/p\u003e\n\u003cp\u003e- Sản phẩm đảm bảo không chứa dầu, không chứa paraben và không gây dị ứng, không gây mụn trở lại nên bạn có thể yên tâm sử dụng.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eĐối tượng sử dụng:\u003c/strong\u003e Kem Dưỡng Giúp Giảm Mụn Kiềm Dầu Cho Da SVR Sebiaclear Mat+Pores dành cho da thường đến da hỗn hợp, kể cả da nhạy cảm.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eHướng dẫn sử dụng:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Sử dụng sau bước làm sạch da.\u003c/p\u003e\n\u003cp\u003e- Thoa lên mặt và cổ, sáng và/hoặc tối.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/c1/3f/6c/878452d15e21eb748cb67bfa59347f74.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c1/3f/6c/878452d15e21eb748cb67bfa59347f74.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c1/3f/6c/878452d15e21eb748cb67bfa59347f74.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c1/3f/6c/878452d15e21eb748cb67bfa59347f74.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c1/3f/6c/878452d15e21eb748cb67bfa59347f74.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/6c/28/39/d48665edc60d5e502a35f1a9d134588f.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/6c/28/39/d48665edc60d5e502a35f1a9d134588f.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/