/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/media/catalog/product/m/a/may-xay-a-nang-panasonic-mj-dj31sra-en-5449-2377911-1-zoom.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2709,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003eThiết kế Inox sang trọng, chắc chắn\u003c/h3\u003e\r\n\u003cp\u003eMáy xay ép đa năng Panasonic PAXD-MJ-DJ31SRA có vỏ ngoài được làm từ chất liệu Inox chắc chắn với tông đen sáng bóng, hạn     chế bám bụi bẩn một cách tối ưu. Các bộ phận được khớp với nhau một cách chắc chắn và mang tính thẩm mỹ cao, giúp máy hoạt     động tốt, êm ái và chống rò rỉ ra ngoài.\u003c/p\u003e\r\n\u003cp style=\"text-align: center;\"\u003e\u003cimg title=\"Máy Xay Ép Đa Năng Panasonic PAXD-MJ-DJ31SRA – 1.5 Lít\" src=\"http://tikicdn.com/media/catalog/product/m/a/may-ep-trai-cay-panasonic-mj-dj31sra-org-1.jpg\" alt=\"Máy Xay Ép Đa Năng Panasonic PAXD-MJ-DJ31SRA – 1.5 Lít\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\r\n\u003ch3\u003e2 cối riêng biệt đi kèm\u003c/h3\u003e\r\n\u003cp\u003e\u003cstrong\u003e \u003c/strong\u003e Bộ sản phẩm kèm theo một cối nghiền khô và một cối xay sinh tố đều làm bằng thủy tinh kháng vỡ vừa sang trọng vừa tiện dụng.     Cối xay sinh tố có sẵn nắp trong tháo được giúp bạn dễ dàng cho trái cây vào mà không cần tháo nắp khi máy đang vận hành.\u003c/p\u003e\r\n\u003cp style=\"text-align: center;\"\u003e\u003cimg title=\"Máy Xay Ép Đa Năng Panasonic PAXD-MJ-DJ31SRA – 1.Lít\" src=\"http://tikicdn.com/media/catalog/product/m/a/may-ep-trai-cay-panasonic-mj-dj31sra-org-3.jpg\" alt=\"Máy Xay Ép Đa Năng Panasonic PAXD-MJ-DJ31SRA – 1.Lít\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\r\n\u003ch3\u003eĐường kính dẫn thực phẩm lớn\u003c/h3\u003e\r\n\u003cp\u003eSản phẩm với thiết kế phần ống dẫn có đường kính rộng, tiện lợi để ép nguyên quả (táo) và các loại rau củ quả khác một cách     nhanh chóng, bỏ qua công đoạn cắt nhỏ. Ngoài ra, bình chứa bã lên đến 2 lít, thoải mái cho bạn ép một lúc nhiều lượng trái cây mà không cần dừng lại để đổ bã hay đổi cốc đựng.\u003c/p\u003e\r\n\u003cp style=\"text-align: center;\"\u003e\u003cimg title=\"Máy Xay Ép Đa Năng Panasonic PAXD-MJ-DJ31SRA – 1.Lít\" src=\"http://tikicdn.com/media/catalog/product/m/a/may-ep-trai-cay-panasonic-mj-dj31sra-org-10.jpg\" alt=\"Máy Xay Ép Đa Năng Panasonic PAXD-MJ-DJ31SRA – 1.Lít\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\r\n\u003ch3\u003eVòi rót xoay 120 độ\u003c/h3\u003e\r\n\u003cp\u003eVòi rót xoay 120 độ được thiết kế hiện đại có thể xoay 120 độ rất thuận tiện cho người sử dụng khi muốn rót nước ép ra nhiều     ly hoặc mỗi thành viên đều có thể tự rót nước ép cho mình chỉ với thao tác đơn giản là xoay vòi rót về phía mình mà không     nhất thiết phải xoay thân máy. Khi nâng vòi nước lên, nước trái cây sẽ ngừng chảy, chống nhỏ giọt.\u003c/p\u003e\r\n\u003cp style=\"text-align: center;\"\u003e\u003cimg title=\"Máy Xay Ép Đa Năng Panasonic PAXD-MJ-DJ31SRA – 1.5 Lít\" src=\"http://tikicdn.com/media/catalog/product/m/a/may-ep-trai-cay-panasonic-mj-dj31sra-org-9.jpg\" alt=\"Máy Xay Ép Đa Năng Panasonic PAXD-MJ-DJ31SRA – 1.5 Lít\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\r\n\u003ch3\u003eBộ lọc và lưỡi dao hình chữ \"s\"\u003c/h3\u003e\r\n\u003cp\u003eVỏ ngoài bọc inox cao cấp cùng thiết kế bên trong bộ lọc bã và dao đều được làm từ chất liệu thép không gỉ cao cấp, an toàn     cho sức khỏe và có độ bền cao. Đặc biệt, máy xay ép đa năng Panasonic PAXD-MJ-DJ31SRA còn cho ra những ly nước ép hiệu quả     hơn nhờ lưỡi dao hình chữ \"S\" giữ trái cây không bị xoay, lực ly tâm ép nước và đẩy bã ra ngoài, lưỡi dao dưới sắc bén ép     trọn vẹn nước trái cây.     \u003cbr /\u003e \u003cbr /\u003e\u003c/p\u003e\r\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Máy Xay Ép Đa Năng Panasonic PAXD-MJ-DJ31SRA – 1.5 Lít\" src=\"http://tikicdn.com/media/catalog/product/m/a/may-ep-trai-cay-panasonic-mj-dj31sra-org-6.jpg\" alt=\"Máy Xay Ép Đa Năng Panasonic PAXD-MJ-DJ31SRA – 1.5 Lít\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\r\n\u003ch3\u003e2 tốc độ dễ dàng điều chỉnh\u003c/h3\u003e\r\n\u003cp\u003eSản phẩm được trang bị 2 mức tốc độ để bạn lựa chọn phù hợp với thực phẩm chế biến. Sau khi lắp đặt các bộ phận vào đúng     vị trí, chỉ cần cho trái cây vào phễu và từ từ nhấn ống ép. Phần nước sẽ chảy vào ly chứa nước để bạn có thể trực tiếp thưởng     thức nước trái cây hoàn toàn nguyên chất.\u003c/p\u003e\r\n\u003cp style=\"text-align: center;\"\u003e\u003cimg title=\"Máy Xay Ép Đa Năng Panasonic PAXD-MJ-DJ31SRA – 1.Lít\" src=\"http://tikicdn.com/media/catalog/product/m/a/may-ep-trai-cay-panasonic-mj-dj31sra-org-13.jpg\" alt=\"Máy Xay Ép Đa Năng Panasonic PAXD-MJ-DJ31SRA – 1.Lít\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\r\n\u003cp\u003e\u003cstrong\u003e Cơ chế an toàn cho người sử dụng \u003c/strong\u003e\u003c/p\u003e\r\n\u003cp\u003eMáy ép trái cây Panasonic PAXD-MJ-DJ31SRA đảm bảo an toàn tuyệt đối cho người dùng, máy tự ngắt điện khi có sự cố, tránh     gây tai nạn và kéo dài độ bền sản phẩm. Máy chỉ hoạt động khi các thành phần được lắp đúng vị trí, tránh hiện tượng nước     ép trào ra do lắp không đúng khớp.\u003c/p\u003e\r\n\u003cp style=\"text-align: center;\"\u003e\u003cimg title=\"Máy Xay Ép Đa Năng Panasonic PAXD-MJ-DJ31SRA – 1.5 Lít\" src=\"http://tikicdn.com/media/catalog/product/m/a/may-ep-trai-cay-panasonic-mj-dj31sra-org-17.jpg\" alt=\"Máy Xay Ép Đa Năng Panasonic PAXD-MJ-DJ31SRA – 1.5 Lít\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\r\n\u003cp\u003eMáy có thanh khóa thân máy bên hông, đảm bảo giữ chắc các bộ phận ở đúng vị trí, không bung khớp, rỉ nước khi máy hoạt động.\u003c/p\u003e\r\n\u003cp style=\"text-align: center;\"\u003e\u003cimg title=\"Máy Xay Ép Đa Năng Panasonic PAXD-MJ-DJ31SRA – 1.Lít\" src=\"http://tikicdn.com/media/catalog/product/m/a/may-ep-trai-cay-panasonic-mj-dj31sra-org-11.jpg\" alt=\"Máy Xay Ép Đa Năng Panasonic PAXD-MJ-DJ31SRA – 1.Lít\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/media/catalog/product/m/a/may-xay-a-nang-panasonic-mj-dj31sra-en-5449-2377911-1-zoom.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/m/a/may-xay-a-nang-panasonic-mj-dj31sra-en-5449-2377911-1-zoom.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/m/a/may-xay-a-nang-panasonic-mj-dj31sra-en-5449-2377911-1-zoom.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/m/a/may-xay-a-nang-panasonic-mj-dj31sra-en-5449-2377911-1-zoom.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/m/a/may-xay-a-nang-panasonic-mj-dj31sra-en-5449-2377911-1-zoom.jpg"},{"base_url":"https://salt.tikicdn.com/media/catalog/product/m/a/may-ep-trai-cay-panasonic-mj-dj31sra-org-22.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w120