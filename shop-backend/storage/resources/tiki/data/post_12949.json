,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":49000,"discount_rate":16,"rating_average":5,"review_count":32,"review_text":"(32)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/f6/f6/a2/9e6db97eaad1f000e365fc7b18e4f602.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1500,"all_time_quantity_sold":60,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003e\u003cspan style=\"font-weight:400;\"\u003e\u003cstrong\u003eCOMBO ĐI SINH BOBBY - TRỌN BỘ SẢN PHẨM ĐÓN BÉ CHÀO ĐỜI!\u003c/strong\u003e\u003c/span\u003e\u003c/h3\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003e\u003cstrong\u003eCombo đi sinh dành cho bé trai\u003c/strong\u003e của thương hiệu Bobby là trọn bộ những sản phẩm thiết yếu dành cho mẹ và bé. Tất cả được đựng trong túi xách siêu tiện lợi, cực dễ thương Bobby thiết kế dành tặng riêng cho mẹ khi mua combo đi sinh - mẹ chỉ cần xách túi Bobby và đi vào bệnh viện! \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cem\u003eCombo bao gồm:\u003c/em\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003eSản phẩm cho bé:\u003c/strong\u003e Miếng lót newborn Bobby 28 miếng, Tã dán Bobby XS 42 miếng, Khăn giấy ướt Bobby gói 100 miếng\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eSản phẩm cho mẹ:\u003c/strong\u003e Băng vệ sinh Mama Diana, Tã dán Caryn siêu thấm\u003c/li\u003e\n\u003cli\u003e01 Túi xách tiện lợi Bobby\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003e\u003cstrong\u003eĐặc điểm nổi bật\u003c/strong\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eCombo đi sinh trang bị đầy đủ các vật phẩm thiết yếu, tất cả được đựng trong túi xách vô cùng \u003cem\u003e\u003cstrong\u003enhỏ gọn và tiện lợi.\u003c/strong\u003e\u003c/em\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003e\u003cstrong\u003eCông dụng\u003c/strong\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cspan style=\"font-weight:400;\"\u003e Giúp chuẩn bị một cách nhanh chóng và tiết kiệm cho lần đầu mẹ đón bé chào đời.\u003c/span\u003e\u003c/li\u003e\n\u003cli\u003e\u003cspan style=\"font-weight:400;\"\u003eLà món quà xinh xắn và hữu dụng để tặng các mẹ bầu.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg style=\"text-align:center;\" src=\"https://salt.tikicdn.com/ts/tmp/f6/f6/a2/9fd51f178542bb6af1ced1fd6399bbbd.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThông tin thương hiệu\u003c/strong\u003e\u003cbr /\u003eBobby là thương hiệu nổi tiếng của công ty Diana, thuộc tập đoàn Unicharm Nhật Bản, chuyên cung cấp những sản phẩm chất lượng cao cấp dành cho trẻ em. Ra mắt thị trường Việt Nam từ năm 2003, Bobby trở thành thương hiệu tã giấy được ưa chuộng và tin dùng bởi sự sáng tạo độc đáo và đầy yêu thương dành cho trẻ em, với thiết kế các loại tã giấy màng đáy thoáng khí dạng vải, đem đến sự khô thoáng và bảo vệ làn da của các bé. Tháng 12 năm 2005, Bobby lại đi tiên phong trên thị trường Việt Nam bằng việc cải tiến sản phẩm tã giấy chống hăm 3 tác động với lõi bông siêu thấm, màng đáy thoáng khí dạng vải và tinh chất trà xanh. Sử dụng dây chuyền sản xuất hiện đại kết hợp với thế mạnh là thành viên của tập đoàn hàng đầu thế giới Unicharm Nhật Bản, công ty Diana luôn đi đầu trong việc ứng dụng các công nghệ hiện đại trong lĩnh vực sản xuất các sản phẩm chăm sóc vệ sinh cá nhân để sáng tạo ra những sản phẩm chất lượng cao nhất, phù hợp nhất và Bobby là một minh chứng cho điều đó.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/f6/f6/a2/9e6db97eaad1f000e365fc7b18e4f602.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f6/f6/a2/9e6db97eaad1f000e365fc7b18e4f602.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f6/f6/a2/9e6db97eaad1f000e365fc7b18e4f602.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f6/f6/a2/9e6db97eaad1f000e365fc7b18e4f602.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f6/f6/a2/9e6db97eaad1f000e365fc7b18e4f602.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/4b/c7/85/68ec1958e3b70f433e4af763724d56ae.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/4b/c7/85/68ec1958e3b70f433e4af763724d56ae.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/4b/c7/85/68ec1958e3b70f433e4af763724d56ae.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4b/c7/85/68ec1958e3b70f433e4af763724d56ae.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4b/c7/85/68ec1958e3b70f433e4af763724d56ae.png"},{"base_url":"https://salt.tikicdn.com/ts/product/88/b3/ce/ca697814a231377438cda5c8e58c0b1e.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/88/b3/ce/ca697814a231377438cda5c8e58c0b1e.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/88/b3/ce/ca697814a231377438cda5c8e58c0b1e.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/88/b3/ce/ca697814a231377438cda5c8e58c0b1e.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/88/b3/ce/ca697814a231377438cda5c8e58c0b1e.png"},{"base