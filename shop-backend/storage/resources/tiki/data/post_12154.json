.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":350000,"discount_rate":19,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ff/db/5d/93b7324ab02688d257cf3de6e099bd6f.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":279,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p>THÔNG TIN SẢN PHẨM:</p>\n<p>Thương hiệu: Tefal</p>\n<p>Model: VH689690</p>\n<div class=\"ctLeft\">\n<p>Loại quạt: Quạt đứng - 80W - 3 mức gió</p>\n<div class=\"ctLeft\">\n<p>Bảng điều khiển: <span class=\"comma\">Remote</span><span>Nút nhấn</span></p>\n<div class=\"ctLeft\">\n<p>Đường kính cánh quạt: 6 cánh - 40 cm</p>\n<div class=\"ctLeft\">\n<p>Tiện ích:</p>\n</div>\n<div class=\"ctRight\">\n<p class=\"circle\">+ Có remote</p>\n<p class=\"circle\">+ Hẹn giờ tắt</p>\n<p class=\"circle\">+ Điều chỉnh được chiều cao</p>\n<p class=\"circle\">+ Lồng quạt có khe hở nan quạt nhỏ</p>\n<div class=\"ctLeft\">\n<p>Kích thước, khối lượng: Ngang 42 cm - Cao 102 - 129 cm - Sâu 42 cm - Nặng 5.9 kg</p>\n<p> </p>\n<p>MÔ TẢ SẢN PHẨM:</p>\n<h3>Thiết kế của sản phẩm</h3>\n<p>- Thiết kế thanh lịch, hiện đại, chất liệu nhựa cao cấp, chiều cao có thể linh hoạt tuỳ chỉnh thân quạt đứng thành quạt lửng, phù hợp với nhiều không gian phòng khách, phòng ngủ,</p>\n<p>- Lồng  lốc xoáy, gió mạnh mà không bị ngộp, có khe hở nan quạt nhỏ lên đến 60 nan quạt, an toàn khi sử dụng.</p>\n<p>Xem thêm: .</p>\n<p></p>\n<h3>Loại motor và công suất hoạt động</h3>\n<p>- Mẫu  này của Tefal sử dụng động cơ bạc thau, giúp cho quạt hoạt động được êm ái và bền bỉ. Động cơ bảo hành 2 năm, tặng thêm 1 năm khi đăng ký bảo hành online. Bên cạnh đó sử dụng công nghệ Dual Cooling System - hệ thống làm mát kép của Tefal giúp motor hoạt động bền bỉ, giảm nhiệt motor bất chấp mở quạt trong thời gian dài.</p>\n<p>- Công suất hoạt động đến 80W tạo luồng gió mạnh, ổn định.</p>\n<p></p>\n<h3>Số cánh quạt - mức gió và chế độ gió</h3>\n<p>-  đường kính 40 cm giúp tạo làn gió mát trải rộng với góc quay rộng đến 80 độ, biên dạng tối ưu khí động học, tăng tốc nhanh, giảm tiếng ồn.</p>\n<p>- 3 mức gió từ thấp đến cao cho phép người dùng tùy chỉnh theo nhu cầu sử dụng.</p>\n<p>- Mẫu  này có 3 chế độ gió:</p>\n<p>+ Gió thường: sẽ thổi ra luồng gió với tốc độ đều đặn không luân phiên theo nhịp điệu lúc mạnh, lúc yếu.</p>\n<p>+ Gió Turbo: luồng gió đối lưu đa chiều, tốc độ gió 6 m/s, làm mát khắp phòng.</p>\n<p>+ Gió yên tĩnh: tạo ra luồng gió với tốc độ vừa phải, tiếng gió êm ái &lt; 50 dBA thích hợp sử dụng vào lúc ngủ.</p>\n<p></p>\n<h3>Bảng điều khiển</h3>\n<p>Điều khiển bằng nút nhấn trên thân quạt ngoài ra quạt có trang bị thêm remote đi kèm cho phép người dùng dễ dàng tuỳ chỉnh từ xa mà không cần lại gần quạt. </p>\n<p></p>\n<h3>Tiện ích</h3>\n<p>Hẹn giờ tắt đến 8 tiếng cho người dùng chủ động thời gian sử dụng quạt.</p>\n<p></p>\n</div>\n</div>\n</div>\n</div>\n</div><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ff/db/5d/93b7324ab02688d257cf3de6e099bd6f.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ff/db/5d/93b7324a