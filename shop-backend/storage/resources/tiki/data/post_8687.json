l,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":227200,"discount_rate":49,"rating_average":4.8,"review_count":4,"review_text":"(4)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/bd/55/51/f014af9dda3ea5a97c414d3dbe6433b9.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":403,"all_time_quantity_sold":20,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eVỢT CẦU LÔNG TRẺ EM CHÍNH HÃNG AGNITE - 2 CHIẾC - F2127/F2128\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eKhách hàng lựa chọn các sản phẩm của AGNITE OFFICIAL STORE sẽ được CAM KẾT:\u003c/p\u003e\n\u003cp\u003eSản phẩm CHÍNH HÃNG, nguồn gốc RÕ RÀNG và chất lượng ĐẠT TIÊU CHUẨN.\u003c/p\u003e\n\u003cp\u003eHỗ trợ ĐỔI TRẢ HÀNG cho những sản phẩm bị lỗi trong vòng 7 NGÀY kể từ ngày nhận hàng.\u003c/p\u003e\n\u003cp\u003eCác sản phẩm được nghiên cứu theo TIÊU CHUẨN QUỐC TẾ, trải qua quá trình thử nghiệm nghiêm ngặt tại nhà máy.\u003c/p\u003e\n\u003cp\u003eGiá cả HỢP LÝ, CẠNH TRANH, RẺ nhất thị trường.\u003c/p\u003e\n\u003cp\u003eLuôn luôn GIẢI ĐÁP VÀ HỖ TRỢ khách hàng trong thời gian NHANH NHẤT.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7qukw-ljpbepjtvnk2d9\" alt=\"vn-11134208-7qukw-ljpbepjtvnk2d9\" width=\"1200\" height=\"1200\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7qukw-ljpbepjtx24i84\" alt=\"vn-11134208-7qukw-ljpbepjtx24i84\" width=\"1200\" height=\"1200\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7qukw-ljpbepjtygoy4a\" alt=\"vn-11134208-7qukw-ljpbepjtygoy4a\" width=\"1200\" height=\"1200\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eTHÔNG TIN CƠ BẢN:\u003c/p\u003e\n\u003cp\u003eQuy cách: 2 Vợt cầu lông , tặng kèm 1 hộp cầu và 1 túi đựng vợt. Riêng mã F2127 và F2128 shop tặng thêm 2 quấn cán vợt.\u003c/p\u003e\n\u003cp\u003eThương hiệu: Agnite\u003c/p\u003e\n\u003cp\u003eMã số: F2126/F2127\u003c/p\u003e\n\u003cp\u003eTên: Vợt cầu lông trẻ em - 2 chiếc\u003c/p\u003e\n\u003cp\u003eKích thước: 540 * 200 * 30mm\u003c/p\u003e\n\u003cp\u003eKích thước tay cầm: G6\u003c/p\u003e\n\u003cp\u003eTrọng lượng: 100 ± 5g\u003c/p\u003e\n\u003cp\u003eTrọng lượng dây kéo: 16-18LB\u003c/p\u003e\n\u003cp\u003eChất liệu: Hợp kim sắt\u003c/p\u003e\n\u003cp\u003eXuất xứ: Trung Quốc\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7qukw-ljpbepjtzv9e1d\" alt=\"vn-11134208-7qukw-ljpbepjtzv9e1d\" width=\"1200\" height=\"1200\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7qukw-ljpcty0og7ia31\" alt=\"vn-11134208-7qukw-ljpcty0og7ia31\" width=\"1200\" height=\"1200\" /\u003e\u003c/p\u003e\n\u003cp\u003e7 ĐIỂM MẠNH CỦA VỢT CẦU LÔNG AGNITE\u003c/p\u003e\n\u003cp\u003e1. Thiết kế khung vuông phẳng, đàn hồi tốt\u003c/p\u003e\n\u003cp\u003e2. Lỗ dây đơn (Làm sâu phần rãnh vợt, bảo vệ và kéo dài tuổi thọ của vợt)\u003c/p\u003e\n\u003cp\u003e3. Tay cầm chắc chắn, thoải mái (Làm từ da tay cầm PVC chống trượt, giúp cầm nắm và kiểm soát tốt hơn)\u003c/p\u003e\n\u003cp\u003e4. Nắp hỗ trợ kiểm soát (Nắp hình nón rộng, tăng tính linh hoạt trong việc điều khiển vợt)\u003c/p\u003e\n\u003cp\u003e5. Thiết kế khớp chữ T (Tăng sự ổn định cho vợt và kiểm soát chính xác)\u003c/p\u003e\n\u003cp\u003e6. Thiết kế dây nylon (Độ căng dây: 16-22LB)\u003c/p\u003e\n\u003cp\u003e7. Hệ thống giảm chấn chống sốc (Giảm biên độ biến dạng, giảm tần số rung, giảm thiểu tác động lên tay\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eCÔNG NGHỆ DÒNG VỢT CẦU LÔNG CHÍNH HÃNG AGNITE\u003c/p\u003e\n\u003cp\u003e- Công nghệ Titan Aerodynamic: thân vợt được phủ Titan giúp vợt được trợ lực tốt hơn và mạnh hơn.\u003c/p\u003e\n\u003cp\u003e- Công nghệ Isodynamic: khung vợt được thiết kế theo công nghệ IsoDynamic giúp diện tích điểm ngọt của khung vợt rộng hơn từ đó đường cầu sẽ thoát hơn và nẩy mạnh hơn.\u003c/p\u003e\n\u003cp\u003e- Thân vợt và khung vợt sử dụng High Modulus Carbon\u003c/p\u003e\n\u003cp\u003e- Carbon cường độ cao là loại carbon ứng suất cao chuyên dụng được Agnite dệt tấm từ những cuộn sợi carbon nguyên chất để tạo ra dòng vợt carbon truyền tải động năng của người chơi mạnh mẽ\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------\u003c/p\u003e\n\u003cp\u003eAGNITE - LÀN GIÓ MỚI CHO DÒNG SẢN PHẨM THỂ THAO CHUYÊN DỤNG !\u003c/p\u003e\n\u003cp\u003eAgnite là một thương hiệu hoàn toàn mới được xây dựng bởi Tập đoàn Dynamic Group Co., Ltd. vào tháng 4 năm 2017 cùng với đội ngũ thiết kế hàng đầu của Đức và được điều hành bởi Ningbo Agnite Sports Limited.\u003c/p\u003e\n\u003cp\u003eVới hơn 70 chi nhánh trên toàn thế giới, 1.000 nhân viên bán hàng, và gần 10.000 điểm bán, chúng tôi mong muốn cung cấp dịch vụ thuận tiện nhất cho người tiêu dùng.\u003c/p\u003e\n\u003cp\u003eSứ mệnh của Agnite:\u003c/p\u003e\n\u003cp\u003eChúng tôi ủng hộ một cách tiến hóa \"di chuyển\". Agnite giúp mọi người thoát khỏi vùng thoải mái tầm thường, theo đuổi bản thân tốt hơn, và tận hưởng niềm vui thể thao. Đó là quá trình thúc đẩy con người trở nên tốt hơn thông qua tập luyện thể dục.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e#vợt_cầu_lông #vợt_cầu_lông_yonex #vợt_cầu_lông_cho_nữ #vợt_cầu_lông_lining #vợt_cầu_lông_chính_hãng #vợt_cầu_lông_victor #vợt_cầu_lông_trẻ_em #vợt_cầu_lông_adidas #vợt_cầu_lông_apacs #vợt_cầu_lông_alp #vợt_cầu_lông_astrox_77 #vợt_cầu_lông_apacs_nano_9900 #vợt_cầu_lông_astrox_100zz #vợt_cầu_lông_ashaway #vợt_cầu_lông_astrox_88d #vợt_cầu_lông_chuyên_nghiệp #vợt_cầu_lông_giá_rẻ #vợt_cầu_lông_giá_rẻ_chất_lượng #vợt_cầu_lông_guang_yu #vợt_cầu_lông_guangyu_4u\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/bd/55/51/f014af9dda3ea5a97c414d3dbe6433b9.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/bd/55/51/f014af9dda3ea5a97c414d3dbe6433b9.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/bd/55/51/f014af9dda3ea5a97c414d3dbe6433b9.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/bd/55/51/f014af9dda3ea5a97c414d3dbe6433b9.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/bd/55/51/f014af9dda3ea5a97c414d3dbe6433b9.png"},{"base_url":"https://salt.tikicdn.com/ts/product/2f/d4/e5/aafaf4c5606b6cf0be1b17108f0dc667.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/2f/d4/e5/aafaf4c5606b6cf0be1b17108f0dc667.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/2f/d4/e5/aafaf4c5606b6cf0be1b17108f0dc667.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2f/d4/e5/aafaf4c5606b6cf0be1b17108f0dc667.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2f/d4/e5/aafaf4