alse,"is_hero":false,"return_reason":"any_reason"}},"discount":9300,"discount_rate":10,"rating_average":4.8,"review_count":60,"review_text":"(60)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/15/a2/99/a577b29f6ba269e632702e49df47b557.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1248,"all_time_quantity_sold":421,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003eĐẶC ĐIỂM NỔI BẬT CỦA SẢN PHẨM\u003c/strong\u003e\u003c/p\u003e\n\u003cul style=\"text-align:justify;\"\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eRau Má Uống Liền ORAMA không đường\u003c/strong\u003e \u003cspan style=\"font-weight:400;\"\u003egiữ trọn vị ngon mát lành từ rau má tươi nguyên chất. Sản phẩm không chỉ giúp bạn tăng cường dinh dưỡng từ rau má tươi, mà còn tiện lợi cho việc pha chế, bạn sẽ có ngay một ly rau má mát lành ngay tức thì.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eRau Má Uống Liền ORAMA không đường \u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003ecó thành phần 100% rau má tươi được sản xuất theo quy trình SẤY LẠNH TIỆT TRÙNG và NGHIỀN BẰNG CỐI ĐÁ GRANITE (thay vì sấy nhiệt và xay bằng máy kim loại truyền thống) cho ra sản phẩm tinh bột thiên nhiên cao cấp, thượng hạng và giữ được dưỡng chất có trong rau tươi.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eGiữ lại được chất xơ không hòa tan mà nước rau má thông thường không giữ được.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eCam kết KHÔNG sử dụng thuốc BVTV, thuốc diệt cỏ và thuốc kích thích\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eNói KHÔNG với phẩm màu và mọi hóa chất độc hại\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/15/a2/99/16ad6c57ca16fd07030efe0217cb527a.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cem\u003e\u003cspan style=\"font-weight:400;\"\u003eRau Má Uống Liền ORAMA không đường g\u003c/span\u003e\u003c/em\u003e\u003cem\u003e\u003cspan style=\"font-weight:400;\"\u003eiúp mát gan, thanh lọc cơ thể\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003eCÔNG DỤNG CỦA SẢN PHẨM\u003c/strong\u003e\u003c/p\u003e\n\u003cul style=\"text-align:justify;\"\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eRau Má Uống Liền ORAMA không đường\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e có tính mát, rất lành tính phù hợp chăm sóc cho cả da thường và da nhạy cảm giúp giảm mụn, lành vết thương và ngăn ngừa lão hóa hiệu quả\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eGiúp tăng collagen và hydroxyproline là một trong những hoạt chất có trong tế bào giúp tái tạo tế bào, làm đẹp da. Hơn nữa với tính kháng khuẩn, thanh nhiệt mà chúng còn giúp trị mụn, ngăn ngừa lão hóa da, xóa mờ nếp nhăn, giúp da luôn chắc khỏe,\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eRau Má Uống Liền ORAMA không đường\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e có tính hàn (lạnh), tân (cay), khổ (đắng) có tác dụng dưỡng âm, thanh nhiệt, nhuận gan, lợi tiểu, thường được sử dụng để bồi bổ cơ thể, sát trùng, chữa thổ huyết, tả lỵ, khí hư, mụn nhọt, rôm sảy…Sử dụng thường xuyên vào mùa hè giúp giải nhiệt, thanh lọc cơ thể để cơ thể luôn khỏe khoắn và tràn đầy năng lực.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cem\u003e\u003cspan style=\"font-weight:400;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/e1/42/9b/2a3a07362d7f35bd1664c8b0e793e2f9.jpg\" alt=\"Rau Má Uống Liền ORAMA không đường giúp mát gan, thanh lọc cơ thể\" width=\"750\" height=\"750\" /\u003e\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cem\u003e\u003cspan style=\"font-weight:400;\"\u003eRau Má Uống Liền ORAMA không đường lành tính phù hợp cho cả da thường và da nhạy cảm\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003eTHÔNG TIN CHUNG\u003c/strong\u003e\u003c/p\u003e\n\u003cul style=\"text-align:justify;\"\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eNgày sản xuất:\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e xem trên bao bì. \u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eHạn sử dụng:\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e 12 tháng kể từ ngày sản xuất.  \u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eKhuyến cáo:\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e không sử dụng sản phẩm đã hết hạn sử dụng, bao bì bị bung, rách.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/15/a2/99/a577b29f6ba269e632702e49df47b557.jp