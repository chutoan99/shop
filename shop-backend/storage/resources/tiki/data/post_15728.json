s_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/7f/e3/89/1fcf026efe056fd560dadf5bad2dbbea.JPG","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1895,"all_time_quantity_sold":15,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp dir=\"ltr\" style=\"line-height: 1.2; margin-top: 10pt; margin-bottom: 0pt; text-align: justify;\"\u003e\u003cspan style=\"font-size: 11pt; font-family: Arial; color: #000000; background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"\u003e\u003cstrong\u003eHeposal là  giải pháp chuyên biệt cho người bị viêm gan, xơ gan, men gan cao, tế bào gan hư tổn.\u003c/strong\u003e Heposal với thành phần từ Ưng Bất Bạc được chuyển giao từ Bằng sáng chế Mỹ, kết hợp với Phosphocomplex - dạng bào chế công nghệ cao tăng cường hiệu quả gấp 100 lần Silymarine thông thường, giúp giảm nhanh triệu chứng bệnh gan, phục hồi tổn thương do viêm gan, xơ gan, phòng ngừa biến chứng nguy hiểm của bệnh gan.\u003c/span\u003e\u003c/p\u003e\n\u003cp dir=\"ltr\" style=\"line-height: 1.2; margin-top: 10pt; margin-bottom: 0pt; text-align: justify;\"\u003e\u003cspan style=\"font-size: 11pt; font-family: Arial; color: #000000; background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"\u003eƯng Bất Bạc (Zanthoxylum avicennae) từ ngàn năm trước đã được sử dụng trong Y học cổ truyền Việt Nam và Trung Quốc để hỗ trợ điều trị các chứng bệnh gan. PGS. TS Nguyễn Thượng Dong – Nguyên Viện trưởng viện Dược liệu chia sẻ: “Theo Y văn cổ của Việt Nam và Trung Quốc, Ưng Bất Bạc có vị cay, tính ấm, quy vào các kinh can, tỳ, vị, dùng để hỗ trợ điều trị các chứng viêm gan vàng da, viêm gan mạn, viêm thận phù thũng, thấp khớp, tổn thương do đòn đánh, eo lưng đau mỏi, hoạt huyết, giảm đau, lá giúp kháng khuẩn kháng viêm, đinh nhọt…”\u003c/span\u003e\u003c/p\u003e\n\u003cp dir=\"ltr\" style=\"line-height: 1.2; margin-top: 10pt; margin-bottom: 0pt; text-align: justify;\"\u003e\u003cspan style=\"font-size: 11pt; font-family: Arial; color: #000000; background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"\u003eKhoa học hiện đại chứng minh Ưng Bất Bạc chứa Hesperidin có tác dụng hỗ trợ phục hồi, tái tạo tế bào gan, hỗ trợ chống oxy hóa tế bào gan, hỗ trợ chống gốc tự do, hỗ trợ ngăn ngừa tổn thương gan, viêm gan do hóa chất và thuốc tân dược trên mô hình COX1 và COX2, hỗ trợ ngăn ngừa sự tạo thành colagen ở tế bào gan dẫn đến xơ gan và phòng ngừa gan nhiễm mỡ.\u003c/span\u003e\u003c/p\u003e\n\u003cp dir=\"ltr\" style=\"line-height: 1.2; margin-top: 10pt; margin-bottom: 0pt; text-align: justify;\"\u003e\u003cspan style=\"font-size: 11pt; font-family: Arial; color: #000000; background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"\u003eDiosmin có tác dụng hỗ trợ giảm tổn thương tế bào gan do rượu, tăng cường chuyển hóa và đào thải ethanol, hạ men gan, tăng cường chức năng gan, cải thiện các chỉ số glucosa máu, cholesterol, ure máu và hạ các men gan như AST và ALT\u003c/span\u003e\u003c/p\u003e\n\u003cp dir=\"ltr\" style=\"line-height: 1.2; margin-top: 10pt; margin-bottom: 0pt; text-align: justify;\"\u003e\u003cspan style=\"font-size: 11pt; font-family: Arial; color: #000000; background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"\u003eThành phần:\u003c/span\u003e\u003c/p\u003e\n\u003cp dir=\"ltr\" style=\"line-height: 1.2; margin-top: 10pt; margin-bottom: 0pt; text-align: justify;\"\u003e\u003cspan style=\"font-size: 11pt; font-family: Arial; color: #000000; background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"\u003e- Chiết xuất Ưng Bất Bạc chuẩn hóa: 450mg.\u003c/span\u003e\u003c/p\u003e\n\u003cp dir=\"ltr\" style=\"line-height: 1.2; margin-top: 0pt; margin-bottom: 0pt; text-align: justify;\"\u003e\u003cspan style=\"font-size: 11pt; font-family: Arial; color: #000000; background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"\u003e- Phosphocomplex: 25mg.\u003c/span\u003e\u003c/p\u003e\n\u003cp dir=\"ltr\" style=\"line-height: 1.2; margin-top: 10pt; margin-bottom: 0pt; text-align: justify;\"\u003e\u003cspan style=\"font-size: 11pt; font-family: Arial; color: #000000; background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"\u003eHướng dẫn sử dụng:\u003c/span\u003e\u003c/p\u003e\n\u003cp dir=\"ltr\" style=\"line-height: 1.2; margin-top: 10pt; margin-bottom: 0pt; text-align: justify;\"\u003e\u003cspan style=\"font-size: 11pt; font-family: Arial; color: #000000; background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"\u003e- Người lớn uống 2-4 viên/ngày.\u003c/span\u003e\u003c/p\u003e\n\u003cp dir=\"ltr\" style=\"line-height: 1.2; margin-top: 0pt; margin-bottom: 0pt; text-align: justify;\"\u003e\u003cspan style=\"font-size: 11pt; font-family: Arial; color: #000000; background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"\u003e- Trẻ em dùng liều bằng ½ người lớn.\u003c/span\u003e\u003c/p\u003e\n\u003cp dir=\"ltr\" style=\"line-height: 1.2; margin-top: 0pt; margin-bottom: 0pt; text-align: justify;\"\u003e\u003cspan style=\"font-size: 11pt; font-family: Arial; color: #000000; background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"\u003e- Uống sau bữa ăn 30 phút - 1 giờ.\u003c/span\u003e\u003c/p\u003e\n\u003cp dir=\"ltr\" style=\"line-height: 1.2; margin-top: 10pt; margin-bottom: 0pt; text-align: justify;\"\u003e\u003cspan style=\"font-size: 11pt; font-family: Arial; color: #000000; background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"\u003eĐối tượng sử dụng:\u003c/span\u003e\u003c/p\u003e\n\u003cp dir=\"ltr\" style=\"line-height: 1.2; margin-top: 10pt; margin-bottom: 0pt; text-align: justify;\"\u003e\u003cspan style=\"font-size: 11pt; font-family: Arial; color: #000000; background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"\u003e- Dùng cho người bị viêm gan siêu vi B, C; xơ gan, men gan cao; dùng thuốc , hóa chất có hại cho gan, uống nhiều rượu bia; ngộ độc do rượu, mẩn ngứa, mề đay, ăn uống kém, khó tiêu.\u003c/span\u003e\u003c/p\u003e\n\u003cp dir=\"ltr\" style=\"line-height: 1.2; margin-top: 0pt; margin-bottom: 0pt; text-align: justify;\"\u003e\u003cspan style=\"font-size: 11pt; font-family: Arial; color: #000000; background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"\u003e- Người có chức năng gan suy giảm, đang và sau quá trình hóa trị, xạ trị.\u003c/span\u003e\u003c/p\u003e\n\u003cp dir=\"ltr\" style=\"line-height: 1.2; margin-top: 10pt; margin-bottom: 0pt; text-align: justify;\"\u003e\u003cspan style=\"font-size: 11pt; font-family: Arial; color: #000000; background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"\u003eCông dụng:\u003c/span\u003e\u003c/p\u003e\n\u003cp dir=\"ltr\" style=\"line-height: 1.2; margin-top: 10pt; margin-bottom: 0pt; text-align: justify;\"\u003e\u003cspan style=\"font-size: 11pt; font-family: Arial; color: #000000; background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"\u003e- Hỗ trợ tăng cường chức năng gan, bảo vệ và phục hồi tế bào gan, giải độc gan trong các trường hợp viêm gan virus B, C, gan nhiễm mỡ, tổn thương gan do rượu bia, thuốc, nhiễm hóa chất.\u003c/span\u003e\u003c/p\u003e\n\u003cp dir=\"ltr\" style=\"line-height: 1.2; margin-top: 0pt; margin-bottom: 0pt; text-align: justify;\"\u003e\u003cspan style=\"font-size: 11pt; font-family: Arial; color: #000000; background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"\u003e- Hỗ trợ giảm nguy cơ và làm chậm sự phát triển của xơ gan, hạ men gan, giảm độc tính hóa trị, xạ trị.\u003c/span\u003e\u003c/p\u003e\n\u003cp dir=\"ltr\" style=\"line-height: 1.2; margin-top: 10pt; margin-bottom: 0pt; text-align: justify;\"\u003e\u003cspan style=\"font-size: 11pt; font-family: Arial; color: #000000; background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\"\u003eHàng ngàn người đã tin tưởng đồng hành cùng Heposal trong hành trình hỗ trợ chữa trị, phục hồi tổn thương bệnh viêm gan, xơ gan của mình.\u003c/span\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/7f/e3/89/1fcf026efe056fd560dadf5bad2dbbea.JPG","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/7f/e3/89/1fcf026efe056fd560dadf5bad2dbbea.JPG","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/7f/e3/89/1fcf026efe056fd560dadf5bad2dbbea.JPG","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7f/e3/89/1fcf026efe056fd560dadf5bad2dbbea.JPG","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7f/e3/89/1fcf026efe056fd560dadf5bad2dbbea.JPG"},{"base_url":"https://salt.tikicdn.com/ts/product/cc/9f/44/fbe97096e9b1e30ec852a80797330631.JPG","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/cc/9f/44/fbe97096e9b1e30ec852a80797330631.JPG","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/cc/9f/44/fbe97096e9b1e30ec852a80797330631.JPG","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/cc/9f/44/fbe97096e9b1e30ec852a80797330631.JPG","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/cc/9f/44/fbe97096e9b1e30ec852a80797330631.JPG"},{"base_url":"https://salt.tikicdn.com/ts/product/2b/c2/7a/c5e467551d8f6ece7db4e27c8b92df04.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/2b/c2/7a/c5e467551d8f6ece7db4e27c8b92df04.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/2b/c2/7a/c5e467551d8f6ece7db4e27c8b92df0