7d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":3100,"discount_rate":2,"rating_average":4,"review_count":9,"review_text":"(9)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/bf/95/64/616787831e53dae27b36e11179585d65.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":280,"all_time_quantity_sold":51,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cdiv\u003eTính năng cơ bản Cáp sạc nhanh C to IP 20W Baseus Tungsten Gold dùng cho iPhone 12/ iP11 Series/ iPXS Max\u003c/div\u003e\n\u003cdiv\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cp\u003e- Cáp sạc nhanh Baseus Tungsten Gold 20W là thế hệ cáp sạc C to IP mới nhất của Baseus. Sản phẩm được thiết kế chuyên dụng cho dòng iPhone 12 mà Apple vừa trình làng. Đảm bảo tốc độ sạc nhanh, độ ổn định cao và tương thích tuyệt đối với dòng iPhone 12.\u003c/p\u003e\n\u003cp\u003e- Hỗ trợ sạc nhanh chuẩn PD (Power Delivery) chuẩn mới nhất với công suất lên đến 20W, có thể tương tích cả chuẩn PD 18W trên iPhone 11 Series trở về trước nhờ vào chip xử lý nguồn điện thông minh có thể nhận dạng được thiết bị để điều chỉnh nguồn điện ngỏ ra phù hợp . Sản phẩm dùng sạc pin cho cả iPhone và iPad với tốc độ cực cao và vẫn đảm bảo an toàn .\u003c/p\u003e\n\u003cp\u003e- Hổ trợ đồng bộ dữ liệu, tốc độ truyền tải dữ liệu lên đến 480Mbps và khả năng bảo vệ an toàn tuyệt đối cho thiết bị của bạn.\u003c/p\u003e\n\u003cp\u003e- Đầu cáp và các tiếp điểm được làm bằng hợp kim Tungsten cao cấp, siêu bền (hay còn gọn là Wolfram) cho hiệu suất sử dụng cực cao và độ ổn định vượt trội, chống hiện tượng gãy đầu cáp . Dây cáp bằng vải dù siêu bền cho thời gian sử dụng cực lâu. \u003c/p\u003e\n\u003cp\u003e\u003cem\u003e(***Tungsten là kim loại cứng thứ 2 sau cacbon (kim cương), nặng quý hiếm và có màu xám trắng, có điểm nóng chảy cao nhất, hệ số giản nở thấp nhất , độ bền kéo cao nhất, áp suất hơi thấp)\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e- Chất liệu cao cấp, thiết kế hiện đại có độ hoàn thiện cao .  \u003c/p\u003e\n\u003ch2\u003eHình ảnh chi tiết Cáp sạc nhanh C to IP 20W Baseus Tungsten Gold dùng cho iPhone 12/ iP11 Series/ iPXS Max\u003c/h2\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/c2/9f/b6/dc7b5e12750b8c9ca5390a7f8871736f.jpg\" alt=\"\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/c6/5b/6c/879a5d28e8ce54a71bc9ef8d45d57fc0.jpg\" alt=\"\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/b8/9b/04/49aac521c8c3feb22d611d2c9092d4c4.jpg\" alt=\"\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/68/ff/dd/5142d12d8365ef5e8a5dba3c4f2aee40.jpg\" alt=\"\" width=\"600\" height=\"600\" /\u003e\u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv\u003e\u003cimg class=\"detail-desc-decorate-image\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/20/b8/eb/f701a53f655e52f9eb6cd489ac82d6a3.jpg\" /\u003e\u003cimg class=\"detail-desc-decorate-image\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/7a/8c/cd/1ea3b5896a9a0452e18e90d4788a8138.jpg\" /\u003e\u003cimg class=\"detail-desc-decorate-image\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/