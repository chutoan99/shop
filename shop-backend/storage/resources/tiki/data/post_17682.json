"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"defective_product"}},"discount":610000,"discount_rate":21,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/24/3c/32/3c0881007e51ea6fa42530b6a8195dea.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":722,"all_time_quantity_sold":8,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eNhóm nước hoa: Hương hoa cỏ\u003c/p\u003e\n\u003cp\u003eGiới tính: Nữ\u003c/p\u003e\n\u003cp\u003eNăm ra mắt: 2017\u003c/p\u003e\n\u003cp\u003eNồng độ: Eau De Parfum (EDP)\u003c/p\u003e\n\u003cp\u003eNhà pha chế: Alberto Morillas\u003c/p\u003e\n\u003cp\u003ePhong Cách: Quyến Rũ, Sang Trọng, Quý Phái\u003c/p\u003e\n\u003cdiv\u003eHương Đầu : Lá Cây\u003c/div\u003e\n\u003cdiv\u003eHương Giữa : Hoa Kim Ngân, Hoa Nhài, Hoa Huệ\u003c/div\u003e\n\u003cdiv\u003eHương Cuối : Gỗ Đàn Hương, Vani, Rễ Cây Diên Vĩ\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv\u003e\n\u003cp\u003eGucci ra mắt dòng nước hoa hoàn toàn mới với tên gọi Gucci Bloom và dược giới thiệu vào năm 2017. Đây là dòng nước hoa đầu tiên được phát triển hoàn toàn dưới tầm nhìn sáng tạo của Alessandro Michele. Đây được xem là một mùi hương được thiết kế để kỷ niệm tính xác thực, sức sống và sự đa dạng của phụ nữ-phát triển theo cách tự nhiên, biểu cảm và cá nhân.\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"aligncenter wp-image-39592\" title=\"Gucci Bloom Eau de Parfum For Her 1 - Nuochoarosa.com - Nước hoa cao cấp, chính hãng giá tốt, mẫu mới\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/9b/21/3f/33b3828cec16c65bff5619d4ddbfd3ef.jpg\" alt=\"z3697874795599 bc943158b2b50fc2cedaf37ef2253401 min - Nuochoarosa.com - Nước hoa cao cấp, chính hãng giá tốt, mẫu mới\" width=\"500\" height=\"375\" /\u003e\u003c/p\u003e\n\u003cp\u003eĐược chế tạo bởi bậc thầy nước hoa Alberto Morillas dưới sự chỉ đạo của giám đốc sáng tạo của Hose, Gucci Bloom được tạo ra giống như tên của nó, thu hút được hương thơm phong phú của một khu vườn rực rỡ đầy hoa.\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"aligncenter wp-image-39591\" title=\"Gucci Bloom Eau de Parfum For Her 2 - Nuochoarosa.com - Nước hoa cao cấp, chính hãng giá tốt, mẫu mới\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/09/d6/68/818b57ff52894ca2e2f9b4fec2ac34d5.jpg\" alt=\"z3697874788809 b0b66bd7f7f1f6303a49eaf846fc12b1 min - Nuochoarosa.com - Nước hoa cao cấp, chính hãng giá tốt, mẫu mới\" width=\"450\" height=\"443\" /\u003e\u003c/p\u003e\n\u003cp\u003eLà một cơn gió mát của mùa xuân, tràn ngập sức sống. Gucci Bloom giống một bông hoa nhỏ bé đang từ từ nở rộ, tràn ngập giữa một vườn hoa trắng muốt đầy trang nhã. Chân thật với hương thơm của lá cây vào buổi sớm mai, chất chứa những giọt sương còn đọng lại vào đêm hôm trước. Gucci Bloom mộc mạc, trần trụi, đem lại cảm giác hồi xuân, mang tôi trở về với quá khứ, vui đùa cùng những cánh hoa trong vườn, nhâm nhi ly nước chanh mát lạnh trong một ngày nắng nóng. Chi ngân, Nhài và Huệ như hoà quyện vào gió, tạo nên một điệu nhảy của cánh hoa , mang đến những khoảnh khắc kì diệu, khác biệt và không hề gây buồn chán. Gỗ đàn hương và Vani hòa quyện với nhau như một cặp đôi đang khiêu vũ, trong veo đầy thơ mộng. Gucci Bloom là một giấc mộng của mùa xuân, mơ màng dưới bóng cây cổ thụ, nhưng biết hé nở và tỏa hương khi cần.\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"aligncenter wp-image-39593\" title=\"Gucci Bloom Eau de Parfum For Her 3 - Nuochoarosa.com - Nước hoa cao cấp, chính hãng giá tốt, mẫu mới\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/f2/cc/f5/5a5acab50d71c6fcb8448366eb8f4d59.jpg\" alt=\"z3697874796855 02cdf8597c634f9e7c3565a1413c9eb4 min - Nuochoarosa.com - Nước hoa cao cấp, chính hãng giá tốt, mẫu mới\" width=\"500\" height=\"500\" /\u003e\u003c/p\u003e\n\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/24/3c/32/3c0881007e51ea6fa42530b6a8195dea.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/24/3c/32/3c0881007e51ea6fa42530b6a8195dea.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/24/3c/32/3c0881007e51ea6fa42530b6a8195dea.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/24/3c/32/3c0881007e51ea6fa42530b6a8195dea.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/24/3c/32/3c0881007e51ea6fa42530b6a8195dea.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/12/08/4b/5dd56e230f9200ff01a2c129af984bb1.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/12/08/4b/5dd56e230f9200ff01a2c129af984bb1.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/12/08/4b/5dd56e230f9200ff01a2c129af984bb1.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/12/08/4b/5dd56e230f9200ff01a2c129af984bb1.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/12/08/4b/5dd56e230f9200ff01a2c129af984bb1.jpg"}],"warranty