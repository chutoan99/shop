con":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/28/90/9e/958c64fb38d465b0131ec05aad85dd97.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":124,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp class=\"QN2lPu\"\u003eTHÔNG TIN SẢN PHẨM:\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eBút chì kim kỹ thuật cao cấp Pentel Graphgear 500 loại 0.3 / 0.5 / 0.7 / 0.9 mm vẽ phác thảo, vẽ kiến trúc - PG513, PG515, PG517, PG519\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eBút Chì Kim Kỹ Thuật Bấm Inox Pentel – PG513/ 515/ 517 / 519 là một trong những mẫu bút chì được đánh giá rất cao về kiểu dáng thiết kế lẫn chất lượng. Vẻ ngoài bắt mắt nhưng vô cùng tinh tế, chất lượng vượt trội với nhiều tính năng đặc sắc, bút chì kim đáp ứng mọi nhu cầu kỹ thuật khó tính nhất của khách hàng.\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e️ Thiết kế tinh tế\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eBút Chì Kim Kỹ Thuật Bấm Inox được làm bằng kim loại cao cấp, sở hữu kiểu dáng thiết kế rất bắt mắt và tinh tế do được phủ lớp sơn màu bạc sang trọng.\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e \u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eCó thể nói, mẫu mã đẹp chính là một trong những yếu tố quan trọng khiến người tiêu dùng rất yêu chuộng loại bút chì này.\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e \u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e️ Chất lượng hoàn hảo\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e \u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eVì được làm bằng chất liệu cao cấp nên bút đảm bảo tối đa sức khỏe người sử dụng, mang lại độ bền cao.\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e \u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eThân bút thiết kế theo dạng lục giác độc đáo, giúp bạn dễ dàng cầm nắm, hạn chế mỏi tay khi dùng lâu. Ngoài ra, thiết kế này cũng ngăn không cho bút lăn khỏi bàn, tránh rơi rớt, làm hỏng bút.\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e \u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eCơ chế bấm được thiết kế ở đuôi bút rất tiện dụng. Bạn chỉ cần giữ thân bút và bấm nhẹ là có thể dễ dàng bấm thêm chì để dùng.\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e \u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eĐặc biệt, bút bấm rất chắc, cho ra lượng ngòi vừa phải, hạn chế tối đa sự gãy ngòi, tiết kiệm nhiều hơn cho bạn.\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e \u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eGần đầu bút có đường gờ chống trượt khắc nhám, tạo sự thoải mái tối đa cho bạn ngay cả khi phải viết trong hàng giờ liền.\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e \u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eỐng giữ ngòi chì được thiết kế nhỏ và có độ dài hợp lý giúp việc vẽ không bị khuất tầm nhìn và dễ dàng kết hợp với thước kẻ. Đây cũng chính là điểm nhấn nổi bật nhất của mẫu bút chì này.\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e \u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eMột nét đặc sắc khác là phần đuôi bút có thể xoay để chọn chỉ số loại ngòi chì bạn đang sử dụng, đáp ứng những yêu cầu kỹ thuật của khách hàng.\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e \u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eSản phẩm sử dụng ngòi 0.3/ 0.5/ 0.7 / 0.9 mm; trang bị gôm tẩy ở đuôi bút, được bảo quản bởi nắp đậy, giúp giữ gôm không bị rơi; thanh gài chắc chắn đem đến sự tiện lợi cho người dùng khi có thể dễ dàng mang bút theo bên mình bằng cách gài lên túi áo.\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e \u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003ế ̛́\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eNhật Bản\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e_____________________________________\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e#nhậtbản #bút #bútchì #bútchìkim #butchikim #butpentel #bútpentel #pentelnhatban #butchikimkythuat #bútchìkimkỹthuật #pentelofficial #Butchikimpentel #graphgear500 #butchikimvekientruc #butchikimvehoihoa #butchikimmythuat #butchibampentel #ngoichipentel #pentelPG513 #pentelPG515 #pentelPG517 #PG513 #PG515 #PG517 #pentel #Graphgear #bútchìkimkỹthuật #Sketch #PG515 #pentel #bútchìkim #chì #chì_kim #bút_kỹ_thuật #bút #bút_chì #chì_kỹ_thuật #chì_cơ_khí\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/28/90/9e/958c64fb38d465b0131ec05aad85dd97.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/28/90/9e/958c64fb38d465b0131ec05aad85dd97.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/28/90/9e/958c64fb38d465b0131ec05aad85dd97.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/28/90/9e/958c64fb38d465b0131ec05aad85dd97.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/28/90/9e/958c64fb38d465b0131ec05aad85dd97.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/6f/3b/10/bc7f00cb51968dbbeef41d2f20be94c9.jpeg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/6f/3b/10/bc7f00cb51968dbbeef41d2f20be94c9.jpeg","medium_url":"