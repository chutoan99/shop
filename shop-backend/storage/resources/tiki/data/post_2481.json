ound_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":19600,"discount_rate":10,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/e9/2e/51/c90200d03a3ad892fcba536873b79bdb.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1790,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eCâu chuyện đầy thú vị về cô gái có mười người bạn trai và chàng trai có hai mươi sáu cô bạn gái được tác giả ngôn tình Giá Oản Chúc khắc họa rõ nét trong Anh yêu em rồi phải không?\u003c/p\u003e\n\u003cp\u003eCô gái Kinh Mịch Ngọc xinh đẹp, tài giỏi thông minh nhưng không kém phần đặc biệt. Điều đặc biệt ở cô là quen nhiều người nhưng chia tay cũng rất nhanh, chia tay xong vẫn có thể làm bạn, thậm chí là bạn bè tốt của nhau. Trải qua mười mối tình, người ta sẽ nghĩ ngay đến một cô gái có phần “dễ dãi” nhưng với Mịch Ngọc thì khác. Cô vẫn luôn vui vẻ, lạc quan khi đi chơi cùng với các bạn trai cũ “tôi nghèo, chỉ có thể sưu tập bạn trai thôi”.\u003c/p\u003e\n\u003cp\u003eYến Ngọc - đẹp trai, nhà giàu, bản lĩnh nhưng cũng không kém phần tốt bụng. Anh biết quá khứ Mịch Ngọc, anh cho rằng quá khứ là quá khứ, bỏ được thì nên bỏ, cái cần hướng tới là tương lai của hai người. Với anh “thái độ đúng đắn nhất đối với quá khứ là chấp nhận chứ không phải là quên lãng”. Chàng trai tốt bụng này đã giúp Mịch Ngọc vốn không còn tin vào tình yêu đã trở thành cô gái biết yêu thương, chia sẻ.\u003c/p\u003e\n\u003cp\u003eKết thúc câu chuyện, sự thật uẩn khúc bấy lâu được vén bức màn bí ẩn khiến độc giả đi từ bất ngờ này sang bất ngờ khác. Một bức tranh tươi sáng được vẽ ra cho cặp đôi kim đồng ngọc nữ Yến Ngọc – Mịch Ngọc như minh chứng cho sự cố gắng của cả hai.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/e9/2e/51/c90200d03a3ad892fcba536873b79bdb.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e9/2e/51/c90200d03a3ad892fcba536873b79bdb.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e9/2e/51/c90200d03a3ad892fcba536873b79bdb.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e9/2e/51/c90200d03a3ad892fcba536873b79bdb.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e9/2e/51/c90200d03a3ad892fcba536873b79bdb.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/ca/91/1d/60fabce9b52de04e5f7f6646cab636a1.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ca/91/1d/60fabce9b52de04e5f7f6646cab636a1.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ca/91/1d/60fabce9b52de04e5f7f6646cab636a1.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ca/91/1d/60fabce9b52de04e5f7f6646cab636a1.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ca/91/1d/60fabce9b52de04e5f7f6646cab636a1.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/54/8f/b8/a7511e8cf9a4e75ba3a990b090f5e365.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/54/8f/b8/a7511e8cf9a4e75ba3a990b090f5e365.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/54/8f/b8/a7511e8cf9