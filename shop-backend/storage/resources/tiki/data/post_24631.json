nd_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.1,"review_count":8,"review_text":"(8)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/27/9e/ff/b40db25c2fdd26ebcef3d14880b1bca4.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":629,"all_time_quantity_sold":24,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch1\u003eBộ chuyển âm thanh Kiwi KX6\u003c/h1\u003e\n\u003cp\u003eBộ chuyển âm thanh Kiwi KX6 là một thiết bị quen thuộc và không thể thiếu trong các dàn âm thanh cũng như các thiết bị trong gia đình. Bộ chuyển đổi giúp sự truyền âm giữa các thiết bị mượt mà và thuận lợi hơn, cho chất âm chân thực hơn từ nguồn ra thiết bị phát. Vì sự hữu ích quan trọng đó của thiết bị này, tháng 12 Kiwi tiếp tục cho ra mắt bộ chuyển âm thanh Kiwi KX6 hoàn toàn mới . Vậy bộ chuyển mới này có những tính năng gì đặc biệt, cùng theo dõi tiếp bài viết này nhé.\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"alignnone size-full wp-image-3767\" style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/ba/9d/59/aa92fa1e605f8a61d5d51fa72fe25f57.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch2\u003eBộ chuyển âm thanh Kiwi KX6 Thiết kế nhỏ gọn, trực quan\u003c/h2\u003e\n\u003cp\u003eBộ chuyển âm thanh Kiwi KX6 được thiết kế rất nhỏ gọn, dễ dàng mang đi, với màu đen đặc trưng được in chìm thương hiệu Kiwi ngay trên mặt sản phẩm. Kiwi KX6 có hai đầu rõ ràng tiện lợi để sử dụng:\u003c/p\u003e\n\u003cp\u003eĐầu vào Input: có cổng Coaxial, OptIcal cùng cổng cắm nguồn 5V hỗ trợ cắm với các thiết bị như Smart TiVi, Android TiVi Box\u003c/p\u003e\n\u003cp\u003eĐầu ra Output có các cổng: Stereo, Cổng 3.5mm hỗ trợ cắm với dàn loa, amply đời cũ\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"alignnone size-full wp-image-3769\" style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/12/3b/a3/4436a619526e64c1828281ae0b3e1f27.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003cimg class=\"alignnone size-full wp-image-3764\" style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/20/a6/4d/01866af541ff79661cd9f211480e9829.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003cimg class=\"alignnone size-full wp-image-3762\" style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/6a/64/81/42d9b2cb5d969a4f1e83a4c671fa5322.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch2\u003eBộ chuyển âm thanh Kiwi KX6 Tính năng hiện đại\u003c/h2\u003e\n\u003cp\u003eBộ chuyển âm thanh Kiwi KX6 sử dụng chíp và linh kiện ngoại vi cao cấp nên cho ra âm thanh lớn, rõ ràng, trong trẻo, chi tiết hơn hẳn các bộ chuyển quang thông thường. Chuyển đổi tín hiệu từ Digital sang Analog với đầu ra thêm cổng 3.5mm. Hỗ trợ chuyển đổi giữa các cổng trên Smart TiVi , Android tivi Box phát nhạc được lên loa, amply khi chưa tương thích cổng với nhau một cách tốt nhất. Kết nối đơn giản, dể sử dụng mà không cần cài đặt.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/27/9e/ff/b40db25c2fdd26ebcef3d14880b1bca4.png","is_gallery":true,"label":null,"large_url":"https://salt.