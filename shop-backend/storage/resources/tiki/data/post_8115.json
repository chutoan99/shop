00f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/36/be/18/a967336b481ce705229889ba169f62a2.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":431,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eMô tả quạt sạc tích điện mini kết hợp đèn bàn Comet CT176 - Quạt sạc và đèn bàn sạc LED tích hợp tiện lợi 2 trong 1.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/7b/69/60/02c09471387d6e71357a6da1b103ad20.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/e8/a1/d8/fc0e9b1a9636e5fd4e366cf99cef653c.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/e9/9b/bb/45fa2515f9261b761d210a43bfaf897a.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eƯu điểm nổi bật:\u003cbr /\u003e– Ánh sáng trắng trung thực, ổn định không nhấp nháy.\u003cbr /\u003e– Thiết kế tinh tế theo xu hướng hiện đại, nhỏ gọn và tiện dụng. Đèn kết hợp quạt sạc Comet siêu tiện lợi cho việc di chuyển hay vào những lúc mất điện\u003cbr /\u003e– Chất liệu nhựa ABS bền đẹp, an toàn cho sức khoẻ người sử dụng\u003cbr /\u003e– Pin Lithium, chất liệu pin cao cấp hiện nay: dung lượng 1800mAh, Pin thiết kế rời, dễ dàng thay thế được\u003cbr /\u003e– ĐẶC BIỆT: Khi tháo bỏ pin sạc ra khỏi Đèn bàn CT176, sản phẩm sẽ sử dụng bình thường như một Đèn Bàn Led nếu có nguồn điện cung cấp (cắm cáp sạc trực tiếp vào Đèn bàn CT176 với cổng USB của PC, Laptop, Sạc dự phòng hoặc dùng kết nối cáp sạc với cốc sạc để cắm điện nguồn AC trực tiếp)\u003cbr /\u003e– Công suất đèn Led: 4W\u003cbr /\u003e– Tổng Công suất quạt: 8W\u003cbr /\u003e– Thời gian sạc: 3-5 4 giờ\u003c/p\u003e\n\u003cp\u003e+ Sáng mạnh: 3 giờ\u003cbr /\u003e+ Sáng vừa: 9 giờ\u003cbr /\u003e+ Sáng yếu: 30 giờ\u003cbr /\u003e– Thời gian hoạt động Quạt:\u003cbr /\u003e+ Mạnh nhất: 2 giờ\u003cbr /\u003e+ Trung bình: 3 giờ\u003cbr /\u003e+ Yếu: 4 giờ\u003cbr /\u003e– Nhiệt độ màu của ánh sáng: 6500K±500K\u003cbr /\u003e– Chỉ số hoàn màu CRI: \u0026gt;80\u003cbr /\u003e– Quang thông: \u0026gt;200 Lm\u003cbr /\u003e– Có thể điều chỉnh góc chiếu mọi hướng\u003c/p\u003e\n\u003cp\u003eHướng dẫn sử dụng:\u003cbr /\u003e– Bật/tắt đèn \u0026amp; điều chỉnh ánh sáng: chạm nhẹ  vào nút nguồn dể chọn chế độ ánh sáng phù hợp: ánh sáng mạnh/vừa/yếu/tắt.\u003cbr /\u003e– Có nút bật/tắt quạt: Khi có nhu cầu sử dụng quạt, nhấn vào nút hình biểu quạt cánh quạt để khởi động quạt. \u003cbr /\u003e– Sạc pin: Kết nối dây cáp USB vào cốc sạc/thiết bị sạc có điện áp phù hợp với đầu vào Micro USB DC 5V, dòng điện tối đa 500mA, sau đó cắm đầu sạc vào cổng Micro USB trên đèn, đèn Led báo sạc pin sẽ sáng đỏ. Khi sạc \u0026gt; 4 giờ pin sẽ đầy và tự động ngắt, đèn bao sạc chuyển sang màu xanh, bạn chú ý rút cốc sạc.\u003cbr /\u003e– Sạc đèn đủ 8 giờ trước khi sử dụng lần đầu. Nếu không sử dụng đèn trong thời gian dài, sạc đèn ít nhất 1 lần trong vòng 3 tháng, sạc đủ 8 giờ để bảo vệ tuổi thọ của pin.\u003c/p\u003e\n\u003cp\u003eỨng dụng:\u003cbr /\u003e– Dùng đọc sách, báo, nghiên cứu tài liệu, làm việc ban đêm….\u003cbr /\u003e– Dùng khi mất điện, hoặc dùng để lấy ánh sáng ở những nơi không có điện nguồn (Khi dùng có pin sạc gắn trong sản phẩm)\u003cbr /\u003e– Dùng như một đèn bàn Led thông thường khi được cung cấp năng lượng (Khi không dùng pin sạc gắn trong sản phẩm)\u003cbr /\u003e– Dùng làm quà tặng cho bé yêu, cho người thân, bạn bè, đối tác, đồng nghiệp, hoặc dành tặng cho nhân viên/công nhân trong công ty\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/36/be/18/a967336b481ce705229889ba169f62a2.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/36/be/18/a967336b481ce705229889ba169f62a2.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/36/be/18/a967336b481ce705229889ba169f62a2.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/36/be/18/a967336b481ce705229889ba169f62a2.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/36/be/18/a967336b481ce705229889ba169f62a2.png"},{"base_url":"https://salt.tikicdn.com/ts/product/2c/ac/f7/d245d128f236651e46042096e1a6eef3.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/2c/ac/f7/d245d128f236651e46042096e1a6eef3.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/2c/ac/f7/d245d128f236651e46042096e1a6eef3.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2c/ac/f7/d245d128f236651e46042096e1a6eef3.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2c/ac/f7/d245d128f236651e46042096e1a6eef3.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/7b/69/60/114d6a8f77bcf04b59ab17d70fe40e3c.jpg","is_gallery":true,"label":null,"large_url":