und_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.5,"review_count":30,"review_text":"(30)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/62/46/a4/d2049422dd5ae1c5f79e8086282b9fab.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2156,"all_time_quantity_sold":1071,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"font-family: -webkit-standard; margin-bottom: 0.0001pt;\"\u003e\u003cspan style=\"font-size: 14px;\"\u003e\u003cspan style=\"font-family: Verdana, Geneva, sans-serif;\"\u003e\u003cspan style=\"line-height: 18.75pt;\"\u003e\u003cstrong\u003e\u003cspan style=\"letter-spacing: 0.15pt;\"\u003eKhẩu trang NeoMask VC65\u003c/span\u003e\u003c/strong\u003e\u003cspan style=\"letter-spacing: 0.15pt;\"\u003elà loại phụ kiện y tế chống bụi hoàn hảo nhưng cực kỳ hợp lý túi tiền của \u003cstrong\u003ehãng NeoVision\u003c/strong\u003e. Được chế tạo bằng \u003cstrong\u003ethan hoạt tính ép trong vải không dệt \u003c/strong\u003e(Activated Carbon Nonwoven) \u003c/span\u003e\u003c/span\u003e\u003cspan style=\"line-height: 18.75pt;\"\u003e\u003cspan style=\"letter-spacing: 0.15pt;\"\u003ecó tính năng ngăn ngừa được hầu hết sự thâm nhập vào đường hô hấp của các hạt bụi cực nhỏ và các chất thải ô nhiễm khác.\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"font-family: -webkit-standard; margin-bottom: 0.0001pt;\"\u003e\u003cspan style=\"font-size: 14px;\"\u003e\u003cspan style=\"font-family: Verdana, Geneva, sans-serif;\"\u003e\u003cspan style=\"line-height: 18.75pt;\"\u003e\u003cspan style=\"letter-spacing: 0.15pt;\"\u003eKhác với những mẫu \u003cem\u003ekhẩu trang than hoạt tính\u003c/em\u003ekhác của, Mẫu \u003cstrong\u003ekhẩu trang NeoMask VC65\u003c/strong\u003emang lại cho bạn vẻ đơn giản và tiết kiệm hơn nhưng vẫn đảm bảo an toàn sức khỏe theo các tiêu chuẩn Quốc Tế, ngăn ngừa tuyệt đối sự thâm nhập vào đường hô hấp của hầu hết các chất ô nhiễm trong không khí: Hydrocacbon (bao gồm benzen, piren butadien 1 - 3) Cacbon oxit CO, Đyoxit sunphua (SO2), Đioxit Nitơ (NO2), Khói quang hoá, khói đen, Andehyt, Oxít chì, phấn hoa…\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"font-family: -webkit-standard; margin-bottom: 0.0001pt;\"\u003e\u003cspan style=\"font-size: 14px;\"\u003e\u003cspan style=\"font-family: Verdana, Geneva, sans-serif;\"\u003e\u003cspan style=\"line-height: 18.75pt;\"\u003e\u003cspan style=\"letter-spacing: 0.15pt;\"\u003eNgoài ra sản phẩm được kiểm nghiệm tại Phòng Thí Nghiệm Nelson (Mỹ) đạt chỉ số Hiệu quả lọc khuẩn \u003cstrong\u003eBFE 95%. BFE \u003c/strong\u003ehay viết tắt của \u003c/span\u003e\u003c/span\u003eBacteria Filtration Efficiency\u003c/span\u003e\u003c/span\u003e. Đây \u003cspan style=\"font-size: 14px;\"\u003e\u003cspan style=\"font-family: Verdana, Geneva, sans-serif;\"\u003e\u003cspan style=\"line-height: 18.75pt;\"\u003e\u003cspan style=\"letter-spacing: 0.15pt;\"\u003elà chỉ số thể hiện khả năng lọc khuẩn và kháng bụi dùng để đánh giá chất lượng của khẩu trang. BFE 95% đồng nghĩa với khả năng kháng bụi và lọc khuẩn lên đến 95%.\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://vcdn.tikicdn.com/ts/tmp/2b/04/c5/dcb51f61e526a7fcb451819e50b1c6b2.jpg\" alt=\"\" width=\"720\" height=\"720\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://vcdn.tikicdn.com/ts/tmp/62/46/a4/3ddccae913824ccd2fa69d2741ab931e.jpg\" alt=\"\" width=\"720\" height=\"720\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://vcdn.tikicdn.com/ts/tmp/66/20/5e/adbeb20bf640f71ce2a13f6e839a817b.jpg\" alt=\"\" width=\"720\" height=\"720\" /\u003e\u003c/p\u003e\n\u003cp\u003eCách Sử Dụng Và Bảo Quản\u003c/p\u003e\n\u003cp\u003eBước 1: Đặt khẩu trang ngay ngắn giữa sống mũi và cằm, quàng thun qua tai.\u003c/p\u003e\n\u003cp\u003eBước 2: Điều chỉnh kẹp mũi cho ôm vừa vặn sống mũi đảm bảo bịt kín mọi kẽ hở.\u003c/p\u003e\n\u003cp\u003eBước 3: Bảo quản trong điều kiện bình thường, khô ráo khi không sử dụng.\u003c/p\u003e\n\u003cp\u003eThời gian sử dụng: 01 - 03 tháng từ ngày bắt đầu sử dụng.\u003c/p\u003e\n\u003cp\u003eLưu ý: khi giặt bạn nhớ tháo bộ lọc ra riêng và chỉ giặt vỏ ngoài, khi đã phơi khô thì lắp bộ lọc vào lại\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/62/46/a4/d2049422dd5ae1c5f79e8086282b9fab.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/62/46/a4/d2049422dd5ae1c5f79e8086282b9fab.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/62/46/a4/d2049422dd5ae1c5f79e8086282b9fab.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/62/46/a4/d2049422dd5ae1c5f79e8086282b9fab.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/62/46/a4/d2049422dd5ae1c5f79e8086282b9fab.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/e6/37/af/50802b07f364c5f7d5bb20030e0b7c62.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e6/37/af/50802b07f364c