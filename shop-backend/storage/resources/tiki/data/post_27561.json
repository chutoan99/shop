d97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":106200,"discount_rate":37,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/e5/25/a6/a598b8d03f3641852d34ac1843ca70b2.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":271,"all_time_quantity_sold":17,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003ePhilips\u003c/strong\u003e là một trong những \u003cstrong\u003ethương hiệu chiếu sáng\u003c/strong\u003e đáng tin cậy hàng đầu trên toàn thế giới. Với đến công nghệ luôn được cải tiến, chất lượng sản phẩm vượt trội, giá thành hợp lý giúp cải thiện và nâng cao chất lượng sống của con người.\u003c/p\u003e\n\u003cp\u003eCác dòng sản phẩm chiếu sáng thương hiệu \u003cstrong\u003ePhilips \u003c/strong\u003eđược Nhập khẩu và Phân phối chính hãng tại thị trường Việt Nam, đáp ứng các tiêu chuẩn an toàn Quốc tế mang lại sự tin cậy cho người dùng.\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/9a/9f/83/b35e98b24c5358d01e9471382a195d80.jpg\" alt=\"Lựa chọn đèn LED\" width=\"750\" height=\"596\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cem\u003eBạn chọn chất lượng nguồn sáng hay chọn giá tiền?\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003eBộ đèn LED Downlight âm trần \u003cstrong\u003e\u003cspan style=\"color:#0000ff;\"\u003eMeson Max DL262\u003c/span\u003e\u003c/strong\u003e là dòng sản phẩm thiết kế siêu mỏng chỉ \u003cspan style=\"color:#0000ff;\"\u003e\u003cstrong\u003e18mm\u003c/strong\u003e\u003c/span\u003e, thân đèn bằng kim loại chắc chắn và tuổi thọ lên đến \u003cspan style=\"color:#0000ff;\"\u003e\u003cstrong\u003e30,000 Giờ\u003c/strong\u003e\u003c/span\u003e giúp vận hành bền bỉ theo thời gian.\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/7a/b3/79/74da8d7d052c2d3bccefdf7bb064f5f1.jpg\" alt=\"Bộ đèn LED âm trần Meson Max\" width=\"750\" height=\"670\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cem\u003eƯu điểm nổi bật của đèn\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e\u003cstrong\u003eCông nghệ Eye Comfort đem lại ánh sáng êm dịu cho mắt\u003c/strong\u003e\u003cbr /\u003eVới công nghệ Eye Comfort, đèn LED âm trần Philips Meson sẽ mang đến bạn 1 nguồn sáng liên tục, nhẹ dịu với mắt và không có những hiện tượng như nhấp nháy, mờ hay nhòe như các mẫu bóng đèn truyền thống.\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cem\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/50/af/7c/1abe99148d997710965d7a944d1ea957.jpg\" alt=\"Thiết kế siêu mỏng phù hợp với mọi loại trần thạch cao\" width=\"750\" height=\"517\" /\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003eÁnh sáng chất lượng cao \u003cspan style=\"color:#0000ff;\"\u003e\u003cstrong\u003eCRI 80\u003c/strong\u003e\u003c/span\u003e mang đến màu sắc trung thực cho không gian nhà bạn. Đây cũng là yếu tố tiên quyết bạn nên chọn sản phẩm này thay vì những sản phẩm giá rẻ khác.\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cem\u003eThiết kế siêu mỏng 18mm phù hợp với mọi loại trần thạch cao\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cem\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/60/c8/f9/3ae60e7e94bdf568961ff42ca2401a86.jpg\" alt=\"Meson Max DL262\" width=\"500\" height=\"422\" /\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cem\u003eThiết kế chắc chắn ứng dụng linh hoạt\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/4c/be/e7/a3f12d84e9efb867c0392b570f660305.jpg\" alt=\"Vì sao nên chọn đèn Philips\" width=\"750\" height=\"304\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/e5/33/c0/2c0fd5d3bf8027d165e4faf78f66b5a4.jpg\" alt=\"Hỗ trợ mua đèn LED Philips\" width=\"750\" height=\"238\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/e5/25/a6/a598b8d03f3641852d34ac1843ca70b2.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e5/25/a6/a598b8d03f3641852d34ac1843ca70b2.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e5/25/a6/a598b8d03f3641852d34ac1843ca70b2.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e5/25/a6/a598b8d03f3641852d34ac1843ca70b2.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e5/25/a6/a598b8d03f3641852d34ac1843ca70b2.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/00/c2/e4/cc50f978ef43e13409ee26b1002dcd61.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/