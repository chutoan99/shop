ating_average":5,"review_count":96,"review_text":"(96)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/f5/d6/73/c5719eb7aecfab6eaaf8855eb78b20ee.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1637,"all_time_quantity_sold":255,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p> </p>\n<p>Femfresh Wash – Dung Dịch Vệ Sinh Phụ Nữ giúp làm sạch mà không gây khô, giúp bạn ngăn ngừa hiện tượng ngứa ngáy, rát buốt do viêm nhiễm. Đặc biệt, sản phẩm này có tác dụng loại bỏ được tất cả mùi hôi trong những ngày 'đèn đỏ', tạo cảm giác thoải mái, dễ chịu ngay sau khi sử dụng rất thích hợp cho con gái tuổi dậy thì.</p>\n<p>Sản phẩm không chứa xà phòng &amp; giúp cân bằng độ pH cho âm đạo, nên giúp làm sạch mà không gây ra cảm giác khô, ngứa, rát &amp; không làm chết các vi khuẩn thường trú có lợi ở vùng kín. Làm dịu da &amp; mang lại mùi thơm nhẹ nhàng, tinh khiết &amp; gợi cảm cho vùng kín của bạn với chiết xuất từ lô hội &amp; hoa cúc La Mã. Đã được kiểm nghiệm phụ khoa (gynaecologically tested) &amp; da liễu (dermatologically tested).</p>\n<p>Femfresh có thể dùng hàng ngày nhưng cá nhân tớ nghĩ nên dùng màu cam dòng Intimate nếu bạn không gặp vấn đề gì đặc biệt với vùng kín.</p>\n<p>Hiện shop có 4 màu:</p>\n<p>- Màu CAM thuộc dòng \"Intimate\" - chiết xuất Lô hội – phù hợp vs nhu cầu làm sạch và nhẹ dịu hàng ngày</p>\n<p>- Màu HỒNG thuộc dòng \"Smoothing Wash - Ultimate\" - Thành phần tăng cường cấp ẩm, chiết xuất cây lô hội và việt quất phù hợp với những làn da bị tổn thương và đang phục hồi</p>\n<p>- Màu XANH BIỂN thuộc dòng \"Active Wash - Ultimate\" - Thành phần tăng cường khả năng làm sạch sâu và thư giãn</p>\n<p>- Màu TRẮNG bằng chiết xuất hoa cúc La Mã và Lô Hội, có mùi hương cực kỳ dịu nhẹ dễ chịu, tạo cảm giác sảng khoái, mát mẻ ngay tức thì.</p>\n<p>Dung tích: fullsize 250ml, minisize 150ml</p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/f5/d6/73/c5719eb7aecfab6eaaf8855eb78b20ee.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f5/d6/73/c5719eb7aecfab6eaaf8855eb78b20ee.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f5/d6/73/c5719eb7aecfab6eaaf8855eb78b20ee.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f5/d6/73/c5719eb7aecfab6eaaf8855eb78b20ee.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f5/d6/73/c5719eb7aecfab6eaaf8855eb78b20ee.png"},{"base_url":"https://salt.tikicdn.com/ts/product/1c/1d/e4/e7c968e333fd32d2d8fbc802850f4202.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/1c/1d/e4/e7c968e333fd32d2d8fbc802850f4202.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/1c/1d/e4/e7c968e333fd32d2d8fbc802850f4202.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1c/1d/e4/e7c968e333fd32d2d8fbc802850f4202.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1c/1d/e4/e7c968e333fd32d2d8fbc802850f4202.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/6a/da/38/0b9d287ddcb53e29dffb7d4a707d821d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/6a/da/38/0b9d287ddcb53e29dffb7d4a707d821d.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/6a/da/38/0b9d287ddcb53e29dffb7d4a707d821d.jpg","position":null,"small_url":"htt