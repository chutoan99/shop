e","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.5,"review_count":30,"review_text":"(30)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/cc/d0/3e/e740bdd2e1573f63b9069bf5e3bbee40.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":764,"all_time_quantity_sold":90,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e-----------------------------------------------------------------\u003cbr /\u003e ĐỘNG CƠ MÁY: 550 ,5 CELL PIN LION 5.0AH\u003cbr /\u003e Đầu khoan: 10mm\u003cbr /\u003e Máy có 3 chức năng : Búa, Khoan, Vít\u003cbr /\u003e Chất liệu vỏ máy: Nhựa cao cấp\u003cbr /\u003e Điện thế pin: 36V\u003cbr /\u003e Loại Pin: Lithium-ion\u003cbr /\u003e Lực siết/mở vít : Cứng (30Nm); Mềm (20Nm)\u003cbr /\u003e Dung lượng pin: 5.0Ah\u003cbr /\u003e Kích thước sản phẩm: 138mm x 79mm x 238mm\u003cbr /\u003e Tốc độ không tải: Cao (0 - 2.000 vòng/phút); Thấp (0 - 800 vòng/phút)\u003cbr /\u003e Sạc tiêu chuẩn có đèn báo tự ngắt khi đầy\u003cbr /\u003e Có chế độ đảo chiều, 2 tốc độ khoan\u003cbr /\u003e Đầu kẹp mũi khoan: 0.8mm - 10mm\u003cbr /\u003e Thiết lập 18 mô-men xoắn cho phép\u003cbr /\u003e Thời lượng 1 pin khi sử dụng liên tục: 2.5h - 3h\u003cbr /\u003e Đèn Led theo máy soi vùng tối khi khoan\u003cbr /\u003e Máy sử dụng Nhông kim loại + Motor ruột đồng 100%\u003cbr /\u003e Màu sắc: XANH/VÀNG\u003cbr /\u003e Trọng lượng sản phẩm: 3,0kg\u003cbr /\u003e Sản xuất tại: Trung Quốc theo Dây chuyền JANPAN\u003cbr /\u003e Phụ kiện bao gồm: 1 hộp máy, 1 thân máy, 1 sạc pin, 1 HOẶC 2 PIN lion , 2 mũi khoan, 1 phiếu bảo hành bán hành, 1 bộ mũi khoan đi kèm (như ảnh)\u003cbr /\u003e2. TIỆN ÍCH VƯỢT TRỘI:\u003cbr /\u003eThế nào được gọi là máy khoan dùng pin tốt ? Đó là chiếc khoan có khả năng đáp ứng tối đa nhu cầu sử dụng của bạn với đầy đủ 5 tiêu chí: chất lượng tốt, độ bền cao; pin máy khoan có dung lượng lớn, tiêu hao năng lượng ít; hiệu suất mạnh mẽ, bền bỉ; thiết kế thông minh, tiện dụng; an toàn tuyệt đối trong suốt quá trình sử dụng; giá hợp túi tiền.\u003cbr /\u003eLợi ích bạn có được khi sở hữu Máy Khoan PIN 36V CÓ BÚA - Made in JAPAN này:\u003cbr /\u003eLàm việc an toàn, hiệu quả cao, giảm bớt được gánh nặng công việc và thời gian lao động.\u003cbr /\u003eCó thể làm việc linh hoạt ở mọi nơi, kể cả những môi trường khắc nghiệt như nhà xưởng sản xuất, công trình xây dựng… đặc biệt là những khu vực thiếu điện, nguồn điện không đảm bảo.\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/cc/d0/3e/5f163a9489e20b953cf3725cb612fd29.png\" alt=\"\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/c3/6a/00/5c4f8706b56671c7562258aaddc32b19.png\" alt=\"\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/bf/b3/7b/3acffc00974cfb9b729b95471f77f158.png\" alt=\"\" width=\"750\" height=\"876\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/76/0c/f9/a17a6f4b34659ad372600bca2b9c71f8.png\" alt=\"\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicd