nd_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.7,"review_count":19,"review_text":"(19)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/84/6d/32/81899ccbd3ac7da4370db0ce0e14ce8a.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1134,"all_time_quantity_sold":67,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003e\u003cspan id=\"Doi_net_ve_thuong_hieu_Ogx\"\u003e\u003cstrong\u003eĐôi nét về thương hiệu Ogx\u003c/strong\u003e\u003c/span\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003eOgx\u003c/strong\u003e là thương hiệu nổi tiếng của Mỹ với các sản phẩm làm đẹp đơn giản, hiệu quả từ thiên nhiên. Các sản phẩm của Ogx được chiết xuất 100% từ thảo dược thiên nhiên, không chứa hóa chất.\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eBộ dầu gội dầu xả chống rụng tóc và mọc tóc Organix Biotin \u0026amp; Collagen\u003c/strong\u003e là một trong những sản phẩm được yêu thích nhất của Oxg, nhận được hàng ngàn phản hồi tích cực của khách hàng trên trang chính của Oxg và các trang chuyên về sản phẩm làm đẹp như Amazon, MakeupAlley…\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003e\u003cspan id=\"Cong_dung_cua_dau_goi_biotin_collagen_tim\"\u003e\u003cstrong\u003eCông dụng của dầu gội biotin collagen tím\u003c/strong\u003e\u003c/span\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eKích thích quá trình mọc tóc, giảm rụng tóc\u003c/li\u003e\n\u003cli\u003eCung cấp độ ẩm và bổ sung các axit amin, khoáng chất cần thiết cho tóc giúp tóc khỏe, xuông mượt\u003c/li\u003e\n\u003cli\u003eBảo vệ tóc khỏi những tác động của môi trường\u003c/li\u003e\n\u003cli\u003eGiảm tình trạng ngứa ngáy da đầu gây cảm giác khó chịu, gàu và vảy nấm.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003c/p\u003e\n\u003cdiv class=\"n\"\u003e\n\u003ch3\u003e\u003cspan id=\"Thanh_phan_cua_biotin_dau_goi\"\u003e\u003cstrong\u003eThành phần của biotin dầu gội\u003c/strong\u003e\u003c/span\u003e\u003c/h3\u003e\n\u003c/div\u003e\n\u003cdiv class=\"t\"\u003e\n\u003cul\u003e\n\u003cli\u003eVitamin B7 , Collagen, Hydrolyzed wheat protrein cùng các axit amin và khoáng chất cần thiết cho tóc.\u003c/li\u003e\n\u003cli\u003eSản phẩm không chứa chất bảo quản, không chứa chất tạo bọt sulfates ( chất tạo bọt có khả năng gây ung thư).\u003c/li\u003e\n\u003cli\u003eThành phần chứa trong sản phẩm đạt tiêu chuẩn của cục quản lí Thực phẩm và Dược phẩm Hoa Kỳ.\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/div\u003e\n\u003ch3\u003e\u003cspan id=\"Huong_dan_su_dung_dau_goi_biotin_385ml\"\u003e\u003cstrong\u003eHướng dẫn sử dụng dau goi biotin 385ml\u003c/strong\u003e\u003c/span\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eThoa dầu gội lên tóc, sau đó gội sạch với nước\u003c/li\u003e\n\u003cli\u003eSau đó, thoa dầu xả lên tóc chờ khoảng 3-5 phút rồi xả sạch với nước\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/84/6d/32/81899ccbd3ac7da4370db0ce0e14ce8a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/84/6d/32/81899ccbd3ac7da4370db0ce0e14ce8a.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/84/6d/32/81899ccbd3ac7da4370db0ce0e14ce8a.jpg