":4.8,"review_count":12,"review_text":"(12)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/20/68/60/11da209de0912136dfea2714e8f182a2.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":0,"all_time_quantity_sold":35,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch1 class=\"product-title product_title entry-title\"\u003eMáy nước nóng Ferroli DIVO SDN, hiển thị nhiệt độ\u003c/h1\u003e\n\u003cdiv class=\"product-short-description\"\u003e\n\u003cdiv class=\"product-description__webyclip-thumbnails\"\u003e\n\u003cdiv class=\"prod_content\"\u003e\n\u003cdiv class=\"prod_details\"\u003e\n\u003cul class=\"prd-attributesList ui-listBulleted js-short-description\"\u003e\n\u003cli class=\"\"\u003eThiết kế mỏng, nhẹ, sang trọng\u003c/li\u003e\n\u003cli class=\"\"\u003eCông nghệ đỉnh cao\u003c/li\u003e\n\u003cli class=\"\"\u003eThanh đốt bằng đồng nguyên chất\u003c/li\u003e\n\u003cli class=\"\"\u003eChế độ bảo vệ an toàn đa cấp\u003c/li\u003e\n\u003cli class=\"\"\u003eMàn hình LED hiển thị\u003c/li\u003e\n\u003cli class=\"\"\u003eTiêu chuẩn an toàn nghiêm ngặt\u003c/li\u003e\n\u003cli class=\"\"\u003eTiết kiệm điện\u003c/li\u003e\n\u003cli class=\"\"\u003ePhụ kiện đi kèm cao cấp\u003c/li\u003e\n\u003cli class=\"\"\u003eDễ dàng lắp đặt\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003eThiết kế siêu mỏng, gọn nhẹ tiết kiệm diện tích\u003c/h3\u003e\n\u003cp\u003eMáy nước nóng Ferroli DIVO SDN được thiết kế với kiểu dáng đẹp mắt, gọn nhẹ, siêu mỏng, tiết kiệm không gian lắp đặt máy. Công suất 4.5 KW bảo đảm hiểu quả làm nóng nhanh tức thì, giúp người dùng không cần chờ đợi.\u003c/p\u003e\n\u003cp\u003e\u003ca class=\"preventdefault\" href=\"https://www.thegioididong.com/images/1962/68558/ferroli-divo-sdn-45kw-trang-99-1.jpg\"\u003e\u003cimg class=\" ls-is-cached lazyloaded\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Máy nước nóng Ferroli DIVO SDN\" src=\"https://cdn.tgdd.vn/Products/Images/1962/68558/ferroli-divo-sdn-45kw-trang-99-1.jpg\" alt=\"Máy nước nóng Ferroli DIVO SDN\" width=\"750\" height=\"562\" data-src=\"https://cdn.tgdd.vn/Products/Images/1962/68558/ferroli-divo-sdn-45kw-trang-99-1.jpg\" /\u003e\u003c/a\u003e\u003c/p\u003e\n\u003ch3\u003eCơ chế làm nóng trực tiếp nhanh chóng, dễ sử dụng\u003c/h3\u003e\n\u003cp\u003e\u003ca class=\"preventdefault\" href=\"https://www.thegioididong.com/images/1962/68558/Slider/vi-vn-ferroli-divo-sdn-45kw-trang-1.jpg\"\u003e\u003cimg class=\" ls-is-cached lazyloaded\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Làm nóng trực tiếp - Máy nước nóng Ferroli DIVO SDN 4.5 kW\" src=\"https://cdn.tgdd.vn/Products/Images/1962/68558/Slider/vi-vn-ferroli-divo-sdn-45kw-trang-1.jpg\" alt=\"Làm nóng trực tiếp - Máy nước nóng Ferroli DIVO SDN 4.5 kW\" width=\"750\" height=\"416\" data-src=\"https://cdn.tgdd.vn/Products/Images/1962/68558/Slider/vi-vn-ferroli-divo-sdn-45kw-trang-1.jpg\" /\u003e\u003c/a\u003e\u003c/p\u003e\n\u003ch3\u003eThanh điện trở bằng đồng nguyên chất \u003c/h3\u003e\n\u003cp\u003eThanh nhiệt làm bằng đồng nguyên chất, độ bền cao có khả năng làm nóng nhanh chóng đồng thời tiết kiệm điện năng tiêu thụ.\u003c/p\u003e\n\u003cp\u003e\u003ca class=\"preventdefault\" href=\"https://www.thegioididong.com/images/1962/68558/ferroli-divo-sdn-45kw-trang-99-6.jpg\"\u003e\u003cimg class=\" ls-is-cached lazyloaded\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Thanh điện trở bằng đồng\" src=\"https://cdn.tgdd.vn/Products/Images/1962/68558/ferroli-divo-sdn-45kw-trang-99-6.jpg\" alt=\"Thanh điện trở bằng đồng\" width=\"723\" height=\"464\" data-src=\"https://cdn.tgdd.vn/Products/Images/1962/68558/ferroli-divo-sdn-45kw-trang-99-6.jpg\" /\u003e\u003c/a\u003e\u003c/p\u003e\n\u003ch3\u003eChức năng chống giật điện (ELCB)\u003c/h3\u003e\n\u003cp\u003eĐể đảm bảo an toàn cho người sử dụng, máy nước nóng Ferroli có tích hợp chức năng chống giật điện, khi phát hiện rò rỉ điện vượt quá 15 mA, công tắt tiết lưu sẽ tự động ngắt mạch điện tức thời. Bạn hoàn toàn có thể yên tâm sử dụng máy nước nóng mà không phải quá lo lắng về các sự cố về điện.\u003c/p\u003e\n\u003ch3\u003e\u003ca class=\"preventdefault\" href=\"https://www.thegioididong.com/images/1962/68558/ferroli-divo-sdn-45kw-trang-99-2.jpg\"\u003e\u003cimg class=\" lazyloaded\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Chức năng chống giật điện (ELCB)\" src=\"https://cdn.tgdd.vn/Products/Images/1962/68558/ferroli-divo-sdn-45kw-trang-99-2.jpg\" alt=\"Chức năng chống giật điện (ELCB)\" width=\"750\" height=\"562\" data-src=\"https://cdn.tgdd.vn/Products/Images/1962/68558/ferroli-divo-sdn-45kw-trang-99-2.jpg\" /\u003e\u003c/a\u003e\u003c/h3\u003e\n\u003ch3\u003eCảm biến nhiệt kết hợp cảm biến nước\u003c/h3\u003e\n\u003cp\u003eHệ thống cảm biến nhiệt trên máy nước nóng sẽ tự động ngắt điện khi nhiệt độ nước quá nóng, đảm bảo an toàn tránh gây bỏng cho người dùng. Cảm biến nước trên máy nước nóng Ferroli, hay còn gọi cảm biến dòng chảy, sẽ tự động điều chỉnh công suất sao cho phù hợp với lượng nước và áp lực nước vào, bảo đảm máy hoạt động trong tình trạng tốt nhất, tăng tuổi thọ sử dụng.\u003c/p\u003e\n\u003cp\u003e\u003ca class=\"preventdefault\" href=\"https://www.thegioididong.com/images/1962/68558/ferroli-divo-sdn-45kw-trang-99-3.jpg\"\u003e\u003cimg class=\" lazyloaded\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Cảm biến nhiệt kết hợp cảm biến nước\" src=\"https://cdn.tgdd.vn/Products/Images/1962/68558/ferroli-divo-sdn-45kw-trang-99-3.jpg\" alt=\"Cảm biến nhiệt kết hợp cảm biến nước\" width=\"750\" height=\"510\" data-src=\"https://cdn.tgdd.vn/Products/Images/1962/68558/ferroli-divo-sdn-45kw-trang-99-3.jpg\" /\u003e\u003c/a\u003e\u003c/p\u003e\n\u003ch3\u003eMàn hình hiển thị LED\u003c/h3\u003e\n\u003cp\u003eMáy nước nóng Ferroli DIVO SDN được trang bị màn hình LED hiển thị rõ ràng, trực quan mức nhiệt độ, tình trạng hoạt động của máy. Với tính năng này, người dùng có thể dễ dàng quan sát và điều chỉnh máy sao cho phù hợp nhất với nhu cầu sử dụng, tránh quá nóng hoặc quá lạnh.\u003c/p\u003e\n\u003cp\u003e\u003ca class=\"preventdefault\" href=\"https://www.thegioididong.com/images/1962/68558/ferroli-divo-sdn-45kw-trang-99-4.jpg\"\u003e\u003cimg class=\" lazyloaded\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Màn hình hiển thị LED\" src=\"https://cdn.tgdd.vn/Products/Images/1962/68558/ferroli-divo-sdn-45kw-trang-99-4.jpg\" alt=\"Màn hình hiển thị LED\" width=\"750\" height=\"411\" data-src=\"https://cdn.tgdd.vn/Products/Images/1962/68558/ferroli-divo-sdn-45kw-trang-99-4.jpg\" /\u003e\u003c/a\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cdiv class=\"product-description__webyclip-thumbnails\"\u003e\n\u003cdiv class=\"prod_content\"\u003e\n\u003cdiv class=\"prod_details\"\u003e\n\u003cp\u003e\u003cstrong\u003eCHẾ ĐỘ BẢO VỆ AN TOÀN ĐA CẤP\u003c/strong\u003e\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cp\u003e\u003cimg class=\"productlazyimage lazy-load-active\" style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://vn-live.slatic.net/v2/resize/products/S-100065794-e77d71cbcbf2cc48948fd3d75f41c61f.jpg\" width=\"485\" height=\"341\" data-src=\"https://vn-live.slatic.net/v2/resize/products/S-100065794-e77d71cbcbf2cc48948fd3d75f41c61f.jpg\" data-original=\"https://vn-live.slatic.net/v2/resize/products/S-100065794-e77d71cbcbf2cc48948fd3d75f41c61f.jpg\" /\u003e\u003c/p\u003e\n\u003cp\u003eCông nghệ làm nóng tách điện và nước riêng biệt, chế độ bảo vệ tiếp đất an toàn, chế độ bảo vệ rò rỉ độc lập, chế độ tự phát hiện lỗi, chế độ bảo vệ chống quá nhiệt, chống cháy khô, chế độ bảo vệ khi nước trong bình thấp, bộ lọc nâng cao chất lượng nước và kéo dài tuổi thọ cho thiết bị.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCÔNG TẮC KIỂM SOÁT DÒNG CHẢY\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"productlazyimage lazy-load-active\" style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://vn-live.slatic.net/v2/resize/products/S-100065794-7ca21b3cfc1483f13be4b77a635a4230.jpg\" alt=\"\" width=\"485\" height=\"341\" data-src=\"https://vn-live.slatic.net/v2/resize/products/S-100065794-7ca21b3cfc1483f13be4b77a635a4230.jpg\" data-original=\"https://vn-live.slatic.net/v2/resize/products/S-100065794-7ca21b3cfc1483f13be4b77a635a4230.jpg\" /\u003e\u003c/p\u003e\n\u003cp\u003eKiểm soát dòng chảy của nước, đảm bảo lượng nước đều và liên tục trong quá trình sử dụng. Chỉ một thao tác mở-tắt công tắc, người sử dụng có thể dễ dàng điều chỉnh mở-tắt hoạt động của máy nóng lạnh trực tiếp (có dòng nước chảy qua, máy nóng lạnh trực tiếp mới hoạt động và ngược lại)\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTHANH ĐỐT BẰNG ĐỒNG NGUYÊN CHẤT HIỆU SUẤT CAO, TIẾT KIỆM ĐIỆN\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"productlazyimage lazy-load-active\" style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://vn-live.slatic.net/v2/resize/products/S-100065794-c22dd52dd15da2b5391cccb26a0b48e4.jpg\" alt=\"\" width=\"569\" height=\"350\" data-src=\"https://vn-live.slatic.net/v2/resize/products/S-100065794-c22dd52dd15da2b5391cccb26a0b48e4.jpg\" data-original=\"https://vn-live.slatic.net/v2/resize/products/S-100065794-c22dd52dd15da2b5391cccb26a0b48e4.jpg\" /\u003e\u003c/p\u003e\n\u003cdiv\u003e\u003cstrong\u003e \u003c/strong\u003e\u003c/div\u003e\n\u003cp\u003eThanh đốt hiệu suất cao bằng đồng tinh khiết đảm bảo độ bền cao, làm nóng siêu tốc. Bình chứa bằng sợi thủy tinh, giữ nhiệt tốt, tiết kiệm điện năng.\u003c/p\u003e\n\u003cdiv\u003e\u003cstrong\u003eMÀN HÌNH LED HIỂN THỊ ĐIỀU CHỈNH NHIỆT\u003c/strong\u003e\u003c/div\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"productlazyimage lazy-load-active\" style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://vn-live.slatic.net/v2/resize/products/S-100065794-af82cc5a8a117141fd40731e7ca08cb3.jpg\" alt=\"\" width=\"485\" height=\"371\" data-src=\"https://vn-live.slatic.net/v2/resize/products/S-100065794-af82cc5a8a117141fd40731e7ca08cb3.jpg\" data-original=\"https://vn-live.slatic.net/v2/resize/products/S-100065794-af82cc5a8a117141fd40731e7ca08cb3.jpg\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eMàn hình LED hiển thị nhiệt độ chính xác, rõ ràng. Người sử dụng có thể dễ dàng lựa chọn nhiệt độ phù hợp, tránh nhiệt độ quá nóng gây bỏng da hoặc chưa đủ nóng để có thể sử dụng.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTAY SEN ĐI KÈM 3 CHỨC NĂNG\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://noithathuyngoc.com/wp-content/uploads/2021/04/binh-nuoc-nong-ferroli-divo-SDN-510x614-1.jpg\" width=\"510\" height=\"614\" /\u003e\u003c/p\u003e\n\u003cdiv\u003e\u003cstrong\u003e \u003c/strong\u003e\u003c/div\u003e\n\u003cp\u003eTay sen với 3 chức năng: giúp điều chỉnh lưu lượng theo nhu cầu, mạ crom sang trọng, thiết kế hiện đại, dễ lau rửa, vệ sinh an toàn cho sức khỏe\u003c/p\u003e\n\u003cdiv\u003e\u003cstrong\u003eVAN ĐIỀU CHỈNH LƯU LƯỢNG THUẬN TIỆN, ĐỘ BỀN CAO\u003c/strong\u003e\u003c/div\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"http://tikicdn.com/media/catalog/product/v/1/v18.u2751.d20161201.t124721.930431.jpg\" alt=\"Máy Nước Nóng Trực Tiếp Không Bơm  Ferroli Divo SDN 4.5S\" width=\"548\" height=\"365\" /\u003e\u003c/p\u003e\n\u003cp\u003eVan điều chỉnh lưu lượng đặc biệt, dễ dàng điề