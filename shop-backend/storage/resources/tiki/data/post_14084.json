nh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/88/ac/ce/9b53e14d0c828a902bb11d22fc9eaf5d.jpeg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/88/ac/ce/9b53e14d0c828a902bb11d22fc9eaf5d.jpeg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/88/ac/ce/9b53e14d0c828a902bb11d22fc9eaf5d.jpeg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/88/ac/ce/9b53e14d0c828a902bb11d22fc9eaf5d.jpeg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/88/ac/ce/9b53e14d0c828a902bb11d22fc9eaf5d.jpeg"},{"base_url":"https://salt.tikicdn.com/ts/product/87/91/cc/03ce08ffb8e1fe26e1d3f51b5721ce4a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/87/91/cc/03ce08ffb8e1fe26e1d3f51b5721ce4a.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/87/91/cc/03ce08ffb8e1fe26e1d3f51b5721ce4a.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/87/91/cc/03ce08ffb8e1fe26e1d3f51b5721ce4a.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/87/91/cc/03ce08ffb8e1fe26e1d3f51b5721ce4a.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/0e/2d/c5/204549e237f24e686029c55e28a4aa48.jpeg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0e/2d/c5/204549e237f24e686029c55e28a4aa48.jpeg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/0e/2d/c5/204549e237f24e686029c55e28a4aa48.jpeg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0e/2d/c5/204549e237f24e686029c55e28a4aa48.jpeg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0e/2d/c5/204549e237f24e686029c55e28a4aa48.jpeg"},{"base_url":"https://salt.tikicdn.com/ts/product/88/27/e1/21b7bada7b6abb737449520691d38147.jpeg","is_gallery":true,"label"