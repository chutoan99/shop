,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":3,"review_text":"(3)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/26/1d/96/d7d5fef72a6eb21f8ef1c8d0ec5f4831.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":0,"all_time_quantity_sold":32,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003e\u003cstrong\u003eGiới Thiệu\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003e\u003cstrong\u003eDung Dịch Giặt Quần Áo Cho Bé D-Nee - Túi 600ml (TÍM)  \u003c/strong\u003evới hương thơm nhẹ nhàng như ánh nắng mặt trời cùng độ pH trung tính không làm tổn thương da tay. Sản phẩm giúp làm sạch quần áo em bé nhờ công thức đặc biệt giúp thổi bay vết bẩn hiệu quả. Dung tích 3000ml giúp mẹ tiết kiệm tối đa trong quá trình chăm sóc vệ sinh bé.\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eDung dịch có độ pH trung tính nên rất mềm dịu với da tay bạn và không làm hư hại đến quần áo của bé.\u003c/li\u003e\n\u003cli\u003eCó hương thơm rất nhẹ, dành cho trẻ sơ sinh và những người bị dị ứng với mùi hương, giúp quần áo bé yêu luôn thơm tho suốt cả ngày.\u003c/li\u003e\n\u003cli\u003eĐược chế tạo bởi công thức đặc biệt chứa Sodium Lauryl Sulfate, Sodium Laureth Sulfate giúp đánh bật các vết bẩn và Polyalate sẽ ngăn chặn vết bẩn quay trở lại mà không gây kích ứng cho làn da nhạy cảm của bé.\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003eThành Phần \u0026amp; Công Dụng\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eSodium Lauryl Sulfate\u003c/li\u003e\n\u003cli\u003eSodium Laureth Sulfate\u003c/li\u003e\n\u003cli\u003ePolyacrylate\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eSodium Lauryl Sulfate Sodium Laureth Sulfate Polyacrylate Nước giặt có chứa Sunfate đây là chất tẩy rửa để làm sạch quần áo. Các sản phẩm của D-nee được trải qua quá trình sản xuất nghiêm ngặt để đạt tiêu chuẩn sử dụng cho TRẺ SƠ SINH không gây kích ứng \u0026amp; độ pH trung tính bảo vệ da tay mẹ khi giặt cũng như không làm hư quần áo.\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eĐặc Điểm Nổi Bật\u003c/strong\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003eNước giặt D-nee được nhập khẩu chính ngạch bởi Công ty TNHH DV TM \u0026amp; XNK Đại Thịnh\u003c/strong\u003e\u003c/li\u003e\n\u003cli\u003eVới xuất xứ từ Thái Lan có thành phần tự nhiên với công thức đặc biệt giúp đánh bật các vết bẩn và ngăn ngừa vi khuẩn trên quần áo. Độ pH trung tính an toàn cho da với hương thơm dịu nhẹ không gây kích ứng cho da.\u003c/li\u003e\n\u003cli\u003eNước giặt D-nee có hoạt chất tẩy rửa nhẹ nhàng thấm sâu vào sợi vải giúp đánh bay các vết bẩn thông thường trên quần áo bé. Có độ pH và các thành phần làm sạch được chọn lọc kỹ để đảm bảo không gây kích ứng trên da bé.\u003c/li\u003e\n\u003cli\u003eTrên thị trường hiện tại có nhiều sản phẩm nhãn hiệu D-nee không nhãn mác, không rõ nguồn gốc. Người mua hàng cứ tin vào người bán, còn người bán tin vào nhà cung cấp.\u003c/li\u003e\n\u003cli\u003eSao phải đặt niềm tin, và an toàn con bạn của mình vào người khác. Hãy chọn sản phẩm D-nee có tem nhãn phụ của Công ty TNHH DV TM \u0026amp; XNK Đại Thịnh. Không phải ngẫu nhiên mà các Siêu thị Mẹ và Bé cũng như các Hệ thống Siêu thị lớ đều chọn sản phẩm D-nee có tem phụ của Công ty Đại Thịnh bởi vì hàng có nguồn gốc rõ ràng, có tem nhãn phụ đầy đủ.\u003c/li\u003e\n\u003cli\u003eHãy là người tiêu dùng thông thái để lựa chọn đúng sản phẩm cho Bé cưng nhà mình nhé Mẹ ơi!\u003c/li\u003e\n\u003cli\u003eHiện tại, Baby Thiên Phúc chỉ cung cấp các Sản phẩm thương hiệu D-nee do Công ty TNHH DV TM \u0026amp; XNK Đại Thịnh nhập khẩu và phân phối nhằm đảm bảo chất lượng tốt nhất cho Bé yêu!\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eThông Tin Sản Phẩm\u003c/strong\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eThương hiệu: D-nee đây là một thương hiệu nổi tiếng chuyên các sản phẩm an toàn cho bé.\u003c/li\u003e\n\u003cli\u003eXuất xứ: Thái Lan. (Có dán tem phụ tiếng Việt của Công ty Đại Thịnh.)\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eQuy cách đóng gói: túi 600 ml\u003c/strong\u003e\u003c/li\u003e\n\u003cli\u003eHạn sử dụng: xem chi tiết trên bao bì.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eHướng Dẫn Sử Dụng\u003c/strong\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eHoà ½ nắp chai hoặc 15ml nước giặt quần áo trẻ em D-Nee với 2 lít nước\u003c/li\u003e\n\u003cli\u003eNgâm trong vài phút.\u003c/li\u003e\n\u003cli\u003eGiặt quần áo lại với nước sạch.\u003c/li\u003e\n\u003cli\u003eVắt ráo nước và mang quần áo bé yêu đi phơi\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cem\u003eLƯU Ý: MẪU MÃ CÓ THỂ KHÁC TÙY TỪNG THỜI ĐIỂM NHẬP HÀNG. NHƯNG KHÔNG GIẢM ĐI CHẤT LƯỢNG SẢN PHẨM.\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/26/1d/96/563c337a8b5a7169534f2a0bdb24e2e2.jpg\" alt=\"\" width=\"750\" height=\"1000\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/26/1d/96/d7d5fef72a6eb21f8ef1c8d0ec5f4831.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/26/