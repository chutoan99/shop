//salt.tikicdn.com/cache/280x280/ts/product/fd/64/48/bd4ee2f8a6df399f7b3a108a6554815b.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2022,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e\u003cstrong\u003e\u003cspan style=\"box-sizing: border-box;\"\u003eGiận\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003eKhi ta giận, khi một ai đó làm cho ta giận, ta phải trở về với thân tâm và chăm sóc cơn giận của mình. Không nên nói gì hết. Không nên làm gì hết. Khi đang giận mà nói năng hay hành động thì chỉ gây thêm đổ vỡ mà thôi thế là không khôn ngoan. Phải trở về dập tắt lửa trước đã\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003eGiận là một cuốn sách hay của Thiền sư Thích Nhất Hạnh, nó mở ra cho ta những khả năng kỳ diệu, nhưng lại rất dễ thực hành để ta tự mình từng bướát khỏi cơn giận và sống đẹp với xã hội quanh mình.\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003eGiận được xuất bản tại Hoa Kỳ ngày 10.9.2001, trước biến cố 11.9.2001 có một ngày. Vì thế Giận đã trở thành quyển sách bán chạy nhất Hoa Kỳ - 50.000 bản mỗi tuần - trong vòng 9 thá\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003eTại Hàn Quốc, quyển sách này đã bán được 1 triệu bản trong vòng 11 tháng. Rất nhiều độc giả nhờ đọc sách này mà đã điều phục được tâm mình, sử dụng ái ngữ lắng nghe để hoà giải với người thân, đem lại hạnh phúc trong gia đình và trong cộng đồng của họ.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/fd/64/48/bd4ee2f8a6df399f7b3a108a6554815b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/fd/64/48/bd4ee2f8a6df399f7b3a108a6554815b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/fd/64/48/bd4ee2f8a6df399f7b3a108a6554815b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fd/64/48/bd4ee2f8a6df399f7b3a108a6554815b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fd/64/48/bd4ee2f8a6df399f7b3a108a6554815b.jpg"}],"warranty_policy":null,"authors":[{"id":3840,"name":"Thích Nhất Hạnh","slug":"thich-nhat-hanh"}],"current_seller":{"id":295057,"sku":"2408063862097","name":"HỆ THỐNG NHÀ SÁCH ABC","link":"https://tiki.vn/cua-hang/he-thong-nha-sach-abc","logo":"https://vcdn.tikicdn.com/ts/seller/98/3d/ff/cec0ba0eaa575634616ab4605fccbe6d.jpg","price":135000,"product_id":"274771800","store_id":282399,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[{"id":256173,"name":"Thiện Ngôn Book","link":"https://tiki.vn/cua-hang/thien-ngon-book","logo":"01/28/f3/e22ecef32f76b31aac9d42bd2a279c12.jpg","price":108000,"product_id":"176520941","store_id