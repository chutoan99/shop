ull,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4,"review_count":6,"review_text":"(6)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/media/catalog/product/4/1/4110235985280_s_01.d20170615.t164838.462361.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2647,"all_time_quantity_sold":51,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003ciframe src=\"//www.youtube.com/embed/ZTEhO04R8UY\" width=\"750\" height=\"421\" allowfullscreen=\"allowfullscreen\"\u003e\u003c/iframe\u003e\u003c/p\u003e\u003cul\u003e_x000D_\n\u003cli\u003e \u003cstrong\u003e Bộ 3 Hộp Thủy Tinh Glasslock 400ml Và Túi Giữ Nhiệt Lunch Set 3 \u003c/strong\u003e giúp bạn mang theo thức ăn khi đi làm, đi học, đến bệnh, đi dã ngoại… thật tiện lợi. \u003c/li\u003e_x000D_\n\u003cli\u003e Túi giữ nhiệt giúp giữ ấm thức ăn, cho bạn những bữa ăn ngon miệng hơn. Đồng thời, túi có tay xách và khóa kéo sẽ bảo quản         thức ăn thật tốt và giúp bạn xách, cầm dễ dàng. \u003c/li\u003e_x000D_\n\u003cli\u003e Áp dụng công nghệ kín hơi, hút chân không cùng thiết kế gioăng silicon, nắp đậy 4 khớp khóa kín, hộp đựng giúp bảo quản         thực phẩm, thức ăn bên trong được lâu, không tiếp xúc với không khí, chống lại sự xâm nhập của vi khuẩn có hại. Vì thế, thức         ăn được bảo đảm vệ sinh, giữ nguyên hương vị, chất dinh dưỡng, bảo quản được lâu hơn. \u003c/li\u003e_x000D_\n\u003cli\u003e Hộp đựng làm từ chất liệu thủy tinh cường lực nên chắc chắn, sử dụng bền, lâu, khó vỡ khi rơi ở độ cao dưới 1,5m. Hộp đựng         cũng không bị vỡ, nứt khi thay đổi nhiệt độ đột ngột. Đồng thời, thủy tinh làm từ cát tự nhiên, không chứa hóa chất BPA độc         hại, vì thế sản phẩm an toàn cho sức khỏe, tạo sự yên tâm cho người sử dụng. \u003c/li\u003e_x000D_\n\u003cli\u003e Hộp thủy tinh chịu được nhiệt độ đến 120 độ C. \u003c/li\u003e_x000D_\n\u003cli\u003e Nắp hộp làm bằng nhựa cao cấp, có khả năng chịu nhiệt, có thể đậy nắp khi thức ăn còn nóng. \u003c/li\u003e_x000D_\n\u003cli\u003e Bạn có thể sử dụng hộp thủy tinh trong nhiều môi trường như: lò vi sóng, tủ lạnh, tủ đông, máy rửa chén. \u003c/li\u003e_x000D_\n\u003cli\u003e Hộp được thiết kế với kiểu dáng vuông vức, cùng chất liệu thủy tinh trong suốt, tạo nên vẻ đẹp sang trọng cho sản phẩm. \u003c/li\u003e_x000D_\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/media/catalog/product/4/1/4110235985280_s_01.d20170615.t164838.462361.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/4/1/4110235985280_s_01.d20170615.t164838.462361.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/4/1/4110235985280_s_01.d20170615.t164838.462361.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/4/1/4110235985280_s_01.d20170615.t164838.462361.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/4/1/4110235985280_s_01.d20170615.t164838.462361.jpg"},{"base_url":"https://salt.tikicdn.com/media/catalog/product/4/1/4110235985280_s_02.d20170615.t164842.210739.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/4/1/4110235985280_s_02.