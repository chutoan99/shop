null,"icon_width":0,"icon_height":0,"text_color":"#FFF0F1","background_color":"#D93843","href":null,"text":"9.9"},{"placement":"pdp_badge","code":"is_hero","type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":true,"return_reason":"any_reason"}},"discount":90000,"discount_rate":38,"rating_average":4.5,"review_count":51,"review_text":"(51)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/67/00/cb/b455b20e37a02d6817fc7e42f4534a37.png","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1011,"all_time_quantity_sold":180,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eDầu gội nam Bergami hương nước hoa Shocking Man - Hương nước hoa nam tính - Lịch lãm - Sạch gàu vượt trội\u003c/p\u003e\n\u003cp\u003e---------------------------\u003c/p\u003e\n\u003cp\u003eTHƯƠNG HIỆU BERGAMI\u003c/p\u003e\n\u003cp\u003eThương hiệu BERGAMI đã được đăng ký với Bộ Công Thương, tuân thủ đầy đủ các tiêu chuẩn an toàn và phù hợp với mọi loại da. Mọi thông tin về sản phẩm - xuất xứ - sản xuất đều rõ ràng, minh bạch.\u003c/p\u003e\n\u003cp\u003eDẦU GỘI NAM BERGAMI SHOCKING MAN,HƯƠNG NƯỚC HOA, DẦU GỘI CAO CẤP ĐỘT PHÁ GÀU, HẾT NGỨA, DƯỠNG TÓC THƠM LÂU 330ML\u003c/p\u003e\n\u003cp\u003eGiới thiệu: DẦU GỘI BERGAMI SHOCKING MAN là siêu phẩm SẠCH GÀU đậm mùi hương NAM TÍNH dành riêng cho nam giới hiện đại, không gây kích ứng, hương thơm lâu phai. Dầu gội đầu nam Bergami Shocking Man là sự lựa chọn hoàn hảo cho những chàng trai yêu thích sự nam tính, phong độ. Mang trong mình hương thơm tươi mát đầy lôi cuốn từ nước hoa Pháp. Không chỉ đem lại những giây phút thư giãn thật dễ chịu khi tắm gội, mà hương thơm lưu lại còn khiến cho các chàng trai toát lên được phong cách lịch lãm, thỏa sức khởi bật nét nam tính mạnh mẽ!\u003c/p\u003e\n\u003cp\u003eCông dụng:\u003c/p\u003e\n\u003cp\u003e- Dầu gội nam Shocking Man giúp ĐÁNH BAY GÀU\u003c/p\u003e\n\u003cp\u003e- Là dòng sản phẩm chăm sóc tóc cao cấp đến từ thương hiệu nhà Bergami.\u003c/p\u003e\n\u003cp\u003e- Nhờ chiết xuất thành phần thiên nhiên từ dừa, gừng lành tính sẽ tấn công và phá huỷ những nguyên nhân gây nên tình trạng gàu, vảy gàu kéo dài trên da đầu, không gây kích ứng, không gây khô rát.\u003c/p\u003e\n\u003cp\u003e- Công thức đột phá X2 sức mạnh sạch gàu vượt trội, nhờn ngứa, nuôi dưỡng da đầu và giúp tóc chắc khỏe, mềm mượt.\u003c/p\u003e\n\u003cp\u003eTHÔNG TIN CHI TIẾT\u003c/p\u003e\n\u003cp\u003eTên sản phẩm: Dầu gội nam Bergami hương nước hoa Shocking Man\u003c/p\u003e\n\u003cp\u003eXuất xứ: Việt Nam.\u003c/p\u003e\n\u003cp\u003eThương hiệu: BERGAMI.\u003c/p\u003e\n\u003cp\u003eMàu sắc: Xanh dương.\u003c/p\u003e\n\u003cp\u003eThành phần: Chiết xuất thành phần thiên nhiên từ dừa, gừng tươi ẽ tấn công và phá huỷ những nguyên nhân gây nên tình trạng gàu, vảy gàu kéo dài trên da đầu, không gây kích ứng, không gây khô rát. Loại da phù hợp: Mọi loại da.\u003c/p\u003e\n\u003cp\u003eHướng dẫn sử dụng:\u003c/p\u003e\n\u003cp\u003e- Bước 1: Làm ướt đều tóc trước khi gội.\u003c/p\u003e\n\u003cp\u003e- Bước 2: Cho 1 lượng vừa đủ dầu gội vào tay và tạo bọt trước khi cho lên tóc.\u003c/p\u003e\n\u003cp\u003e- Bước 3: Dùng các đầu ngón tay để massage da đầu.\u003c/p\u003e\n\u003cp\u003e- Bước 4: Xả nước thật kỹ.\u003c/p\u003e\n\u003cp\u003eHướng dẫn bảo quản: Nơi thoáng mát, độ ẩm, nhiệt độ vừa phải. Tránh nơi nhiệt độ quá cao (ánh nắng) hoặc quá thấp (trong ngăn đá) vì như vậy sẽ gây phân tách các thành phần, gây nên phản ứng có hại cho da đầu.\u003c/p\u003e\n\u003cp\u003eNgày sản xuất/ Hạn sử dụng:\u003c/p\u003e\n\u003cp\u003e- Ngày sản xuất: Xem trên Bao bì. - Hạn sử dụng: 36 tháng kể từ ngày sản xuất.\u003c/p\u003e\n\u003cp\u003e#daugoi #daugoidau #daugoidaunam #bergami #shocking #man #daugoidaunuochoa #daugoidauhuongnuochoa #daugoidauluuhuong #daugoidauthomlau\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/67/00/cb/b455b20e37a02d6817fc7e42f4534a37.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/67/00/cb/b455b20e37a02d6817fc7e42f4534a37.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/67/00/cb/b455b20e37a02d6817fc7e42f4534a37.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/67/00/cb/b455b20e37a02d6817fc7e42f4534a37.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/67/00/cb/b455b20e37a02d6817fc7e42f4534a37.png"},{"base_url":"https://salt.tikicdn.com/ts/product/6d/b1/9d/d622c692c51a17ff6ebac2d302edf676.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/6d/b1/9d/d622c692