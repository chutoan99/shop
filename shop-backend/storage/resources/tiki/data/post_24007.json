n.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":206000,"discount_rate":27,"rating_average":4.7,"review_count":12,"review_text":"(12)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/f6/f4/ce/8771c9568348f3a2b7e9e2e1cf892d32.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1167,"all_time_quantity_sold":86,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eThương hiệu:\u003c/strong\u003e Avène\u003cbr /\u003e\u003cstrong\u003eXuất xứ:\u003c/strong\u003e Pháp\u003cbr /\u003e\u003cstrong\u003eHạn sử dụng:\u003c/strong\u003e 03 năm kể từ ngày sản xuất\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e• Nước khoáng Avène (Avène Aqua): giúp làm dịu và giảm kích ứng da cho làn da nhạy cảm nhất.\u003cbr /\u003e• Monolaurin: Giúp kháng khuẩn và hạn chế tiết dầu trên da.\u003cbr /\u003e• Kẽm Gluconate: Làm dịu làn da bị kích ứng và mẩn đỏ trên da.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003e CÔNG DỤNG:\u003c/strong\u003e\u003cbr /\u003e- Sữa rửa mặt dạng gel Avène Cleanance Cleansing Gel với chất gel có khả năng tạo bọt nhẹ nhàng làm sạch sâu và se khít lỗ chân lông mà không gây bít tắc lỗ chân lông, giúp giảm tình trạng mụn trên da.\u003cbr /\u003e- Thành phần Monolaurin giúp hạn chế tiết dầu trên da tạo hiệu quả giảm bóng nhờn trên da dầu.\u003cbr /\u003e- Ngay sau khi sử dụng, làn da trở nên mềm mại, mịn màng, sạch thoáng.\u003cbr /\u003e- Thành phần không chứa xà phòng (Soap – free) nên không làm khô da khi sử dụng.\u003cbr /\u003e- Chất gel lỏng khi tạo bọt rất mềm giúp nhẹ nhàng cuốn trôi đi bụi bẩn và dầu thừa trên da, giúp làm sạch sâu lỗ chân lông mà không làm mất đi độ ẩm của da.\u003cbr /\u003e- Thành phần nước khoảng Avène cùng kẽm Gluconate, Monolaurin giúp kháng khuẩn, hạn chế tiết dầu thừa, làm dịu da giúp cải thiện tình trạng bị kích ứng, nổi mẩn đỏ trên da.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/90/d5/b4/d35f4d5d68269df6e57efa7e060a8026.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003e HƯỚNG DẪN SỬ DỤNG:\u003c/strong\u003e\u003cbr /\u003e• Lấy sản phẩm bằng ra khoảng bằng một hạt đậu (hoặc khoảng hai hạt đậu nếu bạn thích nhiều bọt).\u003cbr /\u003e• Thêm một ít nước và tạo bọt nhẹ nhàng bằng cách xoa hai tay vào nhau hoặc tạo bọt với sản phẩm chuyên dụng như cốc tạo bọt.\u003cbr /\u003e• Massage đều lên mặt để mặt được thư giãn với sữa rửa mặt dạng gel Avène Cleanance Cleansing Gel.\u003cbr /\u003e• Tần suất: 2 lần/ngày.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/72/87/7b/3ab34c4f3d4d44a14a3c9114480afb46.jpg\" alt=\"\" width=\"750\" height=\"421\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003e LƯU Ý:\u003c/strong\u003e\u003cbr /\u003e- Không nên thoa sữa rửa mặt trực tiếp lên mặt mà nên tạo bọt trên tay trước để tránh gây kích ứng da.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá