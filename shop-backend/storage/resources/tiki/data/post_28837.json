\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lm8q63fldckf4f\" alt=\"vn-11134208-7r98o-lm8q63fldckf4f\" width=\"750\" height=\"518\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lo80zwf7zgmv0e\" alt=\"vn-11134208-7r98o-lo80zwf7zgmv0e\" width=\"840\" height=\"690\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lo80zwf7y22fd1\" alt=\"vn-11134208-7r98o-lo80zwf7y22fd1\" width=\"1440\" height=\"720\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7qukw-lk3wmofis7g4da\" alt=\"vn-11134208-7qukw-lk3wmofis7g4da\" width=\"2072\" height=\"1168\" /\u003e\u003c/p\u003e\n\u003cp\u003eThanh vân là hệ thống phân phối xe máy, phụ tùng \u0026amp; dịch vụ sữa chữa chính hãng do chính Honda uỷ nhiệm\u003c/p\u003e\n\u003cp\u003esp đảm báo đúng mẫu mã như mô tả\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e5. Mô tả sản phẩm\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e- Thiết kế mang DNA thể thao\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eVARIO 160 sở hữu thiết kế thể thao, mới lạ, phù hợp với các khách hàng trẻ tuổi và năng động. Diện mạo xe bề thế mạnh mẽ mang tới hình ảnh trẻ trung độc đáo, nổi bật dưới mọi góc nhìn.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e- Sàn để chân bằn\u003c/p\u003e\n\u003cp\u003eg phẳng và tiện lợi\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eSàn để phẳng với độ rộng lên tới 422mm, mang lại sự tiện dụng và thoải mái khi di chuyển hàng ngày.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e- Bánh xe kích thước lớn\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eVARIO 160 được trang bị bộ lốp lớn và dày giúp tăng khả năng bám đường và sự ổn định khi vận hành. Kích thước lốp lớn (100/80-14 cho bánh trước và 120/70-14 cho bánh sau) kết hợp với bộ mâm hình chữ Y góp phần tạo nên hình ảnh mạnh mẽ và nổi bật.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e- Hộc đựng đồ phía trước rộng kết hợp cổng sạc USB tiện lợi\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eVARIO 160 sở hữu 2 hộc chứa đồ phía trước rộng rãi, đặc biệt hộc chứa đồ bên trái được trang bị nắp che tích hợp cổng sạc USB loại A tiện lợi với công suất tối đa là 10,5W (5V – 2,1A) cho phép sạc pin điện thoại trong khi đang di chuyển.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e- Hệ thống khóa thông minh Smart Key\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eVới thao tác đơn giản, khóa điện mở xe, khóa cổ xe, định vị xe cùng chức năng báo động được tích hợp trên thiết bị điều khiển FOB gia tăng sự tiện ích, an tâm cho khách hàng.\u003c/p\u003e\n\u003c/div\u003e"},{"code":"dieu_kien_su_dung","name":"Điều kiện sử dụng","value":"\u003cp\u003ePhiếu không áp dụng hình thức thanh toán tại cừa hàng \u003cbr /\u003ePhiếu được sử dụng để quy đổi số tiền trả trước hoặc trả góp của nhà bán hàng trên tiki.vn\u003cbr /\u003eGiá trị quy đổi được tính là giá bán (giá thanh toán khi mua), không phải giá thị trường\u003cbr /\u003eĐơn hàng không được phép Hủy khi đã được quy đổi \u0026amp; đã nhận xe tại nhà bán hàng.\u003c/p\u003e\n\u003cp\u003ePhiếu Mua Xe Máy HEAD THANH VAN\u003c/p\u003e\n\u003cp\u003eVí dụ, bạn có nhu cầu mua chiếc xe máy với giá 40 triệu, nhưng hạn mức thẻ tín dụng của bạn chỉ có 30 triệu. Lúc này, Tiki sẽ gửi cho bạn sản phẩm phiếu mua xe trị giá 30 triệu, bạn đặt trả góp 0% phiếu này như 1 sản phẩm bình thường. \u003c/p\u003e\n\u003cul\u003e\u003cli\u003eKhi ra nhận xe, bạn chỉ cần bù 10 triệu tiền mặt tại cửa hàng để nhận xe có giá trị 40 triệu.\u003c/li\u003e\u003cli\u003eTuy nhiên, phiếu này chỉ được mở lên cho KH đặt sau khi đã được Tiki tư vấn về dòng xe muốn mua và tương ứng với nhà bán hàng đó.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Tuy nhiên tuỳ vào từng loại sản phẩm hoặc phương thức, nơi giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh,\u003c/p\u003e\n\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e"},{"code":"brand","name":"Thương hiệu","value":"Honda"},{"code":"brand_country","name":"Xuất xứ thương hiệu","value":"Nhật Bản"},{"code":"origin","name":"Xuất xứ (Made in)","value":"Việt Nam"},{"code":"seller_delivery_method","name":"Phương thức giao hàng Seller Delivery","value":"Nhà bán giao hàng cho khách hàng"},{"code":"is_warranty_applied","name":"Sản phẩm có được bảo hành không?","value":"Không"}]}],"product_links":[],"gift_item_title":"0 quà tặng kèm","configurable_options":[{"code":"option1","name":"Màu","position":0,"show_preview_image":true,"values":[{"label":"10 Triệu VNĐ"},{"label":"15 Triệu VNĐ"},{"label":"20 Triệu VNĐ"},{"label":"25 Triệu VNĐ"},{"label":"30 Triệu VNĐ"},{"label":"40 Triệu VNĐ"},{"label":"50 Triệu VNĐ"}]}],"configurable_products":[{"child_id":132189389,"discount_rate":0,"id":263559706,"images":[{"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/af/44/28/4f8c981c65be03e5016eed696654f550.png","medium_url":"https://salt.tikicdn.com/cache/550x550/ts/product/af/44/28/4f8c981c65be03e5016eed696654f550.png","small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/af/44/28/4f8c981c65be03e5016eed696654f550.png"}],"inventory_status":"available","name":"Phiếu Mua Xe Máy - 30 Triệu VNĐ","option1":"30 Triệu VNĐ","original_price":34690000,"price":34540000,"selected":false,"seller":{"id":282426,"name":"HEAD THANH VÂN"},"sku":"9678608530646","thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/5b/5b/82/772e9b84e77b661059c8d35fa8a87a8d.png"},{"child_id":132189383,"discoun