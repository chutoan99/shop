png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/02/0e/1e/60ca6600fe997d3fcaf1847f22355341.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1184,"all_time_quantity_sold":14,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003eGiới thiệu\u003c/h3\u003e\n\u003cul\u003e\u003cli\u003eDầu ép từ hạt hoa hướng dương có hàm lượng vitamin A, D, C và E cao, có tác dụng dưỡng ẩm tuyệt vời cho làn da. Tinh dầu hoa hướng dương thật sự là một loại tinh dầu có thể sử dụng một cách rất linh hoạt do đặc tính nhanh chóng thẩm thấu vào da, phù hợp với mọi loại da ngay cả đối với da nhạy cảm. Ngoài ra, tinh dầu Hoa Hướng Dương có hương thơm dịu nhẹ, dễ chịu giúp cho bé cảm giác dễ chịu và dễ dàng có giấc ngủ ngon.\u003c/li\u003e\u003cli\u003eDung dịch tắm gội dịu nhẹ (2 trong 1) Pigeon chiết xuất từ dầu Hoa Hướng Dương là sự kết hợp của dầu gội và sữa tắm trong cùng một sản phẩm giúp nhẹ nhàng làm sạch tóc, da đầu và toàn thân bé mà vẫn giữ được các chất nhờn sinh lý tự nhiên trên da.\u003c/li\u003e\u003cli\u003eVới công thức cải tiến thành phần chất bảo quản (không chứa Paraben), thành phần Hydroxyacetophenone cùng Ethylhexylglycerin với nồng độ phù hợp, dịu nhẹ, giúp nhẹ nhàng làm sạch làn da cho bé, hỗ trợ cân bằng độ pH, cải thiện hiệu quả kháng khuẩn, giảm sự mất nước, bảo vệ da, mang lại làn da sạch sẽ, mịn màng cùng hương thơm tươi mát.\u003c/li\u003e\u003cli\u003eXuất xứ: Việt Nam\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/02/0e/1e/6aec35485f003d00f6498cf26fd94c33.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch3\u003eThành phần\u003c/h3\u003e\n\u003cp\u003ePurified Water, Cocamidopropyl Betaine, Sodium Myreth Sulfate, Sodium Cocoamphoacetate, Glycerin, Fragrance, PEG-250 Distearate, Phenoxyethanol, Polyquaternium-10, Citric Acid, Sodium Benzoate, Hydroxyacetophenone, Ethylhexylglycerin, Tetrasodium EDTA, Sodium PCA, Polysorbate 80, Propylene Glycol, Helianthus Annuus (Sunflower) Seed Oil, Lactic Acid, Bisabolol.\u003c/p\u003e\n\u003ch3\u003eĐặc điểm nổi bật\u003c/h3\u003e\n\u003cul\u003e\u003cli\u003eHình thành màng dưỡng ẩm cho da sau bước làm sạch với nước, thấy được sự mượt mà trơn tru của làn da ngay sau khi sử dụng với nước. Các sản phẩm chuyên dụng cho làn da của trẻ luôn cần có lớp màng cấp ẩm này để nuôi dưỡng và bảo vệ làn da của bé\u003c/li\u003e\u003cli\u003eChiết xuất giàu Vitamin E\u003c/li\u003e\u003cli\u003eDưỡng chất tự nhiên chiết xuất từ hạt Hoa hướng dương.\u003c/li\u003e\u003cli\u003eDành cho trẻ sơ sinh và trẻ nhỏ.\u003c/li\u003e\u003cli\u003ePhù hợp với mọi loại da của bé.\u003c/li\u003e\u003c/ul\u003e\n\u003ch3\u003eĐối tượng sử dụng\u003c/h3\u003e\n\u003cul\u003e\u003cli\u003eDành cho trẻ sơ sinh và trẻ nhỏ.\u003c/li\u003e\u003cli\u003ePhù hợp với mọi loại da của bé.\u003c/li\u003e\u003c/ul\u003e\n\u003ch3\u003eHướng dẫn sử dụng\u003c/h3\u003e\n\u003cul\u003e\u003cli\u003eCách dùng: Cho dung dịch tắm gội vào bông tắm hay khăn tắm, thoa nhẹ nhàng lên da và tóc bé. Xả sạch bằng nước.\u003c/li\u003e\u003cli\u003eHSD: 3 năm kể từ khi sản xuất\u003c/li\u003e\u003c/ul\u003e\n\u003ch3\u003eLưu ý sử dụng\u003c/h3\u003e\n\u003cp\u003e1. Chỉ sử dụng ngoài da.\u003c/p\u003e\n\u003cp\u003e2. Tránh tiếp xúc trực tiếp với mắt.\u003c/p\u003e\n\u003cp\u003e3. Rửa sạch ngay với nước nếu sản phẩm tiếp xúc vào mắt.\u003c/p\u003e\n\u003cp\u003e4. Ngưng sử dụng ngay sản phẩm và tham khảo ý kiến bác sĩ nếu thấy có dấu hiệu bất thường.\u003c/p\u003e\n\u003cp\u003e5. Tránh xa tầm tay trẻ em.\u003c/p\u003e\n\u003cp\u003e_/2021/XNQC-YTHCM\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/02/0e/1e/60ca6600fe997d3fcaf1847f22355341.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/02/0e/1e/60ca6600fe997d3fcaf1847f22355341.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/02/0e/1e/60ca6600fe997d3fcaf1847f22355341.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/02/0e/1e/60ca6600fe997d3fcaf1847f22355341.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/02/0e/1e/60ca6600fe997d3fcaf1847f22355341.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/87/ec/ce/3d0a5c57e800b89312723136fac85ac3.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/87/ec/ce/3d0a5c57e800b89312723136fac85ac3.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/87/ec/ce/3d0a5c57e800b89312723136fac85ac3.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/87/ec/ce/3d0a5c57e800b89312723136fac85ac3.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/87/ec/ce/3d0a5c57e800b89312723136fac85ac3.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/76/4f/dd/47c155783aeca08120e013b89372c177.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/76/4f/dd/47c155783