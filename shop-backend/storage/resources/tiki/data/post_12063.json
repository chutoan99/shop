or":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":459000,"discount_rate":50,"rating_average":4.5,"review_count":172,"review_text":"(172)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/bc/f0/20/5caa8d9ae719e48c8fc51a9273971046.JPG","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1441,"all_time_quantity_sold":579,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p>Bộ tạ miếng nhựa đen ( ; 20kg; 30kg; 40kg; ) gồm:</p>\n<p><img src=\"https://salt.tikicdn.com/ts/tmp/08/7a/8a/c309c419674bb8ee383dc1ef5bc83d9f.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p>- Thanh nối</p>\n<p>- Tạ miếng nhựa 20 kg : 2kg - 4 miếng; 1,5kg - 4 miếng &amp; 1,25kg - 4 miếng</p>\n<p>- Tạ miếng nhựa 30 kg : 2,5kg - 4 miếng ; 2kg - 4 miếng; 1,5kg - 4 miếng &amp; 1,25kg - 4 miếng</p>\n<p>- Tạ miếng nhựa 40 kg : 3kg - 8 miếng ; 2,5kg - 4 miếng &amp; 1,25kg - 4 miếng</p>\n<p><img src=\"https://salt.tikicdn.com/ts/tmp/94/80/4c/77bf06914db2631895ce57129508f0d6.JPG\" alt=\"\" width=\"750\" height=\"725\" /></p>\n<p>Tạ tay hay tạ tay đơn là dòng sản phẩm phổ biến hiện nay và được rất nhiều người lựa chọn để tập luyện.</p>\n<p>Tạ tay đơn được thiết kế đơn giản và có thể luyện tập ngay tại nhà, các bài tập với tạ tay đơn cũng rất dễ dàng, gọn nhẹ. Những động tác có thể thực hiện với tạ đơn chủ yếu cho vùng bụng và tay, vai hay ngực cùng với nhiều cân nặng khác nhau để có thể tập luyện.</p>\n<p><img src=\"https://salt.tikicdn.com/ts/tmp/de/80/34/ddaab32b44c3e40d496864b33417ca6e.JPG\" alt=\"\" width=\"750\" height=\"751\" /></p>\n<p>Với độ bề cao, đáp ứng mọi nhu cầu tập luyện của bạn.Ngoài ra tạ còn được thiết kế đẹp mắt, đòn tạ cầm nắm chắc chắn giúp bạn yên tâm tập luyện.</p>\n<p>Tạ có thể tháo lắp dễ dàng để tăng hoặc giảm cân nặng phù hợp nhiều bài tập khác nhau. Bên ngoài bọc nhựa cứng dày + có độ bền cao và nó có nhiều trọng lượng khác nhau cho bạn lựa chọn. Đường kính và độ dày của mỗi miếng tạ sẽ được điều chỉnh sao cho phù hợp với từng mức cân nặng cụ thể.</p>\n<p><img src=\"https://salt.tikicdn.com/ts/tmp/a5/3c/3a/497bc8418bb1ae475ec50b76c3522c0d.jpg\" alt=\"\" width=\"720\" height=\"714\" /></p>\n<p><img src=\"https://salt.tikicdn.com/ts/tmp/b2/a0/08/f1475d72a09fcbdb51e1c55abefa82bf.jpg\" alt=\"\" width=\"720\" height=\"714\" /></p>\n<p><img src=\"https://salt.tikicdn.com/ts/tmp/aa/1b/4b/79faf70e345b084d9a9accf51e59a780.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p>Trên mỗi miếng tạ có ghi rõ trọng lượng từng quả tạ, giúp người sử dụng có thể dễ dàng phân biệt.</p>\n<p>Tạ miếng nhựa phù hợp dùng để ghép vào đòn tạ đẩy, đòn tạ tay hoặc các mẫu ghế tập tạ để thực hiện các bài tập Gym tại nhà. Ưu điểm của tạ miếng nhựa này là giá rẻ và phù hợp với tất cả các mẫu đòn tạ dùng tập thể hình tại nhà.</p>\n<p><img src=\"https://salt.tikicdn.com/ts/tmp/63/1e/78/a36727d1926943c23528ff3c9d6174d3.JPG\" alt=\"\" width=\"750\" height=\"672\" /></p>\n<p><img src=\"https://salt.tikicdn.com/ts/tmp/62/e9/8c/017f98e78372afaebdf9ae2622c8c7c7.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p><img src=\"https://salt.tikicdn.com/ts/tmp/4a/dc/f1/b99ce2c0806f4e48956daf7a55f5aed1.JPG\" alt=\"\" width=\"750\" height=\"754\" /></p>\n<p><img src=\"https://salt.tikicdn.com/ts/tmp/b9/2b/6e/664b8ff2a6db8972a7e770b14ec4f229.JPG\" alt=\"\" width=\"750\" height=\"676\" /></p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/bc/f0/20/5caa8d9ae719e48c8fc51a9273971046.JPG","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/bc/f0/20/5caa8d9ae719e48c8fc51a9273971046.JPG","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/bc/f0/20/5caa8d9ae719e48c8fc51a9273971046.JPG","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/bc/f0/20/5caa8d9ae719e48c8fc51a9273971046.JPG","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/bc/f0/20/5caa8d9ae719e48c8fc51a9273971046.JPG"},{"base_url":"https://salt.tikicdn.com/ts/product/ed/a5/14/525f24d4e821b02fd130d6e2fd2900cb.JPG","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ed/a5/14/525f24d4e821b02fd130d6e2fd2900cb.JPG","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ed/a5/14/525f24d4e821b02fd130d6e2fd2900cb.JPG","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ed/a5/14/525f24d4e821b02fd130d6e2fd2900cb.JPG","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ed/a5/14/525f24d4e821b02fd130d6e2fd2900cb.JPG"},{"base_url":"https://salt.tikicdn.com/ts/product/6f/e0/cd/eb5bfeca5b51a998821ce06620c218e0.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/6f/e0/cd/eb5bfeca5b51a998821ce06620c218e0.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/6f/e0/cd/eb5bfeca5b51a998821ce06620c218e0.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6f/e0/cd/eb5bfeca5b51a998821ce06620c218e0.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x28