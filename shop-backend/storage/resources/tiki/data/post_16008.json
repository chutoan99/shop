ull}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":123000,"discount_rate":52,"rating_average":4.7,"review_count":19,"review_text":"(19)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ed/7e/da/d039b0e9fbe4609f842d603b2ef07531.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":903,"all_time_quantity_sold":67,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2\u003e\u003cstrong\u003eHÌNH DÁNG GỐI CAO SU NON BỤNG MÈO\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/d0/af/f7/4b28f118edae757d2d6e6867d84d6014.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eĐúng như tên gọi của sản phẩm, gối đầu cao su non bụng mèo Ema được thiết kế theo hình bánh mỳ của gối ngủ truyền thống, cải tiến bo tròn 4 cạnh và bóp gọn ở hông giống như hình dạng của bụng mèo.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/64/6f/19/8d81977fa37117753da4213d84ad630d.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eThiết kế này nhằm giúp vùng cổ và vùng đầu được thoải mái nhất khi nằm ngừa, nằm nghiêng khi có các vùng chuyên biệt cho tư thế này. \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/54/37/92/3b42addaf00e23854b78f02c0d53c0e4.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center\"\u003e\u003cem\u003eTạo cảm giác thoải mái như bạn đang gối đầu lên chính chú mèo vậy!\u003c/em\u003e\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/13/f3/13/685b1d810c3dc76f71a4c497ed7caa19.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/69/47/b9/797efd464bfda1fa5dc9c4090c019a88.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eKÍCH THƯỚC\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/d6/b7/ba/67dc1922a16dbb00cf24a928744f7f66.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003cbr /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eGối có chiều dài 50cm rộng 30cm và cao 9cm - kích thước này là kích thước tiêu chuẩn cho người trưởng thành sử dụng, đủ rộng \u0026amp; thoải mái để bạn nghiêng trái, phải khi ngủ.\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eCHẤT LIỆU RUỘT\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/3b/cd/a0/049656ed1842f2ffcd4d86b3a0819f60.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eRuột gối:\u003c/strong\u003e Được làm từ Cao su non - với khả năng chậm đàn hồi và độ bền lên đến 10 năm, là một trong những chất liệu tốt nhất để làm gối ngủ - cùng với cao su thiên nhiên.\u003c/p\u003e\n\u003cp\u003eMemory Foam (cao su non) với đặc tính chậm đàn hồi là vật liệu do trung tâm vũ trụ NASA phát minh vào năm 1966 nhằm nâng cao sự an toàn cho các phần nệm của thiết bị bay nhằm giảm thiểu tối đa áp lực tác động lên các phi hành gia và rung chấn trong quá trình phóng tàu vũ trụ. Ngày này chất liệu này được sử dụng rất nhiều trong ngành công nghiệp gối - đệm\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/35/76/98/96dcaf80fe6bd73c76e2c21adc5ede4b.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center\"\u003e\u003cem\u003eĐặc tính chậm đàn hồi đặc trưng chỉ có ở cao su non\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center\"\u003e\u003cstrong\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/37/ca/23/70736ff4514b1cd290ae0cd9e8db29c0.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center\"\u003e\u003cem\u003eĐộ đàn hồi và dai của ruột giúp gối nhanh chóng lấy lại hình dạng dù trước đó bị xoắn mạnh\u003c/em\u003e\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eCHẤT LIỆU VỎ\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/f2/8f/0e/8906ddd99cd38bc87ac8837416b57873.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eVỏ gối được làm từ chất liệu vải cotton siêu thoáng, co giãn 4 chiều và có khả năng thấm hút mồ hôi rất tốt\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/40/c6/5d/ad9c4518171ca0990852b822731b3952.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eVỏ gối được thiết kế ẩn rất ấn tượng vừa tăng tính thẩm mỹ mà còn giúp tiện lợi có thể tháo ra giặt dễ dàng.\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eMÀU SẮC\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003eGối có 3 màu giúp bạn thoải mái lựa chọn, có thể dùng cho cả nam và nữ\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/7a/cb/88/8d5bd52bfa053c777a47b9ee2ffbfa8d.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/a6/2a/03/51b8ac9f9c6efb0dc083559a5e1c6f7e.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/b3/b0/df/e3955377775268a879bf2181ea58a084.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/f3/f3/a7/deb3b1fa4902f10227cfc7d24f2fd95f.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ed/7e/da/d039b0e9fbe4609f842d603b2ef07531.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ed/7e/da/d039b0e9fbe4609f842d603b2ef07531.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ed/7e/da/d039b0e9fbe4609f842d603b2ef07531.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ed/7e/da/d039b0e9fbe4609f842d603b2ef07531.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ed/7e/da/d039b0e9fbe4609f842d603b2ef07531.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/a8/4f/26/922e91e4014959348294fc0f00a03501.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a8/4f/26/922e91e4014959348294fc0f00a03501.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/pr