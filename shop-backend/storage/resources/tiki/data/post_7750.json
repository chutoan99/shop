t_rate":0,"rating_average":4.3,"review_count":6,"review_text":"(6)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/e5/de/70/f60b55d4f26f17a8b37cd887e9409cec.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1719,"all_time_quantity_sold":25,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch5 style=\"text-align: justify;\"\u003eAn toàn khi sử dụng trên mọi loại vải\u003c/h5\u003e\n\u003cp style=\"text-align: justify;\"\u003eBàn ủi hơi nước an toàn để sử dụng trên mọi loại vải. Đây là giải pháp tuyệt vời cho những loại vải tinh xảo như lụa và len cashmere.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/65/e7/4b/69268dfbb4e92fe7051f7f13c927bad9.jpg\" alt=\"\" width=\"750\" height=\"536\" /\u003e\u003c/p\u003e\n\u003ch5 style=\"text-align: justify;\"\u003eHơi nước diệt sạch hơn 99% vi khuẩn và mạt bụi*\u003c/h5\u003e\n\u003cp style=\"text-align: justify;\"\u003eHơi nước làm mới quần áo của bạn và tiêu diệt hơn 99% vi khuẩn và mạt bụi*. Tiết kiệm thời gian và tiền bạc khi ít phải giặt ướt và giặt khô, cũng như giúp quần áo bền hơn.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/7a/37/ce/de560769cc5af8205acb8b35cc762110.jpg\" alt=\"\" width=\"750\" height=\"502\" /\u003e\u003c/p\u003e\n\u003ch5 style=\"text-align: justify;\"\u003eGăng tay tăng cường cách nhiệt bảo vệ đôi tay bạn trong khi ủi hơi nước\u003c/h5\u003e\n\u003cp style=\"text-align: justify;\"\u003eGăng tay cách nhiệt đi kèm giúp bảo vệ tay bạn trong khi ủi bằng hơi nước. Ngoài ra, móc treo quần áo tích hợp giúp bạn dễ dàng treo những trang phục như áo, váy, quần trong khi dùng bàn ủi.\u003c/p\u003e\n\u003ch5 style=\"text-align: justify;\"\u003eNgăn chứa nước 1.4 lít với lỗ châm nước lớn hơn 80%*\u003c/h5\u003e\n\u003cp style=\"text-align: justify;\"\u003eNgăn chứa nước lớn 1,4 lít có thể tháo rời đi cùng với lỗ châm nước lớn hơn 80%* so với các mẫu tiền nhiệm, giúp châm nước và lau rửa dễ dàng hơn, đảm bảo vệ sinh ngăn chứa tốt hơn. Bên cạnh đó, chức năng xả cặn cho hiệu suất sử dụng lâu dài hơn.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/cf/a8/36/c442f37fd1eab9410592d19dc8e38b0d.jpg\" alt=\"\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003ch5 style=\"text-align: justify;\"\u003e2 chế độ hơi phun cho các loại vải khác nhau\u003c/h5\u003e\n\u003cp style=\"text-align: justify;\"\u003eThiết lập chế độ hơi phun ưa thích để có kết quả tối ưu trên các loại vải khác nhau. Sử dụng chế độ hơi phun thấp cho loại vải mỏng và hơi phun mạnh hơn cho vải dày và áo khoác. Đầu phun tạo hơi phun mạnh liên tục 32 g/phút, giúp ủi phẳng chỉ với vài đường ủi.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/3e/b0/11/61e2d9311cd4d93faa55a6b32d013178.jpg\" alt=\"\" width=\"750\" height=\"536\" /\u003e\u003c/p\u003e\n\u003ch5 style=\"text-align: justify;\"\u003eThiết kế gọn nhẹ để tiện bảo quản\u003c/h5\u003e\n\u003cp style=\"text-align: justify;\"\u003eThiết kế gọn nhẹ để dễ dàng bảo quản. Trụ đứng có thể điều chỉnh được tích hợp giúp treo trang phục của bạn. Trụ có thể gấp lại, thuận tiện cho việc bảo quản.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/b9/7b/b5/d5947a5fe155dadb8f6c30662a6ab318.jpg\" alt=\"\" width=\"750\" height=\"602\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/e5/de/70/f60b55d4f26f17a8b37cd887e9409cec.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e5/de/70/f60b55d4f26f17a8b37cd887e9409cec.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e5/de/70/f60b55d4f26f17a8b37cd887e9409cec.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e5/de/70/f60b55d4f26f17a8b37cd887e9409cec.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e5/de/70/f60b55d4f26f17a8b37cd887e9409cec.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/0c/31/11/c48ffaab2a83bf2bb4fce555d328fe85.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0c/31/11/c48ffaab2a83bf2bb4fce555d328fe85.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/0c/31/11/c48ffaab2a83bf2bb4fce555d328fe85.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0c/31/11/c48ffaab2a83bf2bb4fce555d328fe85.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0c/31/11/c48ffaab2a83bf2bb4fce555d328fe85.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/1a/99/fd/37c2858531c06e612323136f0e634dcc.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/1a/99/fd/37c2858531c06e612323136f0e634dcc.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/1a/99/fd/37c2858531c06e612323136f0e634dcc.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1a/99/fd/37c2858531c06e612323136f0e634dcc.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1a/99/fd/37c2858531c06e612323136f0e634dcc.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/4e/ee/f5/637d4ecd8b2fa7e5fd4e4b0a097a6a8a.jpg","is_gallery":true,"label":null,"lar