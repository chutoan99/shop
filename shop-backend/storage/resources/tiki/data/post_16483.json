ing_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/dd/59/a1/ee381789cf99e3a3b8b6bc09d5cf9e24.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2221,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch5\u003e\u003ciframe src=\"//www.youtube.com/embed/eqfCsFBQL3w\" width=\"750\" height=\"421\" allowfullscreen=\"allowfullscreen\"\u003e\u003c/iframe\u003e\u003c/h5\u003e\n\u003ch5\u003eThiết kế đầy cá tính và nhỏ gọn\u003c/h5\u003e\n\u003cp\u003e\u003cstrong\u003eMáy Scan Canon P-215II\u003c/strong\u003e Ngoài thiết kế đầy cá tính và nhỏ gọn, máy scan Canon còn được trang bị cổng USB và tiện ích plug-and-scan (cắm cáp và quét) giúp quét màu và quét đen trắng với độ phân giải cao lên đến 600dpi.\u003c/p\u003e\n\u003ch5\u003eQuét một lần tốc độ cao\u003c/h5\u003e\n\u003cp\u003eNhờ tính năng quét hai mặt hoàn hảo của tài liệu trong một lần duy nhất, Canon P-215II cho tốc độ quét lên đến 15 trang/phút hay 30 hình/phút đối với tài liệu đen trắng và 10 trang/phút hay 20 hình/phút đối với tài liệu màu. Một thiết bị cầm tay có thể đáp ứng mọi yêu cầu của một chiếc máy quét có kích thước thông thường.\u003c/p\u003e\n\u003ch5\u003eĐộ phân giải 600 x 600 dpi\u003c/h5\u003e\n\u003cp\u003eVới độ phân giải 600 x 600 dpi, máy Scan Canon P-215II giúp các hình ảnh, tài liệu có màu sắc trung thực và sống động hơn.\u003c/p\u003e\n\u003ch5\u003eKết nối USB tiện dụng\u003c/h5\u003e\n\u003cp\u003eChỉ cần kết nối máy scan với máy tính qua cổng USB là bạn đã có thể thực hiện việc quét hình ảnh và giấy tờ cần thiết. Nhờ khả năng sử dụng năng lượng hiệu quả, cổng USB cũng sẽ giúp cung cấp điện cho máy một cách nhanh chóng.\u003c/p\u003e\n\u003ch5\u003eTiện ích plug-and-scan\u003c/h5\u003e\n\u003cp\u003eGiao diện tiếng Việt thân thiện, trực quan giúp bạn sữ dụng một cách thuận tiện, các chức năng đặc biệt: scan 2 mặt tự động, scan thẻ nhựa, dùng nguồn trực tiếp từ máy tính. Tiện ích plug-and-scan giúp Canon P-215II không yêu cầu bất kỳ driver hay cài đặt ứng dụng nào từ hệ điều hành Windows và Mac OS.\u003c/p\u003e\n\u003ch5\u003eThông số kỹ thuật\u003c/h5\u003e\n\u003ctable style=\"border-collapse: collapse; width: 100%; height: 180px;\" border=\"1\"\u003e\n\u003ctbody\u003e\n\u003ctr style=\"height: 18px;\"\u003e\n\u003ctd style=\"width: 24.8209%; height: 18px;\"\u003eKhổ bản gốc\u003c/td\u003e\n\u003ctd style=\"width: 75.1791%; height: 18px;\"\u003e\n\u003cul\u003e\n\u003cli\u003eGiấy thường (R x D): 50.8 - 216mm x 70 - 356mm (Có thể quét tài liệu dài tới 1.000mm nếu cài đặt máy quét ở chế độ Quét tài liệu dài)\u003c/li\u003e\n\u003cli\u003eThiếp (R x D): 88.9 - 108mm x 127 - 152.4mm\u003c/li\u003e\n\u003cli\u003eThẻ nhựa (R x D): 49 - 55mm x 85 - 91mm\u003c/li\u003e\n\u003cli\u003eThẻ: 54 x 86mm (chuẩn ISO)\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr style=\"height: 18px;\"\u003e\n\u003ctd style=\"width: 24.8209%; height: 18px;\"\u003eĐộ dày và Trọng lượng bản gốc\u003c/td\u003e\n\u003ctd style=\"width: 75.1791%; height: 18px;\"\u003e\n\u003cul\u003e\n\u003cli\u003eGiấy thường: 0.06 – 0.15mm, 52 - 128g/m2 \u003c/li\u003e\n\u003cli\u003eBưu thiếp: 0.15 – 0.3mm, 128 - 225g/m2\u003c/li\u003e\n\u003cli\u003eThẻ nhựa: 0.15 – 0.3mm, 128 -225g/m2\u003c/li\u003e\n\u003cli\u003eThẻ: 0.76mm tương thích IS07810 ID-1\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr style=\"height: 18px;\"\u003e\n\u003ctd style=\"width: 24.8209%; height: 18px;\"\u003eNạp bản gốc\u003c/td\u003e\n\u003ctd style=\"width: 75.1791%; height: 18px;\"\u003e Nạp giấy tự động\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr style=\"height: 18px;\"\u003e\n\u003ctd style=\"width: 24.8209%; height: 18px;\"\u003eDung lượng bản gốc\u003c/td\u003e\n\u003ctd style=\"width: 75.1791%; height: 18px;\"\u003e Chồng giấy 3mm (bao gồm cả mép quăn) hoặ 20 tờ giấy định lượng 64g/m2 (16lb. bond)\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr style=\"height: 18px;\"\u003e\n\u003ctd style=\"width: 24.8209%; height: 18px;\"\u003eYếu tố quét\u003c/td\u003e\n\u003ctd style=\"width: 75.1791%; height: 18px;\"\u003e CIS\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr style=\"height: 18px;\"\u003e\n\u003ctd style=\"width: 24.8209%; height: 18px;\"\u003eNguồn sáng\u003c/td\u003e\n\u003ctd style=\"width: 75.1791%; height: 18px;\"\u003e LED (đỏ, xanh lá cây, xanh da trời)\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr style=\"height: 18px;\"\u003e\n\u003ctd style=\"width: 24.8209%; height: 18px;\"\u003eMặt quét\u003c/td\u003e\n\u003ctd style=\"width: 75.1791%; height: 18px;\"\u003e Quét một mặt / Quét đảo mặt\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr style=\"height: 18px;\"\u003e\n\u003ctd style=\"width: 24.8209%; height: 18px;\"\u003eCác chế độ quét\u003c/td\u003e\n\u003ctd style=\"width: 75.1791%; height: 18px;\"\u003e Quét đen trắng, quét phân tán lỗi, Tự làm rõ văn bản II, quét 8 bit quét 256 thang màu, quét một màu, quét màu 24 bit\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr style=\"height: 18px;\"\u003e\n\u003ctd style=\"width: 24.8209%; height: 18px;\"\u003eĐộ phân giải bản quét\u003c/td\u003e\n\u003ctd style=\"width: 75.1791%; height: 18px;\"\u003e 150 x 150dpi, 200 x 200dpi, 300 x 300dpi, 400 x 400dpi, 600 x 600dpi\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr style=\"height: 18px;\"\u003e\n\u003ctd style=\"width: 24.8209%; height: 18px;\"\u003eCổng kết nối\u003c/td\u003e\n\u003ctd style=\"width: 75.1791%; height: 18px;\"\u003e USB 2.0 tốc độ cao (hỗ trợ nguồn điện USB 3.0)\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd style=\"width: 24.8209%;\"\u003eTrình điều khiển quét / Phần mềm\u003c/td\u003e\n\u003ctd style=\"width: 75.1791%;\"\u003e\n\u003cul\u003e\n\u003cli\u003eWindows:ISIS / TWAIN Driver, CaptureOn Touch, CaptureOn Touch Lite (Built-in), PaperPort, Presto! BizCard, Evernote*3\u003c/li\u003e\n\u003cli\u003eMac: TWAIN Driver, CaptureOn Touch, CaptureOn Touch Lite (Built-in), Presto! PageManager, Presto! BizCard, Evernote*3\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/dd/59/a1/ee381789cf99e3a3b8b6bc09d5cf9e24.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/dd/59/a1/ee381789cf99e3a3b8b6bc09d5cf9e24.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/dd/59/a1/ee381789cf99e3a3b8b6bc09d5cf9e24.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/dd/59/a1/ee381789cf99e3a3b8b6bc09d5cf9e24.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/dd/59/a1/ee381789cf99e3a3b8b6bc09d5cf9e24.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/1b/80/82/e06c7d710783fd7c2b07e7bd26681c0b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/1b/80/82/e06c7d710783fd7c2b07e7bd26681c0b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/1b/80/82/e06c7d710783fd7c2b07e7bd26681c0b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1b/80/82/e06c7d710783fd7c2b07e7bd26681c0b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280