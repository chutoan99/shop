r":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":5,"review_text":"(5)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/media/catalog/product/m/a/may-theu-brother-as2730s-trang-8225-829692-1-zoom.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":0,"all_time_quantity_sold":9,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/9f/d3/f4/308f94303899ff2de64a3db4aaee5006.jpg\" alt=\"Máy May Brother AS2730S - Hàng chính hãng\" width=\"750px\" height=\"500px\" /\u003e\u003c/p\u003e\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/f9/96/d4/97a53b002be7dad342820576b8d3f733.jpg\" alt=\"Máy May Brother AS2730S - Hàng chính hãng\" width=\"750px\" height=\"500px\" /\u003e\u003c/p\u003e\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/4e/4c/0c/e3f695b144d24fedd6de15600109dc5c.jpg\" alt=\"Máy May Brother AS2730S - Hàng chính hãng\" width=\"750px\" height=\"500px\" /\u003e\u003c/p\u003e\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/27/37/d4/c13e12cb5fac55118139554127137672.jpg\" alt=\"Máy May Brother AS2730S - Hàng chính hãng\" width=\"750px\" height=\"500px\" /\u003e\u003c/p\u003e\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/07/97/2b/9c8f6641cdec490dd859c0a740f4e87c.jpg\" alt=\"Máy May Brother AS2730S - Hàng chính hãng\" width=\"750px\" height=\"500px\" /\u003e\u003c/p\u003e\u003ch5\u003eThiết kế máy hiện đại\u003c/h5\u003e\n\u003cp\u003e\u003cstrong\u003eMáy May Brother AS2730S\u003c/strong\u003e được thiết kế nhỏ gọn nên bạn dễ dàng di chuyển và xếp đặt. Phù hợp cả với những gian phòng có diện tích hẹp. Tông màu trắng sang trọng cùng với họa tiết hoa anh đào hồng nổi bật trên nên trắng góp phần tô điểm thêm căn phòng nhà bạn.\u003c/p\u003e\n\u003ch5\u003eĐa chức năng may tiện dụng\u003c/h5\u003e\n\u003cp\u003eMáy May AS2730S hơn 27 mũi may cơ bản may được các kiểu zigzag, blind hem, triangle,  Bạn còn có thể điều chỉnh được độ dài và rộng của mũi chỉ để sáng tạo ra nhiều mẫu chỉ khác nhau, giúp bạn may được nhiều loại quần áo cho cả gia đình. Ngoài tính năng may cơn bản máy còn hỗ trợ đính nút, làm khuy một bước, hỗ trợ xỏ chỉ nhanh, mạng vải, Chức năng may kim đôi, hỗ trợ xỏ chỉ nhanh cùng hệ thống suốt chỉ giúp bạn thao tác cực nhanh và các đường may cực kỳ sắc xảo.\u003c/p\u003e\n\u003ch5\u003eChân vịt dễ dàng thay thế\u003c/h5\u003e\n\u003cp\u003ePhần chân vịt dễ dàng tháo lắp, bạn có thể thay đổi nhiều loại chân vịt khác nhau như chân vịt vắt sổ, chân vịt đính ren, chân vịt may viền lai giấu mũi, chân vịt tra khóa, chân vịt thùa khuyế tùy theo nhu cầu sử dụng. Việc thay đổi chân vịt dễ dàng giúp bạn có thể may, vắt sổ, hay đính ren, làm nút trên cùng một sản phẩm.\u003c/p\u003e\n\u003ch5\u003eMay được trên nhiều chất liệu vải\u003c/h5\u003e\n\u003cp\u003eMáy được sản xuất dựa trên công nghệ tiên tiến của Anh cho chất lượng cực kỳ tốt, đảm bảo cho việc may mặc trở nên đơn giản hơn bao giờ hết. Máy có thiết kế gọn nhẹ nhưng có thể may được có thể may trên tất cả các loại vải, kể cả các loại vải cực dày hay những loại vải mỏng như lụa tơ tằm, \u003c/p\u003e\n\u003ch5\u003eMáy hoạt động êm, không gây ồn\u003c/h5\u003e\n\u003cp\u003eCông suất 51 W, máy hoạt động mạnh mẽ, động cơ máy chạy cực êm cho việc sử dụng trở nên dễ dàng và tiết kiệm thời gian, điện năng. Brother AS2703S chạy mượt và êm, ít gây tiếng động ồn ào, khó chịu, ảnh hưởng đến sinh hoạt của các thành viên khác trong gia đình.\u003c/p\u003e\n\u003ch5\u003eTrang bị đèn Led tiện dụng\u003c/h5\u003e\n\u003cp\u003eThiết kế đèn Led chiếu sáng trực tiếp trên máy sẽ giúp bạn nhìn rõ đường kim mũi chỉ ngay cả khi ở môi trường thiếu ánh sáng. Điều này giúp bạn có thể đặt máy may ở bất cứ góc nào trong nhà và cho các thao tác chính xác hơn để có những sản phẩm chuyên nghiệp.\u003c/p\u003e\n\u003ch5\u003ePhụ kiện đi kèm hữu ích\u003c/h5\u003e\n\u003cp\u003eMáy trang bị đầy đủ phụ kiện tiện lợi cho người sử dụng: một bộ dây nguồn và bàn ga, bộ chân vịt gồm chân vịt may thường (chữ J), chân vịt thùa khuyết (chữ A ), chân vịt tra khóa (chữ I), chân vịt đính nút (chữ M), chân vịt lên lai giấu mũi, 4 suốt chỉ (gồm 1 cái theo máy), nắp che răng cưa (dùng khi đính nút), 4 kim đơn (gồm 1 cây theo máy), 1 kim đôi, 1 khóa mở vít, 1 cọc chỉ phụ (dùng khi may kim đôi).\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThông số kỹ thuật:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eLoại: Máy may\u003c/li\u003e\n\u003cli\u003eCông suất: 51 W\u003c/li\u003e\n\u003cli\u003eSố mũi chỉ: 27 mũi\u003c/li\u003e\n\u003cli\u003eĐộ dài mũi chỉ ( tối đa ): 5 mm\u003c/li\u003e\n\u003cli\u003eMàu: Trắng\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/media/catalog/product/m/a/may-theu-brother-as2730s-trang-8225-829692-1-zoom.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/m/a/may-theu-brother-as2730s-trang-8225-829692-1-zoom.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/m/a/may-theu-brother-as2730s-trang-8225-829692-1-zoom.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/m/a/may-th