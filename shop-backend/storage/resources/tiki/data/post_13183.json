n_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":99750,"discount_rate":25,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/a7/be/2b/f1c5853d9f766ec7aef008a3e1fbe9cd.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1225,"all_time_quantity_sold":3,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eQuần short tây nam Novelty in họa tiết 2101400 được may từ chất liệu chọn lọc kết cấu vải tốt, thiết kế tối giản, kiểu dáng trẻ trung mang đến sự mạnh mẽ, lịch lãm cho phái mạnh. Form quần Regular Fit, phù hợp mọi dáng người. Màu sắc tinh tế dễ dàng kết hợp với nhiều trang phục thể hiện gu thời trang riêng của mỗi người. Những chiếc quần nam Novelty sẽ tạo nên phong cách năng động trẻ trung cho chàng. Hãy cùng Novelty trải nghiệm và mua sắm thông minh để bổ sung thêm những mẫu hot cho bộ sưu tập thời trang của mình nào!\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003eĐặc điểm sản phẩm\u003cbr /\u003eThiết kế trẻ trung, cá tính nhưng không kém phần lịch lãm hiện đại\u003cbr /\u003eChất liệu tốt tạo cảm giác dễ chịu, thoải mái suốt ngày dài, mà không lo hầm bí\u003cbr /\u003eMàu sắc hài hòa, tinh tế dễ dàng kết hợp với nhiều trang phục tạo phong cách riêng\u003cbr /\u003eĐường chỉ may sắc sảo, tỉ mỉ và đẹp mắt tạo nên sự bền đẹp cho sản phẩm\u003cbr /\u003ePhù hợp với nhiều độ tuổi và dáng người\u003cbr /\u003e- Họa tiêt in được thiêt kế riêng biệt độc đáo chỉ có ở Novelty\u003cbr /\u003e- Có 5 họa tiết in cho đa dạng sự lựa chọn\u003cbr /\u003e- Có khả năng thấm mồ hôi, hút ẩm cao\u003cbr /\u003e- Nhanh khô sau khi giặt\u003cbr /\u003e- Kiểu dáng thoải mái, tiện lợi trong mọi vận động hàng ngày\u003cbr /\u003e- Chất liệu: 50%Cotton 23%Lyocell 24%Polyester 3%Spandex\u003cbr /\u003e- Form dáng: Regular Fit\u003cbr /\u003eHướng dẫn bảo quản\u003cbr /\u003eGiặt riêng sản phẩm màu sáng và màu tối\u003cbr /\u003eGiặt sản phẩm với nước ở nhiệt độ thường\u003cbr /\u003eKhông nên sử dụng chất tẩy, không xoắn vắt mạnh\u003cbr /\u003eỦi mặt trái sản phẩm và ủi với nhiệt độ không quá 110 độ C\u003cbr /\u003eNên phơi mặt trái sản phẩm và không phơi dưới ánh nắng trực tiếp\u003c/p\u003e\n\u003cp\u003eThông tin thương hiệu\u003cbr /\u003eXuất hiện hơn 10 năm trong thị trường thời trang nam công sở nội địa, Novelty thương hiệu thời trang của Tổng Công ty May Nhà Bè, đã từng bước tạo dựng được niềm tin và dần giành được vị thế trong lòng khách hàng. Với khác biệt trong thiết kế cùng những chuẩn mực thời trang vượt bậc, thương hiệu thời trang Novelty giúp cho khách hàng khoác lên mình phong thái lịch lãm, sang trọng nhưng năng động, hiện đại, đậm cá tính. Đồng thời chất lượng trong từng sản phẩm khiến khách hàng cảm thấy thoải mái, linh hoạt, và tự tin thể hiện phong cách của mình.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/a7/be/2b/f1c5853d9f766ec7aef008a3e1fbe9cd.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a7/be/2b/f1c5853d9f766ec7aef008a3e1fbe9cd.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a7/be/2b/f1c5853d9f766ec7aef008a3e1fbe9cd.jpg","position":null,"small_url":"https://salt.tikicdn