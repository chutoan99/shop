n.com/cache/280x280/ts/product/d7/c7/05/0766969365efcabe7503818413c5317f.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2150,"all_time_quantity_sold":13,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e“\u003cspan style=\"box-sizing: border-box;\"\u003eĐạo tình\u003c/span\u003e” có thể nói là một tác phẩm xuất sắc của dòng tiểu thuyết ngôn tình hắc bang. Tác phẩm là thế giới của xã hội đen, của những cuộc phiêu lưu, những hành trình đầy hiểm nguy và kịch tính. Cũng giống như thế, tình yêu trong “\u003cspan style=\"box-sizing: border-box;\"\u003eĐạo tình\u003c/span\u003e” vừa mãnh liệt lại vừa lạnh lùng, vừa hiển nhiên lại vừa lạ lẫm. Qua ngòi bút cá tính và trí tưởng tượng độc đáo của \u003cspan style=\"box-sizing: border-box;\"\u003eChu Ngọc\u003c/span\u003e, cả một thế giới hiện lên đầy hấp dẫn với vô vàn sắc màu, mỗi nhân vật đều có tính cách riêng và ấn tượng, đặc biệt là cặp nam nữ chính - Tề Mặc và Ly Tâm.\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e“Cô là một trong những siêu trộm nổi tiếng nhất thế kỷ hai mươi mốt.\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003eCô là thần thoại Vua tốc độ bất bại trong thế giới ngầm.\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003eCô là một cô gái tự do như gió.\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003eHắn là truyền kỳ của đế quốc bóng đêm.\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003eMáu lạnh vô tình, thủ đoạn tàn độc.\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003eMột miếng ngọc bích, số mệnh của hai người từ đó cuốn vào nhau.\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003eNgười biến dị trong rừng sâu, Kim Tự Tháp dưới lòng đất, bão xoáy dưới lòng biển sâu…\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003eHắn đưa cô vào thế giới của hắn.\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003eKhông chiến, hải chiến, dã chiến…\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003eDù đứng giữa sống và chết cũng không từ bỏ nhau.\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003eNếu đó không phải là yêu, thì thế nào là yêu?”\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e\u003cspan style=\"box-sizing: border-box;\"\u003e\u003cspan style=\"box-sizing: border-box; text-decoration-line: underline;\"\u003eThông tin tác giả\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e\u003cspan style=\"box-sizing: border-box;\"\u003eChu Ngọc\u003c/span\u003e là nữ tác giả của văn học mạng. Hiện cô là tác giả ký hợp đồng loại A với trang sáng tác Tiêu Tương. Cô từng nói: “Viết văn lúc đầu chỉ là một sở thích, nhưng giờ nó còn quan trọng hơn công việc chính của tôi. Tôi muốn toàn tâm toàn ý sáng tác, không ngừng nỗ lực vì giấc mơ của bản thân mình”.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/d7/c7/05/0766969365efcabe7503818413c5317f.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d7/c7/05/0766969365efcabe7503818413c5317f.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d7/c7/05/0766969365efcabe7503818413c5317f.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d7/c7/05/0766969365efcabe7503818413c5317f.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d7/c7/05/0766969365efcabe7503818413c5317f.jpg"}],"warranty_policy":null,"authors":[{"id":22177,"name":"Chu Ngọc","slug":"chu-ngoc"}],"current_seller":{"id":179295,"sku":"581186094