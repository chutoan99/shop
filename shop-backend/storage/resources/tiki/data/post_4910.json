ull,"text":"9.9"},{"placement":"pdp_badge","code":"is_hero","type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"freeship_xtra","type":"pdp_icon_badge","index":2,"icon":"https://salt.tikicdn.com/ts/upload/be/67/48/04a82ab8df178e1a13bde38316081865.png","icon_width":91,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":true,"return_reason":"any_reason"}},"discount":171000,"discount_rate":37,"rating_average":4.7,"review_count":373,"review_text":"(373)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/b2/b2/d8/17c81c2d7f75201e232e4a6336a67118.png","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1198,"all_time_quantity_sold":1560,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003eDung tích 1.8L đủ dùng hàng ngày\u003c/h3\u003e\n\u003cp\u003e\u003cstrong\u003eẤm Đun Siêu Tốc Inox 2 Lớp Sunhouse SHD1353 (1.8L)\u003c/strong\u003e có dung tích lớn 1.8 lít cùng công suất hoạt động cao (1500W) giúp việc đun nước nhanh chóng hơn, tiết kiệm thời gian và điện năng tối đa.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/88/5c/a7/5d9349bdb6f4762e36fbed97adab8415.jpg\" alt=\"\" width=\"750\" height=\"502\" /\u003e\u003c/p\u003e\n\u003cp\u003eKhông chỉ là một thiết bị nhà bếp, ấm siêu tốc Sunhouse SHD1353 còn là một vật trang trí tinh tế cho căn bếp, thể hiện mắt thẩm mỹ của chủ nhà.\u003c/p\u003e\n\u003ch3\u003eThân ấm 2 lớp chống bỏng\u003c/h3\u003e\n\u003cp\u003eLớp bên trong ấm siêu tốc làm từ inox 304 có độ bền cao, đun sôi nhanh và dễ vệ sinh. Đây là loại chất liệu có khả năng chống ăn mòn tuyệt vời ngay cả khi tiếp xúc với nhiều loại thực phẩm hay hóa chất khác nhau ở nhiệt độ cao.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/e2/e2/1c/3198a6226794b477d5d565a3ecddef7f.jpg\" alt=\"\" width=\"750\" height=\"502\" /\u003e\u003c/p\u003e\n\u003cp\u003eLớp ngoài của ấm siêu tốc là nhựa PP cách nhiệt giúp giảm nguy cơ bị bỏng khi chạm phải. Nhựa PP có đặc điểm không mùi, không vị, không độc, có độ bóng bề mặt cao và chịu nhiệt tốt nên được sử dụng rất phổ biến trong thiết kế các đồ gia dụng.\u003c/p\u003e\n\u003ch3\u003eTay cầm cách nhiệt\u003c/h3\u003e\n\u003cp\u003eẤm siêu tốc Sunhouse SHD1353 được thiết kế với dáng đứng thon gọn, với tay cầm bằng nhựa cao cấp và cách nhiệt tốt giúp bạn yên tâm không bị nóng bỏng tay khi sử dụng ấm đang chứa nước sôi.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/6b/b8/df/9447847eda185ac8444de3c54b99086f.jpg\" alt=\"\" width=\"750\" height=\"502\" /\u003e\u003c/p\u003e\n\u003cp\u003eCông tắc nguồn được thiết kế dạng nút bấm với vị trí thuận tiện trên tay cầm giúp thao tác đơn giản, nhanh gọn.\u003c/p\u003e\n\u003cp\u003eĐặc biệt, ấm siêu tốc Sunhouse SHD1353 còn được trang bị đèn báo hoạt động vừa tiện lợi, vừa tăng tính thẩm mỹ cho sản phẩm.\u003c/p\u003e\n\u003ch3\u003eĐáy liền dập sâu đặc biệt\u003c/h3\u003e\n\u003cp\u003eLớp inox bên trong ấm được thiết kế dạng dập theo khuôn chứ không phải đáy hàn, do đó tuyệt đối sẽ không có tình trạng rò rỉ nước trong quá trình đun hay trong thời gian dài sử dụng. Điều này cũng hạn chế tình trạng han gỉ (do các mối hàn kim loại), bảo đảm sức khỏe cho người sử dụng.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/38/5b/6c/aa59f702d79f9274ff8b15a570a5497c.jpg\" alt=\"\" width=\"750\" height=\"502\" /\u003e\u003c/p\u003e\n\u003ch3\u003eThân ấm xoay 360 độ linh hoạt trên đế tiếp điện\u003c/h3\u003e\n\u003cp\u003eĐế tiếp điện được thiết kế độc lập, tách rời khỏi thân ấm, giúp việc đổ nước – tiếp nước dễ dàng, linh hoạt. Ấm siêu tốc có thể xoay 360 độ trên đế tiếp điện, người dùng có thể đặt ấm lên hay nhấc ấm ra khỏi đế ở bất cứ góc nào mà không phải lo lắng đến vấn đề phải đặt sao cho khớp.\u003c/p\u003e\n\u003ch3\u003eTiết kiệm điện năng, an toàn khi đun nước\u003c/h3\u003e\n\u003cp\u003eẤm siêu tốc Sunhouse SHD1353 với công suất mạnh 1500W cho thời gian nấu nước nhanh chóng, giúp tiết kiệm điện năng tối đa, đồng thời không sản sinh ra các chất độc hại dưới tác động của nhiệt độ cao.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/d8/c9/1d/f84c37584f2f95e41cf14f4631c3b421.jpg\" alt=\"\" width=\"750\" height=\"502\" /\u003e\u003c/p\u003e\n\u003ch3\u003eChế độ tự động tắt khi nước sôi, cạn nước hoặc quá nhiệt\u003c/h3\u003e\n\u003cp\u003eẤm siêu tốc có chế độ ngắt tự động khi nước sôi hoặc cạn nước, đảm bảo an toàn tối đa cho người sử dụng (quên/bận rộn công việc khác). Chức năng này còn giúp làm tăng tuổi thọ sản phẩm và phòng chống cháy nổ.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/f7/7e/06/2d35040d2703c2f69b541ea336635f7b.jpg\" alt=\"\" width=\"750\" height=\"502\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/b2/b2/d8/17c81c2d7f75201e232e4a6336a67118.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b2/b2/d8/17c81c2d7f75201e232e4a6336a67118.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b2/b2/d8/17c81c2d7f75201e232e4a6336a67118.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b2/b2/d8/17c81c2d7f75201e232e4a6336a67118.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b2/b2/d8/17c81c2d7f75201e232e4a6336a67118.png"},{"base_url":"https://salt.tikicdn.com/ts/product/5a/55/37/e41574741ca16e22abf5c73dca10435b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/5a/55/37/e41574741ca16e22abf5c73dca10435b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/5a/55/37/e41574741ca16e22abf5c73dca10435b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5a/55/37/e41574741ca16e22abf5c73dca10435b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5a/55/37/e41574741ca16e22abf5c73dca10435b.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/d0/23/4a/2c32363cb40c155c6796f98423fb634a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d0/23/4a/2c32363cb40c155c6796f98423fb634a.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d0/23/4a/2c32363cb40c155c6796f98423fb634a.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d0/23/4a/2c32363cb40c155c6796f98423fb634a.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d0/23/4a/2c32363cb40c155c6796f98423fb634a.jpg"},{"base_url":"https://salt.t