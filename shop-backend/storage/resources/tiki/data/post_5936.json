ht":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.5,"review_count":107,"review_text":"(107)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/44/50/1d/8a9993961d01095306f626545ebbfd58.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2265,"all_time_quantity_sold":428,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch5\u003eThiết kế thời trang, gọn gàng\u003c/h5\u003e\n\u003cp\u003e\u003cstrong\u003eĐế Tản Nhiệt Laptop N99 2 Fan\u003c/strong\u003e đế nâng có thiết kế tương đối nhỏ gọn, phong cách trẻ trung. Khung bên ngoài làm bằng chất liệu nhựa bóng có độ bền khá cao, chống lại va đập. Phía dưới là nhiều rãnh thoáng để giúp thoát khí nóng và đối lưu luồng khí tốt cho laptop.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/fb/91/31/572fbfe584b03f03cb599b31eab1a39c.jpg\" alt=\"Đế Tản Nhiệt Laptop N99 2 Fan\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003ch5\u003e2 quạt tản nhiệu tối ưu khả năng làm mát\u003c/h5\u003e\n\u003cp\u003eHai quạt gió lớn được thiết kế ở trung tâm với kích thước 12cm mỗi quạt,công suất quạt lớn giúp tản nhiệt và mát laptop hiệu quả nhanh chóng.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/95/b4/a3/c6992bb2eac27ea192614c0ddfd0fa92.jpg\" alt=\"Đế Tản Nhiệt Laptop N99 2 Fan\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003ch5\u003eTùy chỉnh độ nghiêng tiện dụng\u003c/h5\u003e\n\u003cp\u003eNhư các loại đế tản nhiệt cho laptop thông thường trên thị trường chỉ có 1 khấc duy nhất để điều chỉnh độ nghiêng cố định thì với N99 bạn có thể điều chỉnh tới 5 mức độ từ 0 độ tới 45 độ để phù hợp với nhu cầu. \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ee/d5/bf/9d215eaf6ab45ec9af42a254115dccea.jpg\" alt=\"Đế Tản Nhiệt Laptop N99 2 Fan\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003ch5\u003eKhả năng chống trượt hiệu quả\u003c/h5\u003e\n\u003cp\u003eNgoài ra, để chống laptop bị trơn trượt khi để trên bề mặt đế tản nhiệt với độ ngiêng lớn, N99 còn được thiết kế thêm chân chặn ở giữa với chiều dài 10cm có thể gập ra vào. Nhờ đó bạn không còn lo lắng laptop để trên thiết bị này bị trượt hoặc rơi nữa nhé.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/63/23/bf/558cccb46ec1da2bc4741dd6de945c02.jpg\" alt=\"Đế Tản Nhiệt Laptop N99 2 Fan\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003ch5\u003eKết nối USB dễ dàng, nhang chóng\u003c/h5\u003e\n\u003cp\u003eThiết bị dùng cổng USB dễ dàng kết nối thông qua 2 cổng usb 2.0. Bạn chỉ cần kết nối với laptop là đế đã có thể làm việc ngay lập tức.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/9b/68/13/2fc815afbbb7298927b2483096bffe4d.jpg\" alt=\"Đế Tản Nhiệt Laptop N99 2 Fan\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003ch5\u003eLưới bảo vệ an toàn, tản nhiệt nhanh\u003c/h5\u003e\n\u003cp\u003eBề mặt đế tản nhiệt N99 thiết kế dạng mắt lưới được làm bằng chất liệu hợp kim phủ sơn bên ngoài nhằm chống han rỉ và sự oxi hóa khi sử dụng lâu dài sau này,đảm bảo tính thẩm mỹ. Với hàng trăm mắt lưới như vậy, việc tản nhiệt cho laptop cũng sẽ đươc tốt hơn vì luồng khí được phân bổ đều để làm mát laptop nhanh chóng.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/39/01/af/f6c95158c6bc659be36dca1235074f7b.jpg\" alt=\"Đế Tản Nhiệt Laptop N99 2 Fan\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/44/50/1d/8a9993961d01095306f626545ebbfd58.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/44/50/1d/8a9993961d01095306f626545ebbfd58.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/44/50/1d/8a9993961d01095306f626545ebbfd58.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/44/50/1d/8a9993961d01095306f626545ebbfd58.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/44/50/1d/8a9993961d01095306f626545ebbfd58.png"},{"base_url":"https://salt.tikicdn.com/ts/product/34/c5/55/d650c65cb48412564fa6b0b43ad2f7c0.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/34/c5/55/d650c65cb48412564fa6b0b43ad2f7c0.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/34/c5/55/d650c65cb48412564fa6b0b43ad2f7c0.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/34/c5/55/d650c65cb48412564fa6b0b43ad2f7c0.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/34/c5/55/d650c65cb48412564fa6b0b43ad2f7c0.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/00/e6/47/a59cda61714827a28c0e354dd17d09c2.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/00/e6/47/a59cda61714827a28c0e354dd17d09c2.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/00/e6/47/a59cda61714827a28c0e354dd17d09c2.jpg","position":null,"small_url":"ht