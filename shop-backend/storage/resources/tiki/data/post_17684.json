olor":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"defective_product"}},"discount":425000,"discount_rate":19,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/59/6e/25/1f03d95c6469e46813bc0ebfd0389f2a.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1035,"all_time_quantity_sold":4,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eDung tích: 100ml\u003c/p\u003e\n\u003cp\u003eNăm ra mắt: 2021\u003c/p\u003e\n\u003cp\u003eNồng độ: Eau De Toilette\u003c/p\u003e\n\u003cp\u003eĐộ lưu hương: 5 giờ đến 6 giờ\u003c/p\u003e\n\u003cp\u003eĐộ toả hương: Rất xa\u003c/p\u003e\n\u003cp\u003eThời điểm khuyên dùng: Hàng Ngày\u003c/p\u003e\n\u003cp\u003eHương Đầu: Kẹo Trái Cây, Cam Đắng, Chanh Vàng\u003c/p\u003e\n\u003cp\u003eHương giữa: Kẹo Cao Su, Hoa Hồng, Việt Quất, Quế, Đào, Gừng, Hoa Anh Đào\u003c/p\u003e\n\u003cp\u003eHương cuối: Ambroxan, Tuyết Tùng, Xạ Hương\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"wp-image-35733 aligncenter\" style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/9d/81/00/0853944774947b906b622b99e1a4aa43.jpg\" alt=\"\" width=\"392\" height=\"392\" /\u003e\u003c/p\u003e\n\u003cp\u003eTôi nghĩ rằng Moschino đã là một thương hiệu đặc biệt về thời trang và nước hoa trong quá khứ, nhưng nước hoa bằng cách nào đó đã không mấy thành công, cho đến khi họ ra mắt loạt Toy, đặc biệt là Toy 2 và Toy Boy. Hai dòng nước này đã từng gây sóng trong cộng đồng nước hoa quốc tế trong vài năm qua và Toy 2 Bubble Gum hứa hẹn cũng sẽ có được những tiếng vang tương tự.\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"wp-image-35730 aligncenter\" style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/1d/c7/63/0a6370a5b569a544720f9989f0ae45bb.jpg\" alt=\"\" width=\"479\" height=\"479\" /\u003e\u003c/p\u003e\n\u003cp\u003eMùi hương này có sự tươi mát của trái cây, cam quýt, đào và hương hoa. Nhưng cảm giác nó đã gói một lượng kha khá đường. Sau đó, nó biến đổi thành một hương hoa trái cây cực kỳ ngọt ngào. Tầng hương giữa bùng nổ trong hương quế, những bông hoa trừu tượng với hoa Hồng lấp ló qua chúng và sự kết hợp Vani - Caramel - Tonka siêu nồng nhiệt để chấm dứt mọi cơn thèm đường qua khứu giác. Và tâm hương mạnh mẽ này theo bạn khắp mọi nơi trong nhiều giờ. Quả lý chua đen cũng có góp mặt, nhưng không phải với khía cạnh xanh vờn cỏ cây của nó mà như kiểu một loại siro vị trái cây. Trên thực tế, siro là từ để mô tả tốt nhất sự pha chế này, ngay cả khi có những khía cạnh thủy sinh, thiên nhiên để mang lại chút ánh sáng cho nó.\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"wp-image-35732 aligncenter\" style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/6e/e1/fd/166b790407fced1803e1bc733df611e3.jpg\" alt=\"\" width=\"431\" height=\"574\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/59/6e/25/1f03d95c6469e46813bc0ebfd0389f2a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/59/6e/25/1f03d95c6469e46813bc0ebfd0389f2a.jpg","medium_url":"https://salt.tikicdn.c