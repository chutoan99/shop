son"}},"discount":0,"discount_rate":0,"rating_average":4.5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/41/72/df/c35efaf82ff5676c52950b9505054aa1.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1890,"all_time_quantity_sold":10,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<h2 style=\"margin: 0px 0px 20px; padding: 0px; list-style: none; border: 0px; font-size: 15px; outline: none; color: #525050; font-family: Tahoma;\" data-field=\"sapo\">Cùng điểm mặt 10 điều thú vị của Smash Bros. Ultimate do chính các fan khám phá ra nhé!</h2>\n<div style=\"margin: 0px; padding: 0px; list-style: none; border: 0px; font-size: 12px; outline: none; color: #333333; font-family: Tahoma;\" data-check-position=\"gamek_detail_position_start\"> </div>\n<div class=\"rightdetail_content\" style=\"margin: 0px; padding: 0px; list-style: none; border: 0px; font-variant-numeric: normal; font-variant-east-asian: normal; font-stretch: normal; font-size: 17px; line-height: 23px; font-family: 'Times New Roman'; outline: none; color: #333333;\" data-field=\"body\">\n<p class=\"\" style=\"margin: 0px; padding: 0px 0px 20px; list-style: none; border: 0px; outline: none;\">Ít nhất trong 6 tháng tới chúng ta vẫn chưa thể sở hữu Smash Bros. Ultimate trên tay. Nhưng trong thời gian đó, các fan của series này đã kịp tìm ra không ít điều mới mẻ hay ho. Cùng điểm mặt 10 điều thú vị của Smash Bros. Ultimate do chính fan khám phá nhé!</p>\n<p class=\"\" style=\"margin: 0px; padding: 0px 0px 20px; list-style: none; border: 0px; outline: none;\"><strong style=\"margin: 0px; padding: 0px; list-style: none; border: 0px; outline: none;\">1. Cuối cùng thì, Toad cũng trở thành anh hùng</strong></p>\n<div class=\"VCSortableInPreviewMode noCaption active\" style=\"margin: 0px 0px 10px; padding: 0px; list-style: none; border: 0px; outline: none; font-style: italic; text-align: center;\">\n<div style=\"margin: 0px; padding: 0px; list-style: none; border: 0px; outline: none;\"></div>\n<div class=\"PhotoCMS_Caption\" style=\"margin: 0px; padding: 0px; list-style: none; border: 0px; outline: none; min-height: 0px;\"> </div>\n</div>\n<p class=\"\" style=\"margin: 0px; padding: 0px 0px 20px; list-style: none; border: 0px; outline: none;\">Bắt đầu từ khi ra mắt cùng Peach trong Super Smash Bros. Melee, Toad chỉ xuất hiện với duy nhất một nhiệm vụ: làm tấm khiên sống cho nàng công chúa của anh. Toad luôn phải chống lại những cuộc tấn công trong thế bị động không chuẩn bị trước. Nhưng tất cả đã thay đổi trong Smash Bros. Ultimate trên Nintendo Switch, Toad sẵn sàng nhảy ra đứng chắn bảo vệ Peach. Không còn là công cụ trong tay ai nữa, Toad tỏa sáng như một người hùng đích thực.</p>\n<div class=\"VCSortableInPreviewMode noCaption\" style=\"margin: 0px 0px 10px; padding: 0px; list-style: none; border: 0px; outline: none; font-style: italic; text-align: center;\">\n<div style=\"margin: 0px; padding: 0px; list-style: none; border: 0px; outline: none;\"></div>\n<div class=\"PhotoCMS_Caption\" style=\"margin: 0px; padding: 0px; list-style: none; border: 0px; outline: none; min-height: 0px;\"> </div>\n</div>\n<p class=\"\" style=\"margin: 0px; padding: 0px 0px 20px; list-style: none; border: 0px; outline: none;\"><strong style=\"margin: 0px; padding: 0px; list-style: none; border: 0px; outline: none;\">2. Bàn chơi gợi nhớ về quá khứ huy hoàng của Smash Bros.</strong></p>\n<div class=\"VCSortableInPreviewMode noCaption\" style=\"margin: 0px 0px 10px; padding: 0px; list-style: none; border: 0px; outline: none; font-style: italic; text-align: center;\">\n<div style=\"margin: 0px; padding: 0px; list-style: none; border: 0px; outline: none;\"></div>\n<div class=\"PhotoCMS_Caption\" style=\"margin: 0px; padding: 0px; list-style: none; border: 0px; outline: none; min-height: 0px;\"> </div>\n</div>\n<p class=\"\" style=\"margin: 0px; padding: 0px 0px 20px; list-style: none; border: 0px; outline: none;\">Battlefield stage đã trở thành một biểu tượng của series kể từ Melee (hoặc từ N64, nếu tính cả Duel Zone). Trong phiên bản Ultimate, nó được mô phỏng sắc nét hơn bao giờ hết. Nếu nhìn kĩ bạn sẽ nhận ra bốn hòn đảo nổi lơ lửng trong background, như là một ám chỉ về bốn game Smash Bros từng ra mắt trước đó. Thật tuyệt khi tưởng tượng rằng bốn trận chiến khác đang diễn ra cùng lúc khi bạn đang chiến đấu trên Battlefield.</p>\n<div class=\"VCSortableInPreviewMode noCaption\" style=\"margin: 0px 0px 10px; padding: 0px; list-style: none; border: 0px; outline: none; font-style: italic; text-align: center;\">\n<div style=\"margin: 0px; padding: 0px; list-style: none; border: 0px; outline: none;\"></div>\n<div class=\"PhotoCMS_Caption\" style=\"margin: 0px; padding: 0px; list-style: none; border: 0px; outline: none; min-height: 0px;\"> </div>\n</div>\n<p class=\"\" style=\"margin: 0px; padding: 0px 0px 20px; list-style: none; border: 0px; outline: none;\"><strong style=\"margin: 0px; padding: 0px; list-style: none; border: 0px; outline: none;\">3. Khả năng sao chép mới của Kirby</strong></p>\n<div class=\"VCSortableInPreviewMode noCaption\" style=\"margin: 0px 0px 10px; padding: 0px; list-style: none; border: 0px; outline: none; font-style: italic; text-align: center;\">\n<div style=\"margin: 0px; padding: 0px; list-style: none; border: 0px; outline: none;\"></div>\n<div class=\"PhotoCMS_Caption\" style=\"margin: 0px; padding: 0px; list-style: none; border: 0px; outline: none; min-height: 0px;\"> </div>\n</div>\n<p class=\"\" style=\"margin: 0px; padding: 0px 0px 20px; list-style: none; border: 0px; outline: none;\">Kirby vốn nổi tiếng với khả năng sao chép vượt trội của mình, không chỉ ở trong tựa game gốc mà còn cả trò chơi toàn những ngôi sao của Nintendo như Smash Bros. Trong phiên bản lần này, nhà sản xuất đã thêm vào hai phiên bản mới là Ridley và Inkling version Kirby, làm dày thêm danh sác vốn đã rất dài những phiên bản sao chép của Kirby. Nhưng cũng chẳng có vấn đề gì cả, vì Kirby vốn đã đáng yêu mà, thêm vài bản nữa cũng có sao đâu?</p>\n<p class=\"\" style=\"margin: 0px; padding: 0px 0px 20px; list-style: none; border: 0px; outline: none;\"><span style=\"margin: 0px; padding: 0px; list-style: none; border: 0px; outline: none;\"><strong style=\"margin: 0px; padding: 0px; list-style: none; border: 0px; outline: none;\">4. Trang phục của huấn luyện viên Pokemon được làm giống bản gốc</strong></span></p>\n<div class=\"VCSortableInPreviewMode noCaption\" style=\"margin: 0px 0px 10px; padding: 0px; list-style: none; border: 0px; outline: none; font-style: italic; text-align: center;\">\n<div style=\"margin: 0px; padding: 0px; list-style: none; border: 0px; outline: none;\"></div>\n<div class=\"PhotoCMS_Caption\" style=\"margin: 0px; padding: 0px; list-style: none; border: 0px; outline: none; min-height: 0px;\"> </div>\n</div>\n<p class=\"\" style=\"margin: 0px; padding: 0px 0px 20px; list-style: none; border: 0px; outline: none;\">Khi Nintendo tuyên bố rằng \"Everyone is here\", thì nó chính xác là như vậy. Không chỉ có các Pokemon, mà cả các huấn luyện viên Pokemon đã trở lại với hai phiên bản nam và nữ để người chơi thoải mái lựa chọn. Trên hết, trang phục của các huấn luyện viên đều được thực hiện dựa trên những phiên bản game Pokemon cũ. Điều này có vẻ nhỏ nhặt, nhưng đủ cho thấy Nintendo trân trọng lịch sử cũng như những fan đã gắn bó lâu năm với mình đến thế nào.</p>\n<div class=\"VCSortableInPreviewMode noCaption\" style=\"margin: 0px 0px 10px; padding: 0px; list-style: none; border: 0px; outline: none; font-style: italic; text-align: center;\">\n<div style=\"margin: 0px; padding: 0px; list-style: none; border: 0px; outline: none;\"></div>\n<div class=\"PhotoCMS_Caption\" style=\"margin: 0px; padding: 0px; list-style: none; border: 0px; outline: none; min-height: 0px;\"> </div>\n</div>\n<p class=\"\" style=\"margin: 0px; padding: 0px 0px 20px; list-style: none; border: 0px; outline: none;\"><strong style=\"margin: 0px; padding: 0px; list-style: none; border: 0px; outline: none;\">5. Cảnh nhật thực ở phía sau màn chơi Battlefield</strong></p>\n<div class=\"VCSortableInPreviewMode noCaption\" style=\"margin: 0px 0px 10px; padding: 0px; list-style: none; border: 0px; outline: none; font-style: italic; text-align: center;\">\n<div style=\"margin: 0px; padding: 0px; list-style: none; border: 0px; outline: none;\"></div>\n<div class=\"PhotoCMS_Caption\" style=\"margin: 0px; padding: 0px; list-style: none; border: 0px; outline: none; min-height: 0px;\"> </div>\n</div>\n<p class=\"\" style=\"margin: 0px; padding: 0px 0px 20px; list-style: none; border: 0px; outline: none;\">Hầu hết các màn chơi trong Smash Bros. có hiệu ứng hào nhoáng ở cả phần phía trước và phía sau của hậu cảnh. Thế nhưng, riêng với màn chơi Battlefield thì lại chẳng có gì màu mè hết, có thế nào hiện lên thế đấy. Tuy vậy, nếu chú ý một chút vào phía sau background của Ultimate Battlefield, bạn đôi khi sẽ thấy nhật thực xuất hiện, lúc đó stage sẽ tối đi một chút. Đây có thể không phải một easter egg, nhưng vẫn là một chi tiết đẹp rất đáng chú ý.</p>\n<div class=\"VCSortableInPreviewMode GifPhoto noCaption\" style=\"margin: 0px 0px 10px; padding: 0px; list-style: none; border: 0px; outline: none; font-style: italic; text-align: center;\">\n<div style=\"margin: 0px; padding: 0px; list-style: none; border: 0px; outline: none;\">\n<div id=\"wrapt-gif-1\" class=\"wrapt-gif\" style=\"margin: 0px auto; padding: 0px; list-style: none; border: 0px; outline: none; position: relative; width: 503px;\"><img id=\"img_27ec5190-72c6-11e8-bd62-09a0c26779e5\" class=\"lightbox-content gif-content\" style=\"margin: 0px; padding: 0px; list-style: none; border: 0px; font-size: 0px; outline: none; color: transparent; vertical-align: middle; max-width: 100%; width: 503px; display: block;\" title=\"10 điều thú vị trong phiên bản Smash Bros. mới mà chỉ fan ruột mới nhận ra - Ảnh 9.\" src=\"https://salt.tikicdn.com/ts/product/fd/65/de/0ca5922cab54325c8a0ee73a122f82ec.png\" alt=\"10 điều thú vị trong phiên bản Smash Bros. mới mà chỉ fan ruột mới nhận ra - Ảnh 9.\" width=\"503px\" height=\"\" data-original=\"https://salt.tikicdn.com/ts/product/bb/bf/c5/a7942e87b58699140b288c0566404301.gif\" />\n<div class=\"gif-notify pause\" style=\"margin: 0px; padding: 9px 10px; list-style: none; border: 0px; font-size: 24px; outline: none; position: absolute; bottom: 0px; left: 0px; background-color: rgba(0, 0, 0, 0.5); color: #ffffff; font-weight: bold; cursor: pointer;\"> </div>\n</div>\n</div>\n<div class=\"PhotoCMS_Caption\" style=\"margin: 0px; padding: 0px; list-style: none; border: 0px; outline: none; min-height: 0px;\"> </div>\n</div>\n<div id=\"admzone508553\" class=\"wp100 mt-10\" style=\"margin: 0px; padding: 0px; list-style: none; border: 0px; outline: none;\">\n<div id=\"ads_zone508553\" style=\"margin: 0px; padding: 0px; list-style: none; border: 0px; outline: none;\">\n<div id=\"ads_zone508553_slot1\" style=\"margin: 0px; padding: 0px; list-style: none; border: 0px; outline: none;\"> </div>\n</div>\n</div>\n<p class=\"\" style=\"margin: 0px; padding: 0px 0px 20px; list-style: none; border: 0px; outline: none;\"><strong style=\"margin: 0px; padding: 0px; list-style: none; border: 0px; outline: none;\">6. Biểu tượng mới cho Mr. Game and Watch</strong></p>\n<div class=\"VCSortableInPreviewMode noCaption\" style=\"margin: 0px 0px 10px; padding: 0px; list-style: none; border: 0px; outline: none; font-style: italic; text-align: center;\">\n<div style=\"margin: 0px; padding: 0px; list-style: none; border: 0px; outline: none;\"></div>\n<div class=\"PhotoCMS_Caption\" style=\"margin: 0px; padding: 0px; list-style: none; border: 0px; outline: none; min-height: 0px;\"> </div>\n</div>\n<p class=\"\" style=\"margin: 0px; padding: 0px 0px 20px; list-style: none; border: 0px; outline: none;\">Về lý thuyết, Mr. Game and Watch là nhân vật dễ tạo hình nhất. Anh chỉ là một nhân vật hai chiều, không có quá nhiều chuyển động. Mặc dù vậy, Nintendo đã không hời hợt mà bỏ qua nhân vật này. Trong Smash Ultimate, Mr. Game và Watch vẫn tung hứng rồi ném đối thủ của mình như mọi khi, nhưng giờ thứ mà anh tung hứng là một biểu tượng được tạo ra đại diện cho mỗi một nhân vật tương ứng.</p>\n<p class=\"\" style=\"margin: 0px; padding: 0px 0px 20px; list-style: none; border: 0px; outline: none;\"><strong style=\"margin: 0px; padding: 0px; list-style: none; border: 0px; outline: none;\">7. Pit mù chữ được Nintendo ngấm ngầm thừa nhận là thật</strong></p>\n<div class=\"VCSortableInPreviewMode noCaption\" style=\"margin: 0px 0px 10px; padding: 0px; list-style: none; border: 0px; outline: none; font-style: italic; text-align: center;\">\n<div style=\"margin: 0px; padding: 0px; list-style: none; border: 0px; outline: none;\"></div>\n<div class=\"PhotoCMS_Caption\" style=\"margin: 0px; padding: 0px; list-style: none; border: 0px; outline: none; min-height: 0px;\"> </div>\n</div>\n<p class=\"\" style=\"margin: 0px; padding: 0px 0px 20px; list-style: none; border: 0px; outline: none;\">Khá nhiều thông tin thú vị đã được công khai trong buổi stream của Nintendo E3 Treehouse tuần này, bao gồm cả chuyện của Pit. Khi Pit bị ném khỏi stage trong Ultimate, anh đã hét lên \"I never learned to reaaaad!\". Có thể đây chỉ là một trò đùa vô thưởng vô phạt, cũng có thể nó thực sự liên quan đến câu chuyện thật nào đó, họa có trời mới biết.</p>\n<p class=\"\" style=\"margin: 0px; padding: 0px 0px 20px; list-style: none; border: 0px; outline: none;\"><strong style=\"margin: 0px; padding: 0px; list-style: none; border: 0px; outline: none;\">8. Vũ khí mới của Link</strong></p>\n<div class=\"VCSortableInPreviewMode noCaption\" style=\"margin: 0px 0px 10px; padding: 0px; list-style: none; border: 0px; outline: none; font-style: italic; text-align: center;\">\n<div style=\"margin: 0px; padding: 0px; list-style: none; border: 0px; outline: none;\"></div>\n<div class=\"PhotoCMS_Caption\" style=\"margin: 0px; padding: 0px; list-style: none; border: 0px; outline: none; min-height: 0px;\"> </div>\n</div>\n<p class=\"\" style=\"margin: 0px; padding: 0px 0px 20px; list-style: none; border: 0px; outline: none;\">Khi Link chuyển sang dạng Breath of the Wild trong Smash Ultimate, trang bị của anh cũng thay đổi. Anh ta không còn hookshot nữa, nhưng bù lại là những quả bom điều khiển từ xa tiện lợi. Trên hết, Master Sword của Ultimate Link đã được kéo dài để phản ánh đúng kích thước của nó trong BotW. Link sử dụng Guardian Arrows cho Final Smash. Như một phần thưởng nhỏ, anh cũng có thể thu lại những mũi tên sau khi bắn chúng, tương tự với Breath of the Wild.</p>\n<div class=\"VCSortableInPreviewMode GifPhoto noCaption\" style=\"margin: 0px 0px 10px; padding: 0px; list-style: none; border: 0px; outline: none; font-style: italic; text-align: center;\">\n<div style=\"margin: 0px; padding: 0px; list-style: none; border: 0px; outline: none;\">\n<div id=\"wrapt-gif-2\" class=\"wrapt-gif\" style=\"margin: 0px auto; padding: 0px; list-style: none; border: 0px; outline: none; position: relative; width: 503px;\"><img id=\"img_26f74dc0-72c7-11e8-bd62-09a0c26779e5\" class=\"lightbox-content gif-content\" style=\"margin: 0px; padding: 0px; list-style: none; border: 0px; font-size: 0px; outline: none; color: transparent; vertical-align: middle; max-width: 100%; width: 503px; display: block;\" title=\"10 điều thú vị trong phiên bản Smash Bros. mới mà chỉ fan ruột mới nhận ra - Ảnh 13.\" src=\"https://salt.tikicdn.com/ts/product/e2/e9/75/c987ef40d8446c182e569fbc57f299cb.png\" alt=\"10 điều thú vị trong phiên bản Smash Bros. mới mà chỉ fan ruột mới nhận ra - Ảnh 13.\" width=\"503px\" height=\"\" data-original=\"https://salt.tikicdn.com/ts/product/48/c8/26/a1f04f9f00d0c4626ec4884019041765.gif\" />\n<div class=\"gif-notify pause\" style=\"margin: 0px; padding: 9px 10px; list-style: none; border: 0px; font-size: 24px; outline: none; position: absolute; bottom: 0px; left: 0px; background-color: rgba(0, 0, 0, 0.5); color: #ffffff; font-weight: bold; cursor: pointer;\"> </div>\n</div>\n</div>\n<div class=\"PhotoCMS_Caption\" style=\"margin: 0px; padding: 0px; list-style: none; border: 0px; outline: none; min-height: 0px;\"> </div>\n</div>\n<p class=\"\" style=\"margin: 0px; padding: 0px 0px 20px; list-style: none; border: 0px; outline: none;\"><strong style=\"margin: 0px; padding: 0px; list-style: none; border: 0px; outline: none;\">9. Màn chơi thành phố <span style=\"margin: 0px; padding: 0px; list-style: none; border: 0px; outline: none;\">Saffron City hệt như trên Gameboy ngày nào</span></strong></p>\n<div class=\"VCSortableInPreviewMode noCaption\" style=\"margin: 0px 0px 10px; padding: 0px; list-style: none; border: 0px; outline: none; font-style: italic; text-align: center;\">\n<div style=\"margin: 0px; padding: 0px; list-style: none; border: 0px; outline: none;\"></div>\n<div class=\"PhotoCMS_Caption\" style=\"margin: 0px; padding: 0px; list-style: none; border: 0px; outline: none; min-height: 0px;\"> </div>\n</div>\n<p class=\"\" style=\"margin: 0px; padding: 0px 0px 20px; list-style: none; border: 0px; outline: none;\">Smash Ultimate đem tới sự trở lại của rất nhiều điều thú vị, trong đó có cả các màn chơi cũ từ ngày xửa ngày xưa, trong đó có cả màn chơi thành phố trong Pokemon. Để giữ nguyên nét xưa cũ trong trò chơi, nhà sản xuất đã làm nguyên lại màn chơi này hệt như 20 năm trước với đồ họa đúng theo phong cách Gameboy. Nintendo xứng đáng nhận được một tràng pháo tay với sự chăm chút đáng nể này.</p>\n<div class=\"VCSortableInPreviewMode noCaption\" style=\"margin: 0px 0px 10px; padding: 0px; list-style: none; border: 0px; outline: none; font-style: italic; text-align: center;\">\n<div style=\"margin: 0px; padding: 0px; list-style: none; border: 0px; outline: none;\"></div>\n<div class=\"PhotoCMS_Caption\" style=\"margin: 0px; padding: 0px; list-style: none; border: 0px; outline: none; min-height: 0px;\"> </div>\n</div>\n<p class=\"\" style=\"margin: 0px; padding: 0px 0px 20px; list-style: none; border: 0px; outline: none;\"><strong style=\"margin: 0px; padding: 0px; list-style: none; border: 0px; font-size: 12pt; outline: none;\">10. Sự trở lại của của người anh hùng Snake</strong></p>\n<div class=\"VCSortableInPreviewMode noCaption\" style=\"margin: 0px 0px 10px; padding: 0px; list-style: none; border: 0px; outline: none; font-style: italic; text-align: center;\">\n<div style=\"margin: 0px; padding: 0px; list-style: none; border: 0px; outline: none;\"></div>\n<div class=\"PhotoCMS_Caption\" style=\"margin: 0px; padding: 0px; list-style: none; border: 0px; outline: none; min-height: 0px;\"> </div>\n</div>\n<p class=\"\" style=\"margin: 0px; padding: 0px 0px 20px; list-style: none; border: 0px; outline: none;\">Thật ngạc nhiên khi thấy Snake quay trở lại, sau khi bị đánh giá là một game kém thu hút người chơi. Snake đã quay lại, giữ nguyên vẹn những gì từng xuất hiện trong phiên bản đầu, duy chỉ có thay đổi khá dễ nhận thấy nằm ở chiếc logo. Một chi tiết hài hước nữa cũng được fan tinh ý mới nhận ra được: dường như mông của Snake lép hơn trước.</p>\n<div class=\"VCSortableInPreviewMode active noCaption\" style=\"margin: 0px 0px 10px; padding: 0px; list-style: none; border: 0px; outline: none; font-style: italic; text-align: center;\">\n<div style=\"margin: 0px; padding: 0px; list-style: none; border: 0px; outline: none;\"></div>\n</div>\n</div><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikic