800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":71000,"discount_rate":20,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/8c/bf/bf/def0dfbda62cdc9b6b96462f5bb3e7d5.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1870,"all_time_quantity_sold":24,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eNước Hoa Hồng Chống Viêm, Dưỡng Ẩm Klairs Supple Preparation Facial Toner 180ml\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThương hiệu: Dears Klairs\u003c/strong\u003e\u003cbr /\u003e\u003cstrong\u003eXuất xứ: Hàn Quốc\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eDears Klairs\u003c/strong\u003e là thương hiệu mỹ phẩm đến từ Hàn Quốc được thành lập vào năm 2010, trực thuộc By Wishtrend. Klairs tập trung vào các sản phẩm lành tính phù hợp với làn da nhạy cảm, đồng thời hãng cũng đề cao sự uy tín trách nhiệm với khách hàng với cam kết \"dùng tốt cho tất cả những khách hàng có làn da nhạy cảm\". Thành phần lành tính vượt trội, không thử nghiệm trên động vật và không chứa hương liệu.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/product/50/bc/3c/a9bf2f480c45bbd875b902ccdb267735.jpg\" alt=\"SI3g7uUpcdiVse7DKCye_simg_d0daf0_800x1200_max.jpg\" width=\"720\" height=\"720\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eNước hoa hồng chống viêm dưỡng ẩm Klairs Supple Preparation Unscented Toner\u003c/strong\u003e là bước chăm sóc da quan trọng, giúp loại bỏ bụi bẩn và bã nhờn dư thừa trên da sau khi rửa mặt đồng thời cân bằng độ pH để các bước skincare tiếp theo đạt hiệu quả hơn.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCông dụng nổi bật\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eVới chiết xuất từ thực vật, giúp cân bằng PH của da, cải thiện hiệu quả chăm sóc da, giúp làn da của bạn đã sẵn sàng hấp thụ serum và kem tốt hơn.\u003c/li\u003e\n\u003cli\u003eNước hoa hồng Klairs Supple Preparation Unscented giúp loại bỏ bụi bẩn và bã nhờn dư thừa trên da sau khi rửa mặt đồng thời cân bằng độ pH để các bước skincare tiếp theo đạt hiệu quả hơn.\u003c/li\u003e\n\u003cli\u003eKhi sử dụng toner Klairs, các loại serum và kem dưỡng sẽ hấp thụ vào da tốt hơn 20% so với các loại toner thông thường khác. Đối với da khô, sử dụng liên tục 2 - 3 lần để giúp giảm khô căng cho da. Cùng với khả năng điều tiết bã nhờn và tăng hấp thụ, sản phẩm phù hợp cho da nhờn bất kể thời tiết.\u003c/li\u003e\n\u003cli\u003e100% không chứa alcohol, đem lại 100% khả năng làm sạch những bụi bẩn còn sót lại, se lỗ chân lông, tăng cường độ ẩm.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/product/aa/e2/26/95d7dd1dbed653258d60acc5c5e3d9c1.jpg\" alt=\"QfXEcmeDlBSHGloQSSyx_simg_d0daf0_800x1200_max.jpg\" width=\"720\" height=\"720\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCách sử dụng\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eSau khi rửa mặt sạch, cho 1 lượng toner vừa đủ ra bông tẩy trang thấm nhẹ lên mặt theo chiều vòng tròn.\u003cbr /\u003eChờ khoảng thời gian cho toner hoạt động xong thì dùng tinh chất, sữa dưỡng và kem dưỡng theo nhu cầu da.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/product/61/63/75/e8e0f079e287625bf93506bad6efa19d.jpg\" alt=\"mBk19NT2uAvl9ioJOSXt_simg_d0daf0_800x1200_max.jpg\" width=\"600\" height=\"825\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/8c/bf/bf/def0dfbda62cdc9b6b96462f5bb3e7d5.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/8c/bf/bf/def0dfbda62cdc9b6b96462f5bb3e7d5.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/8c/bf/bf/def0dfbda62cdc9b6b96462f5bb3e7d5.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8c/bf/bf/def0dfbda62cdc9b6b96462f5bb3e7d5.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8c/bf/bf/def0dfbda62cdc9b6b96462f5bb3e7d5.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/18/ae/73/ee3ff19a912a88eb789444547af00211.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/18/ae/73/ee3ff19a912a88eb789444547af00211.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/18/ae/73/ee3ff19a912a88eb789444547af00211.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/18/ae/73/ee3ff19a912a88eb789444547af00211.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/18/ae/73/ee3ff19a912a88eb789444547af00211.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/b7/53/f7/1d44fa8d06b2e8dac71157a3f356297f.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b7/53/f7/1d44fa8d06b2e8dac71157a3f356297f.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b7/53/f7/1d44fa8d06b2e8dac71157a3f356297f.jpg","position":nu