:"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":1000,"discount_rate":4,"rating_average":4.2,"review_count":109,"review_text":"(109)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/5e/54/d4/7794b38b0f06544041a39b060f6bbeb4.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1826,"all_time_quantity_sold":1518,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2\u003eMiếng lót giày cao gót mũi nhọn cho giày bị rộng cao cấp, vải thoáng khí và êm chân- buybox - BBPK55\u003c/h2\u003e\n\u003cp\u003eHàng ngày, vì tính chất công việc, hoc tập và lao động mà chúng ta buộc phải thường xuyên sử dụng giày cao gót. Không ít trường hợp bị đau bàn chân và các ngón chân khi mũi giày chịu tải trọng của toàn cơ thể. Đi lâu ngày lót theo giày bị lún làm cho phần bàn chân bị chai sần hoặc giày bị rộng so với ban đầu.\u003c/p\u003e\n\u003cp\u003eTừ nay không còn phải lo lắng nữa vì đã có lót giày cao gót mũi nhọn buybox giúp êm chân và chống rộng cho giày\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/09/30/cb/74c74a2ee8a0b05dfbc1e17d59f5ea25.jpg\" alt=\"lót giày cao gót mũi nhọn êm chân, chống rộng buybox\" width=\"750\" height=\"730\" /\u003e\u003c/p\u003e\n\u003ch2 style=\"text-align: left;\"\u003eCÔNG DỤNG NỔI BẬT\u003c/h2\u003e\n\u003cp style=\"text-align: left;\"\u003eLót giày đa năng chống rộng buybox là sự kết hợp giữa lót giày và lót chống trầy gót chân.\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003eGiúp chống rộng giày, giảm size. Giày rộng lót vào sẽ giúp mang vừa (giúp giảm rộng được 1 size giày). Giày đi lâu ngày, phần lót giày bị lún, lót vào đi êm chân hơn, thoải mái.\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003eCông dụng tuyệt vời: chống trầy gót sau bàn chân khi mang giày cao gót, giày búp bê; chống thốn gót chân; giảm đau gang bàn chân; mang lại cảm giác êm chân tuyệt đối.\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003eSản phẩm thiết kế 4D, kết hợp 2 trong 1 vừa là lót chống rộng vừa bảo vệ bàn chân rất tiện dụng. Được làm từ chất liệu cao cấp rất êm chân, thoáng khí \u0026amp; bền bỉ.\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003eMặt dưới miếng lót in các đường cong tương ứng các size 35 - 36 - 37 - 38 - 39 - 40. Dùng kéo cắt theo các đường cong này để có được kích thước cần sử dụng. Phần lót bọc gót sau có keo 3M để dán cố định vào sau giày.\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003eLót giày đa năng sử dụng được cho nhiều loại giày khác nhau như: giày cao gót mũi nhọn, giày búp bê mũi nhọn, giày mọi, giày lườ\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/9a/1c/09/3eeae589d22f87bbaa934c70f1547604.jpg\" alt=\"lót giày cao gót mũi nhọn cao cấp êm chân buybox\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/25/7a/4f/1419fc91a773e7cdf91b80da02fd57bc.jpg\" alt=\"lót giày cao gót mũi nhọn êm chân, chống rộng buybox\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/8b/97/1b/7f4b912aecf833bc431c7671bb25d295.jpg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/8b/97/1b/7f4b912aecf833bc431c7671bb25d295.jpg\" alt=\"\" 