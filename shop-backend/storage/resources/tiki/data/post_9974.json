_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/c1/dc/09/2c3c9d596765bf38910e7d9f738d902c.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":693,"all_time_quantity_sold":12,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cspan\u003e\u003cbr /\u003e\u003cstrong\u003eTHÔNG TIN CHI TIẾT\u003c/strong\u003e\u003cbr /\u003e\u003cbr /\u003e- Tay bấm game có dây\u003cbr /\u003e- Cổng kết nối USB 2.0\u003cbr /\u003e- 8 nút hỗ trợ; 2 cần analog\u003cbr /\u003e- Tay ốp cao su\u003cbr /\u003e- Tương thích Windows 11, Windows 10, Windows 8, Windows 7 hoặc Windows Vista\u003cbr /\u003e- Độ nhạy cao\u003cbr /\u003e\u003cbr /\u003e============\u003cbr /\u003e\u003cbr /\u003e\u003cstrong\u003eGiới thiệu Tay cầm chơi game Logitech F310 (Đen)\u003c/strong\u003e\u003cbr /\u003e\u003cbr /\u003e\u003cbr /\u003e\u003cstrong\u003eHỖ TRỢ TRÒ CHƠI MỞ RỘNG\u003c/strong\u003e\u003cbr /\u003e\u003cbr /\u003eChơi các trò chơi nổi tiếng và kinh điển\u003cbr /\u003e\u003cbr /\u003eChơi các trò thể thao điều khiển bằng bộ điều khiển riêng hoặc sử dụng vị trí thoải mái hơn trong khi vẫn tận hưởng trò chơi trên máy tính. F310 rất dễ để cài đặt và sử dụng với các trò chơi ưa thích của bạn nhờ XInput/DirectInput \u003cbr /\u003e\u003cbr /\u003eChơi trên chiếc TV của bạn\u003cbr /\u003e\u003cbr /\u003eGhép cặp F310 với Big Picture và điều hướng Steam, lướt web, chơi game và nhiều hơn nữa từ trên ghế sofa một cách thoải mái. Hãy mang toàn bộ thư viện trò chơi Steam của bạn vào phòng khách, cầm lấy chiếc F310, ngồi xuống và thưởng thức.\u003cbr /\u003e\u003cbr /\u003e\u003cstrong\u003eBỐ CỤC QUEN THUỘC TƯƠNG TỰ MÁY CHƠI GAME CONSOLE\u003c/strong\u003e\u003cbr /\u003e\u003cbr /\u003eChỉ cần cầm lên và chơi\u003cbr /\u003e\u003cbr /\u003eBản năng sẽ hướng dẫn các thao tác của bạn trên bố cục quen thuộc. Bạn sẽ sẵn sàng để chơi ngay lập tức. Được thiết kế để có trải nghiệm điều khiển tương tự máy chơi game console và đổi mới từ thiết kế truyền thống, F310 vừa vặn như một chiếc găng tay.\u003cbr /\u003e\u003cbr /\u003e\u003cstrong\u003e4 PHÍM DI CHUYỂN D-PAD RIÊNG\u003c/strong\u003e\u003cbr /\u003e\u003cbr /\u003e4 phím di chuyển D-pad riêng\u003cbr /\u003e\u003cbr /\u003eCác phím D-pad tiêu chuẩn nằm trên một điểm trục có thể khiến điều khiển không chính xác. Bàn di chuyển D-pad F310 lướt qua bốn phím riêng tạo ra cảm giác nhạy và trực quan hơn.\u003cbr /\u003e\u003cbr /\u003e\u003cstrong\u003eHỖ TRỢ TV CHẠY ANDROID\u003c/strong\u003e\u003cbr /\u003e\u003cbr /\u003eBộ điều khiển chơi game của chúng tôi hỗ trợ các TV Sony Android. Với phím bộ điều khiển ở chế độ XID, bố cục kiểu máy chơi game console sẽ mang lại lợi thế cho bạn khi thi đấu. Các đường cong mượt mà và tay cầm bọc cao su sẽ mang lại các cuộc chơi lâu dài, thoải mái. Các nút điều khiển TV Android chuẩn - sử dụng qua nút Logo Logitech trên tay cầm cùng với phím Back (Quay lại) trên bộ điều khiển - cho phép bạn điều khiển TV Android đồng thời.\u003cbr /\u003e\u003cbr /\u003e\u003cstrong\u003eDỄ DÀNG CÀI ĐẶT VÀ SỬ DỤNG\u003c/strong\u003e\u003cbr /\u003e\u003cbr /\u003eSử dụng và tùy chỉnh\u003cbr /\u003e\u003cbr /\u003eThay đổi các lệnh tiêu chuẩn hoặc sử dụng F310 để chơi tựa game không được hỗ trợ bằng cách sử dụng phần mềm cấu hình của Logitech. Các nút và phím điều khiển hoàn toàn có thể lập trình và thậm chí có thể mô phỏng các lệnh bàn phím và chuột.\u003cbr /\u003e\u003cbr /\u003e\u003cstrong\u003eDÂY DÀI 1,8 MÉT\u003c/strong\u003e\u003cbr /\u003e\u003cbr /\u003eDây dài 1,8 mét\u003cbr /\u003e\u003cbr /\u003e\u003cstrong\u003eTAY CẦM THOẢI MÁI\u003c/strong\u003e\u003cbr /\u003e\u003cbr /\u003eDễ dàng thao tác bằng tay\u003cbr /\u003e\u003cbr /\u003eTận hưởng cuộc chơi lâu dài và thoải mái nhờ các đường cong mềm mại và tay cầm bọc cao su\u003cbr /\u003e\u003cbr /\u003e\u003cstrong\u003eTHÀNH PHẦN GÓI\u003c/strong\u003e\u003cbr /\u003e\u003cbr /\u003eTay cầm\u003cbr /\u003e\u003cbr /\u003eTài liệu hướng dẫn sử dụng\u003cbr /\u003e\u003cbr /\u003e\u003cstrong\u003eChú ý :\u003c/strong\u003e\u003cbr /\u003e\u003cbr /\u003e- Mổi sản phẩm Logitech có 2 cấp độ số Serial khác nhau. 1 số trên bao bì (ngoài vỏ hộp) và 1 số bên trên sản phẩm. Hai số Serial này hoàn toàn khác nhau. Do chính sách quản lí riêng của - Logitech nên đây là vấn đề hoàn toàn bình thường.\u003cbr /\u003e\u003cbr /\u003eLogitech bảo hành điện tử theo mã số đơn hàng (Ngoài ra còn bảo hành theo mã số seri từng sản phẩm) nên sẽ không có phiếu bảo hành đi kèm\u003cbr /\u003e\u003cbr /\u003e- Tất cả sản phẩm Logitech đều có thể còn hoặc không còn niêm phong của nhà sản xuất tùy vào từng đợt hàng, chính sách của các đơn vị nhập khẩu, phân phối và quá trình kiểm tra sản phẩm.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/7b/b3/63/71f53a804a8c6f51f0037201abfe6ed4.png\" alt=\"\" width=\"750\" height=\"1266\" /\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/c1/dc/09/2c3c9d596765bf38910e7d9f738d902c.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c1/dc/09/2c3c9d596765bf38910e7d9f738d902c.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c1/dc/09/2c3c9d596765bf38910e7d9f738d902c.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c1/dc/09/2c3c9d596765bf38910e7d9f738d902c.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c1/dc/09/2c3c9d596765bf38910e7d9f738d902c.png"},{"base_url":"https://salt.tikicdn.com/ts/product/1b/53/4b/d4081fcbdfc93f137222dea428ae9901.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/1b/53/4b/d4081fcbdfc93f137222dea428ae9901.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/1b/53/4b/d4081fcbdfc93f137222dea428ae9901.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1b/53/4b/d4081fcbdfc93f137222dea428ae9901.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1b/53/4b/d4081fcbdfc93f137222dea428ae9901.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/23/18/e3/ff196193deb6e77b08964eeca826bfa0.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/23/18/e3/ff196193deb6e77b08964eeca826bfa0.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/23/18/e3/ff196193deb6e77b08964eeca826bfa0.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/23/18/e3/ff196193deb6e77b08964eeca826bfa0.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/23/18/e3/ff196193deb6e77b08964eeca826bfa0.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/54/37/fc/35e8550dcac2e3c3b1602fe0308fcf2f.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product