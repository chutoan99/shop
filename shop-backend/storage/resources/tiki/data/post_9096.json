t":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":3,"review_text":"(3)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/a6/11/de/db761ccfc861726ddbd0c7af6fb02716.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1232,"all_time_quantity_sold":11,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e- Pin sạc dự phòng Baseus Adaman hỗ trợ hầu hết các chuẩn sạc nhanh hiện nay, tương thích với hầu hết các thiết bị số hiện nay từ Macbook/ Laptop cho đến Smartphone/ Tablet ... Dung lượng lớn, công suất, hiệu suất sử dụng cao (lên đến 22.5W) có 3 port (2 USB + 1 Type C). Cả 3 Port này đều hỗ trợ sạc nhanh (QC3.0 và PD3.0) , có thể dùng sạc pin cho cả 3 thiết bị cùng lúc . Giúp bạn sử dụng thoải mái hơn và quên đi nổi lo hết pin khi đi công tác, du lịch, giả ngoại ... Giúp cho mọi thiết bị của bạn luôn trong tình trạng sẳn sàng sử dụng .\u003c/p\u003e\n\u003cp\u003e- Ngỏ vào : được trang bị 3 cổng sạc ngỏ vào gồm Lightning, Micro và Type C . Trong đó cổng Type C hỗ trợ sạc nhanh đồng thời cả in và out (Bi-directional quick charging). Việc trang bị cả 3 cổng sạc ngỏ vào cho phép bạn bạn có thể sạc cho pin bằng chính cáp của điện thoại mà không cần trang bị thêm cáp sạc riêng.\u003c/p\u003e\n\u003cp\u003e- Ngỏ ra : 2 Port USB + Type C hỗ trợ nhiều mức cấu hình khác nhau là 5V/1A, 5V/2.4A, 5V/3A, 9V/2A 12V/1.5A.... Tương thích với hầu hết các smartphone, tablet, Laptop có hỗ trợ sạc qua cổng Type C.\u003c/p\u003e\n\u003cp\u003e- Lỏi pin công nghệ mới nhất hiệu suất cao hơn và an toàn hơn nhưng vẫn đảm bảo kích thước vô cùng nhỏ gọn .\u003c/p\u003e\n\u003cp\u003e- Được tích hợp chíp xử lý nguồn thế hệ mới có hiệu suất sử dụng cao, độ ổn định vượt trội cùng với cơ chế bảo vệ thông minh . Pin dự phòng sạc nhanh Baseus Adaman Metal Digital cho mức điện áp sử dụng ổn định, đảm bảo an toàn cho thiết bị và người sử dụng .\u003c/p\u003e\n\u003cp\u003e- Sản phẩm còn được trang bị đèn LED thông minh và tiện dụng cho biết dung lượng pin còn lại và tình trạng sạc pin .\u003c/p\u003e\n\u003cp\u003e- Bề mặt được làm bằng kim loại chắc chắn và sang trọng . Thiết kế dạng nhám nhẹ giúp bám tay tốt hơn, chống bám vân tay . Viền bi nhẹ giúp cầm tay được thoải mái hơn .\u003cbr /\u003e\u003cbr /\u003e\u003cem\u003e\u003cstrong\u003eHình ảnh chi tiết Pin dự phòng sạc nhanh Baseus Adaman Metal Digital Display Quick Charge (22.5W QC3.0/ PD3.0/ SCP/ AFAFC Quick charge)\u003cbr /\u003e\u003cimg class=\"detail-desc-decorate-image\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/c7/b7/2a/d0a6d9464a63132802f026c6e6a29c4b.jpg\" /\u003e\u003cimg class=\"detail-desc-decorate-image\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/b0/fb/d4/b55aaddf6c3af50c0f08627f3d87cd49.jpg\" /\u003e\u003cimg class=\"detail-desc-decorate-image\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/a6/33/e7/cfd1d60a9ff5e7193bcab53e5870a0d6.jpg\" /\u003e\u003cimg class=\"detail-desc-decorate-image\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/92/21/c3/d1942fe4f81656460d5fba130bc0e0ed.jpg\" /\u003e\u003cimg class=\"detail-desc-decorate-image\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/81/7c/ee/29c7416549eb7f65cc56c7880e390189.jpg\" /\u003e\u003cimg class=\"detail-desc-decorate-image\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/07/46/77/82130bf331de88bd9561cd19395d0bdf.jpg\" /\u003e\u003cimg class=\"detail-desc-decorate-image\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/8a/63/cf/43e5c60f9e1cf18b28d4cbe411f07502.jp