666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.3,"review_count":9,"review_text":"(9)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/be/f9/a9/4e9c4f29ba789af6c4a8f378fbdeba81.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1043,"all_time_quantity_sold":86,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003chtml\u003e\n \u003chead\u003e\u003c/head\u003e\n \u003cbody\u003e\n  \u003cul\u003e\n   \u003cp\u003e- Chai thủy tinh nắp vặn Quattro Stagioni 200ml - 400ml – 1000ml được nhập khẩu từ Ý. Chất liệu thủy tinh cao cấp sáng đẹp và có độ trong tinh khiết, an toàn cho sức khỏe người dùng.\u003c/p\u003e\n   \u003cp\u003e- Cam kết hoàn 100% giá trị nếu bể vỡ do vận chuyển hàng toàn quốc.\u003c/p\u003e\n   \u003cp\u003e- Hàng hóa nhập khẩu rõ ràng nguồn gốc xuất xứ, kiểm định chất lượng.\u003c/p\u003e\n   \u003cp\u003eChất liệu thủy tinh Ý sáng đẹp, có độ trong tinh khiết và có khả năng chống bám bẩn, dễ chùi rửa, tiết kiệm thời gian vệ sinh sản phẩm. Thủy tinh dày, có độ bền cao và an toàn khi dùng để cất trữ thực phẩm.\u003c/p\u003e\n   \u003cp\u003eKích thước chi tiết từng chai vui lòng xem tại ảnh sản phẩm.\u003c/p\u003e\n   \u003cp\u003e-----\u003c/p\u003e\n   \u003cp\u003eTHÔNG TIN THƯƠNG HIỆU:\u003c/p\u003e\n   \u003cp\u003eBormioli Rocco là thương hiệu sản xuất sản phẩm thủy tinh của Italia được thành lập từ năm 1825, có có trụ sở chính tại Fidenza (Italia) và nhiều nhà máy, cơ sở ở các nước như Tây Ban Nha, Pháp, Mỹ…Hiện nay, Bormioli Rocco chiếm 50% thị phần cung cấp các sản phẩm phục vụ bàn ăn của kênh phân phối bán lẻ lớn ở Ý và hơn 85% người dân Ý biết đến và sử dụng sản phẩm của Bormioli Rocco hàng ngày.\u003c/p\u003e\n   \u003cp\u003e-----\u003c/p\u003e\n   \u003cp\u003eCHÚNG TÔI CAM KẾT:\u003c/p\u003e\n   \u003cp\u003e- Hàng hóa nhập khẩu rõ ràng nguồn gốc xuất xứ, kiểm định chất lượng.\u003c/p\u003e\n   \u003cp\u003e- Cam kết hoàn 100% giá trị nếu bể vỡ do vận chuyển hàng toàn quố\u003c/p\u003e\n   \u003cp\u003e- Giá cả luôn tương xứng với chất lượng sản phẩm\u003c/p\u003e\n   \u003cp\u003e-----\u003c/p\u003e\n   \u003cp\u003eHƯỚNG DẪN SỬ DỤNG ĐỂ CHAI, HŨ THỦY TINH LUÔN SẠCH ĐẸP \u0026amp; AN TOÀN\u003c/p\u003e\n   \u003cp\u003e- Vệ sinh sạch sẽ sản phẩm cùng nước rửa chén trước khi sử dụng.\u003c/p\u003e\n   \u003cp\u003e- Tuyệt đối tránh việc thay đổi nhiệt độ đột ngột với thủy tinh. Luôn sử dụng để đựng các đồ ăn, thức uống không chênh lệch quá 40 độ so với nhiệt độ phòng\u003c/p\u003e\n   \u003cp\u003e- Với các sản phẩm có nắp kim loại, nên vệ sinh ngay lập tức và để nơi khô ráo sau khi đựng đồ để kéo dài tuổi thọ sử dụng\u003c/p\u003e\n   \u003cp\u003e- Không để chai thủy tinh vào ngăn đá tủ lạnh khi chứa đầy nước.\u003c/p\u003e\n  \u003c/ul\u003e\n \u003c/body\u003e\n\u003c/html\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e\u003cp\u003eSản phẩm này là tài sản cá nhân được bán bởi Nhà Bán Hàng Cá Nhân và không thuộc đối tượng phải chịu thuế GTGT. Do đó hoá đơn VAT không được cung cấp trong trường hợp này.\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/be/f9/a9/4e9c4f29ba789af6c4a8f378fbdeba81.jpg","is_gallery":true,"label":null,"large_url":"