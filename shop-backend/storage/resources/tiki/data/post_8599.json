dge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":59000,"discount_rate":26,"rating_average":5,"review_count":54,"review_text":"(54)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/0f/3b/19/3705a86277ecddb9470333bde90a5b28.png","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1016,"all_time_quantity_sold":341,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003eGiới thiệu\u003c/h3\u003e\n\u003cp\u003eĐồ chơi lắp ráp, xếp hình Qman 1803 - \u003cstrong\u003eChiến xa, xe tăng lội nước (361 mảnh ghép)\u003c/strong\u003e dành cho bé trên 6 tuổi\u003c/p\u003e\n\u003cp\u003eLà sản phẩm thuộc bộ sưu tập Combined Defomation nổi tiếng của QMAN đã được nhiều người chơi ở Việt Nam biết và sưu tập. Sản phẩm là mô hình xe tăng lội nước cỡ lớn đẹp và chắc chắn\u003c/p\u003e\n\u003ctable style=\"width:100%\"\u003e\u003ctbody\u003e\u003ctr\u003e\u003ctd style=\"width:100%\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ee/bb/ee/1cfb5cf0142b58e1383590981a1ff536.png\" alt=\"\" width=\"550\" height=\"550\" /\u003e\u003c/td\u003e\u003c/tr\u003e\u003c/tbody\u003e\u003c/table\u003e\n\u003ch3\u003eĐối tượng sử dụng\u003c/h3\u003e\n\u003cp\u003eSản phẩm phù hợp với các bé từ 6 tuổi trở lên\u003c/p\u003e\n\u003ch3\u003eHướng dẫn sử dụng\u003c/h3\u003e\n\u003cp\u003e\u003cstrong\u003eSản phẩm có thể ráp được 1 trong 2 cách:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Cách 1: Ráp xe tăng lội nước (hình bên trái)\u003c/p\u003e\n\u003cp\u003e- Cách 2: Ráp thành 8 trang thiết bị khác nhau (hình bên phải)\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eLưu ý:\u003c/strong\u003e các trang bị có bánh xe đều di chuyển được\u003c/p\u003e\n\u003ch3\u003eChất liệu\u003c/h3\u003e\n\u003cp\u003eNhựa ABS\u003c/p\u003e\n\u003ctable style=\"width:100%\"\u003e\u003ctbody\u003e\u003ctr\u003e\u003ctd style=\"width:50%\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/65/62/de/130a65d0537e4bb88d91fd51e27c5c51.png\" alt=\"\" width=\"400\" height=\"400\" /\u003e\u003c/td\u003e\u003ctd style=\"width:50%\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/8a/db/28/baaca21824cf9e9b63fa3d4e0197af10.png\" alt=\"\" width=\"400\" height=\"400\" /\u003e\u003c/td\u003e\u003c/tr\u003e\u003c/tbody\u003e\u003c/table\u003e\n\u003cp\u003e\u003cstrong\u003eSản phầm được đóng trong 8 hộp nhỏ, có sách hướng dẫn lắp ráp\u003c/strong\u003e\u003c/p\u003e\n\u003ctable style=\"width:100%\"\u003e\u003ctbody\u003e\u003ctr\u003e\u003ctd style=\"width:50%\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/d2/e1/70/5deb55e68cf7a0ebc0d915222155c1f8.png\" alt=\"\" width=\"400\" height=\"400\" /\u003e\u003c/td\u003e\u003ctd style=\"width:50%\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/eb/02/7b/ec58fa74fcbe8acd0a97ee6d8f82eab8.png\" alt=\"\" width=\"400\" height=\"400\" /\u003e\u003c/td\u003e\u003c/tr\u003e\u003c/tbody\u003e\u003c/table\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch3\u003eThông tin chi tiết :\u003c/h3\u003e\n\u003cul\u003e\u003cli\u003eTên sản phẩm \u0026#xff1a; QM-09 amphibious panzer \u003c/li\u003e\u003cli\u003eMã sản phẩm\u0026#xff1a;1803\u003c/li\u003e\u003cli\u003eTrọng lượng: 610 gram \u003c/li\u003e\u003cli\u003ePCS \u0026#xff1a; 361 miếng ghép\u003c/li\u003e\u003cli\u003eChất liệu \u0026#xff1a; Nhựa ABS đạt đầy đủ các chứng nhận 3C, EN71, ASTM, HR4040 \u003c/li\u003e\u003cli\u003eThương hiệu: \u003cstrong\u003eQMAN\u003c/strong\u003e\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e------------------------------------------------------------------------------\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eMỘC NHIÊN KIDS STORE \u003c/strong\u003eĐỒNG HÀNH CÙNG BÉ YÊU KHÔN LỚN\u003c/p\u003e\n\u003cp\u003eChúng tôi cam kết:\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eSản phẩm chính hãng\u003c/li\u003e\u003cli\u003e1 đổi 1 nếu sản phẩm lỗi\u003c/li\u003e\u003cli\u003eTư vấn 24x7\u003c/li\u003e\u003cli\u003eGói quà miễn phí\u003c/li\u003e\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/0f/3b/19/3705a86277ecddb9470333bde90a5b28.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0f/3b/19/3705a86277ecddb9470333bde90a5b28.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/0f/3b/19/3705a86277ecddb9470333bde90a5b28.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0f/3b/19/3705a86277ecddb9470333bde90a5b28.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0f/3b/19/3705a86277ecddb9470333bde90a5b28.png"},{"base_url":"https://salt.tikicdn.com/ts/product/22/da/6a/05b0530c0a68c9da333d505810377275.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/22/da/6a/05b0530c0a68c9da333d505810377275.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/22/da/6a/05b0530c0a68c9da333d505810377275.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/22/da/6a/05b0530c0a68c9da333d505810377275.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/22/da/6a/05b0530c0a68c9da333d505810377275.png"},{