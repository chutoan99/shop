"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":6,"review_text":"(6)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/a7/02/5b/657e4217bb80d9e55b8eda68c24609ef.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":502,"all_time_quantity_sold":44,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cul\u003e\u003cli\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eMềm mại khi chạm vào: \u003c/strong\u003eLớp vỏ bằng silicone cho cảm giác mềm mại giữa các ngón tay của bạn khi bạn cắm cáp vào thiết bị của mình.\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eSiêu bền bỉ\u003c/strong\u003e: Cáp dẻo nhất từ trước đến nay và cũng là một trong những loại cáp bền nhất của Anker. Nhờ tuổi thọ 25.000 lần uốn cong, bạn không cần phải lo vấn đề di chuyện gây hại tới cáp.\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eBend It, Twist It, Flex It:\u003c/strong\u003e Không bị rối ngay cả khi nhét vào túi hoặc túi quần hoặc quấn quanh pin sạc di động.\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eSạc nhanh:\u003c/strong\u003e Hỗ trợ công suất đầu ra tối đa 100W khi được ghép nối với bộ sạc tường 100W trở lên để cung cấp năng lượng cho hầu hết mọi thiết bị USB-C, bao gồm điện thoại, máy tính bảng và máy tính xách tay. (Cáp này không hỗ trợ hiển thị.)\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eTrong hộp có gì:\u003c/strong\u003e Cáp Anker 643 USB-C to USB-C (Flow, Silicone) / PowerLine III Flow USB-C to USB-C Cable, dây buộc cáp silicon, hướng dẫn chào mừng.\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/28/9b/fe/2e118a9f235f936d4dacdad3a816be4e.jpg?v=1659065620655\" alt=\"1-d99d545f-1913-4290-bcbc-0cf3fd775d45.jpg?v=1659065620655\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/17/be/de/0a1e0b96359ac62943ff9f731101dd45.jpg?v=1659065622100\" alt=\"2-76214002-4385-4ce1-b2cd-f234163c9c04.jpg?v=1659065622100\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/42/1a/b0/eb99f2362e3f8b21867a1aef30ed8cf4.jpg?v=1659065624456\" alt=\"4-3d3aac0e-114a-4793-83ae-72801b513e41.jpg?v=1659065624456\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/bc/9c/22/8ee38f644a6ec0bebbb4aa0446eddd5a.jpg?v=1659065625585\" alt=\"5-394d4187-7a7a-4fbd-974b-5bcb43a89d65.jpg?v=1659065625585\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/09/e9/50/e0baca1558968120fbd87c5d21b0e69d.jpg?v=1659065627259\" alt=\"6-b5a85c54-e187-4a7a-9f7b-7f95d4ccbc95.jpg?v=1659065627259\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eMã sản phẩm\u003c/strong\u003e: A8553 \u003c/p\u003e\n\u003cp\u003eCáp USB-C sang USB-C PowerLine III Flow\u003c/p\u003e\n\u003cp\u003eSiêu bền bỉ, mềm đến bất ngờ\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCảm nhận sự khác biệt:\u003c/strong\u003e Sau khi cầm trên tay chiếc cáp silicon mềm mại đến bất ngờ này, bạn sẽ không bao giờ quay lại với những chiếc cáp thông thường.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eBền bỉ vô đối\u003c/strong\u003e: Có hệ thống ba lớp gồm dây đồng, graphene mềm dẻo và silicone để nâng cao tính linh hoạt mà không làm giảm độ bền. Kết quả là một sợi cáp có độ bền khi kéo 220 lbs (100 kg) và tuổi thọ 25.000 lần uốn cong. Quá đủ để chịu đựng sự một chiếc điện thoại hoặc máy tính bảng lủng lẳng.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eGọn gàng và ngăn nắp:\u003c/strong\u003e Sử dụng dây đeo silicone đi kèm để giữ cho cáp được cuộn gọn gàng khi cất giữ trong ngăn kéo, túi hoặc bất cứ nơi nào khác. Lưu ý: Không bao gồm túi đựng du lịch.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eLinh hoạt phong cách của bạn\u003c/strong\u003e: Tìm giao diện phù hợp với bạn và điện thoại của bạn. PowerLine III Flow có 4 màu tươi mới:  Tím tử đinh hương, Xanh bạc hà, Trắng mây và Đen nửa đêm.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eSẵn sàng sạc nhanh:\u003c/strong\u003e Tương thích với sạc nhanh Power Delivery và hỗ trợ lên đến 100W để sạc điện thoại, máy tính bảng, máy tính xách tay hoặc hầu như bất kỳ thiết bị USB-C nào khác ở tốc độ tối đa có thể. Lưu ý: Yêu cầu bộ sạc tốc độ cao Power Delivery tương thích. Hỗ trợ truyền tệp, ảnh, nhạc và phim giữa các thiết bị USB-C với tốc độ lên đến 480 Mbps.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eGhi chú:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eCáp này không hỗ trợ hiển thị phương tiện.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eKhả năng tương thích:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eMacBook Pro (M1,2020)\u003c/p\u003e\n\u003cp\u003eMacBook Pro (2019/2018/2017/2016) 15,4 ''\u003c/p\u003e\n\u003cp\u003eMacBook Pro (2020/2019/2018/2017/2016) 13,3 ''\u003c/p\u003e\n\u003cp\u003eMacBook Air (2020/2019/2018)\u003c/p\u003e\n\u003cp\u003eiPad Pro 12,9 inch (thế hệ thứ 5/4/3/2/1),\u003c/p\u003e\n\u003cp\u003eiPad Pro 10,5 inch, iPad Pro 9,7 inch\u003c/p\u003e\n\u003cp\u003eiPad Air (thế hệ thứ 4)\u003c/p\u003e\n\u003cp\u003eiPad Mini (thế hệ thứ 6)\u003c/p\u003e\n\u003cp\u003eGalaxy Note 10 + / 10/9/8\u003c/p\u003e\n\u003cp\u003eGalaxy S21 / S21 + / S20 / S10 + / S10e / S10 / S9 + / S9\u003c/p\u003e\n\u003cp\u003eGoogle Pixel 3\u003c/p\u003e\n\u003cp\u003eNintendo Switch / Switch Lite\u003c/p\u003e\n\u003cp\u003eThiết bị tương thích (tốc độ sạc hạn chế)\u003c/p\u003e\n\u003cp\u003eLG V40 / V30 + / V20 / G7\u003c/p\u003e\n\u003cp\u003eLenovo Yoga 14s\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/55/ea/4b/e6ed4c07dc349f11f313bd49909d