 luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/68/49/bf/3b27c07d87aa515ccb4dcdd8b2cce0ac.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/68/49/bf/3b27c07d87aa515ccb4dcdd8b2cce0ac.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/68/49/bf/3b27c07d87aa515ccb4dcdd8b2cce0ac.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/68/49/bf/3b27c07d87aa515ccb4dcdd8b2cce0ac.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/68/49/bf/3b27c07d87aa515ccb4dcdd8b2cce0ac.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/e3/b0/8d/f494cc9f0b371ca4d6999018e69fc33a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e3/b0/8d/f494cc9f0b371ca4d6999018e69fc33a.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e3/b0/8d/f494cc9f0b371ca4d6999018e69fc33a.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e3/b0/8d/f494cc9f0b371ca4d6999018e69fc33a.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e3/b0/8d/f494cc9f0b371ca4d6999018e69fc33a.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/d8/2f/5f/57d37b094fa8845dbba06784fcd7fa77.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d8/2f/5f/57d37b094fa8845dbba06784fcd7fa77.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d8/2f/5f/57d37b094fa8845dbba06784fcd7fa77.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d8/2f/5f/57d37b094fa8845dbba06784fcd7fa77.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d8/2f/5f/57d37b094