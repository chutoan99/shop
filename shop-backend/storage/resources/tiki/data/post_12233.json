h":0,"icon_height":0,"text_color":"#FFF0F1","background_color":"#D93843","href":null,"text":"9.9"},{"placement":"pdp_badge","code":"is_hero","type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":true,"return_reason":"any_reason"}},"discount":661000,"discount_rate":42,"rating_average":4.5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/b5/91/99/313929a4c08e1fc5a96850c8d7d82e83.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":402,"all_time_quantity_sold":12,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<h2 class=\"irIKAp\">ông Số Kỹ Thuật</h2>\n<p class=\"irIKAp\">Mẫu mã: SoundPEATS Air 4 Lite</p>\n<p class=\"irIKAp\">Màu sắc: Đen</p>\n<p class=\"irIKAp\">Phiên bản Bluetooth: V5.3</p>\n<p class=\"irIKAp\">Giao thức Bluetooth: HFP/A2DP/AVRCP</p>\n<p class=\"irIKAp\">Bộ giải mã Bluetooth được hỗ trợ: AAC, SBC, LDAC</p>\n<p class=\"irIKAp\">Chứng nhận Hi-Res: Có</p>\n<p class=\"irIKAp\">Chipset: WQ7033AX</p>\n<p class=\"irIKAp\">Driver Dynamic: 13mm</p>\n<p class=\"irIKAp\">Pin tai nghe: 35mAh*2</p>\n<p class=\"irIKAp\">Pin hộp sạc: 330 mAh</p>\n<p class=\"irIKAp\">Thời gian sạc tai nghe: 1,5 giờ</p>\n<p class=\"irIKAp\">Thời gian sạc hộp sạc: 2 giờ</p>\n<p class=\"irIKAp\">Số lần sạc từ hộp sạc: 3 lần</p>\n<p class=\"irIKAp\">Thời gian sử dụng tai nghe: 7 giờ</p>\n<p class=\"irIKAp\">Tổng thời gian sử dụng với hộp sạc: 30 giờ</p>\n<p class=\"irIKAp\">Khử tiếng ồn cuộc gọi: 3 Mic</p>\n<p class=\"irIKAp\">Chống nước: IPX4</p>\n<p class=\"irIKAp\">Game mode: 80ms</p>\n<p class=\"irIKAp\">Kết nối 2 thiết bị: Có</p>\n<p class=\"irIKAp\">ỨNG DỤNG SoundPEATS: Có</p>\n<p class=\"irIKAp\">Đầu vào sạc: 5V/1A</p>\n<p class=\"irIKAp\">Độ nhạy của MIC: -38±1dB SNR: 61dB ở 1kHz</p>\n<p class=\"irIKAp\">Đáp ứng tần số: 20Hz—40KHz</p>\n<p class=\"irIKAp\">Trở kháng driver: 12Ω±15% 120±2dB tại 1kHz</p>\n<p class=\"irIKAp\">Kích thước tai nghe (L*W*H): 18,3*19,1*34,4 mm</p>\n<p class=\"irIKAp\">Kích thước vỏ (L*W*H): 53,5*24*58 mm</p>\n<h2 class=\"irIKAp\">Tai Nghe True Wireless SoundPEATS Air4 Lite Hires Audio LDAC 6Mic Bluetooth 5.3</h2>\n<p class=\"irIKAp\">SoundPEATS Air4 Lite là dòng tai nghe được nâng cấp từ SoundPEATS Air3 Deluxe HS, cải tiến hỗ trợ kết nối 2 thiết bị, trang bị 3 mic mỗi bên tai nghe giúp nâng cấp chống ồn cuộc gọi ENC hiệu quả hơn. Màng chắn bụi hợp kim màu gold bắt mắt và sang trọng. Kiểu dáng được tinh gọn, công thái học hơn trước. Được hiệp hội âm thanh Nhật Bản chứng nhận chất lượng cao Hires Audio chuẩn LDAC.</p>\n<p><img style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/4c/62/cf/ae927836ce14b8e773ced325ed16d345.jpg\" alt=\"\" width=\"750\" height=\"394\" /></p>\n<h3 class=\"irIKAp\">Âm Thanh Sống Động Chi Tiết</h3>\n<p class=\"irIKAp\">SoundPEATS Air4 Lite với Driver 13mm màng loa sinh học mới mang đến âm thanh đầy sống động và vô cùng chân thật.</p>\n<p class=\"irIKAp\">Tai nghe tái tạo âm thanh chi tiết, cung cấp tần số mạnh mẽ cùng với trường âm thanh rộng.</p>\n<p class=\"irIKAp\"> </p>\n<p class=\"irIKAp\"><img style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/a2/a5/f4/45059bdccd0c0ab169aa57c57e1eb087.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p class=\"irIKAp\"> </p>\n<h3 class=\"irIKAp\">Bluetooth 5.3 Hiện Đại</h3>\n<p class=\"irIKAp\">SoundPEATS Air4 Lite cũng được hỗ trợ chuẩn bluetooth 5.3 mới nhất ở thời điểm hiện tại.</p>\n<p class=\"irIKAp\">Với chuẩn Bluetooth này, trải nghiệm sử dụng của người dùng được nâng cao hơn với tốc độ truyền tải tín hiệu nhanh hơn, kết nối ổn định hơn, tiêu thụ điện năng ít hơn và đồng thời giảm thiểu độ trễ, giúp cho việc chơi game, xem phim mượt mà hơn.</p>\n<p class=\"irIKAp\"> </p>\n<p class=\"irIKAp\"><img style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/e1/58/e3/fc9332e014e8b121850f95cf4d96b2b9.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<h3 class=\"irIKAp\"> </h3>\n<h3 class=\"irIKAp\">6 Mic Với Công Nghệ Chống Ồn Đàm Thoại Bằng Al</h3>\n<p class=\"irIKAp\">Mỗi bên tai nghe được trang bị 3 Mic chống ồn hỗ trợ cho việc đàm thoại, đồng thời được tích hợp thêm công nghệ chống ồn cuộc gọi Al, mang đến cuộc trò chuyện rõ ràng.</p>\n<p class=\"irIKAp\">Mic chống ồn có nhiệm vụ nhận giọng nói một cách chính xác và loại bỏ tiếng ồn, tạp âm ở xung quanh hiệu quả, tái tạo cuộc gọi rõ ràng, chi tiết trong bất kỳ môi trường nào. Thoải mái chuyện trò trên đường phố, công viên, trong văn phòng và thậm chí là trong quán café ồn ào.</p>\n<p class=\"irIKAp\"> </p>\n<p class=\"irIKAp\"><img style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/1f/93/7e/1ceaf9aecb5bfa9d46be2851094421f6.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<h3 class=\"irIKAp\"> </h3>\n<h3 class=\"irIKAp\">Kết Nối Đa Điểm</h3>\n<p class=\"irIKAp\">SoundPEATS Air4 Lite cho phép người dùng kết nối đồng thời hai thiết bị cùng lúc. Thoải mái chuyển đổi linh hoạt giữa điện thoại và máy tính bảng hoặc điện thoại và laptop.</p>\n<p class=\"irIKAp\">Lưu ý: LDAC sẽ không được hỗ trợ khi người dùng kết nối đa điểm, vui lòng chọn 1 kết nối trong ứng dụng thể có thể sử dụng codec này.</p>\n<p class=\"irIKAp\"> </p>\n<p class=\"irIKAp\"><img style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/20/17/c8/7234ff15a946d9bcac939e629e48bb68.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<h3 class=\"irIKAp\"> </h3>\n<h3 class=\"irIKAp\">Hires Audio với Codec LDAC</h3>\n<p class=\"irIKAp\">So với SoundPEATS Air3, phiên bản Air4 Lite đã được nâng cấp codec LDAC, mang đến âm thanh Hi-res với chất lượng lên đến 96kHz/32bit cùng băng thông tối đa 990kbps, tốc độ truyền tải có thể nhanh gấp 3 lần so với các mẫu tai nghe thông thường khác.</p>\n<p class=\"irIKAp\"> </p>\n<p class=\"irIKAp\"><img style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/0e/d4/25/0c36d44d79bb4548daa1e573bc2fc46b.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<h3 class=\"irIKAp\"> </h3>\n<h3 class=\"irIKAp\">Thời Gian Sử Dụng Pin Lâu Dài</h3>\n<p class=\"irIKAp\">Với thời lượng pin 7 giờ với tai nghe và 30 giờ với case sạc. Lưu ý: Thời lượng pin của SoundPEATS Air4 Lite được thử nghiệm ở mức âm lượng 60%, nếu sử dụng ở mức âm lượng cao hơn, thời gian sử dụng sẽ thấp hơn.</p>\n<p class=\"irIKAp\"> </p>\n<h3 class=\"irIKAp\"><img style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/65/b2/1c/776ffa842e3aeff89edeb96ddb5e074e.jpg\" alt=\"\" width=\"750\" height=\"750\" /></h3>\n<p> </p>\n<h3 class=\"irIKAp\">Game Mode độ trễ thấp</h3>\n<p class=\"irIKAp\">SoundPEATS Air4 Lite được trang bị thêm chế độ Game Mode để giảm độ trễ cho quá trình chơi game hoặc xem phim ở mức 0.08s.</p>\n<p class=\"irIKAp\">Với độ trễ này, người dùng hoàn toàn có thể chơi các tựa game như PUGB, FreeFire một cách chân thực và sinh động nhất. Tiếng bước chân, tiếng súng, tiếng xe chạy gần như được đồng bộ hoàn hảo để mang đến trải nghiệm sử dụng tốt nhất.</p>\n<p class=\"irIKAp\"> </p>\n<p class=\"irIKAp\"><img style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/3f/23/2d/b5c9e746a1d300a1be4e7834eb9817a0.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<h3 class=\"irIKAp\">Điều khiển dễ dàng với APP</h3>\n<p class=\"irIKAp\">Tai nghe không dây SoundPEATS Air4 Lite được hỗ trợ tích hợp với app SoundPEATS. Người dùng có thể dễ dàng điều khiển các tác vụ khác nhau như: Điều chỉnh EQ theo gout âm nhạc, bật/tắt các chế độ Game Mode, LDAC, kết nối đa điểm, tăng giảm âm lượng, update phần mềm, tắt điều khiển cảm ứng, reset và xem được dung lượng pin của mỗi bên tai nghe.</p>\n<h3 class=\"irIKAp\">Trọng lượng siêu nhẹ</h3>\n<p class=\"irIKAp\">Mỗi bên tai nghe SoundPEATS Air4 Lite chỉ nặng 4g, khi đeo lên tai có cảm giác nhẹ tựa lông hồng. Kết hợp với thiết kế Semi-In-Ear vừa khít với khuôn tai, không tạo cảm giác mỏi tai khi đeo và đau tai khi sử dụng trong thời gian dài.</p>\n<p class=\"irIKAp\"> </p>\n<p class=\"irIKAp\"><img style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/2d/7c/28/e5bed3c930c85c22c57be64ddac9c31b.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p class=\"irIKAp\"> </p>\n<h3 class=\"irIKAp\">Bộ sản phẩm bao gồm:</h3>\n<p class=\"irIKAp\">1x Tai nghe SoundPEATS Air4 Lite</p>\n<p class=\"irIKAp\">1x Cáp sạc Type-C</p>\n<p class=\"irIKAp\">1x HDSD nhiều ngôn ngữ</p>\n<p class=\"irIKAp\"> </p>\n<p class=\"irIKAp\"><img style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/32/29/40/427853934db4ab3767a994bab29a83ee.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<h3 class=\"irIKAp\">Cách kết nối 2 thiết bị</h3>\n<p class=\"irIKAp\">Sau khi tai nghe được ghép nối với thiết bị A, hãy tắt Bluetooth của thiết bị A. Lặp lại thao tác ghép nối để kết nối tai nghe với thiết bị B. Khi quá trình ghép nối hoàn tất, vui lòng bật Bluetooth của thiết bị A để hoàn tất quá trình ghép nối ghép đôi.</p>\n<h3 class=\"irIKAp\">Cách reset tai nghe</h3>\n<p class=\"irIKAp\">1. Đặt cả hai tai nghe trở lại hộp sạc</p>\n<p class=\"irIKAp\">2. Mở nắp hộp, nhấn và giữ nút hộp sạc cho đến khi đèn hộp sạc tắt hẳn đi. sau đó đóng nắp hộp lại.</p>\n<p class=\"irIKAp\">Quá trình reset đã hoàn tất.</p>\n<h3 class=\"_2jrvqA\">Sản phẩm được phân phối chính hãng tại SoundPEATS Vietnam với dịch vụ chăm sóc khách hàng và bảo hành sản phẩm tốt nhất.</h3>\n<h2 class=\"_2jrvqA\">Bảo hành</h2>\n<p class=\"_2jrvqA\">Bảo hành chính hãng 12 tháng</p>\n<p class=\"_2jrvqA\">Bảo hành 1 đổi 1 (Đối với lỗi từ nhà sản xuất)</p>\n<p class=\"_2jrvqA\">Bảo hành thông qua mã đơn mua hàng trên sàn Tiki, không cần hóa đơn.</p>\n<p class=\"_2jrvqA\">Tất cả sản phẩm công ty phân phối đều bảo hành qua mã đơn hàng, khách hàng ở tỉnh nếu không đến trực tiếp có thể gửi qua đường bưu điện, bên công ty sẽ gửi hàng bảo hành tận nơi cho các bạn.</p>\n<p class=\"_2jrvqA\">Trung tâm bảo hành SoundPEATS Vietnam: Phường An Phú, Quận 2, HCM.</p>\n<h3 class=\"_2jrvqA\"><strong>Điều kiện bảo hành:</strong> Vui lòng giữ lại HỘP của sản phẩm và khi cần bảo hành vui lòng chat với Shop qua app Tiki.</h3>\n<h2 class=\"_2jrvqA\"> Hỗ trợ khách hàng</h2>\n<p class=\"_2jrvqA\">Hỗ trợ tư vấn qua khung chat với Shop trên app Tiki</p>\n<p class=\"_2jrvqA\">Thời gian làm việc: 8h - 12h00 và 13h30 - 17h00 (Từ thứ 2 đến thứ 6, trừ các ngày Lễ/Tết).</p>\n<h3 class=\"_2jrvqA\"> Vui lòng QUAY VIDEO khui gói hàng trước khi mở gói hàng để đảm bảo SHOP giao đúng và đủ đơn hàng. Cảm ơn quý khách đã ủng hộ!</h3>\n<p class=\"irIKAp\"> </p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/b5/91/99/313929a4c08e1fc5a96850c8d7d82e83.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b5/91/99/313929a4c08e1fc5a96850c8d7d82e83.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b5/91/99/313929a4c08e1fc5a96850c8d7d82e83.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b5/91/99/313929a4c08e1fc5a96850c8d7d82e83.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b5/91/99/313929a4c08e1fc5a96850c8d7d82e83.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/0e/d4/25/1a61c163f01dad4b0a5917ef5639c1d9.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0e/d4/25/1a61c163f01dad4b0a5917ef5639c1d9.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/0e/d4/25/1a61c163f01dad4b0a5917ef5639c1d9.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0e/d4/25/1a61c163f01dad4b0a5917ef5639c1d9.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0e/d4/25/1a61c163f01dad4b0a5917ef5639c1d9.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/1f/93/7e/f7b0b4f6e0ffe39058f984f78ec308f2.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/1f/93/7e/f7b0b4f6e0ffe39058f984f78ec308f2.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/1f/93/7e/f7b0b4f6e0ffe39058f984f78ec308f2.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1f/93/7e/f7b0b4f6e0ffe39058f984f78ec308f2.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1f/93/7e/f7b0b4f6e0ffe39058f984f78ec308f2.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/20/17/c8/97d548ef352ffaa615a1be601775a416.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/