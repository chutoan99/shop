l":"https://salt.tikicdn.com/cache/280x280/ts/product/8d/27/fa/62f6dc000f3d950c59c560eabb0144c7.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":20,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2\u003eMặt Trăng Và Đồng Xu\u003c/h2\u003e\n\u003cp\u003e\u003cem\u003e“Văn minh là thứ khiến ta phát buồn nôn”\u003c/em\u003e.\u003c/p\u003e\n\u003cp\u003eVới tuyên bố trứ danh đó, Paul Gauguin đã bỏ vợ bỏ con để tới hòn đảo nhiệt đới Tahiti, đào thoát khỏi Châu Âu cùng \u003cem\u003e“tất thảy những thứ giả tạo và hình thức”\u003c/em\u003e. Và đó, bước ngoặt trong sự nghiệp hội họa của một trong những gương mặt quan trọng nhất trào lưu hậu ấn tượng.\u003c/p\u003e\n\u003cp\u003eLấy cảm hứng từ cuộc đời danh họa Paul Gauguin, Mặt trăng và đồng xu là bản tụng ca những thế lực vô hình mãnh liệt đã cám dỗ những thiên tài sáng tạo. Cũng như Gauguin, khi vất bỏ tiện nghi của một người buôn chứng khoán bên vợ đẹp con khôn, nhân vật chính Strickland đã giẫm lên \u003cem\u003e“đồng sáu xu”\u003c/em\u003e để mải miết đuổi theo \u003cem\u003e“vầng trăng”\u003c/em\u003e của đời mình: đam mê hội họa. Qua con mắt quan sát tưởng chừng châm biếm và thản nhiên của Maugham, linh hồn độc địa và khổ sở của Strickland được khắc họa một cách đầy đồng cảm và nhân văn, trở thành biểu tượng của lời nguyền mà cũng là ơn phước của một thiên tài nghệ thuật siêu việt.\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e“Nếu cứ mải tìm đồng sáu xu dưới đất,\u003cbr /\u003eAnh sẽ không ngước lên và bỏ lỡ vầng trăng.”\u003c/em\u003e\u003cbr /\u003e- \u003cstrong\u003eW. Somerset Maugham\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/8d/27/fa/62f6dc000f3d950c59c560eabb0144c7.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/8d/27/fa/62f6dc000f3d950c59c560eabb0144c7.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/8d/27/fa/62f6dc000f3d950c59c560eabb0144c7.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8d/27/fa/62f6dc000f3d950c59c560eabb0144c7.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8d/27/fa/62f6dc000f3d950c59c560eabb0144c7.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/17/22/0e/caec2133f0db31b455a9b2cab96b8a9f.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/17/22/0e/caec2133f0db31b455a9b2cab96b8a9f.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/17/22/0e/caec2133f0db31b455a9b2cab96b8a9f.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/17/22/0e/caec2133f0db31b455a9b2cab96b8a9f.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/17/22/0e/caec2133f0db31b455a9b2cab96b8a9f.jpg"}],"warranty_policy":null,"authors":[{"id":7381,"name":"W. Somerset Maugham","slug":"w-somerset-maugham"}],"current_seller":{"id":57167,"sku":"5802379716901","name":"Nhà sách NetaBooks","link":"https://tiki.vn/cua-hang/nha-sach-netabooks","logo":"https://vcdn.tikicdn.com/ts/seller/33/f2/97/e245fe4d226f0e26fb1cc7ba3741d661.jpg","price":107100,"product_id":"275970246","store_id":54106,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Thông tin chung","attributes":[{"code":"publisher_vn","name":"Công ty phát hành","value":"Nhã Nam