ext_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":39000,"discount_rate":23,"rating_average":5,"review_count":10,"review_text":"(10)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/3b/9a/a5/938c7a3a4096fed5010739e8d133cd6a.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":517,"all_time_quantity_sold":102,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align:center;\"\u003e\u003cspan style=\"color:#ff0000;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/5e/9d/bc/8377c591e625579343a59421212689e3.jpg\" alt=\"\" width=\"750\" height=\"436\" /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003eTác giả: Ngô Đức Vượng\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003eNgày xuất bản: 2023\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003eKích thước: 14.5 x 20.5 cm\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003eNhà xuất bản: NXB Tổng hợp\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003eLoại bìa: Bìa mềm\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003eSố trang: 408\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e---\u003c/p\u003e\n\u003cp\u003eCơ thể được xây đắp bởi đồ ăn thức uống hàng ngày, nguồn năng lượng cho chúng ta hoạt động cũng từ đó. Vì vậy, hiểu biết \u003cstrong\u003e\u003cem\u003eMinh triết trong Ăn uống của phương Đông \u003c/em\u003e\u003c/strong\u003elà điều vô cùng cần thiết. Tác giả Ngô Đức Vượng từ lâu đã quan tâm tới vấn đề này. Ông đã ăn chay trường, ăn gạo lứt muối vừng, nhịn ăn chữa bệnh cho chính mình và giúp cho nhiều người thực hành tự chữa bệnh, dưỡng sinh, nâng cao sức khỏe, thu nhiều kết quả tốt đẹp từ nhiều năm nay. Với thiện chí đem lại sức khỏe và trị bệnh không dùng thuốc, ít tốn kém, dễ thực hành…cho cộng đồng, tác giả đã viết cuốn sách này, nhằm cống hiến cho bạn đọc những lời khuyên quý giá và đáp ứng những nhu cầu cần thiết cho độc giả.\u003c/p\u003e\n\u003cp\u003eLà một nhà khoa học chân chính, lương y giàu kinh nghiệm, đã từng tự chữa cho mình mọi bệnh từ cảm cúm đến ung thư, nên tác phẩm của ông đáp ứng được nhiều yêu cầu của bạn đọc. Cung cấp kiến thức tổng quát, tư duy thông thái, giúp người đọc có tầm nhìn và sự đánh giá vấn đề sức khỏe một cách sáng suốt, cùng với những kinh nghiệm thực tiễn giúp cho việc áp dụng vào cuộc sống dễ dàng hơn. Chính vì vậy \u003cstrong\u003eMinh triết trong Ăn uống của phương Đông \u003c/strong\u003ecủa ông là một đóng góp lớn, có giá trị trong lĩnh vực nâng cao sức khỏe và dân trí cho mọi người.\u003c/p\u003e\n\u003cp\u003eVới lần tái bản này, cuốn sách có nhiều thay đổi về nội dung cũng như hình thức, nhằm hoàn thiện và đáp ứng phần nào nhu cầu của bạn đọc và chú ý nhấn mạnh vai trò của ăn uống đối với sức khỏe thể chất, tinh thần của mọi người.\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e///\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/3b/9a/a5/938c7a3a4096fed5010739e8d133cd6a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/3b/9a/a5/938c7a3a4096fed5010739e8d133cd6a.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/3b/9a/a5/938c7a3a4096fed5010739e8d133cd6a.jpg","position":null,"small