color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":1100000,"discount_rate":44,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/a8/56/3d/5ae4d5b11f497ae7689c008a88cca498.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":503,"all_time_quantity_sold":5,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eThưởng thức sữa hạt ngọt lành mỗi ngày một cách tiện lợi và tràn đầy cảm hứng cùng UMB09 – Chiếc máy làm sữa hạt sở hữu thiết kế nhỏ gọn, màu sắc trendy cùng nhiều tính năng cải tiến ấn tượng.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eThiết kế mới – Đa sắc màu thời thượng\u003c/p\u003e\n\u003cp\u003eUMB09 được đánh giá là một trong những sản phẩm máy nấu sữa hạt mini có thiết kế đẹp cùng màu sắc pastel thời thượng “hút mắt” nhất trên thị trường hiện nay.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eDung tích 800ml – Lớn hơn, tiện lợi hơn\u003c/p\u003e\n\u003cp\u003eDù vẫn giữ thiết kế nhỏ gọn, song ở phiên bản mới này, nhà Unie đã nghiên cứu và cải tiến lòng bình. Tăng dung tích lên 800ml, vượt trội hơn 40-50% so với các máy nấu sữa mini khác.\u003c/p\u003e\n\u003cp\u003eNhư vậy, với UMB09 chúng ta hoàn toàn có thể nấu được 3-4 ly sữa hạt ngậy thơm, dinh dưỡng.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eNắp chụp chống ồn \u003c/p\u003e\n\u003cp\u003eĐây là tính năng mới được người dùng quan tâm nhất của máy làm sữa hạt Unie UMB09. Phần nắp chụp chống ồn được thiết kế thông minh, không chỉ tạo nên điểm nhấn độc đáo cho chiếc máy mà hơn hết là sẽ giảm thiểu tối đa tiếng xay nấu.\u003c/p\u003e\n\u003cp\u003eNgười dùng có thể hoàn toàn yên tâm bởi công suất xay nấu 150W- 600W nhưng vẫn êm ru, không hề ảnh hưởng tới sinh hoạt gia đình hoặc không gian văn phòng làm việc.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e6 chức năng xay nấu đa dạng và tiện lợi\u003c/p\u003e\n\u003cp\u003eMáy làm sữa hạt Unie UMB09 được trang bị tới 6 chế độ xay nấu chuyên sâu bao gồm: Sữa nấu nhanh, sữa nấu chậm, sinh tố, cháo dinh dưỡng, sữa ngô và chức năng tự vệ sinh. Mỗi chức năng đã được cài đặt sẵn nhiệt độ và thời gian phù hợp, giúp bạn dễ dàng nấu nướng mà không bận tâm tới việc \u003c/p\u003e\n\u003cp\u003eNgoài 5 chế đậu xay nấu tiện lợi, UMB09 còn có chức năng “Vệ sinh” giúp bạn dễ dàng lau rửa máy hơn.\u003c/p\u003e\n\u003cp\u003eKhả năng xay nấu siêu nhuyễn mịn\u003c/p\u003e\n\u003cp\u003eNhư đã đề cập, Unie UMB09 sở hữu công suất nấu lên tới 600W cùng với đó là lưỡi dao INOX 304 8 cánh sắc bén giúp việc xay nấu cực kỳ nhanh chóng, mạnh mẽ cho dòng sữa hạt sánh mịn hoàn hảo, không cần mất công xay lọc nhiều lần.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eNguyên liệu an toàn tuyệt đối cho sức khỏe người dùng\u003c/p\u003e\n\u003cp\u003eBên cạnh lưỡi dao, toàn bộ phần cối máy tiếp xúc trực tiếp với thực phẩm cũng được làm bằng INOX 304 an toàn với sức khỏe người sử dụng, không gây phản ứng hoá học ở nhiệt độ cao.\u003c/p\u003e\n\u003cp\u003eNgoài ra, phần vỏ máy được làm từ nhựa PP an toàn, chịu nhiệt tốt, không bị ảnh hưởng khi máy nấu sôi trong thời gian dài. Nhờ vậy mà bạn có thể hoàn toàn an tâm khi sử dụng máy làm sữa hạt UMB09 để nấu sữa, chế biến thực phẩm cho gia đình, kể cả với trẻ nhỏ.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eThông số kỹ thuật máy làm sữa hạt Unie UMB09\u003c/p\u003e\n\u003cp\u003eThương hiệu: Unie\u003c/p\u003e\n\u003cp\u003eĐiện áp: 220V/50Hz\u003c/p\u003e\n\u003cp\u003eCông suất nấu: 600W\u003c/p\u003e\n\u003cp\u003eCông suất xay: 150W\u003c/p\u003e\n\u003cp\u003eDung tích: 800ml\u003c/p\u003e\n\u003cp\u003eTrọng lượng: 1.3kg\u003c/p\u003e\n\u003cp\u003eKích thước: 198x155x299mm\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/a8/56/3d/5ae4d5b11f497ae7689c008a88cca498.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a8/56/3d/5ae4d5b11f497ae7689c008a88cca498.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a8/56/3d/5ae4d5b11f497ae7689c008a88cca498.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a8/56/3d/5ae4d5b11f497ae7689c008a88cca498.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a8/56/3d/5ae4d5b11f497ae7689c008a88cca498.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/63/1a/57/d89032311103720dca02b2edf10dbeba.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/63/1a/57/d89032311103720dca02b2edf10dbeba.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/63/1a/57/d89032311103720dca02b2edf10dbeba.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/63/1a/57/d89032311103720dca02b2edf10dbeba.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/63/1a/57/d89032311103720dca02b2edf10dbeba.jpg"},{"base_url":"https://salt.tikicdn.com