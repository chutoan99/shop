g","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":55000,"discount_rate":1,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/d7/7a/ae/27ca249baeaedbaf7dc578577fe1a785.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":936,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eKhu vực ngoại thành HCM có giao hàng tính phí, vui lòng liên hệ trước.\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e* Lắp đặt miễn phí lúc giao hàng ở nhà trệt / có thang máy, vật tư phát sinh tính phí.\u003c/p\u003e\n\u003cp\u003e* Cần hỗ trợ giao hàng nhanh, quý KH vui lòng liên hệ / chat với shop nhé\u003c/p\u003e\n\u003cp\u003e* Bảo hành chính hãng 02 năm, có người đến tận nhà.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color:#ff0000;\"\u003e- Lỗi đổi trả theo CHÍNH SÁCH của sàn.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color:#ff0000;\"\u003e- Bảo hành chính hãng TẬN NHÀ ( đối với sản phẩm điện lạnh - điện tử)\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color:#ff0000;\"\u003e- Bảo hành tại trạm ủy quyền ( đối với sản phẩm gia dụng nhỏ)\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color:#ff0000;\"\u003e- Giao hàng \u0026amp; lắp đặt TẬN NƠI, CÙNG LÚC.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color:#ff0000;\"\u003e- ĐƯỢC KHUI THÙNG KIỂM TRA sản phẩm trước khi thanh toán/ký nhận\u003c/span\u003e\u003c/p\u003e\n\u003ch5\u003e \u003c/h5\u003e\n\u003ch5\u003eThiết kế sang trọng, hiện đại\u003c/h5\u003e\n\u003cp\u003e\u003cstrong\u003eMáy sấy Electrolux 8.5 kg EDV854N3SB\u003c/strong\u003e thuộc dòng máy sấy thông hơi sử dụng thanh điện trở nhiệt để làm nóng không khí. Quạt gió trong mấy sấy sẽ thổi qua thanh điện trở để đẩy không khí nóng vào trong buồng sấy làm nước trong quần áo bay hơi nhanh và tiết kiệm điện năng hơn.\u003c/p\u003e\n\u003ch5\u003eTiết kiệm thời gian với chu kỳ sấy nhanh 30 phút\u003c/h5\u003e\n\u003cp\u003eChọn chu kỳ hẹn giờ 30 phút để làm khô các loại vải hàng ngày, vải bông hoặc vải pha cần sấy nhanh. Chương trình này làm khô các tải nhỏ hơn của bạn trong vòng 30 phút, đối với những thời điểm đó, bạn chỉ cần hoàn thành công việc một cách nhanh chóng.\u003c/p\u003e\n\u003ch5\u003eCông nghệ sấy đảo chiều\u003c/h5\u003e\n\u003cp\u003eKhông cần lo lắng về vấn đề quần áo dễ bị nhăn nhúm sau khi sử dụng máy giặt + máy sấy, Với thiết kế lồng sấy chuyên biệt cùng công nghệ sấy đảo chiều giúp quần áo của bạn giảm nhăn hơn 32% so với những công nghệ sấy khô thông thường.\u003c/p\u003e\n\u003ch5\u003eCảm biến Smart Sensor\u003c/h5\u003e\n\u003cp\u003eMáy sấy Electrolux 8.5kg EDV854N3SB được trang bị cảm biến thông minh Smart Sensor giúp bạn không phải tốn nhiều thời gian để điều chỉnh máy nhờ khả năng tự điều chỉnh thời gian sấy thông minh dựa trên khối lượng cũng như độ ẩm của quần áo, đồng thời giúp quần áo được sấy khô ở mức lý tưởng, hạn chế hư hỏng.\u003c/p\u003e\n\u003ch5\u003eQuần áo khô nhanh, tiết kiệm điện với công nghệ sấy thông hơi\u003c/h5\u003e\n\u003cp\u003eCông nghệ này giúp sấy khô quần áo nhanh chóng, tiết kiệm chi phí điện cho gia đình bạn. Máy sấy quần áo Electrolux EDV854N3SB phù hợp cho gia đình có cửa sổ hoặc không gian rộng rãi, ống thông hơi có thể lắp trước hoặc sau máy tiện lợi.\u003c/p\u003e\n\u003ch5\u003eBảo vệ sức khỏe với túi lọc bụi giúp an toàn cho người sử dụng\u003c/h5\u003e\n\u003cp\u003eChức năng lọc bụi với túi lọc nhỏ của máy sấy này giúp lọc những hạt bụi vải vô cùng nhỏ mà mắt thường khó thấy, những hạt này nếu chúng ta hít phải trong thời gian dài sẽ ảnh hưởng tới sức khỏe. Vì thế, những gia đình có em bé hoặc người mẫn cảm với bụi bẩn sẽ thích hợp nhất với chức năng này.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/d7/7a/ae/27ca249baeaedbaf7dc578577fe1a785.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d7/7a/ae/27ca249baeaedbaf7dc578577fe1a785.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d7/7a/ae/27ca249baeaedbaf7dc578577fe1a785.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d7/7a/ae/27ca249baeaedbaf7dc578577fe1a785.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d7/7a/ae/27ca249baeaedbaf7dc578577fe1a785.png"},{"base_url":"https://salt.tikicdn.com/ts/product/5b/8d/69/ec7b66ae5352b7dad4cd4eef0adf8657.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/5b/8d/69/ec7b66ae5352b7dad4cd4eef0adf8657.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/5b/8d/69/ec7b66ae5352b7dad4cd4eef0adf8657.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5b/8d/69/ec7b66ae5352b7dad4cd4eef0adf8657.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5b/8d/69/ec7b66ae5352b7dad4cd4eef0adf8657.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/90/48/5c/6296267c55ab2827e5a9fc885ecafc83.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/prod