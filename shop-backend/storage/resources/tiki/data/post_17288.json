href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/14/90/f0/41b2e7bd552a76ad7d625141e316640b.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":705,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp class=\"title-ar\"\u003eMÔ TẢ\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eVang cơ Jarguar S850A Platinum\u003c/strong\u003e là model vang cơ với sự kết hợp giữa 2 model S1000 và S600 của hãng Jarguar. \u003cstrong\u003eS850A\u003c/strong\u003e được nâng cấp rất nhiều về hiệu quả âm thanh, sự ổn định và tích hợp nhiều tính năng hiện đại đáng tiền\u003c/p\u003e\n\u003ch2\u003e1. Vang cơ Jarguar S850A Platinum hát hay mà không cần phải chỉnh\u003c/h2\u003e\n\u003cp\u003eVang cơ luôn chứng tỏ là thiết bị phù hợp dành cho các gia đình hát Karaoke. Nếu như vang số rất khó để căn chỉnh thì với vang cơ Jarguar, mọi nhà đều không cần nắm rõ các thông số phức tạp vẫn đạt được 90% hiệu quả âm thanh. Vang cơ Jarguar Hàn Quốc sẵn sàng sử dụng ngay khi khách hàng mua về. Vang Jarguar được tối ưu sẵn, bạn không cần chỉnh nhiều mà hát Karaoke vẫn rất tuyệt vời. Đó chính là ưu điểm mạnh nhất của Vang cơ Jarguar.\u003c/p\u003e\n\u003cdiv class=\"wp-caption aligncenter\"\u003e\n\u003cp\u003e\u003cimg class=\"aligncenter size-full wp-image-11515\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/e6/a4/b1/567e5ea3e7c5e8dde048758b1679932a.jpg\" alt=\"Vang cơ Jarguar S850A (7)\" width=\"1000\" height=\"563\" /\u003e\u003c/p\u003e\n\u003cp class=\"wp-caption-text\"\u003eVang cơ Jarguar S850A Platinum\u003c/p\u003e\n\u003c/div\u003e\n\u003ch2\u003e2. Điều chỉnh chi tiết các dải tần Mic\u003c/h2\u003e\n\u003cp\u003eĐây là tính năng cao cấp của vang cơ S850A so với 2 model vang cơ S600 và vang cơ S800. Trên S850A cho phép người dùng có thể điều chỉnh dải tần từ 63Hz đến 7,4kHz bằng 6 cần xoay: 63Hz, 250Hz, 1,5kHz, 3,2kHz, 7,4kHz. Các cần xoay này có thể tăng giảm 3 dải tần Bass, Mid, Trép chi tiết hơn, để phù hợp với nhiều chất giọng khác nhau. S850A cân được mọi loại giọng hát, chỉ cần bạn biết giọng của bạn cần tăng giảm ở giải tần nào. Không hề khó với S850A\u003cbr /\u003eHát Karaoke sẽ hay hơn và chuyên nghiệp hơn rất nhiều nếu có tính năng là Echo. Với Delay là 3 thông số: Delay, Repeat, Level. S850A luôn đề cao tính năng chuyên nghiệp được chỉnh bằng cách dễ dàng nhất. Qua thời gian thử nghiệm sản phẩm, âm thanh delay của S850A rất mềm mại.\u003c/p\u003e\n\u003ch2\u003e3. Cổng kết nối Sub riêng\u003c/h2\u003e\n\u003cp\u003eVới sự phổ biến của các dòng sub trong các dàn Karaoke gia đình, hãng Jarguar Electronics Hàn quốc cũng dành riêng 1 đường kết nối Sub trên S850A. Khi kết nối, người dùng có thể điều chỉnh được tần số và âm lượng của Sub trên chính chiếc S850A này, giúp âm thanh của Sub được hòa quyện vào âm thanh của cả bộ dàn Karaoke, mà S850A chính là “nhạc trưởng”.\u003c/p\u003e\n\u003ch2\u003e4. Anti-Feedback có thể bật tắt\u003c/h2\u003e\n\u003cp\u003eTrên các sản phẩm trước đây của hãng, mặc định tính năng giảm hú rít luôn được bật sẵn. Tuy nhiên, S850A lại cho phép người dùng có thể lựa chọn . Tắt đi tính năng bộ dàn không có tiếng hú rít là lựa chọn không tồi. Còn khi bật lên, hú rít giảm tới 80-90% mà vẫn giữ được chất âm, âm thanh không hề bị méo như trên 1 số thiết bị.\u003c/p\u003e\n\u003cp\u003eMạch Anti-Feedback phát ra luồng sóng âm thanh siêu nhỏ liên tục, để khi gặp các tần số gây hú rít phát ra từ loa, sẽ được triệt tiêu. Chỉ những thiết bị Karaoke hiện đại mới trang bị mạch Anti-Feedback hiện đại này\u003c/p\u003e\n\u003ch2\u003e5. Trang bị kết nối hiện đại\u003c/h2\u003e\n\u003cp\u003eTrên Vang cơ Vang cơ Jarguar S850A Platinum, khách hàng có thể tìm đầy đủ những kết nối hiện đại nhất. Bluetooth 5.0, USB, Optical, Coaxial\u003cbr /\u003e– Bluetooth 5.0 là chuẩn kết nối Bluetooth hiện đại nhất hiện nay. Kết nối xa và mạnh nhất\u003cbr /\u003e– USB rất tiện lợi cho những khách hàng có list nhạc quen thuộc của tiêng mình\u003cbr /\u003e– Cổng quang Optical rất tiện lợi khi kết nối với SmartTV\u003c/p\u003e\n\u003ch2\u003e6. Vang cơ Jarguar S850A Platinum bảo hành 3 năm\u003c/h2\u003e\n\u003cp\u003eVang cơ Jarguar Electronics có độ bền vượt trội. Hệ thống vận hành ổn định. Tất cả các vang cơ của Jarguar giống như các Amply, đều có thời gian bảo hành lên đến 3 năm, là minh chứng cho chất lượng.\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"aligncenter size-full wp-image-11515\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/e6/a4/b1/567e5ea3e7c5e8dde048758b1679932a.jpg\" alt=\"Vang cơ Jarguar S850A (7)\" width=\"1000\" height=\"563\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"aligncenter size-full wp-image-11516\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/e2/52/38/49a467f3d0cd92940ba5cb6c7a51ea87.jpg\" alt=\"\" width=\"1000\" height=\"563\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"aligncenter size-full wp-image-11514\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/6c/e5/aa/b0ac54ee62d8d6f7963eceebe3428045.jpg\" alt=\"\" width=\"1000\" height=\"563\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"aligncenter size-full wp-image-11513\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/ed/85/8c/faaaca7b5605fca6e7651c14e69a5a9e.jpg\" alt=\"\" width=\"1000\" height=\"563\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"aligncenter size-full wp-image-11512\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/8d/7b/70/8033a4f8b63ff58aa98c662f83db7362