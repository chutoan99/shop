f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":25200,"discount_rate":16,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/91/ee/a5/16af70002a1fef6670175995da4b101b.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":777,"all_time_quantity_sold":7,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eTính năng nổi bật:\u003c/p\u003e\n\u003cp\u003e  ● Cực kì chắc chắn với chất liệu nhôm cao cấp\u003c/p\u003e\n\u003cp\u003e  ● Sử dụng chip VL812 mới nhất giúp kiểm soát và đem lại sự ổn định cho các thiết bị\u003c/p\u003e\n\u003cp\u003e  ● Tốc độ truyền dữ liệu 5Gbps cho cổng USB 3.0\u003c/p\u003e\n\u003cp\u003e  ● Đầu ra: 1 cổng USB 3.0. 3 cổng USB 2.0\u003c/p\u003e\n\u003cp\u003e  ● Chỉ cần cắm và sử dụng không cần cài đặt\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cstrong\u003e️ Công Dụng\u003c/strong\u003e\u003c/em\u003e:\u003c/p\u003e\n\u003cp\u003eOrico AH-13-GY là bộ chia từ 1 cổng type C thành 4 cổng USB (1 cổng USB 3.0. 3 cổng USB 2.0), giúp mở rộng các thiết bị có ít cổng USB trên các máy tính hay laptop hiện nay\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/f7/f8/b1/e202e52824271e3f1b677a3f697c126e.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e️ 4 cổng USB tiện lợi\u003c/p\u003e\n\u003cp\u003eHub USB AH-13 chính hãng trang bị 4 cổng kết nối chuẩn USB, Thiết bị hoạt động như một trạm chuyển dữ liệu mini để chứa bộ sưu tập các thiết bị USB, cho phép kết nối 4 thiết bị USB với máy tính bảng, máy tính xách tay hoặc máy tính.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/03/b5/a0/24392eb6c55d2bc272f779da1b0e4d82.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cem\u003e️Thiết kế sang trọng với chất liệu nhôm chắc chắn \u003c/em\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eHub USB 4 cổng AH-13 có thiết kế đơn giản dạng thanh nhỏ gọn mang lại cho bạn sự tiện lợi khi sử dụng và tiết kiệm được khá nhiều diện tích không gian làm việc của bạn đặc biệt rất gọn gàng khi để trên bàn làm việc\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/6d/ee/16/f395f52b05a6ee9566f02186a6e42c3d.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cem\u003e️ Tốc độ truyền tải nhanh \u003c/em\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eChuẩn USB 3.0 có tốc độ truyền tải tín hiệu và dữ liệu lên đến 5Gbps trên cổng USB 3.0, nhanh hơn gấp 10 so với cổng USB 2.0 thông thường. Điều này giúp bạn tiết kiệm thời gian đáng kể để thực hiện công việc một cách nhanh chóng và dễ dàng hơn\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/25/b1/aa/caccdff14effe1fa706de293edd6d42a.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cstrong\u003e️ Hoạt động ổn định với chip mới nhất \u003c/strong\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003eOrico AH-13 là một bộ chia thông minh nhưng mạnh mẽ, nó không cần cài đặt hay một ứng dụng nào đó để làm việc. Chỉ cần cắm vào và dùng, đây là điều cực kỳ dễ dàng trong quá trình bạn làm việc khi cần mở rộng số cổng usb để kết nối nhiều thiết bị hơn. Bên cạnh đó hỗ trợ bảo vệ quá tải , quá dòng cho các thiết bị giúp bảo vệ các thiết bị ngoại vi\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/c4/b2/80/db5f22fd58628a4c51359815ff974d38.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/91/ee/a5/16af70002a1fef6670175995da4b101b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/91/ee/a5/16af70002a1fef6670175995da4b101b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/91/ee/a5/16af70002a1fef6670175995da4b101b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/91/ee/a5/16af70002a1fef6670175995da4b101b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/91/ee/a5/16af70002a1fef6670175995da4b101b.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/bb/fa/b5/48805450ca6d6d2ec60c87c1412e42ce.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/bb/fa/b5/48805450ca6d6d2ec60c87c1412e42ce.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/bb/fa/b5/48805450ca6d6d2ec60c87c1412e42ce.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/bb/fa/b5/48805450ca6d6d2ec60c87c1412e42ce.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/bb/fa/b5/48805450ca6d6d2ec60c87c1412e42ce.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/36/b8/2c/8c6f52768872216322f52fa6586bb24e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/36/b8/2c/8c6f52768872216322f52fa6586bb24e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/36/b8/2c/8c6f52768872216322f52fa6586bb24e.jpg","position":null,"small_url":"https:/