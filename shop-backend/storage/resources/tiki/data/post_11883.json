d97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":211000,"discount_rate":22,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/39/eb/bf/37034df98e014e6d1b41e0133259405c.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":265,"all_time_quantity_sold":3,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p class=\"irIKAp\"><strong>***Cặp đa năng Sakos Flash 26: KẾ THỪA TÍNH TIỆN LỢI - VƯỢT TRỘI SỰ ĐA NĂNG***</strong></p>\n<p class=\"irIKAp\">Với thiết kế có tính ứng dụng cao và vô cùng tiện lợi, Sakos Flash 26 nằm trong bộ sưu tập cặp đa năng được trang bị “4 trong 1”, phù hợp với từng outfit, mang đến cho người sử dụng sự linh hoạt và mới mẻ mỗi ngày.</p>\n<p class=\"irIKAp\"><strong>1. THÔNG SỐ CỦA SẢN PHẨM</strong></p>\n<p class=\"irIKAp\">- Thương hiệu: Sakos</p>\n<p class=\"irIKAp\">- Màu sắc: Đen phối đỏ, Đen phối xám</p>\n<p class=\"irIKAp\">- Chất liệu: Polyester</p>\n<p class=\"irIKAp\">- Trọng lượng: 0.9 kg</p>\n<p class=\"irIKAp\">- Kích thước RxSxC: 41x10x30cm</p>\n<p class=\"irIKAp\">- Tải trọng: 10 kg</p>\n<p class=\"irIKAp\">- Bảo hành: chính hãng 01 năm</p>\n<p class=\"irIKAp\"><strong>2. CHI TIẾT SẢN PHẨM</strong></p>\n<p class=\"irIKAp\"><strong>Phiên bản lạ mắt và tinh tế</strong></p>\n<p class=\"irIKAp\">- Bộ sưu tập cặp đa năng Sakos Flash liên tục cháy hàng từ khi ra mắt. Kế thừa từ dòng cặp đa năng Sakos Flash trước đó, phiên bản số 26 tăng thêm viền đỏ hoặc xám nổi bật với diện mạo vuông vức, được biến tấu với thiết kế lạ mắt nhưng tinh tế.</p>\n<p class=\"irIKAp\">- Điểm nhấn còn nằm ở dây kéo kim loại sang trọng, chống gỉ sét khiến bạn thật hứng thú mỗi khi mở cặp.</p>\n<p class=\"irIKAp\"><strong>Đa tính năng nhưng “siêu nhẹ”</strong></p>\n<p class=\"irIKAp\">- Dù được tích hợp chức năng “4 trong 1” balo, cặp xách ngang, cặp xách dọc, cặp đeo chéo nhưng Sakos Flash 26 siêu nhẹ, có độ bền cao, giữ được màu sắc và form dáng sau thời gian dài sử dụng.</p>\n<p class=\"irIKAp\">- Được làm từ chất liệu vải polyester cao cấp giúp người dùng toát lên sự năng động nhưng không kém phần thanh lịch. Chất liệu polyester có tính trượt nước kết hợp vải lót chống thấm, hút ẩm và kháng khuẩn giúp đồ đạc chứa bên trong luôn được khô thoáng và an toàn.</p>\n<p class=\"irIKAp\"><strong>Không chỉ chứa được laptop 15.6 inch</strong></p>\n<p class=\"irIKAp\">Trung thành với thiết kế nhiều ngăn chứa, không gian rộng rãi, đặc biệt Sakos Flash 26 có sức chứa lớn của 2 ngăn chính và hơn 10 ngăn phụ để chứa tập sách, tài liệu và nhiều vật dụng khác nhau:</p>\n<p class=\"irIKAp\">- Có ngăn đựng laptop riêng, vừa vặn với các dòng laptop có kích thước 15.6 inch được chống sốc tối ưu.</p>\n<p class=\"irIKAp\">- Chứa được nhiều tập sách, hồ sơ tài liệu khổ A4 mà không lo bị quăn góc.</p>\n<p class=\"irIKAp\">- Bên trong ngăn chính được bố trí các ngăn phụ một cách thông minh, giúp để các món đồ quan trọng như ví tiền, hộ chiếu, thẻ ngân hàng, điện thoại di động,…</p>\n<p class=\"irIKAp\">- Giúp phân loại vật dụng theo từng ngăn, dễ dàng tìm kiếm nhanh chóng đồ đạc khi cần.</p>\n<p class=\"irIKAp\">2 ngăn phụ bên ngoài vừa tinh tế, vừa tiện lợi để chứa các vật dụng, thiết bị cần cất lấy nhanh chóng như sạc dự phòng, thẻ xe, thẻ sinh viên, thẻ chung cư, tiền lẻ, khẩu trang,…</p>\n<p class=\"irIKAp\"><strong>3. SAKOS CAM KẾT VỚI KHÁCH HÀNG</strong></p>\n<p class=\"irIKAp\">- 1 ĐỔI 1 trong vòng 07 ngày sản phẩm bị lỗi do nhà sản xuất (nhắn tin cho Shop để được hỗ trợ nhanh nhất).</p>\n<p class=\"irIKAp\">- BẢO HÀNH chính hãng theo chính sách của Sakos.</p>\n<p class=\"irIKAp\"><strong>4. DỊCH VỤ CỦA SAKOS</strong></p>\n<p class=\"irIKAp\">- Các sản phẩm của Sakos khi giao đến tay khách hàng thân yêu &lt;3 đều được kèm theo Phiếu Bảo Hành chính hãng của Sakos</p>\n<p class=\"irIKAp\">- Gói hàng cẩn thận trước khi giao cho khách.</p>\n<p class=\"irIKAp\">- Hỗ trợ tư vấn chăm sóc khách hàng 24/7 (khách iu ơi! Nhắn cho Sakos ngay nhé)</p>\n<p class=\"irIKAp\"><strong>___KHÁCH HÀNG B2B - QUÀ TẶNG DOANH NGHIỆP VUI LÒNG NHẮN TIN CHO SHOP ĐỂ ĐƯỢC HỖ TRỢ MỨC TỐT NHẤT___</strong></p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/39/eb/bf/37034df98e014e6d1b41e0133259405c.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/39/eb/bf/37034df98e014e6d1b41e0133259405c.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/39/eb/bf/37034df98e014e6d1b41e0133259405c.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/39/eb/bf/37034df98e014e6d1b41e0133259405c.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/39/eb/bf/37034df98e014e6d1b41e0133259405c.png"},{"base_url":"https://salt.tikicdn.com/ts/product/68/f1/26/0f63d24b20e0d1ce068d235a6f334874.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/68/f1/26/0f63d24b20e0d1ce0