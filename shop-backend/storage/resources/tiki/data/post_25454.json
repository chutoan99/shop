_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.3,"review_count":3,"review_text":"(3)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/78/34/84/bc66d8cc59943fcb46c37e863b1db7e3.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":354,"all_time_quantity_sold":10,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eTên sản phẩm: Micro không dây SHURE UGX31 - SHURE UGX 31 PLUS\u003c/p\u003e\n\u003cp\u003e*Phụ kiện bao gồm\u003c/p\u003e\n\u003cp\u003e- 2 Tay Micro (Kèm 4 pin AA)\u003c/p\u003e\n\u003cp\u003e- Cục Nguồn\u003c/p\u003e\n\u003cp\u003e- 4 Râu ăng ten\u003c/p\u003e\n\u003cp\u003e- 1 Dây kết nối 6mm\u003c/p\u003e\n\u003cp\u003e- 2 Chống Lăn\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/bc/9d/f7/3cf52924bd815c79297e08ad425a135d.jpg\" alt=\"\" width=\"750\" height=\"421\" /\u003e\u003c/p\u003e\n\u003cp\u003e*Mô tả\u003c/p\u003e\n\u003cp\u003e- UGX 31 là dòng Micro không dây rất đươc ưa chuộng và gặp thường xuyên ở các Phòng Hát Karaoke , Hội Trường , Sân Khấu Chuyên Nghiệp vì chất lượng của nó .Khả năng kết nối ổn định, mạnh mẽ , tối ưu , mang đến trải nghiệm mượt mà và hiện đại cho người dùng ngay từ những lần đầu tiên chạm vào.\u003c/p\u003e\n\u003cp\u003e*Thông số kỹ thuật\u003c/p\u003e\n\u003cp\u003e- Kênh điều khiển: UHF 6 số .\u003c/p\u003e\n\u003cp\u003e- Kênh: 2 . Sóng : 4 Anten 100 Mét\u003c/p\u003e\n\u003cp\u003e- Năng lượng: Pin AA 1.5V\u003c/p\u003e\n\u003cp\u003e- Nguồn cấp điện: 110-240V\u003c/p\u003e\n\u003cp\u003e- Kích thước: Cao 4cm x Sâu 20cm x Rộng 44cm\u003c/p\u003e\n\u003cp\u003e- Trọng lượng cả hộp: 3.8kg\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/0b/e3/0a/7f2c586b1a7a33754db747163f8c8976.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e*Tính năng\u003c/p\u003e\n\u003cp\u003e- UGX 31 được thiết kế theo phong cách hoàn toàn mới. Với mặt trước làm bằng kính Mica đen huyền bí kết hợp với nhôm phay màu đen rất tinh tế. Volume của 2 tay được điều chỉnh thông qua 2 núm vặn lớn có đèn led màu trông rất nổi bật.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e- Tay Micro SHURE UGX 31 có thiết kế độc đáo gây ấn tượng, hiện đại với lớp vỏ kim loại sáng chống bám vân tay, mồ hôi tạo cảm giác đầm tay thoải mái khi sử dụng.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e- Linh kiện sử dụng bên trong cục phát là những linh kiện chất lượng cao. Toàn bộ vỉ mạch là Main tím xịn và 4 hộp sóng lớn nối với 4 râu Ăng ten siêu khỏe .\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e- UGX 31 sử dụng công nghệ Wireless với bán kính thu phát lên đến hơn 100m, tăng khả năng ổn định tín hiệu âm thanh. Sản phẩm có bộ lọc tốt, tỉ lệ tạp âm rất nhỏ giúp cho âm thanh phát ra luôn được trong trẻo mượt mà.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e- UGX 31 sử dụng công nghệ tự động dò sóng sạch, với tính năng này, dù người dùng có sử dụng thiết bị ở trong môi trường hỗn hợp với nhiều loại thiết bị điện tử khác nhau thì tay mic và đầu thu vẫn luôn đảm bảo được đường truyền tốt\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e- UGX 31 đời mới tích hợp công nghệ chống hú tối ưu , xử lý âm thanh trung thực và hỗ trợ người hát rất tốt khi bị mất hơi , độ nhạy cao nên hát rất nhẹ; khả năng chống hú rất tốt .\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e- Chế Độ Tự Động Ngắt - Mở Siêu Tiết Kiệm Pin sau 5s khi đặt xuống bàn ,chỉ cần nâng lên sẽ tự dộng bật Mic trở lại. Sau 5p tự động tắt hẳn.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e- Chế Độ Dò Chỉnh Tần Số Sóng vô cùng hiện đại, giúp dễ dàng đổi tay mic hay đầu thu mới khi lỗi hỏng mà không cần phải thay cả bộ.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/78/34/84/bc66d8cc59943fcb46c37e863b1db7e3.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/78/34/84/bc66d8cc59943fcb46c37e863b1db7e3.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/78/34/84/bc66d8cc59943fcb46c37e863b1db7e3.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/78/34/84/bc66d8cc59943fcb46c37e863b1db7e3.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/78/34/84/bc66d8cc59943fcb46c37e863b1db7e3.png"},{"base_url":"https://salt.tikicdn.com/ts/product/e2/1a/2d/83445128e25d3f9bc9f8856b53455421.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e2/1a/2d/83445128e25d3f9bc9f8856b53455421.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e2/1a/2d/83445128e25d3f9bc9f8856b53455421.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e2/1a/2d/83445128e25d3f9bc9f8856b53455421.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e2/1a/2d/83445128e25d3f9bc9f8856b53455421.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/fe/d7/59/8fd9b9a68a03094b6ad4328eb262396b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/fe/d7/59/8fd9b9a6