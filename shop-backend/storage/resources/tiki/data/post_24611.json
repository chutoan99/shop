ó giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/a0/de/12/6756c902b0ddb4d9487ad92b35dec8ef.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a0/de/12/6756c902b0ddb4d9487ad92b35dec8ef.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a0/de/12/6756c902b0ddb4d9487ad92b35dec8ef.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a0/de/12/6756c902b0ddb4d9487ad92b35dec8ef.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a0/de/12/6756c902b0ddb4d9487ad92b35dec8ef.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/ff/30/cd/1a5dec4c51db87f906cc70f45425e00b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ff/30/cd/1a5dec4c51db87f906cc70f45425e00b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ff/30/cd/1a5dec4c51db87f906cc70f45425e00b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ff/30/cd/1a5dec4c51db87f906cc70f45425e00b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ff/30/cd/1a5dec4c51db87f906cc70f45425e00b.jpg"}],"warranty_policy":null,"brand":{"id":199937,"name":"Thorakao","slug":"thorakao"},"current_seller":{"id":165433,"sku":"5845465775287","name":"Nhà Thuốc Ngân Châu","link":"https://tiki.vn/cua-hang/nha-thuoc-ngan-chau","logo":"c5/56/ca/22932dfca6e9e7e1c14db95a20d523be.jpg","price":36000,"product_id":"103354903","store_id":152427,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[{"id":166233,"name":"Thảo Mộc An Nhiên","link":"https://tiki.vn/cua-hang/thao-moc-an-nhien","logo":"fe/fc/81/401ff4667e9dfa4f5b37a954b762091f.jpg","price":36000,"product_id":"77775449","store_id":153225}],"specifications":[{"name":"Content","attributes":[{"code":"brand","name":"Thương hiệu","value":"Thorakao"},{"code":"brand_country","name":"Xuất xứ thương hiệ