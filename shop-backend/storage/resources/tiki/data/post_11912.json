ting_average":4.2,"review_count":57,"review_text":"(57)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/3a/5e/ce/235f5992f2f47456bb33d2d8681da113.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":103,"all_time_quantity_sold":1161,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<h5>Thiết kế hiện đại, sang trọng</h5>\n<p><strong>Máy Nghe Nhạc MP3 Ruizu X02</strong> sở hữu thiết kế sang trọng tinh tế với mặt kính gương chống lóa, sáng bóng chịu lực tốt. Ngoài ra, Ruizu X02 với kích thước nhỏ gọn, kiểu dáng đơn giản giúp bạn dễ dàng thao tác phù hợp với nhiều đối tượng người dùng khác nhau.</p>\n<p><img src=\"https://vcdn.tikicdn.com/ts/tmp/94/ce/47/ae6ccc65c2f2f9c992612c2e4110b080.jpg\" alt=\"\" width=\"750\" height=\"768\" /></p>\n<h5>Âm thanh chất lượng cao</h5>\n<p>Ruizu X02 được trang bị công nghệ hiện đại cho phép bạn thưởng thức kho âm nhạc với âm thanh chất lượng cao phù hợp với định dạng âm thanh: APE, MP3, WAV, WMA. Ngoài ra, sản phẩm có tính năng hiển thị lời bài đối với những sản phẩm âm nhạc bản quyền giúp bạn có thể ngân nga theo những giai điệu yêu thích.</p>\n<p><img src=\"https://vcdn.tikicdn.com/ts/tmp/ab/11/cf/0cc0ba1910b109308ce671850f7e13c7.jpg\" alt=\"\" width=\"750\" height=\"415\" /></p>\n<h5>Chức năng tiện ích </h5>\n<p>Sản phẩm hỗ trợ dò sóng tự động và phát Radio cũng như có thể xem video, ảnh chụp với độ phân giải tối đa 128 x 160 px nâng cao chất lượng giải trí của bạn. Bên cạnh đó tính năng hỗ trợ học ngoại ngữ như đọc file .txt, ebook,.. giúp người dùng bận rộn có thể tranh thủ những thời gian giải lao, đợi xe bus, trên tàu điện ngầm để cải thiện năng lực ngoại ngữ.</p>\n<p><img src=\"https://vcdn.tikicdn.com/ts/tmp/39/27/05/c4a47b13c37cd3d53bf7bb92b26a67e0.jpg\" alt=\"\" width=\"750\" height=\"640\" /></p>\n<h5>Hỗ trợ thẻ nhớ 64GB, dung lượng pin ấn tượng</h5>\n<p>Hỗ trợ thẻ nhớ dung lượng lên đến 64GB kết hợp dung lượng pin bền bỉ mang đến thời gian sử dụng liên tục trong 80 giờ giúp người dùng có những trải nghiệm âm nhạc tuyệt vời không gián đoạn.</p>\n<p> </p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/3a/5e/ce/235f5992f2f47456bb33d2d8681da113.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/3a/5e/ce/235f5992f2f47456bb33d2d8681da113.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/3a/5e/ce/235f5992f2f47456bb33d2d8681da113.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3a/5e/ce/235f5992f2f47456bb33d2d8681da113.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3a/5e/ce/235f5992f2f47456bb33d2d8681da113.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/6e/af/8f/99f05afb19ce21e1db55f2c1c98b8c38.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/6e/af/8f/99f05afb19ce21e1db55f2c1c98b8c38.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/6e/af/8f/99f05afb19ce21e1db55f2c1c98b8c38.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6e/af/8f/99f05afb19ce21e1db55f2c1c98b8c38.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6e/af/8f/99f05afb19ce21e1db55f2c1c98b8c38.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/1c/2f/0a/1106bddb11172e07db01b5e2c892645b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w120