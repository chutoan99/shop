dn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/9e/6a/ed/ae2dcb4cf99d0a05f7ed429249c85458.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":812,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eKem chống nắng dưỡng sáng da, giúp làm đều màu \u0026amp; ngăn ngừa nám da, đốm nâu URIAGE DEPIDERM SPF50+ SOIN DE JOUR ANTI-TACHES giúp bảo vệ da trước tác động gây nám của tia UV, tác nhân gây bệnh tăng sắc tố kể cả vùng da đang được điều trị da liễu (tia laser, tẩy tế bào chết bề mặ). Công thức bao gồm nước khoáng Uriage giúp làm ẩm và củng cố màng bảo vệ da cho làn da sạch, mịn, không bết dính.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eTăng 45% độ đều màu da, sạm da giảm 31%, kích thước tàn nhang giảm 27% *.\u003c/p\u003e\n\u003cp\u003e(* Nghiên cứu lâm sàng trên 30 đối tượng dưới sự kiểm soát da liễu. Sử dụng hàng ngày trong 56 ngày. Thang đo dựa trên sự tự đánh giá.)\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eLoại sản phẩm\u003c/p\u003e\n\u003cp\u003e- Kem chống nắng, làm đều màu da, dưỡng sáng da\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eLoại da phù hợp\u003c/p\u003e\n\u003cp\u003e- Phù hợp cho mọi loại da, nhất là da đang gặp vấn đề về sắc tố như nám, đốm nâu, tăng sắc tố sau viêm, thâm mụn, dùng được trên các khu vực da đang được điều trị (laser, peeling,…).\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eĐộ an toàn\u003c/p\u003e\n\u003cp\u003e- Không hương liệu - Không gây nhân mụn - Đã qua kiểm định da liễu.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eCông dụng\u003c/p\u003e\n\u003cp\u003e- Làm dịu da và hạn chế nám da, tàn nhang: Với công thức bao gồm các hợp chất chống hình thành tàn nhang, làm dịu và hoạt chất chống oxy hóa làm giảm sắc số melanine và làm đều màu da.\u003c/p\u003e\n\u003cp\u003e- Hiệu quả bảo vệ da cao UVA-UVB SPF50+: Màng bảo vệ da từ sản phẩm giúp bảo vệ da khỏi tia UV và các gốc tự do giúp chống hình thành nám da, tàn nhang.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eThành phần\u003c/p\u003e\n\u003cp\u003eCx complex 20%: giảm sản sinh melanin, làm sáng da:\u003c/p\u003e\n\u003cp\u003ePea extract + Sucrose: giảm sự phát triển melanosome và ức chế hoạt động của enzyme tyrosinase\u003c/p\u003e\n\u003cp\u003eVitamin C: chống gốc tự do và giảm oxy hóa melanin\u003c/p\u003e\n\u003cp\u003eEnoxolone: giảm viêm, ngăn kích thích tế bào sinh melanin.\u003c/p\u003e\n\u003cp\u003eNước khoáng Uriage: làm dịu và ngăn gốc tự do.\u003c/p\u003e\n\u003cp\u003ePhức hợp màng lọc tia UVA/UVB SPF50 Tinosorb M: Giảm đốm nâu do tia UV gây ra và ngăn ngừa xuất hiện trở lại.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eHướng dẫn sử dụng\u003c/p\u003e\n\u003cp\u003e- Thoa một lượng vừa đủ lên mặt, vùng cổ và tay và toàn bộ vùng da tiếp xúc trực tiếp với ánh nắng mặt trời trước khi ra nắng 20-30 phút. Thoa lại sau mỗi hai giờ.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eLưu ý an toàn khi sử dụng\u003c/p\u003e\n\u003cp\u003eNgay cả khi làn da được bảo vệ hoàn hảo, hãy tiếp xúc với ánh nắng trực tiếp ở mức tối thiểu nhất.\u003c/p\u003e\n\u003cp\u003eTránh tiếp xúc với mắt.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eBảo quản\u003c/p\u003e\n\u003cp\u003eĐể sản phẩm ở nhiệt độ phòng, nơi khô ráo, thoáng mát.\u003c/p\u003e\n\u003cp\u003eTránh ánh nắng trực tiếp và những nơi gần nguồn nhiệt, ẩm mốc.\u003c/p\u003e\n\u003cp\u003eTránh xa tầm với của trẻ em.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eXuất xứ thương hiệu: Pháp\u003c/p\u003e\n\u003cp\u003eNơi sản xuất: Tây Ban Nha\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eTHÔNG TIN THƯƠNG HIỆU\u003c/p\u003e\n\u003cp\u003eUriage là một trong những hãng Dược mỹ phẩm hàng đầu của Pháp\u003c/p\u003e\n\u003cp\u003eNhững lợi ích độc đáo của nước khoáng Uriage được chắt lọc, bổ sung và kết hợp tuyệt vời với những thành phần sáng chế độc quyền, mang đến các dòng sản phẩm chăm sóc và bảo vệ da hiệu quả, giúp làn da sáng khỏe hơn mỗi ngày. Các sản phẩm Uriage được nghiên cứu và được công nhận hiệu quả điều trị các bệnh lý da liễu, được các chuyên gia Da liễu tin dùng ở nhiều quốc gia trên thế giới.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/9e/6a/ed/ae2dcb4cf99d0a05f7ed429249c85458.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/9e/6a/ed/ae2dcb4cf99d0a05f7ed429249c85458.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/9e/6a/ed/ae2dcb4cf99d0a05f7ed429249c85458.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9e/6a/ed/ae2dcb4cf99d0a05f7ed429249c85458.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9e/6a/ed/ae2dcb4cf99d0a05f7ed429249c85458.png"},{"base_url":"https://salt.tikicdn.com/ts/product/09/64/4b/155309136358f1b4ba9f6be8e22a9b82.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.co