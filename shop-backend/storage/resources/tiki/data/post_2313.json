ement":"pdp_badge","code":"is_hero","type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"freeship_xtra","type":"pdp_icon_badge","index":2,"icon":"https://salt.tikicdn.com/ts/upload/be/67/48/04a82ab8df178e1a13bde38316081865.png","icon_width":91,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":true,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/a8/48/da/cada1c794ce4617b7d3c25e1cbe8ae0c.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":621,"all_time_quantity_sold":4,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003eGiới thiệu\u003c/h3\u003e\n\u003cp\u003eLEGO Ninjago 71782 Rồng Thần Tiến Hóa Của Cole (285 Chi Tiết)\u003c/p\u003e\n\u003cp\u003eTrẻ em từ 7 tuổi trở lên sẽ hào hứng tham gia các trận chiến đầy mê hoặc với bộ đồ chơi LEGO NINJAGO Rồng Thần Tiến Hóa Của Cole (71782). Trong suốt trận chiến, người chơi có thể tiến hoá rồng thần để nó lớn và mạnh mẽ hơn bằng cách thêm đôi cánh vàng, sừng và đuôi.\u003cbr /\u003eĐồ chơi ninja tuyệt vời cho trẻ em\u003cbr /\u003eBộ đồ chơi bao gồm 2 nhân vật chiến binh: Cole được trang bị một thanh katana vàng, và Bone Scorpio với một bộ sưu tập weapon và một chiến binh xương. Bone Scorpio cũng có thể cưỡi vào trận chiến trên sinh vật bọ cạp 6 chân của mình. Người chơi sẽ được thưởng một lá cờ sưu tầm “Sức Mạnh” để hoàn thành thử thách của mình.\u003cbr /\u003eTrải nghiệm kỹ thuật số thú vị dành cho người hâm mộ LEGO\u003cbr /\u003eHãy để ứng dụng LEGO Builder hướng dẫn bạn và con bạn trong chuyến phiêu lưu lắp ráp dễ dàng và trực quan. Phóng to và xoay các mô hình ở chế độ 3D, lưu lại và theo dõi tiến trình của bạn.\u003c/p\u003e\n\u003ch3\u003eĐặc điểm nổi bật\u003c/h3\u003e\n\u003cp\u003e• Trẻ em từ 7 tuổi trở lên có thể dàn dựng các trận chiến kịch tính với bộ đồ chơi LEGO NINJAGO Rồng Thần Tiến Hóa Của Cole (71782) này\u003cbr /\u003e• 2 nhân vật – Bộ đồ chơi bao gồm Cole, được trang bị thanh katana vàng và Bone Scorpio được trang bị lưỡi hái. Ngoài ra còn có sinh vật bọ cạp 6 chân\u003cbr /\u003e• Mô hình có thể tiến hoá – Rồng thần có thân, đầu và chân có thể điều chỉnh được, và người chơi có thể nâng cấp nó thành một mô hình lớn và mạnh mẽ hơn bằng cách thêm cánh, sừng và đuôi bằng vàng\u003cbr /\u003e• Sưu tầm lá cờ – Khi trẻ em vượt qua thử thách thành công và giành chiến thắng trong trận chiến, chúng sẽ được thưởng một lá cờ “Sức Mạnh” gắn vào con rồng\u003cbr /\u003e• Nhiều pha hành động của ninja hơn – Hãy cùng khám phá bộ Chiến Giáp Tiến Hóa Của Lloyd (71781), Chiến Xe Tiến Hóa Của Kai (71783), Phi Cơ Sấm Sét Tiến Hóa Của Jay (71784) và các bộ khác trong dòng sản phẩm LEGO NINJAGO\u003cbr /\u003e• Bộ đồ chơi gồm 285 mảnh ghép này dành cho trẻ em từ 7 tuổi trở lên cho phép trẻ vừa nhập vai trong khi lắp ráp và đó cũng là món quà lý tưởng có thể tặng cho trẻ nhân dịp sinh nhật hay ngày lễ\u003cbr /\u003e• Cao hơn 5,5 inch (14 cm), con rồng NINJAGO này bé có thể chơi ở nhà hoặc mang theo khi đi du lịch\u003cbr /\u003e• Một ý tưởng mới – Ứng dụng LEGO Builder hướng dẫn con bạn tham gia vào cuộc phiêu lưu lắp ráp trực quan. Chúng có thể lưu lại, theo dõi tiến trình và phóng to cũng như xoay các mô hình ở chế độ 3D trong khi lắp ráp\u003cbr /\u003e• Chất lượng được đảm bảo – Trong hơn 6 thập kỷ qua, các mảnh ghép LEGO đã được tạo ra để đảm bảo chúng có thể lắp ráp dễ dàng mọi lúc\u003cbr /\u003e• Luôn đảm bảo độ an toàn – Mảnh ghép LEGO đáp ứng các tiêu chuẩn an toàn toàn cầu nghiêm ngặt\u003c/p\u003e\n\u003cdiv class=\"ewa-rteLine\"\u003e\n\u003ch3\u003eĐối tượng sử dụng\u003c/h3\u003e\n\u003cp\u003eDành cho bé từ 7 tuổi trở lên\u003c/p\u003e\n\u003ch3\u003eCảnh báo\u003c/h3\u003e\n\u003cul\u003e\u003cli\u003eCó chi tiết nhỏ, không dùng cho trẻ dưới 3 tuổi\u003c/li\u003e\u003cli\u003eTránh cho sản phẩm tiếp xúc trực tiếp với lửa.\u003c/li\u003e\u003c/ul\u003e\n\u003ch3\u003eHướng dẫn bảo quản\u003c/h3\u003e\n\u003cp\u003eBảo quản nơi khô ráo thoáng mát, tránh ánh nắng trực tiếp\u003c/p\u003e\n\u003ch3\u003eThông số kỹ thuật\u003c/h3\u003e\n\u003c/div\u003e\n\u003cul\u003e\u003cli class=\"ewa-rteLine\"\u003eChất liệu nhựa an toàn không gây hại cho sức khỏe của bé khi sử dụng.\u003c/li\u003e\u003cli class=\"ewa-rteLine\"\u003eĐộ tuổi phù hợp: 7\u0026#43;.\u003c/li\u003e\u003cli class=\"ewa-rteLine\"\u003eBộ gồm: 285 chi tiết.\u003c/li\u003e\u003cli class=\"ewa-rteLine\"\u003eXuất xứ: Trung Quốc.\u003c/li\u003e\u003cli class=\"ewa-rteLine\"\u003eKhối lượng: 391gr\u003c/li\u003e\u003cli class=\"ewa-rteLine\"\u003eKích thước hộp: 26 x 19 x 6 cm\u003c/li\u003e\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/a8/48/da/cada1c794ce4617b7d3c25e1cbe8ae0c.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a8/48/da/cada1c794ce4617b7d3c25e1cbe8ae0c.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a8/48/da/cada1c794ce4617b7d3c25e1cbe8ae0c.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a8/48/da/cada1c794ce4617b7d3c25e1cbe8ae0c.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a8/48/da/cada1c794ce4617b7d3c25e1cbe8ae0c.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/0d/ac/83/6c52c1ab3fd455f362117591107830c4.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0d/ac/83/6c52c1ab3fd455f362117591107830c4.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/0d/ac/83/6c52c1ab3fd455f362117591107830c4.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0d/ac/83/6c52c1ab3fd455f362117591107830c4.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0d/ac/83/6c52c1ab3fd455f362117591107830c4.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/0f/f0/98/ea2136033ec97f5dece3a279f023c42b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0f/f0/98/ea2136033ec97f5dece3a279f023c42b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/0f/f0/98/ea2136033ec97f5dece3a279f023c42b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0f/f0/98/ea2136033ec97f5dece3a279f023c42b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0f/f0/98/ea2136033ec97f5dece3a279f023c42b.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/73/3c/1a/3a4b4d12b89629cc93c732698af6ff16.jpg","is_gallery"