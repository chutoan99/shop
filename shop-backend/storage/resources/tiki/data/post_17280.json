13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/d3/c6/b3/31d0537cb19bf935bcadc5afe15255af.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":880,"all_time_quantity_sold":12,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003e\u003cstrong\u003eĐặc điểm nổi bật\u003c/strong\u003e\u003c/h3\u003e\n\u003cul\u003e\u003cli\u003eCông suất 400W nấu cơm chín nhanh chóng\u003c/li\u003e\n\u003cli\u003eDung tích 1 lít phù hợp với nhiều hộ gia đình\u003c/li\u003e\n\u003cli\u003eRuột nồi làm từ hợp kim nhôm, truyền nhiệt nhanh\u003c/li\u003e\n\u003cli\u003eRuột nồi phủ 2 lớp chống dính, hạn chế cơm bám vào lòng nồi\u003c/li\u003e\n\u003cli\u003eThiết kế nhỏ gọn, không chiếm nhiều diện tích\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/22/71/98/cd10f92e0c01bd19af7e1ccc15438cfe.png\" alt=\"\" width=\"1200\" height=\"1200\"\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cbr\u003e\u003cbr\u003e\u003cstrong\u003eThiết kế trang nhã, đẹp mắt  tiện lợi\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003e GRC5020 có thiết kế màu vàng với điểm nhấn là nút gạt và nút bấm mở giống hình chú vịt dễ thương, bắt mắt mang đến cho không gian nhà bếp thêm thu hút hơn, phù hợp với giới trẻ. Chất liệu vỏ nồi bằng nhựa PP cao cấp, bền bỉ và dễ dàng lau chùi khi bám bẩn.\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eDung tích 1lit, nhỏ nhắn, tiện dụng\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eNồi cơm điện Goldsun GRC5020 có mâm nhiệt lớn kết hợp với công suất đun 400W giúp cho nồi nấu nhanh, chỉ trong ít phút là cơm đã chín, tiết kiệm thời gian và điện năng cho người sử dụng. Nồi dung tích 1L phù hợp để nấu cho khoảng 2-4 người ăn thoải mái. Ngoài ra, bạn có thể tận dụng nồi để nấu và chế biến các món khác như là nấu mì, nấu canh, nấu cháo, hầm xươ tiện lợi. \u003cbr\u003e \u003c/p\u003e\n\u003cdiv\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/47/c1/53/6fa2ea8ffe2ba15bd0148fa7ec509b22.jpg\" alt=\"Nồi cơm điện Goldsun GRC5020\"\u003e\u003c/div\u003e\n\u003ch3\u003e \u003c/h3\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/f4/4b/5b/24bd9bbe9addc317628bfae4a67e0f33.png\" alt=\"\" width=\"1200\" height=\"1200\"\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eLòng nồi phủ chống dính dễ vệ sinh\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eLòng nồi cơm điện Goldsun GRC5020 được làm từ hợp kim nhôm, dày đặn và bền, truyền nhiệt tốt, giữ nhiệt lâu giúp nồi nấu nhanh, ít hao điện khi nấu. Đặc biệt, nồi phủ chống dính 2 mặt cao cấp Whitford (Mỹ), an toàn cho sức khỏe, giúp cơm không bám dính và cháy khét, việc vệ sinh nồi cũng trở nên dễ dàng hơn. \u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eTận dụng tối đa hơi nước để làm chín cơm\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eSản phẩm tận dụng tối đa hơi nước để làm chín mềm cơm nên không có giá tích nước đi kèm như nhiều loại  khác. Bạn không cần mất công đổ giá tích nước, vệ sinh giá sau khi nấu cơm hay lo sợ nước rỉ ra thân nồi khi giá nước bị đầy\u003c/p\u003e\n\u003cdiv\u003e\u003cbr\u003e \u003c/div\u003e\n\u003ch3\u003e\u003cstrong\u003eMâm nhiệt diện tích lớn nấu nhanh hơn\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eNồi cơm điện Goldsun GRC5020 có mâm nhiệt với diện tích lớn và phẳng, tiếp xúc 100% với đáy nồi, giúp nhiệt lan tỏa đều hơn cho hạt cơm chín đều, thơm ngon hơn và thời gian nấu cơm sẽ rút ngắn, tiết kiệm khá nhiều chi phí điện năng tiêu thụ.\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eSử dụng đơn giản chỉ với 1 thao tác\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003e Goldsun GRC5020 được sử dụng đơn giản và dễ dàng chỉ với 1 thao tác gạt nấu, khi cơm chín sẽ tự động chuyển sang chế độ hâm nóng.\u003cbr\u003e\u003cbr\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/be/01/71/60728edde03481e950ba47716c9968f9.png\" alt=\"\" width=\"1200\" height=\"1200\"\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eChế độ bảo hành tốt \u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eSản phẩm được bảo hành chính hãng trong vòng 12 tháng với 63 trung tâm bảo hành trên toàn quốc, bạn hoàn toàn an tâm về chất lượng sản phẩm.\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eMẹo sử dụng nồi cơm điện bền tốt\u003c/strong\u003e\u003c/h3\u003e\n\u003cul\u003e\u003cli\u003eĐặt nồi thăng bằng trên mặt bàn, kệ, không để vật dễ cháy xung quanh.\u003c/li\u003e\n\u003cli\u003eSử dụng với nguồn điện áp ổn định để kéo dài tuổi thọ nồi.\u003c/li\u003e\n\u003cli\u003eVệ sinh lòng nồi sau khi sử dụng để hạn chế ám mùi.\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e \u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eGOLDSUN VIỆT NAM - SẢN PHẨM TIỆN ÍCH, CUỘC SỐNG TIỆN NGHI\u003c/strong\u003e\u003c/h3\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/d3/c6/b3/31d0537cb19bf935bcadc5afe15255af.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d3/c6/b3/31d0537cb19bf935bcadc5afe15255af.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/p