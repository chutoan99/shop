g","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":7000,"discount_rate":11,"rating_average":4.6,"review_count":408,"review_text":"(408)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/aa/34/83/0d147a04ce34e451fe1f6b312d40d3e4.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1589,"all_time_quantity_sold":1876,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p style=\"text-align: center;\"><span style=\"color: #ffffff; font-family: Verdana; font-size: 20px; font-weight: bold; text-align: center; white-space: pre-wrap; background-color: #d48a0d;\">Cặp gối nằm gòn/gối hơi cao cấp - Thương hiệu A</span></p>\n<p><img style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/ff/e2/65/6325ac32269f0ea15111d9bbd41001c2.png\" alt=\"\" width=\"750\" height=\"600\" /></p>\n<p><img style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/d8/15/97/a64cd608d8f38c17042c5df6d81ca796.png\" alt=\"\" width=\"750\" height=\"496\" /></p>\n<p><img style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/ef/4e/6d/473d54bdd290c321ea2e7441c0f6e0df.png\" alt=\"\" width=\"750\" height=\"241\" /></p>\n<p><img style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/59/cf/d8/088da49a21781be0c37c70abbade589c.png\" alt=\"\" width=\"693\" height=\"652\" /></p>\n<p> </p>\n<p> </p>\n<p style=\"text-align: center;\"><img src=\"https://salt.tikicdn.com/ts/tmp/2c/e5/d2/15bf16d5b933fcd33a8c2ef6bd905d08.png\" alt=\"\" width=\"750\" height=\"361\" /></p>\n<p>Biết đến như là sợi tự nhiên nhẹ nhất trên thế giới, bông gòn được nhiều tín đồ yêu thích bởi sự thoải mái và dễ chịu. Những chiếc gối gòn 100% tự nhiên không giữ nhiệt, cho phép không khí đi qua, bao quanh giữ cho đầu, cổ và vai gáy đem lại cảm giác cực kì dễ chịu, thoáng mát suốt cả đêm.</p>\n<p><img style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/78/8e/71/66ece0bb25815d347c7ddcec669cfce1.png\" alt=\"\" width=\"750\" height=\"420\" /></p>\n<p>Những sợi bông gòn có chất xơ nguyên chất tự nhiên giúp kháng khuẩn, khử mùi nhờ tính chất đàn hồi và hút ẩm. Hơn thế nữa, bông gòn rất thân thiện với làn da chính vì thế mà bạn sẽ không lo các trường hợp xảy ra dị ứng từ những nguyên liệu thiên nhiên, an toàn với sức khỏe của người dùng.</p>\n<p>Ngoài ra, <strong>gối gòn </strong>sẽ không làm căng các đốt sống cổ, hỗ trợ bền vững cho đầu, cổ và vai gáy, giữ cho bạn có một giấc ngủ êm ái, bồng bềnh suốt cả đêm.</p>\n<p><img style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/1c/65/6b/d8abf03f6466eb9a8b92d3ad625d182a.png\" alt=\"\" width=\"750\" height=\"390\" /></p>\n<h3><strong>Những ưu điểm của gối gòn của chúng tôi:</strong></h3>\n<ul>\n<li>Chất liệu vải nhanh khô</li>\n<li>Thoáng mát, hút ẩm tốt, hỗ trợ đầu cổ và vai gáy.</li>\n<li>Không làm căng đốt sống cổ trong khi bạn ngủ.</li>\n<li>Thích nghi tốt trong tất cả môi trường thời tiết.</li>\n<li>Thoải mái khi xoay trở, thông thoáng vùng tiếp xúc chúng cho phép không khí đi qua, bao quanh và giữ cho đầu của bạn mát mẻ vào ban đêm</li>\n</ul>\n<h2><strong><img style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/94/95/39/da7ae7cd30507798caaaf98c0b2d305e.png\" alt=\"\" width=\"750\" height=\"252\" /></strong></h2>\n<p style=\"text-align: center;\"><strong><iframe src=\"//www.youtube.com/embed/7VqrIijuEPQ\" width=\"560\" height=\"314\" allowfullscreen=\"allowfullscreen\" data-mce-fragment=\"1\"></iframe></strong></p>\n<h2><strong>Hướng dẫn sử dụng gối nằm/gối gòn:</strong></h2>\n<p>• Giặt với nước ấm nhỏ hơn 40 độ C<br /><br />• Giặt máy ở chế độ nhẹ, sau khi giặt phơi khô ngay, không để ẩm ướt quá lâu.<br /><br />• Không sử dụng bột giặt hoặc chất tẩy mạnh<br /><br />• Không sử dụng gối khi chưa khô hoàn toàn<br /><br />• Không phơi trực tiếp ngoài nắng mà phơi trong bóng râm. Chỉ thỉnh thoảng đem phơi nắng để bay hết hơi ẩm.<br /><br />• Nếu lâu ngày không sử dụng, nên bọc trong túi sau đó cất giữ cẩn thận ở nơi khô thoáng.<br /><br />• Nên vệ sinh gối thường xuyên, đối với phần ruột gối, không nên để tình trạng ẩm ướt trong thời gian dài.</p>\n<p style=\"text-align: center;\"><span style=\"color: #ffffff; font-family: Verdana; font-size: 20px; font-weight: bold; text-align: center; white-space: pre-wrap; background-color: #d48a0d;\">CHÚC ANH CHỊ THÀNH ĐẠT VÀ SỨC KHỎE!!!</span></p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/aa/34/83/0d147a04ce34e451fe1f6b312d40d3e4.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/aa/34/83/0d147a04ce34e451fe1f6b312d40d3e4.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/aa/34/83/0d147a04ce34e451fe1f6b312d40d3e4.jpg","position":null