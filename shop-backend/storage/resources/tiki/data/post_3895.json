,"icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":2200,"discount_rate":5,"rating_average":5,"review_count":5,"review_text":"(5)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/4e/59/b7/12c8a0533c354000babd4b62ff756320.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1791,"all_time_quantity_sold":40,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch1 class=\"product-title\"\u003e\u003cspan style=\"color:#3366ff;\"\u003eSách: Toán Nâng Cao Và Bồi Dưỡng Học Sinh Giỏi Lớp 5\u003c/span\u003e\u003c/h1\u003e\n\u003cp\u003e\u003cspan class=\"sku\"\u003eMã sản phẩm: 8936067609066\u003c/span\u003e\u003c/p\u003e\n\u003cdiv class=\"author_product\"\u003eTác giả : \u003ca href=\"https://minhlongbook.vn/collections/tat-ca-san-pham/tacgia-nguyen-bao-minh-le-yen-ngoc\"\u003eNguyễn Bảo Minh - Lê Yến Ngọc\u003c/a\u003e\u003c/div\u003e\n\u003cdiv class=\"NXB_product\"\u003eNXB: NXB Đại học quốc gia Hà Nội\u003c/div\u003e\n\u003cdiv class=\"size_product\"\u003eKích thước : 19x26.5 cm\u003c/div\u003e\n\u003cdiv class=\"year_product\"\u003eNăm xuất bản : 2023\u003c/div\u003e\n\u003cdiv class=\"numbe_of_pages\"\u003eSố trang : 144\u003c/div\u003e\n\u003cdiv class=\"numbe_of_pages\"\u003eKhối lượng : 300 grams\u003c/div\u003e\n\u003cdiv class=\"book_cover\"\u003eBìa : bìa mềm\u003c/div\u003e\n\u003cp\u003eNội dung cuốn sách được biên soạn theo chương trình giảm tải của Bộ GD \u0026amp; ĐT, bám sát chương trình. Cuốn sách hội tụ đầy đủ hệ thống bài tập nâng cao môn Toán. Các bậc phụ huynh và giáo viên có thể tham khảo, sử dụng tài liệu này đẻ hướng dẫn con em mình học tập tốt môn Toán hơn. Với các em học sinh, cuốn sách như một công cụ tự học, tự bồi dưỡng để nâng cao kĩ năng thực hành Toán.\u003c/p\u003e\n\u003cp\u003eNhằm giúp học sinh tiểu học có thể tự rèn luyện và nâng cao kiến thức môn Toán, chúng tôi đã biên soạn bộ sách “Toán nâng cao và bồi dưỡng học sinh giỏi – Nâng cao kiến thức ngoài chương trình trên lớp” dành cho học sinh từ lớp 1 đến lớp 5.\u003c/p\u003e\n\u003cp\u003eVới nhiều bài tập cơ bản và nâng cao kèm theo hướng dẫn giải chi tiết, bộ sách sẽ  giúp học sinh tự ôn lí thuyết, đồng thời rèn luyện, nâng cao khả năng phân tích đề bài và sáng tạo trong giải Toán.\u003c/p\u003e\n\u003cp\u003eChúng tôi mong rằng bộ sách sẽ là công cụ hữu ích cùng các em tiếp cận sâu hơn kiến thức Toán trong nhà trường cũng như khám phá ra nhiều điều lí thú của môn Toán.\u003c/p\u003e\n\u003cp\u003eChúc các em thành công!\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/4e/59/b7/12c8a0533c354000babd4b62ff756320.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/4e/59/b7/12c8a0533c354000babd4b62ff756320.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/4e/59/b7/12c8a0533c354000babd4b62ff756320.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4e/59/b7/12c8a0533c354000babd4b62ff756320.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4e/59/b7/12c8a0533c354000babd4b62ff756320.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/58/cb/a3/0b85b6f6443be0a3ca3f9a846ff09f08.jpg","is_gallery":true,"label":null