ull,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":1000,"discount_rate":4,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/94/49/ef/438e91a1fad144d116c0184dc2ce4092.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":917,"all_time_quantity_sold":43,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003chtml\u003e\n \u003chead\u003e\u003c/head\u003e\n \u003cbody\u003e\n  \u003cul\u003e\n   \u003cp\u003e Pentel VietNam - Văn phòng phẩm số 1 Nhật Bản- Chất lượng hàng đầu Thế giới\u003c/p\u003e\n   \u003cp\u003e Thông tin sản phẩm\u003c/p\u003e\n   \u003cp\u003eDòng sản phẩm   với công nghệ tiên tiến nhất của Nhật Bản giúp cho cây bút này có được những ưu điểm vượt trội hơn nhiều so với những dòng sản phẩm khác: màu sắc cực kỳ sống động, viết trơn mượt, không bị lem nhòe và đặc biệt, mực khô nhanh chỉ trong 1/3s sau khi viết\u003c/p\u003e\n   \u003cp\u003ẹ  ̣ ̂ ̣ ̉ ̂̉   \u003c/p\u003e\n   \u003cp\u003e️ Bút ký Gel Pentel BL57 sở hữu thiết kế thời trang, sang trọng với đầu bút hợp kim kích cỡ 0.7mm, phù hợp sử dụng để ký và viết\u003c/p\u003e\n   \u003cp\u003e️ Vỏ Bút ký Gel Pentel BL57 được làm từ chất liệu nhựa cao cấp, bền và chắc chắn, cho bạn thời gian sử dụng lâu dài;\u003c/p\u003e\n   \u003cp\u003e️ Với công nghệ Energel của Pentel, giúp cho mực gel của Bút ký Pentel BL57 khô nhanh trong 1/3 s, thiết kế tinh xảo, tỉ mỉ giúp bút không bị tắc hay bị gai ở đầu\u003c/p\u003e\n   \u003cp\u003e️ Màu mực Bút ký Gel Pentel BL57 đậm, đều, không lem, không phai màu\u003c/p\u003e\n   \u003cp\u003e️ Tay cầm Bút ký Gel Pentel BL57 bằng cao su mang lại sự thoải mái ngay cả khi bạn phải viết với thời gian lâu\u003c/p\u003e\n   \u003cp\u003e️ Bút ký Gel Pentel BL57 có thiết kế vừa tay, dễ cầm, dễ viết dù trên mặt phẳng ngang hay thẳng đứng\u003c/p\u003e\n   \u003cp\u003e️ Bút ký Gel Pentel BL57 viết êm với mực gel mau khô, ra mực đều và đẹp giúp bạn không gặp vấn đề như gai, tắc mực và lem ngoài ý muốn\u003c/p\u003e\n   \u003cp\u003e️ Bút ký Gel Pentel BL57 ngòi 0.7mm cho nét chữ rõ ràng, lướt rất êm trên giấy, tiện lợi khi phải viết nhiều. Với miếng lót mềm cách đầu viết khoảng 1cm để tay cầm thêm êm ái và thoải mái hơn\u003c/p\u003e\n   \u003cp\u003e️ Bút ký Gel Pentel BL57 đa dạng màu sắc cho bạn lựa chọn\u003c/p\u003e\n   \u003cp\u003e Cam kết chính hãng và quà tặng đi kèm\u003c/p\u003e\n   \u003cp\u003e Sản phẩm được nhập khẩu chính hãng từ thương hiệu Pentel Nhật Bản\u003c/p\u003e\n   \u003cp\u003eChúng tôi chỉ bán sản phẩm chất lượng cao và kiểm tra chất lượng trước khi giao hàng\u003c/p\u003e\n   \u003cp\u003e ĐỔI TRẢ MIỄN PHÍ TRONG 7 NGÀY.\u003c/p\u003e\n   \u003cp\u003e Tặng kèm 1 bộ Sticker Kawaii hoặc 1 Giấy thử bút Pentel\u003c/p\u003e\n   \u003cp\u003e Thông tin thương hiệu\u003c/p\u003e\n   \u003cp\u003ePentel là một trong những hãng văn phòng phẩm nổi tiếng nhất thế giới, luôn đi đầu trong việc phát triển các công nghệ hiện đại để sản xuất các sản phẩm bút viết chất lượng nhất:\u003c/p\u003e\n   \u003cp\u003e️ Pentel - nhà sản xuất họa phẩm chất lượng hàng đầu Nhật Bản với đầy đủ các dòng sản phẩm chuyên nghiệp.\u003c/p\u003e\n   \u003cp\u003e️ Pentel - nhà phát minh bút chì kim bấm đầu tiên trên thế giới =\u0026gt; Luôn dẫn đầu về chất lượng và kỹ thuật chính xác đến từng milimet.\u003c/p\u003e\n   \u003cp\u003e️ Pentel - nhà phát minh ruột chì kim Hipolymer siêu chắc, siêu mượt chất lượng số 1 thế giới!\u003c/p\u003e\n   \u003cp\u003e️ Pentel - nhà phát minh ra bút xoá đầu tiên trên thế giới.\u003c/p\u003e\n   \u003cp\u003e️ Pentel Energel - cây bút gắn liền với tên tuổi của Pentel tại thị trường Việt Nam. Ưu điểm nổi bật của dòng sản phẩm Energel là siêu mượt, mực ra đều, siêu nhanh khô trong 1/3 giây không bị lem nhòe, phù hợp với cả người viết tay trái. Đây cũng là đặc điểm nổi bật của công nghệ mực độc quyền Energel Inside.\u003c/p\u003e\n   \u003cp\u003eNgoài ra, Pentel là công ty sản xuất công cụ viết duy nhất nhận được giải thưởng Deming - giải thưởng danh giá giành cho những công ty có thành tích cao nhất trong việc quản lý chất lượng:\u003c/p\u003e\n   \u003cp\u003e️ Công nghệ hiện đại: các sản phẩm Pentel tinh tế trong thiết kế, chất lượng khác biệt, sử dụng công nghệ cao để mang lại những thành phẩm hoàn hảo\u003c/p\u003e\n   \u003cp\u003e️ Cây bút biết nói: Từng sản phẩm là những cây bút biết nói đúng như cái tên Pentel (Pen trong từ bút và Tel trong từ tell), đó là những giá trị vượt trội mà Pentel gửi gắm trong từng sản phẩm\u003c/p\u003e\n   \u003cp\u003e️ Bảo vệ môi trường: Cam kết phát triển và cung cấp các sản phẩm thân thiện với môi trường hàng đầu thế giới, an toàn cho sức khỏe người tiêu dùng\u003c/p\u003e\n   \u003cp\u003e Quy cách\u003c/p\u003e\n   \u003cp\u003eBút ký Pentel BL57 ngòi 0.7mm, ruột ngòi thay thế LR7\u003c/p\u003e\n   \u003cp\u003eBL57-A - mực đen\u003c/p\u003e\n   \u003cp\u003eBL57-B - mực đỏ\u003c/p\u003e\n   \u003cp\u003eBL57-C - mực xanh\u003c/p\u003e\n   \u003cp\u003eBL57-V - mực tím\u003c/p\u003e\n   \u003cp\u003e---------------------------------------------------------------\u003c/p\u003e\n   \u003cp\u003ePentel Vietnam - Văn phòng phẩm số 1 Nhật Bản\u003c/p\u003e\n  \u003c/ul\u003e\n \u003c/body\u003e\n\u003c/html\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e\u003cp\u003eSản phẩm này là tài sản cá nhân được bán bởi Nhà Bán Hàng Cá Nhân và không thuộc đối tượng phải chịu thuế GTGT. Do đó hoá đơn VAT không được cung cấp trong trường hợp này.\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/94/49/ef/438e91a1fad144d116c0184dc2ce4092.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/94/49/ef/438e91a1fad144d116c0184dc2ce4092.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/94/49/ef/438e91a1fad144d116c0184dc2ce4092.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/94/49/ef/438e91a1fad144d116c0184dc2ce4092.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/94/49/ef/438e91a1fad144d116c0184dc2ce4092.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/11/66/c9/60e21bf4f5391a26a6aff62314909b7d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/11/66/c9/60e21bf4f5391a26a6aff62314909b7d.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/11/66/c9/60e21bf4f5391a26a6aff62314909b7d.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/11/66/c9/60e21bf4f5391a26a6aff62314909b7d.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/11/66/c9/60e21bf4f5391a26a6aff62314909b7d.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/1e/4a/7f/d4f579776650a997938ad02c92393a4f.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/1e/4a/7f/d4f579776650a997938ad02c92393a4f.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/1e/4a/7f/d4f579776650a997938ad02c92393a4f.jpg","position":null,"small_url":"https://salt.tikic