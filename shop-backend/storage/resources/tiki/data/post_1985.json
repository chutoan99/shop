"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.8,"review_count":6,"review_text":"(6)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/fb/0f/52/151f313feb323219582150633da59fa5.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":323,"all_time_quantity_sold":130,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eRất ít người trong chúng ta nhận ra rằng ngôn ngữ (phong cách giao tiếp) của mình ở nơi làm việc cản trở khả năng giải quyết vấn đề một cách sáng tạo và đôi khi làm gia tăng sự bất ổn và căng thẳng giữa các mối quan hệ trong tổ chức.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eBất kể ở ngữ cảnh nào; dù ở trong tình huống áp lực cao hay những tình huống hàng ngày, hay trong mỗi cuộc họp hay thậm chí lúc soạn email, chúng ta đều có cơ hội trao quyền cho đồng nghiệp của mình bằng cách sử dụng những từ ngữ phù hợp.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/ab/b9/6c/7a26926b4ab162c0ba3aab7e2cff75d3.png\" alt=\"\" width=\"750\" height=\"375\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eTrong cuốn Lãnh đạo là ngôn ngữ, Cựu thuyền trưởng Hải quân Hoa Kỳ David Marquet đã mở rộng kiến thức từ cuốn sách lãnh đạo bán chạy nhất của ông “Xoay chuyển con tàu” và chỉ cho các nhà quản lý và lãnh đạo bước tiếp theo trong quá trình phát triển của họ: \u003c/span\u003e\u003cstrong\u003eCách hỗ trợ đội nhóm thông qua giao tiếp.\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eMarquet phác thảo một\u003c/span\u003e\u003cstrong\u003e bộ nguyên tắc và công cụ\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e giúp các nhà lãnh đạo truyền cảm hứng cho nhân viên của mình nhận trách nhiệm và giải quyết các thách thức mà không cần chờ được yêu cầu phải làm gì, đồng thời nêu bật những thay đổi nhỏ trong ngôn ngữ có thể dẫn đến những thay đổi đáng kể về thành công và tinh thần của một tổ chức.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/3a/47/09/8b551f037d113c91afd0b9ec6b4210c9.jpg\" alt=\"\" width=\"750\" height=\"2241\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch3\u003e\u003cspan style=\"color:#0000ff;\"\u003e\u003cstrong\u003eVỀ TÁC GIẢ\u003c/strong\u003e\u003c/span\u003e\u003c/h3\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eTừ tác giả nổi tiếng của cuốn sách Xoay chuyển con tàu, cựu Thuyền trưởng Hải quân Hoa Kỳ David Marquet, đã cho ra mắt một cuốn sách hoàn toàn mới thông qua đó giúp người đọc học được kỹ năng trao quyền cho đội nhóm của mình để đội nhóm có khả năng đưa ra quyết định dứt khoát và rèn luyện được tư duy làm chủ công việc tốt hơn.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch3\u003e\u003cspan style=\"color:#000000;\"\u003e\u003cstrong\u003eAi nên đọc cuốn sách này?\u003c/strong\u003e\u003c/span\u003e\u003c/h3\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eCuốn sách dành cho tất cả những ai đang giữ vị trí lãnh đạo, nhà lãnh đạo tương lai đầy tham vọng hoặc đang nằm trong kế hoạch đào tạo, phát triển khả năng lãnh đạo của tổ chức. \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eNgay cả khi bạn tự coi mình là một nhà lãnh đạo hiệu quả thì vẫn có những bài học bạn có thể học được từ cuốn sách này. \u003c/span\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eCùng điểm qua đánh giá của chuyên gia về cuốn sách\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cspan style=\"font-weight:400;\"\u003e\"Trong cuốn \u003c/span\u003e\u003c/em\u003e\u003cstrong\u003e\u003cem\u003eXoay chuyển con tàu\u003c/em\u003e\u003c/strong\u003e\u003cem\u003e\u003cspan style=\"font-weight:400;\"\u003e, Marquet yêu cầu chúng ta thay đổi cách lãnh đạo. Giờ đây, trong \u003c/span\u003e\u003c/em\u003e\u003cstrong\u003e\u003cem\u003eLãnh đạo là ngôn ngữ\u003c/em\u003e\u003c/strong\u003e\u003cem\u003e\u003cspan style=\"font-weight:400;\"\u003e, ông đề nghị chúng ta thay đổi cách giao tiếp ở cương vị là những nhà lãnh đạo. Đó là loại bỏ ngôn ngữ mang tính chất mệnh lệnh, kiểm soát, thay vào đó sử dụng ngôn ngữ mang tính chất hợp tác, cam kết, sáng tạo, khơi gợi sự tìm tòi, học hỏi\". \u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cul\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eLIZ WISEMAN, tác giả cuốn sách \u003c/span\u003e\u003cem\u003e\u003cspan style=\"font-weight:400;\"\u003eMultipliers\u003c/span\u003e\u003c/em\u003e\u003cspan style=\"font-weight:400;\"\u003e \u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cspan style=\"font-weight:400;\"\u003e\"Đây là một cuốn sách nổi bật khác của Marquet - và một quan điểm thực sự độc đáo về vai trò của ngôn từ tái thiết lập năng lực lãnh đạo của chúng ta. Neo theo cách mà các đội nhóm thực sự nói chuyện, tác giả chỉ ra cho các nhà lãnh đạo cách loại bỏ ngôn ngữ của Thời đại Công nghiệp và sử dụng một mô thức khác, hệ thống làm việc luân chuyển giữa \"chế độ đỏ\" và \"chế độ xanh\" trong tương lai\". \u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cul\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eVERNE HARNISH, nhà sáng lập của \u003c/span\u003e\u003cem\u003e\u003cspan style=\"font-weight:400;\"\u003eEntrepreneurs’ Organization (EO) \u003c/span\u003e\u003c/em\u003e\u003cspan style=\"font-weight:400;\"\u003evà tác giả cuốn sách \u003c/span\u003e\u003cem\u003e\u003cspan style=\"font-weight:400;\"\u003eScaling Up\u003c/span\u003e\u003c/em\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch3\u003e\u003cspan style=\"color:#0000ff;\"\u003e\u003cstrong\u003eMỤC LỤC\u003c/strong\u003e\u003c/span\u003e\u003c/h3\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eChương 1: Đánh mất El Faro\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eChương 2: Bộ hướng dẫn mới\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eChương 3: Thoát khỏi công việc chế độ đỏ: kiểm soát thời hạn\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eChương 4: Tiến vào công việc chế độ xanh: Sự hợp tác\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eChương 5: Thoát ra khỏi công việc chế độ xanh: Sự cam kết\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eChương 6: Kết thúc của giai đoạn công việc chế độ đỏ: Hoàn thành\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eChương 7: Hoàn thiện chu kỳ: Cải thiện\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eChương 8: Hành động trao quyền: Kết nối\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eChương 9: Áp dụng những nguyên tắc công việc chế độ xanh – công việc chế độ đỏ vào tình huống thực tế\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eChương 10: Hệ thống vận hành xanh-đỏ\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eChương 11: Cứu lấy El Faro\u003c/span\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/fb/0f/52/151f313feb323219582150633da59fa5.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/fb/0f/52/151f313feb323219582150633da59fa5.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/fb/0f/52/151f313feb323219582150633da59fa5.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fb/0f/52/151f313feb323219582150633da59fa5.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fb/0f/52/151f313feb323219582150633da59fa5.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/15/7d/61/392d59edcb0392fce2295f511ff38cba.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/15/7d/61/392d59edcb0392fce2295f511ff38cba.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/15/7d/61/392d59edcb0392fce2295f511ff38cba.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/15/7d/61/392d59edcb0392fce2295f511ff38cba.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/15/7d/61/392d59edcb0392fce2295f511ff38cba.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/18/bc/d0/ffc69f6856eca74838b2f292a060dd4f.jpg","is_gallery":true,"label":null,"large_url":"https://salt.ti