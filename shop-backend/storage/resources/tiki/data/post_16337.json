n_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.5,"review_count":103,"review_text":"(103)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/09/68/fa/3a60c1b002a8807544b582f24a3fa965.jpeg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1945,"all_time_quantity_sold":510,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch1 class=\"product-title product_title entry-title\"\u003eDầu Gội làm sạch Gàu Vảy Nến Orzen Anti Aruff Shampoo 320ML\u003c/h1\u003e\n\u003cdiv class=\"product-short-description\"\u003e\n\u003cp\u003eDầu gội làm sạch gàu Orzen là sản phẩm (Clinic) được chiết xuất 100% từ thảo dược thiên nhiên, không dùng các thành phần hoá học\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eLoại bỏ toàn bộ gàu bám trên da đầu\u003c/li\u003e\n\u003cli\u003eLàm sạch và ngăn cản quá trình hình thành gàu\u003c/li\u003e\n\u003cli\u003eBổ sung dưỡng chất, ngăn ngừa hình thành gàu\u003c/li\u003e\n\u003cli\u003eGiảm stress, lưu thông máu dưới da đầu\u003c/li\u003e\n\u003cli\u003eBổ sung vitamin C chống lão hóa, hạn chế gàu\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eThương hiệu: ORZEN\u003c/p\u003e\n\u003cp\u003eDung tích: 320ML\u003c/p\u003e\n\u003cp\u003eXuất xứ: HÀN QUỐC\u003c/p\u003e\n\u003c/div\u003e\n\u003ch2\u003e\u003cstrong\u003eĐôi Nét Về Bệnh Vẩy Nến Da Đầu\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003e\u003cstrong\u003eBệnh vẩy nến da đầu\u003c/strong\u003e là 1 dạng của bệnh vẩy nến thể thông thường, một bệnh da mạn tính, thường gặp, tiến triển từng đợt, dai dẳng suốt đời. Vảy nến là 1 bệnh da liễu mãn tính và da đầu là một trong các khu vực bị tác động thường xuyên nhất có sự tróc vảy và các mảng vảy nến sưng đỏ, dai dẳng hơn vẩy nến ở những vùng khác trên cơ thể.\u003c/p\u003e\n\u003cfigure id=\"attachment_1242\" class=\"wp-caption aligncenter\" aria-describedby=\"caption-attachment-1242\"\u003e\u003ca href=\"https://daugoichinhhang.vn/orzen\"\u003e\u003cimg class=\"size-full wp-image-1242\" src=\"https://daugoichinhhang.vn/wp-content/uploads/2020/06/da-dau-vay-nen.png\" sizes=\"(max-width: 696px) 100vw, 696px\" srcset=\"https://daugoichinhhang.vn/wp-content/uploads/2020/06/da-dau-vay-nen.png 696w, https://daugoichinhhang.vn/wp-content/uploads/2020/06/da-dau-vay-nen-300x198.png 300w\" alt=\"Da Đầu Bị Vảy Nến\" width=\"696\" height=\"460\" /\u003e\u003c/a\u003e\n\u003cfigcaption id=\"caption-attachment-1242\" class=\"wp-caption-text\"\u003eDa Đầu Bị Vảy Nến\u003c/figcaption\u003e\n\u003c/figure\u003e\n\u003cp\u003e\u003cstrong\u003eBệnh vẩy nến da đầu\u003c/strong\u003e thường ở mức độ nhẹ và hầu như không biểu hiện triệu chứng. Tuy nhiên, bệnh cũng có thể biểu hiện ở mức độ nghiêm trọng, tồn tại trong một thời gian dài và làm mảng bám dày lên hoặc bị vỡ. \u003cstrong\u003eNgứa da đầu\u003c/strong\u003e có thể ảnh hưởng đến giấc ngủ và chất lượng cuộc sống. Gãi da đầu nhiều có thể dẫn đến nhiễm trùng da và rụng tóc.\u003c/p\u003e\n\u003ch2\u003eSử dụng Dầu Gội làm sạch Gàu Vảy Nến Orzen Anti Aruff \u003c/h2\u003e\n\u003cp\u003eLà sản phẩm đặc trị được chiết xuất 100% từ thảo dược thiên nhiên, không dùng các thành phần hoá học (không chất tạo màu, không hương liệu, không phân bón hoá học..), dầu gội làm sạch gàu – vảy nến Orzen sẽ đánh bay hoàn toàn gàu – vảy nến mà không gây bất kỳ tác dụng phụ nào.\u003c/p\u003e\n\u003cp\u003eChiết xuất cây Hermo \u0026amp; chất Climbazole sẽ loại bỏ toàn bộ gầu bám trên da đầu. Cây hoè bổ sung dưỡng chất cho da đầu để ngăn ngừa hình thành gầu, không cho gầu tái xuất hiện trở lại. Chiết xuất chè xanh sẽ bổ sung Vitamin C chống lão hoá, làm cho da đầu \u0026amp; lỗ chân lông sạch sẽ hạn chế gầu, vẩy nến.\u003c/p\u003e\n\u003cfigure id=\"attachment_1243\" class=\"wp-caption aligncenter\" aria-describedby=\"caption-attachment-1243\"\u003e\n\u003cfigcaption id=\"caption-attachment-1243\" class=\"wp-caption-text\"\u003eDầu Gội Trị Gàu Orzen 100% Từ Thiên Nhiên\u003c/figcaption\u003e\n\u003c/figure\u003e\n\u003ch2\u003eCông Dụng Chính\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003eCây Hermo loại bỏ toàn bộ gàu bám trên da đầu\u003c/li\u003e\n\u003cli\u003eHoạt chất Climbazole làm sạch và ngăn cản quá trình hình thành gàu\u003c/li\u003e\n\u003cli\u003eCây Hòe bổ sung dưỡng chất, ngăn ngừa hình thành gàu\u003c/li\u003e\n\u003cli\u003eTinh dầu bạc hà giảm stress, lưu thông máu dưới da đầu\u003c/li\u003e\n\u003cli\u003eChè xanh bổ sung vitamin C chống lão hóa, hạn chế gàu\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch2\u003eKhác biệt của Orzen đặc làm sạch gàu Orzen- Anti Dandruff\u003c/h2\u003e\n\u003ch3\u003eORZEN – Hiệu quả chống nấm của Climbazole\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eĐược phát triển bởi Bayer – hãng sản xuất thuốc đông y toàn cầu\u003c/li\u003e\n\u003cli\u003eTiêu diệt vi khuẩn gầu và cung cấp dưỡng chất cho da đầu nhưng ko làm ảnh hưởng đến vi khuẩn có ích tồn tại trên da đầu\u003cspan class=\"text_exposed_show\"\u003e\u003cbr /\u003e\u003c/span\u003e\u003c/li\u003e\n\u003cli\u003e\u003cspan class=\"text_exposed_show\"\u003eNgăn ngừa gàu quay trở lại lâu hơn Zinc Pyrithione\u003c/span\u003e\u003c/li\u003e\n\u003cli\u003eKhông làm kích ứng da\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch2\u003eCách sử dụng\u003c/h2\u003e\n\u003cp\u003eLắc đều chai sau đó làm ướt tóc, lấy một lượng vừa đủ ra tay rồi thoa đều lên tóc đồng thời massage nhẹ nhàng, để khoảng từ 2 đến 3 phút rồi xả xạch.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/09/68/fa/3a60c1b002a8807544b582f24a3fa965.jpeg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/09/68/fa/3a60c1b002a8807544b582f24a3fa965.jpeg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/09/68/fa/3a60c1b002a8807544b582f24a3fa965.jpeg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/09/68/fa/3a60c1b002a8807544b582f24a3fa965.jpeg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/09/68/fa/3a60c1b002a8807544b582f24a3fa965.jpeg"},{"base_url":"https://salt.tikicdn.com/ts/product/db/55/91/e1930d79c75847ffc7c23ab25b70fdf8.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/db/55/91/e1930d79c75847ffc7c23ab25b70fdf8.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/db/55/91/e1930d79c75847ffc7c23ab25b70fdf8.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/db/55/91/e1930d79c75847ffc7c23ab25b70fdf8.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/db/55/91/e1930d79c75847ffc7c23ab25b70fdf8.jpg"},{"base_url":"https://salt.tikicdn.com/media/catalog/producttmp/e8/6e/16/6982d4c91e18c3603d1ffc1030e93cd1.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/producttmp/e8/6e/16/6982d4c91e18c3603d1ffc1030e93cd1.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/producttmp/e8/6e/16/6982d4c91e18c3