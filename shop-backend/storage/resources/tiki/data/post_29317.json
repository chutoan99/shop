3f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/1b/97/04/286a7f0193f4f4e2faf9bd19fe7ea5d0.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":35,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003carticle class=\"4ever-article\"\u003e\n\u003carticle class=\"4ever-article\"\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cstrong\u003eTận hưởng sự tiện lợi của nguồn nước sạch, trong lành ngay từ vòi của bạn với thiết bị lọc nước Philips AWP3705P1 có màn hình kỹ thuật số (Thể hiện mức nước đã qua sử dụng). Thiết bị cải tiến này đảm bảo  rằng bạn và gia đình được hưởng nguồn nước lọc sử dụng cho sinh hoạt cá nhân và nấu ăn hằng ngày. (Không khuyến khích sử dụng nước uống trực tiếp tại vòi)\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003col\u003e\n\u003cli\u003e\n\u003cdiv\u003e\u003cstrong\u003eTHÔNG TIN CHI TIẾT SẢN PHẨM:\u003c/strong\u003e\u003cbr /\u003e\n\u003cp\u003eVật liệu: Nhựa ABS chịu lực cao cấp\u003c/p\u003e\n\u003cp\u003eKích thước sản phẩm: (17,3 x 13,5 x 8,9 cm)\u003c/p\u003e\n\u003cp\u003eTrọng lượng sản phẩm: 0,45 Kg\u003c/p\u003e\n\u003cp\u003eSản phẩm bao gồm: Thiết bị on-tap, 1 lõi lọc X-Guard, Bộ chuyển đổi đầu vòi\u003c/p\u003e\n\u003cp\u003eLợi ích sản phẩm: Giảm clo và các tạp chất khác, cung cấp nước sinh hoạt cá nhân và nấu ăn hằng ngày\u003c/p\u003e\n\u003cp\u003eChứng nhận chất lượng: Viện Pasteur và Tổ chức Vinacontrol về hệ thống lọc nước và chứng nhận nước uống đáng tin cậy .\u003c/p\u003e\n\u003cp\u003eChính sách bảo hành: 24 tháng (tại các Trung Tâm Bảo Hành PHILIPS trên toàn quốc)\u003c/p\u003e\n\u003cp\u003eThương hiệu: PHILIPS\u003c/p\u003e\n\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/fd/44/02/3f0b3a7f75121d9be1ac6cee051090a9.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv\u003e\u003cstrong\u003eĐẶC ĐIỂM NỔI BẬT:\u003c/strong\u003e\u003c/div\u003e\n\u003c/li\u003e\n\u003c/ol\u003e\n\u003c/article\u003e\n\u003cp\u003e- Dễ dàng lắp đặt: Với Bộ chuyển đổi đầu vòi (Kèm theo) hỗ trợ gắn phù hợp với hầu hết các loại đầu vòi chỉ với 3 Bước thao tác lắp đặt cơ bản.\u003c/p\u003e\n\u003cp\u003e- Công nghệ lọc (Công nghệ X-Guard tiên tiến): Lõi lọc than hoạt tính loại bỏ 99% CLO dư, kim loại hòa tan \u003c/p\u003e\n\u003cp\u003e- Thành phần bộ lọc:  lưới lọc thô, bộ lọc than hoạt tính\u003c/p\u003e\n\u003cp\u003e- Mức nhiệt độ thích hợp: Tương thích nước cấp đầu vào từ | 5°C – 38°C |\u003c/p\u003e\n\u003cp\u003e- Công suất lọc: 2L/ phút. \u003c/p\u003e\n\u003cp\u003e- Máy tích hợp 3 dòng chảy nước phù hợp với mọi nhu cầu sử dụng cho Sinh Hoạt\u003c/p\u003e\n\u003cp\u003e- Bộ hiển thị điện tử \" real time \" cho người dùng biết mức nước đã sử dụng thực tế\u003c/p\u003e\n\u003cp\u003e- Tuổi thọ lọc: 1000L (Tương đương đến 6 tháng sử dụng) \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/55/39/85/9a1d1edb5acbedcd311ea3f3b5006f66.jpg\" width=\"750\" height=\"750\" alt=\"553985b250c9b1e89810081071f42834.jpg\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cstrong\u003eVới thiết kế dễ sử dụng và công nghệ lọc tiên tiến, Philips AWP3705P1/97 là sự bổ sung lý tưởng cho bất kỳ ngôi nhà nào muốn cải thiện chất lượng nước. Tận hưởng sự yên tâm của nước sạch, an toàn. Thiết bị lọc nước máy Philips AWP3705P1/97 không chỉ là một sản phẩm mà còn là sự cam kết đối với sức khỏe và môi trường của bạn.\u003c/strong\u003e\u003c/p\u003e\n\u003c/article\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/1b/97/04/286a7f0193f4f4e2faf9bd19fe7ea5d0.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/1b/97/04/286a7f0193f4f4e2faf9bd19fe7ea5d0.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/1b/97/04/286a7f0193f4f4e2faf9bd19fe7ea5d0.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1b/97/04/286a7f0193f4f4e2faf9bd19fe7ea5d0.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1b/97/04/286a7f0193f4f4e2faf9bd19fe7ea5d0.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/b4/4d/19/4e4c3f93e1d477f4aaa26f983af6921c.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b4/4d/19/4e4c3f93e1d477f4aaa26f983af6921c.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b4/4d/19/4e4c3f93e1d477f4aaa26f983af6921c.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b4/4d/19/4e4c3f93e1d477f4aaa26f983af6921c.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b4/4d/19/4e4c3f93e1d477f4aaa26f983af6921c.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/fd/44/02/2dd29e23ca35bc9a4be9ef34ba2898bb.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/fd/44/02/2dd29e23ca35bc9a4be9ef34ba2898bb.