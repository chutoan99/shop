ext":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":121000,"discount_rate":35,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/80/7d/fb/af358011ca9fffc720a313484e32670f.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":981,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eTông đơ cắt tóc không dây KEMEI KM-809A chuyên nghiệp có màn hình LCD hiển thị pin, cắt được lông cho thú cưng, chó, mèo\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/c3/1b/b8/c28c893178b1a62f1c02c6f75aa3bdb6.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e- Sản phẩm có màn hình LCD hiển thị dung lượng pin lưỡi thép không gỉ, không làm tổn thương da đầu, động cơ mạnh mẽ, thích hợp cho tất cả các loại tóc cắt tỉa.\u003c/p\u003e\n\u003cp\u003eĐược trang bị với 4 cữ dài khác nhau (3mm, 6 mm, 10 mm, 13 mm), bạn có thể dễ dàng kiểm soát các chiều dài bạn muốn để cắt và tạo ra tóc khác nhau phong cách. - Sử dụng được cả dây và không dây sử dụng kép, không còn lo lắng về không có điện, thuận tiện hơn.\u003c/p\u003e\n\u003cp\u003eLưỡi cắt là Titatium. Đây là kim loại vô cùng đặc biệt, không hề độc hại với con người, tuy nhẹ như nhôm nhưng lại có độ bền và khỏe vượt trên thép, chịu lực tốt, chống uốn, chống nén, không gỉ, không bị ăn mòn. Lưỡi dao titanium, sắc, bền, ít mòn, ít nóng khi sử dụng.\u003c/p\u003e\n\u003cp\u003eVới pin lithium 2600mAh cao cấp hỗ trợ sạc nhanh chỉ 4h cho thời gian sử dụng lên đến 140 phút.\u003c/p\u003e\n\u003cp\u003eVới công suất mạnh mẽ và thiết kế thông minh tông đơ kemei 809A vừa có thể sử dụng cắt tóc vừa có thể là dụng cụ hỗ trợ đắc lực trong việc cắt tỉa lông cho thú cưng.\u003c/p\u003e\n\u003cp\u003eTông đơ KM-809A cùng công suất mạnh mẽ 5W mà nó sở hữu, có thể hớt được những vùng lông rậm rạp nhất. Máy còn có thể sử dụng không dây và trực tiếp một cách tiện lợi.\u003c/p\u003e\n\u003cp\u003eBạn có thể dễ dàng tạo kiểu tóc yêu thích với tông đơ kemei KM - 809A với tính năng điều chỉnh lưỡi từ 0.2mm - 3mm kết hợp cùng 4 lược căn độ dài 3,6,9,13mm\u003c/p\u003e\n\u003cp\u003eTHÔNG SỐ KỸ THUẬT :\u003c/p\u003e\n\u003cp\u003e-Thương hiệu KEMEI Model KM-809A\u003c/p\u003e\n\u003cp\u003e-Màu sắc Trắng phối đen Nguồn điện 110 - 240V 50/60Hz\u003c/p\u003e\n\u003cp\u003e-Công suất 5W\u003c/p\u003e\n\u003cp\u003e-Bộ sản phẩm bao gồm : 1x tông đơ, 1x nắp bảo vệ lưỡi cắt, 4x lược căn độ dài, 1x chai dầu máy, 1x chổi vệ sinh máy, 1x khay đựng, 1x hộp đựng.\u003c/p\u003e\n\u003cp\u003e-Kích thước của tông đơ 20x6x5cm\u003c/p\u003e\n\u003cp\u003e-Kích thước của hộp đựng 24x14.5x6.5cm\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/80/7d/fb/af358011ca9fffc720a313484e32670f.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/80/7d/fb/af358011ca9fffc720a313484e32670f.jpg","medium_url":"https://salt.tikicdn.com/cache/w30