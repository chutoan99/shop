},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":77994,"discount_rate":13,"rating_average":4.7,"review_count":28,"review_text":"(28)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/0f/5e/f9/a6be26d11c289024a80a0ddb40253291.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2257,"all_time_quantity_sold":442,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eSữa mẹ là thức ăn tốt nhất cho sức khỏe và sự phát triển toàn diện của trẻ sơ sinh và trẻ nhỏ\u003c/p\u003e\n\u003cp\u003eSữa Bột Namyang Imperial Dream XO 4 GT 800g dành cho trẻ từ 1 đến 3 tuổi có đến 59 thành phần dưỡng chất, với hàm lượng cân đối, phù hợp giúp bé phát triển toàn diện về thể lực và trí não. Sản phẩm sử dụng sữa bột nguyên chất, được làm từ nguồn sữa tươi lấy tại nông trại, không qua khâu lưu kho và sử dụng phương pháp hút chân không đóng gói với khí Nitơ để giữ trọn nguồn dinh dưỡng phong phú và duy trì hương vị của sản phẩm. Đây sẽ là nguồn cung cấp dinh dưỡng dồi dào bên cạnh nguồn sữa mẹ cho trẻ.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eTHÀNH PHẦN DƯỠNG CHẤT NỔI BẬT\u003c/p\u003e\n\u003cp\u003e- Tăng cường hệ miễn dịch gồm các thành phần chính: Lactofferin, Mucin, Lactadherin, Beta-Carotene và Nucleotide giúp tạo và điều hoà các tế bào kháng thể, hoạt hoá hệ miễn dịch, chống oxy hoá, nâng cao sức đề kháng giúp bé ít bị bệnh vặt.\u003c/p\u003e\n\u003cp\u003e- Hỗ trợ hệ tiêu hoá, hấp thu nhanh chất dinh dưỡng: Công nghệ ĐẠM SỮA THUỶ PHÂN (Công nghệ giúp cắt nhỏ những phân tử đạm giúp bé hấp thu nhanh) có tác dụng phòng chống nôn trớ, giảm tối đa dị ứng sữa, tăng cường hấp thu cho hệ tiêu hoá còn non yếu ở trẻ.\u003c/p\u003e\n\u003cp\u003e- Sữa XO Số 4 sử dụng gốc đường cao phân tử cao cấp: Raffinose, Galactosyllactosse và GOS giúp trẻ tăng cường hoạt động của hệ tiêu hoá, giảm thiểu tối đa tình trạng táo bón và tiêu chảy.\u003c/p\u003e\n\u003cp\u003e- Sữa XO Số 4 có vị thơm và nhạt tự nhiên gần giống như sữa mẹ.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eCÔNG DỤNG\u003c/p\u003e\n\u003cp\u003e- Phát triển trí não và thị giác: Sữa XO Số 4 có công thức tối ưu các thành phần DHA, ARA, Choline kết hợp với Sphingomyelin hỗ trợ cho sự phát triển của trí não, hệ thần kinh và thị giác trong giai đoạn đầu đời, tạo tiền đề vững chắc cho việc nhận thức và tư duy cho trẻ.\u003c/p\u003e\n\u003cp\u003e- Phát triển thể chất khoẻ mạnh: Sữa với 59 thành phần dưỡng chất, mang lại nguồn năng lượng và dưỡng chất dồi dào để bé phát triển khoẻ mạnh một cách vượt trội trong giai đoạn đầu đời quan trọng.\u003c/p\u003e\n\u003cp\u003e- Đặc biệt, bổ sung hàm lượng Canxi cao giúp hệ xương của bé cứng cáp hơn.\u003c/p\u003e\n\u003cp\u003e- Bổ sung Vitamin D, đặc biệt là CPP(Casein Phospho Peptides) giúp bé được hấp thu tối đa Canxi vào xương để trẻ có thể phát triển tốt.\u003c/p\u003e\n\u003cp\u003e- Dòng Sữa XO tự hào là sữa duy nhất có công thức CPP.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eĐỐI TƯỢNG SỬ DỤNG: Dành cho trẻ từ 1 - 3 tuổi\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eXuất xứ: Hàn Quốc\u003c/p\u003e\n\u003cp\u003eHạn sử dụng: 20 tháng từ ngày sản xuất\u003c/p\u003e\n\u003cp\u003eNgày sản xuất: Xem trên bao bì sản phẩm\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/0f/5e/f9/a6be26d11c289024a80a0ddb40253291.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0f/5e/f9/a6be26d11c289024a80a0ddb40253291.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/0f/5e/f9/a6be26d11c289024a80a0ddb40253291.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0f/5e/f9/a6be26d11c289024a80a0ddb40253291.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0f/5e/f9/a6be26d11c289024a80a0ddb40253291.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/9f/fd/51/56065c46cca901e6949027412824813b.jpeg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/9f/fd/51/56065c46cca901e6949027412824813b.jpeg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/9f/fd/51/56065c46cca901e6949027412824813b.jpeg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9f/fd/51/56065c46cca901e6949027412824813b.jpeg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9f/fd/51/56065c46cca901e6949027412824813b.jpeg"},{"base_url":"https://salt.tikicdn.com/ts/product/3c/7c/86/6d7e55e49bd3d3f673d9be09bbb01b8d.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/3c/7c/86/6d7e55e49bd3d3f673d9be09bbb01b8d.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/3c/7c/86/6d7e55e49bd3d3f673d9be09bbb01b8d.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3c/7c/86/6d7e55e49bd3d3f673d9be09bbb01b8d.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3c/7c/86/6d7e55e49bd3d3f673d9be09bbb01b8d.png"},{"base_url":"https:/