l,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":2320000,"discount_rate":54,"rating_average":4.7,"review_count":10,"review_text":"(10)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/30/2d/23/b1fef886c67ecaf957ae21222fcec641.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":804,"all_time_quantity_sold":36,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cdiv\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003ciframe src=\"//www.youtube.com/embed/4JDJfDeh2Lc\" width=\"560\" height=\"314\" allowfullscreen=\"\"\u003e\u003c/iframe\u003e\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv\u003eMột không gian bếp thoáng mát và sạch sẽ, không khói mùi là tiêu chí hàng đầu được nhiều gia đình quan tâm hiện nay bởi nó ảnh hưởng trực tiếp đến quá trình nấu ăn hằng ngày cũng như về sức khoẻ của các thành viên. Và việc sử dụng máy hút mùi được xem là giải pháp tốt nhất để đáp ứng những nhu cầu ấy của người dùng. Ecalite đem đến model \u003cstrong\u003emáy hút mùi classic Ecalite EH-CL700T \u003c/strong\u003etrang bị nhiều tiện ích như hẹn giờ, điều khiển cảm ứng kết hợp với cử chỉ hiện đại, thiết kế nhỏ gọn, sang trọ góp phần hoàn thiện căn bếp nhà bạn thêm tiện nghi và tinh tế.\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/03/16/b9/5cdb0f35c25bc616a12aea9925f6d5b8.png\" alt=\"máy hút mùi classic Ecalite EH-CL700T\" width=\"750\" height=\"392\" /\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv\u003e\n\u003ch2\u003e\u003cspan style=\"color:#3366ff;\"\u003eThiết kế cổ điển nhỏ gọn, tiết kiệm diện tích\u003c/span\u003e\u003c/h2\u003e\n\u003cdiv\u003e\n\u003cdiv\u003eMáy hút mùi classic với thiết kế cứng cáp, sang trọng, phần thân cực gọn đặt áp vào tường nên trông rất gọn gàng, không chiếm quá nhiều diện tích bếp. Do đó, sản phẩm phù hợp với các không gian bếp vừa và nhỏ, các chung cư hoặc theo phong cách cổ điển, đơn giản. Các đường nét được gia công tỉ mỉ, góc cạnh rất khỏe khoắn và chắc chắn cho sản phẩm. \u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv\u003eMáy hút mùi cổ điển \u003cstrong\u003eEH-CL700T\u003c/strong\u003e có kích thước 70cm là kích thước phổ biến nhất được sử dụng tại nhiều căn bếp Việt. Bạn có thể kết hợp sản phẩm với nhiều dòng bếp khác nhau mà vẫn đảm bảo tính thẩm mỹ cũng như hiệu suất hoạt động không hề thay đổi.\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/7e/6a/22/ea074c6b2ac5fa2962d6f35fc98b7b91.png\" alt=\"Máy hút mùi Ecalite EH-CL700T thiết kế nhỏ gọn\" width=\"750\" height=\"392\" /\u003e\u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cem\u003eMáy hút mùi Ecalite EH-CL700T thiết kế nhỏ gọn\u003c/em\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv\u003e\n\u003ch2\u003e\u003cspan style=\"color:#3366ff;\"\u003eThân máy sơn tĩnh điện bền bỉ\u003c/span\u003e\u003c/h2\u003e\n\u003cdiv\u003ePhần thân máy hút mùi Ecalite được sơn đen tĩnh điện cho tổng thể sản phẩm tính chắc chắc, chống các va đập mạnh từ bên ngoài. Với tông màu trung tính này, bạn có thể dễ dàng phối với bất kì sản phẩm nội thất nào. \u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/a2/d2/85/dd8eec3ea3bb8bb36679f3b569b09164.png\" alt=\"Thân máy chắc chắn, bền bỉ\" width=\"750\" height=\"392\" /\u003e\u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cem\u003eThân máy chắc chắn, bền bỉ\u003c/em\u003e\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv\u003ePhía trước là mặt kính trắng thiết kế đẹp, chắc, có thể điều chỉnh lên xuống theo hướng khói mùi toả ra trong quá trình nấu ăn, nhờ đó giúp khói mùi được tập trung lại để xử lý nhanh chóng, tiết kiệm thời gian hút. \u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/11/21/26/ce3d11f1eb2855422725bc5b356666db.png\" alt=\"Kính trắng giúp tập trung khói mùi trên máy hút mùi\" width=\"750\" height=\"392\" /\u003e\u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cem\u003eKính trắng giúp tập trung khói mùi trên máy hút mùi\u003c/em\u003e\u003c/div\u003e\n\u003ch2\u003e\u003cspan style=\"color:#3366ff;\"\u003eLưới lọc dầu dễ tháo lắp vệ sinh\u003c/span\u003e\u003c/h2\u003e\n\u003cdiv\u003e\n\u003cdiv\u003eMáy hút mùi classic Ecalite được lắp vào vỉ lọc dầu chất liệu nhôm dày dặn, độ bền cao, lưới lọc này có tác dụng lọc các dầu mỡ trước khi vào các động cơ tiếp theo để xử lý, tăng độ bền cho các bộ phận bên trong. Khi bạn cần lấy ra để vệ sinh, chỉ cần tháo nhẹ là có thể lấy để vệ sinh một cách thoải mái nhất. Vỉ dầu này chỉ cần ngâm vào nước ấm và pha chút nước rửa chén, các mảng bám sẽ dễ dàng bong tróc để bạn chùi rửa một cách dễ dàng.\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/02/e4/a9/a5df64e5a08d157137203ceb034af42b.png\" alt=\"Lưới lọc nhôm dễ tháo rời vệ sinh\" width=\"750\" height=\"392\" /\u003e\u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cem\u003eLưới lọc nhôm dễ tháo rời vệ sinh\u003c/em\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv\u003e\n\u003ch2\u003e\u003cspan style=\"color:#3366ff;\"\u003eKhử mùi hiệu quả bằng than hoạt tính\u003c/span\u003e\u003c/h2\u003e\n\u003cdiv\u003eCơ chế khử mùi của máy hút mùi Ecalite dựa trên hai phương thức là sử dụng bộ lọc than hoạt tính và có thể lắp thêm ống dẫn khí ra bên ngoài (đường kính 12cm) để tăng hiệu quả khử mùi cho máy. Than hoạt tính hoạt động trên cơ chế quay vòng tuần hoàn. Cụ thể là toàn bộ khói, mùi thức ăn được hút vào trong khoang máy đi qua bộ lọc than rồi trả lại nhà bếp không khí đã được làm sạch.\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/1c/34/4a/e255fefcf34224c6101b15fe9d54bbe7.png\" alt=\"Than hoạt tính trên Ecalite EH-CL700T\" width=\"750\" height=\"392\" /\u003e\u003c/div\u003e\n\u003cdiv\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cem\u003eThan hoạt tính trên Ecalite EH-CL700T\u003c/em\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv\u003e\n\u003cdiv\u003e\n\u003ch2\u003e\u003cspan style=\"color:#3366ff;\"\u003eĐiều khiển cảm ứng dễ sử dụng\u003c/span\u003e\u003c/h2\u003e\n\u003cp\u003eĐể tăng thêm tính hiện đại và tiện ích khi sử dụng,\u003cstrong\u003e máy hút mùi classic EH-CL700T\u003c/strong\u003e được Ecalite trang bị bảng điều khiển cảm ứng cực nhanh nhạy, kết hợp là màn hình LED hiển thị trực quan giúp người dùng dễ dàng quan sát và điều chỉnh các chức năng khi sử dụng. \u003c/p\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cem\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ce/a7/dd/9f6f79fc0aa1484945a1950300a0528d.png\" alt=\"máy hút mùi Ecalite EH-CL700T điều khiển cảm ứng\" width=\"750\" height=\"392\" /\u003e\u003cbr /\u003eCác nút chức năng trên máy hút mùi EH-CL700T\u003c/em\u003e\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cp\u003eSản phẩm này cũng cho phép bạn cài đặt thời gian tiện lợi ngay trên màn hình hiển thị của bảng điều khiển. Nó tương tự như một chiếc đồng hồ để bạn tiện quan sát thời gian canh chừng món ăn cho phù hợp, đồng thời chủ động thời gian để thực hiện các công việc khác. \u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv\u003e\n\u003ch2\u003e\u003cspan style=\"color:#3366ff;\"\u003eĐiều khiển cử chỉ thông minh\u003c/span\u003e\u003c/h2\u003e\n\u003cdiv\u003eHút mùi Ecalite EH-CL700T còn có thêm tính năng điều khiển bằng cử chỉ vô cùng thông minh, chỉ bằng vài động tác đơn giản bạn đã có thể điều khiển hoạt động của máy mà không cần chạm vào bảng điều khiển.\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/09/8c/1f/f531335fd4a926bf57ed2d584dad440e.png\" alt=\"Thao tác đơn giản với điều khiển cử chỉ\" width=\"750\" height=\"392\" /\u003e\u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cem\u003eThao tác đơn giản với điều khiển cử chỉ\u003c/em\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv\u003e\n\u003ch2\u003e\u003cspan style=\"color:#3366ff;\"\u003eChiếu sáng bằng đèn LED công suất cao\u003c/span\u003e\u003c/h2\u003e\n\u003cp\u003eEcalite EH-CL700T trang bị 2 bóng đèn LED (2X2W) chiếu sáng tốt cho khu vực nấu ăn, đặc biệt vào ban đêm. Ngoài ra, còn tăng sự ấm áp cho gian bếp, giúp người nội trợ nấu nướng dễ dàng, vừa tiết kiệm điện năng khi sử dụng.\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cem\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/d0/e5/04/8607c66fc769ea7d4e8aea17f52375f3.png\" alt=\"Hai đèn LED công suất cao trên hút mùi Ecalite EH-CL700T\" width=\"750\" height=\"392\" /\u003e\u003cbr /\u003eHai đèn LED công suất cao trên hút mùi Ecalite EH-CL700T\u003c/em\u003e\u003c/p\u003e\n\u003ch2\u003e\u003cspan style=\"color:#3366ff;\"\u003eCông suất hút 750m3/h\u003c/span\u003e\u003c/h2\u003e\n\u003cp\u003eCác máy hút mùi classic thường bị hạn chế ở công suất hút so với các dòng máy hút mùi khác, tuy nhiên với Ecalite EH-CL700T lại trang bị công suất hút khá cao lên đến 750m3/h. Với công suất này sẽ hút sạch mùi hôi, dầu mỡ nhà bạn trong một phạm vi bếp tương đối lớn rất nhanh chóng, giúp bạn an tâm khi nấu ăn hàng ngày với tần suất cao.\u003c/p\u003e\n\u003ch2\u003e\u003cspan style=\"color:#3366ff;\"\u003eChức năng hẹn giờ tắt máy tiện lợi\u003c/span\u003e\u003c/h2\u003e\n\u003cp\u003eVới tính năng này máy hút mùi sẽ tự tắt sau khoảng thời gian nhất định hoặc khi bạn cần rời bếp mà không thể tắt, thì chúng sẽ tự tắt sau khi hết đúng số giờ đã cài đặt và giúp bạn tiết kiệm năng lượng hơn so với những lần để quên. Bạn chỉ cần nhấn vào biểu tượng đồng hồ trên màn hình, lúc này máy sẽ được tự động thiết lập thời gian tắt máy trễ hơn 1 phút so với bình thường. \u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/f3/25/01/0ac970d0cabbfe853f61b0875675643c.png\" alt=\"Hẹn giờ tiện lợi giúp bạn chủ động thời gian\" width=\"750\" height=\"392\" /\u003e\u003cbr /\u003e\u003cem\u003eHẹn giờ tiện lợi giúp bạn chủ động thời gian\u003c/em\u003e\u003c/p\u003e\n\u003c/div\u003e\n\u003ch2\u003e\u003cspan style=\"color:#3366ff;\"\u003eHoạt động êm ái với độ ồn thấp\u003c/span\u003e\u003c/h2\u003e\n\u003cdiv\u003e\n\u003cdiv\u003eMáy hút mùi cổ điển Ecalite EH-CL700T hoạt động rất êm ái nhờ động cơ bền bỉ, độ ồn tối đa chỉ 55dB đảm bảo các hoạt động như học tập, làm việc, đều không bị ảnh hưởng. Nhờ đó, tạo không khí thoải mái và yên tĩnh ngay cả khi sử dụng máy.\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cem\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/24/11/b4/67ba6a1151ff5f75c0d9a08aaf67c298.png\" alt=\"Máy hút mùi Ecalite EH-CL700T có độ ồn thấp\" width=\"750\" height=\"392\" /\u003e\u003cbr /\u003eMáy hút mùi Ecalite EH-CL700T có độ ồn thấp\u003c/em\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv\u003e\n\u003cdiv\u003e\n\u003ch2\u003e\u003cspan style=\"color:#3366ff;\"\u003eThông số kỹ thuật máy hút mùi classic Ecalite EH-CL700T\u003c/span\u003e\u003c/h2\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/22/6