e\n\u003cdiv\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/0f/97/ee/d4c35d723ce74b35034babec3aacfa1b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0f/97/ee/d4c35d723ce74b35034babec3aacfa1b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/0f/97/ee/d4c35d723ce74b35034babec3aacfa1b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0f/97/ee/d4c35d723ce74b35034babec3aacfa1b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0f/97/ee/d4c35d723ce74b35034babec3aacfa1b.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/08/f5/37/eb3bea2dcf7da5bc0e8d09ef8ce70344.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/08/f5/37/eb3bea2dcf7da5bc0e8d09ef8ce70344.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/08/f5/37/eb3bea2dcf7da5bc0e8d09ef8ce70344.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/08/f5/37/eb3bea2dcf7da5bc0e8d09ef8ce70344.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/08/f5/37/eb3bea2dcf7da5bc0e8d09ef8ce70344.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/21/b7/27/4b9e44cd1f7cdab595ec1c959b84cbcc.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/21/b7/27/4b9e44cd1f7cdab595ec1c959b84cbcc.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/21/b7/27/4b9e44cd1f7cdab595ec1c959b84cbcc.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280