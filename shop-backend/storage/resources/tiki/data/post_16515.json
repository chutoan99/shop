text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.7,"review_count":3,"review_text":"(3)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/fd/3b/3e/e701231dbf95434f8d512947eaf8170a.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1569,"all_time_quantity_sold":3,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eNhãn hiệu: LOBINNI\u003c/p\u003e\n\u003cp\u003eMã sản phẩm: No.1023LT-6\u003c/p\u003e\n\u003cp\u003eGiới tính: Nam\u003c/p\u003e\n\u003cp\u003eKiểu máy: Automatic (Máy Cơ)\u003c/p\u003e\n\u003cp\u003eĐường kính mặt: 40 mm\u003c/p\u003e\n\u003cp\u003eĐộ dày: 11 mm\u003c/p\u003e\n\u003cp\u003eChất liệu vỏ: Thép không gỉ 316L\u003c/p\u003e\n\u003cp\u003eChất liệu dây: Thép không gỉ 316L\u003c/p\u003e\n\u003cp\u003eChất liệu mặt kính: Sapphire\u003c/p\u003e\n\u003cp\u003eKhả năng chịu nước: 5ATM\u003c/p\u003e\n\u003cdiv class=\"title_module_main heading-bar d-flex justify-content-between align-items-center\"\u003e\n\u003ch2 class=\"heading-bar__title\"\u003eĐẶC ĐIỂM NỔI BẬT\u003c/h2\u003e\n\u003c/div\u003e\n\u003cdiv class=\"rte js-product-getcontent product_getcontent pos-relative\"\u003e\n\u003cdiv class=\"content js-content\"\u003e\n\u003cp\u003eNHẬT NGUYỆT TRÙNG PHÙNG – THỔI BÙNG CẢM XÚC\u003c/p\u003e\n\u003cp\u003e\u003ciframe src=\"https://www.youtube.com/embed/hbkEoF8104U\" width=\"800\" height=\"400\" frameborder=\"0\" scrolling=\"no\"\u003e\u003c/iframe\u003e\u003c/p\u003e\n\u003cp\u003eLOBINNI tiếp tục cho ra mắt bộ sưu tập đồng hồ nam chính hãng đình đám mang tên No.1023LT Sun And Moon.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://bizweb.dktcdn.net/100/472/501/files/dong-ho-nam-lobinni-no-1023lt-chinh-hang-1.jpg?v=1670298252736\" alt=\"dong-ho-nam-lobinni-no-1023lt-chinh-hang-1.jpg?v=1670298252736\" /\u003e\u003c/p\u003e\n\u003cp\u003eSiêu phẩm này đã đem đến tiếng vang cho thương hiệu khi sở hữu thiết kế Nhật – Nguyệt vô cùng cuốn hút. Bên cạnh đó là nhiều chức năng và chi tiết chưa từng có ở những phiên bản trước.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://bizweb.dktcdn.net/100/472/501/files/dong-ho-nam-lobinni-no-1023lt-chinh-hang-2.jpg?v=1670298253654\" alt=\"dong-ho-nam-lobinni-no-1023lt-chinh-hang-2.jpg?v=1670298253654\" /\u003e\u003c/p\u003e\n\u003cp\u003e  \"Một tác phẩm nghệ thuật\" ngay trên cổ tay người sở hữu chính là điều tạo nên sức hút khó cưỡng cho PHIÊN BẢN ĐẶC BIỆT này.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://bizweb.dktcdn.net/100/472/501/files/dong-ho-nam-lobinni-no-1023lt-chinh-hang-3.jpg?v=1670298254358\" alt=\"dong-ho-nam-lobinni-no-1023lt-chinh-hang-3.jpg?v=1670298254358\" /\u003e\u003c/p\u003e\n\u003cp\u003eMặt đồng hồ \"6 KIM - 4 LỊCH\" phô bày trọn vẹn 3 cột mốc thời gian cùng điểm nhấn SUN \u0026amp; MOON đầy bí ẩn có khả năng xoay vần, giúp người đeo biết được ngày - đêm, vừa nổi bật vừa là điểm nhấn giá trị cho cỗ máy này. \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://bizweb.dktcdn.net/100/472/501/files/dong-ho-nam-lobinni-no-1023lt-chinh-hang-4.jpg?v=1670298255071\" alt=\"dong-ho-nam-lobinni-no-1023lt-chinh-hang-4.jpg?v=1670298255071\" /\u003e\u003c/p\u003e\n\u003cp\u003eLịch thứ, lịch ngày, lịch tháng cùng xuất hiện trên mặt số, nhưng điều đó không hề rối mắt mà ngược lại còn tạo nên một tổng thể ĐẬM NÉT NGHỆ THUẬT bởi từng chi tiết của đồng hồ nam chính hãng LOBINNI No.1023LT đều được hoàn thiện và sắp xếp cực kỳ tinh xảo.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://bizweb.dktcdn.net/100/472/501/files/dong-ho-nam-lobinni-no-1023lt-chinh-hang-5.jpg?v=1670298255977\" alt=\"dong-ho-nam-lobinni-no-1023lt-chinh-hang-5.jpg?v=1670298255977\" /\u003e\u003c/p\u003e\n\u003cp\u003eBộ kim cùng cọc số thanh mảnh, kết hợp với dải vân gouloche đánh sóng khắp diện tích mặt số, tất cả đều tạo nên một nét lịch thiệp gọn gàng và trang nhã, rất phù hợp với những người đàn ông trưởng thành hiện đại tinh tế.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://bizweb.dktcdn.net/100/472/501/files/dong-ho-nam-lobinni-no-1023lt-chinh-hang-6.jpg?v=1670298256943\" alt=\"dong-ho-nam-lobinni-no-1023lt-chinh-hang-6.jpg?v=1670298256943\" /\u003e\u003c/p\u003e\n\u003cp\u003eMặt kính Sapphire nguyên khối chống trầy xước đến hơn 90%, thoải mái hoạt động hay va chạm thường ngày.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://bizweb.dktcdn.net/100/472/501/files/dong-ho-nam-lobinni-no-1023lt-chinh-hang-7.jpg?v=1670298257710\" alt=\"dong-ho-nam-lobinni-no-1023lt-chinh-hang-7.jpg?v=1670298257710\" /\u003e\u003c/p\u003e\n\u003cp\u003eỞ phiên bản đặc biệt này, LOBINNI No.1023LT được cải tiến thêm thiết kế mặt kim dạ quang giúp người dùng có thể xem giờ dễ dàng trong điều kiện ánh sáng thấp.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://bizweb.dktcdn.net/100/472/501/files/dong-ho-nam-lobinni-no-1023lt-chinh-hang-8.jpg?v=1670298258658\" alt=\"dong-ho-nam-lobinni-no-1023lt-chinh-hang-8.jpg?v=1670298258658\" /\u003e\u003c/p\u003e\n\u003cp\u003eSize mặt 40mm cùng độ dày 11mm cực kỳ phù hợp với cổ tay của người Việt Nam vừa sang trọng, thanh lịch lại cực kỳ dễ đeo.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://bizweb.dktcdn.net/100/472/501/files/dong-ho-nam-lobinni-no-1023lt-chinh-hang-9.jpg?v=1670298259623\" alt=\"dong-ho-nam-lobinni-no-1023lt-chinh-hang-9.jpg?v=1670298259623\" /\u003e\u003c/p\u003e\n\u003cp\u003eGia công từ những vật liệu như cao cấp thép không gỉ 316L, dây da thật,... với số lượng phiên bản hạn chế.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://bizweb.dktcdn.net/100/472/501/files/dong-ho-nam-lobinni-no-1023lt-chinh-hang-10.jpg?v=1670298260346\" alt=\"dong-ho-nam-lobinni-no-1023lt-chinh-hang-10.jpg?v=1670298260346\" /\u003e\u003c/p\u003e\n\u003cp\u003eCỗ máy cơ Automatic cải tiến hiện đại chính là một lời khẳng định mạnh mẽ về ĐẲNG CẤP của LOBINNI No.1023LT cũng như người được sở hữu.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://bizweb.dktcdn.net/100/472/501/files/dong-ho-nam-lobinni-no-1023lt-chinh-hang-11.jpg?v=1670298261248\" alt=\"dong-ho-nam-lobinni-no-1023lt-chinh-hang-11.jpg?v=1670298261248\" /\u003e\u003c/p\u003e\n\u003cp\u003eTẦM GIÁ 3 TRIỆU: Mức giá không thể yêu thương hơn đối với một chiếc đồng hồ Automatic dây da thanh lịch, huyền bí và được trang bị độ chống nước 5 ATM. Phái mạnh thi nhau săn đón ráo riết cũng là điều đương nhiên.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://bizweb.dktcdn.net/100/472/501/files/dong-ho-nam-lobinni-no-1023lt-chinh-hang-12.jpg?v=1670298262054\" alt=\"dong-ho-nam-lobinni-no-1023lt-chinh-hang-12.jpg?v=1670298262054\" /\u003e\u003c/p\u003e\n\u003cp\u003eThanh lịch - Chuẩn Men - Đậm cá tính, liệu ai nỡ từ chối cơ chứ?\u003c/p\u003e\n\u003cp\u003eĐồng Hồ Nam Chính Hãng Lobinni No.1023LT-6 Automatic được phân phối chính hãng tại Đồng hồ Bảo Thanh - Nơi An Tâm Mua Đồng Hồ Chính Hãng.\u003c/p\u003e\n\u003cp\u003eCam kết 100% sản phẩm chính hãng, đầy đủ quyền lợi bảo hành quốc tế từ hãng.\u003c/p\u003e\n\u003cp\u003eMiễn phí vận chuyển toàn quốc. \u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/fd/3b/3e/e701231dbf95434f8d512947eaf8170a.jpg","i