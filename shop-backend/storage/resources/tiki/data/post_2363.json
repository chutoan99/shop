ơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/9c/04/54/a792ee1c252f5e8b6de3c713b1cd8fac.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/9c/04/54/a792ee1c252f5e8b6de3c713b1cd8fac.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/9c/04/54/a792ee1c252f5e8b6de3c713b1cd8fac.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9c/04/54/a792ee1c252f5e8b6de3c713b1cd8fac.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9c/04/54/a792ee1c252f5e8b6de3c713b1cd8fac.jpg"}],"warranty_policy":null,"brand":{"id":891455,"name":"TEMPUR","slug":"tempur"},"current_seller":{"id":9596,"sku":"2823515382252","name":"Vua Nệm Official Store","link":"https://tiki.vn/cua-hang/vua-nem-official-store","logo":"https://vcdn.tikicdn.com/ts/seller/a6/bc/d1/e48825f012b94aa2c4c3fb717c46bc28.jpg","price":4784000,"product_id":"270828863","store_id":9398,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Content","attributes":[{"code":"brand","name":"Thương hiệu","value":"TEMPUR"},{"code":"brand_country","name":"Xuất xứ thương hiệu","value":"Mỹ"},{"code":"chat_lieu","name":"Chất liệu","value":"\u003cp\u003efoam\u003c/p\u003e"},{"code":"kich_thuoc","name":"Kích thước (Dài x Rộng x Cao)","value":"70x50x10"},{"code":"material","name":"Chất liệu","value":"foam"},{"code":"origin","name":"Xuất xứ (Made in)","value":"Mỹ"}]},{"name":"Operation","attributes":[{"code":"is_warranty_applied","name":"Sản phẩm có được bảo hành không?","value":"Không"},{"code":"seller_delivery_method","name":"Phương thức giao hàng Seller Delivery","value":"Nhà bán giao hàng cho khách hàng"}]}],"product_links":[],"gift_item_title":"0 quà tặng kèm","services_and_promotions":[],"promitions":[],"stock_item":{"max_sale_qty":1000,"min_sale_qty":1,"preorder_date":null,"qty":1000},"c