ên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/media/catalog/product/1/4/1442544323_ba2086_1.u5530.d20170811.t172402.44361.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/1/4/1442544323_ba2086_1.u5530.d20170811.t172402.44361.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/1/4/1442544323_ba2086_1.u5530.d20170811.t172402.44361.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/1/4/1442544323_ba2086_1.u5530.d20170811.t172402.44361.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/1/4/1442544323_ba2086_1.u5530.d20170811.t172402.44361.jpg"},{"base_url":"https://salt.tikicdn.com/media/catalog/product/1/4/1442544374_ba2086_2.u5530.d20170811.t172402.95545.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/1/4/1442544374_ba2086_2.u5530.d20170811.t172402.95545.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/1/4/1442544374_ba2086_2.u5530.d20170811.t172402.95545.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/1/4/1442544374_ba2086_2.u5530.d20170811.t172402.95545.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/1/4/1442544374_ba2086_2.u5530.d20170811.t172402.95545.jpg"}],"warranty_policy":null,"brand":{"id":21419,"name":"Trường Thọ","slug":"truong-tho"},"current_seller":{"id":69337,"sku":"7113475218757","name":"Home Star Store","link":"https://tiki.vn/cua-hang/home-star-store","logo":"a7/d1/10/9a899c6c30ccd377afaa4aca15cfa72b.jpg","price":264000,"product_id":"56029962","store_id":64779,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[{"id":389,"name":"Đại Phát Tài","link":"https://tiki.vn/cua-hang/dai-phat-tai","logo":"cd/b3/73/cdb3735e0151914cf705609739b1dbda.png","price":282450,"pro