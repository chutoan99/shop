pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":211000,"discount_rate":28,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/63/b2/5d/864e8a8ffb339f187fa1a9b2792e16a0.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":306,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<h2 class=\"irIKAp\">TAI NGHE TRUE WIRELESS SOUNDPEATS CLEAR</h2>\n<h3 class=\"irIKAp\">Thông Số Kỹ Thuật</h3>\n<p class=\"irIKAp\">Mẫu mã: SoundPEATS Clear</p>\n<p class=\"irIKAp\">Màu sắc: Đen, Trắng</p>\n<p class=\"irIKAp\">Chipset: JL6973D8</p>\n<p class=\"irIKAp\">Kích thước tai nghe: 57*30*50 2mm</p>\n<p class=\"irIKAp\">Kích thước hộp sạc: 21*24*33mm”</p>\n<p class=\"irIKAp\">Trọng lượng tai nghe đơn: 4,2g</p>\n<p class=\"irIKAp\">Trọng lượng hộp sạc: 45g</p>\n<p class=\"irIKAp\">Phiên bản Bluetooth: V5.3</p>\n<p class=\"irIKAp\">Cấu hình Bluetooth được hỗ trợ: HFP/A2DP/AVRCP</p>\n<p class=\"irIKAp\">Hỗ trợ Bluetooth Codec: AAC,SBC</p>\n<p class=\"irIKAp\">Dung lượng pin: 38mAh*2 &#43;400mAh</p>\n<p class=\"irIKAp\">Cổng sạc: Type-C</p>\n<p class=\"irIKAp\">Phương pháp giảm tiếng ồn bằng giọng nói: Mic kép</p>\n<p class=\"irIKAp\">Điều khiển: Cảm ứng</p>\n<p class=\"irIKAp\">Thời gian sạc tai nghe 1,5 giờ; Hộp sạc 2 giờ</p>\n<p class=\"irIKAp\">Tổng thời gian phát nhạc: Tai nghe: 7 giờ, Số lần sạc: 4,5 lần</p>\n<p class=\"irIKAp\">Tổng thời gian sử dụng bao gồm hộp sạc: 40 giờ</p>\n<p class=\"irIKAp\">Kháng nước: IPX4</p>\n<p class=\"irIKAp\">Đầu vào: 5V/1A</p>\n<p class=\"irIKAp\">Tổng thời gian chờ: 40 giờ</p>\n<p class=\"irIKAp\">Độ nhạy của micro: -38±1dB</p>\n<p class=\"irIKAp\">Đáp ứng tần số: 20-20KHz</p>\n<p class=\"irIKAp\">Trở kháng/độ nhạy của trình điều khiển: 32Ω ± 15% ở 1KHz AC</p>\n<p class=\"irIKAp\">Kích thước trình điều khiển: 12 mm</p>\n<p class=\"irIKAp\">Linh kiện pin: Polyme Li-ion</p>\n<p class=\"irIKAp\"> </p>\n<p class=\"irIKAp\"><img style=\"margin-left:auto;margin-right:auto\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/41/6f/e8/483b580df95707bec7d37fcff1a9a443.jpg\" alt=\"\" width=\"750\" height=\"307\" /></p>\n<h3 class=\"irIKAp\"> </h3>\n<h3 class=\"irIKAp\">Dòng sản phẩm SoundPEATS Transparent Series</h3>\n<p class=\"irIKAp\">SoundPEATS Clear hình dáng in-ear, đàm thoại rõ ràng với mic kép &#43; ENC, hỗ trợ chế độ chơi game, điều khiển EQ qua ứng dụng SoundPEATS.</p>\n<p><img style=\"margin-left:auto;margin-right:auto\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/f4/d1/aa/cbaf04813749c37294aeb48d80d4355f.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<h3 class=\"irIKAp\">Trong Suốt Ấn Tượng</h3>\n<p class=\"irIKAp\">SoundPEATS Clear gây ấn tượng mạnh mẽ với vẻ ngoài trong suốt đầy thời trang, một trong những xu hướng thiết kế tai nghe thịnh hành trong những tháng gần đây. Phần tai nghe là sự kết hợp hài hòa giữa thiết kế trong suốt, logo chữ S cách điệu, dòng chữ “Hear Your Imagination” cùng điểm nhấn màu xanh ở phần gắn tips tai nghe.</p>\n<p class=\"irIKAp\"> </p>\n<p class=\"irIKAp\"><img style=\"margin-left:auto;margin-right:auto\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/35/8b/a4/a76048fb7a7cc7d6ce684035db5306bc.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<h3 class=\"irIKAp\"> </h3>\n<h3 class=\"irIKAp\">Thiết Kế Tinh Tế</h3>\n<p class=\"irIKAp\">Tai nghe không dây SoundPEATS Clear được thiết kế theo dạng In-ear và có 3 nút tai thay thế với kích thước S/M/L. Với thiết kế nhỏ gọn, được tinh chỉnh để vừa vặn với mọi khuôn tai.</p>\n<p class=\"irIKAp\"> </p>\n<p class=\"irIKAp\"><img style=\"margin-left:auto;margin-right:auto\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/f4/cf/61/95e35feabd4a31aa5ae5115978dd0455.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<h3 class=\"irIKAp\"> </h3>\n<h3 class=\"irIKAp\">Bluetooth Hiện Đại</h3>\n<p class=\"irIKAp\">SoundPEATS Clear mang đến tốc độ kết nối vô cùng nhanh chóng, ổn định và liền mạch trong bán kính 10m. Đồng thời, chuẩn Bluetooth mới cũng hạn chế phần nào độ trễ của tai nghe và tăng thời lượng sử dụng tai nghe, thỏa thích nghe nhạc, chơi game trong nhiều giờ liền.</p>\n<p class=\"irIKAp\"> </p>\n<p class=\"irIKAp\"><img style=\"margin-left:auto;margin-right:auto\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/59/c9/dc/04ddca9e4587eca50956dc12b20365be.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<h3 class=\"irIKAp\"> </h3>\n<h3 class=\"irIKAp\">Driver Dynamic Màng Sinh Học Bio</h3>\n<p class=\"irIKAp\">Được trang bị Driver Dynamic màng sinh học Bio 12mm, SoundPEATS Clear mang đến cho bạn trải nghiệm âm thanh chất lượng cao và sống động. Màng loa dày dặn giúp tái tạo các dải âm trầm chắc, khỏe vô cùng ninh tai, kết hợp cùng những dải cao đầy tinh tế và dải âm trung vừa vặn.</p>\n<p class=\"irIKAp\"> </p>\n<p class=\"irIKAp\"><img style=\"margin-left:auto;margin-right:auto\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/b5/cf/fc/bb25c5b6d5368409be171c04640d2ec3.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<h3 class=\"irIKAp\"> </h3>\n<h3 class=\"irIKAp\">Pin Dùng Lâu Dài</h3>\n<p class=\"irIKAp\">Pin sử dụng 40 giờ liên tục khi có hộp sạc và 7 giờ khi dùng tai nghe. SoundPEATS Clear có thể đáp ứng được nhiều ngày sử dụng liên tục mà không cần phải sạc lại hộp.</p>\n<p class=\"irIKAp\"> </p>\n<p class=\"irIKAp\"><img style=\"margin-left:auto;margin-right:auto\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/3d/47/3c/c2a065198dbded659b273e90fb6e5434.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<h3 class=\"irIKAp\"> </h3>\n<h3 class=\"irIKAp\">Đàm thoại Rõ Ràng Cùng Mic Kép ENC</h3>\n<p class=\"irIKAp\">SoundPEATS Clear được trang bị 2 mic kép với công nghệ ENC chống ồn môi trường. Công nghệ này hỗ trợ cho quá trình đàm thoại được rõ ràng và chi tiết hơn. Tiếng ồn và tạp âm khi trò chuyện ở nơi đông người sẽ được lọc ở mức tối đa.</p>\n<p class=\"irIKAp\"> </p>\n<p class=\"irIKAp\"><img style=\"margin-left:auto;margin-right:auto\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/14/d3/5a/138005e42ee8b7cd850ce611066f4b71.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<h3 class=\"irIKAp\"> </h3>\n<h3 class=\"irIKAp\">Chú ý: Lần Đầu Tiên Sử Dụng:</h3>\n<p class=\"irIKAp\">1. Tháo miếng cách nhiệt nilon khỏi chấu sạc hai tai nghe.</p>\n<p class=\"irIKAp\">2. Sạc đầy pin của tai nghe và hộp sạc trước khi sử dụng. Thời gian sạc đầy là 2 tiếng.</p>\n<p class=\"irIKAp\">3. Lấy hai tai nghe ra khỏi hộp sạc. Chờ trong giây lát.</p>\n<p class=\"irIKAp\">4. Sau đó truy cập Bluetooth trên điện thoại của bạn, chọn “SOUNDPEATS Clear” và kết nối ngay lập tức.</p>\n<p class=\"irIKAp\">***Lần sau chỉ cần lấy tai nghe ra khỏi hộp sạc, tai nghe sẽ tự động kết nối ***</p>\n<h3 class=\"irIKAp\">Các thao tác cảm ứng trên tai nghe:</h3>\n<div class=\"irIKAp\">\n<div>\n<div class=\"cxDtMn\"><img class=\"_0O7Vlf bgImIg\" style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/5d/42/44/0521a587e909811509a3e285646fb9f1.jpg\" width=\"750\" height=\"241\" alt=\"0521a587e909811509a3e285646fb9f1.jpg\" /></div>\n</div>\n</div>\n<h3 class=\"irIKAp\">Sử dụng cảm ứng điều khiển chức năng</h3>\n<p class=\"irIKAp\">1.Điều khiển âm nhạc</p>\n<p class=\"irIKAp\">Phát/Tạm dừng Nhạc: Chạm hai lần vào cảm ứng trên tai nghe bên trái hoặc bên phải.</p>\n<p class=\"irIKAp\">Phát bài hát trước: Chạm và giữ cảm ứng trong 1,5 giây trên tai nghe bên trái.</p>\n<p class=\"irIKAp\">Phát bài hát tiếp theo: Chạm và giữ cảm ứng trong 1,5 giây trên tai nghe bên phải.</p>\n<p class=\"irIKAp\">Tăng âm lượng: Chạm 1 lần vào cảm ứng bên tai phải.</p>\n<p class=\"irIKAp\">Giảm âm lượng: Chạm 1 lần vào cảm ứng ở bên tai trái.</p>\n<p class=\"irIKAp\">2. Điều khiển cuộc gọi</p>\n<p class=\"irIKAp\">Trả lời/Kết thúc cuộc gọi điện thoại: Nhấn hai lần vào cảm ứng trên tai nghe bên trái hoặc bên phải.</p>\n<p class=\"irIKAp\">Từ chối cuộc gọi điện thoại : Chạm và giữ cảm ứng trong 1,5 giây trên tai nghe bên trái hoặc bên phải.</p>\n<p class=\"irIKAp\">Chuyển cuộc gọi: Chạm và giữ cảm ứng trong 2 giây trên tai nghe bên trái hoặc bên phải. (Có cuộc gọi chờ)</p>\n<p class=\"irIKAp\">Kích hoạt Trợ lý giọng nói: Chạm vào cảm ứng 3 lần trên tai nghe bên phải.</p>\n<p class=\"irIKAp\">Bật / tắt chế độ trò chơi: Chạm vào cảm ứng 3 lần trên tai nghe bên trái.</p>\n<h3 class=\"irIKAp\">Cách reset SoundPEATS Clear:</h3>\n<p class=\"irIKAp\">1. Xóa tai nghe khỏi danh sách Bluetooth của điện thoại.</p>\n<p class=\"irIKAp\">2. Cho 2 tai nghe vào trong hộp sạc đảm bảo 2 tai nghe đang được sạc bởi hộp sạc</p>\n<p class=\"irIKAp\">2. Nhấn giữ nút trên hộp sạc trong 10 giây cho đến khi đèn báo hộp sạc nhấp nháy trắng đỏ 2 lần.</p>\n<p class=\"irIKAp\">Quá trình reset đã hoàn tất.</p>\n<div class=\"irIKAp\">\n<div>\n<div class=\"cxDtMn\"><img class=\"_0O7Vlf bgImIg\" style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/8f/b9/55/29dcbbb0ae28eddab95dbb7f95f084d3.jpg\" width=\"750\" height=\"227\" alt=\"29dcbbb0ae28eddab95dbb7f95f084d3.jpg\" /></div>\n</div>\n</div>\n<h3 class=\"irIKAp\">Bộ sản phẩm bao gồm:</h3>\n<p class=\"irIKAp\">1 x Tai nghe Soundpeats Clear</p>\n<p class=\"irIKAp\">1 x Cáp sạc Type-C</p>\n<p class=\"irIKAp\">2 x Tips thay thế size (S,L)</p>\n<p class=\"irIKAp\">1 x HDSD nhiều ngôn ngữ</p>\n<h3 class=\"irIKAp\">Đèn báo hộp sạc của SoundPEATS Clear</h3>\n<p class=\"irIKAp\">1. Khi không sạc hộp sạc</p>\n<p class=\"irIKAp\">Màu xanh lá: 100% - 50%</p>\n<p class=\"irIKAp\">Màu vàng: 49% - 10%</p>\n<p class=\"irIKAp\">Màu đỏ: &lt;10%</p>\n<p class=\"irIKAp\">2. Khi đang sạc hộp sạc</p>\n<p class=\"irIKAp\">&lt;10%: Đèn đỏ nhấp nháy</p>\n<p class=\"irIKAp\">11%-49%: Đèn vàng nhấp nháy</p>\n<p class=\"irIKAp\">50%-99%: Đèn xanh nhấp nháy</p>\n<p class=\"irIKAp\">100%: Đèn xanh đứng yên</p>\n<h3 class=\"_2jrvqA\">Sản phẩm được phân phối chính hãng tại SoundPEATS Vietnam với dịch vụ chăm sóc khách hàng và bảo hành sản phẩm tốt nhất.</h3>\n<h2 class=\"_2jrvqA\">Bảo hành</h2>\n<p class=\"_2jrvqA\">Bảo hành chính hãng 12 tháng</p>\n<p class=\"_2jrvqA\">Bảo hành 1 đổi 1 (Đối với lỗi từ nhà sản xuất)</p>\n<p class=\"_2jrvqA\">Bảo hành thông qua mã đơn mua hàng trên sàn Tiki, không cần hóa đơn.</p>\n<p class=\"_2jrvqA\">Tất cả sản phẩm công ty phân phối đều bảo hành qua mã đơn hàng, khách hàng ở tỉnh nếu không đến trực tiếp có thể gửi qua đường bưu điện, bên công ty sẽ gửi hàng bảo hành tận nơi cho các bạn.</p>\n<p class=\"_2jrvqA\">Trung tâm bảo hành SoundPEATS Vietnam: Phường An Phú, Quận 2, HCM.</p>\n<h3 class=\"_2jrvqA\"><strong>Điều kiện bảo hành:</strong> Vui lòng giữ lại HỘP của sản phẩm và khi cần bảo hành vui lòng chat với Shop qua app Tiki.</h3>\n<h2 class=\"_2jrvqA\"> Hỗ trợ khách hàng</h2>\n<p class=\"_2jrvqA\">Hỗ trợ tư vấn qua khung chat với Shop trên app Tiki</p>\n<p class=\"_2jrvqA\">Thời gian làm việc: 8h - 12h00 và 13h30 - 17h00 (Từ thứ 2 đến thứ 6, trừ các ngày Lễ/Tết).</p>\n<h3 class=\"_2jrvqA\"> Vui lòng QUAY VIDEO khui gói hàng trước khi mở gói hàng để đảm bảo SHOP giao đúng và đủ đơn hàng. Cảm ơn quý khách đã ủng hộ!</h3><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":