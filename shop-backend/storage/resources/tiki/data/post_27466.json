l,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.8,"review_count":25,"review_text":"(25)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/6c/0b/16/a0dea9827f359210821d0431e444392c.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1339,"all_time_quantity_sold":141,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cspan data-spm-anchor-id=\"a2o4n.pdp.product_\"\u003eThức Ăn Hạt Catsrang Cho Mèo Mọi Lứa Tuổi - 5Kg là một trong những sản phẩm ưu chuộng trên thị trường thức ăn dành cho thúcưng tại Việt Nam. Thiết kế hộp tiện lợi, sạch sẽ, dễ sử dụng catsrang đang là “top” những sản phẩm bán chạy nhất.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cdiv\u003e\n\u003cdiv\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/81/0e/7a/6c221e49bdd91f3dcdbe390347681d2e.png\" width=\"750\" height=\"492\" /\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003cp\u003eNói về dòng sản phẩm này, chắc hẳn quý khách hàng không còn xa lạ với đất nước Hàn Quốc xinh đẹp và nổi tiếng bởi sự sạch sẽ cùng quy trình sản xuất vô cùng nghiêm ngặt. Chính điều này đã tạo nên sản phẩm Catsrang - thức ăn hạt dành cho mèo đảm bảo an toàn, đầy đủ hàm lượng chất dinh dưỡng giúp thú cưng khỏe mạnh hơn.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch2\u003eTHÔNG TIN CHI TIẾT SẢN PHẨM\u003c/h2\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eTên sản phẩm: Thức Ăn Hạt Catsrang Cho Mèo Mọi Lứa Tuổi - 5Kg\u003c/li\u003e\n\u003cli\u003eÁp dụng: cho mèo mọi lứa tuổi, mọi loại mèo\u003c/li\u003e\n\u003cli\u003eĐóng gói thành phẩm: Túi 5Kg\u003c/li\u003e\n\u003cli\u003eThương hiệu: Catsrang\u003c/li\u003e\n\u003cli\u003eXuất xứ: nhập khẩu Hàn Quốc\u003c/li\u003e\n\u003cli\u003eLoại sản phẩm: thức ăn dạng hạt\u003c/li\u003e\n\u003cli\u003eTác dụng: hỗ trợ hệ tiêu hóa mèo khỏe mạnh, cải thiện chức năng của da, hạn chế mùi phân, chống rụng lông và vón cục trong ruột mèo.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch2\u003eTHÀNH PHẦN DINH DƯỠNG\u003c/h2\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eSản phẩm Catsrang được cấu tạo từ thành giàu dinh dưỡng và đảm bảo được chọn lọc kỹ lưỡng. Một số thành phần tiêu biểu như sau:\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eBột thịt gà\u003c/li\u003e\n\u003cli\u003eBột ngô\u003c/li\u003e\n\u003cli data-spm-anchor-id=\"a2o4n.pdp.product_\"\u003eBột cá hồi\u003c/li\u003e\n\u003cli\u003eBột củ cải đường\u003c/li\u003e\n\u003cli\u003eDầu gà\u003c/li\u003e\n\u003cli\u003eDầu hương thảo\u003c/li\u003e\n\u003cli\u003eHạt lanh\u003c/li\u003e\n\u003cli\u003eNấm men\u003c/li\u003e\n\u003cli\u003eChiết xuất yucca\u003c/li\u003e\n\u003cli\u003eCellulose\u003c/li\u003e\n\u003cli\u003eVitamin\u003c/li\u003e\n\u003cli\u003eChất khoáng\u003c/li\u003e\n\u003cli\u003eDl-methionine\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch2\u003ePHÂN TÍCH THÀNH PHẦN DINH DƯỠNG CẤU THÀNH SẢN PHẨM\u003c/h2\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eBột cá hồi: tạo mùi vị hấp dẫn và cung cấp chất dinh dưỡng cần thiết\u003c/li\u003e\n\u003cli\u003e\u003cspan data-spm-anchor-id=\"a2o4n.pdp.product_\"\u003eBột thịt gà: bổ sung chất dinh dưỡng có từ thịt gà tươi và xương\u003c/span\u003e\u003c/li\u003e\n\u003cli\u003eNgô: cung cấp carbohydrate\u003c/li\u003e\n\u003cli\u003eDầu gà: kích thích cún ăn ngon miệng\u003c/li\u003e\n\u003cli data-spm-anchor-id=\"a2o4n.pdp.product_\"\u003eHạt lanh: bổ sung hàm lượng hàm lượng Omega 3, 6 và chất xơ hòa tan\u003c/li\u003e\n\u003cli\u003eBột củ cải đường: cung cấp chất xơ và vitamin khoáng chất cần thiết\u003c/li\u003e\n\u003cli\u003eBột Yucca: có tác dụng khử mùi hôi.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cspan data-spm-anchor-id=\"a2o4n.pdp.product_\"\u003eNếu muốn mèo cưng của mình phát triển khỏe mạnh, xinh đẹp, tinh anh hơn thì sản phẩm Catsrang chính là những gì bạn đang cần. Hãy cho thú cưng của mình những trải nghiệm món ăn ngon, hấp dẫn và đặc biệt đảm bảo an toàn tối đa cho sức khỏe.\u003c/span\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/6c/0b/16/a0dea9827f359210821d0431e444392c.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/6c/0b/16/a0dea9827f359210821d0431e444392c.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/6c/0b/16/a0dea9827f359210821d0431e444392c.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6c/0b/16/a0dea9827f359210821d0431e444392c.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6c/0b/16/a0dea9827f359210821d0431e444392c.png"},{"base_url":"https://salt.tikicdn.com/ts/product/4a/dc/29/d55efcc5156148bbeb1e9bd4a86acf68.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/4a/dc/29/d55efcc5156148bbeb1e9bd4a86acf68.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/4a/dc/29/d55efcc5156148bbeb1e9bd4a86acf68.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4a/dc/29/d55efcc5156148bbeb1e9bd4a86acf68.jpg","thumbnail_url":"https://salt.tikicdn.com/ca