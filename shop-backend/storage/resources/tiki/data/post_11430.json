#FFF0F1","background_color":"#D93843","href":null,"text":"9.9"},{"placement":"pdp_badge","code":"is_hero","type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":true,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/f7/45/2c/afa8341a5dffb9551f23d71d57dcf645.png","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":532,"all_time_quantity_sold":14,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p>Trimax là gel bôi trĩ được kết hợp bởi các thành phần thảo mộc, an toàn và hiệu quả cho người bị trĩ. Thành phần không chứa Corticoid hay Paraben không gây hại cho người dùng. Gel Trimax được xem là giải pháp hoàn hảo và tiện lợi cho người bệnh trĩ nhằm làm giảm các triệu chứng sưng, nóng, đỏ, ngứa, đau rát khó chịu, đồng thời mang lại cảm giác dễ chịu và thoải mái cho người bệnh.</p>\n<p> </p>\n<p>1. Thành phần Gel Trimax</p>\n<p>Kết hợp giữa Chiết xuất Hạt dẻ ngựa, chiết xuất Phỉ, chiết xuất Lô hội và Protein sữa, giúp cải thiện tình trạng đàn hồi, giảm khô rát, nứt nẻ, sưng, nóng, đỏ, ngứa rát khó chịu. Kích thích tái tạo tế bào da mới.</p>\n<p> </p>\n<p>- Venocin (Chiết xuất Hạt dẻ ngựa chuẩn hóa 90% aescin nhập khẩu từ Ấn Độ): Được xem là bí quyết tuyệt vời cho người bệnh trĩ, có tác dụng tăng sức bền thành mạch, ngăn ngừa sự thoái hóa của mao mạch, do đó tác động trực tiếp lên đám rối tĩnh mạch hậu môn và làm co búi trĩ.</p>\n<p>- Aloe Barbadensis Leaf Extract (chiết xuất Lô hội): Giúp làm dịu, giảm ngứa và sưng tấy hậu môn, tái tạo các mô bị tổn thương.</p>\n<p>- Lactokine (nhập khẩu từ Đức): Chiết xuất từ Protein sữa, giúp giảm viêm, giảm kích ứng niêm mạc.</p>\n<p>- Hamamelis Virginiana Water (chiết xuất Phỉ): Có tác dụng tăng sức bền thành mạch, ngăn ngừa sự thoái hóa của mao mạch. Ngoài ra, chiết xuất Phỉ còn giúp giảm sưng, giảm đau do trĩ gây ra.</p>\n<p>- ABS Ginger Mint Extract Cooling PF (nhập khẩu từ Mỹ): Chứa chiết xuất Gừng và chiết xuất Bạc hà, mang lại cảm giác dễ chịu, giảm đau và giảm ngứa rát khó chịu.</p>\n<p> </p>\n<p>2. Công dụng của Gel Trimax</p>\n<p>Gel bôi da, giúp: dưỡng ẩm da, làm mềm da, làm dịu đi vùng da bị khô rát, nứt nẻ, sưng, nóng đỏ, ngứa rát khó chịu… cho làn da mềm mại, khỏe mạnh hơn. Góp phần cải thiện độ đàn hồi cho da, kích thích tái tạo tế bào da mới.</p>\n<p> </p>\n<p>3. Cách dùng: Lấy một lượng gel vừa đủ bôi vào vùng cần cải thiện. Sử dụng 2 lần/ngày</p>\n<p> </p>\n<p>Bảo quản: Nơi khô mát, tránh ánh nắng trực tiếp.</p>\n<p> </p>\n<p>4. Đối tượng sử dụng</p>\n<p>Người bị trĩ</p>\n<p>Người bị sưng, nóng, ngứa rát, nứt hậu môn.</p>\n<p> </p>\n<p>Xuất xứ: Việt Nam</p>\n<p>Hạn sử dụng: 3 năm kể từ ngày sản xuất</p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/f7/45/2c/afa8341a5dffb9551f23d71d57dcf645.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f7/45/2c/afa8341a5dffb9551f23d71d57dcf645.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f7/45/2c/afa8341a5dffb9551f23d71d57dcf645.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f7/45/2c/afa8341a5dffb9551f23d71d57dcf645.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f7/45/2c/afa8341a5dffb9551f23d71d57dcf645.png"},{"base_url":"https://salt.tikicdn.com/ts/product/37/df/c5/abbcfadd80ee4fd5082ea8d7f4e68f75.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/37/df/c5/abbcfadd80ee4fd5082ea8d7f4e68f75.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/37/df/c5/abbcfadd80ee4fd5082ea8d7f4e68f75.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/37/df/c5/abbcfadd80ee4fd5082ea8d7f4e68f75.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/37/df/c5/abbcfadd80ee4fd5082ea8d7f4e68f75.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/3d/f8/74/dd885d462e6d7da31fea6fc823bca3ec.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/3d/f8/74/dd885d462e6d7da31fea6fc823bca3ec.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/3d/f8/74/dd885d462e6d7da31fea6fc823bca3ec.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3d/f8/74/dd885d462e6d7da31fea6fc823bca3ec.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3d/f8/74/dd885d462e6d7da31fea6fc823bca3ec.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/45/0f/76/99581c71fd44707c93b1539e463d641a.jpg","is_gallery":true,"label