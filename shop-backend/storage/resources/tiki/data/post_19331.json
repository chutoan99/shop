e":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":true,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":7,"review_text":"(7)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/21/be/c5/9fed6fe3313ed0807f34d8fdc1c2f0cf.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1370,"all_time_quantity_sold":18,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/41/fd/90/cd8e117752c63b71847dcbf5c0fc7c20.jpg\" alt=\"Loa Gaming 2.0 JBL Quantum Duo - Hàng Chính Hãng\" width=\"750px\" height=\"1336px\" /\u003e\u003c/p\u003e\n\u003ch3\u003eDriver kim loại Neodymium 63.5mm, tạo trường âm thanh chân thực\u003c/h3\u003e\n\u003cp\u003e\u003cstrong\u003eLoa Gaming 2.0 JBL Quantum Duo\u003c/strong\u003e cho trải nghiệm âm thanh sống động từ tiếng bước chân mong manh đến những pha cháy nổ khốc liệt nhờ công nghệ âm thanh JBL QuantumSOUND Signature đưa mọi cảnh game hoành tráng hơn và mỗi game thủ quyền năng cạnh tranh hơn. Driver kim loại Neodymium lớn 63.5mm cùng loa tần số cao riêng biệt mang đến chất âm sắc sảo, được tinh chỉnh bởi chuyên gia JBL và được thiết kế dành riêng cho game thủ.\u003c/p\u003e\n\u003cp\u003eCông nghệ âm thanh độc quyền của JBL kết hợp với công nghệ từ Dolby Digital kiến tạo trường âm chân thực đến khó tin. Hết mình với game để thêm chiến thắng vì không có tiếng động nào có thể thoát khỏi được đôi tai bạn.\u003c/p\u003e\n\u003ch3\u003eTrải nghiệm âm thanh chi tiết, tùy chỉnh hiệu ứng ánh sáng\u003c/h3\u003e\n\u003cp\u003eKhông để lọt một viên đạn, tiếng bước chân trên sỏi cát hay tiếng hát của dòng sông nhờ âm thanh chi tiết đáng kinh ngạc cùng âm bass mạnh mẽ đầy uy lực - là tất cả những gì JBL nói về công nghệ âm thanh của họ được ẩn chứa trong loa JBL Quantum Duo Gaming.\u003c/p\u003e\n\u003cp\u003eNgoài ra, sản phẩm còn thổi hồn vào không gian chơi game với hiệu ứng ánh sáng cực ngầu đưa bạn đi sâu hơn vào hành động. Loa JBL Quantum Duo Gaming mang tới những bộ cài đặt ánh sáng khác nhau cùng những họa tiết bắt mắt. Đổi phong cách theo tâm trạng với chỉ một nút điều khiển.\u003c/p\u003e\n\u003ch3\u003eKết nối bluetooth 5.0 cực nhạy và ổn định\u003c/h3\u003e\n\u003cp\u003eLoa JBL Quantum Duo sử dụng kết nối bluetooth 5.0 có tốc độ kết nối nhanh và ổn định. Nhờ vậy mà bạn có thể kết nối với loa một cách nhanh chóng, sử dụng ổn định ở khoảng cách xa hơn. Sở hữu loa JBL Quantum Duo Gaming, bạn sẽ không còn phải bận tâm về việc cắm/rút dây mỗi lần kết nối.\u003c/p\u003e\n\u003cp\u003eSử dụng giao tiếp Bluetooth, loa có thể kết nối với laptop, smartphone hay tablet mà không cần dây. Chỉ cần vài thao tác cài đặt đơn giản là liên kết giữa loa và thiết bị sẽ hình thành. Đồng thời, ở những lần sau, kết nối sẽ tự động thiết lập để người dùng. \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/21/be/c5/9fed6fe3313ed0807f34d8fdc1c2f0cf.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/21/be/c5/9fed6fe3313ed0807f34d8fdc1c2f0cf.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/21/be/c5/9fed6fe3313ed0807f34d8fdc1c2f0cf.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/21/be/c5/9fed6fe3313ed0807f34d8fdc1c2f0cf.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/21/be/c5/9fed6fe3313ed0807f34d8fdc1c2f0cf.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/13/be/44/6c926e3fcbf36bf7b738595adde80d07.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/13/be/44/6c926e3fcbf36bf7b738595adde80d07.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/13/be/44/6c926e3fcbf36bf7b738595adde80d07.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/13/be/44/6c926e3fcbf36bf7b738595adde80d07.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/13/be/44/6c926e3fcbf36bf7b738595adde80d07.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/a6/c7/b1/270a30e80bd0dabd3d8a6eeb50b7529b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a6/c7/b1/270a30e80bd0dabd3d8a6eeb50b7529b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a6/c7/b1/270a30e80bd0dabd3d8a6eeb50b7529b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a6/c7/b1/270a30e80bd0dabd3d8a6eeb50b7529b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a6/c7/b1/270a30e80bd0dabd3d8a6eeb50b7529b.jpg"}