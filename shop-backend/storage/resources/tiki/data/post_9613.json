56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.5,"review_count":22,"review_text":"(22)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/39/0e/bd/170fa57a279ea42a58c68abb5d9f1155.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":227,"all_time_quantity_sold":151,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eChuông cửa không dây, không dùng pin, chống nước Linbell G1\u003c/strong\u003e\u003cstrong\u003e Linptech\u003c/strong\u003e là một bước đột phá về sản phẩm công nghệ chuông cửa không dây. Sản phẩm này vừa có khả năng học lệnh thông minh, nút nhấn còn chống nước và hoàn hảo hơn là không sử dụng pin trong toàn bộ quá trình hoạt động.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/a1/8a/ad/6dea535e7bc2b733916d0fc556fc3692.png\" alt=\"\" width=\"720\" height=\"605\" /\u003e\u003c/p\u003e\n\u003cp\u003eTương tự như các loại chuông không dây khác, chuông cửa không dây thông minh Linptech cũng được thiết kế gồm 2 bộ phận chính: chuông báo và nút bấm. Nút nhấn của chuông được thiết kế hình vuông với các viền cạnh được uống cong lại rất hiên đại và sang trọng.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/48/9e/27/3dbe58162ea3a1c484d8eaac5b5c02cd.jpg\" alt=\"\" width=\"720\" height=\"720\" /\u003e\u003c/p\u003e\n\u003cp\u003ePhần chuông báo cũng có thiết kế hình vuông với 3 nút bấm là tăng giảm âm lượng, tùy chỉnh kiểu chuông và nút tắt chuông. Nút nhấn này có chức năng tắt chuông khi bạn không cần sử dụng đến. Tránh trường hợp người khác làm phiền bạn nhưng lúc không cần thiết. Ba nút bấm được đặt bên trong 1 hình tròn có viền phát sáng vào ban đêm rất đẹp mắt và tiện dụng.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/2b/cc/4c/a4142ac6daf3f3380ca5aa316e88c199.jpg\" alt=\"\" width=\"720\" height=\"505\" /\u003e\u003c/p\u003e\n\u003cp\u003ePhần nút bấm thì có khả năng chống nước rất hiệu quả và tiện lợi. Nút bấm chuông này đã được nhà máy thử nghiệm chất lượng về độ bền và độ đàn hồi. Một nút bấm có thể ấn được khoảng 200.000 lần. Như vậy mỗi ngày bấm 28 lần thì bạn có thể sử dụng bộ chuông này trong suất 20 năm. Đặc biệt là bạn không cần phải lo nghĩ nút bấm bị liệt hay bị ảnh hưởng bởi nước.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch3\u003eTính năng và ưu điểm của sản phẩm:\u003c/h3\u003e\n\u003cp\u003eChuông được thiết kế bền đẹp và sang trọng, sử dụng chất liệu nhựa ABS cao cấp. Linh kiện mạch điện tử bên trong chuông được sử dụng là loại cao cấp nhất.\u003c/p\u003e\n\u003cp\u003eTích hợp chức năng học lệnh bạn có thể kết hợp \u003cspan style=\"color:#ff0000\"\u003e\u003cstrong\u003enhiều nút bấm với một chuông báo\u003c/strong\u003e\u003c/span\u003e hoặc \u003cstrong\u003e\u003cspan style=\"color:#ff0000\"\u003enhiều chuông báo với một nút bấm. \u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003ePhần chuông báo thì cắm điện 220V, phần nút bấm thì k cần cung cấp bất kì một nguồn năng lượng nào an toàn tuyệt đối khi sử dụng.\u003c/p\u003e\n\u003cp\u003eSản phẩm này được sử dụng rộng rãi trong các hộ gia đình, trường học, nhà máy,\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThông số kỹ thuật:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/80/d3/de/f697ff24e3ee18d363cea81ebba68f2e.png\" alt=\"\" width=\"720\" height=\"720\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/2f/e3/94/92e4e2905c7bd1627fb8a78fbcd9d05e.png\" alt=\"\" width=\"720\" height=\"505\" /\u003e\u003c/p\u003e\n\u003ch3\u003eTại sao bạn nên dùng chuông cửa không dây, không dùng pin, chống nước cao Linbell G1\u003c/h3\u003e\n\u003cul\u003e\u003cli\u003eCông nghệ xanh không sử dụng pin, giảm ô nhiễm môi trường.\u003c/li\u003e\u003cli\u003eDễ dàng lắp đặt chỉ cần gắn nút bấm ngoài cửa, chuông báo có thể cắm vào bất kỳ ổ điện nào trong nhà rất thuận tiện.\u003c/li\u003e\u003cli\u003eKhoảng cách kết nối giữa các thiết bị lên đến 50m xuyên qua tường, cửa kim loại.\u003c/li\u003e\u003cli\u003eTuổi thọ trung bình lên đến 20 năm với 200.000 lần bấm\u003c/li\u003e\u003cli\u003eSản phẩm chống thấm nước chịu được môi trường mưa gió quanh năm.\u003c/li\u003e\u003cli\u003eCó thể kết hợp nhiều nút nhấn, nhiều chuông báo hoạt động cùng lúc nhờ tính năng học lệnh.\u003c/li\u003e\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/39/0e/bd/170fa57a279ea42a58c68abb5d9f1155.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/39/0e/bd/170fa57a279ea42a58c68abb5d9f1155.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/39/0e/bd/170fa57a279ea42a58c68abb5d9f1155.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/39/0e/bd/170fa57a279ea42a58c68abb5d9f1155.jpg","thumb