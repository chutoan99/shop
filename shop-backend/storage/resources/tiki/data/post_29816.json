w_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/bb/3e/c8/2ecb0967e41358ddad377bb34008b58f.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":44,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003carticle class=\"4ever-article\"\u003e\n\u003cp\u003eTÍNH NĂNG\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cdiv\u003eMặt trước mở theo chiều dọc với ngăn chứa laptop 15.6\" chuyên dụng (chỉ có trên size cabin)\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv\u003eKhả năng mở rộng tăng sức chứa\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv\u003eNội thất tổ chức phong phú, tinh tế với nhiều ngăn và túi\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv\u003eHệ thống bánh xe đôi xoay 360 có bạc đạn tăng cường sự êm nhẹ khi di chuyển\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv\u003eCần đẩy ống kép tích hợp làm từ aluminum chất lượng cao\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv\u003eKhóa số TSA an toàn tiêu chuẩn Hoa Kỳ\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv\u003eKhóa kéo đôi SafePlux chống trộm\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv\u003eLớp lót làm từ chất liệu tái chế RPET được in họa tiết của Timothy Goodman\u003c/div\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eMÔ TẢ SẢN PHẨM\u003c/p\u003e\n\u003cp\u003eToiis M là bộ sưu tập với cấu trúc mới của Gia đình Toiis. Thiết kế mở \"flat top\" cùng với khả năng mở rộng cho phép vali có độ sâu tối đa để dễ dàng sắp xếp hành lý. Bộ sưu tập vali Toiis M được trang bị hệ thống bánh xe đôi có bạc đạn tiêu chuẩn cao, giúp loại bỏ lực cản ma sát và tạo sự trơn tru khi di chuyển. Vali cũng có khóa kéo an toàn chống trộm để bảo vệ an toàn cho hành lý của bạn. Những tính năng thiết yếu tốt đáng ngạc nhiên này chắc chắn vượt qua sự mong đợi của du khách.\u003c/p\u003e\n\u003cp\u003eLớp lót bên trong của Toiis M được làm bằng vật liệu RPET và được in họa tiết là tác phẩm nghệ thuật của Timothy Goodman về chủ đề bảo vệ môi trường. Tác phẩm thú vị và ý nghĩa này là sự đề cao tuyệt vời cho toàn bộ vali.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eTHÔNG SỐ KỸ THUẬT\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/product/ce/bf/e8/073e074af4ca13109b39b23778392c98.png\" alt=\"cebfe8ba13c899032926d7c2e3156dc0.png\" /\u003e\u003c/p\u003e\n\u003c/article\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/bb/3e/c8/2ecb0967e41358ddad377bb34008b58f.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/bb/3e/c8/2ecb0967e41358ddad377bb34008b58f.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/bb/3e/c8/2ecb0967e41358ddad377bb34008b58f.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/bb/3e/c8/2ecb0967e41358ddad377bb34008b58f.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/bb/3e/c8/2ecb0967e41358ddad377bb34008b58f.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/c3/ed/8d/99d1f86ba611a29574853aeb72f7b43e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c3/ed/8d/99d1f86ba611a29574853aeb72f7b43e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c3/ed/8d/99d1f86ba611a29574853aeb72f