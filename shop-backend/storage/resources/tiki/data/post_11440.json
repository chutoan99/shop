on_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":82000,"discount_rate":26,"rating_average":4.8,"review_count":13,"review_text":"(13)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/79/81/6c/cbf7078820d328a30527b1724e71ab07.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1255,"all_time_quantity_sold":68,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<h1 style=\"text-align:center;\"> </h1>\n<h2 style=\"text-align:justify;\"><span style=\"color:#333399;\">CÔNG DỤNG CỦA VIÊN UỐNG GIẢI ĐỘC GAN, HẠ MEN GAN GOLDLIVER</span></h2>\n<ul><li style=\"text-align:justify;\">\n<p>Hỗ trợ tăng cường chức năng gan, giải độc gan, cải thiện các triệu chứng viêm gan virus, men gan cao.</p>\n</li>\n<li style=\"text-align:justify;\">\n<p>Hỗ trợ làm chậm sự phát triển của xơ gan.</p>\n</li>\n<li style=\"text-align:justify;\">\n<p>Bảo vệ gan, ngăn ngừa viêm gan.</p>\n</li>\n<li style=\"text-align:justify;\">\n<p>Thúc đẩy tái tạo gan khỏe mạnh.</p>\n</li>\n</ul><h1 style=\"text-align:center;\"><span style=\"color:#333399;\"><strong>VIÊN UỐNG GIẢI ĐỘC GAN, HẠ MEN GAN, CHỐNG VIÊM GAN, XƠ GAN GOLDLIVER</strong></span></h1>\n<p><img style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/2c/c4/e8/14ec59002e3da57c015693c997a9e2c2.jpg\" alt=\"\" width=\"720\" height=\"720\" /><img style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/49/2a/6a/db0108aaaf48de034879563eb6396999.jpg\" alt=\"\" width=\"720\" height=\"720\" /><img style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/2f/fa/77/f8f8fc9c99f2fce3afbb7dd1307224f5.jpg\" alt=\"\" width=\"720\" height=\"720\" /><img style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/e5/81/4e/45fb65dfbe756b9545c20c6dcf73f50d.jpg\" alt=\"\" width=\"720\" height=\"720\" /></p>\n<p> </p>\n<h2 style=\"text-align:justify;\"><span style=\"color:#333399;\"><strong>THÀNH PHẦN CỦA VIÊN UỐNG HẠ MEN GAN, GIẢI ĐỘC GAN, CHỐNG VIÊM GAN, XƠ GAN GOLDLIVER</strong></span></h2>\n<ul><li>\n<p><span style=\"color:#333399;\"><strong>Phosphocomplex (chiết xuất Kế sữa)</strong></span>: từ nhà sản xuất Gnosis (Italia), chứa khoảng 30% Silybin, hoạt chất mạnh nhất trong nhóm Silymarin kết hợp với công nghệ phytosom. Nhờ công nghệ này, Phosphocomplex có độ hấp thu (sinh khả dụng) cao hơn gấp 10 lần so với Silybin (Silymarin) thông thường.</p>\n</li>\n<li>\n<p><span style=\"color:#333399;\"><strong>Cao Cà gai leo</strong></span>: là vị thuốc nam có tác dụng tốt trong bệnh viêm gan B, được chứng minh lâm sàng tại Viện quân y 103, 354. Ngoài việc làm giảm nồng độ virus viêm gan trong máu, một số công trình nghiên cứu tại Viện Dược liệu Trung ương cũng đã chứng minh Cà gai leo giúp ngăn ngừa xơ gan tiến triển, giải độc gan, tăng cường chức năng gan, hạn chế tối đa tổn thương tế bào gan do virus.</p>\n</li>\n<li>\n<p><span style=\"color:#333399;\"><strong>Alpha Lipoic Acid</strong></span>: là chất chống oxy hóa mạnh, giúp tăng cường nồng độ Glutathion trong gan, nhờ đó tăng cường khả năng giải độc và bảo vệ tế bào gan.</p>\n</li>\n<li>\n<p><span style=\"color:#333399;\"><strong>Novasol Curcumin</strong></span>: chống viêm mạnh và giải độc tế bào gan.</p>\n</li>\n</ul><h2 style=\"text-align:justify;\"> </h2>\n<h2 style=\"text-align:justify;\"><span style=\"color:#333399;\"><strong>MÔ TẢ SẢN PHẨM</strong></span></h2>\n<ul><li style=\"text-align:justify;\">\n<p>Hộp thủy tinh 30 viên.</p>\n</li>\n</ul><h2 style=\"text-align:justify;\"> </h2>\n<h2 style=\"text-align:justify;\"><span style=\"color:#333399;\"><strong>ĐỐI TƯỢNG SỬ DỤNG </strong></span></h2>\n<h3 style=\"text-align:justify;\"><span style=\"color:#333399;\"><em>Viên uống bảo vệ gan, giải độc gan, hỗ trợ giảm triệu chứng viêm gan, xơ gan GoldLiver dùng trong các trường hợp:</em></span></h3>\n<ul><li style=\"text-align:justify;\">\n<p>Người bị suy giảm chức năng gan do viêm gan virus, viêm gan mạn tính, xơ gan.</p>\n</li>\n<li style=\"text-align:justify;\">\n<p>Người bị men gan cao, vàng da, mệt mỏi, đau tức hạ sườn phải.</p>\n</li>\n</ul><h2 style=\"text-align:justify;\"> </h2>\n<h2 style=\"text-align:justify;\"><span style=\"color:#333399;\"><strong>CÁCH DÙNG</strong></span></h2>\n<ul><li style=\"text-align:justify;\">\n<p>Trường hợp viêm gan, men gan cao: dùng 1 viên/lần x 3 lần/ngày trong tuần đầu tiên và dùng 1 viên/lần x 2 lần/ngày trontrong 3 tuần tiếp theo.</p>\n</li>\n<li style=\"text-align:justify;\">\n<p>Bảo vệ gan, phòng ngừa viêm gan virus: dùng 1 viên/lần x 1 lần/ngày.</p>\n</li>\n<li style=\"text-align:justify;\">\n<p>Khuyến cáo nên sử dụng đủ liệu trình 3 hộp để cảm nhận đầy đủ hiệu quả sản phẩm.</p>\n</li>\n</ul><h2 style=\"text-align:justify;\"> </h2>\n<h2 style=\"text-align:justify;\"><span style=\"color:#333399;\"><strong>CHÚ Ý</strong></span></h2>\n<ul><li style=\"text-align:justify;\">\n<p>Thực phẩm này không phải là thuốc và không có tác dụng thay thế thuốc chữa bệnh.</p>\n</li>\n<li style=\"text-align:justify;\">\n<p>Không dùng cho người mẫn cảm với bất kỳ thành phần nào của sản phẩm.</p>\n</li>\n<li style=\"text-align:justify;\">\n<p>Không dùng cho phụ nữ có thai, hoặc đang cho con bú.</p>\n</li>\n</ul><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/79/81/6c/cbf7078820d328a30527b1724e71ab07.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/79/81/6c/cbf7078820d328a30527b1724e71ab07.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/79/81/6c/cbf7078820d328a30527b1724e71ab07.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/79/81/6c/cbf7078820d328a30527b1724e71ab07.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/79/81/6c/cbf7078820d328a30527b1724e71ab07.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/db/33/d7/6f6cfe2ae33a436a009b11d992151349.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/db/33/d7/6f6cfe2ae33a436a009b11d992151349.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/db/33/d7/6f6cfe2ae33a436a009b11d992151349.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/db/33/d7/6f6cfe2ae33a436a009b11d992151349.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/db/33/d7/6f6cfe2ae33a436a009b11d992151349.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/49/2a/6a/6c556107e9c0010922dabe2bc139c08c.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/49/2a/6a/6c556107e9c0010922dabe2bc139c08c.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/49/2a/6a/6c556107e9c0010922dabe2bc139c08c.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/49/2a/6a/6c556107e9c0010922dabe2bc139c08c.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/49/2a/6a/6c556107e9c0010922dabe2bc139c08c.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/2f/fa/77/b2b646b0402b313ac986465d64063cf3.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/2f/fa/77/b2b646b0402b313ac986