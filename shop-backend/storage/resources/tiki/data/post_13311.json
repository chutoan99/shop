"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/c8/46/b6/49983600a2b2ab5074302060add5efe6.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1975,"all_time_quantity_sold":20,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eNón bảo hiểm SUNDA 227 là phiên bản mũ 3/4 phân khúc cao cấp của thương hiệu mũ bảo hiểm SUNDA, được thiết kế dành cho người đầu to hoặc hơi lớn (chu vi size đầu phù hợp từ 57 tới 61cm có thể đội vừa).\u003c/p\u003e\n\u003cp\u003eNón được thiết kế với các đường gân bao xung quanh mũ, kèm phần ốp kính 2 bên khá lớn, và phần cửa gió phía trên chính giữa vừa có tác dụng là cửa gió, vừa là điểm nhấn tạo nên sự mạnh mẽ, khỏe khoắn cho người đôi.\u003c/p\u003e\n\u003cp\u003eNón có lỗ thông gió phía trên đỉnh mũ có thể đóng mở để tạo sự thông thoáng cho người đội khi cần di chuyển trong thời gian dài, ko gây cảm giác bí bách khó chịu.\u003c/p\u003e\n\u003cp\u003eChất liệu hạt nhựa ABS , chống va đập, xuyên thủng rất tốt.\u003c/p\u003e\n\u003cp\u003eKính mũ chống lóa, độ bền tốt, độ đàn hồi tốt.\u003c/p\u003e\n\u003cp\u003eLớp vải lót của mũ có khả năng kháng khuẩn, hút ẩm tốt, có thể tháo rời để giặt hoặc vệ sinh\u003c/p\u003e\n\u003cp\u003eKhóa dây quai chất lượng cao, bền bỉ, chịu lực mạnh, độ dài linh hoạt.\u003c/p\u003e\n\u003cp\u003eLớp mút xốp cứng, được thiết kế bám sát vào vỏ mũ nên dễ dàng phân tán lực khi có va đập.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThông tin thương hiệu:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eMũ bảo hiểm SUNDA được sản xuất bởi Công Ty TNHH LongHuei Việt Nam, là một công ty sản xuất mũ bảo hiểm với gần ba mươi năm kinh nghiệm phục vụ cho thị trường quốc tế. Các nhãn hiệu mũ của công ty tại Việt Nam: ZEUS, ANDES, SUNDA, CROMO. Trong đó các thương hiệu như ANDES, CROMO đã trở nên rất phổ biến trên thị trường.\u003c/p\u003e\n\u003cp\u003eLong Huei là công ty tại Việt Nam có phòng thử nghiệm hiện đại, đạt tiêu chuẩn quốc tế, nhằm đảm bảo chất lượng sản phẩm đáp ứng các tiêu chuẩn an toàn của Việt Nam và quốc tế trước khi đến với người tiêu dùng.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e*** Hướng dẫn xác định cỡ mũ phù hợp:\u003c/strong\u003e Vòng 1 sợi dây quanh đầu, phía trên lông mày và tai khoảng 2cm. Xiết sợi dây sao cho ôm vừa đủ thoải mái lấy đầu và ghi lại số đo đó. Lặp lại như vậy để tìm được số đo mà bạn thấy đầu dễ chịu. Đó chính là size đầu của bạn. So sánh với kích cỡ mũ để lựa chọn size mũ phù hợp.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/69/5b/d8/9b48781496b797b0e010864e0c9a887d.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/69/5b/d8/9b48781496b797b0e010864e0c9a887d.jpg\" alt=\"\" width=\"750\" height=\"749\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/9a/a5/7c/93617dcf9ba7746b843e08680b03dbaf.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/9a/a5/7c/93617dcf9ba7746b843e08680b03dbaf.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/b3/5b/bd/060ed393c75e348b25846339b953cc2f.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/b3/5b/bd/060ed393c75e348b25846339b953cc2f.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/3c/3f/2c/435d1b7969e2d2cdcac93a7f570d14cc.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/3c/3f/2c/435d1b7969e2d2cdcac93a7f570d14cc.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/f9/ab/d8/8dab6a8485562c20040257a3a6f3f651.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/f9/ab/d8/8dab6a8485562c20040257a3a6f3f651.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/c6/2b/4b/146df7436307389a911eefe5de57d557.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/c6/2b/4b/146df7436307389a911eefe5de57d557.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/c8/46/b6/49983600a2b2ab5074302060add5efe6.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c8/46/b6/49983600a2b2ab5074302060add5efe6.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c8/46/b6/49983600a2b2ab5074302060add5efe6.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c8/46/b6/49983600a2b2ab5074302060add5efe6.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c8/46/b6/49983600a2b2ab5074302060add5efe6.png"},{"base_url":"https://salt.tikicdn.com/ts/product/85/74/dc/82e3d6b29eb5a6e124007c97b7aaa221.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/85/74/dc/82e3d6b29eb5a6e124007c97b7aaa221.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/85/74/dc/82e3d6b29eb5a6