iscount":0,"discount_rate":0,"rating_average":4.8,"review_count":50,"review_text":"(50)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/c1/fd/96/6683ae0d73dc6d6e5227f66e6d5be635.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2753,"all_time_quantity_sold":615,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"color: #ff6600; font-size: medium;\"\u003e\u003cstrong\u003ePhương Pháp Giáo Dục Montessori - Thời Kỳ Nhạy Cảm Của Trẻ\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eTừ lúc bé cất tiếng khóc chào đời cho đến khi biết đi, biết nói, biết viết… tất cả đều bắt đầu từ con số 0. Trẻ đã làm thế nào để hoàn thành những “nhiệm vụ bất khả thi” ấy, để thích ứng với thế giới phức tạp này?\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eMontessori\u003c/strong\u003e từng nói: “Những đứa trẻ trải qua thời kì nhạy cảm đang nhận sự “chỉ huy” từ một mệnh lệnh thần kì trong vô thức, ngay cả tâm hồn bé nhỏ của chúng cũng nhận được sự khích lệ”.Trong quá trình phát triển từ 0~6 tuổi, trẻ chịu sự chi phối của sức sống nội tại, ở một giai đoạn nào đó sẽ vô cùng chú ý tới những đặc trưng của sự vật trong một môi trường nào đó, đồng thời không ngừng lặp lại quá trình thực tiễn. Sau khi thuận lợi vượt qua thời kì nhạy cảm, trí tuệ của trẻ sẽ được nâng lên một tầm cao mới.\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eThời kì nhạy cảm không chỉ là giai đoạn quan trọng cho việc học tập của trẻ mà còn ảnh hưởng đến sự phát triển tâm hồn và tính cách của chúng. Do vậy, các bậc phụ huynh nên tôn trọng những hành động mà tự nhiên đã ban tặng cho trẻ, đồng thời đưa ra những định hướng cần thiết, giúp trẻ không bỏ lỡ cơ hội duy nhất này.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/c1/fd/96/6683ae0d73dc6d6e5227f66e6d5be635.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c1/fd/96/6683ae0d73dc6d6e5227f66e6d5be635.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c1/fd/96/6683ae0d73dc6d6e5227f66e6d5be635.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c1/fd/96/6683ae0d73dc6d6e5227f66e6d5be635.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c1/fd/96/6683ae0d73dc6d6e5227f66e6d5be635.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/e6/1a/10/32f73b1789df00bdd9e53c96d2035d92.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e6/1a/10/32f73b1789df00bdd9e53c96d2035d92.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e6/1a/10/32f73b1789df00bdd9e53c96d2035d92.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e6/1a/10/32f73b1789df00bdd9e53c96d2035d92.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e6/1a/10/32f73b1789df00bdd9e53c96d2035d92.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/eb/fd/28/308b185b3d47124811559fcd5bdd8c9d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/eb/fd/28/308b185b3d47124811559fcd5bdd8c9d.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/eb/fd/28/308b185b3d47124811559fcd5bdd8c9d.jpg","position":null,"small_url":"