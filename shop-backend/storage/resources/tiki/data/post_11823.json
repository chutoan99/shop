cdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/af/a3/24/0a0022b586b33e07848fd62851f93af1.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1587,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p>Thang rút nhôm Sumika SK 380 rất thích hợp cho cả trong nhà, ngoài trời, một trong nhiều những lợi ích của thang rút nhôm đó chính là thiết kế cho phép chiều dài thang được tùy chỉnh đơn giản bằng cách dùng tay kéo ra các phần cần thiết.</p>\n<p><img src=\"https://salt.tikicdn.com/ts/tmp/af/a3/24/7c183bf5e5097d1cace6d491ffdf2bba.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p> Vì vậy, cho dù là bạn đang cố gắng với lên tới tủ bếp hoặc cắt tỉa cây mọc ở trong vườn, chiếc thang sáng tạo này có thể sẽ giúp bạn vượt qua thử thách dễ dàng.</p>\n<p><img src=\"https://salt.tikicdn.com/ts/tmp/ed/67/ee/706994269cf7bdbf06d31196e392bd7f.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p><img style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/e8/35/19/eb6d72c1ff4fffeadf755767e3a0cf75.jpg\" alt=\"\" width=\"750\" height=\"1125\" /></p>\n<p> </p>\n<p>Với chiều cao tối đa là <strong>3,8m</strong> gồm 13 bậc, thang không những sử dụng hữu ích trong gia đình mà còn được dùng cả trong các công trình, nhà máy xí nghiệp. Chiều dài rút gọn của thang nhôm rút giá rẻ chỉ <strong>0,81m</strong> và nặng 11kg sẽ giúp bạn dẽ dàng di chuyển đến bất kì vị trí nào cần sử dụng, trên bất kì phương tiện nào như xe máy, ôtô Bên cạnh đó, thang có thể cất giữ sau khi sử dụng ở bất kì vị trí nào trong căn nhà của bạn mà không mất quá nhiều diện tích, ảnh hưởng đến không gian sống của khách hàng.</p>\n<p> </p>\n<p><img style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/59/2a/0b/7abf8415df4242c7b6bc4a810640cb59.jpg\" alt=\"\" width=\"750\" height=\"500\" /></p>\n<p> </p>\n<p>Điểm nối bật của chiếc thang rút nhôm giá rẻ SK380 chính là chịu được trọng tải tiêu chuẩn từ 150kg và tối đa lên đến 300kg tạo cảm giác an toàn cho bạn trong quá trình thực hiện công việc trên một độ cao nhất định.</p>\n<p> </p>\n<p><img style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/9b/eb/bb/774b1b78def015878c1979a6714a59f2.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p> </p>\n<h3>Hướng dẫn cách sử dụng thang rút nhôm giá rẻ SK 380 đúng cách.</h3>\n<h4>Bước 1: Cách kéo dài thang</h4>\n<div> </div>\n<div>1. Tháo chốt giữ định hình của thang</div>\n<div>2. Tiếp theo:</div>\n<ul>\n<li>Đặt thang trên bề mặt thẳng</li>\n<li>Đặt chân trên bậc thang dưới cùng để giữ thang cố định trước khi leo lên cao</li>\n<li>Dùng 2 tay kéo móc nối của thanh thứ 3 từ dưới lên</li>\n<li>Đảm bảo mỗi bậc thang đã được kéo đến mức tối đa và được cố định chốt khóa an toàn</li>\n<li>Tùy vào độ cao bạn mong muốn phù hợp với công việc mà kéo số lượng bậc thang.</li>\n</ul>\n<h4>Bước 2: Cách gấp thang</h4>\n<ul>\n<li>Giữ lấy thang bằng các móc nối dưới thanh thang mà bạn đang mở chốt</li>\n<li>Đặt 2 ngón tay cái trên chốt mà bạn đang định tháo ra</li>\n<li>Đặt những ngón tay còn lại của bạn dưới móc nối ( nếu bạn đặt bên trên móc nối bạn có thể bị kẹp giữa các thanh)</li>\n<li>Đồng thời, đóng chốt cùng một lúc tới khi thanh trước kéo xuống</li>\n<li>Lặp lại như vậy với các bậc thang còn lại.</li>\n</ul>\n<div> </div>\n<h4>Bước 3: Đóng thang</h4>\n<ul>\n<li>Để chắc chắn thang đã được đóng chặt và đảm bảo an toàn người sử dụng nên kiểm tra lại chốt giữ định hình thang. </li>\n<li>Tuyệt đối không kéo thang bằng thanh vì thang có thể được mở và gây thương tích cho người sử dụng cũng như thang sẽ nhanh bị hỏng.</li>\n<li> </li>\n</ul>\n<p><strong>* Thông số kĩ thuật:</strong></p>\n<p>Thang nhôm rút gọn SUMIKA<br />Model: SK380<br />- Kích thước 81x50x10 cm<br />- Chiều cao tối đa 3.8m<br />- Chiều dài rút gọn 0.81m<br />- Trọng lượng 11 kg<br />- Số bậc: 13 bậc<br />- Chất liệu: Nhôm<br />- Độ dày nhôm: 1,2-1,5 mm<br />- Tải trọng 150kg-300kg, tiêu chuẩn EN131</p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/af/a3/24/0a0022b586b33e07848fd62851f93af1.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/af/a3/24/0a0022b586b33e07848fd62851f93af1.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/af/a3/24/0a0022b586b33e07848fd62851f93af1.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/af/a3/24/0a0022b586b33e07848fd62851f93af1.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/af/a3/24/0a0022b586b33e07848fd62851f93af1.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/ed/67/ee/78ab4b07f417d0c3632ae86b37613dd6.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ed/67/ee/78ab4b07f417d0c3632ae86b37613dd6.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ed/67/ee/78ab4b07f417d0c3632ae86b37613dd6.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ed