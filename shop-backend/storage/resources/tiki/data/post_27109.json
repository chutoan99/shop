_reason"}},"discount":15000,"discount_rate":5,"rating_average":5,"review_count":3,"review_text":"(3)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/a6/92/91/ed489a20ef77ca00d299ce76ad5a2cde.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":650,"all_time_quantity_sold":77,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp class=\"N5VAH-\"\u003e CÙNG CON BƯỚC VÀO MÔI TRƯỜNG GIÁO DỤC HIỆN ĐẠI, VĂN MINH CÙNG \"TRUYỆN CỔ TÍCH TỬ TẾ\"\u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003e \u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003eLần đầu tiên, tại Lionbooks,\u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003e Những câu truyện cổ tích kinh điển với tuổi đời hàng trăm năm được kể lại một cách rất khác!\u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003e Một cuốn sách được ra đời với tư tưởng giáo dục tiên tiến, hiện đại, cùng với nền giáo dục văn minh hàng đầu thế giới; được cải biên bởi chuyên gia khai vấn phụ huynh và tâm lý trẻ em người Việt có chứng chỉ cấp quốc tế!\u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003e Một cuốn sách phá kỉ lục với chi phí đầu tư về minh họa, trau chuốt từng chi tiết. Mang lại phần nhìn ấn tượng, mãn nhãn, nuôi dưỡng và nâng cao gu thẩm mỹ của cả gia đình.\u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003e \u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003e TRUYỆN CỔ TÍCH TỬ TẾ là tuyển tập các chuyện cổ tích kinh điển được cải biên bởi Nhà khai vấn phụ huynh và tâm lý trẻ em Alicia Vu. Các câu chuyện được viết với theo góc nhìn hiện đại, nhân văn, không có nhân vật phản diện, trẻ không cần sợ hãi nhưng vẫn nhận được những bài học sâu sắc. Tất cả đến từ sự thấu hiểu trẻ em, tôn trọng trẻ em như một người trưởng thành thực thụ: chịu trách nhiệm với việc mình làm, tôn trọng người khác, tự lập, kiên trì để đạt được mục đích,...\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/9e/37/c2/380e6d69d07eff2c997c1705201e0a95.jpg\" alt=\"\" width=\"750\" height=\"882\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/16/9c/1c/f1ea8ffd1d2e71ef3607f318bcdab677.jpg\" alt=\"\" width=\"750\" height=\"886\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/30/87/b2/99d40684351033899c0b15a935587085.jpg\" alt=\"\" width=\"750\" height=\"887\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/30/da/56/69cd6a32ad3848b7f02cda817276c033.jpg\" alt=\"\" width=\"750\" height=\"882\" /\u003e\u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003eVới cách truyền đạt mới, bài học mới được gửi gắm trong từng câu chuyện, chúng tôi tin rằng, mỗi em bé được lớn lên trong một môi trường giáo dục dám nghĩ - dám làm - dám chịu trách nhiệm - dám trao đi đều sẽ trở thành những công dân toàn cầu: tự tin với sức mạnh nội tại, giàu lòng nhân ái và khí chất của sự tử tế, nhân văn!\u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003e—-----------------------------\u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003e Thông tin chi tiết về sản phẩm “Truyện cổ tích Tử Tế”:\u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003e- Sách định dạng bìa cứng chắc chắn, có áo bìa chỉn chu.\u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003e- Sách dày gần 100 trang với 4 câu chuyện cổ tích được viết mới, song ngữ Việt - Anh: Ba Chú Heo Con, Cô Bé Quàng Khăn Đỏ, Cô Bé Bán Diêm, Hai Anh Em và Ngôi Nhà Bánh Gừng; đi kèm là các chú thích, hướng dẫn đọc sách dành cho ba mẹ; trò chơi tương tác cho các em bé.\u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003e- Quét mã QR trên trang bìa để bước vào thế giới 3D của các nhân vật.\u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003e \u003c/p\u003e\n\u003cp class=\"N5VAH-\"\u003e THÔNG TIN CHI TIẾT\u003c/p\u003e\