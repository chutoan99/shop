adge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":6,"review_text":"(6)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/8b/41/8c/738a880309df5d2641bf8fc48236b61a.jpeg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":993,"all_time_quantity_sold":13,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: center;\"\u003e\u003cstrong\u003eNhiệt Kế Điện Tử Hồng Ngoại Đo Trán, Đo cơ Thể Cho Bé Và Người Lớn loại Cao Cấp Có Đèn- Hàng Chính Hãng\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cstrong\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/8b/41/8c/3e7d784a7ef53d4c574d0cad29da7692.jpeg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003e \u003c/p\u003e\n\u003cp\u003eNhiệt Kế Điện Tử Hồng Ngoại Đo Trán, Đo cơ Thể Cho Bé loại Cao Cấp Có Đèn\u003c/p\u003e\n\u003cp\u003eNhiệt kế hồng ngoại Infrared thermometer một trong những dòng sản phẩm không thể thiếu trong mỗi gia đình có con nhỏ vì tính đa năng của nó đem lại với nhiều tiện ích sau.\u003cbr /\u003eƯu điểm : Máy đo nhiệt kế hồng ngoại dùng rất đơn giản và nhanh chóng\u003cbr /\u003eĐể ý chiều lắp pin theo cực âm dương sau đó thấy màn hình sáng đèn là máy đã hoạt động. Bạn chỉ việc đưa máy vào gần trán bé và ấn nút là máy sẽ báo nhiệt độ rồi ạ\u003cbr /\u003eĐể đo nhiệt độ phòng, không khí hay nước cho bé tắm bạn nhấn và dữ nút (1) bên tay trái sau đó chỉ việc để ngần nhấn nút là máy sẽ báo nhiệt độ trong phòng , hay nhiệt độ của nước cho bé rồi ạ.\u003cbr /\u003eMáy sẽ tự động tắt lên trong vài giây lên bạn không cần lo tốn pin nhé.\u003cbr /\u003eGIỚI THIỆU VỀ NHIỆT KẾ THÔNG MINH HỒNG NGOẠI\u003cbr /\u003eSản phẩm là nhiệt kế hồng ngoại thông minh, sử dụng cảm biến nhiệt hiện thị thông tin kết quả trên màn hình LCD nhanh chóng, giúp các mẹ phát hiện con trẻ bị sốt hay không nhanh gọn chỉ trong vòng 1 giây.\u003cbr /\u003eHiển thị nhanh chóng kết quả trên màn hình chỉ trong vòng 1 giây.\u003cbr /\u003eGhi nhớ 32 lần đo liên tiếp giúp các mẹ theo dõi nhiệt độ con trẻ chi tiết hơn.\u003cbr /\u003eThao tác sử dụng dễ dàng thuận tiện, đặc biệt phù hợp cho các gia đình có trẻ nhỏ.\u003cbr /\u003eBáo sốt bằng âm thanh và ánh sáng chính xác\u003cbr /\u003eNhiệt độ cơ thể chế độ: 32 Độ. C-42.5 Deg. C\u003cbr /\u003eBề mặt đối tượng chế độ nhiệt độ: 0 Độ. C-100 Deg. C\u003cbr /\u003eNhiệt độ môi trường: 10 Deg. C-40 Deg. C\u003cbr /\u003eĐộ chính xác: +/-0.2 Deg. C\u003cbr /\u003eĐo thời gian: ít hơn 1 thứ hai\u003cbr /\u003eTự động tắt máy thời gian: 15 giây\u003cbr /\u003eĐo khoảng cách: 3-5 cm\u003cbr /\u003eLoại pin: 2 x pin AAA (không bao gồm\u003cbr /\u003eNhiệt Kế Hồng Ngoại – Cách Phát Hiện Trẻ Bị Sốt Chỉ Trong 1s.\u003cbr /\u003eNhiệt kế đã từ lâu là một dụng cụ y tế rất quen thuộc và thiết yếu trong mỗi gia đình, đặc biệt là với các gia đình có trẻ em thì nhiệt kế là một trợ lý vô cùng hữu hiệu khi cần kíp. \u003cbr /\u003eHiểu được nỗi lo lắng và nhằm đáp ứng nhu cầu của quý khách hàng, đã quyết định ra mắt thị trường Nhiệt kế điện tử hồng ngoại .\u003cbr /\u003eSản phẩm nhiệt kế điện tử hồng ngoại thông minh được thiết kế sử dụng cảm biến nhiệt độ siêu nhạy và hiển thị trực tiếp nhiệt độ đo được thông qua một màn hình LCD trong khoảng 0,5s. Nên các bậc cha mẹ có con nhỏ hoàn toàn có thể yên tâm về chất lượng cao cấp và độ bền sản phẩm trên 5 năm.\u003cbr /\u003eCác bậc cha mẹ dùng đo nhiệt độ cho trẻ và mọi người một cách dễ dàng ở trên trán, phía sau gáy, hoặc các bộ phận trên cơ thể, nhiệt đô đo được sẽ hiển thị nhanh chóng và chính xác nhất.\u003cbr /\u003eThông số kỹ thuật của Nhiệt Kế Hồng Ngoại Điện Tử :\u003cbr /\u003eTên sản phẩm: Nhiệt kế hồng ngoại Infrared\u003cbr /\u003eChất liệu: Nhựa ABS\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/8b/41/8c/738a880309df5d2641bf8fc48236b61a.jpeg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/8b/41/8c/738a880309df5d2641bf8fc48236b61a.jpeg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/8b/41/8c/738a880309df5d2641bf8fc48236b61a.jpeg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8b/41/8c/738a880309df5d2641bf8fc48236b61a.jpeg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8b/41/8c/738a880309df5d2641bf8fc48236b61a.jpeg"},{"base_url":"https://salt.tikicdn.com/ts/product/d7/42/06/0618a5fb304ddc918100cdd23e5fb2ed.jpeg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d7/42/06/0618a5fb304ddc918100cdd23e5fb2ed.jpeg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d7/42/06/0618a5fb304ddc918100cdd23e5fb2ed.jpeg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d7/42/06/0618a5fb304ddc918100cdd23e5fb2ed.jpeg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d7/42/06/0618a5fb304ddc918100cdd23e5fb2ed.jpeg"},{"base_url":"https://s