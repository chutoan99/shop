olor":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":187000,"discount_rate":18,"rating_average":4.7,"review_count":58,"review_text":"(58)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/da/85/85/9bf7caed6d77581cde69588f511a7bfd.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2070,"all_time_quantity_sold":190,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p style=\"box-sizing: border-box; margin: 0px 0px 8.5px; padding: 0px; color: #333333; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 15px; text-align: justify;\">Thời tiết thay đổi thất thường, các bệnh lý về đường hô hấp gia tăng. Máy xông khí dung sẽ là trợ thủ đắc lực giúp bạn kiểm soát sức khỏe đường hô hấp dễ dàng, là phương pháp điều trị hiệu quả, kinh tế và tiện lợi nhất cho gia đình bạn.</p>\n<p style=\"box-sizing: border-box; margin: 0px 0px 8.5px; padding: 0px; color: #333333; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 15px; text-align: justify;\"><strong style=\"box-sizing: border-box; margin: 0px; padding: 0px;\">Máy xông mũi họng Omron NE-C101</strong> là dòng sản phẩm mới nhất được thiết kế đẹp mắt, sang trọng và nhỏ gọn rất thuận tiện cho bạn mang theo. Sản phẩm được cung cấp bởi công ty thiết bị y tế Hải Nam.</p>\n<h2 style=\"box-sizing: border-box; margin: 17px 0px 8.5px; padding: 0px; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-weight: 500; line-height: 1.1; color: #666666; font-size: 25px; text-align: justify;\"><span style=\"box-sizing: border-box; margin: 0px; padding: 0px; font-size: 14pt;\"><strong style=\"box-sizing: border-box; margin: 0px; padding: 0px;\">Ưu điểm vượt trội của máy xông mũi họng NE-C101:</strong></span></h2>\n<ul>\n<li>Thiết kế mới nhất, nhỏ gọn, tiện lợi, máy chạy an toàn, dễ sử dụng.</li>\n<li>Hiệu quả điều trị cao.</li>\n<li>Độ bền cao</li>\n<li>Chất liệu của phụ kiện kèm theo máy đều là những sản phẩm chất lượng cao, tuyệt đối an toàn khi sử dụng cho trẻ nhỏ.</li>\n<li>Cốc thuốc với dung lượng 12ml giúp người sử dụng có thể pha lượng thuốc hoặc kháng sinh phù hợp với tình trạng bệnh của mỗi người.</li>\n<li>Phụ kiện máy đầy đủ: gồm 2 mask ( người lớn và trẻ em), 1 cốc đựng thuốc, 1 càng xông họng, 1 càng xông mũi , 2 miếng lọc khí, dây dẫn khí, hướng dẫn sử dụng, phiếu bảo hành</li>\n</ul>\n<ul style=\"box-sizing: border-box; margin: 20px 0px 0px; padding: 0px; list-style: none; float: left; width: 920px; color: #666666; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 15px; text-align: justify;\">\n<li style=\"box-sizing: border-box; margin: 0px; padding: 0px 0px 0px 10px; float: left; width: 920px; position: relative;\"><strong style=\"font-size: 14pt; box-sizing: border-box; margin: 0px; padding: 0px;\">Thông số kỹ thuật của máy khí dung Omron NE-C101:</strong></li>\n</ul>\n<p> </p>\n<p> </p>\n<ul>\n<li>Nguồn điện: 230V, 50Hz</li>\n<li>Điện tiêu thụ: 150VA</li>\n<li>Tốc độ xông : ~0,3 ml/phút</li>\n<li>Kích thước hạt: ~3,9 micron</li>\n<li>Dung lượng cốc thuốc : 12 ml.</li>\n<li>Kích thước máy: 145(rộng) x 182 (dài) x 124 (dầy) mm</li>\n<li>Trọng lượng: ~1050 g ( chỉ bao gồm máy nén khí)</li>\n</ul><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/da/85/85/9bf7caed6d77581cde69588f511a7bfd.jpg","