l,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/21/38/69/f7d869398386fd0ca5f2bf2e13fa1770.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":412,"all_time_quantity_sold":23,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch1 class=\"nameproduct\" style=\"text-align:center;\"\u003eTương Miso giảm muối Marukome Ryotei hộp 375g\u003c/h1\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/16/20/9f/7d2937c35151e5099d48abe10d624e08.jpg\" alt=\"\" width=\"750\" height=\"562\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch1 class=\"nameproduct\" style=\"text-align:center;\"\u003eTương Miso Marukome vị truyền thống hộp 750g\u003c/h1\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/18/8c/66/e0fb6b4fd1f4b99ffa790d27c6cf0ff9.jpg\" alt=\"\" width=\"750\" height=\"562\" /\u003e\u003c/p\u003e\n\u003cp\u003eMiso là một loại nước sốt truyền thống của Nhật Bản được làm bằng cách lên men đậu nành với muối và koji (nấm Aspergillus oryzae ) và đôi khi có cả gạo, lúa mạch, hoặc một số thành phần khác. Kết quả của quá trình lên men đó là tạo thành một miếng ván dày sử dụng tạo thành nước sốt “gây nghiện”, có thể dùng với các loại thịt, đặc biệt là ăn kèm với mì Soba, đây là loại gia vị vô cùng thiết yếu trong ẩm thực Nhật Bản.\u003c/p\u003e\n\u003cp\u003eChứa hàm lượng protein cao, giàu vitamin và khoáng chất , miso đóng vai trò rất quan trọng trong thời phong kiến Nhật Bản bởi độ dinh dưỡng chứa trong nó .\u003c/p\u003e\n\u003cp\u003eCàng để lâu thì Miso sẽ càng thơm ngon hơn và dấy lên hương vị lôi cuốn mỗi khi dùng kèm với các món ăn kết hợp.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/82/b8/b3/12325c03bca265df49f4a9c208b5b850.jpg\" alt=\"\" width=\"750\" height=\"562\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eHướng dẫn sử dụng:\u003c/strong\u003e\u003c/p\u003e\n\u003col\u003e\n\u003cli\u003e    Nước sốt salad: Trộn miso trắng với ít giấm gạo, dầu oliu và mù tạt sẽ tạo ra một món rưới cực ngon\u003c/li\u003e\n\u003cli\u003e    Súp: Nấu món súp từ miso (hòa tan miso trong nước nóng trước khi cho vào nồi súp của bạn. Tốt nhất là cho vào lúc nhấc nồi ra khỏi bếp chứ đừng nấu miso trên bếp.\u003c/li\u003e\n\u003cli\u003e    Dùng để ướp thực phẩm: Trộn miso sẫm màu với gừng, tiêu đen và vài giọt giấm , một ít mật đường để tạo thành một thức ướp chay rất tuyệt vời.\u003c/li\u003e\n\u003cli\u003e    Cho vào trà hoặc là thay thế cà phê: Rót 1 cốc nước ấm và trộn một thìa hoặc nửa thìa miso vào nước và thưởng thức. Nếu bạn thấy khó để hòa tan miso trong một cốc đầy thì hãy cho vào một ít nước quấy tan miso rồi cho nước vào sau.\u003c/li\u003e\n\u003cli\u003e    Dùng như là một loại nước chấm: Trộn tỏi, hành, miso, bơ vừng, nước chanh và thì là tạo thành một món nước chấm ngon tuyệt.\u003c/li\u003e\n\u003c/ol\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/90/d7/46/762417c545c22bd2dd904e665b2e323a.jpg\" alt=\"\" width=\"500\" height=\"399\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eHạn sử dụng:\u003c/strong\u003e Xem trên bao bì sản phẩm\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eXuất xứ:\u003c/strong\u003e Nhật bản\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/21/38/69/f7d869398386fd0ca5f2bf2e13fa1770.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/21/38/69/f7d869398386fd0ca5f2bf2e13fa1770.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/21/38/69/f7d869398386fd0ca5f2bf2e13fa1770.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/21/38/69/f7d869398386fd0ca5f2bf2e13fa1770.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/21/38/69/f7d869398386fd0ca5f2bf2e13fa1770.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/82/b8/b3/cd675d83aa86f08f8e4923e6dc03f3ad.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/82/b8/b3/cd675d83aa86f08f8e4923e6dc03f3ad.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/82/b8/b3/cd675d83aa86f08f8e4923e6dc03f3ad.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/82/b8/b3/cd675d83aa86f08f8e4923e6dc03f3ad.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/82/b8/b3/cd675d83aa86f08f8e4923e6dc03f3ad.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/16/20/9f/df5590b596ec4ac894a87495a68dbfc5.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/16/20/9f/df5590b596ec4ac894a87495a68dbfc5.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/16/20/9f/df5590b596ec4ac894a87495a68dbfc5.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/16/20/9f/df5590b596ec4ac894a87495a68dbfc5.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/16/20/9f/df5590b596ec4ac894a87495a68dbfc5.jpg"}