ef":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.8,"review_count":105,"review_text":"(105)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/b7/91/07/580cf86cb88dfb743e390f246cdd9cca.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1533,"all_time_quantity_sold":633,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003e\u003cstrong\u003eViên nấu Cà ri kiểu Nhật Kobe Bussan 200g\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003e\u003cstrong\u003eXuất xứ: Nội địa Nhật Bản\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eQuy cách: Hộp nấu đc 10-12 phần ăn\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/5b/19/50/9a4137ad1e71220ab5d606ffe9cc7847.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/strong\u003e\u003cstrong\u003eThành phần:\u003c/strong\u003e Bột mì, bột cà ri, dầu thực vật, dầu thảo mộc, đường, muối, tinh bột, gia vị \u003c/p\u003e\n\u003cp\u003eNhắc đến cà ri mọi người thường nghĩ ngay đến ẩm thực Ấn Độ (quốc gia được biết đến với món cà ri ngon trứ danh). Nhưng không chỉ có cà ri Ấn Độ mới làm nức lòng thực khách làng ẩm thực. Cà ri Nhật Bản hay cụ thể hơn là cơm cà ri là một món ăn ngon và nổi tiếng không kém có tên gọi là Karēraisu.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/product/1f/d3/85/15de25e7d11343dbcddb1abcc09598be.jpg\" alt=\"\" width=\"600\" height=\"450\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003eHầu hết các gia đình người Nhật sử dụng viên gia vị nấu cà ri đủ loại được bán sẵn trong các siêu thị hoặc các cửa hàng tiện lợi ở Nhật. Loại gia vị này rất đa dạng về mùi vị, độ ngọt, độ cay…tuỳ theo khẩu vị ưa thích từng người.\u003cbr /\u003eViên nấu cà ri này cũng giúp mọi người có thể thưởng thức được món cà ri đúng chuẩn Nhật Bản ở mọi nơi, vô cùng tiện lợi.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/product/77/0b/e3/f68c5ae9680ada88d42c5e66c1a174c2.jpg\" alt=\"\" width=\"600\" height=\"450\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eCari Nhật Bản có màu vàng đặc trưng của món cà ri truyền thống và tùy loại cà ri cũng như hương liệu cấu thành nên hương vị mà màu vàng có thể thay đổi đậm hay nhạt. Thực khác thường có thể nhận ra món Cari Nhật Bản ngay vì sự khác biệt về cách dùng cũng như hình dáng. Đối với cà ri truyền thống chúng ta sẽ được phục vụ bằng 1 tô cà ri nóng hổi thơm phức và dùng kèm là bánh mì hoặc bún. Nhưng với Cari Nhật Bản chúng ta sẽ được phục vụ hoàn toàn khác, một đĩa đầy ắp cà ri phủ lên phần cơm trắng mịn sẽ làm cho chúng ta cảm thấy háo hức để có thể thưởng thức ngay món Cari Nhật Bản ngon lành này.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/product/23/d7/b4/6b87d55fdcf1c2ffe24d11543ff0e3d1.jpg\" alt=\"\" width=\"600\" height=\"401\" /\u003e\u003c/p\u003e\n\u003cp\u003eSự hấp dẫn của món cơm cà ri không chỉ được tạo nên bởi cách chế biến và nguồn nguyên liệu mà nó còn nhờ vào phương pháp thưởng thức. Khi ăn cơm cà ri, trên bàn ăn của người Nhật luôn được bày biện thêm những chén tsuke-mono. Tsuke-mono là dưa muối được làm từ nhiều loại nguyên liệu rau củ khác nhau được trộn chung với nước tương, đường và  mirin.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/product/25/5e/fe/18c55aa1fa7b33c3e9bf7037a861794f.jpg\" alt=\"\" width=\"600\" height=\"450\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eHướng dẫn sử dụng:\u003c/strong\u003e\u003c/p\u003e\n\u003col\u003e\n\u003cli\u003eĐặt nồi lên bếp, bật lửa vừa, cho 1 thìa canh dầu ăn hoặc dầu ô liu vào.\u003c/li\u003e\n\u003cli\u003eThả hành vào xào qua, sau đó lần lượt thả cà rốt, khoai tây, đảo đều tay.\u003c/li\u003e\n\u003cli\u003eThả thịt vào xào cùng đến khi thịt chín sơ (không còn màu hồng)\u003c/li\u003e\n\u003cli\u003eCho 400 – 450 ml nước vào nồi, đun lửa vừa đến khi sôi thì vớt bọt ra.\u003c/li\u003e\n\u003cli\u003eĐậy nắp, vặn nhỏ lửa, ninh trong khoảng 15 – 20 phút.\u003c/li\u003e\n\u003cli\u003eTắt bếp, thả 2 viên cà ri vào nồi, khuấy nhẹ đến khi cà ri tan ra.\u003c/li\u003e\n\u003cli\u003eBật lại bếp, để lửa nhỏ, đun thêm khoảng 10 phút đến khi nước sốt hơi đặc và sánh.\u003c/li\u003e\n\u003cli\u003eCho cơm ra đĩa, múc sốt cà ri lên cơm, ăn nóng.\u003c/li\u003e\n\u003c/ol\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cdiv\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/product/da/81/8e/6074ca0baaa7a840fa2f245031361fad.jpg\" alt=\"Tbavir_simg_627d6a_541x361_max.jpg\" width=\"541\" height=\"361\" /\u003e\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/b7/91/07/580cf86cb88dfb743e390f246cdd9cca.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b7/91/07/580cf86cb88