"rating_average":5,"review_count":4,"review_text":"(4)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/2e/ea/44/7abd72c8c3b0b5cdd7f412c93e7b391d.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2277,"all_time_quantity_sold":7,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/05/9c/f7/bf951b6c5cd3cb716f811ec3c899c3e2.jpg\" alt=\"Quạt Đứng Toshiba F-LSD30(W)VN - Trắng - Hàng chính hãng\" width=\"750\" height=\"584\" /\u003e\u003c/p\u003e\n\u003ch5\u003eThiết kế nhỏ gọn\u003c/h5\u003e\n\u003cp\u003e\u003cstrong\u003eQuạt Đứng Toshiba F-LSD30(W)VN \u003c/strong\u003esở hữu thiết kế hiện đại kết hợp màu sắc tinh tế phù hợp với nhiều không gian nội thất. Đặc biệt, kiểu dáng cao gọn, không chiếm quá nhiều diện tích giúp bạn vừa có được không khí mát mẻ và vẫn đảm bảo sự gọn gàng, tiện dụng. Màn hình hiển thị bằng LED chiếu sáng dễ nhìn, tiện lợi cho mọi người sử dụng ngay cả vào ban đêm. Màn hình sẽ tự động tắt sau 30 giây, không gây chói mắt vào ban đêm.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/53/14/ef/5953421b4971b62c689588883e13647c.jpg\" alt=\"\" width=\"750\" height=\"415\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ae/5b/00/dc44ddd0de46f35545d5bf553387b903.jpg\" alt=\"\" width=\"750\" height=\"415\" /\u003e\u003c/p\u003e\n\u003ch5\u003eLuồng gió mạnh mẽ, vận hành êm ái\u003c/h5\u003e\n\u003cp\u003eCánh quạt được thiết kế độc đáo từ 7 – 9 cánh tạo luồng gió mạnh mẽ giúp thổi gió mát và xa hơn cho bạn tận hưởng cảm giác thoải mái ở bất cứ không gian nào phù hợp sử dụng trong gia đình có diện tích lớn hoặc lắp đặt tại quán ăn, café… F-LSD30(W)VN sử dụng động cơ vận hành êm ái, không tạo ra tiếng ồn khó chịu đồng thời được làm từ chất liệu cao cấp nên động cơ có tính bền bỉ cao.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/d5/e3/7c/ac36b56af984ab7343b3457b6732b9fa.jpg\" alt=\"\" width=\"750\" height=\"415\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/87/8b/93/a0fd723111d1033cf28b53bc5f54e622.jpg\" alt=\"\" width=\"750\" height=\"415\" /\u003e\u003c/p\u003e\n\u003ch5\u003eCông nghệ Inverter\u003c/h5\u003e\n\u003cp\u003eQuạt Toshiba được thiết kế cánh quạt độc đáo cùng động cơ DC Inverter tiên tiến mạnh mẽ giúp luồng gió thổi mạnh hơn, xa hơn nhưng vận hành vẫn nhẹ nhàng, êm ái. Với đỉnh cao chất lượng Nhật Bản, quạt Toshiba tiết kiệm điện tối ưu nhờ động cơ DC sử dụng dòng điện một chiều có giao thoa điện từ cực nhỏ giúp tiết kiệm đến 70% điện năng.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/fd/0d/e4/71260bb1808205df1c9b789d5ad7c477.jpg\" alt=\"\" width=\"750\" height=\"415\" /\u003e\u003c/p\u003e\n\u003ch5\u003e4 chế độ quạt thông minh\u003c/h5\u003e\n\u003cp\u003eSản phẩm được trang bị 3 chế độ quạt thông minh giúp người dùng dễ dàng lựa chọn chế độ phù hợp: \u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eChế độ Natural / Tự nhiên: Tạo ra luồng khó thay đổi tăng giảm liên tục, mô phỏng gió tự nhiên giúp tạo cảm giác dễ chịu.\u003c/li\u003e\n\u003cli\u003eChế độ Sleep / Ngủ: Luồng gió tạo ra sẽ giảm dần sau 1 giờ về mức gió nhẹ, giúp bạn không bị lạnh, đảm bảo giấc ngủ ngon.\u003c/li\u003e\n\u003cli\u003eChế độ Quite / Tĩnh lặng: Tạo luồng gió thổi ở chế độ êm nhất cho bạn không gian yên tĩnh.\u003c/li\u003e\n\u003cli\u003eChế độ Comfort / Thoải mái: Dựa vào cảm biến nhiệt độ, quạt sẽ tự động tăng giảm lượng gió để tạo cảm giác thoải mái nhất.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/20/57/05/d426996b64c6c692cf639390d40bd2bc.jpg\" alt=\"\" width=\"750\" height=\"415\" /\u003e\u003c/p\u003e\n\u003ch5\u003eChế độ hẹn giờ tiện lợi\u003c/h5\u003e\n\u003cp\u003eQuạt có bảng điều khiển có đèn LED hiện đại, dễ thao tác và quan sát. Khi vừa khởi động, quạt sẽ hoạt động theo đúng các chế độ cài đặt trước khi tắt. Đặc biệt, trang bị thêm chế độ hẹn giờ đến 12 tiếng giúp người dùng chủ động hơn trong thời gian sử dụng quạt, nhất là vào ban đêm. Hơn thế nữa, sản phẩm kèm theo remote điều khiển từ xa tiện lợi.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/0c/ff/b4/16a613ca36150bedd6710afad190e5cb.jpg\" alt=\"\" width=\"750\" height=\"415\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/2e/ea/44/7abd72c8c3b0b5cdd7f412c93e7b391d.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/2e/ea/44/7abd72c8c3b0b5cdd7f412c93e7b391d.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/2e/ea/44/7abd72c8c3b0b5cdd7f412c93e7b391d.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2e/ea/44/7abd72c8c3b0b5cdd7f412c93e7b391d.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2e/ea/44/7abd72c8c3b0b5cdd7f412c93e7b391d.png"},{"base_url":"https://salt.tikicdn.com/ts/product/ce/de/28/4b2d55174bb40d1d2b3d58d018c47243.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ce/de/28/4b2d55174bb40d1d2b3d58d018c47243.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ce/de/28/4b2d55174bb40d1d2b3d58d018c47243.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ce/d