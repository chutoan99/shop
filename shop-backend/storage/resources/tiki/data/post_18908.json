}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":631000,"discount_rate":36,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/49/e2/81/f06d8062eaf3d92cfefeeead0e706f5c.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":267,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align:center;\"\u003e\u003cspan style=\"color:#993366;\"\u003e\u003cstrong\u003eXe tập đi bốn bánh cho người già có ghế ngồi, có giỏ đựng đồ, gấp gọn khi không sử dụng, chính hãng Nikita\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e\u003cspan style=\"color:#000000;\"\u003eXe tập đi có bánh lăn được thiết kế cổ điển với phanh vòng dễ khóa tiên tiến mang đến sự hỗ trợ và ổn định giúp việc đi lại dễ dàng hơn\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e\u003cspan style=\"color:#000000;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ae/d8/92/503bba8e694e1852e84411c56a7eb48e.JPG\" alt=\"\" width=\"705\" height=\"705\" /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003eTHÔNG SỐ\u003c/p\u003e\n\u003cp\u003e- Thương hiệu: Nikita\u003c/p\u003e\n\u003cp\u003e- Kích thước nệm: 40 x 30 x 5cm (Dài x Rộng x Cao)\u003c/p\u003e\n\u003cp\u003e- Chiều cao đệm đến mặt đất: 50cm\u003c/p\u003e\n\u003cp\u003e-  Chiều cao sản phẩm: 80-90cm (có thể điều chỉnh)\u003c/p\u003e\n\u003cp\u003e- Kích thước đóng gói: 78 x 60 x 22cm (Dài x Rộng x Cao)\u003c/p\u003e\n\u003cp\u003e- Khối lượng: 10kg\u003c/p\u003e\n\u003cp\u003e- Trọng lượng: 120kg\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/f6/1e/87/54b935fe49535d950e04c222a35c8c5b.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eƯU ĐIỂM SẢN PHẨM\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e-  Khung xe được làm bằng hợp kim nhôm chống rỉ sét, bền chắc và đẹp\u003c/p\u003e\n\u003cp\u003e- Có giỏ đựng đồ dễ dàng mang theo thức ăn, thuốc, điện thoại và nhiều thứ khác.\u003c/p\u003e\n\u003cp\u003e- Thiết kế có phanh cho người tập đi giúp người yếu vịn đi có thể phanh lại khi cần thiết, nhằm đảm bảo an toàn khi sử dụng. Hai phanh hãm 2 bên bánh sau giúp xe đứng yên khi không cần di chuyển.\u003c/p\u003e\n\u003cp\u003e- Chiều cao tay cầm có thể điều chỉnh kích thước, giúp người sử dụng có thể đặt nó ở độ cao phù hợp nhất cho bản thân giúp làm giảm căng thẳng cho các khớp ở cổ tay, lưng và chân.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/c4/60/ff/a51dff22bb7fe548d0674f952b711e35.JPG\" alt=\"\" width=\"681\" height=\"680\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/a0/7d/74/8970667d8b348d6e4eaa32f5adb3447f.JPG\" alt=\"\" width=\"671\" height=\"667\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/97/f8/ff/59b6dc6c84a781d4714449a14c77c60b.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e- Ghế và tựa lưng có đệm cho phép người dùng ngồi và nghỉ ngơi thoải mái bất cứ khi nào cần thiết.\u003c/p\u003e\n\u003cp\u003e- Ghế lật có phần tựa lưng có mang đến cho bạn một nơi nghỉ ngơi thoải mái.\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/27/ae/2f/53ef0af17373d3156f410d3297067b2b.JPG\" alt=\"\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/77/08/6e/a6d31689a1d5cb35f8864af103d460d5.JPG\" alt=\"\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/45/43/28/2aa804e9773a8c59d47bbaa8c6fef778.JPG\" alt=\"\" width=\"707\" height=\"707\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/27/ae/2f/f02431d6d300b956d40b307e360355f2.JPG\" alt=\"\" width=\"0\" height=\"0\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/45/43/28/b586cb7fac90542ade5711ade870afb4.JPG\" alt=\"\" width=\"0\" height=\"0\" /\u003e\u003c/p\u003e\n\u003cp\u003eNIKITA - CHÚNG TÔI CAM KẾT:\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eBảo hành: 12 tháng\u003c/li\u003e\n\u003cli\u003eChăm sóc \u0026amp; tư vấn trọn đời sau thời gian bảo hành.\u003c/li\u003e\n\u003cli\u003eHình đúng với hàng nhận, đảm bảo chất lượng sản phẩm như cam kết.\u003c/li\u003e\n\u003cli\u003eSau khi nhận hàng NẾU SẢN PHẨM CÓ LỖI quý khách có quyền yêu cầu ĐỔI TRẢ - BẢO HÀNH 1 ĐỔI 1 hoặc\u003c/li\u003e\n\u003cli\u003eQuý khách hoàn toàn yên tâm khi mua sắm với chúng tôi.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eQUÝ KHÁCH LƯU Ý: Khi nhận hàng nếu không hài lòng về chất lượng sản phẩm xin đừng vội đánh giá, hãy liên hệ ngay với SHOP để được hỗ trợ.\u003c/p\u003e\n\u003cp\u003eSỰ HÀI LÒNG CỦA KHÁCH HÀNG LUÔN LÀ MỤC TIÊU HƯỚNG ĐẾN CỦA SHOP\u003c/p\u003e\n\u003cp\u003e#xe_day_tap#dung_cu_ho_tro_di_chuyen,#dung_cu_ho_tro_phuc_hoi_chuc_nang, #xe_tap_di, ghe_tap_di, #khung_tap_di\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e\u003cspan style=\"color:#000000;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/27/ae/2f/b7ca7c89e506980c51279daaf0836aa0.JPG\" alt=\"\" width=\"0\" height=\"0\" /\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/49/e2/81/f06d