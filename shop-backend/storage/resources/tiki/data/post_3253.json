.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.7,"review_count":9,"review_text":"(9)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/2a/43/fe/49c71b79e1cff157c004e28035d2a313.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":0,"all_time_quantity_sold":83,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cspan\u003e\u003cstrong\u003e\u003cspan\u003e\u003cspan style=\"font-size: medium; color: #008ab7;\"\u003e\u003cstrong\u003eGel Lô Hội Nature Republic Soothing \u0026amp; Moisture Aloe Vera 92% Soothing Gel (300ml)\u003c/strong\u003e\u003c/span\u003e\u003cbr /\u003e\u003c/span\u003e\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\r\n\u003cp\u003e\u003cstrong\u003e\u003cstrong\u003e\u003cspan\u003eGel Lô Hội Nature Republic Soothing \u0026amp; Moisture Aloe Vera 92% Soothing Gel (300ml) \u003c/span\u003e\u003c/strong\u003e\u003c/strong\u003echứa 92% tinh chất lô hội có tác dụng làm mát da, cung cấp nước cho da. Đồng thời bổ sung Vitamin và các dưỡng chất giữ ẩm giúp làm mát và làm mềm dịu da. Sử dụng Nature Republic Soothing \u0026amp; Moisture Aloe Vera 92% Soothing Gel giúp bạn có được làn da mịn màng, tươi trẻ và móng tay, móng chân chắc khỏe hơn.\u003c/p\u003e\r\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Gel Lô Hội Nature Republic Soothing \u0026amp; Moisture Aloe Vera 92% Soothing Gel (300ml)\" src=\"http://tikicdn.com/media/catalog/product/a/l/aloe_small_-500x500.jpg\" alt=\"Gel Lô Hội Nature Republic Soothing \u0026amp; Moisture Aloe Vera 92% Soothing Gel (300ml)\" width=\"700\" height=\"700\" /\u003e\u003c/p\u003e\r\n\u003cp\u003e\u003cstrong\u003e\u003c/strong\u003e\u003cstrong\u003eLoại sản phẩm\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp\u003e\u003cspan\u003eNature Republic Soothing \u0026amp; Moisture Aloe Vera 92% Soothing Gel là tinh chất chiết xuất từ cây lô hội (nha đam) mang lại nhiều tác dụng trong việc dưỡng da, dưỡng tóc, dưỡng móng hiệu quả\u003c/span\u003e\u003c/p\u003e\r\n\u003cp\u003e\u003cstrong\u003eThành phần và công dụng\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp\u003e\u003cstrong\u003e\u003c/strong\u003eLô hội có tác dụng làm giảm sự lão hoá của da, chất nhầy của gel lô hội có khả năng thấm ướt, tạo ẩm độ trên da giúp da dễ đàn hồi, giảm bớt nếp nhăn, thu hẹp những mụn cơm hay mụn nhỏ khô cứng mọc trên da. Nó có tác dụng làm kín miệng và nhanh chóng làm liền vết thương do bị bỏng, vết phồng rộp, bị thương do bị côn trùng cắn và mẩn ngứa.\u003c/p\u003e\r\n\u003cp\u003e\u003cstrong\u003eLoại da phù hợp\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp\u003eSản phẩm phù hợp với mọi loại da\u003c/p\u003e\r\n\u003cp\u003e\u003cstrong\u003eHướng dẫn sử dụng\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp\u003e\u003cstrong\u003e\u003c/strong\u003e1. Mặt nạ lô hội dành cho da hỗn hợp đến da khô cung cấp nước và độ ẩm cho da: thoa một lớp dày lên da, để 20 phút rồi rửa sạch bằng nước ấm\u003c/p\u003e\r\n\u003cp\u003e2. Dùng như nước hoa hồng dạng gel giúp se khít lỗ chân lông\u003c/p\u003e\r\n\u003cp\u003e3. Dùng như gel bôi trơn cạo râu tránh bị trầy da\u003c/p\u003e\r\n\u003cp\u003e4. Gel dưỡng tóc vào mùa hè tránh việc sấy tóc làm mất nước: nên bôi phía đuôi tóc để tránh bết tóc\u003c/p\u003e\r\n\u003cp\u003e5. Thư giãn mắt: làm ướt hai miếng bông y tế hoặc bông tẩy trang, thấm gel rồi đắp lên mắt giúp ( Chú ý: tránh để dây vào mắt)\u003c/p\u003e\r\n\u003cp\u003e6. Sử dụng như kem dưỡng móng: tạo độ ẩm cho móng và độ bám màu\u003c/p\u003e\r\n\u003cp\u003e7. Bôi như bodylotion cung cấp nước: tránh cho da bị mất nước khi dùng điều hòa nhiều\u003c/p\u003e\r\n\u003cdiv class=\"right-page\"\u003e\r\n\u003cdiv class=\"prddt-wrap\"\u003e\r\n\u003cdiv id=\"ctl00_cntMain_ctl01_pnlApplication\"\u003e\r\n\u003cdiv class=\"text-left\"\u003e\u003cspan\u003e\u003cspan\u003e8. Làm dịu làn da bị cháy sau khi đi nắng hoặc tắm biển.\u003c/span\u003e\u003c/span\u003e\u003c/div\u003e\r\n\u003cdiv class=\"text-left\"\u003e\u003cspan\u003e\u003cspan\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Gel Lô Hội Nature Republic Soothing \u0026amp; Moisture Aloe Vera 92% Soothing Gel (300ml)\" src=\"http://tikicdn.com/media/catalog/product/a/l/aloe-vera-gel_02d.jpg\" alt=\"Gel Lô Hội Nature Republic Soothing \u0026amp; Moisture Aloe Vera 92% Soothing Gel (300ml)\" width=\"700\" height=\"477\" /\u003e\u003cbr /\u003e\u003c/span\u003e\u003c/span\u003e\u003c/div\u003e\r\n\u003c/div\u003e\r\n\u003c/div\u003e\r\n\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/2a/43/fe/49c71b79e1cff157c004e28035d2a313.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/2a/43/fe/49c71b79e1cff157c004e28035d2a313.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/2a/43/fe/49c71b79e1cff157c004e28035d2a313.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2a/43/fe/49c71b79e1cff157c004e28035d2a313.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2a/43/fe/49c71b79e1cff157c004e28035d2a313.jpg"},{"base_url":"https://salt.tikicd