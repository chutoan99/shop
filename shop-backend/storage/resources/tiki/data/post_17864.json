_hero":false,"return_reason":"any_reason"}},"discount":135000,"discount_rate":20,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/44/7c/80/8597f556db690005ef83eb79c5771ed7.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":735,"all_time_quantity_sold":3,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp class=\"irIKAp\"\u003eKhi mua 4 hủ Tinh nghệ vàng 100g được tặng 1 hũ cùng loại cùng size \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e-------------------------------------------------------------------------------------------------------\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Honimore là thương hiệu thuộc sở hữu của Công ty TNHH Zemlya, với hơn 40 năm kinh nghiệm trong sản xuất mật ong và tinh bột nghệ uống liền. Các sản phẩm của Honimore hiện đã có mặt ở tất cả các hệ thống siêu thị lớn của Việt Nam và nước ngoài.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Tinh bột nghệ nguyên chất Honimore 100 gam được làm từ những củ nghệ tẻ, màu vàng sáng, hoàn toàn không sử dụng chất bảo quản, chất độn và hương liệu. Trải qua quá trình loại bỏ vỏ, dầu nghệ, một số các tạp chất và thu về tinh nghệ nguyên chất cùng với hợp chất curcumin.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Tinh nghệ vàng nguyên chất được dùng nhiều trong việc chế biến các món ăn với tác dụng chữa các bệnh về gan, mật, ứ huyết, phục hồi sức khỏe sau sinh.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eI. THÔNG TIN SẢN PHẨM\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Tên sản phẩm: Tinh bột nghệ vàng nguyên chất\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Thương hiệu: Honimore\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Khu vực khai thác nghệ: ở Hưng Yên\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Thành phần: 100% tinh nghệ vàng nguyên chất\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Nhà sản xuất: Công ty TNHH Zemlya\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Quy cách đóng gói: Hũ thủy tinh.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Khối lượng: 100gr\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Hạn sử dụng: 24 tháng kể từ ngày sản xuất\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Chứng nhận Vệ sinh an toàn thực phẩm số 5331/2020/BQLATTPHCM do Ban quản lí An toàn thực phẩm TPHCM cấp ngày 15/12/2020\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Giấy kiểm nghiệm số AR-23-VD-053853-02 được cấp bởi Eurofins\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eII. ĐẶC ĐIỂM NỔI BẬT\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Tinh nghệ vàng của Honimore là loại bột nghệ uống giàu curcumin, bột nghệ mịn dễ dàng hòa tan với nước ấm. Ngày uống 2 lần là cung cấp đủ dưỡng chất cần thiết cho cơ thể, tốt cho hệ tiêu hóa và làm da trắng min, hồng hào.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Với giá thành phải chăng và hàm lượng curcumin ít hơn nghệ đỏ, phái đẹp có thể pha tinh bột nghệ với mật ong rồi thoa lên mặt trong 30 phút sẽ khiến da mịn hơn và ít thâm nám mà không lo ngại bị vàng da. Ngoài ra, đây cũng là loại tinh bột nghệ nấu ăn, giúp món ăn có màu đẹp vừa mắt.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Đối với mẹ bầu khi sử dụng bột nghệ vàng sẽ giúp hạn chế được vết rạng da ở bụng khi dùng thường xuyên.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e***CÔNG DỤNG\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eHỗ trợ cải thiện dạ dày\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eHỗ trợ làm đẹp da. Giúp da căng mịn, trắng hồng.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eTốt cho sức khỏe phụ nữ sau sinh,...\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eIII. HƯỚNG DẪN SỬ DỤNG VÀ CÁCH BẢO QUẢN\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Pha 2 muỗng cà phê với nước ấm 70°C. Khuấy đều và thưởng thức, sẽ ngon và hiệu quả hơn khi dùng với mật ong.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e***** Lưu ý: không sử dụng nước sôi 100°C.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Bảo quản nơi khô ráo, thoáng mát và luôn đậy kín, tránh ánh sáng trực tiếp. Không bảo quản lạnh.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Dùng cho người lớn và trẻ em từ 6 tuổi trở lên.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Phụ nữ mang thai và sau sinh 1 tháng đều có thể dùng được\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eLưu ý: Sản phẩm này không phải là thuốc và không có tác dụng thay thế thuốc chữa bệnh.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eIV. CAM KẾT TỪ NHÀ BÁN HÀNG\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Đổi trả hàng trong các trường hợp sản phẩm bị nhầm lẫn, bị rách hoặc bị lỗi khi nhận hàng.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Sản phẩm có Hồ sơ công bố, qua kiểm định và đạt tiêu chuẩn An toàn vệ sinh thực phẩm theo quy định về An toàn vệ sinh thực phẩm Việt Nam.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e-Tinh nghệ nguyên chất đảm bảo tiêu chí 3 KHÔNG:\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e(1) Không phụ gia – (2) Không hóa chất – (3) Không màu thực phẩm\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cdiv class=\"irIKAp\"\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"cxDtMn\"\u003e\u003cimg class=\"_0O7Vlf bgImIg\" src=\"https://down-vn.img.susercontent.com/file/vn-11134208-7r98o-lkp0i5viz4wg16\" alt=\"vn-11134208-7r98o-lkp0i5viz4wg16\" /\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/d2/26/75/b5193b5566c661ac3009a