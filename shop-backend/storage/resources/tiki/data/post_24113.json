596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":3,"review_text":"(3)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ce/93/47/6dce181619d677f349f16c52a5bce801.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1790,"all_time_quantity_sold":8,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/13/a6/bc/5044e043d9177b5d76980d24b91ce36d.jpg\" alt=\"Cây Nước Nóng Lạnh Toshiba RWF-W1830UVBV - Hàng Chính Hãng\" width=\"750\" height=\"681\" /\u003e\u003c/p\u003e\n\u003ch5\u003eThiết kế hiện đại, sang trọng\u003c/h5\u003e\n\u003cp\u003e\u003cstrong\u003eCây Nước Nóng Lạnh Toshiba RWF-W1830UVBV\u003c/strong\u003e sở hữu thiết kế sang trọng phù hợp với mọi không gian hiện đại, cung cấp nguồn nước nóng - lạnh đạt chuẩn chất lượng, an toàn cho sức khỏe người tiêu dùng. Trang bị bình nước gắn dưới tiện dụng tháo lắp bình nước chuyên dụng dễ dàng hơn.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/42/16/e7/fc5fc507f2f43b13ba785ac88a407bfb.jpg\" alt=\"\" width=\"750\" height=\"415\" /\u003e\u003c/p\u003e\n\u003ch5\u003eHệ thống làm lạnh thông minh\u003c/h5\u003e\n\u003cp\u003eSản phẩm có hệ thống làm lạnh bằng máy nén cho độ làm lạnh sâu hơn, tiết kiệm điện hơn. Với nhiệt độ làm lạnh từ ≤ 10 độ C, công suất 100W, số lít làm lạnh 2.5 lít/giờ, đảm bảo luôn có nước mát lạnh cho bạn giải khát mọi lúc. Và nhiệt độ làm nóng 85 đến 95 độ C, công suất 550W, số lít làm nóng 4 lít/giờ, cung cấp đủ nước nóng cho bạn pha trà, chế mì, pha sữa… tiện lợi.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/70/bb/66/8e55813aafc6ac5b07aa73918f05507c.jpg\" alt=\"\" width=\"750\" height=\"415\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/0f/b2/ad/7ca6b5374630905842ba8d9d8ea3148c.jpg\" alt=\"\" width=\"750\" height=\"415\" /\u003e\u003c/p\u003e\n\u003ch5\u003eChất liệu cao cấp\u003c/h5\u003e\n\u003cp\u003eSản phẩm có bình chứa bằng inox 304 thiết kế liền khối có độ bền cao, an toàn cho sức khỏe, thân thiện và không gây mùi khó chịu. Vỏ máy làm bằng nhựa ABS không phai màu, siêu bền, có khả năng chịu va đập, đặc biệt có thể chịu được nhiệt độ cao mà không gây ra phản ứng hóa học ảnh hưởng đến chất lượng nguồn nước.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/a0/24/89/fe3a05073540d6d672e8a21a9a120f02.jpg\" alt=\"\" width=\"750\" height=\"415\" /\u003e\u003c/p\u003e\n\u003ch5\u003eBảng điều khiển cảm ứng hiện đại\u003c/h5\u003e\n\u003cp\u003eMáy nước nóng được trang bị bảng điều khiển cảm ứng hiện đại, nhạy bén, chạm để tùy chỉnh chức năng dễ dàng. Máy còn có chế độ ECO dùng cây nước nóng lạnh tiết kiệm điện.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/22/30/6d/a74ff03f8231907ba20c0fce646c6534.jpg\" alt=\"\" width=\"750\" height=\"415\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/6d/15/af/9717ed291750dec21ffd11dddd3c3f96.jpg\" alt=\"\" width=\"750\" height=\"415\" /\u003e\u003c/p\u003e\n\u003ch5\u003eVòi nước nóng thiết kế khóa an toàn\u003c/h5\u003e\n\u003cp\u003eĐặc biệt, khi khóa được kích hoạt, trẻ nhỏ có táy máy bấm vào vòi, nước nóng cũng không chảy ra ngoài gây nguy hiểm cho chúng, giúp đảm bảo an toàn cho gia đình bạn hiệu quả. Cùng với khoảng cách giữa vòi và khay đựng nước đã được thiết kế hợp lý có tính toán khiến bạn dễ dàng lấy nước khi sử dụng cốc cao hay bình đựng cá nhân.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/cc/96/47/9df3b3570cc47af8094ab8ec523b64c2.jpg\" alt=\"\" width=\"750\" height=\"415\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ce/93/47/6dce181619d677f349f16c52a5bce801.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ce/93/47/6dce181619d677f349f16c52a5bce801.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ce/93/47/6dce181619d677f349f16c52a5bce801.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ce/93/47/6dce181619d677f349f16c52a5bce801.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ce/93/47/6dce181619d677f349f16c52a5bce801.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/29/ec/4d/d6fa984af0e21e87fcbfc4f249c62ed1.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/29/ec/4d/d6fa984af0e21e87fcbfc4f249c62ed1.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/29/ec/4d/d6fa984af0e21e87fcbfc4f249c62ed1.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/29/ec/4d/d6fa984af0e21e87fcbfc4f249c62ed1.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/29/ec/4d/d6fa984af0e21e87fcbfc4f249c62ed1.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/77/b7/76/a3154b11f40af284c90ccbc040e42e91.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/77/b7/76/a3154b11f40af284c90ccbc040e42e91.jpg","medium_url":"https: