null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":66150,"discount_rate":35,"rating_average":5,"review_count":10,"review_text":"(10)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/8d/29/29/490efc263d378e74b63addbf3b81d93f.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2367,"all_time_quantity_sold":113,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp class=\"MsoNormal\"\u003e\u003cspan lang=\"vi\" xml:lang=\"vi\"\u003e\u003cstrong\u003eMBA Căn Bản (Tái bản 2022)\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\"\u003eQuản trị kinh doanh không còn là lĩnh vực mới lạ, thậm chí đã phát triển lên đến đỉnh cao trong những năm gần đây. Từ những khái niệm thô sơ coi quản trị đồng nhất với quản lí, từ chỗ chỉ coi việc điều hành kinh doanh đơn thuần tập trung vào quản lí con người...; quản trị kinh doanh hay MBA hiện đã phân tách thành nhiều chuyên ngành riêng biệt, hàm chứa lượng kiến thức tổng hợp rộng lớn. Giờ đây nhắc tới quản trị kinh doanh, ta không thể không đề cập đến marketing, quản lí dự án, quản lí chiến lược, đầu tư tự doanh, tài chính, kế toán… Là một người nuôi dưỡng khát khao khởi nghiệp, hoặc muốn đưa doanh nghiệp của mình tiến lên tầm cao mới, bạn không thể không trang bị những kiến thức mang tính nền tảng cho kinh doanh này. Nhưng bạn phải bắt đầu từ đâu?\u003c/p\u003e\n\u003cp class=\"MsoNormal\"\u003eKhông khó để tìm thấy hàng loạt giáo trình về MBA được chia sẻ trên mạng, cũng như các khóa học MBA cấp tốc được khai giảng thường xuyên. Nhưng để chọn lọc kiến thức nhanh nhất và dễ áp dụng vào thực tế nhất, tiết kiệm chi phí và thời gian, bạn sẽ làm thế nào? Để trợ giúp rất đông người có nhu cầu nắm bắt kiến thức nền về MBA, nhóm 11 tác giả - doanh nhân giàu kinh nghiệm thuộc Trường Kinh doanh Đại học Waseda đã cùng nhau viết cuốn sách \"MBA căn bản\" - tác phẩm tổng hợp các tài liệu nghiên cứu trong môi trường giáo dục kinh doanh chất lượng bậc nhất Nhật Bản.\u003c/p\u003e\n\u003cp class=\"MsoNormal\"\u003eBố cục \"MBA căn bản\" được thiết kế ngắn gọn, súc tích, đi thẳng vào ví dụ thực tế của các doanh nghiệp thành công trong và ngoài Nhật Bản. Tất cả những công ty, doanh nghiệp được chọn lọc đưa vào phân tích trong sách đều là những cái tên điển hình về tư duy kinh doanh và áp dụng chuẩn mực các lí thuyết MBA.\u003c/p\u003e\n\u003cp class=\"MsoNormal\"\u003e12 chương sách giống như 12 bước đi đầu tiên của bạn trên hành trình khám phá chuyên ngành quản trị kinh doanh. Dù bạn là một học viên đang theo học đúng chuyên ngành này hay là một doanh nhân khát khao tạo ra ý tưởng đột phá từ các lí thuyết căn bản, “MBA căn bản” vẫn sẽ là người bạn đồng hành lý tưởng nhất của bạn.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/8d/29/29/490efc263d378e74b63addbf3b81d93f.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/8d/29/29/490efc263d378e74b63addbf3b81d93f.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/8d/29/29/490efc263d378e74b63addbf3b81d93f.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8d/29/29/490efc263d378e74b63addbf3b81d93f.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8d/29/29/490efc263d378e74b63addbf3