56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":3,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ee/30/1a/28a306c31e9b6d93967d18ca96b220d5.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":777,"all_time_quantity_sold":19,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<h1><em><strong>Xà bông rửa xe đậm đặc kết hợp tăng cường độ bóng sơn 2in1 1 lít </strong></em></h1>\n<h1><em><strong>PN39000W</strong></em></h1>\n<p>Sau một thời gian sử dụng xe thì trên xe ít hay nhiều thì cũng sẽ có nhiều vết bui bẩn bám trên xe, thậm chí xe để trong gara cũng sẽ có bụi bẩn bám trên xe. Do đó, sản phẩm <em><strong>Xà bông rửa xe đậm đặc kết hợp tăng cường độ bóng sơn 2in1 1 lít PN39000W </strong></em> được ra đời để phục vụ công việc vệ sinh thân xe một cách toàn diện và đơn giản nhất.</p>\n<p>Bạn có biết chỉ cần sử dụng <em><strong>Xà bông rửa xe đậm đặc kết hợp tăng cường độ bóng sơn 2in1 1 lít PN39000W </strong></em>là bạn đã có thể tẩy rửa tất cả bụi bẩn bùn đất bám trên xế yêu một cách an toàn và tiết kiệm.</p>\n<p>Ngoài khả năng làm sạch xe thì sản phẩm đồng thời kết hợp chứa chất dưỡng tăng cường độ bóng cho bề mặt nước sơn</p>\n<p> </p>\n<p><img src=\"https://salt.tikicdn.com/ts/product/15/93/4e/5d356ed5e9ba63e3c1843e2292cb8521.jpg?v=1658807704552\" alt=\"pn39000w-nd1.jpg?v=1658807704552\" /></p>\n<h2> </h2>\n<h2><strong>Thông tin sản phẩm</strong></h2>\n<ul><li>Tên sản phẩm: <em><strong>Xà bông rửa xe đậm đặc kết hợp tăng cường độ bóng sơn 2in1 1 lít PN39000W</strong></em></li>\n<li><em>Tên sản phẩm (EN): <strong>3M Car Wash With Wax</strong></em></li>\n<li>Mã hàng: <strong>PN39000W</strong></li>\n<li>Công dụng: Dùng trong quá trình rửa xe, giúp lấy đi bụi bẩn, bùn đất, dầu mỡ bám trên xe đồng thời tăng độ bóng sơn xe</li>\n<li><strong>Xuất xứ: 3M Thái Lan</strong></li>\n<li>Dạng: gel pha với nước</li>\n<li>Dung tích: 1 Lít (1000ml)</li>\n<li>Hạn sử dụng: 2 năm</li>\n<li>Khuyến khích: rửa xe hàng tháng hoặc khi bẩn nhiều</li>\n</ul><p> </p>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/db/e2/3d/abd7e71e8297a32d94e56334697635d9.jpg?v=1658807745676\" alt=\"pn39000w-nd2.jpg?v=1658807745676\" /></p>\n<h2> </h2>\n<h2><strong>Thông tin nổi bật</strong></h2>\n<ul><li>Sản phẩm 2  trong 1 có công dụng làm sạch và tăng độ bóng sơn xe</li>\n<li>Dung dịch đậm đặc với tỉ lệ 1:60, 1 chai dùng được rất nhiều lần.</li>\n<li>Tạo bọt tuyết phụ thuộc vào áp xuất nén của từng loại máy phun.</li>\n<li>Làm sạch hiệu quả mà hoàn toàn vô hại với sơn xe. </li>\n<li>Rửa sạch mọi vết bẩn dễ dàng với cả dòng nước mạnh và yếu.</li>\n<li>Tẩy sạch bụi và cặn bẩn mà không làm mất lớp sáp bảo vệ sơn bóng.</li>\n<li>An toàn cho bề mặt sơn bóng</li>\n<li>Thành phần không có chất phosphat.</li>\n<li>Công thức đậm đặc, tiết kiệm chi phí. </li>\n<li>Cấu trúc bọt bền vững</li>\n</ul><p> </p>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/a1/50/d5/db1031b7ecbf6ac4aa566a62da0ded7c.jpg?v=1658807755909\" alt=\"pn39000w-nd3-jpeg.jpg?v=1658807755909\" /></p>\n<h2> </h2>\n<h2><strong>Hướng dẫn sử dụng</strong></h2>\n<ul><li>Bước 1: Lắc đều dung dịch</li>\n<li>Bước 2: pha dung dịch với nước theo tỉ lệ 1:60 (10ml dung dịch pha với 600ml nước)</li>\n<li>Bước 3: Dùng dụng cụ hoặc khăn rửa sạch bề mặt xe, lau khô bề mặt</li>\n<li>Khuyến khích: rửa xe hàng tháng hoặc khi bẩn nhiều</li>\n<li>Dung dịch tạo bọt tuyết phụ thuộc vào áp xuất nén của từng loại máy phun.</li>\n</ul><p><strong>Lưu ý: không rửa xe trực tiếp dưới ánh nắng. Tránh tiếp xúc dung dịch với da và mắt. Đậy kính nắp khi chai không sử dụng</strong></p>\n<p> </p>\n<p><strong><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/af/fc/ca/5f4ebec446c75b3fbfe99c4b8b2d03fa.jpg?v=1658807765608\" alt=\"pn39000w-nd4.jpg?v=1658807765608\" /></strong></p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ee/30/1a/28a306c31e9b6d93967d18ca96b220d5.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ee/30/1a/28a306c31e9b6d93967d18ca96b220d5.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ee/30/1a/28a306c31e9b6d93967d18ca96b220d5.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ee/30/1a/28a306c31e9b6d93967d18ca96b220d5.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ee/30/1a/28a306c31e9b6d93967d18ca96b220d5.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/f8/cf/42/48f2cbf4c1e4576ca7f7907d973f9f8b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f8/cf/42/48f2cbf4c1e4576ca7f7907d973f9f8b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f8/cf/42/48f2cbf4c1e4576ca7f7907d973f9f8b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f8/cf/42/48f2cbf4c1e4576ca7f7907d973f9f8b.jpg","thumbnail_url":"https:/