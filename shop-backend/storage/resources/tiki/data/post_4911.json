"icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/fe/f0/62/383f07e7712bebff3622545b663bca1d.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":84,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cdiv class=\"tongQuan gStyle3 menuViewHightLight\"\u003e\n\u003cdiv class=\"description\"\u003e\n\u003cp\u003e\u003cem\u003eTrải nghiệm cuộc sống hiện đại và đầy tiện nghi với quạt đứng SUNHOUSE 8 cánh SHD7246\u003c/em\u003e\u003cem\u003e, \u003c/em\u003e\u003cem\u003etrang bị bộ điều khiển cảm ứng thông minh, SHD7246 giúp bạn thao tác nhanh chóng chỉ với 1 chạm. Cùng với đó là khả năng làm mát hiệu quả trong không gian rộng, đặc biệt với chế độ mô phỏng làn gió tự nhiên như gió trời, SHD7246 mang đến cho bạn làn gió mát lạnh sảng khoái, yên bình và dịu êm.\u003c/em\u003e\u003c/p\u003e\n\u003cbr /\u003e \u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"thietKe gStyle3 menuViewHightLight\"\u003e\n\u003cdiv class=\"description\"\u003e\n\u003ch2\u003e\u003cstrong\u003e\u003ciframe title=\"HƯỚNG DẪN LẮP ĐẶT QUẠT ĐỨNG 8 CÁNH SUNHOUSE SHD7346\" src=\"https://www.youtube.com/embed/tACgeryHBCc\" width=\"790\" height=\"428\" frameborder=\"0\" scrolling=\"no\" allowfullscreen=\"\"\u003e\u003c/iframe\u003e\u003cbr /\u003eThiết kế thông minh - Cuộc sống thêm tiện nghi\u003c/strong\u003e\u003c/h2\u003e\nKiểu dáng hiện đại cùng thiết kế thông minh, chiều cao có thể linh hoạt thay đổi theo nhu cầu, quạt đứng Sunhouse SHD7246 là thiết bị hoàn hảo giúp cuộc sống của gia đình thêm tiện nghi.\u003cbr /\u003e\u003cbr /\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/30/ef/d0/ac2f811fed10305e2c6835729675df93.jpg\" alt=\"Artboard%201(23).jpg\" /\u003e\u003cbr /\u003eSunhouse SHD7246 tích bảng điều khiển cảm ứng ngay trên thân quạt, bạn có thể tùy chọn các chế độ nhanh chóng chỉ với 1 chạm duy nhất. Bảng điều khiển phát sáng giúp các thành viên trong gia đình sử dụng dễ dàng khi trời tối, đặc biệt là người lớn tuổi hay trẻ nhỏ.\u003cbr /\u003e\u003cbr /\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/97/0e/c1/ac50b819f9f9f17bcc7a217f22493847.png\" alt=\"image(285).png\" /\u003e\n\u003ch2\u003e\u003cstrong\u003eQuạt 8 cánh sải rộng, làm mát mọi không gian\u003c/strong\u003e\u003c/h2\u003e\nSunhouse SHD7246 bao gồm 8 cánh quạt, đường kính sải cánh lên đến 35cm giúp đón gió hiệu quả, cải thiện hiệu suất làm mát và tạo ra luồng không khí mát đều đặn, tỏa khắp không gian một cách đồng đều.\u003cbr /\u003e\u003cbr /\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/e3/cb/1b/8af655b6434806b0b8c60c4c64ad3db9.jpg\" alt=\"Artboard%202(45).jpg\" /\u003e\n\u003ch2\u003e\u003cstrong\u003eĐộng cơ đồng - BỀN BỈ VỚI THỜI GIAN\u003c/strong\u003e\u003c/h2\u003e\nĐộng cơ đồng là yếu tố quan trọng giúp quạt trần SUNHOUSE 8 cánh SHD7346 vận hành hiệu quả và bền bỉ hơn. Ưu điểm của động cơ đồng là hiệu suất hoạt động cao, tạo ra lực mạnh hơn, giúp lưu lượng gió được tăng cường và phân phối một cách đồng đều. Hiệu suất chuyển đổi năng lượng tốt cũng giúp tiết kiệm điện năng, và hơn hết, việc tản nhiệt hiệu quả của động cơ cũng giúp kéo dài tuổi thọ của sản phẩm.\u003cbr /\u003e\u003cbr /\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/de/6c/02/143c15cfd3fd2c405d1cf87ef2048c29.jpg\" alt=\"Artboard%203(23).jpg\" /\u003e\n\u003ch2\u003e\u003cstrong\u003eVận hành êm ái, không gây ồn\u003c/strong\u003e\u003c/h2\u003e\nBên trong động cơ quạt là trục quay ổ bi giảm ma sát đáng kể, từ đó giảm tiếng ồn khi quạt động dù ở chế độ gió mạnh nhất. Bạn có thể tận hưởng không gian thư giãn và làm việc mà không sợ bị quấy rầy bởi tiếng ồn khó chịu.\u003cbr /\u003e\u003cbr /\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/b8/32/88/eadb664858f561ecc37209265c48b633.jpg\" alt=\"Artboard%204(21).jpg\" /\u003e\n\u003ch2\u003e\u003cstrong\u003eĐiều khiển từ xa tiện lợi\u003c/strong\u003e\u003c/h2\u003e\nNhờ có điều khiển từ xa, việc điều khiển quạt đứng Sunhouse SHD7246 trở nên tiện lợi hơn, từ việc điều chỉnh tốc độ gió, chế độ gió, bật/tắt đều chỉ cần bấm nút từ xa mà không di chuyển nhiều. Bạn sẽ không cần phải rời khỏi giường mỗi buổi tối, hay rời khỏi chỗ khi đang bận việc chỉ để bật/tắt quạt, tiết kiệm thời gian vô cùng.\u003cbr /\u003e\u003cbr /\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/ed/0c/33/be422d59286b3e1cd768864148631375.jpg\" alt=\"Artboard%206(6).jpg\" /\u003e\n\u003ch2\u003e\u003cstrong\u003eTích hợp nhiều chế độ gió thông minh\u003c/strong\u003e\u003c/h2\u003e\nNgoài chế độ gió thông thường, quạt đứng Sunhouse SHD7246 còn trang bị 2 chế độ gió đặc biệt và hiện đại nhất hiện nay, bao gồm: chế độ gió thông minh khi ngủ và chế độ gió tự nhiên.\u003cbr /\u003e\u003cbr /\u003eVới chế độ gió tự nhiên, quạt sẽ thay đổi vận tốc lên xuống lặp đi lặp lại thay vì vận tốc đều như chế độ gió thông thường. Từ đó tạo ra một dạng dao động mô phỏng gió tự nhiên, gió mát thoang thoảng như gió trời cho bạn cảm giác mát nhẹ mà vẫn sảng khoái.\u003cbr /\u003e\u003cbr /\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/b7/7a/55/6488f7653dd2a362c22850cc6034a590.jpg\" alt=\"Artboard%208(1).jpg\" /\u003e\u003cbr /\u003e\u003cbr /\u003eKhi chọn chế độ gió thông minh khi ngủ, vận tốc gió cũng sẽ điều chỉnh dần chậm lại theo chu kỳ để điều hòa không khí và làn gió để phù hợp với nhịp sinh học của con người. Làn gió về đêm dịu nhẹ hơn và bạn sẽ cảm thấy dễ chịu khi ngủ, sẽ không bị rét lúc nửa đêm hay nóng bức khi sáng sớm, mà luôn có một nhiệt độ ổn định và vừa phải.\u003cbr /\u003e\u003cbr /\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/0c/33/22/04c07a695479de9fa0cc77553f61e840.jpg\" alt=\"Artboard%207(4).jpg\" /\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/cb/47/87/5a46b20ded0c3b7bb3312aad7f6662db.png\" alt=\"\" width=\"350\" height=\"442\" /\u003e\u003c/p\u003e\n\u003ch2\u003e \u003c/h2\u003e\n\u003c/div\u003e\n\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/fe/f0/62/383f07e7712bebff3622545b663bca1d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/fe/f0/62/383f07e7712bebff3622545b663bca1d.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/fe/f0/62/383f07e7712bebff3622545b663bca1d.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fe/f0/62/383f07e7712bebff3622545b663bca1d.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fe/f0/62/383f07e7712bebff3622545b663bca1d.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/30/ef/d0/4f9b2fb7baeb7b4081a9d72a68fb9e65.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/30/ef/d0/4f9b2fb7baeb7b4081a9d72a68fb9e65.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/30/ef/d0/4f9b2fb7baeb7b4081a9d72a68fb9e65.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/30/ef/d0/4f9b2fb7baeb7b4081a9d72a68fb9e65