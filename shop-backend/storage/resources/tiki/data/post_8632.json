lor":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":80000,"discount_rate":22,"rating_average":5,"review_count":17,"review_text":"(17)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/41/6a/91/eb714663d203c36f088f9a984dd16514.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":410,"all_time_quantity_sold":90,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eGiới thiệu\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eMideer là thương hiệu nổi tiếng thế giới về các loại đồ chơi giáo dục được thành lập năm 2016 tại Ningbo, Trung Quốc. Mideer là thương hiệu tập trung vào sự phát triển thẩm mỹ và trí tuệ của trẻ từ 2-8 tuổi.  Mideer là một thương hiệu đã phá vỡ giới hạn truyền thống của thị trường đồ chơi giáo dục. Bằng cách hợp tác thiết kế với các nghệ sỹ nổi tiếng trên thế giới , Mideer đã tạo ra hai giá trị nổi bật  “Thẩm Mỹ và Trí Tuệ”. Hiện nay, Mideer có mặt trên 68 quốc gia, kết hợp với hơn 100 nghệ sĩ sáng tạo ra những sản phẩm đồ chơi cao cấp giải phóng trí tưởng tượng và khả năng sáng tạo không giới hạn của trẻ. Mideer tin rằng: đồ chơi không chỉ để chơi mà còn thúc đẩy sự phát triển các loại trí thông minh, là chìa khóa giúp trẻ mở ra thế giới quan rộng lớn.\u003c/p\u003e\n\u003cp\u003eGiá trị thực sự của một món đồ chơi không chỉ là để chơi, mà là liệu nó có mang đến cho trẻ tình yêu, hi vọng, khả năng duy trì sự ngây thơ, trí tưởng tượng phong phú của trẻ hay không?Những ảnh hưởng này có thể rất nhỏ, nhưng chính những ảnh hưởng này cho phép trẻ em duy trì một niềm hy vọng và sự lạc quan không thể dập tắt trong trái tim khi chúng phải đối mặt với những thất bại, nỗi đau và bóng tối một mình trong tương lai. Và Mideer sẽ gánh vác trách nhiệm này với một thái độ nghiêm túc!\u003c/p\u003e\n\u003cp\u003eĐó là lý do Mideer mong muốn được đồng hành và bảo vệ sự trưởng thành của con trẻ như những bậc cha mẹ. Chúng ta làm việc cùng nhau, lắng nghe tiếng nói khác nhau và làm cho kỳ vọng cao đẹp này ngày càng tốt hơn và không ngừng cải thiện\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eBộ tranh xếp hình ghép hình puzzle Mideer 280 mảnh ghép 04 chủ đề : Thế giới khủng long - Vỏ sò cá heo - Voi khổng lồ và Tê giác\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eChất liệu\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eTất cả được làm từ giấy ép lụa cứng như gỗ, chất lượng cao (bề dày mảnh ghép 2.5mm), các miếng ghép bo viền xung quanh cẩn thận.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eSố lượng \u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e280 miếng ghép\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eĐặc điểm nổi bật\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eKhác với những mẫu xếp hình quen thuộc từ trước tới nay, bộ xếp hình này thể hiện hình ảnh các loài động vật một cách mới lạ và đặc biệt hơn. Không những vậy, nhờ vào tính sáng tạo của thể loại hình lồng hình này, người chơi được trải nghiệm một bữa tiệc thị giác đầy nghệ thuật.\u003c/li\u003e\u003cli\u003eTranh minh họa chú khủng long được tạo nên bởi nhiều loài khủng long đầy màu sắc khác. Một thế giới khủng long huyền bí sẽ hiện ra khi tất cả các mảnh đã được ghép lại với nhau.\u003c/li\u003e\u003cli\u003eĐối với hình giấc mơ Voi, khung cảnh tráng lệ, huyền ảo của khu rừng trong giấc mơ của voi sẽ được tái hiện dưới đôi tay khéo léo của bé thông quá 280 miếng ghép.\u003c/li\u003e\u003cli\u003eKhi hoàn thành bộ xếp hình, ba mẹ có thể lồng khung thành phẩm để treo lên trường để trẻ có thể tạo ra câu chuyện về chuyến khám phá thế giới khủng long qua trí tưởng tựơng phong phú của mình.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eCông dụng\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eGiúp tăng khả năng tập trung và phát triển não bộ bên trong bé\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003ePhù hợp độ tuổi\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eKhủng Long, Voi: Từ 5 tuổi trở lên\u003c/li\u003e\u003cli\u003eCá heo, Tê giác: Từ 6 tuổi trở lên\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eTiêu chuẩn an toàn\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eTiêu chuẩn chất lượng Châu Âu EN71, nên ba mẹ hoàn toàn yên tâm về chất lượng khi cho con sử dụng.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eKích thước\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eHộp đựng có kích thước 31.2 x 23 x 5cm.\u003c/li\u003e\u003cli\u003eHình được ghép có kích thước 65.7 x 48.4cm (khủng long) hoặc 56 x 40 cm (Voi)\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/2f/ea/bf/8d1835b88fdf78768dfbda292047c0ec.jpg\" alt=\"\" width=\"750\" height=\"562\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/55/da/f1/be7983044621fcfbc4006f576b1f963a.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/d2/8f/9a/c1fd9fe65976aca60e415bc2be1bbd38.jpg\" alt=\"\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/3e/97/42/ba5eea749fff6dc852a85c5d9603f3e4.jpg\" alt=\"\" width=\"750\" height=\"527\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/b2/6e/69/9e20980