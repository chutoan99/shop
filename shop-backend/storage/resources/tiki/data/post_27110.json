":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":11800,"discount_rate":20,"rating_average":5,"review_count":5,"review_text":"(5)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/9b/02/71/96bb15f3b2e7d5838b6575c467561bb1.jpeg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1043,"all_time_quantity_sold":54,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2\u003eMƯA NẮNG NẮNG MƯA - Cuốn sách rực rỡ sắc màu khiến em bé nào cũng ồ lên thích thú\u003c/h2\u003e\n\u003cdiv class=\"o9v6fnle cxmmr5t8 oygrvhab hcukyx3x c1et5uql ii04i59q\"\u003e\n\u003cdiv dir=\"auto\"\u003e\n\u003cp\u003eMới được ra mắt tại tủ sách Sư Tử Bé trong tháng này, \"\u003cstrong\u003eMưa Nắng Nắng Mưa\u003c/strong\u003e\" là cuốn sách siêu đáng yêu sẽ kích thích trí tưởng tượng cho bé, giúp con nhận biết các hiện tượng thời tiết, tiếp thu các kiến thức khoa học một cách vô cùng hiệu quả mà không hề khô khan!\u003c/p\u003e\n\u003cp\u003eVới hình minh hoạ dễ thương, cùng cốt truyện gần gũi, nhẹ nhàng, con sẽ được tham gia vào cuộc trò chuyện siêu thú vị giữa hai người bạn thân: Mưa và Nắng. Toàn bộ câu chuyện về các hiện tượng thiên nhiên sẽ giúp con trả lời được câu hỏi mà bạn nhỏ nào cũng từng tò mò: \"\u003cstrong\u003eMưa và nắng - Điều gì quan trọng hơn?\u003c/strong\u003e\"\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/40/d6/46/5e30e14c338ee114e5d082b9185ed717.jpeg\" alt=\"sách cho bé 0-3 tuổi\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003eSự quan trọng của việc cân bằng các hiện tượng thiên nhiên\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003eMưa giúp cây xanh nảy mầm - Nắng giúp cây xanh quang hợp; Mưa giúp tạo ra những dòng suối trong - Nắng góp phần nuôi dưỡng đồng cỏ xanh, Các phép so sánh đơn giản những siêu trực quan, giúp các bạn nhỏ dễ hình dung về các lợi ích của hiện tượng thiên nhiên, cung cấp các kiến thức khoa học cơ bản những lại siêu hấp dẫn với lứa tuổi mầm non.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/3d/12/d4/f028545aefb780a7c1d3dd28b7390e67.jpeg\" alt=\"sách cho bé 3 tuổi\" width=\"750\" height=\"750\" /\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003eTôn trọng sự khác biệt và vai trò riêng của mỗi người, mỗi sự vật, hiện tượng xung quanh mình,\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003eBạn Nắng \"thổi bay\" những ngày mưa bão, ngập lụt; bạn Mưa lại có thể rửa trôi mọi bụi bẩn trên trái đất. Vậy nên ai ai cũng có những ưu điểm, năng lực khác nhau, con sẽ học được cách tôn trọng sự khác biệt của mỗi người, mỗi vật. Từ đó con mở rộng trái tim yêu thương và bao dung với tất cả mọi người xung quanh mình.\u003c/p\u003e\n\u003cp\u003eĐẶC BIỆT, trong cuốn sách còn đi kèm một trang TƯƠNG TÁC siêu lớn để bé thỏa sức tô màu, vẽ lên thế giới rực rỡ của riêng mình.\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/53/42/3b/dfffbfbc9752d1358ba6d5a6b09a51d7.jpeg\" alt=\"sách cho bé 2 tuổi\" width=\"750\" height=\"750\" /\u003e\u003c/em\u003e\u003c/p\u003e\n\u003ch3 style=\"text-align: left;\"\u003eThông số in ấn\u003c/h3\u003e\n\u003cp\u003eLoại Bìa: Bìa mềm, in nổi, phủ bóng\u003c/p\u003e\n\u003cp\u003eGiấy: CMAT 150\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khá