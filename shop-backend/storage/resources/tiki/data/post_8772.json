"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":2400000,"discount_rate":49,"rating_average":4.7,"review_count":3,"review_text":"(3)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/bf/be/b8/83f1144548fc9c9ea72c49fe5207a4fa.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":542,"all_time_quantity_sold":12,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3 class=\"card-title\"\u003eĐặc điểm nổi bật của Máy lọc không khí Xiaomi Mi AP 4 Lite\u003c/h3\u003e\n\u003cp\u003e\u003ciframe src=\"//www.youtube.com/embed/eL7hF4fa9Ps?t=1s\" width=\"665\" height=\"314\" allowfullscreen=\"\"\u003e\u003c/iframe\u003e\u003c/p\u003e\n\u003cdiv class=\"card-body\"\u003e\n\u003cdiv class=\"st-pd__slider\"\u003e\n\u003cdiv class=\"swiper-container js--pd-contentSlider re-swiper swiper-container-initialized swiper-container-horizontal\"\u003e\n\u003cdiv class=\"swiper-pagination swiper-pagination-clickable swiper-pagination-bullets\"\u003e\u003cstrong\u003eĐánh giá chi tiết Máy lọc không khí Xiaomi Mi AP 4 Lite\u003c/strong\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"st-pd-content\"\u003e\n\u003cp\u003eVới Mi Air Purifier 4 Lite, ai trong số chúng ta cũng có thể tận hưởng bầu không khí hít thở trong lành ở không gian sống. Sản phẩm ghi nhận khả năng lọc tới 99.97% các hạt kích cỡ 0,3 μm, ghi nhận vùng phủ tới 25-43 mét vuông, diện tích gọn gàng nhỏ hơn một tờ giấy A4 và vận hành êm ái không phát ra nhiều tiếng ồn.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://fptshop.com.vn/Uploads/images/2015/Tin-Tuc/BaoPK/S7TInDon/may-loc-khong-khi-xiaomi-mi-air-purifier-4-lite-1.JPG\" alt=\"Máy lọc không khí Xiaomi Mi Air Purifier 4 Lite\" width=\"665\" height=\"431\" /\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eHút/thổi toàn diện, vùng phủ 25-43 mét vuông\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003e được trang bị hệ thống hút/thổi mạnh mẽ, ghi nhận hiệu suất hoạt động lên tới 360 mét khối mỗi giờ và có thể cung cấp tới 6.000 lít không khí sạch trên một phút.\u003c/p\u003e\n\u003cp\u003eThiết kế hình trụ chữ nhật giúp sản phẩm hút gió khắp 360 độ không gian bao quanh và thổi không khí sạch lên trên theo chiều thẳng đứng. Chiếc  này phù hợp với các căn phòng có diện tích từ 25 đến 43 mét vuông, đảm bảo lọc sạch không khí trong không gian sống.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://fptshop.com.vn/Uploads/images/2015/Tin-Tuc/BaoPK/S7TInDon/may-loc-khong-khi-xiaomi-mi-air-purifier-4-lite-2.JPG\" width=\"665\" height=\"421\" alt=\"may-loc-khong-khi-xiaomi-mi-air-purifier-4-lite-2.JPG\" /\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eTrang bị hệ thống lọc không khí ba lớp\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eXiaomi Mi Air Purifier 4 Lite sử dụng bộ lọc ba trong một, ghi nhận năng lực lọc các hạt bụi siêu nhỏ thể tích 0.3 μm. Mỗi lớp lọc phụ trách tách một lớp chất ô nhiễm trong không khí nhằm đảm bảo người dùng được tận hưởng sự trong lành trong mỗi nhịp thở. Các nhân tố gây hại cho sức khỏe như lông thú cưng, phấn hoa, bụi bẩn, khói, tạp chất và sợi bông đều sẽ được giữ lại bên trong lõi lọc.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://fptshop.com.vn/Uploads/images/2015/Tin-Tuc/BaoPK/S7TInDon/may-loc-khong-khi-xiaomi-mi-air-purifier-4-lite-5.JPG\" alt=\"Trang bị hệ thống lọc không khí ba lớp\" width=\"665\" height=\"421\" /\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eLoại bỏ các mùi hôi gây khó chịu trong nhà\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eLõi  cao cấp mà máy lọc không khí Mi Air Purifier 4 Lite sử dụng ghi nhận tỉ lệ hấp thụ mùi hôi cao cấp 1.8 lần so với các dòng sản phẩm khác trên thị trường. Nhờ đó, sản phẩm dễ dàng loại bỏ các mùi ám trong phòng như mùi đồ ăn, mùi thú cưng, VOC, các loại chất độc như Formaldehyde và mọi loại mùi khác.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://fptshop.com.vn/Uploads/images/2015/Tin-Tuc/BaoPK/S7TInDon/may-loc-khong-khi-xiaomi-mi-air-purifier-4-lite-4.JPG\" alt=\"Loại bỏ các mùi hôi gây khó chịu trong nhà\" width=\"665\" height=\"421\" /\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eLõi lọc bền bỉ, sử dụng dài lâu\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eBộ lõi lọc mà Xiaomi Mi Air Purifier 4 Lite sử dụng có cấu trúc ba lớp và ghi nhận hiệu suất lọc không khí cao. Ước tính, diện tích trải rộng của bộ lọc khi không khí đi qua là 20.000 cm vuông, trong đó bao gồm 450.000 mg than hoạt tính. Tổng thể bộ lọc ba lớp có thể sử dụng tốt trong từ 6 đến 12 tháng, không đòi hỏi người dùng phải thay thế thường xuyên.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://fptshop.com.vn/Uploads/images/2015/Tin-Tuc/BaoPK/S7TInDon/may-loc-khong-khi-xiaomi-mi-air-purifier-4-lite-3.JPG\" alt=\"Lõi lọc bền bỉ, sử dụng dài lâu\" width=\"665\" height=\"421\" /\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eĐiều khiển từ xa qua ứng dụng độc quyền\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eĐể chủ nhân của Mi Air Purifier 4 Lite dễ dàng thao tác và vận hành thiết bị mà không cần lại gần,  đã xây dựng một ứng dụng với tên gọi Mi Home để giúp người dùng có thể điều khiển từ xa, hẹn giờ bật/tắt, thiết lập các cài đặt, theo dõi chất lượng không khí và sử dụng chế độ khóa không cho trẻ em tác động vào các tính năng.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://fptshop.com.vn/Uploads/images/2015/Tin-Tuc/BaoPK/S7TInDon/may-loc-khong-khi-xiaomi-mi-air-purifier-4-lite-6.JPG\" alt=\"Điều khiển từ xa qua ứng dụng độc quyền\" width=\"665\" height=\"421\" /\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eRa lệnh bằng Google Assistant và Alexa\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eMáy lọc không khí Xiaomi Mi Air Purifier 4 Lite được trang bị hai trợ lý ảo thông minh là  và Amazon Alexa. Do đó, bạn hoàn toàn có thể sử dụng những trợ lý ảo này để ra lệnh từ xa cho máy thực hiện các tác vụ mong muốn.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://fptshop.com.vn/Uploads/images/2015/Tin-Tuc/BaoPK/S7TInDon/may-loc-khong-khi-xiaomi-mi-air-purifier-4-lite-7.JPG\" alt=\"Ra lệnh bằng Google Assistant và Alexa\" width=\"665\" height=\"421\" /\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eMàn hình LED với các dải màu thông báo\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eTrên thân máy Mi Air Purifier 4 Lite, Xiaomi trang bị một màn hình LED để thông báo dữ liệu theo thời gian thực. Bạn có thể nắm rõ nhiệt độ trong nhà, độ ẩm trong không khí và trạng thái mạng Wi-Fi. Không chỉ vậy, một cơ chế thông báo chất lượng không khí thông minh cũng được áp dụng dựa trên màu sắc ánh sáng hiển thị. Trong đó, màu xanh là an toàn, màu vàng là mức ô nhiễm thấp, màu cam là mức ô nhiễm vừa phải và màu đỏ thông báo mức ô nhiễm cao.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://fptshop.com.vn/Uploads/images/2015/Tin-Tuc/BaoPK/S7TInDon/may-loc-khong-khi-xiaomi-mi-air-purifier-4-lite-8.JPG\" alt=\"Màn hình LED với các dải màu thông báo\" width=\"665\" height=\"421\" /\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eVận hành êm ái cho cả gia đình ngon giấc\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eKhi kích hoạt chế độ ban đêm, Mi Air Purifier 4 Lite sẽ vận hành rất êm ái với lượng tiếng ồn duy trì ở mức 33,4dB, đồng thời máy sẽ tắt đèn LED để tránh làm ảnh hưởng đến chất lượng giấc ngủ của gia đình có người lớn tuổi và trẻ nhỏ.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://fptshop.com.vn/Uploads/images/2015/Tin-Tuc/BaoPK/S7TInDon/may-loc-khong-khi-xiaomi-mi-air-purifier-4-lite-9.JPG\" alt=\"Vận hành êm ái cho cả gia đình ngon giấc\" width=\"665\" height=\"421\" /\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eHoạt động tiết kiệm năng lượng hiệu quả\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eKhả năng tiết kiệm điện cũng là một trong những điểm nhấn tiêu biểu của máy lọc không khí Xiaomi Mi Air Purifier 4 Lite. Dù là khi vận hành ở mức cực đại, sản phẩm cũng chỉ ghi nhận công suất là 33W, nghĩa là chỉ mất khoảng 0.8kWh điện cho 24 giờ máy vận hành.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://fptshop.com.vn/Uploads/images/2015/Tin-Tuc/BaoPK/S7TInDon/may-loc-khong-khi-xiaomi-mi-air-purifier-4-lite-a.JPG\" alt=\"Hoạt động tiết kiệm năng lượng hiệu quả\" width=\"665\" height=\"421\" /\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eThiết kế thay bộ lọc đơn giản\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eXiaomi Mi Air Purifier 4 Lite được thiết kế với cấu trúc gọn gàng để có thể thay bộ lọc hết sức đơn giản chỉ qua ba bước. Trong đó, bước 1 là nhấn vào công tắc trên máy để tháo chốt, bước 2 là nâng bộ lọc cũ ra khỏi máy và bước 3 là lắp bộ lọc mới rồi đặt nắp máy vào vị trí cũ.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://fptshop.com.vn/Uploads/images/2015/Tin-Tuc/BaoPK/S7TInDon/may-loc-khong-khi-xiaomi-mi-air-purifier-4-lite-c.JPG\" alt=\"Thiết kế thay bộ lọc đơn giản\" width=\"665\" height=\"206\" /\u003e\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/bf/be/b