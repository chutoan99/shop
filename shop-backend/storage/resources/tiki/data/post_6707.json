ao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/b0/a6/7b/4de628706d05c880c4b325fa78141a8a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b0/a6/7b/4de628706d05c880c4b325fa78141a8a.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b0/a6/7b/4de628706d05c880c4b325fa78141a8a.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b0/a6/7b/4de628706d05c880c4b325fa78141a8a.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b0/a6/7b/4de628706d05c880c4b325fa78141a8a.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/24/3b/77/3cffd26f74fcc53779b9ebcbacd4c9bd.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/24/3b/77/3cffd26f74fcc53779b9ebcbacd4c9bd.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/24/3b/77/3cffd26f74fcc53779b9ebcbacd4c9bd.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/24/3b/77/3cffd26f74fcc53779b9ebcbacd4c9bd.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/24/3b/77/3cffd26f74fcc53779b9ebcbacd4c9bd.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/13/ef/71/d3d13edfccd348479b437e8e365e8add.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/13/ef/71/d3d13edfccd348479b437e8e365e8add.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/13/ef/71/d3d13edfccd348479b437e8e365e8add.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/13/ef/71/d3d13edfccd348479b437e8e365e8add.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/13