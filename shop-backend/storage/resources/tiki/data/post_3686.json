on"}},"discount":0,"discount_rate":0,"rating_average":4,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/dc/d5/45/8dd165cb7bd40ae284688272be4a3f6a.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":306,"all_time_quantity_sold":5,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2 style=\"text-align:justify;\"\u003eTHÔNG SỐ KỸ THUẬT\u003c/h2\u003e\n\u003cul class=\"my11\" style=\"text-align:justify;\"\u003e\n\u003cli\u003eKết nối: USB, 2.4Ghz hoặc Bluetooth\u003c/li\u003e\n\u003cli\u003eĐèn Nền:RGB\u003c/li\u003e\n\u003cli\u003eNút và Cần cứng điều khiển: Nút Turbo, nút Marco và hai cần điều khiển\u003c/li\u003e\n\u003cli\u003eHệ Điều Hành: Windows 7/8/10/11 hoặc phiên bản cao hơn, Android 5.0 hoặc phiên bản cao hơn\u003c/li\u003e\n\u003cli\u003eTiêu Thụ Điện: Không rung (＜ 45mA), rung (＜100mA)\u003c/li\u003e\n\u003cli\u003ePin: 930mAh, sử dụng lên đến 25 giờ\u003c/li\u003e\n\u003cli\u003eKích Thước: 156mm * 113mm * 65 mm\u003c/li\u003e\n\u003cli\u003eTrọng Lượng: Khoảng 210g\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align:justify;\"\u003e \u003c/p\u003e\n\u003ch1 style=\"text-align:center;\"\u003eDAREU H105\u003c/h1\u003e\n\u003ch3 style=\"text-align:justify;\"\u003ePIN LITHIUM 930MAH\u003c/h3\u003e\n\u003cp style=\"text-align:justify;\"\u003eVới viên pin lithium 930mAh tích hợp, thời lượng pin lên đến 25 giờ, cho phép sản phẩm hoạt động liên tục suốt cả một ngày. Khoảng 25 giờ sử dụng pin và thời gian sạc khoảng 3,5 giờ.\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/6d/f8/71/c289b954b5a4b6accfc25732887026f7.png\" alt=\"\" width=\"750\" height=\"518\" /\u003e\u003c/p\u003e\n\u003ch3 style=\"text-align:justify;\"\u003eĐỘ TRỄ BẰNG KHÔNG\u003c/h3\u003e\n\u003cp style=\"text-align:justify;\"\u003eSử dụng cáp chống nhiễu dài 2m, tín hiệu truyền tải ổn định và hiệu quả, đảm bảo người chơi tận hưởng trò chơi một cách tốt nhất.\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/6e/5f/8a/f88c40b5ec0d4d046f1446bbd81cfa6b.png\" alt=\"\" width=\"750\" height=\"517\" /\u003e\u003c/p\u003e\n\u003ch3 style=\"text-align:justify;\"\u003e3 CHẾ ĐỘ KẾT NỐI \u003c/h3\u003e\n\u003cp style=\"text-align:justify;\"\u003eCó sẵn ba phương thức kết nối: kết nối qua cổng USB dây, kết nối không dây 2.4G và kết nối Bluetooth BT để đáp ứng nhu cầu của người dùng trên các nền tảng khác nhau. Thiết kế ergonomic giúp cầm chặt khoảng cách giữa móng vuốt và đầu ngón tay.\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/86/d8/ed/82d327f4a033272b1b0682ec1928e0a4.png\" alt=\"\" width=\"750\" height=\"516\" /\u003e\u003c/p\u003e\n\u003ch3 style=\"text-align:justify;\"\u003eTƯƠNG THÍCH VỚI NHIỀU TRÒ CHƠI TRÊN NHIỀU NỀN TẢNG\u003c/h3\u003e\n\u003cp style=\"text-align:justify;\"\u003eHỗ trợ PC, Switch, Android TV và điện thoại thông minh, chỉ cần cắm và chơi.\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/0b/f2/42/e45ccb9a8f90129efb58aaa7f65cf909.png\" alt=\"\" width=\"750\" height=\"518\" /\u003e\u003c/p\u003e\n\u003ch3 style=\"text-align:justify;\"\u003eCHẾ ĐỘ BẮN NHANH - TURBO MỘT LẦN CHẠM\u003c/h3\u003e\n\u003cp style=\"text-align:justify;\"\u003eBa tốc độ, động tác hoàn hảo. Nhấn nút turbo và nút hành động, sau khi đèn báo đèn sáng, bạn đã thiết lập thành công. Lần chạm đầu tiên là chế độ bán tự động, lần chạm thứ hai là chế độ tự động, lần chạm thứ ba tắt chế độ bắn nhanh.\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/54/80/57/107190b23d15d1cbf54cfd979a6bccfa.png\" alt=\"\" width=\"750\" height=\"519\" /\u003e\u003c/p\u003e\n\u003ch3 style=\"text-align:justify;\"\u003eMÁY RUNG BẤT ĐỐI XỨNG - KHÔI PHỤC CẢM GIÁC THỰC TẾ\u003c/h3\u003e\n\u003cp style=\"text-align:justify;\"\u003eCả hai tay cầm trái và phải đều được trang bị động cơ rung bất đối xứng, mang đến nhiều rung động khác nhau. Cường độ rung động dựa trên phản hồi của trò chơi, đặc biệt phù hợp cho trò chơi đối kháng và đua xe, mang đến cảm giác thực sự về đòn đánh và rung động.\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/18/e5/14/0effae78b1b3f14fcd7a30fd2dc4ae39.png\" alt=\"\" width=\"750\" height=\"520\" /\u003e\u003c/p\u003e\n\u003ch3 style=\"text-align:justify;\"\u003eRGB\u003c/h3\u003e\n\u003cp style=\"text-align:justify;\"\u003eTrang bị hai dải đèn RGB và nhiều chế độ hiệu ứng ánh sáng đa dạng, cho phép sáng sủa ngay cả trong bóng tối. Có hiệu ứng dải gradient, thay đổi màu sắc nhấp nháy, dải màu đa dạng, thay đổi màu khi động tay, màu sắc chuyển đổi đa dạng và chế độ chạy chuyển đổi màu sắc đa dạng.\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/33/54/f5/7545786aeda698f4cd7fd87640d8a003.png\" alt=\"\" width=\"750\" height=\"514\" /\u003e\u003c/p\u003e\n\u003ch3 style=\"text-align:justify;\"\u003eNÚT D-PAD HÌNH U\u003c/h3\u003e\n\u003cp style=\"text-align:justify;\"\u003eVới nút D-pad lồi, đặc biệt phù hợp trong trò chơi đối kháng. Tám hướng được kích hoạt một cách chính xác, và các động tác kéo luôn mượt mà và tự do.\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/34/76/c7/d6da90217108ee7c78665269b8999581.png\" alt=\"\" width=\"750\" height=\"520\" /\u003e\u003c/p\u003e\n\u003ch3 style=\"text-align:justify;\"\u003eJOYSTICK 360° ESPORTS\u003c/h3\u003e\n\u003cp style=\"text-align:justify;\"\u003eKiểm soát hướng 360° toàn diện, với chất liệu nút làm từ TPE thân thiện với da và không dễ bong tróc.\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/c6/cf/df/7a104c0e7610f063ae0e6f0856b9e2d6.png\" alt=\"\" width=\"750\" height=\"517\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/dc/d5/45/8dd165cb7bd40ae284688272be4a3f6a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/dc/d5/45/8dd165cb7bd40ae284688272be4a3f6a.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/dc/d5/45/8dd165cb7bd40ae284688272be4a3f6a.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/dc/d5/45/8dd165cb7bd40ae284688272be4a3f6a.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/dc/d5/45/8dd165cb7bd40ae284688272be4a3f6a.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/a1/54/b8/5be9dcef6a8a08cd7f4c625551107310.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a1/54/b8/5be9dcef6a8a08cd7f4c625551107310.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a1/54/b8/5be9dcef6a8a08cd7f4c625551107310.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a1/54/b8/5be9dcef6a8a08cd7f4c625551107310.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a1/54/b8/5be9dcef6a8a08cd7f4c625551107310.png"},{"base_url":"https://salt.tikicdn.com/ts/product/1e/5f/6f/a6a2da6f7f825eb87145709a6b7e46fc.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/1e/5f/6f/a6a2da6f7f825eb87145709a6b7e46fc.p