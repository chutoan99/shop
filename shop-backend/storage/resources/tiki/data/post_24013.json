96ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.7,"review_count":156,"review_text":"(156)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/1b/27/23/16035187ac941e08fc1bbeb0ff45bbba.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2660,"all_time_quantity_sold":909,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cspan style=\"font-size: medium; color: #008ab7;\"\u003e\u003cstrong\u003e\u003cstrong\u003eKem Dưỡng Làm Dịu Mát, Phục Hồi Da La Roche-Posay Cicaplast Baume B5 (40ml) - M3232900\u003c/strong\u003e\u003cbr /\u003e\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eKem Dưỡng Làm Dịu Mát, Phục Hồi Da La Roche-Posay Cicaplast Baume B5 (40ml) - M3232900 \u003c/strong\u003evới thành phần chứa các dưỡng chất cao cấp như nước khoáng La Roche-Posay, Pathenol, Madecassoside, Bơ hạt mỡ, Glycerin, Đồng, Kẽm,... sẽ giúp làm dịu, làm mượt, làm mát và phục hồi làn da. Kem có thể dùng cho da mặt và cơ thể của người lớn, trẻ nhỏ và em bé, phù hợp với những làn da nhạy cảm nhất.\u003c/p\u003e\n\u003cp\u003eBao bì sản phẩm có thể thay đổi theo từng đợt nhập hàng\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThông tin sản phẩm\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eLoại sản phẩm\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eLa Roche-Posay Cicaplast Baume B5 là kem dưỡng giúp phục hồi làn da \u0026amp; làm dịu các vùng da khô, da kích ứng \u0026amp; cảm giác bỏng rát, mang lại cảm giác dễ chịu.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThành phần và công dụng\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eCicaplast Baume B5 đẩy nhanh quá trình tái tạo da với những thành phần vượt trội:\u003c/p\u003e\n\u003cp\u003e- Panthenol 5% (vitamin B5): làm dịu các tổn thương, kích ứng và tấy đỏ trên da. 5% là nồng độ cao nhất của panthenol trong các sp bôi da.\u003c/p\u003e\n\u003cp\u003e- Madecassoside: thúc đẩy quá trình tái tạo các tầng biểu bì giúp vết thương mau lành và mờ sẹo.\u003c/p\u003e\n\u003cp\u003e- Các khoáng chất đồng, kẽm, magiê và mangan: giúp kháng khuẩn và giảm sưng tấy.\u003c/p\u003e\n\u003cp\u003e- Shea butter và glycerin: cung cấp độ ẩm cần thiết cho quá trình phục hồi của da.\u003c/p\u003e\n\u003cp\u003e- Kem không chứa paraben, hương liệu, ko gây bít lỗ chân lông.\u003c/p\u003e\n\u003cp\u003eLa Roche – Posay Cicaplast Bame B5 không chỉ giúp dưỡng ẩm mà còn giảm thiểu rõ rệt các dấu hiệu của sự kích ứng trên những vùng da bị tổn thương.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eLoại da phù hợp\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eCông thức không chứa hương liệu, không paraben và không chứa lanolin, nên La Roche – Posay Cicaplast Bame B5 thích hợp với những làn da nhạy cảm nhất.\u003c/p\u003e\n\u003cp\u003eKhuyên dùng trong các trường hợp viêm da cơ địa (eczema), da khô bóng chóc do thời tiết/kích ứng, da trầy sước, vết cắt nhỏ, da nóng, sẩy ngứa, da cháy nắng, nốt thâm và sẹo mụn, trẻ em bị hăm tã, mẩn đỏ, v.v…\u003c/p\u003e\n\u003cp\u003eCó thể sử dụng cho mặt, cho body và cho trẻ nhỏ.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eHướng dẫn sử dụng\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"c0\"\u003eThoa lên vùng da cần điều trị. Có thể thoa nhiều lần trong ngày\u003c/p\u003e\n\u003cp class=\"c0\"\u003eĐọc kỹ hướng dẫn trước khi sử dụng\u003cbr /\u003e\u003cbr /\u003e\u003cimg title=\"Kem Dưỡng Làm Dịu Mát, Phục Hồi Da La Roche-Posay Cicaplast Baume B5 (40ml) - M3232900\" s