:89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/82/d9/cb/abdd1cfe2c99f6004e37eab1e666574b.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1006,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e+ TRIPLE SUN BLOCK 50g\u003c/p\u003e\n\u003cp\u003eKem chống nắng GSC Triple Sun Block Hàn Quốc là một trong những sản phẩm kem chống nắng vật lý. Sản phẩm được chị em phụ nữ tin dùng nhiều nhất tại Việt Nam.\u003c/p\u003e\n\u003cp\u003eKem chống nắng chứa thành phần lành tính và chỉ số chống nắng cao. Giúp bảo vệ làn da khỏi tác hại của các tia UVA/UVB, chống lão hóa. Phù hợp với mọi loại da, kể cả da nhạy cảm\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eVới công dụng luôn bảo vệ da khỏi ánh nắng mặt trời hiệu quả.\u003c/li\u003e\n\u003cli\u003eGiúp cho luôn trắng sáng tự nhiên là điều cần thiết chi chị em phụ nữ.\u003c/li\u003e\n\u003cli\u003eSản phẩm có khả năng bảo vệ cho da dưới ánh mặt trời trong thời gian dài.\u003c/li\u003e\n\u003cli\u003eĐồng thời còn tránh được các tia có hại cho da bởi ánh sáng mặt trời.\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3 class=\"ftwp-heading\"\u003e\u003cstrong\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/25/34/a4/f4d781ac959aedbde182815dfefcd0a2.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/strong\u003e\u003c/h3\u003e\n\u003ch3 id=\"ftoc-tac-hai-cua-anh-nang-mat-troi-doi-voi-lan-da\" class=\"ftwp-heading\"\u003e\u003cstrong\u003eTác hại của ánh nắng mặt trời đối với làn da\u003c/strong\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003eUVA:\u003c/strong\u003e Đây là tia UV có bước sóng mạnh nhất với khả năng đi xuyên qua tường, kính cũng như nhiều lớp vải. Khi tia UVA xâm nhập vào da, chúng sẽ phá hủy collagen khiến da nhanh chóng lão hóa với các biểu hiện như tàn nhang, nám, sạm…\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eUVB:\u003c/strong\u003e Gây ra tình trạng cháy nắng, đen sạm, kích ứng.\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eUVC\u003c/strong\u003e\u003cem\u003e:\u003c/em\u003e Có khả năng gây ung thư cao nhất, nhưng có bước sóng ngắn, đã được tầng ozone hấp thụ.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eKem chống nắng sẽ tạo lớp màng vững chắc, ngăn sự tấn công của các tia tử ngoại, vô hiệu hóa các tác nhân gây hại. Đồng thời, những loại kem chống nắng tốt đến từ thương hiệu uy tín còn giúp nuôi dưỡng, cung cấp năng lượng tế bào cho làn da khỏe đẹp tự nhiên.\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003e\u003cu\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/82/cb/13/e66736b08d4b810df3eaa8c172f7ba60.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/u\u003e\u003c/strong\u003e\u003c/h3\u003e\n\u003ch3\u003e\u003cstrong\u003e\u003cu\u003eCông dụng của kem chống nắng vật lý GSC+:\u003c/u\u003e\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eChỉ số chống nắng SPF 50\u003csup\u003e+\u003c/sup\u003e/PA\u003csup\u003e+++\u003c/sup\u003e.  Với công thức ưu việt vượt trội tác dụng nổi bất là bảo vệ da khỏi bị đen, sạm, cháy nắng, nám, tàn nhang và lão hóa do ánh nắng mặt trời, đặc biệt là khả năng ngăn chặn tác hại của tia UVA và tia UVB đối với da.khả năng ngăn cản tia UVA có trong ánh nắng mặt trời một cách tối ưu (độ PA đạt mức cao nhất là PA+++ ). Ngăn ngừa ung thư da từ tác hại của tia UVA có trong ánh nắng mặt trời.\u003cbr /\u003ebảo vệ da chống lại tia UVB từ hơn 8 giờ.\u003c/p\u003e\n\u003cfigure id=\"attachment_3422\" class=\"wp-caption alignnone\" aria-describedby=\"caption-attachment-3422\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/af/07/21/dc712c153bb20355a7990cb30e1f123c.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e \u003cbr /\u003e\n\u003cfigcaption id=\"caption-attachment-3422\" class=\"wp-caption-text\"\u003e\u003cem\u003e\u003cstrong\u003e                                                                   Kem chống nắng GSC\u003c/strong\u003e\u003c/em\u003e\u003c/figcaption\u003e\n\u003c/figure\u003e\n\u003ch3\u003e\u003cstrong\u003e\u003cu\u003eThành phần chính:\u003c/u\u003e\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eChiết xuất nhau thai thảo dược. Chiết xuất nuôi cấy tế bào gốc cây nho, tế bào gốc cây hoa sen, ethyl amino hydroxy banoate, hexyl benzoate, isoamul p-methoxycinnamate, titanium dioside, Bis-hexy phenol Ethyl methoxyphnyl triaine, Tocopheryl acetate, sodium hyaluronidase nate, chiết xuất rau má, chiết xuất cam thảo, chiết xuất thân cây/rễ/lá bạch dương.\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003e\u003cu\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/f6/d6/21/d98dbaf46be2b210546b43b1ef355f42.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/u\u003e\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cu\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/2a/a2/84/ba81c175cd74f04a33bc387bfbdb88bf.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/u\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003e\u003cu\u003eHướng dẫn sử dụng: \u003c/u\u003e\u003c/strong\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eThoa đều kem chống nắng lên toàn bộ vùng da, massage nhẹ nhàng và vỗ nhẹ để kem chống nắng thẩm thấu hết. Để có hiệu quả tối ưu, cần thoa kem trước khi đi ra ngoài từ 20-25 phút.\u003c/li\u003e\n\u003cli\u003eSau khi thoa kem chống nắng hãy xịt một lớp khoáng để giữ kem chống nắng ko bị trôi nhanh\u003c/li\u003e\n\u003cli\u003eMỗi ngày nên thoa kem chống nắng ít nhất 2 lần vào buổi sáng và trưa để đạt hiệu quả chống nắng tốt nhât.\u003c/li\u003e\n\u003cli\u003eThoa kem chống nắng không kể ngày nắng hay mưa, có ra nắng hay không vì ánh sáng từ điện thoại – ti vi – gương phản chiếu cũng làm ảnh hưởng đến sắc tố của da.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ec/23/06/456a05008a1f504c15cb906ee99d01a0.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/82/d9/cb/abdd1cfe2c99f6004e37eab1e666574b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/82/d9/cb/abdd1cfe2c99f6004e37eab1e666574b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/82/d9/cb/abdd1cfe2c99f6004e37eab1e666574b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/82/d9/cb/abdd1cfe2c99f6004e37eab1e666574b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/82/d9/cb/abdd1cfe2c99f6004e37eab1e666574b.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/25/34/a4/30aeaf9f635213dae5a3c0599f107853.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/25/34/a4/30aeaf9f635213dae5a3c0599f107853.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/25/34/a4/30aeaf9f635213dae5a3c0599f107853.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/25/34/a4/30aeaf9f635213dae5a3c0599f107853.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/25/34/a4/3