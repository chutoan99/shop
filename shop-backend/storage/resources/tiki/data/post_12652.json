ground_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.7,"review_count":13,"review_text":"(13)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/media/catalog/product/a/p/aparat-sauna-faciala-laica-md6062-1.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":0,"all_time_quantity_sold":187,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p><span style=\"color: #008ab7; font-size: medium;\"><strong>Máy Xông Làm Đẹp Da Mặt LAICA - MD6062</strong></span> là sản phẩm được sản xuất bởi LAICA Spa – Nhà sản xuất thiết bị chăm sóc sức khỏe và làm đẹp số 1 tại Italy. Sản phẩm đạt các tiêu chuẩn chất lượng của các tổ chức chứng nhận chất lượng quốc tế: CE-0434; ISO-13485; ISO-9001; DNV; LGA. Máy có tác dụng hỗ trợ làm đẹp da và trị liệu một số bệnh liên quan đến đường hô hấp.</p>\r\n<ul>\r\n<li>Tẩy độc cho vùng da mặt: Hơi nước nóng được khuếch tán qua bầu xông làm giãn nở lỗ chân lông trên da vùng mặt  giúp tẩy rửa, giải phóng và loại bỏ những lớp tế bào chết trên da, mỹ phẩm, bụi bẩn và các chất cặn bã ẩn sâu dưới da, làm cho lỗ chân lông thông thoáng, giữ cho da mặt mềm, mịn, sạch sẽ không bị khô nám và hạn chế các loại mụn (mụn trứng đầu đen, mụn bọc,…) gây bệnh viêm da, chàm, nấm,… làm cho da mặt bạn trở lên mềm, mịn sáng khoẻ và trẻ hơn…</li>\r\n<li>Chống cảm lạnh: Khi thời tiết giá lạnh hệ hô hấp rất dễ bị ảnh hưởng nên kéo theo là chứng bệnh cảm lạnh. Sử dụng chức năng xông mũi của máy cùng với lá xông, tinh dầu bạc hà, thảo dược,..sẽ giúp làm sạch, bảo vệ hệ hô hấp.</li>\r\n<li>Chức năng xông trị liệu: Khi trời lạnh niêm mạc đường hô hấp thường bị khô nên làm khả năng hô hấp kém và dễ bị cảm. Sử dụng chức năng xông trị liệu (sử dụng bầu xông nhỏ) bằng việc hít hơi nóng qua miệng hoặc mũi sẽ giúp khả năng hô hấp tốt hơn. Nếu triệu chứng cảm lạnh vẫn tiếp diễn, bạn có thể cho thêm các dược liệu vào nước xông theo chỉ định của bác sĩ để xông có hiệu quả hơn.</li>\r\n</ul>\r\n<ul>\r\n</ul><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/media/catalog/product/a/p/aparat-sauna-faciala-laica-md6062-1.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/a/p/aparat-sauna-faciala-laica-md6062-1.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/a/p/aparat-sauna-faciala-laica-md6062-1.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/a/p/aparat-sauna-faciala-laica-md6062-1.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/a/p/aparat-sauna-faciala-laica-md6062-1.jpg"},{"base_url":"https://salt.tikicdn.com/media/catalog/product/h/u/huong-dan-su-dung-may-xong-lam-dep-da-mat-laica-md6062.u499.d20160621.t142110.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/h/u/huong-dan-su-dung-may-xong-lam-dep-da-mat-laica-md6062.u499.d20160621.t142110.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/h/u/huong-dan-su-dung-may-xong-lam-dep-da-mat-laica-md6062.u499.d20160621.t142110.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/h/u/huong-dan-su-dung-may-xong-lam-dep-da-mat-laica-md6062.u499.d20160621.t142110.jpg","thum