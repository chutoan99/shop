"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ec/6a/2a/2778478454fe0ff0fc98bd520418d04b.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1756,"all_time_quantity_sold":7,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cspan style=\"color: #ff0000;\"\u003e\u003cstrong\u003eLịch Vạn Niên 1932 - 2050 (Tái Bản) / Tăng Cường Ngô Biên Dịch - Sách Kiến Thức Tổng Hợp (Tặng Kèm Bookmark Happy Life)\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003eSách được trình bày rất dễ tra cứu và chính xác. Bạn có thể tra cứu từ ngày dương lịch sang âm lịch và ngược lạ\u003c/p\u003e\n\u003cp\u003eSố phận con người cũng như đời sống nhân loại còn nhiều bí ẩn, vẫn là thách thức không dễ gì vượt qua. Trong giới hạn đó, có thể xem thuật giải đoán đời người qua 12 con giáp như là một phương thức tiếp cận “tiền khoa học” của người xưa, từ đó hiểu rõ thêm ý nghĩa văn hóa dân gian của việc gọi tên thời gian theo biểu tượng 12 con giáp.\u003c/p\u003e\n\u003cp\u003ePhần I: Biểu lịch từ 1932 – 1950 Lịch âm dương Trung Quốc\u003c/p\u003e\n\u003cp\u003ePhần II: Dự đoán đời người và 12 con giáp\u003c/p\u003e\n\u003cp\u003eVới mỗi tuổi (tương ứng với con giáp), ta sẽ biết được tài năng, sự nghiệp, tính cách, tài vận và hôn nhân, phúc lộc theo tháng sinh, theo các năm, vận mệnh của năm loại tuổi (tý, sửu, dần, mã)\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ec/6a/2a/2778478454fe0ff0fc98bd520418d04b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ec/6a/2a/2778478454fe0ff0fc98bd520418d04b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ec/6a/2a/2778478454fe0ff0fc98bd520418d04b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ec/6a/2a/2778478454fe0ff0fc98bd520418d04b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ec/6a/2a/2778478454fe0ff0fc98bd520418d04b.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/3d/53/e3/461c55c3828d4b436294de6f9acd62f8.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/3d/53/e3/461c55c3828d4b436294de6f9acd62f8.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/3d/53/e3/461c55c3828d4b436294de6f9acd62f8.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3d/53/e3/461c55c3828d4b436294de6f9acd62f8.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3d/53/e3/461c55c3828d4b436294de6f9acd62f8.jpg"}],"warranty_policy":null,"authors":[{"id":238963,"name":"Tăng Cường Ngô (Biên Dịch)","slug":"tang-cuong-ngo-bien-dich"}],"current_seller":{"id":279977,"sku":"2392026026189","name":"Tiệm sách Minh Hằng","link":"https://tiki.vn/cua-hang/tiem-sach-minh-hang","logo":"72/e9/31/97b276a4c1d9e00bf2bac4f286c5b7c9.jpg","price":135000,"product_id":"1895