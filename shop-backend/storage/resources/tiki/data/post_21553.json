dge","code":"text_badge","type":"text_badge","index":0,"icon":null,"icon_width":0,"icon_height":0,"text_color":"#FFF0F1","background_color":"#D93843","href":null,"text":"9.9"},{"placement":"pdp_badge","code":"is_hero","type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"freeship_xtra","type":"pdp_icon_badge","index":2,"icon":"https://salt.tikicdn.com/ts/upload/be/67/48/04a82ab8df178e1a13bde38316081865.png","icon_width":91,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":true,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.7,"review_count":55,"review_text":"(55)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/d7/6c/5a/aaa00145a132ae8315946426e111a064.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1052,"all_time_quantity_sold":317,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eTuan Viet Books xin trân trọng giới thiệu tới quý phụ huynh và các bé bộ sách 5 cuốn Tự tin vào lớp 1 - Phát triển tư duy ngôn ngữ - chỉ số sáng tạo với:\u003c/p\u003e\n\u003cp\u003e1. Toán Tư duy - Beginning Creative Math (Dành cho bé 4-6 tuổi/Song ngữ Việt - Anh) được thiết kế với nhiều hoạt động \"Chơi mà học - Học mà chơi\"  như Tô màu, Tô nét - Vẽ hình, Nối số, Dán sticker, nhằm kích thích tối đa sự phát triển của não bộ trẻ đồng thời giúp cho trẻ có những định hướng chính xác về tư duy thông qua các chủ đề như:\u003c/p\u003e\n\u003cp\u003e- Phân biệt Phương hướng - Vị trí\u003c/p\u003e\n\u003cp\u003e- Phân biệt Màu sắc - Hình khối cơ bản\u003c/p\u003e\n\u003cp\u003e- Quy luật cho bé - Tô màu hình khối\u003c/p\u003e\n\u003cp\u003e- Thứ tự trước sau - Số thứ tự\u003c/p\u003e\n\u003cp\u003e- Giới thiệu các số cơ bản từ 1 - 20 với các hoạt động vui chơi để nắm vững số đếm\u003c/p\u003e\n\u003cp\u003e2. BÉ BƯỚC ĐẦU TẬP VIẾT - Chỉn chu và chi tiết ngay từ những bước đầu tiên.\u003c/p\u003e\n\u003cp\u003e- Hướng dẫn tư thế ngồi viết, Cách cầm bút đúng cách.\u003c/p\u003e\n\u003cp\u003e- Tập tô tập viết: Nét cơ bản, Chữ cái, chữ ghép, Chữ số.\u003c/p\u003e\n\u003cp\u003eQuyển sách giúp bé:\u003c/p\u003e\n\u003cp\u003e- Làm quen với các nét chữ viết cơ bản\u003c/p\u003e\n\u003cp\u003e- Tập tô viết theo những chữ mẫu có sẵn\u003c/p\u003e\n\u003cp\u003e- Tập tô, tập viết chữ cái, chữ ghép, chữ số\u003c/p\u003e\n\u003cp\u003e3. Sách \"Tập đánh vần Tiếng Việt - Phát triển tư duy ngôn ngữ\" được biên soạn công phu dựa theo chương trình giáo dục mới nhất nhất năm 2021 của Bộ GD\u0026amp;ĐT, với hiệu đính của các chuyên gia giáo dục. Nhằm đưa đến sự hứng thú cho bé trong việc tập đọc, tập đánh vần, sách bao gồm rất nhiều đoạn văn, bài thơ, đồng dao, truyện ngắn có nội dung có nội dung trong sáng, gần gũi, dễ hiểu, dễ nhớ, giúp các bé từ 4-6 tuổi rèn kĩ năng đọc cho thông thạo, trôi chảy, phát âm chuẩn và mở rộng vốn từ ngữ.\u003c/p\u003e\n\u003cp\u003eBố cục bài đọc được sắp xếp khoa học, dễ hiểu, các bé chỉ cần vừa học vừa chơi trong vòng 2 tháng là có thể đọc thông thạo tiếng Việt. Giúp các bé tự tin, vững vàng trước khi vào lớp 1.\u003c/p\u003e\n\u003cp\u003eQuyển sách gồm 2 phần:\u003c/p\u003e\n\u003cp\u003e- Phần 1: Tập đánh vần\u003c/p\u003e\n\u003cp\u003e- Phần 2: Luyện đọc\u003c/p\u003e\n\u003cp\u003eĐánh vần tiếng Việt với 124 trang cùng đầy đủ nội dung chữ cái cùng bộ học vần theo chương trình mới nhất bài học giới thiệu bảng chữ cái Tiếng Việt, dấu thanh và vần Tiếng Việt giúp các bé bước đầu làm quen với chữ viết và cách đánh vần Tiếng Việt. Mỗi bài học gồm các từ vựng, câu, đa dạng, bé tha hồ tập đánh vần, tập đọc mà không bị nhàm chán. Đặc biệt, các chữ in mầu, vẽ sơ đồ cầu trúc từ đơn giản đến phức tạp cực kỳ đễ hiểu và logic cùng màu sắc tươi tắn khiến cho việc học trở nên thú vị hơn.\u003c/p\u003e\n\u003cp\u003e4. Sách \"Cùng Bé chinh phục Toán học - Conquering Pre-School Maths\" tập hợp những bài toán căn bản nhất dành cho lứa tuổi mầm non, chuẩn bị vào lớp 1.\u003c/p\u003e\n\u003cp\u003eCác chủ đề chính của cuốn sách bao gồm: số đếm (số chẵn/lẻ), số lượng; Nhận biết hình khối; cộng trừ trong phạm vi 5, 10 đơn vị; Nhận biết Tuần, Tháng, các đơn vị thời gian; Thực hiện phép tính không nhớ và có nhớ trong phạm vi 100 bằng nhiều phương pháp thông minh…\u003c/p\u003e\n\u003cp\u003e5. Cuốn sách Luyện đọc cung cấp các từ ngữ, câu văn, đoạn văn, đoạn thơ với nội dung trong sáng, gần gũi, dễ hiểu, dễ nhớ giúp các em rèn kĩ năng đọc cho thông thạo, trôi chảy, diễn cảm và mở rộng vốn từ ngữ\u003c/p\u003e\n\u003cp\u003eCuốn sách Luyện đọc sẽ giúp các em học sinh rèn luyện kỹ năng đọc trôi chảy, đọc hiểu câu từ khi bắt đầu môn Tiếng việt.\u003c/p\u003e\n\u003cp\u003eHình ảnh rõ nét, màu sắc sinh động bắt mắt sẽ khơi gợi sự hứng thú học tập trong bé\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e(Bao bì có thể có thay đổi theo từng đợt nhập hàng) \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/d7/6c/5a/aaa00145a132ae8315946426e111a064.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d7/6c/5a/aaa00145a132ae8315946426e111a064.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d7/6c/5a/aaa00145a132ae8315946426e111a064.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d7/6c/5a/aaa00145a132ae8315946426e111a064.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d7/6c/5a/aaa00145a132ae8315946426e111a064.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/e8/72/4a/b4c6e41bee29ff7d6ac48aa4650ff7f0.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e8/72/4a/b4c6e41bee29ff7d6ac48aa4650ff7f0.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e8/72/4a/b4c6e41bee29ff7d6ac48aa4650ff7f0.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e8/72/4a/b4c6e41bee29ff7d6ac48aa4650ff7f0.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e8/72/4a/b4c6e41bee29ff7d6ac48aa4650ff7f0.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/48/95/d7/3085fb034c080605aed2c8439b8fdfab.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/48/95/d7/3085fb034c080605aed2c8439b8fdfab.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/48/95/d7/3085fb034c080605aed2c8439b8fdfab.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/48/95/d7/3085fb034c080605aed2c8439b8fdfab.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/48/95/d7