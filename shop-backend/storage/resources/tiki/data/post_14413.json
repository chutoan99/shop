f":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":71000,"discount_rate":22,"rating_average":4.8,"review_count":32,"review_text":"(32)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/c4/3b/ac/edd3a3f5e363a46b050fac864d0273dc.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1498,"all_time_quantity_sold":171,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eĐược mệnh danh là sản phẩm ngăn tiết mồ hôi hàng đầu tại Pháp và là “cứu tinh” cho rất rất nhiều bạn với nỗi lo về “viêm cánh” và tuyến mồ hôi. Lăn khử mùi Etiaxil là dòng lăn khử mùi đầu tiên được khuyên dùng rộng rãi bởi các bác sỹ da liễu, chuyên dành cho các trường hợp ra nhiều mồ hôi.\u003c/p\u003e\n\u003cp\u003eMặc dù có rất nhiều sản phẩm khử mùi trên thị trường, nhưng Etiaxil là dòng lăn khử mùi đầu tiên được khuyên dùng rộng rãi bởi các bác sỹ da liễu, chuyên dành cho các trường hợp ra nhiều mồ hôi.\u003c/p\u003e\n\u003cp\u003eCông thức độc đáo của Etiaxil cho phép lăn khử mùi tác động trực tiếp và hỗ trợ điều trị được hiện tượng đổ mồ hôi ngay từ lần sử dụng đầu tiên, tác dụng lên tới 2-3 ngày mà hoàn toàn không phải lăn lại. Tại các hiệu thuốc ở Pháp hay Đan Mạch, những ai gặp vấn đề về “mùi hương” đều chỉ tìm đến với EtiaXil mà thôi.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/02/66/35/72467a7d3033bce49f485269e8170860.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eThành phần:\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003eCông thức độc đáo của Etiaxil cho phép khử mùi tác động trực tiếp và hỗ trợ điều trị được hiện tượng đổ mồ hôi ngay từ lần sử dụng đầu tiên, mùi khó chịu sẽ hoàn toàn biến mất, đây không phải dạng sáp khử mùi thông thường mà còn là một loại sp hỗ trợ trị “viêm cánh” hoặc có vấn đề với “mùi hương”.\u003c/p\u003e\n\u003cp\u003eNhờ công thức với nhôm Clorua hexahydrat trong dung dịch cồn, các hoạt chất trong Etiaxil phản ứng với nước trong ống mồ hôi để tạo thành một lớp keratin, các tuyến mồ hôi sau đó bắt đầu “nghỉ ngơi” và dừng sản xuất mồ hôi. Clorua nhôm cũng cung cấp chức năng kháng khuẩn, giúp tránh mùi khó chịu.\u003c/p\u003e\n\u003cp\u003eSau một vài ngày, lớp keratin sẽ được đào thải tự nhiên theo tế bào da chết và tuyến mồ hôi lại hoạt động trở lại. Quá trình này mất từ một vài ngày tới 1 tuần. Đó là lý do vì sao bạn chỉ cần dùng Etiaxil 1-3 lần/tuần.\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eCông dụng:\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003eKhử mùi tuyệt đối 100% và ngăn mồ hôi tới 75% ngay từ lần lăn đầu tiên\u003c/p\u003e\n\u003cp\u003eKhông màu, không mùi, không ướt dính, không gây ố vàng áo.\u003c/p\u003e\n\u003cp\u003eHiệu quả từ 2-3 ngày không cần lăn lại (tắm rửa thoải mái)\u003c/p\u003e\n\u003cp\u003eLăn khử mùi Etiaxil hầu như không gây kích ứng hoặc dị ứng trên da. Etiaxil phù hợp với tất cả các loại da, thậm chí cả những vùng da nách cực kỳ nhạy cảm.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/4a/ed/ab/882bc0d3ea203e1465dc90cc175ac628.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eHướng dẫn sử dụng:\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003eSử dụng buổi tối trước khi đi ngủ vì ban đêm là thời điểm tiết mồ hôi rất ít vì vậy mà Etiaxil sẽ hoạt động hiệu quả. Nên sử dụng ngay sau khi tắm xong để đảm bảo vùng da dưới cánh tay hoàn toàn sạch mồ hôi và khô ráo. Tránh sử dụng khi da còn ướt hoặc đã tiết mồ hôi sẽ bị gây ngứa.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eLưu ý:\u003c/strong\u003e Để đạt hiệu quả và độ an toàn, khi sử dụng sản phẩm bạn nên tuân theo nguyên tắc 3S\u003c/p\u003e\n\u003cp\u003e- Sử dụng buổi tối trước khi đi ngủ để Etiaxil hoạt động vào ban đêm, thời điểm ít ra mồ hồi\u003c/p\u003e\n\u003cp\u003e- Sử dụng trên bề mặt da không bị tổn thương, không có vết thương hở\u003c/p\u003e\n\u003cp\u003e- Sử dụng trên \"làn da khô hoàn hảo\" (sau khi tắm xong và lau khô da), da ẩm nước có thể gây kích thích và làm giảm hiệu quả của Etiaxil.\u003c/p\u003e\n\u003cp\u003e- Nên sử dụng kết hợp với các sản phẩm khử mùi hằng ngày của Etiaxil để đạt hiệu quả tốt nhất.\u003c/p\u003e\n\u003cp\u003e\u003cu\u003e\u003cstrong\u003eLiệu trình sử dụng:\u003c/strong\u003e\u003c/u\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eTuần 1: dùng 3 lần/tuần\u003c/li\u003e\n\u003cli\u003eTuần 2: dùng 2 lần/ tuần\u003c/li\u003e\n\u003cli\u003eTuần 3: dùng 1 lần/tuần (có thể dùng thường xuyên nếu bị nặng hơn)\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/c4/3b/ac/edd3a3f5e363a46b050fac864d0273dc.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c4/3b/ac/edd3a3f5e363a46b050fac864d0273dc.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c4/3b/ac/edd3a3f5e363a46b050fac864d0273