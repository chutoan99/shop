n"}},"discount":418500,"discount_rate":15,"rating_average":4,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ed/53/0f/402af15a0fcb4a76fef6708fbf48bc6f.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":783,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cdiv\u003e\u003cstrong\u003eEcalite EF-K128S \u003c/strong\u003elà dòng sản phẩm vòi rửa chén nóng lạnh của thương hiệu Ecalite với thiết kế nhỏ gọn, hiện đại phù hợp với nhiều không gian bếp gia đình. Sản phẩm được làm từ chất liệu inox 304 cao cấp có độ bền vượt trội, sử dụng dài lâu; cổ vòi xoay 360 độ linh hoạt mang đến trải nghiệm sử dụng hiệu quả và tiết kiệm nước.\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/a2/a7/28/4138ba07435eb2d0e9384fce2c517945.png\" alt=\"Vòi rửa chén Ecalite EF-K128S\" width=\"750\" height=\"392\" /\u003e\u003c/div\u003e\n\u003cdiv\u003e\n\u003ch2\u003eThiết kế nhỏ gọn, hiện đại\u003c/h2\u003e\n\u003cdiv\u003eVòi rửa chén Ecalite EF-K128S là một trong những mẫu vòi có thiết kế nhỏ gọn nhất của hãng Ecalite. Với chiều cao phần nổi là 348.4 mm gọn gàng nhưng không kém phần nổi bật, sản phẩm phù hợp với đa số các chậu rửa chén hiện nay như chậu 1 ngăn lớn hay 2 ngăn. Ngoài ra, các chi tiết được gia công tỉ mỉ với công nghệ hiện đại đem đến cho sản phẩm vòi rửa chén Ecalite này một diện mạo chắc chắn và đồng nhất.\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv\u003eBên cạnh đó, kiểu dáng hình chữ L tạo sự mạnh mẽ, cứng cáp cho tổng thể vòi, khi kết hợp với các thiết bị bếp khác sẽ làm tôn lên sự cá tính và hiện đại và không gian bếp.\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/6c/06/e8/8dab928a9225fb92c8d63729feef91e6.png\" alt=\"Thiết kế hiện đại của vòi rửa chén Ecalite EF-K128S\" width=\"750\" height=\"392\" /\u003e\u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003eThiết kế hiện đại của vòi rửa chén Ecalite EF-K128S\u003c/div\u003e\n\u003cdiv\u003e\n\u003ch2\u003eChất liệu inox 304 độ bền cao\u003c/h2\u003e\n\u003cdiv\u003eVề chất liệu của vòi EF-K128S được hoàn thiện từ inox 304 cao cấp với ưu điểm là chống gỉ sét, chống bám bẩn cực tốt. Bên cạnh đó, chất liệu này cũng giúp cho bề mặt của vòi có được độ sáng bóng lý tưởng, nên dù sử dụng trong thời gian dài, sản phẩm luôn bền đẹp, tạo sự thuận tiện cho việc vệ sinh vòi hàng ngày.\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/06/eb/36/8a986f6ad219202bade3703d81c8383f.jpg\" alt=\"Chất liệu vòi rửa EF-K128S làm từ inox 304 cao cấp\" width=\"750\" height=\"392\" /\u003e\u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003eChất liệu vòi rửa EF-K128S làm từ inox 304 cao cấp\u003c/div\u003e\n\u003cdiv\u003e\n\u003ch2\u003eCần gạt nước dạng que dễ thao tác sử dụng\u003c/h2\u003e\n\u003cdiv\u003eVòi inox Ecalite EF-K128S sở hữu cần gạt thiết kế dạng que nhỏ gọn thuận tiện cho việc thao tác đóng/mở nước. Cần gạt có khả năng xoay rất linh hoạt theo nhiều hướng khác nhau, nhờ đó bạn có thể điều chỉnh chính xác nguồn nước nóng/lạnh và mức nước như ý muốn.\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/79/79/c7/97182d904600a3d92498beb9c9aa362f.png\" alt=\"Cần gạt nước dạng que của EF-K128S rất dễ thao tác\" width=\"750\" height=\"392\" /\u003e\u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003eCần gạt nước dạng que của EF-K128S rất dễ thao tác\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv\u003e\n\u003ch2\u003eHai chế độ nước nóng và lạnh theo nhu cầu\u003c/h2\u003e\n\u003cdiv\u003eHai chế độ nóng-lạnh trên vòi rửa chén Ecalite phục vụ nhiều mục đích sử dụng khác nhau của người dùng. Ví dụ như bạn có thể dùng nước lạnh để rửa rau củ quả, thực phẩm tươi sống; hoặc có thể tận dụng nước nóng để rửa chén đĩa, tiệt trùng dụng cụ cho em bé, rửa ly tách rất tiện dụng. Đặc biệt, nguồn nước nóng sẽ giúp bạn rửa chén đĩa, xoong nồi dính dầu mỡ dễ dàng hơn mà không phải dùng quá nhiều xà phòng rửa chén. Để chọn nguồn nước, bạn chỉ cần gạt tay nắm theo hướng ký hiệu trên cần gạt (C- viết tắt của Cold: chế độ nước lạnh; H- viết tắt của Hot: chế độ nước nóng) rất đơn giản và nhanh chóng.\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/17/e8/0c/1751ce114ed955955fed3a114bdbd945.png\" alt=\"Vòi rửa bát Ecalite EF-K128S có 2 nguồn nước nóng lạnh tiện dụng\" width=\"750\" height=\"392\" /\u003e\u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003eVòi rửa bát Ecalite EF-K128S có 2 nguồn nước nóng lạnh tiện dụng\u003c/div\u003e\n\u003cdiv\u003e\n\u003ch2\u003eBọt nước mềm mại chống văng hiệu quả\u003c/h2\u003e\n\u003cdiv\u003eEcalite EF-K128S đem đến những bọt nước mềm mại khi sở hữu đầu vòi thiết kế với những lỗ nhỏ li ti có tác dụng tạo bọt hiệu quả, dòng nước nhẹ nhàng không bị văng nước dù xả mạnh giúp tiết kiệm nước tối ưu. Ngoài ra bộ lọc trên đầu vòi còn có khả năng lọc sạch các cặn bẩn để đưa ra nguồn nước trong lành và an toàn khi sử dụng.\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/34/76/1c/385dede87caa76ae50c481cbbcc19dec.png\" alt=\"Dòng nước êm ái và an toàn với đầu vòi tạo bọt\" width=\"750\" height=\"392\" /\u003e\u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003eDòng nước êm ái và an toàn với đầu vòi tạo bọt\u003c/div\u003e\n\u003ch2\u003eCổ vòi xoay 360 độ linh hoạt\u003c/h2\u003e\n\u003cdiv\u003eBên cạnh dây rút, phần cổ vòi cũng được Ecalite thiết kế dạng xoay 360 độ để tăng sự linh hoạt trong khi sử dụng. Nhờ đó, bạn có thể điều chỉnh hướng dòng chảy theo ý muốn của mình để thuận tiện hơn khi rửa chén và thực phẩm. Thiết kế này cũng giúp vòi rửa chén nóng lạnh EF-K128S dễ kết hợp với chậu rửa chén 1 ngăn lớn hoặc 2 ngăn. \u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/30/e3/55/9fb755e7b31f859cd6814c62ffeecf79.png\" alt=\"Cổ vòi xoay linh hoạt thuận tiện lấy nước ở nhiều vị trí\" width=\"750\" height=\"392\" /\u003e\u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003eCổ vòi xoay linh hoạt thuận tiện lấy nước ở nhiều vị trí\u003c/div\u003e\n\u003cdiv\u003e\n\u003ch2\u003eThông số kỹ thuật vòi rửa chén Ecalite EF-K128S\u003c/h2\u003e\n\u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/c6/ae/38/9d4284acc47e9ae617996fb29a8622b7.png\" alt=\"Thông số kỹ thuật vòi rửa chén nóng lạnh EF-K128S\" width=\"750\" height=\"392\" /\u003e\u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003eThông số kỹ thuật vòi rửa chén nóng lạnh EF-K128S\u003c/div\u003e\n\u003cdiv\u003e\n\u003ch2\u003eChính sách bảo hành vòi rửa chén inox Ecalite EF-K128S\u003c/h2\u003e\n\u003cp\u003eVòi rửa chén nóng lạnh Ecalite EF-K128S được hãng Ecalite\u003cspan style=\"font-size:14px;\"\u003e bảo hành chính hãng 3 năm tại nhà.\u003c/span\u003e\u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/cb/4e/fe/15b32c4f2c21e68997ed575e601b1c98.png\" alt=\"Vòi Ecalite EF-K128S nóng lạnh bảo hành 3 năm chính hãng\" width=\"750\" height=\"392\" /\u003e\u003c/div\u003e\n\u003cdiv style=