:5,"review_count":5,"review_text":"(5)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ec/55/f6/82588adace6e25c6a3db800f1a89a20e.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1082,"all_time_quantity_sold":84,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/89/19/ff/a8f5bbb9b96604556087824325c9f80c.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch2 style=\"text-align:center;\"\u003e\u003cstrong\u003eTHÔNG TIN SẢN PHẨM\u003c/strong\u003e\u003c/h2\u003e\n\u003ctable style=\"width:509px;\"\u003e\u003ctbody\u003e\u003ctr\u003e\u003ctd style=\"width:114.281px;\"\u003e\n\u003cp\u003e\u003cstrong\u003eTên sản phẩm\u003c/strong\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style=\"width:384.719px;\"\u003eChén quai vuông trắng đủ cỡ Chén uống trà sứ Long Phương\u003c/td\u003e\n\u003c/tr\u003e\u003ctr\u003e\u003ctd style=\"width:114.281px;\"\u003e\n\u003cp\u003e\u003cstrong\u003eTên thương hiệu\u003c/strong\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style=\"width:384.719px;\"\u003e\n\u003cp\u003eLONG PHUONG \u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\u003ctr\u003e\u003ctd style=\"width:114.281px;\"\u003e\n\u003cp\u003e\u003cstrong\u003eMàu sắc\u003c/strong\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style=\"width:384.719px;\"\u003eTrắng\u003c/td\u003e\n\u003c/tr\u003e\u003ctr\u003e\u003ctd style=\"width:114.281px;\"\u003e\n\u003cp\u003e\u003cstrong\u003eSize\u003c/strong\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style=\"width:384.719px;\"\u003e\n\u003cp\u003e80ml = 6,2*4,4 cm\u003c/p\u003e\n\u003cp\u003e120ml = 7*5 cm\u003c/p\u003e\n\u003cp\u003e150ml = 7,5*5,4 cm\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\u003ctr\u003e\u003ctd style=\"width:114.281px;\"\u003e\u003cstrong\u003ePhù hợp cho\u003c/strong\u003e\u003c/td\u003e\n\u003ctd style=\"width:384.719px;\"\u003e\n\u003cp\u003eGia đình/Tiệc/ nhà hàng \u0026amp; Khách sạn/ Ngoài trời/Tiệc cưới \u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\u003c/tbody\u003e\u003c/table\u003e\u003cp\u003e\u003cstrong\u003eLưu ý                    \u003c/strong\u003eGiá trên không bao gồm đĩa kê\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/62/80/28/468c1dba1a0bc3aa181b9bc60d9539da.jpg\" alt=\"\" width=\"750\" height=\"300\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eĐặc tính sản phẩm:\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eKhả năng chịu va đập mạnh\u003c/li\u003e\n\u003cli\u003eChất sứ đanh- bền\u003c/li\u003e\n\u003cli\u003eMàu sắc tinh tế\u003c/li\u003e\n\u003cli\u003eKiểu dáng sang trọng\u003c/li\u003e\n\u003cli\u003eBề mặt sản phẩm sáng, bóng nhắn\u003c/li\u003e\n\u003cli\u003eKhả năng chịu sốc nhiệt cao vì được nung ở lò tuynel với nhiệt độ 1380 độ C\u003c/li\u003e\n\u003cli\u003eSử dụng tốt trong lò vi sóng, máy rửa bát\u003c/li\u003e\n\u003cli\u003eSản phẩm được nung ở 1380 độ C nên đã loại bỏ được hết chì và các chất độc hại có trong đất\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/fa/67/3b/2821cd73bb16e7d903871612a5d52f9d.jpg\" alt=\"\" width=\"748\" height=\"342\" /\u003e\u003c/p\u003e\n\u003cp\u003eĐể tạo ra được một sản phẩm sứ trắng chất lượng, những người thợ phải suy nghĩ và khéo léo tạo hình trong suốt thời gian dài từ quá trình hình thành ý tưởng, thử nghiệm, hoàn thiện, bổ sung lại tiếp tục hoàn thiện rồi mới cho ra sản phẩm cuối cùng bán ra thị trường. \u003c/p\u003e\n\u003cp\u003eSản phẩm hội tụ được nét tinh xảo của bàn tay người thợ, tạo ra những sản phẩm cũng tinh xảo vạn phần khiến cho ai cũng phải mê mẩn mỗi khi được chiêm ngưỡng.\u003c/p\u003e\n\u003cp\u003ePhương châm của Sứ Long Phương là \"mang lại vẻ đẹp hoàn mỹ trong từng sản phẩm, mỗi sản phẩm dù lớn hay nhỏ đều là kết tinh của tinh hoa, trí tuệ và công sức\".\u003c/p\u003e\n\u003ch2 style=\"text-align:center;\"\u003e\u003cstrong\u003eMỘT SỐ HÌNH ẢNH SẢN PHẨM\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/5c/94/82/8c4343cab17379fa1f69335be2b93012.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/21/34/26/8a457c31d2644c892bdeaed0dd91ad86.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/52/15/8f/68b81c2da828713b73017840b3b00b4a.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eTẠI SAO NÊN SỬ DỤNG SẢN PHẨM SỨ CAO CẤP CỦA LONG PHƯƠNG?\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003eSứ Long Phương là đơn vị sản xuất ly cốc sứ cao cấp uy tín hàng đầu tại Việt Nam. Chúng tôi có hơn 20 năm kinh nghiệm trong lĩnh vực gốm sứ và kinh nghiệm phục vụ hàng ngàn khách hàng trên toàn quốc và quốc tế. Tự hào đem đến tay người tiêu dùng những sản phẩm chất lượng cao.\u003c/p\u003e\n\u003cp\u003eTất cả mẫu ly cốc sứ tại Sứ Long Phương đều được trải qua quá trình chọn lọc nguyên liệu và chế tác tỉ mỉ của người thợ lành nghề. Vì có giá trị sử dụng cao và mức giá hợp lý nên những chiếc ly sứ còn được các doanh nghiệp lựa chọn in logo để quảng bá thương hiệu đến với công chúng.\u003c/p\u003e\n\u003ch2 style=\"text-align:center;\"\u003e\u003cstrong\u003eMỘT SỐ GIẢI THƯỞNG CỦA CHÚNG TÔI\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/bc/6b/f6/f73aa5ff661d9909cc15b1299bb8e96c.jpg\" alt=\"\" width=\"750\" height=\"458\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ec/55/f6/82588adace6e25c6a3db800f1a89a20e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ec/55/f6/82588adace6e25c6a3db800f1a89a20e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ec/55/f6/82588adace6e25c6a3db800f1a89a20e.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ec/55/f6/82588adace6e25c6a3db800f1a89a20e.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ec/55/f6/82588adace6e25c6a3db800f1a89a20e.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/89/19/ff/4522bbc5b584378ab5ab59a95920dc1b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/89/19/ff/4522bbc5b584378ab5ab59a95920dc1b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/89/19/ff/4522bbc5b584378ab5ab59a95920dc1b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/89/19/ff/4522bbc5b584378ab5ab59a95920dc1b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/89/19/ff/4522bbc5b584378ab5ab59a95920dc1b.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/5c/94/82/df92b049eacf3a81922a5f1b762274e7.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/5c/94/82/df92b049eacf3a81922a5f1b762274e7.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/5c/94/82/df92b049eacf3a81922a5f1b762274e7.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5c/94/82/df92b049eacf3a81922a5f1b762274e7.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5c/94/82/df92b049eacf3a81922a5f1b762274e7.jpg"},{"