ull}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/da/9b/87/60f654285780a84505c7547054cb0d76.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1913,"all_time_quantity_sold":18,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eSẢN PHẨM ĐƯỢC NHẬP KHẨU CHÍNH HÃNG VÀ PHÂN PHỐI BỞI CÔNG TY CỔ PHẦN TẦM NHÌN   \u003c/p\u003e\n\u003cp\u003eKìm cắt tỉa cành mũi hếch Gardena 08905-20 được làm từ chất liệu nhựa cao cấp, với lưỡi kìm bằng thép không gỉ được phủ lớp mạ chống bám dính, giúp cho việc vệ sinh lưỡi được dễ dàng. \u003c/p\u003e\n\u003cp\u003eKìm được thiết kế có thể điều chỉnh độ rộng để phù hợp với tay cầm của người sử dụng, đường kính cắt tối đa 24mm. \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/0c/d9/b1/ebe169b2d9a72ba7f4dc430eceba7a61.png\" alt=\"\" width=\"606\" height=\"606\" /\u003e\u003c/p\u003e\n\u003cp\u003eĐối với kéo Gardena có thiết kế chốt để khóa an toàn hoặc điều chỉnh độ rộng của kéo, phải bóp đóng kéo lại rồi mới điều chỉnh chốt khóa, tránh tình trạng điều chỉnh chốt khi kéo vẫn mở dẫn đến gây hỏng lẫy chốt khóa và không thể điều chỉnh được chốt khóa nữa.\u003c/p\u003e\n\u003cp\u003eCHỈ NHỮNG PHẦN MÀU CAM TRÊN SẢN PHẨM LÀ CÓ THỂ ĐIỀU CHỈNH DI CHUYỂN ĐƯỢC (XOAY/ẤN/VẶN/KÉO).\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTHÔNG TIN THƯƠNG HIỆU \u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eGARDENA là Thương hiệu dẫn đầu thế giới với hơn 60 năm kinh nghiệm trong lĩnh vực sản xuất dụng cụ và thiết bị chăm sóc sân vườn tại Châu Âu, được thành lập năm 1961 tại Đức bởi Werner Kress và Eberhard Kastner. Sản phẩm Gardena đã có mặt tại hơn 80 quốc gia thông qua các Nhà Nhập khẩu và Phân phối. Kể từ năm 2006, Gardena thuộc quyền sở hữu của Tập đoàn Husqvarna AB Thụy Điển. Gardena đã trở thành Thương hiệu ưa thích của hàng triệu chủ sở hữu nhà và vườn trên toàn thế giới bởi các sản phẩm đa dạng cùng chất lượng tuyệt vời.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/da/9b/87/60f654285780a84505c7547054cb0d76.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/da/9b/87/60f654285780a84505c7547054cb0d76.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/da/9b/87/60f654285780a84505c7547054cb0d76.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/da/9b/87/60f654285780a84505c7547054cb0d76.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/da/9b/87/60f654285780a84505c7547054cb0d76.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/9a/45/a5/4c16e402a5584deda71229022cebb0aa.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/9a/45/a5/4c16e402a5584deda71229022cebb0aa.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/9a/45/a5/4c16e402a5584deda71229022cebb0aa.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9a/45/a5/4c16e402a5584deda71229022cebb0aa.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9a/45/a5/4c16e402a5584deda71229022cebb0aa.png"},