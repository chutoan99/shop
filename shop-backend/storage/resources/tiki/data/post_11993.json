oo KG878M không kén loại bếp sử dụng, có thể dùng trên bếp từ, bếp gas, bếp điện, bếp hồng ngoại và bếp halogen.<p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ba/e5/3f/df190fe7df30d19f98e955c2e817574e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ba/e5/3f/df190fe7df30d19f98e955c2e817574e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ba/e5/3f/df190fe7df30d19f98e955c2e817574e.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ba/e5/3f/df190fe7df30d19f98e955c2e817574e.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ba/e5/3f/df190fe7df30d19f98e955c2e817574e.jpg"}],"warranty_policy":null,"brand":{"id":19589,"name":"Kangaroo","slug":"kangaroo"},"current_seller":{"id":1957,"sku":"8012246051064","name":"Bếp Minh Hà","link":"https://tiki.vn/cua-hang/bep-minh-ha","logo":"8e/25/1b/1a8b1f7c12983ae24e3ff18e1d728b33.png","price":220000,"product_id":"91810328","store_id":1916,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Content","attributes":[{"code":"brand","name":"Thương hiệu","value":"Kangaroo"},{"code":"brand_country","name":"Xuất xứ thương hiệu","value":"Việt Nam"},{"code":"item_model_number","name":"Model","value":"KG878M"},{"code":"kich_thuoc","name":"Kích thước (Dài x Rộng x Cao)","value":"300 x 200 x 180 mm"},{"code":"origin","name":"Xuất xứ (Made in)","value":"Trung Quốc"},{"code":"product_weight","name":"Trọng lượng sản phẩm","value":"1300 g"}]},{"name":"Operation","attributes":[{"code":"is_warranty_applied","name":"Sản phẩm có được bảo hành không?","value":"Không"}]}],"p