dn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":145000,"discount_rate":20,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/3c/dc/78/5573d8f07be06c21c7f41eaa5d3b8d63.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":287,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eTrong bộ sưu tập BITI'S HUNTER STREET MIDNIGHT 2K23 mới nhất, với khẩu hiệu “Hoang dã! Mạnh mẽ! Ấn tượng! Đầy táo bạo! Phá vỡ những quy chuẩn thông thường!”, nhiều người tiêu dùng Việt mê mẩn ngay từ lần đầu tiên dòng Giày Thể Thao Nữ Biti’s Hunter Street - Midnight 2K23 HSW004701. Bởi, không chỉ có màu sắc đẹp mắt, thời trang, sản phẩm còn có chất lượng cao cấp, đạt tiêu chuẩn và giá thành phải chăng, hợp túi tiền.\u003c/p\u003e\n\u003ch2\u003eĐế giày\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003eĐế giày được Biti’s chế tác từ chất liệu EVA cao su với hàng loạt ưu điểm nổi bật không thể phủ nhận. Chẳng hạn như độ đàn hồi cao, có khả năng uốn gấp tốt, có độ ma sát cao, chống trơn trượt hiệu quả… \u003c/li\u003e\n\u003cli\u003eBên cạnh đó, bên dưới đế giày bố trí thêm nhiều rãnh chống trượt, giúp bảo đảm an toàn tối đa cho người dùng trong mọi chuyển động.\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch2\u003eThân giày\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003eBiti’s chọn lựa bề mặt thân giày làm từ chất liệu da, được xử lý cẩn trọng theo đúng quy trình tiêu chuẩn. Điều này giúp thân giày có khả năng chống nước, chống bám bẩn tối ưu. Đặc biệt, chính thiết kế bề mặt giả vải Jeans mang lại tính thẩm mỹ cao và khiến người dùng nổi bật giữa đám đông.\u003c/li\u003e\n\u003cli\u003eHSW004701 còn có thêm hiệu ứng chuyển màu phản quang đẹp mãn nhãn, xuất hiện lần đầu tiên trong bộ sưu tập Midnight năm 2023. Qua đó giúp người sử dụng tự tin thể hiện chất riêng và trở nên nổi bật hơn trong mắt người đối diện. \u003c/li\u003e\n\u003c/ul\u003e\n\u003ch2\u003eMàu sắc\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003eGiày Thể Thao Nữ Biti’s Hunter Street thuộc bộ sưu tập Midnight 2K23 HSW004701 có 1 màu duy nhất là Đen.\u003c/li\u003e\n\u003cli\u003eMàu sắc thực tế có sự chênh lệch khoảng 3 - 5 %.\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch2\u003eSize giày\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003eSản phẩm Giày Thể Thao Nữ Biti’s HSW004701 hiện có 5 size cơ bản từ 35 đến 39.\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch2\u003eBảo hành\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003eBiti’s cam kết áp dụng chế độ bảo hành 3 tháng với tất cả lỗi phát sinh liên quan đến nhà sản xuất. Riêng lỗi bung chỉ, đứt chỉ, bong keo…, Biti’s có thêm chế độ bảo hành trọn đời.\u003c/li\u003e\n\u003cli\u003eNgoài ra, khách hàng được đổi size trong vòng 7 ngày hay đổi sản phẩm lỗi trong vòng 7 ngày (kể từ thời điểm mua hàng và đáp ứng yêu cầu chính sách đổi trả quy định). \u003c/li\u003e\n\u003c/ul\u003e\n\u003ch2\u003eTính năng và lợi ích nổi bật\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003ePhát triển kiểu dáng, màu sắc, chất liệu… giày thể thao HSW004701 theo hướng khai phóng tinh thần tự do nguyên bản. Qua đó, mọi người tự tin thể hiện cá tính và được sống với “Midnight” bằng cái tôi chính hiệu.\u003c/li\u003e\n\u003cli\u003eThiết kế phần thân giày bằng da, có màu phản quang nổi bật, giúp tăng độ an toàn khi người dùng di chuyển vào ban đêm.\u003c/li\u003e\n\u003cli\u003eChất liệu đế EVA cao su độc đáo bền chắc, chống trượt tốt.\u003c/li\u003e\n\u003cli\u003eÁp dụng chế độ bảo hành uy tín, minh bạch. \u003c/li\u003e\n\u003c/ul\u003e\n\u003ch2\u003eSản phẩm bao gồm\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003eHộp đựng giày làm từ giấy bìa cứng cáp giúp bảo quản giày tốt hơn.\u003c/li\u003e\n\u003cli\u003eĐôi giày\u003c/li\u003e\n\u003cli\u003eDây giày\u003c/li\u003e\n\u003cli\u003eGiấy gói.\u003c/li\u003e\n\u003cli\u003eTúi chống ẩm.\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/3c/dc/78/5573d8f07be06c21c7f41eaa5d3b8d63.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/3c/dc/78/5573d8f07be06c21c7f41eaa5d3b8d63.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/3c/dc/78/5573d8f07be06c21c7f41eaa5d3b8d63.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3c/dc/78/5573d8f07be06c21c7f41eaa5d3b8d63.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3c/dc/78/5573d8f07be06c21c7f41eaa5d3b8d63.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/70/e2/dc/afef99450b42a115244b3c28b8127499.JPG","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/70/e2/dc/afef99450b42a115244b3c28b8127499.JPG","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/70/e2/dc/afef99450b42a115244b3c28b8127499.JPG","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/70/e2/dc/afef99450b42a115244b3c28b8127499.JPG","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/70/e2/dc/afef99450b42a115244b3c28b8127499.JPG"},{"base_url":"https://salt.tikicdn.com/ts/product/bf/46/43/e57a477994f609