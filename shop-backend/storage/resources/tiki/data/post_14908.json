ght":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/media/catalog/product/p/a/panc-sr-hb184kra_1.u579.d20160524.t143838.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":0,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003eThiết kế sang trọng, hiện đại\u003c/h3\u003e\r\n\u003cp\u003eNồi cơm điện tử Panasonic PANC-SR-HB184KRA sở hữu cho mình một màu sắc đen tuyền bóng bẩy cùng với chất liệu vỏ ngoài bằng     lớp cách nhiệt giúp bảo vệ người dùng trong việc sử dụng nồi và dễ dàng lau chùi. Sản phẩm còn được thiết kế các phím điều     khiển điện tử đơn giản, giúp người dùng cảm thấy thoải mái nhất khi sử dụng sản phẩm.\u003c/p\u003e\r\n\u003cp style=\"text-align: center;\"\u003e\u003cimg title=\"Nồi Cơm Điện Tử Panasonic PANC-SR-HB184KRA\" src=\"http://tikicdn.com/media/catalog/product/p/a/panc-sr-hb184kra_15.u579.d20160524.t143848.jpg\" alt=\"Nồi Cơm Điện Tử Panasonic PANC-SR-HB184KRA\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\r\n\u003ch3\u003eDung tích lớn - Đa chức năng nấu\u003c/h3\u003e\r\n\u003cp\u003eNồi có dung tích 1.8L ( nấu được từ 1 – 1,5kg gạo) phù hợp cho gia đình 4 - 6 người. Bên cạnh đó không chỉ là nồi chuyên     dụng nấu cơm thông thường, nồi cơm điện tử Panasonic SR-HB184KRA còn tích hợp 11 chức năng nấu tiện dụng cài đặt trước giúp     bạn có thể chọn các chức năng như nấu thường, nấu nhanh, nấu cơm ngon, nấu cháo, nấu soup, hầm, nấu  tạo nên sự đa     dạng và phong phú cho thực đơn mỗi ngày của bạn.\u003c/p\u003e\r\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Nồi Cơm Điện Tử Panasonic PANC-SR-HB184KRA - 1.8 Lít\" src=\"http://tikicdn.com/media/catalog/product/p/a/panc-sr-hb184kra_6.u579.d20160524.t143847.jpg\" alt=\"Nồi Cơm Điện Tử Panasonic PANC-SR-HB184KRA - 1.8 Lít\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\r\n\u003ch3\u003eLòng nồi chống dính – chất liệu bền bỉ\u003c/h3\u003e\r\n\u003cp\u003eLòng nồi dày 7 lớp, phủ kim cương Kamado cho độ bền cao có khả năng chịu được 110.000 lần cọ rửa cho phép bạn vo gạo ngay     trong nồi mà không sợ trầy xước như các loại nồi thông thường. Lớp men chống dính còn giúp cho quá trình nấu cơm sẽ không     bị cháy, khét… Ngoài ra, bạn cũng có thể sử dụng nồi cơm chống dính để chế biến món bánh bông lan thơm ngon, ngọt ngào cho     cả gia đình vào dịp cuối tuần.\u003c/p\u003e\r\n\u003cp style=\"text-align: center;\"\u003e\u003cimg title=\"Nồi Cơm Điện Tử Panasonic PANC-SR-HB184KRA - 1.8 Lít\" src=\"http://tikicdn.com/media/catalog/product/p/a/panc-sr-hb184kra_11.u579.d20160524.t143847.jpg\" alt=\"Nồi Cơm Điện Tử Panasonic PANC-SR-HB184KRA - 1.8 Lít\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\r\n\u003ch3\u003eChế độ giữ ấm sau khi cơm chín\u003c/h3\u003e\r\n\u003cp\u003eCó một số loại nồi cơm gặp tình trạng chỉ cần rút phích cắm điện là xảy ra hiện tượng thoát nhiệt rất nhanh. Nhưng đối với     SR-HB184KRA được trang bị thêm chức năng cảm ứng nhiệt, khi cơm chín nhiệt độ đạt mức cho phép sẽ tự động ngắt và chuyển     sang giữ ấm.\u003c/p\u003e\r\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Nồi Cơm Điện Tử Panasonic PANC-SR-HB184KRA - 1.8 Lít\" src=\"http://tikicdn.com/media/catalog/product/p/a/panc-sr-hb184kra_7.u579.d20160524.t143847.jpg\" alt=\"Nồi Cơm Điện Tử Panasonic PANC-SR-HB184KRA - 1.8 Lít\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\r\n\u003ch3\u003eNắp vòm thông minh\u003c/h3\u003e\r\n\u003cp\u003eHơi nước khi nấu sẽ ngưng tụ thành nước bám trên nắp nồi, chỉ cần bạn mở nắp là những giọt nước đó sẽ bị rơi xuống khiến     cơm ngon không đều, nhão hay bám nước. Nắm bắt được lo ngại của người tiêu dùng, những chuyên gia của Panasonic đã nâng cấp     thiết kế nồi đặc biệt không làm nhão cơm bằng cách ngăn hơi nước tụ trên nắp, chức năng thoát hơi thông minh qua ống dẫn     đảm bảo cho bữa cơm của gia đình bạn hoàn hảo hơn bao giờ hết. Nồi cơm điện tử Panasonic SR-HB184KRA tự tin là sản phẩm đáng     giá hỗ trợ cho bàn tay người phụ nữ trong gia đình.\u003c/p\u003e\r\n\u003cp style=\"text-align: center;\"\u003e\u003cimg title=\"Nồi Cơm Điện Tử Panasonic PANC-SR-HB184KRA - 1.8 Lít\" src=\"http://tikicdn.com/media/catalog/product/p/a/panc-sr-hb184kra_13.u579.d20160524.t143847.jpg\" alt=\"Nồi Cơm Điện Tử Panasonic PANC-SR-HB184KRA - 1.8 Lít\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/media/catalog/product/p/a/panc-sr-hb184kra_1.u579.d20160524.t143838.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/p/a/panc-sr-hb184kra_1.u579.d20160524.t143838.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/p/a/panc-sr-hb184kra_1.u579.d20160524.t143838.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/p/a/panc-sr-hb184kra_1.u579.d20160524.t143838.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/p/a/panc-sr-hb184kra_1.u579.d20160524.t143838.jpg"},{"base_url":"https://salt.tikicd