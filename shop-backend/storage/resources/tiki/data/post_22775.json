,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":90000,"discount_rate":28,"rating_average":4.7,"review_count":114,"review_text":"(114)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/88/fa/39/7c7ea4c0c768222d4fa5e073150e5408.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1202,"all_time_quantity_sold":453,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eRang mộc thơm tự nhiên\u003cbr /\u003eĐược sản xuất theo hệ thống công nghệ tiên tiến trên dây chuyền hiện đại của Hà Lan\u003cbr /\u003eNguyên liệu tạo nên sản phẩm theo quy trình khép khín từ Farm to Cup được chọn lọc kĩ càng từ BMT, Đà Lạt.\u003cbr /\u003eCà phê 100% hạt rang xay nguyên chất phù hợp pha máy, café ý, phối trộn café phin\u003cbr /\u003e100% Arabica Cầu Đất Đà Lạt mang tới hương vị hấp dẫn, thơm ngon đăc trưng riêng.\u003cbr /\u003eGu nhẹ, thơm mạnh\u003cbr /\u003eBao bì cao cấp có van 1 chiều bảo quản café thơm lâu.\u003cbr /\u003eTrọng lượng 500gr bột\u003c/p\u003e\n\u003cp\u003e\u003ciframe src=\"https://www.youtube.com/embed/VEqeIV5hSGs\" width=\"560\" height=\"315\" frameborder=\"0\" allowfullscreen=\"allowfullscreen\" data-mce-fragment=\"1\"\u003e\u003c/iframe\u003e\u003c/p\u003e\n\u003cp\u003eCà phê nguyên chất, vị đắng không gắt, nhẹ, hơi ngọt, không đọng lại lâu vị đắng trong miệng, uống nước trà hay nước lọc tráng miệng là hết ngay.\u003cbr /\u003eVì lợi nhuận và không có kinh nghiệm, nhất là kiến thức về chế biến cà phê còn hạn chế, nên trên thị trường cà phê Việt nam còn rất hỗn độn, quá nhiều cơ sở chế biến cà phê ra đời, người tiêu dùng rất phân vân khi lựa chọn cho mình một loại cà phê ngon, thực phẩm an toàn.\u003cbr /\u003eTại nông trại Coffee Tree, cà phê được hái bằng tay, chọn lựa chỉ quả chín đỏ, tỉ lệ bắt buộc 90% quả đỏ, không hái tuốt, hái đại trà cả quả xanh lẫn đỏ.\u003cbr /\u003eSau khi chế biến ướt ra hạt cà phê nhân (green bean), được chọn lọc bằng tay một lần nữa loại bỏ hạt sạn, hạt mẻ, giữ hạt cà phê sạch, không mối mọt, nấm mốc. Hạt cà phê nhân được vận chuyển về nhà máy rang xay.\u003cbr /\u003eTại đây, hạt được rang bởi chuyên gia cà phê và kiểm soát chặt chẽ nhiệt độ, thời gian rang, chất lượng các mẻ rang hoàn toàn đồng nhất với nhau từ những thợ rang giàu kinh nghiệm và tâm huyết với cà phê.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/6b/6e/c2/124ba27cbcda0c4377475dbbd5932886.png\" alt=\"coffee tree đặc biệt\" width=\"750\" height=\"614\" /\u003e\u003cbr /\u003eTừ xưởng rang, cà phê được kiểm tra những khâu cuối cùng, đóng gói và phân phối khắp các cửa hàng trong hệ thống Coffee Tree, để phục vụ những tách cà phê chất lượng nhất.\u003cbr /\u003eVới sự kiểm soát quy trình khép kín từ nông trại đến tách cà phê cuối cùng đến tay khách hàng bằng đảm bảo ở tất cả các khâu: giống cà phê tốt, quy trình chăm bón – thu hoạch, quy trình sơ chế, chế biến, rang xay.\u003c/p\u003e\n\u003cp\u003eNHẬN BIẾT CÀ PHÊ NGUYÊN CHẤT NHƯ THẾ NÀO\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/51/69/d1/4bce0cb8a20128e5c38ca059cfffc4d2.png\" alt=\"nhận biết cà phê nguyên chất,tạp chất\" width=\"750\" height=\"593\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/88/fa/39/7c7ea4c0c768222d4fa5e073150e5408.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/88/fa/39/7c7ea4c0c768222d4fa5e073150e5408.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/88/fa/39/7c7ea4c0c768222d4fa5e073150e5408.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/88/fa/39/7c7ea4c0c768222d4fa5e073150e5408.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/88/fa/39/7c7ea4c0c768222d4fa5e073150e5408.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/43/f9/87/ae17d37691274c09b5e06d44469e29a6.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/43/f9/87/ae17d37691274c09b5e06d44469e29a6.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/43/f9/87/ae17d37691274c09b5e06d44469e29a6.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/43/f9/87/ae17d37691274c09b5e06d44469e29a6.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/43/f9/87/ae17d37691274c09b5e06d44469e29a6.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/d0/cd/2f/5f7e64ba86713f28cc8bdc1d82afc952.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d0/cd/2f/5f7e64ba86713f28cc8bdc1d82afc952.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d0/cd/2f/5f7e64ba86713f28cc8bdc1d82afc952.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d0/cd/2f/5f7e64ba86713f28cc8bdc1d82afc952.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d0/cd/2f/5f7e64ba86713f28cc8bdc1d82afc952.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/ec/0d/3c/1759fe469ed8bd502994ca5e3d657