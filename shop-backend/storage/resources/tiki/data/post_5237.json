:"(217)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/01/3b/f9/09fd08f6165d0e5bbb4f6775021573ca.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1933,"all_time_quantity_sold":1565,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3 class=\"Title__TitledStyled-sc-c64ni5-0 iXccQY\"\u003eSữa dưỡng ẩm Johnson's Baby mềm mịn (200ml)\u003c/h3\u003e\n\u003ch3\u003e\u003cstrong\u003eGiới thiệu\u003c/strong\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cspan style=\"font-weight:400;\"\u003eSữa dưỡng ẩm Johnson's Baby mềm mịn (200ml) dành cho làn da bé mỏng hơn 30% so với da người lớn, do đó cần được nâng niu chăm sóc tuyệt đối nhẹ nhàng và yêu thương.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003e\u003cstrong\u003eThành phần\u003c/strong\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cspan style=\"font-weight:400;\"\u003eGạo và sữa, vitamin A, E và các tinh chất dưỡng\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003e\u003cstrong\u003eĐặc điểm nổi bật\u003c/strong\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cspan style=\"font-weight:400;\"\u003eCông thức sữa dưỡng thể nước độc đáo hòa quyện với sợi bông từ thiên nhiên\u003c/span\u003e\u003c/li\u003e\n\u003cli\u003e\u003cspan style=\"font-weight:400;\"\u003eDịu nhè, không bám rít\u003c/span\u003e\u003c/li\u003e\n\u003cli\u003e\u003cspan style=\"font-weight:400;\"\u003eĐược chứng minh lâm sàng an toàn đối với trẻ sơ sinh\u003c/span\u003e\u003c/li\u003e\n\u003cli\u003e\u003cspan style=\"font-weight:400;\"\u003eGiúp nuôi dưỡng làn da bé ngay trong lần sử dụng đầu tiên\u003c/span\u003e\u003c/li\u003e\n\u003cli\u003e\u003cspan style=\"font-weight:400;\"\u003eKhông chứa paraben, phthalate hoặc thuốc nhuộm\u003c/span\u003e\u003c/li\u003e\n\u003cli\u003e\u003cspan style=\"font-weight:400;\"\u003eMang đến tác dụng dưỡng ẩm tuyệt vời lên đến 24h, cho da bé luôn mềm mịn\u003c/span\u003e\u003c/li\u003e\n\u003cli\u003e\u003cspan style=\"font-weight:400;\"\u003eHương thơm dịu nhẹ cho cả mẹ và bé luôn thoải mái, thư giãn.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003e\u003cstrong\u003eCông dụng\u003c/strong\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cspan style=\"font-weight:400;\"\u003eDưỡng ẩm, giữ da bé luôn mềm mịn\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003e\u003cstrong\u003eHướng dẫn sử dụng\u003c/strong\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cspan style=\"font-weight:400;\"\u003eSau khi tắm bằng nước ấm với sữa tắm Cotton Touch Top-to-toe, nhẹ nhàng thoa sữa dưỡng thể lên khắp người bé để mẹ và bé thêm gắn kết và giúp da bé mềm mịn hơn.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003e\u003cstrong\u003eHướng dẫn bảo quản\u003c/strong\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cspan style=\"font-weight:400;\"\u003eBảo quản ở nơi khô ráo, thoáng mát, tránh ánh nắng trực tiếp.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003e\u003cstrong\u003eLưu ý sử dụng\u003c/strong\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cspan style=\"font-weight:400;\"\u003eSử dụng dưới sự giám sát của người lớn\u003c/span\u003e\u003c/li\u003e\n\u003cli\u003e\u003cspan style=\"font-weight:400;\"\u003eĐể xa tầm tay trẻ em\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/99/7a/7d/ac4e5255a7787e4a2783337635e47cc9.jpg\" alt=\"\" width=\"750\" height=\"749\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/45/32