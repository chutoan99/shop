ll,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":75000,"discount_rate":50,"rating_average":4,"review_count":44,"review_text":"(44)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/f0/0e/bc/f2cfefc76bad2ea66551f48300afb00e.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":714,"all_time_quantity_sold":192,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2\u003eĐÈN PIN CẦM TAY SIÊU SÁNG CHIẾU XA 4 CHẾ ĐỘ SÁNG, CHỐNG THẤM NƯỚC, ĐÈN PIN MINI CÓ 4 COB LED TIỆN DỤNG\u003c/h2\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/1b/ef/2d/d50fa60d2b2395f1895dc76e8a8ab99b.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eĐèn pin LED đa chức năng có thể sạc lại và nhỏ gọn để sử dụng tại nhà.\u003c/p\u003e\n\u003cp\u003ePin lithium có thể sạc lại dung lượng lớn tích hợp, nhiều phương pháp sạc USB, phạm vi dài, tuổi thọ pin dài, độ sáng cao,\u003c/p\u003e\n\u003cp\u003eMàn hình hiển thị điện thông minh, đèn bên sáng, thích hợp cho nguồn điện khẩn cấp khi cúp điện tại nhà.\u003c/p\u003e\n\u003cp\u003eSản phẩm cao cấp công suất lớn, chống thấm nước, đèn sáng mạnh, có thể chuyển đổi 4 cấp độ theo ý muốn [ánh sáng mạnh-trung bình-ánh sáng nhấp nháy-COB hông\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/f0/0e/bc/3bfeab5b6eaba8be174622c71c1fceab.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eĐặc điểm:\u003cbr /\u003e- Sử dụng công nghệ LED siêu sáng cho ánh sáng cực mạnh, tập trung vào mục tiêu nhưng vẫn tiết kiệm năng lượng tối đa.\u003cbr /\u003e- Tiêu thụ điện cực thấp, nhưng cho bạn ánh sáng siêu sáng trong thời gian dài.\u003cbr /\u003e- Sản phẩm rất phù hợp và tiện lợi cho việc đi du lịch, đi rừng, đi câu, đi soi, cúp điện,…\u003cbr /\u003e- Đèn được dùng pin sạc, có cục sạc kết nối với đèn nên rất tiết kiệm, bền và thuận tiện.\u003cbr /\u003e- Kích thước vừa trong lòng bàn tay, thuận tiện cho việc mang theo hàng ngày và trong những trường hợp cấp thiết\u003cbr /\u003e- Pin sạc liền trong máy sử dụng tùy chế độ và độ chai pin của người sử dụng\u003cbr /\u003e- Khoảng cách chùm tia tối đa lên tới 200 mét.\u003cbr /\u003e- Mạch quản lý điện năng hiệu quả bền bỉ\u003cbr /\u003e- Chống va đập và chống nước nhẹ (không ngâm nước + phá hủy với lực mạnh)\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/c5/77/eb/c588665fcea641dba0721cd5448e0ebe.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eThông tin:\u003cbr /\u003e- Chất liệu: ABS\u003cbr /\u003e- Màu sắc: đen\u003cbr /\u003e- Trọng lượng: khoảng 175g\u003cbr /\u003e- Kích thước: khoảng 136mm × 50mm\u003cbr /\u003e- Dung lượng pin: 1200mAh\u003cbr /\u003e- Hạt đèn: 4LED + bên COB\u003cbr /\u003e- Ánh sáng mạnh-ánh sáng yếu-đèn flash-COB ánh sáng bên\u003cbr /\u003e- Lumens: khoảng 500LM\u003cbr /\u003e- Màn hình nguồn: có\u003cbr /\u003e- Không thấm nước: Không thấm nước cho cuộc sống hàng ngày\u003cbr /\u003e- Do Sự khác biệt giữa các màn hình khác nhau, hình ảnh có thể không phản ánh màu sắc thực tế của sản phẩm.\u003cbr /\u003e- Do Thủ công đo lường và các phương pháp đo lường khác nhau, xin vui lòng cho phép sai số nhỏ.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/c5/77/eb/50dd6679705d16c860cdf51cc6824b20.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/e9/72/a3/de70fdac3c280cb40514deaaaf95227d.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https:/