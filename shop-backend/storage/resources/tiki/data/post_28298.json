n_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":18000,"discount_rate":10,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/7a/6b/2b/773e373e46bd183236f82cd5fc9b19ad.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":43,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2 class=\"WjNdTR\"\u003e\u003cimg class=\"GqYslU hnult1\" src=\"https://down-vn.img.susercontent.com/file/vn-11134208-7r98o-ly0r3snduc4b5a\" alt=\"vn-11134208-7r98o-ly0r3snduc4b5a\" /\u003e\u003c/h2\u003e\n\u003cdiv class=\"Gf4Ro0\"\u003e\n\u003cdiv class=\"e8lZp3\"\u003e\n\u003cp class=\"QN2lPu\"\u003e---\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eMullinmore (Ai-len), 1987, một ngày trước đám cưới của Bernie Bradley và Michael Hegarty, một vụ tai nạn xe ô tô cướp đi sinh mạng của ba trong số sáu hành khách ngồi trên xe.\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eCòn sống với tư cách người cầm lái, Connor Hayes chìm trong hối hận tội lỗi. Cuộc sống vẫn tiếp diễn, nhưng những bí mật, cái chết và nỗi mất mát mênh mang của người ở lại sẽ không thể im lặng. Một lần nữa, Connor vẫn phải đối mặt với quá khứ của mình.\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eHành trình ra đi và trở về giúp Connor kết nối lại với những điều tưởng chừng đã mất, con người và nơi chốn đã tạo nên bản thân Connor, cả tốt đẹp lẫn xấu xa. Cùng với cú ngoặt bất ngờ của câu chuyện, sự thật đằng sau vụ tai nạn dần hé lộ cho thấy những phức tạp bên trong con người. Đặc biệt, nỗi đau về bản dạng tính dục trong mối quan hệ cá nhân và xã hội cũng được đào sâu dưới góc nhìn đầy tôn trọng sẽ khiến độc giả không thể dừng đọc áng văn giàu cảm xúc này.\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e---\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e\u003cstrong\u003eĐộc giả cuốn sách:\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e- Cộng đồng độc giả yêu văn học nói chung, đặc biệt là văn học Ai-len\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e- Cộng đồng LGBT hoặc bất cứ ai quan tâm đến chủ đề xu hướng tính dục\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e---\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e\u003cstrong\u003eGiới thiệu tác giả:\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eGraham Norton, tên thật là Graham William Walker, sinh năm 1963 ở vùng ngoại ô Dublin, Ai-len. Ông là người dẫn chương trình, phát thanh viên, diễn viên kiêm nhà văn nổi tiếng thế giới.\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eTruyện của Norton mang màu sắc bí ẩn, gắn liền với chủ đề về xu hướng tính dục và nỗi đau liên thế hệ trong các gia đình vùng tỉnh lẻ Ai-len. Ấy cũng là những đề tài thân thuộc với cuộc đời Norton, song cái nhìn dò sâu đầy nhân văn, bao dung tuổi ngoài ngũ tuần mới thực sự khơi mở định hướng sáng tác cho ông.\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eMột số tác phẩm nổi bật của ông gồm tiểu thuyết Chặng cuối, Còn giữ (Holding), Người giữ nhà (A keeper), Mái ấm vĩnh hằng (Forever Home),...\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e----\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e QUÀ TẶNG KÈM CHO CÁC ĐƠN HÀNG ĐẦU TIÊN: 1 BÚT KÈM SÁCH (như hình, số lượng có hạn) \u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e \u003c/p\u003e\n\u003cdiv class=\"QN2lPu\"\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"P7IbkE\"\u003e\u003cimg class=\"GqYslU hnult1\" src=\"https://down-vn.img.susercontent.com/file/vn-11134208-7r98o-lya5kbl70nd971\" alt=\"vn-11134208-7r98o-lya5kbl70nd971\" /\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/7a/6b/2b/773e373e46bd183236f82cd5fc9b19ad.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/7a/6b/2b/773e373e46bd183236f82cd5fc9b19ad.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/7a/6b/2b/773e373e46bd183236f82cd5fc9b19ad.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7a/6b/2b/773e373e46bd183236f82cd5fc9b19ad.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7a/6b/2b/773e373e46bd183236f82cd5fc9b19ad.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/20/1e/78/0973e4ec8581fd75bb6c7f6f853d660d.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/20/1e/78/0973e4ec8581fd75bb6c7f6f853d660d.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/20/1e/78/0973e4ec8581fd75bb6c7f6f853d660d.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/20/1e/78/0973e4ec8581fd75bb6c7f6f853d660d.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/20/1e/78/0973e4ec8581fd75bb6c7f6f853d660d.png"},{"base_url":"https://salt.tikicdn.com/ts/product/c3/91/92/3d18ef3e0ccaabbb9b18369a6eade0ea.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c3/91/92/3d18ef3e0ccaabbb9b18369a6eade0ea.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c3/91/92/3d18ef3e0ccaabbb9b18369a6eade0ea.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts