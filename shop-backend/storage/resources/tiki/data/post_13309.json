_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.6,"review_count":176,"review_text":"(176)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/4f/90/b9/57e1f7ac85daa186ca745eb3597c7daf.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2235,"all_time_quantity_sold":568,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp data-spm-anchor-id=\"a2o4n.pdp.product_detail.i0.ce4e60f4yEwxUg\"\u003e\u003cspan style=\"color: #666666; font-family: Roboto, sans-serif; font-size: 16.38px; font-weight: bold;\"\u003eMũ Bảo Hiểm GRS a966k kính giấu, tháo lót:\u003c/span\u003e\u003c/p\u003e\n\u003cp data-spm-anchor-id=\"a2o4n.pdp.product_detail.i0.ce4e60f4yEwxUg\"\u003eMũ bảo hiểm GRS 966 1 kính là phiên bản không có kính bảo hộ bên ngoài mà chỉ có lớp kính râm giấu bên trong mũ, có thể kéo lên xuống rất tiện lợi khi bạn cần sử dụng. Với dòng sản phẩm này, GRS 966k 1 kính sẽ là một sự lựa chọn mới cho những ai có nhu cầu mũ bảo hiểm nhẹ và tiện lợi. Khi ra đường không cần sợ quên kính mát, không cần lỉnh kỉnh chuẩn bị nhiều phụ kiện, GRS 966k tích hợp các phụ kiện cần thiết để bảo vệ bạn khi ra đường.\u003c/p\u003e\n\u003cp\u003eGRS 966 1 kính được tỉnh giảm lớp kính bảo hộ bên ngoài giúp trọng lượng mũ trở nên nhẹ hơn, kích thước mũ cũng ôm gọn nên dù nam hay nữ cũng phù hợp khi dùng sản phẩm này.\u003c/p\u003e\n\u003cp\u003eGRS thấu hiểu những khó chịu của bạn khi đội mũ bảo hiểm bốc mùi khó chịu? Hay bất lực trước cảm giác ngứa ngáy da đầu khi đang lái xe? Hoặc bức rức đội chiếc mũ ẩm ướt mồ hôi trong nắng trưa gay gắt? nên đã cho ra đời dòng sản phẩm với lớp vải lót tháo lắp tiện dụng. Chỉ mất 30 giây thay thế vải lót để có một chiếc mũ bảo hiểm mới Sạch sẽ, Sức khỏe, Sảng khoái, giúp bạn phòng tránh các bệnh về tóc và da đầu.\u003cbr /\u003eThiết kế thông minh giúp bạn dễ dàng tháo lắp vải lót để thay thế, vệ sinh đơn giản, mau khô.\u003cbr /\u003e– Vải lót cao cấp được xử lý có khả năng kháng khuẩn, thấm hút tốt, mau khô, giúp hạn chế nguy cơ mắc các bệnh về tóc và da đầu.Vải lót có kết cấu màng lưới lớn, cho phép không khí lưu thông dễ dàng vào bên trong tạo cảm giác thoáng mát và dễ chịu.\u003cbr /\u003e– Sợi vải bền chắc, giúp bạn có thể giặt, vệ sinh thường xuyên mỗi ngày\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cstrong\u003e*** Thông tin thương hiệu:\u003c/strong\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003eGRS hiện đang là nhãn hiệu mũ bảo hiểm rất phổ biến và được ưa chuộng tại Việt Nam, với nguyên liệu nhập khẩu 100% từ Đài Loan bảo đảm về chất lượng, có tem hợp quy CR (tem chứng nhận đạt chuẩn theo TCVN) dán sau mũ.\u003cbr /\u003eMô tả chung về sản phẩm:\u003cbr /\u003e– GRS là nhãn hàng đến từ Đài Loan.\u003cbr /\u003e– Chất liệu hạt nhựa ABS , chống va đập, xuyên thủng rất tốt.\u003cbr /\u003e– Kính mũ đặc biệt chống lóa, độ bền tốt, độ đàn hồi tốt.\u003cbr /\u003e– Lớp vải lót của mũ có khả năng kháng khuẩn, hút ẩm tốt, dễ dàng vệ sinh.\u003cbr /\u003e– Khóa dây quai chất lượng cao, bền bỉ, chịu lực mạnh, độ dài linh hoạt.\u003cbr /\u003e– Lớp mút xốp cứng, được thiết kế bám sát vào vỏ mũ nên dễ dàng phân tán lực khi có va đập.\u003cbr /\u003e– Mũ có tem đảm bảo chất lượng tiêu chuẩn CR của Việt Nam\u003c/p\u003e\n\u003cp data-spm-anchor-id=\"a2o4n.pdp.product_detail.i1.ce4e60f4yEwxUg\"\u003e\u003cem\u003e\u003cstrong\u003e*** Hướng dẫn xác định cỡ mũ phù hợp:\u003c/strong\u003e\u003c/em\u003e Vòng 1 sợi dây quanh đầu, phía trên lông mày và tai khoảng 2cm. Xiết sợi dây sao cho ôm vừa đủ thoải mái lấy đầu và ghi lại số đo đó. Lặp lại như vậy để tìm được số đo mà bạn thấy đầu dễ chịu. Đó chính là size đầu của bạn. So sánh với kích cỡ mũ để lựa chọn size mũ phù hợp.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/4f/90/b9/57e1f7ac85daa186ca745eb3597c7daf.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/4f/90/b9/57e1f7ac85daa186ca745eb3597c7daf.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/4f/90/b9/57e1f7ac85daa186ca745eb3597c7daf.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4f/90/b9/57e1f7ac85daa186ca745eb3597c7daf.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4f/90/b9/57e1f7ac85daa186ca745eb3597c7daf.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/73/1b/67/15739775ecee6dc1032c58563dc90644.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/73/1b/67/15739775ecee6dc1032c58563dc90644.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/73/1b/67/15739775ecee6dc1032c58563dc90644.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/73/1b/67/15739775ecee6dc1032c58563dc90644.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/73/1b/67/15739775ecee6dc1032c58563dc90644.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/d6/26/77/19f16925a28979f8cd59646bff182a99.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d6/26/77/19f16925a28979f8cd59646bff182a99.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d6/26/77/19f16925a28979f8cd59646bff182a99.jpg"