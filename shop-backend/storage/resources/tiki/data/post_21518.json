":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":325000,"discount_rate":25,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/a0/76/b4/cd5a8205dd8c008993a0a6733585ad83.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":912,"all_time_quantity_sold":11,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eMang theo sự pha trộn thú vị giữa retro và vintage, nhiều chút nổi loạn và bản sắc thời trang đậm chất cá nhân, siêu phẩm Woodrose trong thiết kế mới hứa hẹn sẽ giúp bạn tỏa sáng theo cách riêng của mình. Tạo nên cơn sốt mới trong hình tượng mới với Item mê đắm lòng người này!\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThông tin sản phẩm:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eMàu: XANH AQUA\u003c/li\u003e\n\u003cli\u003eSize: XS S M L XL \u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/1e/01/57/053f51354e4cc1a35d3dda68cfb00aa8.jpg\" alt=\"\" width=\"750\" height=\"502\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e(Cân nặng dựa trên người mẫu cao 1m60)\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003eDù bạn ốm, vừa, hơi mập hay quá khổ thì set tập Yoga H140 vẫn có thể chiều bạn tất tần tật, ngay cả quần áo big size. \u003cstrong\u003eSet tập Yoga H140\u003c/strong\u003e sẽ làm suôn mềm mọi vóng dóc cả những vóc dáng khó đỡ nhất. Còn chần chờ gì nữa, hãy đến với Item H140 để lựa chọn cho mình những bộ quần áo tập Yoga - Gym thời trang và trở thành quý cô thời thượng nhất ở phòng tập bạn nhé!\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/a0/76/b4/273393f0422c108dd14342a1f9984f4d.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eVỀ GIAN HÀNG CHÚNG TÔI\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003eKhơi nguồn từ lòng đam mê tập Yoga - Gym, thấu hiểu rõ các nỗi lòng của các cô gái trong việc lựa chọn đồ thể thao, khát khao mang đến sự tự tin và thoải mái vận động cho tất cả các cô gái trong các buổi luyện tập và hơn thế nữa là mong muốn được góp phần tạo dựng hình ảnh mới lạ cho ngành công nghiệp thời trang thể thao Việt Nam. Chúng tôi đã tập trung đầu tư vào chất lượng và kiểu dáng sản phẩm với phương châm \u003cstrong\u003e“HEALTH AND BEAUTY – KHỎE VÀ ĐẸP\"\u003c/strong\u003e.\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003eGIAN HÀNG CHÚNG TÔI\u003c/strong\u003e tin rằng một trang phục tập Yoga - Gym tốt sẽ giúp bạn đạt được năng lượng tối đa trong mỗi buổi luyện tập. Kết hợp với phong cách minimalism trong từng thiết kế, ôm trọn đường cong cơ thể, tôn dáng người mặc. Tất cả tạo nên một thương hiệu khác biệt, với hai tiêu chí cụ thể: hỗ trợ tối đa khi tập luyện và giúp bạn luôn tự tin tỏa sáng.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/6f/a3/b5/d21aef198ff99162cae11a10f5d8b103.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003eSản phẩm \u003cstrong\u003eSet tập yoga H140\u003c/strong\u003e được thiết kế luôn mang đậm phong cách độc đáo và kết hợp hài hoà với các xu hướng thời trang thể thao mới của năm để tạo nên nét cá tính riêng cho từng sản phẩm. Đây cũng chính là phong cách chủ đạo được theo đuổi trong suốt hành trình sáng tạo thời trang thể thao của chúng tôi.\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003eTại gian hàng chúng tôi, các mẫu thiết kế liên tục được kiểm duyệt kĩ càng ở từng khâu lựa chọn chất liệu, dựng mẫu và hoàn thiện. Với đội ngũ thiết kế chuyên nghiệp, đội ngũ thợ may tận tụy và đội ngũ bán hàng đầy tâm huyết được đào tạo bài bản về chuyên môn và kinh nghiệm nhiều năm, hy vọng sẽ làm hài lòng cả những khách hàng khó tính nhất.\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cstrong\u003eThời trang thể thao cao cấp - Chuyên Đồ tập yoga - Đồ tập gym - Đồ tập aerobic\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/11/ec/74/2bd64e8b28881be4c491ec21231996b1.jpg\" alt=\"\" width=\"750\" height=\"284\" /\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/a0/76/b4/cd5a8205dd8c008993a0a6733585ad83.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a0/76/b4/cd5a8205dd8c008993a0a6733585ad83.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a0/76/b4/cd5a8205dd8c008993a0a6733585ad83.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a0/76/b4/cd5a8205dd8c008993a0a6733585ad83.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a0/76/b4/cd5a8205dd8c008993a0a6733585ad83.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/8b/fc/be/c2671a5f560899091472ce58942447c9.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/8b/fc/be/c2671a5f560899091472ce58942447c9.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/