urn_reason":"any_reason"}},"discount":70000,"discount_rate":50,"rating_average":4.5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/a1/56/c6/8e32cc303c5fb85cc41a5d782d4f1f09.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":742,"all_time_quantity_sold":10,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2\u003eĐIỂM NỔI BẬT CỦA KHUNG NẮN CHỈNH CỘT SỐNG LƯNG EMA\u003c/h2\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/a3/29/f0/f33083ffc4f51af7449b77202afd698b.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e- Trên khung có 10 gai nam châm từ tính cùng 96 gai nhỏ giúp massage lưng\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/1d/56/d7/1f9de0b6b2c05c7e66807d5fcf7f5748.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e- 4 nấc điều chỉnh dễ dàng giúp người dùng thoải mái chỉnh cột sống lưng\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/d1/fb/2d/b9abc8039b601945514ce7e4f2610d5c.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e- Chất liệu cao cấp với nhựa PP và xốp NBR\u003c/p\u003e\n\u003ch2\u003eCÔNG DỤNG CỦA KHUNG NẮN CHỈNH CỘT SỐNG LƯNG EMA\u003c/h2\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/a1/56/c6/56923b008cd76d98c29a923276e61b64.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e- Kéo giãn cột sống lưng, giảm đau mỏi thắt lưng đối với những người phải ngồi nhiều như nhân viên văn phòng, lái xe, thu ngân, sinh viê\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/ea/ce/c3/b124c2e546e1e24e80b48304c0308d99.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e- Thư giãn cột sống lưng, dùng thường xuyên giúp ngăn ngừa thoát vị đĩa đệm\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/ca/7b/18/53eab8d7cc6029e8370c3b843ae7697c.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch2\u003eTHÔNG TIN SẢN PHẨM KHUNG NẮN CHỈNH CỘT SỐNG LƯNG EMA\u003c/h2\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/6b/f3/76/d195af42b99b6f8d76c0c1f8f5cb3198.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e- Kích thước: 38x26cm\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/9b/de/76/814a25e18eb01f981a1efd8ad73acd26.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e- Khối lượng: 500g\u003c/p\u003e\n\u003cp\u003e- Chất liệu: Nhựa PP siêu chịu lực, độ bền lớn kết hợp với xốp NBR\u003c/p\u003e\n\u003ch2\u003eHƯỚNG DẪN SỬ DỤNG KHUNG NẮN CHỈNH CỘT SỐNG LƯNG EMA\u003c/h2\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/2d/04/2b/96638d27b1ba84b212151f741fa46d9c.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e- Bước 1: Lắp ráp khung, điều chỉnh độ cong, dộ dốc của khung phù hơp nhu cầu, nên bắt đầu với những nấc thấp nhất\u003c/p\u003e\n\u003cp\u003e- Bước 2: Ngồi thẳng lưng, sát vào phần cuối của khung. Từ từ hạ người xuống, lấy 2 tay đỡ cho đến khi nằm hoàn toàn trên khung\u003c/p\u003e\n\u003cp\u003e- Bước 3: Sử dụng 15-20 phút mỗi ngày để giảm đau lưng, hỗ trợ ngăn ngừa thoái hóa, thoát vị đĩa đệm\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/a1/56/c6/8e32cc303c5fb85cc41a5d782d4f1f09.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a1/56/c6/8e32cc303c5fb85cc41a5d782d4f1f09.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a1/56/c6/8e32cc303c5fb85cc41a5d782d4f1f09.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a1/56/c6/8e32cc303c5fb85cc41a5d782d4f1f09.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a1/56/c6/8e32cc303c5fb85cc41a5d782d4f1f09.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/1d/56/d7/e2e54081fb8b688592364448b8c1c47b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/1d/56/d7/e2e54081fb8b688592364448b8c1c47b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/1d/56/d7/e2e54081fb8b688592364448b8c1c47b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1d/56/d7/e2e54081fb8b688592364448b8c1c47b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1d/56/d7/e2e54081fb8b688592364448b8c1c47b.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/2d/04/2b/570e7ce6fd328808eae0c25b52d6ce8d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/2d/04/2b/570e7ce6fd328808eae0c25b52d6ce8d.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/2d/04/2b/570e7ce6