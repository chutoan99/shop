 thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/a7/61/c2/df4cff69ab561e22570703523f860d1e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a7/61/c2/df4cff69ab561e22570703523f860d1e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a7/61/c2/df4cff69ab561e22570703523f860d1e.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a7/61/c2/df4cff69ab561e22570703523f860d1e.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a7/61/c2/df4cff69ab561e22570703523f860d1e.jpg"}],"warranty_policy":null,"authors":[{"id":847665,"name":"Megan Sussman","slug":"megan-sussman"}],"current_seller":{"id":109134,"sku":"5215783304343","name":"Đinh Tị Books Official","link":"https://tiki.vn/cua-hang/nha-sach-dinh-ti","logo":"c7/e2/43/da051f99f650955de23ab5c8bd33b1ba.jpg","price":40000,"product_id":"249941610","store_id":101016,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Thông tin chung","attributes":[{"code":"publisher_vn","name":"Công ty phát hành","value":"Đinh Tị"},{"code":"publication_date","name":"Ngày xuất bản","value":"2021-08-15 00:00:00"},{"code":"dimensions","name":"Kích thước","value":"19 x 24 cm"},{"code":"dich_gia","name":"Dịch Giả","value":"(Phỏng theo truyện ngụ ngôn Aesop)-Minh Trang-Minh họa: Lim Chansook"},{"code":"book_cover","name":"Loại bìa","value":"Bìa mềm"},{"code":"number_of_page","name":"Số trang","value":"42"},{"code":"manufacturer","name":"Nhà xuất bản","value":"Nhà Xuất Bản Thanh Niên"}]}],"product_links":[],"gift_item_title":"0 quà tặng kèm","configurable_options":[{"code":"option1","name":"Chủ đề","posi