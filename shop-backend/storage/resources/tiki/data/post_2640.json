ng câu chuyện kinh điển này các em nhé!\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/75/ad/fb/e458339c8893114a9192025dc45ab108.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/75/ad/fb/e458339c8893114a9192025dc45ab108.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/75/ad/fb/e458339c8893114a9192025dc45ab108.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/75/ad/fb/e458339c8893114a9192025dc45ab108.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/75/ad/fb/e458339c8893114a9192025dc45ab108.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/05/11/c1/e8138ac36e6301fa85a6c5bb7c6ba03f.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/05/11/c1/e8138ac36e6301fa85a6c5bb7c6ba03f.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/05/11/c1/e8138ac36e6301fa85a6c5bb7c6ba03f.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/05/11/c1/e8138ac36e6301fa85a6c5bb7c6ba03f.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/05/11/c1/e8138ac36e6301fa85a6c5bb7c6ba03f.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/46/ef/2e/3db842aa1ba563c88b5211e066045a0b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/46/ef/2e/3db842aa1ba563c88b5211e066045a0b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/46/ef/2e/3db842aa1ba563c88b5211e066045a0b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/46/ef/2e/3db842aa1ba563