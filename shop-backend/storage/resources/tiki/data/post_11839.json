n_height":0,"text_color":"#FFF0F1","background_color":"#D93843","href":null,"text":"9.9"},{"placement":"pdp_badge","code":"is_hero","type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":true,"return_reason":"any_reason"}},"discount":7000,"discount_rate":14,"rating_average":5,"review_count":10,"review_text":"(10)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/b0/1f/e6/64674a731a5f18771df1468f2aae8b4c.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1044,"all_time_quantity_sold":116,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p><strong> Thông tin sản phẩm</strong></p>\n<p>Combo An Lành gồm có :</p>\n<p>+ 1 túi trầm Bình An</p>\n<p>+ 1 vòng tay chỉ đỏ may mắn</p>\n<p>+ 1 nụ nhang Trầm Hương cao cấp - 12 năm tích trầm</p>\n<p><span style=\"font-weight: 400;\">Túi gấm đỏ bao bọc bên ngoài từ làng nghề dệt gấm La Khê nổi tiếng, được thêu thủ công với họa tiết rồng phượng tinh xảo.  Sụ Kết hợp giữa vòng chỉ đỏ may mắn và túi vải Bình An giúp lưu giữ nguồn năng lượng tích cực, may mắn nhờ đó gia chủ luôn hạnh phúc trong cuộc sống và hanh thông trong công việc.</span></p>\n<p> </p>\n<p><span style=\"font-weight: 400;\"><img src=\"https://salt.tikicdn.com/ts/tmp/ce/fc/4e/c9e3bca7d6bc463ff82dbcf429abd857.jpg\" alt=\"\" width=\"750\" height=\"750\" /></span></p>\n<p><span style=\"font-weight: 400;\"><strong>I. Túi trầm bình an:</strong>  </span></p>\n<p><span style=\"font-weight: 400;\">- Đã từ lâu, túi đỏ được xem như biểu trưng của tiền tài.  </span></p>\n<p><span style=\"font-weight: 400;\">- Sản phẩm túi vải đỏ được thiết kế theo nguyên tắc túi tiền của Thần Tài, bao vải của Ngài Di Lặc, nhờ vậy mà có công năng giữ gìn tài sản và gia tăng tài lộc.</span></p>\n<p><span style=\"font-weight: 400;\">- Bên trong túi đỏ chứa nhang nụ Trầm Hương tự nhiên và chỉ đỏ may mắn. </span><span style=\"font-weight: 400;\">Túi Trầm Bình An, có khả năng hóa giải điềm xấu, mang tới điềm lành, hạnh phúc cho gia chủ. </span></p>\n<p><span style=\"font-weight: 400;\"><br /><img src=\"https://salt.tikicdn.com/ts/tmp/f5/9d/1c/a5e2b65bfdc1d7af251987422be5eb3b.jpg\" alt=\"\" width=\"750\" height=\"750\" /><br /></span></p>\n<p><strong>II. Vòng chỉ đỏ:</strong></p>\n<p><span style=\"font-weight: 400;\">- </span><span style=\"font-weight: 400;\">Khởi nguồn từ sợi chỉ đỏ của ông Tơ bà Nguyện dùng để gắn kết lứa đôi. Vòng chỉ đỏ đã được văn hóa Á Đông tiếp nhận và xem như là một bảo vật cầu may, cầu an, thể hiện cho giao ước của con người và Trời Phật.</span></p>\n<p><span style=\"font-weight: 400;\">- Chính vì thế mà vòng chỉ đỏ đã xuất hiện ở hầu khắp các đền chùa vào mỗi dịp lễ tết. Sau khi thực hiện các nghi thức tế lễ, vòng chỉ đỏ được xem là lộc Thánh, lộc Phật dành cho khách thập phương. </span></p>\n<p><span style=\"font-weight: 400;\">- Nhờ công năng diệu dụng ấy, mà vòng chỉ đỏ còn được kết hợp với các biểu tượng, các linh phù làm từ gốm, gỗ, vàng, bạc giúp phù trợ và bảo mệnh cho người đeo.</span></p>\n<p><span style=\"font-weight: 400;\"><img src=\"https://salt.tikicdn.com/ts/tmp/e8/84/31/07e8039187a4c79914b8cd21b9e70cae.jpg\" alt=\"\" width=\"750\" height=\"750\" /></span></p>\n<p><strong>III. Nhang nụ Trầm Hương: </strong></p>\n<p><strong>Trầm Hương tự nhiên - loại gỗ quý hiếm, với hương thơm tinh túy từ tự nhiên của Trầm hương.</strong></p>\n<p>- Công dụng: Được sử dụng trong không gian thờ cúng nhằm thanh lọc không khí, xua tan vận rủ</p>\n<p>** Trong gia đình<br />- Dùng trong không gian thờ cúng, tạo sự tưởng nhớ biết ơn và cầu nguyện cho con cháu bình an, gia đình hòa thuận.<br />- Thanh lọc không gian sống, tiêu trừ các loại mùi hương xấu, thu hút hạnh phúc, tài lộc.<br />- Xông nhà, trà đạo hoặc yoga giúp tinh thần thông thoáng, cải thiện sức khỏe.<br />- Xông hương chiêu tài dẫn lộc dịp khai trương, tân gia, tất niên,…</p>\n<p>** Trong văn phòng:<br />- Mùi hương tạo cảm giác thư giãn, giảm áp lực, căng thẳng, cải thiến sự tập trung đáng kể.<br />- Làm thơm không gian làm việc, làm dịu nhẹ thần kinh và kích thích khả năng tư duy sáng tạo.</p>\n<p>- Thời gian cháy:<br />+ Đối với nhang nụ :15 - 20 phút/nụ<br />+ Đối với nhang khoanh : 35 - 40 phút/khoanh</p>\n<p>- Cam kết 100% Trầm Hương tự nhiên - an toàn - thơm dịu</p>\n<p>- Xuất xứ: Việt Nam</p>\n<p>- Năm tích trầm: 8 - 12 năm</p>\n<p> </p>\n<p> </p>\n<p> </p>\n<p> </p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/b0/1f/e6/64674a731a5f18771df1468f2aae8b4c.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b0/1f/e6/64674a731a5f18771df1468f2aae8b4c.jpg","medium_url":"https://salt.tikicdn.com/cache/w