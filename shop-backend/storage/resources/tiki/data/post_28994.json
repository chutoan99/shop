,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":39000,"discount_rate":28,"rating_average":4,"review_count":3,"review_text":"(3)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/24/64/5d/06df24fd3df134b24714ca953e6f3599.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":866,"all_time_quantity_sold":58,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eTRÍ TUỆ của NGƯỜI XƯA\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eTrí tuệ và mưu kế của người xưa về chính trị, quân sự cũng như xử thế, được ghi chép lại thành các điển tích nổi tiếng. Cuốn sách Trí tuệ của người xưa biên soạn lại những điển tích nổi bật nhất theo các thời kỳ, nội dung của cuốn sách có thể xem là tinh hoa phản ánh tư duy, học thức và ứng biến của người xưa, làm bài học đáng ngẫm cho hậu thế.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/94/fc/01/bba4f6543a38fa24ca6c609000d25f42.jpg\" alt=\"\" width=\"750\" height=\"618\"\u003e\u003c/p\u003e\n\u003cp\u003eCuốn sách mở ra cho bạn thấy những tấm lương về năng lực phán đoán, phân tích và năng lực phát minh sáng tạo phi phàm của các nhân vật thông minh giàu trí tuệ. Và bạn sẽ thấy “một cung điện tri thức huy hoàng tráng lệ, xây bằng những viên đá kim cương đầy ắp ánh hào quang, lỗng lẫy muôn màu. Tuy bạn nhìn thấy cánh cửa của cung điện ấy đang khóa chặt im ỉm, thế nhưng, bạn có thể cảm nhận được, trong tay bạn đã xuất hiện một chiếc chìa khóa vàng, óng ánh rực rỡ, bạn có thể bước vào trong đó được – nếu như bạn có thể lĩnh hội được phương pháp và kỹ xảo tư duy của các nhân vật thông minh, giàu trí tuệ đó”.\u003c/p\u003e\n\u003cp\u003eCuốn sách \u003cstrong\u003eTRÍ TUỆ của NGƯỜI XƯA\u003c/strong\u003e - dẫn lối vào thế giới trí tuệ của người xưa với những mưu lược đầy sắc sảo của những người được coi là đỉnh cao trí tuệ của thời bấy giờ.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/24/64/5d/06df24fd3df134b24714ca953e6f3599.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/24/64/5d/06df24fd3df134b24714ca953e6f3599.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/24/64/5d/06df24fd3df134b24714ca953e6f3599.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/24/64/5d/06df24fd3df134b24714ca953e6f3599.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/24/64/5d/06df24fd3df134b24714ca953e6f3599.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/24/64/5d/3daefce9c328d06f9f833dc8989f4ec6.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/24/64/5d/3daefce9c328d06f9f833dc8989f4ec6.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/24/64/5d/3daefce9c328d06f9f833dc8989f4ec6.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/24/64/5d/3daefce9c328d06f9f833dc8989f4ec6.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/24/64/5d/3daefce9c328d06f9f833dc8989f4ec6.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/5f/93/f9/395ddf42620da5cb21d41357ad5499ee.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.