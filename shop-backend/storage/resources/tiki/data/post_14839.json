con_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":3.7,"review_count":3,"review_text":"(3)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/8c/af/6c/00e239a3990144ea263080ad384e0ac6.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1675,"all_time_quantity_sold":3,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cspan\u003eNước dưỡng ẩm chống lão hóa Naris Uruoi Collagen Moisturizing Lotion với thành phần lành tính từ thiên nhiên, không chứa cồn. Giúp cân bằng độ PH cho da để cấp nước và dưỡng chất đi thẳng vào da tối ưu.\u003cbr /\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/7b/9f/9e/4d5fe0126255707f9cdd120161348c7a.jpg\" alt=\"\" width=\"500\" height=\"501\" /\u003e\u003cbr /\u003eƯu điểm vượt trội:\u003cbr /\u003e- Giúp cân bằng độ PH ở mức lý tưởng (5,5 – 6,2). Giảm tình trạng khô da, kích ứng, bong tróc\u003cbr /\u003e- Cung cấp độ ẩm sâu, nhẹ nhàng lành tính, không chứa cồn\u003cbr /\u003e- Giúp những làn da thiếu sức sống, tối màu, sẽ trở nên ẩm mịn, bừng sức sống\u003cbr /\u003e- Tạo hàng rào chắn bảo vệ, ngăn chặn sự thất thoát độ ẩm.\u003cbr /\u003e- Hỗ trợ se khít lỗ chân lông, ngăn ngừa lão hóa, tăng độ đàn hồi và giúp da săn chắc.\u003cbr /\u003e- Giúp các bước dưỡng sau thẩm thấu tốt và hiệu quả hơn.\u003cbr /\u003e\u003cbr /\u003eThành phần sản phẩm:\u003cbr /\u003e- Triple collagen: phân hóa thành 3 phân tử khác nhau đi sâu vào 3 tầng da : Water Solute Collagen, Super Collagen, Collagen hấp thụ cao.\u003cbr /\u003e- Hyaluronicacid: chiết xuất từ sữa ong chúa, giữ độ ẩm cao, tạo cảm giác mịn màng cho làn da.\u003cbr /\u003e- Tinh dầu cam: chống oxy hóa, làm sáng da.\u003cbr /\u003e\u003cbr /\u003eHướng dẫn sử dụng\u003cbr /\u003eSau khi làm sạch da, lấy 7-9 giọt nước dưỡng vào bông tẩy trang lau nhẹ nhàng trên da theo chiều cấu tạo da. Sử dụng sản phẩm 2 lần / ngày.\u003cbr /\u003e\u003cbr /\u003eBảo quản: \u003cbr /\u003e- Nơi khô ráo, thoáng mát.\u003cbr /\u003e- Tránh ánh nắng trực tiếp, nơi có nhiệt độ cao hoặc ẩm ướt.\u003cbr /\u003e- Đậy nắp kín sau khi sử dụng\u003cbr /\u003e\u003cbr /\u003eDung tích: 180ml\u003cbr /\u003eThương hiệu: Naris Cosmetic\u003cbr /\u003eXuất xứ thương hiệu: Nhật Bản\u003cbr /\u003eKhuyến cáo: Sản phẩm không phải là thuốc, không có tác dụng thay thế thuốc chữa bệnh\u003cbr /\u003eHạn sử dụng: 5 năm kể từ ngày sản xuất\u003cbr /\u003e\u003cbr /\u003eRa đời từ năm 1932, Naris Cosmetics là một thương hiệu mỹ phẩm cao cấp Nhật Bản là bí quyết kì diệu để gìn giữ và duy trì làn da khỏe đẹp. Những sản phẩm của Naris đạt chứng nhận sản xuất theo quy trình công nghệ tiên tiến hàng đầu tại Nhật Bản, luôn nghiên cứu và phát triển sản phẩm sau mỗi năm để nâng cao hiệu quả sử dụng.\u003cbr /\u003eNgoài ra, Naris không bao giờ thử nghiệm trên động vật. Chúng tôi cũng thực hiện cam kết giảm thiểu cacbon và giảm sức ép rác thải ra trái đất. Các mỹ phẩm của Naris, 100% từ thiên nhiên, hoàn toàn không gây kích ứng da.\u003cbr /\u003e“For Others – Vì bạn” cũng chính là lời cam kết của Naris Cosmetics về chất lượng sản phẩm và dịch vụ\u003c/span\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images