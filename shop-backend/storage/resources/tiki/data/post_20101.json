ó thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ff/d1/9e/56c97fe1c7fe846e30328ad82789d223.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ff/d1/9e/56c97fe1c7fe846e30328ad82789d223.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ff/d1/9e/56c97fe1c7fe846e30328ad82789d223.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ff/d1/9e/56c97fe1c7fe846e30328ad82789d223.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ff/d1/9e/56c97fe1c7fe846e30328ad82789d223.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/5d/17/7d/472b563211831ed882ee037ae4e66abd.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/5d/17/7d/472b563211831ed882ee037ae4e66abd.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/5d/17/7d/472b563211831ed882ee037ae4e66abd.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5d/17/7d/472b563211831ed882ee037ae4e66abd.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5d/17/7d/472b563211831ed882ee037ae4e66abd.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/9c/a4/5d/6dd42cce65bb8708dafe29787e96cb18.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/9c/a4/5d/6dd42cce65bb8708dafe29787e96cb18.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/9c/a4/5d/6dd42cce65bb8708dafe29787e96cb18.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9c/a4/5d/6dd42cce65bb8708dafe29787e96cb18.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9c/a4/5d/6dd42cce65bb8708dafe29787e96cb18.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/bb/ca/d0/