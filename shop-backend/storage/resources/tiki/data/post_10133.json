ikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":38600,"discount_rate":10,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/31/37/0d/a9f9e6e82f92b0e66281afbce81af2b0.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":155,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<div class=\"product-detail page-product__detail\">\n<section class=\"I_DV_3\">\n<div class=\"Gf4Ro0\">\n<div class=\"e8lZp3\">\n<p class=\"QN2lPu\">BỘ THẢI ĐỘC ĐẠI TRÀNG BẰNG CÀ PHÊ</p>\n<p class=\"QN2lPu\">SET 7 ngày: 500 cà phê, 1 túi truyền, 7 dây truyền, 1 túi lọc, 1 móc dán tường, 1 muỗng định lượng 10g cà phê, 1 lọ dầu dừa</p>\n<p class=\"QN2lPu\">Công dụng: - Thải độc, giảm đ.ộc t.ố trong cơ thể. - Làm sạch đ.ại àng, cải thiện n.hu đ.ộng ột - Tăng cường năng lượng, cải thiện tâm trạng - Giúp giảm c.ăng t.hẳng, kh.ó c.hịu do  - Cải thiện tiêu hóa, ngừa táo bón - Giảm ệu c.hứng thèm ăn, khó chịu trong thời gian t.hải đ.ộc, ă êng hoặc c.hữa b.ệnh - Sáng da, eo thon dáng đẹ</p>\n<p class=\"QN2lPu\">Hướng dẫn: 1. Nấu cafe: - Cách 1: Đun sôi 1-1.2 lít nước rồi cho 30g cà phê vào. Tiếp tục đun hỗn hợp trên bếp trong lửa nhỏ khoảng 10 -15 phút, sau đó để nguội dung dịch. (Có thể dùng 1 trong 3 cách trong tờ hướng dẫn chi tiết đi kèm). 2. Thực hiện: - Trải tấm tập yoga, hoặc khăn tắm ra sàn nhà (nên gần hoặc trong nhà vệ sinh) - Khóa van truyền, đổ dung dịch cà phê ấm và đã lọc sạch vào bình truyền. - Mở van cho dung dịch chảy để đảm bảo không còn không khí trong dây truyền ra. Sau đó khóa van lại. - Treo bình truyền cao khoảng 1,5m so với mặt đất. - Dùng dầu dừa hoặc dầu ô liu bôi trơn phần cuối đầu truyền và hậu môn của bạn. - Nằm xuống nghiêng về phía bên trái, co chân lại. - Đưa đầu ống truyền sâu vào hậu môn khoảng 2-3 cm. - Mở van truyền để cho dung dịch chảy vào bên trong trực tràng. Bạn sẽ cảm thấy có áp lực và khí lên trực tràng khi dung dịch đi vào ruột của mình. - Sau khi dung dịch đã truyền vào hết, giữ nguyên tư thế nằm trong 10-15 phút, tay xoa bụng ngược chiều kim đồng hồ để dung dịch di chuyển sâu lên đại tràng. - Ngồi lên bồn vệ sinh. Từ từ rút đầu dây truyền ra khỏi hậu môn. Xoa bụng theo chiều kim đồng hồ để thải toàn bộ dung dịch, những chất cặn bã ra khỏi cơ thể.</p>\n<p class=\"QN2lPu\">Chế độ bảo hành: 1 đổi 1 nếu sản phẩm bị hư hỏng do lỗi của NSX hoặc trong quá trình vận chuyển #caphethaidoc #thaidoccaphe #caphethaidocdaitrang #thaidocdaitrang #coffeegerson #happylife</p>\n</div>\n</div>\n</section>\n</div>\n<div>\n<div>\n<div class=\"product-ratings\">\n<div class=\"product-ratings__header\"> </div>\n<div class=\"product-rating-overview\">\n<div class=\"product-rating-overview__filters\">\n<div class=\"product-rating-overview__filter\"> </div>\n</div>\n</div>\n<div class=\"product-ratings-comments-view__no-data\"> </div>\n</div>\n</div>\n</div><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/31/37/0d/a9f9e6e82f92b0e66281afbce81af2b0.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/31/37/0d/a9f9e6e82f92b0e66281afbce81af2b0.jpg","medium_