"type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"freeship_xtra","type":"pdp_icon_badge","index":2,"icon":"https://salt.tikicdn.com/ts/upload/be/67/48/04a82ab8df178e1a13bde38316081865.png","icon_width":91,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":true,"return_reason":"any_reason"}},"discount":183600,"discount_rate":20,"rating_average":4.5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/3d/00/23/30888e8f43a7fc23cd7621231b2ffa7a.png","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":916,"all_time_quantity_sold":3,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003e\u003cstrong\u003eĐồ Chơi LEGO TECHNIC Trực Thăng Cứu Hộ Airbus H175 42145 (2001 chi tiết)\u003c/strong\u003e\u003c/h3\u003e\n\u003ch3\u003e\u003cstrong\u003eGiới thiệu\u003c/strong\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eĐi chơi tại quán Tiệm Cà Phê Thú Cưng Dễ Thương và giúp đỡ những người bạn nhỏ đang gặp khó khăn. Nâng những con vật được giải cứu khỏi chiếc xe của Priyanka. Giúp chúng vào tòa nhà qua cửa thú cưng. Làm cho những con vật cảm thấy thoải mái trong ngôi nhà mới của chúng. Làm quen với họ trong khi bạn uống cà phê và thư giãn trong khu vực lễ tân ấm cúng. Có lẽ một người sẽ trở thành một người bạn mãi mãi mà bạn có thể mang về nhà!\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eDành cho trẻ từ 6 tuổi.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eKích thước: 7x35,4x19,1cm.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003e\u003cstrong\u003eChất liệu\u003c/strong\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eNhựa nguyên sinh ABS\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003e\u003cstrong\u003eĐặc điểm nổi bật\u003c/strong\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eBộ đồ chơi đi kèm với 2 búp bê mini, 1 chú chó, 1 chú chó con và 1 chú mèo con cho trẻ em, xe ba gác cứu hộ, trung tâm nhận nuôi động vật và quán cà phê có chỗ ngồi trong nhà và ngoài trời.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eNhiều cách chơi - Trẻ em có thể mang thú cưng khỏi thị trấn với Olivia, nuôi dưỡng chúng tại trung tâm, phục vụ đồ uống và thức ăn hoặc ghép đôi thú cưng với chủ nhân mới của chúng.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eBộ trò chơi sinh động này, sẽ giúp thúc đẩy trí tưởng tượng và lòng sáng tạo của trẻ, mở ra cho trẻ 1 không gian và 1 câu chuyện thú vị cùng những người bạn của mình khi trải nghiệm trò chơi.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eTrẻ có thể sử dụng những chiếc xe ba gác để đi vòng quanh thành phố để giải cứu cho những chú thú cưng bị bỏ rơi, hoặc cho các thú cưng tập thể dục trong phòng tập.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eBộ mô hình LEGO này được thiết kế đặc biệt để mang đến cho trẻ từ 6 tuổi trở lên trải nghiệm lắp ráp, vui chơi tuyệt vời.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eCác mảnh ghép được làm từ chất liệu nhựa nguyên sinh ABS, sản phẩm chống trầy xước, không nứt vỡ và bền đẹp, chất liệu không chứa BPA nên an toàn cho sức khỏe của bé.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eBộ sản phẩm bao gồm hướng dẫn sử dụng giúp các bé hoàn thành nhanh chóng và trải nghiệm thế giới của riêng mình.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003e\u003cstrong\u003eHướng dẫn sử dụng\u003c/strong\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eCó giấy hướng dẫn lắp ghép kèm theo.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003e\u003cstrong\u003eHướng dẫn bảo quản\u003c/strong\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eTránh tiếp xúc trực tiếp với ánh nắng mặt trời.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eTránh nơi ẩm ướt.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eTránh tiếp xúc với hóa chất.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eTránh để gần nguồn nhiệt.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ca/e9/29/c346b80a4e0576fa329f598d0d1c33af.jpg\" alt=\"\" width=\"690\" height=\"480\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/70/d8/ed/9b74adbc6eea3a7714a958a7f220222a.jpg\" alt=\"\" width=\"500\" height=\"500\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/3d/00/23/30888e8f43a7fc23cd7621231b2ffa7a.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/3d/00/23/30888e8f43a7fc23cd7621231b2ffa7a.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/3d/00/23/30888e8f43a7fc23cd7621231b2ffa7a.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3d/00/23/30888e8f43a7fc23cd7621231b2ffa7a.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3d/00/23/30888e8f43a7fc23cd7621231b2ffa7a.png"},{"base_url":"https://salt.tikicdn.com/ts/product/81/db/64/4a561199c54e52ad95e51da36af85683.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/81/db/64/4a561199c54e52ad95e51da36af85683.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/81/db/64/4a561199c54e52ad95e51da36af85683.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/81/db/64/4a561199c54e52ad95e51da36af85683.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/81/db/64/4a561199c54e52ad95e51da36af85683.