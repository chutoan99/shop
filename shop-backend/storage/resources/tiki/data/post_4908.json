","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/3e/c6/65/194f6ea8218a9e9ca5166035142452ff.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1765,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cdiv id=\"menuView1\" class=\"tongQuan gStyle3 menuViewHightLight\"\u003e\n\u003cdiv class=\"description\"\u003e\u003cstrong\u003eSưởi điện Ceramic SUNHOUSE SHD7071\u003c/strong\u003e có thiết kế sang trọng, tinh tế, phù hợp với những không gian hiện đại. Sản phẩm sử dụng công nghệ sưởi không đốt cháy oxy, tiết kiệm điện năng hiệu quả, rất dễ sử dụng và an toàn với sức khỏe. Đặc biệt, SHD7071 còn tích hợp chức năng phun sương, cân bằng độ ẩm cho da.\u003cbr /\u003e\u003cbr /\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/76/7e/9e/9ceabb00c3c1df976837e5ebb5bac8b1.jpg\" alt=\"Sưởi điện Ceramic SUNHOUSE SHD7071 \" /\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv id=\"menuView2\" class=\"thietKe gStyle3 menuViewHightLight\"\u003e\n\u003cdiv class=\"description\"\u003e\u003cstrong\u003eNHỎ GỌN – SANG TRỌNG – TINH TẾ\u003c/strong\u003e\u003cbr /\u003e\u003cstrong\u003eThiết kế nhỏ gọn, sang trọng\u003c/strong\u003e\u003cbr /\u003eSưởi điện ceramic SUNHOUSE SHD7071 có kiểu dáng sang trọng với màu trắng tinh tế, thiết kế nhỏ gọn, tiết kiệm diện tích. Bạn sẽ dễ dàng đặt sản phẩm tại bất kỳ đâu trong căn phòng như sàn nhà, bàn, kệ,\u003cbr /\u003e\u003cstrong\u003eĐiều khiển bằng núm xoay\u003c/strong\u003e\u003cbr /\u003eSản phẩm được điều khiển bằng núm xoay rất dễ sử dụng gồm: Núm khởi động và chọn chế độ (Min – Max) và núm điều chỉnh nhiệt độ làm ấm (Cao – Thấp). Ngay cả người mới sử dụng lần đầu, người cao tuổi… cũng có thể làm quen và sử dụng sản phẩm nhanh chóng.\u003cbr /\u003e\u003cstrong\u003eChân đế vững chãi\u003c/strong\u003e\u003cbr /\u003eVới chân đế dày và rộng, SHD7071 rất vững chãi khi đặt trên sàn nhà, mặt bàn mà không sợ bị nghiêng đổ.\u003cbr /\u003e \u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv id=\"menuView3\" class=\"congNang gStyle3 menuViewHightLight\"\u003e\n\u003cdiv class=\"description\"\u003e\u003cstrong\u003eCÔNG NĂNG SƯỞI ẤM NHANH, KHÔNG GÂY KHÔ DA\u003c/strong\u003e\u003cbr /\u003e\u003cstrong\u003eCông nghệ sưởi ấm hiện đại\u003c/strong\u003e\u003cbr /\u003eSưởi điện ceramic SUNHOUSE SHD7071 sử dụng công nghệ sưởi gốm PTC để làm ấm không gian. Đây là công nghệ sưởi hiện đại sử dụng gốm để làm vật phát nhiệt, bộ phận này trong máy sưởi gốm là một miếng gốm có hình dạng dẹt như một chiếc đĩa gọi là đĩa gốm. Đĩa này được nối với một vật bằng kim loại, khi đĩa gốm được làm nóng lên sẽ truyền nhiệt cho dây kim loại và dòng nhiệt lượng đó sẽ được truyền đi theo hình thức đối lưu và mang hơi ấm tỏa ra từ từ ra bên ngoài giúp tăng nhiệt độ phòng mà không gây sốc nhiệt.\u003cbr /\u003eCông nghệ này cũng không đốt cháy oxy, không gây khó thở hay khô da, giúp bạn luôn cảm thấy thoải mái.\u003cbr /\u003e\u003cstrong\u003e2 chế độ sưởi, quay đảo chiều tỏa nhiệt diện rộng\u003c/strong\u003e\u003cbr /\u003eSản phẩm có 2 chế độ sưởi tương ứng với 2 mức công suất 1200W và 2000W để bạn lựa chọn tùy theo nhu cầu sưởi ấm. Ngoài ra, người dùng cũng có thể chọn quay đảo chiều liên tục để hơi ấm được tỏa đều khắp phòng, phù hợp ở những không gian rộng hoặc nhiều người.\u003cbr /\u003e\u003cstrong\u003eTiện lợi, an toàn với người sử dụng\u003c/strong\u003e\u003cbr /\u003eSưởi điện ceramic SUNHOUSE SHD7071 có hai chế độ an toàn đáng chú ý:\n\u003cul\u003e\n\u003cli\u003eChế độ bảo vệ quá nhiệt: Thiết bị sẽ tự động ngắt hoạt động khi nhiệt độ môi trường quanh sản phẩm đo được trên 80 độ C (có thể do cửa thoát khí bị chắn 1 phần hoặc hoàn toàn). Trong trường hợp này chỉ cần chờ sản phẩm nguội xuống, loại bỏ vật chắn là có thể sử dụng tiếp.\u003c/li\u003e\n\u003cli\u003eChế độ bảo vệ khi nghiêng/đổ: Thiết bị sẽ tự động ngắt điện khi bị đổ hay bị đặt nghiêng ở góc quá cao so với phương nằm ngang.\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv id=\"menuView4\" class=\"thongSoKyThuatSanPham1 menuViewHightLight\"\u003e\n\u003ch2 class=\"title\"\u003eThông số kỹ thuật\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cdiv class=\"text\"\u003eLoại sưởi điện: Sưởi gốm\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv class=\"text\"\u003eChất liệu thân vỏ: Nhựa\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv class=\"text\"\u003eMàu sắc: Trắng\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv class=\"text\"\u003eChức năng: Sưởi ấm\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv class=\"text\"\u003eĐiện áp: 220V~/50Hz\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv class=\"text\"\u003eCông suất: 1200/2000W\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv class=\"text\"\u003eChế độ nhiệt: 2 chế độ nhiệt\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv class=\"text\"\u003eTrọng lượng: 3.8 kg\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv class=\"text\"\u003eBảng điều khiển: Núm xoay\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv class=\"text\"\u003eHẹn giờ: Không\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv class=\"text\"\u003eTự động ngắt khi nghiêng đổ: Có\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv class=\"text\"\u003eThương hiệu: SUNHOUSE\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv class=\"text\"\u003eXuất xứ: Trung Quốc\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv class=\"text\"\u003eKích thước đóng hộp: 272 x 262 x 836 mm\u003c/div\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/3e/c6/65/194f6ea8218a9e9ca5166035142452ff.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/3e/c6/65/194f6ea8218a9e9ca5166035142452ff.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/3e/c6/65/194f6ea8218a9e9ca5166035142452ff.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3e/c6/65/194f6ea8218a9e9ca5166035142452ff.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3e/c6/65/194f6ea8218a9e9ca5166035142452ff.png"},{"base_url":"https://salt.tikicdn.com/ts/product/c9/20/d2/9faeb23a19dbfd622a901de7f7b81147.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c9/20/d2/9faeb23a19dbfd622a901de7f7b81147.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c9/20/d2/9faeb23a19dbfd622a901de7f7b81147.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c9/20/d2/9faeb23a19dbfd622a901de7f7b81147.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c9/20/d2/9faeb23a19dbfd622a901de7f7b81147.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/3b/9b/93/d7d832f8d4834f996747a502e7eb85b3.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/3b/9b/93/d7d832f8d4834f996747a502e7eb8