í vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/0f/7f/9b/6d5dd1e20ac2ffa9b623c3b4e84d8e2d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0f/7f/9b/6d5dd1e20ac2ffa9b623c3b4e84d8e2d.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/0f/7f/9b/6d5dd1e20ac2ffa9b623c3b4e84d8e2d.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0f/7f/9b/6d5dd1e20ac2ffa9b623c3b4e84d8e2d.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0f/7f/9b/6d5dd1e20ac2ffa9b623c3b4e84d8e2d.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/e1/a3/66/acd11e8cf11d3da791b4dd038b0b9876.jfif","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e1/a3/66/acd11e8cf11d3da791b4dd038b0b9876.jfif","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e1/a3/66/acd11e8cf11d3da791b4dd038b0b9876.jfif","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e1/a3/66/acd11e8cf11d3da791b4dd038b0b9876.jfif","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e1/a3/66/acd11e8cf11d3da791b4dd038b0b9876.jfif"},{"base_url":"https://salt.tikicdn.com/ts/product/55/7a/51/c7d19ab15873a9a199894b5e353d1e68.jfif","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/55/7a/51/c7d19ab15873a9a199894b5e353d1e68.jfif","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/55/7a/51/c7d19ab15873a9a199894b5e353d1e68.jfif","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/55/7a/51/c7d19ab15873a9a199894b5e353d1e68.jfif","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/55/7a/51/c7d19ab15873a9a199894b5e353d1e68.jfif"}],"warranty_policy":null,"brand":{"id":270981,"name":"Thái Dương","slug":"thai-duong"},"c