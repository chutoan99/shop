xt_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ee/34/92/cc6bd81c01317bea34f35f096f07f0b2.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2144,"all_time_quantity_sold":9,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eMũ bảo hiểm fullface hàm SUNDA 555 trơn \u003c/strong\u003elà dòng mũ fullface cơ bản truyền thống, đã quen thuộc với người dùng từ hàng chục năm nay thông qua thương hiệu ANDES 555. Mũ bảo hiểm fullface hàm SUNDA 555 trơn là 1 trong những dòng mũ bảo hiểm fullface đầu tiên trên thị trường và đến nay vẫn được nhiều khách hàng tin tưởng và lựa chọn bởi giá thành rẻ và thiết kế đơn giản, nồi đồng cối đá.\u003c/p\u003e\n\u003cp\u003eMũ được thiết kế với lớp xốp và lớp vải lót đệm bên trong dầy dặn, kiểu dáng ôm sát đầu nên những người mới đội các dòng fullface chưa quen ban đầu sẽ cảm thấy hơi bí. Cảm giác này sẽ hết sau vài lần sử dụng và đã quen với nón. Mũ fullface là dòng mũ có tính bảo vệ cao nhất trong các loại nón bảo hiểm trên thị trường.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eMũ bảo hiểm fullface hàm SUNDA 555 trơn\u003c/strong\u003e có size 54-56cm phù hợp với người trưởng thành có chu vi đầu trung bình và nhỏ. Nón chỉ có 1 size duy nhất trên thị trường.\u003c/p\u003e\n\u003cp\u003eVỏ Nón: Sản phẩm mũ bảo hiểm Sunda cam kết luôn sử dụng Nhựa ABS nguyên sinh 100% được nhập khẩu từ các nhà cung ứng uy tín như Hàn Quốc, Malaysia, Thái , Nhật,...chịu được độ va đập cao .\u003c/p\u003e\n\u003cp\u003eMút xốp: là bộ phận cực kỳ quan trọng để bảo vệ não bộ , hấp thụ xung động khi xảy ra tai nạn, Sunda luôn sử dụng xốp nguyên sinh trong tất cả các sản phẩm của hãng.\u003c/p\u003e\n\u003cp\u003eVải lót cao cấp được xử lý kháng khuẩn, thấm hút tốt, mau khô, giúp hạn chế nguy cơ mắc các bệnh về tóc và da đầu. Vải lót Sunda có kết cấu màng lưới lớn độc quyền duy nhất trên các sản phẩm của Công Ty TNHH LongHuei, cho phép không khí lưu thông dễ dàng vào bên trong mũ, tạo cảm giác thoáng mát và dễ chịu khi sử dụng.\u003c/p\u003e\n\u003cp\u003eKhóa cài bằng inox và dây đai chịu được lực kéo mạnh, chắc chắn, luôn bám sát vào đầu đảm bảo độ an toàn tốt nhất.\u003c/p\u003e\n\u003cp\u003eKính chắn gió được làm từ vật liệu chất lượng cao, đã qua xử lý đặc biệt, cho góc quan sát rộng, hình ảnh rõ nét, trung thực, không bị chói đèn, có khả năng chống tia UV400, chắn gió, để bạn tập trung lái xe.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eMũ bảo hiểm fullface hàm SUNDA 555 trơn\u003c/strong\u003e có màu sắc đa dạng, khả năng chịu nắng mưa ,không phai màu với thời gian trên 3 năm.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTHÔNG TIN THƯƠNG HIỆU:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eMũ bảo hiểm fullface hàm SUNDA 555 trơn được sản xuất bởi Công Ty TNHH LongHuei Việt Nam, là một công ty sản xuất mũ bảo hiểm với gần ba mươi năm kinh nghiệm phục vụ cho thị trường quốc tế. Các nhãn hiệu mũ của công ty tại Việt Nam: ZEUS, ANDES, SUNDA; SIMPSON, CROMO. Trong đó, những thương hiệu như ANDES, CROMO đã rất nổi tiếng và quen thuộc với người dùng tại VN từ hàng chục năm nay.\u003c/p\u003e\n\u003cp\u003eLong Huei là công ty duy nhất tại Việt Nam có phòng thử nghiệm hiện đại, đạt tiêu chuẩn quốc tế, nhằm đảm bảo chất lượng sản phẩm đáp ứng các tiêu chuẩn an toàn của Việt Nam và quốc tế trước khi đến với người tiêu dùng. Phần lớn các sản phẩm của hãng được xuất khẩu đi nước ngoài.\u003c/p\u003e\n\u003cp\u003eNhững sản phẩm của công ty LongHuei đều đạt tiêu chuẩn Việt Nam và tiêu chuẩn “DOT, ECE,CNS,SNI,JIS” nhằm đáp ứng các yêu cầu của khách hàng và phục vụ hầu hết các thị trường quốc tế khó tính nhất.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e*** HƯỚNG DẪN XÁC ĐỊNH CỠ MŨ PHÙ HỢP:\u003c/strong\u003e Vòng 1 sợi dây quanh đầu, phía trên lông mày và tai khoảng 2cm. Xiết sợi dây sao cho ôm vừa đủ thoải mái lấy đầu và ghi lại số đo đó. Lặp lại như vậy để tìm được số đo mà bạn thấy đầu dễ chịu nhất. Đó chính là size đầu của bạn. So sánh với kích cỡ mũ để lựa chọn size mũ phù hợp nhất.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ee/34/92/cc6bd81c01317bea34f35f096f07f0b2.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ee/34/92/cc6bd81c01317bea34f35f096f07f0b2.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ee/34/92/cc6bd81c01317bea34f35f096f07f0b2.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ee/34/92/cc6bd81c01317bea34f35f096f07f0b2.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ee/34/92/cc6bd81c01317bea34f35f096f07f0b2.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/53/5d/22/052c034deb1f9b467a65938097dde9f5.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/53/5d/22/052c034deb1f9b467a65938097dde9f5.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/53/5d/22/052c034deb1f9b467a65938097dde9f5.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/53/5d/22/052c034deb1f9b