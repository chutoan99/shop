}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/f2/9c/79/31dde976b2093d89421864a86a958741.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":586,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003chtml\u003e\n \u003chead\u003e\u003c/head\u003e\n \u003cbody\u003e\n  \u003cul\u003e\n   \u003cp\u003eVề khả năng xử lý, ống kính nhỏ gọn tích hợp động cơ bước STM, tạo ra hiệu suất lấy nét tự động nhanh, gần như không ồn và chính xác cùng với tính năng ghi đè lấy nét thủ công toàn thời gian. Thiết kế lấy nét bên trong cũng góp phần mang lại hiệu suất nhanh chóng. Ngoài ra, ống kính có một cổng micro-USB tích hợp để thực hiện các bản cập nhật chương trình cơ sở trong tương lai cho ống kính.\u003c/p\u003e\n   \u003cp\u003eỐng kính góc rộng Prime được thiết kế cho máy ảnh không gương lật Fujifilm E-mount định dạng APS-C và cung cấp độ dài tiêu cự tương đương 35mm.\u003c/p\u003e\n   \u003cp\u003eHai yếu tố phân tán cực thấp làm giảm viền màu và quang sai màu để đạt được độ rõ nét và độ chính xác màu cao.\u003c/p\u003e\n   \u003cp\u003eHai yếu tố chiết suất cao giúp kiểm soát quang sai cầu và giảm biến dạng để tạo ra độ sắc nét cao và kết xuất chính xác.\u003c/p\u003e\n   \u003cp\u003eĐộng cơ bước STM cho phép hiệu suất lấy nét tự động nhanh chóng, yên tĩnh và chính xác cùng với tính năng ghi đè lấy nét thủ công toàn thời gian. Ngoài ra, thiết kế lấy nét bên trong duy trì chiều dài ống kính tổng thể trong quá trình sử dụng để cải thiện khả năng xử lý và phản hồi nhanh hơn.\u003c/p\u003e\n   \u003cp\u003eTích hợp vòng khẩu độ bằng tay để kiểm soát độ phơi sáng bằng xúc giác; vòng này cũng có vị trí 'A' để lựa chọn khẩu độ tự động dựa trên máy ảnh.\u003c/p\u003e\n   \u003cp\u003eMàng chắn 9 lá khẩu góp phần tạo ra chất lượng bokeh hài lòng.\u003c/p\u003e\n   \u003cp\u003eCổng micro-USB tích hợp có thể được sử dụng để cập nhật chương trình cơ sở của ống kính.\u003c/p\u003e\n  \u003c/ul\u003e\n \u003c/body\u003e\n\u003c/html\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/f2/9c/79/31dde976b2093d89421864a86a958741.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f2/9c/79/31dde976b2093d89421864a86a958741.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f2/9c/79/31dde976b2093d89421864a86a958741.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f2/9c/79/31dde976b2093d89421864a86a958741.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f2/9c/79/31dde976b2093d89421864a86a958741.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/9f/e4/ac/fb0aa78ae5cab3b2f91a298d124abd46.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/9f/e4/ac/fb0aa78ae5cab3b2f91a298d124abd46.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/9f/e4/ac/fb0aa78ae5cab3b2f91a298d124abd46.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9f/e4/ac/fb0aa78ae5cab3b2f91a298d124abd46.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9f/e4/ac/fb0aa78ae5cab3b2f91a298d124abd46.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/83/0d/66/e767e678d415894e5010f334559ea11e.jpg","is_gallery":true,"l