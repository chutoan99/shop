_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":141000,"discount_rate":35,"rating_average":4.8,"review_count":15,"review_text":"(15)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/6a/a6/ae/2ffb36ff8c58bce7a24b7bd248600dae.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1679,"all_time_quantity_sold":72,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/86/70/e4/43999fe53bacf2547409579b5e6ac4fa.png\" alt=\"\" width=\"750\" height=\"435\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003eSKIN1004 là thương hiệu mỹ phẩm nội địa Hàn, tuy khá xa lạ tại Việt Nam nhưng hãng lại rất được nhiều cô gái Hàn đón nhận bởi những cam kết về thành phần như được chiết xuất từ thực vật tươi, thơm mát, cực kỳ lành tính. Skin1004 là thương hiệu mỹ phẩm có nguồn gốc thiên nhiên, đặc biệt lành tính cho da và rất được ưa chuộng tại Hàn Quốc.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003eKem Chống Nắng Skin1004 Madagascar Centella Air-fit Suncream là kem chống nắng siêu nhẹ, với chỉ số spf 50++++ giúp bảo vệ hàng ngày cùng chiết xuất rau má Centifolia Asiatica từ Madagascar, giúp làm dịu da và tạo lớp nền trang điểm nhẹ nhành.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/2b/b8/71/a7373f43e5ee0838270af437173c76ff.png\" alt=\"\" width=\"750\" height=\"731\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eƯu điểm nổi bật:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli style=\"text-align: justify;\"\u003eBảo vệ da từ bên ngoài: Với SPF50, PA+++ ngăn tác hại của tia UVA \u0026amp; UVB, ngăn ngừa sạm da hay nám da, ngăn ngừa lão hóa da sớm, ngăn ngừa sự hình thành Melanin và tránh được nguy cơ ung thư da. Duy trì cảm giác mát mẻ dễ chịu, giải nhiệt da khỏi cái nắng oi bức của miền nhiệt đới.\u003c/li\u003e\n\u003cli style=\"text-align: justify;\"\u003eHương thơm dịu nhẹ, không kích ứng với mọi làn da, kể cả đối với da nhạy cảm, da có mụn.\u003c/li\u003e\n\u003cli style=\"text-align: justify;\"\u003eDưỡng ẩm cho da giúp da luôn mượt và khỏe mạnh và tránh khỏi các tình trạng da khô hoặc mệt do các yếu tố môi trường gây nên.\u003c/li\u003e\n\u003cli style=\"text-align: justify;\"\u003eKết cấu dạng lotion, mỏng nhẹ, khi thoa trên da thấm khá nhanh, không gây bết rít cũng như làm đều màu không gây loang lỗ trên da.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eThành phần chính:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eChiết xuất rau má vùng Madagascar giàu vitamin B,C và polyphenols có khả năng chống oxi hoá, phục hồi,làm dịu da,kháng viêm,giảm thâm,giúp da trắng sáng mịn màng, hỗ trợ điều trị mụn.\u003c/li\u003e\n\u003cli\u003eNiacinamide : một chất dưỡng trắng da an toàn có khả năng làm tăng hệ miễn dịch của da,điều tiết bã nhờn,bảo vệ da khỏi tác hại tia UV,ức chế melanin giúp da trắng sáng.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/cc/bd/92/91bd97704e2813b114d25fa01c41f2e3.png\" alt=\"\" width=\"750\" height=\"707\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eHướng dẫn sử dụng:\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e- Lấy một lượng kem chống nắng vừa đủ , chấm lên các điểm trán, 2 má, cằm và mũi.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e- Thoa đều khắp mặt , sau đó vỗ nhẹ cho kem thẩm thấu tốt hơn.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e- Nên thoa kem trước khi ra ngoài 20-30 phút. Không nên thoa kem vào các vùng da bị trầy xước.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/19/e7/5f/6870eea0b27a35f575cf7dabf46492ac.png\" alt=\"\" width=\"750\" height=\"701\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/2b/b2/42/a8184248158d7afc826d93b80af35261.jpeg\" alt=\"\" width=\"750\" height=\"533\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/6a/a6/ae/2ffb36ff8c58bce7a24b7bd248600dae.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/6a/a6/ae/2ffb36ff8c58bce7a24b7bd248600dae.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/6a/a6/ae/2ffb36ff8c58bce7a24b7bd248600dae.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6a/a6/ae/2ffb36ff8c58bce7a24b7bd248600dae.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6a/a6/ae/2ffb36ff8c58bce7a24b7bd248600dae.png"},{"base_url":"https://salt.tikicdn.com/ts/product/e0/5d/7e/d80f65573353871c73b4ae70c0a17a16.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e0/5d/7e/d80f65573353871c73b4ae70c0a17a16.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e0/5d/7e/d80f65573353871c73b4ae70c0a17a16.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e0/5d/7e/d80f65573