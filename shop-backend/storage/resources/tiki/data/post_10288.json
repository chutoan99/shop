und_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":221000,"discount_rate":39,"rating_average":4.8,"review_count":56,"review_text":"(56)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ab/d0/6a/ffd98e384cb768ae85233bbdb16868be.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1513,"all_time_quantity_sold":236,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p><strong>Mô tả sản phẩm Kính bơi chống sương mù View V630ASA Swipe-Antifog Chống Mờ Gấp 10 Lần - Hàng chính hãng</strong></p>\n<p>Kính bơi View V630ASA là mẫu kính bơi mới với công nghệ SWIPE ANTI-FOG. SWIPE ANTI-FOG có thể làm sạch ống kính bằng một vài lần vuốt ngón tay và tầm nhìn rõ ràng sẽ được phục hồi. So với các loại kính khác, kính chống sương mù SWIPE mới thời gian sử dụng kéo dài hơn 10 lần.</p>\n<p><strong>Thông tin chi tiết sản phẩm:</strong></p>\n<ul>\n<li>Mã sản phẩm: V630ASA</li>\n<li>Thương hiệu: View</li>\n<li>Xuất xứ: Nhật Bản</li>\n<li>Ống kính: Polycarbonate chống sương mù, chống tia UV</li>\n<li>Miếng đệm mặt: Silicone</li>\n<li>Đai mũi: Elastome. </li>\n<li>Dây đeo: silicone</li>\n<li>Bộ điều chỉnh dây đeo: Polycarbonate</li>\n<li>Công nghệ SWIPE ANTI-FOG chống hiệu ứng sương mù kéo dài hơn 10 lần</li>\n<li>Dễ dàng lau sạch</li>\n<li>Sản phẩm kèm theo 3 size cầu kính S, M, L để khách hàng dễ dàng sử dụng phù hợp với khuôn mặt.</li>\n</ul>\n<p><strong>Ưu điểm sản phẩm:</strong></p>\n<p>Công nghệ Chống sương mù của SWIPE ANTI-FOG có thể làm sạch ống kính bằng cách vuốt ngón tay vào mắt kính từ 5 đến 10 tầm nhìn sẽ được phục hồi. So với các loại kính VIEW khác, kính chống sương mù SWIPE mới kéo dài sử dụng hơn 10 lần.</p>\n<p>Đệm mắt silicone cao cấp 100% của VIEW cung cấp là loại mềm mại có trên thị trường. Silicone cấp phẫu thuật không gây dị ứng và chống lại mệt mỏi do sử dụng kéo dài trong clo.</p>\n<p>Dây đeo silicon cao cấp của VIEW cung cấp dây đeo mềm nhất, dễ uốn nhất và lâu dài nhất hiện có trên thị trường. Silicone không gây dị ứng.</p>\n<p>Công nghệ UV Cut của VIEW cung cấp sự bảo vệ vượt trội khỏi các tia cực tím có hại (UV). Tăng cường tiếp xúc với tia UV gây hại cho da và mắt đã trở thành một vấn đề nghiêm trọng. Chống tia cực tím giúp bảo vệ mắt tốt hơn trong quá trình sử dụng ngoài trời.</p>\n<p><img src=\"https://salt.tikicdn.com/ts/tmp/a7/dd/e7/16be85888a85cc384d9950e0b1145e0c.jpg\" alt=\"\" width=\"693\" height=\"375\" /></p>\n<p><img src=\"https://salt.tikicdn.com/ts/tmp/0a/18/14/934cf0753e510ac833a17c1ba62cf6fa.jpg\" alt=\"\" width=\"700\" height=\"447\" /></p>\n<p><img src=\"https://salt.tikicdn.com/ts/tmp/c3/ea/05/e3568a68e444cc9499abd87e35a548a6.jpg\" alt=\"\" width=\"692\" height=\"417\" /></p>\n<p><img src=\"https://salt.tikicdn.com/ts/tmp/3d/a4/28/1540d396f88ac61c2a6e59089304b618.jpg\" alt=\"\" width=\"696\" height=\"531\" /></p>\n<p><img src=\"https://salt.tikicdn.com/ts/tmp/6d/6f/4a/200950e473f84374c82a8bfefa7dd9f2.jpg\" alt=\"\" width=\"683\" height=\"379\" /></p>\n<p><img src=\"https://salt.tikicdn.com/ts/tmp/62/4a/98/4044ddd9d20bc2b346bde8b4dca1df33.jpg\" alt=\"\" width=\"696\" height=\"361\" /></p>\n<p><img src=\"https://salt.tikicdn.com/ts/tmp/2f/69/94/538e40e5c676df109ec0ef2b3f38de56.jpg\" alt=\"\" width=\"700\" height=\"700\" /></p>\n<p><img src=\"https://salt.tikicdn.com/ts/tmp/c9/b3/d6/c6d80a361794568e3d85262839891f1d.jpg\" alt=\"\" width=\"716\" height=\"716\" /></p>\n<p><img src=\"https://salt.tikicdn.com/ts/tmp/38/73/00/c14db5ded194451481ab63adc1db76e8.png\" alt=\"\" width=\"700\" height=\"356\" /></p>\n<p><strong>Lưu ý: </strong></p>\n<ul>\n<li>Để cho lớp phủ chống mờ và tia UV hoạt động hiệu quả, hãy ngâm kính trong nước vài giây trước khi sử dụng</li>\n<li>Không chạm tay cũng như vật cứng vào phần tròng kính để tránh làm hỏng lớp tráng phủ</li>\n<li>Sau khi sử dụng chỉ nên rửa sạch kính với nước và bảo quản nơi khô ráo, mát mẻ</li>\n<li>Để ngăn ngăn ngừa việc đọng hơi nước tốt hơn, hãy xoa nhẹ một lớp dầu ăn vào mặt trong kính trước khi đi bơi, hoặc có thể mua chai antifog chuyên dụng</li>\n</ul>\n<p> </p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ab/d0/6a/ffd98e384cb768ae85233bbdb16868be.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ab/d0/6a/ffd98e384cb768ae85233bbdb16868be.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ab/d0/6a/ffd98e384cb768ae85233bbdb16868be.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ab/d0/6a/ffd98e384cb768ae85233bbdb16868be.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ab/d0/6a/ffd98e384cb768ae85233bbdb16868be.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/14/a5/9a/55026f1458d39fbb9bfe42eec9180022.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/14/a5/9a/55026f1458d39fbb9bfe42eec9180022.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/14/a5/9a/55026f1458d39fbb9bfe42eec9180022.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/14/a5/9a/55026f1458d39fbb9bfe42eec9180022.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/14/a5/9a/55026f1458d39fbb9bfe42eec9180022.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/f5/71/9b/309f308b551101be553be25f1