age":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/a9/20/20/c5fe59dfe71aab3bba8908ee3a42b4c1.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1177,"all_time_quantity_sold":13,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cdiv style=\"text-align: center;\"\u003e\u003cspan style=\"color: #ff0000;\"\u003e\u003cstrong\u003eKĩ Năng Đọc Hiểu Chuyên sâu Tiếng Anh - Lưu Hoằng Trí\u003c/strong\u003e\u003c/span\u003e\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv\u003eTiếng Anh ngày càng trở nên quan trọng trong hơn thời buổi hội nhập ngày nay. Đặc biệt trong đó, kĩ năng đọc hiểu đóng một vai trò quan trọng trong việc học tiếng Anh nói chung, đối với các sinh viên Đại học và học sinh trung học Phổ Thông nói riêng.\u003cbr /\u003e\u003cbr /\u003eVới mong muốn cung cấp cho các em tài liệu học tập va rèn luyện kĩ năng đọc hiểu bổ ích, tác giả \u003cem\u003e\u003cstrong\u003eLưu Hoằng Trí \u003c/strong\u003e\u003c/em\u003eđã phối hợp với nhà sách\u003cem\u003e\u003cstrong\u003e Hồng Ân\u003c/strong\u003e\u003c/em\u003e cho phát hành cuốn \u003cstrong\u003eKĩ Năng Đọc Hiểu Chuyên sâu Tiếng Anh\u003c/strong\u003e\u003cstrong\u003e.\u003c/strong\u003e\u003cbr /\u003e\u003cbr /\u003eCấu trúc của cuốn sách gồm \u003cstrong\u003e100 bài đọc \u003c/strong\u003eđược phân bổ đều vào 6 chủ đề.\u003c/div\u003e\n\u003cul\u003e\n\u003cli\u003eChủ đề 1: Our Society\u003c/li\u003e\n\u003cli\u003eChủ đề 2: Our Culture\u003c/li\u003e\n\u003cli\u003eChủ đề 3: Our nature and Environment\u003c/li\u003e\n\u003cli\u003eChủ đề 4: Our Health and Medicine\u003c/li\u003e\n\u003cli\u003eChủ đề 5: Science and Technology\u003c/li\u003e\n\u003cli\u003eChủ đề 6: Educayion and Technology\u003c/li\u003e\n\u003cli\u003eReview Readings\u003c/li\u003e\n\u003c/ul\u003e\n\u003cdiv\u003e\u003cbr /\u003eTrong mỗi bài đọc đều được trình bày gồm 3 phần:\u003c/div\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003ePhần A: Reading Comprehension\u003c/strong\u003e (đọc hiểu) gồm 8 câu hỏi trắc nghiệm với 4 phương án lựa chọn\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003ePhần B: Reading skills\u003c/strong\u003e (kĩ năng đọc hiểu) trình bày lần lượt các kĩ năng đọc hiểu, trong đó có các kĩ năng đọc cơ bản được rèn luyện nhiều\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003ePhần C: Vocabulary Practice\u003c/strong\u003e (Luyệ từ vựng) giúp học viên mở rộng vốn từ vựng, có kĩ năng đoán được từ mới dựa trên ngữ cảnh như ôn luyện về căn ngữ, tiền tố, hậu tố.\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/a9/20/20/c5fe59dfe71aab3bba8908ee3a42b4c1.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a9/20/20/c5fe59dfe71aab3bba8908ee3a42b4c1.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a9/20/20/c5fe59dfe71aab3bba8908ee3a42b4c1.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a9/20/20/c5fe59dfe71aab3bba8908ee3a42b4c1.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a9/20/20/c5fe59dfe71aab3bba8908ee3a42b4c1.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/2f/05/e5/26fb471c1cdc49b0a80e15a42d947a7e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/2f/05/e5/26fb471c1cdc49b0a80e15a42d947a