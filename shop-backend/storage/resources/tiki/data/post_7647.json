ao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/4a/19/9c/387feb027fe13eb702f98c689dc2c050.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/4a/19/9c/387feb027fe13eb702f98c689dc2c050.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/4a/19/9c/387feb027fe13eb702f98c689dc2c050.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4a/19/9c/387feb027fe13eb702f98c689dc2c050.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4a/19/9c/387feb027fe13eb702f98c689dc2c050.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/cc/33/35/16179a79a8709dadd7d67517f4a333f9.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/cc/33/35/16179a79a8709dadd7d67517f4a333f9.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/cc/33/35/16179a79a8709dadd7d67517f4a333f9.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/cc/33/35/16179a79a8709dadd7d67517f4a333f9.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/cc/33/35/16179a79a8709dadd7d67517f4a333f9.jpg"}],"warranty_policy":null,"authors":[{"id":10849,"name":"John C. Maxwell","slug":"john-c-maxwell"}],"current_seller":{"id":164395,"sku":"7732241425592","name":"Trạm đọc","link":"https://tiki.vn/cua-hang/tram-doc","logo":"d8/c2/33/0c5467a0e2d780425ef00f82f250443b.jpg","price":81000,"product_id":"126594852","store_id":151394,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Thông tin chung","attributes":[{"code":"publisher_vn","name":"Công ty phát hành","value":"Alphabooks"},{"code":"publication_date","name":"Ngày xuất bản","value":"2023-02-01 00:00:00"},{"code":"dimensions","name":"Kích thước","value":"13 x 20.5 cm"},{"code":"dich_gia","name":"Dịch Giả","value":"Đức Anh"},{"code":"book_cove