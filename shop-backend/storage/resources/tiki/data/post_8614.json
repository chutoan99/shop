badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":72500,"discount_rate":30,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/0b/74/ae/599543cab2c856d7eba78cb32a772777.png","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":841,"all_time_quantity_sold":26,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003e\u003cspan style=\"color:#000000;\"\u003eGiới thiệu\u003c/span\u003e\u003c/h3\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cspan style=\"color:#000000;\"\u003eĐỒ CHƠI XẾP HÌNH GHÉP CẶP ĐẦU TIÊN NHIỀU CHỦ ĐỀ - MIDEER MY FIRST PUZZLE - DÀNH CHO CÁC BÉ TRÊN 2 TUỔI\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color:#000000;\"\u003eMy first puzzle của Mideer đúng như tên gọi của nó - bộ đồ chơi giống như bước khởi đầu cho bé từ 2 tuổi làm quen với dạng ghép tranh. Hàng chính hãng hoàn toàn non toxic, an toàn cho bé.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color:#000000;\"\u003eTrong mỗi chủ đề đều có 5 tranh ghép nhỏ gồm 2 tranh 3 mảnh ghép, 2 tranh 4 mảnh ghép, 1 tranh 5 mảnh,giúp bé có thể làm quen dần mức độ khó của tranh, và đặc biệt các mảnh ghép to vừa dễ dàng cho thao tác của bé lại vừa dễ tìm để tránh thất lạc.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color:#000000;\"\u003eMàu sắc tranh tươi sáng với họa tiết bắt mắt đảm bảo các bạn nhỏ sẽ thích mê.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color:#000000;\"\u003eBạn đừng ngại việc ngồi tìm từng mảnh ghép khi chơi cùng con, vì mặt sau của các mảnh ghép trong cùng 1 tranh đều có màu giống nhau.\u003c/span\u003e\u003cbr /\u003e\u003cspan style=\"color:#000000;\"\u003eNhư vậy, ngoài việc rèn kỹ năng tay - mắt cho bé, bộ đồ chơi giúp bé có thể ghi nhớ màu sắc, vị trí và rèn tính kiên nhẫn cho trẻ nhé ạ.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color:#000000;\"\u003eCó sẵn 6 mẫu cho bố mẹ lựa chọn:\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color:#000000;\"\u003e\u003cstrong\u003e1. Chủ đề Xe công trường\u003c/strong\u003e: bao gồm 6 phương tiện giao thông quen thuộc với trẻ được thể hiện qua 6 mảnh ghép hình. Với bô ghép hình bao gồm 2 mảnh ghép 3 miếng, 1 mảnh ghép 5 miếng, 1 mảnh ghép 6 miếng và một hình mẫu cho mỗi mẫu phương tiện giao thông để trẻ có thể dễ dàng làm theo. Kích thước các mảnh ghép từ 19cm đến 32cm. Kích thích trí tưởng tượng và khả năng tập trung của trẻ.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color:#000000;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/47/a0/b0/dbad14e348fbbbdb9dc3e9167c3bf451.jpg\" alt=\"\" width=\"550\" height=\"550\" /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color:#000000;\"\u003e\u003cstrong\u003e2. Chủ đề Garden Animals\u003c/strong\u003e - Khu vườn bí mật\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color:#000000;\"\u003eCó 6 con vật khác nhau, mỗi con vật được ghép từ 3-5 miếng ghép\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color:#000000;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/20/62/66/358dedce0e126fd53e52b28f5506d057.jpg\" alt=\"\" width=\"550\" height=\"550\" /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color:#000000;\"\u003e\u003cstrong\u003e3. Chủ đề động vật và hình khối:\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color:#000000;\"\u003eCó 6 loài động vật khác nhau kèm bên trong là những hình khối để bé nhận biết hình học một cách đơn giản nhất\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color:#000000;\"\u003eBé vừa học xếp hình vừa học nhận biết thế giới xung quanh với vô vàn điều hay cần khám phá\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color:#000000;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/d9/45/44/7a86766bf44ac6a544c7fd38f65ab84a.jpg\" alt=\"\" width=\"550\" height=\"550\" /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color:#000000;\"\u003e\u003cstrong\u003e4. Chủ đề Mom\u0026amp;Baby: Mẹ con động Vật\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color:#000000;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/68/ee/b4/e5f501d60d8da13654784bcd0968001c.jpg\" alt=\"\" width=\"550\" height=\"550\" /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color:#000000;\"\u003e\u003cstrong\u003e5. Chủ đề 12345Story\u003c/strong\u003e : Học số đếm và kể chuyện cổ tích 1 cách đơn giản nhất\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color:#000000;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/dd/d3/bc/05f1753a217f2efa5c9fde110133dcfa.jpg\" alt=\"\" width=\"403\" height=\"550\" /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color:#000000;\"\u003e\u003cstrong\u003e6. Chủ đề 10 in a box\u003c/strong\u003e: nằm trong series \"Chú Sâu Háu Ăn\" của tác giả Eric Carle, bé vừa học về động vật, vừa học từ tiếng Anh đơn giản, học nhận biết màu sắc\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color:#000000;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ee/38/d3/9186cc4a83f8ff4fa57f0469b9682513.jpg\" alt=\"\" width=\"550\" height=\"550\" /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color:#000000;\"\u003ePhù hợp cho bé từ 2 tuổi trở lên\u003c/span\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cspan style=\"color:#000000;\"\u003eĐặc điểm nổi bật\u003c/span\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eBộ xếp hình tăng cấp độ My First Puzzle Mideer là sự kết hợp hoàn hảo giữa giáo dục và giải trí, mang đến trải nghiệm độc đáo cho bé từ 1 đến 8 tuổi. Với 8 cấp độ (level) khác nhau, mỗi level không chỉ là một thách thức mà còn là một bước tiến quan trọng trong việc phát triển trí tuệ và khả năng giải quyết vấn đề của bé.\u003c/li\u003e\n\u003cli\u003eĐộ khó tăng dần theo từng level, với số lượng miếng ghép cũng tăng theo, tạo ra một trải nghiệm học tập đa dạng và thú vị. Chủ đề của các tranh ghép được lựa chọn từ đơn giản đến phức tạp, giúp bé theo dõi và hiểu rõ hơn về thế giới xung quanh theo từng độ tuổi. Hình ảnh được minh hoạ bởi các nghệ sĩ vẽ tranh nổi tiếng trên thế giới giúp nâng cao khả năng thẩm mỹ của bé ngay từ nhỏ.\u003c/li\u003e\n\u003cli\u003eMy First Puzzle Mideer là sản phẩm được ưa chuộng tại hơn 68 quốc gia trên thế giới. Nó không chỉ là một đồ chơi trí tuệ mà còn là công cụ hữu ích giúp phát triển toàn diện các kỹ năng cần thiết trong cuộc sống của trẻ bao gồm: nhận thức thẩm mĩ, tư duy logic, sự tự tin, khả năng tập trung, kĩ năng vận động tinh, tính kiên trì, kĩ năng phối hợp tay mắt và khả năng học hỏi, ý chí…\u003c/li\u003e\n\u003cli\u003eCác miếng ghép được hoàn thiện mượt mà và không có gờ. Làm từ chất liệu giấy bìa màu trắng cao cấp, mực in gốc đậu nành sắc nét an toàn cho bé và thân thiện với môi trường. Sản phẩm đạt tiêu chuẩn Châu Âu EN71 nên ba mẹ khi mua Tranh ghép hình Mideer.\u003c/li\u003e\n\u003cli\u003eBộ xếp hình My First Puzzle Mideer không chỉ là một bộ đồ chơi trí tuệ, giáo dục xuất sắc mà còn là một món quà tuyệt vời mà ba mẹ có thể chọn tặng cho bé trong các dịp lễ quan trọng như Giáng Sinh, Sinh Nhật, hay Tết Thiếu Nhi. Mideer Level up! Puzzles - mỗi miếng 