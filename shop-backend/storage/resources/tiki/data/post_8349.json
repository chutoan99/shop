ref":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/8a/bb/f2/1b162655ffa6e3c47a8fc28ffa61fa7f.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2753,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003e\u003cspan style=\"font-size: 1.17em;\"\u003eDung tích 1 lít phù hợp với gia đình 2 - 4 người\u003c/span\u003e\u003c/h3\u003e\r\n\u003cp\u003eNồi cơm có dung tích 1 lít sẽ đáp ứng được nhu cầu sử dụng của gia đình có từ 2 - 4 thành viên.\u003c/p\u003e\r\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Nồi Cơm Điện Tử Cuckoo CR-0631F - 1L (Hồng)\" src=\"http://tikicdn.com/media/catalog/product/n/o/noi-com-dien-cuckoo-cr-0631f-3a.u425.d20160715.t144436.jpg\" alt=\"Nồi Cơm Điện Tử Cuckoo CR-0631F - 1L (Hồng)\" width=\"750\" height=\"452\" /\u003e\u003c/p\u003e\r\n\u003ch3\u003eNắp trong có thể tháo ra vệ sinh một cách dễ dàng\u003cstrong\u003e\u003cbr /\u003e\u003c/strong\u003e\u003c/h3\u003e\r\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Nồi Cơm Điện Tử Cuckoo CR-0631F - 1L (Hồng)\" src=\"http://tikicdn.com/media/catalog/product/n/o/noi-com-dien-cuckoo-cr-0631f-4-1.u425.d20160715.t144436.jpg\" alt=\"Nồi Cơm Điện Tử Cuckoo CR-0631F - 1L (Hồng)\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\r\n\u003ch3\u003eNắp thông hơi tinh tế\u003c/h3\u003e\r\n\u003cp\u003eNắp thoát hơi thông minh kiểm soát quá trình thoát hơi nước tốt, và có khả năng chống trào hiệu quả.\u003c/p\u003e\r\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Nồi Cơm Điện Tử Cuckoo CR-0631F - 1L (Hồng)\" src=\"http://tikicdn.com/media/catalog/product/n/o/noi-com-dien-cuckoo-cr-0631f-5-1.u425.d20160715.t144436.jpg\" alt=\"Nồi Cơm Điện Tử Cuckoo CR-0631F - 1L (Hồng)\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\r\n\u003ch3\u003eBảng phím điện tử\u003c/h3\u003e\r\n\u003cp\u003eBảng phím điều khiển điện tử, màn hình hiển thị sẽ giúp bạn dễ dàng hơn với việc chọn lựa và kiểm soát quá trình hoạt động của nồi cơm.\u003c/p\u003e\r\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Nồi Cơm Điện Tử Cuckoo CR-0631F - 1L (Hồng)\" src=\"http://tikicdn.com/media/catalog/product/n/o/noi-com-dien-cuckoo-cr-0631f-1-org-8.u425.d20160715.t142828.jpg\" alt=\"Nồi Cơm Điện Tử Cuckoo CR-0631F - 1L (Hồng)\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\r\n\u003ch3\u003eLòng nồi chống dính\u003c/h3\u003e\r\n\u003cp\u003eLòng nồi dày được làm bằng gang tráng men chống dính, được phủ một lớp chống dính giúp cơm được nấu chín ngon hơn, dễ dàng cho việc chùi rửa.\u003c/p\u003e\r\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Nồi Cơm Điện Tử Cuckoo CR-0631F - 1L (Hồng)\" src=\"http://tikicdn.com/media/catalog/product/n/o/noi-com-dien-cuckoo-cr-0631f-1-org-12.u425.d20160715.t142828.jpg\" alt=\"Nồi Cơm Điện Tử Cuckoo CR-0631F - 1L (Hồng)\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\r\n\u003ch3\u003eCảm biến nhiệt, hẹn giờ nấu thông minh\u003c/h3\u003e\r\n\u003cp\u003eKhi cơm được nấu chín, rơ le nhiệt tự động điều chỉnh nhiệt độ chuyển sang chế độ giữ ấm, hạn chế tình trạng quá nhiệt gây cháy xén. Nồi có thể hấp thụ nhiệt tốt để cơm chín đều và nhanh trong thời gian ngắn.\u003c/p\u003e\r\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Nồi Cơm Điện Tử Cuckoo CR-0631F - 1L (Hồng)\" src=\"http://tikicdn.com/media/catalog/product/n/o/noi-com-dien-cuckoo-cr-0631f-3b.u425.d20160715.t144436.jpg\" alt=\"Nồi Cơm Điện Tử Cuckoo CR-0631F - 1L (Hồng)\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\r\n\u003cp\u003e \u003c/p\u003e\r\n\u003ch3\u003eChức năng khóa an toàn\u003c/h3\u003e\r\n\u003cp\u003eChức năng khóa an toàn, tránh tính trạng bỏng do nước, phù hợp với gia đình có người lớn tuổi và trẻ nhỏ.\u003c/p\u003e\r\n\u003ch3\u003e6 chức năng nấu tiện dụng\u003c/h3\u003e\r\n\u003cp\u003eVới nồi cơm điện \u003cstrong\u003eCuckoo CR-0631F \u003c/strong\u003ebạn có thể dùng để nấu cơm thường, cơm trộn, nấu cháo, làm bánh. Với tính năng này, bạn sẽ tiết kiệm được nhiều thời gian và công sức chuẩn bị.\u003c/p\u003e\r\n\u003cp\u003eChế độ nấu tự động:\u003c/p\u003e\r\n\u003cp\u003e- Nấu cơm trắng “Glutinuos”;\u003c/p\u003e\r\n\u003cp\u003e- Nấu gạo mầm “Gaba”\u003c/p\u003e\r\n\u003cp\u003e- Nấu gạo hạt dài hoặc gạo lứt “Mixed/Brown”\u003c/p\u003e\r\n\u003cp\u003e- Nấu cháo “Porridge”, nấu cháo hoặc để sắc thuốc bắc ở nhiệt độ thấp “Slow cook”, tùy theo nhu cầu sử dụng mà chọn chọn chế độ nấu phù hợp.\u003c/p\u003e\r\n\u003cp\u003e- Hấp “Steam”\u003c/p\u003e\r\n\u003cp\u003e- Nấu súp\u003c/p\u003e\r\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Nồi Cơm Điện Tử Cuckoo CR-0631F - 1L (Hồng)\" src=\"http://tikicdn.com/media/catalog/product/n/o/noi-com-dien-cuckoo-cr-0631f-7-1.u425.d20160715.t145724.jpg\" alt=\"Nồi Cơm Điện Tử Cuckoo CR-0631F - 1L (Hồng)\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\r\n\u003ch3\u003eChức năng nấu nhanh “Turbo”\u003c/h3\u003e\r\n\u003cp\u003eNếu muốn sử dụng chức năng nấu nhanh “Turbo”: Sau khi lựa chọn chức năng “Glutinuos”, nhấn 2 lần và giữ nút “Cook – Turbo” lâu hơn 1 giây, đèn “Turbo” bật sáng, chức năng nấu nhanh sẽ được thực hiện (chức năng Turbo chỉ sử dụng cho lượng cơm đáp ứng nhu cầu 1 – 3 người ăn, nếu nhiều hơn thì không nên sử dụng chức năng này).\u003c/p\u003e\r\n\u003cp\u003eĐồng hồ hiển thị thời gian nấu còn lại kể từ khi van hơi hoạt động (không phải lúc bắt đầu nấu). Khi việc nấu hoàn thành, màn hình sẽ hiện lên chữ “OK” và kêu 1 tiếng “Bíp”, nồi chuyển sang chế độ giữ ấm.\u003c/p\u003e\r\n\u003ch3\u003eChức năng hẹn giờ\u003c/h3\u003e\r\n\u003cp\u003eChức năng hẹn giờ nấu sẽ giúp bạn dễ dàng kiểm soát được thời gian hoạt động của nồi và bạn có thể làm được nhiều công việc khác.\u003c/p\u003e\r\n\u003cp\u003e\u003cspan\u003eĐể hẹn giờ, trước khi bạn cần kiểm tra lại thời gian hiển thị có đúng thời gian hiện tại hay không (nếu chưa đúng phải điều chỉnh lại theo đúng thời gian hiện tại). Kiểm tra lại thực đơn nấu đã chọn đúng hay chưa.\u003c/span\u003e\u003c/p\u003e\r\n\u003cp\u003eĐể chỉnh giờ thực tế, cắm điện, nhấn “Min” để chọn phút, nhấn “Hrs” để chọn giờ.\u003c/p\u003e\r\n\u003cp\u003eSau đó bấm vào nút “Timer”, đèn time sẽ được bật, dùng nút “Hrs” và “Min” để chỉnh lại thời gian nấu.\u003c/p\u003e\r\n\u003cp\u003e\u003cem\u003eLưu ý: thời gian nấu đã được điều chỉnh là thời gian kết thúc việc nấu cơm chứ không phải thời gian bắt đầu nấu. Ví dụ: Muốn ăn lúc 12h trưa thì bạn phải điều chỉnh thời gian nấu là 12h.\u003c/em\u003e\u003c/p\u003e\r\n\u003cp\u003eBấm vào nút “Cook”, việc cài đặt đã hoàn thành, nồi sẽ tự động nấu chín cơm với thời gian đã được cài đặt.\u003c/p\u003e\r\n\u003cp\u003e\u003cem\u003eLưu ý là nếu thời gian cài đặt thấp hơn so với thời gian hiện tại thì nồi sẽ được nấu ngay lập tức. Cài đặt hẹn giờ nấu tối đa 13 tiếng kể từ lúc chọn hẹn giờ nấu.\u003c/em\u003e\u003c/p\u003e\r\n\u003cp\u003e\u003cem\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Nồi Cơm Điện Tử Cuckoo CR-0631F - 1L (Hồng)\" src=\"http://tikicdn.com/media/catalog/product/n/o/noi-com-dien-cuckoo-cr-0631f-8-1.u425.d20160715.t145708.jpg\" alt=\"Nồi Cơm Điện Tử Cuckoo CR-0631F - 1L (Hồng)\" width=\"750\" height=\"500\" /\u003e\u003cbr /\u0