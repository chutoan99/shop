icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.8,"review_count":128,"review_text":"(128)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/2c/58/f4/65aaf01d91e8da1d7a637a1fe9a500b3.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2256,"all_time_quantity_sold":1040,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: center;\"\u003e\u003cstrong\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/5e/17/39/40e3e3df691b05e03988265bea897ac5.jpg\" alt=\"Cà Phê Chế Phin 5 Trung Nguyên (500g)\" width=\"750\" height=\"750\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCà Phê Chế Phin 5 Trung Nguyên (500g)\u003c/strong\u003e được tạo nên bằng cả tình yêu và sự đam mê cà phê mãnh liệt nhất, những hạt cà phê nguyên gốc và tốt nhất thế giới đã được chắt chiu, chọn lựa một cách tỉ mỉ kết hợp với những bí quyết rang xay huyền bí phương Đông, chúng tôi gửi đến những người yêu và sành cà phê hơn cả một ly cà phê thơm ngon, quyến rũ bậc nhất mà còn là một năng lượng đặc biệt.\u003c/p\u003e\n\u003cp\u003eĐược chế biến từ những hạt cà phê Culi Arabica ngon nhất trên Thế giới cùng những công nghệ hiện đại nhất thế giới và bí quyết riêng không thể sao chép, Chế Phin Số 5 mang hương thơm dịu lưu luyến, vị đậm đà mân mê vị giác chuyên dành cho những người sành cà phê và các quán cà phê muốn sở hữu gu cà phê riêng biệt.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/56/57/fb/1506f5a11026075c74fbfccf9a564103.jpg\" alt=\"Cà Phê Chế Phin 5 Trung Nguyên (500g)\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eCà phê có nước pha màu nâu cánh gián đậm, mùi thơm đặc trưng, vị êm nhẹ, ít đắng.\u003c/p\u003e\n\u003cp\u003eCà phê Trung Nguyên là nguồn năng lượng cho sự khởi động của trí não, cho cảm hứng của những ý tưởng sáng tạo và cho những thành công.\u003c/p\u003e\n\u003cp\u003eSáng tạo nên lịch sử và cà phê là bí quyết của các vĩ nhân, người thành đạt.\u003c/p\u003e\n\u003cp\u003eVới công thức riêng biệt, Trung Nguyên tạo ra những sản phẩm cà phê siêu sạch, tuyệt ngon dành cho người sành cà phê, chuyên cho hoạt động \"Sáng tạo\" của não.\u003c/p\u003e\n\u003cp\u003eThích hợp cho những người có \"gu\" uống cà phê đậm.\u003c/p\u003e\n\u003cp\u003eMột sản phẩm của tập đoàn chuyên cà phê Trung Nguyên với phương châm “Sống cà phê, chết cà phê”. Đem lại chất lượng cùng hương vị tuyệt vời cho người dùng. Sự sáng tạo cũng vì thế mà phát triển.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/2c/58/f4/65aaf01d91e8da1d7a637a1fe9a500b3.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/2c/58/f4/65aaf01d91e8da1d7a637a1fe9a500b3.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/2c/58/f4/65aaf01d91e8da1d7a637a1fe9a500b3.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2c/58/f4/65aaf01d91e8da1d7a637a1fe9a500b3.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2c/58/f4/65aaf01d91e8da1d7a637a1fe9a500b3.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/84/