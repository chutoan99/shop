,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.8,"review_count":51,"review_text":"(51)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/30/54/2e/f112513dd2fcb60e3f5987e591bfd515.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":901,"all_time_quantity_sold":467,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eã dán người lớn Caryn M40 - gói lớn siêu tiết kiệm (gồm 40 miếng)\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eTã dán Siêu thấm Caryn cải tiến mới với “Đệm thấm xanh\" chuyên biệt tại vùng xương cụt, với các hạt thấm hút tăng cường giúp thấm hút tối đa, ngăn thấm ngược trở lại đến 97%, cho vùng xương cụt thêm khô thoáng, giảm nỗi lo các vấn đề về da, là lựa chọn tốt nhất cho người dùng hạn chế khả năng đi lại. Thiết kế mở tiện thay trong tư thế nằm giúp việc chăm sóc trở nên thật dễ dàng.\u003c/p\u003e\n\u003cp\u003eSản phẩm được kiểm soát nghiêm ngặt để đáp ứng tiêu chuẩn chất lượng của nhãn hiệu tã giấy hàng đầu Nhật Bản – Lifree.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eĐỐI TƯỢNG SỬ DỤNG:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eDùng cho phụ nữ sau sinh, người lớn gặp khó khăn trong việc vệ sinh như các bệnh nhân sau mổ, những người mất khả năng kiểm soát hệ bài tiết, người hạn chết khả năng đi lại (ngồi hoặc nằm 1 chỗ)\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eSỐ ĐO:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eNam: \u0026lt; 65kg\u003c/li\u003e\n\u003cli\u003eNữ: \u0026lt; 55kg\u003c/li\u003e\n\u003cli\u003eVòng bụng: 61 - 106cm\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eĐẶC ĐIỂM SẢN PHẨM :\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e1/ Đệm thấm xanh bảo vệ vùng xương cụt: Cải tiến mới với đệm thấm xanh chuyên biệt tại vùng xương cụt, giúp khóa chặt tối đa chất lỏng bên trong lõi, ngăn thấm ngược trở lại tới 97%, giúp cho bề mặt tã tiếp xúc với vùng xương cụt thêm khô thoáng, hạn chế nỗi lo các vấn đề về viêm loét da tại vùng xương cụt ở người nằm lâu\u003c/p\u003e\n\u003cp\u003e2/ Rãnh thấm siêu tốc dẫn chất lỏng thấm sâu, giữ bề mặt tã luôn khô thoáng\u003c/p\u003e\n\u003cp\u003e3/ Công nghệ kháng khuẩn kết hợp hương thảo mộc, giúp ngăn ngừa vi khuẩn và kiểm soát mùi hiệu quả\u003c/p\u003e\n\u003cp\u003e4/ Vách chống trào kép ngăn chất lỏng trào ra ngoài, không gây khó chịu hay để lại vết hằn\u003c/p\u003e\n\u003cp\u003e5/ Màng đáy air-active dạng vải cho phép hơi ẩm thoát qua, tránh hằm bí\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/30/54/2e/f112513dd2fcb60e3f5987e591bfd515.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/30/54/2e/f112513dd2fcb60e3f5987e591bfd515.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/30/54/2e/f112513dd2fcb60e3f5987e591bfd515.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/30/54/2e/f112513dd2fcb60e3f5987e591b