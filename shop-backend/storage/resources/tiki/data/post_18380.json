avourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/f1/18/61/92027dc76985c554d2e90e244b48a31f.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":463,"all_time_quantity_sold":3,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align:justify;\"\u003eNhà xuất bản: Kim Đồng\u003cbr /\u003eTác giả: Sơn Tùng\u003cbr /\u003eKích thước: 13 x 19cm\u003cbr /\u003eLoại bìa: Bìa cứng\u003cbr /\u003e-----------------\u003cbr /\u003e“… Mỗi lần, được đọc một bài thơ, một quyển sách, được xem một bức tranh, một cuốn phim về Bác, nếu thấy nó thoát khỏi ước lệ, không đơn giản là một tác phẩm được đặt hàng nhân một ngày kỉ niệm nào đó, nếu thấy nó xuất phát từ đáy lòng, từ lòng kính yêu, từ tinh thần trách nhiệm, là tôi hết sức cảm ơn tác giả đã can đảm vượt qua nỗi run sợ trước khi sáng tác. Tôi chấp nhận tất cả các tác phẩm làm cho tôi nhớ đến Bác, gần gũi thêm với Bác, và gạn lọc rồi để lại cho tôi một cảm xúc trong sáng. Đó chính là cảm xúc mỗi khi gấp lại trang cuối cùng Búp sen xanh của nhà văn Sơn Tùng.” NHÀ VĂN HÓA NGUYỄN KHẮC VIỆN\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e“Không hiểu sao, mỗi lần nhớ đến nhà văn Sơn Tùng, tôi lại nghĩ ông như một quả dừa khô, tích nắng, tích nước để cuối cùng bật lên một chồi cây xanh, sắc và đẹp như một lưỡi mác.\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003eCả cuộc đời mình, nhà văn Sơn Tùng đã không ngừng tích lũy, tìm kiếm tư liệu, vượt lên thương tật để nghiên cứu, viết về Chủ tịch Hồ Chí Minh. Ông có những hiểu biết, tư liệu về lãnh tụ mà không phải bất cứ một nhà nghiên cứu nào cũng có được…” NHÀ VĂN NGUYỄN TRÍ HUÂN (Tạp chí Nhà văn, số 4/2011)\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/f1/18/61/92027dc76985c554d2e90e244b48a31f.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f1/18/61/92027dc76985c554d2e90e244b48a31f.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f1/18/61/92027dc76985c554d2e90e244b48a31f.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f1/18/61/92027dc76985c554d2e90e244b48a31f.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f1/18/61/92027dc76985c554d2e90e244b48a31f.jpg"}],"warranty_policy":null,"authors":[{"id":13739,"name":"Sơn Tùng","slug":"son-tung"}],"current_seller":{"id":54507,"sku":"1272937226294","name":"BOOKCITY.VN","link":"https://tiki.vn/cua-hang/bookcity-vn","logo":"https://vcdn.tikicdn.com/ts/seller/ae/39/78/e802f9672f2da7e8c12fb85a33899be6.jpg","price":72000,"product_id":"262781919","store_id":51746,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Thông tin chung","attributes":[{"code":"publisher_vn","name":"Công ty phát hành","value":" NXB Kim Đồng"},{"code":"manufacturer","name":"Nhà xuất bản","value":"Nhà Xuất Bản Kim Đồng"}]}],"product_links":[],"gift_item_title":"0 quà tặng kèm","configurable_options":[{"code":"option1","name":"Loại bìa","position":0,"show_preview_image":false,"values":[{"label":"Bìa mềm"}]}],"configurable_products":[{"child_id":262781918,"discount_rate":0,"id":262781919,"images":[{"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f1/18/61/92027dc76985c554d2e90e244b48a31f.jpg","medium_url":"https://salt.tikicdn.com/cache/550x550/ts/product/f1/18/61/92027dc