_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/2a/a1/40/d720bf4dc3b0a902d6d4870efbc5bcea.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1973,"all_time_quantity_sold":8,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eNước tẩy trang SENKA A.L.L. CLEAR WATER Micellar Formula White 230ml\u003c/strong\u003e với công nghệ Micellar Nhật Bản, giúp tẩy trang sạch lớp trang điểm và bụi bẩm bám sâu trên da, giảm lượng dầu thừa. Sản phẩm chứa các thành phần chính được chiết xuất từ tơ tằm trắng, lá trà xanh, không những đóng vai trò làm sạch thoáng mà còn tạo nên lớp màng dưỡng ẩm, dưỡng trắng. Sau khi dùng nước tẩy trang, không cần phải rửa sạch bằng nước mà da vẫn không nhờn rít. Sản phẩm có hương thơm dịu nhẹ, tạo nên cảm giác thoải mái, dễ chịu khi dùng.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/2a/a1/40/847b446b54c883f792c465ab89990d2f.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/6e/a0/e7/16f1f251392d9ced77e19dccbda9b2a1.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTHÔNG TIN SẢN PHẨM\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eLoại sản phẩm\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Nước tẩy trang với công nghệ mới Micellar nhẹ nhàng làm sạch, giảm bóng dầu và dưỡng trắng da.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/f9/0b/d6/6f6677972fa3fb776730fcdcab4300c3.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eLoại da phù hợp\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Phù hợp với mọi làn da.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eĐộ an toàn\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Không chứa dầu gây nhờn, không gây kích ứng, không chứa cồn, không có chất tạo màu\u003c/p\u003e\n\u003cp\u003e- An toàn và không gây kích ứng.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCông dụng\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e- Nhẹ nhàng làm sạch 3 lớp: cặn trang điểm - dầu thừa - bụi bẩn và ô nhiễm.\u003c/p\u003e\n\u003cp\u003e- Công thức mới, dưỡng trắng và giảm thiểu tình trạng sạm nám.\u003c/p\u003e\n\u003cp\u003e- Không những làm sạch mà còn dưỡng ẩm, không gây khô căng sau khi sử dụng.\u003c/p\u003e\n\u003cp\u003e- Mang lại hương thơm dễ chịu, tươi mát cho da. \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThành phần\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Chiết xuất hoa anh đào từ vùng núi Fuji Nhật Bản, không những nhẹ nhàng làm sạch da mà còn dưỡng trắng, tăng cường độ đàn hồi, chống oxy hóa cho da, thúc đẩy tái sinh tế bào da.\u003c/p\u003e\n\u003cp\u003e- Trà xanh Uji Nhật Bản: Chiết xuất từ những lá trà xanh hảo hạng được hái từ vùng núi Uji Nhật Bản – với ngành trồng trà truyền thống từ thế kỷ 12. Trà xanh chứa các hợp chất chống oxy hóa và giàu vitamin E, giúp làm sạch da, ngăn ngừa các tác nhân gây mụn và chống lão hóa.\u003c/p\u003e\n\u003cp\u003e- Công nghệ Micell cuốn bay cặn trang điểm: Công thức chứa những phân tử hình cầu nhỏ gọi là mi-xen (micelles). Những phân tử chứa 2 thành phần là Hydrophobic và Hydrophilic. Phần hydrophobic hút tạp chất mà không làm khô da và phần hydrophilic sẽ hòa tan trong nước.\u003c/p\u003e\n\u003cp\u003e- Công nghệ Giữ ẩm độc quyền “Aqua in Pool”: Được sáng chế bởi tập đoàn Shiseido, công nghệ làm sạch chọn lọc giúp lấy đi bụi bẩn và bã nhờn nhưng vẫn giữ lại độ ẩm tự nhiên của da, giúp tăng cường hiệu quả của các thành phần dưỡng ẩm khác.\u003c/p\u003e\n\u003cp\u003e- Chiết xuất từ lõi Tơ tằm trắng \u0026amp; Gấp đôi Hyaluronic acid: Chiết xuất từ thành phần kén Tơ Tằm trắng tự nhiên chứa hàm lượng chất dưỡng ẩm tinh khiết cao nhất. Hyaluronic acid và Super hyaluronic acid với kích thước phân tử nhỏ hơn mang lại hiệu quả dưỡng ẩm chuyên sâu.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eHướng dẫn sử dụng\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Bước 1: Làm sạch tay.\u003c/p\u003e\n\u003cp\u003e- Bước 2: Thấm một lượng sản phẩm vửa đủ (khoảng 3 lần ấn) ra bông tây trang.\u003c/p\u003e\n\u003cp\u003e- Bước 3: Nhẹ nhàng lau sạch lớp trang điểm, không cần rửa lại bằng nước.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTHÔNG TIN THƯƠNG HIỆU\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eRa đời năm 2002 tại Nhật Bản, nhãn hiệu Senka thừa hưởng lịch sử 140 năm của Tập đoàn Shiseido để mang đến những sản phẩm dưỡng da hiệu quả và an toàn với làn da phụ nữ châu Á. Với sản phẩm đại diện Senka Perfect Whip đứng đầu thị trường sữa rửa mặt Nhật Bản trong 7 năm liền (từ 2008 đến 2015), Senka mong muốn chăm sóc những người phụ nữ bận rộn một cách hiệu quả và tinh tế nhất.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/2a/a1/40/d720bf4dc3b0a902d6d4870efbc5bcea.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/2a/a1/40/d720bf4dc3b0a902d6d4870efbc5bcea.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/2a/a1/40/d720bf4dc3b0a902d6d4870efbc5bcea.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2a/a1/40/d720bf4dc3b0a902d6d4870efbc5bcea.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2a/a1/40/d720bf4dc3b0a902d6d4870efbc5bcea.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/14/9a/98/cc551687fdd879ca64afce67e19ad3f6.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/14/9a/98/cc551687fdd879ca64afce67e19ad3f6.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/14/9a/98/cc551687fdd879ca64afce67e19ad3f6.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/14/9a/98/cc551687fdd879ca64afce67e19ad3f6.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/14/9a/98/cc551687fdd879ca64afce67e19ad3f6.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/19/d7/28/ecbaa7f9c3a082b950ce72fb44ba938e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/19/d7/28/ecbaa7f9c3a082b950ce72fb44ba938e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/19/d7/28/ecbaa7f9c3a082b950ce72fb44ba938e.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/19/d7/28/ecbaa7f9c3a082b950ce72fb44ba938e.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/19/d7/28/ecbaa