 thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/bf/c0/5c/fdd9bb1bd711dde6aebefc5ac1f6ae28.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/bf/c0/5c/fdd9bb1bd711dde6aebefc5ac1f6ae28.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/bf/c0/5c/fdd9bb1bd711dde6aebefc5ac1f6ae28.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/bf/c0/5c/fdd9bb1bd711dde6aebefc5ac1f6ae28.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/bf/c0/5c/fdd9bb1bd711dde6aebefc5ac1f6ae28.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/e1/99/b3/3219f4481c28fe14d24698fac1f900ba.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e1/99/b3/3219f4481c28fe14d24698fac1f900ba.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e1/99/b3/3219f4481c28fe14d24698fac1f900ba.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e1/99/b3/3219f4481c28fe14d24698fac1f900ba.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e1/99/b3/3219f4481c28fe14d24698fac1f900ba.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/02/ca/84/3821159986f7185590b1bdef818afb4a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/02/ca/84/3821159986f7185590b1bdef818afb4a.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/02/ca/84/3821159986f7185590b1bdef818afb4a.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/02/ca/84/3821159986f7185590b1bdef818afb4a.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/02/ca/84/3821159986f7185590b1bdef818afb4a.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/6e/08/8e/c092ff47895f651af0d96055d7433f7f.jpg","is_gallery":true,"label":null,"large_u