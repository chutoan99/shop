e":4.8,"review_count":6,"review_text":"(6)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/13/2e/a7/17028e5d305e52e1a8c481ad9cf3e864.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":660,"all_time_quantity_sold":48,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/44/a8/79/d446640974fae8665751f9cba13348cf.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eThông tin sách:\u003c/p\u003e\n\u003cp\u003eKích thước: 16x24cm\u003c/p\u003e\n\u003cp\u003eNhà xuất bản: NXB Hội Nhà Văn\u003c/p\u003e\n\u003cp\u003eSố trang: 460\u003c/p\u003e\n\u003cp\u003eHình thức: Bìa Dẻo\u003c/p\u003e\n\u003cp\u003eTác giả: Võ Khắc Nghiêm\u003c/p\u003e\n\u003cp\u003eCông ty phát hành: Công ty CP Sách và Truyền thông San Hô (San Hô Books)\u003c/p\u003e\n\u003cp\u003e————————————————————\u003c/p\u003e\n\u003cp\u003eViệc chọn Thị Lộ làm nhân vật chính cho cuốn tiểu thuyết dày hàng trăm trang là một thách thức không nhỏ đối với nhà văn Võ Khắc Nghiêm. Bởi tư liệu về Thị Lộ được sử sách ghi lại không nhiều và có không ít những điểm về cuộc đời bà chưa thống nhất và có những tình tiết mơ hồ ,thậm chí hoang đường , ác độc… Bởi quan niệm và cách đọc các tác phẩm văn học về đề tài lịch cử còn rất nhiều giới hạn và không ít bảo thủ. Chính vậy mà lâu nay, các tác phẩm về đề tài lịch sử và đặc biệt về các nhân vật lịch sử có thể tạo ra được phần nào không khí của một giai đoạn lịch sử hoặc một sự kiện lịch sử mà nhân vật ấy tham dự, chứ ít tạo ra được nhân vật một cách sống động mà người đọc có thể cảm nhận được từng hơi thở của nhân vật đó mà từ đấy cảm nhận được hơi thở của thời đại nhân vật đã sống.\u003c/p\u003e\n\u003cp\u003eNhà văn Võ Khắc Nghiêm đã chuẩn bị đầy đủ những gì cần thiết nhất như nguồn gốc, văn hóa, nhan sắc, tâm hồn, chí khí… Thị Lộ để bà sinh ra, lớn lên và hòa vào triều đại của bà. Tất cả những chuẩn bị ấy vừa logic vừa đầy sáng tạo. Nhà văn không phải là người sao chép lại lịch sử mà là người làm cho lịch sử hiện ra trong một ánh sáng mới, sâu sắc và rộng lớn hơn.\u003c/p\u003e\n\u003cp\u003e————————————————————\u003c/p\u003e\n\u003cp\u003eQuy cách: bìa dẻo, cán mờ, ép nhũ vàng.\u003c/p\u003e\n\u003cp\u003e————————————————————\u003c/p\u003e\n\u003cp\u003eTác giả:\u003c/p\u003e\n\u003cp\u003eNhà văn Võ Khắc Nghiêm (1942-2022) quê gốc ở huyện Lệ Thủy, tỉnh Quảng Bình, nhưng sinh sống và làm việc gần như cả cuộc đời ở vùng than Cẩm Phả, tỉnh Quảng Ninh cho đến khi chuyển về làm Phó Tổng Biên tập Tạp chí Than Việt Nam tại Hà Nội. Ông đã được nhận Giải thưởng Nhà nước về Văn học, nghệ thuật đợt 4 năm 2017 cho hai tiểu thuyết \"Mảnh đời của Huệ\" và \"Mạnh hơn công lý\"; Giải thưởng ASEAN năm 2020 cho tiểu thuyết \"Thị Lộ chính danh\". Ông là hội viên của các hội: Hội Nhà văn Việt Nam, Hội Nhà báo; Hội Nghệ sĩ Sân khấu; Hội Điện ảnh. Ông đã xuất bản trên 20 tập tiểu thuyết, truyện ngắn và viết nhiều kịch bản sân khấu, kịch bản phim truyện nhựa, phim truyện truyền hình.\u003c/p\u003e\n\u003cp\u003e————————————————————\u003c/p\u003e\n\u003cp\u003eTrang đọc thử:\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/9c/9b/7d/c73de05ed0031af0b0253a36203d4ba5.jpg\" alt=\"\" width=\"750\" height=\"1130\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/b1/a7/65/3282705afcf9f4b1207119ebafa774a3.jpg\" alt=\"\" width=\"750\" height=\"1130\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/d1/76/52/5005a573ae685c54aee4cd0d604525e2.jpg\" alt=\"\" width=\"750\" height=\"1131\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/c5/ff/30/ff97841e560cef1caa87fc9fb8f295ca.jpg\" alt=\"\" width=\"750\" height=\"1130\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/13/2e/a7/17028e5d305e52e1a8c481ad9cf3e864.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/13/2e/a7/17028e5d305e52e1a8c481ad9cf3e864.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/13/2e/a7/17028e5d305e52e1a8c481ad9cf3e864.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/13/2e/a7/17028e5d305e52e1a8c481ad9cf3e864.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/13/2e/a7/17028e5d305e52e1a8c481ad9cf3e864.png"},{"base_url":"https://salt.tikicdn.com/ts/product/a9/e0/04/1aeac1004e7df5335acdf259e730fbf8.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a9/e0/04/1aeac1004e7df5335acdf259e730fbf8.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a9/e0/04/1aeac1004e7df5335acdf259e730fbf8.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a9/e0/04/1aeac1004e7df5335acdf259e730fbf8.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a9/e0/04/1aeac1004e7df5335acdf259e730fbf8.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/f7/39/f3/3ed6d736118a09ef1459f0ff0c637a9b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f7/39/f3/3ed6d736118a09ef1459f0ff0c637a9b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f7/39/f3/3ed6d736118a09ef1459f0ff0c637a9b.jpg","position":nul