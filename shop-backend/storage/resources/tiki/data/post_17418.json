/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":69000,"discount_rate":14,"rating_average":4.8,"review_count":4,"review_text":"(4)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/b9/f9/47/7021bfe9a8f63178b099f3449e337078.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1001,"all_time_quantity_sold":22,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eSERUM DƯỠNG TRẮNG DA SẮC NGỌC KHANG \u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eDưỡng trắng diệu kỳ\u003c/strong\u003e\u003c/p\u003e\n\u003col\u003e\u003cli\u003e\u003cstrong\u003eThành phần \u003c/strong\u003e\u003c/li\u003e\n\u003c/ol\u003e\u003cul\u003e\u003cli\u003eVC-IP: Vitamin C thế hệ mới: Chống oxi hóa và phục hồi da nhanh hơn giúp da căng mịn, trắng sáng\u003c/li\u003e\n\u003cli\u003eDầu Squalane: như một hàng rào vừa giúp bảo vệ da ngăn ngừa da mất nước và mất độ ẩm\u003c/li\u003e\n\u003cli\u003eDầu Jojoba: chất giữ ẩm có trong dầu tạo ra rào cản chống lại sự mất nước giúp cân bằng độ ẩm trên da và chống lại các tác động của nắng, gió, ô nhiễm môi trường\u003c/li\u003e\n\u003cli\u003eVitamin E: Hỗ trợ chống Oxi hóa tốt hơn khi kết hợp với Vitamin C\u003c/li\u003e\n\u003c/ul\u003e\u003col\u003e\u003cli\u003e\u003cstrong\u003eCông dụng \u003c/strong\u003e\u003c/li\u003e\n\u003c/ol\u003e\u003cp\u003e- Hồi phục \u0026amp; tái tạo kết cấu da, giúp da mịn màng căng mọng.\u003c/p\u003e\n\u003cp\u003e- Dưỡng ẩm, cân bằng độ ẩm và dầu, ngăn chặn tác hại của tia UV.\u003c/p\u003e\n\u003cp\u003e- Dưỡng da trắng khỏe, tươi sáng, đều màu; làm mờ những vùng da thâm sạm, xỉn màu. Đồng thời, tăng độ săn chắc và đàn hồi cho da.\u003c/p\u003e\n\u003cp\u003e- Đảm bảo độ an toàn tối ưu\u003c/p\u003e\n\u003cp\u003e– Không gây kích ứng.\u003c/p\u003e\n\u003cp\u003e– Không chứa chất bảo quản.\u003c/p\u003e\n\u003cp\u003e– Không nhờn rít.\u003c/p\u003e\n\u003cp\u003e– Phù hợp với mọi loại da, kể cả da nhạy cảm.\u003c/p\u003e\n\u003col\u003e\u003cli\u003e\u003cstrong\u003eHướng dẫn sử dụng \u003c/strong\u003e\u003c/li\u003e\n\u003c/ol\u003e\u003cp\u003e- Sử dụng sau các bước làm sạch da và sau bước cân bằng da bằng nước hoa hồng\u003c/p\u003e\n\u003cp\u003e- Lấy lượng sản phẩm vừa đủ khoảng 1 hạt đậu (hoặc nhiều hơn), thoa đều lên mặt và massage nhẹ nhàng.\u003c/p\u003e\n\u003cp\u003e- Nếu mới sử dụng lần đầu sản phẩm bạn có thể thoa lên vùng dưới 2 bên má để xem da có bị kích ứng như ngứa hoặc đỏ không\u003c/p\u003e\n\u003cp\u003e- Có thể sử dụng thêm kem dưỡng da ban đêm sau khi sử dụng Serum dưỡng trắng da diệu kỳ Sắc Ngọc Khang\u003c/p\u003e\n\u003cp\u003e- Thoa tinh chất mỗi sáng và tối để đạt được hiệu quả tối ưu cho làn da của bạn\u003c/p\u003e\n\u003col\u003e\u003cli\u003e\u003cstrong\u003eĐối tượng sử dụng\u003c/strong\u003e\u003c/li\u003e\n\u003c/ol\u003e\u003cul\u003e\u003cli\u003eThích hợp với mọi loại da (da dầu, da khô, da hỗn hợp) kể cả làn da nhạy cảm nhất.\u003c/li\u003e\n\u003c/ul\u003e\u003col\u003e\u003cli\u003e\u003cstrong\u003eHạn sử dụng\u003c/strong\u003e\u003c/li\u003e\n\u003c/ol\u003e\u003cp\u003e- 2 năm kế từ ngày sản xuất\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e- \u003c/strong\u003eHạn mở nắp Serum dưỡng trắng Sắc Ngọc Khang 6 tháng\u003c/p\u003e\n\u003col\u003e\u003cli\u003e\u003cstrong\u003eQuy cách đóng gói\u003c/strong\u003e\u003c/li\u003e\n\u003c/ol\u003e\u003cul\u003e\u003cli\u003eSerum dưỡng trắng da diệu kỳ Sắc Ngọc Khang Chai 20ml\u003c/li\u003e\n\u003c/ul\u003e\u003cp