cdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":25000,"discount_rate":31,"rating_average":5,"review_count":5,"review_text":"(5)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/2d/d3/b0/139a43d785d6f473de7ebb4266bbb166.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":186,"all_time_quantity_sold":45,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p><strong>Thành phần:</strong> Khẩu trang kháng khuẩn 5D An Tâm bao gồm 3 lớp: 2 lớp vải lọc PP cao cấp (100% Polypropylene) và 1 lớp vải lọc kháng khuẩn Melt-blown ở giữa.</p>\n<p><img src=\"https://salt.tikicdn.com/ts/tmp/2d/d3/b0/d280c4839afa527a56a3f6d19dd1d87d.jpg\" alt=\"\" width=\"750\" height=\"656\" /></p>\n<ul><li>Lớp vải lọc PP mặt ngoài dày dặn, mịn, màu sắc trang nhã, mềm mại, có đặc tính lọc bụi, chống thấm, giúp ngăn cản các hạt chất lỏng văng ra khi người bệnh hắt-xì, ho.</li><li>Lớp vải lọc PP mặt trong tinh khiết, mịn màng, thấm hút mồ hôi, không lông tơ gây ngứa, không gây dị ứng.</li><li>Lớp vải lọc Melt-Blown kháng khuẩn ở giữa, màu trắng, không thấm nước: có tác dụng lọc bụi siêu mịn, kháng khuẩn, ngăn ngừa lây nhiễm bệnh qua đường hô hấp, là thành phần quan trọng nhất của khẩu trang.</li></ul>\n<p><img src=\"https://salt.tikicdn.com/ts/tmp/f9/20/5f/6856bc047f24826d5470e884e2d04ca4.jpg\" alt=\"\" width=\"750\" height=\"937\" /></p>\n<ul><li>Thiết kế 5D trang nhã, ôm sát khuôn mặt, không gian thở thoải mái, vừa đảm bảo độ kín vừa mang tính thời trang, sang trọng.</li><li>Không lem son môi, chống mờ kính.</li></ul>\n<ul><li>Thun đeo tai: bền chắc, có độ co giãn tốt, không gây đau tai khi sử dụng trong thời gian dài.</li></ul>\n<p><img src=\"https://salt.tikicdn.com/ts/tmp/9e/f1/53/4bbc78d93df05cdd2ac03ee52eaab37e.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<ul><li>Màu sắc: màu trắng, màu xám, màu đen, màu be.</li></ul>\n<p> </p>\n<ul><li><strong>Đóng gói: 10 Túi/Thùng. 10 Cái/Túi</strong></li></ul>\n<ul><li>Sản phẩm đạt tiêu chuẩn ISO 13485:2016 và  đã được kiểm định bởi trung tâm kiểm định Quatest 3 .</li></ul>\n<p> </p>\n<ul><li><strong>An Tâm: An Toàn - Thoải Mái.</strong></li></ul><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/2d/d3/b0/139a43d785d6f473de7ebb4266bbb166.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/2d/d3/b0/139a43d785d6f473de7ebb4266bbb166.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/2d/d3/b0/139a43d785d6f473de7ebb4266bbb166.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2d/d3/b0/139a43d785d6f473de7ebb4266bbb166.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2d/d3/b0/139a43d785d6f473de7ebb4266bbb166.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/48/80/dc/dba125562ba61813a280b540bd5fb2db.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/48/80/dc/dba125562ba61813a280b540bd5fb2db.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/48/80/dc/dba125562ba61813a280b540bd5fb2db.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/48/80/dc/dba125562ba6181