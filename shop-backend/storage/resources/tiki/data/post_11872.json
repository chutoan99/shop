,"background_color":"#D93843","href":null,"text":"9.9"},{"placement":"pdp_badge","code":"is_hero","type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"freeship_xtra","type":"pdp_icon_badge","index":2,"icon":"https://salt.tikicdn.com/ts/upload/be/67/48/04a82ab8df178e1a13bde38316081865.png","icon_width":91,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":true,"return_reason":"any_reason"}},"discount":202000,"discount_rate":22,"rating_average":5,"review_count":33,"review_text":"(33)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/28/02/b1/3e44501434cf19cc7e75d491949b56a2.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1499,"all_time_quantity_sold":90,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<h1 style=\"text-align:center;\">BALO CREAVTIVE 14 INCH KHƠI NGUỒN SÁNG TẠO</h1>\n<p><em>Sáng tạo là yếu tố khiến cuộc sống trở nên thông minh hơn, tiện lợi hơn. Với mong muốn khơi nguồn sáng tạo trong thế hệ trẻ, Sakos đã cho ra mắt bộ sưu tập balo CREATIVE thể hiện sáng mới mẻ trong thiết kết, đột phá tính năng nhưng vẫn giữ được nét đẹp nguyên bản của một chiếc balo truyền thống.</em></p>\n<h2><strong>Thiết kế mới mẻ tạo điểm nhấn độc đáo</strong></h2>\n<p><strong><img style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/1c/db/cb/e3c2cbad926ca7b21ca758b3e37ee21e.png\" alt=\"\" width=\"750\" height=\"750\" /></strong></p>\n<p><strong>Creative đồng hành cùng mọi chuyến đi: đi học, đi làm, công tác, du lịch… đều thời trang và tiện lợi.</strong></p>\n<p><strong><img style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/ce/65/7c/7e2f3c5cac3e3dcc3630215cd4947458.png\" alt=\"\" width=\"750\" height=\"750\" /></strong></p>\n<p><strong>Bề mặt vải nhẵn được phối bởi những gam màu đơn sắc: đỏ, đen, xanh navy đơn giản, giữ được vẻ đẹp nguyên sơ từ màu sắc đến thiết kế của một chiếc balo truyền thống nhưng tính năng vượt trội trong đặc tính phụ kiện.</strong></p>\n<p><strong><img style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/0f/f0/90/608081cb5d68a8d7844b41bfac980f6b.png\" alt=\"\" width=\"750\" height=\"750\" /></strong></p>\n<p>Hai điểm nhấn độc đáo trong thiết kế mặt trước dòng balo thời trang kiêm laptop này là sự sáng tạo trong dây kéo ngăn và logo hợp kim sang trọng.</p>\n<p>Phần dây kéo được may uốn theo độ cong mềm mại của nắp ngăn phụ mặt trước tạo nên sự uyển chuyển nhưng khỏe khoắn, tôn lên cá tính người dùng.</p>\n<p><img style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/7b/c9/1f/c1187cbd99a64ed58ecc8626e4963172.png\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p>Logo Sakos dập chìm trên nền hợp kim sáng bóng, chống gỉ theo tác động của thời gian và yếu tố môi trường là bảo chứng chất lượng từ dòng balo được sản xuất theo công nghệ Mỹ.</p>\n<h2><strong>Phân ngăn tiện lợi, trọng lượng siêu nhẹ nhưng sức chứa “đáng gờm”</strong></h2>\n<p>Cấu trúc ngăn của Creative gồm 1 ngăn chính với thể tích tương đối lớn, tận dụng tối đa kích thước tổng thể 27 x 15 x 40 cm (rộng x sâu x cao, chứa vừa laptop từ 14 inch trở xuống) cùng nhiều ngăn phụ tiện ích, dễ dàng sắp xếp đồ dùng an toàn, ngăn nắp.</p>\n<p><img style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/07/2a/36/d2768a72f4dd6a795c63fd8fd50f6731.png\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p>Ngăn chính được trang bị đệm EVA xung quanh cách vách có tính năng chống sốc hiệu quả, bảo vệ các thiết bị điện từ cũng như các đồ dùng trong quá trình di chuyển. Ngoài laptop 14 inch, máy tính bảng 10 inch, tài liệu, tập sách, thì ngăn chính còn thích hợp mang theo quần áo cho những hành trình kéo dài 2-3 ngày.</p>\n<p><img style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/68/9b/d4/7e9cd1afeab8354106953e79bbd10b57.png\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<h2>Ngoài ra, bên trong ngăn này còn tích hợp thêm một ngăn phụ độc đáo giúp bạn cất giữ giấy tờ cá nhân, tiền bạc hoặc các món phụ kiện, trang sức giá trị.</h2>\n<p><img style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/02/9f/fc/09f7d3704bce5eaa10878cfe125d8acc.png\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<h2>Các ngăn phụ tiện lợi cũng được thiết kế một cách khéo léo trên dòng balo văn phòng Creative.</h2>\n<p><img style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/af/0e/ce/453d403bd8d08182fa49d1bd7e33b062.png\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p><img style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/58/4e/76/a73a05d0d5b500fb225fdae97021c56b.png\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<h2><strong>Balo thông minh bảo vệ cột sống lưng người dùng cho một vóc dáng hoàn hảo.</strong></h2>\n<p><strong><img style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/fb/9b/08/c9da23119a9c93edcc5198a7f2d4e043.png\" alt=\"\" width=\"750\" height=\"750\" /></strong></p>\n<h2><strong>Đệm mút EVA cấu trúc 3D thoáng khí, hạn chế nóng lưng, mồ hôi dù đeo balo trong thời gian dài dưới điều kiện thời tiết nóng bứt.</strong></h2>\n<p><strong><img style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/9d/bb/00/e3e3dd5340e7020a2d3624d5b25fcf12.png\" alt=\"\" width=\"750\" height=\"750\" /></strong></p>\n<h2><strong>Dây đeo to bản chống hằn hiệu quả, êm ái tuyệt đối.</strong></h2>\n<p><strong><img style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/43/65/c4/eecc5921702c132402391d2382033f72.png\" alt=\"\" width=\"750\" height=\"750\" /></strong></p>\n<h2><strong>Khóa tăng-đơ tùy chỉnh kích thước dây đeo phù hợp với vóc dáng người sử dụng.</strong></h2>\n<p><strong><img style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/ad/cc/46/f2e7506a39210635e8ee7409e4cab580.png\" alt=\"\" width=\"750\" height=\"750\" /></strong></p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/28/02/b1/3e44501434cf19cc7e75d491949b56a2.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/28/02/b1/3e44501434cf19cc7e75d491949b56a2.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/28/02/b1/3e44501434cf19cc7e75d491949b56a2.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/28/02/b1/3e44501434cf19cc7e75d491949b56a2.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product