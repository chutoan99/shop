d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":325000,"discount_rate":54,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/e6/9d/19/b0023266afdece37c2c3eedabd5b9170.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":298,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eMáy Sấy Tóc AZO A811Công Suất 2000W, Máy Sấy Tóc, Tạo Kiểu Tóc 2 Chiều Nóng Lạnh 3 Cấp Độ Gió Giúp Chăm Sóc Và Bảo Vệ Tóc\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/dc/f1/37/d47c784475ebbb0aaa85a9da8ec5f5ab.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e Đặc tính sản phẩm\u003c/p\u003e\n\u003cp\u003eKiểu dáng hiện đại, trẻ trung, đẹp mắt\u003c/p\u003e\n\u003cp\u003eSản phẩm làm từ nhựa cao cấp siêu bền, kháng khuẩn, chống bám bụi tốt giúp sản phẩm luôn sáng bóng như mới.\u003c/p\u003e\n\u003cp\u003eMàu xám đen thời thượng, bắt mắt. Kiểu dáng trẻ trung, hiện đại. \u003c/p\u003e\n\u003cp\u003eBa chế độ sấy linh hoạt phù hợp với nhiều loại tóc Máy sấy sử dụng công suất 1400 - 2000W với 3 chế độ sấy linh hoạt tùy chỉnh sao cho phù hợp với nhiều loại tóc: tóc mỏng, tóc dày, tóc ướt nhiều, tóc ẩm… Bạn có thể tùy chỉnh chế độ sấy khô hoặc sấy mát bảo vệ tóc bằng cách ấn nhẹ công tắc trên tay cầm, vô cùng tiện dụng và dễ dàng.\u003c/p\u003e\n\u003cp\u003eAn toàn với chế độ ngắt điện tự động khi quá nhiệt\u003c/p\u003e\n\u003cp\u003eSản phẩm an toàn tuyệt đối cho người dung nhờ tính năng tự ngắt điện khi máy bị quá nhiệt đồng thời giúp kéo dài tuổi thọ cho máy.\u003c/p\u003e\n\u003cp\u003eThiết kế tiện lợi Đầu sấy tập trung luồng khí làm khô tóc nhanh chóng, tạo kiểu dễ dàng.\u003c/p\u003e\n\u003cp\u003eNắp thông gió cấu trúc hình tổ ong giúp giảm tiếng ồn lúc sấy, không gây khó chịu cho người xung quanh khi sử dụng.\u003c/p\u003e\n\u003cp\u003eKiểu dáng nhỏ gọn cùng tay cầm kiểu gập giúp người dùng sử dụng dễ dàng, tiện lợi kể cả khi đi du lịch.\u003c/p\u003e\n\u003cp\u003e Hướng dẫn sử dụng\u003c/p\u003e\n\u003cp\u003e1. Lần đầu tiên sử dụng:\u003c/p\u003e\n\u003cp\u003eTrong những phút đầu sử dụng ở lần đầu tiên, bạn sẽ nhìn thấy một ít khói và có mùi nhẹ bay ra. Điều này là bình thường và không ảnh hưởng tới chất lượng sản phẩm.\u003c/p\u003e\n\u003cp\u003e2. Lưu ý khi sử dụng:\u003c/p\u003e\n\u003cp\u003eKết nối thiết bị với nguồn điện phù hợp với thông số ghi trên thiết bị.\u003c/p\u003e\n\u003cp\u003eGạt công tắc đến vị trí sử dụng mà bạn cảm thấy phù hợp.\u003c/p\u003e\n\u003cp\u003eNgắt kết nối thiết bị với nguồn điện sau khi sử dụng.\u003c/p\u003e\n\u003cp\u003eĐể thiết bị tự nguội trước khi cất giữ.\u003c/p\u003e\n\u003cp\u003e3. Vệ sinh và bảo quản:\u003c/p\u003e\n\u003cp\u003eTrước khi muốn vệ sinh sản phẩm hãy rút phích cắm điện ra khỏi thiết bị.\u003c/p\u003e\n\u003cp\u003eSử dụng một miếng vải mềm, vải ẩm để vệ sinh tay cầm của sản phẩm.\u003c/p\u003e\n\u003cp\u003eKhông để nước và các chất lỏng khác chảy vào các khe hở của máy.\u003c/p\u003e\n\u003cp\u003eRút phích cắm điện ra khỏi thiết bị, để cho nó tự hạ nhiệt độ sau đó cất giữ thiết bị ở nơi khô ráo.\u003c/p\u003e\n\u003cp\u003eKhông cất giữ thiết bị khi nó đang còn nóng và vẫn còn kết nối với nguồn điện.\u003c/p\u003e\n\u003cp\u003eKhông treo thiết bị bằng dây, thả lỏng dây điện khi cất giữ.\u003c/p\u003e\n\u003cp\u003eKhông để các cạnh sắc đè lên dây dẫn vì nó có thể làm cho dây điện bị hở hoặc đứt.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/3d/55/61/6879e3e2a86406948056e6285b3909f1.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/69/9a/f6/10ab6654c79fbda96db615b57cd79e4f.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/58/bb/88/b1e5224b5a0c55dc0fa9fcf57cd8ca46.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/9d/65/1a/fd7a65572834da3a31d932d292cd7cbc.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eThông Số kỹ Thuật Máy sấy tóc AZO\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eHãng sản xuất : AZO\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Công Suất: 200W ( công xuất thưc tế không phải công xuất ảo như các shop khác đăng bán )\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Công nghệ tiêu chuẩn: Nhật bản có ion âm\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Kích thước: 28,5 cm x 12,5 cm x 7,5cm\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Điện áp định mức: 220V\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Bảo hành : 6 tháng\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eMáy có : Máy sấy + bầu sấy tập trung + Loa tóc xoăn\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eƯu điểm Máy sấy tóc AZO\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eNhựa PPE chịu nhiệt Không có Mùi nhựa khi Sấy.\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eTạo kiểu dễ dàng với bầu sấy tập chung.\u003c/p\u003e\n\u003cp clas