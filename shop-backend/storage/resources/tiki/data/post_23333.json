"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":7580,"discount_rate":2,"rating_average":5,"review_count":39,"review_text":"(39)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/d1/fe/1f/00cf35233332445cccb9ab8cb6c59a86.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2753,"all_time_quantity_sold":316,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch1 style=\"text-align:center;\"\u003e\u003cstrong\u003eBALANCE SHAMPOO\u003c/strong\u003e\u003c/h1\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cem\u003e\u003cstrong\u003eDầu gội làm sạch, ngăn ngừa gầu, giảm ngứa da đầu \u003c/strong\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cstrong\u003eXuất xứ: \u003c/strong\u003ePháp\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cstrong\u003eSản xuất tại: \u003c/strong\u003ePháp\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cstrong\u003eDung tích:\u003c/strong\u003e 200ml\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/cb/74/12/7a88a485cfd04b39571945d952cd7374.jpg\" alt=\"\" width=\"750\" height=\"421\" /\u003e\u003c/p\u003e\n\u003ch2\u003e \u003c/h2\u003e\n\u003ch2\u003e\u003cstrong\u003eCông dụng: \u003c/strong\u003e\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003eĐược làm giàu với Piroctone Olamine và Salicylic Acid loại bỏ gầu hiệu quả ngay trong lần đầu sử dụng với tác động lâu dài, ngăn ngừa gầu quay trở lại. Cảm nhận da đầu cực sạch sau khi dùng 2 tuần. Tác động dịu nhẹ với da đầu ngay cả với da đầu nhạy cảm, bảo vệ da đầu.\u003c/li\u003e\n\u003cli\u003eGiảm ngay cơn ngứa khó chịu do gầu gây ra, làm dịu cảm giác ngứa ngáy, kích ứng trên da đầu.\u003c/li\u003e\n\u003cli\u003eCảm nhận sự khác biệt ngay trong lần gội đầu tiên. Được bổ sung Niacinamide, Panthenol  giúp dưỡng phục hồi và tái tạo màng hydrolipid trên da đầu.\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch2\u003e \u003c/h2\u003e\n\u003ch2\u003e\u003cstrong\u003eHướng dẫn sử dụng:\u003c/strong\u003e \u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003eSử dụng như dầu gội hàng ngày 2-3 lần/tuần trong vòng 4 tuần.\u003c/li\u003e\n\u003cli\u003eLàm ướt tóc và da đầu, cho dầu gội lên, nhẹ nhàng làm sạch tới tận chân tóc sau đó gội qua với nước để làm sạch da đầu và loại bỏ gầu.\u003c/li\u003e\n\u003cli\u003eCho dầu gội lên một lần nữa, mát xa nhẹ nhàng trên da đầu để dầu gội tác động sâu bên trong khoảng vòng 5-10 phút rồi gội sạch với nước.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eĐối tượng sử dụng: \u003c/strong\u003eSản phẩm dùng cho cả gia đình trẻ tuổi dậy thì và người lớn, dùng cho cả nam và nữ, hương thơm dịu nhẹ phù hợp cho cả gia đình. Dùng cho da đầu có gàu, viêm da tiết bã, vẩy nến, nấm da đầu…\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eKiểm nghiệm: \u003c/strong\u003eSản phẩm được kiểm nghiệm da liễu trên da nhạy cảm. Kiểm định an toàn trên trẻ vị thành niên.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThân thiện môi trường:\u003c/strong\u003e Đóng gói đơn giản giảm chất thải ra môi trường giúp bảo vệ trái đất\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eHương thơm:\u003c/strong\u003e Hương thơm tươi mát từ bạc hà và long não\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThành Phần:\u003c/strong\u003e\u003cem\u003e Aqua, Sodium Laureth Sulfate, Cocamidopropyl Betaine, Cocamide Mipa, Salicylic Acid, Peg-7 Glyceryl Cocoate, Piroctone Olamine, Sodium Benzoate, Panthenol, Parfum, Citric Acid, Guar Hydroxypropyl Trimonium Chloride, Niacinamide, Menthol, Limonene, Methylpropanediol, Sodium Chloride, CI 19140, CI42090\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eLưu ý: \u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eĐể xa tầm tay trẻ em.\u003c/li\u003e\n\u003cli\u003eKhông dùng cho phụ nữ có thai.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/d1/fe/1f/00cf35233332445cccb9ab8cb6c59a86.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d1/fe/1f/00cf35233332445cccb9ab8cb6c59a86.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d1/fe/1f/00cf35233332445cccb9ab8cb6c59a86.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d1/fe/1f/00cf35233332445cccb9ab8cb6c59a86.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d1/fe/1f/00cf35233332445cccb9ab8cb6c59a86.jpg"},{"base_url":"https://salt.tikicdn.com/media/catalog/product/0/7/07482.u2409.d20170227.t173211.187710.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/0/7/07482.u2409.d20170227.t173211.187710.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/0/7/07482.u2409.d20170227.t173211.187710.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/0/7/07482.u2409.d20170227.t173211.187710.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/0/7/07482.u2409.d20170227.t173211.187710.jpg"},{"bas