":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/05/56/61/d8e213880895f551a9ef300ecd5a5b6a.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":578,"all_time_quantity_sold":6,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003carticle class=\"4ever-article\"\u003e\n\u003ch3\u003eGiới thiệu:\u003c/h3\u003e\n\u003cp\u003eKhi bắt đầu biết đi, vận động và tiếp xúc với môi trường bên ngoài nhiều hơn, nhu cầu và chế độ chăm sóc của các bé sẽ thay đổi. Vì vậy sản phẩm dầu gộ riêng cho bé sẽ đảm bảo tóc óng mượt, chắc khỏe, mà lại còn dịu nhẹ cho da đầu và tóc tơ của bé. Dầu gội Johnson's Active Kids Strong \u0026amp; Healthy Shampoo với chiết xuất từ lúa mì và vitamin E, mang đến 3 sức mạnh bảo vệ cho mái tóc tơ, vốn mỏng hơn tóc người lớn gấp 2 lần pH cân bằng bào vệ da đầu bé. Công thức phù hợp đối với bé trong giai đoạn phát triển.\u003c/p\u003e\n\u003ch3\u003eThành phần:\u003c/h3\u003e\n\u003cdiv\u003eChiết xuất từ lúa mì và vitamin E, mang đến 3 sức mạnh bảo vệ cho mái tóc tơ\u003c/div\u003e\n\u003ch3\u003eĐặc điểm nổi bật:\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cdiv\u003eCông thức chuyên biệt phù hợp với nhu cầu về tóc của các bé đang phát triển \u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv\u003eLàm sạch tóc và da đầu của bé hiệu quả\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv\u003eDưỡng tóc óng mượt\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv\u003eNuôi tóc dài chắc khỏe, không lo rối gãy\u003c/div\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003eHướng dẫn sử dụng:\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eLàm ướt tóc bé\u003c/li\u003e\n\u003cli\u003eCho dầu gội ra tay, nhẹ nhàng xoa đều và làm sạch bằng nước\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eLƯU Ý:\u003c/p\u003e\n\u003cp\u003eSử dụng dưới sự giám sát của người lớn. Để ngoài tầm tay trẻ em.\u003c/p\u003e\n\u003ch3\u003eHướng dẫn bảo quản:\u003c/h3\u003e\n\u003cp\u003eBảo quản nơi khô ráo, thoáng mát, tránh ánh nắng mặt trời.\u003c/p\u003e\n\u003cp\u003eThành phần chi tiết: Xem trên bao bì sản phẩm\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eThương hiệu: Johnson’s Baby\u003c/li\u003e\n\u003cli\u003eNơi sản xuất: Malaysia\u003c/li\u003e\n\u003cli\u003eNgày sản xuất: Xem trên bao bì sản phẩm\u003c/li\u003e\n\u003cli\u003eHạn sử dụng: 3 năm từ ngày sản xuất\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eTHÔNG TIN THƯƠNG HIỆU:\u003c/p\u003e\n\u003cp\u003eJohnson’s Baby là thương hiệu hàng đầu thế giới về các sản phẩm dành cho mẹ và bé, luôn nỗ lực vì sự phát triển toàn diện của trẻ em toàn cầu. Các dòng sản phẩm của thương hiệu khá đa dạng, bao gồm phấn trẻ em, dầu gội đầu, kem dưỡng, dầu massage, sữa tắm và khăn lau em bé. Với sứ mệnh “tạo ra những sản phẩm dịu nhẹ n.h.ấ trên thế giới để dành tặng cho bé yêu”, Johnson’s Baby cam kết đem đến các sản phẩm chất lượng, lành tính và vượt qua các tiêu chuẩn an toàn hàng đầu trên thế giới. Luôn tiếp thu khoa học công nghệ và quy trình mới, đảm bảo thực hiện đầy đủ các tiêu chuẩn quan trọng về chất lượng là lý do Johnson’s được tin cậy và trở thành người bạn thân thiết của mọi nhà.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003c/article\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/05/56/61/d8e213880895f551a9ef300ecd5a5b6a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/05/56/61/d8e213880895f551a9ef300ecd5a5b6a.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/05/56/61/d8e213880895f551a9ef300ecd5a5b6a.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/05/56/61/d8e213880895f551a9ef300ecd5a5b6a.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/05/56/61/d8e213880895f551a9ef300ecd5a5b6a.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/d8/d7/24/02720d84a2a8b605923b26fa0f36764a.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d8/d7/24/02720d84a2a8b605923b26fa0f36764a.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d8/d7/24/02720d84a2a8b605923b26fa0f36764a.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d8/d7/24/02720d84a2a8b605923b26fa0f36764a.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d8/d7/24/02720d84a2a8b605923b26fa0f36764a.png"},{"base_url":"https://salt.tikicdn.com/ts/product/9b/14/6b/df7b2e92b17f6d71dff4d21892d37de7.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/9b/14/6b/df7b2e92b17f6d71dff4d21892d37de7.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/9b/14/6b/df7b2e92b17f6d71dff4d21892d37de7.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9b/14/6b/df7b2e92b17f6d71dff4d21892d37de7.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9b/14/6b/df7b2e92b17f6d71dff4d21892d37de7.png"},{"base_url":"https://salt.tikicdn.com/ts/product/99/a2/34/abf0ba272650b4fb50e7a88aee6bedef.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/99/a2/34/abf0ba272650b4fb50e