ating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/66/2c/e7/46038021393d6442e8950ea066c8b064.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":123,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eTHÔNG TIN CHI TIẾT MÁY CẠO RÂU KHÔ VÀ ƯỚT PHILIPS S5880/20\u003c/p\u003e\n\u003cp\u003e+ Máy cạo râu Series 5000 của Philips.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/7f/b1/58/62f275164517d6676f62698fdcd3b172.jpg\" alt=\"7fb158d3ca80337ae01cd4522e4576dc.jpg\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eTÍNH NĂNG NỔI BẬT:\u003c/p\u003e\n\u003cp\u003e+ Lưỡi cạo SteelPrecision\u003c/p\u003e\n\u003cp\u003e+ Đầu cạo linh hoạt 360 độ\u003c/p\u003e\n\u003cp\u003e+ Cảm biến bộ điều hợp nguồn\u003c/p\u003e\n\u003cp\u003e+ Đầu tỉa tóc mai và ria mép tích hợp\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch3 class=\"p-heading-04-large p-heading-bold p-feature-title\"\u003eHiệu suất cao trong từng đường cạo\u003c/h3\u003e\n\u003cp class=\"p-body-copy-02\"\u003eVới tối đa 90.000 lần cạo mỗi phút, lưỡi cạo SteelPrecision giúp cạo sát, cắt được nhiều râu hơn trong mỗi lần cạo*. 45 lưỡi cạo hiệu suất cao sẽ tự mài bén và được sản xuất ở châu Âu.\u003c/p\u003e\n\u003cp class=\"p-body-copy-02\"\u003e \u003c/p\u003e\n\u003cp class=\"p-body-copy-02\"\u003e\u003cimg src=\"https://images.philips.com/is/image/philipsconsumer/9f9d970d2d394ac3adb4af3b0083e86e?wid=305\u0026amp;hei=173\u0026amp;$jpglarge$\" alt=\"Hiệu suất cao trong từng đường cạo\" width=\"305\" height=\"173\" /\u003e\u003c/p\u003e\n\u003ch3 class=\"p-heading-04-large p-heading-bold p-feature-title\"\u003eĐiều chỉnh bộ râu của bạn để cạo râu mà không mất nhiều công sức\u003c/h3\u003e\n\u003cp class=\"p-body-copy-02\"\u003eCảm biến râu và da mặt thông minh ghi mật độ râu 250 lần mỗi giây. Công nghệ tự động điều chỉnh công suất cắt để cạo nhẹ nhàng và không mất nhiều công sức.\u003c/p\u003e\n\u003cp class=\"p-body-copy-02\"\u003e \u003c/p\u003e\n\u003cp class=\"p-body-copy-02\"\u003e\u003cimg src=\"https://images.philips.com/is/image/philipsconsumer/6224fce1997e4d66a84aaf3b0083e4ee?wid=305\u0026amp;hei=173\u0026amp;$jpglarge$\" alt=\"Điều chỉnh bộ râu của bạn để cạo râu mà không mất nhiều công sức\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch3 class=\"p-heading-04-large p-heading-bold p-feature-title\"\u003eNút mở trong một lần chạm cho phép vệ sinh dễ dàng\u003c/h3\u003e\n\u003cp class=\"p-body-copy-02\"\u003eVệ sinh máy cạo râu dễ dàng. Chỉ cần một lần chạm nút, bạn có thể lật mở đầu máy cạo ra và rửa sạch bằng nước.\u003c/p\u003e\n\u003cp class=\"p-body-copy-02\"\u003e \u003c/p\u003e\n\u003cp class=\"p-body-copy-02\"\u003e\u003cimg src=\"https://images.philips.com/is/image/philipsconsumer/f05a20eba79a4076bbdaaef900e113a0?wid=305\u0026amp;hei=173\u0026amp;$jpglarge$\" alt=\"Nút mở trong một lần chạm cho phép vệ sinh dễ dàng\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch3 class=\"p-heading-04-large p-heading-bold p-feature-title\"\u003eCạo không dây trong tối đa 60 phút khi sạc đầy\u003c/h3\u003e\n\u003cp class=\"p-body-copy-02\"\u003eCạo râu không dây trong tối đa 60 phút sau một lần sạc đầy pin.\u003c/p\u003e\n\u003cp class=\"p-body-copy-02\"\u003e\u003cimg src=\"https://images.philips.com/is/image/philipsconsumer/2d0cdb5093994932aa6daf2400edf97f?wid=305\u0026amp;hei=173\u0026amp;$jpglarge$\" alt=\"Cạo không dây trong tối đa 60 phút khi sạc đầy\" /\u003e\u003c/p\u003e\n\u003ch3 class=\"p-heading-04-large p-heading-bold p-feature-title\"\u003eMàn hình LED với các biểu tượng cho phép sử dụng máy cạo râu một cách trực quan\u003c/h3\u003e\n\u003cp class=\"p-body-copy-02\"\u003eMàn hình trực quan hiển thị mọi thông tin liên quan, cho phép bạn có được trải nghiệm tốt nhất trên máy cạo râu của mình. Giao diện này bao gồm: trạng thái pin 3 mức độ, lời khuyên khi vệ sinh máy và chỉ báo khóa du lịch.\u003c/p\u003e\n\u003cp class=\"p-body-copy-02\"\u003e \u003c/p\u003e\n\u003cp class=\"p-body-copy-02\"\u003e\u003cimg src=\"https://images.philips.com/is/image/philipsconsumer/e2d7e46e9e334178b961aef900dcc2e5?wid=305\u0026amp;hei=173\u0026amp;$jpglarge$\" alt=\"Màn hình LED với các biểu tượng cho phép sử dụng máy cạo râu một cách trực quan\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eTHÔNG SỐ KỸ THUẬT:\u003c/p\u003e\n\u003cp\u003e+ Thương hiệu: Philips\u003c/p\u003e\n\u003cp\u003e+ Chất liệu: Lưỡi cắt bằng thép không gỉ\u003c/p\u003e\n\u003cp\u003e+ Màu sắc: Xanh\u003c/p\u003e\n\u003cp\u003e+ Điện áp: 100-240 V\u003c/p\u003e\n\u003cp\u003e+ Kiểu pin: Lion\u003c/p\u003e\n\u003cp\u003e+ Công suất: Thời gian sử dụng: 60 phút, Sạc điện: Sạc điện đầy trong 1 giờ\u003c/p\u003e\n\u003cp\u003e+ Xuất xứ: Trung Quốc\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/66/2c/e7/46038021393d6442e8950ea066c8b064.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/66/2c/e7/46038021393d6442e8950ea066c8b064.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/66/2c/e7/46038021393d6442e8950ea066c8b064.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/66/2c/e7/46038021393d6442e8950ea066c8b064.jpg","thumbnail_url":"h