ght":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":161000,"discount_rate":36,"rating_average":3.6,"review_count":5,"review_text":"(5)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ac/74/35/651e3b3284a669f29077030f1c14e56e.jpeg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2230,"all_time_quantity_sold":97,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003e+ Thương hiệu: Secret Key\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e+ Xuất xứ: Hàn Quốc\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e_ Kem dưỡng trắng da Secret Key Snow White Milky Pack sử dụng công thức chứa Niacinamide và chiết xuất từ sữa có tác dụng cung cấp độ ẩm, dưỡng chất, cải thiện làn da từ sâu bên trong, giúp da trắng sáng. Sản phẩm còn có khả năng cung cấp nước và các loại khoáng chất giúp làn da khô ráp, sần sùi trở nên ẩm mượt, mịn màng hơn\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003eƯu điểm nổi bật\u003c/strong\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e+ Đặc trưng: Là sản phẩm tắm trắng dạng kem cho mặt và cho toàn thân từ các hợp chất thiên nhiên không có các chất gây hại cho da như Phenzophenoe (chất ngăn tia cực tím khử mùi và gây hại cho da), dầu khoáng (gây tắc lỗ chân lông), paraben (chất bảo quản mỹ phẩm nhưng gây hại cho da)\u003c/p\u003e\n\u003cdiv class=\"syl-image-wrapper\"\u003e\u003cimg src=\"https://p16-oec-va.ibyteimg.com/tos-maliva-i-o3syd03w52-us/b0706f36e76845128cd932e1403dc4ff~tplv-o3syd03w52-origin-jpeg.jpeg\" alt=\"b0706f36e76845128cd932e1403dc4ff~tplv-o3syd03w52-origin-jpeg.jpeg\" width=\"1000\" height=\"1000\" /\u003e\u003c/div\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003eCông dụng\u003c/strong\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e️+ Làm trắng da an toàn\u003c/p\u003e\n\u003cp\u003e️+ Không gây hiện tượng khô da sau khi sử dụng\u003c/p\u003e\n\u003cp\u003e️+ Cung cấp ẩm và duy trì độ ẩm cho da giúp da mịn màng\u003c/p\u003e\n\u003cp\u003e+️ Nhờ vào các thành phần từ thiên nhiên nên việc làm trắng da rất an toàn\u003c/p\u003e\n\u003cp\u003e️+ Bổ sung các khoáng chất và dưỡng chất giúp nuôi dưỡng da từ sâu bên trong\u003c/p\u003e\n\u003cp\u003e️+ Phá các nhân tố tác động xấu cho da, làm giảm quá trình hình thành melanin\u003c/p\u003e\n\u003cp\u003e️+ Loại bỏ các vết sạm đen, đốm đen trên da giúp da đều màu\u003c/p\u003e\n\u003cp\u003e️+ Sử dụng cho cả mặt và toàn thân\u003c/p\u003e\n\u003cp\u003e️+ Có thể dùng như kem lót trang điểm\u003c/p\u003e\n\u003cp\u003e️+ An toàn phù hợp với mọi loại da\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/9b/49/5e/c2154621155f9afdd7456ddf222614ab.jpeg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003eThành Phần\u003c/strong\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e+ Chứa thành phần làm trắng an toàn cho da như Centella Asiatica, dầu hoa trà, Glyoerophosphoric axit, dầu Mầm lúa mì, B-glucan, Sodium Hyaluronate nên sử dụng thường xuyên sẽ giúp bạn có làn da trắng sáng\u003c/p\u003e\n\u003cp\u003e_ Sản phẩm dành cho những trường hợp sau\u003c/p\u003e\n\u003cp\u003e+ Những người thường xuyên phải make up, bi bít lỗ chân lông và da ngày càng bị xỉn màu\u003c/p\u003e\n\u003cp\u003e+ Những người có khuôn mặt không được tươi tắn\u003c/p\u003e\n\u003cp\u003e+ Những người muốn làm trắng cho cả face và body\u003c/p\u003e\n\u003cp\u003e+ Sản phẩm này làm cho da ngày càng trắng hơn và dưỡng ẩm cho da không bị thô ráp\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/4b/10/6a/8ad8165f31b7e172707bdf14c8fac3db.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003eHướng Dẫn Sử Dụng\u003c/strong\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e+ Sau khi rửa mặt hoặc tắm. Lau khô người. Bôi một lượng vừa đủ lên mặt hoặc phần cơ thể muốn làm trắng. Massage nhẹ nhàng trên khuôn mặt hoặc bất kỳ khu vực muốn làm trắng theo chuyển động tròn trong vòng 2-3 phút. sau đó để trên da khoảng 10' Rửa sạch với nước ấm không dùng sữa tắm hoặc sữa rửa mặt\u003c/p\u003e\n\u003cp\u003e+ Một tuần dùng 3 lần. Tốt nhất là cách 1 ngày dùng 1 lần\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003eLưu Ý\u003c/strong\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e+ Đây không phải là sản phẩm trắng da tạm thời, da bạn sẽ trắng dần lên sau mỗi lần sử dụng\u003c/p\u003e\n\u003cp\u003e+ Không nên tắm lại bằng sữa tắm. Nếu bạn tắm lại bằng sữa tắm cũng được nhưng lượng kem còn lại sẽ trôi hết và tác dụng dưỡng trắng của kem còn lưu lại trên da sẽ không nhiều\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ac/74/35/651e3b3284a669f29077030f1c14e56e.jpeg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ac/74/35/651e3b3284a669f29077030f1c14e56e.jpeg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ac/74/35/651e3b3284a669f29077030f1c14e56e.jpeg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ac/74/35/651e3b3284a669f29077030f1c14e56e.jpeg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ac/74/35