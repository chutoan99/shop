ef":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.7,"review_count":12,"review_text":"(12)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/7f/be/ec/173f2ef0f7a40fba3fe6c19dfbb9469e.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1035,"all_time_quantity_sold":110,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eLàm sạch vi khuẩn và mùi hôi trên cơ thể, mùi hương dịu nhẹ giúp bạn thoải mái khi sử dụng. Sản xuất theo dây chuyền công nghệ hàng đầu ở Mỹ.\u003c/p\u003e\n\u003cp\u003eLốc 8 bánh xà bông Coast 113g/cục siêu tiết kiệm Hương thơm nhẹ nhàng, làm sạch da và giữ mùi tốt sau khi tắm Cực an toàn kể cả làn da nhạy cảm.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCông dụng sản phẩm\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eXà Phòng Coast dạng cục không làm khô da tay, có tinh chất dưỡng da thích hợp cho cả người lớn và trẻ nhỏ.\u003c/li\u003e\n\u003cli\u003eTiện lợi khi sử dụng cho mọi nhu cầu vệ sinh cá nhân trong gia đình dùng làm xà phòng tắm hoặc rửa tay chân.\u003c/li\u003e\n\u003cli\u003eGiúp phòng chống những căn bệnh truyền nhiễm, chống khuẩn tốt\u003c/li\u003e\n\u003cli\u003eHương dịu nhẹ, thơm ngát tạo cảm giác sảng khoái, dễ chịu sau khi tắm.\u003c/li\u003e\n\u003cli\u003eTiết kiệm được nhiều chi phí cho việc chi tiêu mua sắm cho gia đình\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eƯu điểm\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eTận hưởng cảm giác sảng khoái cùng xà bông Coast huyền thoại. Có thể dùng làm xà bông rửa tay, xà bông tắm cho gia đình. Xà bông cục Coast với hương sóng và gió biển dịu nhẹ, giúp sát khuẩn, sạch da. Sẽ mang đến cho bạn một làn da thoáng mát và thật sảng khoái.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eHướng dẫn sử dụng\u003c/strong\u003e: Làm ướt xà phòng, thoa đều xà phòng lên da, tạo bọt và mát-xa nhẹ nhàng, sau đó tắm lại với nước.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eBảo quản\u003c/strong\u003e: Nơi khô ráo, thoáng mát. Tránh ánh nắng trực tiếp.\u003c/p\u003e\n\u003cp\u003eMẫu mã bao bì có thể thay đổi theo từng đợt nhập hàng. Nhưng đảm bảo chất lượng không đổi.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/7f/be/ec/173f2ef0f7a40fba3fe6c19dfbb9469e.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/7f/be/ec/173f2ef0f7a40fba3fe6c19dfbb9469e.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/7f/be/ec/173f2ef0f7a40fba3fe6c19dfbb9469e.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7f/be/ec/173f2ef0f7a40fba3fe6c19dfbb9469e.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7f/be/ec/173f2ef0f7a40fba3fe6c19dfbb9469e.png"},{"base_url":"https://salt.tikicdn.com/ts/product/3f/a1/60/216d9532d072d571cb7e4463383dedea.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/3f/a1/60/216d9532d072d571cb7e4463383dedea.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/3f/a1/60/216d9532d072d571cb7e4463383dedea.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3f/a1/60/216d9532d072d571cb7e4463383dedea.jpg","thumbnail_url":"https:/