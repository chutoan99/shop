.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":488900,"discount_rate":50,"rating_average":3,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/28/a6/21/cea14e406c88735cd9bee9133935de62.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":44,"all_time_quantity_sold":9,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eCombo: Viên rửa bát Finish Quantum max 100 viên \u0026#43; Muối Finish 1.2kg\u003cbr /\u003eLà combo chất tẩy rửa \u0026#34;Đơn giản và Hiệu quả\u0026#34;, thương hiệu của CHLB Đức và sản xuất tại Liên minh Châu Âu\u003cbr /\u003eViên rửa bát Finish quantum max 100viên: là viên rửa bát tổng hợp, 14 chức năng tẩy rửa, tổng hợp cả Muối làm mềm nước và Nước làm bóng. Tuy nhiên đối với những vùng có nước nặng, nhiều kim loại, hãng Finish khuyến cáo nên sử dụng thêm sản phẩm Muối làm mềm nước để bảo vệ máy khỏi cặn vôi giúp nâng cao tuổi thọ của máy rửa bát.\u003cbr /\u003eViên rửa bát Finish quantum max 100 viên\u003cbr /\u003eSản xuất: Châu Âu\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eLưu ý:\u003c/strong\u003e\u003cbr /\u003e\u003cstrong\u003e- Mẫu mã bao bì có thể thay đổi theo từng lô hàng nhập về nhưng chất lượng không đổi.\u003c/strong\u003e\u003cbr /\u003e\u003cstrong\u003e- Để nơi khô ráo, thoáng mát.\u003c/strong\u003e\u003cbr /\u003e\u003cstrong\u003e- Tránh ánh sáng trực tiếp.\u003c/strong\u003e\u003cbr /\u003eLà viên rửa bát tổng hợp với 6 công thức làm sạch hiệu quả:\u003cbr /\u003e1. Pre-Soaking Action: Chức năng ngâm, giúp bạn không phải tráng bát đĩa trước khi đưa vào máy\u003cbr /\u003e2. Powerful Cleaning: Làm sạch hiệu quả sẽ xử lý tất cả các vết bẩn do các món ăn\u003cbr /\u003e3. Cut through grease: Loại bỏ mỡ dai dẳng của các món ăn của bạn và tránh bị đóng cặn trong máy rửa bát\u003cbr /\u003e4. Helps to prevent water spots: Loại bỏ lượng nước dư thừa và giúp ngăn ngừa vết bẩn trong khi vẫn giữ độ bóng\u003cbr /\u003e5. Machine Limescale protection: Bảo vệ chống lại trầm tích vôi\u003cbr /\u003eĐừng quên rằng máy rửa chén của bạn được trang bị một buồng trao đổi ion đặc biệt làm giảm độ cứng của nước và ngăn ngừa sự tích tụ chất vôi. Nó nên được thường xuyên nạp lại bằng Finish Protective Coating , bảo vệ máy rửa chén, bộ lọc và máy giặt cũng như các món ăn và dao kéo\u003cbr /\u003e6. Low temperature action: Hiệu quả làm việc ngay cả ở nhiệt độ thấp\u003c/p\u003e\n\u003ch2\u003eCombo: Viên rửa bát Finish Quantum max 100 viên \u0026#43; Muối Finish 1.2kg\u003c/h2\u003e\n\u003cp\u003e- Là combo chất tẩy rửa \u0026#34;Đơn giản và Hiệu quả\u0026#34;, thương hiệu của CHLB Đức và sản xuất tại Liên minh Châu Âu\u003c/p\u003e\n\u003cp\u003e- Viên rửa bát Finish quantum max 100viên: là viên rửa bát tổng hợp, 14 chức năng tẩy rửa, tổng hợp cả Muối làm mềm nước và Nước làm bóng. Tuy nhiên đối với những vùng có nước nặng, nhiều kim loại, hãng Finish khuyến cáo nên sử dụng thêm sản phẩm Muối làm mềm nước để bảo vệ máy khỏi cặn vôi giúp nâng cao tuổi thọ của máy rửa bát.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch2\u003eViên rửa bát Finish quantum max 100 viên\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/fa/65/dc/5cf091b40187541cdaa2e4f0285f8c3d.jpg\" alt=\"\" width=\"750\" height=\"796\" /\u003e\u003c/h2\u003e\n\u003cp\u003e- Là viên rửa bát tổng hợp với công thức làm sạch hiệu quả:\u003c/p\u003e\n\u003cdiv\u003e1. Pre-Soaking Action: Chức năng ngâm, giúp bạn không phải tráng bát đĩa trước khi đưa vào máy\u003c/div\u003e\n\u003cdiv\u003e2. Powerful Cleaning: Làm sạch hiệu quả sẽ xử lý tất cả các vết bẩn do các món ăn\u003c/div\u003e\n\u003cdiv\u003e3. Cut through grease: Loại bỏ mỡ dai dẳng của các món ăn của bạn và tránh bị đóng cặn trong máy rửa bát\u003c/div\u003e\n\u003cdiv\u003e4. Helps to prevent water spots: Loại bỏ lượng nước dư thừa và giúp ngăn ngừa vết bẩn trong khi vẫn giữ độ bóng\u003c/div\u003e\n\u003cdiv\u003e5. Machine Limescale protection: Bảo vệ chống lại trầm tích vôi\u003c/div\u003e\n\u003cdiv\u003eĐừng quên rằng máy rửa chén của bạn được trang bị một buồng trao đổi ion đặc biệt làm giảm độ cứng của nước và ngăn ngừa sự tích tụ chất vôi. Nó nên được thường xuyên nạp lại bằng Finish Protective Coating , bảo vệ máy rửa chén, bộ lọc và máy giặt cũng như các món ăn và dao kéo\u003c/div\u003e\n\u003cdiv\u003e6. Low temperature action: Hiệu quả làm việc ngay cả ở nhiệt độ thấp\u003c/div\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch2\u003eMuối Finish 1.2kg\u003c/h2\u003e\n\u003cp\u003enhập khẩu từ CHLB Đức\u003c/p\u003e\n\u003cp\u003e- Tác dụng: \u003c/p\u003e\n\u003cdiv\u003e\u0026#43; Bảo vệ máy rửa bát khỏi cặn vôi\u003c/div\u003e\n\u003cdiv\u003e\u0026#43; Làm mềm nước cho quá trình làm sạch bát đĩa được hiệu quả hơn\u003c/div\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cem\u003eHình ảnh thực tế Hộp Muối làm mềm nước Finish 1,2kg\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCách sử dụng:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- \u003cstrong\u003eMuối làm mềm nước\u003c/strong\u003e: Đổ 1,2kg Muối Finish vào khoang để muối chuyên dụng; sử dụng được khoảng 2,5 tháng\u003c/p\u003e\n\u003cp\u003e- \u003cstrong\u003eNước làm bóng\u003c/strong\u003e: Đổ Nước làm bóng Finish vào khoang để nước làm bóng cho đến khi đầy (khoảng 150ml); sử dụng được khoảng 15 ngày.\u003c/p\u003e\n\u003cp\u003e- \u003cstrong\u003eViên rửa bát\u003c/strong\u003e : trường hợp rửa ít bát đĩa, quý khách hàng có thể sử dụng 1/2 viên\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/0f/cf/1c/22173e828ffae6e970c751e8a8e9c43a.jpg\" alt=\"22173e828ffae6e970c751e8a8e9c43a.jpg\" width=\"750\" height=\"422\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003eHình ảnh Máy rửa bát Bosch thông báo hết Muối và Nước làm bóng\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/f7/d4/42/f3133abe85488806511d0b7565cf3511.jpg\" alt=\"f3133abe85488806511d0b7565cf3511.jpg\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003eHình ảnh Khoang để muối chuyên dụng\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ca/93/01/397194219fd1b6dad912379f027deeb3.png\" alt=\"\" width=\"720\" height=\"540\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003eHình ảnh Vị trí để Viên rửa và Nước làm bóng\u003c/em\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/28/a6/21/cea14e406c88735cd9bee9133935de62.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/28/a6/21/cea14e406c88735cd9bee9133935de62.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/28/a6/21/cea14e406c88735cd9bee9133935de62.png","posi