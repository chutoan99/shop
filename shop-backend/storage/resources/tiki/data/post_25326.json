71483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":231000,"discount_rate":51,"rating_average":3.9,"review_count":8,"review_text":"(8)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/35/c2/cb/0ae5420fa5cc65e0db256d87c9330773.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":753,"all_time_quantity_sold":57,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2\u003e\u003cstrong\u003ePin sạc dự phòng 10000mAh Remax RPP-295 với thiết kế thanh lịch, ngoại hình nhỏ gọn sở hữu dung lượng pin cao, hỗ trợ sạc cùng lúc hai thiết bị mang đến cho người dùng nhiều trải nghiệm thú vị.\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/product/a8/c4/b0/a4aabb63475041e896a545e26df2f20b.jpg\" alt=\"Pin sạc dự phòng 10000mAh Remax RPP-295 1\" /\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eThiết kế thanh lịch, nhỏ gọn dễ mang theo\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003ePin sạc dự phòng 10000mAh Remax RPP-295 mang đến một vẻ ngoài thanh lịch sang trọng với ngoại hình nhỏ gọn và mỏng nhẹ kích thước chỉ 138 x 68.5 x 15.5mm cùng trọng lượng 225g dễ dàng mang theo bất cứ đâu. Với thiết kế này người dùng có thể bỏ pin vào trong túi quần áo mà không cần cất trong túi xách hay balo.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/product/27/b6/16/e654e26c76fc06564df341c655788bff.jpg\" alt=\"Pin sạc dự phòng 10000mAh Remax RPP-295 2\" /\u003e\u003c/p\u003e\n\u003cp\u003eMẫu pin sạc dự phòng này có vỏ ngoài được xây dựng từ vật liệu nhựa ABS và PC chống cháy cho độ cứng cáp và bền bỉ cực tốt. Vật liệu này đặc tính nhẹ nên chúng giúp làm giảm trọng lượng sản phẩm giảm nhẹ đồng thời chúng có khả năng chịu nhiệt tốt, chống nóng đảm bảo an toàn trong quá trình sử dụng. Bề mặt pin được phủ lớp sơn nhám nhẹ mang lại cảm giác cầm nắm thoải mái, chống trơn trượt.\u003c/p\u003e\n\u003cp\u003eCác đường nét sản phẩm được hoàn thiện tốt. Góc cạnh không cứng nhọn, thô kệch mà được bo cong trông rất tinh tế. Thiết kế này không chỉ tạo tính thẩm mỹ cao mà còn chống gây đau tay, cấn cộm khi cầm nắm.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/product/86/94/c3/72af76fdb87cd4b3dd8d2cfc2c3f423a.jpg\" alt=\"Pin sạc dự phòng 10000mAh Remax RPP-295 3\" /\u003e\u003c/p\u003e\n\u003cp\u003eCổng sạc được bộ trí ở phần cạnh trên của pin Remax RPP-295. Liền kề đó là kế hệ thống 4 đèn LED nhỏ để thông báo dụng lượng pin còn và tình trạng pin khi sử dụng. Mỗi đèn tương ứng 25%, 4 đèn sẽ là 100% pin.\u003c/p\u003e\n\u003cp\u003eThật tuyệt vời khi suốt hành trình của mình đều ngập tràn năng lượng. Nhờ sở hữu dung lượng pin lên đến 10000mAh, pin đáp ứng đầy đủ nhu cầu của người dùng trong cả ngày dài. Pin có thể sạc đầy cho iPhone 13 trong 2 lần, cho Huawei P40 khoảng 1.6 lần,  cho Xiaomi 11 Pro khoảng 1.2 lần và Vivo iQ007 khoảng 1.5 lần. Bạn thoải mái lướt web, lướt xem phim, chơi game, mà không lo điện thoại hết pin giữa chừng. \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/product/1d/fc/b7/25593ec22471059901d307a211a1a9b0.jpg\" alt=\"Pin sạc dự phòng 10000mAh Remax RPP-295 4\" /\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eSạc cùng lúc 2 thiết bị\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eTrên viên pin sạc dự phòng 10000mAh Remax RPP-295 được nhà sản xuất trang bị 4 giao diện sạc. Trong đó có 2 USB Output và 2 Input là Type C - Micro. Với sự bố trí này, pin dự phòng cho khả năng sạc cho 2 thiết bị di động cùng lúc thông qua 2 cổng USB.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/product/75/4e/d2/e834f9cd51291cf3fbe498b616041b39.jpg\" alt=\"Pin sạc dự phòng 10000mAh Remax RPP-295 5\" /\u003e\u003c/p\u003e\n\u003cp\u003eCả hai cổng USB 1 \u0026amp; USB 2 sở hữu nguồn điện 5V - 2.1A hỗ trợ người dùng cung cấp năng lượng nhanh chóng cho điện thoại, máy tính bảng và các thiết bị sử dụng dòng nhỏ hơn như tai nghe, loa Bluetooth, đồng hồ thông minh.\u003c/p\u003e\n\u003cp\u003eVới hai cổng sạc này bạn có thể sạc cho 2 thiết bị di động của mình hoặc có thể chia sẻ nguồn năng lượng cho bạn bè hay người thân xung quanh.\u003c/p\u003e\n\u003cp\u003eBên cạnh đó, hai cổng Input Micro - Type C sở hữu nguồn điện 5V - 2A giúp nạp đầy pin cho Remax RPP-295 chỉ trong 6 giờ.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/product/a0/3e/7e/41ce2779a967a8dd0ea7d7eb63f0054e.jpg\" alt=\"Pin sạc dự phòng 10000mAh Remax RPP-295 6\" /\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eTrang bị đầy đủ tính năng bảo vệ an toàn\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003ePin sạc dự phòng 10000mAh Remax RPP-295 sử dụng lõi pin polymer siêu bền chất lượng cao, chống cháy nổ an toàn bên trong giúp tăng tuổi thọ cho sản phẩm, đảm bảo an toàn cho thiết bị và người dùng trong suốt quá trình sạc.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/product/48/87/30/566b37a5ccc17ff73e834b46c84df436.jpg\" alt=\"Pin sạc dự phòng 10000mAh Remax RPP-295 7\" /\u003e\u003c/p\u003e\n\u003cp\u003eCông nghệ sạc thông minh tự cảm biến được điện áp để điều chỉnh dòng ra phù hợp với từng thiết bị khác nhau. Từ đó, pin có thể chủ động đưa ra nguồn điện phù hợp vừa sạc nhanh, vừa đảm bảo pin của thiết bị an toàn, tránh tình trạng chai pin, phồng pin.\u003c/p\u003e\n\u003cp\u003eBên cạnh đó, sản phẩm được trang bị nhiều tính năng bảo vệ thông minh như bảo vệ quá tải, bảo vệ quá áp, quá nhiệt, giúp quá trình sạc xả diễn ra an toàn, không gây nguy hiểm.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/product/72/4a/a4/2a92baa48dac93dba4fc4f19d5352570.jpg\" alt=\"Pin sạc dự phòng 10000mAh Remax RPP-295 8\" /\u003e\u003c/p\u003e\n\u003cp\u003eHành trình của bạn luôn ngập tràn năng lượng với Pin sạc dự phòng 10000mAh Remax RPP-295. Dung lượng lớn, sạc nhanh, thiết kế nhỏ gọn, đây chắc chắn là lựa chọn khiến bạn không phải thất vọng.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/35/c2/cb/0ae5420fa5cc65e0db256d87c9330773.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/35/c2/cb/0ae5420fa5cc65e0db256d87c9330773.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/35/c2/cb/0ae5420fa5cc65e0db256d87c9330773.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/35/c2/cb/0ae5420fa5cc65e0db256d87c9330773.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/35/c2/cb/0ae5420fa5cc65e0db256d87c9330773.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/84/b8/9a/40523b642dbb953e112dce36aad4186d.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/84/b8/9a/40523b642dbb953e112dce36aad4186d.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/84/b8/9a/40523b642dbb953e112dce36aad4186d.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/84/b8/9a/40523b642dbb953e112dce36aad4186d.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/84/b8/9a/40523b642dbb953e112dce36aad4186d.png"},{"base_url":"https://salt.tikicdn.com/ts/product/10/96/13/3ec0f126f133765894f10bbb9dd08b