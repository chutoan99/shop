868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.5,"review_count":17,"review_text":"(17)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/61/c8/b8/9864d019010fae178e07d140fbf6b1d0.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1251,"all_time_quantity_sold":65,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: center;\"\u003e\u003cspan style=\"background-color: #ffcc99;\"\u003e\u003cstrong\u003eBộ dây đàn guitar classic cao cấp Alice A106 - Hàng nguyên hộp - Hàng chính hãng\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cstrong\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/7d/74/70/25d66e6ec016cf2b2f4938156d424e13.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eGiữa rất nhiều dây guitar, có thể sẽ rất khó để lựa chọn loại dây nào phù hợp nhất với chiếc đàn guitar. Chọn đúng loại dây cho đàn giutar classic rất quan trọng, vì dây đàn sẽ quyết định hỗ trợ hoặc làm hỏng âm thanh và lối chơi guitar của bạn.\u003c/p\u003e\n\u003cp\u003e- Dây đàn thuộc loại Low tension - trầm ấm, vang to và rất classical. Tremolo hay - dùng loại Low tension thì tremolo sẽ đều đặn hơn. Vibrate sợi dây, nhéo dây dễ hơn, vì dây rất nhão. Đàn đánh được nhẹ hơn, good feeling. Ép dây, dây sẽ không bị nhoè qua dây khác.\u003c/p\u003e\n\u003cp\u003e- Loại Hard tension - nhiều Treble, âm thanh nghe rõ ràng, âm thanh bay đi như mũi tên, sắc bén hơn. Móc dây, ép dây, âm thanh nghe nhẹ nhàng và đầy đặn.\u003c/p\u003e\n\u003cp\u003e- Còn loại Normal tension: trung tính nhất, nằm ở giữa Low và Hard Tension. Có thể nói dùng phổ thông nhất.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eDây đàn guitar classic cao cấp Alice A106 \u003c/strong\u003elà loại Hard Tension nhiều Treble, âm thanh nghe rõ ràng, sắc nét.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/ac/b5/10/df196a0754cdb8571bf250155197bbbb.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eChất liệu lõi nylon bọc hợp kim mạ bạc, độ bền cao. Bộ 6 dây trơn màu, đủ kích cỡ cho đàn classic. Cụ thể là:\u003c/p\u003e\n\u003cp\u003eE-1st: 0,72mm - 0,0285inch\u003c/p\u003e\n\u003cp\u003eB-2nd: 0,83mm - 0,0325inch\u003c/p\u003e\n\u003cp\u003eG-3rd: 1,04mm - 0,041inch\u003c/p\u003e\n\u003cp\u003eD-4th: 0,76mm - 0,030inch\u003c/p\u003e\n\u003cp\u003eA-5th: 0,91mm - 0,036inch\u003c/p\u003e\n\u003cp\u003eE-6th: 1,12mm - 0.044inch\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/6a/a4/5e/dfa7bc4ae8555e9f5bde5c6713bb2bc4.jpg\" alt=\"\" width=\"750\" height=\"499\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eDây đàn guitar classic cao cấp Alice A106\u003c/strong\u003e thuộc loại trung bình, không quá mỏng cũng không quá dày, phù hợp với những bạn nào chơi đàn classic mà vẫn không quá nặng, không làm đau tay người dùng.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eDây đàn guitar classic cao cấp Alice A106\u003c/strong\u003e là dòng sản phẩm dây nylon của hãng Alice. Các dây đàn E-1, B-2, G-3 được làm từ nylon nhập khẩu, và D-4, A-5, E-6 được quấn tự động bằng đồng mạ bạc.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eDây đàn guitar classic cao cấp Alice A106 \u003c/strong\u003ecung cấp cho cây đàn guitar của bạn giai điệu sáng và phong phú. Đây là loại dây phổ biến, được nhiều người yêu thích.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/61/c8/b8/9864d019010fae178e07d140fbf6b1d0.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/61/c8/b8/9864d019010fae178e07d140fbf6b1d0.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/61/c8/b8/9864d019010fae178e07d140fbf6b1d0.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/61/c8/b8/9864d019010fae178e07d140fbf6b1d0.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/61/c8/b8/9864d019010fae178e07d140fbf6b1d0.png"},{"base_url":"https://salt.tikicdn.com/ts/product/1f/1f/83/e616c9faeb6c01feb5f21b37aeda799b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/1f/1f/83/e616c9faeb6c01feb5f21b37aeda799b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/1f/1f/83/e616c9faeb6c01feb5f21b37aeda799b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1f/1f/83/e616c9faeb6c01feb5f21b37aeda799b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1f/1f/83/e616c9faeb6c01feb5f21b37aeda799b.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/40/77/ae/ebafd298c567894ad20e9653203f60b7.jpg","is_gallery":true,"label":null,"large_url":"h