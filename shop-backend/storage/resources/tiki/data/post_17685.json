f":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"defective_product"}},"discount":480000,"discount_rate":19,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/a2/cd/7a/284fff3e2d1a54229f3f4877295b41e8.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":897,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cul class=\"border-bottom\"\u003e\n\u003cli\u003eNhãn hiệu: Burberry\u003c/li\u003e\n\u003cli\u003eGiới tính: Nam\u003c/li\u003e\n\u003cli\u003eNồng độ: Eau de Toilette (EDT)\u003c/li\u003e\n\u003cli\u003eNăm ra mắt: 2004\u003c/li\u003e\n\u003cli\u003eNhóm hương: Hương Phương Đông – Oriental\u003c/li\u003e\n\u003cli\u003ePhong cách: Nam Tính, Tinh Tế, Cuốn Hút\u003cbr /\u003eHương đầu: Quýt, Gừng, Cam bergamot, Bạch đậu khấu\u003cbr /\u003eHương giữa: Hạt nhục đậu khấu, Tuyết tùng, Hoa hồng dại, Hương cay\u003cbr /\u003eHương cuối: Đậu tonka, Hoắc hương, Gỗ phương đông, Tuyết tùng, Xạ hương\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eBurberry Brit For Him là mẫu nước hoa lịch lãm dành riêng cho các quý ông đã được ra mắt vào năm 2004. Burberry Brit For Him đã khắc họa hoàn hảo sự thống nhất tuyệt vời giữa hiện đại và truyền thống. Để tạo nên hình ảnh về những người đàn ông đậm chất Anh, Brit For Him được tạo nên theo một phong cách vừa sang trọng, vừa quyến rũ nhưng vẫn rất thoải mái; Kín đáo và nghiêm nghị.\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"aligncenter wp-image-37076\" title=\"Burberry Brit For Him 1\" src=\"https://salt.tikicdn.com/ts/product/69/f1/a1/eb65cb0a3d85db5cfe467e2f41a6d030.jpg\" sizes=\"(max-width: 450px) 100vw, 450px\" srcset=\"https://salt.tikicdn.com/ts/product/69/f1/a1/eb65cb0a3d85db5cfe467e2f41a6d030.jpg 720w, https://salt.tikicdn.com/ts/product/38/6d/51/b0b89ccc11d2062de29dba688f0a1e06.jpg 600w, https://salt.tikicdn.com/ts/product/b9/1b/bb/5ce2bec220c46c80a6f641fd1adb2cab.jpg 300w, https://salt.tikicdn.com/ts/product/a4/7f/9d/093e89d2ae71ddc5933521bcac5f5c05.jpg 150w\" alt=\"Burberry Brit For Him 3\" width=\"450\" height=\"450\" /\u003e\u003c/p\u003e\n\u003cp\u003eBurberry Brit For Him mở đầu tươi mát của hỗn hợp cam chanh( gồm quýt, cam bergamot), hương gừng nồng nàn và bạch đậu khấu dần chuyển sang một vẻ đẹp nam tính đầy mãnh liệt với gỗ tuyết tùng và đậu khấu, điểm xuyết thêm một ít tinh tế của hoa hồng dại. Lớp hương cuối trở nên gợi cảm và quyến rũ nhờ vào những hương gỗ ấm nóng, hổ phách xám, đậu tonka và hoắc hương. Loại nước hoa gỗ – phương đông này là sự pha trộn tuyệt vời của những trái quýt xanh mọng nước hay các lát cắt từ gừng tươi, phảng phất thêm một chút hoa hồng dại và gỗ tuyết tùng. Mùi hương vừa dễ chịu, nhẹ nhàng nhưng vẫn không kém phần Nam Tính, Tinh Tế và Cuốn Hút.\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"aligncenter wp-image-37077\" title=\"Burberry Brit For Him 2\" src=\"https://salt.tikicdn.com/ts/product/8b/fb/c8/3c1fd2f7b2be7e1078dbf79102ed07cc.jpg\" sizes=\"(max-width: 500px) 100vw, 500px\" srcset=\"https://salt.tikicdn.com/ts/product/8b/fb/c8/3c1fd2f7b2be7e1078dbf79102ed07cc.jpg 718w, https://salt.tikicdn.com/ts/product/4c/6b/c3/28598d165dbe52685133949030255f6c.jpg 600w, https://salt.tikicdn.com/ts/product/f3/15/69/65f3fe22cbb01854d6fa94e09599611d.jpg 150w\" alt=\"Burberry Brit For Him 1\" width=\"500\" height=\"669\" /\u003e\u003c/p\u003e\n\u003cp\u003eChai nước hoa được thiết kế bởi Fabien Baron, Lớp thủy tinh mờ màu hun khói được tô điểm với hoa văn ca-rô độc quyền của hãng. Đây cũng được xem là sự nhắc nhở về sự tồn tại của phiên bản Brit dành cho nữ.\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/a2/cd/7a/284fff3e2d1a54229f3f4877295b41e8.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a2/cd/7a/284fff3e2d1a54229f3f4877295b41e8.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a2/cd/7a/284fff3e2d1a54229f3f4877295b41e8.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a2/cd/7a/284fff3e2d1a54229f3f4877295b41e8.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a2/cd/7a/284fff3e2d1a54229f3f4877295b41e8.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/7a/0f/28/2321d781ef12bf1f0b35342aa2233f92.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/7a/0f/28/2321d781ef12bf1f0b35342aa2233f92.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/7a/0f/28/2321d781ef12bf1f0b35342aa2233f92.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7a/0f/28/2321d781ef12bf1f0b35342aa2233f92.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7a/0f/28/2321d781ef12bf1f0b35342aa2233f92.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/5b/47/c8/b368f42c6bedfc4afee2ca3786b45b81.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/5b/47/c8/b368f42c6bedfc4afee2ca3786b45b81.j