66e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":32850,"discount_rate":15,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/38/27/d5/8af07cf6b7227a36e48bfccd2a2764b0.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":302,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003e\u003cstrong\u003eKem đánh răng cho bé Babycoccole 12M+ trẻ em nuốt được 75ml\u003c/strong\u003e\u003c/h3\u003e\n\u003ch3\u003e\u003cstrong\u003eGiới thiệu\u003c/strong\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eBé đánh răng thường xuyên mà vẫn sâu răng, mắc các vấn đề về răng miệng? Vì trong Kem Đánh răng KHÔNG có chứa Fluoride! Kem đánh răng cho bé Babycoccole 12M+ là ản phẩm DUY NHẤT trên thị trường dành cho bé CÓ CHỨA Flour mà an toàn tuyệt đối khi nuốt. Xuất xứ tại Ý\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eĐược 85.3% gia đình tại Ý tin dùng trong suốt 50 năm qua. Tất cả thành phần nguyên liệu đều được lựa chọn từ các nông trại canh tác hữu cơ hàng đầu của thế giới, từ đó mang đến những sản phẩm có nguồn gốc từ thiên nhiên, mang đậm mùi hương nước Ý. Công ty đã liên kết nhiều năm với Đại học Pavia, được xem như “Đại học Oxford” của Ý. Tất cả các sản phẩm của chúng tôi đều vượt qua 21 bài kiểm tra về da nhạy cảm và đạt được công thức dành riêng cho da nhạy cảm, bằng cách chắt lọc các thành phần tự nhiên hữu cơ.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003e\u003cstrong\u003eThành phần\u003c/strong\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eNước, Glycerin, Xylitol , Aroma (flavor), Sodium, Monofluorophosphate, Calcium, Tocopheryl acetate: Vitamin E\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003e\u003cstrong\u003eĐặc điểm nổi bật\u003c/strong\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eSản phẩm đã được kiểm nghiệm an toàn. Tại Việt Nam, sản phẩm đã được Bộ Y tế cấp giấy phép lưu hành số 136936/20/CBMP-QLD.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eBảo vệ bé khỏi sâu răng:\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e Hiệp hội Nha khoa Mỹ khuyến cáo nên cho các bé 12M+ chải răng hai lần mỗi ngày bằng kem đánh răng có chứa Fluor từ khi chiếc răng sữa đầu tiên xuất hiện. Giúp ngăn ngừa axit có hại được tiết ra từ mảng bám, từ đó làm giảm đáng kể nguy cơ sâu răng và viêm lợi. Trên thực tế, nếu không bổ sung đủ lượng Fluorine cần thiết có thể làm tăng nguy cơ sâu răng ở trẻ nhỏ.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eCông thức bảo vệ răng vượt trội:\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e cung cấp thêm canxi, vitamin và các hương vị tự nhiên giúp củng cố cấu trúc của răng mà không gây hại cho các mô nướu, bảo vệ men răng.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eMột loại kem đánh răng lý tưởng dành riêng cho răng sữa:\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e với hương vị thơm dịu ngọt của táo nhẹ nhàng; không chỉ ngăn ngừa sâu răng mà còn làm cho răng sữa của bé chắc khỏe và khỏe mạnh hơn. Cùng bé có thêm nhiều trải nghiệm thú vị.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eKem đánh răng cho bé babycoccole an toàn tuyệt đối khi bé nuốt kem:\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e bởi thành phần chiết xuất tự nhiên.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eThành phần cân bằng gồm fluoride, canxi và vitamin giúp củng cố cấu trúc của răng mà không gây hại cho các mô nướu. \u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003e\u003cstrong\u003eCông dụng\u003c/strong\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eGiúp bé chải sạch răng, ngăn ngừa sâu răng vượt trội so với các sản phẩm KHÔNG chứa Flouride\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eKem đánh răng dành cho bé từ 1 tuổi trở lên\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eMùi hương trái cây ngọt ngào, AN TOÀN TUYỆT ĐỐI nếu bé NUỐT KEM\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eBảo vệ răng, nướu nhạy cảm cho bé.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003e\u003cstrong\u003eHướng dẫn sử dụng\u003c/strong\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eSử dụng một lượng kem đánh răng cho bé nhỏ để đánh răng hàng ngày. Mỗi ngày trẻ nên đánh răng tối thiểu 2 lần/ngày.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003e\u003cstrong\u003eHướng dẫn bảo quản\u003c/strong\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eBảo quản ở nơi khô ráo, thoáng mát, tránh ánh nắng trực tiếp.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/38/27/d5/8af07cf6b7227a36e48bfccd2a2764b0.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/38/27/d5/8af07cf6b7227a36e48bfccd2a2764b0.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/38/27/d5/8af07cf6b7227a36e48bfccd2a2764b0.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/38/27/d5/8af07cf6b7227a36e48bfccd2a2764b0.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/38/27/d5/8af07cf6b7227a36e48bfccd2a2764b0.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/d0/73/8e/bdc639d3ee26b2a75506e0bbfceed289.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d0/73/8e/bdc639d3ee26b2a75506e0bbfceed289.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d0/73/8e/bdc639d3ee26b2a75506e0bbfceed289.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d0/73/8e/bdc639d3ee26b2a75506e0bbfceed289.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d0/73/8e/bdc639d3ee26b2a75506e0bbfceed289.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/fa/73/4e/d7f74182e0fd52abfa0be37be771fea0.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/fa/73/4e/d7f74182e0fd52abfa0be37be771fea0.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/fa/73/4e/d7f74182e0fd52abfa0be37be771fea0.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fa/73/4e/d7f74182e0fd52abfa0be37