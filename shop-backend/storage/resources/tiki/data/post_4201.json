,"rating_average":4.8,"review_count":67,"review_text":"(67)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/7d/5d/56/e084c1d0e088487c359a762b7ce3198a.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":0,"all_time_quantity_sold":178,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: medium; color: #ff6600;\"\u003e\u003cstrong\u003eCombo Sherlock Holmes Toàn Tập\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eSherlock Holmes là một nhân vật thám tử hư cấu vào cuối thể kỉ 19 và đầu thế kỉ 20, xuất hiện lần đầu trong tác phẩm của nhà văn Arthur Conan Doyle xuất bản năm 1887. Ông là một thám tử tư ở Luân Đôn nổi tiếng nhờ trí thông minh, khả năng suy diễn logic và quan sát tinh tường trong khi phá những vụ án mà cảnh sát phải bó tay. Nhiều người cho rằng Sherlock Holmes là nhân vật thám tử hư cấu nổi tiếng nhất trong lịch sử văn học và là một trong những nhân vật văn học được biết đến nhiều nhất toàn thế giới.\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eSherlock Holmes đã xuất hiện trong 4 tiểu thuyết và 56 truyện ngắn của nhà văn Conan Doyle. Hầu như tất cả các tác phẩm đều được viết dưới dạng ghi chép của bác sĩ John H. Watson, người bạn thân thiết và người ghi chép tiểu sử của Sherlock Holmes, chỉ có 2 tác phẩm được viết dưới dạng ghi chép của người thứ ba. Hai tác phẩm đầu tiên trong số này là 2 tiểu thuyết ngắn và được xuất hiện lần đầu tiên trên tờ Beeton's Christmas Annual vào năm 1887 và tời Lippincott's Monthly Magazine vào văm 1890. Thám tử Holmes trở nên cực kì nổi tiếng khi loạt truyện ngắn của Conan Doyle được xuất bản trên tạp chí The Strand Magazine năm 1891. Các tác phẩm được viết xoay quanh thời gian từ năm 1878 đến năm 1903 với vụ án cuối cùng vào năm 1914.\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eCombo Sherlock Holmes Toàn Tập\u003c/strong\u003e gồm 3 tập:\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eSherlock Holmes Toàn Tập - Tập 1\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eSherlock Holmes Toàn Tập - Tập 2\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eSherlock Holmes Toàn Tập - Tập 3.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/7d/5d/56/e084c1d0e088487c359a762b7ce3198a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/7d/5d/56/e084c1d0e088487c359a762b7ce3198a.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/7d/5d/56/e084c1d0e088487c359a762b7ce3198a.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7d/5d/56/e084c1d0e088487c359a762b7ce3198a.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7d/5d/56/e084c1d0e088487c359a762b7ce3198a.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/5b/72/17/37bddf7edb236a569f2c34952b8588fe.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/5b/72/17/37bddf7edb236a569f2c34952b8588fe.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/5b/72/17/37bddf7edb236a569f2c34952b8588fe.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5b/72/17/37bddf7edb236a569f2c34952b8588fe.jpg","thumbnail_url":"https://