},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":191000,"discount_rate":18,"rating_average":4.8,"review_count":5,"review_text":"(5)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/c9/0f/e5/a67ef6122f8044ca259422b9acdb7ba3.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":264,"all_time_quantity_sold":28,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cdiv class=\"product-detail page-product__detail\"\u003e\n\u003csection class=\"U9rGd1\"\u003e\n\u003cdiv class=\"MCCLkq\"\u003e\n\u003cdiv class=\"f7AU53\"\u003e\n\u003cp class=\"irIKAp\"\u003e- Dung tích thực 6L, 1600W\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Màn hình LED cảm ứng\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Nhìn thấu bên trong khi nấu\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Công nghệ làm nóng Rapid 360º\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- 8 chế độ nấu tự động\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Mặt trước thép không rỉ\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Khoang trong thép không rỉ\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e- Lòng nồi tráng men chống dính\u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003e \u003c/p\u003e\n\u003cp class=\"irIKAp\"\u003eNồi chiên không dầu AGAL 6.5L AF-650VCS với lòng nồi rộng rãi, dung tích thực nấu đến 6.5 lít, chiên được nguyên con gà tới 1.2 kg, phù hợp với gia đình 3-5 người. Công suất mạnh mẽ lên tới 1600W giúp chiên nấu nhanh chóng, tiết kiệm tối đa thời gian chế biến.\u003c/p\u003e\n\u003cdiv class=\"irIKAp\"\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"cxDtMn\"\u003e\u003cimg class=\"_0O7Vlf bgImIg\" src=\"https://down-vn.img.susercontent.com/file/vn-11134208-7r98o-lpkjsrqxus7od3\" alt=\"vn-11134208-7r98o-lpkjsrqxus7od3\" /\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cp class=\"irIKAp\"\u003eMàn hình LED hiển thị sang trọng, kết hợp với phím cảm ứng nhanh nhạy tiện dụng, dễ dàng quan sát, dễ thao tác.\u003c/p\u003e\n\u003cdiv class=\"irIKAp\"\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"cxDtMn\"\u003e\u003cimg class=\"_0O7Vlf bgImIg\" src=\"https://down-vn.img.susercontent.com/file/vn-11134208-7r98o-lpkjsrqxw6s463\" alt=\"vn-11134208-7r98o-lpkjsrqxw6s463\" /\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cp class=\"irIKAp\"\u003eMặt trước khay nồi nấu trong suốt, có đèn chiếu sáng bên trong thuận tiện quan sát thức ăn trong suốt quá trình nấu.\u003c/p\u003e\n\u003cdiv class=\"irIKAp\"\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"cxDtMn\"\u003e\u003cimg class=\"_0O7Vlf bgImIg\" src=\"https://down-vn.img.susercontent.com/file/vn-11134208-7r98o-lpkjsrqxxlck76\" alt=\"vn-11134208-7r98o-lpkjsrqxxlck76\" /\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cp class=\"irIKAp\"\u003eNhiệt độ nồi từ 80 – 200°C, thời gian 0 – 60 phút, dễ dàng điều chỉnh thông số hoặc chọn linh hoạt với 8 chế độ nấu tự động để chiên nướng nhiều loại thực phẩm khác nhau.\u003c/p\u003e\n\u003cdiv class=\"irIKAp\"\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"cxDtMn\"\u003e\u003cimg class=\"_0O7Vlf bgImIg\" src=\"https://down-vn.img.susercontent.com/file/vn-11134208-7r98o-lpkjsrqxyzx053\" alt=\"vn-11134208-7r98o-lpkjsrqxyzx053\" /\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cp class=\"irIKAp\"\u003eVỏ nồi được làm bằng nhựa ABS nguyên sinh an toàn, phía trước mặt bọc 1 lớp thép không rỉ sang trọng, an toàn và dễ lau chui. Bên trong khoang nóng cũng được gia cố thêm 1 lớp thép không rỉ đảm bảo thực phẩm luôn được bảo vệ khỏi các tác nhân gây hại khác sinh ra khi chiên nấu ở nhiệt độ cao.\u003c/p\u003e\n\u003cdiv class=\"irIKAp\"\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"cxDtMn\"\u003e\u003cimg class=\"_0O7Vlf bgImIg\" src=\"https://down-vn.img.susercontent.com/file/vn-11134208-7r98o-lpkjsrqy0ehgca\" alt=\"vn-11134208-7r98o-lpkjsrqy0ehgca\" /\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cp class=\"irIKAp\"\u003eLòng nồi tráng men chống dính, đảm bảo an toàn khi chiên nướng ở nhiệt độ cao, chống dính cháy, dễ chùi rửa sau khi nấu.\u003c/p\u003e\n\u003cdiv class=\"irIKAp\"\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"cxDtMn\"\u003e\u003cimg class=\"_0O7Vlf bgImIg\" src=\"https://down-vn.img.susercontent.com/file/vn-11134208-7r98o-lpkjsrqy1t1w2b\" alt=\"vn-11134208-7r98o-lpkjsrqy1t1w2b\" /\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/section\u003e\n\u003c/div\u003e\n\u003cdiv\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"product-ratings\"\u003e\n\u003cdiv class=\"product-ratings__header\"\u003e\n\u003cdiv class=\"product-ratings__header_score\"\u003eĐÁNH GIÁ SẢN PHẨM\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"product-rating-overview\"\u003e\n\u003cdiv class=\"product-rating-overview__briefing\"\u003e\n\u003cdiv class=\"product-rating-overview__score-wrapper\"\u003e\u003cspan class=\"product-rating-overview__rating-score\"\u003e0\u003c/span\u003e\u003cspan class=\"product-rating-overview__rating-score-out-of\"\u003e trên 5\u003c/span\u003e\u003c/div\u003e\n\u003cdiv class=\"shopee-rating-stars product-rating-overview__stars\"\u003e\n\u003cdiv class=\"shopee-rating-stars__stars\"\u003e\n\u003cdiv class=\"shopee-rating-stars__star-wrapper\"\u003e\n\u003cdiv class=\"shopee-rating-stars__lit\"\u003e \u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"shopee-rating-stars__star-wrapp