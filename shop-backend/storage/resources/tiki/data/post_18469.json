483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":65000,"discount_rate":33,"rating_average":5,"review_count":7,"review_text":"(7)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/8a/1c/13/88e85954d9180270c334ff0cf101c2ea.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":635,"all_time_quantity_sold":50,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\n\u003cp\u003e\u003cspan\u003eLõi lọc thô số 1 - Smax Duo 1 - Vi lọc: được làm tự vật liệu: Polypropylen\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003eVật liệu: Polypropylen.\u003c/p\u003e\n\u003cp\u003eNhờ cấu tạo đặc biệt với các sợi vi liên kết siêu nhỏ trải quá trình ép tạo lõi ở áp suất cao giúp lọc được các hạt siêu bụi và nhiều cặn bẩn hơn so với lõi thông thường. Công nghệ vi lọc 5 micron được nghiên cứu và sản xuất trên dây chuyền gia nhiệt hiện đại với nhiệt độ lên tới 245°C và trải qua quá trình ép phun tạo nên chuỗi các sợi vi liên kết có kích thước cực nhỏ chỉ từ 2-4 micron.\u003c/p\u003e\n\u003cp\u003eGiúp loại bỏ các cặn bã, chất bẩn, cạn, sát, bùn, tảo rêu có kích thước trên 5 micron lẫn trong nguồn nước sử dụng hàng ngày.\u003c/p\u003e\n\u003cp\u003eThời gian sử dụng: Khuyến cáo tối đa 12 tháng tương đương (10.000L – 15.000 L). Thời hạn sử dụng lõi lọc phụ thuộc vào chất lượng nguồn nước tại mỗi khu vực và mức độ sử dụng.\u003c/p\u003e\n\u003cp\u003eVì vậy, cần lưu ý kiểm tra thường xuyên đảm bảo nước sau lọc luôn đạt chuẩn tinh khiết\u003c/p\u003e\n\u003cp\u003eLưu ý: Tránh ánh nắng tiếp xúc trực tiếp, có thể mọc rêu. Khi lắp lõi vào máy chú ý không để lệch tạo khe hở\u003c/p\u003e\n\u003cp\u003eChức năng: Lọc các tạp chất hữu cơ, rỉ sét, bùn đất hay các chất lơ lửng trong nước có kích thước lớn hơn 5 micron\u003c/p\u003e\n\u003cp\u003eThời gian thay thế:\u003c/p\u003e\n\u003cp\u003eĐối với nguồn nước thông thường (Nước máy, nước mưa): Thời gian thay thế 3 – 6 tháng/lần (Nước cấp đầu vào khoảng 5.500 lít – 10.900 lít)\u003c/p\u003e\n\u003cp\u003eĐối với nguồn nước cứng, nước nhiễm đá vôi (Nước chứa Ca­­­­­­2+ \u0026amp; Mg2+), nước giếng khoan, giếng khơi hoặc nước đặc thù có thời gian thay thế 1.5 – 3 tháng/ lần (Nước cấp đầu vào khoảng 3.100 lít – 10.400 lít)\u003c/p\u003e\n\u003cp\u003eDùng cho mọi nguồn nước.\u003c/p\u003e\n\u003cp\u003eSHOP CAM KẾT:\u003c/p\u003e\n\u003cp\u003e- Đóng gói cẩn thận trước khi chuyển đi.\u003c/p\u003e\n\u003cp\u003e- Hoàn tiền 100% nếu không đúng cam kết.\u003c/p\u003e\n\u003cp\u003e- Quý khách cần tư vấn hãy inbox cho shop.\u003c/p\u003e\n\n\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/8a/1c/13/88e85954d9180270c334ff0cf101c2ea.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/8a/1c/13/88e85954d9180270c334ff0cf101c2ea.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/8a/1c/13/88e85954d9180270c334ff0cf101c2ea.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8a/1c/13/88e85954d9180270c334ff0cf101c2ea.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8a/1c/13/88e85954d9180270c334ff0cf101c2ea.png"},{"base_url":"https://salt.tikicdn.com/ts/product/b3/9f/e2/7cbf6355a1