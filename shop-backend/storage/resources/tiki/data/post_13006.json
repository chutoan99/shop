hentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":125000,"discount_rate":31,"rating_average":4.6,"review_count":104,"review_text":"(104)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/83/21/23/55c1e6fb3a131b2b42e59d609044709e.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1475,"all_time_quantity_sold":392,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eĐặc tính sản phẩm:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e1. Tròng kính được làm từ chất liệu PC chuyên làm kính cho mũ bảo hiểm của các phi hành gia vũ trụ, với độ trong suốt, tính quang học cực cao. Đồng thời, bề mặt kính rất cứng, chống mài mòn và chống tia cực tím.\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e2. Mặt kính được phủ lớp chống tia UV, giúp mắt an toàn khi đi biển\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e3. Bề mặt bên trong của tròng kính sử dụng chất chống sương mù (hơi nước) chuyên dụng, chống thấm nước, không gây kích ứng cho mắt, cho tầm quan sát rõ ràng trong mọi môi trường nước.\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e4. Lớp ngoài cùng được tráng gương, giúp mắt không bị chói khi trời nắng, tăng thêm sự cuốn hút.\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e5. Phần nối 2 tròng kính được làm từ chất liệu PU thân thiện với môi trường có độ dẻo dai rất cao.\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e6. Vòng cao su chụp mắt được làm 100% silicone không gây kích ứng da. Được thiết kế theo nhân trắc học, giúp kính ôm sát mắt, chống vào nước và giúp mở rộng tối đa góc nhìn khi đeo.\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e7. Dây đeo được làm 100% silicone mềm mại, thoải mái, thiết kế không trơn trượt, độ co giãn và độ bền thách thức thời gian.\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eHướng dẫn sử dụng và bảo quản sản phẩm:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e1. Ngâm nước bên trong tròng kính trước khi đeo giúp tăng hiệu quả chống sương.\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e2. Sau khi sử dụng kính dùng nước sạch để rửa và để khô tự nhiên, tránh lau bên trong tròng kính sẽ làm mất tác dụng của lớp phủ chống sương mù.\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e3. Đeo cố định vị trí mắt trước, kéo dây ra sau đầu. Điều chỉnh dây đeo cho phù hợp với đầu.\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e4. Thao tác ngược lại khi không dùng kính nữa.\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e5. Đặt kính vào hộp trở lại sau khi kính đã khô tự nhiên, nếu được hãy đặt miếng chống ẩm để bảo quản kính tốt nhất.\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/19/24/03/b98286f7bb44226161e653c4f00f18d7.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/89/8d/72/4dc024c4294f1438908f7bc670886f46.jpg\" alt=\"\" width=\"750\" height=\"249\" /\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/cc/d3/0b/8dd637f5b0935cbbe1693e8ededa2684.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.