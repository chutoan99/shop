info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":510000,"discount_rate":43,"rating_average":4,"review_count":8,"review_text":"(8)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/7b/49/e0/2eded112a9591a68d3fe057d987294c3.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1220,"all_time_quantity_sold":13,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2 style=\"font-weight: 500; text-align: center;\"\u003e\u003cstrong\u003eTai nghe True Wireless Energizer UB2609 – Thiết kế cá tính, tầm giá phù hợp, tích hợp pin dự phòng\u003c/strong\u003e\u003c/h2\u003e\n\u003cp style=\"font-weight: 400;\"\u003eLà một trong những sản phẩm của series tai nghe True Wireless Energizer, UB2609 mang trên mình thiết kế chuẩn dòng tai nghe không dây TWS như các loại tai nghe của khác. Và dĩ nhiên, UB2609 cũng thể hiện nét đặc trưng của một thương hiệu hàng đầu về sản xuất pin năng lượng – Tích hợp sạc dự phòng\u003c/p\u003e\n\u003cp style=\"font-weight: 400; text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/9b/be/28/9faf7130d728c201e5cf3cc114744bbb.png\" width=\"750\" height=\"499\" /\u003e\u003c/p\u003e\n\u003ch3 style=\"font-weight: 500;\"\u003e\u003cstrong\u003eThiết kế cá tính, mạnh mẽ với những góc bo vuông vắn khác biệt\u003c/strong\u003e\u003c/h3\u003e\n\u003cp style=\"font-weight: 400;\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/product/05/03/60/9990135a0786881b19153558fa28a45e.png\" width=\"608\" height=\"637\" /\u003e\u003c/p\u003e\n\u003cp style=\"font-weight: 400;\"\u003eGiải phóng bản thân khỏi dây cáp vướng víu của các mẫu tai nghe truyền thống. UB2609 thiết kế không dây, tự do hơn, an toàn hơn khi trả lời mọi cuộc gọi khi không rảnh tay lúc lái xe, tập luyện thể thao hay làm việc\u003c/p\u003e\n\u003cp style=\"font-weight: 400;\"\u003eThiết kế gọn nhẹ chỉ khoảng 70g cho cả hộp sạc giúp bạn dễ dàng mang theo bên mình. Thiết kế tiện dụng, nhỏ gọn và thời trang, hoàn toàn vừa vặn, không gây đau tai khi đeo nhiều giờ\u003c/p\u003e\n\u003cp style=\"font-weight: 400;\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/f1/5e/64/23689aec7cc59420d27329f118e4532c.png\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"font-weight: 400;\"\u003eBluetooth V5.0 tương thích với nhiều thiết bị điện thoại, máy tính bảng, máy nghe nhạc MP Tự động kết nối với thiết bị từ lần thứ 2\u003c/p\u003e\n\u003cp style=\"font-weight: 400;\"\u003eGọi rảnh tay khi UB2609 tích hợp Micro hỗ trợ trả lời cuộc gọi an toàn hơn\u003c/p\u003e\n\u003cp style=\"font-weight: 400;\"\u003eKháng nước IPX4, bạn hoàn toàn thoải mái vận động ngay cả trong nhà lẫn ngoài trời\u003c/p\u003e\n\u003cp style=\"font-weight: 400;\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/65/c9/d2/74c530df2e52af503d48e49847c94749.png\" width=\"750\" height=\"705\" /\u003e\u003c/p\u003e\n\u003ch3 style=\"font-weight: 500;\"\u003e\u003cstrong\u003eChất lượng âm thanh mạnh mẽ\u003c/strong\u003e\u003c/h3\u003e\n\u003cp style=\"font-weight: 400;\"\u003eChất lương âm thanh mạnh mẽ khi tích hợp trình điều khiển động 6mm cung cấp khả năng truyền bluetooth nhanh chóng. điều chỉnh chuyên nghiệp cho ra chất lượng âm thanh tuyệt vời\u003c/p\u003e\n\u003ch3 style=\"font-weight: 500;\"\u003e\u003cstrong\u003eDung lượng và thời lượng pin ấn tượng\u003c/strong\u003e\u003c/h3\u003e\n\u003cp style=\"font-weight: 400;\"\u003ePin của tai nghe có dung lượng 40mAh, cho khả năng chơi nhạc khoảng 4h mỗi lần sạc.\u003c/p\u003e\n\u003cp style=\"font-weight: 400;\"\u003eDung lượng hộp sạc 2600mAh, tai nghe có thể bỏ vào hộp và sạc lại bất cứ lúc nào. Nếu sạc độc lập, tai nghe có thể sạc lại đến 60 lần.\u003c/p\u003e\n\u003cp style=\"font-weight: 400;\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/65/a3/f3/e501ab5e27cf49c3ea091a28f30f1143.png\" width=\"750\" height=\"670\" /\u003e\u003c/p\u003e\n\u003ch3 style=\"font-weight: 500;\"\u003e\u003cstrong\u003eSmart touch control (Hai tai nghe hoạt động độc lập)\u003c/strong\u003e\u003c/h3\u003e\n\u003cp style=\"font-weight: 400;\"\u003eĐiều khiển cảm ứng thông minh, mọi thao tác điều khiển chỉ với 1 chạm. Có thể sử dụng chỉ một hoặc cả hai tai, cho phép hai người, mỗi người đeo một tai nghe duy nhất, trả lời các cuộc gọi điện thoại cùng một lúc và chia sẻ âm nhạc với nhau\u003c/p\u003e\n\u003cp style=\"font-weight: 400;\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/39/56/dc/a98aad97497869d7a38fd117f3f6387c.png\" width=\"750\" height=\"533\" /\u003e\u003c/p\u003e\n\u003cul style=\"font-weight: 400;\"\u003e\n\u003cli\u003eChạm 3 lần để kết nối Siri/Google Assistant\u003c/li\u003e\n\u003cli\u003eChạm 2 lần để trả lời cuộc gọi\u003c/li\u003e\n\u003cli\u003eChạm 1 lần để dừng/tiếp tục nghe nhac\u003c/li\u003e\n\u003cli\u003eGiữ tai nghe bên trái để trở về bài hát trước\u003c/li\u003e\n\u003cli\u003eGiữ tai nghe bên phải để sang bài hát tiếp theo\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3 style=\"font-weight: 500;\"\u003e\u003cstrong\u003eNhiều hơn là một chiếc tai nghe, UB2609 Tích hợp sạc dự phòng\u003c/strong\u003e\u003c/h3\u003e\n\u003cp style=\"font-weight: 400;\"\u003eBộ sạc có dung lượng 2600mAh, có thể sử dụng như pin dự phòng để sạc cho điện thoại của bạn với đầu ra là 5V/ 1A. Mọi cuộc gọi nguy cấp hay cần tra cứu dữ liệu khi điện thoại chợt hết pin, Pin dự phòng trên hộp tai nghe sẽ cứu nguy cho bạn ngay tích tắc.\u003c/p\u003e\n\u003cp style=\"font-weight: 400;\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/ab/a3/be/f03cfa61e7155ddb4e59d1078cc64de2.png\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"font-weight: 400;\"\u003e\u003cstrong\u003eLựa chọn Tai nghe True Wireless Energizer UB2609\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"font-weight: 400;\"\u003eThương hiệu Mỹ hàng chính hãng 100%\u003c/p\u003e\n\u003cp style=\"font-weight: 400;\"\u003eChuẩn an toàn Âu Mỹ - Bảo hiểm cháy nổ toàn cầu\u003c/p\u003e\n\u003cp style=\"font-weight: 400;\"\u003eBảo hành 01 năm, 1 đổi 1\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/7b/49/e0/2eded112a9591a68d3fe057d987294c3.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/7b/49/e0/2eded112a9591a68d3fe057d987294c3.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/7b/49/e0/2eded112a9591a68d3fe057d987294c3.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7b/49/e0/2eded112a9591a68d3fe057d987294c3.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7b/49/e0/2eded112a9591a68d3fe057d987294c3.png"},{"base_url":"https://salt.tikicdn.com/ts/product/a9/59/f6/d3cbdf9b00bbdce79d060ee2bca9141b.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a9/59/f6/d3cbdf9b00bbdce79d060ee2bca9141b.png","medium_url":"ht