ext":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"defective_product"}},"discount":1510000,"discount_rate":31,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/10/2e/5f/7079916dd448549306d687c8badb604f.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":722,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eNhóm nước hoa: Hương hoa cỏ\u003c/p\u003e\n\u003cp\u003eGiới tính: Nữ\u003c/p\u003e\n\u003cp\u003eNăm ra mắt: 2020\u003c/p\u003e\n\u003cp\u003eNồng độ: EDP\u003c/p\u003e\n\u003cp\u003eĐộ lưu hương: Lâu – 7 giờ đến 12 giờ\u003c/p\u003e\n\u003cp\u003eĐộ toả hương: Vừa phải\u003c/p\u003e\n\u003cp\u003ePhong Cách: Nhẹ Nhàng, Tinh Tế, Nữ Tính\u003c/p\u003e\n\u003cp\u003eHương đầu: Hoa nhài Sambac, Rangoon Creeper\u003c/p\u003e\n\u003cp\u003eHương giữa: Ylang-Ylang, Hoa huệ, Hoa nhài\u003c/p\u003e\n\u003cp\u003eHương cuối: Hương mặt trời, Xạ hương, Gỗ đàn hương, Benzoin, Hương gỗ, Orris\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eDòng nước hoa nổi tiếng của GUCCI BLOOM, bắt đầu với dòng nước hoa Gucci Bloom đầu tiên vào năm 2017 lại một lần nữa khuấy động không khí mùa Hè trong năm 2020 với mùi hương GUCCI BLOOM PROFUMO DI FIORI. “Gương mặt mới” trong địa đàng Gucci Bloom mê hoặc khứu giác bởi hương thơm nhiệt đới ấm áp và cảm hứng đầy kích thích từ hoa ylang-ylang pha trộn với những bông hoa trắng say đắm và hợp âm vốn đã nổi tiếng được tìm thấy trong tất cả các loại nước hoa Gucci Bloom: rangoon creeper, còn được gọi là osmanthus Trung Quốc (Combretum indicum), cây nho đỏ cụm hoa và có nguồn gốc từ vùng nhiệt đới châu Á.\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"aligncenter wp-image-39608\" title=\"Gucci Bloom Profumo Di Fiori 1 - N - Nước hoa cao cấp, chính hãng giá tốt, mẫu mới\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/cb/ed/44/55483d83d31553450c3a025bda472b62.jpg\" alt=\"Gucci Bloom Profumo Di Fiori 3 - N - Nước hoa cao cấp, chính hãng giá tốt, mẫu mới\" width=\"400\" height=\"529\" /\u003e\u003c/p\u003e\n\u003cp\u003eGucci Bloom Profumo Di Fiori là mùi hương dành cho những nàng thơ thích sự cổ điển. Nhưng đằng sau đó vẫn chứa đựng nét hiện đại đầy cá tính và không kém phần nữ tính, dễ thương. Không chỉ đơn thuần là một mùi hương. Profumo Di Fiori còn thay nàng nói lên cá tính của bản thân mình mà không cần dùng đến bất cứ ngôn từ nào. Hương thơm mới lạ, khác biệt này sẽ giúp nàng để lại ấn tượng sâu sắc trong tâm trí đối phương ngay từ lần gặp đầu tiên.\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"aligncenter wp-image-39609\" title=\"Gucci Bloom Profumo Di Fiori 2 - N - Nước hoa cao cấp, chính hãng giá tốt, mẫu mới\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/e6/ac/6b/e2d789ebab0e6dda44d9d15eae471f37.jpg\" alt=\"Gucci Bloom Profumo Di Fiori 2 - N - Nước hoa cao cấp, chính hãng giá tốt, mẫu mới\" width=\"500\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp\u003eĐể diễn giải sự trẻ trung trong mùi hương, Gucci đã trao cho Bloom Profumo Di Fiori chai nước hoa màu vàng. Sắc vàng của mật ong, ngọt ngào mà ấm áp.\u003c/p\u003e\n\u003cp\u003eAlberto Morillas, Chuyên gia nước hoa bậc thầy, người ký hợp đồng với toàn bộ dòng Gucci Bloom, lần này đã chọn một “liên minh hoa” của ylang-ylang, hoa huệ và dây leo rangoon để tạo ra một hương thơm tinh vi, kỳ lạ được hỗ trợ bởi rừng cây thấm đẫm những tia nắng lấp lánh, tinh anh và rạng rỡ, sự khéo léo của orris cùng nhựa benzoin ấm và sắc thái mềm mại. Jasmine Sambac nhấn mạnh màu trắng của bó hoa và tăng cường hiệu ứng mặt trời của thành phần cùng với những nụ hoa nhài tinh tế.\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"aligncenter wp-image-39610\" title=\"Gucci Bloom Profumo Di Fiori 3 - N - Nước hoa cao cấp, chính hãng giá tốt, mẫu mới\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/0a/e3/ab/735664c909a30f2adeb7927d2613fb1a.jpg\" alt=\"Gucci Bloom Profumo Di Fiori 4 - N - Nước hoa cao cấp, chính hãng giá tốt, mẫu mới\" width=\"500\" height=\"510\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/10/2e/5f/7079916dd448549306d687c8badb604f.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/10/2e/5f/7079916dd448549306d687c8badb604f.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/10/2e/5f/7079916dd448549306d687c8badb604f.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/10/2e/5f/7079916dd448549306d687c8badb604f.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/10/2e/5f/7079916dd448549306d687c8badb604f.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/f1/ce/b0/9c7b23d9909e2ce4a3005efd5ee8938f.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f1/ce/b0/9c7b23d9909e2ce4a3005efd5ee8938f.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f1/ce/b0/9c7b23d9909e2ce4a3005efd5ee8938f.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/produc