0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/12/a5/02/4c23f03b6a6adbc4a0776d2ba7b467cd.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1555,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2 style=\"text-align: center;\"\u003e\u003cstrong\u003eMáy trợ giảng xách tay Sunrise SM 351\u003c/strong\u003e\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cp\u003eMáy trợ giảng Sunrise SM - 351 là loại máy trợ giảng không dây chất lượng tốt  thuận tiện cho người sử dụng. \u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eMáy hỗ trợ giảng dạy với 1 micro cầm tay không dây, micro cài đầu, micro cài áo trợ giảng sẽ giúp bạn thuận tiện hơn tùy theo nhu cầu để lựa chọn thích hợp\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/7d/8f/ea/ce11e79cb796ccc4889f4ba197d4bf76.jpg\" alt=\"\" width=\"750\" height=\"1201\" /\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cp\u003eMáy trợ giảng Sunrise SM - 351  là sản phẩm máy trợ giảng không dây chất lượng phù hợp giúp những giáo viên, giảng viên, hướng dẫn viên du lịch, nhân viên quảng bá sản phẩm   không bị tắt tiếng và mất hơi quá nhiều\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/73/ac/84/de97698c34ac58c53f6200a8b93d50f3.jfif\" alt=\"\" width=\"640\" height=\"640\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eĐặc điểm nối bậc máy trợ giảng không dây Sunrise SM-351\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cp\u003eMáy trợ giảng Sunrise SM - 351 nhỏ gọn có kích thước 180 x 300 x 110mm, trọng lượng 3.5 kg \u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eMicro hỗ trợ  giảng dạy  cho giáo viên với phần loa phát không dây hỗ trợ khay cắm thẻ nhớ USB, SSD thuận tiện \u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/51/01/c8/358ef0cfd5738aeadd8b43504790e7fb.jpg\" alt=\"\" width=\"500\" height=\"481\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTính năng tiện dụng của máy trợ giảng \u003c/strong\u003e\u003cstrong\u003eSunrise SM \u003c/strong\u003e\u003cstrong\u003e- \u003c/strong\u003e\u003cstrong\u003e351 \u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cp\u003eMáy trợ giảng công suất lớn có chức năng khuếch đại giọng nói tự nhiên và rất rõ ràng, không bị nhiễu hay rè. \u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eMáy trợ giảng công suất lớn đảm bảo khoảng cách thu phát của máy là 50m\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eMáy trợ giảng công suất 45W cho âm thanh mạnh mẽ. Công nghệ mới giúp tiếng hạn chế bị rè, nhiễu. \u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eMicro trợ giảng hoạt động ở tần số CH-A 180Mhz, kênh CH-B 260MHz. \u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eThiết bị dùng Acquy sạc điện trực tiếp giúp tiết kiệm và nâng cao thời gian sử dụng từ 6-8 tiếng.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eTần số 180-260 MHz\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eThiết bị hỗ trợ giảng dạy hỗ trợ cổng cắm USB, thẻ thớ SD, cassette, line in L-R \u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003ePhụ kiện gồm:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eMicro  cầm t