6ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":40000,"discount_rate":14,"rating_average":4.5,"review_count":85,"review_text":"(85)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/media/catalog/producttmp/77/b9/b2/90c613ac0273bcefbfb91aac80d094ce.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1959,"all_time_quantity_sold":508,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eLăn khử mùi giảm tiết mồ hôi Etiaxil Deodorant Anti-transpirant 48H 50ml\u003c/p\u003e\n\u003cp\u003eQuy cách đóng gói: 50ml/sản phẩm\u003c/p\u003e\n\u003cp\u003eThương hiệu: Etiaxil\u003c/p\u003e\n\u003cp\u003eXuất xứ: Pháp\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/4d/a0/3d/e9f462813c602f0d4c9e3ec9f0fa160f.jpg\" alt=\"\" width=\"750\" height=\"1000\" /\u003e\u003c/p\u003e\n\u003cp\u003eNếu Etiaxil Detranspirant Traitement Roll-On là vị cứu tinh giúp bạn chấm dứt bệnh “viêm cánh” cực kì hiệu quả chỉ trong thời gian ngắn với kết quả đáng kinh ngạc, thì Lăn Khử Mùi Etiaxil Deodorant Anti Transpirant 48h lại là người bạn đồng hành giúp hạn chế và kiểm soát tuyến mồ hôi dưới cánh tay cực kì hiệu quả.\u003c/p\u003e\n\u003cp\u003eDòng sản phẩm khử mùi Etiaxil đến từ hãng Cooper – Đan Mạch được đánh giá là dòng sản phẩm khử mùi tốt nhất hiện nay tại Pháp. Bên cạnh sản phẩm Lăn khử mùi  Etiaxil Treatment, lăn khử mùi Etiaxil Deodorant Anti-transpirant 48H cũng là sản phẩm rất được ưa chuộng đối với những người không tiết quá nhiều mồ hôi và muốn tìm kiếm sản phẩm lăn khử mùi hàng ngày hiệu quả.\u003c/p\u003e\n\u003cp\u003eĐiều gì khiến Cooper, hãng dược phẩm toàn cầu quyết định đầu tư vào 1 công ty nhỏ bé tại Đan Mạch chỉ để sản xuất… sản phẩm các sả phẩm khử mùi cơ thể? Có rất nhiều câu trả lời, nhưng lý do thực sự thì chỉ có 1 – đó chính là công ty nhỏ bé kia đã nắm giữ CÔNG THỨC sản xuất ra sản phẩm KHỬ MÙI TỐT NHẤT- Khử mùi ETIAXIL.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eLăn khử mùi Etiaxil Deodorant Anti-transpirant 48H có khả năng ngăn tiết mồ hôi và ngăn mùi lên đến 48h. Đồng thời sản phẩm ngăn chặn sự xuất hiện của các vết ố vàng trên quần áo. Phù hợp với da nhạy cảm.\u003c/p\u003e\n\u003cp\u003eSản phẩm chứa các thành phần kháng khuẩn, giúp ngăn chặn sự hình thành vi khuẩn cũng như kiểm soát lượng mồ hôi tiết ra ở vùng da dưới cánh tay, tạo cảm giác khô thoáng, dễ chịu.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eBên cạnh đó, các thành phần diệt khuẩn có trong Etiaxil Deodorant Anti Transpirant 48h sẽ giúp ngăn mùi hiệu quả suốt 48 giờ để bạn tự tin giao tiếp suốt cả ngày dài.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eSản phẩm khi lên da mang lại cảm giác khô thoáng, không bết dính, không gây ướt và vàng áo làm mất thẩm mỹ như những loại lăn khử mùi khác.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eĐặc biệt, dòng Lăn Khử Mùi Etiaxil Deodorant Anti Transpirant 48h này được thiết kế dành riêng cho các bạn có làn da nhạy cảm nhờ thành phần không chứa cồn, Paraben, không gây kích ứng da.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eCông thức đã được kiểm nghiệm da liễu, không chứa cồn và paraben.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/cd/92/6d/2b17333d90f4643ae8a0d0f0ef6a1af9.jpg\" alt=\"\" width=\"600\" height=\"602\" /\u003e\u003c/p\u003e\n\u003cp\u003eHƯỚNG DẪN SỬ DỤNG:\u003c/p\u003e\n\u003cp\u003e- Sử dụng vào hằng ngày vào buổi sáng sau khi làm sạch vùng da dưới cánh tay lăn trực tiếp sản phẩm lên da.\u003c/p\u003e\n\u003cp\u003e- Không sử dụng trên vùng da bị tổn thương.\u003c/p\u003e\n\u003cp\u003e– Có thể dùng sản phẩm ngay sau khi wax/cạo/nhổ lông.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/media/catalog/producttmp/77/b9/b2/90c613ac0273bcefbfb91aac80d094ce.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/producttmp/77/b9/b2/90c613ac0273bcefbfb91aac80d094ce.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/producttmp/77/b9/b2/90c613ac0273bcefbfb91aac80d094ce.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/producttmp/77/b9/b2/90c613ac0273bcefbfb91aac80d094ce.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/producttmp/77/b9/b2/90c613ac0273bcefbfb91aac80d094ce.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/cd/92/6d/febcc35414d9e7810bc25784f64df5ca.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/cd/92/6d/febcc35414d9e7810bc25784f64df5ca.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/cd/92/6d/febcc35414d9e7810bc25784f64df5ca.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/cd/92/6d/febcc35414d9e7810bc25784f64df5ca.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/cd/92/6d/febcc35414d9e7810bc25784f64df5ca.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/b1/77/f2/424fefcd5dc65ca932635d40d8a883ab.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b1/77/f2/424fefcd5dc65ca932635d40d8a883a