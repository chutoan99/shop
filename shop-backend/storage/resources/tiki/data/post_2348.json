:null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":5000000,"discount_rate":5,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/48/2f/e9/0654a778a29297e2e309d69ca09528b3.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":463,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eSerta Pedic iBreeze là dòng sản phẩm nệm cao cấp tiêu biểu sở hữu sự phục hồi và cải thiện cơ bắp cho vận động viên, người có vấn đề về xương khớp tối ưu.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/48/2f/e9/a579d9b6bad3567b77153437495785f2.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch3\u003eLợi ích khi sử dụng nệm lò xo Serta Pedic iBreeze\u003c/h3\u003e\n\u003cp\u003e\u003cstrong\u003ePhục hồi sức khỏe đa vùng trong mọi tư thế\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eNệm lò xo Serta Pedic iBreeze cải thiện toàn diện các vùng cơ thể với hệ lò xo túi 7 vùng nâng đỡ. Nhờ đó, bề mặt nệm được tinh chỉnh theo đường cong cơ thể và hỗ trợ cột sống cân bằng và thoải mái nhất.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/61/b9/44/5594f7a48a341d208298d1447d499adc.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/8a/39/60/5de44cd139326b9ae7dd11cd0699dd52.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eLàm mát \u0026amp; cân bằng nhiệt độ\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eNệm iBreeze mang lại cảm giác mát lạnh ngay khi chạm vào nhờ vải Viscose lót len lông cừu. Vải Viscose là công nghệ độc quyền cho bề mặt nệm mềm mại, thoáng khí cao kết hợp cùng lông cừu có khả năng điều nhiệt độ cơ thể tốt, cho bề mặt nệm mát lạnh và tươi mới suốt đêm dài.\u003cbr /\u003eĐặc biệt, công nghệ làm mát ADCS gia tăng thoải mái giúp người nằm đi vào giai đoạn ngủ sâu nhanh hơn và kéo dài thời gian ngủ sâu lâu hơn.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/41/8e/6a/89e58401645c540ea987440b5888e35c.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eKhô thoáng thoải mái\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eiBreeze là dòng nệm lò xo chống ẩm mốc tuyệt vời phù hợp với khí hậu nhiệt đới của Việt Nam. Vải Viscose hấp thụ độ ẩm, kết hợp cùng lông cừu có khả năng hạn chế sự sinh sôi của vi khuẩn nấm mốc, cho tổng thể nệm luôn khô thoáng thoải mái.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eChống bụi khuẩn cao\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eBề mặt vải nệm Serta được xử lý qua lớp chống mạt bụi, nấm mốc và vi khuẩn, giữ cho nệm luôn sạch và an toàn với làn da, hạn chế các bệnh về hô hấp và dị ứng.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/22/7f/8f/9cf9891914a0bd53d8e8b5eb85d26449.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eGia tăng êm ái thư giãn\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eNệm Serta Pedic iBreeze êm ái tuyệt đỉnh nhờ lớp tính năng gia tăng thoải mái dày dặn. Không chỉ được tích hợp các lớp foam mà còn có cao su thiên nhiên mang đến độ đàn hồi cao, hỗ trợ nâng đỡ êm mà không lún.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/6e/72/65/fcb287d09949af8d59420e311eecbff5.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/e0/14/45/40f8b1fceea2cb6fafa2fdab932d2ed9.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/h3\u003e\n\u003ch3\u003eNệm lò xo Serta Pedic iBreeze được bảo hành chính hãng 10 năm\u003c/h3\u003e\n\u003ch3\u003eSerta - Biểu tượng cho giấc ngủ hoàn hảo và thoải mái nhất\u003c/h3\u003e\n\u003cp\u003eRa mắt từ năm 1931, Serta nhanh chóng trở thành thương hiệu tiên phong mang đến trải nghiệm thoải mái vượt trội nhất cho khách hàng khi giữ danh hiệu \"Thương hiệu nệm số 1 tại Mỹ\" trong 8 năm liên tiếp. Nệm Serta thường được sử dụng trong những khách sạn hàng đầu thế giới như Hilton Worldwide, Marriott International, Omni Hotels and R\u003c/p\u003e\n\u003ch3\u003eHướng dẫn sử dụng và bảo quản\u003c/h3\u003e\n\u003cp\u003e1. Luôn đặt sản phẩm trên bề mặt bằng phẳng ổn định, không lồi lõm hoặc bị cong để tránh gây biến dạng, hư hỏng.\u003cbr /\u003e2. Đặt sản phẩm ở nơi thoáng khí, tránh ánh nắng trực tiếp chiếu vào.\u003cbr /\u003e3. Nên dùng kèm ga/drap để giúp cho sản phẩm luôn sạch sẽ và thoáng mát.\u003cbr /\u003e4. Không đặt vật nặng lên sản phẩm trong thời gian dài, không dùng ngoại lực mạnh và tập trung tác động lên sản phẩm dưới mọi hình thức.\u003cbr /\u003e5. Tuyệt đối không được lôi kéo, đẩy, bẻ cong tấm sản phẩm, vì có thể làm rách áo sản phẩm, gây hư hỏng, xô lệch kết cấu của lõi sản phẩm.\u003cbr /\u003e6. Không được là (ủi) trên sản phẩm hoặc đặt vật nóng lên sản phẩm\u003cbr /\u003e7. Tránh đổ các loại hóa chất, dung môi, chất lỏng lên sản phẩm và để gần các thiết bị tỏa nhiệt.\u003cbr /\u003e8. Không được giặt và phơi sản phẩm dưới ánh nắng trực tiếp\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/48/2f/e9/0654a778a29