a giàu Vitamin E\u003c/p\u003e\n\u003cp\u003eMùi hương Hoa Anh Đào, Hoa hồng, Hoa Iris, Hoa lily, Hoa xuyên tuyết\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/4b/79/db/3b14835c5940bd800e5fb28233ec4fd0.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eKhối lượng 800g\u003c/p\u003e\n\u003cp\u003eSản xuất tại Việt Nam\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/1e/32/d3/675875e7c32d7f1d8cdce32551f67327.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/1e/32/d3/675875e7c32d7f1d8cdce32551f67327.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/1e/32/d3/675875e7c32d7f1d8cdce32551f67327.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1e/32/d3/675875e7c32d7f1d8cdce32551f67327.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1e/32/d3/675875e7c32d7f1d8cdce32551f67327.png"},{"base_url":"https://salt.tikicdn.com/ts/product/4b/79/db/652878eccd24f8642da235de92f4fa66.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/4b/79/db/652878eccd24f8642da235de92f4fa66.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/4b/79/db/652878eccd24f8642da235de92f4fa66.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4b/79/db/652878eccd24f8642da235de92f4fa66.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4b/79/db/652878eccd24f8642da235de92f4fa66.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/d4/7e/72/d0a59ed0e38451f067af8dc872a42103.jpg","is_gallery