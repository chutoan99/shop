ndex":0,"icon":null,"icon_width":0,"icon_height":0,"text_color":"#FFF0F1","background_color":"#D93843","href":null,"text":"9.9"},{"placement":"pdp_badge","code":"is_hero","type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":true,"return_reason":"any_reason"}},"discount":100000,"discount_rate":2,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/19/50/25/5146f5a2f8cc87537e352cd31c11284a.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":309,"all_time_quantity_sold":6,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eTÁI HIỆN ÂM THANH SÂN KHẤU VỚI CÔNG NGHỆ CHỐNG ỒN CHỦ ĐỘNG\u003c/p\u003e\n\u003cp\u003eGiới thiệu chất âm mạnh mẽ trong thiết kế hộp sạc gọn nhẹ. Motif II A.N.C. mang đến 30 giờ nghe nhạc, ở bất kỳ đâu bạn muốn. Với công nghệ chống ồn chủ động, bạn sẽ được tận hưởng âm nhạc trọn vẹn mà không bị làm phiền bởi tiếng ồn xung quanh như tiếng tàu điện, hay những con phố ồn ào. Bật chế độ xuyên âm khi đàm thoại để nghe rõ âm thanh bên ngoài. Motif II A.N.C. nay được cải tiến khi thêm một microphone và công nghệ Bluetooth LE hỗ trợ kết nối mạnh mẽ hơn bao giờ hết. Bạn cũng có thể tải Marshall app để cá nhân hóa trải nghiệm nghe nhạc. Với Motif II A.N.C., mọi cung đường luôn sẵn sàng chờ đón bạn.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eÂM THANH MARSHALL ĐẶC TRƯNG\u003c/p\u003e\n\u003cp\u003eĐừng bỏ âm nhạc lại phía sau. Hãy mang chất âm Marshall đặc trưng theo bạn mọi lúc, mọi nơi với Motif II A.N.C. Với thiết kế bỏ túi nhỏ gọn, thoải mái cùng chất âm mạnh mẽ đặc trưng từ Marshall, Motif II A.N.C. bạn có thể trải nghiệm chất âm chuẩn sân khấu dù ở bất cứ đâu. \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eLOẠI BỎ TIẾNG ỒN, KHUẾCH ĐẠI ÂM THANH\u003c/p\u003e\n\u003cp\u003eĐắm chìm trong âm thanh bạn yêu thích với tính năng chống ồn chủ động được cải tiến. Sử dụng app để khuếch đại âm thanh, thưởng thức âm nhạc trọn vẹn mà không bị gián đoạn.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eTHỜI LƯỢNG NGHE NHẠC ĐÁNG TIN CẬY\u003c/p\u003e\n\u003cp\u003eMotif II A.N.C. có thời gian nghe nhạc nhiều hơn 10 giờ so với thế hệ tiền nhiệm. Với tính năng chống ồn chủ động, Motif II A.N.C. mang lại 30 giờ nghe nhạc cùng hộp sạc và 6 giờ nghe nhạc trong một lần sạc. Chỉ cần đặt tai nghe vào hộp sạc khi bạn cần thêm thời lượng nghe nhạc.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eCẢI THIỆN KẾT NỐI VỚI CÔNG NGHỆ BLUETOOTH LE - TIẾT KIỆM NĂNG LƯỢNG\u003c/p\u003e\n\u003cp\u003eVới Motif II A.N.C., không gì có thể cản trở bạn và âm nhạc. Công nghệ Bluetooth LE tiết kiệm năng lượng luôn sẵn sàng đảm bảo kết nối tốt nhất để bạn không bỏ lỡ một nhịp nào. Công nghệ Bluetooth tối tân giúp mang lại chất lượng âm thanh tốt hơn, đồng thời tăng phạm vi phát trực tuyến và cải thiện đồng bộ hóa âm thanh, nhằm mang lại kết nối ổn định khi xem video. \u003c/p\u003e\n\u003cp\u003eTIẾP CẬN VỚI SỰ PHÁT TRIỂN BỀN VỮNG\u003c/p\u003e\n\u003cp\u003eMotif II A.N.C. được thiết kế với khả năng bảo vệ pin. Đồng thời, hộp sạc và tai nghe được chế tạo từ 70% nhựa tái chế sau khi sử dụng, giúp góp phần bảo vệ môi trường.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eSẠC PIN MỌI LÚC, MỌI NƠI\u003c/p\u003e\n\u003cp\u003eMotif II A.N.C. với nguồn năng lượng mạnh mẽ mang lại 6 giờ nghe nhạc không ngừng. Hộp sạc đầy pin sẽ mang lại cho bạn đến 30 giờ nghe nhạc trên chặng đường đi. Chuyển sang chế độ sạc nhanh trong 15 phút khi bạn đang vội và bạn sẽ có thêm đến 1 giờ nghe nhạc.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eTHÔNG SỐ KỸ THUẬT\u003c/p\u003e\n\u003cp\u003eDRIVERS: 6 mm, dynamic\u003c/p\u003e\n\u003cp\u003eDRIVER SENSITIVITY: 106±2 dB @ 1 mW (0.126Vrms) 1 KHz\u003c/p\u003e\n\u003cp\u003eTRỞ KHÁNG: 16 Ω\u003c/p\u003e\n\u003cp\u003eTẦN SỐ PHẢN HỒI: 20 Hz – 20 kHz\u003c/p\u003e\n\u003cp\u003eTRỌNG LƯỢNG HỘP SẠC: 47.1 g\u003c/p\u003e\n\u003cp\u003eTRỌNG LƯỢNG TAI NGHE: 4.312 g \u003c/p\u003e\n\u003cp\u003eTHỜI GIAN SẠC ĐẦY PIN: 1.5 giờ sạc với cổng sạc USB-C\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eSẢN PHẨM CHÍNH HÃNG - ASH VIỆT NAM PHÂN PHỐI (TEM TRÒN ASH 7 MÀU TRÊN HỘP SẢN PHẨM)\u003c/p\u003e\n\u003cp\u003eBẢO HÀNH 1 ĐỔI 1 TRONG VÒNG 1 NĂM (LỖI TỪ NHÀ SẢN XUẤT)\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/19/50/25/5146f5a2f8cc87537e352cd31c11284a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/19/50/25/5146f5a2f8cc87537e352cd31c11284a.jpg","medium_url":"https://salt.tikicdn.c