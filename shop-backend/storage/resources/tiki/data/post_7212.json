idth":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":36000,"discount_rate":20,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/25/ab/0e/09dc849711276a03a204f7ab336630a1.JPG","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":701,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eHiểu để kiểm soát bệnh tiểu đường và biến chứng\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eNếu bạn trả lời “có” cho bất kỳ câu hỏi nào dưới đây,  thì cuốn sách này là dành cho bạn!\u003c/span\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eBạn hay người thân của bạn bị tiền tiểu đường hoặc tiểu đường?\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eBạn có gặp khó khăn khi thực hiện một lối sống lành mạnh để kiểm soát bệnh tiểu đường?\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eBạn có cần những lời khuyên đơn giản và hữu ích về chế độ ăn?\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eBạn có muốn biết về những chiến lược giảm cân hiệu quả nhưng vẫn duy trì sức khỏe?\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eBạn có đang tìm kiếm những lời khuyên về ăn uống, du lịch, tập luyện và duy trì vóc dáng khi đang bị tiểu đường?\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eBạn có muốn biết cách ngăn ngừa và quản lý các biến chứng bệnh tiểu đường?\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eBạn có đang tìm kiếm thông tin về thuốc chữa tiểu đường/insulin và các chúng hoạt động trong cơ thể?\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cem\u003e\u003cspan style=\"font-weight:400;\"\u003eHiểu để kiểm soát bệnh tiểu đường và biến chứng \u003c/span\u003e\u003c/em\u003e\u003cspan style=\"font-weight:400;\"\u003ecủa bác sĩ \u003c/span\u003e\u003cem\u003e\u003cspan style=\"font-weight:400;\"\u003eNuzhat Chalisa\u003c/span\u003e\u003c/em\u003e\u003cspan style=\"font-weight:400;\"\u003e là một bản hướng dẫn hoàn chỉnh cho bất kỳ ai muốn tìm hiểu cách phòng ngừa bệnh tiểu đường, quản lý bệnh và các biến chứng. \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eSau khi đọc cuốn sách này, bạn sẽ hiểu rõ về những gì xảy ra khi bị tiểu đường, nó có liên quan đến bệnh tim và các cơ quan khác như thế nào, tại sao mọi người lại phát triển biến chứng tiểu đường. Không chỉ thế, cuốn sách còn đưa ra cho độc giả những lời khuyên về chế độ ăn và giảm cân, cũng như những loại thuốc sử dụng trong điều trị tiểu đường. \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eCuối cùng, bác sĩ Nuzhat Chalisa sẽ giúp bạn hình thành một kế hoạch toàn diện để quản lý, và có lẽ thậm chí là chữa lành, bệnh tiểu đường.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eCuốn sách được viết bằng ngôn ngữ đơn giản để bất kỳ ai cũng có thể hiểu được những vấn đề cơ bản của bệnh tiểu đường và tự tin hơn trong việc kiểm soát sức khỏe của bản thân.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eChắc chắn cuốn sách này sẽ là một người bạn đồng hành và người hướng dẫn bạn trong việc hiểu và quản lý bệnh tiểu đường, hoặc giúp đỡ một người thân đang phải vật lộn với căn bệnh tiểu đường.\u003c/span\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/25/ab/0e/09dc849711276a03a204f7ab336630a1.JPG","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/25/ab/0e/09dc849711276a03a204f7ab336630a1.JPG","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/25/ab/0e/09dc849711276a03a204f7ab336630a1.JPG","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/25/ab/0e/09dc849711276a03a204f7ab336630a1.JPG","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/25/ab/0e/09dc849711276a03a204f7ab336630a1.JPG"}],"warranty_policy":null,"current_seller":{"id":145814,"sku":"8123245706626","name":"Omega Plus Books","link":"https://tiki.vn/cua-hang/omega-plus-books","logo":"https://vcdn.tikicdn.com/ts/seller/8b/17/0b/9e986158bc230b4fd699f07095893546.jpg","price":143000,"product_id":"200616596","store_id":134535,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[{"id":295057,"name":"HỆ THỐNG NHÀ SÁCH ABC","link":"https://tiki.vn/cua-hang/he-thong-nha-sach-abc","logo":"98/3d/ff/cec0ba0eaa575634616ab4605fccbe6d.jpg","price":161000,"product_id":"205930215","store_id":282399},{"id":281062,"name":"Bamboo Books","link":"https://tiki.vn/cua-hang/bamboo-books","logo":"46/9a/b3/e4fbfd97e7607ea4d2ff8e9ad769121b.jpg","price":152150,"product_id":"20633025