tude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ad/fc/a7/6f44bb3b1901d0ce651102c13d2a1d7b.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2165,"all_time_quantity_sold":7,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eSẢN PHẨM ĐƯỢC NHẬP KHẨU CHÍNH HÃNG VÀ PHÂN PHỐI BỞI CÔNG TY CỔ PHẦN TẦM NHÌN\u003c/strong\u003e   \u003c/p\u003e\n\u003cp\u003eCưa tay mũi khoắm Gardena 08738-20 được làm bằng chất liệu nhựa cao cấp và hợp kim, dùng để cưa cành cây, khúc gỗ nhỏ.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://hqvcdn3.azureedge.net/qs_h=250\u0026amp;w=350\u0026amp;crop=0\u0026amp;ver=20220502T103038\u0026amp;hcsh=B09DBE154B4E25E05F0A3A9AE2802ABA/_$$_/media/aprimo/gardena/garden%20saws/photos/studio/ga610-05xxxx/ga610-0568.png\" alt=\"08738-20-S-001-43cm.eps\" width=\"350\" height=\"250\" /\u003eTay cầm thoải mái và tiện dụng của cưa cho phép bạn vận hành dễ dàng mà không lo trượt tay do phần cao su và phần nhô ra cuối tay cầm.\u003c/p\u003e\n\u003cp\u003eCưa có thể được sử dụng với tất cả cán đa năng thay đổi chiều dài của Gardena . Đối với công việc ở độ cao lớn,  bạn nên sử dụng tay cầm kéo dài Gardena.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://hqvcdn3.azureedge.net/qs_h=250\u0026amp;w=350\u0026amp;crop=0\u0026amp;ver=20220502T103307\u0026amp;hcsh=AB5C92BACC1C41931CD943B2CC72ED80/_$$_/media/aprimo/gardena/garden%20saws/photos/action/ga650-16xxxx/ga650-1620.jpeg\" alt=\"08738-20-L-013-47cm.tif\" width=\"350\" height=\"250\" /\u003e\u003c/p\u003e\n\u003cp\u003eĐầu lưỡi cưa có móc giật cành tiện lợi, lưỡi cưa sắc bén, phủ lớp mạ crom chống bám dính giúp cho việc cắt cành và gỗ tươi và khô đều thật dễ dàng, tùy thuộc vào nhu cầu của bạn.\u003c/p\u003e\n\u003cp\u003eTổng lưỡi cưa có chiều dài 340 mm, phần  lưỡi sử dụng là 300 mm, được cố định chắc chắn trong tay cầm, đảm bảo cưa nhẹ nhàng trong quá trình vận hành mà không phải dùng lực tay nhiều.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://hqvcdn3.azureedge.net/qs_h=250\u0026amp;w=350\u0026amp;crop=0\u0026amp;ver=20220502T103054\u0026amp;hcsh=0961444276D563F4529C7A18FC96859A/_$$_/media/aprimo/gardena/garden%20saws/photos/feature/ga620-01xxxx/ga620-0166.jpeg\" alt=\"08738-20-L-008-47cm.eps\" width=\"350\" height=\"250\" /\u003eCHỈ NHỮNG PHẦN MÀU CAM TRÊN SẢN PHẨM LÀ CÓ THỂ ĐIỀU CHỈNH DI CHUYỂN ĐƯỢC (XOAY/ẤN/VẶN/KÉO).\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTHÔNG TIN THƯƠNG HIỆU \u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eGARDENA là Thương hiệu dẫn đầu thế giới với hơn 60 năm kinh nghiệm trong lĩnh vực sản xuất dụng cụ và thiết bị chăm sóc sân vườn tại Châu Âu, được thành lập năm 1961 tại Đức bởi Werner Kress và Eberhard Kastner. Sản phẩm Gardena đã có mặt tại hơn 80 quốc gia thông qua các Nhà Nhập khẩu và Phân phối. Kể từ năm 2006, Gardena thuộc quyền sở hữu của Tập đoàn Husqvarna AB Thụy Điển. Gardena đã trở thành Thương hiệu ưa thích của hàng triệu chủ sở hữu nhà và vườn trên toàn thế giới bởi các sản phẩm đa dạng cùng chất lượng tuyệt vời.\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng)....