heo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/b5/d5/69/b2d938986c0dcf767d64ebc24fc8d755.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b5/d5/69/b2d938986c0dcf767d64ebc24fc8d755.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b5/d5/69/b2d938986c0dcf767d64ebc24fc8d755.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b5/d5/69/b2d938986c0dcf767d64ebc24fc8d755.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b5/d5/69/b2d938986c0dcf767d64ebc24fc8d755.jpg"},{"base_url":"https://salt.tikicdn.com/media/catalog/product/t/s/tstt_2.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/t/s/tstt_2.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/t/s/tstt_2.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/t/s/tstt_2.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/t/s/tstt_2.jpg"},{"base_url":"https://salt.tikicdn.com/media/catalog/product/t/s/tstt-b1.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/t/s/tstt-b1.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/t/s/tstt-b1.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/t/s/tstt-b1.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/t/s/tstt-b1.jpg"}],"warranty_policy":null,"authors":[{"id":14441,"name":"Đường Thất Công Tử","slug":"duong-that-cong-tu"}],"current_seller":{"id":10039,"sku":"9387605281975","name"