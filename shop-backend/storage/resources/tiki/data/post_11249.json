ài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/4b/98/9c/2e81ce9b9622526ecd92d3386c29ee37.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/4b/98/9c/2e81ce9b9622526ecd92d3386c29ee37.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/4b/98/9c/2e81ce9b9622526ecd92d3386c29ee37.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4b/98/9c/2e81ce9b9622526ecd92d3386c29ee37.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4b/98/9c/2e81ce9b9622526ecd92d3386c29ee37.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/29/50/b0/182b5bb4e5f5a1b26f5e3e45422f54dc.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/29/50/b0/182b5bb4e5f5a1b26f5e3e45422f54dc.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/29/50/b0/182b5bb4e5f5a1b26f5e3e45422f54dc.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/29/50/b0/182b5bb4e5f5a1b26f5e3e45422f54dc.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/29/50/b0/182b5bb4e5f5a1b26f5e3e45422f54dc.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/98/6d/08/7c5398613023a859a6a7fe70801846af.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/98/6d/08/7c5398613023a859a6a7fe70801846af.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/98/6d/08/7c5398613023a859a6a7fe70801846af.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/98/6d/08/7c5398613023a859a6a7fe70801846af.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/98/6d/08/7c5398613023a859a6a7fe70801846af.png"},{"base_url":"https://salt.tikicdn.com/ts/product/f0/4d/df/38aad5816b7f77ddcf0d0d477f16d7d0.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f0/4d/d