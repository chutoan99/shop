ion":"\u003ctable width=\"100%\"\u003e\u003ctbody\u003e\u003ctr\u003e\u003ctd colspan=\"2\" width=\"100\"\u003e\u003cstrong\u003eThông số xe đạp trợ lực điện Fiido D4S\u003c/strong\u003e\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd width=\"188\"\u003eKhung xe\u003c/td\u003e\u003ctd width=\"392\"\u003eHợp kim nhôm\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd width=\"188\"\u003ePin\u003c/td\u003e\u003ctd width=\"392\"\u003eLithium 36V, 10.4Ah\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd width=\"188\"\u003eCảm biến\u003c/td\u003e\u003ctd width=\"392\"\u003eCảm biến tốc độ\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd width=\"188\"\u003eTốc độ\u003c/td\u003e\u003ctd width=\"392\"\u003e25km/giờ ( max 35km/giờ )\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd width=\"188\"\u003eHệ thống truyền động\u003c/td\u003e\u003ctd width=\"392\"\u003eShimano 6 tốc độ\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd width=\"188\"\u003eĐộng cơ\u003c/td\u003e\u003ctd width=\"392\"\u003eKhông chổi than 250w\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd width=\"188\"\u003eQuãng đường\u003c/td\u003e\u003ctd width=\"392\"\u003eSạc đầy đi được 80km\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd width=\"188\"\u003eHệ thống phanh\u003c/td\u003e\u003ctd width=\"392\"\u003ePhanh đĩa thủy lực trước và sau\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd width=\"188\"\u003eNguồn\u003c/td\u003e\u003ctd width=\"392\"\u003e100-240v\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd width=\"188\"\u003eLốp xe\u003c/td\u003e\u003ctd width=\"392\"\u003eCTS chống trượt 20*1,95inch\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd width=\"188\"\u003eTải trọng\u003c/td\u003e\u003ctd width=\"392\"\u003e120kg\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd width=\"188\"\u003eTrọng lượng\u003c/td\u003e\u003ctd width=\"392\"\u003e18kg\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd width=\"188\"\u003eKích thước\u003c/td\u003e\u003ctd width=\"392\"\u003e130x57x105cm\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd width=\"188\"\u003eKích thước gập\u003c/td\u003e\u003ctd width=\"392\"\u003e85x45x64cm\u003c/td\u003e\u003c/tr\u003e\u003c/tbody\u003e\u003c/table\u003e\u003ch4\u003eXe điện gấp gọn Fiido D4S – Mẫu Xe Đạp Trợ Lực Điện hàng đầu của Fiido E-Bike. Hiện đang được phân phối chính thức ở Việt Nam thông qua \u003c/h4\u003e\n\u003ch2\u003e\u003cstrong\u003eGiới Thiệu\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003eD4S là chiếc xe đạp trợ lực điện gấp gọn của Fiido E-bike. Một chiếc xe thể thao cỡ vừa với khung xe chắc chắn, thiết kế đẹp mắt, hiện đại. Với trọng lượng chỉ 18kg và có thể gấp gọn, Fiido D4S giúp cho việc cất vào cốp xe, mang lên xe buýt, tàu điện ngầm trở nên dễ dàng hơn bao giờ hết. Nhờ có Fiido D4S mà việc di chuyển trong phố hay những chuyến đi chơi xa của bạn trở nên vô cùng thú vị.\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"alignnone size-full wp-image-10726 lazy-load-active\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/36/b7/2a/769184a47a339721094e613133d3ae39.jpg\" alt=\"\" width=\"1011\" height=\"572\" /\u003e\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eThiết Kế \u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003eFiido D4S được thiết kế với kiểu dáng thể thao và bắt mắt. Nhờ tổng thể khung bằng hợp kim nhôm cao cấp nên trọng lượng của D4S \u003cstrong\u003echỉ 18,5 kg\u003c/strong\u003e Fiido đã lựa chọn loại Nhôm cho ngành hàng không để đảm bảo rằng thân xe sẽ không bị gỉ sét ngay cả khi đi mưa. Vì trọng lượng thấp nên việc mang những chiếc FIIDO D4S lên cầu thang hoặc lên xe buýt rất dễ dàng. Và đây là một trong những tính năng quan trọng, giá trị nhất của Xe Đạp Điện Gấp Gọn.\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"size-full wp-image-10740 aligncenter lazy-load-active\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/ce/b7/a3/d20e94563da1a08b3a1d4e3665e61536.jpg\" alt=\"\" width=\"1080\" height=\"1080\" /\u003e\u003c/p\u003e\n\u003cp\u003eMột ưu ái mà Fiido dành cho D4s chính là bộ mâm 20 inch thể thao, trái ngược với những người tiền nhiệm của nó như D3s, D2s và D1s. Với nước sơn bóng,cặp lốp to, Fiido D4s thật sự nổi bật giữa đám đông và không thể lẫn với bất kì chiếc xe nào.\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"alignnone size-full wp-image-10741 lazy-load-active\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/a6/6b/05/e7a6570cf561164c76ff0d5f891a04ea.jpg\" alt=\"\" width=\"1120\" height=\"840\" /\u003e\u003c/p\u003e\n\u003cp\u003eCũng giống như hầu hết những chiếc xe trợ lực điện khác của hãng, Fiido D4S được trang bị màn hình led hiển thị thông số rất đẹp và rõ ràng trên tay lái. Chỉ cần khởi động nguồn, các thông tin về tốc độ, chế độ lái, dung lượng …v đều được show hết ra trên mặt đồng hồ giúp người dùng dễ dàng nắm bắt được các thông số khi sử dụng.\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"alignnone size-full wp-image-10742 lazy-load-active\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/b3/2c/1e/c44d5cb52774a58807e756647b8a9a3c.jpg\" alt=\"\" width=\"1920\" height=\"1080\" /\u003e\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eĐộng Cơ 250W Và Pin Mạnh Mẽ\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003eĐược trang bị động cơ không chổi than 250W, tốc độ tối đa của FIIDO D4s có thể lên đến 3\u003cstrong\u003e5 km/h\u003c/strong\u003e . Tuy nhiên, việc giới hạn tốc độ tối đa chỉ ở 25km/h là quy định chung cho xe điện, xe máy điện ở nhiều quốc gia. Để có thể sử dụng được vận tốc tối đa của chiếc xe này, bạn sẽ phải Unlock đồng hồ để bỏ giới hạn tốc độ. Với hộp số 6 cấp Shimano và 3 chế độ điều chỉnh lái, người dùng sẽ có những trải nghiệm thú vị khi cầm lái chiếc Fiido D4s này.\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"alignnone size-full wp-image-10743 lazy-load-active\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/eb/62/af/b88fc5594c06c03ba87ea6b0cebf7437.jpg\" alt=\"\" width=\"1179\" height=\"1428\" /\u003e\u003c/p\u003e\n\u003cp\u003eVới việc đượng trang bị Pin 36V 10.4Ah, Fiido D4s cho quãng đường di chuyển tối đa lên đến 80km chỉ trong 1 lần sạc. Khi test D4s đầy Pin với chế độ chạy thuần điện, xe cho khả năng chạy đến 35km. Quả thật, với một chiếc xe thiên về di chuyển trong phố như D4s thì việc Pin 10.4Ah là quá đủ và đáp ứng đầy đủ nhu cầu của người sử dụng.\u003c/p\u003e\n\u003cp\u003eVới tất cả những lợi thế có sẵn, có thể thấy xe đạp trợ lực điện Fiido D4s là chiếc xe đáng tiền và phù hợp với nhiều nhu cầu sử dụng khác nhau.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/35/d9/8f/360e65dc55969aab11e1924e9112043e.jpeg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/35/d9/8f/360e65dc55969aab11e1924e9112043e.jpeg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/35/d9/8f/360e65dc55969aab11e1924e9112043e.jpeg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/35/d9/8f/360e65dc55969aab11e1924e9112043e.jpeg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/35/d9/8f/360e65dc55969aab11e1924e9112043e.jpeg"},{"base_url":"https://salt.tikicdn.com/ts/product/8c/3f/a7/ed3ba4444e4c3f9112adce45b99b3e9e.jpeg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/8c/3f/a7/ed3ba4444e4c3f9112adce45b99b3e9e.jpeg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/8c/3f/a7/ed3ba4444e4c3f9112adce45b99b3e9e.jpeg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8c/3f/a7/ed3ba4444e4c3f9112adce45b99b3e9e.jpeg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8c/3f/a7/ed3ba4444e4c3f9112adce45b99b3e9e.jpeg"},{"base_u