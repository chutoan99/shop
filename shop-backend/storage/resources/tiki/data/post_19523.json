8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/92/28/1e/81423084f17b6732b8d5a1731be8e44f.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1194,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eẤm siêu tốc thủy tinh SUNHOUSE SHD1215B\u003c/strong\u003e có thiết kế vô cùng sang trọng, tinh tế với thân bình trong suốt đặc biệt. Khe chống cặn thông minh giúp an toàn sử dụng, dung tích đến 1.8L cung cấp đủ nước sôi để cả nhà nấu mì, pha trà, cà phê, pha sữa… mọi lúc mọi nơi.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eKIỂU DÁNG HIỆN ĐẠI, TINH TẾ, TRANG NHÃ\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003eThân ấm làm bằng thủy tinh cao cấp trong suốt\u003c/strong\u003e\u003cbr /\u003e\u003cstrong\u003eẤm siêu tốc SUNHOUSE SHD1215B\u003c/strong\u003e có kiểu dáng đẹp, sang trọng. Thân ấm bằng thủy tinh chịu nhiệt trong suốt, màu sắc trung tính, tính thẩm mỹ cao, không bị oxi hóa nên rất an toàn cho sức khỏe và tiện lợi khi vệ sinh.\u003cbr /\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/c8/7d/bb/92754d2c338faf02859e9bd2678d54ed.jpg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/c8/7d/bb/92754d2c338faf02859e9bd2678d54ed.jpg\" alt=\"\" width=\"750\" height=\"502\" /\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/1b/06/15/29a8f00ece2e7fc3e3a91f93bf53e4cf.jpg\" alt=\"\" width=\"750\" height=\"502\" /\u003eĐế, nắp và tay cầm làm bằng nhựa cao cấp, chống nóng tốt. Ấm mang diện mạo hiện đại, đẹp mắt\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003eMiệng rót tích hợp khe chống cặn\u003c/strong\u003e\u003cbr /\u003eVới khe chống cặn tích hợp ngay ở nắp ấm, khi bạn rót nước từ trong ấm siêu tốc thủy tinh SUNHOUSE SHD1215B ra bình/cốc, các loại cặn sẽ được ngăn lại. Đồng thời các loại côn trùng như muỗi, kiến, bọ… cũng sẽ không thể lọt vào ấm.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/2e/1c/44/21706a915d00eac92c296fa2c405be90.jpg\" alt=\"\" width=\"750\" height=\"502\" /\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003eĐèn LED tự động báo hiệu bật/tắt\u003c/strong\u003e\u003cbr /\u003eThiết kế đặc biệt với công tắc bật tích hợp đèn LED ở dưới đế ấm, cho biết quá trình hoạt động của ấm. Khi bạn bật chế độ đun sôi, đèn sẽ sáng, cho biết ấm đang hoạt động. Khi nước đã được đun sôi, công tắc nhảy về vị trí tắt, đèn cũng sẽ tự động tắt.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/3f/0a/d3/f28b7107feb872cebd2a3ea514c933dd.jpg\" alt=\"\" width=\"750\" height=\"502\" /\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003eThân ấm xoay 360 độ linh hoạt trên đế tiếp điện\u003c/strong\u003e\u003cbr /\u003eĐế tiếp điện được thiết kế tách rời khỏi thân ấm, giúp việc đổ nước – tiếp nước dễ dàng, linh hoạt. Ấm có thể xoay 360 độ trên đế tiếp điện, người dùng có thể đặt ấm lên hay nhấc ấm ra khỏi đế ở bất cứ góc nào mà không phải lo lắng đến vấn đề phải đặt sao cho khớp.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eĐUN SÔI NHANH – AN TOÀN TUYỆT ĐỐI\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003eĐun sôi nhanh chóng \u0026amp; Tiết kiệm điện năng\u003c/strong\u003e\u003cbr /\u003eCông suất mạnh 1800W cho thời gian nấu nước nhanh chóng, chỉ trong 3 – 5 phút là bạn đã có nước sôi để pha chè, café, nấu mì… hay để nguội. Việc đun sôi nhanh cũng giúp tiết kiệm thời gian và điện năng tối đa.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/f2/a4/29/5870e55a61c01ac65e97a0fab9b15d64.jpg\" alt=\"\" width=\"750\" height=\"502\" /\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003eChế độ tự động tắt khi nước sôi hoặc cạn nước\u003c/strong\u003e\u003cbr /\u003eẤm có chế độ ngắt tự động khi nước sôi hoặc cạn nước, đảm bảo an toàn tối đa cho người sử dụng (quên/bận rộn công việc khác). Chức năng này còn giúp làm tăng tuổi thọ sản phẩm và phòng chống cháy nổ. Ấm sẽ không tự động khởi động lại nếu nước sôi trong ấm nguội đi.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/4e/01/5a/79d2c163219f973ba53555185510e6f1.jpg\" alt=\"\" width=\"750\" height=\"502\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/92/28/1e/81423084f17b6732b8d5a1731be8e44f.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/produc