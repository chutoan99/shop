71483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":79,"review_text":"(79)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/e6/30/73/976017abcc3d533d20dc78c165f27eaa.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1276,"all_time_quantity_sold":456,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<h1 class=\"product_title entry-title\" style=\"text-align:center;\">Nước muối biển sâu Nano Ocean Gold</h1>\n<p><img style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/1a/b2/89/46451ebef3a30950425884517c073cfa.jpg\" alt=\"\" width=\"512\" height=\"512\" /></p>\n<div class=\"flex between-xs middle-xs price-review\">\n<p class=\"price\">Nano Ocean Gold với ứng dụng công nghệ Nano khi kết hợp Nano bạc và tinh dầu thiên nhiên vào dụng dịch nước biển sâu, nhằm tăng tác dụng kháng khuẩn, chống viêm mũi, viêm xoang, giúp bảo vệ niêm mạc mũi tốt hơn,….</p>\n</div>\n<div class=\"woocommerce-product-details__short-description\">\n<h3>Thành phần</h3>\n<p>Muối, Nano bạc, tinh dầu khuynh diệp, nước tinh khiết</p>\n<h3>Đối tượng sử dụng</h3>\n<p>Dùng cho trẻ từ 7 tuổi trở lên và người lớn bị: viêm mũi, sổ mũi, nghẹt mũi</p>\n<p>Dùng để rửa sạch và giữ ẩm mũi khi thời tiết thay đổi, không khí khô lạnh</p>\n<h3>Công dụng</h3>\n<p>– Làm sạch và thông mũi</p>\n<p>– Phục hồi độ ẩm tự nhiên cho mũi, tạo cảm giác sảng khoái, thoải mái hít thở</p>\n<p>– Tái tạo các tế bào niêm mạc mũi bị tổn thương</p>\n<p>– Ngăn ngừa viêm mũi, nghẹt mũi, sổ mũi</p>\n<p>– Phòng tránh và hỗ trợ điều trị các bệnh viêm đường hô hấp cấp và mãn tính</p>\n<h3>Hướng dẫn sử dụng</h3>\n<p>Mở nắp bảo vệ, đặt ngón trỏ lên đầu vòi phun đưa nhẹ nhàng vòi phun vào mũi ấn nhanh đầu phun từ 2-3 lần mỗi bên mũi.</p>\n<p>Lau sạch, khô vòi phun, đậy nắp bảo vệ</p>\n<h3>Cách dùng</h3>\n<p>Xịt 4-5 lần/ ngày vài 2 lỗ mũi, mỗi lần ấn đầu xịt 2-3 lần/ 1 lỗ mũi</p>\n<h3>Chống chỉ định</h3>\n<p>Người quá mẫn cảm với bất kì thành phần nào của sản phẩm</p>\n<h3>Bảo quản</h3>\n<p>Tránh nhiệt độ cao, ánh nắng trực tiếp. Đóng nắp sau khi sử dụng.</p>\n<h3>Thông tin thêm</h3>\n<p><strong>Khối lượng tịnh:</strong> 70 ml</p>\n</div><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/e6/30/73/976017abcc3d533d20dc78c165f27eaa.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e6/30/73/976017abcc3d533d20dc78c165f27eaa.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e6/30/73/976017abcc3d533d20dc78c165f27eaa.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e6/30/73/976017abcc3d533d20dc78c165f27eaa.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e6/30/73/976017abcc3d533d20dc78c165f27eaa.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/71/2d/c6/9b6fe491608e49a1c599d6551e583759.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/71/2d/c6/9b6fe491608e49a1c599d6551e583759.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/71/2d/c6/9b6fe491608e49a1c599d6551e583759.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x2