f":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":15000,"discount_rate":12,"rating_average":4.6,"review_count":129,"review_text":"(129)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/media/catalog/product/8/8/8823.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":0,"all_time_quantity_sold":442,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: medium; color: #008ab7;\"\u003e\u003cstrong\u003eSáp Dầu Pentel 50 Màu - PHN-50\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eSáp Dầu Pentel 50 Màu - PHN-50\u003c/strong\u003e là dòng sản phẩm màu vẽ thuộc thương hiệu Pentel uy tín. Đây là một trong những loại màu vẽ lý tưởng với 50 tone màu chuẩn, tự nhiên và tươi sáng. Được làm từ nguyên liệu cao cấp nên sáp dầu Pentel cho độ bám giấy và độ phủ màu cao, màu ra đều, mịn, chân thực và sinh động. Độ nhấn chồng màu cực tốt trở thành một trong những ưu điểm nổi trội, khiến sản phẩm trở thành loại màu vẽ dùng để sáng tạo nên những tác phẩm nghệ thuật tuyệt vời.\u003c/p\u003e\r\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"http://tikicdn.com/media/catalog/product/8/8/8824.jpg\" alt=\"\" width=\"800\" height=\"800\" /\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eThông tin sản phẩm\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eSắc màu chuẩn, sinh động, tươi sáng\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eBút sáp dầu Pentel được làm từ nguyên liệu cao cấp, cho màu sắc chuẩn, tự nhiên, tươi sáng như thật, có độ bám giấy và độ phủ màu tốt. Khi tô vẽ lên mặt giấy, màu đều, mịn và bóng.\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eĐặc biệt, độ nhấn chồng màu tốt cho khả năng phối trộn những màu sắc mới rất sinh động, trở thành một trong những ưu điểm nổi bật nhất của sản phẩm.\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eBút sáp dầu tiện dụng\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eBút màu dạng sáp mang lại sự tiện dụng cho người vẽ vì không cần gọt, không cần pha màu như khi sử dụng bút chì hoặc màu nước. Ruột sáp mềm, ít gãy vụn, ít tạo màu thừa, dễ dàng rửa sạch khi dính lên tay hay quần áo.\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eBút được đựng trong hộp có chia ngăn, giúp người dùng cất bút gọn gàng sau khi sử dụng, tránh tình trạng thất lạc.\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eChất liệu an toàn\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eLớp màng bọc được cố định chắc chắc xung quanh thân bút vừa giúp người vẽ giữ cho tay luôn sạch sẽ vừa tạo sự thoải mái tối đa khi cầm bút.\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eSản phẩm được thiết kế với chất liệu và màu sắc không chứa chất độc hại, đảm bảo an toàn cho sức khỏe.\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eThương hiệu uy tín\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eTrong gần 70 năm kể từ khi thành lập, Pentel luôn là thương hiệu Nhật Bản cực kỳ uy tín, cung cấp các công cụ văn phòng phẩm có chất lượng cao nhất trên toàn thế giới.\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003ePentel là công ty sản xuất công cụ viết duy nhất nhận được giải thưởng Deming cho các sản phẩm chất lượng cao của mình.\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eThông tin khác\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e- Sản xuất tại Thái Lan.\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e- Hộp: 50 cây.\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e- Màu sắc: 50 màu.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e\u003cp\u003eSản phẩm này là tài sản cá nhân được bán bởi Nhà Bán Hàng Cá Nhân và không thuộc đối tượng phải chịu thuế GTGT. Do đó hoá đơn VAT không được cung cấp trong trường hợp này.\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/media/catalog/product/8/8/8823.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/8/8/8823.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/8/8/8823.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/8/8/8823.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/8/8/8823.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/d5/b8/b3/f2b78a9a62bbf0ffb05febe4d1583c46.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d5/b8/b3/f2b78a9a62bbf0ffb05febe4d1583c46.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d5/b8/b3/f2b78a9a62bbf0ffb05febe4d1583c46.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d5/b8/b3/f2b78a9a62bbf0ffb05febe4d1583c46.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d5/b8/b3/f2b78a9a62bbf0ffb05febe4d1583c46.jpg"},{"base_url":"https://salt.tikicd