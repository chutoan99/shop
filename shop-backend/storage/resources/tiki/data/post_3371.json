ull,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":21000,"discount_rate":2,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/73/a1/77/b668f4cd1ad47c0710b25c6857ebe039.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":68,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eKhông chỉ là một máy làm sữa hạt - Gume sẽ giúp bạn thỏa sức sáng tạo với “Hạt mà bạn thích, sữa mà bạn tạo!” \u003cbr /\u003eModel: MSB - 02            \u003cbr /\u003eMàu sắc: Màu sữa      \u003cbr /\u003eDung tích: 1200ml      \u003cbr /\u003eĐiện áp : 220V - 50Hz      \u003cbr /\u003eCông suất nấu: 800W, Công suất xay: 250W            \u003cbr /\u003eChức năng: Nấu sữa hạt, nấu cháo, nấu đồ ăn dặ      \u003cbr /\u003eTrọng lượng: 1,5kg            \u003cbr /\u003eKích thước sản phẩm: 635 x 415 x 615mm \u003c/p\u003e\n\u003cp\u003eBạn đã bao giờ nghe về lợi ích tuyệt vời của sữa hạt chưa?\u003cbr /\u003eKhông chỉ là một nguồn cung cấp protein giàu dinh dưỡng mà sữa hạt còn bổ sung hàng loạt các vitamin, khoáng chất và chất chống oxy hóa tự nhiên.\u003c/p\u003e\n\u003cp\u003eMáy làm sữa hạt đa năng Gume đúng với tên gọi của nó sẽ giúp bạn được trải nghiệm sữa dinh dưỡng vừa tươi ngon, giàu dinh dưỡng và đơn giản, dễ làm. Đặc biệt, sữa hạt tự làm không chứa lactose sẽ thích hợp cho những người bị dị ứng hoặc không tiêu hóa lactose.\u003c/p\u003e\n\u003cp\u003e Việc bạn làm đó là chỉ cần chọn những loại hạt bạn thích, chứa những chất dinh dưỡng bạn muốn bổ sung, thêm hạt và nước vào máy, trong tích tắc bạn đã có ngay cốc sữa hạt thơm ngon bổ dưỡng ngay tại nhà.\u003c/p\u003e\n\u003cp\u003eVới máy làm sữa hạt đa năng của Gume, bạn có thể hoàn toàn yên tâm vì sữa hạt được tạo ra từ nguyên liệu tự nhiên, không chất bảo quản hay chất phụ gia hại sức khỏe.\u003c/p\u003e\n\u003cp\u003e Thay vì mua sữa hạt hàng ngày, việc tự làm sữa hạt tại nhà không chỉ giúp bạn tiết kiệm chi phí mà còn giúp bạn kiểm soát chất lượng và lượng sữa theo ý muốn.\u003c/p\u003e\n\u003cp\u003e Với sự sáng tạo không giới hạn của mình, hãy để máy làm sữa hạt đa năng Gume giúp bạn làm ra những loại sữa hạt độc đáo, bổ dưỡng và đa dạng theo sở thích của mình bạn nhé!\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/73/a1/77/514e096d7020eb6d31a6f594732b544d.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/73/a1/77/b668f4cd1ad47c0710b25c6857ebe039.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/73/a1/77/b668f4cd1ad47c0710b25c6857ebe039.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/73/a1/77/b668f4cd1ad47c0710b25c6857ebe039.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/73/a1/77/b668f4cd1ad47c0710b25c6857ebe039.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/73/a1/77/b668f4cd1ad47c0710b25c6857ebe039.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/d7/db/00/8bc3b7b3136b71d03b13d945e3e22ed9.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d7/db/00/8bc3b7b3136b71d03b13d945e3e22ed9.jpg","medium_