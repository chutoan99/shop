on_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":115000,"discount_rate":26,"rating_average":4.8,"review_count":22,"review_text":"(22)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/3e/e6/21/804ca6ecf4bee6c89baa07388651aedf.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":611,"all_time_quantity_sold":113,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2\u003e\u003cstrong\u003eCốc sạc nhanh siêu nhỏ gọn Baseus Compact Quick Charger 30W(USB dual port +Type C,30w PD/QC3.0 Multi Quick Charge Support)\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003eBaseus compack quick charger là củ sạc mini đa năng mới nhất vừa được Baseus giới thiệu . Sản phẩm sở hữu những ưu điểm vượt trội so với các thế hệ củ sạc truyền thống trên thị trường như : kích thước vô cùng nhỏ gọn nhưng lại có hiệu suất chuyển đổi cao, ổn định trong nhiều điều kiện nhiệt độ khác nhau, nhiệt lương toả ra thấp, hiệu suất cao, hỗ trợ nhiều chuẩn sạc nhanh phổ thông PD/QC\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eTính năng cơ bản Cốc sạc nhanh siêu nhỏ gọn Baseus Compact Quick Charger 30W\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003e- Sản phẩm được trang bị chip quản lý nguồn thế hệ mới giúp cải thiện đáng kể hiệu suất chuyển đổi và kiểm soát nhiệt lượng tốt hơn . Bộ sạc Baseus Compact Quick Charger hỗ trợ đồng thời các chuẩn sạc nhanh Power delivery và Quick charge 3.0 với công suất lên đến 30W. Khả năng tự động nhận diện và điều chỉnh cấu hình điện áp sạc ngỏ ra tối ưu cho từng thiết bị. Tương thích với hầu hết các thiệt bị số hiện nay . Cơ chế bảo vệ thông minh, bảo đảm an toàn tuyệt đối cho thiết bị và người sử dụng .\u003c/p\u003e\n\u003cp\u003e- Sản phẩm hỗ trợ chuẩn sạc nhanh PD 30W chuyên dùng cho iPho 12 Series/ iPd 2020 và chuẩn sạc nhanh 18W khi sử dụng với cáp sạc Type C to IP trên các dòng iPhone 11/ iP X/XS Max/ iphon 8. Ngoài ra bộ sạc naỳ củng hỗ trợ giao thức sạc nhanh QC 3.0 trên các dòng Smartphone Android và kể cả các thiết bị cũ hơn . \u003c/p\u003e\n\u003cp\u003e- Kích thước nhỏ gọn, trọng lương nhẹ , kiểu dáng thiết kế sang trọng, đẹp mắt.\u003c/p\u003e\n\u003cp\u003eHình ảnh chi tiết cốc sạc nhanh siêu nhỏ gọn Baseus Compact Quick Charger 30w\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eHình ảnh sản phẩm\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003e\u003cimg class=\"lazy loaded\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/0b/58/c2/322cc6c08c04aa3c1f17a95a50ed052b.jpg\" alt=\"\" /\u003e\u003cimg class=\"lazy loaded\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/ba/d5/82/64c451ba35438930c6ed4231698382d5.jpg\" alt=\"\" /\u003e\u003cimg class=\"lazy loaded\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/32/6e/9c/ce4a9f2983975491a7f93398db93f74b.jpg\" alt=\"\" /\u003e\u003cimg class=\"lazy loaded\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/df/4b/c1/9674894d0c09ef8486edcbb645c34bb2.jpg\" alt=\"\" /\u003e\u003cimg class=\"lazy loaded\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/74/c5/0a/fa18203fea4b3e91a857e9dc00fd3f33.jpg\" alt=\"\" /\u003e\u003cimg class=\"lazy loaded\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/6f/69/97/21a25ea2c537983247dd52d40baa385d.jpg\" alt=\"\" /\u003e\u003cimg class=\"lazy loaded\" src=\"https://salt