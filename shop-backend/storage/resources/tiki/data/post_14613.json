,"icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.8,"review_count":5,"review_text":"(5)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/73/33/02/d70365fd625e3a23c8a3d85aba818809.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1520,"all_time_quantity_sold":11,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cspan class=\"text\"\u003eTrông giữ em bé trong độ tuổi sơ sinh và trẻ nhỏ là 1 công việc tương đối mệt nhọc với các bậc làm cha mẹ. Ngày nay có rất nhiều thiết bị, sản phẩm hỗ trợ cho việc này. “ Nhà banh kiêm chức năng làm cũi”, là 1 trong những trợ thủ đắc lực cho các bậc cha mẹ. Thị trường hiện nay, có rất nhiều loại sản phẩm dạng này. Tuy nhiên đa phần các sản phẩm này rất sơ xài, không đảm bảo chất lượng và độ an toàn cho bé, từ nguyên vật liệu cho đến kết cấu.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan class=\"text\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/9c/1a/5a/7d8ef9a698d940e050431715fe3de145.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan class=\"text\"\u003eSản phẩm: Nhà banh, kiêm làm cũi kết cấu chân gỗ cao cấp Prota vừa cho ra mắt thị trường, đã được thử nghiệm cho các bé sử dụng trong 1 thời gian dài. Đã tạo sự hài lòng rất cao ở các bậc cha mẹ. Với các nguyên vật liệu được chọn lọc kỹ lưỡng: \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan class=\"text\"\u003e- Vải sít cao cấp nhập khẩu. \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan class=\"text\"\u003e- Vải lưới thông thoáng, mát mẻ, rất mị \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan class=\"text\"\u003e- Inox chính hãng \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan class=\"text\"\u003e- Nguyên liệu gỗ xoài cao cấp, an toàn cho bé.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan class=\"text\"\u003e- “ Một không gian tuyệt vời cho bé yêu “, là cam kết của chúng tôi cho sản phẩm mới này. \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan class=\"text\"\u003e+ Kiểu dáng hiện đại, sang trọng \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan class=\"text\"\u003e+ Chất liệu cao cấp : Gỗ, vải, lưới,  \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan class=\"text\"\u003e+ \u003c/span\u003e\u003cspan class=\" clickable \"\u003eKích thước sản phẩm\u003c/span\u003e\u003cspan class=\"text\"\u003e : 137 x 137 x 62cm\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan class=\"text\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/55/50/43/85932e3db0c6e0ba1a1d0730dd312e91.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan class=\"text\"\u003eBạn hãy so sánh nhà banh chân gỗ cao cấp Prota và các nhà banh trên thị trường (đa phần nhập từ Trung Quốc), các sản phẩm nhập về:\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan class=\"text\"\u003e - Được làm bằng vải bạt ( rất rẻ tiền), không mềm mại và mịn màng như vải sít cao cấp của nhà banh Prota. \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan class=\"text\"\u003e- Lưới rất cứng\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan class=\"text\"\u003e - Inox rất mỏng\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan class=\"text\"\u003e - Đa phần làm bằng khớp nhựa ( nhựa tái sinh), rất dể gãy và rất không an toàn cho bé.\u003c/span\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/73/33/02/d70365fd625e3a23c8a3d85aba818809.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/73/33/02/d70365fd625e3a23c8a3d85aba818809.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/73/33/02/d70365fd625e3a23c8a3d85aba818809.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/73/33/02/d70365fd625e3a23c8a3d85aba818809.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/73/33/02/d70365fd625e3a23c8a3d85aba818809.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/55/50/43/5befa8190be01b19a2d71b3ed52fd353.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/55/50/43/5befa8190be01b19a2d71b3ed52fd353.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/55/50/43/5befa8190be01b19a2d71b3ed52fd353.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/55/50/43/5befa8190be01b19a2d71b3ed52fd353.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/55/50/43/5befa8190be01b19a2d71b3ed52fd353.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/39/b1/b5/50008d674365bd5d6f2b1151aefc5e2f.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/39/b1/b5/50008d674365bd5d6f2b1151aefc5e2f.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/39/b1/b5/50008d674365bd5d6f2b1151aefc5e2f.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/39/b1/b5/50008d674365bd5d6f