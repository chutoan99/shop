und_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.6,"review_count":73,"review_text":"(73)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/3d/c0/83/54d4960e4a9def3b26e89ae5714339cd.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1560,"all_time_quantity_sold":240,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cul\u003e\n\u003cli\u003eKính Chắn Gió mũ bảo biểm, mũ bảo hộ, mũ thể thao dạng 3 khuy bấm được thiết kế với kiểu dáng thời trang, màu sắc hài hòa. Kính giúp đôi mắt bạn tránh khỏi gió bụi, tăng tầm quan sát tốt hơn trên mỗi cung đường.\u003c/li\u003e\n\u003cli\u003eKính có cả lưỡi trai đi kèm, phần lưỡi trai và kính liên kết với nhau bằng 2 trục xoay, nên kính có thể kéo lên kéo xuống dễ dàng trong khi phần lưỡi trai vẫn cố định khi gắn vào mũ.\u003c/li\u003e\n\u003cli\u003eThiết kết thông minh có thể gắn vừa hầu hết tất cả các mẫu nón 3/4 hay nửa đầu trên thị trường, miễn là mũ có 3 khuy bấm phía trên để bấm vào 3 khuy bấm của mũ.\u003c/li\u003e\n\u003cli\u003eCó tác dụng bảo vệ mặt và mắt khỏi gió, bụi bẩn, tia UV và các vật thể, côn trùng bay trên đường, hạn chế ánh sáng gắt.\u003c/li\u003e\n\u003cli\u003eKính có chất lượng rất tốt, nhìn trong và dễ chịu, không gây mỏi mắt, không bị mờ đục tự nhiên sau 1 thời gian sử dụng.\u003c/li\u003e\n\u003cli\u003eCó thể dễ dàng tháo ra cất đi khi không có nhu cầu sử dụng và lắp lại khi cần.\u003c/li\u003e\n\u003cli\u003eKính có 2 màu: Trong và trà để bạn lựa chọn tùy thuộc vào mục đích sử dụng của mỗi người.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"padding-left: 40px;\"\u003e+ Kính màu trà (râm nhẹ): Thích hợp để đi nắng, có tác dụng chống chói, chống tia uv, bảo vệ mắt dưới ánh nắng mặt trời. Độ trà nhẹ nên vẫn đi ban đêm được.\u003c/p\u003e\n\u003cp style=\"padding-left: 40px;\"\u003e+ Kính màu trong: Thích hợp để đi đêm, trong điều kiện ánh sáng yếu, trời râm, ống gió bụi mưa.\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eKính mũ bảo hiểm Sunda 105L được sản xuất bởi Công Ty TNHH LongHuei Việt Nam, là một công ty chuyên sản xuất nón bảo hiểm với gần ba mươi năm kinh nghiệm phục vụ cho thị trường quốc tế, 90% các sản phẩm của công ty được xuất khẩu đi nước ngoài, đảm bảo các yêu cầu khắt khe nhất về tiêu chuẩn và chất lượng. Các nhãn hiệu mũ của công ty tại Việt Nam: ZEUS, ANDES, SUNDA; SIMPSON, CROMO, trong đó thương hiệu mũ bảo hiểm ANDES đã vô cùng quen thuộc với người dùng từ hàng chục năm nay.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/0d/f6/0f/65dc90f15ffcf035e8b4912546d4f37a.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/51/6e/94/9d4eadd2e85d49ddea4dfe4916d7dfe5.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/c5/20/24/852256c52ca06278a71f0e2d59fdb380.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/e1/fd/1e/b7e7715394ff2e555c5258c313ba1f4f.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/94/e2/c3/34c67b8c