],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":652000,"discount_rate":2,"rating_average":4,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/f9/29/16/061070fdc21398a292af464f4546ad0f.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1205,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: center;\"\u003e\u003cspan style=\"background-color: #ccffff;\"\u003e\u003cstrong\u003eBộ trống điện tử cao cấp Medeli Yodrum - Hàng chính hãng\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cstrong\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/93/3f/f3/18934bce05da0414ba959c9647a0b5ed.jpg\" alt=\"\" width=\"750\" height=\"636\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003eDrum Pad: 10 Pads (touch sensitivity)\u003c/strong\u003e\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003ePedals: 2 pedal (1 kick, 1 hi-hat controll)\u003c/strong\u003e\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eDisplay: Dot-matrix OLED display\u003c/strong\u003e\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003ePolyphony: 256\u003c/strong\u003e\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eWIFI: 2.4G WLAN 802.11b/g/n, with AP hotspot function\u003c/strong\u003e\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eBluetooth: Bluetooth 4.0, A2DP \u0026amp; BLE MIDI profile\u003c/strong\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/be/8f/01/a9618479549fd5be3cc7bad491db4947.jpg\" alt=\"\" width=\"750\" height=\"471\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eSỰ ĐỔI MỚI CỦA TRỐNG ĐIỆN TỬ YODRUM\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eTRỐNG ĐIỆN TỬ YODRUM được thiết kế đặc trưng và cấu trúc dễ lắp ráp độc đáo đã giúp cho YoDrum từng đạt giải thưởng hàng đầu về thiết kế. TRỐNG ĐIỆN TỬ YODRUM có chip độc quyền của riêng kèm theo thư viện âm thanh hàng đầu trong ngành. Kết nối không dây đa kênh có độ trễ cực thấp giúp giao tiếp thời gian thực trở nên trơn tru.\u003c/p\u003e\n\u003cp\u003eVề thiết kế sản phẩm, sự khéo léo, công nghệ và trải nghiệm người dùng, YoDrum đặt một trong những cột mốc quan trọng nhất trong ngành công nghiệp nhạc cụ hiện đại.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/31/59/18/589b72eec5a7b8313f11c2d9f6222bfa.jpg\" alt=\"\" width=\"750\" height=\"636\" /\u003e\u003c/p\u003e\n\u003cp\u003eĐế trống U-Bend\u003c/p\u003e\n\u003cp\u003eĐế trống hình chữ U độc đáo của YoDrum là một trong những đặc điểm dễ nhận biết của nó. Bên cạnh việc mang lại vẻ ngoài gọn gàng và gọn gàng, thiết kế sáng tạo này mang đến cho YoDrum sự ổn định và độ bền cao hơn so với bộ trống kỹ thuật số truyền thống, thậm chí với không gian ít hơn 30%. Chữ U cũng làm cho bộ công cụ dễ cài đặt hơn, vì mọi thứ chỉ khớp với nhau trong khi không cần dụng cụ nào!\u003c/p\u003e\n\u003cp\u003eMô-đun điều khiển \u0026amp; Thiết bị trong một\u003c/p\u003e\n\u003cp\u003eMô-đun điều khiển thông minh của YoDrum sử dụng thiết kế vòng cung 3D 45 ° khóa ngay vào đế trống. Tất cả các dây cáp và dây dẫn phức tạp được giấu bên trong giá đỡ trống và bạn được để lại một bộ dụng cụ tích hợp thẩm mỹ, mượt mà. Các mô-đun thông minh và chân đế được thiết kế để chảy cùng nhau, và bạn có thể nói nó là một tác phẩm nghệ thuật duy nhất trong cái nhìn đầu tiên của bạn.\u003c/p\u003e\n\u003cp\u003eNghề thủ công chính xác\u003c/p\u003e\n\u003cp\u003eChân đế YoDrum nhẹ nhưng chắc chắn được làm bằng nhôm được xử lý anốt. U-Bend được sản xuất thông qua quy trình 12 giai đoạn nghiêm ngặt. Bảy trong số các quy trình này được sử dụng để đạt được độ uốn chính xác của đường ống trong khi vẫn đảm bảo đường cong hoàn hảo trong mặt cắt ngang bên trong của chính nó. Các miếng đệm im lặng được làm bằng vật liệu composite kinh vĩ mới cho hiệu suất tự nhiên và không gây ồn. Nếu bạn đang đánh trống trong phòng khách, bạn thậm chí sẽ không đánh thức em bé của mình!\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/51/ed/c8/0a3f3318bde485a7761ff2604aef810f.jpg\" alt=\"\" width=\"750\" height=\"636\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/f9/29/16/061070fdc21398a292af464f4546ad0f.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f9/29/16/061070fdc21398a292af464f4546ad0f.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f9/29/16/061070fdc21398a292af464f4546ad0f.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f9/29/16/061070fdc21398a292af464f4546ad0f.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f9/29/16/061070fdc21398a292af464f4546ad0f.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/93/3f/f3/c666b5cc4b144feebfe4d1b72d76f269.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/93/3f/f3/c666b5cc4b144feebfe4d1b72d76f269.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts