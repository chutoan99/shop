icdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/79/d5/9b/f1a7309aab84c643832aa7966dea1db8.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":446,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2 class=\"BlockTitle__Wrapper-sc-qpz3fo-0 eHltcn\"\u003eMô Tả Sản Phẩm\u003c/h2\u003e\n\u003cdiv class=\"content\"\u003e\n\u003cdiv class=\"ToggleContent__Wrapper-sc-1dbmfaw-1 cqXrJr\"\u003e\n\u003cdiv class=\"ToggleContent__View-sc-1dbmfaw-0 wyACs\"\u003e\n\u003cp\u003e\u003cstrong\u003ePin Sạc Energizer NH15ERP2 - 2300mAh\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003ePin Sạc Energizer NH15ERP2 - 2300mAh\u003c/strong\u003e có xuất xứ từ Mỹ và được sản xuất tại Singapore, được thiết kế để đảm bảo thời lượng pin dài nhất, đạt hiệu suất cao và an toàn cho mọi thiết bị của bạn. Với dung lượng pin 2300mAh, pin có thể sử dụng cho các thiết bị như máy nghe nhạc, đèn pin, đồ chơi và các thiết bị kỹ thuật số cá nhân khác. Pin Sạc Energizer NH15ERP2 - 2300mAh sẽ là sự lựa chọn thông minh cho các thiết bị cần nguồn năng lượng lớn và giúp bạn tiết kiệm được tối đa chi phí.\u003c/p\u003e\n\u003cp\u003ePin sac Energizer NH15ERP2\u003c/p\u003e\n\u003cp\u003e\u003cem\u003eBao bì sản phẩm có thể thay đổi theo từng đợt nhập hàng\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTính năng sản phẩm:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Pin có dung lượng 2300mAh Pin sạc Energizer NH15ERP2 có dung lượng cao lên đến 2300mAh cho thời gian sử dụng lâu hơn, bền bỉ hơn.\u003c/p\u003e\n\u003cp\u003e- Pin sạc Energizer NH15ERP2 được nạp năng lượng bằng bộ sạc chuyên dụng của Energizer.\u003c/p\u003e\n\u003cp\u003eLưu ý: vì là pin Ni-MH nên bạn chỉ nên sạc pin với bộ sạc Ni-MH cùng loại, không nên dùng bộ sạc Ni-Cd để sạc vì sẽ làm giảm tuổi thọ của pin.\u003c/p\u003e\n\u003cp\u003e- Pin có tuổi thọ cao và có thời gian chờ kéo dài lên đến 1 năm với mức hao hụt năng lượng trong khoảng thời gian này là rất nhỏ.\u003c/p\u003e\n\u003cp\u003e- Pin sạc AA Energizer NH15ERP2 tương thích với hầu hết các loại máy ảnh, đèn flash, đồ chơi điện tử hay thậm chí điều khiển từ xa sử dụng nguồn năng lượng chính là pin AA. Do đó bạn có thể an tâm sử dụng pin sạc AA của Energizer để thay thế cho những loại pin AA thông thường chỉ sử dụng được một lần khác để tiết kiệm chi phí và kéo dài thời gian sử dụng máy móc của bạn.\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cstrong\u003eMột số lưu ý khi sử dụng\u003c/strong\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e- Bảo quản Pin nơi thoáng mát – tránh xa lửa và tầm tay trẻ em\u003c/p\u003e\n\u003cp\u003e- Đối với Pin sạc – không nên sạc nhồi quá nhiều sẽ gây nên tình trạng CHAI PIN ( pin sạc không ăn điện được nữa) điều này có nghĩa là Pin hư hỏng nhanh hơn trước thời hạn, chỉ sạc pin khi pin đã thực sự Yếu (hết).\u003c/p\u003e\n\u003cp\u003e- Nên sử dụng Máy sạc Pin có dòng sạc tương ứng với dung lượng mAh của pin để đảm bảo Pin được sạc đầy – đúng và điện năng đủ .\u003c/p\u003e\n\u003cp\u003e- Nên sử dụng Máy sạc pin đồng bộ với Pin (Pin và máy sạc pin cùng hãng) để đảm bảo Pin sạc vào đủ lượng 100% và đảm bảo thời gian sử dụng pin lâu hơn\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThông số kỹ thuật:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Dung lượng: 2300mAh\u003c/p\u003e\n\u003cp\u003e- Số lượng: 2 viên/vỉ\u003c/p\u003e\n\u003cp\u003e- Loại: Pin sạc\u003c/p\u003e\n\u003cp\u003e- HSD: không có hạn sử dụng cụ thể. Pin sạc lại được 1500 lần ~ 10 năm sử dụng\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/79/d5/9b/f1a7309aab84c643832aa7966dea1db8.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/79/d5/9b/f1a7309aab84c643832aa7966dea1db8.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/79/d5/9b/f1a7309aab84c643832aa7966dea1db8.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/79/d5/9b/f1a7309aab84c643832aa7966dea1db8.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/79/d5/9b/f1a7309aab84c643832aa7966dea1db8.png"},{"base_url":"https://salt.tikicdn.com/ts/product/ee/82/d6/e867999f93cccbb37ec3321b674de54a.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ee/82/d6/e867999f93cccbb37ec3321b674de54a.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ee/82/d6/e867999f93cccbb37ec3321b674de54a.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ee/82/d6/e867999f93cccbb37ec3321b674de54a.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ee/82/d6/e867999f93cccbb37ec3321b674de54a.png"},{"base_url":"https://salt.tikicdn.com/ts/product/a3/0d/dd/ab88ef974600ee61f49d93dee88a2a00.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a3/0d/dd/ab88ef974600ee61f49d93dee88a2a00.png",