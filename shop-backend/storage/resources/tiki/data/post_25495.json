ull,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":771000,"discount_rate":21,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/cc/35/bc/7337fd99a6a1010e8700ce3aaa66c7a1.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":232,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2\u003eMua điện thoại di động TECNO SPARK 10 (8GB/128GB) giá rẻ, chính hãng tại Hoàng Hà Mobile\u003c/h2\u003e\n\u003cp style=\"font-weight:400;\"\u003eTECNO SPARK 10 thuộc điện thoại phân khúc giá rẻ của \u003cstrong\u003eTECNO\u003c/strong\u003e nhưng sở hữu nhiều ưu điểm vượt trội. Sản phẩm được trang bị chipset MediaTek Helio G37 cùng RAM 8GB, dung lượng lưu trữ lên đến 128 GB. Thông số kỹ thuật cụ thể của chiếc \u003cstrong\u003eđiện thoại\u003c/strong\u003e này được chúng tôi chia sẻ trong phần dưới đây:\u003c/p\u003e\n\u003cp style=\"font-weight:400;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/25/1e/92/1ec20952d65ea8cb85befca62dc33fbf.jpeg\" alt=\"\" width=\"500\" height=\"500\" /\u003e\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eThiết kế sang trọng, trẻ trung\u003c/strong\u003e\u003c/h2\u003e\n\u003cp style=\"font-weight:400;\"\u003eTECNO SPARK 10 được thiết kế trẻ trung, hiện đại nổi bật với cụm 3 ống kính camera mặt sau. Điều này tạo điểm nhấn và sự tinh tế cho thiết bị, bề mặt lưng còn được dán bóng mờ để hạn chế bám dính vân tay, bụi bẩn.\u003c/p\u003e\n\u003cp style=\"font-weight:400;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/6b/6e/95/d42edc548b08f916cb3837ca7e16cfc6.png\" alt=\"\" width=\"750\" height=\"421\" /\u003e\u003c/p\u003e\n\u003cp style=\"font-weight:400;\"\u003eCác cạnh của thiết bị được bo vuông góc vừa tạo cảm giác sang trọng vừa giúp người dùng dễ dàng cầm nắm. Điện thoại có hai tuỳ chọn màu sắc đó là Đen và Xanh dương phù hợp với mọi độ tuổi, phong cách cá nhân.\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eCấu hình mạnh mẽ\u003c/strong\u003e\u003c/h2\u003e\n\u003cp style=\"font-weight:400;\"\u003eĐiện thoại TECNO SPARK 10 gây ấn tượng cho người dùng bởi hiệu năng mạnh mẽ. Điện thoại được trang bị  chip MediaTek G37 đảm bảo hiệu năng ổn định, khả năng xử lý nhanh chóng mang đến cho người dùng trải nghiệm tốt. TECNO SPARK 10 được kết hợp hoàn hảo giữa hiệu năng và dung lượng lưu trữ lớn đáp ứng nhu cầu giải trí, làm việc trên thiết bị.\u003c/p\u003e\n\u003cp style=\"font-weight:400;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/22/62/d5/bd06845223e5b3be25d9f86bb70450b6.png\" alt=\"\" width=\"750\" height=\"421\" /\u003e\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eCamera kép 50MP\u003c/strong\u003e\u003c/h2\u003e\n\u003cp style=\"font-weight:400;\"\u003eTECNO SPARK 10 nổi bật với hệ thống camera kép 50MP, công nghệ 4 trong 1 mới nâng cấp để hợp nhất các điểm ảnh nhỏ thành điểm ảnh lớn. Điều này giúp điện thoại có thể chụp hình sắc nét trong môi trường thiếu ánh sáng. Đồng thời giúp khôi phục các chi tiết nhỏ mang lại cho bạn những bức ảnh cho độ phân giải cao.\u003c/p\u003e\n\u003cp style=\"font-weight:400;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/28/08/c8/36b5438721a3c642a346109fcc20cb49.png\" alt=\"\" width=\"750\" height=\"421\" /\u003e\u003c/p\u003e\n\u003cp style=\"font-weight:400;\"\u003eNgoài ra, điện thoại TECNO SPARK 10 còn có độ phân giải video lên đến 1080p. Camera selfie 5MP có 3 mức chỉnh ánh sáng để bạn có thể tha hồ chụp hình mà không lo điều kiện ánh sáng tự nhiên ảnh hưởng tới chất lượng.\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eMàn hình 6.6 inches\u003c/strong\u003e\u003c/h2\u003e\n\u003cp style=\"font-weight:400;\"\u003eĐiện thoại TECNO SPARK 10 sở hữu màn hình rộng 6.6 inches giúp người dùng có trải nghiệm hình ảnh sắc nét. Độ phân giải HD+ nhằm mang đến cho người dùng hình ảnh chân thực, rõ ràng. Bên cạnh đó, màn hình của điện thoại còn có tần số quét 90Hz nhằm hạn chế bị giật lag trong quá trình sử dụng.\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003ePin “trâu” khả năng sạc nhanh\u003c/strong\u003e\u003c/h2\u003e\n\u003cp style=\"font-weight:400;\"\u003eBên cạnh những ưu điểm trên, TECNO SPARK 10 còn được trang bị viên pin có dung lượng lưu trữ 5000mAh. Người dùng có thể sử dụng điện thoại cả ngày mà không sợ hết pin giữa chừng. Hơn nữa, sản phẩm còn được trang bị khả năng sạc nhanh 18W với cổng Type - C. Bạn có thể sạc đầy pin điện thoại trong thời gian ngắn, tối ưu hoá trong công việc.\u003c/p\u003e\n\u003cp style=\"font-weight:400;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/c0/80/e0/657fcd2a2ee5db168186644460cf0905.png\" alt=\"\" width=\"750\" height=\"421\" /\u003e\u003c/p\u003e\n\u003cp style=\"font-weight:400;\"\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/cc/35/bc/7337fd99a6a1010e8700ce3aaa66c7a1.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/cc/35/bc/7337fd99a6a1010e8700ce3aaa66c7a1.jpg","medium_url":"https://salt.t