6/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":15300,"discount_rate":5,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/21/05/33/e814b7f4f6f6bf65eb540a76428653d7.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":621,"all_time_quantity_sold":9,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eLEGO Ninjago 71784 Phi Cơ Sấm Sét Tiến Hóa Của Jay (146 Chi Tiết)\u003c/p\u003e\n\u003cp\u003eMang đến cho những người hâm mộ ninja từ 7 tuổi trở lên có cơ hội bay vút lên bầu trời với bộ NINJAGO City Phi Cơ Sấm Sét Tiến Hoá Của Jay (71784). Phi cơ siêu ngầu này có thể được nâng cấp thành một mô hình thậm chí còn lớn hơn và đáng sợ hơn bằng cách thêm 2 súng bắn đinh tán, lưỡi sword vàng và bánh lái vàng.\u003cbr /\u003eNhững cuộc phiêu lưu trên không hay nhất dành cho người hâm mộ ninja\u003cbr /\u003eBộ đồ chơi phi cơ sấm sét này đi kèm với nhân vật Jay để người chơi có thể đặt vào trong buồng lái và thực hiện các cuộc phiêu lưu ninja bay cao. Người chơi cũng có thể kết hợp nó với các bộ NINJAGO khác trong bộ sưu tập của mình để tận hưởng nhiều pha hành động hơn.\u003cbr /\u003eỨng dụng LEGO Builder\u003cbr /\u003eHãy để ứng dụng LEGO Builder hướng dẫn bạn và con bạn trong chuyến phiêu lưu lắp ráp dễ dàng và trực quan. Phóng to và xoay các mô hình ở chế độ 3D, lưu lại và theo dõi tiến trình của bạn.\u003cbr /\u003e• Đồ chơi phi cơ ninja – Trẻ em có thể tận hưởng những chuyến phiêu lưu trên bầu trời cao với bộ LEGO NINJAGO Phi Cơ Sấm Sét Tiến Hoá Của Jay (71784)\u003cbr /\u003e• Bộ đồ chơi bao gồm một nhân vật Jay, được trang bị sword, để người chơi đặt phía sau bộ điều khiển trong buồng lái của phi cơ sấm sét để thực hiện các cuộc phiêu lưu nhanh trên không\u003cbr /\u003e• Phi cơ NINJAGO có thể nâng cấp – người chơi có thể nâng cấp phi cơ để trông nó lớn hơn và đáng sợ hơn bằng cách thêm 2 súng bắn đinh, lưỡi sword vàng và bánh lái vàng\u003cbr /\u003e• Nhiều pha hành động ninja hơn – Hãy cùng khám phá bộ Rồng Biển Tiến Hóa Của Nya (71800), Chiến Giáp Tiến Hóa Của Lloyd (71781), Chiến Xe Tiến Hóa Của Kai (71783) và các bộ khác trong dòng sản phẩm LEGO NINJAGO\u003cbr /\u003e• Bộ đồ chơi gồm 146 mảnh ghép này dành cho trẻ em từ 7 tuổi trở lên cho phép trẻ vừa nhập vai trong khi lắp ráp và đó cũng là món quà lý tưởng có thể tặng cho trẻ nhân dịp sinh nhật hay ngày lễ\u003cbr /\u003e• Với kích thước cao hơn 2,5 inch (6 cm), dài 8,5 inch (22 cm) và rộng 8,5 inch (21 cm), phi cơ LEGO NINJAGO bé có thể chơi ở nhà hoặc mang theo khi đi du lịch\u003cbr /\u003e• Một ý tưởng mới – Ứng dụng LEGO Builder hướng dẫn con bạn tham gia vào cuộc phiêu lưu lắp ráp trực quan. Chúng có thể lưu lại, theo dõi tiến trình và phóng to cũng như xoay các mô hình ở chế độ 3D trong khi lắp ráp\u003cbr /\u003e• Đồ chơi chất lượng cao – Trong hơn 6 thập kỷ, các mảnh ghép LEGO đã được tạo ra để đảm bảo chúng luôn tương thích một cách nhất quán\u003cbr /\u003e• Đảm bảo an toàn – Mảnh ghép LEGO đáp ứng đủ các tiêu chuẩn an toàn nghiêm ngặt toàn cầu\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"h