800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":8,"review_text":"(8)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/77/60/aa/e51fd0b58ab4705c27b1cd29da499712.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":876,"all_time_quantity_sold":228,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch4\u003eVới sứ mệnh nâng cao sức khỏe cho thú cưng tại Việt Nam, thức ăn hỗn hợp hoàn chỉnh pate Kings Pet là một sản phẩm sáng tạo mới của Công Ty TNHH TMDV Thú Cưng Việt Nam, dành cho chó và mèo từ 01 tháng tuổi.\u003c/h4\u003e\n\u003cp\u003e\u003cstrong\u003ePate cho mèo kingspet có 3 hương vị cho bạn lựa chọn:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003ePate Kingspet cá hỗn hợp\u003c/li\u003e\n\u003cli\u003ePate Kingspet gà\u003c/li\u003e\n\u003cli\u003ePate Kingspet cá hồi\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eƯU ĐIỂM SẢN PHẨM :\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eChó \u0026amp; mèo chỉ cần sử dụng sản phẩm King’s Pet và bổ sung thêm nước là có thể duy trì \u0026amp; nâng cao sức khỏe mà không cần bổ sung thực phẩm chức năng:\u003c/li\u003e\n\u003cli\u003eHương vị thơm ngon: Phát triển từ dòng sản phẩm pate tươi đã phổ biến với khách hàng của công ty. Hoàn hảo cho khách hàng cần sử dụng Pate tươi với định lượng nhỏ, cần bảo quản lâu, di chuyển xa,\u003c/li\u003e\n\u003cli\u003eĐầy đủ vitamin, khoáng chất cần thiết: Giàu vitamin A, E từ gan và thịt, cá tươi nguyên chất giúp chó mèo sáng mắt, khỏe xương, phát triển bền vững.\u003c/li\u003e\n\u003cli\u003eSiêu cấp nước cho hệ tiêu hóa: giúp ngăn ngừa sỏi thận do thói quen sử dụng thức ăn khô \u0026amp; lười uống nước.\u003c/li\u003e\n\u003cli\u003eCam kết không chất bảo quản và mùi nhân tạo: được thanh trùng tại 119 độ C với áp suất cao trong 90 phút. Công ty không sử dụng bất kỳ chất bảo quản và mùi nhân tạo nào trong quá trình sản xuất\u003c/li\u003e\n\u003cli\u003eNhuận trường: Trong sản phẩm có chứa Xanthan Gum, là chất nhuận trường tự nhiên cho chó mèo mà không cần sử dụng rau củ.\u003c/li\u003e\n\u003cli\u003eBao bì hiện đại: sản phẩm có nắp nhựa chống khô đầu tiên tại Việt Nam. Bao bì đầy đủ tiếng Anh \u0026amp; tiếng Việt\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eHƯỚNG DẪN SỬ DỤNG:\u003c/strong\u003e Cho ăn trực tiếp, bảo quản tủ lạnh sau khi mở. Điều chỉnh khối lượng cho phù hợp để đảm bảo sức khỏe cho thú cưng\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eBảo quản:\u003c/strong\u003e Nơi khô thoáng. Tránh ánh nắng trực tiếp. Bảo quản tủ mát nếu dùng không hết\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eHạn sử dụng:\u003c/strong\u003e 03 năm kể từ ngày sản xuất.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e\u003cp\u003eSản phẩm này là tài sản cá nhân được bán bởi Nhà Bán Hàng Cá Nhân và không thuộc đối tượng phải chịu thuế GTGT. Do đó hoá đơn VAT không được cung cấp trong trường hợp này.\u003c/p\u003e","images":[{"base