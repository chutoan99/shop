,"code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/63/81/7b/3cf0b0f511107f9599e0a40d10bfd873.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":132,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eDầu gội đầu suôn mượt Bondy Care, Nuôi dưỡng và bảo vệ tóc từ sâu bên trong Z1103 650g Lixco Việt Nam\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lu06dc82zzm9db\" width=\"1200\" height=\"1200\" alt=\"vn-11134208-7r98o-lu06dc82zzm9db\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eTHÔNG TIN CƠ BẢN DẦU GỘI BONDY SUÔN MƯỢT 650G\u003c/p\u003e\n\u003cp\u003e- Loại sản phẩm: Dầu gội\u003c/p\u003e\n\u003cp\u003e- Xuất xứ : Việt Nam\u003c/p\u003e\n\u003cp\u003e- Thương hiệu: Bondy\u003c/p\u003e\n\u003cp\u003e- Khối lượng: 650g\u003c/p\u003e\n\u003cp\u003e- Công thức: Dạng sánh\u003c/p\u003e\n\u003cp\u003e- Mùi hương: Thiên nhiên dịu nhẹ\u003c/p\u003e\n\u003cp\u003e- Thích hợp cho: cả gia đình\u003c/p\u003e\n\u003cp\u003eTHÔNG TIN CHI TIẾT DẦU GỘI SUÔN MƯỢT BONDY CARE 650G\u003c/p\u003e\n\u003cp\u003eƯu điểm của sản phẩm:\u003c/p\u003e\n\u003cp\u003e- Giúp tóc Suôn mượt và dễ chải: Dầu gội đầu Bondy giúp làm tóc trở nên mềm mượt, dễ chải và không bị rối. Cảm giác tóc mềm mượt sau khi sử dụng sẽ khiến bạn tự tin hơn trong cuộc sống hàng ngày.\u003c/p\u003e\n\u003cp\u003e- Nuôi dưỡng từ sâu bên trong: Công thức chứa Hydrolyzed Keratin giúp tái tạo và bảo vệ sợi tóc từ sâu bên trong. Keratin là một loại protein tự nhiên trong tóc, và việc cung cấp thêm Keratin giúp tóc trở nên khỏe mạnh hơn.\u003c/p\u003e\n\u003cp\u003e- Bảo vệ tóc khỏi hư tổn: Tóc thường phải đối mặt với nhiều tác động từ môi trường, hóa chất trong sản phẩm tạo kiểu tóc, và tác động nhiệt từ máy sấy. Dầu gội đầu Bondy giúp tóc chống lại những tác nhân này, bảo vệ tóc khỏi hư tổn và giảm thiểu tình trạng tóc gãy rụng.\u003c/p\u003e\n\u003cp\u003e- Thích hợp cho cả gia đình: Với tính chất dịu nhẹ, sản phẩm phù hợp cho mọi thành viên trong gia đình. Bạn có thể yên tâm sử dụng cho cả trẻ em và người lớn.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eCách sử dụng:\u003c/p\u003e\n\u003cp\u003eBước 1: Ướt tóc: Trước khi sử dụng, hãy ướt tóc thật sạch bằng nước ấm.\u003c/p\u003e\n\u003cp\u003eBước 2: Lấy một lượng dầu gội vừa đủ: Lấy một lượng dầu gội Bondy ra lòng bàn tay, sau đó thoa đều lên tóc.\u003c/p\u003e\n\u003cp\u003eBước 3: Mát-xa nhẹ nhàng: Mát-xa nhẹ nhàng da đầu và tóc để dầu gội thẩm thấu đều khắp.\u003c/p\u003e\n\u003cp\u003eBước 4: Xả sạch bằng nước: Rửa sạch tóc bằng nước ấm cho đến khi không còn dầu gội.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eSử dụng thường xuyên: Để có hiệu quả tốt nhất, hãy sử dụng dầu gội đầu Bondy thường xuyên, ít nhất là 2-3 lần mỗi tuần.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eLưu ý:\u003c/p\u003e\n\u003cp\u003eBảo quản ở nhiệt độ phòng, nơi kho thoáng, tránh ánh nắng trực tiếp\u003c/p\u003e\n\u003cp\u003eXả sạch dầu gội bằng nước để đảm bảo hiệu quả sau khi sử dụng\u003c/p\u003e\n\u003cp\u003eXuất xứ thương hiệu: Việt Nam\u003c/p\u003e\n\u003cp\u003eNơi sản xuất: Việt Nam\u003c/p\u003e\n\u003cp\u003eNgày sản xuất: Xem trên bao bì sản phẩm\u003c/p\u003e\n\u003cp\u003eHạn sử dụng: Xem trên bao bì sản phẩm\u003c/p\u003e\n\u003cp\u003eThành phần: Xem trên bao bì sản phẩm\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eLIXCO VIỆT NAM CAM KẾT\u003c/p\u003e\n\u003cp\u003e- Sản phẩm chính hãng 100%\u003c/p\u003e\n\u003cp\u003e- Sản phẩm giống như hình ảnh và mô tả\u003c/p\u003e\n\u003cp\u003e- Tư vấn, hỗ trợ 24/7\u003c/p\u003e\n\u003cp\u003e- Hỗ trợ đổi trả theo quy định\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/63/81/7b/3cf0b0f511107f9599e0a40d10bfd873.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/63/81/7b/3cf0b0f511107f9599e0a40d10bfd873.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/63/81/7b/3cf0b0f511107f9599e0a40d10bfd873.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/63/81/7b/3cf0b0f511107f9599e0a40d10bfd873.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/63/81/7b/3cf0b0f511107f9599e0a40d10bfd873.png"},{"base_url":"https://salt.tikicdn.com/ts/product/99/57/21/5445219bb13a24326b645cf970fda560.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/99/57/21/5445219bb13a24326b645cf970fda560.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/99/57/21/5445219bb13a24326b645cf970fda560.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/99/57/21/5445219bb13a24326b645cf970fda560.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/99/57/21/5445219bb13a24326b645cf970fda560.jpg"},{"