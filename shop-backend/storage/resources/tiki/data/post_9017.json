eTrong cuộc hành trình bất định ấy, anh có duyên gặp gỡ những con người tốt bụng như Steiner, Marill; họ đã cưu mang, giúp đỡ anh trong cuộc sống khó khăn nơi đất khách. Số phận cũng cho anh gặp Ruth – người con gái mang đến cho anh một tình yêu, một niềm an ủi, một hy vọng mới. Họ đến với nhau bằng sự cảm thông sâu sắc giữa hai con người cùng cảnh ngộ. Họ yêu nhau và làm mọi cách để được ở bên nhau bất chấp những lần bị bắt giam, bị trục xuất. \u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cspan\u003eHành trình của họ tựa như bản du ca của những con người không còn đất sống, chỉ có thể bám víu vào con thuyền mang tên hy vọng và tình người.\u003c/span\u003e\u003cstrong\u003e\u003cbr /\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/5f/de/98/8d32bc1ab627cdf3aa6ef6c5b46f0a19.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/5f/de/98/8d32bc1ab627cdf3aa6ef6c5b46f0a19.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/5f/de/98/8d32bc1ab627cdf3aa6ef6c5b46f0a19.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5f/de/98/8d32bc1ab627cdf3aa6ef6c5b46f0a19.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5f/de/98/8d32bc1ab627cdf3aa6ef6c5b46f0a19.jpg"}],"warranty_policy":null,"authors":[{"id":14415,"name":"Erich Maria Remarque","slug":"erich-maria-remarque"}],"current_seller":{"id":229927,"sku":"9308311459238","name":"Đông A Books Official","link":"https://tiki.vn/cua-hang/dong-a-books-official","logo":"9f/5f/bd/b1a337741eed8c7b997f8a808abfe9fc.jpg","price":73000