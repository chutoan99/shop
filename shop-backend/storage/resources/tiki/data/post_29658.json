ong\u003e\u003c/li\u003e \n   \u003cli\u003eĐường kính lỗ khoét trần: 76\u003csup\u003e±2\u003c/sup\u003emm\u003c/li\u003e \n   \u003cli\u003eNguồn điện danh định: 220V/50Hz\u003c/li\u003e \n   \u003cli\u003eVật liệu thân: Làm bằng hợp kim nhôm và được sơn tĩnh điện, chống rỉ, chống tác động môi trường\u003c/li\u003e \n   \u003cli\u003eMặt sáng: mặt nhựa mica có hệ số truyền sáng cao,chống lóa tạo phân bố ánh sáng đều trên bề mặt, giảm độ chói\u003c/li\u003e \n   \u003cli\u003eNhiệt độ màu ánh sáng: Trắng 6500K và vàng ấm 3000K\u003c/li\u003e \n  \u003c/ul\u003e \n  \u003col start=\"2\"\u003e \n   \u003cli\u003e\u003cstrong\u003eThông số điện:\u003c/strong\u003e\u003c/li\u003e \n  \u003c/ol\u003e \n  \u003cul\u003e \n   \u003cli\u003eCông suất: 3W\u003c/li\u003e \n   \u003cli\u003eĐiện áp có thể hoạt động: 150V-250V\u003c/li\u003e \n   \u003cli\u003eDòng điện (Max): 90mA\u003c/li\u003e \n   \u003cli\u003eHệ số công suất 0.5\u003c/li\u003e \n  \u003c/ul\u003e \n  \u003col start=\"3\"\u003e \n   \u003cli\u003e\u003cstrong\u003eThông số quang:\u003c/strong\u003e\u003c/li\u003e \n  \u003c/ol\u003e \n  \u003cul\u003e \n   \u003cli\u003eQuang thông: 180 lm\u003c/li\u003e \n   \u003cli\u003eHiệu suất sáng: 65 lm/W\u003c/li\u003e \n   \u003cli\u003eHệ số trả màu(CRI): 80\u003c/li\u003e \n   \u003cli\u003eGóc trùm tia: 110 độ\u003c/li\u003e \n  \u003c/ul\u003e \n  \u003col start=\"4\"\u003e \n   \u003cli\u003e\u003cstrong\u003eTuổi thọ:\u003c/strong\u003e\u003c/li\u003e \n  \u003c/ol\u003e \n  \u003cul\u003e \n   \u003cli\u003eTuổi thọ đèn: 15.000 giờ\u003c/li\u003e \n   \u003cli\u003eChu kì tắt bật: 50.000 lần\u003c/li\u003e \n  \u003c/ul\u003e \n  \u003col start=\"5\"\u003e \n   \u003cli\u003e\u003cstrong\u003eMức tiêu thụ điện:\u003c/strong\u003e\u003c/li\u003e \n  \u003c/ol\u003e \n  \u003cul\u003e \n   \u003cli\u003eMức tiêu thụ điện 1000 giờ: 7kWh\u003c/li\u003e \n   \u003cli\u003eMức hiệu suất năng lượng: A+\u003c/li\u003e \n  \u003c/ul\u003e \n  \u003col start=\"6\"\u003e \n   \u003cli\u003e\u003cstrong\u003eKích thước đèn:\u003c/strong\u003e\u003c/li\u003e \n  \u003c/ol\u003e \n  \u003cul\u003e \n   \u003cli\u003eĐường kính: 110 mm\u003c/li\u003e \n   \u003cli\u003eChiều cao: 62 mm\u003c/li\u003e \n  \u003c/ul\u003e \n  \u003col start=\"7\"\u003e \n   \u003cli\u003e\u003cstrong\u003eĐăc điểm khác: \u003c/strong\u003e\u003c/li\u003e \n  \u003c/ol\u003e \n  \u003cul\u003e \n   \u003cli\u003eHàm lượng t.h.ủ.y â: 0mg\u003c/li\u003e \n   \u003cli\u003eThời gian khởi động: ≤ 0.5 giây\u003c/li\u003e \n  \u003c/ul\u003e \n  \u003col\u003e \n   \u003cli\u003e\u003cstrong\u003eƯU ĐIỂM: \u003c/strong\u003e\u003c/li\u003e \n   \u003cli\u003e\u003cstrong\u003eTiết kiệm 60% điện năng:\u003c/strong\u003e\u003c/li\u003e \n  \u003c/ol\u003e \n  \u003cul\u003e \n   \u003cli\u003eSử dụng chip LED Samsung có hiệu suất sáng 180 lm/W\u003c/li\u003e \n   \u003cli\u003eTiết kiệm 40-57% điện năng thay thế đèn downlight compact 15W\u003c/li\u003e \n   \u003cli\u003eGiúp giảm chi phí hóa đơn tiền điện\u003c/li\u003e \n  \u003c/ul\u003e \n  \u003col start=\"2\"\u003e \n   \u003cli\u003e\u003cstrong\u003eTuổi thọ cao:\u003c/strong\u003e\u003c/li\u003e \n  \u003c/ol\u003e \n  \u003cul\u003e \n   \u003cli\u003eTuổi thọ cao 25000 giờ, độ tin cậy cao, không hạn chế số lần bật/tắt.\u003c/li\u003e \n   \u003cli\u003eCao gấp 2-3 lần so với đèn compact\u003c/li\u003e \n  \u003c/ul\u003e \n  \u003col start=\"3\"\u003e \n   \u003cli\u003e\u003cstrong\u003eDải điện áp hoạt động rộng, tương thích điện từ trường EMC/EMI:\u003c/strong\u003e\u003c/li\u003e \n  \u003c/ol\u003e \n  \u003cul\u003e \n   \u003cli\u003eĐèn LED Downligt có dải điện áp rộng (150-250V) ánh sáng và công suất không thay đổi khi điện áp lưới thay đổi.\u003c/li\u003e \n   \u003cli\u003eTương thích điện từ trường không gây ra hiện tượng nhiễu cho sản phẩm điện tử và không bị ảnh hưởng nhiễu của các thiết bị điện tử khác\u003c/li\u003e \n  \u003c/ul\u003e \n  \u003col start=\"4\"\u003e \n   \u003cli\u003e\u003cstrong\u003eHệ số trả màu (CRI \u0026gt; 80):\u003c/strong\u003e\u003c/li\u003e \n  \u003c/ol\u003e \n  \u003cul\u003e \n   \u003cli\u003eHệ số trả màu cao (CRI ≥ 80), ánh sáng trung thực tự nhiên.\u003c/li\u003e \n   \u003cli\u003eĐáp ứng tiêu chuẩn chiếu sáng Việt Nam TCVN 7114: 2008\u003c/li\u003e \n  \u003c/ul\u003e \n  \u003col start=\"5\"\u003e \n   \u003cli\u003e\u003cstrong\u003eĐáp ứng Tiêu chuẩn Việt Nam (TCVN), Quốc tế (IEC):\u003c/strong\u003e\u003c/li\u003e \n  \u003c/ol\u003e \n  \u003cul\u003e \n   \u003cli\u003eTCVN 7722-1:2009/ IEC 60598-1: 2008\u003c/li\u003e \n  \u003c/ul\u003e \n  \u003col start=\"6\"\u003e \n   \u003cli\u003e\u003cstrong\u003eThân thiện môi trường:\u003c/strong\u003e\u003c/li\u003e \n  \u003c/ol\u003e \n  \u003cul\u003e \n   \u003cli\u003eKhông chứa t.h.ủ.y â và hóa chất độc hại, không phát ra tia tử ngoại, an toàn cho người sử dụng\u003c/li\u003e \n  \u003c/ul\u003e \n  \u003col start=\"7\"\u003e \n   \u003cli\u003e\u003cstrong\u003eỨng dụng:\u003c/strong\u003e\u003c/li\u003e \n  \u003c/ol\u003e \n  \u003cul\u003e \n   \u003cli\u003eChiếu sáng hộ gia đình, căn hộ: phòng ngủ, phòng bếp….\u003c/li\u003e \n   \u003cli\u003eChiếu sáng khu văn phòng: Phòng họp, hành lang, tiền sảnh…\u003c/li\u003e \n   \u003cli\u003eĐèn Led Downlight D AT06L 76/3W Rạng Đông với chất liệu nhựa PC là thế hệ đèn Led mới của Rạng Đông với những cải tiến ưu việt về thiết kế cũng như chất lượng ánh sáng. Bề mặt của downlight D AT06L 76/3W làm bằng chất liệu mica mờ chống lóa, Viền cong modul D AT06L được thiết kế với bề mặt phẳng, chipLed sử dụng của Samsung cho ánh sáng đều độ hoàn màu cao.\u003c/li\u003e \n  \u003c/ul\u003e \n  \u003cp\u003eVới công suất chiếu sáng 3W đường kính lỗ khoét 76 đèn Led downlight Rạng Đông thích hợp để lắp đặt chiếu sáng ở những không gian sống và làm việc như: phòng khách, nhà bếp, phòng ngủ, căn hộ hoặc khu văn phòng, phòng triển lãm, trưng bày,\u003c/p\u003e \n  \u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thu