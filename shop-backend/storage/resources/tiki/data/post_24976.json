lor":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":780,"discount_rate":1,"rating_average":4.7,"review_count":29,"review_text":"(29)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/7a/a9/35/cda07409166d5e607d301081471df027.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":3226,"all_time_quantity_sold":166,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: medium; color: #008ab7;\"\u003e\u003cstrong\u003e* \u003cspan style=\"color: #ff0000;\"\u003eLưu ý bóp sổ 6 còng thay đổi mẫu tùy đợt hàng \u003c/span\u003e\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: medium; color: #008ab7;\"\u003e\u003cstrong\u003eBóp Sổ 6 Còng Lớn 2 Da (4 Màu)\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eBóp Sổ 6 Còng Lớn 2 Da (4 Màu)\u003c/strong\u003e vô cùng nổi bật bởi thiết kế rất công phu, sang trọng, thể hiện tác phong làm việc chuyên nghiệp của người sử dụng. Những tiện ích vượt trội của dòng sổ 6 còng, cùng mẫu mã đa dạng với 4 màu sắc khác nhau chính là điểm nhấn đặc sắc của sản phẩm này. Đây chính là một vật dụng cá nhân hoàn hảo hỗ trợ tối đa cho công việc của bạn, một sự lựa chọn tuyệt vời nếu bạn muốn sở hữu loại sổ tay tốt nhất.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"http://tikicdn.com/media/catalog/product/1/2/1287.jpg\" alt=\"\" width=\"800\" height=\"800\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eThông tin sản phẩm\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eBìa ép lún cao cấp\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003eBìa sổ được làm bằng chất liệu chất lượng, có độ bền cao, chống phai màu và khả năng chống thấm nước tốt, giúp bảo quản cẩn thận những ghi chép quan trọng của bạn. Chất liệu này còn tạo nên phong cách sang trọng, thanh lịch cho người sử dụng.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003eBìa được ép lún, có đường may viền xung quanh, hai góc ngoài được bo tròn, làm giảm độ góc cạnh, tăng tính thẩm mỹ cho sản phẩm.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003eSản phẩm sử dụng ruột giấy có bề mặt mịn, không chói, bám mực tốt, và đặc biệt là khó bị ố vàng theo thời gian, rất thích hợp cho việc lưu trữ.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eMẫu mã đa dạng\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003eBóp Sổ 6 Còng Lớn 2 Da có hai mẫu: quai gài và quai hít nam châm với 4 màu đỏ, đen, nâu đậm, nâu nhạt được thiết kế đẹp mắt, giúp bạn thoải mái lựa chọn sản phẩm theo sở thích và nhu cầu riêng của mình.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003eSổ có trang lịch năm 2015, 2016 và các trang để người sử dụng ghi họ tên, địa chỉ, số điện thoại; những trang thông tin về các số điện thoại cần thiết, các cơ quan hành chính nhà nước…, giúp người dùng tiện tham khảo khi cần đến.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eNgăn đựng giấy tờ tiện lợi\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003eThiết kế ngăn đựng giấy tờ, thẻ cá nhân là một trong những điểm nhấn nổi bật của sản phẩm. Nhiều ngăn đựng cho khả năng chứa một lượng lớn thẻ, card visit của cá nhân, khách hàng và đối tác. Quai gài chắc chắc giúp bạn hoàn toàn yên tâm, tránh việc thất lạc hay làm mất những giấy tờ quan trọng.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"http://tikicdn.com/media/catalog/product/1/2/1288_2.jpg\" alt=\"\" width=\"800\" height=\"800\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eThiết kế tiện ích vượt trội\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003eDòng sổ tay 6 còng luôn mang lại sự hài lòng cho khách hàng bởi tính linh hoạt của thiết kế.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003eCòng được làm bằng chất liệu tốt, không gỉ sét, bền chắc, đặc biệt có thể đóng, mở khi cần thiết, giúp bạn dễ dàng tháo gỡ, tránh làm giấy rách hay nhàu nát.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003eCùng với ngăn đựng giấy tờ, sổ còn trang bị miếng đính để gài bút ở bên hông vô cùng tiện lợi.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003eSản phẩm có dây cài bên ngoài, tạo sự chắc chắn tuyệt đối, rất tiện dụng khi bạn có nhu cầu đi lại thường xuyên.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eThể hiện sự chuyên nghiệp\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003eVới thiết kế đẹp mắt, công phu và vô cùng tiện ích, sổ không những là công cụ tuyệt vời hỗ trợ cho công việc của bạn, mà còn là vật dụng cá nhân thể hiện tác phong làm việc chuyên nghiệp của người sử dụng.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003eSản phẩm rất phù hợp để làm quà tặng cho khách hàng, đối tác.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/7a/a9