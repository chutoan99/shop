ext":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":1200000,"discount_rate":26,"rating_average":4.3,"review_count":3,"review_text":"(3)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/8d/3c/88/85790a03600a9b1a4bab961245724aa9.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":424,"all_time_quantity_sold":7,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eCấu hình sản phẩm\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eCông nghệ màn hình:: IPS LCD, 90Hz\u003c/p\u003e\n\u003cp\u003eĐộ phân giải:: HD+ (720x1600)\u003c/p\u003e\n\u003cp\u003eMàn hình rộng:: 6,82”\u003c/p\u003e\n\u003cp\u003eĐộ phân giải: Cảm biến chính 50MP, Cảm biến chiều sâu, 8MP\u003c/p\u003e\n\u003cp\u003eHệ điều hành: HIOS dựa trên Android 12\u003c/p\u003e\n\u003cp\u003eChip xử lý (CPU): Helio G99\u003c/p\u003e\n\u003cp\u003eBộ nhớ trong (ROM): 128GB\u003c/p\u003e\n\u003cp\u003eRAM: 8GB\u003c/p\u003e\n\u003cp\u003eMạng di động: 2G, 3G, 4G\u003c/p\u003e\n\u003cp\u003eSố khe sim: 2 nano SIM\u003c/p\u003e\n\u003cp\u003eDung lượng pin: 6000mAh\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eTECNO POVA 4 (8GB/128GB) là một thiết bị thuộc phân khúc giá tầm trung nhưng lại sở hữu khá nhiều tính năng và trang bị chất lượng so với các sản phẩm khác có cùng tầm giá. Sản phẩm tiếp tục được đầu tư về mặt cấu hình hơn các thế hệ trước.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/51/45/3f/63faacad65f0832adfd819fce18f5327.jpeg\" alt=\"\" width=\"500\" height=\"500\" /\u003e\u003c/p\u003e\n\u003ch2\u003eThiết kế đẹp, sáng tạo\u003c/h2\u003e\n\u003cp\u003eTECNO POVA 4 sở hữu thiết kế đẹp mắt, nổi trội về sự bền bỉ, sức sống và năng lượng tuyệt vời cùng kết cấu cao cấp. TECNO POVA 4 có ngoại hình khá phù hợp với thị trường hiện nay khi sở hữu khung viền vuông vức cùng các góc được bo cong nhẹ giúp cầm nắm dễ dàng, tiện lợi đi mọi nơi.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/d9/32/f3/7b2bcb2ffbafbb5f6926a6bb61f306f1.jpeg\" alt=\"\" width=\"500\" height=\"500\" /\u003e\u003c/p\u003e\n\u003ch2\u003eDung lượng lưu trữ lớn, không lo trì trệ\u003c/h2\u003e\n\u003cp\u003eBộ nhớ lên tới 128GB ROM + 8GB RAM kèm thêm 5GB RAM mở rộng giúp thao tác trên điện thoại vô cùng mượt mà. TECNO POVA 4 tăng 9 ứng dụng bộ nhớ đệm phụ trợ, tăng trung bình 61% tốc độ khởi động ứng dụng. Vi xử lý Helio G99 mang tới hiệu suất Hardcore cải tiến mạnh mẽ. Với con chip này, TECNO POVA 4 sẽ có đủ khả năng để có thể cân được các tác vụ nặng, nhẹ khác nhau một cách dễ dàng. Sản phẩm sẽ phục vụ tốt cho nhu cầu giải trí của bạn bằng việc tải các tựa game hay những bộ phim về máy thông qua bộ nhớ trong 128GB.\u003c/p\u003e\n\u003ch2\u003eMàn hình ấn tượng\u003c/h2\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch2\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/82/c2/7e/ba5efb63eef8648b9a6d59e4c3d0eca8.jpg\" alt=\"\" width=\"750\" height=\"421\" /\u003e\u003c/h2\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eMàn hình lớn HD 6.82” với tốc độ làm tươi cao 90Hz giúp bắt trọn mọi khung hình. Điều này cho phép bạn thưởng thức video chất lượng, lướt stream và mạng xã hội với tốc độ khung hình cao, loại bỏ độ trễ, đem tới cảm giác mượt mà và khác biệt\u003c/p\u003e\n\u003ch2\u003eDung lượng pin khủng, có hỗ trợ sạc nhanh\u003c/h2\u003e\n\u003cp\u003eTECNO POVA 4 có dung lượng pin lên tới 6000mAh. Sạc 20% chỉ trong 20 phút với sạc siêu tốc 18W. Với 20% pin này, bạn có thể trò chuyện bằng 4G trong hơn 12 giờ, chơi game gần 3 giờ và xem YouTube trong 4 giờ. Công nghệ pin an toàn STS giúp đảm bảo cho việc sử dụng điện thoại trong thời gian dài.\u003c/p\u003e\n\u003ch2\u003eCamera chất lượng, đem tới hình ảnh làm đẹp chân thực\u003c/h2\u003e\n\u003cp\u003eTECNO POVA 4 được trang bị camera AI 50MP. Hệ thống camera kép của thiết bị đi kèm với đèn flash LED đem tới hình ảnh siêu nét. Chế độ làm đẹp chân dung chế làm đẹp tự nhiên và nhẹ nhàng cho từng bức hình. Chế độ HDR mang lại cảm giác chân thật và rõ ràng trong ánh sáng nền.\u003c/p\u003e\n\u003ch2\u003eTrải nghiệm chơi game hoàn hảo\u003c/h2\u003e\n\u003ch2\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/b4/8e/42/0f4d5c269aa2254645668461bd08f664.jpg\" alt=\"\" width=\"750\" height=\"328\" /\u003e\u003c/h2\u003e\n\u003cp\u003eCảm biến con quay hồi chuyển sẽ nâng tầm trải nghiệm game của bạn. Đây là cảm biến trong những game vật lý (game bắn súng PUBG, đua xe,...) giúp điều khiển hướng và hỗ trợ ngắm bắn, mang lại cho bạn trải nghiệm chơi game vượt trội. Bạn thoả sức đắm chìm vào thế giới game khi âm thanh được nâng cấp với bộ loa kép giảm tiếng ồn AI. Hệ thống tản nhiệt nhiều lớp với ống làm mát bằng than chì đảm bảo an toàn cho vỏ pin, bo mạch chủ và vỏ ngoài, thời gian chơi game ít bị gián đoạn. Sự phân bổ hợp lý sức mạnh CPU thông qua máy học mang đến cho bạn trải nghiệm chơi game mượt mà với đủ khung hình mà lại giảm hiện tượng phát nhiệt, tiêu hao pin và rớt khung hình.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url