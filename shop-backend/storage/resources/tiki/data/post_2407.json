:1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":true,"return_reason":"any_reason"}},"discount":105000,"discount_rate":35,"rating_average":4.8,"review_count":750,"review_text":"(750)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/da/d9/7c/159a3d82dfcfcf6eef64644f0de46627.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2028,"all_time_quantity_sold":6889,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003e\u003cstrong\u003eCombo Danh Nhân Thế Giới (10 cuốn) - Tái Bản\u003c/strong\u003e\u003c/h3\u003e\n\u003ch3\u003e\u003cstrong\u003eLời nói đầu/Giới thiệu sách\u003c/strong\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eBộ sách khái quát cuộc đời và sự nghiệp của 10 danh nhân thế giới như Edixon, Anhxtanh, Niuton…\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eHọ là ai và cuộc đời của họ trưởng thành và đi đến thành công như thế nào? Thông qua tập tranh truyện minh họa vô cùng sinh động giúp các em hiểu được thời thơ ấu, giai đoạn trưởng thành và cuộc đời cống hiến lẫn sự nghiệp của các danh nhân.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eQua đó các em hiểu hơn và phấn đấu theo tấm gương không ngừng học tập và nghiên cứu của Danh nhân.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eBộ sách giúp trẻ hoàn thiện và phát triển những kỹ năng cho mình sau này. Đặc biệt đây là bộ tranh truyện thu hút lôi cuốn các bé tìm hiểu khám phá kiến thức mà hào hứng như đọc truyện tranh vậy!\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003e\u003cstrong\u003eĐối tượng sử dụng\u003c/strong\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eDành cho trẻ từ 6 tuổi\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003e\u003cstrong\u003eDanh sách tác phẩm trong bộ\u003c/strong\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eÊđixơn\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eAnhxtanh\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eFabrê\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eHêlen\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eLincoln\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eMari Quyri\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eNapôlêông\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eNiutơn \u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eNôben\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eSutơ\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003e\u003cstrong\u003eTóm tắt nội dung\u003c/strong\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cstrong\u003eÊđixơn:\u003c/strong\u003e\u003cspan style=\"font-weight: 400;\"\u003e Cha đẻ của hàng trăm phát minh vĩ đại, từ bóng đèn đến máy quay phim.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cstrong\u003eAnhxtanh:\u003c/strong\u003e\u003cspan style=\"font-weight: 400;\"\u003e Nhà vật lý thiên tài, người đặt nền móng cho lý thuyết tương đối.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cstrong\u003eFabrê:\u003c/strong\u003e\u003cspan style=\"font-weight: 400;\"\u003e Nhà khoa học nổi tiếng với những đóng góp quan trọng trong lĩnh vực hóa học.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cstrong\u003eHêlen:\u003c/strong\u003e\u003cspan style=\"font-weight: 400;\"\u003e Cô bé khiếm thị và khiếm thính nhưng vẫn trở thành một nhà văn, nhà hoạt động xã hội nổi tiếng.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cstrong\u003eLincoln:\u003c/strong\u003e\u003cspan style=\"font-weight: 400;\"\u003e Tổng thống thứ 16 của Hoa Kỳ, người đã lãnh đạo đất nước vượt qua cuộc nội chiến.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cstrong\u003eMari Quyri:\u003c/strong\u003e\u003cspan style=\"font-weight: 400;\"\u003e Nhà khoa học nữ đầu tiên đoạt giải Nobel, người khám phá ra nguyên tố Radium và Polonium.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cstrong\u003eNapôlêông:\u003c/strong\u003e\u003cspan style=\"font-weight: 400;\"\u003e Vị tướng và hoàng đế tài ba của Pháp, người đã làm thay đổi cục diện lịch sử châu Âu.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cstrong\u003eNiutơn:\u003c/strong\u003e\u003cspan style=\"font-weight: 400;\"\u003e Nhà vật lý học vĩ đại, người phát hiện ra định luật vạn vật hấp dẫn.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cstrong\u003eNôben:\u003c/strong\u003e\u003cspan style=\"font-weight: 400;\"\u003e Nhà khoa học, kỹ sư và nhà phát minh người Thụy Điển, người sáng lập giải thưởng Nobel.\u003c/span\u003e\u003c/li\u003e\n\u003cli\u003e\u003cspan style=\"font-weight: 400;\"\u003e\u003cstrong\u003eSutơ:\u003c/strong\u003e Nhà văn Nga nổi tiếng với những tác phẩm văn học kinh điển.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003e\u003cstrong\u003eƯu điểm\u003c/strong\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cstrong\u003eMở rộng kiến thức:\u003c/strong\u003e\u003cspan style=\"font-weight: 400;\"\u003e Giúp bé hiểu biết về lịch sử, khoa học, văn học và những nhân vật đã làm nên lịch sử nhân loại.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cstrong\u003eRèn luyện tính cách:\u003c/strong\u003e\u003cspan style=\"font-weight: 400;\"\u003e Qua những câu chuyện về cuộc đời và sự nghiệp của các danh nhân, bé sẽ học được những đức tính quý báu như sự kiên trì, sáng tạo, lòng yêu nước...\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cstrong\u003ePhát triển tư duy:\u003c/strong\u003e\u003cspan style=\"font-weight: 400;\"\u003e Giúp bé hình thành tư duy độc lập, khả năng phân tích và tổng hợp thông tin.\u003c/span\u003e\u003c/li\u003e\n\u003cli\u003e\u003cspan style=\"font-weight: 400;\"\u003e\u003cstrong\u003eCảm hứng cho tương lai:\u003c/strong\u003e Những câu chuyện về thành công của các danh nhân sẽ truyền cảm hứng cho bé, giúp bé nuôi dưỡng ước mơ và phấn đấu.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/da/d9/7c/159a3d82dfcfcf6eef64644f0de46627.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/da/d9/7c/159a3d82dfcfcf6eef64644f0de46627.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/da/d9/7c/159a3d82dfcfcf6eef64644f0de46627.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/da/d9/7c/159a3d82dfcfcf6eef64644f0de46627.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/da/d9/7c/159a3d82dfcfcf6eef64644f0de46627.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/86/de/94/5690483e133cc082bcb44a484527068b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/86/de/94/5690483e133cc082bcb44a484527068b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/86/de/94/5690483e133cc082bcb44a484527068b.jpg","position":null,"small_url":"https://salt.tikicd