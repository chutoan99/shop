8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":3,"review_text":"(3)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/d0/f7/dc/b09394044aae16237b8759f402a7fdab.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1219,"all_time_quantity_sold":95,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ba/f5/8d/3e089fbe593ba2b111a6d40102b204a8.jpg\" alt=\"Bộ Lau Nhà Xoay 360 Độ Sunhouse Happy Time KH-CL330S\" width=\"750px\" height=\"502px\" /\u003e\u003c/p\u003e\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/32/83/57/89629f6251b141244c02f0e4c39670a7.jpg\" alt=\"Bộ Lau Nhà Xoay 360 Độ Sunhouse Happy Time KH-CL330S\" width=\"750px\" height=\"502px\" /\u003e\u003c/p\u003e\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/d8/24/d8/a8d7cb07ae979274b89b8dc438879b3c.jpg\" alt=\"Bộ Lau Nhà Xoay 360 Độ Sunhouse Happy Time KH-CL330S\" width=\"750px\" height=\"502px\" /\u003e\u003c/p\u003e\u003ch5\u003eThiết kế thông minh - tiện dụng\u003c/h5\u003e\n\u003cp\u003e\u003cstrong\u003eBộ Lau Nhà Xoay 360 Độ Sunhouse Happy Time KH-CL330S\u003c/strong\u003e được thiết kế tiện dụng với thùng vắt làm bằng nhựa tổng hợp với 2 màu sắc bắt mắt, kích thước phù hợp giúp bạn thoải mái giặt, vắt mà không lo bị bắn nước ra bên ngoài.\u003c/p\u003e\n\u003cp\u003eNgoài ra, dưới thùng giặt có 4 bánh xe giúp cân bằng và dễ dàng di chuyển sản phẩm mà không cần tốn quá nhiều công sức để xách thùng nước lau nhà, thoải mái tận hưởng mà không lo đau lưng hay mỏi tay.\u003c/p\u003e\n\u003ch5\u003eLồng vắt inox giúp tiết kiệm thời gian và công sức vắt khô nước\u003c/h5\u003e\n\u003cp\u003eBên trong thùng giặt có 1 lồng vắt bằng inox chống han gỉ và giúp dễ dàng vắt khô nước của bông lau nhờ cơ chế vắt ly tâm và thiết kế lỗ thoát tiện dụng.\u003c/p\u003e\n\u003ch5\u003eCây lau bằng inox độ bền cao\u003c/h5\u003e\n\u003cp\u003eBộ lau nhà xoay 360 độ HAPPY TIME KH-CL330S có cây lau được làm bằng inox với các khớp nối bằng nhựa tổng hợp giúp tăng độ bền của sản phẩm, chống ăn mòn và không bị han gỉ sau 1 thời gian sử dụng. Bên cạnh đó, cây lau còn có thể điều chỉnh được độ dài từ 950 đến 1200mm giúp làm sạch cả những góc khuất khó lau dọn như gầm giường, tủ hay cả những nơi cao, khó với tới.\u003c/p\u003e\n\u003ch5\u003eBông lau thấm hút nước tốt\u003c/h5\u003e\n\u003cp\u003eTấm bông lau làm bằng sợi Microfiber thiết kế đan chéo lập thể siêu nhỏ giúp thấm hút nước tốt, vắt khô nhanh gấp nhiều lần so với các loại khăn lau thông thường, có tác dụng lau sạch bụi bẩn nhanh chóng nhất. Hệ thống vắt nước tích hợp gọn và tiện lợi, dễ dàng giặt và vắt khô bông lau. Đặc biệt, sợi Microfiber có ưu điểm là không bị xơ cứng nên không làm trầy xước bề mặt được lau. \u003c/p\u003e\n\u003ch5\u003eBộ chuyển động 360 độ siêu bền\u003c/h5\u003e\n\u003cp\u003eBộ phận tạo chuyển động với thanh dẫn động xoắn bằng thép hợp kim và cơ cấu tạo chuyển động bằng nhựa POM chống mài mòn tốt cùng hệ thống giảm chấn động bằng cao su giúp tạo chuyển động 360 độ nhẹ nhàng, tăng độ bền sản phẩm (thao tác vắt 18.000 lần). Chỉ cần nhấn cây lau vào thùng giặt hoặc lồng vắt bạn sẽ dễ dàng giặt hoặc vắt khô bông lau.\u003c/p\u003e\n\u003ch5\u003eThông số kỹ thuật\u003c/h5\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cdiv class=\"text\"\u003eChiều dài thùng: 476 mm\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv class=\"text\"\u003eChiều rộng thùng : 270 mm\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv class=\"text\"\u003eChiều cao thùng: 270 mm\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv class=\"text\"\u003eTrọng lượng (g) thùng: 1520 gam\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv class=\"text\"\u003eTrọng lượng (g) tổng: 2100 gam\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv class=\"text\"\u003eKích thước lồng vắt: Ø200x90 mm\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv class=\"text\"\u003eCây lau: 3 đoạn inox - có thể điều chỉnh độ dài 950 -\u0026gt;1200 mm\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv class=\"text\"\u003eBông lau Microfiber: Kích thước bông: Ø330 mm/ Độ dài sợi: 40/85 mm\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv class=\"text\"\u003eChốt giặt: Nhựa POM + PP + thép mạ / Kích thước định vị: Ø27 mm\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv class=\"text\"\u003eĐầu chổi: Nhựa tổng hợp + POM    Ø164 mm/  Kích thước định vị  quay Ø27 mm\u003c/div\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/d0/f7/dc/b09394044aae16237b8759f402a7fdab.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d0/f7/dc/b09394044aae16237b8759f402a7fdab.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d0/f7/dc/b09394044aae16237b8759f402a7fdab.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d0/f7/dc/b09394044aae16237b8759f402a7fdab.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d0/f7/dc/b09394044aae16237b8759f402a