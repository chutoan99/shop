sha, đồng thời nhận giải thưởng danh giá Tezuka Osamu. \u003c/p\u003e \n  \u003cp class=\"text-justify\"\u003eBộ truyện dành cho tuổi 16+ \u003c/p\u003e\n \u003c/body\u003e\n\u003c/html\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/7a/18/11/d6d1057931599c901018e3032f9fb319.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/7a/18/11/d6d1057931599c901018e3032f9fb319.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/7a/18/11/d6d1057931599c901018e3032f9fb319.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7a/18/11/d6d1057931599c901018e3032f9fb319.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7a/18/11/d6d1057931599c901018e3032f9fb319.jpg"}],"warranty_policy":null,"authors":[{"id":7368347,"name":"Yamaguchi Tsubasa","slug":"yamaguchi-tsubasa"}],"current_seller":{"id":229023,"sku":"2491926594044","name":"Nhà Sách Phương Nam","link":"https://tiki.vn/cua-hang/nha-sach-phuong-nam","logo":"9b/48/13/34cc77f2e15c273a64bc5158e1354e4a.jpg","price":48000,"product_id":"275291240","store_id":216055,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Thông tin chung","attributes":[{"code":"publisher_vn","name":"Công ty phát hành","value":"NXB Trẻ"},{"code":"book_cover","name":"Loại bìa","value":"Bìa mềm"},{"code":"number_of_page","name":"Số trang","value":"192"},{"code":"manufacturer","name":"Nhà xuất bản","value":"NXB Trẻ"}]}],"product_links":[],"gift_item_title":"0 quà tặng kèm","services_and_promotions":[],"promitions":[],"stock_item":{"max_sale_qty":1000,"min_sale_qty"