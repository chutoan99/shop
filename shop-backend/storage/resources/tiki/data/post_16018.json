":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/b8/57/b3/2cb6c962a3d40273081ac9fcac8aa81b.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2323,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch5\u003e\u003ciframe src=\"//www.youtube.com/embed/h-dekE5uGDI\" width=\"750\" height=\"421\" allowfullscreen=\"allowfullscreen\"\u003e\u003c/iframe\u003e\u003c/h5\u003e\n\u003cp\u003e\u003ciframe src=\"//www.youtube.com/embed/K0woOt9yirA\" width=\"750\" height=\"421\" allowfullscreen=\"allowfullscreen\"\u003e\u003c/iframe\u003e\u003c/p\u003e\n\u003ch5\u003eKiểu dáng tiện lợi, thẩm mỹ\u003c/h5\u003e\n\u003cp\u003e\u003cstrong\u003eTripod Cho Điện Thoại Yunteng 5208\u003c/strong\u003e chân với thiết kế nhỏ gọn cứng cáp rất tiện dùng khi mang đi chơi, du lịch. Chân chụp hình điện thoại VCT 5208 được làm từ chất liệu hợp kim nhôm, kích thước thu gọn chân là 43cm và kéo dài tối đa lên tới 1.25m. Chân đế chụp hình cho điện thoại có thể tùy chỉnh cao thấp tùy ý, trọng lượng chân chỉ có 600gr và chịu tải tối đa khoảng 1.5kg nên có thể dùng cho mọi máy điện thoại và máy ảnh du lịch.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://vcdn.tikicdn.com/ts/tmp/c0/a6/42/c09b5c18772c99fd11001bc1da4b0f6f.jpg\" alt=\"Tripod Cho Điện Thoại Yunteng 5208 - Hàng Nhập Khẩu\" width=\"750\" height=\"537\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://vcdn.tikicdn.com/ts/tmp/7c/0d/84/309d32619a9fa7e83de3d09c36e3b177.jpg\" alt=\"Tripod Cho Điện Thoại Yunteng 5208 - Hàng Nhập Khẩu\" width=\"750\" height=\"473\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://vcdn.tikicdn.com/ts/tmp/af/f2/2d/9d791b8adfb9128f3511771522c7239e.jpg\" alt=\"Tripod Cho Điện Thoại Yunteng 5208 - Hàng Nhập Khẩu\" width=\"750\" height=\"516\" /\u003e\u003c/p\u003e\n\u003ch5\u003eChất liệu chắc chắn\u003c/h5\u003e\n\u003cp\u003eGậy được làm từ chất liệu nhựa ABS và nhựa PC, thân cây hợp kim nhôm. Phần tay cầm bằng nhựa dạng nhám cầm rất bám tay. Pin của gậy cũng được tích hợp ngay dưới phần tay cầm tiện dùng hơn.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://vcdn.tikicdn.com/ts/tmp/9e/6b/53/0565d3a14a3af247993c172ac9480417.jpg\" alt=\"Tripod Cho Điện Thoại Yunteng 5208 - Hàng Nhập Khẩu\" width=\"750\" height=\"936\" /\u003e\u003c/p\u003e\n\u003ch5\u003eCấu tạo hợp lý\u003c/h5\u003e\n\u003cp\u003eMẫu chân này là phiên bản nâng cấp của hàng từ chân đế Yunteng VCT 520, mọi chi tiết hình thức giống nhau. Điểm khác nhau duy nhất giữa hai chân là mẫu mới có trang bị thêm remote chụp hình từ xa qua Bluetooth. Remote dùng pin sạc mỗi lần sạc đầy có thể chụp được 700-800 tấm hình, thời gian sạc pin mất khoảng 45 phút. Có thể sạc với củ sạc điện thoại cổng usb máy tính, pin dự phòng.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://vcdn.tikicdn.com/ts/tmp/e6/ff/f6/c71cc595f128736e2b6f10f59c0eb585.jpg\" alt=\"Tripod Cho Điện Thoại Yunteng 5208 - Hàng Nhập Khẩu\" width=\"750\" height=\"457\" /\u003e\u003c/p\u003e\n\u003cp\u003eBộ chân đế chụp hình cho điện thoại có tặng kèm khung gắn điện thoại giữ máy chắc chắn, tương thích với các máy từ 3.5 cho tới 6.5 inch. Các điểm tiếp xúc với máy là cao su nên không làm gây trầy máy và tăng độ bám chắc chắn hơn.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://vcdn.tikicdn.com/ts/tmp/92/3a/91/89ad81bd2f7d02721e374db77c53e59a.jpg\" alt=\"Tripod Cho Điện Thoại Yunteng 5208 - Hàng Nhập Khẩu\" width=\"750\" height=\"293\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://vcdn.tikicdn.com/ts/tmp/29/5c/4b/eb9c0683d6159da42afb9ffea19a6772.jpg\" alt=\"Tripod Cho Điện Thoại Yunteng 5208 - Hàng Nhập Khẩu\" width=\"750\" height=\"568\" /\u003e\u003c/p\u003e\n\u003cp\u003eChân đế chụp hình cho mọi điện thoại cho phép tùy chỉnh lên xuống 180 độ, xoay ngang 360 độ, lật máy điện thoại ngang dọc tùy ý. Đế chân được làm từ nhựa ABS cho độ bám đất tốt.\u003c/p\u003e\n\u003ch5\u003ePhù hợp với nhiều dòng máy\u003c/h5\u003e\n\u003cp\u003eChân đê chụp ảnh điện thoại Yunteng VCT 5208 có sẵn nút chụp hình từ xa quá Bluetooth (remote) có thể dùng cho các máy điện thoại như iPhone, Samsung, HTC, LG, Lumia (Windows 10 mobile)….\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://vcdn.tikicdn.com/ts/tmp/68/6e/1a/2f78d180d514a3ebcda870ed9f324e30.jpg\" alt=\"Tripod Cho Điện Thoại Yunteng 5208 - Hàng Nhập Khẩu\" width=\"750\" height=\"526\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://vcdn.tikicdn.com/ts/tmp/53/4a/ef/eb59bcabda248e91e8f1c6c0285f146d.jpg\" alt=\"Tripod Cho Điện Thoại Yunteng 5208 - Hàng Nhập Khẩu\" width=\"750\" height=\"427\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/b8/57/b3/2cb6c962a3d40273081ac9fcac8aa81b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b8/57/b3/2cb6c962a3d40273081ac9fcac8aa81b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b8/57/b3/2cb6c962a3d40273081ac9fcac8aa81b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b8/57/b3/2cb6c962a3d40273081ac9fcac8aa