g và hiện đại, bản sắc và hội nhập, tạo nguồn lực nội sinh và huy động sức mạnh của văn hóa, con người Việt Nam trong công cuộc xây dựng, phát triển đất nước phồn vinh, thịnh vượng. \u003c/p\u003e\n\u003cp\u003eXin trân trọng giới thiệu cuốn sách với bạn đọc.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/a8/e0/f8/c42b9b4d68467c68632cdc6e084e94df.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a8/e0/f8/c42b9b4d68467c68632cdc6e084e94df.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a8/e0/f8/c42b9b4d68467c68632cdc6e084e94df.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a8/e0/f8/c42b9b4d68467c68632cdc6e084e94df.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a8/e0/f8/c42b9b4d68467c68632cdc6e084e94df.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/51/34/6e/41813d9691563a972f58a142fb5f91c1.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/51/34/6e/41813d9691563a972f58a142fb5f91c1.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/51/34/6e/41813d9691563a972f58a142fb5f91c1.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/51/34/6e/41813d9691563a972f58a142fb5f91c1.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/51/34/6e/41813d9691563a972f58a142fb5f91c1.jpg"}],"warranty_policy":null,"authors":[{"id":34114,"name":"GS.TS. Nguyễn Phú Trọng","slug":"gs-ts-nguyen-phu-trong"}],"current_seller":{"id":259784,"sku":"1500854354875","name":"Bảo Châu Books","link":"https://tiki.vn/cua-hang/ba