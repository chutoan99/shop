\u003cli\u003e\n\u003cp\u003eHỗ trợ 4 chế độ hút, bao gồm chế độ yên tĩnh với độ ồn cực thấp không ảnh hưởng đến sinh hoạt người dùng\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eSử dụng công nghệ điều hướng laser LDS tiên tiến\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eLập bản đồ nhanh chóng, lên kế hoạch đường đi chính xác\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg src=\"https://mitn.vn/image/catalog/robotc1011.png\" alt=\"robotc1011\" width=\"750\" height=\"750\" /\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://mitn.vn/image/catalog/robotc1012.png\" alt=\"robotc1012\" width=\"750\" height=\"750\" /\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://mitn.vn/image/catalog/robotc1013.png\" alt=\"robotc1013\" width=\"750\" height=\"750\" /\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://mitn.vn/image/catalog/robotc1014.png\" alt=\"robotc1014\" width=\"749\" height=\"829\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/33/75/97/3ba675f5e82f5c8491d54acb39bdde32.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/33/75/97/3ba675f5e82f5c8491d54acb39bdde32.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/33/75/97/3ba675f5e82f5c8491d54acb39bdde32.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/33/75/97/3ba675f5e82f5c8491d54acb39bdde32.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/33/75/97/3ba675f5e82f5c8491d54acb39bdde32.png"},{"base_url":"https://salt.tikicdn.com/ts/product/89/7e/6b/d2c00aba8d25db339634e4c94