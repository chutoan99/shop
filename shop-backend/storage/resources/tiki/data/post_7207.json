h động. Thế giới thông qua nhãn quan của các tác giả đầy hiện thực – có tốt, xấu, kỳ dị, và hơn hết là “siêu hài hước”.\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/50/b0/60/7f4044cdbb570806298a429058c0e684.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/50/b0/60/7f4044cdbb570806298a429058c0e684.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/50/b0/60/7f4044cdbb570806298a429058c0e684.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/50/b0/60/7f4044cdbb570806298a429058c0e684.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/50/b0/60/7f4044cdbb570806298a429058c0e684.png"},{"base_url":"https://salt.tikicdn.com/ts/product/de/09/55/792211ab398a2bc18589eb6f3a7fd19a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/de/09/55/792211ab398a2bc18589eb6f3a7fd19a.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/de/09/55/792211ab398a2bc18589eb6f3a7fd19a.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/de/09/55/792211ab398a2bc18589eb6f3a7fd19a.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/de/09/55/792211ab398a2bc18589eb6f3a7fd19a.jpg"}],"warranty_policy":null,"authors":[{"id":160625,"name":"Steven D.Levitt","slug":"steven-d-levitt"},{"id":13028,"name":"Stephen J. Dubner","slug":"stephen-j-dubner"}],"current_seller":{"id":145814,"sku":"6570793893560","name":"Omega Plus Books","link":"https://tiki.vn/cua-hang/omega-plus-books","logo":"8b/17/0b