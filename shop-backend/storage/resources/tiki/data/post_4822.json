u trực tiếp vào sản phẩm.\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/1d/10/b6/2a587a0ae082a86175987d17c1787087.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/1d/10/b6/2a587a0ae082a86175987d17c1787087.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/1d/10/b6/2a587a0ae082a86175987d17c1787087.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1d/10/b6/2a587a0ae082a86175987d17c1787087.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1d/10/b6/2a587a0ae082a86175987d17c1787087.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/58/47/29/f21c72fea98301235fbe64745e262328.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/58/47/29/f21c72fea98301235fbe64745e262328.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/58/47/29/f21c72fea98301235fbe64745e262328.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/58/47/29/f21c72fea98301235fbe64745e262328.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/58/47/29/f21c72fea98301235fbe64745e262328.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/7c/22/28/fff4e12313c05bfa269c833ff25ab9e0.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/7c/22/28/fff4e12313c05bfa269c833ff25ab9e0.jpg","medium_url":"htt