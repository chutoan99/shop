ull,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":true,"return_reason":"no_return"}},"discount":20000,"discount_rate":0,"rating_average":5,"review_count":3,"review_text":"(3)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/6b/a4/96/1317782203f702cc80ad8436e2d64247.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":797,"all_time_quantity_sold":9,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/95/01/b8/ce482ccfcfee413c401258ef882999aa.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/f7/28/93/922805c8b289ad0d2bd7b8b7dc83bf68.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/38/5f/27/819d3e24a8006f0213f3adbe0730c61a.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/24/22/1b/e9875ad70f0a1c3f381cab132d769963.png\" alt=\"\" width=\"750\" height=\"421\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ff/d6/9b/bba154217caae8a1e82b0d258fb6a1ca.png\" alt=\"\" width=\"750\" height=\"421\" /\u003e\u003c/p\u003e\n\u003ch5 style=\"text-align:justify;\"\u003ePhiên bản mới và màu xe mới hiện đại, tinh tế\u003c/h5\u003e\n\u003cp class=\"text-justify\" style=\"text-align:justify;\"\u003eFuture 125 FI bao gồm 03 phiên bản. Phiên bản đặc biệt hoàn toàn mới với vành đúc và 2 màu sắc: màu Đen và Xanh Đen mang lại vẻ trẻ trung và hiện đại. Ngoài ra, 2 phiên bản Cao cấp và Tiêu chuẩn được áp dụng cách phối màu mới trên các chi tiết nhựa từ yên xe, tay dắt sau, mặt ốp trong xe, yếm xe mang lại hình ảnh tổng thể mới mẻ và thu hút hơn cho xe Future 125 FI.\u003c/p\u003e\n\u003cp class=\"text-justify\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/2d/ff/4c/af5bf5ea0e0f3ff49c23d9b2412b1b19.png\" alt=\"\" width=\"650\" height=\"490\" /\u003e\u003c/p\u003e\n\u003ch5 style=\"text-align:justify;\"\u003eĐèn pha LED\u003c/h5\u003e\n\u003cp class=\"text-justify\" style=\"text-align:justify;\"\u003eCụm đèn pha với thiết kế nổi bật, được trang bị đèn LED có tuổi thọ cao, tiết kiệm năng lượng, với cường độ ánh sáng mạnh, giúp nâng cao khả năng quan sát khi đi vào ban đêm.\u003c/p\u003e\n\u003cp class=\"text-justify\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/d1/f2/c6/9c61bb7a91d3b22ef7571b1c5f9b48d7.png\" alt=\"\" width=\"650\" height=\"490\" /\u003e\u003c/p\u003e\n\u003ch5 style=\"text-align:justify;\"\u003eLogo Future 3D\u003c/h5\u003e\n\u003cp class=\"text-justify\" style=\"text-align:justify;\"\u003eLogo \"Future\" 3D cao cấp làm tăng thêm vẻ hiện đại và sang trọng cho xe.\u003c/p\u003e\n\u003cp class=\"text-justify\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/6f/8a/43/7f2369f98990e2fdd23055415591a1d2.png\" alt=\"\" width=\"650\" height=\"490\" /\u003e\u003c/p\u003e\n\u003ch5 style=\"text-align:justify;\"\u003eĐộng cơ - Công nghệ\u003c/h5\u003e\n\u003cp class=\"text-justify\" style=\"text-align:justify;\"\u003eFuture 125 FI được kế thừa động cơ 125cc danh tiếng của Honda, đầy mạnh mẽ với hiệu suất vượt trội mà vẫn đảm bảo khả năng tiết kiệm nhiên liệu một cách ấn tượng.\u003c/p\u003e\n\u003cp class=\"text-justify\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/e3/2c/6b/f3232ba5a8166d3d52dc3e60dc329528.png\" alt=\"\" width=\"650\" height=\"490\" /\u003e\u003c/p\u003e\n\u003ch5 style=\"text-align:justify;\"\u003eKhả năng tiết kiệm nhiên liệu\u003c/h5\u003e\n\u003cp class=\"text-justify\" style=\"text-align:justify;\"\u003eKhả năng tiết kiệm nhiên liệu vượt trội được kế thừa từ điểm mạnh của động cơ danh tiếng 125cc của Honda luôn là một trong những lý do lớn nhất khiến khách hàng lựa chọn Future 125 FI.\u003c/p\u003e\n\u003ch5 style=\"text-align:justify;\"\u003eĐèn chiếu sáng phía trước luôn sáng khi vận hành xe\u003c/h5\u003e\n\u003cp class=\"text-justify\" style=\"text-align:justify;\"\u003eĐảm bảo cho người điều khiển xe có tầm nhìn tốt nhất, hạn chế các trường hợp quên bật đèn pha khi đi trong điều kiện ánh sáng không đảm bảo, ngoài ra giúp tăng khả năng nhận diện của xe khi lưu thông trên đường phố.\u003c/p\u003e\n\u003cp class=\"text-justify\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/52/8d/f4/d751b6105a5646215093759e1092d479.png\" alt=\"\" width=\"650\" height=\"490\" /\u003e\u003c/p\u003e\n\u003ch5 style=\"text-align:justify;\"\u003eỔ khóa đa năng 4 trong 1\u003c/h5\u003e\n\u003cp class=\"text-justify\" style=\"text-align:justify;\"\u003eỔ khóa hiện đại 4 trong 1 bao gồm khóa điện, khóa từ, khóa cổ và khóa yên rất dễ sử dụng, an tâm và chống rỉ sét hiệu quả.\u003c/p\u003e\n\u003cp class=\"text-justify\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/18/b6/18/c4244b6840729a30c3cef03b407f3f03.png\" alt=\"\" width=\"650\" height=\"490\" /\u003e\u003c/p\u003e\n\u003ch5 style=\"text-align:justify;\"\u003eHộc dựng đồ\u003c/h5\u003e\n\u003cp class=\"text-justify\" style=\"text-align:justify;\"\u003eHộc đựng đồ lớn dễ dàng để vừa 1 mũ bảo hiểm cả đầu cùng vật dụng cá nhân khác.\u003c/p\u003e\n\u003cp class=\"text-justify\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/4e/51/63/b7bab5177fb2928d4885363b54d03cb5.jpg\" alt=\"\" width=\"576\" height=\"434\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/6b/a4/96/1317782203f702cc80ad8436e2d64247.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/6b/a4/96/1317782203f702cc80ad8436e2d64247.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/6b/a4/96/1317782203f702cc80ad8436e2d64247.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6b/a4/96/1317782203f702cc80ad8436e2d64247.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6b/a4/96/1317782203f702cc80ad8436e2d64247.png"}],"warranty_policy":null,"brand":{"id":152855,"name":"Honda","slug":"honda"},"current_seller":{"id":35638,"sku":"1435801548970","name":"Hệ thống HEAD Khánh An","link":"https://tiki.vn/cua-hang/he-thong-head-khanh-an","logo":"40/fd/6f/56fedb8b1842fc447a0c4076ca6c6cf8.jpg","price":36580000,"product_id":"190181375","store_id":34923,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Thông tin chung","attributes":[{"code":"brakes","name":"Phanh","value":"Đĩa"},{"code":"loai_chia_khoa","name":"Loại chìa khóa","value":"Khóa thường"},{"code":"origin_year","name":"Năm ra mắt","value":"2021"},{"code":"brand","name":"Thương hiệu","value":"Honda"},{"code":"brand_country","name":"Xuất xứ thương hiệu","value":"Nhật Bản"},{"code":"origin","name":"Xuất xứ (