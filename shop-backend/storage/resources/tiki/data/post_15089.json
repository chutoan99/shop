:5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/fb/b5/4c/c605822e05a6ff62ce23b32dc48720e6.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1813,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"margin: 0px 0px 40px; padding: 0px; box-sizing: border-box; outline: none; color: #3b3b3b; font-family: Arial; font-size: 13px;\"\u003e\u003cem style=\"margin: 0px; padding: 0px; box-sizing: border-box; outline: none;\"\u003eVới sự thành công của Marshall Woburn, hãng âm thanh danh tiếng Marshall đã cho ra mắt phiên bản nâng cấp thứ 2 với tên gọi \u003cspan style=\"margin: 0px; padding: 0px; box-sizing: border-box; outline: none; font-weight: bold;\"\u003eMarshall Woburn II \u003c/span\u003evào năm 2018. Ở thế hệ thứ 2 này, loa không chỉ có những cách tân về ngoại hình mà phần cứng bên trong cũng được cải tiến với chất lượng và tính năng nổi trội.\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"margin: 0px 0px 40px; padding: 0px; box-sizing: border-box; outline: none; color: #3b3b3b; font-family: Arial; font-size: 13px;\"\u003e\u003cem style=\"margin: 0px; padding: 0px; box-sizing: border-box; outline: none;\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/2a/8a/1a/9ab3e331859d5951a8f3c6ebff59f8cb.jpg\" alt=\"Loa Marshall Woburn 2 1\" width=\"750\" height=\"438\" /\u003e\u003cbr /\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cul style=\"margin: 0px 0px 20px; padding: 0px; box-sizing: border-box; outline: none; list-style: none outside none; color: #3b3b3b; font-family: Arial; font-size: 13px;\"\u003e\n\u003cli style=\"margin: 0px; padding: 0px; box-sizing: border-box; outline: none;\"\u003e\n\u003ch2 style=\"margin: 20px 0px 10px; padding: 0px; box-sizing: border-box; outline: none; font-weight: 500; line-height: 1.1; color: inherit; font-size: 30px;\"\u003e\u003cspan style=\"margin: 0px; padding: 0px; box-sizing: border-box; outline: none; font-weight: bold;\"\u003eThiết kế phong cách tân cổ điển\u003c/span\u003e\u003c/h2\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"margin: 0px 0px 40px; padding: 0px; box-sizing: border-box; outline: none; color: #3b3b3b; font-family: Arial; font-size: 13px;\"\u003eTuy có những sự khác biệt nhất định về ngoại hình, song, Woburn II vẫn giữ được nét cổ điển, phong trần của mình. Cũng như các thế hệ loa thứ II của hãng, Marshall Woburn 2 được thay đổi diện mạo với tấm écran mới. Bên cạnh đó, nằm trên mặt trước của loa còn được gắn thêm chi tiết lá đồng, trên có đó khắc năm thành lập của thương hiệu Marshall – năm 1962, khẳng định tên tuổi và di sản gần 60 năm của hãng.\u003c/p\u003e\n\u003cp style=\"margin: 0px 0px 40px; padding: 0px; box-sizing: border-box; outline: none; color: #3b3b3b; font-family: Arial; font-size: 13px;\"\u003eCác núm vặn cơ điều chỉnh âm thanh cũng có chút thay đổi. Cơ bản, loa chỉ giữ lại các nút điều chỉnh volume, bass và treble ở dạng núm vặn. Đối với núm chọn nguồn phát, nay đã được chuyển thành dạng nút bấm.\u003c/p\u003e\n\u003cp style=\"margin: 0px 0px 40px; padding: 0px; box-sizing: border-box; outline: none; color: #3b3b3b; font-family: Arial; font-size: 13px;\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/bd/9b/be/cf061d879b48412e7d08c27b54cf6393.jpg\" alt=\"Loa Marshall Woburn 2 2\" width=\"750\" height=\"570\" /\u003e\u003c/p\u003e\n\u003cul style=\"margin: 0px 0px 20px; padding: 0px; box-sizing: border-box; outline: none; list-style: none outside none; color: #3b3b3b; font-family: Arial; font-size: 13px;\"\u003e\n\u003cli style=\"margin: 0px; padding: 0px; box-sizing: border-box; outline: none;\"\u003e\n\u003ch2 style=\"margin: 20px 0px 10px; padding: 0px; box-sizing: border-box; outline: none; font-weight: 500; line-height: 1.1; color: inherit; font-size: 30px;\"\u003e\u003cspan style=\"margin: 0px; padding: 0px; box-sizing: border-box; outline: none; font-weight: bold;\"\u003eLoa Marshall Woburn 2 bluetooth– Lựa chọn âm thanh hoàn hảo\u003c/span\u003e\u003c/h2\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"margin: 0px 0px 40px; padding: 0px; box-sizing: border-box; outline: none; color: #3b3b3b; font-family: Arial; font-size: 13px;\"\u003e\u003cspan style=\"margin: 0px; padding: 0px; box-sizing: border-box; outline: none;\"\u003eWoburn vốn được mệnh danh là chiếc loa bluetooth khủng nhất của Marshall. Đi đôi với vẻ ngoài khá ngoại cỡ đối với một chiếc loa di động là một sức mạnh âm thanh sống động và rõ nét. Ở phiên bản thứ 2, Woburn được nhà sản xuất nâng cấp bộ xử lý âm thanh với\u003c/span\u003e\u003cspan style=\"margin: 0px; padding: 0px; box-sizing: border-box; outline: none;\"\u003e 2 loa tweeter 1 inch và loa trầm đôi 5.25 inch được cấp riêng bởi amplifier class D. Việc thiết kế thêm chất liệu gỗ cũng giúp âm thanh được tự nhiên, ấm áp và hệ thống phản xạ âm bass một cổng giúp tăng hiệu quả ở tần số thấp\u003c/span\u003e\u003cspan style=\"margin: 0px; padding: 0px; box-sizing: border-box; outline: none;\"\u003e.\u003c/span\u003e\u003c/p\u003e\n\u003cul style=\"margin: 0px 0px 20px; padding: 0px; box-sizing: border-box; outline: none; list-style: none outside none; color: #3b3b3b; font-family: Arial; font-size: 13px;\"\u003e\n\u003cli style=\"margin: 0px; padding: 0px; box-sizing: border-box; outline: none;\"\u003e\n\u003ch2 style=\"margin: 20px 0px 10px; padding: 0px; box-sizing: border-box; outline: none; font-weight: 500; line-height: 1.1; color: inherit; font-size: 30px;\"\u003e\u003cspan style=\"margin: 0px; padding: 0px; box-sizing: border-box; outline: none; font-weight: bold;\"\u003eKết nối Bluetooth 5.0 aptX\u003c/span\u003e\u003c/h2\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"margin: 0px 0px 40px; padding: 0px; box-sizing: border-box; outline: none; color: #3b3b3b; font-family: Arial; font-size: 13px;\"\u003e\u003cspan style=\"margin: 0px; padding: 0px; box-sizing: border-box; outline: none;\"\u003eBên cạnh các kết nối không dây Chromecast tích hợp, Spotify Connect, AirPlay, Bluetooth và Wi-Fi WPA, 802.11b/g/n/ac, 2.4 GHz/5 GHz, Marshall Woburn còn được cải tiến với công nghệ Bluetooth 5.0 aptX. Với công nghệ mới này, Woburn II có khả năng hoạt động ở phạm vi tối đa hơn 9m (30 feet), giúp bạn dễ dàng kết nối với các thiết bị thông minh và đảm bảo âm thanh được truyền tải một cách chi tiết, đầy đặn nhất.\u003c/span\u003e\u003c/p\u003e\n\u003cfigure id=\"attachment_3168\" class=\"wp-caption aligncenter\" style=\"margin: 0.4em auto 1.2em; padding: 0px; box-sizing: border-box; outline: none; max-width: 100%; height: auto; clear: both; color: #3b3b3b; font-family: Arial; font-size: 13px; width: 741px;\" aria-describedby=\"caption-attachment-3168\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/22/41/fb/436c89c7c65ab0fac1e44d3a22f82e76.jpg\" alt=\"Loa Marshall Woburn 2 3\" width=\"750\" height=\"611\" /\u003e\u003c/figure\u003e\n\u003cp style=\"margin: 0px 0px 40px; padding: 0px; box-sizing: border-box; outline: none; color: #3b3b3b; font-family: Arial; font-size: 13px;\"\u003eNgoài ra, loa cũng được bổ sung tính năng Multi-host, giúp bạn dễ dàng chuyển đổi giữa 2 thiết bị bluetooth khác nhau và vẫn hỗ trợ cổng AUX 3.5mm và RCA, đảm bảo tương thích với mọi thiết bị giải trí hiện nay.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e"