":"pdp_badge","code":"is_hero","type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"freeship_xtra","type":"pdp_icon_badge","index":2,"icon":"https://salt.tikicdn.com/ts/upload/be/67/48/04a82ab8df178e1a13bde38316081865.png","icon_width":91,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":true,"return_reason":"any_reason"}},"discount":20997,"discount_rate":5,"rating_average":4.3,"review_count":12,"review_text":"(12)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/45/6b/a1/b0fc74ceac63700935d4727f7595564a.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":820,"all_time_quantity_sold":754,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cdiv class=\"tongQuan gStyle3 menuViewHightLight\"\u003e\n\u003cdiv class=\"description\"\u003eĂn lẩu tại gia ngày càng trở nên quen thuộc với các gia đình Việt. Không những đổi vị bữa cơm gia đình, quây quần bên nồi lẩu còn là khoảng thời gian vàng để các thành viên thêm gắn kết. Thấu hiểu được nhu cầu đó, SUNHOUSE cho ra đời \u003cstrong\u003eNồi lẩu điện SUNHOUSE SHD4523\u003c/strong\u003e với thiết kế trang nhã và công suất nấu mạnh mẽ, chế biến được nhiều loại thức ăn khác nhau, sử dụng đơn giản, tiện dụng hơn cho công việc nội trợ.\u003cbr /\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/7e/91/4d/f92fedc96498b1e2536927c955ec3efb.jpeg\" alt=\"image-20211109091130-1.jpeg\" /\u003e\u003cbr /\u003e\u003cbr /\u003e \u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"thietKe gStyle3 menuViewHightLight\"\u003e\n\u003cdiv class=\"description\"\u003e\u003cstrong\u003eKIỂU DÁNG TRANG NHÃ, GỌN NHẸ, DỄ SỬ DỤNG\u003c/strong\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eThiết kế \u003c/strong\u003e\u003cstrong\u003ehiện đại, gọn nhẹ\u003c/strong\u003e\u003c/li\u003e\n\u003c/ul\u003e\nNồi lẩu điện SUNHOUSE SHD4523 có thân nồi làm từ chất liệu tôn sơn tĩnh điện, có khả năng chịu nhiệt cao và ít bị ảnh hưởng bởi môi trường. Đây cũng là chất liệu không bong tróc, dễ dàng vệ sinh, tiết kiệm thời gian cho người sử dụng. Màu đen xám trang nhã, hiện đại, làm tôn lên vẻ đẹp cho căn bếp của gia đình bạn.\u003cbr /\u003e\u003cbr /\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/96/0f/b4/879692b3d65ff6be7cd247bfd48a26ed.jpeg\" alt=\"image-20211109091152-2.jpeg\" /\u003e\u003cbr /\u003eVung nồi được làm bằng thủy tinh chịu nhiệt, chất liệu trong suốt giúp quan sát được thức ăn bên trong nồi khi chế biến mà không cần mở vung, vô cùng tiện lợi. Núm vung, tay cầm bằng nhựa cao cấp, chịu nhiệt siêu bền giúp việc mở nắp và di chuyển dễ dàng và an toàn.\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eLòng nồi chống dính cao cấp\u003c/strong\u003e\u003c/li\u003e\n\u003c/ul\u003e\nLòng nồi được làm từ hợp kim nhôm dày giúp giữ nhiệt lâu hơn. Không những thế, lòng nồi còn được tráng một lớp chống dính cao cấp siêu bền, an toàn cho sức khỏe, không làm phát sinh chất độc hại khi tiếp xúc dưới nhiệt độ cao, tránh bám dính thức ăn và dễ dàng vệ sinh sau khi sử dụng.\u003cbr /\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/3c/fa/0d/6aa77488f1056a5a96bd8db2f5e0df69.jpeg\" alt=\"image-20211109091152-3.jpeg\" /\u003e\u003cul\u003e\u003cli\u003e\u003cstrong\u003eĐiều khiển bằng thanh gạt dễ sử dụng\u003c/strong\u003e\u003c/li\u003e\n\u003c/ul\u003e\nNồi có nhiều mức nhiệt phù hợp với chức năng và mục đích nấu nướng khác nhau, được điều chỉnh bằng thanh gạt đơn giản.\u003cbr /\u003e \u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"congNang gStyle3 menuViewHightLight\"\u003e\n\u003cdiv class=\"description\"\u003e\u003cstrong\u003eNẤU ĂN NGON HƠN, TIỆN LỢI VÀ NHANH CHÓNG HƠN\u003c/strong\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eNồi lẩu đa chức năng\u003c/strong\u003e\u003c/li\u003e\n\u003c/ul\u003e\nDung tích nồi lớn 3.5 lít phù hợp cho cả gia đình 2 – 4 người trong những buổi liên hoan, họp mặt. Không chỉ nấu lẩu, nồi còn có thể dùng để xào, rán, hầm… rất tiện dụng. Nồi có thể thay thế bếp gas tiện lợi, tiết kiệm năng lượng.\u003cbr /\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/21/41/17/c81e2f97c9a71131d720ad5706f492f0.jpeg\" alt=\"image-20211109091221-4.jpeg\" /\u003e\u003cul\u003e\u003cli\u003e\u003cstrong\u003eCông suất lớn, nấu chín nhanh\u003c/strong\u003e\u003c/li\u003e\n\u003c/ul\u003e\nLẩu điện có một mâm nhiệt lớn giúp truyền nhiệt nhanh và đều, cùng công suất cao 1300W giúp nấu chín thức ăn nhanh chóng, tiết kiệm thời gian nấu nướng.\u003cbr /\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/e7/55/b9/0e0b30a5bfc845ce2a299fb58e0dd595.jpeg\" alt=\"image-20211109091221-5.jpeg\" /\u003e\u003cul\u003e\u003cli\u003e\u003cstrong\u003eDễ dàng vệ sinh\u003c/strong\u003e\u003c/li\u003e\n\u003c/ul\u003e\nCác bộ phận nồi có thể dễ dàng tháo lắp nên việc vệ sinh, lau chùi rất đơn giản và nhẹ nhàng.\u003cbr /\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/21/ba/9a/4b0be22d56d36e9e82ba3039c53f551c.jpeg\" alt=\"image-20211109091221-6.jpeg\" /\u003e\u003c/div\u003e\n\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/45/6b/a1/b0fc74ceac63700935d4727f7595564a.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/45/6b/a1/b0fc74ceac63700935d4727f7595564a.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/45/6b/a1/b0fc74ceac63700935d4727f7595564a.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/45/6b/a1/b0fc74ceac63700935d4727f7595564a.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/45/6b/a1/b0fc74ceac63700935d4727f7595564a.png"},{"base_url":"https://salt.tikicdn.com/ts/product/04/25/eb/311afa149b01ca3844487dc9043b4069.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/04/25/eb/311afa149b01ca3844487dc9043b4069.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/04/25/eb/311afa149b01ca3844487dc9043b4069.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/04/25/eb/311afa149b01ca3844487dc9043b4069.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/04/25/eb/311afa149b01ca3844487dc9043b4069.png"},{"base_url":"https://salt.tikicdn.com/ts/product/9f/02/48/c79244c1abfd176ff2d22e0bcb9f9832.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/9f/02/48/c79244c1abfd176ff2d22e0bcb9f9832.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/9f/02/48/c792