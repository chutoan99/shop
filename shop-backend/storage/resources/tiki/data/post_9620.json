tic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ce/f2/29/38d011366bac0d64644b0f27a11fa96c.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":673,"all_time_quantity_sold":14,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cdiv class=\"jsx-1357106482 thread-cover\"\u003e\u003cimg class=\"aligncenter size-full wp-image-39653 lazyloaded\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/03/00/c7/bcf80b116da2847fb66d62043bca1587.jpg\" width=\"1280\" height=\"791\" /\u003e\u003c/div\u003e\n\u003cdiv class=\"jsx-1357106482\"\u003e \u003c/div\u003e\n\u003cdiv class=\"jsx-1357106482\"\u003e\n\n\u003cdiv class=\"jsx-1357106482\"\u003e\n\u003cblockquote class=\"jsx-1357106482\"\u003e\n\u003cdiv class=\"jsx-3299783595\"\u003e\n\u003cdiv class=\"jsx-3299783595 xfBody big \"\u003e\n\u003cp\u003e\u003cstrong\u003eCamera Bullet 2C\u003c/strong\u003e là một trong những sản phẩm mới nhất trong các mẫu sản phẩm của Imou năm 2020. Dòng Bullet nói chung và sản phẩm Bullet 2C nói riêng được thiết kế chuyên dụng cho việc bảo đảm an ninh tại những hộ gia đình, chuỗi cửa hàng, văn phòng vừa và nhỏ. Đặc điểm nổi bật của Bullet 2C so với những đối thủ cùng phân khúc là cảm biến thu nhận hình ảnh sắc nét, hỗ trợ định dạng file H.265 tiết kiệm dung lượng bộ nhớ, thiết kế đạt chuẩn IP67 chống chịu thời tiết tốt, phù hợp cho một chiếc camera ngoài trời.\u003c/p\u003e\n\u003cdiv\u003e\u003cem\u003e\u003cspan class=\"bdImage_attachImage\"\u003e\u003cspan class=\"inner\"\u003e\u003cimg class=\"aligncenter size-full wp-image-39654 lazyloaded\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/87/3a/c1/daa2dab362643d57bb5a7f142bb63116.jpg\" alt=\"Bullet 2C-05.jpg\" width=\"1280\" height=\"1279\" /\u003e\u003c/span\u003e\u003c/span\u003e\u003cbr /\u003eBullet 2C một trong những sản phẩm mới trong mẫu sản phẩm của Imou năm 2020\u003c/em\u003e\u003cbr /\u003e​\u003c/div\u003e\n\u003cp\u003e\u003cstrong\u003eNhững tính năng chính của Bullet 2C:\u003c/strong\u003e\u003c/p\u003e\n\u003cdiv\u003e• Thu hình với độ phân giải full HD 1080p.\u003cbr /\u003e• Bảo mật tuyệt đối 24/7 nhờ công nghệ IR tiên tiến.\u003cbr /\u003e• Tích hợp AI nhận diện con người.\u003cbr /\u003e• Hỗ trợ chuẩn nén file H.265 tiết kiệm dung lượng bộ nhớ.\u003cbr /\u003e• Tích hợp mic công nghệ cao cho khả năng thu âm trong trẻo.\u003cbr /\u003e• Khả năng lưu trữ đa dạng bao gồm thẻ nhớ, lưu trữ đám mây và đầu ghi hình.\u003cbr /\u003e• Thông báo thời gian thực giúp bạn cập nhật thông tin nhanh nhất.\u003cbr /\u003e• Đạt chuẩn IP67 cho khả năng chống chịu thời tiết tốt.​\u003c/div\u003e\n\u003cdiv\u003e\n\u003cp\u003eChất lượng hình ảnh của Bullet 2C tự tin với độ phân giải full HD, đem lại những chi tiết sắc nét nhất, thậm chí vào cả ban đêm. Với cảm biến ánh sáng vô cùng nhạy được trang bị trong Bullet 2C, việc chuyển đổi từ cảm biến hình ảnh thường cho ban ngày sang cảm biến hồng ngoại trong giây lát mà vẫn giữ được độ chi tiết và sắc nét, hứa hẹn một sự an tâm 24/7 cho người sử dụng.\u003c/p\u003e\n\u003cp\u003eĐiểm tối ưu hơn của Bullet 2C so với các đối thủ cạnh tranh là định dạng nén file H.265, một loại định dạng nén mới hơn so với dạng H.264 phổ thông trên các camera an ninh hiện giờ. H.265 đem đến cho người dùng dung lượng giảm đi đáng kể, lên đến 50% so với chuẩn H.264 cũ mà vẫn giữ toàn vẹn được chất lượng của camera. Imou tự tin rằng người dùng sử dụng Bullet 2C sẽ không còn phải lo lắng đến vấn đề lưu trữ các hình ảnh được nhiều hay ít nữa.\u003c/p\u003e\n\u003cp\u003eTích hợp nhiều công nghệ và chức năng, song Bullet 2C vẫn giữ được sự thân thiện với người dùng về mặt điều khiển và thao tác mà đàn anh tiền nhiệm đã làm rất tốt. Không chỉ vậy, khả năng kết nối mạng cũng được cải thiện với 2 ăng-ten giảm thiểu tối đa sự nhiễu sóng cũng như sự ngắt quãng trong việc ghi lại hình ảnh, thứ gây phiền toái đối với các sản phẩm công nghệ không dây nói chung.\u003c/p\u003e\n\u003cp\u003eVề mặt thiết kế của sản phẩm, Imou công bố rằng Bullet 2C đạt chuẩn IP67, với khả năng kháng bụi và chống thấm nước. Những điều kiện thời tiết ngoài trời sẽ không gây khó dễ được cho Bullet 2C trong quá trình hoạt động.\u003c/p\u003e\n\u003cdiv\u003e\u003cem\u003e\u003cspan class=\"bdImage_attachImage\"\u003e\u003cspan class=\"inner\"\u003e\u003cimg class=\"aligncenter size-full wp-image-39655 lazyloaded\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/9e/38/69/65f1a97c9ec46582396abd76350b507b.jpg\" alt=\"Bullet 2C-02.jpg\" width=\"1280\" height=\"1279\" /\u003e\u003c/span\u003e\u003c/span\u003e\u003cbr /\u003eKhả năng kháng bụi và chống thấm nước chuẩn IP67\u003c/em\u003e​\u003c/div\u003e\n\u003cp\u003eKhả năng kết nối internet mạnh mẽ, Bullet 2C luôn thông báo những cảnh báo sớm nhất có thể ngay khi nhận diện được những hiện tượng bất thường xảy ra trong quá trình hoạt động của camera, luôn giữ sự bảo mật cao độ cho dù bạn có đang ở đâu đi chăng nữa.\u003c/p\u003e\n\u003cp\u003eBảo mật của Bullet 2C không chỉ ở camera mà còn ở lưu trữ dữ liệu. Mọi dữ liệu hình ảnh thu về đều được mã hóa và có mật khẩu bảo mật chặt chẽ, chỉ được mở xác nhận qua tài khoản của chủ dùng. Việc này bảo đảm sự an toàn tuyệt đối về thông tin cho người dùng.\u003c/p\u003e\n\u003cp\u003e\u003cspan class=\"bdImage_attachImage\"\u003e\u003cspan class=\"inner\"\u003e\u003cimg class=\"aligncenter size-full wp-image-39653 lazyloaded\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/03/00/c7/bcf80b116da2847fb66d62043bca1587.jpg\" width=\"1280\" height=\"791\" /\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cdiv\u003e\u003cem\u003eMọi dữ liệu hình ảnh thu về đều được mã hóa và có mật khẩu bảo mật chặt chẽ\u003c/em\u003e​\u003c/div\u003e\n\u003cp\u003eBullet 2C còn được thiết lập với sự kết nối đồng bộ 4 camera qua Wi-Fi, với việc cài đặt đơn giản, độ bao phủ tốt, mỗi chiếc camera có thể cách xa nhau 100m mà vẫn có thể đồng bộ dễ dàng thông qua sóng Wi-Fi, tăng đáng kể độ bao quát cho người dùng khi phải quản lý an ninh ở một nơi rộng hoặc nhiều góc khuất.\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/blockquote\u003e\n\u003c/div\u003e\n\n\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ce/f2/29/38d011366bac0d64644b0f27a11fa96c.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ce/f2/29/38d011366bac0d64644b0f27a11fa96c.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ce/f2/29/38d011366bac0d64644b0f27a11fa96c.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ce/f2/29/38d011366bac0d64644b0f27a11fa96c.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ce/f2/29/38d011366bac0d64644b0f27a11fa96c.jpg"}],"warranty_policy":null,"brand":{"id":416097,"name":"IMOU","slug":"imou"},"current_seller":{"id":283233,"sku":"1610744195468","name":"HÀ NỘI DIGITAL SHOP","link":"https://tiki.vn/cua-hang/ha-noi-digital-shop","