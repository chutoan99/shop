alse,"is_hero":false,"return_reason":"any_reason"}},"discount":1932000,"discount_rate":15,"rating_average":4,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/da/df/69/6f8dc464e2f1564b2c476954b8027fd1.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":804,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cdiv\u003e\u003cstrong\u003eLò vi sóng âm tủ Ecalite EMW-2560JS\u003c/strong\u003e thiết kế lắp âm hiện đại, dung tích 25L đáp ứng tốt cho nhu cầu sử dụng của gia đình 2-4 thành viên. Nhờ được tích hợp đa dạng chức năng nấu, hâm nóng, rã đông, nướng, lò EMW-2560JS sẽ là lựa chọn đáng cân nhắc cho người nội trợ, giúp việc nấu ăn hằng ngày trở nên dễ dàng và tiện lợi hơn.\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ba/63/f4/c8684245afa2a83aedc641802424bed0.png\" alt=\"Lò vi sóng âm tủ Ecalite EMW-2560JS âm tủ 25l\" width=\"750\" height=\"392\" /\u003e\u003c/div\u003e\n\u003cdiv\u003e\n\u003ch2\u003e\u003cspan style=\"color:#3366ff;\"\u003eThiết kế màu inox sang trọng, lắp âm tủ cực gọn\u003c/span\u003e\u003c/h2\u003e\n\u003cdiv\u003eTổng thể \u003cstrong\u003elò EMW-2560JS\u003c/strong\u003e được hãng Ecalite hoàn thiện tỉ mỉ bằng chất liệu inox phối kính đen, mang lại điểm nhấn độc đáo cho không gian bếp. Ưu điểm của chất liệu này giúp lò vi sóng Ecalite có khả năng chống bám vân tay tốt, ít bám bẩn và dễ vệ sinh.\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv\u003eVề phương thức lắp đặt, lò được lắp âm tủ cực gọn giúp bạn tối ưu diện tích bếp hơn đồng thời đem đến sự hiện đại cho căn bếp. Bên cạnh đó, thiết kế lắp âm của lò cũng dễ dàng kết hợp với các mẫu lò nướng của Ecalite để tạo nên combo sản phẩm hoàn hảo.\u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e \u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/a4/2e/43/5d890badd3dc917494a074438ae260f3.png\" alt=\"Lò vi sóng âm tủ Ecalite EMW-2560JS thiết kế lắp âm\" width=\"750\" height=\"392\" /\u003e\u003cbr /\u003e\u003cem\u003eLò vi sóng Ecalite EMW-2560JS lắp âm tủ sang trọng\u003c/em\u003e\u003c/div\u003e\n\u003cdiv\u003e\n\u003ch2\u003e\u003cspan style=\"color:#3366ff;\"\u003eDung tích lò 25L thoải mái sử dụng cho gia đình 2-4 thành viên\u003c/span\u003e\u003c/h2\u003e\n\u003cdiv\u003eKhoang lò EMW-2560JS có dung tích là 25L giúp bạn có thể nấu, hâm hoặc nướng khối lượng lớn thực phẩm mà không cần chia nhỏ nhiều lần. Dung tích của lò vi sóng âm tủ Ecalite này có thể  đáp ứng tốt cho gia đình từ 2-4 thành viên.\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/f2/e3/57/c4c832d2bf881734b94b42020c9fe109.png\" alt=\"lò vi sóng Ecalite EMW-2560JS dung tích 25 lít\" width=\"750\" height=\"392\" /\u003e\u003cbr /\u003e\u003cem\u003eDung tích lò vi sóng 25L\u003c/em\u003e\u003c/div\u003e\n\u003cdiv\u003e\n\u003ch2\u003e\u003cspan style=\"color:#3366ff;\"\u003eBảng điều khiển phím nhấn, núm xoay và màn hình hiển thị LED dễ quan sát\u003c/span\u003e\u003c/h2\u003e\n\u003cdiv\u003eLò Ecalite EWM-2560JS 25L sử dụng hệ thống bảng điều khiển bằng tiếng Anh, bao gồm phím bấm, núm xoay với các ký hiệu rất dễ hiểu. Bên cạnh đó, phía trên cùng còn được trang bị màn hình LED hiển thị rõ ràng các thông số như thời gian, chức năng, khối lượng, giúp bạn dễ dàng quan sát hơn. Với bảng điều khiển này, các thành viên trong gia đình ai cũng có thể làm quen và thao tác nhanh chóng.\u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e \u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/60/d4/44/a672d958b022d3a434fa32e606b3feab.png\" alt=\"bảng điều khiển lò vi sóng Ecalite EMW-2560JS\" width=\"750\" height=\"392\" /\u003e\u003cbr /\u003e\u003cem\u003eBảng điều khiển của lò vi sóng EMW-2560JS dễ sử dụng\u003c/em\u003e\u003c/div\u003e\n\u003cdiv\u003e\n\u003ch2\u003e\u003cspan style=\"color:#3366ff;\"\u003eCông suất cao tiết kiệm thời gian đun nấu\u003c/span\u003e\u003c/h2\u003e\n\u003cdiv\u003eLò vi sóng Ecalite này có công suất vi sóng là 900W, công suất nướng là 1000W mang lại hiệu suất nấu nướng cao, tiết kiệm thời gian mà vẫn đảm bảo món ăn luôn đạt được hương vị thơm ngon. Song song đó, điện năng tiêu thụ cũng sẽ được tối ưu hơn trong quá trình nấu nướng.\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/3c/16/0b/77f213df10109e444aff5c209b7a1a79.png\" alt=\"công suất lò vi sóng kết hợp nướng ecalite emw-2560js\" width=\"750\" height=\"392\" /\u003e\u003cbr /\u003e\u003cem\u003eCông suất lò vi ba Ecalite EMW-2560JS\u003c/em\u003e\u003c/div\u003e\n\u003cdiv\u003e\n\u003ch2\u003e\u003cspan style=\"color:#3366ff;\"\u003eLò Ecalite EMW-2560JS có đa dạng chức năng đáp ứng tốt nhu cầu sử dụng\u003c/span\u003e\u003c/h2\u003e\n\u003cdiv\u003eNhằm mang đến sự tiện lợi khi sử dụng, lò vi sóng 25L EMW-2560JS được trang bị đầy đủ các chức năng cần thiết trong việc chế biến thực phẩm hằng ngày, bao gồm chức năng vi sóng (hâm nóng, rã đông, nấu), nướng, nướng kết hợp vi sóng và 7 chương trình tự động. Cụ thể như sau:\u003c/div\u003e\n\u003cdiv\u003e\n\u003cul\u003e\u003cli\u003e5 mức vi sóng dễ dàng tùy chỉnh để phù hợp với tình trạng thực phẩm: P10, P30, P50, P80, P100 tương ứng 10%, 30%, 50%, 80% và 100% mức vi sóng.\u003c/li\u003e\n\u003cli\u003e2 chương trình rã đông: rã đông theo khối lượng thực phẩm( dEF1) từ 100g - 2kg và rã đông theo thời gian (dEF2) tối đa 95 phút.\u003c/li\u003e\n\u003cli\u003e3 chương trình nướng: Nướng-Grill (0% vi sóng; 100% nướng); Nướng kết hợp vi sóng-C1 (55% vi sóng - 45% nướng), Nướng kết hợp vi sóng-C2 (36% vi sóng - 64% nướng).\u003c/li\u003e\n\u003c/ul\u003e\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/7d/2f/91/fddf2cf2b32cc3db24efc10021a72d7b.png\" alt=\"lò vi sóng emw-256-js có đa chức năng\" width=\"750\" height=\"392\" /\u003e\u003cbr /\u003e\u003cem\u003eCác chức năng có trên lò EMW-2560JS của Ecalite\u003c/em\u003e\u003c/p\u003e\n\u003ch2\u003e\u003cspan style=\"color:#3366ff;\"\u003eCài đặt hẹn giờ nấu lên đến 95 phút, kiểm soát thời gian hiệu quả\u003c/span\u003e\u003c/h2\u003e\n\u003cdiv\u003eChức năng này phù hợp khi nấu nướng các món cần có độ chính xác về thời gian để đạt được hương vị bạn mong muốn, hoặc những người nội trợ bận rộn và hay quên. Bạn có thể điều chỉnh cài hẹn giờ nấu lên đến 95 phút, khi kết thúc thời gian cài đặt lò sẽ có chuông báo và tự động ngưng hoạt động rất tiện lợi.\u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e \u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/f2/a7/28/c58d285a6857d5352471d23a618a446b.png\" alt=\"hẹn giờ trên lò vi sóng emw-2560js của ecalite\" width=\"750\" height=\"392\" /\u003e\u003cbr /\u003e\u003cem\u003ePhím bấm cài đặt giờ nấu có chuông báo trên lò vi sóng Ecalite\u003c/em\u003e\u003c/div\u003e\n\u003cdiv\u003e\n\u003ch2\u003e\u003cspan style=\"color:#3366ff;\"\u003eSử dụng an toàn hơn với chức năng khóa an toàn cho trẻ em \u003c/span\u003e\u003c/h2\u003e\n\u003cdiv\u003eChỉ cần nhấn nút Stop/Clear và giữ khoảng 3 giây, bạn đã có thể kích hoạt chức năng khóa an toàn nhanh chóng. Khi đó, hệ thống bảng điều khiển sẽ không còn nhận diện thao tác nữa nên đảm bảo an toàn cho gia đình có trẻ nhỏ vô tình chạm vào sử dụng lò.\u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/a9/4f/8c/16be57ddbb3deb501b773b83f36e054e.png\" alt=\"lò vi ba ecalite emw-2560js có khoá trẻ em\" width=\"750\" height=\"392\" /\u003e\u003cbr /\u003e\u003cem\u003eMàn hình hiển thị chức năng khóa an toàn\u003c/em\u003e\u003c/div\u003e\n\u003cdiv\u003e\n\u003ch2\u003e\u003cspan style=\"color:#3366ff;\"\u003eKhoang lò chất liệu thép không gỉ dễ dàng vệ sinh \u003c/span\u003e\u003c/h2\u003e\n\u003cdiv\u003eNhờ có bề mặt đồng nhất, hoàn thiện từ chất liệu thép không gỉ nên bạn có thể vệ sinh lò cực dễ chỉ bằng khăn ẩm sau mỗi lần sử dụng. Chất liệu này cũng giúp lò có khả năng chịu nhiệt tốt, độ bền cao sử dụng được lâu dài.\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/e2/06/1b/615ffcee6a31ca613c9c644c4ec1c85d.png\" alt=\"khoang lò bằng thép không gỉ\" width=\"750\" height=\"392\" /\u003e\u003c/div\u003e\n\u003cdiv\u003e\n\u003ch2\u003e\u003cspan style=\"color:#3366ff;\"\u003eĐèn trong khoang lò sáng, thuận tiện quan sát thực phẩm từ bên ngoài\u003c/span\u003e\u003c/h2\u003e\n\u003cdiv\u003eVới đèn được bố trí bên trong khoang lò, bạn có thể quan sát tình trạng thức ăn bên trong khi lò đang hoạt động mà không cần phải đóng/mở lò nhiều lần để kiểm tra. Đây cũng là ưu điểm lớn trong phần hoàn thiện tính năng của lò vi sóng âm tủ Ecalite EMW-2560JS. \u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/54/d0/24/3fdb9a45946ce6aec9251f16179aefe0.png\" alt=\"đèn trong khoang lò\" width=\"750\" height=\"392\" /\u003e\u003cbr /\u003e\u003cem\u003eĐèn chiếu sáng bên trong khoang lò\u003c/em\u003e\u003c/div\u003e\n\u003cdiv\u003e\n\u003ch2\u003e\u003cspan style=\"color:#3366ff;\"\u003ePhụ kiện đi kèm tiện dụng\u003c/span\u003e\u003c/h2\u003e\n\u003cdiv\u003eLò vi sóng Ecalite âm tủ bao gồm các phụ kiện là đĩa xoay và vỉ nướng. Trong đó, đĩa xoay với khả năng xoay 360 độ sẽ giúp thức ăn chín đều mọi mặt hơn, còn vỉ nướng sẽ giúp khi chế biến các món nướng một cách tiện lợi. Khi không cần sử dụng, bạn có thể lấy vỉ nướng ra để lò có diện tích rộng rãi hơn.\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/32/8c/7d/1b6eeccd6b6250e9fc42f7fab25d2792.png\" alt=\"phụ kiện của lò vi sóng ecalite emw-1560js\" width=\"750\" height=\"392\" /\u003e\u003c/div\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\u003cem\u003ePhụ kiện vỉ nướng tiện lợi\u003c/em\u003e\u003c/div\u003e\n\u003cdiv\u003e\n\u003ch2\u003e\u003cspan style=\"color:#3366ff;\"\u003eThông số kỹ thuật của lò vi sóng Ecalite EMW-2560JS\u003c/span\u003e\u003c/h2\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cspan style=\"color:#3366ff;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/e9/4a/ff/1be8798a2dc47054df0175c49e30d890.png\" alt=\"thông số kỹ thuật lò vi sóng ecalite emw-1560js\" width=\"750\" height=\"392\" /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003ch2\u003e\u003cspan style=\"color:#3366ff;\"\u003eChính sách bảo hành lò vi sóng 25L Ecalite EMW-1560JS\u003c/span\u003e\u003c/h2\u003e\n\u003cp\u003e\u003cspan style=\"color:#000000;\"\u003eLò vi sóng âm tủ có nướng Ecalite EMW-2560JS được bảo hành chính hãng 3 năm.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color:#000000;\"\u003eNguồn: ecalite.com\u003c/span\u003e\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv\u003e\n\u003cdiv\u003eNhìn chung,\u003cstrong\u003e lò vi sóng Ecalite EMW-250JS\u003c/strong\u003e âm tủ sở hữu thiết kế đẹp phù hợp với nhiều phong cách bếp khác nhau. Lò trang bị đầy đủ các chức năng nấu nướng cũng như tính năng an toàn, đem lại trải nghiệm nấu nướng hoàn hảo và tiện lợi cho người nội trợ.  \u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\