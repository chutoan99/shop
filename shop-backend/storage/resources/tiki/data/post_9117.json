null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.8,"review_count":12,"review_text":"(12)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/f9/11/74/077e8de626c6b767c09e7ec2d000d026.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1206,"all_time_quantity_sold":32,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2 style=\"text-align: center;\"\u003eBỘ KÍCH ẮC QUY KIÊM SẠC DỰ PHÒNG CRJS03-01 12000mAh THƯƠNG HIỆU CAO CẤP BASEUS DÙNG CHO XE Ô TÔ - HÀNG NHẬP KHẨU\u003c/h2\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ce/f2/40/7d9231cdd14778deb9c3c0fd7e09e840.jpg\" alt=\"\" width=\"720\" height=\"720\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003ciframe src=\"//www.youtube.com/embed/mH0Ip_0IISo\" width=\"720\" height=\"404\" allowfullscreen=\"allowfullscreen\"\u003e\u003c/iframe\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003e\u003cstrong\u003eThương Baseus là một thương hiệu cung cấp những sản phẩm tiện ích ô tô cực kỳ chất lượng và tiện dụng.\u003c/strong\u003e\u003cbr /\u003e- Bộ kích nô kiêm sạc dự phòng dùng cho xe ô tô Baseus CRJS03-01 là sản phẩm sử dụng giúp tài xế xử lý trong tình huống bình ắc quy của xe hết điện. Sản phẩm này có thể sử dụng tốt cho Xe máy, xe mô tô, xe ô tô máy xăng và xe ô tô máy dầu\u003cbr /\u003e- Là một sản phẩm mà chắc chắn phải có khi sở hữu xe hơi. Giúp khởi động xe, nô máy một cách an toàn và dễ dàng. Với hiệu xuất mạnh mẽ, dung lượng Pin lên đến 12000mAh\u003cbr /\u003e- Thiết kế tinh tế, mô phỏng như một chiếc ô tô mini, có thể dùng làm đồ trang trí trên ô tô.\u003cbr /\u003e- Thiết bị đánh lửa an toàn và thao tác đơn giản\u003cbr /\u003e- Hiệu năng pin được nâng cấp để có hiệu suất mạnh hơn, có thể sử dụng 20 lần kích nô ô tô khi được sạc đầy.\u003cbr /\u003e- Sản phẩm sử dụng màn hình hiển thị giúp người dùng luôn luôn nắm bắt được dung lượng Pin thực tế để có thể chủ động sạc khi cần thiết. Để kiểm tra dung lượng Pin, chỉ cần chạm nhẹ vào nút nguồn ở mặt trước sản phẩm. Màn hình sẽ hiển thị thông số chi tiết\u003cbr /\u003e- Sản phẩm được trang bị thêm đèn chiếu sáng để hỗ trợ soi chiếu trong điều kiện không có ánh sáng tốt\u003cbr /\u003e- Đặc biệt, sản phẩm có thể hoạt động trong điều kiện thời tiết khắc nhiệt từ -20 độ cho tới nhiệt độ cao 60 độ\u003cbr /\u003e\u003cstrong\u003eThông số kỹ thuật sản phẩm\u003c/strong\u003e\u003cbr /\u003e- Thương hiệu: Baseus\u003cbr /\u003e- Dung lượng: 12000mAh/3.7V/44.4Wh\u003cbr /\u003e- Đầu vào: 5V / 3A (Tối đa)\u003cbr /\u003e- Đầu ra USB: 5V / 2.4 A (Tối đa).\u003cbr /\u003e- Đầu ra Type-C: 5V / 3A (Tối đa)\u003cbr /\u003e- Điện áp khởi động: 12V\u003cbr /\u003e- Dòng khởi động: 600A (1s)\u003cbr /\u003e- Dòng điện cực đại: 1000A (0.3s)\u003cbr /\u003e- Kích thước sản phẩm: 163*83*36.5mm\u003cbr /\u003e- Trọng lượng: 470g\u003cbr /\u003e- Kiểu xe phù hợp: xe chạy xăng có dung tích dưới 6.0 L hoặc xe diesel có dung tích dưới 3.5L\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/4e/cf/53/9f9763608c4cf758269328d81fccd052.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/4e/cf/53/9f9763608c4cf758269328d81fccd052.jpg\" alt=\"\" width=\"720\" height=\"720\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/ea/c8/e3/c0590a9e69d7276a27397d9c8915c823.jpg\" 