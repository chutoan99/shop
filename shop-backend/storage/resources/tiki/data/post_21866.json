/189aeb03b88678b8bb1a882674397459.jpg","price":999000,"product_id":"106362939","store_id":116136}],"specifications":[{"name":"Content","attributes":[{"code":"capacity","name":"Dung tích","value":"1500ml"},{"code":"tinh_nang","name":"Tính năng","value":"Giữ nhiệt"},{"code":"brand","name":"Thương hiệu","value":"Elmich"},{"code":"brand_country","name":"Xuất xứ thương hiệu","value":"Cộng Hòa Séc"},{"code":"chat_lieu","name":"Chất liệu","value":"\u003cp\u003eInox 304 và nhựa cao cấp\u003c/p\u003e"},{"code":"huong_dan_bao_quan","name":"Hướng dẫn bảo quản","value":"\u003cul\u003e\n\u003cli style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 11pt; color: #000000;\"\u003eTránh va đập mạnh: Bạn nên tránh để bình va đập mạnh. Lực tác động quá mạnh sẽ khiến 2 lớp kim loại chạm vào nhau, làm giảm khoảng không giữa hai lớp này dẫn đến khả năng cách nhiệt của bình giảm sút.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"text-align: justify;\"\u003e“Khoảng thở” hai lần nóng - lạnh: Nếu đang đựng nước lạnh, bạn chuyển sang đựng nước nóng và ngược lại, bạn cần để chiếc bình có thời gian giãn cách khoảng 10 - 15 phút. Việc thay đổi nhiệt độ đột ngột sẽ khiến chất liệu trong chiếc bình co - dãn đột ngột, làm giảm tuổi thọ bình.\u003c/li\u003e\n\u003cli style=\"text-align: justify;\"\u003eVệ sinh thường xuyên: Bạn cần vệ sinh bình thường xuyên để tránh nấm mốc, vi khuẩn tích tụ.\u003c/li\u003e\n\u003c/ul\u003e"},{"code":"huong_dan_su_dung","name":"Hướng dẫn sử dụng","value":"\u003cul\u003e\n\u003cli style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 11pt; color: #000000;\"\u003eChỉ được phép sử dụng đúng công năng của bình. Nếu là bình giữ lạnh thì chỉ được đựng nước lạnh, nếu là bình lưỡng tính thì có thể vừa đựng nước nóng vừa đựng nước lạnh.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"text-align: justify;\"\u003eVới mỗi loại bình giữ nhiệt, sẽ có khoảng rộng nhiệt độ cho phép khác nhau, nghĩa là cho phép nhiệt độ thấp nhất và cao nhất là bao nhiêu. Đối với những thức uống có nhiệt độ rất nóng, chúng ta nên hạn chế vì sẽ tăng nguy cơ người sử dụng bị phỏng do đổ thức uống trực tiếp từ trong bình ra. Trong trường hợp này, bạn không nên sử dụng nắp lật có ống hút và nên sử dụng nắp vặn bình thường.\u003c/li\u003e\n\u003cli style=\"text-align: justify;\"\u003eBạn nên rửa sạch bình giữ nhiệt trước khi sử dụng lần đầu, có thể dùng xà phòng rửa chén, hoặc bột baking soda hoặc dấm.\u003c/li\u003e\n\u003cli style=\"text-align: justify;\"\u003eKhông được phép để bình giữ nhiệt trực tiếp vào trong tủ lạnh, vì chất lỏng trong bình sẽ giãn nở khi gặp lạnh và làm biến dạng bình.\u003c/li\u003e\n\u003cli style=\"text-align: justify;\"\u003eĐối với bình giữ nhiệt bằng kim loại, không được cho vào lò vi sóng.\u003c/li\u003e\n\u003cli style=\"text-align: justify;\"\u003eKhông nên rửa bình bằng máy rửa chén mà vệ sinh bình bằng tay để bình luôn được bền đẹp.\u003c/li\u003e\n\u003c/ul\u003e"},{"code":"item_model_number","name":"Model","value":"EL-3129"},{"code":"kich_thuoc","name":"Kích thước (Dài x Rộng x Cao)","value":"13x13x23cm"},{"code":"material","name":"Chất liệu","value":"Inox 304, nhựa"},{"code":"origin","name":"Xuất xứ (Made in)","value":"Trung Quốc"}]},{"name":"Operation","attributes":[{"code":"is_warranty_applied","name":"Sản phẩm có được bảo hành không?","value":"Có"},{"code":"warranty_form","name":"Hình thức bảo hành","value":"Phiếu bảo hành"},{"code":"warranty_time_period","name":"Thời gian bảo hành","value":"12 Tháng"}]}],"price_comparison":{"sub_title":"Giá từ 975.000 ₫","title":"So sánh 2 nhà bán khác"},"product_links":[],"gift_item_title":"0 quà tặng kèm","services_and_promotions":[],"promitions":[],"stock_item":{"max_sale_qty":1000,"min_sale_qty":1,"preorder_date":null,"qty":1000},"categories":{"id":1883,"name":"Nhà Cửa - Đời Sống","is_leaf":false},"breadcrumbs":[{"url":"/nha-cua-doi-song/c1883","name":"Nhà Cửa - Đời Sống","category_id":1883},{"url":"/phong-an/c1954","name":