:null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":6,"review_text":"(6)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/26/e1/34/911b405be5327c55a8b6c5da118bd170.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":917,"all_time_quantity_sold":12,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch1 class=\"ddnb-title spct-title\"\u003e\u003cstrong\u003eĐánh giá Màn hình Viewsonic TD1655 Cảm Ứng Di Động 15.6inch FHD IPS\u003c/strong\u003e\u003c/h1\u003e\n\u003cdiv\u003e\n\u003cdiv\u003e\n\u003cdiv\u003e\n\u003ch3\u003eTổng quan\u003c/h3\u003e\nViewSonic TD1655 là màn hình cảm ứng di động để mở rộng nội dung cho các thiết bị di động như laptop, máy tính bảng, máy chơi game và điện thoại di động thông minh. Sản phẩm tích hợp cổng USB Type-C kép cho khả năng truyền tải nội dung, sạc điện với công suất lên tới 60W và truyền tín hiệu kết nối cảm ứng. Màn hình mở rộng TD1655 có thiết kế bền bỉ với vỏ kim loại, chân đế bằng nhôm có thể gập lại được và màn hình chống xước có độ cứng 6H. Sản phẩm được tặng kèm một tấm vỏ bảo vệ từ tính sang trọng.\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv id=\"featureLegacy\"\u003e\n\u003cdiv id=\"feature0\" data-feature-id=\"4940\"\u003e\n\u003cdiv\u003e\n\u003ch3\u003eMở Rộng Tầm Nhìn Của Bạn\u003c/h3\u003e\n\u003cp\u003eKết nối màn hình thứ 2 với máy tính xách tay, máy tính bảng hoặc điện thoại có tích hợp cổng USB Type-C. Các hệ điều hành hỗ trợ Windows, Android, Chrome, MacOS, iOS và iPadOS *. Yêu cầu máy tính xách tay, máy tính bảng hoặc điện thoại thông minh của bạn sở hữu cổng kết nối USB-C có hỗ trợ Display Port 1.2 Alt Mode và và sạc nhanh (Power Delivery).\u003c/p\u003e\n\u003cp\u003e* Để kết nối với iPhone hoặc iPad qua cổng sạc, bạn sẽ yêu cầu mua Bộ chuyển đổi AV kỹ thuật số từ Apple và kết nối qua dây cáp HDMI-mini HDMI **\u003cbr /\u003e** Cáp HDMI to mini HDMI có sẵn trong hộp **\u003c/p\u003e\n\u003cdiv\u003e\n\u003cdiv\u003eKết Nối Dễ Dàng Với Laptop, Máy Tính Bảng Và Điện Thoại\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv\u003e\u003cimg class=\"loading\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/dd/96/dd/6bea6264aa51bba1cf4315133c542cd7.png\" alt=\"Màn hình di động Viewsonic TD1655-1\" width=\"960\" height=\"441\" data-was-processed=\"true\" /\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv id=\"feature1\" data-feature-id=\"4941\"\u003e\n\u003cdiv\u003e\n\u003ch3\u003ePhát Video, Âm Thanh Và Sạc Điện Cùng Lúc\u003c/h3\u003e\n\u003cp\u003eSản phẩm được trang bị cổng kết nối USB Type-C kép, người dùng có thể truyền tải video và âm thanh hay sử dụng như một nguồn hai chiều ở cả hai cổng (60W). Kết nối trực tiếp laptop với màn hình di động để cấp nguồn và truyền tải nội dung bằng một dây cáp hoặc ngược lại, người dùng cũng có thể sạc cho laptop khi kết nối màn hình di động với nguồn adapter ở cổng USB còn lại.\u003c/p\u003e\n\u003cp\u003e\u003csmall\u003e*Thời gian hoạt động:\u003cbr /\u003e1. Khi làm việc trong thời gian dài và liên tục chúng tôi đề xuất bạn sử dụng nguồn điện trực tiếp từ ổ điện.\u003cbr /\u003e2. Khi làm việc trong thời gian ngắn, người dùng chỉ cần kết nối trực tiếp với thiết bị đang sử dụng.\u003cbr /\u003e1\u0026gt; Màn hình di động có khả năng hoạt động trên 2 giờ khi sử dụng điện từ điện thoại di động thông minh - Đã kiểm nghiệm với điện thoại di động có dung lượng pin 4,000 mAh.\u003cbr /\u003ea. Điện thoại bật nhưng không sử dụng.\u003cbr /\u003eb. Màn hình di động có độ sáng 15 và độ tương phản 70.\u003cbr /\u003ec. Kết nối qua dây cáp USB Type-C.\u003cbr /\u003e\u003cbr /\u003e2\u0026gt; Màn hình di động có khả năng hoạt động trên 1,5 giờ khi sử dụng điện từ laptop - Đã kiểm nghiệm với laptop có dung lượng pin 53,546 mAh.\u003cbr /\u003ea. Laptop bật; màn hình bật.\u003cbr /\u003eb. Màn hình di động có độ sáng 100 và độ tương phản 70.\u003cbr /\u003ec. Kết nối qua dây cáp USB Type-C.\u003c/small\u003e\u003c/p\u003e\n\u003cdiv\u003e\n\u003ch3\u003eDễ Dàng Cài Đặt Với 2 Cổng USB Type C\u003c/h3\u003e\n\u003c/div\u003e\n\u003cdiv\u003e\u003cimg class=\"loading\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/d5/bc/a1/9d501bb3fce77cdfeee3aefb3e04e866.png\" alt=\"Màn hình di động Viewsonic TD1655-2\" width=\"960\" height=\"695\" data-was-processed=\"true\" /\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv id=\"feature2\" data-feature-id=\"4942\"\u003e\n\u003cdiv\u003e\n\u003ch3\u003eMàn Hình Cảm Ứng Di Động\u003c/h3\u003e\n\u003cp\u003eDễ dàng thao tác cảm ứng với một chiếc màn hình phụ thứ 2 có kích thước lớn 16 inch. Sản phẩm được tặng kèm một bút cảm ứng từ tính giúp người dùng vẽ, viết ghi chú thuận tiện.\u003cbr /\u003e\u003cbr /\u003e*Hỗ trợ cảm ứng một điểm cho MacOS; không áp dụng cho thiết bị iOS và iPadOS.\u003c/p\u003e\n\u003cdiv\u003e\n\u003cdiv\u003eMàn Hình Cảm Ứng 10 Điểm\u003cbr /\u003eBút Cảm Ứng\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv\u003e\u003cimg class=\"loading\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/5e/c8/98/56b3d950b873f38a7c6654cd793a64de.png\" alt=\"Màn hình di động Viewsonic TD1655-3\" width=\"960\" height=\"560\" data-was-processed=\"true\" /\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv id=\"feature3\" data-feature-id=\"4943\"\u003e\n\u003cdiv\u003e\n\u003ch3\u003eKích Thước Nhỏ Gọn Để Làm Việc \u0026amp; Giải Trí\u003c/h3\u003e\nMàn hình 16 inch với trọng lượng chư