"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/4b/6f/2e/8be5c24d07df1459d2a643bcbf8c31e1.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":158,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e \u003c/p\u003e\n\u003cdiv class=\"syl-image-wrapper\"\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/94/1b/ca/4493e1c3376e53124d758bcbdb083f7c.jpeg?from=476444299\" width=\"1280\" height=\"960\" alt=\"29b533742e474425999e4194a3f33489~tplv-o3syd03w52-origin-jpeg.jpeg?from=476444299\" /\u003e\u003c/div\u003e\n\u003col start=\"1\"\u003e\n\u003cli\u003eMicro KMC 9 là dòng micro chuyên nghiệp cao cấp nổi tiếng thế giới.\u003c/li\u003e\n\u003cli\u003eĐây cũng là một trong những dòng Mirco Không Dây đang được rất nhiều khách hàng quan tâm bởi rất nhiều tính năng tiên tiến mà chỉ một số ít dòng micro hiện nay có được.\u003c/li\u003e\n\u003cli\u003eMicro KMC 9 sử dụng tốt cho karaoke gia đình, dàn karaoke kinh doanh, sân khấu, phòng trà... ️\u003c/li\u003e\n\u003cli\u003eVề phần tay cầm của Micro KMC 9 cũng được làm từ hợp kim cao cấp và phần đầu Mic được làm từ inox không gỉ.\u003c/li\u003e\n\u003cli\u003eBên trong phần chụp mic là một lớp màng vải mỏng, giúp lọc âm tốt, đồng thời hạn chế hơi nước từ miệng người hát tiếp xúc trực tiếp với củ mic gây gỉ sét. ️\u003c/li\u003e\n\u003cli\u003eGiữa tay cầm Micro KMC 9 được thiết kế một nút bật/tắt và một màn hình LCD nhỏ để hiển thị tần số và tình trạng pin của micro. ️\u003c/li\u003e\n\u003cli\u003eBắt âm chuẩn, hút âm tốt .\u003c/li\u003e\n\u003c/ol\u003e\n\u003cp\u003eMicro karaoke KMC 9 sở hữu độ nhạy cao nên bắt âm chuẩn và hút âm rất tốt, âm thanh phát ra chi tiết và trong. ️\u003c/p\u003e\n\u003cp\u003eĐặc biệt, sử dụng Micro Không Dây KMC 9 không bị chói tai hoặc vỡ tiếng mà ấm áp, rõ ràng. ️ Tự động dò sóng sạch .Với khả năng tự động dò tìm sóng phù hợp \"sóng sạch’’ thông minh, Micro KMC 9 cho âm thanh ra loa karaoke không bị tạp âm, tránh được tình trạng nhiễu sóng, mất sóng xảy ra trong quá trình sử dụng mang đến cho khách hàng những trải nghiệm hoàn toàn thú vị. ️\u003c/p\u003e\n\u003cp\u003eChế Độ Dò Chỉnh Tần Số Sóng vô cùng hiện đại, giúp dễ dàng đổi tay mic hay đầu thu mới khi lỗi hỏng mà không cần phải thay cả bộ.\u003c/p\u003e\n\u003cp\u003eThông Số Kỹ Thuật : ️\u003c/p\u003e\n\u003cp\u003eKênh điều khiển : UHF 6 số . ️ Kênh : 2 . Sóng : 2 Anten. ️\u003c/p\u003e\n\u003cp\u003eNăng lượng : Pin Tiểu Con Thỏ AA 1.5V ️ Nguồn cấp điện : 220V ️\u003c/p\u003e\n\u003cp\u003eKích thước : Cao 4cm x Sâu 20cm x Rộng 44cm ️\u003c/p\u003e\n\u003cp\u003eTrọng Lượng Đóng Gói : 4kg ️ BẢO HÀNH 12 THÁNG.\u003c/p\u003e\n\u003cp\u003eĐỔI MỚI TRONG VÒNG 30 NGÀY TỪ NGÀY NHẬN ĐƯỢC HÀNG . ️\u003c/p\u003e\n\u003cp\u003eẢNH THẬT TỰ CHỤP SẢN PHẨM QUẢNG CÁO. ️ Test Kiểm Tra Kĩ Càng ,Bọc Hàng Cẩn Thận Trước Khi Gửi Cho Khách Hàng .\u003c/p\u003e\n\u003cdiv class=\"syl-image-wrapper\"\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/89/52/e8/9b890246e38423a66bfbaf82c5f9860e.jpeg?from=476444299\" width=\"960\" height=\"1280\" alt=\"c0228582f1a84df58377787caea94e83~tplv-o3syd03w52-origin-jpeg.jpeg?from=476444299\" /\u003e\u003c/div\u003e\n\u003cp\u003eBộ Sản Phẩm bao gồm :\u003c/p\u003e\n\u003cp\u003eĐầu Thu + 2 Tay Micro + Cục Nguồn + 2 Râu ăng ten + Dây kết nối 6mm + 2 Chống Lăn + 4 Pin AA\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/4b/6f/2e/8be5c24d07df1459d2a643bcbf8c31e1.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/4b/6f/2e/8be5c24d07df1459d2a643bcbf8c31e1.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/4b/6f/2e/8be5c24d07df1459d2a643bcbf8c31e1.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4b/6f/2e/8be5c24d07df1459d2a643bcbf8c31e1.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4b/6f/2e/8be5c24d07df1459d2a643bcbf8c31e1.png"},{"base_url":"https://salt.tikicdn.com/ts/product/f7/23/53/b98d277959ef34654f31a01a467d4d47.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f7/23/53/b98d277959ef34654f31a01a467d4d47.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f7/23/53/b98d277959ef34654f31a01a467d4d47.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f7/23/53/b98d277959ef34654f31a01a467d4d47.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f7/23/53/b98d277959ef34654f31a01a467d4d47.png"},{"base_url":"https://salt.tikicdn.com/ts/product/c5/49/45/141799b2ed57c3587a2c0d1b48a5403a.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c