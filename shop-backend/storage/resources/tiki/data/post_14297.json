8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":21,"review_text":"(21)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/61/a3/87/ebddf50459f8b0db6bb633996cc33010.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1394,"all_time_quantity_sold":183,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eGạo nếp Bạch Ngọc Ông Thọ có nguồn gốc từ giống Nếp Bắc, là một loại nếp thơm được gieo trồng nhiều ở các tỉnh miền Bắc và được xuất khẩu đi nhiều tỉnh thành trong cả nước. Sản phẩm được người dân Việt Nam dùng trong nhiều món ăn truyền thống như xôi, bánh chưng, bánh dày,… Hạt Nếp Bắc to tròn, trơn bóng, trắng đều dẻo thơm. Khi chín sản phẩm cho ra xôi khô ráo, hạt trắng trong có độ kết dính cao. Gạo nếp còn là một loại thực phẩm có giá trị dinh dưỡng cao, cung cấp nhiều loại vitamin và chất xơ quan trọng cho cơ thể.\u003c/p\u003e\n\u003cp\u003eSản phẩm được sản xuất theo một quy trình nghiêm ngặt và quản lý chặt chẽ từ khâu thu hoạch cho đến đóng gói nên người tiêu dùng có thể hoàn toàn yên tâm về chất lượng. Nếp Bắc có nguồn gốc hoàn toàn tự nhiên, không sử dụng chất bảo quản, thuốc chống mốc và mối mọt. Sản phẩm còn được đóng gói nilon dày dặn, bảo đảm vệ sinh an toàn mang đến cho người dùng sự an tâm tuyệt đối.\u003c/p\u003e\n\u003cp\u003eĐặc điểm gạo Nếp Bạch Ngọc\u003cbr /\u003eHạt gạo tròn, trắng đều dẻo, thơm đặc biệt nên thường dùng đồ xôi, làm cốm\u003cbr /\u003eLàm các loại bánh có sử dụng gạo nếp, làm tương.\u003cbr /\u003eHạt gạo có mùi thơm ngào ngạt, ít bị lại gạo nên được nhiều người tiêu dùng lựa chọn.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eCông Dụng:\u003cbr /\u003e- Nấu cơm, đồ xôi, làm bánh, nấu cháo, trà gạo lứt, sữa bột gạo, bột nế\u003cbr /\u003e- Gạo nếp vốn chứa nhiều amilopectin tạo nên độ dẻo đặc trưng\u003cbr /\u003e- Gạo nếp còn có tính ấm, vị ngọt, dễ tiêu hóa, giúp làm ấm bụng\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eThành phần dinh dưỡng gạo nếp\u003cbr /\u003eGạo nếp bắc cũng là dòng họ với lúa gạo nhưng có đặc điểm khác so với loại kia. Gạo nếp chứa các thành phần dinh dưỡng rất cao như canxi, protein, lipid, sắt và các vitamin B1, B2, tinh bột…bổ sung và cung cấp cho cơ thể với nhiều công dụng. Tuy nhiên cần ăn gạo nếp một cách phù hợp, tránh ăn quá nhiều sẽ làm cho cơ thể nóng, khó tiêu.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eCách sử dụng: \u003cbr /\u003e- Dùng nấu xôi, chè, cơm nếp\u003cbr /\u003e- Những người mới phẫu thuật, người có những chỗ bị sưng viêm nên tránh ăn sản phẩm làm từ nếp\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eCách nấu\u003c/p\u003e\n\u003cp\u003e- Vo gạo sạch, Nấu theo tỷ lệ 1 gạo / 0,9-1 nước, lượng nước có thể điều chỉnh tùy theo khẩu vị\u003cbr /\u003e- Nấu cơm gạo nếp trong khoảng 35 - 45 phút để hạt nếp chín kĩ và thơm ngon hơn.\u003cbr /\u003e- Nên cho một ít muối và dầu ăn để hạt xôi khi chín đậm đà và bóng bẩy hơn\u003cbr /\u003e -Cơm chín, mở nắp đảo đều và thưởng thức, có thể ăn kèm với nhiều loại thức ăn khác.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eBảo quản: cần bảo quản nơi khô ráo, thoáng mát tránh côn trùng xâm nhập\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập 