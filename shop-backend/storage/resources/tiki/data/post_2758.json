unt":0,"discount_rate":0,"rating_average":4,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/75/40/bb/07b4f5e7eae9e5c7335c7b8bf53fff44.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1933,"all_time_quantity_sold":25,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cdiv\u003e\n\u003ch3 style=\"text-align: center;\"\u003e\u003cimg class=\" wp-image-1295 aligncenter\" src=\"https://salt.tikicdn.com/ts/product/b2/a8/44/745ac6ce3547521058407bb5333087f0.png\" alt=\"\" width=\"437\" height=\"270\" /\u003e\u003c/h3\u003e\n\u003ch3\u003e\u003cspan style=\"color: #282828;\"\u003eSản phẩm \u001drất kinh tế và thân thiện với môi trường vì viên pin có thể sạc lên đến 3000 lần.\u003c/span\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eHãy thử chia số tiền bạn bỏ ra cho số lần sạc của pin, chi phí bạn bỏ ra là bao nhiêu đồng / lần sử dụng?\u003c/li\u003e\n\u003cli\u003eHãy tưởng tượng, pin đươc sử dụng tới 23000 lần mới phải vứt đi. Thay vì phải tìm cách để vứt đi 3000 viên pin ra môi trường?\u003c/li\u003e\n\u003c/ul\u003e\n\u003cdiv class=\"titleText section\"\u003e\n\u003cdiv class=\"titleText_in\"\u003e\n\u003cdiv class=\"text parbase section\"\u003e\n\u003ch3\u003e\u003cimg class=\"alignnone size-medium wp-image-1290\" style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/product/7a/d4/58/c1c57e786caa05ac5e967098589189aa.png\" alt=\"\" width=\"750\" height=\"189\" /\u003e\u003c/h3\u003e\n\u003ch3\u003e\u003cspan style=\"color: #333399;\"\u003eNgoài ra, với công nghệ vượt trội của mình, eneloop hoàn toàn không có hiệu ứng nhớ. Có nghĩa là bạn có thể sạc pin bất kỳ lúc nào, không sợ pin bị chai, bị “nhớ” nhầm mức dung lượng.\u003c/span\u003e\u003c/h3\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"freeimage section\"\u003e\n\u003csection class=\"free-image \"\u003e\n\u003cdiv class=\"container\"\u003e\u003cimg class=\"copyguard lazy aligncenter\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Siêu bền và không có hiệu ứng nhớ\" src=\"https://salt.tikicdn.com/ts/product/dc/00/ac/67d2f6293b2e764f7146bc8864286c2b.jpg\" alt=\"Siêu bền và không có hiệu ứng nhớ\" width=\"640\" height=\"184\" data-src=\"/content/panasonic/vn/vi/consumer/batteries-learn/eneloop-san-pham-den-tu-tuong-lai/5-uu-diem-cua-pin-eneloop-panasonic-so-voi-cac-doi-thu/_jcr_content/learncontent/learncontentsection/parsys/freeimage_107773683/image.img.jpg/1548642372791.jpg\" /\u003e\u003c/div\u003e\n\u003c/section\u003e\n\u003c/div\u003e\n\u003cdiv class=\"pageseparator section\"\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"titleText section\"\u003e\n\u003cdiv class=\"titleText_in\"\u003e\n\u003cdiv class=\"text parbase section\"\u003e\n\u003ch3\u003e\u003cspan style=\"color: #282828;\"\u003eĐộ tự xả thấp\u003c/span\u003e\u003c/h3\u003e\n\u003cp\u003e\u003cspan style=\"color: #282828;\"\u003ePin không phải lúc nào cũng dùng thường xuyên. Hầu hết các pin sạc trên thị trường đều có độ tự xả cao.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color: #282828;\"\u003eNghĩa là nếu bạn cất giữ pin, không làm gì cả, không dùng gì đến, chỉ sau 1 năm, pin sẽ cạn sạch năng lượng. eneloop thì khác, sau 3 năm, nó vẫn giữ được 75% năng lượng. Bạn cất giữ trong tủ 1 viên eneloop, sau 3 năm lấy ra bạn có thể sử dụng ngay.\u003c/span\u003e\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"freeimage section\"\u003e\n\u003csection class=\"free-image \"\u003e\n\u003cdiv class=\"container\"\u003e\u003cimg class=\"copyguard lazy\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Độ tự xả thấp\" src=\"https://salt.tikicdn.com/ts/product/12/e9/48/767b51b17096bc2e587e77c6dd04aff3.jpg\" alt=\"Độ tự xả thấp\" width=\"600\" height=\"327\" data-src=\"/content/panasonic/vn/vi/consumer/batteries-learn/eneloop-san-pham-den-tu-tuong-lai/5-uu-diem-cua-pin-eneloop-panasonic-so-voi-cac-doi-thu/_jcr_content/learncontent/learncontentsection/parsys/freeimage_1503024124/image.img.jpg/1548653255237.jpg\" /\u003e\u003c/div\u003e\n\u003c/section\u003e\n\u003c/div\u003e\n\u003ch3\u003e\u003cspan style=\"color: #555555;\"\u003eĐiện áp ổn định\u003c/span\u003e\u003c/h3\u003e\n\u003cdiv\u003eĐiện áp của pin sạc NiMH là 1.2V, nhưng của pin Alkaline là 1.5V. Tuy nhiên, eneloop duy trì điện áp cực kỳ ổn định trong suốt vòng đời của nó trước khi phải sạc lại.\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003ch1\u003eThông tin sản phẩm:\u003c/h1\u003e\n\u003cul\u003e\n\u003cli\u003eXuất xứ \bTrung Quốc\u003c/li\u003e\n\u003cli\u003eHạn sử dụng sản phẩm: Không có, đến hết số lần sạc (3000 lần) thì hết.\u003c/li\u003e\n\u003cli\u003eKhông chảy nước Không cháy nổ\u003c/li\u003e\n\u003cli\u003eKích thước chuẩn cho mọi thiết bị\u003c/li\u003e\n\u003cli\u003eThiết kế pin chắc chắn, chịu được mọi điều kiện khí hậu\u003c/li\u003e\n\u003cli\u003eQuy cách đóng gói:\u003cbr /\u003e- Một vỉ gồm 02 viên\u003cbr /\u003e- Một \bHỘP = 10 \u001dvỉ x 02 viên = 20 viên/Hộp\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003eHãy tìm hiểu dòng cao cấp hơn \u001c pin eneloop trắng và eneloop Pro theo video bên dưới.\u003c/h3\u003e\n\u003cp\u003e\u003ciframe src=\"https://www.youtube.com/embed/O37Xg90h4qE\" width=\"560\" height=\"315\" frameborder=\"0\" allowfullscreen=\"allowfullscreen\" data-mce-fragment=\"1\"\u003e\u003c/iframe\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/75/40/bb/07b4f5e7eae9e5c7335c7b8bf53fff44.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/75/40/bb/07b4f5e7eae9e5c7335c7b8bf53fff44.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/75/40/bb/07b4f5e7eae9e5c7335c7b8bf53fff44.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/75/40/bb/07b4f5e7eae9e5c7335c7b8bf53fff44.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/75/40/bb/07b4f5e7eae9e5c7335c7b8bf53fff44.jpg"}],"warranty_policy":null,"brand":{"id":18804,"name":"Panasonic","slug":"panasonic"},"current_seller":{"id":12055,"sku":"1336489603920","name":"Điện tử Phương Nam","link":"https://tiki.vn/cua-hang/dien-tu-phuong-nam","logo":"9a/2c/4f/5288d24e5b9589cfe4019a119a38c78d.jpg","price":300000,"product_id":"16989953","store_id":11724,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Content","attributes":[{"code":"brand","name":"Thương hiệu","value":"Panasonic"},{"code":"brand_country","name":"Xuất xứ thương hiệu","value":"Nhật Bản"},{"code":"kich_thuoc","name":"Kích thước (Dài x Rộng x Cao)","value":"10x5cm"},{"code":"origin","name":"Xuất xứ (Made in)","value":"Thái Lan/ Indonesia/Trung Quốc"},{"code":"thoi_gian_su_dung","name":"Thời gian sử dụng","value":"\u003cp class=\"p1\"\u003eTuỳ theo thiết bị sử dụng, thời gian sử dụng pin, và cách sử dụng pin.\u003c/p\u003e"}]},{"name":"Operation","attributes":[{"code":"is_warranty_applied","name":"Sản phẩm có được bảo hành không?","value":"Không"}]}],"product_links":[],"gift_item_title":"0 quà tặng kèm","services_and_promotions":[],"promitions":[],"stock_item":{"max_sale_qty":1000,"min_sale_qty":1,"preorder_date":null,"qty":1000},"quantity_sold":{"text":"Đã bán 25","value":25},"categ