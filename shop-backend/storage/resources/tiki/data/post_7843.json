t hết thiết bị ánh sáng khi sử dụng đèn\u003cbr /\u003eCác thiết bị ánh sáng khác có thể ảnh hưởng đến khả năng thu hút muỗi của đèn. Có thể bạn chưa biết, đèn bắt muỗi hoạt động hiệu quả vào ban đêm hơn là ban ngày. Chính vì thế khi sử dụng đèn bắt muỗi bạn nên tắt các thiết bị chiếu sáng khác trong phòng. Việc này để làm tăng khả năng thu hút muỗi của đèn.\u003c/p\u003e\n\u003cp\u003eChú ý khoảng cách giữa đèn và mặt đất\u003cbr /\u003eLoài muỗi cũng giống như những loài côn trùng khác, thường bay qua lại ở khoảng cách cách mặt đất tầm 1,5 đến 2m. Chính vì vậy để nâng cao hiệu quả sử dụng đèn bắt muỗi thì nên đặt đèn ở khoảng tương đương không nên đặt quá cao hay quá sát mặt đất.\u003c/p\u003e\n\u003cp\u003eVệ sinh bóng đèn, quạt hút, lưới điện thường xuyên\u003cbr /\u003eViệc vệ sinh bóng đèn, lưới điện và quạt hút là điều vô cùng quan trọng. Vì khi muỗi bị tiêu diệt, xác sẽ tồn lại trong đèn điều đó không chỉ làm mất vệ sinh mà còn ảnh hưởng đến hoạt động của đèn. Mỗi tuần nên vệ sinh đèn bắt muỗi một lần và bảo quản nơi khô ráo, tránh nước và những nơi quá ẩm thấp.\u003c/p\u003e"},{"code":"item_model_number","name":"Model","value":" DBM01 5W"},{"code":"kich_thuoc","name":"Kích thước (Dài x Rộng x Cao)","value":"(200x238)mm"},{"code":"origin","name":"Xuất xứ (Made in)","value":"Việt Nam"},{"code":"product_weight","name":"Trọng lượng sản phẩm","value":"900g"},{"code":"thoi_gian_sac_day","name":"Thời gian sạc đầy","value":"0"},{"code":"thoi_gian_su_dung","name":"Thời gian sử dụng","value":"\u003cp\u003eSử dụng được tất cả thời gian trong ngày\u003c/p\u003e"},{"code":"tuoi_tho_toi_da","name":"Tuổi thọ tối đa","value":"5 năm "}]},{"name":"Operation","attributes":[{"code":"is_warranty_applied","name":"Sản phẩm có được bảo hành không?","value":"Có"},{"code":"warranty_form","name":"Hình thức bảo hành","value":"Điện tử"},{"code":"warranty_time_period","name":"Thời gian bảo hành","value":"1 Năm"}]}],"product_links":[],"gift_item_title":"0 quà tặng kèm","configurable_opti