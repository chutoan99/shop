9,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":100000,"discount_rate":11,"rating_average":4.8,"review_count":8,"review_text":"(8)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/22/a0/05/558131fced4c59712d8a3c4ea68be9af.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2065,"all_time_quantity_sold":33,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp class=\"MsoNormal\"\u003eGhế xếp thông minh có khay để ly MK-116 sẽ là một vật dụng rất hữu ích, quan trọng \u0026amp; không thể thiếu trong mỗi gia đình, nhân viên văn phòng hoặc các chuyến du lịch bởi tính tiện dụng, nhỏ gọn \u0026amp; xếp gọn để dễ dàng di chuyển khi cần.\u003c/p\u003e\n\u003cp class=\"MsoNormal\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/45/bf/7b/3258f45c89b07d68760eda3c8c728c3d.jpg\" alt=\"\" width=\"750\" height=\"527\" /\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\"\u003eChiếc ghế xếp thư giãn Kachi MK-116 là dòng sản phẩm chất lượng, có thiết kế thông minh để có thể vừa là chiếc ghế ngồi vừa làm giường nằm thoải mái. Kiểu dáng cùng màu sắc hiện đại, trang nhã thích hợp cho mọi lứa tuổi, mọi kiểu thiết kế nội thất. Bạn có thể đặt ghế xếp thông minh MK-116 này ở nhiều không gian khác nhau như phòng khách, phòng ngủ, sân vườn, văn phòng làm việc, lan can căn hộ chung cư, trong các chuyến đi du lịch biển, núi, rừng, dã ngoại….\u003c/p\u003e\n\u003cp class=\"MsoNormal\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/3c/dd/8b/67f7cd43691f49b6132c797f499e2d88.jpg\" alt=\"\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\"\u003eGhế xếp MK-116 có thể ngã ra sau tối đa 160° và bật thẳng đứng 90° cơ động.\u003c/p\u003e\n\u003cp class=\"MsoNormal\"\u003eKhung thân ghế là “bộ xương” của chiếc ghế này làm từ ống sắt Ø25, sơn tĩnh điện chắc chắn, chịu được tải trọng cao đến 90Kg, bền bỉ \u0026amp; khó bị rỉ sét thời gian dài sau khi sử dụng. Tay vịn của ghế xếp có thiết kế đơn giản, làm bằng nhựa nhám với các đường gờ nổi nhỏ trên bề mặt tay vịn giúp tay bám chắc hơn.\u003c/p\u003e\n\u003cp class=\"MsoNormal\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/d8/af/48/9be6b98fe3a0c52ebcf422e13c972e97.jpg\" alt=\"\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/2f/1f/39/c0c7a1096e0c5eeaf87d858621e14e4a.jpg\" alt=\"\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/15/ae/17/7f86352a07cf9a70d37c3f93028800a1.jpg\" alt=\"\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/92/0c/1c/604eacf6e387126b0dd822a1e24a5ddf.jpg\" alt=\"\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\"\u003e \u003c/p\u003e\n\u003cp class=\"MsoNormal\"\u003eVải lưới chất lượng cao Fabric, có hai mặt giống nhau hoàn toàn và đều nhìn giống mặt trái, các sợi vải siêu nhỏ đan chặt vào nhau tạo sự siêu bền bỉ khác với các loại ghế xếp thông thường, tính chất của vải như thoáng mát cho da của bạn, không thấm nước, chịu được các kiểu khí hậu thay đổi nắng gió khác nhau. Hơn nữa, tấm vải được kết nối với khung ghế bằng dây thun co giãn tốt, đan theo kiểu zic-zac, độ đàn hồi bền lâu, cùng với các khoen nối duy mĩ không gây cấn đau khó chịu cho toàn cơ thể, giúp bạn có được cảm giác thoải mái, êm ái khi ngồi hoặc nằm cho bất kì hoạt động thư giãn nào.\u003c/p\u003e\n\u003cp class=\"MsoNormal\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/22/dc/6e/88609a142c67b0f1457b264e398ffb56.jpg\" alt=\"\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/3c/b9/dd/017e92d663dbc7e8f0a1afbfc7c35560.jpg\" alt=\"\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\"\u003e \u003c/p\u003e\n\u003cp class=\"MsoNormal\"\u003eSự cải tiến nổi bật nhất của ghế xếp MK-116 lần này chính là khay để ly bằng nhựa cao cấp, tích hợp ngay phía bên trái của hông ghế xếp, với 2 hộc đựng, bạn có thể đặt các ly nước hoa quả, ly trà \u0026amp; kèm luôn cả chai nước lọc nếu cần ,mà không gây vướng hay nặng nề khung ghế, chiếc khay tiện lợi tối ưu này có thể đáp ứng cho bạn sự thư thái đỉnh cao nhất. Vừa ngồi đọc sách vừa nhâm nhi ly nước yêu thích thì còn gì tuyệt vời hơn nữa?!! Lúc không cần sử dụng bạn chỉ cần tháo ra rất đơn giản.\u003c/p\u003e\n\u003cp class=\"MsoNormal\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/bc/eb/39/e0baec8009601f850523643bbb446a99.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\"\u003eKhớp xoay kèm khóa cố định được thiết kế đặc biệt, bằng nhựa nhẹ nhàng, êm ái cho bàn tay điều chỉnh mà rất chắc chắn. Giúp người dùng thoải mái điều chỉnh độ nghiêng của ghế cho phù hợp làm ghế ngồi hay ghế nằm.\u003c/p\u003e\n\u003cp class=\"MsoNormal\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/e8/b5/89/6cdda315acf1a91e1282b57d1fe5fb30.jpg\" alt=\"\" width=\"750\" height=\"505\" /\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\"\u003ePhía trên đầu ghế được nhà sản xuất tích hợp một chiếc gối mềm có ruột bông gòn, có thể đặt cố định hay tháo rời tùy ý người dùng, gối có kiểu dáng \u0026amp; độ cao tương thích nhất cho cổ \u0026amp; đầu có cảm giác thư giãn tối đa. Gối màu đen tuyền sang trọng hài hòa với tổng thể chiếc ghế xếp.\u003c/p\u003e\n\u003cp class=\"MsoNormal\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/31/19/6a/db368846b47edae8ede8f3c4eb8fba86.jpg\" alt=\"\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\"\u003eThiết kế của ghế ôm gọn với cơ thể trung bình con người, cho khách hang cảm giác thoải mái khi ngồi, xoay chuyển người thuận lợi khi nằm \u0026amp; nghỉ ngơi.\u003c/p\u003e\n\u003cp class=\"MsoNormal\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/66/72/f4/8bc9d7b28770cb6670be1645233f7474.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\"\u003eSau khi sử dụng hoặc cần diện tích không gian ở, bạn có thể xếp gọn dễ dàng, nhanh chóng chiếc ghế xếp có khay đựng ly MK-116 này để di chuyển thuận lợi \u0026amp; không chiếm diện tích không gian sống căn hộ nhà bạn.\u003c/p\u003e\n\u003cp class=\"MsoNormal\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/8a/c7/a1/c463cc06e36239ca79660c4031a70ee4.jpg\" alt=\"\" width=\"500\" height=\"500\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/22/a0/05/558131fced4c59712d8a3c4ea68be9af.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/22/a0/05/558131fced4c59712d8a3c4ea68be9af.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/22/a0/05/558131fced4c59712d8a3c4ea68be9af.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/22/a0/05/558131fced4c59712d8a3c4ea68be9af.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/22/a0/05/558131fced4c59712d8a3c4ea68be9af.png"},{"base_url":"https://salt.tikicdn.com/ts/product/f2/ac/e8/21920fbf5fcaf47236cc8ba942bb9cf5.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f2/ac/e8/21920fbf5fcaf47236cc8ba942bb9cf5.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f2/ac/e8/21920fbf5fcaf47236cc8ba942bb9cf5.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f2/ac/e8/21920fbf5fcaf47236cc8ba942bb9cf5.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f2/ac/e8/21920fbf5fcaf47236cc8ba942bb9cf5.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/3c/dd/8b/6adcb2d87dc549c4bab6f97bb204c705.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/3c/dd/8b/6adcb2d87dc549c4bab6f97bb204c705.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/3c/dd/8b/6adcb2d87dc549c4bab6f97bb204c705.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3c/dd/8b/6adcb2d87dc549c4bab6f97bb204c705.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3c/dd/8b/6adcb2d87dc549c4bab6f97bb204c705.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/bc/eb/39/cf0341060bc211a687fb9c6574efe