nd_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/d2/e5/07/bac35995b59c464c0112d1a22e1e1459.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":966,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eTHÔNG ĐIỆP CỦA CUỐN SÁCH\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003e“Khi tuyệt vọng nhất, rất có thể là lúc con người mới trong bạn hồi sinh. Hết mình cố gắng, vượt qua trắc trở, đó là cách duy nhất để bạn sinh tồn giữa thế giới khắc nghiệt này\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eCó bậc thầy từng bảo, người nhiều cảm xúc thì sống với quá khứ, người tự tại sống cho hiện tại, còn người lúc nào cũng sống với tương lai, người ấy ‘điên’ mất rồi! \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eChỉ khi nỗ lực cho hiện tại, bạn mới cảm nhận được sự thanh thản từ sâu trái tim. Lúc đó, với mọi khó khăn, bạn có thể tự vỗ vai mình và nói: Mọi chuyện sẽ ổn thôi! Từ đó, giải quyết mọi việc một cách dễ dàng”\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eĐÔI ĐIỀU VỀ TÁC GIẢ\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003e \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eBút danh: Huế LyLy\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eSinh năm 1992\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eBà chủ công ty TNHH LyLy\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eKinh doanh nhiều thứ\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eMột cô gái mới gần 30, nhưng giống như đã sống mấy cuộc đời, lăn lộn và hết mình từ những ngày thơ bé nhất…\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eGIỚI THIỆU SÁCH\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eKhi tuyệt vọng nhất, rất có thể là lúc con người mới trong bạn hồi sinh. Hết mình cố gắng, vượt qua trắc trở, đó là cách duy nhất để bạn sinh tồn giữa thế giới khắc nghiệt này\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eCó bậc thày từng bảo, người nhiều cảm xúc thì sống với quá khứ, người tự tại sống cho hiện tại, còn người lúc nào cũng sống với tương lai, người ấy “điên” mất rồi! \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eThú thật, có nhiều lúc tôi đã sống với cả quá khứ và tương lai, chập chừng giữa những miền cảm xúc và kế hoạch hành động. Cho đến một thời điểm, trải qua những thử thách lớn nhỏ, tôi nhận ra: Chỉ khi nỗ lực cho hiện tại, bạn mới cảm nhận được sự thanh thản từ sâu trái tim. Lúc đó, với mọi khó khăn, bạn có thể tự vỗ vai mình và nói: Mọi chuyện sẽ ổn thôi! Từ đó, giải quyết mọi việc một cách dễ dàng\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003e--\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eTrưởng thành, người ta sẽ có rất nhiều sự thay đổi. Nhiều ngôi nhà mới mọc lên, công việc kinh doanh nhiều thử thách hơn, còn những mối quan hệ… Dẫu có bao nhiêu thay đổi, tôi vẫn luôn mỉm cười mỗi khi nhớ về thanh xuân. \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eVì đó là những ngày tháng tôi sống hết mình và cống hiến cho con đường đã lựa chọn\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eNếu còn một tuổi trẻ để sống, hãy trân trọng nó và làm tốt nhất những mình gì có thể\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eCuốn sách này là cuộc sống, là vất vả, là bi kịch của tôi, cũng là tuổi trẻ, là khát vọng, là mong ước kinh doanh tôi ấp ủ và nuôi lớn. Hy vọng rằng, chia sẻ của tôi sẽ đồng hành với bạn, đem đến cảm hứng sống, mục tiêu và cả lời an ủi, cũng như những kinh nghiệm lí trí nhất\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eChúc bạn có một tuổi trẻ rạng ngời, một hành trình đích đáng!\u003c/span\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/d2/e5/07/bac35995b59c464c0112d1a22e1e1459.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d2/e5/07/bac35995b59c464c0112d1a22e1e1459.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d2/e5/07/bac35995b59c464c0112d1a22e1e1459.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d2/e5/07/bac35995b59c464c0112d1a22e1e1459.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/p