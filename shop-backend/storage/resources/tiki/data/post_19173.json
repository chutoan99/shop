_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/b7/d2/2a/61ea5141ee1b1df5b795491c09135c4b.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1416,"all_time_quantity_sold":24,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cdiv class=\"kvgmc6g5 cxmmr5t8 oygrvhab hcukyx3x c1et5uql\"\u003eBạn đang muốn vất hết đống dầu gội sặc mùi hoá chất ?\u003c/div\u003e\n\u003cdiv class=\"o9v6fnle cxmmr5t8 oygrvhab hcukyx3x c1et5uql\"\u003eNhững sản phẩm khiến tóc bạn càng xơ rối, hư tổn hơn ?\u003c/div\u003e\n\u003cdiv class=\"o9v6fnle cxmmr5t8 oygrvhab hcukyx3x c1et5uql\"\u003eDầu Gội Sinh Khương sẽ là giải pháp cho mái tóc bạn :\u003cbr /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/71/2e/00/f34393acd61ad4309a31bcccee2967b8.jpg\" alt=\"\" width=\"750\" height=\"499\" /\u003e\u003c/div\u003e\n\u003cdiv class=\"o9v6fnle cxmmr5t8 oygrvhab hcukyx3x c1et5uql\"\u003eCÔNG DỤNG :\u003c/div\u003e\n\u003cdiv class=\"o9v6fnle cxmmr5t8 oygrvhab hcukyx3x c1et5uql\"\u003eNgăn rụng tóc, kích thích mọc tóc Làm đen tóc, hỗ trợ trị gàu và làm sạch sâu da đầu Làm chắc cơ nang tóc Giữ ấm da đầu, ngừa cảm lạnh Giúp lưu thông tuần hoàn máu dưới da đầu Giảm đau đầu, giảm stress và mang đến cảm giác thư giãn\u003c/div\u003e\n\u003cdiv class=\"o9v6fnle cxmmr5t8 oygrvhab hcukyx3x c1et5uql\"\u003eCÁCH DÙNG :\u003c/div\u003e\n\u003cdiv class=\"o9v6fnle cxmmr5t8 oygrvhab hcukyx3x c1et5uql\"\u003eLàm ướt tóc, thoa dầu gội Massage tóc nhẹ nhàng 5-10 phút để làm sạch bụi bẩn và thư giãn da đầu Xả sạch tóc với nước, lặp lại lần nữa (nếu muốn). Thoa dầu gội lên tóc, tiếp tục massage da đầu tầm 5 phút rồi xả sạch Dùng khăn mềm lau khô tóc, chờ tóc khô tự nhiên, thực hiện đều đặn tuần 2-3 lần để cảm nhận sự khác biệt\u003c/div\u003e\n\u003cdiv class=\"o9v6fnle cxmmr5t8 oygrvhab hcukyx3x c1et5uql\"\u003eĐỐI TƯỢNG SỬ DỤNG :\u003c/div\u003e\n\u003cdiv class=\"o9v6fnle cxmmr5t8 oygrvhab hcukyx3x c1et5uql\"\u003eDùng được cho tất cả mọi người Đặc biệt là những người hay uốn duỗi nhuộm bị hư tổn lâu năm, muốn phục hồi mái tóc đẹp, người bị gàu, rụng tóc Hoặc dùng thay dầu gội hóa chất thông thường mỗi ngày.\u003cbr /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/b7/d2/2a/42dceaf3fd8a864fb620a1bb6bf6e2c6.jpg\" alt=\"\" width=\"600\" height=\"600\" /\u003e\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/b7/d2/2a/61ea5141ee1b1df5b795491c09135c4b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b7/d2/2a/61ea5141ee1b1df5b795491c09135c4b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b7/d2/2a/61ea5141ee1b1df5b795491c09135c4b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b7/d2/2a/61ea5141ee1b1df5b795491c09135c4b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b7/d2/2a/61ea5141ee1b1df5b795491c09135c4b.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/85/35/ce/e18df5b2653b3319e307f4dde3da8734.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/85/35/ce/e18df5b2653b3319e307f4dde3da8734.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/85/35/ce/e18df5b2653b3319e307f4dde3da8734.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/85/35/ce/e18df5b2653b3319e307f4dde3da8734.jpg","thumbnail_url":"https://salt.tik