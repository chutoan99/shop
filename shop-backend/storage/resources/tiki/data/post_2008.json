d_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":48400,"discount_rate":40,"rating_average":4.7,"review_count":14,"review_text":"(14)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/2c/1f/9d/eb5e6c84eb0aa8f9d6e7460f7bef45e1.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":630,"all_time_quantity_sold":151,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/767e2687b6341a4492b41085fcb1ceee\" alt=\"767e2687b6341a4492b41085fcb1ceee\" /\u003e\u003c/p\u003e\n\u003cp\u003eNƯỚC CHẤM CÁ CƠM THAN LÀNG CHÀI XƯA CHAI NHỰA CAO CẤP 2 LÍT/CHAI ĐẶC BIỆT THANH DỊU AN TOÀN TIẾT KIỆM\u003c/p\u003e\n\u003cp\u003eMÔ TẢ SẢN PHẨM\u003c/p\u003e\n\u003cp\u003e- Nước chấm cá cơm than làng chài xưa chai nhựa cao cấp 2 LÍT/chai đặc biệt thanh dịu an toàn tiết kiệm\u003c/p\u003e\n\u003cp\u003esánh đặc thịt cá đặc biệt có hương vị thanh dịu được ủ chượp từ 100% cá cơm tươi trong thùng lều gỗ lâu năm.\u003c/p\u003e\n\u003cp\u003e- Nước chấm Làng Chài Xưa chuyên dùng để chấm ăn sống hoặc nêm nếm khi nấu ăn.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/sg-11134202-22120-eh7ucvtnl0kvb5\" alt=\"sg-11134202-22120-eh7ucvtnl0kvb5\" /\u003e\u003c/p\u003e\n\u003cp\u003e-THÔNG TIN SẢN PHẨM\u003c/p\u003e\n\u003cp\u003eNước chấm cá cơm than Làng Chài Xưa, nước chấm ngon phù hợp cho bữa cơm của mọi gia đình Việt.\u003c/p\u003e\n\u003cp\u003e+ Nước chấm cốt nhỉ đặc biệt vị thanh dịu , an toàn, tiết kiệm\u003c/p\u003e\n\u003cp\u003e+ Sản phẩm chất lượng của bảo tàng nước mắm Làng Chài Xưa Phan Thiết\u003c/p\u003e\n\u003cp\u003e+ Chai nhựa cao cấp 2 lít\u003c/p\u003e\n\u003cp\u003eQUY TẮC BẢO QUẢN\u003c/p\u003e\n\u003cp\u003e- Bảo quản nơi khô ráo, thoáng mát, tránh ánh nắng trực tiếp.\u003c/p\u003e\n\u003cp\u003e- Ăn sống hoặc nêm nếm món ăn, đậy nắp kín sau khi sử dụng.\u003c/p\u003e\n\u003cp\u003e- Nước chấm chuẩn truyền thống nên khi để lâu nước mắm sẽ sậm màu và mùi cá cơm chín tự nhiên sẽ không còn như ban đầu nữa.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/sg-11134202-22120-9u8q3l8nl0kvbf\" alt=\"sg-11134202-22120-9u8q3l8nl0kvbf\" /\u003e\u003c/p\u003e\n\u003cp\u003eHẠN SỬ DỤNG: 12 tháng kể từ ngày sản xuất, sau khi đã mở nắp thì nên sử dụng trong vòng 3 tháng để đảm bảo nguyên vẹn hương vị.\u003c/p\u003e\n\u003cp\u003eNƯỚC CHẤM CÁ CƠM THAN LÀNG CHÀI XƯA CHAI NHỰA CAO CẤP 525ML/CHAI ĐẶC BIỆT THANH DỊU AN TOÀN TIẾT KIỆM\u003c/p\u003e\n\u003cp\u003e+ Là nguyên liệu chế biến món ăn.\u003c/p\u003e\n\u003cp\u003e+ Là gia vị không thể thiếu trong bữa ăn gia đình.\u003c/p\u003e\n\u003cp\u003e+ Đặc sản Phan Thiết (Việt Nam)\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product