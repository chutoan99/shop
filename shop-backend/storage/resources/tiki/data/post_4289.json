.2,"review_count":27,"review_text":"(27)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/a7/57/1d/60d1aa9ad559ea8c8309c046d465884f.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1813,"all_time_quantity_sold":274,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eVideo hướng dẫn diệt mối tận gốc\u003c/strong\u003e\u003cbr /\u003e\u003ciframe src=\"//www.youtube.com/embed/eA9gMnlLwvk\" width=\"853\" height=\"480\" frameborder=\"0\" allowfullscreen=\"allowfullscreen\"\u003e\u003c/iframe\u003e\u003c/p\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cp\u003e\u003cstrong\u003eBước 1:\u003c/strong\u003e\u003cbr /\u003eNhúng ướt hộp nhữ mối Tìm ở những nơi có vị trí mối ăn nhiều để đặt hộp nhử mối. Dùng dây để cột cố định hộp nhử mối nếu hộp như mối có thể bị chó mèo hay trẻ em làm xê dịch. Dùng giấy báo nhúng ẩm nước để tủ hộp nhử mối lại để tăng thêm độ ẩm cho hộp nhử mối. Thời gian đặt hộp nhử mối là 10 đến 15 ngày tùy theo số lượng mối trong nhà nhiều hay it. Nhiều thì khoản 10 ngày còn ít thì 15 ngày.\u003cbr /\u003e\u003cbr /\u003e\u003c/p\u003e\n\u003cdiv\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/a7/57/1d/92945a63b59050f6895121707cad8539.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/a7/57/1d/92945a63b59050f6895121707cad8539.jpg\" alt=\"\" width=\"750\" height=\"663\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/6b/3b/e0/3fa62a11aa1494a48a07ffaac4311b86.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/6b/3b/e0/3fa62a11aa1494a48a07ffaac4311b86.jpg\" alt=\"\" width=\"750\" height=\"561\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/28/5e/68/64e37d6bda4108eb3da76a149934a208.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/28/5e/68/64e37d6bda4108eb3da76a149934a208.jpg\" alt=\"\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/6c/87/a0/d9ea66f6cd3d845be21b61ba6ed8af28.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/6c/87/a0/d9ea66f6cd3d845be21b61ba6ed8af28.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv\u003e\u003cem\u003e\u003cbr /\u003eHình ảnh hộp nhữ mối và thuốc PMC90\u003cbr /\u003e\u003cbr /\u003e\u003c/em\u003e\u003c/div\u003e\n\u003cp\u003e\u003cstrong\u003eBước tiếp theo\u003c/strong\u003e là quy trình phun thuốc diệt mối tận gốc PMC 90 vào hộp nhử - gây bệnh cho mối:\u003cbr /\u003eSau 10 đến 15 ngày chúng ta tiến hành lấy những con mối đang ăn trong hộp nhữ mối ra tờ giấy báo và tiến hành phun thuốc diệt mối tận gốc PMC90 vào những con mối để trên tờ giấy báo. Xịt xong trộn đều lên để chắc rằng những con mối này đã dính thuốc đều ( tránh để cho mối chết) ta đổ những con mối xử lý trên tờ báo vào hộp nhữ và đặt lại chổ cũ. Khoảng 5 ngày sau thì ta dọn dẹp những hộp nhữ. Thuốc diệt mối tận gốc PMC 90 dạng bột được pha chế sẳn trong chai 100 Gr và chúng ta dùng ngay không pha chế thêm bất cứ thứ gì khác.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/a7/57/1d/60d1aa9ad559ea8c8309c046d465884f.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a7/57/1d/60d1aa9ad559ea8c8309c046d465884f.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a7/57/1d/60d1aa