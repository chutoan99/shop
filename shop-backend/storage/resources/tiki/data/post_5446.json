te_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/82/81/aa/74bb939e21c16051653c2b30f6578562.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1112,"all_time_quantity_sold":157,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: center;\"\u003e\u003cstrong\u003eTHÙNG 30 GÓI MÌ GÀ SỢI PHỞ GẤU ĐỎ 63G\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eSợi mì phở dai ngon, mềm mịn Nước súp với mùi thơm tinh tế của gà Đảm bảo vệ sinh an toàn thực phẩm Tiết kiệm thời gian nấu nướng\u003c/p\u003e\n\u003cp\u003eXuất xứ: Việt Nam\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/39/2a/64/64ed36c03ed5fc9c477ff9716fe8890b.jpg\" alt=\"\" width=\"750\" height=\"562\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThùng 30 Gói Mì Gấu Đỏ Vị Gà Sợi Phở \u003c/strong\u003eđược sản xuất từ nguyên liệu bột mì, bổ sung thêm thành phần khoai tây, tạo nên sợi mì dai ngon tự nhiên hòa cùng nước súp đậm đà, dậy mùi hành phi. Mì Gấu Đỏ vị gà sợi phở hành phi là món ăn tiện lợi cho người bận rộn, chỉ mất 3 phút là bạn đã có một món ăn thơm ngon.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/24/02/a3/a8250ddcd2991da5dc15e5b5c98dbd6b.jpg\" alt=\"\" width=\"750\" height=\"562\" /\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eThành phần dinh dưỡng trong 1 gói 65gr: Năng lượng tổng 293.3Kcal (Trong đó: Chất béo 12.1g, Natri/Sodium 980mg, Carbonhydrate 45g, Protein 5.6g)\u003c/li\u003e\n\u003cli\u003eMì Gấu Đỏ cung cấp nhiều dưỡng chất và năng lượng cần thiết cho cơ thể của bạn với các thành phần từ Bột mì, tinh bột khoai mì, shortening, muối, đường…\u003c/li\u003e\n\u003cli\u003eSản phẩm với những sợi mì mỏng mịn, giòn dai và nước súp mang hương vị thơm ngon từ 100% tôm và gà thật, hòa quyện cùng hành phi sa tế ngon tuyệt đem lại cho bạn trải nghiệm khó quên.\u003c/li\u003e\n\u003cli\u003eBạn cũng có thể kết hợp sản phẩm cùng các loại rau, trứng, thị để làm tăng hương vị và giá trị dinh dưỡng cho tô mì.\u003c/li\u003e\n\u003cli\u003eMì Gấu Đỏ được sản xuất theo công nghệ hiện đại, tiên tiến, đảm bảo vệ sinh an toàn thực phẩm, an toàn cho sức khỏe của gia đình bạn.\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/82/81/aa/74bb939e21c16051653c2b30f6578562.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/82/81/aa/74bb939e21c16051653c2b30f6578562.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/82/81/aa/74bb939e21c16051653c2b30f6578562.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/82/81/aa/74bb939e21c16051653c2b30f6578562.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/82/81/aa/74bb939e21c16051653c2b30f6578562.png"},{"base_url":"https://salt.tikicdn.com/ts/product/24/02/a3/e2a37a6b81a0351e4adf2c081f53b443.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/24/02/a3/e2a37a6b81a0351e4adf2c081f53b443.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/24/02/a3/e2a37a6b81a0351e4adf2c081f53b443.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/24/02/a3/e2a37a6b81a0351e4adf2c081f5