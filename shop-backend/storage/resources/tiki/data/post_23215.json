ight":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/a7/4b/cb/01a0ed5ca93c230fadb3a3690234498c.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1060,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eMáy lọc nước ion kiềm Trimion Hyper nội địa Nhật Bản, chính hãng, sở hữu nhiều tính năng nổi bật giúp chăm sóc sức khỏe \u0026amp; sắc đẹp toàn diện. \u003c/span\u003e\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003e1. Vì sao nên sở hữu máy lọc nước ion kiềm Trimion Hyper?\u003c/strong\u003e\u003c/h2\u003e\n\u003ch3\u003e\u003cstrong\u003e1.1 Máy lọc nước ion kiềm Trimion Hyper tốt cho sức khỏe với 7 loại nước đa chức năng\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eMáy lọc nước ion kiềm Trimion Hyper có khả năng tạo ra 7 loại nước với độ pH ~3.5 - 10.5 giúp đáp ứng nhiều nhu cầu sử dụng như: \u003c/span\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eNước ion kiềm cấp độ 1 pH ~8.5: Dành cho người trưởng thành mới bắt đầu uống nước ion kiềm, tốt cho sức khỏe. \u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eNước ion kiềm cấp độ 2 pH ~9.0: Nước uống dành cho người quen uống nước ion kiềm sau 1 tuần và nấu cơm.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eNước ion kiềm cấp độ 3 pH ~9.5: Nước uống và dùng để pha trà, nấu ăn. \u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eNước ion kiềm cấp độ 4 pH ~ 10.5: Nước kiềm mạnh, giúp rửa rau củ quả sạch hơn, an toàn hơn, loại bỏ vị chát.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eNước lọc trung tính pH ~7.0: Nước phù hợp để pha sữa \u0026amp; nấu ăn cho em bé.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eNước ion axit yếu pH ~5.5: Dùng để làm đẹp như rửa mặt, gội đầu giúp da căng mịn, tóc mượt mà hơn.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eNước ion axit mạnh pH ~3.5: Vệ sinh, khử khuẩn.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003e\u003cspan style=\"font-weight: 400;\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/d4/7b/76/a1eb198e250dc1dfd72e8a51d584daea.png\" alt=\"Máy lọc nước ion kiềm Trimion Hyper tạo ra 7 loại nước đa chức năng giúp chăm sóc sức khỏe toàn diện\" width=\"640\" height=\"480\" /\u003eMáy lọc nước ion kiềm Trimion Hyper tạo ra 7 loại nước đa chức năng giúp chăm sóc sức khỏe toàn diện\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003e1.2 Sở hữu 5 tấm điện cực Titan phủ bạch kim\u003c/strong\u003e\u003cspan style=\"font-weight: 400;\"\u003e \u003c/span\u003e\u003c/h3\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eMáy lọc nước ion kiềm Trimion Hyper được trang bị 5 tấm điện cực Titan phủ bạch kim giúp tạo nước ion kiềm có nồng độ Hydro ~ 800 ppb tốt cho sức khỏe. Các tấm điện cực được làm từ Titan phủ bạch kim giúp máy có hiệu suất hoạt động cao và tạo 7 loại nước chức năng khác nhau dao động trong dải pH ~3.5 ~ 10.5. \u003c/span\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003e1.3 Công nghệ tự động làm sạch điện cực Double Auto Change Crossline\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eMáy điện giải Trimion Hyper được trang bị công nghệ độc quyền tự động đảo chiều điện cực (Double Auto Change Crossline), hoạt động với cơ chế đổi chiều liên tục dòng điện và dòng nước, khiến các khoáng chất khó bám vào các tấm điện cực. Tính năng này giúp các tấm điện cực bền bỉ và sạch sẽ với thời gian, đem lại độ bền siêu việt (lên đến trên 15 năm).\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003e\u003cspan style=\"font-weight: 400;\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/64/25/48/d2d8988aa5c698528e2e88d4f0638faf.jpg\" alt=\"Công nghệ tự động đảo chiều điện cực giúp loại bỏ các mảng bám cặn trên bề mặt điện cực\" width=\"500\" height=\"304\" /\u003eCông nghệ tự động đảo chiều điện cực giúp loại bỏ các mảng bám cặn trên bề mặt điện cực\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003e1.4 Lõi lọc tinh được sản xuất theo tiêu chuẩn NSF\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eLõi lọc tinh máy lọc nước ion kiềm Trimion Hyper được sản xuất tại Nhật Bản, theo tiêu chuẩn NSF (chứng nhận an toàn vệ sinh thực phẩm đối với than hoạt tính trong lõi lọc tinh). Nước đầu ra của lõi lọc tinh máy điện giải Trimion Hyper có khả năng loại bỏ 17 chất độc hại trong nước theo tiêu chuẩn công nghiệp Nhật Bản - JIS. Vì vậy, nước sau lọc của máy đạt chuẩn nước uống tiêu chuẩn JIS và tiêu chuẩn nước uống tại Việt Nam.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003e\u003cspan style=\"font-weight: 400;\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/13/ba/9f/69bf32cbb8349229f16719ef2877e17d.jpg\" alt=\"Lõi lọc tinh máy điện giải Trimion Hyper đạt chứng nhận NSF\" width=\"500\" height=\"342\" /\u003eLõi lọc tinh máy điện giải Trimion Hyper đạt chứng nhận NSF\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003e1.5 Máy lọc nước ion kiềm Trimion Hyper có thiết kế nhỏ gọn, tinh tế\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eMáy điện giải Trimion Hyper có thiết kế phần vòi nước và thân máy tách rời, do đó người dùng có thể lắp tại bồn rửa, treo tường... tùy ý. Phần vòi rời tách biệt giúp lắp đặt tiện lợi cũng như tạo được tính thẩm mỹ cho không gian của ngôi nhà. Đây cũng chính là điểm khác biệt nổi trội của máy điện giải Trimion Hyper thế hệ mới so với dòng máy thế hệ cũ (đã ngưng sản xuất).\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003e\u003cspan style=\"font-weight: 400;\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/d9/7f/3a/ee4b586a9439836b4275f7165c2b91ad.jpg\" alt=\"Lõi lọc tinh máy điện giải Trimion Hyper đạt chứng nhận NSF\" width=\"500\" height=\"288\" /\u003eMáy lọc nước ion kiềm Trimion Hyper thế hệ mới có phần vòi rời tách biệt với phần thân máy\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eMáy lọc nước ion kiềm Trimion Hyper được trang bị bộ đèn LED cùng bảng điều khiển hiển thị trực quan kết hợp hệ thống âm thanh báo hiệu. Bảng điều khiển hiển thị các thông tin như vạch báo chế độ nước khi chọn, chỉ số nồng độ Hydro hòa tan, tuổi thọ của lõi lọc giúp người dùng có thể theo dõi quá trình sử dụng.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003e\u003cspan style=\"font-weight: 400;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/8f/4c/bf/b51a15ea63e9851d0f4086dbb4eba81a.png\" alt=\"Màn hình máy Trimion Hyper trực quan giúp người dùng dễ quan sát và sử dụng\" width=\"512\" height=\"512\" /\u003e\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003e\u003cspan style=\"font-weight: 400;\"\u003eMàn hình máy Trimion Hyper trực quan giúp người dùng dễ quan sát và sử dụng\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003e1.6 Máy lọc nước ion kiềm Trimion Hyper được sản xuất bởi tập đoàn Nihon Trim tại Nhật Bản\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eMáy lọc nước ion kiềm Trimion Hyper là dòng máy nội địa được nghiên cứu và sản xuất bởi tập đoàn Nihon Trim tại Nhật Bản. Tập đoàn có nhiều năm kinh nghiệm chuyên nghiên cứu về nước sức khỏe, Nihon Trim luôn nỗ lực hết mình nghiên cứu, mang tới những công nghệ và giải pháp toàn diện về nước để góp phần nâng cao sức khỏe. Đó cũng chính là lý do máy lọc nước ion kiềm nội địa Trimion Hyper được người dân Nhật Bản yêu thích và tin dùng.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003e\u003cspan style=\"font-weight: 400;\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/0f/f6/22/f394cce4dd7bb457db97cbca4fe7ae45.jpg\" alt=\"\" width=\"750\" height=\"269\" /\u003eMáy lọc nước ion kiềm Trimion Hyper là sản phẩm nội địa của Nhật Bản, sản xuất bởi hãng Nihon Trim\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003e2. Thông số kỹ thuật máy lọc nước ion kiềm Trimion Hyper\u003c/strong\u003e\u003c/h2\u003e\n\u003cul\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eSố tấm điện cực: 5 tấm điện cực nguyên khối Titan phủ Platinum \u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eBộ phận lọc nước: 1 lõi, 2 tầng lọc (vải không dệt, Micro-carbon)\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eNồng độ Hydro: ~ 800 ppb\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eDải pH: ~ 3.5 - 10.5\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eSố loại nước: 7 \u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eChế độ vệ sinh: Vệ sinh tự động bằng công nghệ Double Auto Change Crossline (đảo chiều điện cực tự động kép)\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eTốc độ tạo nước sử dụng: 4,0 - 5,0 lít/phút\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eMàn hình: LCD \u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eĐiều khiển: Bảng điều khiển cảm ứng\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eThông báo: Âm thanh báo động, đèn tín hiệu\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eNgôn ngữ: Tiếng Nhật\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eĐiện áp: 100 (V) \u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eCông suất: 300 (W)\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eKích thước: 112,5 x 234 x 239 mm (dài x rộng x cao)\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eTrọng lượng khi chưa chứa nước: 2,8 kg\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eTuổi thọ: \u0026gt; 15 năm\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eBảo hành chính hãng: 5 năm cho tấm điện cực, 2 năm cho thân máy\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eCác chứng nhận chất lượng: \u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cul\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eJIS - Loại bỏ 17 chất độc theo quy định Tiêu chuẩn công nghiệp Nhật\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eISO 13485 Tiêu chuẩn quốc tế về hệ thống quản lý chất lượng cho thiết bị đạt chuẩn y tế\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eISO 9001 Tiêu chuẩn quốc tế về hệ thống quản lý chất lượng\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eNSF - Chứng nhận an toàn vệ sinh thực phẩm đối với than hoạt tính trong lõi lọc tinh\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\" aria-level=\"1\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eChứng nhận thiết bị đạt chuẩn y tế tại Nhật Bản - số: 226AGBZX00012000\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/a7/4b/cb/01a0ed5ca93c230fadb3a3690234498c.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a7/4b/cb/01a0ed5ca93c230fadb3a3690234498c.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a7/4b/cb/01a0ed5ca93c230fadb3a3690234498c.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a7/4b/cb/01a0ed5ca93c230fadb3a3690234498c.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a7/4b/cb/01a0ed5ca93c230fadb3a3690234498c.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/8f/4c/bf/a0bed592625c19ea3995bd4816b853d0.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/8f/4c/bf/a0bed592625c19ea3995bd4816b853d0.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/8f/4c/bf/a0bed592625c19ea3995bd4816b853d0.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8f/4c/bf/a0bed592625c19ea3995bd4816b853d0.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8f/4c/bf/a0bed592625c19ea3995bd4816b853d0.png"},{"base_url":"https://salt.tikicdn.com/ts/product/43/9c/5a/ff281e9f1e62d5f9c04564e8e4b6485a.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/43/9c/5a/ff281e9f1e62d5f9c04564e8e4b6485a.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/43/9c/5a/ff281e9f1e62d5f9c04564e8e4b6485a.pn