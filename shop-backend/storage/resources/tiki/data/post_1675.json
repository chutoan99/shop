olor":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":14000,"discount_rate":14,"rating_average":4.8,"review_count":5,"review_text":"(5)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/53/21/5c/53a4cd84ce69f73d28132bbc2513e4e9.png","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1721,"all_time_quantity_sold":40,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003eGiới thiệu:\u003c/h3\u003e\n\u003cdiv class=\"flex-shrink-0 flex flex-col relative items-end\"\u003e\n\u003cdiv class=\"pt-0.5 juice:pt-0\"\u003e\n\u003cdiv class=\"gizmo-bot-avatar flex h-6 w-6 items-center justify-center overflow-hidden rounded-full juice:h-8 juice:w-8\"\u003e\n\u003cdiv class=\"relative p-1 rounded-sm flex items-center justify-center bg-token-main-surface-primary text-token-text-primary h-6 w-6\"\u003eĐồ chơi trí tuệ cờ cá ngựa là một trò chơi mang đến cho người chơi những trải nghiệm độc đáo và hấp dẫn. Trò chơi này được thiết kế để kích thích trí tuệ và tư duy chiến thuật của người chơi.\u003c/div\u003e\n\u003ch3 class=\"relative p-1 rounded-sm flex items-center justify-center bg-token-main-surface-primary text-token-text-primary h-6 w-6\"\u003eChất liệu\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cp\u003eNhựa: Các cờ cá ngựa có thể được làm từ nhựa, đặc biệt là những loại nhựa chất lượng cao như nhựa ABS, PP, PVC. Nhựa có thể được sử dụng vì nó đủ mềm để không gây tổn thương nếu bị va đập nhẹ và có thể được màu sắc đa dạng.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eGỗ: Các cờ cũng có thể được làm từ gỗ, đặc biệt là gỗ tự nhiên hoặc gỗ cứng như gỗ thông, gỗ sồi, hoặc gỗ dầu. Gỗ thường được sử dụng để làm cờ cho vẻ đẹp tự nhiên, đồng thời có độ bền tốt.\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003eĐặc điểm nổi bật\u003c/h3\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cspan class=\"text\"\u003eBộ đồ chơi \"Cờ cá ngựa bằng nhựa SATO\"  thuộc nhóm đồ chơi trí tuệ dành cho đối tượng trẻ từ 3 tuổi trở lên. Với các đặc điểm nổi bật là:\u003c/span\u003e\u003c/li\u003e\n\u003cli\u003e\u003cspan class=\"text\"\u003eSản phẩm được làm từ 100% nhựa nguyên sinh tại Việt Nam\u003c/span\u003e\u003c/li\u003e\n\u003cli\u003e\u003cspan class=\"text\"\u003eKích thước bàn cờ 242 x 242 x 19 (mm) nhỏ gọn thuận tiện cho các bé bỏ vào cặp để mang đến trường chơi cùng bạn bè\u003c/span\u003e\u003c/li\u003e\n\u003cli\u003e\u003cspan class=\"text\"\u003eQuân cờ lớn, các chi tiết trên quân cờ như mắt ngựa, bờm ngựa, thân ngựa được thiết kế tinh xảo; tuyệt đối không có via sắc.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cspan class=\"text\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/74/9d/58/48b3f198d247b04e90c80610b3f46b10.jpeg\" alt=\"\" width=\"555\" height=\"555\" /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cspan class=\"text\"\u003eBên trong quân cờ cá ngựa chứa các hạt nhựa nhỏ, khi người chơi di chuyển quân cá ngựa trên bàn cờ sẽ nghe tiếng âm thanh vui tai, tạo bầu không khí vui nhộn, kịch tính hơn trong ván chơi\u003c/span\u003e\u003c/li\u003e\n\u003cli\u003e\u003cspan class=\"text\"\u003eCác chi tiết được cất gọn bên trong bàn cờ sau khi chơi xong, thuận tiện cho việc bảo quản và mang đi mọi nơi\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cspan class=\"text\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/b7/6c/72/2776a84ea48b91a41ae4e5d924a4e5c8.jpg\" alt=\"\" width=\"509\" height=\"371\" /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cspan class=\"text\"\u003eCờ cá ngựa là trò chơi rất thú vui mà trẻ nào cũng thích, nó mang lại cho trẻ cảm giác vừa hồi hộp, vừa gay cấn và niềm vui mỗi khi chiến thắng.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003e\u003cstrong\u003eHướng dẫn cách chơi:\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003e\u003cstrong\u003eBộ cờ cá ngựa cơ bản gồm: \u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e2 viên xúc xắc.\u003c/li\u003e\n\u003cli\u003e1 bàn cờ hình vuông được vẽ sẵn.\u003c/li\u003e\n\u003cli\u003e16 quân cờ ( 4 quân cờ màu đỏ, 4 quân cờ màu xanh dương, 4 quân cờ xanh lá, 4 quan cờ màu vàng).\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eThiết lập trò chơi\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eChuẩn bị đồ tung xúc xắc (nếu cần) như cốc lắc xúc xắc hay chén nhựa.\u003c/li\u003e\n\u003cli\u003eTrải bàn cờ và chia 16 quân cờ theo màu.\u003c/li\u003e\n\u003cli\u003eMỗi người chơi chọn 1 trong 4 màu và nhận 4 quân cờ theo màu sắc đã chọn và đặt vào vị trí màu tương ứng trên bàn cờ.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eĐiều kiện thắng\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eNgười chơi phải đưa tất cả 4 quân cờ của mình về chuồng (cùng màu với quân cờ đã chọn) theo thứ tự 6, 5, 4, 3 đầu tiên sẽ là người chiến thắng.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/53/21/5c/53a4cd84ce69f73d28132bbc2513e4e9.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/53/21/5c/53a4cd84ce69f73d28132bbc2513e4e9.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product