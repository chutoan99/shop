,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/61/6e/02/fcbae3520c26341d0f993e2c35da106e.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":688,"all_time_quantity_sold":9,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://cf.shopee.vn/file/ef86543a7c0ec64575068201c5307ad5\" alt=\"ef86543a7c0ec64575068201c5307ad5\" width=\"700\" height=\"466\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eTHÔNG TIN SẢN PHẨM:\u003c/p\u003e\n\u003cp\u003eHỘP 3 CUỐN SỔ LÒ XO BÌA CỨNG VỚI 2 KÍCH THƯỚC: A4, A5 (240 TRANG)\u003c/p\u003e\n\u003cp\u003eThương hiệu: HANOTE\u003c/p\u003e\n\u003cp\u003eDòng sổ: Sổ lò xo 240 trang (hộp 3 cuốn)\u003c/p\u003e\n\u003cp\u003eXuất xứ: Việt Nam\u003c/p\u003e\n\u003cp\u003eĐóng gói: 3 cuốn sổ/hộp (tặng kèm sticker)\u003c/p\u003e\n\u003cp\u003eBộ gồm 3 cuốn sổ với các màu: Xanh Sapphire, Đen trơn, Nâu nhạt.\u003c/p\u003e\n\u003cp\u003eKích thước (2 loại):\u003c/p\u003e\n\u003cp\u003e5,5 x 8,5 inch (A5)\u003c/p\u003e\n\u003cp\u003e8.5 x 11 inch (A4)\u003c/p\u003e\n\u003cp\u003eNăm sản xuất: 2019\u003c/p\u003e\n\u003cp\u003eMỗi quyển vở có 240 trang, có lề đầu dòng, khoảng cách giữa các dòng 0.27 inch.\u003c/p\u003e\n\u003cp\u003eCó thể gập 360 độ, thiết kế xoắn ốc, dễ viết.\u003c/p\u003e\n\u003cp\u003ePhù hợp trong môi trường văn phòng, xu hướng giới trẻ và cuộc họp, kinh doanh hoặc tại trường học, giúp bạn trở nên chuyên nghiệp hơn.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/8fc080d449daa73c54853611f9a95a62\" alt=\"8fc080d449daa73c54853611f9a95a62\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eMÔ TẢ SẢN PHẨM:\u003c/p\u003e\n\u003cp\u003eChất liệu sổ làm từ giấy Ivory cao cấp, chuyên được sử dụng để sản xuất những cuốn sổ đắt nhất thế giới của Mo.les.kin... chống lóa, mỏi mắt, không nhòe, không thấm mực, không lem.\u003c/p\u003e\n\u003cp\u003eCó phân trang hữu ích.\u003c/p\u003e\n\u003cp\u003eThiết kế trẻ trung, nhã nhặn, bắt mắt, hợp xu hướng.\u003c/p\u003e\n\u003cp\u003eTúi đựng card, bút... tiện dụng tại ở bìa sau\u003c/p\u003e\n\u003cp\u003eTặng kèm sticker trang trí ngộ nghĩnh\u003c/p\u003e\n\u003cp\u003eTrang vở có đường xé dễ dàng khi sử dụng, kẻ lề sẵn ở mỗi đầu trang.\u003c/p\u003e\n\u003cp\u003ePhù hợp cho giới văn phòng, đi học.\u003c/p\u003e\n\u003cp\u003eLò xo kép độc đáo, cực kỳ cứng cáp và không bị hoen, gỉ theo thời gian\u003c/p\u003e\n\u003cp\u003eTrang giấy thân thiện với môi trường, chất dày và mịn.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eCHÍNH SÁCH CHĂM SÓC KHÁCH HÀNG:\u003c/p\u003e\n\u003cp\u003eSản phẩm được giao trong thời gian nhanh nhất.\u003c/p\u003e\n\u003cp\u003eSản phẩm là hàng chính hãng, đạt chất lượng cao.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eHình ảnh thực tế:\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/sg-11134202-22100-5jk7s14b1liv53\" alt=\"sg-11134202-22100-5jk7s14b1liv53\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/d2b0b62479cdfb78fa7dd85a7dc293a4\" alt=\"d2b0b62479cdfb78fa7dd85a7dc293a4\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/sg-11134202-22100-19gx2orgwlivf5\" alt=\"sg-11134202-22100-19gx2orgwlivf5\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/sg-11134202-22100-l96vftw6vliv61\" alt=\"sg-11134202-22100-l96vftw6vliv61\" width=\"700\" height=\"700\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/31c26cf6470a3b50815184e17d240513\" alt=\"31c26cf6470a3b50815184e17d240513\" /\u0