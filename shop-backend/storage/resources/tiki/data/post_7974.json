p_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/11/f3/f3/3263343c95c092cbc02cb2fb6a3b7754.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":840,"all_time_quantity_sold":3,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cdiv class=\"editor-component-row editor-component-row-relative editor-component-row-active\"\u003e\n\u003cdiv class=\"editor-component-container\"\u003e\n\u003cdiv class=\"previewer-item-wrap\"\u003e\n\u003cdiv class=\"module-detailImageText\"\u003e\n\u003cdiv\u003e\n\u003cdiv\u003e\n\u003cdiv style=\"text-align:center;\"\u003e\n\u003cpre\u003e\u003cstrong\u003e\u003cbr /\u003e20 \u0026amp; 30 Series (YRS-23/24/31/32B)\u003c/strong\u003e\u003c/pre\u003e\n\u003c/div\u003e\n\u003cdiv\u003e\n\u003cpre\u003eNguyên liệu thô đạt tiêu chuẩn an toàn quốc tế (tháng 2 năm 2020)\u003c/pre\u003e\n\u003c/div\u003e\n\u003cdiv\u003e\n\u003cpre\u003eLắp ráp an toàn\u003c/pre\u003e\n\u003c/div\u003e\n\u003cdiv\u003e\n\u003cpre\u003eQuản lý chất lượng tiêu chuẩn ISO 9001\u003c/pre\u003e\n\u003c/div\u003e\n\u003cdiv\u003e\n\u003cpre\u003e      Sáo Recorder series 20 và 30 của Yamaha được thiết kế để đem đến một khởi đầu hoàn hảo cho việc giáo dục âm nhạc. Chúng được thiết kế như bạn mong đợi dựa trên việc điều khiển luồng hơi thổi dễ dàng và tính chính xác của âm sắc mà chỉ tìm thấy trên các model đắt tiền hơn. Mặc dù sáo Recorder của các nhà sản xuất khác có thể có ngoại hình tương tự, nhưng với sáo Recorder Yamaha là nhạc cụ thực sự vượt trội. Recorder luôn có sẵn với các hệ thống ngón bấm ‘German \u0026amp;#39;hoặc‘ Baroque\u0026amp;#39;. Về Series 20, âm vực của chúng rất dễ chơi, chủ yếu dành cho người mới bắt đầu.\n      Là model phổ biến nhất thế giới, sáo recorder này dễ chơi, có âm thanh rõ ràng và là nhạc cụ lý tưởng để sử dụng trong trường học.\u003c/pre\u003e\n\u003c/div\u003e\n\u003cdiv\u003e\n\u003cpre\u003e      Nhựa ABS được sử dụng trong phần thân của một số cây sáo recorder có thể chứa chì, este phthalate và các vật liệu độc hại khác. Nhựa ABS sử dụng trong các sản phẩm Yamaha được sản xuất từ các vật liệu không độc hại, đáp ứng các tiêu chuẩn an toàn quốc tế.\n      • Nhật Bản, Luật An toàn và Vệ sinh Thực phẩm: đáp ứng các tiêu chuẩn về đồ dùng và đồ chơi.\u003c/pre\u003e\n\u003c/div\u003e\n\u003cdiv\u003e\n\u003cpre\u003e      Các phần của sáo recorder Yamaha không sử dụng bất kỳ chất kết dính nào. Sáo recorder soprano YRS-2X có các linh kiện được lắp ráp khớp với nhau hoàn toàn bằng phương pháp ép, còn các mẫu khác sủ dụng hàn siêu âm cho một số linh kiện.\n      * Chất kết dính an toàn sử dụng vật liệu tái chế và không chứa este phthalate được sử dụng cho một số linh kiện không thể nối bằng hàn siêu âm trong sáo recorder tenor và bass.\u003c/pre\u003e\n\u003c/div\u003e\n\u003cdiv\u003e\n\u003cpre\u003e      Hệ thống quản lý chất lượng của Yamaha tuân thủ tiêu chuẩn ISO 9001 quốc tế và được cấp chứng nhận bởi DNV (Det Norske Veritas), một tổ chức chứng nhận quốc tế được công nhận có trụ sở tại Na Uy. Hệ thống quản lý chất lượng tương tự áp dụng cho tất cả các cơ sở sản xuất của Yamaha trên toàn thế giới, đảm bảo mọi sản phẩm bàn giao đều tuân thủ các tiêu chuẩn chất lượng cao nhất.\u003c/pre\u003e\n\u003c/div\u003e\n\u003cdiv\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/product/6e/62/da/cde5d21000b848ffcc409ad958c5b7b6.png\" alt=\"6e62dac86f3a6eb59d43c784d06bd518.png\" /\u003e\u003c/div\u003e\n\u003cdiv\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/product/d9/47/78/4353f791e423ad4e31cee072397e1cde.png\" alt=\"d94778738c6098efe48361f603219b6b