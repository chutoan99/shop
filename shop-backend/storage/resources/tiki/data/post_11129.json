lor":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":679000,"discount_rate":47,"rating_average":4.6,"review_count":14,"review_text":"(14)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/6f/7b/78/73209509edc13b14d6268cd4ff3a8ead.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1254,"all_time_quantity_sold":44,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p><strong>Galaxy Store</strong> là thương hiệu chuyên sản phẩm ngày may đo chất lượng cao bao gồm đồ da, balo, túi và dã ngoại của Việt Nam từ 2015, sinh ra với mục đích mang chính sản phẩm Việt chinh phục người Việt với sự kết hợp mạnh mẽ bởi 3 yếu tố chất lượng, tiện dụng và thời trang.</p>\n<p><strong>Đặc điểm nổi bật</strong></p>\n<p>Hình ảnh sản phẩm thật 100%<br />Kích thước phù hợp sử dụng cho 4 người<br />Làm bằng chất liệu vải lều chuyên dụng, nhẹ, chống thấm nước cực tốt.<br />Thiết kế gọn nhẹ, lều có thể xếp lại gọn gàng, cho vào trong túi nhỏ, thuận tiện mang theo khi đi du lịch, dã ngoại, picnic,…<br />Kiểu dáng trẻ trung, màu ngẫu nhiên theo đợt sản xuất<br />Sản phẩm có khung được làm bằng thép chắc chắn, giúp lều đứng vững, nên bạn có thể yên tâm khi sử dụng.<br />Gọng lều nhẹ nhưng dẻo dai bền bỉ, có thể dựng trên sàn bê tông, đất, cát mà không cần căng dây.<br />Lều có 2 cửa chính 2 bên, cùng sử dụng khóa kéo tiện lợi.<br />Những đường may tỉ mỉ và khéo léo, sẽ giúp kéo dài thêm tuổi thọ cho sản phẩm</p>\n<p>Trọng lượng: ~ 3.5-3.8 Kg</p>\n<p>Màu sắc: Giao màu ngẫu nhiên theo từng đợt sản xuất</p>\n<p><strong>QUÀ TẶNG KÈM</strong>: Tặng kèm đèn pin dã ngoại chiếu sáng đi phượt, du lịch hoặc dùng để chiếu sáng khi mất điện, đi đường ban đêm, đi làm nương rẫy, đi du lịch khám phá…Dễ dàng mang theo hoặc bỏ túi do thiết kế nhỏ, gọn và tiện dụng. Lưu ý: Sản phẩm quà tặng từ các thương hiệu uy tín và có thể thay đổi mẫu mã và màu sắc theo từng đợt quà tặng.</p>\n<p><strong>Cách lắp lều</strong></p>\n<p>Lều lắp đơn giản như sau:</p>\n<p>- Kết nối các thanh ngắn thành 2 thanh đường chép dài </p>\n<p>- Luồn 2 thanh đường chéo vào các lỗ may sẵn trên vải lều.</p>\n<p>- Lều tự bung lên và dễ dàng lắp các bộ phận khác hoàn chỉnh lều</p>\n<p><strong>*** Mẹo hữu ích về một số Sản phẩm thường dùng kèm lều cắm trại:</strong></p>\n<p>- Thảm dã ngoại lót lều: Tăng độ dày đáy lều hoặc lót ngồi ăn uống hóng mát bên ngoài lều</p>\n<p>- Túi ngủ: Sẽ rất hữu ích giữ ấm khi về đêm nhiệt độ xuống thấp hoặc êm lưng khi cắm trại nền đất đá gồ ghề.</p>\n<p>- Đèn treo lều: Thắp sáng bên trong hoặc ngoài lều, có thể treo lên và sạc được bằng điện hoặc năng lượng mặt trời</p>\n<p>- Quạt sạc nhỏ: Sẽ rất hữu ích là thông thoáng không khí trong lều hoặc ngày không gió. </p>\n<p><strong>Lưu ý</strong>: Cho phép chúng tôi có sai số kích thước và trọng lượng chút ít do sai số phép đo và thước/cân đo.</p>\n<div id=\"bd_0\" class=\"com-struct\">\n<div id=\"bd_0_container_0\" class=\"com-struct\">\n<div>\n<div id=\"shell-com-16131024\" class=\"J_module\">\n<div class=\"module-detailImageText\">\n<div>\n<div data-spm-anchor-id=\"a2o4n.pdp.product_\">\n<div id=\"bd_0\" class=\"com-struct\">\n<div id=\"bd_0_container_0\" class=\"com-struct\">\n<div>\n<div id=\"shell-com-16131024\" class=\"J_module\">\n<div class=\"module-detailImageText\">\n<div>\n<div data-spm-anchor-id=\"a2o4n.pdp.produc