oad/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":40600,"discount_rate":35,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/40/ea/cd/d6eaaf141a5c4bf2096f22baad699056.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":894,"all_time_quantity_sold":11,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2\u003e\u003cspan class=\"ez-toc-section\"\u003e\u003cstrong\u003eGiáo Trình Hán Ngữ 4 phiên bản mới dùng App có gì đặc biệt ???\u003cbr /\u003e\u003c/strong\u003e\u003c/span\u003e\u003c/h2\u003e\n\u003cp\u003e\u003cstrong\u003e“Giáo Trình Hán Ngữ 4 phiên bản mới dùng App”\u003c/strong\u003e nằm trong \u003cstrong\u003eBộ giáo trình Hán ngữ\u003c/strong\u003e do Đại học Ngôn ngữ Bắc Kinh và tác giả Dương Ký Châu ủy quyền cho Công ty cổ phần sách MCBooks – Chuyên sách ngoại ngữ phát hành độc quyền tại thị trường Việt Nam. Tất cả chương trình đào tạo tiếng Trung từ các Trường học cho đến các trung tâm đào tạo tiếng Trung đều sử dụng Bộ giáo trình này. Cũng giống như bộ sách giáo khoa “Tiếng Việt”, “Giáo trình Hán ngữ” là bộ sách không thể thiếu khi học tiếng Trung.\u003c/p\u003e\n\u003cp\u003eBộ Giáo trình Hán ngữ gồm 6 cuốn được biên soạn tỉ mỉ với 3300 từ mới. Phần bài khóa và nội dung đàm thoại có quan hệ chủ điểm đồng nhất với bài luyện đọc và từ mới của từng bài. Chủ điểm bài khóa bao gồm nhiều lĩnh vực trong đời sống hàng ngày, giới thiệu những kiến thức về đất nước và con người Trung Quốc nhằm tăng cường sự hiểu biết đối với đất nước Trung Hoa.\u003c/p\u003e\n\u003cp\u003eCuốn “Giáo trình Hán ngữ phiên bản mới tập 4” cung cấp 10 bài học chủ điểm giúp người học hoàn thiện trình độ tiếng Trung trung cấp: giao tiếp thành thạo các chủ đề thường ngày và có thể đạt chứng chỉ HSK4.\u003c/p\u003e\n\u003cdiv class=\"wp-video\"\u003e\u003cspan class=\"mejs-offscreen\"\u003eTrình chơi Video\u003c/span\u003e\n\u003cdiv class=\"mejs-container mejs-container-keyboard-inactive wp-video-shortcode mejs-video\"\u003e\n\u003cdiv class=\"mejs-inner\"\u003e\n\u003cdiv class=\"mejs-mediaelement\"\u003e\u003cvideo class=\"wp-video-shortcode lazy-hidden\" src=\"https://mcbooks.vn/wp-content/uploads/2019/03/Sach-Giao-Trinh-Han-Ngu-4-Tap-2-Quyen-Ha-Phien-Ban-Moi-Hoc-Kem-App-Hoc-Online_1.mp4?_=1\" preload=\"metadata\" width=\"1020\" height=\"1020\"\u003e\u003c/video\u003e\u003c/div\u003e\n\u003cdiv class=\"mejs-layers\"\u003e\n\u003cdiv class=\"mejs-overlay mejs-layer mejs-overlay-play\"\u003e\n\u003cdiv class=\"mejs-overlay-button\"\u003e \u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"mejs-controls\"\u003e\n\u003cdiv class=\"mejs-button mejs-playpause-button mejs-play\"\u003e \u003c/div\u003e\n\u003cdiv class=\"mejs-time mejs-currenttime-container\"\u003e\u003cspan class=\"mejs-currenttime\"\u003e00:00\u003c/span\u003e\u003c/div\u003e\n\u003cdiv class=\"mejs-time-rail\"\u003e \u003c/div\u003e\n\u003cdiv class=\"mejs-time mejs-duration-container\"\u003e\u003cspan class=\"mejs-duration\"\u003e00:39\u003c/span\u003e\u003c/div\u003e\n\u003cdiv class=\"mejs-button mejs-volume-button mejs-mute\"\u003e \u003c/div\u003e\n\u003cdiv class=\"mejs-button mejs-fullscreen-button\"\u003e \u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch2\u003e\u003cspan class=\"ez-toc-section\"\u003e\u003cstrong\u003eBạn nhận được gì sau khi học xong cuốn Giáo trình Hán Ngữ 4\u003c/strong\u003e\u003c/span\u003e\u003c/h2\u003e\n\u003ch3\u003e\u003cspan class=\"ez-toc-section\"\u003e\u003cem\u003e\u003cstrong\u003eLuyện tập đủ 4 kỹ năng\u003c/strong\u003e\u003c/em\u003e\u003c/span\u003e\u003c/h3\u003e\n\u003cp\u003eTrong mỗi bài học chủ điểm, tác giả xây dựng nội dung bài học bao gồm 5 phần: Bài khóa, Từ mới, Chú thích, Ngữ pháp – ngữ âm, Luyện tập giúp bạn nâng cao cả 4 kỹ năng Nghe – Nói – Đọc – Viết tiếng Trung.\u003c/p\u003e\n\u003ch3\u003e\u003cspan class=\"ez-toc-section\"\u003e\u003cem\u003e\u003cstrong\u003eNâng cao khả năng viết chữ Hán\u003c/strong\u003e\u003c/em\u003e\u003c/span\u003e\u003c/h3\u003e\n\u003cp\u003eỞ cuối mỗi bài học sẽ có các bảng từ được kẻ ô sẵn giúp các bạn luyện tập viết chữ Hán đúng chuẩn. Những chữ khó, sách đã có phần kẻ mờ, người học chỉ cần viết lại theo các nét đã được vạch ra để học được cách viết các nét chính xác.\u003c/p\u003e\n\u003ch3\u003e\u003cspan class=\"ez-toc-section\"\u003e\u003cem\u003e\u003cstrong\u003eTăng thêm hiểu biết về nhiều ngôn ngữ cùng lúc\u003c/strong\u003e\u003c/em\u003e\u003c/span\u003e\u003c/h3\u003e\n\u003cp\u003eCuốn sách có phiên âm pinyin giúp các bạn đọc tiếng Trung một cách chuẩn xác. Bên cạnh đó, sách còn được dịch sang cả tiếng Anh và tiếng Việt giúp các bạn tăng thêm hiểu biết về nhiều ngôn ngữ cùng lúc.\u003c/p\u003e\n\u003ch3\u003e\u003cspan class=\"ez-toc-section\"\u003e\u003cem\u003e\u003cstrong\u003eTăng thêm sự hiểu biết về đất nước Trung Hoa\u003c/strong\u003e\u003c/em\u003e\u003c/span\u003e\u003c/h3\u003e\n\u003cp\u003eChủ điểm bài khóa bao gồm nhiều lĩnh vực trong đời sống hàng ngày, giới thiệu những kiến thức về con người và đất nước Trung Quốc. Các phần chú thích chi tiết cũng nêu rõ những kiến thức về ngôn ngữ và bối cảnh văn hóa Trung Hoa. Từ đó các bạn không chỉ học được tiếng Trung mà còn nâng cao sự hiểu biết của mình về đất nước Trung Quốc.\u003c/p\u003e\n\u003ch3\u003e\u003cspan class=\"ez-toc-section\"\u003e\u003cem\u003e\u003cstrong\u003eNâng cao kỹ năng nghe với App Mcbooks\u003c/strong\u003e\u003c/em\u003e\u003c/span\u003e\u003c/h3\u003e\n\u003cp\u003eCác bài nghe đều được các giảng viên của Đại học Ngôn ngữ Bắc Kinh thực hiện, qua đó các bạn nâng cao được kỹ năng nghe một cách nhanh nhất. Để tiện lợi hơn trong quá trình học tập, giúp bạn tận dụng mọi khoảng thời gian trống để ôn lại các bài nghe, với “Giáo trình Hán ngữ 4 phiên bản mới tải APP”, chỉ cần tải app của MCBooks bằng cách quét mã QR code ở sau cuốn sách. Bạn có thể sở hữu cuốn sách ngay trong điện thoại của mình. Hệ thống hỗ trợ trên cả hai hệ điều hành Android và IOS. Hãy thưởng thức công nghệ trong một cuốn sách tuyệt vời. Chắc chắn cuốn sách này sẽ là bạn đồng hành không thể thiếu trên chặng đường học tiếng Trung của bạn.\u003c/p\u003e\n\u003cp\u003eCuốn sách này do MCBooks – chuyên sách ngoại ngữ – độc quyền phát hành nên chắc chắn người học sẽ không phải lo lắng về chất lượng cuốn sách. Giáo trình được in rõ nét trên chất liệu giấy cực tốt không hề kém cạnh thậm chí còn nhỉnh hơn các cuốn sách giáo khoa trên thị trường hiện nay. Các phần bài học đều được viết chi tiết và tỉ mỉ, đảm bảo một giáo trình quy chuẩn đi cùng với chất lượng vượt trội. Với cuốn sách này các bạn vừa có thể tự tin để vượt qua HSK 4, vừa tự tin giao tiếp tiếng Trung trong những tình huống hội thoại hàng ngày. Nếu bạn đã thành công với 3 tập đầu của bộ sách, thì chắc chắn tập 4 này sẽ là lựa chọn tuyệt vời của bạn.\u003c/p\u003e\n\u003ch2\u003e\u003cspan class=\"ez-toc-section\"\u003e\u003cstrong\u003eReview Giáo Trình Hán Ngữ 4 phiên bản mới dùng App\u003c/strong\u003e\u003c/span\u003e\u003c/h2\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cdiv class=\"container section-title-container\"\u003e\n\u003ch3 class=\"section-title section-title-bold-center\"\u003e\u003cspan class=\"ez-toc-section\"\u003e\u003cspan class=\"section-title-main\"\u003eVTV6 GIỚI THIỆU BỘ GIÁO TRÌNH\u003c/span\u003e\u003c/span\u003e\u003c/h3\u003e\n\u003c/div\u003e\n\u003cp\u003e \u003c/p\u003e\n\u