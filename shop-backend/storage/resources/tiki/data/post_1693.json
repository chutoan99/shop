xt_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":18000,"discount_rate":21,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/e8/d9/9a/908266857cba81c604df87aea1f7dbd6.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1238,"all_time_quantity_sold":5,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eĐồ chơi đàn gỗ 8 quãng\u003c/strong\u003e hay còn gọi là đàn Xylophone với 8 thanh nhạc màu sắc, bé có thể dùng thanh gõ để tạo ra những âm thanh vui nhộn, khơi dậy năng khiếu âm nhạc của bé từ sớm. Sản phẩm được làm từ chất liệu gỗ cao cấp, vừa nhẹ nhàng, chi tiết tỉ mỉ đẹp mắt, lại vừa an toàn cho sức khỏe của bé, từ nay mẹ có thể an tâm khi bé chơi đùa.\u003cstrong\u003e Đàn gõ 8 quãng Xylophone\u003c/strong\u003e cho bé phát triển năng khiếu âm nhạc gồm dùi gõ gỗ cho bé tập gõ đàn, cảm thụ âm thanh và tăng khả năng vận động.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/96/d7/9a/039c948788be037d45dc0f524e6a26f6.jpg\" alt=\"\" width=\"563\" height=\"650\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003eĐàn gỗ gồm 8 âm sắc- 8 nốt nhạc khác nhau và 2 dùi gõ, mỗi âm sắc mang một màu sắc khác nhau kích thích thị giác của bé.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/e8/d9/9a/2977a3979a796473e15bfcb5eb1fe2a7.jpg\" alt=\"\" width=\"563\" height=\"650\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003eCách chơi đàn gỗ:\u003c/p\u003e\n\u003cul style=\"text-align: justify;\"\u003e\n\u003cli\u003e8 phím của đàn Xylophone mang 8 âm sắc khác nhau. Khi gõ vào, nó sẽ phát ra những âm điệu cơ bản nhất trong nhạc lí.\u003c/li\u003e\n\u003cli\u003eKhi chơi đàn cùng phụ huynh, trẻ có thể nhận biết sự khác nhau cơ bản giữa các lần gõ. Từ đó, biết những tính chất cơ bản nhất của âm điệu. Đây là một trong những yếu tố quan trọng, góp phần kích thích não bộ của trẻ trong những tháng đầu đời.\u003c/li\u003e\n\u003cli\u003eNgoài ra, những màu sắc bắt mắt khiến đàn xylophone trở nên thu hút trẻ hơn. Thông qua đó, kích thích khả năng tìm hiểu của trẻ.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/37/5f/a1/91072b2f2fd9e7abf587727d3fa38d89.jpg\" alt=\"\" width=\"563\" height=\"650\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e Thông tin chi tiết:\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e- Chất liệu: khung đàn bằng gỗ dày dặn, chắc chắn.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e- Đàn gồm 8 phím bằng kim loại được sơn bằng sơn an toàn, màu sắc đẹp và an toàn cho bé.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e- Chất liệu: gỗ, kim loại, sơn\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e- Màu sắc: đa dạng\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e- Kích thước:24x12x2 cm\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003eMẹ hãy khơi dậy năng khiếu âm nhạc từ bé cho trẻ nhé\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng 