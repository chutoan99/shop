://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":676000,"discount_rate":27,"rating_average":4.8,"review_count":18,"review_text":"(18)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/7c/e9/8a/cf65be6fe674d48f87c0a93865351138.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2183,"all_time_quantity_sold":42,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<div class=\"hero-list\">\n<div class=\"row\">\n<div class=\"col-lg-7\">\n<div class=\"wrap-img\">\n<div class=\"img\">\n<h3 class=\"title\">Balo laptop Neo Lamborghini i17 siêu bền</h3>\n</div>\n<div class=\"img\"><img src=\"https://salt.tikicdn.com/ts/tmp/a3/96/32/15f8fdf6660ae5304846e84298f4f55c.png\" alt=\"\" width=\"500\" height=\"500\" /></div>\n</div>\n</div>\n<div class=\"col-lg-5\">\n<div class=\"wrapper-content\">\n<h3 class=\"title\">Balo laptop Neo Lamborghini có thiết kế mạnh mẽ trên chất liệu trượt nước</h3>\n<div class=\"content\">\n<p>Chất liệu polyester trượt nước, bền màu, chống bám bụi và dễ dàng vệ sinh khi bị dính bẩn.</p>\n<p>Bên trong trang bị vải lót 3 tính năng: chống thấm, hút ẩm, kháng khuẩn.</p>\n<p>Thiết kế hình hộp vuông vức, kết hợp tinh tế giữa cổ điển và hiện đại phá cách, mới lạ.</p>\n<p>Mặt trước được trang trí họa tiết hình khiên với sợi dạ quang thu hút mọi ánh nhìn.</p>\n<p>Logo Sakos tinh tế khẳng định chất lượng sản phẩm và giá trị thương hiệu được chuyển nhượng độc quyền từ USA.</p>\n</div>\n</div>\n</div>\n</div>\n</div>\n<div class=\"hero-list\">\n<div class=\"row\">\n<div class=\"col-lg-7\">\n<div class=\"wrap-img\">\n<div class=\"img\"><img src=\"https://salt.tikicdn.com/ts/tmp/b1/de/14/6ae3a5e4918e85bed00716166c562237.png\" alt=\"\" width=\"500\" height=\"500\" /></div>\n</div>\n</div>\n<div class=\"col-lg-5\">\n<div class=\"wrapper-content\">\n<h3 class=\"title\">Phân ngăn tiện lợi khiến Neo Lamborghini xứng đáng là dòng balo laptop 17 inch phù hợp đi học, đi làm hoặc du lịch</h3>\n<div class=\"content\">\n<p>Ngăn laptop chống sốc 17 inch riêng biệt, thích hợp cho các dòng máy tính xách tay, máy tính bảng.</p>\n<p>Ngăn chính rộng rãi có thể đựng quần áo cho chuyến đi cả tuần. Phần đáy chắc chắn, trang bị đế bảo vệ cao su bên ngoài, chống quăn góc tài liệu.</p>\n<p>Hệ thống các ngăn phụ kích thước lớn – nhỏ đa dạng tiết kiệm thời sắp xếp đồ dùng ngăn nắp.</p>\n<p>Hai ngăn phụ bên hông với khóa zip an toàn, dễ dàng cất – lấy các vật dụng nhanh chóng.</p>\n</div>\n</div>\n</div>\n</div>\n</div>\n<div class=\"hero-list\">\n<div class=\"row\">\n<div class=\"col-lg-7\">\n<div class=\"wrap-img\">\n<div class=\"img\"><img src=\"https://salt.tikicdn.com/ts/tmp/5f/d9/3b/001a7c95f5b50f774f13529e427577ed.png\" alt=\"\" width=\"500\" height=\"500\" /></div>\n</div>\n</div>\n<div class=\"col-lg-5\">\n<div class=\"wrapper-content\">\n<h3 class=\"title\">Công nghệ may gấp mép viền tạo phom cứng cáp giúp balo laptop Sakos đứng vững không cần điểm tựa</h3>\n<div class=\"content\">\n<p>Công nghệ may gấp mép viền tinh tế, bền bỉ cùng thời gian.</p>\n<p>Phom dáng cứng cáp nhờ sợi nhựa PE bọc vải tạo khung vững vàng.</p>\n<p>Quai xách và quai đeo được đánh bọ kỹ lưỡng, chắc chắn.</p>\n<p>Đế cao su bảo vệ đáy giúp balo luôn đứng vững.</p>\n</div>\n</div>\n</div>\n</div>\n</div>\n<div class=\"hero-list\">\n<div class=\"row\">\n<div class=\"col-lg-7\">\n<div class=\"wrap-img\">\n<div class=\"img\"><img class=\" lazyloaded\" src=\"https://sakos.vn/Data/Sites/1/media/2-sp/sbv057-balo-laptop-neo-lamborghini/04.png\" alt=\"\" data-src=\"/Data/Sites/1/media/2-sp/sbv057-balo-laptop-neo-lamborghini/04.png\" /></div>\n</div>\n</div>\n<div class=\"col-lg-5\">\n<div class=\"wrapper-content\">\n<h3 class=\"title\">Đệm lưng thoáng khí, quai đeo êm ái giúp balo laptop Neo Lamborghini chống đau vai, mỏi cổ dù đeo balo trong nhiều giờ</h3>\n<div class=\"content\">\n<p>Balo sinh công sở kiêm balo du lịch Neo Lamborghini trang bị quai đeo to bản với đệm mút dày, chống hằn, chống đau vai, mỏi cổ. Dễ dàng điều chỉnh chiều dài dây đeo với chốt tăng – đơ tiện lợi.</p>\n<p>Đai trợ lực dàn trải đều trọng lượng balo lên toàn thân thay vì đè nặng trên vai.</p>\n<p>Đệm lưng EVA cấu trúc tổ ong với hàng ngàn lỗ thông khí chống nóng lưng.</p>\n<p>Hai quai xách tiện lợi được may theo công nghệ đánh bọ chắc chắn. Quai chính dày, bản lớn chống hằn da tay. Quai nhỏ vải thô để treo balo lên giá đỡ những khi không sử dụng.</p>\n</div>\n</div>\n</div>\n</div>\n</div><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/7c/e9/8a/cf65be6fe674d48f87c0a93865351138.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/7c/e9/8a/cf65be6fe674d48f87c0a93865351138.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/7c/e9/8a/cf65be6fe674d48f87c0a93865351138.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7c/e9/8a/cf65be6fe674d48f87c0a93865351138.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7c/e9/8a/cf65be6fe674d48f87c0a93865351138.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/e8/90/fa/bf43d9597d11a2e3726d82c9829022db.png","is_gallery":true,"label":null,"large_url":"h