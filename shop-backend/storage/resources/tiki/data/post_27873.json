/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e\u003cspan style=\"color:#008080;\"\u003e\u003cstrong\u003e- Tích hợp các lớp lưới thoáng khí\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e\u003cspan style=\"color:#008080;\"\u003e\u003cstrong\u003e- Phần dây dán chắc chắn, giữ tay bạn luôn chặt với đích đấm\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e\u003cspan style=\"color:#008080;\"\u003e\u003cstrong\u003eĐỡ bàn tay DoDoDios được thiết kế tỉ mỉ , chắc chắn vô cùng thuận tiện cho các HLV boxing , tán thủ hay Muay Thái sử dụng\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e\u003cspan style=\"color:#008080;\"\u003e\u003cstrong\u003eĐích đấm DoDoDios là sản phẩm đỡ bàn tay tốt nhất thị trường với mức giá dưới 1 triệu đồng / đôi .\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e\u003cspan style=\"color:#008080;\"\u003e\u003cstrong\u003eĐÍch đấm DoDoDios được may chắn chắn, tinh tế\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e\u003cspan style=\"color:#008080;\"\u003e\u003cstrong\u003e--------\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e\u003cspan style=\"color:#008080;\"\u003e\u003cstrong\u003e* DoDoDios cam kết với khách hàng về sản phẩm:\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e\u003cspan style=\"color:#008080;\"\u003e\u003cstrong\u003e- Sản phẩm 100% giống mô tả\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e\u003cspan style=\"color:#008080;\"\u003e\u003cstrong\u003e- Đảm bảo chất lượng, dịch vụ tốt nhất, hàng được giao từ 1-5 ngày kể từ ngày đặt hàng\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e\u003cspan style=\"color:#008080;\"\u003e\u003cstrong\u003e- Giao hàng trên toàn quốc theo hình thức COD hoặc qua ví điện tử\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e\u003cspan style=\"color:#008080;\"\u003e\u003cstrong\u003e- Đổi trả theo đúng quy định của Sàn\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e\u003cspan style=\"color:#008080;\"\u003e\u003cstrong\u003e1. Điều kiện áp dụng (trong vòng 07 ngày kể từ khi nhận sản phẩm):\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e\u003cspan style=\"color:#008080;\"\u003e\u003cstrong\u003e- Hàng hoá vẫn còn mới, chưa qua sử dụng\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e\u003cspan style=\"color:#008080;\"\u003e\u003cstrong\u003e- Hàng hóa hư hỏng do vận chuyển hoặc do nhà sản xuất.\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e\u003cspan style=\"color:#008080;\"\u003e\u003cstrong\u003e2. Trường hợp được chấp nhận:\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e\u003cspan style=\"color:#008080;\"\u003e\u003cstrong\u003e- Hàng không đúng chủng loại, mẫu mã như quý khách đặt hàng\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e\u003cspan style=\"color:#008080;\"\u003e\u003cstrong\u003e- Không đủ số lượng, không đủ bộ như trong đơn hàng\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e\u003cspan style=\"color:#008080;\"\u003e\u003cstrong\u003e- Tình trạng bên ngoài bị ảnh hưởng như rách bao bì, bong tróc, bể vỡ…\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e\u003cspan style=\"color:#008080;\"\u003e\u003cstrong\u003e3. Trường hợp không đủ điều kiện áp dụng chính sách:\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e\u003cspan style=\"color:#008080;\"\u003e\u003cstrong\u003e- Quá 03 ngày kể từ khi Quý khách nhận hàng\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e\u003cspan style=\"color:#008080;\"\u003e\u003cstrong\u003e- Gửi lại hàng không đúng mẫu mã, không phải hàng của DoDoDios\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e\u003cspan style=\"color:#008080;\"\u003e\u003cstrong\u003e- Đặt nhầm sản phẩm, chủng loại, không thích, không hợp,...\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e\u003cspan style=\"color:#008080;\"\u003e\u003cstrong\u003e#đích_đá #đích_đá_cầm_tay #dichdacamtay #dichda #dichdadaPU #dichdacamtaydaPU #đích_đá_da_PU #đích_đá_cầm_tay_da_PU #đích_đácaocap #đích_đá_cầm_taycaocap #dichdacamtaycaocap #dichdacaocap #dichdadaPUcaocap #dichdacamtaydaPUcaocap #đích_đá_da_PUcaocap #đích_đá_cầm_tay_da_PUcaocap #đích_đáchinhhang #đích_đá_cầm_taychinhhang #dichdacamtaychinhhang #dichdachinhhang #dichdadaPUchinhhang #dichdacamtaydaPUchinhhang #đích_đá_da_PUchinhhang #đích_đá_cầm_tay_da_PUchinhhang\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e"},{"code":"material","name":"Chất liệu","value":"Chất liệu chuyên dụng võ thuật dododios"},{"code":"origin","name":"Xuất xứ (Made in)","value":"Việt Nam"}]},{"name":"Operation","attributes":[{"code":"is_warranty_applied","name":"Sản phẩm có được bảo hành không?","value":"Không"},{"code":"product_weight","name":"Trọng lượng sản phẩm","value":"0.55kg"}]}],"product_links":[],"gift_item_title":"0 quà tặng kèm","configurable_options":[{"code":"option1","name":"Chủng loại","position":0,"show_preview_image":false,"values":[{"label":"combo 2 đích đá màu xanh"},{"label":"combo 2 đích đá màu đen"},{"label":"combo 2 đích đá màu đỏ"}]}],"configurable_products":[{"child_id":202619048,"discount_rate":0,"id":202619049,"images":[{"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/09/14/9b/418d21eafe40a19ca6f1385b7f4082ec.png","medium_url":"https://salt.tikicdn.com/cache/550x550/ts/product/09/14/9b/418d21eafe40a19ca6f1385b7f4082ec.png","small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/09/14/9b/418d21eafe40a19ca6f1385b7f4082ec