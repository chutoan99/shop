,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":67,"review_text":"(67)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/42/21/7d/348d877c9b5ce4d23d935bb7420f81f3.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":924,"all_time_quantity_sold":278,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch1\u003e\u003cem\u003eMũ bảo hiểm nửa đầu SRT ASA-05, nón bảo hiểm 1/2 đầu cao cấp kèm kính UV, phi công freesize 55-61cm, nhiều màu, cá tính - Hàng Chính Hãng\u003c/em\u003e\u003c/h1\u003e\n\u003cp style=\"text-align: justify; background: white; margin: 3.75pt 0cm 9.0pt 0cm;\"\u003e\u003cspan style=\"font-size: 10.5pt; color: #242424;\"\u003eMũ bảo hiểm SRT mang đến cho các bạn trẻ một dòng sản phẩm mũ bảo hiểm nửa đầu hay còn gọi là mũ bảo hiểm phượt 1/2 dành cho cả nam và nữ, với những màu sắc được in nước cẩn thận, không phai theo thời gian đồng hành trọn đời với khách hàng.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"background: white; margin: 3.75pt 0cm 9pt;\"\u003e\u003cspan style=\"font-size: 10.5pt; color: #242424;\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/02/3b/bf/2b2056c2ff49bdeae0839aa49e50b7e5.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eThân nón hay còn gọi là vỏ nón: được làm từ nhựa ABS chính phẩm,nguyên sinh chưa qua sử dụng nên chất lượng cao, không mùi như các loại mũ chất lượng kém.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/70/ae/14/1f2e7d8bd792a26fd394b549cdcc9443.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eLớp đệm mút xốp EPS (Foam): có độ cứng vững rất tốt, vừa vặn và bám chặt vào thân nón có tác dụng hấp thụ xung động cao.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/8e/4b/9b/f35be92506ca44918358743ac6190adc.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eDây đeo và khóa mũ: chắc chắn, với khóa mũ là khóa rút cao cấp, dễ dàng tháo lắp, bền với thời gian.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/c9/36/56/fea7e89d5ec075b146950265799f04f8.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eNước sơn: được sơn bằng công nghệ hiện đại, tạo bề mặt sáng, bóng, nhẵn mịn, không ngả màu.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/77/00/87/346bcf8813021a0e23966d44c7c91dd8.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eĐược kiểm định độ bền và chất lượng kĩ lưỡng trước khi xuất xưởng.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/9e/c8/65/c343bd3086b826c657e306dc461eaddf.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cstrong\u003eLưu ý: Hãy trang trí thêm những chiếc kính UV hay kính phi công để thêm phần thời trang nhé. \u003c/strong\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/34/cf/3f/71bc4691297e61a3f3fd1661a3517c5e.jpg\" alt=\"\" width=\"750\" height=\"1406\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/ec/2c/9c/dd7c396e8679e11e59b3a4058ac3bd14.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eNón bảo hiểm SRTsẽ không bao giờ làm bạn thất vọng.\u003c/p\u003e\n\u003cp\u003e   1. Đội ngũ trẻ trung, năng động “nhất quả đất”: Là những người thuộc thế hệ Z (GenZ) chúng mình tự tin là những người thấu hiểu khách hàn. Chúng mình luôn sẵn sàng ở phần chat để lắng nghe những chia sẻ và tư vấn, chăm sóc nhiệt tình mỗi khi bạn cần.\u003c/p\u003e\n\u003cp\u003e   2. Hình ảnh: nón bảo hiểm SRT cam kết hình ảnh về sản phẩm và dịch vụ, là ảnh thật tự chụp, không qua chỉnh sửa chỉ đính thêm logo.\u003c/p\u003e\n\u003cp\u003e   3. Chất lượng, đảm bảo: SRT mang đến khách hàng những chiếc mũ bảo hiểm có chất lượng cao, được lựa chọn và kiểm tra cẩn thận trước khi được giao đến tay khách hàng.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/c0/00/f8/4be95cb6813f6c5b427e44ae860c627b.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/f5/5f/b4/df5b7675679183222a78a3a209414a27.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e- Hướng dấn cách lắp, tháo kính:\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/a7/c4/80/d2ddf17eff08c5c466a0108ff087e456.jpg\" alt=\"\" width=\"750\" height=\"1069\" /\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/42/21/7d/348d877c9b5ce4d23d935bb7420f81f3.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/42/21/7d/348d877c9b5ce4d23d935bb7420f81f3.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/42/21/7d/348d877c9b5ce4d23d935bb7420f81f3.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/42/21/7d/348d877c9b5ce4d23d935bb7420f81f3.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/42/21/7d/348d877c9b5ce4d23d935bb7420f81f3.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/f2/60/95/7a17a11a1efd33519903dcc2580447e2.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f2/60/95/7a17a11a1efd33519903dcc2580447e2.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f2/60/95/7a17a11a1efd33519903dcc2580447e2.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f2/60/95/7a17a11a1efd33519903dcc2580447e2.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f2/60/95/7a17a11a1efd33519903dcc2580447e2.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/02/3b/bf/a76a064da805610cb19e3733c882d4f7.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/02/3b/bf/a76a064da805610cb19e3733c882d4f7.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/02/3b/bf/a76a064da805610cb19e3733c882d4f7.jpg","position":