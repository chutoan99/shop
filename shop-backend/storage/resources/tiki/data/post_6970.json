on"}},"discount":13200,"discount_rate":15,"rating_average":5,"review_count":9,"review_text":"(9)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/04/ed/e2/bfc4b92a91c105cfd88d4b525d077034.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1877,"all_time_quantity_sold":86,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cspan lang=\"VI\"\u003eCùng Khủng Long Học Tiếng Anh Theo Chủ Đề \u003c/span\u003e\u003cspan lang=\"VI\"\u003elà bộ sách đầu tiên tại Việt Nam được viết theo tiêu chuẩn Quốc tế dành cho học sinh Tiểu học (từ 5 đến 12 tuổi). Bộ sách được xây dựng để các con có thể tự học tiếng Anh tại nhà dưới sự kèm cặp của cha mẹ mà không phải đến những trung tâm tiếng Anh đông người mà hiệu quả học tập không cao.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/47/ea/5d/68fe798cc8f40545c6b8f622dad3b6c8.jpg\" alt=\"\" width=\"750\" height=\"335\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan lang=\"VI\"\u003eCùng Khủng Long Học Tiếng Anh Theo Chủ Đề Lớp 3\u003c/span\u003e (Tái bản) \u003cspan lang=\"VI\"\u003elà bộ sách đầu tiên tại Việt Nam được viết theo tiêu chuẩn Quốc tế dành cho học sinh \u003c/span\u003elớp 3\u003c/p\u003e\n\u003cp\u003e\u003cspan lang=\"VI\"\u003eBộ sách được xây dựng để các con có thể tự học tiếng Anh tại nhà dưới sự kèm cặp của cha mẹ mà không phải đến những trung tâm tiếng Anh đông người mà hiệu quả học tập không cao.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan lang=\"VI\"\u003eBộ sách giúp các con rèn luyện khả năng tư duy bằng cả 2 bán cầu não trái và bán cầu não phải; luyện cả 2 kỹ năng tư duy logic của não trái và tư duy hình ảnh của não phải thông qua phương pháp học TIÊN TIẾN nhất – học qua hình ảnh, màu sắc và âm thanh.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan lang=\"VI\"\u003eNHỮNG ƯU ĐIỂM VƯỢT TRỘI CỦA BỘ SÁCH:\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan lang=\"VI\"\u003e1. Nhớ từ mới nhanh và lâu thông qua hình ảnh và hoạt động bài tập đặc sắc. Giúp cân bằng 2 bán cầu não.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003c!--[endif]--\u003e\u003c!-- [if gte vml 1]\u003e\u003c/o:wrapblock\u003e\u003c![endif]--\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan lang=\"VI\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/91/b4/a5/4ad4eaf9d25dc534322b1e156cd18144.png\" alt=\"\" width=\"750\" height=\"1082\" /\u003e \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan lang=\"VI\"\u003e2. Hệ thống ngữ pháp nền tảng và ứng dụng siêu dễ hiểu, giúp con xây dựng nền tảng ngữ pháp vững chắc để phát triển tiếng Anh sau này.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan lang=\"VI\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/b5/18/f4/179f6f9ccb3103938133d0a2e24f8e65.png\" alt=\"\" width=\"750\" height=\"1082\" /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cspan lang=\"VI\"\u003e3. File nghe chuẩn Quốc tế với giáo viên nước ngoài và mã cào tiện dụng. Con được nghe phát âm chuẩn, từ đó nâng cao kĩ năng nghe và giao tiếp của con như người bản xứ.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/1a/11/92/bb2505895a4cd3a9f2dfbabd1ece9dbc.png\" alt=\"\" width=\"750\" height=\"1082\" /\u003e \u003c/p\u003e\n\u003cp\u003e\u003cspan lang=\"VI\"\u003e4. Tập viết từ mới tiếng Anh ngay sau mỗi bài học giúp con vừa luyện chữ, vừa nhớ từ vựng.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan lang=\"VI\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/4b/05/8b/64dbf65fd83da1858c0fe3fffcc9921d.png\" alt=\"\" width=\"750\" height=\"1082\" /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cspan lang=\"VI\"\u003e \u003c/span\u003e5. Nghiên cứu hành vi người học Việt Nam theo phương pháp học Tiếng Anh chuẩn quốc tế.\u003c/p\u003e\n\u003cp\u003e\u003cspan lang=\"VI\"\u003eNỘI DUNG CHƯƠNG TRÌNH được chia thành các chủ đề thân thuộc với các con như chủ đề Gia đình, chủ đề Động vật. Mỗi chủ để được lồng ghép những kiến thức lý thuyết xen lẫn với hình ảnh minh họa phù hợp với độ tuổi của con.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan lang=\"VI\"\u003eHãy để Cùng khủng long học tiếng Anh theo chủ đề trở thành người bạn đồng hành, giúp con chinh phục thành công tiếng Anh!\u003c/span\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/04/ed/e2/bfc4b92a91c105cfd88d4b525d077034.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/04/ed/e2/bfc4b92a91c105cfd88d4b525d077034.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/04/ed/e2/bfc4b92a91c105cfd88d4b525d077034.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/04/ed/e2/bfc4b92a91c105cfd88d4b525d077034.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/04/ed/e2/bfc4b92a91c105cfd88d4b525d077034.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/f6/01/c9/fc67c0ae955639282d6f6dafe7e4a148.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f6/01/c9/fc67c0ae955639282d6f6dafe7e4a148.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f6/01/c9/fc67c0ae955639282d6f6dafe7e4a148.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/produc