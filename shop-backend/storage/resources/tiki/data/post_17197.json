xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":9,"review_text":"(9)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/76/1c/ed/ec17da2b3402d00c9cf2a3cb9892d74a.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1450,"all_time_quantity_sold":29,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch1\u003eCây chổi lau nhà 2 trong 1 Xiaomi Deerma TB500 vừa xịt nước vừa lau khô\u003c/h1\u003e\n\u003cp\u003eBạn sẽ không phải hì hục lau đi lau lại nhiều nước mới làm sạch được nhà cửa nữa, vì bạn đã có \u003cstrong\u003e\u003cem\u003eChổi lau nhà 2 trong 1 Xiaomi Deerma TB500\u003c/em\u003e\u003c/strong\u003e  là một dạng chổi lau có tác dụng vừa xịt nước vừa lau khô vô cùng tiện lợi. Nhờ tích hợp hai tính năng trong cùng một sản phẩm, bạn sẽ không cần phải lau đi lau lại nhiều nước mỗi khi vệ sinh nhà cửa nữa.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/76/1c/ed/5300e7e8e915bee6c2a39056f6a03eec.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThông số kỹ thuật:\u003c/strong\u003e\u003cbr /\u003e-Kích thước 124 x 355 x 120mm\u003cbr /\u003e-Khối lượng 0.75kg\u003cbr /\u003e-Chất liệu vỏ nhựa ABS/ PP\u003cbr /\u003e-Chất liệu lõi ống thép\u003cbr /\u003e-Chất liệu vải lau sợi bông cotton\u003cbr /\u003e-Dung tích bình chứa 350ml\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/31/2d/ce/162acd4ab8968a098bfc07def753251f.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003cbr /\u003eVới khối lượng chỉ vỏn vẹn \u003cstrong\u003e0.75kg\u003c/strong\u003e tương đương cân nặng của 3 quả táo, bạn sẽ dễ dàng di chuyển được cây lau nhà mà không hề cảm thấy chút nặng nhọc nào. Trong khi đó tay cầm dài \u003cstrong\u003e1.2m\u003c/strong\u003e của cây lau nhà sẽ cho phép bạn làm sạch các vị trí trên cao như tường nhà hay gầm ghế một cách dễ dàng, thay vì vừa phải kiễng chân lên cao hay cúi người xuống thấp vừa lau nhà theo kiểu truyền thống.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/b4/60/1c/00156978a02f083ccc744d13da140715.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eTay cầm trên cây lau nhà Deerma Xiaomi được bọc ngoài bằng một lớp vật liệu nhựa ABS, giúp làm tăng ma sát giữa người dùng và cây lau. Từ đó hạn chế tình trạng người dùng bị tuột tay khi đang lau nhà. Bên trong cây lau nhà là một lõi thép có tác dụng chống ăn mòn, bảo vệ cây lau được nguyên dạng kể cả khi người dùng lỡ tay đánh rớt nhiều lần. Bể chứa trên cây lau có thiết kế tách rời sẽ giúp bạn thoải mái tháo lắp trong 1 giây mà không tốn chút sức lực nào.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/b5/34/a4/0ef78a74144ef2a724e40d68ca20da35.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eViệc lau nhà trông đơn giản là thế nhưng trên thực tế lại đòi hỏi rất nhiều “kỹ năng”. Bởi lẽ nếu để sàn nhà quá ướt sàn nhà sẽ rất dễ bị trơn trượt và tạo điều kiện cho nấm mốc sinh sôi. Trong khi sàn nhà quá khô sẽ không thể làm sạch hoàn toàn vi khuẩn được. Thế nhưng bằng cơ chế phun nước ở dạng phun sương trong 0.1 giây, cây lau nhà có thể kiểm soát lượng nước mỗi lần phun chỉ dao động trong khoảng từ 1.7ml đến 2ml.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/ee/f1/56/c459b057f889d2bff7b93c17af87b883.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eMặt khác, nếu kiểu lau nhà truyền thống buộc bạn phải thực hiện nhiều thao tác rất bất tiện như làm ướt khăn lau, lau sơ qua một lượt rồi lại giặt khăn để lau tiếp thì với cây lau nhà lần này, bạn chỉ cần một động tác duy nhất là kéo cây lau theo hướng nước phun. Bể chứa dung tích 350ml trên cây lau sẽ cho phép bạn làm sạch không gian rộng đến 100m\u003csup\u003e2\u003c/sup\u003e chỉ với một lần bơm đầy nước.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/03/14/54/624f945115fdd288ff374902e0b2a4dc.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eKhi điều chỉnh cây lau, khoảng cách nước phun ra có thể lên đến 95cm. Tạo thành một khu vực phun hình quạt, có bán kính rộng hơn. Lúc này bạn chỉ cần di chuyển cây lau là đã có thể làm sạch sàn nhà được ngay trong khi thời gian lau lại được tiết kiệm đến mức tối đa. Các hạt nước sau khi phun đều ở dạng hạt mịn nên có thể duy trì độ ẩm cân bằng cho sàn nhà, giúp sàn khô ngay lập tức sau khi lau và không còn sự hiện diện của nấm mốc, vi khuẩn nữa.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/97/24/4a/88b1c8da660ee3e5da804495d63e7e03.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/e8/04/3b/c4e7970b94fa5fe4347a2c2d157bb5ab.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eĐể làm nên hiệu quả làm sạch thuộc hàng vô đối, khăn lau trên cây lau nhà Deerma Xiaomi cũng là một bộ phận không thể bỏ qua. Với kết cấu khăn lau bằng vải sợi carbon, sợi vải sẽ trở nên vô cùng nhẹ nhàng và bền bỉ. Với khả năng bám dính cao với mặt sàn, khăn lau sẽ “khuất phục” được cả những loại bụi bẩn cứng đầu nhất, kể cả lông thú cưng nhà bạn. Khăn lau có độ dày 10mm sẽ cho khả năng thấm hút nước cực mạnh cũng như cho hiệu quả làm sạch khô nhanh chóng.  \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/29/c3/6e/9c1204599a1fe4f9a5c769d1a5c6b206.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eỞ ngay đầu chổi lau của \u003cstrong\u003ecây lau nhà\u003c/strong\u003e, nhà sản xuất thiết kế một khớp xoay giúp đầu lau có thể linh động xoay được 360 độ. Trong khi đó, đầu nhựa nối với khăn lau chỉ dày 3cm, điều này sẽ khiến đầu lau sẽ trở nên cực kỳ linh hoạt. Có thể len lỏi khắp các ngóc ngách trong nhà và làm sạch các vị trí khuất như góc tủ, chân bàn hay gầm giường mà không gặp bất cứ trở ngại nào.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/e5/19/96/4aa5bd829abe9ced3478b8bbbbdde302.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eTrong trường hợp muốn làm tăng hiệu quả làm sạch hơn nữa hoặc muốn sàn nhà thơm mát hơn, bạn có thể đổ thêm các loại tinh dầu, chất tẩy rửa, nước lau sàn vào bể chứa. Lúc này các chất kể trên sẽ được nước trong bể dung hòa và tạo thành dung dịch làm sạch hiệu quả cho sàn nhà của bạn.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/51/76/15/e5b39dfbb0ff57bba4042822c74d9cf4.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\