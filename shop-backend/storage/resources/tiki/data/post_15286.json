3e \u003c/div\u003e\n\u003cdiv\u003eTrong 100g Gạo Lứt có:\u003c/div\u003e\n\u003cul\u003e\n\u003cli\u003e70g Carbonhydrat\u003c/li\u003e\n\u003cli\u003e2,5g chất xơ\u003c/li\u003e\n\u003cli\u003e100mg Magie\u003c/li\u003e\n\u003cli\u003e0.4mg Vitamin B6\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eCÁCH NẤU \u003c/strong\u003e\u003c/p\u003e\n\u003cdiv\u003eNgâm gạo 30 - 60 phút trước khi nấu\u003c/div\u003e\n\u003cdiv\u003eSau khi ngâm, vo gạo khoảng 2, 3 lần để làm sạch\u003c/div\u003e\n\u003cdiv\u003e1 chén gạo cho 1 - 1.5 chén nước\u003c/div\u003e\n\u003cdiv\u003eNấu trong vòng 30 - 45 phút\u003c/div\u003e\n\u003cp\u003e\u003cstrong\u003eBẢO QUẢN \u003c/strong\u003e\u003c/p\u003e\n\u003cdiv\u003eĐể nơi khô ráo, thoáng mát, tránh ánh nắng trực tiếp\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/6b/2f/d3/f2aba48af60f3a7f823e2bec497047ee.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/6b/2f/d3/f2aba48af60f3a7f823e2bec497047ee.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/6b/2f/d3/f2aba48af60f3a7f823e2bec497047ee.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6b/2f/d3/f2aba48af60f3a7f823e2bec497047ee.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6b/2f/d3/f2aba48af60f3a7f823e2bec497047ee.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/f4/0d/fe/30f2632239b0f8376924f01ef2e31162.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f4/0d/fe/30f2632239b0f8376924f01ef2e31162.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts