96ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/bc/10/67/2ab81d5ea3220ec6db205bee054bd1bc.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":692,"all_time_quantity_sold":13,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2 class=\"BlockTitle__Wrapper-sc-qpz3fo-0 eHltcn\"\u003eMô Tả Sản Phẩm\u003c/h2\u003e\n\u003cdiv class=\"content\"\u003e\n\u003cdiv class=\"ToggleContent__Wrapper-sc-1dbmfaw-1 cqXrJr\"\u003e\n\u003cdiv class=\"ToggleContent__View-sc-1dbmfaw-0 wyACs\"\u003e\n\u003ch3\u003e\u003cstrong\u003eThiết kế bảo vệ thân máy hiệu quả\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eĐược sáng tạo với mục đích bảo vệ Galaxy S22 trước những sự cố bất ngờ có thể xảy đến như va chạm bất ngờ, bộ bao da Smart LED View bao bọc lấy các góc máy một cách hiệu quả để hạn chế tình trạng nứt vỡ, móp méo hoặc trầy xước xảy ra trong quá trình sử dụng. Kích cỡ nhỏ gọn giúp bộ phụ kiện không đem lại cảm giác vướng víu khi cầm nắm, để bạn dễ dàng hơn khi sử dụng.\u003c/p\u003e\n\u003cdiv\u003e\u003csource type=\"image/webp\"\u003e\u003c/source\u003e\u003cimg class=\"WebpImg__StyledImg-sc-h3ozu8-0 fWjUGo\" src=\"https://salt.tikicdn.com/ts/tmp/bc/10/67/94b584b0d3e9f2f59891dfbde2ae0db0.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/div\u003e\n\u003ch3\u003e\u003cstrong\u003eKích hoạt hệ thống đèn LED thông báo\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eThông qua hệ thống đèn Smart LED View, chủ nhân của Galaxy S22 sẽ thoải mái quan sát và theo dõi những thông tin cần thiết như thời gian, ngày tháng, tin nhắn, cuộc gọi, bộ hẹn giờ, thời lượng pin còn lại và những biểu tượng thông báo đơn giản được bật trên màn hình LED. Hãy thoải mái sử dụng các biểu tượng mà nhà sản xuất tích hợp sẵn hoặc biến tấu theo sở thích của bản thân.\u003c/p\u003e\n\u003cdiv\u003e\u003csource type=\"image/webp\"\u003e\u003c/source\u003e\u003cimg class=\"WebpImg__StyledImg-sc-h3ozu8-0 fWjUGo\" src=\"https://salt.tikicdn.com/ts/tmp/2a/6b/ec/204151d97cdd3b141743bc8d02834aa7.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/div\u003e\n\u003ch3\u003e\u003cstrong\u003eTrang bị khay chứa thẻ đi kèm\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eTrên bộ bao da Smart LED View được thiết kế độc quyền cho Galaxy S22, đội ngũ kỹ sư  samsung đã cho thấy sự tinh tế khi trang bị thêm khay chứa thẻ ở ngay mặt tiếp xúc của màn hình. Tận dụng được khoảng không gian trống bên trong để hỗ trợ chủ nhân Galaxy S22 thoải mái lưu trữ các loại thẻ cần thiết cho cuộc sống cá nhân như thẻ tiêu dùng, thẻ ra vào và một số dòng thẻ dịch vụ khác. So với việc chứa thẻ trong ví, thao tác này sẽ giúp bạn sử dụng thẻ được tiện lợi hơn trước nhiều.\u003c/p\u003e\n\u003cdiv\u003e\u003csource type=\"image/webp\"\u003e\u003c/source\u003e\u003cimg class=\"WebpImg__StyledImg-sc-h3ozu8-0 fWjUGo\" src=\"https://salt.tikicdn.com/ts/tmp/01/e2/2b/f805a0e56dfa27676cf18b4a36489858.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/div\u003e\n\u003cdiv\u003e\u003csource type=\"image/webp\"\u003e\u003c/source\u003e\u003cimg class=\"WebpImg__StyledImg-sc-h3ozu8-0 fWjUGo\" src=\"https://salt.tikicdn.com/ts/tmp/58/cd/75/d1f7afe3fbaa78a8556bc82990234cb0.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/div\u003e\n\u003ch3\u003e\u003cstrong\u003eChất da mềm mại, cao cấp và rất bền\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eĐể tạo nên sản phẩm bao da Smart LED View dành cho Galaxy S22 mà bạn đang theo dõi, Samsung đã tìm ra chất liệu da mềm và có độ mỏng tối ưu nhất nhằm đảm bảo hiệu quả chống xước, chống sốc mà vẫn đạt tiêu chuẩn bền nhẹ cần thiết. Mặt da mềm đem lại cảm nhận cầm nắm chân thật, êm ái và biến chiếc smartphone của bạn thành thiết bị sang trọng bậc nhất nhờ mặt da bóng đẹp, cuốn hút.\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/bc/10/67/2ab81d5ea3220ec6db205bee054bd1bc.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/bc/10/67/2ab81d5ea3220ec6db205bee054bd1bc.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/bc/10/67/2ab81d5ea3220ec6db205bee054bd1bc.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/bc/10/67/2ab81d5ea3220ec6db205bee054bd1bc.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/bc/10/67/2ab81d5ea3220ec6db205bee054bd1bc.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/58/cd/75/4a76a1bf285f1d945c2e5fade9b6370a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/58/cd/75/4a76a1bf285f1d945c2e5fade9b6370a.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/58/cd/75/4a76a1bf285f1d945c2e5fade9b6370a.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/58/cd/75/4a76a1bf285f1d945c2e5fade9b6370a.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/58/cd/75/4a76a1bf285f1d945c2e5fade9b6370a.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/2a/6b/ec/e1bc182652f6