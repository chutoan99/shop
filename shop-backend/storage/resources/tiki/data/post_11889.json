2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":90000,"discount_rate":50,"rating_average":5,"review_count":68,"review_text":"(68)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/d4/13/05/70f3daf64fc622037745c6c5d9015696.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1366,"all_time_quantity_sold":304,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p class=\"irIKAp\"><strong>***Túi phụ kiện Sakos Versa – GIẢI PHÁP CHO NHỮNG PHỤ KIỆN CẦN THIẾT NHƯNG DỄ BỊ LÃNG QUÊN***</strong></p>\n<p class=\"irIKAp\">Những phụ kiện như dây sạc laptop, sạc dự phòng, dây sạc điện thoại, tai nghe, dây nguồn… những vật dụng luôn cần thiết nhưng dễ bị bỏ quên. Giờ đây, bạn không cần lo ngại về việc lục tung chiếc balo, túi xách để tìm những thứ này. Túi phụ kiện VERSA nhỏ gọn sẽ giải quyết “gọn trơn” những thứ “rối ren” một cách nhanh chóng và đơn giản.</p>\n<p class=\"irIKAp\"><strong>1. THÔNG SỐ CỦA SẢN PHẨM</strong></p>\n<p class=\"irIKAp\">- Thương hiệu: Sakos</p>\n<p class=\"irIKAp\">- Màu sắc: Xanh đen, Xanh dương, Đỏ, Đen</p>\n<p class=\"irIKAp\">- Chất liệu: Polyester, PE,</p>\n<p class=\"irIKAp\">- Trọng lượng: 0.08 kg</p>\n<p class=\"irIKAp\">- Kích thước: 17x12x4 cm</p>\n<p class=\"irIKAp\">- Tải trọng tối đa: 3kg</p>\n<p class=\"irIKAp\">- Bảo hành chính hãng: 30 ngày</p>\n<p class=\"irIKAp\"><strong>2. CHI TIẾT SẢN PHẨM</strong></p>\n<p class=\"irIKAp\">Dễ dàng sắp xếp đồ dùng ngăn nắp, không lo bị bỏ quên</p>\n<p class=\"irIKAp\">- Kích thước nhỏ gọn chỉ 17 x 15 x 4 cm (rộng x sâu x cao) nhưng túi dụng cụ SAKOS VERSA rất dễ dàng cho vào balo, túi xách. Các vật dụng sẽ được sắp xếp một cách gọn gàng dù bạn là người không mấy ngăn nắp.</p>\n<p class=\"irIKAp\">- Hệ thống phân ngăn tận dụng tối đa diện tích hai mặt bên cố định các loại phụ kiện như tai nghe, sạc dự phòng, sạc laptop, sạc điện thoại hay thậm chí là ổ cứng…</p>\n<p class=\"irIKAp\">- Mặt nông gồm vách ngăn lưới kế hợp đai thun co giãn, cố định tốt đồ dùng. Phần nắp sâu lồng trang bị đai cố định. Đặc biệt phần đai có thể linh hoạt tùy chỉnh linh hoạt theo kích thước phụ kiện bằng cách trượt theo đai gai hai bên.</p>\n<p class=\"irIKAp\">- Vải lót bên trong chiếc túi phụ kiện thông minh VERSA có tính năng chống thấm – hút ẩm – kháng khuẩn, bảo quản tốt đồ dùng kể cả trong điều kiện thời tiết ẩm ướt.</p>\n<p class=\"irIKAp\"> </p>\n<p class=\"irIKAp\">Chất liệu Polyester trượt nước, sáng màu, bền bỉ cùng thời gian</p>\n<p class=\"irIKAp\">- Có cấu tạo từ Polyester 600D, VERSA sở hữu tính năng trượt nước vượt trội. Nước sẽ nhanh chóng rơi khỏi bề mặt túi ngay sau khi tiếp xúc. Đây cũng là chất liệu sáng mịn, bền bỉ dù sử dụng lâu.</p>\n<p class=\"irIKAp\">- Chất liệu cao cấp kết hợp công nghệ in chuyển nhiệt thương hiệu SAKOS trên bề mặt túi không lo bong tróc.</p>\n<p class=\"irIKAp\"> </p>\n<p class=\"irIKAp\">Khóa kéo êm mượt, viền khung chắc chắn</p>\n<p class=\"irIKAp\">- Dây kéo nhựa dẻo êm mượt, lá kéo kim loại chống gỉ sét là điểm cộng cho VERSA. Công nghệ ngay gấp mép viền trên dây chuyền sản xuất USA hiện đại đã tạo nên một chiếc túi phụ kiện đơn giản nhưng đạt đến độ bền, thẩm mỹ không tì vết.</p>\n<p class=\"irIKAp\">- Ngoài dây kéo nhựa êm ái, túi dụng cụ VERSA còn được trang bị sợi nhựa PE xung quanh vững dáng chiếc túi dù bị vật nặng đè.</p>\n<p class=\"irIKAp\"> </p>\n<p class=\"irIKAp\">Dù nam hay nữ, đi học hay đi làm đều hợp!</p>\n<p class=\"irIKAp\">- Ba tông màu hiện đại: đỏ cá tính – xanh đen mạnh mẽ – xanh dương tinh tế thích hợp cho cả nam và nữ. Thiết kế nhỏ gọn rất tiện khi cho vào balo, túi xách mà không chiếm quá nhiều không gian.</p>\n<p class=\"irIKAp\"><strong>3. SAKOS CAM KẾT VỚI KHÁCH HÀNG</strong></p>\n<p class=\"irIKAp\">- 1 ĐỔI 1 trong vòng 07 ngày sản phẩm bị lỗi do nhà sản xuất (nhắn tin cho Shop để được hỗ trợ nhanh nhất).</p>\n<p class=\"irIKAp\">- BẢO HÀNH chính hãng theo chính sách của Sakos.</p>\n<p class=\"irIKAp\"><strong>4. DỊCH VỤ CỦA SAKOS</strong></p>\n<p class=\"irIKAp\">- Gói hàng cẩn thận trước khi giao cho khách.</p>\n<p class=\"irIKAp\">- Hỗ trợ tư vấn chăm sóc khách hàng 24/7 (khách iu ơi! Nhắn cho Sakos ngay nhé)</p>\n<p class=\"irIKAp\"><strong>___KHÁCH HÀNG B2B - QUÀ TẶNG DOANH NGHIỆP VUI LÒNG NHẮN TIN CHO SHOP ĐỂ ĐƯỢC HỖ TRỢ MỨC TỐT NHẤT___</strong></p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/d4/13/05/70f3daf64fc622037745c6c5d9015696.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d4/13/05/70f3daf64fc622037745c6c5d9015696.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d4/13/05/70f3daf64fc622037745c6c5d9015696.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d4/13/05/70f3daf64fc622037745c6c5d9015696.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d4/13/05/70f3daf64fc622037745c6c5d9015696.png"},{"base_url":"https://salt.tikicdn.com/ts/product/eb/c8/