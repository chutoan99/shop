ttps://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":64000,"discount_rate":20,"rating_average":4.5,"review_count":16,"review_text":"(16)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/41/a7/ee/b8105cc5e2554742571912d81016f00e.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1586,"all_time_quantity_sold":112,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p><strong>Ngũ Cốc Dinh Dưỡng Mẹ Bầu LoliFood - Mang Lại Giá Trị Dinh Dưỡng Cho Mẹ Bầu</strong></p>\n<p><strong>Tặng kèm muỗng gỗ (Quà tặng có thể được thay đổi tùy theo từng thời điểm)</strong></p>\n<p><strong>Thành phần:</strong> Đậu đen xanh lòng hạt nhỏ, đậu xanh, đậu đỏ, đậu ngự, gạo lứt, vừng đen, yến mạch, hạt sen, macca, sachi, hạnh nhân, óc chó, hạt chia, điều sữa. Các loại đậu được Long Liên thu gom từ bà con nông dân dưới sự kiểm soát và lựa chọn kỹ càng. Sau đó rửa sạch, ngâm, ủ lên mầm, sấy khô rồi rang xay thành phẩm.</p>\n<p><strong>Công dụng:</strong></p>\n<ul><li>Giúp mẹ bầu loại bỏ chứng táo bón thường xảy ra trong thai kỳ.</li>\n<li>Làm giảm nguy cơ mắc bệnh tiểu đường của các mẹ bầu.</li>\n<li>Mang đến cho bé yêu nguồn dinh dưỡng dồi dào, bé phát triển khỏe mạnh và tăng cân đều trong suốt thai kỳ.</li>\n<li>Các loại hạt trong ngũ cốc chứa nhiều omega 3, omega 6, DHA giúp bé yêu phát triển một cách toàn diện.</li>\n<li>Hàm lượng axit folic cao cũng giúp ngăn ngừa các dị tật ẩm sinh ở thai nhi.</li>\n<li>Giúp mẹ có sữa non sớm khi sinh.</li>\n</ul><p><strong>Hướng dẫn sử dụng:</strong></p>\n<ul><li>Pha 3 - 4 thìa cà phê bột ngũ cốc với 200ml nước ấm.</li>\n<li>Thêm sữa đặc hoặc đường theo khẩu vị riêng.</li>\n<li>Uống đều đặn mỗi ngày 3 - 4 lần để có hiệu quả tốt nhất.</li>\n</ul><p style=\"text-align:center;\"><img src=\"https://salt.tikicdn.com/ts/tmp/64/bc/cd/3cf7fb77bebb828bb743a3920618cea1.jpg\" alt=\"\" width=\"750\" height=\"500\" /></p>\n<p><strong>Bảo quản:</strong></p>\n<ul><li>Sản phẩm có hạn sử dụng 12 tháng kể từ ngày sản xuât.</li>\n<li>Bảo quản nơi khô ráo, thoáng mát, tránh ánh nắng trực tiếp và nơi ẩm mốc.</li>\n<li>Sử dụng tốt nhất trong vòng 50 ngày kể từ ngày mở túi.</li>\n</ul><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/41/a7/ee/b8105cc5e2554742571912d81016f00e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/41/a7/ee/b8105cc5e2554742571912d81016f00e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/41/a7/ee/b8105cc5e2554742571912d81016f00e.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/41/a7/ee/b8105cc5e2554742571912d81016f00e.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/41/a7/ee/b8105cc5e2554742571912d81016f00e.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/16/fd/ee/5971b7c7535a7e20bd58408da1fec5fb.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/16/fd/ee/5971b7c7535a7e20bd58408da1fec5fb.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/16/fd/ee/5971b7c7535a7e20bd58408da1fec5fb.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/produc