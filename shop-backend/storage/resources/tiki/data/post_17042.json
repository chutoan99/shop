pe":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":123700,"discount_rate":32,"rating_average":3.7,"review_count":9,"review_text":"(9)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/cc/16/c5/f2231dd09648975d7872dcb96c8e86e6.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":588,"all_time_quantity_sold":144,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003eGiới thiệu\u003c/h3\u003e\n\u003cp\u003eTã/bỉm dán Huggies Skincare Super Jumbo M76/L68/XL60/XXL54\u003c/p\u003e\n\u003ch3\u003eĐặc điểm nổi bật\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eTinh chất TRÀM TRÀ TỰ NHIÊN trên bề mặt tã giúp hạn chế vi khuẩn, làm dịu và chữa lành da bé. \u003c/li\u003e\n\u003cli\u003eCông nghệ BONG BÓNG 3D - Ngăn thấm ngược giúp thấm hút tức thì, khóa chặt chất lỏng sâu bên trong và ngăn thấm ngược.\u003c/li\u003e\n\u003cli\u003eLớp đệm siêu mềm được bổ sung tại các vị trí dễ tổn thương như lưng, bụng và hai đùi giúp nâng niu toàn vẹn da bé ngay cả khi bé vận động.\u003c/li\u003e\n\u003cli\u003eMàng đáy thoát ẩm 100% cho phép không khí lưu thông và thoát khỏi màng đáy dễ dàng, giúp da bé luôn khô thoáng và ngăn ngừa hăm tã.\u003c/li\u003e\n\u003cli\u003eKhả năng thoáng khí được chứng minh lâm sàng giúp NGỪA HĂM TÃ, cho da bé luôn được khô thoáng dài lâu.\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003eHướng dẫn chọn size \u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eSize M – cho bé từ 6 - 11 kg\u003c/li\u003e\n\u003cli\u003eSize L – cho bé từ 9 - 14 kg\u003c/li\u003e\n\u003cli\u003eSize XL – cho bé từ 12 - 17 kg\u003c/li\u003e\n\u003cli\u003eSize XXL – cho bé trên 15 kg\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003eHướng dẫn sử dụng\u003c/h3\u003e\n\u003col\u003e\n\u003cli\u003eLuồn tã dưới mông bé và kéo thẳng ngay ngắn. \u003c/li\u003e\n\u003cli\u003eDán miếng dán lần lượt từng bên không quá lỏng hoặc quá chặt\u003c/li\u003e\n\u003cli\u003eLuồn ngón tay bên hông kiểm tra tã vừa vặn với người, giúp tránh tràn ra ngoài.\u003c/li\u003e\n\u003c/ol\u003e\n\u003ch3\u003eHướng dẫn bảo quản\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eBảo quản nơi khô ráo, thoáng mát, tránh ánh sáng trực tiếp\u003c/li\u003e\n\u003cli\u003eTránh xa tầm tay trẻ em\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003eThông số sản phẩm\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eHSD: 3 năm kể từ ngày sản xuất (ngày sản xuất: xem trên bao bì)\u003c/li\u003e\n\u003cli\u003eThương hiệu: Huggies\u003c/li\u003e\n\u003cli\u003eXuất xứ thương hiệu: Mỹ\u003c/li\u003e\n\u003cli\u003eXuất xứ sản phẩm: Trung Quốc\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eTHÔNG TIN THƯƠNG HIỆU\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTẬP ĐOÀN KIMBERLY CLARK - MỘT LỊCH SỬ ĐÁNG TỰ HÀO \u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eThành lập vào năm 1872 tại Wisconsin, Mỹ, là đơn vị kinh doanh hàng đầu các sản phẩm Chăm sóc sức khỏe gia đình, Chăm sóc sức khỏe trẻ em cùng những sản phẩm vệ sinh chuyên dụng.\u003c/p\u003e\n\u003cp\u003eHiện nay, Kimberly Clark cùng những thương hiệu của mình tự hào là một phần không thể thiếu trong cuộc sống con người tại hơn 175 quốc gia. Mỗi ngày, hơn 1/4 thế giới tin tưởng Kimberly Clark để nâng cao sức khỏe, cải thiện vệ sinh và chất lượng cuộc sống. Nhờ vào sự tin tưởng của khách hàng mà hiện nay, Kimberly Clark đang nắm giữ vị  trí số 1 trong việc cung cấp các sản phẩm thiết yếu tại hơn 80 quốc gia trên toàn thế giới.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/cc/16/c5/f2231dd09648975d7872dcb96c8e86e6.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/cc/16/c5/f2231dd09648975d7872dcb96c8e86e6.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/cc/16/c5/f2231dd09648975d7872dcb96c8e86e6.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/cc/16/c5/f2231dd09648975d7872dcb96c8e86e6.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/cc/16/c5/f2231dd09648975d7872dcb96c8e86e6.png"},{"base_url":"https://salt.tikicdn.com/ts/product/8c/56/d4/3944840b7e9531ce825d06c4e4fe46c1.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/8c/56/d4/3944840b7e9531ce825d06c4e4fe46c1.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/8c/56/d4/3944840b7e9531ce825d06c4e4fe46c1.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8c/56/d4/3944840b7e9531ce825d06c4e4fe46c1.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8c/56/d4/3944840b7e9531ce825d06c4e4fe46c1.png"},{"base_url":"https://salt.tikicdn.com/ts/product/6d/79/fc/b30353a5ceef1b8701115f91ea853d24.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/6d/79/fc/b30