í hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/0b/f0/be/25d497c9aa8c63e770ce641e2f5e6d31.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0b/f0/be/25d497c9aa8c63e770ce641e2f5e6d31.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/0b/f0/be/25d497c9aa8c63e770ce641e2f5e6d31.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0b/f0/be/25d497c9aa8c63e770ce641e2f5e6d31.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0b/f0/be/25d497c9aa8c63e770ce641e2f5e6d31.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/2b/dc/e6/b464868b1bb5071254fd46ef627e275c.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/2b/dc/e6/b464868b1bb5071254fd46ef627e275c.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/2b/dc/e6/b464868b1bb5071254fd46ef627e275c.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2b/dc/e6/b464868b1bb5071254fd46ef627e275c.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2b/dc/e6/b464868b1bb5071254fd46ef627e275c.jpg"}],"warranty_policy":null,"brand":{"id":152608,"name":"Andes","slug":"andes"},"current_seller":{"id":19357,"sku":"5794034447732","name":"Nón Bảo Hiểm Halo Phượt","link":"https://tiki.vn/cua-hang/non-bao-hiem-halo-phuot","logo":"ca/f8/f3/884dc7fda5f4b5a60bada93b1bd58082.jpg","price":349000,"product_id":"172816464","store_id":18721,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Thông tin chung","attributes":[{"code":"brand","name":"Thương hiệu","value":"Andes"},{"code":"brand_country","name":"Xuất xứ thương hiệu","value":"Việt Nam"},{"code":"origin","name":"Xuất xứ (Made in)","value":"Việt Nam"},{"code":"item_model_number","name":"Model