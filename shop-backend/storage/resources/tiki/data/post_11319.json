s_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":1910000,"discount_rate":24,"rating_average":5,"review_count":6,"review_text":"(6)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ab/bc/03/17f7f4cfe0bfa294703d8cdefe3c3b8c.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1125,"all_time_quantity_sold":18,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<div class=\"mb-4 font-size-lg font-weight-bold\">\n<p><strong>(MIỄN PHÍ giao hàng và lắp đặt tại: Hà Nội, TP. Hồ Chí Minh, Hải Phòng và Đà Nẵng)</strong></p>\n</div>\n<div class=\"mb-4 font-size-lg font-weight-bold\">Giới thiệu sản phẩm</div>\n<div class=\"mb-4 font-size-lg font-weight-bold\"><iframe src=\"//www.youtube.com/embed/wOKqBvorKk0\" width=\"560\" height=\"314\" allowfullscreen=\"\"></iframe></div>\n<div class=\"post-body\">\n<div class=\"text-justify\"><strong>Giàn tạ đa năng kết hợp xà đơn xà kép Zasami 8211 </strong>tích hợp nhiều bài tập, sẽ là lựa chọn hoàn hảo để bạn có cơ bụng 6 múi, thân hình săn chắc mà không cần đến phòng Gym.</div>\n<div class=\"text-justify\">\n<h2><strong>ĐẶC ĐIỂM NỔI BẬT</strong></h2>\n<p><strong><img style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/6a/76/c5/8700a1c63dd92aa79a49f77a683b69a1.jpg\" alt=\"\" width=\"750\" height=\"750\" /></strong></p>\n<p><strong><img style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/47/49/1a/9d0048e0e32dbd0fbd0678e9d18930c0.jpg\" alt=\"\" width=\"750\" height=\"1000\" /></strong></p>\n<p class=\"text-justify\">Giàn tạ đa năng kết hợp xà đơn xà kép Zasami 8211 với <strong>11 chức năng</strong> tập Gym tại nhà gồm:</p>\n<p class=\"text-justify\"><strong><em>- Tập kéo xô trước - xô sau</em></strong></p>\n<p class=\"text-justify\"><strong><em>- Tập cơ đùi trước - cơ đùi sau</em></strong></p>\n<p class=\"text-justify\"><strong><em>- Tập ngực trên - ngực dưới - ngực giữa</em></strong></p>\n<p class=\"text-justify\"><strong><em>- Tập bụng</em></strong></p>\n<p class=\"text-justify\"><strong><em>- Tập ép ngực</em></strong></p>\n<div class=\"text-justify\">Thiết kế chắc chắn, kiểu dáng thể thao, màu sắc nổi bật sẽ tạo phong cách riêng cho ngôi nhà bạn.</div>\n<div class=\"text-justify\">Bề mặt được sơn tĩnh điện, độ bền cao, chống gỉ, chống xước tốt.</div>\n<div class=\"text-justify\">Tiện nghi tối đa: Thiết kế động điều chỉnh phù hợp với thể hình mỗi người.</div>\n<div class=\"text-justify\">Nệm tựa lưng êm ái – hạn chế chấn thương.</div>\n<div class=\"text-justify\">Hiệu quả tối ưu: Bộ ròng rọc trợ lực, dây cáp, bố trí các điểm puly phù hợp cho các động tác được kéo nhẹ, mượt, trơn.</div>\n<h2><strong>HƯỚNG DẪN CÁC BÀI TẬP</strong></h2>\n<p class=\"text-justify\"> với thiết kế đơn giản, dễ dàng sử dụng. Tuy nhiên, bạn có thể dành ra một vài phút để tìm hiểu kỹ hơn về cách tập luyện của giàn tạ này.</p>\n<p class=\"text-justify\"><img style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/65/23/a7/27e8e8b036ae51b86afbfdfa2113ea9b.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p><img style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/ae/5f/7c/afd6989f2e5ba5aaace0137ab508a3a3.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p><img style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/ba/9a/3e/1e33d71b5a17e7e71d606e6f4af00b2a.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p><img style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/05/de/0b/d61f844b8b3f4ce1635754598c0d0059.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p><img style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/53/e8/41/1aec5d6d0ec4227bc2b9d535004019e6.jpg\" alt=\"\" width=\"750\" height=\"749\" /></p>\n<p><img style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/f1/fb/e7/2a55de7c231faaf81fe94f4aaffcd11c.jpg\" alt=\"\" width=\"750\" height=\"749\" /></p>\n<p><img style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/17/32/51/b9d29314c878235856cd7a94fd7abcb1.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p><img style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/1d/44/28/2995aa65de44e69c3aabb680c22af955.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p><img style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/ab/c6/fd/9efdb5df9ce9d65dae7e8ab8ba37352d.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p><img style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/57/74/ad/d7179e814b2265d58d7bbed2e931cc83.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p><img style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/27/53/cd/c0a299c23794ff1e674653ac29f67abf.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<div class=\"text-justify\">Với bất kỳ bài tập nào cũng vậy, giàn tạ Zasami 8211 cũng cần 5 phút khởi động bình thường để các khớp, cơ bắp sẵn sàng vận động theo cường độ tập luyện của bạn.</div>\n<p> </p>\n</div>\n</div><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ab/bc/03/17f7f4cfe0bfa294703d8cdef