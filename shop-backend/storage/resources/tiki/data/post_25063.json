dn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":469000,"discount_rate":47,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/cb/47/97/6dde5e74e61cb1046b6b5baa0d237b2f.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":409,"all_time_quantity_sold":13,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eVIÊN UỐNG HỖ TRỢ TIM MẠCH, HUYẾT ÁP HEALTHY CARE OMEGA 3 6 9 ULTIMATE 200 VIÊN\u003c/p\u003e\n\u003cp\u003eViên uống Omega 3 6 9 Healthy Care Ultimate là sự kết hợp đầy đủ giữa các thành phần Omega 3, 6 và 9 axit béo cùng dầu hạt lanh, dầu cá và tinh dầu hoa anh thảo\u003c/p\u003e\n\u003cp\u003e* Thương hiệu: Healthy Care\u003c/p\u003e\n\u003cp\u003e* Xuất xứ: Úc\u003c/p\u003e\n\u003cp\u003e* Quy cách: Hộp 200 viên\u003c/p\u003e\n\u003cp\u003e* Hạn sử dụng: 3 năm kể từ ngày sản xuất\u003c/p\u003e\n\u003cp\u003e* Ngày sản xuất và hạn sử dụng được in trên bao bì sản phẩm\u003c/p\u003e\n\u003cp\u003eOMEGA 3 6 9 LÀ GÌ?\u003c/p\u003e\n\u003cp\u003e- Omega 3: là 1 loại axit béo thiết yếu của cơ thể. Do cơ thể không thể tự tổng hợp được mà cần phải nhờ thực phẩm mang vào. Trong đó, quan trọng nhất là DHA và EPA. Ngoài ra còn có ALA. Có tác dụng bảo vệ tim mạch (giảm loạn nhịp tim, giảm nguy cơ đột quỵ…); giảm tình trạng cứng khớp và đau khớp; trầm cảm…\u003c/p\u003e\n\u003cp\u003e- Omega 6: là chất béo thiết yếu cho hoạt động của cơ thể. Việc bổ sung các acid béo omega-6 thay cho chất béo bão hòa và các loại chất béo chuyển dạng từ chất béo chưa no sẽ giúp làm giảm các nguy cơ mắc bệnh tim mạch.\u003c/p\u003e\n\u003cp\u003e- Omega 9: còn được gọi là Oleic Acid. Đây là một loại chất béo không bão hòa đơn thể. Nó có tác dụng tốt trong việc phòng ngừa các bệnh về tim mạch; là tác nhân bảo vệ trái tim, giảm áp huyết, đẩy lùi quá trình lão hó\u003c/p\u003e\n\u003cp\u003eCÔNG DỤNG CỦA HEALTHY CARE OMEGA 3 6 9\u003c/p\u003e\n\u003cp\u003e- Omega 3 6 9 Health Care giúp hỗ trợ tuần hoàn, bảo vệ tim mạch, ngăn ngừa các bệnh tim mạch, huyết áp\u003c/p\u003e\n\u003cp\u003e- Bảo vệ tế bào thần kinh, tăng trí nhớ\u003c/p\u003e\n\u003cp\u003e- Cải thiện tình trạng về da, tóc, móng và các loại mụn trứng cá\u003c/p\u003e\n\u003cp\u003e- Hỗ trợ tăng cường sức đề kháng và hệ miễn dịch giúp cải thiện sức khỏe toàn diện\u003c/p\u003e\n\u003cp\u003eHƯỚNG DẪN SỬ DỤNG HEALTHY CARE OMEGA 3 6 9\u003c/p\u003e\n\u003cp\u003e- Người lớn: Uống 2-3 viên/lần, 3 lần một ngày với bữa ăn\u003c/p\u003e\n\u003cp\u003e- Trẻ em 6-12 tuổi: Uống 1 viên/lần, 1 đến 2 lần một ngày\u003c/p\u003e\n\u003cp\u003e- Trẻ em 2-6 tuổi: Uống 1 viên mỗi ngày (có thể vắt vào sữa, nước trái cây hoặc ngũ cốc)\u003c/p\u003e\n\u003cp\u003eHEALTHY CARE VIỆT NAM cam kết phân phối sản phẩm 100% chính hãng. Hỗ trợ đổi trả trong vòng 07 ngày nếu sản phẩm gặp các vấn đề lỗi từ phía nhà sản xuất, sản phẩm gặp vấn đề trong quá trình vận chuyển.\u003c/p\u003e\n\u003cp\u003e- Sản phẩm đổi trả phải còn nguyên mác niêm phong, chưa qua sử dụng.\u003c/p\u003e\n\u003cp\u003e- Khách hàng nên quay lại quá trình mở kiện hàng vận chuyển để thuận tiện hơn trong quá trình đổi, trả hàng nếu có sai sót ở sản phẩm.\u003c/p\u003e\n\u003cp\u003e- Khi đổi trả sản phẩm, nếu không phải lỗi sản phẩm hay shop giao sai sản phẩm, quý khách vui lòng trả phí vận chuyển.\u003c/p\u003e\n\u003cp\u003eSản phẩm không phải là thuốc và không có tác dụng thay thế thuốc chua bệnh.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên 