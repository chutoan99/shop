f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":202000,"discount_rate":40,"rating_average":4.6,"review_count":27,"review_text":"(27)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/2a/99/06/e3c0e5ccdc675e2053d42edc9da9c80a.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1779,"all_time_quantity_sold":227,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eTinh Chất Rau Má Giảm Mụn, Dưỡng Trắng và Phục Hồi Da Nhạy Cảm Skin1004 Madagascar Centella Asiatica 100 Ampoule 100ml\u003cbr /\u003e- Thương hiệu: Skin1004\u003cbr /\u003e- Xuất xứ: Hàn Quốc\u003c/p\u003e\n\u003cp\u003e- Dung tích: 100ml\u003c/p\u003e\n\u003cp\u003e1. Dành cho mọi loại da, da mụn, da kích ứng\u003cbr /\u003e2. Tinh chất làm dịu da, cấp ẩm; dưỡng trắng; giảm mụn, thâm\u003cbr /\u003e3. Rau Má làm sáng da; hỗ trợ chữa lành tổn thương; phục hồi, bảo vệ da\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/b6/32/37/66ff6c81c7d5ff45bd85cfe3de648ffb.png\" alt=\"\" width=\"750\" height=\"760\" /\u003e\u003cbr /\u003eSkin1004 Madagascar Centella Asiatica 100 Ampoule là sản phẩm đã nhận được sự chứng nhận từ người tiêu dùng với bình quân độ hài lòng là 94%.\u003cbr /\u003eTinh chất Centella Asiatica là được tạo ra dưới nỗ lực : \"bức tường\" da, làn da đã bị tổn thương, cân bằng lượng dầu - nước bị phá vỡ - chỉ trong 1 sản phẩm duy nhất.\u003c/p\u003e\n\u003cp\u003eTinh chất dịu nhẹ cho làn da với chiết xuất từ thiên nhiên - Centella Asiatica 100 Ampoule\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/18/f1/5b/e53ed6b044a36fbe75ca552b9bc923ee.jpg\" alt=\"\" width=\"694\" height=\"768\" /\u003e\u003c/p\u003e\n\u003cp\u003eCông dụng:\u003c/p\u003e\n\u003cp\u003e- Hỗ trợ tạo nên sinh lực để làn da có thể tự chữa những tổn thương da, đồng thời cải thiện làn da mẫn cảm.\u003c/p\u003e\n\u003cp\u003e- Mang lại sự rạng rỡ cho làn da sần sùi, sạm đi vì những tác nhân gây hại từ môi trường bên ngoài.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/53/a5/c8/ddb75a4f45b53e59016956491f0b9df3.png\" alt=\"\" width=\"645\" height=\"900\" /\u003e\u003c/p\u003e\n\u003cp\u003e- Thành phần Asiatic Axit (một hoạt chất có trong Rau Má) sẽ cải thiện những vết tích, vết thương nhỏ trên bề mặt da khi làn da đang trở nên mẫn cảm hơn.\u003c/p\u003e\n\u003cp\u003e- Kết cấu lỏng nhẹ sẽ thấm vào sâu trong da, truyền những thành phần hữu hiệu qua lớp biểu bì và bạn sẽ cảm thấy sự ẩm mượt từ bên trong.\u003c/p\u003e\n\u003cp\u003e- Trong sản phẩm chứa đầy chiết xuất Rau Má đúng như ghi trong bảng thành phần (100% Rau Má) - chiết lọc những gì tinh túy nhất từ thành phần này.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/f8/20/e6/01d2678a524ba13e67bd110e344fb33d.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e*Thành phần chính TECA: bao gồm Asiaticoside, Asiatic Axit, Madecassic Axit (những hoạt chất có trong Rau Má)\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/d1/23/19/70eb6e7c36402a5f603596e8826c1513.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eHướng dẫn sử dụng:\u003cbr /\u003e- Sử dụng 2 lần/ngày vào buổi sáng và tối.\u003cbr /\u003e- Sử dụng sau serum/essence, trước kem/dầu dưỡng.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/95/9c/94/b7a2776093e2859d417961ccc49616dc.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/2a/99/06/e3c0e5ccdc675e2053d42edc9da9c80a.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/2a/99/06/e3c0e5ccdc675e2053d42edc9da9c80a.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/2a/99/06/e3c0e5ccdc675e2053d42edc9da9c80a.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2a/99/06/e3c0e5ccdc675e2053d42edc9da9c80a.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2a/99/06/e3c0e5ccdc675e2053d42edc9da9c80a.png"},{"base_url":"https://salt.tikicdn.com/ts/product/18/f1/5b/625127206d8eb4b8e7e1ba8e66a0b361.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/18/f1/5b/625127206d8eb4b8e7e1ba8e66a0b361.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/18/f1/5b/625127206d8eb4b8e7e1ba8e66a0b361.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/18/f1/5b/625127206d8eb4b8e7e1ba8e66a0b361.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/18/f1/5b/625127206d8eb4b8e7e1ba8e66a0b361.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/86/cc/b4/0201db27a0a80bb777cf028888fb89db.png","is_gallery":true,"label":null,