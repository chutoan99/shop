litude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":242000,"discount_rate":51,"rating_average":4.7,"review_count":74,"review_text":"(74)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/32/df/3c/55daac1c62c09af826ea954554134014.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1167,"all_time_quantity_sold":389,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cspan style=\"color: #ff6600;\"\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/f6/b0/f4/a86c468f0946451838ebf07fecb4dd8f.jpg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/f6/b0/f4/a86c468f0946451838ebf07fecb4dd8f.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003ch2 style=\"text-align: center;\"\u003e\u003cspan style=\"color: #ff6600;\"\u003eCÔNG DỤNG CỦA GỐI KÊ LƯNG EMA\u003c/span\u003e\u003c/h2\u003e\n\u003cul\u003e\n\u003cli style=\"font-size: 20px;\"\u003eGiảm đau mỏi lưng dưới (vùng thắt lưng và eo) đặc biệt với đối tượng bà bầu, người cao tuổi, người thường xuyên phải mang vác hoặc cúi người khi làm việc\u003c/li\u003e\n\u003cli style=\"font-size: 20px;\"\u003ePhòng và trị liệu các bệnh cột sống thắt lưng như thoát vị đĩa đệm\u003c/li\u003e\n\u003cli style=\"font-size: 20px;\"\u003eKê lưng thư giãn khi ngủ, tựa lưng hoặc đầu khi đặt trên ghế văn phòng hoặc ghế ô tô\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch2 style=\"text-align: center;\"\u003e\u003cspan style=\"color: #ff6600;\"\u003eĐIỂM NỔI BẬT CỦA GỐI KÊ LƯNG EMA\u003c/span\u003e\u003c/h2\u003e\n\u003cp\u003e\u003cspan style=\"color: #ff6600;\"\u003e\u003cspan style=\"color: #000000;\"\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/57/8f/93/57e55e71bbb193926182c3ff034173e9.jpg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/57/8f/93/57e55e71bbb193926182c3ff034173e9.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli style=\"font-size: 20px;\"\u003e\u003cstrong\u003eThiết kế chuyên biệt theo công thái học cho cột sống thắt lưng, phù hợp cả tư thế nằm ngửa hoặc nằm nghiêng\u003c/strong\u003e\u003c/li\u003e\n\u003cli style=\"font-size: 20px;\"\u003e\u003cstrong\u003eChất liệu cao cấp với ruột gối cao su non, vỏ gối 4D siêu thoáng\u003c/strong\u003e\u003c/li\u003e\n\u003cli style=\"font-size: 20px;\"\u003e\u003cstrong\u003eĐa dụng khi sử dụng được để nằm, kê đầu, tựa lư\u003c/strong\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color: #000000;\"\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/0d/8b/aa/eaf0847b1ba6d8c6e9aa04d730f9a07f.jpg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/0d/8b/aa/eaf0847b1ba6d8c6e9aa04d730f9a07f.jpg\" alt=\"\" width=\"750\" height=\"772\" /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003ch2 style=\"text-align: center;\"\u003e\u003cspan style=\"color: #ff6600;\"\u003eGỐI KÊ LƯNG EMA GIẢM ĐAU MỎI THẮT LƯNG NHƯ THẾ NÀO?\u003c/span\u003e\u003c/h2\u003e\n\u003cp style=\"font-size: 20px;\"\u003eĐường cong sinh lý của cột sống là đường cong cột sống ở người bình thường. Ở người bình thường thì khi nhìn cột sống từ bên thì cột sống uốn cong theo đường cong cơ thể, hơi cong về phía trước ở phần cột sống thắt lưng. Chính điều này làm cho khi ngủ (đặc biệt khi nằm nghiêng) sẽ tạo ra khe hở, cột sống thắt lưng ở trạng thái treo cong. Đối với những người thường xuyên mang vác vật nặng, làm việc cúi người hoặc người thoát vị đĩa đệm tư thế này sẽ gây đau, mỏi vùng thắt lưng\u003c/p\u003e\n\u003cp style=\"font-size: 20px;\"\u003e\u003cspan style=\"color: #ff6600;\"\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/1f/e4/3d/ef9a0e046b3182af1c5fb503240a9d2a.jpg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/1f/e4/3d/ef9a0e046b3182af1c5fb503240a9d2a.jpg\" alt=\"\" width=\"750\" height=\"1005\" /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"font-size: 20px;\"\u003eGối kê lưng Ema với thiết kế theo công thái học cột sống giúp người sử dụng \"lấp đầy\" vùng hẫng này, từ đó giải phóng áp lực lên cột sống thắt lưng, giúp cột sống luôn theo đường cong sinh lý của cơ thể (trạng thái tự nhiên nhất)\u003c/p\u003e\n\u003cp style=\"font-size: 20px;\"\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/86/a5/fa/9d07384380a44baaed803f76d699d72b.jpg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/86/a5/fa/9d07384380a44baaed803f76d699d72b.jpg\" alt=\"\" width=\"750\" height=\"839\" /\u003e\u003c/p\u003e\n\u003cp style=\"font-size: 20px; text-align: center;\"\u003e\u003cem\u003e3 điểm đánh dấu trên ảnh vừa khít vào phần cột sống thắt lưng \u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"font-size: 20px;\"\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/5f/7b/8a/fdb3a2a6c94087864c2d965098f114a3.jpg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/5f/7b/8a/fdb3a2a6c94087864c2d965098f114a3.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"font-size: 20px;\"\u003eThiết kế của gối đặc biệt với 3 điểm tiếp xúc A,B \u0026amp; C:\u003c/p\u003e\n\u003cul\u003e\n\u003cli style=\"font-size: 20px;\"\u003eA \u0026amp; C - nâng đỡ eo khi nằm nghiêng\u003c/li\u003e\n\u003cli style=\"font-size: 20px;\"\u003eB - nâng đỡ cột sống jhi nằm thẳng\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"font-size: 20px;\"\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/c2/7f/97/614585e62afc55c20f2e59f2a971e174.jpg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/c2/7f/97/614585e62afc55c20f2e59f2a971e174.jpg\" alt=\"\" width=\"750\" height=\"1253\" /\u003e\u003c/p\u003e\n\u003cp style=\"font-size: 20px; text-align: center;\"\u003e\u003cem\u003eTừ đó giúp cho người sử dụng thoải mái dù nằm thẳng hay nằm nghiêng\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"font-size: 20px;\"\u003e \u003c/p\u003e\n\u003cp style=\"font-size: 20px;\"\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch2 style=\"text-align: center;\"\u003e\u003cspan style=\"color: #ff6600;\"\u003eTHÔNG SỐ SẢN PHẨM\u003c/span\u003e\u003c/h2\u003e\n\u003cp style=\"font-size: 20px;\"\u003e\u003cstrong\u003eKích thước:\u003c/strong\u003e Dài 46cm rộng 23cm cao 11cm. Kích thước này đảm bảo người sử dụng có thể đặt cả phần eo - thắt lưng trên gối dù nằm ngửa hay nằm nghiêng\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/59/c2/f5/4505fd241ccc35cd16c0314b2c1ca7fd.jpg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/59/c2/f5/4505fd241ccc35cd16c0314b2c1ca7fd.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"font-size: 20px;\"\u003e\u003cstrong\u003eTrọng lượng: \u003c/strong\u003e500g\u003c/p\u003e\n\u003cp style=\"font-size: 20px;\"\u003e\u003cstrong\u003eRuột gối:\u003c/strong\u003e Được làm từ 100% cao su non với đặc tính đàn hồi chậm, giúp lấp đầy một cách êm ái vùng thắt lưng khi bạn nằm lên, từ đó giảm áp lực và giảm đau lên khu vực này. \u003c/p\u003e\n\u003cp style=\"font-size: 20px;\"\u003eMemory Foam (cao su non) với đặc tính chậm đàn hồi là vật liệu do trung tâm vũ trụ NASA phát minh vào năm 1966 nhằm nâng cao sự an toàn cho các phần nệm của thiết bị bay nhằm giảm thiểu tối đa áp lực tác động lên các phi hành gia và rung chấn trong quá trình phóng tàu vũ trụ. Ngày này chất liệu này được sử dụng rất nhiều trong ngành công nghiệp gối - đệm\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/2a/97/7b/773342b8206dcdac209206d40755803e.jpg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/2a/97/7b/773342b8206dcdac209206d40755803e.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"font-size: 20px;\"\u003e\u003cstrong\u003eVỏ gối:\u003c/strong\u003e Vỏ gối được may từ chất liệu vài lưới 4D siêu thoáng mát, bề mặt có các lỗ hút khí, thấm hút mồ hôi giúp người sử dụng nằm cả đêm trên gối mà không gây cảm giác nóng, dính lưng.\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/88/1e/53/50c264af3651602db2dcf7abd883e225.jpg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/88/1e/53/50c264af3651602db2dcf7abd883e225.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"font-size: 20px;\"\u003eVỏ gối có khóa kéo được may ẩn vừa tiện lợi vệ sinh dễ dàng vừa không ảnh hưởng đến thẩm mỹ của gối\u003c/p\u003e\n\u003cp style=\"font-size: 20px;\"\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/88/82/bc/397acc8b63dacc9d2e7bf30bfc23403d.jpg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/88/82/bc/397acc8b63dacc9d2e7bf30bfc23403d.jpg\" alt=\"\" width=\"750\" height=\"487\" /\u003e\u003c/p\u003e\n\u003cp style=\"font-size: 20px;\"\u003e\u003cstrong\u003eMàu sắc:\u003c/strong\u003e gối có 2 màu trung tính phù hợp với cả nam, nữ tất cả các độ tuổi\u003c/p\u003e\n\u003cp style=\"font-size: 20px;\"\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/55/3b/60/4175e7c7b4027897f47452e14bd7e05d.jpg\" style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"\" src=\"https://s