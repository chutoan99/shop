nd_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":5000,"discount_rate":5,"rating_average":4.6,"review_count":7,"review_text":"(7)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/3c/67/7c/b5c109a2d0a9b4e446b2303201d599a5.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1143,"all_time_quantity_sold":34,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: center;\"\u003e\u003cstrong\u003eSữa rửa mặt Reihaku Hatomugi tạo bọt 160ml Nhật Bản\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" alt=\"Sữa Rửa Mặt Dưỡng Ẩm HATOMUGI Facial Whip Chiết Xuất Ý Dĩ Nhật Bản - 160ml  - Sạch nhờn, ngừa mụn | MyPhamTONA\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch2\u003eMô tả\u003c/h2\u003e\n\u003cdiv class=\"user-content\"\u003e\n\u003cp\u003eSửa rửa mặt chiết xuất ý dĩ Hatomugi vì là thành phần quen thuộc nên đã chiếm được lòng tin của chị em nhờ vào khả năng: Dưỡng ẩm da từ bên trong đem đến cho bạn làn da mềm mịn, tươi trẻ.\u003c/p\u003e\n\u003cp\u003eHạt Coix (ý dĩ) hay còn gọi là bo bo được biết đến như một loại dược liệu quý trong việc, giải độc cơ thể, bồi bổ cho sức khỏe và tăng hương vị cho nhiều món ăn, thức uống. Đặc biệt hơn, ý dĩ chứa protein, khoáng chất và 8 loại acid amin giúp da ngăn ngừa và làm lành các vết thương hiệu quả nên là nguyên liệu thích hợp cho nhiều công thức dưỡng da hiệu quả. Hãng Hatomugi đã đem vào thử nghiệm và cho ra đời dòng sửa rửa mặt chiết xuất hạt ý dĩ với khả năng làm sạch, sáng da vượt trội được các chị em ưa chuộng.\u003c/p\u003e\n\u003cp\u003eSửa rửa mặt chiết xuất ý dĩ Hatomugi giúp cho độ tuổi teen chống lại các loại mụn dậy thì khỏi sạm thâm. Ngoài ra, các bạn nên biết rằng từ tuổi 25 trở đi, mỗi năm chúng ta mất đi từ 1 – 1,5% collagen, nguyên nhân khiến da chúng ta bị chùng nhão, nhăn. Do đó, cần trang bị loại sữa rửa mặt này vì hạt ý dĩ cũng lặp chiến công không nhỏ trong nhiệm vụ chống lão hóa và làm săn chắc da cực tốt.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cu\u003eCông dụng của sữa rửa mặt ý dĩ Hatomugi Naturie:\u003c/u\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eKhoáng chất trong sữa thẩm thấu sâu dưới lớp hạ bì dưỡng ẩm cho da hiệu quả.\u003c/p\u003e\n\u003cp\u003eVitamin B trong hạt ý dĩ Khống chế lượng dầu, chống viêm da, phòng chống cháy nắng, cải thiện làn da khô.\u003c/p\u003e\n\u003cp\u003eChống lão hóa da, ngăn ngừa vết nhăn, chống chảy xệ.\u003c/p\u003e\n\u003cp\u003eHỗ trợ ngăn ngừa mụn, kháng viêm.\u003c/p\u003e\n\u003cp\u003eSe khít lỗ chân lông, hạn chế bã nhờn.\u003c/p\u003e\n\u003cp\u003eLàm trắng sáng da, mờ thâm.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cu\u003eThành phần có trong Hatomugi:\u003c/u\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eHạt ý dĩ là nguyên liệu chính trong sữa rửa mặt Nhật Bản và sự hỗ trợ của các thành phần thiên nhiên khác như: lúa mạch, đào, vitamin…\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cu\u003eHướng dẫn sử dụng sửa rửa mặt trắng da ý dĩ:\u003c/u\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eRửa mặt 2 lần vào buổi sáng và tối.\u003c/p\u003e\n\u003cp\u003eLấy một lượng kem vừa đủ tạo bọt và thoa lên cùng da đã làm ướt.\u003c/p\u003e\n\u003cp\u003eMassge nhẹ nhàng theo chuyển động vòng tròn.\u003c/p\u003e\n\u003cp\u003eRửa lại mặt bằng nước sạch.\u003c/p\u003e\n\u003cp\u003e- Loại bỏ chất bẩn hiệu quả trả lại làn da tươi sáng cho bạn.\u003c/p\u003e\n\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/3c/67/7c/b5c109a2d0a9b4e446b2303201d599a5.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/3c/67/7c/b5c109a2d0a9b4e446b2303201d599a5.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/3c/67/7c/b5c109a2d0a9b4e446b2303201d599a5.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3c/67/7c/b5c109a2d0a9b4e446b2303201d599a5.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3c/67/7c/b5c109a2d0a9b4e446b2303201d599a5.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/26/07/66/993065d61d714af694a947bd3c39ca27.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/26/07/66/993065d61d714af694a947bd3c39ca27.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/26/07/66/993065d61d714af694a947bd3c39ca27.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/26/07/66/993065d61d714af694a947bd3c39ca27.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/26/07/66/993065d61d714af694a947bd3c39ca27.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/48/d2/84/82636391f8caffa9f54deb1870a4be1b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/48/d2/84/82636391f8caffa9f54deb1870a4be1b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/48/d2/84/82636391f8caffa9f54deb1870a4be1b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/48/d2/84/82636391f8caffa9f54deb1870a4be1b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/48/d2/84/82636391