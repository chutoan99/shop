6.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":20,"review_text":"(20)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/c3/d1/de/2106d270053c86522e0bf61f37c1e010.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1222,"all_time_quantity_sold":101,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cbr /\u003e \u003c/p\u003e\n\u003cp\u003eTrà Hoàng Thảo Mộc có \u003cstrong\u003ethành phần\u003c/strong\u003e gồm: Trà dây, Cỏ ngọt, Hoa nhài, Kim ngân hoa,   Lạc tiên, sơn mật\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/41/0e/60/29c7a48b0e24fbaf57095e9fac1532c8.jpg\" alt=\"1USJ6Z_simg_b5996f_500x445_max.jpg\" width=\"750\" height=\"675\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCông dụng:\u003c/strong\u003e Hiện tại có nhiều thực phẩm bảo vệ sức khỏe có mặt trên thị trường, tuy nhiên xu hướng lựa chọn những sản phẩm hoàn toàn từ nguyên liệu thiên nhiên như \u003cstrong\u003e\u003cem\u003etrà thảo mộc bảo vệ sức khỏe\u003c/em\u003e \u003c/strong\u003eđang là lựa chọn số 1 được đông đảo người tiêu dùng áp dụng.\u003c/p\u003e\n\u003cp\u003e       Tốt cho người bị mất ngủ, giúp ngủ ngon và sâu giấc.\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eHỗ trợ cho người  tiểu đường\u003c/li\u003e\n\u003cli\u003eỔn định đường huyết , huyết áp cao\u003c/li\u003e\n\u003cli\u003eTốt cho người bị dạ dày \u003cbr /\u003eHạ men gan, mỡ máu\u003c/li\u003e\n\u003cli\u003ePhòng ngừa bệnh ung thư\u003c/li\u003e\n\u003cli\u003eGiảm viêm dạ dày, đại tràng, tá tràng\u003c/li\u003e\n\u003cli\u003engăn ngừa béo phì\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eTrà vị ngọt thơm có thể ướp lạnh hay pha cùng đá. Các quán trà, cà phê có thể sử dụng bán cho khách mà không cần phải pha chế thêm đường hay bất kỳ hương liệu khác.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/product/24/d5/ab/0cb4c955c84f6413627f7ac38c5fcb29.jpg\" alt=\"fNdAHR_simg_be5e64_500x500_max.jpg\" width=\"500\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp\u003eVị trà khá độc đáo là vị ngọt thanh từ cỏ ngọt và hương thơm nhẹ từ hoa nhài hoàn toàn tạo nên từ hương vị thiên nhiên.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eHướng dẫn sử dụng\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eĐể có một tách trà ngon tưởng chừng như rất đơn giản nhưng nếu chúng ta làm sai cách sẽ không giữ được hương vị tự nhiên nhất của trà.\u003c/p\u003e\n\u003cp\u003eVới \u003cem\u003e\u003cstrong\u003etrà thảo mộc bảo vệ sức khỏe \u003c/strong\u003e\u003c/em\u003ecó cách pha và sử dụng không cầu kỳ mà rất đơn giản.\u003c/p\u003e\n\u003cp\u003eBạn có thể dùng 10 -15 gram pha cho 1 - 1.5 lít nước, nhiệt độ nhiệt thích hợp nhất là 80 - 90 độ để nước ngấm vào trà trong vòng 5 - 10 phút là có thể thưởng thức.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/c3/d1