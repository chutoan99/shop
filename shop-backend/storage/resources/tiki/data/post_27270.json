abc1e985991d6d249132e16.png\" alt=\"\" width=\"750\" height=\"1193\" /\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/de/c2/0b/bea1096af0f6d7b22874f53e67b10a25.png\" alt=\"\" width=\"750\" height=\"1194\" /\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/b7/4a/b6/f3306c22dd08749032b6f86706265f66.png\" alt=\"\" width=\"750\" height=\"1193\" /\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/6d/1f/0a/cd9e43b9fe4aa9b90d42ee395af52841.png\" alt=\"\" width=\"750\" height=\"1194\" /\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/01/f5/6e/d77d01d268439979bc7e5582f95ba938.png\" alt=\"\" width=\"750\" height=\"1194\" /\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/ac/7a/44/167e30ae01023b6f2476d540de54b512.png\" alt=\"\" width=\"750\" height=\"1193\" /\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/5a/04/43/243c6f7264595def12af2463a0de75e8.png\" alt=\"\" width=\"750\" height=\"1194\" /\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/72/10/96/f434f6d2b1ca4625d71e2fd201b59ab6.png\" alt=\"\" width=\"750\" height=\"74\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThông tin sản phẩm :\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eKích thước mở ra: 27x193x65cm\u003c/li\u003e\n\u003cli\u003eKích thước gập gọn: 110x21x65cm\u003c/li\u003e\n\u003cli\u003eGiường gập đôi\u003c/li\u003e\n\u003cli\u003eChân đỡ có 2 thanh ngang và 4 chân trụ bánh xe đỡ phần giữa giường(khu vực chịu tải trọng lớn nhất)\u003c/li\u003e\n\u003cli\u003eKhi gập gọn 4 chân đỡ bánh xe giúp di chuyển giường thuận tiện hơn\u003c/li\u003e\n\u003cli\u003eGiường có thể tùy chỉnh được độ ngả theo ý muốn\u003c/li\u003e\n\u003cli\u003eGiường có 4 lớp chính\u003c/li\u003e\n\u003cli\u003eKhung kim loại hợp kim chịu lực được phủ sơn tĩnh điện bảo vệ\u003c/li\u003e\n\u003cli\u003eSản phẩm có 2 màu sắc lựa chọn: Xanh và Xám\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eĐặc điểm nổi bật :\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\n\u003cp\u003eKhung giường được thiết kế từ vật liệu sắt sơn tỉnh điện cho màu sơn bền, đẹp.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eNệm được chế tạo từ chất liệu nệm bọt biển với mật độ cao êm ái chống lún\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eGường có 4 lớp chính: lớp ga,lớp đệm,lớp phản gỗ,lớp khung chịu tải\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eGiường gấp có phần đầu nâng được 5 cấp khác nhau từ 0 độ đến 90 độ.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eGiường xếp di động nâng đầu có phần khung làm bằng thép sơn tĩnh điện, nối với nhau bằng bản lề nên có thể gấp gọn\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eĐệm giường được làm từ bọt biển có mật độ cao giúp tăng độ đàn hồi và hấp thu lực tốt\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eGiường gấp hai khúc đặc biệt còn có thể để dáng ngồi tựa như ghế sofa.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eChân giường gấp cấu tạo gồm 4 bánh xe giúp di chuyển dễ dàng.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eĐồng thời có cấu tạo chốt an toàn định vị. Đầu giường có thể nâng lên hạ xuống rất tiện dụng trong lúc đọc sách, thư giãn hoặc bệnh nhân trong điều trị được bác sĩ chỉ định nằm cao đầu\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối 