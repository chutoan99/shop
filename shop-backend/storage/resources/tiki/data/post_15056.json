h bảo quản sản phẩm: Sau khi sử dụng lau lại bằng cồn rồi bỏ vào bao bì để bảo quản. Để nơi khô ráo và tránh xa tầm tay trẻ em.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/49/87/a9/3aeff69e7de410f14d6039e6a03c40eb.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/49/87/a9/3aeff69e7de410f14d6039e6a03c40eb.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/49/87/a9/3aeff69e7de410f14d6039e6a03c40eb.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/49/87/a9/3aeff69e7de410f14d6039e6a03c40eb.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/49/87/a9/3aeff69e7de410f14d6039e6a03c40eb.png"},{"base_url":"https://salt.tikicdn.com/ts/product/2a/a0/11/e4df708c2263c02c4316b79d3b561fbb.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/2a/a0/11/e4df708c2263c02c4316b79d3b561fbb.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/2a/a0/11/e4df708c2263c02c4316b79d3b561fbb.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2a/a0/11/e4df708c2263c02c4316b79d3b561fbb.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2a/a0/11/e4df708c2263c02c4316b79d3b561fbb.png"},{"base_url":"https://salt.tikicdn.com/ts/product/35/15/ea/40a013b3a39a1140e77f7b58ecf1c099.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/35/15/ea/40a013b3a39a1140e77f7b58ecf1c099.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/35/15/ea/40a013b3a39a1140e77f7b58ecf1c099.png","position":nul