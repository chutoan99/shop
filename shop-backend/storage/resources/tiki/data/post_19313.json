":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":true,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.8,"review_count":621,"review_text":"(621)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/bb/9a/d6/e821d119e7a9fb8c6a662d2f08912e30.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1370,"all_time_quantity_sold":1708,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003e\u003cstrong\u003eNhỏ gọn, tiện lợi và nhiều màu sắc\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003e\u003cstrong\u003eLoa Bluetooth JBL Go 3\u003c/strong\u003e là chiếc loa bluetooth mini có kích thước nhỏ nhắn. Người dùng có thể mang loa đi bất cứ đâu rất dễ dàng. Hơn nữa chiếc loa này còn được trang bị 1 quai xách rất chắc chắn và thời trang. Bạn có thể xỏ vào ngón tay hoặc móc vào balo để mang theo một cách tiện lợi.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/19/c0/70/b348f29861480faa9b1d160433576d76.jpg\" alt=\"\" width=\"750\" height=\"474\" /\u003e\u003c/p\u003e\n\u003cp\u003eJBL GO 3 có đến 8 màu sắc khác nhau để bạn lựa chọn theo sở thích và phong cách. Gồm có: Đen, Đỏ, Hồng Trắng, Xanh lục, Xanh lam và Rằn ri. Có thể thấy chiếc loa này vừa là phương tiện giải trí, vừa có thể làm phụ kiện trang trí cá tính.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/86/21/8d/de971d665057a35272b294d14c369ac9.jpg\" alt=\"\" width=\"750\" height=\"458\" /\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eÂm thanh JBL GO 3 vượt trội so với kích thước\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eCó thể nói trong năm nay, chiếc JBL GO 3 chính là sự đột phá trong dòng sản phẩm loa bluetooth mini. Tuy rất nhỏ gọn nhưng lại có chất lượng âm thanh không hề thua kém so với những mẫu loa có kích thước lớn hơn. Độ rộng âm sắc cùng với dải âm rộng giúp đáp ứng tốt nhiều thể loại nhạc khác nhau. Công suất cũng được cải thiện để cho người dùng thưởng thức với mức âm lượng lớn hơn.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/4f/65/01/383a56d2f1e78d9a43679abd75cd9574.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eChống nước chống bụi IP76 cao cấp\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eLà sản phẩm thường xuyên phải cầm nắm trên tay nên rất dễ bám mồ hôi, bụi bẩn. Hiểu được điều này, hãng JBL đã trang bị khả năng chống nước và chống bụi IP67 cao cấp cho chiếc loa này. Giúp loa hoạt động bền bỉ và lâu dài hơn. JBL GO 3 còn sở hữu viên pin dung lượng tương đối lớn. Cho thời lượng hoạt động 5 giờ đồng hồ liên tục khi mở ở mức âm lượng lớn nhất. Kết hợp cùng chân sạc USB Type-C, cho tốc độ sạc pin với tốc độ cao hơn so với cổng sạc Micro USB trước đây.\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eBluetooth 5.1 hiện đại nhất\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eNăm 2020 công nghệ Bluetooth 5.1 hiện là công nghệ truyền tải tốt nhất hiện tại trên thiết bị điện tử và cũng có sẵn trên loa Bluetooth JBL GO 3. Với công nghệ này mọi dữ liệu âm thanh đều được truyền tải xuyên suốt đến loa và tăng khả năng kết nối ghép đôi với các thiết bị một cách nhanh nhất khi sử dụng hằng ngày.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/bb/9a/d6/e821d119e7a9fb8c6a662d2f08912e30.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/bb/9a/d6/e821d119e7a9fb8c6a662d2f08912e30.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/bb/9a/d6/e821d119e7a9fb8c6a662d2f08912e30.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/bb/9a/d6/e821d119e7a9fb8c6a662d2f08912e30.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/bb/9a/d6/e821d119e7a9fb8c6a662d2f08912e30.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/4f/65/01/018c2428732e7083e9e17c700836a154.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/4f/65/01/018c2428732e7083e9e17c700836a154.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/4f/65/01/018c2428732e7083e9e17c700836a154.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4f/65/01/018c2428732e7083e9e17c700836a154.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4f/65/01/018c2428732e7083e9e17c700836a154.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/c0/c9/93/5e6a58d7406e0663550bfaa2d185c9a8.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c0