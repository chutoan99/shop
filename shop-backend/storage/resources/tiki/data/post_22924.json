:89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/0a/c6/2d/c4007a19b04fffd671c506fa47ac9d94.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":83,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eMŨ BẢO HIỂM XE MÁY 1/2 ROYAL M239 KÍNH ÂM\u003c/p\u003e\n\u003cp\u003eThông số kỹ thuật mũ bảo hiểm Royal M239:\u003c/p\u003e\n\u003cp\u003e- Thương hiệu: Royal Helmet\u003c/p\u003e\n\u003cp\u003e- Model: M239\u003c/p\u003e\n\u003cp\u003e- Trọng lượng: 715gr +-50gr\u003c/p\u003e\n\u003cp\u003e- Size mũ M239: M - L - XL - XXL\u003c/p\u003e\n\u003cp\u003e- Màu sắc mũ Royal M239: 7 màu như phân loại\u003c/p\u003e\n\u003cp\u003e- Kính: có thể giấu âm bên trong nón, che hết mặt, màu kính là trong suốt hoặc khói trà có thể đi được cả ngày và đêm\u003c/p\u003e\n\u003cp\u003e- Lót mũ M239: Lớp lót tháo rời dễ dàng để tiện vệ sinh giặt.\u003c/p\u003e\n\u003cp\u003e- Đối tượng sử dụng: Mũ Royal M239 phù hợp cho cả nam và nữ đi xe máy.\u003c/p\u003e\n\u003cp\u003e- Bảo hành trọn đời các lỗi kỹ thuật khi mua hàng tại HALO PHƯỢT\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/9c/2d/dc/b2683a9e38ae31bd224ca11b0a3466aa.jpg\" alt=\"\" width=\"700\" height=\"406\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eNón nửa đầu Royal M239\u003c/strong\u003e là mẫu nón mà Tập đoàn Á Châu vừa cho ra mắt vào đầu tháng 07 năm 2024. Được nghiên cứu và trau chuốt rất lâu để có thể trình làng được sản phẩm vừa tiện lợi, vừa thời trang như mẫu \u003cstrong\u003eRoyal M139\u003c/strong\u003e đã quá nổi tiếng\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://halophuot.com/static/plugin/ckeditor/plugins/kcfinder/uploads/images/N%C3%93N%20B%E1%BA%A2O%20HI%E1%BB%82M/M239/M239-den-nham-700-1.jpg\" alt=\"\" /\u003e\u003c/p\u003e\n\u003cp\u003eĐiểm đặc biệt nhất của mẫu nón này chính là phần \u003cstrong\u003ekính âm \u003c/strong\u003eche hết mặt được thiết kế giấu âm bên trong nón. Ưu điểm của những mẫu nón kính âm chính là phần kính được bảo vệ khi không dùng được giấu đi nên sẽ hạn chế trầy xước, tăng tuổi thọ kính; khi đi mưa không sợ nước mưa rớt xuống mặt và giúp nón gọn gàng hơn khi không dùng kính\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://halophuot.com/static/plugin/ckeditor/plugins/kcfinder/uploads/images/N%C3%93N%20B%E1%BA%A2O%20HI%E1%BB%82M/M239/M239-700X700-1.jpg\" alt=\"\" /\u003e\u003c/p\u003e\n\u003cp\u003eCũng như các mẫu nón khác, dòng \u003cstrong\u003eM239\u003c/strong\u003e vẫn được làm phần vỏ nón từ nhựa ABS nguyên sinh bền chắc, xốp chịu lực làm từ EPS được ép chắc chắn. \u003c/p\u003e\n\u003cp\u003eNón có thiế kế 2 lỗ thông gió phía trước đỉnh đầu giúp đón gió vô lòng nón, hạn chế hầm hơi khi đội.\u003c/p\u003e\n\u003cp\u003eKhóa lẫy Micro rất chắc chắc và dễ thao tác.\u003c/p\u003e\n\u003cp\u003eBảng mặc cực kì đa dạng với phổ size rộng từ M L XL XXL cho vòng đầu 53 đến tận 62cm phù hợp với đại đa số vòng đầu của cả nam và nữ.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://halophuot.com/static/plugin/ckeditor/plugins/kcfinder/uploads/images/N%C3%93N%20B%E1%BA%A2O%20HI%E1%BB%82M/M239/M239-size-700-1.jpg\" alt=\"\" /\u003e\u003c/p\u003e\n\u003cp\u003eLót lòng nón có thể tháo rời để vệ sinh riêng tiện lợi mà không cần vệ sinh trực tiếp vào nón\u003c/p\u003e\n\u003cp\u003eMỗi nón tặng kèm ngay 1 túi rút đựng nón tiện lợi và 1 khóa chống trộm để luôn giữ nón an toàn\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://halophuot.com/static/plugin/ckeditor/plugins/kcfinder/uploads/images/N%C3%93N%20B%E1%BA%A2O%20HI%E1%BB%82M/M239/M239-700-1.jpg\" alt=\"\" /\u003e\u003c/p\u003e\n\u003cp\u003eNón được bảo hành trọn đời các lỗi kỹ thuật như chốt khóa, chốt kính... khi mua hàng tại Halo Phượt\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/0a/c6/2d/c4007a19b04fffd671c506fa47ac9d94.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0a/c6/2d/c4007a19b04fffd671c506fa47ac9d94.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/0a/c6/2d/c4007a19b04fffd671c506fa47ac9d94.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0a/c6/2d/c4007a19b04fffd671c506fa47ac9d94.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0a/c6/2d/c4007a19b04fffd671c506fa47ac9d94.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/52/ea/0c/8427401886185cb4fd1cf894d32cd366.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/52/ea/0c/8427401886185cb4fd1cf894d32cd366.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/52/ea/0c/8427401886185cb4fd1cf894d32cd366.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/52/ea/0c/8427401886185cb4fd1cf894d32cd366.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/52/ea/0c/8427401886185cb4fd1cf894d32cd366.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/fc/5c/41/89eb51badb6e74985a889942bc8a56e1.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w