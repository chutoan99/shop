"icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":55000,"discount_rate":37,"rating_average":5,"review_count":3,"review_text":"(3)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/df/b5/0c/97740db7172967637f62ae8082bdd2a2.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":138,"all_time_quantity_sold":11,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eTai Nghe \u003cspan style=\"color:#ff0000;\"\u003eRIBI KT-02\u003c/span\u003e: Trải Nghiệm Âm Thanh Chất Lượng và Phong Cách Đẳng Cấp\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color:#ff0000;\"\u003e\u003cstrong\u003e1. Công Nghệ Âm Thanh Tiên Tiến:\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eLoa động cơ lớn tái tạo âm thanh chân thực và sống động, với dải tần rộng từ bass sâu đến treble sắc nét.\u003c/li\u003e\n\u003cli\u003eCông nghệ giảm tiếng ồn xung quanh, mang lại trải nghiệm nghe nhạc tập trung và thư giãn.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/e4/46/07/995eb2ef4442139cdffc17d36c60607d.jpg\" alt=\"\" width=\"718\" height=\"1003\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color:#ff0000;\"\u003e\u003cstrong\u003e2. Thiết Kế Ergonomic và Chất Lượng:\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eThiết kế nhét tai êm ái và ôm sát, giúp cách âm hiệu quả và mang lại cảm giác thoải mái suốt thời gian sử dụng.\u003c/li\u003e\n\u003cli\u003eTai nghe được đeo vòng qua tai và có phân biệt trái phải trên từng tai nghe\u003c/li\u003e\n\u003cli\u003eChất liệu cao cấp và độ bền vững, đảm bảo sự chắc chắn và đáng tin cậy trong mọi hoàn cảnh.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/01/b1/c2/a3680edc0165fff463de022fb47e4a73.jpg\" alt=\"\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color:#ff0000;\"\u003e\u003cstrong\u003e3. Kết Nối Đa Năng:\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eJack cắm tiêu chuẩn 3.5mm và còn thêm lựa chọn cổng TypeC - phù hợp với hầu hết các thiết bị phát nhạc, từ điện thoại di động, máy tính bảng đến laptop và máy nghe nhạc.\u003c/li\u003e\n\u003cli\u003eDây cáp chất lượng cao đảm bảo truyền tải âm thanh mạnh mẽ và không bị nhiễu.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/5d/a0/a3/cf6143f637299f22caff2c049b9051de.jpg\" alt=\"\" width=\"710\" height=\"986\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color:#ff0000;\"\u003e\u003cstrong\u003e4. Microphone Chất Lượng Cao:\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eTai nghe KT-02 được trang bị micro tích hợp, cho phép bạn thực hiện cuộc gọi điện thoại hoặc tham gia các cuộc hội thoại trực tuyến một cách dễ dàng và tiện lợi.\u003c/li\u003e\n\u003cli\u003eMicrophone chất lượng cao giúp truyền tải giọng nói rõ ràng và sống động, đảm bảo bạn có thể giao tiếp một cách hiệu quả ngay cả trong môi trường ồn ào.\u003c/li\u003e\n\u003cli\u003eMicrophone của KT-02 được tích hợp công nghệ hủy tiếng ồn, giúp loại bỏ tiếng ồn xung quanh và tập trung vào giọng nói của bạn, làm cho cuộc gọi trở nên rõ ràng hơn.\u003c/li\u003e\n\u003cli\u003eKhả năng sử dụng micro trong cả trò chơi trực tuyến, hội thoại video, hoặc cuộc gọi điện thoại di động giúp KT-02 trở thành một sản phẩm đa năng và linh hoạt.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/d2/ac/27/8db69f1599a4ec336bac590d1f63ddf9.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/4a/69/18/646c05741ed90906a3a7bd83435cadf0.jpg\" alt=\"\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color:#ff0000;\"\u003e\u003cstrong\u003e5. Phong Cách và Thời Trang:\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eThiết kế hiện đại, sang trọng và tinh tế, phản ánh phong cách và cá tính của người sử dụng.\u003c/li\u003e\n\u003cli\u003eCác tùy chọn màu sắc đa dạng, từ tông màu tối đến tông màu sáng, giúp phù hợp với mọi phong cách và sở thích cá nhân.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eTai Nghe KT-02 không chỉ là một sản phẩm âm nhạc mà còn là biểu tượng của sự phong cách và công nghệ tiên tiến. Với sự kết hợp hoàn hảo giữa chất lượng âm thanh, thiết kế tiện lợi và phong cách đẳng cấp, nó là sự lựa chọn hoàn hảo cho mọi người yêu thích âm nhạc.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/f3/5b/13/13ded351732a91b0a9f1e91daceca674.jpg\" alt=\"\" width=\"712\" height=\"1003\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/produc