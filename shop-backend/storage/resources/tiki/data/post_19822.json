unt":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/media/catalog/product/l/e/leng-keng-tien-oi-hien-ra.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2754,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"color: #ff6600; font-size: medium;\"\u003e\u003cstrong\u003eBi Kíp Rèn Luyện Kỹ Năng Mềm - Leng Keng, Tiền Ơi Hiện Ra!\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003e\" Tiết kiệm - sức mạnh nuôi dưỡng thói quen chi tiêu đúng cách\".\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eYoung Uh chưa bao giờ tích cóp nổi một đồng.\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eSố tiền tiêu vặt mẹ cho hàng tuần luôn hết veo.\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eBởi cậu nghĩ rằng: \"Tuần nào chả nhận được tiền tiêu vặt, để giành làm gì chứ?\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eMột ngày, cậu bất ngờ nhận được lời mời dự sinh nhật Yu Na, cô bạn cậu thầm ngưỡng mộ.\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eKhông có tiền tiết kiệm, Young Uh chẳng biết lấy đâu ra quà.\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eCậu đã ăn trộm chiến ví hình đầu mèo của chị gái và phải \"trả một giá rất đắt\"!\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eLiền đó, phải thực hiện chương trình \"tiết kiệm toàn diện\" do mẹ khởi xướng, cậu cảm thấy vô cùng khổ sở\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eMay mắn thay, nhờ đó cậu nhận ra có nhiều bạn nhỏ đã biết tiết kiệm từ tấm bé.\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eKhông chỉ tiết kiệm tiền - nhờ chi tiêu hợp lý - kiếm tiền từ những việc nhỏ, mà còn tiết kiệm năng lượng.\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eVà việc tiết kiệm, không chỉ cho mình mà còn có thể giúp đỡ người khác, góp phần bảo vệ trái đất.\u003c/p\u003e\r\n\u003cp style=\"text-align: justify;\"\u003eYoung Uh đã trở thành một cậu bé sống có trách nhiệm và biết sẻ chia như thế đó.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/media/catalog/product/l/e/leng-keng-tien-oi-hien-ra.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/l/e/leng-keng-tien-oi-hien-ra.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/l/e/leng-keng-tien-oi-hien-ra.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/l/e/leng-keng-tien-oi-hien-ra.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/l/e/leng-keng-tien-oi-hien-ra.jpg"}],"warranty_policy":null,"authors":[{"id":26726,"name":"Lee Kyu Hee","slug":"lee-kyu-hee"}],"current_seller":{"id":82087,"sku":"3099954483153","name":"Nhà Sách Lifebooks","link":"https://tiki.vn/cua-hang/nha-sach-lifebooks","logo":"a3/c9/64/eb97a5bb8c46816ff6c09027f1e1bb9a.jpg","price":74000,"product_id":"88942719","store_id":76421,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Thông tin chung","attributes":[{"code":"publisher_vn","name":"Công ty phát hành","value":"Alphabooks"},{"code":