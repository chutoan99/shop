":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":410000,"discount_rate":40,"rating_average":4.8,"review_count":17,"review_text":"(17)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/84/67/a2/5fedcaa596e70f7f044d14e48fd88d2f.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":520,"all_time_quantity_sold":60,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eMáy xay ăn dặm mini Bear GR-B06V1\u003c/strong\u003e dung tích 600 ml kết hợp với công suất 200 W cho hiệu quả xay tốt nhất. Toàn bộ thiết bị được làm từ chất liệu nhựa ABS cao cấp, cối xay thủy tinh, lưỡi xay inox 304 không gỉ an toàn cho bé. \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/83/7d/99/b944d47658302432ff3006d26fa60846.png?v=1628244561740\" width=\"750\" height=\"1119\" alt=\"b944d47658302432ff3006d26fa60846.png?v=1628244561740\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThiết kế nhỏ gọn, đáng yêu\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eKhác hẳn với các dòng máy xay trên thị trường, máy xay ăn dặm 0.6L Bear mang một thiết kế tươi trẻ với hình chiếc nơ phối màu xanh pastel đáng yêu. Đây được đánh giá là một trong những ưu điểm nội bật của thương hiệu Bear, mang lại cảm giác gần gũi và tăng cảm hứng khi nấu nướng.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/6e/13/fd/040023ce9b40d6a6aa43f633ae657fb5.png?v=1622447773423\" width=\"750\" height=\"503\" alt=\"040023ce9b40d6a6aa43f633ae657fb5.png?v=1622447773423\" /\u003e\u003c/p\u003e\n\u003cp\u003eMáy xay ăn dặm Bear QSJ-C02K1 (GR-B06V1) có dung tích 0.6L, thích hợp dùng để xay một lượng ít thực phẩm như xay đồ ăn dặm cho bé (thịt, tôm, rau, củ,); xay gia vị (tỏi, ớt,); xay các món sinh tố tráng miệ Với dung tích 0.6L, máy có thể xay từ 50g - 200g thực phẩm, cực thích hợp khi cần xay một lượng nhỏ thức ăn để luôn tươi ngon.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/50/05/e8/ccb9c7e64357dae25c083d67179db81f.png?v=1622447778717\" alt=\"ccb9c7e64357dae25c083d67179db81f.png?v=1622447778717\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eMáy xay 2 chế độ, nâng cao chất lượng xay\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eMáy xay ăn dặm Bear có phương thức hoạt động rất đơn giản, chỉ cần nhấn nút để điều khiển. Với chiếc máy xay ăn dặm 0.6L Bear này có tới 2 mức xay khác nhau:\u003c/p\u003e\n\u003cp\u003e️ \u003cstrong\u003eMức I\u003c/strong\u003e \u003cem\u003e(xay thực phẩm mềm) \u003c/em\u003ethích hợp khi xay rau, trái cây, nước sốt, gia vị\u003c/p\u003e\n\u003cp\u003e️ \u003cstrong\u003eMức II\u003c/strong\u003e \u003cem\u003e(xay thực phẩm cứng) \u003c/em\u003ethích hợp khi xay thịt, củ, quả, Để tăng hiệu quả xay, lưỡi dao được làm bằng inox 304 bền chắc, không gỉ được thiết kế 3 tầng giúp xay cắt mạnh đều và nhuyễn mịn.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/03/fa/91/1035281b70a130ea63a106cb04edc4e1.png?v=1622447775999\" width=\"750\" height=\"503\" alt=\"1035281b70a130ea63a106cb04edc4e1.png?v=1622447775999\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/6a/4c/aa/2346bccfc103130a8bbd97b81e7e80de.png?v=1622447774920\" width=\"750\" height=\"503\" alt=\"2346bccfc103130a8bbd97b81e7e80de.png?v=1622447774920\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/0f/07/14/ac3fc6cfb6678ce9bd268a271fb9ef24.png?v=1622447776542\" width=\"750\" height=\"503\" alt=\"ac3fc6cfb6678ce9bd268a271fb9ef24.png?v=1622447776542\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCối xay thủy tinh an toàn\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eVới chất liệu thủy tinh borosilicate, cối xay có thể chịu nhiệt, chịu lực cực kì an toàn cho bé\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/98/fb/d1/2bf5e2c689fec643f87f25297e7d307f.png?v=1622447770839\" alt=\"2bf5e2c689fec643f87f25297e7d307f.png?v=1622447770839\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eMáy xay êm ái, không ồn\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eKhác với các dòng máy xay thân cao dễ rung lắc, máy xay ăn dặm 0.6L Bear có thân máy thấp hơn, máy cầm chắc chắn và đầm hơn hẳn. Điều này giúp máy xay ổn định, không rung lắc.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/fd/d7/16/e417c54740093ffbecb444f5fd85b75a.png?v=1622447775465\" width=\"750\" height=\"503\" alt=\"e417c54740093ffbecb444f5fd85b75a.png?v=1622447775465\" /\u003e\u003c/p\u003e\n\u003cp\u003eNgoài ra, máy xay Bear luôn được thiết kế thêm tấm đệm silicon dưới đáy cối, giúp giảm tiếng ồn, xay êm ái hơn.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/38/ed/f8/6c7196ea267e8e06dcc356fb15e108a6.png?v=1622447777619\" alt=\"6c7196ea267e8e06dcc356fb15e108a6.png?v=1622447777619\" /\u003e\u003c/p\u003e\n\u003cp\u003eVới chiếc máy xay ăn dặm 0.6L Bear GR-B06V1 (QSJ-C02K1) mẹ có thể dễ dàng chuẩn bị các món ăn dễ dàng dù bé đang trong giai đoạn phát triển nào đi chăng nữa.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/a9/75/cf/d794a2c2bd936e958bb96cb5c41fa0ea.png?v=1622447771579\" alt=\"d794a2c2bd