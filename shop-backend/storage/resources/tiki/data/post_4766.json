ull,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":3000,"discount_rate":2,"rating_average":4.3,"review_count":171,"review_text":"(171)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/77/af/74/4994d8bb6009a72f152d259d6434301a.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1408,"all_time_quantity_sold":643,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align:center;\"\u003e\u003cem\u003e\u003cstrong\u003eBếp Nướng Than Hoa Phiên Bản Cải Tiến Loại Dài 2023 Chống Cháy Thực Phẩm, An Toàn Sức Khỏe\u003c/strong\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003eBếp nướng than hoa KUNBE phiên bản cải tiến, thông minh dễ dàng gấp gọn khi mang đi dã ngoại, cất giữ dễ dàng. Lòng khay có thể nới rộng khá sâu so với những dòng sản phẩm du lịch thông thường, sử dụng được lâu hơn. Bếp loại dài hình chữ nhật khá tiện cho việc sắp xếp phân bổ nhiệt nướng, vỉ nướng inox chịu nhiệt đảm bảo vệ sinh thực phẩm khi chế biến, dễ dàng chùi rửa, vệ sinh sau khi sử dụng.\u003c/p\u003e\n\u003cp\u003eSản phẩm phù hợp sử dụng gia đình, liên hoan, đi dã ngoại, picnic, cắm trại, sự kiện, đáp ứng mọi nhu cầu sử dụng.\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cem\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/82/47/a8/fc10adef3b0bc357319dfb4cec77cb4a.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e1. THÔNG TIN SẢN PHẨM\u003c/p\u003e\n\u003cp\u003e- Kích Thước: 59 x 22 x 29cm.\u003c/p\u003e\n\u003cp\u003e- Chất Liệu: Sắt sơn tĩnh điện + phên nướng inox.\u003c/p\u003e\n\u003cp\u003e- Ưu Điểm Nổi Bật:\u003c/p\u003e\n\u003cp\u003e+ Khung bếp cải tiến với thiết kế dày dặn chắc chắn.\u003c/p\u003e\n\u003cp\u003e+ Phên nướng inox chống dính dễ dàng vệ sinh sau khi sử dụng.\u003c/p\u003e\n\u003cp\u003e+ Bếp dài, khay than sâu phù hợp với gia đình, các nhóm bạn trẻ liên hoan dã ngoại\u003c/p\u003e\n\u003cp\u003e- Bộ sản phẩm bao gồm: thân bếp + khay than + giá đỡ than + phên nướng inox.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/8d/7d/cb/5879b516de91fd352c26e5260697872c.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e2. ĐẶC ĐIỂM NỔI BẬT\u003c/p\u003e\n\u003cp\u003e- Đáy bếp có giá đỡ than kết hợp với lỗ thông gió giúp than tự cháy, không cần phải quạt, tránh bụi lên thức ăn.\u003c/p\u003e\n\u003cp\u003e- Tiết kiệm thời gian nhóm than, ít khói, it tiêu hao than.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/ba/63/dc/dc3e817e76d34e6929b0bef50b93b911.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/e2/14/87/78e642dfd5d3936350740cd9a954d477.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e- Vỉ nướng chất liệu inox, an toàn cho sức khỏe, dễ dàng vệ sinh\u003c/p\u003e\n\u003cp\u003e- Bếp nướng than hoa có thể gấp gọn, tiện lợi mang theo cho các chuyến đi.\u003c/p\u003e\n\u003cp\u003e- Khay than dài giúp điều chỉnh than để phân bố nhiệt phù hợp với thực phẩm nướng.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/15/ec/21/4d2e2271135c9ddff29dd23ce3450c9c.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/b5/19/8d/88b88d08c8c99bb2ab961c8b734bea03.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/87/7d/be/7d4a9ff38f181816eacecce214891bcd.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eLưu Ý:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Do ánh sáng và cài đặt màn hình khác nhau, màu của sản phẩm có thể hơi khác so với hình ảnh.\u003c/p\u003e\n\u003cp\u003e️- Xin vui lòng cho phép sai số kích thước của sản phẩm khác nhau do đo lường thủ công.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/77/af/74/4994d8bb6009a72f152d259d6434301a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/77/af/74/4994d8bb6009a72f152d259d6434301a.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/77/af/74/4994d8bb6009a72f152d259d6434301a.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/77/af/74/4994d8bb6009a72f152d259d6434301a.jpg","thumbnail_u