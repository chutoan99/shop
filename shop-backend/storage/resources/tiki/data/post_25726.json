596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":20,"review_text":"(20)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/53/26/04/b9b8e5e45923ad2338b5731f9432234c.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1225,"all_time_quantity_sold":242,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\n\u003ch3\u003eTrà thảo mộc hữu cơ HiPP Mama dành cho mẹ cho con bú - giúp bồi bổ cơ thể, giải khát và lợi sữa (30g/20 túi lọc/hộp)\u003c/h3\u003e\n\u003ch3\u003e1. THÔNG SỐ KỸ THUẬT\u003c/h3\u003e\n\u003cp\u003e- Model: AL2345\u003c/p\u003e\n\u003cp\u003e- Xuất xứ: Châu Âu\u003c/p\u003e\n\u003cp\u003eNhà sản xuất ULRICH WALTER GMBH\u003c/p\u003e\n\u003cp\u003eĐịa chỉ: Dr Jurgen Ulderup Strabe 12, 49356 Diepholz, Đức\u003c/p\u003e\n\u003cp\u003e- Dòng sản phẩm: Trà thảo mộc hữu cơ HiPP Mama dành cho mẹ cho con bú dạng túi lọc\u003c/p\u003e\n\u003cp\u003e- Độ tuổi sử dụng: Bà mẹ cho con bú\u003c/p\u003e\n\u003cp\u003e- Khối lượng: 30g/ hộp (gồm 20 túi lọc, 1.5g/túi lọc)\u003c/p\u003e\n\u003cp\u003e- Hương vị: Xả và bạc hà tươi mát, dễ chịu\u003c/p\u003e\n\u003cp\u003e- Hạn sử dụng: 24 tháng.\u003c/p\u003e\n\u003cp\u003e\u0026#34;Sản phẩm không phải là thuốc và không có chức năng thay thế thuốc chữa bệnh\u0026#34;.\u003c/p\u003e\n\u003ch3\u003e2. ĐẶC ĐIỂM SẢN PHẨM\u003c/h3\u003e\n\n\u003cp\u003e- Là thức uống bồi bổ cơ thể, giải khát hằng ngày, hỗ trợ hoạt động các tuyến lợi sữa\u003c/p\u003e\n\u003cp\u003e- Nên uống ở giai đoạn cuối thai kỳ và suốt quá trình cho con bú\u003c/p\u003e\n\u003cp\u003e- Sản phẩm có nguyên liệu từ thảo mộc hoàn toàn tự nhiên\u003c/p\u003e\n\u003cp\u003e- Sản phẩm đạt tiêu chuẩn hữu cơ Châu Âu và tiêu chuẩn cao hơn của HiPP\u003c/p\u003e\n\u003ch3\u003e3. HƯỚNG DẪN SỬ DỤNG\u003c/h3\u003e\n\u003cp\u003e- Cho 1 túi trà vào 200ml nước sôi, ngâm từ 3-5 phút. Có thể uống nóng hoặc nguội\u003c/p\u003e\n\u003cp\u003e- Uống từ 3-4 cốc mỗi ngày\u003c/p\u003e\n\u003ch3\u003e4. BẢO QUẢN: \u003c/h3\u003e\n\u003cp\u003eBảo quản nơi khô ráo, thoáng mát ở nhiệt độ thường. Không để gần chất có mùi.\u003c/p\u003e\n\n\u003cp\u003e_____\u003c/p\u003e\n\u003cp\u003eHiPP là một trong những thương hiệu hàng đầu tại Đức, chuyên về các dòng thực phẩm dinh dưỡng hoàn toàn hữu cơ cho mẹ và bé. Chúng tôi thấu hiểu rằng trong giai đoạn đầu đời, các bậc phụ huynh luôn mong muốn đem đến cho con mình những nguồn dinh dưỡng tốt nhất cho sự phát triển khỏe mạnh của bé. Do đó, phương châm làm việc và niềm đam mê của Hipp luôn là mang đến những giá trị sống cũng như chất lượng sản phẩm tốt nhất cho người tiêu dùng. Không chỉ kiểm soát nghiêm ngặt trong quá trình sản xuất, mỗi sản phẩm của HiPP đều trải qua hơn 260 công đoạn kiểm tra gắt gao và hơn 1300 cuộc kiểm nghiệm kỹ càng, từ nguyên liệu đầu vào cho tới sản phẩm trước khi đưa đến tay người tiêu dùng.\u003c/p\u003e\n\u003cp\u003eHiPP sở hữu nhiều loại sản phẩm phong phú, từ sữa công thức, nước quả nguyên chất đến thức ăn dặm và các loại thịt đều được làm từ nguyên liệu siêu sạch, thơm ngon và bổ dưỡng\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\n\n\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/53/26