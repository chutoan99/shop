"icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":71000,"discount_rate":14,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/0e/ef/24/0b43ccd5527d2a1c4698ce2e906eef57.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":21,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cul\u003e\n\u003cli\u003eTên sản phẩm: \u003cstrong\u003eKệ Để Đồ Nhà Bếp, Kệ Để Đồ Đa Năng 3 Tầng Bằng Nhựa Cao Cấp\u003c/strong\u003e\u003c/li\u003e\n\u003cli\u003eChất liệu: Nhựa Abs cao cấp\u003c/li\u003e\n\u003cli\u003eKích thước: 109 x 33 x 44 cm\u003c/li\u003e\n\u003cli\u003eKiểu dáng: 3 tầng\u003c/li\u003e\n\u003cli\u003eMàu sắc: trắng, xám, xanh hồng\u003c/li\u003e\n\u003cli\u003eTrọng lượng: 4007GRAM\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/46/b9/51/5aa381b83957dc1dd049cc353cc375e8.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eĐặc tính sản phẩm\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eSử dụng sản phẩm thông minh hàng đầu được người tiêu dùng lựa chọn.\u003c/li\u003e\n\u003cli\u003e\u003cem\u003eKệ để đồ nhà bếp đa năng\u003c/em\u003e có bánh xe cho cuộc sống thêm nhiều tiện nghi và hiện đại hơn bao giờ hết. Với nhiều tính năng vượt trội, kệ để đồ dùng cho nhà bếp tiết kiệm không gian nhà cửa cực kì hiệu quả.\u003c/li\u003e\n\u003cli\u003eChất liệu nhựa bền bỉ sử dụng bền lâu, với thiết kế 3 tầng mỗi tầng mang chức năng riêng cho sức chứa rộng rãi\u003c/li\u003e\n\u003cli\u003eTrang bị khớp xoay điều chỉnh góc độ của ngăn đựng hỗ trợ việc lấy đồ thuận tiện hơn; các ngăn đựng thiết kế lỗ thoáng khí và ráo nước tránh ẩm mốc và bụi bẩn.\u003c/li\u003e\n\u003cli\u003eBánh xe linh hoạt xoay 360 độ di chuyển và vừa vặn với mọi ngóc ngách của không gian nhà cửa. Thao tác lắp đặt nhanh chóng và dễ dàng; kiểu dáng hiện đại và đẹp mắt.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/26/47/bf/4ff563bd40cc3fb360ae59fcfc196bb6.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/32/b8/5c/fbc89258e65253f9d0085fd2d91fecfa.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/3d/39/a0/7ede216b8bb03729394fd80011145433.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/0e/ef/24/0b43ccd5527d2a1c4698ce2e906eef57.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0e/ef/24/0b43ccd5527d2a1c4698ce2e906eef57.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/0e/ef/24/0b43ccd5527d2a1c4698ce2e906eef57.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0e/ef/24/0b43ccd5527d2a1c4698ce2e906eef57.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0e/ef/24/0b43ccd5527d2a1c4698ce2e906eef57.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/95/5e/e6/98f