ikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":115000,"discount_rate":21,"rating_average":5,"review_count":47,"review_text":"(47)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/3e/cd/f1/580c63a9d9f2ed9e28196f0e908d4c7c.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":701,"all_time_quantity_sold":582,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\"* Finish -Thương hiệu viên rửa chén bát bán chạy số 1 toàn cầu. \u003cbr /\u003e* Finish là thương hiệu dẫn đầu thị trường về rửa chén tự động, được khuyên dùng bởi các nhãn hàng máy rửa chén hàng đầu trên thế giới\u003c/p\u003e\n\u003cp\u003e* Sản phẩm Finish tại Tiki cam kết 100% nhập khẩu chính hãng tại Việt Nam.\u003c/p\u003e\n\u003cp\u003eViên Rửa Chén Bát Hương Chanh Finish Powerball Power Essential Lemon Sparkle - Túi 100 viên siêu tiết kiệm\u003c/p\u003e\n\u003cp\u003eGiải pháp tổng hợp làm sạch \u003cbr /\u003echén bát cho mọi nhà. Công thức tẩy rửa vượt trội, với sức mạnh 6X* chứa trong phần lõi màu đỏ của viên nén giúp làm sạch hiệu quả chỉ sau một lần rửa.\u003cbr /\u003e*Sáu chức năng trong một viên rửa\"\"\u003cbr /\u003eNo\u003c/p\u003e\n\u003cp\u003eHướng dẫn sử dụng: \u003cbr /\u003e1. Xé màng bọc bên ngoài viên nén và vứt màng bọc vào thùng rác\u003cbr /\u003e2. Ngăn chứa viên rửa bát phải KHÔ RÁO trước khi cho 1 viên rửa bát vào.\u003cbr /\u003e3. Không đặt viên rửa bát vào rổ đựng đũa, muỗng.\u003cbr /\u003e4. Để có kết quả tốt nhất, hãy chọn chế độ rửa tiết kiệm/tự động. Nếu viên rửa bát không vừa với ngăn đựng, hãy tham khảo hướng dẫn từ nhà sản xuất máy rửa bát hoặc trên tờ hướng dẫn sử dụng. \u003cbr /\u003e5. Để đạt hiệu quả tốt nhất trong chu kì ngắn, hãy đặt viên tẩy rửa Finish Power Essential kế bên bộ lọc ở mặt sàn của máy rửa bát.\u003c/p\u003e\n\u003cp\u003eKhuyến cáo:\u003cbr /\u003e- Tránh xa tầm tay trẻ em. \u003cbr /\u003e- Gây kích ứng mắt nghiêm trọng. Nếu chẳng may dính vào mắt, hãy rửa mắt cẩn thận với nước trong vài phút và tháo kính áp tròng nếu có thể. Tiếp tục rửa với nước. Nếu tình trạng kích ứng kéo dài, hãy tham khảo ý kiến của bác sỹ và cầm theo vỏ hoặc nhãn dán sản phẩm khi đi khám.\u003cbr /\u003e- Tuyệt đối không được nuốt sản phẩm. Nếu chẳng may nuốt phải, hãy lập tức tham khảo ý kiến bác sỹ.\u003cbr /\u003e\"\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/3e/cd/f1/580c63a9d9f2ed9e28196f0e908d4c7c.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/3e/cd/f1/580c63a9d9f2ed9e28196f0e908d4c7c.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/3e/cd/f1/580c63a9d9f2ed9e28196f0e908d4c7c.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3e/cd/f1/580c63a9d9f2ed9e28196f0e908d4c7c.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3e/cd/f1/580c63a9d9f2ed9e28196f0e908d4c7c.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/1a/c2/a5/ab338ac00f19458f46e9014b14897136.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/1a/c2/a5/ab338ac00f19458f46e9014b14897136.jpg","me