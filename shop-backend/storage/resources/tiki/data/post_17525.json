":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":321800,"discount_rate":45,"rating_average":4.5,"review_count":9,"review_text":"(9)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/e2/ca/e6/064890e004792a03244c3721cebdfad5.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":695,"all_time_quantity_sold":36,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eBình giữ nhiệt Lock\u0026amp;Lock x Việt Nam phiên bản đặc biệt 897ml LHC4160 kèm cọ rửa và ống hút đầu Silicone - JoyMall\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cdiv class=\"syl-image-wrapper\"\u003e\u003cimg src=\"https://p16-oec-va.ibyteimg.com/tos-maliva-i-o3syd03w52-us/d56b72401942463889ef486bd8e4387a~tplv-o3syd03w52-origin-jpeg.jpeg\" alt=\"d56b72401942463889ef486bd8e4387a~tplv-o3syd03w52-origin-jpeg.jpeg\" width=\"1000\" height=\"1310\" /\u003e\u003c/div\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eKích thước: 230x90mm\u003c/p\u003e\n\u003cdiv class=\"syl-image-wrapper\"\u003e\u003cimg src=\"https://p16-oec-va.ibyteimg.com/tos-maliva-i-o3syd03w52-us/65792362ca154bc39490269c7a848855~tplv-o3syd03w52-origin-jpeg.jpeg\" alt=\"65792362ca154bc39490269c7a848855~tplv-o3syd03w52-origin-jpeg.jpeg\" width=\"1000\" height=\"1334\" /\u003e\u003c/div\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eChất liệu: Nắp nhựa, thân thép không gỉ\u003c/p\u003e\n\u003cp\u003eSản phẩm có khay lọc trà tiện lợi và quai xác mang đi\u003c/p\u003e\n\u003cp\u003eRiêng 4 phiên bản Lock\u0026amp;Lock x Việt Nam đều sẽ được tặng kèm 1 ống hút có đầu Silicone và 1 cọ rửa\u003c/p\u003e\n\u003cp\u003e1/ Nón Lá (Palm-leaf Conical Hat) - LHC4160BEG\u003c/p\u003e\n\u003cp\u003eNón Lá là một loại nón và là biểu tượng đặc trưng của người Việt Nam. Từ xa xưa, Những chiếc nón lá đã được sử dụng để bảo vệ người dùng khỏi các tác động nắng mưa của khí hậu nhiệt đới gió mùa ở Việt Nam.\u003c/p\u003e\n\u003cp\u003e2/ Hoa Sen (Lotus) - LHC4160VOL\u003c/p\u003e\n\u003cp\u003eHoa Sen được xem là Quốc hoa của nước Việt Nam. Nó được biết đến như loài hoa của bình minh; là biểu tượng của sự thanh khiết, sự cam kết và lạc quan cho tương lai. Vào ban đêm, hoa sẽ khép mình lại và chìm dưới nước; vươn lên và nở rộ vào lúc bình minh.\u003c/p\u003e\n\u003cp\u003e3/ Ruộng Bậc Thang(Terrace) - LHC4160DGRN\u003c/p\u003e\n\u003cp\u003eTỉnh Yên Bái ở miền bắc Việt Nam là một nơi nổi tiếng với những thửa ruộng bậc thang bạt ngàn. Cấu trúc độc đáo của ruộng bậc thang giúp cho việc canh tác hiệu quả hơn trên địa hình đất dốc đặc trưng của miền núi. Trong những năm gần đây, những cánh đồng lúa này đã trở thành một điểm thu hút khách du lịch đặc biệt vào mùa thu hoạch.\u003c/p\u003e\n\u003cp\u003e4/ Phú Quốc(the Pearl Island) - LHC4160NVY\u003c/p\u003e\n\u003cp\u003ePhú Quốc là một hòn đảo của Việt Nam ngoài khơi Campuchia thuộc Vịnh Thái Lan. Nơi đây được biết đến với những bãi biển cát trắng và các khu nghỉ dưỡng cao cấp, hầu hết đều nằm dọc theo bờ biển phía tây nam rợp bóng mát. Phú Quốc là hòn đảo lớn và đẹp nhất Việt Nam.\u003c/p\u003e\n\u003cdiv class=\"syl-image-wrapper\"\u003e\u003cimg src=\"https://p16-oec-va.ibyteimg.com/tos-maliva-i-o3syd03w52-us/dde61b6ce2424186ba2e499ca0d18567~tplv-o3syd03w52-origin-jpeg.jpeg\" alt=\"dde61b6ce2424186ba2e499ca0d18567~tplv-o3syd03w52-origin-jpeg.jpeg\" width=\"1000\" height=\"1797\" /\u003e\u003c/div\u003e\n\u003cdiv class=\"syl-image-wrapper\"\u003e\u003cimg src=\"https://p16-oec-va.ibyteimg.com/tos-maliva-i-o3syd03w52-us/8315f9ed9f3041f5a40e25312f4d806d~tplv-o3syd03w52-origin-jpeg.jpeg\" alt=\"8315f9ed9f3041f5a40e25312f4d806d~tplv-o3syd03w52-origin-jpeg.jpeg\" width=\"1000\" height=\"1418\" /\u003e\u003c/div\u003e\n\u003cp\u003eDỄ DÀNG MANG THEO VỚI QUAI XÁCH TIỆN LỢI: Quai xách của bình mang đến tính năng di dộng tiện lợi để bạn có thể mang bình theo đến bất cứ đâu.\u003c/p\u003e\n\u003cdiv class=\"syl-image-wrapper\"\u003e\u003cimg src=\"https://p16-oec-va.ibyteimg.com/tos-maliva-i-o3syd03w52-us/954bf22d14c14677a94966c12ba2903b~tplv-o3syd03w52-origin-jpeg.jpeg\" alt=\"954bf22d14c14677a94966c12ba2903b~tplv-o3syd03w52-origin-jpeg.jpeg\" width=\"1000\" height=\"1714\" /\u003e\u003c/div\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eBỘ LỌC THÉP KHÔNG GỈ: Bộ lọc giúp cho đá bên trong cốc không bị tràn ra ngoài khi uống.\u003c/p\u003e\n\u003cdiv class=\"syl-image-wrapper\"\u003e\u003cimg src=\"https://p16-oec-va.ibyteimg.com/tos-maliva-i-o3syd03w52-us/871ab3490bcd4c2994ab28d896038180~tplv-o3syd03w52-origin-jpeg.jpeg\" alt=\"871ab3490bcd4c2994ab28d896038180~tplv-o3syd03w52-origin-jpeg.jpeg\" width=\"1000\" height=\"1994\" /\u003e\u003c/div\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eMIỆNG BÌNH RỘNG: Bình với thiết kế phần miệng rộng giúp bạn thưởng thức đồ uống với đá viên một cách trọn vẹn và vệ sinh bình dễ dàng hơn.\u003c/p\u003e\n\u003cdiv class=\"syl-image-wrapper\"\u003e\u003cimg src=\"https://p16-oec-va.ibyteimg.com/tos-maliva-i-o3syd03w52-us/9b32cfe56f4140249c4d9ffc4532a06a~tplv-o3syd03w52-origin-jpeg.jpeg\" alt=\"9b32cfe56f4140249c4d9ffc4532a06a~tplv-o3syd03w52-origin-jpeg.jpeg\" width=\"1000\" height=\"2000\" /\u003e\u003c/div\u003e\n\u003cdiv class=\"syl-image-wrapper\"\u003e\u003cimg src=\"https://p16-oec-va.ibyteimg.com/tos-maliva-i-o3syd03w52-us/2646092d275b4993abae5e435c60dbe2~tplv-o3syd03w52-origin-jpeg.jpeg\" alt=\"2646092d275b4993abae5e435c60dbe2~tplv-o3syd03w52-origin-jpeg.jpeg\" width=\"1000\" height=\"1194\" /\u003e\u003c/div\u003e\n\u003cp\u003e*Bộ bình bao gồm: BÌNH GIỮ NHIỆT, ỐNG HÚT VỚI PHẦN ĐẦU SILICONE 2 CHIỀU LINH HOẠT VÀ BỘ CỌ VỆ SINH (bao gồm cả hướng dẫn cách sử dụng ống hút)\u00