am giới.\u003c/p\u003e\n\u003cp\u003e3 Đồ hình huyệt vị kinh lạc ở nữ giới\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/f4/31/06/bfcda62f41a6959ce10eab9a490cea1d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f4/31/06/bfcda62f41a6959ce10eab9a490cea1d.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f4/31/06/bfcda62f41a6959ce10eab9a490cea1d.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f4/31/06/bfcda62f41a6959ce10eab9a490cea1d.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/f4/31/06/bfcda62f41a6959ce10eab9a490cea1d.jpg"}],"warranty_policy":null,"current_seller":{"id":34746,"sku":"9370650985660","name":"Nhà Sách Đinh Lễ","link":"https://tiki.vn/cua-hang/nha-sach-dinh-le","logo":"c5/89/63/a6b1e451ca7287f268f8143ff2f3b888.jpg","price":396150,"product_id":"262082876","store_id":34032,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[{"id":10821,"name":"nha sach nguyet linh","link":"https://tiki.vn/cua-hang/nha-sach-nguyet-linh","logo":"https://vcdn.tikicdn.com/ts/seller/88/2b/d0/eaa1eadc8566bf565288bb245d07f952.jpg","price":396150,"product_id":"262083283","store_id":10595}],"specifications":[{"name":"Thông tin chung","attributes":[{"code":"publisher_vn","name":"Công ty phát hành","value":"Cty TNHH Văn hóa Minh Lâm"},{"code":"manufacturer","name":"Nhà xuất bản","value":"Nhà Xuất Bản Hồng Đức"}]}],"price_comparison":{"sub_title":"Giá từ 396.150 ₫","title":"So sánh 1 nhà bán khác"},"product_links":[],"gift_item_title":"0 quà tặng kèm","services_and_promotions":[],"promition