is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":10400,"discount_rate":10,"rating_average":4.8,"review_count":14,"review_text":"(14)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/bf/c6/60/e58a88369b6a8db40f9759ff23036c4b.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1250,"all_time_quantity_sold":67,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003eĐẶC ĐIỂM NỔI BẬT CỦA SẢN PHẨM\u003c/strong\u003e\u003c/p\u003e\n\u003cul style=\"text-align:justify;\"\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eHộp Bột Lá Sen Quảng Thanh \u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003ecó nguồn gốc từ những vùng trồng riêng biệt để sản xuất thành bột có thể làm thực phẩm. Bột được trải qua quy trình sấy lạnh và nghiền mịn đảm bảo an toàn cho người dùng. Đặc biệt, rất thích hợp cho người  thường hay mất ngủ, những người bị mỡ máu, mỡ tạng hoặc nhiều mỡ cơ thể. \u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eHộp Bột Lá Sen Quảng Thanh \u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003ekhông chứa chất bảo quản, không pha trộn thêm bất kỳ thành phần phụ gia hóa học nào.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/bf/c6/60/6741e3ac64f4237da3c40a2923a2f990.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cem\u003e\u003cspan style=\"font-weight:400;\"\u003eBột Lá Sen Quảng Thanh thích hợp cho người mất ngủ, những người bị mỡ máu\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003eCÔNG DỤNG CỦA SẢN PHẨM\u003c/strong\u003e\u003c/p\u003e\n\u003cul style=\"text-align:justify;\"\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eHộp Bột Lá Sen Quảng Thanh\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e hỗ trợ mất ngủ\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eGiảm mỡ trong máu, mỡ trong nội tại\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eGiảm cân, tiêu mỡ, điều hòa huyết áp\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eNgoài ra còn dùng làm nguyên liệu pha chế dược liệu và nguyên liệu mỹ phẩm vì bột lá sen hoàn toàn tự nhiên.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cem\u003e\u003cspan style=\"font-weight:400;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/22/42/e4/438caa0cabb6409c8a4fe3b525482592.jpeg\" alt=\"Hộp Bột Lá Sen Quảng Thanh\" width=\"750\" height=\"525\" /\u003e\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cem\u003e\u003cspan style=\"font-weight:400;\"\u003eHộp Bột Lá Sen Quảng Thanh\u003c/span\u003e\u003c/em\u003e\u003cem\u003e\u003cspan style=\"font-weight:400;\"\u003e - hộp gói nhỏ tiện lợi - dễ dàng sử dụng và bảo quản\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cul style=\"text-align:justify;\"\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eThành phần: 100% lá sen tươi, sấy lạnh tiệt trùng và nghiền siêu mịn\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eĐộ ẩm: dưới 5%\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eNgày sản xuất: xem trên bao bì\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eHạn sử dụng: 1 năm kể từ ngày sản xuất\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eSố công bố: 007-2019/CBHQ-TNV\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003eCÁCH DÙNG\u003c/strong\u003e\u003c/p\u003e\n\u003cul style=\"text-align:justify;\"\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eGiải khát bằng cách pha 1 gói với 200ml nước. Khuấy đều và thêm đá nếu uống lạnh. Bạn cũng có thể thêm đường, mật ong, chanh hoặc nước dừa để tăng thêm vị ngon (1 – 2 lần/ ngày).\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eCông thức làm đẹp với \u003c/span\u003e\u003cstrong\u003eHộp Bột Lá Sen Quảng Thanh:\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e Để có được làn da căng mịn, tràn sức sống, hãy áp dụng ngay công thức: bột lá sen trộn với nước tinh khiết tỉ lệ 1:3 (có thể thay nước bằng sữa tươi hoặc sữa chua không đường để vừa ngăn ngừa mụn vừa dưỡng trắng), đắp hỗn hợp này lên da trong 15-20 phút, duy trì 2 lần/tuần.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cem\u003e\u003cspan style=\"font-weight:400;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/00/61/6e/ef188b46a61f7da9d56723554791cd5a.jpg\" alt=\"Hộp Bột Lá Sen Quảng Thanh\" width=\"750\" height=\"750\" /\u003e\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cem\u003e\u003cspan style=\"font-weight:400;\"\u003eHộp Bột Lá Sen mini Quảng Thanh phù hợp cho gia đình\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003eBẢO QUẢN\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli style=\"font-weight:400;text-align:justify;\"\u003e\u003cstrong\u003eHộp Bột Lá Sen Quảng Thanh\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e bảo quản \u003c/span\u003e\u003cspan style=\"font-weight:400;\"\u003enơi khô thoáng, tránh tác động của ánh sáng và nhiệt. Tốt nhất nên bảo quản trong ngăn mát tủ lạnh. \u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/bf/c6/60/e58a88369b6a8db40f9759ff23036c4b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/bf/c6/60/e58a88369b6a8db40f9759ff23036c4b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/bf/c6/60/e58a88369b6a8db40f9759ff23036c4b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/bf/c6/60/e58a88369b6a8db40f9759ff23036c4b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/bf/c6/60/e58a88369b6a8db40f9759ff23036c4b.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/c5/04/42/a3cc7644513ca2e4e94220cc2e9f3288.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c5/04/42/a3cc7644513ca2e4e94220cc2e9f3288.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c5/04/42/a3cc7644513ca2e4e94220cc2e9f3288.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c5/04/42/a3cc7644513ca2e4e94220cc2e9f3288.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c5/04/42/a3cc7644513ca2e4e94220cc2e9f3288.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/d6/6c/f9/aa5e432c3