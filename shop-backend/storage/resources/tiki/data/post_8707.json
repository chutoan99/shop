,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/79/cb/17/e815b0752e3092a2460828abd72fb7a5.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":272,"all_time_quantity_sold":18,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"margin:0px;padding:0px;line-height:25px;color:#333333;font-family:'system-ui', '-apple-system', BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;font-size:12px;font-style:normal;font-weight:400;letter-spacing:normal;text-indent:0px;text-transform:none;white-space:normal;word-spacing:0px;background-color:#ffffff;\"\u003e“TÔI LÀ AI?” – RAMANA MAHARSHI: CUỐN SÁCH KINH ĐIỂN CỦA BẬC THẦY CHỨNG NGỘ NGƯỜI ẤN ĐỘ GIÚP NGƯỜI ĐỌC NHẬN RA CHÍNH MÌNH\u003c/p\u003e\n\u003cp style=\"margin:0px;padding:0px;line-height:25px;color:#333333;font-family:'system-ui', '-apple-system', BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;font-size:12px;font-style:normal;font-weight:400;letter-spacing:normal;text-indent:0px;text-transform:none;white-space:normal;word-spacing:0px;background-color:#ffffff;\"\u003eSri Ramana Maharshi (1879 - 1950) được xem là một bậc thầy chứng ngộ, một đạo sư có ảnh hưởng bậc nhất tại Ấn Độ trong thế kỷ XX. Suốt hơn nửa thế kỷ, Bhagavan Sri Ramana Maharshi được dòng người từ khắp Ấn Độ và nhiều người từ phương Tây đến thăm hỏi, để tìm kiếm sự chỉ dẫn tâm linh, tìm kiếm sự an ủi trong vấn nạn khổ não trần đời, hoặc đơn giản để có thể hiện diện cùng với ông. Tuy nhiên, ông không phải giáo chủ, cũng không phải nhà diễn thuyết hay triết gia; lời dạy của ông đặt trọng tâm ở truy vấn “Tôi là ai?” hay truy vấn Tự Ngã.\u003c/p\u003e\n\u003cp style=\"margin:0px;padding:0px;line-height:25px;color:#333333;font-family:'system-ui', '-apple-system', BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;font-size:12px;font-style:normal;font-weight:400;letter-spacing:normal;text-indent:0px;text-transform:none;white-space:normal;word-spacing:0px;background-color:#ffffff;\"\u003eTRÍCH ĐOẠN:\u003c/p\u003e\n\u003cp style=\"margin:0px;padding:0px;line-height:25px;color:#333333;font-family:'system-ui', '-apple-system', BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;font-size:12px;font-style:normal;font-weight:400;letter-spacing:normal;text-indent:0px;text-transform:none;white-space:normal;word-spacing:0px;background-color:#ffffff;\"\u003e“Vì mọi nghĩ tưởng khác chỉ có thể xuất hiện sau khi khởi hoạt cái nghĩ tưởng “Tôi”, và bởi lẽ tâm trí không là gì ngoài một mớ nghĩ tưởng, nên chỉ thông qua truy vấn, “Tôi là ai?” thì tâm trí mới chìm lặng. Hơn nữa, cái nghĩ tưởng tôi toàn vẹn ẩn tàng trong cuộc truy vấn như thế, sau khi hoại diệt tất cả những nghĩ tưởng khác, thì sau rốt chính bản thân nó cũng bị hoại diệt hoặc tiêu mòn, giống như que củi dùng để khều lửa giàn hỏa thiêu đang bốc cháy thì chính bản thân que củi cũng bị thiêu cháy lần hồi.”\u003c/p\u003e\n\u003cp style=\"margin:0px;padding:0px;line-height:25px;color:#333333;font-family:'system-ui', '-apple-system', BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;font-size:12px;font-style:normal;font-weight:400;letter-spacing:normal;text-indent:0px;text-transform:none;white-space:normal;word-spacing:0px;background-color:#ffffff;\"\u003e* THÔNG TIN SÁCH:\u003c/p\u003e\n\u003cp style=\"margin:0px;padding:0px;line-height:25px;color:#333333;font-family:'system-ui', '-apple-system', BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;font-size:12px;font-style:normal;font-weight:400;letter-spacing:normal;text-indent:0px;text-transform:none;white-space:normal;word-spacing:0px;background-color:#ffffff;\"\u003e- Nhà xuất bản Đà Nẵng\u003c/p\u003e\n\u003cp style=\"margin:0px;padding:0px;line-height:25px;color:#333333;font-family:'system-ui', '-apple-system', BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;font-size:12px;font-style:normal;font-weight:400;letter-spacing:normal;text-indent:0px;text-transform:none;white-space:normal;word-spacing:0px;background-color:#ffffff;\"\u003e- Tác giả: Sri Ramana Maharshi\u003c/p\u003e\n\u003cp style=\"margin:0px;padding:0px;line-height:25px;color:#333333;font-family:'system-ui', '-apple-system', BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;font-size:12px;font-style:normal;font-weight:400;letter-spacing:normal;text-indent:0px;text-transform:none;white-space:normal;word-spacing:0px;background-color:#ffffff;\"\u003e- Dịch giả: Võ Quốc Việt\u003c/p\u003e\n\u003cp style=\"margin:0px;padding:0px;line-height:25px;color:#333333;font-family:'system-ui', '-apple-system', BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;font-size:12px;font-style:normal;font-weight:400;letter-spacing:normal;text-indent:0px;text-transform:none;white-space:normal;word-spacing:0px;background-color:#ffffff;\"\u003e- Hình thức: bìa mềm\u003c/p\u003e\n\u003cp style=\"margin:0px;padding:0px;line-height:25px;color:#333333;font-family:'system-ui', '-apple-system', BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;font-size:12px;font-style:normal;font-weight:400;letter-spacing:normal;text-indent:0px;text-transform:none;white-space:normal;word-spacing:0px;background-color:#ffffff;\"\u003e- Kích thước: 13.5 x 20.5cm\u003c/p\u003e\n\u003cp style=\"margin:0px;padding:0px;line-height:25px;color:#333333;font-family:'system-ui', '-apple-system', BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;font-size:12px;font-style:normal;font-