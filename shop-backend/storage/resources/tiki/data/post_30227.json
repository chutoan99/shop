on"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":42,"review_text":"(42)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/b9/85/f5/e40c8f1bd38baf565e072c52d14509a6.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":533,"all_time_quantity_sold":485,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/1b/4e/a0/2c4cad7cdbf69ac16a5c8a2774f4458d.jpg\" alt=\"\" width=\"750\" height=\"188\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eGiới thiệu về Công ty TNHH Thu phí tự động VETC:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eVETC là đơn vị tiên phong trong lĩnh vực Thu phí tự động tại Việt Nam. Hệ thống Thu phí Tự động kết nối VETC chiếm thị phần lớn nhất cả nước và đang được sử dụng trên 114 trạm trải dài từ Bắc vào Nam dọc theo Quốc lộ 1 và các tuyến huyết mạch, cửa ngõ Hà Nội, TPHCM.\u003c/p\u003e\n\u003cp\u003eVETC cung cấp sản phẩm và dịch vụ Giao thông thông minh vì sự phát triển của văn minh xã hội\u003c/p\u003e\n\u003cp\u003eDÁN THẺ VETC, SUÔN SẺ HÀNH TRÌNH\u003c/p\u003e\n\u003cp\u003e------------------------------------------------\u003cbr /\u003e\u003cstrong\u003eCác tuyến/trạm BOT tiêu biểu sử dụng công nghệ Thu phí tự động của VETC\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eCác tuyến cao tốc chính: Pháp Vân-Cầu Giẽ; Cầu Giẽ-Ninh Bình; Hà Nội-Hải Phòng; Nội Bài-Lào Cai; Cao tốc TPHCM-Long Thành-Dầu Giây; Trung Lương-Mỹ Thuận; Đà Nẵng-Quảng Ngãi; Liên Khương-Prenn...\u003c/p\u003e\n\u003cp\u003eCác trạm tiêu biểu: Các trạm thu phí thuộc Quốc lộ 5A, Các trạm thuộc Quốc lộ 1A từ Bắc vào Nam; trạm cửa ngõ TPHCM như Xa lộ Hà Nội; An Sương An Lạc; Cầu Phú Mỹ; các trạm khu vực phía nam Chơn Thành-Tân Khai; Bến Lức-Đức Hòa...\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eVề sản phẩm thẻ etag\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Dịch vụ thu phí tự động đường bộ VETC sử dụng công nghệ RFID (Radio Frequency Identification) dùng sóng radio để nhận diện tự động phương tiện xe cơ giới, từ đó có thể dễ dàng giám sát, quản lý từng giao dịch của phương tiện.\u003c/p\u003e\n\u003cp\u003e- Để sử dụng, khách hàng dán thẻ lên tâm đèn pha ghế phụ theo hướng dẫn gửi kèm trong bộ kit. Thẻ etag giao tiếp với hệ thống Thu phí tự động tại trạm BOT qua sóng radio, nên khi dán cần tránh dán thẻ sát với các mép đèn, gần các bộ phận kim loại gây ảnh hưởng đến việc đọc tín hiệu khi xe qua trạm thu phí. Mỗi xe ô tô chỉ dán 1 thẻ duy nhất, nếu trên xe đã có thẻ, khách hàng bóc bỏ thẻ cũ trước khi dán thẻ mới.\u003c/p\u003e\n\u003cp\u003e- Khách hàng sau khi đã dán thẻ, liên hệ với VETC theo tổng đài 19006010-nhánh 1 để kích hoạt. Sau đó khách hàng mới có thể nạp tiền vào tài khoản và sử dụng qua trạm. VETC sẽ hỗ trợ khách hàng trong vòng 01 tháng kể từ thời điểm khách hàng nhận thẻ. Trong trường hợp cần gia hạn, vui lòng liên hệ VETC để được hướng dẫn.\u003c/p\u003e\n\u003cp\u003e- Để kiểm soát hành trình, quản lý giao dịch qua trạm, nạp tiền, kiểm tra số dư, truy xuất hóa đơn... quý khách tải ứng dụng \"VETC Customer\" trên kho ứng dụng với cả điện thoại Android và IOS.\u003c/p\u003e\n\u003cp\u003e- Thẻ chỉ hữu dụng khi khách hàng dán thẻ đúng vị trí và sử dụng với Biển số xe đã đăng ký. Trong trường hợp quý khách thay đổi thông tin, xin vui lòng liên hệ trước với VETC để được hỗ trợ. VETC có quyền từ chối phục vụ và được miễn trừ trách nhiệm trong trường hợp khách hàng sử dụng thẻ không đúng hướng dẫn và khác với thông tin đã đăng ký. \u003cbr /\u003e------------------------------------------------\u003cbr /\u003e\u003cstrong\u003eCông ty TNHH Thu phí tự động VETC\u003c/strong\u003e\u003cbr /\u003e\u003cstrong\u003eTỔNG ĐÀI 24/7: 19006010-nhánh 1\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/b9/85/f5/e40c8f1bd38baf565e072c52d14509a6.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b9/85/f5/e40c8f1bd38baf565e072c52d14509a6.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b9/85/f5/e40c8f1bd38baf565e072c52d14509a6.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b9/85/f5/e40c8f1bd38baf565e072c52d14509a6.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b9/85/f5/e40c8f1bd38baf565e072c52d14509a6.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/01/a2/a8/fb4fe3057fe92f06991b32fc6af92e63.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/01/a2/a8/fb4fe3057fe92f06991b32fc6af92e63.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/01/a2/a8/fb4fe3057fe92f06991b32fc6af92e63.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/01/a2/a8/fb4fe3057fe92f06991b32fc6af92e63.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/01/a2/a8/fb4fe3057fe92f06991b32fc6af92e63.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/59/25/f5/0644e09c0ac3e53355fc7024cf5361c8.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/59/25/f5/0644e09c0ac3e53355fc7024cf5361c8.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/59/25/f5/0644e09c0ac3e53355fc7024cf5361c8.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5