n_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":73800,"discount_rate":20,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/45/d2/7c/a57f1371d08e7d3e5a6e48762b36adf2.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":579,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/16/df/77/faa93349176a3ec5575d13eb038e2e7a.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eƯu điểm nổi bật:\u003cbr /\u003e- Ánh sáng trung thực, ổn định không nhấp nháy.\u003cbr /\u003e- Đạt tiêu chuẩn Việt Nam 5699-1-2010 về thiết bị an toàn do Cục Tiêu Chuẩn Đo lường Chất Lượng TP.HCM chứng nhận.\u003cbr /\u003e- Thiết kế tinh tế theo xu hướng hiện đại, sang trọng và tinh tế\u003cbr /\u003e- Chất liệu nhựa ABS bền đẹp, an toàn cho sức khoẻ người sử dụng\u003cbr /\u003e- Pin Lithium, chất liệu pin cao cấp nhất hiện nay: dung lượng 1200mAh\u003cbr /\u003e- Số lượng chip Led: 42\u003cbr /\u003e- Công suất: 5W\u003cbr /\u003e- Điện áp: 5V DC – 500mA\u003cbr /\u003e- Thời gian sạc: 4 giờ\u003cbr /\u003e- Thời gian hoạt động:\u003cbr /\u003e+ Sáng mạnh: 2 giờ\u003cbr /\u003e+ Sáng vừa: 3,5 giờ\u003cbr /\u003e+ Sáng yếu: 5 giờ\u003cbr /\u003e- Nhiệt độ màu ánh sáng: 3000 – 7300K\u003cbr /\u003e- Chỉ số hoàn màu CRI: 82 Ra\u003cbr /\u003e- Quang thông: 230Lm\u003cbr /\u003e- Có thể điều chỉnh góc chiếu mọi hướng\u003cbr /\u003e- Cấp độ sáng: 3 mức (100%, 40%, 10%)\u003cbr /\u003e\u003cbr /\u003e- Có 3 màu Ánh sáng: Ánh sáng Trắng , Ánh sáng Vàng, Ánh sáng Trung Tính\u003cbr /\u003e\u003cbr /\u003e- Chạm giữ phím nguồn để tăng/giảm độ sáng theo nhu cầu sử dụng\u003cbr /\u003e- Dễ dàng sạc cho Đèn bàn sạc Led Comet CT175 thông qua cổng Micro USB (được tặng kèm 01 cáp Micro USB: có thể sạc cho đèn bàn CT175 thông qua cổng USB của PC, Laptop, Pin sạc dự phòng, ổ cắm điện có cổng USB, hoặc đơn giản là dùng cục sạc điện thoại cổng Micro USB để sạc cho đèn bàn Comet CT175)\u003cbr /\u003e\u003cbr /\u003eHướng dẫn sử dụng:\u003cbr /\u003e- Gạt nút nguồn phía sau đế sản phẩm sang chế độ ON \u003cbr /\u003e- Bật/tắt đèn \u0026amp; điều chỉnh ánh sáng: chạm nhẹ 1, 2, 3, 4 lần vào nút nguồn để chọn chế độ ánh sáng phù hợp: trắng/vàng/trung tính/tắt.\u003cbr /\u003e- Sau khi chọn màu ánh sáng phù hợp, bạn giữ nút nguồn để tùy chỉnh tăng/giảm độ sáng theo nhu cầu.\u003cbr /\u003e- Sạc pin: Kết nối dây cáp USB vào cốc sạc/thiết bị sạc có điện áp phù hợp với đầu vào Micro USB DC 5V, dòng điện tối đa 500mA, sau đó cắm đầu sạc vào cổng Micro USB trên đèn, đèn Led báo sạc pin sẽ sáng đỏ. Khi sạc 4 giờ pin sẽ đầy và tự động ngắt, đèn bao sạc chuyển sang màu xanh, bạn chú ý rút cốc sạc.\u003cbr /\u003e- Sạc đèn đủ 6 giờ trước khi sử dụng lần đầu. Nếu không sử dụng đèn trong thời gian dài, sạc đèn ít nhất 1 lần trong vòng 3 tháng, sạc đủ 6 giờ để bảo vệ tuổi thọ của pin.\u003cbr /\u003e- Sử dụng dây sạc USB đi kèm hoặc cổng sạc khác tương thích, đảm bảo chất lượng\u003cbr /\u003e\u003cbr /\u003eỨng dụng: \u003cbr /\u003e- Dùng đọc sách, báo, nghiên cứu tài liệu, làm việc ban đê\u003cbr /\u003e- Dùng khi mất điện, hoặc dùng để lấy ánh sáng ở những nơi không có điện nguồn\u003cbr /\u003e- Dùng làm quà tặng cho bé yêu, cho người thân, bạn bè, đối tác, đồng nghiệp, hoặc dành tặng cho nhân viên/công nhân trong công ty\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com