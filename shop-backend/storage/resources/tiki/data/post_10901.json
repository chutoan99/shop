icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":5,"review_text":"(5)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/07/d2/0d/a4476a648104fca452983a22105e4ffd.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":385,"all_time_quantity_sold":96,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<h2><strong>Nguồn năng lượng thơm ngon, tiện dụng, hấp thu nhanh.</strong></h2>\n<p>Gel năng lượng GU Original cung cấp năng lượng nhanh chóng, hiệu quả và bền vững để đáp ứng nhu cầu của mọi hoạt động, trong một gói tiện dụng nhỏ gọn, dễ cho vào túi của bạn.</p>\n<p><em><strong>Giảm 10% khi mua 1 hộp 24 gói vị bất kỳ - Giá giảm được tự động áp dụng trong giỏ hàng khi thanh toán. </strong></em></p>\n<p> </p>\n<table border=\"1\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr>\n<td>\n<p><img src=\"//file.hstatic.net/1000092436/file/gluten_689947c0a7914e9ab5eb3d5430654571_grande.png\" alt=\"Không chứa Gluten\" /></p>\n</td>\n<td>\n<p><img src=\"//file.hstatic.net/1000092436/file/dairy_d4d509dcbc8845f7931a5237deadb874_grande.png\" alt=\"KHÔNG CHỨA SẢN PHẨM SỮA\" /></p>\n</td>\n<td>\n<p><img src=\"//file.hstatic.net/1000092436/file/vegan_978f220f6b164a8ba0effa8e6e0a7a5f_grande.png\" alt=\"Thuần chay\" /></p>\n</td>\n<td>\n<p><img src=\"//file.hstatic.net/1000092436/file/kosher_1_dac1bc8d-097e-41b1-ae81-2bc364a2c022_15fa4c3b77554f1b89a83a960ac5eebe_grande.png\" alt=\"Chuứng nhận Do Thái Kosher\" /></p>\n</td>\n<td>\n<p><img src=\"//file.hstatic.net/1000092436/file/informed_choice-201x201-min_4d9bc28f94ea40c8bdadd58a068c5dac_grande.png\" alt=\"Chuứng nhận Informed_Choice\" /></p>\n</td>\n</tr>\n<tr>\n<td>KHÔNG CHỨA <br />GLUTEN</td>\n<td>KHÔNG CHỨA<br />SẢN PHẨM SỮA</td>\n<td>THUẦN CHAY</td>\n<td>\n<p>ĐẠT CHUẨN<br />DO THÁI</p>\n</td>\n<td>\n<p>KHÔNG CHỨA<br />CHẤT CẤM THỂ THAO</p>\n</td>\n</tr>\n</tbody>\n</table>\n<h2> </h2>\n<div>\n<h2><strong>Khi nào nên sử dụng Gel năng lượng?</strong></h2>\n<ul>\n<li>Trước khi tập luyện</li>\n<li>Đói bụng trong qua trình tập</li>\n<li>Mất nhiều mồ hôi</li>\n<li>Phục hồi cơ trong vòng 30 phút sau luyện tập</li>\n</ul>\n<div> </div>\n<h2><strong>Sản phẩm phù hợp cho môn thể thao nào? </strong></h2>\n<ul>\n<li>Tập luyện sức bền như cardio, HIIT trong phòng tập thể dục. </li>\n<li>Các buổi long run hoặc tempo run</li>\n<li>Tham gia marathon tại các cự ly đòi hỏi thời gian dài và sức bền.</li>\n<li>3 môn phối hợp</li>\n<li>Các môn thể thao có thời gian vận động trên 60 phút.  </li>\n</ul>\n<div> </div>\n</div>\n<div>\n<table border=\"1\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr>\n<td>\n<h2><strong>THÀNH PHẦN GEL NĂNG LƯỢNG GỒM CÓ NHỮNG GÌ?</strong></h2>\n<p>Gel năng lượng GU Original chứa carbohydrate để cung cấp năng lượng, điện giải để bổ sung nước và BCAA để bảo vệ cơ bắp hoạt động. </p>\n</td>\n<td>\n<p><img src=\"//file.hstatic.net/1000092436/file/gel_nang_luong_gu_energy_original_-5_b5c967b60b264fdabb36bc882a97af16_grande.jpeg\" alt=\"Thành phần gel năng lượng GU\" /></p>\n</td>\n</tr>\n</tbody>\n</table>\n<table border=\"1\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr>\n<td>\n<h2><strong>CARBOHYDRATES TỪ HAI NGUỒN</strong></h2>\n<p>Các carbohydrate hấp thu nhanh và bền vững - từ maltodextrin và fructose - cho phép bạn tiêu hóa nhiều nhiên liệu nhanh chóng mà không gây cảm giác khó chịu dạ dày.</p>\n</td>\n<td>\n<p><img src=\"//file.hstatic.net/1000092436/file/gel_nang_luong_gu_energy_original_-3_7f371aaa8a764a2dafa16674825ba602_grande.jpeg\" alt=\"CARBOHYDRATES TỪ HAI NGUỒN\" /></p>\n</td>\n</tr>\n<tr>\n<td>\n<h2><strong>BỔ SUNG ĐIỆN GIẢI ĐÃ MẤT</strong></h2>\n<p>Gel của GU chứa natri, điện giải bị mất đi khi ra mồ hôi.<br />Luôn luôn uống gel kèm với một ít nước để giúp cơ thể hấp thụ nhiên liệu một cách hiệu quả.</p>\n</td>\n<td>\n<p><img src=\"//file.hstatic.net/1000092436/file/gel_nang_luong_gu_energy_original_-4_1599ce1fe1934ecba109f30de5b07e28_grande.jpeg\" alt=\"BỔ SUNG ĐIỆN GIẢI ĐÃ MẤT\" /></p>\n</td>\n</tr>\n<tr>\n<td>\n<h2><strong>LỢI ÍCH CỦA BCAA</strong></h2>\nHỗn hợp BCAA giúp bảo vệ cơ bắp, hỗ trợ tạo năng lượng và giúp ngăn ngừa mệt mỏi tinh thần. (Điều này không có ý nghĩa rằng sản phẩm này là thuốc và không được đánh giá bởi Cục Quản lý Thực phẩm và Dược phẩm Hoa Kỳ. Sự hiệu quả có thể thay đổi từ người này sang người khác.)</td>\n<td>\n<p><img src=\"//file.hstatic.net/1000092436/file/gel_nang_luong_gu_energy_original_-2_e9e973aeabd74281b56bab0343de5b4d_grande.jpeg\" alt=\"LỢI ÍCH CỦA BCAA\" /></p>\n</td>\n</tr>\n</tbody>\n</table>\n</div>\n<h2> </h2>\n<h2><strong>So sánh giữa các loại GU Energy Gels</strong> </h2>\n<table border=\"1\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr>\n<td>\n<p><img src=\"//product.hstatic.net/1000092436/product/mandarine_we_1_9682cde5f40c4d8e8b4690d0e91c4c15_master_437d8accb86543fc876ea0cabe3f8624_grande.jpg\" alt=\"GU Energy Gel truyền thống\" /></p>\n</td>\n<td>\n<p><img src=\"//product.hstatic.net/1000092436/product/gu-liquid-energy-lemonade---single-square_89adb13cf6914f77b2e020df15928c95_grande.jpg\" alt=\"GU Energy Liquid Gel\" /></p>\n</td>\n<td>\n<p><img src=\"//product.hstatic.net/1000092436/product/gu_roctane_gel_single_-_strawberry_kiwi_master_a98cc74036f34d58a0ad556f1b1141bb_grande.jpg\" alt=\"GU Energy Roctane Gel\" /></p>\n</td>\n</tr>\n<tr>\n<td>\n<h2><strong>Original Energy Gels</strong></h2>\n<p>GU Gels thông thường cung cấp nguồn năng lượng nhanh chóng, hiệu quả và bền vững để đáp ứng nhu cầu của mọi loại hoạt động.</p>\n</td>\n<td>\n<h2><strong>Liquid Energy Gel</strong></h2>\n<p>Cung cấp lượng carbohydrates dễ hấp thu và tiện dụng như original Energy Gel nhưng với dạng lỏng, dễ uống.</p>\n</td>\n<td>\n<h2><strong>Roctane Energy Gel</strong></h2>\n<p>Dành cho các hoạt động cường độ cao trong thời gian dài, với nhiều điện giải và axit amin hơn.</p>\n</td>\n</tr>\n<tr>\n<td>\n<h2><strong>Khác biệt chính</strong></h2>\n<p>32g<br />Dạng Gel đặc <br />100 Cal<br />22g Carbs<br />-<br />-</p>\n</td>\n<td>\n<h2><strong>Khác biệt chính</strong></h2>\n<p>60g<br />Dạng nước lỏng<br />95 Cal<br />23g Carbs<br />-<br />-</p>\n</td>\n<td>\n<h2><strong>Khác biệt chính</strong></h2>\n<p>32g<br />Dạng Gel đặc <br />100 Cal<br />21g Carbs<br />3X Electrolytes<br />3X BCAA</p>\n</td>\n</tr>\n</tbody>\n</table>\n<h2> </h2>\n<div>\n<h2><strong>Thời gian sử dụng khuyến nghị</strong></h2>\n</div>\n<hr class=\"faqline\" />\n<h2 class=\"clickable\"><strong>0 - 1 Giờ Tập Luyện </strong></h2>\n<p>Khi bạn tập luyện trong vòng một giờ hoặc ít hơn, điều quan trọng là bắt đầu bài tập của bạn trong tình trạng được cung cấp đủ nước và năng lượng. Năm phút trước khi bắt đầu hoạt động, hãy bổ sung năng lượng cho cơ thể với Energy Gel. Tốt nhất là luôn uống vài ngụm nước để giúp cơ thể xử lý nguồn năng lượng hiệu quả hơn.</p>\n<hr class=\"faqline\" />\n<h2 class=\"clickable\"><strong>1 - 2 Giờ Tập Luyện </strong></h2>\n<p>Khi bạn tập luyện trong thời gian dài hơn một giờ, điều quan trọng là phải bổ sung năng lượng trong suốt quá trình tập luyện. Hãy cố gắng ăn Energy Gel mỗi 30-45 phút để duy trì sức mạnh. Mặc dù Liquid Energy Gels có chứa một số nước, nhưng việc bổ sung thêm chất lỏng vẫn rất quan trọng.</p>\n<hr class=\"faqline\" />\n<h2 class=\"clickable\"><strong>2 - 3 Giờ Tập Luyện </strong></h2>\n<p>Khi bạn tăng thời gian tập luyện, cơ thể bạn cần nhiều hơn. Bổ sung Energy Gels với Hydration Tabs để bổ sung điện giải.</p>\n<hr class=\"faqline\" />\n<h2 class=\"clickable\"><strong>3 - 4 Giờ Tập Luyện </strong></h2>\n<p>Trong những nỗ lực duy trì sức bền, bạn không thể thay thế tất cả những gì bạn đang đốt cháy, nhưng bạn có thể tối đa hóa hiệu suất của mình bằng cách ăn càng nhiều càng tốt nguồn thực phẩm năng lượng mà cơ thể của bạn có thể xử lý thoải mái. Tăng cường tiêu thụ BCAA với Roctane Energy Gels sẽ giúp bảo vệ cơ bắp của bạn khi bạn tập luyện lâu hơn.</p>\n<h4> </h4>\n<h2><strong>Thông tin dinh dưỡng</strong></h2>\n<div> </div>\n<div>\n<table border=\"1\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr>\n<td>\n<h2><strong>VỊ CHANH PHÚC BỒN TỬ</strong></h2>\n<p> </p>\n<p> </p>\n</td>\n<td>\n<p><strong><img src=\"//file.hstatic.net/1000092436/file/gel_nang_luong_gu_energy_original_-6_9d6176ac680945619177b1b079103ca5_2048x2048.jpeg\" alt=\"Thành phần dinh dưỡng vị GU Chanh Phúc Bồn Tử\" /></strong></p>\n</td>\n</tr>\n</tbody>\n</table>\n</div>\n<div>\n<table border=\"1\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr>\n<td>\n<h2><strong>VỊ DÂU CHUỐI</strong></h2>\n<p> </p>\n<p> </p>\n<p> </p>\n</td>\n<td>\n<p><img src=\"//file.hstatic.net/1000092436/file/gel_nang_luong_gu_energy_original_-27_483bde23594b49a9956fbac3ef115334_2048x2048.jpg\" alt=\"Thông tin dinh dưỡng GU Gel Dâu chuối\" /></p>\n</td>\n</tr>\n</tbody>\n</table>\n<table border=\"1\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr>\n<td>\n<h2><strong>VỊ CAM QUÝT</strong></h2>\n<h2><strong>+20g CAFFEINE</strong></h2>\n<div> </div>\n<h2> </h2>\n<p> </p>\n<p> </p>\n</td>\n<td>\n<p><strong><img src=\"//file.hstatic.net/1000092436/file/gel_nang_luong_gu_energy_original_-23_c6b99179959b41beaa9325fd47ae9e68_2048x2048.jpg\" alt=\"Thành phần dinh dưỡng vị GU Cam\" /></strong></p>\n</td>\n</tr>\n<tr>\n<td>\n<h2><strong>VỊ CÀ PHÊ ESPRESSO</strong></h2>\n<h2><strong>+40g CAFFEINE</strong></h2>\n<h2> </h2>\n<p> </p>\n<p> </p>\n</td>\n<td>\n<p><strong><img src=\"//file.hstatic.net/1000092436/file/gel_nang_luong_gu_energy_original_-20_4da49df9bc9b46a09ddcca8c88328fe8_2048x2048.jpg\" alt=\"Thành phần dinh dưỡng vị GU Cà Phê Espresso\" /></strong></p>\n</td>\n</tr>\n<tr>\n<td>\n<h2><strong>VỊ BÁNH KẸP SÔ CÔ LA</strong></h2>\n</td>\n<td>\n<p><strong><img src=\"//file.hstatic.net/1000092436/file/gel_nang_luong_gu_energy_original_-17_fd64f12b88da45b899492117e8a33588_2048x2048.jpg\" alt=\"Thông tin dinh dưỡng GU vị bánh kẹp Sô cô la\" /></strong></p>\n</td>\n</tr>\n<tr>\n<td>\n<h2><strong>VỊ SÔ CÔ LA NGUYÊN CHẤT</strong></h2>\n<h2><strong>+20mg CAFFEINE</strong></h2>\n</td>\n<td>\n<p><strong><img src=\"//file.hstatic.net/1000092436/file/gel_nang_luong_gu_energy_original_-18_1b84ac87ae78442e9f0055c3699c215a_master.jpg\" alt=\"Thông tin dinh dưỡng GU vị Sô Cô La Nguyên Chất\" /></strong></p>\n</td>\n</tr>\n<tr>\n<td>\n<h2><strong>VỊ COLA</strong></h2>\n<h2><strong>+40mg CAFFEINE</strong></h2>\n</td>\n<td>\n<p><strong><img src=\"//file.hstatic.net/1000092436/file/gel_nang_luong_gu_energy_original_-19_8785c654cf1d42809f0e25e670db8152_master.jpg\" alt=\"Thông tin dinh dưỡng GU vị Cola\" /></strong></p>\n</td>\n</tr>\n<tr>\n<td>\n<h2><strong>VỊ CHANH</strong></h2>\n<h2><strong>+23g CARBS</strong></h2>\n</td>\n<td>\n<p><strong><img src=\"//file.hstatic.net/1000092436/file/gel_nang_luong_gu_energy_original_-22_e4c231e985f84f9ea4150a48ea1266a8_master.jpg\" alt=\"Thông tin dinh dưỡng GU vị Chanh\" /></strong></p>\n</td>\n</tr>\n<tr>\n<td><br />\n<h2><strong>VỊ MÂM XÔI ĐEN</strong></h2>\n<h2><strong>+40mg CAFFEINE</strong></h2>\n</td>\n<td>\n<p><strong><img src=\"//file.hstatic.net/1000092436/file/gel_nang_luong_gu_energy_original_-21_ae48dd1144264acca68132b9516a905b_master.jpg\" alt=\"Thông tin dinh dưỡng GU vị Mâm Xôi Đen\" /></strong></p>\n</td>\n</tr>\n<tr>\n<td>\n<h2><strong>VỊ SÔ CÔ LA BẠC HÀ</strong></h2>\n<h2><strong>+20mg CAFFEINE</strong></h2>\n</td>\n<td>\n<h2><strong><img src=\"//file.hstatic.net/1000092436/file/gel_nang_luong_gu_energy_original_-24_8228d9604c21438c967623b015bd68db_master.jpg\" alt=\"Thông tin dinh dưỡng GU vị Sô Cô La Bạc Hà\" /></strong></h2>\n</td>\n</tr>\n<tr>\n<td>\n<h2><strong>VỊ DƯA HẤU MUỐI</strong></h2>\n<h2><strong>+20g CAFFEINE</strong></h2>\n</td>\n<td>\n<p><strong><img src=\"//file.hstatic.net/1000092436/file/gel_nang_luong_gu_energy_original_-26_60822212aa604fb69903d186ff90a8d9_master.jpg\" alt=\"Thông tin dinh dưỡng GU vị Dưa Hấu\" /></strong></p>\n</td>\n</tr>\n<tr>\n<td>\n<h2><strong>VỊ MẠCH NHA MẶN</strong></h2>\n<h2><strong>+20mg CAFFEINE</strong></h2>\n</td>\n<td>\n<p><strong><img src=\"//file.hstatic.net/1000092436/file/gel_nang_luong_gu_energy_original_-25_b3ddae610b4c48b7a8997e1f378b8cce_master.jpg\" alt=\"Thông tin dinh dưỡng GU vị Mạch Nha Mặn\" /></strong></p>\n</td>\n</tr>\n<tr>\n<td>\n<h2><strong>VỊ DÂU TỔNG HỢP</strong></h2>\n<h2><strong>+20mg CAFFEINE</strong></h2>\n</td>\n<td>\n<p><strong><img src=\"//file.hstatic.net/1000092436/file/gel_nang_luong_gu_energy_original_-28_d4ab063aa7dc4c7abe62d48599553f97_master.jpg\" alt=\"Thông tin dinh dưỡng GU vị Dâu Tổng Hợp\" /></strong></p>\n</td>\n</tr>\n<tr>\n<td>\n<h2><strong>VỊ ĐẬU VANI </strong></h2>\n<h2><strong>+20mg CAFFEINE</strong></h2>\n</td>\n<td>\n<p><strong><img src=\"//file.hstatic.net/1000092436/file/gel_nang_luong_gu_energy_original_-29_7ad005c59c1e47919dcf50b8f40955c0_master.jpg\" alt=\"Thông tin dinh dưỡng GU vị Đậu Vani\" /></strong></p>\n</td>\n</tr>\n<tr>\n<td>\n<h2><strong>VỊ BÁNH KEM SINH NHẬT</strong></h2>\n</td>\n<td>\n<p><img src=\"//file.hstatic.net/1000092436/file/gel_nang_luong_gu_energy_original_-16_87b0b051ea8644fc84383aea5a4b1dc3_master.jpg\" alt=\"Thông tin dinh dưỡng GU vị Bánh Kem Sinh Nhật\" /></p>\n</td>\n</tr>\n</tbody>\n</table>\n</div>\n<div>\n<p> </p>\n<p><em><strong>** Ghi chú: </strong></em></p>\n<ol>\n<li><em>Gluten Free - không chứa gluten. Gluten là một loại protein có trong lúa mạch, lúa mì và lúa mạch đen. Chế độ ăn không chứa gluten được dùng cho những người bị bệnh celiac hoặc nhạy cảm với gluten để tránh viêm ruột và cải thiện sức khỏe. </em></li>\n<li><em>Dairy Free - không chứa các sản phẩm sữa (như sữa, phô mai, bơ, v.v.)</em></li>\n<li><em>Vegan - thuần chay.  Thành phần không sử dụng bất kì một sản phẩm nào có nguồn gốc từ động vật hoặc lạm dụng sức lao động của động vật. Sản phẩm có thể lấy protein từ hạt và ngũ cốc.</em></li>\n<li><em>Kosher là tiêu chuẩn liên quan đến quy định và tuân thủ của luật Do Thái trong việc sản xuất, chuẩn bị và kiểm định thực phẩm. </em></li>\n<li><em>Banned substance tested - đã được kiểm tra đảm bảo không chứa các chất bị cấm trong thể thao an toàn cho các vận động viên sử dụng. NSF khuyến cáo mua các loại bổ sung đã được kiểm tra và chứng nhận bởi NSF hoặc các tổ chức tương tự không chứa các chất bị cấm. </em></li>\n</ol>\n<div><em>(*) Sản phẩm đạt chứng nhận Informed Choice và An toàn Vệ Sinh Thực Phẩm. <br />(**) Informed Choice là một chương trình đảm bảo chất lượng toàn cầu được nhiều cơ quan chống doping và dinh dưỡng trên thế giới công nhận. </em></div>\n</div>\n<div>\n<div><em>(**) Sản phẩm này không phải là thuốc và không có tác dụng chữa bệnh. </em></div>\n<p> </p>\n</div>\n<div> </div>\n<p> </p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/07/d2/0d/a4476a648104fca452983a22105e4ffd.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/07/d2/0d/a4476a648104fca452983a22105e4ffd.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/07/d2/0d/a4476a648104fca452983a22105e4ffd.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/07/d2/0d/a4476a648104fca452983a22105e4ffd.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/07/d2/0d/a4476a648104fca452983a22105e4ffd.png"}],"warranty_policy":null,"brand":{"id":608227,"name":"GU","slug":