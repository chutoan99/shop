"rating_average":5,"review_count":6,"review_text":"(6)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/1a/bd/ef/9ffbfbc96450c4adef68388666f10016.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2385,"all_time_quantity_sold":32,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch5 style=\"text-align: center;\"\u003e\u003ciframe src=\"//www.youtube.com/embed/hD2o9wpx7CY\" width=\"750\" height=\"421\" allowfullscreen=\"allowfullscreen\"\u003e\u003c/iframe\u003e\u003c/h5\u003e\n\u003ch5\u003eThiết kế mỏng, kiểu dáng đẹp\u003c/h5\u003e\n\u003cp\u003e\u003cstrong\u003eBảng Vẽ Wacom Intuos Pro Medium PTH-660\u003c/strong\u003e chế tạo bằng vật liệu cao cấp và được thiết kế để tận dụng tối đa sức mạnh tuyệt vời của bút Wacom Pro Pen 2, Intuos Pro là dòng bảng vẽ tuyệt vời và có thiết kế đẹp nhất cho đến nay. Khả năng kết nối Bluetooth dễ dàng và trông tuyệt vời trên bàn làm việc. Wacom Intuos Pro có 2 cỡ vừa và lớn, kích thước nhỏ gọn hơn các mẫu trước. Wacom Intuos Pro được chế tạo bằng nhôm đen anốt và sợi thủy tinh composite. Tạo nên một bảng vẽ cứng cáp mạnh mẽ nhưng chỉ dày 8mm.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://vcdn.tikicdn.com/ts/tmp/96/57/36/ba279ccf9fc17eb91c9fe0214a1d90c5.jpg\" alt=\"Bảng Vẽ Wacom Intuos Pro Medium PTH-660 - Hàng Chính Hãng\" width=\"750\" height=\"394\" /\u003e\u003c/p\u003e\n\u003ch5\u003eCông nghệ kỹ thuật số trực tiếp\u003c/h5\u003e\n\u003cp\u003eKết nối với PC Mac hoặc Windows bằng USB hoặc Bluetooth tích hợp, cài đặt trình điều khiển và bạn đã sẵn sàng để bắt đầu làm việc trực tiếp trong phần mềm bạn chọn. Bút Wacom Pro Pen 2 cực kỳ nhạy và tinh tế sẽ kết nối bạn với công việc sáng tạo của bạn một cách chưa từng có. Chất liệu cao cấp và thiết kế nhỏ gọn cung cấp cho bạn không gian sáng tạo hoàn hảo.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://vcdn.tikicdn.com/ts/tmp/bf/ca/db/1e37adcf3e8fdeda4b90471bb339678b.jpg\" alt=\"Bảng Vẽ Wacom Intuos Pro Medium PTH-660 - Hàng Chính Hãng\" width=\"750\" height=\"717\" /\u003e\u003c/p\u003e\n\u003ch5\u003eBút Wacom Pro Pen 2: tự nhiên và chính xác\u003c/h5\u003e\n\u003cp\u003eWacom Pro Pen 2 mới sẽ ngay lập tức trở thành công cụ sáng tạo ưa thích của bạn. Nó nhạy cảm hơn, chính xác hơn và đáp ứng nhanh hơn.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://vcdn.tikicdn.com/ts/tmp/41/56/5d/20974fcb79a4b4bd6f0b2d7820e9775f.jpg\" alt=\"Bảng Vẽ Wacom Intuos Pro Medium PTH-660 - Hàng Chính Hãng\" width=\"750\" height=\"182\" /\u003e\u003c/p\u003e\n\u003ch5\u003eSẵn sàng cho sự sáng tạo\u003c/h5\u003e\n\u003cp\u003eĐược thiết kế cho những sáng tạo 3D trong ý tưởng người nghệ sĩ, Wacom Pro Pen 3D cung cấp khả năng điều khiển đầy đủ trong môi trường ứng dụng 3D. Ba nút tùy chỉnh cho phép bạn quay tròn các đối tượng trong không gian 3D, trượt, phóng to, thu nhỏ mô hình, điêu khắc hoặc tùy chỉnh các công cụ sáng tạo trong các ứng dụng 3D và 2D. Độ nhạy áp lực cao hơn 4 lần *, đặc biệt cảm nhận được góc nghiêng và không độ trễ, kiểm soát tốt hơn trong thiết kế sáng tạo. Sử dụng cho Wacom MobileStudio Pro, Wacom Cintiq Pro hoặc Wacom Intuos Pro (2017) và với bất kỳ ứng dụng Windows hoặc Mac.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://vcdn.tikicdn.com/ts/tmp/92/7a/24/54bd8ee6997ddb94a01603c62ee214a1.jpg\" alt=\"Bảng Vẽ Wacom Intuos Pro Medium PTH-660 - Hàng Chính Hãng\" width=\"750\" height=\"742\" /\u003e\u003c/p\u003e\n\u003ch5\u003eTùy biến phong cách làm việc\u003c/h5\u003e\n\u003cp\u003eWacom Intuos Pro được thiết kế để bạn tập trung vào điều quan trọng nhất - sự sáng tạo. ExpressKeys ™ và Touch Ring có thể tùy chỉnh cung cấp các phím tắt nhanh chóng và dễ dàng cho các tác vụ hàng ngày. Hai nút tùy biến trên Wacom Pro Pen 2 giúp cài đặt phím tắt và điều khiển các chức năng ngay trong khi thao tác. Bật/Tắt chức năng cảm ứng đa chạm giúp điều khiển công việc đơn giản hơn, giống như cách sử dụng điện thoại thông minh của bạn. Chọn lựa các Texture Sheet * khác nhau để thay đổi cảm giác khi thao tác trên Wacom Intuos Pro của bạn. Mỗi loại có mô phỏng khác nhau, từ mịn đến thô.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://vcdn.tikicdn.com/ts/tmp/07/19/e7/ea59ff7879b2ed4cbd0a9d306090a0a8.jpg\" alt=\"Bảng Vẽ Wacom Intuos Pro Medium PTH-660 - Hàng Chính Hãng\" width=\"750\" height=\"541\" /\u003e\u003c/p\u003e\n\u003ch5\u003eThông số kỹ thuật\u003c/h5\u003e\n\u003ctable style=\"width: 750px; margin-left: auto; margin-right: auto;\" border=\"1\"\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd\u003eKích cỡ\u003c/td\u003e\n\u003ctd\u003e338 x 219 x 8 mm / 13.2 x 8.5 x 0.3 in\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003eVùng hoạt động\u003c/td\u003e\n\u003ctd\u003e224 x 148 mm / 8.7 x 5.8 in\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003eTrọng lượng\u003c/td\u003e\n\u003ctd\u003e700g / 1.54lbs\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003eCảm ứng chạm đa điểm\u003c/td\u003e\n\u003ctd\u003eCó\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003eLực nhấn bút\u003c/td\u003e\n\u003ctd\u003e8.192 mức cho đầu vẽ, đầu xóa\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003eGóc nghiêng bút\u003c/td\u003e\n\u003ctd\u003e+/- 60 độ\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003eNgòi dự phòng\u003c/td\u003e\n\u003ctd\u003e6 ngòi tiêu chuẩn + 4 ngòi nhám\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003eĐế cắm bút\u003c/td\u003e\n\u003ctd\u003eCó\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003eĐộ phân giải bảng vẽ\u003c/td\u003e\n\u003ctd\u003e5.080 lpi\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003eExpressKeys\u003c/td\u003e\n\u003ctd\u003e8 phím tùy biến\u003c/td\u00