00f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":46200,"discount_rate":35,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/f2/7f/bf/ffd270b73763206ad932b16c1f5ccc87.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2165,"all_time_quantity_sold":4,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003ciframe src=\"//www.youtube.com/embed/7dlKTfWDx74\" width=\"560\" height=\"314\" allowfullscreen=\"\"\u003e\u003c/iframe\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\" style=\"margin-bottom:.0001pt;text-align:justify;line-height:150%;vertical-align:baseline;\"\u003e\u003cspan style=\"font-size:14pt;line-height:150%;font-family:'Times New Roman', serif;color:#000000;\"\u003e\u003ciframe src=\"//www.youtube.com/embed/wr6hFhuJlYA\" width=\"560\" height=\"314\" allowfullscreen=\"\"\u003e\u003c/iframe\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eIELTS MIKE dạy cho bạn tất cả các kỹ năng và chiến lược quan trọng để cải thiện kĩ năng đọc hiểu và dành điểm cao cho bài thi IELTS Reading. \u003cbr /\u003eCác bạn thi Ielts học thuật chọn cuốn Academic màu vàng, các bạn thi Ielts tổng quát chọn cuốn General màu xanh.\u003c/p\u003e\n\u003cp\u003e1. Giải thích tất tần tật 12 loại câu hỏi thường gặp trong bài thi IELTS Academic Reading và IELTS General Reading đồng thời đưa ra các mẹo, bí kíp, và cả cách tiếp cận từng bước để đưa ra đáp án cho mọi câu hỏi trong bài một cách nhanh nhất và chính xác.\u003c/p\u003e\n\u003cp\u003e2. Bao gồm 5 bài luyện tập thực hành đầy đủ bằng cách sử dụng các bài đọc hiểu với độ khó tương đương những bài thi thực tế, kết hợp sử dụng nhiều loại câu hỏi, đảm bảo giúp bạn luôn sẵn sàng trước mọi bài thi IELTS Reading. \u003c/p\u003e\n\u003cp\u003e3. Reading là phần thi dễ tăng thang điểm IELTS nhất, thầy Mike đã viết cuốn sách The Ultimate Guide to Academic Reading giúp cho thí sinh nạp nhanh khối lượng từ vựng của bài thi và khả năng đọc hiểu nhanh chóng. Rút ngắn thời gian đọc hiểu, suy luận, điền đáp án vào answer sheet trong thời gian chưa đến 60 phút để thí sinh có thể đạt điểm tối đa trong phần thi này.\u003c/p\u003e\n\u003cp\u003e4. Phần thi General Reading không quá nặng về chuyên ngành và mang nội dung về cuộc sống đời thường gần gũi. Cuốn sách The Ultimate Guide to General Reading giúp bạn hoàn thiện tất cả kĩ năng và chiến lược mà bạn cần đồng thời tránh mọi bẫy trong bài thi giúp bạn đạt điểm tối đa.\u003c/p\u003e\n\u003cp\u003eThêm đó, cuốn sách còn cung cấp rất nhiều kiến thức quý giá:\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eCác kỹ năng đọc hiệu quả như scanning và skimming\u003c/li\u003e\n\u003cli\u003eMẹo xác định ngay các từ khóa giúp bạn tìm câu trả lời nhanh và chính xác nhất\u003c/li\u003e\n\u003cli\u003ePhương pháp trả lời mười hai loại câu hỏi xuất hiện trong bài thi\u003c/li\u003e\n\u003cli\u003eBí kíp tránh những lỗi sai thường gặp\u003c/li\u003e\n\u003cli\u003eCách quản lý và chạy đua với lượng thời gian ngắn ngủi trong khi làm bài thi\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/f2/7f/bf/ffd270b73763206ad932b16c1