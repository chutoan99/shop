olor":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"defective_product"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":44,"review_text":"(44)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/0d/60/f3/cb1ec531f46a588ea1ba76325222fa62.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1100,"all_time_quantity_sold":385,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p>Quần lót nữ bikini Smoothie iBasic PANW130</p>\n<p>- Quần lót lưng thấp.</p>\n<p>- Kiểu dáng bikini ôm 3/4 mông.</p>\n<p>- Vải thun co giãn, bề mặt vải thông thoáng khí, thấm hút mồ hôi.</p>\n<p>- Màu sắc nhẹ nhàng, ngọt ngào, nữ tính.</p>\n<p>Chất liệu: Vải thun lưới co giãn 4 chiều, thấm hút tốt, mang lại cảm giác thoải mái cho người mặc.</p>\n<p>Thành phần: 92% Polyester + 8% Spandex</p>\n<p>Xuất xứ: Thiết kế và sản xuất tại Việt Nam.</p>\n<p>Hướng dẫn bảo quản sản phẩm:</p>\n<p>TIP: Ngâm nước lạnh pha ít muối và giặt với dầu gội cho lần giặt đầu tiên giúp cho sản phẩm bền màu hơn.</p>\n<p>- Không giặt với quần áo khác màu, đồ lót nên được giặt riêng.</p>\n<p>- Sử dụng chất tẩy rửa nhẹ, không có chất tẩy trắng.</p>\n<p>- Giặt bằng nước ấm, 30 - 40 độ là nhiệt độ thích hợp nhất, vò nhẹ bằng tay.</p>\n<p>- Nếu phải giặt máy, bỏ vào túi giặt, chọn nhiệt độ nước và chu kì nhẹ nhàng.</p>\n<p>- Nên phơi ở nơi thông thoáng, tránh ánh nắng mặt trời trực tiếp.</p>\n<p>- Sản phẩm không cần ủi, riêng đối với sản phẩm quần lót có thể ủi ở nhiệt độ nhẹ phần đáy để tiệt trùng trước khi sử dụng.</p>\n<p><img title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/70/9a/15/f8c6e14b0845a2287980807c827e1b01.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p><img title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/9f/b0/4c/49e6c9fb9e2e978081ddb07882812c87.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p><img title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/fd/3c/eb/121bedb9a49743871db2ee8bcb2e5f5a.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p><img title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/52/23/63/2f34a42d1f7f00bbe701922ee253ca67.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<p><img src=\"https://salt.tikicdn.com/ts/tmp/a0/7c/6a/cc233ac0dc210d09128bf8809f5e1b91.jpg\" alt=\"\" width=\"750\" height=\"476\" /></p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/0d/60/f3/cb1ec531f46a588ea1ba76325222fa62.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0d/60/f3/cb1ec531f46a588ea1ba76325222fa62.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/0d/60/f3/cb1ec531f46a588ea1ba76325222fa62.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0d/60/f3/cb1ec531f46a588ea1ba76325222fa62.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0d/60/f3/cb1ec531f46a588ea1ba76325222fa62.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/5c/5f/9e/6008664d26f9d8f611352c1ff3233943.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/5c/5f/9e/6008664d26f9d8f611352c1ff3233943.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/5c/5f/9e/6008664d26f9d8f611352c1ff3233943.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5c/5f/9e/6008