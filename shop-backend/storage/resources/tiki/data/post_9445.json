s://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":51000,"discount_rate":20,"rating_average":4.7,"review_count":36,"review_text":"(36)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/5c/2a/9a/2cdb54f9d927caa958e8b579c07516df.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":478,"all_time_quantity_sold":277,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eNếu bạn là một tín đồ của game Console thì không thể thiếu cho mình một chiếc tay cầm rồi, nhưng mà đa phần tay cầm trên thị trường đều có giá cao, với túi tiền của các bạn sinh viên có khi phải ăn mì gói vài tháng mới tiết kiệm mua được. Và đây là lý do chiếc Xbox 360 ra đời. Sản phẩm vừa đáp ứng được nhu cầu giải trí, rèn luyện kỹ năng sử dụng tay cầm chuyên nghiệp cho các game thủ, còn vừa phù hợp túi tiền của các bạn sinh viên.\u003c/p\u003e\n\u003cp\u003eTay cầm Xbox 360 dường như đã trở thành mẫu tay cầm quốc dân cho mọi nhà làm game. Ngay cả các game indie được phát triển cho PC cũng hỗ trợ đầy đủ skill. Đơn giản mẫu tay cầm Xbox 360 chính là tay cầm chơi game PC phổ biến nhất.\u003c/p\u003e\n\u003cp\u003e️Ưu điểm của sản phẩm: - Tay cầm xbox 360 cực kỳ dễ cài đặt. Kết nối qua cổng USB (gắn vào là nhận), không cần cài đặt Driver. - Hỗ trợ hầu hết các game chơi tay cầm như Fifa online các phiên bản, Pes, Devil May Cry, Crysis, Call Of Duty, các tựa game thế giới mở như GTA5, Elden ring, stray,  và còn rất nhiều tựa game nổi tiếng nữa. - Hỗ trợ rung tốt với những game có chế độ rung cho bạn trải nghiệm chơi game tuyệt đỉnh chẳng khác nào tay cầm chuyên nghiệp. - Các phím tay cầm rất êm, analog nhạy giúp bạn sử dụng skill linh hoạt mà không lo về độ trễ.\u003c/p\u003e\n\u003cp\u003e️Đặc Điểm Của Sản Phẩm:\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e Chất liệu nhựa ABS\u003c/li\u003e\n\u003cli\u003e Dùng trên nhiều thiết bị : Máy tính (PC), Laptop, Smart TV (chú ý không thích ứng với máy chơi game Xbox)\u003c/li\u003e\n\u003cli\u003e Chiều dài dây cable 2.5 Mét: Khoảng cách hợp lý sử dụng với màn hình PC\u003c/li\u003e\n\u003cli\u003e Đầu cắm USB - Dễ dàng cài đặt và tinh chỉnh trên PC (cắm vô là sử dụng)\u003c/li\u003e\n\u003cli\u003e Phù hợp với Win XP; Win Vista; Win 7,10,11\u003c/li\u003e\n\u003cli\u003eThiết kế tay nắm mới và đường nét gọn gàng hơn vào hầu hết các kích cỡ bàn tay.\u003c/li\u003e\n\u003cli\u003e Hình dáng nhỏ gọn; cầm vừa tay chắc tay giúp bạn chơi thoải mái nhiều giờ\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/5e/2d/be/fa9c16d99f6e40803d6080463c076ac5.jpg\" alt=\"\" width=\"600\" height=\"600\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/f8/d7/61/a7fb37c4a169547bfb831546f48aba18.jpg\" alt=\"\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/98/43/29/3a1c75cd2bbca4a4b21719c3cf464162.jpg\" alt=\"\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/1c/c3/4f/de789a190fac7b3c32d3b27fe4126009.jpg\" alt=\"\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/ba/29/68/ee7de37a2e1ed5853f622931