}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/43/b4/5c/d480ad091a9a0f7f61ab6cf53b69fc0f.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1514,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eNhãn hiệu LOBINNI\u003c/p\u003e\n\u003cp\u003eMã sản phẩm No.18018-1\u003c/p\u003e\n\u003cp\u003eGiới tính Nam\u003c/p\u003e\n\u003cp\u003eKiểu máy Automatic (Máy Cơ)\u003c/p\u003e\n\u003cp\u003eĐường kính mặt 41 mm\u003c/p\u003e\n\u003cp\u003eĐộ dày 11 mm\u003c/p\u003e\n\u003cp\u003eChất liệu vỏ Thép không gỉ 316L\u003c/p\u003e\n\u003cp\u003eChất liệu dây Dây da cao cấp\u003c/p\u003e\n\u003cp\u003eChất liệu mặt kính Sapphire\u003c/p\u003e\n\u003cp\u003eKhả năng chịu nước 5 ATM\u003c/p\u003e\n\u003cp\u003e----------------------------------------------\u003c/p\u003e\n\u003cdiv class=\"title_module_main heading-bar d-flex justify-content-between align-items-center\"\u003e\n\u003ch2 class=\"heading-bar__title\"\u003eĐẶC ĐIỂM NỔI BẬT\u003c/h2\u003e\n\u003c/div\u003e\n\u003cdiv class=\"rte js-product-getcontent product_getcontent pos-relative\"\u003e\n\u003cdiv class=\"content js-content\"\u003e\n\u003cp\u003eĐỒNG HỒ NAM CHÍNH HÃNG LOBINNI NO.18018 - KHAO KHÁT CỦA GIỚI MÊ ĐỒNG HỒ TẦM GIÁ TRUNG\u003c/p\u003e\n\u003cp\u003e\u003ciframe src=\"https://www.youtube.com/embed/gwfK6DEhgEQ\" width=\"800\" height=\"400\" frameborder=\"0\" scrolling=\"no\"\u003e\u003c/iframe\u003eLuôn làm hài lòng các quý ông thời đại, siêu phẩm lần này của nhà Lobinni tiếp tục làm SAY LÒNG khách hàng không chỉ bởi diện mạo tinh tế, sang trọng mà còn là tinh hoa chế tác tuyệt vời.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://bizweb.dktcdn.net/100/472/501/files/dong-ho-nam-lobinni-no-18018-chinh-hang-1.jpg?v=1670755170892\" alt=\"dong-ho-nam-lobinni-no-18018-chinh-hang-1.jpg?v=1670755170892\" /\u003e\u003c/p\u003e\n\u003cp\u003eỔ CỬA SỔ SUN\u0026amp;MOON độc đáo làm điểm nhấn hoàn hảo cho phần mặt đồng hồ với biểu tượng Nhật - Nguyệt tương phùng như ôm trọn cả vòng tuần hoàn ngày đêm trên cổ tay.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://bizweb.dktcdn.net/100/472/501/files/dong-ho-nam-lobinni-no-18018-chinh-hang-2.jpg?v=1670755171652\" alt=\"dong-ho-nam-lobinni-no-18018-chinh-hang-2.jpg?v=1670755171652\" /\u003e\u003c/p\u003e\n\u003cp\u003eLịch ngày, lịch tháng cùng xuất hiện trên mặt số, nhưng điều đó không hề rối mắt mà ngược lại còn tạo nên một tổng thể ĐẬM NÉT NGHỆ THUẬT bởi từng chi tiết của LOBINNI No.18018 đều được hoàn thiện và sắp xếp cực kỳ tinh xảo.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://bizweb.dktcdn.net/100/472/501/files/dong-ho-nam-lobinni-no-18018-chinh-hang-3.jpg?v=1670755172516\" alt=\"dong-ho-nam-lobinni-no-18018-chinh-hang-3.jpg?v=1670755172516\" /\u003e\u003c/p\u003e\n\u003cp\u003eVới size mặt 41mm cùng độ dày 11m phù hợp với đại đa cổ tay của đàn ông Việt Nam.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://bizweb.dktcdn.net/100/472/501/files/dong-ho-nam-lobinni-no-18018-chinh-hang-4.jpg?v=1670755172966\" alt=\"dong-ho-nam-lobinni-no-18018-chinh-hang-4.jpg?v=1670755172966\" /\u003e\u003c/p\u003e\n\u003cp\u003ePhần vỏ được gia công bằng chất liệu thép không gỉ 316L, đồng thời tạo hình cong đem đến những hình ảnh 3D nhờ hiệu ứng thị giác.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://bizweb.dktcdn.net/100/472/501/files/dong-ho-nam-lobinni-no-18018-chinh-hang-5.jpg?v=1670755173639\" alt=\"dong-ho-nam-lobinni-no-18018-chinh-hang-5.jpg?v=1670755173639\" /\u003e\u003c/p\u003e\n\u003cp\u003eCông nghệ PVD giữ cho màu bền và đẹp hơn, không tổn hại đến da tay của bạn.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://bizweb.dktcdn.net/100/472/501/files/dong-ho-nam-lobinni-no-18018-chinh-hang-6.jpg?v=1670755174732\" alt=\"dong-ho-nam-lobinni-no-18018-chinh-hang-6.jpg?v=1670755174732\" /\u003e\u003c/p\u003e\n\u003cp\u003eDây da chính hãng được làm từ da thật, cùng với đó là khóa bướm dập logo thương hiệu cực kỳ ấn tượng. \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://bizweb.dktcdn.net/100/472/501/files/dong-ho-nam-lobinni-no-18018-chinh-hang-7.jpg?v=1670755175420\" alt=\"dong-ho-nam-lobinni-no-18018-chinh-hang-7.jpg?v=1670755175420\" /\u003e\u003c/p\u003e\n\u003cp\u003eMặt kính Sapphire chống trầy xước và tạo độ hiển thị sắc nét.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://bizweb.dktcdn.net/100/472/501/files/dong-ho-nam-lobinni-no-18018-chinh-hang-8.jpg?v=1670755176151\" alt=\"dong-ho-nam-lobinni-no-18018-chinh-hang-8.jpg?v=1670755176151\" /\u003e\u003c/p\u003e\n\u003cp\u003eMặt đáy nhìn xuyên bộ máy với nhiều vây xoáy được chạm khắc tinh xảo.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://bizweb.dktcdn.net/100/472/501/files/dong-ho-nam-lobinni-no-18018-chinh-hang-9.jpg?v=1670755176810\" alt=\"dong-ho-nam-lobinni-no-18018-chinh-hang-9.jpg?v=1670755176810\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://bizweb.dktcdn.net/100/472/501/files/dong-ho-nam-lobinni-no-18018-chinh-hang-10.jpg?v=1670755177457\" alt=\"dong-ho-nam-lobinni-no-18018-chinh-hang-10.jpg?v=1670755177457\" /\u003e\u003cimg src=\"https://bizweb.dktcdn.net/100/472/501/files/dong-ho-nam-lobinni-no-18018-chinh-hang-11.jpg?v=1670755178360\" alt=\"dong-ho-nam-lobinni-no-18018-chinh-hang-11.jpg?v=1670755178360\" /\u003e\u003cimg src=\"https://bizweb.dktcdn.net/100/472/501/files/dong-ho-nam-lobinni-no-18018-chinh-hang-12.jpg?v=1670755179159\" alt=\"dong-ho-nam-lobinni-no-18018-chinh-hang-12.jpg?v=1670755179159\" /\u003e\u003cbr /\u003eTrái tim mạnh m