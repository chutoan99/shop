=\"\" src=\"https://salt.tikicdn.com/ts/tmp/41/82/c9/c520b4a49fe6ef711494c9334d9d0c37.png\" alt=\"\" width=\"750\" height=\"1193\" /\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/de/c2/0b/cd8107d36bb71b329980f1c167fdd9e0.png\" alt=\"\" width=\"750\" height=\"1194\" /\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/b7/4a/b6/e7de856322afffdd8796ce3dedb433ba.png\" alt=\"\" width=\"750\" height=\"1193\" /\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/6d/1f/0a/1441d7c6a6db744d80fb243e330aaf32.png\" alt=\"\" width=\"750\" height=\"1194\" /\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/01/f5/6e/d57d1635bae78ebc96941be448a449a1.png\" alt=\"\" width=\"750\" height=\"1194\" /\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/ac/7a/44/a534c5b8c644be4704d8dd2508f8db0c.png\" alt=\"\" width=\"750\" height=\"1193\" /\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/29/52/e8/10037fd3230807a1ceb457756b8f8cb2.jpg\" alt=\"\" width=\"750\" height=\"1194\" /\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/72/10/96/dab3e8ad24164bb8606b6372defc99aa.png\" alt=\"\" width=\"750\" height=\"74\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cspan style=\"font-size:10.5pt;font-family:\u0026#39;roboto\u0026#39;;color:#242424\"\u003eĐặc điểm nổi bật :\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cspan style=\"font-size:10.5pt;font-family:\u0026#39;roboto\u0026#39;;color:#242424\"\u003eKhung giường được thiết kế từ vật liệu sắt sơn tỉnh điện cho màu sơn bền, đẹp.\u003c/span\u003e\u003c/li\u003e\u003cli\u003e\u003cspan style=\"font-size:10.5pt;font-family:\u0026#39;roboto\u0026#39;;color:#242424\"\u003eNệm được chế tạo từ chất liệu nệm bọt biển với mật độ cao êm ái chống lún\u003c/span\u003e\u003c/li\u003e\u003cli\u003e\u003cspan style=\"font-size:10.5pt;font-family:\u0026#39;roboto\u0026#39;;color:#242424\"\u003eGường có 4 lớp chính: lớp ga,lớp đệm,lớp phản gỗ,lớp khung chịu tải\u003c/span\u003e\u003c/li\u003e\u003cli\u003e\u003cspan style=\"font-size:10.5pt;font-family:\u0026#39;roboto\u0026#39;;color:#242424\"\u003eGiường gấp có phần đầu nâng được 5 cấp khác nhau từ 0 độ đến 90 độ.\u003c/span\u003e\u003c/li\u003e\u003cli\u003e\u003cspan style=\"font-size:10.5pt;font-family:\u0026#39;roboto\u0026#39;;color:#242424\"\u003eGiường xếp di động nâng đầu có phần khung làm bằng thép sơn tĩnh điện, nối với nhau bằng bản lề nên có thể gấp gọn\u003c/span\u003e\u003c/li\u003e\u003cli\u003e\u003cspan style=\"font-size:10.5pt;font-family:\u0026#39;roboto\u0026#39;;color:#242424\"\u003eĐệm giường được làm từ bọt biển có mật độ cao giúp tăng độ đàn hồi và hấp thu lực tốt\u003c/span\u003e\u003c/li\u003e\u003cli\u003e\u003cspan style=\"font-size:10.5pt;font-family:\u0026#39;roboto\u0026#39;;color:#242424\"\u003eGiường gấp hai khúc đặc biệt còn có thể để dáng ngồi tựa như ghế sofa.\u003c/span\u003e\u003c/li\u003e\u003cli\u003e\u003cspan style=\"font-size:10.5pt;font-family:\u0026#39;roboto\u0026#39;;color:#242424\"\u003eChân giường gấp cấu tạo gồm 4 bánh xe giúp di chuyển dễ dàng.\u003c/span\u003e\u003c/li\u003e\u003cli\u003e\u003cspan style=\"font-size:10.5pt;font-family:\u0026#39;roboto\u0026#39;;color:#242424\"\u003eĐồng thời có cấu tạo chốt an toàn định vị. Đầu giường có thể nâng lên hạ xuống rất tiện dụng trong lúc đọc sách, thư giãn hoặc bệnh nhân trong điều trị được bác sĩ chỉ định nằm cao đầu\u003c/span\u003e\u003c/li\u003e\u003c/ul\u003e\n\u003ch5\u003e\u003cstrong\u003eThông tin chi tiết :\u003c/strong\u003e\u003c/h5\u003e\n\u003cul\u003e\u003cli style=\"text-align:justify;background:#ffffff;word-spacing:0px\"\u003e\u003cspan style=\"font-size:10.5pt;font-family:\u0026#39;roboto\u0026#39;;color:#242424\"\u003eKích thước mở ra: 27x193x90cm\u003c/span\u003e\u003c/li\u003e\u003cli style=\"text-align:justify;background:#ffffff;word-spacing:0px\"\u003e\u003cspan style=\"font-size:10.5pt;font-family:\u0026#39;roboto\u0026#39;;color:#242424\"\u003eKích thước gập gọn: 110x21x90cm\u003c/span\u003e\u003c/li\u003e\u003cli style=\"text-align:justify;background:#ffffff;word-spacing:0px\"\u003e\u003cspan style=\"font-size:10.5pt;font-family:\u0026#39;roboto\u0026#39;;color:#242424\"\u003eGiường gấp đôi\u003c/span\u003e\u003c/li\u003e\u003cli style=\"text-align:justify;background:#ffffff;word-spacing:0px\"\u003e\u003cspan style=\"font-size:10.5pt;font-family:\u0026#39;roboto\u0026#39;;color:#242424\"\u003eChân đỡ có 2 thanh ngang và 4 chân trụ bánh xe đỡ phần giữa giường(khu vực chịu tải trọng lớn nhất)\u003c/span\u003e\u003c/li\u003e\u003cli style=\"text-align:justify;background:#ffffff;word-spacing:0px\"\u003e\u003cspan style=\"font-size:10.5pt;font-family:\u0026#39;roboto\u0026#39;;color:#242424\"\u003eKhi gập gọn 4 chân đỡ bánh xe giúp di chuyển giường thuận tiện hơn\u003c/span\u003e\u003c/li\u003e\u003cli style=\"text-align:justify;background:#ffffff;word-spacing:0px\"\u003e\u003cspan style=\"font-size:10.5pt;font-family:\u0026#39;roboto\u0026#39;;color:#242424\"\u003eGiường ngủ gấp văn phòng có thể tùy chỉnh được độ ngả theo ý muốn\u003c/span\u003e\u003c/li\u003e\u003cli style=\"text-align:justify;background:#ffffff;word-spacing:0px\"\u003e\u003cspan style=\"font-size:10.5pt;font-family:\u0026#39;roboto\u0026#39;;color:#242424\"\u003eGiường ngủ có 4 lớp chính\u003c/span\u003e\u003c/li\u003e\u003cli style=\"text-align:justify;background:#ffffff;word-spacing:0px\"\u003e\u003cspan style=\"font-size:10.5pt;font-family:\u0026#39;roboto\u0026#39;;color:#242424\"\u003eKhung kim loại hợp kim chịu lực được phủ sơn tĩnh điện bảo vệ\u003c/span\u003e\u003c/li\u003e\u003c/ul\u003e\n\u0