:20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.6,"review_count":53,"review_text":"(53)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/12/75/82/a18a2a8d6f3cc800746615a57f298a51.JPG","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1936,"all_time_quantity_sold":250,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp class=\"MsoNormal\" style=\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; line-height: 15.75pt;\"\u003e\u003cstrong\u003e\u003cspan style=\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; color: black;\"\u003ePhin nhôm Trung Nguyên hoa văn Trống Đồng\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\" style=\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; text-align: justify; line-height: 15.75pt;\"\u003e\u003cstrong\u003e\u003cem\u003e\u003cspan style=\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; color: black;\"\u003eVăn hóa cà phê từ lâu đã gắn liền với hình ảnh của những hạt cà đỏ mọng, của mùi hương ngào ngạt vừa thơm nồng lại chan chát và đặc biệt là của những chiếc phin nhôm hoa văn Trống Đồng thấm đượm văn hòa người Việt xưa.\u003c/span\u003e\u003c/em\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\" style=\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; text-align: justify; line-height: 15.75pt;\"\u003e\u003cspan style=\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; color: black;\"\u003eĐể tạo nên một tách cà phê hoàn hảo đúng điệu, không thể thiếu vai trò của những chiếc phin cà phê. Loại phin phổ biến để pha cà phê hiện nay là Phin nhôm với chất liệu vừa phải để giữa cà phê được thơm nóng sau khi pha chế.\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\" style=\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; line-height: normal;\"\u003e\u003cspan style=\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; color: black;\"\u003eCà Phê Trung Nguyên sau nhiều năm được thành lập không chỉ nhằm mục đích kinh doanh mà còn được xem là sứ giả giúp bảo tồn và mở rộng văn hóa cà phê đến với khách hàng trên cả nước và quốc tế. Sản phẩm \u003cstrong\u003ephin nhôm Trung Nguyên hoa văn Trống Đồng\u003c/strong\u003e với thiết kế đẹp mắt cùng ý nghĩa đặc biệt luôn hứa hẹn sẽ đem đến tách cà phê tuyệt hảo cho những tín đồ ưa thích thức uống này. \u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\" style=\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; text-align: justify; line-height: 15.75pt;\"\u003e \u003c/p\u003e\n\u003cp class=\"MsoNormal\" style=\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; text-align: justify; line-height: 15.75pt;\"\u003e\u003cstrong\u003e\u003cspan style=\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; color: black;\"\u003eNguồn gốc của ý tưởng phin nhôm Trung Nguyên hoa văn Trống Đồng:\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\" style=\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; text-align: justify; line-height: 15.75pt;\"\u003e\u003cspan style=\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; color: black;\"\u003eÝ tưởng phin nhôm Trung Nguyên hoa văn Trống Đồng được xuất phát từ sự giao thoa văn hóa giữa văn hóa truyền thống của người Việt và văn hóa cà phê Tây Nguyên.\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\" style=\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; text-align: justify; line-height: 15.75pt;\"\u003e\u003cspan style=\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; color: black;\"\u003eXuất phát từ hình ảnh Trống Đồng Đông Sơn được in dập nổi trên nắp phin nhôm cùng chất liệu hoàn hảo để tạo nên tách cà phê lý tưởng cho những tín đồ mong muốn thưởng thức trọn vẹn vị cà phê chuẩn Tây Nguyên.\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\" style=\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; text-align: justify; line-height: 15.75pt;\"\u003e \u003c/p\u003e\n\u003cp class=\"MsoNormal\" style=\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; text-align: justify; line-height: 15.75pt;\"\u003e\u003cstrong\u003e\u003cspan style=\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; color: black;\"\u003eThiết kế phin nhôm Trung Nguyên hoa văn Trống Đồng -  Điểm nhấn nghệ thuật hóa cho sản phẩm:\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\" style=\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; text-align: justify; line-height: 15.75pt;\"\u003e\u003cspan style=\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; color: black;\"\u003eThói quen uống cà phê truyền thống là phải giữ nguyên phin cà phê trên ly và chờ từng giọt cà phê rơi xuống. Những giọt cà phê thể hiện sự tinh túy và vất vả của người dân lao động trong khi chăm sóc và nuôi dưỡng cây cà phê.\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\" style=\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; text-align: justify; line-height: 15.75pt;\"\u003e\u003cspan style=\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; color: black;\"\u003eVới thiết kế giữ nguyên hình dáng truyền thống của một chiếc phin nhôm và phá cách ở các nếp dập nổi hoa văn Trống Đồng, những người thưởng thức cà phê sẽ có thể dễ dàng cảm nhận cái nghệ thuật ở bên trong tách cà phê của mình, đồng thời, hồi tưởng lại những vẻ đẹp văn hóa đặc sắc của người dân đất Việt.\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\" style=\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; text-align: justify; line-height: 15.75pt;\"\u003e \u003c/p\u003e\n\u003cp class=\"MsoNormal\" style=\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; text-align: justify; line-height: 15.75pt;\"\u003e\u003cstrong\u003e\u003cspan style=\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; color: #0a0a0a;\"\u003eCách pha chế cà phê phin ngon và đúng kỹ thuật theo chuẩn Trung Nguyên\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\" style=\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; text-align: justify; line-height: 15.75pt;\"\u003e\u003cspan style=\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; color: #0a0a0a;\"\u003eBước 1: Chuẩn bị Nguyên liệu và công cụ dụng cụ - Nước pha cần sử dụng nước tinh khiết có độ PH = 7 - Bột cà phê còn hạn sử dụng và đảm bảo vệ sinh toàn thực phẩm, được bảo quản trong hũ thủy tinh. - Một bộ cốc tách cà phê - Bình đun siêu tốc \u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\" style=\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; text-align: justify; line-height: 15.75pt;\"\u003e\u003cspan style=\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; color: #0a0a0a;\"\u003eBước 2: Định lượng Trộn đều cà phê trước khi cho vào phin, sử dụng 20 - 25 gram bột cà phê cho một phin cà phê chuẩn \u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\" style=\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; text-align: justify; line-height: 15.75pt;\"\u003e\u003cspan style=\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; color: #0a0a0a;\"\u003eBước 3 San phẳng, lắc và gõ nhẹ vào thân phin loại bỏ không khí thừa và khoảng trống trong lòng bụng phin \u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\" style=\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; text-align: justify; line-height: 15.75pt;\"\u003e\u003cspan style=\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; color: #0a0a0a;\"\u003eBước 4: - Loại bỏ cặn, dùng ngón tay vuốt nhẹ dưới đáy thân phin, hạn chế hạt cà phê lọt vào tách - Đặt thân phin lên nắp phin \u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\" style=\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; text-align: justify; line-height: 15.75pt;\"\u003e\u003cspan style=\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; color: #0a0a0a;\"\u003eBước 5: Sử dụng 20ml nước sôi đảm bảo nhiệt độ từ 92 - 98 độ C, rót vào nắp cà phê và ủ cà phê trong vòng 20 giây Tác dụng: Giúp cho bột cà phê thấm đều nước sôi và nở nhẹ, tránh hiện tượng sốc nhiệt, cà phê ổn định, cân bằng áp suất, cà phê sẽ không bị trào khi rót nước lần 2. Dùng ngón tay chạm nhẹ vào tim gài trước khi sang bước 7 \u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\" style=\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; text-align: justify; line-height: 15.75pt;\"\u003e\u003cspan style=\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; color: #0a0a0a;\"\u003eBước 6: Sử dụng 50-60 ml nước sôi rót trực tiếp lên tim gài hoặc rót xung quanh tim gài để nước sôi ngấm đều Lưu ý: Khi rót nước lần 2, sau 15 - 20 giây giọt cà phê đầu tiên sẽ rơi xuống tách, trong trường hợp giọt cafe chưa rơi xuống tách, chúng ta nên xử lý bằng cách dùng muỗng inox nhỏ gạt nhẹ dưới đáy phin\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\" style=\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; text-align: justify; line-height: 15.75pt;\"\u003e\u003cspan style=\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; color: #0a0a0a;\"\u003eBước 7:Thành phẩm, thời gian nhỏ giọt của tách cafe theo tiêu chuẩn là từ 7-8 phút. Kết thúc quá trình nhỏ giọt thu được: - 30-35ml dung dịch cà phê cho cà phê đen đá, sữa đá và sữa nóng. - 40 - 45ml cho cà phê đen nóng, sử dụng 20ml sữa đặc cho cà phê sữa nóng và cà phê sữa đá, sử dụng 4g đường tinh khiết cho cà phê đen nóng và đen đá \u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\"\u003e\u003cspan style=\"font-size: 12.0pt; line-height: 107%; font-family: 'Times New Roman',serif;\"\u003e \u003c/span\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/12/75/82/a18a2a8d6f3cc800746615a57f298a51.JPG","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/12/75/82/a18a2a8d6f3cc800746615a57f298a51.JPG","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/12/75/82/a18a2a8d6f3cc800746615a57f298a51.JPG","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/12/75/82/a18a2a8d6f3cc800746615a57f298a51.JPG","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/12/75/82/a18a2a8d6f3cc800746615a57f298a51.JPG"},{"base_url":"https://salt.tikicdn.com/ts/product/71/63/cb/85fc7ab1babae028713eee8d3a1f2d62.JPG","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/ca