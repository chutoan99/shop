"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":62000,"discount_rate":20,"rating_average":3,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/9f/6a/15/2de1fbaf83a296082625dcd2315e193e.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":817,"all_time_quantity_sold":22,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cdiv class=\"ToggleContent__View-sc-1dbmfaw-0 wyACs\"\u003e\n\u003cdiv\u003e\n\u003cp\u003e\u003cstrong\u003eTRUNG THU TẶNG SÁCH - CÙNG CON GIỮ NÉT TRUYỀN THỐNG THEO CÁCH MỚI\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eTrung thu tưng bừng - Vui mừng đón trăng về với #set_sách_độc_quyền phát hành bởi Lionbooks!\u003c/p\u003e\n\u003cp\u003e\u003cem\u003eThay vì là những món đồ chơi, bánh kẹo thường thấy hàng năm, tại sao năm nay SÁCH chủ đề Trung thu lại là lựa chọn hàng đầu để tặng con vào mùa trăng năm nay?\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003eSách chủ đề Trung thu mở ra một thế giới vừa thân thương, vừa hấp dẫn với đầy những điều mới lạ với bất cứ em bé nào!\u003c/p\u003e\n\u003cp\u003eSách là người bạn đồng hành tuyệt vời để cùng con lan tỏa niềm vui với bạn bè, ba mẹ, ông bà thông qua hoạt động cùng nhau đọc sách.\u003c/p\u003e\n\u003cp\u003eSách Trung thu mang lại vô vàn giá trị tích cực, không chỉ mở mang thế giới của con mà còn giúp con thêm yêu và trân trọng những giá trị truyền thống, lưu giữ chúng bằng cách khám phá của riêng con.\u003c/p\u003e\n\u003cp\u003eTiết kiệm tối đa vì có thể tái sử dụng nhiều lần, anh chị em cùng đọc với nhau, chia sẻ lại cho các bạn nhỏ khác.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eHỘP QUÀ KỂ CHUYỆN TRUNG THU CÓ GÌ?\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/3c/51/6d/2bfd9bd9c82eea269220f2d20ac96cb7.jpg\" alt=\"hộp quà trung thu\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCuốn “Chuyện mùa Trăng”\u003c/strong\u003e - Sách bìa cứng song ngữ Việt Anh với phong cách minh họa bằng màu nước vừa mới mẻ, vừa nghệ thuật, chắc chắn sẽ khiến cả những người lớn yêu Tết Trung thu say mê trước vẻ đẹp của làng Hồng Đỏ.\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/64/46/11/66404aeadc0101c22876740f89f3474c.jpg\" alt=\"\" width=\"750\" height=\"749\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/e1/fc/97/7c54ec874c9589b868af9552e462f40a.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/61/cb/5e/46c91720c31a409e17f35313342a8825.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/bc/11/6c/c68f9b09d155393ca71e7dd253765733.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/9f/b2/08/3048d9fc92330a71928c612d79471bc5.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/f2/e5/54/4053be3b4f8d17f2345553902835f0f9.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCuốn “Đủng đỉnh trăng đi”:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Nếu là một bạn nhỏ yêu thơ ca, chắc chắn con không thể bỏ qua cuốn sách thơ kết hợp cùng âm nhạc mang tên “Đủng đỉnh trăng đi” này! Từng câu thơ về hành trình vui chơi của bạn Trăng kết hợp với các bài hát chủ đề Trung thu chắc chắn sẽ khiến nhiều độc giả nhí say mê!\u003c/p\u003e\n\u003cp\u003e- Mỗi bài hát trong trang sách đều có gắn mã QR code dẫn tới bản thu âm được thực hiện bởi lời ca trong trẻo, đáng yêu để cả nhà có thể nghe đi nghe lại nhiều lần!\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/68/14/19/896236735801859801ac9c02bf53c6b4.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/f2/1f/5e/4b2359f231cce21d6d3a03533c2f1745.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/91/ef/04/7e60c6c31f95c8dae35e4048ee14da48.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/1f/22/e6/927ba6f7315ab371f00b7f54f4a7b093.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/fc/55/ec/d4fc0e781bfa6caa0144f7e789bfd438.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/07/d6/34/b5282f02ed1f956ea5708666cc78856e.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/af/55/4e/96b5b0356b7dad18f75ca8dba0ce7bd9.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/08/01/80/c7a3f04a56255d776119e26d3e1cba3d.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eTặng kèm cuốn ngoại truyện giới thiệu nhân vật làng Hồng Đỏ và sự tích đêm Trung thu.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/8c/1e/dc/b6e96d348f7baccfa635f448e4e1e31b.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\