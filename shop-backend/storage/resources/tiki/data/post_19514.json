800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/a1/77/27/02cb60472b4ecf22b75257bdf80d8155.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":847,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\nQuạt sạc SUNHOUSE SH7116 có thiết kế nhỏ gọn, thời trang, sở hữu pin sạc Lithium chất lượng cao bền bỉ, sạc nhanh, đặc biệt giúp quạt có thể hoạt động liên tục trong thời gian tới 10 giờ trên một lần sạc(*). Quạt có 3 tốc độ gió cùng chế độ quay đảo chiều, làm mát nhanh và rộng chắc chắn sẽ là sản phẩm “nhỏ mà có võ” không thể thiếu trong mùa hè này. \n\n\nTHIẾT KẾ NHỎ GỌN – TIỆN LỢI\nKiểu dáng nhỏ gọn, thời trang\n\nQuạt sạc SUNHOUSE SHD7116 sở hữu vẻ ngoài nhỏ nhắn, thời trang, giúp bạn dễ dàng mang theo khi đi du lịch, sử dụng mọi lúc mọi nơi. Chất liệu nhựa cao cấp bền màu, hạn chế trầy xước. Chân đế vững chắc, bạn có thể đặt quạt ngay ngắn trên bàn làm việc, bàn học….Không chỉ có chức năng làm mát, với gam màu xanh ngọc tinh tế, SUNHOUSE SHD7116 còn như một vật trang trí xinh xắn cho không gian làm việc học tập của bạn.\nTùy chỉnh xoay lên xuống tiện dụng\n\nPhần lồng quạt được thiết kế để có thể dễ dàng xoay quay lên trên hoặc chéo xuống thấp quanh trục cố định, nhờ vậy bạn có thể tùy chỉnh hướng gió mà không cần thay đổi vị trí đặt quạtCổng sạc Micro-USB tiện lợi\n\nQuạt sử dụng cổng sạc Micro-USB tiện lợi, giúp bạn dễ dàng, nhanh chóng sạc điện cho quạt. Đây cũng là loại cổng sạc vô cùng phổ biến, bạn có thể dễ dàng tìm kiếm ở bất kì đâu nếu không may có quên bộ sạc cho quạt ở nhà. \n\n\nGIẢI PHÁP LÀM MÁT HIỆU QUẢ\nPin sạc Lithium chất lượng, sạc điện nhanh, tuổi thọ cao\n\nQuạt sạc SUNHOUSE SH7116 sử dụng pin sạc Lithium chất lượng cao, bền bỉ nên bạn có thể hoàn toàn yên tâm sử dụng lâu dài. So sánh với các pin sạc thông thường, pin sạc của SUNHOUSE SHD7116 có thể sạc nhanh gấp 2 lần, tuổi thọ cao gấp 5 lần.Khi được sạc đầy, quạt có thể làm mát liên tục đến 10 giờ (khi quạt hoạt động ở tốc độ thấp), giúp làm mát hiệu quả khi ở ngoài trời, những khi mất điện hay giúp làm thông thoáng không khí khi bạn phải ở trong môi trường kín, đông người.(*) Tuy nhiên, bạn cần lưu ý, để gia tăng tuổi thọ của quạt và đảm bảo an toàn, bạn không được vừa sạc vừa sử dụng quạt, tốt nhất nên sạc đầy rồi mới sử dụng nhé.\n3 tốc độ gió, tùy chỉnh linh hoạt\n\nQuạt có 3 tốc độ gió để bạn có thể tùy chỉnh linh hoạt theo nhu cầu sử dụng và nhiệt độ môi trường xung quanh. Công suất quạt 25W, gió tản đều, động cơ hoạt động êm ái, mang đến sự thư thái cho bạn và người thân.Quay đảo chiều làm mát nhanh và rộng\n\nSUNHOUSE SHD7116 được trang bị thêm tính năng Quay đảo chiều nhờ vậy có thể làm mát không gian rộng hơn. Tính năng này cũng giúp gió phân tán, phù hợp cho đối tượng là trẻ nhỏ có hệ hô hấp yếu.\nTích hợp đèn ngủ 2 trong 1 tiện lợi\nĐược trang bị thêm đèn LED phía trước, SUNHOUSE SHD7116 vừa làm mát hiệu quả, vừa hô biến thành một chiếc đèn ngủ xinh xắn. Không chỉ thế, riêng chế độ sáng quạt cũng có đến 2 chế độ để bạn tùy chỉnh vô cùng tiện lợi.\n\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://sal