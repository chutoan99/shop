png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/6d/bf/b2/b9adc9f241a96388c21e5c80c9200e8e.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1359,"all_time_quantity_sold":4,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eBÍ ẨN CỦA NƯỚC\u003c/p\u003e\n\u003cp\u003eGiải mã sự kỳ diệu của nước sống\u003c/p\u003e\n\u003cp\u003eNước sống và nước bình thường khác nhau ra sao? Vì sao hiểu về nước cũng là hiểu sâu sắc về chính mình, về hành tinh Trái Đất và xa hơn chính là gốc rễ của Đại đạo Tự nhiên?\u003c/p\u003e\n\u003cp\u003eNước có ở khắp mọi nơi, cả bên trong lẫn bên ngoài cơ thể chúng ta. Dù vậy, chúng ta vẫn chưa thật sự hiểu về nước. Nước chiếm 70% cơ thể con người, đồng thời cũng chiếm 70% thể tích Trái đất. Cho đến nay, Trái đất (nên đặt tên là Thủy cầu, thay vì địa cầu) là hành tinh duy nhất mà chúng ta biết có tồn tại sự sống. Chính vì vậy, tìm hiểu kỹ hơn về nước cũng là cách để chúng ta hiểu hơn về chính mình, về hành tinh mà ta đang sinh sống và xa hơn nữa chính là Đại đạo Tự nhiên.\u003c/p\u003e\n\u003cp\u003eNước ẩn chứa những bí ẩn của thuộc tính Mẹ trong mọi sự sinh sôi, thành – trụ - hoại – diệt của tất cả chủng loài trên trái đất. Nước cũng là nguồn sống quan trọng nhất của cơ thể vật lý chúng ta và cũng là nền tảng tự nhiên nhất của những hoạt động tự nhiên của con người từ ăn uống, tình dục, sinh nở, tìm về nước để trị liệu… và thậm chí nghiên cứu về nước, quan sát sự chuyển động của nước cũng khiến con người ngộ ra đạo lý, huyền thuật, võ thuật, khoa học và thậm chí cả trong một số công nghệ quan trọng của nhân loại.\u003c/p\u003e\n\u003cp\u003eVậy nước có chứa những bí ẩn gì?\u003c/p\u003e\n\u003cp\u003eBí ẩn của nước - Sự kỳ diệu của nước sống là hành trình khám phá các yếu tố tạo nên sự sống của nước hoặc được giải phóng bởi nước. Suốt nhiều thế kỷ, các học giả đã dùng mọi cách để tìm hiểu bản chất và nguồn gốc của nước. Nước là nhân tố quan trọng, quyết định sự xuất hiện của loài Homo Sapiens, tạo tiền đề cho sự hình thành xã hội loài người. Về cơ bản, các đại dương là một chiếc nôi lớn và ẩm ướt mà trong đó những sinh vật thông minh được nuôi dưỡng và phát triển. Từ lúc còn là phôi thai, phát triển thành bào thai đến khi chào đời, con người trải qua chín tháng đầu đời trong môi trường nước ối, giống như cá sống trong nước mặn. Vì vậy, một khi đã tìm hiểu về nước, chúng ta không thể bỏ qua vai trò của nước đối với sức khỏe.\u003c/p\u003e\n\u003cp\u003eThời gian gần đây, chúng ta thường nghe thấy khái niệm “nước sống” qua các phương tiện truyền thông đại chúng. Vậy nước sống là gì? Nước sống khác với nước thường ra sao? Ngoài uống đủ nước hằng ngày, chúng ta còn phương pháp “trị liệu” nào khác từ nước không để mang lại cho cơ thể nguồn năng lượng tốt nhất? Tất cả sẽ được giải đáp trong Bí ẩn của nước - Sự kỳ diệu của nước sống.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eVề tác giả\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003ePaolo Consigli là một bác sĩ và nhà tâm lý học điều trị bằng phương pháp y học tổng thể kết hợp châm cứu. Ông đang công tác khám chữ bệnh tại Thành phố Milan (Ý) và giảng dạy tại Hiệp hội Đông y châu Âu.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/6d/bf/b2/b9adc9f241a96388c21e5c80c9200e8e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/6d/bf/b2/b9adc9f241a96388c21e5c80c9200e8e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/6d/bf/b2/b9adc9f241a96388c21e5c80c9200e8e.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6d/bf/b2/b9adc9f241a96388c21e5c80c9200e8e.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6d/bf/b2/b9adc9f241a96388c21e5c80c9200e8e.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/c2/3e/f7/00398e22d7b55575235a538c1c0b97a3.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c2/3e/f7/00398e22d7b55575235a538c1c0b97a3.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c2/3e/f7/00398e22d7b55575235a538c1c0b97a3.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c2/3e/f7/00398e22d7b55575235a538c1c0b97a3.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c2/3e/f7/00398e22d7b55575235a538c1c0b97a3.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/8e/ae/f2/1f4d91504ea2755d3a3bc5c752734bd2.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/8e/ae/f2/1f4d91504ea2755d3a3bc5c752734bd2.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/8e/ae/f2/1f4d91504ea2755d3a3bc5c752734bd2.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8e/ae/f2/1f4d91504ea2755d3a3bc5c752734bd2.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8e/ae/f2/1f4d91504ea2755d3a3bc5c752734bd2.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/74/ba/9c/99f76f3b9cb60d340289011e85089645.jpg","is_gallery":true,"label":null,"large_url":"