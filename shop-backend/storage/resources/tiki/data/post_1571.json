à nam tính, để gợi nhớ về sự đam mê trong tình yêu. Biểu tượng đầu Medusa ở giữa chai và họa tiết Hy Lạp như một vị thần canh giữ những thành phần quý giá bên trong và đặt mùi hương này thành tâm điểm của thế giới Versace.\u003c/p\u003e\n\u003cp\u003eNổi bật tại trung tâm, bằng vàng, chính là thương hiệu: Versace Eros Flame .\u003c/p\u003e\n\u003cp\u003eĐầu Medusa, một biểu tượng đặc trưng của Versace lần này xuất hiện trên nắp vàng như một viên ngọc quý, biểu tượng đại diện cho sức mạnh có thể vượt qua mọi giới hạn của thời gian.\u003c/p\u003e\n\u003cp\u003eThiết kế hộp ngoài tái hiện những đặc điểm nổi bật của chai bên trong: đầu Medusa và họa tiết Hy Lạp trên nền đỏ rực rỡ - một biểu tượng nam tính không thể nhầm lẫn\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/8d/5c/fe/f9f442e1fa961eb37a311b69e2ad5bf6.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/8d/5c/fe/f9f442e1fa961eb37a311b69e2ad5bf6.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/8d/5c/fe/f9f442e1fa961eb37a311b69e2ad5bf6.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8d/5c/fe/f9f442e1fa961eb37a311b69e2ad5bf6.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8d/5c/fe/f9f442e1fa961eb37a311b69e2ad5bf6.jpg"}],"warranty_policy":null,"brand":{"id":223635,"name":"Versace","slug":"versace"},"current_seller":{"id":40786,"sku":"5576329817698","name":"Rosa Perfume","link":"https://tiki.vn/cua-hang/rosa-perfume","logo":"3e/99/67/a9c8b85e45561502767cf8023c529867.jpg","price":1600000,"product_id":"42990968","store_id":39803,"is_best_store":false,"is_o