oại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/c8/5b/9c/f6f408fa87646d417dfc9ef02bd84027.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c8/5b/9c/f6f408fa87646d417dfc9ef02bd84027.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c8/5b/9c/f6f408fa87646d417dfc9ef02bd84027.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c8/5b/9c/f6f408fa87646d417dfc9ef02bd84027.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c8/5b/9c/f6f408fa87646d417dfc9ef02bd84027.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/e3/e9/22/1e9a11e528fedb624b7f467824811b25.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e3/e9/22/1e9a11e528fedb624b7f467824811b25.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e3/e9/22/1e9a11e528fedb624b7f467824811b25.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e3/e9/22/1e9a11e528fedb624b7f467824811b25.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e3/e9/22/1e9a11e528fedb624b7f467824811b25.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/32/e0/50/e01b450c988f59347de7d186bd43be5a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/32/e0/50/e01b450c988f59347de7d186bd43be5a.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/32/e0/50/e01b450c988f59347de7d186bd43be5a.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/32/e0/50/e01b450c988f59347de7d186bd43be5a.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/32/e0/50/e01b450c988f59347de7d186bd43be5a.jpg"},{"base_ur