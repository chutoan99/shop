ount":6,"review_text":"(6)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/2a/68/19/cd2233d2fd4eab656e8b448a62c5b162.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1086,"all_time_quantity_sold":109,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eHũ đựng tăm (lọ đựng tăm)\u003c/strong\u003e sứ Long Phương là sản phẩm được sử dụng phổ biến tại Việt Nam bởi văn hóa dùng tăm sau bữa cơm của người Việt. Hiểu được nhu cầu của khách hàng, Long Phương luôn đổi mới và cải tiến để có thể đáp ứng được thị hiếu ngày càng cao của người dân. \u003c/p\u003e\n\u003cp\u003eSản phẩm sứ trắng cao cấp được sản xuất và phân phối trực tiếp bởi công ty Long Phương. \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ab/80/eb/d5bbeb5e000f2228be961399f57b9e4e.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eTHÔNG SỐ SẢN PHẨM\u003c/strong\u003e\u003c/h2\u003e\n\u003ctable style=\"width: 596px;\"\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd style=\"width: 127.469px;\"\u003e\n\u003cp\u003e\u003cstrong\u003eTên sản phẩm\u003c/strong\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style=\"width: 452.531px;\"\u003eỐng tăm bầu sứ Long Phương Hủ đựng tăm bằng sứ\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd style=\"width: 127.469px;\"\u003e\n\u003cp\u003e\u003cstrong\u003eTên thương hiệu\u003c/strong\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style=\"width: 452.531px;\"\u003e\n\u003cp\u003eLONG PHUONG \u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd style=\"width: 127.469px;\"\u003e\n\u003cp\u003e\u003cstrong\u003eMàu sắc\u003c/strong\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style=\"width: 452.531px;\"\u003eTrắng\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd style=\"width: 127.469px;\"\u003e\u003cstrong\u003eKích thước\u003c/strong\u003e\u003c/td\u003e\n\u003ctd style=\"width: 452.531px;\"\u003e5.1*8.5 cm\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd style=\"width: 127.469px;\"\u003e\u003cstrong\u003ePhù hợp cho\u003c/strong\u003e\u003c/td\u003e\n\u003ctd style=\"width: 452.531px;\"\u003e\n\u003cp\u003eGia đình/Tiệc/ nhà hàng \u0026amp; Khách sạn/ Ngoài trời/Tiệc cưới \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\n\u003ch3\u003eChi tiết về kích thước sản phẩm Ống tăm bầu sứ Long Phương\u003c/h3\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/3b/bf/f0/cba81d735e87bc012563165bfd3f8c26.jpg\" alt=\"\" width=\"682\" height=\"387\" /\u003e\u003c/p\u003e\n\u003ch2 style=\"text-align: center;\"\u003eTẠI SAO NÊN SỬ DỤNG SẢN PHẨM ỐNG TĂM BẦU SỨ LONG PHƯƠNG?\u003c/h2\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/62/80/28/a822f4f6e4dd728f0b3a46824405eacb.jpg\" width=\"750\" height=\"300\" /\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eAn toàn\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eSản phẩm \u003cstrong\u003ekhông chứa chì\u003c/strong\u003e và cadium nên rất toàn cho sức khỏe người dùng. \u003c/p\u003e\n\u003cp\u003eSứ Long Phương được đốt ở nhiệt độ 1380 độ C với công nghệ nung 2 lần tiên tiến, giúp loại bỏ hết các độc tố trong đất, tạo nên một sản phẩm tinh túy và đặc biệt an toàn. \u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eTiện lợi\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eCác sản phẩm hũ, bình, lọ, của Long Phương đều có khả năng chịu sốc nhiệt tốt, và có thể sử dụng trong hầu hết các máy gia dụng như: lò vi sóng, lò nướng, máy rửa chén giúp cuộc sống trở nên tiện lợi và việc dọn dẹp trở nên dễ dàng hơn.\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eChất lượng\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eSứ trắng Long Phương có độ bền cao, chất sứ dai đanh chứ không giòn nên khó bể mẻ hay trầy xước. Điều này giúp các gia đình có con nhỏ yên tâm sử dụng sản phẩm Long Phương hơn. \u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eThẩm mỹ\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003eSản phẩm được làm tỉ mỉ trong tất cả các công đoạn. Bề mặt sản phẩm nhẵn mịn, lớp men sáng bóng, không phai màu. \u003c/p\u003e\n\u003cp\u003eLong Phương sử dụng công nghệ in đốt chuyển nhiệt, vì thế men của sản phẩm cũng rất bền, có thể sử dụng trong thời gian dài nhưng vẫn giữ được độ trắng sáng. \u003c/p\u003e\n\u003ch2 style=\"text-align: center;\"\u003e\u003cstrong\u003eMỘT SỐ HÌNH ẢNH SẢN PHẨM \u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/ab/80/eb/84ab885ce4b878aeeec79216a17a1d3d.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/ab/80/eb/84ab885ce4b878aeeec79216a17a1d3d.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/bc/b0/42/a47a3413e0d4ce19882eef848ecf0caa.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/bc/b0/42/a47a3413e0d4ce19882eef848ecf0caa.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch2 style=\"text-align: center;\"\u003e\u003cstrong\u003eMUA ỐNG TĂM BẦU BẰNG SỨ - HỦ ĐỰNG TĂM BẰNG SỨ  Ở ĐÂU?\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003eỐng tăm nhựa hiện nay rất phổ biến, tuy nhiên khá đại trà và không có sự khác biệt. Nếu bạn là người ưa thích sự tinh tế, chắc hẳn các sản phẩm sứ trắng của Long Phương sẽ làm bạn mê mẩn. \u003c/p\u003e\n\u003cp\u003eLong Phương với 20 năm kinh nghiệm sản xuất, liên tục tạo ra các sản phẩm mới lạ, bắt kịp xu hướng và nhu cầu của người tiêu dùng, mang đến những sản phẩm sứ gia dụng an toàn, chất lượng, và thiết kế sang trọng, tinh tế.\u003c/p\u003e\n\u003cp\u003eLong Phương cung cấp rất nhiều chủng loại sứ gia dụng khác nhau như: tô, thố, âu, bộ đồ ăn, bộ ấm chén, quà tặ\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/bc/6b/f6/d57a8b0d342cc4867e7cf98dd57b930f.jpg\" alt=\"\" width=\"750\" height=\"458\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/2a/68/19/cd2233d2fd4eab656e8b448a62c5b162.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/2a/68/19/cd2233d2fd4eab656e8b448a62c5b162.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/2a/68/19/cd2233d2fd4eab656e8b448a62c5b162.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2a/68/19/cd2233d2fd4eab656e8b448a62c5b162.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2a/68/19/cd2233d2fd4eab656e8b448a62c5b162.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/ab/80/eb/98eaa0e1393d4c9511070e21cda06d4c.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ab/80/eb/98eaa0e1393d4c9511070e21cda06d4c.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ab/80/eb/98eaa0e1393d4c9511070e21cda06d4c.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ab/80/eb/98eaa0e1393d4c9511070e21cda06d4c.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ab/80/eb/98eaa0e1393d4c9511070e21cda06d4c.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/bc/b0/42/8709f2217474c5e27e84634c5eda46cf.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/bc/b0/42/8709f2217474c5e27e84634c5eda46cf.jpg","medium_ur