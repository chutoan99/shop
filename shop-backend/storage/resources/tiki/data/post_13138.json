t.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/aa/f7/95/49719db94e0684555fa163a10c6d558d.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1374,"all_time_quantity_sold":5,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eTHỦY TINH CƯỜNG LỰC\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eKÍN HƠI\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eThủy tinh không chứa BPA\u003c/p\u003e\n\u003cp\u003eNắp đậy có gioăng silicon và 4 khóa kín\u003c/p\u003e\n\u003cp\u003eTúi giữ nhiệt có thể giữ nóng hoặc giữ lạnh\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eBộ 2 Hộp Thủy Tinh Glasslock Lunch40-67K \u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eGồm hộp thủy tinh 400ml và hộp thủy tinh 670ml chia ngăn kèm túi giữ nhiệt tiện lợi\u003c/strong\u003e,\u003c/p\u003e\n\u003cp\u003egiúp bạn có thể lưu trữ thức ăn khi đi ra ngoài như: đi học, đi làm hoặc đi dã ngoại, Sản phẩm được làm từ chất liệu thủy tinh trong suốt, dày dặn thuộc thương hiệu Glasslock đến từ Hàn Quốc, chuyên sản xuất các sản phẩm thủy tinh cường lực cao cấp.\u003c/p\u003e\n\u003cp\u003eGiữ thức ăn không bị đổ ra ngoài và giúp bảo quản thực phẩm, rau quả tươi lâu hơn, nhờ được cách ly không khí. Sản phẩm sẽ mang lại sự tinh tế và sang trọng cho bạn khi sử dụng.\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eHộp Glasslock được làm từ chất liệu thủy tinh cường lực, trong suốt và siêu bền, chịu được va chạm và khó bị vỡ. Sau thời gian dài\u003c/li\u003e\n\u003cli\u003eHộp thủy tinh Glasslock chịu được nhiệt độ đến 120 độ C, nên bạn có thể sử dụng thoải mái trong lò vi sóng, mà không lo bị rạng nứt hay vỡ.\u003c/li\u003e\n\u003cli\u003eĐi kèm với bộ hộp thủy tinh là túi giữ nhiệt tiện lợi, bạn có thể giữ ấm thức ăn khi đi ra ngoài, như đi học, đi làm, đi picnic,… đều rất thuận tiện. Túi giữ nhiệt được thiết kế vuông vức, cùng màu đỏ nổi bật, đẹp mắt, ngoài dùng để chứa hộp thức ăn còn mang lại tính thẩm mỹ cao.\u003c/li\u003e\n\u003cli\u003eVới chất liệu thủy tinh, bạn có thể dễ dàng chùi rửa. Thiết kế nhỏ gọn, bạn có thể xếp chồng 3 hộp lên nhau khi đặt trong tủ lạnh, hoặc xếp gọn gàng trên giá chén, mà không chiếm nhiều diện tích.\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/aa/f7/95/49719db94e0684555fa163a10c6d558d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/aa/f7/95/49719db94e0684555fa163a10c6d558d.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/aa/f7/95/49719db94e0684555fa163a10c6d558d.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/aa/f7/95/49719db94e0684555fa163a10c6d558d.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/aa/f7/95/49719db94e0684555fa163a10c6d558d.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/8a/03/4b/125d408a1413bb2d6b9f89d2c088af7e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w120