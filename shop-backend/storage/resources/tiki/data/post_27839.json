ang đầu đường xó chợ, chịu vô số uất ức, hiểu lầm, sỉ nhục bên cạnh những người cùng cực nhất trong xã hội. Những tình huống éo le, dở khóc dở cười cũng từ đó xuất hiện, đi kèm với không ít nhưng rắc rối khác. Liệu rằng Edward có trở về được với ngai vàng của mình và Tom có kết cục ra sao?\u003c/span\u003e\u003c/p\u003e\n\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/5d/5e/8e/6c50dbbbca66bc09baa39f0bdee89717.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/5d/5e/8e/6c50dbbbca66bc09baa39f0bdee89717.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/5d/5e/8e/6c50dbbbca66bc09baa39f0bdee89717.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5d/5e/8e/6c50dbbbca66bc09baa39f0bdee89717.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5d/5e/8e/6c50dbbbca66bc09baa39f0bdee89717.png"}],"warranty_policy":null,"current_seller":{"id":281062,"sku":"5969822367446","name":"Bamboo Books","link":"https://tiki.vn/cua-hang/bamboo-books","logo":"46/9a/b3/e4fbfd97e7607ea4d2ff8e9ad769121b.jpg","price":99000,"product_id":"205807344","store_id":268132,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[{"id":248554,"name":"aacboks","link":"https://tiki.vn/cua-hang/aacboks","logo":"https://vcdn.tikicdn.com/ts/seller/0c/9a/49/95e22e34ab8150aaa1bd9b0c3937aad1.jpg","price":72500,"product_id":"274998949","store_id":235586}],"specifications":[{"name":"Thông tin chung","attributes":[{"code":"publisher_vn","name":"Công ty phát hành","value":"Đinh Tị"},{"code":"book_cover","name":"Loại bìa","value":"Bìa mềm"},