dth":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":91000,"discount_rate":36,"rating_average":4.7,"review_count":20,"review_text":"(20)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/7a/6e/6e/686e29bf198adfd25c509e4b46bb1f3d.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2051,"all_time_quantity_sold":126,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003eKem Sâm Dưỡng Ẩm Và Trắng Da My Gold Korea Red Ginseng White Cream\u003c/strong\u003e được làm từ hồng sâm sâm kết hợp với những dưỡng chất chiết xuất từ dâu tằm, Kitin, Vitamin A, E, Sodium Siloxane có tác dụng giúp cân bằng độ ẩm, cho da luôn khỏe mạnh.\u003c/li\u003e\n\u003cli\u003eĐồng thời kem giúp ngăn ngừa mụn, chống nám và tàn nhang, chống lão hóa, chống lại những tác hại do anh nắng mặt trời hoặc thời tiết khô lạnh mang lại cho bạn làn da trắng hồng và rạng ngời.\u003c/li\u003e\n\u003cli\u003eCác thành phần trong kem đều chiết xuất từ thành phần tự nhiên như dầu dừa, trà xanh, đậu nành , dâu tầm, lá salvia hoặc hoa chamomilla, đặt biết là nhân sâm. Cung cấp đầy đủ dưỡng chất và vitamin như vitamin e, b1, vitamin c … Sản phẩm được kiểm định chất lượng và độ an toàn cho da trước khi đưa ra thị trường. Ngoài ra sản phẩm được sản xuất hoàn toàn tự động theo dây chuyền khép kín và hiện đại của samsung. Nên chất lượng sản phẩm đồng đều, ít lỗi và được kiểm tra chất lượng sau cùng trước khi đưa ra thị trường.\u003c/li\u003e\n\u003cli\u003eNhân sâm giúp làm mịn , trắng da an toàn và hiệu quả, ngoài ra kem sâm hàn quốc còn dưỡng ẩm rất tốt, giúp làn da khô mịn và khỏe hơn và cân bằng dầu nhờn trên da. Chức năng chính của kem là dưỡng trắng da tự nhiên, giàm nhờn , khô da, chống lão hóa , xe khít và mịn da, giảm các vết thâm, nám, làm đều màu da. Điểm vượt trội của kem sâm my gold ginseng so với các loại kem khác là bổ sung tinh chất nhân sâm, một dược liệu quý vô giá cho làn da.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eHướng dẫn sử dụng\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eRửa thật sạch mặt bằng nước.\u003c/li\u003e\n\u003cli\u003eSau đó lau khô, rồi lấy một lượng vừa đủ không quá dày, thoa lên vùng tráng, hai bên má rồi tan đều ra khuôn mặt. Ngủ qua đêm , sáng dậy rửa lại bằng nước sạch.\u003c/li\u003e\n\u003cli\u003eLưu ý, phải để kem tối thiểu ba mươi phút rồi mới rửa lại với nước. Thời gian trên 30 phút giúp kem đủ thẩm thấu đều vào da, giúp tác dụng hiệu quả cao.\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/7a/6e/6e/686e29bf198adfd25c509e4b46bb1f3d.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/7a/6e/6e/686e29bf198adfd25c509e4b46bb1f3d.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/7a/6e/6e/686e29bf198adfd25c509e4b46bb1f3d.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7a/6e/6e/686e29bf198adfd25c509e4b46bb1f3d.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7a/6e/6e/686e29bf198adfd25c509e4b46bb1f3d.png"},{"base_url":"https://salt.tikicdn.com/ts/product/2d/04/00/14ee0d06d95275acfad1885609787600.jpg","is_g