n phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/94/52/9c/a3c177d92f46cbd7fffe9a11d1823968.jpeg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/94/52/9c/a3c177d92f46cbd7fffe9a11d1823968.jpeg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/94/52/9c/a3c177d92f46cbd7fffe9a11d1823968.jpeg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/94/52/9c/a3c177d92f46cbd7fffe9a11d1823968.jpeg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/94/52/9c/a3c177d92f46cbd7fffe9a11d1823968.jpeg"}],"warranty_policy":null,"authors":[{"id":154258,"name":"Jougi Shiraishi","slug":"jougi-shiraishi"}],"current_seller":{"id":9908,"sku":"4183578588884","name":"AMAK BOOKS","link":"https://tiki.vn/cua-hang/amak-books","logo":"3d/55/a7/ba89e1c9843eec7b5b3efe475515805f.jpg","price":78400,"product_id":"252231459","store_id":9706,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Thông tin chung","attributes":[{"code":"publisher_vn","name":"Công ty phát hành","value":"AMAK"},{"code":"publication_date","name":"Ngày xuất bản","value":"2017-12-07 09:39:45"},{"code":"dimensions","name":"Kích thước","value":"\u003cp\u003e13 x 18 cm\u003c/p\u003e"},{"code":"dich_gia","name":"Dịch Giả","value":"Thỏ Koyuki"},{"code":"book_cover","name":"Loại bìa","value":"Bìa mềm"},{"code":"number_of_page","name":"Số trang","value":"376"},{"code":"manufacturer","name":"Nhà xuất bản","value":"Nhà Xuất Bản Dân Trí"}]}],"product_links":[],"gift_item_title":"0 quà tặng kèm","highlight":{"items":["Câu chuyện hấp dẫn và lôi cuốn.","Mô tả chi tiết về thế giới p