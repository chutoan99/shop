type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":108000,"discount_rate":24,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/92/01/02/56f3cff0c4d71774da945104c6939e93.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":80,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eMáy nướng bánh mì là sản phẩm không thể thiếu trong gia đình bạn, nó sẽ giúp hâm nóng và làm giòn bánh mì, làm cho các lát bánh giòn tan, vàng đều hai mặt và có mùi hương thơm bột cực kỳ hấp dẫn.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/fe/2c/7a/992b893c252e16b1269a992cca2e1e6e.jpg\" alt=\"\" width=\"553\" height=\"550\" /\u003e\u003c/p\u003e\n\u003cp\u003eMáy nướng bánh mì với chức năng chính là nướng bánh sandwich, bánh hot dog, làm các món ăn nhẹ đầy đủ dinh dưỡng\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/bf/5f/6f/92c81275357eb2da0b6607df450ee4fa.jpg\" alt=\"\" width=\"550\" height=\"545\" /\u003e\u003c/p\u003e\n\u003cp\u003eMáy được trang bị 2 bề mặt khuôn nướng, cùng lúc nướng được cả hai mặt giúp tiết kiệm thời gian chế biến.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/11/4d/04/99b2ce1c3b8cce1fcb330955b865f7cf.jpg\" alt=\"\" width=\"545\" height=\"554\" /\u003e\u003c/p\u003e\n\u003cp\u003eTÍNH NĂNG NỔI BẬT CỦA MÁY NƯỚNG BÁNH MÌ:\u003c/p\u003e\n\u003cp\u003e- Nướng bánh nhanh chóng: Bạn chỉ cần nướng từ 3 – 5 phút để có thể hoàn thành 4 chiếc bánh nướng xinh xắn, thơm lừng.\u003c/p\u003e\n\u003cp\u003e- Nhiệt tỏa đều 2 mặt: Giúp bạn nướng bánh chín đều mà không cần lật bánh mì.\u003c/p\u003e\n\u003cp\u003e- Khuôn máy chống dính tốt, không lo bánh dính vào khuôn khi nướng.\u003c/p\u003e\n\u003cp\u003e- Trên khuôn bánh còn có những họa tiết tạo hình càng làm cho món ăn ngon mắt hơn.\u003c/p\u003e\n\u003cp\u003e- Bánh nướng chín đều, có màu vàng, không bị cháy.\u003c/p\u003e\n\u003cp\u003e- Máy Nướng Bánh Mì có hệ thống rơ le tự cảm biến nhiệt.\u003c/p\u003e\n\u003cp\u003e- Trên tay cầm, nhà sản xuất bố trí khóa chốt an toàn, giúp giữ hai nắp của khuôn bánh ép chặt vào nhau khi nướng.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/71/c9/7f/573390b617e4c58cc2e9ffa3218ce82a.jpg\" alt=\"\" width=\"741\" height=\"681\" /\u003e\u003c/p\u003e\n\u003cp\u003eTHÔNG SỐ KĨ THUẬT CỦA MÁY NƯỚNG BÁNH MÌ  :\u003c/p\u003e\n\u003cp\u003e- Chất liệu: Nhựa ABS, hợp kim\u003c/p\u003e\n\u003cp\u003e- Dòng điện: 220V - 50Hz\u003c/p\u003e\n\u003cp\u003e- Công suất: 750W\u003c/p\u003e\n\u003cp\u003e- Kích thước: 22x22x7 cm\u003c/p\u003e\n\u003cp\u003e- Cân nặng: 0.6kg\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/c2/1b/2b/24e7a01f38cf4e3b9f85e0881cd0daa8.jpg\" alt=\"\" /\u003e\u003c/p\u003e\n\u003cp\u003eBộ phận tay cầm được làm bằng nhựa cách nhiệt, cố định với thân máy rất chắc chắn, người dùng dễ dàng thực hiện các thao tác nâng lên đặt xuống và trở mặt bánh chín đều mà không lo bị bỏng.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/e9/32/98/9474748c6f1728e4518ead73db46f050.jpg\" alt=\"\" width=\"748\" height=\"417\" /\u003e\u003c/p\u003e\n\u003cp\u003eBề mặt khuôn nướng được phủ lớp chống dính cao cấp, dễ dàng lấy bánh ra sau khi chế biến xong, vệ sinh đơn giản, đảm bảo an toàn sức khỏe, thuận tiện khi sử dụng Khuôn nướng chống dính từ hợp kim nhôm phủ Ceramic, vỏ inox, thiết kế nhỏ gọn và trang nhã phù hợp với mọi không gian bếp.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/62/d0/3c/5156a240a25a4c158976f17d4904a1ee.jpg\" alt=\"\" width=\"750\" height=\"420\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/92/01/02/56f3cff0c4d71774da945104c6939e93.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/92/01/02/56f3cff0c4d71774da945104c6939e93.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/92/01/02/56f3cff0c4d71774da945104c6939e93.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/92/01/02/56f3cff0c4d71774da945104c6939e93.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/92/01/02/56f3cff0c4d71774da945104c6939e93.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/be/2b/39/4fa404f145ab0c1c34dd4bdcc09c1cdf.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/be/2b/39/4fa404f145ab0c1c34dd4bdcc09c1cdf.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/be/2b/39/4fa404f145ab0c1c34dd4bdcc09c1cdf.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/be/2b/39/4fa404f145ab0c1c34dd4bdcc09c1cdf.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/be/2b/39/4fa404f145ab0c1c34dd4bdcc09c1cdf.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/17/3f/c5/ddbf283d4efe38c925b853b49093f65e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200