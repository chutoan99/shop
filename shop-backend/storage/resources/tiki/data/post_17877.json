ourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/media/catalog/product/8/9/8930003001457-001.u2683.d20160725.t131252.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2754,"all_time_quantity_sold":17,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: medium; color: #008ab7;\"\u003e\u003cstrong\u003eBộ Trà Trúc Gốm Sứ Bát Tràng T548 H\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eBộ Trà Trúc Gốm Sứ Bát Tràng T548 H\u003c/strong\u003e\u003cstrong\u003e \u003c/strong\u003elà sản phẩm thể hiện sự khéo léo và tài hoa của các nghệ nhân, mang tính nghệ thuật cao. Bộ ấm trà không chỉ dùng đáp ứng mục đích sử dụng thông thường, bạn còn có thể sử dụng để trang trí hoặc làm món quà tặng ý nghĩa cho người thân và bạn bè. Sản phẩm được làm từ chất liệu cao cấp, qua dây chuyền sản xuất hiện đại, đảm bảo chất lượng tốt nhất cho người tiêu dùng.\u003c/p\u003e\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eThông tin sản phẩm\u003c/strong\u003e\u003c/p\u003e\u003cp style=\"text-align: justify;\"\u003e- Loại sản phẩm: Bộ ấm trà.\u003c/p\u003e\u003cp style=\"text-align: justify;\"\u003e- Thương hiệu: Gốm Sứ Bát Tràng.\u003c/p\u003e\u003cp style=\"text-align: justify;\"\u003e- Xuất xứ: Việt Nam.\u003c/p\u003e\u003cp style=\"text-align: justify;\"\u003e- Chất liệu: Gốm sứ cao cấp, chất men sáng bóng, chịu nhiệt tốt, độ bền cao.\u003c/p\u003e\u003cp style=\"text-align: justify;\"\u003e- Thiết kế:\u003c/p\u003e\u003cp style=\"text-align: justify;\"\u003e+ Ấm trà có thiết kế tinh tế, tay cầm chắc chắn. Tách trà và các đĩa lót có màu sắc và họa tiết đồng bộ tạo nên bộ sản phẩm hoàn hảo.\u003c/p\u003e\u003cp style=\"text-align: justify;\"\u003e+ Hoa văn hình lá trúc màu xanh nổi bật trên nước men trắng sáng bóng được vẽ tỉ mỉ, vô cùng tinh xảo nhờ bàn tay tài hoa của các nghệ nhân.\u003c/p\u003e\u003cp style=\"text-align: justify;\"\u003e+ Sản phẩm phù hợp với không gian nội thất hiện đại lẫn truyền thống.\u003c/p\u003e\u003cp style=\"text-align: justify;\"\u003e- Bộ sản phẩm gồm: 1 ấm trà, 6 tách, 7 đĩa lót.\u003c/p\u003e\u003cp style=\"text-align: justify;\"\u003e- Màu sắc: Trắng.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/media/catalog/product/8/9/8930003001457-001.u2683.d20160725.t131252.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/8/9/8930003001457-001.u2683.d20160725.t131252.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/8/9/8930003001457-001.u2683.d20160725.t131252.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/8/9/8930003001457-001.u2683.d20160725.t131252.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/8/9/8930003001457-001.u2683.d20160725.t131252.jpg"},{"base_url":"https://salt.tikicdn.com/media/catalog/product/8/9/8930003001457-002.u2683.d20160725.t131252.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/8/9/8930003001457-002.u2683.d20160725.t131252.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/8/9/8930003001457-002.u2683.d20160725.t131252.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/20