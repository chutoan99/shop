ng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/media/catalog/product/d/s/dsc_00.u5618.d20171010.t161617.375009_2.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/d/s/dsc_00.u5618.d20171010.t161617.375009_2.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/d/s/dsc_00.u5618.d20171010.t161617.375009_2.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/d/s/dsc_00.u5618.d20171010.t161617.375009_2.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/d/s/dsc_00.u5618.d20171010.t161617.375009_2.jpg"},{"base_url":"https://salt.tikicdn.com/media/catalog/product/d/s/dsc_0006.u5618.d20171010.t161617.411699_2.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/d/s/dsc_0006.u5618.d20171010.t161617.411699_2.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/d/s/dsc_0006.u5618.d20171010.t161617.411699_2.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/d/s/dsc_0006.u5618.d20171010.t161617.411699_2.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/d/s/dsc_0006.u5618.d20171010.t161617.411699_2.jpg"},{"base_url":"https://salt.tikicdn.com/media/catalog/product/d/s/dsc_0007.u5618.d20171010.t161617.443198_2.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/d/s/dsc_0007.u5618.d20171010.t161617.443198_2.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/d/s/dsc_0007.u5618.d20171010.t161617.443198_2.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/d/s/dsc_0007.u5618.d20171010.t161617.443198_2.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/d/s/dsc_0007.u5618.d20171010.t161617.443198_2.jpg"}