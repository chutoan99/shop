:null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"defective_product"}},"discount":700000,"discount_rate":28,"rating_average":5,"review_count":36,"review_text":"(36)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ac/84/fe/9941e8129ac8ec4c44cb43850ece839e.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1275,"all_time_quantity_sold":73,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/ac/84/fe/9d5f01644240e26352f175f407adb358.jpg\" alt=\"\" width=\"750\" height=\"533\" /\u003e\u003c/p\u003e\n\u003cp\u003eNam tính và tự tin, \u003cstrong\u003eVersace Eros Eau De Parfum\u003c/strong\u003e là một loại nước hoa có sự kết hợp các tầng hương gỗ, phương Đông và tươi mới. Sự kết hợp hài hòa và tinh tế đã tạo ra một loại nước hoa nam mạnh mẽ gợi nhớ đến thần Eros - vị thần tình yêu. Donatella Versace cho biết: “Tôi đã hình dung ra một người đàn ông - một anh hùng đầy đam mê gần giống như là một vị thần Hy Lạp. Hương thơm được tạo thành từ những nốt hương thể hiện sự hấp dẫn và quyền lực, một sức mạnh tột độ”.\u003c/p\u003e\n\u003cp\u003eHương đầu: Quả quýt và chanh Ý, tinh dầu bạc hà, kẹo táo\u003cbr /\u003eHương giữa: Hoa phong lữ, tinh chất cây xô thơm Clary, hổ phách\u003cbr /\u003eHương cuối: Gỗ tuyết tùng và Virginia, Tinh chất cỏ Vetiver Orpur, Tinh chất hoắc hương Coeur Orpour, Gỗ đàn hương, Vani\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/5a/56/50/afa43cc6eb749c0296b4bd65cfca253a.jpg\" alt=\"\" width=\"750\" height=\"756\" /\u003e\u003c/p\u003e\n\u003cp\u003eMasculine and confident, the Eros Eau de Parfum is a sensual fragrance that fuses woody, oriental and fresh notes, creating a powerful perfume that evokes Eros - the god of love. \"I envisioned an heroic, passionate man, almost a Greek God. The fragrance is made up of notes that express sensuality and power, an extreme force,\" says Donatella Versace.\u003cbr /\u003eTop: Italian lemon and mandarin, mint oil, candied apple\u003cbr /\u003eHeart: Geranium flower, Clary sage essence, ambermax\u003cbr /\u003eBase: Cedarwood and Virginia, Vetiver Orpur essence, Patchouli Coeur Orpour essence, sandalwood, vanilla\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ac/84/fe/9941e8129ac8ec4c44cb43850ece839e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ac/84/fe/9941e8129ac8ec4c44cb43850ece839e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ac/84/fe/9941e8129ac8ec4c44cb43850ece839e.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ac/84/fe/9941e8129ac8ec4c44cb43850ece839e.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ac/84/fe/9941e8129ac8ec4c44cb43850ece839e.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/00/85/c2/c9847c61e8d5ac78ba2ffee3596eb799.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/00/85/c2/c9847c61e8d5ac78ba2ffee3596eb799.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/00/85/c2/c9847c61e8d5ac78ba2ffee3