con_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":174000,"discount_rate":26,"rating_average":5,"review_count":3,"review_text":"(3)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/83/af/29/9c4b8dd3d0b64c5be73bb8eb28cca580.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":872,"all_time_quantity_sold":46,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eGiới thiệu, Chất liệu, Đặc điểm nổi bật, Công dụng, Hướng dẫn sử dụng, Hướng dẫn bảo quản, Lưu ý sử dụng, Khuyến cáo, Tối thiểu 5 ảnh , độ phân giải 1000 x 1000 pixel\u003c/p\u003e\n\u003ch3\u003eGiới thiệu\u003c/h3\u003e\n\u003cp\u003e\u003cstrong\u003eGhế gội đầu cho bé Holla HL-03151\u003c/strong\u003e là phiên bản mới nhất 2022 của thương hiệu Holla với rất nhiều cải tiến vợt trội mang tới một lựa chọn tuyệt vời cho trẻ. Không chỉ thay đổi về thiết kế để bé dễ nằm, ba mẹ dễ gội mà ghế còn có thể sử dụng được cho trẻ nhỏ từ độ tuổi sơ sinh. Bên cạnh đó, ghế gội đầu HL-03151 còn có trọng lượng nhẹ hơn rất nhiều so với phiên bản cũ chỉ 2.8kg. Tính năng gấp gọn giúp tiết kiệm tối đa diện tích trong nhà sau khi bé sử dụng gội đầu. Holla mang tới cho ba mẹ 2 màu xanh và cam để lựa chọn cho bé.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/product/e3/d1/f5/b05ba21b61894a939438e80d8e3f6d1b.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch3\u003eChất liệu\u003c/h3\u003e\n\u003cp\u003eGhế gội đầu cho bé Holla HL-03151 được làm từ chất liệu nhựa PP cao cấp, một loại nhựa được chứng nhận an toàn không chứa chất độc hại và được phép sử dụng trong công nghiệp sản xuất đồ dùng cho bé. Đặc biệt, đây là chất liệu rất thân thiện với môi trường do đó là sản phẩm an toàn cho trẻ khi sử dụng.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/product/69/01/45/43509b83e8f510dffb1795cb741b4011.jpg\" alt=\"\" width=\"750\" height=\"751\" /\u003e\u003c/p\u003e\n\u003ch3\u003eĐặc điểm nổi bật\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eMột điểm đáng kể là thiết kế của ghế đã được điều chỉnh để bé dễ nằm và ba mẹ dễ gội. Điều này giúp tạo sự tiện lợi và thoải mái khi sử dụng.\u003c/li\u003e\n\u003cli\u003eĐặc biệt, ghế còn có thể sử dụng cho trẻ nhỏ từ độ tuổi sơ sinh. Điều này thực sự là một điểm mạnh vượt trội so với các sản phẩm khác trên thị trường.\u003c/li\u003e\n\u003cli\u003eBề mặt ghế được làm nhẵn cùng chi tiết đều được thiết kế bo tròn và không chứa các cạnh sắc đảm bảo cho bé thoải mái tiếp xúc mà không gây tổn thương tới da bé.\u003c/li\u003e\n\u003cli\u003ePhần đệm gối đầu của ghế với lớp bên trong là mút xốp êm ái đàn hồi tốt, còn lớp bên ngoài được làm bằng chất liệu da PU tổng hợp không mùi và an toàn cho bé.\u003c/li\u003e\n\u003cli\u003eChân ghế dày dặn, chắc chắn với phần đế chống trơn trượt giữ cho ghế không bị xê dịch khi gội đầu.\u003c/li\u003e\n\u003cli\u003eVới tính năng điều chỉnh được độ nông và sâu của phần đỡ đầu, ghế gội đầu cho bé Holla HL-0315 cho phép ba mẹ lựa chọn mức độ phù hợp với kích cỡ cơ thể cũng như độ tuổi của bé để bé có tư thế nằm thoải mái nhất.\u003c/li\u003e\n\u003cli\u003eVới 4 nấc điều chỉnh đỡ mông, trong đó nấc cao nhất phù hợp với trẻ sơ sinh, còn với trẻ lớn hơn thì tùy vào chiều cao của từng bé mà ba mẹ điều chỉnh lại khay đỡ mông và lắp vào nấc phù hợp trên ghế. \u003c/li\u003e\n\u003cli\u003eTay vịn 2 bên được bố trí ở chính giữa của ghế có tác dụng giữ cho bé luôn an toàn và không bị trượt ra ngoài khi nằm gội đầu. Và với thiết kế dạng tay bám, bé có thể nắm trực tiếp vào phần tay vịn này khi gội đầu.\u003c/li\u003e\n\u003cli\u003eVới kích thước rộng rãi đường kính 22cm và độ sâu 14cm, khay chứa không chỉ đựng được rất nhiều nước mà bố mẹ lại rất dễ dàng thao tác gội đầu cho bé. Ngoài ra, ở phía đáy của khay chứa còn có van thoát nước để dẫn trực tiếp nước thải ra ngoài. Do đó, ba mẹ có thể gội đầu cho bé trong nhà hay bất kỳ nơi nào, chỉ cần lắp thêm đường ống dẫn nước vào khay chứa rồi kéo dây dẫn ra nơi chứa nước thải là được.\u003c/li\u003e\n\u003cli\u003eTính năng gấp gọn của Ghế gội đầu cho bé Holla HL-03151 cho phép có thể cất gọn trong nhà sau khi bé gội đầu, chỉ cần một vài thao tác đơn giản là đã tiết kiệm được đáng kể diện tích trong gia đình. Một tính năng cực kỳ tiện lợi và phù hợp với nhu cầu của rất nhiều bậc phụ huynh.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/product/e3/d1/f5/b05ba21b61894a939438e80d8e3f6d1b.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch3\u003eCông dụng\u003c/h3\u003e\n\u003cp\u003eVới độ nghiêng thoai thoải cùng phần bé nằm rộng rãi, Ghế gội đầu cho bé Holla HL-03151 được sử dụng gội đầu cho bé từ sơ sinh đến 10 tuổi.\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003eHướng dẫn sử dụng\u003c/strong\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eBước 1 : Trải 1 tấm khăn bên dưới phần đỡ cổ.\u003c/li\u003e\n\u003cli\u003eBước 2 : Cho bé nằm lên ghế gội đầu\u003c/li\u003e\n\u003cli\u003eBước 2 : Điều chỉnh phần đỡ hông và chân ghế theo các mức để bé có tư thế thoải mái nhất.\u003c/li\u003e\n\u003cli\u003eBước 3 : Quấn khăn lên cổ của bé để nước không làm ướt áo của trẻ.\u003c/li\u003e\n\u003cli\u003eBước 4 : Bắt đầu làm ướt tóc và gội đầu cho bé.\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003eHướng dẫn bảo quản\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eVệ sinh sạch sẽ sản phẩm sau mỗi lần sử dụng \u003c/li\u003e\n\u003cli\u003eGấp gọn và bảo quản sản phẩm ở nơi khô ráo, tránh ánh nắng trực tiếp để không làm mất cấu trúc của nhựa dẫn đến giòn dễ vỡ và bay màu sản phẩm. \u003c/li\u003e\n\u003cli\u003eKhông ngâm ghế gội đầu trong chất tẩy rửa. \u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003eThông tin sản phẩm\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eKích thước sản phẩm: 116*38.3*27.4 cm\u003c/li\u003e\n\u003cli\u003eKích thước đóng thùng: 39*17*53cm\u003c/li\u003e\n\u003cli\u003eCân năng: 2.8 kg\u003c/li\u003e\n\u003cli\u003eMàu sắc: Xanh, Cam\u003c/li\u003e\n\u003cli\u003eLh: 0379.277.386\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/83/af/29/9c4b8dd3d0b64c5be73bb8eb28cca580.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/83/af/29/9c4b8dd3d0b64c5be73bb8eb28cca580.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/83/af/29/9c4b8dd3d0b64c5be73bb8eb28cca580.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/83/af/29/9c4b8dd3d0b64c5be73bb8eb28cca580.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/83/af/29/9c4b8dd3d0b64c5be73bb8eb28cca580.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/28/44/d4/342644883548ccc3420b89d8639eb957.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/28/44/d4/342644883548ccc3420b89d8639eb957.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/28/44/d4/342644883548ccc3420b89d8639eb957.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/28/44/d4/342644883548ccc3420b89d8639eb957.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/28/44/d4/342644883548ccc3420b89