s://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/9c/47/b4/73cc0a38edc067c4180d8ec8e776622a.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1413,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eCombo 02 Set hộp nhựa Nakaya 100ml bảo quản thức ăn trong rủ lạnh, có nắp mềm - Nội địa Nhât (04 hộp/Set):\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/c5/3b/83/925d660314d2533819fe7cacda7060e0.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/c5/3b/83/925d660314d2533819fe7cacda7060e0.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/ab/fb/c7/4c568abd8b744ba6bc8b6c4124e6681c.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/ab/fb/c7/4c568abd8b744ba6bc8b6c4124e6681c.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/26/b3/46/54e457afc0223be5f2cfc9bad2593b7c.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/26/b3/46/54e457afc0223be5f2cfc9bad2593b7c.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e* Chất liệu: \u003c/strong\u003eNhựa PP cao cấp, bền đẹp, có khả năng chịu nhiệt cao, dễ dàng vệ sinh sau khi sử dụng.\u003c/p\u003e\n\u003cp\u003eNhựa PP chứa hoạt chất CEM-Bio kháng khuẩn, không chứa BPA, chịu được nhiệt độ từ -20 đến 140 độ C, không sản sinh ra các hoạt chất gây hại trong quá trình sử dụng. Sản phẩm đạt tiêu chuẩn chất lượng của FDA (Cục quản lý Dược phẩm và Thực phẩm Hoa Kỳ). Chính vì vậy, sản phẩm luôn tuyệt đối an toàn với cả gia đình bạn.\u003c/p\u003e\n\u003cp\u003eNhựa PP là loại nhựa chống va đập rất tốt, là sản phẩm thay thế cho những hạn chế của thủy tinh.\u003cem\u003e\u003cstrong\u003e \u003c/strong\u003e\u003c/em\u003eSản phẩm khi rơi sẽ khó bị vỡ, nhẹ, không gây khó khăn hay nguy hiểm cho người sử dụng.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e* Kích thước\u003c/strong\u003e: 8,5 x 6,6 x 11,5Hcm.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e* Dung tích:\u003c/strong\u003e 100ml/hộp x 04 hộp.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e* Công dụng: \u003c/strong\u003eChuyên dùng để đựng \u0026amp; bảo quản thực phẩm trong tủ lạnh như các món dưa muối, dưa góp và các loại hạt, đồ khô, gia vị hoặc dùng để đựng thực phẩm dự trữ cho những chuyến dã ngoại, picnic,\u003c/p\u003e\n\u003cp\u003eKhả năng chịu nhiệt cao, từ -20 độ C đến 140 độ C, (nắp hộp dẻo và chịu nhiệt lên đến 70 độ C).\u003c/p\u003e\n\u003cp\u003eHoàn toàn có thể sử dụng được trong lò vi sóng, tủ lạnh, tủ đông đá,\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e* Lưu ý: \u003c/strong\u003eMở nắp hộp khi sử dụng trong lò vi sóng.\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/fd/e1/67/50ce69945ea40895ef65eb1d4919ec64.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/fd/e1/67/50ce69945ea40895ef65eb1d4919ec64.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/d3/65/eb/50b85016759678aee684b9952cbc9717.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/d3/65/eb/50b85016759678aee684b9952cbc9717.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/57/cc/d8/9e56dde8c5683075b2d0122518cd5a8f.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/57/cc/d8/9e56dde8c5683075b2d0122518cd5a8f.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/86/97/c8/e2f2a41ba5363390ee03fb0347a8933a.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/86/97/c8/e2f2a41ba5363390ee03fb0347a8933a.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eSản phẩm được thiết kế nắp gioăng silicone bảo đảm kín hơi và chống tràn không bị bay mùi thực phẩm, giữ vị tươi ngon cho thực phẩm khi bảo quản trong tủ lạnh, tủ đông tránh ám mùi sang các thực phẩm khác trong tủ.\u003c/p\u003e\n\u003cp\u003eHộp trong suốt, có vạch chia ml dễ dàng quan sát tình trạng thực phẩm ở bên trong.\u003c/p\u003e\n\u003cp\u003eThiết kế tinh tế, đẹp mắt, khả năng giữ kín hơi vượt trội!!\u003c/p\u003e\n\u003cp\u003eDễ dàng vệ sinh sau khi sử dụng.\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color: #ff0000;\"\u003e\u003cem\u003e\u003cstrong\u003eCHÚ Ý:\u003c/strong\u003e\u003c/em\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e* Để sử dụng sản phẩm một cách an toàn, Quý khách vui lòng lưu ý những nội dung sau đây:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eTránh va đập mạnh!\u003c/li\u003e\n\u003cli\u003eKhông đặt sản phẩm gần nơi có có lửa hoặc những nơi có nguồn nhiệt cao.\u003c/li\u003e\n\u003cli\u003eKhông vệ sinh, cọ rửa sản phẩm bằng những dụng cụ có thể gây tổn hại đến bề mặt của sản phẩm như: bàn chải, miếng rẻ rửa bát có các chất thô nhám hoặc miếng cọ xoong nồi bằng thé \u003c/li\u003e\n\u003cli\u003eKhông nên bọc lớp màng nylon bọc thực phẩm trên thân hộp trong thời gian dài hoặc sử dụng trong lò vi sóng, lớp màng bọc sẽ dính chặt vào thân hộp mà có thể sẽ không gỡ ra được!\u003c/li\u003e\n\u003cli\u003eXếp chồng sản phẩm lên nhau để dễ dàng bảo quản có thể sẽ gây nên vết trầy xước trên bề mặt sản phẩm, cần chú ý trước khi sử dụng!\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003e* Những điều cần biết và chú ý khi sử dụng sản phẩm trong lò vi sóng \u0026amp; ngăn đông lạnh\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eKhông hâm nóng sản phẩm \u003cstrong\u003eRỖNG\u003c/strong\u003e trong lò vi sóng\u003c/li\u003e\n\u003cli\u003eChỉ dùng sản phẩm trong lò vi sóng để rã đông, hâm nóng thức ăn, thực phẩm! \u003cstrong\u003eLưu ý\u003c/strong\u003e Mở nắp hộp khi sử dụng trong lò vi sóng (Không sử dụng với mục đích nấu ăn).\u003c/li\u003e\n\u003cli\u003eHâm nóng thức ăn có nhiều dầu (cà ri, thịt hầm, nước số) có thể là nguyên nhân làm biến dạng và đổi màu sản phẩm, cần chú ý khi sử dụng\u003c/li\u003e\n\u003cli\u003eNên chú ý cài đặt thời gian ngắn khi hâm nóng thực phẩm chứa ít nước trong lò vi sóng\u003c/li\u003e\n\u003cli\u003eNếu sử dụng sản phẩm ngay sau khi bảo quản lâu trong ngăn đông lạnh, nắp hộp có thể bị hỏng do sự chênh lệch nhiệt độ bất ngờ (hiện tượng sốc nhiệt) do đó cần để nguyên sản phẩm ở nhiệt độ thường từ 2~5 phút sau đó mở nắp để sử dụng sản phẩm được an toàn \u0026amp; lâu bền hơn\u003c/li\u003e\n\u003cli\u003eDùng sản phẩm để bảo quản kín hơi nước có ga hoặc thực phẩm lên men ở nhiệt độ thường trong thời gian dài có thể làm giảm khả năng giữ kín hơi của sản phẩm!\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eSản phẩm sản xuất theo công nghệ hiện đại của Nhật Bản cho chất lượng cao, đảm bảo các thông số an toàn kỹ thuật. Người dùng hoàn toàn yên tâm khi sử dụng.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/9