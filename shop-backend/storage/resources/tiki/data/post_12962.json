14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":9200,"discount_rate":21,"rating_average":4.5,"review_count":28,"review_text":"(28)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/af/06/8a/0f1ebb50a47a1d371b630d252cf16d09.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1897,"all_time_quantity_sold":394,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eKhăn ướt em bé Bobby là sản phẩm chăm sóc sức khỏe giúp bé yêu và cả gia đình tránh nhiễm khuẩn một cách an toàn và ưu việt. Nhờ ứng dụng công nghệ Nano Bạc thuần vật lý, đặc biệt loại bỏ nguy cơ kháng kháng sinh - hiện tượng thường gặp khi sử dụng các chất kháng khuẩn khác.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ec/90/3f/6f2151aa163b52166a3551a213e842de.png\" alt=\"\" width=\"750\" height=\"2202\" /\u003e\u003c/p\u003e\n\u003cp\u003eThông tin sản phẩm\u003cbr /\u003e- Xuất xứ : Nhật Bản\u003cbr /\u003e- Nơi sản xuất : Việt Nam\u003cbr /\u003e- Số lượng : 100 miếng\u003cbr /\u003e+ Màu xanh\u003cbr /\u003e+ Màu hồng\u003c/p\u003e\n\u003cp\u003eĐặc điểm nổi bật\u003cbr /\u003e- Được sản xuất theo công thức Siêu An Toàn, với nguyên liệu mềm mại như bông\u003cbr /\u003e- Ứng dụng công nghệ Nano Bạc giúp tăng cường khả năng chống vi khuẩn, hiệu quả với tụ cầu khuẩn vàng; đặc biệt thích hợp cho làn da nhạy cảm của bé.\u003cbr /\u003e- Công thức 99% nước tinh khiết loại bỏ vi khuẩn, vi sinh vật sống trong nước\u003cbr /\u003e- Sản phẩm được Hội sản phụ khoa Việt Nam khuyên dùng.\u003cbr /\u003e- Hương thơm nhẹ nhàng, dễ chịu.\u003cbr /\u003e- Thiết kế lá cắt giúp mẹ có thể rút từng tờ khăn ướt dễ dàng khi chỉ với một tay, đặc biệt là trong lúc thay tã cho bé.\u003cbr /\u003e- Thiết kế đáy nâng thông minh giúp lấy giấy dễ dàng đến tận tờ cuối cùng.\u003cbr /\u003e- Thiết kế đóng gói nắp đậy tiện lợi cho việc chăm sóc bé mọi lúc mọi nơi, giúp bé luôn sạch sẽ và cảm thấy mát mẻ, đặc biệt thích hợp khi thay tã hoặc khi bé đi chơi xa.\u003cbr /\u003e- Khóa ấn bảo vệ ngăn không cho nắp mở tự do.\u003cbr /\u003e- Dùng cho bé: chăm sóc và vệ sinh da, đặc biệt thích hợp khi thay tã cho bé.\u003cbr /\u003e- Dùng cho toàn thể gia đình: phù hợp cho nhiều mục đích làm sạch như tẩy trang, du lịch, thể thao,...\u003c/p\u003e\n\u003cp\u003e*Lưu ý: Không sử dụng sản phẩm trên vùng da có vết thương hở, xước, sưng tấy hay bị chàm. Không sử dụng cho vùng da niêm mạc mũi hay quanh mắt.\u003c/p\u003e\n\u003cp\u003eThông tin thương hiệu\u003c/p\u003e\n\u003cp\u003eBobby là thương hiệu nổi tiếng của công ty Diana, thuộc tập đoàn Unicharm Nhật Bản, chuyên cung cấp những sản phẩm chất lượng cao cấp dành cho trẻ em. Ra mắt thị trường Việt Nam từ năm 2003, Bobby trở thành thương hiệu tã giấy được ưa chuộng và tin dùng bởi sự sáng tạo độc đáo và đầy yêu thương dành cho trẻ em, với thiết kế các loại tã giấy màng đáy thoáng khí dạng vải, đem đến sự khô thoáng và bảo vệ làn da của các bé. Tháng 12 năm 2005, Bobby lại đi tiên phong trên thị trường Việt Nam bằng việc cải tiến sản phẩm tã giấy chống hăm 3 tác động với lõi bông siêu thấm, màng đáy thoáng khí dạng vải và tinh chất trà xanh. Sử dụng dây chuyền sản xuất hiện đại kết hợp với thế mạnh là thành viên của tập đoàn hàng đầu thế giới Unicharm Nhật Bản, công ty Diana luôn đi đầu trong việc ứng dụng các công nghệ hiện đại trong lĩnh vực sản xuất các sản phẩm chăm sóc vệ sinh cá nhân để sáng tạo ra những sản phẩm chất lượng cao Bobby là một minh chứng cho điều đó.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/af/06/8a/0f1ebb50a47a1d371b630d252cf16d09.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/af/06/8a/0f1ebb50a47a1d371b630d252cf16d09.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/af/06/8a/0f1ebb50a47a1d371b630d252cf16d09.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/af/06/8a/0f1ebb50a47a1d371b630d252cf16d09.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/af/06/8a/0f1ebb50a47a1d371b630d252cf16d09.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/3c/18/41/0b6731e5b49b5d9b2e6ab683da25fb0e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/3c/18/41/0b6731e5b49b5d9b2e6ab683da25fb0e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/3c/18/41/0b6731e5b49b5d9b2e6ab683da25fb0e.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3c/18/41/0b6731e5b49b5d9b2e6ab683da25fb0e.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3c/18/41/0b6731e5b49b5d9b2e6ab683da25fb0e.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/74/f7/f9/572818e94fdce420f38eb496ef2ec1bb.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/74/f7/f9/572818e94fdce420f38eb496ef2ec1bb.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/74/f7/f9/572818e94fdce420f38eb496ef2ec1bb.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/74/f7/f9/572818e94fdce420f38eb496ef2ec1bb.jpg","thumbnail_url":"https://salt.tikicd