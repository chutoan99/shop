on"}},"discount":0,"discount_rate":0,"rating_average":4.7,"review_count":9,"review_text":"(9)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/d8/5a/6c/3df99e019eeacbcdb6a5129622bb432d.JPG","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1490,"all_time_quantity_sold":37,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003ciframe src=\"//www.youtube.com/embed/zFcdJXscr_Q\" width=\"560\" height=\"314\" allowfullscreen=\"allowfullscreen\"\u003e\u003c/iframe\u003e\u003c/p\u003e\n\u003cp\u003eXe scooter 3 in 1 có nhạc - đèn- chòi chân là một món quà ý nghĩ và tuyệt vời nhất mà các cha mẹ dành cho các bé. Khung xe được làm từ hợp kim chống gỉ chắc chắn, tay cầm có thể điều chỉnh theo chiều cao của từng bé. Bánh xe phát sáng và có âm thanh khi bánh lăn. Tay cầm với chất liệu nhựa mềm an toàn, đàn hồi êm ái và chống trơn trượt cao.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/54/4d/e0/b4851964fb2d8def3ecf42c84fd5523e.jpg\" alt=\"\" width=\"750\" height=\"888\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/dc/8b/44/b07fb744b2bb3165095cb637dbf518e2.jpg\" alt=\"\" width=\"750\" height=\"1090\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/42/c8/79/66321f0f7852e319eadb0c0ea9f3cfad.jpg\" alt=\"\" width=\"750\" height=\"1079\" /\u003e\u003c/p\u003e\n\u003cp\u003eThiết kế ghế ngồi chắc chắn và di động, ghế ngồi dày, có thể xoay hoặc gấp lại, điều chỉnh lên cao, xuống thấp tùy chiều cao từng bé, chịu lực đến 100kg, ghế có thể chịu được 25kg. Bánh xe có đèn và âm thanh khi bánh lăn, tăng cường chống trượt và chống mài mòn.\u003c/p\u003e\n\u003cp\u00