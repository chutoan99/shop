ing_average":5,"review_count":17,"review_text":"(17)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/6a/14/35/d596e3d6d49d954fc1978540736868b5.png","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2021,"all_time_quantity_sold":58,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"margin: 15px 0px; padding: 0px; box-sizing: border-box; color: #444444; font-family: Arial, Helvetica, sans-serif; text-align: justify;\"\u003eLời Nói Đầu \u003c/p\u003e\n\u003cp style=\"margin: 15px 0px; padding: 0px; box-sizing: border-box; color: #444444; font-family: Arial, Helvetica, sans-serif; text-align: justify;\"\u003eCuốn Ngữ âm tiếng Anh Quốc tế cấp độ Trung cấp là cấp độ kế tiếp của cuốn Sách Ngữ âm cho người mới băt đầu của tác giả Lê Thị Hiệp đã được ra mắt vào tháng 6 năm 2018, giúp các học viên nhận diện các ký tự Latin Quốc tế và hàng ngàn học viên đã áp dụng thành công.\u003c/p\u003e\n\u003cp style=\"margin: 15px 0px; padding: 0px; box-sizing: border-box; color: #444444; font-family: Arial, Helvetica, sans-serif; text-align: justify;\"\u003eĐể tiếp cận với môi trường nói tiếng Anh nói nhanh, chuẩn tự ghép vần, tự biết đánh dấu trọng âm của các loại từ, các loại câu khác nhau, tự phát âm lên giống như người bản xứ.\u003c/p\u003e\n\u003cp style=\"margin: 15px 0px; padding: 0px; box-sizing: border-box; color: #444444; font-family: Arial, Helvetica, sans-serif; text-align: justify;\"\u003eTác giả Lê Thị Hiệp đồng tác giả Giáo sư, Tiến sĩ, Diễn giả Ngài Stuart Kewley đến từ Đại học Oxford tại Vương Quốc Anh kết hợp biên soạn giáo trình này nhằm hỗ trợ thúc đẩy các học viên tiếp cận với môi trường giáo dục, học tập, thương mại, kinh tế Quốc tế có sử dụng tiếng Anh một cách tự tin nhất.  Trong ấn phẩm này gồm có 3 chương, 12 bài và 3 bài ôn tập cùng các mini test để đánh giá lại kiến thức cũ đã học trước đó.\u003c/p\u003e\n\u003cp style=\"margin: 15px 0px; padding: 0px; box-sizing: border-box; color: #444444; font-family: Arial, Helvetica, sans-serif; text-align: justify;\"\u003eCuốn sách có giới thiệu sự khác biệt của tiếng Anh – Anh và Anh – Mỹ, điều này cho thấy sự đa văn hoá và đa ngôn ngữ rất thú vị. Mục đích giúp các bạn nhận diện sự giống và khác nhau về văn hoá, ngôn ngữ giữa hai Cường quốc Anh và Mỹ. Từ đó đưa ra những giải pháp tối ưu cho mục đích giao tiếp, liên kết và hợp tác. \u003c/p\u003e\n\u003cp style=\"margin: 15px 0px; padding: 0px; box-sizing: border-box; color: #444444; font-family: Arial, Helvetica, sans-serif; text-align: justify;\"\u003eChúc các bạn thành công !\u003c/p\u003e\n\u003cp style=\"margin: 15px 0px; padding: 0px; box-sizing: border-box; color: #444444; font-family: Arial, Helvetica, sans-serif; text-align: justify;\"\u003eChủ tịch AIED. Lê Thị Hiệp\u003c/p\u003e\n\u003cp style=\"margin: 15px 0px; padding: 0px; box-sizing: border-box; color: #444444; font-family: Arial, Helvetica, sans-serif; text-align: justify;\"\u003e-------------------------\u003c/p\u003e\n\u003cp style=\"margin: 15px 0px; padding: 0px; box-sizing: border-box; color: #444444; font-family: Arial, Helvetica, sans-serif; text-align: justify;\"\u003eP/s: Đối với các sản phẩm được giảm giá từ 30% trở lên miễn đổi trả, cảm ơn.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/6a/14/35/d596e3d6d49d954fc1978540736868b5.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicd