":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.5,"review_count":10,"review_text":"(10)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/1e/c9/e2/b86492fa8a71fddd82399422e58a2010.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1919,"all_time_quantity_sold":24,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e• Nón bảo hiểm 3/4 giấu kính Sunda 388 tem thuộc phân khúc nón 3/4 cao cấp của SUNDA được trang bị lớp kính giấu bên trong, có thể kéo ra giấu vào tùy theo nhu cầu sử dụng. Ngoài ra, nón còn đính kèm 3 khuy bấm phía trên mũ, giúp bạn có thể dễ dàng trang bị thêm cho nón lớp kính ngoài. Không như các loại kính cố định đi kèm mũ không thể thay đổi, các loại kính rời này có rất nhiều loại, màu sắc, và chức năng khác nhau cho bạn lựa chọn (như kính trong, kính trà, kính tráng gương, kính bạc,) và bạn có thể dễ dàng tìm mua chúng trên thị trường. Việc tháo lắp kính với mũ cũng rất đơn giản giống như bạn bấm khuy cúc áo vậy.\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e• Nón bảo hiểm 3/4 giấu kính Sunda 388 tem cũng được trang bị lớp mút dày và êm, giúp thấm hút mồ hôi tốt, êm ái khi đội. Lớp mút này có thể tháo rời để thuận tiện cho việc giặt hoặc vệ sinh. Việc tháo lắp lớp lót cũng rất dễ dàng qua các nút gài.\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e• Nón bảo hiểm 3/4 giấu kính Sunda 388 tem thu hút người đối diện nhờ kiểu dáng classic cổ điển và các hình tem đẹp mắt được in chìm bằng công nghệ cao rất bền. Kiểu dáng này làm cho người đội trông bụi bặm và \"chất\" hơn khi phối cùng với những chiếc xe tay côn hoặc xe PKL. Những chiếc mũ có kiểu classic này vẫn làm say đắm nhiều người từ hàng chục năm nay.\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e• Các sản phẩm của SUNDA (được sản xuất bởi LONGHUEI) đều có chất lượng rất tốt , đáp ứng đủ các yêu cầu khắt khe trong nước cũng như xuất khẩu đi nước ngoài. Nón có độ bền và độ bảo vệ rất cao. Lựa chọn nón bảo hiểm 3/4 giấu kính Sunda 388 tem bạn hoàn toàn có thể yên tâm ngao du trên mọi cung đường cùng với 1 chiếc nón đẹp và chất lượng.\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e• Nón bảo hiểm 3/4 giấu kính Sunda 388 tem được sản xuất bởi Công Ty TNHH LongHuei Việt Nam, là một công ty sản xuất mũ bảo hiểm với gần ba mươi năm kinh nghiệm phục vụ cho thị trường quốc tế. Các nhãn hiệu mũ của công ty tại Việt Nam: ZEUS, ANDES, SUNDA; SIMPSON, CROMO.\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e• Long Huei là công ty duy nhất tại Việt Nam có phòng thử nghiệm hiện đại, đạt tiêu chuẩn quốc tế, nhằm đảm bảo chất lượng sản phẩm đáp ứng các tiêu chuẩn an toàn của Việt Nam và quốc tế trước khi đến với người tiêu dùng. Những sản phẩm của công ty LongHuei đều đạt tiêu chuẩn Việt Nam và tiêu chuẩn “DOT, ECE,CNS,SNI,JIS” nhằm đáp ứng các yêu cầu của khách hàng và phục vụ hầu hết các thị trường quốc tế khó tính nhất.\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e• Nón bảo hiểm 3/4 giấu kính Sunda 388 tem ứng dụng công nghệ sản xuất hiện đại nhất, và sử dụng nguyên vật liệu tốt nhất để sản xuất mũ bảo hiểm với thiết kế phù hợp với người Việt Nam.\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e• Vỏ Nón: Sản phẩm mũ bảo hiểm Sunda cam kết luôn sử dụng Nhựa ABS nguyên sinh 100% được nhập khẩu từ các nhà cung ứng uy tín như Hàn Quốc, Malaysia, Thái , Nhật, chịu được độ va đập cao .\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e• Mút xốp: là bộ phận cực kỳ quan trọng để bảo vệ não bộ , hấp thụ xung động khi xảy ra tai nạn , SUNDA luôn sử dụng xốp nguyên sinh trong tất cả các sản phẩm .\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e• Vải lót cao cấp được xử lý kháng khuẩn, thấm hút tốt, mau khô, giúp hạn chế nguy cơ mắc các bệnh về tóc và da đầu. \u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e• Khóa bằng inox và dây đai chịu được lực kéo mạnh, chắc chắn, luôn bám sát vào đầu đảm bảo an toàn tốt nhất. \u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e• Quai mũ dệt 2 lớp bằng sợi tổng hợp, chịu lực kéo lực văng tốt, dễ thao tác khi sử dụng\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e• Kính âm dấu được làm từ vật liệu PC chất lượng cao, đã qua xử lý đặc biệt, cho góc quan sát rộng, hình ảnh rõ nét, trung thực, không bị chói đèn, có khả năng chống tia UV400 cực tốt tới 99%, để bạn tập trung lái xe.\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e• Mũ được sơn bằng nguyên liệu ngoại nhập, độ bền cao, chống trầy rất tốt (3 đến 5 năm). \u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e• Nón có màu sắc đa dạng, đẹp mắt, phù hợp với những người năng động, thích di chuyển và thể hiện được cá tính của mình.\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e\u003cstrong\u003e***  Hướng dẫn xác định cỡ mũ phù hợp:\u003c/strong\u003e Vòng 1 sợi dây quanh đầu, ngay phía trên lông mày và tai. Xiết sợi dây sao cho ôm vừa đủ thoải mái lấy đầu và ghi lại số đo đó. Lặp lại như vậy để tìm được số đo mà bạn thấy đầu dễ chịu nhất và sử dụng số đo đó.\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: center;\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/cd/14/c1/15cb472ee7986c3