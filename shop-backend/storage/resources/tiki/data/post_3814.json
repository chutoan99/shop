ức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/6d/b8/88/f13ef2dcff9451bfb1ddb86dd2586afa.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/6d/b8/88/f13ef2dcff9451bfb1ddb86dd2586afa.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/6d/b8/88/f13ef2dcff9451bfb1ddb86dd2586afa.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6d/b8/88/f13ef2dcff9451bfb1ddb86dd2586afa.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6d/b8/88/f13ef2dcff9451bfb1ddb86dd2586afa.png"},{"base_url":"https://salt.tikicdn.com/ts/product/a3/5e/a2/ac616371974dc04b57c93332d7bce6ca.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a3/5e/a2/ac616371974dc04b57c93332d7bce6ca.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a3/5e/a2/ac616371974dc04b57c93332d7bce6ca.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a3/5e/a2/ac616371974dc04b57c93332d7bce6ca.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a3/5e/a2/ac616371974dc04b57c93332d7bce6ca.jpg"}],"warranty_policy":null,"authors":[{"id":324343,"name":" Chu Văn Sơn ","slug":"chu-van-son-1"}],"current_seller":{"id":31023,"sku":"6409508031020","name":"Vân Sơn Garden","link":"https://tiki.vn/cua-hang/van-son-garden","logo":"a9/91/51/8b6415c0b903cc24817b73d10ad23817.png","price":129000,"product_id":"12600504","store_id":30345,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Thông tin chung","attributes":[{"code":"publisher_vn","name":"Công ty phát hành","value":"Công ty TNHH LINH TÂM"},{"code":"dimensions","name":"Kích thước","value":"\u003cp\u0