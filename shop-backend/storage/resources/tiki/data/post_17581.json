","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.8,"review_count":4,"review_text":"(4)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/af/bc/9e/e5275527efbbd5dca941fd9a2c7910a0.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1081,"all_time_quantity_sold":5,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2 style=\"text-align: center;\"\u003e\u003cem\u003e\u003cstrong\u003eTAI NGHE TRUE WIRELESS CHỐNG ỒN CHỦ ĐỘNG EARFUN AIR PRO 2\u003c/strong\u003e\u003c/em\u003e\u003c/h2\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003e\u003cstrong\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/37/54/db/c488c12c4fcd99e95f83e530e0bc9aca.jpg\" alt=\"\" width=\"750\" height=\"421\" /\u003e\u003c/strong\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e \u003c/p\u003e\n\u003ch3\u003e\u003cem\u003e\u003cstrong\u003eTai nghe True Wireless chống ồn thế hệ mới nhất\u003c/strong\u003e\u003c/em\u003e\u003c/h3\u003e\n\u003cp\u003eTiếp nối những thành công đã quá vang dội của dòng sản phẩm Air Pro, EarFun tiếp tục ra mắt cặp tai nghe flagship mới của mình với cái tên Air Pro 2. Cặp tai nghe này sở hữu một thiết kế mới với những đường nét mềm mại, gọn gàng và nhỏ nhắn hơn, trái với vẻ góc cạnh của phiên bản cũ. Những tính năng cơ bản như điều khiển cảm ứng, cảm biến tự động ngắt nhạc và khả năng gọi trợ lý ảo vẫn được đảm bảo.\u003c/p\u003e\n\u003cp\u003eBên cạnh đó, hệ thống chống ồn QuietSmart đã được nâng cấp lên phiên bản 2.0, tăng hiệu quả chống tạp âm bên ngoài lên tới 40dB, giúp bạn thưởng thức âm nhạc trong điều kiện yên tĩnh nhất có thể. Đi kèm với ANC là tính năng Transparent Mode giúp người dùng nhanh chóng nghe những âm thanh bên ngoài, giao tiếp mà không cần phải tháo Air Pro 2 ra khỏi tai.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/0a/da/c1/44df0472065fd0fb9f99e667694681f5.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch3\u003e\u003cem\u003e\u003cstrong\u003eThời lượng sử dụng 34 tiếng, Bluetooth 5.2 và chống nước IPX5\u003c/strong\u003e\u003c/em\u003e\u003c/h3\u003e\n\u003cp\u003eVới viên pin lớn cùng vi xử lý tiết kiệm điện, EarFun Air Pro 2 cho thời lượng sử dụng rất ấn tượng với 7 tiếng liên tiếp và 27 tiếng khi sạc trong hộp, tổng cộng 34 tiếng. Hộp sạc tích hợp khả năng sạc nhanh để cắm sạc dây 10 phút có thể tiếp tục sử dụng trong 2 tiếng, cùng với đó là sạc không dây chuẩn Qi mà phiên bản Air Pro trước đó còn thiếu.\u003c/p\u003e\n\u003cp\u003eTai nghe được thiết kế theo chuẩn chống nước IPX5, sẵn sàng cho những buổi tập thể dục của người dùng hay những lúc vô ý vẩy nước vào. Chuẩn kết nối Bluetooth cũng đã được nâng cấp từ 5.0 lên 5.2, đảm bảo EarFun Air Pro 2 luôn kết nối chắc chắn với nguồn phát với độ trễ thấp nhất có thể để bản thoải mái thưởng thức phim và game.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/76/f8/3e/69c598072f3e71b3b74c20e8bafd4804.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e \u003c/p\u003e\n\u003ch3\u003e\u003cem\u003e\u003cstrong\u003eMàng loa 10mm Titanium hoàn toàn mới\u003c/strong\u003e\u003c/em\u003e\u003c/h3\u003e\n\u003cp\u003eCung cấp khả năng tái tạo âm thanh của Air Pro 2 là 2 màng loa Dynamic 10mm Composite phủ Titanium tăng độ cứng. Màng loa này đem lại chất âm với độ chân thực cao, độ chi tiết cao hơn so với phiên bản cũ. Đây hứa hẹn sẽ là cặp tai nghe đầy đủ tính năng và có chất âm toàn diện nhất đến từ nhà sản xuất EarFun.\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003e\u003cstrong\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/21/1b/1a/371ada2ae07723d9a9e824701a1e76af.jpg\" alt=\"\" width=\"750\" height=\"449\" /\u003e\u003c/strong\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e \u003c/p\u003e\n\u003ch3\u003e\u003cem\u003e\u003cstrong\u003eThông số kỹ thuật: \u003c/strong\u003e\u003c/em\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eMàng loa Dynamic Titan 10mm\u003c/li\u003e\n\u003cli\u003eChống ồn QuietSmart 2.0 hiệu quả 40dB\u003c/li\u003e\n\u003cli\u003eThời lượng sử dụng (tắt ANC): 7 - 34 tiếng\u003c/li\u003e\n\u003cli\u003eThời lượng sử dụng (bật ANC): 6 - 30 tiếng\u003c/li\u003e\n\u003cli\u003eChống nước chuẩn IPX5\u003c/li\u003e\n\u003cli\u003eSạc không dây chuẩn Qualcomm Qi\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/af/bc/9e/e5275527efbbd5dca941fd9a2c7910a0.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/af/bc/9e/e5275527efbbd5dca941fd9a2c7910a0.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/af/bc/9e/e5275527efbbd5dca941fd9a2c7910a0.jpg","position":null,"small_url":"https://salt