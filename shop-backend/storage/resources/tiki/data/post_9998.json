h":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":3.4,"review_count":5,"review_text":"(5)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/0d/c3/2b/ec50c4fb930bf88af388d3e05eb8450e.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":692,"all_time_quantity_sold":37,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cul\u003e\u003cli\u003e\u003cstrong\u003eTÊN SẢN PHẨM\u003c/strong\u003e\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eChuột game có dây Logitech G502 X  – switch LIGHTFORCE hybrid, Cảm biến Hero 25K, 13 nút macro, tương thích Windows/Mac OS \u003c/span\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eMÔ TẢ SẢN PHẨM \u003c/strong\u003e\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eChuột Game có dây G502 X là sự bổ sung mới nhất cho dòng G502 huyền thoại. Được thiết kế lại để có mức giảm trọng lượng ấn tượng xuống còn 89 gram. Bao gồm các switch lai quang học - cơ học LIGHTFORCE đầu tiên và cảm biến chính xác đến từng micromet HERO 25K \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eCÁC ĐẶC ĐIỂM NỔI BẬT \u003c/strong\u003e\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e \u003c/p\u003e\n\u003cul\u003e\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eCông nghệ LIGHTFORCE SWITCH: \u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003eCác phím switch quang học - cơ học đột phá, đạt được tốc độ và độ tin cậy cao. \u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e \u003c/p\u003e\n\u003cul\u003e\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eCảm biến HERO 25K: \u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003eCảm biến chơi game tiên tiến nhất đạt được độ chính xác đến từng micromet với khả năng làm mịn, lọc và tăng tốc. Với tính năng theo dõi ưu việt và tiêu thụ năng lượng thông minh, HERO 25K đem lại hiệu suất, độ chính xác và mức tiết kiệm điện vô song.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e \u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eNút Chuyển DPI có thể điều chỉnh\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e: Nút chuyển DPI được thiết kế lại, để bạn có thể chọn cấu hình phù hợp với kiểu cầm nắm và phong cách của mình. Tháo ra và đảo ngược để đưa nó gần hơn với ngón cái của bạn, hoặc thay thế nó bằng vỏ trống đi kèm\u003c/span\u003e\u003cstrong\u003e.\u003c/strong\u003e\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e \u003c/p\u003e\n\u003cul\u003e\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eNút Cuộn hai chế độ: \u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003eXoay tự do nút cuộn đã làm nhẹ ở chế độ siêu nhanh. Chuyển đổi với một cú nhấp sang chế độ nhảy cóc để cuộn chính xác hơn. Nghiêng sang trái và phải để có hai nút điều khiển bổ sung, hoàn toàn có thể lập trình.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e \u003c/p\u003e\n\u003cul\u003e\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eTrọng lượng chỉ còn 89g\u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003e: Thiết kế biểu tượng của G502 X phù hợp với mức giảm trọng lượng ấn tượng xuống 89 gram nhờ bộ khung mỏng để giảm thiểu vật liệu và tăng tối đa độ vững chắc, nút cuộn được làm nhẹ.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e \u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eTHÔNG SỐ KỸ THUẬT \u003c/strong\u003e\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003eChuột game có dây Logitech G502 X  – switch LIGHTFORCE hybrid, Cảm biến Hero 25K, 13 nút macro, tương thích Windows/Mac OS \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cul\u003e\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eCảm biến Logitech HERO 25K\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eCông nghệ LIGHTFORCE quang học – cơ học\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eDPI: 100 – 25.600\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003e13 nút điều khiến có thể lập trình được\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eCon lăn Hyper Fast hai chế độ \u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eBộ nhớ có thể lưu trữ 5 chế độ\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eMặt đế chất liệu PTFE giảm thiểu ma sát\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eKích thước: 131.4mm x 79.2mm x 41.1mm\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eTrọng lượng: 89gram \u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003ePhần mềm hỗ trợ: Logitech Gaming Software\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e \u003c/p\u003e\n\u003col\u003e\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eTHÔNG TIN BẢO HÀNH: \u003c/strong\u003e\u003cstrong\u003e \u003c/strong\u003e\u003cspan style=\"font-weight:400;\"\u003eBảo hành phần cứng chính hãng trong 2 năm\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cstrong\u003eTRONG HỘP BAO GỒM: \u003c/strong\u003e\u003c/li\u003e\n\u003c/ol\u003e\u003cul\u003e\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eChuột chơi game G502 X\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eVỏ nút chuyển DPI\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eTài liệu hướng dẫn sử dụng\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight:400;\"\u003e\u003cspan style=\"font-weight:400;\"\u003eSicker nhãn dán\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/94/13/64/f463b34ff243fb0fb0ee2f7dea0247e4.png\" alt=\"\" width=\"750\" height=\"12033\" /\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/0d/c3/2b/ec50c4fb930bf88af388d3e05eb8450e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0d/c3/2b/ec50c4fb930bf88af388d3e05eb8450e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/0d/c3/2b/ec50c4fb930bf88af388d3e05eb8450e.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0d/c3/2b/ec50c4fb930bf88af388d3e05eb8450e.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0d/c3/2b/ec50c4fb930bf88af388d3e05eb8450e.jpg"},{"base_url":"https://salt.t