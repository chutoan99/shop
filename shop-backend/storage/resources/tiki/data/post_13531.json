0,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.5,"review_count":12,"review_text":"(12)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/9c/96/54/a63de927c08bbe0920067a31a0997b2a.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1381,"all_time_quantity_sold":64,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eVới chinh phục đề thi vào lớp 6 môn Tiếng Việt, học sinh sẽ được:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eCẬP NHẬT xu hướng đề thi mới, tiếp cận đề minh họa của 7 trường TOP tại Hà Nội\u003c/li\u003e\n\u003cli\u003eTổng hợp các bài văn mẫu hay và đặc sắc từ đội ngũ tác giả nổi tiếng, giàu kinh nghiệm luyện thi\u003c/li\u003e\n\u003cli\u003eCung cấp kỹ năng làm bài, xử lý tình huống và hướng dẫn giải chi tiết\u003c/li\u003e\n\u003cli\u003eTẶNG 20 video phân tích lỗi sai thường gặp\u003c/li\u003e\n\u003cli\u003eKết nối với khóa học trực tuyến giúp các con hiểu sâu, nhớ lâu.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003e1. Định nghĩa\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan data-sheets-value=\"{\u0026quot;1\u0026quot;:2,\u0026quot;2\u0026quot;:\u0026quot;Chinh phục đề thi vào 6 là cuốn sách giúp học sinh lớp 5 luyện tập làm quen dần với cấu trúc đề thi của các trường chất lượng cao trong kì thi 5 vào 6\u0026quot;}\" data-sheets-userformat=\"{\u0026quot;2\u0026quot;:4993,\u0026quot;3\u0026quot;:{\u0026quot;1\u0026quot;:0},\u0026quot;10\u0026quot;:1,\u0026quot;11\u0026quot;:4,\u0026quot;12\u0026quot;:0,\u0026quot;15\u0026quot;:\u0026quot;Arial\u0026quot;}\"\u003eChinh phục đề thi vào 6 là cuốn sách giúp học sinh lớp 5 luyện tập làm quen dần với cấu trúc đề thi của các trường chất lượng cao trong kì thi 5 vào 6.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e2. Phương pháp tiếp cận\u003c/strong\u003e\u003c/p\u003e\n\u003cstyle type=\"text/css\"\u003e\u003c!--td {border: 1px solid #ccc;}br {mso-data-placement:same-cell;}--\u003e\u003c/style\u003e\n\u003cp\u003e\u003cspan data-sheets-value=\"{\u0026quot;1\u0026quot;:2,\u0026quot;2\u0026quot;:\u0026quot;Chinh phục đề thi vào 6 là cuốn sách giúp học sinh lớp 5 luyện tập làm quen dần với cấu trúc đề thi của các trường chất lượng cao trong kì thi 5 vào 6\u0026quot;}\" data-sheets-userformat=\"{\u0026quot;2\u0026quot;:4993,\u0026quot;3\u0026quot;:{\u0026quot;1\u0026quot;:0},\u0026quot;10\u0026quot;:1,\u0026quot;11\u0026quot;:4,\u0026quot;12\u0026quot;:0,\u0026quot;15\u0026quot;:\u0026quot;Arial\u0026quot;}\"\u003eHệ thống đề thi bám sát và cập nhật cấu trúc mới nhất đề thi vào trường THCS chất lượng cao tại Hà Nội.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e3. Cấu trúc sách\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cspan data-sheets-value=\"{\u0026quot;1\u0026quot;:2,\u0026quot;2\u0026quot;:\u0026quot;Chinh phục đề thi vào 6 là cuốn sách giúp học sinh lớp 5 luyện tập làm quen dần với cấu trúc đề thi của các trường chất lượng cao trong kì thi 5 vào 6\u0026quot;}\" data-sheets-userformat=\"{\u0026quot;2\u0026quot;:4993,\u0026quot;3\u0026quot;:{\u0026quot;1\u0026quot;:0},\u0026quot;10\u0026quot;:1,\u0026quot;11\u0026quot;:4,\u0026quot;12\u0026quot;:0,\u0026quot;15\u0026quot;:\u0026quot;Arial\u0026quot;}\"\u003e\u003cem\u003ePhần 1: Luyện đề\u003c/em\u003e \u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cspan data-sheets-value=\"{\u0026quot;1\u0026quot;:2,\u0026quot;2\u0026quot;:\u0026quot;Chinh phục đề thi vào 6 là cuốn sách giúp học sinh lớp 5 luyện tập làm quen dần với cấu trúc đề thi của các trường chất lượng cao trong kì thi 5 vào 6\u0026quot;}\" data-sheets-userformat=\"{\u0026quot;2\u0026quot;:4993,\u0026quot;3\u0026quot;:{\u0026quot;1\u0026quot;:0},\u0026quot;10\u0026quot;:1,\u0026quot;11\u0026quot;:4,\u0026quot;12\u0026quot;:0,\u0026quot;15\u0026quot;:\u0026quot;Arial\u0026quot;}\"\u003eHệ thống đề thi chuẩn về cấu trúc và hình thức thể hiện. Đặc biệt, đề sử dụng những ngữ liệu/văn bản ngoài SGK hay, lạ, hấp dẫn nhưng phù với lứa tuổi giúp học sinh nâng cao năng lực đọc hiểu văn bản, phát triển vốn từ, rèn cách hành văn, khơi gợi cảm xúc, hứng thú với môn Tiếng Việt.\u003c/span\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cem\u003ePhần 2: Hướng dẫn giải chi tiết\u003c/em\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cstyle type=\"text/css\"\u003e\u003c!--td {border: 1px solid #ccc;}br {mso-data-placement:same-cell;}--\u003e\u003c/style\u003e\n\u003cp\u003eHướng dẫn giải được biên soạn tỉ mỉ, chi tiết, dễ hiểu, học sinh có thể TỰ HỌC. Đồng thời, phụ huynh có thể đồng hành, giúp con ĐÁNH GIÁ MỨC NĂNG LỰC, bám sát mục tiêu và xây dựng lộ trình ôn luyện cho phù hợp.\u003c/p\u003e\n\u003cstyle type=\"text/css\"\u003e\u003c!--td {border: 1px solid #ccc;}br {mso-data-placement:same-cell;}--\u003e\u003c/style\u003e\n\u003cstyle type=\"text/css\"\u003e\u003c!--td {border: 1px solid #ccc;}br {mso-data-placement:same-cell;}--\u003e\u003c/style\u003e\n\u003cp\u003eCuốn sách \u003cstrong\u003eChinh phục đề thi vào 6 môn Tiếng Việt\u003c/strong\u003e được xây dựng với 3 phương châm học thật – giải đáp thật – hiệu quả thật để giúp con chinh phục dễ dàng các trường CLC, trường TOP tại Hà Nội.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có g