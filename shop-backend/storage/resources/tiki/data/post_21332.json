14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/99/83/17/f552ca16cee6589a583eb90f6a118160.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":179,"all_time_quantity_sold":7,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cimg class=\"ckimgrsz\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/0f/94/07/5b2fc2ca6b482f1ddda6c1ea64ff8633.jpg\" alt=\"pre-workout-the-curse-danh-thuc-suc-manh-tiem-an-ben-trong-ban_268d413e00e94bf1acfb581857796bda.jpg\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003eThe Curse Pre Workout JNX Sports.\u003c/em\u003e\u003c/p\u003e\n\u003ch2\u003eThe Curse bật tung nguồn năng lượng\u003c/h2\u003e\n\u003cp\u003eNhững tháng cuối năm hoặc những ngày mưa dai dẳng hay buổi chiều thường làm trì trệ những buổi tập luyện. Bạn có thể rất tự tin về sức mạnh của mình, nhưng để bắt đầu một buổi tập, vẫn cần phải vượt qua bước đầu trong việc làm nóng và khởi động.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/c8/c3/be/91cb343f744c3826a78bbcfd919f9549.jpg\" alt=\"suc-manh-tuyet-voi-tu-pre-workout-the-curse-bung-no-suc-manh_3dd537c4abb149018ab2486ad1c5fdb8.jpg\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003eGiải pháp “đề ba” để có buổi tập hiệu quả nhất.\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003eCó rất nhiều bài khởi động làm nóng, nhưng cũng cần mất một thời gian ngắn để nó có tác dụng. Nếu bạn chưa biết phải “đề ba” như thế nào hoặc giả bạn đang cần một loại Pre workout chuyên dụng, hãy để \u003cem\u003e\u003cstrong\u003ePre workout The Curse \u003c/strong\u003e\u003c/em\u003egiúp bạn.\u003c/p\u003e\n\u003ch3\u003eCông thức hoàn hảo của The Curse cho một loại Pre workout đỉnh cao\u003c/h3\u003e\n\u003cp\u003e“Lời nguyền” The Curse tác động lên người dùng với những hoạt chất cực mạnh mà lại an toàn cho người dùng. Không giống các loại chất kích thích khác, liều lượng và hoạt tính của các chất có trong công thức của The Curse được nhà sản xuất Cobra Labs kết hợp hoàn hảo.\u003c/p\u003e\n\u003cp\u003eMỗi khẩu phần \u003cstrong\u003eThe Curse\u003c/strong\u003e chứa 3000mg hoạt chất giúp tăng cường quá trình sinh năng lượng, bao gồm Beta Alanine, Creatine Monohydrate và Acid Citric. Hàm lượng hoạt chất này sẽ nhanh chóng được hấp thu và kích hoạt các quá trình tổng hợp và phát sinh năng lượng, cung cấp cho cơ thể.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/2d/8b/b7/ec70742f2adaa23e994599179b7ebdef.jpg\" alt=\"the-curse-pre-workout-ket-hop-hoan-hao-hoat-tinh-manh-me_ec1837e5449e4342a193dcdfe8792919.jpg\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003eCông thức hoàn hảo của The Curse.\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003eNguồn năng lượng được giải phóng sau đó sẽ được chính các hoạt chất trong The Curse vận chuyển đi khắp cơ thể để sử dụng. Tính năng này được ví như một “chiếc bơm năng lượng” đem sức mạnh đi lan tỏa khắp nơi trong cơ thể.\u003c/p\u003e\n\u003cp\u003eCùng với đó là 900mg hỗn hợp “Ma trận” các hoạt chất tăng cường tổng hợp cơ bắp như Citrulline và Arginine. Để đem lại sự tỉnh táo và tập trung cao độ, Cobra Labs còn tích hợp thêm 157mg các hoạt chất như Caffein và tinh dầu lá Ô-liu (Olive).\u003c/p\u003e\n\u003ch3\u003eVừa mạnh mẽ lại vừa ngon hơn với hương vị tuyệt vời của The Curse\u003c/h3\u003e\n\u003cp\u003eCác dòng sản phẩm bổ sung trước tập (Pre workout) thường được sản xuất với những hương vị đem lại sự hưng phấn và sảng khoái. The Curse cũng không ngoại lệ. Với công nghệ tiên tiến mà Cobra Labs sử dụng để sản xuất The Curse, hương vị mà bạn được thưởng thức sẽ hoàn toàn không khác gì với những loại trái cây mà bạn dùng hằng ngày.\u003c/p\u003e\n\u003cp\u003eThe Curse có rất nhiều hương vị khác nhau cho bạn lựa chọn như cam, chanh, trái cây tổng hợp và việt quất.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/ab/10/06/4994ce3b65f4df0f7f8f31a340ff19d6.jpg\" alt=\"pre-workout-the-curse-huong-vi-thom-ngon-suc-manh-hoan-hao_734cca72fa984c14be19ee179eac0dd8.jpg\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003eNhiều hương vị thơm ngon.\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003eKhông giống các loại sản phẩm Pre workout sử dụng chất kích thích, nguồn hoạt chất trong \u003cstrong\u003eThe Curse\u003c/strong\u003e được căn chỉnh theo tỷ lệ hợp lý nhất, để người dùng đạt được mục đích, chinh phục bài tập mà không bị các cảm giác khó chịu khác như buồn nôn, bồn chồn và mất ngủ.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/99/83/17/f552ca16cee6589a583eb90f6a118160.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/99/83/17/f552ca16cee6589a583eb90f6a118160.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/99/83/17/f552ca16cee6589a583eb90f6a118160.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/99/83/17/f552ca16cee6589a583eb90f6a118160.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/99/83/17/f552ca16cee6589a583eb9