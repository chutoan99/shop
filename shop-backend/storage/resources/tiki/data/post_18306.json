h":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":157000,"discount_rate":14,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/56/30/f7/b92a3cd5048578a4169c94ce9fe9064b.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":366,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eMột không gian hiện đại sẽ trở lên sang trọng hơn khi thiết bị K580 Slim Milti- Device được xuất hiện trong đó. Bàn phím không dây K580 Slim được thiết kế siêu mỏng nhẹ, có thể chuyển tiếp hoàn hảo để nhập ý tưởng trên chiếc máy tính của bạn, dễ dàng chuyển đổi sang điện thoại thông minh, đây thật sự là một người bạn đồng hành tuyệt vời cho công việc đa nhiệm hàng ngày.\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eGIAO DIỆN THIẾT KẾ\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/bf/a6/f1/5e61bed7ca82a6fd25e4d28eb709ee56.jpg\" alt=\"thiết kế bàn phím Logitech không dây K580 Slim\" width=\"1000\" height=\"614\" /\u003e\u003c/p\u003e\n\u003cp\u003eMột không gian làm việc hiện đại, nếu được điểm thêm bàn phím không dây K580 thì còn gì tuyệt vời hơn. Nhờ vào thiết kế tối giản, siêu mỏng nhẹ mà bàn phím K580 không hề chiếm nhiều diện tích trong căn phòng của bạn, nó thật sự rất phù hợp cho những không gian nhỏ hẹp và cần sự riêng tư.\u003c/p\u003e\n\u003cp\u003eNhìn tổng quan bề mặt của các phím ta thấy, kích thước của phím to, rõ ràng, khả năng gõ vô cùng thoải mái. Cũng được tích hợp đầy đủ các phím tắt nhanh, bàn phím số và phím mũi tên lên xuống. Mặc dù được tối ưu hết cỡ để mang tới cho người dùng một bàn phím di động. Nhưng theo tôi thấy nó không bị lược bỏ đi bất cứ một chi tiết nào mà ngược lại, nó rất đầy đủ mà còn được tích hợp thêm một số tính năng cực kỳ thú vị như phím F11, F12 tự động chuyển đổi dạng bàn phím cho hệ điều hành Windows hoặc Mac.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eHAI PHIÊN BẢN MÀU SẮC ĐỂ LỰA CHỌN\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/0a/f1/bd/86d66abf68cb7dc03db6b3358175ba0c.jpg\" alt=\"màu sắc bàn phím Logitech không dây K580 Slim\" width=\"1000\" height=\"555\" /\u003e\u003c/p\u003e\n\u003cp\u003eVới \u003cstrong\u003eBàn phím Logitech K580 Graphite Slim\u003c/strong\u003e, bạn sẽ có hai phiên bản màu sắc để lựa chọn. Và cả hai màu sắc này thì cả nam và nữ đều có thể sử dụng được. Bởi vậy, bạn có thể cân nhắc và lựa chọn màu sắc phù hợp nhé.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTỐI ƯU HÓA KHÔNG GIAN LÀM VIỆC CỦA BẠN\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/0f/6e/17/017b62cf0731c81e13c8a86670eb00b1.jpg\" alt=\"Bàn phím Logitech không dây K580 mỏng nhẹ- tối ưu\" width=\"1000\" height=\"562\" /\u003e\u003c/p\u003e\n\u003cp\u003eMột thiết kế nhỏ gọn phù hợp với nhiều căn phòng trong đó bao gồm cả những căn phòng có diện tích nhỏ hẹp.\u003c/p\u003e\n\u003cp\u003eCũng có thêm bàn phím số được trang bị để nâng cao hiệu suất nhập liệu, một dãy phím tắt kết hợp với phím Fn để bạn dễ dàng thực hiện phím tắt nhanh, vô cùng tiết kiệm thời gian. Tuy được tích hợp đầy đủ phím bấm như vậy nhưng bộ khung của bàn phím hết sức gọn gàng, giúp bạn làm việc mà ít phải mở rộng cách tay để với, đạt được năng suất cao trong tầm tay, giúp bạn có thể làm việc thoải mái hơn trong nhiều giờ đồng hồ.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eLÀM VIỆC NGAY LẬP TỨC VỚI EASY-SWITCH \u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/c2/81/f7/445b9335e5b6dcc541a05b5b1c08916a.jpg\" alt=\"các phím EASY-SWITCH  của K580\" width=\"1000\" height=\"694\" /\u003e\u003c/p\u003e\n\u003cp\u003eCũng giống như bàn phím \u003cstrong\u003eMX Keys Mini,\u003c/strong\u003e bàn phím K580 cũng được trang bị các nút \u003cem\u003e\u003cstrong\u003eEasy Switch\u003c/strong\u003e\u003c/em\u003e để cho phép bạn chuyển đổi thao tác nhập liệu giữa hai thiết bị có cùng bàn phím. Các nút tính năng này còn cho phép bạn nhập báo cáo trên máy tính sau đó chuyển đổi dễ dàng sang điện thoại di đọng và có thể đặt điện thoại trong giá đỡ ngay phía trên của bàn phím một cách tiện lợi.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eKẾT NỐI THEO CÁCH MÀ BẠN MUỐN\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/b9/5b/53/3a36bd790c1e48e908af07f1288afd0f.jpg\" alt=\"kết nối bàn phím logitech K580\" width=\"1000\" height=\"523\" /\u003e\u003c/p\u003e\n\u003cp\u003eBàn phím không dây kết nối thông qua \u003cstrong\u003e\u003cem\u003eWireless\u003c/em\u003e\u003c/strong\u003e hoặc\u003cstrong\u003e\u003cem\u003e Bluetooth\u003c/em\u003e\u003c/strong\u003e đồng thời cho hai thiết bị.\u003c/p\u003e\n\u003cp\u003eKết nối được với nhiều thiết bị điện tử như: laptop, PC, điện thoại, máy tính bảng.\u003c/p\u003e\n\u003cp\u003eKhông kén chọn hệ điều hành, tương thích dễ dàng với hệ điều hành Windows và Mac.\u003c/p\u003e\n\u003cp\u003eKết nối thông qua đầu cắm USB vô cùng tiện lợi, tốc độ kết nối 2.4Ghz và được lưu trữ trong cửa pin. Phạm vi kết nối không dây lên tới 10m, thoải mái để bạn có thể xê dịch bàn phím đi khắp mọi nơi trong căn phòng của bạn.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTHỜI LƯỢNG PIN DÀI\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/9f/51/da/6fc4d2bd7b734e451bbad6c82dd7b105.jpg\" alt=\"thời lượng pin của bàn phím Logitech K580\" width=\"798\" height=\"450\" /\u003e\u003c/p\u003e\n\u003cp\u003eHãng \u003cstrong\u003eLogitech\u003c/strong\u003e đã trang bị cho sản phẩm bàn phím Logitech K580 Graphite Slim một viên pin thật sự chất lượng, được tích hợp tính năng tự động ngủ đông khi bạn không sử dụng tới chúng, chính bởi vậy mà thời gian duy trì để làm việc thao tác văn bản kéo dài lên tới 24 tháng. Một khoảng thời gian dài để bạn thỏa sức xây dựng ý tưởng cho công việc của mình.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCÁC BƯỚC THIẾT LẬP\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/3e/0f/14/a7c75e5bcf220995af05eb1e7dd67b38.jpg\" alt=\"\" width=\"1000\" height=\"432\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/b8/ba/65/226fd5f8d47a17d5b0ee8bf43c679802.jpg\" alt=\"\" width=\"983\" height=\"400\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/b5/0a/76/4d7da6f19e35ce810ae7f336a667f2e2.jpg\" alt=\"\" width=\"1000\" height=\"550\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/dd/4f/9a/111bbd67bba524507b2be215e887f0c4.jpg\" alt=\"\" width=\"1029\" height=\"448\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/6a/34/78/820f67b1786992cfa5474df691547b89.jpg\" alt=\"\" width=\"1000\" height=\"423\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/d6/a4/53/81b5e1c7d11a2c684893c67f70d8de3c.jpg\" alt=\"\" width=\"1000\" height=\"496\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/29/e8/51/1854af94d89eeb8798a9961a8c1d7467.jpg\" alt=\"\" width=\"1000\" height=\"372\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/d3