13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":18000,"discount_rate":15,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/bc/3e/ac/2d66cadb6693d4cb08862d3c127e9747.JPG","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1862,"all_time_quantity_sold":7,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cul style=\"box-sizing: border-box; margin-top: 0px; margin-bottom: 10px; color: #333333; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e\n\u003cli style=\"box-sizing: border-box;\"\u003e\u003cspan style=\"box-sizing: border-box;\"\u003eThức Ăn Cho Chó Lớn Trưởng Thành Nutrience Original - Thịt Cừu, Rau Củ Và Trái Cây Tự Nhiên\u003c/span\u003e là nguyên liệu số 1 trong công thức Nutrience Orginal Adult, Medium Breed để mang đến cho chú chó cưng của bạn hương vị yêu thích và hỗ trợ phát triển cơ thể năng động khỏe mạnh.\u003c/li\u003e\n\u003cli style=\"box-sizing: border-box;\"\u003eNguyên liệu số 1 trong công thức dinh dưỡng của chúng tôi luôn luôn là thịt cừu chất lượng cao giúp chú chó đáng yêu của bạn duy trì cơ bắp dẻo dai.\u003c/li\u003e\n\u003cli style=\"box-sizing: border-box;\"\u003eChúng tôi không bao giờ sử dụng những nguyên liệu kém chất lượng như meat-by-product (phụ phẩm từ thịt) hay đạm thực vật để tăng hàm lượng đạm trong các sản phẩm của mình.\u003c/li\u003e\n\u003cli style=\"box-sizing: border-box;\"\u003eChúng tôi sử dụng nhiều nguồn nguyên liệu tự nhiên có chứa chất chống oxy hóa cho các công thức dinh dưỡng (quả việt quất, nam việt quất và cà rốt cùng với vitamin C và vitamin E) để chúng hoạt động cùng nhau hỗ trợ phát triển hệ miễn dịch của chú chó cưng của bạn.\u003c/li\u003e\n\u003cli style=\"box-sizing: border-box;\"\u003eSức khỏe tiêu hóa có liên kết trực tiếp đến sức khỏe tổng thể của thú cưng của bạn. Công thức của chúng tôi bao gồm một sự kết hợp của ngũ cốc nguyên hạt, chất xơ tự nhiên và prebiotics để giúp chó cưng của bạn duy trì đường ruột khỏe mạnh.\u003c/li\u003e\n\u003cli style=\"box-sizing: border-box;\"\u003eBộ da và lông của một chú chó sẽ phản ánh tổng thể sức khỏe của chúng.\u003c/li\u003e\n\u003cli style=\"box-sizing: border-box;\"\u003eNguồn cung cấp axit béo tự nhiên Omega 3 và Omega 6, bao gồm dầu cá hồi và hạt lanh, sẽ giúp chú chó cưng của bạn duy trì da lông một cách khỏe mạnh và sáng bóng.\u003c/li\u003e\n\u003cli style=\"box-sizing: border-box;\"\u003eKích thước của chó càng lớn thì áp lực sẽ lớn hơn đối với xương khớp của chúng. Chúng tôi luôn đảm bảo lượng Glucosamin và Chondroitin cần thiết trong công thức dinh dưỡng của chúng tôi để hỗ trợ xương khớp và sự linh động cho chú chó cưng của bạn.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e\u003cspan style=\"box-sizing: border-box;\"\u003eThành phần\u003c/span\u003e\u003c/p\u003e\n\u003cul style=\"box-sizing: border-box; margin-top: 0px; margin-bottom: 10px; color: #333333; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e\n\u003cli style=\"box-sizing: border-box;\"\u003eBột thịt cừu, lúa mạch, bột yến mạch, đậu Hà Lan, gạo lứt, bột thịt gà, mỡ gà (được bảo quản bằng hỗn hợp tocopherols – nhóm chất quan trọng có trong Vitamin E), bột củ cải khô, hương vị thịt cừu tự nhiên, hạt lanh, men bia, kali clorua, dầu cá hồi (nguồn DHA), quả việt quất, quả nam việt quất, cà rốt, Vitamin [bổ sung vitamin E, axit ascorbic (vitamin C), bổ sung vitamin A, niacin, calcium pantothenate, inositol, riboflavin, pyridoxine hydrochloride, thiamine mononitrate, biotin, bổ sung vitamin B12, bổ sung vitamin D3, folic acid], khoáng chất [kẽm oxide, kẽm proteinate, sắt proteinate, sắt sulfate, đồng proteinate, đồng sulfate, manganese proteinate, manganese oxide, calcium iodate, sodium selenite], muối, DL-methionine, dicalcium phosphate, lecithin, choline chloride, chiết xuất từ rễ rau diếp xoăn, chiết xuất nấm men, L-lysine, chiết xuất hương thảo, glucosamine hydrochloride, chondroitin sulfate.\u003c/li\u003e\n\u003cli style=\"box-sizing: border-box;\"\u003eKhông phải là thành phần cần thiết trong hồ sơ dinh dưỡng thức ăn cho chó của AAFCO\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/bc/3e/ac/2d66cadb6693d4cb08862d3c127e9747.JPG","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/bc/3e/ac/2d66cadb6693d4cb08862d3c127e9747.JPG","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/bc/3e/ac/2d66cadb6693d4cb08862d3c127e9747.JPG","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/bc/3e/ac/2d66cadb6693d4cb08862d3c127e9747.JPG","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/bc/3e/ac/2d66cadb6693d4cb08862d3c127e9747.JPG"},{"base_url":"https://salt.tikicdn.com/ts/product/ba/d2/a1/e41b0ee3d52e20bc960462270702321a.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ba/d2/a1/e41b0ee3d52e20bc960462270702321a