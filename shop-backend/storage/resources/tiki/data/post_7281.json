uật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/3f/dd/23/312432d0332509807e467bb11cb4abf2.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/3f/dd/23/312432d0332509807e467bb11cb4abf2.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/3f/dd/23/312432d0332509807e467bb11cb4abf2.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3f/dd/23/312432d0332509807e467bb11cb4abf2.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3f/dd/23/312432d0332509807e467bb11cb4abf2.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/52/09/9a/0465f75d4c3a480ff764475d59ff6990.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/52/09/9a/0465f75d4c3a480ff764475d59ff6990.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/52/09/9a/0465f75d4c3a480ff764475d59ff6990.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/52/09/9a/0465f75d4c3a480ff764475d59ff6990.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/52/09/9a/0465f75d4c3a480ff764475d59ff6990.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/17/b7/05/31dd5720797cda51738fc8eee866f451.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/17/b7/05/31dd5720797cda51738fc8eee866f451.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/17/b7/05/31dd5720797cda51738fc8eee866f451.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/17/b7/05/31dd5720797cda51738fc8eee866f451.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/17/b7/05/31dd5720797