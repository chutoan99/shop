eeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":3.3,"review_count":13,"review_text":"(13)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/b1/8b/98/bc36dcfd02040e9c0764c5576e60a2d7.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1800,"all_time_quantity_sold":94,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eThông tin sản phẩm\u003c/strong\u003e:\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/b1/8b/98/4de7cd0a9ce10fba83d755607309718c.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/b1/8b/98/4de7cd0a9ce10fba83d755607309718c.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/10/9c/90/31e168b2b4a614c8f265a4163e83fc74.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/10/9c/90/31e168b2b4a614c8f265a4163e83fc74.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e- Sản phẩm sản xuất theo tiêu chuẩn công nghệ Anh Quốc tại nhà máy đặt ở Đồng Nai do công ty MAP PACIFIC Việt Nam điều hành và phân phối chính thức bởi công ty TNHH Ứng dụng KHKT Cúc Phương.\u003c/p\u003e\n\u003cp\u003e- Là sản phẩm dạng dung dịch đóng chai có dung tích 100ml, đã qua kiểm duyệt y tế nghiêm ngặt và chứng nhận an toàn\u003c/p\u003e\n\u003cp\u003e- Thuốc có mùi nhẹ, không gây hoen ố bề mặt khi phun, ít ảnh hưởng đến sức khỏe người sử dụng và môi trường. Hiệu lực: kéo dài 4 – 6 tháng.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eHướng dẫn sử dụng \u003c/strong\u003e\u003c/p\u003e\n\u003ctable border=\"1\" cellspacing=\"0\" cellpadding=\"0\"\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd valign=\"top\" width=\"123\"\u003e\n\u003cp align=\"center\"\u003e\u003cstrong\u003eCách dùng\u003c/strong\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd valign=\"top\" width=\"198\"\u003e\n\u003cp align=\"center\"\u003e\u003cstrong\u003eTỷ lệ pha loãng với nước\u003c/strong\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd valign=\"top\" width=\"265\"\u003e\n\u003cp align=\"center\"\u003e\u003cstrong\u003eMức áp dụng\u003c/strong\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd valign=\"top\" width=\"123\"\u003e\n\u003cp\u003ePhun tồn lưu\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd valign=\"top\" width=\"198\"\u003e\n\u003cp\u003ePha 20ml chế phẩm với 1L nước sạch\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd valign=\"top\" width=\"265\"\u003e\n\u003cp\u003e1L dung dịch đã pha phun cho 25m\u003csup\u003e2\u003c/sup\u003e bề mặt. Chế phẩm có thể tồn lưu 3 tháng\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd valign=\"top\" width=\"123\"\u003e\n\u003cp\u003ePhun ULV\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd valign=\"top\" width=\"198\"\u003e\n\u003cp\u003ePha 1 phần chế phẩm với 9 phần nước sạch\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd valign=\"top\" width=\"265\"\u003e\n\u003cp\u003e0,5L dung dịch đã pha phun cho 1ha.\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd valign=\"top\" width=\"123\"\u003e\n\u003cp\u003eTẩm màn\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd valign=\"top\" width=\"198\"\u003e\n\u003cp\u003ePha 6,6ml chế phẩm với 693,4ml nước sạch\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd valign=\"top\" width=\"265\"\u003e\n\u003cp\u003eTẩm cho 1 màn đôi hoặc 2 màn đơn\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eNên kết hợp vơi thuốc muỗi dạng bột như : Map OLive hay Fendona để hiệu quả tồn lưu kết dính được lâu dài hơn\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eDùng bình xịt tưới cây để tự phun tại hộ gia đình. Chọn bình xịt càng có độ tạo sương nhỏ càng tốt\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eKhi sử dụng phun hộ gia định nên sơ tán các vật dụng nhạy cảm như: quần áo, bát đũa, bàn chải đánh răng, cốc chén.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eNên phun tồn lưu tránh để các dung dịch vương vãi xuống nền nhà: Phun tường, hốc tủ, cánh cửa, cửa sổ\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eNếu nhà có em bé nên sơ tán đi vài ngày, trẻ sơ sinh thì cần đặc biệt chú ý.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/b1/8b/98/bc36dcfd02040e9c0764c5576e60a2d7.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b1/8b/98/bc36dcfd02040e9c0764c5576e60a2d7.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b1/8b/98/bc36dcfd02040e9c0764c5576e60a2d7.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b1/8b/98/bc36dcfd02040e9c0764c5576e60a2d7.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b1/8b/98/bc36dcfd02040e9c0764c5576e60a2d7.jpg"}],"warranty_policy":null,"brand":{"id":509673,"name":"Hanpet","slug":"hanpet"},"current_seller":{"id":16591,"sku":"7334527205727","name":"Cửa Hàng NgọcLan","link":"https://tiki.vn/cua-hang/cua-hang-ngoclan","logo":"12/95/20/8502c3725de2635b6f0cbd5e96e58c32.jpg","price":88998,"product_id":"39614182","store_id":15996,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[{"id":52177,"name":"TitiNo","link":"https://tiki.vn/cua-hang/titino","logo":"4e/b9/42/cfc4a0b7996a42