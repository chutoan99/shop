-align:justify;\"\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/97/33/ed/1f90836ce73c6d533d4394ff0a093db9.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/97/33/ed/1f90836ce73c6d533d4394ff0a093db9.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/97/33/ed/1f90836ce73c6d533d4394ff0a093db9.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/97/33/ed/1f90836ce73c6d533d4394ff0a093db9.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/97/33/ed/1f90836ce73c6d533d4394ff0a093db9.jpg"}],"warranty_policy":null,"authors":[{"id":438453,"name":"Nguyễn Duy Cần, Thu Giang","slug":"nguyen-duy-can-thu-giang"}],"current_seller":{"id":258465,"sku":"7961941024915","name":"Lá Thư Xanh Bookstore","link":"https://tiki.vn/cua-hang/la-thu-xanh-bookstore","logo":"03/3f/2e/f0cd86e88d5803a7d4dbc645453accb0.jpg","price":130000,"product_id":"202762432","store_id":245498,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[{"id":97533,"name":"Nhà Sách Vĩnh Thụy","link":"https://tiki.vn/cua-hang/nha-sach-vinh-thuy","logo":"https://vcdn.tikicdn.com/ts/seller/19/f2/bd/8bda12adffb15edf1b3d8339b0238283.jpg","price":130000,"product_id":"275117507","store_id":90454},{"id":295057,"name":"HỆ THỐNG NHÀ SÁCH ABC","link":"https://tiki.vn/cua-hang/he-thong-nha-sach-abc","logo":"https://vcdn.tikicdn.com/ts/seller/98/3d/ff/cec0ba0eaa575634616ab4605fccbe6d.jpg","price":130000,"product_id":"275478523","store_id":282399},{"id":126688,"name":"info book","link":"https://tiki.vn/cua-hang/info-book","logo":"https://vcdn.tikicd