ull,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":123000,"discount_rate":25,"rating_average":4,"review_count":4,"review_text":"(4)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/96/39/37/4500405a829276db1a613c4aa0a8ab0f.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":857,"all_time_quantity_sold":12,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2\u003e\u003cem\u003eMũ bảo hiểm 1/2 đầu có kính cao cấp Protec Hiway họa tiết đen đeo kính, mẫu mới, an toàn, thời trang - Hàng chính hãng\u003c/em\u003e\u003c/h2\u003e\n\u003cp\u003e\u003cem\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/8a/3c/b1/2d7235f945efb21a3522fccf00b4b8a2.jpg\" alt=\"\" width=\"750\" height=\"750\"\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003eĐược thiết kế dành cho cả nam và nữ. Mũ Hiway màu sắc sinh động, nhỏ gọn, thông thoáng khí thời trang mà thoáng mát, tạo cảm giác thoải mái cho cho người sử dụng khi đội. Mũ có trọng lượng nhẹ chỉ 550 gram và được thiết kế ôm vừa vặn vào đầu người đội tạo cảm giác nhẹ nhàng êm ái dù khi đi xa đội mũ bảo hiểm lâu cũng không bị mỏi cổ nặng đầu khó chịu. \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/08/aa/3b/281a774e3c0466419f991e60a0cb1aae.jpg\" alt=\"\" width=\"750\" height=\"750\"\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eDây nón chịu được lực kéo, lực văng lớn, đồng thời giúp ôm gọn vòng đầu tốt hơn nhưng không gây khó chịu. Dây nón có thể điều chỉnh độ dài ngắn dễ dàng.\u003c/li\u003e\n\u003cli\u003eMũ có trọng lượng rất nhẹ, chỉ khoảng 550 gram khiến người đội cảm thấy nhẹ nhàng, không hề nặng đầu dù có phải đội mũ trong thời gian dài.\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/d8/95/77/a8f720d8f0bfb189dcae0b4db0afd398.jpg\" alt=\"\" width=\"750\" height=\"375\"\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eKích thước Chi vi vòng đầu : Size L (56cm - 57cm), size XL (57-58cm)\u003c/li\u003e\n\u003cli\u003eThiết kế và chất liệu đặc biệt phù hợp với con người và khí hậu nóng ẩm tại Việt Nam.\u003c/li\u003e\n\u003cli\u003eMũ bảo hiểm Protec Hiway được chứng nhận đạt quy chuẩn kỹ thuật quốc gia QCVN 2:2008/BKHCN (tem chứng nhận CR được dán phía sau mũ khẳng định chất lượng sản phẩm).\u003c/li\u003e\n\u003cli\u003eMũ Protec đã thông qua các quy trình kiểm định nghiêm ngặt về độ va đập, độ đâm xuyên và độ ổn định của khóa mũ.\u003c/li\u003e\n\u003cli\u003eLõi xốp mũ là bộ phận quan trọng có tác dụng giảm chấn động tới đầu người đội và bảo vệ bộ não. Lõi với chất liệu chính là EPS, nén bằng nhiều lớp xốp rắn chắc, các hạt xốp nhỏ, đều mịn nhẹ, thoáng và hấp thu xung động tốt khi xảy ra tai nạn. Lớp mút này có thể tháo ra dễ dàng để giặt hay vệ sinh khi cần.\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/18/42/55/48ecebeedde67d35b0cba0ca977a47e7.jpg\" alt=\"\" width=\"750\" height=\"750\"\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eKiểu dáng 1/2 đầu ôm gọn, phối 2 màu tinh tế, hiện đại và hợp thời trang, thể hiện cá tính của người đội.\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/52/4c/14/50dc5a4833418955172582907e0d35db.jpg\" alt=\"\" width=\"750\" height=\"750\"\u003e\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003e\u003cem\u003eHướng dẫn sử dụng:\u003c/em\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eXác định cỡ nón phù hợp: Vòng 1 sợi dây quanh đầu, ngay phía trên lông mày và tai. Xiết sợi dây sao cho ôm vừa đủ thoải mái lấy đầu và ghi lại số đo đó. Lặp lại như vậy để tìm được số đo mà bạn thấy đầu dễ chịu nhất và sử dụng số đo đó.\u003c/li\u003e\n\u003c/ul\u003e\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/4d/04/23/266ff42c97312303cbcde012298f5b2d.png\" alt=\"\" width=\"687\" height=\"510\"\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/96/39/37/4500405a829276db1a613c4aa0a8ab0f.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/96/39/37/4500405a829276db1a613c4aa0a8ab0f.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/96/39/37/4500405a829276db1a613c4aa0a8ab0f.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/96/39/37/4500405a829276db1a613c4aa0a8ab0f.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/96/39/37/4500405a829276db1a613c4aa0a8ab0f.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/8a/3c/b1/1a4ff59d02c1a3cb0c141911e1e4ef08.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/8a/3c/b1/1a4ff59d02c1a3cb0c141911e1e4ef08.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/8a/3c/b1/1a4ff59d02c1a3cb0c141911e1e4ef08.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8a/3c/b1/1a4ff59d02c1a3cb0c141911e1e4ef08.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8a/3c/b1/1a4ff59d02c1a3cb0c141911e1e4ef08.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/08/aa/3b/3227daf635e37f25b06dbfa9f89be03f.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/08/aa/3b/3227daf635e37f25b06dbfa9f89be03f.jpg","medium_url":"https://salt.tikicdn.com/cache/