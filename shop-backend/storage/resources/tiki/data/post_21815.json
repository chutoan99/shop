3596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":165000,"discount_rate":22,"rating_average":5,"review_count":10,"review_text":"(10)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/b2/07/d3/fd05832b3e7d7d71ffc2a28bded6392b.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":763,"all_time_quantity_sold":31,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cspan class=\"_96e-7edee3 undefined d7e-d87aa1 d7e-fb1c84\"\u003e1. Kích Thước Sản Phẩm:\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan class=\"_96e-7edee3 undefined d7e-d87aa1 d7e-fb1c84\"\u003eSize 20inch : 53cm x 35cm x 21cm, nặng 2.5kg, đựng được 7-10kg hành lý - Xách tay được lên máy bay.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan class=\"_96e-7edee3 undefined d7e-d87aa1 d7e-fb1c84\"\u003eSize 24inch : 65cm x 42cm x 25cm, nặng 3.4kg, Ký gửi hành lý Có thể đựng 12 đến 22kg hành lý.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003eSize 28\u003cspan class=\"_96e-7edee3 undefined d7e-d87aa1 d7e-fb1c84\"\u003einch\u003c/span\u003e : 73cm x 48cm x 28cm, nặng 4.4kg, Ký gửi hành lý Có thể đựng 22 đến 32kg hành lý.\u003c/p\u003e\n\u003cp\u003e2. Kiểu dáng sáng tạo, độc đáo:\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003eChiếc vali NiceVilla sẽ thật nổi bật và không lẫn vào đâu được bởi thiết kế từng đường cong tạo trên bề mặt sản phẩm, đem lại cảm giác vừa thanh lịch vừa cá tính, năng động và rất dễ dàng trở thành tâm điểm độc đáo giữa đám đông.\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003eChất liệu 100% nhựa PP chống va đập tốt\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003eĐược hoàn thiện bởi 100% chất liệu nhựa PP cao cấp, với ưu điểm vượt trội về tính đàn hồi ấn tượng giúp sản phẩm chống va đập, chống nước và chịu lực rất hiệu quả. Ngoài ra với thiết kế bề mặt nhám giúp hạn chế trầy xước và dễ dàng vệ sinh sản phẩm. Với những tính năng nổi bật từ chất liệu cao cấp.\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/14/e6/0a/a25ec1fbca3814540a2d385f3326c2eb.jpg\" alt=\"\" width=\"750\" height=\"509\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/83/0d/91/dce28440ad18243eac7742d255ccd6ff.jpg\" alt=\"\" width=\"750\" height=\"509\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/7a/1c/1d/cf79bb7bd038a9419c46ff2039bc144f.jpg\" alt=\"\" width=\"750\" height=\"509\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/22/e9/9e/0f2c306929613e16c55c5081281cec30.jpg\" alt=\"\" width=\"750\" height=\"509\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e3. Bánh xe đôi chống ồn hiệu quả\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003eVali NiceVilla được trang bị hệ thống bánh xe đôi với khả năng chịu lực cực tốt trên 4 trục xoay, toàn bộ trọng lực bên trên sẽ được phân tán đều qua các tiếp điểm với mặt đường. Bên cạnh đó vỏ bánh xe làm bằng cao su thiên nhiên đúc nguyên khối, bọc quanh khung nhựa cứng có lỗi cốt thép đặc bên trong, hạn chế ma sát với mặt đường, hỗ trợ điều hướng vali, giúp di chuyển sản phẩm êm ái, không gây tiếng ồn.\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/9a/39/e7/825bdc89e1a52f4b9a2af53697d72e58.jpg\" alt=\"\" width=\"750\" height=\"512\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e4. Khóa số âm kim loại bảo mật hành lý 100%\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003eĐược thiết kế âm vào bề mặt vali chống cạy, chống dò số hiệu quả.\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/bf/33/de/b5b3f4c3fba3e42b22b58a8475279938.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/2b/8d/6e/c1a1643c2a3ad92cdab905807e1293b7.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e5. Cần kéo phân nấc thông minh\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003eSở hữu thiết kế cần kéo hợp kim cao cấp với đặc tính siêu nhẹ và chịu được áp lực tốt, đặc biệt chất liệu này không bị oxy hóa, không lo rỉ sét. Với chức năng phân nấc tiêu chuẩn, cần kéo được điều chỉnh thay đổi chiều cao phù hợp với vóc dáng và nhu cầu của người sử dụng, giúp giảm thiểu nguy cơ các bệnh về cột sống.\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/b6/55/8f/9956fee011dc7817cf67a027c63c2ac9.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e6. Chính Sách Bảo Hành:\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e+ Bảo hành  dây kéo, khóa số, bánh xe, cần kéo\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e+ Nếu do lỗi sản xuất sẽ thay mới hoàn toàn.\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e+ Nếu sai quy cách sử dụng sẽ miển phí sửa chửa và tính phí phụ kiện.\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e7. Thời Gian Bảo Hành:\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e+ Từ 1-2 tuần: Nếu không thay phụ kiện\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e+ Từ 3-5 tuần: Nếu có thay phụ kiện - Tuỳ vào loại phụ kiện và tình trạng có sẵn, một số loại phụ kiện đặc biệt cần nhập thêm sẽ có thời gian chính xác.\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e+ Bảo hành 03 năm\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/b2/07/d3/fd05832b3e7d7d71ffc2a28bded6392b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b2/07/d3/fd05832b3e7d7d71ffc2a28bded6392b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b2/07/d3/fd05832b3e7d7d71ffc2a28bded6392b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b2/07/d3/fd05832b3e7d7d71ffc2a28bded6392b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b2/07/d3/fd05832b3e7d7d71ffc2a28bded6392b.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/8a/a2/d3/d54e12f992f20d7ed67404613e06b79b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/8a/a2/d3/d54e12f992f20d7ed67404613e06b79b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/8a/a2/d3/d54e12f992f20d7ed67404613e06b79b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8a/a2/d3/d54e12f992f20d7ed67404613e06b79b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8a/a2/d3/d54e12f992f20d7ed67404613e06b79b.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/02/3e/f1/25c0f0265ecc21d0db815022838cc418.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/02/3e/f1/25c0f0265ecc21d0db815022838cc418.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/02/3e/f1/25c0f0265ecc21d0db815022838cc418.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/02/3e/f1/25c0f0265ecc21d0db815022838cc418.jpg","thumbnail_url":"h