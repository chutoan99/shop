":370383,"name":"Rule 1","slug":"rule-1"},"current_seller":{"id":113682,"sku":"8164381414546","name":"SUPVN Fitness","link":"https://tiki.vn/cua-hang/supvn-fitness","logo":"https://vcdn.tikicdn.com/ts/seller/e5/8b/e3/81687f7232305d86cfa16926da889b3b.jpg","price":1569000,"product_id":"273010878","store_id":105163,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Content","attributes":[{"code":"brand","name":"Thương hiệu","value":"Rule 1"},{"code":"brand_country","name":"Xuất xứ thương hiệu","value":"USA"},{"code":"has_food_safety_certificate","name":"Sản phẩm được Công bố và Chứng nhận an toàn vệ sinh thực phẩm","value":"Có"},{"code":"huong_dan_su_dung","name":"Hướng dẫn sử dụng","value":"\u003ch3\u003eCách sử dụng whey rule 1 một cách tối ưu nhất\u003c/h3\u003e\n\u003cp\u003eNgoài ra bao bì vỏ nhựa chắc chắn của dòng 5lbs sẽ bảo quản bột protein tốt hơn bao giờ hết. Nếu các bạn đã từng sử dụng loại 2.2kg hũ 5lbs thì lần sau hãy mua cho mình gói tiết kiệm hơn 10lbs, tiết kiệm về giá thành cũng như có hũ để bảo quản.\u003c/p\u003e\n\u003cp\u003eVới những điều nói ở trên, Cấu hình Protein tinh khiết dày dặn trong thành phần dinh dưỡng bao gồm chút tinh bột và không chất béo. Rất hoàn hảo cho những ai đang ở chế độ giảm mỡ, Cần một lượng Protein cấp cứu kịp thời mà không có tác dụng phụ nào đi kèm. Do được tách lọc bằng các vi lọc của Công nghệ \u003cem\u003eCross Flow microfiltration\u003c/em\u003e cho ra sự tinh khiết và không kèm bất cứ thành phần nào như\u003cem\u003e Lactose\u003c/em\u003e và\u003cem\u003e Gluten.\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003eKhả năng tiêu hóa nhanh còn có lợi rất nhiều sau quá trình tập luyện. Là một loại\u003cem\u003e Post Workout\u003c/em\u003e được rất nhiều người đánh giá cao cùng với đó là giá thành sản phẩm cũng rất dễ chịu, rẻ đối với người dùng. So với các đối thủ cùng phân khúc thì \u003cem\u003egiá thành \u003cstrong\u003eRule 1 Protein\u003c/strong\u003e\u003c/em\u003e đã làm rất tốt và tạo được thị trường tốt tại việt nam.\u003c/p\u003e\n\u003cp\u003eCách Dùng đơn giản như bao sản phẩm khác, pha một muỗng 28.9g và dùng ngay. Không cần pha nước nóng hoặc nước ấm. Thời điểm vàng khi dùng vào buổi sáng – Sau Tập và trong ngày nếu cần thiết.\u003c/p\u003e"},{"code":"main_ingredients","name":"Thành phần chính","value":"PROTEIN"},{"code":"origin","name":"Xuất xứ (Made in)","value":"USA"},{"code":"servings","name":"Số Lần Dùng","value":"76"},{"code":"thanh_phan","name":"Thành phần","value":"\u003cul\u003e\u003cli\u003eTỷ lệ Protein * là 87% – so với các thương hiệu hàng đầu.\u003c/li\u003e\u003cli\u003eWhey Protein tinh khiết cô lập 90% cùng với công thức protein kép của Rule 1.\u003c/li\u003e\u003cli\u003eWhey Protein kết hợp với BCAAs trong 1 Serving.\u003c/li\u003e\u003cli\u003eDễ hòa tan thậm chí với nước lạnh\u003c/li\u003e\u003cli\u003eKhông cô đặc chỉ đơn giản có nghĩa là đầu vào tốt hơn\u003c/li\u003e\u003cli\u003eCó bịch lớn 4.5kg giúp tiết kiệm thời gian và tiền bạc Rule 1 Protein 10lbs.\u003c/li\u003e\u003c/ul\u003e"},{"code":"Vegan","name":"Thuần chay","value":"Thuần chay"}]},{"name":"Operation","attributes":[{"code":"is_warranty_applied","name":"Sản phẩm có được bảo hành không?","value":"Không"},{"code":"product_weight","name":"Trọng lượng sản phẩm","value":"5Lbs"}]},{"name":"Cách sử dụng","attributes":[{"code":"how_to_use","name":"Hướng dẫn sử dụng","value":""}]}],"product_links":[],"gift_item_title":"0 quà tặng kèm","configurable_options":[{"code":"option1","name":"Hương vị","position":0,"show_preview_image":false,"values":[{"label":"Chocolate Peanut Butter"},{"label":"Cookies Cream"},{"label":"Frozen Banana"}]},{"code":"option2","name":"Tùy chọn","position":0,"show_preview_image":false,"values":[{"label":"Không kèm bình lắc"}]}],"configurable_products":[{"child_id":275454000,"discount_rate":0,"id":158853552,"images":[{"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/08/43/d0/e1c425414154b94bdbb771fc7d7f8