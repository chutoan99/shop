on"}},"discount":0,"discount_rate":0,"rating_average":2,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/6b/bd/58/0cf3d7556e154b641189e7d08b2afd0d.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1234,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"color: #333333;\"\u003e\u003cspan style=\"font-size: 24pt;\"\u003e\u003cstrong\u003eQuạt đảo trần Thái Lan Hatari HT-C16R1\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"color: #333333;\"\u003e\u003cspan style=\"font-size: 18pt;\"\u003eQuạt đảo trần Thái Lan Hatari HT-C16R1 thường được dùng trong các nhà hàng, văn phòng. Quạt đi kèm điều khiển từ xa sẽ thuận tiện trong việc điều chỉnh tốc độ gió bởi quạt được lắp ở vị trí trên cao.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"color: #333333;\"\u003e\u003cspan style=\"font-size: 18pt;\"\u003eQuạt đảo trần này \u003cstrong\u003ecó thể sử dụng cho quay hoặc dừng\u003c/strong\u003e để làm mát một vị trí nhất định được.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"color: #333333;\"\u003e\u003cspan style=\"font-size: 18pt;\"\u003eThiết kế kiểu dáng quạt hiện đại, màu sắc phù hợp với mọi không gian. Quạt đảo trần Hatari HT- C16R1 cũng phù hợp khi lắp đặt tại phòng khách hay phòng bếp tại gia đình bạn.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cspan style=\"font-size: 18pt;\"\u003e\u003cimg style=\"margin: 0 auto; display: block;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/73/03/ad/adc0630ef9899d92065a01209676928e.jpg\" /\u003e\u003c/span\u003e\u003cspan style=\"font-size: 18pt;\"\u003eHình ảnh quạt đảo trần Hatari HT- C16R1\u003c/span\u003e\u003c/p\u003e\n\u003ch2 style=\"font-size: 18px;\"\u003e\u003cspan style=\"font-size: 18pt;\"\u003eThông tin quạt Hatari HT- C16R1\u003c/span\u003e\u003c/h2\u003e\n\u003ch3\u003e\u003cspan style=\"font-size: 18pt;\"\u003eĐộ bền cao\u003c/span\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cspan style=\"font-size: 18pt;\"\u003eĐộng cơ chất lượng cao của các bóng mang hệ thống bôi trơn được bảo hành 3 năm. Không chỉ vậy, quạt đảo trần Hatari HT- C16R1 tăng tính an toàn cho người sử dụng với cầu trì nhiệt, đảm bảo cho thống tự động cắt giảm điện khi quạt gặp sự cố về điện áp.\u003c/span\u003e\u003c/li\u003e\n\u003cli\u003e\u003cspan style=\"font-size: 18pt;\"\u003eHơn nữa, quy trình sản xuất của sản phẩm được đảm bảo với chất lượng của hệ thống quản lý tiêu chuẩn: ISO 9001 và chứng nhận với tiêu chuẩn 934 -2533 và các sản phẩm tiêu chuẩn an toàn no.TIS 572-2528 từ Viện Tiêu chuẩn Công nghiệp Thái Lan.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003e\u003cspan style=\"font-size: 18pt;\"\u003eTrọng lượng nhẹ, quạt gió mạnh, độ ồn thấp\u003c/span\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cspan style=\"font-size: 18pt;\"\u003eCó trọng lượng 3,8 kg, khả năng quay 360 độ, tốc độ quay 1.300 vòng/phút nhưng quạt chạy rất êm nhẹ, không gây tiếng ồn sẽ mang đến cho gia đình bạn những giờ thư giãn trong làn gió mát lành.\u003c/span\u003e\u003c/li\u003e\n\u003cli\u003e\u003cspan style=\"font-size: 18pt;\"\u003eQuạt có nhiều chế độ gió với Remote (bộ điều khiển từ xa). Bằng cách chạm ngón tay vào remote, bạn dễ dàng điều chỉnh hướng quay của quạt theo ý muốn.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003e\u003cspan style=\"font-size: 18pt;\"\u003eCác chức năng dễ sử dụng từ điều khiển\u003c/span\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cspan style=\"font-size: 18pt;\"\u003e\u003cstrong\u003eON/OFF\u003c/strong\u003e (BẬT/TẮT). Nhấn nút để mở quạt, đèn tín hiệu sẽ sáng và hoạt động ở trạng thái cuối cùng của lần sử dụng trước khi tắt. Sau đó bấm lần nữa để tắt quạt.\u003c/span\u003e\u003c/li\u003e\n\u003cli\u003e\u003cspan style=\"font-size: 18pt;\"\u003e\u003cstrong\u003eSPEED\u003c/strong\u003e: TỐC ĐỘ. Nhấn nút để điều khiển tốc độ quạt theo mong muốn 1 (tốc độ chậm), 2 (tốc độ trung bình), 3 (tốc độ nhanh).\u003c/span\u003e\u003c/li\u003e\n\u003cli\u003e\u003cspan style=\"font-size: 18pt;\"\u003e\u003cstrong\u003eTIMER\u003c/strong\u003e: Cài đặt chế độ hẹn giờ 1, 2, 4, 8. Chỉ thực hiện được chế độ này thông qua điều khiển từ xa.\u003c/span\u003e\u003c/li\u003e\n\u003cli\u003e\u003cspan style=\"font-size: 18pt;\"\u003e\u003cstrong\u003eHẹn giờ tắt\u003c/strong\u003e: Bấm nút hẹn giờ tắt khi quạt đang hoạt động. \u003c/span\u003e\u003c/li\u003e\n\u003cli\u003e\u003cspan style=\"font-size: 18pt;\"\u003e\u003cstrong\u003eHẹn giờ bật\u003c/strong\u003e: Bấm nút hẹn giờ khi quạt đang không hoạt động (có cắm điện) để hẹn giờ mở. Và đến thời gian hẹn, quạt sẽ tự động mở ở trạng thái sử dụng trước khi tắt gần nhất. Đèn tín hiệu hẹn giờ sẽ hiển thị thời gian hoạt động còn lại theo thời gian giảm dần.\u003c/span\u003e\u003c/li\u003e\n\u003cli\u003e\u003cspan style=\"font-size: 18pt;\"\u003e\u003cstrong\u003eSWING\u003c/strong\u003e: Nhấn nút để chuyển hướng quay của quạt, nhấn lần nữa để tắt chế độ quay.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cspan style=\"font-size: 18pt;\"\u003e \u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"color: #333333; font-size: 16px;\"\u003e\u003cspan style=\"font-size: 18pt;\"\u003e\u003cimg title=\"Kích thước quạt đảo trần Hatari HT- C16R1\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/c6/e7/4d/ab3832fb80d38147c19a66f2b907bf0a.jpg\" alt=\"Quạt đảo trần\" width=\"1200\" height=\"900\" /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"color: #333333; font-size: 16px;\"\u003e\u003cspan style=\"font-size: 18pt;\"\u003eKích thước quạt đảo trần Hatari HT- C16R1\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cspan style=\"font-size: 18pt;\"\u003e\u003cimg style=\"margin: 0 auto; display: block;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/8a/98/ca/2362bedcf59a54f2b22c2c733af3bbc3.jpg\" /\u003e\u003c/span\u003e\u003cspan style=\"font-size: 18pt;\"\u003eQuạt đảo trần Hatari HT- C16R1 thiết kế bằng nhựa cứng chịu lực chắc chắn\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"color: #333333; text-align: center;\"\u003e\u003cspan style=\"font-size: 18pt;\"\u003e\u003cimg style=\"margin: 0 auto; display: block;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/70/4c/ff/5358890d1cd2cf7d54d0def8e7b97201.jpg\" /\u003e\u003c/span\u003e\u003cspan style=\"font-size: 18pt;\"\u003eĐộng cơ mạnh mẽ, đảm bảo độ bền và hiệu suất hoạt động liên tục\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cspan style=\"font-size: 18pt;\"\u003e\u003cimg style=\"margin: 0 auto; display: block;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/9c/50/f9/1f9c672faf793973abc928ceeb42c075.jpg\" /\u003e\u003c/span\u003e\u003cspan style=\"font-size: 18pt;\"\u003eKhả năng quay 360 độ, tốc độ quay 1.300 vòng/phút nhưng rất êm nhẹ\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"color: #333333; text-align: center;\"\u003e\u003cspan style=\"font-size: 18pt;\"\u003e\u003cimg style=\"margin: 0 auto; display: block;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/43/ff/46/7d6b74edd1a9f4946653cb4ce8e23a35.jpg\" /\u003e\u003c/span\u003e\u003cspan style=\"font-size: 18pt;\"\u003eQuạt có nhiều chế độ gió cho bạn lựa chọn\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cspan style=\"font-size: 18pt;\"\u003e\u003cimg style=\"margin: 0 auto; display: block;\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/59/37/20/50ec017b8b611bcaaacd707d2f945a93.jpg\" /\u003e\u003c/span\u003e\u003cspan style=\"font-size: 18pt;\"\u003eĐộng cơ chất lượng cao của các bóng mang hệ thống bô