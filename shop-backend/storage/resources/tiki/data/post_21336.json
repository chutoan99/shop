ull,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/40/0d/3b/0ba87f0a675fafa339b1056c910f8f82.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":350,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2\u003eThành phần nào có trong Clear Whey Protein\u003c/h2\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"ckimgrsz\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/46/9c/c0/c13fc9197c476d8f8310d66c8adaab1f.jpg\" alt=\"cleat-whey-protein-cung-cap-nang-luong-cho-hoat-dong-song\" width=\"900\" height=\"506\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003eCung cấp năng lượng cho cơ bắp\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003eTrong một muỗng sản phẩm 25g có chứa: 90 calo: Như chúng ta đều biết calo là đơn vị được dùng để tính năng lượng có trong các loại thực phẩm. Nó xuất hiện trong hầu hết tất cả thức ăn mà chúng ta nạp vào cơ thể mỗi ngày( cơm, bánh mì, ức gà,...) giúp duy trì mọi hoạt động của cơ thể như: ngủ, tập thể dục, học bài,.... 0.12g chất béo thuộc top nhóm chất dinh dưỡng đa lượng, có mặt trong khẩu phần ăn của con người. Nó đóng vai trò quan trọng trong việc xây dựng cấu trúc cơ thể, đồng thời dự trữ và cung cấp năng lượng cho cơ bắp và các hoạt động sống của con người. 1.01g carbohydrates có vai trò vô cùng quan trọng trong việc cung cấp nhiên liệu cho hệ thần kinh trung ương. Không những thế thành phần này còn tiếp năng lượng cho cơ bắp làm việc, giúp cho các chất béo được chuyển hóa và hỗ trợ hoạt động của não bộ.\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"ckimgrsz\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/bc/82/c4/e86944276a7a0cf1bc5243dfecd93509.jpg\" alt=\"cleat-whey-protein-bcaa-va-luong-protein-tinh-khiet\" width=\"900\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003eBổ sung các amino axit giúp cho việc tập luyện\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003eCó đến 21.27g protein: Liệu bạn có biết protein chính là thành phần cấu trúc tạo nên khung tế bào. Bên cạnh đó nó còn tham gia vào mọi hoạt động bên trong tế bào nhằm duy trì hoạt động sống của cơ thể và giúp cơ bắp săn chắc, khỏe khoắn hơn. Và bổ sung thêm 4874mg BCAA là chuỗi axit amin mà cơ thể không thể tự tổng hợp. Vì vậy, để bổ sung chất này cho cơ thể phải thông qua đường ăn uống hoặc sử dụng thực phẩm chức năng. Theo nghiên cứu, thì chỉ có một số loại axit amin có thể kích thích tế bào cơ phát triển, mà BCAA lại bao gồm 3 nhân tố quan trọng nhất là Leucine, Isoleucine, Valine. Chính vì lẽ đó đây là một trong những thành phần được những người tập gym thường xuyên tìm kiếm và bổ sung.\u003c/p\u003e\n\u003ch3\u003eTại sao bạn nên lựa chọn Clear Whey Protein ?\u003c/h3\u003e\n\u003cp\u003eMỗi thành phần trong Clear Whey Protein  đều phải trải qua quá trình giám sát và kiểm tra chất cấm vô cùng nghiêm ngặt trước khi sản xuất. Sau đó, sản phẩm sẽ được sản xuất đóng gói tại phòng thí nghiệm được công nhận ISO 22000, BRC, GMP \u0026amp; Halal để mang đến mức độ đảm bảo cao nhất cho các vận động viên sử dụng.\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"ckimgrsz\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/9a/e1/36/fb8d581052980c88cb768e7a2005fbf6.jpg\" alt=\"cleat-whey-protein-kiem-soat-nghiem-ngat\" width=\"900\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003eSản phẩm được sử dụng cho vận động viên\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003eVới mong muốn trở thành thương hiệu thực phẩm dinh dưỡng đáng tin cậy nhất thế giới, mọi quá trình trong khâu sản xuất của Applied Nutrition đều được đảm bảo nghiêm ngặt. Nhờ vậy, có thể cho ra đời những sản phẩm bổ sung chất lượng bậc nhất hiện nay.\u003c/p\u003e\n\u003cp\u003eKhông ngừng theo đuổi sự hoàn hảo, đơn vị này luôn cố gắng làm mới sản phẩm bằng cách tạo ra đa dạng hương vị cũng như nâng cao chất lượng sản phẩm. Những đứa con tinh thần của Applied Nutrition đã có mặt ở trên 65 quốc gia và được sử dụng bởi các vận động viên ưu tú trên thế giới. Một số cái tên tiêu biểu như: Dennis McCann, Natasha jonas, Jazza Dickens,...\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"ckimgrsz\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/66/6c/21/d966a4fe95f54653af35ea4244498491.jpg\" alt=\"cleat-whey-protein-co-6-loai-huong-vi\" width=\"900\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003eSản phẩm có hương vị hấp dẫn\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003eTheo thông tin mà nhà sản xuất cung cấp sản phẩm này có hương vị tương tự nước trái cây với 6 vị khác nhau bao gồm: Cherry \u0026amp; Apple, Cranberry \u0026amp; Pomegranate, Grapefruit, Orange \u0026amp; Squash, Strawberry \u0026amp; Lime, Strawberry and Raspberry, Twirler Ice cream, Watermelon. Bây giờ bạn có thể thỏa thích lựa chọn hương vị phù hợp với khẩu vị của mình.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/40/0d/3b/0ba87f0a675fafa339b1056c910f8f82.jpg","is_g