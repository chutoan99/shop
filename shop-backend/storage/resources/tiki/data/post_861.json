nt":13,"review_text":"(13)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/38/33/19/0ac8e2cdcd25e651528ac316c6f6c105.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":567,"all_time_quantity_sold":113,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003carticle class=\"4ever-article\"\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/38/33/19/71ddb860acf8a3c71ace25d40b121419.png\" alt=\"383319d7f78721eef3d43c36753ae9a4.png\" /\u003eI. GIỚI THIỆU SẢN PHẨM:\u003c/p\u003e\n\u003cp\u003eMang thương hiệu và công nghệ Philips của châu Âu, đèn bán nguyệt BN001C ra mắt năm 2022 với chất lượng sáng cao và hiệu suất vượt trội. Góc chiếu rộng, ánh sáng mạnh và đều hơn gấp 3 lần so với đèn huỳnh quang. \u003c/p\u003e\n\u003cp\u003e Thiết kế thanh lịch: Đầu đẻn mỏng ốp tường và ốp trần rất đẹp. \u003c/p\u003e\n\u003cp\u003e Lắp đặt dễ dàng và linh hoạt: Dây nối thông minh kèm theo móc cài hỗ trợ lắp nổi trên tường hoặc treo trần\u003c/p\u003e\n\u003cp\u003e Kết cấu chắc chắn: Vỏ đèn nhựa tổng hợp nguyên khối đảm bảo an toàn chịu được va đập\u003c/p\u003e\n\u003cp\u003e Hỗ trợ kỹ thuật: Dịch vụ tư vấn và bảo hành sau khi mua 12 tháng.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eII. THÔNG SỐ SẢN PHẨM:\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e Loại 20W: \u003c/p\u003e\n\u003cp\u003e+ Kích thước: 60cm x 7cm x 2.7cm. \u003c/p\u003e\n\u003cp\u003e+ Độ sáng: 2100 lumen.\u003c/p\u003e\n\u003cp\u003e+ Màu ảnh sáng: Trắng sáng (6500K)/ Trung tính (4000K)/ Vàng ấm (3000W).\u003c/p\u003e\n\u003cp\u003e+ CRI - Độ hoàn màu: \u0026gt; 80.\u003c/p\u003e\n\u003cp\u003e+ Tuổi thọ: 20.000h.\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/35/d9/98/6f707da7ebbfe61891dc62bf24e5e678.png\" alt=\"35d99845742953e8e95765d3f5ebbf37.png\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e Loại 40W: \u003c/p\u003e\n\u003cp\u003e+ Kích thước: 120cm x 7cm x 2.7cm.\u003c/p\u003e\n\u003cp\u003e+ Độ sang: 3900 lumen.\u003c/p\u003e\n\u003cp\u003e+ Màu ánh sáng: Trắng sáng (6500K)/ Trung kính (4000K)/ Vàng ấm (3000W).\u003c/p\u003e\n\u003cp\u003e+ CRI - Độ hoàn màu: \u0026gt; 80.\u003c/p\u003e\n\u003cp\u003e+ Tuổi thọ: 20.000h.\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/8e/63/cb/08f99220988758cde2d475a477f51601.png\" alt=\"8e63cbed437fc261d9fbf73cc6625771.png\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eDùng tốt cho cả nhà ở - văn phòng - cửa hàng - bãi đậu xe.\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/78/4e/5a/39395770dc7c4f0f42e0b697974a3370.png\" alt=\"784e5afcfcbd2cc20a3fd8e5c9b06b02.png\" /\u003e\u003c/p\u003e\n\u003cp\u003e____________________\u003c/p\u003e\n\u003cp\u003ePhilips là thương hiệu đèn lâu đời nhất của tập đoàn Philips Lighting, thành lập tại Eindhoven, Hà Lan vào năm 1891, tự hào cung cấp những sản phẩm chiếu sáng chất lượng hàng đầu thế giới trong suốt hơn 130 năm qua. Năm 2016, Philips Lighting tách khỏi tập đoàn Hoàng Gia Philips, trở thành một tập đoàn riêng biệt và vào năm 2018 chính thức đổi tên thành Signify với ý nghĩa ánh sáng có thể kết nối và truyền tải thông điệp.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e#Philips #LEDBatten #đènLED #Bannguyet\u003c/p\u003e\n\u003c/article\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/38/33/19/0ac