1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":true,"return_reason":"any_reason"}},"discount":151691,"discount_rate":5,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/df/27/46/e9d201c3b3fbb9b072b7d5f3d7b8462b.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":789,"all_time_quantity_sold":4,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2 style=\"text-align:left;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/85/bb/b7/0edd96c2080ef65d86c6cd4582fec26d.png\" alt=\"\" width=\"750\" height=\"499\" /\u003e\u003c/h2\u003e\n\u003ch2 style=\"text-align:center;\"\u003eĐể mọi người lắng nghe âm nhạc của bạn\u003c/h2\u003e\n\u003cp\u003eÂm thanh khuếch đại, chất âm chuyên nghiệp trong một thiết kế khiêm tốn. Hiệu ứng tuyệt vời, khơi nguồn sáng tạo. Tất cả mọi thứ bạn cần để tạo ra một kiểu âm sắc của riêng mình.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/0d/4f/b1/01b72122ac848d14d03612fcf7a31466.png\" alt=\"\" width=\"750\" height=\"499\" /\u003e\u003c/p\u003e\n\u003ch2 style=\"text-align:center;\"\u003eNhạc cụ khơi nguồn cảm hứng và ghi dấu khoảnh khắc\u003c/h2\u003e\n\u003cp\u003eBộ Arpeggiator tích hợp truyền cảm hứng cho những ý tưởng mới, tạo giai điệu và nhịp điệu, và để giúp bạn trở thành phù thủy âm nhạc, sử dụng tính năng Ghi âm để \u0026amp;quot;loop\u0026amp;quot; lặp nhạc, phát lại và ghi âm. Kết nối với bộ ghi âm tại nhà và khám phá khả năng của PSS-A50, trở thành người bạn đồng hành âm nhạc đáng tin cậy của bạn.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/8e/94/8a/1aee845f8822e3423db63fdcf5eac8cd.png\" alt=\"\" width=\"750\" height=\"499\" /\u003e\u003c/p\u003e\n\u003ch1 style=\"text-align:center;\"\u003eTÍNH NĂNG\u003c/h1\u003e\n\u003ch3\u003eKhông có gì cản trở bạn\u003c/h3\u003e\n\u003cp\u003eChất lượng âm thanh của Yamaha đặt ra tiêu chuẩn trong ngành và công nghệ Yamaha đã đổi mới cách sản xuất âm nhạc. Chức năng arpeggio tạo ra các tiết tấu và nhịp điệu khi chạm vào phím đàn, hiệu ứng Motion sửa đổi \u0026amp;quot;Tiếng\u0026amp;quot;, và chức năng thu âm tiết tấu tạo vòng lặp và phát lại các tiết tấu đã ghi.\u003cbr /\u003eThưởng thức sự kết hợp của âm thanh và công nghệ trên PSS-A50 và khơi nguồn cảm hứng để tìm kiếm âm sắc riêng cho bạn.\u003c/p\u003e\n\u003ch3\u003eMọi lúc, mọi nơi\u003c/h3\u003e\n\u003cp\u003ePSS-A50 chạy bằng bốn pin AA hoặc pin di động USB, giúp bạn dễ dàng mang theo trên những chuyến đi, buổi biểu diễn nhỏ, tiệc BBQ tại sân vườn hoặc thậm chí là phòng thu âm.\u003cbr /\u003eCáp nguồn USB đi kèm cho phép bạn cắm vào máy tính hoặc ổ cắm AC khi không có pin.\u003cbr /\u003e* Vui lòng sử dụng pin di động USB có chức năng ở chế độ dòng điện thấp và có thể cung cấp điện cho các thiết bị có mức tiêu thụ dòng điện từ 40 mA trở xuống.\u003c/p\u003e\n\u003ch3\u003eKết nối máy tính\u003c/h3\u003e\n\u003cp\u003eKết nối PSS-A50 với máy tính để thử nghiệm các nhạc cụ ảo và phần mềm sản xuất nhạc - không có giới hạn của sự sáng tạo.\u003cbr /\u003e*Phần mềm được bán riêng\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/28/5c/ea/3104e1d165d0f8866d3671fcceb4d1fb.png\" alt=\"\" width=\"750\" height=\"499\" /\u003e\u003c/p\u003e\n\u003ch3\u003eCảm nhận độ chuyên nghiệp\u003c/h3\u003e\n\u003cp\u003eNhạc cụ keyboard mini chất lượng cao PSS-A50 thừa hưởng từ dòng Reface của Yamaha, được các chuyên gia đánh giá cao về độ nhạy phím và sức mạnh biểu cảm vượt trội.\u003cbr /\u003eThuần thục các hợp âm phức tạp, các tiết tấu khó, chơi các đoạn nhạc nhanh và giai điệu đầy cảm xúc, dám thách thức cả những người chơi chuyên nghiệp; PSS-A50 là nhạc cụ keyboard cần thiết để bạn phát huy tối đa tiềm năng của mình.\u003c/p\u003e\n\u003ch3\u003eTách biệt thế giới\u003c/h3\u003e\n\u003cp\u003eKhi bạn muốn bước vào thế giới âm nhạc của mình và tách biệt khỏi bên ngoài, chỉ cần cắm tai nghe yêu thích, chế độ tự động tắt loa tích hợp, mang lại cho bạn sự riêng tư mong muốn.\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cstrong\u003eTHÔNG SỐ KỸ THUẬT\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eNhạc cụ keyboard mini cảm ứng lực chất lượng cao\u003c/li\u003e\n\u003cli\u003e42 Tiếng (nhạc cụ)\u003c/li\u003e\n\u003cli\u003e138 loại Arpeggio khác nhau\u003c/li\u003e\n\u003cli\u003eChức năng thu âm tiết tấu (Phrase recorder)\u003c/li\u003e\n\u003cli\u003eHiệu ứng Motion\u003c/li\u003e\n\u003cli\u003eTích hợp cổng kết nối USB-MIDI\u003c/li\u003e\n\u003cli\u003eNhẹ và nhỏ gọn\u003c/li\u003e\n\u003cli\u003eGiắc cắm loa / tai nghe có sẵn\u003c/li\u003e\n\u003cli\u003eCấp nguồn bằng pin và cáp USB (bộ chuyển nguồn USB bán riêng)\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eBỘ SẢN PHẨM GỒM: Đàn (1), (1) hướng dẫn sử dụng,(1) dây cáp USB, (1)thẻ đăng ký người sử dụng \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/df/27/46/e9d201c3b3fbb9b072b7d5f3d7b8462b.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/df/27/46/e9d201c3b3fbb9b072b7d5f3d7b8462b.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/df/27/46/e9d201c3b3fbb9b072b7d5f3d7b8462b.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/df/27/46/e9d201c3b3fbb9b072b7d5f3d7b8462b.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/df/27/46/e9d201c3b3fbb9b072b7d5f3d7b8462b.png"},{"base_url":"https://salt.tikicdn.com/ts/product/28/5c/ea/efda12becedb738ead3a7c78d020012a.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/28/5c/ea/efda12becedb738ead3a7c78d020012a.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/28/5c/ea/efda12becedb738ead3a7c78d020012a.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/28/5c/ea/efda12becedb738ead3a7c78d020012a.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/28/5c/ea/efda12becedb738ead3a7c78d020012a.png"},{"base_url":"https://salt.tikicdn.com/ts/product/0a/f5/03/c44bc882dd914334eef7a64743e37f25.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0a/f5/03/c44bc882dd914334eef7a64743e37f25.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/0a/f5/03/c44bc882dd914334eef7a64743e37f25.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0a/f5/03/c44bc882dd914334eef7a64743e37f25.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x28