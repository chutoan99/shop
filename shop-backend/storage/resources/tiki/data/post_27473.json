c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eCách dùng:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eDiệt muỗi, kiến, gián: Cứ 5ml pha với 0,5 lít nước, phun 10 m2 bề mặt, tường, vách, cống rãnh, phun kỹ các khe kẽ nơi côn trùng hay trú đậu.\u003c/li\u003e\n\u003cli\u003eDiệt ruồi: Cứ 5 ml pha với 0,5 lít nước phun 5 m2 bề mặt, bãi rác, nhà tiêu, các nơi ruồi cư trú. Hiệu lực kéo dài 6-8 tuần sau 1 lần phun.\u003c/li\u003e\n\u003cli\u003eDiệt bọ chét: Cứ 5ml pha với 2 lít nước, phun kỹ bề mặt hốc kẽ nơi bọ chét trú ẩn và qua lại. Phun 2 lần, mỗi lần cách nhau 10 ngày.\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/media/catalog/product/h/a/hantox50ml.u5530.d20170804.t112610.263437.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/h/a/hantox50ml.u5530.d20170804.t112610.263437.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/h/a/hantox50ml.u5530.d20170804.t112610.263437.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/h/a/hantox50ml.u5530.d20170804.t112610.263437.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/h/a/hantox50ml.u5530.d20170804.t112610.263437.jpg"}],"warranty_policy":null,"brand":{"id":145651,"name":"Hanvet","slug":"hanvet"},"current_seller":{"id":231263,"sku":"8737864200754","name":"Kun Miu Plus Now","link":"https://tiki.vn/cua-hang/kun-miu-plus-now","logo":"53/72/55/edd25e63c0b9728f92f5ca3d1a207615.jpg","price":26999,"product_id":"146630675","store_id":218295,"is_best_store":false,"is_offline_installment_supported":null},"o