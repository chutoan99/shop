":null,"icon_width":0,"icon_height":0,"text_color":"#FFF0F1","background_color":"#D93843","href":null,"text":"9.9"},{"placement":"pdp_badge","code":"is_hero","type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"freeship_xtra","type":"pdp_icon_badge","index":2,"icon":"https://salt.tikicdn.com/ts/upload/be/67/48/04a82ab8df178e1a13bde38316081865.png","icon_width":91,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":true,"return_reason":"any_reason"}},"discount":40000,"discount_rate":14,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/e9/43/1c/9a104140aee231ca0e14a20de5e6fa1d.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":512,"all_time_quantity_sold":9,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align:left;\"\u003e\u003cspan style=\"color:#000000;\"\u003e\u003cstrong\u003eCờ vua gỗ nam châm cao cấp- \u003c/strong\u003e\u003c/span\u003e\u003cspan style=\"color:#000000;\"\u003e\u003cstrong\u003eBộ cờ vua nam châm bằng gỗ thông tự nhiên - \u003c/strong\u003e\u003c/span\u003e\u003cspan style=\"color:#000000;\"\u003e\u003cstrong\u003eChính hãng D Danido\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align:left;\"\u003e\u003cspan style=\"color:#000000;\"\u003eCờ vua là môn thể thao phát huy trí tuệ logic, giúp trẻ hình thành tư duy xây dựng mục tiêu và chiến lược. Bàn cờ vua, quân cờ đều được làm bằng gỗ thông tự nhiên Có Gắn Nam Châm, đảm bảo chất lượng, giúp quân cờ và bàn cờ giữ được tốt hơn. Mở ra làm bàn, đóng lại là hộp đựng.\u003c/span\u003e\u003c/p\u003e\n\u003ch3 style=\"text-align:left;\"\u003e\u003cspan style=\"color:#000000;\"\u003eChất liệu\u003c/span\u003e\u003c/h3\u003e\n\u003cp style=\"text-align:left;\"\u003e\u003cspan style=\"color:#000000;\"\u003eGỗ Tự Nhiên An Toàn Tuyệt Đối Với Trẻ Em\u003c/span\u003e\u003c/p\u003e\n\u003ch3\u003eĐặc điểm nổi bật\u003c/h3\u003e\n\u003cul\u003e\n\u003cli style=\"text-align:justify;\"\u003eBộ cờ vua quốc tế gắn nam châm dùng luyện tập thi đấu phù hợp mọi đối tượng, đặc biệt là lứa tuổi trẻ nhỏ, em bé, học sinh.\u003c/li\u003e\n\u003cli style=\"text-align:justify;\"\u003eBề mặt bàn cờ màu được xử lý không bị bong tróc, phai mờm, được sơn chất lượng cao rõ ràng, không bị lem, không chứa formaldehyd.\u003c/li\u003e\n\u003cli style=\"text-align:justify;\"\u003eBàn cờ có thể gập lại thành hộp nhỏ gọn, có chốt hộp, dễ dàng cho việc mang đi. Phía mặt trong của hộp được bọc bằng nhung hoặc vải xốp, có khe để quân cờ, giúp cho việc bảo quản quân cờ được dễ dàng hơn\u003c/li\u003e\n\u003cli style=\"text-align:justify;\"\u003eBàn cờ vua, quân cờ đều được làm bằng gỗ thông tự nhiên, đảm bảo chất lượng, giúp quân cờ và bàn cờ giữ được tốt hơn.\u003c/li\u003e\n\u003cli style=\"text-align:justify;\"\u003eBàn và quân cờ được tích hợp từ tính (nam châm hút nhẹ, để nghiêng khoảng 45 độ), giúp cho quân cờ không bị xê dịch khi chơi.\u003c/li\u003e\n\u003cli style=\"text-align:justify;\"\u003eBàn cờ nhẹ, gọn, không cong gập, gấp thỏa mái có khóa cài nên giữ bộ cờ chắc chắn khi di chuyển\u003c/li\u003e\n\u003cli style=\"text-align:justify;\"\u003eChơi cờ vua Giúp phát triển trí thông minh và sự nhạy bén trong việc xử lý tình huống, cải thiện trí nhớ, tăng khả năng tập trung.\u003c/li\u003e\n\u003cli style=\"text-align:justify;\"\u003eHọa tiết trên quân cờ và bàn cờ, kích thước, màu sắc, bộ cờ sai số có thể thay đổi nhỏ tùy theo lô sản xuất.\u003c/li\u003e\n\u003cli style=\"text-align:justify;\"\u003eQuân cờ thiết kế tinh xảo, đảm bảo độ nét trong các nét khắc – Không có lỗ dăm, phía dưới có miếng bọc giúp tránh làm xước bàn cờ.\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003eHướng dẫn sử dụng\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eCờ dành cho 2 người chơi, bàn cờ hình vuông chia đều thành 64 ô vuông. Mỗi người chơi sẽ có 16 quân cờ và lần lượt đi các quân cờ của mình sau khi đối thủ đi.\u003c/li\u003e\n\u003cli\u003eCờ Vua bao gồm 6 quân cờ là Vua, Hoàng Hậu, Xe, Tượng, Mã, Tốt. Mỗi quân cờ có nước đi khác nhau, tùy vào cách tính toán của người chơi, sử dụng quân cờ đúng lúc để có thể thắng đối phương.\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003eHướng dẫn chơi cờ\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eVua (ký hiệu Vua là K): Là quân cờ quan trọng nhất bàn cờ. Nếu để mất vua thì coi như thua ván chơi. Vua đi mỗi nước một ô (trừ trường hợp nhập thành), có thể đi ngang, đi dọc hoặc đi chéo. Mỗi lần di chuyển vua có thể ăn quân của đối phương nhưng không được đi vào vị trí quân của mình đang đứng\u003c/li\u003e\n\u003cli\u003eHậu (ký hiệu Vua Q): Đi ngang, đi dọc, đi chéo khắp bàn cờ. Hậu có thể ăn quân đối phương trên đường đi, nhưng không được phép đi vào vị trí quân mình đang đứng.\u003c/li\u003e\n\u003cli\u003eTượng (ký hiệu Vua B): Di chuyển theo đường chéo với ô có cùng màu. Tượng di chuyển tới ô còn trống, không có quân cản giữa đường hoặc di chuyển tới ô bị quân đối phương chiếm giữ (ăn quân)\u003c/li\u003e\n\u003cli\u003eMã (ký hiệu Vua N): Đi ngang 2 ô và đi dọc 1 ô ( hoặc đi dọc 2 ô và đi ngang 1 ô) cho mỗi nước đi theo dạng hình chữ L. Mã có thể di chuyển tới ô còn trống hay ô bị quân đối phương chiếm giữ (ăn quân). Quân mã không bị cản như trong cờ Tướng.\u003c/li\u003e\n\u003cli\u003eXe (ký hiệu Vua R): Đi ngang hoặc dọc khắp bàn cờ miễn không có quân khác cản trên đường đi. Hoặc di chuyển tới vị trí quân đối phương đang chiếm giữ nhưng không được vượt qua quân đang đứng ở ô đó (trừ trường hợp nhập thành)\u003c/li\u003e\n\u003cli\u003eTốt (không có ký hiệu): Di chuyển thẳng về phía trước, mỗi nước đi tới một ô còn trống. Riêng nước đi đầu tiên có thể đi 2 ô tùy ý. Tốt ăn quân theo đường chéo. Đặc biệt nếu tốt đi tới ô cuối cùng của đối phương thì sẽ được phong cấp thành Hậu hay các quân khác tùy chọn, nhưng không được phong cấp thành vua.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eĐặc biệt, hộp cờ cũng chính là bàn cờ, vì thế bạn có thể mang cờ đi đến nhiều nơi để giải trí mà không phải mang vác quá cồng kềnh, bạn chỉ cần mở hộp cờ, đặt các quân cờ lên và bắt đầu chơi.\u003c/p\u003e\n\u003ch3\u003eHướng dẫn bảo quản\u003c/h3\u003e\n\u003cp\u003eBảo quản sản phẩm nơi khô ráo, tránh tiếp xúc trực tiếp với ánh nắng.\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/b5/c0/43/baaa81c7f0b428062d01f1ea5fe3272b.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch3 style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/c0/6e/25/47f62ca9c0dfb7c95d293e3b015f399a.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/h3\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/4f/3a/ec/5a60c6136db9f43e257bb74682e30c3e.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/ce/b6/bd/69aac83f789f68973436546877c5f511.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch3 style=\"text-align:center;\"\u003e- Chất liệu: Gỗ thông gắn nam châm\u003c/h3\u003e\n\u003ch3 style=\"text-align:center;\"\u003e- Số quân cờ: \u003cspan style=\"color:#ff0000;\"\u003e32 quân đầy đủ (2 đội – 2 màu)\u003c/span\u003e\u003c/h3\u003e\n\u003ch3 style=\"text-align:center;\"\u003e- Chiều cao quân vua: 6.6cm và 7.8cm tương đương phân loại 34cm và 39cm\u003c/h3\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/fd/9b/3d/809e8b5e1af7edfe81bb4f62af058cdf.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/d0/9b/2b/1e1c755be9c8f7f7aa9e38184f242f08.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/8d/40/3a/367af2325ac5da54eccd98262e8f739b.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/4c/02/70/eacd08242e0b1126dfa111b131aec162.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e#covuanamcham #covua #trochoi #trochoichobe #trochoitritue #co\u003cbr /\u003e#chess #cờvua #internationalchess #namchâm #magne\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá t