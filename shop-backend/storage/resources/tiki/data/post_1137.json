ad/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.1,"review_count":10,"review_text":"(10)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/d7/f2/20/45fb402c75d87cfb1d2417c70363d182.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":650,"all_time_quantity_sold":69,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<h1><em><strong>Giới thiệu Gói 2 miếng rửa chén hạt nổi siêu sạch Scotch-Brite 3M CR-HNSS-G2</strong></em></h1>\n<p><strong><em>Gói 2 miếng rửa chén hạt nổi siêu sạch Scotch-Brite 3M CR-HNSS-G2</em></strong> được cấu tạo bởi những sợi cước đặc biệt, kết hợp chặt chẽ với hạt nổi mài đa góc cạnh sắc bền. Vì thế bạn có thể tiết kiệm được chi phí tối đa mà không tốn nhiều thời gian.</p>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/8d/eb/be/6dbee7810ba98994e8949a6b1ec22c4e.jpg?v&#61;1600227617772\" /></p>\n<h2><strong>Thông tin sản phẩm</strong></h2>\n<ul><li>Tên sản phẩm: <em><strong>Gói 2 miếng rửa chén hạt nổi siêu sạch Scotch-Brite 3M CR-HNSS-G2</strong></em></li><li>Mã hàng: <em><strong>CR-HNSS-G2</strong></em></li><li>Công dụng: Rửa chén, nồi, chảo, hoặc các vật dụng khác</li><li><strong>Sản xuất tại: Thái Lan</strong></li><li><strong>Thương hiệu: Scotch-Brite của 3M</strong></li><li>Màu sắc: Xanh</li><li>Thành phần: hạt mài Polyester, CaCO3, Vải không dệt Polyester, Polyamide, Cenllulose, Mút: polyurethane</li><li>Kích thước: 11.4 x 6.9 x 2.6 (cm)</li><li>Hạn sử dụng: 5 năm từ NSX</li></ul>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/19/15/81/1ea52073b203d369e8982702d5815787.jpg?v&#61;1600227628271\" /></p>\n<h2><strong>Thông tin nổi bật</strong></h2>\n<ul><li>Rửa sạch vết bẩn – lớp phủ đặc biệt trên bề mặt giúp loại bỏ các cặn bẩn bám dính và chống lại mùi khó chịu một cách hiệu quả.</li><li>Chà mạnh mẽ - lớp phủ hạt nổi trên bề mặt miếng rửa chén gúp làm sạch các vết bẩn cứng đầu.</li><li>Mút kháng khuẩn giúp ngăn chặn sự phát triển của vi khuẩn để giữ cho vệ sinh sạch sẽ.</li><li>Chống bám bẩn – Miếng rửa chén luôn sạch và không có vi khuẩn</li><li>Lấy đi mọi vết bẩn, vết khét đen, vết ố trên nồi, chảo, chén dĩa,</li><li>Tốc độ làm sạch nhanh gấp 3 lần so với sản phẩm thông thường</li><li>Đảm bảo vệ sinh ăn uống và sức khỏe cho gia đình bạn</li><li>Rửa chén nhanh gấp 3 lần nên bạn sẽ có nhiều thời gian hơn cho gia đình</li></ul>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/d9/7c/45/e4a9b27536557c57e20247eff60e9f36.jpg?v&#61;1600227637756\" /></p>\n<h2><strong>Hướng dẫn bảo quản</strong></h2>\n<ul><li>Rửa kỹ trước và sau mỗi khi sử dụng và vắt khô.</li><li>Có thể vệ sinh bằng máy rửa chén hoặc luộc với nước sôi.</li><li>Không dùng với lò vi sóng.</li></ul>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/39/1c/38/02e1c8c433e0e8254abe7c8bf6e3e1b1.jpg?v&#61;1600227713995\" /></p>\n<h2><strong>Thông tin thương hiệu</strong></h2>\n<p><strong><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/fa/d7/cf/c43228bc428520e588f5e5e228d0c7be.jpg?v&#61;1571196342254\" /></strong><em><strong>Scotch-Brite</strong></em> là thương hiệu gia dụng hàng đầu tại Mỹ của tập đoàn 3M (1902). Với hơn 56 nãm không ngừng nghiên cứu và phát triển, nhãn hàng <em><strong>Scotch-Brite</strong></em> mong muốn mang đến cho người tiêu dùng các sản phẩm chất lượng cao, góp phần bảo vệ sức khỏe cho mọi gia đình, từ miếng rửa chén được sử dụng hàng ngày cho đến cây lau nhà siêu tốc. Sản phẩm đã và đang được tin dùng ở hơn 200 quốc gia trên toàn thế giớ</p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/d7/f2/20/45fb402c75d87cfb1d2417c70363d182.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d7/f2/20/45fb402c75d87cfb1d2417c70363d182.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d7/f2/20/45fb402c75d87cfb1d2417c70363d182.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d7/f2/20/45fb402c75d87cfb1d2417c70363d182.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d7/f2/20/45fb402c75d87cfb1d2417c70363d182.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/67/5b/ab/700d48b1de57bbecaa9abb70f21b2a71.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/67/5b/ab/700d48b1de57bbecaa9abb70f21b2a71.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/67/5b/ab/700d48b1de57bbecaa9abb70f21b2a71.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/67/5b/ab/700d48b1de57bbecaa9abb70f21b2a71.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/67/5b/ab/700d48b1de57bbecaa9abb70f21b2a71.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/66/39/c6/881b0b90849d07e0a8ba84c83fe1e481.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/66/39/c6/881b0b90849d07e0a8ba84c83fe1e481.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/66/39/c6/881b0b90849d07e0a8ba84c83fe1e481.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/66/39/c6/881b0b90849d07e0a8ba84c83fe1e481.jpg","