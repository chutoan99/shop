m/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":35760,"discount_rate":6,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/cc/b4/8e/df1913a16952e868fca821c36e936743.png","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":261,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eLEGO MINECRAFT 21252 Đồ chơi lắp ráp Kho chế tạo trang bị (203 chi tiết)\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lpl9p0gg3fsf20\" width=\"1500\" height=\"1500\" alt=\"vn-11134208-7r98o-lpl9p0gg3fsf20\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lpl9p0gg4ucv23\" width=\"1500\" height=\"1500\" alt=\"vn-11134208-7r98o-lpl9p0gg4ucv23\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lpl9p0gg68xbed\" width=\"1500\" height=\"1500\" alt=\"vn-11134208-7r98o-lpl9p0gg68xbed\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lpl9p0gg922791\" width=\"1500\" height=\"1500\" alt=\"vn-11134208-7r98o-lpl9p0gg922791\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lpl9p0ggagmn5e\" width=\"1500\" height=\"1500\" alt=\"vn-11134208-7r98o-lpl9p0ggagmn5e\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lpl9p0ggbv73cd\" width=\"1500\" height=\"1500\" alt=\"vn-11134208-7r98o-lpl9p0ggbv73cd\" /\u003e\u003cimg src=\"https://cf.shopee.vn/file/vn-11134208-7r98o-lpl9p0ggd9rj1a\" width=\"1500\" height=\"1500\" alt=\"vn-11134208-7r98o-lpl9p0ggd9rj1a\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eKhám phá thế giới LEGO Minecraft với bộ Đồ chơi lắp ráp Kho chế tạo trang bị. Trở thành 1 rèn áo giáp và làm việc với đe, lò nung, đá mài và vạc chứa đầy dung nham. Hãy cẩn thận để không làm đổ dung nham lên những viên gạch đất nung quý hiếm nhé! Sau đó hãy tham gia cùng Alex khi cô ấy kiểm tra bộ giáp. Mở rương để tìm một chiếc rìu vàng, cây đinh ba ma thuật, thanh gươm bằng kim cương, tấm khiên và các tài nguyên thú vị khác khi băng qua cánh cổng Nether.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e• Bộ lắp ráp LEGO Minecraft hấp dẫn – Bộ lắp ráp kho chế tạo trang bị Minecraft mở ra cánh cửa dẫn bé đến những cuộc phiêu lưu sáng tạo trong Minecraft. Bộ trò chơi gồm các nhân vật minifigure Minecraft Alex và Armorsmith, 3 khu vực chế tạo, áo giáp và trang bị Minecraft, bao gồm một chiếc rìu vàng, 2 thanh gươm, 2 tấm khiên và một cây đinh ba quyền lực\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e• Gạch đất nung quý hiếm – Bộ trò chơi LEGO Minecraft này gồm các chi tiết chân thực như gạch đất nung được người chơi Minecraft đánh giá cao.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e• Quà tặng thù vị cho người hâm mộ Minecraft– Món đồ chơi xây dựng và hành động này có các nhân vật Minecraft quen thuộc, mang đến trải nghiệm y như trong trò chơi. Các bé có thể sưu tầm và kết hợp các bộ đồ chơi LEGO Minecraft khác nhau\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e• Biến thế giới Minecraft được biến thành hiện thực – Bộ LEGO Minecraft mang đến cho trẻ em một cách khác để thưởng thức trò chơi phổ biến, với công cụ, cảnh vật và các tính năng được hiện thực hóa nhờ khả năng sáng tạo thực tế của những viên gạch LEGO\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/cc/b4/8e/df1913a16952e868fca821c36e936743.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/cc/b4/8e/df1913a16952e868fca821c36e936743.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/cc/b4/8e/df1913a16952e868fca821c36e936743.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/cc/b4/8e/df1913a16952e868fca821c36e936743.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/cc/b4/8e/df1913a16952e868fca821c36e936743.png"},{"base_url":"https://salt.tikicdn.com/ts/product/07/16/e2/c2157297cca2e526c9ed9e8bf28bba65.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/07/16/e2/c2157297cca2e526c9ed9e8bf28bba65.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/07/16/e2/c2157297cca2e526c9ed9e8bf28bba65.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/07/16/e2/c2157297cca2e526c9ed9e8bf28bba65.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/07/16/e2/c2157297cca2e526c9ed9e8bf28bba65.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/0e/11/b9/7966cc1f7f05d95baacfcfa0eb301d1d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0e/11/b9/7966cc1f7f05d95baacfcfa0eb301d1d.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/0e/11/b9/7966cc1f7f05d95baacfcfa0eb301d1d.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0e/11/b9/7966cc1f7f05d95baacfcfa0eb301d1d.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/prod