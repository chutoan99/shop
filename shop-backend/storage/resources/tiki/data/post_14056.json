kground_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/9a/f4/04/3445486eb6ac9ebe2b8d699f87ad0d89.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1086,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch5\u003eThương hiệu Electrolux của Thụy Điển, sản phẩm được sản xuất tại Châu Âu đảm bảo về chất lượng và uy tín\u003c/h5\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/ee/5c/d1/cc7cb33e7bb0e7f49fb568016d216501.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/ee/5c/d1/cc7cb33e7bb0e7f49fb568016d216501.jpg\" alt=\"\" width=\"750\" height=\"416\" /\u003e\u003c/p\u003e\n\u003ch5\u003eBếp từ có 4 vùng nấu hoạt động với tổng công suất 7350W nấu nhanh 4 món cùng lúc\u003c/h5\u003e\n\u003cp\u003e\u003cstrong\u003eBếp từ 4 vùng nấu Electrolux EIV644\u003c/strong\u003e hoạt động với công suất bếp phía sau bên phải 2300/3200W, phía sau bên trái 2300/3200W và bếp phía trước bên phải 2300/3200W, phía trước bên trái 2300/3200W giúp nấu chín 4 món ăn cùng lúc nhanh chóng, tiện lợi.\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/ca/39/bf/377df392508271c99e14c9c439e7bd66.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/ca/39/bf/377df392508271c99e14c9c439e7bd66.jpg\" alt=\"\" width=\"750\" height=\"416\" /\u003e\u003c/p\u003e\n\u003ch5\u003eMặt kính Ceramic Eurokera chịu lực, chịu nhiệt và chống xước tốt dễ vệ sinh\u003c/h5\u003e\n\u003cp\u003eNhiệt năng được truyền tới đúng vị trí đặt nồi trong khi các vùng xung quanh luôn nguội và an toàn.\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/e9/f0/5a/96e17d3c7bf4a029a00deec5d8c36935.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/e9/f0/5a/96e17d3c7bf4a029a00deec5d8c36935.jpg\" alt=\"\" width=\"750\" height=\"416\" /\u003e\u003c/p\u003e\n\u003ch5\u003eGia nhiệt nhanh, làm chín thức ăn nhanh chóng, tiết kiệm thời gian nhờ chức năng Booster\u003c/h5\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/22/6f/9c/02278723cf7f0b7b543b64b542f64cc4.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/22/6f/9c/02278723cf7f0b7b543b64b542f64cc4.jpg\" alt=\"\" width=\"750\" height=\"416\" /\u003e\u003c/p\u003e\n\u003ch5\u003eBảng điều khiển cảm ứng nhanh nhạy, dễ thao tác kèm màn hình hiển thị rõ nét\u003c/h5\u003e\n\u003cp\u003eBạn có thể nhanh chóng điều chỉnh nhiệt độ bằng trượt cảm ứng DirectTouch. Ngoài ra, mỗi vùng nấu có một bảng điều khiển riêng biệt giúp bạn dễ dàng thay đổi chế độ nấu.\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/d3/41/17/dd1d0262628c4eeac0320cd80053ac34.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/d3/41/17/dd1d0262628c4eeac0320cd80053ac34.jpg\" alt=\"\" width=\"750\" height=\"416\" /\u003e\u003c/p\u003e\n\u003ch5\u003eBếp từ 4 vùng nấu lắp âm hiện đại, màu đen sang trọng, phù hợp mọi không gian bếp\u003c/h5\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/13/92/46/475d0212e526833eb408729e24609d3a.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/13/92/46/475d0212e526833eb408729e24609d3a.jpg\" alt=\"\" width=\"750\" height=\"416\" /\u003e\u003c/p\u003e\n\u003ch5\u003eCó chức năng khóa bảng điều khiển, khi kích hoạt sẽ làm vô hiệu hóa toàn bộ bàn phím\u003c/h5\u003e\n\u003cp\u003eNhờ đó, người dùng có lỡ bấm vào các phím cũng không làm thay đổi các cài đặt trước và gây nguy hiểm. \u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/9d/e3/48/bc4816495ecb6ed828405aa5937f8427.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/9d/e3/48/bc4816495ecb6ed828405aa5937f8427.jpg\" alt=\"\" width=\"750\" height=\"407\" /\u003e\u003c/p\u003e\n\u003cp\u003eBếp từ Electrolux được trang bị nhiều tính năng thông minh giúp tối đa an toàn khi sử dụng:\u003c/p\u003e\n\u003cp\u003e- Chức năng tự ngắt khi bếp nóng quá tải giúp đảm bảo nguồn điện luôn ở mức an toàn, tăng độ bền cho bếp và giữ an toàn cho người sử dụng.\u003c/p\u003e\n\u003cp\u003e- Thiết lập đèn báo nhiệt dư, cảnh báo nhiệt độ nấu không phù hợp với bếp giúp người dùng dễ dàng theo dõi và tùy chỉnh lại mức nhiệt, thay đổi nhiệt lượng nấu để sử dụng bếp an toàn, bền lâu hơn.\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/f9/74/02/49ce058bcb92a60113424c7cf6ae7c62.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/f9/74/02/49ce058bcb92a60113424c7cf6ae7c62.jpg\" alt=\"\" width=\"750\" height=\"374\" /\u003e\u003c/p\u003e\n\u003ch5\u003eChỉ sử dụng nồi, chảo có đế nhiễm từ\u003c/h5\u003e\n\u003cp\u003eKhi sử dụng bếp người dùng cần chọn nồi nấu, chảo thích hợp để nấu ăn tốt hơn.\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/60/10/ab/fdb4e7b54a2aac15a29a73df5bf7603b.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/60/10/ab/fdb4e7b54a2aac15a29a73df5bf7603b.jpg\" alt=\"\" width=\"750\" height=\"416\" /\u003e\u003c/p\u003e\n\u003cp\u003eBếp từ 4 vùng nấu Electrolux EIV644 sang trọng, đa dạng các chức năng, hỗ trợ tối đa và an toàn sử dụng cho người dùng.\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/57/75/d4/43f4e0f04ea463c69cb0ec2c099783f4.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/57/75/d4/43f4e0f04ea463c69cb0ec2c099783f4.jpg\" alt=\"\" width=\"750\" height=\"633\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/9a/f4/04/3445486eb6ac9ebe2b8d699f87ad0d89.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/9a/f4/04/3445486eb6ac9ebe2b8d699f87ad0d89.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/9a/f4/04/3445486eb6ac9ebe2b8d699f87ad0d89.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9a/f4/04/3445486eb6ac9ebe2b8d699f87ad0d89.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9a/f4/04/3445486eb6ac9ebe2b8d699f87ad0d89.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/07/ba/e1/38fb7fc919b5a1ea65f5c1953b6cc1af.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/07/ba/e1/38fb7fc919b5a1ea65f5c1953b6cc1af.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/07/ba/e1/38fb7fc919b5a1ea65f5c1953b6cc1af.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/07/ba/e1/38fb7fc919b5a1ea65f5c1953b6cc1af.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/07/ba/e1/38fb7fc919b5a1ea65f5c1953b6cc1af.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/40/8d/b5/7534530c06f61f895fb009495984e103.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/40/8d/b5/7534530c06f61f895fb009495984e103.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/40/8d/b5/7534530c06f61f895fb009495984e103.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/40/8d/b5/7534530c06f61f895fb009495984e103.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/40/8d/b5/7534530c06f61f895fb009495984e103.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/61/c9/0e/593c93290c