b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/04/e5/01/a9c330d97ed3e37d913b1234ea147d19.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2197,"all_time_quantity_sold":59,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"box-sizing: border-box; margin: 0px 0px 10px; color: #333333; font-size: 13px; text-align: justify; font-family: Arial, sans-serif;\"\u003e\u003cspan style=\"box-sizing: border-box; font-weight: bold;\"\u003eChai xịt baking soda 400ml Rocket được nhập khẩu trực tiếp từ Nhật Bản:\u003c/span\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli style=\"box-sizing: border-box; color: #333333; font-size: 13px; text-align: justify; font-family: Arial, sans-serif;\"\u003e\u003cspan style=\"box-sizing: border-box; font-weight: bold;\"\u003eThành phần:\u003c/span\u003e baking soda, là loại dung dịch tẩy rửa không sử dụng chất hoạt đồng bề mặt và cồn. Khi hòa tan trong nước tạo ra phản ứng trao đổi ion giúp làm sạch các vết bật cứng đầu.\u003cbr style=\"box-sizing: border-box;\" /\u003e\u003cspan style=\"box-sizing: border-box; font-weight: bold;\"\u003eCông dụng:\u003c/span\u003e tẩy sạch các đồ dùng trong gia đình như xoong nồi, bát đĩa, quạt điện, ….\u003cbr style=\"box-sizing: border-box;\" /\u003e\u003cspan style=\"box-sizing: border-box; font-weight: bold;\"\u003eHướng dẫn sử dụng:\u003c/span\u003e Vặn phần đầu của vòi phun về phía có kí hiệu mở. Bỏ phần nắp đậy vòi phun. Xịt đều vào vết bẩn ở khoảng cách 15 cm, sau đó lau sạch bằng khăn. Trong trường hợp làm sạch các vật dụng điện tử như máy điện thoại bàn, TV… thay vì xịt trực tiếp lên thiết bị, xịt vào khăn sau đó lau.\u003c/li\u003e\n\u003cli style=\"box-sizing: border-box; color: #333333; font-size: 13px; text-align: justify; font-family: Arial, sans-serif;\"\u003eSau khi sử dụng, vặn phần đầu của vòi phun về phía có kí hiệu đóng (x), đặt chai xịt ở nơi không có ánh sáng. Trường hợp lau rửa lò vi sóng: Xịt trực tiếp vào mặt trong của lò vi sóng, sau đó lau sạch. Xịt trực tiếp vào chất bẩn hoặc nơi có mùi, sau đó bật lò vi sóng khoảng 30s, rồi lau lại bằng khăn. Không sử dụng với thảm, các bề mặt được sơn, đồ nội thất, tường, sàn.\u003c/li\u003e\n\u003cli style=\"box-sizing: border-box; font-family: Arial, sans-serif; font-weight: 500; line-height: 1.1; color: #333333; font-size: 18px; text-align: justify;\"\u003eHàng nhập khẩu từ Nhật Bản. Sản xuất tại Nhật.\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch1 id=\"product-name\" class=\"item-name\" style=\"box-sizing: border-box; margin: 16px 0px 5px; font-family: Roboto, Helvetica, Arial, sans-serif; font-weight: 300; line-height: 30px; color: #333333; font-size: 24px;\"\u003eChai nước tẩy lồng máy giặt 400ml nội địa Nhật Bản\u003c/h1\u003e\n\u003cul\u003e\n\u003cli style=\"box-sizing: border-box; color: #333333; font-size: 13px; text-align: justify; font-family: Arial, sans-serif;\"\u003e\u003cspan style=\"box-sizing: border-box; font-weight: bold;\"\u003eCông dụng:\u003c/span\u003e Loại nước tẩy trắng được sử dụng cho quần áo để tẩy các vết bẩn, vết ố vàng, đồ ăn, vết máu, loại bỏ các vi khuẩn gây mùi khó chịu. Sử dụng với các loại chất liệu cotton, lanh, polyester, acrylic.\u003c/li\u003e\n\u003cli style=\"box-sizing: border-box; color: #333333; font-size: 13px; text-align: justify; font-family: Arial, sans-serif;\"\u003eHướng dẫn sử dụng:\u003c/li\u003e\n\u003cli style=\"box-sizing: border-box;\"\u003eGiặt máy: Cho nước tẩy vào cùng với nước giặt.\u003c/li\u003e\n\u003cli style=\"box-sizing: border-box;\"\u003eGiặt tay: Ngâm khoảng 30 phút (không quá 2 giờ), tráng lại bằng nước. Lượng sử dụng:\u003c/li\u003e\n\u003cli style=\"box-sizing: border-box;\"\u003eGiặt máy: 30L nước, dùng 70 ml nước tẩy.\u003c/li\u003e\n\u003cli style=\"box-sizing: border-box;\"\u003eGiặt tay: 5L nước, dùng 12 ml nước tẩy. 1L nước, dùng 10 ml nước tẩy.\u003c/li\u003e\n\u003cli style=\"box-sizing: border-box;\"\u003eChú ý khi sử dụng: Không sử dụng với nước nóng. Sau khi sử dụng, rửa tay bằng xà phòng.\u003c/li\u003e\n\u003cli style=\"box-sizing: border-box;\"\u003eNên sử dụng găng tay nếu tiếp xúc trong thời gian dài. Không sử dụng với lụa, chất pha nilon, vải polyurethane, acetate.\u003c/li\u003e\n\u003cli style=\"box-sizing: border-box; font-family: Arial, sans-serif; font-weight: 500; line-height: 1.1; color: #333333; font-size: 18px; text-align: justify;\"\u003eNhập khẩu trực tiếp từ Nhật. Sản xuất tại Nhật\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/04/e5/01/a9c330d97ed3e37d913b1234ea147d19.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/04/e5/01/a9c330d97ed3e37d913b1234ea147d19.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/04/e5/01/a9c330d97ed3e37d913b1234ea147d19.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/04/e5/01/a9c330d97ed3e37d913b1234ea147d19.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/04/e5/01/a9c330d97ed3e37d913b123