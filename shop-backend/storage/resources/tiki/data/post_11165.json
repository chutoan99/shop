ừ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/52/e7/31/d51a3525be10e3aca02fe60820c258da.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/52/e7/31/d51a3525be10e3aca02fe60820c258da.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/52/e7/31/d51a3525be10e3aca02fe60820c258da.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/52/e7/31/d51a3525be10e3aca02fe60820c258da.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/52/e7/31/d51a3525be10e3aca02fe60820c258da.jpg"}],"warranty_policy":null,"authors":[{"id":275469,"name":"TS.Nguyễn Văn Quyền","slug":"ts-nguyen-van-quyen"},{"id":4206181,"name":"Uyển Uyển","slug":"uyen-uyen"},{"id":4206183,"name":"Nguyễn Văn Quân","slug":"nguyen-van-quan"}],"current_seller":{"id":1213,"sku":"6595517088857","name":"Nhà Sách Quảng Lợi","link":"https://tiki.vn/cua-hang/lich-xuan-thang-long","logo":"9c/8f/db/d3d5b37058345d490a5ac537fc0296b8.jpg","price":40000,"product_id":"253182589","store_id":1172,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Thông tin chung","attributes":[{"code":"publisher_vn","name":"Công ty phát hành","value":"Công ty cổ phần sách Qbooks"},{"code":"publication_date","name":"Ngày xuất bản","value":"2023-04-21 13:59:36"},{"code":"book_cover","name":"Loại bìa","value":"Bìa mềm"},{"code":"number_of_page","name":"Số trang","value":"72"},{"code":"manufacturer","name":"Nhà xuất bản","value":"Nhà Xuất Bản Hà Nội"}]}],"product_links":[],"gift_item_title":"0 quà tặng kèm","services_and_promotions":[],"promitions":[],"stock_item":{"max_sale_qty":1000,"min_sale_qty":1,"preorder_date":null,"qty":1000},"quantity_sold":{"text":"Đã bán 18","value":18},"categories":{"id":2248,"name":"Sách tham khảo cấp I","is_leaf":true},"breadcrumbs":[{"url":"/nha-sach-tiki/c8322","name":"Nhà Sách Tiki","category_i