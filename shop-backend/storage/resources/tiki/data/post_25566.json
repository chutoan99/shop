or":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":31200,"discount_rate":20,"rating_average":5,"review_count":3,"review_text":"(3)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/e2/fb/18/d2ed63cf6a4c0b5e0ffc3a2e98b380b8.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1292,"all_time_quantity_sold":20,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ac/26/01/1c4d6cedae432a857aceaae3649b1b13.jpg\" alt=\"Combo 1 (4 Cuốn): Bé Yêu Kỹ Thuật Kết Cấu Công Trình + Bé Yêu Lực Hấp Dẫn + Bé Yêu Năng Lượng Xanh + Bé Yêu Nhiệt Động Lực Học\" width=\"750px\" height=\"500px\" /\u003e\u003c/p\u003e\u003cp\u003eÁnh nắng, nước, không khí và mặt trời có vai trò quan trọng như thế nào trong cuộc sống của bé? Bộ sách “Bé yêu ” sẽ giải thích khái niệm về việc làm thế nào bé lớn lên, tác dụng của thiên nhiên đối với sự lớn lên của bé.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eGiới thiệu tác giả\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eRuth Spiro là một tác giả sách thiếu nhi và là nhà văn tự do. Bà tốt nghiệp bằng Cử nhân Truyền thông của trường Đại học Illinois và tốt nghiệp Thạc sĩ Quản trị Kinh doanh trường Đại học Chicago tại Loyola. Cuốn sách đầu tay của bà, “Lester Fizz, Bubble-Gum Artist” đã giành được giải thưởng của các tổ chức Writer’s Digest và Willamette Writers và là cuốn sách hay nhất do Đại học Giáo dục Bank Street bình chọn.\u003c/p\u003e\n\u003cp\u003eCác bài báo, bài viết và câu chuyện của bà đã xuất hiện trên nhiều tạp chí và các tuyển tập. Bà là một diễn giả thường xuyên tại các trường học, hội sách và hội thảo, trong đó phải kể đến Hội thảo về STEM dành cho trẻ mầm non, Lễ hội sách của Thời báo Los Angeles, Hiệp hội Giáo dục Nghệ thuật Illinois…\u003c/p\u003e\n\u003cp\u003eBà sống cùng chồng và hai con gái tại Illinois.\u003c/p\u003e\n\u003cp\u003eIrene Chan là một họa sĩ, họa sĩ minh họa, và người thiết kế đồ họa của sách thiếu nhi, thiệp mừng, quà tặng, tranh tường…\u003cbr /\u003eCô là họa sĩ minh hoa của bộ sách “Bé yêu khoa học” (tác giả Ruth Spiro), “Những người phụ nữ bé nhỏ: Phiên bản kể lại theo phong cách hiện đại” (tác giả Laura Schaefer) và nhiều tựa sách khác.\u003c/p\u003e\n\u003cp\u003eCô sống cùng gia đình tại Atlanta, bang Georgia. \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/e2/fb/18/d2ed63cf6a4c0b5e0ffc3a2e98b380b8.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/e2/fb/18/d2ed63cf6a4c0b5e0ffc3a2e98b380b8.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/e2/fb/18/d2ed63cf6a4c0b5e0ffc3a2e98b380b8.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e2/fb/18/d2ed63cf6a4c0b5e0ffc3a2e98b380b8.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/e2/fb/18/d2ed63cf6a4c0b5e0ffc3a2e98b380b8.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/58/ad/96/cb36a92747b5c32f9583db28bd2b7627.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/58/ad/96/cb36a92747b5c32f9583db28bd2b7627.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/58/ad/96/cb36a92747b5c32f9583db28bd2b7627.jpg","position":null,"small_url":"https: