pload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/41/57/9a/feccbdd0b1e516157f22d0c79c74d9bd.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":0,"all_time_quantity_sold":14,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cspan style=\"font-size:medium;color:#008ab7\"\u003e\u003cstrong\u003eDung Dịch Tắm Gội Toàn Thân Cho Bé Dưới 3 Tuổi D-nee - Chai 800ml (Xanh Lá)\u003c/strong\u003e\u003c/span\u003e chứa thành phần tự nhiên giúp làm sạch cơ thể và nuôi dưỡng mái tóc của bé một cách an toàn hiệu quả. Sản phẩm có độ pH cân bằng không làm tổn hại làn da non nớt của trẻ nhỏ. Dung dịch tắm gội còn giúp lưu lại mùi hương dễ chịu cho bé suốt ngày thơm mát.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/12/2e/1d/c481d4426dcc2a7d2cef59a973c45613.jpg\" alt=\"\" width=\"750\" height=\"1000\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center\"\u003e\u003cem\u003e\u003cstrong\u003eLƯU Ý: BAO BÌ CÓ THỂ THAY ĐỔI, TÙY TỪNG THỜI ĐIỂM NHẬP HÀNG. \u003c/strong\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eCó chứa các thành phần tự nhiên như nước khoáng và vitamin E nuôi dưỡng, làm sạch nhẹ nhàng và giúp trẻ sơ sinh có làn da và mái tóc mềm mại.\u003c/li\u003e\u003cli\u003eĐộ pH cân bằng, được kiểm nghiệm không kích ứng da nên rất an toàn cho trẻ.\u003c/li\u003e\u003cli\u003eSản phẩm với công thức dịu nhẹ, làm sạch làn da và mái tóc cho trẻ, không làm cay mắt. Mẹ có thể vừa tắm vừa gội cho bé tiện dụng và an toàn.\u003c/li\u003e\u003cli\u003eHương thơm nhẹ dịu giúp trẻ thêm sảng khoái.\u003c/li\u003e\u003c/ul\u003e\n\u003ch3\u003eThành phần\u003c/h3\u003e\n\u003cp\u003eXem trên bao bì sản phẩm\u003c/p\u003e\n\u003ch3\u003eHướng dẫn sử dụng\u003c/h3\u003e\n\u003cul\u003e\u003cli\u003eLấy 1 lượng vừa đủ sữa tắm gội xoa lên tóc ướt.\u003c/li\u003e\u003cli\u003eMassage nhẹ nhàng quanh đầu bé để tạo bọt.\u003c/li\u003e\u003cli\u003eLấy 1 lượng sữa tắm gội vừa đủ thoa lên người bé để tạo bọt và kỳ cọ làm sạch cơ thể.\u003c/li\u003e\u003cli\u003eTương tự cho tắm như gội. Sau khi tắm nhớ lau khô và giữ ấm cho bé.\u003c/li\u003e\u003c/ul\u003e\n\u003ch3\u003eHướng dẫn bảo quản\u003c/h3\u003e\n\u003cul\u003e\u003cli\u003eBảo quản nơi khô ráo, thoáng mát.\u003c/li\u003e\u003cli\u003eTránh ánh nắng trực tiếp.\u003c/li\u003e\u003cli\u003eĐể xa tầm tay trẻ nhỏ.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eLưu ý: \u003c/strong\u003eTắm và gội Dnee thích hợp sử dụng cho trẻ dưới 3 tuổi. Để xa tầm tay các bé.\u003c/p\u003e\n\u003ch3\u003ePhân loại\u003c/h3\u003e\n\u003cul\u003e\u003cli\u003eDnee xanh lá là dòng sữa tắm chuyên dùng cho da thường. Sản phẩm có nồng độ PH cân bằng, giúp lưu giữ độ ẩm tự nhiên của làn da bé. Sữa tắm gội toàn thân em bé Dnee xanh lá chiết xuất từ 7 thành phần tự nhiên. Các chiết xuất hữu cơ trên đã được chứng minh có khả năng nuôi dưỡng làn da và mái tóc bé. an toàn đối với trẻ nhỏ.\u003c/li\u003e\u003cli\u003eDnee xanh dương chiết xuất từ: yến mạch, nước khoáng và Allantoin. Các chiết xuất có lợi này tạo nên lớp màng chắn, bảo vệ làn da khỏi các tác nhân gây kích ứng da. có hương thơm dịu nhẹ từ các thành phần tự nhiên, không chứa chất tạo mùi, Paraben, SLS, silicone, cồn và gluten. Do đó, sản phẩm đặc biệt phù hợp với các bé có làn da nhạy cảm, dễ bị kích ứng.\u003c/li\u003e\u003cli\u003eDnee hồng chứa các thành phần tự nhiên như: nước khoáng, dầu hướng dương và Vitamin E chuyên dành cho da khô, cung cấp đầy đủ độ ẩm cho làn da bé. Dnee hồng có thành phần chiết xuất từ hoa anh đào với mùi thơm ngọt dịu. Nhờ đó, bé có thể thoải sức chạy nhảy, vui chơi mà cơ thể vẫn lưu hương lâu suốt ngày dài.\u003c/li\u003e\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/41/57/9a/feccbdd0b1e516157f22d0c79c74d9bd.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/41/57/9a/feccbdd0b1e516157f22d0c79c74d9bd.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/41/57/9a/feccbdd0b1e516157f22d0c79c74d9bd.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/41/57/9a/feccbdd0b1e516157f22d0c79c74d9bd.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/41/57/9a/feccbdd0b1e516157f22d0c79c74d9bd.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/42/f8/eb/187b030ae5ca520f159ebf21233c3b19.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/42/f8/eb/187b030ae5ca520f159ebf21233c3b19.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/42/f8/eb/187b030ae5ca520f159ebf21233c3b19.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/42/f8/eb/187b030ae5ca520f159ebf21233c3b19.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/42/f8/eb/187b030ae5ca520f159ebf21233c3b19.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/12/2e/1d/39b0afc544b46fe8d0e656c268df442d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tik