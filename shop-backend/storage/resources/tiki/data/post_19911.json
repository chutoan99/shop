"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":50000,"discount_rate":2,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/media/catalog/product/t/s/ts9602 (2).u579.d20160607.t165123.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2754,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cspan style=\"font-size: medium; color: #0087ab;\"\u003e\u003cstrong\u003eLò Nướng Tiross TS9602 - 40L (Đen)\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\r\n\u003cp\u003e\u003cstrong\u003eLò Nướng Tiross TS9602 - 40L (Đen) \u003c/strong\u003etích hợp những tính năng hiện đại như nướng bằng thanh nhiệt, chế độ hẹn giờ 90 phút, cùng với đó là dung tích lớn 40L, cho bạn nướng được một lượng nhiều thức ăn, phục vụ nhu cầu cho bữa ăn gia đình hay các bữa tiệc. Sản phẩm có thiêt kế nhỏ gọn, đẹp mắt phù hợp với nhiều không gian bếp khác nhau giúp bạn thuận tiện hơn khi sử dụng.\u003c/p\u003e\r\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Lò Nướng Tiross TS9602 - 40L (Đen)\" src=\"http://tikicdn.com/media/catalog/product/t/s/ts9602%20(2)\" alt=\"Lò Nướng Tiross TS9602 - 40L (Đen)\" width=\"600\" height=\"430\" /\u003e\u003c/p\u003e\r\n\u003cp\u003e\u003cstrong\u003eMô tả tính năng\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp\u003e\u003cstrong\u003eLò nướng bằng thanh nhiệt\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp\u003e\u003cstrong\u003eLò Nướng Tiross TS9602 - 40L (Đen) \u003c/strong\u003esử dụng công nghệ nướng bằng thanh phát nhiệt, gồm 2 giàn bên trên và bên dưới giúp nướng chín đều thực phẩm, lưu giữ hương vị và chất dinh dưỡng có trong thực phẩm.\u003c/p\u003e\r\n\u003cp\u003e\u003cstrong\u003eNhiều chức năng thông minh\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp\u003eLò có mức điều chỉnh nhiệt độ từ 80 - 320 độ C, hẹn giờ đến 90 phút sẽ giúp bạn tiết kiệm được thời gian cho những công việc khác.\u003c/p\u003e\r\n\u003cp\u003eBạn có thể sử dụng sản phẩm để nướng nhiều loại bánh trái, thực phẩm khác nhau một cách dễ dàng và nhanh chóng giúp bạn tiết kiệm được công sức chuẩn bị.\u003c/p\u003e\r\n\u003cp\u003e\u003cstrong\u003eKhay hứng mỡ có thể tháo lắp\u003cbr /\u003e\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp\u003e\u003cstrong\u003eLò Nướng Tiross TS9602 - 40L (Đen) \u003c/strong\u003ethiết kế khay  hứng mỡ có thể tháo lắp tiện dụng, vỏ sơn tĩnh điện, khoang lò chống  dính dễ dàng vệ sinh. Cửa lò làm bằng thủy tinh cao cấp chịu nhiệt dễ  dàng quan sát món ăn.\u003c/p\u003e\r\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Lò Nướng Tiross TS9602 - 40L (Đen)\" src=\"http://tikicdn.com/media/catalog/product/t/s/ts9602%20(3)\" alt=\"Lò Nướng Tiross TS9602 - 40L (Đen)\" width=\"600\" height=\"450\" /\u003e\u003c/p\u003e\r\n\u003cp\u003e\u003cstrong\u003ePhụ kiện đi kèm tiện dụng\u003cbr /\u003e\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp\u003e\u003cstrong\u003eLò Nướng Tiross TS9602 - 40L (Đen) \u003c/strong\u003ecó 3 mức tạo nhiệt tiện lợi cho sự lựa chọn mức nhiệt độ phù hợp với thực phẩm mà bạn chế biến. Phụ kiện đi kèm theo lò nướng: giá đỡ, khay nướng sẽ hỗ trợ bạn trong công việc nấu nướng.\u003c/p\u003e\r\n\u003cp\u003e\u003cstrong\u003eDung tích 40 L \u003c/strong\u003echo việc nấu nướng dễ dàng\u003c/p\u003e\r\n\u003cp\u003eCông suất 1300W, dung tích 40 lít, thức ăn sẽ được quay nướng vàng giòn mà không bị cháy khen hay ám mùi khói. Dung tích này phù hợp cho những gia đình có đông thành viên hoặc nướng các thức ăn dạng khối như gà, vịt…\u003c/p\u003e\r\n\u003cp\u003e\u003cstrong\u003eKiểu dáng đẹp mắt, sang trọng\u003c/strong\u003e\u003c/p\u003e\r\n\u003cp\u003e\u003cstrong\u003eLò Nướng Tiross TS9602 - 40L (Đen) \u003c/strong\u003ethiết kế hiện đại, màu sắc sang trọng tạo điểm nhấn nổi bật cho không gian sử dụng.\u003c/p\u003e\r\n\u003cp\u003eChất liệu chống bám bẩn, dễ lau chùi. Thiết kế nút điều khiển tiện lợi, dễ dàng cho người dùng điều chỉnh các chế độ.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/media/catalog/product/t/s/ts9602 (2).u579.d20160607.t165123.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/t/s/ts9602 (2).u579.d20160607.t165123.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/t/s/ts9602 (2).u579.d20160607.t165123.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/t/s/ts9602 (2).u579.d20160607.t165123.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/t/s/ts9602 (2).u579.d20160607.t165123.jpg"},{"base_url":"https://salt.tikicdn.com/media/catalog/product/t/s/ts9602 (1).u579.d20160607.t165123.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/product/t/s/ts9602 (1).u579.d20160607.t165123.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/product/t/s/ts9602 (1).u579.d20160607.t165123.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/product/t/s/ts9602 (1).u579.d20160607.t165123.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/me