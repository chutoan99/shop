843","href":null,"text":"9.9"},{"placement":"pdp_badge","code":"is_hero","type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"freeship_xtra","type":"pdp_icon_badge","index":2,"icon":"https://salt.tikicdn.com/ts/upload/be/67/48/04a82ab8df178e1a13bde38316081865.png","icon_width":91,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":true,"return_reason":"any_reason"}},"discount":36000,"discount_rate":51,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/d9/be/50/29c5ccfecf100ac2d5680be42a9af012.png","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":473,"all_time_quantity_sold":44,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e– Tên sách: Toán Tư Duy Beginning Creative Math (Dành Cho Bé 3-4 Tuổi Song Ngữ Việt Anh)\u003c/p\u003e\n\u003cp\u003e– Tác giả: Phạm Thị Thanh\u003c/p\u003e\n\u003cp\u003e– Số trang: 90 trang\u003c/p\u003e\n\u003cp\u003e– Nhà xuất bản: Hà Nội\u003c/p\u003e\n\u003cp\u003e– Khổ: 20,5 x 29 cm\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eToán Tư Duy (Dành Cho Trẻ Em 3-4 Tuổi) (Tái Bản 2023)\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eĐây là cuốn sách được biên soạn dựa trên chương trình Toán tư duy mới theo phương pháp giáo dục sớm dành cho trẻ em của Nhật Bản. Cuốn sách với các trò chơi tích hợp bài học toán sẽ khơi dậy tiềm năng toán học cho trẻ, giúp trẻ yêu thích môn toán và phát triển tư duy ngay từ khi còn nhỏ.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eCuốn sách giúp các bé làm quen với các khái niệm toán học ban đầu như phân biệt giống nhau – khác nhau, so sánh to – nhỏ, lớn – bé, dài – ngắn … làm quen với các con số, hình dạng, nối hình, phân loại logic …giúp trẻ rèn kĩ năng tập trung, tư duy logic và phán đoán giải quyết vấn đề linh hoạt.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eHọc và chơi cùng con sẽ giúp con thông minh hơn, học giỏi hơn và gắn kết tình cảm gia đình hơn.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eBộ sách được thiết kế với nhiều hoạt động \"Chơi mà học - Học mà chơi\" như Tô màu, Tô nét - Vẽ hình, Nối số, Dán sticker, nhằm kích thích tối đa sự phát triển của não bộ trẻ đồng thời giúp cho trẻ có những định hướng chính xác về tư duy thông qua các chủ đề như:\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e- Phân biệt Phương hướng - Vị trí\u003c/p\u003e\n\u003cp\u003e- Phân biệt Màu sắc - Hình khối cơ bản\u003c/p\u003e\n\u003cp\u003e- Quy luật cho bé - Tô màu hình khối\u003c/p\u003e\n\u003cp\u003e- Thứ tự trước sau - Số thứ tự\u003c/p\u003e\n\u003cp\u003e- Giới thiệu các số cơ bản từ 1 - 20 với các hoạt động vui chơi để nắm vững số đếm\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eĐây là thành quả của quá trình nghiên cứu và chuẩn bị lâu dài của đội ngũ biên soạn Tuan Viet Books. Đặc biệt, sách được thiết kế song ngữ Việt - Anh giúp bé có thể phát triển đa ngôn ngữ dễ dàng. Rất mong được ba mẹ và các bé đón nhận!\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/d9/be/50/29c5ccfecf100ac2d5680be42a9af012.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d9/be/50/29c5ccfecf100ac2d5680be42a9af012.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d9/be/50/29c5ccfecf100ac2d5680be42a9af012.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d9/be/50/29c5ccfecf100ac2d5680be42a9af012.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d9/be/50/29c5ccfecf100ac2d5680be42a9af012.png"},{"base_url":"https://salt.tikicdn.com/ts/product/38/e6/1f/62d130fdd95f6449dee1135551b0356b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/38/e6/1f/62d130fdd95f6449dee1135551b0356b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/38/e6/1f/62d130fdd95f6449dee1135551b0356b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/38/e6/1f/62d130fdd95f6449dee1135551b0356b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/38/e6/1f/62d130fdd95f6449dee1135551b0356b.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/d9/bc/16/f446911a7118c096a84ade3b1c271093.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d9/bc/16/f446911a7118c096a84ade3b1c271093.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d9/bc/16/f446911a7118c096a84ade3b1c271093.jpg","posi