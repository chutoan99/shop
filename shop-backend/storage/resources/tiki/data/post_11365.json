àng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/c5/c1/5c/a83fcfc61dc95c97cc0e0a5930c6f557.jpeg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c5/c1/5c/a83fcfc61dc95c97cc0e0a5930c6f557.jpeg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c5/c1/5c/a83fcfc61dc95c97cc0e0a5930c6f557.jpeg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c5/c1/5c/a83fcfc61dc95c97cc0e0a5930c6f557.jpeg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c5/c1/5c/a83fcfc61dc95c97cc0e0a5930c6f557.jpeg"}],"warranty_policy":null,"authors":[{"id":18780,"name":"Lý Cư Minh","slug":"ly-cu-minh"}],"current_seller":{"id":10821,"sku":"8685052819839","name":"nha sach nguyet linh","link":"https://tiki.vn/cua-hang/nha-sach-nguyet-linh","logo":"https://vcdn.tikicdn.com/ts/seller/88/2b/d0/eaa1eadc8566bf565288bb245d07f952.jpg","price":113050,"product_id":"273511893","store_id":10595,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[{"id":1308,"name":"Tazano Official Store","link":"https://tiki.vn/cua-hang/sachbanchay","logo":"https://vcdn.tikicdn.com/ts/seller/95/08/28/6d2a2db44eb4b71b91fb2a1d9d60d863.jpg","price":119000,"product_id":"272167790","store_id":1265}],"specifications":[{"name":"Thông tin chung","attributes":[{"code":"publisher_vn","name":"Công ty phát hành","value":"Công ty TNHH Thương mại và Dịch vụ Văn hóa Hà Nội"},{"code":"book_cover","name":"Loại bìa","value":"Bìa mềm"},{"code":"number_of_page","name":"Số trang","value":"312"},{"code":"manufacturer","name":"Nhà xuất bản","value":"Nhà Xuất Bản Hồng Đức"}]}],"price_comparison":{"sub_title":"Giá từ 119.000 ₫","title":"So sánh 1 nhà bán khác"},"product_links":[],"gift_item_title":"0 quà tặng kèm","services_and_promotions":[],"