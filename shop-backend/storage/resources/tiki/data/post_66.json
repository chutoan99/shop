ới tương lai đầy hứa hẹn. Subaru và Mio thực chất là người yêu và đang hẹn hò rất êm đẹp. Bỗng một ngày, anh hóa thành trẻ con ngay trước mắt Mio, cứ như một trò đùa. Hai người họ quyết định giấu - kín thân phận thật của Subaru và cùng tìm kiếm câu trả lời cho sự việc khó tin này, cũng như cách để Subaru trở lại như cũ.\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/7c/01/55/1999b88e0d1f2e9aad9020630010762c.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/7c/01/55/1999b88e0d1f2e9aad9020630010762c.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/7c/01/55/1999b88e0d1f2e9aad9020630010762c.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7c/01/55/1999b88e0d1f2e9aad9020630010762c.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7c/01/55/1999b88e0d1f2e9aad9020630010762c.png"},{"base_url":"https://salt.tikicdn.com/ts/product/d0/b0/74/fe0bbe3d43a79dbb064b4c8b837b0428.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d0/b0/74/fe0bbe3d43a79dbb064b4c8b837b0428.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d0/b0/74/fe0bbe3d43a79dbb064b4c8b837b0428.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d0/b0/74/fe0bbe3d43a79dbb064b4c8b837b0428.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d0/b0/74/fe0bbe3d43a79dbb064b4c8b837b0428.png"},{"base_url":"https://salt.tikicdn.com/ts/product/4d/15/c8/0984bfe1865e07327f92d18ecfe4a69d.png","is_gallery":