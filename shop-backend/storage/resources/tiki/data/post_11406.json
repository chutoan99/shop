null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/20/9e/f8/755279aa473f4841db7d652b53f5fbf2.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":711,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<h2>Màn hình Lenovo C22-20 21.5Inch 75Hz 62A7KAR1W 21.5Inch VA</h2>\n<p><strong>Lenovo C22-20</strong> là chiếc màn hình văn phòng có thiết kế khỏe khoắn cùng chất lượng hiển thị tốt trong tầm giá, đem lại hiệu năng làm việc cao trong môi trường văn phòng hiện đại.</p>\n<p><img src=\"https://salt.tikicdn.com/ts/product/fc/95/19/5e8ee835c14ca91da19f4b714f528530.jpg\" alt=\"\" /></p>\n<h3>Thiết kế tối giản phù hợp cho văn phòng làm việc</h3>\n<p>Thiết kế bên ngoài của <strong>Lenovo C22-20</strong> mang tính tối giản, nhẹ nhàng với viền màn hình siêu mỏng tạo cảm giác không viền mang đến hình ảnh chất lượng cao và kiểu dáng hiện đại.</p>\n<p>Màn hình Lenovo này có kích thước gọn gàng 21.5 inch, vừa đủ cho công việc, từ soạn văn bản, dùng excel hay chỉnh sửa ảnh hoặc lập trình đều phù hợp, và cũng thích hợp trong không gian văn phòng nhỏ, hiện đại.</p>\n<p><img src=\"https://salt.tikicdn.com/ts/product/78/83/c9/d45517d4fb2cd49f8844adbac37921bc.jpg\" alt=\"\" /></p>\n<h3>Khả năng hiển thị sắc nét</h3>\n<p>Điểm sáng về chất lượng khi sử dụng <strong>Lenovo C22-20</strong> chính là khả năng hiển thị sắc nét. Đây là sự kết hợp của tần số quét 75Hz cùng độ phân giải full HD tỷ lệ 16:9. Đi kèm với đó là đèn nền sáng đủ, độ tương phản cao và lớp phủ chống chói phù hợp với môi trường làm việc nhiều ánh đèn chiếu vào.</p>\n<p>Người dùng sẽ hoàn toàn không bị phân tâm, hoàn toàn tập trung vào công việc khi không có những bóng phản chiếu trên chính màn hình, ngay cả khi có ánh sáng mạnh phía sau. Màn hình có chất lượng cao với góc nhìn thoải mái, độ bao phủ màu rộng và được tinh chỉnh sẵn từ nhà sản xuất để phù hợp với công việc đa dạng.</p>\n<p> <img src=\"https://salt.tikicdn.com/ts/product/2a/0a/8a/490c5588e68fb03709104875181341ed.jpg\" alt=\"\" /></p>\n<h3>Kết nối toàn diện</h3>\n<p><strong>Màn hình Lenovo C22-20 62A7KAR1W</strong> cung cấp các cổng kết nối hiện đại là HDMI và VGA cho các mẫu PC đời mới có hiệu năng cao. Ngoài ra, với chân đế của vững chắc và linh hoạt, <strong>Lenovo C22-20</strong> có thể dễ dàng nâng lên hạ xuống, nghiêng ngửa theo góc nhìn dễ dàng.</p>\n<p><img src=\"https://salt.tikicdn.com/ts/product/3e/10/fe/1a424a1a8d2606f74cb4d2c8435413c2.jpg\" alt=\"\" /></p>\n<table class=\"ModelExTable\" style=\"width:1082px;height:1685px;\"><thead><tr><th class=\"titleth\" style=\"width:273.212px;\">\n<p> </p>\n<p>Model</p>\n</th>\n<th class=\"alignleft\" style=\"width:399.184px;\">62A7KAR1WW</th>\n<td style=\"width:399.219px;\"> </td>\n</tr></thead><tbody><tr><td style=\"width:273.212px;\">Product</td>\n<td class=\"alignleft\" style=\"width:399.184px;\">Lenovo C22-20</td>\n<td style=\"width:399.219px;\"> </td>\n</tr><tr><td style=\"width:273.212px;\">Machine Type</td>\n<td class=\"alignleft\" style=\"width:399.184px;\">62A7</td>\n<td style=\"width:399.219px;\"> </td>\n</tr><tr><td style=\"width:273.212px;\">Region</td>\n<td class=\"alignleft\" style=\"width:399.184px;\">ASN</td>\n<td style=\"width:399.219px;\"> </td>\n</tr><tr><td style=\"width:273.212px;\">Display Size</td>\n<td class=\"alignleft\" style=\"width:399.184px;\">21.5\"</td>\n<td style=\"width:399.219px;\"> </td>\n</tr><tr><td style=\"width:273.212px;\">View Area</td>\n<td class=\"alignleft\" style=\"width:399