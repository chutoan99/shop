ount_rate":0,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/05/2f/57/3911d0b1f7f9251725d0a72dd66c693d.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1846,"all_time_quantity_sold":16,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2 style=\"text-align: center;\"\u003eGiới thiệu sản phẩm Ổ cứng SSD 120GB Lexar NS100 2.5-Inch SATA III\u003c/h2\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/b3/3c/ea/5c2fcb328ba56a0290aacbba9b97cea3.jpg\" alt=\"\" width=\"750\" height=\"306\" /\u003e\u003c/p\u003e\n\u003ch3\u003eTăng tốc hiệu suất máy tính của bạn với tốc độ và độ tin cậy tối ưu\u003c/h3\u003e\n\u003cp\u003eNâng cấp \u003cem\u003eổ cứng SSD Lexar NS100  \u003c/em\u003esẽ giúp tiết kiệm thời gian cho bạn. Với hiệu suất được cải thiện và tốc độ đọc lên đến 550MB / s *, nó sẽ giúp cho máy tính khởi động, chuyển dữ liệu và tải ứng dụng một cách dễ dàng. Thời gian phản hồi ứng dụng và hiệu suất tổng thể tốt hơn để chơi trò chơi, chỉnh sửa ảnh và video hoặc các ứng dụng đa phương tiện khác.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/fc/bc/20/0d7c14e6877155e5ee356a1991fbf63c.png\" alt=\"\" width=\"750\" height=\"312\" /\u003e\u003c/p\u003e\n\u003ch3\u003eKhông còn độ trễ\u003c/h3\u003e\n\u003cp\u003eVới việc nâng cấp \u003cem\u003eổ cứng SSD Lexar NS100\u003c/em\u003e, máy tính của bạn sẽ phản ứng nhanh hơn. Hiệu suất được cải thiện sẽ cho phép bạn tăng tốc toàn bộ hệ thống của bạn.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/8a/64/e8/60e997d0de6b6ae5528bb311925d9b53.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch3\u003eTốc độ ấn tượng\u003c/h3\u003e\n\u003cp\u003e\u003cem\u003eỔ cứng SSD Lexar NS100 \u003c/em\u003evới tốc độ đọc liên tục lên tới 550MB / giây và tốc độ ghi liên tục lên đến 510MB / giây *, bạn sẽ tận hưởng hiệu suất tốt hơn cho trải nghiệm giải trí hoặc công việc hàng ngày của mình, máy tính khởi động nhanh hơn, truyền dữ liệu và thời gian tải ứng dụng sẽ không còn trễ.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/2b/e7/3d/400932c4478fcc02b529e6eeca529811.jpg\" alt=\"\" width=\"480\" height=\"382\" /\u003e\u003c/p\u003e\n\u003ch3\u003eĐáng tin cậy\u003c/h3\u003e\n\u003cp\u003eKhông giống như các ổ đĩa cứng truyền thống, \u003cem\u003eổ cứng SSD Lexar NS100 \u003c/em\u003ekhông có bộ phận chuyển động nên ít có khả năng bị hỏng, giảm tiêu thụ điện năng và hoạt động làm mát giúp kéo dài thời lượng pin cho máy tính. Trên hết, nó cũng chống sốc, chống rung và chống va đạp, khiến nó trở thành một SSD mạnh mẽ và đáng tin cậy.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/c5/e9/fe/d941170f3295db236995954edb7bbd92.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch3\u003eTheo dõi ổ đĩa của bạn\u003c/h3\u003e\n\u003cp\u003eVới phần mềm quản lý SSD Dash đặc trưng, bạn sẽ có những công cụ cần thiết để cập nhật cách thức hoạt động của SSD. Dễ dàng theo dõi hiệu suất của \u003cem\u003eổ cứng SSD Lexar NS100\u003c/em\u003e, bao gồm tình trạng ổ đĩa và cập nhật firmware để đảm bảo ổ cứng luôn hoạt động tốt.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/1e/3f/15/1fb171018f23e84ed7011ddea48b4795.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch3\u003eKiểm tra nghiêm ngặt\u003c/h3\u003e\n\u003cp\u003e\u003cem\u003eỔ cứng SSD Lexar NS100\u003c/em\u003e của Lexar đã được trải qua hàng ngàn thử nghiệm với hơn 1.100 thiết bị kỹ thuật số, để đảm bảo hiệu suất, chất lượng, tính tương thích và độ tin cậy.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/39/54/dd/ef84e11ab6771a83debec2f8e32b93b7.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/05/2f/57/3911d0b1f7f9251725d0a72dd66c693d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/05/2f/57/3911d0b1f7f9251725d0a72dd66c693d.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/05/2f/57/3911d0b1f7f9251725d0a72dd66c693d.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/05/2f/57/3911d0b1f7f9251725d0a72dd66c693d.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/05/2f/57/3911d0b1f7f9251725d0a72dd66c693d.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/29/87/02/c2cccef4ac91a78c86fe28b5277745b1.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/29/87/02/c2cccef4ac91a78c86fe28b5277745b1.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/29/87/02/c2cccef4ac91a78c86fe28b5277745b1.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/29/87/02/c2ccc