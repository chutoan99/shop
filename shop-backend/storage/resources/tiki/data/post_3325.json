m đổ đồ đạc khi di chuyển. Đầu khóa không để dư móc kéo nên không làm kẹt tay bé khi         khóa vali. Đầu khóa có móc để bé nối đây kéo khi cần, tiện lợi hơn cho bé khi dùng. \u003c/li\u003e\r\n\u003cli\u003e Sản phẩm có kèm sticker dán để bé thỏa sức trang trí cho vali của mình theo sở thích. \u003c/li\u003e\r\n\u003cli\u003e Bé có thể sử dụng khi đi học hay du lịch cùng gia đình đều phù hợp. \u003c/li\u003e\r\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/24/99/c2/2fb799e7feedf91917ecf298f7e89d8e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/24/99/c2/2fb799e7feedf91917ecf298f7e89d8e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/24/99/c2/2fb799e7feedf91917ecf298f7e89d8e.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/24/99/c2/2fb799e7feedf91917ecf298f7e89d8e.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/24/99/c2/2fb799e7feedf91917ecf298f7e89d8e.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/26/55/80/0f17f4ee536fd2155f0e2907143278b7.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/26/55/80/0f17f4ee536fd2155f0e2907143278b7.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/26/55/80/0f17f4ee536fd2155f0e2907143278b7.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/26/55/80/0f17f4ee536fd2155f0e2907143278b7.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/26/55/80/0f17f4ee536fd2155f0e2907143278b7.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/e7/08/19/aa9d86f