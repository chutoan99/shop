ết xuất từ hàu thịt, Bột chiết xuất cô đặc shijimi, Bột chiết xuất tinh bột nghệ mùa thu, Bột chiết xuất cô đặc tỏi,\u003c/p\u003e\n   \u003cp\u003e5. Hướng dẫn sử dụng:\u003c/p\u003e\n   \u003cp\u003e- Ngày uống 3 viên chia 3 lần trước hoặc sau ăn đều được.\u003c/p\u003e\n   \u003cp\u003e- Để xa tầm với của trẻ em.\u003c/p\u003e\n  \u003c/ul\u003e\n \u003c/body\u003e\n\u003c/html\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/b6/ed/cc/2cfd0947bca8e8ea8ee9bd5f01773aba.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b6/ed/cc/2cfd0947bca8e8ea8ee9bd5f01773aba.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b6/ed/cc/2cfd0947bca8e8ea8ee9bd5f01773aba.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b6/ed/cc/2cfd0947bca8e8ea8ee9bd5f01773aba.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b6/ed/cc/2cfd0947bca8e8ea8ee9bd5f01773aba.png"}],"warranty_policy":null,"brand":{"id":47803,"name":"Orihiro ","slug":"orihiro"},"current_seller":{"id":110455,"sku":"1205740133783","name":"Orihiro Official Store","link":"https://tiki.vn/cua-hang/orihiro-official-store","logo":"46/3e/de/9b64989ddc06b8bd11f263c4828361fb.jpg","price":415000,"product_id":"74745039","store_id":102237,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Content","attributes":[{"code":"brand","name":"Thương hiệu","value":"Orihiro"},{"code":"brand_country","name":"Xuất xứ thương hiệu","value":"Việt Nam"},{"code":"origin","name":"Xuất xứ (Made in)","value":"Nhật Bản"},{"code":"expiry_time","name":"