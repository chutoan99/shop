dge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":true,"return_reason":"any_reason"}},"discount":760000,"discount_rate":12,"rating_average":4.7,"review_count":74,"review_text":"(74)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/d2/19/c7/77dbef21dea9fb03d13b7f43dd0190d5.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1369,"all_time_quantity_sold":124,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ctable border=\"0\" width=\"100%\" cellspacing=\"5\" cellpadding=\"5\"\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd\u003e\n\u003cp\u003e\u003cstrong\u003eThiết kế năng động, nhiều màu sắc\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eNgoài thiết kế cực kỳ năng động và mạnh mẽ, Xtreme 3 còn có đến 3 màu sắc để bạn lựa chọn là: đen, xanh lam và rằn ri quân đội. Bạn có thể tùy chọn màu sắc phù hợp với phong cách và sở thích của bản thân.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://philong.com.vn/media/lib/24388_1.jpg\" alt=\"\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eÂm thanh sôi động\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eXtreme 3 là sản phẩm loa Bluetooth thế hệ mới nhất của JBL nên được trang bị đến 4 trình điều khiểu cải tiến và 2 bộ tản nhiệt (Bass Radiators). Mang lại âm thanh bùng nổ để khuấy động bữa tiệc của bạn với không khí đầy sôi động.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://philong.com.vn/media/lib/24388_2.jpg\" alt=\"\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eKết nối rộng với loa JBL tương thích\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eBạn có thể kết nối lên đến 2 thiết bị di động tới Xtreme 3 và thay phiên nhau thưởng thức chất âm độc quyền JBL Pro. Ngoài ra, bạn cũng có thể ghép nối giữa 2 chiếc loa tương thích với nhau qua công nghệ JBL PartyBoost để tạo ra âm thanh nổi đặc sắc. Hoặc liên kết với hàng trăm loa khác nhau để nâng cao âm thanh trong bữa tiệc lớn.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://philong.com.vn/media/lib/24388_3.jpg\" alt=\"\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eChống nước IP67 cao cấp\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eNếu chẳng may loa dính nước hoặc bụi bẩn? Đừng lo lắng bởi chiếc Xtreme 3 đã được trang bị công nghệ chống bụi chống nước chuẩn IP67. Bạn có thể yên tâm mang loa đi chơi tại bất kỳ đâu mà không sợ loa bị trục trặc ngoài ý muốn. Tính năng này cũng góp phần làm tăng tuổi thọ của Xtreme 3.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://philong.com.vn/media/lib/24388_4.jpg\" alt=\"\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTrang bị Bluetooth v5.1 hiện đại\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eSở hữu công nghệ Bluetooth 5.1 mới nhất, Xtreme 3 cho khả năng truyền tải thông tin không dây cực kỳ hoàn hảo. Bạn có thể ghép nối loa với hầu hết các thiết bị điện tử nào như smartphone, laptop,… Và quan trọng hơn là chất lượng âm thanh vẫn được giữ nguyên như bản gốc.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://philong.com.vn/media/lib/24388_5.jpg\" alt=\"\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTrải nghiệm tối đa lên đến 15 giờ\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eNhờ trang bị viên pin mạnh mẽ, bạn có thể thưởng thức âm thanh suốt 15 giờ đồng hồ. Tích hợp Powerbank có thể sạc thêm cho các thiết bị khác của bạn cực kỳ tiện lợi. Loa Bluetooth Xtreme 3 sử dụng cổng sạc USB Type-C, cho khả năng sạc nhanh chóng và ổn định nhất.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://philong.com.vn/media/lib/24388_6.jpg\" alt=\"\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThông số kỹ thuật\u003c/strong\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\n\u003ctable border=\"0\" width=\"80%\" cellspacing=\"5\" cellpadding=\"5\"\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd width=\"25%\"\u003eNhà sản xuất:\u003c/td\u003e\n\u003ctd width=\"75%\"\u003eJBL - United States\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003eStyle:\u003c/td\u003e\n\u003ctd\u003ePortable Bluetooth Speaker\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003eTransducer:\u003c/td\u003e\n\u003ctd\u003e2 x 70mm woofer, 2 x 20mm Tweeter\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003eOutput Power:\u003c/td\u003e\n\u003ctd\u003e2 x 25W RMS woofer + 2 x 25W RMS tweeter (AC power mode)\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003ePower Input:\u003c/td\u003e\n\u003ctd\u003e5V/9V/12V/15V/20V, 3A\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003eFrequency response:\u003c/td\u003e\n\u003ctd\u003e53.5Hz - 20kHz\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003eSignal-to-noise ratio:\u003c/td\u003e\n\u003ctd\u003emore than 80dB\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003eWaterproof:\u003c/td\u003e\n\u003ctd\u003eIP67\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003eConnection:\u003c/td\u003e\n\u003ctd\u003eBluetooth version 5.1\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003eBattery:\u003c/td\u003e\n\u003ctd\u003e\n\u003cul\u003e\n\u003cli\u003eLithium-ion Polymer (36.3Wh) - up to 15 hours (Varies by volume level and music content)\u003c/li\u003e\n\u003cli\u003eBattery charge time: 2.5 hours (20V/3A)\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003eUSB-A / USB-C Charge Out:\u003c/td\u003e\n\u003ctd\u003e\n\u003cul\u003e\n\u003cli\u003eUSB-A Charge Out: 5V/2A (Maximum)\u003c/li\u003e\n\u003cli\u003eUSB-C Charge Out: 5V/1.5A (Maximum)\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003eSize:\u003c/td\u003e\n\u003ctd\u003e298.5 x 136 x 134 mm\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003eWeight:\u003c/td\u003e\n\u003ctd\u003e1.968kg\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003eColor:\u003c/td\u003e\n\u003ctd\u003eBlack, Blue, Camo\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003eManual User :\u003c/td\u003e\n\u003ctd\u003e\u003ca href=\"https://www.maccenter.vn/Audio/JBL-Xtreme3.pdf\"\u003eDownload Manual User for JBL Xtreme 3\u003c/a\u003e\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003eIn the box:\u003c/td\u003e\n\u003ctd\u003e\n\u003cul\u003e\n\u003cli\u003e1 x JBL Xtreme 3\u003c/li\u003e\n\u003cli\u003e1 x JBL Adaptor with Power Cable + Regional Plug\u003c/li\u003e\n\u003cli\u003e1 x JBL Xtreme 3 Strap\u003c/li\u003e\n\u003cli\u003eQuick-start Guide\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi p