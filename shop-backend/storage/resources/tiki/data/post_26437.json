x":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":53000,"discount_rate":15,"rating_average":5,"review_count":15,"review_text":"(15)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/05/42/dc/2b07e0d5f8e3b1989ebdc8b0ee44c2cd.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1157,"all_time_quantity_sold":42,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch1\u003eNón Bảo Hiểm Trẻ Em 1/2 Đầu Protec Kitty, Họa Tiết Siêu Anh Hùng Captain American\u003c/h1\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/7c/5c/e5/d55318b67e81a0f3c17de25fff4328da.webp\" alt=\"\" width=\"750\" height=\"187\" /\u003e\u003c/p\u003e\n\u003cp\u003e Mũ Bảo Hiểm Trẻ Em 1/2 Đầu Không Kính Protec Kitty Họa Tiết Siêu Anh Hùng Captain American Mạnh Mẽ sẽ khiến các bé trai nhà bạn thích thú khi được đội nhờ vào hình nhân vật siêu anh hùng Captain American được in nổi bật, sống động, đồng thời giúp tập cho bé thói quen đội mũ ngay từ khi còn nhỏ.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/58/77/1f/5d77a1dd0b817fb65471ff397dc0a329.jpg\" alt=\"\" width=\"750\" height=\"375\" /\u003e\u003c/p\u003e\n\u003cp\u003e+ Chứng nhận đạt quy chuẩn kỹ thuật quốc gia QCVN 2:2008/BKHCN (tem chứng nhận CR được dán phía sau mũ khẳng định chất lượng sản phẩm).\u003c/p\u003e\n\u003cp\u003e+  Mũ Protec đã thông qua các quy trình kiểm định nghiêm ngặt về độ va đập, độ đâm xuyên và độ ổn định của khóa mũ.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/62/54/56/91e647644627b968c72bb01fd5e2d6ed.jpg\" alt=\"\" width=\"750\" height=\"375\" /\u003e\u003c/p\u003e\n\u003cp\u003e+ Vỏ mũ được làm từ chất liệu nhựa ABS siêu bền, có tác dụng ngăn chặn các va đập trực tiếp vào đầu người đội, độ bền đâm xuyên cao và chịu được va đập mạnh.\u003c/p\u003e\n\u003cp\u003e+ Lõi bằng xốp EPS đặc chủng, dẻo dai, được nén nhiều lớp, tăng khả năng hấp thu chấn động, bảo vệ phần đầu tối đa khi chẳng may có va chạm. Lớp mút này có thể tháo ra dễ dàng để giặt hay vệ sinh khi cần.\u003c/p\u003e\n\u003cp\u003e+ Mũ có trọng lượng rất nhẹ, chỉ khoảng 450 - 550 gram để bé cảm thấy nhẹ nhàng, không hề nặng đầu dù có phải đội mũ trong thời gian dài.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/93/c9/6b/0ee6f4e52437e321243d815c872ea1cd.jpg\" alt=\"\" width=\"750\" height=\"375\" /\u003e\u003c/p\u003e\n\u003cp\u003e+ Bố trí lỗ thoát khí khoa học, tạo sự lưu thông không khí, mang lại cảm giác thoải mái, thoáng mát khi đội.\u003c/p\u003e\n\u003cp\u003e+ Kiểu dáng 1/2 đầu, hình nhân vật Captain American được in sống động và nổi bật trên nền xanh, khiến bé thích thú khi đội, tạo vẻ ngoài năng động cho bé.\u003c/p\u003e\n\u003cp\u003e️ BÉ BAO NHIÊU TUỔI CÓ THỂ ĐỘI MŨ PROTEC KITTY ️\u003c/p\u003e\n\u003cp\u003eĐể trả lời câu hỏi này cho ba mẹ, hãy cùng Protec tìm hiểu nhé. Hiện nay Protec có 02 cỡ mũ dành riêng cho trẻ em:\u003c/p\u003e\n\u003cp\u003e Size S: Chu vi vòng đầu 48,5 cm - 51,5 cm\u003c/p\u003e\n\u003cp\u003e Size M: Chu vi vòng đầu 52 cm - 54,5 cm\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/0c/bb/55/7f3dd84c50242c26ebf5d157b73058e8.jpg\" alt=\"\" width=\"750\" height=\"375\" /\u003e\u003c/p\u003e\n\u003cp\u003eHướng dẫn sử dụng: Vòng 1 sợi dây quanh đầu, ngay phía trên lông mày và tai. Xiết sợi dây sao cho ôm vừa đủ thoải mái lấy đầu và ghi lại số đo đó. Lặp lại như vậy để tìm được số đo mà bạn thấy đầu dễ chịu nhất và sử dụng số đo đó\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/64/ee/b9/48454d177089fde835b97bffb9d8c98c.webp\" alt=\"\" width=\"750\" height=\"556\" /\u003e\u003c/p\u003e\n\u003cp\u003eHướng dẫn bảo quản: Dùng khăn ẩm (không dùng xăng hoặc chất tẩy rửa mạnh) để lau nón. Nên thay nón mới sau tai nạn hoặc va đập mạnh vì lớp EPS không thể bảo vệ bạn nếu nó đã bị va đập. Không nên để nón ở nơi có nhiệt độ cao để đảm bảo độ bền của nón. Protec khuyên khách hàng nên thay nón sau thời gian sử dụng từ 2-3 năm.\u003c/p\u003e\n\u003cp\u003ePROTEC CAM KẾT:\u003c/p\u003e\n\u003cp\u003eDo màn hình và điều kiện ánh sáng khác nhau, màu sắc thực tế của sản phẩm có thể chênh lệch khoảng 3-5%\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/05/42/dc/2b07e0d5f8e3b1989ebdc8b0ee44c2cd.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/05/42/dc/2b07e0d5f8e3b1989ebdc8b0ee44c2cd.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/05/42/dc/2b07e0d5f8e3b1989ebdc8b0ee44c2cd.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/05/42/dc/2b07e0d5f8e3b1989ebdc8b0ee44c2cd.jpg","thumbnail_ur