ull,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":23000,"discount_rate":20,"rating_average":4.8,"review_count":52,"review_text":"(52)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/d7/53/e4/74d80e2d7182661d1b563adf84235f29.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1404,"all_time_quantity_sold":208,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eNước dưỡng tóc vỏ bưởi \u0026amp; bồ kết HERBARIO\u003c/strong\u003e giúp giảm gãy rụng tóc*, cung cấp dưỡng chất từ chân tóc đến thân và ngọn tóc. Cho tóc chắc khỏe không còn sơ rối gãy rụng, mang lại mái tóc suôn mượt, làm mềm tóc.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e1, Công dụng Nước dưỡng tóc vỏ bưởi và bồ kết herbario\u003c/strong\u003e\u003cbr /\u003e- Giảm gãy rụng tóc, giúp mọc tóc dài nhanh\u003cbr /\u003e- Bồi bổ dưỡng chất cho tóc, bảo vệ tóc trước tác động của môi trường và hóa chất.\u003cbr /\u003e- Giúp tóc giảm khô sơ rối, suôn mượt, mềm mại\u003cbr /\u003e- Nuôi dưỡng mái tóc đẹp một cách tự nhiên tư bên trong\u003cbr /\u003e- Cung cấp dưỡng chất cho nang tóc, giúp khỏe từ thân đến ngọn\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e2, Thành phần chính Nước dưỡng tóc vỏ bưởi và bồ kết herbario\u003c/strong\u003e\u003cbr /\u003e- Vỏ bưởi: Trong vỏ bưởi hàm lượng vitamin C rất cao đồng thời khả năng chống lại oxy hoá mạnh, tăng kích thích mọc tóc. sẽ giúp giải phóng paraben và các chất bẩn bám trên tóc. Nó cũng giúp làm sáng màu tóc và khiến tóc bạn trông óng ả hơn.\u003cbr /\u003e- Bồ kết: Lượng tóc gãy rụng cũng được giảm đáng kể do hợp chất flavonozit với thành phần chính saponaretin trong bồ kết giúp cung cấp những dưỡng chất cần thiết để nuôi dưỡng tóc từ gốc đến ngọn.\u003cbr /\u003e- Vitamin b5: 95% dưỡng chất nuôi dưỡng tóc được lấy từ máu, trong các thành phần nuôi tóc không thể thiếu vitamin b5 là chủ yếu quyết định sức khỏe tóc. bổ sung trực tiếp lên chân tóc để bảo vệ sức khỏe mái tóc của bạn ngay từ bây giờ.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/98/4c/24/39c3963175e8643cfa13afa5b918432e.jpg\" alt=\"\" width=\"750\" height=\"578\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e3, Đối tượng sử dụng\u003c/strong\u003e\u003cbr /\u003e- Sau sinh tóc yếu không khỏe\u003cbr /\u003e- Tóc bắt dầu gãy rụng, tóc ít.\u003cbr /\u003e- Sấy, duỗi nhiều tóc dể rụng.\u003cbr /\u003e- Tóc hư tổn do sử dụng hóa chất, nhuộm nhiều lần\u003cbr /\u003e- Tóc khô, yếu do làm việc nhiều trong môi trường khói bụi\u003cbr /\u003e- Tóc yếu tự nhiên do bẩm sinh hoặc do lão hóa.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e4, Ưu điểm Nước dưỡng tóc vỏ bưởi và bồ kết herbario\u003c/strong\u003e\u003cbr /\u003e- No Paraben (không Paraben)\u003cbr /\u003e- No phthalate (không Phthalate)\u003cbr /\u003e- Vegan product (Sản phẩm thuần chay)\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e5, Thành phần đầy đủ\u003c/strong\u003e\u003cbr /\u003eAQUA/WATER, PELVETIA CULATA EXTRACT, XYLITOL, XYLITYL-GLUCOSIDE, MALTITOL, ANHYDRO-XYLITOL, GLEDITSIA SINENSIS SEED EXTRACT (bồ kết), PANTHENOL (Vitamin b5), BETAINE, GLYCERIN, GLYCERETH-26, SODIUM GLUCONATE, ETHYLHEXYLGLYCEIN, SODIUM LACTATE, PEG-40, HYDRO-GENATED CASTOR OIL, POLY-SORBATE 20, TRISODIUM ETHYLENED-AMINE DISUCCINATE,CITRUS GRANDIS PEEL OIL (vỏ bưởi), CITRUS AURANTIUM DULOS (ORANGE) PEEL OIL, PARFUM, PHENOXYETHANOL.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e6, Hướng dẫn sử dụng\u003c/strong\u003e\u003cbr /\u003e- Để tóc khô, sạch rồi xịt lên tóc.\u003cbr /\u003e- Xịt lên mái tóc và mát-xa nhẹ nhàng. dùng hàng ngày để đặt hiệu quả tốt.\u003cbr /\u003e- Kết hợp serum vỏ bưởi và bồ kết herbario để chăm sóc từ thân đến ngọn.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e7, Dùng bao lâu có hiệu quả\u003c/strong\u003e\u003cbr /\u003e* Tùy theo cơ địa của mỗi người, Nước dưỡng tóc vỏ bưởi và bồ kết Herbario sẽ có thời gian tác dụng khác nhau.\u003cbr /\u003e- Trong thời gian đầu mới dùng sản phẩm, bạn sẽ thấy tình trạng rụng tóc giảm đáng kể.\u003cbr /\u003e- Tiếp theo các tình trạng như bết tóc, khô xơ, chẻ ngọn sẽ được cải thiện, tóc sẽ suôn mượt và bồng bềnh dần lên.\u003cbr /\u003e- Sau một thời gian, tóc sẽ bắt đầu mọc nhiều, mái tóc sẽ dày lên thấy rõ, sợi tóc chắc và rất mượt.\u003c/p\u003e\n\u003cp\u003eHạn sử dụng: 3 năm kể từ ngày sản xuất, in trên chai.\u003cbr /\u003eMở nắp dùng trong 12 tháng.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/7c/5b/9c/e8ea09986c54efccfe5bf477bde53871.jpg\" alt=\"\" width=\"600\" height=\"600\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/dc/05/f5/5a0c02577d6fe67d780dd51538344ecf.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/d6/9c/0b/3d0b4cc73bd70ee65bca7dbcbe12fc4a.jpg\" alt=\"\" width=\"600\" height=\"0\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/d7/53/e4/74d80e2d7182661d1b56