4/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.8,"review_count":189,"review_text":"(189)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/01/05/7f/d493b1be7916a3345f57e56388807d27.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1406,"all_time_quantity_sold":1193,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p>Kem nhuộm tóc phủ bạc L'Oreal Paris Excellence Crème 172ml với dầu gội dịu nhẹ mới mang lại 3 HIỆU QUẢ SỬ DỤNG:<br />1. Bảo vệ màu nhuộm Với kem nhuộm &amp; chất phát triển màu<br />2. Bảo vệ da dầu Với dầu gội dịu nhẹ<br />3. Bảo vệ tóc Với dầu xả dưỡng tóc</p>\n<p><img style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/product/55/19/3a/5117d7c133a3ce74a4c3e2709e99c93f.jpg\" alt=\"\" width=\"720\" height=\"720\" data-cke-saved-src=\"https://salt.tikicdn.com/ts/product/55/19/3a/5117d7c133a3ce74a4c3e2709e99c93f.jpg\" /></p>\n<p>Nhiều màu nhuộm phù hợp với bạn theo 3 tông:<br />- Tông sáng<br />- Tông vừa<br />- Tông tối</p>\n<p><img style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/product/f2/4e/f0/1f2c049708573ca46b7e125f640e56fd.jpg\" alt=\"\" width=\"720\" height=\"720\" data-cke-saved-src=\"https://salt.tikicdn.com/ts/product/f2/4e/f0/1f2c049708573ca46b7e125f640e56fd.jpg\" /></p>\n<p>3 THÀNH PHẦN GIÚP DƯỠNG TÓC GẤP 3 LẦN<br />- CERAMIDE : Làm mềm mượt và bảo vệ tóc<br />- PRO-KERATIN: Tái cấu trúc tóc và giúp tóc khỏe mượt<br />- I ONENE D: Phục hồi tóc từ sâu bên trong</p>\n<p><img style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/product/4a/2f/da/b9d8e0792154ffd880cede03a6a205ab.jpg\" alt=\"\" width=\"720\" height=\"720\" data-cke-saved-src=\"https://salt.tikicdn.com/ts/product/4a/2f/da/b9d8e0792154ffd880cede03a6a205ab.jpg\" /></p>\n<p>Bộ sản phẩm bao gồm:<br />1a: Kem nhuộm dưỡng tóc<br />1b: Thuốc phát triển màu<br />2: Dầu gội dịu nhẹ<br />3. Dầu xả bảo vệ tóc<br />4. Găng tay</p>\n<p><img style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/product/6b/bc/fe/55458d97a76d1fb8e44f47336c3f220e.jpg\" alt=\"\" width=\"720\" height=\"720\" data-cke-saved-src=\"https://salt.tikicdn.com/ts/product/6b/bc/fe/55458d97a76d1fb8e44f47336c3f220e.jpg\" /></p>\n<p><strong>HƯỚNG DẪN SỬ DỤNG CHO KẾT QUẢ TỐT NHẤT</strong></p>\n<p>I.TRƯỚC KHI NHUỘM TÓC:<br />● Đổ kem nhuộm(1a) vào lọ thuốcPhát triển màu (1b)<br />● Đóng nắp lọ và Lắc cho hỗn hợpĐược trộn đều<br />●Tháo nắp ngay sau khi trộn đểtránh hỗn hợpbị đổ và trào ra<br />● Sử dụng đầu phun hoặc đầu lược để tiến hành nhuộm tóc</p>\n<p><strong>II. NHUỘM TÓC</strong></p>\n<p>Bước 1: NHUỘM TÓC VỚI kem nhuộm bảo vệ tóc<br />● Bắt đầu thoa kem nhuộm từ chân tóc đến thân và ngọn tóc<br />● Mát xa nhẹ nhàng<br />● Sử dụng toàn bộ kem nhuộm cho thân và chân tóc. Chờ 30 phút<br />Bước 2. GỘI ĐẦU Với dầu gội dịu nhẹ<br />● Xả một chút nước ấm lên tóc vàMát-xa nhẹ nhàng<br />● Sau đó xả sạch tóc cho tới khi hết màu nhuộm<br />Bước 3: DƯỠNG TÓCVới dầu xả bảo vệ tóc sau khi nhuộm<br />● Mát-xa nhẹ nhàng<br />● Xả sạch với nước và sấy tóc<br /><strong>THÔNG TIN THƯƠNG HIỆU</strong><br />Hơn 100 năm thành lập, L’Oreal Paris là tập đoàn chuyên về mỹ phẩm và chăm sóc sắc đẹp lớn nhất thế giới. L’Oreal Paris đã có mặt tại hơn 120 quốc gia với các dòng sản phẩm về chăm sóc tóc, chăm sóc da và trang điểm dành cho đại chúng. Được xây dựng trên nền tảng khoa học, áp dụng những phát minh công nghệ mới nhất, các sản phẩm L'Oreal Paris có chất lượng cao cấp, đa dạng, dễ sử dụng, với mức giá phù hợp cho tất cả mọi người, đáp ứng nhiều nhu cầu làm đẹp.</p>\n<p>*L’Oréal Paris là nhãn hiệu mỹ phẩm hàng đầu tại Châu Âu được sản xuất tại nhiều nhà máy trên toàn thế giới như Trung Quốc, Mỹ, Indonesia… Dù được sản xuất ở đâu, các sản phẩm đều tuân theo quy trình kiểm soát chất lượng nghiêm ngặt và đồng đều của L’Oréal Toàn Cầu. Các sản phẩm chính hãng đều có tem nhãn tiếng Việt phía sau và nhập khẩu trực tiếp từ công ty TNHH L’Oreal Việt Nam nên các bạn hoàn toàn yên tâm về chất lượng sản phẩm.</p>\n<p>(*) Kem nhuộm số 1 Thế Giới được chứng nhận bởi tổ chức  Euromonitor International, 01/06/2018<br />Xuất xứ thương hiệu: Pháp<br />Hạn sử dụng: 3 năm kể từ ngày sản xuất<br />Ngày sản xuất: In trên bao bì sản phẩm<br />Thành phần: Xem trong bao bì hướng dẫn</p>\n<p>*Bao bì thay đổi theo từng đợt nhập hàng</p>\n<p><img style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/product/0f/65/b2/673e970a10daf4c08a97385476d24f48.jpg\" alt=\"\" width=\"720\" height=\"720\" data-cke-saved-src=\"https://salt.tikicdn.com/ts/product/0f/65/b2/673e970a10daf4c08a97385476d24f48.jpg\" /></p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/01/05/7f/d493b1be7916a3345f57e56388807d27.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/01/05/7f/d493b1be7916a3345f57e56388807d27.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/01/05/7f/d493b1be7916a3345f57e56388807d27.jpg","position":null,"small_url":"https://salt.tikicdn.co