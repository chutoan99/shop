null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.8,"review_count":46,"review_text":"(46)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/19/49/56/c42bbaa08b4621d59fd8b9f10a7bbc71.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1217,"all_time_quantity_sold":414,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003eThông tin sản phẩm\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eDựa theo tiêu chuẩn công nghệ Nhật Bản - Đóng gói tại Việt Nam.\u003c/li\u003e\n\u003cli\u003eKích thước khăn: 25x25cm (+-2cm)\u003c/li\u003e\n\u003cli\u003eMàu sắc: trắng viền màu (viền màu xanh lá, xanh dương, cam, hồng, vàng)\u003c/li\u003e\n\u003cli\u003eThành phần chính: vải cotton\u003c/li\u003e\n\u003cli\u003eĐóng gói 10 cái / bịch\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cem\u003e\u003cstrong\u003eLưu ý: Hình ảnh, kích thước có thể thay đổi đôi chút. Tùy từng thời điểm nhập hàng. \u003c/strong\u003e\u003c/em\u003e\u003c/p\u003e\n\u003ch3\u003eĐặc điểm nổi bật\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eChất liệu vải thấm hút nước tốt, giúp mẹ dễ dàng vệ sinh cho bé.\u003c/li\u003e\n\u003cli\u003eKhăn sữa Nhật trẻ em siêu mềm Aiko làm từ chất liệu 100% cotton siêu mềm, Giúp làm sạch các lỗ chân lông, tránh hiện tượng viêm nhiễm lỗ chân lông, sợi vải bông mềm mịn không làm chầy xước làn da nhạy cảm của trẻ của trẻ, tạo cảm giác êm ái và dễ chịu cho làn da nhạy cảm của bé.\u003c/li\u003e\n\u003cli\u003eChất liệu vải cao cấp, được Aiko cuốn biên cẩn trọng.\u003c/li\u003e\n\u003cli\u003eThiết kế tiện dụng\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eLà sản phẩm thích hợp khi vệ sinh mặt và thân thể cho bé yêu của bạn, rửa mặt cho bé, thấm sữa lau ty cho mẹ.\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eKích thước khăn nhỏ gọn, nhẹ, mẹ dễ dàng mang theo người khi đi ra ngoài.\u003c/li\u003e\n\u003cli\u003eĐường chỉ khâu được may tỉ mỉ, cẩn thận, phần đường cuốn khéo léo không bị cuộn lên quá dày làm ảnh hưởng đến bé.\u003c/li\u003e\n\u003cli\u003eMàu sắc hài hòa.\u003c/li\u003e\n\u003cli\u003eKhăn màu trắng được kết hợp cùng viền màu hồng, vàng và xanh, tạo điểm nhấn cho sản phẩm thêm bắt mắt.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e(Khăn sữa khi lần đầu mua về các mẹ nên giặt cho bé trước khi sử dụng thì khăn sẽ mềm hơn).\u003c/p\u003e\n\u003ch3\u003eHướng dẫn sử dụng\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eGiặt trước khi sử dụng\u003c/li\u003e\n\u003cli\u003eKhông sử dụng với bột giặt có độ tẩy cao.\u003c/li\u003e\n\u003cli\u003eTránh phơi dưới nắng gắt.\u003c/li\u003e\n\u003cli\u003eSử dụng chế độ giặt nhẹ khi giặt máy và nên dùng với túi giặt.\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003eHướng dẫn bảo quản:\u003c/h3\u003e\n\u003cp dir=\"ltr\"\u003eTránh phơi dưới nắng gắt. Sau khi giặt xong thì đem phơi ở nơi có ánh nắng, tránh phơi ở nơi ẩm ướt lâu khô. Bảo quản nơi khô ráo, thoáng mát, nhiệt độ phòng bình thường, tránh nơi nhiệt độ cao, lửa, để xa các hóa chất ăn mòn, gây cháy nổ. \u003c/p\u003e\n\u003ch3\u003eLưu ý về sản phẩm:\u003c/h3\u003e\n\u003cp dir=\"ltr\"\u003eKhông nên dùng đi dùng lại quá nhiều lần cho một chiếc khăn sữa. không được sử dụng khăn sữa để lau nền nhà hay bất cứ bề mặt nào có vết sữa của con vì sẽ làm cho khăn sữa nhanh bị sổ lông. Không dùng khăn sữa để rơ lưỡi vì tiềm ẩn nhiều nguy cơ gây bệnh do có vi khuẩn.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/19/49/56/8972acc1f910f30585481cf100424575.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch3 dir=\"ltr\"\u003eĐôi nét về thương hiệu\u003c/h3\u003e\n\u003cp dir=\"ltr\"\u003eNhắc đến Aiko bạn sẽ nhận diện ngay đây là thương hiệu uy tín hàng đầu trong lĩnh vực sản xuất và tiếp thị các sản phẩm dành cho mẹ và bé.\u003c/p\u003e\n\u003cp dir=\"ltr\"\u003eAIKO ra mắt lần đầu vào năm 2017 với loại nước giặt đặc trưng, an toàn tuyệt đối cho bé Aiko đã nhanh chóng tạo nên sức hút mạnh mẽ trong ngành mẹ và bé tại Việt Nam.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/f2/52/94/f985eade2b8798218af62fe8af9f61d1.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/7c/85/d4/cb50fa128108fe0afde19cc814641745.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/64/f4/c0/7e6130e0f1a46487f449ccfde1068490.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/44/4c/a3/b3eef89433ab05485a4d30edc7d248fa.jpg\" alt=\"\" width=\"750\" height=\"749\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/19/49/56/c42bbaa08b4621d59fd8b9f10a7bbc71.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/19/49/56/c42bbaa08b4621d59fd8b9f10a7bbc71.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/19/49/56/c42bbaa08b4621d59fd8b9f10a7bbc71.jpg","position":null,"small_url":"https://salt.ti