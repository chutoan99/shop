"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.6,"review_count":190,"review_text":"(190)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/fa/71/d1/1392f873c99f3f255d6a52e10ced6913.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1548,"all_time_quantity_sold":956,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/30/2a/14/f2f4408fd1d13f2e0c38bf152b8981ad.png\" alt=\"dịch chuối phong lan hoa hồng\" width=\"750\" height=\"750\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003ePhân bón dịch chuối humic, thần dược hoa hồng, phong lan\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThông tin Phân bón Dịch chuối hữu cơ DOCNEEM:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eThương hiệu DOCNEEM đã được đăng ký bảo hộ tại cục sở hữu trí tuệ Việt Nam.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003e100% tự nhiên, sản phẩm hữu cơ gấp đôi Kali, chuối ủ với men vi sinh. Hormon tự nhiên, giàu Vitamin.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eChai 1 lít (chai nhựa cao cấp).\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eKết cấu hình dạng: dạng lỏng.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/1d/c1/b2/6375dd0e2fb8fa9cb42cc9ca7fc3885a.jpg\" alt=\"DỊCH CHUỐI PHONG LAN\" width=\"720\" height=\"720\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003eChuyên bón là phong lan\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCông dụng Phân bón Dịch chuối hữu cơ DOCNEEM:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eTăng sức đề kháng cho hoa hồng, hoa lan, phục hồi sau khi ngộ độc phân bón hóa học. \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eĐiều trị các bệnh thường gặp trên hoa hồng như: Vàng lá gân xanh, khô cành do thiếu vi lượng, \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eKích rễ non, mầm ngọn cứng cáp và nhanh lớn. \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eTối ưu tăng trưởng cho hoa lan và hoa hồng.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eKích rễ non, cây ra lá. Giúp mầm, ngọn, cứng cáp nhanh lớn\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eTăng sức đề kháng, sạch sâu bệnh.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/1b/3c/fb/fd53edd882e5b36172cdf3ec6e4bf4f5.jpg\" alt=\"dịch chuối phong lan hoa hồng\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003eGấp đôi Kali giúp cây chắc khỏe\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eHướng dẫn sử dụng Phân bón Dịch chuối hữu cơ DOCNEEM:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eHoa Hồng: Bón gốc: 15 ml dịch chuối với 1 lít nước, cho 1 gốc hồng, định kỳ 1 lần/ tuần.Bón lá: 10ml dịch chuối với 1 lít nước, phun bón lá định kỳ 1 lần/tuần.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003ePhong lan: Pha 1 lít dịch chuối với 100 lít nước, có thể pha thêm 100g nấm Trichoderma vào 100 lít dung dịch đã pha để tăng thêm hiệu quả phòng bệnh thối nhũn cho phong lan.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eDOCNEEM cam kết:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eSản phẩm Phân bón Dịch chuối hữu cơ DOCNEEM chai 1L giống mô tả. \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eHình ảnh sản phẩm là ảnh thật do shop tự chụp và giữ bản quyền hình ảnh.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eĐảm bảo sản phẩm hữu cơ chất lượng 100%.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eĐược đóng gói cẩn thận và tư vấn nhiệt tình trước khi gói hàng giao cho Quý Khách.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eHàng có sẵn, giao hàng ngay khi nhận được đơn. \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eHoàn tiền nếu sản phẩm không giống với mô tả.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eGiao hàng trên toàn quốc, nhận hàng tại nhà.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cstrong\u003eHỗ trợ đơn hàng theo quy định của Tiki:\u003c/strong\u003e\u003c/em\u003e\u003c/p\u003e\n\u003col\u003e\n\u003cli\u003e\u003cspan style=\"font-weight: 400;\"\u003e Điều kiện áp dụng (trong vòng 07 ngày kể từ khi nhận sản phẩm) \u003c/span\u003e\u003c/li\u003e\n\u003c/ol\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003e- Hàng hoá vẫn còn mới, chưa qua sử dụng \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003e- Hàng hoá bị lỗi hoặc hư hỏng do vận chuyển hoặc do nhà sản xuất \u003c/span\u003e\u003c/p\u003e\n\u003col start=\"2\"\u003e\n\u003cli\u003e\u003cspan style=\"font-weight: 400;\"\u003e Trường hợp được chấp nhận: \u003c/span\u003e\u003c/li\u003e\n\u003c/ol\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003e- Hàng không đúng kích thước, kiểu dáng như quý khách đặt hàng \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003e- Không đủ số lượng, không đủ bộ như trong đơn hàng \u003c/span\u003e\u003c/p\u003e\n\u003col start=\"3\"\u003e\n\u003cli\u003e\u003cspan style=\"font-weight: 400;\"\u003e Trường hợp không đủ điều kiện áp dụng chính sách: \u003c/span\u003e\u003c/li\u003e\n\u003c/ol\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003e- Quá 07 ngày kể từ khi Quý khách nhận hàng. \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003e- Gửi lại hàng không đúng mẫu mã, không phải sản phẩm của DOCNEEM.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003e- Không thích, đặt nhầm mã,...\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003e- Do màn hình và điều kiện ánh sáng khác nhau, màu sắc thực tế của sản phẩm có thể chênh lệch khoảng 3-5%.\u003c/span\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/fa/71/d1/1392f873c99f3f255d6a52e10ced6913.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/fa/71/d1/1392f873c99f3f255d6a52e10ced6913.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/fa/71/d1/1392f873c99f3f255d6a52e10ced691