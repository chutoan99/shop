":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.5,"review_count":10,"review_text":"(10)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/6f/b1/71/d328b73ec1fb20d959c3e0b4161274b1.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1354,"all_time_quantity_sold":29,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: justify;\"\u003eCombo 4 cuốn truyện tranh Ehon Nhật Bản - Tớ là em bé ngoan (Thức dậy nào, Chúng mình xin lỗi bạn nhé, Để chúng mình giúp bạn nhé, Cảm ơn bạn cảnh sát hành tây) - Dành cho trẻ từ 2 - 8 tuổi\u003cbr /\u003e\u003cbr /\u003e“Tớ là em bé ngoan” là bộ sách Ehon gồm 4 cuốn “Chúng mình xin lỗi bạn nhé!”; “Để chúng mình giúp bạn!”; “Cảm ơn bạn cảnh sát hành tây!”; “Thức dậy nào! Thức dậy nào!”. Bộ sách phù hợp với trẻ từ 2 tuổi và thông qua các từ láy, từ tượng thanh, bộ sách sẽ góp phần phát triển Thùy Thái Dương, phần não ảnh hưởng đến khả năng ngôn ngữ của con đấy.\u003cbr /\u003e\u003cbr /\u003eĐi cùng với bộ sách, các bé sẽ học được những câu chuyện ứng xử rất đỗi đời thường, nhưng lại là hành trang vô cùng quan trọng để hình thành nên nhân cách và tính cách của trẻ sau này. Ở mỗi cuốn sách, bé sẽ tìm hiểu được cách bày tỏ sự biết ơn, cách nói lời xin lỗi hoặc bộc lộ đức tính luôn sẵn sàng giúp đỡ mọi người xung quanh. Những kiến thức sẽ được lồng ghép trong câu chuyện và tình huống thực tế nhưng không kém phần ngộ nghĩnh, sẽ giúp trẻ thực hành tốt hơn\u003cbr /\u003e\u003cbr /\u003eNội dung đơn giản mà sâu sắc được thể hiện bằng những hình vẽ rau củ quả vô cùng đáng yêu ngộ nghĩnh cùng với những mảng màu lớn, chắc chắn sẽ khiến các bé vô cùng thích thú và hào hứng theo dõi. Hứa hẹn đây sẽ là một bộ sách gối đầu giường của bất kỳ bạn nhỏ nào đang trong độ tuổi lên 3 đấy. \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/6f/b1/71/d328b73ec1fb20d959c3e0b4161274b1.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/6f/b1/71/d328b73ec1fb20d959c3e0b4161274b1.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/6f/b1/71/d328b73ec1fb20d959c3e0b4161274b1.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6f/b1/71/d328b73ec1fb20d959c3e0b4161274b1.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6f/b1/71/d328b73ec1fb20d959c3e0b4161274b1.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/d0/69/1b/aeae69749ce1cc340ae9625fa9fbf6af.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d0/69/1b/aeae69749ce1cc340ae9625fa9fbf6af.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d0/69/1b/aeae69749ce1cc340ae9625fa9fbf6af.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d0/69/1b/aeae69749ce1cc340ae9625fa9fbf6af.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d0/69/1b/aeae69749ce1cc340ae9625fa9fbf6af.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/b5/e0/8f/52df2218038608772a727