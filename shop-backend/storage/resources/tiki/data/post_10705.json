/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":1000,"discount_rate":2,"rating_average":4.5,"review_count":278,"review_text":"(278)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/b3/78/0d/bbf3ef0efb9b9eef96ac52ffdaa47336.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2178,"all_time_quantity_sold":1436,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<h5 style=\"box-sizing: border-box; font-family: Roboto, Helvetica, Arial, sans-serif; font-weight: 500; line-height: 1.1; color: #333333; margin-top: 10px; margin-bottom: 10px; font-size: 20px; text-align: justify;\">Thiết kế nhỏ gọn, tiện dụng</h5>\n<p style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"><span style=\"box-sizing: border-box;\">Tai Nghe Nhét Tai Langsdom Super Bass JM26</span> được thiết kế khá tinh xảo với kiểu dáng siêu hiện đại, tông màu bắt mắt, làm nổi bật hơn cho những phụ kiện phối kèm với người sở hữu.</p>\n<h5 style=\"box-sizing: border-box; font-family: Roboto, Helvetica, Arial, sans-serif; font-weight: 500; line-height: 1.1; color: #333333; margin-top: 10px; margin-bottom: 10px; font-size: 20px; text-align: justify;\">Dây chống rối tốt</h5>\n<p style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\">Dây dài 1.2m với thiết kế chống rối siêu tiện ích đem đến nhiều tiện lợi hơn cho người dùng. Ngoài ra, vỏ tai nghe làm bằng chất liệu cao cấp cho chất âm đầy đặn và rõ nét hơn, đồng thời cũng góp phần nâng cao tuổi thọ sử dụng cho sản phẩm.</p>\n<p style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: center;\"><img style=\"box-sizing: border-box; vertical-align: middle; border: 0px; display: block; max-width: 100%; height: 750px; margin-left: auto; margin-right: auto;\" title=\"Tai Nghe Nhét Tai Langston Langsdom Super Bass JM26 - Hàng Nhập Khẩu\" src=\"https://vcdn.tikicdn.com/ts/tmp/33/42/cd/db5dbb4e39d3450d2180521f9f33fe58.jpg\" alt=\"\" width=\"750\" height=\"750\" /></p>\n<h5 style=\"box-sizing: border-box; font-family: Roboto, Helvetica, Arial, sans-serif; font-weight: 500; line-height: 1.1; color: #333333; margin-top: 10px; margin-bottom: 10px; font-size: 20px; text-align: justify;\">Âm thanh sôi động</h5>\n<p style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\">Tai nghe Langsdom JM26 cho ra những âm bass với chất lượng cực đỉnh, chất âm có chiều sâu, rõ ràng, chi tiết trong từng giai điệu mang đến cho người dùng những phút giây giải trí cực đã.</p>\n<h5 style=\"box-sizing: border-box; font-family: Roboto, Helvetica, Arial, sans-serif; font-weight: 500; line-height: 1.1; color: #333333; margin-top: 10px; margin-bottom: 10px; font-size: 20px; text-align: justify;\">Dễ dàng mang theo</h5>\n<p style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\">Kích thước của tai nghe khá nhẹ, do đó bạn có thể dễ dàng gấp gọn nhét túi, balo hay túi xách đều thuận tiện, đặc biệt là khi mang theo trong những chuyến hành trình xa mà không lo vướng víu.</p>\n<h5 style=\"box-sizing: border-box; font-family: Roboto, Helvetica, Arial, sans-serif; font-weight: 500; line-height: 1.1; color: #333333; margin-top: 10px; margin-bottom: 10px; font-size: 20px; text-align: justify;\">Thoải mái hơn khi đeo</h5>\n<p style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\">Langsdom JM26 tạo điểm nhấn tiếp theo khi mà ốp tai được làm bằng mút đệm cao su chất lượng cao tạo độ mềm mại, thoải mái hơn cho người dùng khi đeo, đặc biệt là trong thời gian dài.</p>\n<h5 style=\"box-sizing: border-box; font-family: Roboto, Helvetica, Arial, sans-serif; font-weight: 500; line-height: 1.1; color: #333333; margin-top: 10px; margin-bottom: 10px; font-size: 20px; text-align: justify;\">Đàm thoại và điều khiển dễ dàng hơn</h5>\n<p style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\">Thực hiện cuộc gọi rảnh tay và chuyển tiếp các bài hát chỉ trong nháy mắt mà không cần phải chạm vào điện thoại thông minh của bạn, đó chính là việc nhờ vào bộ điều khiển từ xa và micro trực tuyến được tích hợp trên tai nghe, mang đến cho người dùng những trải nghiệm mới mẻ và nhiều hứng thú hơn.</p>\n<h5 style=\"box-sizing: border-box; font-family: Roboto, Helvetica, Arial, sans-serif; font-weight: 500; line-height: 1.1; color: #333333; margin-top: 10px; margin-bottom: 10px; font-size: 20px; text-align: justify;\">Tương thích mọi thiết bị</h5>\n<p style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\">Sử dụng cho hầu hết các dòng thiết bị phổ biến hiện nay như PC, laptop, điện thoại, máy tính bảng.</p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/b3/78/0d/bbf3ef0efb9b9eef96ac52ffdaa47336.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b3/78/0d/bbf3ef0efb9b9eef96ac52ffdaa47336.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b3/78/0d/bbf3ef0efb9b9eef96ac52ffdaa47336.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b3/78/0d/bbf3ef0efb9b9eef96ac52ffdaa47336.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b3/78/0d/bbf3ef0efb9b9eef96ac52ffdaa47336.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/fd/a6/31/d2fde7163ff681387a7303df5a8b0e56.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/fd/a6/31/d2fde7163ff681387a7303df5a8b0e56.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/fd/a6/31/d2fde7163ff681387a7303df5a8b0e56.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fd/a6/31/d2fde7163ff681387a7303df5a8b0e56.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fd/a6/31/d2fde7163ff681387a7303df5a8b0e56.jpg"}],"warranty_policy":null,"brand":{"id":150004,"name":"Langston","slug":"langston"},"current_seller":{"id":656,"sku":"6088184674655","name":"Công Nghệ Việt","link":"https://tiki.vn/cua-hang/cong-nghe-viet","logo":"38/22/a2/750588cff02eb372718898310a4dce65.jpg","price":49000,"product_id":"54682527","store_id":619,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Content","attributes":[{"code":"brand","name":"Thươn