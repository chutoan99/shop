96ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":90000,"discount_rate":5,"rating_average":4.8,"review_count":5,"review_text":"(5)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/cc/ae/50/c88ada2f7635b53459a1f3c16a300514.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":0,"all_time_quantity_sold":31,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p style=\"text-align: left;\"><span style=\"color: #008ab7;\"><strong><span style=\"font-size: medium;\">Ổ cứng Di Động Transcend StoreJet H3B 1TB TS1TSJ25H3B<br /></span></strong></span></p>\n<p><strong>Ổ cứng Di Động Transcend StoreJet H3B 1TB </strong>sẽ là một chiếc ổ cứng hoàn hảo cho việc lưu trữ của bạn. Thiết kế máy có khả năng chống sốc cực tốt giúp bạn yên tâm khi xảy ra va chạm. Bên cạnh đó,  chuẩn kết nối USB 3.0 cho tốc độ truyền tải dữ liệu khá nhanh giúp bạn không cần phải chờ đợi lâu khi truy xuất những file có dung lượng lớn.</p>\n<p style=\"text-align: center;\"><img title=\"Ổ cứng Di Động Transcend StoreJet H3B 1TB USB 3.0\" src=\"http://tikicdn.com/media/catalog/product/2/5/25h3.jpg\" alt=\"Ổ cứng Di Động Transcend StoreJet H3B 1TB USB 3.0\" width=\"570\" height=\"380\" /></p>\n<p><strong>Thông tin sản phẩm</strong></p>\n<p><strong>Quản lý dữ liệu dễ dàng với phần mềm Transcend Elite</strong></p>\n<p>Sản phẩm tích hợp phần mềm Transcend Elite giúp bạn bạn quản lý và sắp xếp các dữ liệu một cách chuyên nghiệp hơn và an toàn hơn. Ngoài ra, phần mềm này còn tích phần mềm khóa máy tính để bạn tạo mật khẩu nhằm bảo mật dữ liệu khi vắng mặt.</p>\n<p><strong>Thoải mái lưu trữ dữ liệu</strong></p>\n<p>Ổ cứng di động <strong>Transcend StoreJet H3B</strong> được trang bị dung lượng lên đến 1TB, cho phép người dùng thoải mái lưu trữ mà không lo đầy bộ nhớ. Người dùng có thể lưu trữ hình ảnh, nhạc, phim mà vẫn đảm bảo hiệu năng hoạt động tốt nhất cho chiếc máy tính.</p>\n<p><strong>Nhỏ gọn thuận tiện di động</strong></p>\n<p>Với kích thước nhỏ gọn và trọng lượng nhẹ, người dùng dễ dàng cho vào balo hoặc túi xách để mang những dữ liệu quan trọng theo bên người. Đặc biệt, vỏ silicon có khả năng chống sốc, chống bụi và chống thấm nước. Phần vỏ cứng bên trong được gia cố chắc chắn giúp ổ cứng luôn hoạt động trong tình trạng ổn định.</p>\n<p><span style=\"color: #333333;\"><strong>Thông số kỹ thuật</strong></span></p>\n<p>Loại ổ cứng: ổ cứng di động</p>\n<p>Dung lượng:</p>\n<p>Kích thước đĩa cứng: 2.5\"</p>\n<p>Nhiệt độ hoạt động: 5°C 55 °C</p>\n<p>Nguồn điện: 5V</p>\n<p>Kết nối: USB 3.0/ 3.1</p>\n<p>Hệ điều hành tương thích:  Windows XP, Windows Vista , Windows 7, Windows 8 Linux Kernel 2.6.31 trở lên, Mac OS X 10.5 trở lên</p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/cc/ae/50/c88ada2f7635b53459a1f3c16a300514.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/cc/ae/50/c88ada2f7635b53459a1f3c16a300514.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/cc/ae/50/c88ada2f7635b53459a1f3c16a300514.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/cc/ae/50/c88ada2f7635b53459a1f3c16a300514.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/cc/ae/50/c88