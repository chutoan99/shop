f":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":13,"review_text":"(13)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/c9/fd/46/5921e2e7c37038240255db9a2d7522d1.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":433,"all_time_quantity_sold":44,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003eMáy hút sữa bằng điện Philips Avent SCF394/11\u003c/h3\u003e\n\u003cul\u003e\u003cli\u003eHút sữa và kích thích núm vú như cách bú sữa tự nhiên của trẻ.\u003c/li\u003e\u003cli\u003eCông nghệ chuyển động tự nhiên giúp hút sữa nhanh hơn, nhiều hơn, trong thời gian ngắn hơn*\u003c/li\u003e\u003cli\u003eMiếng đệm bằng silicon mềm mại, co giãn, phù hợp với mọi kích thước và hình dạng núm vú của mẹ\u003c/li\u003e\u003cli\u003eHút sữa nhẹ nhàng và thoải mái mà không cần phải nghiêng người về phía trước\u003c/li\u003e\u003cli\u003eCó thể tùy chỉnh theo nhu cầu cá nhân với 8 mức kích thích và 16 mức hút\u003c/li\u003e\u003cli\u003eĐộng cơ chạy êm để hút sữa một cách kín đáo ở bất cứ nơi đâu (sử dụng dây nối)\u003c/li\u003e\u003cli\u003eChức năng bộ nhớ cho phép máy lưu lại chế đột hút và kích thích ở lần hút sữa cuối cùng\u003c/li\u003e\u003cli\u003eChức năng tạm dừng/phát cho phép mẹ điều chỉnh chế độ hoặc tạm dừng bất cứ khi muốn\u003c/li\u003e\u003cli\u003ePin có thể sạc lại để hút sữa khi đang di chuyển\u003c/li\u003e\u003cli\u003eMàn hình theo dõi thời gian\u003c/li\u003e\u003cli\u003eCó sẵn túi nhỏ và bao đựng máy hút sữa\u003c/li\u003e\u003cli\u003eÍt bộ phận, dễ lắp đặt, vệ sinh\u003c/li\u003e\u003c/ul\u003e\n\u003ch3\u003eƯu điểm của sản phẩm \u003c/h3\u003e\n\u003cp style=\"font-weight:400\"\u003e\u003cstrong\u003eTự nhiên:\u003c/strong\u003e Công nghệ hút sữa mô phỏng theo chu kỳ bú và nuốt sữa tự nhiên: tạo ra dòng sữa nhanh và hiệu quả cho mẹ cảm giác thoải mái và tự nhiên hơn\u003c/p\u003e\n\u003cp style=\"font-weight:400\"\u003e\u003cstrong\u003eDễ chịu:\u003c/strong\u003e Lớp đệm silicon mềm mại, kích thước 30mm có thể co giãn linh hoạt, vừa khít với 99.98% kích thước bầu ngực mẹ\u003c/p\u003e\n\u003cp style=\"font-weight:400\"\u003e\u003cstrong\u003eTiện lợi:\u003c/strong\u003e Thiết kế phễu hút giúp mẹ có thể ngồi hút sữa ở tư thế thoải mái, mẹ không cần ngồi thẳng. Hiệu quả đã được chứng minh lâm sàng\u003c/p\u003e\n\u003cp style=\"font-weight:400\"\u003e\u003cstrong\u003eLinh hoạt :\u003c/strong\u003e 8 cấp độ mát xa và 16 cấp độ hút giúp mẹ có thể dễ dàng lựa chọn cấp độ thoải mái nhất cho mình\u003c/p\u003e\n\u003cp style=\"font-weight:400\"\u003e\u003cstrong\u003eTự động chuyển chế độ mát xa sang hút sau 90 giây\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"font-weight:400\"\u003e\u003cstrong\u003eĐộng cơ nhỏ gọn, vận hành yên tĩnh\u003c/strong\u003e: giúp mẹ có thể sử dụng ngay cả khi bé đang ngủ\u003c/p\u003e\n\u003cp style=\"font-weight:400\"\u003e\u003cstrong\u003eHiển thị chế độ bằng đèn Led\u003c/strong\u003e dễ dàng sử dụng ngay cả ban đêm. Thiết kế van cao su có tay cầm giúp vệ sinh và tháo lắp dễ dàng hơn\u003c/p\u003e\n\u003cp style=\"font-weight:400\"\u003e\u003cstrong\u003eTiện dụng: \u003c/strong\u003eMáy sử dụng pin sạc. Chỉ cần sạc 4 giờ cho 3 lần hút sữa\u003c/p\u003e\n\u003ch3 class=\"p-heading-02 p-heading-medium p-s08__spec-main-title\"\u003eThông số kỹ thuật\u003c/h3\u003e\n\u003cdiv class=\"p-chapter-container\"\u003e\n\u003cp class=\"p-heading-03 p-heading-light p-s08__spec-title\"\u003eCông suất: Điện áp nguồn điện 100 - 240  V\u003c/p\u003e\n\u003ch3 class=\"p-heading-03 p-heading-light p-s08__spec-title\"\u003eChất liệu\u003c/h3\u003e\n\u003cul class=\"p-s08__main-list\"\u003e\u003cli\u003eBình sữa: Polypropylene, Không chứa BPA*Núm vú thông khí: Silicone, Không chứa BPA*Máy hút sữa: Không chứa BPA* (chỉ các bộ phận tiếp xúc với sữa)\u003c/li\u003e\u003c/ul\u003e\n\u003c/div\u003e\n\u003ch3\u003eHướng dẫn bảo quản\u003c/h3\u003e\n\u003cul\u003e\u003cli\u003eTháo rời các bộ phận để vệ sinh trước lần dùng đầu tiên và sau mỗi lần sử dụng\u003c/li\u003e\u003cli\u003eSử dụng nước rửa bình chuyên dụng để làm sạch các bộ phận và rửa lại bằng nước sạch\u003c/li\u003e\u003cli\u003eKhử trùng bằng nước sôi hoặc sử dụng máy tiệt trùng hơi nước ở nhiệt độ 120oC\u003c/li\u003e\u003cli\u003eĐộng cơ máy: dùng khăn ẩm để vệ sinh bên ngoài\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/57/4f/38/cec61e72facf025592c27f19abb6e9f3.png\" alt=\"\" width=\"750\" height=\"1200\" /\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/1e/f5/15/7c76a1c055ebc6626492c6b7da8adbed.jpg\" alt=\"\" width=\"750\" height=\"646\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/2c/1d/ab/2fea17b8b08660157691ebdd3ab857f5.jpg\" alt=\"\" width=\"750\" height=\"743\" /\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/17/f9/52/cb416f6ff37325c41b3b0fb8d505e968.jpg\" alt=\"\" width=\"750\" height=\"739\" /\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/b2/5d/e3/2a7b1b5c1e3f77386dbab349413a589e.jpg\" alt=\"\" width=\"750\" height=\"499\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/2b/9b/8d/1a74ab4ca79c1e0c4a7055843c2c5e44.jpg\" alt=\"\" width=\"750\" height=\"1156\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/34/56/5f/4bbf2d04a61888c5e19c8086b1ac238b.png\" alt=\"\" width=\"750\" height=\"1303\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi p