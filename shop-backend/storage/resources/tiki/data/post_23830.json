olor":"#D93843","href":null,"text":"9.9"},{"placement":"pdp_badge","code":"is_hero","type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":true,"return_reason":"any_reason"}},"discount":100000,"discount_rate":15,"rating_average":5,"review_count":3,"review_text":"(3)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/11/ef/46/e644b605fe5b2a38fb5d7f2949db056f.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":482,"all_time_quantity_sold":13,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eBảo vệ chuyên nghiệp: bộ lọc HEPA H13 \u0026#43; lớp phủ y tế Ion bạc ngăn chặn sự phát triển trở lại của siêu vi trong bộ lọc.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eHEPA H13 là gì?\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eLà sản phẩm lọc tinh nhất trong các sản phẩm lọc khí sạch, H13 là một tiêu chuẩn của lọc HEPA, hiệu xuất đạt 99,97 – 99,99% cho cỡ hạt là 0,3micron.\u003cbr /\u003eThường HEPA đạt và trên mức H13 có thể được gọi là True HEPA. Bộ lọc HEPA H13 thực sự được chứng minh có thể lọc sạch H1N1, thu lại hiệu quả các hạt trong không khí như bào tử nấm mốc, mạt bụi, phấn hoa, xơ vải, bụi gia dụng, PM 2.5, lông thú nuôi,  và giúp giảm mùi nấu ăn không mong muốn, VOC, khói sơn và các chất ô nhiễm hóa học.\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003e\u003cimg class=\"wp-image-3061 aligncenter\" style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/product/4d/b7/ce/68e1127877d3f2bba2be90917c85d753.jpg\" alt=\"\" width=\"515\" height=\"515\" /\u003e\u003cbr /\u003e\u003cstrong\u003eThiết kế hoàn hảo 360°:\u003c/strong\u003e kín khí hoàn hảo là điều kiện tiên quyết của quá trình lọc không khí. Thiết kế vòng tròn 360° và xếp ly của ULTTY giúp tăng diện tích bề mặt của bộ lọc HEPA và do đó tăng hiệu quả hấp thụ hiệu quả các hạt có hại trong không khí và giảm mùi hôi.\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003e\u003cimg class=\"wp-image-3328 aligncenter\" style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/product/fb/63/32/2a391a77b442d56011a63df44eb19af8.jpg\" alt=\"\" width=\"524\" height=\"524\" /\u003e\u003cbr /\u003e\u003cstrong\u003eHệ lọc 3 lớp:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e1. Màng lọc trước Pre-filter bằng kim loại tĩnh điện: Giữ lại bụi thô như long động vật nuôi và xơ vải, …\u003cbr /\u003e2. Lớp phủ y tế ion bạc: Khử khuẩn và ngăn chặn vi trùng phát triển lại.\u003cbr /\u003e3. Bộ lọc HEPA H13: Thu giữ 99,97% hạt nhỏ 0,3 micron\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003e\u003cimg class=\"wp-image-3327 aligncenter\" style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/product/bc/80/4c/a3268d38a6d1d209a021aed8a2acb786.jpg\" alt=\"\" width=\"545\" height=\"545\" /\u003e\u003cbr /\u003e\u003cstrong\u003eThay bộ lọc dễ dàng\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003eVới thiết kế ULTTY, bạn có thể dễ dàng thay bộ lọc HEPA H13 trong 1 phút. Chỉ cần xoay nắp trên ngược chiều kim đồng hồ để mở, tháo bộ lọc cũ, đặt bộ lọc mới vào quạt lọc không khí, xoay theo chiều kim đồng hồ để cố định nó, thay thế hoàn thành.\u003c/p\u003e\n\u003cp\u003ePhù hợp: Quạt lọc không khí R21 chính hãng của ULTTY, và tất cả các mẫu quạt lọc khác của Thương hiệu ULTTY.\u003c/p\u003e\n\u003cp\u003eKích thước: 6.3×6.3×5 inches/ 16x16x12.7 cm\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/11/ef/46/e644b605fe5b2a38fb5d7f2949db056f.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/11/ef/46/e644b605fe5b2a38fb5d7f2949db056f.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/11/ef/46/e644b605fe5b2a38fb5d7f2949db056f.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/11/ef/46/e644b605fe5b2a38fb5d7f2949db056f.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/11/ef/46/e644b605fe5b2a38fb5d7f2949db056f.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/c8/94/e5/f9ccdfece45dca86fb659fc35348ad1b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c8/94/e5/f9ccdfece45dca86fb659fc35348ad1b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c8/94/e5/f9ccdfece45dca86fb659fc35348ad1b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c8/94/e5/f9ccdfece45dca86fb659fc35348ad1b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c8/94/e5/f9ccdfece45dca86fb659fc35348ad1b.jpg"},{"base_url":"https://salt.tikicdn.com/ts/produ