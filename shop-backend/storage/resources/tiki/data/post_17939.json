_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":100000,"discount_rate":20,"rating_average":5,"review_count":5,"review_text":"(5)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ef/75/7a/0483c9545aa7b71d358221511bea22a6.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1568,"all_time_quantity_sold":19,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cspan style=\"color:#008000;\"\u003e\u003cstrong\u003eBÓNG TẬP GYM YOGA GLOFIT-GFY001 \u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cspan style=\"color:#008000;\"\u003e\u003cstrong\u003e\u003ciframe src=\"//www.youtube.com/embed/loIWJ0YKYes\" width=\"750\" height=\"421\" allowfullscreen=\"\"\u003e\u003c/iframe\u003e\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003eBóng tập yoga, gym \u003cstrong\u003eGlofit GFY001\u003c/strong\u003e là dòng bóng tập chuyên nghiệp được sự tin tưởng của các vận động viên và người tập gym, yoga chuyên nghiệp. Đây là dòng bóng tập cao cấp sử dụng đa năng giúp tăng thể lực trong thể thao, tập vật lý trị liệu hoặc dùng cho mục đích vui chơi giải trí. Bóng có độ bền cao, chịu lực tốt tới 200kg, không nổ khi bị vật nhọn đâm vào ( an toàn cho mọi lứa tuổi, kể cả trẻ nhỏ ).\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/e7/8c/28/b46e83a2709ad50447fe325ebcaf1f2f.jpg\" alt=\"\" width=\"600\" height=\"600\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cspan style=\"color:#008000;\"\u003e\u003cem\u003e\u003cstrong\u003eCách chọn đường kính bóng Glofit GFY001\u003c/strong\u003e\u003c/em\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e→ Dưới 1m75 dùng bóng đường kính 65cm \u003cbr /\u003e→ Trên 1m75 dùng bóng đường kính 75cm\u003cbr /\u003e\u003cstrong\u003eNote:\u003c/strong\u003e Đường kính bóng theo tiêu chuẩn theo chiều cao, tuy nhiên quý khách hàng cũng có thể chọn size theo sở thích của mình tùy vào từng mục đích sử dụng\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003e»\u003c/strong\u003e Bóng tập yoga gym Glofit GFY001 dùng để tập yoga và tập gym chuyên dụng, đây là dòng bóng thể thao đa năng nên phù hợp cho rất nhiều mục đích sử dụng và tập luyện khác nhau : Tập tăng cường thể lực, tập tăng cơ làm săn chắc các bó cơ, tập giảm mỡ, tập vậy lý trị liệu…Ngoài ra bóng tập yoga gym Glofit còn có thể sử dụng trong vui chơi giải trí, trong các gameshow hoặc dùng để ngồi làm việc thay ghế (chọn đường kính 75cm).\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/34/13/25/30653e9b8fe97fefe54960b1f1bdc203.jpg\" alt=\"\" width=\"600\" height=\"800\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e \u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color:#008000;\"\u003e\u003cem\u003e\u003cstrong\u003eMục đích sử dụng của bóng Yoga Gym Glofit GFY001 \u003c/strong\u003e\u003c/em\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e1.\u003c/strong\u003e Sử dụng trong việc tập yoga, tập gym, tập tăng thể lực trong thể thao\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e2.\u003c/strong\u003e Sử dụng bóng Glofit GFY001 trong việc tập vật lý trị liệu, tập phục hồi sau chấn thương (Theo chỉ định của bác sĩ)\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e3.\u003c/strong\u003e Sử dụng tập thể dục giãn gân cốt, giúp thẳng cột sống lưng, giảm đau nhức mỏi thắt lưng, giảm stress lúc mỏi mệt\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e4.\u003c/strong\u003e Trong văn phòng có thể dùng làm nghế ngồi làm việc (Có thể dùng cho bà bầu ngồi rất tốt khi sinh)\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e5.\u003c/strong\u003e Sử dụng bóng trong mục đích trang trí sự kiện, nhiếp ảnh hoặc dùng cho bé chơi\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e6.\u003c/strong\u003e Sử dụng trong các mini game, gameshow…(Bóng tập yoga gym Glofit dùng được cả trên cạn và dưới nước)\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e»\u003c/strong\u003e Ngoài ra bóng tập yoga gym glofit GFY001 có thể dùng cho nhiều mục đích khác vì đây là dòng bóng thể thao chất lượng cao đa năng có độ bền cao, chịu lực tốt. Bóng có bề mặt nhám tạo độ bám cao khi sử dụng.\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/b9/74/b0/1aa2b2d4c0cdc23f27e8c87a58bb53f6.jpg\" alt=\"\" width=\"600\" height=\"600\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/81/89/34/b13a17fb398f504a71cf534ff07d6de7.jpg\" alt=\"\" width=\"600\" height=\"600\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/b5/e8/0e/3dd5f010aa898168e45ebb65c6c70db8.jpg\" alt=\"\" width=\"600\" height=\"600\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ef/75/7a/0483c9545aa7b71d358221511bea22a6.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ef/75/7a/0483c9545aa7b71d358221511bea22a6.jpg","medium_url":"https:/