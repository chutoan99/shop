ng","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/24/4c/c9/cc4fbf07461fb8768f2adaa70f83c2e2.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1569,"all_time_quantity_sold":10,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eBộ Dầu Gội Xả Salon Link Extra là một sản phẩm chăm sóc tóc chuyên nghiệp được rất nhiều người sử dụng và có phản hồi tốt. Chuyên dùng cho spa nên dung tích được thiết kế rất to, vô cùng tiết kiệm và kinh tế.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eBộ sản phẩm cung cấp protein tơ tằm và các axit amin thiết yếu cho tóc giúp tóc giữ được độ ẩm, bóng mượt, phục hồi tóc hư tổn.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eCác thành phần nguồn gốc tự nhiên như bơ hạt mỡ, mật ong, tơ tằm… được nghiên cứu và điều chế theo tỷ lệ hoàn hảo giúp nuôi dưỡng mái tóc suôn, mềm mượt, cung cấp độ bóng tự nhiên cho tóc, làm tóc khỏe mạnh và bồng bềnh hơn.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eBộ Dầu Gội Xả Salon Link Extra Nhật Bản giúp làm sạch da đầu và tóc, lấy đi chất bẩn, mồ hôi, bã nhờn giúp giảm thiểu tối đa nguy cơ hình thành gàu, các bệnh về da đầu.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eBổ sung dưỡng chất cho tóc, đặc biệt là Protein và axit amin quan trọng, giúp phục hồi tận sâu bên trong lõi tóc, giúp mái tóc suôn mượt, óng ả, tràn đầy sức sống.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003ePhục hồi tóc bị hư tổn nặng do tác động của nhiệt, hóa chất, nuôi dưỡng mái tóc chắc khỏe, mềm mại.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eSau một thời gian sử dụng, bạn sẽ cảm nhận được sự thay đổi tích cực trên mái tóc của mình, không còn khô xơ, chẻ ngọn, gãy rụng.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eSử dụng kết hợp với dầu xả giúp mái tóc được bổ sung dưỡng chất nhiều hơn, phục hồi tóc nhanh hơn và nuôi dưỡng tóc chắc khỏe, mềm mượt lâu dài.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eĐặc biệt, bộ dầu gội xả Salon Link Extra Không Chứa Silicone – một thành phần không tốt nhưng lại rất quen thuộc trong các sản phẩm dành cho tóc đặc biệt là dầu gội.\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cspan style=\"color: #ed1c24;\"\u003e(Thông tin hữu ích: Thành phần Silicone trong dầu gội có tác dụng làm suôn mượt và bồng bềnh tóc xơ, tạo hiệu ứng tóc óng ả, bóng khỏe hơn. Nhưng cảm giác bóng mượt trên tóc chỉ là “Giả”. Bởi tóc hoàn toàn không có khả năng hấp thụ silicone, khi sử dụng tóc sẽ tích lũy silicone trên bề mặt gây bít, tắc nang lông và ngăn cản sự hấp thụ của các dưỡng chất khác đồng thời gây nên tình trạng tóc bết dính nhanh dù mới gội đầu cách đó không lâu.)\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003eVậy nên Non-Silicone là một điểm cộng cực kỳ lớn của bộ gội xả Salon Link Extra đó.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eThành phần chiết xuất từ thiên nhiên và lành tính, an toàn cho da đầu của bạn, không gây kích ứng da, và không có chất hóa học ảnh hưởng đến sức khỏe.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eSản phẩm đạt tiêu chuẩn khắt khe của người Nhật về chất lượng và độ an toàn nên mọi người cứ an tâm sử dụng 1 lần nha! \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/24/4c/c9/cc4fbf07461fb8768f2adaa70f83c2e2.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/24/4c/c9/cc4fbf07461fb8768f2adaa70f83c2e2.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/24/4c/c9/cc4fbf07461fb8768f2adaa70f83c2e2.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/24/4c/c9/cc4fbf07461fb8768f2adaa70f83c2e2.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/24/4c/c9/cc4fbf07461fb8768f2adaa70f83c2e2.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/0b/fe/06/da55b7724b76432bf6ff059ee3f5b98f.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0b/fe/06/da55b7724b76432bf6ff059ee3f5b98f.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/0b/fe/06/da55b7724b76432bf6ff059ee3f5b98f.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0b/fe/06/da55b7724b76432bf6ff059ee3f5b98f.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0b/fe/06/da55b7724b76432bf6ff059ee3f5b98f.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/93/5f/58/7ede03ae37d0f85119cd3cd1aac7d407.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/93/5f/58/7ede03ae37d0f85119cd3cd1aac7d407.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/93/5f/58/7ede03ae37d0f85119cd3cd1aac7d407.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/93/5f/58/7ede03ae37d0f85119cd3cd1aac7d407.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/93/5f/58/7ede03ae37d0f85119cd3cd1aac7d407.jpg"}],"warranty_policy":null,"brand":{"id":243191,"name":"Kumano","slug":"kumano"},