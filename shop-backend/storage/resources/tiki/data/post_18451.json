ext":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":3,"review_text":"(3)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/0f/16/5e/58faad5dd1c844863f2abfee77ea4980.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1128,"all_time_quantity_sold":23,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2\u003e\u003cstrong\u003eBioGrow – Phân bón Siêu kích\u003c/strong\u003e\u003cstrong\u003e kie lan, thân mầm lá - chuyên biệt hoa lan\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003ePhân bón kích kie lan BioGrow là loại phân bón 100% hữu cơ vi sinh, giàu Potassium Humate cùng các chất dinh dưỡng thiết yếu hỗ trợ tối đa cho lan trong giai đoạn muốn cây ra nhiều mầm, lá, kích kei phi điệp, giúp mầm ra nhanh, nuôi kie mập khoẻ và dưỡng mầm lá xanh tươi\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eCô đặc, hàm lượng dinh dưỡng x2\u003c/li\u003e\n\u003cli\u003eĐa năng: bón là và bón góc cho tất cả các loại cây cảnh\u003c/li\u003e\n\u003cli\u003e100% hữu cơ vi sinh, AN TOÀN\u003c/li\u003e\n\u003cli\u003eHỗ trợ tăng đề kháng, chóng chọi sâu bệnh\u003c/li\u003e\n\u003cli\u003eThương hiệu DOCNEEM được bảo hộ tại Cục sở hữu trí tuệ Việt Nam\u003c/li\u003e\n\u003cli\u003eKiểm định chất lượng bởi TỔNG CỤC TIÊU CHUẨN ĐO LƯỜNG CHẤT LƯỢNG\u003c/li\u003e\n\u003c/ul\u003e\n\u003cdiv\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/a2/fe/04/77905d23d3978944160bebff7e4fe0b7.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003c/div\u003e\n\u003ch2\u003e\u003cstrong\u003eThành phần\u003c/strong\u003e\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003ePotassium Humate (80%)\u003c/li\u003e\n\u003cli\u003eFulvic Acid (12%)\u003c/li\u003e\n\u003cli\u003eN (0.215%)\u003c/li\u003e\n\u003cli\u003eP2O5 (0.75%)\u003c/li\u003e\n\u003cli\u003eK2O (1.21%)\u003c/li\u003e\n\u003c/ul\u003e\n\u003cdiv\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/92/a3/b5/3c3742aba7f5ec443db988e8d1280848.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eCông dụng\u003c/strong\u003e\u003c/h2\u003e\n\u003c/div\u003e\n\u003cp\u003eĐược ủ lên men với công thức độc quyền, giàu khoáng chất, kích kie lan BioGrow được đóng gói dưới dạng dung dịch, dễ hoà tan và giúp cây hấp thu nhanh hơn các phân bón dạng hạt thông thường. Hàm lượng dinh dưỡng cao, đặc biệt là 80% Potassium Humate thúc đẩy sự tổng hợp diệp lục ở thân lá lên mức cao nhất.\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eSiêu kích kie lan, mầm to khoẻ, đề kháng cao, lớn nhanh\u003c/li\u003e\n\u003cli\u003eThúc đẩy tăng trưởng mầm lá, phù hợp cho các loại hoa, cây cảnh\u003c/li\u003e\n\u003cli\u003eThích hợp với các loại đất khác nhau của từng vùng miền hoặc giá thể\u003c/li\u003e\n\u003cli\u003eGiàu Kali Humate (Potassium Humate) tăng đề kháng, giúp thân-mầm-lá khoẻ, xanh bóng\u003c/li\u003e\n\u003c/ul\u003e\n\u003cdiv\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/1c/9e/fd/dab6aa6f82820542472b5a3ec8c4564b.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003c/div\u003e\n\u003ch2\u003e\u003cstrong\u003eCách sử dụng\u003c/strong\u003e\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003eCây khoẻ: 7-10ml/1 lít nước. Bón lá hoặc bón gốc định kỳ 2 lần/tháng\u003c/li\u003e\n\u003cli\u003eCây yếu: 5ml/1 lít nước. Bón lá hoặc bón gốc định kỳ 2 lần/tháng\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch2\u003e\u003cstrong\u003eThông tin khác\u003c/strong\u003e\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003eHạn sử dụng: 36 tháng kể từ ngày sản xuất\u003c/li\u003e\n\u003cli\u003eDung tích: 500 ml\u003c/li\u003e\n\u003cli\u003eBảo quản nơi khô ráo, thoáng mát, vặn kín nắp chai sau khi sử dụng và tránh ánh nắng trực tiếp từ mặt trời\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003ekie lan, cách kích kie lan, kích kie phi điệp, kie phi điệp\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/da/28/0f/cba747684c60dc3b07e4e29c06c9788c.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/0f/16/5e/58faad5dd1c844863f2abfee77ea4980.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0f/16/5e/58faad5dd1c844863f2abfee77ea4980.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/0f/16/5e/58faad5dd1c844863f2abfee77ea4980.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0f/16/5e/58faad5dd1c844863f2abfee77ea4980.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0f/16/5e/58faad5dd1c844863f2abfee77ea4980.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/a2/fe/04/fb11b5bebce9f111898fdb62045480de.jpg","is_gallery":true,"lab