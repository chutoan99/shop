con":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/33/10/85/92d38ef21e2a29893249d4d0fec9f009.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":783,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align:center;\"\u003e\u003cstrong\u003eTAI NGHE KHÔNG DÂY CHẤT LƯỢNG CAO TẦM GIÁ RẺ EARFUN AIR MINI\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/fd/c8/32/3c9fef2732e335bfba726dda7f1f549d.jpg\" alt=\"\" width=\"750\" height=\"972\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTiếp nối sự thành công, đem tính năng mạnh mẽ tới tầm giá rẻ\u003c/strong\u003e\u003cbr /\u003eDựa trên những thành công vang dội trên thị trường của dòng Air, năm nay EarFun tiêp tục ra mắt cặp tai nghe EarFun Air Mini hoàn toàn mới. Cặp tai nghe này sở hữu thiết kế \"có đuôi\" đặc trưng của dòng Air với mặt ngoài có thể cảm ứng, điều khiển từ nhạc, cuộc gọi đến âm lượng và có chip BES2500IU bên trong mới nhất với chuẩn kết nối Bluetooth 5.2 hiện đại.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/d6/1e/15/78449b53696cce9176944ce658c90acd.jpg\" alt=\"\" width=\"750\" height=\"972\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eMàng loa Composite 8mm, chế độ Gaming Mode\u003c/strong\u003e\u003cbr /\u003eĐảm nhiệm khả năng tái tạo âm thanh cho EarFun Air Mini là cặp loa Dynamic 8mm dạng Composite, cho chất âm chi tiết, hướng tới sự sôi động và có nhiều âm trầm. Những bạn có gu nhạc trẻ, nhạc Dance, Pop, Rock chắc chắn sẽ phù hợp với kiểu âm thanh từ cặp tai nghe này. Air Mini cũng được trang bị thêm cả chế độ Gaming Mode, giảm độ trễ xuống chỉ còn 100ms để dễ dàng sử dụng cho việc chơi game và xem phim.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp style=\"text-align:center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/aa/31/0a/a15e03f3237f3e180a7ebda88cbd2930.jpg\" alt=\"\" width=\"750\" height=\"972\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThời lượng sử dụng 25 tiếng và kháng nước IPX7\u003c/strong\u003e\u003cbr /\u003eTrong một lần sạc đầy, EarFun Air Mini có thể sử dụng được trong 25 tiếng, bao gồm 5 tiếng sử dụng liên tục ở tai nghe và 20 tiếng được cung cấp bởi hộp sạc, sẵn sàng cho việc sử dụng cả một ngày dài. Với chuẩn kháng nước cao tới IPX7, đây cũng là một cặp tai nghe với độ bền cao để có thể sử dụng khi đi tắm, đi bơi hay tập thể dục ở những điều kiện ẩm ướt khắc nghiệt nhất.\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003e\u003cstrong\u003eTHÔNG SỐ KỸ THUẬT:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eMàng loa Dynamic Composite 8mm\u003c/li\u003e\n\u003cli\u003eDải tần đáp ứng 20Hz - 20kHz\u003c/li\u003e\n\u003cli\u003eChuẩn Bluetooth 5.2\u003c/li\u003e\n\u003cli\u003eChế độ Gaming Mode độ trễ 100ms\u003c/li\u003e\n\u003cli\u003eDung lượng pin: 35mAh x 2 (tai nghe) và 310mAh (hộp sạc)\u003c/li\u003e\n\u003cli\u003eThời lượng sử dụng: 5 tiếng (tai nghe) và 25 tiếng (tổng cộng)\u003c/li\u003e\n\u003cli\u003eKhả năng kháng nước chuẩn cao IPX7\u003c/li\u003e\n\u003cli\u003eTrọng lượng: 42g\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/33/10/85/92d38ef21e2a29893249d4d0fec9f009.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/33/10/85/92d38ef21e2a29893249d4d0fec9f009.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/33/10/85/92d38ef21e2a29893249d4d0fec9f009.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/33/10/85/92d38ef21e2a29893249d4d0fec9f009.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/33/10/85/92d38ef21e2a29893249d4d0fec9f009.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/fd/c8/32/5e98d1632ce890a3d118efb203d11e3f.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/fd/c8/32/5e98d1632ce890a3d118efb203d11e3f.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/fd/c8/32/5e98d1632ce890a3d118efb203d11e3f.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fd/c8/32/5e98d1632ce890a3d118efb203d11e3f.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fd/c8/32/5e98d1632ce890a3d118efb203d11e3f.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/d6/1e/15/ee1b84829e8b20ae17f097b3972a2aaf.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d6/1e/15/ee1b84829e8b20ae17f097b3972a2aaf.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d6/1e/15/ee1b84829e8b20ae17f097b3972a2aaf.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d6/1e/15/ee1b84829e8b20ae17f097b3972a2aaf.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d6/1e/15/ee1