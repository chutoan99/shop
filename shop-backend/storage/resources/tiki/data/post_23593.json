kèm bộ thu USB.\u003c/p\u003e\n\u003cp\u003e+ Số lượng phím: 82 (Bao gồm 13 phím đa phương tiện).\u003c/p\u003e\n\u003cp\u003e+ Khả năng kết nối đa thiết bị: 3 thiết bị.\u003c/p\u003e\n\u003cp\u003e+ Phạm vi hoạt động: lên đến 10m.\u003c/p\u003e\n\u003cp\u003e+ Pin: 1xAAA 1.5vol.\u003c/p\u003e\n\u003cp\u003e+ Kích thước: 308 x 144.2 x 21mm (Dài x Rộng x Cao).\u003c/p\u003e\n\u003cp\u003e+ Trọng lượng: 445g. (±10g).\u003c/p\u003e\n\u003cp\u003e+ Hệ điều hành tương thích: Windows/Android/MacOS/iOS.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e BAO GỒM:\u003c/p\u003e\n\u003cp\u003e+ 1 x Bàn phím PROLiNK GK5001M. \u003c/p\u003e\n\u003cp\u003e+ 1 x Đầu thu Nano USB. \u003c/p\u003e\n\u003cp\u003e+ 1 x Pin AAA. \u003c/p\u003e\n\u003cp\u003e+ 1 x Hướng dẫn sử dụng.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e CAM KẾT \u0026amp; BẢO HÀNH:\u003c/p\u003e\n\u003cp\u003e+ 100% sản phẩm chính hãng PROLiNK.\u003c/p\u003e\n\u003cp\u003e+ Bảo hành chính hãng 1 đổi 1 trong vòng 12 tháng.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/2a/7f/bc/2174fd4e800994bd8d000e6f6bf67575.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/2a/7f/bc/2174fd4e800994bd8d000e6f6bf67575.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/2a/7f/bc/2174fd4e800994bd8d000e6f6bf67575.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2a/7f/bc/2174fd4e800994bd8d000e6f6bf67575.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2a/7f/bc/2174fd4e800994bd8d000e6f6bf67575.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/95/7f/45