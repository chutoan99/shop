c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"freeship_xtra","type":"pdp_icon_badge","index":2,"icon":"https://salt.tikicdn.com/ts/upload/be/67/48/04a82ab8df178e1a13bde38316081865.png","icon_width":91,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":true,"return_reason":"any_reason"}},"discount":22000,"discount_rate":32,"rating_average":4.7,"review_count":116,"review_text":"(116)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/9f/3e/b0/89764b6835985ecd4ba01582d41f946d.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2028,"all_time_quantity_sold":876,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e️️\u003cstrong\u003e MANG TUỔI THƠ TRỞ LẠI – Và bạn sẽ chẳng bao giờ già đi\u003c/strong\u003e ️️\u003c/p\u003e\n\u003cp\u003e️ Những em nhỏ thành thị của thế kỉ XXI, lớn lên cùng với những tòa nhà chung cư xi măng cốt thép, lớn lên với những thứ đồ điện điện tử thông minh, sành điệu. Chưa một lần chạm đôi chân trần vào đất thịt mát lạnh, chưa một lần trốn mẹ ngủ trưa trèo cây hái trộm quả ngọt…\u003cbr /\u003e️ Những người lớn thành thị của thế kỉ XXI, cùng với nhịp chảy của cuộc đời, với nỗi lo cơm áo gạo tiền, với sự phồn hoa nơi phố thị, họ dường như quên mất tuổi thơ của mình. Chẳng còn nhớ những hôm cãi nhau với đứa bạn thân mấy buổi chẳng nói chuyện, những ngày ghen tị với đứa em vì được mẹ chiều hơn…\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eVậy phải tìm nó ở đâu?\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eChẳng phải tìm ở đâu xa xôi, chẳng cần phải vất vả lục lại kí ức làm gì. Chỉ cần “quờ tay là thấy ngay” những kỉ niệm, nhưng yêu thương, giận hờn của tuổi thơ trong cuốn sách mang đậm màu sắc hoài niệm: “\u003cstrong\u003eÔ kìa! Tuổi thơ\u003c/strong\u003e”.\u003c/p\u003e\n\u003cp\u003eNhững người đã đi qua tuổi thơ hãy đọc “\u003cstrong\u003eƠ kìa tuổi thơ”\u003c/strong\u003e để thấy tuổi thơ còn mãi trong mình. Những em nhỏ thành thị hãy đọc \u003cstrong\u003e“Ơ kìa tuổi thơ”\u003c/strong\u003e được biết thêm một tuổi thơ khác hẳn với tuổi thơ mình đang có.\u003c/p\u003e\n\u003cp\u003eBằng những cảm nhận thật hồn nhiên, chân thực đầy xúc động của một trái tim non nớt nhưng không dại khờ, thơ ngây nhưng không thơ dại, Tác giả \u003cstrong\u003eĐào Thiên An\u003c/strong\u003e đã vẽ lên một bức tranh tuổi thơ với rất nhiều các cung bậc cảm xúc khác nhau. Khi thì là những trò đùa tinh nghịch; khi thì là những xúc cảm vui buồn khi phải xa bạn; lúc lại là những day dứt, muộn phiền khi mắc lỗi với người thân, với bạn bè…\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eƠ kìa tuổi thơ\u003c/strong\u003e” được tác giả gom góp trong bốn năm nên xúc cảm không liền mạch và không có giới hạn. Chính vì vậy mỗi một câu chuyện là một cung bậc cảm xúc, là một nỗi niềm ở một thời điểm, một độ tuổi khác nhau. Đây cũng chính là điều thú vị tạo nên những mạch nguồn khác lạ, độc đáo của “Ơ kìa! Tuổi thơ”.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/9f/3e/b0/89764b6835985ecd4ba01582d41f946d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/9f/3e/b0/89764b6835985ecd4ba01582d41f946d.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/9f/3e/b0/89764b6835985ecd4ba01582d41f946d.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9f/3e/b0/89764b6835985ecd4ba01582d41f946d.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9f/3e/b0/89764b6835985ecd4ba01582d41f946d.jpg"},{"base_url":"https://salt.tikicdn.com/media/catalog/producttmp/d8/49/33/2fe18655a3ac20c1178e77475c6df24a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/producttmp/d8/49/33/2fe18655a3ac20c1178e77475c6df24a.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/producttmp/d8/49/33/2fe18655a3ac20c1178e77475c6df24a.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/producttmp/d8/49/33/2fe18655a3ac20c1178e77475c6df24a.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/media/catalog/producttmp/d8/49/33/2fe18655a3ac20c1178e77475c6df24a.jpg"},{"base_url":"https://salt.tikicdn.com/media/catalog/producttmp/c2/99/f9/20178c21f3677edf1f6a543021aef389.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/media/catalog/producttmp/c2/99/f9/20178c21f3677edf1f6a543021aef389.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/media/catalog/producttmp/c2/99/f9/20178c21f3677edf1f6a543021aef389.jpg","position":null,"small_url":"https://salt.