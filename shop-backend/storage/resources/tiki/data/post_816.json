und_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":80000,"discount_rate":27,"rating_average":4.6,"review_count":137,"review_text":"(137)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/17/b7/cf/4858b2cd05a2394e6dd3941ae90f67c4.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1590,"all_time_quantity_sold":629,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eTOP 10 THƯƠNG HIỆU UY TÍN HÀNG ĐẦU CHÂU Á\u003c/p\u003e\n\u003cp\u003e1. Thành Phần: Ngoài thành phần chính được chiết xuất từ Hà Thủ Ô, nay được bổ sung thêm: Dầu olive, Dầu hạt macca, Argan oil, Collagen, Tinh dầu Bưở\u003cbr /\u003eHà thủ ô: Hà Thủ Ô được coi là một vị thảo dược \"thần dược\" trong sách cổ xưa với rất nhiều công dụng đối với sức khỏe như bồi bổ khí huyết, tăng cường lưu thông máu giúp da dẻ hồng hà. Đặc biệt công dụng nổi bật nhất được công nhận hiệu quả rất tốt đối với tóc, làm chậm quá trình bạc tóc, làm đen tóc cũng như kích thích mọc tóc.\u003c/p\u003e\n\u003cp\u003eTuy nhiên, bạn có thể chưa biết đến phần thân và rễ của cây hà thủ ô có chứa một lượng lớn các chất bao gồm: anthranoid, chrysophanol, emodin, physcion, protid, lipid, lecithin, tanin cùng các chất vô cơ, chất tan trong nước. Đây là những thành phần có tác dụng nổi bật là kích thích lưu thông khí huyết trên da đầu, ổn định sự phân tán của chất melanin giúp tóc đen.\u003cbr /\u003eDầu Olive: chứa chất c.h.ố oxi hóa. Có khả năng làm tăng sự khỏe mạnh cho da dầu, đồng thời còn đóng vai trò là dưỡng chất tự nhiên giúp chăm sóc tóc làm tóc sáng bóng và mềm mại hơn\u003cbr /\u003eDầu hạt macca: Nuôi dưỡng tế bào tóc, phục hồi tóc hư tổn, giúp tóc mềm mại, óng mượt hơn\u003cbr /\u003eDầu Argan: Làm bóng tóc, dưỡng ẩm giúp tóc mềm mượt, phục hồi tóc hư tổn, kích thích mọc tóc và hỗ trợ trị gàu\u003cbr /\u003eTinh dầu bưởi: giảm rụng tóc, kích thích mọc tóc, nhờ hoạt tính kháng khuẩn cao nên sẽ cho bạn một da đầu sạch gàu\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/b0/87/83/1c814d4bf7a7c86e636ee4ea09077932.jpg\" alt=\"\" width=\"720\" height=\"376\" /\u003e\u003c/p\u003e\n\u003cp\u003e2. Công Dụng: \u003cbr /\u003eLàm chậm quá trình bạc tóc \u003cbr /\u003eGiảm gãy rụng, phục hồi tóc hư tổn.\u003cbr /\u003eDưỡng tóc mềm mượt và chắc khỏe hơn.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ac/11/c5/6d73124402f12e339e55523be1e706b2.jpg\" alt=\"Dầu gội thảo dược HÀ THỦ Ô Chiết xuất từ 6 loại thảo dược - Cân Bằng Sắc Tố Melanin Khỏi lo bạc tóc rụng tóc Cocayhoala 300g\" width=\"643\" height=\"643\" /\u003e\u003c/p\u003e\n\u003cp\u003e3.Tại sao bạn nên lựa chọn dầu gội hà thủ ô trong việc giảm rụng tóc, bạc tóc?\u003cbr /\u003e=\u0026gt; Sử dụng thành phần từ thiên nhiên, an toàn cho người sử dụng\u003c/p\u003e\n\u003cp\u003e=\u0026gt;Ứng dụng công nghệ Nano vào trong sản xuất. Tạo ra các hạt phân tử siêu nhỏ, mang theo các dưỡng chất thẩm thấu vào tận sâu bên trong chân tóc giúp cải thiện và nuôi dưỡng tóc chắc khỏe.\u003c/p\u003e\n\u003cp\u003e=\u0026gt;Tinh chất Hà thủ ô nano - kích thích sắc tố Mầm tóc (sắc tố quy định màu tóc), làm chậm quá trình bạc tóc\u003c/p\u003e\n\u003cp\u003e=\u0026gt;Giảm các triệu chứng ngứa da đầu và làm sạch gàu.\u003c/p\u003e\n\u003cp\u003e=\u0026gt; Đặc biệt, kết hợp 2 in 1 - chứa dưỡng chất giúp mềm mượt tóc, nuôi dưỡng từ chân đến ngọn tóc, phục hồi nang tóc hư tổn mà không phải dùng thêm dầu xả. Cảm nhận rõ rệt sau hơn một tháng sử dụng.\u003c/p\u003e\n\u003cp\u003e4. Cách dùng\u003cbr /\u003eBước 1: Làm ướt tóc bằng nước sạch (tốt nhất là nước ấm), nước ấm giúp nang tóc và các lớp biểu bì tóc mở to ra.\u003c/p\u003e\n\u003cp\u003eBước 2: Xịt dầu gội ra tay với một lượng vừa đủ (khoảng 5ml – 7ml). Sau đó thoa đều lên tóc, massage tóc nhẹ nhàng trong vài phút để dầu gội thấm sâu vào chân tóc và thân tóc.\u003cbr /\u003eBước 3: Xả sạch với nước\u003c/p\u003e\n\u003cp\u003e- Thương hiệu: cocayhoala vietnam \u003cbr /\u003e- Xuất xứ: Việt Nam\u003cbr /\u003e- Tình trạng: mới\u003cbr /\u003e- Trọng lượng: 300g\u003cbr /\u003e- Hạn sử dụng: 3 năm kể từ ngày sản xuất.\u003cbr /\u003e#daugoihathuo #hotrotrirungtocbactoc #hathuo #dầugộixả #rụngtóc #hỗtrợtrịrụngtóc #chamsocmaitoc\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/17/b7/cf/4858b2cd05a2394e6dd3941ae90f67c4.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/17/b7/cf/4858b2cd05a2394e6dd3941ae90f67c4.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/17/b7/cf/4858b2cd05a2394e6dd3941ae90f67c4.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/17/b7/cf/4858b2cd05a2394e6dd3941ae90f67c4.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/17/b7/cf/4858b2cd05a2394e6dd3941ae90f67c4.png"},{"base_url":"https://salt.tikicdn.com/ts/product/3a/0f/45/05eb8475044a62052ceb06ed3b75a18c.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/3a/0f/45/05eb8475044a62052ceb06ed3b75a18c.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/3a/0f/45/05eb8475044a62052ceb06ed3b75a18c.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/3a/0f/