ull},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.5,"review_count":110,"review_text":"(110)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/45/a0/99/4f9e0e6a1d857db68a8838646a01b00d.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1055,"all_time_quantity_sold":557,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: center;\"\u003e\u003cstrong\u003eDụng Cụ Lấy Ráy Tai, Bộ Ngoáy Tai 6 Chiếc KUNBE, Chất Liệu Inox Cao Cấp Giúp Vệ Sinh Tai An Toàn, Chuyên Nghiệp\u003cbr /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003e\u003cstrong\u003e\u003cbr /\u003e\u003c/strong\u003eRáy tai hay còn gọi là sáp tai, ở salon thường sử dụng bộ dụng cụ lấy ráy tai cho nhiều người vì thế thật sự không an toàn cho bạn. Bạn có thể bị lây nhiễm nấm hay virus từ người khác và không phải lúc nào bạn cũng có thể đi ra ngoài salon để lấy ráy tai. Hãy sắm ngay cho mình 1 bộ lấy ráy tai, ngoáy tai đa năng 6 chiếc bằng inox cao cấp, giúp việc lấy ráy tai chính xác và không gây đau tai. Sau khi sử dụng, bạn có thể cất giữ dễ dàng để sử dụng cho lần sau. \u003cbr /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/7a/a5/b8/57d3b287f82b0061c4c4f67789466ac0.jpg\" alt=\"\" width=\"654\" height=\"654\" /\u003e\u003cbr /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/80/6a/87/da4d59541eb83d560dd7ce1ebdecf6a7.jpg\" alt=\"\" width=\"655\" height=\"655\" /\u003e\u003cbr /\u003e\u003cstrong\u003eĐặc điểm sản phẩm\u003c/strong\u003e\u003c/p\u003e\n\u003cp data-spm-anchor-id=\"a2o4n.pdp_revamp.product_\"\u003eBộ sản phẩm inox 6 chi tiết lấy ráy tai ngoáy tai cao cấp: \u003cbr /\u003e- Chất liệu inox chống rỉ.\u003cbr /\u003e- Bộ sản phẩm với 6 chi tiết và phân loại giúp vệ sinh tai sạch sẽ, dễ dàng. \u003cbr /\u003e- Hộp đựng thiết kế nhỏ gọn bắt mắt, có thể treo vào chùm chìa khóa, dễ dàng mang theo sử dụng         mỗi khi cần. \u003cbr /\u003e- Thiết kế mẫu mã sang trọng.\u003cbr /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/24/34/c5/7d0d73a3a5b4d665febc15a83c85cfd4.jpg\" alt=\"\" width=\"750\" height=\"746\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/df/72/2a/983d4b8c65c8808d4270ab490530597c.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003cbr /\u003eVới thiết kế độc đáo và cải tiến, việc vệ sinh tai của bạn trở nên dễ dàng và nhẹ nhàng không gây đau rát, vệ sinh tai triệt để trong mọi ngõ ngách của vùng tai nơi mà các dụng cụ lấy ráy tai thông thường không thể xử lý. Sau khi vệ sinh tai xong bạn có thể làm sạch dụng cụ 1 cách dễ dàng bằng nước mà không sợ rỉ.\u003cbr /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/2d/52/ac/432fd0cc5cb5e740f6838d5525e2d49b.JPG\" alt=\"\" width=\"718\" height=\"343\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/c4/cf/db/8dddcc09b53d9206ee74384cf8b79bfe.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003cbr /\u003eBộ dụng cụ lấy ráy tai chuyên nghiệp 6 món được đựng trong hộp thiết kế nhỏ gọn, tiện lợi, kèm thêm hộp đựng nhỏ gọn bắt mắt thích hợp cho nam và nữ, dùng trong mọi gia đình và salon làm đẹp. Bạn cũng có thể mua tặng sản phẩm như 1 món quà để tặng cho những người yêu thương và trong gia đình của mình\u003cbr /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/87/35/31/1a07963a2313e57f97d9abc7cf079b35.JPG\" alt=\"\" width=\"722\" height=\"360\" /\u003e\u003cbr /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/0e/6c/d0/0f6fdd942fab81f5d63796ef114d14bf.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003cbr /\u003eDo ánh sáng và cài đặt màn hình khác nhau, màu của sản phẩm có thể hơi khác so với hình ảnh.\u003c/p\u003e\n\u003cp data-spm-anchor-id=\"a2o4n.pdp_revamp.product_\"\u003eXin vui lòng cho phép sai số kích thước của sản phẩm khác nhau do đo lường thủ công\u003c/p\u003e\n\u003cp data-spm-anchor-id=\"a2o4n.pdp_revamp.product_\"\u003e\u003cbr /\u003e#dungculayraytai #dungculayraytaichotre #dungculayraytaicocamera #dungculayraytaicoden #dungculayraytaithongminh #dungculayraytaichuyennghiep #dungculaydaitai #lay_ray_tai #Bo_lay_ray_tai #dụng_cụ_lấy_ráy_tai #Bộ_lấy_ráy_tai #dụng_cụ_lấy_ráy_tai_chuyên_nghiệp\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/45/a0/99/4f9e0e6a1d857db68a8838646a01b00d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/45/a0/99/4f9e0e6a1d857db68a8838646a01b00d.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/45/a0/99/4f9e0e6a1d857db68a8838646a01b00d.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/45/a0/99/4f9e0e6a1d857db68a8838646a01b00d.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/45/a0/99/4f9e0e6a1d857db68a8838646a01b00d.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/68/85/af/473d0579d6f5f40408390dfa8688c326.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/68/85/af/473d0579d6f5f40408390dfa8688c326.jpg","medium_url