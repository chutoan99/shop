à có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/60/9d/69/34c23194a68eb0f8e4de7ed21f031193.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/60/9d/69/34c23194a68eb0f8e4de7ed21f031193.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/60/9d/69/34c23194a68eb0f8e4de7ed21f031193.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/60/9d/69/34c23194a68eb0f8e4de7ed21f031193.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/60/9d/69/34c23194a68eb0f8e4de7ed21f031193.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/64/2a/ec/3ab056adc4c4990b5e6b4e864340a3e1.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/64/2a/ec/3ab056adc4c4990b5e6b4e864340a3e1.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/64/2a/ec/3ab056adc4c4990b5e6b4e864340a3e1.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/64/2a/ec/3ab056adc4c4990b5e6b4e864340a3e1.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/64/2a/ec/3ab056adc4c4990b5e6b4e864340a3e1.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/ed/3d/0f/9181b62530261438d357e52d684a8683.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ed/3d/0f/9181b62530261438d357e52d684a8683.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ed/3d/0f/9181b62530261438d357e52d684a8683.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ed/3d/0f/9181b62530261438d357e52d684a8683.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ed/3d/0f/9181b62530261438d357e52d684a8683.jpg"}],"warranty_policy":null,"brand":{"id":165313,"name":"Bá