ount":395000,"discount_rate":50,"rating_average":4,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ff/46/c4/36537041e89db1d05fd0705885513f82.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":719,"all_time_quantity_sold":3,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cbr /\u003e️ PIN SẠC DỰ PHÒNG AUKEY PB-N83S 10,000MAH – DUNG LƯỢNG LỚN, SẠC NHANH 22.5W\u003cbr /\u003eAukey là một thương hiệu nổi tiếng với các loại pin sạc dự phòng chất lượng. Nếu bạn đang tìm kiếm một chiếc pin sạc dự phòng để phục vụ cho cuộc sống hàng ngày, sản phẩm pin sạc dự phòng Aukey PB-N83S 10,000mAh 22.5W Type-C (12V-1.5A) sẽ là sự lựa chọn tuyệt vời đáng để trải nghiệm.\u003c/p\u003e\n\u003cp\u003e️ Nổi bật hơn ở khả năng tích hợp tất cả các công nghệ sạc nhanh (PPS, FCP, SCP).\u003c/p\u003e\n\u003cp\u003e️ THIẾT KẾ NHỎ GỌN, TIỆN MANG THEO, CHẤT LIỆU CAO CẤP\u003cbr /\u003eChiếc pin sạc dự phòng Aukey PB-N83S được hãng thiết kế nguyên khối với kích thước nhỏ vừa phải. Nhờ đó, bạn có thể mang theo pin sạc đồng hành trong mọi chuyến đi xa vì sự nhỏ gọn, không chiếm nhiều diện tích.\u003c/p\u003e\n\u003cp\u003e️ Để sản phẩm hoạt động bền bỉ và hiệu quả hơn, hãng Aukey đã sử dụng chất liệu cao cấp để sản xuất pin sạc dự phòng. Lõi pin chất lượng vừa giúp sạc nhanh các thiết bị vừa đảm bảo an toàn trong quá trình sử dụng.\u003cbr /\u003eDUNG LƯỢNG LỚN 10,000MAH, SẠC NHANH CÁC THIẾT BỊ\u003cbr /\u003ePin sạc dự phòng Aukey PB-N83S sở hữu dung lượng lớn 10,000mAh cho phép bạn có thể sạc được thiết bị được nhiều lần. Khi mang theo pin sạc bên cạnh, bạn sẽ không phải lo về tình trạng điện thoại đột ngột hết pin.\u003c/p\u003e\n\u003cp\u003e️ Ngoài ra, pin sạc Aukey PB-N83S còn được trang bị cổng sạc Type-C cùng chế độ sạc nhanh hiệu quả, giúp tiết kiệm thời gian chờ đợi mỗi lần sạc. Bên cạnh đó, pin sạc còn có khả năng tương thích được với nhiều thiết bị.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cbr /\u003eThông số kỹ thuật:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eCapacity: 10000mAh / 37Wh\u003c/li\u003e\n\u003cli\u003eUSB-C In: 5V 3A 9V 2A\u003c/li\u003e\n\u003cli\u003eUSB-C Out (20W PD): 5V 2.4A / 9V 2.22A / 12V 1.67A\u003c/li\u003e\n\u003cli\u003eUSB-A Out: (QC 3.0)5V 2.4A / 9V 2A / 12V 1.5A; (SCP) 4.5V 5A / 5V 4.5A\u003c/li\u003e\n\u003cli\u003eMax Power Output: 22.5W\u003c/li\u003e\n\u003cli\u003eDimensions: 27.0 x 57.7 x 80.5mm / 1.06'' x 2.27'' x 3.17''\u003c/li\u003e\n\u003cli\u003eWeight: 174g / 6.14oz\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ff/46/c4/36537041e89db1d05fd0705885513f82.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ff/46/c4/36537041e89db1d05fd0705885513f82.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ff/46/c4/36537041e89db1d05fd0705885513f82.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ff/46/c4/36537041e89db1d05fd0705885513f82.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ff/46/c4/36537041e89db1d05fd0705885513f82.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/64/df/66/b9d86c364d9d7c0e4c073dc8332ee6c3.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/64/df/66/b9d86c364d9d7c0e4c073dc833