icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/98/ae/3f/1fed94a86ad3f89722b44609817ac67b.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":92,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cdiv class=\"boxInfo\"\u003e\n\u003cdiv class=\"tongQuan gStyle3 menuViewHightLight\"\u003e\n\u003cdiv class=\"description\"\u003e\n\u003cp\u003e\u003cem\u003eQuạt trần\u003c/em\u003e \u003cem\u003eSunhouse 3 cánh SHD7657 sở hữu đường kính sải cánh ấn tượng 140cm mang đế\u003c/em\u003e\u003cem\u003en lưu lượng gió lớn, làm mát diện rộng\u003c/em\u003e\u003cem\u003e, tỏa khắp không gian. Trang bị động cơ đồng nguyên chất, SHD7657 hoạt động bền bỉ và đặc biệt êm ái, không gây ồn.\u003c/em\u003e\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"thietKe gStyle3 menuViewHightLight\"\u003e\n\u003cdiv class=\"description\"\u003e\n\u003ch2\u003e\u003cstrong\u003eGió mạnh máy bền, làm mát diện rộng\u003c/strong\u003e\u003c/h2\u003e\nQuạt trần Sunhouse 3 cánh SHD7657 có công suất làm mát lên đến 75W, cho ra tốc độ gió mạnh mẽ lan tỏa rộng khắp không gian, giúp bạn và gia đình tận hưởng không gian sống mát mẻ và sảng khoái tức thì với quạt.\u003cbr /\u003e\u003cbr /\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/ea/32/3b/44ec59a6dc612921f1be8470d148ffd5.jpg\" alt=\"Artboard%201(28).jpg\" /\u003e\n\u003ch2\u003e\u003cstrong\u003eLưu lượng gió mạnh, mát lạnh tức thì\u003c/strong\u003e\u003c/h2\u003e\nQuạt trần SUNHOUSE SHD7657 trang bị 3 cánh quạt với đường kính sải cánh lên đến 140cm, tăng cường, rộng phạm vi làm mát và rút ngắn thời gian làm mát hiệu quả. Không chỉ vậy với lưu lượng gió 230 m³/phút, SHD7657 thuộc nhóm quạt có lưu lượng gió cao trên thị trường. Điều này giúp làm mát lạnh không gian tức thì, không khí cũng được thông thoáng và thoái mái trong ngày hè oi bức.\u003cbr /\u003e\u003cbr /\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/6c/48/20/1b55580b903e68174f4197776025233a.jpg\" alt=\"Artboard%202(30).jpg\" /\u003e\n\u003ch2\u003e\u003cstrong\u003eĐộng cơ đồng nguyên chất bền bỉ\u003c/strong\u003e\u003c/h2\u003e\nĐộng cơ đồng là yếu tố quan trọng giúp quạt trần SUNHOUSE 3 cánh SHD7657 vận hành hiệu quả và bền bỉ hơn. Ưu điểm của động cơ đồng là hiệu suất hoạt động cao, tạo ra lực mạnh hơn, giúp lưu lượng gió được tăng cường và phân phối một cách đồng đều. Hiệu suất chuyển đổi năng lượng tốt cũng giúp tiết kiệm điện năng, và hơn hết, việc tản nhiệt hiệu quả của động cơ cũng giúp kéo dài tuổi thọ của sản phẩm.\u003cbr /\u003e\u003cbr /\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/bd/c7/b6/22f2dc9bc9058ebe51241b09845ff37a.jpg\" alt=\"\" /\u003e\n\u003ch2\u003e\u003cstrong\u003eVận hành êm ái, không gây ồn\u003c/strong\u003e\u003c/h2\u003e\nBên trong động cơ quạt là trục quay ổ bi giảm ma sát đáng kể, từ đó giảm tiếng ồn, luôn duy trì ở mức ổn định dưới 65dB khi quạt động, dù ở chế độ gió mạnh nhất. Bạn có thể tận hưởng không gian thư giãn và làm việc mà không sợ bị quấy rầy bởi tiếng ồn khó chịu.\u003cbr /\u003e\u003cbr /\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/c9/49/9f/61f118ae297b3f35236839353ea3ec9c.jpg\" alt=\"Artboard%204(26).jpg\" /\u003e\n\u003ch2\u003e\u003cstrong\u003e5 Tốc độ gió cho mọi nhu cầu làm mát\u003c/strong\u003e\u003c/h2\u003e\nVới 5 tốc độ gió khác nhau, Quạt Trần Sunhouse SHD7657 sẽ đáp ứng được mọi nhu cầu làm mát của bạn. Dù bạn muốn không gian mát mẻ nhẹ nhàng hay là sự gió lớn mạnh, sản phẩm này đều đáp ứng được.\u003cbr /\u003e\u003cbr /\u003e\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/30/8f/84/de790e3b44a26eed703d302f5345f39e.jpg\" alt=\"Artboard%205(15).jpg\" /\u003e\n\u003ch2\u003e\u003cstrong\u003eThông số kỹ thuật\u003c/strong\u003e\u003c/h2\u003e\n\u003cimg src=\"https://salt.tikicdn.com/cache/w750/ts/product/ba/7f/f2/4e0772c69ac801a32cf7003c2ab5de36.jpg\" alt=\"Artboard%206(8).jpg\" /\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"danhGiaSanPham menuViewHightLight\"\u003e\n\u003cdiv class=\"title\"\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/e5/37/85/812ff52e391ee8436b96367783a0d1eb.png\" alt=\"\" width=\"345\" height=\"501\" /\u003e\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/98/ae/3f/1fed94a86ad3f89722b44609817ac67b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/98/ae/3f/1fed94a86ad3f89722b44609817ac67b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/98/ae/3f/1fed94a86ad3f89722b44609817ac67b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/98/ae/3f/1fed94a86ad3f89722b44609817ac67b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/98/ae/3f/1fed94a86ad3f89722b44609817ac67b.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/ea/32/3b/873c5cd31a7834b392e7409f39d95c2d.jpg","is_gallery":true,"label":null,"larg