unt":54,"review_text":"(54)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/90/43/37/8092c05d4f378ad2ce00f54059315c6d.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1408,"all_time_quantity_sold":213,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"Số lượng quà tặng sẽ thay đổi tùy theo chương trình\nBao bì thay đổi theo từng đợt nhập hàng\nHạn sử dụng 3 năm kể từ ngày sản xuất in trên bao bì\nNước Giặt Ariel Đậm Đặc Sạch Nhanh Túi 3.6kg là bột giặt dạng gel đậm đặc giúp loại sạch vết bẩn tốt hơn gấp 2X chỉ trong 1 bước giặt. Sản phẩm thế hệ mới được áp dụng công nghệ cao với khả năng loại sạch vết bẩn vượt trội, chứa nhiều thành phần làm sạch hiệu quả giúp loại bỏ được nhiều vết bẩn cứng đầu như vết bẩn dầu mỡ, vết cà phê. Sản phẩm dạng gel đậm đặc cho khả năng giặt tẩy vượt trội, giúp đánh bật mọi vết bẩn tốt hơn gấp 2 lần chỉ trong 1 bước giặt, quần áo sẽ được trắng sáng, không để lại chất cặn và lưu lại hương thơm tươi mát. Là sản phẩm phù hợp cả giặt tay và giặt bằng máy, nước giặt Ariel đậm đặc sẽ giúp cho việc giặt giũ của bạn trở nên nhẹ nhàng và hiệu quả hơn, giúp các bà nội trợ tiết kiệm được thời gian và công sức của mình. An toàn cho làn da của người sử dụng nếu giặt bằng tay. Hướng dẫn sử dụng : Giặt tay: 15ml cho 5 - 7 chiếc quần áo Giặt máy: 45ml cho 1 lần giặt thông thường (15 - 20 chiếc quần áo) Bao bì thay đổi tùy theo đợt nhập hàng\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/90/43/37/8092c05d4f378ad2ce00f54059315c6d.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/90/43/37/8092c05d4f378ad2ce00f54059315c6d.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/90/43/37/8092c05d4f378ad2ce00f54059315c6d.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/90/43/37/8092c05d4f378ad2ce00f54059315c6d.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/90/43/37/8092c05d4f378ad2ce00f54059315c6d.png"},{"base_url":"https://salt.tikicdn.com/ts/product/16/24/09/b81bf51bc60e47cd15722d20ecb48b18.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/16/24/09/b81bf51bc60e47cd15722d20ecb48b18.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/16/24/09/b81bf51bc60e47cd15722d20ecb48b18.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/16/24/09/b81bf51bc60e47cd15722d20ecb48b18.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/16/24/09/b81bf51bc60e47cd15722d20ecb48b18.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/2c/9d/5b/343d3ca778b71e7b00edd68ac429ddab.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/2c/9d/5b/343d3ca778b71e7b00edd68ac429ddab.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/2c/9d/5b/343d3ca778b71e7b00edd68ac429ddab.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2c/9d/5b/343d3ca778b71e7b00edd68ac429ddab.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2c/9d/5b/343d3ca778b71e7b00edd68ac429ddab.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/d6/ee/9c/604d033456b75c1c3b6873e7b22aba8a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d6/ee/9c/604d033456b75c1c3b