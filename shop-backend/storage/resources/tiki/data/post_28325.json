d751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":13000,"discount_rate":19,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ce/ac/b5/540d9793c2b8ea861831bf7715a7bd06.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":98,"all_time_quantity_sold":50,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp class=\"QN2lPu\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/ce/ac/b5/81069eb9c09798a0f99dd63857dcb7c4.jpg\" alt=\"\" width=\"720\" height=\"720\" /\u003eTên sản phẩm : Viên diệt gián Nhật Bản hộp 12 viên – Diệt sạch gián, khử mùi hôi \u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eXuất xứ : Nhật Bản\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eThuốc diệt gián của Nhật là sản phẩm diệt gián tận gốc với cơ chế tỏa hương thơm dễ chịu, thu hút gián tới ăn, ngấm dần làm cho gián chết và lây bệnh cho cả tổ. Đặc biệt, thuốc diệt gián Nhật không có mùi độc hại, không gây hại cho trẻ em khi cầm vào.\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e \u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eTác dụng của thuốc diệt gián Nhật\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e- Phát huy hiệu quả nhanh chòng nhờ hợp chất Fipronil\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e- Diệt gián tận gốc ngay cả với những loại gián đã kháng thuốc thông thường\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e- Những con gián ăn phải phân hoặc xác của những con gián đã ăn phải thuốc đều sẽ bị tiêu diệt\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e- Thiết kế nhỏ gọn, hộp đựng thông minh, dễ dàng đặt vào mọi ngóc ngách\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e- Tỏa mùi hương dễ chịu thu hút gián lại gần ăn thức ăn chứa trong viên nhựa đen\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e- An toàn nếu bé cầm phải\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/70/87/48/4fc0b4efe7817938d049be43f847f903.jpg\" alt=\"\" width=\"720\" height=\"720\" /\u003e\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eCách sử dụng thuốc diệt gián của Nhật\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eBước 1: Tách rời từng viên thuốc diệt gián bằng cách bóc lớp gói thiếc bọc sản phẩm\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eBước 2: Đặt viên thuốc tại các nới gián thường hay qua lại như gầm bếp, tủ quần áo, máy giặt với mật độ 2 viên/ 5m²\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eTùy vào gián nhiều hay ít mà thuốc trong hộp đen hết nhanh hay chậm, trung bình khoảng 3 tháng hết thuốc bạn hãy thay thuốc mới\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eDuy trì sử dụng thuốc diệt gián 6 tháng 1 lần để đạt hiệu quả tốt nhất\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/27/dd/2c/fe5abe94b264f6ca787ba08d5907f2b2.jpg\" alt=\"\" width=\"750\" height=\"521\" /\u003e\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eHướng dẫn bảo quản thuốc diệt gián của Nhật\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eCần bảo quản thuốc diệt gián Nhật Bản nơi khô ráo, thoáng mát, tránh ánh nắng mặt trời\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eVới những viên thuốc diệt gián đã được để trong túi nilong bọc kín để tránh mất tác dụng\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eXuất xứ: Nhật Bản\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e\u003cstrong\u003e“Bao bì sản phẩm giao ngẫu nhiên tùy đợt nhập hàng”\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ce/ac/b5/540d9793c2b8ea861831bf7715a7bd06.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ce/ac/b5/540d9793c2b8ea861831bf7715a7bd06.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ce/ac/b5/540d9793c2b8ea861831bf7715a7bd06.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ce/ac/b5/540d9793c2b8ea861831bf7715a7bd06.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ce/ac/b5/540d9793c2b8ea861831bf7715a7bd06.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/52/6d/7a/9a4d375eb084cda3b0cb8b404c065ff4.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/52/6d/7a/9a4d375eb084cda3b0cb8b404c065ff4.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/52/6d/7a/9a4d375eb084cda3b0cb8b404c065ff4.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/52/6d/7a/9a4d375eb084cda3b0cb8b404c065ff4.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/52/6d/7a/9a4d375eb084cda3b0cb8b404c065ff4.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/70/87/48/96af22d557548cb7a64f497669fd6da8.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/70/87/