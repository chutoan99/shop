:null,"text":"9.9"},{"placement":"pdp_badge","code":"is_hero","type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":true,"return_reason":"any_reason"}},"discount":1033000,"discount_rate":45,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ef/8f/b0/4be53f33cbfa4cf79c4052c4a2699958.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":300,"all_time_quantity_sold":4,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"Giày sneaker unisex Fila Funky Tennis 1998 X Smiley - 1TM02006F-150\n\u003cbr /\u003eĐặc điểm nổi bật: GIÀY THỜI TRANG UNISEX FILA FUNKY TENNIS 1998 X SMILEY\n\u003cbr /\u003eBỘ SƯU TẬP TENNIS CLUB X SMILEYSẵn sàng để \"giao bóng\" với niềm vui vô tận cùng bộ sưu tập mới nhất của Fila - Tennis Club X Smiley! FILA đang hành động với mục tiêu truyền tải tinh thần của bộ môn tennis, cùng sự lạc quan và niềm vui thuần khiết đến với cộng đồng Đông Nam Á. Hãy tưởng tượng một kết hợp tinh tế giữa thời trang thể thao và một phong cách vui nhộn, làm mới biểu tượng quả bóng Tennis kinh điển bằng biểu tượng Smiley vui vẻ. Bộ sưu tập kỷ niệm những phong cách thời trang đương đại cùng sự pha trộn tuyệt vời giữa tinh thần thể thao. Hãy để sân tennis trở thành sàn diễn thời trang của bạn, và bộ sưu tập \"Tennis Club X Smiley\" là tuyên ngôn về phong cách của bạn!\n\u003cbr /\u003eKhám phá không gian thời trang độc đáo với Giày Thời Trang Unisex Fila Tennis 1998 X Smiley. Thiết kế funky và vui nhộn kết hợp với chất liệu đa dạng và đế Phylon độc đáo, tạo ra một đôi giày không chỉ là sản phẩm, mà còn là tác phẩm nghệ thuật biểu tượng của sự sáng tạo và niềm vui.\n\u003cbr /\u003eTHÔNG SỐ\n\u003cp\u003eLấy cảm hứng từ giày quần vợt, phù hợp để mang hàng ngày như phong cách thời trang đường phố cổ điển từ những năm 1980 và 1990\u003cbr /\u003eThân trên được làm bằng sự kết hợp của da và vật liệu tổng hợp.\u003cbr /\u003eĐế được đệm dày, trọng lượng nhẹ và có khả năng chống nước.\u003cbr /\u003eNổi bật với logo Smiley và logo F-box ở phần thân đế.\u003cbr /\u003eSự hợp tác giữa Fila Tennis Club x Smiley tượng trưng cho niềm vui khi chơi quần vợt. Đây là môn thể thao không chỉ dành cho vận động viên trên sân thi đấu mà còn phù hợp cho hoạt động giải trí hằng ngày.\u003cbr /\u003eMã sản phẩm: 1TM02006F-150\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003eNơi sản xuất: Hàng sản xuất ở nước thứ 3 tùy từng lô hàng (Việt Nam, Trung Quốc, Ấn Độ, C)\u003c/p\u003e\n\u003cp\u003eHướng dẫn bảo quản:\u003cbr /\u003e• Hạn chế không nên để sản phẩm tiếp xúc nhiều với chất bẩn, đặc biệt là các chất bẩn cứng đầu như máu, cà phê, nhựa trái cây…\u003cbr /\u003e• Bảo quản sản phẩm ở nơi khô ráo, thoáng mát… để tránh các loại nấm mốc. (Nếu không sử dụng thường xuyên thì nên bỏ vào bao ni lông bịt kín hoặc hộp đựng.)\u003cbr /\u003e• Nên sử dụng khuôn hoặc nhét giấy báo cũ vào bên trong để luôn giữ được hình dạng ban đầu (đối với sản phẩm giày dép)\u003cbr /\u003e• Không nên phơi sản phẩm dưới nắng quá gắt. \u003c/p\u003e\n\u003cp\u003eChính sách đổi trả: Áp dụng theo chính sách của sàn\u003c/p\u003e\n\u003cp\u003eChính sách bảo hành: Không bảo hành\u003c/p\u003e\n\u003cp\u003eXuất xứ thương hiệu: Ý\u003c/p\u003e\n\u003cp\u003eThông Tin Thương Hiệu:\u003cbr /\u003eĐược ra mắt lần đầu tiên năm 1911, FILA được thành lập bởi 2 anh em nhà Fila với ý tưởng và mục đích ban đầu nhằm tạo ra những sản phẩm kết hợp giữa những khối sang trọng với tính nghệ thuật trong đó.\u003cbr /\u003eNăm 1923, khi chính thức trở thành một công ty dệt may chuyên sản xuất những mặt hàng thể thao với chất lượng cao chuyên về dệt kim thì Fila càng được nhiều người biết đến hơn. Trải qua nhiều năm phát triển sau đó, thương hiệu FILA đã vươn xa ra khỏi biên giới của Biella để trở thành một nhà sản xuất hàng dệt kim nổi tiếng của cả nước Ý lúc bấy giờ. Sau khoảng 100 năm lịch sử hình thành và phát triển thì giờ đây thương hiệu FILA đã trở thành một trong những thương hiệu chuyên về các sản phẩm thể thao hàng đầu trên toàn thế giới.\u003cbr /\u003eĐến năm 2003, thương hiệu FILA được Fila Sport Korea mua lại và phát triển. Khi nhìn vào thương hiệu Fila chúng ta dễ dàng nhận ra được ở đó là sự trang nhã về phong cách thiết kế với kiểu dáng trẻ trung, năng động được chăm chút từng chi tiết nhỏ nhất với tiêu chuẩn quốc tế. Qua đó tôn vinh lên vẻ đẹp hình thể cũng như là nét cá tính của người dùng,và hơn hết tạo được sự tự tin khi sử dụng thời trang FIla ( quần áo và giày dép).\u003cbr /\u003eThông Tin Nhà Phân Phối:\u003cbr /\u003eSupersports là hệ thống bán lẻ hàng đầu và chuyên phân phối các mặt hàng về thể thao tại Thái Lan và là hệ thống thuộc tập đoàn Central Retail. Supersports mang đến rất nhiều lựa chọn về giày dép và quần áo, máy tập thể dục và phụ kiện thể thao từ các thương hiệu nổi tiếng thế giới. Supersports tự hào mang đến sản phẩm chất lượng tốt và dịch vụ đặc biệt cho Việt Nam.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ef/8f/b0/4be53f33cbfa4cf79c4052c4a2699958.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ef/8f/b0/4be53f33cbfa4cf79c4052c4a2699958.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ef/8f/b0/4be53f33cbfa4cf79c4052c4a2699958.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ef/8f/b0/4be53f33cbfa4cf79c4052c4a2699958.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ef/8f/b0/4be53f33cbfa4cf79c4052c4a2699958.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/8e/36/f1/85a82168c6e5bd6a5ce5f357cf2320b4.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/8e/36/f1/85a82168c6e5bd6a5ce5f357cf2320b4.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/8e/36/f1/85a82168c6e5bd6a5ce5f357cf2320b4.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8e/36/f1/85a82168c6e5bd6a5ce5f357cf2320b4.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8e/36/f1/85a82168c6e5bd6a5ce5f357cf2320b4.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/4c/6f/5b/2690f8f9c3f3c489e25651ede24b941a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/4c/6f/5b/2690f8f9c3f3c489e25651ede24b941a.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/4c/6f/5b/2690f8f9c3f3c489e25651ede24b941a.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4c/6f/5b/2690f8f9c3f3c489e25651ede24b941a.jpg","thumbnail_url":"https://salt.tik