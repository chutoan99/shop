_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/05/a5/9d/319abc0b6e1cd5b9681e4679ad43ba94.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":688,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/76/a3/6c/e91d79c9f5eabe97ae91a0077fbec9a9.jpg\" alt=\"\" width=\"750\" height=\"562\" /\u003e\u003c/p\u003e\n\u003cp\u003eKhối lượng: 500gr\u003c/p\u003e\n\u003cp\u003eVới kinh nghiệm gần 40 năm hoạt động trong lĩnh vực chế biến cà phê, cà phê Huy Tùng được chế biến với công thức bí truyền, mang lại hương vị độc đáo, đậm đà và tự hào là sản phẩm đặc trưng của vùng đất Phú Yên. Sự kết hợp chọn lọc hoàn hảo giữa hai loại cà phê nổi tiếng của Cao nguyên Buôn Ma Thuột - Arabica và Robusta cùng những hương liệu cao cấp, Huy Tùng cho ra sản phẩm cà phê Hương Chồn truyền thống gợi nhớ đến sản phẩm cà phê Chồn Kopi Luwak danh tiếng.\u003c/p\u003e\n\u003cp\u003eNhững hạt cà phê thơm ngon tới tay người tiêu dùng đều phải qua một quá trình chọn lựa nguyên liệu và chế biến kĩ càng. Hạt cà phê sau khi chọn lọc, phân loại sẽ được đưa vào lò rang trong khoảng 55 phút, với nhiệt độ khoảng 228 độ C. Sau đó cà phê được làm nguội rồi trộn tẩm bơ, nguyên liệu, cho vào bao ủ thùng trong 3 ngày. Sau đó, cà phê hạt được chuyển sang công đoạn xay và đóng bao thành phẩm.\u003c/p\u003e\n\u003cp\u003eMặc dù đầu tư công nghệ hiện đại nhưng công ty vẫn giữ một phần công đoạn làm tay truyền thống như rang kết hợp giữa điện và than củi để giữ được nhiệt độ đều, duy trì độ nóng phù hợp. Bên cạnh đó, trong quá trình rang, người rang cà phê bằng kinh nghiệm lâu năm có thể kiểm tra được độ chín của hạt cà phê để đảm bảo hạt cà phê đạt đúng độ chín cần thiết. Nhờ vậy, sản phẩm cà phê Huy Tùng luôn giữ được nét riêng, hương vị đậm đà. Khi uống cà phê có mùi đặc trưng, một chút vị khói, hương thơm đậm đà, thoang thoảng vị socola và một chút đắng dễ chịu.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/05/a5/9d/319abc0b6e1cd5b9681e4679ad43ba94.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/05/a5/9d/319abc0b6e1cd5b9681e4679ad43ba94.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/05/a5/9d/319abc0b6e1cd5b9681e4679ad43ba94.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/05/a5/9d/319abc0b6e1cd5b9681e4679ad43ba94.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/05/a5/9d/319abc0b6e1cd5b9681e4679ad43ba94.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/0a/9f/f3/354282c4887335ed0de3e345a984409b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0a/9f/f3/354282c4887335ed0de3e345a984409b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/0a/9f/f3/354282c4887335ed0de3e345a984409b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0a/9f/f3/354282c4887335ed0de3e345a984409b.j