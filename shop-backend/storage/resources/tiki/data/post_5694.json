 thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/35/42/29/a43d90008ef38b4844c49609ea1e9fb9.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/35/42/29/a43d90008ef38b4844c49609ea1e9fb9.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/35/42/29/a43d90008ef38b4844c49609ea1e9fb9.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/35/42/29/a43d90008ef38b4844c49609ea1e9fb9.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/35/42/29/a43d90008ef38b4844c49609ea1e9fb9.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/90/36/d0/a342bf953536921efa318b0e878825f3.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/90/36/d0/a342bf953536921efa318b0e878825f3.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/90/36/d0/a342bf953536921efa318b0e878825f3.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/90/36/d0/a342bf953536921efa318b0e878825f3.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/90/36/d0/a342bf953536921efa318b0e878825f3.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/43/f0/aa/0cf44854b92ed2441d1a351dd21d7620.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/43/f0/aa/0cf44854b92ed2441d1a351dd21d7620.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/43/f0/aa/0cf44854b92ed2441d1a351dd21d7620.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/43/f0/aa/0cf44854b92ed2441d1a351dd21d7620.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/43/f0/aa