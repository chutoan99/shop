4800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":10000,"discount_rate":7,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ae/92/a3/540a4f04ba94d8f9190f369ab1b1e4e7.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":286,"all_time_quantity_sold":5,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eDép Eva Phun Bé Gái Biti's BEG001800 hiện đang là một trong những sản phẩm siêu hot của nhà Biti’s dành cho các bé gái. Hiện nay sản phẩm đang được các ông bố bà mẹ săn lùng bởi mẫu mã đẹp, chất lượng tốt và an toàn cho trẻ nhỏ, hãy cùng tìm hiểu sản phẩm này ngay dưới đây nhé.\u003c/p\u003e\n\u003ch2\u003eĐế Dép Eva Phun Bé Gái Biti's BEG001800\u003c/h2\u003e\n\u003cp\u003eSản phẩm dép dành cho các bé gái vô cùng dễ thương này có đế được chế tác từ Eva Phun cao cấp, khi vận động rất khó bị mất form, hạn chế bám bụi bẩn nên dễ dàng vệ sinh. Ngoài ra đế dép còn vô cùng êm ái giúp các bé có thể tha hồ di chuyển, chạy nhảy mà không bị đau châ Đế dép có thiết kế thêm rãnh chống trơn trượt, an toàn cho bé khi đi trên những địa hình khó khăn.\u003c/p\u003e\n\u003ch2\u003eQuai dép\u003c/h2\u003e\n\u003cp\u003eHiện nay với thiết kế Dép Eva Phun Bé Gái Biti's BEG001800, sản phẩm được dập liền quay và nguyên khối vô cùng chắc chắn. Thoải mái cho bé khi xỏ và bé có thể tự túc xỏ không cần sự trợ giúp của bố mẹ. Họa tiết của dép cũng được thiết kế đơn giản và dễ thương, quai dép không hề gây hầm nóng mà rất thông thoáng, nhẹ nhàng cho đôi bàn chân của bé.\u003c/p\u003e\n\u003ch2\u003eMàu sắc\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003eHiện nay, sản phẩm Dép Eva Phun Bé Gái Biti's BEG001800 hiện tại được bày bán với ba màu sắc vô cùng xinh xắn là màu hồng, màu kem và màu vàng. Cha mẹ hãy cùng bé chọn màu dép ưng ý nhất.\u003c/li\u003e\n\u003cli\u003eMàu sắc thực tế có thể chênh lệch 3 - 5 % tùy theo điều kiện ánh sáng.\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch2\u003eSize dép \u003c/h2\u003e\n\u003cp\u003eDép Eva Phun Bé Gái Biti's BEG001800 có các size từ size 30, size 31, size 32 size 33, size 34, size 35, size 36, size 37. Bố mẹ có thể đo bàn chân cho bé để chọn được đôi dép vừa vặn nhất.\u003c/p\u003e\n\u003ch2\u003eBảo hành\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003eSản phẩm Dép Eva Phun Bé Gái Biti's BEG001800 hiện nay được Biti’s áp dụng chính sách bảo hành trong vòng 3 tháng kể từ thời điểm mua hàng. \u003c/li\u003e\n\u003cli\u003eVới các lỗi do nhà sản xuất, bạn hoàn toàn có thể yên tâm bởi sản phẩm sẽ được bảo hành trọn đời phần này nhé. \u003c/li\u003e\n\u003cli\u003eĐổi trả sản phẩm trong vòng 7 ngày hay đổi sản phẩm lỗi trong vòng 7 ngày (kể từ thời điểm mua hàng và phù hợp với chính sách đổi trả được quy định). \u003c/li\u003e\n\u003c/ul\u003e\n\u003ch2\u003eTính năng và lợi ích nổi bật\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003eThiết kế dễ thương, màu sắc năng động, nữ tính. Họa tiết được trang trí thêm các sticker hoạt hình ngộ nghĩnh, đáng yêu đúng với lứa tuổi của các bé.\u003c/li\u003e\n\u003cli\u003eCó thể sử dụng cho bé lúc đi học, đi chơi, dùng trong cuộc sống thường ngày.\u003c/li\u003e\n\u003cli\u003eGiá thành phù hợp.\u003c/li\u003e\n\u003cli\u003eMàu sắc và kích cỡ đa dạng, dễ dàng đáp ứng sở thích của các bé.\u003c/li\u003e\n\u003cli\u003eChất liệu đế dép, quai dép được chọn lọc và xử lý cẩn thận.\u003c/li\u003e\n\u003cli\u003eChế độ bảo hành uy tín.\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch2\u003eSản phẩm bao gồm\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003eHộp giấy bìa cứng cáp.\u003c/li\u003e\n\u003cli\u003eDép\u003c/li\u003e\n\u003cli\u003eTúi chống ẩm.\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ae/92/a3/540a4f04ba94d8f9190f369ab1b1e4e7.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ae/92/a3/540a4f04ba94d8f9190f369ab1b1e4e7.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ae/92/a3/540a4f04ba94d8f9190f369ab1b1e4e7.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ae/92/a3/540a4f04ba94d8f9190f369ab1b1e4e7.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ae/92/a3/540a4f04ba94d8f9190f369ab1b1e4e7.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/53/64/08/a4840436dc7257925b5011a9dc8a583d.JPG","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/53/64/08/a4840436dc7257925b5011a9dc8a583d.JPG","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/53/64/08/a4840436dc7257925b5011a9dc8a583d.JPG","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/53/64/08/a4840436dc7257925b5011a9dc8a583d.JPG","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/53/64/08/a4840436dc7257925b5011a9dc8a583d.JPG"},{"base_url":"https://salt.tikicdn.com/ts/product/40/24/61/b43ce38aae80573767cb35bdde7911e1.JPG","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/40/24/61/b43ce38aae80573767cb35bdde7911e1.JPG","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/40/24/61/b43ce38aae80573767cb35bdde7911e1.JPG","position":null