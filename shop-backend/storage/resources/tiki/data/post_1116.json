93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/d8/2d/43/a93b8356d860880449f468aa80dbc1e3.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":134,"all_time_quantity_sold":3,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p>Quy cách đóng gói: Hộp 30 gói gạc đã được tẩm ẩm<br />THÔNG TIN SẢN PHẨM:<br />Gạc Rơ Lưỡi SACHI Chiết Xuất Lá Hẹ, Lô Hội, Cúc La Mã<br />Gạc rơ lưỡi Dr Papie Chiết Xuất Dịch chiết lá hẹ, Natribicarbonat,, Natriclorua, Xylitol<br /><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/d8/2d/43/0af29df606e2902004aa0879e63f2c36.png\" alt=\"202404100649430edd4f59da91702f7cd7bc7dee8613a0.png\" /><br /><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/08/7f/93/559891e3183a1f186f6915b19c5c608a.jpg\" alt=\"202404100650090c211fac41c95f41ef958d55fdc00a05.jpg\" /><br />———-<br />CÔNG DỤNG:<br />- Vệ sinh hàng ngày làm sạch lưỡi, nướu, răng, miệng cho từ sơ sinh trở lên<br />- Tăng cường cơ chế tự bảo vệ cho lưỡi, nướu, răng, miệng giúp phòng chống những bệnh về răng miệng ( nấm miệng, tưa lưỡi, viêm nướu,..) giúp nướu khỏe trong thời kỳ trẻ mọc răng, giúp chống sâu răng.<br />ĐỐI TƯỢNG SỬ DỤNG:<br />- Gạc rơ lưỡi dùng cho trẻ sơ sinh trở lên:<br />- Vệ sinh miệng hàng ngày cho trẻ sơ sinh và trẻ nhỏ<br />-Trẻ ăn sữa ngoài, trẻ đang ăn dặm, trẻ có nguy cơ bị nhiễm nấm cao do thường xuyên phải dùng khí dung hoặc thuoc giảm viêm chứa corticoid gây ức chế miễn dịch<br />- Trẻ đang trong thời kỳ chuẩn bị mọc răng và đã mọc răng<br />- Trẻ đã có răng nhưng chưa biết vệ sinh răng miệng và đánh răng hàng ngày<br />- Người lớn ốm không có khả năng vệ sinh răng miệng<br />HƯỚNG DẪN SỬ DỤNG:<br />- Hướng dẫn chung:<br />+ Sản phẩm chỉ sử dụng 1 lần<br />+ Rửa tay sạch bằng xà phòng trước khi sử dụng<br />+ Cho nhẹ nhàng ngón tay vào miệng gạc<br />+ Lau nhẹ nhàng lên nướu, lưỡi, răng và 2 phần bên má<br />+ Sử dụng ngay sau khi mở và không tái sử dụng lại<br />- Theo từng đối tượng<br />+ Đối vỡi những trẻ đang bị tưa lưỡi : lau nhẹ nhàng lên lưỡi bé, nên sử dụng 3 lần/ngày<br />+ Đối với trẻ đang mọc răng : khi trẻ đau nhức khi mọc răng, mẹ có thể đeo gạc và xoa nhẹ nơi nướu đang sung để giảm cảm giác khó chịu cho bé<br />+ Đối với trẻ đã mọc răng chưa biết đánh răng : nên vệ sinh đều đặn ngày 2 lần : buổi sang khi ngủ dậy và buổi tối trước khi đi ngủ<br />+ Vệ sinh miệng sau 30p mới nên cho bé ăn<br />+ Đối với người lớn ốm không có khả năng vệ sinh răng miệng : người chăm sóc đeo gạc và vệ sinh răng, lợi, miệng của người lớn. Có thể dùng nhiều miếng gạc cho mỗi lần vệ sinh<br />BẢO QUẢN:<br />- Để xa tầm tay trẻ em<br />- Bảo quản nơi khô ráo, thoáng mát dưới 30 độ C<br />- Đọc kỹ hướng dẫn sử dụng trước khi dùng</p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/d8/2d/43/a93b8356d860880449f468aa80dbc1e3.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d8/2d/43/a93b8356d860880449f468aa80dbc1e3.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d8/2d/43/a93b8356d860880449f468aa80dbc1