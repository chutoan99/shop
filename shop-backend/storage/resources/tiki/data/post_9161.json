pdp_badge","code":"is_hero","type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":true,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/2b/1a/4a/81d676ec8aad92b0b2ae9bf05d13c23e.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":918,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch5\u003eNgắm nhìn thế giới với một tỷ sắc màu - Công nghệ Quantum Dot hiển thị 100% dải màu\u003c/h5\u003e\n\u003cp\u003eCông nghệ Quantum Dot hiển thị 100% dải màu với độ chân thực sống động và rõ nét, cho bạn thưởng thức từng khung hình mang màu sắc cuộc sống, tuyệt đẹp ở mọi mức độ sáng.\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/35/c7/7c/2b514e47ab719c7e5bc7ef2e2a956b03.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/35/c7/7c/2b514e47ab719c7e5bc7ef2e2a956b03.jpg\" alt=\"\" width=\"750\" height=\"383\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg id=\"https://salt.tikicdn.com/ts/tmp/16/c1/fa/cc04408b955c340523f7599486e244d2.jpg\" title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/16/c1/fa/cc04408b955c340523f7599486e244d2.jpg\" alt=\"\" width=\"750\" height=\"441\" /\u003e\u003c/p\u003e\n\u003ch5\u003eTrải nghiệm điện ảnh hoàn hảo đến từng sắc thái với dải màu rộng lớn - Công nghệ Quantum HDR\u003c/h5\u003e\n\u003cp\u003eTrải nghiệm độ tương phản đỉnh cao cùng chi tiết chân thực nhờ công nghệ Quantum HDR. Vượt xa những tiêu chuẩn hàng đầu, công nghệ HDR10+ kiến tạo khung hình rực rỡ, tỏa sáng ấn tượng trong từng chi tiết với sắc đen sâu thẳm và sắc trắng thuần khiết.‎\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/57/9a/e4/57df9c6bae19306f34d5f34ad8744395.jpg\" alt=\"\" width=\"750\" height=\"414\" /\u003e\u003c/p\u003e\n\u003ch5\u003eTuyệt tác thiết kế thanh mảnh - Thiết kế AirSlim\u003c/h5\u003e\n\u003cp\u003eChiêm ngưỡng thiết kế TV với độ mỏng ấn tượng chưa từng có, dễ dàng kết hợp với mọi không gian tạo nên tổng thể liền mạch thu hút mọi ánh nhìn.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/9d/84/b1/f0e9ac9a5cd53eda41abc51b5ce5e9ff.jpg\" alt=\"\" width=\"750\" height=\"524\" /\u003e\u003c/p\u003e\n\u003ch5\u003eNâng cấp hình ảnh lên chuẩn 4K bằng AI - Bộ vi xử lý Quantum Lite 4K\u003c/h5\u003e\n\u003cp\u003eBộ vi xử lý mạnh mẽ Samsung giúp tối ưu hóa khả năng hiển thị hình ảnh, mang đến trải nghiệm xem chất lượng cao và hoàn hảo nhất. Không những vậy, công nghệ nâng cấp hình ảnh chuẩn 4K bằng AI tiên tiến cho bạn thỏa thích xem nội dung yêu thích với độ phân giải 4K ưu việt bất kể chất lượng đầu nguồn.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/7a/08/b7/8befcb446997633b07fe6aac2215d467.jpg\" alt=\"\" width=\"750\" height=\"312\" /\u003e\u003c/p\u003e\n\u003ch5\u003eCá nhân hóa kho ứng dụng giải trí - Smart Hub\u003c/h5\u003e\n\u003cp\u003eỨng dụng Smart Hub mới từ Samsung hiển thị nội dung yêu thích chuẩn xác trong mục Khám phá, giúp bạn không tốn nhiều thời gian để tìm kiếm và tận hưởng nhiều hơn khoảng thời gian xem phim cũng như nhiều chương trình khác.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/9a/e3/f1/26e82c94db24ddcf410ae85641fc7e8a.jpg\" alt=\"\" width=\"750\" height=\"442\" /\u003e\u003c/p\u003e\n\u003ch5\u003eBứt phá trải nghiệm chiến game - Tính năng Super Ultrawide GameView \u0026amp; Game Bar\u003c/h5\u003e\n\u003cp\u003eChiến thắng nhiều trận game gay cấn hơn bằng cách mở rộng khung hình đến tầm nhìn cực đại từ màn hình tỉ lệ 21:9 và 32:9. Menu Game Bar dễ dàng truy cập bằng một phím điều hướng cho phép bạn ngay lập tức điều chỉnh các thông số như tỉ lệ màn hình, kiểm tra độ trễ đầu vào, FPS, HDR, thiết lập của tai nghe không dây và hơn thế nữa.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/66/6e/89/0b3a9563849c19741306824eecf3be40.jpg\" alt=\"\" width=\"750\" height=\"299\" /\u003e\u003c/p\u003e\n\u003ch5\u003eChìm đắm trong âm thanh vòm theo chuyển động hình ảnh - Công nghệ Object Tracking Sound Lite (OTS Lite)\u003c/h5\u003e\n\u003cp\u003eĐắm chìm trong chất âm 3D đỉnh cao nhờ sự kết hợp giữa hình ảnh sống  động, chân thực và kênh âm thanh giả lập hàng đầu từ Samsung.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/07/0b/e5/348f58c72fca0c1002c798b886dd06be.jpg\" alt=\"\" width=\"750\" height=\"312\" /\u003e\u003c/p\u003e\n\u003ch5\u003eTối ưu tông màu đèn nền giúp tăng cường độ tương phản - Công nghệ đèn nền Dual LED\u003c/h5\u003e\n\u003cp\u003eĐắm chìm trong thế giới hình ảnh hoàn mỹ trên Smart TV 4K QLED mới. Công nghệ đèn nền cải tiến sở hữu khả năng tối ưu hóa tông màu đèn nền phù hợp với từng loại nội dung, cho phép hiển thị hình ảnh với độ tương phản rõ nét và chuẩn xác đến không ngờ.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/76/7a/6b/05c098c65fae0159cb987f8bb4d33286.jpg\" alt=\"\" width=\"750\" height=\"195\" /\u003e\u003c/p\u003e\n\u003ch5\u003eRõ khung hình, mượt chuyển động - Công nghệ Motion Xcelerator\u003c/h5\u003e\n\u003cp\u003eTrong các phân cảnh đua xe hoặc rượt đuổi, các khung hình thay đổi liên tục dễ dẫn đến hiện tượng \"bóng ma\" trên màn hình. Công nghệ Motion Xcelerator sẽ giúp bạn tận hưởng khung hình sắc nét và mượt mà hơn nhờ tính năng tự động bổ sung thêm khung hình vào nội dung gốc.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/11/93/96/6df3fb7c45125a10e7b1e3a8912af20a.jpg\" alt=\"\" width=\"750\" height=\"321\" /\u003e\u003c/p\u003e\n\u003ch5\u003eLinh hoạt cho mọi không gian - Chân đế điều chỉnh chiều cao\u003c/h5\u003e\n\u003cp\u003eVới chân đế tùy chỉnh, giờ đây bạn có thể sắp đặt TV với vị trí loa thanh hoặc sắp đặt TV phù hợp với không gian sống một cách dễ dàng.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/8a/36/b7/fb9dad48596467682a59423187424378.jpg\" alt=\"\" width=\"750\" height=\"338\" /\u003e\u003c/p\u003e\n\u003ch5\u003eBộ đôi hoàn hảo TV \u0026amp; Loa thanh - Công Nghệ Q-Symphony\u003c/h5\u003e\n\u003cp\u003eThăng hoa cùng những thanh âm tuyệt vời, được đồng bộ liền mạch giữa loa thanh Samsung và TV. Công nghệ Q-Symphony tận dụng loa TV và loa thanh, kiến tạo không gian giải trí đỉnh cao, bao trùm mọi giác quan.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/42/d6/bd/8f5d1aa1c66ef299a3ca02ca406acaec.jpg\" alt=\"\" width=\"750\" height=\"300\" /\u003e\u003c/p\u003e\n\u003ch5\u003eGọi Video Call trên màn hình cực đại - Ứng dụng gọi Video Google Duo\u003c/h5\u003e\n\u003cp\u003eKết nối điện thoại với TV hoặc sử dụng Samsung Slim Fit Cam để gọi điện cho người thân trên Google Dou. Mọi cuộc trò chuyện đều diễn ra chân thực như gặp mặt trực tiếp, xóa nhòa mọi khoảng cách địa lý.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/65/a0/4e/5760d29b5f262a30ab34408463a68a2b.jpg\" alt=\"\" width=\"750\" height=\"336\" /\u003e\u003c/p\u003e\n\u003ch5\u003eTối ưu âm thanh trong từng phân cảnh bằng AI - Công nghệ Adaptive Sound\u003c/h5\u003e\n\u003cp\u003eCông nghệ Adaptive Sound với khả năng nhận biết âm thanh theo từng phân cảnh giúp tối ưu chất lượng nghe dựa trên phân tích cảnh phim đang phát theo từng loại nội dung.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ef/83/78/f8917f617aeeec55b142ed499739c1cd.jpg\" alt=\"\" width=\"750\" height=\"302\" /\u003e\u003c/p\u003e\n\u003ch5\u003eDễ dàng điều khiển, thân thiện môi trường - Điều khiển Solar Cell Remote\u003c/h5\u003e\n\u003cp\u003eKhông còn lo ngại rác thải pin nhờ Solar Cell Remote thân thiện môi trường, mặt sau được trang bị tấm phim hấp thụ năng lượng ánh sáng trong nhà. Mi-cro tích hợp bên trong sở hữu chức năng Voice Assitant, giúp việc điều khiển thêm thuận tiện\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/d2/61/7d/08c6e6dc2e7e4ff296d1e8601c04c374.jpg\" alt=\"\" width=\"750\" height=\"296\" /\u003e\u003c/p\u003e\n\u003ch5\u003eĐa màn hình, đa trải nghiệm - Tính năng Multiview - Hiển thị đa màn hình\u003c/h5\u003e\n\u003cp\u003eKhông cần phải lo lắng bản thân sẽ lỡ mất những thông tin quan trọng trên điện thoại khi đang xem TV với tính năng Multi View. Bạn sẽ thỏa sức theo dõi video hướng dẫn game trong lúc vẫn nắm được tỷ số trận đấu yêu thích chỉ bằng cách kết nối TV và điện thoại để trải nghiệm đa màn hình, dễ dàng chưa từng có!\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/4d/30/ba/ebff6f4f752863775469a222e447d6b6.jpg\" alt=\"\" width=\"750\" height=\"312\" /\u003e\u003c/p\u003e\n\u003ch5\u003eChọn ngay trợ lý giọng nói của riêng bạn - Điều khiển giọng nói Tiếng Việt với trợ lý ảo Google (Google Assistant)\u003c/h5\u003e\n\u003cp\u003eLần đầu tiên, Samsung TV tích hợp cả 3 trợ lý giọng nói: Bixby, Amazon Alexa và Google Assistant. Cho bạn thoải mái lựa chọn trợ lý yêu thích, cung cấp trải nghiệm giải trí tối ưu và khả năng điều khiển liền mạch ngôi nhà thông minh của bạn.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/d3/c0/68/b9606e31e7040c3dae744059cf1177c6.jpg\" alt=\"\" width=\"750\" height=\"303\" /\u003e\u003c/p\u003e\n\u003ch5\u003e\"Quản gia\" lý tưởng cho ngôi nhà thông minh - SmartThings\u003c/h5\u003e\n\u003cp\u003eHãy thư giãn và để người quản gia thông minh của bạn lo liệu mọi thứ. SmartThings có thể kết nối liền mạch, giám sát và điều khiển tất cả các thiết bị thông minh trong nhà của bạn một cách trực quan. Bạn có thể điều khiển các thiết bị trực tiếp bằng remote hoặc giọng nói khi xem TV.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/a6/d6/e5/c6706418858fc190d21d6e4ea7617ac8.jpg\" alt=\"\" width=\"750\" height=\"300\" /\u003e\u003c/p\u003e\n\u003ch5\u003eLàm việc và học tập tại nhà - Từ máy tính đến TV\u003c/h5\u003e\n\u003cp\u003eTận hưởng tiện ích kết nối vượt trội từ Smart TV QLED 4K Q60B, dễ dàng truy cập vào máy tính, laptop và thiết bị di động ngay trên TV.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/5e/6c/75/7143f9ef639d260d3a69ae90723df9c8.jpg\" alt=\"\" width=\"750\" height=\"306\" /\u003e\u003c/p\u003e\n\u003ch5\u003eNhà là nơi rèn luyện sức khỏe - Samsung Health\u003c/h5\u003e\n\u003cp\u003eDễ dàng giữ dáng khi ở nhà với tính năng theo dõi dữ liệu của Samsung Health ngay trên màn hình. Bạn có thể kiểm tra số lượng bài tập đã hoàn thành, tổng thời gian tập luyện và lượng calo đã đốt cháy. Việc đồng bộ hóa dữ liệu từ một thiết bị tương thích hoặc thiết bị đeo cũng không còn là vấn đề.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/68/43/5e/50e99d3659308f4e170cde9983158c19.jpg\" alt=\"\" width=\"750\" height=\"299\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/2b/1a/4a/81d676ec8aad92b0b2ae9bf05d13c23e.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/2b/1a/4a/81d676ec8aad92b0b2ae9bf05d13c23e.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/2b/1a/4a/81d676ec8aad92b0b2ae9bf05d13c23e.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2b/1a/4a/81d676ec8aad92b0b2ae9bf05d13c23e.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2b/1a/4a/81d676ec8aad92b0b2ae9bf05d13c23e.png"},{"base_url":"https://salt.tikicdn.com/ts/product/5b/85/a8/8024548814ad883a386f5b20245dd197.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/5b/85/a8/8024548814ad883a386f5b20245dd197.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/5b/85/a8/8024548814ad883a386f5b20245dd197.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5b/85/a8/8024548814ad883a386f5b20245dd197.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5b/85/a8/8024548814ad883a386f5b20245dd197.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/1a/fa/64/062c1b49999e80430dba777050f11f32.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/1a/fa/64/062c1b49999e80430dba777050f11f32.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/1a/fa/64/062c1b49999e80430dba777050f11f32.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1a/fa/64/062c1b49999e80430dba777050f11f32.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/1a/fa/64/062c1b49999e80430dba777050f11f32.jpg"},{"base_u