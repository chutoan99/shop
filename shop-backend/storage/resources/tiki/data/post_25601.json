href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"defective_product"}},"discount":121000,"discount_rate":21,"rating_average":5,"review_count":3,"review_text":"(3)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/b6/cb/cd/8f72f554d36fa127fa6ffeb667112b77.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":440,"all_time_quantity_sold":4,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eNƯỚC HOA NAM BERGAMI SHOCKING MAN, NƯỚC HOA CHÍNH HÃNG DẠNG XỊT HƯƠNG THƠM MẠNH MẼ QUYẾN RŨ LƯU HƯƠNG 6 GIỜ - 50ML\u003c/p\u003e\n\u003cp\u003eNước hoa nam sử dụng công thức chuyển giao từ Châu Âu, kết hợp với nguyên liệu nhập khẩu hoàn toàn từ Pháp. Shocking Man được sản xuất tại Việt Nam theo công nghệ chế biến và chưng cất hiện đại.\u003c/p\u003e\n\u003cp\u003eChai nước hoa nam với thiết kế sang trọng, đẳng cấp với 3 tầng hương và có sự phân biệt rõ ràng. Hương đầu: Hương quýt, nghệ tây. Hương giữa: Mùi hoa nhài, hoa cam. Hương cuối: Hổ phách, linh sam, rêu.\u003c/p\u003e\n\u003cp\u003eHương thơm Shocking Man tươi sáng, dễ chịu, thanh lịch, mang lại cảm giác khoan khoái cho chàng. Lưu hương đến 12h.\u003c/p\u003e\n\u003cp\u003eMùi hương của nước hoa nam Shocking Man linh hoạt như sự mềm dẻo, linh hoạt của người mang mệnh Thủy. Vì vậy, nước hoa Shocking Man có thể đồng hành cùng bạn trong nhiều hoàn cảnh khác nhau dù là đi làm, đi chơi, gặp gỡ gia đình, bạn bè thân thiết hay đối tác làm ăn quan trọng.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://banhang.shopee.vn/api/v1/cdn_proxy/vn-11134207-7qukw-lil3wrfj5a18f4\" width=\"750\" height=\"750\" alt=\"vn-11134207-7qukw-lil3wrfj5a18f4\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://img.sp.mms.shopee.sg/sg-11134202-22110-6swyg1baozjv8e\" width=\"750\" height=\"750\" alt=\"sg-11134202-22110-6swyg1baozjv8e\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eNước hoa nam có công dụng Khử mùi cơ thể của nam giới và mang đến mùi hương nam tính, lịch lãm, quyến rũ. Shocking Man thể hiện được sự mạnh mẽ và một sự lôi cuốn mà không có chai nước hoa nào sánh được.\u003c/p\u003e\n\u003cp\u003eGiúp bạn trở nên thật hấp dẫn trong đôi mắt nàng. Nước hoa nam chính hãng Bergami Shocking Man 35ml là mùi nước hoa nam quyến rũ nhất của hãng với đầy sự đam mê, năng lượng, là hiện thân giữa di sản quý giá của nước Pháp và phong cách mạnh mẽ.\u003c/p\u003e\n\u003cp\u003eNước hoa nam Shocking Man giúp Rũ bỏ stress công việc và “hạ nhiệt” tâm trạng. Một mùi hương nam tính sảng khoái để bắt đầu, Shocking Man sẽ giúp phái mạnh thoát khỏi áp lực công việc và giải nhiệt trong ngày hè nóng bức.\u003c/p\u003e\n\u003cp\u003eTHÔNG TIN CHI TIẾT NƯỚC HOA NAM\u003c/p\u003e\n\u003cp\u003e- Xuất xứ: Việt Nam.\u003c/p\u003e\n\u003cp\u003e- Màu sắc: Xanh dương.\u003c/p\u003e\n\u003cp\u003e- Loại da phù hợp: Mọi loại da.\u003c/p\u003e\n\u003cp\u003e- Hướng dẫn sử dụng:\u003c/p\u003e\n\u003cp\u003e+ Vị trí xịt nước hoa: Bên trong cổ tay, phía sau tai, dưới cổ, bên trong khuỷu tay, phía sau đầu gối,... Hoặc xịt nước hoa ra phía trước rồi nhẹ nhàng bước qua màn sương mình sẽ sở hữu một mùi thơm nhẹ nhàng.\u003c/p\u003e\n\u003cp\u003e+ Không xịt quá nhiều.Chỉ xịt lên da, tuyệt đối không xịt lên áo quần hay trang sức vì nước hoa có thể khiến kim loại sỉn màu màu hoặc làm vải áo quần đổi màu, ố vàng.\u003c/p\u003e\n\u003cp\u003e- Hướng dẫn bảo quản nước hoa: Nơi thoáng mát, độ ẩm, nhiệt độ vừa phải. Tránh nơi nhiệt độ quá cao (ánh nắng) hoặc quá thấp (trong ngăn đá) vì như vậy sẽ gây phân tách các thành phần, gây nên phản ứng có hại cho da.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://img.sp.mms.shopee.sg/sg-11134202-22110-ty4db0abozjv8c\" width=\"750\" height=\"750\" alt=\"sg-11134202-22110-ty4db0abozjv8c\" /\u003e\u003c/p\u003e\n\u003cp\u003e_____________________________________\u003c/p\u003e\n\u003cp\u003eTHƯƠNG HIỆU NƯỚC HOA NAM BERGAMI\u003c/p\u003e\n\u003cp\u003eThương hiệu BERGAMI đã được đăng ký với Bộ Công Thương, tuân thủ đầy đủ các tiêu chuẩn an toàn và phù hợp với mọi loại da. Mọi thông tin về sản phẩm - xuất xứ - sản xuất đều rõ ràng, minh bạch.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e#nuochoa #nuochoanam #nuochoachinhhang #nuochoaluuhuonglau #nuochoachonam #nuochoafullsize #nuochoaunisex #nuochoathomlau #nuochoanammini #nuochoanamthomlau #nuochoaphap #nuochoanamcaocap #nuochoaedp #perfume #bergami #nuochoachinhhang #nuochoachonam #nuochoamini #nuochoanam #nuochoanamcaocap #nuochoanamchinhhang #nuochoanamthom #nuochoanamthomlau #nuochoathomlau\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/b6/cb/cd/8f72f554d36fa127fa6ffeb667112b77.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b6/cb/cd/8f72f554d36fa127fa6ffeb667112b77.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b6/cb/cd/8f72f554d36fa127fa6ffeb667112b77.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b6/cb/cd/8f72f554d36fa127fa6ffeb667112b77.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b6/cb/cd/8f72f554d36fa127fa6