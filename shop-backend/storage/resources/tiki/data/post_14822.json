ull,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":111000,"discount_rate":20,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/08/a6/23/cb0f52c3fe7aa5483f8a9e66323b6f1c.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":883,"all_time_quantity_sold":7,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cspan\u003eNaris Ailus Stress Free Face Powder áp dụng công nghệ siêu bền màu, giúp cho lớp nền bền màu trong cả một ngày dài. Có khả năng hút – kiềm dầu, che khuyết điểm trên cả những làn da khô, mụn. Tôn lên vẻ đẹp tự nhiên, rạng rỡ. \u003cbr /\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/e0/83/7c/d0a5fe5568e6c19f2d0db1d9f30fb0da.jpg\" alt=\"\" width=\"0\" height=\"0\" /\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/e0/83/7c/8907eecd89f24b12b89c1579dc63b54a.jpg\" alt=\"\" width=\"501\" height=\"501\" /\u003e\u003cbr /\u003eƯu điểm vượt trội: \u003cbr /\u003e- Phấn phủ sáng da với tông màu ánh tím giúp hiệu chỉnh sắc tố da, cải thiện tone da che phủ khuyết điểm mang đến vẻ đẹp trắng sáng. \u003cbr /\u003e- Công nghệ giải tỏa stress với hạt phấn mỏng mịn, bảo vệ da trước tác động của ánh sáng xanh và tia UV, hiệu quả lâu trôi lên đến 6 giờ. \u003cbr /\u003e- Bảo vệ da khỏi tác hại của ánh sáng xanh và tia cực tím. \u003cbr /\u003e- Kiểm soát lượng nhờn dầu dư thừa. \u003cbr /\u003e- Che phủ khuyết điểm và lỗ chân lông tốt. \u003cbr /\u003e- Dưỡng ẩm và ngăn ngừa lão hóa. \u003cbr /\u003e\u003cbr /\u003eMàu sắc sản phẩm \u003cbr /\u003e- 01: Trắng ánh tím (dành cho những làn da bị v.i.ê.m ửng đỏ do kích ứng với ánh nắng hoặc mụn v.i.ê.m, da thiên dầu xỉn màu) \u003cbr /\u003e- 02: Trắng sáng (phù hợp với tông màu da trung tính, trắng xanh) \u003cbr /\u003e- 03: Trắng tự nhiên (phù hợp với mọi tông màu da, kể cả tông da ngăm, xỉn màu) \u003cbr /\u003e\u003cbr /\u003eThành phần sản phẩm: \u003cbr /\u003e- Thành phần thiên nhiên, an toàn cho da mụn và nhạy cảm \u003cbr /\u003e- Trà xanh: chống oxy hóa, k.h.á.n.g v.i.ê.m. \u003cbr /\u003e- Hyaluronic acid: dưỡng ẩm, cấp nước giúp da ẩm mịn. \u003cbr /\u003e- Suối nước nóng ONSEN: làm dịu da, tăng sức đề kháng cho da, ngăn ngừa lão hóa. \u003cbr /\u003e- Vitamin E: cấp ẩm và ngăn ngừa lão hóa, giúp da mịn màng căng mướt. \u003cbr /\u003e\u003cbr /\u003eHướng dẫn sử dụng \u003cbr /\u003eThoa phấn phủ trực tiếp lên da hoặc phủ lên lớp nền. \u003cbr /\u003eDùng cọ trang điểm lấy một lượng nhỏ phấn phủ lên da hoặc dùng miếng bọt biển trang điểm. \u003cbr /\u003e\u003cbr /\u003eBảo quản: Tránh ánh sáng trực tiếp \u003cbr /\u003eTrọng lượng: 12gr \u003cbr /\u003eThương hiệu: Naris Cosmetic \u003cbr /\u003eXuất xứ thương hiệu: Nhật Bản \u003cbr /\u003eKhuyến cáo: Không có \u003cbr /\u003eHạn sử dụng: 5 năm kể từ ngày sản xuất \u003cbr /\u003e\u003cbr /\u003eRa đời từ năm 1932, Naris Cosmetics là một thương hiệu mỹ phẩm cao cấp Nhật Bản là bí quyết kì diệu để gìn giữ và duy trì làn da khỏe đẹp. Những sản phẩm của Naris đạt chứng nhận sản xuất theo quy trình công nghệ tiên tiến hàng đầu tại Nhật Bản, luôn nghiên cứu và phát triển sản phẩm sau mỗi năm để nâng cao hiệu quả sử dụng. \u003cbr /\u003eNgoài ra, Naris không bao giờ thử nghiệm trên động vật. Chúng tôi cũng thực hiện cam kết giảm thiểu cacbon và giảm sức ép rác thải ra trái đất. Các mỹ phẩm của Naris, 100% từ thiên nhiên, hoàn toàn không gây kích ứng da. \u003cbr /\u003e“For Others – Vì bạn” cũng chính là lời cam kết của Naris Cosmetics về chất lượng sản phẩm và dịch vụ \u003cbr /\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/08/a6/23/cb0f52c3fe7aa5483f8a9e66323b6f1c.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/08/a6/23/cb0f52c3fe7aa5483f8a9e66323b6f1c.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/08/a6/23/cb0f52c3fe7aa5483f8a9e66323b6f1c.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/08/a6/23/cb0f52c3fe7aa5483f8a9e66323b6f1c.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/08/a6/23/cb0f52c3fe7aa5483f8a9e66323b6f1c.png"},{"base_url":"https://salt.tikicdn.com/ts/product/26/73/cb/e656abfc069932eae897d7f7afa23b77.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/26/73/cb/e656abfc069932eae897d7f7afa23b77.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/26/73/cb/e656abfc069932eae897d7f7afa23b77.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/26/73/cb/e656abfc069932eae897d7f7afa23b77.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/26/73/cb/e656abfc069932eae897d7f7afa23b77.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/ee/b5/a6/f33f121b9777e6efc050da0903abf335.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ee/b5/a6/f33f121b9777e6efc050da0903abf335.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ee/b5/a6/f33f121b9777e6efc050da0903abf335.jpg","position":null,"small_url":"https://salt.tiki