text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":36000,"discount_rate":11,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/57/e6/bd/79daa105e2be0deee2cced00f6b35ee1.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":52,"all_time_quantity_sold":26,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eCuốn sách bạn đọc đang cầm trên tay hẳn chưa phải là toàn bộ cuộc chiến và có lẽ không một cuốn sách nào có thể làm được nhiệm vụ này. Tuy vậy, việc cho ra đời những cuốn sách thế này là hết sức cần thiết, đặc biệt có ý nghĩa đối với thế hệ trẻ tuổi, chưa từng kinh qua chiến tranh. Nội dung chính của cuốn sách tập trung vào hai mốc thời gian trọng yếu: 1979 và 1984, với mục đích của nhóm biên soạn là để phần nào tái hiện lại một thời đoạn lịch sử qua lời kể của các nhân chứng là dân thường, bộ đội chính quy, công an vũ trang, bộ đội địa phương, dân phòng.\u003c/p\u003e\n\u003cp\u003e\"Với tư cách một độc giả, đồng thời là một cựu binh, tôi thấy câu chuyện lịch sử được kể và tái hiện ở nhiều phương diện, góc nhìn, gồm đa dạng các nguồn tin chính thống khả tín kết hợp với tư liệu phỏng vấn công phu. Cuốn sách được tổ chức theo hình thức hiện đại, nhưng vẫn bám sát tình hình chiến sự nóng hổi của 40 năm về trước, điều đó chắc chắn sẽ giúp bạn đọc ở nhiều thế hệ dễ tiếp cận hơn cuộc chiến đặc biệt này.\u003c/p\u003e\n\u003cp\u003eBiên cương đã im tiếng súng, nhưng thời gian không thể làm suy suyển sự thật và bản chất lịch sử. Lịch sử cần được nhìn nhận, ghi nhớ, không phải nhen lên thù hận dân tộc, mà để xây đắp cho ước vọng hòa bình, để chúng ta không bao giờ bị bất ngờ trong nhiệm vụ tối hậu: bảo vệ độc lập chủ quyền thiêng liêng.\" - Trung tướng Nguyễn Hữu Khảm Nguyên Phó Tổng tham mưu trưởng Quân đội Nhân dân Việt Nam, Nguyên Sư đoàn trưởng Sư đoàn 316\u003c/p\u003e\n\u003cp\u003e ***\u003c/p\u003e\n\u003ch1\u003eNHỮNG MẢNH KÝ ỨC 1979-1989 - CHUYỆN KỂ TỪ BIÊN GIỚI PHÍA BẮC\u003c/h1\u003e\n\u003ch1\u003eTác giả: Đào Thanh Huyền - Hà Hương - Phạm Hoài Thanh\u003c/h1\u003e\n\u003ch1\u003eNhà phát hành: NXB Trẻ\u003c/h1\u003e\n\u003ch1\u003eNhà xuất bản: NXB Trẻ\u003c/h1\u003e\n\u003cp\u003eHình thức: Bìa mềm                                                         \u003c/p\u003e\n\u003cp\u003e***\u003c/p\u003e\n\u003cp\u003eThông tin sách:\u003c/p\u003e\n\u003cp\u003eKích thước:  17x24cm\u003c/p\u003e\n\u003cp\u003eSố trang: 288 trang/cuốn\u003c/p\u003e\n\u003cp\u003eCân nặng: 500gr\u003c/p\u003e\n\u003cp\u003eNăm phát hành: 2024\u003c/p\u003e\n\u003cp\u003e***\u003c/p\u003e\n\u003cp\u003e#Những_mảnh_ký_ức_1979_1989\u003c/p\u003e\n\u003cp\u003e#NXB_Trẻ\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/57/e6/bd/79daa105e2be0deee2cced00f6b35ee1.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/57/e6/bd/79daa105e2be0deee2cced00f6b35ee1.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/57/e6/bd/79daa105e2be0deee2cced00f6b35ee1.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/57/e6/bd/79daa105e2be0deee2cced00f6b35ee1.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/57/e6/bd/79daa105e2be0deee2cced00f6b35ee1.jpg"},{"bas