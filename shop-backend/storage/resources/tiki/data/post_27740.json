und_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":470000,"discount_rate":43,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ac/e5/89/394312b51f386c432dffa2b6e70fa4f0.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":582,"all_time_quantity_sold":9,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eNinh nấu nhiều giờ, cho món ngon trọn vẹn dinh dưỡng với nồi nấu chậm Unie USC10W. Chỉ cần cho nguyên liệu, chọn chức năng, món ăn ngon dành cho trẻ nhỏ, cho ông bà hay cả gia đình… sẽ tự động được hoàn thành mà chẳng cần tốn thời gian theo dõi, canh nhiệt độ, thời gian.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003cimg src=\"https://cf.shopee.vn/file/sg-11134202-23010-noi6skzcnymvf8\" alt=\"sg-11134202-23010-noi6skzcnymvf8\" /\u003e\u003c/p\u003e\n\u003cp\u003eĐẶC ĐIỂM NỔI BẬT CỦA NỒI NẤU CHẬM UNIE USC10W\u003c/p\u003e\n\u003cp\u003eCho món ngon trọn vẹn dưỡng chất\u003c/p\u003e\n\u003cp\u003eNấu chậm trong thời gian dài bằng nồi Unie USC10W giúp món ăn thấm vị hơn. Cơ chế đun nóng từ từ ở nhiệt độ thấp giúp dưỡng chất giảm thất thoát mà vẫn giữ nguyên hương vị trong từng loại nguyên liệu.\u003c/p\u003e\n\u003cp\u003eNấu chậm là phương pháp nấu phổ biến trong mọi gia đình. Đặc biệt với những “mẹ bỉm” nấu đồ ăn dặm cho bé thì đây là cách chế biến hàng đầu được các chuyên gia dinh dưỡng khuyên thực hiện. Chính vì vậy, Unie USC10W xứng đáng là món đồ gia dụng cần có trong căn bếp của mọi gia đình.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/sg-11134202-23010-jtjmp2bcnymv06\" alt=\"sg-11134202-23010-jtjmp2bcnymv06\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e3 chế độ nhiệt tự động điều chỉnh\u003c/p\u003e\n\u003cp\u003eNồi được tích hợp 3 chế độ nhiệt từ thấp, trung bình, đến cao, giúp bạn có thể nấu nướng đa dạng món ăn: đun sôi, hầm nhiều giờ hoặc đơn giản chỉ là giữ ấm đồ ăn.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/sg-11134202-23010-w9z144hdnymv02\" alt=\"sg-11134202-23010-w9z144hdnymv02\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e6 chức năng nấu đa dạng \u003c/p\u003e\n\u003cp\u003eVới 6 tính năng được lập trình sẵn hiện đại, nồi Unie USC10W cho phép bạn dễ dàng nấu nhiều món ăn khác nhau mà không cần điều chỉnh thời gian, nhiệt độ thủ công. Bất kỳ ai cũng có thể trở thành “đầu bếp” trong chính căn bếp của mình nhờ có nồi nấu chậm Unie.\u003c/p\u003e\n\u003cp\u003eNấu súp: 2,5 giờ\u003c/p\u003e\n\u003cp\u003eNấu cháo trẻ em: 2 giờ\u003c/p\u003e\n\u003cp\u003eNấu canh trứng: 0,5 giờ\u003c/p\u003e\n\u003cp\u003eChưng tổ yến: 1 giờ \u003c/p\u003e\n\u003cp\u003eKho cá: 1,5 giờ\u003c/p\u003e\n\u003cp\u003eNấu món tráng miệng: 2,8 giờ\u003c/p\u003e\n\u003cp\u003eBên cạnh loạt chức năng thông minh được lập trình sẵn, bạn cũng có thể tự động điều chỉnh nhiệt độ theo nhu cầu của mình từ 0,5 giờ lên tới 12 giờ. \u003c/p\u003e\n\u003cp\u003eNhờ khả năng gia nhiệt ổn định, đều đặn, Unie USC10W cho phép bạn nấu nướng an toàn, rảnh tay liên tục nhiều giờ mà không cần canh chừng vì sợ sôi trào, gây mất vệ sinh và nguy hiểm.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/sg-11134202-23010-45lzg5udnymv77\" alt=\"sg-11134202-23010-45lzg5udnymv77\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eHẹn giờ nấu tiện lợi\u003c/p\u003e\n\u003cp\u003eNồi có chức năng hẹn giờ nấu tiện lợi linh hoạt từ 2 – 12h, đây thực sự giải pháp hoàn hảo dành cho những người bận rộn, đặc biệt là các bà mẹ bỉm sữa; những người làm việc tại công sở cả ngày, không có thời gian chuẩn bị bữa ăn nhưng vẫn luôn muốn đảm bảo dinh dưỡng trong từng món ăn.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/sg-11134202-23010-6n4xwp5dnymv95\" alt=\"sg-11134202-23010-6n4xwp5dnymv95\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eLòng nồi gốm ceramic \u003c/p\u003e\n\u003cp\u003eChất lượng gốm ceramic chất lượng cao, có khả năng chống dính giúp lấy thức ăn một cách dễ dàng, không lo bám dính, cháy khét. Chất liệu gốm an toàn sức khỏe giúp bạn hoàn toàn an tâm về những món ăn được nấu với Unie USC10W, đặc biệt là những món ăn dặm dành cho trẻ nhỏ.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/sg-11134202-23010-4ydjew6enymv7e\" alt=\"sg-11134202-23010-4ydjew6enymv7e\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://cf.shopee.vn/file/sg-11134202-23010-opibsvcfnymv84\" alt=\"sg-11134202-23010-opibsvcfnymv84\" /\u003e\u003c/p\u003e\n\u003cp\u003eVung kính cường lực cao cấp, an toàn sử dụng\u003c/p\u003e\n\u003cp\u003eThiết kế vung kính cao cấp chịu lực, chịu nhiệt giúp người dùng có thể dễ dàng quan sát thực phẩm trong quá trình nấu. Đồng thời, lau rửa, vệ sinh nhanh chóng, dễ dàng kể cả bằng tay hay mới máy rửa bát.\u003c/p\u003e\n\u003cp\u003eThông số kỹ thuật:\u003c/p\u003e\n\u003cp\u003eModel: USC10W \u003c/p\u003e\n\u003cp\u003eĐiện áp: 220V～50Hz \u003c/p\u003e\n\u003cp\u003eCông suất: 300W \u003c/p\u003e\n\u003cp\u003eDung tích : 1.0L \u003c/p\u003e\n\u003cp\u003eKích thước (d × r × c): 258 mm×222 mm×215 mm \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ac/e5/89/394312b51f386c432dffa2b6e70fa4f0.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ac/e5/89/394312b51f386c432dffa2b6e70fa4f0.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ac/e5/89/394312b51f386c432dffa2b6e70fa4f0.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ac/e5/89/394312b51f386c432dffa2b6e70fa4f0.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ac/e5/89/394312b51f386c432dffa2b6e70fa4f0.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/05/25/54/4ede724509ede8bdc72c56e84806e053.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/05/25/54/4ede724509ede8bdc72c56e84806e053.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/05/25/54/4ede724509ede8bdc72c56e84806e053.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/05/25/54/4ede724509ede8bdc72c56e84806e053.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/05/25/54/4ede724509ede8bdc72c56e84806e053.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/9e/32/12/55e597e2cb73659cb04735f0a04fae22.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/9e/32/12/55e597e2cb73659cb04735f0a04fae22.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/9e/32/12/55e597e2cb73659cb04735f0a04fae22.jpg","position":null,"sm