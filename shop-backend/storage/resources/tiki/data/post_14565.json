:null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.6,"review_count":85,"review_text":"(85)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/49/0a/4c/c7ab345ba314107763a10a0b87baafc2.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1401,"all_time_quantity_sold":265,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cspan style=\"color: #00ff00;\"\u003e\u003cem\u003e\u003cstrong\u003e Bột Ngũ Cốc Min Min Dinh Dưỡng Min Min Phù hợp với mọi đối tượng, Đặc biệt đối với phụ nữ trước và sau sinh, người già, người táo bón, mất ngủ và trẻ em trên 2 tuổi\u003c/strong\u003e\u003c/em\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cstrong\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/0c/54/90/79975c021db5a9414b9a86d18426b1d9.jpg\" alt=\"\" width=\"750\" height=\"467\" /\u003e\u003c/strong\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e   Bột Ngũ Cốc Min Min đảm bảo 100% nguồn sản phẩm nhập khẩu (Hạnh nhân, Macca, Yến mạch, Óc chó, Chia) là         dòng Bio, có CO, CQ đầy đủ.\u003c/p\u003e\n\u003cp\u003e    Các loại đậu ( đậu xanh, đỏ, đen, nành, ngự) là các loại đậu ta, không sử dụng sản phẩm biến đối gen (GMO) - đảm     bảo không thuốc trừ sâu, không phân hóa học.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/52/02/98/9839bd651041b7f229c6832ecf91b04a.png\" alt=\"\" width=\"750\" height=\"374\" /\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cspan style=\"color: #00ff00;\"\u003e\u003cstrong\u003eCông dụng ngũ cốc lợi sữa Min Min 29  loại hạt+đậu \u003c/strong\u003e\u003c/span\u003e\u003c/h3\u003e\n\u003col\u003e\n\u003cli\u003eCác thành phần trong bột ngũ cốc giúp ,lợi sữa, tăng tiết sữa, đặc sữa, thơm sữa.\u003c/li\u003e\n\u003cli\u003eLàm đẹp, giảm thâm nám ,sáng, mịn da, chống ô xy hóa.\u003c/li\u003e\n\u003cli\u003eCải thiện lượng sữa, tăng tiết sữa, kích thích sữa mẹ về nhiều trong khoảng 1-5 ngày.\u003c/li\u003e\n\u003cli\u003eSữa mẹ về nhiều, ngực căng sữa, kích thích tuyến sữa mẹ hoạt động tốt hơn.\u003c/li\u003e\n\u003cli\u003eNgoài ra bột ngũ cốc còn giúp bổ gan,mát gan, giải độc,thanh nhiệt.\u003c/li\u003e\n\u003cli\u003eThành phần trong các hạt ngũ cốc lợi sữa Min Min giúp bạn khỏe hơn, máu lưu thông tốt hơn.\u003c/li\u003e\n\u003cli\u003eBổ sung thêm thành phần yến mạch và quả óc chó giúp tăng cường dưỡng chất đặc biệt là ô mê ga 3cho sự phát triển trí não ở trẻ.\u003c/li\u003e\n\u003c/ol\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/c8/78/ba/8f2bfb87a80dabc7d4f10d112dcf847e.png\" alt=\"\" width=\"600\" height=\"400\" /\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong\u003e  \u003cspan style=\"color: #00ff00;\"\u003e Cách sử dụng ngũ cốc Min Min\u003c/span\u003e\u003c/strong\u003e\u003cspan style=\"color: #00ff00;\"\u003e:\u003c/span\u003e\u003c/h3\u003e\n\u003cp\u003e- HSD:  45 ngày từ ngày mở hộp và 12 tháng từ ngày sản xuất. \u003c/p\u003e\n\u003cp\u003e  B1: Pha 2- 3 thìa ngũ cốc lợi sữa với 50ml chút nước nguội khuấy đều.\u003cbr /\u003e  B2: Cho  200ml nước mới đun sôi , thêm chút đường/ sữa đặc và uống nóng., ngày uống  2 đến 3 cốc bột ngũ cốc lợi   sữa.\u003c/p\u003e\n\u003cp\u003e   pha không đường hoặc ít đường hay dùng đường cho người ăn kiêng, uống trước ăn 15-20p, tốt nhất vào bữa sáng,     uống lúc nóng.\u003c/p\u003e\n\u003cp\u003e- \u003cstrong\u003ePhụ nữ sau sinh\u003c/strong\u003e:  sử dụng 3 ly , chia đều trước cữ cho bé bú 20-30 phút và uống đủ 2-3l nước ấm mỗi ngày.\u003c/p\u003e\n\u003cp\u003e- \u003cstrong\u003eNgười gầy\u003c/strong\u003e: sử dụng sau khi ăn thêm đường hoặc sữa ông thọ( ngày 3 ly)\u003c/p\u003e\n\u003cp\u003e- \u003cstrong\u003eNgười mập\u003c/strong\u003e: Sử dụng trước bữa ăn  sử dụng không  đường hoặc ít đường( ngày 3 ly)\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e  Lưu ý: \u003c/strong\u003eNgũ cốc lợi sữa tuy tuy có nhiều chất dinh dưỡng nhưng không thể thay thế toàn bộ các loại thực phẩm khác,   để đảm bảo sự phát triển toàn diện người dùng cần phải kết hợp với các loại thực phẩm khác nhau để có Kết quả tốt   nhất. Chất lượng sữa còn tùy vào cơ địa từng người. Vì thế các mẹ cần kiên trì thực hiện chế độ ăn uống nghỉ ngơi  hàng ngày một cách hợp lý nhé.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/49/0a/4c/c7ab345ba314107763a10a0b87baafc2.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/49/0a/4c/c7ab345ba314107763a10a0b87baafc2.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/49/0a/4c/c7ab345ba314107763a10a0b87baafc2.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/49/0a/4c/c7ab345ba314107763a10a0b87baafc2.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/49/0a/4c/c7ab345ba314107763a10a0b87baafc2.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/10/0f/e1/550aa6d3547463df1