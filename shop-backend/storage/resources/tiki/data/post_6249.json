"rating_average":4.2,"review_count":46,"review_text":"(46)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/bd/c5/5d/7d07e84fe09f5f597c372dfcc8c0116e.JPG","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1548,"all_time_quantity_sold":166,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003ciframe src=\"//www.youtube.com/embed/jv2X-5mF2xU?feature=youtu\" width=\"999\" height=\"560\" allowfullscreen=\"allowfullscreen\"\u003e\u003c/iframe\u003e\u003c/p\u003e\n\u003cp\u003eĐối với các quán cà phê, sinh tố, chè, máy bào đá là một thiết bị không thể thiếu để làm ra những thức uống mát lành, nhất là một số loại đồ uống yêu cầu phải dùng đá bào thay cho đá viên như siro đá bào, chanh tuyế Ngoài ra, đá bào dạng tuyết mịn cũng làm các ly nước uống nhìn đẹp mắt hơn, và có thể dùng để ướp lạnh cho hoa quả.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/81/ae/77/6dc35b49342450679c9f70e04a479272.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eVận hành nhanh, tiếng ồn nhỏ.\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eNhỏ gọn dễ sử dụng. Công suất máy hoạt động chỉ với 380W không lo tiêu hao điện năng, không lo phát ra tiếng ồn. Không tốn quá nhiều không gian trong gian bếp cũng như làm gian bếp của bạn trông hiện đại, bắt mắt hơn, thu hút được nhiều thực khách.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/e0/01/12/7a5bdbe78fc0523d29567e307710a3e2.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch5\u003eCông nghệ mới\u003c/h5\u003e\n\u003cp\u003eMáy bào đá tuyết sử dụng công nghệ mới, chuyên nghiệp dùng cho quán cafe và nhà hàng: có 2 lưỡi cho đá bào tuyết mịn hơn, motor lớn, cho nên tuổi thọ máy bào đá cao, có 2 vị trị chứa đá, tiện lợi theo yêu cầu, chức năng tạm tắt máy khi nâng tay cảm của máy bào đá lên.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/4a/6a/e6/94f177256cd5b4066b6d8b0173710cdf.JPG\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch5\u003ePhạm vi sử dụng lớn\u003c/h5\u003e\n\u003cp\u003eSử dụng đá bào để tạo nên những món vô cùng phong phú: dùng cho pha chế, tạo các món sinh tố, trái cây dầm, siro đá bào, ngoài ra còn kết hợp tuyệt vời với những thức uống giải khát, đá bào có công dụng lớn để tạo giữ độ độ tươi cho thực phẩm.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/37/fb/bd/acb2aa0e305d302d783f92b2f396e808.JPG\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThông tin sản phẩm:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eKích thước máy: 400 x 180 x 310mm\u003c/li\u003e\n\u003cli data-spm-anchor-id=\"a261y.7663282.descB\"\u003eKích thước đóng gói: 425 x 205 x 320mm\u003c/li\u003e\n\u003cli\u003eTrọng lượng: 5,5kg\u003c/li\u003e\n\u003cli\u003eCông suất: 380W\u003c/li\u003e\n\u003cli\u003eĐiện áp: 220v ~ 50Hz\u003c/li\u003e\n\u003cli\u003eChất liệu: nhựa ABS + nhôm đúc\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/12/21/ee/6343b0f1ff0fce07f8caedc6ba224392.JPG\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eCác bước vận hành\u003cbr /\u003eB1- Cấp nguồn điện cho máy,bật công tắc nguồn\u003cbr /\u003eB2- Cho đầy đá vào trong khoang tiếp theo đó dùng tay dập để dập tay 1 xuống, đá sau khi được bào sẽ tự rơi xuống khay đựng đá\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/65/2b/2d/f017407eea85e5f577c24d3f9f87db33.JPG\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eHàng ngày sau khi sử dụng xong máy 