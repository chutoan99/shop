unt":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/9f/e5/42/64edfc0f48cd4697f6b133723a11b85f.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1016,"all_time_quantity_sold":25,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003chtml\u003e\n \u003chead\u003e\u003c/head\u003e\n \u003cbody\u003e\n  \u003cul\u003e\n   \u003cp\u003eGõ phím nhanh và thoải mái :\u003c/p\u003e\n   \u003cp\u003eBãn sẽ được tận hưởng sự thoải mái và gõ phím nhanh hơn với các phím thấp được bố trí dầy đủ cùng với bàn phím số.\u003c/p\u003e\n   \u003cp\u003eThiết kế chống tràn* :\u003c/p\u003e\n   \u003cp\u003eChất lỏng sẽ tự chảy ra ngoài nên bạn sẽ không còn lo lắng về việc vô tình làm đổ chất lỏng lên trên bàn phím.\u003c/p\u003e\n   \u003cp\u003eThiết kế mỏng :\u003c/p\u003e\n   \u003cp\u003eBàn mỏng ngang tầm với bản tay, giúp cho tay gõ phím dễ hơn và không gây cảm giác mỏi tay sau nhiều giờ sử dụng.\u003c/p\u003e\n   \u003cp\u003eĐộ bền cao :\u003c/p\u003e\n   \u003cp\u003eCác có độ bền cao với số lần gõ phím lên đến 10 triệu lần, vì thế bạn có thể sử dụng liên tục mà không lo sợ các phím bấm bị hư.\u003c/p\u003e\n   \u003cp\u003eĐiều chỉnh chiều cao :\u003c/p\u003e\n   \u003cp\u003eBạn có thể gấp lại hoặc mở rộng đôi chân vững chắc để tăng độ nghiên của bàn phím thêm 8 độ.\u003c/p\u003e\n   \u003cp\u003eKết nối nhanh qua cổng USB :\u003c/p\u003e\n   \u003cp\u003eThiết lập đơn giản, chỉ cần tháo hộp và cắm nó vào cổng USB của bất kì máy tính nào và sử dụng được ngay.\u003c/p\u003e\n   \u003cp\u003eKý tự dễ đọc :\u003c/p\u003e\n   \u003cp\u003eCác ký tự của phím được in đậm với màu trắng sáng giúp cho người dùng dễ đọc hơn, hỗ trợ tối đa cho những người có tầm nhìn kém.\u003c/p\u003e\n   \u003cp\u003eSự tin cậy của Logitech :\u003c/p\u003e\n   \u003cp\u003eBạn sẽ có được chất lượng cao cùng độ tin cậy từ Logitech với thời gian bảo hành lâu và chu đáo.\u003c/p\u003e\n   \u003cp\u003eCác phím được bo góc :\u003c/p\u003e\n   \u003cp\u003eNó giữ cho tay bạn được tự nhiên hơn khi gõ phím và dễ dàng di chuyển qua lại giữa các phím.\u003c/p\u003e\n   \u003cp\u003eYêu cầu hệ thống\u003c/p\u003e\n   \u003cp\u003eWindows-based computer: Windows XP, Windows Vista or Windows 7, Cổng USB\u003c/p\u003e\n   \u003cp\u003eLinux: Linux kernel 2.6+, Cổng USB\u003c/p\u003e\n  \u003c/ul\u003e\n \u003c/body\u003e\n\u003c/html\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/9f/e5/42/64edfc0f48cd4697f6b133723a11b85f.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/9f/e5/42/64edfc0f48cd4697f6b133723a11b85f.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/9f/e5/42/64edfc0f48cd4697f6b133723a11b85f.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9f/e5/42/64edfc0f48cd4697f6b133723a11b85f.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9f/e5/42/64edfc0f48cd4697f6b133723a11b85f.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/90/05/21/1825dc49c42c3b704edf569086630d9a.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/90/05/21/1825dc49c42c3b704edf569086630d9a.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/90/05/21/1825dc49c42c3b704edf569086630d9a.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/90/05/21/1825dc49c42c3b704edf569