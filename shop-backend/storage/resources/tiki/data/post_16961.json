cdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.7,"review_count":203,"review_text":"(203)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/47/cd/74/10353be3d248be52980426e14fc4cb49.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1534,"all_time_quantity_sold":616,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003eGiới Thiệu\u003c/h3\u003e\n\u003cp\u003eXe tập thăng bằng đang dần được phổ biến rộng rãi, thay thế cho những chiếc xe đạp 3 bánh nặng, cồng kềnh hay khó điều khiển mà vẫn đảm bảo trẻ có thể luyện tập kĩ năng lái xe cũng như giữ cân bằng hiệu quả. Điểm đặc biệt của chiếc xe tập thăng bằng này chính là không có bàn đạp và di chuyển được (tiến lên hay lùi lại) nhờ lực đẩy từ đôi chân của trẻ, nhờ đó mà việc lái xe không chỉ giúp trẻ học giữ thăng bằng mà còn khuyến khích trẻ vận động, rèn luyện cơ thể dẻo dai, khỏe mạnh.\u003c/p\u003e\n\u003ch3\u003eChất Liệu\u003c/h3\u003e\n\u003cp\u003eVới chất liệu khung thép được sơn màu an toàn cho bé và độ bền cao, đặc biệt không phai theo thời gian, không bị bong tróc do tác động của thời tiết\u003c/p\u003e\n\u003ch3\u003eĐặc Điểm Nổi Bật\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eKhung xe được làm từ hợp kim chắc chắn, đảm bảo độ vững chãi của chiếc xe và sự an toàn của trẻ khi lái xe nhưng lại không làm trọng lượng của chiếc xe trở nên quá nặng (trẻ có thể tự vác, xách xe bằng 1 tay).\u003c/li\u003e\n\u003cli\u003eThiết kế khung xe đơn giản và thu gọn tối đa tạo không gian cho trẻ thực hiện những động tác vận động linh hoạt.\u003c/li\u003e\n\u003cli\u003eYên xe rộng, bọc nệm mềm nhằm tránh gây ê hay đau mông khi ngồi lâu, chiều cao phù hợp cho trẻ từ 1,5-6 tuổi.\u003c/li\u003e\n\u003cli\u003eTay lái nằm ngang được thiết kế tương thích với chiều cao yên giúp trẻ dễ dàng điều khiển hướng đi của xe. \u003cbr /\u003eBánh xe vành nhựa đúc liền khối siêu nhẹ; lốp xe đặc không cần bơm, bám đường, chống trơn trượt và chống xóc nảy hiệu quả, đảm bảo chiếc xe di chuyển trơn tru trên mọi địa hình.\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003eLưu Ý\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eLuôn cho trẻ đội mũ bảo hiểm, đeo đai bảo vệ chân tay trong suốt quá trình luyện tập. \u003c/li\u003e\n\u003cli\u003eKhông cho trẻ mới tập xe đi vào những đoạn đường không bằng phẳng, đoạn đường bùn đất lầy lội, đoạn đường nhiều sỏi đá, đoạn đường diện tích quá hẹp hay những đoạn đường có nhiều phương tiện giao thông qua lại. \u003c/li\u003e\n\u003cli\u003eKhông cho trẻ chưa đủ chiều cao (chân chưa chạm tới đất khi ngồi trên yên xe) luyện tập đi xe thăng bằng.\u003c/li\u003e\n\u003cli\u003eThường xuyên tham gia cùng bé trong quá trình luyện tập và vui chơi của trẻ nhằm đảm bảo an toàn tối đa.\u003c/li\u003e\n\u003cli\u003eKhông để trẻ tập đi xe tại khu vực gần sông, hồ, có thể gây nguy hiểm.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003ciframe src=\"https://www.youtube.com/embed/Qu2K_9oNMoc\" width=\"560\" height=\"314\" allowfullscreen=\"\"\u003e\u003c/iframe\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/cf/1b/bf/6ce4b86020c7e5351c857d92ed92a89d.jpg\" alt=\"\" width=\"750\" height=\"499\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/f9/65/65/c5f0181f4e1852fe43628fdc5eea2b3f.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://sal