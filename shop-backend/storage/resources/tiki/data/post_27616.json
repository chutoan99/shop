l,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":60,"review_text":"(60)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/fc/27/66/7acdc68ad2b32ced9ea097195e9208ca.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":943,"all_time_quantity_sold":511,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eĐược làm hoàn toàn từ sữa tươi sạch lên men tự nhiên cùng hương vị của hương dâu - chuối - lúa mạch tự nhiên. Sữa chua uống tiệt trùng TOPKID hương dâu-chuối-lúa mạch mang đến cho bạn hương vị thơm ngon, đầy đủ chất dinh dưỡng cho cơ thể. Với thiết kế bao bì nhỏ gọn, bạn dễ dàng tận hưởng vị ngon bất tận của TH True Yogurt ở mọi nơi.\u003c/p\u003e\n\u003cdiv\u003e\n\u003cdiv\u003e\n\u003cdiv\u003e\n\u003cdiv\u003e\n\u003cdiv\u003e \u003c/div\u003e\n\u003cdiv\u003e\n\u003cdiv\u003e\u003cimg class=\"focused\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/17/a7/0c/be2091d9c757f57a4c9cbf1803810f68.jpg\" alt=\"be2091d9c757f57a4c9cbf1803810f68.jpg\" /\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eĐẶC ĐIỂM NỔI BẬT\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Được làm từ sữa tươi sạch lên men tự nhiên từ trang trại TH kết hợp cùng hương vị trái cây tự nhiên hấp dẫn, mang đến cảm giác sảng khoái và tốt cho sức khỏe\u003c/p\u003e\n\u003cp\u003e- Đặc biệt không chất bảo quản và phụ gia\u003c/p\u003e\n\u003cp\u003e- Hộp giấy 110ml nhỏ gọn, tiện lợi cho trẻ sử dụng và mang theo hàng ngày. Thiết kế bao bì sản phẩm là hình ảnh các nhân vật trong bộ truyện tranh Chinh Phục Vũ Trụ dễ thương, sống động cuốn hút mọi trẻ nhỏ\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTHÀNH PHẦN\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eSữa hoàn toàn từ sữa bò tươi (51%), nước, đường, chất ổn định (E 440), hương dâu - chuối - lúa mạch tự nhiên, màu tự nhiên ( E 160b(ii)), E 120), vitamin (B6, B12, axit folic), khoáng chất (calci carbonat), men Streptococcus thermophilus và Lactobacillus bulgaricus\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eQUY CÁCH ĐÓNG GÓI\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e1 thùng 48 hộp 110ml\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eHƯỚNG DẪN SỬ DỤNG\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Sử dụng ngay sau khi mở. Ngon hơn khi uống lạnh\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCÁCH BẢO QUẢN\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Ngon hơn khi uống lạnh\u003c/p\u003e\n\u003cp\u003e- Sử dụng ngay sau khi mở\u003c/p\u003e\n\u003cp\u003e- Không dùng cho trẻ dưới 1 tuổi\u003c/p\u003e\n\u003cp\u003e- Sản phẩm bổ sung vitamin và khoáng chất giúp phát triển não bộ và chiều cao\u003c/p\u003e\n\u003cp\u003e- Nên dùng từ 2-3 hộp mỗi ngày\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eLưu ý: Bao bì có thể thay đổi theo từng thời điểm\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eXuất xứ: Việt Nam\u003c/p\u003e\n\u003cp\u003eNơi sản xuất: Việt Nam\u003c/p\u003e\n\u003cp\u003eNgày sản xuất: In trên bao bì sản phẩm\u003c/p\u003e\n\u003cp\u003eHạn sử dụng: 180 ngày kể từ ngày sản xuất\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTHÔNG TIN THƯƠNG HIỆU\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eKhao khát khai mở một con đường, một sứ mệnh nâng cao Tầm Vóc Việt, tập đoàn TH tự hào là đơn vị đặt viên gạch đầu tiên tạo nền móng cho ngành công nghiệp sữa sạch Việt Nam. Những dự án đầu tư của TH được hiện thực hoá một cách bài bản theo hướng ứng dụng công nghệ cao, khoa học công nghệ và khoa học quản trị đan xen vào nhau tạo ra những sản phẩm có chất lượng đột phá, góp phần nâng cao chất lượng cuộc sống con người và hướng tới sự phát triển bền vững của quốc gia.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/fc/27/66/7acdc68ad2b32ced9ea097195e9208ca.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/fc/27/66/7acdc68ad2b32ced9ea097195e9208ca.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/fc/27/66/7acdc68ad2b32ced9ea097195e9208ca.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fc/27/66/7acdc68ad2b32ced9ea097195e9208ca.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fc/27/66/7acdc68ad2b32ced9ea097195e9208ca.png"},{"base_url":"https://salt.tikicdn.com/ts/product/00/72/f7/8af56aad4e29f15ba869842364349225.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/00/72/f7/8af56aad4e29f15ba869842364349225.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/00/72/f7/8af56aad4e29f15ba869842364349225.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/00/72/f7/8af56aad4e29f15ba869842364349225.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/00/72/f7/8af56aad4e29f15ba869842364349225.png"},{"base_url":"https://salt.tikicdn.com/ts/product/96/23/e2/3640be3c33afd54c41937f45be3bee17.png","is_gallery":true,"label":n