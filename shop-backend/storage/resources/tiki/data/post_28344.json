,"icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/b7/6a/61/c189f78dfad5b8eee84d4b8eb97a4676.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":757,"all_time_quantity_sold":17,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eCombo 2 Hộp Hillway Trà Sữa Trân Châu 416g\u003c/p\u003e\n\u003cp\u003eHƯỚNG DẪN SỬ DỤNG\u003c/p\u003e\n\u003cp\u003eUống lạnh: Cho 1 gói Trà sữa vào ly, thêm 50ml nước nóng, khuấy đều, cho tiếp 1 gói Trân Châu (có kèm nước đường) vào ly, thêm đá và thưởng thức.\u003c/p\u003e\n\u003cp\u003eHƯỚNG DẪN BẢO QUẢN \u0026amp; QUY CÁCH ĐÓNG GÓI\u003c/p\u003e\n\u003cp\u003eBảo quản nơi khô ráo thoáng mát, tránh ánh sáng trực tiếp\u003c/p\u003e\n\u003cp\u003eHạn sử dụng: 9 tháng kể từ ngày sản xuất\u003c/p\u003e\n\u003cp\u003eQuy cách đóng gói: 8 gói Trà Sữa (22g) và 8 gói Trân Châu (30g)\u003c/p\u003e\n\u003cp\u003eGIỚI THIỆU SẢN PHẨM\u003c/p\u003e\n\u003cp\u003eHILLWAY là Trà sữa hoà tan có gói TRÂN CHÂU TƯƠI bên trong, lần đầu tiên có mặt tại Việt Nam.\u003c/p\u003e\n\u003cp\u003e1 HỘP gồm: 8 gói Trà sữa x 22g và 8 gói Trân châu x 30g.\u003c/p\u003e\n\u003cp\u003eChỉ với 1 phút và 2 gói (1 gói Trà sữa, 1 gói Trân châu), bạn sẽ có ngay ly Trà sữa Trân Châu chuẩn vị quán với Trân Châu hoàng gia ngon giòn sần sật.\u003c/p\u003e\n\u003cp\u003eHILLWAY Trà Sữa Trân Châu là một sản phẩm của: CÔNG TY TNHH FES (VIỆT NAM) cùng với nhãn hàng MacCoffee CaféPHỐ, thuộc tập đoàn Food Empire Holdings của Singapore, với các thương hiệu toàn cầu trong việc sản xuất ngành hàng thực phẩm và đồ uống.\u003c/p\u003e\n\u003cp\u003eTHÔNG TIN THƯƠNG HIỆU\u003c/p\u003e\n\u003cp\u003eĐược thành lập vào năm 1994, Công ty TNHH FES (Việt Nam) là một trong những công ty đầu tiên đưa văn hoá uống cà phê hoà tan vào Việt Nam với 2 dòng sản phẩm MacCoffee 3in1 Đậm Đà và MacCoffee 3in1 Cổ Điển. Bên cạnh đó, FES còn đem đến cho người tiêu dùng Việt Nam các sản phẩm bổ dưỡng và tiện lợi khác như ngũ cốc dinh dưỡng MacCereal hay TRÀ SỮA TRÂN CHÂU HILLWAY với TRÂN CHÂU TƯƠI lần đầu tiên có mặt tại Việt Nam.\u003c/p\u003e\n\u003cp\u003eCác sản phẩm của FES ngày càng được người tiêu dùng ưa chuộng nhờ hương vị thơm ngon, hợp gu với người Việt.\u003c/p\u003e\n\u003cp\u003eNăm 2005, FES thành lập nhà máy tại Bình Dương, khởi đầu cho công cuộc chinh phục thị trường Việt Nam.\u003c/p\u003e\n\u003cp\u003eCHÍNH SÁCH ĐỔI TRẢ\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eCAM KẾT: Hàng chính hãng, có đầy đủ giấy giờ, hạn sử dụng luôn mới.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/b7/6a/61/c189f78dfad5b8eee84d4b8eb97a4676.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b7/6a/61/c189f78dfad5b8eee84d4b8eb97a4676.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b7/6a/61/c189f78dfad5b8eee84d4b8eb97a4676.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b7/6a/61/c189f78dfad5b8eee84d4b8eb9