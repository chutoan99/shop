_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":145000,"discount_rate":8,"rating_average":4.8,"review_count":63,"review_text":"(63)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/4f/25/95/a569eb6c41f6fb2b1d42c5433441fb8b.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":0,"all_time_quantity_sold":210,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<h3>Thiết kế lò hiện đại, sang trọng</h3>\r\n<p><strong></strong>Thiết kế nhỏ gọn với những đường nét tính tế và hiện đại, không chỉ giúp tiết kiệm tối đa không gian phòng mà còn tô điểm thêm vẻ ưa nhìn cho căn bế của bạn. Bên cạnh đó, cửa lò còn được thiết kế nút ấn mở dễ thao tác cho bạn sử dụng thật dễ dàng và nhanh chóng.</p>\r\n<p><img style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Lò Vi Sóng Sharp R-205VN(S) - 20L\" src=\"http://tikicdn.com/media/catalog/product/1/_/1.u425.d20160813.t155759.603601.jpg\" alt=\"Lò Vi Sóng Sharp R-205VN(S) - 20L\" width=\"750\" height=\"500\" /></p>\r\n<h3>Dung tích lò 20L</h3>\r\n<p><strong></strong>Khoang lò có dung tích phổ thông 20L , phù hợp cho việc chế biến đa dạng các món ăn hay kết hợp nhiều món ăn cùng lúc. Với sự tiện ích này, đây chắc chắn sẽ là sự lựa chọn phù hợp cho những gia đình đông người và bận rộn.</p>\r\n<p><img style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Lò Vi Sóng Sharp R-205VN(S)\" src=\"http://tikicdn.com/media/catalog/product/s/h/sharp-r-205vn-s-org-7_1.jpg\" alt=\"Lò Vi Sóng Sharp R-205VN(S)\" width=\"750\" height=\"536\" /></p>\r\n<h3>3 chức năng nấu, hâm và rã đông</h3>\r\n<p><strong></strong>3 chức năng nấu, hâm và rã đông tiện dụng, giúp bạn nấu chín và chế biến thực phẩm dễ dàng và nhanh chóng. Với 3 chức năng tiện lợi này, bạn sẽ chỉ cần vài phút cho 1 món ăn nóng hổi mà vẫn giữ lại được trọn vẹn hương vị của món ăn.</p>\r\n<p><img style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Lò Vi Sóng Sharp R-205VN(S) - 20L\" src=\"http://tikicdn.com/media/catalog/product/4/_/4.u425.d20160813.t155759.696444.jpg\" alt=\"Lò Vi Sóng Sharp R-205VN(S) - 20L\" width=\"750\" height=\"500\" /></p>\r\n<h3>Nhiều mức điều chỉnh công suất phù hợp</h3>\r\n<p><strong></strong>Công suất tối đa 800W giúp tiết kiệm tối đa thời gian nấu nướng. Ngoài ra, với nhiều mức điều chỉnh công suất khác nhau, bạn có thể dễ dàng lựa chọn mức công suất phù hợp với mục đích sử dụng hay yêu cầu chế biến món ăn, cho hiệu quả sử dụng tối ưu nhất.</p>\r\n<p><img style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Lò Vi Sóng Sharp R-205VN(S) - 20L\" src=\"http://tikicdn.com/media/catalog/product/2/_/2.u425.d20160813.t155759.637642.jpg\" alt=\"Lò Vi Sóng Sharp R-205VN(S) - 20L\" width=\"750\" height=\"500\" /></p>\r\n<h3>Chế độ cài đặt thời gian tiện lợi</h3>\r\n<p><strong></strong>Ngoài các mức công suất khác nhau, lò còn có chế độ cài đặt thời gian tiện lợi phù hợp với từng món ăn khác nhau, giúp món ăn không bị cháy, khét hay khô. Bạn có thể hẹn giời tối đa lên tới 35 phút.</p>\r\n<p><img style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Lò Vi Sóng Sharp R-205VN(S) - 20L\" src=\"http://tikicdn.com/media/catalog/product/5/_/5.u425.d20160813.t155759.723989.jpg\" alt=\"Lò Vi Sóng Sharp R-205VN(S) - 20L\" width=\"750\" height=\"500\" /></p>\r\n<h3>Hệ thống núm xoay cơ tiện dụng</h3>\r\n<p><strong></strong>Hệ thống núm xoay cơ tiện dụng giúp điều chỉnh chế độ nhẹ nhàng. Với núm xoay cơ thao tác đơn giản, bạn có thể dễ dàng điều chỉnh đến chế độ, công suất và thời gian thật phù hợp, cho chất lượng và hương vị món ăn hoàn hảo.</p>\r\n<h3><img style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Lò Vi Sóng Sharp R-205VN(S) - 20L\" src=\"http://tikicdn.com/media/catalog/product/s/h/sharp-r-205vn-s-org-3_1.jpg\" alt=\"Lò Vi Sóng Sharp R-205VN(S) - 20L\" width=\"750\" height=\"543\" /></h3>\r\n<h3>Cụm điều khiển tiếng Việt thân thiện người dùng</h3>\r\n<p>Cụm điều khiển vặn xoay có tiếng Việt chỉ dẫn trên từng nút, giúp hạn chế thao tác sai. Cho nên lò vi sóng Sharp R-205VN(S) hoàn toàn thân thiện với người sử dụng cho dù có là người lớn tuổi</p>\r\n<p><img style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Lò Vi Sóng Sharp R-205VN(S) - 20L\" src=\"http://tikicdn.com/media/catalog/product/3/_/3.u425.d20160813.t155759.668772.jpg\" alt=\"Lò Vi Sóng Sharp R-205VN(S) - 20L\" width=\"750\" height=\"500\" /></p>\r\n<h3>Chức năng rã đông theo trọng lượng</h3>\r\n<p><strong></strong>Lò có chức năng tự động cài đặt rã đông theo trọng lượng thực phẩm, giúp rã đông nhanh mà không làm mất chất dinh dưỡng có trong thực phẩm, đồng thời hạn chế tối đa các hiện tượng rã đông không hết hay không đều.</p>\r\n<p><img style=\"display: block; margin-left: auto; margin-right: auto;\" title=\"Lò Vi Sóng Sharp R-205VN(S) - 20L\" src=\"http://tikicdn.com/media/catalog/product/6/_/6.u425.d20160813.t155759.750842.jpg\" alt=\"Lò Vi Sóng Sharp R-205VN(S) - 20L\" width=\"750\" height=\"500\" /></p>\r\n<h3>Lưu ý để sử dụng lò vi sóng an toàn</h3>\r\n<p><strong></strong>- Đảm bảo các dụng cụ đựng thức ăn phải là loại dùng riêng cho lò vi sóng. Nên sử dụng đồ dùng làm từ vật liệu trong suốt để nhiệt lượng truyền nhanh,tiết kiệm điện năng sử dụng.</p>\r\n<p>- Không sử dụng đồ dùng bằng kim loại, dụng cụ có chứa kim loại trong lò vi sóng hay các sản phẩm bằng giấy tái sử dụng bởi chúng có chứa kim loại, dễ làm phát tia lửa hoặc gây cháy nổ.</p>\r\n<p>- Không vận hành lò vi sóng khi cửa bị hỏng hoặc không đóng khít.</p>\r\n<p>- Không vận hành khi lò vi song đang rỗng vì có thể phát lửa và gây hỏa hoạn.</p>\r\n<p>- Nên đứng cách xa lò vi sóng khoảng 1 mét để đảm bảo an toàn khi lò đang hoạt động.</p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/4f/25/95/a569eb6c41f6fb2b1d42c5433441fb8b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/4f/25/95/a569eb6c41f6fb2b1d42c5433441fb8b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/4f/25/95/a569eb6c41f6fb2b1d42c5433441fb8b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4f/25/95/a569eb6c41f6fb2b1d42c5433441fb8b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4f/25/95/a569eb6c41f6fb2b1d42c5433441fb8b.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/04/f6/13/0b643e211c9908d0473d70e00c69a450.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/04/f6/13/0b643e211c9908d0473d70e00c69a450.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/04/f6/13/0b643e211c9908d0473d70e00c69a450.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/04/f6/13/0b643e211c9908d0473d70e00c69a450.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/04/f6/13/0b643e211c9908d0473d70e00c69a450.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/9f/f1/82/2df4cc3b7e4cb446b8b