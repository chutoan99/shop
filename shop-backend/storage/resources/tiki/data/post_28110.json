_reason"}},"discount":27000,"discount_rate":15,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/a0/37/1b/546ae2e6c927a9cdd87b5065f24e174d.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":693,"all_time_quantity_sold":2,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp class=\"_2jrvqA\"\u003e\u003cstrong\u003eSÁCH RA MẮT VÀO THÁNG 10.2022\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003eThông tin sách:\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003eCông ty phát hành: Công ty CP Sách và Truyền thông San Hô (San Hô Books)\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003eKích thước: 20.5 x 26 CM\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003eNhà xuất bản: NXB Thanh Niên\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003eNgười dịch: Nhật Minh, Lan Võ\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003eSố trang: 80\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003eHình thức: Bìa Cứng\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003eTác giả: Štěpánka Sekaninová \u0026amp; Marta Matus\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003eNgôn ngữ: Tiếng Việt\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e \u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003eĐã bao giờ các bạn nhỏ gặp phải tình huống bạn bè, người thân ho ốm hay bản thân phải vật lộn cùng cơn đau bụng khi vắng mặt bố mẹ?\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003eDù bạn nhỏ tò mò về công việc của bác sĩ hay muốn tự chăm sóc bản thân, giúp đỡ mọi người, cuốn sách này sẽ hỗ trợ ít nhiều. Làm sao để xì mũi đúng cách? Viêm amidan có được ăn kem không? Bị lây chấy phải làm gì? Tại sao cần uống đủ nước? Xử trí nhiệt miệng thế nào?\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003eHơn hết, Sổ tay bác sĩ nhí cung cấp những thông tin về các bệnh thường gặp, giúp độc giả nhí tự trang bị kiến thức để từ đó hiểu về cơ thể, chủ động hợp tác với bố mẹ và bác sĩ để cùng chăm sóc sức khoẻ. Xen kẽ thông tin khoa học là những minh hoạ hài hước, sinh động, cùng lối truyền tải đối thoại thân thiện, chắc chắn độc giả nhí sẽ không thể rời mắt khỏi cuốn sách dù chỉ một giây.\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e————————————————————\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003eThông tin về tác giả:\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003eŠtěpánka Sekaninová tốt nghiệp Khoa Nghệ thuật tại Đại học Masaryk, Cộng hoà Séc. Štěpánka Sekaninová hiện là biên tập viên ở Albatros Media – một nhà xuất bản lâu đời của Séc, đồng sáng lập Hội chợ sách trẻ em Bologna. Hiện tại cô là tác giả và đồng tác giả của hơn 60 đầu sách.\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e \u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003eMarta Matus tốt nghiệp chuyên ngành Minh họa tại Học viện Mĩ thuật và Thiết kế ở Bratislava (Slovakia) năm 2020. Cô sở hữu gia tài sách minh hoạ đồ sộ đến từ các nhà xuất bản khác nhau.\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e————————————————————\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003eQuy cách: bìa cứng bồi các tông chắc chắn, cán mờ, phủ spot UV. Ruột sách in trên giấy offset120 dày dặn, chống loá, thân thiện với mắt trẻ.\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e————————————————————\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003eTRANG ĐỌC THỬ:\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/11/9b/46/c7f951ce87e286bde51fdb740e505355.jpg\" alt=\"\" width=\"750\" height=\"475\" /\u003e\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/59/7c/12/f4e165a7c40c1e34628a5dd7ca27fbf5.jpg\" alt=\"\" width=\"750\" height=\"475\" /\u003e\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/17/50/5c/284f6ef4fd183697575d9f389e8223d0.jpg\" alt=\"\" width=\"750\" height=\"475\" /\u003e\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/37/d9/89/1f6b3703918725318bd17dd0e2bc8b81.jpg\" alt=\"\" width=\"750\" height=\"475\" /\u003e\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/db/51/76/4eedfff2aa20d1e1bf539af4052bf0ed.jpg\" alt=\"\" width=\"750\" height=\"475\" /\u003e\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/5f/98/23/02107f91be523d91b635c9b10aa7ef5b.jpg\" alt=\"\" width=\"750\" height=\"475\" /\u003e\u003c/p\u003e\n\u003cp class=\"_2jrvqA\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/b9/21/19/65b0d91a2cdbdb31ed4b1657220c7adb.jpg\" alt=\"\" width=\"750\" height=\"475\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/a0/37/1b/546ae2e6c927a9cdd87b5065f24e174d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a0/37/1b/546ae2e6c927a9cdd87b5065f24e174d.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a0/37/1b/546ae2e6c927a9cdd87b5065f24e174d.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a0/37/1b/546ae2e6c927a9cdd87b5065f24e174d.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a0/37/1b/546ae2e6c927a9cdd87b5065f24e174d.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/bb/dd/d1/1e5dbcc52ecbd7e5b249297714b742ef.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/bb/dd/d1/1e5dbcc52ecbd7e5b249297714b742ef.