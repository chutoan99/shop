l,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/06/28/a2/fd0bbe500b1a36689cf7441f6d603871.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":343,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003carticle class=\"4ever-article\"\u003e\n\u003cp\u003e\u003cstrong\u003eThông tin chi tiết sản phẩm\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e---------------\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCáp sạc nhanh Ba-se-us Tự Ngắt 20W Gen2 Ba-se-us Explorer Series Fast Charging Cable Smart Power-Off Type-C to Lai-nin 20W\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/e8/b0/d3/f0d4378aee7c5a3c24b9c9aa703562c9.jpg\" alt=\"\" width=\"600\" height=\"600\" /\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cdiv\u003eCông Nghệ Smart Power - OFF Thông Minh\u003c/div\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eMột trong những tính năng nổi bật của sản phẩm này là công nghệ điều khiển nhiệt thông minh, giúp giảm nhiệt độ của cáp sạc khi sạc các thiết bị của bạn, đảm bảo an toàn cho thiết bị và kéo dài tuổi thọ của sản phẩm. \u003c/p\u003e\n\u003cp\u003eNgoài ra sản phẩm còn được trang bị tính năng power off, hay còn gọi là chức năng tự động ngắt điện sau khi thiết bị đã được sạc đầy. Tính năng này có tác dụng giúp tiết kiệm điện năng và bảo vệ thiết bị của bạn khỏi nguy cơ quá tải điện và nhiệt độ cao.\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cdiv\u003eKhi thiết bị được sạc đầy, tính năng power off sẽ ngắt nguồn điện tự động, không cho phép dòng điện tiếp tục chảy vào thiết bị. Điều này giúp tránh tình trạng quá tải điện và giảm thiểu nguy cơ cháy nổ hoặc hỏng hóc do quá tải điện. Ngoài ra, tính năng này còn giúp tiết kiệm điện năng và kéo dài tuổi thọ của thiết bị sạc.\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv\u003eHỗ trợ sạc nhanh chuẩn PD (Power Delivery) chuẩn mới nhất với công suất lên đến 20W/27W, có thể tương tích cả chuẩn PD 18W trên Ai-phôn 11 Series trở về trước nhờ vào chip xử lý nguồn điện thông minh có thể nhận dạng được thiết bị để điều chỉnh nguồn điện ngỏ ra phù hợp.\u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003eThiết kế đẹp mắt, siêu bền\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e-Baseus Explorer Series Fast Charging Cable là một sản phẩm chất lượng được thiết kế để đáp ứng nhu cầu sạc nhanh và đáng tin cậy của người dùng. Cáp sạc này được làm từ các vật liệu chất lượng cao như dây cáp đồng tinned, bọc nhôm chống nhiễu, lớp vỏ bảo vệ bằng PC + Nylon, đầu nối bằng hợp kim nhôm cao cấp, giúp tăng độ bền của sản phẩm.\u003c/p\u003e\n\u003cdiv\u003eDây cũng hỗ trợ tốc độ truyền tải dữ liệu lên đến 480mbps.\u003c/div\u003e\n\u003cdiv\u003eGiám sát nhiệt độ liên tục theo đèn báo:\u003c/div\u003e\n\u003cdiv\u003eĐèn sáng báo nhiệt độ sạc bình thường\u003c/div\u003e\n\u003cp\u003eĐèn chớp chậm, liên tục sạc ở nhiệt độ cao\u003c/p\u003e\n\u003cp\u003eĐèn chớp nhanh liên tục và tắt, nhiệt độ sạc quá cao\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cdiv\u003eThông số kỹ thuật \u003c/div\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e- Thương hiệu: BA-SE-US \u003c/p\u003e\n\u003cp\u003e- Tên sản phẩm: Ba-se-us Explorer Series Fast Charging Cable Smart Power-Off with Smart Temperaturer Control Type-C to Lai-nin 20W\u003c/p\u003e\n\u003cp\u003e- Chất liệu: polycarbonate + nylon \u003c/p\u003e\n\u003cp\u003e- Đặc điểm: Có đèn báo LED \u003c/p\u003e\n\u003cp\u003e- Công suất: 20W (9V / 2.22A) \u003c/p\u003e\n\u003cp\u003e- Tốc độ truyền: 480Mbps \u003c/p\u003e\n\u003cp\u003e- Giao diện đầu vào: Type-C \u003c/p\u003e\n\u003cp\u003e- Giao diện đầu ra: dành cho IP \u003c/p\u003e\n\u003cp\u003e- Chiều dài: 1m, 2m \u003c/p\u003e\n\u003cp\u003e- Màu sắc: Trắng, xanh, tím, hồng\u003c/p\u003e\n\u003cp\u003e- Khả năng: \u003c/p\u003e\n\u003cp\u003e+ 20W PD sạc nhanh: 13/12/12Mini, 12 Pro/Pro Max \u003c/p\u003e\n\u003cp\u003e+ 18W sạc nhanh: SE2, 11/PRO/PRO Max, Xs/XS Max, X/XR, 8/8 Plus \u003c/p\u003e\n\u003cp\u003eSạc bình thường: Pad 8/10.2 inch, Pro 12.9 inch, Pro 10.5 inch, Air3 10.5 inch, Mini5 7.9 inch \u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cdiv\u003eNote: - Sạc nhanh lên đến 27W nếu sử dụng củ sạc nhanh Ba-se-us 30W PD. \u003c/div\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cdiv\u003eSau \u0026gt;30 phút mới kích hoạt ngắt dòng điện. \u003c/div\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eBảo hành 12 tháng 1 đổi mới (Vui lòng giữ lại vỏ hộp sản phẩm để được hỗ trợ tốt nhất)\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/e8/b0/d3/9d42fa2f4f5c595e76f0b95d374e0d26.jpg\" alt=\"\" width=\"600\" height=\"600\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/de/f2/1a/a898cfdec3a6947ab2b59414bc7658b3.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/ts/tmp/79/db/87/0a99c3464eb87cbcdb0bba494ac4642e.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg title=\"\" src=\"https://salt.tikicdn.com/