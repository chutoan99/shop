ic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":40000,"discount_rate":14,"rating_average":4.8,"review_count":48,"review_text":"(48)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/media/catalog/producttmp/93/0e/a6/1eaa3c06aee2f6f20e409228819d766c.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2001,"all_time_quantity_sold":360,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/10/91/2b/d44a5ca1e2124319390b2000586308a8.jpg\" alt=\"\" width=\"750\" height=\"499\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"font-family: Lato; text-align: left;\"\u003eXịt khử mùi Etiaxil Déodorant Anti-Transpirant 48h đích thực là khắc tinh của mùi cơ thể. Cảm giác ẩm ướt và mùi khó chịu sẽ tan biến hoàn toàn ngay từ lần đầu tiên sử dụng sản phẩm. Điểm cộng cho sản phẩm là khả năng khử mùi cơ thể đến 48 tiếng đồng hồ cho bạn tha hồ tung tăng.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cspan style=\"font-family: Lato; text-align: left;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/eb/70/91/5ce1f549ab4445b83fd1dafb303af4f8.jpg\" alt=\"\" width=\"750\" height=\"562\" /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003ch3 style=\"text-align: justify;\"\u003e\u003cstrong\u003e\u003cspan style=\"font-family: Lato; text-align: left;\"\u003eĐặc tính nổi bật:\u003c/span\u003e\u003c/strong\u003e\u003c/h3\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"font-family: Lato; text-align: left;\"\u003e\u003cspan style=\"white-space: pre-wrap;\"\u003e- Cảm giác ẩm ướt và mùi khó chịu sẽ tan biến hoàn toàn ngay từ lần đầu tiên sử dụng. Điểm cộng cho sản phẩm là khả năng khử mùi đến 48 tiếng đồng hồ cho bạn tha hồ tung tăng. - Muối nhôm Aluminum Sesquichlorohydrate là thành phần chính của sản phẩm. Thành phần có tác dụng làm chậm lại quá trình tiết mồ hôi và kháng khuẩn cực kỳ hiệu quả. Theo nghiên cứu của các chuyên gia thì thành phần hóa học này không làm ảnh hưởng tới sức khỏe. Nên các bạn sử dụng sản phẩm vô tư nhé. - Mùi hương tươi mát, nhẹ nhàng. Có khả năng lưu hương dài lâu, khử mùi hôi, mang lại cho bạn cảm giác tươi mới suốt cả ngày. - Thiết kế chai vỏ nhôm chắc chắn, gọn nhẹ nên rất tiện mang theo mà không sợ vướng víu khi bạn hoạt động ngoài trời hoặc đi du lịch. - Sản phẩm không chứa paraben và cồn nên rất an toàn cho da. Đặc biệt là công thức sản phẩm không gây ố vàng áo hoặc vớ chân nhé!\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cspan style=\"font-family: Lato; text-align: left;\"\u003e\u003cspan style=\"white-space: pre-wrap;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/b4/75/18/49705c6b16ea014caa42e190d2f5392d.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"font-family: Lato; text-align: left;\"\u003e\u003cspan style=\"white-space: pre-wrap;\"\u003e\u003cspan style=\"font-style: italic; font-weight: bold; white-space: normal;\"\u003eXịt