_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.8,"review_count":5,"review_text":"(5)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/59/87/83/e688233f2ee0f2ebf80668841528cfa6.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":468,"all_time_quantity_sold":32,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<h1><em><strong>Giới thiệu Bộ 9 chìa lục giác 1.5mm - 10mm đa năng TOTAL THT106191</strong></em></h1>\n<p><em><strong>Bộ 9 chìa lục giác 1.5mm - 10mm đa năng TOTAL THT106191</strong></em> là một bộ dụng cụ cơ khí chuyên dùng để tháo lắp ốc lục giác có kích thước từ 1.5 - 10 mm</p>\n<p><em><strong>Bộ 9 chìa lục giác 1.5mm - 10mm đa năng TOTAL THT106191</strong></em> nhỏ gọn và dễ dàng bỏ túi mang theo bất cứ đâu</p>\n<p> </p>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/67/79/d5/6677c210d7d3e2c2e51a1c7e4839d243.jpg?v=1685505286732\" alt=\"tht106191-nd1.jpg?v=1685505286732\" /></p>\n<h2> </h2>\n<h2><strong>Thông tin sản phẩm</strong></h2>\n<ul><li>Tên sản phẩm: <em><strong>Bộ 9 chìa lục giác 1.5mm - 10mm đa năng TOTAL THT106191</strong></em></li>\n<li>Mã hàng: <em><strong>THT106191</strong></em></li>\n<li>Công dụng: vặn ốc lục giác</li>\n<li><em><strong>Thương hiệu: TOTAL</strong></em></li>\n<li><strong>Xuất xứ: Trung Quốc</strong></li>\n</ul><p> </p>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/7f/fa/98/6e542256181f6f6d084d667a72814cf6.jpg?v=1685505296217\" alt=\"tht106191-nd2.jpg?v=1685505296217\" /></p>\n<h2> </h2>\n<h2><strong>Thông số kỹ thuật</strong></h2>\n<ul><li>Bộ 8 chìa lục giác kích thước từ 1.5mm - 9mm</li>\n<li>Được xử lý nhiệt cao cấp giúp sản phẩm thêm bền và đẹp</li>\n</ul><p> </p>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/8f/a2/b6/e6fe52090ecdfe8c96df19ab98d84688.jpg?v=1685505303506\" alt=\"tht106191-nd3.jpg?v=1685505303506\" /></p>\n<h2> </h2>\n<h2><strong>Thông tin nổi bật</strong></h2>\n<ul><li>\n<p><strong>Chất liệu chất lượng: </strong>Bộ chìa lục giác TOTAL được làm từ chất liệu thép hợp kim chất lượng cao, đảm bảo độ bền và độ cứng của chìa lục giác. Chất liệu này cho phép bạn sử dụng chìa lục giác trong thời gian dài mà không bị biến dạng hay gãy.</p>\n</li>\n<li>\n<p><strong>Bộ chìa đa kích cỡ: </strong>Bộ chìa lục giác này bao gồm 8 kích cỡ khác nhau, từ 1.5mm đến 10mm. Điều này cho phép bạn thực hiện các công việc với nhiều loại bu lông và ốc vít có kích cỡ khác nhau.</p>\n</li>\n<li>\n<p><strong>Đầu chìa lục giác chính xác: </strong>Các đầu chìa lục giác trong bộ này được thiết kế chính xác để khớp hoàn hảo với các bu lông và ốc vít tương ứng. Điều này giúp tránh trơn trượt và giữ chặt bu lông một cách an toàn và hiệu quả.</p>\n</li>\n<li>\n<p><strong>Tiện lợi và dễ sử dụng:</strong> Mỗi chìa lục giác trong bộ có một đầu hình trụ, giúp bạn dễ dàng sử dụng và vặn chặt bu lông và ốc vít. Kích thước nhỏ gọn và thiết kế tay cầm thuận tiện cho việc cầm nắm và vặn nhanh chóng.</p>\n</li>\n<li>\n<p><strong>Sử dụng đa năng: </strong>Bộ chìa lục giác TOTAL 1.5mm - 10mm thích hợp cho nhiều ngành công nghiệp, bao gồm cơ khí, ô tô, xe máy, điện tử và nhiều ứng dụng khác. Bạn có thể sử dụng nó trong các công việc sửa chữa, lắp ráp hoặc bảo dưỡng các máy móc và thiết bị.</p>\n</li>\n<li>\n<p><strong>Bảo quản dễ dàng: </strong>Bộ chìa lục giác này thường đi kèm với hộp đựng tiện lợi để bảo quản chìa lục giác và ngăn chúng khỏi bị mất hoặc hư hỏng.</p>\n</li>\n</ul><p> </p>\n<p><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/f0/03/5f/c0eb5fe774596f3c51c26db70e7aa601.jpg?v=1685505314800\" alt=\"tht106191-nd4.jpg?v=1685505314800\" /></p>\n<h2> </h2>\n<h2><strong>Hướng dẫn sử dụng</strong></h2>\n<ul><li>Vui lòng đọc kỹ hướng dẫn sử dụng kèm theo sản phẩm</li>\n</ul><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/59/87/83/e688233f2ee0f2ebf80668841528cfa6.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/59/87/83/e688233f2ee0f2ebf80668841528cfa6.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/59/87/83/e688233f2ee0f2ebf80668841528cfa6.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/59/87/83/e688233f2ee0f2ebf80668841528cfa6.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/59/87/83/e688233f2ee0f2ebf80668841528cfa6.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/83/57/76/7de29348226f6e7d4c990149eac66efe.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/83/57/76/7de29348226f6e7d4c990149eac66efe.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/83/57/76/7de29348226f6e7d4c990149eac66efe.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/83/57/76/7de29348226f6e7d4c990149eac66efe.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/83/57/76/7de29348226f6e7d4c990149eac66efe.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/0a/d7/93/070d9