urite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/c6/17/b3/1ec0bcbfce2c55430235cdcca19429bf.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1952,"all_time_quantity_sold":51,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cdiv style=\"box-sizing: border-box; color: #777777; font-family: Lato, sans-serif; font-size: medium;\" data-blogger-escaped-style=\"text-align: justify;\"\u003e\n\u003cp style=\"box-sizing: border-box; margin-bottom: 1.3em; margin-top: 0px;\"\u003eChuông gió hay còn được gọi là phong linh. Gia chủ sử dụng chuông gió làm đẹp cho không gian và là sự lựa chọn khá phổ biến của nhiều gia đình. Với  thiết kế nhỏ xinh chuông gió tạo nên nét chấm phá, điểm nhấn giúp không gian trở nên thu hút, ấn tượng. Không những thế, ẩn sau vẻ đẹp đó chuông gió còn có ý nghĩa phong thủy sâu sắc.\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin-bottom: 1.3em; margin-top: 0px;\"\u003eViệc sử dụng chuông gió có ý nghĩa mang lại tài lộc, may mắn cho gia chủ. Theo phong thủy, chuông gió có thể hóa giải vận hạn, biến hung thành cát. Chuông gió phù hợp với mọi tuổi và có thể được trang trí ở mọi không gian như gia đình, phòng làm việc, công sở. Chuông gió gốm sứ bát tràng là lựa chọn thông minh cho không gian nhà. Ngoài ra chuông gió còn được nhiều nhà chùa treo, bày trong các khu sảnh thờ, chiếu nghỉ tạo vẻ thanh tịnh,..\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin-bottom: 1.3em; margin-top: 0px;\"\u003eChuông gió có thể làm từ nhiều chất liệu khác nhau như kim loại, thủy tinh… Tuy nhiên theo quan niệm của người Việt sử dụng chuông gió gốm sứ là cách “chơi” đúng nhất với văn hóa truyền thống của người Việt.\u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv style=\"box-sizing: border-box; color: #777777; font-family: Lato, sans-serif; font-size: medium;\" data-blogger-escaped-style=\"text-align: justify;\"\u003e\n\u003cp style=\"box-sizing: border-box; margin-bottom: 1.3em; margin-top: 0px;\"\u003eCó nhiều mẫu chuông gió phù hợp với gia chủ như: chuông gió đơn 1 nón 1 chuông; chuông gió 1 nón to 6 nón nhỏ, chuông gió 1 nón to và 9 nón nhỏ, Chuông gió đại 1 nón to và 10 nón nhỏ.\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin-bottom: 1.3em; margin-top: 0px;\"\u003eChuông quả cũng có nhiều mẫu quả như chuông nón phù hợp theo nhu cầu và sở thích của gia chủ.\u003c/p\u003e\n\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/c6/17/b3/1ec0bcbfce2c55430235cdcca19429bf.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c6/17/b3/1ec0bcbfce2c55430235cdcca19429bf.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c6/17/b3/1ec0bcbfce2c55430235cdcca19429bf.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c6/17/b3/1ec0bcbfce2c55430235cdcca19429bf.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c6/17/b3/1ec0bcbfce2c55430235cdcca19429bf.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/91/c1/01/b780f1b4f7eb5fdf8584940983e04cd8.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/91/c1/01/b780f1b4f7eb5fdf8584940983e04cd8.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/91/c1/01/b780f1b4f7eb5fdf8584940983e04cd8.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/t