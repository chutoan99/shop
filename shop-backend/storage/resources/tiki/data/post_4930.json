_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":76000,"discount_rate":40,"rating_average":4.6,"review_count":334,"review_text":"(334)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ee/56/c4/de1a8da050cf82caf18028cb7a68ac76.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1716,"all_time_quantity_sold":3278,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eTHÔNG TIN SẢN PHẨM BỘT CẦN TÂY:\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight:400;\"\u003e- Khối lượng: 72g (24 gói x 3g).\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e- Thành phần: 100% nguyên chất từ rau cần tây tươi.\u003c/p\u003e\n\u003cp\u003e- Xuất xứ: Việt Nam.\u003c/p\u003e\n\u003cp\u003e- NSX và HSD: Xem trên bao bì (18 tháng kể từ ngày sản xuất).\u003c/p\u003e\n\u003cp\u003eLưu ý: Không sử dụng sản phẩm đã hết hạn. Sản phẩm này không phải là thuốc và không có tác dụng thay thế thuốc chữa bệnh.\u003c/p\u003e\n\u003cp\u003eBảo quản: Nơi khô ráo, thoáng mát. Tránh ánh nắng trực tiếp.\u003c/p\u003e\n\u003cp\u003e--------------------------------------------------------------\u003c/p\u003e\n\u003cp\u003eHƯỚNG DẪN SỬ DỤNG BỘT CẦN TÂY:\u003c/p\u003e\n\u003cp\u003e- Cho gói bột cần tây (3g) vào 60ml - 85ml nước ấm (có thể gia giảm lượng nước theo ý thích). Khuấy đều và thưởng thức.\u003c/p\u003e\n\u003cp\u003eCó thể cho thêm đường vào để dễ uống và ngon hơn.\u003c/p\u003e\n\u003cp\u003e- Ngoài ra, bột cần tây còn dùng trong các món trộn, soup, canh, sữa chua, dùng đắp mặt... và nhiều công thức khác.\u003c/p\u003e\n\u003cp\u003e--------------------------------------------------------------\u003c/p\u003e\n\u003cp\u003eCÔNG DỤNG CỦA BỘT CẦN TÂY:\u003c/p\u003e\n\u003cp\u003e- Detox cơ thể - giảm cân – giảm mỡ bụng.\u003c/p\u003e\n\u003cp\u003e- Giúp hỗ trợ ổn định huyết áp, tốt cho người bị huyết áp cao.\u003c/p\u003e\n\u003cp\u003e- Giúp tăng cường hệ miễn dịch.\u003c/p\u003e\n\u003cp\u003e- Giúp trẻ hóa làn da.\u003c/p\u003e\n\u003cp\u003e- Giảm Cholesterol xấu giúp tim mạch khỏe mạnh.\u003c/p\u003e\n\u003cp\u003e- Lợi tiểu, kháng viêm.\u003c/p\u003e\n\u003cp\u003e- Ngăn ngừa bệnh ung thư.\u003c/p\u003e\n\u003cp\u003e-------------------------------------------------------------\u003c/p\u003e\n\u003cp\u003eƯU ĐIỂM SẢN PHẨM:\u003c/p\u003e\n\u003cp\u003e- Nguồn nguyên liệu thiên nhiên được tuyển chọn khắt khe.\u003c/p\u003e\n\u003cp\u003e- Nguyên chất 100% từ rau cần tây tươi.\u003c/p\u003e\n\u003cp\u003e- Cam kết: Không sử dụng chất bảo quản – Không phụ gia – An toàn cho người sử dụng\u003c/p\u003e\n\u003cp\u003e- Bột có độ mịn cao 120 – 150 mesh\u003c/p\u003e\n\u003cp\u003e- Sản phẩm đạt tiêu chuẩn an toàn quốc tế ISO 22000:2018 và VSATTP, đã được xuất khẩu đi nhiều nước khó tính: Úc, Mỹ, Hàn Quốc, Nhật Bản, Đức, Hong Kong, Singapore…\u003c/p\u003e\n\u003cp\u003e- Hệ thống máy móc sản xuất hiện đại giúp giữ trọn thành phần dinh dưỡng từ rau cần tây.\u003c/p\u003e\n\u003cp\u003e- Đóng gói túi nhỏ tiện dụng cho mỗi lần sử dụng.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ee/56/c4/de1a8da050cf82caf18028cb7a68ac76.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ee/56/c4/de1a8d