ground_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/a7/61/de/9822bdfb11022562ae0751e143667b7e.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1183,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch5\u003e\u003cstrong\u003e\u003ciframe src=\"//www.youtube.com/embed/WEK6TmX3Z7o\" width=\"560\" height=\"314\" allowfullscreen=\"\"\u003e\u003c/iframe\u003e\u003c/strong\u003e\u003c/h5\u003e\n\u003ch3\u003eGiới thiệu\u003c/h3\u003e\n\u003cp\u003e\u003cstrong\u003eMáy Tiệt Trùng Sấy Khô Bình Sữa PHILIPS AVENT Bottle Steriliser and Dryer SCF293/00\u003c/strong\u003e không những tiệt trùng bình sữa nhanh chóng và hợp vệ sinh, tiêu diệt 99,9% các loại vi trùng mà còn phun ra luồng khí sạch để sấy khô bình sữa trước khi tắt. Tiệt trùng và sấy khô trong 40 phút để mẹ luôn an tâm bình sữa thật sự vệ sinh và sẵn sàng cho bé bú cữ sữa tiếp theo. \u003c/p\u003e\n\u003cp\u003eMáy tiệt trùng thế hệ mới của Philips Avent có thể đặt ở mọi nơi, có thể giảm kích thước bằng cách dùng khay chứa các vật dụng có kích thước nhỏ (núm ty, ty ngậ) và chiếm ít không gian mặt bếp khi không sử dụng.\u003c/p\u003e\n\u003cp\u003eMáy được thiết kế liền khối giúp cho việc vệ sinh máy dễ dàng, nhanh gọn, để bạn có nhiều thời gian chơi với bé hơn.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/79/dd/ec/feffa840da08cb548355609f74e48b13.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch3\u003eĐặc điểm nổi bật\u003c/h3\u003e\n\u003cp\u003e\u003cstrong\u003eAn toàn vượt trội\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cspan style=\"color:#333300;\"\u003eCông nghệ \u003cstrong\u003etiệt trùng bằng hơi nước\u003c/strong\u003e giúp \u003cstrong\u003etiệt trùng đến 99.9% vi khuẩn gây hại\u003c/strong\u003e cho bé, chỉ với 1 chu trình \u003cstrong\u003etriệt trùng trong 10 phút\u003c/strong\u003e\u003c/span\u003e\u003c/li\u003e\n\u003cli\u003e\u003cspan style=\"color:#333300;\"\u003eTính năng sấy khô giúp \u003cstrong\u003esấy khô bình sữa và phụ kiện\u003c/strong\u003e trong khoang với chu trình làm việc \u003cstrong\u003etrong 30 phút\u003c/strong\u003e.\u003c/span\u003e\u003c/li\u003e\n\u003cli\u003e\u003cspan style=\"color:#333300;\"\u003eChức năng \u003cstrong\u003etiệt trùng và sấy khô\u003c/strong\u003e có thể hoạt động \u003cstrong\u003eđộc lập\u003c/strong\u003e bằng cách xoay nút điều khiển sang trái hoặc sang phải, hoặc kết hợp cả 2 chu trình thông qua chương trình \u003cstrong\u003etiệt trùng sấy khô tự động kéo dài trong 40 phút\u003c/strong\u003e.\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cspan style=\"color:#333300;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/a2/cb/f5/0afac09074e197e71d5b419bb75ef3f3.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cspan style=\"color:#333300;\"\u003eGiữ bình sữa và phụ kiện ở chế độ \u003cstrong\u003evô trùng trong 24h\u003c/strong\u003e sau khi kết thúc chu trình tiệt trùng, trong điều kiện nắp được đậy kín\u003c/span\u003e\u003c/li\u003e\n\u003cli\u003e\u003cspan style=\"color:#333300;\"\u003eTự động ngắt điện sau khi kết thúc mội chu trình hoạt động\u003c/span\u003e\u003c/li\u003e\n\u003cli\u003e\u003cspan style=\"color:#333300;\"\u003e\u003cstrong\u003eĐã kiểm nghiệm lâm sàn và được chứng nhận tuyệt đối an toàn\u003c/strong\u003e cho trẻ\u003c/span\u003e\u003c/li\u003e\n\u003cli\u003e\u003cspan style=\"color:#333300;\"\u003e\u003cstrong\u003eKHÔNG\u003c/strong\u003e chứa\u003cstrong\u003e BPA\u003c/strong\u003e, \u003cstrong\u003eBPS\u003c/strong\u003e,\u003cstrong\u003e Latex\u003c/strong\u003e và \u003cstrong\u003eSulphur Nitrosamine\u003c/strong\u003e\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cspan style=\"color:#333300;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/70/c0/ac/788c4535c76268123c02ea2380338592.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThiết Kế Sang Trọng, Tiện Lợi\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cspan style=\"color:#333300;\"\u003e2 khoang chứa với khả năng tiệt trùng bằng hơi nước và sấy khô cùng lúc 6 bình sữa cổ rộng và phụ kiện (núm ty, ty ngậm, phụ kiện hút sữa của mẹ)\u003c/span\u003e\u003c/li\u003e\n\u003cli\u003e\u003cspan style=\"color:#333300;\"\u003e2 khoang chứa có khả năng hoạt động độc lập hoặc kết hợp tùy nhu cầu sử dụng của ba mẹ\u003c/span\u003e\u003c/li\u003e\n\u003cli\u003e\u003cspan style=\"color:#333300;\"\u003ePhong cách kiểu dáng thiết kế tối giản không chiếm dụng diện tích, đem lại sự tiện lợi tối đa cho người sử dụng, mà vẫn giữ được sự sang trọng nổi tiếng vốn thấy của thương hiệu Philips Avent\u003c/span\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cspan style=\"color:#333300;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/e3/fa/6e/6fe9a7451b5d3d142130c34bf1354c0a.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003ch3\u003eThông số kỹ thuật\u003c/h3\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/d0/28/c5/2254a7d818dbe0b273494102b832a2f0.PNG\" alt=\"\" width=\"750\" height=\"608\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/a7/61/de/9822bdfb11022562ae0751e143667b7e.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a7/61/de/9822bdfb11022562ae0751e143667b7e.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a7/61/de/9822bdfb11022562ae0751e143667b7e.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a7/61/de/9822bdfb11022562ae0751e143667b7e.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a7/61/de/9822bdfb11022562ae0751e143667b7e.png"},{"base_url":"https://salt.tikicdn.com/ts/product/0f/04/53/688a5dab7a69cbec265c0ab98c58991f.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0f/04/53/688a5dab7a69cbec265c0ab98c58991f.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/0f/04/53/688a5dab7a69cbec265c0ab98c58991f.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0f/04/53/688a5dab7a69cbec265c0ab98c58991f.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0f/04/53/688a5dab7a69cbec265c0ab98c58991f.png"},{"base_url":"https://salt.tikicdn.com/ts/product/2a/dd/6a/625af44341ecdc5a6374ac8ce04903ba.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/2a/dd/6a/625af44341ecdc5a6374ac8ce04903ba.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/2a/dd/6a/625af44341ecdc5a6374ac8ce04903ba.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2a/dd/6a/625af44341ecdc5a6374ac8ce04903ba.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/2a/dd/6a/625af44341ecdc5a6374ac8ce04903ba.png"},{"base_url":"https://salt.tikicdn.com/ts/product/d