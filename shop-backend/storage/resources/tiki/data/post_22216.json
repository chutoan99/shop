iew_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/4c/b8/0c/de18c2301b0f53d2c3ba9ff8c0bdaaa1.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1149,"all_time_quantity_sold":10,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003chtml\u003e\n \u003chead\u003e\u003c/head\u003e\n \u003cbody\u003e\n  \u003cul\u003e\n   \u003cp\u003eTác giả: Dr. Joseph Murphy\u003c/p\u003e\n   \u003cp\u003eNgày xuất bản: 2019\u003c/p\u003e\n   \u003cp\u003eKích thước: 16 x 24 cm\u003c/p\u003e\n   \u003cp\u003eNhà xuất bản: NXB Tổng hợp \u003c/p\u003e\n   \u003cp\u003eSố trang: 272\u003c/p\u003e\n   \u003cp\u003eGía Bìa: 158.000VNĐ\u003c/p\u003e\n   \u003cp\u003eMô tả sản phẩm:\u003c/p\u003e\n   \u003cp\u003eLà một trong những quyển sách về nghệ thuật sống nhận được nhiều lời ngợi khen và bán chạy nhất mọi thời đại, Sức Mạnh Tiềm Thức đã giúp hàng triệu độc giả trên thế giới đạt được những mục tiêu quan trọng trong đời chỉ bằng một cách đơn giản là thay đổi tư duy.\u003c/p\u003e\n   \u003cp\u003eSức Mạnh Tiềm Thức giới thiệu và giải thích các phương pháp tập trung tâm thức nhằm xoá bỏ những rào cản tiềm thức đã ngăn chúng ta đạt được những điều mình mong muốn.\u003c/p\u003e\n   \u003cp\u003eJoseph Murphy (1898 – 1981) là Tiến sĩ Tâm lý học, Tác giả và diễn giả người Mỹ gốc Ireland. Các bài diễn thuyết và tác phẩm của ông đã thay đổi nhận thức của hàng triệu người trên thế giới, giúp họ nhìn nhận được sức mạnh bên trong của bản thân để có cuộc sống tốt đẹp và ý nghĩa như mong muốn.\u003c/p\u003e\n   \u003cp\u003eTác phẩm Sức Mạnh Tiềm Thức – The Power Of Your Subconscious Mind đã trở thành một trong những cuốn sách về nghệ thuật sống hay nhất và bán chạy nhất mọi thời đại. First News mới tái bản tác phẩm này theo phiên bản bìa cứng tuyệt đẹp, xứng đáng làm quà tặng và có mặt trên những kệ sách giá trị.\u003c/p\u003e\n  \u003c/ul\u003e\n \u003c/body\u003e\n\u003c/html\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/4c/b8/0c/de18c2301b0f53d2c3ba9ff8c0bdaaa1.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/4c/b8/0c/de18c2301b0f53d2c3ba9ff8c0bdaaa1.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/4c/b8/0c/de18c2301b0f53d2c3ba9ff8c0bdaaa1.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4c/b8/0c/de18c2301b0f53d2c3ba9ff8c0bdaaa1.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4c/b8/0c/de18c2301b0f53d2c3ba9ff8c0bdaaa1.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/89/8b/82/39140254d7ffab67a20e1bf894d83b57.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/89/8b/82/39140254d7ffab67a20e1bf894d83b57.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/89/8b/82/39140254d7ffab67a20e1bf894d83b57.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/89/8b/82/39140254d7ffab67a20e1bf894d83b57.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/89/8b/82/39140254d7ffab67a20e1bf894d83b57.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/d1/3b/82/c4ea977e197d4a267057373a425b9d5d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d1/3b/82/c4ea977e197d4a267057373a425b9d5d.jpg","medium_url":"https://salt.tikicdn.