r":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":5000,"discount_rate":2,"rating_average":5,"review_count":8,"review_text":"(8)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/8c/a7/dd/6f73ee63e631e13d5ac7d08cb1e10876.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":971,"all_time_quantity_sold":35,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003ePhiên bản PRO mới ra mắt 2022 với công nghệ màu Fluid độc quyền, sánh ngang với công nghệ Philip Hue vốn có giá thị trường đắt hơn gấp 2-3 lần.\u003c/p\u003e\n\u003cp\u003eLưu ý: Hộp 1m nối dài chưa bao gồm adapter nên không sử dụng được riêng biệt, cần mua bộ 2m gồm adapter để sử dụng\u003c/p\u003e\n\u003cp\u003e█ ĐẶC ĐIỂM NỔI BẬT\u003cbr /\u003e Yeelight Lightstrip Plus 1s được trang bị các bóng đèn lắp đặt bên trong 1 dây nhựa PU dạng dẹt nối dài. Thiết kế dây PU dẹt như vậy sẽ giúp người dùng dễ dàng tạo hình, lắp đặt dây đèn vào nhiều vị trí khác nhau, dễ dàng uống cong linh hoạt mà ko sợ đứt dây\u003cbr /\u003e Ngoài ra, Đèn LED Lightstrip Plus 1s thông minh còn được trang bị khả năng điều chỉnh màu sắc vô cùng linh hoạt theo từng chế độ màu sắc khác nhau qua công tắc với thao tác nhấn giữ. Công nghệ đèn LED mới giúp tăng tuổi thọ các bóng đèn, hiệu quả chiếu sáng cao và đặc biệt là vô cùng tiết kiệm điện\u003cbr /\u003e Đèn còn hỗ trợ điều khiển thông minh qua App được cài đặt trên Smartphone để điều chỉnh các thông số màu sắc, hẹn giờ tắt mở với app Mihome từ Xiaomi\u003cbr /\u003e Điểm đặc biệt của phiên bản Lightstrip Plus 1s lần này, đó là việc trang bị thêm đầu nối mở rộng. Với đầu nối mở rộng, người dùng hoàn toàn có thể mở rộng chiều dài của dây LED lên đến 10m một cách đơn giản, nhờ gói mở rộng 1m được trang bị\u003c/p\u003e\n\u003cp\u003e█ THÔNG SỐ CHI TIẾT:\u003cbr /\u003e=\u0026gt;\u0026gt;\u0026gt; Version Plus/1S:\u003cbr /\u003eĐiện áp đầu vào đầu vào: 100-240V~50/60Hz 0.09A (2m); 100-240V~50/60Hz 0.3A (10m)\u003cbr /\u003eCông suất định mức: 7.5W (2m); 26.6W (10m)\u003cbr /\u003eKết nối không dây: Wi-Fi IEEE 802.11 b/g/n 2.4GHz\u003cbr /\u003eNền tảng hỗ trợ: Android4.4 \u0026amp; iOS 10.0 trở lên\u003cbr /\u003eMàu ánh sáng: màu RGB\u003cbr /\u003e=\u0026gt;\u0026gt;\u0026gt; New 2022 Pro version:\u003cbr /\u003e1. Full box 2m gồm nguồn: YLDD005 \u003cbr /\u003eCông suất định mức: 5.1W (2m); 21W (10m)\u003cbr /\u003e2. Dải nối dài 1m: YLDD007\u003cbr /\u003eĐầu vào định mức: 24V\u003c/p\u003e\n\u003cp\u003e=\u0026gt;\u0026gt;\u0026gt; Nhiều kịch bản khác nhau phù hợp với tâm trạng của bạn\u003cbr /\u003eLightstrip Pro cung cấp nhiều công thức sử dụng cho nhiều kịch bản khác nhau như: mặt trời mọc, hoàng hôn, hẹn hò đêm, chiếu phim, bữa tiệc sinh nhật, lãng mạn, đèn flash thông báo, nến lung linh, …. Chỉ một cảm ứng đơn giản, Lightstrip Pro sẽ chọn cho bạn 1 hoàn cảnh phù hợp nhất với tâm trạng.\u003c/p\u003e\n\u003cp\u003e=\u0026gt;\u0026gt;\u0026gt; Công nghệ màu Fluid độc quyền là điểm cải tiến nổi bật nhất ở phiên bản Pro này\u003cbr /\u003eDải LED Pro có một chip IC tích hợp, có thể hiển thị đồng thời các màu RGB khác nhau trong cùng một dải cùng 1 thời điểm để khắc họa những khoảnh khắc riêng và góp phần làm không gian thêm sống động, dễ dàng sync với màn hình tivi/máy tính, đổi màu theo âm nhạc, đặc biệt tích hợp với Razer Chroma khiến trải nghiệm chơi game nhập vai hơ\u003c/p\u003e\n\u003cp\u003e=\u0026gt;\u0026gt;\u0026gt; Nhiều phương thức điều khiển thông minh\u003cbr /\u003eĐèn LED dây Yeelight Lightstrip Pro còn hỗ trợ điều khiển thông minh qua các nền tảng trợ lý ảo (Google Home/Alexa) hoặc App Yeelight/Mihome để điều chỉnh các thông số màu sắc, hẹn giờ tắt mở, đặc biệt đã có thể tích hợp với Apple Homekit…\u003c/p\u003e\n\u003cp\u003e#yeelight #xiaomi #dentran #denled #denledday #dentha #denbanan #dentrangtri #denoptran #denngu #rgb #philiphue #applehomekit #lightstrip\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/8c/a7/dd/6f73ee63e631e13d5ac7d08cb1e10876.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/8c/a7/dd/6f73ee63e631e13d5ac7d08cb1e10876.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/8c/a7/dd/6f73ee63e631e13d5ac7d08cb1e10876.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8c/a7/dd/6f73ee63e631e13d5ac7d08cb1e10876.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8c/a7/dd/6f73ee63e631e13d5ac7d08cb1e10876.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/4f/c4/d9/09f6eec71241a60a4e61defc2b7d6c15.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/4f/c4/d9/09f6eec71241a60a4e61defc2b7d6c15.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/4f/c4/d9/09f6eec71241a60a4e61defc2b7d6c15.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/4f/c4/d9/09f6eec71241a60a4e61defc2b7d6c15.jpg","thumbnail_url":"https://salt.tikicdn.com/