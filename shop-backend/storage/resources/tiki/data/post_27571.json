ki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e\u003cp\u003eSản phẩm này là tài sản cá nhân được bán bởi Nhà Bán Hàng Cá Nhân và không thuộc đối tượng phải chịu thuế GTGT. Do đó hoá đơn VAT không được cung cấp trong trường hợp này.\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/be/42/37/4647d2476194170cb05f37eb420375af.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/be/42/37/4647d2476194170cb05f37eb420375af.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/be/42/37/4647d2476194170cb05f37eb420375af.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/be/42/37/4647d2476194170cb05f37eb420375af.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/be/42/37/4647d2476194170cb05f37eb420375af.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/ec/c5/88/b136e9bb9cd98e5dcb52ad47063ec03e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ec/c5/88/b136e9bb9cd98e5dcb52ad47063ec03e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ec/c5/88/b136e9bb9cd98e5dcb52ad47063ec03e.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ec/c5/88/b136e9bb9cd98e5dcb52ad47063ec03e.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ec/c5/88/b136e9bb9cd98e5dcb52ad47063ec03e.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/48/0b/62/cdad004c73ee9f0511e293eb5a32f9f2.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/48/0b/62/cdad004c73ee9f0511e293eb5a32f9f2.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/48/0b/62/cdad004c73ee9f0511e293eb5a32