ll,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":3.8,"review_count":32,"review_text":"(32)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/8a/21/ee/f880d1e7cb5953c92cb973fbe8caf492.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1216,"all_time_quantity_sold":88,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eBạn là một người quan tâm đến sức khỏe và công việc nấu ăn trong gia đình. Bạn muốn lựa chọn cho mình một chiếc thùng đựng gạo đủ chất lượng , đảm bảo an toàn về thời gian cũng như chất lương để gạo ngon không bị nấm mốc, mọt. Hôm nay Shop xin giới thiệu đến các bạn sản phẩm Thùng đựng gạo thông minh. Nó sẽ giúp dễ dàng trong quá trình bảo quản và nấu ăn - giúp người nội trợ tiết kiệm được nhiều thời gian và công sức.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eThùng đựng gạo thông minh là một thiết kế hoàn hảo đối với người sử dụng. Gạo cần lấy mỗi khi sử dụng sẽ được cho xuống cốc đựng phía dưới, rất thuận lợi trong việc tính toán số gạo cần sử dụng\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/36/1a/88/c347aa20c7f89aa1cabaea9c88d97ec4.jpg\" alt=\"\" width=\"720\" height=\"720\" /\u003e\u003c/p\u003e\n\u003cp\u003eLấy gạo tuần hoàn theo nguyên lý vào trước ra trước, giúp cho gạo trong thùng luôn mới (sẽ không còn tình trạng gạo cũ đọng lại dưới đáy thùng). Với thùng đựng gạo này, bạn chỉ cần nhấn nút là có đủ lượng gạo cho cả gia đình dùng, giúp bạn yên tâm sử dụng kể cả khi tay đang ướt.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eĐặc điểm nổi bật của thùng đựng gạo thông minh:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eThiết kế sang trọng, hiện đại.\u003c/li\u003e\n\u003cli\u003eChất liệu ABS và PP cao cấp.\u003c/li\u003e\n\u003cli\u003eLấy gạo bằng 1 nút ấn.\u003c/li\u003e\n\u003cli\u003eCốc vo gạo tích hợp thước đo tiện lợi.\u003c/li\u003e\n\u003cli\u003eNắp đậy chắc chắn chống côn trùng và ẩm mốc.\u003c/li\u003e\n\u003cli\u003eThiết kế kín đáo và an toàn, giúp bảo vệ gạo không bị chuột, kiến, mối, gián,… xâm nhập.\u003c/li\u003e\n\u003cli\u003eSức chứa lên đến 12Kg cho bạn thoải mái đựng gạo với số lượng lớn.\u003cbr /\u003e\u003cbr /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/5e/68/a9/c6ca5d729a137c992322870e8023ac51.jpg\" alt=\"\" width=\"720\" height=\"720\" /\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eSản phẩm có kích thước vừa phải, đựng được 12kg gạo, dễ sắp đặt gọn gàng trong bếp, bên dưới kệ bếp,… giúp không gian bếp nhà bạn luôn ngăn nắp và cũng tiện cho việc lấy gạo nấu cơm hàng ngày.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/bc/57/90/18e95bc81be78454cee17c94a4eb7b1a.PNG\" alt=\"\" width=\"629\" height=\"405\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/64/52/57/c9120a15fcf99883f4c3aef72669f1c6.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCốc vo gạo thiết kế thông minh, lỗ thoát nước, vạch chia số lượng gạo cần lấy\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThông tin sản phẩm:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eChất liệu nhựa ABS và PP cao cấp\u003c/li\u003e\n\u003cli\u003eKích thước 41x17x34 cm\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/be/b1/44/8c4ce0122861bb7a85c5f3bc265fd096.PNG\" alt=\"\" width=\"711\" height=\"923\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/54/88/c9/617ae371cd0b20de5b45caaf83326aa2.PNG\" alt=\"\" width=\"614\" height=\"746\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/8a/21/ee/f880d1e7cb5953c92cb973fbe8caf492.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/8a/21/ee/f880d1e7cb5953c92cb973fbe8caf492.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/8a/21/ee/f880d1e7cb5953c92cb973fbe8caf492.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8a/21/ee/f880d1e7cb5953c92cb973fbe8caf492.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8a/21/ee/f880d1e7cb5953c92cb973fbe8caf492.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/bf/4a/d2/ed306737f075fa454cb36f59cada7a76.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/bf/4a/d2/ed306737f075fa454cb36f59cada7a76.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/bf/4a/d2/ed306737f075fa454cb36f59cada7a76.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/bf/4a/d2/ed306737f075fa454cb36f59cada7a76.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/bf/4a/d2/ed306737f075fa454cb36f59cada