/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":47000,"discount_rate":11,"rating_average":4.8,"review_count":35,"review_text":"(35)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/c2/d6/bd/5cf44c6c422fa59fcc3d5260a225fb05.png","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":876,"all_time_quantity_sold":146,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eBALO DU LỊCH BỀN BỈ, CHẮC CHẮN HASUN HÀNG XUẤT KHẨU\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/7e/a9/7b/6c2b76a56cae8ea42a5489abf97f4d3b.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eNhiều ngăn tiện dụng để đựng các đồ đạc phục vụ cho chuyến đi\u003cbr /\u003eQuai đeo có lớp mút đệm chống được đau vai\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/46/bb/e0/55fd41f8b086a1613b708ed90547831b.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eBalo Xuất Khẩu Hasun HXK 003 với chất liệu vải dù chống thấm cao cấp có khả năng chống thấm nước cực tốt, chống bám bụi và không độc hại cho người sử dụng.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/82/4f/cd/c69af8d7acbdc73d0bfa0ae3d59f9aaa.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eThiết kế: Tinh tế, nhiều ngăn tiện dụng để đựng các đồ đạc phục vụ cho chuyến đi. Cách phối màu hòa hợp, không gây rối mắt, nêu bật được điểm nhấn của sản phẩm. Kiểu dáng thể thao, mạnh mẽ dễ phối hợp cùng các trang phục khác nhau để mang lại sự đa dạng trong phong cách chính là điểm mạnh của sản phẩm này.\u003c/p\u003e\n\u003cp\u003eMặt trước của balo có thêu tên thương hiệu, tăng thêm giá trị cho sản phẩm.\u003c/p\u003e\n\u003cp\u003eQuai đeo: Có lớp mút đệm chống được đau vai, phần dây đeo có thể thâu nới dễ dàng phù hợp kích thước người sử dụng.\u003c/p\u003e\n\u003cp\u003eDây kéo: Rất chắc chắn, mượt êm với các răng đều khít, đầu khóa kéo nhựa dẻo siêu bền.\u003c/p\u003e\n\u003cp\u003eĐường may: Sử dụng loại chỉ dù chuyên dùng may balo nên đường chỉ may rất chắc chắn.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/c2/d6/bd/5cf44c6c422fa59fcc3d5260a225fb05.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c2/d6/bd/5cf44c6c422fa59fcc3d5260a225fb05.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c2/d6/bd/5cf44c6c422fa59fcc3d5260a225fb05.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c2/d6/bd/5cf44c6c422fa59fcc3d5260a225fb05.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c2/d6/bd/5cf44c6c422fa59fcc3d5260a225fb05.png"},{"base_url":"https://salt.tikicdn.com/ts/product/1c/9b/e9/18413b75911de16caf1412fb81c990ec.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/1c/9b/e9/18413b75911de16caf1412fb81c990ec.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/1c/9b/e9/18413b75911de16caf1412fb81c990ec.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/20