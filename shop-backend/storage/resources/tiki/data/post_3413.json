6.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":6000,"discount_rate":4,"rating_average":3,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/90/0f/9f/52f6c8bfe43070e6896a60c2bf6a93e6.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1744,"all_time_quantity_sold":18,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eLoa Bluetooth Cầm Tay Mini GUTEK BS-01 Vỏ Kim Loại, Nghe Nhạc Cực Hay, Hỗ Trợ Kết Nối Thẻ Nhớ Tf Và Cổng 3.5\u003c/p\u003e\n\u003cp\u003eGIỚI THIỆU VỀ LOA BLUETOOTH MINI GUTEK BS-01\u003c/p\u003e\n\u003cp\u003e- Loa Bluetooth Mini GUTEK BS-01 Vỏ Kim Loại là dòng loa có vẻ ngoài cực kì đẹp, vỏ kim loại sáng nổi bật, nhỏ bằng lòng bàn tay của bạn với công suất loa 5w nhưng âm thanh mang đến lại hay không kém những dòng loa cỡ lớn đắt tiền.\u003c/p\u003e\n\u003cp\u003e- Loa Bluetooth Cầm Tay GUTEK BS-01 Vỏ Kim Loại được trang bị công nghệ truyền tải âm thanh qua bluetooth trong khoảng cách 10m với kết nối đơn giản.\u003c/p\u003e\n\u003cp\u003e- Loa Bluetooth Không Dây GUTEK BS-01 Vỏ Kim Loại sở hữu vẻ ngoài nhỏ nhắn, thiết kế sang trọng, tinh tế mà bạn có thể dễ dàng mang theo bên mình mọi lúc mọi nơi. Bạn có thể nghe trong nhà, đi làm, đi du lịch,\u003c/p\u003e\n\u003cp\u003e- Thời gian phát nhạc của loa bluetooth mini GUTEK BS-01 vỏ kim loại lên đến 5 giờ giúp bạn có thể thỏa thích tận hưởng trọn vẹn những phút giây thư giãn của mình.\u003c/p\u003e\n\u003cp\u003e- Đặc biệt, loa nghe nhạc mini GUTEK BS-01 còn mang đến chất lượng âm bass hay, bạn thỏai mái nghe những bài nhạc bass, nhạc sôi động với chất lượng tốt.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTHÔNG SỐ KỸ THUẬT LOA BLUETOOTH MINI BS-01:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eTên sản phẩm:GUTEK BS-01\u003c/p\u003e\n\u003cp\u003eCổng kết nối: AUX, bluetooth, thẻ nhớ.\u003c/p\u003e\n\u003cp\u003eKhoảng cách: khoảng 10m\u003c/p\u003e\n\u003cp\u003eTương thích: laptop, điện thoại, máy tính bảng\u003c/p\u003e\n\u003cp\u003eCông suất: 3W RMS Nguồn: adapter\u003c/p\u003e\n\u003cp\u003eDung lượng pin: khoảng 3-5 giờ ( mở lớn hay nhỏ)\u003c/p\u003e\n\u003cp\u003ePhụ kiện: Cáp Micro USB.\u003c/p\u003e\n\u003cp\u003eMàu sắc: Đa dạng\u003c/p\u003e\n\u003cp\u003eThiết kế tinh tế, không chỉ được thu hút bởi vẻ ngoài sang trọng, trông giống như đồ trang điểm của phái nữ, cánh mày râu cũng không thể cưỡng lại vẻ lịch lãm của GUTEK BS-01, đặt cạnh chiếc laptop của bạn, đúng là sự kết hợp tuyệt vời.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/90/0f/9f/52f6c8bfe43070e6896a60c2bf6a93e6.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/90/0f/9f/52f6c8bfe43070e6896a60c2bf6a93e6.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/90/0f/9f/52f6c8bfe43070e6896a60c2bf6a93e6.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9