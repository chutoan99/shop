596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":8,"review_text":"(8)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/28/76/3f/2e541b25d5b6c2cde9ae3feba69e6308.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1360,"all_time_quantity_sold":44,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<h3>Giới Thiệu</h3>\n<ul>\n<li>Máy hâm sữa và tiệt trùng Fatzbaby Mono 7 FB3010TN có bộ điều khiển điện tử KTS và điều chỉnh nhiệt độ chính xác từng con số. Đặc biệt máy hâm sữa Fatzbaby Mono 7 FB3010TN có đế đun có lớp bảo vệ hỗ trợ chống chập điện, vệ sinh dễ dàng, tiện lợi. Ngoài ra, máy còn có kèm theo nắp đậy hỗ trợ mẹ tiệt trùng bình sữa nhanh chóng và hiệu quả</li>\n</ul>\n<h3>Thiết Kế &amp; Công Dụng</h3>\n<div class=\"page\" title=\"Page 13\">\n<div class=\"section\">\n<div class=\"layoutArea\">\n<div class=\"column\">\n<ul>\n<li>Lớp phủ bảo vệ đế đun nóng • Dễ dàng vệ sinh • Chống thấm • Chống mài mòn • Ngăn cặn bám và ngăn ngừa chập mạch.</li>\n<li>Màn hình điều khiển có đèn LED với những nút chạm.  Khoảng nhiệt độ điều chỉnh : từ 25 độ C đến 90 độ C.</li>\n<li>Tích hợp 4 chức năng: HÂM SỮA/RÃ ĐÔNG/HẤM THỨC ĂN/TIỆT TRÙNG.</li>\n</ul>\n</div>\n</div>\n</div>\n</div>\n<h3>Đặc Điểm Nổi Bật</h3>\n<ul>\n<li>Đây là  một trong nhưng tính năng cải tiến đối với 1 máy hâm sữa, lý do việc sử dụng thường xuyên khi đun nóng nước ở nhiệt độ cao sẽ khiến cho đế  máy bị tích tụ và bám cặn. Lớp cặn này nếu không được vệ sinh nó sẽ càng dày lên và làm giảm hiệu suẩt sử dụng của máy. Đồng thời làm tăng khả năng chập điện và giảm tuổi thọ. Chính vì vậy nhờ có lớp bảo vệ, máy hâm sữa Mono 6 giúp cho việc tiệt trùng thực hiện dễ dàng hơn và không làm giảm tuổi thọ của máy như với các máy hâm sữa thông thường khác.</li>\n<li>Máy FB3010TN- Mono 7 có thiết kế nhỏ nhắn nhưng được tích hợp đến 4 chức năng tiện lợi:</li>\n<li>Với khả năng canh chỉnh nhiệt độ và thời gian chuẩn xác, FB3010TN- Mono 7 là trợ thủ đắc lực giúp mẹ hâm nóng thức ăn cho bé trong tích tắc mà vẫn đảm bảo sữa không bị mất chất.</li>\n</ul>\n<div><strong>Thời gian /Nhiệt độ:</strong></div>\n<ul>\n<li>Rã đông sữa (25oC-40oC) : trong vòng 6 – 10 phút</li>\n<li>Hâm sữa (37<sup>o</sup>C- 60<sup>o</sup>C): trong vòng 6 – 10 phút</li>\n<li>Hâm thức ăn (60<sup>o</sup>C- 90<sup>o</sup>C): trong vòng 10 – 20 phút</li>\n<li>Tiệt trùng  (100<sup>o</sup>C): trong vòng 10 (tương ứng với 40 ml nước)</li>\n<li><strong>Tiết kiện chi phí điện năng: </strong>Máy FB3010TN- Mono 7 áp dụng công nghệ hâm nóng và giữ ấm PTC tiết kiệm tối đa chi phí điện năng, mẹ có thể an tâm sử dụng.</li>\n<li><strong>Thích hợp cho tất cả các loại bình sữa:</strong> Mẹ không còn phải đắn đo khi mua bình sữa cho mé khi sở hữu Mono 7, khoang hâm đủ rộng để mẹ đặt bất cứ 1 chiếc bình sữa nào mà mẹ mua trên thị trường.</li>\n<li><strong>Có nắp đậy đi kèm để giữ nhiệt tốt hơn: </strong>vì nắp đậy giữ hơi nước nằm lại trong máy nên việc có nắp đậy sẽ rút ngắn thời gian tiệt trùng xuống còn 10 phút đồng thời việc hâm sữa cũng hiệu quả hơn khi mẹ dùng chiếc nắp này.</li>\n<li>Thiết kế hiện đại, thời trang và trang nhã.</li>\n<li>Tự động ngắt khi hết nước.</li>\n</ul>\n<div>\n<div><strong>Cơ Chế Giữ Ấm</strong></div>\n<ul>\n<li>Máy sẽ tự động làm nóng nước đến 40<sup>o</sup>C rồi tự động ngắt. Quá trình trao đổi nhiệt làm giảm nhiệt độ của nước và làm tăng nhiệt độ của sữa. Khi nước nguội đi, máy sẽ tiếp tục đun nóng nước để đạt 40<sup>o</sup>C, rồi tự động ngắt. Quá trình này diễn ra liên tục cho đến khi sữa đạt nhiệt độ 40<sup>o</sup>C.</li>\n</ul>\n</div>\n<h3><strong>Lưu Ý Sử Dụng</strong></h3>\n<ul>\n<li>Trước khi cắm điện cho máy, cần đảm bảo núm điều khiển đã ở vị trí “OFF”</li>\n<li>Để đảm bảo độ bền của máy, không nên đổ nước quá 110ml</li>\n<li>Để máy xa tầm với của trẻ để đảm bảo an toàn</li>\n<li>Vệ sinh máy sau mỗi lần sử dụng</li>\n<li>Luôn để máy tại nơi thoáng mát</li>\n<li>Không sử dụng sản phẩm với mục đích khác ngoài hâm và giữ ấm sữa/ thức ăn</li>\n<li>Sau khi sử dụng xoay núm điều khiển về “OFF” và rút dây điện.</li>\n</ul>\n<div><strong>Thông Số Kỹ Thuật</strong></div>\n<ul>\n<li>Nguồn điện: AC 220V-240 V, 50/60 Hz; Công suất : 180 W;</li>\n<li>Khối lượng: 0.46kg</li>\n<li>Kích thước: 28 x 11 x 11 cm\n<div> </div>\n</li>\n<li><iframe src=\"https://www.youtube.com/embed/aanNdz0cNzY\" width=\"650\" height=\"365\" frameborder=\"0\" allowfullscreen=\"\"></iframe></li>\n<li>\n<div class=\"page\" title=\"Page 13\">\n<div class=\"section\">\n<div class=\"layoutArea\">\n<div class=\"column\">\n<div><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/8a/25/70/0e4ce86e116355347073fcd3e9fce4fd.jpg\" alt=\"\" width=\"750\" height=\"416\" />​</div>\n<div> </div>\n</div>\n</div>\n</div>\n</div>\n<div> </div>\n<div> </div>\n<div><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/18/51/f6/1165bea28a9f039da5d3220c1f271279.jpg\" alt=\"\" /></div>\n<div> </div>\n<div><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/91/4f/be/35c403ebfe3aefc08c81cf131a839300.jpg\" alt=\"\" /></div>\n<div> </div>\n<div><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/a0/d1/2c/373b0ce5c214b61fcbaede5767fe8ed8.jpg\" alt=\"\" /></div>\n<div> </div>\n<div><img src=\"https://salt.tikicdn.com/cache/w750/ts/product/25/fa/d3/f6e52888f776e75404d4fd78c58be575.jpg\" alt=\"\" /></div>\n<div> </div>\n<div class=\"page\" title=\"Page 16\">\n<div class=\"lay