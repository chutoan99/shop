ground_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":50000,"discount_rate":51,"rating_average":4.7,"review_count":67,"review_text":"(67)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/25/d6/af/fc3c5f1bc6375b91028cd93b4e4a8732.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1625,"all_time_quantity_sold":583,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p class=\"irIKAp\"><strong>***Túi đựng dụng cụ Sakos 01: BẢO QUẢN ĐỒ DÙNG - DỄ DÀNG THAO TÁC***</strong></p>\n<p class=\"irIKAp\">Túi đựng dụng cụ thích hợp cất giữ đồ các món đồ nhỏ gọn, tránh thất lạc hay mất nhiều thời gian tìm kiếm. Thiết kế nhỏ gọn với chất liệu trượt nước cao cấp, kiểu dáng tối giản hiện đại, túi dụng cụ 01 là phụ kiện không thể thiếu cho học sinh, dân công sở.</p>\n<p class=\"irIKAp\"><strong>1. THÔNG SỐ CỦA SẢN PHẨM</strong></p>\n<p class=\"irIKAp\">- Thương hiệu: Sakos</p>\n<p class=\"irIKAp\">- Màu sắc: Đen, Xanh đen, Đỏ, </p>\n<p class=\"irIKAp\">- Chất liệu: Nylon, Polyester, EVA, PE</p>\n<p class=\"irIKAp\">- Trọng lượng: 0.06 kg</p>\n<p class=\"irIKAp\">- Kích thước RxSxC: 22x9x9 cm</p>\n<p class=\"irIKAp\">- Tải trọng tối đa: 1 kg</p>\n<p class=\"irIKAp\">- Bảo hành chính hãng: 30 ngày</p>\n<p class=\"irIKAp\"><strong>2. CHI TIẾT SẢN PHẨM</strong></p>\n<p class=\"irIKAp\">Thiết kế nhỏ gọn, tiện lợi cất trong balo hoặc cặp xách</p>\n<p class=\"irIKAp\">- Kích thước nhỏ gọn, tiện lợi cho vào balo hoặc cặp sách và mang đi bất cứ nơi đâu.</p>\n<p class=\"irIKAp\">- Màu đơn sắc hiện đại, logo Sakos ở vị trị trung tâm khẳng định chất lượng sản phẩm tiêu chuẩn Mỹ.</p>\n<p class=\"irIKAp\">- Một ngăn chính lớn bên trong dễ dàng tao tác, tìm kiếm đồ dùng mà không mất nhiều thời gian.</p>\n<p class=\"irIKAp\">Chất liệu trượt nước, dễ dàng vệ sinh</p>\n<p class=\"irIKAp\">- Chất liệu polyster trượt nước, không bị phai màu, dễ dàng vệ sinh.</p>\n<p class=\"irIKAp\">- Khung túi được làm từ sợi nhựa PE tạo viền khung chắc chắn.</p>\n<p class=\"irIKAp\">- Vải mềm mịn, sáng màu, an toàn, không gây kích ứng da tay.</p>\n<p class=\"irIKAp\"> </p>\n<p class=\"irIKAp\">Bảo quản đồ dùng gọn gàng, cất – lấy nhanh chóng</p>\n<p class=\"irIKAp\">- Với trọng lượng chỉ 0.06 kg, kích thước Rộng x Sâu x Cao tương ứng 29x9x9 cm tha hồ mang theo bút mực, bút chì, cục tẩy, bút dạ… dễ dàng cất – lấy, tránh thất lạc và không mất nhiều thời gian.</p>\n<p class=\"irIKAp\">- Khóa kéo nhựa dẻo êm mượt dù sau thời gian sử dụng lâu.</p>\n<p class=\"irIKAp\">- Đường chỉ may tinh xảo, mang đến sự chắc chắn, bền bỉ.</p>\n<p class=\"irIKAp\"><strong>3. SAKOS CAM KẾT VỚI KHÁCH HÀNG</strong></p>\n<p class=\"irIKAp\">- 1 ĐỔI 1 trong vòng 07 ngày sản phẩm bị lỗi do nhà sản xuất (nhắn tin cho Shop để được hỗ trợ nhanh nhất).</p>\n<p class=\"irIKAp\">- BẢO HÀNH chính hãng theo chính sách của Sakos.</p>\n<p class=\"irIKAp\"><strong>4. DỊCH VỤ CỦA SAKOS</strong></p>\n<p class=\"irIKAp\">- Gói hàng cẩn thận trước khi giao cho khách.</p>\n<p class=\"irIKAp\">- Hỗ trợ tư vấn chăm sóc khách hàng 24/7 (khách iu ơi! Nhắn cho Sakos ngay nhé)</p>\n<p class=\"irIKAp\"><strong>___KHÁCH HÀNG B2B - QUÀ TẶNG DOANH NGHIỆP VUI LÒNG NHẮN TIN CHO SHOP ĐỂ ĐƯỢC HỖ TRỢ MỨC TỐT NHẤT___</strong></p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/25/d6/af/fc3c5f1bc6375b91028cd93b4e4a8732.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/25/d6/af/fc3c5f1bc6375b91028cd93b4e4a8732.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/25/d6/af/fc3c5f1bc6375b91028cd93b4e4a8732.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/25/d6/af/fc3c5f1bc6375b91028cd93b4e4a8732.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/25/d6/af/fc3c5f1bc6375b91028cd93b4e4a8732.png"},{"base_url":"https://salt.tikicdn.com/ts/product/5b/7b/f8/3198201abc2698d4fc5780a70b5c0840.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/5b/7b/f8/3198201abc2698d4fc5780a70b5c0840.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/5b/7b/f8/3198201abc2698d4fc5780a70b5c0840.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5b/7b/f8/3198201abc2698d4fc5780a70b5c0840.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5b/7b/f8/3198201abc2698d4fc5780a70b5c0840.png"},{"base_url":"https://salt.tikicdn.com/ts/product/86/89/1d/09aa0c5b20fa00fe86e99e8c92daa1f9.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/86/89/1d/09aa0c5b20fa00fe86e99e8c92daa1f9.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/86/89/1d/09aa0c5b20fa00fe86e99e8c92daa1f9.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/86/89/1d/09aa0c5b20fa00fe86e99e8c92daa1f9.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/86/89/1d/09aa0c5b20fa00fe86e99e8c92daa1f9.png"},{"base_url":"https://salt.tikicdn.com/ts/product/3c/4