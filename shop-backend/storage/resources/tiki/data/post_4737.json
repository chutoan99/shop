,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.8,"review_count":11,"review_text":"(11)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/2e/be/e2/313e65b5d5301c5a740bf01f7ae6d68f.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":706,"all_time_quantity_sold":127,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align:center;\"\u003e\u003cem\u003e\u003cstrong\u003eGhế Gác Chân Văn Phòng Công Thái Học Ergonomic Footrest KUNBE Điều Chỉnh 6 Mức Chiều Cao Massage Chân Bản Cao Cấp\u003c/strong\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003eNgồi một chỗ làm việc, học tập trong thời gian dài? Bạn nhất định cần kê chân công thái học.\u003c/p\u003e\n\u003cp\u003eĐể dưới bàn và gác chân lên, bạn sẽ cảm thấy thoải mái hơn bao giờ hết, nâng cao hiệu suất làm việc!\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://cf.shopee.vn/file/90b1455d12806664de762f59d3da7ef3\" alt=\"90b1455d12806664de762f59d3da7ef3\" width=\"750\" height=\"1000\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e1. THÔNG TIN CHI TIẾT SẢN PHẨM\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Tên gọi sản phẩm: Ghế kê chân công thái học\u003c/p\u003e\n\u003cp\u003e- Chất liệu: Được làm từ hạt nhựa HIPS cao cấp không chất độc hại, cứng cáp chịu lực từ đôi chân trong thời gian dài mà không có vấn đề gì\u003c/p\u003e\n\u003cp\u003e- Diện tích bề mặt mát xa chân lớn (45.7cm x 33cm) với các hạt tròn nổi massage giảm stress, phù hợp sử dụng nơi công sở lẫn ở nhà\u003c/p\u003e\n\u003cp\u003e- Bề mặt chống trượt giữ vững bất cứ loại giày, tất hay chân trần\u003c/p\u003e\n\u003cp\u003e- Kích thước: 42*31*20 cm\u003c/p\u003e\n\u003cp\u003e- Quy cách đóng gói: Các chi tiết của ghế được tháo dời để thuận tiện cho việc vận chuyển\u003c/p\u003e\n\u003cp\u003e- Lắp đặt đơn giản, dễ dàng sử dụng\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://cf.shopee.vn/file/sg-11134202-22100-glxai93qo8hv89\" alt=\"sg-11134202-22100-glxai93qo8hv89\" width=\"750\" height=\"748\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e2. ƯU ĐIỂM SẢN PHẨM\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Giảm đau lưng khi ngồi lâu\u003c/p\u003e\n\u003cp\u003e- Ghế kê gác chân dưới gầm bàn mang lại cảm giác làm việc thoải mái, nâng cao hiệu suất công việc lâu dài.\u003c/p\u003e\n\u003cp\u003e- Bề mặt để chân rộng, rắn chắc và cứng cáp.\u003c/p\u003e\n\u003cp\u003e- 6 mức điều chỉnh độ cao, phù hợp mọi tư thế gác chân và mọi lứa tuổi sử dụng.\u003c/p\u003e\n\u003cp\u003e- Lớp hạt nhỏ vừa có tác dụng massage chân, vừa tăng cường khả năng bám giữ chân chắc chắn khi ngồi.\u003c/p\u003e\n\u003cp\u003e- Hạt lớn có tác dụng massage mạnh mẽ hơn, giúp tinh phần phấn chấn, tươi vui.\u003c/p\u003e\n\u003cp\u003e- Lót chân đáy cao su, chống trượt hiệu quả.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://cf.shopee.vn/file/23585fca389498d565368a77ed03ebc5\" alt=\"23585fca389498d565368a77ed03ebc5\" width=\"750\" height=\"1181\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://cf.shopee.vn/file/sg-11134202-22100-sewasbgvo8hv7f\" alt=\"sg-11134202-22100-sewasbgvo8hv7f\" width=\"750\" height=\"1177\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e3. NHỮNG LỢI ÍCH TỪ VIỆC SỬ DỤNG GHẾ KÊ CHÂN\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e- Tư thế lưng thẳng, mắt nhìn thẳng, không bị mỏi cổ.\u003c/p\u003e\n\u003cp\u003e- Không tạo áp lực lên đùi, không gây đau mỏi cơ đùi.\u003c/p\u003e\n\u003cp\u003e- Chân cố định, không bị lơ lửng. Nếu chân lơ lửng, thường có xu hướng gây mỏi thắt lưng.\u003c/p\u003e\n\u003cp\u003e- Tư thế ngồi đúng, tạo áp lực nhẹ nhàng lên xương hông, xương cụt, tránh đau lưng khi hết giờ làm việc.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://cf.shopee.vn/file/sg-11134202-22100-9iqhunbto8hv5d\" alt=\"sg-11134202-22100-9iqhunbto8hv5d\" width=\"750\" height=\"1033\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://cf.shopee.vn/file/sg-11134202-22100-kgs3hjvvo8hv2e\" alt=\"sg-11134202-22100-kgs3hjvvo8hv2e\" width=\"750\" height=\"689\" /\u003e\u003c/p\u003e\n\u003cp\u003eLưu Ý:\u003c/p\u003e\n\u003cp\u003e- Do ánh sáng và cài đặt màn hình khác nhau, màu của sản phẩm có thể hơi khác so với hình ảnh.\u003c/p\u003e\n\u003cp\u003e- Xin vui lòng cho phép sai số kích thước của sản phẩm khác nhau do đo lường thủ công.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e#footrest #foot #rest #KeChan #GiaKeChan #VanPhong #GheLuoi\u003c/p\u003e\n\u003cp\u003e#GheCongThaiHoc #GheVanPhong #ErgonomicChair #Ghexoay #Ghekechan\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"ba