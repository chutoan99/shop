on_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":10000,"discount_rate":11,"rating_average":4.7,"review_count":758,"review_text":"(758)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/ab/ed/15/ca07cf4827814d43a3a10264734e2152.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1553,"all_time_quantity_sold":4191,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: center;\"\u003e\u003cstrong\u003e\u003ciframe src=\"//www.youtube.com/embed/GlNZrXQTl0Y\" width=\"560\" height=\"314\" allowfullscreen=\"allowfullscreen\"\u003e\u003c/iframe\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cstrong\u003eTrà Hoa Cúc Vàng Sấy Khô Nguyên Bông DK Harvest\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eHoa cúc\u003c/strong\u003e là cái tên quen thuộc mà ai cũng biết, được biết đến như một loại hoa để trang trí rất phổ biến nhưng ít ai biết được những công dụng khác của hoa cúc khô với sức khỏe. \u003cstrong\u003eTrà hoa cúc\u003c/strong\u003e sấy khô nguyên bông là một loại trà thảo mộc có nguồn gốc hoàn toàn từ thiên nhiên được làm từ chính những bông hoa cúc đẹp nhất, tốt nhất. Trà có tính mát, giúp thanh nhiệt và giải độc cho cơ thể rất hiệu quả, là loại trà rất phù hợp với những người bị thiếu ngủ, khó ngủ.\u003c/p\u003e\n\u003cp\u003e\u003cem\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/6a/1f/bb/3f098c678cebf34646d09ca16855e76a.jpg\" alt=\"Tra hoa cuc\" width=\"750\" height=\"1125\" /\u003e\u003c/em\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cem\u003eTrà hoa cúc vàng DK Harvest\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThành phần của trà hoa cúc\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eThành phần: Bông cúc sấy khô\u003c/li\u003e\n\u003cli\u003eNguồn gốc: Việt Nam\u003c/li\u003e\n\u003cli\u003eCông dụng: Ngủ ngon sâu giấc, sáng mắt, thanh nhiệt\u003c/li\u003e\n\u003cli\u003eMùi vị: Vị ngọt hơi đắng, hương thơm nhè nhẹ, dễ uống\u003c/li\u003e\n\u003cli\u003eBảo quản: Nơi thoáng mát, khô giáo\u003c/li\u003e\n\u003cli\u003eHạn sử dụng: Được in trực tiếp trên bao bì\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/dc/ae/32/cd9adf5f6eb440a0800f5e1b2e5dce53.jpg\" alt=\"\" width=\"750\" height=\"1125\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCÔNG DỤNG CỦA TRÀ HOA CÚC\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTrà hoa cúc\u003c/strong\u003e không chỉ vô cùng bổ dưỡng mà còn có tác dụng kháng khuẩn, điều trị cảm cúm, giảm mỡ trong máu và giúp giải tỏa căng thẳng một cách hiệu quả. Với y học ngày càng phát triển như hiện nay, trà hoa cúc được coi là một thức uống đầy tinh tế tốt cho sức khỏe. Trà hoa cúc có nguồn gốc hoàn toàn từ thiên nhiên được sản xuất ngay tại Việt Nam với nguyên liệu chính là \u003cstrong\u003ebông cúc mới hé nở\u003c/strong\u003e. \u003cstrong\u003eTrà hoa cúc khô\u003c/strong\u003e là loại dược liệu quý nhưng không khó tìm với nhiều tác dụng cực tốt cho sức khỏe (đặc biệt là người cao tuổi) như ngăn ngừa huyết áp cao, thanh lọc và thải độc cho cơ thể, đẹp da, sáng mắt…\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCÁCH SỬ DỤNG TRÀ HOA CÚC\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eBạn có thể sử dụng \u003cstrong\u003etrà hoa cúc nguyên bông\u003c/strong\u003e hàng ngày như một loại trà giúp tăng cường sức khỏe và chăm sóc da: Cho 4-5 \u003cstrong\u003ebông cúc khô\u003c/strong\u003e vào ấm trà, cho nước sôi trên 100 độ vào. Ngâm trong 2 phút sau đó đổ nước 1 đi. Tuỳ theo người dùng cho thêm mật ong hoặc đường phèn vào, sau đó cho thêm nước sôi vào sau 2 phút là có thể thưởng thức. Pha trà uống hàng ngày Trà hoa cúc hiện nay được sử dụng rộng rãi bởi những tác dụng quá tuyệt vời mà loại trà này mang lại cho sức khỏe con người. Vừa nhâm nhi, vừa thưởng thức, cảm nhận hương vị thơm ngọt của vị trà, vừa rất tốt cho sức khỏe.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/a5/b4/9f/c7b2d256a3ad5eb3970acfdae43f6289.jpg\" alt=\"\" width=\"750\" height=\"1125\" /\u003e\u003cbr /\u003e\u003cstrong\u003eHướng dẫn cách pha trà hoa cúc vàng sấy khô\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eCho 10-15 bông cúc khô vào 200ml nước sôi 100 độ vào. Ngâm trong 2 phút sau đó đổ nước 1 đi. Dùng từ nước 2.\u003c/p\u003e\n\u003cp\u003eLọc trà để bỏ bã hoa cúc và giữ lại nước trà.\u003c/p\u003e\n\u003cp\u003eTuỳ theo người dùng có thể cho thêm mật ong hoặc đường phèn để có thể thưởng thức.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eHƯỚNG DẪN BẢO QUẢN\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eĐể trà nơi khô ráo, tránh ẩm thấp hoặc nhiệt độ quá cao, tránh ánh nắng trực tiếp.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/ab/ed/15/ca07cf4827814d43a3a10264734e2152.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ab/ed/15/ca07cf4827814d43a3a10264734e2152.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ab/ed/15/ca07cf4827814d43a3a10264734e2152.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ab/ed/15/ca07cf4827814d43a3a10264734e2152.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ab/ed/15/ca07cf4827814d43a3a10264734e2152.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/ba/92/86/3cfc6cf3960df5522da5bd338b9664d0.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ba/92/86/3cfc6cf3960df5522da5bd338b9664d0.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ba/92/86/3cfc6cf3960df5522da5bd338b9664d0.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ba/92/86/3cfc6cf3960df5522da5bd338b9664d0.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ba/92/86/3cfc6cf3960df5522da5bd338b9664d0.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/43/6d/ae/60a49cdf04d6ce674f9621d56eb91b42.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/43/6d/ae/60a49cdf04d6ce674f9621d56eb91b42.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/43/6d/ae/60a49cdf04d6ce674f9621d56eb91b42.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/43/6d/ae/60a49cdf04d6ce674f9621d56eb91b42.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/43/6d/ae/60a49cdf04d6ce674f9621d56eb91b42.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/63/e6/be/545bae3c3cb589a83a8b07885