í vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/cf/1e/43/a6671a3837962e19bd94859abdba2108.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/cf/1e/43/a6671a3837962e19bd94859abdba2108.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/cf/1e/43/a6671a3837962e19bd94859abdba2108.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/cf/1e/43/a6671a3837962e19bd94859abdba2108.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/cf/1e/43/a6671a3837962e19bd94859abdba2108.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/b8/e4/3b/4854c85cbeb81d081d5054c5b3b2ad4e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b8/e4/3b/4854c85cbeb81d081d5054c5b3b2ad4e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b8/e4/3b/4854c85cbeb81d081d5054c5b3b2ad4e.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b8/e4/3b/4854c85cbeb81d081d5054c5b3b2ad4e.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b8/e4/3b/4854c85cbeb81d081d5054c5b3b2ad4e.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/b6/c0/f0/f3c8e9e13f143548996eb7d903e91eb9.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b6/c0/f0/f3c8e9e13f143548996eb7d903e91eb9.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b6/c0/f0/f3c8e9e13f143548996eb7d903e91eb9.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b6/c0/f0/f3c8e9e13f143548996eb7d903e91eb9.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b6/c0/f0/f3c8e9e13f143548996eb7d903e91eb9.jpg"}],"warranty_policy":null,"authors":[{"id":737,"name":"Adele Faber","slug":"adele-faber"},{"id":5090