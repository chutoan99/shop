text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/01/2c/a1/a5547a11af3d1e8c36f7a6cb45413c5b.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1107,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch2\u003eThiết kế nhỏ gọn\u003c/h2\u003e\n\u003cp\u003eThiết kế thân máy toàn bộ bằng thép không gỉ, bền và vững chắc kể cả khi thời gian sử dụng lâu dài. Bề ngang của máy rất mỏng, chưa đến 15cm vì vậy máy phù hợp với mọi không gian bếp hay văn phòng mà không hề chiếm diện tích.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/eb/d9/c1/fd6d23d4296ea19564ba2fea415c759c.jpg\" alt=\"\" width=\"750\" height=\"416\" /\u003e\u003c/p\u003e\n\u003ch2\u003e \u003c/h2\u003e\n\u003ch2\u003eChức năng tạo bọt Cappuccino bằng vòi đánh tay với nhiệt độ chuẩn\u003c/h2\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eMáy có 2 chế độ - Hot Milk (làm nóng sữa) hoặc Cappuccino (tạo bọt sữa) tích hợp bộ điều chỉnh cao cấp cho phép \u003cstrong\u003etùy chỉnh mức độ bọt và hơi nước\u003c/strong\u003e.\u003c/p\u003e\n\u003cp\u003eGiúp bạn pha chế 1 tách cappuccino hoàn hảo hay các thức uống ngon miệng khác mà không tốn nhiều công sức. Ngoài ra, bạn cũng có thể lấy nước sôi để pha trà hoặc làm ấm ly tách.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/b4/e0/37/0f340b6a43b8ca6467921774b66d5370.jpg\" alt=\"\" width=\"750\" height=\"416\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch2\u003eCông nghệ thermoblock giúp gia nhiệt chuẩn và làm nở cafe trước khi chiết xuất\u003c/h2\u003e\n\u003cp\u003eCông nghệ thermoblock \u003cstrong\u003eđun nóng nhanh và giữ nước ở nhiệt độ chính xác\u003c/strong\u003e cần thiết giúp bạn pha một ly espresso hoàn hảo. Hệ thống thermoblock được lập trình để chiết suất nước ngắt quãng 2 lần, lần đầu: ủ cà phê, lần 2: chiết suất cà phê. \u003c/p\u003e\n\u003cp\u003eVới áp suất chuyên nghiệp 15 bar tạo ra cốc espresso chất lượng với hương thơm ngây ngất và lớp kem cream màu hạt cà phê hấp dẫn trên bề mặt.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/54/8e/d1/5f128de54b3257a5674bf76abb5623f7.jpg\" alt=\"\" width=\"750\" height=\"416\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch2\u003eDung tích 1.1 lít cùng than đo mực nước sau lưng máy giúp dễ châm nước khi pha cà phê\u003c/h2\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/1f/ed/84/dab0c3193d598016eab4c0da5c603a4a.jpg\" alt=\"\" width=\"750\" height=\"416\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch2\u003eMáy pha cà phê điều khiển bằng nút nhấn, dễ thao tác khi pha cà phê\u003c/h2\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eBảng điều khiển trực quan bằng nút nhấn dễ dàng thao tác, tùy chỉnh 3 chức năng gồm: pha 1 ly, pha 2 ly, đánh hơi tạo bọt sữa. Ngoài ra máy còn có chức năng Auto Off:\u003cstrong\u003e tự động tắt nguồn và tiết kiệm điện năng\u003c/strong\u003e.\u003c/p\u003e\n\u003cp\u003eMáy pha cà phê bán tự động này cài đặt chế độ điều chỉnh pha 9 phút, 30 phút, 1 tiếng. Sau khi chiết xuất đủ lượng, máy sẽ \u003cstrong\u003etự động ngắt khi không dùng\u003c/strong\u003e.\u003c/p\u003e\n\u003cp\u003eChức năng dừng dòng chảy giữa chừng để máy dừng thêm nước bất kì lúc nào, cho phép \u003cstrong\u003eđiều chỉnh lượng nước hay độ đậm nhạt tùy ý\u003c/strong\u003e.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/66/45/26/1e4966c7b271e5c61f5591b8ffd4fce2.jpg\" alt=\"\" width=\"750\" height=\"419\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch2\u003eKhay nhỏ giọt có thể tháo rời, dễ vệ sinh, có thể sử dụng cốc và ly cao đến 12 cm\u003c/h2\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/b4/2d/ae/076c6937089f94d8e57e0d4d20457dcb.jpg\" alt=\"\" width=\"750\" height=\"419\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eHướng dẫn sử dụng máy Pha Cà Phê Delonghi EC785.BG\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e- \u003cstrong\u003eBước 1\u003c/strong\u003e: Lấy bình chứa nước ra khỏi máy, thêm nước sạch, lắp bình trở vào máy. \u003cbr /\u003e\u003cbr /\u003e\u003c/p\u003e\n\u003cp\u003e- \u003cstrong\u003eBước 2\u003c/strong\u003e: Kết nối nguồn điện, bật máy bằng cách nhấn vào nút nguồn, khi máy khởi động 3 nút trên bảng điều khiển sẽ nhấp nháy luân phiên nhau. Khi đèn 1 ly - 2 ly sáng ổn định thì máy đã sẵn sàng để sử dụng.\u003cbr /\u003e\u003cbr /\u003e\u003c/p\u003e\n\u003cp\u003e- \u003cstrong\u003eBước 3\u003c/strong\u003e: Đặt phin lọc đơn hay đôi vào tay cầm, cho cà phê bột vào phin lọc (muốn pha 1 cốc cà phê, dùng phin lọc với biểu tượng ở bên dưới là 1 cái muỗng, pha 2 cốc thì dùng phin lọc với biểu tượng 2 cái muỗng.\u003cbr /\u003e\u003cbr /\u003e\u003c/p\u003e\n\u003cp\u003e- \u003cstrong\u003eBước 4:\u003c/strong\u003e San bằng cà phê bột trong phin, nén cà phê bằng dụng cụ nén.\u003cbr /\u003e\u003cbr /\u003e\u003c/p\u003e\n\u003cp\u003e- \u003cstrong\u003eBước 5\u003c/strong\u003e: Gắn tay cầm vào máy đúng khớp, căn chỉnh tay cầm cùng biểu tượng “Insert”. Xoay nó về bên phải đến khi tay cầm căn chỉnh với biểu tượng “Close”.\u003cbr /\u003e\u003cbr /\u003e\u003c/p\u003e\n\u003cp\u003e- \u003cstrong\u003eBước 6:\u003c/strong\u003e Đặt tách Espresso bên dưới phin lọc.\u003cbr /\u003e\u003cbr /\u003e\u003c/p\u003e\n\u003cp\u003e- \u003cstrong\u003eBước 7\u003c/strong\u003e: Nhấn nút pha cà phê 1 ly hoặc 2 ly. Khi cà phê chiết xuất đủ lượng, máy sẽ tự ngừng.\u003cbr /\u003e\u003cbr /\u003e\u003c/p\u003e\n\u003cp\u003e-\u003cstrong\u003e Bước 8:\u003c/strong\u003e Sau khi máy ngắt, lấy tay cầm khỏi máy, bỏ bã cà phê, sẵn sàng làm cốc cà phê tiếp theo.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/01/2c/a1/a5547a11af3d1e8c36f7a6cb45413c5b.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/01/2c/a1/a5547a11af3d1e8c36f7a6cb45413c5b.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/01/2c/a1/a5547a11af3d1e8c36f7a6cb45413c5b.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/01/2c/a1/a5547a11af3d1e8c36f7a6cb45413c5b.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/01/2c/a1/a5547a11af3d1e8c36f7a6cb45413c5b.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/0b/f6/9b/f8ea43b9f1ebf9f2f1c2c88b04e9deb5.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/0b/f6/9b/f8ea43b9f1ebf9f2f1c2c88b04e9deb5.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/0b/f6/9b/f8ea43b9f1ebf9f2f1c2c88b04e9deb5.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0b/f6/9b/f8ea43b9f1ebf9f2f1c2c88b04e9deb5.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/0b/f6/9b/f8ea43b9f1ebf9f2f1c2c88b04e9deb5.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/19/6e/