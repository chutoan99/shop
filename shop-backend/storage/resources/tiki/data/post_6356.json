:50000,"discount_rate":33,"rating_average":4.8,"review_count":41,"review_text":"(41)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/8e/e2/5f/010e5e1d8bf5d0b5587876d9e8e99b7e.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":874,"all_time_quantity_sold":198,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eGIỚI THIỆU VỀ TÁC GIẢ:\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003e\u003cem\u003eHô Diên Vân là tác giả nổi tiếng chuyên viết truyện trinh thám. Anh được xem là một nhà văn có ảnh hưởng lớn đến tiểu thuyết phá án hình sự đương đại Trung Quốc. Tác phẩm của Hô Diên Vân đều rất logic, bố cục chặt chẽ, suy luận thuyết phục, nội dung hấp dẫn, đặc biệt là có tính sáng tạo cao. Mỗi một tác phẩm của anh đều để lại ấn tượng trong lòng độc giả với phong cách viết độc đáo, riêng biệt.\u003c/em\u003e \u003c/strong\u003e\u003c/p\u003e\n\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003eVề tác phẩm: Hung Trạch (trọn bộ 2 tập)\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003eVào một đêm mưa tầm tã, Đường Tiểu Đường - một cựu nhân viên pháp y, đột ngột mất tích. Kẻ bắt cóc đưa ra lời thách thức: trong mấy tiếng đồng hồ, cảnh sát phải khám xét hiện trường, phá giải những vụ án cũ trong ba căn hung trạch đã được dọn vệ sinh, bằng không hắn sẽ ế c.h.ế con tin!\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003eChạy đua từng phút từng giây, Lưu Tư Miễu dẫn theo Từ Nhiễm - cô gái may mắn sống sót trong vụ thảm án từng xảy ra ở Phong Chi Thự, để dấn sâu vào từng căn hung trạch âm u, truy tìm sự thật vốn bị thời gian chôn vùi.\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003eCùng lúc ấy, Lôi Dung - một chuyên gia pháp y, đến dự tiệc tối tại tòa Phong Chi Thự, nào ngờ trong đêm ấy lại có thêm người b.ỏ m.ạ\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003eNhững vụ án c.h.ế người kỳ lạ nối tiếp nhau, rốt cuộc do ma quỷ tác quái, hay là có kẻ cố tình ngụy tạo hung trạch?\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/8e/e2/5f/010e5e1d8bf5d0b5587876d9e8e99b7e.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/8e/e2/5f/010e5e1d8bf5d0b5587876d9e8e99b7e.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/8e/e2/5f/010e5e1d8bf5d0b5587876d9e8e99b7e.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8e/e2/5f/010e5e1d8bf5d0b5587876d9e8e99b7e.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8e/e2/5f/010e5e1d8bf5d0b5587876d9e8e99b7e.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/fc/54/39/43f5ed660d9868a232a03050113a2790.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/fc/54/39/43f5ed660d9868a232a03050113a2790.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/fc/54/39/43f5ed660d9868a232a03050113a2790.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fc/54/39/43f5ed660d9868a232a03050113a2790.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fc/54/39/43f5ed660d9868a232a03050113a2790.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/34/ad/16/f234bde13f7f46ae62b91c9dc2128155.jpg","is_gallery":true,"label":null,"large_url":"http