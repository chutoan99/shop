xt_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":1398000,"discount_rate":19,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/56/f5/ef/dbb1f9ca98d6e630578bacbfcdfafb52.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":338,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cdiv class=\"html-content detail-content\"\u003e\n\u003carticle class=\"lzd-article\"\u003e\n\u003cp\u003eTHÔNG SỐ KỸ THUẬT\u003c/p\u003e\n\u003cp\u003e- Công suất: 500W\u003c/p\u003e\n\u003cp\u003e- Loa bass: 12 inch (3 tấc)\u003c/p\u003e\n\u003cp\u003e- Loa treb: 1.5 inch\u003c/p\u003e\n\u003cp\u003e- Nồn điện: 220V / 50Hz - 60Hz\u003c/p\u003e\n\u003cp\u003e- Thời gian sử dụng: 3 – 4 tiếng\u003c/p\u003e\n\u003cp\u003e- Thời gian xạc: 4 tiếng\u003c/p\u003e\n\u003cp\u003e- Bình acquy: có, bình acquy 12V tích hợp trong loa\u003c/p\u003e\n\u003cp\u003e- Micro đi kèm: 2 micro không dây UHF\u003c/p\u003e\n\u003cp\u003e- Kết nối: Bluetooth, USB, SD card, AUX, đài FM\u003c/p\u003e\n\u003cp\u003e- Kích thước: (66 x 37.5 x 38.5) cm\u003c/p\u003e\n\u003cp\u003e- Trọng lượng: 28 kg\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/15/f8/cf/637a1fad836b0e249862ccdcd7aa3084.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eHỆ THỐNG TINH CHỈNH ÂM THANH\u003c/p\u003e\n\u003cp\u003e+ Điều chỉnh cho micro gồm 4 nút: V.MIC, HI, MID và LOW (volume, treble, mid, bass)\u003c/p\u003e\n\u003cp\u003e+ Điều chỉnh echo gồm 2 nút: DELAY và ECHO\u003c/p\u003e\n\u003cp\u003e+ Điều chỉnh nhạc gồm 3 nút: V. MUSIC, HI và LOW (volume, treble, bass) Với thiết kế tay kéo chắc chắn, hỗ trợ thêm tay nắm tiện lợi người dùng có thể mang loa KS-12000A đi khắp không gian.\u003c/p\u003e\n\u003cp\u003eCùng với khả năng hoạt động lên đến 5 giờ giúp loa hoạt động cực bền bỉ. KS-12000A hỗ trợ cổng kết nối DC 12V bên ngoài giúp bạn linh động hơn trong trường hợp hết bình acquy.\u003c/p\u003e\n\u003cp\u003ePHỐI GHÉP DỄ DÀNG KS-12000A được trang bị khả năng kết nối không dây, có dây hiện đại. Truyền phát không dây bluetooth mới nhất mang đến cho người dùng trải nghiệm âm nhạc tuyệt vời. Ngoài ra, hệ thống các cổng kết nối có dây Bluetooth, USB, SD card, AUX, đài FM cũng mang đến những tiện ích, khả năng nghe nhạc đa ồn.\u003c/p\u003e\n\u003cp\u003e+ Cổng Output có 2 ngõ: jack bông sen và jack 6.5mm\u003c/p\u003e\n\u003cp\u003e+ Cổng Mic in 6.5mm: Ngoài micro không dây còn có thể kết nối micro bên ngoài với loa khi cần qua jack cắm 6.5mm trên mặt điều khiển + Cổng Guitar jack cắm 6.5mm: dùng cho kết nối với nhạc cụ.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/28/6d/2c/189f495246b5f29b73169baaa509d95f.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eĐI KÈM VỚI 2 MICRO KHÔNG DÂY Loa karaoke Yamachi KS-12000A đi kèm với 2 micro không dây Yamachi chất lượng UHF điều chỉnh tần số dễ dàng bắt sóng trong phạm vi 3m, giúp bạn có thể hát karaoke, biểu diễn một cách tự tin. Đặc biệt micro không dây có khả năng chỉnh được 16 tần số kết nối. Việc này giúp cho loa tránh trường hợp trùng lặp tần số micro với các loa khác ở gần.\u003c/p\u003e\n\u003ch2\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/40/dd/df/6d51d0c415cfaf66cd60bd5bd69645ee.jpg\" alt=\"\" width=\"750\" height=\"500\" /\u003e\u003c/h2\u003e\n\u003c/article\u003e\n\u003c/div\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản p