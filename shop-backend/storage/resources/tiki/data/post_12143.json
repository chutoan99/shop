20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":437000,"discount_rate":37,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/6c/76/05/1a32333bb65fc780b6dfc3159d7e44cb.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1944,"all_time_quantity_sold":10,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<h5>Tốc độ quay vắt ổn định</h5>\n<p><strong>Máy Vắt Cam Hafele GS-401</strong> sử dụng điện 220 - 240V/50 - 60Hz nhằm đảm bảo được công suất hoạt động tối đa là 100W, nhờ vậy mà tốc độ quay vắt sẽ ổn định hơn, giúp bạn nhanh chóng có được những cốc nước cam bổ dưỡng. </p>\n<p><img src=\"https://salt.tikicdn.com/ts/tmp/37/14/82/08b6802bd71389f83f66737e0b4545dd.jpg\" alt=\"\" width=\"750\" height=\"500\" /></p>\n<h5>Chức năng chống nhỏ giọt</h5>\n<p>Máy vắt cam Hafele còn có chức năng đóng mở chống nhỏ giọt, đảm bảo vệ sinh hơn. Vì vậy mà sản phẩm máy vắt cam bằng điện này rất phù hợp dùng cho quán nước giải khát, quán cà phê. Tính năng tự động ở đây chính là công tắc máy ép: Tự động bật khi bạn ép trái cây xuống và phễu bắt đầu xoay. Và sẽ tắt ngay sau khi áp lực giảm trên phễu. Lúc này đây, phễu gạt bã ra ngoài và chỉ vắt nước cốt từ quả. Nước chảy qua bầu lọc vào trong bầu đựng nước từ đó sẽ chảy vào bên trong cốc (ống máng phải mở). Bầu lọc giữ lại phần bã và hạt.</p>\n<p><img src=\"https://salt.tikicdn.com/ts/tmp/7a/94/47/1b3c6c365d2b6e0e3ab10400bde957b7.jpg\" alt=\"\" width=\"750\" height=\"500\" /></p>\n<h5>Dễ dàng tháo rời</h5>\n<p>Đặc biệt, các bộ phận của máy có thể tháo rời để dễ dàng vệ sinh. Máy có thiết kế hình trụ chống bụi xâm nhập, vỏ ngoài bằng thép không gỉ và lưới lọc bằng nhựa, nắp đậy trong suốt rất đẹp và ấn tượng. Chân cao su chống trượt hiệu quả, khi vận hành máy không kêu ồn, giúp bạn an tâm hơn về tuổi thọ và độ bền của máy.</p>\n<p><img src=\"https://salt.tikicdn.com/ts/tmp/b8/b1/ed/3d57532db4db4e44d9d0d66ee0d42905.jpg\" alt=\"\" width=\"750\" height=\"500\" /></p>\n<h5>Hướng dẫn sử dụng máy vắt cam Hafele</h5>\n<p><strong>Vận hành</strong></p>\n<ul>\n<li>1. Thiết lập máy ép Hafele 535.43.089</li>\n<li>2. Để thiết bị đứng trên một bề mặt bằng phẳng dễ vệ sinh.</li>\n<li>3. Tháo dây nguồn từ khoang chứa dây điện (bên dưới máy ép).</li>\n<li>4. Cắm phích cắm vào nguồn điện </li>\n</ul>\n<p><strong>Chọn phụ kiện</strong></p>\n<ul>\n<li>1. Tùy vào kích thước quả, bạn có thể sử dụng phễu lớn hoặc bé.</li>\n<li>2. Phễu lớn phù hợp để ép cam quýt nhỏ như bưởi, cam,</li>\n<li>3. Phễu bé phù hợp để ép quả nhỏ</li>\n<li>4. Lắp phễu ép nhỏ trực tiếp lên trên trục dẫn động.</li>\n<li>5. Nếu bạn muốn dùng phễu lớn, hãy lắp phễu bé lên trên trục dẫn động. Sau đó lắp phễu lớn trên đỉnh phễu bé.</li>\n<li>6. Khi lắp phễu vào máy, bạn phải đảm bảo rằng các nấc trong kẹp phễu lớn vào đúng vị trí trên các cánh khuấy trên phễu bé.</li>\n<li>7. Để tách các phễu, hãy kéo phễu lớn hướng lên và ra ngoài.</li>\n</ul>\n<p><strong>Ép</strong></p>\n<p><strong>Lưu ý:</strong> Nếu bạn dùng lực ép quá lớn lên phễu ép, thì động cơ có thể bị kẹt.</p>\n<ul>\n<li>1. Mở nắp chống bụi trong suốt ra.</li>\n<li>2. Lắp phễu phù hợp lên trên trục dẫn động.</li>\n<li>3. Phễu ép phù hợp lên trên trục dẫn động.\n<ul>\n<li>Nếu bạn muốn gom nước ép vào trong bình đựng, hãy ấn ống máng hướng lên trên để đóng nó lại.</li>\n<li>Nếu bạn muốn lấy nước ép vào cốc trực tiếp, hãy ấn ống máng hướng xuống dưới và mở ống máng để cốc hứng bên dưới.</li>\n</ul>\n</li>\n<li>4. Cắt đôi trái cam và ấn đầu cắt của nửa quả lên phễu.</li>\n<li>5. Để tối đa hóa lượng nước ép từ hoa quả, hãy ấn quả lên trên phễu vài lần.</li>\n</ul><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/6c/76/05/1a32333bb65fc780b6dfc3159d7e44cb.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/6c/76/05/1a32333bb65fc780b6dfc3159d7e44cb.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/6c/76/05/1a32333bb65fc780b6dfc3159d7e44cb.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6c/76/05/1a32333bb65fc780b6dfc3159d7e44cb.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6c/76/05/1a32333bb65fc780b6dfc3159d7e44cb.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/61/21/3e/1a1247ca8a7eeb0400fd8658cd587888.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/61/21/3e/1a1247ca8a7eeb0400fd8658cd587888.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/61/21/3e/1a1247ca8a7eeb0400fd8658cd587888.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/61/21/3e/1a1247ca8a7eeb0400fd8658cd587888.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/61/21/3e/1a1247ca8a7eeb0400fd8658cd587888.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/23/f1/de/e0de7a99a142c70774236c3041c7ae17.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1