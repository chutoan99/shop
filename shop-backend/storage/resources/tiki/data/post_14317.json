,"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/6d/87/54/d3bcfe5426e6748decb08db3fd6d5d21.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2165,"all_time_quantity_sold":11,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003eSẢN PHẨM ĐƯỢC NHẬP KHẨU CHÍNH HÃNG VÀ PHÂN PHỐI BỞI CÔNG TY CỔ PHẦN TẦM NHÌN\u003c/strong\u003e   \u003c/p\u003e\n\u003cp\u003eCút nối vòi ren 3/4\" Gardena 18201-50 được làm từ chất liệu nhựa cao cấp, đường vân trên cút nối tăng cường sức vặn, đảm bảo chặt hơn khi kết nối với ống tưới Gardena, sử dụng để ghép nối vòi nước để phun tưới và chăm sóc vườn hoa, cây cảnh.\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://hqvcdn3.azureedge.net/qs_h=250\u0026amp;w=350\u0026amp;crop=0\u0026amp;ver=20220929T095958\u0026amp;hcsh=42FAFA214BB36F8BB2077D399C924241/_$$_/media/aprimo/gardena/hose%20fittings/photos/studio/ga110-10xxxx/ga110-1028.png\" alt=\"18201-20-S-001\" width=\"350\" height=\"250\" /\u003eCút nối vòi ren là phụ kiện chuyên dụng cho các đầu ống tưới, có các ren nối khớp chặt, đảm bảo cho nước không bị rò rỉ ra ngoài. Cút nối vòi ren thiết kế chắc chắn và chịu lực tốt, phù hợp gắn với vòi nước có đường kính 26,5mm. \u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://hqvcdn3.azureedge.net/qs_h=250\u0026amp;w=350\u0026amp;crop=0\u0026amp;ver=20220908T131644\u0026amp;hcsh=7A8E9D6339E16982814FAA2D4BD48191/_$$_/media/aprimo/gardena/hose%20fittings/photos/feature/ga120-02xxxx/ga120-0241.jpeg\" alt=\"18200-20-L-001\" width=\"350\" height=\"250\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTHÔNG TIN THƯƠNG HIỆU \u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eGARDENA là Thương hiệu dẫn đầu thế giới với hơn 60 năm kinh nghiệm trong lĩnh vực sản xuất dụng cụ và thiết bị chăm sóc sân vườn tại Châu Âu, được thành lập năm 1961 tại Đức bởi Werner Kress và Eberhard Kastner. Sản phẩm Gardena đã có mặt tại hơn 80 quốc gia thông qua các Nhà Nhập khẩu và Phân phối. Kể từ năm 2006, Gardena thuộc quyền sở hữu của Tập đoàn Husqvarna AB Thụy Điển. Gardena đã trở thành Thương hiệu ưa thích của hàng triệu chủ sở hữu nhà và vườn trên toàn thế giới bởi các sản phẩm đa dạng cùng chất lượng tuyệt vời.\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/6d/87/54/d3bcfe5426e6748decb08db3fd6d5d21.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/6d/87/54/d3bcfe5426e6748decb08db3fd6d5d21.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/6d/87/54/d3bcfe5426e6748decb08db3fd6d5d21.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6d/87/54/d3bcfe5426e6748decb08db3fd6d5d21.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/6d/87/54/d3bcfe5426e6748decb08db3fd6d5d21.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/6d/b6/30/41d5e5c4c98d61f7220907faa0e8395a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/6d/b6/30/41d5e5c4c98d61f7220907faa0e8395a.jpg","mediu