eview_count":55,"review_text":"(55)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/5c/30/89/5d6c50e5e4babb4c0c38eaf32981ff94.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1126,"all_time_quantity_sold":204,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cstrong\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/db/45/af/57393582925cad53951af3e7bed08b88.jpg\" alt=\"\" width=\"750\" height=\"561\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTiếng gọi của hoang dã\u003c/strong\u003e là câu chuyện cuộc đời phiêu lưu mạo hiểm của chú chó Buck. Buck bị bắt cóc từ trang trại của người chủ giàu có và trở thành chó kéo xe ở khu vực Alaska lạnh giá trong thời kì người ta đổ xô đi tìm vàng thế kỉ 19. Từ cuộc sống bình yên, được cưng chiều, Buck phải làm việc rất khổ cực, chịu đói chịu rét với đủ hạng người độc ác, man rợ nơi vùng Bắc Cực khí hậu vô cùng khắc nghiệt. Chính vì thế Buck đã học cách chiến đấu để sinh tồn, trở thành thủ lĩnh của đàn chó và luôn bị thôi thúc bởi tiếng gọi của rừng hoang… Vào lúc ranh giới giữa sự sống và cái chết mong manh như một sợi chỉ, Buck may mắn được cứu thoát và sống trong tình yêu thương của người chủ mới. Nhưng nhiều biến cố ập đến, chứng kiến cái chết bi thương của chủ, với tình yêu thương và sự trung thành, bản tính hoang dã trong Buck trỗi dậy mạnh mẽ hơn bao giờ hết…\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/e9/c2/ce/3bcdfe9189014ed4b33cf0a30e70572c.jpg\" alt=\"\" width=\"750\" height=\"487\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eÔng già và Biển cả\u003c/strong\u003e (The Old Man and the Sea) là tác phẩm xuất sắc nhất của Ernest Hemingway. Câu chuyện xoay quanh một ông lão đánh cá người Cuba, Santiago, suốt tám mươi tư ngày không bắt được một con cá nào, cho đến khi ông câu được một con cá kiếm khổng lồ. Ông đã cố gắng chiến đấu suốt ba ngày đêm với con cá kiếm vĩ đại bằng nghị lực phi thường. Sang đến ngày thứ ba, ông dùng lao đâm chết được con cá, buộc nó vào mạn thuyền và mang về. Nhưng trên đường trở về, ông lại bị đàn cá mập đánh hơi thấy mùi của con cá kiếm nên đã ùa tới tấn công. Ông cũng rất dũng cảm đem hết sức mình chống chọi với lũ cá mập, phóng lao và thậm chí dùng cả mái chèo để đánh. Cuối cùng ông giết được khá nhiều con và xua đuổi được chúng đi. Nhưng khi ông về đến bờ và nhìn lại thì con cá kiếm của mình đã bị rỉa hết thịt và chỉ còn lại một bộ xương trơ trọi.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/5c/30/89/5d6c50e5e4babb4c0c38eaf32981ff94.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/5c/30/89/5d6c50e5e4babb4c0c38eaf32981ff94.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/5c/30/89/5d6c50e5e4babb4c0c38eaf32981ff94.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5c/30/89/5d6c50e5e4babb4c0c38eaf32981ff94.png","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/5c/30/89/5d6c50e5e4babb4c0c38eaf32981ff94.png"},{"base_url":"https://salt.tikicdn.com/ts/product/d7/ad/cc/e13aff1b8c381d9dd0214aac772fe1ed.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d7/ad/cc/e13aff1b8c381d9dd0214aac772fe1ed.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d7/a