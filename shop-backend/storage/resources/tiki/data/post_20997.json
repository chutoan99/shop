icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":1,"review_text":"(1)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/a9/ab/21/1541ab0e5181eedf5460d75ac6604b12.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1132,"all_time_quantity_sold":29,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3\u003eThông tin chi tiết sản phẩm\u003c/h3\u003e\n\u003cul\u003e\u003cli\u003eDung tích: 3 lít\u003c/li\u003e\u003cli\u003eMàu/mùi: xanh dương/hương ban mai, trắng/hoa cúc, hồng/hoa hồng, tím/hoa oải hương\u003c/li\u003e\u003cli\u003eThương hiệu: Dnee\u003c/li\u003e\u003cli\u003eXuất xứ: Thái Lan\u003c/li\u003e\u003cli\u003eHSD: 3 năm kể từ NSX\u003c/li\u003e\u003c/ul\u003e\n\u003ch3\u003eĐặc điểm nổi bật\u003c/h3\u003e\n\u003cul\u003e\u003cli\u003eDung dịch có độ pH trung tính nên rất mềm dịu với da tay bạn và không làm hư hại đến quần áo của bé.\u003c/li\u003e\u003cli\u003e️Sản phẩm có hương thơm nhẹ, thích hợp cho trẻ sơ sinh và những người bị dị ứng với mùi hương.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e️NƯỚC GIẶT DNEE có 4 màu với 4 mùi khác nhau để mẹ dễ lựa chọn theo sở thích:\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eDnee màu xanh: màu này được nhiều mẹ yêu thích vì mùi hương dịu nhẹ nhưng vẫn lưu giữ mùi lâu trên quần áo.\u003c/li\u003e\u003cli\u003eDnee hồng: mùi hương hoa hồng dịu nhẹ cho những ngày mưa ẩm ướt.\u003c/li\u003e\u003cli\u003eDnee trắng: mùi hương hoa cúc và cũng là mùi hương dịu nhẹ nhất trong các dòng sản phẩm nước giặt của Dnee Thái.\u003c/li\u003e\u003cli\u003eDnee tím: mùi hương từ hoa oải hương, ngọt ngào, nồng nàn mà không gây bí bách, giữ cho con luôn thoải mái, dễ chịu nhất có thể\u003c/li\u003e\u003cli\u003eDnee xanh lá: mùi hương từ nha đam là một mùi hương nhẹ nhàng và mang chút hương thoang thoảng\u003c/li\u003e\u003c/ul\u003e\n\u003ch3\u003eCông dụng\u003c/h3\u003e\n\u003cp\u003eSodium Lauryl Sulfate Sodium Laureth Sulfate Polyacrylate Nước giặt có chứa Sunfate đây là chất tẩy rửa để làm sạch quần áo. Các sản phẩm của D-nee được trải qua quá trình sản xuất nghiêm ngặt để đạt tiêu chuẩn sử dụng cho TRẺ SƠ SINH không gây kích ứng \u0026amp; độ pH trung tính bảo vệ da tay mẹ khi giặt cũng như không làm hư quần áo\u003c/p\u003e\n\u003ch3\u003eThành phần:\u003c/h3\u003e\n\u003cul\u003e\u003cli\u003eSodium Lauryl Sulfate\u003c/li\u003e\u003cli\u003eSodium Laureth Sulfate\u003c/li\u003e\u003cli\u003ePolyacrylate\u003c/li\u003e\u003c/ul\u003e\n\u003ch3\u003eHướng dẫn sử dụng\u003c/h3\u003e\n\u003cp\u003e\u003cstrong\u003eGiặt tay:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eHòa ½ nắp chai hoặc 15ml NƯỚC GIẶT TRẺ EM DNEE với 2 lít nước (dùng giặt cho 10 bộ quần)\u003c/li\u003e\u003cli\u003eNgâm quần áo trong vài phút\u003c/li\u003e\u003cli\u003eGiặt lại với nước sạch\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eGiặt máy\u003c/strong\u003e: Hòa 2 nắp chai hoặc 60ml nước giặt Dnee với 8 lít nước trong máy giặt rồi cài chế độ giặt.\u003c/p\u003e\n\u003cp\u003e-----------------------\u003c/p\u003e\n\u003cp\u003eSHOP TRẺ THƠ CAM KẾT\u003c/p\u003e\n\u003cp\u003eCung cấp sản phẩm CHÍNH HÃNG, an toàn và chất lượng cho bé.\u003c/p\u003e\n\u003cp\u003eHỗ trợ tư vấn và giải đáp 24/7 mọi thắc mắc của khách hàng.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/a9/ab/21/1541ab0e5181eedf5460d75ac6604b12.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/a9/ab/21/1541ab0e5181eedf5460d75ac6604b12.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/a9/ab/21/1541ab0e5181eedf5460d75ac6604b12.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a9/ab/21/1541ab0e5181eedf5460d75ac6604b12.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/a9/ab/21/1541ab0e5181eedf5460d75ac6604b12.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/ac/29/07/823adc8346475c2df7d1487c861a6074.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/ac/29/07/823adc8346475c2df7d1487c861a6074.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/ac/29/07/823adc8346475c2df7d1487c861a6074.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ac/29/07/823adc8346475c2df7d1487c861a6074.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/ac/29/07/823adc8346475c2df7d1487c861a6074.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/68/6e/38/2904ff6eed3c47b249ec151a0dac831c.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/68/6e/38/2904ff6eed3c47b249ec151a0dac831c.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/68/6e/38/2904ff6eed3c47b249ec151a0dac831c.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/68/6e/38/2904ff6eed3c47b249ec151a0dac831c.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/68/6e/38/2904ff6eed3c47b249ec151a0dac831c.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/c3/21/df/c53cecf577ac1cab1d3af43bbcdcef99.jpg","is_gallery":true,"label":null,