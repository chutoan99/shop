ing_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/77/a4/a6/7662be23949379c74a8f999b8fe1b636.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":827,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cspan style=\"color:#0000ff;\"\u003e\u003cstrong\u003eCombo Sơn Nam - 4 Truyện Vừa Và Hương Quê ( Tặng sổ tay)\u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color:#ff0000;\"\u003e\u003cstrong\u003e1. Sơn Nam - 4 Truyện Vừa \u003c/strong\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003eTruyện vừa là thể loại chiếm tỉ lệ khá khiêm tốn trong toàn bộ sáng tác của nhà văn Sơn Nam. Để giúp bạn đọc có cái nhìn toàn diện hơn về bút lực của nhà văn Sơn Nam ở thể loại truyện này,  xin trân trọng giới thiệu với bạn đọc tuyển tập 4 truyện vừa của nhà văn. Gồm các truyện: Ngôi nhà mặt tiền; Âm dương cách trở; Chuyện tình một người thường dân; Truyện ngắn của truyện ngắn.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cspan style=\"color:#ff0000;\"\u003e2. Hương Quê\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"color:#000000;\"\u003eHương Quê gồm 23 truyện ngắn thấm đẫm hương vị Nam bộ của nhà văn Sơn Nam, từng được in trên tạp chí cùng tên trước năm 1975, của hội Khuyến nông miền Nam. Các truyện ngắn trong Hương Quê thường bắt đầu bằng một chi tiết hoặc hình ảnh rất đỗi bình thường, sau khi đưa ta vào những nẽo quanh co kỳ thú, đến khi kết thúc, lại khiến ta ngạc nhiên bất ngờ - Tưởng vậy mà không phải vậy! Ta cảm nhận một vẻ sâu sắc ẩn dưới sự mộc mạc giản dị. Cầu kỳ là dễ học được, vì nó là sự thu vào, là kiến thức. Còn giản dị mới khó, bởi là trải nghiệm, từ trong mà ra. Chỉ những tâm hồn trưởng thành thật sự mới có thể đạt đến giản dị thuần khiết như vậy.\u003c/span\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/77/a4/a6/7662be23949379c74a8f999b8fe1b636.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/77/a4/a6/7662be23949379c74a8f999b8fe1b636.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/77/a4/a6/7662be23949379c74a8f999b8fe1b636.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/77/a4/a6/7662be23949379c74a8f999b8fe1b636.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/77/a4/a6/7662be23949379c74a8f999b8fe1b636.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/26/43/b5/d43b56f74375aaecfa3a236d0604c6d5.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/26/43/b5/d43b56f74375aaecfa3a236d0604c6d5.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/26/43/b5/d43b56f74375aaecfa3a236d0604c6d5.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/26/43/b5/d43b56f74375aaecfa3a236d0604c6d5.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/26/43/b5/d43b56f74375aaecfa3a236d0604c6d5.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/36/b0/45/a74f05eb167e10294ba76b4c9b01bebb.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/36/b0/45/a74f05eb167e10294ba76b4c9b01bebb.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/36/b0/45/a74f05eb167e10294ba76