on_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.5,"review_count":92,"review_text":"(92)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/21/64/07/2812496ef70e8cde7e9449b5d2fe3507.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1741,"all_time_quantity_sold":530,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch1 id=\"product-name\" class=\"item-name\" style=\"text-align:center\"\u003e\u003cspan style=\"color:#ff0000\"\u003eGiá Đỡ Cằm Chống Cận Thị, Chống Gù Amalife\u003c/span\u003e\u003c/h1\u003e\n\u003cp style=\"text-align:center\"\u003eSẢN PHẨM CHÍNH HÃNG ĐẢM BẢO CHẤT LƯỢNG VÀ AN TOÀN TUYỆT ĐÔI\u003c/p\u003e\n\u003cp style=\"text-align:center\"\u003e\u003cstrong\u003eAmalife là Thương hiệu nổi tiếng cho các sản phẩm nắn chỉnh và điều chỉnh tư thế cột sống lưng và chống cận thị\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center\"\u003e \u003c/p\u003e\n\u003cp\u003eCận thị học đường đã và đang trở thành một vấn nạn đối với lứa tuổi học sinh. Tại khắp cả nước, tỷ lệ cận thị học đường đang ngày một tăng cao, ảnh hưởng không nhỏ đến việc học tập và vui chơi của trẻ em.\u003c/p\u003e\n\u003cp\u003eTheo thống kê của Bệnh Viện Mắt Trung Ương, cả nước ta có gần 5 triệu trẻ em trong độ tuổi đi học mắc tật khúc xạ. Trong đó số trẻ bị cận thị chiếm tới hơn 40% và tập trung chủ yếu ở thành thị. Một trong những nguyên nhân đó là \u003cstrong\u003eSai tư thế ngồi học\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" src=\"https://salt.tikicdn.com/ts/tmp/9b/a5/96/b75a5e8e55eab399d19a05cc418913a6.jpg\" alt=\"\" width=\"600\" height=\"315\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eDo đó, đồng hành cùng các vị phụ huynh, Amalife đưa ra giải pháp đưa thiết bị dụng cụ đỡ cằm vào bộ dụng cụ học tập để giải quyết tối ưu tình trạng nhức nhối này\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp style=\"text-align:center\"\u003e\u003cstrong\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/28/79/10/ef04c7b6db7342ef0f62880340694a53.jpg\" alt=\"\" width=\"750\" height=\"685\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center\"\u003e \u003c/p\u003e\n\u003cul style=\"list-style-type:circle\"\u003e\u003cli\u003e\u003cstrong\u003eĐiều chỉnh tư thế ngồi chuẩn, bảo vệ cột sống cho trẻ\u003c/strong\u003e\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eGiữ cân bằng vai cho trẻ, hình thành thói quen ngồi học đúng cách\u003c/strong\u003e\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eBảo vệ sức khỏe, giúp trẻ say mê, chăm chỉ học tập\u003c/strong\u003e\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eHỗ trợ phát triển chiều cao cho trẻ\u003c/strong\u003e\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eDễ dàng sử dụng cho mọi lứa tuổi\u003c/strong\u003e\u003c/li\u003e\u003cli\u003e \u003c/li\u003e\u003c/ul\u003e\n\u003cp style=\"text-align:center\"\u003e\u003cstrong\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/c3/33/fe/0c0db966036414c5d2e304f1a2fd180a.PNG\" alt=\"\" width=\"750\" height=\"748\" /\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align:center\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align:center\"\u003e\u003cstrong\u003eBộ dụng cụ vừa giúp trẻ không cúi sát hoặc nằm oải trên mặt bàn, đồng thời đẩy phần ngực được khoảng cách chuẩn xác so với bàn học\u003c/strong\u003e\u003c/