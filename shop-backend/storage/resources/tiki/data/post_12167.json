verage":5,"review_count":7,"review_text":"(7)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/f7/0f/19/7bb6ed0554e4818b527dde85464e1330.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2101,"all_time_quantity_sold":45,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p> </p>\n<h5 style=\"box-sizing: border-box; font-family: Roboto, Helvetica, Arial, sans-serif; font-weight: 500; line-height: 1.1; color: #333333; margin-top: 10px; margin-bottom: 10px; font-size: 20px; text-align: center;\"><iframe style=\"box-sizing: border-box; display: table; margin: auto;\" src=\"https://www.youtube.com/embed/hBvMSP7cI-Q\" width=\"750\" height=\"421\" allowfullscreen=\"allowfullscreen\"></iframe></h5>\n<h5 style=\"box-sizing: border-box; font-family: Roboto, Helvetica, Arial, sans-serif; font-weight: 500; line-height: 1.1; color: #333333; margin-top: 10px; margin-bottom: 10px; font-size: 20px; text-align: justify;\">Chất lượng hình ảnh hoàn hảo</h5>\n<p style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"><span style=\"box-sizing: border-box;\">Đĩa Game PlayStation PS4 Sony GTA Grand Theft Auto V</span> là một trong những tựa game độc quyền đầu tiên dành cho PS4, GTA Grand Theft Auto V cũng đang tỏ ra rất hứa hẹn ở thời điểm hiện tại, trước hết là về mặt đồ họa. Đoạn gameplay mới được Rockstar Games công bố dành cho trò chơi mang đến chất lượng hình ảnh chất lượng Full HD 1080p phải nói là không có gì để chê trách.</p>\n<p style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"><img style=\"box-sizing: border-box; vertical-align: middle; border: 0px; display: block; max-width: 100%; height: auto; margin-left: auto; margin-right: auto;\" src=\"https://vcdn.tikicdn.com/ts/tmp/aa/45/6b/33583884f53339837fd59de1ffd933a8.jpg\" alt=\"Đĩa Game PlayStation PS4 Sony GTA Grand Theft Auto V Hệ US\" width=\"900\" height=\"600\" /></p>\n<h5 style=\"box-sizing: border-box; font-family: Roboto, Helvetica, Arial, sans-serif; font-weight: 500; line-height: 1.1; color: #333333; margin-top: 10px; margin-bottom: 10px; font-size: 20px; text-align: justify;\">Nhập vai ấn tượng</h5>\n<p style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\">Nhắc đến nội dung thì Rockstar lại một lần nữa làm người hâm mộ kinh ngạc vì tài năng của họ. Một điều dễ nhận thấy qua các bản GTA gần đây là nhân vật chính ngày càng phức tạp về tính cách và nội tâm, chứ không đơn giản như trước nữa. Người chơi sẽ thật sự đắm chìm trong câu chuyện của họ, mỗi người một vẻ, vì sự truyền cảm và hấp dẫn trong cách dẫn truyện cũng như phải trăn trở, suy ngẫm về những điều trò chơi muốn thể hiện. Đó là những câu chuyện về tình bạn và niềm tin, những rắc rối gia đình của một tay anh chị, sự bế tắc khi tay đã “nhúng chàm” và muốn thoát ra… tất cả đều là những vấn đề đậm tính xã hội, tràn đầy hơi thở cuộc sống. Ngoài ra, đây là lần đầu tiên GTA có nhiều kết thúc khác nhau, tùy vào lựa chọn của người chơi – một điểm hấp dẫn chưa từng có. Với thành công lớn của mô hình đa góc nhìn, có thể nói đây sẽ là xu thế cho các bản GTA sau này.</p>\n<p style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"><img style=\"box-sizing: border-box; vertical-align: middle; border: 0px; display: block; max-width: 100%; height: auto; margin-left: auto; margin-right: auto;\" src=\"https://vcdn.tikicdn.com/ts/tmp/42/83/fd/0b7bbd4f5a060c4dc57002496055c777.jpg\" alt=\"Đĩa Game PlayStation PS4 Sony GTA Grand Theft Auto V Hệ US\" width=\"900\" height=\"600\" /></p>\n<h5 style=\"box-sizing: border-box; font-family: Roboto, Helvetica, Arial, sans-serif; font-weight: 500; line-height: 1.1; color: #333333; margin-top: 10px; margin-bottom: 10px; font-size: 20px; text-align: justify;\">Đem đến góc nhìn mới</h5>\n<p style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px;\">Đĩa Game PS4 GTA Grand Theft Auto V bạn sẽ được trải nhiệm một tựa game hoàn hảo từ \"A đến Z\". Sở hữu nền đồ họa đỉnh cao, lung linh, tráng lệ, cùng với đó là lối chơi hành động xen lẫn sinh tồn vô cùng hấp dẫn, giúp bạn có những phút giây giải trí đầy thú vị gay cấn.</p>\n<p style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px;\"><img style=\"box-sizing: border-box; vertical-align: middle; border: 0px; display: block; max-width: 100%; height: auto; margin-left: auto; margin-right: auto;\" src=\"https://vcdn.tikicdn.com/ts/tmp/cf/08/a7/b2cdb4993af2133f70d82f219c9aec11.jpg\" alt=\"Đĩa Game PlayStation PS4 Sony GTA Grand Theft Auto V Hệ US\" width=\"900\" height=\"600\" /></p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/f7/0f/19/7bb6ed0554e4818b527dde85464e1330.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/f7/0f/19/7bb6ed0554e4818b527dde85464e1330.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/f7/0f/19/7bb6ed0554e4818b527dde85464e1330.jpg","pos