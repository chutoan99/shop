xt":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":146000,"discount_rate":23,"rating_average":4.6,"review_count":26,"review_text":"(26)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/34/20/87/e9e8806f0ad0e547a322ba3616248319.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":987,"all_time_quantity_sold":165,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p style=\"text-align:left;\"><strong><img src=\"https://salt.tikicdn.com/ts/tmp/01/ba/b2/e0b7c359be9a4feb7da7e864c104da68.png\" alt=\"\" width=\"750\" height=\"750\" /></strong></p>\n<p style=\"text-align:left;\"><strong>Giới thiệu</strong></p>\n<ul>\n<li style=\"text-align:left;\">Bổ sung vitamin và khoáng chất bổ dưỡng, thơm ngon, đem đến cho người cao tuổi một bữa ăn bổ sung giàu dinh dưỡng.</li>\n<li style=\"text-align:left;\">Giảm mệt mỏi, ăn ngủ tốt, tăng cường sức đề kháng, chống chọi bệnh tật.</li>\n<li style=\"text-align:left;\">Giảm cholesterol, tốt cho tim mạch với nhóm chất béo PUFA.</li>\n<li style=\"text-align:left;\">Bổ sung canxi kết hợp với phospho, magie, D3 giúp cho hệ xương răng chắc khỏe.</li>\n<li style=\"text-align:left;\">Chống lão hoá, thiếu canxi ở hệ xương.</li>\n</ul>\n<p><img style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/c2/40/7c/44a8043d94f3fe5e45b31abcddff4679.png\" alt=\"\" width=\"351\" height=\"351\" /></p>\n<h3><strong>Công Dụng</strong></h3>\n<ul>\n<li>Bồi bổ sức khỏe cho người trưởng thành, người cao tuổi, nâng cao thể trạng cho người mới ốm dậy.</li>\n<li>Bảo vệ hệ tim mạch , phòng ngừa loãng xương, tăng cường khả năng miễn dịch của cơ thể</li>\n<li>Bổ sung FOS giúp ngăn ngừa táo bón và giúp trẻ hấp thu, tiêu hóa tốt.</li>\n</ul>\n<h3><strong>Thành phần</strong></h3>\n<p>Sữa bột béo 25%, Sữa bột tách béo 10%, Maltosedextrine, Đường Sucrose, Đạm đậu nành, Dầu hạt cải, kẽm sulfat, natri selanat, Hỗn hợp vitamin (Vitamin A, vitamin D, vitamin C, Vitamin B1,  Vitamin B2,) và khoáng chất,</p>\n<p>Nguyên liệu nhập khẩu từ NewZealand</p>\n<h3>Đối Tượng Sử dụng</h3>\n<ul>\n<li>Dành cho người cao tuổi và người phục hồi sau ốm bệnh</li>\n<li>Dùng cho người gầy yếu, kém hấp thu</li>\n<li>Người lao động nặng nhọc</li>\n</ul>\n<h3>Cách Dùng</h3>\n<ul>\n<li>Cho 5 muỗng gạt bằng ( tương đương 45g) với 180ml nước ấm ( 40-50 độ C ) được 1 ly khoảng 200ml. Khuấy đều cho đến khi bột tan hoàn toàn.</li>\n<li>Uống ngay sau khi pha trong vòng 1h là tốt nhất</li>\n<li>Khẩu phần khuyên dùng: Uống 2-3 ly/ ngày</li>\n</ul>\n<h3>Bảo Quản</h3>\n<p>Bảo quản ở nhiệt độ thường, nơi khô ráo, sạch sẽ, thoáng mát, tránh nắng trực tiếp. Chỉ dùng thìa có trong lon. Lon đã mở phải được đậy kín và sử dụng trong vòng 4 tuần.</p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/34/20/87/e9e8806f0ad0e547a322ba3616248319.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/34/20/87/e9e8806f0ad0e547a322ba3616248319.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/34/20/87/e9e8806f0ad0e547a322ba3616248319.jpg",