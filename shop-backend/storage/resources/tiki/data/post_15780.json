c ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/b3/f1/76/157c7eed835a0e7c00d0b3c8651bb2b2.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b3/f1/76/157c7eed835a0e7c00d0b3c8651bb2b2.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b3/f1/76/157c7eed835a0e7c00d0b3c8651bb2b2.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b3/f1/76/157c7eed835a0e7c00d0b3c8651bb2b2.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b3/f1/76/157c7eed835a0e7c00d0b3c8651bb2b2.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/32/86/d6/e750421e3bd3598fdcec1c32cdc432b9.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/32/86/d6/e750421e3bd3598fdcec1c32cdc432b9.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/32/86/d6/e750421e3bd3598fdcec1c32cdc432b9.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/32/86/d6/e750421e3bd3598fdcec1c32cdc432b9.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/32/86/d6/e750421e3bd3598fdcec1c32cdc432b9.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/33/df/01/8a84e81e492af42359d7c6c2fb908a58.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/33/df/01/8a84e81e492af42359d7c6c2fb908a58.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/33/df/01/8a84e81e492af42359d7c6c2fb908a58.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/33/df/01/8a84e81e492af42359d7c6c2fb908a58.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/33/df/01/8a84e81e492af42359d7c6c2fb908a58.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/8a/a2/76/540280f012f36b73439dc9783af39e7d.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/