ull,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.8,"review_count":6,"review_text":"(6)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/b7/55/0d/825619f307cf8f21b5b7d39ba7beea8f.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":173,"all_time_quantity_sold":26,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3 style=\"text-align:justify\"\u003e\u003ciframe src=\"//www.youtube.com/embed/E1fkbYA2A0w\" width=\"560\" height=\"314\" allowfullscreen=\"allowfullscreen\"\u003e\u003c/iframe\u003e\u003c/h3\u003e\n\u003ch3 style=\"text-align:justify\"\u003eThiết kế cao cấp, sang trọng\u003c/h3\u003e\n\u003cp\u003eMáy ép trái cây Kuvings C7000 có thiết kế nguyên khối, màu sắc đẹp mắt kết hợp các bộ phận được lắp ghép với nhau một cách thẩm mỹ, mang lại sự sang trọng cho không gian nhà bạn. Kuvings C7000 là dòng sản phẩm cao cấp được nhập khẩu từ Hàn Quốc, đáp ứng yêu cầu khắt khe của gia chủ khó tính từ mẫu mã cho đến những tính năng ưu việt và lợi ích mà nó mang lại.\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" title=\"Máy Ép Trái Cây Kuvings C7000 (Đỏ)\" src=\"http://tikicdn.com/media/catalog/product/1/8/1815396119910.u3059.d20161215.t124012.787087.jpg\" alt=\"Máy Ép Trái Cây Kuvings C7000 (Đỏ)\" width=\"750\" height=\"499\" /\u003e\u003c/p\u003e\n\u003ch3 style=\"text-align:justify\"\u003e \u003c/h3\u003e\n\u003ch3 style=\"text-align:justify\"\u003eCông nghệ ép tốc độ chậm\u003c/h3\u003e\n\u003cp\u003eCông nghệ ép của dòng máy ép Kuvings C7000 chính hãng được nghiên cứu và phát triển tại Hàn Quốc đã được cấp bằng sáng chế. Công nghệ ép tốc độ chậm sử dụng trục vít cưỡng bức LSTS khô giúp ép triệt để hơn. Tổng số vòng quay chỉ khoảng 60 vòng/phút ở dòng máy ép thế hệ mới C7000 cho phép ép trái cây và nghiền được các loại rau củ quả mà các loại máy ép thông thường không làm được.\u003c/p\u003e\n\u003ch3 style=\"text-align:justify\"\u003eNước ép giữ nguyên dưỡng chất\u003c/h3\u003e\n\u003cp\u003eLượng nước ép từ máy ép tốc độ chậm mang lại nhiều hơn so với máy ép ly tâm. Ngoài ra, máy ép trái cây tốc độ chậm giữ được hầu hết các loại vitamin và các chất dinh dưỡng có trong rau củ quả, có lợi cho sức khỏe người dùng. So với máy ép thông thường thì lượng nước từ máy ép Kuving gấp 1,5 lần và lượng vitamin gấp 5 lần. Nhờ đó, nước ép từ máy ép tốc độ chậm Kuvings C7000 có màu sắc tự nhiên hơn, đậm đà hơn khi uống.\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" title=\"Máy Ép Trái Cây Kuvings C7000 (Đỏ)\" src=\"http://tikicdn.com/media/catalog/product/1/8/18153961199101.u3059.d20161215.t124012.831282.jpg\" alt=\"Máy Ép Trái Cây Kuvings C7000 (Đỏ)\" width=\"750\" height=\"499\" /\u003e\u003c/p\u003e\n\u003ch3 style=\"text-align:justify\"\u003e \u003c/h3\u003e\n\u003ch3 style=\"text-align:justify\"\u003eVận hành êm\u003c/h3\u003e\n\u003cp style=\"text-align:justify\"\u003eĐược thiết kế với công nghệ hiện đại, máy ép Kuvings C7000 hoạt động êm ái và hầu như không có tiếng ồn như các dòng máy ép thông thường. Bạn có thể sử dụng máy để ép những ly nước trái cây dinh dưỡng vào bất kỳ thời điểm nào mà không sợ làm phiền đến những người xung quanh.\u003c/p\u003e\n\u003ch3 style=\"text-align:justify\"\u003eÉp liên tục trong 30 phút\u003c/h3\u003e\n\u003cp\u003eSản phẩm hoạt động liên tục trong 30 phút và có thể ép hàng chục lít nước mỗi lần. Nhờ đó, bạn sẽ thoải mái ép nước trái cây cho cả gia đình đông người hoặc mua sản phẩm để kinh doanh đồ uống.\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" title=\"Máy Ép Trái Cây Kuvings C7000 (Đỏ)\" src=\"http://tikicdn.com/media/catalog/product/1/8/18153961199102.u3059.d20161215.t124012.865735.jpg\" alt=\"Máy Ép Trái Cây Kuvings C7000 (Đỏ)\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003ch3 style=\"text-align:justify\"\u003e \u003c/h3\u003e\n\u003ch3 style=\"text-align:justify\"\u003eỐng tiếp trái cây rộng\u003c/h3\u003e\n\u003cp\u003eMáy ép chậm Kuvings C7000 thiết kế ống tiếp nguyên liệu rộng để ép nguyên trái mà không cần cắt lát như các dòng máy khác. Thiết kế miệng rộng giúp bạn tiết kiệm thời gian cũng như hạn chế sự biến chất của hoa quả khi cắt.\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" title=\"Máy Ép Trái Cây Kuvings C7000 (Đỏ)\" src=\"http://tikicdn.com/media/catalog/product/1/8/18153961199103.u3059.d20161215.t124012.898176.jpg\" alt=\"Máy Ép Trái Cây Kuvings C7000 (Đỏ)\" width=\"750\" height=\"500\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch3 style=\"text-align:justify\"\u003eAn toàn và dễ vệ sinh\u003c/h3\u003e\n\u003cp style=\"text-align:justify\"\u003eSản phẩm dễ dàng lắp ráp và tháo rời từng bộ phận giúp dễ dàng hơn trong quá trình sử dụng, đồng thời máy có khả năng làm sạch hoàn toàn tự động giúp người sử dụng tiết kiệm được thời gian, an toàn khi sử dụng.\u003c/p\u003e\n\u003cp\u003eMáy trang bị tính năng tự ngắt an toàn sau khi hoạt động liên tục trong 30 phút, đảm bảo sự bền bỉ cho động cơ và tuổi thọ lâu dài.\u003c/p\u003e\n\u003cp\u003e\u003cbr /\u003e\u003cimg style=\"margin-left:auto;margin-right:auto\" title=\"Máy Ép Trái Cây Kuvings C7000 (Đỏ)\" src=\"http://tikicdn.com/media/catalog/product/1/8/18153961199105.u3059.d20161215.t124012.962006.jpg\" alt=\"Máy Ép Trái Cây Kuvings C7000 (Đỏ)\" width=\"750\" height=\"499\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/b7/55/0d/825619f307cf8f21b5b7d39ba7beea8f.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b7/55/0d/825619f307cf8f21b5b7d39ba7beea8f.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b7/55/0d/825619f307cf8f21b5b7d39ba7beea8f.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b7/55/0d/825619f307cf8f21b5b7d39ba7beea8f.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b7/55/0d/825619f307cf8f21b5b7d39ba7beea8f.jpg"}],"warranty_policy":null,"brand":{"id":41435,"name":"Kuvings","slug":"kuvings"},"current_seller":{"id":7880,"sku":"1422505917601","name":"dienmaycuongviet","link":"https://tiki.vn/cua-hang/dienmaycuongviet","logo":"https://vcdn.tikicdn.com/ts/seller/ba/49/f9/4c0baf3fb2670f6d88d08d1cb1994f0a.jpg","price":6999000,"product_id":"274564044","store_id":7699,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[],"specifications":[{"name":"Content","attributes":[{"code":"brand","name":"Thương hiệu","value":"Kuvings"},{"code":"brand_country","name":"Xuất xứ thương hiệu","value":"Hàn Quốc"},{"code":"chat_lieu_vo","name":"Chất liệu vỏ","value":"Cối Nhựa Tritan ,Trục ép, bộ lọc bằng nhựa PEI và thép không gỉ "},{"code":"cong_suat","name":"Công suất","value":"240W"},{"code":"function","name":"Tính năng","value":"Ép chậm, ép kiệt bã các loại rau, củ, quả..."},{"code":"knife_material","name":"Chất liệu lưỡi dao","value":"Thép không gỉ"},{"code":"machine_type","name":"Loại máy","value":"Máy ép chậm"},{"code":"origin","name":"Xuất xứ (Made in)","value":"Hàn Quốc"},{"code":"safe_mode","name":"Chế độ an toàn","value":"Có"},{"code":"toc_do","name":"Tốc độ","value":"