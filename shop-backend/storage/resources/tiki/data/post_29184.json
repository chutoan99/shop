round_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/04/c8/0b/f859ad3d46b6ff8a314cc3541af0f443.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":736,"all_time_quantity_sold":6,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003ePhòng và sạch ve, bọ chét trên chó.\u003c/p\u003e\n\u003cp\u003eCÔNG DỤNG:\u003c/p\u003e\n\u003cp\u003e– Dùng cho chó từ 8 tuần tuổi trở lên.\u003c/p\u003e\n\u003cp\u003e– Phòng và sạch ve, bọ chét trên chó và chó con.\u003c/p\u003e\n\u003cp\u003e– Sau 1 tháng sử dụng, đã phá vỡ được hoàn toàn vòng đời của bọ chét và kiểm soát được sự lây nhiễm của ve.\u003c/p\u003e\n\u003cp\u003e– Các nghiên cứu đã chứng minh rằng tiêu diệt được trứng, nhộng và bọ chét trưởng thành cho đến 3 tháng. tiêu diệt được ve ít nhất 1 tháng; và chỉ cần một lần sử dụng sẽ kiểm soát được ve nơi cần kiểm soát. Mặc dù có thể kiểm soát được bọ chét cho đến 3 tháng, nhưng nếu có nguy cơ tái nhiễm hay do bọ chét gây viêm da dị ứng thì có thể lặp lại mỗi tháng.\u003c/p\u003e\n\u003cp\u003e– duy trì được hiệu quả sau khi tắm, nhúng nước hay phơi dưới ánh nắng.\u003c/p\u003e\n\u003cp\u003eLIỀU DÙNG: 01 ống/con cho 1 lần dùng. dùng ngoài da\u003c/p\u003e\n\u003cp\u003eCÁCH SỬ DỤNG:\u003c/p\u003e\n\u003cp\u003e– Lấy ống ra khỏi bao. Giữ ống thẳng đứng và bẻ gãy đầu ống. Nhớ đưa ống ra xa khỏi người.\u003c/p\u003e\n\u003cp\u003e– Đặt đầu ống lên da giữa hai xương bả vai. Bóp ống nhẹ nhàng để đẩy toàn bộ trong ống lên một đốm trên da chó. Phải bôi thật sự lên da chứ không bôi lên lông thú,  cẩn thận tránh dính vào lông thú quá nhiều.\u003c/p\u003e\n\u003cp\u003e– Tránh tiếp xúc cho đến khi đã khô.\u003c/p\u003e\n\u003cp\u003e– Không dùng lặp lại trong vòng 30 ngày.\u003c/p\u003e\n\u003cp\u003eTHỂ TÍCH THỰC:\u003c/p\u003e\n\u003cp\u003e0,67 ml/ống (Chó dưới 10 kgs) .Hộp 03 ống\u003c/p\u003e\n\u003cp\u003e1,34 ml/ ống (Chó 10-20 kgs) Hộp 03 ống\u003c/p\u003e\n\u003cp\u003e2,68 ml/ống (Chó 20-40 kgs) Hộp 03 ống\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e\u003cp\u003eSản phẩm này là tài sản cá nhân được bán bởi Nhà Bán Hàng Cá Nhân và không thuộc đối tượng phải chịu thuế GTGT. Do đó hoá đơn VAT không được cung cấp trong trường hợp này.\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/04/c8/0b/f859ad3d46b6ff8a314cc3541af0f443.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/04/c8/0b/f859ad3d46b6ff8a314cc3541af0f443.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/04/c8/0b/f859ad3d46b6ff8a314cc3541af0f443.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/04/c8/0b/f859ad3d46b6ff8a314cc3541af0f443.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/04/c8/0b/f859ad3d46b6ff8a314cc3541af0f443.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/c9/68/dd/51ea49f8c0554999452ae9e331e2393e.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c9/68/dd/51ea49f8c0554999452ae9e331e2393e.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c9/68/dd/51ea49f8c0554999452ae9e331e2393e.png","position":null