n_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.8,"review_count":5,"review_text":"(5)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/d3/1d/7f/6da4120f3914c42f73756d823d795d27.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1762,"all_time_quantity_sold":36,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align: center;\"\u003e\u003ciframe src=\"//www.youtube.com/embed/E4zoMGfhofY\" width=\"560\" height=\"314\" allowfullscreen=\"allowfullscreen\"\u003e\u003c/iframe\u003e\u003c/p\u003e\n\u003cp data-spm-anchor-id=\"a2o4n.pdp.product_\"\u003e\u003cstrong\u003eLƯU Ý KHI SỬ DỤNG:\u003c/strong\u003e\u003c/p\u003e\n\u003cp data-spm-anchor-id=\"a2o4n.pdp.product_\"\u003e\u003cstrong\u003e KHÔNG ĐƯỢC KÉO ỐNG NƯỚC QUÁ MỨC CHO PHÉP CỦA CUỘN ỐNG. \u003c/strong\u003e\u003c/p\u003e\n\u003cp data-spm-anchor-id=\"a2o4n.pdp.product_\"\u003e\u003cstrong\u003e KHI THU DÂY PHẢI GIỮ DÂY VÀ THẢ TỪ TỪ.\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003e     Bạn mệt mỏi với những ống nước dài nhằn, và dễ bị gấp khúc, bị rối mỗi lần tưới cây. Hãy sử dụng cuộn vòi Rotoroll của Claber để giải quyết tất cả các vấn đề trên. Cuộn dây dài đến 20m, tự động thu vào mà không phải mất công cuộn. Thật tiện lợi phải không nào? Rotoroll là giải pháp lý tưởng cho sân hoặc khu vườn nhỏ, nhờ vào khung treo tường xoay 180°.\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/5d/a5/e6/02a60a33c559e0fdd5a17e74c1b08df5.jpg\" alt=\"\" width=\"750\" height=\"3625\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003e\u003cstrong\u003eĐẶC ĐIỂM NỔI BẬT\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003e    Chống sốc và chống chịu thời tiết do được làm bằng chất liệu nhựa PP. Cụ thể, bộ dụng cụ tưới có thể hoạt động tốt với nhiệt độ từ 130oC – 170oC. Loại chất liệu này còn được đánh giá là an toàn tuyệt đối với sức khỏe của người dùng, thân thiện với môi trường.\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003e    Thiết kế hiện đại độc quyền của hãng Claber cho phép bạn có thể lấy dây tưới ra để chăm sóc cây trồng và tự động thu gọn vào cuộn vòi tưới để dễ dàng trong công tác bảo quản. Từ đó góp phần nâng cao chất lượng cũng như là tuổi thọ của sản phẩm.\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003e    Cuộn ống tự thu gọn trơn tru và nhanh chóng, không tốn công sức nên mọi thành viên trong gia đình bạn đều có thể sử dụng được. Thiết kế sản phẩm đẹp, bắt mắt và nhỏ gọn nên đặc biệt phù hợp với mục đích tưới cảnh quan.\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003e    Hệ thống khóa an toàn Soft Block được cấp bằng sáng chế toàn thế giới đảm bảo hoạt động tưới diễn ra an toàn nhất, tiết kiệm nước tưới nhất bạn nhé.\u003c/p\u003e\n\u003cp style=\"text-align: left;\"\u003e    Có ống đặc biệt 20m với vách ngoài chống gập và bề mặt chống ma sát, thao tác thu gọn ống hoàn hảo (không rối, không kẹt, không gãy ống nước). Được làm từ vật liệu chịu được tác động và ánh sáng mặt trời mạnh, độ bền tối đa theo thời gian.\u003c/p\u003e\n\u003cp data-spm-anchor-id=\"a2o4n.pdp.product_\"\u003e    Khung treo tường chất liệu trục nhôm không gỉ cho phép cuộn quay 180° theo hướng kéo dây, giảm ma sát và không gãy ống.\u003c/p\u003e\n\u003cp data-spm-anchor-id=\"a2o4n.pdp.product_\"\u003e \u003c/p\u003e\n\u003cp data-spm-anchor-id=\"a2o4n.pdp.product_\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align: center;\" data-spm-anchor-id=\"a2o4n.pdp.product_\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/60/cf/0d/ab2298bb92523dcfb985e29bf473afe1.JPG\" alt=\"\" width=\"750\" height=\"245\" /\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\" data-spm-anchor-id=\"a2o4n.pdp.product_\"\u003e \u003c/p\u003e\n\u003cp data-spm-anchor-id=\"a2o4n.pdp.product_\"\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/d3/1d/7f/6da4120f3914c42f73756d823d795d27.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d3/1d/7f/6da4120f3914c42f73756d823d795d27.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d3/1d/7f/6da4120f3914c42f73756d823d795d27.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d3/1d/7f/6da4120f3914c42f73756d823d795d27.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d3/1d/7f/6da4120f3914c42f73756d823d795d27.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/29/7d/bc/b5470b79f5d76f9f41dbb0670fd07778.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/29/7d/bc/b5470b79f5d76f9f41dbb0670fd07778.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/29/7d/bc/b5470b79f5d76f9f41dbb0670fd07778.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/29/7d/bc/b5470b79f5d76f9f41dbb0670fd07778.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/29/7d/bc/b5470b79f5d76f9f41dbb0670fd07778.jpg"