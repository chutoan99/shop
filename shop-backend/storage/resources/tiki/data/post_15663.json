,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/b1/47/26/22c41fe04af3e6c7a6301dd478ea0306.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":119,"all_time_quantity_sold":3,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003e\u003cimg style=\"margin-left:auto;margin-right:auto;\" src=\"https://salt.tikicdn.com/ts/tmp/b1/47/26/69bf21453f69d1d771dab02e89a10301.png\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eThông số kỹ thuật :\u003cbr /\u003e\u003cbr /\u003eModel : NORWii N97s\u003cbr /\u003eChất liệu : Nhựa ABS và hợp kim nhôm\u003cbr /\u003eKết nối : 2.4GHz và Bluetooth\u003cbr /\u003eĐầu USB có thể cắm 2 cổng USB và Type C\u003cbr /\u003eLaser : Tia kĩ thuật số và tia Laser vật lý ( màu xanh công suất cao) \u003cbr /\u003eTầm chiếu xa laser vật lý 200m\u003cbr /\u003ePin: Pin lithium 300mAh\u003cbr /\u003eNguồn sạc : 5V\u003cbr /\u003eCổng sạc : USB Type C\u003cbr /\u003eĐiện áp làm việc: 3.7V ~ 4.2V\u003cbr /\u003eKích thước: 137 * 30 * 13.8mm\u003cbr /\u003eCân nặng: 46.9g\u003cbr /\u003eChức năng : Thuyết trình, trình chiếu trong hội nghị, họp công ty, văn phòng, giảng bài trên các phần mềm như PowerPoint, Word, Canva  và các phần mềm chuyên dụng khác.\u003cbr /\u003eHỗ trợ các HĐH : Windows, Linux, MacOS, Android từ 4.3 trở lên .\u003cbr /\u003eBộ sản phẩm gồm : Bút laser, đầu cắm 2in1, Cáp sạc Type c, Hộp đựng vải, HDSD\u003cbr /\u003eSản phẩm cắm usb kết nối và dùng trực tiếp các tính năng cơ bản của bút trình chiếu.\u003cbr /\u003eNgoài ra, để sử dụng các tính năng trình chiếu nâng cao của bút laser Spotlight N97s quý khách cần tải thêm phần mềm quản lý trang chủ Norwii\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ba/dc/03/e725834da4da746d294ce3e7e5db465e.jpg\" alt=\"\" width=\"750\" height=\"936\" /\u003e\u003cbr /\u003e Những điểm nâng cấp của bút Norwii N97s so với các dòng đời trước :\u003c/p\u003e\n\u003cp\u003e➊ Thân bằng hợp kim nhôm cao cấp tạo cảm giác cầm đầm tay và chắc chắn\u003cbr /\u003e➋ Hỗ trợ cả kết nối bluetooth, kết nối trực tiếp không cần đầu cắm\u003cbr /\u003e➌ Đầu cắm kết nối không dây 2in1 có thể cắm cổng USB hoặc Type c đều được\u003cbr /\u003e➍ Tích hợp sẵn laser tia xanh công suất cao\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/77/08/af/e851476503016b8d454f1897a25b11be.jpg\" alt=\"\" width=\"750\" height=\"463\" /\u003e\u003c/p\u003e\n\u003cp\u003e Ưu điểm vượt trội của bút laser Spotlight N97s so với bút trình chiếu laser phổ thông :\u003c/p\u003e\n\u003cp\u003eTia chỉ kỹ thuật số giúp bạn có thể chỉ điểm rõ ràng trên mọi màn hình máy tính, tivi, màn máy chiếu, màn LED, màn LCD\u003cbr /\u003e\u003cbr /\u003eNgoài ra, bút vẫn có laser vật lý tia xanh công suất cao sáng rõ hơn nhiều so với các dòng tia laser đỏ\u003c/p\u003e\n\u003cp\u003eBật , tắt video trong Slides dễ dàng chỉ bằng thao tác trên bút.\u003cbr /\u003e\u003cbr /\u003eNhiều tính năng nâng cao trên bút giúp bài thuyết trình được trình bày sáng tạo nổi bật và chi tiết hơn.\u003c/p\u003e\n\u003cp\u003eTính năng Spotlight chọn vùng cần làm nổi bật ( có thể tăng hoặc giảm vùng chọn tùy ý ).\u003c/p\u003e\n\u003cp\u003eTính năng phóng to vùng chọn làm tăng kích thước điểm ảnh giúp người bên dưới quan sát rõ hơn.\u003cbr /\u003e\u003cbr /\u003eTính năng chuột giúp thao tác trên slide như đang sử dụng chuột có thể bật tắt video, mở file, mở liên kết \u003c/p\u003e\n\u003cp\u003eBút cũng có chế độ rung hẹn giờ báo khi nào thời gian thuyết trình sắp hết để bạn chủ động hơn.\u003cbr /\u003e\u003cbr /\u003eChế độ viết ghi chú Note trên Slides rất tiện lợi.\u003c/p\u003e\n\u003cp\u003eNgoài ra, còn 1 vài tính năng như tăng, giảm âm lượng, chuyển tab, rung báo kết nối, hiện %  , quý khách có thể tham khảo thêm trong phần mềm cài đặt quản lý.\u003cbr /\u003e\u003cbr /\u003eBút mang đến sự thuận tiên cho người dùng với cổng sac USB C hiện đại và có thể dùng 3 tháng với chỉ 1 lần sạc 2h.\u003cbr /\u003e\u003cbr /\u003eSản phẩm phù hợp với mọi nhu cầu thuyết trình từ cơ bản đến nâng cao. Đồng thời, rất thích hợp với nhu cầu trình chiếu trên màn hình tivi, màn LED đang phổ biến hiện nay.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ed/54/a5/db0743a37fc416a7b4242fc08e0cb2e4.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/14/80/2f/c960581e9ec5e13b542ca72733cd8b03.jpg\" alt=\"\" width=\"750\" height=\"800\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/b9/12/fa/e3a0587ac851120f918043cd68ac72cb.jpg\" alt=\"\" width=\"750\" height=\"463\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ef/4b/f1/fce3690700696bb708f779de12f41b19.jpg\" alt=\"\" width=\"750\" height=\"922\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/b1/47/26/22c41fe04af3e6c7a6301dd478ea0306.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b1/47/26/22c41fe04af3e6c7a6301dd478ea0306.png","med