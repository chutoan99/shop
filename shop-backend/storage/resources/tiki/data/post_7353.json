ụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/19/ef/9f/c67fa120e05f900c4c3f786cf646a36c.jpeg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/19/ef/9f/c67fa120e05f900c4c3f786cf646a36c.jpeg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/19/ef/9f/c67fa120e05f900c4c3f786cf646a36c.jpeg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/19/ef/9f/c67fa120e05f900c4c3f786cf646a36c.jpeg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/19/ef/9f/c67fa120e05f900c4c3f786cf646a36c.jpeg"},{"base_url":"https://salt.tikicdn.com/ts/product/53/c5/49/82d40753740728b0debebc4896b1928b.jpeg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/53/c5/49/82d40753740728b0debebc4896b1928b.jpeg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/53/c5/49/82d40753740728b0debebc4896b1928b.jpeg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/53/c5/49/82d40753740728b0debebc4896b1928b.jpeg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/53/c5/49/82d40753740728b0debebc4896b1928b.jpeg"},{"base_url":"https://salt.tikicdn.com/ts/product/9c/c4/65/664bca070edb305e47cc858ba1229c21.jpeg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/9c/c4/65/664bca070edb305e47cc858ba1229c21.jpeg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/9c/c4/65/664bca070edb305e47cc858ba1229c21.jpeg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9c/c4/65/664bca070edb305e47cc858ba1229c21.jpeg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/9c/c4/65/664bca070edb305e47cc858ba1229c21.jpeg"},{"base_url":"https://salt.tikicdn.com/ts/product/d0/36/e9/0dfd5c9353946a7672b5c700b0820c2a.jpeg","i