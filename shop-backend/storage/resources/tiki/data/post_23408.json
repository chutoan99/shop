0,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/fd/74/e2/4622e3069fba245a0ee15ee499790100.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2137,"all_time_quantity_sold":3,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch5\u003eThiết kế cho máy ảnh không gương lật Sony E-mount\u003c/h5\u003e\n\u003cp\u003e\u003cstrong\u003eỐng Kính Sigma 30mm f/1.4 DC DN For Sony E Mount\u003c/strong\u003e là ống kính khẩu độ lớn dành cho máy APS-C và Micro Four Thirds và người dùng có thể tuỳ chọn các phiên bản ngàm E-mount hoặc M43 tuỳ theo loại máy. Với những đặc điểm như motor lấy nét bước, trọng lượng nhẹ, khẩu độ lớn, đây sẽ là một ống kính tốt cho cả nhu cầu chụp ảnh và quay phim được thiết kế cho máy ảnh không gương lật Sony E-mount. \u003c/p\u003e\n\u003ch5\u003eChất liệu chắc chắn\u003c/h5\u003e\n\u003cp\u003eỐng kính Sigma 30mm f 1.4 DC DN được chế tạo bằng vật liệu Composite (TSC) cùng với các kim loại truyền thống, cho độ chính xác cao hơn, bên ngoài của ống kính cũng được khắc với năm sản xuất\u003c/p\u003e\n\u003cp\u003eĐây là ống kính DN đầu tiên được xếp vào dòng Contemporary với kích thước nhỏ gọn 65 x 73mm và trọng lượng chỉ 265gr. Ống kính có thiết kế bóng bẩy với vỏ màu đen, đường kính filter của ống kính này có kích thước 52mm phổ biến.\u003c/p\u003e\n\u003ch5\u003eTiêu cự 30mm\u003c/h5\u003e\n\u003cp\u003eỐng kính có tiêu cự 30mm, cho góc nhìn tương đương 45mm trên cảm biến Full Frame khi gắn trên cảm biến APS-C và tương đương 60mm khi gắn trên cảm biến M43. Sigma cho biết cấu trúc quang học của ống kính bao gồm 9 thấu kính gom thành 7 nhóm, trong đó có 1 thấu kính phi cầu và 1 thấu kính phi cầu kép hai mặt, cho chất lượng hình ảnh tương đương với dòng ống kính ART.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/fd/74/e2/4622e3069fba245a0ee15ee499790100.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/fd/74/e2/4622e3069fba245a0ee15ee499790100.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/fd/74/e2/4622e3069fba245a0ee15ee499790100.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fd/74/e2/4622e3069fba245a0ee15ee499790100.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/fd/74/e2/4622e3069fba245a0ee15ee499790100.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/bc/61/9b/a91ed82e01edfc88ef35144298568103.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/bc/61/9b/a91ed82e01edfc88ef35144298568103.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/bc/61/9b/a91ed82e01edfc88ef35144298568103.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/bc/61/9b/a91ed82e01edfc88ef35144298568103.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/bc/61/9b/a91ed82e01edfc88ef35144298568103.jpg"}],"warranty_policy":null,"brand":{"id":45714,"name":"Sigma","slug":"sigma"},"current_seller":{"id":141495,"sku":"8990572790329","name":"DZ st