g_average":5,"review_count":3,"review_text":"(3)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/6f/2a/48/92524c008ee98fbbe496641270ade336.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1933,"all_time_quantity_sold":28,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch3 style=\"box-sizing: border-box; margin: 20px 0px 10px; padding: 0px; font-family: Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif; font-weight: 500; line-height: 1.1; color: #333333; text-align: justify; font-size: 15px !important;\"\u003eThiết kế hiện đại\u003c/h3\u003e\n\u003cp style=\"box-sizing: border-box; margin: 0px 0px 10px; padding: 0px; color: #333333; font-family: Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e\u003cspan style=\"box-sizing: border-box; margin: 0px; padding: 0px; font-weight: bold;\"\u003e DCN1806\u003c/span\u003e sở hữu thiết kế hiện đại, màu sắc phối kết hợp hài hòa, phù hợp để bạn lắp đặt sử dụng trong mọi không gian nội thất.\u003c/p\u003e\n\u003ch3 style=\"box-sizing: border-box; margin: 20px 0px 10px; padding: 0px; font-family: Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif; font-weight: 500; line-height: 1.1; color: #333333; text-align: justify; font-size: 15px !important;\"\u003eLàm mát hiệu quả\u003c/h3\u003e\n\u003cp style=\"box-sizing: border-box; margin: 0px 0px 10px; padding: 0px; color: #333333; font-family: Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003eSải cánh quạt với đường kính 43cm, kết hợp động cơ mạnh mẽ có công suất hoạt động 65W, đem đến hiệu quả làm mát vượt trội. \u003cspan style=\"box-sizing: border-box; margin: 0px; padding: 0px; font-weight: bold;\"\u003eQuạt đứng  DCN1806\u003c/span\u003e cho lưu lượng gió 91.2 m3/phút, giúp căn phòng của bạn luôn thông thoáng, dễ chịu.\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 0px 0px 10px; padding: 0px; color: #333333; font-family: Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003eVới công suất lớn cùng luồng gió mạnh, quạt được thiết kế chủ yếu sử dụng trong môi trường rộng như dùng trong cửa hàng, quán ăn, bách hóa, để tạo luồng gió mát xua tan đi cái nóng oi ức, khó chịu của ngày hè.\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 0px 0px 10px; padding: 0px; color: #333333; font-family: Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003eThêm vào đó, khi bạn sử dụng quạt đứng công nghiệp kết hợp với điều hòa nhiệt độ, luồng khí lạnh sẽ được khuếch tán rộng hơn, cho hiệu quả làm mát diện rộng, nơi mà điều hòa không tỏa được gió lạnh đến sẽ được làm mát đều.\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 0px 0px 10px; padding: 0px; color: #333333; font-family: Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/00/ac/31/60a28778777cfb29bf9327fa3e0c04cc.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/00/ac/31/b680a3f8666280f7abc2e6d4d46204bc.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 0px 0px 10px; padding: 0px; color: #333333; font-family: Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003eTuốc năng đảo gió diện rộng\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 0px 0px 10px; padding: 0px; color: #333333; font-family: Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003eĐằng sau quạt phía động cơ là một tuốc năng cơ giúp bạn điều chỉnh hướng gió thổi của quạt nhanh chóng mà không cần di chuyển chân đế. Khi rút tuốc năng lên quạt sẽ cố định góc thổi, còn khi bạn bấm tuốc năng xuống, quạt sẽ đảo gió liên tục theo chiều ngang, giúp làm mát diện rộng.\u003c/p\u003e\n\u003ch3 style=\"box-sizing: border-box; margin: 20px 0px 10px; padding: 0px; font-family: Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif; font-weight: 500; line-height: 1.1; color: #333333; text-align: justify; font-size: 15px !important;\"\u003eBa tốc độ gió tùy chọn\u003c/h3\u003e\n\u003cp style=\"box-sizing: border-box; margin: 0px 0px 10px; padding: 0px; color: #333333; font-family: Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e\u003cspan style=\"box-sizing: border-box; margin: 0px; padding: 0px; font-weight: bold;\"\u003e Senko DCN1806\u003c/span\u003e tích hợp sẵn 3 chế độ gió cho người dùng tùy chọn theo nhu cầu và sở thích. Các chế độ gió có thể được điều chỉnh bằng núm vặn trên thân quạt. Thêm vào đó, thân quạt còn có thể điều chỉnh chiều cao dễ dàng, giúp bạn linh hoạt sử dụng trong nhiều điều kiện và không gian khác nhau.\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 0px 0px 10px; padding: 0px; color: #333333; font-family: Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e \u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 0px 0px 10px; padding: 0px; color: #333333; font-family: Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e \u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 0px 0px 10px; padding: 0px; color: #333333; font-family: Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ee/bb/d2/7a3c11c9c343dd5d0bcfc057861b807e.jpg\" alt=\"\" wid