ân và hóa chất độc hại, không phát ra tia tử ngoại, an toàn cho người sử dụng\u003cbr /\u003e\nỨng dụng:Chiếu sáng hộ gia đình, căn hộ: phòng ngủ, phòng bếp….Chiếu sáng khu văn phòng: Phòng họp, hành lang, tiền sảnh…lắp đặt âm trần, nổi trần\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/d7/df/7c/c758d3ca833d6171c91c4bf93f32a04a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/d7/df/7c/c758d3ca833d6171c91c4bf93f32a04a.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/d7/df/7c/c758d3ca833d6171c91c4bf93f32a04a.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d7/df/7c/c758d3ca833d6171c91c4bf93f32a04a.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/d7/df/7c/c758d3ca833d6171c91c4bf93f32a04a.jpg"}],"warranty_policy":null,"brand":{"id":193677,"name":"Rạng Đông","slug":"rang-dong"},"current_seller":{"id":85931,"sku":"2506820208506","name":"BẢO LONG ELECTRIC","link":"https://tiki.vn/cua-hang/bao-long-electric","logo":"c3/47/92/531b011e6f9f33f7a6fb49eed8a1afb9.png","price":345000,"product_id":"56543546","store_id":79913,"is_best_store":false,"is_offline_installment_supported":null},"other_sellers":[{"id":246985,"name":"PHƯƠNG ĐÔNG TPHCM","link":"https://tiki.vn/cua-hang/phuong-dong-tphcm","logo":"b9/65/2f/670c7ac310a0419b7c104df559c72c52.jpg","price":385000,"product_id":"271894852","store_id":234017}],"specifications":[{"name":"Operation","attributes":[{"code":"is_warranty_applied","name":"Sản phẩm có được bảo hành không?","value":"Có"},{"code":"warranty_form","name":"Hình thức bảo hành","value":"Hóa đơn"},{"code":"warranty_ti