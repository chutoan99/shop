h":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":84500,"discount_rate":50,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/88/11/80/b358970883ad714dcb57e85f39427956.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":489,"all_time_quantity_sold":3,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch1\u003e\u003cstrong\u003eSản Phẩm: \u003c/strong\u003e\u003cstrong\u003eTất/ Vớ Cao Cấp Chất Liệu Modal - OCMSKCG 030\u003c/strong\u003e\u003c/h1\u003e\n\u003ch2\u003e\u003cstrong\u003e1. Thông Tin Sản Phẩm\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003e thuộc kiểu vớ cổ dài, có họa tiết kẻ sọc ngay phần cổ chân - giúp đôi chân thon gọn và hack chiều cao hiệu quả. Đây lựa chọn đúng chuẩn dành cho những đôi Giày Tây Derby hay Oxford.\u003c/p\u003e\n\u003cp\u003eSản phẩm làm từ sợi modal, công nghệ kháng khuẩn 2 lớp tránh gây mùi khi sử dụng cả ngày dài. Chất liệu đàn hồi ôm chân, thoải mái khi vận động. \u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003ePierre Cardin Paris Vietnam\u003c/strong\u003e. Chúng tôi cam kết đem đến cho Quý Khách hàng những trải nghiệm tốt nhất về sản phẩm thời trang hàng hiệu.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003e2. Chất Liệu Sản Phẩm\u003c/strong\u003e\u003c/h2\u003e\n\u003cul\u003e\u003cli\u003e\n\u003cp\u003eChất liệu Modal có tính kháng khuẩn, mềm mại và thoải mái;\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eĐược phủ thêm lớp phủ kháng khuẩn bằng công nghệ Agion AntimicrobiaL và khử mùi bằng công nghệ Lava X2;\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eVớ Oscar bền và đàn hồi, ít co giãn sau thời gian sử dụng;\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003e\u003cstrong\u003ePierre Cardin Paris Vietnam\u003c/strong\u003e là thương hiệu phụ kiện cao cấp đến từ Hoa Kỳ, song hành cùng những giá trị của Pierre Cardin.\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\u003cdiv\u003e \u003c/div\u003e\n\u003ch2\u003e\u003cstrong\u003e3. Cam Kết Về Sản Phẩm\u003c/strong\u003e\u003c/h2\u003e\n\u003cul\u003e\u003cli\u003e\n\u003cp\u003eCam kết đúng chất liệu \u0026amp; màu sắc sản phẩm.\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\u003cdiv\u003e \u003c/div\u003e\n\u003ch2\u003e\u003cstrong\u003e4. Hướng Dẫn Sử Dụng\u003c/strong\u003e\u003c/h2\u003e\n\u003cul\u003e\u003cli\u003e\n\u003cp\u003eGiữa tất ở nơi khô thoáng, tránh nơi ẩm thấp;\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eGiặt ở nhiệt độ dưới 40 độ C;\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eHạn chế là ủi với nhiệt độ cao trên 100 độ C.\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/88/11/80/b358970883ad714dcb57e85f39427956.png","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/88/11/80/b358970883ad714dcb57e85f39427956.png","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/88/11/80/b358970883ad714dcb57e85f39427956.png","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/88/11/80/b358970883ad714dcb57e85f39427956.png","thumbnail_url"