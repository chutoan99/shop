":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.6,"review_count":14,"review_text":"(14)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/b0/71/00/fdc066d3d365368251883c32c68bf665.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1127,"all_time_quantity_sold":45,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eĐược kiểm định chất lượng bởi TỔNG CỤC TIÊU CHUẨN ĐO LƯỜNG CHẤT LƯỢNG và phân phối bởi DOCNEEM, Bộ ba Phân bón hoa Lan toàn diện - Thương hiệu Docneem dự kiến sẽ phá đảo thị thị trường phân bón cho hoa lan với công dụng chăm sóc toàn diện từ RỄ, MẦM đến HOA\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003e1. \u003c/strong\u003e\u003cstrong\u003ePhân\u003c/strong\u003e\u003cstrong\u003e bón kích rễ BioRoot\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003ePhân bón dạng dung dịch, dễ hoà tan và hấp thụ, giúp xây dựng một bộ rễ khoẻ, vững chắc cho hoa lan để cây phát triển vượt trội với khả năng chống chịu hoàn hảo trước những nhân tố khắc nghiệt của môi trường như lạnh, hạn hán,…\u003c/p\u003e\n\u003cp\u003eBioRoot mang lại hiệu quả cao đối với các loại cây con, cây giâm chiết cành hoặc các cây đang giai đoạn phát triển nên được ứng dụng rộng rãi khi nhân giống hoa lan, hoa hồng\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/06/65/77/ca2cec1e1e1629755fefd7654cdaa003.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCÁCH BÓN\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cu\u003eVới hoa lan:\u003c/u\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eKích rễ BioRoot có thể sử dụng trong bất cứ giai đoạn nào của Lan, đặc biệt dùng cho cả cây yếu.\u003c/li\u003e\n\u003cli\u003eTỉ lệ: 8-10ml/ lít nước sạch, phun lên lá, tưới gốc mỗi 2 lần/tháng\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cu\u003eCây cảnh khác:\u003c/u\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eLúc vừa sang/chuyển chậu:  8-10ml/ lít nước sạch, bón mỗi 5-7 ngày/lần, liên tục trong 1 tháng\u003c/li\u003e\n\u003cli\u003eCây ổn định: 8-10ml/ lít nước sạch, phun lên lá, tưới gốc mỗi 2 lần/tháng\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cu\u003eGiâm cành giống:\u003c/u\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eNgâm trực tiếp vào dung dịch 15-20 phút và giâm cành\u003c/li\u003e\n\u003cli\u003eKhông cần rữa lại với nước\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/25/33/94/54f1bd08c2d51cfa082dffde05a39526.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003e2. \u003c/strong\u003e\u003cstrong\u003ePhân\u003c/strong\u003e\u003cstrong\u003e bón kích kie, mầm lá BioGrow\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003ePhân bón 100% hữu cơ vi sinh, giàu Potassium Humate thúc đẩy sự tổng hợp diệp lục ở thân lá lên mức cao nhất. Cùng đó, bổ sung các chất dinh dưỡng thiết yếu hỗ trợ tối đa cho lan trong giai đoạn muốn cây ra nhiều mầm, lá, kích kei cho cây lan phi điệp, giúp mầm ra nhanh, nuôi kie mập khoẻ và dưỡng mầm lá xanh tươi\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/a2/fe/04/2e52fadf33e185ddbd8eefa11a849e75.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCÁCH BÓN\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eCây khoẻ: 7-10ml/1 lít nước. Bón lá hoặc bón gốc định kỳ 2 lần/tháng\u003c/li\u003e\n\u003cli\u003eCây yếu: 5ml/1 lít nước. Bón lá hoặc bón gốc định kỳ 2 lần/tháng\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/1c/9e/fd/52a233a2c913f35538d02ac9309a21c0.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003e3. \u003c/strong\u003e\u003cstrong\u003ePhân\u003c/strong\u003e\u003cstrong\u003e bón kích hoa lá BioThrive:\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003eNguồn gốc 100% hữu cơ, giàu Potassium Humate, Fulvic Acid, Ca và Bo thúc đẩy sự phát triển và phân hoá nụ hoa. Đồng thời, đẩy nhanh quá trình phân hóa mầm hoa, đẩy nụ giúp hoa nở sai hơn, lâu tàn, chuẩn form và đậm màu\u003c/p\u003e\n\u003cp\u003e\u003cimg style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://salt.tikicdn.com/ts/tmp/61/f6/51/046c54cb0e4eabef7e314d2df1231b3a.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003eNgoài ra, do hoa lan thường chỉ ra hoa 1-2 lần mỗi năm nên BioThrive còn hỗ trợ phát triển kích thích bộ rễ, tăng sức đề kháng cho cây, hạn chế tình trạng mất sức. Có thể được xem là thần dược siêu kích hoa lan\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCÁCH BÓN\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eCây khoẻ: 7-10ml/1 lít nước. Bón lá hoặc bón gốc định kỳ 2 lần/tháng\u003c/li\u003e\n\u003cli\u003eCây yếu: 5ml/1 lít nước. Bón lá hoặc bón gốc định kỳ 2 lần/tháng\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/6d/8e/19/92971e2689e3087f927bbe83002f82d5.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003e4. Thông tin khác\u003c/strong\u003e\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003eCơ sở sản xuất: Uyên Ngô\u003c/li\u003e\n\u003cli\u003eHạn sử dụng: 36 tháng kể từ ngay sản xuất\u003c/li\u003e\n\u003cli\u003eDung tích: 500 ml\u003c/li\u003e\n\u003cli\u003eBảo quản nơi khô ráo, thoáng mát, vặn kín nắp chai sau khi sử dụng và tránh ánh nắng trực tiếp từ mặt trời\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/b0/71/00/fdc066d3d365368251883c32c68bf665.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/b0/71/00/fdc066d3d365368251883c32c68bf665.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/b0/71/00/fdc066d3d365368251883c32c68bf665.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b0/71/00/fdc066d3d365368251883c32c68bf665.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/b0/71/00/fdc066d3d365368251883c32c68bf665.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/61/f6/51/b67593e2c74ede11f69a0731058a4cd5.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/61/f6/51/b67593e2c74ede11f69a0731058a4cd5.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/61/f6/51/b67593e2c74ede11f69a0731058a4cd5.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/61/f6/51/b67593e2c74ede11f69a0731058a4cd5.jpg","thumbnail_url":"https://salt.t