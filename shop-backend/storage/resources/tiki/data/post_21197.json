11)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/29/75/04/dadebbb2ff62f3962424c90a66934f56.png","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1988,"all_time_quantity_sold":28,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch1 style=\"text-align: center;\"\u003e\u003cem\u003e\u003cstrong\u003eMáy Bơm Lốp Đa Năng MICHELIN 4398ML\u003c/strong\u003e\u003c/em\u003e\u003c/h1\u003e\n\u003cp style=\"color: #222222; font-size: 12.8px; text-align: center;\"\u003e\u003cspan style=\"font-size: 14pt;\"\u003e\u003cem\u003e\u003cstrong\u003e\u003cimg src=\"http://media3.scdn.vn/img3/2019/3_1/coDroL_simg_d0daf0_800x1200_max.jpg\" /\u003e\u003cbr /\u003e\u003c/strong\u003e\u003c/em\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"color: #222222; font-size: 12.8px; text-align: center;\"\u003e \u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003eBơm điện Michelin 12266 được thiết kế rất hiện đại, thông minh, nhiều tính năng thông dụng cho phép bạn cài đặt áp suất lốp tích hợp phù hợp và thông số hơi tự động ngắt. Đặc biệt máy Michelin 4398ML còn tích hợp đèn LED chiếu sáng và đèn LED màu đỏ nhấp nháy để cảnh báo an toàn khi bạn bơm trong đêm tối. Sở hữu máy bơm đa năng  Michelin 4398ML sẽ đảm bảo an toàn cho bạn và gia đình trên mọi nẻo đường.\u003c/p\u003e\n\u003cp style=\"color: #222222; font-size: 12.8px; text-align: center;\"\u003e\u003cspan style=\"color: #404040; font-size: 12pt;\"\u003e \u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"color: #222222; font-size: 12.8px; text-align: center;\"\u003e\u003cstrong\u003e\u003cspan style=\"color: #404040; font-size: 12pt;\"\u003eĐẶC ĐIỂM NỔI BẬT\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"color: #222222; font-size: 12.8px; text-align: center;\"\u003e\u003cspan style=\"color: #404040; font-size: 12pt;\"\u003e \u003cimg style=\"margin: 0 auto; display: block;\" src=\"http://media3.scdn.vn/img2/2018/3_22/13kVhx_simg_d0daf0_800x1200_max.jpg\" /\u003e\u003cbr /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003eTự động ngắt khi hơi đủ\u003cbr /\u003eMáy Bơm lốp Michelin 12266 được trang bị công nghệ cài đặt thông số hơi tự động ngắt khi áp suất trong lốp đủ, thông thường áp suất trong lốp là 2.4 Bar. Với công nghệ cài đặt thông số hơi tự động, giúp bạn yên tâm hơn mỗi khi bơm, không lo lốp căng quá hay non quá, đảm bảo an toàn tuyệt đối cho bạn trên mọi nẻo đường.\u003c/p\u003e\n\u003cp style=\"color: #222222; font-size: 12.8px; text-align: center;\"\u003e\u003cspan style=\"color: #404040; font-size: 12pt;\"\u003e \u003cimg style=\"margin: 0 auto; display: block;\" src=\"http://media3.scdn.vn/img2/2018/3_22/uGGMDf_simg_d0daf0_800x1200_max.jpg\" /\u003e\u003cbr /\u003e\u003cbr /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003eThiết kế đèn LED tiện dụng\u003cbr /\u003eĐặc biệt hơn, máy Michelin 12266 còn sở hữu hai đèn LED: 1 đèn chiếu sáng khi bơm, 1 đèn thông báo; rất thuận tiện và an toàn cho bạn khi bơm trong đêm tối.\u003c/p\u003e\n\u003cp style=\"color: #222222; font-size: 12.8px; text-align: center;\"\u003e\u003cspan style=\"color: #404040; font-size: 12pt;\"\u003e \u003cimg style=\"margin: 0 auto; display: block;\" src=\"http://media3.scdn.vn/img2/2018/3_22/5GkFPB_simg_d0daf0_800x1200_max.jpg\" /\u003e\u003cbr /\u003e\u003cbr /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003eThiết kế nhỏ gọn, đa năng\u003cbr /\u003eThiết kế nhỏ gọn, tiện dụng thuận tiện cho bạn khi di chuyển và khi cất, bạn có thể để trong cốp xe tiện dùng khi cần thiết. Ngoài ra, máy còn có kèm theo nhiều loại van bơm khác nhau: van bơm bóng, bơm xe máy, xe đạp, xuồng, phao… không những thế, máy còn trang bị thêm 1 ổ chia mồi thuốc 12V, 1 ổ chia USB rất thuận tiện cho việc dùng nhiều thiết bị cùng một lúc.\u003c/p\u003e\n\u003cp style=\"color: #222222; font-size: 12.8px; text-align: center;\"\u003e\u003cspan style=\"color: #404040; font-size: 12pt;\"\u003e \u003cimg style=\"margin: 0 auto; display: block;\" src=\"http://media3.scdn.vn/img2/2018/3_22/3Cw9cz_simg_d0daf0_800x1200_max.jpg\" width=\"748\" height=\"798\" /\u003e\u003cbr /\u003e\u003cbr /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003eTHÔNG SỐ KỸ THUẬT\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e-         Máy Bơm lốp Michelin 12266 có chức năng cài đặt thông số hơi tự động ngắt\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e-          Tiết kiệm thời gian thay lốp dự phòng\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e-          Bơm được tất cả các loại xe\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e-          Vòi thổi bụi, vòi bơm banh, bơm phao, bơm bong bóng.\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e-          Máy bơm được phao và nệm khí\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e-          Lập trình bơm khí từ 15 - 99.5PSI\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e-          Đèn LED hai màu ( Đỏ \u0026amp; Trắng )\u003c/p\u003e\n\u003cp style=\"text-align: center;\"\u003e-          Tích hợp ổ cắm nguồn 12V\u003c/p\u003e\n\u003cp style=\"color: #222222; font-size: 12.8px; text-align: center;\"\u003e-           Dây điện dài 305cm - dây bơm 50cm   \u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/29/75/04/dadeb