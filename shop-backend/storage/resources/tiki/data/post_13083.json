:"#FFF0F1","background_color":"#D93843","href":null,"text":"9.9"},{"placement":"pdp_badge","code":"is_hero","type":"pdp_icon_badge","index":1,"icon":"https://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":true,"return_reason":"any_reason"}},"discount":161000,"discount_rate":33,"rating_average":4.5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/bb/eb/a8/767b581280d6ca70d353fa5c2725ab58.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":923,"all_time_quantity_sold":7,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp\u003eCOMBO TRÀ GẠO LỨC VÀ NGŨ CỐC GIẢM CÂN ĂN KIÊNG QUÊ VIỆT NGUYÊN LIỆU TỰ NHIÊN AN TOÀN\u003c/p\u003e\n\u003cp\u003eTy Cổ Phần Tinh Chất Quê Việt chuyên cung cấp các sản phẩm chăm sóc sức khỏe và sắc đẹp với dây chuyền sản xuất hiện đại, trong đó có thể kể đến các sản phẩm như trà gạo lứt, ngũ cốc lợi sữa, ngũ cốc tăng cân, ngũ cốc giảm cân, ngũ cốc dinh dưỡng, tinh bột nghệ, viên tinh nghệ sữa ong chúa, mầm đậu nành, kem nghệ CurcuNa E+ Những sản phẩm này đều được làm từ các loại hạt tự nhiên không chứa chất bảo quản, không hóa chất độc hại và rất an toàn, lành tính.\u003c/p\u003e\n\u003cp\u003e⁂ Thương hiệu: Quê Việt\u003c/p\u003e\n\u003cp\u003e⁂ Xuất xứ: Việt Nam\u003c/p\u003e\n\u003cp\u003e⁂ Khối lượng: + Trà gạo lứt: 600gr + Ngũ cốc giảm cân: 500gr\u003c/p\u003e\n\u003cp\u003e⁂ Thành phần:\u003c/p\u003e\n\u003cp\u003e+ Trà gạo lứt: Đậu đen xanh lòng, đậu đỏ, gạo lứt, kỷ tử, hoa nhài, cỏ ngọt\u003c/p\u003e\n\u003cp\u003e+ Ngũ cốc giảm cân: Mè đen, mè trắng, đậu đen, đậu đỏ, gạo lứt, yến mạch, hạt chia ⁂ Hạn sử dụng 2 năm kể từ ngày sản xuất (xem trên bao bì)\u003c/p\u003e\n\u003cp\u003eTÁC DỤNG CỦA TRÀ GẠO LỨT VÀ NGŨ CỐC GIẢM CÂN QUÊ VIỆT\u003c/p\u003e\n\u003cp\u003e1. Trà gạo lứt:\u003c/p\u003e\n\u003cp\u003e- Giúp thanh lọc gan, thải độc cơ thể, giúp làn da trở nên tươi sáng và hồng hào hơn.\u003c/p\u003e\n\u003cp\u003e- Hỗ trợ bệnh nhân ung thư, bệnh tiểu đường, viêm gan và suy nhược thần kinh.\u003c/p\u003e\n\u003cp\u003e- Tốt cho người bệnh gout và phong thấp.\u003c/p\u003e\n\u003cp\u003e- Tăng cường chức năng của thận, người lớn sẽ không bị tiểu đêm.\u003c/p\u003e\n\u003cp\u003e2. Ngũ cốc giảm cân:\u003c/p\u003e\n\u003cp\u003e- Giảm cân tự nhiên, giúp phụ nữ lấy lại vóc dáng thon gọn, làn da săn chắc, khả năng chống lão hóa cơ thể, giúp xương luôn chắc khỏe, không bị giòn, đảm bảo hoạt động trơn tru và nhanh nhẹn.\u003c/p\u003e\n\u003cp\u003e- Phòng ngừa các bệnh về tim mạch, cao huyết áp, giảm lượng Cholesterol trong máu.\u003c/p\u003e\n\u003cp\u003e- Ngăn chặn tình trạng béo phì, mỡ máu cho người già ít vận động.\u003c/p\u003e\n\u003cp\u003e- Bột ngũ cốc sẽ giúp giảm cân, sẽ tạo cảm giác no, giúp bạn hạn chế ăn vặt, giảm lượng ăn trong các bữa chính trong khi vẫn đảm bảo cơ thể được cung cấp đầy đủ các vitamin, chất béo thực vật, giúp bạn giảm cân mà không bị mệt mỏi do thiếu chất.\u003c/p\u003e\n\u003cp\u003e- Bồi bổ sức khỏe, tăng cường sức đề kháng.\u003c/p\u003e\n\u003cp\u003eĐỐI TƯỢNG SỬ DỤNG TRÀ GẠO LỨT VÀ NGŨ CỐC GIẢM CÂN QUÊ VIỆT\u003c/p\u003e\n\u003cp\u003e- Người uống nhiều rượu bia hay chức năng gan bị suy yếu.\u003c/p\u003e\n\u003cp\u003e- Người muốn giải nhiệt, thanh lọc gan, cải thiện chức năng gan, thận.\u003c/p\u003e\n\u003cp\u003e- Dân văn phòng ngồi nhiều, ít vận động, muốn giảm cân an toàn.\u003c/p\u003e\n\u003cp\u003e- Những người bị bệnh gout và phong thấp.\u003c/p\u003e\n\u003cp\u003e- Người bị tiểu đường, mỡ máu, cao huyết áp.\u003c/p\u003e\n\u003cp\u003e- Người lớn tuổi thường xuyên bị tiểu đêm, mất ngủ.\u003c/p\u003e\n\u003cp\u003e- Cho mọi lứa tuổi có nhu cầu giảm cân.\u003c/p\u003e\n\u003cp\u003eCÁCH DÙNG TRÀ GẠO LỨC VÀ NGŨ CỐC GIẢM CÂN QUÊ VIỆT 1.\u003c/p\u003e\n\u003cp\u003eTrà gạo lứt:\u003c/p\u003e\n\u003cp\u003e- Cho 1 túi trà vào 1,5 lít nước đun sôi 5 phút, hoặc ngâm 10-15 phút trong nước nóng trên 80 độ c.\u003c/p\u003e\n\u003cp\u003e- Trà sau khi đun bạn nên sử dụng trong vòng một ngày. Có thể cho thêm đá nếu bạn thích uống lạnh. Dùng thay nước lọc uống hàng ngày.\u003c/p\u003e\n\u003cp\u003e2. Ngũ cốc giảm cân:\u003c/p\u003e\n\u003cp\u003e- Cho 25 - 30gr bột ngũ cốc pha với 200 - 250ml nước ấm khoảng 40 độ C, khuấy đều và có thể cho thêm đá nếu muốn uống lạnh.\u003c/p\u003e\n\u003cp\u003e- Uống 2 - 3 lần / 1 ngày vào các bữa trưa và bữa tối thay cho bữa ăn chính (hoặc trước bữa ăn chính).\u003c/p\u003e\n\u003cp\u003eLƯU Ý SỬ DỤNG\u003c/p\u003e\n\u003cp\u003e- Bảo quản ở nơi khô ráo, tránh ánh nắng trực tiếp.\u003c/p\u003e\n\u003cp\u003e- Duy trì đều đặn, kết hợp chế độ ăn uống hợp lý và sinh hoạt khoa học.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eQUÊ VIỆT - KHƠI NGUỒN VẺ ĐẸP TỪ THIÊN NHIÊN\u003c/p\u003e\n\u003cp\u003e➊ Cam kết 100% nguyên liệu từ thiên nhiên, không chất phụ gia, chất bảo quản, chất hóa học.\u003c/p\u003e\n\u003cp\u003e➋ Sản phẩm hàng chính hãng, có giấy tờ chứng nhận đầy đủ.\u003c/p\u003e\n\u003cp\u003e➌ Nhiệt tình hỗ trợ, tư vấn khách hàng 24/7.\u003c/p\u003e\n\u003cp\u003e➍ Miễn phí trả hàng 07 ngày\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e#tra #gao #lut #tragaolut #tragiamcan #trathaomoc #tuitra #thanhnhiet #giainhiet #thaidoc #giaidoc #gan #momau #bogan #giamcan #giammo #thongon #lamdep #boduong #suckhoe #gaolut #dauden #daudo #kytu #hoanhai #congot #thiennhien #antoan #douong #ngucoc #dinhduong #ankieng #antoan #ngucocdinhduong #ngucocgiamcan #tinhbotnghe #vientinhnghe #matong #suaongchua #mamdaunanh #quatang #queviet #chinhhang\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/bb/eb/a8/767b581280d6ca70d353fa5c2725ab58.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/bb/eb/a8/767b581280d6ca70d353fa5c2725ab58.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/bb/eb/a8/767b581280d6ca70d353fa5c2725ab58.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/bb/eb/a8/767b581280d6ca70d353fa5c2725ab58.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/bb/eb/a8/767b581280d6ca70d353fa5c2725ab58.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/7d/35/5f/76190e1bd8e2687d2860ed0b98efe928.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/7d/35/5f/76190e1bd8e2687d2860ed0b98efe928.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/7d/35/5f/76190e1bd8e2687d2860ed0b98efe928.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/7d/35/5f/76190e1bd8e2687d2860ed0b98efe928.jpg","thumbnail_url":"https://salt.tikicdn.com/