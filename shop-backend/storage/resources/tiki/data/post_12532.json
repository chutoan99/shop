s://salt.tikicdn.com/ts/upload/94/36/e7/c5297f3fad0a83fb56f98be877904467.png","icon_width":76,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"freeship_xtra","type":"pdp_icon_badge","index":2,"icon":"https://salt.tikicdn.com/ts/upload/be/67/48/04a82ab8df178e1a13bde38316081865.png","icon_width":91,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"return_policy","type":"pdp_icon_badge","index":3,"icon":"https://salt.tikicdn.com/ts/ta/b1/3f/4e/cc3d0a2dd751a7b06dd97d868d6afa56.png","icon_width":114,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":true,"return_reason":"any_reason"}},"discount":6000,"discount_rate":5,"rating_average":4.3,"review_count":4,"review_text":"(4)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/6a/61/53/dfabcf477f7a4e3437f72f5e56498751.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1198,"all_time_quantity_sold":58,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"<p><strong>Mã sản phẩm:</strong> NT31H320</p>\n<p><strong>Thành phần</strong>: Trầm hương, keo bời lời, tăm tre</p>\n<p><strong>Trọng lượng:</strong> 200g (~ 190 cây)</p>\n<p><strong>Chiều cao:</strong> 30 cm</p>\n<p><strong>Thời gian cháy</strong>: 30 phút/ cây</p>\n<p><strong>Tác dụng:</strong></p>\n<ul>\n<li>Vừa tạo hương thơm nhẹ nhàng, vừa mang màu sắc trang nhã, thích hợp  kính dâng Phật và gia tiên.</li>\n<li>Sử dụng trầm hương sẽ giúp đẩy lùi khí âm, tạp khí.</li>\n<li>Mang lại hương thơm dịu nhẹ, không quá đậm, hoàn toàn không gây kích ứng cho mũi.</li>\n<li>Khói hương mỏng, không gây ngạt hay cay mắt, an toàn đối với sức khỏe.</li>\n<li>Thanh lọc không khí,  xua tan các mùi khó chịu sẵn có, lưu hương giúp không gian sống trở nên thông thoáng, sạch sẽ hơn.</li>\n<li>Tạo điều kiện cho năng lượng tích cực mang tài khí, vận khí có thể bước chân đến gia đình bạn. </li>\n</ul>\n<p><strong>Hướng dẫn sử dụng:</strong></p>\n<ol>\n<li>Thắp nén nhang</li>\n<li>Cắm vào bát/ lư hương</li>\n</ol>\n<p><strong>Bảo Quản:</strong></p>\n<ul>\n<li>Bảo quản nơi khô ráo</li>\n<li>Đóng nắp hộp sau khi sử dụng</li>\n<li>Sản phẩm dùng được trong phòng máy lạnh (điều hòa)</li>\n</ul>\n<p><strong>Xuất xứ:</strong> Việt Nam</p>\n<p><strong>Nhang Trầm Hương Khánh An 30cm 200g</strong> là sản phẩm nhang sạch, làm từ nguyên liệu 100% tự nhiên từ trầm hương, keo bời lời và tăm tre. Đáp ứng nhu cầu thắp hương, cúng bái và đảm bảo an toàn cho sức khỏe người sử dụng. Sản phẩm được kiểm nghiệm tại Sở Khoa Học và Công Nghệ TP. HCM và Viện Sức Khỏe Nghề Nghiệp Và Môi Trường – Bộ Y Tế, khói nhang không chứa các thành phần độc hại, đảm bảo an toàn sức khỏe cho người sử dụng, đặc biệt an toàn với người bị mũi nhạy cảm.</p>\n<p><strong>Điểm nổi bật của Nhang Trầm Hương Khánh An 30cm 200g</strong></p>\n<p>Hương thơm dịu nhẹ, an toàn, dùng tốt cho nhà chung cư/ phòng máy lạnh.</p><p>Giá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....</p>","images":[{"base_url":"https://salt.tikicdn.com/ts/product/6a/61/53/dfabcf477f7