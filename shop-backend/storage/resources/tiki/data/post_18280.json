//salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":false,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":5,"review_count":2,"review_text":"(2)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/3a/6f/9f/753cb98edab696bd3f75e11860fdf050.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"instock","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":835,"all_time_quantity_sold":14,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch5\u003e \u003c/h5\u003e\n\u003ch5\u003eNâng tay một cách thoải mái\u003c/h5\u003e\n\u003cp\u003eĐặt tay lên con chuột thẳng đứng Lift trong suốt cả ngày, với tay cầm hoa văn mềm mại và chỗ để ngón tay cái vừa vặn giúp nâng cao sự thoải mái.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/b6/00/d1/fdcf4aa94ab3fa2419a6493f6a8f694c.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003ch5\u003eGóc nghiêng 57° thoải mái\u003c/h5\u003e\n\u003cp\u003eHình dáng thẳng đứng của Lift giúp cổ tay có cảm giác “thư giãn” khi làm việc, và tạo ra tư thế tự nhiên hơn ở cẳng tay cho cả ngày dài thoải mái và hiệu quả.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/04/1e/be/a13984f6436ded0be4a5cc7f68cbb565.png\" alt=\"\" width=\"450\" height=\"386\" /\u003e\u003c/p\u003e\n\u003ch5\u003eThư giãn để tập trung\u003c/h5\u003e\n\u003cp\u003eGiải quyết công việc với con chuột máy tính không dây có các nút tùy chỉnh dễ tiếp cận, tiếng nhấp chuột êm ái và SmartWheel để cuộn mượt mà, liền mạch.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/ba/05/0f/6ef3d4a2e1f8c0e697e9051b2442f6be.jpg\" alt=\"\" width=\"720\" height=\"720\" /\u003e\u003c/p\u003e\n\u003ch5\u003eĐược chứng nhận công thái học\u003c/h5\u003e\n\u003cp\u003eChuột không dây Lift Vertical được thiết kế, phát triển, thử nghiệm và phê duyệt theo tiêu chí do những nhà công thái học hàng đầu đề ra.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/e8/08/b9/324268b7216657fd48269176db0ea472.jpg\" alt=\"\" width=\"600\" height=\"600\" /\u003e\u003c/p\u003e\n\u003ch5\u003eKết nối theo cách của bạn\u003c/h5\u003e\n\u003cp\u003eKết nối qua Bluetooth tiết kiệm năng lượng hoặc USB Logi Bolt tới Windows, macOS, iPadOS, Chrome OS hoặc Linux, và tận hưởng thời lượng pin lên tới 2 năm.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/04/6e/47/b178a8d7cd4d5109c9611aa506f19f52.jpg\" alt=\"\" width=\"600\" height=\"600\" /\u003e\u003c/p\u003e\n\u003ch5\u003eChuyển đổi giữa các thiết bị khác nhau\u003c/h5\u003e\n\u003cp\u003eKết nối Lift tới tối đa 3 thiết bị sử dụng đa hệ điều hành, cho dù bạn sử dụng máy tính hay máy tính bảng. Di chuyển tệp giữa các thiết bị bằng công nghệ Flow của Logitech.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/7c/ed/34/f480d94bdcdd528ba8d02e520bbfb5c6.jpg\" alt=\"\" width=\"720\" height=\"720\" /\u003e\u003c/p\u003e\n\u003ch5\u003eLàm việc theo cách của riêng bạn\u003c/h5\u003e\n\u003cp\u003eTùy chỉnh 4 nút của Lift thành các lối tắt ưa thích của bạn bằng Phần mềm trực quan Logi Options+. Bạn thậm chí còn có thể thay đổi cài đặt cho các ứng dụng khác nhau.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/23/42/0f/d11e231f5f2375c04f1ea83020fa5c59.jpg\" alt=\"\" width=\"720\" height=\"720\" /\u003e\u003c/p\u003e\n\u003ch5\u003eThư giãn để tập trung suốt cả ngày dài\u003c/h5\u003e\n\u003cp\u003eÍt căng cơ ở cánh tay hơn. Đạt hiệu suất cao hơn trong tầm tay bạn. Yên lặng như một lời thì thầm, Lift giúp bạn tránh xa những điều gây xao lãng và tập trung vào những việc thực sự quan trọng.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/62/f1/ae/bfcec7d5a5d25d245bd1966344e5f268.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThông số sản phẩm\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003eTrọng lượng: 4,4 oz (125 g)\u003c/li\u003e\n\u003cli\u003eKích thước: 4,25 x 2,75 x 2,79 in (108 x 70 x 71 mm)\u003c/li\u003e\n\u003cli\u003eTracking DPI: 4000 DPI (hoàn toàn có thể điều chỉnh DPI)\u003c/li\u003e\n\u003cli\u003eLoại pin: 1 pin AA. Tuổi thọ pin: 24 tháng***\u003c/li\u003e\n\u003cli\u003ePhạm vi không dây: 10 m (33 ft)\u003c/li\u003e\n\u003cli\u003eKhả năng kết nối: Bluetooth Tiết kiệm Năng lượng hoặc đầu thu USB Logi Bolt\u003c/li\u003e\n\u003cli\u003eNền tảng tương thích: Windows 10, 11 trở lên, MacOs 10.15 trở lên, iPadOS 14 trở lên, Chrome OS, Linux, Android 8.0 trở lên**\u003c/li\u003e\n\u003c/ul\u003e\u003cp style=\"padding-left:80px;\"\u003e(***)Tuổi thọ pin có thể thay đổi tùy theo người dùng và điều kiện sử dụng máy tính.\u003c/p\u003e\n\u003cp style=\"padding-left:80px;\"\u003e(**) Các chức năng cơ bản của thiết bị sẽ được hỗ trợ mà không cần phần mềm dành cho các hệ điều hành khác ngoài Windows và macOS\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/3a/6f/9f/753cb98edab696bd3f75e11860fdf050.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/3a/6f/9f/753cb98edab696bd3f75e11860fdf050.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product