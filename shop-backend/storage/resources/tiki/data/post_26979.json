ll}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/c7/35/e3/e6306ee1c98a7b5c7a6e23d1bde3d0e2.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":1113,"all_time_quantity_sold":3,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003eTỪ ĐIỂN SONG NGỮ HÁN VIỆT - NHẬT DỤNG THƯỜNG ĐÀM CỦA PHẠM ĐÌNH HỔ\u003c/strong\u003e là bộ tự điển song ngữ Hán - Việt nhỏ, giải thích chữ Hán bằng chữ Nôm, xếp theo 32 môn loại như: Thiên văn, Luân tự, Nho giáo, Đạo giáo, Thích giáo, Thân thể, Thất ốc, Tác dụng, Thực phẩm, Quả thưởng, Đại dụng, Trướng dụng,  Du hí, Tật bệnh, Cầm thú, Trùng loạ Các từ ngữ tuy không nhiều, nhưng có thể nói là tạm đủ để đọc biết các chữ thông thường. Đó cũng là một tài liệu mà chúng ta có thể dùng so sánh để thấy những chỗ khác biệt trong cách chú và giải nghĩa chữ Hán bằng chữ Nôm.\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e\u003cstrong\u003eTỪ ĐIỂN SONG NGỮ HÁN VIỆT - NHẬT DỤNG THƯỜNG ĐÀM\u003c/strong\u003e hiện đang lưu giữ tại Thư viện Quốc gia Việt Nam, mang kí hiệu R.1726, được khắc in năm Tự Đức thứ 4 (1851), do nhà in Đồng Văn Trai tàng bản. Ngoài trang bìa và bài tựa, sách gồm 52 tờ khắc in trên dấy dó. Nội dung được chia làm 32 môn loại, mỗi môn loại chia thành nhiều mục từ khác nhau; mỗi mục từ được chia làm 2 phần là chữ Hán và giải thích nghĩa bằng chữ Nôm.\u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003eTheo như thống kê của các nhà nghiên cứu, từ Hán Việt trong tiếng Việt chiếm khoảng 70 %. Do đó việc học tập và hiểu biết cặn kẽ từ Hán Việt đối với học sinh, sinh viên và những người ngoại quốc học tiếng Việt là rất cần thiết. \u003c/p\u003e\n\u003cp style=\"text-align:justify;\"\u003e(Sách chưa sử dựng nhưng do in bằng giấy xốp lâu ngày nên bị ố nhẹ. Quý khách cân nhắc!)\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/c7/35/e3/e6306ee1c98a7b5c7a6e23d1bde3d0e2.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c7/35/e3/e6306ee1c98a7b5c7a6e23d1bde3d0e2.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c7/35/e3/e6306ee1c98a7b5c7a6e23d1bde3d0e2.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c7/35/e3/e6306ee1c98a7b5c7a6e23d1bde3d0e2.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c7/35/e3/e6306ee1c98a7b5c7a6e23d1bde3d0e2.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/8b/db/f4/7110e05c26496f2d52a74e670d6efee9.jpeg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/8b/db/f4/7110e05c26496f2d52a74e670d6efee9.jpeg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/8b/db/f4/7110e05c26496f2d52a74e670d6efee9.jpeg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8b/db/f4/7110e05c26496f2d52a74e670d6efee9.jpeg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/8b/db/f4/7110e05c26496f2d52a74e670d6efee9.jpeg"},{"base_url":"https://salt.tikicdn.com/ts/product/41/ca/d4/73a6d3b791e0ecdd41b26153bdc69c7c.jpeg","is_gallery":true,"label":null,"large_url":