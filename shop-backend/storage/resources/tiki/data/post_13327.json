ht":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":4.5,"review_count":17,"review_text":"(17)","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/17/07/84/7e6544eb4b7e15a2bc08c786194940fe.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":2140,"all_time_quantity_sold":51,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e\u003cspan style=\"box-sizing: border-box;\"\u003e\u003cstrong\u003eMũ bảo hiểm nửa đầu có kính Sunda 180B trơn\u003c/strong\u003e \u003c/span\u003elà phụ kiện không thể thiếu khi đi xe mô tô, xe máy, mang lại sự an toàn và phong cách thời trang cho người sử dụng. Thiết kế kiểu mũ nửa đầu gọn gàng, có kính chắn gió rất tiện lợi và an toàn cho người đội.\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e\u003cspan style=\"box-sizing: border-box;\"\u003e\u003cstrong\u003eChất liệu cao cấp, đảm bảo an toàn\u003c/strong\u003e\u003cbr style=\"box-sizing: border-box;\" /\u003e\u003c/span\u003e\u003cstrong\u003e\u003cspan style=\"box-sizing: border-box;\"\u003eMũ bảo hiểm nửa đầu có kính Sunda 180B trơn\u003c/span\u003e\u003c/strong\u003e với vỏ mũ được sản xuất từ chất liệu nhựa ABS có tính năng chịu va đập mạnh và xuyên thủng cao. Đây đều là những loại nhựa nguyên chất, không pha tạp, không thêm phụ gia. Đặc tính của nhựa ABS là có độ đàn hồi lớn, chịu được cong vênh và áp lực. Lớp xốp bên trong mũ dày dặn, vừa vặn bám chặt với phần vỏ giúp triệt tiêu hoàn toàn xung lực mạnh từ bên ngoài tác động vào, giảm chấn hiệu quả tối đa, ôm trọn vòng đầu. Do đó, bảo vệ tốt và giảm tối đa các chấn thương đầu khi không may xảy ra va chạm. Trọng lượng được phân tán đều, không gây cảm giác nặng và đau đầu, tạo cho người đội cảm giác thoải mái khi sử dụng. Đường may viền, là một điểm nhấn của Sunda 180B.\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e\u003cstrong\u003e\u003cspan style=\"box-sizing: border-box;\"\u003eTrang bị lớp lót và khóa an toàn\u003c/span\u003e\u003c/strong\u003e\u003cbr style=\"box-sizing: border-box;\" /\u003eMũ sử dụng lớp vải lót kháng khuẩn, có khả năng thấm hút cao, giúp thoáng khí tốt, không gây ra các bệnh về da đầu và tóc. Vải lót có kết cấu màng lưới lớn, cho phép không khí lưu thông dễ dàng vào bên trong, tạo cảm giác thoáng mát và dễ chịu. Ngoài ra, mũ còn được trang bị khóa chắc chắn và dây quai chịu lực cực mạnh, độ dài linh động phù hợp với nhiều người.\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e\u003cstrong\u003e\u003cspan style=\"box-sizing: border-box;\"\u003eKính\u003c/span\u003e \u003c/strong\u003e\u003cspan style=\"box-sizing: border-box;\"\u003e\u003cstrong\u003emũ bảo hiểm nửa đầu có kính Sunda 180B\u003c/strong\u003e \u003cstrong\u003etrơn\u003c/strong\u003e\u003c/span\u003e được làm từ vật liệu chất lượng cao, đã qua xử lý đặc biệt, cho góc quan sát rộng, hình ảnh rõ nét, trung thực, không bị chói đèn, có khả năng chống tia UV, chắn gió, để bạn tập trung lái xe.\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e\u003cstrong\u003e\u003cspan style=\"box-sizing: border-box;\"\u003eCh­ứng nhận QCVN\u003c/span\u003e\u003c/strong\u003e: Đã được chứng nhận hợp quy, công bố hợp quy phù hợp quy chuẩn kỹ thuật quốc gia QCVN . Nón được gắn dấu hợp quy CR, ghi nhãn hàng hóa theo quy định của pháp luật.\u003c/p\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e\u003cstrong\u003e\u003cspan style=\"box-sizing: border-box;\"\u003eVì sao Mũ bảo hiểm nửa đầu có kính Sunda 180B trơn là lựa chọn tốt nhất của bạn ?\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cul dir=\"ltr\" style=\"box-sizing: border-box; margin-top: 0px; margin-bottom: 10px; color: #333333; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e\n\u003cli style=\"box-sizing: border-box;\"\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424;\"\u003eGiá thành phải chăng mà vẫn đảm bảo an toàn khi tham gia giao thông\u003c/p\u003e\n\u003c/li\u003e\n\u003cli style=\"box-sizing: border-box;\"\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424;\"\u003eNhỏ nhẹ, thuận lợi khi sử dụng trong việc di chuyển trong thành phố\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp style=\"box-sizing: border-box; margin: 5px 0px 12px; color: #242424; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"\u003e\u003cstrong\u003e\u003cspan style=\"box-sizing: border-box;\"\u003e*** Hướng dẫn xác định cỡ mũ phù hợp\u003c/span\u003e:\u003c/strong\u003e Vòng 1 sợi dây quanh đầu, ngay phía trên lông mày và tai khoảng 2cm. Xiết sợi dây sao cho ôm vừa đủ thoải mái lấy đầu và ghi lại số đo đó. Lặp lại như vậy để tìm được số đo mà bạn cảm thấy dễ chịu nhất và sử dụng số đo đó để xác định cỡ mũ phù hợp.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/17/07/84/7e6544eb4b7e15a2bc08c786194940fe.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/17/07/84/7e6544eb4b7e15a2bc08c786194940fe.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/17/07/84/7e6544eb4b7e15a2bc08c786194940fe.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/17/07/84/7e6544eb4b7e15a2bc08c786194940fe.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/17/07/84/7e6544eb4b7e15a2bc08c786194940fe.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/c5/d0/14/db1d54311fb5808744ac0a89e4e30b7a.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c5/d0/14/db1d54311fb5808744ac0a89e4e30b7a.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c5/d0/14/db1d54311fb5808744ac0a89e4e30b7a.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c5/d0/14/db1d54311fb5808744ac0a89e4e30b7a.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c5/d0/14/db1d54311fb5808744ac0a89e4e30b7a.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/c0/66/60/6054ca64fd9f059b40d86bbe3729dcc7.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c0/66/60/6054ca64fd9f059b40d86bbe3729dcc7.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c0/66/60/6054ca64fd9f059b40d86bbe3729dcc7.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/20