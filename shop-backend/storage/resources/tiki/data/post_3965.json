turn_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/64/36/33/be6a220f304ee0f12c03c19c33d7ff09.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":690,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003cdiv class=\"ldf-key-title\"\u003e\n\u003cdiv class=\"ldf-text ldf-sizeTitle4 ldf-weightBold ldf-primary\"\u003e \u003c/div\u003e\n\u003cdiv class=\"ldf-text ldf-sizeTitle4 ldf-weightBold ldf-primary\"\u003e\u003cstrong\u003eThông tin nổi bật\u003c/strong\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003cul class=\"ldf-list\"\u003e\u003cli class=\"ldf-listItem\"\u003eHệ thống loa kép\u003c/li\u003e\n\u003cli class=\"ldf-listItem\"\u003eÂm thanh stereo đa hướng\u003c/li\u003e\n\u003cli class=\"ldf-listItem\"\u003eKết nối không dây Bluetooth\u003c/li\u003e\n\u003cli class=\"ldf-listItem\"\u003eThời lượng pin: 8 tiếng\u003c/li\u003e\n\u003c/ul\u003e\u003cdiv class=\"title-link-wrapper mb-2\"\u003e\n\u003ch4 class=\"title font-weight-bold\"\u003eHộp sản phẩm\u003c/h4\u003e\n\u003c/div\u003e\n\u003cul class=\"list-type-check list-style-none\"\u003e\u003cli\u003eLoa Harman Kardon Onyx Studio 8\u003c/li\u003e\n\u003cli\u003ePower cable\u003c/li\u003e\n\u003cli\u003ePrinted materials\u003c/li\u003e\n\u003cli\u003ePhiếu bảo hành\u003c/li\u003e\n\u003cli\u003eHướng dẫn sử dụng\u003c/li\u003e\n\u003c/ul\u003e\u003ch2\u003e\u003cstrong\u003eThiết kế thông minh\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003e kế thừa những nét đặc trưng về thiết kế của các mẫu loa tiền nhiệm. Loa có vóc dáng hình cầu tạo hình dạng như dải ngân hà bao quanh trái đất mang đến vẻ đẹp độc đáo và cao cấp.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eHarman Kardon Onyx Studio 8\u003c/strong\u003e được chế tác từ chất liệu tái chế, kết hợp với các vật liệu thân thiện với môi trường. Tay cầm được làm từ kim loại cao cấp, giúp tăng tính sang trọng, tinh tế cho loa để dễ dàng phù hợp với bất cứ không gian phòng nào và giúp bạn dễ dàng điều chỉnh loa xung quanh tay cầm.\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"lazy-load\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/8c/4f/b7/f98f74c98206967ef4d5bd0556932b6a.jpg\" alt=\"Harman Kardon Onyx Studio 8 16\" width=\"850\" height=\"445\" /\u003e\u003c/p\u003e\n\u003cp\u003eXung quanh loa được bọc tấm ê căng vải dệt giúp chống bụi, ẩm để có thể phù hợp với nhiều môi trường khác nhau. Với kích thước nhỏ gọn chỉ 312 x 275.8 x 163.8 mm và nặng 3.52 kg, bạn sẽ dễ dàng di chuyển và bố trí loa ở bất cứ đâu để thưởng thức âm nhạc.\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"lazy-load\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/90/38/c3/2c40a9804591d2bffea58925bed96e30.jpg\" alt=\"Harman-Kardon-Onyx-Studio-8-15-1\" /\u003e\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eÂm thanh stereo ấn tượng\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003e\u003cstrong\u003eOnyx Studio 8\u003c/strong\u003e được Harman Kardon trang bị hệ thống loa kép cải tiến độc quyền, cho ra âm thanh stereo đa hướng sống động, nâng cao trải nghiệm giải trí của bạn và gia đình.\u003c/p\u003e\n\u003cp\u003eVới hệ thống củ loa bao gồm củ tweeter 2.5cm và củ woofer 12cm phát âm nổi một cách trung thực, mạnh mẽ với công suất 50W.  m thanh từ nhạc cụ, bộ gõ hay giọng hát đều được tái hiện một cách rõ ràng và chi tiết.\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"lazy-load\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/e5/b1/65/dcaf2ee4139a795e622a47623fec930e.jpg\" alt=\"Harman-Kardon-Onyx-Studio-8-11\" /\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eHarman Kardon Onyx Studio 8\u003c/strong\u003e sẽ là sự lựa chọn lý tưởng để nghe nhạc giao hưởng, jazz, Loa phù hợp với các buổi party 15 - 20 m2, hứa hẹn mang đến cho bạn không gian giải trí hoàn hảo.\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eThời lượng pin lớn\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003eMột ưu điểm của loa \u003cstrong\u003eOnyx Studio 8 \u003c/strong\u003ephải kể đến là có dung lượng pin lớn. Với mỗi lần sạc đầy mất 5 tiếng, loa cung cấp nguồn năng lượng dồi dào với khả năng phát nhạc liên tục hơn 8 tiếng. Bạn sẽ thoải mái vui chơi giải trí mà không lo bị gián đoạn giữa chừng.\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"lazy-load\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/9b/02/51/20cdf232b44517c24546ef1820493d4a.jpg\" alt=\"Harman Kardon Onyx Studio 8 18\" width=\"850\" height=\"445\" /\u003e\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eKết nối linh hoạt và hiện đại\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003eBạn có thể kết nối loa \u003cstrong\u003eHarman Kardon Onyx Studio 8\u003c/strong\u003e với các thiết bị thông minh như , ,  một cách dễ dàng và nhanh chóng thông qua công nghệ Bluetooth không dây hiện đại.\u003c/p\u003e\n\u003cp\u003eChỉ mất vài giây kết nối, Harman Kardon Onyx Studio 8 sẽ giúp bạn tận hưởng âm thanh ở bất cứ đâu mà không phải cắm dây rườm rà. Với phạm vi kết nối lên đến 10 mét và đường truyền ổn định, loa cho âm thanh chất lượng, có độ trễ thấp và chân thực như bản gốc.\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"lazy-load\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/cf/6b/b1/60a9504bab68428ab98f31d7910956a7.jpg\" alt=\"Harman-Kardon-Onyx-Studio-8-13\" /\u003e\u003c/p\u003e\n\u003cp\u003eNgoài ra, loa được trang bị các cổng kết nối AUX 3.5mm, Type-C cho phép bạn kết nối với các thiết bị âm thanh khác một cách linh hoạt.\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eCông nghệ Wireless Dual Sound\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003eHarman Kardon đã tích hợp công nghệ Wireless Dual Sound, cho phép bạn kết nối 2 chiếc \u003cstrong\u003eHarman Kardon Onyx Studio 8 \u003c/strong\u003eđể phát nhạc, giúp mở rộng không gian bữa tiệc và mang đến trải nghiệm nghe hoàn hảo.\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eĐiều khiển trực quan\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003e\u003cstrong\u003eHarman Kardon Onyx Studio 8\u003c/strong\u003e cung cấp các nút điều khiển trực quan, cho phép bạn thao tác linh hoạt và dễ dàng, tùy theo nhu cầu sử dụng của mình. Bao gồm các nút như: bật/tắt Bluetooth, giảm âm lượng, nút nguồn, tăng âm lượng, dừng/phát chơi nhạc (nhấn lần 2 là chuyển bài hát).\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"lazy-load\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/86/51/93/08cd44feb3c8c58822a6372f401636b6.jpg\" alt=\"Harman-Kardon-Onyx-Studio-8-09\" width=\"850\" height=\"850\" /\u003e\u003c/p\u003e\n\u003ch2\u003e\u003cstrong\u003eTích hợp 2 micro thoại cao cấp\u003c/strong\u003e\u003c/h2\u003e\n\u003cp\u003e\u003cstrong\u003eHarman Kardon Onyx Studio 8\u003c/strong\u003e được trang bị 2 micro thoại có khả năng thu nhận giọng nói của bạn từ mọi vị trí trong căn phòng. Đi kèm với đó là công nghệ khử tiếng ồn và chống ồn tối ưu, giúp micro thu được âm thanh chất lượng, ổn định và rõ ràng nhất.\u003c/p\u003e\n\u003cp\u003e\u003cimg class=\"lazy-load\" src=\"https://salt.tikicdn.com/cache/w750/ts/product/af/02/e1/ae77553593fcb3b92766c614a83e2f23.jpg\" alt=\"Harman-Kardon-Onyx-Studio-8-14\" /\u003e\u003c/p\u003e\n\u003cp\u003eLoa \u003cstrong\u003eHarman Kardon Onyx Studio 8\u003c/strong\u003e sở hữu những ưu điểm về cả thiết kế và chất lượng âm thanh. Đây sẽ là sự lựa chọn lý tưởng mang đến cho người nghe trải nghiệm giải trí đỉnh cao.\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá tr