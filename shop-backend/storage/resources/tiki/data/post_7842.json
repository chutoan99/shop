ull,"text":null},{"placement":"pdp_badge","code":"is_authentic","type":"pdp_icon_badge","index":4,"icon":"https://salt.tikicdn.com/ts/upload/d7/56/04/b93b8c666e13f49971483596ef14800f.png","icon_width":89,"icon_height":20,"text_color":null,"background_color":null,"href":null,"text":null}],"tracking_info":{"amplitude":{"is_authentic":true,"is_freeship_xtra":true,"is_hero":false,"return_reason":"any_reason"}},"discount":0,"discount_rate":0,"rating_average":0,"review_count":0,"review_text":"Chưa có đánh giá","favourite_count":0,"thumbnail_url":"https://salt.tikicdn.com/cache/280x280/ts/product/c2/ab/db/362776c61a981f195e5ad725c9021dd2.jpg","has_ebook":false,"inventory_status":"available","inventory_type":"backorder","productset_group_name":"","is_fresh":false,"seller":null,"is_flower":false,"has_buynow":true,"is_gift_card":false,"salable_type":null,"data_version":3300,"day_ago_created":188,"all_time_quantity_sold":1,"meta_title":"","meta_description":"","meta_keywords":"","is_baby_milk":false,"is_acoholic_drink":false,"description":"\u003ch1 class=\"QN2lPu\"\u003eMáy sấy tóc SUNHOUSE SHD2317\u003c/h1\u003e\n\u003cp class=\"QN2lPu\"\u003e\u003cstrong\u003eMáy sấy tóc SUNHOUSE SHD2317\u003c/strong\u003e công suất lớn lên đến \u003cstrong\u003e1800W\u003c/strong\u003e giúp tóc nhanh khô. Sản phẩm còn có đầu sấy hẹp tạo luồng khí mạnh và tập trung giúp bạn làm khô tóc nhanh chóng và tạo được nhiều kiểu tóc hơn.\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eSản phẩm thích hợp dùng trong cả gia đình và các salon, tiệm tóc…\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/c2/ab/db/1671171aab893c4a8f5f2787f37e8b7b.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e\u003cstrong\u003eKIỂU DÁNG NHỎ GỌN, DỄ DÀNG SỬ DỤNG\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eThiết kế chắc tay, hiện đại\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eSản phẩm làm từ nhựa ABS siêu bền, kháng khuẩn, chống bám bụi tốt giúp sản phẩm luôn sáng bóng như mới. Gam màu đen bóng pha chi tiết vàng đồng tạo cảm giác sang trọng và hiện đại.\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eĐầu sấy hẹp dài tạo luồng khí mạnh và tập trung, giúp sấy khô nhanh hơn và tạo được nhiều kiểu hơn.\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/68/a3/8d/0b6c2762ed7be07fb00fd5d80f319895.jpg\" alt=\"\" width=\"750\" height=\"502\" /\u003e\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e\u003cstrong\u003eNút gạt nhẹ nhàng, thay đổi nhiệt độ linh hoạt\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eSản phẩm sử dụng nút gạt lên xuống để thay đổi 2 tốc độ gió \u0026amp; 3 mức nhiệt. Chế độ gió nóng mặc định, nếu muối đổi chế độ gió mát, bạn chỉ cần ấn nút có sẵn trên tay cầm.\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/33/22/2f/9cf421f529ae0b9a19c203408540cc7b.jpg\" alt=\"\" width=\"750\" height=\"502\" /\u003e\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e\u003cstrong\u003eSẤY KHÔ NHANH \u0026amp; BẢO VỆ TÓC\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eCông suất mạnh mẽ, sấy tóc nhanh\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eMáy sấy sử dụng công suất 1800W với 2 tốc độ - 4 mức nhiệt khác nhau giúp sấy tóc nhanh khô; tiết kiệm thời gian, điện năng và công suất. Bạn có thể tùy chỉnh chế độ sấy khô hoặc sấy mát bảo vệ tóc bằng cách trượt/gạt nhẹ công tắc trên tay cầm, vô cùng tiện dụng và dễ dàng.\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/11/86/7a/e3d9d25d77346b4bbc91d638decad950.jpg\" alt=\"\" width=\"750\" height=\"502\" /\u003e\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e\u003cstrong\u003eTấm tản nhiệt siêu bền, quạt gió mạnh mẽ\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eMáy sấy có tấm tản nhiệt bằng hợp kim siêu bền, hút gió tối ưu mà không làm nóng sản phẩm, nâng cao tuổi thọ cho máy được lâu bền hơn.\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/43/3c/5f/2cbca2db6d6468638ce07f9bd81b9eb4.jpg\" alt=\"\" width=\"750\" height=\"502\" /\u003e\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e\u003cstrong\u003eAn toàn khi sử dụng\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003eSản phẩm mang đến sự an toàn tuyệt đối cho người dùng nhờ bộ phận bảo vệ quá tải nhiệt an toàn, tự động ngắt điện khi máy hoạt động quá tải.\u003c/p\u003e\n\u003cp class=\"QN2lPu\"\u003e\u003cimg src=\"https://salt.tikicdn.com/ts/tmp/1a/a7/53/c93ba5ca235837497a5c6fff3b775ffd.jpg\" alt=\"\" width=\"750\" height=\"750\" /\u003e\u003c/p\u003e\u003cp\u003eGiá sản phẩm trên Tiki đã bao gồm thuế theo luật hiện hành. Bên cạnh đó, tuỳ vào loại sản phẩm, hình thức và địa chỉ giao hàng mà có thể phát sinh thêm chi phí khác như phí vận chuyển, phụ phí hàng cồng kềnh, thuế nhập khẩu (đối với đơn hàng giao từ nước ngoài có giá trị trên 1 triệu đồng).....\u003c/p\u003e","images":[{"base_url":"https://salt.tikicdn.com/ts/product/c2/ab/db/362776c61a981f195e5ad725c9021dd2.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/c2/ab/db/362776c61a981f195e5ad725c9021dd2.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/c2/ab/db/362776c61a981f195e5ad725c9021dd2.jpg","position":null,"small_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c2/ab/db/362776c61a981f195e5ad725c9021dd2.jpg","thumbnail_url":"https://salt.tikicdn.com/cache/200x280/ts/product/c2/ab/db/362776c61a981f195e5ad725c9021dd2.jpg"},{"base_url":"https://salt.tikicdn.com/ts/product/87/ec/b4/f2bca9a942225cd0b6d875ec9fa74467.jpg","is_gallery":true,"label":null,"large_url":"https://salt.tikicdn.com/cache/w1200/ts/product/87/ec/b4/f2bca9a942225cd0b6d875ec9fa74467.jpg","medium_url":"https://salt.tikicdn.com/cache/w300/ts/product/87/ec/b4/f2bca9a942225cd0b6d875ec9fa74467.jpg","position":null,"small_url":"https://salt.ti